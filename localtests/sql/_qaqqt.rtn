	set:$d(commentOptions("SQLRuntimeStats"),topt) $$$mtOptionsSQLRuntimeStatsFlag=topt
	set:$d(commentOptions("SQLRuntimeStatsPID"),topt) $$$mtOptionsSQLRuntimeStatsPID=topt
