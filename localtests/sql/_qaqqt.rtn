%qaqqt^MAC^^^0
%qaqqt	// Main SQL statement compiler routine)
	;; COMPONENTS :: SQL
	#;
#INCLUDE %msql
#INCLUDE %SYS.PTools.Stats
#IF 0   ;-------------------------------------------------------------
	; Description:   Query Processor Main
	; Author:        Aviel Klausner
	; Date Started:  1987
	;
	;  MRP1267 (09/29/2021) - [DP-408485] Fix bugs and Refactor the SQL 'EXPLAIN' feature
