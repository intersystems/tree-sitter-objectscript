		#; if %0SQLCompileLevel>0, this is a recursive compile.
		#; We also record statement hashes to record nested parallel compiles and links between root-parent and the parallel child.
		#;  %0SQLCompileLevel(%0SQLCompileLevel)=hash of statement
		#;  %0SQLCompileLevel("proot") = hash of parallel root statement
