	set:$g(commentOptions("Profile"))=1 mt("pTools")=1
	set:$d(commentOptions("Profile_All"),topt)=1 mt("pTools")=$S(+topt=0:0,1:2)
	set:$d(commentOptions("source-tsql"),topt)=1 mt("options","source-tsql")=topt
