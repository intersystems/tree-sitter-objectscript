					set act=$o(mtc(0,0,"g/r fields",act),1,fields) quit:act=""
					set ptr=0,flist=""
					while $listnext(fields,ptr,fld) { set ifn=$$$smdGetIfn($p(i,$c(1),3),irn,fld),flist=flist_$lb($s(ifn'="":$$$smdGetFieldName(ifn),1:fld)) }
					set mtc(0,0,"g/r fields",act)=flist
				}
				#; DPV3164= If $g(%caller)="xDBC",'$g($$$mtKCheckOptionCodeCounter),$g($$$EXTsqlinsertcode($$$rEXT,$$$smdExtent($p(i,$c(1),3),irn))) s mtc(0,0,"insert inline")=1	// DPV2318=
			}
		}
		s mtc(0,0,"type")=$$$mtStatementType                             ;  statement type
			#;  updel flag=1 for unrestricted UPDATE/DELETE
			#;  proceed with SELECT statement only
		If $$$mtStatementType'="SEL",($$$mtStatementType'="DEC") {
			 s:"UPD DEL"[$$$mtStatementType mtc(0,0,"updel")='$g($$$mtWhere(1))
			 	#;  For INS/UPD/DEL we go to continfo because we may need to setup mtc(0,0,"view iud priv") privileges
			 g:" INS UPD DEL "[(" "_$$$mtStatementType_" ") continfo
			 GOTO end
		}
	}
	GOTO:"OPE CLO"[$$$mtStatementType&&('$d($$$mtSelectInto)) end                  ; no code generated
	
	#; MRP875
	if $$$SQLStatsFlagON&&($$$mtStatementType'="FET")&&($g(rtname)'="")&&(rtname'="source lines")&&(callname'="info") { do newSQLStats^%SYS.PTools(.sql,$$$mtStatementType,$NAMESPACE,rtname,$S($g(mcurs)'="":mcurs,1:callname),($ZH-compiletime),$LG($g(sqlidxhash),1),$LB($g(embeddedcached),callname,%caller)) }
	//BJB408		Next line and the jdbcType condition are only need until Aviel adds support for JDBC to %qaqcmx
	if $g($$$mtDSNConnection)'="" s connectionNumber=$O(^%SYS("sql","ODBCCONNECTION","INDEX","NameIndex",$zu(28,$$$mtDSNConnection,7),"")),jdbcType=$S(connectionNumber="":"",1:$LG(^%SYS("sql","ODBCCONNECTION","DATA",connectionNumber),7))
	if ($$$mtStatementType'="SEL")&&($$$mtStatementType'="DEC")&&extab&&'info {
		do open^%qacsub
		do exsel^%qaqcmx
		do file^%qacsub($$$qsqline(1),"int-only-=-no-filing")
		do close^%qacsub   ;  external table DECLARE/SELECT
		goto end
	}
	if $$$mtStatementType="FET",'$d($$$mtSelectInto)	{ do fetch^%qaqcmn goto end }
	if "CRV ALV DRV"[$$$mtStatementType		{ do vugen^%qaqcDDLCodeGen goto end }    ; View DDL
	if "CRT ALT DRT CRI DRI CRUS ALUS DRUS CRF CRM CRP CRQ DRF DRM DRP DRQ CRG DRG CAL LCK ULK CRD DRD USD TUN CMDL AMDL DMDL TMDL VMDL CMLCONFIG AMLCONFIG DMLCONFIG CRA DRA CRS DRS CRFT DRFT ALFT CRSV DRSV ALSV ALS"[$$$mtStatementType { do ^%qaqcDDLCodeGen goto end }
	if "GRP RVP"[$$$mtStatementType			{ do grsysprv^%qaqcmn goto end }		// GRA/REV System Privs
	if "CRR DRR"[$$$mtStatementType			{ do crdrrole^%qaqcmn goto end }		// CREATE DROP role (DPV3678 moved this up to here, was after DD lookup)
	if $$$mtStatementType="%CHSP"				{ do chkprv^%qaqcmn goto end }			// %CHECKPRIV <syspriv>
	if $$$mtStatementType["GET"				{ do getgen^%qaqcmn goto end }			// Parse the GET statement...
	if ",SET TP,START TP,%BE,%IN,%INTRANSACTION,COM,ROL,SAV,"[(","_$$$mtStatementType_",") { do tp^%qaqcmn goto end }		// Transaction Processing...
	if $$$mtStatementType["SET"				{ do setopt^%qaqcDDLCodeGen goto end }
	if $$$mtStatementType["STATISTICS"			{ set mtc(0,0,"type")=$$$mtStatementType do setopt^%qaqcDDLCodeGen goto end }
	if $$$mtStatementType="FET"				{ do fetch^%qaqcmn goto end }			// FETCH ... INTO
	if $$$mtStatementType="DEL",'mcurs			{ do updel^%qaqcmn goto end }			// cursor DELETE
	if $$$mtStatementType="FREEZE"				{ do freeze^%qaqcDDLCodeGen goto end }		// FREEZE PLANS
	if $$$mtStatementType="UNFREEZE"			{ do unfreeze^%qaqcDDLCodeGen goto end }	// UNFREEZE PLANS
	if $$$mtStatementType="PURGE"				{ do purge^%qaqcDDLCodeGen goto end }		// PURGE [CACHED] QUERIES
	if $$$mtStatementType="BUILD"				{ do buildindex^%qaqcDDLCodeGen goto end }	// BUILD INDEX
	if $$$mtStatementType="BUILDDEFERRED"		{ do BuildDeferred^%qaqcDDLCodeGen goto end }	// BUILD DEFERRED
	if $$$mtStatementType="LOAD"				{ do load^%qaqcDDLCodeGen GOTO end }	// LOAD
	if $$$mtStatementType="CANCELQRY"			{ do cancelQuery^%qaqcDDLCodeGen GOTO end }	// CANCEL QUERY <pid spec> ...
.
continfo	; --- Continue Here for INSERT/UPDATE Information Gathering ---
	
		#; determine if this view is updateable prior to dd lookup because we don't need to get all checkoption conditions for
		#; the viewinfo compile if the view is not updateable. (DPV2956)
	new checkView set checkView=0 if readonlyview="check" { set readonlyview=$$UpdatableQuery(),checkView=1 }	// DPV2956=
	if " INS UPD DEL "[(" "_$$$mtStatementType_" "),$$$mtKIudSubquery($g($$$mtK))=1,$$UpdatableQuery() do error^%qaqpsq("35e")	// DPV3701
.
	  #;   ------------------------------------- DATA DICTIONARY LOOKUP -------------------------------------
	new privs
	If "GRA REV %CH"[$$$mtStatementType { d start^%qaqpqo } 
	Elseif 'fplan { 
		new mtsave
		if $d(sqlidxhash) {
				// For the SQL Statement Index, define mtc(0,0,"table") and gather privilege info for the statement.
			new irn,sub,ttype
			kill mtc(0,0,"table")   // start clean
			set sub=""
			for  {
				set sub=$o($$$mtFromTableName(sub)) quit:sub=""
				continue:$d($$$mtQbHasForSomeElement($p(sub,"^",1)))
	                	continue:$e($$$mtFromTableName(sub),1,3)="%%Q"
				set irn=$$$smdLoadGetIrn($$$mtFromTableName(sub),$g($$$mtTvf(+sub,$$$mtFromTableName(sub)))),i=$$$smdRVData($$$mtFromTableName(sub))
				continue:irn=""||(i="")
				set ttype=$p(i,$c(1),3)
				set mtc(0,0,"table",sub)=ttype_$c(1)_irn_$c(1)_$p(i,$c(1))_$c(1)_$$$smdExtent(ttype,irn)_$c(1)_$$$smdClassname(ttype,irn)_$c(1)_$$$smdSharded(ttype,irn)_$c(1)_$$$smdFastInsert(ttype,irn)_$c(1)_$$$smdFastSelect(ttype,irn)_$c(1)_$$$smdfastSelectSlotCount(ttype,irn)_$c(1)_$$$smdShardMasterName(ttype,irn)_$c(1)_$$$smdfastInsertSlotCount(ttype,irn)
			}
			if $d($$$mtSaveF) {	// anything saved in inssel^%qaqcmn?
				set sub=""
				for  {
					set sub=$o(mt("savef",sub)) quit:sub=""
					continue:$d(mtc(0,0,"table",sub))#2	// already defined
					continue:$d($$$mtQbHasForSomeElement($p(sub,"^",1)))
		                	continue:$e(mt("savef",sub),1,3)="%%Q"
					set irn=$$$smdLoadGetIrn(mt("savef",sub),$g($$$mtTvf(+sub,mt("savef",sub)))),i=$$$smdRVData(mt("savef",sub))
					continue:irn=""||(i="")
					set ttype=$p(i,$c(1),3)
					set mtc(0,0,"table",sub)=ttype_$c(1)_irn_$c(1)_$p(i,$c(1))_$c(1)_$$$smdExtent(ttype,irn)_$c(1)_$$$smdClassname(ttype,irn)_$c(1)_$$$smdSharded(ttype,irn)_$c(1)_$$$smdFastInsert(ttype,irn)_$c(1)_$$$smdFastSelect(ttype,irn)_$c(1)_$$$smdfastSelectSlotCount(ttype,irn)_$c(1)_$$$smdShardMasterName(ttype,irn)_$c(1)_$$$smdfastInsertSlotCount(ttype,irn)
				}
			}
			do DefineMtcTable^%qaqpif2
			if " INS UPD DEL "[(" "_$$$mtStatementType_" "),$$$mtKViewIVN($g($$$mtK))'="" { set mtc(0,0,"view iud priv")=$$$smdGetIqnFromIrn($$$mtKViewIVN($$$mtK)) }
			do StatementPrivs(.mtc,.privs)
			kill mtc(0,0)
		}
		d ^%qaqpqo
	}  // DPV1693 New mtsave; PVA320 fplan
 
		#; PVA052: remove setting of mtc(0,0,"view iut")
	If " INS UPD DEL "[(" "_$$$mtStatementType_" "),$$$mtKViewIVN($g($$$mtK))'="" { s mtc(0,0,"view iud priv")=$$$smdGetIqnFromIrn($$$mtKViewIVN($$$mtK)) }	// DPV1705=, // DPV2090 Storediqn in "view iud priv" data, not irn
.
.
	If checkView {  //DPV1693+	// DPV2956
		//s readonlyview=$$UpdatableQuery()
		If readonlyview,checkoptioncode'="" d error^%qaqpsq(36)
		If 'readonlyview {
			  #;  In checkoptioncode(-1) I store a $List of View extents which have check option code 
			  #;  which needs to be executed.  This list gets stored in ^oddEXTR(extentname,"spec",92,-1) and 
			  #;  the code from these views is code generated it INS/UPD compile time.
 
			  #;  In checkoptioncode(-1) I store a $List of View ivn's which have check option code which needs to be executed.
			  #;  This list gets stored in ^mdd(3,ivn,4,-1) and the code from these views is code generated it INS/UPD compile time.
			If checkoptioncode="C" {  //Check ALL conditions on underlying views
				s i="" 
				For  {
					s i=$o(mt("view2",i)) q:i=""
					s checkoptioncode(-1)=$g(checkoptioncode(-1))_$lb($$$smdExtent(3,$p(mt("view2",i,"co"),"^",2)))	// a list of all underlying views
				}
			}
			Else {	// Check only underlying views with check option
				s i="" 
				For  {
					s i=$o(mt("view2",i)) q:i=""
					i $e(mt("view2",i,"co"))="C"||($e(mt("view2",i,"co"))="L") s checkoptioncode(-1)=$g(checkoptioncode(-1))_$lb($$$smdExtent(3,$p(mt("view2",i,"co"),"^",2)))	// a CHECK OPTION was found in an underlying view
				}
			}
				#; If updatable view, define code to check validation against this view's where condition(s).
					#; It may not be checked against this view if this view has no check option, but if this view is used
					#; as an underlying view which has CASCADED CHECK OPTION this condition will need to be checked for it. 
			n checkoption,cond,datag,lines,mod,sqline,tag,tagchar,tagpre,textcond
			s lines=0,mod=0,tag="",checkoption=checkoptioncode,checkoptioncode=0,tagpre=$p(gtag,$c(1)),datag=0,tagchar=""
			i '$d(%substk) n %substk s %substk=1
			f i=1:1:$l($g($$$mtWhere(1)),"^")-1 {
				  #;  If CHECK OPTION and condition from this view's query, build the code
				If '$lf($g($$$mtWhereCheckOption),$p($$$mtWhere(1),"^",i)) {
					#; a new code generation context for the evaluation of multiple expressions
					#; within each condition
					n cgc do cgcInit^%qaqcasl
					d open^%qacsub k sqline do cgcInit^%qaqcasl //clear any davals from Open
					s cond=$$cond^%qaqpDDLParser2($p($$$mtWhere(1),"^",i),1,.sqline)    // If updatable, determine validation code for CHECK OPTION
					n davals s davals = $e($$cgcGet^%qaqcasl("davals"),2,*) //remove the prefix ","
					i davals'="" {
						s lines=""
						f j=1:1:$l(davals,",")-1 s lines=$g(lines)_$s($g(lines)="":" n ",1:",")_pti($p(davals,",",j))
						s checkoptioncode($i(checkoptioncode))=lines
					}
					s lines="" f  s lines=$o(sqline(0,lines)) q:lines=""  s checkoptioncode($i(checkoptioncode))=sqline(0,lines)
					s checkoptioncode($i(checkoptioncode))=" i '"_cond_" s sqlcode=$s(%oper=""INSERT"":-136,1:-137),%msg=""WITH CHECK OPTION validation for view '"_$p(callname,$c(1),2)_"' failed"" q"
					n vcheckoptioncode s vcheckoptioncode="checkoptioncode"
					d file^%qacsub("@vcheckoptioncode@(1)","int-only-=-no-filing"),close^%qacsub
					i $d(sqline(1)) {
						s checkoptioncode($i(checkoptioncode))=$c(9)_" Quit" 
						s mod=0 f  s mod=$o(sqline(mod)) q:mod=""  s lines="" f  s lines=$o(sqline(mod,lines)) q:lines=""  s checkoptioncode($i(checkoptioncode))=sqline(mod,lines)
					}
				}
			}
		}
	}  // DPV1693-
 	GOTO:info end
 	
	i $$$mtStatementType="INS",'$P($g($$$mtSelectInto),"^",2) d open^%qacsub,insrt^%qaqcmn,file^%qacsub($$$qsqline(1),"int-only-=-no-filing"),close^%qacsub g end
	i $$$mtStatementType="UPD",'mcurs  d open^%qacsub,updel^%qaqcmn,file^%qacsub($$$qsqline(1),"int-only-=-no-filing"),close^%qacsub g end    ; cursor UPDATE
	#;  if target sharded, maybe send whole INSERT-SELECT to shards  ;AK959;AK1000
	i $$$mtStatementType="INS",$g(mt("shtop",1)),$$$smdSharded(1,$p(mtc(mcurs,"f"),",",2)),$$freesh^%qaqcmn(1) { d open^%qacsub,shinsel^%qaqcmn,file^%qacsub($$$qsqline(1),"int-only-=-no-filing"),close^%qacsub GOTO end }  ;  free-sharded INSERT
	#;  AK957;AK1000
	i "UPD DEL"[$$$mtStatementType,$g(mt("shtop",1)) { i $$$smdSharded(1,$p(mtc(mcurs,"f"),",",2)),$$freesh^%qaqcmn(1) { d open^%qacsub,shardup^%qaqcmn,file^%qacsub($$$qsqline(1),"int-only-=-no-filing"),close^%qacsub GOTO end }  ;  sharded DELETE
		else { s mtc(mcurs,"rid")=+$$$mtOutputVals($$$mtOutput(1)),$$$mtOutput(1)=$$$mtOutput(1)_$g($$$mtNewVals) } }
	i $$$mtStatementType="%CH"         d chkprv^%qaqcmn   g end    ; %CHECKPRIV
	i "GRA REV"[$$$mtStatementType     d grtrev^%qaqcmn   g end    ; GRANT REVOKE
	 	
	#;   ------------------------------------- QUERY OPTIMIZATION AND PATH ACCESS SELECTION -------------------------------------
	#;s malg=$i($$$tFileRoot),mcost=$i($$$tFileRoot)
queryopt
	d:'fplan ^%qaqo1 // PVA320 fplan test
 
	  #;   ------------------------------------- PATH SPECIFICATION -------------------------------------
pathspec	  
	k ptj  ;  ,ptres  ;  removed by AK1014
	d:'fplan ^%qaqpag  // PVA320 fplan test
	kill $$$MalgItself,$$$McostItself  ;  to prevent <STORE>
	kill $$$fsave
	
		#; For the query plan, there are a couple of things we need to check here.
		#; We need to know if this is a parallel query or not.  Parallel queries (for now) are not allowed to be frozen.
		#; $data(mt("haspar")) is TRUE if this query will produce "child" subqueries for %PARALLEL.  This will be used to tell that this query is a "parent" parallel query
	if $d(sqlidxhash) {	// Make sure there is a statement hash
		if $d($$$mtHasParRoot) {	// This is a parallel compile that will produce child statements
			if '%0SQLCompileLevel { set %0SQLCompileLevel("proot")=$li(sqlidxhash) }	// parallel root, record hash
			else {	// recursive compile
				if '$d(%sqlParallelInfo) { do pushPRoot($li(sqlidxhash)) }	// new parallel parent, not a parallel child.  Must push previous parallel root on stack
				else                     { set %0SQLCompileLevel(%0SQLCompileLevel)=$$Hash^%SYS.SQLSRV(str,.%normsql,%0SQLCompileLevel("proot")),$li(sqlidxhash,1)=%0SQLCompileLevel(%0SQLCompileLevel) }	// parallel child that is itself parallel.  reset statement hash to include parallel root hash
			}
		}
		else {	// this is not a parallel compile
			if $d(%sqlParallelInfo) { 	// parallel child, reset statement hash to include parallel root hash
				set %0SQLCompileLevel(%0SQLCompileLevel)=$$Hash^%SYS.SQLSRV(str,.%normsql,%0SQLCompileLevel("proot"))
				set $li(sqlidxhash,1)=%0SQLCompileLevel(%0SQLCompileLevel)
			}
		}
		if saveplan>0,'fplan { do SavePlanar^%qaqplansave(.%qplan,0) } // PVA320	// THIS SHOULD SIMPLY DEFINE THE PLAN TO SAVE IN %qplan (sic) and then pass in by reference below to SaveSQLIndex()
	}
        g:saveplan=2 end
	  #;   ------------------------------------- CODE GENERATION -------------------------------------
codegeneration
	#; AK877
	i jdbcType=1,'$g($$$mtEmpty(1)) {  ;  AK882
		d open^%qacsub
		d exsel^%qaqcmxj
		merge:((%caller="ShowPlan1")||(%caller="ShowPlan4")||(%caller="ShowPlan5")||(%caller="ShowPlan3")) dsql=sql,dasl=asl,dmt=mt,dcost=omscost,dmts=mts
		merge:(%caller="ShowPlan2") dsql($i(dsql))=sql,dasl(dsql)=asl,dmt(dsql)=mt,cost(dsql)=omscost
		d file^%qacsub($$$qsqline(1),"int-only-=-no-filing")
		d close^%qacsub   ;  external table DECLARE/SELECT
		g end
	}
	#; AK877-
	if 'fplan,$g(mt("rtpc","outliersexist")) {
		new %RTUQueryExpression,mtcsave // %sqlstub - ^%qaqcasl will fill this in through call-chain that calls GetSQL 
		merge mtcsave=mtc // must be saved before %qaqcasl call, %qaqcasl will add a lot of stuff to mtc
	}
	d open^%qacsub,^%qaqcasl,file^%qacsub($$$qsqline(1),"int-only-=-no-filing"),close^%qacsub
	if 'fplan,$g(mt("rtpc","outliersexist")) { // JSL5140
		// complete asl with node used in ShowPlan and mt node used in SavePlanar
		Set mt("rtpc","RTUqexp")=$g(%RTUQueryExpression) ; JSL5140, JSL5154
		if saveplan>0,'$g(%showplan) { // %showplan tested, JSL5146
			n mtcqaqcasl,mtcode
			merge mtcqaqcasl=mtc
			kill mtc
			merge mtc=mtcsave // we don't want the new mtc nodes added by %qaqcasl to be saved in the plan
			do SavePlanar^%qaqplansave(.%qplan,0)  // PVA320 // JSL5087, THIS SHOULD SIMPLY DEFINE THE PLAN TO SAVE IN %qplan (sic) and then pass in by reference below to SaveSQLIndex()
			kill mtc
			merge mtc=mtcqaqcasl
 		}
	}
	if $g(mt("rtpc","outliersexist")),($extract($get(%caller),1,8)="ShowPlan")||$g(%showplan) {
		merge dasl=asl,dmt=mt,dmts=mts ; Make these variable arrays publicly available for use by the ShowPlan/Explain features!
	}
.
	s:mcurs mcurs=""
end	;   entry point to end program
	if ",info,recount,"'[(","_callname_",") {	// --- Code-Generator SQL {%PROFILE | %PROFILE_ALL} Directives ---
		set:$g(PTActFlag)'="" PTActFlag=$$$setSQLStatsActionFlagForJobValue(PTActFlag)	// Reset PTools 'actionFlag'
	}
	#; DPV4651
		#;  Here we will record a SQL Statement Index of embedded SQL statements.
		#;  This includes a list of privileges needed in order to run the statement
	if $d(sqlidxhash),$extract($get(%caller),1,8)'="ShowPlan",'$g(%showplan) { // %showplan tested, JSL5146
		if 'fplan {
			new planstate
			if $d($$$mtHasParRoot)||($d(%sqlParallelInfo))||($d(mt("options","fastFetchPut"))) { set planstate=3 } else { set planstate=0 }	// Unfrozen/Parallel if this is a parallel statement, otherwise Unfrozen.
			if '$$SaveSQLIndex^%SYS.SQLSRV($lg(sqlidxhash),.%normsql,rtname,$$GetRelationList(.mt),.%qplan,.privs,planstate,$li(sqlidxhash,2),codecontainer,$s($d(%sqlParallelInfo):$g(%0SQLCompileLevel("proot")),1:""),+$get(mt("natural"))) {
				if $$$mtStatementType="DEC" { kill mtc(mcurs,"o") }	// Allows subsequent OPEN/FETCH/CLOSE compilations to know statement failed to compile
				if $g(wrtref)'="",$g(backgrnd) {  ; Record SQL Error for MPP...
					new n,sqlcnt
					set n=$g(@wrtref@(0))+1
					set sqlcnt=$g(@wrtref@("sql"))+1
					set @wrtref@(n)=%msg
					set @wrtref@(0)=n                  ; Count ALL Errors
					set @wrtref@("sql")=sqlcnt         ; Count SQL Errors
				}
				set $ze="<SYNTAX>ep^%qaqperr" goto err	// simulate same failure as if in %qaqperr
			}
		} else {
				#; Just update the routine/container the statement was found in
			if '$$SaveSQLIndex^%SYS.SQLSRV($lg(sqlidxhash),,rtname,,,,,,codecontainer) {
				if $$$mtStatementType="DEC" { kill mtc(mcurs,"o") }	// Allows subsequent OPEN/FETCH/CLOSE compilations to know statement failed to compile
				if $g(wrtref)'="",$g(backgrnd) {  ; Record SQL Error for MPP...
					new n,sqlcnt
					set n=$g(@wrtref@(0))+1
					set sqlcnt=$g(@wrtref@("sql"))+1
					set @wrtref@(n)=%msg
					set @wrtref@(0)=n                  ; Count ALL Errors
					set @wrtref@("sql")=sqlcnt         ; Count SQL Errors
				}
				set $ze="<SYNTAX>ep^%qaqperr" goto err	// simulate same failure as if in %qaqperr
			}
		}
	}
	if $data(%fastivar),%msqlvar="i%%" do insertprops^%qaqcasl(%classname,$lg($g(sqlidxhash)),.methodstoadd)
	#; DPV4651-
	kill $$$ptrelRoot,$$$ptlnRoot
	do:$g($$$smd("fakefields"))'="" RemoveFakeFields^%qTable()	// DPV3554
	do:$g($$$smd("fakestreams"))'="" removeFakeStreams^%qTable()
	if $data(OldPartitionSize) set $zs=OldPartitionSize	// Reset partition size
	if $g(%smdpushed) { do popsmd() }
	if $g(%prootpush) { do popPRoot() }
	set %0SQLCompileLevel=%0SQLCompileLevel-1 kill:%0SQLCompileLevel=-1 %0SQLCompileLevel 
	if SQLStatsLocal'="" { $$$resetSQLStatsFlag(SQLStatsLocal) }
	QUIT
err	set $zt="" n errtn
	if $$$ZERRORISINTERRUPT($ze) { ztrap $zerror }
	if ($ze'="") { set err=$ze,errtn=$p($ze,">",2) } 
	else { set err=$g(err),errtn="" }
	if errtn["qaqperr" { set err="qaqperr" }
	kill $$$MalgItself,$$$McostItself
	do:$g($$$smd("fakefields"))'="" RemoveFakeFields^%qTable()	// DPV3554
	$$$ksqline
	kill $$$ptrelRoot,$$$ptlnRoot,$$$fsave
		#;  here there should be a broadcast utility
	if err["qaqperr",$d(%msg),'$g(backgrnd) { goto errdone }
	if err["qacsub",$d(%ok),$e(%ok,1,2)=$c(48,1) { set %msg=$p(%ok,$c(1),2,*) goto errdone }	// DPV2848=
	new tCurDevice set tCurDevice=$io
	if $g(%msg)'="" { goto qaperr }
	if '$g(backgrnd) { u:$g(%diffdev)&&($d(IO)) IO w !,"ObjectScript Error while compiling SQL statement: ",err u tCurDevice }
errdone	if $data(OldPartitionSize) { set $zs=OldPartitionSize } /* Reset partition size */ RETURN:callname="recount"   /* Don't trap to class compiler error trap during recount compilation. (DPV1525) */ if $g($$$mtStatementType)="DEC",mcurs'="" { set mtc(mcurs,"error")=$lb(SQLCODE,%msg) }
	#;i $g(err)'="" s %msg=$g(%msg)=$s($g(%msg)'="":$c(13,10),1:"")_err
	if $g(%smdpushed) { do popsmd() } set %0SQLCompileLevel=%0SQLCompileLevel-1 kill:%0SQLCompileLevel=-1 %0SQLCompileLevel if SQLStatsLocal'="" { $$$resetSQLStatsFlag(SQLStatsLocal) } if $g(err)'="",$g(%msg)="" { set %msg=err } if $g(%prootpush) { do popPRoot() }
	$$$Abort	// THIS LINE MUST BE AT errdone+2.  IF YOU MOVE IT, UPDATE ALL CODE THAT CHECKS FOR $ZE AT errdone+2
	RETURN
 
qaperr	if '$g(backgrnd) { use:$g(%diffdev)&&($d(IO)) IO write !,$p(%msg,"^"),!,$p(%msg,"^",2) use tCurDevice }
	goto errdone
UpdatableQuery() [mt,mtc] PRIVATE {	// DPV1693+
	
	    #;  If we are info compiling the view query when the view is projected to SQL, determine if the
	    #;  view is updatable or not.  Here are the rules:
	    #;  A view is updatable if and only if:
	    #;	  - The query does not use DISTINCT
	    #;    - The value-expressions in the select-list are all column-references, and none of them appear more than once or use -> syntax
	    #;    - The query has only one table reference, and it identifies either a non-read-only base-table or an updatable view
	    #;    - The query does not have group-by-clause or a having clause.
	    #;    - The query does not specify any pagination clause: TOP/LIMIT/FECTH or OFFSET
	    #;  Parameter:
	    #;    checkoption - PBR, return the check option for the view
	    #;  Returns 1 if view is read-only, 0 if view is updatable
 
	    #;  Assume updatable to begin with...
 
	  set readonlyview=0
	  if $d($$$mtGroupDistinctRoot) QUIT 1  // GROUP BY or SELECT DISTINCT specified
	  if $d($$$mtHavingRoot) QUIT 1  // HAVING conditions specified
	  if $d(mt("union")) QUIT 1  // UNION specified
	  if $d($$$mtIntersectExceptRoot) QUIT 1  // INTERSECT or EXCEPT specified
	  if $$hasPagination^%qaqpsq() QUIT 1 // pagination specified: TOP/LIMIT/FETCH or OFFSET
	    #;  Make sure each output column is a field
	  set ok=1,m=$o($$$mtOutput("")),olist="" set:m olist=$$$mtOutputVals($$$mtOutput(m))
	  for i=1:1:$l(olist,",")-1 {
		set val=$p(olist,",",i)
		if $e($g($$$mtV(val)))="s" { set val=$p($$$mtV(val),"^",4) }
	  	if $e($g($$$mtV(val)))'="f" || ($d(dupchk(val))) || ($p($g($$$mtV(val)),"^",3,4)["->") { set ok=0 quit }
	  	set dupchk(val)=""
	  }
	  QUIT:'ok 1
	    #;  Make sure the query references only one table 
	  set sub="",tabcnt=0
		  #; PVA088: Consider streamed view case below, and also check for corresponding 
		  #;         absence of extent.
	  set m=1,extent="",ok=1
	  for  {
	  	set sub=$o($$$mtFromTableName(sub)) quit:sub=""  
	  	if +sub=m {
	  		if $e($$$mtFromTableName(sub),1,3)="%%Q" { set m=+$e($$$mtFromTableName(sub),4,*) continue  }
	  		else  { set extent=$$$GetExtentNameFromIQN($$$mtFromTableName(sub)) }
			    #;  Make sure each output column is a field (DPV3387+)
			// if no IUD target, count the table; if IUD target found, only count the table if it is the target
			if '$d($$$mtTarget)||($d($$$mtTarget)&&(" UPD INS DEL "[(" "_$$$mtStatementType_" "))&&(sub=$$$mtTarget)) { set tabcnt=tabcnt+1 }
			if m>1 {
				set olist=$$$mtOutputVals($$$mtOutput(m)) kill dupchk
				for i=1:1:$l(olist,",")-1 {
					set val=$p(olist,",",i)
					if $e($g($$$mtV(val)))="s" { set val=$p($$$mtV(val),"^",4) }
				  	if $e($g($$$mtV(val)))'="f" || ($d(dupchk(val))) || ($p($g($$$mtV(val)),"^",3,4)["->") { set ok=0 quit }
				  	set dupchk(val)=""
				}
				set extent=$$$GetExtentNameFromIQN($$$mtFromTableName(sub))
			}
	  	}
		quit:tabcnt>1||('ok)
	  } 
	  QUIT:tabcnt>1||(extent="")||('ok) 1  // More than 1 table in m=1
	  s extinfo=$$$EXTsqlinfo($$$rEXT,extent)
	  If $$$SQLLocTableReadOnly(extinfo)="Y" QUIT 1  // Read-only table	// DPV3116
	  	#;  Make sure FOR SOME not specified (EXISTS, NOT EXISTS, IN (SELECT..., FOR { SOME | ALL } ... ).  Also make sure =* not specified
	  set sub="",quit=0
	  for  {
		  set sub=$o($$$mtL(sub)) quit:sub=""
		  if $e($$$mtL(sub),1,10)="v^FOR SOME" || ($e($$$mtL(sub),1,4)="v^=*") { set quit=1 quit }
	  }
	  QUIT:quit 1 // PVA242
		// check all where clauses for subqueries
  	  set nextw=""
	  for { 
		set nextw=$o($$$mtWhere(nextw))
		QUIT:nextw=""
		for i=1:1 { 
			set val=$p($g($$$mtWhere(nextw)),"^",i) 
			QUIT:val=""
			RETURN:$$findtree(val,"q") 1 // not updatable since where clause involves a subquery
		}
	  }
	  	#;  Build a dependency list of tables and views
  	  set i="" 
	  for {
		set i=$o(mtc(0,0,"table",i),1,d) 
		QUIT:i=""  
		set:'$d($$$mtTarget)||($d($$$mtTarget)&&(i=$$$mtTarget)) depend($p(d,$c(1)),$p(d,$c(1),3))="" // if IUD target, only count the target table's dependency
	  }
	  set i=$o(depend(1,"")) 
	  QUIT:$o(depend(1,i))'="" 1  // View dependent on more than 1 table
  	  set i="" 
  	  for { 
  	  	set i=$o(depend(3,i)) 
		QUIT:i=""
  	  	set extent=$$$GetExtentNameFromIQN(i)
  	  	set extinfo=$$$EXTsqlinfo($$$rEXT,extent)
  	  	RETURN:$$$SQLLocViewUpdateable(extinfo)'=1 1 // Dependent on non-updatable view
  	  }
	  QUIT 0  // Query is not read-only, it is updatable
	}	// DPV1693-
.
findtree(val,evlist)  ;  search subtree of val for nodes of type evlist
	n call,found
	s found=0,call="evlist^%qaqcpr"
	do lvtree^%qaqpnl("l",val)
	QUIT found
.
	// Given the mt(), return a $List of table/view names used by this query
GetRelationList(&mt) [] PRIVATE {
	set return="",m=""
	for  {
		set m=$o($$$mtFLabelsQbNode(m)) quit:m=""
		continue:$d($$$mtQbHasForSomeElement(m))	// Ignore %ELEMENT pseudo-FROM item
		set label="" 
		for  {
			set label=$o($$$mtFLabelsSaveNode(m,label)) quit:label=""
			set qnumName=""
			for  {
				set qnumName=$o($$$mtFLabels(m,label,qnumName),1,i) quit:qnumName=""
				set i=$lg(i)	// i is now the IQN
				if $$$TableFromIQN(i)?1"tsq"1.n1"%" { continue }
				set:'$lf(return,i) return=return_$lb(i)
			}
		}
	}
	if $d($$$mtSaveFlbls) {
		set m=""	// And maybe any flbls saved from inssel^%qaqcmn
		for  {
			set m=$o(mt("saveflbls",m)) quit:m=""
			continue:$d($$$mtQbHasForSomeElement(m))	// Ignore %ELEMENT pseudo-FROM item
			set label="" 
			for  {
				set label=$o(mt("saveflbls",m,label)) quit:label=""
				set qnumName=""
				for  {
					set qnumName=$o(mt("saveflbls",m,label,qnumName),1,i) quit:qnumName=""
					set i=$lg(i)	// i is now the IQN
					if $$$TableFromIQN(i)?1"tsq"1.n1"%" { continue }
					set:'$lf(return,i) return=return_$lb(i)
				}
			}
		}
	}
	QUIT return
}
.
.
	// Given an mt() that might include mt("options"), return options we need for the SQL statement index hash
	//  Arguments:
	//	- mt :: passed by reference, input
	//	   mt() array
	// 
	// Return value:
	//   return string of options and values
	//
	// Called from:  comp^%qaqqt and GetSatementPlan^%qaqqt
CommentOptionsForHash(&mt) [] PRIVATE {
		#; If there are SQLCompileOptions defined, we may need to add these options to the sqlidxhash.
		#; Only some options are needed to be part of the hash.  Any option that only involve code generation decisions does not need to be in the hash.
		#; Options that determine actions within parsing, DDL lookup, pathselection, optimization, etc., need to be included in the hash.
		#; We will put any options defined into a single list item for the input to the hash.
		#; While fastfetch/fastSelect are really only needed for code generation, we also have to match the cached query container code generation with the generated SQL code,
		#; So we need to include xDBCfastfetch here
	set option="",return=""
	for  {
		set option=$o(mt("options",option),1,value) quit:option=""
			#; Don't need CompileSelectMode here because mt("sqlcomp") is already part of the statement index hash, don't need IsolationLevel as this will be in the normalized SQL anyway
		continue:($case(option,"xDBCIsoLevel":0,"xDBCfastFetch":0,"xDBCVarTypes":0,"DynamicSQLTypeList":0,"DML_PARALLEL":0,"collect-optimizer-output":0,"efSearch":0,"SQLRuntimeStats":0,"SQLRuntimeStatsPID":0,:1) 
					&& '(option?1"rtpc-"1.e))	// The list of comment options we need to include in the statement index for the hash
		if (option="rtpc-log-sel")||(option="rtpc-truth-value")||(option="rtpc-range")||(option="rtpc-list")||(option="rtpc-vdf"){
			set key="",value="" 
			for {
				set key=$O(mt("options",option,key),1,v) q:key=""
				set value=value_v	
			}
			set return=return_$lb(option,value)
		}
		else{
			set return=return_$lb(option,+value)	// May need to adjust this if we add non-numeric values to options needed by hash	
		}
		
	}
	QUIT return
	
}
.
	// Given an SQL statement in sql() of the form sql=#lines, sql(1)=line #1, etc.  
	//	- Find any /*#OPTIONS ... */ comment settings in the SQL text
	//  Arguments:
	//	- input :: passed by reference, input
	//	   array of SQL text in the form:
	//		sql = #lines
	//		sql(1) = line #1
	//		...
	//		sql(n) = line #n
	//	- comments :: passed by reference, output, array format
	//           comments(<option>) = value
	// 
	// Return value:
	//   None
	//
	// Called from:  comp^%qaqqt (before calling parser)
FindCommentOptions(&input,&comments) [backgrnd,c,callname,f,fsave,input,insdt,label,line,lineprev,logic,lower,m,mask,more,n,name,p,pprev,prevtoken,qr,rv,SQLCODE,sql,token,tt,val,value] PRIVATE {
 
	#; Sample Input:
	#; s input(1) = """aviel"" aviel.sas :vv from a"
	#; s input(2)="where f=4 and z=? order by 2 ff"
	#; s input(1) = "a"
	#; s input=2
	#; normsql() returns the normalized SQL input
	
	new c,callname,%delid,%context,%COSParse,f,fsave,%inMLComment,insdt,label,line,lineprev,pprev,prevtoken,logic,lower,m,mask,%mmmNoDelidCheck,more,n,name,%PythonParse,p,qr,rv,sql,token,tt,val,value
	new %compOptions,%compTags set %compOptions=0,%compTags=0
	set %mmmNoDelidCheck=1,maybeCOS=0,maybePython=0
	kill comments
	try {
		set hasoption=0
		for line=1:1  QUIT:'$d(input(line),sql)  if $zconvert(sql,"U")["*#OPTIONS" set hasoption=1 QUIT
		if 'hasoption RETURN ""
		set line=0,more=0,f=0,p=0,callname="info",sql=input,tt=0,jsonParen=0,%context=$system.Context.SQLCompile(),%delid=%context.DelimitedIdentifiers
		do first:'input
		set oldmask=$get(mask)
		do lext
		if token=$c(1) { set tReturn=$lb(input,"","") quit  }
			#; We only need this for statements that will be reported in the statement index. (no longer true)
		// if '$case(token,"SELECT":1,"DECLARE":1,"INSERT":1,"UPDATE":1,"DELETE":1,"CREATE":1,"TRAIN":1,"VALIDATE":1,:0) { RETURN "" }
		if $case(token,"CREATE":1,"ALTER":1,"GRANT":1,"REVOKE":1,"DROP":1,"SET":1,:0) {
			new %mmmNo28Check set %mmmNo28Check=1
			set:token="CREATE" maybeCOS=1,maybePython=1
		}
		for  {
			set lasttoken=token
			do lext
			if token="{",lasttoken="USING" {	// USING { <json> }, special parsing needed to handle ":" as not an hvar
				set %mmmJSONOBJECT=1
				set bracket=1
				for  {
					do lext
					quit:token=$c(1)
					set:token="{" bracket=bracket+1
					set:token="}" bracket=bracket-1
					if bracket=0 { kill %mmmJSONOBJECT quit }	// end of USING <json>
				}
			}
			quit:token=$c(1)
			Do JSONParm^%qaqpsq(token,$g(value),.jsonParen)
			set:maybeCOS&&(token="ID")&&((value="OBJECTSCRIPT")||(value="COS")) %COSParse=1,mask=$$MASK(sql)_$c(1)	// Reset mask for COS parser so "$", ":", "'", """" are included in mask
			set:maybePython&&(token="ID")&&(value="PYTHON") %PythonParse=1,mask=$$MASK(sql)_$c(1)  					// Reset mask for Python parser so "$", ":", "'", """" are included in mask
		}
		if $get(%COSParse) { kill %COSParse set mask=oldmask }
		if $get(%PythonParse) { kill %PythonParse set mask=oldmask }
		if %compOptions {
			for iter=1:1:%compOptions {
					#; first, create a temp dynamic object from the option json string.  This validates the json string in the comment and allows us to easily get the key/value pairs
				try { set json=##class(%Library.DynamicObject).%FromJSON(%compOptions(iter)) }
				catch { set jsonstring=%compOptions(iter) do error(153) }
				do decomposeJSON(json,.comments)
			}
		}
	}
	catch { }	// ignore any errors here.  A real error will be caught and reported by the parser, and it will get reported properly as the real parser is not an "info" compile.
	QUIT
}
.
decomposeJSON(json,%array) public {
	do decomposeJSONint(json,"%array")
}
.
decomposeJSONint(json,name) public {
	set iterator=json.%GetIterator()
	while iterator.%GetNext(.key,.value) {
		if $isobject(value) {
			do decomposeJSONint(value,$name(@name@(key)))
		} else {
			set @name@(key)=value
		}
	}
}
.
NormalizeSQL(&input,&normsql,&normsqlalt) [backgrnd,c,callname,f,fsave,input,insdt,label,line,lineprev,logic,lower,m,mask,maybeCOS,more,mt,n,name,p,pprev,prevtoken,qr,rv,SQLCODE,sql,token,tt,val,value] PUBLIC {
 
	#; Sample Input:
	#; s input(1) = """aviel"" aviel.sas :vv from a"
	#; s input(2)="where f=4 and z=? order by 2 ff"
	#; s input(1) = "a"
	#; s input=2
	#; normsql() returns the normalized SQL input
	#; normsqlalt() returns set of alternative normalized SQL with different options so we can find older frozen plan, may be blank if no alternative needed
	
	new c,callname,%compOptions,%compTags,%delid,%context,f,fsave,%inMLComment,insdt,label,line,lineprev,%mmmJSONOBJECT,%mmmNoDelidCheck,pprev,prevtoken,logic,lower,m,mask,maybeCOS,more,n,name,p,qr,rv,sql,token,tt,val,value
	set %compOptions=0,%compTags=0      // Don't want to define more %compOptions when just normalizing SQL
	set %mmmNoDelidCheck=1,maybeCOS=0,maybePython=0,value=""
	try {
		set line=0,more=0,f=0,p=0,callname="info",sql=input,tt=0,jsonCBrace=0,jsonParen=0,%context=$system.Context.SQLCompile(),%delid=%context.DelimitedIdentifiers
		kill normsql,normsqlalt set normsql=1,normsql(1)=""
		do first:'input
		set oldmask=$get(mask)
		do lext
		if token=$c(1) { set tReturn=$lb(input,"","") quit  }
		set tt=tt+1,tt(tt)=$lb(token,lower,value,%delid,$s("'"""'[$e(sql,f):1,1:0))
		if $case(token,"CREATE":1,"ALTER":1,"GRANT":1,"REVOKE":1,"DROP":1,"SET":1,:0) {
			new %mmmNo28Check set %mmmNo28Check=1
			set:token="CREATE" maybeCOS=1,maybePython=1
		}
		for  {
			do lext
			quit:token=$c(1)
				//TRW: Copied + modified from preparse^%qaqpreparser (should be unified!)
				//All we're doing is finding a "top level" JSON_OBJECT/JSON_ARRAY and pairing parens until we're back to 0.
				//While we're inside that top level expression, the alternative : syntax is allowed. How would this interact
				//with host variable expressions?
			Do JSONParm^%qaqpsq(token,value,.jsonParen,.jsonCBrace,$$statementTypeMightHaveUSING($g($$$mtStatementType)))
			set:maybeCOS&&(token="ID")&&((value="OBJECTSCRIPT")||(value="COS")) %COSParse=1,mask=$$MASK(sql)_$c(1)	// Reset mask for COS parser so "$", ":", "'", """" are included in mask
			set:maybePython&&(token="ID")&&(value="PYTHON") %PythonParse=1,mask=$$MASK(sql)_$c(1)  					// Reset mask for Python parser so "$", ":", "'", """" are included in mask
			set tt=tt+1,tt(tt)=$lb(token,lower,value,%delid,$s("'"""[$e(sql,f):1,1:0))
		}
		if $get(%COSParse) { kill %COSParse set mask=oldmask }
		if $get(%PythonParse) { kill %PythonParse set mask=oldmask }
		for i=1:1:tt {
			set token=$li(tt(i)),value=$lg(tt(i),3)
			if token="ID" {
				if value="JSON_OBJECT",'$d(jsonobject),$li($g(tt(i+1)),1)="(" { set jsonobject=0 }
				set normsql(normsql)=normsql(normsql)_$s($li(tt(i),4)=2:$$$SQLquoter(value),1:value)_" "
			}
			elseif token="(" {
				if $d(jsonobject) { set jsonobject=jsonobject+1 }
				set normsql(normsql)=normsql(normsql)_"( "
			}
			elseif token=")" {
				if $d(jsonobject) { set jsonobject=jsonobject-1 if 'jsonobject { kill jsonobject } }
				set normsql(normsql)=normsql(normsql)_") "
			}
			elseif token=9    { set normsql(normsql)=normsql(normsql)_$s($isvalidnum(value):value,value=$c(0):"''",1:"'"_$replace(value,"'","''")_"'")_" " }
			elseif token=":"  { do hvar }
			elseif token="'=" { set normsql(normsql)=normsql(normsql)_"<> " }
			elseif token="'<" { set normsql(normsql)=normsql(normsql)_">= " }
			elseif token="'>" { set normsql(normsql)=normsql(normsql)_"<= " }
			elseif token="'&" { set normsql(normsql)=normsql(normsql)_"NOT& " }
			elseif token="'!" { set normsql(normsql)=normsql(normsql)_"NOT! " }
			elseif token="'[" { set normsql(normsql)=normsql(normsql)_"NOT[ " }
			elseif token="']" { set normsql(normsql)=normsql(normsql)_"NOT] " }
			elseif token="_"  { set normsql(normsql)=normsql(normsql)_"|| " }
			elseif token="$$" { set normsql(normsql)=normsql(normsql)_"$$"_value_"( " }
			else              { set normsql(normsql)=normsql(normsql)_$$$UPPER(token)_" " }
			if $l(normsql(normsql))>8192 { set normsql(normsql)=$$$StripTrailingWhiteSpace(normsql(normsql)),normsql=normsql+1,normsql(normsql)="" }
		}
		set normsql(normsql)=$$$StripTrailingWhiteSpace(normsql(normsql))
.
			#; Comments are typically stripped out by the parsing.
			#; however, some user comments we want to retain so the comments can appear in the audit log or the statement index.  These comments are labeled as /*#TAG ... */
		for iter=1:1:%compTags {
			if normsql(normsql)'["--" {
				set normsql(normsql)=normsql(normsql)_" /*#TAG "_%compTags(iter)_" */"
			} else {
				do:iter=1 $i(inormsql)
				set normsql(normsql)=$g(normsql(normsql))_" /*#TAG "_%compTags(iter)_" */"
			}
		}
.
			#; Comments are typically stripped out by the parsing.
			#; however, some comment options we want to keep in the statement text - the ones that affect the SQL compilation before code generation.
			#; Others may be introduced in the future
		for iter=1:1:%compOptions {
				#; first, create a temp dynamic object from the option json string.  This validates the json string in the comment and allows us to easily get the key/value pairs
			try { set json=##class(%Library.DynamicObject).%FromJSON(%compOptions(iter)) }
			catch { set jsonstring=%compOptions(iter) do error(153) }
				#; Now iterate over the json object and set each value into the mt("option",key)=value
			do decomposeJSON(json,.options)
		}
		set optString="",altOptString=""
		if $d(options("IsolationLevel")) {
			set optString="""IsolationLevel"":"_options("IsolationLevel")
			if options("IsolationLevel")=0,'$d(options("xDBCIsoLevel")) set alternativeOptString($i(alternativeOptString))=""   ; If IsolationLevel:0 we need to find frozen plan with no isolation level too
		} else {
			if '$d(options("xDBCIsoLevel")) set alternativeOptString($i(alternativeOptString))="""IsolationLevel"":0"   ; If query has no isolation level then also find frozen plan for IsolationLevel:0
		}
		if $d(options("xDBCIsoLevel"))      { set optString=optString_$e(",",optString'="")_"""xDBCIsoLevel"":"_options("xDBCIsoLevel"),altOptString=altOptString_$e(",",altOptString'="")_"""xDBCIsoLevel"":"_options("xDBCIsoLevel") }
		if $d(options("xDBCfastFetch"))     { set optString=optString_$e(",",optString'="")_"""xDBCfastFetch"":"_options("xDBCfastFetch"),altOptString=altOptString_$e(",",altOptString'="")_"""xDBCfastFetch"":"_options("xDBCfastFetch") }
		if $d(options("CompileSelectMode")) { set optString=optString_$e(",",optString'="")_"""CompileSelectMode"":"_$$$quote(options("CompileSelectMode")),altOptString=altOptString_$e(",",altOptString'="")_"""CompileSelectMode"":"_$$$quote(options("CompileSelectMode")) }
		if $d(options("DML_PARALLEL"))      { set optString="""DML_PARALLEL"":"_options("DML_PARALLEL") }
		set rtpcOption = $O(options("rtpc-"))
		while (rtpcOption?1."rtpc-"1.e) {
			if (rtpcOption="rtpc-log-sel")||(rtpcOption="rtpc-truth-value")||(rtpcOption="rtpc-range")||(rtpcOption="rtpc-list")||(rtpcOption="rtpc-vdf"){
				set optString=optString_$e(",",optString'="")_""""_rtpcOption_""":["
				set altOptString=altOptString_$e(",",altOptString'="")_""""_rtpcOption_""":["
				set key=""
				for {
					set key=$O(options(rtpcOption,key),1,value) q:key=""
					set:key'=0 optString=optString_",",altOptString=altOptString_","
					set optString=optString_$$$quote(value),altOptString=altOptString_$$$quote(value)
				}
				set optString=optString_"]",altOptString=altOptString_"]"
			}
			else{
				set optString=optString_$e(",",optString'="")_""""_rtpcOption_""":"_$$$quote(options(rtpcOption))
				set altOptString=altOptString_$e(",",altOptString'="")_""""_rtpcOption_""":"_$$$quote(options(rtpcOption))
			}
			set rtpcOption = $O(options(rtpcOption))
		}
		for i=1:1:$g(alternativeOptString) {
			merge normsqlalt($i(normsqlalt))=normsql
			if altOptString'="" { set alternativeOptString(i)=alternativeOptString(i)_$e(",",alternativeOptString(i)'="")_altOptString }
			if alternativeOptString(i)'="" {
				set normsqlalt(normsqlalt,$i(normsqlalt(normsqlalt)))=" /*#OPTIONS {"_alternativeOptString(i)_"} */"
			}
		}
		if optString'="" {
			set normsql($i(normsql))=" /*#OPTIONS {"_optString_"} */"
		}
		if $d(options("DynamicSQLTypeList")) { 
			set optString="""DynamicSQLTypeList"":"_$$$quote(options("DynamicSQLTypeList"))
			set normsql($i(normsql))=" /*#OPTIONS {"_optString_"} */"
			#; Append to all normsqlalt items
			for i=1:1:+$g(normsqlalt) {
				set normsqlalt(i,$i(normsqlalt(i)))=" /*#OPTIONS {"_optString_"} */"
			}
		}
		if $d(options("xDBCVarTypes")) { 
			set optString="""xDBCVarTypes"":"_$$$quote(options("xDBCVarTypes"))
			set normsql($i(normsql))=" /*#OPTIONS {"_optString_"} */"
			#; Append to all normsqlalt items
			for i=1:1:+$g(normsqlalt) {
				set normsqlalt(i,$i(normsqlalt(i)))=" /*#OPTIONS {"_optString_"} */"
			}
		}
		if $d(options("collect-optimizer-output")) { set optString=optString_$e(",",optString'="")_"""collect-optimizer-output"":"_options("collect-optimizer-output")}
		// The SQLRuntimeStats and SQLRuntimeStatsPID options are used for hashing
		if $d(options("SQLRuntimeStats")) {
			set optString=optString_$e(",",optString'="")_"""SQLRuntimeStats"":"_options("SQLRuntimeStats")
		}
		if $d(options("SQLRuntimeStatsPID")) {
			set optString=optString_$e(",",optString'="")_"""SQLRuntimeStatsPID"":"_options("SQLRuntimeStatsPID")
		}
	}
	catch { ztrap $ze }
	RETURN
.
.
hvar	;	    See if the host variable is of the form var(<constant>).  If so, treat it as one item
	if $d(jsonobject) {	
		set normsql(normsql)=normsql(normsql)_":"
		RETURN
	}
	if $lg($g(tt(i+1)))="(",$lg($g(tt(i+2)))="9",$lg($g(tt(i+3)))=")" { set normsql(normsql)=normsql(normsql)_":"_value_"("_$li(tt(i+2),3)_") ",i=i+3 QUIT  }
	if $lg($g(tt(i+1)))="(",$lg($g(tt(i+2)))="ID",$lg($g(tt(i+3)))=")" { set normsql(normsql)=normsql(normsql)_":"_value_"("_$$quoter($li(tt(i+2),2))_") ",i=i+3 QUIT  }
		#;  See if the host variable is of the form oref.prop.  If so, treat it as one item
	if $lg($g(tt(i+1)))=".",$lg($g(tt(i+3)))'="(" { set normsql(normsql)=normsql(normsql)_":"_value_"."_$li(tt(i+2),2)_" ",i=i+2 QUIT  }
		#;  See if the host variable is of the form i%Prop or r%Prop.  If so, treat it as one item
	if value="i"||(value="r")&&($d(tt(i+1))) {
		if $lg($g(tt(i+1)))="ID",$e($lg($g(tt(i+1)),2))="%" { set normsql(normsql)=normsql(normsql)_":"_$li(tt(i),3)_$li(tt(i+1),2)_" ",i=i+1 QUIT  }
		if $$$SQLReservedWordForParsingContext(%context,$lg($g(tt(i+1)))),$e($lg($g(tt(i+1)),2))="%" { set normsql(normsql)=normsql(normsql)_":"_$li(tt(i),3)_$li(tt(i+1),2)_" ",i=i+1 QUIT  }
	}
			#;  See if the host variable is of the form oref.prop(...).  If so, treat it as one item
	if $lg($g(tt(i+1)))=".",$lg($g(tt(i+3)))="(" {
		set varref=$li(tt(i),3)_"."_$li(tt(i+2),2)_"("
		for j=i+4:1 {
			set:$lg($g(tt(j)))=9 varref=varref_$$quoter($li(tt(j),3))
			set:$lg($g(tt(j)))="," varref=varref_","
			if $lg($g(tt(j)))=")" { set varref=varref_")" quit  }
			quit:j=999999	// need to avoid inf loop
		}
		set normsql(normsql)=normsql(normsql)_":"_varref_" "
		set i=i+j
		QUIT
	}
	set normsql(normsql)=normsql(normsql)_":"_value_" "
	QUIT
}
.
.
	// Given an SQL Statement, strip the comments, but retain any /*#OPTIONS ... */ comments
	// Called from Prepare^%SYS.SQLSRV, but only for the statements that we retain in the cache
stripComments(&input,&saveSqlText) [backgrnd,c,callname,f,fsave,input,insdt,label,line,lineprev,logic,lower,m,mask,maybeCOS,more,mt,n,name,p,pprev,prevtoken,qr,rv,SQLCODE,sql,token,tt,val,value] PUBLIC {
 
	#; Sample Input:
	#; s input(1) = """aviel"" aviel.sas :vv from a"
	#; s input(2)="where f=4 and z=? order by 2 ff"
	#; s input(1) = "a"
	#; s input=2
	#; normsql() returns the normalized SQL input
	#; normsqlalt() returns set of alternative normalized SQL with different options so we can find older frozen plan, may be blank if no alternative needed
	
	new c,callname,%compOptions,%compTags,%delid,%context,f,fsave,%inMLComment,insdt,label,line,lineprev,%mmmJSONOBJECT,%mmmNoDelidCheck,pprev,prevtoken,logic,lower,m,mask,maybeCOS,more,n,name,p,qr,rv,sql,token,tt,val,value
	set %compOptions=0,%compTags=0
	set %mmmNoDelidCheck=1,maybeCOS=0,maybePython=0,value=""
	try {
		set line=0,more=0,f=0,p=0,callname="info",sql=input,tt=0,jsonCBrace=0,jsonParen=0,%context=$system.Context.SQLCompile(),%delid=%context.DelimitedIdentifiers
		kill saveSqlText merge saveSqlText=input
		set normsql=1,normsql(1)=""
		do first:'input
		set oldmask=$get(mask)
		do lext
		if token=$c(1) { set tReturn=$lb(input,"","") RETURN  }
		set tt=tt+1,tt(tt)=$lb(token,lower,value,%delid,$s("'"""'[$e(sql,f):1,1:0))
		for  {
			do lext
			quit:token=$c(1)
				//TRW: Copied + modified from preparse^%qaqpreparser (should be unified!)
				//All we're doing is finding a "top level" JSON_OBJECT/JSON_ARRAY and pairing parens until we're back to 0.
				//While we're inside that top level expression, the alternative : syntax is allowed. How would this interact
				//with host variable expressions?
			Do JSONParm^%qaqpsq(token,value,.jsonParen,.jsonCBrace,$$statementTypeMightHaveUSING($g($$$mtStatementType)))
			set tt=tt+1,tt(tt)=$lb(token,lower,value,%delid,$s("'"""[$e(sql,f):1,1:0))
		}
		for i=1:1:tt {
			set $lg(token,lower,value,delid)=tt(i)
			if token="ID" {
				if value="JSON_OBJECT",'$d(jsonobject),$li($g(tt(i+1)),1)="(" { set jsonobject=0 }
				set normsql(normsql)=normsql(normsql)_$s(delid=2:$$$SQLquoter(lower),1:lower)_" "
			}
			elseif token="(" {
				if $d(jsonobject) { set jsonobject=jsonobject+1 }
				set normsql(normsql)=normsql(normsql)_"( "
			}
			elseif token=")" {
				if $d(jsonobject) { set jsonobject=jsonobject-1 if 'jsonobject { kill jsonobject } }
				set normsql(normsql)=normsql(normsql)_") "
			}
			elseif token=9    { set normsql(normsql)=normsql(normsql)_$s(value?1.n1"e"1.n:"'"_value_"'",$isvalidnum(value):value,value=$c(0):"''",1:"'"_$replace(value,"'","''")_"'")_" " }
			elseif token=":"  { do hvar }
			elseif token="'=" { set normsql(normsql)=normsql(normsql)_"<> " }
			elseif token="'<" { set normsql(normsql)=normsql(normsql)_">= " }
			elseif token="'>" { set normsql(normsql)=normsql(normsql)_"<= " }
			elseif token="'&" { set normsql(normsql)=normsql(normsql)_"NOT& " }
			elseif token="'!" { set normsql(normsql)=normsql(normsql)_"NOT! " }
			elseif token="'[" { set normsql(normsql)=normsql(normsql)_"NOT[ " }
			elseif token="']" { set normsql(normsql)=normsql(normsql)_"NOT] " }
			elseif token="_"  { set normsql(normsql)=normsql(normsql)_"|| " }
			elseif token="$$" { set normsql(normsql)=normsql(normsql)_"$$"_value_"( " }
			else              { set normsql(normsql)=normsql(normsql)_$$$UPPER(token)_" " }
			if $l(normsql(normsql))>8192 { set normsql(normsql)=$$$StripTrailingWhiteSpace(normsql(normsql)),normsql=normsql+1,normsql(normsql)="" }
		}
		set normsql(normsql)=$$$StripTrailingWhiteSpace(normsql(normsql))
.
			#; Comments are typically stripped out by the parsing.
			#; however, some user comments we want to retain so the comments can appear in the audit log or the statement index.  These comments are labeled as /*#TAG ... */
		for iter=1:1:%compTags {
			if normsql(normsql)'["--" {
				set normsql(normsql)=normsql(normsql)_" /*#TAG "_%compTags(iter)_" */"
			} else {
				do:iter=1 $i(inormsql)
				set normsql(normsql)=$g(normsql(normsql))_" /*#TAG "_%compTags(iter)_" */"
			}
		}
			#; Comments are typically stripped out by the parsing.
			#; however, some comment options we want to keep in the statement text - the ones that affect the SQL compilation before code generation.
			#; Others may be introduced in the future
		for iter=1:1:%compOptions {
			if normsql(normsql)'["--" {
				set normsql(normsql)=normsql(normsql)_" /*#OPTIONS "_%compOptions(iter)_" */"
			} else {
				do:iter=1 $i(inormsql)
				set normsql(normsql)=$g(normsql(normsql))_" /*#OPTIONS "_%compOptions(iter)_" */"
			}
		}
	}
	catch {
		// if there are any errors, we don't care, just leave the comments in
		kill input merge input=saveSqlText
	}
	kill input merge input=normsql
	RETURN
.
.
hvar	;	    See if the host variable is of the form var(<constant>).  If so, treat it as one item
	if $d(jsonobject) {	
		set normsql(normsql)=normsql(normsql)_":"
		RETURN
	}
	if $lg($g(tt(i+1)))="(",$lg($g(tt(i+2)))="9",$lg($g(tt(i+3)))=")" { set normsql(normsql)=normsql(normsql)_":"_value_"("_$li(tt(i+2),3)_") ",i=i+3 QUIT  }
	if $lg($g(tt(i+1)))="(",$lg($g(tt(i+2)))="ID",$lg($g(tt(i+3)))=")" { set normsql(normsql)=normsql(normsql)_":"_value_"("_$$quoter($li(tt(i+2),2))_") ",i=i+3 QUIT  }
		#;  See if the host variable is of the form oref.prop.  If so, treat it as one item
	if $lg($g(tt(i+1)))=".",$lg($g(tt(i+3)))'="(" { set normsql(normsql)=normsql(normsql)_":"_value_"."_$li(tt(i+2),2)_" ",i=i+2 QUIT  }
		#;  See if the host variable is of the form i%Prop or r%Prop.  If so, treat it as one item
	if value="i"||(value="r")&&($d(tt(i+1))) {
		if $lg($g(tt(i+1)))="ID",$e($lg($g(tt(i+1)),2))="%" { set normsql(normsql)=normsql(normsql)_":"_$li(tt(i),3)_$li(tt(i+1),2)_" ",i=i+1 QUIT  }
		if $$$SQLReservedWordForParsingContext(%context,$lg($g(tt(i+1)))),$e($lg($g(tt(i+1)),2))="%" { set normsql(normsql)=normsql(normsql)_":"_$li(tt(i),3)_$li(tt(i+1),2)_" ",i=i+1 QUIT  }
	}
			#;  See if the host variable is of the form oref.prop(...).  If so, treat it as one item
	if $lg($g(tt(i+1)))=".",$lg($g(tt(i+3)))="(" {
		set varref=$li(tt(i),3)_"."_$li(tt(i+2),2)_"("
		for j=i+4:1 {
			set:$lg($g(tt(j)))=9 varref=varref_$$quoter($li(tt(j),3))
			set:$lg($g(tt(j)))="," varref=varref_","
			if $lg($g(tt(j)))=")" { set varref=varref_")" quit  }
			quit:j=999999	// need to avoid inf loop
		}
		set normsql(normsql)=normsql(normsql)_":"_varref_" "
		set i=i+j
		QUIT
	}
	set normsql(normsql)=normsql(normsql)_":"_value_" "
	RETURN
}
.
/// Return 1 if the statement type (see e.g. GetType^%SYS.SQLSRV) is one that could have a USING clause
statementTypeMightHaveUSING(statementType="") [] {
	RETURN $case(statementType,"LOAD":1,"CMDL":1,"AMDL":1,"TMDL":1,"CMLCONFIG":1,"AMLCONFIG":1,"CRSV":1,"ALSV":1,"CRFT":1,:0)
}
.
///  Given a $listbuild of package names, returns $listbuild of default schema names
Packages(packages="") [] {
		#; If this is a cached query class we don't want the default schema to be controled by the package name of the cached query class.
	set:packages'=""&&($ll(packages)=1)&&($$$CACHEDSTATEMENT($lg(packages))) packages=""	// DPV4002
	if packages="" { set defschema=$lb($$$DEFAULTSCHEMAVAR(defschema)) }
	else {
		set defschema="",schema=""
		for i=1:1:$ll(packages) {
			set package=$lg(packages,i) 
			if package'="" {
				set schema=$g($$$PACKAGEsqlname(package))
				if schema="",package="User" { s schema="SQLUser" }
				elseIf schema="" { set schema=$tr(package,".","_") }
			}
			set:schema=""||($$$UPPER(schema)="%%DEFAULTSCHEMA") schema=$$$DEFAULTSCHEMAVAR(schema)
			set defschema=defschema_$lb($$$UPPER(schema))
		}
		kill package,schema
	}
	QUIT defschema
}
.
	// Given an SQL statement in sql() of the form sql=#lines, sql(1)=line #1, etc.  
	//	- Normalize the SQL
	//	- Lookup the statement in the statement index
	//	- Retrieve the frozen plan if one exists.
	//  Arguments:
	//	- sql :: passed by reference, input
	//	   array of SQL text in the form:
	//		sql = #lines
	//		sql(1) = line #1
	//		...
	//		sql(n) = line #n
	//	- packages :: passed by value, input
	//	   A $List of class package names to turn into a current schema(s) list.  If %defschema is passed in, this is ignored
	//	- plan :: passed by reference, output
	//	   Return values for plan:
	//           -1 == Statement plan found, but err node is defined, so plan not usable
	//            0 (or <UNDEFINED>) == No frozen plan found
	//           >0 == plan found and is returned in the plan() array
	//	- sqlcomp  :: passed by value, input
	//	   Value from mt("sqlcomp"), something like %Runtime, %ODBC, %FDBMS, etc.
	//	- %sqlSchemaPath :: passed by value, input, optional
	//	   Schema search path used for unqualified names
	//	- %defschema :: passed by value, input, optional
	//	   $lb(schema-names) that are the default schemas for this statement. Could be derived from packegs list if packages are supplied
	//	- error :: passed by reference, output
	//         String that contains error information if GetStatementPlan encounters an error
	// 
	// Return value:
	//   Returns the hash of the SQL Statement Index, or NULL ("") if no index entry or index with no plan was found
	//
	// Called from:  fplan^%qaqplansave
GetStatementPlan(&sql,packages="",&plan,sqlcomp="",%sqlSchemaPath="",%defschema="",&error,&planVersion)
	
	try {
		kill error,plan
		//new callname,%delid,extab,extb,federated,fplan,fsave,gtag,I,ib,impjns,info,infocnt,%inssel,jj,l1,lcval,m1,maxm,maxv,mcurs,$$$MSQLModuleTag,%msg,%msqlvar,mt,mtag,mtc,node,noindexmap,ptfjoo,ptfjoos,ptj,ptlikeimp,%ptrel,rtname,selinfo,SQLCODE,%sqlColPriv,sqlline1,sqlvarsThisStatement,str,tHash,V,v,valins,%viewinfo,where,zh2
		new planerror,planinfo,str,tHash,normsqlalt
		set tHash="",planVersion=""
		if %defschema="" { set %defschema=$$Packages(packages) }
		
			#;  Get the hash for this embedded SQL statement.  This hash will be used in error reporting to link to the text of the SQL statement
			#;  I don't know if the statement is fully qualified or not.  So I will look up using a hash that assumes the statement is fully qualified, and if that
			#;  is not found I will look up using a hash that includes the %sqlSchemaPatch and %defschema
		do NormalizeSQL(.sql,.%normsql,.normsqlalt)
		set str=$lb(sqlcomp)
		if ($$$ANSIPrecedence=1) set str = str _ $listbuild(1)
.
			#; If there are SQLCompileOptions defined, we may need to add these options to the sqlidxhash.
			#; Only some options are needed to be part of the hash.  Any option that only involve code generation decisions does not need to be in the hash.
			#; Options that determine actions within parsing, DDL lookup, pathselection, optimization, etc., need to be included in the hash.
			#; We will put any options defined into a single list item for the input to the hash.
		new commentOptionsForhash
		if $d(mt("options")) {
			set commentOptionsForhash=$$CommentOptionsForHash(.mt)
			set str=str_commentOptionsForhash
		}
		set tHash=$$Hash^%SYS.SQLSRV(str,.%normsql)
			// lookup statement index using hash for plan, if found we are done, if not try using hash for fully qualified statement
		if '$d($$$SQLIndex(1,tHash)) {
			new qualifiedstr
			set qualifiedstr=$li(str,1,1)_$lb($g(%sqlSchemaPath),%defschema)_$li(str,2,*)
			set tHash=$$Hash^%SYS.SQLSRV(qualifiedstr,.%normsql)		// Check for Statement index using %sqlSchemaPath/%defschema
			#; SQL Statement not found so try alternative formulations from normsqlalt to see if any of these match
			if '$d($$$SQLIndex(1,tHash)) {
				set tHash=""
				new i,normalt
				for i=1:1:$g(normsqlalt) {
					kill normalt merge normalt=normsqlalt(i)
					set tHash=$$Hash^%SYS.SQLSRV(str,.normalt)
					if $d($$$SQLIndex(1,tHash)) QUIT
					set tHash=$$Hash^%SYS.SQLSRV(qualifiedstr,.normalt)
					if $d($$$SQLIndex(1,tHash)) QUIT
					set tHash=""
				}
			}
		}
		quit:tHash=""	// Statement not found in index
		
			#; The plan is defined, we need to see if this plan's version is older than our current version.
			#; If so, and the plan is not already frozen, freeze the plan.
			#; This means upon upgrade, when a query is recompiled, it will continue to use the same plan as the previous version
			#; until it is unfrozen.  This prevents upgrading customers from degrades in performance due to plan choice
		set planinfo=$g($$$SQLIndex(1,tHash,"planinfo"))
		if planinfo="" { set tHash="" quit  }	// should never happen, but just to be safe...
		if $lg(planinfo,1)=""||($lg(planinfo,3)="") { set tHash="" quit }	// most likely not a SELECT statement with only a timestamp stored in planinfo
		
		new sysVersion
		set planVersion=$p($p($lg(planinfo,3),") ",2)," ",1)	// same logic used in $SYSTEM.Version.GetNumber()
		set sysVersion=$p($p($zv,") ",2)," ",1)
		
		if $case($lg(planinfo,1),1:1,2:1,:0) {		// plan is Frozen/Upgrade or Frozen/Explicit
			if $$HasExternalTable^%SYS.SQLSRV(tHash) { 	// It has an external table, unfreeze it.  We don't support frozen plans for statements against external tables
				if $$UnfreezePlan^%SYS.SQLSRV(tHash,,.SQLCODE,.%msg)
				set tHash=""
			}
			elseif $$$mtStatementType="INS",planVersion<2017.1 {	// INSERT...SELECT statement for version prior to 2017.1, put plan in an error state
				if '$$UpdateSQLIndex^%SYS.SQLSRV(tHash,"Frozen plan metadata for INSERT/SELECT statement frozen prior to version 2017.1 potentially incorrect. Must unfreeze and then re-freeze if wanted frozen.") {
					set error="Error attempting to save error into statement plan:  SQLCODE="_$g(SQLCODE)_", %msg="_$g(%msg)
				}
				set tHash=""
			}
		}
		
		if $case($lg(planinfo,1),0:1,3:1,:0) { 	// plan is Unfrozen or Unfrozen/Parallel
				// check version
				//   But only define as Frozen/Upgrade if AdaptiveMode=0
			if planVersion'="",planVersion<sysVersion,'$$$AdaptiveMode {
					#; DPV4946:
					#; If this is an INSERT/SELECT statement plan from prior to 2017.1, do not freeze on upgrade.
					#; The plan metadata may not be correct (DPV4945 fixed the metadata)
				if $$$mtStatementType="INS",planVersion<2017.1 { set tHash="" }
					#; plan was defined using an older version, freeze the plan
				elseif ('$$HasExternalTable^%SYS.SQLSRV(tHash)) && ($$FreezePlan^%SYS.SQLSRV(tHash,2,.SQLCODE,.%msg)) {	// freeze was successful, as long as the plan is not in error state, return the plan
					if $g($$$SQLIndex(1,tHash,"err"))'="" { set tHash="" } 		// don't return hash if plan is in error state
					else { merge plan=$$$SQLIndex(1,tHash,"plan") }
				}
				else { set tHash="" }
			}
			else {	// plan is not frozen, and there was no upgrade
				set tHash=""
			}
		}
		else {		// plan is frozen, either Frozen/Explicit or Frozen/Upgrade
			set planerror=$g($$$SQLIndex(1,tHash,"err"))
			if planerror'="" {
					// if we are in a soft error state, clear error and attempt to use it.
				if $e(planerror,1,12)="[Soft Error]" {
					if '$$UpdateSQLIndex^%SYS.SQLSRV(tHash,"") { set error="Error attempting to clear error from statement plan:  SQLCODE="_$g(SQLCODE)_", %msg="_$g(%msg),tHash="" }	// Got an error trying to clear the error
					else { merge plan=$$$SQLIndex(1,tHash,"plan") }
				}
				else {	// hard error, can't use the plan, clear the hash
					set tHash=""
				}
			}
			else { merge plan=$$$SQLIndex(1,tHash,"plan") }		// plan frozen, and not in error
		}
	}
	catch {	//
		set error="Unexpected error in GetStatementPlan^%qaqqt:  "_$ze
	}
	QUIT tHash
.
	// Given an privilege information recorded during query processing in mtc(0,0,...), return a list of privileges needed to execute this statement.
	// This will be recorded in the statement index, and used to determine if the user can see the entry in the statement index or not.
	// This privilege information will not be presented to the user in the SMP UI for the statement or in the INFORMATION_SCHEMA.STATEMENTS catalog.
	//
	//  Arguments:
	//	- mtc :: passed by reference, input
	//	   array containing statement metadata needed to determine privilege info
	//	- privs :: passed by reference, output
	//	   array containing privilege inormation for the statement
	// 
	// Return value:
	//   NONE
	//
StatementPrivs(&mtc,&privs) [mt] PRIVATE {
	try {
		set actlist=$case($$$mtStatementType,"DEC":"s","SEL":"s","INS":"i","UPD":"u","DEL":"d",:"")
		quit:actlist=""
		set tab="",prev=""
.
			#;  If this is an INSERT OR UPDATE, make sure we add "u" to the actlist
		set:$d(mtc(0,0,"update privs"))&&(actlist'["u")&&(actlist["i") actlist=actlist_",u"
.
		if $d(mtc(0,0,"view iud priv"),iqn) {
			for jj=1:1 {
				set tab=$o(mtc(0,0,"table",tab),-1) quit:tab=""
				if tab["^",prev'["^",prev'="" quit
				set prev=tab,ttype=+mtc(0,0,"table",tab),rel=$p(mtc(0,0,"table",tab),$c(1),3) 
				continue:rel'=iqn
				quit:(+ttype=0||(rel=""))
				for ii=1:1 {
					set act=$p(actlist,",",ii) quit:act=""  
					if act'="s" { 
						set fields=$g(mtc(0,0,"table",tab,"priv",act,"fields"))
						set ptr=0
						while $listnext(fields,ptr,field) { s:'$lf($g(privs(ttype_","_rel,act)),field) privs(ttype_","_rel,act)=$g(privs(ttype_","_rel,act))_$lb(field) }
					}
				}
			}
			set prev=""
		}
		
			#;  SELECT privileges
		if $d(mtc(0,0,"select privs")) {
			set jj=""
			for  {
				set tab=$o(mtc(0,0,"select privs",tab),1,fields) quit:tab=""
					#; If there is a "realname" node defined, we want to check privs on the real name, not the tab name (this is a sharded table)
				if $d(%qinfo("select privs",tab,"realname"),tabe) {}
				else { set tabe=$$$GetExactIQNFromIQN(tab) }  // Int Qualified exact case name
				continue:tabe=""  	// *** error?
				continue:tabe="%TSQL_sys.snf"	// DPV3196
				set ttype=$$$GetTableTypeFromIQN(tab)
				set:actlist'["s" actlist=actlist_",s"
				set ptr=0
				while $listnext(fields,ptr,field) { set:'$lf($g(privs(ttype_","_tabe,"s")),field) privs(ttype_","_tabe,"s")=$g(privs(ttype_","_tabe,"s"))_$lb(field) }
				set:'$d(privs(ttype_","_tabe,"s")) privs(ttype_","_tabe,"s")=""
			}
		}
.
			#;  INS/UPD/DEL privileges
		if '$d(mtc(0,0,"inssel")),'$d(mtc(0,0,"view iud priv")) {
			for jj=1:1 {
				set tab=$o(mtc(0,0,"table",tab),1) quit:tab=""
				if tab["^",prev'["^",prev'="" quit
				set prev=tab,ttype=+mtc(0,0,"table",tab)
				set rel=$p(mtc(0,0,"table",tab),$c(1),10)	// Shard Master Table Name (in case this is a sharded table)
				set:rel="" rel=$p(mtc(0,0,"table",tab),$c(1),3)  // Not a sharded table, use actual name
				quit:(+ttype=0||(rel=""))
				for ii=1:1 {
					set act=$p(actlist,",",ii) quit:act=""  
					if act'="s" {
						set fields=$g(mtc(0,0,"table",tab,"priv",act,"fields"))
						set ptr=0
						while $listnext(fields,ptr,field) { set:'$lf($g(privs(ttype_","_rel,act)),field) privs(ttype_","_rel,act)=$g(privs(ttype_","_rel,act))_$lb(field) }
						set:'$d(privs(ttype_","_rel,act)) privs(ttype_","_rel,act)=""
						if act="i"&&($d(mtc(0,0,"table",tab,"priv","u","fields"))) {	// DPV4086 INSERT OR UPDATE
							set ptr=0 
							while $listnext(fields,ptr,field) { set:'$lf($g(privs(ttype_","_rel,"u")),field) privs(ttype_","_rel,"u")=$g(privs(ttype_","_rel,"u"))_$lb(field) }
							set:'$d(privs(ttype_","_rel,"u")) privs(ttype_","_rel,"u")=""
						}
					}
				}
				q 	//:'ok - just go through loop once
			}
		}
		elseif '$d(mtc(0,0,"view iud priv")),$d(mtc(0,0,"inssel")) {	// INSERT ... SELECT - special case, just check INSERT priv on first table
			set tab=mtc(0,0,"inssel")	// this is the iqn of the table/view we are inserting into
			set ttype=$$$GetTableTypeFromIQN(tab)
			set rel=$$$GetExactIQNFromIQN(tab) 
			if ttype=1,rel'="" {	// ttype=3 is check above in "view iud priv" section
				for ii=1:1 {
					set act=$p(actlist,",",ii) quit:act=""  
					if act'="s" {
						set fields=$g(mtc(0,0,"table","1^"_tab,"priv",act,"fields"))
						set ptr=0
						while $listnext(fields,ptr,field) { set:'$lf($g(privs(ttype_","_rel,act)),field) privs(ttype_","_rel,act)=$g(privs(ttype_","_rel,act))_$lb(field) }
						set:'$d(privs(ttype_","_rel,act)) privs(ttype_","_rel,act)=""
					}
				}
			}
		}
	}
	catch {
		ztrap $ze
	}
}
.
	// Push the contents of $$$smd on a stack.  We use %0SQLCompileLevel as the stack level as this is also the level of recursion
pushsmd(pushreason=1) [] PUBLIC {
	merge ^||%sql.smdstack(%0SQLCompileLevel)=$$$smdRoot
	set i=$zu(68,28,0) kill $$$smdRoot do $zu(68,28,i)
	set %smdpushed=pushreason
	QUIT
}
.
	// Pop the contents of $$$smd from a stack.  We use %0SQLCompileLevel as the stack level as this is also the level of recursion
popsmd() [] PUBLIC {
	set i=$zu(68,28,0)
	kill $$$smdRoot
	merge $$$smdRoot=^||%sql.smdstack(%0SQLCompileLevel)
	kill ^||%sql.smdstack(%0SQLCompileLevel)
	do $zu(68,28,i)
	set %smdpushed=0
	QUIT
}
.
	// Push any existing %0SQLCompileLevel("proot") metadata on a stack
pushPRoot(hash) PUBLIC {
	if '$d(%0SQLCompileLevel("proot")) { set %0SQLCompileLevel("proot")=hash }
	else {
		set %0SQLCompileLevel("proot stack",$i(%0SQLCompileLevel("proot stack")))=%0SQLCompileLevel("proot")
		set %0SQLCompileLevel("proot")=hash
		set %prootpush=1
	}
	QUIT
}
.
	// Pop a level off the %0SQLCompileLevel("proot stack")
popPRoot() PUBLIC {
	if '$g(%0SQLCompileLevel("proot stack")) { QUIT }	// nothing to pop, should this error happen?  I don't think so.  Report error???
	set %0SQLCompileLevel("proot")=%0SQLCompileLevel("proot stack",%0SQLCompileLevel("proot stack"))
	kill %0SQLCompileLevel("proot stack",%0SQLCompileLevel("proot stack"))
	set %0SQLCompileLevel("proot stack")=%0SQLCompileLevel("proot stack")-1
	QUIT
}
.
	// Given an mtc() array, kill off any mtc(mcurs,"f") nodes
	// This is done when we have to kill $$$smdRoot and the irns defined in mtc(mcurs,"f") are no longer defined
killmtcfNodes(&mtc) [] {
	set mcurs=""
	for  { set mcurs=$o(mtc(mcurs)) quit:mcurs=""  kill:mcurs mtc(mcurs,"f") }
	QUIT
}
.
#INCLUDE %qaqplex
#include %quoter
.
---
