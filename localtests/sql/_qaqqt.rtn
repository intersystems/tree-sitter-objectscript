	set:$d(commentOptions("DML_PARALLEL"),topt)=1 mt("options","DML_PARALLEL")=topt
	set:$d(commentOptions("DynamicSQLTypeList"),topt)=1 mt("options","DynamicSQLTypeList")=topt
	set:$d(commentOptions("IsolationLevel"),topt) mt("options","IsolationLevel")=topt
