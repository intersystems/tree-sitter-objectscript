%urmac(rtname,nofilesw,vendor,msgs,nosyntax,wrtref,success,ssmodule,nullparm,expcomm,%msqlvar,%msqlrpc,topomscost,splitsql,qstruct,%caller="",rmaptype="MAC",%rmap=1,%multiRoutines=0)
	;; COMPONENTS :: IRIS/MPP
	#; 
1 g 1^%qarmac
 
LINES(inref,outref,tagchar,msgs,errflag,nosyntax,wrtref,savemacs,skipobjsyn,%symtab,mtc,sqlvars,rtname,classlist,qstruct,rmaptype="MAC",%rmap=0,success)
	g LINESe^%qarmac
 
find(str,chars,start,end) g finde^%qarmac
