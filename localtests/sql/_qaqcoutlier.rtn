====
qaqcoutlier
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqcoutlier^MAC^^^0
%qaqcoutlier	// (Outlier Utilities) (Jonathan Levinson 2017)
	;; COMPONENTS :: SQL/CodeGeneration/RTPC
	#;
#IF 0   ;-------------------------------------------------------------
	; Description:   Utilities to help generate run-time stubs for run-time plan choice for outliers
	; Author:        Jonathan Levinson
	; Date Started:  April 01, 2017
	;
	; JSL5059   (04/12/2017) - Make compiling and creating RTU be in-line and do proper locking and transactional stuff
	; JSL5054   (04/01/2017) - made from %qaqoutlier with modifications to generate code from asl
	; JSL5032	(02/13/2017) - generation of run-time plan choice stubs for outliers
#ENDIF
.
#include %sySystem
#INCLUDE %occInclude
#INCLUDE %SYS.DBSRV
.
DetectOutliers(infoComp,queryType=0,sqlvarcparm="",&outlier)[ mt,call,m,opflag,pti,v,val,str,fval,log,tag,vList,output,ptv,linx,mod,sqline,rtpcHelperCode,cls,clst,li,list,k,x,logs,range,partitionByLogs,lines,line,cgc] PUBLIC {
	set output=0,linx=""
	set:queryType=-2 queryType=2
	Goto:'infoComp endFurtherComp 
	// do some further analysis in mt
	f fval=1:1:$$$maxv s v=$$$mtV(fval), str = 0 d:"f"=$e(v) field^%qaqpqo
	f m=1:1:$$$mtPNumQbs {set:(($g($$$mtWhere(m))'="")&&($e($$$mtWhere(m),*)'="^")) $$$mtWhere(m)=$$$mtWhere(m)_"^" s logs=$g($$$mtWhere(m)) f lgi=1:1 { s log=$p(logs,"^",lgi) q:log=""  d where^%qaqpqo(.logs,log,.lgi) } s:$d($$$mtWhere(m)) $$$mtWhere(m)=logs }
	f m=1:1:$$$mtPNumQbs { s logs=$g($$$mtPartitionPredicates(m)) f lgi=1:1 { s log=$p(logs,"^",lgi) q:log=""  d where^%qaqpqo(.logs,log,.lgi) } if $d($$$mtPartitionPredicates(m)) {f lgi=1:1 { s log=$p(logs,"^",lgi) q:log=""  set partitionByLogs(log)="" }} }
	f m=1:1:$$$mtPNumQbs s logs=$g($$$mtWhere(m)) f lgi=1:1 s log=$p(logs,"^",lgi) q:log=""  d or2in^%qaqpqo
	for m=1:1:$$$mtPNumQbs { 
		set i="",skip=0
		for {
			set i=$o($$$mtOn(m, i),1,xa) q:i=""
			set logs=$li(xa,2)
			for lgi=1:1 { s log=$p(logs,"^",lgi) q:log=""  d where^%qaqpqo(.logs,log,.lgi) }
			set $li($$$mtOn(m, i),2)=logs
			if $li(xa,1)'="INNER" set skip=1
		}
		if 'skip {
			set i=""
			for {
				set i=$o($$$mtOn(m, i),1,xa) q:i=""
				set $$$mtWhere(m)=$g($$$mtWhere(m))_$li(xa,2)
				kill $$$mtOn(m, i)
			}
		}
	}
	f log=1:1:$$$maxl s v=$$$mtL(log) i $e(v)="v","'<'>%STARTSWITH']'="[$p($p(v,"^",2),"%NOINDEX") d logfn^%qaqpqo // PVA242
	f log=1:1:$$$maxl s v=$$$mtL(log) i $p($p(v,"^",2),"%NOINDEX")="IN"||($p($p(v,"^",2),"%NOINDEX")="INSET") s fn=$$ddfun^%qaqpqo($p(v,"^",4)) f pi=4:1:$l(v,"^")-1 if '($p($p(v,"^",2),"%NOINDEX")="INSET"&&(pi>5)) s $p($$$mtL(log),"^",pi)=$$coll^%qaqpqo($p(v,"^",pi),fn) // take care of collation
	f val=1:1:$$$maxv d createval^%qaqpdt(val) ; set up the vtr objects, xformCond needs this step
	f log=1:1:$$$maxl d createlog^%qaqpdt(log)
	
	f m=1:1:$o($$$mtP(""),-1) d:$g($$$mtL(+$g($$$mtWhere(m))))'="" lflds^%qaqpnl("l",$g($$$mtWhere(m)),"do") ; populate $P(3),xformCond and conds needs this step
	
	f m=1:1:$$$mtPNumQbs {
		s logs=$g($$$mtWhere(m))
		f lgi=1:1:$l(logs,"^")-1{
			s log=$p(logs,"^",lgi)
			d xformCond^%qaqpnl(log,m)
		}	
	}
	for m=1:1:$$$mtPNumQbs { 
		s logs=$g($$$mtWhere(m)) f  s log=+logs,logs=$p(logs,"^",2,*) q:'log  d:$e($g($$$mtL(log),"i"))'="i" conds^%qaqpnl
		f cls=1:1:$$$maxv { i $p($g(ptv(cls)),"^",$$$PTVQB)=m,+$p(ptv(cls),"^",$$$PTVEQUIVCLASS)=cls d class^%qaqpnl }
	}
	kill range
	
endFurtherComp	
	// RTPC doesn't care about partition by range condition
	if 'infoComp {
		f m=1:1:$$$mtPNumQbs { 
			s logs=$g($$$mtPartitionPredicates(m))
			f lgi=1:1 { 
				s log=$p(logs,"^",lgi) q:log=""  
				set partitionByLogs(log)="" 
			}
		}
	}
	// populate fake pti
	do populateFakePti(queryType,sqlvarcparm) 
	set outlierDetected = 0
	kill vList
	For log=1:1 {
		q:'$D($$$mtL(log))
		set v=$$$mtL(log),ev=$e(v)
		continue:ev'="v"
		Set op=$zcvt($P(v,"^",2),"U") ; upper case of operator
		Set allowedOp=(",IN,INSET,ONEOF,=,"[(","_op_","))
		continue:('allowedOp)
		
		// change IN to INSET so that davalue can gen an array for the set
		// This array will be used to check whether outlier exists
		// $p(6) is populated because we already know the number of elements in the set 
		// via $l(mt("l",log),"^")-5, so RTPC-ListLength will not be triggered
		// for this condition
		if op = "IN" {
			set con = $$$newval("v^SET:SETOF^,^"_$p(v,"^",5,*),1)	
			set pti(con) = "SQLrtpcv"_con
			set op = "INSET"
			set listLength = $$$newval("t^"_($l($$$mtL(log),"^")-5),1)
			set $$$mtLOperator($$$mtL(log))=op,$p($$$mtL(log),"^",5,*)=con_"^"_listLength_"^"
		}
		
		Set v1=$$$mtLOperand1($$$mtL(log)),v2=$$$mtLOperand2($$$mtL(log))
		continue:(+v1=0 || (+v2=0)) ; continue if v1 or v2 is empty
		
		kill pti("update"),hasField1,hasField2
		set parms = "",hasField1 = 0,hasField2 = 0, allLiteral1 = 1, allLiteral2 = 1, line = ""
		
		$$$nsqline
		continue:'$$dfsXprs(infoComp,,,v1,,,.parms,.hasField1,.osel,.oval,.sel,.ocol,.allLiteral1)
		
		continue:'$$dfsXprs(infoComp,,,v2,,,.parms,.hasField2,.osel,.oval,.sel,.ocol,.allLiteral2)
		
		
		continue:(hasField1&&hasField2) ; field should only be on one side
		continue:(('hasField1)&&('hasField2)) ; this case will be pick up by truth value
		if hasField2 { 
			continue:op'="="
			continue:allLiteral1
			set temp=v1,v1=v2,v2=temp ; reverse order, field on LHS, expression on RHS
		} else {
			continue:allLiteral2
		}
		
		// set lExp and rExp
		set inset = $s(op="=":0,1:1)
		continue:inset&&(oval="")
		do:line'="" setin^%qaqcasl
		do updatePti
		if $$$mtVType($$$mtV(v1)) = "v" { ; this is a expression of field
			set lExp = pti(v1)
		} else { // this is a field 
			set lExp = $s(ocol'="":$$applycollation^%qaqcoutlier(ocol,oval),1:oval)
			set:'$isvalidnum(lExp) lExp = $$$quote(lExp)
		}
		set rExp = pti(v2)
		continue:(lExp="")||(rExp="")
		if infoComp{
			set outlier($I(outlier))=$lb(log)
			set:outlierDetected=0 outlierDetected = 1
			continue
		}
		// calculate sel and osel for list condition
		if (op '= "="){
			do GetRTPCListSel^%qaqomul(log,.osel,.sel)
		}
		set tag = "", opflag = 0
		for vi = 1,2{ 
			set mod = vi+1
			set tempV = $S(vi = 1:v1,1:v2)
			if '$d(vList(tempV)){
				d davalue^%qaqcpr(tempV)
			}
		}	
		for mod = 0:1:3{	
			set key = ""
			for {
				set key=$O($$$sqline(mod,key),1,value) q:key=""	
				set xpr = value
				if xpr[$C(3){
					for k = 2:2:$l(xpr,$C(3))-1{
						set col = $p($p(xpr,$C(3),k),"_",2)
						set coloval = $s(col'="":$$applycollation^%qaqcoutlier(col,oval),1:oval)
						set $p(xpr,$C(3),k) = $s('$isvalidnum(coloval):$$$quote(coloval),1:coloval)
					}
					set xpr = $ZSTRIP(xpr,"*",$C(3))	
				}
				set outlier("exp",$I(outlier("exp"))) = xpr
			}
		}
		//                             1      2        3            4          5        6            7                            8
		set outlier($I(outlier))=$lb(log,$get(osel),$get(sel),$get(inset),$get(lExp),$get(rExp),$get(parms),$lb(op,$g(hasField1("f"))_$g(hasField2("f"))))
		set:outlierDetected=0 outlierDetected = 1
	}
	QUIT outlierDetected
}
.
DetectTruthValues(infoComp,queryType=0,sqlvarcparm="",&truthValue)[ mt,pti,call,m,opflag,tag,vList,sqline,mod,rtpcHelperCode,lines,line,rtpcTVLogInfo,cgc] PUBLIC {
	// YCL106 - do not apply RTPC-truth value for parallel subquery
	return:$g(mt("options","parallelQuery"),0) 0
	set:queryType=-2 queryType=2
	set truthValueDetected = 0
	For log=1:1 {
		q:'$D($$$mtL(log))
		set v=$$$mtL(log),ev=$e(v)
		continue:ev'="v"
		Set op=$zcvt($P(v,"^",2),"U") ; upper case of operator
		Set allowedOp=(",NULL,'NULL,'<,<,>,'>,=,'=,"[(","_op_","))
		continue:('allowedOp)
		
		Set v1=$P(v,"^",4)
		continue:+v1=0
		if op'["NULL"{
			Set v2=$P(v,"^",5)
			continue:+v2=0 ; continue if v1 or v2 is empty
		}
		set parms = "",allLiteral1 = 1, allLiteral2 = 1, line = ""
		kill pti("update")
		
		$$$nsqline
		new rtpcTVLogInfo
		continue:'$$dfsXprs(infoComp,queryType,sqlvarcparm,v1,"DetectTruthValues",,.parms,,,,,,.allLiteral1)
		
		if op'["NULL"{ 
			continue:'$$dfsXprs(infoComp,queryType,sqlvarcparm,v2,"DetectTruthValues",,.parms,,,,,,.allLiteral2)
			continue:allLiteral1&&allLiteral2
		} else {
			continue:allLiteral1
		}
		Return:infoComp 1
		
		set logInfo=$lb(op)_rtpcTVLogInfo
		set hash = $$$Base64SHA(logInfo,10)
		do:line'="" setin^%qaqcasl
		do updatePti
		set val1 = pti(v1)
		set:op'["NULL" val2 = pti(v2)
		
		set tag = "", opflag = 0
		for vi = 1,2{
			quit:(op["NULL")&&(vi=2)
			set mod = vi+1
			set tempV = $S(vi = 1:v1,1:$g(v2))
			if (tempV'="")&&('$d(vList(tempV))){
				d davalue^%qaqcpr(tempV)
			}
		}
		for mod = 0:1:3{
			set key = ""
			for {
				set key=$O($$$sqline(mod,key),1,value) q:key=""	
				set truthValue("exp",$I(truthValue("exp"))) = value
			}
		}
		if op = ">" {set op = "]]"}
		elseif op = "'>" {set op = "']]"}
		elseif op = "<" {set op = "]]", temp = val1, val1 = val2, val2 = temp}
		elseif op = "'<" {set op = "']]", temp = val1, val1 = val2, val2 = temp}
						  //	 1   2     3       4    5      6	
		set truthValue(log)=$lb(val1,op,$g(val2),parms,hash,logInfo)
		set:truthValueDetected=0 truthValueDetected = 1
	}
	QUIT truthValueDetected
}
DetectRange(infoComp,queryType=0,sqlvarcparm="",&rangeRTPC)[ mt,call,m,opflag,pti,v,val,str,fval,log,tag,vList,output,ptv,linx,mod,sqline,rtpcHelperCode,cls,clst,li,list,k,x,logs,partitionByLogs,lines,line,cgc] PUBLIC {
	new v
	set rangeDetected = 0
	set:queryType=-2 queryType=2
	GOTO:'infoComp endFurtherComp
	for val=1:1:$$$maxv {
		set v=$$$mtV(val) 
		if $e(v)="v" {
			set fn=$p(v,"^",2)
			if (($$$ISENCODEDCOLLATE(fn))||(",%ANYOF,%ANYOFKEY,%ALPHAUP,%UPPER,%SQLSTRING,%SQLUPPER,%STRING,%PLUS,%MINUS,%SPACE,%MVR,%TRUNCATE,"[(","_$p($p(fn,"("),":")_","))) {
				set v=$$$mtV($p(v,"^",4)) 
				if $e(v)="f" { 
					set str=$p(v,"^",2),m=$$$mtRQb($$$mtR(str)) 
					do nuatt^%qaqpqo(val,str,$p(v,"^",3)_"_"_$tr(fn,":"))
					set pti(val) = $C(3)_$p(v,"^",3)_$C(3)
				} 
				elseif $e(v)="n" { set $$$mtV(val)="n^^^"_$$coll^%qaqpqo($p(v,"^",4),fn)_"^" }  ;  JLF015
			}
		}
	}
	
	for m=1:1:$$$mtPNumQbs { 
		s logs=$g($$$mtWhere(m)) f  s log=+logs,logs=$p(logs,"^",2,*) q:'log  d:$e($g($$$mtL(log),"i"))'="i" conds^%qaqpnl
		f cls=1:1:$$$maxv { i $p($g(ptv(cls)),"^",$$$PTVQB)=m,+$p(ptv(cls),"^",$$$PTVEQUIVCLASS)=cls d class^%qaqpnl }
	}
endFurtherComp
	do:infoComp populateFakePti(queryType,sqlvarcparm)
	For log=1:1 {
		q:'$D($$$mtL(log))
		continue:$d(partitionByLogs(log))
		set v=$$$mtL(log),ev=$e(v)
		continue:ev'="v"
		Set op=$zcvt($P(v,"^",2),"U") ; upper case of operator
		Set allowedOp=(",'<,<,>,'>,%STARTSWITH,],'],"[(","_op_",")) ; LIKE will be transform to %STARTSWITH and %Pattern
		continue:('allowedOp)
		Set v1=$P(v,"^",4),v2=$P(v,"^",5)
		continue:(+v1=0)||(+v2=0) ; continue if v1 or v2 is empty
		if $$$mtVType($$$mtV(v1))="f" { ; LHS must be a field or this field wrapped by its default collation, instead of a expression of field
			set col = $p($p($$$mtV(v1),"^",3),"_",2)
			if $$$ISENCODEDCOLLATE(col) {
				set parm1 = "", parm2 = ""
				do decodeCollate^%qaqcpre(col,.parm1,.parm2)
 				set col = "%COLLATE("_$$$quote(parm1)_$S(parm2="":")",1:","_parm2_")")
			}
			set ifn = +$p(pti(v1),$c(3),2)
			set irn=$$$smdGetIrnFromIfn(ifn)
			continue:irn=""
			set ttype = $$$smdTType(irn)
			if $lf($lb("%STARTSWITH","]","']"),op) {
				// must be a string
				continue:",INTEGER,DATE,NUMERIC,TIME,DOUBLE,POSIXTS,"[(","_$$$smdColCategory(ttype,irn,ifn)_",")
				set op=$replace(op,"]",">")
			}
			set defaultCol=$$$smdColCollation(ttype,irn,ifn)
			s defaultCol=$s(defaultCol="":"",defaultCol="SU":"%SQLUPPER",defaultCol="A":"%ALPHAUP",defaultCol="U":"%UPPER",defaultCol="S":"%SPACE",defaultCol="P":"%PLUS",defaultCol="M":"%MINUS",defaultCol="MV":"%MVR",defaultCol="E":"",defaultCol="T":"%STRING",defaultCol="SS":"%SQLSTRING",defaultCol["T(":"%STRING("_$p(defaultCol,"(",2),defaultCol["SS(":"%SQLSTRING("_$p(defaultCol,"(",2),defaultCol["SU(":"%SQLUPPER("_$p(defaultCol,"(",2),1:defaultCol)
			if $$$ISENCODEDCOLLATE(defaultCol) {
				set parm1 = "", parm2 = ""
				do decodeCollate^%qaqcpre(defaultCol,.parm1,.parm2)
 				set defaultCol = "%COLLATE("_$$$quote(parm1)_$S(parm2="":")",1:","_parm2_")")
			}
			continue:defaultCol'=col ; this collation should be the default collation of this field
		} else {continue} 
		set parms = "", allLiteral = 1, line = ""
		kill pti("update")
		$$$nsqline
		continue:'$$dfsXprs(infoComp,,,v2,"DetectRange",,.parms,,,,,,.allLiteral)
		if allLiteral {
			set literalLog(log) = 1
			continue:op="%STARTSWITH" // %STARTSWITH cannot be combined with other range condition, so if it's allLiteral, continue
		}
		
		// LHS field
		set ifn = +$p(pti(v1),$c(3),2)
		set irn=$$$smdGetIrnFromIfn(ifn)
		continue:irn=""
		continue:$$$classIsSerial($$$smdColDatatype(1,irn,ifn)) // skip for serial field
		set ttype = $$$smdTType(irn)
		set histInfo = $$$smdColHistogram(ttype,irn,ifn)
		continue:histInfo=""
		try{
			set sel = $p($g(ptv(v1)),"^",10)
			set:sel="" sel = +$$ddfldst2^%qaqpqo(m,ifn)
		} catch { continue }
		continue:sel=""
		
		if infoComp {
			set rangeRTPC(log)=$lb(log)
			set:rangeDetected=0 rangeDetected = 1
			continue
		}
		
		// RHS expreesion 
		do:line'="" setin^%qaqcasl
		do updatePti
		set val2 = pti(v2)
		set tag = "", opflag = 0,mod = 2
		if '$d(vList(v2)){
			d davalue^%qaqcpr(v2)
		}
		for mod = 0:1:2{
			set key = ""
			for {
				set key=$O($$$sqline(mod,key),1,value) q:key=""	
				set rangeRTPC("exp",$I(rangeRTPC("exp"))) = value
			}
		}
		kill pti("Code")
		
		// get null and empty value if op is %STARTWITH, since %STARTSWITH(null or empty) returns all the not null value
		if op = "%STARTSWITH" {
			set swEnd="SQLrtpcswEnd"_v2
			set rangeRTPC("exp",$I(rangeRTPC("exp"))) = " s "_swEnd_"=$e("_val2_",1,*-1)_$e($zlc($zla($e("_val2_",*)_$c(0,0,0))+1),1)"
			set col = $p($p(pti(v1),$c(3),2),"_",2)
			if $$$ISENCODEDCOLLATE($p(col,"(")){
				set parm1 = "", parm2 = ""
				do decodeCollate^%qaqcpre(col,.parm1,.parm2)
				set nullValue = $$$quote(##class(%Library.Collation).Collate("",parm1,parm2))
				set emptyValue = $$$quote(##class(%Library.Collation).Collate($c(0),parm1,parm2))
			}else{
				set nullValue = $s(col="":""""""," %SQLSTRING %SQLUPPER %SPACE %STRING "[$p(col,"("):""" """,col="%MVR":""" 5"""," %PLUS %MINUS "[col:0,1:"""""")
				set emptyValue = $s(col="":"$c(0)"," %SQLSTRING %SQLUPPER %SPACE %STRING %MVR "[$p(col,"("):"$c(32,0)",1:"$c(0)")
			}
			//			            1   2,3 : lower/upper val    4         5, 6: lower/upper op              7 $lb(null,empty str)    8           9          10:sel
			set rangeRTPC(log)=$lb(log)_$lb(val2,swEnd)_$lb(parms)_$lb($$$quote("'<"),$$$quote("<"))_$lb($lb(nullValue,emptyValue),histInfo,$lb($lb(op,ifn)),sel)
		}else {
			//			            1         	2,3 : lower/upper val                            4               5, 6: lower/upper op                                          7        8           9       10:sel
 			set rangeRTPC(log)=$lb(log)_$s((",'<,>,"[(","_op_",")):$lb(val2,),1:$lb(,val2))_$lb(parms)_$s((",'<,>,"[(","_op_",")):$lb($$$quote(op),),1:$lb(,$$$quote(op)))_$lb("",histInfo,$lb($lb(op,ifn)),sel)
		}
		set logCnt = $I(logCnt)
		set:rangeDetected=0 rangeDetected = 1
	}
	GOTO:rangeDetected=0 exit
	GOTO:infoComp exit
	//combine AND ranges together
	set ptvRangelogList = ""
	set key=""
	for {
		set key=$O(ptv(key),1,value) q:key=""
		continue:$p(value,"^",$$$PTVVALTYPE)'="f" ; continue if this is not a field
		continue:$p(value,"^",$$$PTVCONTYPE)'="r" ; continue if type is not range
		set rangeInfoList = $p($p(value,"^",$$$PTVRANGEINFO),",",2,*), logList = "", field = "", diffField = 0
		for i = 1:1 {
			set rangeInfo = $p(rangeInfoList,",",i)
			quit:rangeInfo=""
			continue:$lf(logList,$p(rangeInfo,$c(1),1)) // prevent duplicate log in this logList
			set logList = logList_$LB($p(rangeInfo,$c(1),1))
			if field="" {
				set field = $$$mtLColVals($g($$$mtL($p(rangeInfo,$c(1),1))))	
				set:field="" diffField = 1
			} elseif ($$$mtLColVals($g($$$mtL($p(rangeInfo,$c(1),1))))'=field){
				set diffField = 1
			}
			quit:diffField
			
		}
		continue:diffField
		set ptr=0,allLiteral=1,otherOpLogList=""
		while $LISTNEXT(logList,ptr,log) {
	      quit:log=""
	      if '$D(rangeRTPC(log)){ set otherOpLogList = otherOpLogList_$LB(log) continue}
	      set ptvRangelogList = ptvRangelogList_$LB(log)
          if '$d(literalLog(log)) {
	          set allLiteral=0
	      }
    	}
    	if allLiteral{
	    	set ptr=0
	    	while $LISTNEXT(logList,ptr,log) {
	      		quit:log=""
          		if $D(rangeRTPC(log)) {
	          		kill rangeRTPC(log)
          			set logCnt = logCnt-1
          			if logCnt=0 {
	          			set rangeDetected = 0
	          			GOTO exit
          			}
          		}
    		}	
	    }
	    
		set lowerArr = 0, upperArr = 0
		set lowerV = "", lowerOp = "", upperV = "", upperOp = "", parms = ""
		for i = 1:1 {
			set rangeInfo = $p(rangeInfoList,",",i)
			quit:rangeInfo=""
			set log = $p(rangeInfo,$c(1),1),op = $p(rangeInfo,$c(1),2),con = $p(rangeInfo,$c(1),3)
			if ('$D(rangeRTPC(log)))||(op="%STARTSWITH"){ set otherOpLogList = otherOpLogList_$LB(log) continue} // just combine >,'>,<,'<, since %startswith need to compare with null value, follows is not in range
			if (op = ">")||(op="'<"){
				set lowerV = pti(con),lowerOp = $$$quote(op)
				set lowerArr($I(lowerArr),"v")=lowerV, lowerArr(lowerArr,"o")=lowerOp
			} elseif (op = "'>")||(op="<") {
				set upperV = pti(con),upperOp = $$$quote(op)
				set upperArr($I(upperArr),"v")=upperV, upperArr(upperArr,"o")=upperOp
			} 
			set:(rangeRTPC(log)'=1)&&($lg(rangeRTPC(log),4)'="") parms = parms_$S(parms="":"",1:",")_$lg(rangeRTPC(log),4)
		}
		if lowerArr > 1 {
			set keyL="",tmp=""
			for {
				set keyL=$O(lowerArr(keyL),1) q:keyL=""
				continue:keyL=1
				set lvopIdx = $I(lvopIdx)
				set curV = lowerArr(keyL,"v")
				set curO = lowerArr(keyL,"o")
				if keyL = 2 {
					if curO=""">""" {
						set rangeRTPC("exp",$I(rangeRTPC("exp"))) = "set SQLrtpclvop"_lvopIdx_"=$s("_lowerArr(1,"v")_"']]"_curV_":$LB("_curV_","_curO_"),1:$LB("_lowerArr(1,"v")_","_lowerArr(1,"o")_"))"
					} else {
						set rangeRTPC("exp",$I(rangeRTPC("exp"))) = "set SQLrtpclvop"_lvopIdx_"=$s("_curV_"]]"_lowerArr(1,"v")_":$LB("_curV_","_curO_"),1:$LB("_lowerArr(1,"v")_","_lowerArr(1,"o")_"))"
					}	
				} else {
					if curO=""">""" {
						set rangeRTPC("exp",$I(rangeRTPC("exp"))) = "set SQLrtpclvop"_lvopIdx_"=$s($LIST(SQLrtpclvop"_(lvopIdx-1)_")']]"_curV_":$LB("_curV_","_curO_"),1:SQLrtpclvop"_(lvopIdx-1)_")"
					} else {
						set rangeRTPC("exp",$I(rangeRTPC("exp"))) = "set SQLrtpclvop"_lvopIdx_"=$s("_curV_"]]$LIST(SQLrtpclvop"_(lvopIdx-1)_"):$LB("_curV_","_curO_"),1:SQLrtpclvop"_(lvopIdx-1)_")"
					}
					
				}
			}
.
			set lowerV = "$LIST(SQLrtpclvop"_lvopIdx_")"
			set lowerOp = "$LIST(SQLrtpclvop"_lvopIdx_",2)"
		} 
		if upperArr > 1 {
			set keyU="",tmp=""
			for {
				set keyU=$O(upperArr(keyU),1) q:keyU=""
				continue:keyU=1
				set uvopIdx = $I(uvopIdx)
				set curV = upperArr(keyU,"v")
				set curO = upperArr(keyU,"o")
				if keyU = 2 {
					if curO="""<""" {
						set rangeRTPC("exp",$I(rangeRTPC("exp"))) = "set SQLrtpcuvop"_uvopIdx_"=$s("_curV_"']]"_upperArr(1,"v")_":$LB("_curV_","_curO_"),1:$LB("_upperArr(1,"v")_","_upperArr(1,"o")_"))"
					} else {
						set rangeRTPC("exp",$I(rangeRTPC("exp"))) = "set SQLrtpcuvop"_uvopIdx_"=$s("_upperArr(1,"v")_"]]"_curV_":$LB("_curV_","_curO_"),1:$LB("_upperArr(1,"v")_","_upperArr(1,"o")_"))"
					}	
				} else {
					if curO="""<""" {
						set rangeRTPC("exp",$I(rangeRTPC("exp"))) = "set SQLrtpcuvop"_uvopIdx_"=$s("_curV_"']]$LIST(SQLrtpcuvop"_(uvopIdx-1)_")"_":$LB("_curV_","_curO_"),1:SQLrtpcuvop"_(uvopIdx-1)_")"
					} else {
						set rangeRTPC("exp",$I(rangeRTPC("exp"))) = "set SQLrtpcuvop"_uvopIdx_"=$s($LIST(SQLrtpcuvop"_(uvopIdx-1)_")]]"_curV_":$LB("_curV_","_curO_"),1:SQLrtpcuvop"_(uvopIdx-1)_")"
					}
					
				}
			}
.
			set upperV = "$LIST(SQLrtpcuvop"_uvopIdx_")"
			set upperOp = "$LIST(SQLrtpcuvop"_uvopIdx_",2)"
		}
		set ptr=0,firstLog = 1
		while $LISTNEXT(logList,ptr,log) {
			quit:log=""
			continue:$LISTFIND(otherOpLogList,log)
			if firstLog {
				continue:'$D(rangeRTPC(log))
				continue:rangeRTPC(log)=1 ; in case this log is used in other ptv(val)
				set $li(rangeRTPC(log),2,3) = $lb(lowerV,upperV)
				set $li(rangeRTPC(log),4) = parms
				set $li(rangeRTPC(log),5,7) = $lb(lowerOp,upperOp,"")
				set firstLog = 0,firstLog("l")=log
			} else{
				continue:rangeRTPC(log)=1 ; in case this log is used in other ptv(val)
				set $li(rangeRTPC(firstLog("l")),9) = $li(rangeRTPC(firstLog("l")),9)_$li(rangeRTPC(log),9)
				set rangeRTPC(log) = 1
			}
    	}	
	}
	
	// if exist literal range conditions, check range array again to remove literal condition from range array if this condition log is not in ptvRangelogList
	if $d(literalLog){
		for {
			set key=$O(rangeRTPC(key),1,value) q:(key="")||((+key)=0)
			if $d(literalLog(key))&&('$LISTFIND(ptvRangelogList,key)) {
				if $D(rangeRTPC(key)) {
					kill rangeRTPC(key)
          			set logCnt = logCnt-1
          			if logCnt=0 {
	          			set rangeDetected = 0
	          			GOTO exit
          			}
				}
			}
		}
	}
exit	QUIT rangeDetected
}
#define SB(%i) $CASE(%i,0:0,1:.00006103515625,2:.000244140625,3:.0009765625,4:.00390625,5:.015625,6:.0625,7:.25,8:1,:"")
#define SBmiddle(%i) (($$$SB(%i+0.5)+$$$SB(%i-0.5))/2)
DetectListLength(infoComp,queryType=0,sqlvarcparm="",&listLength,&outlier,&hasOutlier=0)[ mt,pti,call,colnm,m,opflag,tag,vList,sqline,mod,rtpcHelperCode,lines,line,cgc] PUBLIC {
	set listLengthDetected = 0
	set:queryType=-2 queryType=2
	goto:'infoComp endFurtherComp
	for log=1:1:$$$maxl {
		set ptlg=$$$mtL(log)
		if $p(ptlg,"^",2)="ONEOF" {
			set $$$mtCollationNullMarker($p(ptlg,"^",5))=$$colnul^%qaqcpr($p(ptlg,"^",4),0)
			set ($$$mtNullMarker($p(ptlg,"^",4)),$$$mtNullMarker($p(ptlg,"^",5)))=$$colnm^%qaqpnl($p(ptlg,"^",4),$$$mtCollationNullMarker($p(ptlg,"^",5)))
			n call,colnm s call="setcolnm^%qaqpnl",colnm=$$$mtNullMarker($p(ptlg,"^",5))
			d lvtree^%qaqpnl("v",$p(ptlg,"^",5))  ;  propagate to all SETs in the subtree
		}
	}
	d undoSideEffects^%qaqpre3 
endFurtherComp
	do:infoComp populateFakePti(queryType,sqlvarcparm)
	For log=1:1 {
		q:'$D($$$mtL(log))
		set v=$$$mtL(log),ev=$e(v)
		continue:ev'="v"
		Set op=$zcvt($P(v,"^",2),"U") ; upper case of operator
		Set allowedOp=(",INSET,ONEOF,"[(","_op_","))
		continue:('allowedOp)
		continue:$p(v,"^",6) ; the length has been specified by user
		Set v1=$$$mtLOperand1($$$mtL(log)),v2=$$$mtLOperand2($$$mtL(log))
		continue:(+v1=0 || (+v2=0)) ; continue if v1 or v2 is empty
		continue:$$$mtVType($$$mtV(v1))'="f"
		
        kill pti("update"),hasField1,hasField2
        set parms = "",hasField1 = 0,hasField2 = 0, allLiteral1 = 1, allLiteral2 = 1, line = ""
        $$$nsqline
        
		continue:'$$dfsXprs(infoComp,,,v1,"DetectListLength",,.parms,.hasField1,.osel,.oval,.sel,.ocol,.allLiteral1)
		continue:'$$dfsXprs(infoComp,,,v2,"DetectListLength",,.parms,.hasField2,.osel,.oval,.sel,.ocol,.allLiteral2)
		continue:hasField2 ; field should only be on hasField1 side
		continue:(($g(osel)'="")&&($g(oval)=""))
		if infoComp {
			set listLength($I(listLength))=$lb(log)
			set:listLengthDetected=0 listLengthDetected = 1
			continue
		}
		if (line'="")&&($g(osel)="") { do setin^%qaqcasl,updatePti }
		if $g(osel)'="" {
			set hasOutlier = 1, oFound = 0
			// DetetOutlier must include this log if there is no UDF, otherwise, create a outlier entry for it
			for oi=1:1 {
				q:'$D(outlier(oi))
				if $li(outlier(oi),1)=log {
					set oFound = 1
					set $li(outlier(oi),2)="SQLrtpclosel"_log
					set $li(outlier(oi),3)="SQLrtpclsel"_log
					quit
				}
			} 
			if 'oFound {
				if (line'="") { do setin^%qaqcasl,updatePti }
				set lExp = $s(ocol'="":$$applycollation^%qaqcoutlier(ocol,oval),1:oval)
				set:'$isvalidnum(lExp) lExp = $$$quote(lExp)
				set rExp = pti(v2)
				set outlier($I(outlier))=$lb(log,"SQLrtpclosel"_log,"SQLrtpclsel"_log,1,$get(lExp),$get(rExp),$get(parms),$lb(op,$g(hasField1("f"))_$g(hasField2("f"))))
			}
		}
		set tag = "", opflag = 0,mod=2
		if ($g(osel)="")||(($g(osel)'="")&&('oFound)){
			if '$d(vList(v2)){
				d davalue^%qaqcpr(v2)
			}
		}
		set key = ""
		for mod = 0:1:2 {
			for {
				set key=$O($$$sqline(mod,key),1,value) q:key=""	
				if ($g(osel)="") { 
					set listLength("exp",$I(listLength("exp"))) = value
				} else{ 
					set keyL=""
					for {
						set keyL=$O(listLength("exp",keyL),1,valueL) q:keyL=""	
						set outlier("exp",$I(outlier("exp")))= valueL // put listLength("exp") before we set value, since some variable setting might be in listLength("exp")
					}
					k listLength("exp")
					set outlier("exp",$I(outlier("exp")))= value 
				}
			}
		}
		if $g(osel)'="" {
			set outlier("llexp",$I(outlier("llexp"))) = "s SQLrtpcll=0,SQLrtpckey="""""
		    set outlier("llexp",$I(outlier("llexp"))) = "for {s SQLrtpckey=$o("_pti(v2)_"(SQLrtpckey)) q:SQLrtpckey="""""
			set outlier("llexp",$I(outlier("llexp"))) = $c(9)_"s SQLrtpcll=$i(SQLrtpcll) }"
			set outlier("llexp",$I(outlier("llexp"))) = "s SQLrtpclsel"_log_"="_sel_"*SQLrtpcll"
			set outlier("llexp",$I(outlier("llexp"))) = "s SQLrtpclosel"_log_"="_osel_"+("_sel_"*(SQLrtpcll-1))"
			set outlier("llexp",$I(outlier("llexp"))) = "s SQLrtpclsel"_log_" = $S(SQLrtpclsel"_log_"=0:.00001,SQLrtpclsel"_log_"]]"_$$$SB(4)_":$S(SQLrtpclsel"_log_"]]"_$$$SB(6)_":$S(SQLrtpclsel"_log_"]]"_$$$SB(7)_":"_$$$SBmiddle(7.5)_",1:"_$$$SBmiddle(6.5)_"),1:$S(SQLrtpclsel"_log_"]]"_$$$SB(5)_":"_$$$SBmiddle(5.5)_",1:"_$$$SBmiddle(4.5)_")),1:$S(SQLrtpclsel"_log_"]]"_$$$SB(2)_":$S(SQLrtpclsel"_log_"]]"_$$$SB(3)_":"_$$$SBmiddle(3.5)_",1:"_$$$SBmiddle(2.5)_"),1:$S(SQLrtpclsel"_log_"]]"_$$$SB(1)_":"_$$$SBmiddle(1.5)_",1:"_$$$SBmiddle(0.5)_")))"
			set outlier("llexp",$I(outlier("llexp"))) = "s SQLrtpclosel"_log_" = $S(SQLrtpclosel"_log_"=0:.00001,SQLrtpclosel"_log_"]]"_$$$SB(4)_":$S(SQLrtpclosel"_log_"]]"_$$$SB(6)_":$S(SQLrtpclosel"_log_"]]"_$$$SB(7)_":"_$$$SBmiddle(7.5)_",1:"_$$$SBmiddle(6.5)_"),1:$S(SQLrtpclosel"_log_"]]"_$$$SB(5)_":"_$$$SBmiddle(5.5)_",1:"_$$$SBmiddle(4.5)_")),1:$S(SQLrtpclosel"_log_"]]"_$$$SB(2)_":$S(SQLrtpclosel"_log_"]]"_$$$SB(3)_":"_$$$SBmiddle(3.5)_",1:"_$$$SBmiddle(2.5)_"),1:$S(SQLrtpclosel"_log_"]]"_$$$SB(1)_":"_$$$SBmiddle(1.5)_",1:"_$$$SBmiddle(0.5)_")))"
		} else {
			set listLength("exp",$I(listLength("exp"))) = "s SQLrtpcll=0,SQLrtpckey="""""
		    set listLength("exp",$I(listLength("exp"))) = "for {s SQLrtpckey=$o("_pti(v2)_"(SQLrtpckey)) q:SQLrtpckey="""""
			set listLength("exp",$I(listLength("exp"))) = $c(9)_"s SQLrtpcll=$i(SQLrtpcll) }"
			set listLength("exp",$I(listLength("exp"))) = "s SQLrtpclsel"_log_"="_sel_"*SQLrtpcll"
			set listLength("exp",$I(listLength("exp"))) = "s SQLrtpclsel"_log_" = $S(SQLrtpclsel"_log_"=0:.00001,SQLrtpclsel"_log_"]]"_$$$SB(4)_":$S(SQLrtpclsel"_log_"]]"_$$$SB(6)_":$S(SQLrtpclsel"_log_"]]"_$$$SB(7)_":"_$$$SBmiddle(7.5)_",1:"_$$$SBmiddle(6.5)_"),1:$S(SQLrtpclsel"_log_"]]"_$$$SB(5)_":"_$$$SBmiddle(5.5)_",1:"_$$$SBmiddle(4.5)_")),1:$S(SQLrtpclsel"_log_"]]"_$$$SB(2)_":$S(SQLrtpclsel"_log_"]]"_$$$SB(3)_":"_$$$SBmiddle(3.5)_",1:"_$$$SBmiddle(2.5)_"),1:$S(SQLrtpclsel"_log_"]]"_$$$SB(1)_":"_$$$SBmiddle(1.5)_",1:"_$$$SBmiddle(0.5)_")))"
			//                                  1           2          3                             4
			set listLength($I(listLength))=$lb(log,"SQLrtpclsel"_log,parms,$lb(op,$g(hasField1("f"))_$g(hasField2("f"))))
			set:listLengthDetected=0 listLengthDetected = 1
		}
	}
exit	
	RETURN listLengthDetected
}
DetectSameVDF(infoComp,queryType=0,sqlvarcparm="",&vdfRTPC,&vdfExist=0)[ mt,call,m,opflag,pti,v,val,str,fval,log,tag,vList,output,ptv,linx,mod,sqline,rtpcHelperCode,cls,clst,li,list,k,x,logs,partitionByLogs,lines,line,cgc,rtpcTVLogInfo] PUBLIC {
	new output,v
	set VDFDetected = 0,output=1
	set:queryType=-2 queryType=2
	GOTO:'$D($$$mtSequencers) exit
	if infoComp {
		do populateFakePti(queryType,sqlvarcparm)
	} else {
		set vdfExist=$d(mt("vdf"))	
	}
	for m=1:1:$$$mtPNumQbs{ 
		continue:'$d($$$mtOutput(m))
		continue:$s(m=1:('$d($$$mtSequencersQb(m)))&&('$d($$$mtSequencers)),1:'$d($$$mtSequencersQb(m)))
		set ord=$s(m=1:$g($$$mtSequencers),1:$$$mtSequencersQb(m))
		set:m=1 checkBoth=0 // check both mt("s") and mt("s",1)
loop	for i=1:1:$l(ord,",")-1 {
			set val=+$p(ord,",",i)
			if $d($$$mtVecDistFunc(val)) {set val=$$$mtVecDistFunc(val)}
			// check for v^<DISTANCE FUNCTION>^
			continue:$$$mtVType($$$mtV(val))'="v"
			continue:'$lf($lb("VECTOR_DOT_PRODUCT","VECTOR_COSINE","VECTOR_L2"),$p($$$mtV(val),"^",2))
			//switch $p(4) and $p(5) if $p(4) is not f
			set:$e($$$mtV($p($$$mtV(val),"^",4)))'="f" $$$mtV(val)=$p($$$mtV(val),"^",1,3)_"^"_$p($$$mtV(val),"^",5)_"^"_$p($$$mtV(val),"^",4)_"^"
			set fval=$p($$$mtV(val),"^",4)
			continue:$$$mtVType($$$mtV(fval))'="f" // should be a field
			set pval=$p($$$mtV(val),"^",5)
			d lflds^%qaqpnl("v",pval,"do")  // piece 5 should be a streamless v expression
			set pv=$$$mtV(pval)
			continue:'(("tx"[$e(pv))||(($e(pv)="v")&&($p(pv,"^",3)=",")))
			set op=$p($$$mtV(val),"^",2)
			// sameVDF(m,op,fval,"s")=$lb($lb(pval,#ord,val),$lb(pval,#ord,val))
			set sameVDF(m,op,fval,"s")=$g(sameVDF(m,op,fval,"s"))_$lb($lb(pval,i,val))
		}
		if m=1,checkBoth=0 {
			set ord=$g($$$mtSequencersQb(m)),checkBoth=1 goto loop
		}
		set rtpcTVLogInfo=""
		kill outputHash
		set outputs=$$$mtOutputVals($g($$$mtOutput(m)))  ;  SELECT-list
		for i=1:1:$l(outputs,",")-1 {
			set val=$p(outputs,",",i)
			continue:$$$mtVType($$$mtV(val))'="v"
			continue:'$lf($lb("VECTOR_DOT_PRODUCT","VECTOR_COSINE","VECTOR_L2"),$p($$$mtV(val),"^",2))
			//switch $p(4) and $p(5) if $p(4) is not f
			set:$e($$$mtV($p($$$mtV(val),"^",4)))'="f" $$$mtV(val)=$p($$$mtV(val),"^",1,3)_"^"_$p($$$mtV(val),"^",5)_"^"_$p($$$mtV(val),"^",4)_"^"
			set fval=$p($$$mtV(val),"^",4)
			continue:$$$mtVType($$$mtV(fval))'="f" // should be a field
			set pval=$p($$$mtV(val),"^",5)
			d lflds^%qaqpnl("v",pval,"do")  // piece 5 should be a streamless v expression
			set pv=$$$mtV(pval)
			continue:'(("tx"[$e(pv))||(($e(pv)="v")&&($p(pv,"^",3)=",")))
			set op=$p($$$mtV(val),"^",2)
			// sameVDF(m,op,fval,"o")=$lb($lb(pval,#output),$lb(pval,#output))
			if $d(sameVDF(m,op,fval,"s"),sData) {
				set once=0 //only want to code gen oparm once
				
				// code gen for order by parameter
				set ptr=0
				while $listnext(sData,ptr,value) {
					set $lb(spval,ordNum,sval)=value
					continue:sval=val // ORDER BY 3
					if 'once {
						RETURN:infoComp 1
						set VDFDetected=1
						// code gen for output parameter 
						set line="",parms=""
						kill pti("update")
						$$$nsqline 
						set rtpcTVLogInfo=""
						do dfsXprs(infoComp,queryType,sqlvarcparm,pval,"DetectSameVDF",,.parms)
						set outputHash(i)=rtpcTVLogInfo
						do:line'="" setin^%qaqcasl
						do updatePti
						set tag = "", opflag = 0,mod = 2
						if '$d(vList(pval)){
							d davalue^%qaqcpr(pval)
						}
						for mod = 0:1:2{
							set key = ""
							for {
								set key=$O($$$sqline(mod,key),1,value) q:key=""	
								set vdfRTPC("exp",$I(vdfRTPC("exp"))) = value
							}
						}
						kill pti("Code")
						set oParm=pti(pval)	
						set once=1
					}
					set line=""
					kill pti("update")
					$$$nsqline
					set rtpcTVLogInfo=""
					do dfsXprs(infoComp,queryType,sqlvarcparm,spval,"DetectSameVDF",,.parms)
					set hash=$$$Base64SHA(outputHash(i)_rtpcTVLogInfo,10) // SHA(select parameter_order parameter)
					do:line'="" setin^%qaqcasl
					do updatePti
					set tag = "", opflag = 0,mod = 2
					if '$d(vList(spval)){
						d davalue^%qaqcpr(spval)
					}
					for mod = 0:1:2{
						set key = ""
						for {
							set key=$O($$$sqline(mod,key),1,value) q:key=""	
							set vdfRTPC("exp",$I(vdfRTPC("exp"))) = value
						}
					}
					kill pti("Code")
					set sParm=pti(spval),result="SQLrtpcSameVDFs"_spval_"o"_pval 
					set vdfRTPC("exp",$I(vdfRTPC("exp"))) = "if $vop(""type"","_sParm_")'=$vop(""type"","_oParm_") {"
					set vdfRTPC("exp",$I(vdfRTPC("exp"))) = $c(9)_"set "_result_"=0"
					set vdfRTPC("exp",$I(vdfRTPC("exp"))) = "} else {"
					set vdfRTPC("exp",$I(vdfRTPC("exp"))) = $c(9)_"set SQLrtpcSameVDFLength=$vop(""length"","_sParm_")"
					set vdfRTPC("exp",$I(vdfRTPC("exp"))) = $c(9)_"if SQLrtpcSameVDFLength'=$vop(""length"","_oParm_") {"
					set vdfRTPC("exp",$I(vdfRTPC("exp"))) = $c(9,9)_"set "_result_"=0"
					set vdfRTPC("exp",$I(vdfRTPC("exp"))) = $c(9)_"} else {"
					set vdfRTPC("exp",$I(vdfRTPC("exp"))) = $c(9,9)_"set "_result_"=(SQLrtpcSameVDFLength=$bitcount($vop(""v="","_sParm_","_oParm_"),1))"
					set vdfRTPC("exp",$I(vdfRTPC("exp"))) = $c(9)_"}"
					set vdfRTPC("exp",$I(vdfRTPC("exp"))) = "}"
					//                           m #ord  #output,hash,result, parms
					set vdfRTPC($I(vdfRTPC))=$lb(m,ordNum,i,hash,result,parms)
				}	
			}
		}
	}
exit	merge vdfRTPC("helper")=rtpcHelperCode("helper")	
		RETURN VDFDetected
}
isRTPCApplicable(infoComp=1,queryType=0,sqlvarcparm="",selectMode="",&hasOutlier=0,&outlier,&hasTruthValue=0,&truthValue,&hasRange=0,&rangeRTPC,&hasListLength=0,&listLength,&hasSameVDF=0,&vdfRTPC,&vdfExist=0)[a,append,b,bool,call,cgc,cls,clst,colnm,ev,flagg,fname,fval,idifn,imp,irn,k,l2,l3,lefts,leftv,lgi,li,line,lines,linx,list,ln,lni,log,logs,m,maxs,mlabel,mod,mt,newstr,op,opflag,output,partitionByLogs,pi,pti,ptl,ptlg,ptv,range,rtpcHelperCode,rtpcTVLogInfo,sql,sqline,str,tag,tname,tup,type,v,v1,v2,v3,vList,val,val1,val2,val3,vals,x,xa,xb] PUBLIC {
	return:",DEC,SEL,INS,UPD,DEL,"'[(","_$$$mtStatementType_",") 0
	merge mttemp = mt
	new a,append,b,bool,call,cgc,cls,clst,colnm,ev,flagg,fname,fval,idifn,imp,irn,k,l2,l3,lefts,leftv,lgi,li,line,lines,linx,list,ln,lni,log,logs,m,maxs,mlabel,mod,mt,newstr,op,opflag,output,partitionByLogs,pi,pti,ptl,ptlg,range,rtpcHelperCode,rtpcTVLogInfo,sqline,str,tag,tname,tup,type,v,v1,v2,v3,vList,val,val1,val2,val3,vals,x,xa,xb
	new:infoComp ptv
	merge mt = mttemp
	set mt("sqlcomp")=$case(selectMode,"Runtime":"%Runtime","ODBC":"%ODBC","IntExt":"%INTEXT","Text":"%EXTERNAL","FDBMS":"%FDBMS",:"")
	// init the structure for rtpc helper function
	set rtpcHelperCode("caller") = $s(queryType=-2:"ShowPlan",1:"Query")_infoComp
	do cgcInit^%qaqcasl
	set hasOutlier = $$DetectOutliers^%qaqcoutlier(infoComp,queryType,sqlvarcparm,.outlier)
	set hasTruthValue = $$DetectTruthValues^%qaqcoutlier(infoComp,queryType,sqlvarcparm,.truthValue)
	set hasRange = $$DetectRange^%qaqcoutlier(infoComp,queryType,sqlvarcparm,.rangeRTPC)
	set hasListLength = $$DetectListLength^%qaqcoutlier(infoComp,queryType,sqlvarcparm,.listLength,.outlier,.hasOutlier)
	set hasSameVDF = $$DetectSameVDF^%qaqcoutlier(infoComp,queryType,sqlvarcparm,.vdfRTPC,.vdfExist)
	kill vList
	return:'infoComp 1
	// mt("vdf") - indicates that we could potentially use vector index
	set couldUseVectorIndex = ($d(mt("vdf"))'="")
	if (hasOutlier||hasTruthValue||hasRange||hasListLength||hasSameVDF)&&($$checkRTPCPlanCost(.queryType,sqlvarcparm,selectMode,.sql,.hasOutlier,.outlier,.hasTruthValue,.truthValue,.hasRange,.rangeRTPC,.hasListLength,.listLength,.hasSameVDF,.vdfRTPC)){
		return (hasOutlier||hasTruthValue||hasRange||hasListLength||hasSameVDF)
	}
	return 0	
}
checkRTPCPlanCost(queryType,sqlvarcparm,selectMode,&sql,&hasOutlier,&outlier,&hasTruthValue,&truthValue,&hasRange,&rangeRTPC,&hasListLength,&listLength,&hasSameVDF=0,&vdfRTPC)[phasOutlier,poutlier,phasTruthValue,ptruthValue,phasRange,prangeRTPC,phasListLength,plistLength,phasSameVDF,pvdfRTPC,rtpcHelperCode,partitionByLogs,vList,packages,pvdfExist]PUBLIC{
	new %plan,%msqlvar
	new phasOutlier,poutlier,phasTruthValue,ptruthValue,phasRange,prangeRTPC,phasListLength,plistLength,phasSameVDF,pvdfRTPC,rtpcHelperCode,partitionByLogs,vList,pvdfExist
	merge tempsql = sql
	set tempsql($I(tempsql)) = "/*#OPTIONS {""rtpc-utility"":1} */"_" /*#OPTIONS {""rtpc-info-queryType"":"_queryType_"} */"_" /*#OPTIONS {""rtpc-info-sqlvarcparm"":"_$$$quote(sqlvarcparm)_"} */"_" /*#OPTIONS {""rtpc-info-selectMode"":"_$$$quote(selectMode)_"} */"
	set planCost = 0
	set outlierStr = "", rangeStr = "", listStr = ""
	if hasOutlier {
		set key=""
		for {
			set key=$O(outlier(key),1,value) q:(key="")||((+key)=0)
			set outlierStr = $s(outlierStr="":"",1:outlierStr_",")_$$$quote($li(value,1)_"^0.99")
		}
		set tempsql(tempsql) = tempsql(tempsql)_" /*#OPTIONS {""rtpc-log-sel"":["_outlierStr_"]}*/"
	}
	if hasRange {
		set key=""
		for {
			set key=$O(rangeRTPC(key),1, value) q:(key="")||((+key)=0)
			set rangeStr = $s(rangeStr="":"",1:rangeStr_",")_$$$quote(key_"^0.99")
		}
		set tempsql(tempsql) = tempsql(tempsql)_" /*#OPTIONS {""rtpc-range"":["_rangeStr_"]}*/"
	}
	if hasListLength {
		set key=""
		for {
			set key=$O(listLength(key),1, value) q:(key="")||((+key)=0)
			set listStr = $s(listStr="":"",1:listStr_",")_$$$quote($li(value,1)_"^0.99")
		}
		set tempsql(tempsql) = tempsql(tempsql)_" /*#OPTIONS {""rtpc-list"":["_listStr_"]}*/"
	}
	do
	. $$$SuspendErrorCount	// We do not want to count any errors we get in this call to ShowPlan, we don't report these errors or care about them
	. Do ShowPlan^%apiSQL(.tempsql,1,,,$g(packages),,0,,,1,,,,,1,,,1)
	return:'$d(phasOutlier) 0 // if there is any error before reaching the bottom of %qaqpqo1, we cannot get this phasOutlier, return 0
	set hasOutlier = phasOutlier,hasTruthValue = phasTruthValue,hasRange = phasRange,hasListLength=phasListLength,hasSameVDF=phasSameVDF
	k outlier,truthValue,rangeRTPC,listLength,vdfRTPC
	merge outlier = poutlier,truthValue=ptruthValue,rangeRTPC = prangeRTPC,listLength = plistLength,vdfRTPC = pvdfRTPC
	set planCost=+%plan
	return pvdfExist||(planCost>$$$RTPCPlanCostThreshold)||(planCost=0)||(planCost="")
}
.
populateFakePti(queryType=0,sqlvarcparm="") [ev,mt,pti] public {
	new ev
	set key=""
	for v= 1:1{
		q:'$D($$$mtV(v))
		set ev = $$$mtVType($$$mtV(v))
		if ev = "f" {
			set ifn = $p($$$mtV(v),"^",3)
			set pti(v)=$C(3)_ifn_$C(3)
		}
		elseif ev = "v" {set pti(v) = "SQLrtpcv"_v}
		elseif ev = "x" {
			set pti(v) = $P($$$mtV(v),"^",2)
			if $isvalidnum(pti(v)) { // this is not a parameter, this is same as a n node for correlated field
				set pti(v) = ""
				continue
			} 
			if (queryType = 1) {
				if ((sqlvarcparm'="")&&($E(pti(v),1,5) = "%parm")) {
		   			set pti(v) = sqlvarcparm_$S($E(sqlvarcparm,*)="(":$E(pti(v),7,*),1:+$E(pti(v),7,*))	
		   		}	
			} elseif (queryType = 2) {
				if ($E(pti(v),1,5) = "%parm") {
		   			set pti(v) = "%CallArgs"_$E(pti(v),6,*)	
		   		}
			}
			set pti(v) = "$g("_pti(v)_")"
		}
		elseif ev = "t" {
			set dat = $e($$$mtV(v),3,*),odat=dat
			s dat=$$$SQLquoter(dat)
			#; Escape embedded cr/lf characters or we can generate INT code that can not be recompiled
			if $e(dat)="""" s dat=$$quoteName^%qaqcasl(dat)
			if $$$mtV(v)'="t^" {
				if $$$VTRgetcat(v)="INTEGER" {
					set pti(v) = $$quoter($s($isvalidnum(odat):+odat,1:odat)) 		// non-null constant, no need to check for NULL before normalizing	
				} elseif $$$VTRgetcat(v)="NUMERIC"||($$$VTRgetdt(v)="%Library.Float"||($$IsA^%occLibrary($$$VTRgetdt(v),"%Library.Float"))) {
					set pti(v) = $$quoter($s($isvalidnum(odat):+odat,1:odat))			// non-null constant, no need to check for NULL before +'ing
				} elseif $$$VTRgetcat(v)="DOUBLE" {
					set pti(v) = $s($isvaliddouble(odat):"$double("_dat_")",1:dat)		// non-null constant, no need to check for NULL before calling $double
				} elseif $case($$$VTRgetcat(v),"TIMESTAMP":1,"POSIXTS":1,:0) {
					set pti(v) = $$quoter($s(odat[".":$zstrip($zstrip(odat,">W","0 "),">","."),1:$zstrip(odat,">W")))		// non-null contant, no need to check for NULL before normalizing			
				} else {
					set pti(v) = dat
				}
			} else {
				set pti(v) = dat
			}
		}
		else {set pti(v) = ""}
	}
}
.
dfsXprs(infoComp=1,queryType=0,sqlvarcparm="",val,caller="DetectOutliers",parentOps="",parms="",&hasField=0,&osel,&oval,&sel,&ocol,&allLiteral=1) [mt,m,pti,ptv,line,rtpcHelperCode,tag,mod,rtpcTVLogInfo] public {
	set v = $$$mtV(val)
	if "tx"[$e(v){
		if ($e(v)="x"){
			return:(",CheckTruthValues,CheckSameVDF,"'[(","_caller_","))&&(pti(val)="") 0 // this is same as a n node for correlated field
			return:$g($$$mtVtrName(val))="%pID" 0 
			if (",DetectTruthValues,CheckTruthValues,DetectSameVDF,CheckSameVDF,"[(","_caller_","))&&('infoComp) {
	      		set rtpcTVLogInfo=$g(rtpcTVLogInfo)_$lb("x^"_$$getParameterName(caller,$p(v,"^",2),queryType,sqlvarcparm))
	      		return:",CheckTruthValues,CheckSameVDF,"[(","_caller_",") 1	
	      	}
	      	set ptiVal = pti(val)
			set:$e(ptiVal,1,3)="$g(" ptiVal = $e(ptiVal,4,*-1)
      		if ('infoComp)&&('$match(ptiVal,"SQLrtpcv\d+")) {
				if ptiVal'["." {
					if ($E(ptiVal)'="%")&&($E(ptiVal,1,2)'="i%") {
						set parms = parms_$S(parms'="":",",1:"")_$P(ptiVal,"(")
					}
					if $P(ptiVal,"(",2,*)'=""{
						set subs=$P($P(ptiVal,"(",2,*),")")
						for i=1:1:$l(subs,","){
							set sub=$p(subs,",",i)
							continue:($isvalidnum(sub))||($E(sub)="%")||($E(sub,1,2)="i%")||($E(sub)="""")
							set parms = parms_$S(parms'="":",",1:"")_sub
						}
					}
				} elseif ($E(ptiVal)'="%")&&($E(ptiVal,1,2)'="i%") {
					do adset^%qaqcasl("SQLrtpcv"_val,ptiVal)
					set pti("update") = $g(pti("update"))_$lb(val)
					set parms = parms_$S(parms'="":",",1:"")_$P(ptiVal,".")
				}
			}
      		set allLiteral = 0
      	} else {
			// if ($e(v)="t")
			return:$g($$$mtVtrName(val))="%VID" 0
			if (",DetectTruthValues,CheckTruthValues,DetectSameVDF,CheckSameVDF,"[(","_caller_","))&&('infoComp) {
				// we use x^ and t^ to distinguish t^aaa and x^aaa, 
				// so (('aaa'))=:bbb and :aaa=:bbb would not have the same hash
	      		set rtpcTVLogInfo=$g(rtpcTVLogInfo)_$lb(v) 
	      		return:",CheckTruthValues,CheckSameVDF,"[(","_caller_",") 1	
	      	}  	
		}
		set tag = "", mod = 0
		if ('infoComp)&&(pti(val)'=("SQLrtpcv"_val))&&('$g(mt("options","parallelQuery"),0))&&('$g(mt("options","shardLocalQuery"),0)){
			If mt("sqlcomp")="%Runtime",'$d(mt("unary",val,"%ODBCIN")) {
				d adset^%qaqcasl("SQLrtpcv"_val,$$appmeth^%qaqcpr(pti(val),"RuntimeToLogical",val))
				set pti("update") = $g(pti("update"))_$lb(val)	
			}
			ElseIf mt("sqlcomp")="%ODBC",'$d(mt("unary",val,"%ODBCIN")) {
				d adset^%qaqcasl("SQLrtpcv"_val,$$appmeth^%qaqcpr(pti(val),"OdbcToLogical",val))
				set pti("update") = $g(pti("update"))_$lb(val)	
			}
			ElseIf mt("sqlcomp")="%EXTERNAL",'$d(mt("unary",val,"%ODBCIN")) {
				d adset^%qaqcasl("SQLrtpcv"_val,$$appmeth^%qaqcpr(pti(val),"DisplayToLogical",val))	
				set pti("update") = $g(pti("update"))_$lb(val)	
			}
			ElseIf mt("sqlcomp")="%FDBMS",'$d(mt("unary",val,"%EXTERNAL")) {
				i $e(v)="t" d adset^%qaqcasl("SQLrtpcv"_val,$$appmeth^%qaqcpr(pti(val),"DisplayToLogical",val))
				e  d adset^%qaqcasl("SQLrtpcv"_val,$$appmeth^%qaqcpr(pti(val),"FDBMSToLogical",val))
				set pti("update") = $g(pti("update"))_$lb(val)	
			}
			if $listfind($g(pti("update")),val) {
				set dat = "SQLrtpcv"_val	
			} else {
				set dat = pti(val)
			}
				
			if '$d(mt("unary",val,"%ODBCIN")) {	
				if ($$$mtStatementType="INS"||($$$mtStatementType="UPD")) && ((","_$g($$$mtNewVals)_",")[(","_val_",")) {
					if $case($$$VTRgetcat(val),"TIMESTAMP":1,"POSIXTS":1,:0),$g(mt("options","source-tsql"))=1 { 	// New values for INSERT or UPDATE, don't normalize unless this is a TIMESTAMP or POSIXTIME for TSQL statement
						do adset^%qaqcasl("SQLrtpcv"_val,"$s("_dat_"="""":"""",1:$$ConvertDATETIMEToTIMESTAMP^%qarfunc("_dat_",,,,"_($$$VTRgetcat(val)="POSIXTS")_"))")
						set pti("update") = $g(pti("update"))_$lb(val)
					}			
				} else {
					set directdat=$s($e(dat,1,3)="$g("&&($e(dat,*)=")"):$e(dat,4,*-1),1:dat)
					#;s normalize=$$appmeth^%qaqcpr(pti(val),"Normalize",val)	// DPV3208
					if $$$VTRgetcat(val)="INTEGER" {
						d adset^%qaqcasl("SQLrtpcv"_val,"$s("_dat_"="""":"""",$isvalidnum("_directdat_"):+"_directdat_",1:"_directdat_")")		// Don't normalize value if NULL
						set pti("update") = $g(pti("update"))_$lb(val)
					} elseif $$$VTRgetcat(val)="NUMERIC"||($$$VTRgetdt(val)="%Library.Float"||($$IsA^%occLibrary($$$VTRgetdt(val),"%Library.Float"))) {
						d adset^%qaqcasl("SQLrtpcv"_val,"$s("_dat_"="""":"""",$isvalidnum("_directdat_"):+"_directdat_",1:"_directdat_")")		// Don't + value if NULL
						set pti("update") = $g(pti("update"))_$lb(val)
					} elseif $$$VTRgetcat(val)="DOUBLE" {
						d adset^%qaqcasl("SQLrtpcv"_val,"$s("_dat_"="""":"""",$isvaliddouble("_directdat_"):$double("_directdat_"),1:"_directdat_")")	// Don't $double value if NULL
						set pti("update") = $g(pti("update"))_$lb(val)
					} elseif $case($$$VTRgetcat(val),"TIMESTAMP":1,"POSIXTS":1,:0) {
						if $g(mt("options","source-tsql"))=1 {
							do adset^%qaqcasl("SQLrtpcv"_val,"$s("_dat_"="""":"""",1:$$ConvertDATETIMEToTIMESTAMP^%qarfunc("_dat_",,,,"_($$$VTRgetcat(val)="POSIXTS")_"))")
							set pti("update") = $g(pti("update"))_$lb(val)
						} else {
							d adset^%qaqcasl("SQLrtpcv"_val,"$s("_dat_"[""."":$zstrip($zstrip("_directdat_","">W"",""0 ""),"">"","".""),1:$zstrip("_dat_","">W""))")	// Don't normalize value if NULL
							set pti("update") = $g(pti("update"))_$lb(val)
						}
					}
				}
			}
		}
		return 1	
	} elseif $e(v)="f"{
		return:(caller="DetectTruthValues")||(caller="DetectRange")||(caller="CheckTruthValues")||(caller="CheckSameVDF") 0
		set hasField = 1,ifn = $p(v,"^",3)
		set col=$p(ifn,"_",2)
		if col'=""{
			// collation should not contain max truncate length
			return:($$$SQLCOLLATIONS'[(","_col_","))&&('(($$$ISENCODEDCOLLATE(col))&&(col'["("))) 0
		}
		if ((parentOps'="")&&(caller'="DetectListLength")){
			set ptr = 0
    		while $LISTNEXT(parentOps,ptr,value) {
	         	return:'$$isOnetoOneFunc(value) 0	
   			 }	
		}
		if '$D(hasField("f")){
			set hasField("f")=+ifn	
			Set hasOutlier=$$getoutlier^%qaqomul(+ifn,.osel,.oval,.ocol)
			if (caller'="DetectListLength") return:('hasOutlier)||($G(osel)="") 0
			set m = $p(v,"^",2)
			try{
				set sel = $p($g(ptv(val)),"^",10)
				set:sel="" sel = +$$ddfldst2^%qaqpqo(m,ifn)
			} catch { return 0 }
			return 1
		} elseif ((+ifn)'=hasField("f")){
			return 0	
		} else {
			return 1	
		}
	} elseif $e(v) = "v" {
		set op = $p(v,"^",2)
		if ((op ["USERDEFINEDFUNCTION")&&(",DetectListLength,DetectSameVDF,CheckSameVDF,"'[(","_caller_","))) {
			return 0	
		} 
		if ('infoComp)&&(",DetectTruthValues,"[(","_caller_",")) {
	      	return:$l($p(v,"^",3))>=2 0 // this is not a streamless expression
	    } 
	    if (",DetectTruthValues,CheckTruthValues,DetectSameVDF,CheckSameVDF,"[(","_caller_","))&&('infoComp) {
	      	set rtpcTVLogInfo=$g(rtpcTVLogInfo)_$lb(op)
	    } 
		//check all the args in this expression
		set isValid = 1
		for i=4:1{
			quit:$p(v,"^",i)=""
			set isValid = isValid&&$$dfsXprs(infoComp,queryType,sqlvarcparm,$p(v,"^",i),caller,parentOps_$LB(op),.parms,.hasField,.osel,.oval,.sel,.ocol,.allLiteral)	
		}
		return isValid
	} else {
		return 0	
	}
}
getParameterName(caller,parameter,queryType,sqlvarcparm) PUBLIC{
	if (queryType = 1) {
		if ((sqlvarcparm'="")&&($E(parameter,1,5) = "%parm")) {
		   	return sqlvarcparm_$S($E(sqlvarcparm,*)="(":$E(parameter,7,*),1:+$E(parameter,7,*))	
		}	
	} elseif (queryType = 2) {
		if ($E(parameter,1,5) = "%parm") {
		   	return "%CallArgs"_$E(parameter,6,*)	
		}
	}
	return parameter
}
isOnetoOneFunc(func) PUBLIC{
	// collation should not contain max truncate length, 
	return:$$$SQLCOLLATIONS[(","_func_",") 1
	return:($$$ISENCODEDCOLLATE(func))&&(func'["(") 1
	return ",+,-,*,/,\,**,_,CHAR,DATEADD,DEGREES,EXP,JSON_ARRAY,JSON_OBJECT,LISTBUILD,LISTFROMSTRING,LISTTOSTRING,LOG,LOG10,%OBJECT,%ODBCIN,%ODBCOUT,POWER,RADIANS,REPEAT,REPLACE,REPLICATE,REVERSE,SQRT,STUFF,TOCHAR,TODATE,TOPOSIXTIME,TOTIMESTAMP,TRANSLATE,"[(","_func_",")	
}
.
updatePti() [pti] public {
	if $d(pti("update")){
		set ptr = 0
   		while $LISTNEXT(pti("update"),ptr,ptiVal) {
     		set pti(ptiVal) = "SQLrtpcv"_ptiVal
   		}	
   		kill pti("update")
	}
	return $$$OK
}
.
HasOutliers() [ mt, rtpc, call, smd] public {
	// $LB(oval,fieldname,collation,val1,val2,v,op,hasOutlier,allowedOp) ; value of outlier 
	// rtpc("outlierval",v) refers to a hostvariable in mt("v",v) and is a $LB list with following structure
	//	1) outlier value for field
	//	2) name of field with outlier value
	//	3) name of collation, e.g., %SQLUPPER
	//	4) val1 - LHS of comparison, usually the field (LHS logically not physically in line)
	//	5) val2 - RHS of comparison
	//	6) logical condition containing LHS and RHS and comparison operator as stored in mt("v")
	//	7) op - op in logical condition
	//  8) hasOutlier - if field (2) has outlier 1, otherwise 0
	//	9) allowedOp - if op is allowed 1, otherwise 0.  Currently only operators expressing equality, inequality, IN or %INLIST are allowed comparison operators.
	
	
	// walk logical conditions in mt("w") which is list of logical conditions in where clause
	// then use lvtree to descend upon each mt("l") and process outlier vars from equality, inequality conditions and "IN"
	n %log,call
	Set outliers=""
	Set mt("rtpc","outliersexist")=0
	Set k="" for { Set k=$o($$$mtWhere(k),1,loglist) q:k="" 
		For i=1:1 {
			Set log=$P(loglist,"^",i)
			Set %log=log
			q:log=""
			Set call="ProcessOutliers^%qaqcoutlier"
			Do lvtree^%qaqpnl("l",log)
.
		}
	}
	Set mt("rtpc","outliersexist")=($D(rtpc("outlierval"))>0)
	RETURN mt("rtpc","outliersexist")
}
.
.
ProcessOutliers
	GOTO:ev="l" lvarg^%qaqpnl
	Do ProcOutliers(ev,v)
	QUIT
	
ProcOutliers(ev,v) [mt, rtpc ] {
	// input - mt (parse tree)
	// output rtpc("outlierval",v") where v is an index into mt("v") (mt("v",v)) and the first piece with
	// respect to "^" must be "x"
	
	// v - logical condition, comparing field $$$mtV(v1) to $$$mtV(v2)
	// v1 - field index in mt("v")
	// v2 - what field is being compared to, also an index of mt("v")
	// val1 - mt("v",v1) - i.e. field, if v1 is not null, otherwise null
	// val2 - mt("v",v2) - i.e., what field is being compared to,
	// ifn1 - field number from val1
	
	Set op=$zcvt($P(v,"^",2),"U") // upper case of operator
	RETURN:ev'="v"
	// operator is one of equality, inequality, or IN
	// current assumptions is that the comparision is of the form v1 op v2 where v1 is a field and v2 is a constant, this assumption may not be valid
	Set v1=$P(v,"^",4)
	Set v2=$P(v,"^",5)
	RETURN:(+v1=0 || (+v2=0))  
	// QUIT condition, v1 or v2 is empty
	Set val1=$$$mtV(v1) ; field in comparision
	Set val2=$$$mtV(v2) ; RHS of comparison
	Set ifn1=$P(val1,"^",3)
	Set fieldname=$$$smdGetFieldName(+ifn1)
	Set hasOutlier=$$getoutlier^%qaqomul(+ifn1,.osel,.oval)
	Set allowedOp=(",ONEOF,INSET,IN,=,'=,"[(","_op_","))
	QUIT:'hasOutlier
	QUIT:oval=""
	QUIT:'allowedOp
	Set collation=$P(ifn1,"_",2)
	; if field's collation (collation variable above) is not equal to default collation, (stored in smd), then RETURN oR QUIT
	; if equal to default go on and process
	If $$MatchOp(v2,"SET:SETOF") { // JSL5051 change how operand is used and use invar instead, JSL5195 uaw $$MatchOp
		// IN processing
		For operand=4:1:$L(val2,"^") {
			Set invar=$PIECE(val2,"^",operand)
			Continue:invar=""
			Set val=$$$mtV(invar)
			// currently don't support arbitray nested conditions
			If $E(val)="x" {
				Set found=invar
			} ElseIf $E(val)="v",$PIECE(val,"^",2)=collation,$e($$$mtV($PIECE(val,"^",4)))="x" {
				Set found=$PIECE(val,"^",4)
			} Else { 
				continue ; Do not RTPC tranform the invar
			}
			Set newcondition="v^=^,"_v1_",^"_v1_"^"_found_"^" // check if equals to outlier value 
			Set rtpc("outlierval",found)=$LB(oval,fieldname,collation,val1,val2,newcondition,op,hasOutlier,allowedOp) ; value of outlier 
		}
	}
	ElseIf $$MatchOp(v2,"SET:LIST") { // JSL5051 change how operand is used and use invar instead, %INLIST, JSL5195 - use $$MatchOp
		// %INLIST outlier processing
		For operand=4:1:$L(val2,"^") {
			Set invar=$PIECE(val2,"^",operand)
			Continue:invar=""
			If $$findtree^%qaqcpr("v",invar,"aqnf")  {
				Quit
			}
			Set found=$$findtree^%qaqcpr("v",invar,"x")
			if found {
				Set rtpc("outlierval",found)=$LB(oval,fieldname,collation,val1,val2,v,op,hasOutlier,allowedOp) ; value of outlier 
			}			
		} // end operand loop for %INLIST
	} Else {
		If $E(val2)="x" {
			Set found=v2
		} ElseIf $E(val2)="v",$PIECE(val2,"^",2)=collation,$e($$$mtV($PIECE(val2,"^",4)))="x" {
			Set found=$PIECE(val2,"^",4)
			
		} Else { 
			Set found=0
		}	
		Set:found rtpc("outlierval",found)=$LB(oval,fieldname,collation,val1,val2,v,op,hasOutlier,allowedOp) ; value of outlier 
	}
	QUIT
}
.
.
MatchOp(v,op) [mt] {
	RETURN:v="" 0
	Set val=$$$mtV(v)
	RETURN:$P(val,"^",2)=op 1
	RETURN:$P(val,"^")="x" 0
	RETURN $$MatchOp($P(val,"^",4),op)
	
}
.
RemoveInListOutliers(sql) [ mt, rtpc ] {
		Set v="" For {
			Set v=$o(rtpc("inlist",v),1,sizelist) Quit:v=""
			Set size=$LG(sizelist,1)
			If size '="" {
				Set bl=$LG(sizelist,2),el=$LG(sizelist,4),bt=$LG(sizelist,3),et=$LG(sizelist,5)
				// we have a SIZE constant on %INLIST
				For j=bl:1:el {
					if bl=el {
						Set sizetext=sql(j)
						Set $e(sizetext,bt,et)=$$getspaces(et-bt+1)
						Set sql(j)=sizetext
					} else {
						If j=bl {
							Set sizetext=sql(j)
							Set $e(sizetext,bt,*)=$$getspaces($L(sizetext)-bt+1)
							Set $LI(sql,j)=sizetext
						} ElseIf j=el {
							Set sizetext=sql(j)
							Set $e(sizetext,1,et)=$$getspaces(et)
							Set sql(j)=sizetext
						} Else {
							Set sql(j)=$$getspaces($L(sql(j)))
						}
					}
				}	
			}		
		}
.
}
.
getspaces(count) [] {
	Set spaces=""
	For i=1:1:count {
		Set spaces=spaces_" "
	}
	Quit spaces
}
.
GetText(&sql) [ mt, rtpc ] {
	Set bl=""
	Set el=""
	Set textAtEnd=""
	For { 
		Set oldel=el
		Set bl=$order(rtpc("varposmap",bl))
		Quit:bl=""
		Set textBeforeLine=textAtEnd
		if bl>oldel {
			For i=oldel+1:1:bl-1 { // gather previous lines
   				Set textBeforeLine=textBeforeLine_$e($g(sql(i)),1,*)
			}
		}
		Set textAtEnd=""	     		
		Set bt=""
		Set et=""
		For { 
			Set bt=$order(rtpc("varposmap",bl,bt),1,v)
			Quit:bt=""
			Set textBeforePosition=textBeforeLine
			Set textBeforeLine=""
			// we now have the v (which may be identical) in order of position
			Set positions=rtpc("varmap",v,bl,bt)
	        If positions '="" {
		          // Gather text into a list
		          // Gather outlier expresions into a list
		          // positions is of the form
	          	  // bl - beginning line
	          	  // bt - beginning of token on beginning line
	          	  // el - end line for variable (a host variable can span multiple lines)
	          	  // et - end of token on end line
	          	  // btel - begining of token on end line (which could be bt when bl=el)
	          	  Set el=$LI(positions,1)
	          	  Set oldet=et
	          	  Set et=$LI(positions,2)
	          	  Set op=$LI(positions,3)
	          	  Set oldbtel=$g(btel)
	          	  Set btel=$LI(positions,4)
	          	  If bl=el {
				  		Set textBeforePosition=textBeforePosition_$e($g(sql(bl)),oldet+1,bt-1)
	          	  } 
				  Set rtpc("text",v,bl,bt)=textBeforePosition
		      
			} // endif if positions is non-null
			Set fbt=$order(rtpc("varposmap",bl,bt),1,fv) // look at next bt
			if fbt=""
			{
				Set textAtEnd=$e($g(sql(bl)),et+1,*)
			} else {
				Set textAtEnd=""
			}
		} // end for tokens on line
.
	} // end processing all sql lines
    // get text from end
    If $D(el) {
	    Set restOfLine=$e($g(sql(el)),$g(et)+1,*)
	    For i=el+1:1:sql {
		    Set restOfLine=restOfLine_" "_$g(sql(i))
	    }
	    Set:restOfLine'="" rtpc("text",0,0,0)=restOfLine
    } else {
	    // the text is solid with no host variables
	    For line=1:1:sql {
		    Set rtpc("text",0,line,1)=$g(sql(line))
	    }
    }
}
.
GenRunTimeStub(&sql, sqlhash,&stubGenSQLExpr) [ fplan, mt, rtpc ] public {
	Do:'fplan GetStubSQLExpr(.sql,sqlhash,.stubGenSQLExpr)
	;RETURN:$g(%showplangeneration)
	Do GenCode(.sql,sqlhash,$s(fplan:$g(mt("rtpc","RTUqexp")),1:$g(stubGenSQLExpr)))
    
}
.
GetStubSQLExpr(&sql, sqlhash, &stubGenSQLExpr) [ mt,asl,rtpc,pti ] {
	//  JSL5087
	Merge sql1=sql
	Set sql1=sql
	;Do FilterOutNonCandidates()
	Do RemoveInListOutliers(.sql1) // For inlists where the field we are finding is an inlist need to remove the SIZE statement
	Do GetText(.sql1)
	Set stubGenSQLExpr=$$GetSQLGenExpr()
}
.
GenCode(&sql,sqlhash,stubGenSQLExpr) [ mt,rtpc, fplan ] public {
	// *** ACTUAL CODE GENERATION
	Do setcode("New rtuclassname,Status,err,origsql,sqlrtu,compOptions,compOptionString")
	Do setcode("Set compOptions=0,sqlrtu="""_stubGenSQLExpr)
	;Do setcode("Set sqlrtu="""_$replace($s($e(stubGenSQLExpr,*)=")":stubGenSQLExpr,1:stubGenSQLExpr_""""),"""",""""""))
	;Do setcode("Set sqlrtu="""_$s($e(stubGenSQLExpr,*)=")":$replace(stubGenSQLExpr,"""",""""""),1:$replace(stubGenSQLExpr,"""","""""")_""""))
 	For i=1:1:$g(%compOptions) { // JSL5183
 		if %compOptions(i)["xDBC" { continue }  // Do not include xDBC* compile options
		Do setcode("Set compOptions=compOptions+1,compOptions(compOptions)="_$$quoter(%compOptions(i)))
 	}
 	if $$$SQLCompileOption("xDBCCompileMode")=1,$$$SQLCompileOption("xDBCServerProtocol")>6,$case($$$SQLCompileOption("xDBCFunction"),"DU":0,"DQ":0,:1) {
	 	Do setcode("Set compOptions=compOptions+1,compOptions(compOptions)=""{""""RTUXdbc"""":1}""")
 	}
 	Do setcode("Set:$D(%sqlrtu) %sqlrtu=sqlrtu")
 	Do setcode("Set sqlrtu=$$ApplyCompOptions^%qaqcoutlier(sqlrtu,.compOptions)") // JSL5183
	Do setcode("Set:$D(%sqlrtu) %sqlrtu=sqlrtu")
	Do setcode("QUIT:$g(%showplan)")
	Do setcode("Set Status=1")
	Do setcode("Set rtuclassname=""%sqlcq.""_$tr($namespace,""%_-$@:/\[]^ ."",""pudssssssssss"")_"".H""_$e($tr($system.Encryption.Base64Encode($system.Encryption.SHA1Hash(sqlrtu)),""%_-$@:/\+[]^ ."",""pudssssssssss""),1,10)_"".cls1""")
 	Do setcode("Try {")
  	Do setcode($c(9)_"Set "_$$$getVarName("rtoref")_"=$classmethod(rtuclassname,""%New"")")
 	Do setcode("} Catch err {")
        // JSL5129+
	Do setcode($c(9)_"If $system.Status.GetErrorText(err.AsStatus())[""<CLASS DOES NOT EXIST>"" {")
	Do setcode($c(9,9)_"Set "_$$$getVarName("rtoref")_"=""""")
	Do setcode($c(9)_"} ElseIf err.Code=5131 { ")	
	Do setcode($c(9)_"// Query DependentChange")
	Do setcode($c(9,9)_"Do PurgeRtn^%SYS.SQLSRV(rtuclassname)")
	Do setcode($c(9,9)_"Set "_$$$getVarName("rtoref")_"=""""")
 	Do setcode($c(9)_"}")
 	Do setcode($c(9)_"Else { ")
 	Do setcode($c(9,9)_"Set SQLCODE=-400,%msg=""unexpected error from %OnNew""")
 	Do setcode($c(9,9)_"d SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) ")
 	Do setcode($c(9,9)_"throw err")
        // JSL5129-
 	Do setcode($c(9)_"}")
 	Do setcode($c(9)_"Set origsql="_sql)
 	For i=1:1:sql { 
	 	Do setcode($c(9)_"Set origsql("_i_")="_$$quoter(sql(i)))
 	} 
 	Do setcode("}")
  	;Do setcode("If "_$$$getVarName("rtoref")_"="""" { Set "_$$$getVarName("rtoref")_"=$$CreateNewRunTimeQuery^%SYS.SQLRTUMAKER(.origsql,"""_$get(%classname)_""","""_$get(rtname)_""","""_sqlhash_""",sqlrtu,rtuclassname,""i%%CursorData"","""_mt("sqlcomp")_""","_$LL(mt("output"))_","_+$g(rtpc("frozenplan"))_","""_$listtostring($g(mt("rtpc","str")))_""",.err,.Status)  If +Status=0 {  Throw ##class(%Exception.StatusException).CreateFromStatus(Status) } }")
  	Do setcode("If "_$$$getVarName("rtoref")_"="""" { Set "_$$$getVarName("rtoref")_"=$$CreateNewRunTimeQuery^%SYS.SQLRTUMAKER(.origsql,"""_$get(%classname)_""",$zname,"""_sqlhash_""",sqlrtu,rtuclassname,""i%%CursorData"","""_mt("sqlcomp")_""","_$LL(mt("output"))_","_+$g(rtpc("frozenplan"))_","""_$listtostring($g(mt("rtpc","str")))_""",.err,.Status)  If +Status=0 {  Throw ##class(%Exception.StatusException).CreateFromStatus(Status) } }")
  	;Do setcode("If +Status=1 { Do "_$$$getVarName("rtoref")_".OPEN()}")
  }
.
GetSQLGenExpr() [ mt, rtpc, sql, pti ] private {
	try {
		// bl - beginning line
		// el - ending line
		// bt - beginning of token on beginning line
		// et - end of token on ending line
		// Note beginning line can be ending line
		
		Set lastText=$g(rtpc("text",0,0,0))
		Set tsql=""
		Set bl=""
		Set sizestring=""
		For { 
			Set bl=$O(rtpc("varposmap",bl)) q:bl=""			
			Set bt="" 
			For { 
				Set bt=$O(rtpc("varposmap",bl,bt),1,v) q:bt=""
				Set expression=$P($g($$$mtV(v)),"^",2)
				Set hostexpression=$s(expression'="":":"_expression,1:"")
				Set isoutlier=+$LG($g(rtpc("outlierval",v)),8)
				Set allowedOp=+$LG($g(rtpc("outlierval",v)),9)
				Set op=$LG(rtpc("varmap",v,bl,bt),3) ; 
				Set prevtext = $$quoter($g(rtpc("text",v,bl,bt)))
				Set tsql=tsql_"_"_prevtext
				Set mv=v
				Set mbl=bl
				Set mbt=bt
				Set nextText=$$NextText(.mv,.mbl,.mbt)
				If op="%INLIST" {
					If mv=-1 { // mt("v") entry which comes after %INLIST expression
						Set size=$LG(rtpc("inlist",v))
						If (size="") {
							Set sizestring = """ SIZE ((-10)) """
						} else { 
							Set sizestring = """ SIZE (("_(-size)_"))"""	
						}
						Set lastInListText=nextText
					}
					If v=-1 { // end of %INLIST expression
						Set endinlist=$s($g(inlistcondexpression)'="":"_$s("_inlistcondexpression_":"_sizestring_",1:"""")",1:"")
						If $g(LastInListText)'="" {
							Set tsql=tsql_"_"_lastInListText_endinlist
						} Else {
							Set tsql=tsql_endinlist
						}
						Set LastInListText=""
					}		
				}
				If isoutlier,allowedOp {
					Set outlierval=rtpc("outlierval",v)
					Set oval=$LI(outlierval)
					Set collation=$LI(outlierval,3)
					Set vop=$PIECE($LI(outlierval,6),"^",2)
					Set outlierconstant=$$$newval("t^"_$$quoter(oval))
					Set pti(outlierconstant)=$$quoter(oval)
					Set outliercondition=$LI(outlierval,6) // All outlier conditions for the host variables within an %INLIST are the same.  One is as good as another.
					Set $PIECE(outliercondition,"^",4)=outlierconstant
					Set outlierlog=$$$newlog(outliercondition)
					Set eoval=$$quoter("(('"_oval_"'))") // JSL5192										
.
					if op="%INLIST" {
						Set inlistcondexpression=$$cond^%qaqcpr(outlierlog)
						Set tsql=tsql_"_"_$$quoter(hostexpression)
					} else {
						If collation="" {
							Set condexpression=$$cond^%qaqcpr(outlierlog)
							If vop="'=" { // JSL5192
								Set sExpression="$S("_condexpression_":"_$$quoter(hostexpression)_",1:"_eoval_")"
							} else {
								Set sExpression="$S("_condexpression_":"_eoval_",1:"_$$quoter(hostexpression)_")"
							}
							Set:sExpression'="" tsql=tsql_"_"_sExpression
						} else {
							Set collatedexpression="$$applycollation^%qaqcoutlier("_$$quoter(collation)_","_$e(hostexpression,2,*)_")"
							Set collatedoval=$$applycollation(collation,oval)
							If vop="'=" {
								Set condexpression=collatedexpression_vop_$$quoter(collatedoval)
							} else {
								Set condexpression=collatedexpression_"="_$$quoter(collatedoval)
							}
							Set collatedhostexpression=collation_"("_$e(hostexpression,1,*)_")"
							If vop="'=" { // JSL5192
								Set sExpression="$S("_condexpression_":"_$$quoter(collatedhostexpression)_",1:"_eoval_")"
							} else{
								Set sExpression="$S("_condexpression_":"_eoval_",1:"_$$quoter(collatedhostexpression)_")"
							}
							Set:sExpression'="" tsql=tsql_"_"_sExpression
						}
					}
				} else { // not an outiler or not an allowd op
					Set tsql=tsql_"_"_$$quoter(hostexpression)
				}
			}
			
		}
		;Set:lastText'="" tsql=tsql_lastText
		If lastText'="" {
			Set tsql=tsql_"_"_$$quoter(lastText)
		} 
	}
	catch (err) {
		throw err
	}
.
	Set tsql=$$RemoveComments(tsql)
	Set tsql=$$GetSelectNoRunTime^%SYS.SQLRTUMAKER(tsql)
	Set %RTUQueryExpression=tsql // COS expression evaluated by stub at runtime, must be newed by caller		
	QUIT tsql
}
.
NextText(&nv,&nbl,&nbt) [ mt, rtpc ] {
	Set nbt=$O(rtpc("varposmap",nbl,nbt),1,nv)
	if nbt="" { // beyond end of line
		Set nbl=$O(rtpc("varposmap",nbl))
		if nbl="" { // reached end of SQL statement
			Set nv=0
			Set nbl=0
			Set nbt=0
		} else { // at beginning of next line
			Set nbt=$O(rtpc("varposmap",nbl,nbt),1,nv)
		}
	}
	RETURN $zstrip($g(rtpc("text",nv,nbl,nbt)),"<W")
}
.
setcode(s) [ mt, rtpc ] {
	// JSL5171 so frozen plan for RTPC open can be saved, use "rtpc" as first subscript
	Set linenum=$i(rtpc("outliercode"))
	set rtpc("outliercode",linenum)=s
	RETURN
}
.
codegen() [ mt, rtpc  ] public { // called from %qaqcasl
	; JSL5171 so frozen plan for RTPC open can be saved, use "rtpc" as first subscript
	for i=1:1:$g(rtpc("outliercode")) {
		$$$liin(rtpc("outliercode",i))
	}
	RETURN
}
.
applycollation(fun,arg) public {
	RETURN:fun="%SQLUPPER" $$$SQLUPPER(arg)
	RETURN:fun="%ALPHAUP" $$$ALPHAUP(arg)
	RETURN:fun="%MVR" $$$MVR(arg)
	RETURN:fun="%UPPER" $$$UPPER(arg)
	RETURN:fun="%SQLSTRING" $$$SQLSTRING(arg)
	RETURN:fun="%STRING" $$$STRING(arg)
	RETURN:fun="%TRUNCATE" $$$TRUNCATE(arg)
	if fun["%COLLATE("{
		set parms=$P(fun,"(",2)
		do getCollateParms^%qaqcpre(parms,.parm1,.parm2)
		RETURN $$$COLLATET(arg,parm1,parm2)
	}
	if $$$ISENCODEDCOLLATE(fun){
		set parm1 = "", parm2 = ""
		do decodeCollate^%qaqcpre(fun,.parm1,.parm2)
		RETURN $$$COLLATET(arg,parm1,parm2)
	}
	RETURN ""
}
.
RemoveComments(psql) [] public {  // psql is a COS expression that generates SQL
		Set insidecomment=0 // 0 - outside of quotes, 1 - inside of quotes")
		Set tsql=""
		For ci=1:1:$L(psql) {
			Set cc=$e(psql,ci)
			Set nextcc=$e(psql,ci+1)
			If 'insidecomment {
				If cc="/",nextcc="*" {
					Set ci=ci+1
					Set insidecomment=1
					Set tql=tsql_" "
					// do nothing, cast everything inside comment away, including comment introducer and terminator
				} Else {
					Set tsql=tsql_cc
				}
			} Else {
					If cc="*",nextcc="/" {
						Set ci=ci+1
						Set insidecomment=0
					} 
			}
		}
		RETURN tsql
}
.
ApplyCompOptions(sqlrtu,&compOptions) public {  // JSL5183 The sqlrtu does not have the compiler options passed when code was generated
	Set compOptionString=""
	For iter=1:1:compOptions { Set compOptionString=compOptionString_" /*#OPTIONS "_compOptions(iter)_" */" } // Put SQL Comment Options back on the statement
	Set sqlrtu=sqlrtu_compOptionString
	Return sqlrtu
.
}
.
ValidCollation(collation) {
	QUIT:collation="" 1
	QUIT:collation="%SQLUPPER" 1
	QUIT:collation="%ALPHAUP" 1
	QUIT:collation="%MVR" 1
	QUIT:collation="%UPPER" 1
	QUIT:collation="%SQLSTRING" 1 
	QUIT:collation="%STRING" 1
	QUIT:collation="%TRUNCATE" 1 
	QUIT:$$$ISENCODEDCOLLATE(collation) 1 
	QUIT 0
}
.
#INCLUDE %quoter
.
---
