====
qaqojn2
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqojn2^MAC^^^0
%qaqojn2	// QO - Create join and ALG arrays for join algorithms
	;; COMPONENTS :: SQL/Optimizer
	#;
#INCLUDE %msql
#INCLUDE %qao 
#IF 0   ;-------------------------------------------------------------
 ; Description:   QO - Create join and ALG arrays for join algorithms
 ; Author:        Terry Ragon
 ; Date Started:  22 April 1988
 ; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
 ;
 ;  JMM756  (09/25/2016) - Join optimizer avoid <SUBSCRIPT> error due to badly compressed bitstring
 ;  PVA347  (01/27/2016) - Avoid <DIVIDE> error or possible <SUBCRIPT> overflow in queries with a huge number of join conditions 
 ;  PVA279  (02/12/2014) - Enhance ptres handling for longstanding defects 
 ;  PVA286  (09/23/2013) - Fix: Useless index chosen for UPDATE or DELETE with no WHERE clause 
 ;  PVA283  (09/14/2013) - Fix a case of Optimizer choosing bulding a temp file for a join when it makes no sense 
 ;  PVA268  (10/19/2012) - Fix <VALUE OUT OF RANGE> compiling an SQL statement with joins involving tables with CacheSQLStorage using complex expression subscripts 
 ;  PVA260  (06/07/2012) - Remove special case optimization for idkey joins that is superseded by PVA258, and also improve edge case. 
 ;  PVA258  (05/09/2012) - Optimize multi-key joins 
 ;  PVA256  (03/27/2012) - Enhance TOP .... ORDER BY optimization to use partial indexes more often 
 ;  PVA248  (12/19/2011) - Fix cases where %noindex hint changed the query answer.
 ;  PVA242  (07/28/2011) - Support a hint (%noindex) to not use indexes to satisfy the indicated condition. 
 ;  PVA218  (03/05/2010) - Fix a selectivity handling bug. 
 ;  PVA177  (05/06/2009) - Fix undesired plan bias for DISTINCT queries when there is no good index for DISTINCT 
 ;  PVA154  (09/01/2008) - Improve optimizer cost model : distinguish selectivity for complex conditions on map subscripts from that on map data
 ;  PVA157  (05/01/2008) - Support faster DISTINCT while preserving case (i.e. with FASTDISTINCT OFF )
 ;  PVA152  (11/08/2007) - Query Optimization improved for text and collection predicates
 ;  PVA073  (01/28/2005) - Avoid unnecessary data map access for "TOP n id .... ORDER BY id" queries; also for idkey columns. Also, additional TOP bugs.
 ;  PVA072  (11/10/2004) - Support pseudo conditions implied by TOP... ORDER BY in optimizer
 ;  PVA066  (08/25/2004) - Initial optimizer support for bit slice indexes 
 ;  PVA35   (05/15/2002) - Fix minor flaw in optimizer index access cost 
 ;  PVA33   (03/08/2002) - Consider an index if it contains join or ORDER BY attribute as data. 
 ;  PVA32   (02/06/2002) - Apply range optimizations to unrestricted index components
 ;  PVA31   (02/01/2002) - Consider using indexes even when no WHERE or ORDER BY clauses
 ;  PVA023  (10/24/2001) - Optimizer fails to prevent testing of some unnecessary conditions. 
 ;  PVA030  (09/28/2001) - poor index selection for join
 ;  PVA028  (08/28/2001) - Remove ptjorder/ptjouter structures from optimizer
 ;  PVA027  (08/01/2001) - Support a few optimizer directives on the FROM clause  
 ;  AK450   (08/18/2000) - Braam: Outer Join from a Constant
 ;  DPV1300 (05/01/2000) - Fix <NOLINE> error
 ;  AK430   (03/06/1999) - BERNE: Disable temp-files on virtual fields
 ;  AK392   (09/02/1999) - Query Optimizer alg() counter
 ;  AK315   (05/12/1998) - CCS: Multifield outer-join
 ;  DPV702  (01/03/1996) - Improve efficiency of QO:
 ;                           Move ^%qaoc2 here
 ;                           Move ^%qaoc3 here
 ;  MRP639 (08/23/1996) - Allow Conditional Map for Complex RANGE 
 ;                        Specifications...
 ;
 ;    TR01;TR02;TR05;TR08;TR09;AK125;MRP201
 ;-------------------------------------------------------------
 ;                       I N F O R M A T I O N
 ;-------------------------------------------------------------
 ;
 ; For a given stream, create join and ALG arrays for join algorithms
 ; Input variables:
 ;     qoqn: (sub)query #
 ;     qojsn: join set #
 ;     qosn:  stream # to be joined
 ; mts() array has been created
 ;
 ; Among others, the following structures are built for each map:
 ;    form() = cost formula values (uses $$$SSE1, etc as subscripts)
 ;    resknown = list of rest we know can be satisfied by map
 ;    resmaybe = list of rest that may be satisifed + needed streams
 ;    respar   = list of rest we know can partially be satisfied
 ;    respar(res) = partial selectivity processed due to this subscript
 ;    ressubk(mapsub) = known restrictions satisfied by this map sub
 ;    ressubm(mapsub) = maybe ...
 ;    ressubp(mapsub) = partial ...
 ;    change(rest #) = info needed to backout of cost formulas the
 ;               impact of this restriction should this restriction
 ;               already have been processed.  Its data value is
 ;               an ^-bracketed list of:
 ;                      cost formula subscript : selectivity
 ;               Every 'maybe' restriction is listed in 'change'.
 ;               With 'known' and 'partial' restrictions, we frequently
 ;               only list one restriction that will undo the 
 ;               selectivity
 ;               of several restrictions.  For example, if there are
 ;               several range restrictions on the same ifn, we only
 ;               put one of them in 'change()'.
 ;
 ; For a given stream, for each join ifn in mts(qoqn,qosn,"JOIN")
 ;    and for each appropriate combination of them, run through
 ;    all of the maps of this stream to determine what algorithms
 ;    are applicable for that join
 ;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: kill resalready for each new context of use of 'allmap' (used now in algorithm
 #;    generation for proper costing of temp files)
 #; PVA258: add n jamap
 k resalready n jamap
 #; First, run through each join ifn.  If one is an outer join, only
 #;     it can be used.
 #; qoouter = 1 if this is an outer join, else 0
 #; qoridifn = record id ^ bracketed list of ifns for the record id
 s qoouter=0,qoja="",qoridifn=$p(mts(qoqn,qosn),"^",5,6) i $p(qoridifn,"^",2)="" s qoridifn=$p(qoridifn,"^")_"^,"_$p(qoridifn,"^",1)_","
 #; qoja = join attribute ifns
 #; PVA258: Replace all the prior logic with buildjamaps and single loop
 d buildjamap(qoqn,qosn,.jamap,.qoouter)
 s qoja="" f  s qoja=$o(jamap(qoja)) q:qoja=""  s qojar=""  f  s qojar=$o(jamap(qoja,qojar)) q:qojar=""  d allmap(qoja,jamap(qoja,qojar),qojar)
 q
 #; PVA258: eliminate comp4,joinres; create buildjamap,countifn,addstrs,addifns,combinejainfo: whole new algorithm
 #;     fixing many errors and handling multi-key joins uniformly for outer joins and inner joins 
 #;      (for the moment, retaining all current restrictions on outer joins within the new logic).
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
buildjamap(qoqn,qosn,jamap,qoouter) [mts,mt] public
#;   qoouter set here; passed by reference
#;   jamap(jaifnlst,jarest) = jainfo : assumed passed by reference
 #;   where jaifnlst: compound join attribute list
 #;         jarest:   compound restrictions
 #;         jainfo:   compound equivalent of mts(..."JOIN"...)
 {  
    #; Structures used
    #;-----------------
    #;   Built from mts JOIN nodes one pass:
 	#; joins(ifn,streambitset)=$lb(jainfo,jcond)
 	#; joinstrs(streambitset)=ifnval bitset
 	#; jcondstrs(ifn,jcond)=LH stream bit set
 	#;    Note: strmlst entries in mts JOIN nodes are sorted and duplicate stripped
	#;
	#;   A join template is usef multi-key combination maximally exploiting a set of 
	#;     LH streams; Goal is to have as few as possible templates, while still having the most
	#;     useful. Few, because more lead to explosion in compile time. Algorithm below attempts
	#;     a fine line between enough without excess.
    #; jtmplt(strmbits)=$lb(jaifnlst,jarest,jainfo) join templates (one per 'interesting' set of streams)
    #; jtmpused(strmbits)  - defined if a template fully used by some map
 	
 	s $bit(emptybit,1)=0   // empty bit string safe in subscripts (canonic form -> <SUBSCRIPT>)
	s ifn="" for // collect information about joins
	{  s ifn=$o(mts(qoqn,qosn,"JOIN",ifn)) q:ifn=""
	   s jcond="" for
	   {  s jcond=$o(mts(qoqn,qosn,"JOIN",ifn,jcond),1,jainfo) q:'jcond
	   	  s strmlst=$p(jainfo,"^",3) s:strmlst="" strmlst="," // for const=*field joins
	      s cstrs=$$pctobit^%qaqomul(strmlst) s:cstrs="" cstrs=emptybit
	      s joins(ifn,cstrs)=$lb(jainfo,jcond) // don't care if overwrite
	          #; need to consider at most one join per ifn, streamset source (jother will find rest)
	      s:$p(jainfo,"^",4) qoouter=1
	      s strs=$bitlogic(strs|cstrs)
	      s $bit(joinstrs(cstrs),$p(mts(qoqn,qosn,"ATT",ifn),"^",5))=1
	      s jcondstrs(ifn,jcond)=cstrs
	   }
	}
	QUIT:'$d(joinstrs) // no joins
	s strused=""
	for // build full templates - that include all possible join target ifns
	{  s jaifnlst=",",jarest=",",jainfo="",ifnvbits="",cstrs=""
	   if $d(jtmplt) // already built at least one full template; build another from any unused stream/streamset
	   {  quit:$bitcount($bitlogic(strs&~strused),1)=0 //no more full templates worth building (outer join always quits here)
		  s strb="" for { s strb=$o(joinstrs(strb)) q:$bitcount($bitlogic(strb&~strused),1)>0 }
	   	  d addstrs(.cstrs,strb,.joins,.joinstrs,.ifnvbits,.jaifnlst,.jarest,.jainfo) // add ifns for strb + any strmsets now satisfied
	   }
	   if qoouter 
	   {  if $d(joinstrs(emptybit)) // add possible <const>=*<field> oj fields to template
	      {d addifns(.ifnvbits,joinstrs(emptybit),emptybit,.joins,.jaifnlst,.jarest,.jainfo)}
	   }
	   for // add streams/streamsets that add most ifns, till all ifns used
	   {  s strb="",maxadd=0,maxstrs="" for 
	      {  s strb=$o(joinstrs(strb)) q:strb=""
	         s ifnadd=$$countifn(cstrs,strb,.joinstrs,ifnvbits)
	         if ifnadd>maxadd {s maxadd=ifnadd,maxstrs=strb }
	      }
	      quit:'maxadd // have completed a full template
	      d addstrs(.cstrs,maxstrs,.joins,.joinstrs,.ifnvbits,.jaifnlst,.jarest,.jainfo)
	   }
	   s strused=$bitlogic(strused|cstrs)
	   s $p(jainfo,"^",3)=$$bitopc^%qaqomul(cstrs)
	   // JMM756+
	   // This works around a $bitlogic bug (PL #143062) which sometimes produces bitstrings which
	   // are logically correct but poorly compressed, and too long to use as subscripts.  This is
	   // safe to leave in place after the bug is fixed, since $l(cstrs) should then never exceed 100.
	   // The choice of 100 is arbitrary, but large enough to avoid wasted work in most cases, while
	   // small enough to ensure an encoded subscript length < 512.
	   if $l(cstrs)>100 {
	      s limit=$bitcount(cstrs),compressed=""
		  for ii=1:1:limit {
			 s:$bit(cstrs,ii) $bit(compressed,ii)=1
	      } 
	      s cstrs=compressed
	   }
	   // JMM756-
	   s jtmplt(cstrs)=$lb(jaifnlst,jarest,jainfo)
	}  
	if 'qoouter 
	{  s strb="" for // build partial templates, one for each LH stream or stream set
	   {  s strb=$o(joinstrs(strb)) q:strb=""
	      s jaifnlst=",",jarest=",",jainfo="",ifnvbits="",cstrs=""
	      d addstrs(.cstrs,strb,.joins,.joinstrs,.ifnvbits,.jaifnlst,.jarest,.jainfo)
		  s $p(jainfo,"^",3)=$$bitopc^%qaqomul(cstrs)
		  s jtmplt(cstrs)=$lb(jaifnlst,jarest,jainfo) 
	   }  
	}
	#; Application of templates to maps MUST BE CONSISTENT with logic in and use of testja/testmany in dosub
	s cstrs="" for
	{  s cstrs=$o(jtmplt(cstrs),1,jinfo) q:cstrs=""
	   s fjaifnlst=$li(jinfo),fjarest=$li(jinfo,2),fjainfo=$li(jinfo,3),fjaifndlst=$listfromstring(fjaifnlst)
	   s fjcbmap=$$pctobit^%qaqomul(fjarest)
	   s map="" for
	   {  s map=$o(mts(qoqn,qosn,"MAP",map),1,mapinfo) q:map=""  continue:",S,T,"[(","_$p(mapinfo,"^",6)_",")
	      s jaifnlst=",",jarest=",",jainfo="",jcbmap="",jfnd=0,strused=""
	      s mapsub="" for
	      {  s mapsub=$o(mts(qoqn,qosn,"MAP",map,mapsub),1,subinfo) q:mapsub=""  q:subinfo=0  q:+subinfo=9  continue:+subinfo=1  
	         s mapsubifn=$p(subinfo,"^",2)_$s($p(subinfo,"^",6)="":"",1:"_"_$p(subinfo,"^",6))
			 #; PVA260: consider match of %id ifn against idsub group of map subcripts
	         s pos=0
			 if $p(subinfo,"^",4)>0 // multi-part idkey representation in map
			 {  // look for possible rowid in join template
			 	s pos=$lf(fjaifndlst,$p(mts(qoqn,qosn),"^",5))
			 	s:pos mapsub=mapsub+$p(subinfo,"^",4)-1 
			 }
			 s:'pos pos=$lf(fjaifndlst,mapsubifn) s:'pos pos=$lf(fjaifndlst,+mapsubifn) 
	         if pos
	         {  s jfnd=1,ifn=$lg(fjaifndlst,pos),jcond=$p(fjarest,",",pos)
	            s jaifnlst=jaifnlst_ifn_","
	            s jarest=jarest_jcond_","
	            if '$bit(jcbmap,jcond) // This needed to handle possible multiple subs based on same ifn - don't want to accumulate extra selectivity
	            {  s $bit(jcbmap,jcond)=1
	               s jainfo=$$combinejainfo(jainfo,mts(qoqn,qosn,"JOIN",ifn,jcond))
	            }
	            s strused=$bitlogic(strused|jcondstrs(ifn,jcond))
	            continue
	         }
			 #; Check for 'subdone'; cannot rely on +subinfo, because that could be set for a join
			 #;    that is not part of this template (e.g. to a different stream)
		 	 quit:('$d(mts(qoqn,qosn,"CON",mapsubifn)) && '$d(mts(qoqn,qosn,"CON",+mapsubifn)) && '$d(mts(qoqn,qosn,"RANGE",mapsubifn)) && (+subinfo'=3 || '$d(mts(qoqn,qosn,"RANGE",+mapsubifn)))) 
	         continue:'jfnd // if good non-join before join, ok (later code will select strategies
	         #;                  to build join index from this index
	         quit // matched what we could
	      }
	      if jaifnlst'="," 
	      {  s usedAll=($bitcount($bitlogic(fjcbmap&~jcbmap),1)=0)
	         s:usedAll jtmpused(cstrs)=1
	         if qoouter {s $p(jainfo,"^",3)=$p(fjainfo,"^",3)} // oj must require all streams from the full template
	         else {s $p(jainfo,"^",3)=$$bitopc^%qaqomul(strused)}
	         s jamap(jaifnlst,jarest)=jainfo
	      }
	   }
	}
		
	s cstrs="" for // add jamap entry for any template that was never fully satisfied against a map (good for a temp file strategy)
	{ s cstrs=$o(jtmplt(cstrs),1,jlst) q:cstrs=""
	  if qoouter,'$d(jtmpused(cstrs)) {s jamap($li(jlst),$li(jlst,2))=$li(jlst,3) }
	  elseif '$d(jtmpused(cstrs))
	  {   
         // PVA347: But prune number of joins used from the template - these jamap entries are for building
         #;    temp files, and once there are enough subscripts to guarantee one row per look up, more only
         #;    only slow the build and use of temp, while creating possibility of selectivity underflow
         #;    for the join. Heuristic is to limit joins to combined selectivity of 1/ (100 * RHS cardinality)
.
         s fjaifnlst=$li(jlst),fjarest=$li(jlst,2),fjainfo=$li(jlst,3)
         s jaifnlst=",",jarest=",",jainfo="",strused=""
         s limsel=1/+mts(qoqn,qosn)/100
         for pos=2:1:($l(fjaifnlst,",")-1)
         {  
            s ifn=$p(fjaifnlst,",",pos),jcond=$p(fjarest,",",pos)
            s jaifnlst=jaifnlst_ifn_","
            s jarest=jarest_jcond_","
            s jainfo=$$combinejainfo(jainfo,mts(qoqn,qosn,"JOIN",ifn,jcond))
            s strused=$bitlogic(strused|jcondstrs(ifn,jcond))
            //Stop if we hit the selectivity limit AND at least one
            //joined stream has been identified (otherwise constant
            //conditions alone could trigger the limit)
            q:($p(jainfo,"^",2)<limsel)&&($bitfind(strused,1))
         }
         s $p(jainfo,"^",3)=$$bitopc^%qaqomul(strused)
         s jamap(jaifnlst,jarest)=jainfo
	  }
	}
    QUIT   
 }
countifn(cstrs,nstrs,joinstrs,ifnvbits) [] public // count how many ifns would be added by addstrs 
   #; All args as for addstrs, except all input (but joinstrs must be passed by reference)
 {   
	 s nstrs=$bitlogic(cstrs|nstrs),ifncnt=$bitcount(ifnvbits,1)
	 s cstrs2="" for
	 {  s cstrs2=$o(joinstrs(cstrs2),1,ifnvbits2) q:cstrs2=""  
	   	if $bitcount($bitlogic(cstrs2&~cstrs),1)>0 && ($bitcount($bitlogic(cstrs2&~nstrs),1)=0)
	   	{  s ifnvbits=$bitlogic(ifnvbits|ifnvbits2) 
	   	}
	 }
	 QUIT $bitcount(ifnvbits,1)-ifncnt
 }
.
addstrs(cstrs,nstrs,joins,joinstrs,ifnvbits,jaifnlst,jarest,jainfo) [mt] public
 #; cstrs: in/out : bit string of streams so far
 #; nstrs: input : bit string of streams to add
 #; joins, joinstrs : input(by reference) : join structures built by buildjamap
 #; ifnvbits: in/out : bit strinf of ifn vals used so far
 #; jaifnlst,jarest,jainfo : in/out : description of current join
 #;    NOTE: piece 3 of jainfo is not set up by this call
 {
	 s nstrs=$bitlogic(cstrs|nstrs)
	 s cstrs2="" for
	 {  s cstrs2=$o(joinstrs(cstrs2),1,ifnvbits2) q:cstrs2=""  
	   	if $bitcount($bitlogic(cstrs2&~cstrs),1)>0 && ($bitcount($bitlogic(cstrs2&~nstrs),1)=0)
	   	{  d addifns(.ifnvbits,ifnvbits2,cstrs2,.joins,.jaifnlst,.jarest,.jainfo) }
	 }
	 s cstrs=$bitlogic(nstrs)
	 QUIT
 }
addifns(curvbits,newvbits,strs,joins,jaifnlst,jarest,jainfo) [mt] public
 #; curvbits - in/out - current ifn val bits
 #; newvbits - input  - ifn val bits to add into curvbits if not already there
 #; strs     - input  - streams (bit set) associated with newvbits
 #; joins    - input  - join information by (ifn,stream set). Must be passed by reference.
 #; jaifnlst - in/out 
 #; jarest   - in/out
 #; jainfo   - in/out
 {  s ifnv=-1 for
	{  s ifnv=$bitfind(newvbits,1,ifnv+1) q:'ifnv  s ifn=$p($$$mtV(ifnv),"^",3)
	   if '$bit(curvbits,ifnv)
	   {  s jaifnlst=jaifnlst_$p($$$mtV(ifnv),"^",3)_","
	   	  s jarest=jarest_$li(joins(ifn,strs),2)_","
	   	  s jainfo=$$combinejainfo(jainfo,$li(joins(ifn,strs)))
	   	  s $bit(curvbits,ifnv)=1
	   }
	}
 }
combinejainfo(jainfo1,jainfo2) [] public // jainfo1 may be ""; doesn't handle piece 3 (stream list)
 {  if jainfo1="" QUIT jainfo2
    s $p(jainfo1,"^",1)=0
    s $p(jainfo1,"^",2)=$p(jainfo1,"^",2)*$p(jainfo2,"^",2)
    s $p(jainfo1,"^",4)=$p(jainfo1,"^",4)!$p(jainfo2,"^",4)
    s $p(jainfo1,"^",5)=$p(jainfo1,"^",5)_$e($p(jainfo2,"^",5),2,*)
    s sel1=$p(jainfo1,"^",6),sel2=$p(jainfo2,"^",6),$p(jainfo1,"^",6)=$s(sel2<sel1:sel2,1:sel1)
    quit jainfo1
 }
 #;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
allmap(jaifnlst,jainfo,jarest) ;
 #;
 #; process this map for this join attribute
 #; input parameter: JA ifn, value of mts(..."JOIN"...)
 #;              jaifnlst: join attribute ifn list, bracketed by comma
 #;              jainfo: value of mts(..."JOIN"...)
 #;              jarest: join restriction #(s), bracketed by commas
 new begsub,conrid,form,formlog,ifn,jasub,map,map0,mapsub,qojc,qojcr,qojrid,qonjsub,qonumjasub,qoorder,qosubdone,rangesub,resknown,resmaybe,respar,typ
 #; AK430+
 n vorused s vorused=0  ;  1 if jaifnlst contains a virtual field
 s ifn=""
 f  s ifn=$o($$$mtVirtualOrFields(ifn)) q:ifn=""  i jaifnlst[(","_ifn_",") s vorused=1 q
 #; PVA066: skip bit slice index
 s map="" f  s map=$o(mts(qoqn,qosn,"MAP",map)) q:map=""  s typ=$p(mts(qoqn,qosn,"MAP",map),"^",6) d:(typ'="S"&&(typ'="T")) map
 q
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
map ; for this join attribute, consider this map
 #; PVA072: add tressubk,jj,lnum,topsel
 #; PVA023: 'new' tchange so not left around.
 #; PVA157: added hasdist
 #; PVA256: added hastoprange
 n change,tchange,ressubk,ressubm,ressubp,tressubk,jj,lnum,topsel,hasdist,hastoprange
 n mapsubifn s mapsubifn="," ; TR05 added: mapsubifn = list of exact ifn subscripts in map
 n movdistcost,movdistcostb,dgood s (movdistcost,movdistcostb,dgood)=0 // PVA177: new variables
 k respar // PVA218: array entries were never cleared!!
 s qosubdone=0,jasub="",rangesub="",resknown="",resmaybe="",respar="",rangeifn="",qonjsub=0,qonumjasub=0
 s (hasdist,hastoprange)=0
 #;
 #; when qosubdone = 1, it means that subsequent subscripts are
 #; of interest for determining if restrictions can be processed
 #; on the restriction, but they should not be used for setting
 #; jasub or rangesub and their selectivity should be applied to
 #; the $$$SSOI subscript, not to the actual map subscript
 #; set qojrid = 1 if JA is record id
 #;
 i jaifnlst=$p(qoridifn,"^",2) s qojrid=1
 e  i $l(jaifnlst,",")=3,$p(jaifnlst,",",2)=$p(qoridifn,"^") s qojrid=1
 e  s qojrid=0
 k form,ptform // PVA152
 #; PVA154: New form() entries
 f i=$$$SSE1M,$$$SSE1,$$$SSJASUB,$$$SSJAADD,$$$SSE2M,$$$SSE2,$$$SSRM,$$$SSR,$$$SSE3M,$$$SSE3,$$$SSOI,$$$SSOID,$$$SSOIMUL,$$$SSOIMULD,$$$SSO0,$$$SSO0MUL,$$$SSOE,$$$SSJACOND s form(i)=1
 s form($$$SSJA)=$p(jainfo,"^",2),form($$$SSJAIN)=$p(jainfo,"^",6),form($$$SSJAADDM)=$s(form($$$SSJA)>form($$$SSJAIN):form($$$SSJAIN)/form($$$SSJA),1:1)
 #; PVA072: set up ptform() 
 #; PVA154: New form() entries
 f i=$$$SSE1M,$$$SSE1,$$$SSJASUB,$$$SSJAADD,$$$SSJAADDM,$$$SSE2M,$$$SSE2,$$$SSRM,$$$SSR,$$$SSE3M,$$$SSE3,$$$SSOI,$$$SSOID,$$$SSOIMUL,$$$SSOIMULD,$$$SSO0,$$$SSO0MUL,$$$SSOE,$$$SSJAIN,$$$SSJACOND,$$$SSJA s ptform(i)=form(i)
 #; PVA072: SSJACOND set up must account for whether range is  TOP: predicate
 #;         Also, because transitive elimination of RANGE when CON exists on same
 #;         ifn, is disabled for TOP: RANGE, set up for form() needs change as well
 #;         as ptform()
 f i=2:1:$l(jaifnlst,",")-1 {
	s c=$p(jaifnlst,",",i),a=$g(mts(qoqn,qosn,"CON",c)),b=$g(mts(qoqn,qosn,"RANGE",c))
	s:a form($$$SSJACOND)=form($$$SSJACOND)*a,formlog($$$SSJACOND)=$g(formlog($$$SSJACOND))_$p(a,"^",2)
	s:b form($$$SSJACOND)=form($$$SSJACOND)*b,formlog($$$SSJACOND)=$g(formlog($$$SSJACOND))_$p(b,"^",2)
 }
 s ptform($$$SSJACOND)=form($$$SSJACOND)
 if $d($$$mtTopLimit(qoqn)) {
   f i=2:1:$l(jaifnlst,",")-1 {
 	s c=$p(jaifnlst,",",i),b=$g(mts(qoqn,qosn,"RANGE",c)),a=$p(b,"^",2)
 	f jj=2:1 {s lnum=$p(a,",",jj) quit:lnum=""
 	  i $e($$$mtL(lnum),1,6)="v^TOP:"
 	  { s topsel=$$GetSel^%qaqomul(lnum)
 	    s ptform($$$SSJACOND)=ptform($$$SSJACOND)/topsel
 	    quit // Rely on there being only one TOP: condition for a given jaifnlst item
 	  }
 	}
   }
 }
 s begsub=$o(mts(qoqn,qosn,"MAP",map,"")) q:begsub=""
 s map0=map=$p(mts(qoqn,qosn),"^",4) ; map0 = 1 if this is map 0
 s qoorder=1 ; 1 => JA order is directly produced by this map if do a sort
 #; conrid = "CON" condition if there is a CON on the record id
 s conrid=$g(mts(qoqn,qosn,"CON",+qoridifn))
 #; If this is a conditional map, process the
 #; conditional map restrictions.  First, see
 #; what restrictions are exactly satisfied by the
 #; conditional map restrictions.
#IF 0   ; MRP639+
 s mapsub=0,x=mts(qoqn,qosn,"MAP",map) i $p(x,"^",3)'="" d known^%qaoj4(1,$$$SSE1M,$$$SSE1,$p(x,"^",3),"") ; TR09 added ^%qaoj4
#ELSE   ; MRP639=  (Allow Cond Map for Complex RANGE Specifications)...
 #; --- Process the Conditional Map Restrictions as Normal ---
 s mapsub=0,x=mts(qoqn,qosn,"MAP",map)
#ENDIF  ; MRP639-
 #; If there are any restrictions that are partially
 #; satisfied by the conditional map (i.e. the query
 #; restriction is more restrictive than the map restriction)
 #; then process them.
#IF 0   ; DPV1300+
 s x=$p(x,"^",4) f y=2:1:$l(x,"_")-1 s z=$p(x,"_",y) d cmappar
#ELSE   ; DPV1300=
 s x=$p(x,"^",4) f y=2:1:$l(x,"_")-1 s z=$p(x,"_",y) d cmapper
#ENDIF  ; DPV1300-
 s allinmap=1  // PVA248
 d %qaoj4^%qaqojn3
 d ^%qaqojn3 ; process additional "JOIN","CON","RANGE","COMP","MREL" restrictions
 d %qaoj2 ; Now its time to select algorithms
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; This routine currently never gets invoked, due to change in what is set up in %qaqpcmp. 
cmapper ; Process restrictions that are partially satisfied by,
 #; but are more restrictive than, the conditional map restriction
 #; input variable: z =
 #;        ,restriction #(s), : selectivity in cond map of
 #;                             corresponding restriction
 #; set maxsel = selectivity of restriction
 f c="CON","RANGE" s a="" f j=1:1 s a=$o(mts(qoqn,qosn,c,a)) q:a=""  s b=mts(qoqn,qosn,c,a) i $p(b,"^",2)[(","_$p(z,",",2)_",") s maxsel=+b g cmappar1
 #; PVA242: modify below for noindex, in case this routine is re-activated (see above).
 f c="COMP","MREL" s a="" f j=1:1 s a=$o(mts(qoqn,qosn,c,a)) q:a=""  i $bit(noindexmap,a)=0  i $p(z,":")[(","_a_",") s maxsel=+mts(qoqn,qosn,c,a) g cmappar1
 #; we didn't find it (but should have)
 #; it shouldn't have been a JOIN (or a MREL) restriction
 #; just make up a value for its partial selectivity
 s maxsel=+$p(z,":",2),maxsel=$s(maxsel*2<1:maxsel*2,maxsel*1.1<1:maxsel*1.1,1:1)
cmappar1 d partial^%qaqojn3(+$p(z,":",2),maxsel,$$$SSE1M,$$$SSE1,$p(z,":")) QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
%qaoj2 ; 
#IF 0   ;
 ; Collect additional information about this map and join
 ; input variables:
 ;  as described at top of qojinit:
 ;     qoqn,qojsn,qosn,form(),
 ;     resknown,resmaybe,respar,ressubk(),ressubm(),ressubp(),change()
 ;  also created in qojinit:
 ;     rangeifn: ifn of range subscript or unbounded subscript (PVA32).
 ;     qoridifn: record id ifn ^ comma bracketed list of component 
 ;               ifns of record id
 ;     jasub: subscript at which join attribute is found (or starts)
 ;            (null string if not found)
 ;     qonumjasub: # of subscripts that contain the join attribute
 ;             (0 if 'jasub)
 ;     rangesub: subscrt at which range is found (null string if none)
 ;               Also set for first unbounded subscript (PVA32)
 ;     map: map # being considered
 ;     map0: 1 if this is map 0
 ;     qojrid: 1 if JA is record id
 ;     qoouter: 1 if outer join
 ;     jaifnlst: join attribute ifn list, bracketed by comma
 ;     qoorder:  map automatically produces an interesting order
 ;     jainfo: value of mts(..."JOIN"...) or equivalent
 ;     jarest: join restriction #(s), bracketed by commas
 ;
 ;---------------------------------------------------------------------
#ENDIF  ;
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: Setting of ressub moved here from jfile1 because needed for setresalready2 call and also 
 #;   there is no need to compute it for every jfile1 call. It is constant over a given call to 
 #;   %qaoj2. Also, 'new' savchange,savform
 #; get list of restrictions by subscript
 n ressub,savchange,savform,tressub
 s ressub="" f i=$o(mts(qoqn,qosn,"MAP",map,"")):1:$o(mts(qoqn,qosn,"MAP",map,""),-1),"index","indexmul","map0","map0mul","outer" s ressub=ressub_"*"_i_":"_$g(ressubk(i))_":"_$g(ressubm(i))_":"_$g(ressubp(i)) 
 s ressub=$p(ressub,"*",2,99)
 #; PVA072; Now need a tressub for algorithms with a pre-process step
 s tressub="" f i=$o(mts(qoqn,qosn,"MAP",map,"")):1:$o(mts(qoqn,qosn,"MAP",map,""),-1),"index","indexmul","map0","map0mul","outer" s tressub=tressub_"*"_i_":"_$g(tressubk(i))_":"_$g(ressubm(i))_":"_$g(ressubp(i))
 s tressub=$p(tressub,"*",2,99)
 #; PVA023: make a copy of current change() for easy restoration after adjustment when temp algs 
 #;   generated
 s i="" f  s i=$o(change(i)) q:i=""  s savchange(i)=change(i)
 #; is the JA in the map?  If so, set jainmap = 1
 i 'qojrid f i=2:1:$l(jaifnlst,",")-1 i $p(mts(qoqn,qosn,"ATT",$p(jaifnlst,",",i)),"^",7)'[(","_map_",") s jainmap=0 g b
 s jainmap=1
#IF 0   ;
 ; find out how much is in this map and how much must
 ; be obtained from map 0
 ; set map0read or mapiread to indicate:
 ;           # fields read
 ; mapiread represents data contained in this map,
 ;     map0read represents other needed data
 ;     If this is map0, then mapiread is used for all data
 ; allinmap = 1 if everything is in this map
 ; calculate outnodes: (data needed to produce sort file)
 ;     # nodes to output , max total data length per tuple , 
 ;       average total data length per tuple
 ;     Don't include 7 bytes needed to store node overhead
#ENDIF  ;
#; PVA248: moved allinmap initialization to 'map' tag
b s map0read="",mapiread="",outnodes="1,0,0",d=0
 s a="" f  s a=$o(mts(qoqn,qosn,"ATT",a)) q:a=""  d nodes
 #; PVA030: remove completely bogus way of telling if data is in subscripts
 s qoslist=$p(jainfo,"^",3) ; list of streams to which joined
 #; setup other form() parameters
 s a=mts(qoqn,qosn,"MAP",$p(mts(qoqn,qosn),"^",4))
 #; PVA072: Now maintain ptform() as well as form
 s form($$$SNbtup)=$p(a,"^",2),form($$$SNbblk)=+a
 s ptform($$$SNbtup)=form($$$SNbtup),ptform($$$SNbblk)=form($$$SNbblk)
 #;
 #; calculate # tuples in 'index map' after satisfying all
 #; high level equals and implicit map restrictions.
 #; = # tuples in index * form($$$SSE1M)*form($$$SSE2M) / 
 #;   sel of implicit rest
 #; = # tuples in map 0 * form($$$SSE1M)*form($$$SSE2M)
 #;
 #; PVA072: Now maintain ptform() as well as form 
 s form($$$SNitup)=$p(a,"^",2)*form($$$SSE1M)*form($$$SSE2M)
 #; PVA073: Fix ptform maintenance to compute from ptform entries;
 #;         in some special situations TOP selectivity can be 
 #;         recorded in SSE1M/2M 
 s ptform($$$SNitup)=$p(a,"^",2)*ptform($$$SSE1M)*ptform($$$SSE2M)
 #;
 #; # blocks used in index (after satisfying all high level
 #; equals and implicit map restrictions.)
 #; = # blks in index * form($$$SSE1M)*form($$$SSE2M) / 
 #;   sel of implicit rest
 #;
 s b=mts(qoqn,qosn,"MAP",map)
#IF 0   ; MRP639+
 s form($$$SNiblk)=b*form($$$SSE1M)*form($$$SSE2M)/($p(b,"^",2)/$p(a,"^",2))
#ELSE   ; MRP639=  (Allow Cond Map for Complex RANGE Specifications)...
 #; --- Multiply by the % of Rows Specified by Conditional Map ---
 #; PVA072: Now maintain ptform() as well as form - note SSE1M and 2M
 #;         cannot be affectged by TOP: predicates.
 s form($$$SNiblk)=b*form($$$SSE1M)*form($$$SSE2M)*($p(b,"^",2)/$p(a,"^",2))
 #; PVA073: Fix ptform maintenance to compute from ptform entries;
 #;         in some special situations TOP selectivity can be 
 #;         recorded in SSE1M/2M 
 s ptform($$$SNiblk)=b*ptform($$$SSE1M)*ptform($$$SSE2M)*($p(b,"^",2)/$p(a,"^",2))
#ENDIF  ; MRP639-
 #; # data nodes we need to retrieve per tuple in index map
 #; PVA072: Now maintain ptform() as well as form
 #; PVA152: must allow for SGPi already haveing collection cost in it
 s form($$$SGPi)=1+$g(form($$$SGPi))
 s ptform($$$SGPi)=form($$$SGPi)
 #; # data nodes we need to retrieve per tuple in map 0
 #; PVA072: Now maintain ptform() as well as form
 #; PVA152: must allow for SGPb already haveing collection cost in it
 s form($$$SGPb)=1+$g(form($$$SGPb))
 s ptform($$$SGPb)=form($$$SGPb)
#IF 0   ;
 ; if join attribute is a subscript, calculate distribution
 ; of nodes.
 ; form($$$SL2B) = # of nodes at the join attribute subscript level
 ;         ('jasub') in which the node passes all $$$SSE1M and $$$SSE2M
 ;              restrictions (i.e. equals restrictions at and
 ;              above the JA)
 ; form($$$SZB)  = # of nodes at subscript level 'jasub'+1 (i.e.
 ;              immediately following the join attribute
 ;              subscript level) for each node at the 'jasub' level
 ; form($$$SL2B)*form($$$SZB) = % of time that for a given JA we will
 ;     find the JA in the index under the specified higher
 ;     level equals restrictions (not counting restrictions on JA)
 ; Don't consider selectivity of a restriction on the JA,
 ;   since we are only concerned about distribution here.  Note
 ;   that restrictions on the JA will be migrated to already
 ;   processed streams, so they will serve to cut down on the
 ;   number of input tuples (stream 'A') being processed, but
 ;   all those being considered will pass the JA restriction.
 ;  *****Is this also true for initial stream algs? I think so.
#ENDIF  ;
 #; PVA072: Now maintain ptform() as well as form
 i 'jasub s form($$$SL2B)=1,form($$$SZB)=1,ptform($$$SL2B)=1,ptform($$$SZB)=1 g c
 s c=(form($$$SNitup)/form($$$SSE2M))*form($$$SSJASUB) 
 #; i c>1, there is at least one tuple for each JA that passes all
 #;        high level restrictions (other than restrictions on the JA)
 i c>1 s form($$$SZB)=c,form($$$SL2B)=form($$$SSE2M)/form($$$SSJASUB)
 e  s form($$$SZB)=1,form($$$SL2B)=form($$$SNitup)
 #; PVA073: Fix ptform maintenance to compute from ptform entries;
 #;         in some special situations TOP selectivity can be 
 #;         recorded in SSE1M/2M 
 s c=(ptform($$$SNitup)/ptform($$$SSE2M))*ptform($$$SSJASUB) 
 #; i c>1, there is at least one tuple for each JA that passes all
 #;        high level restrictions (other than restrictions on the JA)
 i c>1 s ptform($$$SZB)=c,ptform($$$SL2B)=ptform($$$SSE2M)/ptform($$$SSJASUB)
 e  s ptform($$$SZB)=1,ptform($$$SL2B)=ptform($$$SNitup)
 #;
 #;*******Above formulas for $$$SZB and $$$SL2B don't work if
 #;*******there's a range above the JA (setting 'done' should
 #;*******keep this case from happening?)
 #;********$$$SZB and $$$SL2B probably don't matter in this case
 #;
c g %qaoj3
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nodes ; calculate map0read, mapiread, allinmap, outnodes
 #; PVA030: add variable m0imp
 n m0imp
 s:'map0&&(" UPD DEL "[(" "_$$$mtStatementType_" "))&&('$d($$$mtWhere(qoqn)))&&(qoqn=1) allinmap=0 // PVA286
 s b=mts(qoqn,qosn,"ATT",a),c=$p(b,"^",7)[(","_map_",")
 #; PVA030: Doesn't need to be read from node if in a subscript
 i c!map0 s:$$nosub(map,a) mapiread=mapiread+1 ;data is in this map (or this is map 0)
 e  s allinmap=0,m0imp=$p(mts(qoqn,qosn),"^",4) s:$$nosub(m0imp,a) map0read=map0read+1 ; data must be read from map 0
 QUIT:+b=1
 #; calculate average length of field + 2 for delmiter
 n a,c s a=$p(b,"^",4)
 if $p(b,"^",8)'= "" { s c = $p(b,"^",8)+ 2 }
 else { s c = $s(a>100:60,a>50:30,a>20:15,a>10:10,1:a)+2 }
 If $$$LimitGlobalNodeSize {i d+a>$$$MaxGlobalNodeSize s $p(outnodes,",")=outnodes+1,d=0} ; see if need to store in another output node
 s outnodes=+outnodes_","_($p(outnodes,",",2)+a)_","_($p(outnodes,",",3)+c),d=d+a
 QUIT
 #; PVA030: Add new function, nosub
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nosub(map,ifn) ; Check whether ifn is computable from subscript data of map
 #;      return 1 if not computable from subscript, else 0
 n sub,subinfo,ret s ret=1
 s sub="" f  s sub=$o(mts(qoqn,qosn,"MAP",map,sub),1,subinfo) q:sub=""  d  q:'ret
 . i ifn=($p(subinfo,"^",2)_$s($p(subinfo,"^",6)]"":"_"_$p(subinfo,"^",6),1:"")) s ret=0 q
 #; PVA35: must compare +ifn to complete ifn for subscript else think exact(ifn) is computable
 #;   from collate(ifn).
 . i +ifn=($p(subinfo,"^",2)_$s($p(subinfo,"^",6)]"":"_"_$p(subinfo,"^",6),1:"")) s ret=0 q
 QUIT ret
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
%qaoj3 ;
#IF 0   ;
 ; Select a set of join algorithms that can be used to process
 ;    a given join on a given map
 ; Input variables:
 ;   described at top of qojinit:
 ;      qoqn,qojsn,qosn,form(),
 ;      resknown,resmaybe,respar,ressubk(),ressubm(),ressubp(),change()
 ;   described at top of qoj2:
 ;      jasub,rangesub,map,map0,qojrid,qoouter,jaifnlst,jainfo,jarest
 ;      rangeifn,qoridifn,qoorder
 ;   also created in qoj2:
 ;      jainmap: 1 if JA in map
 ;      allinmap: 1 if all needed ifns are in map (or this is map0)
 ;      mapiread: data contained in map
 ;      map0read: data that must be obtained from map 0
 ;          format of mapiread & map0read:
 ;               # fields ^ max total length ^ ave total length
 ;      outnodes: amount of data needed to produce sort file
 ;      qoslist: list of streams to which this stream is joined
 ; PVA32: following is no longer true because of expanded meaning of rangesub    
 ; If outer join, then rangesub=""
 ;
 ;---------------------------------------------------------------------
#ENDIF  ;
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 n high,onestrm s onestrm=0 g nojasub:jasub="",range:rangesub
 #;
 #; we have JA as a subscript(s), there is no range subscript
 #; do subscripts below the JA include an equals restriction?
 #;
 #; PVA072: Without range processing (see 'range' tag)
 #;         with the JA provided in given map, only jalg1x options make
 #;         any sense. Cases left over from history removed rather than 
 #;         upgraded for TOP issues. 
 i form($$$SSE3M)-1 d jalg12 g done ; yes
 d jalg11 g done
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
range ; we have JA as a subscript(s) and we have a range subscript
 #; note that an outer join cannot have a range subscript
 #; is JA preceeded by a range subscript?
 i jasub>rangesub d jalg23,jalg34b g done
 #; do subscripts below JA include a range restriction?
 i jasub<rangesub d jalg13,jalg24:jainmap,jalg33b g done
#IF 0   ;
 ; range is on the (first) JA subscript
 ; When using JALG1, ignore range since it will be migrated
 ;   (not migrated for initial stream algorithms, whose cost formulas
 ;   closely parallel the join cost formulas, so be careful in writing
 ;    cost formulas.
 ; For index or sort creation:
 ;        increase $$$SSE1M and $$$SSE1 by $$$SSRM,$$$SSR
 ;        set rangesub="", $$$SSRM=1, $$$SSR=1 (i.e., ignore range)
 ;        reduce $$$SL2B by $$$SSRM, keep $$$SZB the same
 ;     ****Alternatively, we could modify cost formulas to
 ;         reflect these w/o change form().  Check cost
 ;         formulas to insure we aren't double booking
 ;         by increasing $$$SSE1 and decreasing $$$SL2B
 ;     ****modify descriptions of index/sort creation algorithms
 ;         to allow this (S4,S5, S9,S10 )
#ENDIF  ;
 #; PVA072: Restructure to make clear why no need to worry about ptform 
 i form($$$SSE3M)-1 { d jalg12 } else {d jalg11}
 d fix,jalg33a 
 g done
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA283: remove clearing of rangesub below; previously, nothing depended on it. Now prepform depends on the original value.
fix s form($$$SSE1)=form($$$SSE1)*form($$$SSRM),form($$$SSE1M)=form($$$SSE1M)*form($$$SSRM),form($$$SL2B)=form($$$SL2B)*form($$$SSRM),form($$$SSRM)=1,form($$$SSR)=1 
 #; PVA072: Also transform ptform
 s ptform($$$SSE1)=ptform($$$SSE1)*ptform($$$SSRM),ptform($$$SSE1M)=ptform($$$SSE1M)*ptform($$$SSRM),ptform($$$SL2B)=ptform($$$SL2B)*ptform($$$SSRM)
 s ptform($$$SSRM)=1,ptform($$$SSR)=1 
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nojasub ; no join attribute subscript, is there a range subscript?
 #; PVA32: All possible reasons for using this map use these algs if rangesub. This
 #;        subsumes the PVA31 change.
 #; PVA072: Use ptform() throughout since all algs use pre-process.
 #;         Unlike initial stream, there is no special case where a 
 #;         sort algorithm is not-preprocess. 
 #; PVA154: new SSOID now needed in following test
 i rangesub]"",ptform($$$SSOI)*ptform($$$SSOID)*ptform($$$SSRM)*ptform($$$SSE1M)<1!allinmap d jalg23,jalg34a g done ; yes
 #; PVA33: Consider index building algs if jainmap
 i rangesub]"",jainmap d jalg23 g done
 #; no - is there an equals subscript?
 i ptform($$$SSE1M)-1 d jalg22,jalg32 g done
 #; Don't consider this map unless this is map 0 -- actually, presumabley never
 #;     get here because map0 implies allinmap, and first unrestricted
 #;     subscript is now considered a rangesub.
 i map0 d jalg21,jalg31 g done ; if this is map 0, perform JALG-2-1, JALG-3-1 
 #; PVA32: PVA31 change merged with rangesub case above
done QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; Join algorithms.
 #; For every join algorithm that includes a sort, if this
 #; is not an outer join, then also consider merge sort
 #;
 #; Join algorithm names correspond to printed papers on this topic
 #;
jalg11 s high="jalg11" i allinmap d jfile("J2",.form,.change,ressub,map0,"","",0) q
 d jfile("J3",.form,.change,ressub,1,"","",0) QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
jalg12 s high="jalg12" i allinmap d jfile("J4",.form,.change,ressub,map0,"","",0) q
 d jfile("J5",.form,.change,ressub,1,"","",0) QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
jalg13 s high="jalg13" i allinmap d jfile("J6",.form,.change,ressub,map0,"","",0) q
 d jfile("J7",.form,.change,ressub,1,"","",0) QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
jalg21 s high="jalg21" d prepform("IC1",1),jfile("J1",.tform,.tchange,tressub,1,"IC1",$$ic1^%qaqoidx,0),temprestore QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
jalg22 s high="jalg22" i jainmap d prepform("IC2",1),jfile("J1",.tform,.tchange,tressub,1,"IC2",$$ic2^%qaqoidx,0),temprestore q
 d prepform("IC3",1),jfile("J1",.tform,.tchange,tressub,1,"IC3",$$ic3^%qaqoidx,0),temprestore QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
jalg23 s high="jalg23" i jainmap d prepform("IC4",1),jfile("J1",.tform,.tchange,tressub,1,"IC4",$$ic4^%qaqoidx,0),temprestore QUIT
 #;
 #; if range restriction is part of the record id and if
 #; the 1st part of the record id isn't stored below the
 #; range subscript, skip extra index and use IC5; else use IC6
 #;
 i $$rifn d prepform("IC5",1),jfile("J1",.tform,.tchange,tressub,1,"IC5",$$ic5^%qaqoidx,0),temprestore QUIT
 d prepform("IC6",1),jfile("J1",.tform,.tchange,tressub,1,"IC6",$$ic6^%qaqoidx,0),temprestore QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
jalg24 s high="jalg24" d prepform("IC7",1),jfile("J1",.tform,.tchange,tressub,1,"IC7",$$ic7^%qaqoidx,0),temprestore q
jalg31 s high="jalg31" d prepform("S1",1) s x=$$s1^%qaqosrt d jfile("J8",.tform,.tchange,tressub,0,"S1",x,0),temprestore
 i 'qoouter d jfile("J9",.tform,.tchange,tressub,0,"S1",x,1) ; merge sort
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
jalg32 s high="jalg32" i allinmap d prepform("S2",1) s x=$$s2^%qaqosrt,y="S2" d temprestore
 i 'allinmap d prepform("S3",1) s x=$$s3^%qaqosrt,y="S3" d temprestore
 d jfile("J8",.tform,.tchange,tressub,0,y,x,0)
 i 'qoouter d jfile("J9",.tform,.tchange,tressub,0,y,x,1)
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
jalg33a s high="jalg33a" i allinmap d prepform("S4",1) s x=$$s4^%qaqosrt,y="S4" d temprestore
 i 'allinmap d prepform("S5",1) s x=$$s5^%qaqosrt,y="S5" d temprestore
 d jfile("J8",.tform,.tchange,tressub,0,y,x,0)
 i 'qoouter d jfile("J9",.tform,.tchange,tressub,0,y,x,1)
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
jalg33b s high="jalg33b" i allinmap d prepform("S6",1) s x=$$s6^%qaqosrt,y="S6" i 1
 #;
 #; if range restriction is part of the record id and if
 #; the 1st part of the record id isn't stored below the
 #; range subscript, skip extra index and use S7; else use S8
 #;
 e  i $$rifn d prepform("S7",1) s x=$$s7^%qaqosrt,y="S7" i 1
 e  d prepform("S8",1) s x=$$s8^%qaqosrt,y="S8"
 d temprestore
 d jfile("J8",.tform,.tchange,tressub,0,y,x,0)
 i 'qoouter d jfile("J9",.tform,.tchange,tressub,0,y,x,1)
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
jalg33c s high="jalg33c" i allinmap d prepform("S9",1) s x=$$s9^%qaqosrt,y="S9" i 1
 e  d prepform("S10",1) s x=$$s10^%qaqosrt,y="S10"
 d temprestore
 d jfile("J8",.tform,.tchange,tressub,0,y,x,0)
 i 'qoouter d jfile("J9",.tform,.tchange,tressub,0,y,x,1)
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
jalg34a s high="jalg34a" i allinmap d prepform("S11",1) s x=$$s11^%qaqosrt,y="S11" i 1
 e  i $$rifn d prepform("S12",1) s x=$$s12^%qaqosrt,y="S12" i 1
 e  d prepform("S13",1) s x=$$s13^%qaqosrt,y="S13"
 d temprestore
 d jfile("J8",.tform,.tchange,tressub,0,y,x,0)
 i 'qoouter d jfile("J9",.tform,.tchange,tressub,0,y,x,1)
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
jalg34b s high="jalg34b" i allinmap d prepform("S14",1) s x=$$s14^%qaqosrt,y="S14" i 1
 e  i $$rifn d prepform("S12",1) s x=$$s12^%qaqosrt,y="S12" i 1
 e  d prepform("S13",1) s x=$$s13^%qaqosrt,y="S13"
 d temprestore
 d jfile("J8",.tform,.tchange,tressub,0,y,x,0)
 i 'qoouter d jfile("J9",.tform,.tchange,tressub,0,y,x,1)
