 #; PVA023: new routine prepform to adjust formula entries for in stream equivalences
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA072: uset variable
 #; PVA283: add join argument
prepform(tempalg,join=0)  n joinres,resknownsav,resmaybesav,a,b,c,uset
 s resknownsav=resknown,resknown="",resmaybesav=resmaybe,resmaybe=""
 s joinres=" ",noresmay=",",resprev=""
 #; PVA072: set uset
 s uset=1 s:$e(tempalg)="S"&&onestrm&&(tempalg'="S8")&&(tempalg'="S13") uset=0
 #; PVA072: setresalready2 now takes ressub as arg - choose the right one
 d setresalready2^%qaqoco($s(uset:tressub,1:ressub))
 #; adjust form() based on change() and nores, killing used entries of change()
 #; subtract out impact of replicated restrictions that have already
 #; been processed. Save it first so temprestore can restore it.
 s i="" f  s i=$o(form(i)) q:i=""  s savform(i)=form(i)
 #; PVA072: use ptform when applicable (most of the time).
 if uset 
 {  s i="" f  s i=$o(form(i)) q:i=""  s form(i)=ptform(i)
 }
 #; PVA177: Move distinct cost to latest processing time for this stream; depends on algorithm situation.
 s tform($$$SGPi)=0
 if $e(tempalg)="I" 
 {  
 	s form($$$SGPi)=form($$$SGPi)-movdistcost 
 	s form($$$SGPb)=form($$$SGPb)-movdistcostb
 	s tform($$$SGPb)=form($$$SGPb)+movdistcost+movdistcostb
 }
 elseif onestrm 
 {  if (" S3 S5 S7 S8 S10 S12 S13 "[(" "_tempalg_" "))&&(uset||'dgood) s form($$$SGPb)=form($$$SGPb)+movdistcost,form($$$SGPi)=form($$$SGPi)-movdistcost
		#; list of S algs are those that use SGPb
    else    // no change needed
    if " S8 S13 "[(" "_tempalg_" ") {s tform($$$SGPb) = form($$$SGPb)} // two stage sorts need this tform for stage two master map access
    else {s tform($$$SGPb)=1 }  
 }
 else
 {  s tform($$$SGPi)=movdistcost+movdistcostb
 	s form($$$SGPi)=form($$$SGPi)-movdistcost 
 	s form($$$SGPb)=form($$$SGPb)-movdistcostb
 	s tform($$$SGPb)=1
 }
 #; THIS LOGIC MUST BE IDENTICAL TO formsub^%qaqoco (except for off by one piece difference
 #;    between malg(#,res) and change(res).
 s a="" f   
 {  s a=$o(change(a))  q:a=""  
    if (nores[(","_a_",") || (adjsel[(","_a_","))) // PVA279: adjsel
    { 
       #; PVA072: Now must pick the proper ":" piece of a change entry correponding to ptform or form
       s b=change(a) f i=2:1:$l(b,"^") s c=$p(b,"^",i) i c]"" s form(+c)=form(+c)*$s(uset:$p(c,":",3),1:$p(c,":",2))
       k change(a)
    }
 }
 s resknown=resknownsav,resmaybe=resmaybesav
 #; PVA283: treat bounding restrictions below the join subscripts as nonbounding if they would be non-bounding
 #;         without testing the join (as in temp file building). The following logic being sufficient depends sensitively
 #;         on the way rangesub and qosubdone and jasub are managed in %qaqojn3. 
 if join && (jasub>0) && (rangesub>0) && (form($$$SSE2M)=1)
 {  if rangesub>jasub 
    {  s form($$$SSOI)=form($$$SSOI)*form($$$SSE3),(form($$$SSE3),form($$$SSE3M))=1
       s form($$$SSOI)=form($$$SSOI)*form($$$SSR),(form($$$SSR),form($$$SSRM))=1
	} 
    else {s form($$$SSOI)=form($$$SSOI)*form($$$SSE3),(form($$$SSE3),form($$$SSE3M))=1} 
 }
 QUIT
 #; PVA023: new routine temprestore to restore variables temporarily modified by prepform
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
temprestore
 ; restore change() from savchange - note: only change to change() is to kill some nodes,
 ;   nothing more complidated than this is needed.
 s i="" f  s i=$o(savchange(i)) q:i=""  s change(i)=savchange(i)
 ; restore form() as well
 s i="" f  s i=$o(savform(i)) q:i=""  s form(i)=savform(i)
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA072: Add ressub argument so caller selects which to use
jfile(procalg,cfarr,chgarr,ressub,nocdmap0,tempalg,tcost,ordinput) ;
#IF 0   ;
 ; jfile:  File a join algorithm
 ; input parameters:
 ;     procalg: low level join algorithm # (after sort
 ;              or index is created, if needed)
 ;     cfarr: cost formula array (.form if no temp file,
 ;             else .tform)
 ;     chgarr: change array that is used to backout selectivity
 ;             (.change if no temp file, else .tchange)
 ;     ressub: caller chooses tressub (preprocess) or ressub
 ;     nocdmap0: with this algorithm, map 0 blocks are still
 ;               in the buffer pool for subsequent joins,
 ;               assuming the output of this and intervening
 ;               joins isn't stored in a temp file
 ;     tempalg: index or sort creation alg #, or null
 ;     tcost: cost of temp file creation (or null)
 ;     ordinput: 1 if ordered input is mandatory, else null
 ;               (1 if merged sort algorithm, else null)
 ; input variables:
 ;     all previously defined variables may be used
#ENDIF  ;
#IF 1   ; AK430+
 i vorused,tempalg'="" QUIT  ;  can't build temp-file on virtual field
#ENDIF  ; AK430-
 d jfile1 i 'ordinput,(tempalg]"")!qoorder s ordinput=1 d jfile1 ; do w/ & w/o ordered input
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
isRedundant()
 #; HSU277+ 
 #; If the join algorithm is a J3 (visit index map and then go to map0) alg on a extent bitmap and join by a foregin key (HasFKey^%qTablenow support single FK info via DPV5301).
 #; Then this algorithm is apparently a subpar alg.
 #; since we know this is FK join, no any join miss would happen when visiting this extent bitmap.
 #; This implies visiting extent bitmap is completely redundant.
 
 i $l($p(jainfo,"^",5),",")'=3 RETURN 0 ;if not single join field, just quit 0
 
 n jointoIfn,recidIfn,smdimp
 s jointoIfn = $p($$$mtV($p($p(jainfo,"^",5),",",2)),"^",3) ; ifn of potential foreign key, only consider single FK right now.
 s recidIfn = $p(mts(qoqn,qosn),"^",5)
 #; test if "J3", join on ID, and the index map is extent bitmap and this is forein key join
 s smdimp=$s($d(mt("smdimp",map)):mt("smdimp",map),1:map)
 if procalg="J3",qojrid,$$$smdMapExists(smdimp),$$$smdMapIndexType(smdimp)="BE",($$HasFKey^%qTable(jointoIfn,recidIfn)||(jointoIfn=recidIfn)) RETURN 1
 RETURN 0 
 #; PVA023: 'new' of ressub moved to %qaoj2. 
jfile1 n algnum,a,b,c,x,y
 #;HSU277+
 QUIT:$$isRedundant()
 #;HSU277-
#IF 0   ; AK392+
 s algnum=$g($$$Malg(0))+1,$$$Malg(0)=algnum
#ELSE   ; AK392+
 s algnum=$i($$$Malg(0))
#ENDIF  ; AK392-
 s ptj(qoqn,qojsn,qosn,qoslist,algnum)=""
 #; PVA177: Move distinct cost to latest processing time for this stream; depends on algorithm situation.
 if (" J1 J3 J5 J7 "[(" "_procalg_" "))&&(tempalg="")&&'dgood s cfarr($$$SGPb)=cfarr($$$SGPb)+movdistcost,cfarr($$$SGPi)=cfarr($$$SGPi)-movdistcost
	#; Above list of J algs are those that use SGPb
 s c=$$trunc(cfarr(1)) f i=2:1:$$$SUBMAX s c=c_","_$$trunc(cfarr(i))
 i tcost'="" f i=1:1:4 s $P(tcost,",",i)=$$trunc($P(tcost,",",i))
 #; PVA023: Move setting of ressub 'up higher'. Now needed for setresalready2 call for temp alg
 #;    costing. Also, it is the same for all the algorithms for a given map, for a given join condition.
 #;    Thus, there is no need to computed it so many times. 
 s a="" i $e(tempalg,1)="S" s a=outnodes*7+$p(outnodes,",",3) 
 If $$$CostBabyFile {
  i a s a=($$$DBBlockSize*3\4)*BABYBLK\a i a<20 s a=20 ; a = # tuples per temp sort file
 }
 #;
 #; if produce tempalg's sort file with an algorithm that processes
 #; tuples in order, then don't need to use baby files when store
 #; sort file output since access them in order
 #;
 i qoorder,",S4,S5,S6,S7,S9,S10,"[(","_tempalg_",") s a=""
 #;
 #; Algorithms S8 and S13 produce an index file and then a sort file
 #; I the join attrib list is the same as the record id, then the index
 #; is in the desired order and hence we don't need baby files for
 #; output
 #; *****If we change the definition of the subscripts for temp index
 #; such that subcase A is when map 0 subscripts = JA rather than when
 #; RID = JA, then this test should be altered to test if the join
 #; attribute list is the same as the map 0 subscripts.
 #;
 i qojrid,(tempalg="S8")!(tempalg="S13") s a=""
 s b=$p(jainfo,"^",5) i b'["," s b=","_b_","
 s x=+qoouter_"^"_jaifnlst_"^"_qojrid_"^"_qoslist_"^"_b_"^"_jarest_"^"_resknown_"^"_resmaybe_"^"_respar_"^"_ressub_"^"_ordinput_"^"_map_"^"_tempalg_"^"_procalg_"^"_high_"^"_tcost
 s y=a_"^"_outnodes_"^^"_nocdmap0_"^"_qonumjasub
 s $$$Malg(algnum)=x_"^"_c_"^"_y
 #;
 #; setup info to remove selectivity impact on cost formulas
 #; of migrated restrictions and restrictions that cannot be
 #; satisfied due to streams needed for restriction not yet having
 #; been processed.
 #;
 s a="" f  s a=$o(chgarr(a)) q:a=""  s $$$Malg(algnum,a)=$p(chgarr(a),"^",2,99)
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
trunc(x) ;  $$:  truncate to 5 significant digits (x>0 only!)  ;  AK263+
 QUIT:x'["." x  ;  no-op
 QUIT:$F(x,".")>6 $P(x+.5,".")  ;  make an integer
 QUIT:$E(x)'="." +$E(x,1,6)
 QUIT +$E(x,1,3+$F(x,$E($TR(x,".0"))))
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
rifn() ; return 1 if range restriction is part of the record id
 #;     and if the 1st part of the record id isn't stored
 #;     below the range subscript.
 i rangeifn'=$p(qoridifn,"^"),qoridifn'[(","_rangeifn_",") QUIT 0 ; quit if range subscript isn't part of rid
 QUIT:qojrid jasub'>rangesub ; joining on record id
 #; not joining on record id, see if 1st ifn of record id is in
 #;    a subscript below the rangesub in the map
 i rangeifn=$p(qoridifn,"^") QUIT 1 ; q 1 if rangeifn is record id
 n a,b,c s a=$p(qoridifn,",",2) i a=rangeifn q 1 ; a = ifn of 1st part of the record id
 s b="" f  s b=$o(mts(qoqn,qosn,"MAP",map,b)) q:b=""  s c=mts(qoqn,qosn,"MAP",map,b) q:'c!($p(c,"^",2)=a)!($p(c,"^",2)=rangeifn)
 i b]"",$p(c,"^",2)=a,c QUIT 1
 QUIT 0
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 
.
---
