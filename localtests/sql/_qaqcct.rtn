				}
				$$$liin($c(9,9,9)_"set %qQueryFetch=2,%0IRISServer.FDTimeMarker=$zh goto "_$p($p(call,$c(1),2),"^"))
 			} else { // hopefully, this is the most common case.  As long as we have not hit the rowlimit, grab the next row to output
	 			$$$liin($c(9,9,9)_"goto:("_$$$getVarName("rowlimit")_"&&("_$$$VarName("rowcnt")_"'<"_$$$getVarName("rowlimit")_")) "_$p($p(call,$c(1),2),"^")_$s($g($$$mtRowlimit):" goto:("_pti($$$mtRowlimit)_"<=+$g("_$$$getVarName("rowcount1")_")) "_$p($p(call,$c(1),2),"^"),1:"")) // if rowlimit reached get out
				do generateSQLStartCode^%qaqcasl(0,0,0,$c(9,9,9))
				$$$liin($c(9,9,9)_"set %qQueryFetch=2,%0IRISServer.FDTimeMarker=$zh goto "_bottom)     // if rowlimit not reached, continue to next row
 			}
			$$$liin($c(9,9)_"} else {  // client has requested something other than more data for this statement id")
			$$$liin($c(9,9,9)_"set %0IRISServer.HeaderReadInSQL=1 if $d(%qsc(%qacn,2))#2 { set x=$zobjexport($s($d(%0IRISServer):%0IRISServer.WaterMark2,1:%qWaterMark2),54) kill %qsc(%qacn,2) }")
			$$$liin($c(9,9)_"}")
			$$$liin($c(9)_"}")
			$$$liin("}")
		}
	}
	elseif $$$SQLCompileOption("fastFetchPut")'="" {
			#; fastFetchPut is a feature for parallel queries where we will output the row to the 's ipq.Value=<data>' function and then continue fetching until there are no more rows
			#; Code assumes the ipq variable contains the ipq oref.  This is set up in generateworker^%qaqcky and if that logic changes, this needs to be updated too
		new put
		set put=$$$SQLCompileOption("fastFetchPut")
 		//if mt("maxonerow")||/*(bottom["dun")||*/($g(asl(mod,0,"rowcnti"))) {  // only returning 1 row, not a loop case, or there is a TOP check
			$$$liin("set ipq.Value=$lb("_put_"),"_$$$getVarName("fastFetchPutStatus")_"=1 goto "_$p($p(call,$c(1),2),"^"))
 		//} else { // hopefully, this is the most common case.  As long as we have not hit the rowlimit, grab the next row to output
		//	$$$liin("if ipq.Put($lb("_put_")) { goto:("_$$$getVarName("rowlimit")_"&&("_$$$VarName("rowcnt")_"'<"_$$$getVarName("rowlimit")_")) "_$p($p(call,$c(1),2),"^")_" goto "_bottom_" }")
 		//}
	}
.
fetchOutput
	$$$liin("// --- FETCH Output ---")
	// --- PTools/SQLStats: SQL FETCH [END of Module] ---
	if $$$SQLStatsFlagON { $$$liin("do:"_$$$SQLStatsCollectMAINValueQ($$$getVarName("action-flag-run"))_" %statsStop("_$$$getVarName("statsJob")_","_$$$getVarName("statsNS")_",$zn,"""_$S($g(mcurs)'="":mcurs,1:callname)_""",""1"","_$$$getVarName("collect-flag-bits")_")  // SQLStats: Stop collecting for module: FIRST (Outermost)") }
	if $$$SQLStatsFlagON { $$$liin("if "_$$$SQLStatsCollectMAINValueQ("$g("_$$$getVarName("action-flag-run")_")")_" { merge "_$$$getVarName("%SQLStats")_"=%SQLStats kill %SQLStats } // SQLStats: Save the %SQLStats(...) array to the local object instance and remove!") }
	
	if '$g(mt("rtpc","outliersexist")) { // JSL5121 - prune fetch logic
		do generateSQLEndCode^%qaqcasl()
	}
	$$$liin("quit  // FIRST FETCH")
	s tag=$p($p(call,$c(1),2),"^")  ;  FETCH tag
	$$$liin("// --- FETCH EP ---")
	s line="i '$g("_$$$getVarName("CursorState")_") { s SQLCODE=-102 q  } i "_$$$getVarName("CursorState")_"=100 { s SQLCODE=100 q  } s SQLCODE=0" $$$liin(.line)
	// %ROWLIMIT support, to be replaced by a true LIMIT syntax or an extension to TOP
	if $g($$$mtRowlimit) $$$liin("i "_pti($$$mtRowlimit)_"<=+$g("_$$$getVarName("rowcount"_$s($$$topWorkerModule(1)=1:$$$topParentModule(1),1:1))_") { s SQLCODE=100,%ROWCOUNT=+$g("_$$$getVarName("rowcount"_$s($$$topWorkerModule(1)=1:$$$topParentModule(1),1:1))_"),"_$$$getVarName("CursorState")_"=100 q }")	// DPV2771
	#; AK738
	#; No need if we only output a single row
	if 'mt("maxonerow") $$$liin("i "_$$$getVarName("rowlimit")_","_$$$VarName("rowcnt")_"'<"_$$$getVarName("rowlimit")_" { s SQLCODE=100,%ROWCOUNT="_$$$VarName("rowcnt")_","_$$$getVarName("CursorState")_"=100 q }")	// DPV2771
	// --- PTools/SQLStats: SQL FETCH [START of Module] ---
	if $$$SQLStatsFlagON { $$$liin("if "_$$$SQLStatsCollectMAINValueQ("$g("_$$$getVarName("action-flag-run")_")")_" { merge %SQLStats="_$$$getVarName("%SQLStats")_" } // SQLStats: Load the %SQLStats(...) array from the local object instance!") }
	if $$$SQLStatsFlagON { $$$liin("do:"_$$$SQLStatsCollectMAINValueQ($$$getVarName("action-flag-run"))_" %statsStart("_$$$getVarName("statsJob")_","_$$$getVarName("statsNS")_",$zn,"""_$S($g(mcurs)'="":mcurs,1:callname)_""",""1"","_$$$getVarName("collect-flag-bits")_")  // SQLStats: Start collecting for module: FIRST (Outermost)") }
	
	if '$g(mt("rtpc","outliersexist")) { // JSL5121 - prune fetch logic
		do generateSQLStartCode^%qaqcasl(,1)
	}
	#; AK738-
	#; AK811
	s fchmod=mod,fchline=lines+1,lines=lines+2  ;  leave room for NEW
	
	if $$$topWorkerModule(1)=1{
		; If MOD 1 is a top worker ASL module for Adaptive Parallel Execution, 
		; set the goto line to the corresponding top parent ASL module
		$$$liin("g "_$$modpre^%qaqcasl($$$topParentModule(1))_"Mod:"_$$$getVarName("CursorState")_"=1")
	} else { 
		$$$liin("g "_gtag_"first:"_$$$getVarName("CursorState")_"=1")
	} 
	
	if '$g(mt("rtpc","outliersexist")) { // JSL5121 - prune fetch logic
		#; MRP875
		if $$$SQLStatsFlagALL {	// --- Generate SQLStats Collection Code ---
			new modList,modListExt,nMod,pos
			set modList=mod,modListExt=$$$ModuleNameIntToExt(mod)
			for pos=1:1 { 
				set nMod=$p(modList,",",pos) 
				QUIT:'nMod
				set nMod=$P($g($$$aslMod(nMod)),$c(1),2) 
				if nMod,(","_modList_",")'[(","_+nMod_",") {
					set:nMod["," nMod=$e(nMod,1,*-1)
 					CONTINUE:+nMod=1  // SKIP 'FIRST' Module, which is handled in a special way elsewhere (as the entire outermost FETCH module)!
					set modList=modList_","_nMod
					set modListExt=modListExt_","_$$$ModuleNameIntToExt(nMod)
				}
			}
			
		#; MRP879
		#; MRP902
			// --- PTools/SQLStats: SQL FETCH [MIDDLE of Module] ---
			$$$liin("do:"_$$$SQLStatsCollectALLValueQ($$$getVarName("action-flag-run"))_" %statsStart("_$$$getVarName("statsJob")_","_$$$getVarName("statsNS")_",$zn,"""_$S($g(mcurs)'="":mcurs,1:callname)_""","""_$re(modList)_""","_$$$getVarName("collect-flag-bits")_")  // SQLStats: Start collecting for module"_$s($l(modListExt,",")>1:"s",1:"")_": "_modListExt)
		}
		#; MRP875-
	}
	QUIT
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nest(nestmod) ; Do some nesting here
	s:lines=0 lines=1
	s line="; asl MOD# "_nestmod $$$liin(.line)
	s nest(mod,lines)=nestmod  ; nested module is inserted here in ^asl1
	#; AK738
	d topdun
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK419
share(nestmod)  ;  share this module - call it with a return tag
	#; AK827
	#;  set call-back variable to the calling module, for the GOTO $CASE()
	s line="s "_$$$getVarName("caller"_nestmod)_"="_mod_" g "_$$modpre^%qaqcasl(nestmod)_"Mod" $$$liin(.line)  ;  GOTO the shared module
	#; AK827-
	s tag=tagpre_"bak"_nestmod
	#; AK738
	d topdun 
	if tag'="" $$$liin("")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK419-
	#; AK738
topdun	n lm,li,m s lm=$g($$$asl0QbThreadsThisBelongsTo(mod))  ;  [public: bottom,asl,mod,ntry,line,tagpre,padbot]
	#;  gen:  GOTO:msTOP(m) mod_dun for any m in asl(mod,0,"thrd")=$LIST(m)
	QUIT:(bottom["dun")&&($o($$$aslAct(mod,ntry))="")  ;  "dun" is next anyway
	s line="" f li=1:1:$ll(lm) s m=$li(lm,li) s:$g($$$mtTopArg(m)) line=line_$$mstop(m)_"||"
	if line'="" $$$liin("i "_$e(line,1,*-2)_" "_$s(+$$padhead^%qaqcasl(mod):"s "_$$$getVarName("pad"_$$padhead^%qaqcasl(mod))_"=0 ",1:"")_"g "_tagpre_"dun")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mstop(m)  ;  [public: mt] $$: generated TOP stop condition for subquery m
	QUIT "("_$$$VarName("rowcnt"_m)_">="_$$ptvalue^%qaqcpr($$$mtTopArg(m))_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK738-
	#; DPV1531
lock	;        lock the row - call %SQLGetLock classmethod
	new irnval,rowidref 
	set irnval=$s(mcurs'=""&&($p(mtc(mcurs,"f"),",",2)'=""):$p(mtc(mcurs,"f"),",",2),1:irn)	// DPV2999
	#;s tabrtn="^"_$$$smdTableRoutinePrefix(irnval)_"1"
	#;  *** what case has mcurs empty???
	s rowidref=$s(mcurs'="":mtc(mcurs,"rid"),1:pti($$rowid(irn)))
	if $$$smdTempTableType(1,irnval)'="LOCAL TEMPORARY" {	// DPV2999
		if $$$mtKUseCheckVariable($$$mtK)=1 { 
			s line="if '$a($g(%check),2) { set "_$$$getVarName("lockstat")_"=##class("_$$$smdClassname(1,irnval)_").%SQLGetLock("_rowidref_") i '"_$$$getVarName("lockstat")_" { s SQLCODE=-110,%msg=$$FormatMessage^%occMessages(,""%SQL.Filer"",""SQLFiler40"",,"""_$case($$$mtStatementType,"INS":"INSERT","UPD":"UPDATE",:"DELETE")_""","_$$quoter($$$smdSchema(1,irnval))_"_"".""_"_$$quoter($$$smdName(1,irnval))_","_rowidref_") g "_$p($p(call,$c(1),3),"^")_" } s:"_$$$getVarName("lockstat")_"=2&&($g(%check)'="""") $e(%check,2)=$c(1) } else { s "_$$$getVarName("lockstat")_"=0 }"		// DPV3148 // DPV3677
		}
		else { 
			s line="set "_$$$getVarName("lockstat")_"=##class("_$$$smdClassname(1,irnval)_").%SQLGetLock("_rowidref_") i '"_$$$getVarName("lockstat")_" s SQLCODE=-110,%msg=$$FormatMessage^%occMessages(,""%SQL.Filer"",""SQLFiler40"",,"""_$case($$$mtStatementType,"INS":"INSERT","UPD":"UPDATE",:"DELETE")_""","_$$quoter($$$smdSchema(1,irnval))_"_"".""_"_$$quoter($$$smdName(1,irnval))_","_rowidref_") g "_$p($p(call,$c(1),3),"^")	// DPV3677
		}
		$$$liin(.line)
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
lock2(m,str)    ;  lock (shared) the row - lock generated in-line
	i 'mcurs {
		#;  Lock line for cursor based queries
		n irn,rowidref,slock,var
		s imp=$p(mts(m,str),"^",4),irn=$$$smdMapIrn(imp)
		s rowidref=pti($$rowid(irn,str))
		#;  taglockskip is a 'global-in-scope' variable used in lockskiptag
		s taglockskip=tagpre_"uncommitted"
		set lockref=$$$smdLockReference(1,irn)
		if lockref="%LockId()" {	// DPV3767+
			set line="g:"_$$$getVarName("isolationMode")_"'=1"_$s('$g(padnext):"",1:"||($g("_$$$getVarName("oldpad_"_mod)_")=2)")_" "_taglockskip_" i "_$$$getVarName("isolationMode")_"=1 if $classmethod("""_$$$smdClassname(1,irn)_""",""%LockId"","_rowidref_",1) { s "_$$$getVarName("lockstat_"_m_"_"_str)_"=2,"_$$$getVarName("%delock_"_m_"_"_str)_"=$lb("""_$$$smdClassname(1,irn)_""","_rowidref_") } else { s SQLCODE=-114,%msg=""Unable to acquire shared lock on table "_$$quoter2($$$smdSchema(1,irn),1)_"."_$$quoter2($$$smdName(1,irn),1)_" for RowID value: ""_"_rowidref_" ztrap ""LOCK""  }" $$$liin(.line)
		}
		else {
			set lockref=$$buildLockRef(m,str,irn,lockref,rowidref)
			set slock=$s(($e(lockref,1,2)="^*"&&($l(lockref,"^*")=2))||($e(lockref)="@"&&($l(lockref,"@")=2)):$e(lockref,1,*-1)_"_""#""""S"""""")",1:lockref_"#""S""")
			set line="goto:"_$$$getVarName("isolationMode")_"'=1"_$s('$g(padnext):"",1:"||($g("_$$$getVarName("oldpad_"_mod)_")=2)")_" "_taglockskip $$$liin(.line)
			set line="if "_$$$getVarName("isolationMode")_"=1 {" $$$liin(.line)
			set line=$c(9)_"lock +"_slock_":"_$$$LockTimeoutQ $$$liin(.line)
				#; There is a feature/switch in Cache called RefInKind:
				#;	The RefInKind(switch) class method specifies whether $QUERY and $NAME
				#;	return an extended global reference when the first argument of $QUERY or $NAME
				#;	contains an extended global reference. A switch value of 0 returns the extended
				#;	global reference. A switch value of 1 strips the extended global reference
				#;	before returning the global. Invoking the ZWRITE command returns the extended
				#;	global reference regardless of the RefInKind setting.
				#; If RefInKind is 1, we need to set it to 0 in order to get the proper $name reference for the delock variable reference
				#; RefInKind is controlled by the $zu(68,7) function
				#;  First we use var to hold/reset the RefInKind flag, then we set it to 1 to signal we acquired the lock
			set var=$$$getVarName("lockstat_"_m_"_"_str)
			if lockref["^["||(lockref["^|") {
				set line=$c(9)_"if $t { set "_var_"=$zu(68,7,0),"_$$$getVarName("%delock_"_m_"_"_str)_"=$name("_lockref_")_""#""""SI"""""" do:"_var_" $zu(68,7,1) set "_var_"=1 }" $$$liin(.line)
			}
			else {
				set line=$c(9)_"if $t { set "_$$$getVarName("%delock_"_m_"_"_str)_"=$name("_lockref_")_""#""""SI"""""","_var_"=1 }" $$$liin(.line)
			}
			set line=$c(9)_"else { s SQLCODE=-114,%msg=""Unable to acquire shared lock on table "_$$quoter2($$$smdSchema(1,irn),1)_"."_$$quoter2($$$smdName(1,irn),1)_" for RowID value: ""_"_rowidref_" ztrap ""LOCK""  }" $$$liin(.line)	// DPV2808 (ztrap, don't quit)
			set line="}" $$$liin(.line)
		}
	}
	#;  Lock line for non-cursor SELECTs
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
unlock	;  unlock the row - call %SQLReleaseLock classmethod if necessary        check SQLCODE for fatal filer failure
	If mcurs,$$$smdTempTableType(1,$p(mtc(mcurs,"f"),",",2))'="LOCAL TEMPORARY" {	// DPV2999
		If $$$mtStatementType="UPD",$$$mtKILockFlag($g($$$mtK))=1 { // UPDATE %ILOCK
			s line="d:"_$$$getVarName("lockstat")_"=1 ##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLReleaseLock("_mtc(mcurs,"rid")_",,1) g:SQLCODE<0 "_$p($p(call,$c(1),3),"^") $$$liin(.line)	// DPV3677
		}
		Else { s line="d:"_$$$getVarName("lockstat")_"=1 ##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLReleaseLock("_mtc(mcurs,"rid")_") g:SQLCODE<0 "_$p($p(call,$c(1),3),"^") $$$liin(.line) }	// DPV3677
	}
	ElseIf $$$smdTempTableType(1,$p(mtc(mcurs,"f"),",",2))'="LOCAL TEMPORARY" {	// DPV2999
			#;  *** what case is this???
		n rowidref	//,tabrtn
			#;s tabrtn="^"_$$$smdTableRoutinePrefix(irn)_"1"
		s rowidref=pti($$rowid(irn))
		s line="i $g("_$$$getVarName("isolationMode")_")=1,$g("_$$$getVarName("lockstat")_")=1 do ##class("_$$$smdClassname(1,irn)_").%SQLReleaseLock("_rowidref_")" $$$liin(.line)	// DPV3677
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
unlocksi2(m,str,reset=0)        ;  $$ func, code immediately unlock the the shared lock on the row (code is not filed but returned for in-line generation)
	#; lockstat=1 means we can just l -lockref
	#; lockstat=2 means we must call %UnlockId() class method. (DPV3767)
	new delock,lockstat set delock=$$$getVarName("%delock_"_m_"_"_str),lockstat=$$$getVarName("lockstat_"_m_"_"_str)
	//QUIT "if $g("_$$$getVarName("isolationMode")_")=1 { if $g("_lockstat_")=1 { l -@"_delock_$s(reset:" s "_lockstat_"=0",1:"")_" } elseif $g("_lockstat_")=2 { do $classmethod($li("_delock_"),""%UnlockId"",$li("_delock_",2),1,1) "_$s(reset:" s "_lockstat_"=0",1:"")_" } }"
	QUIT "if $g("_lockstat_")=1 { l -@"_delock_$s(reset:" s "_lockstat_"=0",1:"")_" } elseif $g("_lockstat_")=2 { do $classmethod($li("_delock_"),""%UnlockId"",$li("_delock_",2),1,1) "_$s(reset:" s "_lockstat_"=0",1:"")_" }"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
lockskiptag	    ;
	i mt("querylock"),$g(taglockskip)'="" s tag=taglockskip,taglockskip="",line="" $$$liin(.line)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 // return the total count of top and offset rows for counter condition
paginationTotalRows(m) [mt] PUBLIC {
	RETURN $s($d($$$mtTopArg(m)):$$ptvalue^%qaqcpr($$$mtTopArg(m)),1:"")_$s($d($$$mtOffset(m)):"+"_$$ptvalue^%qaqcpr($$$mtOffset(m)),1:"")
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
rowid(irn,str) [mt,mts] PUBLIC {
	#; $$ function  Given an irn, return the val of the rowid
	#; AK536
	#;  *** could this even happen?  what does it mean?
	i '$g(str) f str=1:1 q:irn=+$$$mtR(str)  ;  better not loop forever...
	s m=$$$mtRQb($$$mtR(str))
	QUIT $p(mts(m,str,"ATT",$p(mts(m,str),"^",5)),"^",5)
	#; AK536-
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; DPV1531-
aggate	;  Aggregate function
	new var1
	set var1=pti($p(stuff,$c(1),3))
	do null^%qaqcasl($p(stuff,$c(1),3))
	set line=""	//  initialize for adset/setin
		#;  Insert the code. The '0' tells calcagg its not a Sub-Aggregate
	do calcagg($p(stuff,$c(1),4),$p(stuff,$c(1),5),0)
	do setin	//  for case of COUNT
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
quit	;  Translate quit entry (for subqueries)
	#;    stuff = q [ V qval# [ val#(SELECT-clause) ] ]
	#;    3 cases:
	#;       $p(1) only - QUIT (currently unused)
	#;       $p(1,2)    - SET result=1 and QUIT (FOR SOME - a row found)
	#;       $p(1,2,3)  - SET subquery result and QUIT (scalar subquery)
	n qval,mtv,qn,gcf s qval=$p(stuff,$c(1),2),mtv=$g($$$mtV(+qval)),qn=$p(mtv,"^",2),gcf=$g($$$mtGroupCorrFieldOpt(+qn))
	#;  for group decorrelation mt("gcf",qn)=f, cache query result for f
	#;  s ^||%t(var(tfn),f)=1  ;  AK1014
	// Writing here so set readWriteMode=1 so that it writes to local for non-DISTINCT hybrid temp-files
	i gcf { $$$liin("s "_$$tfref^%qaqcpre($$$mtPTempFile($$$mtP(qn)),1,1)_pti($$$mtLOperand1($$$mtL(gcf)))_")="_$s($p(stuff,$c(1),3)="":1,1:pti($p(stuff,$c(1),3)))) RETURN }
	#; MRP875
	#; MRP879
	new isDSN
	if $$$SQLStatsFlagALL&&(mod>1) { $$$liin("do:"_$$$SQLStatsCollectALLValueQ($$$getVarName("action-flag-run"))_" %statsStop("_$$$getVarName("statsJob")_","_$$$getVarName("statsNS")_",$zn,"""_$S($g(mcurs)'="":mcurs,1:callname)_""","""_mod_""","_$$$getVarName("collect-flag-bits")_")  // SQLStats: Stop collecting for module: "_$$$ModuleNameIntToExt(mod)) }
	#; Check if this subquery has a $$$mtDSNLinkedTable(qbn) entry (i.e. is a gateway query) so that we make sure cursor is always closed at the end
	#; Note: $$$mtDSNLinkedTable() is " " to mark union run in parallel
	if $e(mtv)="q", ",, ,~,"'[(","_$g($$$mtDSNLinkedTable(qn))_",") {
		$$$liin($$gwclosecursor^%qaqcmh)
	}
	$$$liin($s(qval="":"",1:"s "_pti(qval)_"="_$s($p(stuff,$c(1),3)="":1,1:pti($p(stuff,$c(1),3)))_" ")_"q")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
build	;  build up the references
	n node,orgRef,piece,generatedPPGoverflow,ref,rvar,sublev,val,var1
	n filenum,tfname,tfvarr,tref s filenum=$p(stuff,$c(1),6)
	set generatedPPGoverflow=0
	#; AK841
	s ref=$$tfref^%qaqcpre(filenum) ; TODO FIX!!
	// For post-EEE019 hybrid temp-files (p1'="dist" / non-DISTINCT statements), set ref/mt("tref",tref) to be the local version of the hybrid (i%hybtf1)
	// instead of the PPG (^||%t(tablenum1,...), i.e., use local array i%hybtf1 for the build (unless TOP optimization is used)
	if $$hybtfForNonDistinct^%qaqcpre(filenum) {
		// If TOP optimization is used, we temporarily set ref to use indirection, which then gets replaced by an if-else logic when building the temp-file (in setNonDistinctHybtfForTop^%qaqcct)
		if $p(stuff,$c(1),12) {
			set ref = "@"_$$$getVarName("hybtfn"_filenum)_"@("
		} else {
			set ref = $$adsub^%qaqcmn($$$getVarName("hybtf"_filenum))	; referred to as tfvarr in other areas (such as in hybtag^%qaqcpre)
		}
		s:$e(ref,*)="," ref=$e(ref,1,*-1)
	}
	s tref=mod_"^"_ntry,$$$mtTref(tref)=ref  ;  used in build^cky
	#; AK841-
	#; AK615
	#;  "distinct" temp-file (reused here for agg's) already initialized
	d:$p($$$mtTempFile(filenum),"^")'="dist" initemp^%qaqcasl(filenum,$p(stuff,$c(1),7),stuff)
	#; AK615-
	i $p(stuff,$c(1),13)'="" {  ;  use VectorJoin  ;  AK1064
	#;  vector join "build" node information by $P($C(1)):
	#;  1. "b"  ;  "build" ACTION
	#;  13. "vj0"/"vj1"  ;  inner/outer join
	#;  14. vecvar(jto), = left table key vector (possibly %VHASH)
	#;  15. LIST(vecvar(val),) = left table field vectors needed after the
	#;      join, if any (may include %ID and jointo)
	#;  16. vecvar(jav), = right table key vector (possibly %VHASH)
	#;  17. LIST(vecvar(val),) = right table field vectors needed after the
	#;      join, if any (may include %ID and jalist)
	#;  18. rvhi = right table firstId, id of position 1 in the chunk
	#;  19. rwf = val of right table applicable bitmap filter (EBM/WHERE)
	#;  20. lvhi = left table firstId, id of position 1 in the chunk
	#;  21. lwf = val of left table applicable bitmap filter (EBM/WHERE)
	#;  22. jidvec = vector of returned result-set id value
	#;  23. lidvec = returned vector of left id values for joi join result
	#;  24. ridvec = returned vector of right id values for joi join result
	#;  25. jvhi = join result-set firstId, id of position 1 in the chunk
	#;  26. jwf = join result-set bitmap filter
	#;  For the actual "extra fields" parameters, don't include 24/16
	#;      (except include 16=jav if OUTER JOIN and it's a single field)
		#;  d vj.Build(firstId,bitExpr,keyChunk[,val1Chunk,...])
		$$$liin("d "_$e(ref,1,*-1)_".Build("_$$genargs^%qaqcpr($p(stuff,$c(1),18)_"^"_$p(stuff,$c(1),19)_"^"_$tr($p(stuff,$c(1),16)_$$remove^%qaqpmod($p(stuff,$c(1),17),$s($$innerj^%qaqcky(stuff):$p(stuff,$c(1),16),1:"")_$p(stuff,$c(1),24)),",","^"))_")")
		RETURN
	}
	d bldaray
	n levcnt s levcnt=sublev  ;  remember how many subscripts there are
	#; AK849
	MERGE $$$mtTrefRefNode(tref)=ref  ;  to replace asl("bd") $P(1)
	// All DISTINCT hybrid temp-file (p12="dist") writes go into the local var("hybtf"_tf#) and they use indirection for read ;  AK936;AK986
	// For new non-DISTINCT hybrid temp-files, use indirection for read and either an if-else logic (set as indirection temporarily first) for build (when TOP optimization is used)
	// or local array for build (when TOP optimization is not used)
	i $$hybtf^%qaqcpre(filenum) || ($$hybtfForNonDistinct^%qaqcpre(filenum) && levcnt>0) {
		s val=$l($$$mtTref(tref))+($e($$$mtTref(tref),*)'="(")
		// When TOP optimization is used, set ref to use indirection, which then gets replaced by an if-else logic when building the temp-file (in setNonDistinctHybtfForTop^%qaqcct)
		// (this optimization doesn't apply to DISTINCT statements to begin with, so no need to check for that condition in the following line)
		s tfvarr=$s($p(stuff,$c(1),12):"@"_$$$getVarName("hybtfn"_filenum)_"@(",1:$$adsub^%qaqcmn($$$getVarName("hybtf"_filenum)))
		s $$$mtTref(tref)="@"_$$$getVarName("hybtfn"_filenum)_"@(",sublev="",$$$mtTrefTfNode(tref)=filenum
		f  s sublev=$o(ref(sublev)) q:sublev=""  s $e(ref(sublev),1,val)=tfvarr,$e($$$mtTrefRefSubLev(tref,sublev),1,val)=$$$mtTref(tref)
		f  s sublev=$o($$$aslBuildActNode(mod,ntry,sublev)) q:sublev=""  s:$e($$$aslBuildActNode(mod,ntry,sublev))="^" $e($$$aslBuildActNode(mod,ntry,sublev),1,val)=$$$mtTref(tref)
	}
	#; AK936-
	#;  Now we have the Refeneces and nodes, Start frying up Code
	#;  if theres no data in this file, only subscripts, then set to null
	#; AK610
	#; AK633
	If filenum=$$$getParAggWorkerTf(m) { // This implicitly checks for $$$parAggUsesSharedGlobal too
		// When we are using a shared global to which workers write in parallel, then we want to store the correct references
		// to the shared global temp-file as well and not just the worker-private temp-file (filenum).
		// To do that, we run bldaray^%qaqcct starting with an initial reference to the shared global temp-file instead.
		// Those references are to be used by hybridsel^%qaqcky and nodeloop^%qaqcdt.
		MERGE orgRef=ref
		Kill ref
		Set ref=$$tfref^%qaqcpre($$$getParAggSharedTf(m))
		Do bldaray
		Set $$$mtTrefTempFile(tref)=$$$getParAggSharedTf(m)
		Set $$$mtTrefFieldRef(tref)=ref // We need only the top level node of ref since it stores the complete set of subscripts for the field
		Kill ref
		MERGE ref=orgRef
		// We also need to store the fields that we need to pass from the parent to the workers later on in findprm^%qaqpagg
		// But we only do that for the module where the workerTf is being built
		If mod=$p($$$mtTempFile(filenum),"^",2) {
			Set sublev = ""
			For {
				Set sublev=$o($$$aslBuildActNode(mod,ntry,sublev),1,val)
				QUIT:sublev=""
				Set $p($$$mtAPESharedGlobal(m),"^",3)=$s((val="")||($p($g($$$mtAPESharedGlobal(m)),"^",3)[$p(val,$c(1),2)):"",1:$p(val,$c(1),2)_",")_$p($g($$$mtAPESharedGlobal(m)),"^",3)
			}
		}
	}
	#; Do not set="" for distinct temp file as distinct processing will have already set the root distinct node
	i '$d(node),$d(ref) {
		// Building the temp-file here.
		if $p($$$mtTempFile(filenum),"^")'="dist" {
			// If TOP optimization with a non-DISTINCT hybrid, use an if-else logic instead of indirection (better performance)
			// This means we have to set it on its own line without using adset^%qaqcpre as done previously
			if $$hybtfForNonDistinct^%qaqcpre(filenum) && $p(stuff,$c(1),12) {
				// Set all things to be set so far then set the temp-file on the line after
				do setin
				do setNonDistinctHybtfForTop($s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")"),"""""")
			} else {
				do adset($s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")"),"""""") ; pre-EEE019
			}
		}
		d setin,setop
		// Only when we have at least one subscript (levcnt>0) that we proceed with generating code to allow PPG overflow for non-DISTINCT hybrid temp-files
		if generatedPPGoverflow=0 && levcnt>0 && $$hybtfForNonDistinct^%qaqcpre(filenum) {
			do overflowIntoPPG
		}		
		// Reached the end of the temp-file 'set' code, so figure out the line that will be later needed for merging the temp-file
		if $g($$$mtOptionsSQLRuntimeStatsFlag)=1 {
			do generateTfMergeLine(filenum)
		}
		QUIT
	}
	#; AK610-
	// makelev2 takes care of setting the temp-table appropriately for non-DISTINCT hybrids with TOP optimization (since they use an if-else logic for builds)
	Do makelev2(.node,.ref,mod,.pti,ntry)
	// Only when we have at least one subscript (levcnt>0) that we proceed with generating code to allow PPG overflow for non-DISTINCT hybrid temp-files
	if generatedPPGoverflow=0 && levcnt>0 && $$hybtfForNonDistinct^%qaqcpre(filenum) {
		do overflowIntoPPG
	}
	// Reached the end of the temp-file 'set' code, so figure out the line that will be later needed for merging the temp-file
	if $g($$$mtOptionsSQLRuntimeStatsFlag)=1 {
		do generateTfMergeLine(filenum)
	}
	QUIT
	;
overflowIntoPPG
	// Copied from distinct^%qaqcpre
	set tfvarr = $$$getVarName("hybtf"_filenum)
	set tfname = $$$getVarName("hybtfn"_filenum)
	// If TOP optimization used, we change to writing into the PPG directly after one overflow
	$$$liin("if "_$s($p(stuff,$c(1),12):"($e("_tfname_")'=""^"") && ",1:"")_"($i("_tfvarr_")>"_$$maxhyb^%qaqcpre(filenum)_") {")
	$$$liin($c(9)_"d "_$$hybtag^%qaqcpre(filenum))
	// If TOP optimization used:
	// 	1. for DESC, do nothing;
	// 	2. for ASC (i.e., no DESC), set only i%limit_ to now reference the PPG - a logic copied from setopq^%qaqcct
	//  (because the limit_sub_ variables will be set correctly upon next write into the PPG if a better result was found)
	if $p(stuff,$c(1),12) && ($$$mtSequencersQb(m)'["d") {
		$$$liin($c(9)_"s "_$$$getVarName("limit"_filenum)_"=$na(@"_tfname_"@(""""))")
	}
	$$$liin("}")
	set generatedPPGoverflow=1
	QUIT
generateTfMergeLine(filenum) [levcnt,mt,sqlidxhash,sqline] {
	// Figure out the line for merging the temp-file and plug it into its proper location (if already figured out); used for SQL runtime statistics
	if ($$hybtf^%qaqcpre(filenum) || ($$hybtfForNonDistinct^%qaqcpre(filenum) && levcnt>0)) {
		// Different merge line for non-DISTINCT hybrid temp-files
		set $$$mtSQLRuntimeStatsMergeLineString(filenum) = "if ($e("_$$$getVarName("hybtfn"_filenum)_")'=""^"") { merge "_$$$SQLRuntimeStatsQ_"("_$g($$$mtOptionsSQLRuntimeStatsPID)_","""_$LG($g(sqlidxhash),1)_""",""tf"","_filenum_",""merge"") = "_$$$getVarName("hybtf"_filenum)_" } else { merge "_$$$SQLRuntimeStatsQ_"("_$g($$$mtOptionsSQLRuntimeStatsPID)_","""_$LG($g(sqlidxhash),1)_""",""tf"","_filenum_",""merge"") = "_$$tfref^%qaqcpre(filenum,2,2)_" }"
	} else {
		set $$$mtSQLRuntimeStatsMergeLineString(filenum) = "merge "_$$$SQLRuntimeStatsQ_"("_$g($$$mtOptionsSQLRuntimeStatsPID)_","""_$LG($g(sqlidxhash),1)_""",""tf"","_filenum_",""merge"") = "_$$tfref^%qaqcpre(filenum,2,0)
	}
	if $d($$$mtSQLRuntimeStatsMergeLineLocation(filenum),mergeLineLocation) {
		set $$$sqline($p(mergeLineLocation,"^",1),$p(mergeLineLocation,"^",2)) = $$$sqline($p(mergeLineLocation,"^",1),$p(mergeLineLocation,"^",2))_" "_$$$mtSQLRuntimeStatsMergeLineString(filenum)
	}
}
makelev2(node,ref,mod,pti,ntry) [ piece,filenum,stuff ] {
	Set sublev=""
	For {
		; Spin down thru the levels that have data & Gen code.
		Set sublev=$order(node(sublev)) Quit:sublev=""  ;  AK850
		Set node=""
		For {
			#; Finally down to the node. We'll get all the fields for this
			#; node set into a local variable, than flash it to the DISC.
			Set complex=0
			Set node=$order(node(sublev,node),1,complex) Quit:node=""
			Set ref=ref(sublev)
			If node Set ref=ref_$S($e(ref,*)="(":"",1:",")_node
			If complex {
				#; Use 'Set $list(<var>,<pos>)=<val>' to insert items and finally set temp table to this value
				#; or if aggregate it will have the whole node so this generates efficient code already
				Set icol="",pece1=1  ;  pece1 marks to first initialize %n
				For {
					#; Go thru all the columns that are on this node
					Set icol=$order(node(sublev,node,icol),1,x) Quit:icol=""
					Set piece=$piece(x,$c(1)),aggs=$piece(x,$c(1),5,6)
					#; Set 'piece'
					If piece'="" {
						Set nodevar=$$$getVarName("build"_mod_"ntry"_ntry)
						#;  If pieced, 1st see if its in from disc yet
						If pece1 Set pece1=0 Do adset(nodevar,$S($c(1)[aggs:"""""",1:"$g("_$s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")")_")"))
						Set piece="$li("_nodevar_","_piece_")"
					}
					#;  It's an aggregate - better calculate first
					If $char(1)'[aggs {
						Do calcagg($piece(aggs,$c(1),1),$p(aggs,$c(1),2),1,icol)
						If piece="" QUIT
					} Else {
						Set var1=pti(icol)
						#;  Single field in the whole node - get node over with
						#; If piece="" Do adset($s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")"),var1) QUIT
						#; Do adset(piece,var1)
						If piece="" {
							// If TOP optimization used and it's a non-DISTINCT hybrid temp-file, set temp-file node on separate line because we use an if-else logic for build
							if $$hybtfForNonDistinct^%qaqcpre(filenum) && $p(stuff,$c(1),12) {
								// Set all things to be set so far then set the temp-file on the line after
								do setin
								do setNonDistinctHybtfForTop($s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")"),var1)
								QUIT
							} else {
								Do adset($s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")"),var1) QUIT ; pre-EEE019
							}
						}
						Do adset(piece,var1)
					}
				}
				If $get(nodevar)'="" {
					// If TOP optimization used and it's a non-DISTINCT hybrid temp-file, set temp-file node on separate line because we use an if-else logic for build
					if $$hybtfForNonDistinct^%qaqcpre(filenum) && $p(stuff,$c(1),12) {
						// Set all things to be set so far then set the temp-file on the line after
						do setin
						do setNonDistinctHybtfForTop($s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")"),nodevar)
					} else {
						Do adset($s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")"),nodevar) ; pre-EEE019
					}
				}
			} Else {
				#; No aggregates and just piece position items, construct the $lb
				#; Do not need to worry about line length here because we only ever put a fixed number of columns in a temp table
				#; Put the temp table set onto its own line
				Do setin
				Set icol="",max=0
				For {
					Set icol=$order(node(sublev,node,icol),1,x) Quit:icol=""
					Set piece=$piece(x,$c(1))
					Set listpos(piece)=pti(icol)
					If piece>max Set max=piece
				}
				Set val="$lb("
				For i=1:1:max {
					Set var=$get(listpos(i))
					Set val=val_var_","
				}
				// If TOP optimization used and it's a non-DISTINCT hybrid temp-file, set temp-file node on separate line because we use an if-else logic for build
				if $$hybtfForNonDistinct^%qaqcpre(filenum) && $p(stuff,$c(1),12) {
					// Set all things to be set so far then set the temp-file on the line after
					do setin
					do setNonDistinctHybtfForTop($s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")"),$extract(val,1,*-1)_")")
				} else {
					Do adset($s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")"),$extract(val,1,*-1)_")") ; pre-EEE019
				}
			}
		}
	}
	Do setin,setop
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK610
setop	;  if TOP optimization, set cardinality and 'limit' variables
	#; AK875
	n m s m=$p(stuff,$c(1),12)
	QUIT:'m  ;  TOP optimization not used
	n limit,card,line,ref,i5 s card=$$$getVarName("card"_filenum)
	#; AK875-
	#; AK841
	d nullvar^%qaqcasl(card) s ref=$$$mtTref(mod_"^"_ntry),line=""
	#; Handle bitmap temp file code generation, only ever have a single subscript
	if $p(stuff,$c(1),8)="bit" {
		n limitsub s limitsub=$$$getVarName("limit"_filenum_"sub1")
		set limit=$$$getVarName("limit"_filenum),ref=ref_$s($e(ref,*)="(":"",1:",")
		do nullvar^%qaqcasl(limitsub)
		if $$$mtSequencersQb(m)["d" {
			#;  i $i(card1)'<topn f  s limit1=$s(limit1sub1="":0,1:$bitfind(table1(limit1sub1+1\64000+1),1,limit1sub1+1#64000+1)) i limit1 { s limit1sub1=limit1sub1+1\64000*64000+limit1-1 Q } s limit1sub1=$o(table1($s(limit1sub1="":"",1:limit1sub1+1\64000+1)))-1*64000-1
			set line=" f  s "_limit_"=$s("_limitsub_"="""":0,1:$bitfind("_ref_limitsub_"+1\64000+1),1,"_limitsub_"+1#64000+1)) i "_limit_" { s "_limitsub_"="_limitsub_"+1\64000*64000+"_limit_"-1 Q } s "_limitsub_"=$o("_ref_"$s("_limitsub_"="""":"""",1:"_limitsub_"+1\64000+1)))-1*64000-1"
		} else {
			#;  i $i(card1)'<topn f  s limit1=$s(limitsub1="":0,1:$bitfind(table1(limit1sub1-1\64000+1),1,limit1sub1-1#64000+1,-1)) i limit1 { s limit1sub1=limit1sub1-1\64000*64000+limit1-1 Q } s limit1sub1=$o(table1($s(limit1sub1="":"",1:limit1sub1-1\64000+1)),-1)*64000
			set line=" f  s "_limit_"=$s("_limitsub_"="""":0,1:$bitfind("_ref_limitsub_"-1\64000+1),1,"_limitsub_"-1#64000+1,-1)) i "_limit_" { s "_limitsub_"="_limitsub_"-1\64000*64000+"_limit_"-1 Q } s "_limitsub_"=$o("_ref_"$s("_limitsub_"="""":"""",1:"_limitsub_"-1\64000+1)),-1)*64000"
		}
		$$$liin("i $i("_card_")'<("_$$paginationTotalRows(m)_")"_line) // get offset rows too when creating temp files
		QUIT
	}
	#; AK739
	GOTO:$$$mtSequencersQb(m)'["d" setopq  ;  no DESC, use $QUERY
	#;  i $I(card)'<topn f  s limit3=$O(^mtemp0(tfn(2),0,limit1,limit2,limit3),-1) QUIT:limit3'=""  f  s limit2=$O(^mtemp0(tfn(2),0,limit1,limit2),-1) QUIT:limit2'=""  s limit1=$O(^mtemp0(tfn(2),0,limit1),-1)
	f i5=1:1:levcnt {
		set limit=$$$getVarName("limit"_filenum_"sub"_i5)
		set ref=ref_$s($e(ref,*)="(":"",1:",")_limit
		// For TOP optimization with DESC, we use $select to read non-DISTINCT hybrid temp-files, used for setting i%limit_sub_ variables
		if $$hybtfForNonDistinct^%qaqcpre(filenum) {
			new refLocal,refPPG
			set refLocal = $replace(ref,"@"_$$$getVarName("hybtfn"_filenum)_"@(",$$tfref^%qaqcpre(filenum,1,1)) ; readWriteMode=1 to indicate that we want to use a local temp-file reference for this non-DISTINCT hybrid temp-file (because it's what we will write to when "i%hybtfn1='""^""")
			set refPPG = $replace(ref,"@"_$$$getVarName("hybtfn"_filenum)_"@(",$$tfref^%qaqcpre(filenum,1,2)) ; readWriteMode=2 to indicate that we want to use a PPG reference for this non-DISTINCT hybrid temp-file (because it's what we will write to when "i%hybtfn1=""^""")
			// From $$tfref^%qaqcpre:
			set refLocal = "$O("_refLocal_"),"_$e("-",$p($$$mtSequencersQb(m),",",i5)'["d")_"1)"
			set refPPG = "$O("_refPPG_"),"_$e("-",$p($$$mtSequencersQb(m),",",i5)'["d")_"1)"
			set line=$s(i5'=1:" f  s:"_$$$getVarName("limit"_filenum_"sub"_(i5-1))_"'="""" ",1:" s ")_limit_"=$s($e("_$$$getVarName("hybtfn"_filenum)_")=""^"":"_refPPG_",1:"_refLocal_")"_$s(i5'=1:" q:"_limit_"'="""" ",1:"")_line
		} else {
			set line=$s(i5'=1:" f  s:"_$$$getVarName("limit"_filenum_"sub"_(i5-1))_"'="""" ",1:" s ")_limit_"=$O("_ref_"),"_$e("-",$p($$$mtSequencersQb(m),",",i5)'["d")_"1)"_$s(i5'=1:" q:"_limit_"'="""" ",1:"")_line
		}
		d nullvar^%qaqcasl(limit)  ;  AK633
	}
	#; AK739-
	$$$liin("i $i("_card_")'<("_$$paginationTotalRows(m)_")"_line) // get top and offset rows when creating temp files
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setopq	;  use $QUERY/$QSUBSCRIPT:
	#;  s:$I(card)'<topn limit=$Q(@limit,-1),limit1=$QS(limit,3),limit2=$QS(limit,4),limit3=$QS(limit,5)
	s limit=$$$getVarName("limit"_filenum)
	#; AK833
	d nullvar^%qaqcasl($$$getVarName("limit"_filenum_"sub1"))
	if '$$glotf^%qaqcpre(filenum) {
		// If it's a post-EEE019 hybrid temp-file (p1'="dist" / non-DISTINCT statements):
		// 	1. First, initialize similarly to how you would a glotf/pre-EEE019 hybrid (DISTINCT).
		// 	2. Then, set some variables that are needed for the TOP optimization to function properly with ASC (no DESC).
		if $$hybtfForNonDistinct^%qaqcpre(filenum) {
			new tfname
			set tfname = $$$getVarName("hybtf"_filenum)
			// Set i%hybtfn_
			d initvar^%qaqcasl($$$getVarName("hybtfn"_filenum),"##quote("_tfname_")")
			// Set i%limit_
			d initvar^%qaqcasl(limit,$$$quote($$adsub^%qaqcmn(tfname)_""""")")) ; sometimes tfname ends with a right parenthesis, so we need to open it accordingly
			#; AK841
			// Should set i%limit_sub_ to $qs(i%limit_,$s($e(i%limit_)="^":2,1:1)) to accommodate both PPG and local temp-files
			f i5=1:1:$l($$$mtSequencersQb(m),",")-1 s line=line_","_$$$getVarName("limit"_filenum_"sub"_i5)_"=$qs("_limit_",$s($e("_limit_")=""^"":"_(i5+1)_",1:"_i5_"))"
		} else {
			d initvar^%qaqcasl(limit,$$$quote($s($e(ref,*)="(":ref,1:ref_",")_""""")"))
			#; AK841
			f i5=1:1:$l($$$mtSequencersQb(m),",")-1 s line=line_","_$$$getVarName("limit"_filenum_"sub"_i5)_"=$qs("_limit_","_i5_")"
		}
	} else {
		// It's a global/pre-EEE019 hybrid (p1="dist" / DISTINCT statements)
		d initvar^%qaqcasl(limit,"$na("_$s($e(ref,*)="(":ref,1:ref_",")_"""""))")
		#; AK841
		f i5=1:1:$l($$$mtSequencersQb(m),",")-1 s line=line_","_$$$getVarName("limit"_filenum_"sub"_i5)_"=$qs("_limit_","_(i5+1)_")"
	}
	$$$liin("s:$i("_card_")'<("_$$paginationTotalRows(m)_") "_limit_"=$q(@"_limit_",-1)"_line) // get offset rows too when creating temp files
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK610-
	// Called from aggate, makelev2
calcagg(aggfun,aggcol,subagg,aggval) ; Insert code to calculate subaggregates and aggregates.
	#;  For regular aggregates (subagg=0), the result goes into var1
	#;  aggval is the $$$mtV(val) for this aggregate entry, only defined when coming from makelev2 for UDAFs
	new canbenull,isnull,newag,oldag,val1
	set canbenull=1
	if aggcol {
		set val1=pti(aggcol)  ;  for COUNT(*) aggcol=NULL, val1 not used
		set canbenull=$$nullreplace(aggcol,1)
	}
		#;  If only NULL values found, AGG=NULL except that COUNT=0
	if 'subagg       { set newag=var1,oldag=var1 }	// regular aggregate
	elseif piece'="" { set newag=piece,oldag=$$strrep(piece,"$li(","$lg(",1) }
	else             { set newag=$s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")"),oldag="$g("_newag_")" }
.
		#;  Start the actual aggregate calculation
	new aggrep
	set aggrep=$s('subagg&&(+$p(stuff,$c(1),9)):$g(pti(+$p(stuff,$c(1),9))),1:"")  ;  repetition counter (AK614+)
.
		#;  If the aggregation operator has been overridden by the class, then let the class method do the work (JLF049)
	if aggcol'="",$e($g($$$mtV(aggcol)))="f",'$d($$$mtRVirtual($$$mtVFieldQbOrStream($$$mtV(aggcol)))) {
		new irn,ifn,pkgdotcls,methname
		set irn=$$$mtRIrn($$$mtR($$$mtVFieldQbOrStream($$$mtV(aggcol)))),ifn=$$$mtVFieldLabelOrIFN($$$mtV(aggcol))
		set pkgdotcls=$$$smdClassname($$$smdTType(irn),irn),methname=$$$smdColPropertyName($$$smdTType(irn),irn,ifn)_"SQL"_aggfun
		if $$ismeth^%qadadt(pkgdotcls,methname)=1 { // DPV2538=  Check should be =1
			$$$liin("s"_$s(canbenull:":"_val1_"'=""""",1:"")_" "_newag_"=##class("_pkgdotcls_")."_methname_"("_oldag_","_val1_$S(aggrep'="":","_aggrep,1:"")_")")  ;  AK614
			RETURN
		}
	}
	
		#; Handle User Defined Aggregate Functions
	if $e(aggfun,1,4)="udaf" {
		new class,i,initcall,method,procname,schema,args2N,x
		set schema=$p(aggfun,$c(2),2),procname=$p(aggfun,$c(2),3),args2N=""
		set class=$$$PROCudafiteratefunction($$$pPROC,schema,procname)		// class is now $lb(class,method,SCHEMA,FUNCTION) for the iterator function
		set initcall=$g($$$PROCudafinitializefunction($$$pPROC,schema,procname))	// initcall is now $lb(class,method,SCHEMA,FUNCTION) for the iterator function
			#; oldag is our state variable (current/old aggregate value)
			#; val1 is our input value
			#; Inputs values 2 -> N (if any) are in stuff piece 13, or we get them from mt(v",aggval) if aggval is defined
		if $g(aggval)'="" {
			set x=$$$mtVAggUDAFOrKeyVal($$$mtV(aggval))	// x is LIST(val#,)
		} else {
			set x=$p(stuff,$c(1),13)
		}
		for i=1:1 {
			quit:$p(x,",",i)=""
			set args2N=args2N_","_$$ptvalue^%qaqcpr($p(x,",",i))
		}
		if initcall'="" { $$$liin("set:'$d("_newag_") "_newag_"=##class("_$lg(initcall,1)_")."_$lg(initcall,2)_"()") }
		$$$liin("set "_newag_"=##class("_$lg(class,1)_")."_$lg(class,2)_"("_oldag_","_val1_args2N_")")
		RETURN
	}
	if aggfun="approx_count_distinct" {
		$$$liin("set "_$$$getVarName("acdStatus")_" =""""")
		set line="if ("_oldag_"="""") { set "_newag_"=##class(%SQL.HLL).%New() }  if ("_val1_"'="""") { set "_$$$getVarName("acdStatus")_" = "_newag_".update("_val1_") }"
		set line=line_"  if "_$$$getVarName("acdStatus")_" { set SQLCODE=-400,%msg=""HyperLogLog update error""  ztrap ""HLER"" }"
		$$$liin(.line)
		RETURN
	}
		#; AK614
	if aggfun="count" {	// DPV3721=
		if aggrep'="" {
			if $e(newag,1,3)="$li" {
				do adset(newag,$S(canbenull:val1_"'=""""*"_aggrep,1:aggrep)_"+"_oldag)  ;  4/4/2kx4 throw-away line for before DPV4377
			} else {
				do setin $$$liin($s($e(newag)="^":"i "_aggrep_" ",1:"")_"d $i("_newag_","_$S(canbenull:val1_"'=""""*",1:"")_aggrep_")")
			}
			RETURN
		}
		if $$IsAStream(aggcol) {		// COUNT(stream field)
			if $$$VTRgetoref(aggcol)=1 { 	// %OBJECT(StreamField)
				do adset(newag,$S(aggcol:"$s("_val1_"'="""":'"_val1_".IsNull(),1:0)+",1:"1+")_oldag)
			} else {				// Stream Oid
				do adset(newag,$S(aggcol:"$s("_val1_"'="""":'##class(%Stream.Object).StreamOIDIsNull("_val1_"),1:0)+",1:"1+")_oldag)	// DPV3910 (StreamOIDIsNull)
			}
			RETURN
		}
			#; AK841
		if $e(newag,1,3)="$li" {
			do adset(newag,$S(canbenull:val1_"'=""""+",1:"1+")_oldag)  ;  4/4/2kx4 throw-away line for before DPV4377
			RETURN
		}
			#; DAP004
			#; Check not null against fn(null) where fn is collation of column being aggregated
			#; If aggregate is * then aggcol = "" so cannot run (and do not need) $$colnul^%qaqcpr(aggcol)
		new nulstr
		set nulstr = $SELECT(aggcol="":"",canbenull:$$colnul^%qaqcpr(aggcol),1:"")
		do setin
		if newag["(" {
			$$$liin("d $i("_newag_$S(nulstr'="":","_val1_"'="_nulstr,1:"")_")")
		} else {
			$$$liin("s"_$s(nulstr'="":":"_val1_"'="_nulstr,1:"")_" "_newag_"="_newag_"+1")
		}
		RETURN
			#; DAP004-
		
		#; AK841-
	}
		#; AK506
	if aggfun="bitcount" { do adset(newag,"$bitcount("_val1_",1)+"_oldag) RETURN }
		#; AK608
	if aggfun="negcount" { do adset(newag,"$bitcount("_val1_",1)-(2*$bitcount($bitlogic("_val1_"&"_pti($p(stuff,$c(1),11))_"),1))+"_oldag) RETURN }
	if aggfun="orbit"    { do adset(newag,"$bitlogic("_val1_"|"_newag_")") RETURN }
	if aggfun="andbit"   { do adset(newag,"$bitlogic("_val1_"&"_newag_")") RETURN }
		#; AK506-
	if aggfun="%bitmapchunk" { $$$liin("s:"_val1_"'="""" $bit("_newag_","_val1_"#64000+1)=1") RETURN }  ;  AK690
	if aggfun="%bitmap" { $$$liin("d:"_val1_"'="""" "_newag_".SetBit("_val1_",1)") RETURN }  ;  AK690
		#; JLF005
		#; JLF083
	if aggfun="anyneq" { do adset(newag,"$s(("_oldag_"="_$$$SQLEMPTYq_"):$lb($s("_val1_"="_$$colnul^%qaqcpr(aggcol)_":"""",1:"_val1_")),("_oldag_"="_$$$SQLMULTIDISTINCTVALUED_")||($li("_oldag_")="_val1_"):"_oldag_","_val1_"="_$$colnul^%qaqcpr(aggcol)_":$lb($li("_oldag_"),""""),$li("_oldag_")="""":$lb("_val1_",""""),1:"_$$$SQLMULTIDISTINCTVALUED_")") RETURN }
	if aggfun="alleql" { do adset(newag,"$s(("_oldag_"="_$$$SQLCONTAINSNULL_")||("_oldag_"="_$$$SQLMULTIDISTINCTVALUED_"):"_oldag_","_val1_"="_$$colnul^%qaqcpr(aggcol)_":"_$$$SQLCONTAINSNULL_","_oldag_"="_$$$SQLEMPTYq_":$lb("_val1_"),$li("_oldag_")="_val1_":"_oldag_",1:"_$$$SQLMULTIDISTINCTVALUED_")") RETURN }
	if aggfun="allmin" { do adset(newag,"$s("_oldag_"="_$$$SQLCONTAINSNULL_":"_$$$SQLCONTAINSNULL_","_val1_"="_$$colnul^%qaqcpr(aggcol)_":"_$$$SQLCONTAINSNULL_","_oldag_"="_$$$SQLEMPTYq_":$lb("_val1_"),$li("_oldag_")]]"_val1_":$lb("_val1_"),1:"_oldag_")") RETURN }
	if aggfun="allmax" { do adset(newag,"$s("_oldag_"="_$$$SQLCONTAINSNULL_":"_$$$SQLCONTAINSNULL_","_val1_"="_$$colnul^%qaqcpr(aggcol)_":"_$$$SQLCONTAINSNULL_","_val1_"]]$li("_oldag_"):$lb("_val1_"),1:"_oldag_")") RETURN }
		#; JLF083-
	if aggfun="anyeql" { do adset(newag,"""""") RETURN }
	if aggfun="allneq" { do adset(newag,"""""") RETURN }
	
	if aggfun="anymin" { do adset(newag,"$s((("_oldag_"="""")||("_oldag_"]]"_val1_"))&&("_val1_"'="_$$colnul^%qaqcpr(aggcol)_"):"_val1_",1:"_oldag_")") RETURN }
	if aggfun="anymax" { do adset(newag,"$s(("_val1_"]]"_oldag_")&&("_val1_"'="_$$colnul^%qaqcpr(aggcol)_"):"_val1_",1:"_oldag_")") RETURN }
		#; JLF005-
	do setin  ;  not a simple SET, so flush in old SETs, start a new line
		#; AK614
		#; AK841
	if aggfun="sum" {
		if $e(newag,1,3)="$li" {
			$$$liin("s"_$s(canbenull:":"_val1_"'=""""",1:"")_" "_newag_"="_val1_$s(aggrep'="":"*"_aggrep,1:"")_"+"_oldag)  ;  4/4/2kx4 throw-away line for before DPV4377
		} else {
			if newag["(" {
				$$$liin("d"_$s(canbenull:":"_val1_"'=""""",1:"")_" $i("_newag_","_val1_$s(aggrep'="":"*"_aggrep,1:"")_")")
			} else {
				$$$liin("s"_$s(canbenull:":"_val1_"'=""""",1:"")_" "_newag_"="_newag_"+"_$s(aggrep="":val1,1:"("_val1_"*"_aggrep_")"))
			}
		}
		RETURN
	}
		#;  SET sumP=sumP+($$POWER(val)*scale*cnt), aggrep must be supplied
	i aggfun="sump" { 
		$$$liin("d:"_aggrep_"'="""" $i("_newag_",$s("_val1_"=""Z"":0,1:2**("_val1_"-1)*"_$p(stuff,$c(1),11)_"*"_aggrep_"))") 
		QUIT 
	}
	#; AK841-
.
	if aggfun="list" {
			// if the new value is NULL (""), do nothing
			// if the new value is not the empty string ($c(0)), concatenate it
			// if the new value is the empty string, and there are already aggreated values, and don't use $c(0) just leave it empty
			// if the new value is the empty string, and there are not already aggregated values, set the value to $c(0).
		set line="if ("_oldag_"="""") { set "_newag_"="_val1_" } elseif ("_oldag_"'=$c(0)) { set "_newag_"="_oldag_"_"",""_$s(("_val1_"'=$c(0)):"_val1_",1:"""") } else { set "_newag_"="",""_$s(("_val1_"'=$c(0)):"_val1_",1:"""") }" 
		if canbenull set line= "if ("_val1_"'="""") { "_line_" }"
		$$$liin(.line)
		RETURN
	}
	if aggfun="distinctlist" {
			// if the new value is NULL (""), do nothing
			// if the new value is not the empty string ($c(0)), concatenate it if not already in the list
			// if the new value is the empty string, and there are already aggreated values, and don't use $c(0) just leave it empty
			// if the new value is the empty string, and there are not already aggregated values, set the value to $c(0).
		set line="if ("_oldag_"="""") { set "_newag_"="_val1_" } "_	//first value in the list
					"elseif ("_oldag_"'=$c(0)) { if "_val1_"'=$c(0) { set:("",""_"_oldag_"_"","")'[("",""_"_val1_"_"","") "_newag_"="_oldag_"_"",""_"_val1_" } elseif $p("_newag_","","",1)'="""",$p("_newag_","","",*)'="""","_newag_"'["",,"" { set "_newag_"="_oldag_"_"","" }} "_	// Current list is not just empty string, add string value if it is not already in the list
					"elseif ("_val1_"'=$c(0)) { set "_newag_"="",""_"_val1_" }"	// Current list is just the empty string, add value if it is not the empty string
		if canbenull { set line= "if ("_val1_"'="""") { "_line_" }"	} // don't add null values to the list
		$$$liin(.line)
		RETURN
	}
	if aggfun="distinct%dlist" {
		set line="set:"_$s(canbenull:val1_"'=""""&&",1:"")_"('$lf("_oldag_","_val1_")) "_newag_"="_oldag_"_$lb("_val1_")"
		$$$liin(.line)
		RETURN
	}
	if aggfun="%dlist" {
		set line="set"_$s(canbenull:":"_val1_"'=""""",1:"")_" "_newag_"="_oldag_"_$lb("_val1_")"
		$$$liin(.line)
		RETURN
	}
	i aggfun="somevalue" { $$$liin("s "_newag_"="_val1) RETURN }
	if aggfun="xmlagg" {
			// if the new value is NULL (""), do nothing
			// if the new value is not the empty string ($c(0)), concatenate it and if the existing value was $c(0), remove the $c(0).
			// if the new value is the empty string, and there are already aggregated values, do nothing
			// if the new value is the empty string, and there are not already aggregated values, set the value to $c(0).
		set line="if ("_val1_"'="""") { if ("_val1_"'=$c(0)) { if ("_oldag_"=$c(0)) { set "_newag_"="_val1_" } else { set "_newag_"="_oldag_"_"_val1_" }} else { set:("_oldag_"="""") "_newag_"=$c(0) }}" 
		$$$liin(.line)
		 RETURN
	}
		#; To Do:
		#; 		Since order within a list is significant, the SQL/XML standard specifies an ORDER BY
		#; 		clause as an optional qualifier of an xmlAgg function.  If specified, the ORDER BY list
		#; 		is stored in $p($$$mtV(val),"^",7) for the "val" of this aggregate function.
		#; 		
		#; 		When an ORDER BY is specified, we need to set ^mtemp0(tID, subscriptList) = $g(^mtemp0(tID, subscriptList)) _ $lb(val1)
		#; 		and then serialize the results with a $o loop in ptvalue^%qaqcpr, with a new case for the 
		#; 		xmlagg operator. This would probably also require the allocation of a temp table in
		#; 		qaqpag, and possibly the passing of the ORDER BY list in some other way.  The expressions
		#; 		in the ORDER BY list need to be evaluated, but I'm not sure where this evaluation would occur.
		#; 		
		#;  MAX/MIN - cover case that col is not NULL, agg is NULL
	new getold,fn,oldcoll,fcoll
	set getold=""
		#;  for subaggregate, better to use local than global
	if subagg,piece="" { set getold="s "_var1_"="_oldag,oldag=var1 }
	set line=$s(canbenull:"i "_val1_"'="_$$colnul^%qaqcpr(aggcol)_" ",1:"")_getold_" s:"
		#; No need for $s check for "" for 'max' case as any value always follows ""
	set line=line_$s(aggfun="max":val1_"]]"_oldag,1:"$s("_oldag_"="""":1,1:"_oldag_"]]"_val1_")")_" "_newag_"="_val1
	$$$liin(.line)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
bldaray	;  EP from build action.  Set the Arrays:  asl(mod,4,ntry,"bd")
	#;  Which have all the stuff to build and retrieve data.
	#;  The following variables are left around to be used by the
	#;  caller:  ref(), node(), line
	n ilev,stuff,icol,constant,ifn,nulev
	s ilev=0,sublev=0,line="",nulev=1,ref(sublev)=ref
bldloop	; Get the Global References, and sort by nodes.
	#; Data may be stored at varying levels (aggregates), so we
	#; gotta get the global refs, and nodes BY level.
	#;
	s ilev=$o($$$aslActNode(mod,ntry,ilev),1,stuff)
	q:"bd"[ilev  ;  done building build array
	s icol=$p(stuff,$c(1),2),constant=$p(stuff,$c(1),3)
	#; AK615
	#;  if constant=$P(3) set, icol would be empty
	i icol s var1=pti(icol),val=$$$mtV(icol) s:$E(val)="t" constant=var1  ;  a constant subscript
	#; AK615-
	#; AK506
	#;  use SET $BIT() for ID's going into an id-list - no more subscripts
	i $p(stuff,$c(1),9)="bit" {
		#; For distinct table we have already set the distinct bit so no need to do it here too
		if $p($$$mtTempFile(filenum),"^")'="dist" $$$liin("s $bit("_ref_$s($e(ref,*)="(":"",1:",")_var1_"\64000+1),"_var1_"#64000+1)=1")
		k ref
		QUIT
	}
	#; AK506-
	g:$p(stuff,$c(1),1)="" data ; its data - go set up the node array
	i constant'="" s ref=ref_$s($e(ref,*)="(":"",1:",")_constant,sublev=sublev+1,nulev=1,ref(sublev)=ref g bldloop ; put it in subscripts
	#;  IF a temp ID, better bump it
	#; AK849
	d:$p(stuff,$c(1),8)="tid" adset(var1,var1_"+1"),null^%qaqcasl(icol)  ;  flag for temp ID.  ;  EYT148;AK215
	#; set the string to set the subs.  If a NULL set = " "
	if $$nullreplace(icol) {
		if ($$$mtV(icol)="i^tempID")||($e($$$mtV(icol),1,9)="i^^i^dist") {
			s rvar=var1
		} else {
			#; Can not use "sub"_icol as we use this for subscript variable already and this could be different due to different null subscript marker values
			#; Shows up in SQL/ODBCviaSQLGateway/queryoptimization/AK618 where it loop forever
			#; If we already have the same null marker we can use this directly, second if we do not then we can avoid new variables by using expression (is this a good idea, can we detect how many things we will build with this subscript?)
			#; Maybe better is can we mark the temp table as using a different null marker than -1E19 if the subscript comes from a different null marker value?
			#; Also suspect the test for $data on "sub"_icol is not the best way to determine if we are looping on this
			if $get($$$mtNullMarkerSub(mod,icol))=$$$NULLSubscriptMarker19q,$data($$$VarNum("sub"_icol)) {
				s rvar=$$$getVarName("sub"_icol)
			} else {
				s rvar=$$tomark^%qaqcpr(var1)
			}
		}
	} else {
		set rvar=var1
	}
	s ref=ref_$s($e(ref,*)="(":"",1:",")_rvar
	#; AK849-
	s sublev=sublev+1  ;  lev of variable subscripts
	s ref(sublev)=ref,nulev=1  ;  Set for all levels even without node data  ;  AK850
	g bldloop
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
data	;  This is Data - Start building the Node list.
	#; store current refernce and get new node stuff if not there.
	s:nulev node=" ",piece="",nulev=0  ;  AK850
	#; Store unary(f) in the temp file as well!
	#; (but not if it's an aggregate = $P(6,7))
	d:$c(1)[$p(stuff,$c(1),6,7) addfun(icol,"%ODBCOUT"),addfun(icol,"%RUNTIMEOUT"),addfun(icol,"%EXTERNAL"),addfun(icol,"%INTEXT")
	d adddata("bd"[$O($$$aslActNode(mod,ntry,ilev)))  ;  add the icol (field?) itself
	g bldloop
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
addfun(ficol,keyword) ; Add the converted value as well
	n icol
	s icol=$g(mt("unary",ficol,keyword))
	#; AK662
	QUIT:'icol  ;  keyword was not requested
	QUIT:pti(icol)=pti(ficol)  ;  same variable, keyword is no-op
	#; AK662-
	#;  add it, if this keyword was requested.  pass in 0 to force
	d:icol adddata(0)  ;  $Piecing in the node, since it's not alone
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adddata(last) ; Add icol to the data of the current sublev.
	#;	Pack it with some fields in the current node.
	#;  	If it's the last icol, AND also the first in this node, there's no need to increment piece. 
	#;	Maintain node,piece,del
	#;	If last field in a new node, no piece increment - esp. for agg's!
	if 'last||piece { set piece=piece+1 }
	set:'$d($$$aslBuildActNode(mod,ntry,icol)) $$$aslBuildActNode(mod,ntry,icol)=$s(node:ref(sublev),1:"")_$c(1)_sublev_$c(1)_node_$c(1)_piece  ;  used only in tempdata^dat
		#; set $$$aslBuildActNodeRef($$$aslBuildActNode(mod,ntry,icol))=$s(node:ref(sublev),1:"")
		#; set $$$aslBuildActNodeRefTfSubscript($$$aslBuildActNode(mod,ntry,icol))=sublev
		#; set $$$aslBuildActNodeTfNode($$$aslBuildActNode(mod,ntry,icol))=node
		#; set $$$aslBuildActNodeTfDataPosition($$$aslBuildActNode(mod,ntry,icol))=piece
	#;  now set node() that's used in nodecol+2 to generate set code
	new x set x=piece_$c(1,1,1,1)_$p(stuff,$c(1),6,7)
	set:'$d(node(sublev,node,icol)) node(sublev,node,icol)=x
	#; See if we can use mode efficient 'set <tmptable>=$lb(args,...)' format, set to 1 if we can not
	if $c(1)'[$p(x,$c(1),5,6)||('piece) { set node(sublev,node)=1 }
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adset(into,from)  ;  add a SET argument to the line
	#; DPV929
	d:$l(line)+$l(into)+$l(from)-20>$$$complength setin s line=line_","_into_"="_$$strrep(from,"$li(","$lg(",1) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setin	if line'="" { set line="s "_$e(line,2,*) $$$liin(.line) } // add line with many SETs
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setNonDistinctHybtfForTop(into,from)
	// Helper function to set/build non-DISTINCT hybrid temp-files when TOP optimization is used using an if-else logic (instead of indirection) for better performance
	new refLocal,refPPG
	// If $$$getVarName("hybtfn"_filenum) ends in ")" such as @i%%sqlcursor(205)@ - or really if it's any node that needs to be opened manually for further subscripting - we need to 1) open the right parenthesis and 2) remove the left parenthesis of the following subscripts tuple
	#; set refLocal = $replace($s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")"),"@"_$$$getVarName("hybtfn"_filenum)_"@",$$$getVarName("hybtf"_filenum))
	set refLocal = $replace($s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")"),"@"_$$$getVarName("hybtfn"_filenum)_"@(",$$tfref^%qaqcpre(filenum,1,1)) ; readWriteMode=1 to indicate that we want to use a local temp-file reference for this non-DISTINCT hybrid temp-file (because it's what we will write to when "i%hybtfn1='""^""")
	set refPPG = $replace($s($e(ref,*)="(":$e(ref,1,*-1),1:ref_")"),"@"_$$$getVarName("hybtfn"_filenum)_"@(",$$tfref^%qaqcpre(filenum,1,2)) ; readWriteMode=2 to indicate that we want to use a PPG reference for this non-DISTINCT hybrid temp-file (because it's what we will write to when "i%hybtfn1=""^""")
	$$$liin("if ($e("_$$$getVarName("hybtfn"_filenum)_")=""^"") { s "_refPPG_"="_$$strrep(from,"$li(","$lg(",1)_" } else { s "_refLocal_"="_$$strrep(from,"$li(","$lg(",1)_" }")
	RETURN
dolget(exp) ; piece out expression for fields in queries
	#; don't $g($P it's gotta be $p($g(, new vars, don't leave garbage
	#; note exp always starts with $p( and contains $c(1)
	n array s array="$g("_$p($E(exp,4,*),",$c(1)")_")"
	s exp="$p("_array_",$c(1)"_$p(exp,",$c(1)",2)
	QUIT exp
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
GetFieldCategory(ifn) ;
	#;  Given the ifn of a field, return the SQL Category for the field
	#;  if virtual stream, try to use original field
	if $d($$$mtVirf(ifn)) {
		set ifn=$g($$$mtV(+$lg($$$mtVirf(ifn),2)))
		QUIT:$e(ifn)'="f" "STRING"
		QUIT $$GetFieldCategory(+$p(ifn,"^",3)) 	// AK446=
	}
	new irn
	set irn=$$$smdGetIrnFromIfn(ifn)
	QUIT $$$smdColCategory(1,irn,ifn)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
IsAStream(val) [mt] public {
	#;  Given the ifn of a field, 1 if this is a Stream field
	QUIT:'val 0
	set v=$g($$$mtV(val))
	QUIT:v="" 0
	QUIT:$p(v,"^",2)="%OBJECT" 1  	// Stream Oref
	if $e(v)="f" { set ifn=$p(v,"^",3) } else { QUIT 0 /* not a field, can't be a stream. Right? */ }
	#;  if virtual stream, try to use original field
	if $d($$$mtVirf(+ifn)) {	// ifn might be #_<collation>
		set virfval=$$virfnext^%qaqcasl(val)
		if virfval="" RETURN 0
		RETURN $$IsAStream(virfval)
	}
	set irn=$$$smdGetIrnFromIfn(+ifn)	// ifn may have collation appended to it
	QUIT $case($$$smdColxDBCType(1,irn,+ifn),"LONGVARCHAR":1,"LONGVARBINARY":1,:0)
}
	
	// Given a position of a output (select list) item, return the value that holds the column's value
getfieldvalue(position) [i,ext,mt,pti,val] PUBLIC {
	new i,ext,val
	set i=0,ext=0
	for iter=1:1:position {	set val=$$nexto^%qaqcasl }
	QUIT pti(val)
}
.
	// Return true if the icol can be "" and false if it can never be null so there is no need to create a null replacement variable for this
nullreplace(icol,ignorecol=0) [mt] public {
	if +icol=0 RETURN 1
	set icoldata=$$$mtV(icol)
	if $p(icoldata,"^")="i" {
		#; No null replacement needed for Temp ID, also distinct variables have already been null replaced if needed
		if (icoldata="i^tempID")||($extract(icoldata,1,9)="i^^i^dist") RETURN 0
		#; Bitmap chunk number can not be null
		if $extract(icoldata,1,7)="i^^i^sb" RETURN 0
	} elseif $p(icoldata,"^")="f" {
		set ifn=$p(icoldata,"^",3)
		set str=$p(icoldata,"^",2),m=$$$mtRQb($$$mtR(str))
		#; If any of the following collations then it can not be ""
		set collation=$p($p(ifn,"_",2),"(")
		if 'ignorecol,$lf($lb("%SQLUPPER","%SQLSTRING","%STRING"),collation) RETURN 0
		if $lf($lb("%PLUS","%MINUS","%SPACE"),collation) RETURN 0
		#; If the stream could be null then no more checking needed
		#; For frozen plan we may not have mt("nulstr") so assume it could be null
		if '$d(mt("nulstr")) RETURN 1
		if $lf(mt("nulstr"),str) RETURN 1
		#; If this field %ID then it can not be ""
		if icol=$$idval^%qaqpmod(m,str) RETURN 0
		#; If virtual stream use original field
		if $d($$$mtVirf(ifn)) {
			#; If dupsv on then different code can share an ifn so disable this optimization
			if $d($$$mtDupsvRoot) RETURN 1
			set realf=$$virfnext^%qaqcasl(icol)
			if realf=""||(realf=icol) RETURN 1
			RETURN $$nullreplace(realf)
		}
		#; If this field is required then it can also not be ""
		if $$ddreqi^%qaqpqo($$$mtRIrn($$$mtR(str)),ifn) RETURN 0
	} elseif $p(icoldata,"^")="v" {
		#; These expressions can not be ""
		set operator=$p($p(icoldata,"^",2),"(")
		if 'ignorecol,$lf($lb("%SQLUPPER","%SQLSTRING","%STRING"),operator) RETURN 0
		if $lf($lb("%PLUS","%MINUS","%SPACE"),operator) RETURN 0
		if operator="%BARS",$l(icoldata,"^")>5 RETURN 0
		if operator="LISTBUILD" RETURN 0
	}
	RETURN 1
}
buildLockRef(m, str, irn, lockref, rowidref) [ mts, pti ] public {
	Set ifns = $$$smdBATOldRowIDPhysical(1,irn)
	If 'ifns RETURN $$strrep(lockref,$c(1),rowidref,1)
	For i=1:1 {
		Set ifn = $p(ifns,",",i) QUIT:ifn=""
		Set v = $p(mts(m,str,"ATT",ifn),"^",5)
		Set ref = pti(v)
		Set lockref = $$strrep(lockref,"{"_ifn_"}",ref,1)
	}
	RETURN lockref
}
#INCLUDE %stringreplace
#INCLUDE %quoter
.
