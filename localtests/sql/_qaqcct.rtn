====
qaqcct
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqcct^MAC^^^0
%qaqcct	// ASL Code Gen for ACTION!!!
	;; COMPONENTS :: SQL/CodeGeneration
	#;
#include %msql
#include %SYS.DBSRV
#INCLUDE %SYS.PTools.Stats
#IF 0   ;-------------------------------------------------------------
	; Description:   asl code generation for action
	; Author:        Aviel Klausner
	; Date Started:  1987
	;
	;  AK850   (11/30/2020) - Implement lateral join
	;  AK1037  (01/28/2021) - Use %SOMEVALUE(field) for 'opg' optimization
	;  MRP1194 (04/29/2020) - UCQ: Maintain compile-time 'SQLStats-flag' value & Collect Initialization 'INFO' at SQL Query runtime
	;  DAP004  (05/15/2020) - Check field '= collation(null) (instead of field '= "") for COUNT aggregates
	;  AK986   (10/03/2018) - Use indirection for hybrid temp-file read
	;  MRP1029 (11/14/2017) - SQL: Fix leaky SQL variable (ptr) for %INTOLIST parsing
	;  MRP1007 (07/10/2017) - Provide method for Setting PTools SQLStats-flag by Namespace: $SYSTEM.SQL.SetSQLStatsFlagByNS()
	;  MRP1000 (07/02/2017) - Use new $ZU() bins created by JO3000 for all SQLStats flags
	;  JSL5121 (06/20/2017) - prune fetch logic when outlier processing being done in stub, since done in RTU
	;  JSL5074 (04/21/2017) - When outliers present in statement, only RTU does fetching, not the RTS which just delegates the fetch
	;  AK690   (02/15/2017) - Extensions for SQL manipulation of bitmaps
	;  MRP902  (09/12/2016) - Start collecting SQLStats for FIRST module directly within code-generated SQL code
	;  MRP879  (06/13/2016) - Allow SQLStats data collection granularity
	;  MRP875  (05/12/2016) - Reengineer & Optimize SQLStats Data Collection
	;  AK936   (07/07/2015) - Use hybrid local->global GROUP+aggs temp-file
	;  AK841   (12/21/2011) - Use extended local arrays for some temp-files
	;  AK875   (02/26/2013) - Record q# in "build" ACTION for TOP
	;  AK849   (01/18/2012) - Parallel processing for UNION
	;  AK833   (10/14/2011) - Use $NAME(temp-file) for TOP optimization
	;  AK827   (08/22/2011) - Use GOTO $CASE() for shared modules
	;  AK811   (05/19/2011) - Use unsubscripted locals as FOR loop variable
	;  BJB428 - Rewrite output calls to Stop and Start to handle UNION queries
	;  AK739   (06/18/2009) - ASL for TOP/ORDER BY in subqueries
	;  AK738   (06/17/2009) - Re-Implement TOP as part of ASL modules
	;  DPV3341 (01/15/2009) - Support TOP clause in INSERT/SELECT, report error if TOP used in subquery
	;  DPV3148 (05/08/2008) - Don't perform locking in query if %USECHECKVARIABLE and %NOLOCK was specified
	;  DPV3131 (03/25/2008) - DD Lookup and Table compiler performance improvements
	;  DPV3090 (01/07/2008) - Correct setting %ROWCOUNT for insert/update into LOCAL TEMPORARY tables
	;  BJB364  (10/01/2007) - Correct <UNDEFINED> caused by missing CursorName for non cursor queries.
	;  DPV2999 (08/17/2007) - PRIVATE TEMP TABLES do not acquire locks for filing or read-committed checks
	;  DPV2974 (08/07/2006) - Some SQL Stats changes
	;  BJB352  (08/02/2007) - Change flags so you can turn on or off stats save while leaving the cod ein the query
	;  DPV2986 (07/30/2007) - Experimental change - Support %NOJOURN and %ILOCK
	;  BJB347  (05/11/2007) - Create SQLStats code generation
	;  AK662   (11/07/2006) - Remove duplicate field data in temp-files
	;  DPV2808 (12/06/2006) - When a RC lock fails, ztrap "LOCK" instead of just quiting
	;                         SQL Fix ProdLog 47358:  query returns 0 rows instead of reporting lock timeout error -114
	;  DPV2793 (11/20/2006) - Fix code generation for unlock call in INSERT/SELECT (DPV2622 fix)
	;                         Fix ProdLog 53410 - set rowcount for insert stored proc gets SQLCODE -1
	;  DPV2771 (10/23/2006) - Improve performance of ROWLIMIT check
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  DPV2677 (06/22/2006) - Support "BROWSE" mode for READ_COMMITTED locking via xODBC
	;  AK614   (09/09/2004) - Index-assisted aggregates optimization
	;  AK644   (04/07/2006) - Set %ROWID for updateable cursor
	;  DPV2622 (04/24/2006) - Add support for %0CacheRowLimit - Used with TSQL SET ROWCOUNT
	;  MAK1719 (03/09/2006) - Encapsulate SQL variable used by new resultset interface inside the resultset object
	;  JLF083  (02/23/2006) - Use collated nulls in SVSO
	;  DPV2593 (02/21/2006) - SQL Enhancement: Use private global for SQL instead of ^mtemp0
	;  AK633   (10/19/2005) - Fix TOP limit calculation with DESC
	;  DPV2538 (10/17/2005) - SQL Fix: Fix Logic for checking ismeth in calcagg^%qaqcct
	;  DPV2503 (08/30/2005) - Fix <UNDEFINED> of cat in GetFieldCategory
	;                         SQL Fix ProdLog 40555:  <UNDEFINED>GetFieldCategory+5^%qaqcct *cat while compiling SQL statement
	;  DPV2445 (06/15/2005) - Calculate $$lockref at SQL binding time instead of each time it is needed by a query
	;  JLF049  (02/25/2005) - Override SQL aggregation function
	;  AK608   (09/09/2004) - SELECT SUM(f) FROM t using bitslice
	;  AK610   (09/27/2004) - Restrict sort-file size when TOP used
	;  AK615   (11/19/2004) - Single temp-file for GROUP BY and aggregates
	;  JLF012  (02/27/2004) - SQL/XML extensions
	;  JLF005  (02/27/2004) - Set-Valued Subquery Optimization
	;  PVA057  (11/07/2003) - Aggregate speed up: avoid data map access for aggregated collated values.
	;  DPV2114 (11/03/2003) - Don't set $ze="" in Generated SQL code
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  DPV1879 (11/12/2002) - Initialize SQLCODE=0 in the beginning of Fetch
	;  DPV1855 (10/22/2002) - Fix reporting of SQLCODE-114 error from SELECT statement
	;  AK536   (09/30/2002) - Set lockref only when needed
	;  BJB215  (03/05/2002) - Fix syntax errors with new locking on maps with no subscripts
	;  AK506   (01/22/2002) - ASL for chunk and bit manipulation
	;  AK488   (09/21/2001) - Remove $ZN from $ZT setting
	;  DPV1575 (08/20/2001) - use $$$LockTimeout
	;  DPV1550 (06/15/2001) - More READ_COMMITTED work, now we support queries with multiple tables
	;  DPV1531 (05/18/2001) - Support READ_COMMITTED Isolation level
	;  AK475   (05/17/2001) - TJdoRJ: Apply collation to MAX/MIN
	;  AK467   (02/27/2001) - Use $BIT for an id list temp-file
	;  DPV1431 (10/24/2000) - Changed all %Date to %Library.Date, %Time[Stamp] to %Library.Time[Stamp], etc
	;  AK446   (05/31/2000) - View stream processing
	;  DPV1357 (08/08/2000) - Support LIST Aggregate function
	;  AK444   (06/08/2000) - Use "]]" instead of ">"
	;  AK436   (04/12/2000) - CCS#146: Use "]]" instead of "]"
	;  AK427   (02/28/2000) - CCS#112: Lock/reread row on UPDATE/DELETE
	;  AK419   (01/04/2000) - Berne: ASL OR constructs
	;  MIT070  (10/25/1999) - RUNTIME compilation mode
	;  AK400   (10/12/1999) - CCS: Remove variable XXXn for nodes
	;  AK394   (09/17/1999) - Generate $SORT* for temp files
	;  AK387   (08/03/1999) - EMIS: TOP, %ROWCOUNT
	;  AK361   (04/29/1999) - ODBC datatype reporting and conversion
	;  DPV1004 (03/16/1999) - Support NUMERIC ODBC Type
	;  DPV929  (12/07/1998) - Use $lg or right side of '=' sign when
	;                         calulating aggregates
	;  DPV870  (09/10/1998) - TIMESTAMP fields use '[' comparison operator
	;  AK329   (09/04/1998) - Named scratch run-time variables
	;  AK327   (07/28/98)   - Replace LOCK +^mtemp with $INCREMENT(^mtemp0)
	;  DPV837  (05/07/98)   - Eliminate need for old datatype
	;  DPV836  (05/04/98)   - Fix multiple occurances of ordertag in 1 rtn
	;  DPV811  (02/03/98)   - Eliminate unused isrowid function
	;  AK304   (01/06/98)   - List-fields in the query processor
	;  DPV786  (10/27/97)   - Support $li structure, no longer use $zlist
	;  MRP700  (07/08/97)   - Optimize Complex OR & IN Conditions
	;  DPV751  (06/23/97)   - new routine derived from %aaact
	;                         Changed all I's to "^", V's to $c(1)
	;  DPV700  (04/07/97)   - Make NULL subscript marker in temp files
	;                         use standard NULL subscript marker.
	;  DPV710  (02/11/97)   - Allow generated line lengths up to 511
	;  MIT061  (01/17/97)   - Remove $P($C(1)) from field node value in QP
	;  DLP005  (01/16/97)   - Support list structured nodes
	;  MRP659  (12/06/96)   - Count all Rows Processed
	;  MRP643  (10/02/96)   - Modularize Embedded SQL Code: 'gvar' to
	;                         '$$$MSQLModuleVariable'
	;  MRP615  (06/03/96)   - Count the number of Rows FETCHed
	;  MRP598  (04/05/96)   - Fix Multiple DISTINCT BYs in SELECT-list
	;  DPV603  (03/06/96)   - Generate smaller/more efficient code
	;  MRP570  (01/29/96)   - Transaction Processing
	;  DPV578  (12/06/95)   - Make NULL Date, Time and Number fields
	;                         collate first when Ordered By.
	;  MRP543  (11/08/95)   - Error Trap for Embedded SQL Modules
	;  DPV486  (06/16/95)   - Remove comment from generated code to decrease
	;                         routine size and increase performance
	;  MRP472  (01/13/95)   - Make WHERE RowID = :p1 OR
	;                         RowID = :p2 ... work
	;                         --- cleaned up: old stuff in zaaact ---
	;  MRP379  (03/04/94)   - Process new prefix extended functions
	;                         (+, -, " ") for index maps
	;                         *** REMOVED: Keep around for info ***
	;  MJF006  (09/29/93)   - Replace irep with %irep
	;  MRP299  (02/22/93)   - Modularize parsing of ^* COSTAR globals
	;
	;  AK014;AK037;AK061;AK080;AK097;AK128;AK129;AK130;AK145;IS102
	;  AK175;AK176;AK188;EYT148;ALL004;RGG460;RGG521;RGG527;RLL055
	;  AK215;MRP263;AK244;AK258
	;
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; Can be Output, Nest, Aggregate, Quit, or Build
	n flag,ntry,stuff
	s ntry=""
actloop	s ntry=$o($$$aslAct(mod,ntry),1,stuff) QUIT:ntry=""
	s flag=$p(stuff,$c(1))	// DPV1531
	d:flag="o" output
	d:flag="n" nest($p(stuff,$c(1),2))
	d:flag="s" share($p(stuff,$c(1),2))  ;  AK419
	d:flag="l" lock  ;  AK427
	d:flag="l2" lock2($p(stuff,$c(1),2),$p(stuff,$c(1),3))  ;  DPV1531;DPV1550
	d:flag="u" unlock  ;  AK427
	d:flag="a" aggate
	d:flag="q" quit
	d:flag="b" build
	d:flag="ipq" ipqsent
	d:flag="WQMsync" WQMsync($p(stuff,$c(1),2))
	g actloop
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
WQMsync(m) [gtag,mt] private {
	if $$$parAggUsesSharedGlobal(m) {
		// Wait until all workers in this group - i.e., parallel aggregation workers - have finished
		$$$liin("try {")
		$$$liin($c(9)_"set "_$$$getVarName("sc")_"="_$$$getVarName("quq"_m)_".Sync()")
		$$$liin($c(9)_"if $$$ISERR("_$$$getVarName("sc")_") { set SQLCODE=-400,%msg=$$GetErrorText^%apiOBJ("_$$$getVarName("sc")_") throw }")
		$$$liin("} catch {")
		$$$liin($c(9)_"if '$isobject($g("_$$$getVarName("quq"_m)_")) { quit }")
		$$$liin($c(9)_"throw")
		$$$liin("}")
	}
}
ipqsent()[stuff,pti,m] private { 
	#; set variables back to parent process using IPQ
	#; variables are specified by p(stuff,$c(1),2) in the format of "varidx1,varidx2,..."
.
  #; create ipq for sendind values
  Set ipqvar = "ipq"_m
.
  #; generate the code "Set ipq.Value=$lb(var1,var2,...)"
  Set line = "Set "_ipqvar_".Value=$lb("
  For i=1:1:$l($p(stuff,$c(1),2), ","){
	  Set:$p($p(stuff,$c(1),2),",",i) line = line_$select(i=1:"", 1:",")_pti($p($p(stuff,$c(1),2),",",i))
  }
  Set line = line_")"
  $$$liin(.line)
  Quit
}
.
output	; This Module Outputs.  That means we're gonna QUIT, and
		#; give an entry point back in.
		#;  perform final copy "SET y=x" for case "SELECT f,f INTO :x,:y"
	new i,jj,main		; BJB428
	if '$g(mt("rtpc","outliersexist")) { // JSL5074
		if $d(mt("into$list")) {
			new ptr
			set line="set "_mt("into$list")_"=$lb("
			set ptr=0
			while $listnext(mt("output"),ptr,val) { set line=line_pti(val)_"," }
			set $e(line,*)=")"
			$$$liin(.line)
		} else {
			for jj=1:2:$ll($g($$$mtEndset)) {
					#; if this is fastSelect, and we are simply setting one of the output variables here (i%%coli), no need to set it... (DPV5091)
				if $g($$$mtFastSelectFlag)=1,$li($$$mtEndset,jj)?1"i%%col"1.N {
					set line="set:'$g(%qQueryFetch) "_$li($$$mtEndset,jj)_"="_$li($$$mtEndset,jj+1) $$$liin(.line)
				}
				else {
					set line="set "_$li($$$mtEndset,jj)_"="_$li($$$mtEndset,jj+1) $$$liin(.line)
				}
			}
		}
	}
.
	#; MRP875
	if $$$SQLStatsFlagON&&(",DEL,UPD,"'[(","_$$$mtStatementType_",")) { // --- Code-Generate the PTools/SQLStats Statistics Collection Code ---
		new modList,modListExt,nMod,pos
		if $$$SQLStatsFlagMAIN { // --- Record the top/outer-most Module (MOD#) value in which PTools/SQLStats statistics were collected: MAIN (0) ---
			set modList=0,modListExt="MAIN"
		}
		else { // --- Record a list of all Module (MOD#) values in which PTools/SQLStats statistics were collected ---
			set modList=mod,modListExt=$$$ModuleNameIntToExt(mod)
			for pos=1:1 { // --- Process All Module (MOD#) values up the tree within the 'asl(nMod)' array ---
				set nMod=$p(modList,",",pos)
				QUIT:'nMod  // No more Module (MOD#) values!
				
				set nMod=$P($g($$$aslMod(nMod)),$c(1),2)
				if nMod,(","_modList_",")'[(","_+nMod_",") { // --- Record All Valid Module (MOD#) values not in 'modList' ---
					set:nMod["," nMod=$e(nMod,1,*-1)
 					CONTINUE:+nMod=1  // SKIP 'FIRST' Module, which is handled in a special way elsewhere (as the entire outermost FETCH module)!
					set modList=modList_","_nMod
					set modListExt=modListExt_","_$$$ModuleNameIntToExt(nMod)
				}
			}
		}
.
	#; MRP879
		// --- PTools/SQLStats: SQL FETCH [MIDDLE of Module] ---
		if $$$SQLStatsFlagALL { $$$liin("do:"_$$$SQLStatsCollectALLValueQ($$$getVarName("action-flag-run"))_" %statsStop("_$$$getVarName("statsJob")_","_$$$getVarName("statsNS")_",$zn,"""_$S($g(mcurs)'="":mcurs,1:callname)_""","""_modList_""","_$$$getVarName("collect-flag-bits")_")  // SQLStats: Stop collecting for module"_$s($l(modListExt,",")>1:"s",1:"")_": "_modListExt) }
	}
	#; MRP875-
		#;  INSERT-SELECT or non-cursor UPDATE/DELETE
		#;  if "querylock", the test for SQLCODE must occur after unlocking
	if mcurs {	// DPV2999
		do action^%qaqcmn
			if mt("maxonerow") {
				#; We can only return one row so just set this directly
				#; UPD & DEL can now use maxonerow too
			if $g(mt("querylock")) {
				if $case($$$mtStatementType,"DEL":1,"UPD":1,:0),$d(mt("var","lockstat")) {
					set line="if "_$$$getVarName("lockstat")_"=1 { do ##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLReleaseLock("_mtc(mcurs,"rid")_$s($$$mtStatementType="UPD"&&($$$mtKILockFlag($g($$$mtK))=1):",,1",1:"")_") set "_$$$getVarName("lockstat")_"=0 }"
					$$$liin(.line)
				}
			}
			set line="goto:SQLCODE<0 "_$p($p(call,$c(1),3),"^")_" set "_$$$VarName("rowcnt")_"=1"
			$$$liin(.line)
		} elseif $$$smdTempTableType(1,$p(mtc(mcurs,"f"),",",2))'="LOCAL TEMPORARY" {
				#;    If $$$mtStatementType="UPD",$$$mtKILockFlag($g($$$mtK))=1 { // UPDATE %ILOCK, release lock immediately
			if $g(mt("querylock")) {
				if $$$mtStatementType="DEL" {
					$$$liin("if 'SQLCODE {")
					set line=$c(9)_"if $i("_$$$VarName("rowcnt")_")'<"_$$$getVarName("rowlimit")_" { "_$s($d(mt("var","lockstat")):"do:"_$$$getVarName("lockstat")_"=1 ##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLReleaseLock("_mtc(mcurs,"rid")_$s($$$mtStatementType="UPD"&&($$$mtKILockFlag($g($$$mtK))=1):",,1",1:"")_") ",1:"")_"g "_$p($p(call,$c(1),3),"^")_" }"
					$$$liin(.line)
					if $d(mt("columnarBufferedFiling")) {
						set line=$c(9)_"elseif $d("_$$$getVarName("bufferedColumns")_"),'("_$$$VarName("rowcnt")_"#256000) { set "_$$$getVarName("sc")_"=##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLDeleteBufferedColumns(."_$$$getVarName("bufferedColumns")_") if '"_$$$getVarName("sc")_" { set SQLCODE=-400,%msg=$$GetErrorText^%apiOBJ("_$$$getVarName("sc")_") goto "_gtag_"err }}"
						$$$liin(.line)
					}
					$$$liin("}")
				} elseif $$$mtStatementType="UPD" {
					$$$liin("if 'SQLCODE {")
					set line=$c(9)_"if $i("_$$$VarName("rowcnt")_")'<"_$$$getVarName("rowlimit")_" { "_$s($d(mt("var","lockstat")):"do:"_$$$getVarName("lockstat")_"=1 ##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLReleaseLock("_mtc(mcurs,"rid")_$s($$$mtStatementType="UPD"&&($$$mtKILockFlag($g($$$mtK))=1):",,1",1:"")_") ",1:"")_"g "_$p($p(call,$c(1),3),"^")_" }"
					$$$liin(.line)
					if $d(mt("columnarBufferedFiling")) {
						$$$liin($c(9)_"elseif '("_$$$VarName("rowcnt")_"#256000) {")
						$$$liin($c(9,9)_"if $d("_$$$getVarName("bufferedColumns")_") { set "_$$$getVarName("sc")_"=##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLInsertBufferedColumns(."_$$$getVarName("bufferedColumns")_") if '"_$$$getVarName("sc")_" { set SQLCODE=-400,%msg=$$GetErrorText^%apiOBJ("_$$$getVarName("sc")_") goto "_gtag_"err }}")
						$$$liin($c(9,9)_"if $d("_$$$getVarName("bufferedColumnsDel")_") { set "_$$$getVarName("sc")_"=##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLDeleteBufferedColumns(."_$$$getVarName("bufferedColumnsDel")_") if '"_$$$getVarName("sc")_" { set SQLCODE=-400,%msg=$$GetErrorText^%apiOBJ("_$$$getVarName("sc")_") goto "_gtag_"err }}")
						$$$liin($c(9)_"}")
					}
					$$$liin("}")
				} else {
					set line="if 'SQLCODE { if $i("_$$$VarName("rowcnt")_")'<"_$$$getVarName("rowlimit")_" { "_$s($d(mt("var","lockstat")):"do:"_$$$getVarName("lockstat")_"=1 ##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLReleaseLock("_mtc(mcurs,"rid")_$s($$$mtStatementType="UPD"&&($$$mtKILockFlag($g($$$mtK))=1):",,1",1:"")_") ",1:"")_"g "_$p($p(call,$c(1),3),"^")_" }}"
				}
			} else {
				if $$$mtStatementType="INS" {
					set line="goto:SQLCODE<0 "_$p($p(call,$c(1),3),"^") $$$liin(.line)
					set line="if $i("_$$$VarName("rowcnt")_")'<"_$$$getVarName("rowlimit")_" { "_$s($d(mt("var","lockstat")):"do:"_$$$getVarName("lockstat")_"=1 ##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLReleaseLock("_mtc(mcurs,"rid")_",,1) ",1:"")_"goto "_$p($p(call,$c(1),3),"^")_" }" $$$liin(.line)
					if $d(mt("columnarBufferedFiling")) {
						set line="if $d("_$$$getVarName("bufferedColumns")_"),'("_$$$VarName("rowcnt")_"#256000) { set "_$$$getVarName("sc")_"=##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLInsertBufferedColumns(."_$$$getVarName("bufferedColumns")_") if '"_$$$getVarName("sc")_" { set SQLCODE=-400,%msg=$$GetErrorText^%apiOBJ("_$$$getVarName("sc")_") goto "_gtag_"err }} "
						$$$liin(.line)
					}
				} else {
					$$$liin("goto:SQLCODE<0 "_$p($p(call,$c(1),3),"^"))
					$$$liin("if $i("_$$$VarName("rowcnt")_")'<"_$$$getVarName("rowlimit")_" { "_$s($d(mt("var","lockstat")):"do:"_$$$getVarName("lockstat")_"=1 ##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLReleaseLock("_mtc(mcurs,"rid")_",,1) ",1:"")_"goto "_$p($p(call,$c(1),3),"^")_" }")
					if $$$mtStatementType="DEL",$d(mt("columnarBufferedFiling")) {
						set line="if $d("_$$$getVarName("bufferedColumns")_"),'("_$$$VarName("rowcnt")_"#256000) { set "_$$$getVarName("sc")_"=##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLDeleteBufferedColumns(."_$$$getVarName("bufferedColumns")_") if '"_$$$getVarName("sc")_" { set SQLCODE=-400,%msg=$$GetErrorText^%apiOBJ("_$$$getVarName("sc")_") goto "_gtag_"err }}"
						$$$liin(.line)
					}
					if $$$mtStatementType="UPD",$d(mt("columnarBufferedFiling")) {
						$$$liin($c(9)_"elseif '("_$$$VarName("rowcnt")_"#256000) {")
						$$$liin($c(9,9)_"if $d("_$$$getVarName("bufferedColumns")_") { set "_$$$getVarName("sc")_"=##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLInsertBufferedColumns(."_$$$getVarName("bufferedColumns")_") if '"_$$$getVarName("sc")_" { set SQLCODE=-400,%msg=$$GetErrorText^%apiOBJ("_$$$getVarName("sc")_") goto "_gtag_"err }}")
