====
apiISQL3
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%apiISQL3^MAC^^^0
%apiISQL3
#include %occInclude
	Quit
	
POC	Do TestCompileBatchFile("i:\poc.sql","i:\poc.sql.log")
	Quit
		
POC1	Do TestCompileBatchFile("i:\poc1.sql","i:\poc1.sql.log")
	Quit
		
	// test-compile all the .sql files in the given directory, logging to the given file
TestCompileDirectory(inputdir,loggingfile) PUBLIC {
			
	Write "Writing log to ",loggingfile,!
	Set logging=##class(%File).%New(loggingfile)
	Do logging.Open("NWS")
 
	Write "Scanning ",inputdir," .. "
	Set dlm=$Select(inputdir["\":"\",1:"/")
 	If $Extract(inputdir,*)'=dlm {Set inputdir=inputdir_dlm}
 
 	If ##class(%File).DirectoryExists(inputdir)=0 {
		Write "Directory ",inputdir," not found",!
		Quit
 	}
 
 	Set rs=##class(%ResultSet).%New("%File:FileSet")
 	Set sc=rs.Execute(inputdir,"*.sql","")
 	If $$$ISERR(sc) {
	 	Do ReportError^%apiISQL2(sc,"Error scanning directory: "_dir,.outcome)
	 	Quit
	 }
 	If 'rs.Next() {
		Write "No .sql files in directory ",dir,!
		Quit
 	}
 
	Do {
		If rs.GetData(2)'="F" Quit
		Set inputfile=rs.GetData(1)
 
		Write "Loading input from ",inputfile," .. "
		Set input=##class(%FileCharacterStream).%New()
		Do input.LinkToFile(inputfile)
		Set input.LineTerminator=$Char(13,10)
		Do TestCompileBatch(input,logging)
		Write "done",!
		
	} While rs.Next()
 
	Do rs.Close()
}
 
	
	// test-compile the given file, logging to the given file ("*" => inputfile.log)
TestCompileBatchFile(inputfile,loggingfile) PUBLIC {
	
	If '##class(%File).Exists(inputfile) {
		Write "File ",inputfile," not found",!		
	}
	Else {
		Write "Loading input from ",inputfile," .. "
		Set input=##class(%FileCharacterStream).%New()
		Do input.LinkToFile(inputfile)
		Set input.LineTerminator=$Char(13,10)
		Write "done",!
		
		If loggingfile="*" {Set loggingfile=inputfile_".log"}
		
		// set up logging
		New %xsqllogging
		Do ##class(%XSQL.Reporting).InitLog(loggingfile)
 
		Do TestCompileBatch(input,logging)
	}
}
	
	// given SQL batches in the input stream, try compiling
	// every procedure definition body in it and write the
	// results to the logging stream
TestCompileBatch(input,logging) PUBLIC {
	
	// set up logging
	New %xsqllogging
	Do ##class(%XSQL.Reporting).InitLogFromStream(logging)
 
	Kill %xsqlstats
	
	Set transformer=##class(%ISQL.Transformer).%New()
	Set settings=$Get(^%ISQL("SETTINGS"))
	
	Kill sarr
	Do ##class(%XSQL.Settings).LoadSettings(settings,.sarr)
	If $Data(sarr("UL")) {Set underline=sarr("UL")}
	ElseIf $Data(sarr("UNDERLINE")) {Set underline=sarr("UNDERLINE")}
	Else {Set underline=""}	
 
	Kill requiredclasses
 
	Set cp="CREATE PROCEDURE",lcp=$Length(cp)
	Set ep="END PROCEDURE",lep=$Length(ep)
	Kill primaryclasses
	While 'input.AtEnd {
		
		Set line=input.ReadLine()
		If line'?." " {
			
			If $ZCVT($Extract(line,1,lcp),"U")=cp {
	
				Set procname=$$ProcNameFrom($Extract(line,lcp+1,*))
				
				If procname="" {
					Do Log^%apiISQL("Couldn't get procedure name after CREATE PROCEDURE")
					Quit
				}
				
				Do Log^%apiISQL("")
				Do Log^%apiISQL("")
				Do Log^%apiISQL("-------------------------------")
				Do Log^%apiISQL("CREATE PROCEDURE "_procname)
				Do Log^%apiISQL("")
 
				Kill lines Set lines=0
				Set lines($I(lines))=line
				
				While 'input.AtEnd {
					Set line=input.ReadLine()
					Set lines($I(lines))=line
					If $ZCVT($Extract(line,1,lep),"U")=ep {Quit}
				}
				If line="" {
					Do Log^%apiISQL("Missing END PROCEDURE")
					Quit
				}
				Write procname," .. "
				For i=1:1:lines {Do Log^%apiISQL(lines(i))}
				Do Log^%apiISQL("")
				
				// parse into class and method names
				If procname["." {		
					Set classname=$Piece(procname,".",1,$Length(procname,".")-1),methodname=$Piece(procname,".",$Length(procname,"."))
				}
				Else {
					Set classname="ISQL.StoredProcedures",methodname=procname
				}
	
				Kill outcome
				Set sc=$$Dispatch(transformer,$ListBuild(classname,methodname),.lines,settings,underline,.procs,.primaryclassname,.outcome)
				If $$$ISERR(sc) {Do ReportError^%apiISQL2(sc,"Error in DoTransform",.outcome)}
 
				Do CreateProcs^%apiISQL5(primaryclassname,procs,underline,.requiredclasses)
				Set primaryclasses(primaryclassname)=""
 
				Write "done",!
			}
			
			Else {
				Do Log^%apiISQL("Ignored: "_line)
			}
		}
	}
	
	Kill outcome		
	Set sc=##class(%XSQL.Compile).CompileClasses(.primaryclasses,.requiredclasses,.outcome)
	If $$$ISERR(sc) {Do ReportError^%apiISQL2(sc,"Error in DoTransform",.outcome)}
	
	Do ##class(%XSQL.Reporting).LogStats()
}
 
 
ProcNameFrom(rest) PRIVATE {
	Quit $ZStrip($Piece($ZStrip(rest,"<W"),"("),">W")
}
 
 
 // returns status and outcome
Dispatch(transformer,SPInfo,lines,settings,underline,procs,classname,outcome) PRIVATE {
	
	Set input=##class(%Library.GlobalCharacterStream).%New()
	Set input.LineTerminator=$Char(10)
	For i=1:1:lines {Do input.WriteLine(lines(i))}
	Set sc=$$GenerateCode^%apiISQL5(transformer, input, settings, SPInfo, .gencode, .procs, .outcome)
	If $$$ISERR(sc) {Quit sc}
 
	Do gencode.Rewind()
	Set anygencode='gencode.AtEnd
 
	// if there is generated code ..
	If anygencode {
		
		Set sc=$$WriteSPMethod^%apiISQL5("ISQL",underline,SPInfo,gencode,.classname,settings,0,.macrtname,.intrtname,.outcome)
		If $$$ISERR(sc) {Quit sc}
	}
	
	Quit $$$OK
}
---
