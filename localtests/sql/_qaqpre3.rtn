====
qaqpre3
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpre3^MAC^^^0
%qaqpre3	// preoptimizer analysis overflow, called from %qaqpnl
	;; COMPONENTS :: SQL/PreOptimizer
	#;
#INCLUDE %msql
#IF 0   ;-------------------------------------------------------------
	;
	; Description:   Pre-Optimizer Analysis
	; Author:        Jim Finnerty
	; Date Started:  12/01/2006
	;
	;  AK1021  (08/05/2020) - Compute streamless expressions on the master
	;  AK953   (05/20/2016) - Fix "shtop" cloning for subquery
	;  PVA354  (03/25/2016) - Fix: : <UNDEFINED>ptvsel+1^%qaqomul for unusual ORDER BY queries 
	;  PVA348  (03/01/2016) - PVA348 - Support Lateral references in JSON_TABLE through optimizer 
	;  PVA342  (12/15/2015) - Generate ojfilters for sharding only when really needed, and fix interaction between aggregates and outer joins (for sharding) 
	;  PVA316  (02/04/2015) - Make cost based decision for or->union optimization for multi-table OR condition case 
	;  PVA315  (01/14/2015) - Fix <UNDEFINED>ptvsel+1^%qaqomul *ptv("6") for occasional queries with range and equijoin on the same field
	;  AK920   (11/03/2014) - DO a called module only once, if possible
	;  PVA279  (02/12/2014) - Enhance ptres handling for longstanding defects 
	;  PVA291  (09/30/2013) - Fix some (rare) wrong answers introduced by PVA289
	;  PVA270  (12/18/2012)  - incorrect query return for SELECT ... INTO local array
	;  PVA260  (06/07/2012) - Remove special case optimization for idkey joins that is superseded by PVA258, and also improve edge case
	;  PVA252  (02/24/2012) - Fix error (<UNDEFINED>indexed2+1^%qaqpre3) for certain rare queries with OR to UNION optimizaiton
	;  PVA251  (01/10/2012) - Fix: Subquery cloning fails to copy "onerow" flag
	;  AK831   (10/04/2011) - Correct more NOT EXISTS SVSO logic
	;  PVA242  (07/28/2011) - Support a hint (%noindex) to not use indexes to satisfy the indicated condition
	;  PVA238  (03/29/2011) - Fix: <UNDEFINED>badvidref+12^%qaqpre3 introduced by PVA237
	;  PVA237  (03/10/2010) - Prevent performance regression in FULL OUTER JOIN
	;  PVA232  (12/03/2010) - Support optional second argument of %inlist() to provide a selectivity hint
	;  PVA231  (11/30/2010) - Implement view.%id feature
	;  PVA225  (05/19/2020) - Fix a new <UNDEFINED>aptv^%qaqpnl *ptv("nn") error
	;  AK768   (04/08/2010) - Fix JSV exclusion to skip obsolete subqueries
	;  JLF341  (01/27/2010) - Fix copyqb so that collection fields are copied correctly
	;  AK757   (11/01/2009) - GWQ: Prevent TOP optimization
	;  PVA207  (11/10/2009) - Avoid JSV optimization when likely to make query worse
	;  PVA203  (10/23/2009) - Fix view output optimization for case of a DISTINCT query against a remote source
	;  PVA198  (09/04/2009) - Extend AK743 to cover remaining opportunities for view output optimization
	;  JLF266  (08/18/2009) - Perform join analysis in DISTINCT optimization
	;  PVA184  (06/14/2009) - Optimizer support for TOP... ORDER BY in subqueries
	;  PVA183  (05/26/2009) - Pre-optimizer support for TOP...ORDER BY in subqueries
	;  AK694   (02/15/2008) - JSV fixes - OUTER JOIN into UNION, "empty"
	;  PVA179  (05/18/2009) - Fix execution time <undefined> for a query with multiple opportunities for OR to UNION optimization
	;  PVA175  (03/20/2009) - Fix: A query with a complex OR condition involving a unary function, that also refers to the same unary function elsewhere, may fail
	;  PVA169  (03/03/2009) - Fix: FULL OUTER JOIN gives <UNDEFINED>corr+2^%qaqpnl
	;  AK723   (02/13/2009) - Skip more optimizations for linked queries
	;  PVA166  (02/03/2009) - Fix another or/union case of: <UNDEFINED>corr+2^%qaqpnl *$$$mtP(0)
	;  JLF235  (01/07/2009) - Implemented system-level %NOUNIONOROPT optimizer hint
	;  DPV3258 (12/10/2008) - Avoid <SUBSCRIPT> error if $p(v,"^",2,3) is long because of -> joins
	;  DPV3231 (08/05/2008) - Use process private global for ptln, ptrel
	;  JLF224  (08/04/2008) - Improved efficiency of transformExists loop
	;  JLF222  (07/23/2008) - UNION/OR optimization
	;  JLF020  (06/25/2008) - Improve error handling of FOR SOME %ELEMENT
	;  JLF216  (04/09/2008) - General code cleanup of ptv structure
	;  JLF201  (01/30/2008) - Reinitialized uniqueBody, etc., before transformExists
	;  JLF198  (01/07/2008) - Move ANYOFAND factor-AND transform into setAnyof
	;  JLF193  (12/11/2007) - Text search in streams without long strings
	;  JLF192  (12/07/2007) - Semantic analysis of FOR SOME %ELEMENT argument
	;  PVA159  (07/29/2008) - Clean up orphaned subqueries
	;  PVA158  (07/20/2008) - Utility for OR to UNION transformation
	;  PVA157  (05/01/2008) - Support faster DISTINCT while preserving case (i.e. with FASTDISTINCT OFF )
	;  PVA155  (01/10/2008) - Fix: Simple text predicates not using index efficiently on 2009.1
	;  JLF214  (04/08/2008) - Support text operators on streamed views
	;  DPV3131 (03/25/2008) - New obTuple
	;  AK689   (01/24/2008) - Improve TOP optimization with DISTINCT
	;  AK683   (08/01/2007) - Use index for outer join into a view
	;  PVA140  (06/13/2007) - Improve JLF167 to do one type of factoring earlier (as originally done)
	;  PVA132  (03/18/2007) - %inlist doesn't work for a collated column; also row level security not working
	;  JLF153  (03/02/2007) - Restored SVSO optimizations that were disabled by PVA099, added analyzeSubqueries
	;  PVA124  (01/04/2006) - Implement facility to undo side effects of conds/outer/class in propagatePreds^%qaqpnl
	;  JLF136  (12/14/2006) - First production version completed
	;  PVA115  (12/12/2006) - Assorted outer join fixes
	;  JLF136  (12/10/2006) - Create copyqb utility (prototype)
	;
#ENDIF
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- 
error(e) GOTO ^%qaqperr
validateCollectionRefs()
	n val,v,m,logs,lgi,log,f
	f m=1:1:$$$mtPNumQbs { i $$$mtPQbIsActive(m) {s logs=$g($$$mtWhere(m)) f lgi=$l(logs,"^")-1:-1:1 s log=$p(logs,"^",lgi) f j=2:1:$l($$$mtLColVals($$$mtL(log)),",")-1 { d validateCollectionField($p($$$mtLColVals($$$mtL(log)),",",j))}}}
	QUIT
validateCollectionField(fval)
	i $$$mtV(fval)["_%ANYOF",$$collectionType(fval)="" d error(472)
    QUIT
collectionType(fval)
	n str,ifn,irn,qno,ttype,fnodedeep,fnode,collType s fnode = $$$mtV(fval)
	#; If this is a view output, look through the view to the mt("o",*) node that defines the view output
 	n fvalDeep,fnodeDeep s fvalDeep=fval,fnodeDeep=fnode
	while ($e(fnodeDeep)="f" && $d($$$mtRVirtual($p(fnodeDeep,"^",2))))
	{	s fvalDeep=$lg($$$mtVirf(+$p(fnodeDeep,"^",3)),2)
		s fvalDeep=$$thruRMLSP^%qaqpqo1(fvalDeep)
		s fnodeDeep=$$$mtV(fvalDeep)
		if fnodeDeep["_" s fnodeDeep="" quit	// Disallow deep references through a collation function (or any expression)
	}
	QUIT:$e(fnodeDeep)'="f" ""
	
	s fval = fvalDeep, fnode = fnodeDeep
	s str = $p(fnode,"^",2)
	s ifn = $p(fnode,"^",3)
	s irn = $$$smdGetIrnFromIfn(+ifn)
	s qno = $$$mtRQb($$$mtR(str))	
	s ttype = $$$smdTType(irn)
	
	#; Check if this property is projected as a list collection or array collection
	#;
	QUIT:",Y,1,"[$$$smdColListCollection(ttype,irn,+ifn) "list"
	QUIT:",Y,1,"[$$$smdColArrayCollection(ttype,irn,+ifn) "array"
	
	#; If the projection of the column is not list or array, but the class defines the property
	#; as a list or array, then we're looking at the property inside the child table.  $$ismeth
	#; would claim that there is a runnable BuildValueArray method in this case, but this is not
	#; the case we're interested in here.
	#;
	s collType = $$$smdColCollectionType(1,irn,+ifn)	// DPV3350
	QUIT:",list,array,"[(","_collType_",") ""
	
	#; Otherwise, if there is a runnable BuildValueArray method, then return "bva"
	#;
	QUIT:$$ismeth^%qadadt($$$smdClassname(ttype,irn),$$$smdColPropertyName(1,irn,+ifn)_"BuildValueArray")=1 "bva"
	QUIT ""
copyqb(oldQb,newPqb)
	#; Makes a copy of a query block, and everything it contains, and returns
	#; the query block number of the new query block.  newQb=0 is not supported.
	#;
	#; NOTE:  It is the caller's responsibility to ensure that mt("dups",) is
	#;		  set correctly.  Currently distinctOpt sets mt("dups",).
	#; NOTE:  copyqb may be called on a query block hierarchy that contains
	#;		  anyof IFNs, but it will not maintain the information created
	#;		  by setAnyof.  (Calling setAnyof after calling copyqb is ok).
	#;
	RETURN:newPqb=0 0							; not callable on a/the top-level query block
	new aoifn,args,baseFld,collBaseVal,dupsv,fval,i,j,joinSet,log,logs,m,newQb,newStr,oldViewStr,oldVqb,olist,onc,onode,qsu,shtop,strInOldQb,strName,ud,v,val,vqb,x
	set joinSet=1
.
	#; Create new query block for view oldQb, along with a new stream, unless the
	#; caller has already set it up.
	#;
	set (m,newQb)=$i(maxm)				; create a new qb unless it was created by caller
	set $$$mtP(newQb)=newPqb				; set temporarily here to be able to call calcQBOrder inside nested call
	set xlate("qb",oldQb)=newQb			; repoint refs from old m to new m
	set $$$mtCorrParentQb(newQb)=$$$xlateQb($$$mtCorrParentQb(oldQb))
	set:$d(mt("dups",oldQb)) mt("dups",newQb)=mt("dups",oldQb)
	set dupsv=0
	set:$d($$$mtDupsv(oldQb)) $$$mtDupsv(newQb)=$$$xlateQb($$$mtDupsv(oldQb)),dupsv=1
	set:$d($$$mtQbHasForSomeElement(oldQb)) $$$mtQbHasForSomeElement(newQb)=$$$mtQbHasForSomeElement(oldQb)
	#; AK757
	#; If moved into a partitioned subquery (parallel, sharded), add to the partitioning.
	#; AK953
	#;  a query block shtop could differ from its parent's  AK1021
	set shtop=$g(mt("shtop",oldQb))
	set:shtop mt("shtop",newQb)=$s(shtop=oldQb:newQb,1:mt("shtop",newPqb))
	set $$$mtDSNLinkedTable(newQb)=$g($$$mtDSNLinkedTable(oldQb))  ;  copy connection information
	if $d($$$mtUnionTopDSN(oldQb),$$$mtUnionTopDSN(newQb)) { }
	#; AK757-
	#; Copy all the streams inside oldQb, and their fields
	#; r,f,ptrel,ptj
	#;
	set strInOldQb="",oldViewStr=""
	set ptj(newQb,joinSet)=",^,"
	set oldViewStr=$s($$$mtPViewIDVal($$$mtP(oldQb))="":"",1:$p($$$mtV($$$mtPViewIDVal($$$mtP(oldQb))),"^",2))
	
	#; Loop over ptj to create a copy of each stream in oldQb
	#;
	for i=2:1
	{
		QUIT:dupsv
		s strInOldQb=$p($p(ptj(oldQb,1),"^",2),",",i) q:strInOldQb=""
		s strName=$$strtoname^%qaqpre2(strInOldQb)
		if '$d($$$mtRVirtual(strInOldQb))
		{	s str=0,vqb="",oldVqb="" d putstr^%qaqpqo(newQb_"^"_strName,+$$$mtR(strInOldQb)) // putstr leaves new stream in str
			s:strName'["->"&&($d($$$mtFromTableName(oldQb_"^"_strName))) $$$mtFromTableName(newQb_"^"_strName)=$$$mtFromTableName(oldQb_"^"_strName)	// DPV3258 (strName'["->")
			#; Copy all the fields in strInOldQb
			s ifn="" 
			for 
			{	s ifn=$o(mts(oldQb,strInOldQb,"ATT",ifn)) q:ifn="" 
				s fval=$p(mts(oldQb,strInOldQb,"ATT",ifn),"^",5)
				if ifn["_%ANYOF"
				{	s aoifn=$e(ifn,1,$find(ifn,$s(ifn["%ANYOFKEY":"%ANYOFKEY",1:"%ANYOF"))-1),baseFld=$e(ifn,$l(aoifn)+1,*)
					s:$g(xlate("bf",baseFld))="" xlate("bf",baseFld) = $i($$$mtNumAnyOf)
					s collBaseVal = $p(mts(oldQb,strInOldQb,"ATT",+ifn),"^",5)
					s:'$d(viewFvals(collBaseVal,newQb)) viewFvals(collBaseVal,newQb)=$$nufld^%qaqpqo(str,$p($$$mtV(collBaseVal),"^",3))
					s viewFvals(fval,newQb)=$$nufld^%qaqpqo(str,aoifn_xlate("bf",baseFld))
				}
				else
				{	s:'$d(viewFvals(fval,newQb)) viewFvals(fval,newQb)=$$nufld^%qaqpqo(str,ifn)			// create fval and record in viewFvals for translation
				}
			}
			if $d($$$mtTvfParams(strInOldQb)) // PVA350: clone tvf strucures 
	        {  s args=$$$mtTvfParams(strInOldQb) 
	           if args'=$c(0) {for j=1:1:$ll(args) {s val=$lg(args,j) s:val]"" $li(args,j)=$$clone^%qaqpnl("v",val)}}
	           s $$$mtTvfParams(str)=args
	           s $$$mtTvfFuncLabel(str)=$$$mtTvfFuncLabel(strInOldQb)
	        }
			// copy foreign table structures
			if $$$IsFTStream(strInOldQb) {
				do copyFTInformation^%qaqpftpd(strInOldQb, str, oldQb_"^"_strName, newQb_"^"_strName)
			}
	        #; PVA342: Clone row leve security (RLS) node (only might exist for base table streams)
			if $d(mt("RLS",strInOldQb))
			{  s mt("RLS",str)=$$clone^%qaqpnl("l",mt("RLS",strInOldQb))
			   #; do NOT set complexlog - that will be done by placeRLSPred if we actually use this condition
			}
		} 
		else	
		{	s oldVqb=$$$mtRVirtual(strInOldQb)
			s vqb=$$copyqb(oldVqb,newQb)
			s mlabel=newQb_"^"_strName,($$$mtFromTableName(mlabel),tname)="%%Q"_vqb		; tname passed to nuvstr
			s (fval,$$$mtPViewIDVal($$$mtP(vqb)))=$$$newval("junk",1)		; real content to be filled in by vstrf
			s viewFvals($$$mtPViewIDVal($$$mtP(oldVqb)),newQb)=fval
			s m=newQb d vstrf^%qaqpqo,createval^%qaqpdt(fval)
			s olist=$$$mtOutputVals($$$mtOutput(vqb))
			for j=1:1:$l(olist,",")-1
			{	s fval=$$$newval("junk",1)			; create the fval as known outside of vqb (modified by virf)
				d vstrf^%qaqpqo,createval^%qaqpdt(fval)
				s viewFvals($$$mtPViewIDVal($$$mtP(oldVqb))+j,newQb)=fval
			}
			#; Must set up translations for any collated virtual fields
			s ifn="" 
			for 
			{	s ifn=$o(mts(oldQb,strInOldQb,"ATT",ifn)) q:ifn="" 
				s fval=$p(mts(oldQb,strInOldQb,"ATT",ifn),"^",5)
				s:'$d(viewFvals(fval,newQb)) viewFvals(fval,newQb)="" //special clone convention
			}
 			#; copy any union attached to this view	
 			do copyunion(oldVqb, vqb, newQb)
		}
	}
	#; Clone mt("g"). This must be done first, as aggregates often specify
	#; same val as mt("g") in their %foreach spec, and this is important 
	#; to preserve (for performance)
	n gcols
	if $d($$$mtGroupDistinctList(oldQb),gcols)
	{	s m=newQb
		for i=1:1:$l(gcols,",")-1 s ($p(gcols,",",i),xlate("v",$p($$$mtGroupDistinctList(oldQb),",",i)))=$$clone^%qaqpnl("v",$p(gcols,",",i))
		s $$$mtGroupDistinctList(newQb)=gcols
	}
	if $d(mt("gsynth",oldQb)) s mt("gsynth",newQb) = mt("gsynth",oldQb)
 
	#; For mt("o",) look for overlap with mt("g") and preserve
	n ogcols,ocols,x
	if $d($$$mtOutput(oldQb)) 
	{	s $$$mtOutput(newQb)=$$$mtOutput(oldQb)
		s ocols=$$$mtOutputVals($$$mtOutput(oldQb))
		s ogcols=$listfromstring($g($$$mtGroupDistinctList(oldQb)))
		for i=1:1:$l(ocols,",")-1 
		{	s val=$p(ocols,",",i)
			s x=$lf(ogcols,val)
			s m=newQb,(xlate("v",val),$p(ocols,",",i))=$s(x:$p(gcols,",",x),1:$$clone^%qaqpnl("v",val))
		}
		s $$$mtOutputVals($$$mtOutput(newQb))=ocols
	}
 
	#; p - pieces 3 and 4 filled in by clone
	s $$$mtPQbIsActive(newQb)="1"					; if oldQb is disabled, then newQb will be, too
	s $$$mtPQbParent($$$mtP(newQb))=newPqb		; parent query block, or 0 if none	
 
	#; c
	#;
	#; Note: the current processing order guarantees that mt("c",oldQb) will always be empty
	#; because undeSideEffects moves mt("c") conditions to mt("w",) and then kills mt("c")
	#;
	if $d($$$mtStreamlessConds(oldQb))
	{	for i=1:1:$l($$$mtStreamlessConds(oldQb),",")-1
		{	s m=newQb,$p($$$mtStreamlessConds(newQb),",",i)=$$clone^%qaqpnl("v",$p($$$mtStreamlessConds(oldQb),",",i))
			s xlate("v",$p($$$mtStreamlessConds(oldQb),",",i))=$p($$$mtStreamlessConds(newQb),",",i)
		}
	}
 
	#; w
	if $d($$$mtWhere(oldQb))
	{	s v=$$$mtWhere(oldQb)
		for i=1:1:$l(v,"^")-1 
		{	s m=newQb
			n oldLog s oldLog = $p(v,"^",i)
			s $p(v,"^",i)=$$clone^%qaqpnl("l",oldLog) // PVA252 - don't put "l" nodes in xlate
			do propagateComplexLog^%qaqpnl(oldLog, $p(v,"^",i), oldQb, newQb)
		}
		s $$$mtWhere(newQb)=v
	}
	
	#; j - not expecting to see $$$mtLeftOuterJoins() in current usage, so no need to test this for now
	#; h
	if $d($$$mtHaving(oldQb))
	{	s m=newQb,$$$mtHaving(newQb)=$$clone^%qaqpnl("l",$$$mtHaving(oldQb))
		do propagateComplexLog^%qaqpnl($$$mtHaving(oldQb), $$$mtHaving(newQb), oldQb, newQb)
	}
 
	#; empty
	s:$d($$$mtEmpty(oldQb)) $$$mtEmpty(newQb)=$$$mtEmpty(oldQb)
	
	#; onerow
	s:$d($$$mtOneRow(oldQb)) $$$mtOneRow(newQb)=$$$mtOneRow(oldQb) // PVA251
	
	#; linx
	i $d(linx) 
	{	s m=newQb
		for i=1:1:$l(linx,"^")-1 
		{	s val=$$$mtLOperand2($$$mtL($p(linx,"^",i)))
			s:(oldQb=$$$mtRQb($$$mtR($p($$$mtV(val),"^",2)))) linx=linx_$$clone^%qaqpnl("l",$p(linx,"^",i))_"^"
		}
	}
 
	#; At this point we have created all the new logs, vals, ms, and strs
	#; that can be referenced from within this query block.  Now we can update 
	#; all the structures that reference those objects.
	#;
 
	#; ON
	s j="" 
	for 
	{	s j=$o($$$mtOn(oldQb, j),1,onode) q:j=""
		s logs=$li(onode,$$$SQLONPREDICATE)
		#; PVA252 - don't put "l" nodes in xlate
		for i=1:1 s log=$p(logs,"^",i) q:'log  s $p(logs,"^",i)=$$clone^%qaqpnl("l",log)
		s $li(onode,$$$SQLONPREDICATE)=logs
		s $$$mtOn(newQb, j)=onode
	}
	
 	#; PVA183: Subquery ORDER BY; still assume not used to copy top qb. Thus $$$mtSequencers, mt("uns") 
 	#;   still not relevant. Only $$$mtSequencersQb(qb) a concern.
 	#;   Must use xlate("v",) for real: if TOP operators, their operand vals are 
 	#;   intended to match OBY expressions, and the %LIMIT val is also shared . 
 	#;   This is now all handled in clone: it will enter these values in xlate, and
 	#;   discover them there, simplifying code using clone.
 	if $d($$$mtSequencersQb(oldQb))
 	{  s ocols=$$$mtSequencersQb(oldQb),m=newQb
 	   for j=1:1:$l(ocols,",")-1 { s $p(ocols,",",j)=$$clone^%qaqpnl("v",+$p(ocols,",",j))_$s($p(ocols,",",j)["d":"d",1:"") } 
 	   s $$$mtSequencersQb(newQb)=ocols
 	}
 
	#; AS,as
	s:$d($$$mtAlphaUpAliases(oldQb)) $$$mtAlphaUpAliases(newQb)=$$$mtAlphaUpAliases(oldQb)
	s:$d($$$mtAliases(oldQb)) $$$mtAliases(newQb)=$$$mtAliases(oldQb)
 
	#; distinct
	#; mt("distinct") should be handled better, but currently not really used, and current
	#;   convention for setting in parser is a little tricky. Fix up when really needed.
	#;   Currently, flds^%qaqpnl ignores it. But a couple places test its definition,
	#;   so copy it. The following will have meaningless vals sometimes.
	s:$d($$$mtDistinct(oldQb)) $$$mtDistinct(newQb)=$$$mtDistinct(oldQb)
	#; svso
	#; The structure of mt("svso",oldQb) is $lb(agg,operators,pqbExpr,oldQbExpr), where pqbExpr is an "^"-follows 
	#; list of pqb expression vals and oldQbExpr is a $list of oldQb expression vals.  Thus for oldQb to be copied
	#; it is required that every pqb referenced in pqbExpr be either newPqb or an ancestor of newQb.  Note that this
	#; is called from a recursive context, so some of the ancestors may be included in an open copyqb operation.
	#; If an ancestor val is referenced that is part of an open copyqb operation, then it must already have been
	#; translated to xlate("v",val); thus if a correlated reference is reached it must already be translated.  In
	#; general this cannot be guaranteed unless the correlated references are either fvals or from some mt("o",);
	#; consequently a fixup pass will be needed by the top-level caller if copyqb is called on a query block that
	#; could transitively contain an mt("svso",*).
	i $d(mt("svso",oldQb)) {  ;  AK1079
		s mt("svso",newQb)=mt("svso",oldQb),args=$li(mt("svso",newQb),3),v=$li(mt("svso",newQb),4)
		f j=1:1:$ll(v) s $p(args,"^",j)=$$$xlateVal($p(args,"^",j),newPqb),$li(v,j)=$$$xlateVal($li(v,j),newQb)
		s $li(mt("svso",newQb),3)=args,$li(mt("svso",newQb),4)=v
	}
	#; PVA183: toplimit,top
	#;    Current planning for future TOP pushdown combined with current TOP in subquery
	#;    is based on the idea of exactly one TOP limiting operation being active in 
	#;    query block. It is either the one associate with TOP for that query, OR pushed down
	#;    limit referring to another query. The toplimit information should already be present
	#;    in xlate by this time, from cloning of the TOP: conditions. We ASSUME that in cloning
	#;    toplimit. Note, the second piece of toplimit is a query number. For now it is the 
	#;    same as the subscript for toplimit. However, for a future pushed down toplimit we 
	#;    might have, e.g. mt("toplimit",5)="37^2" where the limit val and limit sort file
	#;    are related to query 2. 
	s:$d($$$mtTopLimit(oldQb)) $$$mtTopLimit(newQb)=xlate("v",$$$mtTopOptOrTfCard($$$mtTopLimit(oldQb)))_"^"_$$$xlateQb($$$mtTopLimitQb($$$mtTopLimit(oldQb)))
	// rely on constant/parameter restriction for TOP
	merge:$d($$$mtTopArg(oldQb)) $$$mtTopArg(newQb)=$$$mtTopArg(oldQb)
	set:$d($$$mtTopStyle(oldQb)) $$$mtTopStyle(newQb)=$$$mtTopStyle(oldQb)
	// offset
	merge:$d($$$mtOffset(oldQb)) $$$mtOffset(newQb)=$$$mtOffset(oldQb)
.
	#; hint/hintsave
	m:$d(mt("hint",oldQb)) mt("hint",newQb)=mt("hint",oldQb)
	m:$d(mt("hintsave",oldQb)) mt("hintsave",newQb)=mt("hintsave",oldQb)
	
	#; intersect/except
 	m:$d($$$mtIntersectExceptOnQb(oldQb)) $$$mtIntersectExceptOnQb(newQb)=$$$mtIntersectExceptOnQb(oldQb)
 	s:$d($$$mtIntersectExceptDist(oldQb)) $$$mtIntersectExceptDist(newQb)=$$$mtIntersectExceptDist(oldQb)
 	
	#; If there are any correlated references to expressions in query block oldQb that are neither
	#; simple fields nor in $$$mtOutput(oldQb), then the correlation references in the copied query
	#; blocks inside newQb may still point to the wrong place.  Find and fix up all "n" nodes
	#; that reference a val that needs to be translated.
	#;
 
	#; qbo - Note: caller needs to update the query block order 
	Set val=$$$newval("q^"_newQb,1)
	s $$$mtPQbVal($$$mtP(newQb))=val			; create new val for this query
	s xlate("v",$$$mtPQbVal($$$mtP(oldQb)))=val // PVA252 record this to avoid excess copying
	s viewFvals($$$mtPQbVal($$$mtP(oldQb)),newQb)=$$$mtPQbVal($$$mtP(newQb))
	
	d setnulstr^%qaqpnl(newQb)
	s m=newQb d flds^%qaqpnl
 	if $g(killsource) s $$$mtPQbIsActive(oldQb)=0 k $$$mtWhere(oldQb) // DEBUG - for testing with viewtest
	QUIT newQb
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;
	#; Like copyqb, copies the oldQb query block into a new query block child of newPqb.
	#; Additionally, if oldQb is part of a union, copies the rest of the union into newPqb
	#; as well.
copysubq(oldQb, newPqb) [ mt ] PUBLIC {
	//First, copy the query block.
	Set newQb = $$copyqb(oldQb, newPqb)
	//Then, copy any union
	Do copyunion(oldQb, newQb, newPqb)
	QUIT newQb
}
	#; Translate mt("untop")/mt("union") for a qb and recursively copy
	#; qb's found in $$$mtUnion( qb).
copyunion(oldQb, newQb, newPqb) [ mt, xlate ] PUBLIC {
	//Translate "untop" for this qb, if any.
	If $d($$$mtUnionTopQb(oldQb)) {
		Set $$$mtUnionTopQb(newQb)=xlate("qb",$$$mtUnionTopQb(oldQb))
	}
	//Translate "union" for this qb, including copying
	//leg qbs.
	For i=1:1:$ll($g($$$mtUnion(oldQb))) {
		Set ud=$li($$$mtUnion(oldQb),i)
		//All qb's in a union have the same parent
		Set uqb = $$copysubq(+ud,newPqb)
		Set $$$mtUnion(newQb)=$g($$$mtUnion(newQb))_$lb(uqb_$e(ud,*))
	}
}
migrateIJ(m)
	#; JLF131 - New procedure migrateIJ
	#;
	#; Merge inner joins that are not on the null padded side of a join
	#; join into the WHERE clause.
	#;
	new cur,oi,iNode,stk,top
	s oi="",top=0
	for
	{	s oi=$o($$$mtOn(m, oi),1,iNode) q:oi=""
		continue:$li(iNode,$$$SQLONOPERATOR)'=$$$SQLONINNERJOIN||$$inNullPaddedSubtree^%qaqpre2(m,iNode)
		s stk($i(top))=oi
	}
	s cur=0
	while ($i(cur) <= top)
	{	s $$$mtWhere(m) = $g($$$mtWhere(m))_$li(mt("ON",m,stk(cur)),$$$SQLONPREDICATE)
		k mt("ON",m,stk(cur))
	}
	if top>0 d pointifyON^%qaqpre2(m)
	QUIT top  // PVA140 add function return
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
		#; PVA087: New routine 'good' - is a condition compatible with our =* support?
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
good(log,rstr,fcols,ccols,lf) //fcols, ccols and lf should be passed by reference, init to "", "", and 0
                       // respectively
	n l,r,ptlg,j
	s ptlg=$$$mtL(log)			  
	if $e(ptlg,1,4)'="v^=^"||($p(ptlg,"^",3)=",") QUIT 0
	s l=$p(ptlg,"^",4),r=$p(ptlg,"^",5)
	if $p($$$mtV(l),"^",1,2)=("f^"_rstr) {s j=l,l=r,r=j}
	else {if $p($$$mtV(r),"^",1,2)'=("f^"_rstr) QUIT 0 }
	if "xtf"'[$$$mtVType($$$mtV(l)),$p($$$mtV(l),"^",3)'="," QUIT 0
	if $p($$$mtV(l),"^",1,2)=("f^"_rstr) QUIT 0
	#; Remove following check when Aviel supports multiple =* refs to 
	#; same target column (both ccols and fcols no longer needed)
	if $$$mtVType($$$mtV(l))="f" { if $bit(fcols,r)=1 { QUIT 0 } else { s $bit(fcols,r)=1,lf=1 }}
	else { if $bit(ccols,r)=1 {QUIT 0} else {s $bit(ccols,r)=1}}
	s $p(ptlg,"^",4,5)=l_"^"_r,$$$mtL(log)=ptlg
	QUIT 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA124: create
undoSideEffects  // Reverse side effects of conds/outer/class in qaqpnl
	n val,str,log,ptln,logs,i,m,lgi
	#; Restore most mt("c") conditions back to mt("w"). Can't tell which are really
	#;   essential. Hope that removeredundant works well. 
	#;   SKIP if log already in mt("w")
	s m="" for  
	{ s m=$o($$$mtStreamlessConds(m),1,logs) q:m=""  continue:'$$$mtPQbIsActive(m)
	   for i=1:1 
	   { s log=$p(logs,",",i) q:'log
	      s ptln=$$$mtL(log)
	      continue:$p(ptln,"^",2)["EMPTY" // these we know are inessential
	      continue:"^"_$g($$$mtWhere(m))[("^"_log_"^") // many times streamless condition was left in mt("w")
	      if $p(ptln,"^",2)="ONEOF" s $$$mtWhere(m)=$g($$$mtWhere(m))_$$undoONEOF(log,$p($p(ptv($p(ptln,"^",5)),"^",$$$PTVRANGEINFO),",",2))_"^"
		  else  s $$$mtWhere(m)=$g($$$mtWhere(m))_log_"^"
	   }
	}
	#; Reverse ONEOF back to IN, INSET, =, and other operators. 
	s m="" for  
	{ s m=$o($$$mtWhere(m),1,logs) q:m=""  continue:'$$$mtPQbIsActive(m)
	   for i=1:1 
	   { s log=$p(logs,"^",i) q:'log
	      s ptln=$$$mtL(log)
	      if $p(ptln,"^",2)="ONEOF" s $p(logs,"^",i)=$$undoONEOF(log,$p($p(ptv($p(ptln,"^",4)),"^",$$$PTVRANGEINFO),",",2))
	   }
	   s $$$mtWhere(m)=logs
	}
	#; In case top level set op was INTX, converted to &, must do:
	f m=1:1:$$$mtPNumQbs { s logs=$g($$$mtWhere(m)) f lgi=1:1 { s log=$p(logs,"^",lgi) q:log=""  d where^%qaqpqo(.logs,log,.lgi) } s:$d($$$mtWhere(m)) $$$mtWhere(m)=logs }
	#; Reset ptv to state after nuatt^%qaqpqo+flds^%qaqpnl
	s val="" for  
	{ s val=$o(ptv(val)) q:val=""
	   if $p(ptv(val),"^",$$$PTVVALTYPE)'="f" { k ptv(val) }  // introduced by outer^%qaqpnl; must be reversed
	                                              // Also introduced for ci case in conds to allow
	                                              // proper undoing mt("c") ONEOF test
	   else 
	   {  s ($p(ptv(val),"^",$$$PTVEQUIVCLASS),$p(ptv(val),"^",$$$PTVVALSINCLASS))=val_","
	      s ($p(ptv(val),"^",$$$PTVLOGREFS),$p(ptv(val),"^",$$$PTVCONTYPE),$p(ptv(val),"^",$$$PTVRANGEINFO),$p(ptv(val),"^",$$$PTVOJSTR),$p(ptv(val),"^",$$$PTVTOPINFO))=""
	   }
	}
	#; note: linx doesn't need to be restored because it is never killed by outer^%qaqpnl
	s str="" for  
	{ s str=$o($$$mtR(str)) q:str=""
	   k:$d($$$mtROuterJoins(str)) $$$mtROuterJoins(str)
	}
	k ptl,$$$mtStreamlessCondsRoot,ptres,seladj,range // PVA279: seladj, PVA315: range
	f m=1:1:$$$mtPNumQbs KILL $$$mtLeftOuterJoins(m)
	Do undoCondsPtv(.ptv)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; conds^%qapnl sets ptv entries with two subscripts:
	#;    s (ptv(val,con),ptv(con,val))=log  ;indicates `val=con' exists
	#; This function removes (undoes) these entries.
undoCondsPtv(ptv) PUBLIC {
	Set a = ""
	For {
		Set a = $O(ptv(a))
		Quit:a=""
		Set b = ""
		For {
			Set b = $O(ptv(a,b))
			Quit:b=""
			Kill ptv(a,b)
		}
	}
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA124: create
undoONEOF(log,nullinset) [mt,pti,val] PUBLIC {
	set tlog = log
	s ptln=$$$mtL(log),ptset=$$$mtV($p(ptln,"^",5)),setop=$p(ptset,"^",2),fld=$p(ptln,"^",4)
	if setop="SET:SETOF" 
	{  s pti($p(ptln,"^",5))="<obsolete>"  ; Set this to obsolete as variable is not used to avoid creating a variable for this in phase #7 %qaqcasl
	   s $p(ptln,"^",2)="IN"
	   s $p(ptln,"^",5,6)=$p(ptset,"^",4,*)
	   s $$$mtL(log)=ptln
	}
	elseif setop="SET:LIST"||($$$SQLCOLLATIONS[$p($p(setop,":",2),"("))||($$$ISENCODEDCOLLATE($p($p(setop,":",2),"("))) // PVA132
	#; PVA232: set up list size argument (always, no harm).
	{  s $p(ptln,"^",2)="INSET",$p(ptln,"^",6)=mt("listsize",$p(ptln,"^",5)),$p(ptln,"^",7)=""
	   s $$$mtL(log)=ptln
	}
	else { s log=$$undoSETop(fld,$p(ptln,"^",5))}
	if nullinset 
	{  Set val=$$$newlog("v^NULL^,"_$s($$$mtVType($$$mtV(fld))="f":fld_",",1:"")_"^"_fld_"^")
	   Set val=$$$newlog("l^!^,"_$s($$$mtVType($$$mtV(fld))="f":fld_",",1:"")_"^"_log_"^"_val_"^")   
	   s log=val
	}
	if $D(mt("nRTP","SelInfo",tlog)){
			set mt("nRTP","SelInfo",log) = mt("nRTP","SelInfo",tlog)	
	}
    QUIT log
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA124: create
undoSETop(fld,oprnd)
    n val,ptset,setop
    s ptset=$$$mtV(oprnd),setop=$p(ptset,"^",2)
	if setop="SET:SETOF" 
	{  Set val=$$$newlog("v^IN^,"_$s($$$mtVType($$$mtV(fld))="f":fld_",",1:"")_"^"_fld_"^"_$p(ptset,"^",4,*))
	}    
	elseif setop="SET:LIST"||($$$SQLCOLLATIONS[$p($p(setop,":",2),"("))||($$$ISENCODEDCOLLATE($p($p(setop,":",2),"("))) // PVA132
	#; PVA232: set up listsize argument
	{  Set val=$$$newlog("v^INSET^,"_$s($$$mtVType($$$mtV(fld))="f":fld_",",1:"")_"^"_fld_"^"_oprnd_"^"_mt("listsize",oprnd)_"^")
	}
	elseif setop="SET:UNION" || (setop="SET:INTX") 
	{  Set val=$$$newlog("l^"_$s(setop="SET:INTX":"&",1:"!")_"^,"_$s($$$mtVType($$$mtV(fld))="f":fld_",",1:"")_"^"_$$undoSETop(fld,$p(ptset,"^",4))_"^"_$$undoSETop(fld,$p(ptset,"^",5))_"^")
	}
	else  // SET filter : convert to field comparison + AND
	{  Set val=$$$newlog("v^"_$p(setop,":",2,*)_"^,"_$s($$$mtVType($$$mtV(fld))="f":fld_",",1:"")_"^"_fld_"^"_$s($p(ptset,"^",5)]"":$p(ptset,"^",5)_"^",1:""))
	   Set val=$$$newlog("l^&^,"_$s($$$mtVType($$$mtV(fld))="f":fld_",",1:"")_"^"_val_"^"_$$undoSETop(fld,$p(ptset,"^",4))_"^")
	} 
	QUIT val
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; If a condition has been fully pushed down into subqueries, we can
	#; no longer use its derived dependencies on other conditions.
	#; This function removes such dependencies and associated selectivity
	#; adjustments from ptres or seladj, which have the same structure,
	#; except for seladj's value, which must be in the list subscript anyway.
removePushedLogDependencies(deps) PUBLIC	{
	Set log = ""
	//ptres
	For {
		Set log = $O(deps(log))
		Quit:log=""
		If $$isPushedLog(log) Kill deps(log) Continue
		Set loglist = ""
		For {
			Set loglist = $O(deps(log,loglist))
			Quit:loglist=""
			If $$hasPushedLog(loglist) Kill deps(log,loglist) Continue
		}
	}
}
isPushedLog(l) [ mt ] PUBLIC {
	QUIT $e($$$mtL(l),1,6) = "i^push"  // PVA354: other types of push as well
}
#; log lists look like ",5,6,"
hasPushedLog(list) PUBLIC {
	For i=2:1:$L(list,",")-1 {
		If $$isPushedLog($P(list,",",i)) RETURN 1
	}
	QUIT 0
}
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
vidrefs(sqb) // PVA231: remove first argument
	#; Check whether virtual id of stream str (corresponding to query sqb) is referenced from outside sqb.
	#;   This is for the purposes of validity of merging. Since a duplicated view can't be 
	#;   merged anyway, we don't need to worry about references to duplicated view.
	#;
	#; PVA231: rewrite to use ptv reference tracking; now completely general
	n vidval
	s vidval=$$$mtPViewIDVal($$$mtP(sqb))
	if +$p(ptv(vidval),"^",$$$PTVREFERENCED)=0 { QUIT 0} else { QUIT 1}
	#; PVA087: New routine 'fixsubq' 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
badvidref(qb) [mt] PUBLIC // PVA231 create
	#; Check whether there is a reference to the viewid of qb that is sensitive value of
	#;    the viewid. While any reference to viewid must prevent merging of the view, only
	#;    such sensitive references need disable optimizations that would change row numbering
	#;    (e.g. pushlog and distinctOpt). 
	#; Because checking requires a complete walk of mt("l"), we cache the answer for 
	#;    for each query, assuming this character will never change. 
	#; 1 means there are bad viewid references, else 0
	{
    QUIT:$$$mtPViewIDVal($$$mtP(qb))="" 0
	if $d(mt("badvidrefs",qb)) QUIT mt("badvidrefs",qb)   
	s vid=$$$mtPViewIDVal($$$mtP(qb))
	s log="",found=0 for 
	  {  s log=$o($$$mtL(log)) q:log=""
	     s lv=$$$mtL(log)
	     continue:($e(lv)'="v" || ($p(lv,"^",2)["NULL") || ($p(lv,"^",3)'[(","_vid_",")))
	     s found=1 q
	  }
	#; Also check for mt("o") references - PVA237
	if 'found
	{  s svals=$$$mtOutputVals($g($$$mtOutput(+$$$mtP(qb)))) //PVA238: allow fro missing mt("o") with FOR SOME construct
	   for i=1:1
	   {  s val=$p(svals,",",i) q:val=""
	      if val=vid { s found=1 q } // direct reference
	      s lv=$$$mtV(val) continue:"ftxn"[$e(lv)
	      if ($p(lv,"^",3)[(","_vid_",")) { s found=1 q }
	   }
	}
	s mt("badvidrefs",qb)=found
	QUIT found
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fixsubq(m, doHaving=0) // Fix $$$mtP() for all subqueries directly contained in m to point to m.
           // Fix $$$mtCorrParentQb() for all such subqueries to point to m or $$$mtCorrParentQb(m) 
           //   as appropriate. It is only query streams that should point to $$$mtCorrParentQb(m). 
           // This is intended to fix up after a new query is assembled from pieces that
           // came from other queries. 
    n logs,log,i,j
    s call="fixpcorr",logs=$g($$$mtWhere(m))
    for i=1:1 { s log=$p(logs,"^",i) q:'log  d lvtree^%qaqpnl("l",log) }
	if doHaving {
		set logs=$g($$$mtHaving(m))
		for i=1:1 { s log=$p(logs,"^",i) q:'log  d lvtree^%qaqpnl("l",log) }
	}
	#; PVA108: fix up ON clauses as well
    s j="" for 
    {  s j=$o($$$mtOn(m, j),1,logs) q:j=""
       s logs=$li(logs,2)
       for i=1:1 { s log=$p(logs,"^",i) q:'log  d lvtree^%qaqpnl("l",log) }
    }
  	QUIT	
	#; PVA087: New routine 'nullreject' 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nullreject(log,refstr,rjstr) // maintain streams that a log references and also the streams
							 // for which it rejects null padded rows. refstr and rjstr 
							 // should be passed by reference, initialized to "". They are
							 // bit strings. Intially, this returns 1 if a streamed view
							 // is referenced. (Must be on left of loj, because right is
							 // constrained to base table during parsing).
	n flds,val,call,svnopad,str,bad,i
	s bad=0
	s flds=$$$mtLColVals($$$mtL(log)) for i=2:1
	{  s val=$p(flds,",",i) q:val=""
	   s str=$p(ptv(val),"^",$$$PTVSTR)
	#; JLF125
	   s $bit(refstr,str)=1
	}
	if bad QUIT 1
	s call="nopad",svnopad=nopad,nopad=""
	d lvtree^%qaqpnl("l",log)
	for str=1:1:$l(nopad,",") { continue:'$p(nopad,",",str)  s $bit(rjstr,str)=1 }
	s nopad=svnopad
	QUIT 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF153
analyzeSubqueries()
	n log,m,mTopo,ptlg,ndxConEql
 
 	d marksqs(1) // clean orphan subqueries left from outer join transforms // PVA159
 	
 	#; Re-do the distinct optimization in order to recalculate the
 	#; temporary arrays such as uniqueBody and singletonSelect.  These
 	#; structures are not maintained by the OJ code, and for new query
 	#; blocks will not be initialized.
 	#;
	#; JLF266: Merge views if any DISTINCT was removed, now that ON clause processing is complete
	if $$distinctOpt^%qaqpre()
	{	f mTopo=maxm:-1:1 s m=mt("qbo",mTopo) continue:$$isLinked^%qaqpnl(m)  d:$$$mtPQbIsActive(m) mergeviews^%qaqpre2(m,0) //PVA291: donull arg for mergeviews
	#; AK831
		d non2n^%qaqpqo  ;  in case mergeviews() caused n-to-n nodes
	}
.
	#; Convert OR to UNION ALL, and EXISTS of UNION ALL to OR of EXISTS
	#;
	d:'$$hint^%qaqpre("%NOUNIONOROPT") unionOrOpt^%qaqpre() // PVA270: hint on query 1 erroneously applying full depth
.
	#; Convert (a %MATCHES ?) to UNION ALL
	#;
	n v,val,xformed,everxformed
	s everxformed = 0
	for
	{   s xformed=0
		for mTopo=maxm:-1:1 
		{	s m=mt("qbo",mTopo) 				; In bottom-up topological order
			continue:$$willRegenerate^%qaqpnl(m)
			if $$hint^%qaqpre("%PATTERNEXPAND",m)
			{	continue:'$$$mtPQbIsActive(m)
				continue:((m=1)&&(",SEL,DEC,INS,"'[$g($$$mtStatementType)))		
				if $$MatchesToUnion(m) 
				{	s (xformed,everxformed) = 1
					d calcQBOrder^%qaqpnl(m) 
					quit 
				}
			}
		}
		quit:'xformed
	}
	if everxformed s val="" f  s val=$o($$$mtL(val),1,v) q:val=""  s:$e(v,1,12)="v^%MATCHES2^" $$$mtLOperator($$$mtL(val)) = "%MATCHES"
	
	d marksqs(1) // clean orphan subqueries left from unionOrOpt // PVA159
.
 	#; Some of the transformations that follow need to know whether an index exists that is
 	#; likely to be used by the optimizer.  Set ndxConEql(m)=1 if there is an indexed constant= 
 	#; predicate in query block m.
 	#; 
 	d createMtsMaps^%qaqpre()
 	    
	#; Transform EXISTS: flatten, convert to a view, or use the set-valued subquery optimization (SVSO)
	#; Note that with SVSO, transformExists also transforms NOT EXISTS (anti-join) in certain cases.
	#;
	n pqbdone s pqbdone(0)=1 f mTopo=maxm:-1:1  s m=mt("qbo",mTopo) continue:$d(pqbdone(+$$$mtP(m)))||$$isLinked^%qaqpnl(m)  d transformExists^%qaqpre(+$$$mtP(m)) s pqbdone(+$$$mtP(m))=1
	
	#; Clean up the temporary map structures
	#; 
	d dropMtsMaps^%qaqpre()
	quit
	#; JLF153-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK683
jsv	;  see if we can make streamed view m "joined"
	#; AK694
	QUIT:$g($$$mtUnionTopQb(m))  ;  UNION *** in future, verify $$modag()+$$indexed() for each leg!
	n vid,str,pm,logs,fvals,log,fval,lgi,v,fv,cq
	s vid=$$$mtPViewIDVal($$$mtP(m))  ;  streamed view rowid
	QUIT:'vid  ;  not a streamed view
	QUIT:$$hasPagination^%qaqpsq(m) // PVA231, YWH094 
	QUIT:$$isSharded^%qaqpnl(m) // Let shard server do it; can' regenerate this.
	QUIT:$$badvidref(m) // PVA231, PVA237
	s str=$p($g($$$mtV(vid)),"^",2)
	QUIT:'$lf(nulstr,str)  ;  not OJ target
	QUIT:$g($$$mtEmpty(m))  ;  Can't do better than that
	;  *** switch to:  QUIT:$lf($g(mt("dupsv")),m)
	f pm=1:1:$$$mtPNumQbs GOTO quit:$g($$$mtDupsv(pm))=m  ;  not a "dupsv" source
	s pm=$$$mtRQb($$$mtR(str))  ;  containing query
	#; AK694
	QUIT:$g($$$mtEmpty(pm))
	#; PVA207
	#;  check for streamed views in the target that are not themselves OJ targets
	#;  If any found, jsv optimization is likely to make the query worse
	#; AK768
	f cq=1:1:$$$mtPNumQbs GOTO quit:($$$mtPQbIsActive(cq) && (+$$$mtP(cq)=m) && '$g($$$mtEmpty(cq)) && $$$mtPViewIDVal($$$mtP(cq)) && '$lf(nulstr,$p($$$mtV($$$mtPViewIDVal($$$mtP(cq))),"^",2)))
	#; PVA207-
	s logs="",fvals=""  ;  list OJ logs, target fields
	#;  find OJ's into this stream, make sure it is into an actual field
	#;  within m (the target virtual fields may need to be collated)
	f lgi=1:1 {
		s log=$p($$$mtLeftOuterJoins(pm),",",lgi)
		QUIT:log=""  ;  all conditions were good
		s v=$$$mtV($$$mtLOperand2($$$mtL(log)))
		i $p(v,"^",1,2)=("f^"_str) {  ;  from this stream
			#;  find corresponding SELECT-item
			s fval=$p($$$mtOutputVals($$$mtOutput(m)),",",$p(mts(pm,str,"ATT",+$p(v,"^",3)),"^",5)-vid),fv=$$$mtV(fval)
			QUIT:$e(fv)'="f"  ;  join not to a field
			QUIT:(v["_")&&(fv["_")  ;  Coll(Coll(f)) - too wierd
			QUIT:$d($$$mtRVirtual($p(fv,"^",2)))  ;  from a virtual stream
			QUIT:$d($$$mtTvfParams($p(fv,"^",2))) // PVA348: can't randomly access a TVF
			QUIT:$$$IsFTStream($p(fv,"^",2))		// and can't randomly access foreign table maps
			#;  if need to be collated and a collated entry not
			#;  found, then don't generate it yet - might not
			#;  need it, use instead special notation fval_%COLL!
			i v["_" s fval=$p($g(mts(m,$p(fv,"^",2),"ATT",$p(fv,"^",3)_"_"_$p(v,"_",2)),"^^^^"_fval_"_"_$p(v,"_",2)),"^",5)
			s logs=logs_log_",",fvals=fvals_fval_","
		}
	}
	QUIT:log  ;  a condition failed one of the tests
	QUIT:$$modag(m,fvals)  ;  no aggregates, except those grouped by fvals
	QUIT:'$$indexed(m,fvals)  ;  check that they're indexed
	s $$$mtQbIsJsv(m)=1  ;  JSV! - add conds to m
	#;  d trace("jsv,m,"_m_",str,"_str)
	f lgi=1:1:$l(logs,",")-1 {
		s log=$p(logs,",",lgi),fval=$p(fvals,",",lgi)
		#;  get collated entry for the fval/ifn mismatch case above
		s:fval["_" fval=$$coll^%qaqpqo(+fval,$p(fval,"_",2))
		s fv=$$$mtLOperand1($$$mtL(log))
		d adwlog(m,$$$newlog("v^=^,"_fval_",^"_fval_"^"_$s($$$mtVType($$$mtV(fv))'="f":fv,1:$$$newval("x^"_fv,1))_"^"))
		d complexlog^%qaqpnl(m,log)
		s $bit($$$mtJsvCorrVal,fval) = 1 //field values that are eqv to the jsv correlated value
	}
quit	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
modag(m,fvals)  ;  $$: 1 if m has any aggregates that might be modified by
	#;  restrictions on fvals, i.e. not including aggregates grouped by
	#;  fvals or a superset of fvals (or anything that implies fvals)
	n ags,agi,agg s ags=$$$mtPAggList($$$mtP(m))  ;  list of aggregates
	f agi=1:1 s agg=$p(ags,",",agi) QUIT:agg=""  QUIT:'$$fd($p($$$mtV(agg),"^",6),fvals)
	QUIT agg
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
indexed(m,fvals)  ;  $$: 1 if each of fvals=LIST(fval[_%COLL],) is a
	#;      leading subscript in some index, or possibly following
	#;      some fields considered "given", such as other fvals
	#;      fields, or mt("w",m) "CON" condition fields
	#;  Also OK if the rowid or the whole IDKEY for the stream is "given"
	#;  Also allowed is index on Coll(fval), but an fvals entry already
	#;      specified with a collation MUST be found with that collation!
	#;  The unusual "fval_%COLL" notation is used only when fval is a
	#;      pure ifn, and there isn't yet an mt("v") entry for coll(fval)
	#;  *** For now, fvals do not have to be all found in the SAME index!
	n given,strs,jj,fval,str s given=fvals_$$fcon(m),strs=""
	#;  *** maybe need to run $$redist()???
	f jj=1:1 s fval=$p(fvals,",",jj) q:fval=""  s str=$p($$$mtV(+fval),"^",2),$p(strs,"^",str)=str_",",fvals(str)=$g(fvals(str))_fval_","
	s strs=$tr(strs,"^")  ;  list of streams
	f jj=1:1 s str=$p(strs,",",jj) q:str=""  q:'$$indexed2()
	QUIT 'str  ;  whether bad stream was found
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
indexed2()  ;  [public: m,str,fvals,given]  $$: 1 if str fval entries are ok
	n irn,ifns,jj,imp,lead,ifn,fval s irn=+$$$mtR(str),ifns=$p(mts(m,str),"^",5,6),imp="",lead=""
	d ddmsubs(str)
	#;  check if rowid, or the whole IDKEY, of the stream is "given"
	QUIT:$$removel($$ifnval(m,str,+ifns)_",",given)="" 1
	i ifns["," s ifns=$p(ifns,+ifns_"^,",2) f jj=1:1:$l(ifns,",")-1 { s $p(ifns,",",jj)=$$ifnval(m,str,$p(ifns,",",jj)) } QUIT:$$removel(ifns,given)="" 1
	#;  go thru map subscripts, collect in lead=LIST(fval[_%COLL],) all
	#;      leading "given", stop if not
	#;  if subscript is uncollated ifn - if it's in given, add it to lead
	#;  if subscript is Coll(ifn), and if ifn or Coll(ifn) or
	#;      fval_Coll found in given, then add both uncollated and
	#;      collated (possibly fval_coll) to lead
	f  s imp=$o(mt("irn",irn,"map",imp),1,ifns) q:imp=""  f jj=1:1:$l(ifns,",")-1 s ifn=$p(ifns,",",jj),fval=$$ifnval(m,str,ifn)_"," i ifn["_" { s fval=fval_$$ifnval(m,str,+ifn)_"," s:'fval $e(fval)=$p(fval,",",2)_"_"_$p(ifn,"_",2) } q:$$removel(fval,given)=fval  s lead=lead_fval
	QUIT $$removel(fvals(str),lead)=""  ;  all of fvals(str) found in lead
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fcon(m)  ;  $$: LIST(fval,) of all fields with an mt("w",m) "CON" condition
	n fcon,lgi,ptlg,fval s fcon=""
	f lgi=1:1:$l($g($$$mtWhere(m)),"^")-1 s ptlg=$$$mtL($p($$$mtWhere(m),"^",lgi)),fval=$p(ptlg,",",2) s:(("v^NULL^,"_fval_",^"_fval_"^")=ptlg)||("v^=^,"_fval_","=$p(ptlg,"^",1,3)&&(((fval=$p(ptlg,"^",4))&&$$const($p(ptlg,"^",5)))||((fval=$p(ptlg,"^",5))&&$$const($p(ptlg,"^",4))))) fcon=fcon_fval_","
	QUIT fcon
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
const(val)  ;  $$: 1 if $$$mtV(val) is streamless
	s val=$$$mtV(val)
	QUIT ("xt"[$e(val))||($p(val,"^",3)=",")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddmsubs(str)  ;  populate mt("irn",irn,"map",imp)=LIST(ifn[_%COLL],) of
	#;  leading field subscripts, skip constants, and stop at expressions
	#;  (*** maybe allow single field expressions?)
	#;  also list rowid/IDKEY under imp=0/-1
	n sti,irn,mname,imp,ilev,ifn,fx s sti=$$$mtR(str),irn=+sti,sti=$p(mts($p(sti,"^",2),str),"^",5,6),mname=""
	QUIT:$d(mt("irn",irn))
	s mt("irn",irn,"map",0)=+sti_","
	s:sti["," mt("irn",irn,"map",-1)=$p(sti,+sti_"^,",2)
	f  {
		s mname=$o($$$smd(1,irn,"map",mname))
		QUIT:mname=""
		s imp=$o($$$smd(1,irn,"map",mname,""))
		CONTINUE:"N"'[$$$smdMapConditional(imp)  ;  conditional map
		CONTINUE:$$$smdMapIndexType(imp)="S"  ;  bitslice
		s ilev=0
		f  {
			s ilev=$o($$$smd(12,imp,6,ilev))
			#;  append rowid subscript for bitmap index
			i 'ilev s:$e($$$smdMapIndexType(imp))="B" mt("irn",irn,"map",imp)=$g(mt("irn",irn,"map",imp))_+sti_"," QUIT
			CONTINUE:$$$smdMSConstant(imp,ilev)'=""  ;  constant
			CONTINUE:$$$smdMSExpression(imp,ilev)'?.e1"{".n1"}".e  ;  constant expression
			s ifn=$$$smdMSFieldIfn(imp,ilev)
			QUIT:'ifn  ;  stop at expressions *** not handling %Name, single field expressions
			s fx=$$$smdMSFunction(imp,ilev)
			s:fx'="" ifn=ifn_"_%"_fx
			s:ilev=$$$smdMapParIDStartLev(imp) ifn=$$$smd(1,irn,"col",0),ilev=$$$smdMapParIDLastLev(imp)  ;  ParentRef on >=1 subscripts
			s mt("irn",irn,"map",imp)=$g(mt("irn",irn,"map",imp))_ifn_","
		}
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fd(l1,l2)  ;  $$: 1 if all l2=LIST(val,) entries are proven to be
	#;  functionally dependent on l1=LIST(val,);  could use
	#;  rules including the following:
	#;  * l2 is a subset of l1
	#;  * l1 contains keys to all tables of l2 - $$redist()
	#;  * l1 implies a key to the table of l2, e.g. thru a foreign key
	#;  * l2=Coll(l1)
	#;  * l2 is an expression of fields in l1
	#;  * l2 is a computed field based on l1
	#;  * l2 is streamless
	QUIT:l2="" 1
	;QUIT:l1="" 0 	; MAK4781 removed in case $$redist returns ""
	QUIT:$$removel(l2,l1)="" 1
	QUIT:$$redist^%qaqpqo(l1)=$$redist^%qaqpqo(l1_l2) 1
	#;  ***
	QUIT 0  ;  could not prove
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ifnval(m,str,ifn) QUIT +$p($g(mts(m,str,"ATT",ifn)),"^",5)  ;  $$: corresponding val, or 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  $$: l1=LIST(log#,) sans conditions in l2 (same as $$remove^ag() )
removel(l1,l2) [] PUBLIC { s l2=","_l2_"," f li=1:1 { s log=$p(l1,",",li) q:log=""  i l2[(","_log_",") s $p(l1,",",li,*)=$p(l1,",",li+1,*),li=li-1 } QUIT l1 }
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adwlog(m,val) s $$$mtWhere(m)=$g($$$mtWhere(m))_val_"^"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK683-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF020
addTopNPred(m)
	n obExpr,obExprs,obTuple,val,v,vTop,i,j,desc,cnt,obyLst,depCols,litOne,topLimit,opList,orderByV,log,nActual
	#; PVA183: support TOP... ORDER BY in subquery
	s vTop=$$$mtTopArg(m),v=$$$mtV(vTop),obyLst=$$$mtSequencersQb(m),cnt=$l(obyLst,",")-1,obExprs="",depCols=",",topLimit="",opList="",nActual=0
	QUIT:$$needsCartesianProduct(m)
	#; Forward windows require producing all rows
	QUIT:$$forwardWindowsInSubq^%qaqpagg(m)
	n gbListExpr,ngb,canon s ngb=$l($g(mt("g",m)),",")-1,gbListExpr="" f j=1:1:ngb s gbListExpr(j)=$$buildCanonical^%qaqpre("v",$p(mt("g",m),",",j),0,-1,"")
	n aggInQB,containsAggs,call s aggInQB=$p($g(mt("p",m)),"^",3),containsAggs="",call="containsAggFunc^%qaqpre2"
	n saveMtw,savmaxl,savmaxv s saveMtw=$g(mt("w",m)),savmaxl=$$$maxl,savmaxv=$$$maxv
	f i=1:1:cnt
	{	s obExpr = $p(obyLst,",",i),desc=(obExpr["d")
		s obExpr = $p(obExpr,"d",1)
		continue:$p($$$mtV(obExpr),"^",3)=","
		s obExprs=obExprs_obExpr_"^",nActual=nActual+1
		i aggInQB do lvtree^%qaqpnl("v",obExpr) QUIT:containsAggs
		
		#; Stop if there is a GROUP BY and we find an ORDER BY expression that doesn't match any GROUP BY expression
		s canon=$s(ngb=0:"",1:$$buildCanonical^%qaqpre("v",obExpr,0,-1,""))
		f j=1:1:ngb i canon=gbListExpr(j) { s canon="" quit }
	#; AK683
		#;  more precise check of $$fd(), because things were
		#;      possibly removed from mt("g") in AK435 $$redist^qo 
		set:canon'=""&&($$fd^%qaqpre3($$$mtGroupDistinctList(m),obExpr_",")) canon=""
		#;  *** unclear why we have this restriction in the first
		#;      place - it should be removed!!!
	#; AK683-
		QUIT:canon'=""
		
		s orderByV = $$$mtV(obExpr)
		s depCols = depCols _ $s($e(orderByV)="f":obExpr_",",1:$e($p(orderByV,"^",3),2,*))
		s opList = opList_"."_$s((i<cnt)||aggInQB:$s(desc:"'<",1:"'>"),1:$s(desc:">",1:"<"))
		
		if $l(obExprs,"^")-1 = 1		// if this is the first non-streamless expression in the ORDER BY
		{	Set val=$$$newval("v^%LIMIT^,^",1) s topLimit=val
			d nulog^%qaqpnl("v^TOP:"_$e(opList,2,*)_"^"_depCols_"^"_obExpr_"^"_topLimit_"^")
			s $$$mtTopLimit(m)=topLimit_"^"_m
		}
		else
		{	Set val=$$$newval("v^TUPLE^"_depCols_"^"_obExprs,1) s obTuple = val
			d nulog^%qaqpnl("v^TOP:"_$e(opList,2,*)_"^"_depCols_"^"_obTuple_"^"_topLimit_"^")
		}
		do complexlog^%qaqpnl(m, val)
		s:i<cnt $p(opList,".",nActual+1)="'="
	}
	#; For now, disable the TOP optimization altogether if there are any aggregates in the ORDER BY
	#; list, or if there are any ORDER BY expressions that are not in the GROUP BY list.  Enable it
	#; when&if the code generator is generalized to dynamically find the %LIMIT in these cases.
	#; 
	if containsAggs||(ngb>0&&(canon'=""))
	{	i (saveMtw="") { k $$$mtWhere(m) } else { set $$$mtWhere(m)=saveMtw } 	; restore mt("w",m) as it was
		f i=savmaxl+1:1 { q:'$d($$$mtL(i))  k $$$mtL(i) } 				; restore $$$mtL(*) as it was
		f i=savmaxv+1:1 { q:'$d($$$mtV(i))  k $$$mtV(i),$$$mtVtr(i) } 	; restore $$$mtV(*)/mt("vtr",*) as they were
		k $$$mtTopLimit(m)
	}
	QUIT
needsCartesianProduct(m)
	#; count the number of streams in query block m
	n str,strcnt,nStr,subgraph,ojStart,inOrderDependentPart,nSubgraphs s strcnt=$$getNodeCount^%qaqpre("r"),nStr=0
	for str=1:1:strcnt { s subgraph(str)=str,inOrderDependentPart(str)="" if ($$$mtRQb($$$mtR(str))=m) s nStr=nStr+1 } // DPV2595 removed (ojClass(str)=""), not used anywhere and not NEW'd
	s nSubgraphs=nStr QUIT:nSubgraphs<=1 ""
	#; count the number of equijoins in query block m
	#; ASSERT($$$mtPQbIsActive(m))
	n logs,lgi,log,vals,s1,s2,equijoin s logs=$g($$$mtWhere(m))
	s ojStart=$s(logs="":1,1:$l(logs,"^"))
	
	#; i $d($$$mtLeftOuterJoins(m)) s logs=$g(logs)_$tr($$$mtLeftOuterJoins(m),",","^")
	i $d(linx) 
	{	for lgi=1:1:$l(linx,"^")-1 
		{	s vals=$$$mtLOperand2($$$mtL($p(linx,"^",lgi)))
			s:(m=$$$mtRQb($$$mtR($p($$$mtV(vals),"^",2)))) logs=$g(logs)_$p(linx,"^",lgi)_"^"
		}
	}
  
	f lgi=1:1:$l(logs,"^")-1
	{	s log=$p(logs,"^",lgi)
		if $$$mtLOperator($$$mtL(log))="="
		{	s vals=$$$mtLColVals($$$mtL(log))
			if ($l(vals,",")=4)&&($e($g($$$mtV($$$mtLOperand1($$$mtL(log)))))="f")&&($e($g($$$mtV($$$mtLOperand2($$$mtL(log)))))="f")
			{	s s1=$p($$$mtV($$$mtLOperand1($$$mtL(log))),"^",2)
				s s2=$p($$$mtV($$$mtLOperand2($$$mtL(log))),"^",2)
 				continue:inOrderDependentPart(s2)
 				
				#; Shorten up the subgraph paths as we encounter them
				f { q:subgraph(s1)=subgraph(subgraph(s1))||inOrderDependentPart(subgraph(s1))  s subgraph(s1)=subgraph(subgraph(s1)) }
				f { q:subgraph(s2)=subgraph(subgraph(s2))||inOrderDependentPart(subgraph(s2))  s subgraph(s2)=subgraph(subgraph(s2)) }
 
				if (subgraph(s1)'=subgraph(s2)) 
				{	if 'inOrderDependentPart(subgraph(s2))
					{	s:(lgi>=ojStart) inOrderDependentPart(subgraph(s2))=1
						s subgraph(subgraph(s2))=subgraph(s1),nSubgraphs=nSubgraphs-1
						quit:nSubgraphs=1
					}
				}
			}
		}
	}
	QUIT:nSubgraphs=1 ""
	
	#; After all the simple inner and outer equijoins have been processed,
	#; the join graph still has disconnected components.  Determine if 
	#; any "expression joins" can be used to connect the disconnected components.
	#;
	n v4,v5,vExpr,s3,progress
	s logs=$g($$$mtWhere(m)),progress=1
	while (nSubgraphs>1&&progress)
	{	s progress=""
		f lgi=1:1:$l(logs,"^")-1
		{	s log=$p(logs,"^",lgi)
			if $$$mtLOperator($$$mtL(log))="="
			{	s v4=$$$mtV($$$mtLOperand1($$$mtL(log)))
				s v5=$$$mtV($$$mtLOperand2($$$mtL(log)))
 
				#; s1 is the stream of the field, s2 is the stream of the first field in the expression.
				s s1=0
				if ($e(v4)="f")&&($e(v5)="v")&&($l($p(v5,"^",3),",")>3) // should be 2 when optimizer fixed
				{	s s1=$p(v4,"^",2),s2=$p($$$mtV($p($p(v5,"^",3),",",2)),"^",2),vExpr=v5
				}
				elseif ($e(v5)="f")&&($e(v4)="v")&&($l($p(v4,"^",3),",")>3) // should be 2 when optimizerr fixed
				{	s s1=$p(v5,"^",2),s2=$p($$$mtV($p($p(v4,"^",3),",",2)),"^",2),vExpr=v4
				}
				if (s1'=0)		; found either (field = expression) or (expression = field)
				{	continue:inOrderDependentPart(s2)
					f { q:subgraph(s1)=subgraph(subgraph(s1))||inOrderDependentPart(subgraph(s1))  s subgraph(s1)=subgraph(subgraph(s1)) }
					f { q:subgraph(s2)=subgraph(subgraph(s2))||inOrderDependentPart(subgraph(s2))  s subgraph(s2)=subgraph(subgraph(s2)) }
	 
					#; Every stream referenced in the expression must be in the same equivalence class as s2
					if (subgraph(s1)'=subgraph(s2))&&'inOrderDependentPart(subgraph(s2))
					{	s s3=s2
						f v=3:1:$l($p(v5,"^",3),",")-1
						{	s s3=$p($$$mtV($p($p(vExpr,"^",3),",",v)),"^",2)
							quit:inOrderDependentPart(s3)
							f { q:subgraph(s3)=subgraph(subgraph(s3))||inOrderDependentPart(subgraph(s3))  s subgraph(s3)=subgraph(subgraph(s3)) }
							quit:s3'=s2
						}
						if (s3=s2)
						{	s inOrderDependentPart(subgraph(s2))=1
							s subgraph(subgraph(s2))=subgraph(s1),nSubgraphs=nSubgraphs-1,progress=1
							quit:nSubgraphs=1
						}
					}
				}
			}
		}
	}
	QUIT nSubgraphs>1
	#; JLF020-
	#; JLF015
	#; Purpose: to set $$$mtAnyOfVals(log), mt("forallval",val), and mt("foralllog",log).
	#;
	#; In principle $$$mtAnyOfVals(log) could be set with a much less complex algorithm earlier in
	#; the compilation process; however, this would require all downstream code to properly 
	#; maintain the "anyof" values.  In particular, code that factors common terms, or that 
	#; copies/clones a log, etc., would potentially be affected.  Rather than make the whole of
	#; phase-1 optimization more complex, the complexity is at least localized here.
	#;
setAnyof(qno=0) // PVA316: qno arg for quickcost setup
	n x,m,j,logs,log,lgi,mtwLog,call,fld,aoRoots,anyofFound,mtwRoots,keyEle,baseIfn,otherRoots s anyofFound=""
	n v,baseFld,v2,baseOther,fld2,element,noconds
	if qno {s noconds=1} else {s noconds=0} // PVA316: disable side effect for quickcost setup
	  
	s call = "setAnyofRoots^%qaqpre3"
	f m=$s(qno:qno,1:1):1:$s(qno:qno,1:$$$mtPNumQbs ) // PVA316: only do specified query block for quickcost setup
	{	i $$$mtPQbIsActive(m),'$d($$$mtDupsv(m)),'$$isSharded^%qaqpnl(m)
		{	;; Loop over all logs in query block m, building $$$mtAnyOfVals(log) and mtwRoots(fVal)
		
			#; First mark all the collection f vals that are reachable from mt("w",m)
			#;
			s logs=$g($$$mtWhere(m)) k mtwRoots f lgi=$l(logs,"^")-1:-1:1 s mtwLog=$p(logs,"^",lgi) do lvtree^%qaqpnl("l",mtwLog)
 
			#; Now loop over each %ANYOF or %ANYOFKEY field, converting the 
			#; root logs for each field into a list of fields for each log.
			#;
			s fld="",aoRoots=""
			for 
			{	s fld=$o(mtwRoots(fld),1,aoRoots) q:fld=""  
 
				#; Combine %ANYOF* fields that reference the same element of a collection.
				#; This situation can be created by either multiple collations of an element, or
				#; because KEY and VALUE of the same element are referenced, or both. 
				#;
				s v=$$$mtV(fld)
				continue:($e(v)'="f")
				s baseFld=$e(v,$find(v,$s(v["%ANYOFKEY":"%ANYOFKEY",1:"%ANYOF")),*)
				s fld2 = fld
				for 
				{	s fld2 = $o(mtwRoots(fld2),1,otherRoots) q:fld2=""
					s v2=$$$mtV(fld2),baseOther=$e(v2,$find(v2,$s(v2["%ANYOFKEY":"%ANYOFKEY",1:"%ANYOF")),*)
					continue:(baseFld'=baseOther)  ; &&(mt("anyofOther",baseFld)'=baseOther))
					f j=1:1:$ll(otherRoots) s:$lf(aoRoots,$li(otherRoots,j))=0 aoRoots=aoRoots_$lb($li(otherRoots,j))
					s mtwRoots(fld2) = ""
				}
				
				#; If different %ANYOF* fields overlap at the mt("w",*) level, then root them
				#; under a common ANYOFAND
				#; 
				s fld2 = fld
				for
				{	s fld2 = $o(mtwRoots(fld2),1,otherRoots) q:fld2=""
					for j=1:1:$ll(otherRoots) 
					{	i $lf(aoRoots,$li(otherRoots,j))>0 
						{	for k=1:1:$ll(otherRoots) { s:$lf(aoRoots,$li(otherRoots,k))=0 aoRoots=aoRoots_$lb($li(otherRoots,k)) } 
							s mtwRoots(fld2)=aoRoots,aoRoots="" q 	; process fld+fld2 later, when we get to fld2
						}
					}
				}
 
				#; When there is more than one mt("w") condition that refers to an %ANYOF item, be 
				#; it the VALUE, the KEY, or both, we need to add an additional predicate 
				#; to AND their top-level mt("w",m) predicates together.  The new predicate is
				#; only partially satisfied by the other predicates.  Mark the lower-level predicates
				#; as optional, and unnecessary to test if the top-level condition has already been tested.
				#;
				i ($ll(aoRoots) > 1)
				{	s x="" f j=1:1:$ll(aoRoots) { s x=$$$mtLColVals($$$mtL($li(aoRoots,j)))_x_"^"_$li(aoRoots,j),$e(x)="" }
					#; PVA155: Use conds to classify anyofand
				    #; PVA316 noconds: no irrecoverable side effects for quickcost setup
					do nulog^%qaqpnl("l^ANYOFAND^,"_x_"^") if 'noconds { i $$conds^%qaqpnl } // properly set ptl, ptv, etc.
					k element,$$$mtAnyOfVals(log)
					f j=1:1:$l(x,",")-1
					{	s v=$$$mtV($p(x,",",j)),v2=$find(v,$s(v["%ANYOFKEY":"%ANYOFKEY",1:"%ANYOF"))
						if v2 { s baseFld=$e(v,v2,*),element(baseFld)="" }
					}
					s baseFld=""  f { s baseFld=$o(element(baseFld),1) q:baseFld=""  s $$$mtAnyOfVals(log)=$g($$$mtAnyOfVals(log))_$lb(baseFld) }
					f j=4:1:$l($$$mtL(log),"^")-1 s ptres($p($$$mtL(log),"^",j),","_log_",") = ""
				}
			}
		}
	}
 
	n mTopo,call,logs,log,lgi
	f mTopo=$$$mtPNumQbs:-1:1				; In bottom-up topological order - JLF128
	{	s m=mt("qbo",mTopo) s:qno m=qno // PVA316: only one query block for quickcost setup
		i $$$mtPQbIsActive(m),'$d($$$mtDupsv(m)),'$$isSharded^%qaqpnl(m) 
		{	s call = "xformAoaSubtree^%qaqpre2"
			s logs=$g($$$mtWhere(m))
			f lgi=$l(logs,"^")-1:-1:1 s log=$p(logs,"^",lgi) d lvtree^%qaqpnl("l",log)
			s:$d($$$mtWhere(m)) $$$mtWhere(m)=$tr($$distlist^%qaqcpr($tr($$$mtWhere(m),"^",",")),",","^")
		}
		quit:qno // PVA316: only one query block for quickcost setup	
	}
	QUIT
		
setAnyofRoots
	#; called with type,val,v,ev	rootList,mtwLog,mtwRoots (initially set to "")
	n evOrig,vOrig,valOrig,typeOrig,opn,opni,fValType s evOrig=ev,vOrig=v,valOrig=val,typeOrig=type
	#; $$$mtAnyOfVals(val) contains the list of ANYOF vals
	#; mtwRoots(anyofval) = $list of root logs
	#; 
	if "f"=ev 
	{	if v["_%ANYOF" { set anyofFound=1 s:$lf($g(mtwRoots(val)),mtwLog)=0 mtwRoots(val)=$g(mtwRoots(val))_$lb(mtwLog) }
		QUIT
	}
	#; if (type="l") && ("v"=ev) { s vParent = valOrig }
	QUIT:("tsxiq"[ev)
	QUIT:'$$hasAnyof(type,val)
	do lvarg^%qaqpnl
	if "l"=typeOrig && anyofFound
	{	if " ' '%NOINDEX "[(" "_$p(vOrig,"^",2)_" ") // PVA242
		{	f fld=2:1  q:$p($p(vOrig,"^",3),",",fld)=""  s:$$$mtV($p($p(vOrig,"^",3),",",fld))["_%ANYOF" mt("forallval",$p($p(vOrig,"^",3),",",fld))=""
		}
		if "!"'=$p(vOrig,"^",2)&& 
			((" ' '%NOINDEX "'[(" "_$p(vOrig,"^",2)_" "))||($d($$$mtAnyOfVals($p(vOrig,"^",4)))&&($p($$$mtLOperator($$$mtL($p(vOrig,"^",4))),"%NOINDEX")'="ANYOFAND"))) // PVA242
		{	n aoBaseFldRefs,fVal,v2,alias,afld,baseFld,opn,opnVal,vv,foundMultiRef
		
			#; Search for %ANYOF fields in the field list of the node.  If more than one operand
			#; references the same base field then mark this as a "multi-reference" log.  Such a
			#; log must be implemented with a single BuildValueArray loop if it's an AND node.
			#;
			s baseFld=0,foundMultiRef=0
			if $p(vOrig,"^",2)="&"
			{	for opn=4:1
				{	s opnVal=$p(vOrig,"^",opn) q:opnVal=""
					s vv=$p(mt(evOrig,opnVal),"^",3)
					for fld=2:1
					{	set fVal=$p(vv,",",fld) q:fVal=""
						if $d(mtwRoots(fVal))
						{	set v2=$$$mtV(fVal),baseFld=$e(v2,$find(v2,$s(v2["%ANYOFKEY":"%ANYOFKEY",1:"%ANYOF")),*)
							set aoBaseFldRefs(baseFld)=$i(aoBaseFldRefs(baseFld))
							if aoBaseFldRefs(baseFld)>1	{ set foundMultiRef=1 quit }
						}
					}
					quit:foundMultiRef
				}
			}
			
			#; Count the references to each base field.  If there is more than a single reference to
			#; a particular base field then we have a little problem, because an index lookup can't
			#; enforce the requirement that we're referring to the same collection element in different
			#; parts of the predicate.  If we have this situation, then insert a predicate that cannot
			#; be satisfied with index ANDing and ORing.
			#;
			if $p(vOrig,"^",2)'="&" || foundMultiRef
			{	k aoBaseFldRefs n aoBaseFldRefs
				for fld=2:1
				{	set fVal=$p($p(vOrig,"^",3),",",fld) q:fVal=""
					if $d(mtwRoots(fVal)) 
					{	set v2=$$$mtV(fVal),baseFld=$e(v2,$find(v2,$s(v2["%ANYOFKEY":"%ANYOFKEY",1:"%ANYOF")),*)
						if $lf($g($$$mtAnyOfVals(valOrig)),baseFld)=0 s $$$mtAnyOfVals(valOrig) = $g($$$mtAnyOfVals(valOrig))_$lb(baseFld)
						set aoBaseFldRefs(baseFld)=$i(aoBaseFldRefs(baseFld))	; count the #references to the collection element under this log
					}
				}
				set baseFld=""
				for { s baseFld=$o(aoBaseFldRefs(baseFld),1) q:baseFld=""  if $g(aoBaseFldRefs(baseFld))>1 d insANYOFAND(valOrig,vOrig) }
			}
		}
	}
	QUIT
	
hasAnyof(type,val)[call,found] {
	new call,found
	set call = "hasAnyofLvIter^%qaqpre3",found = 0
	do lviter^%qaqpnl(type,val)
	quit found
}
.
hasAnyofLvIter
	#; called with type,val,v,ev
	if ev="f",v["_%ANYOF" set found=1 quit
	GOTO lviterarg^%qaqpnl
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
insANYOFAND(andLog,v)
	#; An index lookup can't enforce multiple references to the same collection element, so we insert
	#; a non-indexable predicate at the right place in the parse tree for bsl.  That is, we convert:
	#; (& a b) => (& (ANYOFAND a b) (& a b))
	#; 
    new aoLog,aoBaseFldRefs,val
    RETURN:$p(v,"^",2)'="&"				; only insert the ANYOFAND under an AND node
    Set val=$$$newlog(v) s aoLog=val		; make a copy of the original "&" log
    set $$$mtLOperator($$$mtL(aoLog))="ANYOFAND"	; Make the new log (aoLog) an ANYOFAND
    Set val=$$$newlog(v)					; make another copy of the original operator
    set $p($$$mtL(andLog),"^",4,6)=aoLog_"^"_val_"^"	; Make the original log point to the ANYOFAND and a copy of itself
    RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-    
	#; JLF015-
	#; PVA157: new routine distinctpred	
distinctpred(m) // Add special DISTINCT predicate to query m
	n gcols,output
	if $d($$$mtGroupDistinctList(m),gcols),$$$mtPAggList($$$mtP(m))=""
	{	Set val=$$$newlog("v^DISTINCT^,^"_$tr(gcols,",","^"))
		s output=0 d lflds^%qaqpnl("l",val,"do")
		d adwlog^%qaqpnl(m,val)
	}
	QUIT
	#; PVA158: new utility OrToUnion
 	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- 
OrToUnion(m,wand,pos,orlist,nodups) // Transform query to union based on specified OR
    #; m - query number to transform
    #; wand - 0 if the OR driving the UNION is in mt("w")
    #;        otherwise the $$$mtL() number of the AND containing the OR
    #; pos - "^" piece position in mt("l") or mt("w") to replace with each OR alternative
    #; orlist - $list of mt("l") entries for the OR alternatives. None of these should be
    #;          an OR.
    #; nodups - 1 - extra duplicates are not acceptable
    #;          0 - extra duplicates don't matter
    #; ----
    #; Note that this is intended to be called between after undosideEffect, and before the
    #; second propagatPreds call. Calling at other locations is invalid (the usage
    #; of utilities assumes mt("ON") doesn't exist, nor does any stuff created by conds/outer/class.
    #; These assumptions are true only for the given location). 
    #; 
    #; Note that m never becomes part of union, nor is m ever copied, because various of 
    #; its features (e.g. aggregation) need to apply to the result of the union, 
    #; not be part of any query in the union. This is really a transform of the 
    #; stream list of m into a single stream with union query expresssion. 
    #; Thus special m=1 issues never arise. If no dups is specified, another query level 
    #; is introduced to perform the proper DISTINCT; note, this cannot generally be combined
    #; with mt("g") for m. That mt("g") may be doing grouping with counts, whose correct
    #; result required duplicate control in m's source stream.
    #; 
	n movstrs,str,trvals,pwh,cwh,i,log,op,svpos,qnums,oi,msav,max,qr,dist,info,lgi,logs
	n viewFvals,xlate // MUST!! be newed here for copyqb
	#; First build an initial union leg query from scratch. The other union legs are copied
	#; from this (this is the same approach as fjxfrm). All streams of m are moved into 
	#; leg 1. Other legs get copies.
	s str="",movstrs="," for 
	{  s str=$o($$$mtR(str),1,info) q:str=""
	   continue:$p(info,"^",2)'=m
	   s movstrs=movstrs_str_","
	}
	#; Factor mt("w",m) into pwh (remains in m) and cwh (goes to new queries with OR substitution)
	#;  TOP and DISTINCT pseudopreds remain in m; rest goes to cwh
	s svpos=pos
	for i=1:1 
	{  s log=$p($g($$$mtWhere(m)),"^",i) q:'log
	   s op=$$$mtLOperator($$$mtL(log))
	   if op["TOP:" || (op="DISTINCT") //with intended usage, DISTINCT pseudo-pred not added yet
	   {  s pwh=$g(pwh)_log_"^"
	      if 'wand,i<svpos s pos=pos-1
	   }
	   else { s cwh=$g(cwh)_log_"^" }	   
	}
	#; First OR alternative substituted within cr8query, for timing reasons.	
	if $g(pwh) {s $$$mtWhere(m)=pwh} else {k $$$mtWhere(m)}
	s qnums(1)=$$cr8query^%qaqpre2(movstrs,.trvals,cwh,nodups,wand,pos,.orlist)
	s $$$mtUnionTopQb(qnums(1))=qnums(1) // start the union
	
	#; substitute remaining OR alternatives in qnums(1) and copy it
	for oi=2:1:$ll(orlist)
	{  s xlate("qb",m)=maxm+1 // PVA165: for deep subqueries in the OR alternative that
	                          #; correlate to m, must set up this translation for copyqb.
	                          #; Note maxm+1 is the new query that to be created by
	                          #; copyqb. 
	   s qnums(oi)=$$copyqb(qnums(1),m)
	   s $$$mtL($li(orlist,oi-1))="i^clean"_$$$mtL($li(orlist,oi-1)) // PVA159
	   #; make union another union
	   s $$$mtUnion(qnums(1))=$g($$$mtUnion(qnums(1)))_$lb(qnums(oi)_"a")
	   s $$$mtUnionTopQb(qnums(oi))=qnums(1)
	   if wand {s $p($$$mtL(wand),"^",pos)=$li(orlist,oi)} else {s $p($$$mtWhere(qnums(1)),"^",pos)=$li(orlist,oi)}
	   #; The new OR substitution can have arbitrary differences from the the last.
	   #;   Thus a bunch of things need to be recomputed
	   s $$$mtPCorrelatedFields($$$mtP(qnums(1)))="" d setqparms^%qaqpre2(m,qnums(1),movstrs) // set $$$mtP() piece 4
	   d fixsubq^%qaqpre3(qnums(1)) 
	   d resetnulstr^%qaqpre2(qnums(1)) 
 	   s msav=m,m=qnums(1) d flds^%qaqpnl s m=msav
 	   k xlate // PVA183: so one copy doesn't interfere with another.
	}
	#; qnums(1) is left with the last OR alternative	
	
	#;  make stream of union
	s tname="%%Q"_qnums(1)
	s mlabel=m_"^crvw%"_qnums(1)
	s $$$mtFromTableName(mlabel)=tname
	s fval = $$$newval("junk",1) //real content to be filled in by vstrf
	s $$$mtPViewIDVal($$$mtP(qnums(1)))=fval // set pointer to (what will be) id val of osq streamed view
	d vstrf^%qaqpqo,createval^%qaqpdt(fval)
	s max=$l($$$mtOutputVals($$$mtOutput(qnums(1))),",")-$l(movstrs,",")+2
	s dist=""
	for i=1:1:($l($$$mtOutputVals($$$mtOutput(qnums(1))),",")-1)
	{ s fval=$$$newval("junk",1) 
	  if 'nodups||(i<max) { s trvals($p($$$mtOutputVals($$$mtOutput(qnums(1))),",",i))=fval } 
	  else {s dist=dist_fval_","}
	  d vstrf^%qaqpqo,createval^%qaqpdt(fval)
	}
	#;  fix all references to movstrs in m to ref output of new stream 
	d fixstrmrefs^%qaqpre2(m,movstrs,"",$$$ptrel(mlabel),mlabel,0) //strnames arg empty 
	#;                     because mt("ON") should not exist after propagatePreds phase 1
	d fixrefs^%qaqpnl(m,"",.trvals,0,1,1) // PVA179: dostrms argument
	d flds^%qaqpnl
	#; In case one of the orlist items was an AND, must flatten into mt("w").
	f i=1:1:$ll(orlist) { s logs=$g($$$mtWhere(qnums(i))) f lgi=1:1 { s log=$p(logs,"^",lgi) q:log=""  d where^%qaqpqo(.logs,log,.lgi) } s:$d($$$mtWhere(qnums(i))) $$$mtWhere(qnums(i))=logs }
	if nodups 
	{  s qr=$$cr8strview^%qaqpre2(","_$$$ptrel(mlabel)_",","","","","",1) // PVA179: dostrms argument
	   s $$$mtGroupDistinctList(qr)=dist,$$$mtDistinct(qr)=dist,mt("dups",qr)=$$$SQLELIMINATEDUPS
	   s $p($$$mtOutput(qr),"^")="d"
	   s msav=m,m=qr d flds^%qaqpnl
       s m=msav d flds^%qaqpnl
	}
	QUIT
	#; PVA159: create marksqs,lsubqs,lsq
	#; PVA169: add inloop argument
 	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- 
marksqs(m,inloop=0) // Find orphan queries and ensure marked as abandoned
		#; This can be called either before or after mt("j") is made as long as linx
		#;  still exists (note: linx is not killed when mt("j") are created)
		#; Except as a recursive call, this should only be called with m=1
		#; NOTE: This function is necessary because a value subquery selected by a
		#;   view can be multiply referenced after the view is merged. If one of its
		#;   uses becomes obsolete, it is impossible to locally know if it is save to mark
		#;   such subquery obsolete. Yet, it is very wasteful to generate code for an
		#;   unreachable subquery. Thus this global reachability algorithm.
		#; inloop=1 means this is being called within a calcQBOrder loop; thus it should
		#;   not call calcQBOrder. 
	n lx,log,vals,val,info,q,xa,logs,str,args
	if m=1 {
		set $$$mtPActiveQbs=$tr($$$mtPActiveQbs,"1","0") // clear $$$mtPActiveQbs, then turn on for reachable subqs
		new revmt,revtop,revlog
		set lx="" for {
			set lx=$order($$$mtR(lx),1,info) quit:lx=""
			s val=$piece(info,"^",2)
			if val'="" set revmt(val,lx)=""
		}
		for q=1:1:maxm {
			set val=$get($$$mtUnionTopQb(q))
			if val'="",val'=q set revtop(val,q)=""
		}
		for lx=1:1 {
			set log=$piece(linx,"^",lx) quit:'log
			set val=$$$mtLOperand1($$$mtL(log)) set:$$$mtVType($$$mtV(val))'="f" val=$piece($$$mtL(log),"^",5)
			set val=$piece(ptv(val),"^",7)
			if val'="" set revlog(val,log)=""
		}
	}
	i $$$mtPQbIsActive(m)=1 q
	s $$$mtPQbIsActive(m)=1 // mark this one
	d lsubqs("l",$g($$$mtWhere(m))) 
	d lsubqs("l",$g($$$mtStreamlessConds(m))) // PVA169: support streamless subquery conditions
	#; PVA169: support mt("ON",) nodes in marksqs
	s xa="" f 
	{  s xa=$o($$$mtOn(m, xa),1,logs) q:xa=""
	   s logs=$li(logs,$$$SQLONPREDICATE) 
	   d lsubqs("l",logs)
	}
	d lsubqs("l",$g($$$mtHaving(m)))
	f vals=$g($$$mtGroupDistinctList(m)),$$$mtOutputVals($g($$$mtOutput(m))) d lsubqs("v",vals)
	s str="" for // PVA348: tvfs too; note subqueries only prohibited from json_table if lateral references
	{  s str=$o($$$mtTvfParams(str),1,args) q:str=""  continue:$$$mtRQb($$$mtR(str))'=m
	   continue:args=$c(0) 
	   s vals=$$listToStringSkipNull^%qaqutility(args) continue:args=""
	   d lsubqs("v",vals)
	}
	d lsubqs("v",$tr($g($$$mtSequencersQb(m)),"d")) // PVA183
	d:m=1 lsubqs("v",$tr($g($$$mtSequencers),"d"))  
	d:m=1 lsubqs("v",$g($$$mtNewVals))
	set lx="" for {
		set lx=$order(revlog(m,lx)) quit:lx=""
		do lsubqs("l",lx)
	}
	set lx="" for {
		set lx=$order(revtop(m,lx)) quit:lx=""
		do marksqs(lx) // if m a union top
	}
	#; Also stream queries
	set lx="" for {
		set lx=$order(revmt(m,lx)) quit:lx=""
		if $data($$$mtRVirtual(lx),val) do marksqs(val)
	}
	#; Perhaps still necessary to kill mt("w") ; MJG044 - but not if this where clause is needed for FT regeneration
	if m=1 for q=1:1:maxm k:'$$$mtPQbIsActive(q) $$$mtWhere(q)
	d:m=1&&'inloop calcQBOrder^%qaqpnl(1) // PVA169: make this conditional on inloop arg.
	QUIT
lsubqs(type,list)
	QUIT:'list
	n call,j,val
	s call="lsq"
	s list=$tr(list,"^",",")
	for j=1:1
	{  s val=$p(list,",",j) q:'val
	   d lviter^%qaqpnl(type,val)
	}
	QUIT
	#; PVA175: create cleanunary
 	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- 
cleanunary(movstrs) // eliminate normal (not collection related) mt("unary") entries
	#;                 associated with movstrs
	n fld,op
	s fld="" for
	{  s fld=$o(mt("unary",fld)) q:fld=""
	   s op="" for
	   {  s op=$o(mt("unary",fld,op)) q:op=""
	      continue:$e($g($$$mtV(fld)))'="f"
	      k:movstrs[(","_$p($$$mtV(fld),"^",2)_",")&&(op'["%ANYOF") mt("unary",fld,op)
	   }
	}
	QUIT
#; PVA198: create clearflds	
clearflds() [maxm,mt,ptv] public
 {  for m=1:1:maxm { continue:'$$$mtPQbIsActive(m)  s $p($$$mtP(m),"^",3,4)="^" }
 	for i=1:1:$$$maxv { if $d(ptv(i)) {s $p(ptv(i),"^",$$$PTVREFERENCED)=0,$p(ptv(i),"^",$$$PTVNEEDEDFOROUTPUT)=1}}
 }	
#; PVA198: create optVwOut   
optVwOut(m) [ptv,mt,anyset] public
 {  n anyset s anyset=0
    s ml=m_"^" for 
    {  s ml=$o($$$ptrel(ml),1,str) q:ml=""  q:$p(ml,"^")'=m 
       continue:(ml=$g($$$mtTarget)&&($$$mtStatementType'="INS")) // don't bother with update/delete target; it will be merged anyway
       continue:'$d($$$mtRVirtual(str))  
       s qv=$$$mtRVirtual(str) continue:$d($$$mtDupsv(qv)) // can't optimize duplicate view
       continue:$g($$$mtDSNLinkedTable(qv))]""&&$d($$$mtGroupDistinctList(qv)) // PVA203
	   #; also, for duplicated view, must check referenced against both duplicated view
       #;       and its duplicate.
       s dqv="" f  s dqv=$o($$$mtDupsv(dqv)) q:dqv=""  q:$$$mtDupsv(dqv)=qv
       ; continue:dqv]""
       #; The following assumes there is only one duplicate of a given view. If this 
       #; turns out not to be true, must either generalize this to a loop on
       #; duplicate views, or go back to prior continue:dqv'"" (skipping duplicated views)
       s vid=$$$mtPViewIDVal($$$mtP(qv)),nvf=$ll($$$mtAlphaUpAliases(qv)) s:dqv]"" dqvid=$$$mtPViewIDVal($$$mtP(dqv))
       for vn=vid+1:1:vid+nvf { if (+$p(ptv(vn),"^",$$$PTVREFERENCED)=0 && $s(dqv]"":(+$p(ptv(vn-vid+dqvid),"^",$$$PTVREFERENCED)=0),1:1)) {d nuljj^%qaqpsq(qv,vn-vid)}}
    }
    QUIT anyset
 }
isTableFld(val)
	QUIT:$$$mtVType($$$mtV(val))'="f" 0
	QUIT:$d($$$mtRVirtual($p($$$mtV(val),"^",2))) 0
	QUIT 1
insertTopN()
	QUIT:(m'=1) 0
	n ordBy s ordBy = $s($g($$$mtSequencers)'="":$$$mtSequencers,1:$g($$$mtSequencersQb(1)))				; for generality.  As presently called, $$$mtSequencersQb(1) will never be defined
	QUIT:ordBy="" 0										; ORDER BY is not specified
	QUIT:$g($$$mtTopSQLCODE100)'="" 0							; TOP is not already specified
	QUIT:'$$hint^%qaqpre("%USEORDERBYINDEX",1) 0		; The %USEORDERBYINDEX hint was not specified
	n i,allflds,sortCols,sameStr,str 
	s allflds=1,sortCols="",sameStr="" 
	f i=1:1 
	{	s v = $p(ordBy,",",i) q:v=""  
		if '$$isTableFld(+v) 
		{ 	s allflds = 0 quit } 						; is this a table column?
		else 
		{ 	s sortCols=sortCols_$lb(+v)
			s str=$p($$$mtV(+v),"^",2) 
			s:i=1 sameStr = str							; initialize sameStr first time through the loop
			if sameStr'=str { s sameStr="" quit }		; same stream as all the other ORDER BY columns?
		}
	}
	QUIT:'allflds 0										; all the ORDER BY expressions are table columns
	QUIT:'sameStr 0										; all the ORDER BY columns are on the same table
	QUIT:'$$usefulIndex^%qaqpre(1,sortCols,"") 0		; there is an index that can deliver the requested order
	s $$$mtTopSQLCODE100 = $$$newval("t^999999999999999999",1)	; insert TOP [all]
	set $$$mtTopStyle(1) = "TOP"
	QUIT 1												; return success status
	
	#; JLF: new utility MatchesToUnion
 	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- 
 	#;
 	#; a %MATCHES ?	in mt("w",m) =>	
 	#;	[	
 	#;		(? IN ('*','**') AND a IS NOT NULL) OR
 	#;		(NOT ? IN ('*','**') AND a %MATCHES ? AND a %STARTSWITH f(?)) 
 	#; 	]
 	#;
 	#; then:
 	#;  n orl s orl = $o($$$mtL(""),-1)
 	#;	do OrToUnion^%qaqpre3(m,0,$l(mt("w",m),"^")-1,$lb(orl,orl-1,orl-2),0)
 	#;
MatchesToUnion(m)
	QUIT:'$$$mtPQbIsActive(m) 0
	QUIT:($l($tr($$$mtPActiveQbs,"0",""))>256) 0
	n logs,log,ptln,i,orl,xformed,swlog,swpos
	n log1,log2,log3,log4,log5,log6,log7,log8,log9
	n star,starstar,one,firstchar,matchpat
	s xformed = 0, logs = $g($$$mtWhere(m))
	for i=1:1 
	{	s log=$p(logs,"^",i) q:'log
	 	s ptln=$$$mtL(log)
	 	
		if $p(ptln,"^",2)="%MATCHES" && ($p($$$mtV($p(ptln,"^",5)),"^",1,2)="v^%MATCHES2PAT")
			&& ( ($e($$$mtV($p($$$mtV($p(ptln,"^",5)),"^",4)))="x") ||
				 (  ($e($$$mtV($p($$$mtV($p(ptln,"^",5)),"^",4)))="v") && 
				    ($e($$$mtV($p($$$mtV($p($$$mtV($p(ptln,"^",5)),"^",4)),"^",4)))="x")
				 )
			   )
			&& $bit($g(ptlikeimp),log)							; but only if there is also a %STARTSWITH
			&& ($p($g($$$mtL(log+1)),"^",1,2)="v^%STARTSWITH")	; and it is in the expected place
		{	
			if 'xformed
			{	s star = $$$newval("t^*",1)
				s starstar = $$$newval("t^**",1)
				s one = $$$newval("t^1",1)
				s quesmark = $$$newval("t^?",1)
				s matchpat = $p($$$mtV($p(ptln,"^",5)),"^",4)
				s firstchar = $$$newval("v^SUBSTRING^"_$p(ptln,"^",3)_"^"_matchpat_"^"_one_"^"_one_"^",1)
				s xformed = 1
			}
			
			#; Change the operator to %MATCHES2 until all transformations are completed
			#; so that the transformation is applied only once, then change the name back
			#; to %MATCHES at the end.
			#;
			s $p(ptln,"^",2) = "%MATCHES2"
	
			#; Temporarily remove the %STARTSWITH that was added at parse time from mt("w",m),
			#; then add it back to one of the OR legs
			#;
			s swlog = log+1
			s swpos = $f("^"_$$$mtWhere(m),"^"_swlog_"^")
			s $e($$$mtWhere(m),swpos-($l(swlog)+2),swpos-($l(swlog)+2)+$l(swlog)) = ""
			s logs = $$$mtWhere(m)
			// s $bit(ptlikeimp,log) = 0		; disassociate the %STARTSWITH from this log
			
			#; (NOT ? IN ('*','**') AND a %MATCHES ? AND a %STARTSWITH f(?))
			s log5 = $$$newlog("v^IN^,^"_matchpat_"^"_star_"^"_starstar_"^")
			s log5 = $$$newlog("l^'^"_$p(ptln,"^",3)_"^"_log5_"^")
			s log7 = $$$newlog(ptln)
			s log8 = $$$newlog("l^&^"_$p(ptln,"^",3)_"^"_log5_"^"_log7_"^")
			s log9 = $$$newlog("l^&^"_$p(ptln,"^",3)_"^"_log8_"^"_swlog_"^")
			
			#; (? IN ('*','**') AND a IS NOT NULL)
			s log7 = $$$newlog("v^IN^,^"_matchpat_"^"_star_"^"_starstar_"^")
			s log8 = $$$newlog("v^'NULL^"_$p(ptln,"^",3)_"^"_$p(ptln,"^",4)_"^")
			s log5 = $$$newlog("l^&^"_$p(ptln,"^",3)_"^"_log7_"^"_log8_"^")
			
			d nulog^%qaqpnl("l^!^"_$p(ptln,"^",3)_"^"_log5_"^"_log9_"^")
			
			s $$$mtWhere(m) = $s(i>1:$p($$$mtWhere(m),"^",1,i-1)_"^",1:"")_$p($$$mtWhere(m),"^",i+1,*)
			
			do OrToUnion^%qaqpre3(m,0,$l($$$mtWhere(m),"^")-1,$lb(log5,log9),0)				
			quit
		}
	}
	QUIT xformed
---
