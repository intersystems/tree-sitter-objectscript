====
qaqpqo1
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpqo1^MAC^^^0
%qaqpqo1	// part of %qaqpqo (3/9/87)
	;; COMPONENTS :: SQL/PreOptimizer
	#;
#INCLUDE %msql
#include %SYS.DBSRV
#IF 0   ;-------------------------------------------------------------
	; Description:   Last part of %qaqpqo
	; Author:        Aviel Klausner
	; Date Started:  March 09, 1987
	;
	;  AK850   (11/30/2020) - Implement lateral join
	;  AK1030  (10/07/2020) - Avoid tail recursion in andfeq()
	;  AK989   (10/30/2018) - Correct "empty" UNION leg in AK865 "pushag"
	;  JMM760  (10/21/2016) - Take outlier selectivity into account when calculating join selectivity
	;  PVA342  (12/15/2015) - Generate ojfilters for sharding only when really needed, and fix interaction between aggregates and outer joins (for sharding)
	;  PVA336  (10/13/2015) - Build ojfilter structure to specify filtiering of sharded outer join query results
	;  AK865   (09/21/2015) - Push aggregates into UNION ALL
	;  PVA321  (05/13/2015) - Fix a performance regression with an OR of join conditions
	;  AK887   (01/27/2015) - (TRW) Build mts("AGG") again, align with spec (case of operator, DISTINCT)
	;  AK902   (02/21/2014) - Parallel GROUP BY partitioned by FROM
	;  PVA306  (06/13/2014) - Support system switch for whether selectivity for unknown values (parameters) is assumed to possibly be the outlier
	;  AK895   (11/13/2013) - Fix %FIND for more than one stream
	;  AK871   (01/10/2013) - Fix multi-subscript collection index
	;  AK688   (01/24/2008) - Abstract index/filter conditions
	;  AK861   (08/03/2011) - Skip abandoned linx entries in ezoj
	;  PVA253  (03/01/2012) - Fix ptsjoin+1^%qaqpqo1 *ptv("8") ERROR for dumb query
	;  BJB529  (02/12/2012) - %IGNOREINDEX * does not work
	;  PVA242  (07/28/2011) - Support a hint (%noindex) to not use indexes to satisfy the indicated condition
	;  AK802   (02/19/2011) - Fix fields found in collection clone maps
	;  AK794   (12/07/2010) - Fix idsub for collection cloned maps
	;  PVA230  (11/29/2010) - Fix problem of picking worse collection index when more than one satisfy the same condition
	;  AK787   (09/01/2010) - Skip "ezoj" opt. for %INORDER, %DBUGFULL
	;  PVA217  (01/26/2010) - Enhance collection predicate optimization to favor using collection indexes first in the join order
	;  PVA214  (12/08/2009) - Report error for attempt to update/delete from a non-updatable query
	;  AK752   (10/09/2009) - Construct partial order of outer join targets
	;  AK693   (02/20/2008) - Don't optimize arrow-syntax lookup
	;  AK742   (07/28/2009) - Recompute "needed for output" flag
	;  PVA196  (07/28/2009) - Fix an: <UNDEFINED>ptfjoo+2^%qaqpqo1 *mt("s")
	;  PVA184  (06/14/2009) - Optimizer support for TOP... ORDER BY in subqueries
	;  PVA183  (05/26/2009) - Pre-optimizer support for TOP...ORDER BY in subqueries
	;  AK723   (02/13/2009) - Skip more optimizations for linked queries
	;  DPV3231 (08/05/2008) - Use process private global for ptln, ptrel
	;  JLF216  (04/09/2008) - General pre-optimizer code cleanup for ptv
	;  DPV3131 (03/25/2008) - DD Lookup and Table compiler performance improvements
	;  JLF196  (01/03/2008) - Clean up mts(m,str) after LOJ is removed
	;  PVA152  (11/08/2007) - Query Optimization improved for text and collection predicates
	;  PVA139  (09/21/2007) - Allow updatable view to be streamed
	;  DPV2999 (08/17/2007) - PRIVATE TEMP TABLES do not acquire locks for filing or read-committed checks
	;  DPV2990 (08/01/2007) - Support SELECT %NOLOCK
	;  JLF169  (07/24/2007) - Fix ddfmap so that collated references can be satisfied from index data
	;  AK681   (06/11/2007) - Correct orlog/andid logic for OR on rowid
	;  AK680   (05/24/2007) - Consider all indexes on UPDATE
	;  JLF162  (05/17/2007) - Fix to collection index eligibility alg in ddfmap (JLF156)
	;  JLF156  (04/23/2007) - Check for KEY/ELEMENT in index subscript or data
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  DPV2840 (01/17/2007) - SQL Fix: Correct DPV2769 when collation with truncation length is used
	;  JLF140  (01/03/2007) - Unreferenced collection fields were not removed by fsave
	;  JLF138  (12/21/2006) - Collection index map number improperly allocated
	;  PVA117  (12/15/2006) - an <UNDEFINED>realf+2^%qaqcasl *mt("virf","30") error
	;  PVA115  (12/12/2006) - Assorted outer join fixes
	;  DPV2769 (10/19/2006) - SQL Fix: Fix use of %Name multi-subscript index when collation is used
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  AK650   (06/09/2006) - Fix assignment of new mt("v") nodes
	;  DPV2608 (03/08/2006) - Fix SPACE, PLUS and MINUS collations
	;  DPV2546 (11/08/2005) - Implement new MVR collation function.  Change collation implementations to use $zu(28)
	;  JLF050  (09/06/2005) - Handle missing ID in mts "ATT" - <UNDEFINED>parnt^%qaqpqo1
	;  PVA079  (05/12/2005) - Cosmetic fix to JLF020
	;  PVA078  (05/12/2005) - Error in inequality selectivity for two conditions of the same 'direction'
	;  DPV2351 (01/28/2005) - Support BitSlice indices in SQL Filer
	;  DPV2326 (11/29/2004) - Implement Build/Purge Indices for %CacheSQLStorage
	;  PVA068  (09/08/2004) - Eliminate Extra temp file and sort for ORDER BY that includes aggregates. 
	;  JLF013  (04/27/2004) - DISTINCT + left outer join optimization
	;  JLF015  (02/27/2004) - Added support for %ANYOF
	;  PVA064  (07/13/2004) - Remove MRP512 
	;  BJB284  (03/01/2004) - Correct ifn conflict with Virtual OR
	;  PVA059  (02/05/2004) - Index on expression of one field not used in query. 
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  AK556   (01/07/2003) - Re-enable AK465 for old OR optimization
	;  AK553   (12/20/2002) - Don't remove rowid from mts()
	;  AK527   (07/17/2002) - Remove unnecessary uncollated mts() entries
	;  DPV1748 (06/13/2002) - Make sort() PRIVATE function, 'y' was un-NEW'd
	;  PVA34   (03/15/2002) - Use more than one index per table for restriction
	;  AK514   (03/26/2002) - Filter inherited bitmaps
	;  DPV1690 (03/21/2002) - Fix <UNDEFINED> in hirar when join on childtable not including the parent
	;  PVA021  (10/26/2000) - bitmaps: Pre-optimizer support for OR generalized CON node
	;  AK503   (12/17/2001) - Use bitmaps anywhere
	;  AK491   (10/03/2001) - SHD: Mark MREL fields for sort-file
	;  DPV1557 (06/19/2001) - Make READ_COMMITTED code generation ties to new lock system support
	;  DPV1550 (06/15/2001) - More READ_COMMITTED work, now we support queries with multiple tables
	;  DPV1531 (05/18/2001) - Support READ_COMMITTED Isolation level, remove indirection for mt, mts, ptv
	;  AK465   (02/20/2001) - SHD: Report only master map for OR optimization
	;  PVA022  (11/03/2000) - IPSA: Building sort file when build index is better
	;  AK446   (05/31/2000) - View stream processing
	;  AK442   (05/15/2000) - Improve DNF analysis
	;  AK434   (03/31/2000) - eBSure: Avoid recursion in OR analysis
	;  DPV1258 (02/04/2000) - Don't use Bitmap indices (for now)
	;  AK421   (01/12/2000) - Fix coll(f) in map subscript
	;  AK420   (01/10/2000) - Berne: Pre-optimizer OR constructs
	;  AK403   (10/28/1999) - Apply collation to equality conditions
	;  DPV1151 (10/01/1999) - Support SQLUPPER and SQLSTRING Collations
	;  AK380   (07/08/1999) - CCS#37: OUTER JOIN with expression
	;  DPV1095 (06/28/1999) - Add truncate parameter to STRING function
	;  AK368   (05/27/1999) - Bern: Fix NOT with Not-NULL maps
	;  DPV1006 (04/07/1999) - String collation support
	;  TR701   (10/26/98)   - Modify condition selectivity formulas
	;  DPV837  (05/08/98)   - Use SQL Category, not old datatype to determine
	;                         if it's a name field
	;  DPV700  (02/06/97)   - Support IS NOT NULL in a single log condition
	;  MRP655  (11/19/96)   - Quick <UNDEFINED> fix with a $g()
	;  MRP570  (06/26/96)   - Transaction Processing
	;  MRP569  (01/26/96)   - Analyze Complex Subscripts for Query 
	;  MRP535  (10/20/95)   - Support SET <field> = <value expression>
	;  MRP562  (12/18/95)   - Allow LIKE <multiple-choice-field>
	;  MRP536  (10/30/95)   - Allow M Expression in WHERE clause
	;  MRP512  (07/04/95)   - Optimize Block Count for Master Maps
	;  MRP510  (07/03/95)   - Clean-Up loose ends from MRP466
	;  RLL546  (12/05/94)   - Don't set up function flags in mts array
	;                         for compound row ids
	;  MRP466  (11/28/94)   - Handle Collation Expressions
	;                         --- cleaned up: old stuff in zqapqo1 ---
	;  MRP442  (08/24/94)   - Fix LIKE predicate to apply function properly
	;  MRP404  (05/17/94)   - Check for the proper function
	;                         (See 'zqapqo1' for all Change codes)
	;  MRP379  (03/04/94)   - Process new prefix extended functions 
	;                         (+, -, " ") for index maps
	;  AK017;AK040;AK062;AK069;AK114;AK116;AK124;AK127;AK153;ALL001
	;  AK195
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 
	#; default x to d if it is 0 or NULL
#define default(%x,%d) $s(%x:%x,1:%d)
 
	#;---------- append stuff to piece pn of ptv(val) -------
#define aptv(%val,%pn,%stuff) s $p(ptv(%val),"^",%pn)=$p($g(ptv(%val)),"^",%pn)_%stuff
 
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#; CRUCIAL THAT CHANGES TO here are mirrored in quickcost^%qaqomul (PVA316)
	#; JLF015
	#; mvMaps contains a list of all the multi-valued (collection) maps,
	#; along with a sub-list of all the vals of a particular collection
	#; that are referenced within that map.  Each entry in mvMaps will
	#; correspond to a cloned map, and the clone references the map that
	#; it came from through mt("smdimp", cloneimp).  Since smd is not
	#; cloned, mt("smdimp",imp) needs to be used when referencing smd.
	#; 
	n mvMaps s mvMaps=""
	#; JLF015-
	#; AK465
	n onemap  ;  flag per str to report to the optimizer only one map
	#; AK865
	n undist s undist=""  ;  $BIT(m) of "untop" m with UNION DISTINCT
	f m=1:1:maxm s:$g($$$mtUnion(m))["d" $bit(undist,$$$mtUnionTopQb(m))=1
	#;  check for no UNION DISTINCT, not obsolete, UNION top, in FROM
	f mTopo=2:1:maxm s m=mt("qbo",mTopo) i '$bit(undist,m),$$$mtPQbIsActive(m),$g($$$mtUnionTopQb(m))=m,$$$mtCorrParentQb(m)'=+$$$mtP(m) { d pushag }
	#; AK865-
	#; PVA139: Move setting of mt("o") for updating statement from pqo so all new deferred view merging is already done
	#;  rowid "needed for output" - make sure we land on the correct target
	i "DEL UPD"[$$$mtStatementType,mcurs s str=$$$ptrel($$$mtTarget),m=1,output=1 d:$d($$$mtRVirtual(str)) error(35) d apndo^%qaqpqo($$nufld^%qaqpqo(str,$$$smdRowIDField(1,+$$$mtR(str)))) d lflds^%qaqpnl("v",$$$mtOutputVals($g($$$mtOutput(m))),"do")
	#; PVA115: Don't look at disabled queries in following loops
	#; AK723
	#; PVA321: skip orlog for ORs already analyzed in tryOrToUnion^%qaqpre
	f m=1:1:maxm if $$$mtPQbIsActive(m),$g($$$mtDSNLinkedTable(m))="",'$$isSharded^%qaqpnl(m),$g($$$mtPartitionPredicates(m))="" f lgi=1:1 s log=$p($g($$$mtWhere(m)),"^",lgi) q:log=""  d:'$lf($g(mt("no-orlog")),log) orlog  ; AK420
	d txtfixptv() // PVA217: After this (last call to txtfixptv), no new fields used by any conditions should be set up
	f fval=1:1:$$$maxv s:"f"=$p($g(ptv(fval)),"^",$$$PTVVALTYPE) $p(ptv(fval),"^",$$$PTVLOGREFS)=""
	s noindexmap="" // PVA242
	#; PVA253: test for mt("empty") below
	f m=1:1:maxm if $$$mtPQbIsActive(m),$g($$$mtDSNLinkedTable(m))="",'$$isSharded^%qaqpnl(m),'$g($$$mtEmpty(m)) f lgi=1:1 s log=$p($g($$$mtWhere(m)),"^",lgi) q:log=""  d cond
	f m=1:1:maxm if $$$mtPQbIsActive(m),$g($$$mtDSNLinkedTable(m))="",'$$isSharded^%qaqpnl(m) f lgi=1:1 s log=$p($g($$$mtLeftOuterJoins(m)),",",lgi) q:log=""  d cond
	#; AK723-
	f m=1:1:maxm if $$$mtPQbIsActive(m) d ptfjoo(m) // PVA183: for subqueries now
	s mname=""  ; --- get maps info for each stream, field --------
	f str=1:1:maxs d maps
	#; JLF015
	if mvMaps'="" f str=1:1:maxs d cloneMaps($p($g($$$mtR(str)),"^",2),str,mvMaps)
	
	#; Completely remove the collection index template from the mts "ATT" map lists,
	#; and mark the template so it is not mistakenly used for any plan.
	#; 
	n a,ch,i,pc14
	
	s m="" 
	for
	{	s m=$o(mts(m)) q:m=""
	    continue:$$isSharded^%qaqpnl(m)
		s str=""
		for
		{	s str=$o(mts(m,str)) q:str=""
			s i=""
			for
			{	s i=$o(mt("collidx",i)) q:i=""
				continue:$d(mts(m,str,"MAP",i))=0
				if '$d(mt("smdimp",i))||(mt("smdimp",i)=i)
				{	if '$d(mt("smdimp",i))
					{	s $p(mts(m,str,"MAP",i),"^",3)=""	// The index template is not eligible for use as a conditional map, e.g. for 'NULL baseFld  JLF156
						s $p(mts(m,str,"MAP",i),"^",6)="T"	// Mark as a Template map
					}
					s a=""
					for
					{	s a=$o(mts(m,str,"ATT",a),1,v) q:a=""
						if (a'["_%ANYOF")
						{	s val=$p(v,"^",5),pc14=$p(ptv(val),"^",$$$PTVMAPS)
							s ch=$f(","_pc14,","_i_",") 
							s:ch>0 $e(pc14,ch-$l(i)-2,ch-2)="",$p(ptv(val),"^",$$$PTVMAPS)=pc14
						}
					}
				}
			}
		}
	}
	#; JLF015-
	#; AK420
	s ifn=""  f  s ifn=$o($$$mtVirtualOrFields(ifn)) q:'ifn  d ormap
	#; AK742
	s mt("nfo")=$$bitree("v",$g($$$mtNewVals),"f")  ;  for INSERT/UPDATE
	s mt("nfo")=$$bitree("v",$tr($g($$$mtSequencers),"d"),"f",mt("nfo"))  ;  ORDER
	#;  look in HAVING, SELECT, ORDER, GROUP of each subquery
	f m=1:1:maxm i $$$mtPQbIsActive(m),'$g($$$mtEmpty(m)) s mt("nfo")=$$bitree("l",$g($$$mtHaving(m)),"f",mt("nfo")),mt("nfo")=$$bitree("v",$$$mtOutputVals($g($$$mtOutput(m)))_$tr($g($$$mtSequencersQb(m)),"d")_$g($$$mtGroupDistinctList(m)),"f",mt("nfo"))
	#;  target rowid needed for UPDATE/DELETE
	i "DEL UPD"[$$$mtStatementType,mcurs s str=$$$ptrel($$$mtTarget),$bit(mt("nfo"),$p(mts(1,str,"ATT",$p(mts(1,str),"^",5)),"^",5))=1
	#; AK742-
	f fval=1:1:$$$maxv s v=$g(ptv(fval)) d:"f"=$p(v,"^",$$$PTVVALTYPE) att
	#;  set up mts("VOP")/nonvop=$LB(valog) (negative for conditions)  ;  AK1081
	n nonvop s nonvop="",mts("VOP")="" s call="mtsvop^%qaqpqo1"
	f val=1:1:$$$maxv d lvtree^%qaqpnl("v",val)
	f log=1:1:$$$maxl d lvtree^%qaqpnl("l",log)
	#; Build mts("AGG")
	if '$d(^ISCNoBitSliceAggs) {
		f m=1:1:maxm i $$$mtPQbIsActive(m),'$g($$$mtEmpty(m)),'$$isSharded^%qaqpnl(m) do createMtsAGG()
	}
	f str=1:1:maxs d hirar
	#; JLF013
	f str=1:1:maxs s m=$$$mtRQb($$$mtR(str)) d:(m&&($p(mts(m,str),"^",3)'="")) hirad(str,",")
	#; DPV1531
	#;  mt("queryinfo") flag determines whether or not we need Isolation Level locking in the query
	s mt("querylock")=$$tplockok()
	#; DPV1531-
	f str=1:1:maxs if '$$colopt(str) {s mt("nocolopt",str)=1}
	#; AK527
	k $$$fsave s $$$fsave="" f m=1:1:maxm f str=1:1:maxs d:$$$mtPQbIsActive(m)&&$d(mts(m,str)) fsave  ;  remove unneeded nodes
	f str=1:1:maxs d cdmap0  ;  columnar virtual map0 size  ;  AK1076
	#; AK693
	#;  list in mt("adoj") all "easy" OJ target streams (no WHERE, OJ into
	#;  rowid), use OJ conditions in linx (in reverse order of processing!)
	n ojdun s ojdun=""  ;  positioned string by str# - 3: easy, 2: hard, 1: hard (not recursed yet)
	#; AK752
	n po  ;  construct partial order of outer join targets
	f ln=1:1 s log=$p(linx,"^",ln) q:'log  s str=$$$mtV($$$mtLOperand1($$$mtL(log))) d:$e(str)="f" porder($p(str,"^",2),$p($$$mtV($$$mtLOperand2($$$mtL(log))),"^",2))
	d getpo  ;  set in po list of streams in reverse order of processing
	f ln=1:1:$ll(po) d ezoj($li(po,ln))
	#; AK752-
	MERGE mt("adoj0")=mt("adoj")  ;  for debug, since it will be removed
	s $$$mtRNumStreams=maxs
	#; AK693-
	#; AK742
	#;  remove "empty" queries from optimizer input
	f m=1:1:maxm i $$$mtPQbIsActive(m),$g($$$mtEmpty(m)) { KILL mts(m),ptj(m) s ptfjoo(m)="",ptfjoos(m)="" }
	#; AK742-
	#; AK902
	#;  remove reconstructed queries from optimizer input
	f m=1:1:maxm KILL:($g($$$mtDSNLinkedTable(m))'="" || $$isSharded^%qaqpnl(m)) ptj(m)
	#; AK902-
	f m=1:1:maxm d:$$isShardedTop^%qaqpnl(m) ojfilter(m)
	#; Save ptv array for query regeneration support
	m mt("ptv") = ptv  // At least this should NOT BE DONE unless there is some regeneration going on??!!
	s mt("nulstr")=nulstr
	#;  first list in mts("lat*") "f" nodes in TVF arguments  ;  AK1060
	d setLateralRefs^%qaqpnl  ;  PVA348  ;  call moved here from ^%qaqpnl
	#;  also analyze and list all lateral "x^NN" nodes  ;  AK850
	s call="latxf^%qaqpqo1"
	f m=1:1:maxm i $$$mtPQbIsActive(m),'$g($$$mtEmpty(m)),'($d($$$mtUnionTopQb(m),ln)&&(ln'=m)) { d lvsubquery^%qaqpag(m) }
	do:('info)&&($$$SQLCompileOption("rtpc-info-queryType")'="") isRTPCApplicable^%qaqcoutlier(0,$$$SQLCompileOption("rtpc-info-queryType"),$$$SQLCompileOption("rtpc-info-sqlvarcparm"),$$$SQLCompileOption("rtpc-info-selectMode"),.phasOutlier,.poutlier,.phasTruthValue,.ptruthValue,.phasRange,.prangeRTPC,.phasListLength,.plistLength,.phasSameVDF,.pvdfRTPC,.pvdfExist)
	do postRTPC
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
colopt(str)  ;  $$: 1 if ok to use optimizer columnar algorithms for stream str  ;  AK1081
	n m s m=$$$mtRQb($$$mtR(str))
	RETURN:m=0 0  ;  obsolete stream
	RETURN:$$$mtRNumStreams>1 0
	Return:$g($$$mtSequencersQb(m))'="" 0 ; has order by 
	Return:$g($$$mtGroupDistinctList(m)) 0 ; has group by
	Return:($$$mtPAggList($$$mtP(m))'="") 0 ; has aggregrations 
	Return:("UPD DEL INS"[$$$mtStatementType) 0
	RETURN:($g(mt("options","disable-vectorized-plan"))=1) 0
	RETURN:$$windowsInSubq^%qaqpagg(m) 0  ;  no window functions supported
	RETURN 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mtsvop	;  lvtree() call back, coming in with type,val,v,ev  ;  AK1081
	#;  populate mts("VOP")/nonvop=$LB(val/-log) whether val is
	#;  vectorized or can be used in $VOP() operations
	s lv=$e("-",type="l")_val
	#;  streamless - can be used in $VOP(), maybe using log2bm(eval)
	i "xtn"[ev { d advop(1) RETURN }
	i ev="f" {
		n m,str,ifn,con s str=$p(v,"^",2),m=$$$mtRQb($$$mtR(str)),ifn=$p(v,"^",3)
		Return:m=0 // this steam has been removed in chkremovestr^%qaqpre
		i "^"'[$p(mts(m,str,"ATT",ifn),"^",9,10) { d advop(1) RETURN }  ;  whether in a CDM/CIM, rowid, or bmCON
		d advop(0)
		RETURN
	}
	#;  agg's cannot participate in further vector op's, their arguments
	#;  are processed independently, so there is no need to recurse down
	i ev="a" { d advop(0) RETURN }  ;  aggregate
	i $p(v,"^",3)="," { d advop(1) RETURN }  ;  streamless
	i "eq"[ev { d advop(0) RETURN }  ;  extrinsic function/subquery/aggregate
	#;  "l" or "v" node
	#;  not supported unless it's one of the following operators
	i " & ! ' < '< > '> = '= NULL 'NULL IN ONEOF + - * / # \ MOD POWER _ %VHASH %SQLUPPER %UPPER %RMLSP LCASE SUBSTR SUBSTRING $EXTRACT NVL NULLIF IFNULL COALESCE FLOOR CEILING "'[(" "_$p(v,"^",2)_" "),'$$castok^%qaqpag() { d advop(0) RETURN }
	#;  SUBSTRING/SUBSTR/$EXTRACT
	#;  for now, $VOP("substring",x,y,z) only supports x as vector
	i ($e(v,1,8)="v^SUBSTR")||($e(v,1,11)="v^$EXTRACT^"),'$$nof(5)||'$$nof(6) { d advop(0) RETURN }
	n li f li=4:1:$l(v,"^")-1 { i '$lf(mts("VOP"),$e("-",ev="l")_$p(v,"^",li)) { d advop(0) RETURN } }
	d advop(1)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
advop(y)  ;  [public: lv] add lv to the correct list based on y  ;  AK1081
	i y { d addvop(lv) RETURN }
	s nonvop=nonvop_$lb(lv)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
addvop(val)  ;  mark val (possibly val=-log) as columnar  ;  AK1081
	s mts("VOP")=mts("VOP")_$lb(val)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nof(pos)  ;  [public: v, mt] $$: 1 if $P(v,pos) is streamless or it doesn't exist  ;  AK1077
	s pos=$p(v,"^",pos)
	RETURN:'pos 1
	RETURN $$isStreamless^%qaqpag(pos)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
latxf	;  lviter() call back, coming in with type,val,v,ev
	#;  also input qn=q# where this val was found
	#;  find all "x^NN" lateral field references
	#;  and populate mts(latfm,latvs,"lateral"/"lateralf")
	i ev="x",v=("x^"_+$e(v,3,*)),v'="x^0" {
		n latf,latfs,latfm,latvs
		s $LB(,latf,latfs,latfm,,latvs)=$$latxn^%qaqpre2(v,qn)
		#;  use latf,latfs,latfm,latvm,latvs to set the data structures
		s:'$lf($g(mts(latfm,latvs,"lateral")),latfs) mts(latfm,latvs,"lateral")=$g(mts(latfm,latvs,"lateral"))_$lb(latfs)
		s:'$lf($g(mts(latfm,latvs,"lateralf")),latf) mts(latfm,latvs,"lateralf")=$g(mts(latfm,latvs,"lateralf"))_$lb(latf)
		RETURN
	}
	GOTO lviterarg^%qaqpnl
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA336: ojfilter,makojfilter,makstrlist
	#; PVA342: needsOJfilter,shardentries
needsOJfilter(m) [mt] PUBLIC 
{  s ocnt="" for 
   {  s ocnt=$o($$$mtOn(m, ocnt),1,ojinfo) q:ocnt=""
      s ojop=$li(ojinfo,$$$SQLONOPERATOR)
      s lcnt=$$shardentries(m,$li(ojinfo,$$$SQLONLEFTSTREAMS)),rcnt=$$shardentries(m,$li(ojinfo,$$$SQLONRIGHTSTREAMS))
      if ojop="LEFT"
      {  if rcnt && 'lcnt {return 1}
         elseif  lcnt && rcnt && ($$shardentries(m,$li(ojinfo,$$$SQLONLEFTSTREAMS)_$li(ojinfo,$$$SQLONRIGHTSTREAMS)) > 1) {return 1}
      }
      elseif ojop="FULL"
      {  if 'lcnt && 'rcnt {} // good case
         if lcnt'=rcnt {RETURN 1}
         elseif $$shardentries(m,$li(ojinfo,$$$SQLONLEFTSTREAMS)_$li(ojinfo,$$$SQLONRIGHTSTREAMS)) '= 1 {RETURN 1}
      }
      else {} // we don't care
   }
   quit 0
}
shardentries(m,strms) [mt] PUBLIC
{  s tplcnt=0,cosh=$g(mt("cosh",m)),strms=$$makstrlist(m,strms)
   for tplent=1:1:$ll(cosh)
   {  for i=1:1:$ll($li(cosh,tplent)) 
      {  if $lf(strms,$li($li(cosh,tplent),i)) {s tplcnt=tplcnt+1 quit}
	  }
   }
   quit tplcnt
}
ojfilter(m) [mt] PUBLIC 
{   // PVA342: implement new rules for fewest possible ojfilters
	s ocnt="" f 
	{ s ocnt=$o($$$mtOn(m, ocnt),1,ojinfo) q:ocnt=""
      s ojop=$li(ojinfo,$$$SQLONOPERATOR),lstr=$li(ojinfo,$$$SQLONLEFTSTREAMS),rstr=$li(ojinfo,$$$SQLONRIGHTSTREAMS)
      s lcnt=$$shardentries(m,lstr),rcnt=$$shardentries(m,rstr)
      if ojop="LEFT"
      {  if rcnt && 'lcnt {d makojfilter(m,lstr,rstr)}
         elseif  lcnt && rcnt && ($$shardentries(m,lstr_rstr) > 1) {d makojfilter(m,lstr,rstr)}
      }
      elseif ojop="FULL"
      {  if 'lcnt && 'rcnt {} // good case
         if rcnt && 'lcnt {d makojfilter(m,lstr,rstr)}
         elseif lcnt && 'rcnt {d makojfilter(m,rstr,lstr)}
         elseif $$shardentries(m,lstr_rstr) '= 1 {d makojfilter(m,lstr,rstr),makojfilter(m,rstr,lstr)}
      }
      else {} // we don't care
	}
}
makojfilter(m,lstr,rstr) [ojfilter] PUBLIC 
{   s ojfilter(m,$$makstrlist(m,lstr))=$$makstrlist(m,rstr)
}
makstrlist(m,strnames)[$$$ptrelRoot] PUBLIc 
{   s strs="" for i=1:1:$ll(strnames)
	{  s strs=strs_$lb($$$ptrel(m_"^"_$li(strnames,i)))
	}
	QUIT strs
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK865
pushag	n supq,vid,vstr,nvf,aggs,nagg,cols,colls,li,v,val,row,unq,nuag,selst,p3,lbp3,call  ;  [public: m,mt,mts]
	s supq=+$$$mtP(m)  ;  the superquery must have ...
	RETURN:$g($$$mtWhere(supq))  ;  no WHERE clause,
	RETURN:$g($$$mtGroupDistinctList(supq))  ;  no GROUP BY clause,
	RETURN:'$g($$$mtOneRow(supq))  ;  it must be "onerow
	RETURN:$$isSharded^%qaqpnl(supq) ; it must not already be sharded condext - but good! if a union leg is shard top
	RETURN:$$numstr^%qaqpnl(supq)'=1  ;  no other streams,
	s vid=$$$mtPViewIDVal($$$mtP(m))  ;  %VID val#
	RETURN:$p(ptv(vid),"^",$$$PTVREFERENCED)  ;  cannot reference %VID
	#;  nvf - size of view SELECT-list, aggs=LIST(val,) of aggregates
	#;  nagg - number of such aggregates
	s vstr=$p($$$mtV(vid),"^",2),nvf=$ll($$$mtAlphaUpAliases(m)),aggs=$$$mtPAggList($$$mtP(supq)),nagg=$l(aggs,",")-1
	RETURN:aggs=""  ;  nothing to do???
	for li=1:1:nagg {
		set v=$$$mtV($p(aggs,",",li)),val=$p(v,"^",5)
		RETURN:$e(v,1,6)="a^udaf"	// no user-defined aggregates
		RETURN:"^"'[$p(v,"^",6,7)  ;  no agg can have DISTINCT/%FOREACH
		CONTINUE:'val  ;  COUNT(*)
		RETURN:$$$mtVType($$$mtV(val))'="f"  ;  ... or an expression argument
		#;  get aggs info: cols=$LIST(column#) of aggregate argument,
		#;  colls=$LIST(coll) to apply to that argument
		s v=$$$mtV(val) s:v["_" val=$p(mts(supq,$p(v,"^",2),"ATT",+$p(v,"^",3)),"^",5),$li(colls,li)=$p(v,"_",2)
		s $li(cols,li)=val-vid
	}
	#;  each union leg can't have any agg's, GROUP BY/DISTINCT, TOP (unless
	#;      it's "onerow")
	s row=0  ;  but they can't all be "onerow"! ???
	f unq=2:1:maxm { i $$$mtPQbIsActive(unq),$g($$$mtUnionTopQb(unq))=m {  ;  AK989
		i $g($$$mtOneRow(unq)) { s:'$g($$$mtHaving(unq)) row=1 CONTINUE }
		RETURN:$$hasPagination^%qaqpsq(unq)  ;  no UNION leg could have Pagination: TOP/LIMIT/FETCH or OFFSET, ...
		RETURN:$g($$$mtGroupDistinctList(unq))  ;   ... GROUP BY/DISTINCT, ...
		RETURN:$$$mtPAggList($$$mtP(unq))  ;  ... or any aggregates
		s row=1
	} }
	RETURN:'row
	d logopt("pushag",m)  ;  it's a go!
	#;  first modify SELECT-list of each UNION leg
	f unq=2:1:maxm { i $$$mtPQbIsActive(unq),$g($$$mtUnionTopQb(unq))=m {  ;  AK989
		s nuag="",selst=$$$mtOutputVals($$$mtOutput(unq)),lbp3=""
		f li=1:1:nagg {
			s v=$$$mtV($p(aggs,",",li))
			#;  next line not applicable to COUNT(*)
			i $p(v,"^",5) { s val=$p(selst,",",$li(cols,li)),p3=$$p3(val),$p(v,"^",5)=$$coll(val,$lg($g(colls),li),unq),$p(v,"^",3)=","_p3 s:li>=nvf lbp3=lbp3_p3 }
			i '$g($$$mtOneRow(unq)) { s val=$$$newval(v,1) }  ;  handle the strange "onerow" case
			else { s val=$s('$p(v,"^",5):$$$newval("t^1",1),1:$case($p(v,"^",2),"count":$$$newval("v^IFNULL^,"_p3_"^"_val_"^"_$$$newval("t^0",1)_"^"_$$$newval("t^1",1)_"^",1),"%dlist":$$$newval("v^IFNULL^,"_p3_"^"_val_"^"_$$$newval("t^",1)_"^"_$$$newval("v^LISTBUILD^,"_p3_"^"_val_"^",1)_"^",1),:val)) }
			s nuag=nuag_val_","
		}
		s:'$g($$$mtOneRow(unq)) $$$mtPAggList($$$mtP(unq))=nuag  ;  set of aggregates in subquery
		i nagg>nvf s $p(nuag,",",nvf,nagg)=$$$newval("v^LISTBUILD^,"_lbp3_"^"_$tr($p(nuag,",",nvf,nagg),",","^")_"^",1)
		s $$$mtOutputVals($$$mtOutput(unq))=nuag
		s $$$mtOneRow(unq)=1
		s $$$mtAlphaUpAliases(unq)=$li($$$mtAlphaUpAliases(unq),1,nagg)
	} }
	#;  adjust the field list/contents of the final aggregates
	f li=1:1:nagg s val=$p(aggs,",",li),v=$$$mtV(val),$p($$$mtV(val),"^",2,5)=$$combag($p(v,"^",2))_"^,"_$s((li<nvf)||(nagg=nvf):(vid+li)_",^^"_(vid+li),1:(vid+nvf)_",^^"_$$$newval("v^LIST^,"_(vid+nvf)_",^"_(vid+nvf)_"^"_$$$newval("t^"_(li-nvf+1),1)_"^",1))
	s call="aggp3" d lvtreep("l",$g($$$mtHaving(supq)),"")
	s selst=$$$mtOutputVals($$$mtOutput(supq))
	f li=1:1:$l(selst,",")-1 d lvtreep("v",$p(selst,",",li),"")
	s v=$$$mtV(vid)  ;  remove unused old view fields, if any
	f li=nagg+1:1:nvf s $$$mtV(vid+li)="i^pushag",$bit(mt("nfo"),vid+li)=0 KILL mts(supq,$p(v,"^",2),"ATT",$p(v,"^",3)+li),$$$mtVirf($p(v,"^",3)+li)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
coll(val0,fn,m) n v,str,ifn,val  ;  $$: fn(val0) - might already exist, might
	#;  be a field or not, for pushag MIN/MAX pushed into UNION legs
	RETURN:fn="" val0
	RETURN:$d(mt("unary",val0,fn),v) v  ;  *** but still needs to fix "nfo"
	s v=$$$mtV(val0)  ;  *** but set mt("unary")!!!
	i ($e(v)'="f")||(v["_") { Set val=$$$newval("v^"_fn_"^,"_$$p3(val0)_"^"_val0_"^",1) }
	else {
		s str=$p(v,"^",2),ifn=$p(v,"^",3)_"_"_fn
		Set val=$$$newval("f^"_str_"^"_ifn,1)
		s $p(mts(m,str,"ATT",ifn),"^",5)=val
		s ptv(val)=val_"^f^^^^"_val_",^"_m_"^"_str_"^"_ifn_"^"_$$ddfldst^%qaqpqo(str,ifn)_"^0^^"_$p(mts(m,str),"^",4)_",^1^"
	}
	d createval^%qaqpdt(val)  ;  also create a vtr entry
	s mt("unary",val0,fn)=val  ;  setup proper mt("unary") node
	RETURN val
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
combag(agg)  ;  $$: function to combine agg results from UNION/%PARALLEL/shards
	RETURN $case(agg,"count":"sum","%dlist":"xmlagg",:agg)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
p3(val)  ;  $$: LIST(fval,) of fields used by val (no recursion - $P(3) used)
	RETURN $case($$$mtVType($$$mtV(val)),"f":val_",","x":"","t":"","n":"",:$e($p($$$mtV(val),"^",3),2,*))
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
aggp3	;  called from pushag->lvtreep with type,val,v,ev,tveistack -
	#;  correct all the way up $P(3) field-lists for expressions with aggs
	#;  first, initialize parent field list (if first time through the loop)
	s:$lg(tveistack,4)=1 $p(mt($lg(tveistack,1),$lg(tveistack,2)),"^",3)=","
	GOTO lvargp:ev'="a"  ;  recurse down if THIS is not an aggregate
	#;  update field lists all the way up with new view fields info
	f lv=1:4:$ll(tveistack) s $p(mt($lg(tveistack,lv),$lg(tveistack,lv+1)),"^",3)=$p(mt($lg(tveistack,lv),$lg(tveistack,lv+1)),"^",3)_$p(v,",",2)_","
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  generic tree traversal - type="v"/"l", for each mt(type,val) node,
	#;  set v,ev and GOTO @call, which may recurse down to lvargp, tveistack
	#;  $LB(pt,pv,pe,pi,...) provides ancester information type/val/ev and
	#;  loop position lv=1:1, original caller may also provide special stack info
lvtreep(type,val,tveistack) RETURN:'val  n v,ev,lv s v=mt(type,val),ev=$e(v) GOTO @call
lvargp	;  possibly come back from 'call' to recurse down the subtree
	RETURN:"fxtqn"[ev
	i "vl"[ev { f lv=4:1:$l(v,"^")-1 { d lvtreep(ev,$p(v,"^",lv),$lb(type,val,ev,lv-3)_tveistack) } RETURN }
	i "a"=ev { s v=$p(v,"^",6)_$p(v,"^",7)_$p(v,"^",5)_"," f lv=1:1:$l(v,",")-1 { d lvtreep("v",$p(v,",",lv),$lb(type,val,ev,lv)_tveistack) } RETURN }
	i "e"=ev { s v=$p(v,"^",4) f lv=1:1:$l(v,",")-1 { d lvtreep("v",$p(v,",",lv),$lb(type,val,ev,lv)_tveistack) } RETURN }
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
logopt(name,value)  ;  record in mt("logopt")=$LB(name,val,name,val,...)
	s $$$mtLogOpt=$g($$$mtLogOpt)_$lb(name,value)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK865-
	#; AK693
ezoj(str)  ;  see if str (on right side of LOJ) is easy or hard
	QUIT:$e(ojdun,str)>1  ;  already processed
	n m,ifn,log,jalist,jointo,joinres,lstr,v
	s m=$$$mtRQb($$$mtR(str))
	#; AK861
	QUIT:'$$$mtPQbIsActive(m)  ;  abandoned linx not updated by marksqs^pre3()
	s ifn="",log="",jalist=",",jointo=",",joinres=",",lstr=""
	QUIT:$g(mt("hint",m,"%FULL"))
	#; AK787
	QUIT:$g(mt("hint",m,"%DBUGFULL"))
	QUIT:$lf($g(mts("streamorder",m)),str)  ;  join order explicitly specified
	#; AK787-
	QUIT:'$d(mt("adoj",m))&&($l($p(ptj(m,1),"^",2),",")-2<7)  ;  big join
	#;  jalist,jointo,joinres,lstr: LIST(x,) of ifns, left-values, logs,
	#;      and left-streams with OJ into str
	f  s ifn=$o(mts(m,str,"JOIN",ifn)) q:'ifn  s jalist=jalist_ifn_"," f  s log=$o(mts(m,str,"JOIN",ifn,log),1,v) q:'log  s joinres=joinres_log_",",jointo=jointo_$$$mtLOperand1($$$mtL(log))_",",lstr=lstr_$e($p(v,"^",3),2,*)
	GOTO hardoj:ptfjoos(m)[(","_str_",")  ;  in ORDER BY
	#;  check if marked before as hard, WHERE conditions, virtual stream
	GOTO hardoj:($e(ojdun,str)=1)||$d(mts(m,str,"CON"))||$d(mts(m,str,"RANGE"))||$d(mts(m,str,"COMP"))||$d(mts(m,str,"MREL"))||$d($$$mtRVirtual(str))
	GOTO hardoj:$l(jalist,",")'=$l(joinres,",")  ;  >1 condition per field
	#;  not on rowid AND not on the whole IDKEY
	GOTO hardoj:((","_$p(mts(m,str),"^",5)_",")'=jalist)&&(($l(jalist,",")'=$l($p(mts(m,str),"^",6),","))||($$removel($e(jalist,2,*),$p(mts(m,str),"^",6))'=""))
	#;  *** should be easy to also check for UNIQUE/extent map!  i.e.,
	#;      OJ conditions exactly match subscripts, or match a leading
	#;      subset of the subscripts that includes a unique key (find
	#;      smalled such map that includes all needed fields)!
	d logopt("ezoj",str)  ;  AK865
	s $e(ojdun,str)=3  ;  str is easy!
	s mt("adoj",m,str)=jalist_"^1^^"_jointo_"^"_joinres_"^^^^^^"_$p(mts(m,str),"^",4)  ;  $P(alg(i),2:12)
	f  q:'lstr  s mt("adoj",m,str,+lstr)="",$p(lstr,",",1,2)=$p(lstr,",",2)
	MERGE $$$fsave("mts",m,str)=mts(m,str) KILL mts(m,str)
	s v=$f(ptj(m,1),","_str_",",$f(ptj(m,1),"^"))-1,$e(ptj(m,1),v-$l(str),v)=""  ;  remove str from ptj(m,1)
	#;  did not remove log from mt("j"), ptj(m,1) - not used
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
hardoj	;  [public: str,lstr,ojdun] mark str as hard (2), and mark each
	s $e(ojdun,str)=2  ;  unmarked left stream as 1 to recurse later
	f  q:'lstr  s:'$e(ojdun,+lstr) $e(ojdun,+lstr)=1 s $p(lstr,",",1,2)=$p(lstr,",",2)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  $$: l1=LIST(log#,) sans conditions in l2 (same as $$remove^ag() )
removel(l1,l2) [] PUBLIC { s l2=","_l2_"," f li=1:1 { s log=$p(l1,",",li) q:log=""  i l2[(","_log_",") s $p(l1,",",li,*)=$p(l1,",",li+1,*),li=li-1 } QUIT l1 }
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK693-
	#; AK752
porder(a,b) s po(1,a,b)="",po(0,b,a)=""  ;  input - assert that a precedes b
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getpo	n a,b  ;  return po=$LIST(b) of all 2nd arguments, in reverse order,
	s po="",po(1)=""  ;  and po(1)=$LIST(a) of all 1st arguments not in po
	s a="" f  s a=$o(po(1,a)) q:a=""  s:'$d(po(0,a)) po(1)=po(1)_$lb(a)
	s b="" f  s b=$o(po(0,b)) q:b=""  i '$d(po(1,b)) s a="" f  { s a=$o(po(0,b,a)) q:a=""  KILL po(1,a,b) } KILL po(0,b) s po=po_$lb(b),b=""
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK752-
	#; AK742
bitree(type,val,evlist,bl="")  ;  $$: search subtree of mt(type,val) for
	#;  all nodes of type evlist, add them to $BIT list bl
	QUIT:val="" bl  ;  val could also be a "," or "^" list
	n li,call s call="evbitl^%qaqpqo1"
	s val=$tr(val,"^",",")
	f li=1:1:$l(val,",") d lviter^%qaqpnl(type,$p(val,",",li))
	QUIT bl
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
evbitl	;  check for 'evlist', called from listree->lvtree with type,val,v,ev
	#; check if found, but don't recurse if already listed
	i evlist[ev QUIT:$bit(bl,val)  s $bit(bl,val)=1
	i ev="q" i evlist["f" { f lv=2:1:$l(v,",")-1 s $bit(bl,$p(v,",",lv))=1 } QUIT  ; correlated fields
	GOTO lviterarg^%qaqpnl  ;  recurse down
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK742-
	#; AK527
  	#; PVA231: rewrite fsave to use ptvreference
fsave() [mt,ptv,str,m,fsave,mts] PUBLIC
	{
	if $d($$$mtRVirtual(str)) {s rid=""} else {s rid=$p(mts(m,str),"^",5)}  ;  don't remove the rowid of base tables
       s val="" f   
       {  s val=$o($$$mtV(val),1,v) q:val=""  continue:($e(v)'="f" || ($p(v,"^",2)'=str) || (rid=$p(v,"^",3)))
          if +$p(ptv(val),"^",$$$PTVREFERENCED)=0 
          {  s ifn=$p(v,"^",3)
             s $$$fsave=$$$fsave_$lb(val)
             s $$$fsave("mts",m,str,"ATT",ifn)=mts(m,str,"ATT",ifn)  
             k mts(m,str,"ATT",ifn)
          }
       }
	QUIT
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cdmap0	;  calculate virtual columnar master map size  ;  AK1076
	s v=$$$mtR(str),irn=+v,m=$p(v,"^",2)
	RETURN:(m=0)
	RETURN:'$$$mtPQbIsActive(m)
	RETURN:$g($$$mtRVirtual(str))  ;  virtual stream
	s v=mts(m,str),imp0=$p(v,"^",4),idifn=","_$p(v,"^",5)_$p(v,"^",6)_","
	n cdmf s cdmf=$$$smdMapCDMFieldList(imp0)  ;  AK1048
	RETURN:cdmf=""  ;  adjust map0 size to sum of all columnar maps used
	s mpst=0,imp=""  ;  loop over maps, find columnar fields used
	#;  *** need to account for computed fields also!  add the fields
	#;      they're based on to mts("ATT")
	f  s imp=$o(mts(m,str,"MAP",imp),1,v) q:'imp  s ifn=$p(v,"^",9) i $p(v,"^",6)="CD",($d(mts(m,str,"ATT",ifn))||(+$o(mts(m,str,"ATT",ifn_"_"))=ifn)) { s mpst=mpst+v }
	#;  add master map actual size, if has fields that are used
	f  s ifn=$o(mts(m,str,"ATT",ifn),1,v) q:'ifn  i +ifn'=$p(idifn,",",2),'$lf(cdmf,+ifn) { s mpst=mpst+mts(m,str,"MAP",imp0) QUIT }
	#;  always add EBM size
	s ($p(mts(m,str,"MAP",imp0),"^"),$p(mts(m,str),"^",2))=mpst+mts(m,str,"MAP",$$$smdBitmapExtentMap(1,irn))
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK527-
	#; DPV1531=
tplockok() [irn,mt] PUBLIC {
	#; Check to see if it is OK to use Transaction Processing Locking for SELECTs...
	#; 
	#; Locking is not permitted for the following conditions:
	#;    1) DECLARE queries with a <updatability clause> of FOR READ ONLY
	#;    2) Queries that contain aggregates
	#;    3) Queries that specify a GROUP BY clause
	#;
	QUIT:",DEC,SEL,"'[(","_$$$mtStatementType_",") 0                   // NOT a SELECT Statement
	QUIT:$$$SQLCompileOption("xDBCIsoLevel")=0 0			// SELECT xDBC Cached Query using READ_UNCOMMITTED
	QUIT:$$$SQLCompileOption("IsolationLevel")=0 0			// SELECT Cached Query using READ_UNCOMMITTED
	#; IBA017, IBA019
	If (($extract($get(%caller),1,8)="ShowPlan")||(%caller="DynamicQuery")),$$$SQLCompileOption("IsolationLevel")="",$$$SQLCompileOption("xDBCIsoLevel")="",$$$ProcessIsolationLevel=0 {QUIT 0} // The isolation level can lead to plan changes
	QUIT:$d($$$mtGroupDistinctRoot) 0                                      // GROUP BY or SELECT DISTINCT BY Specified so Don't Lock
	#; All support shared now??? QUIT:('$$$sysNEWLOCK) 0                                 // Does this system support Shared Locking? (DPV1557)
	QUIT:$$$mtKNoLockFlag($g($$$mtK))=1 0				// SELECT %NOLOCK (DPV2990)
	#; DPV3434= QUIT:$$$smdTempTableType(1,irn)="LOCAL TEMPORARY" 0	// PRIVATE TEMP TABLE (DPV2999)
	s sub="",agg=0
	f  { s sub=$o($$$mtV(sub)) q:'+sub  i $e($g($$$mtV(sub)))="a" s agg=1 q  } QUIT:agg 0   // Aggregates Found so Don't Lock
	QUIT 1      // Do the lock dance...
}
	#; DPV1531=-
    #; PVA183: Now takes query argument; modified for subqueries
ptfjoo(m) ;---------- set FJOO in ptfjoo, ptfjoos ----------
	s ptfjoo(m)=$tr($g($$$mtSequencersQb(m)),"d"),(vals,ptfjoos(m))="",(flagg)=0  ;  aggregates-flag
	#; PVA195: need #10 for $d(mt("s")) now
	if m=1,ptfjoo(1)="" s ptfjoo(1)=$tr($g($$$mtSequencers),"d") s:$d($$$mtSequencers)#10 $$$mtSequencersQb(1)=$$$mtSequencers zk $$$mtSequencers
	f li=1:1 s val=$p(ptfjoo(m),",",li) q:'val  s v=$$lflds^%qaqpnl("v",val) q:flagg  s vals=vals_v
	#; PVA068: Don't set up ptfjoo if aggregates found.
	i flagg s ptfjoo(m)="" QUIT
	#; Similarly, window functions make otherwise "interesting" orders, not.
	i +$$windowsInSubq^%qaqpagg(m) s ptfjoo(m)="" QUIT
	#; PVA068: kill $$$mtSequencers if ptfjoos would be empty. 
	QUIT:li=1  i 'vals { s ptfjoo(m)="" k $$$mtSequencersQb(m)  } else { s ptfjoo(m)=","_ptfjoo(m) }
	f li=1:1:$L(vals,",")-1 s str=$p($$$mtV($p(vals,",",li)),"^",2),$p(ptfjoos(m),"^",str)=str_","
	s ptfjoos(m)=","_$tr(ptfjoos(m),"^") ; ptfjoos is sorted and without duplicates
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
maps	;  process all maps for this stream.  ddmaps sets mname,imp,mpst,id
	new uniqueIdx set uniqueIdx=0
	s v=$$$mtR(str),irn=+v,m=$p(v,"^",2)
	#; JLF013
	QUIT:(m=0)  QUIT:'$$$mtPQbIsActive(m)
	s v=mts(m,str),imp0=$p(v,"^",4),idifn=","_$p(v,"^",5)_$p(v,"^",6)_","
	#;  setup the map for the virtual stream
	i $g($$$mtRVirtual(str)) s mts(m,str,"MAP",imp0)=100_"^"_+v,mts(m,str,"MAP",imp0,1)="0^"_$p(v,"^",5) QUIT  	// AK446=
	f  d ddmaps q:mname=""  d map
	#; AK688
	s idifn=$p(idifn,",",2),ifn=""
	#;  add a filter map for each filter adhoc computed field
	f  { s ifn=$o($$$mtFilter(ifn),1,op) q:'ifn
	#; AK895
		CONTINUE:'$d(mts(m,str,"ATT",ifn),val)  ;  not used in this stream
		s imp=$$nuimp(),mt("filterm",imp)=op
		s val=$p(val,"^",5),v=$p(ptv(val),"^",10)
		s mts(m,str,"MAP",imp)=(1.5/v)_"^"_+mts(m,str)_"^^^0^B"
		s mts(m,str,"MAP",imp,1)="2^"_ifn_"^"_v
		s mts(m,str,"MAP",imp,2)=$$idcond()  ;  maybe rowid conditions?
		s $p(ptv(val),"^",14)=$p(ptv(val),"^",14)_imp_","
		s idv=$p($g(mts(m,str,"ATT",idifn)),"^",5) s:idv $p(ptv(idv),"^",14)=$p(ptv(idv),"^",14)_imp_","
	}
	#; AK688-
	do:uniqueIdx checkUniqueCond(uniqueIdx)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK688
idcond() n imp,sub,v s imp="",sub=""  ;  look for rowid sub in other maps
	f  s imp=$o(mts(m,str,"MAP",imp)) q:imp=""  f  s sub=$o(mts(m,str,"MAP",imp,sub),1,v) q:sub=""  RETURN:$p(v,"^",2)=idifn $p(v,"^",1,3)
	RETURN "0^"_idifn_"^"_(1/mts(m,str))
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK688-
	#; JLF015
cloneMaps(m,str,mvMaps)
	#; Clone mts(m,str,"MAP",<imp>) for each %ANYOF reference
	QUIT:$$isSharded^%qaqpnl(m)
	n mv,pc14,imp,nsub,basenum,ifn,ilev,smdimp
	#;  mvMaps = $LB($LB(imp,str,basenum,baseifn),...)  ;  AK871
	#; AK794
	n id
	for mv=1:1:$ll(mvMaps) 
	{	s smdimp = $li($li(mvMaps,mv),1)		// original map template number
		continue:str'=$li($li(mvMaps,mv),2)		// only process maps for the current stream
	#; AK794
		s irn=+$$$mtR(str)
		#;    id = $c(1) pieces:
		#;            1: ifn(PID)
		#;            2: first-PID-ilev
		#;            3: last-PID-ilev 
		#;            4: PID-ordered?
		#;            5: first-RID-ilev
		#;            6: last-RID-ilev
		#;            7: RID-#levels
		#;            8: RID-ordered?
		#;            9:
		#;           10: PID-#levels
		#;           11: first-PID-without-constants
	set id=$g($$$smd(1,irn,"col",0))_$c(1)_				// piece 1
			$$$smdMapParIDStartLev(smdimp)_$c(1)_		// piece 2
			$$$smdMapParIDLastLev(smdimp)_$c(1)_		// piece 3
			$$$smdMapParIDInOrder(smdimp)_$c(1)_		// piece 4
			$$$smdMapRowIDStartLev(smdimp)_$c(1)_		// piece 5
			$$$smdMapRowIDLastLev(smdimp)_$c(1)_		// piece 6
			$$$smdMapRowIDNumLevs(smdimp)_$c(1)_		// piece 7
			$$$smdMapRowIDInOrder(smdimp)_$c(1,1)_		// piece 8
			$$$smdMapParIDLevWOCon(smdimp)_$c(1)_		// piece 10
			$$$smdMapParIDStartLevWOCon(smdimp)			// piece 11
	#; AK794-
	#; AK871
		#;  Create a separate clone of the template map smdimp for each
		#;  basenum used in the map
		#;  *** if 2 different baseifn's have %ANYOF* entries in
		#;      this map (not supported for now?), then we need
		#;      to clone it for each pair of basenum's!
		#; then rename the corresponding ifns in the cloned map
		s imp=$i($$$smd("mcnt"))	// get next unusued map number for clone map
		MERGE mts(m,str,"MAP",imp)=mts(m,str,"MAP",smdimp)
		#; PVA152: Make collection indexes moderately cheap, and 'normal' looking
		#;    Model them as an index with a relatively small number of
		#;    distinct values in relation to the cardinality of the relation,
		#;    thus size determined by relation cardinality.
		#; PVA230: Add a factor based on number of index subscripts, so a usable index with
		#;    more subscripts is considered more expensive.
		s nsub=$o(mts(m,str,"MAP",imp,""),-1) // get #subscripts, set #blocks
		s $p(mts(m,str,"MAP",imp),"^",1)=$p(mts(m,str,"MAP",imp),"^",2)*$s($p(mts(m,str,"MAP",imp),"^",6)="B":.125,1:3)*(nsub/2)\$$$DBBlockSize+1
		s mt("smdimp",imp)=smdimp
		s basenum=$li($li(mvMaps,mv),3),ifn=$li($li(mvMaps,mv),4)
		f ilev=1:1:nsub {	s val=mts(m,str,"MAP",imp,ilev)
			i val["%ANYOF",$p(val,"^",2)=ifn
			{	s sub=ilev_$c(1)_ifn_$c(1,1)_$p(val,"%",2,3)_basenum_$c(1)_$$$smdMSExpression(smdimp,ilev)
				#;  Set subscript type, selectivity in $P(1,3),
				#;  call fsub->admap to add imp to ptv(fval) 
				s mts(m,str,"MAP",imp,ilev)=$$sub
			}
		}
	#; AK802
		#;  for each non-collection ATT reference to the old map,
		#;  add a reference to imp
		s ifn=""
		f  {	s ifn=$o(mts(m,str,"ATT",ifn),1,val) q:ifn=""
			CONTINUE:ifn["_%ANYOF"  ;  because of the ifn there will always be a leading "_" before the collation name
			s val=$p(val,"^",5),pc14=$p(ptv(val),"^",$$$PTVMAPS)
			s:$f(","_pc14,","_smdimp_",") $p(ptv(val),"^",$$$PTVMAPS)=pc14_imp_","
		}
	#; AK802-
	#; AK871-
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF015-
	#; JLF359
getQualifiedNames(lblist,irn)
	new i,cl,ll,ndots,qn
	set ll=$ll(lblist)
	RETURN:ll=0 ""
	set cl=""
	for i=1:1:ll {
		set qn=$li(lblist,i), ndots=$l(qn,".")-1
		set:ndots<2 qn=$s(ndots=0:$$schemaDotTable(irn),ndots=1:$$schemaName(irn))_"."_qn
		set cl=cl_$s(i>1:",",1:"")_qn
	}
	RETURN cl
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
schemaName(irn)
	RETURN $$$smdSchema($$$smdTType(irn),irn)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
schemaDotTable(irn)
	new ttype
	set ttype = $$$smdTType(irn)
	RETURN $$$smdSchema(ttype,irn)_"."_$$$smdName(ttype,irn)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF359-
map	;
	#; JLF124
	new i,ignoreMaps,maplist
	set maplist = $$hint^%qaqpre("%IGNOREINDEX",m)
	set ignoreMaps = ","_$zcvt($$getQualifiedNames(maplist,irn),"U")_","
	if $$$smdMapIndexType(imp)="CD" {}										// Columnar Data maps should not be ignored, they are virtually part of the master map
	elseif $$$smdMapIndexType(imp)="BE",$$$smdHasColumnarMaps(1,irn) {}		// Bitmap Extent map should not be ignored if there are Columnar Data maps
	else {
		if imp'=imp0,ignoreMaps[(","_$zcvt($$schemaDotTable(irn)_"."_$$$smdMapName(imp),"U")_",") { RETURN }
		if imp'=imp0,ignoreMaps[(","_$zcvt($$schemaDotTable(irn),"U")_".*,") { RETURN }
	}
		#; JLF124-
	set mts(m,str,"MAP",imp)=mpst
	new smdimp
	set smdimp=$g(mt("smdimp",imp),imp)  ;  JLF015=
	if imp'=imp0 {
		for li=2:1 { set ifn=$p(idifn,",",li) quit:ifn=""  do fsub }
	}
	set ilev=0
	new indextype,nIfns,subIfn
	set indextype=$$$smdMapIndexType(smdimp), nIfns=0
	for ns=1:1 {
		set ilev=$o($$$smd(12,smdimp,6,ilev)) q:'ilev
		if $$$IsVectorSearchIndex(smdimp)&&($lg($$$smdMapIndexFields(smdimp))=$$$smdMSFieldName(smdimp,ilev)){
			n fakeval,vdfval,mapBlockCount,rinfo,extentSize,avgFieldLength,multiplier
			s fakeval="" 
			for {
				s fakeval=$o($$$mtVecDistFunc(fakeval),1,vdfval) 
				q:fakeval="" 
				continue:'$$$CheckVectorSearchIndexOp(indextype,$p($$$mtV(vdfval),"^",2))
				quit:$$$smdMSFieldIfn(smdimp,ilev)=$p($$$mtV($p($$$mtV(vdfval),"^",4)),"^",3)
			}
			if fakeval {
				set sub=ilev_$c(1)_$p($$$mtV(fakeval),"^",3)_$c(1)_$$$smdMSConstant(smdimp,ilev)_$c(1)_$$$smdMSFunction(smdimp,ilev)_$c(1)_$$$smdMSExpression(smdimp,ilev)
				set mts(m,str,"MAP",imp,ns)=$$sub
				set mapBlockCount=+mts(m,str,"MAP",imp)
				set extentSize=$$$smdExtentSize($$$smdTType(irn),irn)
				set avgFieldLength=$$$smdColAverageFieldSize($$$smdTType(irn),irn,$$$smdMSFieldIfn(smdimp,ilev))
				set mapBlockCount=mapBlockCount+((extentSize*$s(avgFieldLength:avgFieldLength,1:60))\$$$DBBlockSize)
				set multiplier=$$$smdColVectorLength(1,irn,$p($$$mtV($p($$$mtV(vdfval),"^",4)),"^",3))/15 // use vector_length /15 as the multiplier to the map block count of the vector search index
				set mapBlockCount=mapBlockCount*$s(multiplier<1:1,1:multiplier) 
				if $d(mts(m,str,"RANGE",$p(mts(m,str),"^",5)),rinfo) {
					set mapBlockCount=mapBlockCount/(+rinfo)
				}
				set $p(mts(m,str,"MAP",imp),"^",1)=mapBlockCount
				continue
			} else {
				kill mts(m,str,"MAP",imp)
				RETURN
			}
.
		}
		set subIfn=$$$smdMSFieldIfn(smdimp,ilev)
		set:subIfn nIfns=nIfns+1
		set sub=ilev_$c(1)_subIfn_$c(1)_$$$smdMSConstant(smdimp,ilev)_$c(1)_$$$smdMSFunction(smdimp,ilev)_$c(1)_$$$smdMSExpression(smdimp,ilev)
		set mts(m,str,"MAP",imp,ns)=$$sub
	}
	#; IBA164 only file unique index constraints when there is at least 2 fields (excluding ID)
	if nIfns>=3 {
		set:$$$smdMapUnique(imp) uniqueIdx=imp
	}
	set $p(mts(m,str,"MAP",imp),"^",5)=$$$smdMapFromThisTable(smdimp)  ;  whether from here	// AK514=
		#;  simulate rowid subscript for bitmap index *** in future add to mdd
	
	if $e(indextype)="B" { set $p(mts(m,str,"MAP",imp),"^",6)="B",sub=$c(1)_$p(idifn,",",2)_$c(1,1,1)_"{"_$p(idifn,",",2)_"}",mts(m,str,"MAP",imp,ns)=$$sub }
	elseif indextype="S" { set $p(mts(m,str,"MAP",imp),"^",6)="S",$p(mts(m,str,"MAP",imp),"^",7)=$$$smdMapBitSliceScale(smdimp),sub=$c(1)_$p(idifn,",",2)_$c(1,1,1)_"{"_$p(idifn,",",2)_"}",mts(m,str,"MAP",imp,ns)=$$sub }
	elseif indextype="C" { 
		new collation,ifn
		set $p(mts(m,str,"MAP",imp),"^",6)="CI"
			#; And also record the ifn and collation of the field for this CIM
		set ifn=$$$smdMDifn(smdimp,1)
		set collation=$$$smdMapCIMCollation(smdimp)
		set $p(mts(m,str,"MAP",imp),"^",9)=ifn_$e("_",collation'="")_collation
		i collation'="" d admap(ifn_"_"_collation)  ;  CDI on COLL(f)  ;  AK1050
	}
	elseif indextype="CD" {
		new ifn
		set $p(mts(m,str,"MAP",imp),"^",6)="CD"
			#; And also record the ifn of the field for this CDM
		set ifn=$$$smdMDifn(smdimp,1)
		set $p(mts(m,str,"MAP",imp),"^",9)=ifn
	}
	if $$$smdMapCDMFieldList(imp)'="" { set $p(mts(m,str,"MAP",imp),"^",8)=$listtostring($$$smdMapCDMFieldList(imp)) }	// Should only be defined for the mast map
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
sub()	;---------- $$:  map subscript-information as defined in QO-II
	QUIT:$p(sub,$c(1),3)'="" 1        ;  constant
	QUIT:$p(sub,$c(1),5)'?.e1"{".n1"}".e 1  ;  constant expression	// MRP466=
	#;
	#;    sub = $c(1) pieces:
	#;            1. Level#
	#;            2. Field ifn *
	#;            3. Constant *
	#;            4. Function *  Can be 'keyup' or 'exp' if it's a complex expression on 1 ifn.
	#;            5. MUMPS expression - fields represented as {ifn}
	#;          //  6. Special next subscript code? Y/N
	#;          //  7. Start value if special next
	#;          //  8. Stop value if special next
	#;          //  9. Access Type
	#;          // 10. Piece Delimiter
	#;          // 11. Null Subscript Marker (DPV1441)
	#;               5)= $c(1) Pieces:  (This entire node is done in post map processing)
	#;             -        1. Is Parent ID stored in the subscripts?  Y/N
	#;             -        2. 'ilev' that Parent ID starts
	#;             -        3. 'ilev' of last Parent ID
	#;             -        4. Is this in Parent ID order?  Y/N
	#;             -        5. 'ilev' that Row ID starts
	#;             -        6. 'ilev' of last Row ID
	#;             -        7. Number and levels of Row ID, including constants,
	#;             -           AND treating Parent ID as one subscript
	#;             -        8. Is this in Row ID order?  Y/N
	#;             -       10. Number of Parent ID levels without constants
	#;             -       11. Level that Parent ID starts without constants
	#;
	#;    id = $c(1) pieces:
	#;            1: ifn(PID)
	#;            2: first-PID-ilev
	#;            3: last-PID-ilev 
	#;            4: PID-ordered?
	#;            5: first-RID-ilev
	#;            6: last-RID-ilev
	#;            7: RID-#levels
	#;            8: RID-ordered?
	#;            9:
	#;           10: PID-#levels
	#;           11: first-PID-without-constants
	n fx,ifn s fx="",ifn=$p(sub,$c(1),2)  ;  AK871
	d:'ifn ddname  ;  check if it is a name
	#; PVA059: Restore support for expression of one field in a map subscript
	if $p(sub,$c(1),4)="exp" {
		s fx=$p(sub,$c(1),5)
		s:$p(fx,"{")_"{"_$p($p(fx,"{",2),"}")_"}"_$p(fx,"}",2)=fx ifn=$p($p(fx,"{",2),"}"),fx=$$twist^%qaqpqo(fx)  // function of single {ifn}
	}
	QUIT:'ifn $$complex(sub,m,str)  ; Check for Valid Complex Subscript...	// MRP569=
	#;---------- subscript is a field ----------
	#; ------ Process extended functions: + (P), - (M), and " " (S) ------
	s:fx="" fx=$p(sub,$c(1),4)
	#; JLF015
	i fx["_%ANYOF" { s fx=$p(fx,"_%ANYOF",1) } elseif fx["ANYOF" { s fx="" }	// so fx = collation name or "" if exact
	If fx'="" { 
		If fx["UPPER"||(fx["STRING")||(fx["ALPHAUP")||(fx["MVR")||(fx["SPACE")||(fx["PLUS")||(fx["MINUS")||(fx["TRUNCATE")||($$$ISENCODEDCOLLATE(fx)) { 
			s ifn=ifn_$s($e(fx,1,2)'="$$":"_%"_fx,1:$s(fx?1"$$"3.9A1"(":"_%"_$tr(fx,"$("),1:"_~"_fx)) 
		}
		Else { s ifn=ifn_"_~"_fx } 
	}	// DPV2839=
	#;  flag name in $p(8)
	#; JLF015
	#; Put the ifn in the form: <ifn> [_<collationFunc> [(len)]] [_%ANYOF[KEY]]
	
	if $p(sub,$c(1),4)["_%ANYOF" 				; collated ANYOF
	{ s ifn=$p(sub,$c(1),2)_$s(fx'="":"_%"_fx,1:"")_"_"_$p($p(sub,$c(1),4),"_",2) s mt("collidx",imp)="" }
	elseif $e($p(sub,$c(1),4),1,5)="ANYOF"		; exact ANYOF
	{ s ifn=$p(sub,$c(1),2)_"_%"_$p(sub,$c(1),4) s mt("collidx",imp)="" }
	else 
	{ s:$l(ifn,"_")=3 ifn = +ifn_"_"_$p(ifn,"_",3)_"_"_$p(ifn,"_",2) }	// can we make this uniform rather than fixing it here?
	
	#; JLF015-
	#; JLF001
	s idsub="^"_$s(ilev&&(ilev=$p(id,$c(1),5)):$p(id,$c(1),7)_"^"_($p(id,$c(1),8)="Y"*2),1:"^")_"^"_$p(ifn,"_",2,*)_$S($p(sub,$c(1),3):"^^1",1:"")
	#;  check if this starts the ParentID, flag in $p(2) for type=4
	#; RLL546+  be sure not to inherit function from a higher subscript level
	s:ilev&&(ilev=$p(id,$c(1),2)) ifn=+id,$p(id,$c(1),2)=$s(ilev&&(ilev)=$p(id,$c(1),3):0,"N"=$p(id,$c(1),4):$p(id,$c(1),3),1:0),ilev=$p(id,$c(1),3),$p(idsub,"^",4)=""
	#;  list map for ifn (side effect), except for map0 and RID fields
	d:imp'=imp0&&(idifn'[(","_+ifn_",")) fsub
	s val=$p($g(mts(m,str,"ATT",ifn)),"^",5),idsub="^"_+ifn_"^"_$p($g(ptv(+val)),"^",$$$PTVCONEQLSEL)_idsub
	QUIT:val&&($$nogood(ifn,imp,val)) 0_idsub  ;  DPV700  Should we not be using this map?
		#;  *** Indeed if $$nogood we should back out of this map - currently the map is still being used  ;  AK368
		#;      Ideally the whole map should be "approved" before we even start tag map, as we do with conditional maps
	QUIT:val&&($$good(ifn)) $s(ifn["_":5,ilev&&(ilev=$p(id,$c(1),2)):4,1:2)_idsub
		#;  type=5:  sub=fun(f), but good condition on f
		#; PVA152: Don'd adjust collection selectivity by 1.2
	i ifn["_",$$good(+ifn) s:'val $p(idsub,"^",3)=$p(ptv($p(mts(m,str,"ATT",+ifn),"^",5)),"^",$$$PTVCONEQLSEL)*$s(ifn["%ANYOF":1,1:1.2) QUIT 5_idsub
		#;  sub is usefull only if sort or complex condition on
		#; field (*** also if any cond on sub=fun(f) ?)
		#;  *** should realy check for COMP only, not COMP/MREL
		#;  PVA183: ptfjoo(m)
	QUIT $s('val:0,ptfjoo(m)[(","_val_","):6,$p(ptv(val),"^",$$$PTVLOGREFS):6,1:0)_idsub
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
good(ifn) [m,mts,str] PUBLIC {
	#;  whether there is a JOIN/CONST/RANGE on this ifn
	QUIT:$d(mts(m,str,"JOIN",ifn)) 1 QUIT:$d(mts(m,str,"CON",ifn)) 1 QUIT $d(mts(m,str,"RANGE",ifn))
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; DPV700
nogood(ifn,imp,val) ;
	#;  $$nogood function determines whether this map can be used or not.
	#;  We cannot use this map if the map.MapPopulateType field is
	#;  Non-NULL, and the subscripted field is not required, and
	#;  one of the following are true:
	#;      There is No WHERE condition on the field
	#;      The WHERE condition on the field is IS NULL
	#;      The WHERE condition on the field is = ''
	#;
	#;  Special note:  Terry wants the following condition to be allowed
	#;                 on Non-NULL maps.  Thus, I have made it so.
	#;                     The WHERE condition on the field is = :var
	#;
	#;  0 is returned if we can use the map
	#;  1 is returned if we cannot use the map
	#;
	#;  ifn is the subscript field's ifn
	#;  imp is the map id of the map in question
	#;  val is the field's val number for $$$mtV(val)
	#;
	QUIT:'$g(ifn)||'$g(imp) 0 		// Safeguards
	#; JLF015
	QUIT:((imp=smdimp)&&$d(mt("collidx",imp))) 1	// Template for a collection index is never good to use
	QUIT:$d(mt("smdimp",imp)) 0						// Always pass a real (cloned) collection index (for now)
	#; JLF127
	QUIT:ifn["%ANYOF"&&'$d(mt("collidx",imp)) 1	// 
	QUIT:$$$smdMapPopulateType(smdimp)'=0 0 		// Map is not Non-NULL
	#; JLF015-
	n irn s irn=$$$smdGetIrnFromIfn(ifn)		// Field table's ID
	QUIT:'irn 0 					// Possible???
	QUIT:$$$smdColRequired(1,irn,ifn)="Y" 0  	// Required Field
	#;
	#; OK, now we gotta check out conditions on the field
	#;
	n stopcond s stopcond=0
	i $d(mts(m,str,"CON",ifn)) d  QUIT:stopcond 1  ;Check CONditions
	. n i,log,loginfo,loglist
	. s loglist=$p(mts(m,str,"CON",ifn),"^",2)
	. f i=2:1 s log=$p(loglist,",",i) q:log=""  i $$chklog($$$mtL(log)) s stopcond=1 q
	; *** Need to check out functions on fields in range (%ALPHAUP)
	i $d(mts(m,str,"RANGE",ifn)) QUIT 0            ; RANGE Conds are OK
	i $d(mts(m,str,"COMP")) d  QUIT stopcond       ; Chk out COMPlex conds
	. n log s log=""
	. f  s log=$o(mts(m,str,"COMP",log)) q:log=""  i $$chklog($$$mtL(log)) s stopcond=1 q
	QUIT 1                                         ;Can't use it
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
chklog(loginfo) ;
	#;  Given the log entry data for a log node in mt("l"), determine
	#;  if the condition is a comparison against NULL, '', or a host
	#;  variable.  This function may be called recursively since a log
	#;  entry may reference other logical conditions.
	#;
	#;  Parameters:
	#;     loginfo:  data from $$$mtL(log)
	#;     val:      Value in $$$mtV(val) possibly compared to NULL
	#;
	#;  Returns:
	#;     Positive Integer:  If field <val> is possibly compared
	#;                        with a NULL value
	#;     0:  Otherwise
	#;
	#;  Globally Scoped Variables:
	#;     mt():  Parse Tree
	#;
	#;------------------------------------------------------------
	n quitval
	s quitval=0
	#;  this Recursive Call accounts for unary or binary logical operation  ;  AK368
	i $e(loginfo)="l" QUIT:$$chklog($$$mtL($p(loginfo,"^",4))) 1 QUIT:$l(loginfo,"^")=5 0 QUIT $$chklog($$$mtL($p(loginfo,"^",5)))
	i $p(loginfo,"^",2)="NULL" QUIT 1           ;Fld IS NULL
	i $p(loginfo,"^",2)="=" d  QUIT quitval     ;Fld = ??? Condition
	#;--- Check for Fld = '' or '' = Fld
	. i $g($$$mtV($p(loginfo,"^",4)))="t^" s quitval=1 q
	. i $g($$$mtV($p(loginfo,"^",5)))="t^" s quitval=1 q
	#;--- Check for Fld = :var or :var = Fld, OK according to Terry
	. i $e($g($$$mtV($p(loginfo,"^",4))))="x" s quitval=0 q
	. i $e($g($$$mtV($p(loginfo,"^",5))))="x" s quitval=0 q
	i $p(loginfo,"^",2)="'=" d  QUIT quitval     ;Fld NOT= ??? Condition
	. q:$g($$$mtV($p(loginfo,"^",4)))="t^"     ; Fld NOT= '' is OK
	. q:$g($$$mtV($p(loginfo,"^",5)))="t^"     ; '' NOT= Fld is OK
	. s quitval=1                                ; None other are valid
	QUIT 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; DPV700-
fsub	;  if sub=f, then fun(f) can also be gotten
	#;  fix collations  ;  DPV1006;DPV1151;AK403
	i ifn["_" d admap(ifn) QUIT  ;  *** could actually do better than that!	// AK421
	n ifnloop s ifnloop="" f  s ifnloop=$o(mts(m,str,"ATT",ifnloop)) q:ifnloop=""  d:+ifnloop=ifn admap(ifnloop)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK403
admap(ifn)  ;  if ifn used, mark it as available from this map (imp)
	#; JLF015
	RETURN:$$$IsVectorSearchIndex(imp) 
	s val=$p($g(mts(m,str,"ATT",ifn)),"^",5) i val $$$aptv(val,$$$PTVMAPS,imp_",") QUIT
	QUIT:ifn'["_%ANYOF"
	n attrIfn,vals s attrIfn=ifn
	for
	{	s attrIfn = $o(mts(m,str,"ATT",attrIfn),1,val)
	#; AK871
		s vals=$p(attrIfn,ifn,2)  ;  basenum of this mts("ATT") entry
		QUIT:'vals  ;  done with all basenums for the given ifn
		CONTINUE:$d(mt("forallval",+$p(val,"^",5)))  ;  No index support for NOT ANYOFAND == NOT FOR SOME %ELEMENT
		#;  mvMaps = $LB($LB(imp,str,basenum,baseifn),...) ,
		#;  but no more than one entry for each <basenum,baseifn>
		s vals=$lb(imp,str,vals,+ifn)
		s:'$lf(mvMaps,vals) mvMaps=mvMaps_$lb(vals)
	#; AK871-
	}
	#; JLF015-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK403-
att	s m=$p(v,"^",$$$PTVQB),str=$p(v,"^",$$$PTVSTR),ifn=$p(v,"^",$$$PTVIFN)
	QUIT:$d(mts(m,str))=0
	i $p(mts(m,str),"^",5)'=+ifn,$p(mts(m,str),"^",6)'[(","_+ifn_","),ifn'["_%ANYOF" $$$aptv(fval,$$$PTVMAPS,$$ddfmap(+$$$mtR(str),+ifn)) s v=ptv(fval)  ;  RID and components set in `map'
	#; AK742
	s $p(v,"^",$$$PTVNEEDEDFOROUTPUT)='$bit(mt("nfo"),fval)
	s mts(m,str,"ATT",ifn)=$S('$p(v,"^",$$$PTVNEEDEDFOROUTPUT):"0^",'$p(v,"^",$$$PTVOJSTR):"1^",ifn["%ANY":"1^",1:"2^"_$$sort($p(v,"^",$$$PTVOJSTR),str))_"^"_$S($p(v,"^",$$$PTVLOGREFS):","_$p(v,"^",$$$PTVLOGREFS),1:"")_"^"_$p(v,"^",$$$PTVLENGTH)_"^"_fval_"^"_$p(v,"^",$$$PTVCONEQLSEL)_"^,"_$p(v,"^",$$$PTVMAPS)
	n avgFieldLength s avgFieldLength = "" 
	s:($$$smdGetIrnFromIfn(+ifn)'="") avgFieldLength = $$$smdColAverageFieldSize(1,$$$smdGetIrnFromIfn(+ifn),+ifn)
	s:'$p(v,"^",$$$PTVLENGTH) $p(mts(m,str,"ATT",ifn),"^",4)=$s(avgFieldLength>110:avgFieldLength,1:512)
	s $p(mts(m,str,"ATT",ifn),"^",8)=avgFieldLength_"^"_$$cdmf(ifn,fval)_"^"_$$bmconmf(ifn,fval)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cdmf(ifn,fval="")  ;  $$: CDM for field <m,str,ifn,fval>, if any  ;  AK1055
	n limp,col,con,li,imp,subs s limp=$$$smdBitmapExtentMap(1,+$$$mtR(str))  ;  EBM
	RETURN:'$d(mts(m,str,"MAP",+limp)) ""  ;  no EBM, no columnar!  ;  AK1080
	RETURN:$p(mts(m,str),"^",5)=ifn limp  ;  for %ID, could use $VOP("position",EBM)
	#;  ;  limp=LIST(imp,) for this field
	s limp=$p($g(ptv(+fval)),"^",$$$PTVMAPS),col=$$$smdGetIcolFromIfn(+ifn)  
	#;  skip the first element - it is always the master map
	f li=2:1:$l(limp,",")-1 s imp=$p(limp,",",li) RETURN:$p(mts(m,str,"MAP",imp),"^",9)=ifn imp
	#;  if list of maps not available for some reason, look at all maps
	i 'limp { s li="" f  s li=$o(mts(m,str,"MAP",li),1,limp) QUIT:'li  RETURN:$p(limp,"^",9)=ifn li }
	RETURN:ifn'["_" ""  ;  no CDM found for this (uncollated) field
	RETURN $$cdmf(+ifn,fval)  ;  maybe there's a CDM for the uncollated field 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
bmconmf(ifn,fval="")  ;  $$: BMCON bitmap for field <m,str,ifn,fval>, if any  ;  AK1081
	n limp,col,con,li,imp,subs,val,v,badExpr s limp=$$$smdBitmapExtentMap(1,+$$$mtR(str))  ;  EBM
	RETURN:'$d(mts(m,str,"MAP",+limp)) ""  ;  no EBM, no BMCON!  ;  AK1080
	#;  ;  limp=LIST(imp,) for this field
	s limp=$p($g(ptv(+fval)),"^",$$$PTVMAPS),col=$$$smdGetIcolFromIfn(+ifn)  
	#;  maybe has a CON condition AND a bitmap (bmCON) (if not virtual)
	i col,$d(mts(m,str,"CON",ifn),con),'$p(con,"^",4) {
		f li=2:1:$l(limp,",")-1 {
			s imp=$p(limp,",",li),badExpr=0
			CONTINUE:$g(mt("smdimp",imp)) ; Skip cloned map
			i $p(mts(m,str,"MAP",imp),"^",6)="B" {
				CONTINUE:($d($$$smd(12,imp))=0) ; skip if we have no dictionary info to use
				s subs=$p($$$smdMapCompiledTopLevelPieces(imp),$c(1))
				i $l(subs,"%d(")=2,subs[($s(ifn["_":"$$"_$p(ifn,"_%",2)_"(",1:"")_"%d("_col_")") {
					f val=1:1:$$$maxv {s v=$$$mtV(val) if $p(v,"^",3)[(","_fval_","),$e(v)="v" {s badExpr=1 QUIT }}
					CONTINUE:badExpr
					s $p(mts(m,str,"MAP",imp),"^",10)=ifn,mt("bmcon")=$g(mt("bmcon"))_$lb("F"_fval,"M"_imp,"L"_$p(con,",",2))
					s $p(mts(m,str,"CON",ifn),"^",8)=imp
					RETURN imp
				}
			}
		}
	}
	RETURN ""
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
hirar	;  [public: str] find map0 hierarchies
	QUIT:$g($$$mtRVirtual(str))  ;  virtual stream	// AK446
	s v=$$$mtR(str),m=$p(v,"^",2)
	QUIT:$$isSharded^%qaqpnl(m)
	#; JLF013
	QUIT:m=0
	s sinfo=mts(m,str),pimp0=$$$smdMapParentMapUnder($p(sinfo,"^",4))
	QUIT:'pimp0  ;  pimp0 = map0 of parent that contains our map0, if exists
	s idi=$g($$$smd(1,+v,"col",0)),idv=$p($g(mts(m,str,"ATT",idi)),"^",5)
	QUIT:'idv
	f pstr=1:1:maxs d:pimp0=$p($g(mts(m,pstr)),"^",4) parnt  // DPV1690 - add $Get() arounf mts() reference
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
parnt	s pidi=$p(mts(m,pstr),"^",5),pidv=$p($g(mts(m,pstr,"ATT",pidi)),"^",5) q:'pidv	// Added $g - JLF050
	s log=$o(mts(m,str,"JOIN",idi,"")),plog=$o(mts(m,pstr,"JOIN",pidi,""))
	QUIT:log_plog=""  ;3 `good' cases: pid=id, pid-leftj-id, id-leftj-pid
	i +ptv(pidv)'=+$g(ptv(idv)),'$p($g(mts(m,str,"JOIN",idi,+log)),"^",4),"1^,"_idv_","'=$p($g(mts(m,pstr,"JOIN",pidi,+plog)),"^",4,5) q
	d:+$g(mts(m,pstr))*2.5>$p(sinfo,"^",2) hirad(pstr,","_str),hirad(str,","_pstr)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
hirad(str,x) ;---------- append x to hierarchies of str ----------
	s $p(mts(m,str),"^",3)=$p(mts(m,str),"^",3)_x
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK420
orlog	n dlist,lflist,jj,lf,lstr,hasvstr  ;  apply OR optimization for (f=? OR g=?) - generate virtual
	#;  field <f,g>, a virtual "CON"/"JOIN" condition, and a virtual index
	s dlist=$$orleaf(log)  ;  get list of OR leafs
	QUIT:$li(dlist)=log  ;  it's not OR at all
	#;  each leaf must be of the form (f IS NULL) | (f=<expr>)
	#;  possibly with [ AND ... ] , e.g. 'AND (f IS NOT NULL)'
	s lflist=""
	f jj=1:1:$ll(dlist) s lf=$$andfeq($li(dlist,jj)) QUIT:lf=""  s lflist=lflist_$lb(lf)
	QUIT:lf=""  ;  one of the terms did not work
	#; AK465
	d orowid(lflist)  ;  OR on rowid/components - report only the master map
	#; PVA34AK556
	#;  Ignore single stream conditions as PVA34 machinery handles these now
	s vals=$$$mtLColVals($$$mtL(log)) d strval(vals)
	QUIT:2'<$l(sl,",")
	#; PVA34AK556-
	#; PVA117: skip if OR refers to any virtual streams
	s hasvstr=0 for jj=1:1:$l(sl,"^") if +$p(sl,"^",jj) s:$d($$$mtRVirtual(+$p(sl,"^",jj))) hasvstr=1
	QUIT:hasvstr
	d ortry(lflist,"")  ;  recurse over all combinations from 1:nn to find one or more candidates
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK465
orowid(lflist) n str,v,imp0,idifn,based,jj,type  ;  [public: m] set onemap(str) to the master map if
		#;  found OR=const on rowid/components
	s str=$p($$$mtV($li($li(lflist),2)),"^",2),v=mts(m,str),imp0=$p(v,"^",4),idifn=$p(v,"^",5),based=$p(v,"^",6)
		#;  change based from ifn's to val#
	f jj=2:1:$l(based,",")-1 s $p(based,",",jj)=$p($g(mts(m,str,"ATT",$p(based,",",jj))),"^",5)
	#; AK681
	s idifn=$p($g(mts(m,str,"ATT",idifn)),"^",5)
	s type=$s(based="":"id",1:"")  ;  whether based or rowid itself
	f  QUIT:'$$andid($li(lflist))  s $li(lflist,1,1)="" QUIT:lflist=""
	s:lflist="" onemap(str)=imp0  ;  all OR terms qualified
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
andid(lfli) n lf,jj  ;  $$: 1 if fields listed in lfli properly cover the
	#;  rowid (type="id") or the based-on fields (type="based")
	s lf=""  ;  list of qualifying fields
	f  q:lfli=""  s ptlg=$$$mtL($li(lfli)),$li(lfli,1,2)="" i $e(ptlg,1,4)="v^=^",$$lflds^%qaqpnl("v",$p(ptlg,"^",5))="" s lf=lf_$lb($p(ptlg,"^",4))
	#;  first see if the rowid is listed there
	i $lf(lf,idifn) QUIT:type="based" 0 s type="id" QUIT 1
	QUIT:type="id" 0  ;  did not fine the rowid
	s type="based"
	f jj=$l(based,",")-1:-1:1 QUIT:'$lf(lf,$p(based,",",jj))
	QUIT jj=1  ;  all the based-on fields were found in lf
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK465-
ortry(lflist,lfnn) n lfli  ;  try all possibilities for the next level
	#;  of lflist, append to lfnn and recurse up to nn
	#; AK434
ortrytail  ;  come in here for the last lfli pair, instead of the tail recursion
	i lflist="" d orproc(lfnn) QUIT  ;  recursion bottom - process it
	s lfli=$li(lflist),$li(lflist,1,1)=""  ;  lfli = pairs of log,fld
	#; AK442
	#;  if any lfli vals are already in lfnn, then use only them!
	s lf="",log=0  ;  list in lf all fields in previous levels
	f jj=1:1:$ll(lfnn) s val=$li($li(lfnn,jj),2) s:'$lf(lf,val) lf=lf_$lb(val)
	#;  flag in log whether any of those fields are in lfli
	i lf'="" f jj=2:2:$ll(lfli) i $lf(lf,$li(lfli,jj)) s log=1 q
	#;  if found such fields, then remove all other ones from lfli!
	i log f jj=$ll(lfli):-2:2 s:'$lf(lf,$li(lfli,jj)) $li(lfli,jj-1,jj)=""
	#; AK442-
	#;  try each possiblitly on this level, and recurse to next level,
	#;  but all have to be in the same stream lstr
	#; AK434
	#;  for last <log,val> pair in lfli, don't recurse, just jump to top
	f  QUIT:lfli=""  s log=$li(lfli),val=$li(lfli,2),log=$lb($lb(log,val)),val=$p($$$mtV(val),"^",2),$li(lfli,1,2)="" s:lfnn="" lstr=val i lstr=val d:lfli'="" ortry(lflist,lfnn_log) i lfli="" s lfnn=lfnn_log GOTO ortrytail
	#; AK434-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
orproc(lfnn)  ;  process lfnn, which is nn pairs <log,fld>, all in lstr
	#;  lfld - $list of distinct fields, loth - list^ of right-sides
	n lfld,loth,lothf,vifn,vf,vr,vc s lfld="",loth="",lothf="",vr=""
	f jj=1:1:$ll(lfnn) s val=$li(lfnn,jj),log=$li(val),val=$li(val,2) s:'$lf(lfld,val) lfld=lfld_$lb(val) s ptlg=$$$mtL(log),val=$s(ptlg["NULL":"",val=$p(ptlg,"^",4):$p(ptlg,"^",5),1:$p(ptlg,"^",4)),loth=loth_$lb(val) s:val vr=vr_val_"^"
	i $ll(lfld)=1 QUIT  ;  *** Case B - not handled yet, use old opt!
	#;  now get list of fields, streams for loth
	s lothf=$$lflds^%qaqpnl("v",vr) d strval(","_lothf)  ;  set stvl/sl for the right side
	QUIT:$p(sl,"^",lstr)  ;  fields from the left table are on the right
	d logopt("orlog",lstr)  ;  add a new virtual field for the left side
	s vifn=$$nuifn(),$$$mtVirtualOrFields(vifn)=$lb(lfnn,lfld,loth,m,lstr,$tr(sl,"^"))
	s vf=$$nufld^%qaqpqo(lstr,vifn),$p(ptv(vf),"^",$$$PTVREFERENCED)=1,vr=$$$newval("v^%VR^,"_lothf_"^"_vr,1) d setxpr(vr)
	#;  add a new virtual condition
	d nulog^%qaqpnl("v^%VC^,"_vf_","_lothf_"^"_vf_"^"_vr) s vc=log
	d complexlog^%qaqpnl(m,log)
	s $p(ptl,"^",log)=$s(lothf="":"c",1:"x"),$$$mtVirtualOrFields(vifn)=$$$mtVirtualOrFields(vifn)_$lb(vf,vr,vc)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ormap	n vor,lfld,jj,subds  ;  generate maps, if any, for virtual field ifn
	s vor=$$$mtVirtualOrFields(ifn),lfld=$li(vor,2),m=$li(vor,4),str=$li(vor,5)
	f jj=1:1:$ll(lfld) s $li(lfld,jj)=$p($$$mtV($li(lfld,jj)),"^",3)  ;  change to ifn's
	d ormtry(lfld,"","")  ;  recurse from 1:$ll(lfld) over all maps
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ormtry(orf,lmap,pre) n lifn,imp,subs,subi,subd,sifn  ;  try all maps for the first
	#;  field in orf, append to lmap, build pre, and recurse up to nn
	i orf="" d ormproc(lmap,pre) QUIT  ;  recursion bottom - process it
	s lifn=$li(orf),$li(orf,1,1)=""  ;  field for this level
	#;  try each map for this field, and recurse to next level,
	s imp=""  ;  but cannot have other fields from lfld
	f  s imp=$o(mts(m,str,"MAP",imp)) q:'imp  s subs="" f subi=1:1 s subd=$g(mts(m,str,"MAP",imp,subi)) q:subd=""  i +subd'=1 s sifn=$p(subd,"^",2) q:'sifn  s:$p(subd,"^",6)'="" sifn=sifn_"_"_$p(subd,"^",6) s $p(subd,"^",4,5)="^" d:sifn=lifn ormtry(orf,lmap_$lb(imp),subs):(lmap="")!(subs=pre) q:$lf(lfld,sifn)  s subs=subs_$lb(sifn),$li(subds,$ll(subs))=subd
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ormproc(lmap,subs) n imp  ;  add a new virtual map based on the maps
	#;  in lmap, with subscripts <pre,vf>
	s imp=$$nuimp(),$$$mtVirtualOrMaps(imp)=$lb(ifn,lmap,subs,m,str)
	s mts(m,str,"MAP",imp)=mts(m,str,"MAP",$li(lmap))  ;  shamelessly copy from the first map
	s subs=subs_$lb(ifn)  ;  now it lists all the ifn's
	s $li(subds,$ll(subs))="2^"_ifn_"^"_$p(ptv($li(vor,7)),"^",$$$PTVCONEQLSEL)_"^^^"
	n ifn  ;  setup subscripts, also mark all the fields as "being in this map"
	f jj=1:1:$ll(subs) s mts(m,str,"MAP",imp,jj)=$li(subds,jj),ifn=$li(subs,jj) d fsub
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
orleaf(log)  ;  $$:  $lb(logs) which are OR leafs.  log may be a $p("^") list
	#; AK434
orleaftail  ;  come in here if it's OR, instead of the tail recursion
	QUIT:$p(log,"^",2)'="" $$orleaf(+log)_$$orleaf($p(log,"^",2,*))
	s ptlg=$$$mtL(+log)
	#; AK434
	#;  if OR, don't recurse, just jump to top
	i $p(ptlg,"^",2)="!" s log=$p(ptlg,"^",4,*) GOTO orleaftail
	#; AK434-
	QUIT $lb(+log)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
andfeq(log) [mt,ptlg] PUBLIC {  ;  $$:  $lb(log,f,log,f,...) , each pair is
	#;  an AND-leaf of log of either form:  (f IS NULL) | (f=<expr>)
andfeqtail  ;  AK1030
	#;  QUIT:$p(log,"^",2)'="" $$andfeq(+log)_$$andfeq($p(log,"^",2,*))
	i $p(log,"^",2)'="" { s ptlg=$$andfeq(+log) RETURN:ptlg'="" ptlg_$$andfeq($p(log,"^",2,$$$MaxStringLength)) s log=$p(log,"^",2,$$$MaxStringLength) GOTO andfeqtail }
	s ptlg=$$$mtL(+log)  ;  if AND, recurse to leaves
	#;  QUIT:$p(ptlg,"^",2)="&" $$andfeq($p(ptlg,"^",4,*))
	i $p(ptlg,"^",2)="&" { s log=$p(ptlg,"^",4,$$$MaxStringLength) GOTO andfeqtail }
		#;  check if log is  (f IS NULL)
	QUIT:$e(ptlg,1,7)="v^NULL^" $$itsafld(+log,$p(ptlg,"^",4))
		#;  check if log is  (f=<expr>)  (both directions)
	QUIT:$e(ptlg,1,4)="v^=^" $$itsafld(+log,$p(ptlg,"^",4))_$$itsafld(+log,$p(ptlg,"^",5))
	QUIT ""
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  $$:  $lb(log,fld) if it's a field, "" otherwise
itsafld(log,fld) [mt] PUBLIC { QUIT:$$$mtLColVals($$$mtL(log))[(","_fld_",") $lb(log,fld) QUIT "" }
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK688
nuifn() PUBLIC { QUIT $i($$$smd("fcnt")) }  ;  $$: new unused ifn, for virtual field
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nuimp() PUBLIC { QUIT $i($$$smd("mcnt")) }  ;  $$: new unused imp, for virtual map
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nuirn() PUBLIC { QUIT $i($$$smd("tcnt")) }  ;  $$: new unused irn, for virtual table
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK688-
setxpr(val) [m,ptv] PUBLIC { s ptv(val)=val_"^e^^^^"_val_",^"_m  QUIT  } ;  set ptv() to "e"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK420-
	;---------- DATA DICTIONARY ACCESS ----------
ddmaps	;  $o-loop thru map `Map-Name' for given irn
	f  s mname=$o($$$smd(1,irn,"map",mname)) q:mname=""  s imp=$o($$$smd(1,irn,"map",mname,"")) q:imp
	QUIT:mname=""
	#;  return mname,imp, node->$$^%qaqpcmp, id->$$sub, 
	#; C.Pid added to id, mpst->map
		#;    id = $c(1) pieces:
		#;            1: ifn(PID)
		#;            2: first-PID-ilev
		#;            3: last-PID-ilev 
		#;            4: PID-ordered?
		#;            5: first-RID-ilev
		#;            6: last-RID-ilev
		#;            7: RID-#levels
		#;            8: RID-ordered?
		#;            9:
		#;           10: PID-#levels
		#;           11: first-PID-without-constants
	set id=$g($$$smd(1,irn,"col",0))_$c(1)_			// piece 1
			$$$smdMapParIDStartLev(imp)_$c(1)_		// piece 2
			$$$smdMapParIDLastLev(imp)_$c(1)_		// piece 3
			$$$smdMapParIDInOrder(imp)_$c(1)_		// piece 4
			$$$smdMapRowIDStartLev(imp)_$c(1)_		// piece 5
			$$$smdMapRowIDLastLev(imp)_$c(1)_		// piece 6
			$$$smdMapRowIDNumLevs(imp)_$c(1)_		// piece 7
			$$$smdMapRowIDInOrder(imp)_$c(1,1)_		// piece 8
			$$$smdMapParIDLevWOCon(imp)_$c(1)_		// piece 10
			$$$smdMapParIDStartLevWOCon(imp)		// piece 11
.
	#;  skip index maps iff %MasterMapOnly="%%%~~~BuildPurgeIndices~~~%%%"				// DPV2326=
	GOTO:$g(%MasterMapOnly)="%%%~~~BuildPurgeIndices~~~%%%"&&($$$smdMapMaster(imp)'="Y") ddmaps		// DPV2236=
	if $$$smdMapMaster(imp)'="Y" {
			#; If this is not the master map, skip any maps that are defined as not selectable ($SYSTEM.SQL.SetMapSelectability())
			#;  ^rINDEXSQL("MS",...) is current setting.  ^oddSQL(schema,table,"MS") is the old setting, but might be defined from a prior version before upgrade
		if $d(^rINDEXEXT("MS",$$$smdSchema(1,irn),$$$smdName(1,irn),mname))||($d(^oddSQL($$$smdSchema(1,irn),$$$smdName(1,irn),"MS",mname,$namespace))) {
					#; However, we need to report an error if a Columnar Data Map is defined as selectable
					#; Unless WE set it as not selectable b/c we're convert columns to columnar storage
				if $$$smdMapIndexType(imp)="CD",'$$$smdMapConversionTarget(imp) { 
					new %map,%table set %map=mname,%table=$$$smdSchema(1,irn)_"."_$$$smdName(1,irn) do error(156) 
				}
					#; Or if this is the BME index and the table has Columnar maps
				if $$$smdHasColumnarMaps(1,irn),$$$smdMapIndexType(imp)="BE" { new %map,%table set %map=mname,%table=$$$smdSchema(1,irn)_"."_$$$smdName(1,irn) do error(156) }
			goto ddmaps
		}
	}
	#;  skip inherited extent bitmap
	GOTO:$$$smdMapIndexType(imp)="BE"&&('$$$smdMapFromThisTable(imp)) ddmaps 	// AK514=
	#;---------- map statistics:  #blocks ^ #tuples ----------
	s mpst=$$$default($$$smdMapNumberOfBlocks(imp),100)_"^"_+mts(m,str)
	QUIT:"Y"=$$$smdMapMaster(imp)            ;  map 0 - not a conditional map
	#; i $g($$$mtStatementType)="UPD",$$setindx^%qaqpqo2(imp) g ddmaps ; Make sure SET <field> not on Index  ;  MRP535;  removed by AK680
	GOTO:$g(onemap(str))&&(imp'=onemap(str)) ddmaps  ;  skip this map AK465=
	QUIT:"N"[$$$smdMapConditional(imp)  	// not a conditional map
	#; DPV2060 - I Don't think we ever set this to "Never"???  g ddmaps:$p(node,V,2)="Never"  ;  never use this map
	g ddmaps:'$$^%qaqpcmp(imp)          ;  test conditional map, set list
	s $p(mpst,"^",2)=$p(mpst,"^",2)*$$$default($$$smdMapConditionalPercent(imp),1)_"^"_$s(list:","_list,1:"")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddname	n cat,exp,fx,ifname,nilev
	s exp=$tr($p(sub,V,5),"p","P")
	QUIT:$tr($e(exp,1,3),"P","p")'="$p("
	s exp=$e(exp,4,*),ifname=+$p(exp,"{",2)
	s cat=$$GetFieldCategory^%qaqcct(ifname)
	QUIT:cat'="NAME"  ; *** recurse on RowID/des-ref
	s ifname="{"_ifname_"}"  ;  check for $p(fun({ifn}))
	s fx=$p(exp,"{")
	s:fx'="" ifname=fx_ifname_")"
	q:ifname_","","")"'=exp&&(ifname_","","",1)"'=exp)
	s nilev=$o($$$smd(12,+imp,6,ilev))  ;  see if next sub matches
	QUIT:"$P("_ifname_","","",2)"'=$tr($$$smdMSExpression(imp,nilev),"p","P")
	#;  this is split name!  flag in $p(sub,3)
	s:ilev=$p(id,$c(1),5) $p(id,$c(1),5)=nilev  ;  patch for idsub
	s ilev=nilev,sub=$c(1,1)_1_$c(1)_fx,ifn=+$p(ifname,"{",2)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddfmap(irn,ifn) [imp,m,mt,mts,str,x] PUBLIC {
		#;  $$:  list of maps, other than map0, containing ifn as data
	s x="",imp="",imp0=$p(mts(m,str),"^",4) ;ifn is not RID or components!
	#; JLF156
	for
	{	s imp=$o($$$smd(1,irn,2,ifn,52,imp)) q:imp=""
		if imp'=imp0
		{	continue:'$d(mts(m,str,"MAP",imp))
			#; Verify that this is not a KEY or ELEMENT subvalue
			s idata="" f  s idata=$o($$$smd(1,irn,2,ifn,52,imp,idata)) q:idata=""  quit:$lg($$$smd(12,imp,7,idata),6)=""
			continue:idata=""
			#;  if CDI on collation, then f is not available there
			CONTINUE:$p(mts(m,str,"MAP",imp),"^",9)[("_")  ;  AK1050
			if $p(mts(m,str,"MAP",imp),"^",6)="T"		// collection index template map
			{	s impC="" for  s impC=$o(mt("smdimp",impC),1,smdimp) q:impC=""  s:imp=smdimp x=x_impC_"," }
			else
			{	s x=x_imp_"," }
		}
	}
	#; JLF156-
	QUIT x
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA242; created marknoindex
marknoindex(log)  // Mark bit string for all logs that (deeply) contain a %noindex condition
	n call s call="marknoind^%qaqpqo1"
	d lvtree^%qaqpnl("l",log)
	QUIT
marknoind // via goto from lvtree, via call variable
	if $p(v,"^",2)["%NOINDEX" s $bit(noindexmap,val)=1 QUIT
	QUIT:ev="v"
	f lv=4:1:$l(v,"^")-1 { d lvtree^%qaqpnl(ev,$p(v,"^",lv)) s:$bit(noindexmap,$p(v,"^",lv))=1 $bit(noindexmap,val)=1}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
checkUniqueCond(imp) [mts,m,str,idifn] {
	#; this function, introduced by IBA164, populates mts(m,str,"UNIQUECON").
	#; we only call it if there is a unique index in the maps tag of this routine.
	#; If there is a unique index constraint that is satisfied by WHERE clause equal conditions,
	#; then define mts(m,str,"UNIQUECON") as imp^LIST(,#log,)^sel,
	#; where sel is the product of selectivities of each individual conditon
	set sub="",uniqueCon=1,listIfns=",",listLogs="",sel=1
	for {
		set sub=$o(mts(m,str,"MAP",imp,sub),1,subInfo)
		QUIT:sub=""
		set ifn=$p(subInfo,"^",2)
		CONTINUE:'ifn
		set:$p(subInfo,"^",6)'="" ifn=ifn_"_"_$p(subInfo,"^",6)
		set:ifn'=idifn listIfns=listIfns_ifn_","
		set hasCon=$d(mts(m,str,"CON",ifn),conInfo)
		if 'hasCon,idifn'=ifn {
			set uniqueCon=0
			QUIT	
		} elseif hasCon {
			set log=$p(conInfo,"^",2),listLogs=listLogs_$p(conInfo,"^",2)
			#; accumulate the product of selectivites of conditions with unique constraints
			set sel=sel*$p(conInfo,"^")
		}
	}
	if uniqueCon {
		#; we store product in selectivities in $p3, it will be replaced by 1/extentsize in the optimizer
		set mts(m,str,"UNIQUECON")= imp_"^"_$change(listLogs,",,",",")_"^"_sel
	}
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cond	s type=$p(ptl,"^",log)
	QUIT:type="s"  ; streamless condition
	#;  Set-Up the CONDition in the 'mts' array, according to its type
	n collectcost // PVA152
	s ptj(m,1)=","_log_ptj(m,1)  ;  add condition `log' to join-set listing
	s ptlg=$$$mtL(log),vals=$p(ptlg,"^",3)
	d marknoindex(log)  // PVA242
	f pi=2:1 s val=$p(vals,",",pi) q:val=""  $$$aptv(val,$$$PTVLOGREFS,log_",")
	s collectcost=$$collect(vals) //PVA152
	g con:type="c",range:type="r",join:"jo"[type,fex:type="x"
	d strval(vals)  ;  if >1 streams - "MREL"
	i 2<$L(sl,",") s %Y=$$seltabs(sl) d mrel(sl) QUIT  ;  "f" or "m"
comp	;  "COMP":  complex single-stream condition
	#; TR701
	s str=$tr(sl,"^,")
	#; JLF013
	QUIT:str=""
	#; PVA34: Use new selectivity machinery shared with optimizer
	n sel s sel=$$GetSel^%qaqomul(log)
	s mts(m,str,"COMP",log)=sel_"^,"_$tr(stvl,"^")_"^1"
	s $p(mts(m,str,"COMP",log),"^",7)=collectcost //PVA152
	#; TR701-
	do condWithSubqCalls(log,m)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
con	;  "CON":  ff=constant
		#; PVA34: Use new selectivity utility shared with optimizer
	n sel s sel=$$GetSel^%qaqomul(log)
	#; MRP536
	n vinfo s vinfo=$$$mtV($p(ptlg,"^",4))
	s v=$g(ptv($p(ptlg,"^",4)))
	s:v=""&&($e(vinfo)="e") v=ptv($p(vinfo,"^",4))
	#; MRP536-
	s str=$p(v,"^",$$$PTVSTR),ifn=$p(v,"^",$$$PTVIFN)
	#; TR701
	#; PVA021
	#; PVA34: Use sel as computed above for selectivity for all cases.
	#;  Distinguish NULL test, simple CON, and OR generalized CON.
	#;  null test can never participate in equivalence class, so no need for ptv(+v)
	#; PVA152: also set piece for collection cost
	i $p(v,"^",$$$PTVCONTYPE)="n"       s mts(m,str,"CON",ifn)=sel_"^,"_log_",^"_1,$p(mts(m,str,"CON",ifn),"^",7)=collectcost QUIT
	i $p(ptv(+v),"^",$$$PTVCONTYPE)="c" s mts(m,str,"CON",ifn)=sel_"^,"_log_",^"_0,$p(mts(m,str,"CON",ifn),"^",7)=collectcost QUIT
	i $p(ptv(+v),"^",$$$PTVCONTYPE)="i" s mts(m,str,"CON",ifn)=sel_"^,"_log_",^"_$p($p(ptv(+v),"^",$$$PTVRANGEINFO),",",2)_"^"_$p($p(ptv(+v),"^",$$$PTVRANGEINFO),",",5),$p(mts(m,str,"CON",ifn),"^",7)=collectcost QUIT
	#; PVA021-
	s mts(m,str,"CON",ifn)=sel_"^,"_log_",^"_("NULL"=$tr($p(ptlg,"^",2),"'"))
	do condWithSubqCalls(log,m)
	s $p(mts(m,str,"CON",ifn),"^",7)=collectcost
	#; TR701-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA34: Use same rules (and maintain seldict) as in andsel^%qaqomul; rewrite this tag
range	n lv,uv,issw,sel,selt
	s v=ptv($p(ptlg,"^",4)),str=$p(v,"^",$$$PTVSTR),ifn=$p(v,"^",$$$PTVIFN)
	s x=$g(mts(m,str,"RANGE",ifn)),v=ptv(+v),selt=$s(x="":1,1:+x)
	#; JLF020
	n xb s xb = $s($p(v,"^",$$$PTVTOPINFO)'="":$p(v,"^",$$$PTVTOPINFO),1:$p(v,"^",$$$PTVRANGEINFO))
	if ($D(mt("nRTP","SelInfo",log))){
		set sel = mt("nRTP","SelInfo",log)	
 	} else{
		set sel = $$GetAllLitRangeSel(xb,ifn)
		if sel'="" {
			set selt=1
		} else {
			set sel=$$eqsel^%qaqomul(log)
			#; PVA079: DEPENDENT ON/FIX TO: JLF020: fix references to $p(v,"^",5) to refer to xb,
			#;         as the former may not be a range asl spec at all.
			s lv=$p($p(xb,",",1),$c(1),1),uv=$p($p(xb,",",1),$c(1),3)
			s issw=2=$p($p(xb,",",1),$c(1),2)
			#; JLF020
			if issw { if $p(ptlg,"^",5)=lv { s sel=sel*.75 +($zsqr(sel)/4) } else { s sel=.8 } }
			else { 
	 			if lv&uv { s sel=$s($p(v,"^",$$$PTVTOPINFO)'="":.8,(ptlg["^TOP")&(idifn=ifn):.8, // IBA140: if idifn and top conditon, use the .8 selectivity
									($p(ptlg,"^",5)=lv)||($p(ptlg,"^",5)=uv):$zsqr(2*sel/3+($zsqr(sel)/3)),1:.8) } // PVA078: cange sel*.8 to .8
				else { s sel=$s($p(v,"^",$$$PTVTOPINFO)'="":.8,(ptlg["^TOP")&(idifn=ifn):.8, // IBA140: if idifn and top conditon, use the .8 selectivity
								($p(ptlg,"^",5)=lv)||($p(ptlg,"^",5)=uv):sel/2+($zsqr(sel)/2),1:.8) } // PVA078: cange sel*.8 to .8
			}
		}
		set:$D(mt("nRTP","MaxSel",log))&&(sel>mt("nRTP","MaxSel",log)) sel=mt("nRTP","MaxSel",log)	
 	}
	#; JLF020-
	s seldict(log)=sel,selt=selt*sel
	#; JLF020
	s mts(m,str,"RANGE",ifn)=selt_"^,"_log_$S(x="":",^"_$p(xb,","),1:$p(x,"^",2,3))
	s $p(mts(m,str,"RANGE",ifn),"^",7)=collectcost // PVA152
	#; JLF020-
	do condWithSubqCalls(log,m)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
condWithSubqCalls(log,m) [mt] PUBLIC { ; IBA142 - Expose subquery call count to the optimizer
	#; this should be moved to mts in ther future
	set subqList=$$listree^%qaqpagg("l",log,"q")
	for j=1:1:$l(subqList,",")-1 {
		s subq=$p($$$mtV($p(subqList,",",j)),"^",2)
		CONTINUE:'$$$mtPCorrelatedFields($$$mtP(subq)) ; skip non-correlated subqueries
		#; this should be stored in mts in ther future since it's used by the optimizer
		set $$$mtLogSubquery(m,log)=$g($$$mtLogSubquery(m,log))_$p($$$mtV($p(subqList,",",j)),"^",2)_","
	}
	QUIT
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
join	s val=$p(ptlg,"^",4),con=$p(ptlg,"^",5)
	#; JLF015
	#; If there is an %ANYOF expression inside the value expression rooted at 
	#; val or con, then mark anyofVal or anyofCon accordingly
	#; 
	n anyofVal,anyofCon,v,v2,flds,fi,fvar s anyofVal="",anyofCon=""
	
	s v=$$$mtV(val) 
	if $e(v)="n" { s flds = "," } elseif $e(v)="f" { s flds=","_val_"," } elseif "v"=$e(v) { s flds = $p(v,"^",3) } else { s flds="" }
	f fi=2:1:$l(flds,",")-1 { s fvar=$p(flds,",",fi) i $$$mtV(fvar)["_%ANYOF" s anyofVal=1 q }
	
	s v=$$$mtV(con) 
	if $e(v)="n" { s flds = "," } elseif $e(v)="f" { s flds=","_con_"," } elseif "v"=$e(v) { s flds = $p(v,"^",3) } else { s flds="" }
	f fi=2:1:$l(flds,",")-1 { s fvar=$p(flds,",",fi) i $$$mtV(fvar)["_%ANYOF" s anyofCon=1 q }
	
	d ptsjoin(val,con):(type="j"&&'anyofCon),ptsjoin(con,val):'anyofVal
	#; JLF015-
	QUIT
	#; PVA152: New function 'collect' to estimate cost of collection condition applied to data
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
collect(valifns) [mt,mts] PUBLIC {
	s collectcost=0
	for i=2:1 {
		s v=$p(valifns,",",i) q:'v
		continue:$$$mtV(v)'["_%ANYOF"
		s str=$p($$$mtV(v),"^",2),irn=+$$$mtR(str),ifn=+$p($$$mtV(v),"^",3),vm=$$$mtRQb($$$mtR(str))
		s v=$p($g(mts(vm,str,"ATT",ifn)),"^",5) // better exist if ifn is from streamed view
		while $d($$$mtRVirtual(str))
		{
			s vm=$$$mtRVirtual(str) s j=v-$$$mtPViewIDVal($$$mtP(vm))
			s:$d($$$mtDupsv(vm)) vm=$$$mtDupsv(vm)
			s v=$p($$$mtOutputVals($$$mtOutput(vm)),",",j) // can't use virf in dupsv case
			s v=$$thruRMLSP(v)  ;  AK1084
			s str=$p($$$mtV(v),"^",2),irn=+$$$mtR(str),ifn=$p($$$mtV(v),"^",3)
		}
		s elemcost=+mts(vm,str)/200 s:elemcost<4 elemcost=4 s collectsize=100
		set:'$$$smdColListType(1,irn,ifn)&&('$$$smdColStream(1,irn,ifn))&&('$$$smdColArrayCollection(1,irn,ifn)) collectsize=$$$smdColMaxLength(1,irn,ifn)/10
		s collectcost=collectcost+(elemcost*collectsize)
	}
	QUIT collectcost
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
thruRMLSP(val)  ;  $$: the actual uncollated field, if val is RMLSP  ;  AK1084
	#;  *** maybe extend for UPPER/PLUS/ALPHAUP etc. (identity function), i.e. go through the collation to get to the original actual field
	n v s v=$$$mtV(val)
	RETURN:$e(v,1,5)'="v^%RM" val  ;  for %RMLSP/%RMINUS/%RMVR
	s val=$p(v,"^",4),v=$$$mtV(val)
	RETURN:$e(v)'="f" val
	s val=$p($g(mts($$$mtRQb($$$mtR($p(v,"^",2))),$p(v,"^",2),"ATT",+$p(v,"^",3))),"^",5)
	RETURN:val val  ;  when called from the optimizer, it might be only in fsave()
	RETURN $p(fsave("mts",$$$mtRQb($$$mtR($p(v,"^",2))),$p(v,"^",2),"ATT",+$p(v,"^",3)),"^",5)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fex	s con=$p(ptlg,"^",5),vals=$p($$$mtV(con),"^",3)
	#;  ff=expr - expression must contain fields, there are 3 cases:
	#;  generate ifn/stream lists for "expr"
	d strval(vals) s val=$p(ptlg,"^",4),str=$p($$$mtV(val),"^",2)
	i ","_str_","[$tr(","_sl,"^") d addsv g comp  ;  A.  all in ff's stream
	s %Y=$$seltabs(sl)  ;  selectivity for the "expression" only!
	#;  B.  all in streams different than ff - consider it a JOIN for ff
	d:'$p(sl,"^",str) ptsjoin(val,con,$tr(sl,"^"),%Y)
	#;  C.  expression includes fields from the same stream as ff
	#;  For both cases B. and C., record "MREL" for each stream in "expr"
	s list=sl d addsv,mrel(list)  ;  *** but not on this str if JOIN too!
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ptsjoin(val,con,constr,consel)  ;---------- one-half of a join ----------
	new valsel
	s:'$D(constr) v=ptv(con),constr=$p(v,"^",$$$PTVSTR)_",",consel=$p(v,"^",$$$PTVCONEQLSEL)
	s v=ptv(val),str=$p(v,"^",$$$PTVSTR),ifn=$p(v,"^",$$$PTVIFN)
	d joinsel(val,con,consel,constr=",",.valsel,.consel)                           // JMM760
	set seldict(log) = consel
	#; AK380
	#;  handle const=*f (*** also generalize for any expression!)
	#; PVA152: set piece 7 for collection cost
	i constr="," s mts(m,str,"JOIN",ifn,log)=(ifn=$p(mts(m,str),"^",5))_"^"_valsel_"^^1^,"_con_",^"_consel_"^"_collectcost QUIT // PVA152, JMM760
	#; AK380-
	$$$aptv(val,$$$PTVOJSTR,constr)
	#; PVA34: Should use common selectivity utility, but it needs a little generalization for JOIN -
	#;        it needs the concept of left and right selectivity as represented in pieces 2 and 6 below.
	s mts(m,str,"JOIN",ifn,log)=(ifn=$p(mts(m,str),"^",5))_"^"_valsel_"^,"_constr_"^"_(type="o")_"^,"_con_",^"_consel_"^"_collectcost // PVA152, JMM760
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  Calculate join selectivity      JMM760+
	#;  
	#;  val - Input - This side of join
	#;  con - Input - Other side of join
	#;  conconst - Input - 1 if other side of join is constant expression, else 0
	#;  valjsel - Output - Selectivity of this side of the join
	#;  conjsel - Output - Selectivity of the other side of the join
	#;  Handles 6 cases:
	#;  1) Neither side has outlier
	#;  2) One side has outlier
	#;  3) Both sides have same outlier
	#;  4) Both sides have outliers, but they are different
	#;  5) Other side is constant expression
	#;     5a) and this side has no outlier
	#;     5b) and this side has outlier 
	#;  6) There is also a CON condition on one of the join fields
joinsel(val,con,csel,conconst,valjsel,conjsel)
	new conhasoutlier,conosel,conoval,v,valhasoutlier,valosel,valoval,vsel
	if $d(mt("nRTP","SelInfo",log),valjsel) { ; IBA158 - use RTPC selectivities if available
		set conjsel=valjsel
		QUIT
	}
	s v=ptv(val),vsel=$p(v,"^",$$$PTVCONEQLSEL)
	s valhasoutlier=$$getoutlier^%qaqomul(+$p($$$mtV(val),"^",3),.valosel,.valoval)
	s conhasoutlier=$$getoutlier^%qaqomul(+$p($$$mtV(con),"^",3),.conosel,.conoval)
	#; Case 6, there is also a CON condition on one of the join fields
	if $p($g(ptv($p(v,"^",$$$PTVEQUIVCLASS))),"^",$$$PTVCONTYPE)="c" {
		s valjsel=vsel,conjsel=csel
		#; use any RTPC selectivities of any CON conditions on val or its equivalence class ($p(v,"^",$$$PTVEQUIVCLASS))
		if $d(mt("nRTP","SelInfo")) { ; IBA158: use RTPC selectivity of the implied CON condition on val
			new selInfoLog,logv s selInfoLog=""
			for {
				s selInfoLog=$o(mt("nRTP","SelInfo",selInfoLog))
				QUIT:selInfoLog=""
				CONTINUE:'$d($$$mtL(selInfoLog),logv) ; YCL481 make sure this log exists
				#; selInfoLog can be CON, RANGE or IN/INSET/ONEOF, this check makes sure it's an equal condition on one field
				if $l($p(logv,"^",3),",")=3, $p(logv,"^",2)="=" {
					#; Important to note that we should not use the selectivity of the equivalence class $p(v,"^",$$$PTVEQUIVCLASS) for val
					set:($p($p(logv,"^",3),",",2)=val) valjsel=mt("nRTP","SelInfo",selInfoLog)
					#; There is a CON on the other field (equivalence class field)
					set:($p($p(logv,"^",3),",",2)=$p(v,"^",$$$PTVEQUIVCLASS)) conjsel=mt("nRTP","SelInfo",selInfoLog)
.
				}
			}
		}
	}
	elseif 'valhasoutlier { 
		s valjsel=vsel
		if conconst {
			#; Case 5a, other side is constant expression and this side has no outlier
			s conjsel=valjsel
		}
 		elseif 'conhasoutlier { 
 			#; Case 1, neither side has outlier
 			s conjsel=csel
 		}
 		else {
	 		#; Case 2, one side has outlier
	 		#; Currently using "classic selectivity"
	 		#; Note: Paul uses simple average in qaqomul when prmIncOutlier is set:
	 		#;  s conjsel=(csel+conosel)/2
	 		s conjsel=csel/(1-conosel+csel)
 		}
	}
	elseif conconst {
		#; Case 5b, other side is constant expression and this side has outlier
		s valjsel=vsel
		s conjsel=valjsel
	}
	elseif 'conhasoutlier { 
		s conjsel=csel
	 	#; If here, valhasoutlier is true
	 	#; Case 2, one side has outlier
	 	#; Currently using "classic selectivity"
	 	#; Note: Paul uses simple average in qaqomul when prmIncOutlier is set:
	 	#;  s valjsel=(vsel+valosel)/2
	 	s valjsel=vsel/(1-valosel+vsel)
	}
	else {
		#; Both sides have outliers
		if valoval=conoval {
			#; Case 3, both sides have same outlier
			#; Aviel's formula: (L2*L1)+((1-L2)*S1
			s valjsel=(conosel*valosel)+((1-conosel)*vsel)
			s conjsel=(valosel*conosel)+((1-valosel)*csel)
		}
		else {
			#; Case 4, both sides have outliers, but they are different
			#; Aviel's formula: (L2*S1)+((1-L2)*C1)
			s valjsel=(conosel*vsel)+((1-conosel)*(vsel/(1-valosel+vsel)))
			s conjsel=(valosel*csel)+((1-valosel)*(csel/(1-conosel+csel)))
		}
	}
 	QUIT
 	#; JMM760-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mrel(listr) s list=$tr(stvl,"^")
	s list=$e($p(ptlg,"^",3),2,*)  ;  list of field val# in the condition	// AK491
	f li=1:1 s val=$p(list,",",li) q:val=""  $$$aptv(val,$$$PTVOJSTR,$tr(sl,"^"))
	#; PVA34: Use common selectivity facility (should eliminate input argument and obsolete
	#;        routines).
	#; PVA152: set piece 7 for collection cost
	f str=1:1:maxs s:$p(listr,"^",str) list=sl,$p(list,"^",str)="",mts(m,str,"MREL",log)=$$GetSel^%qaqomul(log)_"^,"_$p(stvl,"^",str)_"^,"_$tr(list,"^")_"^1",$p(mts(m,str,"MREL",log),"^",7)=collectcost
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA217: create txtfixptv and numcollect
txtfixptv(qno=0)[ptv,mt] PUBLIC // must be called after all collection/text fvals have been set up, 
            #; and only on a 'consistent' parse tree state, e.g. ALL query blocks 
            #; are complete (rather than in the middle of being cloned or constructed).
	{  for fval=1:1:$$$maxv 
	   {  s pt=$g(ptv(fval)) continue:("f"'=$p(pt,"^",$$$PTVVALTYPE)||($p(pt,"^",$$$PTVCONEQLSEL)'<0))
	      continue:(qno && ($$$mtRQb($$$mtR($p(pt,"^",$$$PTVSTR)))'=qno))
	      s sel=$p(pt,"^",$$$PTVCONEQLSEL),sel=-sel,sel=((sel+$zsqr(sel))/2)**(1/$$numcollect($p(pt,"^",$$$PTVIFN),$p(pt,"^",$$$PTVSTR)))
	      s $p(pt,"^",$$$PTVCONEQLSEL)=sel,ptv(fval)=pt
	   }
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
numcollect(ifn,str) [mt]
	{  for log=1:1:$$$maxl
	   {  s lvn=$g($$$mtL(log)) continue:$e(lvn)'="v"
	      s fvals=$p(lvn,"^",3)
	      for i=2:1
	      {  s fval=$p(fvals,",",i) quit:'fval
	   		 continue:$p($$$mtV(fval),"^",2)'=str
	   		 s ifn2=$p($$$mtV(fval),"^",3)
	   		 continue:ifn2'["%ANYOF"||(+ifn2'=+ifn)
	   		 if $i(cnt) quit
	      }
	   }
	QUIT $s($d(cnt):cnt,1:1)
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  1/SQRT(N), where N is the product of #rows in all tables in listr
seltabs(listr) n sel,str,maxnumber s sel=1,maxnumber=0  ;  get sel=product(#rows)
	f str=1:1:maxs {
		q:maxnumber
		try {
			s:$p(listr,"^",str) sel=sel*mts(m,str)
		} catch err {
			i err.Name="<MAXNUMBER>" {s maxnumber=1} else {throw err}
		}
	}
	QUIT sel**-.5
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
strval(vals) s stvl="",sl=""  ;---------- return ifn, stream lists ----------
	f li=2:1 s val=$p(vals,",",li) q:val=""  d addsv
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
addsv	s v=$$$mtV(val),str=$p(v,"^",2),ifn=$p(v,"^",3),x=$p(stvl,"^",str)
	s:","_x'[(","_ifn_",") $p(stvl,"^",str)=x_ifn_",",$p(sl,"^",str)=str_","
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
complex(sub,qry,str) ; Analyze Complex Subscripts for Query Optimization...
	#; pva024: add variable j
	n cons,exp,found,good,i,ifn,ifns,info,j,log,logs,string,toval,val,vals
	#; Default to Valid Complex Subscript...
	s ifns=",",logs=",",vals=",",cons=$c(1),good=1,exp=$p(sub,$c(1),5)  ; Get the Subscript Expression...
	QUIT:$l(exp,"{")<3 0      ; Not a valid Complex Subscript...
	s string=exp
	for  {
		s string=$p(string,"{",2,*) q:string'["}"  ; Parse out the ifn's...
		s ifn=+string,string=$p(string,"}",2,*)
		s val=$p($g(mts(qry,str,"ATT",ifn)),"^",5)
		i ifn=""||(val="") s good=0 q
		s vals=vals_val_",",ifns=ifns_ifn_","
	}
	g:'good plexend  ; Bad Complex Subscript...
	#; 
	#; ------ Check to see if all the 'val's have a given value ------
	f i=2:1 s val=$p(vals,",",i) q:val=""  d  q:'good  ; Check 'val's...
	. i '+val s good=0 q   ; Bad Complex Subscript...
	. s found=0,log=""
	  #; PVA024: Change to use mt("w") and therefore eliminiate flawed boolean 
	  #;         analysis (as well as risk of using logic entries intended to
	  #;         be deleted by equivalence class analysis, which doesn't 
	  #;         set them to "i").
	. f j=1:1 s log=$p($g($$$mtWhere(qry)),"^",j) q:'log  d  q:found  ; Spin thru logs.
	.. s info=$$$mtL(log)
	.. q:$e(info,1,4)'="v^=^"  ; Only want Equality...
	.. q:("^"_$p(info,"^",4,5)_"^")'[("^"_val_"^")  ; Not this Logical...
	.. s found=1  ; Found one that matches...
	.. s toval=+$s($p(info,"^",4)=val:$p(info,"^",5),1:$p(info,"^",4))
	.. s:",x,t,"'[(","_$e($g($$$mtV(toval)))_",") good=0
	.. s logs=logs_log_","  ; Keep Track of Logs Involved...
	.. s toval=$$$mtV(toval)
	.. s toval=$s($e(toval)="t":""""_$p(toval,"^",2)_"""",1:$p(toval,"^",2))
	.. s cons=cons_toval_$c(1)
	. i 'found s good=0 q  ; Bad Complex Subscript...
	  #; PVA024: Eliminate flawed second pass. Not needed with use of mt("w")
	#;
plexend	; Exit the Complex Subscript Module...
	i good d  ; Valid Complex Subscript...
	. n from,to
	. f i=2:1 s ifn=$p(ifns,",",i),val=$p(cons,$c(1),i) q:'+ifn  d  q:'good  ;Parse
	.. i ifn=""||(val="") s good=0 q
	.. s from="{"_ifn_"}",to=val
	.. f  q:exp'[from  s exp=$p(exp,from)_to_$p(exp,from,2,*)
	. q:'good  ; Bad Complex Subscript...
	. s good=9,$p(good,"^",9)=ifns_"^"_$$twist^%qaqpqo(exp)
	QUIT good
.
createMtsAGG()
	n call,i,val,vals,foundNonStdAgg
	s foundNonStdAgg=0,vals=$p($g($$$mtP(m)),"^",3),foundNonStdAgg=0,call="ansiAgg^%qaqpre"
	f i=1:1 s val=$p(vals,",",i) q:val=""  do lvtree^%qaqpnl("v",val) q:foundNonStdAgg
	QUIT:foundNonStdAgg
.
	#; There is no optimizer/code gen support yet for aggmaps in GROUP BY queries
	QUIT:$d($$$mtGroupDistinctList(m))
	
	#; Verify that the SELECT list references only GROUP BY expressions or ANSI aggregates
	if $d($$$mtOutput(m)) && $d($$$mtGroupDistinctList(m))
	{	s vals=$$$mtOutputVals($$$mtOutput(m))
	    f i=1:1 s val=$p(vals,",",i) q:val=""  do lvtree^%qaqpnl("v",val) q:foundNonStdAgg
	}
	QUIT:foundNonStdAgg
	
	s call = "doMtsAGG^%qaqpqo1"
	s vals = $p($g($$$mtP(m)),"^",3)		
	f i=1:1 s val=$p(vals,",",i) q:val=""  do lvtree^%qaqpnl("v",val)
	QUIT
	
doMtsAGG	;  called with type,val,v,ev, m
	; n valsave s valsave=val
	; QUIT:("ftsxiq"[ev)
	if ("a"=ev)
	{	n aggcol,aggfun,aggList,vli
		s aggcol=$p(v,"^",5),aggfun=$p(v,"^",2),aggList=val_","
 
		#; Push the aggregation operator below the operand, if this enables an
		#; index to be exploited for performing the aggregation.
		#; 
		if (aggfun="sum") && $p(v,"^",5) && (",+,-," [ (","_$p($$$mtV($p(v,"^",5)),"^",2)_",")) && 
		(""'=$p($g($$$mtV($p(v,"^",5))),"^",5)) &&		; not a unary minus  JLF102
		(($e($$$mtV($p($$$mtV($P(v,"^",5)),"^",4)))="f") && ($e($$$mtV($p($$$mtV($P(v,"^",5)),"^",5)))="f"))
		{
			#; There is a linear function of aggregation operations.  If none of the fields
			#; in the expression are nullable, and if a bitslice index exists on each one,
			#; then we push the aggregation operator down.  We could handle (fld + const) by
			#; simply changing the && to || above.
			#; 
			new optimizable,fldList,nuval,aggPos
			set optimizable = 1
			set fldList = $p($$$mtV($p(v,"^",5)),"^",3)
			for vli=2:1:$l(fldList,",")-1 { if $$IsNullable^%qaqpre($p(fldList,",",vli)) || '$$bitsliced($p(fldList,",",vli)) s optimizable = "" quit }
			s aggList = $$$mtPAggList($$$mtP(m))
			s aggPos = $find(","_aggList,","_val_",") - 2 - $l(val)
			if optimizable && (aggPos > 0)
			{
				#; Convert agg(op(arg4, arg5)) => op(agg(arg4),agg(arg5)) { swap nodes in-situ }
				#; 
				s nuval = $$$newval($p(v,"^",1,4)_"^"_$p($$$mtV($p(v,"^",5)),"^",4)_"^"_$p(v,"^",6,*),1)
				s $$$mtV(val) = "v^"_$p($$$mtV($p(v,"^",5)),"^",2)_"^"_$p(v,"^",3)_"^"_nuval_"^"_$p(v,"^",5)_"^"
				s $$$mtV($p(v,"^",5)) = $p(v,"^",1,4)_"^"_$p($$$mtV($p(v,"^",5)),"^",5)_"^"_$p(v,"^",6,*)
				
				#; Replace the reference to val in $$$mtP(m) with the vals of the two new aggregates
				s $e(aggList,aggPos,$l(val)) = nuval_","_$p(v,"^",5)
				s $$$mtPAggList($$$mtP(m)) = aggList
			}
			else
			{	s aggList = val_","
			}
		}
		
		#; Create an mts AGG node for each SQL-standard aggregate
		#; 
		f vli=1:1:$l(aggList,",")-1
		{	s v = $$$mtV($p(aggList,",",vli))
			set:'$d(mts("AGG",m,$s('$p(v,"^",5):"*",1:$p(v,"^",5)),$p(aggList,",",vli))) mts("AGG",m,$s('$p(v,"^",5):"*",1:$p(v,"^",5)),$p(aggList,",",vli)) = $ZCVT($p(v,"^",2), "U") _ $s($p(v,"^",7):" DISTINCT",1:"")
		}
	}
	; s v = $$$mtV(valsave)
	; s ev = $e(v)
	do lvarg^%qaqpnl  //  recurse down the tree
	QUIT
bitsliced(val)
	// tbd: replace this with a search through mts for an eligible bitslice index
	quit 1			  // until we have mv's, always assume it is bitsliced	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;---------- GENERAL UTILITIES ----------
sort(sort,xept) [] PUBLIC {  ;  $$:  sort, remove dup's and xept from ","-followed list
	s y="" f i=1:1 s x=$p(sort,",",i) q:x=""  s:x'=xept $p(y,"^",x)=x_","
	QUIT ","_$tr(y,"^")
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
error(e) GOTO ^%qaqperr // PVA214
.
/// Check if this range condition is all literal, if it is, call to calRangeSel to return range sel based on histogram information, otherwise return ""
GetAllLitRangeSel(xb,ifn)[mt] PUBLIC {
	// check if this range condition is all literal
	set list = $lfs($p(xb,",",2,*),","), ptr = 0
	while $LISTNEXT(list,ptr,rangeInfo) {
		quit:rangeInfo=""
		set rangeV = $$$mtV(+$p(rangeInfo,$c(1),3)), rangeOp = $p(rangeInfo,$c(1),2)
		if $e(rangeV)'="t" {
			if $e(rangeV) = "v" {
				return:+$p(rangeV,"^",3) ""
				return:$p(rangeV,"^",2)'=$p(ifn,"_",2,*) ""
				set rangeV = $$$mtV($p(rangeV,"^",4))
				return:$e(rangeV)'="t" ""
				set rangeV = $p(rangeV,"^",2,*)
				set col = $p($p(ifn,"_",2,*),"(")
				set:$e(col)="%" col = $e(col,2,*)
				set len = $s(+$p($p(ifn,"_",2,*),"(",2):+$p($p(ifn,"_",2,*),"(",2),1:"")
				set rangeV = $$collate^%qaqpcmp(col,rangeV,len)
			} else {return ""}	
		} else{
      		set rangeV = $p(rangeV,"^",2,*)
		}
      	if ",<,'>,"[(","_rangeOp_","){
		     set:(('$d(uv))||(uv]]rangeV))||((uv=rangeV)&&(rangeOp="<")) uv = rangeV,uop = rangeOp	
	    } else {
		     set:(('$d(lv))||(rangeV]]lv))||((lv=rangeV)&&(rangeOp=">")) lv = rangeV,lop = rangeOp	
		}
   	}
   	set ifn = +ifn
	set irn=$$$smdGetIrnFromIfn(ifn)
	return:irn="" ""
	set ttype = $$$smdTType(irn), hist = $$$smdColHistogram(ttype,irn,ifn)
	return:hist="" ""
	set hist = ##class(%Library.Global).Unquote(hist)
	set binWidth = $LIST(hist,1)
	set isNumInterp = $LIST(hist,2)
	set nullBucketCount = $LIST(hist,3)
	set bucketVals = $LIST(hist,4)
	set commonLeadingChars = $LIST(hist,5)
	set intBucketVals = $LIST(hist,6) 
   	set sel = $$calRangeSel($g(lv),$g(lop),$g(uv),$g(uop),nullBucketCount, bucketVals, commonLeadingChars, intBucketVals, binWidth, isNumInterp)
   	set:sel=0 sel=.00001
   	return sel
	
}
.
/// Range sel calculation based on histogram information
calRangeSel(LV="",LO="",UV="",UO="",NNB=0,HI,CL,IB,BW,NI) PUBLIC {
	#; if all buckets are nulls, then selectivity = very small
	if NNB = 16 { return .00001 }
	  #; find the lower bucket
	if LO = "" {
		set lowerBucket = NNB + 1
	} elseif LO = "'<" {
		set lowerBucket = $S(LV]]$LI(HI,16):17,1:$S(LV]]$LI(HI,8):$S(LV]]$LI(HI,12):$S(LV]]$LI(HI,14):$S(LV]]$LI(HI,15):16,1:15),1:$S(LV]]$LI(HI,13):14,1:13)),1:$S(LV]]$LI(HI,10):$S(LV]]$LI(HI,11):12,1:11),1:$S(LV]]$LI(HI,9):10,1:9))),1:$S(LV]]$LI(HI,4):$S(LV]]$LI(HI,6):$S(LV]]$LI(HI,7):8,1:7),1:$S(LV]]$LI(HI,5):6,1:5)),1:$S(LV]]$LI(HI,2):$S(LV]]$LI(HI,3):4,1:3),1:$S(LV]]$LI(HI,1):2,1:1)))))
	} elseif LO = ">" {
		set lowerBucket = $S($LI(HI,16)']]LV:17,1:$S($LI(HI,8)]]LV:$S($LI(HI,4)]]LV:$S($LI(HI,2)]]LV:$S($LI(HI,1)]]LV:1,1:2),1:$S($LI(HI,3)]]LV:3,1:4)),1:$S($LI(HI,6)]]LV:$S($LI(HI,5)]]LV:5,1:6),1:$S($LI(HI,7)]]LV:7,1:8))),1:$S($LI(HI,12)]]LV:$S($LI(HI,10)]]LV:$S($LI(HI,9)]]LV:9,1:10),1:$S($LI(HI,11)]]LV:11,1:12)),1:$S($LI(HI,14)]]LV:$S($LI(HI,13)]]LV:13,1:14),1:$S($LI(HI,15)]]LV:15,1:16)))))	
	} else{
		#; use existing estimating formula for %STARTSWITH for now
		return ""	
	}
	#; find the upper bucket
	if UO = "" {
		set upperBucket = 17
	} elseif UO = "<" {
		set upperBucket = $S(UV]]$LI(HI,16):17,1:$S(UV]]$LI(HI,8):$S(UV]]$LI(HI,12):$S(UV]]$LI(HI,14):$S(UV]]$LI(HI,15):16,1:15),1:$S(UV]]$LI(HI,13):14,1:13)),1:$S(UV]]$LI(HI,10):$S(UV]]$LI(HI,11):12,1:11),1:$S(UV]]$LI(HI,9):10,1:9))),1:$S(UV]]$LI(HI,4):$S(UV]]$LI(HI,6):$S(UV]]$LI(HI,7):8,1:7),1:$S(UV]]$LI(HI,5):6,1:5)),1:$S(UV]]$LI(HI,2):$S(UV]]$LI(HI,3):4,1:3),1:$S(UV]]$LI(HI,1):2,1:1)))))
	} elseif UO = "'>" {
		set upperBucket = $S($LI(HI,16)']]UV:17,1:$S($LI(HI,8)]]UV:$S($LI(HI,4)]]UV:$S($LI(HI,2)]]UV:$S($LI(HI,1)]]UV:1,1:2),1:$S($LI(HI,3)]]UV:3,1:4)),1:$S($LI(HI,6)]]UV:$S($LI(HI,5)]]UV:5,1:6),1:$S($LI(HI,7)]]UV:7,1:8))),1:$S($LI(HI,12)]]UV:$S($LI(HI,10)]]UV:$S($LI(HI,9)]]UV:9,1:10),1:$S($LI(HI,11)]]UV:11,1:12)),1:$S($LI(HI,14)]]UV:$S($LI(HI,13)]]UV:13,1:14),1:$S($LI(HI,15)]]UV:15,1:16)))))
	}
	#; If need to interpolate but bounds and values are not integers,
	  #; get the corresponding intege values
	if upperBucket = lowerBucket{
		if (lowerBucket = 1)||(lowerBucket = 17) {
			return .00001
		} else {
			set lower = $S(NI=0:$LI(IB,2*(lowerBucket-1)),1:$LI(HI,lowerBucket-1))
			set upper = $S(NI=0:$LI(IB,2*lowerBucket-1),1:$LI(HI,lowerBucket))
			if NI = 0 {
				if UO'="" {
					#; strip shared leading characters
					set highStr = $extract(UV,$LI(CL,lowerBucket-1)+1,*)
					#; convert unicode if necessary
					if $ziswide(highStr){set highStr=$zconvert(highStr,"O","UTF8")}
					Set UV=$zla($e($c(0,0,0,0)_$reverse($e(highStr,1,4)),*-3,*))
				}
				if LO'="" {
					#; strip shared leading characters
					set lowStr = $extract(LV,$LI(CL,lowerBucket-1)+1,*)
					#; convert unicode if necessary
					if $ziswide(lowStr){set lowStr=$zconvert(lowStr,"O","UTF8")}
					set LV=$zla($e($c(0,0,0,0)_$reverse($e(lowStr,1,4)),*-3,*))
				}
			}
			return $select(lower=upper:0,lower="-10000000000000000000":0,1:($s(UO'="":UV,1:upper)-$s(LO'="":LV,1:lower))*BW/(upper-lower))
		}
	} else {
		 #; set the lower percentile
		if LO = ""{
			if NNB = 0 {
				set lowerPerc = 0	
			} elseif NNB = 16 {
				set lowerPerc = 1
			} else {
				set lowerPerc = (lowerBucket-1)*BW
			}
		} else {
			set lowerPerc = $S(lowerBucket=1:0,lowerBucket=17:1,LV=$LI(HI,lowerBucket):(lowerBucket-1)*BW,1:(lowerBucket-1.5)*BW)
		}
		  #; set the upper percentile
		if UO = ""{
			set upperPerc = 1
		} else {
			set upperPerc = $S(upperBucket=17:1,upperBucket=1:0,UV=$LI(HI,upperBucket):(upperBucket-1)*BW,1:(upperBucket-1.5)*BW)
		}
		return upperPerc - lowerPerc
	}
	return ""
}
.
postRTPC() [mt,rtpcTVLogInfo] public {
	RETURN:'$d(mt("nRTP","vdf"))
	new rtpcTVLogInfo
	for m=1:1:$$$mtPNumQbs { 
		continue:'$$$mtPQbIsActive(m) 
		continue:'$d(mt("nRTP","vdf",m))
		s selVals=$$$mtOutputVals($g($$$mtOutput(m))) continue:selVals=""
		s ordVals=$g($$$mtSequencersQb(m)) continue:ordVals=""
		set selPos=""
		for {
			set selPos = $o(mt("nRTP","vdf",m,selPos),1,info) q:selPos=""
			set $lb(ordPos,hash)=info
			set ordVal=+$p(ordVals,",",ordPos),selVal=$p(selVals,",",selPos)
			set:$d($$$mtVecDistFunc(ordVal)) ordVal=$$$mtVecDistFunc(ordVal)
			set ordV=$$$mtV(ordVal),selV=$$$mtV(selVal)
			continue:$p(ordVal,"^",2,3)'=$p(selVal,"^",2,3) // same op and field
			set ordParm=$s($e($$$mtV($p(ordV,"^",4)))="f":$p(ordV,"^",5),1:$p(ordV,"^",4))
			set selParm=$s($e($$$mtV($p(selV,"^",4)))="f":$p(selV,"^",5),1:$p(selV,"^",4))
			set rtpcTVLogInfo=""
			continue:'$$dfsXprs^%qaqcoutlier(0,$s(%caller["ShowPlan":2,1:0),,selParm,"CheckSameVDF")
			continue:'$$dfsXprs^%qaqcoutlier(0,$s(%caller["ShowPlan":2,1:0),,ordParm,"CheckSameVDF")
			continue:hash'=$$$Base64SHA(rtpcTVLogInfo,10)
			set $p(selVals,",",selPos)=(+$p(ordVals,",",ordPos))
			set $$$mtOutputVals($$$mtOutput(m))=selVals
.
		}
.
	}
	RETURN
}
---
