^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqcmxc^MAC^^^0
%qaqcmxc	// code generation for ext tables
	;; COMPONENTS :: SQL/CodeGeneration
	#;
#include %msql
 #IF 0   ;-------------------------------------------------------------
	; Description:   Code generator for ext tables
	;
	;  BJB398 (10/31/2008) - One more dnQ change for JOINs 
	;
#ENDIF  ;-------------------------------------------------------------
#define odbcgatewayHandle "%SQLGateway"
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
uniquealias() [mt, dnQ] PUBLIC {
 	f m=1:1:$$$mtPNumQbs {
	 	i $$$mtPQbIsActive(m) f fi=1:1:$ll($$$mtFromList(m)) s al=$li($$$mtFromList(m),fi) s as($$uniqal(al))="" 
 	}
  	RETURN
uniqal(al)
	s old=al
	f  QUIT:'$d(as(al))  s al=al_m
	i al'=old d replaceal(old,al)
	QUIT al
.
replaceal(old,al)
	f val=1:1 s v=$g($$$mtV(val)) q:v=""  i $p(v,"^",1,3)=("f^"_m_"^"_old) s $p($$$mtV(val),"^",3)=al
	s $$$mtFromTableName(m_"^"_al)=$$$mtFromTableName(m_"^"_old) k $$$mtFromTableName(m_"^"_old)
	i $g($$$mtTarget) = (m_"^"_old) s $$$mtTarget = m_"^"_al
	s $li($$$mtFromList(m),fi)=al
    s n="" f  s n=$o($$$mtOn(m,n),1,on) q:n=""  f p34=3,4 s f34=$li(on,p34),i=$lf(f34,old) s:i $li(f34,i)=al,$li($$$mtOn(m,n),p34)=f34
    QUIT
.
}
buildq() 
	new vars,i,j,jp,tsql,pos,res,repl,vn,loj,thvloc,iloc
	i $d(@mt@("parm")) d ohvloc^%qaqcmxc(.mt)
	d uniquealias()
	s param=0
	s loj=0
	d joinstat^%qaqcmx(.loj,.mt)
	s res=$$parseQuery^%qaqcmx(.mt)
	if res=""       f i=1:1:sql s res=res_" "_sql(i)
	i $g(mt("hvloc"))'="" s j=2 f  d  q:jp=($ll(mt("hvloc"))+1)  s j=jp+1
	.s jp=$lf(mt("hvloc"),"*",j)
	.if jp'>j s jp=$ll(mt("hvloc"))+1
	. s vn=" ? "
	.i jp-j=4 d
	.. s repl($li(mt("hvloc"),j+1),$li(mt("hvloc"),j+2))=$lb(vn,$li(mt("hvloc"),j+1),$li(mt("hvloc"),j+2)+$l(vn)-1)
	.i jp-j=6 d
	.. i $li(mt("hvloc"),j+1)=$li(mt("hvloc"),j+4) s pos=$li(mt("hvloc"),j+5)-1
	.. i $li(mt("hvloc"),j+1)'=$li(mt("hvloc"),j+4) s pos=$l(sql($li(mt("hvloc"),j+1)))
	.. s repl($li(mt("hvloc"),j+1),$li(mt("hvloc"),j+2))=$lb(vn,$li(mt("hvloc"),j+4)-1,pos)
	.. s param=param+1,param(param)=$p($$$mtV($li(mt("hvloc"),j+3)),"^",2)
	d repldts^%qaqcmxc(.res)
	//s res=$$quoter^%qaqcmx(res)
	QUIT res   ;$tr(res,$c(0),"""")
	m tsql=sql
	s res=""
	s param=0
		;remove everything before sel
	i $d(mt("seloc")) d
	.f i=1:1:$li(mt("seloc"))-1 s tsql(i)=""
	. s repl($li(mt("seloc")),1)=$lb("",$li(mt("seloc")),$li(mt("seloc"),2)-1)
	i $g(mt("hvloc"))'="" s j=2 f  d  q:jp=($ll(mt("hvloc"))+1)  s j=jp+1
	.s jp=$lf(mt("hvloc"),"*",j)
	.if jp'>j s jp=$ll(mt("hvloc"))+1
	. s vn=" ? "
	.i jp-j=4 d
	.. s repl($li(mt("hvloc"),j+1),$li(mt("hvloc"),j+2))=$lb(vn,$li(mt("hvloc"),j+1),$li(mt("hvloc"),j+2)+$l(vn)-1)
	.i jp-j=6 d
	.. i $li(mt("hvloc"),j+1)=$li(mt("hvloc"),j+4) s pos=$li(mt("hvloc"),j+5)-1
	.. i $li(mt("hvloc"),j+1)'=$li(mt("hvloc"),j+4) s pos=$l(sql($li(mt("hvloc"),j+1)))
	.. s repl($li(mt("hvloc"),j+1),$li(mt("hvloc"),j+2))=$lb(vn,$li(mt("hvloc"),j+4)-1,pos)
	.. s param=param+1,param(param)=$p($$$mtV($li(mt("hvloc"),j+3)),"^",2)
	i $g(mt("intoloc"))'="" d
	. s j=$li(mt("intoloc"))
	. s jp=$li(mt("intoloc"),3)
	. i j=jp s repl(j,$li(mt("intoloc"),2))=$lb("",j,$li(mt("intoloc"),4)-1) q
	. s repl(j,$li(mt("intoloc"),2))=$lb("",j,$l(tsql(j)))
	. f i=j+1:1:jp-1 s repl(i,1)=$lb("",i,$l(tsql(i))+1)
	. s repl(jp,1)=$lb("",jp,$li(mt("intoloc"),4)-1)
	i $d(repl) d
	.s j=""
	.f  s j=$o(repl(j)) q:j=""  d
	.. s jp=""
	.. f  s jp=$o(repl(j,jp),-1) q:jp=""  d
	... s $e(tsql(j),jp,$li(repl(j,jp),3))=$li(repl(j,jp),1)
 
	f i=1:1:tsql s res=res_" "_tsql(i)
 
	f  s j=$f(res,"SQLUser . ") q:j=0  s $e(res,j-10,j-1)=" "       ; temp !!!!
	f  s j=$f(res,"SQLUser.") q:j=0  s $e(res,j-8,j-1)=" "       ; temp !!!!
	f  s j=$f(res," . ") q:j=0  s $e(res,j-3,j-1)="."       ; temp !!!!
	d repldts^%qaqcmxc(.res)
 
	//s res=$$quoter(res)
	RETURN res   ;$tr(res,$c(0),"""") 
ohvloc(mt) [dnQ] public {
	s temp=""
	s ind=$o($$$mtRecordParams(""))
	while(ind'="") {
		s ii=0  for   q:$li(mt("hvloc"),ii+5)=$$$mtRecordParams(ind)  s ii=ii+7
		s temp=temp_$lb($li(mt("hvloc"),ii+1))_$lb($li(mt("hvloc"),ii+2))_$lb($li(mt("hvloc"),ii+3))_$lb($li(mt("hvloc"),ii+4))_$lb($li(mt("hvloc"),ii+5))_$lb($li(mt("hvloc"),ii+6))_$lb($li(mt("hvloc"),ii+7))
		s ind=$o($$$mtRecordParams(ind))
	}
	s mt("hvloc")=temp
	RETURN
}
repldts(str) 
	new i,j,k
	s i=0
 
	for  s k=$f($e(str,i,*),"{") q:'k  s i=i+k-1 d
	. s j=i
	. d skipws^%qaqcmx(.str,.j)
	. i '$$skipdts^%qaqcmx(.str,.j) q
	. d skipws^%qaqcmx(.str,.j)
	. i $e(str,j)'="?" q
	. s j=j+1
	. d skipws^%qaqcmx(.str,.j)
	. i $e(str,j)'="}" q
	. s $e(str,i-1,j)=" ? "
	RETURN
 
genLojFrom(loj,mt,qn,first)
 
	if $d($$$mtOnRoot(qn)) quit $$genNewJoin(.mt,qn)
	QUIT:'$d(loj("rl",qn)) ""  ;  no OJ, all already generated
	n res,node,rt,cycle s res ="",node=qn_"^"
	#;  generate all the regular joins of the left sides
	f  s node=$o($$$mtFromTableName(node)) q:+node'=qn  s rt=$p(node,"^",2,*) s:'$d(loj("rl",qn,rt)) res=res_" CROSS JOIN "_$$ltJoin^%qaqcmx(qn,rt,.loj,.mt)
	s rt=""  ;  now generate the left-outer-joins
	f cycle=1:1:1000 q:'$d(loj("rl",qn))  s rt=$o(loj("rl",qn,rt)) i rt'="",$d(loj("rl",qn,rt))=1 s res=res_" LEFT OUTER JOIN "_$$ltJoin^%qaqcmx(qn,rt,.loj,.mt)_" on "_$$genOn^%qaqcmx(loj("rl",qn,rt),.mt) KILL loj("rl",qn,rt)
	QUIT:cycle>999 "[ERROR:  Irresolvable cycle in LEFT OUTER JOIN]"
	QUIT $e(res,13,*)  ;  remove the first " CROSS JOIN "
.
		// Returns metadata for each parameter defined in param
		// Note, the list of parameters in param() might be different than the list in mtc(0,0,"parameter").  Some might be missing in param() or duplicated.
		// Each parameter in param() must be looked up in mtc(0,0,"parameter")
		// assumes param() is already defined
		// Called from %qaqcmx and %qaaqcmxj
GetTypes(&dt,&prec,&scale,&numpars,&iot,&parms,bindTSasString=0)	;
	new i,j,mcurs,mtag,%mmmzzzr,%msg,%qscqry,pathout,SQLCODE,sqlin,%switch,mtc,res,mt,dtl,thisScale
	set %qscqry=1,%switch="ODBC"
	do comp^%qaqqt("query",.sql,"info","",0,"","%qsc(%qscacn",,,$g(packages))
	set dt="",prec="",scale="",iot="",parms=""
	set numpars=$g(param)
	for i=1:1:numpars {
		set j=$$getParamIndex(param(i),.mtc)
		set dtl=$p(mtc(0,0,"parameter",j,1),$c(1),2)
		set iot=iot_"_$lb(1)"
		if (dtl=-1)||(dtl=-4) {
			set prec=prec_"_$lb(0)"
			set parms=parms_"_$lb(-2)"
			set scale=scale_"_$lb(0)"
		}
		if '((dtl=-1)||(dtl=-4)) {
			set prec=prec_"_$lb("_$p(mtc(0,0,"parameter",j,1),$c(1),4)_")"
			set parms=parms_"_$lb("_dtl_")"
			set thisScale=$p(mtc(0,0,"parameter",j,1),$c(1),5) set:thisScale=""&&(dtl=2||(dtl=8)) thisScale=0	// DPV4513, restore behavior of scale=0, never undefined for numeric/double types (DPV4306).  Not 100% sure this is needed, but should not hurt anything.
			set scale=scale_"_$lb("_thisScale_")"
		}
		if bindTSasString && (dtl=11 || (dtl=93)) { set dtl=12 }	// bindTSasString option in %Library.SQLConnection.bindTSasString setting
		set dt=dt_"_$lb("_dtl_")"
	}
	set dt = $e(dt,2,*)
	set iot = $e(iot,2,*)
	set prec = $e(prec,2,*)
	set parms = $e(parms,2,*)
	set scale = $e(scale,2,*)
	if dt="" { set dt="""""",prec="""",scale="""" }
	QUIT
	
	// Given the name of a parameter and an mtc(), return the index of the parameter in mtc(0,0,"parameter")
	// Returns "" if the parameter pName is not found
getParamIndex(pName,&mtc) [] {
	set tPtr=""
	for  {
		set tPtr=$o(mtc(0,0,"parameter",tPtr),1,tData) quit:tPtr=""
		quit:$p(tData,$c(1),1)=pName
	}
	QUIT tPtr
	
}
.
	// Called from exsel^%qaqcmx
GenBind(vhstmt)	//
	new data,err,j,mcurs,mtag,%mmmzzzr,%msg,%qscqry,pathout,SQLCODE,sqlin,%switch,mtc,res,mt,dtl,ctype,extsqltype 
	set %qscqry=1,%switch="ODBC"
	do comp^%qaqqt("query",.sql,"info","",0,"","%qsc(%qscacn",,,$g(packages))
	set numpars=$g(mtc(0,0,"parameter"))
	for j=1:1:numpars {
		set dtl=$p(mtc(0,0,"parameter",j,1),$c(1),2)
		set extsqltype=$p(mtc(0,0,"parameter",j,1),$c(1),7)
		set iot=1
		if (dtl=-1)||(dtl=-4) {	// stream
			if $g(needLEN) {
				if extsqltype=-10 { set prec=1073741823 }		// NTEXT
				else { set prec=2147483647 }
			}
			else { set prec=0 }
			set parms=-2,scale=""""""
		}
		else {			// not a stream
			set prec=$p(mtc(0,0,"parameter",j,1),$c(1),4)
			set parms=prec
			set scale=$p(mtc(0,0,"parameter",j,1),$c(1),5)
			set:scale="" scale=0	// null scale not allowed in $zf call
		}
		set dt=dtl,ctype=1
.
		if dtl=-1 {	// LONGVARCHAR
			if uniStream { set ctype="$s(%SQLGateway(""-uv"")&&$zbitget($zversion(0),1):-8,1:1)" }
			else         { set ctype=1 }
			if extsqltype      { set dt=extsqltype }	// Use external type if one is defined
			elseif $g(needLEN) { set dt=-1 }
			else               { set dt=12 }
		}
		
	 	if ((dt = -2) || (dt = -3) || (dt=-4)) {		//  BINARY or VARBINARY or LONGVARBINARY
			set ctype = -2
			if extsqltype { set dt=extsqltype }		// Use external type if one is defined
			elseif $g(needLEN),dt=-4 { set dt=-4 }
			else { set dt=-3 }
		}
		set:dt=-8 ctype=-8
		$$$liin("s "_verr_"=$zf(-5,"_$$$odbcgatewayHandle_",62,"_vhstmt_","_j_",1,"_ctype_","_dt_","_prec_","_scale_","_parms_") goto:"_verr_"=-1 "_qerrt)
	
	}
	QUIT 
 
genNewJoin(mt,qn)[dnQ,linxon] public {
		s res=""
		s ind=$o($$$mtOn(qn,""))
		while(ind'="") {
			s jarr(ind)=""
			s ind=$o($$$mtOn(qn, ind))
		}
	n linxon  ;  move all arrow->syntax from jarr() to linxon()  ;  AK1056
	f  { s ind=$o(jarr(ind))
		QUIT:ind=""
		s mton=$$$mtOn(qn, ind),tn=$li($li(mton,4))
		CONTINUE:tn'["->"  CONTINUE:$li(mton)'="LEFT"
		#;  linxon(m,lt,rt)=n  ;  follow table lt with a LOJ into rt
		#;      using the condition in $$$mtOn(m, n)
		#;  for lt, use the last table in the chain in mt("ON"),$P(3)
		s on3=$li(mton,3),linxon(qn,$li(on3,*),tn)=ind KILL jarr(ind)
		#;  linxon(m,lt,rt)=""  ;  follow lt with a CROSS JOIN into rt
		#;  use <lt,rt> for any pair of adjacent tables in $P(3) chain
		f pos=$ll(on3):-1:2 s tn=$li(on3,pos) q:tn'["->"  s ltn=$li(on3,pos-1),linxon(qn,ltn,tn)=$g(linxon(qn,ltn,tn))
	}
		s ind=$o($$$mtFromTableName(""))
		while(ind'="") { //create list of tables
			if $p(ind,"^",1)=qn s tabl($p(ind,"^",2))=""
			s ind=$o($$$mtFromTableName(ind))
		}
		s ind=$o(jarr(""))
		while(ind'="") {  //find maximal elements
			if (jarr(ind)="") {
			 	s ind2=$o(jarr(ind))
			 	while(ind2'="") {
				 	s tt=$$compareON($li($$$mtOn(qn, ind),3)_$li($$$mtOn(qn, ind),4),$li($$$mtOn(qn, ind2),3)_$li($$$mtOn(qn, ind2),4))
				 	if tt=-1 s jarr(ind)=ind2
				 	if tt=1,jarr(ind2)="" s jarr(ind2)=ind
					 s ind2=$o(jarr(ind2))
			 	}
			}
			s ind=$o(jarr(ind))
		}
		
		s ind=$o(jarr(""))
		while(ind'="") {  //call generation for maximal elements
				if jarr(ind)="" s res=res_","_$$genOneJoin(.mt,qn,ind,.jarr,.tabl)
				s ind=$o(jarr(ind))
		}
 
		
		s ind=$o(tabl(""))
		while(ind'="") {
			s res=res_","_$$genTableEntry(.mt,qn,ind )_$$genlinxon(qn, ind)
			s ind=$o(tabl(ind)) 
		}
 
		
		
	
	quit $e(res,2,*)
}
genOneJoin(mt,qn,ind,jarr,tabl) [dnQ] public {
	s leftval=$li($$$mtOn(qn,ind),3)
	s rightval=$li($$$mtOn(qn,ind),4)
	s res=$$genJoinFromList(.mt,qn,leftval,.jarr,.tabl)_" "_$li($$$mtOn(qn,ind),1)_" join "_$$genJoinFromList(.mt,qn,rightval,.jarr,.tabl)
	s conds = $li($$$mtOn(qn,ind),2)
	if conds {
		s res = res_" on "
	}
	s condres = ""
	For i=1:1:$L(conds,"^")-1 {
		s cond = $$parseCond^%qaqcmx(.mt, $P(conds,"^",i), qn)
		CONTINUE:cond=""
		s condres = condres _  " AND " _ cond
	}
	set res = res_$e(condres,6,*)
	/* AK1056 changed regeneration for sharded joins including -> implicit joins, which involves adding tables to
	 	the linxon() structure that represent the right-most table on the left side of an -> join that has been added to 
		mt("ON"). When that table's entry was generated, we'd generate the linxon() joins for it. The problem is that 
		you could have queries like:
		
			SELECT A->field FROM A LEFT JOIN B ON condAB
		
		(imagine the type of A is some table called C). In this case, the left join added for -> is between A and C, but
		the linxon logic waits to generate this until the AB join has been generated. The problem with doing the linxon() 
		generation once a table entry is generated is that you could end up with:
		
			mt(ON) = $lb(,condA,$lb("A"),$lb("B"))
			mt(ON) = $lb(,condB,$lb("A","B"), $lb("A->field->C")) 	// something like this
.
		You end up with a reconstructed join like:
.
			... A LEFT JOIN B LEFT JOIN C ON condition(A,C) ON condition(A,B)
			(eventually parsed as:  ... [ A LEFT JOIN [ B LEFT JOIN C ON condition(A,C) ] ON condition(A,B) ]
.
		but the parser reading this query will associate condition (A,C) with (B LEFT JOIN C) which is not valid. So instead
		when linxon() specifies that a -> left join should be generated after e.g. B, we should wait until the entire LIST
		that B is the right-most table of has been generated, and then after the associated conditions for the explicit
		LEFT JOINs have been generated (i.e. the loop above this blob), generate the linxon conditions 
	*/
	set:$ll(rightval)=1 res = res _ $$genlinxon(qn,$li(rightval,1))  ;  AK1056
	RETURN "("_res_")"
}
.
genJoinFromList(mt,qn,list,jarr,tabl) [dnQ] public {
	if ($ll(list)=1){
		 k tabl($li(list))
		 quit $$genTableEntry(.mt,qn,$li(list))
	}
	s fn=0
	s res=""
	s ind=$o($$$mtOn(qn,""))
	while(ind'="") {
		//s jarr(ind)=""
		s cr=$$compareON($li($$$mtOn(qn, ind),3)_$li($$$mtOn(qn, ind),4),list)
		if (cr=2)  {
			s fn=1 //quit $$genOneJoin(.mt,qn,ind,.jarr,.tabl)
			quit
		}
		if (cr=-1) s ljarr(ind)=""
		s ind=$o($$$mtOn(qn, ind))
	}
		if fn quit $$genOneJoin(.mt,qn,ind,.jarr,.tabl)
		
		//generate local jarr for conditions contained in list
		s ind=$o(ljarr(""))
		while(ind'="") {  //find maximal elements
			if (ljarr(ind)="") {
			 	s ind2=$o(ljarr(ind))
			 	while(ind2'="") {
				 	s tt=$$compareON($li($$$mtOn(qn, ind),3)_$li($$$mtOn(qn, ind),4),$li($$$mtOn(qn, ind2),3)_$li($$$mtOn(qn, ind2),4))
				 	if tt=-1 s ljarr(ind)=ind2
				 	if tt=1,ljarr(ind2)="" s ljarr(ind2)=ind
					 s ind2=$o(ljarr(ind2))
			 	}
			}
			s ind=$o(ljarr(ind))
		}
		
		// Create local list of tables
		for ii=1:1:$ll(list) set ltabl($li(list,ii))=""
		
		//Go trough max elements
		s ind=$o(ljarr(""))
		while(ind'="") {  //call generation for maximal elements
				if ljarr(ind)="" {
					if res ="" {s res=$$genOneJoin(.mt,qn,ind,.jarr,.tabl)}
					else {s res=res_" cross join "_$$genOneJoin(.mt,qn,ind,.jarr,.tabl)}
					do RemoveLocal(.mt,qn,ind,.ltabl)
				}
				s ind=$o(ljarr(ind))
		}
 
		//generate cross joins for remaining tables in ltabl
		
		s ind=$o(ltabl(""))
		while (ind'="") {
			kill tabl(ind)
			
			
			if (res= "") {s res=$$genTableEntry(.mt,qn,ind)}
			else {s res=res_" cross join "_$$genTableEntry(.mt,qn,ind)}
				// This table might be the LHS anchor for a -> join, and since it wasn't in any existing chain of ON-clause 
				// joins, it will have been removed from mt("ON") and only be present in tablesInQuery() and linxon() arrays. 
				// If so, generate the necessary outer join now - this is a no op if there are no such implicit joins to add.
			set res = res _ $$genlinxon(qn, ind)
			s ind=$o(ltabl(ind))
		}
		
		
		quit res
	
}
RemoveLocal(mt,qn,ind,ltabl) public {
	s leftval=$li($$$mtOn(qn, ind),3)
	s rightval=$li($$$mtOn(qn, ind),4)
 
	set list=leftval_rightval
	for ii=1:1:$ll(list) {
		k ltabl($li(list,ii))
	}
	
}
.
compareON(val1,val2)  public{//returns 1 for >,-1 for less and 0 if not comparable 2 for equal
	s el=$li(val1)
	if $lf(val2,el)>0 {
		quit:$ll(val2)>$ll(val1) -1
		quit:$ll(val2)<$ll(val1) 1
		quit 2
	}
	quit 0
	
}
.
	//Generates a FROM clause item for outer join reconstruction.
	//Translate the mt("f")-style labels used by mt("ON") into a stream #
	//for use with the usual FROM item reconstruction logic.
genTableEntry(mt,qn,str) public {
	//parse tree 1 case for INSERT/UPDATE/DELETE
	RETURN:'$d($$$mtRNumStreams) $$fromit1^%qaqcmh(qn, str)
	RETURN $$fromit^%qaqcmh(qn,mt("ptrel",qn_"^"_str))
}
genlinxon(qn,str)  ;  $$: generate { LOJ <t> ON <c> } for all  ;  AK1056
	#;  arrow->syntax ON starting from table str in subquery qn, as
	#;  listed in linxon(qn,str,tn)=ind
	#;  for linxon(qn,str,tn)="" generate CROSS JOIN <t>
	n res,tn,ind s res="",tn=""
	f  {
		s tn=$o(linxon(qn,str,tn),1,ind)
		QUIT:tn=""
		s res=res_$s(ind:" LEFT",1:" CROSS")_" JOIN "_$$fromit^%qaqcmh(qn,mt("ptrel",qn_"^"_tn))_$$genoncond($lg($g($$$mtOn(qn,+ind)),2),qn)_$$genlinxon(qn,tn)
	}
	RETURN res
genoncond(conds,qn)  ;  ON conditions for conds, which could be "", "^", or LIST(log^)
	RETURN:'conds ""
	n res,i s res=""
	f i=1:1:$l(conds,"^")-1 s res=res_" AND "_$$parseCond^%qaqcmx(.mt,$p(conds,"^",i),qn)
	RETURN " ON "_$e(res,6,*)
zeroargfn(op)	QUIT $s(foreignTableGen: $$zeroargop(op), 1: "{fn "_op_"()}")
oneargfn(op)	QUIT $s(foreignTableGen: $$oneargop(op), 1: "{fn "_op_"("_arg1_")}")
twoargfn(op)	QUIT $s(foreignTableGen: $$twoargop(op), 1: "{fn "_op_"("_arg1_","_arg2_")}")
threeargfn(op)	QUIT $s(foreignTableGen: $$threeargop(op), 1: "{fn "_op_"("_arg1_","_arg2_","_arg3_")}")
.
zeroargop(op)	QUIT op_"()"
oneargop(op)	QUIT op_"("_arg1_")"
twoargop(op)	QUIT op_"("_arg1_","_arg2_")"
threeargop(op)	QUIT op_"("_arg1_","_arg2_","_arg3_")"
fourargop(op)	QUIT op_"("_arg1_","_arg2_","_arg3_","_arg4_")"
manyargop(op)
	n qval
	s qval=op _ "("
	i arg1'="" s qval = qval _ arg1
	i arg2'="" s qval = qval _ "," _ arg2
	i arg3'="" s qval = qval _ "," _ arg3
	i arg4'="" s qval = qval _ "," _ arg4
	n i,v f i=8:1:$l(val,"^")-1 s v=$p(val,"^",i) if v'="" { s v=$$vertVal^%qaqcmx(.mt,$p(val,"^",i)),qval=qval_","_v } else { s qval=qval_"," }
	s qval=qval_")"
	QUIT qval
	
	// PREDICT ( modelname WITH ( args... ) )
	// In the parse tree node it is ^mt("v",val)="v^PREDICT^^modelname-val^use-name^...multiple-^-peice-args..."
predictFunc(val) [ mt, arg2, arg3, arg4 ] PUBLIC {
	//Model name is a constant which should not be quoted
	Set model = $p($$$mtV($p(val,"^",4)),"^",2)
	Set usename = $p($$$mtV($p(val,"^",5)),"^",2)
	Set args = ""
		// arg2 is the optional USE name - already handled
	if arg3'="" { set args = arg3 }
	if arg4'="" { set args = args _ "," _ arg4 }
	For i=8:1 {
		Set v = $p(val,"^",i) QUIT:v=""
		Set args = args _ "," _ $$vertVal^%qaqcmx(.mt,v)
	}
	RETURN "PREDICT("_model_" "_$s(usename="":"",1:"USE "_usename_" ")_$s(args="":"",1:"WITH ("_args_")")_")"
}
	// PROBABILITY ( modelname [ USE <expr> ] [ FOR <expr> ] [ <predict-with> ] )
	// In the parse tree node it is ^$$$mtV(val)="v^PROBABILITY2^^"_model_"^"_use_"^"_forexpr_"^"_vallist_"^""
probabilityFunc(val) [ mt, arg2, arg3, arg4 ] PUBLIC {
	//Model name is a constant which should not be quoted
	Set model = $p($$$mtV($p(val,"^",4)),"^",2)
	Set usename = $p($$$mtV($p(val,"^",5)),"^",2)
	Set args = ""
	// arg2 is the USE name, already handed
	// arg3 is the FOR expr
	if arg3'="" { set for=arg3 }
	if arg4'="" { set args=arg4 }
	For i=8:1 {
		Set v = $p(val,"^",i) QUIT:v=""
		Set args = args _ "," _ $$vertVal^%qaqcmx(.mt,v)
	}
	RETURN "PROBABILITY("_model_$s(usename="":"",1:" USE "_usename)_$s(for="":"",1:" FOR "_for)_$s(args="":"",1:" WITH ("_args_")")_")"
}
.
scalFunc(val, foreignTableGen=0) //
	QUIT:op="NULL" "("_arg1_" IS NULL)"
	QUIT:op="'NULL" "("_arg1_" IS NOT NULL)"
	If op="PREDICT" { QUIT $$predictFunc(val) }
	If op="PROBABILITY" { QUIT $$probabilityFunc(val) }
	If op="JSON_ARRAY" { QUIT $$manyargop(op) }
	If op="JSON_ARRAY_ABSENT" { b  QUIT $e($$manyargop("JSON_ARRAY"),1,*-1)_" ABSENT ON NULL)" }
	if op="JSON_OBJECT" {
		new i,qval,v 
		set qval="JSON_OBJECT("
		for i=4:2:$l(val,"^")-1 {
			set v1=$p(val,"^",i)
			if v1'="" { set v1=$$vertVal^%qaqcmx(.mt,$p(val,"^",i)) }
			set v2=$p(val,"^",i+1)
			if v2'="" { set v2=$$vertVal^%qaqcmx(.mt,$p(val,"^",i+1)) }
			set qval=qval_v1_":"_v2_","
		}
		QUIT $e(qval,1,*-1)_")"
	}
	if op="JSON_OBJECT_ABSENT" {
		new i,qval,v 
		set qval="JSON_OBJECT("
		for i=4:2:$l(val,"^")-1 {
			set v1=$p(val,"^",i)
			if v1'="" { set v1=$$vertVal^%qaqcmx(.mt,$p(val,"^",i)) }
			set v2=$p(val,"^",i+1)
			if v2'="" { set v2=$$vertVal^%qaqcmx(.mt,$p(val,"^",i+1)) }
			set qval=qval_v1_":"_v2_","
		}
		QUIT $e(qval,1,*-1)_" ABSENT ON NULL)"
	}
	if $e(op,1,4)="JSON" {
		if op="JSON*A" QUIT "("_arg1_" IS JSON ARRAY)"
		if op="JSON*O" QUIT "("_arg1_" IS JSON OBJECT)"
		if op="JSON*S" QUIT "("_arg1_" IS JSON SCALAR)"
		if op="JSON*V" QUIT "("_arg1_" IS JSON VALUE)"
		QUIT "("_arg1_" IS JSON)"
	}
	if $e(op,1,5)="'JSON" {
		if op="'JSON*A" QUIT "("_arg1_" IS NOT JSON ARRAY)"
		if op="'JSON*O" QUIT "("_arg1_" IS NOT JSON OBJECT)"
		if op="'JSON*S" QUIT "("_arg1_" IS NOT JSON SCALAR)"
		if op="'JSON*V" QUIT "("_arg1_" IS NOT JSON VALUE)"
		QUIT "("_arg1_" IS NOT JSON)"
	}
	QUIT:$e(op,1,10)="MSCONVERT:" $$msconvert^%qaqcmx(op,arg1,arg2)
	d:"CAST,CONV,"[$e(op,1,4)_"," adcast^%qaqcmh(.arg1,$p(val,"^",4))  ; add extra CAST to locally evaluated expressions if needed
	if $g(useCAST)||$g(useCASTCHAR){
		QUIT:op="CONVERT:%Library.TimeStamp" "CAST("_arg1_" AS TIMESTAMP)"
		QUIT:op="CONVERT:%Library.PosixTime" "CAST("_arg1_" AS POSIXTIME)"
		QUIT:op="CONVERT:%Library.Date" "CAST("_arg1_" AS DATE)"	
		QUIT:op="CONVERT:%Library.Time" "CAST("_arg1_" AS TIME)" 
		QUIT:op="CONVERT:%Library.String"&&$g(useCASTCHAR) "CAST("_arg1_" AS CHAR)" 
		QUIT:op="CONVERT:%Library.String" "CAST("_arg1_" AS VARCHAR)" 
		QUIT:op="CONVERT:%Library.Integer" "CAST("_arg1_" AS INT)"
		QUIT:op="CONVERT:%Library.Double" "CAST("_arg1_" AS DOUBLE)"
		QUIT:op="CONVERT:%Library.BigInt" "CAST("_arg1_" AS BIGINT)"
		QUIT:op="CONVERT:%Library.SmallInt" "CAST("_arg1_" AS SMALLINT)"
		QUIT:op="CONVERT:%Library.TinyInt" "CAST("_arg1_" AS TINYINT)"
		QUIT:$e(op,1,8)="CONVERT:" "CONVERT("_$p(op,":",2)_","_arg1_")" ; Don't use CAST for other datatypes
	}
	else {
		QUIT:op="CONVERT:%Library.TimeStamp" "{fn CONVERT("_arg1_",SQL_TIMESTAMP)}" 
		QUIT:op="CONVERT:%Library.PosixTime" "{fn CONVERT("_arg1_",SQL_POSIXTIME)}" 
		QUIT:op="CONVERT:%Library.Date" "{fn CONVERT("_arg1_",SQL_DATE)}" 
		QUIT:op="CONVERT:%Library.Time" "{fn CONVERT("_arg1_",SQL_TIME)}" 
		QUIT:op="CONVERT:%Library.String" "{fn CONVERT("_arg1_",SQL_VARCHAR)}" 
		QUIT:op="CONVERT:%Library.Integer" "{fn CONVERT("_arg1_",SQL_INTEGER)}" 
		QUIT:op="CONVERT:%Library.Double" "{fn CONVERT("_arg1_",SQL_DOUBLE)}"
		QUIT:op="CONVERT:%Library.BigInt" "{fn CONVERT("_arg1_",SQL_BIGINT)}"
		QUIT:op="CONVERT:%Library.SmallInt" "{fn CONVERT("_arg1_",SQL_SMALLINT)}"
		QUIT:op="CONVERT:%Library.TinyInt" "{fn CONVERT("_arg1_",SQL_TINYINT)}"
	}
	QUIT:op="ABS" $$oneargfn(op)
	QUIT:op="ACOS" $$oneargfn(op)
	QUIT:op="ASIN" $$oneargfn(op)
	QUIT:op="ATAN" $$oneargfn(op)
	QUIT:op="ATAN2" $$twoargfn(op)
	QUIT:op="ASCII" $$oneargfn(op)
	QUIT:op="CEILING" $$oneargfn(op)
	QUIT:op="CAST_BIT" "CAST("_arg1_" AS BIT)"
	QUIT:op="CAST_CHAR" "CAST("_arg1_" AS CHAR "_arg2_")" 
	QUIT:op="CAST_CURRENCY" "CAST("_arg1_" AS NUMERIC(15,4))"
	QUIT:op="CAST_DATE" "CAST("_arg1_" AS DATE)"                                               //$$oneargfn(op)
	QUIT:op="CAST_DATETIME" "CAST("_arg1_" AS DATETIME)"
	QUIT:op="CAST_DOUBLE" "CAST("_arg1_" AS DOUBLE)"
	QUIT:op="CAST_INT" "CAST("_arg1_" AS INT)"
	QUIT:op="CAST_NUMERIC" "CAST("_arg1_" AS NUMERIC"_$s(arg3'="": "("_arg2_","_arg3_")", arg2'="": "("_arg2_")", 1:"")_")"
	QUIT:op="CAST_POSIXTIME" "CAST("_arg1_" AS POSIXTIME)"
	QUIT:op="CAST_SMALLDATETIME" "CAST("_arg1_" AS SMALLDATETIME)"
	QUIT:op="CAST_TIME" "CAST("_arg1_" AS TIME)"
	QUIT:op="CAST_TIMESTAMP" "CAST("_arg1_" AS TIMESTAMP)"
	QUIT:op="CAST_VARCHAR" "CAST("_arg1_" AS VARCHAR "_arg2_")"
	QUIT:op="CHAR" $$oneargfn(op)
	QUIT:op="CHARLEN" $$oneargfn(op)
	QUIT:op="CHARLEN:STREAM" "CHARACTER_LENGTH("_arg1_")"
	QUIT:op="COALESCE" $$manyargop(op)
	QUIT:op="COS" $$oneargfn(op)
	QUIT:op="COT" $$oneargfn(op)
	QUIT:op="CURDATE" $$zeroargfn(op)
	QUIT:op="CURTIME" $$zeroargfn(op)
	QUIT:op="CURTS" $$zeroargfn("NOW")
	QUIT:op="CURUTCTS" "GETUTCDATE("_arg1_")"
	QUIT:op="DATEDIFF" $$datediff^%qaqcmx()
	QUIT:op="DATEADD" $$dateadd^%qaqcmx()
	QUIT:op="DATENAME" $$oneargfn(op)
	QUIT:op="DAYNAME" $$oneargfn(op)
	QUIT:op="DAYOFMONTH" $$oneargfn(op)
	QUIT:op="DAYOFWEEK" $$oneargfn(op)
	QUIT:op="DAYOFYEAR" $$oneargfn(op)
	QUIT:op="DAY" $$oneargfn(op)
	QUIT:op="DECODE" $$manyargop(op)
	QUIT:op="DEGREES" $$oneargfn(op)
	QUIT:op="EXP" $$oneargfn(op)
	If (op="$EXTRACT") || (op="$FIND") || (op="$LENGTH") {
		if arg3'="" QUIT $$threeargop(op)
		if arg2'="" QUIT $$twoargop(op)
		QUIT $$oneargop(op)
	}
	QUIT:op="FLOOR" $$oneargfn(op)
	QUIT:op="GREATEST" $$manyargop(op)
	QUIT:op="HOUR" $$oneargfn(op)
	QUIT:op="IFNULL" $$oneargfn(op)
	If op="INSTR" {
		if arg4'="" QUIT $$fourargop("INSTR")
		if arg3'="" QUIT $$threeargop("INSTR")
		if arg2'="" QUIT $$twoargop("INSTR")
	}
	QUIT:op="ISNUMERIC" $$oneargop(op)
	if op="JUSTIFY" {
		if arg3'="" QUIT $$threeargop("$JUSTIFY")
		QUIT $$twoargop("$JUSTIFY")
	}
	QUIT:op="LASTIDENTITY" $$zeroargop("LAST_IDENTITY")
	QUIT:op="LASTDAY" $$oneargop("LAST_DAY")
	QUIT:op="LCASE" $s(foreignTableGen: $$oneargfn("LOWER"), 1:$$oneargfn(op))
	QUIT:op="LEAST" $$manyargop(op)
	QUIT:op="LEFT" $$twoargfn(op)
	QUIT:op="LENGTH" $$oneargfn(op)
	If op="LIST" {
		if arg3'="" QUIT $$threeargop("$LIST")
		if arg2'="" QUIT $$twoargop("$LIST")
		QUIT $$oneargop("$LIST")
	}
	QUIT:op="LISTBUILD" $$manyargop("$listbuild")
	If op="LISTDATA" {	
		if arg2'="" QUIT $$twoargop("$LISTDATA")
		QUIT $$oneargop("$LISTDATA")
	}
	If op="LISTFIND" {
		if arg3'="" QUIT $$threeargop("$LISTFIND")
		if arg2'="" QUIT $$twoargop("$LISTFIND")
		QUIT $$oneargop("$LISTFIND")
	}
	If op="LISTFROMSTRING" {
		if arg2'="" QUIT $$twoargop("$LISTFROMSTRING")
		QUIT $$oneargop("$LISTFROMSTRING")
	}
	If op="LISTGET" {
		if arg3'="" QUIT $$threeargop("$LISTGET")
		if arg2'="" QUIT $$twoargop("$LISTGET")
		QUIT $$oneargop("$LISTGET")
	}
	QUIT:op="LISTLENGTH" $$oneargop("$LISTLENGTH")
	QUIT:op="LISTSAME" $$twoargop("$LISTSAME")
	If op="LISTTOSTRING" {
		if arg2'="" QUIT $$twoargop("$LISTTOSTRING")
		QUIT $$oneargop("$LISTTOSTRING")
	}
	If op="STRING" {
		QUIT $$manyargop("STRING")
	}
	QUIT:op="LOG" $$oneargfn(op)
	QUIT:op="LOG10" $$oneargfn(op)
	if op="LPAD" {
		 QUIT:arg3'="" $$threeargop("LPAD")
		 QUIT $$twoargop("LPAD")
	}
	QUIT:op="LTRIM" $$oneargfn(op)
	QUIT:op="MINUTE" $$oneargfn(op)
	QUIT:op="MOD" $$twoargfn(op)
	QUIT:op="NVL" $select($g(nvl):$$twoargfn("NVL"),1:$$twoargfn("IFNULL"))
	QUIT:op="MONTH" $$oneargfn(op)
	QUIT:op="MONTHNAME" $$oneargfn(op)
	QUIT:op="PATINDEX" $$twoargop("PATINDEX")
	QUIT:op="PI" $$oneargfn(op)
	If op="PIECE" {
		if arg4'="" QUIT $$fourargop("$PIECE")
		if arg3'="" QUIT $$threeargop("$PIECE")
		if arg2'="" QUIT $$twoargop("$PIECE")
		QUIT $$oneargop("$PIECE")
	}
	QUIT:op="POWER" $$twoargfn(op)
	QUIT:op="QUARTER" $$oneargfn(op)
	QUIT:op="RADIANS" $$oneargfn(op)
	QUIT:op="REPEAT" $$twoargfn(op)
	QUIT:op="REPLACE" op_"("_arg1_","_arg2_","_arg3_")"
	QUIT:op="RIGHT" $$twoargfn(op)
	QUIT:(op="ROUND")&&($g(arg3)="") $$twoargfn(op)
	QUIT:(op="ROUND")&&($g(arg3)'="") $$threeargfn(op)
	if op="RPAD" {
		 QUIT:arg3'="" $$threeargop("RPAD")
		 QUIT $$twoargop("RPAD")
	}
	QUIT:op="RTRIM" $$oneargfn(op)
	QUIT:op="SECOND" $$oneargfn(op)
	QUIT:op="SIGN" $$oneargfn(op)
	QUIT:op="SIN" $$oneargfn(op)
	QUIT:op="SPACE" $$oneargfn(op)
	QUIT:op="SQRT" $$oneargfn(op)
	QUIT:op="STR" "STR("_arg1_$s(arg3'="": ", "_arg2_", "_arg3, arg2'="": ", "_arg2, 1:"")_")"
	QUIT:op="STRING" $$threeargfn("SUBSTRING")
	QUIT:op="STUFF" $$fourargop(op)
	QUIT:$e(op,1,9)="SUBSTRING" $$threeargfn("SUBSTRING")	// might be SUBSTRING:STREAM
	QUIT:op="TAN" $$oneargfn(op)
	QUIT:((op="TOCHAR")&(arg2="")) "TO_CHAR("_arg1_")"
	QUIT:op="TOCHAR" "TO_CHAR("_arg1_","_arg2_")"
	QUIT:op="TODATE" "TO_DATE("_$s($g(arg2)'="":arg1_","_arg2,1:arg1)_")"
	QUIT:op="TOPOSIXTIME" "TO_POSIXTIME("_$s($g(arg2)'="":arg1_","_arg2,1:arg1)_")"
	QUIT:op="TOTIMESTAMP" "TO_TIMESTAMP("_$s($g(arg2)'="":arg1_","_arg2,1:arg1)_")"
	QUIT:op="TO_VECTOR" "TO_VECTOR("_arg1_$s(arg2'="":", "_$tr(arg2,"(')") _ $s(arg3'="":", "_$tr(arg3,"(')"), 1:""), 1:"") _ ")"
	if op="TRANSLATE" {
		if arg3'="" QUIT $$threeargop("$TRANSLATE")
		QUIT $$twoargop("$TRANSLATE")
	}
	QUIT:op="TRUNCATE" $$twoargfn(op)
	QUIT:op="TSQL_BIT_AND" $$twoargop("$TSQL_BIT_AND")
	QUIT:op="TSQL_BIT_OR" $$twoargop("$TSQL_BIT_OR")
	QUIT:op="TSQL_BIT_XOR" $$twoargop("$TSQL_BIT_XOR")
	QUIT:op="TSQL_BIT_NOT" $$oneargop("$TSQL_BIT_NOT")
	QUIT:op="TSQL_COL_NAME" $$oneargop("$TSQL_COL_NAME")
	QUIT:op="TSQL_INDEX_COL" $$fourargop("$TSQL_COL_NAME")
	if op="TSQL_LIKE" {
		if arg3'="" { QUIT $$threeargop("$TSQL_LIKE") }
		QUIT $$twoargop("$TSQL_LIKE")
	}
	QUIT:op="TSQL_LTRIM_SYBASE" $$oneargop("$TSQL_LTRIM_SYBASE")
	QUIT:op="TSQL_NEWID" "$TSQL_NEWID"
	QUIT:op="TSQL_OBJECT_ID" $$oneargop("$TSQL_OBJECT_ID")
	QUIT:op="TSQL_OBJECT_NAME" $$oneargop("$TSQL_OBJECT_NAME")
	QUIT:op="TSQL_PLUS" $$manyargop("$TSQL_PLUS")
	if op="TSQL_RAND" {
		if arg1'="" { QUIT $$oneargop("$TSQL_RAND") }
		QUIT "$TSQL_RAND()"
	}
	QUIT:op="TSQL_RTRIM_SYBASE" $$oneargop("$TSQL_RTRIM_SYBASE")
	if $p(op,"_")="TSQL" { QUIT "$"_op }  // All the rest of the $TSQL functions
	QUIT:op="CHARINDEX" "CHARINDEX("_arg1_","_arg2_")"  //$$twoargfn(op)
	if (op="TRIM_BOTH")||(op="TRIMSPACE_BOTH") {
		if arg2="" QUIT "TRIM("_arg1_")"
		QUIT "TRIM("_arg1_" FROM "_arg2_")"
	}
	if (op="TRIM_LEADING")||(op="TRIMSPACE_LEADING") {
		if arg2="" QUIT "TRIM(LEADING "_arg1_")"
		QUIT "TRIM(LEADING "_arg1_" FROM "_arg2_")"
	}
	if (op="TRIM_TRAILING")||(op="TRIMSPACE_TRAILING") {
		if arg2="" QUIT "TRIM(TRAILING "_arg1_")"
		QUIT "TRIM(TRAILING "_arg1_" FROM "_arg2_")"
	}
	QUIT:(op="%UPPER"||(op="UCASE")) $s(foreignTableGen: $$oneargfn("UPPER"), 1:$$oneargfn("UCASE"))	// ucase not as widely used in other DBs so for FTs we'll generate UPPER()
	QUIT:op="VECTOR_COSINE" $$twoargop(op)
	QUIT:op="VECTOR_DOT_PRODUCT" $$twoargop(op)
	QUIT:op="WEEK" $$oneargfn(op)
	QUIT:op="YEAR" $$oneargfn(op) 
	// by returning "" we will use toper which will do the || concatenation
	QUIT:op="_" $s(foreignTableGen: "", 1:$$twoargfn("CONCAT"))
	QUIT:op="%OID" $$oneargop(op)
	QUIT:op="%ALPHAUP" $$oneargop(op)
.
	QUIT ""
	// end of scalFunc(val)
---
