====
qaGenDS
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaGenDS^MAC^^^0
#include %sySystem
#include %occExtent
.
#define markdownMacroEntry "### MacroName: "
#define macrosGlobal "^macros"
#define AddLine(%file,%line) if md=0 {s ^rINC(%file,0,0)=$increment(^rINC(%file,0,0)),^rINC(%file,0,^rINC(%file,0,0))=%line} else {s ^mdLines(%file)=$increment(^mdLines(%file)),^mdLines(%file,^mdLines(%file))=%line}
#define AddLineToMacroDescription(%macroName,%line) set @$$$macrosGlobal@(%macroName,0,0)=$increment(@$$$macrosGlobal@(%macroName,0)),@$$$macrosGlobal@(%macroName,0,@$$$macrosGlobal@(%macroName,0,0))=%line
.
generateHeader(outputFile,md=0)	{
    set linePrefix = $s(md=0:"/// ",1:"")
	$$$AddLine(outputFile,linePrefix_"**********************************************************************")
	#; do Copyright^%apiOBJ(.lines,linePrefix_"* ")
	#; for line=1:1:lines {
    #;     $$$AddLine(outputFile,lines(line))
    #; }
	$$$AddLine(outputFile,linePrefix_"**********************************************************************")
	$$$AddLine(outputFile,linePrefix_"* This file is generated by routine ^%qaGenDS")
	$$$AddLine(outputFile,linePrefix_"* Please DO NOT edit")
	$$$AddLine(outputFile,linePrefix_"**********************************************************************")
    $$$AddLine(outputFile,"")
	QUIT
}
.
writeMacrosFromJSON(aslDocumentationFile,outputFile,md=0) [children,macrosJSON,sortedMacroNames,writtenMacrosInOrder] PUBLIC {
    try {
        new children,macrosJSON,sortedMacroNames,writtenMacrosInOrder
        set macrosJSON = ##class(%Library.DynamicAbstractObject).%FromJSONFile(aslDocumentationFile)
.
        set linePrefix = $s(md=0:"/// ",1:"")
        
        if macrosJSON.%IsDefined("additionalFileDescription") {
            for i=1:1:$length(macrosJSON.additionalFileDescription, $char(10)) {
                set line = $piece(macrosJSON.additionalFileDescription, $char(10), i)
                $$$AddLine(outputFile,linePrefix_line)
            }
            $$$AddLine(outputFile,"")
        }
.
        if macrosJSON.%IsDefined("pedigreeInfo") {
            $$$AddLine(outputFile,linePrefix_"============ Custom Ordering of $Piece Macros ==========================================")
            $$$AddLine(outputFile,linePrefix_"When no exact match is found between the argument of a $piece macro and its parent macro, a warning is generated.")
            $$$AddLine(outputFile,linePrefix_"However, one can offer alternative child-parent links in the ""pedigreeLink"" property in '//"_$p(aslDocumentationFile,"/",*-5,*)_"'")
            $$$AddLine(outputFile,linePrefix_"Some custom-set ordering rules will appear here:")
            set it = macrosJSON.pedigreeInfo.%GetIterator()
            while it.%GetNext(.key,.pedigreeLink) {
                set parentToLinkTo(pedigreeLink.parameter) = pedigreeLink.parent
                $$$AddLine(outputFile,linePrefix_"- $piece macros referencing parameter '"_pedigreeLink.parameter_"' will directly follow the parent macro '"_pedigreeLink.parent_"' in order of appearance.")
            }
            $$$AddLine(outputFile,linePrefix_"=================================================================================")
            $$$AddLine(outputFile,"")
        }
.
.
        // Create alphabetically sorted array of non-$piece macros
        if macrosJSON.%IsDefined("macros") {
            // Sort all macros by definition before processing
            set it = macrosJSON.macros.%GetIterator()
            while it.%GetNext(.key,.macro) {
                if (macro.definition.value'="") && (macro.macroName'="") {
                    if $d(sortedMacroNames(macro.macroName)) {
                        do $system.Status.DisplayError($$$ERROR($$$GeneralError,"Macro '"_macro.macroName_"' is defined more than once, macro names must be unique."))
                        RETURN
                    }
                    if $d(sortedDefinitions(macro.definition.value)) {
                        write "WARNING: macro '"_macro.macroName_"' is reusing the same definition ('"_macro.definition.value_"') as macros: "
                        set repeatedMacros = ""
                        set key1 = ""
                        for {
                            set key1 = $o(sortedDefinitions(macro.definition.value,key1))
                            QUIT:key1=""
                            set repeatedMacros = repeatedMacros_", '"_sortedDefinitions(macro.definition.value,key1)_"'"
                        }
                        write $e(repeatedMacros,3,*),! // Remove leading ", "
                    }
                    do $i(sortedDefinitions)
                    set sortedDefinitions(macro.definition.value,key)=macro.macroName
                    set sortedMacroNames(macro.macroName)=key
                    
                    if ($e(macro.definition.value,1,2)="$p") || ($e(macro.definition.value,1,2)="$e") || ($e(macro.definition.value,1,2)="$l") {
                        do $i(sortedPieceMacros)
                        set sortedPieceMacros(macro.definition.value,key)=macro.macroName
                    } else {
                        do $i(sortedNonPieceMacros)
                        set sortedNonPieceMacros(macro.definition.value,key)=macro.macroName
                    }
                } else {
                    write "WARNING: some macros were skipped because they did not have a macroName or a definition.value ("_$s(macro.macroName'="":"macro.macroName: "_macro.macroName_", ",macro.definition.value'="":"macro.definition.value: "_macro.definition.value,1:"")_")",!
                }
            }
.
            #; 1. first put all non-$piece macros as first level dads in pedigree(level1orderOfDad1,dad1,)= jsonKeyOfDad1Macro, pedigree(level1orderOfDad2,dad2)=jsonKeyOfDad2Macro... where the level orders are fetched from the alphabetical ordering of the dad's macro.definition.value (maybe have that no hand before starting this)
            #; 2. process all macros whose definition start with $p( by just doing one directional children array children(parentMacroName,pieceNum)=childMacroName
            #; 3. now loop over first level of dads, as in pedigree(orderOfDad1,dad1) then get all children(dad1) and add them in order under pedigree(orderOfDad1,dad1,pieceNumOfChild1,child1macro)=jsonKeyOfChild1Macro. then recursively keep doing that for all children till every original definition has been covered??
            #; 4. now go in order of pedigree nodes and just use the JSON key stored at every node to write into the file using writeMacroGivenJsonKey(macrosJSON,key,def,outputFile)
.
            // === Step 1: Create pedigree structure with pedigree(orderInLevel1,macroName1) where macroName1 is a parent macro that
            // may later have children nodes to be written directly under it, as will be defined in the children array (a child of macroName1
            // is one whose definition is a $piece of macroName1 (e.g., "$p(<macroName1>,...)")
            // And pedigree = count of non-$piece macros 
            set level1MacroDef = ""
            for {
                set level1MacroDef = $o(sortedNonPieceMacros(level1MacroDef))
                QUIT:level1MacroDef=""
.
                set level1MacroKey = ""
                for {
                    set level1MacroKey = $o(sortedNonPieceMacros(level1MacroDef,level1MacroKey),1,level1MacroName)
                    QUIT:level1MacroKey=""
.
                    set pedigree($i(pedigree),level1MacroName)=level1MacroKey
                }            
            }
.
            // === Step 2: Process all macros whose definition start with $p and populate a one directional children array with:
            // children(parentMacroName,pieceNum)=$lb(child1MacroName,[child2MacroName,])
            // This is to allow multiple macros to potentially reference the same piece of the same node
            set childMacroKey = ""
            set childMacroDef = ""
            for {
                set childMacroDef = $o(sortedPieceMacros(childMacroDef))
                QUIT:childMacroDef=""
.
                set childMacroKey = ""
                for {
                    set childMacroKey = $o(sortedPieceMacros(childMacroDef,childMacroKey),1,childMacroName)
                    QUIT:childMacroKey=""
.
                    // We know childMacroDef starts with "$p":
                    //   1. If it's $p(%<parentMacroName>,...) such that parentMacroName is a node in sortedMacroNames, then add it to children(parentMacroName,pieceNum)=childMacroName
                    //   2. Otherwise (unless it's linked to another parent defined in macrosJSON.pedigreeInfo), then consider it a stranded child
                    //      and add it to pedigree on its own as a new parent
                    set parentMacroName = $e($p($e(childMacroDef,4,*),",",1),2,*) // Skip the first character "%"
                    set pieceNum = $e($p(childMacroDef,",",*),1,*-1) // Skip the last character ")"
                    if (parentMacroName="")||(pieceNum="") {
                        set pedigree($i(pedigree),childMacroName) = childMacroKey
                        CONTINUE
                    }
.
                    // Child exists but parent doesn't; check if there's a link of this childMacroName (e.g., aslId) to another parent macro (e.g., aslKId)
                    if '$d(sortedMacroNames(parentMacroName)) {
                        write "         ... macro '"_childMacroName_"' is a $piece macro but we were unable to find its referenced parent '"_parentMacroName_"' in the list of macros",!
                        write "         ... checking for possible links under macrosJSON.pedigreeInfo ...",!
                        set possibleParent = $g(parentToLinkTo(parentMacroName))
                        // Testing link to possible parent
                        if possibleParent="" {
                            write "WARNING: None found, this macro will appear at an unpredictable order. You can edit macrosJSON.pedigreeInfo to create custom child-parent links for ordering purposes.",!
                            set pedigree($i(pedigree),childMacroName) = childMacroKey
                        } elseif '$d(sortedMacroNames(possibleParent)) {
                            write "WARNING: Found a child-parent link in macrosJSON.pedigreeInfo but '"_possibleParent_"' is not a defined macro.",!
                            set pedigree($i(pedigree),childMacroName) = childMacroKey
                        } else {
                            // possibleParent is a defined macro!
                            write "         Found parent '"_possibleParent_"' to substitute '"_parentMacroName_"' - '"_childMacroName_"' will now appear under it as p"_pieceNum_"!",!
                            set children(possibleParent,pieceNum) = $g(children(possibleParent,pieceNum))_$lb(childMacroName)
                            do $i(children)
                        }
                        CONTINUE
                    }
.
                    set children(parentMacroName,pieceNum) = $g(children(parentMacroName,pieceNum))_$lb(childMacroName)
                }
            }
.
            // === Step 3: Now loop over the top parents level, pedigree(orderOfParent1,parent1MacroName) then get all of children(parent1) and add them in their $piece order under
            // pedigree(orderOfParent1,parent1,pieceNumOfChild1,child1Macro)=jsonKeyOfChild1Macro. Then recursively keep doing that for all children
            set parentOrder = ""
            for {
                set parentOrder = $o(pedigree(parentOrder))
                QUIT:parentOrder=""
                
                set parentMacroName = ""
                set indentation = 0
                for {
                    set parentMacroName = $o(pedigree(parentOrder,parentMacroName))
                    QUIT:parentMacroName=""
.
                    // Write macro for this node and recurse on its children to be written directly under it
                    do writeMacroGivenJsonKey(macrosJSON,sortedMacroNames(parentMacroName),outputFile,.writtenMacrosInOrder,md,indentation)
                    do writeChildrenOf(parentMacroName,outputFile,md,indentation+1)
                }
            }
.
            // Save & close
            write "Macros were written to "_outputFile,!
            set macroName = ""
            for {
                set macroName = $o(sortedMacroNames(macroName))
                QUIT:macroName=""
                if '$lf(writtenMacrosInOrder,macroName) {
                    write "WARNING: macro '"_macroName_"' was skipped",!
                }
            }
        } else {
            write "No macros found in JSON file.",!
        }
.
        if md=0 {
            do RebuildItemIndex^%R(outputFile,"INC")
            set rtnname = outputFile_".INC"
            set extname = ##class(%Studio.SourceControl.ISC).ExtName(rtnname)
            write "Outputting ",rtnname," to ",extname,!
            do Export^%apiRTN(rtnname,extname,,,"/diffexport")
        } else {
            set fileObj = ##class(%File).%New(^Sources_"internal/docs/sql/"_outputFile)
            set status = fileObj.Open("WSN")
            If $$$ISERR(status) { 
                Do $system.Status.DisplayError(status) 
                QUIT
            }
.
            set lineNum=""
            for {
                set lineNum = $o(^mdLines(outputFile,lineNum))
                QUIT:lineNum=""
                do fileObj.WriteLine(^mdLines(outputFile,lineNum))
            }
.
            write "Outputting to "_^Sources_"internal/docs/sql/"_outputFile,!
.
            Do fileObj.Close()
        }
        QUIT
    } catch ex {
        throw ex
    }
}
.
writeChildrenOf(parent,outputFile,md=0,indentation=0) [children,macrosJSON,sortedMacroNames,writtenMacrosInOrder] PRIVATE {
    // Return if node has no children
    if '$d(children(parent)) {
        RETURN
    }
.
    set childPieceNum = ""
    for {
        set childPieceNum = $o(children(parent,childPieceNum),1,childrenMacroNameList)
        QUIT:childPieceNum=""
.
        // Write current children representing this piece and recurse over their children
        set ptr = 0
        while $LISTNEXT(childrenMacroNameList,ptr,childMacroName) {
            if md=0 {
                do writeMacroGivenJsonKey(macrosJSON,sortedMacroNames(childMacroName),outputFile,.writtenMacrosInOrder)
                do writeChildrenOf(childMacroName,outputFile)
            } else {
                do writeMacroGivenJsonKey(macrosJSON,sortedMacroNames(childMacroName),outputFile,.writtenMacrosInOrder,md,indentation,childPieceNum)
                do writeChildrenOf(childMacroName,outputFile,md,indentation+1)
            }
        }
    }
}
.
.
writeMacroGivenJsonKey(macrosJSON,key,outputFile,writtenMacrosInOrder,md=0,indentation=0,childPieceNum=0) PRIVATE {
    set macro = macrosJSON.macros.%Get(key)
    set writtenMacrosInOrder = $g(writtenMacrosInOrder)_$lb(macro.macroName)
                    
    // === Description ===
    if md=1 {
        $$$AddLine(outputFile,"")
        set indentationLine = ""
        for i=1:1:indentation {
            set indentationLine = indentationLine_$c(9)
        }
        if childPieceNum'=0 {
            $$$AddLine(outputFile,indentationLine_"Piece "_childPieceNum_" = "_macro.definition.value_" ($$$"_macro.macroName_"):")
        } else {
            // it's a parent/non-$piece node
            $$$AddLine(outputFile,indentationLine_macro.definition.value_" ($$$"_macro.macroName_"):")
        }
    }
.
    set desc = macro.description
    for i=1:1:$length(desc, $char(10)) {
        set line = $piece(desc, $char(10), i)
        // one more indentaion when description starts
        if md=0 {
            $$$AddLine(outputFile,"/// "_line)
        } else {
            set:desc="" line="<Empty description so far>"
            $$$AddLine(outputFile,indentationLine_$c(9)_line)
        }
    }
.
    // === Parameters ===
    if md=0 {
        set argList = ""
        set params = macro.parameters
        if params'="" {
            set pIter = params.%GetIterator()
            while pIter.%GetNext(.pKey, .param) {
                set argList = argList _ param.name _ ","
            }
            // Remove trailing comma
            if $length(argList) > 0 {
                set argList = $extract(argList, 1, *-1)
            }
.
            set:argList'="" argList = "(" _ argList _ ")"
        }
        // Output the macro line
        $$$AddLine(outputFile,"#define " _ macro.macroName _ argList _ " " _ macro.definition.value)
    }
.
}
.
sourceControl(aslDocumentationFile="",generatedFilePath,generatedPath) PRIVATE {
    #; This was set in ^build: set ^Sources("INC",outputFile)="databases/sys/generated/" // used in Export^%R to know where to write the .inc file
	read "Auto checkout (Y/N): (Y)",auto,!
	set auto = $zconvert(auto,"l")
    set auto = $case(auto,"":1,"y":1,:0)
	if auto {
		if '$data(^%SYS("SourceRoot",0)) {
			write "Source control setting not setup, please enter the following information (this will not be stored)",!
			read "Perforce username: ",username,! if username="" QUIT
			read "Perforce password: ",password,! if password="" QUIT
			read "Workspace: ",workspace,! if workspace="" QUIT
			set ^%SYS("SourceRoot",0) = $lb(username,password,workspace,,"perforce.iscinternal.com:1666")
			set setup = 1
		}
		set name = ""
        // read aslFormatted.md documentation file and generate macros from it
        set args($i(args)) = "sync"
        set args($i(args)) = generatedPath_"..."
        set sc = ##class(%Studio.SourceControl.ISC).SecureRunCmd("p4",.args)
        // ***
        kill args
        set args($i(args)) = "edit"
        set args($i(args)) = generatedFilePath
        set sc = ##class(%Studio.SourceControl.ISC).SecureRunCmd("p4",.args)
        if $$$ISERR(sc) do DisplayError^%apiOBJ(sc) GOTO exit
	} else {
		write "Files in the following directories will be updated, manually check these out",!
        write generatedFilePath,!
		read "Continue (Y):",continue
		if $zconvert(continue,"l")="n" GOTO exit
	}
	write !,"Generating file: "_generatedFilePath,!,"From file:       "_aslDocumentationFile,!
    RETURN
exit
    if $get(setup) {
        kill ^%SYS("SourceRoot",0)
    }
    kill ^mdLines
    if $$$ISERR(sc) {
	    throw
    }
}
.
generateAslMacros() PUBLIC {
    // Note for *** in writeMacrosFromJSON
    // In the first iteration of the ASL Documentation project, when aslMacros.inc did not exist in the branch,
    // you have to comment all of these p4 commands as they would fail on a non-existing file. Steps:
    // 1. Update build.mac so that it maps the macros file onto the /generated/ directory 
    //    (see Setup^build: 'set ^Sources("INC","%aslMacros")="databases/sys/generated/"')
    // 2. Compile build.mac and run zbuild again to fix the mappings
    // 3. Simply comment these p4 commands below (you might need to manually check out other files like aslFormatted.json)
    // 4. Run this method, and (potentially before that) make sure to check out the databases/sys/generated/_aslMacros.inc file
    // 5. Then uncomment these commands for consequent runs of this method
    set outputFile = "%aslMacros"
    set generatedFilePath = ^Sources_"databases/sys/generated/_aslMacros.inc"
    set generatedPath = ^Sources_"databases/sys/generated/"
	kill ^rINC(outputFile)
	set ^rINC(outputFile,0) = $H
    set ^rINC(outputFile,0,0) = 0
    set aslDocumentationFile = ^%SYS("SourceRoot")_"databases/sys/keywords/aslFormatted.json"
    do sourceControl(aslDocumentationFile,generatedFilePath,generatedPath)
    do generateHeader(outputFile)
    do writeMacrosFromJSON(aslDocumentationFile,outputFile)
}
.
generateAslMd() PUBLIC {
    // Note for *** in writeMacrosFromJSON
    // In the first iteration of the ASL Documentation project, when aslMacros.inc did not exist in the branch,
    // you have to comment all of these p4 commands as they would fail on a non-existing file. Steps:
    // 1. Update build.mac so that it maps the macros file onto the /generated/ directory 
    //    (see Setup^build: 'set ^Sources("MD","%aslMacros")="internal/docs/sql/"')
    // 2. Compile build.mac and run zbuild again to fix the mappings
    // 3. Simply comment these p4 commands below (you might need to manually check out other files like aslFormatted.json)
    // 4. Run this method, and (potentially before that) make sure to check out the internal/docs/sql/asl.md file
    // 5. Then uncomment these commands for consequent runs of this method
    set outputFile = "asl.md"
    set generatedFilePath = ^Sources_"internal/docs/sql/asl.md"
    set generatedPath = ^Sources_"internal/docs/sql/"
	kill ^mdLines
    try {
        set aslDocumentationFile = ^%SYS("SourceRoot")_"databases/sys/keywords/aslFormatted.json"
        do sourceControl(aslDocumentationFile,generatedFilePath,generatedPath)
        do generateHeader(outputFile,1)
        do writeMacrosFromJSON(aslDocumentationFile,outputFile,1)
        kill ^mdLines
    } catch ex {
        kill ^mdLines
        throw ex
    }
}
.
generateMtMd() PUBLIC {
    // Note for *** in writeMacrosFromJSON
    // In the first iteration of the Documentation project, when mtMacros.inc did not exist in the branch,
    // you have to comment all of these p4 commands as they would fail on a non-existing file. Steps:
    // 1. Update build.mac so that it maps the macros file onto the /generated/ directory 
    //    (see Setup^build: 'set ^Sources("MD","%mtMacros")="internal/docs/sql/"')
    // 2. Compile build.mac and run zbuild again to fix the mappings
    // 3. Simply comment these p4 commands below (you might need to manually check out other files like mtFormatted.json)
    // 4. Run this method, and (potentially before that) make sure to check out the internal/docs/sql/mt.md file
    // 5. Then uncomment these commands for consequent runs of this method
    set outputFile = "mt.md"
    set generatedFilePath = ^Sources_"internal/docs/sql/mt.md"
    set generatedPath = ^Sources_"internal/docs/sql/"
	kill ^mdLines
    try {
        set mtDocumentationFile = ^%SYS("SourceRoot")_"databases/sys/keywords/mtFormatted.json"
        do sourceControl(mtDocumentationFile,generatedFilePath,generatedPath)
        do generateHeader(outputFile,1)
        do writeMacrosFromJSON(mtDocumentationFile,outputFile,1)
        kill ^mdLines
    } catch ex {
        kill ^mdLines
        throw ex
    }
}
.
generateMtMacros() PUBLIC {
    // Note for *** in writeMacrosFromJSON
    // In the first iteration of the ASL Documentation project, when mtMacros.inc did not exist in the branch,
    // you have to comment all of these p4 commands as they would fail on a non-existing file. Steps:
    // 1. Update build.mac so that it maps the macros file onto the /generated/ directory 
    //    (see Setup^build: 'set ^Sources("MD","%mtMacros")="internal/docs/sql/"')
    // 2. Compile build.mac and run zbuild again to fix the mappings
    // 3. Simply comment these p4 commands below (you might need to manually check out other files like mtFormatted.json)
    // 4. Run this method, and (potentially before that) make sure to check out the internal/docs/sql/mt.md file
    // 5. Then uncomment these commands for consequent runs of this method
    set outputFile = "%mtMacros"
    set generatedFilePath = ^Sources_"databases/sys/generated/_mtMacros.inc"
    set generatedPath = ^Sources_"databases/sys/generated/"
	kill ^rINC(outputFile)
	set ^rINC(outputFile,0) = $H
    set ^rINC(outputFile,0,0) = 0
    set mtDocumentationFile = ^%SYS("SourceRoot")_"databases/sys/keywords/mtFormatted.json"
    do sourceControl(mtDocumentationFile,generatedFilePath,generatedPath)
    do generateHeader(outputFile)
    do writeMacrosFromJSON(mtDocumentationFile,outputFile)
}
.
generate() PUBLIC {
    // (Must be called from %SYS) Method to generate both the macros & markdown files for ASL and MT
    write "Generating ASL macros file...",!
    do generateAslMacros^%qaGenDS()
    write !,!,"Generating ASL markdown file ...",!
    do generateAslMd^%qaGenDS()
    write "Generating MT macros file...",!
    do generateMtMacros^%qaGenDS()
    write !,!,"Generating MT markdown file...",!
    do generateMtMd^%qaGenDS()
}
---
