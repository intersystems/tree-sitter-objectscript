^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqosrt^MAC^^^0
%qaqosrt    // QO - Sort creation algorithms
	;; COMPONENTS :: SQL/Optimizer
	#;
#INCLUDE %msql
#INCLUDE %qao
   	#; 
	#; ---------------------------------------------------------------------
	#;  Description:   QO - Sort creation algorithms
	#;  Author:        Terry Ragon
	#;  Date:          December 17, 1987
	#;  Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	#; 
	#;   PVA177 (05/06/2009) - Fix undesired plan bias for DISTINCT queries when there is no good index for DISTINCT 
	#;   PVA154 (09/01/2008) - Improve optimizer cost model : distinguish selectivity for complex conditions on map subscripts from that on map data
	#;   PVA072 (11/10/2004) - Support pseudo conditions implied by TOP... ORDER BY in optimizer
	#;   DPV702 (01/03/97) - Made $$is^%qaois a local call via a #INCLUDE
	#; 
	#; ---------------------------------------------------------------------
	#;                      I N F O R M A T I O N
	#; ---------------------------------------------------------------------
	#; 
	#;  A variety of internal entry points, whose names correspond to
	#;      the sort creation algorithm #s, is used.
	#;  call: qoorder: map automatically produces an interesting order
	#;      qojrid: 1 if interesting order is record id
	#;      form():  input cost formula parameters for map
	#;  output:
	#;      value of extrinsic: the cost to create, read, and delete
	#;                   the temp sort file, in the format:
	#;                 cost,cd,cgg,cgs
	#;      array tform() contains cost formula parameters to be used
	#;                 in subsequent join or initial stream algorithm
	#;                 It reflects characteristics of the created sort file
	#;      array tchange() equivalent of change() for temp file
	#; 
	#;  The algorithms that use these sort files should expect
	#;  parameters to be in the "index" file set of parameters, as
	#;  if "map0" didn't have to be referenced (or as if this was map0)
	#; 
	#;  Do we convert $$$SSOIMUL to $$$SSO0MUL? I think so - check joins
	#; 
	#; 
	#; ---------------------------------------------------------------------
	#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
s1()    RETURN $$sortout("IS12")
s2()    RETURN $$sortout("IS8")
s3()    RETURN $$sortout("IS9")
s4()    RETURN $$seqout("IS4")
s5()    RETURN $$seqout("IS5")
s6()    RETURN $$seqout("IS6")
s7()    RETURN $$seqout("IS7")
s8()    new cost s cost=$$s8sub^%qaqoidx g s13a
s9()    RETURN $$seqout("IS2")
s10()   RETURN $$seqout("IS3")
s11()   RETURN $$sortout("IS10")
s12()   RETURN $$sortout("IS11")
s13()   n cost s cost=$$s13sub^%qaqoidx ; create initial index
s13a    n x,y s tform($$$SZB)=1,tform($$$SL2B)=1 ; these we be reset, but for 
    	#;                                     now define them for the for loop
    f i=1:1:$$$SUBMAX s x(i)=tform(i) ;now copy tform to a scratch array x
        #;  act as if we're using the record id as the JA, since
        #;  that is how the first subscript is ordered
        #;  PVA072: Fix longstanding bug exposed more by TOP changes: saving 
        #;          and restoring SSOIMUL/SSO0MUL overwrote the transform done
        #;          on them by settform as used in sortout from s13sub. This was
        #;          relied on by the join algs that used sort files. 
    s x=qojrid,qojrid=1 f i=$$$SSJA,$$$SSJASUB,$$$SSJAADD,$$$SSJAADDM s y(i)=tform(i)
	    #;  PVA072: Fix inconsistency with first phase of IC6 - setting of x($$$SSJA)
    s x($$$SSJASUB)=1/tform($$$SNitup),x($$$SSJAADD)=1,x($$$SSJAADDM)=1,x($$$SSJA)=x($$$SSJASUB),x($$$SL2B)=tform($$$SNitup),x($$$SZB)=1
        #;  PVA072: In this case we don't set MUL entries to 1, because settform
        #;          used within sortout by s13sub uses them and takes care of 
        #;          setting them to 1 within the actual IS cost formula input. 
    s cost=$$addcost(cost,$$s13sub(.x))
        #;  now readjust tform to reflect fact that we are really
        #;  ordered on the JA, not on the record id
    s qojrid=x f i=$$$SSJA,$$$SSJASUB,$$$SSJAADD,$$$SSJAADDM s tform(i)=y(i)
    d change,fintform
    RETURN cost
	    #; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	    #;  calculate cost to creat sort file (2nd temp file) given temp indx
s13sub(form) ; this is a way of renaming 'x' array to be 'form' array
    RETURN $$sortout("IS1")
	    #; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
s14()   RETURN $$sortout("IS10")
	    #; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
sortout(%is) ;
        #;  input variable:
        #;      is:  initial stream algorithm that can be used to process
        #;           the stream to produce desired set of tuples
        #;  return extrinsic value: cost of processing initial stream
        #;  return variables:
        #;       tform($$$SNiblk),tform($$$SGPi),tform($$$SNitup)
        #;      outseq and outsort as described below for 'sortcost'
    n a,numtup,cost,outseq,outsort d settform ; init tform array
    s a=$$is^%qaois(%is,qojrid,PBP8),numtup=+$p(a,"^",2),tform($$$SNitup)=numtup,cost=$p(a,"^") ; calculate cost of processing stream
    d sortcost ; get cost of sorting output and later reading and deleting it
    d change,fintform
    RETURN $$addcost(cost,outsort)
	    #; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
seqout(%is) ;
	    #;  just like $$sortout(is) except output can be stored in a seq file
    n a,numtup,cost,outseq,outsort d settform ; init tform array
    s a=$$is^%qaois(%is,qojrid,PBP8),numtup=+$p(a,"^",2),tform($$$SNitup)=numtup,cost=$p(a,"^") ; calculate cost of processing stream
    d sortcost ; get cost of sorting output and later reading and deleting it
    d change,fintform
    RETURN $$addcost(cost,$s(qoorder:outseq,1:outsort))
	    #; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
sortcost ;
        #;  calculate cost to store output of sort, read it, and delete it
        #; return variables:
        #;      outseq: cost to output results in a sequential temp file
        #;              and later read and delete the temp file
        #;      outsort: cost to output results in a sorted temp file
        #;              and later read and delete the temp file
        #;      tform($$$SNiblk) = # blocks in sort file
        #;      tform($$$SGPi) = # data nodes per sort file tuple
    n a,b,c,bytes,baby,cgs,cgg,cd,blocks
        #;  determine amount of data in a temp output file
        #;  count 7 overhead bytes per global node
    s bytes=outnodes*7+$p(outnodes,",",3) ; bytes = # bytes per tuple
    	#;  determine cost to produce, read, and delete a sequential file
    s blocks=numtup*bytes\$$$DBBlockSize+1 ; # blocks for a seq created file
    s cgs=numtup*outnodes+TEMPCGS,a=blocks,cd=a*3+TEMPCD ; must write block, read block, and garbage collect (write) it
    s b=numtup*(outnodes+1),cgg=b+TEMPCGG ; assumes have to do a $O per tuple on read
    s outseq=((cd*CDFACTOR)+(cgs*CGSFACTOR)+(cgg*CGGFACTOR))_","_cd_","_cgg_","_cgs
	    #;  determine cost to produce, read, and delete a sort file
    s blocks=numtup*bytes\($$$DBBlockSize*3/4)+1,cd=blocks*3+TEMPCD
	    #;  if need to produce baby files, cost to produce the file increased
    If $$$CostBabyFile {i blocks>BABYBLK s cgg=cgg*2,cgs=cgs*2,cd=cd*2}
    s outsort=((cd*CDFACTOR)+(cgg*CGGFACTOR)+(cgs*CGSFACTOR))_","_cd_","_cgg_","_cgs
    s tform($$$SNiblk)=blocks,tform($$$SGPi)=tform($$$SGPi)+outnodes // PVA177: SGPi may already be set
    RETURN
    	#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
change ;
        #; When we have created a sort file, we convert many of the
        #;  restriction selectivities to be selectivities in $$$SSE1.
        #;  This is because the created sort file effectively has a high
        #;  level equals that processes all of these restrictions.
        #;  Hence, if a restriction has been replicated and already
        #;  processed, we don't want to count its selectivity twice.
        #;  Thus we must remove its selectivity from $$$SSE1 if we find
        #;  it has already been processed.  To do this, we must convert
        #;  the 'change()' array so that it will properly remove selectivity
        #;  from $$$SSE1.  Selectivities such as $$$SSR, etc. are not considered
        #;  by the low level join on a created sort file.
        #; 
        #;  In general, the following are all converted to $$$SSE1:
        #;          $$$SSE2, $$$SSE3, $$$SSR, $$$SSOI, $$$SSO0
        #;  The following are left alone:
        #;          $$$SSE1, $$$SSOE ($$$SSOE shouldn't ever appear in change())
        #; 
        #;  Also, change $$$SSO0MUL to $$$SSOIMUL, since join/initial strm algs
        #;  that use a presort act as if they use an index that has
        #;  everything in it
        #;  ******ALSO CONSIDER SIMILAR CHANGE IN 'ressub'
    n res,a,b,c k tchange
    s res="" f i=1:1 s res=$o(change(res)) q:res=""  d change1 s tchange(res)=a
    RETURN
	    #; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
change1 s a=change(res)
    f j=2:1:$l(a,"^") s b=$p(a,"^",j),c=":"_$p(b,":")_":" d change2:b]""
    RETURN
	    #; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
change2 
        #;  PVA072: each change entry now has 2 selectivity ":" pieces (for form() and ptform()).
        #;  PVA154: Use new form() entry SSOID
    i ":"_$$$SSE2_":"_$$$SSE3_":"_$$$SSR_":"_$$$SSOI_":"_$$$SSOID_":"_$$$SSO0_":"[c s $p(a,"^",j)=$$$SSE1_":"_$p(b,":",2,3)
	    #;  PVA154: Note, current uses of SSOIMUL replaced with SSOIMULD
    e  i ":"_$$$SSO0MUL_":"=c s $p(a,"^",j)=$$$SSOIMULD_":"_$p(b,":",2,3)
    RETURN
	    #; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
settform ; init most of tform array
        #;  $$$SNitup, $$$SGPi, $$$SNiblk, $$$SL2B, and $$$SZB are NOT setup 
        #;   by this subroutine
        #;  See comments under change() above
    s tform($$$SSE1)=form($$$SSE1)*form($$$SSO0),tform($$$SSO0)=1
	    #;  PVA154: Use new form() entry SSOID
    f i=$$$SSE2,$$$SSE3,$$$SSR,$$$SSOI,$$$SSOID s tform($$$SSE1)=tform($$$SSE1)*form(i),tform(i)=1
	    #;  PVA154: Note, current uses of SSOIMUL replaced with SSOIMULD
    s tform($$$SSOIMULD)=form($$$SSOIMULD)*form($$$SSO0MUL),tform($$$SSO0MUL)=1
    s tform($$$SSOIMUL)=form($$$SSOIMUL) // PVA154: placeholder for future
	    #;  PVA072: Now that mul form entries moved to tform, must set form entries
	    #;          to 1 because IS algs now may use mul entries.
    s form($$$SSOIMUL)=1,form($$$SSOIMULD)=1,form($$$SSO0MUL)=1 // PVA154
    f i=$$$SSOE,$$$SSJA,$$$SSJAADDM,$$$SSJACOND,$$$SSJAIN s tform(i)=form(i)
    f i=$$$SNbtup,$$$SNbblk,$$$SGPb s tform(i)=1 ; These aren't needed
        #; 
        #;  calculate additional selectivity if domain of JA in B is small
        #;  than domain of JA in A.  Previously we may have accounted for
        #;  some of this extra selectivity in $$$SSOIMUL or $$$SSO0MUL
        #; 
    s tform($$$SSJASUB)=form($$$SSJA),tform($$$SSJAADD)=form($$$SSJAADDM)
        #;  PVA154: If ssoimul really used again, following would be tricky to upgrade:
        #;       Wouldn't know whether to adjust ssoimul or ssoimuld. Similar problem
        #;       does not arise in settform^%qaqpoidx, because there is just sso0mul 
        #;       (i.e. no mul/muld distinction). 
    i form($$$SSJAADDM)'=form($$$SSJAADD) s tform($$$SSOIMULD)=tform($$$SSOIMULD)*form($$$SSJAADD)/form($$$SSJAADDM)
        #; 
        #;  Now that we have the join attribue as a subscript, reduce the
        #;  selectivity of the "other" multistream restrictions to which the
        #;  join restriction was previously assigned
        #; 
        #; PVA072: Since initial stream algorithms may now have MUL selectivity 
        #;         from top predicates, the following adjustment could apply to
        #;         them - but its purpose is bogus for initial streams - jother
        #;         is not used, and does not record join related selectivity
        #;         in MUL entries. So skip this adjustment if an initials stream:
        #;         high variable beginning wiht "is". 
        #;  PVA154: If ssoimul really used again, following would be tricky to upgrade:
        #;       Wouldn't know whether to adjust ssoimul or ssoimuld. Similar problem
        #;       does not arise in settform^%qaqpoidx, because there is just sso0mul 
        #;       (i.e. no mul/muld distinction). 
    i form($$$SSJA)<form($$$SSJASUB),$e(high,1,2)'="is" s tform($$$SSOIMULD)=tform($$$SSOIMULD)*form($$$SSJASUB)/form($$$SSJA)
    i tform($$$SSOIMULD)>.999 s tform($$$SSOIMULD)=1
    s tform($$$SSE1M)=tform($$$SSE1),tform($$$SSE2M)=1,tform($$$SSE3M)=1,tform($$$SSRM)=1
    RETURN
    	#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fintform ; finish setting up tform, setup $$$SZB and $$$SL2B
    n c s c=tform($$$SNitup)*tform($$$SSJASUB)/form($$$SSJACOND)
        #; 
        #;  i c>1, there is at least one tuple for each JA that passes all
        #;         high level restrictions (other than restrictions on the JA)
        #; 
    i c>1 s tform($$$SZB)=c,tform($$$SL2B)=form($$$SSJACOND)/tform($$$SSJASUB)
    e  s tform($$$SZB)=1,tform($$$SL2B)=tform($$$SNitup)
    RETURN
	    #; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
addcost(a,b) RETURN a+b_","_($p(a,",",2)+$p(b,",",2))_","_($p(a,",",3)+$p(b,",",3))_","_($p(a,",",4)+$p(b,",",4))
    	#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
---
