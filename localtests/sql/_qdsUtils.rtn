====
qdsUtils
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qdsUtils^MAC^^^0
%qdsUtils ; DeepSee Privilege and License checking APIs
.
 ; license slots
#if ($p($p($p($ZV,") ",2)," ",1),".",1))>=2011
#define DSRUN 	8
#define DSANALYZE 9
#define DSMODEL 10
#define DSVRRUN 14
#define DSVRFORMAT 16
#define DSVRDATA 17
#else
 ; legacy
#define DSRUN 	3
#define DSANALYZE 3
#define DSMODEL 4
#define DSVRRUN 3
#define DSVRFORMAT 3
#define DSVRDATA 3
#endif
.
 ; Test if the current user has a DeepSee license
CheckDeepSeeAccess() PUBLIC
{
	Quit $SYSTEM.License.GetFeature($$$DSRUN)||$SYSTEM.License.GetFeature($$$DSMODEL)
}
.
 ; Test if the current user holds the use (view) privileges needed to
 ; access the given DeepSee folder item (such as a dashboard).
CheckFolderUseAccess(pFolderItem) PUBLIC
{
	Set tUse = 1
	Set tLicense = 1
.
	If ($IsObject(pFolderItem)&&(pFolderItem.resource'="")) {
		Set tUse = $System.Security.Check(pFolderItem.resource,"USE")
	}
	If ('tUse) {
		Set %response.Redirect = ##class(%DeepSee.UserPortal.Utils).%GetErrorPageURL("Privilege")
		Throw ##class(%Exception.SystemException).%New("DeepSee Privilege")
	}
	If ('tLicense) {
		Set %response.Redirect = ##class(%DeepSee.UserPortal.Utils).%GetErrorPageURL("License")
		Throw ##class(%Exception.SystemException).%New("DeepSee License")
	}
}
.
 ; Test if the current user holds the Write privileges on a 
 ; DeepSee folder item (such as a dashboard).
CheckFolderWriteAccess(pFolderItem) PUBLIC
{
	Set tWrite = 1
.
	If ($IsObject(pFolderItem)&&(pFolderItem.resource'="")) {
		Set tWrite = $System.Security.Check(pFolderItem.resource,"WRITE")
	}
	Quit tWrite
}
.
 ; Test if the current user holds the use privileges needed to run the User Portal
CheckPortalUseAccess() PUBLIC
{
	Set tUse = 1
	Set tLicense = 1
.
	Set tUse = $System.Security.Check("%DeepSee_Portal","USE")||
				$System.Security.Check("%DeepSee_PortalEdit","USE")
.
	If ('tUse) {
		Set %response.Redirect = ##class(%DeepSee.Utils).%GetErrorPageURL("Privilege")
		Throw ##class(%Exception.SystemException).%New("DeepSee Privilege")
	}
	If ('tLicense) {
		Set %response.Redirect = ##class(%DeepSee.Utils).%GetErrorPageURL("License")
		Throw ##class(%Exception.SystemException).%New("DeepSee License")
	}
}
.
 ; Test if the current user holds the Write privileges in the User Portal
CheckPortalWriteAccess() PUBLIC
{
	Quit $System.Security.Check("%DeepSee_PortalEdit","USE")
}
.
 ; Test if the current user holds the use privileges needed to run a Visual Reporting Class.
CheckReportExecuteAccess() PUBLIC
{
	Set tLicense = $SYSTEM.License.GetFeature($$$DSVRRUN)||$SYSTEM.License.GetFeature($$$DSVRDATA)||$SYSTEM.License.GetFeature($$$DSVRFORMAT)
	Quit tLicense
}
.
 ; Test if the current user holds the use privileges needed to run the Analyzer.
CheckAnalyzerUseAccess() PUBLIC
{
	Set tUse = 1
	Set tLicense = $SYSTEM.License.GetFeature($$$DSANALYZE)||$SYSTEM.License.GetFeature($$$DSMODEL)
.
	Set tUse = $System.Security.Check("%DeepSee_Analyzer","USE")||
				$System.Security.Check("%DeepSee_AnalyzerEdit","USE")
.
	If ('tUse) {
		Set %response.Redirect = ##class(%DeepSee.Utils).%GetErrorPageURL("Privilege")
		Throw ##class(%Exception.SystemException).%New("DeepSee Privilege")
	}
	If ('tLicense) {
		Set %response.Redirect = ##class(%DeepSee.Utils).%GetErrorPageURL("License")
		Throw ##class(%Exception.SystemException).%New("DeepSee License")
	}
}
.
 ; Test if the current user holds the Write privileges on the Analyzer
CheckAnalyzerWriteAccess() PUBLIC
{
	Quit $System.Security.Check("%DeepSee_AnalyzerEdit","USE")
}
.
 ; Test if the current user holds the privileges to see the Analyzer
CheckAnalyzerViewAccess() PUBLIC
{
	Quit ($SYSTEM.License.GetFeature($$$DSANALYZE)||$SYSTEM.License.GetFeature($$$DSMODEL))&&($System.Security.Check("%DeepSee_Analyzer","USE")||$System.Security.Check("%DeepSee_AnalyzerEdit","USE"))
}
.
 ; Test if the current user holds the use privileges needed to run the Analyzer.
CheckArchitectUseAccess() PUBLIC
{
	Set tUse = 1
	Set tLicense = $SYSTEM.License.GetFeature($$$DSMODEL)
.
	Set tUse = $System.Security.Check("%DeepSee_Architect","USE")||
				$System.Security.Check("%DeepSee_ArchitectEdit","USE")
.
	If ('tUse) {
		Set %response.Redirect = ##class(%DeepSee.Utils).%GetErrorPageURL("Privilege")
		Throw ##class(%Exception.SystemException).%New("DeepSee Privilege")
	}
	If ('tLicense) {
		Set %response.Redirect = ##class(%DeepSee.Utils).%GetErrorPageURL("License")
		Throw ##class(%Exception.SystemException).%New("DeepSee License")
	}
}
.
 ; Test if the current user holds the Write privileges on the Architect
CheckArchitectWriteAccess() PUBLIC
{
	Quit $System.Security.Check("%DeepSee_ArchitectEdit","USE")
}
.
 ; Test if the current user holds the privileges to see the Architect
CheckArchitectViewAccess() PUBLIC
{
	Quit $SYSTEM.License.GetFeature($$$DSMODEL)&&($System.Security.Check("%DeepSee_Architect","USE")||$System.Security.Check("%DeepSee_ArchitectEdit","USE"))
}
.
 ; Test if the current user holds the use privileges needed to run the Listing Group Manager.
CheckListingGroupUseAccess() PUBLIC
{
	Set tUse = 1
	Set tLicense = $SYSTEM.License.GetFeature($$$DSANALYZE)||$SYSTEM.License.GetFeature($$$DSMODEL)
.
	Set tUse = $System.Security.Check("%DeepSee_ListingGroup","USE") ||
				$System.Security.Check("%DeepSee_ListingGroupEdit","USE")||
				$System.Security.Check("%DeepSee_ListingGroupSQL","USE")
.
	If ('tUse) {
		Set %response.Redirect = ##class(%DeepSee.Utils).%GetErrorPageURL("Privilege")
		Throw ##class(%Exception.SystemException).%New("DeepSee Privilege")
	}
	If ('tLicense) {
		Set %response.Redirect = ##class(%DeepSee.Utils).%GetErrorPageURL("License")
		Throw ##class(%Exception.SystemException).%New("DeepSee License")
	}
}
.
 ; Test if the current user holds the privileges to see the Listing Group Manager
CheckListingGroupViewAccess() PUBLIC
{
	Quit ($SYSTEM.License.GetFeature($$$DSANALYZE)||$SYSTEM.License.GetFeature($$$DSMODEL))&&
			($System.Security.Check("%DeepSee_ListingGroup","USE") ||
			$System.Security.Check("%DeepSee_ListingGroupEdit","USE")||
			$System.Security.Check("%DeepSee_ListingGroupSQL","USE"))
}
.
 ; Test if the current user holds the Write privileges for listing groups
CheckListingGroupWriteAccess() PUBLIC
{
	Quit $System.Security.Check("%DeepSee_ListingGroupEdit","USE")
}
.
 ; Test if the current user is allowed to interact with arbitrary SQL queries
CheckListingGroupSQLViewAccess() PUBLIC
{
	Quit $System.Security.Check("%DeepSee_ListingGroupSQL","USE")
}
---
