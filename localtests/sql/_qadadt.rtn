====
qadadt
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qadadt^MAC^^^0
%qadadt	// ADT API to Objects
	;; COMPONENTS :: SQL
.
#INCLUDE %occInclude
#INCLUDE %occODBC
.
#IF 0
	;---------------------------------------------------------------------
	; Description:   ADT API to Objects
	; Author:        Alex Djakovic
	; Date:          July 2, 1997
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;  DPV3304 (10/29/2008) - Correct checking to see if method code is a no-op
	;  DPV3255 (09/03/2008) - Report type VARCHAR for %Library.List since on ODBC they are imply strings.
	;  DPV3106 (02/14/2008) - SQL: Report 32749 as length of %List type if no MAXLEN specified
	;  DPV2977 (07/18/2007) - Report type VARCHAR for serial fields
	;                         SQL Fix ProdLog 59055: CacheFactory and DynamicQuery - serial properties
	;  DPV2952 (06/08/2007) - Use $$$ODBCVarcharMaxlen instead of 4096 as default maxlen of VARCHAR
	;                         SQL Fix ProdLog 58316: length limitation Security.Users field Roles
	;  DPV2908 (04/19/2007) - Support override of datatype methods for a property
	;  DPV2734 (09/15/2006) - TSQL: Implement %TSQL.sys.types table
	;  DPV2072 (09/15/2003) - Add support for BIGINT datatype
	;  BJB253  (01/22/2003) - Fix the calculation for precision
	;  DPV1543 (05/25/2001) - Handle Mo's removal of the METHformallist
	;  DPV1516 (03/28/2001) - Rewrite using new class glbal structures
	;  DPV1440 (11/01/2000) - Fix SCALE reporting for %Currency/%Library.Currency
	;  AK453   (10/20/2000) - Add %Library to ADT API class name input
	;  DPV1409 (10/03/2000) - Fix precision reporting for NUMERIC types
	;  DPV1405 (09/28/2000) - Add support for TINYINT
	;  DPV1218 (12/14/1999) - Fix LENGTH returned for NUMERIC types
	;  DPV1206 (12/08/1999) - Support VARBINARY instead of BINARY
	;  DPV1177 (10/28/1999) - Support BIT ODBC type
	;  DPV1027 (04/06/1999) - Fix PRECISION/SCALE reporting for NUMERIC and DECIMAL
	;  DPV1004 (03/16/1999) - Support NUMERIC ODBC Type
	;  DPV985  (03/02/99)   - Always report 2Gig as the precision for BLOB types
	;  DPV972  (02/10/99)   - Report 4096 as precision for BINARY and VARCHAR 
	;                         default
	;  DPV924  (12/04/98)   - Support LONGVARBINARY ODBC Type, synchronize all
	;                         ODBC Types
	;  DLP008  (08/05/98)   - Updated ODBC type names. Used macro definitions
	;  DLP007  (05/07/98)   - Allow non-literal datatypes, i.e. reference
	;                         and serial types.
	;  DLP006  (03/16/98)   - Support %oddXXX globals
	;  DPV817  (02/24/98)   - Support new routine names for Objects
	;  DPV808  (01/20/98)   - Fix <UNDEFINED> error in fetchlst when 
	;                         classes' datatype spec info is undefined.
	;  DPV753  (07/02/97)   - Move routine (written by AND) into DEV
#ENDIF   ;-------------------------------------------------------------
	x "*"  ;  Not an Entry Point!!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 
#define isdt(%dt) $s($g(%dt)="":"DatatypeArgumentMissing",'$$$comClassDefined(%dt):"DatatypeNotFound",1:1)
 
ismeth(dt,method) [] PUBLIC {       ;checks dt,method
	QUIT:$g(dt)="" "DatatypeArgumentMissing" s isdatat=$$$isdt(dt) QUIT:'isdatat isdatat
	QUIT:$g(method)="" "MethodArgumentMissing" QUIT:'$$$comMemberDefined(dt,$$$cCLASSmethod,method) "MethodNotFound" QUIT:'$$runnable(dt,method) "MethodNotRunnable"
	QUIT 1
}
 
 
runnable(classname,method) public {
	$$$comMemberKeyGetLvar(stub,classname,$$$cCLASSmethod,method,$$$cMETHstub)
	If stub = "" {
		$$$comMemberKeyGetLvar(runnable,classname,$$$cCLASSmethod,method,$$$cMETHrunnable)
	} Else {
		Set member=$p(stub,".",1),membermethod=$p(stub,".",2),kind=$p(stub,".",3)
		$$$comSubMemberKeyGetLvar(runnable,classname,kind,member,$$$cCLASSmethod,membermethod,$$$cMETHrunnable)
	}
	QUIT runnable
}
 
 
getdt(dt,goup,super,opti,odbc,metharr,paramarr,dtinfo) public {  ;gets datatype info
	i $e(dt)="%",dt'["." s $e(dt)="%Library."  ;  allow old class names
	k super,opti,odbc,metharr,paramarr,dtinfo
	s isdatat=$$$isdt(dt) QUIT:isdatat'=1 isdatat
	s method="",dtinfo="",param=""
	f  s method=$$$comMemberNext(dt,$$$cCLASSmethod,method) q:method=""  d ProcessMethodFormalspec^%occName(dt,method,,,.formallist) s metharr(method)=method_$g(formalist)
	f  s param=$$$comMemberNext(dt,$$$cCLASSparameter,param) q:param=""  $$$comMemberKeyGetLvar(paramdefault,dt,$$$cCLASSparameter,param,$$$cPARAMdefault) s paramarr(param)=paramdefault
	$$$comClassKeyGetLvar(super,dt,$$$cCLASSsuper)
	$$$comClassKeyGetLvar(odbc,dt,$$$cCLASSodbctype)
	$$$comClassKeyGetLvar(opti,dt,$$$cCLASSsqlcategory)
	QUIT 1
}
.
.
	#;  If classname/property are defined, we will look to see if there is a property override for this datatype method.
	#;  For example, the class author may have defined Sample.Person.DobLogicalToDisplay and Sample.Person.Dob.DisplayToLogical
	#;	dtclassname is the name of the class to look for method in
	#;	method is like LofgicalToDisplay, DisplayToLogical, etc.
	#;	parameters, PBR type parameters for the field
	#;	formals, PBR formal arguments for the method call
	#;	code, PBR metod code returned
	#;	methinfo, PBR - NO LONGER USED
	#;	cls = Name of the class the property is from
	#;	prop  = Name of the property in the class
	#;	defaultargs, PBR default values for arguments of the method
	#;	pProcedureBlock, PBR returns 1 if this method should be a procedure block
	#;      pGenerateCall, if 1 return a call to the method, not the harvested code
	#;      expression, PBR, return expression if possible with parameter replaced by '@@p@@' so we can replace it.
	#;	pCanConvertOnClient, PBR, return 1 if this datatype is using regular datatype conversion code, and not overridden in a member method and the type if %Library.Date, %Library.Time, or %Library.PosixTime
	#;
	#; getcode is called from:
	#;	getmeth^%qaqcpr
	#;	odbcout^%qaqcasl
	#;	findopt^%qadop
	#;	%ocsCacheSQLFiler0
	#;	%Compiler.XML.Generator.Adaptor.getSingleLine()
.
#define DatatypeMethods ",IsValid,Normalize,LogicalToDisplay,DisplayToLogical,LogicalToOdbc,OdbcToLogical,LogicalToStorage,StorageToLogical,LogicalToFDBMS,FDBMSToLogical,LogicalToDate,DateToLogical,LogicalToTimeStamp,TimeStampToLogical,LogicalToJSON,JSONToLogical,LogicalToXSD,XSDToLogical,LogicalToUnixTime,UnixTimeToLogical,"
getcode(dtclassname="",method="",&parameters,&formals,&code,&methinfo,cls="",prop="",&defaultargs,&pProcedureBlock,pGenerateCall=0,&expression,&pCanConvertOnClient,&overriddenMM) public {
	$$$InitISCName
	Set $ztrap="getcodeerr"
	Kill code,formals,defaultargs,methinfo,expression
	Set methinfo="",origmethod=method
	Set expr=0,pCanConvertOnClient=0,overriddenMM=0
	Quit:dtclassname="" "DatatypeArgumentMissing"
	Quit:method="" "MethodArgumentMissing"
	Set dtclassname=$$$NormalizeClassname(dtclassname)
	if (dtclassname = "%Collection.ListOfDT") && (method [ "Logical") && (cls '= "") && (prop '= "") && ($$$comMemberKeyGet(cls,$$$cCLASSproperty,prop,$$$cPROPsqllistdelimiter) '= "" ) {
		If '$$$comMemberDefined(dtclassname,$$$cCLASSmethod,method) Quit "MethodNotFound"
		QUIT:'$$runnable(dtclassname,method) "MethodNotRunnable"
		set code=1,code(1)="	Quit val"
		Do ProcessMethodFormalspec^%occName(dtclassname,method,,,.formals,.defaultargs)
	} else {
		#; Check for projected class
		#;	See if the class has the SQLCOLLECTIONTABLE parameter.
		;#	It is projected for every collection child table - it is either an "L" or an "A"
		If cls'="" {
			$$$comMemberKeyGetLvar(sqlcollectiontable,cls,$$$cCLASSparameter,"SQLCOLLECTIONTABLE",$$$cPARAMdefault)
			If sqlcollectiontable="A"||(sqlcollectiontable="L") {
				Set parent=$$$EXTparent($$$pEXT,cls)
				If parent'="" {
					Set parentcls=$$$EXTPROPtype($$$pEXT,cls,parent)
					If parentcls'="" Set cls=parentcls
				}
			}
		}
			#; Check for user overridden method
		if cls'="",prop'="",$$$comMemberDefined(cls,$$$cCLASSmethod,$$$nameMemberMethodName(prop,method)),$$$comMemberKeyGet(cls,$$$cCLASSmethod,$$$nameMemberMethodName(prop,method),$$$cMETHstub)="" {
			Set method=$$$nameMemberMethodName(prop,method),dtclassname=cls
			Set cls="",prop="",overriddenMM=1
		} else {
				#; No user overridden member method found
				#; We can move conversion to the client if there is now property member method for the conversion defined and it is one of these types
			if method["Odbc" {
				set origin=$$$comMemberKeyGet(dtclassname,$$$cCLASSmethod,method,$$$cMETHorigin)
				if '$$$comMemberDefined(dtclassname,$$$cCLASSmethod,method) { set pCanConvertOnClient=1 }	// there is no Odbc conversion code, so nothing to convert
					#; The following are a list of types we can convert on the client.
					#; We don't put %Library.TimeStamp in this list because there is already special handling of that type in %qaqpif2 for INSERT Prepare
				elseif $case($s(origin'="":origin,1:dtclassname),"%Library.Date":1,"%Library.DateTime":1,"%Library.Double":1,"%Library.PosixTime":1,"%Library.String":1,"%Library.StringTimeStamp":1,"%Library.Time":1,:0) { set pCanConvertOnClient=1 }
			}
			If cls'="",prop'="" {
					#; If the caller is asking for a method from a class that is not the same as the property type class then just look into
					#; datatype class directly and do not consider the property method at all
				If '$$$comMemberDefined(cls,$$$cCLASSproperty,prop) {
					Set cls="",prop=""
				} Else {
					$$$comMemberKeyGetLvar(type,cls,$$$cCLASSproperty,prop,$$$cPROPtype)
					If type=dtclassname {
						$$$comSubMemberKeyGetLvar(runnable,cls,$$$cCLASSproperty,prop,$$$cCLASSmethod,method,$$$cMETHrunnable)
						If 'runnable { Set cls="",prop="" }
					} Else {
						Set cls="",prop=""
					}
				}
			}
		}
		If prop=""||(cls="") {
			If '$$$comMemberDefined(dtclassname,$$$cCLASSmethod,method) { RETURN "MethodNotFound" }
				#; if we did not find an overridden member method, make sure we are looking for the method in a datatype class
			//if 'overriddenMM,($$$DatatypeMethods[(","_method_",")),($$$comClassKeyGet(dtclassname,$$$cCLASSclasstype)'=$$$cCLASSCLASSTYPEDATATYPE) { RETURN "MethodNotFOund" }
			$$$comMemberKeyGetLO(runnable,origin,dtclassname,$$$cCLASSmethod,method,$$$cMETHrunnable)
			$$$comMemberKeyGetLO(codemode,origin,dtclassname,$$$cCLASSmethod,method,$$$cMETHcodemode)
			$$$comMemberKeyGetLO(language,origin,dtclassname,$$$cCLASSmethod,method,$$$cMETHlanguage)
			$$$comMemberKeyGetLO(pProcedureBlock,origin,dtclassname,$$$cCLASSmethod,method,$$$cMETHprocedureblock)
			$$$comMemberKeyGetLO(classmethod,origin,dtclassname,$$$cCLASSmethod,method,$$$cMETHclassmethod)
			Set nocontext=1
			Do ProcessMethodFormalspec^%occName(dtclassname,method,,,.formals,.defaultargs)
		} Else {
			#; We checked runnable earlier so no need to test it here
			Set runnable=1
			$$$comSubMemberKeyGetLO(codemode,sorigin,cls,$$$cCLASSproperty,prop,$$$cCLASSmethod,method,$$$cMETHcodemode)
			$$$comSubMemberKeyGetLO(language,sorigin,cls,$$$cCLASSproperty,prop,$$$cCLASSmethod,method,$$$cMETHlanguage)
			$$$comSubMemberKeyGetLO(pProcedureBlock,sorigin,cls,$$$cCLASSproperty,prop,$$$cCLASSmethod,method,$$$cMETHprocedureblock)
			$$$comSubMemberKeyGetLO(classmethod,sorigin,cls,$$$cCLASSproperty,prop,$$$cCLASSmethod,method,$$$cMETHclassmethod)
			$$$comSubMemberKeyGetLO(nocontext,sorigin,cls,$$$cCLASSproperty,prop,$$$cCLASSmethod,method,$$$cMETHnocontext)
			Do ProcessSubMethodFormalspec^%occName(cls,$$$cCLASSproperty,prop,method,,,.formals,.defaultargs)
		}
		QUIT:'runnable "MethodNotRunnable"
		If pGenerateCall Goto generateCall
		Set origcodemode=codemode
		If language'=$$$cMETHLANGUAGEOBJECTSCRIPT||(codemode=$$$cMETHCODEMODECALL) Goto generateCall
		if codemode=$$$cMETHCODEMODECODE {
			If $case($$$comClassKeyGet(dtclassname,$$$cCLASSdeployed),1:1,2:1,:0) Goto generateCall
			$$$comMemberKeyGetLvar(lines,dtclassname,$$$cCLASSmethod,method,$$$cMETHimplementation)
			If lines Set code($increment(code))=^($$$cMETHimplementation,1) For i=2:1:lines Set code($increment(code))=^(i)
		} elseif codemode=$$$cMETHCODEMODEEXPRESSION {
			If $case($$$comClassKeyGet(dtclassname,$$$cCLASSdeployed),1:1,2:1,:0) Goto generateCall
			Set code($increment(code))="	Quit "_$$$comMemberArrayGet(dtclassname,$$$cCLASSmethod,method,$$$cMETHimplementation,1)
		} elseif codemode=$$$cMETHCODEMODEGENERATOR||(codemode=$$$cMETHCODEMODEOBJECTGENERATOR)||(codemode=$$$cMETHCODEMODESQLGEN) {
			Lock +$$$tGENCODE(cls)#"S":0 Set locked=$test
			If locked,prop'="",$data($$$tGENCODE(cls,$$$cCLASSproperty,prop,$$$cCLASSmethod,method)) {
				$$$comSubMemberKeyGetLvar(codemode,cls,$$$cCLASSproperty,prop,$$$cCLASSmethod,method,$$$cMETHruntimecodemode)
				If codemode=$$$cMETHCODEMODECALL {
					Set call=$get($$$tGENCODE(cls,$$$cCLASSproperty,prop,$$$cCLASSmethod,method,1))
					If $piece(call,"(")="##class",$piece($piece(call,")"),"(",2)=cls {
						Set m=$piece($piece(call,").",2),"(")
						$$$comMemberKeyGetLvar(stub,cls,$$$cCLASSmethod,m,$$$cMETHstub)
						If stub'="",$piece(stub,".",3)=$$$cCLASSproperty {
							Set prop=$piece(stub,"."),method=$piece(stub,".",2)
							If $data($$$tGENCODE(cls,$$$cCLASSproperty,prop,$$$cCLASSmethod,method)) $$$comSubMemberKeyGetLvar(codemode,cls,$$$cCLASSproperty,prop,$$$cCLASSmethod,method,$$$cMETHruntimecodemode)
						}
					}
				}
				If codemode=$$$cMETHCODEMODECODE||(codemode=$$$cMETHCODEMODEEXPRESSION) {
					Set lines=$get($$$tGENCODE(cls,$$$cCLASSproperty,prop,$$$cCLASSmethod,method))
					If lines Set code($increment(code))=^(method,1) For i=2:1:lines Set code($increment(code))=^(i)
				}
			}
			If locked Lock -$$$tGENCODE(cls)#"SI" Set locked=0
			If '$data(code) {
				If $data(parameters)=1 {
					Set i=0 While $listnext(parameters,i,p) { Set parameters($piece(p,"="))=$piece(p,"=",2,*) }
					ZKill parameters
				}
				If prop="" {
					Set p="" 
					For  {
						Set p=$$$comMemberNext(dtclassname,$$$cCLASSparameter,p) Quit:p=""
						If '$data(parameters(p)) { $$$comMemberKeyGetLvar(tmp,dtclassname,$$$cCLASSparameter,p,$$$cPARAMdefault) Set parameters(p)=tmp }
						$$$comMemberKeyGetLvar(origin,dtclassname,$$$cCLASSmethod,method,$$$cMETHorigin)
					}
				} Else {
					Set p="",p=$order($$$comSubMemberRaw(cls,$$$cCLASSproperty,prop,$$$cXXXXparamvalue,p),1,tmp)
					While p'="" {
						set:'$data(parameters(p)) parameters(p)=tmp
						Set p=$order(^(p),1,tmp)
					}
					$$$comSubMemberKeyGetLvar(origin,cls,$$$cCLASSproperty,prop,$$$cCLASSmethod,method,$$$cMETHorigin)
				}
				$$$comMemberKeyGetLvar(tag,origin,$$$cCLASSmethod,method,$$$cMETHtaggenerator)
				If tag="" Goto generateCall
				Set tag=method_"^"_$$$nameMethodGeneratorRtnNameGet(origin,tag)
				Set codemode=origcodemode
				If prop'="" {
					Set member=$listbuild($$$cCLASSproperty,prop)
				} Else {
					Set member=""
				}
				Do
				. $$$SuspendErrorCount
				. Set sc=$$callmethodgenerator^%occCode($select(prop="":dtclassname,1:cls),method,member,.parameters,.code,.codemode,language,tag)
				If $$$ISERR(sc) Goto generateCall
				If codemode=$$$cMETHCODEMODEEXPRESSION Set code=$get(code,1),code(1)="	Quit "_$get(code(1))
			}
		}
	}
	if '$g(code) { kill code set code=0 RETURN $$$OK }	// No code found
	Set justQuit=-1,quitOne=0,isValid=0 Set:method="IsValidDT"||(method="IsValid") isValid=1
	For i=1:1:code {
		Set line=code(i),lline=$zconvert(line,"l")
		#;  Now check the code to see if it is simple or we should call property method directly.
		#;  It is simple if the code does not contain ".." or "##class(" and the class reference is not normalized
		Set found=$find(lline,"##class(")
		While found'=0 {
			If '$zname($extract(lline,found-$length("##class(")-1)) {
				Set name=$piece($extract(lline,found,*),")")
				If name'["."||($extract(name)="="),$extract(name)'="%" {
					Goto generateCall
				}
			}
			Set found=$find(lline,"##class(",found)
		}
		If line[".."||(lline["##super") {
			Goto generateCall
		}
		#;  If there are any line labels in this code, we have to simply call the method directly instead of code generating
		#;  this code in the generated SQL code.  This is because if there are two properties with the same type, 
		#;  you'll probably end up with <LABELREDEF> errors.  Even if the code is the same, the SQL subroutinier does not think it is because of the 
		#;  #classcontext class:prop line in the code.
		If $case($e(line)," ":0,"#":0,$c(9):0,:1) Goto generateCall
		#;  See if code is just Quit %val, if so kill it. (DPV3304)
		If justQuit=-1,$extract($$$StripLeadingWhiteSpace(line))'="#" {
			Set tmp=$select(isValid:1,$get(formals)'[",":$extract($get(formals),2,*-1),1:"")
			If tmp'="",$tr($g(line),"Q "_$c(9),"q")=("q"_tmp)||($tr($g(line),"QUIT "_$c(9),"quit")=("quit"_tmp))||($tr($g(line),"RETURN "_$c(9),"RETURN")=("return"_tmp)) { s justQuit=1 quit } else { s justQuit=0 }
			Set line=$zstrip(line,"<W"),formal=$extract($get(formals),2,*-1)
			If formal'="",formal'["," {
				Set text=$zconvert($tr(line,$c(9)," "),"l")
				For match="q ","quit ","return ","ret " {
					If $extract(text,1,$length(match))=match {
						Set expression=$zstrip($extract(line,$length(match)+1,*),"<W")
						Quit
					}
				}
				If $get(expression)'="" {
					Set qexpr=$$HideQuotes^%qarmac(expression,,.comment),lformal=$zconvert(formal,"l")
					#; Check if this is a self contained expression that we can inline
					If 'comment,$length(qexpr,"(")=$length(qexpr,")"),$length(qexpr,"{")=$length(qexpr,"}") {
						Set tmp=0
						For {
							Set tmp=$find(qexpr,lformal,tmp) Quit:tmp=0
							#; Need this as qexpr is lower cased so check original case is correct
							If $extract(expression,tmp-$length(formal),tmp-1)'=formal Continue
							Set after=$extract(expression,tmp),before=$extract(expression,tmp-$length(formal)-1)
							If after'?.P||(before'?.P) Continue
							If before'="","?.$^"[before Continue
							If after'="","$^"[after Continue
							Set $extract(expression,tmp-$length(formal),tmp-1)="@@p@@",$extract(qexpr,tmp-$length(formal),tmp-1)="@@p@@",tmp=tmp+$length("@@p@@")-$length(formal)
						}
					} Else {
						Kill expression
					}
					
				}
			}
		}
	}
	If justQuit=1 {
		Kill code Set code=0
		set pCanConvertOnClient=1	// nothing to convert on client
	} ElseIf $extract($get(code(1)),1,$length("#classcontext "))="#classcontext " {
		#; If the method contains object syntax we generate the call anyway, so we can strip any #classcontext from this
		For i=2:1:code-1 Set code(i-1)=code(i)
		Kill code(code),code(code-1)
		Set code=code-2
	}
	RETURN $$$OK
getcodeerr	Set $ztrap=""
	If $get(locked) Lock -$$$tGENCODE(cls)#"SI"
	RETURN $$$ERROR($$$ObjectScriptError,$zerror)
	#; Do not need defaultargs if this is a call as it will apply the arguments for us
generateCall	Kill code // DPV5112, don't kill/reset defaultargs because they might be needed for table compiler  //,defaultargs Set defaultargs=""
	If cls=""||(prop="") {
		Set code=1,code(1)=$select(pGenerateCall:"",1:"	Quit ")_"##class("_dtclassname_")."_$$$QN(method)_"("_$extract($get(formals),2,*-1)_")"
		If formals'["," Set expression="##class("_dtclassname_")."_$$$QN(method)_"(@@p@@)"
	} Else {
		Set code=1,code(1)=$select(pGenerateCall:"",1:"	Quit ")_"##class("_cls_")."_$$$QN($$$nameMemberMethodName(prop,method))_"("_$extract($get(formals),2,*-1)_")"
		If formals'["," Set expression="##class("_cls_")."_$$$QN($$$nameMemberMethodName(prop,method))_"(@@p@@)"
	}
	RETURN $$$OK
}
.
	// Given a datatype and a parameter name, return the paramer value.  
	// Might already be determined and defined in the %array() array, which is passed by reference
ParValue(%dt,%param,%array) [] PRIVATE {
	if $data(%array(%param)) { RETURN %array(%param) }
	if $$$comMemberKeyGet(%dt,$$$cCLASSparameter,%param,$$$cPARAMtype) = $$$cPARAMTYPECOSEXPRESSION {
		try { RETURN $Parameter(%dt,%param)
		} catch { RETURN $$$comMemberKeyGet(%dt,$$$cCLASSparameter,%param,$$$cPARAMdefault) }
	} else {
		RETURN $$$comMemberKeyGet(%dt,$$$cCLASSparameter,%param,$$$cPARAMdefault)
	}
}
.
	// Called from %ocsSQLRTDict5 and %TSQL.sys.types.length()
	// As of 02/24/2017, all callers pass what=0
	// In type, we return typename^datatype^length^precision^scale
getodbc(dt,param,&type,what=0)       ;returns ODBC info for the given datatype and parameter values
	//#define ParValue(%dt,%param,%array) $select($data(%array(%param)):%array(%param),1:$$$comMemberKeyGet(%dt,$$$cCLASSparameter,%param,$$$cPARAMdefault))
#define ParValue(%dt,%param,%array) $select($data(%array(%param)):%array(%param),1:$Parameter(%dt,%param))
	new isdatat,precision,scale,maxlen
	set isdatat=$$$isdt(dt) QUIT:isdatat'=1 isdatat
	set precision="",scale="",maxlen=""
	if $$$classIsSerial(dt) { s type=$$$ODBCTYPENAMEvarchar } else { $$$comClassKeyGetLvar(type,dt,$$$cCLASSodbctype) }	// DPV2977
	QUIT:type="" "DatatypeNotFound"
		#;  Return TYPENAME^TYPENUMBER^MAXLEN^PRECISION^SCALE
	i type=$$$ODBCTYPENAMEinteger||(type=$$$ODBCTYPENAMEsmallint)||(type=$$$ODBCTYPENAMEdouble)||(type=$$$ODBCTYPENAMEnumeric)||(type=$$$ODBCTYPENAMEtinyint)||(type=$$$ODBCTYPENAMEbigint) {
		n maxval,minval,precision s precision=""
		s maxval=$$ParValue(dt,"MAXVAL",.param)
		s minval=$$ParValue(dt,"MINVAL",.param)
		i maxval'="",minval'="" {
			set precision=$l($tr($p(maxval,"."),"-"))
			set:$l($tr($p(maxval,"."),"-"))>precision precision=$l($tr($p(maxval,"."),"-"))
			#; right now precision is only the precision of the value before the decimal
		}
		i type=$$$ODBCTYPENAMEinteger s:precision="" precision=10 s type=$$$ODBCTYPENAMEinteger_"^4^4^"_precision_"^0" s:what type=$p(type,"^",what) QUIT 1
		i type=$$$ODBCTYPENAMEsmallint s:precision="" precision=5 s type=$$$ODBCTYPENAMEsmallint_"^5^2^"_precision_"^0" s:what type=$p(type,"^",what) QUIT 1
		i type=$$$ODBCTYPENAMEtinyint s:precision="" precision=3 s type=$$$ODBCTYPENAMEtinyint_"^-6^1^"_precision_"^0" s:what type=$p(type,"^",what) QUIT 1
		i type=$$$ODBCTYPENAMEbigint s:precision="" precision=19 s type=$$$ODBCTYPENAMEbigint_"^-5^8^"_precision_"^0" s:what type=$p(type,"^",what) QUIT 1
		n scale s scale=""
		s scale=$$ParValue(dt,"SCALE",.param)
		s:precision precision=precision+scale s:precision="" precision=15 /*s:scale="" scale=0*/ s:scale>precision precision=scale
		i scale=0,dt="%Library.Currency"||(dt="%Currency") s scale=4
		i type=$$$ODBCTYPENAMEdouble s type=$$$ODBCTYPENAMEdouble_"^8^8^"_precision_"^"_scale s:what type=$p(type,"^",what) QUIT 1
		i type=$$$ODBCTYPENAMEnumeric s type=$$$ODBCTYPENAMEnumeric_"^2^"_(precision+2)_"^"_precision_"^"_scale s:what type=$p(type,"^",what)
		QUIT 1
	}
	i type=$$$ODBCTYPENAMEbit s type=$$$ODBCTYPENAMEbit_"^-7^1^1^0" s:what type=$p(type,"^",what) QUIT 1
	i type=$$$ODBCTYPENAMEdate s type=$$$ODBCTYPENAMEdate_"^9^4^10^0" s:what type=$p(type,"^",what) QUIT 1
	i type=$$$ODBCTYPENAMEtime {
			#; if PRECISION parameter is a positive integer, adjust the precision and scale
		set precision=8,scale=$$ParValue(dt,"PRECISION",.param) 
		if scale="" { set precision=18 }      // 8 + "." + up to 9 decimal places
		elseif scale=0 { set precision=8 }    // scale=0, no subsecond precision
		else { set precision=8+1+scale }      // 8 + "." plus scale 
		set type=$$$ODBCTYPENAMEtime_"^10^4^"_precision_"^"_scale
		set:what type=$p(type,"^",what)
		QUIT 1
	}
	i type=$$$ODBCTYPENAMEtimestamp {
		i 40[what s precision=$$ParValue(dt,"PRECISION",.param) s:'precision precision=23
		i 50[what s scale=$$ParValue(dt,"SCALE",.param) s:'scale scale=3
		s type=$$$ODBCTYPENAMEtimestamp_"^11^16^"_precision_"^"_scale s:what type=$p(type,"^",what)
		QUIT 1
	}
	if type=$$$ODBCTYPENAMEguid { set maxlen=36 s type=$$$ODBCTYPENAMEguid_"^-11^"_maxlen_"^"_maxlen_"^0" set:what type=$p(type,"^",what) QUIT 1 }
	i type=$$$ODBCTYPENAMElongvarchar s maxlen=2147483647 s type=$$$ODBCTYPENAMElongvarchar_"^-1^"_maxlen_"^"_maxlen_"^0" s:what type=$p(type,"^",what) QUIT 1
	i type=$$$ODBCTYPENAMElongvarbinary s maxlen=2147483647 s type=$$$ODBCTYPENAMElongvarbinary_"^-4^"_maxlen_"^"_maxlen_"^0" s:what type=$p(type,"^",what) QUIT 1
	s maxlen=$$ParValue(dt,"MAXLEN",.param)
	if dt="%Library.List" s:maxlen="" maxlen=32749,type=$$$ODBCTYPENAMEvarchar	// DPV3106=	// DPV3255=
	i type=$$$ODBCTYPENAMEvarbinary s:maxlen="" maxlen=4096 s type=$$$ODBCTYPENAMEvarbinary_"^-3^"_maxlen_"^"_maxlen_"^0" s:what type=$p(type,"^",what) QUIT 1
	QUIT:maxlen=-1 "DatatypeParameterIntegerNotPositive"
	set:$$checkDataType^%apiDDL2(dt, $lb("%Library.Vector")) maxlen = ##class(%Vector).CalculateODBCLength($g(param("DATATYPE")), $g(param("LEN"))) // report max system string length to clients, not max ODBC string length 
	s:maxlen="" maxlen=-1 s type=$$$ODBCTYPENAMEvarchar_"^12^"_maxlen_"^"_maxlen_"^0" s:what type=$p(type,"^",what) // YCL110 - check ODBC VARCHAR maximum length config glb during query prepare time
	QUIT 1
---
