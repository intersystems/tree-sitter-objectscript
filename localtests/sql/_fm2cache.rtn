====
fm2cache
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%fm2cache^MAC^^^0
%fm2cache ; VA -> IRIS FILE MANAGER INTERFACE (Version .816)
 #;
#INCLUDE %msql
#define FM2CacheVersion "'.816'"
 #;
#IF 0    ;
	#;---------------------------------------------------------------------
	#; Description:   New Fileman to IRIS Interface
	#; Author:        David Van De Griek
	#; Date:          February 2005
	#; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ] 
	#;
	#;  DPV3217 (07/08/2008) - Improve performance of class creation (.815)
	#;                         Add FILEMANFILENAME and FILEMANFILENUMBER class parameters
	#;  DPV3159 (05/13/2008) - Correct <MAXSTRING> in trxtofname with field name containing X_ (.814)
	#;  DPV3126 (03/17/2008) - Default String field length is now 255.    (.813)
	#;                         Use %String for IEN fields.
	#;                         Define MINLEN on %String fields where appropriate
	#;                         Fix <UNDEFINED> error with fid in index2
	#;                         Perform one save of entire class instead of saving each class item
	#;                         Field names longer the 50 characters are now supported
	#;  DPV3084 (12/13/2007) - Use %EnumString datatype for multiple choice fields (.812)
	#;  DPV3069 (11/07/2007) - Add %fmRetainClass parameter to not completely delete the class definition (.811)
	#;  DPV3068 (11/06/2007) - Generate index maps from new style cross references (.810)
	#;  DPV3017 (09/13/2007) - Generate Foreign Keys for PointerToFile fields
	#;  DPV3013 (09/10/2007) - Add ;PREV logic to Next code, move multpc to %fm2cache2
	#;  DPV3008 (08/27/2007) - Fix Variable Pointers
	#;  DPV2963 (06/19/2007) - Fix Delete of classes, use 60 for class name length
	#;  DPV2877 (03/09/2007) - Allow class Owner to be passed in, default is $Username
	#;  DPV2845 (01/23/2007) - Enhance ConvertFiles entry point
	#;  DPV2802 (11/29/2006) - Use ";" for VALUELIST/DISPLAYLIST separator instead of ","
	#;  DPV2801 (11/28/2006) - ConvertFiles entry point
	#;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	#;  DPV2449 (06/28/2005) - First checkin of utility
	#;---------------------------------------------------------------------
	#;                     I N F O R M A T I O N
	#;---------------------------------------------------------------------
	#;
	#; DOCUMENTATION
	#; initialize fileman preferences
	#; initialize name mapping variables
	#; all variables that deal with name mapping will have %fmnm prefix
	#; %fmnm  = 1 if name mapping enabled 0 otherwise
	#; %fmnms = "SUB_" if name mapping is disabled, else what was defined
	#; %fmnmd = 1 if duplicate words should be eliminated 0 otherwise
	#; %fmnme = 1 if eliminating fields/files starting with ... (PRT005)
	#; %fmWPFIsListCol = (Word-Proc as List collection (1) or child table (0)
	#; %fmsecs = 1 if they Allow seconds when converting date-time fields
	#; %fmAppendFileNoToName = 1 means append the FileMan file no. to every table name
	#; %qc = queue count - the number of tables queued for creation
	#;---------------------------------------------------------------------
#ENDIF   ;
	$$$Abort  ; Not an Entry Point!!
	QUIT
 
 
Compile(%package="User",flags="d-l") [] PUBLIC {
	s:$e(%package,$l(%package))'="." %package=%package_"."
	d Compile^%fm2cache2(%package,flags)
}
 
 
all(%package="User",compile=1,%fmWPFIsListCol=0,%readonly=0,%fmAppendFileNoToName=0,%fmUseFMFiler=1,%compflags="d-l",%qc,%fmOwner="",%fmRetainClass=0) [] PUBLIC {
		#; CONVERT ALL FILES TO CACHE' CLASSES
		#; User Entry Point
		#;  1. %package               = Name of the package to create the classes in
		#;  2. compile                = 1/0 1 means compile the classes, 0 means don't compile.
		#;  3. %fmWPFIsListCol        = 1/0 1 means convert word-processing fields as list collections
		#;                                  0 means convert word-processing fields as child tables
		#;  4. %readonly              = 1/0 1 means generate readonly classes, 0 means generate read/write classes
		#;  5. %fmAppendFileNoToName  = 1/0 1 means append the FM File number to each table name, otherwise 0
		#;                                  Note, the FileMan file number is always appended to Sub-File and Word-Processing field child tables.
		#;  6. %fmUseFMFiler          = 1/0 1 means File using FileMan, 0 means let IRIS file
		#;  7. %compflags             = Class compiler flags
		#;  8. %qc                    = Queue Count, value passed by reference, the number of classes queued for creation.
		#;  9. %fmOwner               = Username to use as the owner of the classes created.  The default is $Username
		#; 10. %fmRetainClass	      = 1/0 1 means that if the IRIS class already exists we will not recreate the entire class, just the properties, storage, indexes, foreign keys, etc.
		#;                              0 means we delete and recreate the class, SQL privileges and any add-ons to the class will be lost
		
	s:%fmOwner="" %fmOwner=$Username
	Do:'%fmRetainClass DeletePackage^%apiOBJ(%package,%compflags)
	d QueueClasses("0:999999999",%package,%fmWPFIsListCol,%readonly,%fmAppendFileNoToName,%fmUseFMFiler,%compflags,.%qc,%fmOwner)
	d MakeClasses(%package,compile,%readonly,%compflags)
	QUIT 1
}
 
ConvertFiles(fmlist,%package="User",compile=1,%fmWPFIsListCol=0,%readonly=0,%fmAppendFileNoToName=0,%fmUseFMFiler=1,%compflags="d-l",%qc,%fmOwner="",%fmRetainClass=0) [] PUBLIC {
		#; CONVERT LIST OF FILES TO CACHE' CLASSES
		#;  When ConvertFiles entry point is used, the entire package is not deleted, only the classes that are being converted.
		#; User Entry Point
		#;  1. fmfiles		      = List of files to convert
		#;               Each item in the list must have the following syntax:
		#;               1. from fileman file #:to fileman file # | action
		#;               2. fileman file # | action
		#;               3. fileman file #^ fielman field # | action | action is an optional parameter it must have one of the following
		#;          values:
		#;               i - INSERT, u - UPDATE, d - DELETE
		#;          examples:  9.4:10         (No action specified - figure it out)
		#;                     9.4            (Determine if INSERTING or UPDATING file)
		#;                     9.4^2|i        (INSERT field 2 in FILE # 9.4)
		#;                     9.4^4|d,9.4^2  (Delete field 4 in FILE 9.4 and determine
		#;                                     if UPDATING or INSERTING field 2)
		#;
		#;          NOTE: When ranges are specified, we only deal with TOP level FILES
		#;                To map subfiles, the file number must be uniquely sepcified.
		#;  2. %package               = Name of the package to create the classes in
		#;  3. compile                = 1/0 1 means compile the classes, 0 means don't compile.
		#;  4. %fmWPFIsListCol        = 1/0 1 means convert word-processing fields as list collections
		#;                                  0 means convert word-processing fields as child tables
		#;  5. %readonly              = 1/0 1 means generate readonly classes, 0 means generate read/write classes
		#;  6. %fmAppendFileNoToName  = 1/0 1 means append the FM File number to each table name, otherwise 0
		#;                                  Note, the FileMan file number is always appended to Sub-File and Word-Processing field child tables.
		#;  7. %fmUseFMFiler          = 1/0 1 means File using FileMan, 0 means let IRIS file
		#;  8. %compflags             = Class compiler flags
		#;  9. %qc                    = Queue Count, value passed by reference, the number of classes queued for creation.
		#; 10. %fmOwner               = Username to use as the owner of the classes created.  The default is $Username
		#; 11. %fmRetainClass	      = 1/0 1 means that if the IRIS class already exists we will not recreate the entire class, just the properties, storage, indexes, foreign keys, etc.
		#;                              0 means we delete and recreate the class, SQL privileges and any add-ons to the class will be lost
		
	s:%fmOwner="" %fmOwner=$Username
	d QueueClasses(fmlist,%package,%fmWPFIsListCol,%readonly,%fmAppendFileNoToName,%fmUseFMFiler,%compflags,.%qc,%fmOwner)
	d MakeClasses(%package,compile,%readonly,%compflags)
	QUIT 1
}
 
QueueClasses(fmlist="0:999999999",%package="User",%fmWPFIsListCol=0,%readonly=0,%fmAppendFileNoToName=0,%fmUseFMFiler=1,%compflags="d-l",%qc,%fmOwner="") [] PUBLIC {
		#; User Entry Point
		#;  1. fmfiles		      = List of files to convert
		#;               Each item in the list must have the following syntax:
		#;               1. from fileman file #:to fileman file # | action
		#;               2. fileman file # | action
		#;               3. fileman file #^ fielman field # | action | action is an optional parameter it must have one of the following
		#;          values:
		#;               i - INSERT, u - UPDATE, d - DELETE
		#;          examples:  9.4:10         (No action specified - figure it out)
		#;                     9.4            (Determine if INSERTING or UPDATING file)
		#;                     9.4^2|i        (INSERT field 2 in FILE # 9.4)
		#;                     9.4^4|d,9.4^2  (Delete field 4 in FILE 9.4 and determine
		#;                                     if UPDATING or INSERTING field 2)
		#;
		#;          NOTE: When ranges are specified, we only deal with TOP level FILES
		#;                To map subfiles, the file number must be uniquely sepcified.
		#;  2. %package               = Name of the package to create the classes in
		#;  3. %fmWPFIsListCol        = 1/0 1 means treat word-processing fields as list collections
		#;                                  0 means treat word-processing fields as child tables
		#;  4. %readonly              = 1/0 1 means geerate readonly classes, 0 means generate read/write classes
		#;  5. %fmAppendFileNoToName  = 1/0 1 means append the FM File number to each table name, otherwise 0
		#;  6. %fmUseFMFiler          = 1/0 1 means File using FileMan, 0 means let IRIS file
		#;  7. %compflags             = Class compiler flags
		#;  8. %qc                    = Queue Count, value passed by reference, the number of classes queued for creation.
		#;  9. %fmOwner               = Username to use as the owner of the classes created.  The default is $Username
 
	//d api(.4_":"_1,1,0)
	s %qc=0 s:%fmOwner="" %fmOwner=$Username
	k ^IRIS.TempFM($j),^IRIS.TempFMI($j)
	s:$e(%package,$l(%package))'="." %package=%package_"."
	d api(fmlist,%package,%readonly)
	w !!,%qc," classes queued for creation."
	QUIT
}
 
MakeClasses(%package="User",compile=1,%readonly=0,%compflags="d-l",DeleteQueue=1) [] PUBLIC {
		#; User Entry Point
		#;  1. %package               = Name of the package to create the classes in
		#;  2. compile                = 1/0 1 means compile the classes, 0 means don't compile.
		#;  3. %readonly              = 1/0 1 means generate readonly classes, 0 means generate read/write classes
		#;  4. %compflags             = Class compiler flags
		#;  5. DeleteQueue            = 1/0 1 means delete classes queed for creation.  0 means retain them
	s:$e(%package,$l(%package))'="." %package=%package_"."
	d MakeClasses^%fm2cache2(compile)
	k:DeleteQueue ^IRIS.TempFM($j),^IRIS.TempFMI($j)
	QUIT
}
 
 
		#;  FileMan files into IRIS classes
api(fmlist,%package="User.",%readonly=0) ; list is a comma delimited list
		#; Each item in the list must have the following syntax:
		#;  1. from fileman file #:to fileman file # | action
		#;  2. fileman file # | action
		#;  3. fileman file #^ fielman field # | action
		#; | action is an optional parameter it must have one of the following
		#;          values:
		#;    i - INSERT, u - UPDATE, d - DELETE
		#; examples:  9.4:10         (No action specified - figure it out)
		#;            9.4            (Determine if INSERTING or UPDATING file)
		#;            9.4^2|i        (INSERT field 2 in FILE # 9.4)
		#;            9.4^4|d,9.4^2  (Delete field 4 in FILE 9.4 and determine
		#;                            if UPDATING or INSERTING field 2)
		#;
		#; NOTE: When ranges are specified, we only deal with TOP level FILES
		#;       To map subfiles, the file number must be uniquely sepcified.
		#; 
	q:$g(fmlist)=""
	n action,anydata,data,errmsg,errtyp,fid,filen,flevl,%fmnm,%fmnmd,%fmnme,%fmnms,%fmpref,%fmsecs,i,nextid,ok,oper,syntax,topfil,updatex,x,y
	k ^IRIS.TempFMI($j,"fileman-update"),^IRIS.TempFMI($j,"fileman-update-field")
	f i=1:1:$l(fmlist,",") s x=$p(fmlist,",",i) i x'="" d
	. s y=x,action=$p(x,"|",2),x=$p(x,"|")
	. i x[":" d  q  ; do range
	.. s filen=+$p(x,":") s:filen'=0 filen=$o(^DIC(filen),-1)
	.. s x=$p(x,":",2) s:x="" x=$o(^DIC(" "),-1)
	.. f  s filen=$o(^DIC(filen)) q:filen>x  q:filen'=+filen  d
	... i $d(^DD(filen,0,"UP")) d log2("Skipping File "_filen_" Because its DD is already used for a subfile","W","",2) q
	... i '$d(^DD(filen)) d log2("Skipping File "_filen_" because its ^DD entry does not EXIST","W","",2) q
	... d addmtemp(filen,action,y)
	. s filen=$p(x,"|"),fid=$p(filen,"^",2),filen=$p(filen,"^")
	. i x'[":",'$d(^DIC(filen)) d log2("Skipping File "_filen_" because its ^DIC entry does not EXIST","W","",2) q
	. s syntax=$$syntax^%fm2cache2(filen,fid) q:syntax=""  ; invalid
	. d addmtemp(syntax,action,y)
	//i $$$traperr s $zt="err1^%fm2cache"
		#; init name map vars
	d initvars
	s flevl=1
	k ^IRIS.TempFMI($j,"fmtemp")
	s nextid="",anydata=0
userifct ; entry point to continue when userif bombs out
	//i $$$traperr s $zt="errq^%fm2cache"
	f  s nextid=$o(^IRIS.TempFMI($j,"fileman-update",nextid),1,data) q:nextid=""  d  k ^IRIS.TempFMI($j,"fileman-update",nextid)
	. s (filen,topfil)=$p(data,$c(1)),anydata=1
	. s updatex=($p(data,$c(1),3)="Y")
	. s oper=$p(data,$c(1),2),$p(oper,",",4)=""
	. s oper=$p("insert^update^delete^ignore","^",$l($p(oper,"X"),","))
	. s data=$g(^(nextid,1)),fid=$$ddtable(filen)
	. s:fid="" fid=filen s ok=$e(oper,1,$l(oper)-1)
	. i $s(oper'="ignore":1,'updatex:1,1:0) s:$e(oper,$l(oper))'="e" ok=ok_$e(oper,$l(oper)) s ok=ok_"ing "
	. s ok=ok_"fileman File # "_fid_"  "_$$setext(data)
	. s:updatex ok=ok_" - Updating indices"
	. //d log2(ok,"M")
	. s fid="" i data'="" s ok=$l(data,"->") d
	. . s filen=$p(data,"->",ok),fid=$p(filen,"^",2),filen=$p(filen,"^")
	. . q:fid'=""  q:oper'="insert"  ; get previous file if inserting
	. . s filen=$p(data,"->",ok-1),fid=$p(filen,"^",2),filen=$p(filen,"^")
	. i "^insert^delete^"[("^"_oper_"^") s updatex=1
	. i oper="insert" d  q
	. . i fid["W" s fid=+fid
	. . s ok=$s(fid="":$$add(filen,topfil),1:$$addfield(topfil,filen,fid))
	. . d:'ok log("insert",nextid)
#IF 0
	. i oper="delete" d  q
		#; if deleting a Word-Processing Field redefine filen and fid
	. . i fid["W" s:$d(^IRIS.TempFMI($j,"fid",filen,+fid)) fid=+fid d:fid["W"
	. . . n y s y=+$p($g(^DD(filen,+fid,0)),"^",2),filen=y,fid=""
	. . s ok=$s(fid="":$$delete(filen),1:$$delfld(filen,fid))
	. . d:'ok log("delete",nextid)
	. i oper="update" d  q
	. . i fid["W" s ok=$$updsubf(filen,+fid,updatex,topfil,+$p($g(^DD(filen,+fid,0)),"^",2)) i 1
	. . e  s ok=$s(fid="":$$update(filen,updatex,topfil),1:$$updfld(filen,fid,updatex))
	. . d:'ok log("update",nextid)
	. i updatex,fid'["W" d  q
	. . s ok=$s(fid="":$$updatex(filen),1:$$updfldx(filen,fid))
	. . d:'ok log("update indices",nextid)
#ENDIF
	q:'anydata
		#; convert des refs
	d References()
	k ^IRIS.TempFMI($j,"fmtemp")
	k ^IRIS.TempFMI($j,"fileman-update"),^IRIS.TempFMI($j,"fileman-update-field")
	QUIT
 
addmtemp(syntax,action,parameter) ; add filen and syntax to ^mtemp1($j global
	n SQLCODE,data,x
	s action=$$validact^%fm2cache2(syntax,action)
	i action="error" d log2("Invalid parameter '"_parameter_"' using mapping API '"_syntax_"|"_action_"'","E") q
	s data(2)=$p(syntax,"^")
	s:syntax=+syntax syntax=""
	s data(3)=syntax
	i action="i" s data(4)="X"
	i action="u" s data(5)="X",data(7)="Y"
	i action="d" s data(6)="X"
	s data(1)=$i(^IRIS.TempFMI($j,"fileman-update"))
	s ^IRIS.TempFMI($j,"fileman-update",data(1))=data(2)_$c(1)_$g(data(4))_","_$g(data(5))_","_$g(data(6))_$c(1)_$g(data(7))
	s:$g(data(3))'="" ^IRIS.TempFMI($j,"fileman-update",data(1),1)=data(3)
	QUIT
 
 
ddtable(filen) [] PUBLIC {
		#;extrinsic function to return the fileman table name (From %qadltb)
	QUIT:'$d(^DD(filen)) ""
	s up=$g(^DD(filen,0,"UP")) i $g(up) s fid=$o(^DD(up,"SB",filen,""))
	i $g(fid) s btabnm=$p($g(^DD(up,fid,0)),"^")
	e  s btabnm=$p($g(^DIC(filen,0)),"^")
	s:btabnm="" btabnm="fmtab"
	QUIT btabnm
}
 
 
ddtable2(key,test,keyold,filen="",child=0) [] PRIVATE {
		#; return a unique table name (From %qadlnmp)
		#; if in test mode, precede table name with 1 or 0 to indicate 
		#; if successfully translated
	s:key="" key="fmtab"
	i $g(%fmAppendFileNoToName)||child s key=key_$s($g(filen)'="":"_"_$g(filen),1:"")
	s key=$tr(key,$p($g(%fmpref),$c(1),4),$p($g(%fmpref),$c(1),3))
	s key=$$keycomp^%fm2cache2(key,128,$g(test)) i '$g(test),key="" s key="fmtab"_"_"_$tr($g(filen),".",dectrans)
		#; in test mode, uniqueness not tested because no fields are created
	i "*"'[key,'$g(test) s key=$$unique(key,"^IRIS.TempFMI($j,""rv"")",128,$g(keyold),,,filen)
	i "*"'[key,$g(test) s key=($l(key)'>128)_key
	QUIT key
}
 
 
ddfield(key,filen,keyold,test,fid="reference") [] {
		#; return a unique field name
		#; if in test mode, precede field name with 1 or 0 to indicate
		#; if successfully translated
	s key=$$keycomp^%fm2cache2(key,128,$g(test))
		#; in test mode, uniqueness not tested because no fields are created
		#; check for non-mapping names
	i '$g(test),"*"'[key s key=$$unique(key,"^IRIS.TempFM($j,"_filen_",""f"")",128,$g(keyold),"ddfield",fid)
	i $g(test),"*"'[key s key=($l(key)'>128)_key
	QUIT key
}
 
 
ddfieldu(key,filen,keyold) [] PUBLIC {
		#; return a unique field name
	s key=$$unique(key,"^IRIS.TempFM($j,"_filen_",""f"")",128,$g(keyold))
	QUIT key
}
 
 
unique(val,glo,len,ignore,caller,fid,filen="") ; find a unique name for the value in val
	#; if value equal 'ignore' then ignore uniqueness. (Updates)
	n i,up,upignore,x
	s ignore=$g(ignore),up=$$$UPPER(val),upignore=$$$UPPER(ignore),x=up QUIT:up=upignore ignore
	i '$d(@glo@(up)),'$d(^%qSQL("reservewords",up)) q val
	i filen'="" s val=val_"_"_$tr(filen,".","_") i '$d(@glo@($$$UPPER(val))),'$d(^%qSQL("reservewords",$$$UPPER(val))) q val
	i $g(caller)="ddfield",$d(^%qSQL("reservewords",up)) s val=val_$tr(fid,".",$e($p($g(%fmpref),$c(1),3)_"_",1)) s:$l(val)>len val=$e(val,1,40) s up=$$$ALPHAUP(val) i '$d(@glo@(up)),'$d(^%qSQL("reservewords",up)) q val
	i $l(val)<len f i=48:1:57,65:1:91 s x=up_$c(i) q:x=upignore  q:'$d(@glo@(x))&'$d(^%qSQL("reservewords",x))
	q:x=upignore ignore
	i $t,i<91 q val_$c(i)
uniqloop s up=$e(up,1,$l(up)-1) i up="" q ""
	f i=48:1:57,65:1:91 s x=up_$c(i) q:x=upignore  q:'$d(@glo@(x))&'$d(^%qSQL("reservewords",x))
	i x=upignore q ignore
	i i<91 q x
	g uniqloop
 
 
setext(path) ;
	n ext,i,x s ext=""
	f i=1:1 s x=$p(path,"->",i) q:x=""  q:$p(x,"^",2)=""  s ext=ext_$p(^DD($p(x,"^"),+$p(x,"^",2),0),"^")_"->"
	QUIT $e(ext,1,$l(ext)-2)
 
 
add(filenum,topfil) ; CREATE NEW BASE TABLE(S) FROM FILE # filenum
	n anydata,compil,flevl,nextid,ok
	s flevl=1,ok='$$CreateTable(filenum,"",topfil)
	QUIT ok
 
 
CreateTable(filen,dflg,topfil) ;
	#; Create Base Table From FileMan File
	#;
	#; Called as extrinsic function
	#; Input Parameters - filen = FileMan File # (ref to ^DIC)
	#;                    dflg  >0 (creating a designated table)
	#;                             (dflg indicates level of nesting)
	#;                    topfil = file # of top level file
	#; Returns          - 0 = success, >0 = error code
	#;
	#; Global variables used in pgm:
	#; btabnm = base table name
	#; gloref = full global reference of master map
	#; level  = level of subscripting in master master
	#; 
		#; Setup some stuff
	n err,gloref,level,mapname,RowIDDefault,SQLCODE,tabname
	s err=0,SQLCODE=0
	s dflg=+$g(dflg) i 'dflg d
	. s topfil=filen
	. q:$g(jobfm)  ; don't reset the job for fileman
	. k ^IRIS.TempFMI($j,"fmtemp")
	d log2("Analyzing File(s) For "_$s(+dflg:"Pointer ",1:"")_"File #"_filen_"  Name: "_$$ddtable(filen),"M",5*dflg)
	s tabname=$$table(filen,.err) i err g error
	s mapname=$$map(filen,tabname,.gloref) i err g error
	d mapsubs(filen,tabname,mapname,gloref,.level,.err) i err g error
	d maprowid(filen,mapname,level) i err g error
	s RowIDDefault=$$nextdef(filen,mapname) i err s err=14 g error
	//s $li(^IRIS.TempFM($j,filen),10)=RowIDDefault
		#;Define IDKEY IEN (Internal Entry Number) field
	s ^IRIS.TempFM($j,filen,"f","IEN")=$lb("IEN","Internal Entry Number","%Library.String",1,,,,,,,,,,$lb($lb("COLLATION","EXACT"),$lb("TRUNCATE",0)),2,0,RowIDDefault,)
		#; Create IDKey index for IEN field
	s ^IRIS.TempFM($j,filen,"i","IDKEYINDEX")=$lb("IDKeyIndex","idkey",$lb("IEN"))
	d fields(filen,tabname,mapname,+dflg,topfil) i err g error
	d index(filen,tabname,.err) i err s err=12 g error
	d index2(filen,tabname,.err) i err QUIT 0  	// new-style cross references
	//s ^mtemp1("fmtemp",jobfm,"list",tabirn)=btabnm
	//d setrow^%qcrsapi(tabirn_"|500000")
	If %fmUseFMFiler d CreateFMFilingTriggers^%fm2cache2(filen,gloref,0)
	d log2("Base Table '"_tabname_"' queued for creation (File #"_filen_")","M",5*dflg)
	s %qc=%qc+1
	QUIT 0 ; success
 
 
table(filen,err) [] {
		#; create base table
	i $d(^IRIS.TempFM($j,filen)) s err=1 QUIT ""
	i '$d(^DD(filen,.01,0)) s err=2 QUIT ""
	s tabname=$$ddtable(filen)	// tabname is now FileMan table name
	s tabname=$$ddtable2(tabname,,,filen) i "*"[tabname s err=$s(tabname="":3,1:16) QUIT "" ; check if not mapping on purpose
	s datype=$$datype($p(^DD(filen,.01,0),"^",2))
	i datype="" s err=7 q  ; unsupp. datatype for 'Name' field
	s desc="Generated class for FileMan File Number: '"_filen_"'  File Name: '"_$o(^DD(filen,0,"NM",""))_"'   Class generated by %fm2cache version "_$$$FM2CacheVersion
	s ^IRIS.TempFM($j,filen)=$lb(tabname,desc,%fmOwner,,"Y","RowId",$lb(tabname_".IEN"),$lb(tabname_".IEN"),"RowId")
	s ^IRIS.TempFMI($j,"rv",$$$UPPER(tabname))=filen
	s ^IRIS.TempFMI($j,"fm",filen)=$lb(tabname,desc)
	QUIT tabname
}
 
 
map(filen,tabname,gloref,topfile="") [] {
		#; create master map
		#; gloren returned - PBR
	s:topfile="" topfile=filen
	s gloref=^DIC(topfile,0,"GL")
	s mapname=tabname_" Data Map"
	s ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname))=$lb(mapname,$p(gloref,"("),"Y")
	QUIT mapname
}
 
mapsubs(filen,tabname,mapname,gloref,level,err) [] {
		#; Create Map Subscripts
		#; Map simple table with no parents
		#; FIRST DO LITERAL SUBSCRIPTS
		#;  ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"s",level) = $lb(<optional FieldName>,<subscript expression>,<invcond>,<nextsub>)
	s level=0,i=0
	s subs=$e(gloref,$f(gloref,"("),$l(gloref)-1)
	i subs'="" d lexan(gloref,.subs,.level) f i=1:1:level d
	. s subi=level(i)
	. i $e(subi)="""",$e(subi,$l(subi))="""" s subi=""""_$tr(subi,"""")_""""
	. s ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"s",i)=$lb(,subi)
	. s gloref=gloref_$$quoter(subi)_","
		#; THEN DO VARIABLE SUBSCRIPT
	s level=i+1
	s invcond=$lb("{L"_level_"}'>0")
		#; DPV3486 - for the PREV code, start at ":" and reverse $order to pick up all the numeric subscript values.
		#;           Old code started at 0, which was wrong.
	s nextsub=$lb("s:{L"_level_"}="""" {L"_level_"}=0 s {L"_level_"}=$o(^({L"_level_"})) s:'{L"_level_"} {L"_level_"}=""""",";PREV","s:{L"_level_"}="""" {L"_level_"}="":"" s {L"_level_"}=$o(^({L"_level_"}),-1) s:'{L"_level_"} {L"_level_"}=""""")
	s ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"s",level)=$lb(tabname_".IEN","{"_tabname_".IEN}",invcond,nextsub)
	s gloref=gloref_$c(1)_","
	QUIT
}
 
 
MapSubsChild(pfilen,cfilen,tabname,mapname,gloref,parprof,err) [] {
	#; Create Map Subscripts
 
		#; First copy parent map subs to child map subs
		#;	Find master map of parent
		#; Build gloref for use in Delete Trigger of Child Table (to set into DIC)
		
	s pmap="" f  s pmap=$o(^IRIS.TempFM($j,pfilen,"m",pmap),1,data) q:pmap=""  i $lg(data,3)="Y" q
	i pmap="" s err=17 q  // *** No master map in parent table???
	s MAPNAME=$$$UPPER(mapname)
	s i="",gloref=$p(gloref,"(")_"(" For  {
		s i=$o(^IRIS.TempFM($j,pfilen,"m",pmap,"s",i),1,data) q:i=""  
		s ^IRIS.TempFM($j,cfilen,"m",MAPNAME,"s",i)=data
			#;  gloref has constant or $c(1) for DA() position holder
		s gloref=gloref_$s($lg(data)="":$lg(data,2),1:$c(1))_","
	}
	s level=$o(^IRIS.TempFM($j,cfilen,"m",MAPNAME,"s",""),-1)
		#;  Now insert literal child subscript(s)
	s subi=$p($p(parprof,"^",4),";",1)
	i +subi'=subi s subi=""""_subi_""""
	s ^IRIS.TempFM($j,cfilen,"m",MAPNAME,"s",$i(level))=$lb(,subi)
	s gloref=gloref_subi_","
		#;  Now insert variable child subscript(s)
	s level=level+1
	s invcond=$lb("{L"_level_"}'>0")
		#; DPV3486 - for the PREV code, start at ":" and reverse $order to pick up all the numeric subscript values.
		#;           Old code started at 0, which was wrong.
	s nextsub=$lb("s:{L"_level_"}="""" {L"_level_"}=0 s {L"_level_"}=$o(^({L"_level_"})) s:'{L"_level_"} {L"_level_"}=""""",";PREV","s:{L"_level_"}="""" {L"_level_"}="":"" s {L"_level_"}=$o(^({L"_level_"}),-1) s:'{L"_level_"} {L"_level_"}=""""")
	s ^IRIS.TempFM($j,cfilen,"m",MAPNAME,"s",level)=$lb(tabname_".IEN","{"_tabname_".IEN}",invcond,nextsub)
	QUIT
}
 
 
maprowid(filen,mapname,level) [] {
		#; Create Map Row Id
	s ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"r",level)=$lb("IEN","{L"_level_"}")
	QUIT
}
 
 
CreateMapRowid(filen,mapname,level) [] {	// Create Map Row Id Info
		#; get row-id physical based-on field names
	s based=$lg(^IRIS.TempFM($j,filen),7)
	s MAPNAME="" f  s map=$o(^IRIS.TempFM($j,filen,"m",map),1,data) q:MAPNAME=""  i $lg(data,3)="Y" q
	s ilev="" For  {
		s ilev=$o(^IRIS.TempFM($j,filen,"m",MAPNAME,"s",ilev),1,data)
		If '$lf(based,$lg(data,1)) continue	// Based on field not at this subscript level
		s ^IRIS.TempFM($j,filen,"m",MAPNAME,"r",$i(^IRIS.TempFM($j,filen,"m",MAPNAME,"r")))=$lb($lg(data,1),"{L"_ilev_"}")
	}
 }
 QUIT
 
 
nextdef(filen,mapname,err) [] {
		#; returns initialexpression of rowid field
	s glo=$lg(^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname)),2),pcount=0
	s ilev=0 f  s ilev=$o(^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"s",ilev),1,data) q:'ilev  s level($i(level))=$lg(data,2)
	s ifn=$tr(level(level),"{}") ; get bottom level ifn
	s ref=glo_"("
	f ilev=1:1:level-1 d
	. s ref=ref_$s($e(ref,$l(ref))="(":"",1:",")
	. i level(ilev)'["{" d  q
	.. i +$p(level(ilev),$c(1))'=$p(level(ilev),$c(1)) d
	... i $e(level(ilev))="""" s ref=ref_""""_$tr($p(level(ilev),$c(1)),"""")_""""
	... ; no special handling for MUMPS expressions
	... e  s ref=ref_$p(level(ilev),$c(1))
	.. e  s ref=ref_$p(level(ilev),$c(1))
	. s pcount=pcount+1
	. s ref=ref_"$p(%d(0),""||"","_pcount_")"
	s ref=ref_$s($e(ref,$l(ref))="(":"",1:",")_"0)"
	s ref="$p("_ref_",""^"",3)"
	s ref="$$next^%apiSQL("_$$quoter(ref)_")"
	i $l(ref)>250 s err=1 QUIT ""
	QUIT ref
}
 
 
GlobalRef(filen,mapname) [] {
	s glo=$lg(^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname)),2)_"("
	s ilev=0 f  s ilev=$o(^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"s",ilev),1,data) q:'ilev  s level($i(level))=$lg(data,2)
	s level="" f  { s level=$o(level(level)) q:level=""  s glo=glo_$s($e(glo,$l(glo))="(":"",1:",")_level(level) } s glo=glo_")"
	QUIT glo
}
 
 
 
fields(filen,tabname,mapname,flevl,topfil) [] {
	#; Create Base Table Fields
	#; This subroutine loops through all of the fields for a File Man file
	#; If the field is a pointer, we recursively call the base table
	#; creation routine to establish the designated table.  If the field
	#; points to a sub-file, we recursively call the child table creation
	#; routine to establish the child, and its descendents.
	#;
	#; Parameters - flevl=level of recursive call
	#;
	s fid=.000099 s icol=2 f  s fid=$o(^DD(filen,fid)) q:+fid=0  d:$d(^DD(filen,fid,0)) onefield ; q:SQLCODE!err
	QUIT
 
 
onefield ; Create One Field Given filen and fid
		#; STEP 1: DEFINE FIELD
		#; DETERMINE DATA TYPE
	//i $$$traperr n zt s zt=##vendor($zt),##vendor($zt)="err^%qadlfls"
	k Collection,DisplayList,fldnm,desc,type,ReadOnly,required,SQLComputed,Transient,SQLComputedCode,TypeParam,ValueList
	s nocon=0,ReadOnly=0
	i '$d(^DD(filen,fid,0)) s nocon=1,x="WARNING: Omitting Field #"_fid_" in DD #"_filen_" - Missing 0 node." d log2(x,"W",flevl*5) q
	s stuff=^DD(filen,fid,0) // get field specs.
	s flength=$g(^DD(filen,fid,30))
	s fmtype=$p(stuff,"^",2)
	s datype=$$datype(fmtype)
	i datype="" s nocon=1,x="WARNING: Omitting Field "_$p(stuff,"^")_" - Unsupported Data Type." d log2(x,"W",flevl*5) q
	i $p(stuff,"^",5)="",fmtype["D",'fmtype s nocon=1,x="WARNING:  Omitting Field "_$p(stuff,"^")_" - Null Input Transform on a Date field." d log2(x,"W",flevl*5) q
 
		#;
		#;IF CHILD TABLE and not Word-Proc: SAVE symbol, Create Child and Quit
		#;   if Word-Proc act according to preferences
	s:datype=100 wp=$$wordproc(+fmtype)
	i datype=100,$s('wp:1,'%fmWPFIsListCol:1,1:0) {
		s ret=$$ChildTable(tabname,filen,fid,flevl+1,,topfil,wp) QUIT:ret=1 //s err=11 g err
		s x="WARNING: Field #"_fid_" Has Invalid Sub-File - Omitted."
		d log2(x,"W")
		QUIT
	}
	s:datype=100 datype="8W"
 
		#;
		#; GET BASIC INFORMATION FOR FIELD
	s fldnm=$$ddfield($p(stuff,"^"),filen,,,fid)
	
	i "*"[fldnm {
		s x="Omitting Field "_$p(stuff,"^")_" - "
		s x=x_$s(fldnm="*":"Non - mapping",1:"Non - unique or invalid")
		s x=x_" field name" d log2(x,"W",flevl*5)
		QUIT
	}
	s dt=+datype 					// DataType ; PNT004 (datype = 8-> for mult pointer)
	s required=($p(stuff,"^",2)["R")		// Required &&$d(^DD(filen,0,"ID",fid)):1,1:0) 	// Required
 
		#;
		#; MULTIPLE CHOICE DATA TYPE
	i dt=6 {  ; Multi-Choice Data Type
		s type="%Library.EnumString"
		s x=$p(stuff,"^",3) f j=1:1:$l(x,";") s y=$p(x,";",j) q:y=""  s $p(DisplayList,";",j)=$p(y,":",2),$p(ValueList,";",j)=$p(y,":")
		s TypeParam("VALUELIST")=";"_ValueList
		s TypeParam("DISPLAYLIST")=";"_DisplayList
	}
 
		#;
		#; DESIGNATIVE REFERENCE DATA TYPE
	i dt=10 {
		s x=$p(stuff,"^",2),y=$f(x,"P"),zfil="",ok=1
		f j=y:1:$l(x) q:$e(x,j)'?.1n.1"."  s zfil=zfil_$e(x,j)
		i 'zfil s ok=0,x="Invalid Pointer For Field #"_fid_". Omitted." d log2(x,"W") QUIT
			#; IF DESIGNATED TABLE ALREADY EXISTS, JUST GET ITS ROW-ID
			#;  store des refs and make text field temporarily
		s type="%Library.String"	// Text Data Type         
	}
	
		#;
		#; THEN ADD INFO FROM FILE-MAN FIELD SPECIFICATION
	i +datype=8 {
			#; Function (default 'EXACT' for text flds)
		s type="%Library.String"	// Text Data Type
		s:datype="8W" Collection="list"       
		s TypeParam("COLLATION")="EXACT"
		s TypeParam("TRUNCATE")=0
		s TypeParam("MAXLEN")=255	// DPV3126 default
		#;s:datype="8->" ReadOnly=1	// DPV3008
	}
	
	If fmtype["W" { s TypeParam("MAXLEN")=32000 } // Word Processing Data Type
	ElseIf $p(stuff,"^",5,99)["$L(X)>",dt'=10 { 
		s x=$p(stuff,"^",5,99) s:+$p(x,"$L(X)>",2) TypeParam("MAXLEN")=+$p(x,"$L(X)>",2) // MaxLen
		s:+$p(x,"$L(X)<",2) TypeParam("MINLEN")=+$p(x,"$L(X)<",2) 			 // MinLen
	}
	ElseIf $g(type)="%Library.String",dt'=10 { s TypeParam("MAXLEN")=255 }
	If $p(stuff,"^",5)'="",$p(stuff,"^",5)'="Q" {
		s x=$p(stuff,"^",5,999) i fmtype["D" d fmdate(x,fmtype,flength,.type) k TypeParam("MAXLEN"),TypeParam("MINLEN")
	}
	i fmtype["Q" {}		// MUMPS Code DataType (no-op)
	If fmtype["J" {
		s x=$e(fmtype,$f(fmtype,"J"),$l(fmtype)) s:+$p(x,",",2) TypeParam("SCALE")=+$p(x,",",2) 	// NuDeci
	}
		#;	If $d(^DD(filen,fid,"DEL")),fmtype'["R" {	// Maybe Required - no-op for now
		#;		s data(9)="M" ; Required = 'Maybe'
		#;		s data(10)="$$execute^%qadlutl("_filen_","_fid_")"
		#;	} 
	i dt=5,fmtype'["D" {	// numeric data type (Exclude date/time)
		s type="%Library.Numeric"
		k TypeParam("MAXLEN"),TypeParam("MINLEN")
		i fmtype?.e1","1n.n.e s TypeParam("SCALE")=+$p(fmtype,",",2) ; Nu decPlaces
		s x=$p(^DD(filen,fid,0),"^",5)
		// *** i x["S:X[""$""" s data(26)="$" ; NuLeadPn
		i x["(X>" s y1=$f(x,"(X>"),y2=$f(x,")",y1),z=$e(x,y1,y2-2) s:$isvalidnum(z) TypeParam("MAXVAL")=z ; NuMax
		i x["(X<" s y1=$f(x,"(X<"),y2=$f(x,")",y1),z=$e(x,y1,y2-2) s:$isvalidnum(z) TypeParam("MINVAL")=z ; NuMin
	}
		#; if .001 field make computed equal to RowId or Sub
	i fid=.001 {
		s type="%Library.String"
		k TypeParam s TypeParam("COLLATION")="EXACT",TypeParam("TRUNCATE")=0
		s SQLComputed=1
		s Transient=1
		s logical=$lg(^IRIS.TempFM($j,filen),8)
		s SQLComputedCode=$lb(" Set {*}={"_$$$LastPiece($li(logical,$ll(logical)),".")_"}")
	}
 
		#;
		#; INSERT FIELD INFO INTO FIELD TABLE
	s:$g(type)=""&&(dt'=10) type="%Library.String",TypeParam("MAXLEN")=255
	If $d(TypeParam) {
		s TypeParam=""
		s p="" f  s p=$o(TypeParam(p),1,d) q:p=""  s TypeParam=TypeParam_$lb($lb(p,d))
	}
	i dt=10 /*k TypeParam */s ^IRIS.TempFMI($j,"desref",tabname,fldnm)=$lb(zfil,2,fldnm)
 
		#;
		#; NOW ADD MORE INFO TO BASIC FIELD DEFINITION
		#; Fixed length fields must be made computed
	i $p($p(stuff,"^",4),";",2)?1"E".e s fmtype="C"_fmtype
	i fmtype["C" {	// Set Up Computed Field Stuff
		s SQLComputed=1,err="" // CompField
		If $p($p(stuff,"^",4),";",2)'?1"E".e {
			#; Compute Real Computed Fields
			s Transient=1		// ComEqualValue
			s SQLComputedCode=$lb("s U=""^"",X=$zd($h),%DT=""X"" d ^%DT s DT=Y")
			s SQLComputedCode=SQLComputedCode_$lb("f i=1:1:$l({RowId},""||"") s @(""D""_(i-1))=$p({RowId},""||"",i)")
			s SQLComputedCode=SQLComputedCode_$lb("s Y={"_fldnm_"}")
			s SQLComputedCode=SQLComputedCode_$lb($$codeopt($p(stuff,"^",5,999)))
			s SQLComputedCode=SQLComputedCode_$lb("s {"_fldnm_"}=X")
			i $s($g(fmtype)["D":1,$g(fmtype)[",":1,1:0) s SQLComputedCode=SQLComputedCode_$lb("q:X="""" ")
		}
		Else {
				#; Compute Fixed Length Fields
			s gloref=$$GlobalRef(filen,mapname)
			s node=$p($p(stuff,"^",4),";",1)
			i +node'=node s node=""""_node_""""
			s x=$p($p(stuff,"^",4),";",2)
			s x=$e(x,$f(x,"E"),$l(x))
			s ext1=$p(x,",",1),ext2=$p(x,",",2)
			s gloref=$e(gloref,1,$l(gloref)-1)_","_node_")"
			d find(filen,gloref,.nodename) i nodename="" s nodename=$$makenode(filen,stuff,fldnm,fid,gloref,.icol)
			d:'%readonly&&('%fmUseFMFiler) trig(filen,fldnm,nodename,ext1,ext2,gloref)
			s exp="$e({"_nodename_"},"_ext1_","_ext2_")"
			s Transient=1		// ComEqualValue
			s SQLComputedCode=$lb("s {"_$$quoter2(fldnm)_"}="_exp)
		}
	}
	s fieldlength=flength s:$g(TypeParam("MAXLEN")) fieldlength=TypeParam("MAXLEN")
	
	s description="FileMan Field Label: '"_$p(stuff,"^")_"'  FileMan Field Number: '"_fid_"'"
	i $d(^DD(filen,fid,.1)) s description=description_$$$NL_^(.1)		// Was converted to FDBMS Caption
	s x=0 f  s x=$o(^DD(filen,fid,21,x)) q:x'=+x  s description=description_$$$NL_$g(^DD(filen,fid,21,x,0))	// Was converted to FDBMS Long Help
	s ^IRIS.TempFM($j,filen,"f",$$$UPPER(fldnm))=$lb(fldnm,description,type,required,fieldlength,$g(TypeParam("COLLATION")),$g(SQLComputed),$g(Transient),$g(SQLComputedCode),,,,,$g(TypeParam),$i(icol),0,,$g(Collection),ReadOnly)
	s ^IRIS.TempFMI($j,"fid",filen,fid)=$lb(fldnm,desc,+$g(SQLComputed)+$g(Transient),datype="8W",icol,ReadOnly)
 
		#;
		#; STEP 2: ADD FIELD TO MAPPED DATA
	i fmtype["C" QUIT  	// Computed fields not mapped
	i fid=.001 QUIT  	// .001 field is NEVER mapped
	k node,piece,delimiter,RetrievalCode
	s MAPNAME=$o(^IRIS.TempFM($j,filen,"m",""))	// Only 1 map defined at this time
	i datype="8->" {
		s gloref=$lg(^IRIS.TempFM($j,filen,"m",MAPNAME),2)_"("
		s sub="" f  s sub=$o(^IRIS.TempFM($j,filen,"m",MAPNAME,"s",sub)) q:sub=""  s gloref=gloref_"{S"_sub_"},"
		s node=$p($p(stuff,"^",4),";",1) s:node'=+node node=""""_node_""""
		s piece=$p($p(stuff,"^",4),";",2) ; Piece
		s gref="$p($g("_gloref_node_")),""^"","_piece_")"
		d multpc^%fm2cache2(filen,fid,tabname,fldnm,fldnm,.icol,MAPNAME,gref)	// multiple pointer fields
	}
	If datype="8W" {
		s sub=$o(^IRIS.TempFM($j,filen,"m",MAPNAME,"s",""),-1)
		s sub="S"_sub
		s node=$p($p(stuff,"^",4),";",1) s:node'=+node node=""""_node_""""
		s RetrievalCode=$lb("n i,j,nl s {"_$$quoter2(fldnm)_"}="""",j={%row},nl=$p($g(^({"_sub_"},"_node_",0)),""^"",3) f i=1:1:nl s j={%row},$li({"_$$quoter2(fldnm)_"},i)=$g(^({"_sub_"},"_node_",i,0))")
	}
	ElseIf 0,datype="8->" {	// DPV3008=
		s gloref=$lg(^IRIS.TempFM($j,filen,"m",MAPNAME),2)_"("
		s sub="" f  s sub=$o(^IRIS.TempFM($j,filen,"m",MAPNAME,"s",sub)) q:sub=""  s gloref=gloref_"{S"_sub_"},"
		s node=$p($p(stuff,"^",4),";",1) s:node'=+node node=""""_node_""""
		s piece=$p($p(stuff,"^",4),";",2) ; Piece
		s RetrievalCode=$lb("n vp s {"_$$quoter2(fldnm)_"}="""",vp=$p($g("_gloref_node_")),""^"","_piece_") s:vp'="""" {"_$$quoter2(fldnm)_"}=$p($g(@(""^""_$p(vp,"";"",2,999)_+vp_"",0)"")),""^"")")
	}
	Else {
		s node=$p($p(stuff,"^",4),";",1) ; Node
		i +node'=node s node=""""_node_""""
		i fmtype'["W" {
			s piece=$p($p(stuff,"^",4),";",2) ; Piece
			s delimiter="""^""" ; Delimiter
		}
	}
	s ^IRIS.TempFM($j,filen,"m",MAPNAME,"d",$i(^IRIS.TempFM($j,filen,"m",MAPNAME,"d")))=$lb(fldnm,$g(node),$g(piece),$g(delimiter),$g(RetrievalCode))
	k node,piece,delimiter,RetrievalCode
		#; insert triggers to update field
	If datype="8W",'%readonly,'%fmUseFMFiler {
		s gloref=$$GlobalRef(filen,MAPNAME),gloref=$e(gloref,1,$l(gloref)-1)
		s node=$p($p(stuff,"^",4),";",1) s:node'=+node node=""""_node_""""
		s gloref=gloref_","_node,lines=0,gloref=$$swap(gloref)
		s code1="n DA,i f i=1:1:$l({RowId},""||"") { s DA(i)=$p({RowId},""||"",i) } k "_$$fixglref(filen,gloref)_")"
		s code2="f i=1:1:$ll({"_$$quoter2(fldnm)_"}) { s "_gloref_",i,0)=$lg({"_$$quoter2(fldnm)_"},i) } s i=$ll({"_$$quoter2(fldnm)_"}),$p(DA,""^"",3,4)=i_""^""_i,i=$zd(+$H,1)"
		s code3="s:$l($p(i,""/"",3))=2 $p(i,""/"",3)=$s(+$H<21550:18,+$H>94598:21,+$H>58073:20,1:19)_$p(i,""/"",3) s i=($p(i,""/"",3)-1700)_$p(i,""/"",1)_$p(i,""/"",2)"
		s code4="s $p(DA,""^"",5)=i,"_gloref_",0)=DA"
		s gloref=gloref_")"
 
		s ^IRIS.TempFM($j,filen,"t","AfterInsert"_fldnm)=$lb("INSERT","AFTER",0,"AFTER INSERT Trigger to file word-processing field: "_fldnm,$lb($c(9)_code1,$c(9)_code2,$c(9)_code3,$c(9)_code4))
		s code0="If {"_$$quoter2(fldnm)_"*C} {"
		s ^IRIS.TempFM($j,filen,"t","AfterUpdate"_fldnm)=$lb("UPDATE","AFTER",0,"AFTER UPDATE Trigger to file word-processing field: "_fldnm,$lb(code0,$c(9)_code1,$c(9)_code2,$c(9)_code3,$c(9)_code4,"}"))
		s code1="n DA,i f i=1:1:$l({RowId},""||"") { s DA(i)=$p({RowId},""||"",i) } k "_$$fixglref(filen,gloref)
		s ^IRIS.TempFM($j,filen,"t","AfterDelete"_fldnm)=$lb("DELETE","AFTER",0,"AFTER DELETE Trigger to file word-processing field: "_fldnm,$lb($c(9)_code1))
	}
	QUIT
}
 
 
swap(x) [] PRIVATE {
		#; swap every {###} not within quoetes for DA(#)
	s pz=1,sub=0
swapexp s a=$p(x,"{",1,pz),b=$p(x,"{",pz+1,999) QUIT:b="" x 
	s field=$p(b,"}"),b=$p(b,"}",2,999)
		#; if {} within quotes or contents not a field skip it 
	If $l(a,"""")#2=0 { s pz=pz+1 g swapexp } s sub=sub+1,x=a_"DA("_sub_")"_b g swapexp
}
 
find(filen,gloref,nodename) [] {
		#; Find Out If There Is Computed Field For gloref
	s fld="",nodename=""
	For  {
		s fld=$o(^IRIS.TempFM($j,filen,"f",fld),1,data) q:fld=""
		continue:$lg(data,9)=""	// No computed code
		s compcode=$li(data,9)
		f i=1:1:$ll(compcode) i $lg(compcode,i)[("}=$g("_gloref) s nodename=$lg(data) q
	}
	QUIT
}
 
 
makenode(filen,stuff,fldnm,fid,gloref,icol) [] {
		#; Establish Computed Field For Node That Fixed Length
		#; Fields Are Extracted From
		#;
		#; Input  - gloref = global reference for computed field
		#; Output - fldnm  = name of newly created field
	s fldnm="NODE_"_$p($p(stuff,"^",4),";",1)
	s fldnm=$$ddfield(fldnm,filen,,,fid)
	s desc="Computed Field For Node "_$p($p(stuff,"^",4),";",1)	// Description
	s type="%Library.String"
	s TypeParam=$lb($lb("MAXLEN",255),$lb("COLLATION","EXACT"),$lb("TRUNCATE",0))
	s SQLComputed=1 ; CompField
	s Transient=1 ; ComEqualValue
	s SQLComputedCode=$lb("s {"_$$quoter2(fldnm)_"}=$g("_$$fixglref(filen,gloref)_")")
	s ^IRIS.TempFM($j,filen,"f",$$$UPPER(fldnm))=$lb(fldnm,desc,type,0,255,"Exact",$g(SQLComputed),$g(Transient),$g(SQLComputedCode),,,,,TypeParam,$i(icol),0)
	s ^IRIS.TempFMI($j,"fid",filen,fid)=$lb(fldnm,desc,+$g(SQLComputed)+$g(Transient),0,icol)
	QUIT fldnm
}
 
 
fixglref(filen,gloref) [] {
		#;  We have a global reference which might reference fields from other 
		#;  (parent) tables.  Since Computed field code is not allowed to 
		#;  reference fields from other tables, we have to turn these into 
		#;  $Piece({RowID},"",xxx) reference.
		#;
	s data=$g(^IRIS.TempFM($j,filen))
	QUIT:$lg(data,5)'="Y" gloref 	// RowID not based on other fields
	s physical=$lg(data,7)
	QUIT:physical=$lg(data,8) gloref ; Physical and Logical RowID field list is the same
	For i=1:1:$ll(physical) {
		s field=$lg(physical,i)
		continue:$p(field,".")=$lg(data,1)	// field from this table
		s gloref=$$strrep(gloref,"{"_field_"}","$p({RowId},""||"""_$s(i=1:"",1:","_i)_")",1) 
	}
	QUIT gloref
}
 
 
trig(filen,fldnm,nodename,ext1,ext2,gloref) [] {
		#; create triggers
	s code="n space,x,y s $p(space,"" "",256)="""",x={"_nodename_"},y=$e(x,"_(ext2+1)_",$l(x))"
	s:ext1'=1 code=code_",x=$e(x_space,1,"_(ext1-1)_")"
	s code2="$e({"_$$quoter2(fldnm)_"}_space,1,"_(ext2-ext1+1)_")_y"
	s:ext1'=1 code2="x_"_code2 s code2="s x="_code2
	s code3="s y=$tr(x,"" ""),y=$e(y,$l(y)),"_$$fixglref(filen,gloref)_"=$p(x,y,1,$l(x,y)-1)_y // strip trailing spaces"
	s ^IRIS.TempFM($j,filen,"t","AfterInsert"_fldnm)=$lb("INSERT","AFTER",0,"AFTER INSERT Trigger to file fixed-length computed field: "_fldnm,$lb(code,code2,code3))
	s code0="If {"_$$quoter2(fldnm)_"*C} {",code4="}"
	s ^IRIS.TempFM($j,filen,"t","AfterUpdate"_fldnm)=$lb("UPDATE","AFTER",0,"AFTER UPDATE Trigger to file fixed-length computed field: "_fldnm,$lb(code0,$c(9)_code,$c(9)_code2,$c(9)_code3,code4))
	QUIT
}
 
fmapins //&sql(INSERT INTO MapData VALUES :data())
	QUIT
 
 
fmdate(x,fmtype,flength,type) [] {
	#; general date subroutine,
	#;         Input variables are: x          Fileman code
	#;                              fmtype     Fileman DataType
	#;                              flength    Field's length
	#;        Output variables are: type       Field's datatype
	#; Deal with Date-Time formats - get rid of Secs if no Time
 
	n %DT s %DT=$p($p(x,"%DT=""",2),"""") s:fmtype["C" %DT="",x=""
	s:%DT'["T" %DT=$tr(%DT,"S","")
		#; date format v.s. date-time format
		#;  It could be true that a field has a "T" code, but only a length
		#;  of 7, which can only hold a date.  If the field specifies a length
		#;  and we know the length can only hold a date value, then just make it
		#;  a Date.
	If %DT["T"||(%DT["C") {
		If flength,flength<8 { s type="%Library.FilemanDate" }	// FileMan Date
		Else { s type="%Library.FilemanTimeStamp" }		// FileMan.DateTime
	}
	Else { s type="%Library.FilemanDate" }
	QUIT
}
 
datype(fmtype) [] {
		#; Return IRIS numeric Data Type number Given FileMan DataType String
	s datype=""
	i fmtype?.1"."1.n.e s datype=100 			// fake datatype for child tables
	e  i fmtype="" 	// missing data type - not supported
	e  i fmtype["C",(fmtype[",")||(fmtype["D") s datype=5	// Computed Field --> Numeric
	e  i fmtype["C" s datype=8				// Computed Field --> Text
	e  i fmtype["V" s datype="8->"				// Variable pointer --> Text + comp flds
	e  i fmtype["D" s datype=5				// Date/Time --> Number
	e  i fmtype["F" s datype=8				// Free Text --> Text
	e  i fmtype["N" s datype=5				// Numeric --> Number
	e  i fmtype["P" s datype=10				// Pointer --> Designative Reference
	e  i fmtype["S" s datype=6				// Set --> Multiple Choice
	e  i fmtype["W" s datype=8				// Word-Processing --> Text
	e  s datype=8						// No DataType --> Text
		#; Any Other FileMan Data Types Not Supported
	QUIT datype
}
 
 
addfield(topfil,filen,fid) ; e.p. to link one fileman field to IRIS
	q  n SQLCODE,anydata,compil,err,flevl,nextid,nocon,ok
	d basic QUIT:'ok 0
	s irn=2 d onefield^%qadlfls i err!SQLCODE QUIT 0
	i +$g(nocon) QUIT 0 ; Field Not Converted
	d doit^%qadlnx i err!SQLCODE QUIT 0
	d addlist(filen)
	QUIT 1
 
 
lexan(gloref,subs,level) [] {
		#; Derive Subscript Levels From ^DIC(filen,0,"GL")
		#; INPUT - subs = string of subscript expressions
		#; OUTPUT - level array - list of subscripts
	k level s level=0
ploop	QUIT:subs=""  s subi="",(qp,lpp,rpp)=0,end=0
ploop1	QUIT:end  s x=$e(subs) i x="" s end=1 g addlev
	i ","")("'[x d concat g ploop1
	i x="""" s qp=qp+1 d  d concat g ploop1
	. i qp#2 f i=2:1:$f(subs,"""",2)-2 d
	.. i $e(subs,i)="(" s lpp=lpp-1
	.. i $e(subs,i)=")" s rpp=rpp-1
	i x="(" s lpp=lpp+1 d concat g ploop1
	i x=")" s rpp=rpp+1 d concat g ploop1
	i x="," i (qp#2)!(lpp'=rpp) d concat g ploop1
addlev	s level=level+1,level(level)=subi
	s subs=$e(subs,2,$l(subs))
	g ploop
concat	s subi=subi_x,subs=$e(subs,2,$l(subs)) QUIT
}
 
 
index(filen,tabname,err) [errmsg] {
	n errmsg
		#; CREATE CROSS REFERENCE INDEXES
	s err=0,fid=.0099 ; DPV1723 = New ixname,mapindex,skipit
iloop	s fid=$o(^DD(filen,fid)) q:+fid=0
	g iloop:'$d(^DD(filen,fid,1)) d doit d:err error
	g iloop
doit	// THE MEAT OF THE MATTER
		#; Check if field has a sub-file: if so, don't look for indices
		#; error trapping without exiting
	//s:$$$traperr zt=##vendor($zt),##vendor($zt)="err^%qadlnx"
	i $p($g(^DD(filen,fid,0)),"^",2)?.1"."1.n.e s err="" q
		#; Don't give any error message for Non-Mapping flds
	i '$d(^IRIS.TempFMI($j,"fid",filen,fid)) d  s err="" q
		#; check if it's a non-Mapping Field
	//. q:$$ddfield($p($g(^DD(filen,fid,0)),"^"),filen,,,fid)="*"
	//. s err=8 d error
	s ndx=0
nloop	s ndx=$o(^DD(filen,fid,1,ndx)) q:ndx=""  s j=0,xreftyp=$p(^DD(filen,fid,1,ndx,0),"^",3)
		#; For SOUNDEX, FUNCTION, BULLETIN, & TRIGGER indices, set up post-filing triggers
	i xreftyp'="","^SOUNDEX^FUNCTION^BULLETIN MESSAGE^TRIGGER^"[("^"_xreftyp_"^"),'%fmUseFMFiler d indx(filen,fid,ndx) g nloop
	i $p(^DD(filen,fid,1,ndx,0),"^")="" s err=3 d error s err="" g nloop ; invalid ndx spec.
	i $p(^DD(filen,fid,1,ndx,0),"^")'=filen,'%fmUseFMFiler d indx(filen,fid,ndx)  g nloop
	s ixname=$p(^DD(filen,fid,1,ndx,0),"^",2)
	s mapped=0
jloop	s j=$o(^DD(filen,fid,1,ndx,j))
		#; if not mapped map as trigger
	i j="" g:mapped nloop d:'%fmUseFMFiler indx(filen,fid,ndx)  g nloop
	g jloop:+j'=j s code=^(j)
	i xreftyp="KWIC" s code="S ^"_$p(code,"S ^",2) f k=1:1:$l(code,",") i $p(code,",",k)="I" s $p(code,",",k)="X"
	i xreftyp="MNEMONIC" s code=$p(code," "),code="S "_$p(code,"$D(",2),code=$e(code,1,$l(code)-1)_"="""""
	i xreftyp="MULTIPLE",code'["S ^" d:'%fmUseFMFiler indx(filen,fid,ndx) g nloop
	i xreftyp="MULTIPLE" d  d:skipit=2&&('%fmUseFMFiler) indx(filen,fid,ndx) g:skipit nloop g dmap
	. s skipit=0  ; DPV1723= ; Flag indicates index already created for this multiple cross reference on another field
	. s fldrefs=$p(^DD(filen,fid,1,ndx,0),"^",6)
	. i $d(mapindex(fldrefs)) s skipit=1 q  ; DPV1723 skip index if already defined from another field
	. s mapindex(fldrefs)=""                ; DPV1723 record the index to avoid duplicates
	. s (code,ocode)="S ^"_$p(code,"S ^",2)
	. f k=1:1:$l(code,",") q:$p(code,",",k)?1"Y"1n
	. s code=$p(code,",",1,k-1)_")="""""
	. d lexanC(code,.glo,.level)
	. s ocode=$p(ocode,",",k,99)
	. s l=1 
	.  ; If this field is the first field in the index, bump the fldrefs marker
	. s:code["$E(X"&($p(fldrefs,",",l+1)=fid) l=l+2
	. f k=1:1 q:$p(ocode,",",k)="DA)="""""  d  q:skipit  
	.. i $p(ocode,",",k)="$E(X" s level=level+1 s level(level)=$p(ocode,",",k,k+$l($p($p(ocode,"$E(X",2),")"),",")-1),k=k+$l($p($p(ocode,"$E(X",2),")"),",")-1,l=l+$l($p($p(ocode,"$E(X",2),")"),",")-1 q
	.. s fmfile=$p(fldrefs,",",l),l=l+1,fmfld=$p(fldrefs,",",l),l=l+1
	.. ; if fmfile or fmfld is NULL, there was most likely something in the index code other than the global set (DPV 11/15/2004)
	.. i fmfile=""||(fmfld="") s skipit=2 q
	.. ; if field has not yet been linked, define it as a trigger.  It must be index of a field in another file.
	.. i '$d(^IRIS.TempFMI($j,"fid",fmfile,fid)) s skipit=2 q  
	.. s level=level+1,level(level)="{"_$lg(^IRIS.TempFMI($j,"fid",fmfile,fid))_"}"
	. s level=level+1,level(level)="DA"
	. s j=99 ;To stop the code from looking at the rest of the mul code
		#; Not setting an index node in the following 2 conditions
	i $e(code,1,3)'="S ^" g jloop
	i $e(code,$l(code)-2,$l(code))'="=""""" g jloop
	d lexanC(code,.glo,.level)
	
dmap	
		#; create index map
	s gloref="^"_glo
	s fldnm=$lg(^IRIS.TempFMI($j,"fid",filen,fid),1)
	s mapname="index"_$g(ixname),mapname=$e(fldnm,1,26-$l(mapname))_mapname
	s ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname))=$lb(mapname,$p(gloref,"("),"N")
 
		#; create index map subs
	s fields(1)=fid
	d IndexMapSubs(filen,.fields,mapname,.level,.err) i err d delmap(filen,mapname) q:err'=8&(err'=3)  d error s err="" g jloop
	
		#; create index map rowidspecs
	// *** I don't think we need this!  d CreateMapRowid(filen,mapname,.level) i err d delmap(filen,mapname) q
 
		#;  If we can't generate MapRowIDSpecs for this map, it can't be indexed.  Use a trigger
	s physical=$lg(^IRIS.TempFM($j,filen),7)
	If physical'="" {
		s ok="" f i=1:1:$ll(physical) s ok=$$FindFieldInMap(filen,$$$UPPER(mapname),$lg(physical,i)) q:ok=""
		i ok="" {
				#;  Won't be able to generate good map rowid specs at class compilation time, so delete index map
				#;  and file through a trigger
			k ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname))
			d:'%fmUseFMFiler indx(filen,fid,ndx) g nloop
		}
	}
	
		#;  If the Map RowID specs don't match the table's based on fields, the index map is invalid
		#;  and the table won't compile.  Better handle the filing of this through a trigger.
	//i $p(^mdd(1,tabirn,14),$c(1),7)'="",$p(^mdd(1,tabirn,14),$c(1),7)'=$$mrilist^%qadcpt(mapid) d delmap(mapid) d indx(filen,fid,ndx) q:err  g nloop
	//s da1=tabirn,da12=mapid,js=jobfm d mapget^%qadlutl(mapid),gettab^%qadltb2,^%qadmap k da1,da12,js
		#; If map is invalid, delete it and try a trigger index
	//If $g(^mdd(12,mapid,22))'="" d delmap(mapid) d indx(filen,fid,ndx) q:err  g nloop
	s mapped=1
	g jloop
 
error 	If err=1 d log2("Cannot Create Index Map.","E")
	If err=2 d log2("Cannot Create Index Map Subscripts.","E")
	If err=3 d log2("Invalid FileMan Index. Omitting Index #"_ndx_" On Field #"_fid_".","W")
	If err=4 d log2("Cannot Create Index Map Row ID.","E")
	If err=5 d log2("Cannot Create Post-Insert Trigger For Non-Regular Index.","E")
	If err=6 d log2("Cannot Create Post-Update Trigger For Non-Regular Index.","E")
	If err=7 d log2("Cannot Create Post-Delete Trigger For Non-Regular Index.","E")
	If err=8 d log2("Cannot Create Indices For Omitted Field #"_fid_".","W")
	QUIT
}
 
 
index2(filen,tabname,err) [errmsg] {
	n errmsg
		#; CREATE NEW STYLE CROSS REFERENCE INDEXES
	s err=0,crid=""
iloop	s crid=$o(^DD("IX","B",filen,crid)) q:crid=""
	k d0 g iloop:'$d(^DD("IX",crid,0),d0)
	g iloop:($p(d0,"^",4)'="R")	// Not a regular index (#TODO, create a trigger if not %fmUseFMFiler???)
	g iloop:($p(d0,"^",9)'=filen)	// Root file not this file
	d doit d:err error
	g iloop
 
doit	// THE MEAT OF THE MATTER
	s j=0,ixname=$p(d0,"^",2),code=$g(^DD("IX",crid,1))
	i $e(code,1,3)'="S ^" q
	i $e(code,$l(code)-2,$l(code))'="=""""" q
	d lexanC(code,.glo,.level)
	
dmap	
		#; create index map
	s gloref="^"_glo
		#; Build fields() fields(ORDER_NUMBER)=FIELD_ID  ORDER_NUMBER cooresponds with X(ORDER_NUMBER)
	s allFields=1,crsub=0,fids=""
	f  { s crsub=$o(^DD("IX",crid,11.1,crsub)) q:'crsub  s data=$g(^DD("IX",crid,11.1,crsub,0)) if $p(data,"^",2)'="F" { s allFields=0 q  } s fields(+data)=$p(data,"^",4),fids=fids_","_$p(data,"^",4) }
	q:'allFields
	s mapname=$p(d0,"^",2)_"index"
	s ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname))=$lb(mapname,$p(gloref,"("),"N")
 
		#; create index map subs
	d IndexMapSubs(filen,.fields,mapname,.level,.err) i err d delmap(filen,mapname) q:err'=8&&(err'=3)&&(+err'=9)  d error s err="" q
	
		#; create index map rowidspecs
	#; *** I don't think we need this!  d CreateMapRowid(filen,mapname,.level) i err d delmap(filen,mapname) q
 
		#;  If we can't generate MapRowIDSpecs for this map, it can't be indexed.  Use a trigger
	s physical=$lg(^IRIS.TempFM($j,filen),7)
	If physical'="" {
		s ok="" f i=1:1:$ll(physical) s ok=$$FindFieldInMap(filen,$$$UPPER(mapname),$lg(physical,i)) q:ok=""
		i ok="" {
				#;  Won't be able to generate good map rowid specs at class compilation time, so delete index map
				#;  and file through a trigger
			k ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname))
			d:'%fmUseFMFiler indx(filen,fid,ndx) q
		}
	}
	
		#;  If the Map RowID specs don't match the table's based on fields, the index map is invalid
		#;  and the table won't compile.  Better handle the filing of this through a trigger.
	#; i $p(^mdd(1,tabirn,14),$c(1),7)'="",$p(^mdd(1,tabirn,14),$c(1),7)'=$$mrilist^%qadcpt(mapid) d delmap(mapid) d indx(filen,fid,ndx) q:err  g nloop
	#; s da1=tabirn,da12=mapid,js=jobfm d mapget^%qadlutl(mapid),gettab^%qadltb2,^%qadmap k da1,da12,js
		#; If map is invalid, delete it and try a trigger index
	#; If $g(^mdd(12,mapid,22))'="" d delmap(mapid) d indx(filen,fid,ndx) q:err  g nloop
	s mapped=1
	QUIT
 
error 	If err=1 d log2("Cannot Create Index Map.","E")
	If err=2 d log2("Cannot Create Index Map Subscripts.","E")
	If err=3 d log2("Invalid FileMan Index. Omitting Index #"_crid_" On Field(s) #"_$e(fids,2,*)_".","W")
	If err=4 d log2("Cannot Create Index Map Row ID.","E")
	If err=5 d log2("Cannot Create Post-Insert Trigger For Non-Regular Index.","E")
	If err=6 d log2("Cannot Create Post-Update Trigger For Non-Regular Index.","E")
	If err=7 d log2("Cannot Create Post-Delete Trigger For Non-Regular Index.","E")
	If err=8 d log2("Cannot Create Indices For Omitted Field(s) #"_$e(fids,2,*)_".","W")
	If +err=9 d log2("Cannot Create Indices For $E(field) expressions: "_$p(err,$c(1),2)_".","W")
	QUIT
}
 
 
FindFieldInMap(filen,MAPNAME,field) [] PRIVATE {
	s ilev="",val=""
	For  {
		s ilev=$o(^IRIS.TempFM($j,filen,"m",MAPNAME,"s",ilev),1,data) q:ilev=""
		If $lg(data)=field s val="{L"_ilev_"}" q
	}
	QUIT val
}
 
indx(filen,fid,indxnum) [] {
		#; ENTRY POINT TO CREATE FILING TRIGGERS FOR NON-"B" INDICES
	QUIT:%readonly
	s fldnm=$lg(^IRIS.TempFMI($j,"fid",filen,fid),1)
		#; AFTER INSERT Trigger
	s code1="n i,l,x s x={RowId},l=$l(x,""||"") f i=1:1:l-1 s @(""DA(""_(l-i)_"")"")=$p(x,""||"",i),DA=$p(x,""||"",l),X={"_$$quoter2(fldnm)_"}"
	s code2=$$codeopt(^DD(filen,fid,1,indxnum,1))
	s ^IRIS.TempFM($j,filen,"t","AfterInsert"_fldnm)=$lb("INSERT","AFTER",0,"AFTER INSERT Trigger to file non-""B"" index field: "_fldnm,$lb(code1,code2))
		#; AFTER DELETE Trigger
	s code1="n i,l,x s x={RowId},l=$l(x,""||"") f i=1:1:l-1 s @(""DA(""_(l-i)_"")"")=$p(x,""||"",i),DA=$p(x,""||"",l),X={"_$$quoter2(fldnm)_"}"
	s code2=$$codeopt(^DD(filen,fid,1,indxnum,2))
	s ^IRIS.TempFM($j,filen,"t","AfterDelete"_fldnm)=$lb("DELETE","AFTER",0,"AFTER DELETE Trigger to file non-""B"" index field: "_fldnm,$lb(code1,code2))
		#; AFTER UPDATE Trigger
	s code1="n i,l,x s x={RowId},l=$l(x,""||"") f i=1:1:l-1 s @(""DA(""_(l-i)_"")"")=$p(x,""||"",i),DA=$p(x,""||"",l),X={"_$$quoter2(fldnm)_"*O}"
	s code2=$$codeopt(^DD(filen,fid,1,indxnum,2))
			#; SECOND: SET UP NEW INDEX
	s code3="s X={"_$$quoter2(fldnm)_"*N}"
	s code4=$$codeopt(^DD(filen,fid,1,indxnum,1))
	s ^IRIS.TempFM($j,filen,"t","AfterUpdate"_fldnm)=$lb("UPDATE","AFTER",0,"AFTER UPDATE Trigger to file non-""B"" index field: "_fldnm,$lb(code1,code2,code3,code4))
	QUIT
}
 
 
lexanC(M,glo,level) [] {
		#; Derive Subscript Levels From M Executable Code
		#; returns glo (PBR)
	k level s level=0
	s glo=$p($p(M,"S ^",2),"(",1) ; global name
	s subs=$p($p(M,"(",2,999),")=",1)
ploop	q:subs=""  s subi="",(qp,lpp,rpp)=0,end=0
ploop1	q:end  s x=$e(subs) i x="" s end=1 g addlev
	i ","")("'[x d concat g ploop1
	i x="""" s qp=qp+1 d  d concat g ploop1
	. i qp#2 f i=2:1:$f(subs,"""",2)-2 d
	.. i $e(subs,i)="(" s lpp=lpp-1
	.. i $e(subs,i)=")" s rpp=rpp-1
	i x="(" s lpp=lpp+1 d concat g ploop1
	i x=")" s rpp=rpp+1 d concat g ploop1
	i x="," i (qp#2)!(lpp'=rpp) d concat g ploop1
addlev	s level=level+1,level(level)=subi
	s subs=$e(subs,2,$l(subs))
	g ploop
concat	s subi=subi_x,subs=$e(subs,2,$l(subs)) q
}
 
 
delmap(filen,mapname) [] { k ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname)) q  }
 
IndexMapSubs(filen,fields,mapname,level,err) [] {
		#; Create Index Map Subscripts
	s ilev=-1
	s tinfo=$g(^IRIS.TempFM($j,filen))
	If $lg(tinfo,7)="" { 
		s rowsubs=$lg(tinfo,9),maxsubs=1 
		s list(0)=rowsubs
	} 
	Else { 
		s rowsubs=$lg(tinfo,7),maxsubs=$ll(rowsubs)
		f ilev=0:1:maxsubs-1 s list(ilev)=$lg(rowsubs,maxsubs-ilev)
	}
	If rowsubs="" s err=2 q
	i $g(fields(1))="" s err=8 QUIT
	s fldnm=$lg(^IRIS.TempFMI($j,"fid",filen,fields(1)),1)
	i fldnm="" s err=8 QUIT
	s maxlen=$lg($g(^IRIS.TempFM($j,filen,"f",$$$UPPER(fldnm))),5)
	s nlev=0
levloop s nlev=$o(level(nlev)) q:nlev=""  
	s subi=level(nlev),fieldname="",Subscript="",invcond="",nextsub=""
	i subi["$E(X(" s subi=$$extchk2(subi,filen,.fields,"$E(X(",.err) q:err
	i subi["X(" s subi=$$trxtofname2(filen,subi,.fields,.err) q:err
	i subi["$E(X,",maxlen s subi=$$extchk(subi,maxlen)
	i subi["X" s subi=$$trxtofname(subi,fldnm)
	If subi=+subi||($e(subi)="""") {	// LITERAL SUBSCRIPT
		s Subscript=subi		// Subscript
	}
	ElseIf subi[("{"_$$quoter2(fldnm)_"}") {		// expression with '{fieldname}'
		s fieldname=fldnm
		s Subscript=subi
	}
	ElseIf subi?1"DA".e {  q:err  ; ALL OTHER VARIABLE SUBSCRIPTS
		If subi="DA" { s subi="DA(0)" }
		ElseIf $e(subi,1,3)="DA_" { s subi="DA(0)_"_$e(subi,4,$l(subi)) }
		s slev=$p($p(subi,"(",2),")",1)
		i '$d(list(slev)) s err=3 q
		s fieldname=list(slev)		// Fieldname
		s Subscript="{"_list(slev)_"}" 	// Subscript
		s invcond=$lb("{L"_nlev_"}'>0")	// SpecInvalCondOver (counter)
			#; DPV3486 - For index maps we won't specify NEXT code for the ID fields.  I don;t think there are any subscript values we need to
			#;           avoid in this case.  
		#; DPV3486=s nextsub=$lb("s:{L"_nlev_"}="""" {L"_nlev_"}=0 s {L"_nlev_"}=$o(^({L"_nlev_"})) s:'{L"_nlev_"} {L"_nlev_"}=""""",";PREV","s:{L"_nlev_"}="""" {L"_nlev_"}="":"" s {L"_nlev_"}=$o(^({L"_nlev_"}),-1) s:'{L"_nlev_"} {L"_nlev_"}=""""")
	}
	ElseIf +subi'=subi,'($l($p(subi," "),"""""")#2) {	// assume a variable
		s:$e(subi)'="$" subi="$g("_subi_")" 	// DPV 11/15/2002= Make sure it is not an expression before adding $Get
		s Subscript=subi			// Subscript
	}
	ElseIf subi?1"{"1.e1"}" { s Subscript=subi }
	ElseIf subi?1"$E({"1.e1"}".e { s Subscript=subi }
	//ElseIf $e(subi,1,3)="$E(" { b  s err=9_$c(1)_subi q  }	// Don't create index when subscript expression has $Extract
	Else { s err=3 q  }
	s ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"s",nlev)=$lb(fieldname,Subscript,invcond,nextsub)
	g levloop
}
 
 
extchk(x,len) [] {
		#; Convert every "$E(X,1,N)" where N > maxlen to "X"
	s inst=1,delim="$E(X,1"
	f  s p1=$p(x,delim,1,inst) q:p1=x  s p2=$p(x,delim,inst+1,*) d
	. i '($l(p1,"""")#2) s inst=inst+1 q  ; in quotes
	. i "),"'[$e(p2) s inst=inst+1 q  ; bad M
	. i $e(p2)=")" d  q
	. . i len>1 s inst=inst+1 ; bad length
	. . e  s x=p1_"X"_$p(p2,")",2,*)
	. i $e(p2)'="," s inst=inst+1 q  ; bad M
	. i +$e(p2,2,$l(p2))<len s inst=inst+1 q  ; bad length ; PRT013 correct length
	. i $e(p2,$l(+$e(p2,2,$l(p2)))+2)'=")" s inst=inst+1 q  ; bad M ; PRT012 06/03/94 fix bug
	. s x=p1_"X"_$p(p2,")",2,*)
	QUIT x
}
 
extchk2(x,filen,fields,delim,err) [] {
		#; Convert every "$E(X(n),1,N)" where N > maxlen to "X"
	s inst=1
	f  s p1=$p(x,delim,1,inst) q:p1=x  s p2=$p(x,delim,inst+1,*),fieldOrder=+p2,startExtract=$p(p2,",",2),p2=","_$p(p2,",",3,*) d  q:err
	. i startExtract'=1 s inst=inst+1 q   // Not $e(...,1,...)
	. i '($l(p1,"""")#2) s inst=inst+1 q  ; in quotes
	. i "),"'[$e(p2) s inst=inst+1 q  ; bad M
	. s fid=$g(fields(fieldOrder)) i fid="" s inst=inst+1 q
	. s fldnm=$lg(^IRIS.TempFMI($j,"fid",filen,fid),1)
	. i fldnm="" s err=8 QUIT
	. s len=$lg($g(^IRIS.TempFM($j,filen,"f",$$$UPPER(fldnm))),5)
	. i $e(p2)=")" d  q
	. . i len>1 s inst=inst+1 ; bad length
	. . e  s x=p1_"{"_fldnm_"}"_$p(p2,")",2,*)
	. i $e(p2)'="," s inst=inst+1 q  ; bad M
	. i +$e(p2,2,$l(p2))<len s inst=inst+1 q  ; bad length ; PRT013 correct length
	. i $e(p2,$l(+$e(p2,2,$l(p2)))+2)'=")" s inst=inst+1 q  ; bad M ; PRT012 06/03/94 fix bug
	. s x=p1_"{"_fldnm_"}"_$p(p2,")",2,*)
	QUIT x
}
 
trxtofname(x,fieldname) [] {
		#; translate string containing 'X' to '{fieldname}'
	s inst=1,%dpv=x
	f  s p1=$p(x,"X",1,inst) q:p1=x  s p2=$p(x,"X",inst+1,*) d
	. i '($l(p1,"""")#2) s inst=inst+1 q  ; in quotes
	. i '($l(p1,"{")#2) s inst=inst+1 q  ; in a {FieldName}
	. i p1'="",$e(p1,$l(p1))'?1p s inst=inst+1 q  ; X not a variable
	. i p2'="",$e(p2)'?1p s inst=inst+1 q  ; X not a variable
	. s x=p1_"{"_$$quoter2(fieldname)_"}"_p2
	QUIT x
}
 
trxtofname2(filen,x,fields,err) [] {
		#; translate string containing 'X(FIELD_ORDER)' to '{fieldname}'
	s inst=1
	f  s p1=$p(x,"X(",1,inst) q:p1=x  s p2=$p(x,"X(",inst+1,*),fieldOrder=+p2,p2=$p(p2,")",2,*) d
	. i '($l(p1,"""")#2) s inst=inst+1 q  ; in quotes
	. s fid=$g(fields(fieldOrder)) i fid="" s inst=inst+1 q
	. s fieldname=$lg(^IRIS.TempFMI($j,"fid",filen,fid),1) i fieldname="" s err=8 QUIT
	. i p1'="",$e(p1,$l(p1))'?1p s inst=inst+1 q  ; X not a variable
	. i p2'="",$e(p2)'?1p s inst=inst+1 q  ; X not a variable
	. s x=p1_"{"_$$quoter2(fieldname)_"}"_p2
	QUIT x
}
 
errtbl2 ; Table Of Error/Warning Messages
 ;;E;;"Cannot Create Index Map."
 ;;E;;"Cannot Create Index Map Subscripts."
 ;;W;;"Invalid FileMan Index. Omitting Index #"_ndx_" On Field #"_fid_"."
 ;;E;;"Cannot Create Index Map Row ID."
 ;;E;;"Cannot Create Post-Insert Trigger For Non-Regular Index."
 ;;E;;"Cannot Create Post-Update Trigger For Non-Regular Index."
 ;;E;;"Cannot Create Post-Delete Trigger For Non-Regular Index."
 ;;W;;"Cannot Create Indices For Omitted Field #"_fid_"."
 
 
ChildTable(partabname,parfil,fldfid,clevel,btabnm,topfile,wp) [] {
		#; Create Child Table From FileMan File
		#; Called as extrinsic function
		#; Input Parameters - partabname = name of parent table
		#;                    parfil = File # Of FileMan Parent File
		#;                    fldfid = fid of multi-answer field
		#;                    clevel = Child Level
		#;                    btabnm = optional var to pass back new child table name
		#; Returns          - 0 = success, >0 = error code
		#;                    btabnm = name of new table (passed by ref)
		#;
		#; Global variables used in pgm:
		#; filen = FileMan File# For Sub-Field/Multi-Line Field
		#; tabirn = row id of base table
		#; btabnm = base table name
		#; rowifn = ifn of row id field
		#; childifn = ifn of childsub field
		#; mapid  = row id of master map
		#; parprof = sub-field profile from parent table
		#; topfil = file # of top level file
		#; wp      = 1/0 if this is a word processing field child table
 
	s parprof=^DD(parfil,fldfid,0)
	s filen=+$p(parprof,"^",2)
	d log2("Analyzing Sub-File(s) #"_filen_"  Name: "_$$ddtable(filen),"M",clevel*5,1)
	s err=0
	d CreateChildTable(filen,parfil,partabname,parprof,wp,.btabnm,.err) i err g error
	d CreatePCRelationship(parfil,filen,partabname,btabnm,wp,.parrefname)
	s mapname=$$map(filen,btabnm,.gloref,topfile)
	d MapSubsChild(parfil,filen,btabnm,mapname,.gloref,parprof,.err) i err g error
		#;  If this is a word-processing field child table and we are usng the FileMan Filer,
		#;  Just set the IEN to the constant 1.  This is so the WP field counter is not bumped twice
		#;  upon insert, once by Cache' and once by FileMan.
		#;  It does mean the IEN and RowID value of this row are probably not correct until the Fileman
		#;  Filer is called in the BEFORE INSERT trigger.
	If wp,%fmUseFMFiler { s IENDefault=-999 }
	Else { s IENDefault=$$nextdef(filen,mapname,.err) }
	If err { d log2("Can't Generate Default Value For IEN field. No Inserts Allowed."_$s(SQLCODE:" - SQLCODE="_SQLCODE,1:""),"W") s err=0 }
	Else { s $li(^IRIS.TempFM($j,filen,"f","IEN"),17)=IENDefault }
	d fields(filen,btabnm,mapname,+clevel,topfile)
	d index(filen,btabnm,.err) i err QUIT 0
	d index2(filen,btabnm,.err) i err QUIT 0  	// new-style cross references
	If %fmUseFMFiler {
		If wp { d CreateFMFilingTriggers^%fm2cache2(filen,gloref,2,parrefname,parfil,fldfid) }
		Else  { d CreateFMFilingTriggers^%fm2cache2(filen,gloref,1,parrefname) }
		
	}
	d log2("Child Base Table '"_btabnm_"' queued for creation","M",clevel*5)
	s %qc=%qc+1
	QUIT 1 ; success
 
error 	If err=1 d log2("Field #"_fldfid_" Of File #"_parfil_" Points To Duplicate Sub-File. Field Omitted.","E")
	If err=3 d log2("Cannot Obtain A Unique Name For This File Manager File. File Omitted.","W")
	If err=7 d log2("Name Field Has Unsupported Data Type. Sub-File Omitted.","W")
	If err=17 d log2("Error creating Map Subscripts for child table for Field #"_fldfid_" Of File #"_parfil_".  No master map of parent table found.  Field Omitted.","E")
	If err=18 d log2("File starts with NON-Mapping Name. File Omitted.","W")
	QUIT 0
}
 
CreateChildTable(filen,parfil,ParentTableName,parprof,wp,btabnm,err) [] {
		#; create child base table
	i $d(^IRIS.TempFMI($j,"fm",filen)) s err=1 QUIT
	s btabnm=$$ddtable2($g(%fmnms)_$p(parprof,"^"),,,filen,1) i "*"[btabnm s err=$s(btabnm="":3,1:18) QUIT
	s datype=$$datype($p($g(^DD(filen,.01,0)),"^",2))
	i datype="" s err=7 QUIT  ; unsupp. datatype for 'Name' field
	i 'wp { s desc="Generated class for FileMan Sub-File Number: '"_filen_"'  Sub-File Name: '"_$$ddtable(filen)_"'   Class generated by %fm2cache version "_$$$FM2CacheVersion }
	i wp  { s desc="Generated class for FileMan Word Processing Field: '"_filen_"'  Name: '"_$$ddtable(filen)_"'   Class generated by %fm2cache version "_$$$FM2CacheVersion }
	s parphys=$lg(^IRIS.TempFM($j,parfil),7)
	s ^IRIS.TempFM($j,filen)=$lb(btabnm,desc,%fmOwner,,"Y","RowId",parphys_$lb(btabnm_".IEN"),$lb(btabnm_"."_ParentTableName,btabnm_".IEN"),"RowId")
	s ^IRIS.TempFMI($j,"rv",$$$UPPER(btabnm))=filen
	s ^IRIS.TempFMI($j,"fm",filen)=$lb(tabname,desc)
	QUIT
}
 
 
CreatePCRelationship(pfilen,cfilen,ParentTableName,ChildTableName,wp,ref2parent) [] { 
		#; Create Relationships for Parent/Child
		#; This is the relationship in the parent class
	s ref2child=$$ddfield(ChildTableName,pfilen)
	s ref2parent=$$ddfield(ParentTableName,cfilen)
	s ^IRIS.TempFM($j,pfilen,"f",$$$UPPER(ref2child))=$lb(ref2child,"Relationship for "_$s(wp:"Word-Processing Field",1:"Sub-File")_" child",ChildTableName,0,,,,,,,1,"children",ref2parent,,,1)
		#; This is the relationship in the child class (Parent reference field)
	s ^IRIS.TempFM($j,cfilen,"f",$$$UPPER(ref2parent))=$lb(ref2parent,"Relationship to parent",ParentTableName,1,,,,,,,1,"parent",ref2child,,,1)
	s ^IRIS.TempFM($j,cfilen,"f","IEN")=$lb("IEN","Child Counter Field","%Library.String",1,,,,,,,,,,$lb($lb("COLLATION","EXACT"),$lb("TRUNCATE",0)),,,)
		#; Create child's IENS field, computed off of RowId
	s SQLComputedCode=$lb("Set {*}="""" New i For i=$l({RowId},""||""):-1:1 s {*}={*}_$p({RowId},""||"",i)_"",""")
	s TypeParam=$lb($lb("COLLATION","EXACT"))
	s ^IRIS.TempFM($j,cfilen,"f","IENS")=$lb("IENS","IENS Field","%Library.String",1,,"Exact",1,1,SQLComputedCode,,,,,TypeParam)
		#; Create child's IDKey index
	s ^IRIS.TempFM($j,cfilen,"i","IDKEYINDEX")=$lb("IDKeyIndex","idkey",$lb("IEN"))
	QUIT
}
 
 
errtbl3 ; Table Of Error/Warning Messages
 ;;W;;"Field #"_fldfid_" Of File #"_parfil_" Points To Duplicate Sub-File. Field Omitted."
 ;;W;;"No Name Exists For This File Manager File. File Omitted."
 ;;W;;"Cannot Obtain A Unique Name For This File Manager File. File Omitted."
 ;;E;;"Cannot Create Base Table."
 ;;E;;"Cannot Create Master Map."
 ;;E;;"Cannot Create Map Subscripts."
 ;;W;;"Name Field Has Unsupported Data Type. Sub-File Omitted."
 ;;W;;"Field Has Unsupported Data Type. Omitted."
 ;;E;;"Cannot Create Base Table Fields."
 ;;E;;"Cannot Identify Parent Relation."
 ;;E;;"Cannot Add Child Table Pointer To Parent Relation."
 ;;E;;"Cannot Create Child Subscript Field."
 ;;E;;"Cannot Create Child Table Master Map Subscripts."
 ;;W;;"Could Not Create Lower Level Child Table."
 ;;E;;"Cannot Create Designated Table."
 ;;W;;"Cannot Generate Default Value For New Row Id."
 ;;E;;"Could Not Generate Filing Code For Fixed Length Fields."
 ;;W;;"File starts with NON-Mapping Name. File Omitted." 
 
 
References() [] {
	i '$d(^IRIS.TempFMI($j,"desref")) QUIT
	d log2("Converting pointer fields to reference properties","M","",2)
	s tabname=""
	For  {
		s tabname=$o(^IRIS.TempFMI($j,"desref",tabname)) q:tabname=""
		s fldname=""
		For  {
			s fldname=$o(^IRIS.TempFMI($j,"desref",tabname,fldname),1,dfil) q:fldname=""
			s fk=$lg(dfil,2),dfil=$lg(dfil)
			s dtabname=$lg($g(^IRIS.TempFMI($j,"fm",dfil)))
			s thisfile=^IRIS.TempFMI($j,"rv",$$$UPPER(tabname))
			If dtabname="" { 
				s ok=$$CreateRefTable(dfil,fldname,.dtabname)	// create designated table
				i 'ok d MakeString(thisfile,fldname,"%Library.String") k ^IRIS.TempFMI($j,"desref",tabname,fldname) continue
			}
			d MakeReference(thisfile,fldname,dtabname)			// make text field a reference
			if fk=1 s ^IRIS.TempFM($j,thisfile,"fk","FKey_"_fldname)=$lb(dtabname,fldname,"Foriegn Key constraint for Variable Pointer reference field "_fldname)	// DPV3009, Variable pointer reference fields create foreign key constraints
			if fk=2 s ^IRIS.TempFM($j,thisfile,"fk","FKey_"_fldname)=$lb(dtabname,fldname,"Foriegn Key constraint for Pointer reference field "_fldname_"->"_dtabname)		// DPV3017, Pointer reference fields create foreign key constraints
			k ^IRIS.TempFMI($j,"desref",tabname,fldname)
		}
		s tabname=""
	}
	d log2("References Converted","M","",1)
	QUIT
}
 
 
CreateRefTable(dfil,fldname,tabname) [] {
		#; CREATE THE DESIGNATED TABLE
	i '$d(^DIC(dfil)) g CreateRefTableErr
	s topfil=dfil,ok='$$CreateTable(dfil,1,topfil)
	g:'ok CreateRefTableErr
	s tabname=$lg(^IRIS.TempFM($j,dfil))
	QUIT 1
 
CreateRefTableErr
	s ok=0,x="WARNING: Couldn't Create Designated Table For Field #"_fldname_" (File #"_dfil_"). Mapped As Text."
	d log2(x,"W")
	s dirn=0
	QUIT 0
}
 
 
MakeReference(filen,fldname,type) [] {
		#; RE-DO THE TEXT FIELD AS A DES REF FIELD
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fldname)),3)=type
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fldname)),16)=1	// IsAReference
	QUIT
}
 
 
MakeString(filen,fldname,type) [] {
		#; RE-DO THE REFERENCE FIELD AS A String
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fldname)),3)=type
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fldname)),16)=0	// IsAReference
	QUIT
}
 
 
delete(filenum) ; DELETE BASETABLE (& DESCENDENTS) ASSOCIATED WITH FILE
	n ok s ok='$$^%qadldel(filenum) 
	QUIT ok
 
delfld(filen,fid) ; Delete a field from IRIS that is linked to fileman
	n anydata,compil,ifn,nextid,ok
	s ifn=$p($g(^mdd(1,"fmfld",filen,fid)),$c(1),2)
	QUIT:'ifn 0
	s ok=$$field^%qadlfdl(ifn,"","DX")
	i ok d addlist(filen)
	QUIT ok
 
#IF 0 
update(filen,updatex,topfil) ; update a file
	n SQLCODE,anydata,compil,da12,err,fid,flevl,ifn,irn,mapid,nextid,nocon
	n ok,okany,oper,stuff,tabirn
	d basic q:'ok 0
		#; rename table if has to be renamed and set number of rows
	d rename^%qadltb(filen,tabirn),setrow^%qcrsapi(tabirn_"|500000")
		#; First delete deleted subfiles
	f ok=1:1 s fid=$p($g(^mdd(1,tabirn,21)),"_",ok) q:'fid  d
	. s fid=$p($g(^mdd(1,fid,34)),$c(1))
	. i fid,'$d(^DD(fid)) s fid=$$delete(fid) ; delete deleted sub-files
	s fid=.000099,okany=0
	f  s fid=$o(^DD(filen,fid)) q:+fid=0  d
	. ; delete deleted fields
	. f  s ifn=$o(^mdd(1,"fmfld",filen,fid),-1) q:'ifn  q:$d(^DD(filen,ifn,0))  s ok=$$delfld(filen,ifn)
	. s stuff=$p($g(^DD(filen,fid,0)),"^",2),oper="update"
	. i stuff?.n.1"."1.n.e s ok=$$updsubf(filen,fid,updatex,topfil,+stuff) i 1
	. e  i '$d(^mdd(1,"fmfld",filen,fid)) s ok=$$addfield(topfil,filen,fid),oper="insert" i 1
	. e  s ok=$$updfld(filen,fid,updatex)
	. i ok s okany=okany+1
	. e  d log2("Couldn't "_oper_" File # "_filen_" field "_fid,"E")
	i okany d addlist(filen)
	q okany
 
 
updfld(filen,fid,updatex) ; e.p. to update one field
	n SQLCODE,anydata,compil,da12,err,flevl,irn,mapid,nextid,nocon
	n ok,okany,oper,stuff,tabirn
	d basic q:'ok 0
	i '$d(^mdd(1,"fmfld",filen,fid)) q 0 ; does not exist
	s irn=2,ifn=$p($g(^(fid)),$c(1),2),ok=0
	q:'ifn 0
	s ok=$$field^%qadlfdl(ifn,"","U"_$e("X",updatex)) ; cleanup
	q:'ok 0 s ok=$$updatef^%qadlflu(filen,fid,updatex) q:'ok 0
	i updatex d doit^%qadlnx s ok='(err!SQLCODE)
	i ok d addlist(filen)
	q ok
 
 
updsubf(filen,fid,updatex,topfil,stuff) ; update sub-files
	n ok s stuff=+$g(stuff),fid=+fid
	i $$wordproc^%qadlutl(stuff) s fid=fid_"W" d  g:fid["W" updsubfq
	. i $d(^mdd(1,"fmfld",filen,+fid)) d  q
	. . i %fmWPFIsListCol s ok=$$updfld(filen,+fid,updatex) q
	. . s ok=$$delfld(filen,+fid) i 'ok d log("delete",nextid) q
	. . s ok=$$addfield(topfil,filen,+fid) d:'ok log("insert",nextid)
	. i '%fmWPFIsListCol s fid=+fid q
	. i $d(^IRIS.TempFM($j,stuff)) s ok=$$delete(stuff) i 'ok d log("delete",nextid) q
	. s ok=$$addfield(topfil,filen,+fid) i 'ok d log("insert",nextid)
	i '$d(^IRIS.TempFM($j,stuff)) s ok=$$addfield(topfil,filen,fid) g updsubfq
		#;  update recursively child tables 
	s ok=$$update(stuff,updatex,topfil) 
	d:'ok log("update",nextid)
updsubfq q ok
 
 
updatex(filen) ; update indices for a file
	n SQLCODE,anydata,compil,da12,err,fid,flevl,irn,mapid,nextid,nocon
	n ok,okany,oper,stuff,tabirn
	d basic q:'ok 0
	s fid=.000099,okany=0
	f  s fid=$o(^DD(filen,fid)) q:+fid=0  d 
	. s stuff=$p(^DD(filen,fid,0),"^",2)
		#; no inserting only updating indices
		#;  update indices recursively child tables
	. i stuff?.1"."1.n.e  q:'$d(^IRIS.TempFM($j,+stuff))  s ok=$$updatex(+stuff)
	. e  q:'$d(^mdd(1,"fmfld",filen,fid))  s ok=$$updfldx(filen,fid)
	. i ok s okany=okany+1
	. e  d log2("Couldn't update indices File # "_filen_" field "_fid,"E")
	i okany d addlist(filen)
	q okany
 
 
updfldx(filen,fid) ; update indices for a field
	n SQLCODE,anydata,compil,da12,err,flevl,irn,mapid,nextid,nocon
	n ok,okany,oper,stuff,tabirn
	d basic q:'ok 0
	i '$d(^mdd(1,"fmfld",filen,fid)) q 0 ; does not exist
	s irn=2,ifn=$p($g(^(fid)),$c(1),2),ok=0
	q:'ifn 0
	s ok=$$field^%qadlfdl(ifn,"","X") ; cleanup
	q:'ok 0 d doit^%qadlnx s ok='(err!SQLCODE)
	i ok d addlist(filen)
	q ok
 
#ENDIF 
basic ; e.p. to check and set basic info for insert, update and updatex
		; *** fix
	i '$d(^IRIS.TempFM($j,stuff)) s ok=0 q  ; table not linked
	s flevl=1,err="",SQLCODE="",ok=1
	QUIT
 
 
addlist(filen) ; add filen to list of irns to be recompiled
	n x,y
	s x=$p(^IRIS.TempFM($j,stuff),$c(1),1),y=$p(^mdd(1,x,1),$c(1),1)
	QUIT
 
wordproc(filen=0) [] {
		#; Ext func to return 1 if filen is word-proc sub-file.  return 0 otherwise
	QUIT $p($g(^DD(filen,.01,0)),"^",2)["W"
}
 
 
codeopt(string) [] {
		#; OPTIMIZE FILE MANAGER EXECUTABLE CODE
		#; (INTERFACE COMPILE-TIME SUB-ROUTINE)
		#; This subroutine determines whether to treat executable code
		#; as a program line or as an executable string.  Any code with
		#; QUITS must be converted to Xecute syntax with all quotes
		#; converted to double quotes.
		#;
	s us=$$$ALPHAUP(string)
	i '((us[" Q")||(us["Q:")||(us[" QUIT")||(us["QUIT:")||(us="Q")) QUIT string
		#; string probably contains a quit.  Find where we think it is
	s qpos=$f(us," Q") i qpos="" s qpos=$f(us,"Q:") i qpos="" s qpos=$f(us," QUIT") i qpos="" s qpos=$f(us,"QUIT:") i qpos="" s qpos=1
		#; find where we think there might be a for loop
	s fpos=$f(us," F ") i fpos="" s fpos=$f(us," FOR ") i fpos="" s fpos=$l(string)
		#; If the quit is in the for loop, no need to execute code.
	i fpos<qpos QUIT string
	s newcode="x """_$$addquote(string)_""""
	QUIT newcode
}
 
 
addquote(text) [] {
		#; Double The Quotes In A String
	 s newtext="" f i=1:1:$l(text) { s newtext=newtext_$e(text,i) i $e(text,i)="""" s newtext=newtext_"""" } QUIT newtext
}
 
 
err	d err1 q 0
errq	d err1 g userifct
err1 	s $zt=""
	i +$g(err)=0||($ze'="") d log2("Program Error: "_$ze,"E","",3) d ^%ET s $ze=""
	QUIT
 
error 	s x=$t(errtbl+err),errtyp=$p(x,";;",2),@("errmsg="_$p(x,";;",3))
	d log2(errmsg_$s(SQLCODE:" - SQLCODE="_SQLCODE,1:""),errtyp)
	QUIT err  ; no need to force another error
 
	#; DOCUMENTATION
	#; initialize fileman preferences
	#; initialize name mapping variables
	#; all variables that deal with name mapping will have %fmnm prefix
	#; %fmnm  = 1 if name mapping enabled 0 otherwise
	#; %fmnms = "SUB_" if name mapping is disabled, else what was defined
	#; %fmnmd = 1 if duplicate words should be eliminated 0 otherwise
	#; %fmnme = 1 if eliminating fields/files starting with ... (PRT005)
	#; %fmWPFIsListCol = (Word-Proc as Multi-line (Y or N))
	#; %fmsecs = 1 if they Allow seconds when converting date-time fields
	#; %fmAppendFileNoToName = 1 means append the FileMan file no. to every table name
	#;
initvars // parameter now s %fmWPFIsListCol=0	//($p($g(^%qSQLKeys("fileman","pref")),$c(1))="Y")
	s %fmnm=0	//($g(^%qSQLKeys("fileman","name"))="Y")
	s %fmnms=$s('%fmnm:"SUB_",1:$p($g(^%qSQLKeys("fileman","name","data")),$c(1)))
	s %fmnmd=$s('%fmnm:0,1:$p($g(^%qSQLKeys("fileman","name","data")),$c(1),2)="Y")
		#; PRT028 04/03/95) Treat all fileman dates as date-times and use secs
	s %fmsecs=0	//($p($g(^%qSQLKeys("fileman","pref")),$c(1),2)="Y")
		#; PRT029 (09/14/95) All other flags will be in %fmpref
	s %fmpref=""	//$p($g(^%qSQLKeys("fileman","pref")),$c(1),3,999)
	s:$p(%fmpref,$c(1),3)="" $p(%fmpref,$c(1),3)="_"
	s:$p(%fmpref,$c(1),4)="" $p(%fmpref,$c(1),4)="."
		#; do not map fields starting with ...
	s %fmnme=0	//+$g(^%qSQLKeys("fileman","name","data","nomap",0))
	i %fmnme n i,x f i=1:1:%fmnme s x=^(i) d  q:%fmnme'[$c(1)
	. ; take out pieces if did not fit in one string
	. i $l(x)+$l(%fmnme)+1>250 s %fmnme=+%fmnme q
	. s %fmnme=%fmnme_$c(1)_x
	QUIT
 
		#; tab = tab stop  nl = Number of new lines by default 1
log2(msg,typ,tab,nl) ; Create Error Log Entries and display
	n ctr,x s tab=+$g(tab),nl=+$g(nl) s:'nl nl=1 s $p(x,"!",nl+1)=""
	s ctr=$g(^%QCacheSQLFMLog(+$h,$namespace))+1,^($namespace)=ctr
	s ^($namespace,ctr)=$p($h,",",2)_"^"_$g(filen)_"^"_typ_"^"_$g(SQLCODE)_"^"_msg
	i $g(%msg)'="" s ^(ctr,1)=%msg
logwrite ;
	i typ'="M" {
		i typ["E",$tr(msg,"ero ","ERO")'["ERROR:" s msg="ERROR: "_msg
		i typ["W",$tr(msg,"warnig ","WARNIG")'["WARNING:" s msg="WARNING: "_msg
	}
	w @x,?tab,msg
	QUIT
 
log(oper,nextid) ; update fileman log with approppriate message
	n data,x s data=$g(^IRIS.TempFMI($j,"fileman-update",nextid,1))
	s data="" i data'="" s data=$$setext(data) i 1
	e  s data=$p($g(^IRIS.TempFMI($j,"fileman-update",nextid)),$c(1),1)
	e  s x=$$ddtable(data),data=$s(x'="":x,1:data)
	d log2("Couldn't "_oper_" "_data,"E")
	QUIT
	
 
#IF 0	;
ConvertCode(ns,code,loc) [] PUBLIC {
		#; Converts the internal code to external representation
	i code["$$dateext" s code=$$strrep(code,"$$dateext^%qarzdt($h)","$zd($h)")
	f iii=1:1 d  q:b=""
	. s a=$p(code,"{",1,iii),b=$p(code,"{",iii+1,999) q:b=""
	. s quote=($l(a,"""")#2) 
	. i 'quote q
	. i $d(loc),"0123469"[loc,$p(b,"}")?1"S"1.n!($p(b,"}")?1"L"1.n) s code=a_"{L"_$e($p(b,"}"),2,$l($p(b,"}")))_"}"_$p(b,"}",2,999) q
	. s ifn="" d CCint1
	. q:fld=""!(ifn="")
	. s irn=$p(^|ns|mdd(1,"ifn",ifn),$c(1),2)
	. i mltln="" s code=a_"{"_fld_"}"_b q         ; Non-multiline reference
	. i mltln="()" d  q
	.. i $$$UPPER($s(($l(a)-3)<1:" ",1:"")_$e(a,$l(a)-2,$l(a)))=" K " s code=a_"{"_fld_"}"_b q  ; Killing the # of lines - Kill the field value
	.. i $$$UPPER($s(($l(a)-6)<1:" ",1:"")_$e(a,$l(a)-5,$l(a)))=" KILL " s code=a_"{"_fld_"}"_b q  ; Killing the # of lines - Kill the field value
	.. i $$$UPPER($s(($l(a)-3)<1:" ",1:"")_$e(a,$l(a)-2,$l(a)))=" S " s code=a_"%mmmnoop"_b q  ; Setting the # of lines - Kill the field value
	.. i $$$UPPER($s(($l(a)-5)<1:" ",1:"")_$e(a,$l(a)-4,$l(a)))=" SET " s code=a_"%mmmnoop"_b q  ; Setting the # of lines - Kill the field value
	.. i $p($g(^|ns|mdd(1,irn,2,ifn,3)),$c(1),9)=1 s code=a_"$l({"_fld_"},"_$p($g(^|ns|mdd(1,irn,2,ifn,3)),$c(1),10)_")"_b q  ; Multiline number of elements, delimited
	.. s code=a_"$ll({"_fld_"})"_b q  ; Multiline number of elements, list
	. i $p($g(^|ns|mdd(1,irn,2,ifn,3)),$c(1),9)=1 s code=a_"$p({"_fld_"},"_$p($g(^|ns|mdd(1,irn,2,ifn,3)),$c(1),10)_","_$e(mltln,2,$l(mltln)-1)_")"_b q  ; An element of a multiline field, delimited
	. s code=a_"$li({"_fld_"},"_$e(mltln,2,$l(mltln)-1)_")"_b  ; An element of a multiline field, list
	QUIT
 
CCint1	s fld=$p(b,"}"),flag="",b=$p(b,"}",2,999),mltln=""
	s x=$l(a),x=$e(a,x-2,x) i x="var" q
	i fld["%" q
	i fld["*" s flag="*"_$p(fld,"*",2),fld=$p(fld,"*") q:fld=""
	i fld["(" s mltln="("_$p(fld,"(",2,999),fld=$p(fld,"(")
	QUIT:fld=""
	s x=$g(^|ns|mdd(1,"ifn",fld)),ifn=fld,fld=$p(x,$c(1),1)
	s:$e(fld)="." fld=$e(fld,2,$l(fld))
CCint2	s fld=fld_flag QUIT
}
 
ConvertCode2(ns,code) [] PUBLIC { d ConvertCode(ns,.code) QUIT code }
#ENDIF	;
 
