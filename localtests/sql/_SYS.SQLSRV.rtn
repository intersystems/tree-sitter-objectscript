	// FetchRows is called at run time from %ResultSet.Static.%OnNew()
GenerateFetchRows(pClassName,pColumns,pStream,&sequence) PUBLIC {
	set method="FetchRows"
	set code=0
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHplaceafter,"%Open")
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHprocedureblock,1)
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHformalspec,"s:%Integer")
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHreturntype,"%Integer")
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHpubliclist,"SQLCODE")
	set code=0
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"new SQLCODE set r=0"_$s($g(%qinfo("fastFetch")):",%qQueryFetch=0",1:""))
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"for  {")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"&sql(FETCH C) quit:SQLCODE")
