	// Called from SetAutoParallelThreshold^%apiSQL
	// Code is located here so we can escalate privs and not receive a <PROTECT> error if user does not have write permission on the ^%SYS global
SetAutoParallelThreshold(threshold=3200,&oldval) [SQLCODE] public {
	try {
		if '$SYSTEM.Security.Check($$$AdminManageResourceName,$$$PermUseName) {
			set SQLCODE=-99,%msg=$$$FormatText($$$Text("User '%1' is not privileged to change SQL AUTO_PARALLEL_THRESHOLD setting","%SYS.SQLSRV"),$username)
			do Audit99^%SYS.SQLSEC(%msg)
			RETURN $$$ERROR($$$SQLPrivilege2,SQLCODE,%msg)
		}
		set sc=$$$OK
		set callRoutine=$zu(96,9),callDatabase=$zu(96,10)
		if callDatabase=$zu(12,$p($g(^%SYS("DBRefByName","IRISLIB")),"^",3)),(callRoutine="%apiSQL") {
			$$$AddAllRoleTemporaryInTry
		}
		set oldval=$$$GetAutoParallelThreshold
		RETURN $$$SetAutoParallelThreshold(threshold)
	} catch tException {
		set SQLCODE=-400,%msg=$$$FormatText($$$Text("Error setting SQL option AUTO_PARALLEL_THRESHOLD : '%1'","%SYS.SQLSRV"),$ze)
		set sc=tException.AsStatus()
 	}
	RETURN sc
}
.
	// Called from SetDefaultSchema^%apiSQL
	// Code is located here so we can escalate privs and not receive a <PROTECT> error if user does not have write permission on the ^%SYS global
SetDefaultSchema(schema,&oldval,nameSpace=0) [SQLCODE] public {
	try {
		if '$SYSTEM.Security.Check($$$AdminManageResourceName,$$$PermUseName) {
			set SQLCODE=-99,%msg=$$$FormatText($$$Text("User '%1' is not privileged to change SQL DEFAULT_SCHEMA setting","%SYS.SQLSRV"),$username)
			do Audit99^%SYS.SQLSEC(%msg)
			RETURN $$$ERROR($$$SQLPrivilege2,SQLCODE,%msg)
		}
		set sc=$$$OK
		set callRoutine=$zu(96,9),callDatabase=$zu(96,10)
		if callDatabase=$zu(12,$p($g(^%SYS("DBRefByName","IRISLIB")),"^",3)),(callRoutine="%apiSQL") {
			$$$AddAllRoleTemporaryInTry
		}
		$$$SQLCompileUpdateContext
		if 'nameSpace {	// Set system-wide default schema
			set oldval=$$$GetDefaultSchema
			set:$g(schema)="" schema="SQLUser"
			RETURN $$$SetDefaultSchema(schema)
		}
			#; Set default schema only for the current namespace
		set oldval=$g(^%SYS("sql","sys","default schema",$namespace))
		set:oldval="" oldval=$$$GetDefaultSchema
		if $g(schema)="" { kill ^%SYS("sql","sys","default schema",$namespace) RETURN $$$OK }
		set ^%SYS("sql","sys","default schema",$namespace)=schema
		RETURN $$$OK
	} catch tException {
		set SQLCODE=-400,%msg=$$$FormatText($$$Text("Error setting SQL option DEFAULT_SCHEMA : '%1'","%SYS.SQLSRV"),$ze)
		set sc=tException.AsStatus()
 	}
	RETURN sc
}
