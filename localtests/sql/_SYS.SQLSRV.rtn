		if callDatabase=$zu(12,$p($g(^%SYS("DBRefByName","IRISLIB")),"^",3)),(callRoutine="%apiSQL") {
			$$$AddAllRoleTemporaryInTry
		} 
		Set oldval=$$$GetLockThreshold
		RETURN $$$SetLockThreshold(+$g(%val,$$$DefaultLockThreshold))
	} catch tException {
		set SQLCODE=-400,%msg=$$$FormatText($$$Text("Error setting SQL option LOCK_ESCALATION_THRESHOLD: '%1'","%SYS.SQLSRV"),$ze)
		set sc=tException.AsStatus()
 	}
 	RETURN sc
}
