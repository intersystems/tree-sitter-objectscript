	// Update a SQL Statement Index entry.  Items that can be updated are:
	//   - Record or clear an error string for the frozen plan of this indexed statement
	//   - Update the child entry if this hash belongs to a parent statement
	//   - Record or clear the SQLStatementID for this indexed statement
	//
	// Parameters:
	// - pHash :: passed by value, input
	//     Hash IDKEY for the SQL Statement
	// - pError :: passed by value, input
	//     An error text string to be reported in the "err" node for this statement
	//       if pError="", clear the errors in the "err" node
	//       if '$d(pError), no action taken
	// - pErrorType :: passed by value, input
	//     Error flag:
	//       0 means a regular error.  User must clear the error state to use this plan again
	//       1 means soft error.  Next compile will attempt to clear the error state and use the plan.
	//         Soft error is currently used for indices used by plans that are currently in MapSelectability=0
	// - pChildHash :: passed by value, input
	//     A string that is the hash of the child statement to record in the parent statement
	// - pRoutine :: passed by value, input  [Used only if pChildHash'=""]
	//     is the name of the routine or class the SQL is in.  
	//     A value of "%Freeze%Plan" means this is being called from the SMP UI to freeze a plan and we do not need to record the location.
	// - pCodeContainer :: passed by value, input  [Used only if pChildHash'=""]
	//     RTN for Routine, CLS for Class
	// - pSQLStatementID :: passed by value, input
	//     A SQLStatementID to be recorded in the 6th $LIST(...) piece of the following global reference: ^rINDEXSQL("sqlidx",1,hash,0)
	//       if pSQLStatementID="", clear this value by setting it to the empty string ("")
	//       if '$d(pSQLStatementID), no action taken
	//
	// Return value:
	//   Returns 1 if ok, 0 if error.  If err, SQLCODE and %msg are set.
	//
	// Called from:
	//	- %CSP.UI.Portal.Dialog.SQLStatementDetails.ClearPlanError (Do UpdateSQLIndex^%SYS.SQLSRV(hash,"")) to clear the error
	//	- fplanerr^%qaqplansave (do UpdateSQLIndex^%SYS.SQLSRV(hkey,msg,soft)) to set the error
	//	- GetStatementPlan^%qaqqt ('$$UpdateSQLIndex^%SYS.SQLSRV(tHash,...)) to set or clear the error
	//	- AddSQLStatementID^%SYS.SQLSRV ($$UpdateSQLIndex(hash,,,,,,,SQLStatementID)) to reset the statement ID value
	//	- SaveSQLIndex^%SYS.SQLSRV ('$$UpdateSQLIndex(pParentHash,,,pHash,pRoutine,pCodeContainer)) to record the child statement
UpdateSQLIndex(pHash,pError,pErrorType=0,pChildHash="",pRoutine="",pCodeContainer="",childtype="child",pSQLStatementID) [SQLCODE] PUBLIC {
	try {
		set return=1
		try {
			$$$lockexclusive($$$SQLIndex(1,pHash),$s($zu(115,4)<20:20,1:$zu(115,4)),gotlock)
		} catch {
			if $ze["<PROTECT" { set gotlock=0 quit }
			throw
		}
		if 'gotlock {
			set SQLCODE=-114,%msg=$$$FormatText($$$Text("Unable to acquire exclusive lock to update SQL Statement Index entry with ID '%1' System:Instance: %2, Namespace: %3, $Job: %4.","%SQL.Server"),pHash,$system,$namespace,$job),return=0
			quit
		}
		if '$d($$$SQLIndex(1,pHash)),pChildHash="" {	// index for this hash does not exist
			set return=0,SQLCODE=100,%msg=$$$FormatText($$$Text("SQL Statement index for hash '%1' does not exist. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),pHash,$system,$namespace,$job)
		}
		else {				// update log entry
			if $d(pError) {
				if pError="" { kill $$$SQLIndex(1,pHash,"err") }
				else         { set $$$SQLIndex(1,pHash,"err")=$s(pErrorType:"[Soft Error] ",1:"")_pError }
			}
				// Note, since the child statement is a recursive compile, it is actually stored before the parent (for the first one).
				// Go ahead and create this child entry here, the parent entry will folow shortly.
			if pChildHash'="" {
				set runtimelocation=pRoutine
				if pCodeContainer="CLS",$$$CACHEDSTATEMENT(pRoutine),$p(pRoutine,".",1,*-1)'="",$data($$$CQ("QueryRoutine",$p(pRoutine,".",1,*-1)),cachedqueryinfo),$lg(cachedqueryinfo)=$$$CQEmbedVersion {
					set pRoutine=$lg(cachedqueryinfo,14),pCodeContainer=$p(pRoutine,".",*),pRoutine=$p(pRoutine,".",1,*-1)_$s(pCodeContainer="CLS":".1",1:"")
				}
				if pRoutine'="",pRoutine'="%Freeze%Plan" {
					set $$$SQLIndex(1,pHash,"rtn",pRoutine)=$lb(pCodeContainer,runtimelocation)
					set $$$SQLIndex(2,pRoutine,pHash)=""
				}
				set $$$SQLIndex(1,pHash,childtype,pChildHash)=""
			}
			if $d(pSQLStatementID) { // --- Reset the 'SQLStatementID' Value ---
				set oldSQLStatementID=$LG($$$SQLIndex(1,pHash,0),6)
				
				set $LIST($$$SQLIndex(1,pHash,0),6)=pSQLStatementID
				kill:oldSQLStatementID'="" $$$SQLIndex(4,oldSQLStatementID,pHash)  // Kill old 'SQLStatementID' Index!
				set:pSQLStatementID'="" $$$SQLIndex(4,pSQLStatementID,pHash)=""    // Set new 'SQLStatementID' Index!
			}
		}
		$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock)
	} catch {
		try {
			$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock) // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
			if $ze["<EXTERNAL INTERRUPT" { throw }  // If we were interrupted externally, unlock and throw the same EI error.  Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
			elseif $ze["<PROTECT" {}	// Ignore <PROTECT> errors, user does not have permission to write to SQL index, so this entry will not be updated
			else { set SQLCODE=-400,%msg=$$$FormatText($$$Text("Unexpected error in attemptng to update SQL statement index, $ze = %1. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),$ze,$system,$namespace,$job),return=0 }
		} catch {
			$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock) // 	There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
			if $ze["<EXTERNAL INTERRUPT" { throw }	// If we were interrupted externally in the catch(), unlock and throw the same EI error.  Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
				#; it should be almost impossible to get here.  An error within the error handler and neither were EI errors, reset setting and release locks and report error
			set SQLCODE=-400,%msg=$$$FormatText($$$Text("Unexpected error in attemptng to update SQL statement index, $ze = %1. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),$ze,$system,$namespace,$job),return=0
		}
	}
	RETURN return
}
.
	// Delete the specified 'pRoutine' from all of the appropriate SQL Statement Indices
	// in which it is referenced, and clear all PTools/SQLStats data for this routine:
	//
	//   $$$SQLIndex(1,tHash,"rtn",pRoutine)
	//   $$$SQLIndex(2,pRoutine,tHash)
	//   
	// Parameters:
	//  - pRoutine  :: passed by value, input
	//     Name of the routine being deleted that we need to remove from the SQL Statement Indices
	//  - pNoLock   :: passed by value, input, 1/0 flag
	//     A flag to determine if the SQL Statement Index should NOT be locked before
	//     it is deleted: 0 = False (Lock); 1 = True (Don't Lock)
	//
	// Return value:
	//   NONE
	//
	// Called From:
	//  - %SYS.SQLSRV.MAC
	//      RtnAlloc(...)
	//        do:$d($$$SQLIndex(2,rtn)) DeleteSQLIndex(rtn)
	//      RtnDelete(...)
	//        do:$d($$$SQLIndex(2,rtn)) DeleteSQLIndex(rtn)
	//      RtnDeleteUpgrade(...)
	//        do DeleteSQLIndex(rtn)
	//  - %apiRTN.MAC
	//      Import(...)/ImportLoop2
	//        do:$d($$$SQLIndex(2,rtn)) DeleteSQLIndex^%SYS.SQLSRV(rtn)
	//      CompileRoutine(...)
	//        do:$d($$$SQLIndex(2,rtnname)) DeleteSQLIndex^%SYS.SQLSRV(rtnname)
	//      Delete(...)
	//        if $d($$$SQLIndex(2,rtn)) { do DeleteSQLIndex^%SYS.SQLSRV(rtn) }
	//      SaveRoutine(...)
	//        do:$d($$$SQLIndex(2,rtnname)) DeleteSQLIndex^%SYS.SQLSRV(rtnname)
	//  - %occRoutine.MAC
	//      newroutine
	//        do:$d($$$SQLIndex(2,rtnname)) DeleteSQLIndex^%SYS.SQLSRV(rtnname)
	//  - %qarmac.MAC
	//      %qarmac(...)
	//        do:$d($$$SQLIndex(2,rtname)) DeleteSQLIndex^%SYS.SQLSRV(rtname)
	//  - %Library.Routine.CLS
	//      SaveStream(...)
	//        do:$d($$$SQLIndex(2,..RoutineName)) DeleteSQLIndex^%SYS.SQLSRV(..RoutineName)
	//	
DeleteSQLIndex(pRoutine,pNoLock=0) [] PUBLIC {
	try {
		quit:'$d($$$SQLIndex(2,pRoutine))
		if $g($$$SQLIndexVersion)<$$$SQLIndexCurrentVersion { do DeleteEntireSQLIndex() quit }
		set tHash=""
			// Kill the SQL statement index for each statement in this routine.
			// If there is a plan for this index, do not delete the entire entry
			// If no plan, and this statement is in no other routines, delete the entry
		for  {
			set tHash=$o($$$SQLIndex(2,pRoutine,tHash)) quit:tHash=""
			if 'pNoLock {
					#; if we cannot acquire the lock here, what do we do?  There is no failure to report back to the caller.
					#; For now we will just continue on to the next hash and not delete this entry.  ok???
				$$$lockexclusive($$$SQLIndex(1,tHash),$s($zu(115,4)<20:20,1:$zu(115,4)),gotlock)
				continue:'gotlock
.
			}
			kill $$$SQLIndex(1,tHash,"rtn",pRoutine)	// This routine entry is killed.
			kill $$$SQLIndex(2,pRoutine,tHash)	// This routine/hash entry is killed
			
				#; The plan is defined, we need to see if this plan's version is older than our current version.
				#; If so, and the plan is not already frozen, freeze the plan.
				#; This means upon upgrade, when a query is recompiled, it will continue to use the same plan as the previous version
				#; until it is unfrozen.  This prevents upgrading customers from degrades in performance do to plan choice
				#; When recompiling after an upgrade, SQL within a class definition compilation probably comes through here first as the class is uncompiled.
			set:'$d(adaptivemode) adaptivemode=$$$AdaptiveMode
			if 'adaptivemode {	// Only define the plan as Frozen/Upgrade if AdaptiveMode=0
				set planinfo=$g($$$SQLIndex(1,tHash,"planinfo"))
				set planVersion=$p($p($lg(planinfo,3),") ",2)," ",1)		// same logic used in $SYSTEM.Version.GetNumber()
				set sysVersion=$p($p($zv,") ",2)," ",1)
				if '$lg(planinfo,1),planVersion'="",planVersion<sysVersion {			// assume first compile after upgrade
						#; plan was defined using an older version, freeze the plan
					set result=$$FreezePlan(tHash,2)				// not really concerned if this fails, should I be?
				}
			}
.
			if 'pNoLock { $$$unlockexclusive($$$SQLIndex(1,tHash),I,gotlock) }
		}
		#; --- Clear PTools/SQLStats data for this given 'pRoutine' ---
		if $$$existsSYSPToolsStatsSQLByRoutine(pRoutine) { set SQLStatsClear=$$clearStatsSQL^%SYS.PTools($NAMESPACE,pRoutine,0,1,0,0) }
		elseif $e(pRoutine,1,7)'="%sqlcq." { // --- Clear PTools/SQLStats data Based on UCQCaller ---
			if $$$existsSYSPToolsStatsSQLIndexByRoutineUCQCaller(pRoutine_".RTN") { set SQLStatsClear=$$clearStatsSQL^%SYS.PTools($NAMESPACE,pRoutine_".RTN",0,1,0,0) }
			elseif $$$existsSYSPToolsStatsSQLIndexByRoutineUCQCaller($p(pRoutine,".",1,*-1)_".CLS") { set SQLStatsClear=$$clearStatsSQL^%SYS.PTools($NAMESPACE,$p(pRoutine,".",1,*-1)_".CLS",0,1,0,0) }
		}
	} catch {
		try {
			if 'pNoLock { $$$unlockexclusive($$$SQLIndex(1,tHash),I,gotlock) } // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
			if $ze["<PROTECT" {}	// Ignore <PROTECT> errors, user does not have permission to write to SQL index, so this entry will not be updated
			else { throw }
		} catch {
			if $ze["<PROTECT" { quit }	// In some mirror databases we don't allow lock/unlock if the db is read-only and not an async member (SML2226)  Don't report this as an error to the caller, and don't try to unlock again
			if 'pNoLock { $$$unlockexclusive($$$SQLIndex(1,tHash),I,gotlock) }
			throw
		}
	}
	RETURN
}
.
	// Delete child hash entry for a given parent hash
	//  Arguments:
	//  - hash      :: passed by value, input
	//     Hash id of the parent statement
	//  - childHash :: passed by value, input
	//     Hash id of the child statement
	//  - pNoLock   :: passed by value, input
	//     1/0 flag.  If 1, do not lock the SQL Statement Index record
	//
	// Return value:
	//   none
	//  
DeleteSQLIndexChild(hash,childHash,pNoLock) [] PUBLIC {
	try {
		quit:'$d($$$SQLIndex(1,hash))
		if 'pNoLock {
				#; if we cannot acquire the lock here, what do we do.  There is no failure to report back to the caller.  Just quit
				#; For now we will just continue on to the next hash and not delete this entry.  ok???
			$$$lockexclusive($$$SQLIndex(1,hash),$s($zu(115,4)<20:20,1:$zu(115,4)),gotlock)
			quit:'gotlock
		}
		kill $$$SQLIndex(1,hash,"child",childHash)
		if 'pNoLock { $$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock) }
	} catch {
		try {
			if 'pNoLock { $$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock) } // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
			if $ze["<PROTECT" {}	// Ignore <PROTECT> errors, user does not have permission to write to SQL index, so this entry will not be updated
			else { throw }
		} catch {
			if $ze["<PROTECT" { quit }	// In some mirror databases we don't allow lock/unlock if the db is read-only and not an async member (SML2226)  Don't report this as an error to the caller, and don't try to unlock again
			if 'pNoLock { $$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock) }
			throw
		}
	}
	RETURN
}
.
	// Convert any stats in the SQL Statement Index to version 2 of the stats
	//  Version 2 moves "stat" out of the "1" node and adds a date index to improve performance of queries against daily and hourly stats
	// Returns a %Status value
	// If this fails, any statements already converted are left converted.  This function can be run again if the call fails to convert any unconverted stats
ConvertSIStatsV2() PUBLIC {
	RETURN:$g($$$SQLIndex("statsversion"))>=2 $$$OK	// Already converted
	set sc=$$$OK
	try {
		set hash=""
		for  {
			set hash=$o($$$SQLIndex(1,hash)) quit:hash=""
			$$$lockexclusive($$$SQLIndex(1,hash),$s($zu(115,4)<20:20,1:$zu(115,4)),gotlock)
			if '$g(gotlock) {
				set sc=$$$ERROR($$$LockFailedToAcquireExclusive,$name($$$SQLIndex(1,hash)))
				quit
			}
			if '$d($$$SQLIndex(1,hash,"stat"))	{	// See if there are stats for this statement
				$$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock)
				continue
			}
				// if the stats were collected from a version older tham 2023.3.0 the stats might have bad data, just purge these stats and continue
				// The associated fix that corrected the stats is DP-423899 in 2023.3.0 and up.
			set planVersion=$lg($g(^rINDEXSQL("sqlidx",1,hash,"planinfo")),3)
			if $SYSTEM.Version.GetNumber(planVersion)<"2023.3.0" {
				kill $$$SQLIndex(1,hash,"stat")									// kill <v2 stats from older version
				$$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock)
				continue
			}
			merge $$$SQLIndex(5,hash,"stat")=$$$SQLIndex(1,hash,"stat")		// move stats
			kill $$$SQLIndex(1,hash,"stat")									// kill <v2 stats
			set date=""
			for  {															// define day index
				set date=$o($$$SQLIndex(5,hash,"stat",date)) quit:date=""
				set $$$SQLIndex(6,date,hash)=""
			}
			$$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock)
		}
		set:'$$$ISERR(sc) $$$SQLIndex("statsversion")=2	// Mark this namespaces as having version 2 stats if we converted all SI entries
	} catch {
		set sc=$$$ERROR($$$GeneralError,$ze)
	}
	$$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock)
	RETURN sc
}
.
.
	// Given a Statement hash, unfreeze (delete) any plan that is frozen for the statement
	//  Arguments:
	//  - pHash :: passed by value, input
	//     Hash IDKEY for the SQL Statement
	//  - frozenType :: passed by value, input
	//     0 means unfreeze if it is Frozen/Explicit, or Frozen/Upgrade
	//     2 means unfreeze only if it is Frozen/Updgrade.
	//  - SQLCODE :: passed by reference, output
	//     integer representing the sqlcode for the first error caught by the operation
	//  - %msg :: passed by reference, output
	//     string error message for the errors caught by the operation
	//
	// Return value:
	//   Returns 1 if ok, 0 if error.  If err, SQLCODE and %msg are set.
UnfreezePlan(pHash,frozenType=0,&SQLCODE=0,&%msg) PUBLIC {
	try {
		set return=1
		try {
				// In some mirror databases we don't allow lock/unlock if the db is read-only and not an async member (SML2226)
			$$$lockexclusive($$$SQLIndex(1,pHash),$s($zu(115,4)<20:20,1:$zu(115,4)),gotlock)
		} catch {
			if $ze["<PROTECT" { set gotlock=0 }
			else { throw }
		}
		if 'gotlock { 
			set:SQLCODE>=0 SQLCODE=-114
			set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$FormatText($$$Text("Unable to acquire exclusive lock to unfreeze plan for SQL Statement Index entry with ID '%1'.","%SQL.Server"),pHash)
			set return=0
			quit 
		}
		if $d($$$SQLIndex(1,pHash,"plan")) {	// update log entry
			if frozenType=2,$li($$$SQLIndex(1,pHash,"planinfo"),1)'=2 { set:'SQLCODE SQLCODE=100 } // Don't unfreeze Frozen/Explicit if only asking for Frozen/Upgrade to be unfrozen
			elseif frozenType=0,$case($li($$$SQLIndex(1,pHash,"planinfo"),1),0:1,3:1,:0) { set:'SQLCODE SQLCODE=100 } // plan already frozen
			else {
				kill $$$SQLIndex(1,pHash,"err")
					// User has chosen to explicitly unfreeze a plan.  We record that, along with timestamp and new version info
				set savets=$zu(188),savets=$zdt(savets,3,1,$l($p(savets,".",2)))
				set $li($$$SQLIndex(1,pHash,"planinfo"),1,3)=$lb(0,savets,$zv)
				set $li($$$SQLIndex(1,pHash,"planinfo"),6,8)=$lb(,,)
			}
		}
		else {				// index for this hash does not exist
			set return=0
			set:'SQLCODE SQLCODE=100
			if '$d($$$SQLIndex(1,pHash)) { set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$FormatText($$$Text("SQL Statement index for hash id '%1' does not exist.","%SQL.Server"),pHash) }
			else                         { set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$FormatText($$$Text("SQL Statement index for hash id '%1' does not include a query plan","%SQL.Server"),pHash) }
		}
		// JSL5186
		set rtuhash="" 
		for { // JSL5186, walk all RTU hashes stored in the parent statement index
			set rtuhash=$O($$$SQLIndex(1,pHash,"rtu",rtuhash)) quit:rtuhash=""
			do UnfreezePlan(rtuhash,frozenType) // recursive call, since RTUs have no children, 1 level of recursion
		}
			#; Now Purge any cached queries using this plan we just Unfroze
		set rtn=""
		for {
			set rtn=$o(^rINDEXSQL("sqlidx",1,pHash,"rtn",rtn),1,data) quit:rtn=""
			if $lg(data)="CLS" {
				set cqrtn=$lg(data,2)
				if ($p(cqrtn,".",1)_".")'=$$$CQShortRoutinePrefix,($p(cqrtn,".",1,2)_".")'=$$$CQSYSShortRoutinePrefix { continue } 	// not a cached query class
				if $p(cqrtn,".",*)=1 { set cqrtn=$p(cqrtn,".",1,*-1) }	// If this is a %sqlcq.NAMESPACE.cls#.1 routine, remove the ".1"
					#; We now have a cached query classname in cqrtn.  
					#; If the statement is not against a sharded table and cqregen is supported by this system, we can mark it as stale, otherwise, we purge it
				if '$d($$$CQ("QueryRoutine",cqrtn),qrdate)||($g(^%SYS("sql","sys","cqnoregen"),0)) {	// We are not regenerating CQs on this system, or the CQ is missing or corrupt.
					do PurgeRtn(cqrtn,1)
				} elseif $$AnyClassesAreSharded($lg(qrdate,4)) {	// Purge if any classes for this CQ are sharded
					do PurgeRtn(cqrtn,1)
				} else {	// else regenerate
					set x=$$DefineCQAsStale(cqrtn)
				}
			}
		}
		$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock)
	} catch {
		try {
			$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock) // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
			if $ze["<EXTERNAL INTERRUPT" { throw } // If we were interrupted externally, unlock and throw the same EI error.  Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
			elseif $ze["<PROTECT" { 
				set:SQLCODE>=0 SQLCODE=-99
				set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$Text("Attempting to unfreeze plan for SQL Statement Index encountered a <PROTECT> error","%SQL.Server") 
				do Audit99^%SYS.SQLSEC(%msg)
			} else { 
				set SQLCODE=-400,%msg=$$$FormatText($$$Text("Unexpected error in attemptng to unfreeze plan for SQL Statement Index, $ze = %1. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),$ze,$system,$namespace,$job),return=0
			}
		} catch {
			if $ze["<PROTECT" { }	// In some mirror databases we don't allow lock/unlock if the db is read-only and not an async member (SML2226)  Don't report this as an error to the caller, and don't try to unlock again
			$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock)
			if $ze["<EXTERNAL INTERRUPT" { throw } // If we were interrupted externally in the catch(), unlock and throw the same EI error.  Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
				#; it should be almost impossible to get here.  An error within the error handler and neither were EI errors, reset setting and release locks and report error
			set SQLCODE=-400,%msg=$$$FormatText($$$Text("Unexpected error in attemptng to unfreeze plan for SQL Statement Index, $ze = %1. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),$ze,$system,$namespace,$job),return=0
		}
	}
	RETURN return
}
.
/// Given a $lb(classnames), return 1 if any class in the list are sharded, otherwise return 0
AnyClassesAreSharded(clist) {
	RETURN:clist=""||('$listvalid(clist)) 0
	set ptr=0
	while $listnext(clist,ptr,class) { if $$$comClassKeyGet(class,$$$cCLASSsharded) { RETURN 1 } }	// if Sharded = 1 or 2, RETURN 1
	RETURN 0
}
.
	// Given a Statement hash, Freeze the plan that is stored for the statement
	//  Arguments:
	//  - pHash :: passed by value, input
	//     Hash IDKEY for the SQL Statement
	//  - freezeType :: passed by value, input
	//     1 (default) means explicitly frozen, 2 means implcitly frozen after upgrade
	//  - SQLCODE :: passed by reference, output
	//     integer representing the sqlcode for the first error caught by the operation
	//  - %msg :: passed by reference, output
	//     string error message for the errors caught by the operation
	//
	// Return value:
	//   Returns 1 if ok, 0 if error.  If err, SQLCODE and %msg are set.
FreezePlan(pHash,freezeType=1,&SQLCODE=0,&%msg) PUBLIC {
	try {
		set return=1
		try {
				// In some mirror databases we don't allow lock/unlock if the db is read-only and not an async member (SML2226)
			$$$lockexclusive($$$SQLIndex(1,pHash),$s($zu(115,4)<20:20,1:$zu(115,4)),gotlock)
		} catch {
			if $ze["<PROTECT" { set gotlock=0 }
			else { throw }
		}
		if 'gotlock { 
			set:SQLCODE>=0 SQLCODE=-114
			set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$FormatText($$$Text("Unable to acquire exclusive lock to freeze plan for SQL Statement Index entry with ID '%1'. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),pHash,$system,$namespace,$job)
			set return=0
			quit 
		}
		set rtuhash=""
		for { // JSL5186, walk all RTU hashes stored in the parent statement index
			set rtuhash=$O($$$SQLIndex(1,pHash,"rtu",rtuhash)) quit:rtuhash=""
			do FreezePlan(rtuhash,freezeType) // recursive call, since RTUs have no children, 1 level of recursion
		}
		if $d($$$SQLIndex(1,pHash,"plan")) {	// update log entry
			if $li($$$SQLIndex(1,pHash,"planinfo"),1)=3 {	// Can't freeze Unfrozen/Parallel
				set:'SQLCODE SQLCODE=100
				set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$FormatText($$$Text("SQL Statement index for hash id '%1' has a plan state of Unfrozen/Parallel.  This plan may not be frozen. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),pHash,$system,$namespace,$job)
				set return=0
				GOTO end
			}
			elseif $$HasExternalTable(pHash) {
				set:'SQLCODE SQLCODE=100
				set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$FormatText($$$Text("SQL Statement for hash id '%1' references an external/linked table.  This plan may not be frozen. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),pHash,$system,$namespace,$job)
				set return=0
				GOTO end
			}
			elseif $li($$$SQLIndex(1,pHash,"planinfo"),1)=1 { set:'SQLCODE SQLCODE=100 } // plan already frozen
			else {
				set $li($$$SQLIndex(1,pHash,"planinfo"),1)=freezeType
				set $li($$$SQLIndex(1,pHash,"planinfo"),6,8)=$lb(,,)
			}
		}
		else {				// index for this hash does not exist
			set return=0
			set:'SQLCODE SQLCODE=100
			if '$d($$$SQLIndex(1,pHash)) { set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$FormatText($$$Text("SQL Statement index for hash id '%1' does not exist. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),pHash,$system,$namespace,$job) }
			else                         { set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$FormatText($$$Text("SQL Statement index for hash id '%1' does not include a query plan. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),pHash,$system,$namespace,$job) }
		}
end		$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock)
	} catch {
		try {
			$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock) // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
			if $ze["<EXTERNAL INTERRUPT" { throw }	// If we were interrupted externally, unlock and throw the same EI error.  Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
			elseif $ze["<PROTECT" { 
				set:SQLCODE>=0 SQLCODE=-99
				set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$Text("Attempting to freeze plan for SQL Statement Index encountered a <PROTECT> error","%SQL.Server") 
				do Audit99^%SYS.SQLSEC(%msg)
			} else { 
				set SQLCODE=-400,%msg=$$$FormatText($$$Text("Unexpected error in attemptng to freeze plan for SQL Statement Index, $ze = %1. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),$ze,$system,$namespace,$job),return=0
			}
		} catch {
			$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock) // 	There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
			if $ze["<EXTERNAL INTERRUPT" { throw }	// If we were interrupted externally in the catch(), unlock and throw the same EI error.  Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
				#; it should be almost impossible to get here.  An error within the error handler and neither were EI errors, reset setting and release locks and report error
			set SQLCODE=-400,%msg=$$$FormatText($$$Text("Unexpected error in attemptng to freeze plan for SQL Statement Index, $ze = %1. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),$ze,$system,$namespace,$job),return=0
		}
	}
	RETURN return
}
.
	// Given a Statement hash, determine if the statement uses aany exteral (linked) tables
	//  Arguments:
	//  - pHash :: passed by value, input
	//     Hash IDKEY for the SQL Statement
	//	- checkForeignTables :: 
	//		Boolean whether to whether foreign tables count as external tables (e.g. as opposed to linked)
	//
	// Return value:
	//   Returns 1 if any table in statement is external, otherwise 0.
HasExternalTable(pHash,checkForeignTables=1) [] PUBLIC {
	set relation=""
	for  {
		set relation=$o($$$SQLIndex(1,pHash,"rel",relation)) quit:relation=""	// relation is a $$$UPPER(iqn) value
		set extent=$$$GetExtentNameFromIQN(relation) continue:extent=""		// ??? possible
		if $$$SQLTabConnect(extent)'="" { RETURN 1 }				// Found an external table, return 1 from this function
		if checkForeignTables, $$$IsAForeignTable(extent) { RETURN 1 }
	}
	RETURN 0		// No external tables found
}
.
	// Given a Statement hash, clear all SQL statistics assocaited with this
	//  Arguments:
	//  - pHash :: passed by value, input
	//     Hash IDKEY for the SQL Statement
	//  - SQLCODE :: passed by reference, output
	//     integer representing the sqlcode for the first error caught by the operation
	//  - %msg :: passed by reference, output
	//     string error message for the errors caught by the operation
	//
	// Return value:=
	//   Returns 1 if ok, 0 if error.  If err, SQLCODE and %msg are set.
	// Called from:
	//   %CSP.UI.Portal.Dialog.SQLStatementDetails.ClearSQLStatistics()
	//   %SYSTEM.SQL.Statement.ClearStatement()
	//   ActionStatementAll
	//   ActionStatementSchema
	//   ActionStatementRelation
ClearStats(pHash,&SQLCODE=0,&%msg) PUBLIC {
	try {
		set return=1
		try {
				// In some mirror databases we don't allow lock/unlock if the db is read-only and not an async member (SML2226)
			$$$lockexclusive($$$SQLIndex(1,pHash),$s($zu(115,4)<20:20,1:$zu(115,4)),gotlock)
		} catch {
			if $ze["<PROTECT" { set gotlock=0 }
			else { throw }
		}
		if 'gotlock { 
			set:SQLCODE>=0 SQLCODE=-114
			set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$FormatText($$$Text("Unable to acquire exclusive lock to clear SQL statistics for SQL Statement Index entry with ID '%1'. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),pHash,$system,$namespace,$job)
			set return=0 
			quit
		}
		if '$d($$$SQLIndex(1,pHash)) {
			set:'SQLCODE SQLCODE=100
			set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$FormatText($$$Text("SQL Statement index for hash id '%1' does not exist. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),pHash,$system,$namespace,$job)
		} else {
				#; First kill off Day index entries for this hash
			set date=""
			for  {
				set date=$o($$$SQLIndex(5,pHash,"stat",date)) quit:date=""
				kill $$$SQLIndex(6,date,pHash)
			}
				#; Then kill off master data for stats, daily stats, and hourly stats
			kill $$$SQLIndex(5,pHash,"stat")
		}
		$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock)
	 } catch {
		try {
			if $ze["<EXTERNAL INTERRUPT" {
					#; If we were interrupted externally, unlock and throw the same EI error
					#; Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
				$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock) // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
				throw
			}
			$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock) // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
			if $ze["<PROTECT" { 
				set:SQLCODE>=0 SQLCODE=-99
				set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$FormatText($$$Text("Attempting to Clear Stats for SQL Statement Index encountered a <PROTECT> error.  System:Instance: %1, Namespace: %2, $Job: %3","%SQL.Server"),$system,$namespace,$job)
				do Audit99^%SYS.SQLSEC(%msg)
			} else { 
				set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$FormatText($$$Text("Unexpected error attemptng to Clear Stats for SQL statement index, $ze = %1. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),$ze,$system,$namespace,$job)
			}
		} catch {
			if $ze["<EXTERNAL INTERRUPT" {
					#; If we were interrupted externally in the catch(), unlock and throw the same EI error
					#; Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
				$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock) // 	There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
				throw
			}
				#; it should be almost impossible to get here.  An error within the error handler and neither were EI errors, reset setting and release locks and report error
			$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock)
			set %msg=$select($get(%msg)'="":%msg_$$$NL,1:"")_$$$FormatText($$$Text("Unexpected error attemptng to Clear Stats for SQL statement index, $ze = %1. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),$ze,$system,$namespace,$job)
		}
	}
	RETURN return
}
.
	// Perform an action for each SQL Statement in this namespace.
	//  Arguments:
	//  - freeze :: passed by value, input
	//    "" means do not modify frozen state
	//     0 means make all Unfrozen
	//     1 means make all Frozen/Explicit - default
	//     2 means make all statements marked Frozen/Upgrade Unfrozen
	//  - clearstat :: passed by value input
	//     0 means do not clear SQL stats
	//     1 means clear SQL stats
	//  - errors :: passed by reference, output
	//     error array reporting errors for any plans that could not be frozen
	//  - count :: passed by reference, output
	//     integer representing the number of plans updated by the operation
	//  - SQLCODE :: passed by reference, output
	//     integer representing the sqlcode for the first error caught by the operation
	//  - %msg :: passed by reference, output
	//     string error message for the errors caught by the operation
	//
	// Return value:
	//   Returns nothing
ActionStatementAll(freeze="",clearstat=0,&errors,&count,&SQLCODE=0,&%msg) PUBLIC {
	try {
		set hash="",count=0
		kill errors set errors=0
		for  {
			set hash=$o($$$SQLIndex(1,hash)) quit:hash=""
			if clearstat=1 {
				If '$$ClearStats(hash,.SQLCODE,.%msg) { set errors=errors+1,errors(errors)="Unable to clear SQL statistics for statement ID '"_hash_"', SQLCODE = "_SQLCODE_$s($g(%msg)'="":", %msg = "_%msg,1:"") }
			}
			continue:'$d($$$SQLIndex(1,hash,"plan"))	// no plan
			if freeze=1 {	// Make all Frozen/Explicit
				continue:($case($lg($g($$$SQLIndex(1,hash,"planinfo")),1),1:1,3:1,:0))	// plan already frozen, or plan not freezable
				if '$$FreezePlan(hash,,.SQLCODE,.%msg) { set errors=errors+1,errors(errors)="Plan failed to freeze for statement ID '"_hash_"', SQLCODE = "_SQLCODE_$s($g(%msg)'="":", %msg = "_%msg,1:"") }
				set:'SQLCODE count=count+1
			}
			elseif freeze=2 {	// Make all Frozen/Upgrade plans Unfrozen
				continue:($lg($g($$$SQLIndex(1,hash,"planinfo")),1)'=2)			// plan not Frozen/Upgrade
				if '$$UnfreezePlan(hash,,.SQLCODE,.%msg) { set errors=errors+1,errors(errors)="Plan failed to freeze for statement ID '"_hash_"', SQLCODE = "_SQLCODE_$s($g(%msg)'="":", %msg = "_%msg,1:"") }
				set:'SQLCODE count=count+1
			}
			elseif freeze=0 {		// Make all plan Unfrozen
				continue:$case($lg($g($$$SQLIndex(1,hash,"planinfo")),1),0:1,3:1,:0)	// plan not frozen
				if '$$UnfreezePlan(hash,,.SQLCODE,.%msg) { set errors=errors+1,errors(errors)="Plan failed to unfreeze for statement ID '"_hash_"', SQLCODE = "_SQLCODE_$s($g(%msg)'="":", %msg = "_%msg,1:"") }
				set:'SQLCODE count=count+1
			}
		}
		set:(count=0)&&'SQLCODE SQLCODE=100
	}
	catch {
		if $ze["<PROTECT" { 
			set:SQLCODE>=0 SQLCODE=-99
			set errors=errors+1,errors(errors)="Attempting to run ActionStatementAll("_freeze_":"_clearstat_") encountered a <PROTECT> error",return=0 
		}
		else { 
			set:SQLCODE>=0 SQLCODE=-400
			set errors=errors+1,errors(errors)="Unexpected error in attemptng to run ActionStatementAll("_freeze_":"_clearstat_"), $ze = "_$ze_".",return=0 
		}
	}
	QUIT
}
.
	// Freeze the plan for each SQL Statement in the given schema
	//  Arguments:
	//  - schema :: passed by value, input
	//     name of the schema to freeze plans for
	//  - freeze :: passed by value, input
	//    "" means do not modify frozen state
	//     0 means make all Unfrozen
	//     1 means make all Frozen/Explicit - default
	//     2 means make all statements marked Frozen/Upgrade Unfrozen
	//  - clearstat :: passed by value input
	//     0 means do not clear SQL stats
	//     1 means clear SQL statsx
	//  - errors :: passed by reference, output
	//     error array reporting errors for any plans that could not be frozen
	//  - count :: passed by reference, output
	//     integer representing the number of plans updated from the operation
	//  - SQLCODE :: passed by reference, output
	//     integer representing the sqlcode for the first error caught by the operation
	//  - %msg :: passed by reference, output
	//     string error message for the errors caught by the operation
	//
	// Return value:
	//   Returns nothing
ActionStatementSchema(schema="",freeze="",clearstat=0,&errors,&count,&SQLCODE=0,&%msg) PUBLIC {
	try {
		kill errors set errors=0,foundAny=0,count=0
		quit:schema=""
		set SCHEMA=$$$UPPER(schema),relation=SCHEMA
		for  {
			set relation=$o($$$SQLIndex(3,relation)) quit:relation=""
			quit:SCHEMA'=$$$SchemaFromIQN(relation)				// no more relations in this schema
			set hash=""
			for  {
				set hash=$o($$$SQLIndex(3,relation,hash)) quit:hash=""
				set foundAny=1
				if clearstat=1 {
					If '$$ClearStats(hash,.SQLCODE,.%msg) { set errors=errors+1,errors(errors)="Unable to clear SQL statistics for statement ID '"_hash_"', SQLCODE = "_SQLCODE_$s($g(%msg)'="":", %msg = "_%msg,1:"") }
				}
				continue:'$d($$$SQLIndex(1,hash,"plan"))
				if freeze=1 {		// Make all Frozen/Explicit
					continue:($case($lg($g($$$SQLIndex(1,hash,"planinfo")),1),1:1,3:1,:0))	// plan already Frozen/Explicit or plan Unfrozen/Parallel
					if '$$FreezePlan(hash,,.SQLCODE,.%msg) { set errors=errors+1,errors(errors)="Plan failed to freeze for statement ID '"_hash_"', SQLCODE = "_SQLCODE_$s($g(%msg)'="":", %msg = "_%msg,1:"") }
					set:'SQLCODE count=count+1
				}
				elseif freeze=2 {	// Change from Frozen/Upgrade to Unfrozen
					continue:($lg($g($$$SQLIndex(1,hash,"planinfo")),1)'=2)	// no plan, or plan not Frozen/Upgrade
					if '$$UnfreezePlan(hash,,.SQLCODE,.%msg) { set errors=errors+1,errors(errors)="Plan failed to freeze for statement ID '"_hash_"', SQLCODE = "_SQLCODE_$s($g(%msg)'="":", %msg = "_%msg,1:"") }
					set:'SQLCODE count=count+1
				}
				elseif freeze=0 {			// make all Unfrozen
					continue:($case($lg($g($$$SQLIndex(1,hash,"planinfo")),1),0:1,3:1,:0))	// plan already unfrozen
					if '$$UnfreezePlan(hash,,.SQLCODE,.%msg) { set errors=errors+1,errors(errors)="Plan failed to unfreeze for statement ID '"_hash_"', SQLCODE = "_SQLCODE_$s($g(%msg)'="":", %msg = "_%msg,1:"") }
					set:'SQLCODE count=count+1
				}
			}
		}
		if 'foundAny,freeze'="" {
			set errors=errors+1,errors(errors)="No statements found for schema "_schema_" attempting to "_$s(freeze=1:"freeze",1:"unfreeze")_" plans.",return=0
		} 
		set:(count=0)&&'SQLCODE SQLCODE=100
	}
	catch {
		if $ze["<PROTECT" { 
			set:SQLCODE>=0 SQLCODE=-99
			set errors=errors+1,errors(errors)="Attempting to run ActionStatementSchema^%SYS.SQLSRV("_freeze_":"_clearstat_","""_schema_""") encountered a <PROTECT> error",return=0 
		}
		else { 
			set:SQLCODE>=0 SQLCODE=-400
			set errors=errors+1,errors(errors)="Unexpected error in attemptng to run ActionStatementSchema^%SYS.SQLSRV("_freeze_":"_clearstat_","""_schema_"""), $ze = "_$ze_".",return=0 
		}
	}
	QUIT
}
.
	// Freeze the plan for each SQL Statement in the given table/view
	//  Arguments:
	//  - relation :: passed by value, input
	//     name of the table or view to [un]freeze plans for
	//     the relation name must be in iqn format, that is schema . $tr(tablename,".",$c(2))
	//     this is really only an issue if the unqialified table name contains "."s 
	//  - freeze :: passed by value, input
	//    "" means do not modify frozen state
	//     0 means make all Unfrozen
	//     1 means make all Frozen/Explicit - default
	//     2 means make all statements marked Frozen/Upgrade Unfrozen
	//  - clearstat :: passed by value input
	//     0 means do not clear SQL stats
	//     1 means clear SQL statsx
	//  - errors :: passed by reference, output
	//     error array reporting errors for any plans that could not be frozen
	//  - count :: passed by reference, output
	//     integer representing the number of plans updated from the operation
	//  - SQLCODE :: passed by reference, output
	//     integer representing the sqlcode for the first error caught by the operation
	//  - %msg :: passed by reference, output
	//     string error message for the errors caught by the operation
	//
	// Return value:
	//   Returns nothing
ActionStatementRelation(relation="",freeze="",clearstat=0,&errors,&count,&SQLCODE=0,&%msg) PUBLIC {
	try {
		kill errors set errors=0
		quit:relation=""
		set RELATION=$$$UPPER(relation)
		set hash="",foundAny=0,count=0
		for  {
			set hash=$o($$$SQLIndex(3,RELATION,hash)) quit:hash=""
			set foundAny=1
			if clearstat=1 {
				If '$$ClearStats(hash,.SQLCODE,.%msg) { set errors=errors+1,errors(errors)="Unable to clear SQL statistics for statement ID '"_hash_"', SQLCODE = "_SQLCODE_$s($g(%msg)'="":", %msg = "_%msg,1:"") }
			}
			continue:'$d($$$SQLIndex(1,hash,"plan"))
			if freeze=1 {		// Make all Frozen/Explicit
				continue:($case($lg($g($$$SQLIndex(1,hash,"planinfo")),1),1:1,3:1,:0))	// plan already Frozen/Explicit or Unfrozen/Parallel
				if '$$FreezePlan(hash,,.SQLCODE,.%msg) { set errors=errors+1,errors(errors)="Plan failed to freeze for statement ID '"_hash_"', SQLCODE = "_SQLCODE_$s($g(%msg)'="":", %msg = "_%msg,1:"") }
				set:'SQLCODE count=count+1
			}
			if freeze=2 {		// Make all Frozen/Upgrade plans Unfrozen
				continue:($lg($g($$$SQLIndex(1,hash,"planinfo")),1)'=2)	// plan not Frozen/Upgrade
				if '$$UnfreezePlan(hash,,.SQLCODE,.%msg) { set errors=errors+1,errors(errors)="Plan failed to freeze for statement ID '"_hash_"', SQLCODE = "_SQLCODE_$s($g(%msg)'="":", %msg = "_%msg,1:"") }
				set:'SQLCODE count=count+1
			}
			elseif freeze=0 {			// make all Unfrozen
				continue:($case($lg($g($$$SQLIndex(1,hash,"planinfo")),1),0:1,3:1,:0))	// plan already unfrozen
				if '$$UnfreezePlan(hash,,.SQLCODE,.%msg) { set errors=errors+1,errors(errors)="Plan failed to unfreeze for statement ID '"_hash_"', SQLCODE = "_SQLCODE_$s($g(%msg)'="":", %msg = "_%msg,1:"") }
				set:'SQLCODE count=count+1
			}
		}
		if 'foundAny,freeze'="" {
			set errors=errors+1,errors(errors)="No statements found for relation "_relation_" attempting to "_$s(freeze=1:"freeze",1:"unfreeze")_" plans.",return=0
		}
		set:(count=0)&&'SQLCODE SQLCODE=100
	}
	catch {
		if $ze["<PROTECT" { 
			set:SQLCODE>=0 SQLCODE=-99
			set errors=errors+1,errors(errors)="Attempting to run ActionStatementRelation^%SYS.SQLSRV("_freeze_":"_clearstat_","""_relation_""") encountered a <PROTECT> error",return=0 
		}
		else { 
			set:SQLCODE>=0 SQLCODE=-400
			set errors=errors+1,errors(errors)="Unexpected error in attemptng to run ActionStatementRelation^%SYS.SQLSRV("_freeze_":"_clearstat_","""_relation_"""), $ze = "_$ze_".",return=0 
		}
	}
	QUIT
}
.
	// Clean up the SQL Statement Index (SSI) based on the 'purgeType' parameter
	// specified below...
	//
	// Parameters:
	//  - display   :: passed by value, input, 0/1 flag  
	//                 0 = Don't display any output
	//                 1 = Display the output to the screen
	//  - purgeType :: passed by value, input
	//                 0 = For each Routine Index 'rtn' & 'hash' [$$$SQLIndex(2,rtn,hash)]
	//                     that is a <stale rtn index>, clean the SQL Statement Index
	//                     by deleting the following SQL Statement Indices:
	//                       $$$SQLIndex(1,tHash,"rtn",pRoutine)
	//                       $$$SQLIndex(2,pRoutine,tHash)
	//                 1 = For each SQL Statement Index 'hash' [$o($$$SQLIndex(1,hash))] that
	//                     is a <stale stmt index>, remove that SQL Statement Index and its
	//                     related indices
	//
	// Key:
	//   <stale rtn index>  ::= A specific SQL Statement Index referenced by its 'hash'
	//                          within the Routine Index [$$$SQLIndex(2,rtn,hash)] is
	//                          considered 'stale' if the associated routine 'rtn' no 
	//                          longer exists:
	//                            '$d(^rINDEX(rtn,"OBJ")),'$d(^("INT")),'$d(^("MAC"))
	//   <stale stmt index> ::= A specific SQL Statement Index referenced by its 'hash' 
	//                          [$$$SQLIndex(1,hash)] is considered 'stale' if it has
	//                          an 'Unfrozen' Plan, and it is not used in any routine:
	//                            '$d($$$SQLIndex(1,hash,"rtn"))
	//
	// Return value:
	//   NONE
	//  
	// Called From:
	//  - %SYS.SQLSRV.MAC
	//      CleanSQLIndexTask()
	//        do CleanSQLIndex^%SYS.SQLSRV(0,0)
	//  - %CSP.UI.Portal.SQL.Home.CLS  (SMP)
	//      StatementIndexClean()
	//        do CleanSQLIndex^%SYS.SQLSRV(0,1)
	//  - %SYSTEM.SQL.Statement.CLS
	//      Clean()
	//        do CleanSQLIndex^%SYS.SQLSRV(0,1)
	//  - %SYS.WorkQueueMgr.MAC
	//      RunDaemon()
	//        Set sc=$$QueueRepeatSystem(60*60,"%CleanSQLIndex","$$CleanSQLIndexTask^%SYS.SQLSRV") If $$$ISERR(sc) Do appendError(sc)
	//
CleanSQLIndex(display=1,purgeType=0) [SQLCODE,%msg] PUBLIC {
	try {
		#; On a mirror non-primary system we can not write to statement index global from mirror so do nothing
		If $system.Mirror.IsMember(),'$system.Mirror.IsPrimary(),$system.Mirror.GetMemberType()'="Read-Write Reporting" RETURN
		// If the SQL Statement Index (SSI) global [$$$SQLIndex - ^rINDEXSQL] is located in a read-only DB, causing a <PROTECT> error when modified, then display a warning message and terminate this method's invocation!
		if $$GetGlobalPermission^%SYS.SECURITY($NAMESPACE, "^rINDEXSQL", "(""sqlidx"")") '[ "WRITE" {
			write:display !!,"Could not clean SQL statement index because the user does not have WRITE permissions on the database"
			RETURN
		}
		write:display !!,"Cleaning up the SQL Statement Index entries..."
		if $g($$$SQLIndexVersion)<$$$SQLIndexCurrentVersion { do DeleteEntireSQLIndex() RETURN }
			// Allow only one cleaner at a time, if we can not get the lock straight away just let other cleaner do the work
		try {
				// In some mirror databases we don't allow lock/unlock if the db is read-only and not an async member (SML2226)
			$$$lockexclusive($$$SQLIndex("CleanSQLIndex"),0,cleanlock)
		} catch {
			if $ze["<PROTECT" { set cleanlock=0 }
			else { throw }
		}
		RETURN:'cleanlock
		set cleanCnt=0,deleteCnt=0,ssiCnt=0
		if purgeType { // --- Cleanup <stale stmt index>s ---
			set hash=""
			for ssiCnt=1:1 { // --- Process All 'hash' Values of the SQL Statement Index ---
				set hash=$order($$$SQLIndex(1,hash))
				QUIT:hash=""  // No more 'hash' values!
				
				if display,'(ssiCnt#10) { write "." }  // Show Progress dots!
				set delObjIUDSIdx=$$NeedDeleteObjIUDSQLIdx(hash)
				if ('$d($$$SQLIndex(1,hash,"rtn")))||delObjIUDSIdx { // --- No Associated Routines ---
					$$$lockexclusive($$$SQLIndex(1,hash),$s($zu(115,4)<20:20,1:$zu(115,4)),gotlock)
					CONTINUE:'gotlock  // Skip if lock not acquired!
					#; Lock Acquired: If routine(s) now defined, then skip since there is nothing to clean!
					if ($d($$$SQLIndex(1,hash,"rtn")))&&('delObjIUDSIdx) { // --- SQL Statement Index used in routine(s) ---
						$$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock)
						CONTINUE
					}
					set planinfo=$g($$$SQLIndex(1,hash,"planinfo"))
					set hasFrozenPlan=$case($LG(planinfo,1),1:1,2:1,:0)
					if 'hasFrozenPlan { // --- Only Clean a SQL Statement Index that has an 'Unfrozen' Plan ---
						do DeleteSQLIndexEntry(hash,planinfo) // Remove the SQL Statement Index and its related indices!
						set deleteCnt=deleteCnt+1
					}
					$$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock)
				}
			}
		} else { // --- Cleanup <stale rtn index>s ---
			set iterator=##class(%Iterator.Global).%New($name($$$SQLIndex(2)),2,1,"","")
			set token=iterator.getzu113Cookie()
			for ssiCnt=1:1 { // --- Quickly Process All 'rtn' Values ---
				set level=$ZU(113,token,.rtn,.hash)
				QUIT:'level  // No more 'rtn' & 'hash' values!
				
				if display,'(ssiCnt#10) { write "." }  // Show Progress dots!
				if '$d(^rINDEX(rtn,"OBJ")),'$d(^("INT")),'$d(^("MAC")) { // --- Routine Doesn't Exist ---
					$$$lockexclusive($$$SQLIndex(1,hash),$s($zu(115,4)<20:20,1:$zu(115,4)),gotlock)
					CONTINUE:'gotlock  // Skip if we can't get the lock, as someone else may be updating this node
.
					#; Re-check that we still have this 'rtn' listed and the routine still doesn't exist
					set rtndata=$g($$$SQLIndex(1,hash,"rtn",rtn))
					set truertn=$LG(rtndata,2,rtn)    // For UCQ the rtn is the container name
					if '$d($$$SQLIndex(2,rtn,hash))||($d(^rINDEX(truertn,"OBJ"))||($d(^("INT")))||($d(^("MAC")))) { lock -$$$SQLIndex(1,hash)#"I" CONTINUE }
					
					#; --- Cleanup the SQL Statement Index and its related Routine Index ---
 					kill $$$SQLIndex(1,hash,"rtn",rtn)
					kill $$$SQLIndex(2,rtn,hash)
					set cleanCnt=cleanCnt+1
					
#IF 0	//MRP1312+ [Maybe add this code at a later date]
					if '$d($$$SQLIndex(1,hash,"rtn")) { // --- No Associated Routines ---
						set planinfo=$g($$$SQLIndex(1,hash,"planinfo"))
						set hasFrozenPlan=$case($LG(planinfo,1),1:1,2:1,:0)
						if 'hasFrozenPlan { // --- Only Clean a SQL Statement Index that has an 'Unfrozen' Plan ---
							do DeleteSQLIndexEntry(hash,planinfo) // Remove the SQL Statement Index and its related indices!
							set deleteCnt=deleteCnt+1,cleanCnt=cleanCnt-1
						}
					}
#ENDIF	//MRP1312-
					
					$$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock)
				}
			}
		}
		$$$unlockexclusive($$$SQLIndex("CleanSQLIndex"),I,cleanlock)
		write:display !?3,"Of the ",$fn(ssiCnt,",",0)," entr",$s(ssiCnt=1:"y",1:"ies")," processed, ",$fn(cleanCnt,",",0),$s(cleanCnt=1:" was",1:" were")," cleaned"," & ",$fn(deleteCnt,",",0),$s(deleteCnt=1:" was",1:" were")," deleted."
		write:display !?3,"Done!"
	} catch {
		try {
			if $ze["<EXTERNAL INTERRUPT" {
					#; If we were interrupted externally, unlock and throw the same EI error
					#; Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
				$$$unlockexclusive($$$SQLIndex("CleanSQLIndex"),I,cleanlock)
				if $g(hash)'="" { $$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock) } // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
				throw
			}
			$$$unlockexclusive($$$SQLIndex("CleanSQLIndex"),I,cleanlock)
			if $g(hash)'="" { $$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock) } // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
			write:display !!,"Unexpected error in CleanSQLIndex^%SYS.SQLSRV():  "_$ze
			do BACK^%ETN
		} catch {
			if $ze["<EXTERNAL INTERRUPT" {
					#; If we were interrupted externally in the catch(), unlock and throw the same EI error
					#; Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
				$$$unlockexclusive($$$SQLIndex("CleanSQLIndex"),I,cleanlock)
				if $g(hash)'="" { $$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock) } // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
				throw
			}
				#; it should be almost impossible to get here.  An error within the error handler and neither were EI errors, reset setting and release locks and report error
			$$$unlockexclusive($$$SQLIndex("CleanSQLIndex"),I,cleanlock)
			if $g(hash)'="" { $$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock) } // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
			write:display !!,"Unexpected error in CleanSQLIndex^%SYS.SQLSRV():  "_$ze
			do BACK^%ETN
		}
	}
	RETURN
.
/// Delete the SQL Statement Index (SSI) specified by the 'hash' parameter
/// and its related indices...
///
/// This is a helper method of the 'CleanSQLIndex(...)' method with the
/// following assumptions:
/// 
///   - The 'hash' & 'planinfo' parameters are always defined since they 
///     corresponds to a specific SQL Statement Index entry: $$$SQLIndex(1,hash)
///   - Locking has already been acquired prior to calling this helper method
///   - The SQL Statement Index entry does not have any associated
///     routines and therefore no routine indicies: 
///       - '$d($$$SQLIndex(1,hash,"rtn"))
///       - '$d($$$SQLIndex(2,?rtn?,hash))
///
/// Parameters:
///  - hash      :: passed by value, input
///     hash ID of the SQL Statement Index entry to delete
///  - planinfo  :: passed by value, input
///     Information stored in the following node: $$$SQLIndex(1,hash,"planinfo")
///
/// Return value:
///   NONE
///
DeleteSQLIndexEntry(hash,planinfo) // --- Remove the SQL Statement Index and its related indices ---
	set SQLStatementID=$lg($g($$$SQLIndex(1,hash,0)),6)
	set:'$d(planinfo) planinfo=$g($$$SQLIndex(1,hash,"planinfo"))
	
		#; No need to delete the following since they don't exist: $$$SQLIndex(1,hash,"rtn",rtn),$$$SQLIndex(2,rtn,hash)
	set relation=""
	for { // --- Process All 'relation' Values for this SQL Statement Index ---
		set relation=$order($$$SQLIndex(1,hash,"rel",relation)) quit:relation=""  // No more 'relation' values!
		kill $$$SQLIndex(3,relation,hash)  // Kill 'relation' Index!
	}
	
	do:$lg(planinfo,4)'="" DeleteSQLIndexChild($LG(planinfo,4),hash,0)
	kill:SQLStatementID'="" $$$SQLIndex(4,SQLStatementID,hash)  // Kill 'SQLStatementID' Index!
	kill $$$SQLIndex(1,hash)  // Kill SQL Statement Index!
	set day=""
	for  {					// Kill stat/day index entries
		set day=$o($$$SQLIndex(5,hash,"stat",day)) quit:day=""
		kill $$$SQLIndex(6,day,hash)
	}
	kill $$$SQLIndex(5,hash)  // Kill statement stats Index!
	
	RETURN
}
.
.
	// Clean up the SQL index in all namespaces, called from Task Manager
	// If a statement entry says it defined in a routine, but the routine no longer exists, remove that routine from the statement index entry
	//  Arguments:
	//
	// Return value:
	//   Status Code
	//  
CleanSQLIndexTask() [] PUBLIC {
	try {
		#; On a mirror non-primary system we can not write to statement index global from mirror so do nothing
		If $system.Mirror.IsMember(),'$system.Mirror.IsPrimary(),$system.Mirror.GetMemberType()'="Read-Write Reporting" RETURN $$$OK
		do List^%SYS.NAMESPACE(.nslist)
		set namespace="",swapns=0
		for {
			set namespace=$o(nslist(namespace),1,nsdata) quit:namespace=""
			if $listget(nsdata,1)=0  { continue }                // If namespace not enabled skip
			#; See is swapping to this namespace would mount any databases
			kill info
			do GetAllNSInfo^%SYS.NAMESPACE(namespace,.info,1)
			#; If they are not mounted skip doing anything with this data
			if $get(info("GlobalDB","Mounted"))=0||($get(info("RoutineDB","Mounted"))=0) {
				continue
			}
			try {
				if 'swapns new $namespace set swapns=1
				set $namespace=namespace
				if $data(^dummyGlobal)
			} catch {
				continue
			}
			do CleanSQLIndex(0,0)
		}
	} catch ex { 
		set sc=ex.AsStatus()
		do apiOBJ^%ETN(sc)
	}
	QUIT $$$OK
}
.
.
	// Clean up the SQL index for an array of relations
	// If a statement entry says it defined in a routine, but the routine no longer exists, remove that routine from the statement index entry
	// Called from DeleteClassRuntime^%occCLass
	//  Arguments:
	//  - relation  :: passed by reference, input
	//     Array of relations in the form relation(IQN) to clean statement entries for.  IQN format (Upper case internal qualified name)
	//
	// Return value:
	//   none
	//  
CleanSQLIndexRelation(&relation) [SQLCODE,%msg] PUBLIC {
	try {
		if $g($$$SQLIndexVersion)<$$$SQLIndexCurrentVersion { do DeleteEntireSQLIndex() quit }
		set rel=""
		for  {
			set rel=$o(relation(rel)) quit:rel=""
			set hash=""
			for  {
				set hash=$order($$$SQLIndex(3,rel,hash)) quit:hash=""
				$$$lockexclusive($$$SQLIndex(1,hash),$s($zu(115,4)<20:20,1:$zu(115,4)),gotlock)
				CONTINUE:'gotlock
				set rtn=""
				for  {
					set rtn=$o($$$SQLIndex(1,hash,"rtn",rtn),1,rtndata) quit:rtn=""
					set truertn=$lg(rtndata,2,rtn)  ; For UCQ rtn is the container
					if '$d(^rINDEX(truertn,"OBJ")),'$d(^("INT")),'$d(^("MAC")) {
						kill $$$SQLIndex(1,hash,"rtn",rtn)
						kill $$$SQLIndex(2,rtn,hash)
					}
				}
				$$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock)
			}
		}
	} catch {
		try {
			if $ze["<EXTERNAL INTERRUPT" {
					#; If we were interrupted externally, unlock and throw the same EI error
					#; Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
				$$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock)
				throw
			}
			$$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock)
			write:display !!,"Unexpected error in CleanSQLIndex^%SYS.SQLSRV():  "_$ze
			do BACK^%ETN
		} catch {
			if $ze["<PROTECT" {
				quit	// In some mirror databases we don't allow lock/unlock if the db is read-only and not an async member (SML2226)  Don't report this as an error to the caller, and don't try to unlock again
			}
			elseif $ze["<EXTERNAL INTERRUPT" {
					#; If we were interrupted externally in the catch(), unlock and throw the same EI error
					#; Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
				$$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock)
				throw
			}
				#; it should be almost impossible to get here.  An error within the error handler and neither were EI errors, reset setting and release locks and report error
			$$$unlockexclusive($$$SQLIndex(1,hash),I,gotlock)
			write:display !!,"Unexpected error in CleanSQLIndex^%SYS.SQLSRV():  "_$ze
			do BACK^%ETN
		}
	}
	RETURN
}
.
	// Export, in XML format, the SQL Statement Index (SSI) specified by the 'hash'
	// parameter to the specified 'file' parameter...
	//
	// NOTE: The 'SQLStatementID' field, which is recorded in the 6th $LIST(...) 
	//       piece of the following global reference, will be exported 'as is' for
	//       completeness: 
	//         $$$SQLIndex(1,hash,0) ::= ^rINDEXSQL("sqlidx",1,hash,0)
	//       However, this field will be reset to a new/unique value when this
	//       SQL Statement Index is imported via the following method:
	//          ImportSQLStatement(...)
	//
	// Parameters:
	//  - file      :: passed by value, input
	//     The path and file in which to export the SQL Statement Index specified
	//     by the 'hash' parameter.
	//     It's worth noting that the current device, represented by the special
	//     variable $IO, can be specified to output the information to this device,
	//     which in the case of an IRIS terminal is the screen. 
	//  - hash      :: passed by value, input
	//     hash IDKEY for the SQL Statement to export
	//
	// Return value:
	//   Status Code
	//
	// Called From:
	//  - %CSP.UI.Portal.SQL.ExportOutput.CLS  (SMP)
	//      OnPage()
	//        Set tSC = $SYSTEM.SQL.ExportSQLStatement(FileName, Hash)
	//          OR
	//        Set status = ##class(%CSP.UI.System.BackgroundTask).RunTask("SQLExportStatement",$namespace,.tParms,.tItems,.tJob)
	//  - %CSP.UI.System.BackgroundTask.CLS  (SMP)
	//      SQLExportStatement(...)
	//        Set tSC = $System.SQL.ExportSQLStatement(pParms("FileName"), pParms("Hash"))
	//  - %SYSTEM.SQL.Statement.CLS
	//      ExportFrozenPlans(...)
	//        set tSC=$$ExportSQLStatement^%SYS.SQLSRV(Filename,Hash)
	//
ExportSQLStatement(file="",hash="") [] PUBLIC {
.
 	set tSC=$$$OK,$ZE=""
 	
 try {
	if file="" { set tSC=$$$ERROR($$$ObjectScriptError,"The 'file' parameter must be specified") THROW }
	if hash="" { set tSC=$$$ERROR($$$ObjectScriptError,"The 'hash' parameter must be specified") THROW }
.
	if '$$StatementIndexPrivileged^%SYS.SQLSEC(hash) { set tSC=$$$ERROR($$$SQLPrivilege2,"User '"_$username_"' is not privileged for SQL Statement with the specified hash: "_hash) THROW }
	set oref=##class(INFORMATION.SCHEMA.STATEMENTS).%OpenId(hash,,.tSC) THROW:$$$ISERR(tSC)
	if oref="" { set tSC=$$$ERROR($$$ObjectScriptError,"No SQL Statement Index entry exists for the specified hash: "_hash) THROW }
.
	// WQC017 Encode dangerous characters to prevent remote code execution
	if oref.Statement["##(" {
		set oref.Statement = $replace(oref.Statement, "##(", "&#35;&#35;(")
	}
.
	#; --- Write out the 'INFORMATION.SCHEMA.STATEMENTS' Object for the SQL Statement Index - $$$SQLIndex(1,hash) ---
	set writer=##class(%XML.Writer).%New()
	set writer.Charset="UTF-8"
	set writer.Indent=1
	set tSC=writer.OutputToFile(file) THROW:$$$ISERR(tSC)
	set tSC=writer.RootElement("Export generator=""SQLStatementIndex"" version=""1""") THROW:$$$ISERR(tSC)
	set tSC=writer.Object(oref,"Statement") THROW:$$$ISERR(tSC)
	set tSC=writer.EndRootElement() THROW:$$$ISERR(tSC)
 }
 catch {
	set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
 }
	RETURN tSC
}
.
	// Export, in XML format, all of the SQL Statement Index (SSI) entries to the
	// specified 'file' parameter...
	//
	// NOTE: The 'SQLStatementID' field, which is recorded in the 6th $LIST(...) 
	//       piece of the following global reference of an individual entry
	//       specified by the 'hash' variable, will be exported 'as is' for
	//       completeness: 
	//         $$$SQLIndex(1,hash,0) ::= ^rINDEXSQL("sqlidx",1,hash,0)
	//       However, this field will be reset to a new/unique value when each
	//       individual SQL Statement Index is imported via the following method:
	//          ImportSQLStatement(...)
	//
	// Parameters:
	//  - file      :: passed by value, input
	//     The path and file in which to export the entire SQL Statement Index
	//
	// Return value:
	//   Status Code
	//  
	// Called From:
	//  - %CSP.UI.Portal.SQL.ExportOutput.CLS  (SMP)
	//      OnPage()
	//        Set tSC = $System.SQL.ExportAllSQLStatements(FileName)
	//          OR
	//        Set status = ##class(%CSP.UI.System.BackgroundTask).RunTask("SQLExportStatement",$namespace,.tParms,.tItems,.tJob)
	//  - %CSP.UI.System.BackgroundTask.CLS  (SMP)
	//      SQLExportStatement(...)
	//        Set tSC = $System.SQL.ExportAllSQLStatements(pParms("FileName"))
	//  - %SYSTEM.SQL.CLS
	//      ExportAllSQLStatements(...)
	//        QUIT ##class(%SYSTEM.SQL.Statement).ExportAllFrozenPlans(Filename)
	//  - %SYSTEM.SQL.Statement.CLS
	//      ExportAllFrozenPlans(...)
	//        set tSC=$$ExportAllSQLStatements^%SYS.SQLSRV(Filename)
	//
ExportAllSQLStatements(file="") [] PUBLIC {
.
 	set tSC=$$$OK,$ZE=""
 	
 try {
	if file="" { set tSC=$$$ERROR($$$ObjectScriptError,"The 'file' parameter must be specified") THROW }
	
	set writer=##class(%XML.Writer).%New()
	set writer.Charset="UTF-8"
	set writer.Indent=1
	set tSC=writer.OutputToFile(file) THROW:$$$ISERR(tSC)
	set tSC=writer.RootElement("Export generator=""SQLStatementIndex"" version=""1""") THROW:$$$ISERR(tSC)
	
	set hash=""
	for { // --- Process All 'hash' Values ---
		set hash=$o($$$SQLIndex(1,hash))
		QUIT:hash=""  // No more 'hash' values!
		CONTINUE:'$$StatementIndexPrivileged^%SYS.SQLSEC(hash)  // Skip past 'hash' that fails the privilege test!
		
		set oref=##class(INFORMATION.SCHEMA.STATEMENTS).%OpenId(hash,,.tSC)
		CONTINUE:oref=""  // Skip past 'hash' that doesn't have an 'INFORMATION.SCHEMA.STATEMENTS' object
		
		#; --- Write out the 'INFORMATION.SCHEMA.STATEMENTS' Object for the SQL Statement Index - $$$SQLIndex(1,hash) ---
		set tSC=writer.Object(oref,"Statement") THROW:$$$ISERR(tSC)
	}
	set tSC=writer.EndRootElement() THROW:$$$ISERR(tSC)
 }
 catch {
	set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
 }
	RETURN tSC
}
.
	// Import, from an XML format, all of the SQL Statement Index (SSI) entries
	// from the specified 'filename' parameter...
	//
	// NOTE: The 'SQLStatementID' field, which is recorded in the 6th $LIST(...) 
	//       piece of the following global reference of an individual entry
	//       specified by the 'hash' variable, will be reset to a new/unique
	//       value when each individual SQL Statement Index is imported:
	//         $$$SQLIndex(1,hash,0) ::= ^rINDEXSQL("sqlidx",1,hash,0)
	//
	// Parameters:
	//  - filename  :: passed by value, input
	//     The path and file from which to import the entire SQL Statement Index 
	//  - display   :: passed by value, input
	//     1/0 flag.  If 1, display progress to current device
	//
	// Return value:
	//   Status Code
	//  
	// Called From:
	//  - %CSP.UI.Portal.SQL.ImportOutput.CLS  (SMP)
	//      OnPage()
	//        Set tSC = $SYSTEM.SQL.ImportSQLStatement(FileName)
	//          OR
	//        Set status = ##class(%CSP.UI.System.BackgroundTask).RunTask("SQLImportStatement",$namespace,.tParms,.tItems,.tJob)
	//  - %CSP.UI.System.BackgroundTask.CLS  (SMP)
	//      SQLImportStatement(...)
	//        Set tSC = $System.SQL.ImportSQLStatement(pParms("FileName"),0)
	//  - %SYSTEM.SQL.CLS
	//      ImportSQLStatement(...)
	//        QUIT ##class(%SYSTEM.SQL.Statement).ImportFrozenPlans(Filename,Display)
	//  - %SYSTEM.SQL.Statement.CLS
	//      ImportFrozenPlans(...)
	//        set tSC=$$ImportSQLStatement^%SYS.SQLSRV(Filename,Display)
	//
ImportSQLStatement(filename,display=1) [SQLCODE] PUBLIC {
.
	set tSC=$$$OK
	try {
		new %msg,SQLCODE,%SAX
		if $g($$$SQLIndexVersion)<$$$SQLIndexCurrentVersion { do DeleteEntireSQLIndex() }
		write:display !,$$$FormatText($$$Text("Importing SQL Statements from file %1","%SQL.TuneTable"),filename)
		set tTime=$zh
		set tReader = ##class(%XML.Reader).%New()
			#; Prevent parsing of DTDs  Corrects DP-440866 - XXE Vulnerability importing XML files in System Management Portal
		set tReader.SAXFlags=$zboolean(tReader.SAXFlags,$$$SAXVALIDATIONPROHIBITDTDS,7)
		set tSC=tReader.OpenFile(filename)
		quit:$$$ISERR(tSC)
		do tReader.Correlate("Statement","INFORMATION.SCHEMA.STATEMENTS")
	
		for { // --- Process the entire 'filename' ---
			QUIT:'tReader.Next(.tOref,.tSC)  // No more file to process!
			QUIT:$$$ISERR(tSC)  // An error occurred!
			
			write:display !,$$$FormatText($$$Text("Importing SQL Statement with hash ID %1","%SQL.Server"),tOref.Hash)
			set sql=1,sql(1)=$$$StripLeadingWhiteSpace(tOref.Statement)
			kill children
			set child=0
			for {
				set tOrefChildren=tOref.Children.GetNext(.child)
				quit:child=""
				quit:tOrefChildren=""
				set children(tOrefChildren.ParentHash)=""
			}
			set relations="",rel=0
			for {
				set tOrefRelations=tOref.Relations.GetNext(.rel)
				quit:rel=""
				quit:tOrefRelations=""
				set relations=relations_$lb(tOrefRelations.Relation)
			}
			kill privs
			set rel=0
			for {
				set tOrefPrivObjs=tOref.PrivilegeRelations.GetNext(.rel)
				quit:rel=""
				quit:tOrefPrivObjs=""
				set relation=tOrefPrivObjs.Relation
				set actions="",act=0
				for {
					set tOrefPrivActs=tOrefPrivObjs.Actions.GetNext(.act)
					quit:act=""
					quit:tOrefPrivActs=""
					set privs(relation,tOrefPrivActs.Action)=tOrefPrivActs.Fields
				}
			}
			kill plan
			Set tSC=tOref.GetBinaryPlan(.plan)
			QUIT:$$$ISERR(tSC)
			set node0=$lb(tOref.SqlComp,tOref.SQLSchemaPath,tOref.DefaultSchema,tOref.Packages,tOref.Switch,$$GetSQLStatementIDPriv())
			if tOref.Frozen'="",tOref.Timestamp'="",tOref.Version'="" { set planinfo=$lb(tOref.Frozen,tOref.Timestamp,tOref.Version,tOref.ParentHash,tOref.NaturalQuery,tOref.FrozenDifferent,tOref.FrozenScanHash,tOref.FrozenScanVersion) } else { set planinfo="" }
			set stats=$lb(tOref.StatCount,tOref.StatTotal,tOref.StatVariance,tOref.StatFirst,tOref.StatRowCount,tOref.StatCommands)
			//SaveSQLIndexImport(pHash,&pSQL,pRelations,&pPlan,&pPrivs,pNode0,pPlanInfo,pStatementVersion="",pCodeContainer="RTN",children) [SQLCODE] PUBLIC {
			set tSC=$$SaveSQLIndexImport(tOref.Hash,.sql,relations,.plan,.privs,node0,planinfo,tOref.StatementVersion,,.children,stats)	// tSC here is 1/0.  If error, SQLCODE/%msg are set.
			if 'tSC {
				if display { write !,$$$FormatText($$$Text("An unexpected error occurred importing SQL Statements,  SQLCODE=%1, %msg=%2","%SQL.Server"),$g(SQLCODE),$g(%msg)) }
				set tSC=$$$ERROR($$$SQLCode,$g(SQLCODE),$g(%msg))
				quit
			}
		}
		write:display !!,$$$FormatText($$$Text("Import completed in %1 seconds","%SQL.Server"),$zh-tTime)
	}
	catch(ex) {
		set tSC=ex.AsStatus()
		if display do DisplayError^%apiOBJ(tSC)
	}
	QUIT tSC
}
.
	// Delete all SQL Index entries in this namespace.  
	// We only call this if the internal index version number is higher than the one defined on disk.
	// This gives us a way to wipe out all index entries, even if frozen, because we have changed the internal structures of the statement index
	// Returns 1 if success, 0 if there is an error.  If 0, check SQLCODE/%msg for error information
DeleteEntireSQLIndex() [SQLCODE] PRIVATE {
	set return=1
	try {
		$$$lockexclusive($$$SQLIndexVersion,$s($zu(115,4)<20:20,1:$zu(115,4)),gotlock)
			// If we got the lock, make sure someone else didn't already Delete the Entire SQL Index.  If the index is still stale, delete it
		if gotlock {
				#; If the entire index does not exist, just set the version
			if '$d($$$SQLIndexRoot) { set $$$SQLIndexVersion=$$$SQLIndexCurrentVersion }
			if $g($$$SQLIndexVersion)<$$$SQLIndexCurrentVersion {	// recheck to make sure statement index is still stale
				kill $$$SQLIndexRoot
				set $$$SQLIndexVersion=$$$SQLIndexCurrentVersion
			}
			$$$unlockexclusive($$$SQLIndexVersion,I,gotlock)
		}
		else {
			// failed to acquire the lock.
			if $g($$$SQLIndexVersion)<$$$SQLIndexCurrentVersion {	// recheck to make sure statement index is still stale.  If not stale, someone other process handled this
				set SQLCODE=-114,%msg=$$$FormatText($$$Text("Unable to acquire exclusive lock to delete entire SQL Statement Index. System:Instance: %1, Namespace: %2, $Job: %3","%SQL.Server"),$system,$namespace,$job),return=0
			}
		}
	} catch {
		try {
			$$$unlockexclusive($$$SQLIndexVersion,I,gotlock) // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after lock timeout and before setting gotlock=0, but unlocking again should not hurt
			if $ze["<PROTECT" {}	// Ignore <PROTECT> errors, user does not have permission to write to SQL index, so this entry will not be updated
			else { throw }
		} catch {
			if $ze["<PROTECT" { quit }	// Ignore <PROTECT> errors, might get <PROTECT on the [un]lock if this is a read-only non-asynch mirror member
			$$$unlockexclusive($$$SQLIndexVersion,I,gotlock) // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after lock timeout and before setting gotlock=0, but unlocking again should not hurt
			throw
		}
	}
	RETURN return
}
.
/// *** SQL Stats Collection Logic ***
/// When a process executes SQL it records stats such as time, commands, global references for the execution of the SQL logic
/// These stats are recorded in the process context object $SYSTEM.SQL.Context().Stats
/// In a process that is actively executing SQL, stats are aggregated about every 60 seconds
/// Stats are also aggregated when the $SYSTEM.SQL.Context() object is closed (typically when the process halts), or when $SYSTEM.SQL.Context().SaveStats() is called.
/// When a process's stats are aggregated, they are copied into the ^|"%SYS"|%sqlcq(0) global by calling AggregateStats^%SYS.SQLSRV()
/// There are cases when Stats cannot be Aggregated from the process to the system:
/// - When Switch 13 is set
/// - On a mirror non-primary system (Statement Index global is not writable)
/// - If the process has Stats collection disabled (when $SYSTEM.Context.SQL().DisableStatsCollection=1)
/// 
/// The aggregated stats stay in the ^|"%SYS"|%sqlcq(0) global until they are processed by a WorkQueue Daemon that updates the Stats in the SQL Statement Index
/// This WQM task is called %UpdateSQLStats and runs one per hour.
/// 
/// If you would like to make sure your process's SQL stats that have been collected are forced into the SQL Statement Index entries more often, you should:
/// - do $SYSTEM.Context.SQL().SaveStats()
/// - do UpdateSQLStats^%SYS.SQLSRV()
///
#; Take the statistics from $system.Context.SQL().Stats and move it to the statement hash buffer to be aggregated later by a daemon process
AggregateStats() public {
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	Try {
		Set context=$system.Context.SQL(),gbls=$$$GlobalRefs
		If $order(context.Stats(0))=""||(context.DisableStatCollection) Goto exit
		GOTO:$SYSTEM.Util.GetSwitch(13) exit  // GOTO exit if global sets and kills are suspended!
		$$$SuspendAllTrans(transuspend)
		#; On a mirror non-primary system just drop the stats as we can not write to statement index global from mirror 
		If $system.Mirror.IsMember(),'$system.Mirror.IsPrimary(),$system.Mirror.GetMemberType()'="Read-Write Reporting" GOTO exit
		Set index=$increment($$$CQrootsys(0,0))
		#; This lock protects against UpdateSQLStats being called while we are merging data into this
		$$$lockexclusive($$$CQrootsys(0,index),0,gotlock)
		goto:'gotlock exit
		Try {
			Merge $$$CQrootsys(0,index)=context.Stats
			#; Set this node to actual time when the data was recorded for SAM so it will know when it has scanned back far enough in the window of $$$CQrootsys(0,index) nodes to get a SQL query count figure
			Set $$$CQrootsys(0,index,0,0)=$zutil(99)
			Set $$$CQrootsys(0,-1)=$ztimestamp
		} Catch {}
		$$$unlockexclusive($$$CQrootsys(0,index),I,gotlock)
	} Catch {
			#; If we got an error just unlcok (if needed) and ignore it as the stats are optional and not required.
		try {
			$$$unlockexclusive($$$CQrootsys(0,index),I,gotlock)
			set $ze=""	// error has been processed, clear $ze
		} catch {
			if $ze'["<PROTECT" { $$$unlockexclusive($$$CQrootsys(0,index),I,gotlock) }
			set $ze=""	// error has been processed, clear $ze
		}
	}
exit	Kill context.Stats
	If $data(transuspend) $$$ResumeAllTrans(transuspend)
	Set context.Stats=$$$SQLStatNextAggregateTime,context.Stats(0)=$horolog
	#; Subtrack out globals referenced here as these are non-deterministic
	Try {
		Set context=##class(%SYSTEM.Context).WorkMgr()
		Set context.GlobalReferences=context.GlobalReferences+gbls-$$$GlobalRefs
	} Catch {	  // Ignore errors due to failure to load context object in HALT processing
		set $ze=""	// error has been processed, clear $ze
	}
}
.
/// MRP1328: Documentation:
/// Update the SQL Runtime Statistics, which are collected and stored for aggregation via the
/// 'AggregateStats()' method.  The 'AggregateStats()' method populates the following database
/// global from the statistics sored in the specified '$SYSTEM.Context.SQL().Stats'
/// structure:
///
///    $$$CQrootsys(...) = ^|"%SYS"|%sqlcq(...)
///
///    $$$CQrootsys(0,0)=index #                             // Index Counter
///    $$$CQrootsys(0,index)=$SYSTEM.Context.SQL().Stats     // Merge the entire .Stats structure into this global node
///    $$$CQrootsys(0,index)=$zu(99)+60                      // Next Aggregate Time [$ZDT($HOROLOG,-2)] with milliseconds [When to invoke AggregateStats^%SYS.SQLSRV()]
///    $$$CQrootsys(0,index,0)=$HOROLOG                      // $horolog when last aggregation happened
///    $$$CQrootsys(0,index,0,0)=$zu(99)                     // Aggregate Time [$ZDT($HOROLOG,-2)] with milliseconds [When we last aggregated stats]
///    $$$CQrootsys(0,index,ns,hash)=$LIST(...)
///                   1) Counter                     SUM(Counter)
///                   2) TimeSpent                   SUM(TimeSpent)
///                   3) SumSqTime                   SUM(TimeSpent**2)
///                   4) RowCount                    SUM(RowCount)
///                   5) Commands                    SUM(Commands)
///    $$$CQrootsys(0,-1)=$ZTIMESTAMP
///    $$$CQrootsys(0,-2,ns,index)=$$$CQrootsys(0,index,0)   // $HOROLOG
///    $$$CQrootsys(0,-2,ns,index)=$$$CQrootsys(0,index,ns)  // Merged Data
///
///    $$$CQrootsys(ns,2,path,className,cqName)=""           // path=$zu(12,"") from the 'ns' Namespace
///                     ,"LastPrepare",cqName)=$HOROLOG      // Creation/Compilation Timestamp
///                     ,"Package",packageName,className,cqName)=""
///                     ,"QueryRoutine",cqName)=$LB(...)     // Cached Query Routine Details
///                     ,"QueryText",cqName)=Stmt Lines      // The number of SQL Statement Lines
///                     ,"QueryText",cqName,sqlStatementLine)="SQL Stmt text"
///						,"Stale",cqName)=$zu(188)			 // Time the CQ was marked as stale
///
UpdateSQLStats(forceucqpurge=0,skiprecent=0) PUBLIC {
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	RETURN:$SYSTEM.Util.GetSwitch(13) $$$OK  // QUIT if global sets and kills are suspended!
	
	Try {
		#; Once a day see if we can purge embedded SQL style cache queries
		If (+$horolog)'=$get($$$CQrootsys(0,0,"purgeCached"))||(forceucqpurge) {
			Set $$$CQrootsys(0,0,"purgeCached")=+$horolog
			Do purgeCachedQueries(.lastseen)
		}
		#; On a mirror non-primary system just drop the stats as we can not write to statement index global from mirror
		If $system.Mirror.IsMember(),'$system.Mirror.IsPrimary(),$system.Mirror.GetMemberType()'="Read-Write Reporting" {
			If $data($$$CQrootsys(0)) { Kill $$$CQrootsys(0) }
			RETURN $$$OK
		}
.
			#; if somehow we have not upgraded to the correct stats data form version, do so now
		if +$g($$$SQLIndex("statsversion"))<2 {
			set sc=$$ConvertSIStatsV2()
			RETURN:$$$ISERR(sc) sc
		}
		Set updated=$get($$$CQrootsys(0,-1))
		New $namespace
			#; stoptime is to allow a window of results from the last minute we delay aggregating so this data is available for SAM.
			#; See logic in SYS.Monitor.SAM.Sensors.SQL.cls, the $$$CQrootsys(0,index) node is set to $zu(99) after which we collect this data.
			#; By subtracting a minute we leave this data for SAM
		Set stoptime=$select(skiprecent:$zu(99)-60,1:"")
		Set horolog=$horolog
		Set index=0
		Set cache=0  ; Flag to use the cache and update stats in the cache rather than writing back to statement index immediately
		for { // --- Process 'AggregateStats()' Statistics for All 'index' Values ---
			Set index=$order($$$CQrootsys(0,index),1,ts) Quit:index=""
			Lock +$$$CQrootsys(0,index):0 continue:'$test
			Lock -$$$CQrootsys(0,index)#"I"
			Set time=$get($$$CQrootsys(0,index,0))
				#; If this entry is too recent leave it for SAM to record, we will grab it on next UpdateSQLStats run
			If ts'="",stoptime'="",ts>stoptime { CONTINUE }
			Set namespace=0
			for { // --- Process 'AggregateStats()' Statistics for All 'namespace' Values ---
				Set namespace=$order($$$CQrootsys(0,index,namespace)) Quit:namespace=""
				Set swapns=$$swapNS(namespace,.lastseen)
				If swapns'="" {
						#; If we have not seen/mounted this namespace in over 7 days we will purge SQL stat data associated with this
					If swapns'>7 {
							#; Else move the data to be collected when namespace is visible, putting this indexed by namespace avoids overhead
							#; scanning these under multiple 'index' nodes every time we try to collect stats.
						Merge $$$CQrootsys(0,-2,namespace,index)=$$$CQrootsys(0,index,namespace)
						Set $$$CQrootsys(0,-2,namespace,index)=time
					}
				} Else {
					Set hash=""
					for { // --- Process 'AggregateStats()' Statistics for All Cached Query (SQL Statement) 'hash' Values ---
						set hash=$order($$$CQrootsys(0,index,namespace,hash),1)
						QUIT:hash=""  // No more 'hash' values!
						
							#; --- Retrieve All 'AggregateStats()' Statistics Data under the 'hash' Node ---
						kill data set data=""
						merge data=$$$CQrootsys(0,index,namespace,hash)
						do updateStat(hash,.data,$s(time="":$HOROLOG,1:time),.cache)
					}
				}
			}
			Kill $$$CQrootsys(0,index)
		}
			#; Now scan for any data from namespaces that were not visible earlier
		Set namespace=""
		for { // --- Process 'AggregateStats()' Statistics for All 'namespace' Values ---
			Set namespace=$order($$$CQrootsys(0,-2,namespace)) Quit:namespace=""
			Set swapns=$$swapNS(namespace,.lastseen)
			If swapns="" {
				Set index=0
				for { // --- Process 'AggregateStats()' Statistics for All 'index' Values ---
					Set index=$order($$$CQrootsys(0,-2,namespace,index),1,time) Quit:index=""
					Set hash=""
					for { // --- Process 'AggregateStats()' Statistics for All Cached Query (SQL Statement) 'hash' Values ---
						set hash=$order($$$CQrootsys(0,-2,namespace,index,hash),1)
						QUIT:hash=""  // No more 'hash' values!
						
							#; --- Retrieve All 'AggregateStats()' Statistics Data under the 'hash' Node ---
						kill data set data=""
						merge data=$$$CQrootsys(0,-2,namespace,index,hash)
						do updateStat(hash,.data,time,.cache)
					}
				}
				Kill $$$CQrootsys(0,-2,namespace)
			} ElseIf swapns>7 {
					#; If namespace not seen in over 7 days remove the SQL stat information
				Kill $$$CQrootsys(0,-2,namespace)
			}
		}
		Kill index
		Set $$$CQrootsys(0)=updated
	} Catch ex {
		Set sc=ex.AsStatus()
		Do apiOBJ^%ETN(sc)
	}
	Do WriteSIcache(.cache)
	if $get(index)'="" { Lock -$$$CQrootsys(0,index)#"I" }
	RETURN $$$OK
}
.
#; Write the statement index cache back to the global
#;
#; %cache - This is the same structure as $$$SQLIndex(1) statement index global. It also has:
#; 	%cache(ns) = permission on this database to avoid checking it multiple times
#; 	%cache = number of distinct entries we have loaded into the cache
#; Called from:
#;	- updateStat
#;	- UpdateSQLStats
WriteSIcache(%cache) {
	new %ns
		#; Now merge the data back to the statement index, only update nodes that are different to minimize journal traffic
	set %ns=""
	for {
		set %ns=$order(%cache(%ns)) QUIT:%ns=""
		set node=$name(%cache(%ns)),statementgbl=$extract($name($$$SQLNSIndex(5)),1,*-1),nodelen=$length(node)
		for {
			set node=$query(@node,1,data) QUIT:node=""||($qs(node,1)'=%ns)
			set gbl=statementgbl_$extract(node,nodelen,*)
			try {
				if $get(@gbl)'=data set @gbl=data
			} catch {
				; ignore errors here
			}
		}
			#; Now we have written all the stats back check if the statement index entry was removed after we updated the stats, 
			#; get rid of the data we just set into the "stat" node of the SSI (done after the set to avoid race condition)
		set hash=""
		for {
			set hash=$order(%cache(%ns,hash)) quit:hash=""
			if '$data($$$SQLNSIndex(1,hash,0)) { kill $$$SQLNSIndex(5,hash,"stat") }
				#; Make sure the day index is populated
			set day=""
			for  {
				set day=$o($$$SQLIndex(5,hash,"stat",day)) quit:day=""
				set:'$d($$$SQLIndex(6,day,hash)) $$$SQLIndex(6,day,hash)=""
			}
		}
	}
	kill %cache
	set %cache=0
	RETURN
}
.
/// Update the SQL Statistics for a given Namespace (ns) and SQLIndexHash (hash)...		//MRP1314
UpdateSQLStatsByHash(ns = "",hash = "") [] PUBLIC {
	RETURN $$UpdateSQLStatsByHashPRIV(ns,hash)
}
/// UpdateSQLStatsByHash(...) [Private Method]											//MRP1314
UpdateSQLStatsByHashPRIV(ns = "",hash = "") [] PRIVATE {
	new %objlasterror
	
	set tSC=$$$OK
.
	$$$AddAllRoleTemporary
	RETURN:$SYSTEM.Util.GetSwitch(13) $$$OK  // QUIT if global sets and kills are suspended!
.
 try {
	if hash="" { set tSC=$$$ERROR($$$ObjectScriptError,"The 'hash' parameter must be specified") THROW }
	set:ns="" ns=$NAMESPACE $$$changeNamespaceIfNotCurrent(ns)
	
	set index=0
	for { // --- Process All 'index' Values ---
		set index=$order($$$CQrootsys(0,index),1,ts)
		QUIT:index=""  // No more 'index' values!
		CONTINUE:'$d($$$CQrootsys(0,index,ns,hash))  // No new 'stats' are available for the this 'ns' & 'hash'!
		
		lock +$$$CQrootsys(0,index):0 CONTINUE:'$test
		
		set time=$g($$$CQrootsys(0,index,0))
		#; --- Retrieve All 'AggregateStats()' Statistics Data under the 'hash' Node ---
		kill data set data=""
		merge data=$$$CQrootsys(0,index,ns,hash)
		
		do updateStat(hash,.data,$s(time="":$HOROLOG,1:time))
		kill $$$CQrootsys(0,index,ns,hash)
		kill:'$d($$$CQrootsys(0,index,ns)) $$$CQrootsys(0,index)
.
		lock -$$$CQrootsys(0,index)#"I"
		
		if $d($$$CQrootsys(0,-2,ns,index,hash)) { // --- Process data from namespace (ns) that was not visible earlier ---
			set time=$g($$$CQrootsys(0,-2,ns,index))
			#; --- Retrieve All 'AggregateStats()' Statistics Data under the 'hash' Node ---
			kill data set data=""
			merge data=$$$CQrootsys(0,-2,ns,index,hash)
			
			do updateStat(hash,.data,time)
			kill $$$CQrootsys(0,-2,ns,index,hash)
			kill:$o($$$CQrootsys(0,-2,ns,index,""))="" $$$CQrootsys(0,-2,ns,index)
		}
	}
 }
 catch {
	set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
	#; do apiOBJ^%ETN(tSC)
 }
	lock:$get(index)'="" -$$$CQrootsys(0,index)#"I"
	RETURN tSC
}
.
.
/// The 'updateStat(...)' method, along with its public Entry Point method            //MRP1328+
/// 'updateStatPUB(...)', perform the actual SQL Runtime Statistics aggregation...
///
/// These methods are called from the following locations:
///   UpdateSQLStats^%SYS.SQLSRV(forceucqpurge,skiprecent)
///     - do updateStat(hash,.data,$s(time="":$HOROLOG,1:time))
///     - do updateStat(hash,.data,time)
///   UpdateSQLStatsByHash^%SYS.SQLSRV(ns,hash)
///   UpdateSQLStatsByHashPRIV(ns,hash)
///     - do updateStat(hash,.data,$s(time="":$HOROLOG,1:time))
///     - do updateStat(hash,.data,time)
///   recordSQLStatsInStmtIndx^%SYS.PTools(SQLIndexHash,statsHorolog,statsData)
///     - do updateStatPUB^%SYS.SQLSRV(SQLIndexHash,$LIST(statsData,1,3),statsHorolog)
///
/// The 'data' parameter variable/array contains the SQL Runtime Statistics from the
/// following global node:
///   merge data=$$$CQrootsys(0,index,ns,hash)
///
updateStatPUB(hash,&data,horolog) PUBLIC { do updateStat(hash,.data,horolog) } // MRP1142: Public Entry-Point for PTools/SQLStats: recordSQLStatsInStmtIndx^%SYS.PTools(...)
	#; cache - This is the same structure as $$$SQLIndex(1) statement index global. It also has:
	#; cache(ns) = permission on this database to avoid checking it multiple times
	#; cache = number of distinct entries we have loaded into the cache, or "" if we are not using caching
	#;	This is called from recordSQLStatsInStmtIndx^%SYS.PTools
updateStat(hash,&data,horolog,cache) {
	#; This is called from locally:
	#;	- UpdateSQLStats
	#;	- UpdateSQLStatsByHashPRIV
.
	if '$data(cache($namespace,hash)) {
		if '$data($$$SQLIndex(1,hash,0)) {  // The SQL Statement Index (SSI) for the given 'hash' is not yet defined!
			RETURN:$e(hash)'="^" // return if this is not a object insert/delete/update
			do AddObjIUDSQLIndex(hash)
		}
		#; If we don't have WRITE permission on the $$$SQLIndex global, then QUIT because there is nothing to do.
		#; Additionally, we want to avoid getting a PROTECT error since this method is auditted!
		if '$data(cache($namespace),permission) {		
			set gbl=$name($$$SQLIndexRoot)
			set permission=$$GetGlobalPermission^%SYS.SECURITY($namespace,$e($qs(gbl,0),2,*),""""_$qs(gbl,1)_"""",1)
			set cache($namespace)=permission
		}
		RETURN:permission'["WRITE"  // No WRITE permission!
	}
.
		#; if somehow we have not upgraded to the correct stats data form version, do so now
	if +$g($$$SQLIndex("statsversion"))<2 {
		set sc=$$ConvertSIStatsV2()
		RETURN:$$$ISERR(sc)
	}
	
		#; StatsRetentionDays is the number days we should retain stats for this namespace, default is 399 (57 weeks)
		#; Namespace setting -> system setting -> default (57)
	set StatsRetentionDays=$g(^%SYS("sql","sys","SQLStatsRetention",$namespace),$g(^%SYS("sql","sys","SQLStatsRetention"),57))*7
.
		#; --- Aggregate Daily Totals ---
	set day=+horolog,today=+$HOROLOG
	#; //*** FOR TESTING
	#; set day=day-$r(100)
	if $data(cache($namespace,hash,"stat",day),current)#10=0 {
		set (cache($namespace,hash,"stat",day),current)=$g($$$SQLIndex(5,hash,"stat",day))
			#; For first entry for this day check for stale values we can prune
		if current="" {
			for { // --- Spin Through All Day (oldest) Values & Prune Entries Older than 400 Days ---
				set oldest=$order($$$SQLIndex(5,hash,"stat","")) quit:oldest=""  // No more 'oldest' Values!
				if ((today-oldest)<=StatsRetentionDays) { // --- Put Valid 'oldest' Value into a Bucket based on the Week in which it belongs: 1-57 ---
					set bucketWeek=(today-oldest)\7
					if (bucketWeek'=0) { // --- If 'oldest' not in this week, then add it to it's corresponding bucket 'bucket(bucketWeek)' to be pruned later ---
						set paramHash=""
						for { // --- Process All 'paramHash' Values ---
							set paramHash=$order($$$SQLIndex(5,hash,"stat",oldest,"params",paramHash)) quit:paramHash=""  // No more 'paramHash' Values!
							set bucket(bucketWeek,$i(bucket(bucketWeek)))=$LB(oldest,paramHash)
						}
					}
					QUIT  // 'Parameter Pruning' only happens for the first 'oldest' date that matches the following condition: (today-oldest)<400
						#; This won't be a problem if this method gets invoked frequently (daily)
				}
				try {
					kill $$$SQLIndex(5,hash,"stat",oldest),$$$SQLIndex(6,oldest,hash)
				} catch { }  // Ignore Errors!
			}
			set bucketWeek=0
			for { // --- Process Each 'bucket(bucketWeek)' from previous weeks and Prune down to $$$MaxNumParametersPerOlderWeek Per Week ---
				set bucketWeek=$o(bucket(bucketWeek)) QUIT:bucketWeek=""  // No more 'bucketWeek' Values!
				CONTINUE:$g(bucket(bucketWeek))'>$$$MaxNumParametersPerOlderWeek  // Skip if Parameter Count <= Max!
				#; --- Process Random Parameter Sampling ---
				set paramCnt=bucket(bucketWeek) kill randomParam
				for { // --- Process Max Number of Parameter Sampling allowed for Previous Weeks ---
					QUIT:paramCnt'>$$$MaxNumParametersPerOlderWeek  // We've pruned to the Max Number of Parameters to sample for older weeks!
					set randomParam=$random(bucket(bucketWeek))+1
					CONTINUE:$d(randomParam(randomParam))  // 'randomParam' Already Processed!
						#; This does not mess up the 'cache' because we never remove items for 'today' and cache only caches items for today
					kill $$$SQLIndex(5,hash,"stat",$LG(bucket(bucketWeek,randomParam),1),"params",$LG(bucket(bucketWeek,randomParam),2))
					do $i($$$SQLIndex(5,hash,"stat",$LG(bucket(bucketWeek,randomParam),1),"params"),-1)
					set randomParam(randomParam)=1
					do $i(paramCnt,-1)
				}
			}
		}
	}
.
	set $LG(c1,t1,t1sq,r1,cmds1)=data
	RETURN:(c1<=0)||(t1<0)||(r1<0)||(cmds1<0)  // Check to seee if we have sensible numbers to aggregate; Otherwise, skip this step!
	set m1=t1/c1,v1=$select(t1sq="":"",1:t1sq/c1-(m1**2))
	if v1<0 { set v1=0 }  ; Should not be needed, but in case of rounding errors
	if current="" { // --- No Statistics Collected for the Current 'day' ---
		merge newdata("params")=data("params")
		set newdata=$lb(c1,t1,v1,r1,cmds1)
	} else { // --- Statistics Collected for the Current 'day' ---
		#; --- Aggregate Day Totals ---
		set $LG(c2,t2,v2,r2,cmds2)=current
		RETURN:(c2<=0)||(t2<0)||(r2<0)||(cmds2<0)  // Check to seee if we have sensible numbers to aggregate; Otherwise, skip this step!
		set m2=t2/c2
		if $data(cache($namespace,hash,"stat",day,"params"))\10=0 {
			merge cache($namespace,hash,"stat",day,"params")=$$$SQLIndex(5,hash,"stat",day,"params")
			merge current("params")=cache($namespace,hash,"stat",day,"params")
		}
		do updateParams(.data,.current,.newdata) // Aggregate 'Parameter Sampling' statistics!
		set total=t1+t2,count=c1+c2,mean=total/count,rowcount=r1+r2,commands=cmds1+cmds2
		set variance=(c1*(v1+((m1-mean)**2)))+(c2*(v2+((m2-mean)**2)))/count
		set newdata=$LB(count,total,variance,rowcount,commands)
	}
	
	#; // *** FOR TESTING set hour=$p(horolog,",",2)\3600
	#; set hour=$r(86400)\3600
	set hour=$p(horolog,",",2)\3600
	kill current
	if $data(cache($namespace,hash,"stat",day,hour),current)#10=0 set (cache($namespace,hash,"stat",day,hour),current)=$g($$$SQLIndex(5,hash,"stat",day,hour))
	if current="" { // --- No Statistics Collected for the Current 'day' & 'hour' ---
		set newhourdata=$lb(c1,t1,v1,r1,cmds1)
	} else { // --- Statistics Collected for the Current 'day' & 'hour' ---
		#; --- Aggregate Hourly Totals ---
		set $LG(c2,t2,v2,r2,cmds2)=current
		RETURN:(c2<=0)||(t2<0)||(r2<0)||(cmds2<0)  // Check to seee if we have sensible numbers to aggregate; Otherwise, skip this step!
		set m2=t2/c2
		set total=t1+t2,count=c1+c2,mean=total/count,rowcount=r1+r2,commands=cmds1+cmds2
		set variance=(c1*(v1+((m1-mean)**2)))+(c2*(v2+((m2-mean)**2)))/count
		set newhourdata=$LB(count,total,variance,rowcount,commands)
	}
	
	#; --- Now Aggregate Grand Total Values ---
	if $data(cache($namespace,hash,"stat"),current)#10=0 {
		set (cache($namespace,hash,"stat"),current)=$g($$$SQLIndex(5,hash,"stat"))
		if $get(cache)'="" { do $increment(cache) }  ; Count how many distinct cache entries we are using
	}
	if current="" { // --- No Statistics Collected for the Current SQL Statement Index (SSI) ---
		set newtotaldata=$lb(c1,t1,v1,day,r1,cmds1)
	} else { // --- Statistics Collected for the Current SQL Statement Index (SSI) ---
		#; --- Aggregate Grand Totals ---
		set $LG(c2,t2,v2,first,r2,cmds2)=current
		RETURN:(c2<=0)||(t2<0)||(r2<0)||(cmds2<0)  // Check to seee if we have sensible numbers to aggregate; Otherwise, skip this step!
		set m2=t2/c2
		set total=t1+t2,count=c1+c2,mean=total/count,rowcount=r1+r2,commands=cmds1+cmds2
		set variance=(c1*(v1+((m1-mean)**2)))+(c2*(v2+((m2-mean)**2)))/count
		set newtotaldata=$LB(count,total,variance,first,rowcount,commands)
	}
	set cache($namespace,hash,"stat")=newtotaldata
	merge cache($namespace,hash,"stat",day)=newdata
	set cache($namespace,hash,"stat",day,hour)=newhourdata
	if $get(cache)="" {
		try {
			merge $$$SQLIndex(5,hash,"stat")=cache($namespace,hash,"stat")
				#; If this entry was removed after we updated the stats, get rid of the data we just set into the "stat" node of the SSI (done after the set to avoid race condition)
			kill:'$data($$$SQLIndex(1,hash,0)) $$$SQLIndex(5,hash,"stat")
			set day=""
			for  {
				set day=$o(cache($namespace,hash,"stat",day)) quit:day=""
				set $$$SQLIndex(6,day,hash)=""
			}
		} catch {
			#; If we can't write to the global, just ignore this step!
		}
	} elseif $get(cache)#10000=0 {
		#; If we get 10,000 distinct cache entries then flush the cache to avoid using too much memory
		do WriteSIcache(.cache)
	}
}
.
/// This method performs 'Parameter Sampling' statistics aggregation...
///
updateParams(&data,&current,&newdata) PUBLIC {
	merge newdata=current
	RETURN:'$d(data("params")) $$$OK
	
	set paramHash=""
	for { // --- Process All 'paramHash' Values ---
		set paramHash=$o(data("params",paramHash),1,value)
		QUIT:paramHash=""  // No more 'paramHash' values!
		
		if $d(current("params",paramHash,"stats")) { // --- Aggregate 'data("params",paramHash,"stats")' & 'current("params",paramHash,"stats")' ---
			set newdata("params",paramHash,"stats")=$LB($LG($g(data("params",paramHash,"stats")),1)+$LG(current("params",paramHash,"stats"),1),$LG($g(data("params",paramHash,"stats")),2)+$LG(current("params",paramHash,"stats"),2))
		} elseif (($g(newdata("params")))<$$$MaxNumParametersPerDay) { // --- Collect 'data("params",paramHash,"stats")' for up to $$$MaxNumParametersPerDay Parameters ---
			merge newdata("params",paramHash)=data("params",paramHash)
			do $i(newdata("params"))
		} 
	}
	RETURN $$$OK
}
.
#; Swap to 'namespace' if possible. It avoids mounting namespaces that are not already mounted
#; and it returns the number of days since we have been able to use this namespace so the caller
#; can purge old data if the namespace has not been accessed in a long while.
#; The 'lastseen' is a local array passed by reference to cache some information if this is being called
#; a large number of times. If it was able to swap to the new namespace it returns "".
swapNS(namespace,lastseen) PUBLIC {
	If $get(lastseen(namespace))'="" RETURN lastseen(namespace)
	Set failed=0
	If namespace'=$namespace {
		#; See is swapping to this namespace would mount any databases
		If '$data(lastseen(namespace)) {
			Do GetAllNSInfo^%SYS.NAMESPACE(namespace,.info,1)
			#; If they are not mounted skip doing anything with this data
			If '$get(info("GlobalDB","Mounted"))||('$get(info("RoutineDB","Mounted"))) Set failed=1
		}
		Try {
			Set $namespace=namespace If $data(^dummyGlobal)
		} Catch {
			Set failed=1
		}
	}
	If failed {
		If '$data($$$CQrootsys(0,0,"lastseen",namespace),date) {
			Set date=+$horolog,$$$CQrootsys(0,0,"lastseen",namespace)=date
		}
		Set lastseen(namespace)=(+$horolog)-date
	} Else {
		Set lastseen(namespace)=""
		Kill:$data($$$CQrootsys(0,0,"lastseen",namespace)) $$$CQrootsys(0,0,"lastseen",namespace)
	}
	RETURN lastseen(namespace)
}
.
#; If there are new stats to aggregate then job off a process to do this
CheckAggregateStats() public {
	#; Nothing new so nothing to do
	If $get($$$CQrootsys(0))=$get($$$CQrootsys(0,-1)) RETURN
	Try {
		Set lock=0
		Lock +$$$CQrootsys(0):0 Else  Quit
		Set lock=1
		If $get($$$CQrootsys(0))=$get($$$CQrootsys(0,-1)) Quit
		#; If aggregation task is already running just return
		Lock +%ISCUpdateSQLStats:0 Else  Quit
		Lock -%ISCUpdateSQLStats#"I"
		$$$AddAllRoleTemporaryInTry
		Set $$$CQrootsys(0)=$get($$$CQrootsys(0,-1))
		Job UpdateSQLStats(0,1)
	} Catch err {}
	If lock Lock -$$$CQrootsys(0)#"I"
	If $isobject($get(err)) Throw err
	RETURN
}
.
#; Determine if the SQL statement with 'hash' has the same plan as the frozen plan or has it change
#; Sets 'sameplan' to 1 if the plan is the same 0 if it is different and -1 if it could not determine if it is difference due to locking problem
SamePlan(hash,sameplan) [backgrnd] public {
	Set $ztrap="err"
	New %plan,backgrnd
	Set gotlock=0,sc=$$$OK,backgrnd=1
	Lock +$$$SQLIndex(1,hash):$zu(115,4) If '$test {
		Set sameplan=-1
		Goto exit
	}
	Set gotlock=1,sameplan=1
	#; If no plan data then it is always the same
	If '$data($$$SQLIndex(1,hash,"plan")) {
		Goto exit
	}
	#; If parallel query skip or plan not frozen
	Set planinfo=$get($$$SQLIndex(1,hash,"planinfo"))
	If $case($listget(planinfo,1),3:1,0:1,:0) {
		Goto exit
	}
	#; If already flagged as different to frozen plan we are done
	If $listget(planinfo,6) Set sameplan=0 Goto exit
.
	Merge sqllines=$$$SQLIndex(1,hash,1)
	Set info=$get($$$SQLIndex(1,hash,0))
	
	Do ShowPlan^%apiSQL(.sqllines,1,1,0,$listget(info,4),$listget(info,2),0,$listget(info,5))
	
	#; Now we have the frozen plan we can unlock and obtain the non-frozen plan
	Lock -$$$SQLIndex(1,hash)#"I" Set gotlock=0
	For i=1:1:%plan {
		Set line=%plan(i)
		If line'="<Frozen Plan/>" Set oldplan($increment(oldplan))=line
	}
	Kill %plan
	
	Do ShowPlan^%apiSQL(.sqllines,1,1,0,$listget(info,4),$listget(info,2),0,$listget(info,5),1)
	If $get(oldplan)'=$get(%plan,-1) Set sameplan=0 Goto exit
	For i=1:1:oldplan {
		If oldplan(i)'=%plan(i) Set sameplan=0 Quit
	}
.
exit	If gotlock Lock -$$$SQLIndex(1,hash)#"I"
	Quit sc
err	Set $ztrap=""
	Set sc=$$$ERROR($$$ObjectScriptError,$zerror)
	Goto exit
}
.
#; Function to be called to scan frozen plans looking if they would produce different plans now compared
#; to the frozen plan. This is scheduled to be run by the task manager and it will only run for a period of
#; time before exiting. If it exits without finishing its work it will remember where it left off so it can
#; continue from this point.
ScanPlans() public {
	RETURN:$SYSTEM.Util.GetSwitch(13) $$$OK  // QUIT if global sets and kills are suspended!
	
	#; On a mirror non-primary system we can not write to statement index global from mirror so do nothing
	If $system.Mirror.IsMember(),'$system.Mirror.IsPrimary(),$system.Mirror.GetMemberType()'="Read-Write Reporting" RETURN $$$OK
	Set sc=$$$OK,$ztrap="err"
	#; Determine when we will automatically stop running
	Set stop=$zh+$$$SQLRunFrozenPlanCheck
	$$$AddAllRoleTemporary
	Set swapns=0
	Lock +%ISCCheckSQLPlans:0 If '$test RETURN $$$OK
	Set batch=$zu(68,25,1)
	Do List^%SYS.NAMESPACE(.nslist,3,0,1,0)
	Set lastpos=$get(^%SYS("sql","sys","lastfrozenplanpos")),namespace=$listget(lastpos,1),hash=$listget(lastpos,2)
	Set first=(namespace'=""&&(hash'=""))
	For {
		If 'first {
			Set namespace=$order(nslist(namespace),1,nsdata) Quit:namespace=""
			#; If namespace not enabled skip
			If $listget(nsdata,1)=0 Continue
		} Else {
			Set first=0
		}
		Try {
			If 'swapns Set swapns=1 New $namespace
			Set $namespace=namespace If $data($$$SQLIndexRoot)
		} Catch {
			Continue
		}
		Set gotlock=0
		For {
			#; See if we should stop processing now
			If $zh>stop GOTO exit
			Set hash=$order($$$SQLIndex(1,hash)) Quit:hash=""
			Do StatementSame(hash)
		}
		Write !
	}
exit Do $zu(68,25,batch)	
	Set ^%SYS("sql","sys","lastfrozenplanpos")=$listbuild(namespace,hash)
	Lock -%ISCCheckSQLPlans#"I"
	RETURN sc
err	Set $ztrap=""
	Set sc=$$$ERROR($$$ObjectScriptError,$zerror)
	GOTO exit
}
.
#; Deterine if this statement is the same as the frozen plan or not and update the flags based on this
#; same is passed by reference and returns -1 if we can not check item and 0,1 based on if the frozen
#; plan is the same as current plan
StatementSame(hash,same,force=0) public {
	Set same=1
		#; Only wait for 1s or we will come back to this another time anyway
	try {
		$$$lockexclusive($$$SQLIndex(1,hash),1,gotlock)
	} catch {
			#; Any error attempting to acuire the lock, just return,
			#; Most likely errors are <PROTECT> or <EXTERNAL INTERRUPT>
		RETURN
	}
	RETURN:'gotlock
	
	Set relationhash=""
	Try {
		#; If no plan data then nothing to do
		If '$data($$$SQLIndex(1,hash,"plan")) Goto exit
		#; If parallel query skip or plan not frozen nothing to do
		Set planinfo=$get($$$SQLIndex(1,hash,"planinfo"))
		If $case($listget(planinfo,1),3:1,0:1,:0) Goto exit
		#; If natural query no point checking
		If $listget(planinfo,5) Goto exit
		#; If already flagged with frozen is different plan nothing to do
		If $listget(planinfo,6) Set same=0 Goto exit
		#; If we have a parent query do not do anything here as we will check this child when we check the parent associated with this
		If $listget(planinfo,4)'="" Goto exit
		#; Check version of Cache when we checked this, if it is different then we automatically want to scan again
		If 'force,$listget(planinfo,8)=$system.Version.GetNumber() {
			Set relationhash=$$statementRelationHash(hash)
			If $listget(planinfo,7)=relationhash Goto exit
		}
		#; Release the lock to avoid holding it while checking plan which could take a long time
		Set gotlock=0 Lock -$$$SQLIndex(1,hash)#"I"
.
		Do recursiveSame(hash,.same)
		#; If failed to compare plans skip
		If same=-1 Goto exit
		
		#; Re-obtain the lock so we can write the results
		Lock +$$$SQLIndex(1,hash):$zu(115,4) Set gotlock=$test
		If 'gotlock Goto exit
		Set newplaninfo=$get($$$SQLIndex(1,hash,"planinfo"))
		If $listget(planinfo,2)'=$listget(newplaninfo,2) {
			#; Plan timestamp has changed while we were unlocked so just skip this entry
			Goto exit
		}
		If relationhash="" Set relationhash=$$statementRelationHash(hash)
		Set newdata=$listbuild('same,relationhash,currentver)
		Set $list($$$SQLIndex(1,hash,"planinfo"),6,8)=newdata
	} Catch {
		lock -$$$SQLIndex(1,hash)#"I"
		Throw
	}
exit
	lock -$$$SQLIndex(1,hash)#"I"
	RETURN
}
.
#; Recusively check this statement and all its child statements are the same
recursiveSame(hash,same) {
	Set sc=$$SamePlan(hash,.same)
	If same=-1||(same=0) Quit
.
	#; If this is a parent then let's check its children to see if they have different frozen plans
	Set child=""
	For {
		Set child=$order($$$SQLIndex(1,hash,"child",child)) Quit:child=""
		Do recursiveSame(child,.same)
	}
}
.
#; Construct a hash based on all the classes this statement depends on and their timestamps, if all the same we do not need to process this
statementRelationHash(hash) {
	Do statementRelationClasses(hash,.classlist)
	Set hash=""
	Set class=""
	For {
		Set class=$order(classlist(class)) Quit:class=""
		Set hash=hash_$lb(class,$listget($get(^rINDEXCLASS($zconvert(class,"U")))),$listget($get(^rINDEX($$$nameClassRoutineNameGet(class,0),"OBJ"))))
	}
	RETURN $zstrip($system.Encryption.Base64Encode($zcrc(hash,9)),">","=")
}
.
#; Return a list of classes this query and all child queries depend on
statementRelationClasses(hash,classlist,visited) {
	Set visited(hash)=""
	Set rel=""
	For {
		Set rel=$o($$$SQLIndex(1,hash,"rel",rel)) Quit:rel=""
		Set iqn=$$$GetExactIQNFromIQN(rel)
		If iqn="" {
			#; Might me a TVF
			Set classname=""
			Do IsATVF^%qTable(rel,.schema,.table,.classname,.classTS)
		} Else {
			Set classname=$$$GetClassNameFromIQN(rel)
		}
		If classname'="" {
			Set classlist(classname)=""
		}
	}
	#; Include child queries in hash
	Set child=""
	For {
		Set child=$order($$$SQLIndex(1,hash,"child",child)) Quit:child=""
		If '$data(visited(child)) Do statementRelationClasses(child,.classlist,.visited)
	}
.
}
.
	// Using the current UTC time ($ZTIMESTAMP), return the number of minutes offset for the local server time
	// An assumption is made that utc and local time are never more than 24 hours apart
UTC2LocalTimeOffset() [] PUBLIC {
	set utc=$ztimestamp,local=$zdatetimeh(utc,-3)
	set utcdate=+utc,utctime=$p(utc,",",2),localdate=+local,localtime=$p(local,",",2)
	if utcdate=localdate { RETURN (utctime-localtime)\60 }           // assume offset is not under 1 min
	if utcdate>localdate { RETURN ((utctime+86400)-localtime)\60 }   // utc is already tomorrow, add a day' worth of seconds to utctime
	RETURN (utctime-(localtime+86400))\60                            // localtime is already tomorrow, add a day' worth of seconds to localtime
}
.
ResourceCleanup() public {
	$$$AddAllRoleTemporary
	New $namespace
	Set $namespace = "%SYS"
	Try {
		#; Only one cleanup task at a time
		Lock +%ISCResourceCleanup:0 Else  Return $$$OK
		#; Walk resources checking each job if it still exists or not, if it does not free resources it had
		#; registered as long as they are over a minute old
		Set killstate=$zu(68,28,0)
		
		Set hash=""
		For {
			Set hash=$order(^IRIS.TempNodes(hash)) Quit:hash=""
			Set job=""
			For {
				Set job=$order(^IRIS.TempNodes(hash,job)) Quit:job=""
				If job="." CONTINUE   ; Skip over padding node
				If $zutil(67,3,job)=0 {  ; Process no longer exists
					Set nodelist="",userlist=""
					For type="gbl","event","semaphore" {
						Set node=""
						For {
							Set node=$order(^IRIS.TempNodes(hash,job,type,node),1,data) Quit:node=""
							Set time=$lg(data),user=$lg(data,2)
							If $zutil(99)-time>60||(+time=0) {
								Set cleaned=0
								#; Over a minute old so remove it
								If type="gbl"||(type="queue") {
									If $extract(node,1)="^",$case($extract(node,2), "|":0, "[":0, :1),$lg(data,3)'="" {
										Set tmpnode = "^|"""_$li(data,3)_"""|"_$extract(node,2,*)
									} Else {
										Set tmpnode = node
									}
									If type="queue" {
										Try { Do ##class(%SYS.Queue).QueueState(@tmpnode,2),##class(%SYS.Queue).QueueState(@tempnode,3) } Catch {}
										Set cleaned=1
									}
									If $data(@tmpnode) {
										Try { Kill @tmpnode Set cleaned=1 } Catch {}
									}
								} ElseIf type="event" {
									Try { If $system.Event.Defined(node) Do $system.Event.Delete(node) Set cleaned=1 } Catch {}
								} ElseIf type="semaphore" {
									Try {
										Set semaphore=##class(%SYSTEM.Semaphore).%New()
										If semaphore.Open(node) {
											Do semaphore.Delete()
											; Do not log we cleaned semaphore as we free all semaphores here now
										}
										Kill semaphore
									} Catch {}
								}
								Kill ^IRIS.TempNodes(hash,job,type,node)
								If cleaned {
									Set nodelist=nodelist_type_":"_node_","
									If (","_userlist)'[(","_user_",") Set userlist=userlist_user_","
								}
							}
						}
					}
					#; Report resources we had to cleanup unless the silent flag is set for jobs we know we forced down in WQM
					If $get($$$TempNodeReleaseSilent(job)) {
						If '$data(^IRIS.TempNodes(hash,job)) Try { Kill $$$TempNodeReleaseSilent(job) } Catch {}
					} ElseIf nodelist'="" {
						$$$SevereMsg("ResourceCleanup: Dead job cleanup from '"_$extract(userlist,1,*-1)_"' job '"_job_"' of '"_$extract(nodelist,1,*-1)_"'")  ; Log to messages.log file
					}
				}
			}
		}
.
		// JMM1151 - Check all sharding tempfiles for ones that need to be recycled
		d recycleTempfiles^%SYS.SHARDSRV()
	} Catch ex {
		Set sc=ex.AsStatus()
		Do apiOBJ^%ETN(sc)
	}
exit	Lock -%ISCResourceCleanup#"I"
	Do $zu(68,28,killstate)
	Quit $$$OK
}
.
	// In each namespace, perform backfill filing for any deferred records for all class/tables
	// Note, this does not perform backfill filing for %DEFER inserted records, it is up to the application to file those.
	// 
DeferredFilingBackfill(display=0) [] PUBLIC {
	try {
		write:display !,"Retrieving list of namespaces..."
		do List^%SYS.NAMESPACE(.nslist)
		set namespace="",swapns=0
		for {
			set namespace=$o(nslist(namespace),1,nsdata) quit:namespace=""
			if $listget(nsdata,1)=0  { continue }                // If namespace not enabled skip
				#; See is swapping to this namespace would mount any databases
			kill info
			do GetAllNSInfo^%SYS.NAMESPACE(namespace,.info,1)
				#; If they are not mounted skip doing anything with this data
			if $get(info("GlobalDB","Mounted"))=0||($get(info("RoutineDB","Mounted"))=0) { continue }
			try {
				if 'swapns new $namespace set swapns=1
				set $namespace=namespace
				if $data(^dummyGlobal)
				write:display !,"Building Deferred for namespace "_$namespace
			} catch {
				continue
				write:display !,"Namespace "_$namespace_" is not accessible.  Error: "_$ze
			}
			set class=""
			for {
				set class=$o(^rINDEXEXT("D",class)) quit:class=""
				try {
					set meta=$g(^rINDEXEXT("D",class,-1E19)),$lg(flag1,flag2,flag3,lastBFTS)=meta
					set classname=$p(class,"^",1)	// Shard local classes will be indexed as classname^shard#
					set backfillInterval=$parameter(classname,"DEFERREDBACKFILLINTERVAL")
					continue:'backfillInterval	// A value of 0 means no automated backfilling is performed for this table
					if ($zu(99,0)-lastBFTS)<backfillInterval { 	// Not time to start a backfill yet
						write:display !,"too soon for BACKFILL of class: "_classname_", "_($zu(99,0)-lastBFTS)_" since last BACKFILL"
						continue
					}
					if flag1 {	// %BuildDeferred already in progress for this class
						write:display !,"BACKFILL of class: "_classname_", skipped because %BuildDeferred already in progress"
						continue
					} elseif flag2 { // or bulk load is in progress
						write:display !,"BACKFILL of class: "_classname_", skipped because BULK LOAD is in progress for this table"
						continue
					} elseif flag3 { //  or table is locked
						write:display !,"BACKFILL of class: "_classname_", skipped because the class/table is class"
						continue
					}	
					write:display !,"Building Deferred for class: "_classname
					set sc=$classmethod(classname,"%BuildDeferred",0,0,0)
				} catch ex {
					set sc=ex.AsStatus()
					do apiOBJ^%ETN(sc)
					write:display !,"Building Deferred for classname "_class_" got an error: "_$$$GETERRORCODE((sc)_" "_$$$GETERRORMESSAGE(sc))
					continue	// try next class
				}
			}
		}
	} catch ex {
		set sc=ex.AsStatus()
		do apiOBJ^%ETN(sc)
	}
	RETURN $$$OK
}
.
	// Regenerate "Stale" cached statements in all namespaces
	//
	// Return value:
	//   Status Code
	//  
RegenerateStaleCQs() [] PUBLIC {
	try {
		do List^%SYS.NAMESPACE(.nslist)
		set namespace="",swapns=0
		for {
			set namespace=$o(nslist(namespace),1,nsdata) quit:namespace=""
			if $listget(nsdata,1)=0  { continue }                // If namespace not enabled skip
				#; See is swapping to this namespace would mount any databases
			kill info
			do GetAllNSInfo^%SYS.NAMESPACE(namespace,.info,1)
				#; If they are not mounted skip doing anything with this data
			if $get(info("GlobalDB","Mounted"))=0||($get(info("RoutineDB","Mounted"))=0) { continue }
			try {
				if 'swapns new $namespace set swapns=1
				set $namespace=namespace
				if $data(^dummyGlobal)
			} catch {
				continue
			}
			set cqclass=""
			for {
				set cqclass=$o($$$CQ("Stale",cqclass)) quit:cqclass=""
				set sc=$SYSTEM.SQL.RegenerateQuerySource(cqclass)
				if $$$ISERR(sc) { do PurgeRtn^%SYS.SQLSRV(cqclass) }
			}
		}
	} catch ex { 
		set sc=ex.AsStatus()
		do apiOBJ^%ETN(sc)
	}
	RETURN $$$OK
}
.
	// Regenerate "Stale" cached statements in this namespace
	//
	// Return value:
	//   Status Code
	//  
	// Called via WorkQueueMgr from:
	//	- DeleteExtentCQ^%SYS.SQLSRV
	//	- %occCompile
	//	- %qarTune
RegenerateStaleCQsSingleNS() [] PUBLIC {
	try {
			#; Only one process will execute this code at a time
		set sc=$$$OK
		lock +^IRIS.Temp.RegenCQ:0 else  goto end
			// grab a snapshot of what is currently stale to reduce the number of stale cached statements that are currently being compiled
		do {
			kill stale merge stale=$$$CQ("Stale")
.
			quit:'$d(stale)
		
			set cqclass=""
			for {
				set cqclass=$o(stale(cqclass)) quit:cqclass=""
.
				set sc=$$RegenerateQuerySource(cqclass,0)	// Do not Purge on error.  Allow another retry to regenerate in the future
				if $$$ISERR(sc) {
					hang .1
					if '$d($$$CQ("QueryRoutine",cqclass)) {	// CQ no longer defined
						continue
					}
					set sc=$$RegenerateQuerySource(cqclass,0)	// Try again
					if $$$ISERR(sc) {
						hang .1
						continue:'$d($$$CQ("QueryRoutine",cqclass))	// CQ no longer defined
						set sc=$$RegenerateQuerySource(cqclass,1)	// Try again (max 3 tries)
							#; We tried 3 times to purge the CQ and it failed 3 times.  Assume the CQ cannot be recompiled and Purge it
						if $$$ISERR(sc) { do PurgeRtn(cqclass,1,$namespace) }
					}
				}
			}
		} while $d($$$CQ("Stale"))=11
	} catch ex { 
		set sc=ex.AsStatus()
		do apiOBJ^%ETN(sc)
	}
	lock -^IRIS.Temp.RegenCQ#"I"
end	RETURN $$$OK
}
.
	// Given an xDBC cached statement classname, regenerate/recompile the cached statement definition
	// If PurgeOnError is TRUE, if there is an error regenerating, we will Purge the cached query
	// Returns a %Status code
RegenerateUCQ(classname,PurgeOnError=1,keepSource="") [sqltext,SQLCODE] PUBLIC {
	try {
		new %IRISSQLCachedCompileOnly,%msg,%qacn,%qfun,%qrc,%qsc,SQLCODE,sqltext
		set purge=0,%qacn=1,sc=$$$OK
		if '$d($$$CQ("QueryText",classname)) { set purge=1,sc=$$$ERROR($$$CachedQueryDefinitionMissing,classname,"QueryText") quit }
		if '$d($$$CQ("QueryRoutine",classname),QRdata) { set purge=2,sc=$$$ERROR($$$CachedQueryDefinitionMissing,classname,"QueryRoutine") quit } 
		set version=$lg(QRdata,1)
		// w !?60,classname,?80,version
		if version=11 {	// UCQ cached statement stores QueryText in ()=# of lines, (1)=line 1, ...
			merge sqltext=$$$CQ("QueryText",classname)
			set sqltext(0)=sqltext
		} else {
			set purge=3 quit // other CQ types do not support Regenerate via this API
		}
		set $lg(cqversion,,,,,,,,,,,,,,caller,callerinf,sqlcompile,colprop,return,ansiPrecedence,delimitedIdentifiers,issys)=$$$CQ("QueryRoutine",classname)	// $lb(version,cls,$h,clist,0,0,"",cls,dblist,10, 0 , 0, 0, utcoffset,caller,callerinf,sqlcompile,colprop,return,ansiPrecedence,delimitedIdetifiers,issys)
		if $system.Context.SQLCompile().ANSIPrecedence'=ansiPrecedence {
			set saveAnsiPrecedence=$system.Context.SQLCompile().ANSIPrecedence
			set $system.Context.SQLCompile().ANSIPrecedence=ansiPrecedence
		}
		if $system.Context.SQLCompile().DelimitedIdentifiers'=delimitedIdentifiers {
			set saveDelimitedIdentifiers=$system.Context.SQLCompile().DelimitedIdentifiers
			set $system.Context.SQLCompile().DelimitedIdentifiers=delimitedIdentifiers
		}
		#; if $zu(115,2)'=isolationLevel { set saveIsolationLevel=$zu(115,2,isolationLevel) }
		set %IRISSQLCachedCompileOnly=1
eloop	set stalets=$g($$$CQ("Stale",classname))	// timestamp for when the CQ was last defined as stale
		do buildEmbeddedDirect(.sqltext,.sqlcompile,.sqldata,.colprop,caller,callerinf,classname,issys,return,keepSource,1,args...)
		if $g(SQLCODE)<0 {	// compilation failed
			set purge=4,sc=$$$ERROR($$$SQLError,SQLCODE,$g(%msg))
		}
		if $d($$$CQ("Stale",classname),newstalets),stalets'=$g(newstalets) { // CQ is still stale, but was marked stale again during Regen
			goto eloop
		}
		kill $$$CQ("Stale",classname) 	// Regeneration is ok, unmark as Stale 
	} catch {
		set purge=4,sc=$$$ERROR($$$ObjectScriptError,$ze)
	}
	if purge,PurgeOnError { 
		// if purge=1 { w !?50,"QueryText is not defined" }
		// if purge=2 { w !?50,"QueryRoutine is not defined" }
		// if purge=3 { w !?50,"version is not supported" }
		// if purge=4 { w !?50,"error trap "_$ze }
		do PurgeRtn(classname)
	}
	if $d(saveAnsiPrecedence) { set $system.Context.SQLCompile().ANSIPrecedence=saveAnsiPrecedence }
	if $d(saveDelimitedIdentifiers) { set $system.Context.SQLCompile().DelimitedIdentifiers=saveDelimitedIdentifiers }
	#; if $d(saveIsolationLevel) { do $zu(115,2,saveIsolationLevel) }
	RETURN sc
}
.
#; Called when our call to embedded SQL cached class fails, generally we need to build a new implementation and then call it
#; sqltext   - array of SQL lines
#; sqlcompile	- $lb(switch,%sqlAudit,%sqlSchemaPath,imports,parallel-flag,%msqlvarcparm,objfiler,mcurs,modvar) // last to only if currentof statement
#; colprop		- only defined for DEC
#; caller		- %qarmac's caller
#; return		- Whether or not to return a value, 1 for DEC
#; args...
#; Called from %qarmac
BuildQuery(&sqldata,sqlcompile,colprop,caller,return=0,args...) [SQLCODE] public {
	#; As GetCurrent walks load frames this should always be the last but one routine loaded even though it may be a few $zu(41) levels down
	Set callerinf=$system.RTN.GetCurrent(1)
#;$ZR may have been last set when the process had escalated privileges. Guard against <PROTECT> error here.
	d
	. $$$AddAllRoleTemporary
	. s zr=$ZR
	Merge sqltext=sqldata("S")
	Set sqltext=$order(sqltext(""),-1)
	Set calledfromsys=($zutil(96,10)=$zutil(12))
	set isRTQuery = $D(sqldata("RTPCUtility"))
	set nolock=+$get(sqldata("NL"))
	#; Obtain the classname, this returns an expression to evaluate
	Set cls=$$EmbedCls^%qarmac(.sqltext,caller,sqlcompile,.issys,calledfromsys,isRTQuery,nolock)
	New %cls
	Set @("%cls="_cls)
	Set cls=%cls
		#; Flag to force the UCQ from this tag to be deleted
	If $get(%IRISSQLCachedDelete) {
		If cls'="",$$$defClassDefined(cls) Do Delete^%apiOBJ(cls,"-d-l")
		RETURN ""
	}
	#; If query does no have %NOLOCK already include current isolation level and build query for this case
	If ('nolock)&&('isRTQuery) {
		set sqltext=$o(sqltext(""),-1)+1,sqltext(sqltext)=" /*#OPTIONS { ""IsolationLevel"":"_$$$ProcessIsolationLevel_" } */"
		set sqldata("NL") = 1
	}
	#; We used to check if the class already exists before building it again if $get(%IRISSQLCachedCompileOnly) but users expect
	#; class to be compiled if this flag is set all the time and it fixes a problem in statement index.
.
	#; Loop max three times so we may build a query only to have it immediately out of date in which case we will build another one, but we
	#; will not do this more than three times before reporting an error.
	For i=1:1:3 {
		If '$$buildEmbeddedDirect(.sqltext,.sqlcompile,.sqldata,.colprop,caller,callerinf,cls,issys,return,,,args...) Goto exit
		If $get(%IRISSQLCachedCompileOnly) RETURN ""   ; So we can compile the query without calling it
		#; Try to restore $zr but if it fails most code does not need this.
		Do
		. $$$AddAllRoleTemporary
		. Try { Set $zr=zr } Catch {}
		Try {
			If return {
				RETURN $classmethod(cls,"%New",args...)
			} else {
				Do $classmethod(cls,"%New")
				RETURN
			}
		} Catch exception {
			#; Need to detect <CLASS DOES NOT EXIST> and the table up to date error as special as these allow us to try building query again
			If $classname(exception)="%Exception.SystemException" {
				If $zerror[cls,($zerror["<CLASS DOES NOT EXIST>"&&($zerror[$zname))||($zerror["<ZSQLU>") {
					If '$data(%sqlcachedqueryrtninfo) New %sqlcachedqueryrtninfo Set %sqlcachedqueryrtninfo="force"
					CONTINUE
				}
			}
			#; Convert unexpected exception to SQL error and exit
			Set SQLCODE=-400,%msg=$$$FormatText($$$Text("Unexpected error compiling embedded SQL cached query: %1. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),exception.AsSQLMessage(),$system,$namespace,$job)
			Goto exit
		}
	}
	Set SQLCODE=-400,%msg=$$$Text("Unable to build embedded SQL cached query after three attempts","%SQL.Server")_$select($data(exception):": "_exception.AsSQLMessage(),1:"")
exit	If return { RETURN "" } Else { RETURN }
}
.
#; Build embedded SQL cached query for none cursor query
#; RETURNS - 0 if an error happened (it also sets SQLCODE/%msg) and 1 if we were able to build the class or someone else did
#; sqltext		- sqltext=#lines, sqltext(1)=line 1, ...
#; sqlcompile	- $lb(switch,%sqlAudit,%sqlSchemaPath,imports,parallel-flag,%msqlvarcparm,objfiler,mcurs,modvar) // last to only if currentof statement
#; includes		-
#; colprop		- only defined for DEC
#; caller		- %qarmac's caller
#; callerinf	- $system.RTN.GetCurrent(1) - for routine the SQL is nocated in
#; cls			- cached statement class name
#; pReturn		- Whether or not to return a value, 1 for DEC
#; keepSource
#; regenerate	- 1/0 flag.  0 is default.  1 means this is a regeneration of a UCQ
#; args...
#; Called from BuildQuery
buildEmbeddedDirect(&sqltext,&sqlcompile,&includes,&colprop,caller,callerinf,cls,issys,pReturn,keepSource="",regenerate=0,args...) [ SQLCODE,mtc,err ] {
	new %caller,%ISCSNRemoteTables,%sqlSchemaPath,%SourceControl,%caller,err,mtc
	$$$AddAllRoleTemporary
	Set $ztrap="trap"
	$$$SuspendAllTrans(transuspend)
		#; Do not allow <EXTERNAL INTERRUPT> errors around preparing a query as we want to at least compile it before we abort
	set interrupt=##class(%SYSTEM.Util).SetInterruptEnable(0)
	Set return=1
	#; Note, if during this build the caller is deleted/modified it does not matter as the daemon will cleanup the cached query at some point
	#; and implementation does not write anything back to the caller routine
	lock +$$$CQ("Query",$$$CQEmbedVersion,cls):$$$CQGetLockTO
	if '$test { // lock failed
		set SQLCODE=-114,%msg=$$$Text("Lock Timeout attempting to acquire exclusive lock on Universal Cached Query metadata during UCQ creation","%SQL.Server")
		Set return=0
		GOTO finalexit
	}
	set isRTQuery = $D(includes("RTPCUtility"))
	#; Now we have the lock we need to see if someone else recompiled the query already or if we need to.
	#; This is done by passing a public variable with the routine info in it if the invokation fails the
	#; up to date checking, the value is just $system.RTN.GetCurrent() so we need to strip the buffer info
	#; If %IRISSQLCachedCompileOnly=1 we were called from container compilation (or RegenerateUCQ) so we want to force recompilation here
	If '$get(%IRISSQLCachedCompileOnly) {
		If $get(%sqlcachedqueryrtninfo)="force" {
			#; This is case where we already tried to build query once and it failed so ignore $data(^rOBJ(rtn.1)) check as class may be messed up
		} ElseIf $get(%sqlcachedqueryrtninfo)'="" {
			Set rtninfo=%sqlcachedqueryrtninfo
			Kill %sqlcachedqueryrtninfo
			If $ziswide(rtninfo) {
				Set rtninfo=$zwunpack(rtninfo)  ; For 8-bit IRIS
				Set rtninfo=$e(rtninfo,9,*)
				#; If big-endian system swap bytes because $zwunpack swap bytes
				If $ZU(40,0,0) Set rtninfo=$e(rtninfo,2)_$e(rtninfo,1)_$e(rtninfo,4)_$e(rtninfo,3)_$e(rtninfo,6)_$e(rtninfo,5)_$e(rtninfo,8)_$e(rtninfo,7)
			} else {
				Set rtninfo=$e(rtninfo,9,*)
			}
			#; The $system.RTN.GetCurrent always returns data in little endian form so we can do this compare with the routine header in ^rOBJ
			Set rtnheader=$e($get(^rOBJ($$$nameClassRoutineNameGet(cls,1))),1,8)
			If rtnheader'=rtninfo,rtnheader'="" {
				#; Someone else has updated the routine so we should call new implementation
				GOTO exit
			}
		} Else {
			#; If %sqlcachedqueryrtninfo is not set then first call to class did not find it, so check if someone else has created it in the mean time
			If $data(^rOBJ($$$nameClassRoutineNameGet(cls,1))) {
				GOTO exit
			}
		}
	}
	Set $lg(switch,audit,%sqlSchemaPath,imports,parallel,sqlvarcparm,objectfiler,mcurs,modvar)=sqlcompile
	if mcurs'="" {
		#; Dummy values for the parse below so we think the other query is defined, never used as real values used when we compile the class
		#; Specific to WHERE CURRENT OF queries
		set mtc(mcurs,"modvar")=modvar,mtc(mcurs,"modtag")="%tag",mtc(mcurs,"o")=""
	}
		#;  queryType = 0: xDBC Query; queryType = 1: Embedded SQL; queryType = 2: Dynamic SQL;
	set nRTP("qType") = 1
	set nRTP("selectMode") = switch
	if (sqlvarcparm'="") {
		set nRTP("sqlvarcparm") = sqlvarcparm
	}
	set SQLCODE=-$$ParseSQL(.sqltext,$lfs(imports),.nRTP) if SQLCODE set return=0 GOTO exit
	merge qinfo("table")=mtc(0,0,"table")	// We only need the table info in qinfo, not all of mtc
	set stmttype=$$GetType(mtc(0,0,"type"))
	if 'stmttype { set SQLCODE=1,%msg="A valid SQL statement type was expected, statement type '"_mtc(0,0,"type")_"' was found",return=0 GOTO exit }
	set statement=$e(mtc(0,0,"type"),1,3)
	set parallel=$get(mtc(0,0,"parallel"),0)
	
	#; Let's build the cached query class, first remove any old data
	If $data($$$CQ("QueryRoutine",cls)) Do RemoveClassFromCQLib(cls)
	Set sc=$$CreateClass(cls,"Embedded SQL cached statement "_$s($g(nRTP):"(RTPC utility) ",$d(includes("RTPCUtility")):"(RTPC runtime) ",1:"")_"created with server version:",1) If $$$ISERR(sc) Set SQLCODE=-400,%msg=$$GetErrorText^%apiOBJ(sc),return=0 GOTO exit
	Set clslock=1
	
	$$$defClassKeySet(cls,$$$cCLASSfinal,1)
	
	$$$defClassKeySet(cls,$$$cCLASSgeneratedby,$select($e(caller,*-3,*)=".RTN":$e(caller,1,*-4)_".MAC",1:caller))
	$$$defClassKeySet(cls,$$$cCLASSclasstype,$$$cCLASSCLASSTYPESYSTEM)
.
		#; Add include files from tables in the query to includes("I") (like we do for dynamic and xDBC cached queries
		#;  Here we get a list of include files from the class.  These are needed if the user uses
		#;  macro references defined in these files in OdbcToLogical, StorageToLogical, Computed field code, etc.
	set tab=""
	for  {
		set tab=$o(mtc(0,0,"table",tab),1,data) quit:tab=""
		if data'="",$p(data,$c(1),1),$p(data,$c(1),2),'$$$smdIsATVF($p(data,$c(1),1),$p(data,$c(1),2)) { // don't record include files if this "table" is a TVF - no need.
			set data=$p(data,$c(1),4)	// data is now the extentname
			set inc=""
			for  {
				set inc=$$$comClassArrayNext(data,$$$cCLASSincludecodeall,inc) quit:inc=""
				set:inc'="%occSqlfunc" includes("I",inc)=""
			}
		}
	}
		#; Add include files from datatypes of select list items that use non-% datatype classes
	set sel=""
	for  {
		set sel=$o(mtc(0,0,"select",sel)) quit:sel=""
		set data=$g(mtc(0,0,"select",sel,1))
		if data'="" {
			set data=$p(data,$c(1),13)	// data is now the extentname
			set inc=""
			for  {
				set inc=$$$comClassArrayNext(data,$$$cCLASSincludecodeall,inc) quit:inc=""
				set:inc'="%occSqlfunc" includes("I",inc)=""
			}
		}
	}
		#; Add the include files the original routine/class had
	set includes="",inc="",removedincs=""
	for {
		set inc=$order(includes("I",inc)) quit:inc=""
		#; If one of the includes is no longer available at runtime try compiling with no includes but remember we did this so we can report an error
		if '$data(^rINC(inc)) {
			set removedincs=removedincs_inc_","
		}
		set includes=includes_inc_","
	}
	if includes'="",removedincs="" $$$defClassKeySet(cls,$$$cCLASSincludecode,$e(includes,1,*-1))
.
	set code=0,argsStr=""
	
	if $G(nRTP) {
		$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHprocedureblock,1)
		$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHreturntype,$select(pReturn:"%RegisteredObject",1:"%Status"))
		
   		if (nRTP("params")'="") {
	   		$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHpubliclist,nRTP("params"))
	   	}
		$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHclassmethod,0)
		
		// check random sig
		if '$g(parallel) {
			set clist="",cnt=0,ii=""
			for  {
				set ii=$o(qinfo("table",ii)) quit:ii=""
				set classname=$p(qinfo("table",ii),$c(1),5)
				continue:$lf(clist,classname)
				if classname'="" {
					Try {
						Set randomsig=$parameter(classname,"%RandomSig")
					} Catch {
						Continue
					}
					if 'cnt {
						$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"new $ET set $ET=""""")
					}
					$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"if "_$$LiteralExpr^%occName(randomsig)_"'=##class("_classname_").#%RandomSig { set %sqlcachedqueryrtninfo=$system.RTN.GetCurrent() ZTRAP ""SQLUPDATE"" }")
					set clist=clist_$lb(classname)
					set cnt=cnt+1
				}
			}
		}
		do:statement="DEC" ProcessColprop(colprop,cls,.code,1,.cursorname,.colvars,.args,.argsStr)
   		
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"try {")
		for i=1:1:nRTP("dispatch-code","rtexpr"){
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_nRTP("dispatch-code","rtexpr",i))
		}
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"} catch SQLrtpcerr{")
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9)_"If $p($p($ze,"">""),""<"",2)'="""" { ")
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_"do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg)")
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_"throw ##class(%Exception.SQL).CreateFromSQLCODE(SQLCODE,%msg)") 
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9)_"} else { ") 
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_"throw SQLrtpcerr")
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9)_"} ") 		
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"} ")
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"set SQLrtpcrthash="""_$E(cls,1,*-27)_"R"_"""_"_$$$Base64SHACode("$lb("""_$E(cls,*-25,*)_""","_nRTP("rtexprStr")_")",26)_$S(pReturn:", SQLrtpcrtQuery=""""",1:""))
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"try {")
		if pReturn {
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9)_" set SQLrtpcrtQuery=$classmethod(SQLrtpcrthash,""%New"""_$REPLACE(argsStr,",.",",")_")")	
		} else{
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9)_"do $classmethod(SQLrtpcrthash,""%New"""_$REPLACE(argsStr,",.",",")_")")
		}
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"} catch SQLrtpcerr{")
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9)_"if $ze[""<CLASS DOES NOT EXIST>""&&($ze[SQLrtpcrthash)||($ze[""<ZSQLU>"") {")
		// write out xxsql
		for i=1:1:nRTP("dispatch-code","sql"){
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),nRTP("dispatch-code","sql",i))
		}
		
		set key=""
		for {
			set key=$O(includes("I",key),1,value) q:key=""			
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_"set SQLrtpcxxsql(""I"","_$$$quote(key)_")="_$S(value'="":$$$quote(value),1:""""""))
		}
		set key=""
		for {
			set key=$O(includes("M",key),1,value) q:key=""			
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_"set SQLrtpcxxsql(""M"","_$$$quote(key)_")="_$s(value=$c(1):"$c(1)",1:$$Quote^%qcr(value)))
		}
		set key=""
		for {
			set key=$O(includes("RT",key),1,value) q:key=""			
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_"set SQLrtpcxxsql(""RT"","_$$$quote(key)_")="_$S(value'="":$$$quote(value),1:""""""))
		}
		if ($G(includes("NS")) '= ""){
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_"set SQLrtpcxxsql(""NS"")="_$$$quote(includes("NS")))	
		}
		if ($G(includes("PToolsCTI")) '= ""){
			set ptr=0,str = "$LB("
   			while $LISTNEXT(includes("PToolsCTI"),ptr,value) {
	  			set str = str_$S($D(value):$$$quote(value),1:"")_","
   			}
   			set str = $E(str,1,*-1)_")"
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_"set SQLrtpcxxsql(""PToolsCTI"")="_str)
		}
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_"set SQLrtpcxxsql(""RTPCUtility"")=$classname()")
		if ($G(includes("NL")) '= "") {
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_"set SQLrtpcxxsql(""NL"")="_+$g(includes("NL")))
		}
		set ptr=0,str = $S(pReturn:"set SQLrtpcrtQuery=$$",1:"d ")_"BuildQuery^%SYS.SQLSRV(.SQLrtpcxxsql,$LB("
		while $LISTNEXT(sqlcompile,ptr,value) {
	  		set str = str_$S($D(value):$$$quote(value),1:"")_","
   		}
   		
		set str = $E(str,1,*-1)_"),"_$S($D(colprop):$$$quote(colprop),1:"")_","_$S($D(caller):$$$quote(caller),1:"")_","_(+pReturn)_argsStr_")"
		
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_str)
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9)_"} elseif $p($p($ze,"">""),""<"",2)'="""" { ")
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_"do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg)")
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_"throw ##class(%Exception.SQL).CreateFromSQLCODE(SQLCODE,%msg)") 
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9)_"} else { ") 
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9,9)_"throw SQLrtpcerr")
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9)_"} ") 
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"}")
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"quit "_$S(pReturn:"SQLrtpcrtQuery",1:"$$$OK"))
		$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,code)
		do GenerateRTPCHelperMethod(cls,"%Construct",.nRTP)
	} else {
		$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHprocedureblock,0)
		if pReturn,isRTQuery {
			$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHreturntype,"%RegisteredObject")
		} else {
			$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHreturntype,"%Status")
		}
		
		$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHclassmethod,0)
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),"#EXECUTE s %msqlvar=""i%%""")
		#; If UCQ class lives in IRISSYS database need to make sure caller is from here also, if not throw PROTECT error
		if issys { $$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"if '$$FromIRISSYS^%SYS.SQLSRV() do $zu(96,3,32,1)") }
		set killvars=""
		if sqlvarcparm'="" { $$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),"#EXECUTE s %msqlvarcparm="_$$$QuoteName(sqlvarcparm)) set killvars=killvars_"%msqlvarcparm," }
		if switch'="" { $$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),"#sqlcompile select="_switch) }
		if audit'="" { $$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),"#sqlcompile audit="_audit) }
		if %sqlSchemaPath'="" { $$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),"#sqlcompile path="_$lts(%sqlSchemaPath)) }
		if imports'="" { $$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),"#import "_imports) }
		if objectfiler'="" { $$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),"#EXECUTE s %msqlObjectFiler="_$$$QuoteName(objectfiler)) set killvars=killvars_"%msqlObjectFiler," }
		if mcurs'="" { $$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),"#EXECUTE s %msqlCurrentOf="_$$$QuoteName(modvar)) set killvars=killvars_"%msqlCurrentOf," }
		merge %ISCSNRemoteTables=includes("RT")
		set macro="",set=""
		for {
			set macro=$order(includes("M",macro),1,macdata) quit:macro=""
			#; Rather than trying to regenerate the '#define' just set the macro array directly
			set set=set_"%sqlrmac("_$$$QuoteName(macro)_")="_$$Quote^%qcr(macdata)_","
			if $l(set)>120 $$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),"#execute s "_$e(set,1,*-1)) set set=""
		}
		if set'="" {
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),"#execute s "_$e(set,1,*-1))
			set set=""
		}
		if '$g(parallel),'isRTQuery {
			set clist="",cnt=0,ii=""
			for  {
				set ii=$o(qinfo("table",ii)) quit:ii=""
				set classname=$p(qinfo("table",ii),$c(1),5)
				continue:$lf(clist,classname)
				if classname'="" {
					Try {
						Set randomsig=$parameter(classname,"%RandomSig")
					} Catch {
						Continue
					}
					if 'cnt {
						$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"new $ET set $ET=""""")
					}
					$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"if "_$$LiteralExpr^%occName(randomsig)_"'=##class("_classname_").#%RandomSig { set %sqlcachedqueryrtninfo=$system.RTN.GetCurrent() ZTRAP ""SQLUPDATE"" }")
					set clist=clist_$lb(classname)
				}
			}
		}
		
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"&sql"_$$$CQSQLMarker_"(")
		for ii=1:1:sqltext {
			if '$data(sqltext(ii),text) QUIT
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9,9)_text)
		}
		$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_")"_$$$CQSQLMarkerR)
		
		#; Add cursor based properties needed and FETCH method
		if statement="DEC" {
			do ProcessColprop(colprop,cls,.code,0,.cursorname,.colvars,.args)
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"&sql"_$$$CQSQLMarker_"(OPEN "_cursorname_")"_$$$CQSQLMarkerR)
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"")
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"RETURN $s(SQLCODE=0:$$$OK,1:$$$ERROR($$$SQLCode,SQLCODE,$g(%msg)))")
			for propnum=1:1:colvars {
				$$$defMemberSet(cls,$$$cCLASSproperty,"sqlcol"_propnum,"")
				$$$defMemberKeySet(cls,$$$cCLASSproperty,"sqlcol"_propnum,$$$cPROPtype,"%RawString")
			}
			#; Generate fetch logic into 'FET' method
			set fet=0
			$$$defMemberKeySet(cls,$$$cCLASSmethod,"FET",$$$cMETHprocedureblock,0)
			$$$defMemberKeySet(cls,$$$cCLASSmethod,"FET",$$$cMETHclassmethod,0)
			$$$defMemberKeySet(cls,$$$cCLASSmethod,"FET",$$$cMETHreturntype,"")
			$$$defMemberKeySet(cls,$$$cCLASSmethod,"FET",$$$cMETHplaceafter,"%Construct")
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"FET",$$$cMETHimplementation,$i(fet),$c(9)_"&sql"_$$$CQSQLMarker_"(FETCH "_cursorname_")"_$$$CQSQLMarkerR)
			$$$defMemberKeySet(cls,$$$cCLASSmethod,"FET",$$$cMETHimplementation,fet)
			#; Generate close logic into destructor
			set destruct=0
			$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Destruct",$$$cMETHprocedureblock,0)
			$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Destruct",$$$cMETHclassmethod,0)
			$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Destruct",$$$cMETHreturntype,"%Status")
			$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Destruct",$$$cMETHplaceafter,"%Construct")
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Destruct",$$$cMETHimplementation,$i(destruct),$c(9)_"if '$g(i%CursorState) RETURN $$$OK")  ; Do not report an error if already closed cursor
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Destruct",$$$cMETHimplementation,$i(destruct),$c(9)_"&sql"_$$$CQSQLMarker_"(CLOSE "_cursorname_")"_$$$CQSQLMarkerR)
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Destruct",$$$cMETHimplementation,$i(destruct),$c(9)_"RETURN $$$OK") ; If an SQL error happens we can still return $$$OK as the destruct worked and the caller will be checking SQLCODE/%msg anyway
			$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Destruct",$$$cMETHimplementation,destruct)
		} Else {
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"RETURN $$$OK")
		}
		if killvars'="" $$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),"#EXECUTE k "_$extract(killvars,1,*-1))
		
		$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,code)
	}
	Set ts=$zutil(188)
	$$$defClassKeySet(cls,$$$cCLASStimechanged,ts)
	Do RebuildItemIndex^%R(cls,"CLS")
	Do UnlockOneClass^%occLock(cls,3,1)	Set clslock=0 // We locked the class in CreateClass, unlock should never fail
	set utcoffset=$$UTC2LocalTimeOffset()
	set $$$CQ("QueryRoutine",cls)=$listbuild($$$CQEmbedVersion,cls,$h,,0,0,"",cls,,10,0,0,0,utcoffset,caller,callerinf)  ; Need this to point statement index at caller location
	#; If we record PTools stats for PTools tables we can get into infinite loops
	set disablestats=($extract(caller,1,12)="%SYS.PTools.")
	if disablestats {
		$$$setSQLStatsFlagOFF(oldstats)  // Turn OFF/Disable SQLState for current JOB
	} else { // --- Set {SQLStats-flag} (System/JOB) to the Compile-time Value ---
		set SQLStatsFlagComp=$LG($g(includes("PToolsCTI")),2) set:SQLStatsFlagComp="" SQLStatsFlagComp=$$$getSQLStatsFlag // Default to the current SQLStats-flag (SYS/JOB) Value if '$LG(includes("PToolsCTI"),2)' not specified!
		if $$$isSQLStatsFlagTypeSystemValue(SQLStatsFlagComp) { // --- Process Compile-time {SQLStats-flag} (System) ---
			set:($$$getSQLStatsFlagForSystem)'=SQLStatsFlagComp SQLStatsFlagCompSYS=$$SetSQLStatsFlag^%SYS.PToolsUtil("",SQLStatsFlagComp) // Set {SQLStats-flag} (System)
			set:($$$getSQLStatsFlagForJob)'=$$$getSQLStatsFlagZEROJob SQLStatsFlagCompJOB=$$SetSQLStatsFlag^%SYS.PToolsUtil(1,0)           // Set {SQLStats-flag} (JOB) to use {SQLStats-flag} (System) settings
		} else { // --- Process Compile-time {SQLStats-flag} (JOB) ---
			set:($$$getSQLStatsFlagForJob)'=SQLStatsFlagComp SQLStatsFlagCompJOB=$$SetSQLStatsFlag^%SYS.PToolsUtil("",SQLStatsFlagComp)    // Set {SQLStats-flag} (JOB)
		}
	}
	#; Compile 'issys' and %SYS queries that include none-% includes in %SYS namespace
	set swapns=($get(includes("NS"))="%SYS")&&($namespace'="%SYS")&&($namespace'="BUILDSYS")
	do
	  #; Preserve smd around namespace swap for ShowPlan else it records mt/asl but smd can get rebuilt due to namespace swap and nothing matches
	. If swapns { New $namespace Set $namespace="%SYS" Kill ^||%sql.smdtmp Merge ^||%sql.smdtmp=^||%sql.smd }
	. Set SQLCODE=$$compileCls(cls,keepSource,regenerate)
	. If swapns { Kill ^||%sql.smd Merge ^||%sql.smd=^||%sql.smdtmp Kill ^||%sql.smdtmp }
	if disablestats {
		$$$resetSQLStatsFlag(oldstats)   // Reset SQLStats-flag for current JOB to original value
	} else { // --- Reset {SQLStats-flag} (System/JOB) to its Original Value ---
		set:$d(SQLStatsFlagCompSYS) SQLStatsFlagCompSYSreset=$$SetSQLStatsFlag^%SYS.PToolsUtil("",SQLStatsFlagCompSYS) // Reset {SQLStats-flag} (System)
		set:$d(SQLStatsFlagCompJOB) SQLStatsFlagCompJOBreset=$$SetSQLStatsFlag^%SYS.PToolsUtil("",SQLStatsFlagCompJOB) // Reset {SQLStats-flag} (JOB)
	}
	if SQLCODE {
		kill $$$CQ("QueryRoutine",cls),$$$CQ("QueryText",cls)
		set return=0
		if removedincs'="" set %msg="Include files not present at runtime '"_$e(removedincs,1,*-1)_"' from namespace '"_$namespace_"' must be available at runtime and compile time which was in namespace '"_$get(includes("NS"))_"' class compile error without includes '"_$get(%msg,"<unknown>")_"'"
		GOTO exit
	}
	merge $$$CQ("QueryText",cls)=sqltext
	do SetExtInfo(.qinfo,cls,.clist,.dblist)
	; $$$CQ("QueryRoutine",rtn) = $lb(version,cls,$h,clist,0,0,"",cls,dblist,10, 0 , 0, 0, utcoffset,caller,callerinf,sqlcompile,colprop,return)
	set $$$CQ("QueryRoutine",cls)=$listbuild($$$CQEmbedVersion,cls,$h,clist,0,0,"",cls,dblist,10,0,0,0,utcoffset,caller,callerinf,sqlcompile,colprop,pReturn,$system.Context.SQLCompile().ANSIPrecedence,$system.Context.SQLCompile().DelimitedIdentifiers,issys)
		#; store date last prepared last (so purge doesn't see this routine until it is complete)
	set $$$CQ("LastPrepare",cls)=$h
	set:$d(includes("RTPCUtility")) $$$CQ("RTQ",includes("RTPCUtility"),cls)="",$$$CQ("RTQ2",cls)=includes("RTPCUtility")
	
	#; If parallel sub-query record parents name so this child will be purged if parent is removed
	if parallel {
		set $$$CQ("RTQ",$select($e(caller,*-3,*)=".RTN":$e(caller,1,*-4),1:$e(caller,1,*-4)_".1"),cls)=""
		set $$$CQ("RTQ2",cls)=$select($e(caller,*-3,*)=".RTN":$e(caller,1,*-4),1:$e(caller,1,*-4)_".1")
	}
	
exit	lock -$$$CQ("Query",$$$CQEmbedVersion,cls)#"I"
	If 'return {
		Set %msg=$g(%msg,"Unknown Error")_" compiling embedded cached query from "_$select($e(caller,*-3,*)=".RTN":$e(caller,1,*-4)_".mac",1:caller)
	}
finalexit	If $data(transuspend) $$$ResumeAllTrans(transuspend)
	if $g(interrupt) { $$$EnableExternalInterrupt }
	RETURN return
trap	Set $ztrap="",exception=""   // Process $ZTRAP errors from: RtnDelete(...), buildEmbeddedDirect(...), etc...
	try {
		set SQLCODE=-400,%msg=$$$FormatText($$$Text("Unexpected error compiling embedded SQL cached query: %1, System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),$zerror,$system,$namespace,$job)
		if $get(caller)'="" { set %msg=%msg_" compiling embedded cached query from "_$select($e(caller,*-3,*)=".RTN":$e(caller,1,*-4)_".mac",1:caller) }
		if $get(clslock) { do UnlockOneClass^%occLock(cls,3,1) Set clslock=0 }
		if cls'="",$$$IsClassDefined(cls) { do Delete^%apiOBJ(cls,"-d-l") }
	} catch exception {}
	if $get(cls)'="" {
		kill $$$CQ("QueryText",cls),$$$CQ("QueryRoutine",cls)
		lock -$$$CQ("Query",$$$CQEmbedVersion,cls)#"I"
	}
	if $data(transuspend) { $$$ResumeAllTrans(transuspend) }
	if $g(interrupt) { $$$EnableExternalInterrupt }
	if $isobject($get(exception)) { throw exception }
	RETURN 0
}
.
	/// Compile the cached query class, returns SQLCODE
	/// regeneration=1 means this CQ is being regenerated and we have to [maybe] temporarily mark it as not deployed
compileCls(cls,keepSource="",regeneration=0) {
	set:keepSource="" keepSource=$$$CQSaveMAC
	if regeneration,$$$defClassKeyGet(cls,$$$cCLASSdeployed) { $$$defClassKeySet(cls,$$$cCLASSdeployed,0) }	// Regenerating CQ and it might have been deployed previously  If $$$CQSaveMAC is off, we will make it deployed again below.
	set SQLCODE=0,sc=$$CompileRecurse^%apiOBJ(cls,$select(keepSource:"k",1:"")_"-d",.errors)
	if $$$ISERR(sc) {
		if (($$$GETERRORMESSAGE(sc)["<EXTERNAL INTERRUPT>")||($g(errors(1))["<EXTERNAL INTERRUPT>"))&&($SYSTEM.Util.InterruptReason()=$$$UserInitiatedInterrupt) { // --- User-Initiated <EXTERNAL INTERRUPT> ---
			set SQLCODE=-456,%msg=$$$FormatText($$$Text("SQL query execution interrupted by user","%SQL.Server"))
		} elseif $g(errors(1))[" : SQLCODE=" {
			set SQLCODE=$p($p(errors(1)," : SQLCODE=",2)," "),%msg=$p($p(errors(1)," : ",3),$$$NL,1)
				#; If SQLCODE=-52 then most likely the cached query class failed to compile with an error inside the SQL compiler.
				#; The -52 errors are just noise, and mask the real error, which should by in $p(tError(1),$$$NL,1)
			if SQLCODE=-52 {
				set SQLCODE=-400,%msg=$$$FormatText($$$Text("Error compiling cached query class %1:  %2. System:Instance: %3, Namespace: %4, $Job: %5","%SQL.Server"),cls,$p(errors(1),$$$NL,2),$system,$namespace,$job)
			}
		} else {
			set SQLCODE=-400,%msg=$$$FormatText($$$Text("Process %1 failed to compile Cached Query Class %2 with the following errors:  System:Instance: %3, Namespace: %4, $Job: %5, $zu(56,2): %6","%SQL.Server"),$j,cls,$system,$namespace,$job,$zu(56,2))
			for i=1:1:$g(errors) set %msg=%msg_$$$NL_$g(errors(i))
			set %msg=%msg_$$$NL_$$GetErrorText^%apiOBJ(sc)
		}
	} else {	// Class compiled OK, if not keeping CQ source, make the class deployed
		do:'keepSource MakeClassDeployed^%apiOBJ(cls,"",,1)
	}
	If SQLCODE {
		If cls'="",$$$IsClassDefined(cls) do Delete^%apiOBJ(cls,"-d-l") 
	}
	RETURN SQLCODE
}
.
#; Scan for embedded SQL cached queries where the parent routine/class has been removed
#; if the parent is no longer in the routine buffer cache remove the cached query
#; This is called with %All already
purgeCachedQueries(lastseen) {
	New $namespace
	Set batch=$zu(68,25,1)
	#; Purge any stale "lastseen" entries for namespaces we have not seen in a very long while
	Set ns="",today=+$horolog
	For {
		Set ns=$order($$$CQrootsys(0,0,"lastseen",ns),1,date) Quit:ns=""
		If today-date>300 Kill $$$CQrootsys(0,0,"lastseen",ns)
	}
	Set ns=""
	For {
		Set ns=$order($$$CQrootsys(ns)) Quit:ns=""
		Set swapns=$$swapNS(ns,.lastseen)
		If swapns'="" {
			#; If we have not seen/mounted this namespace in over 30 days purge embedded SQL queries in it, we can not swap to this namespace to do this
			#; so purge from %SYS
			If swapns>30 {
				Set $namespace="%SYS"
				Set cls=""
				For {
					Set cls=$order($$$CQns("QueryRoutine",cls)) Quit:cls=""
					Do PurgeRtn(cls,,ns)
				}
			}
			Continue
		}
		Set cls=""
		For {
			Set cls=$order($$$CQ("QueryRoutine",cls),1,data) Quit:cls=""
			#; Skip if not embedded SQL query
			If $lg(data)'=$$$CQEmbedVersion Continue 
			Set caller=$lg(data,15),callerinf=$lg(data,16),callertype=$piece(caller,".",*)
			Set callerrtn=$piece(caller,".",1,*-1)_$select(callertype="CLS":".1",1:"")
			#; Skip if the caller is still present
			If $data(^rINDEX(callerrtn,"OBJ")) Continue
			#; Check if the class is in the routine buffer, if it is then it could still be in use so do not purge anything
			Try {
				Set sfn=$piece($zutil(90,22,"","^rOBJ",callerrtn),"^")
			} Catch {
				Set sfn=$$$SFNUNDEF
			}
			#; If class descriptor still in buffer do not purge this
			#; $zutil(96,42,sfn,rtn,info) will return the number of users of a deleted routine, if the routine exists it returns -2
			If sfn'=$$$SFNUNDEF,$zutil(96,42,sfn,callerrtn,callerinf)>0 Continue
			#; Check if routine exists one last time in case it was built since first check
			If $data(^rOBJ(callerrtn)) Continue
			Do PurgeRtn(cls,,ns)
		}
	}
	Do $zu(68,25,batch)
}
.
#; Return true if caller is from IRISSYS database
#; If caller is %SYS.SQLSRV or %SYS cached query class then ignore this caller and keep walking back frames
FromIRISSYS() public {
	Set stack=$zu(41,-2)
	Set irissys="^^"_$zutil(12)
	For level=2:1 {
		Set item=$listget(stack,level) If item="" RETURN 0
		Set rtn=$piece(item,"^",3)
		If rtn=""||(rtn["%SYS.SQLSRV")||(rtn[$$$CQSYSShortRoutinePrefix) CONTINUE
		Set ns=$piece(rtn,"|",2)
		If ns'="" Set ns=$extract(ns,2,*-1),rtn=$piece(rtn,"|",3)
		If ns="" Set ns=$namespace
		If $extract(ns,1,2)="^^" Set $extract(ns,1,2)="@@"   ; Assume fake implied namespace rather than real one
		Set sourcedb="^"_$piece($zutil(90,22,ns,"rOBJ",rtn),"^",2,*)
		If (sourcedb=irissys) RETURN 1
	}
	RETURN 0
}
ProcessColprop(colprop,cls,&code,RTPC=0,&cursorname,&colvars,&args,&argsStr) public {
	set argsStr = "",propargs=$p(colprop,","),colvars=$p(colprop,",",2),cursorname=$p(colprop,",",3),formalspec="",args=$p(colprop,",",4)
	if args'="" {
		for i=1:1:$l(args,"|") {
			set arg=$p(args,"|",i),name="sqltmp"_arg
			$$$defMemberArraySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHimplementation,$i(code),$c(9)_"Set i%"_name_"=arg"_arg)
			set:RTPC argsStr = argsStr_$S(i=1:",.",1:"")_"arg"_arg_",." 
			Set formalspec=formalspec_"arg"_arg_":%RawString,"
			$$$defMemberSet(cls,$$$cCLASSproperty,name,"")
			$$$defMemberKeySet(cls,$$$cCLASSproperty,name,$$$cPROPtype,"%RawString")
		}
	}
	If propargs'="" {
		for i=1:1:$l(propargs,"|") {
			set arg=$p(propargs,"|",i),name="sqltmp"_arg
			$$$defMemberSet(cls,$$$cCLASSproperty,name,"")
			$$$defMemberKeySet(cls,$$$cCLASSproperty,name,$$$cPROPtype,"%RawString")				
		}
	}
	$$$defMemberKeySet(cls,$$$cCLASSmethod,"%Construct",$$$cMETHformalspec,$extract(formalspec,1,*-1))
	set:RTPC argsStr = $E(argsStr,1,*-2)
	RETURN $$$OK
}
DefineODBCDataTypeInfo() Public {
	#; Define ODBC Datatype information (for SQLGetTypeInfo)
	#;  Global Structure: 
	#;   ^%qSQL("odbcdt",DataType)=$LB( 1.  TYPE_NAME,
	#;                                       2.  DATA_TYPE,
	#;                                       3.  PRECISION,
	#;                                       4.  LITERAL_PREFIX,
	#;                                       5.  LITERAL_SUFFIX,
	#;                                       6.  CREATE_PARAMS,
	#;                                       7.  NULLABLE,
	#;                                       8.  CASE_SENSITIVE,
	#;                                       9.  SEARCHABLE,
	#;                                       10. UNSIGNED_ATTRIBUTE,
	#;                                       11. MONEY,
	#;                                       12. AUTO_INCREMENT,
	#;                                       13. LOCAL_TYPE_NAME,
	#;                                       14. MINIMUM_SCALE,
	#;                                       15. MAXIMUM_SCALE,
	#;                                       16. SQL_DATA_TYPE,
	#;                                       17. SQL_DATETIME_SUB,
	#;                                       18. NUM_PREC_RADIX,
	#;                                       19. INTERVAL_PRECISION )
	#;  Ordered by:
	#;    DataType and TypeName.
	#;
	#;  UNSIGNED_ATTRIBUTE is 0 for all numerics and 1 for all non-numerics (DPV1057)
	#;  CASE_SENSITIVE is 0 for everything (DPV1057)
	#;  LITERAL_PREFIX and LITERAL_SUFFIX for LONG* is now "'" (DPV1858)
	#;  LITERAL_PREFIX and LITERAL_SUFFIX for DATE/TIME/TIMESTAMP is now "'" / "'" (DPV2298)
	#;-------------------------------------------------------------------
	k ^%qSQL("odbcdt") ; Clean up any old stuff
	s ^%qSQL("odbcdt",-11)=$lb("GUID",-11,36,"'","'","",1,0,3,1,0,0,"",0,0,-11,"","","")
	s ^%qSQL("odbcdt",-7)=$lb("BIT",-7,1,"","","",1,0,3,1,0,0,"",0,0,-7,"","","")
	s ^%qSQL("odbcdt",-6)=$lb("TINYINT",-6,3,"","","",1,0,3,0,0,0,"",0,0,-6,"",10,"")
	s ^%qSQL("odbcdt",-5)=$lb("BIGINT",-5,19,"","","",1,0,3,0,0,0,"",0,0,-5,"",10,"")	// DPV2139 (Precision 19)
	s ^%qSQL("odbcdt",-4)=$lb("LONGVARBINARY",-4,2147483647,"'","'","max length",1,0,0,1,0,0,"","","",-4,"","","")
	s ^%qSQL("odbcdt",-3)=$lb("VARBINARY",-3,4096,"'","'","max length",1,0,3,1,0,0,"","","",-3,"","","")
	s ^%qSQL("odbcdt",-1)=$lb("LONGVARCHAR",-1,2147483647,"'","'","max length",1,0,0,1,0,0,"","","",-1,"","","")
	s ^%qSQL("odbcdt",0)=$lb("OREF",0,255,"","","",1,1,0,1,0,0,"","","",0,"","","")
	s ^%qSQL("odbcdt",2)=$lb("NUMERIC",2,15,"","","precision,scale",1,0,3,0,0,0,"",0,15,2,"",10,"")
	s ^%qSQL("odbcdt",4)=$lb("INTEGER",4,10,"","","",1,0,3,0,0,0,"",0,0,4,"",10,"")
	s ^%qSQL("odbcdt",5)=$lb("SMALLINT",5,5,"","","",1,0,3,0,0,0,"",0,0,5,"",10,"")
	s ^%qSQL("odbcdt",8)=$lb("DOUBLE",8,15,"","","",1,0,3,0,0,0,"","","",8,"",2,"")
	s ^%qSQL("odbcdt",12)=$lb("VARCHAR",12,4096,"'","'","max length",1,0,3,1,0,0,"","","",12,"","","")
	s ^%qSQL("odbcdt",91)=$lb("DATE",91,10,"'","'","",1,0,3,1,0,0,"","","",9,"","","")
	s ^%qSQL("odbcdt",92)=$lb("TIME",92,18,"'","'","",1,0,3,1,0,0,"","","",10,"","","")
	s ^%qSQL("odbcdt",93)=$lb("TIMESTAMP",93,23,"'","'","",1,0,3,1,0,0,"",0,0,11,"","","")
	//s ^%qSQL("odbcdt",1093)=$lb("POSIXTIME",1093,19,"","","",1,0,3,0,0,0,"",0,0,1093,"",10,"")
	#;
	#;  Same as above but for ODBC 2.5 version support (DPV3403)
	k ^%qSQL("odbcdt25") ; Clean up any old stuff
	s ^%qSQL("odbcdt25",-11)=$lb("GUID",-11,36,"'","'","",1,0,3,1,0,0,"",0,0,-11,"","","")
	s ^%qSQL("odbcdt25",-7)=$lb("BIT",-7,1,"","","",1,0,3,1,0,0,"",0,0,-7,"","","")
	s ^%qSQL("odbcdt25",-6)=$lb("TINYINT",-6,3,"","","",1,0,3,0,0,0,"",0,0,-6,"",10,"")
	s ^%qSQL("odbcdt25",-5)=$lb("BIGINT",-5,19,"","","",1,0,3,0,0,0,"",0,0,-5,"",10,"")	// DPV2139 (Precision 19)
	s ^%qSQL("odbcdt25",-4)=$lb("LONGVARBINARY",-4,2147483647,"'","'","max length",1,0,0,1,0,0,"","","",-4,"","","")
	s ^%qSQL("odbcdt25",-3)=$lb("VARBINARY",-3,4096,"'","'","max length",1,0,3,1,0,0,"","","",-3,"","","")
	s ^%qSQL("odbcdt25",-1)=$lb("LONGVARCHAR",-1,2147483647,"'","'","max length",1,0,0,1,0,0,"","","",-1,"","","")
	s ^%qSQL("odbcdt25",0)=$lb("OREF",0,255,"","","",1,1,0,1,0,0,"","","",0,"","","")
	s ^%qSQL("odbcdt25",2)=$lb("NUMERIC",2,15,"","","precision,scale",1,0,3,0,0,0,"",0,15,2,"",10,"")
	s ^%qSQL("odbcdt25",4)=$lb("INTEGER",4,10,"","","",1,0,3,0,0,0,"",0,0,4,"",10,"")
	s ^%qSQL("odbcdt25",5)=$lb("SMALLINT",5,5,"","","",1,0,3,0,0,0,"",0,0,5,"",10,"")
	s ^%qSQL("odbcdt25",8)=$lb("DOUBLE",8,15,"","","",1,0,3,0,0,0,"","","",8,"",2,"")
	s ^%qSQL("odbcdt25",9)=$lb("DATE",9,10,"'","'","",1,0,3,1,0,0,"","","",9,"","","")
	s ^%qSQL("odbcdt25",10)=$lb("TIME",10,18,"'","'","",1,0,3,1,0,0,"","","",10,"","","")
	s ^%qSQL("odbcdt25",11)=$lb("TIMESTAMP",11,23,"'","'","",1,0,3,1,0,0,"",0,0,11,"","","")
	s ^%qSQL("odbcdt25",12)=$lb("VARCHAR",12,4096,"'","'","max length",1,0,3,1,0,0,"","","",12,"","","")
	//s ^%qSQL("odbcdt25",1093)=$lb("POSIXTIME",1093,19,"","","",1,0,3,0,0,0,"",0,0,1093,"",10,"")
	#;
	#; Define JDBC Datatype information (for getTypeInfo)
	#;  Global Structure: 
	#;   ^%qSQL("jdbcdt",DataType)=$LB( 1.  TYPE_NAME,
	#;                                       2.  DATA_TYPE,
	#;                                       3.  PRECISION,
	#;                                       4.  LITERAL_PREFIX,
	#;                                       5.  LITERAL_SUFFIX,
	#;                                       6.  CREATE_PARAMS,
	#;                                       7.  NULLABLE,
	#;                                       8.  CASE_SENSITIVE,
	#;                                       9.  SEARCHABLE,
	#;                                       10. UNSIGNED_ATTRIBUTE,
	#;                                       11. FIXED_PREC_SCALE,
	#;                                       12. AUTO_INCREMENT,
	#;                                       13. LOCAL_TYPE_NAME,
	#;                                       14. MINIMUM_SCALE,
	#;                                       15. MAXIMUM_SCALE,
	#;                                       16. SQL_DATA_TYPE,     ; unused
	#;                                       17. SQL_DATETIME_SUB,  ; unused
	#;                                       18. NUM_PREC_RADIX )
	#;  Ordered by:
	#;    DataType and TypeName.
	#;
	#;  UNSIGNED_ATTRIBUTE is 0 for all numerics and 1 for all non-numerics (DPV1057)
	#;  CASE_SENSITIVE is 0 for everything (DPV1057)
	#;  LITERAL_PREFIX and LITERAL_SUFFIX for LONG* is now "'" (DPV1858)
	#;  LITERAL_PREFIX and LITERAL_SUFFIX for DATE/TIME/TIMESTAMP is now "'" / "'" (DPV2298)
	#;-------------------------------------------------------------------
	k ^%qSQL("jdbcdt") ; Clean up any old stuff
	s ^%qSQL("jdbcdt",-11)=$lb("GUID",-11,36,"'","'","",1,0,3,1,0,0,"",0,0,"","","")
	s ^%qSQL("jdbcdt",-7)=$lb("BIT",-7,1,"","","",1,0,3,1,0,0,"",0,0,"","","")
	s ^%qSQL("jdbcdt",-6)=$lb("TINYINT",-6,3,"","","",1,0,3,0,0,0,"",0,0,"","",10)
	s ^%qSQL("jdbcdt",-5)=$lb("BIGINT",-5,19,"","","",1,0,3,0,0,0,"",0,0,"","",10)	// DPV2139 (Precision 19)
	s ^%qSQL("jdbcdt",-4)=$lb("LONGVARBINARY",-4,2147483647,"'","'","max length",1,0,0,1,0,0,"","","","","","")
	s ^%qSQL("jdbcdt",-3)=$lb("VARBINARY",-3,4096,"'","'","max length",1,0,3,1,0,0,"","","","","","")
	s ^%qSQL("jdbcdt",-1)=$lb("LONGVARCHAR",-1,2147483647,"'","'","max length",1,0,0,1,0,0,"","","","","","")
	s ^%qSQL("jdbcdt",0)=$lb("OREF",0,255,"","","",1,1,0,1,0,0,"","","",0,"","")
	s ^%qSQL("jdbcdt",2)=$lb("NUMERIC",2,16,"","","precision,scale",1,0,3,0,1,0,"",0,16,"","",10)
	s ^%qSQL("jdbcdt",4)=$lb("INTEGER",4,10,"","","",1,0,3,0,0,0,"",0,0,"","",10)
	s ^%qSQL("jdbcdt",5)=$lb("SMALLINT",5,5,"","","",1,0,3,0,0,0,"",0,0,"","",10)
	s ^%qSQL("jdbcdt",8)=$lb("DOUBLE",8,15,"","","",1,0,3,0,0,0,"","","","","",10)
	s ^%qSQL("jdbcdt",12)=$lb("VARCHAR",12,4096,"'","'","max length",1,0,3,1,0,0,"","","","","","")
	s ^%qSQL("jdbcdt",91)=$lb("DATE",91,10,"'","'","",1,0,3,1,0,0,"","","","","","")
	s ^%qSQL("jdbcdt",92)=$lb("TIME",92,18,"'","'","",1,0,3,1,0,0,"","","","","","")
	s ^%qSQL("jdbcdt",93)=$lb("TIMESTAMP",93,23,"'","'","",1,0,3,1,0,0,"",0,0,"","","")
	//s ^%qSQL("jdbcdt",1091)=$lb("DATE",1091,7,"","","",1,0,3,0,0,0,"",0,0,"","",10)
	//s ^%qSQL("jdbcdt",1092)=$lb("TIME",1092,5,"","","",1,0,3,0,0,0,"",0,0,"","",10)
	//s ^%qSQL("jdbcdt",1093)=$lb("POSIXTIME",1093,19,"","","",1,0,3,0,0,0,"",0,0,"","",10)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
} 
