	#; Code Generate call to make an Audit entry for this statement
	#; fast = 0 :: Not fast
	#; fast = 1 :: fastInsert
	#; fast = 2 :: Columnar fastInsert
	#; fast = -1 :: Maybe fastSelect, check $g(%qsc(%qacn,4)
GenerateAuditCode(pClassName,method,stmttype,&pSQL,&code,fast=0,indent="") [] PRIVATE {
		// Code to run if Auditing for XDBCStatements is enabled
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,indent_"if %0IRISServer.AuditingDML {")
		// Record SQL statement
	for i=1:1:pSQL {
		set sqllen=$l(pSQL(i))
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,indent_$c(9)_"set sAudit="_$s(i>1:"sAudit_$c(13,10)_",1:"")_$zu(144,1,$e(pSQL(i),1,$$$MaxRtnLineLength)))						// First 4k of this line of code
		for ii=($$$MaxRtnLineLength+1):$$$MaxRtnLineLength { quit:ii>sqllen  set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"set sAudit=sAudit_"_$zu(144,1,$e(pSQL(i),ii,ii+$$$MaxRtnLineLength-1)))  }	// Remaining 4k chunks of this line
	}
		// Record argument values
	if $g(%sqlHVarTypes) {	// %sqlHVarTypes may not be defined if this is an ExecuteBatch or %protocol 44 or under
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,indent_$c(9)_"try {")
		if stmttype=2,fast {
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,indent_$c(9,9)_"set pAudit=$c(13,10)_""Parameter values are not available for a fastInsert statement""")
		} else {
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,indent_$c(9,9)_"set pAudit=$c(13,10)_""Parameter values:"" for i=1:1:"_%sqlHVarTypes_" { set pAudit=pAudit_$c(13,10)_""%qpar(""_i_"")=""_$case($g(%qpar(i)),"""":""<null>"",$c(0):""<empty string>"",:$s($isvalidnum(%qpar(i)):%qpar(i),1:$zu(144,1,%qpar(i)))) }")
		}
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,indent_$c(9)_"} catch { do $SYSTEM.Security.AuditID("_$$$AUDITXDBCSTATEMENTDML_",""** ERROR::""_$ze_"" **""_$c(13,10)_"" Auditing arguments for SQL Statement""_$c(13,10)_sAudit_$g(pAudit),""**ERROR** SQL "_$$GetTypen(stmttype)_" Statement"") set $ze="""" }")
	}
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,indent_$c(9)_"do $SYSTEM.Security.AuditID("_$$$AUDITXDBCSTATEMENTDML_",sAudit_$g(pAudit),""SQL "_$case(fast,1:"fast",2:"Columnar fast",-1:"""_$s($g(%qsc(%qacn,4)):""fast"",1:"""")_""",:"")_$$GetTypen(stmttype)_" Statement"")")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,indent_"}")
		// Code to run if Auditing for XDBCStatements is not enabled
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,indent_"else { do $SYSTEM.Security.AuditID("_$$$AUDITXDBCSTATEMENTDML_","""",""SQL "_$case(fast,1:"fast",2:"Columnar fast",-1:"""_$s($g(%qsc(%qacn,4)):""fast"",1:"""")_""",:"")_$$GetTypen(stmttype)_" Statement"") }")
	QUIT
