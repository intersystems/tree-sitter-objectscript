				#; If that happens, just skip the update of the SI.  We certainly don't want to create a new SI entry without all the SI info, and we can't update an SI entry that no longer exists.
				#; We could report an error here, but I don't think that is needed.
			if '$d(pCompileOptions) || '$d(pSQL) { GOTO end }
			set $$$SQLIndex(1,pHash,0)=pCompileOptions
			set:$LG(pCompileOptions,6)'="" $$$SQLIndex(4,$LG(pCompileOptions,6),pHash)="" // Set 'SQLStatementID' Index!
			set callstack=""
			for lev=$zu(41)-1:-1:1 {
				try { set stack=$zu(41,lev) } catch { if $zerror'["<NAMESPACE>" { throw } QUIT }  ; If we get an error decoding stack frame ignore storing call stack
				if $e($p(stack,"^",2),1,$l("%0dsql"))="%0dsql" CONTINUE  ; Skip UCQ tag
				set rtn=$p(stack,"^",3)
				if rtn["|" set rtn=$p(rtn,"|",3)
				if rtn="" CONTINUE
				if $e(rtn,1,2)="%q" CONTINUE
				if $e(rtn,1,4)="%occ" CONTINUE
				if $e(rtn,1,4)="%api" CONTINUE
				if $e(rtn,1,11)="%SYSTEM.OBJ" CONTINUE
				if $e(rtn,1,11)="%SYSTEM.SQL" CONTINUE
				if $e(rtn,1,5)="%SYS." CONTINUE
				if $e(rtn,1,5)="%SQL." CONTINUE
				if $lg(pCompileOptions,7)'="" CONTINUE	// Object Insert/Update/Delete SQL Statement Index
				for ilev=lev:-1:1 {
					try { set stack=$p($zu(41,ilev),"^",2,3) } catch { if $zerror'["<NAMESPACE>" { throw } QUIT }   ; If we get an error decoding stack frame ignore storing further call stack frames
