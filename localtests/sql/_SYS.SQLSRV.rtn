	#;----------------------------------------
RtnAlloc(sc) [] PUBLIC {
		  #; Allocate new routine name
		  #;  Do not reuse CachedProc# before $h+2 to prevent client error
		  #; sc is passed by reference, return status code
	set $zt="Error",sc=$$$OK
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	$$$SuspendAllTrans(zu139)
	#; DPV2749 $$$DisableJournal
	set rtn=""  ;  use $increment for test-and-set, only 1956 wins
	for {
		set rtn=$o($$$CQ("NextRtn",rtn)) quit:rtn=""
		set h=$i(^(rtn)) kill ^(rtn) quit:h=1956
	}
	if rtn="" { set rtn=$increment($$$CQ("NextRtn")) }
	set rtn=$$$CQRoutinePrefix_rtn 
	kill ^rMAC(rtn),^rMACSAVE(rtn),^ROUTINE(rtn),^rOBJ(rtn),^rINDEX(rtn,"MAC"),^("INT"),^("BAS"),^("OBJ"),^rMAP(rtn)	// DPV2905
	do:$d($$$SQLIndex(2,rtn)) DeleteSQLIndex(rtn)
	$$$ResumeAllTrans(zu139)
	#; DPV2749 $$$EnableJournal
	RETURN rtn
Error
	set $zt=""
	set sc=$$$ERROR($$$ObjectScriptError,$ze)
	if $d(zu139) { $$$ResumeAllTrans(zu139) }
	#; DPV2749 $$$EnableJournal
	RETURN ""
}
	#;----------------------------------------
#; YCL198 - this is only called from RunTempCode^%SYS.SQLSRV, instead of using $increment($$$CQ("NextRtn")) in the rtn name, 
#; use "j"_+$job_"s"_$stack to make each process have its own rtn name, since RunTempCode is never meant to be the code cached or shared 
#; between different processes
TempRtnAlloc(sc,cacheable=0) [] PRIVATE {
		  #; Allocate new temp routine name
		  #; sc is passed by reference, return status code
	set $zt="Error",sc=$$$OK
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	$$$SuspendAllTrans(zu139)
		// For storage type conversions, we allocate (potentially 2) routines that are cached for potential use later. These could overwrite each other if only $job and $stack are used because
		// those values would be the same if this is called twice in a non-recursive fashion
	set rtn=$$$CQRoutinePrefix_"TEMPj"_+$job_"s"_$stack_$s(cacheable:"c"_+$p($zh,".",2),1:"")
	kill ^rMAC(rtn),^rMACSAVE(rtn),^ROUTINE(rtn),^rOBJ(rtn),^rINDEX(rtn,"MAC"),^("INT"),^("BAS"),^("OBJ"),^rMAP(rtn)	// Make sure we start clean
	do:$d($$$SQLIndex(2,rtn)) DeleteSQLIndex(rtn)
	$$$ResumeAllTrans(zu139)
	RETURN rtn
.
Error
	s $zt=""
	set sc=$$$ERROR($$$ObjectScriptError,$ze)
	If $d(zu139) $$$ResumeAllTrans(zu139)
	#; DPV2749 $$$EnableJournal
	QUIT ""
	}
ClassNameAlloc(pError) [] PUBLIC {
		  #; Allocate new classname name
		  #; Called from:
		  #;    %XSQL.DSI.Cursor.%Generate
		  #;    %XSQL.DSI.DeferredStatement.Generate
		  #;    %XSQL.DSI.GlobalPrivateTable.%Generate
		  #;    %XSQL.DSI.IteratorFunction.%Generate
		  #;    %SYS.DynamicStatement
		  #;    %SYS.ResultSet
		  #;    %SYS.XSQL
		  #;
		  #; pError passed by reference, may return $ze error if we encounter an error
	set $zt="Error"
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	$$$SuspendAllTrans(zu139)
	set cls=""  ;  use $increment for test-and-set, only 1956 wins
	for {
		set cls=$o($$$CQ("NextCls",cls)) quit:cls=""
		set h=$i(^(cls)) kill ^(cls) quit:h=1956
	}
	set:cls="" cls=$increment($$$CQ("NextCls"))
	set cls=$$$CQPackage_".cls"_cls
	$$$ResumeAllTrans(zu139)
	RETURN cls
Error	set $zt="",pError=$ze
	if $d(zu139) { $$$ResumeAllTrans(zu139) }
	RETURN ""
}
.
	#;----------------------------------------
	  #; Return routine prefix
GetPrefix(ns="") [] PUBLIC { s i=$$$CQRoutinePrefix QUIT i  }
	#;----------------------------------------
	/// Called from:
	///	- %SQL.Manager.API.CheckPriv
	/// - %SYSTEM.SQL.Security.CheckPrivilege
	/// - %SYSTEM.SQL.Security.CheckPrivilegeWithGrant
	/// - %XSQL.DSI.TSQL.Generate
	/// - %SYS.DynamicQuery
	/// - %SYS.DynamicStatement
	/// - %SYS.PTools
	/// - %SYS.ResultSet
	/// - %SYS.SQLRTUMAKER
	/// - %SYS.SQLSEC
	/// - %apiDDL
	/// - Compile^%SYS.SQLSRV()
CheckPriv(act,&mtc,&%qinfo,&privs,&sysprivs,checkPriv=1) public {
	#; Check privileges
	#;  If user is SuperUser or security is off, privileged
	#; if checkPriv=0, we are performing no-privilege checking %SQL.Statement, but we still need to define privs and sysprivs
	set:$g(act)="" act=$$GetType($g(%qinfo("type")))
	set stmttype=act
 
	  #;  Here we check if the user is doing a DDL statement and if so do they hae system privilege to do it
	  #;  We only need to check in Compile since DDL statements are not cached :)
	
	if '$$$IAmSuperUser && ($$$SQLSecurityOn) {
		if ((act>8&&(act<18))||(act>34)),checkPriv {
			if ",9,75,"[(","_act_","), '$$$CreateTablePriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %CREATE_TABLE privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 } // 75 is CRFT
			if ",10,15,16,17,52,76,"[(","_act_","),'$$$AlterTablePriv($$$aid,0) { set %msg=$$$FormatText($$$Text("User %1 does not have %ALTER_TABLE privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if ",11,77,"[(","_act_","),'$$$DropTablePriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %DROP_TABLE privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=12,'$$$CreateViewPriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %CREATE_VIEW privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=13,'$$$AlterViewPriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %ALTER_VIEW privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=14,'$$$DropViewPriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %DROP_VIEW privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=35,'$$$CreateFunctionPriv($$$aid,0)		{ set %msg=$$$FormatText($$$Text("User %1 does not have %CREATE_FUNCTION privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=36,'$$$CreateMethodPriv($$$aid,0)		{ set %msg=$$$FormatText($$$Text("User %1 does not have %CREATE_METHOD privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=37,'$$$CreateProcedurePriv($$$aid,0)		{ set %msg=$$$FormatText($$$Text("User %1 does not have %CREATE_PROCEDURE privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=38,'$$$CreateQueryPriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %CREATE_QUERY privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			If act=39,'$$$DropFunctionPriv($$$aid,0)		{ set %msg=$$$FormatText($$$Text("User %1 does not have %DROP_FUNCTION privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=40,'$$$DropMethodPriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %DROP_METHOD privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=41,'$$$DropProcedurePriv($$$aid,0)		{ set %msg=$$$FormatText($$$Text("User %1 does not have %DROP_PROCEDURE privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=42,'$$$DropQueryPriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %DROP_QUERY privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=43,'$$$CreateTriggerPriv($$$aid,0)		{ set %msg=$$$FormatText($$$Text("User %1 does not have %CREATE_TRIGGER privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=44,'$$$DropTriggerPriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %DROP_TRIGGER privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=54,'$$$ManageModelPriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %MANAGE_MODEL privilege which is needed to CREATE MODEL","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=55,'$$$ManageModelPriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %MANAGE_MODEL privilege which is needed to DROP MODEL","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=56,'$$$ManageModelPriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %MANAGE_MODEL privilege which is needed to TRAIN MODEL","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=57,'$$$ManageModelPriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %MANAGE_MODEL privilege which is needed to ALTER MODEL","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=58,'$$$UseModelPriv($$$aid,0)			{ set %msg=$$$FormatText($$$Text("User %1 does not have %USE_MODEL privilege which is needed to VALIDATE MODEL","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=60,'$$$CreateMLConfigurationPriv($$$aid,0)	{ set %msg=$$$FormatText($$$Text("User %1 does not have %CREATE_ML_CONFIGURATION privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=61,'$$$AlterMLConfigurationPriv($$$aid,0)	{ set %msg=$$$FormatText($$$Text("User %1 does not have %ALTER_ML_CONFIGURATION privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=62,'$$$DropMLConfigurationPriv($$$aid,0)		{ set %msg=$$$FormatText($$$Text("User %1 does not have %DROP_ML_CONFIGURATION privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if act=66,'$$$BuildIndexPriv($$$aid,0)				{ set %msg=$$$FormatText($$$Text("User %1 does not have %BUILD_INDEX privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			if ",72,73,74,"[(","_act_","),'$$$ManageForeignServerPriv($$$aid,0) 					{set %msg=$$$FormatText($$$Text("User %1 does not have %MANAGE_FOREIGN_SERVER privilege","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99}
		}
		if $g(mtc(0,0,"syspriv"))'="" {
			if checkPriv {
				if $listget(mtc(0,0,"syspriv"),1),'$$$NoCheckPriv($$$aid,0)   { set %msg=$$$FormatText($$$Text("User %1 does not have %NOCHECK privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
				if $listget(mtc(0,0,"syspriv"),2),'$$$NoTriggerPriv($$$aid,0) { set %msg=$$$FormatText($$$Text("User %1 does not have %NOTRIGGER privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
				if $listget(mtc(0,0,"syspriv"),3),'$$$NoIndexPriv($$$aid,0)   { set %msg=$$$FormatText($$$Text("User %1 does not have %NOINDEX privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
				if $listget(mtc(0,0,"syspriv"),4),'$$$NoLockPriv($$$aid,0)    { set %msg=$$$FormatText($$$Text("User %1 does not have %NOLOCK privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
				if $listget(mtc(0,0,"syspriv"),12),'$$$NoJournPriv($$$aid,0)  { set %msg=$$$FormatText($$$Text("User %1 does not have %NOJOURN privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
				if $listget(mtc(0,0,"syspriv"),9),'$$$UseModelPriv($$$aid,0)  { set %msg=$$$FormatText($$$Text("User %1 does not have %USE_MODEL privilege needed for using the PREDICT or PROBABILITY function","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
				if $listget(mtc(0,0,"syspriv"),15),'$$$UseEmbeddingPriv($$$aid,0)  { set %msg=$$$FormatText($$$Text("User %1 does not have the %USE_EMBEDDING privilege needed to use the EMBEDDING function or datatype","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
				if $listget(mtc(0,0,"syspriv"),32),'$$$DeferPriv($$$aid,0)  { set %msg=$$$FormatText($$$Text("User %1 does not have %DEFER privileges","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
			}
		}
	}
	set sysprivs=$g(mtc(0,0,"syspriv"))
	if act=47 {	// LOCK TABLE
		if $d(mtc(0,0,"lock priv"),ii),checkPriv {
			set ok=0
			if $lg(ii)="e",$$AnyPrivObjIUD^%SYS.SQLSEC("1,"_$lg(ii,2),0) { set ok=1 }
			elseif $lg(ii)="s",$$AnyPrivObjS^%SYS.SQLSEC("1,"_$lg(ii,2),0) { set ok=1 }
			If 'ok,$$$SQLSecurityOn s %msg=$$$FormatText($$$Text("User %1 does not have privilege to LOCK TABLE %2","%SQL.Server"),$$$aid,$lg(ii,2)) do Audit99^%SYS.SQLSEC(%msg) RETURN -99  ; -99 = privilege violation
			RETURN 0
		}
	}
	elseif act=52 {	// TUNE TABLE
		if $d(mtc(0,0,"tune priv"),rel) {
			set realrel=$$$GetExactIQNFromIQN(rel)
			if checkPriv { set ok=$$priv^%SYS.SQLSEC("1,"_realrel,"a",$namespace,0) }
			if 'ok,$$$SQLSecurityOn { set %msg=$$$FormatText($$$Text("User %1 does not have privileged to TUNE TABLE","%SQL.Server"),$$$aid,realrel) do Audit99^%SYS.SQLSEC(%msg) RETURN -99  }
			RETURN 0
		}
	} elseif act=59 {
		if $d(mtc(0,0,"set ml configuration"),rel) {
				#; First we will check if the ML Configuration exists, if not, report -187 instead of -99
				#; This is a bit of a kludge, but it matches the behavior of tables and procedures (-30 error instead of -99 for non-existing table/view)
			
			if checkPriv { set ok=$$priv^%SYS.SQLSEC("6,"_$$$UPPER(rel),"l",$namespace,0) }
			if 'ok,$$$SQLSecurityOn {
				if '$d(^%SYS("ml","configuration","i","NameIndex",$$$SQLUPPER(rel))) {
					set %msg=$$$FormatText($$$Text("%ML Configuration '%1' not found","%SQL.Server"),rel) RETURN -187
				}
				set %msg=$$$FormatText($$$Text("User %1 is not privileged for the operation","%SQL.Server"),$$$aid) RETURN -99
			}
			RETURN 0
		}
	} elseif act=63 { // FREEZE PLANS
		if checkPriv { set ok=$SYSTEM.Security.Check($$$DevelopmentResourceName,$$$PermUseName) }
		if 'ok,$$$SQLSecurityOn { set %msg=$$$FormatText($$$Text("User %1 does not have privilege to FREEZE PLANS","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
		RETURN 0
	} elseif act=64 { //UNFREEZE PLANS
		if checkPriv { set ok=$SYSTEM.Security.Check($$$DevelopmentResourceName,$$$PermUseName) }
		if 'ok,$$$SQLSecurityOn { set %msg=$$$FormatText($$$Text("User %1 does not have privilege to UNFREEZE PLANS","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg) RETURN -99 }
		RETURN 0
	} elseif ",9,10,35,36,37,38,43,"[(","_act_",") { // CREATE [TABLE/FUNCTION/METHOD/PROC/QUERY/TRIGGER], ALTER TABLE
		if checkPriv,$g(mtc(0,0,"%development_use")) { 
			if $$$SQLSecurityOn,'$SYSTEM.Security.Check($$$DevelopmentResourceName,$$$PermUseName) {
				set actionText = $CASE(act,10:"ALTER",:"CREATE")_" "_$CASE(act,35:"FUNCTION",36:"METHOD",37:"PROCEDURE",38:"QUERY",43:"TRIGGER",:"TABLE")
				set %msg=$$$FormatText($$$Text("User %1 does not have privilege to %2 with custom code","%SQL.Server"),$$$aid,actionText) 
				do Audit99^%SYS.SQLSEC(%msg) 
				RETURN -99 
			}
		}
		RETURN 0
	} elseif act = 80 { // THROUGH [FOREIGN] SERVER <server> ... 
		if checkPriv, $$$SQLSecurityOn {
			if $d(mtc(0,0,"through-server"), server) {
				if '$$priv^%SYS.SQLSEC("7,"_server,"l",$namespace,0) {
					set %msg=$$$FormatText($$$Text("User %1 does not have privilege to USE foreign server %2","%SQL.Server"),$$$aid, server)
					do Audit99^%SYS.SQLSEC(%msg) 
					RETURN -99
				}
			}
		}
		RETURN 0
	}
	set actlist=$s(act=1:"s",act=2:"i",act=3:"u",act=4:"d",",7,8,"[(","_act_","):"*",",9,10,11,14,15,16,17,"[(","_act_","):"a",act=45:"e",1:"")	// DPV3022=
	set:actlist="*" actlist=$g(%qinfo("g/r actions"))
	RETURN:actlist="" 0  ; OK
	set tab="",ok=1,prev="",quit=0
.
		#;  If this is an INSERT OR UPDATE, make sure we add "u" to the actlist
	set:$d(%qinfo("update privs"))&&(actlist'["u")&&(actlist["i") actlist=actlist_",u"
.
	if $d(%qinfo("view iud priv"),iqn) {
		for jj=1:1 {
			set tab=$o(%qinfo("table",tab),-1) quit:tab=""
			if tab["^",prev'["^",prev'="" { quit }
			set prev=tab,ttype=+%qinfo("table",tab),rel=$p(%qinfo("table",tab),$c(1),3) 
			continue:rel'=iqn
			quit:(+ttype=0||(rel=""))
			for ii=1:1 {
				set act=$p(actlist,",",ii) quit:act=""
				if act'="s" {
					set fields=$g(%qinfo("table",tab,"priv",act,"fields"))
					if checkPriv { set ok=$$priv^%SYS.SQLSEC("3,"_rel,act,$namespace,0,fields) }
					if 'ok { set auditaction=act,auditrelation=rel,auditfields=fields,audittype=3 quit }
				}
				set ptr=0
				while $listnext(fields,ptr,field) { set:'$lf($g(privs(ttype_","_rel,act)),field) privs(ttype_","_rel,act)=$g(privs(ttype_","_rel,act))_$lb(field) }
			}
			quit:'ok
		}
		if 'ok,$$$SQLSecurityOn { set %msg=$$$FormatText($$$Text("User %1 is not privileged for the operation","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg,,auditaction,audittype,auditrelation,auditfields) RETURN -99 } ; -99 = privilege violation
		set prev=""
	}
		
		#;  Check all the SELECT privileges
	if $d(%qinfo("select privs")) {
		set jj=""
		for  {
			set tab=$o(%qinfo("select privs",tab),1,fields) quit:tab=""
				#; If there is a "realname" node defined, we want to check privs on the real name, not the tab name (this is a sharded table)
			if $d(%qinfo("select privs",tab,"realname"),tabe) {}
			else { set tabe=$$$GetExactIQNFromIQN(tab) }  // Int Qualified exact case name
			continue:tabe=""  	// Perhps it is a TVF?
			continue:tabe="%TSQL_sys.snf"	// DPV3196
			set ttype=$$$GetTableTypeFromIQN(tab)
			set:actlist'["s" actlist=actlist_",s"
			if checkPriv { set ok=$$priv^%SYS.SQLSEC(ttype_","_tabe,"s",$namespace,0,fields) }
			if 'ok{ set auditaction="s",auditrelation=tabe,auditfields=fields,audittype=ttype quit }
			set ptr=0 while $listnext(fields,ptr,field) { set:'$lf($g(privs(ttype_","_tabe,"s")),field) privs(ttype_","_tabe,"s")=$g(privs(ttype_","_tabe,"s"))_$lb(field) }
			set:'$d(privs(ttype_","_tabe,"s")) privs(ttype_","_tabe,"s")=""
		}
	}
	if 'ok,$$$SQLSecurityOn set %msg=$$$FormatText($$$Text("User %1 is not privileged for the operation","%SQL.Server"),$$$aid) do Audit99^%SYS.SQLSEC(%msg,,auditaction,audittype,auditrelation,auditfields) RETURN -99  ; -99 = privilege violation
.
	if '$d(%qinfo("inssel")),'$d(%qinfo("view iud priv")) {
			#;  Then all the INS/UPD/DEL privileges
		for jj=1:1 {
			set tab=$o(%qinfo("table",tab),1) quit:tab=""
			if tab["^",prev'["^",prev'="" { quit }
			set prev=tab,ttype=+%qinfo("table",tab)
			set rel=$p(%qinfo("table",tab),$c(1),10)	// Shard Master Table Name (in case this is a sharded table)
			set:rel="" rel=$p(%qinfo("table",tab),$c(1),3)  // Not a sharded table, use actual name
			quit:(+ttype=0||(rel=""))
			for ii=1:1 {
				set act=$p(actlist,",",ii) quit:act=""  
				if act'="s" {
					set fields=$g(%qinfo("table",tab,"priv",act,"fields"))
					set:fields=""&&(stmttype=7||(stmttype=8)) fields=$g(mtc(0,0,"g/r fields",act))
					if checkPriv { set ok=$$priv^%SYS.SQLSEC(ttype_","_rel,act,$namespace,0,fields) }
					if 'ok{ set auditaction=act,auditrelation=rel,auditfields=fields,audittype=ttype quit }
					set ptr=0
					while $listnext(fields,ptr,field) { set:'$lf($g(privs(ttype_","_rel,act)),field) privs(ttype_","_rel,act)=$g(privs(ttype_","_rel,act))_$lb(field) }
					set:'$d(privs(ttype_","_rel,act)) privs(ttype_","_rel,act)=""
					if act="i",($d(%qinfo("table",tab,"priv","u","fields"))) {	// DPV4086 INSERT OR UPDATE
						if checkPriv { set ok=$$priv^%SYS.SQLSEC(ttype_","_rel,"u",$namespace,0,fields) }
						if 'ok{ set auditaction="u",auditrelation=rel,auditfields=fields,audittype=ttype quit }
						set ptr=0 while $listnext(fields,ptr,field) { set:'$lf($g(privs(ttype_","_rel,"u")),field) privs(ttype_","_rel,"u")=$g(privs(ttype_","_rel,"u"))_$lb(field) }
						set:'$d(privs(ttype_","_rel,"u")) privs(ttype_","_rel,"u")=""
					}
				}
			}
			quit 	//:'ok - just go through loop once
		}
	}
	elseif '$d(%qinfo("view iud priv")) {	// INSERT ... SELECT - special case, just check INSERT priv on first table
		set tab=%qinfo("inssel")	// this is the iqn of the table/view we are inserting into
		set ttype=$$$GetTableTypeFromIQN(tab),rel=$$$GetExactIQNFromIQN(tab) 
		if ttype=1,rel'="" {	// ttype=3 is check above in "view iud priv" section
			for ii=1:1 {
				set act=$p(actlist,",",ii) q:act=""  
				if act'="s" {
					set fields=$g(%qinfo("table","1^"_tab,"priv",act,"fields"))
					if checkPriv { set ok=$$priv^%SYS.SQLSEC(ttype_","_rel,act,$namespace,0,fields) }
					if 'ok { set auditaction=act,auditrelation=rel,auditfields=fields,audittype=ttype quit }
					set ptr=0 while $listnext(fields,ptr,field) { set:'$lf($g(privs(ttype_","_rel,act)),field) privs(ttype_","_rel,act)=$g(privs(ttype_","_rel,act))_$lb(field) }
					set:'$d(privs(ttype_","_rel,act)) privs(ttype_","_rel,act)=""
				}
			}
		}
	}
		#;  Check any EXECUTE privileges
	if $d(%qinfo("execute privs")) {	// DPV3020=
		set jj=0
		while $listnext(%qinfo("execute privs"),jj,value) {
			set proc=$li(value)_"."_$tr($li(value,2),".",$c(2)) continue:proc="."  	// *** error?
			set:actlist'["e" actlist=actlist_",e"
			if checkPriv { set ok=$$priv^%SYS.SQLSEC("9,"_proc,"e",$namespace,0) }
			if 'ok{ set auditaction="e",auditrelation=proc,auditfields="",audittype=9 quit }
			set privs("9,"_proc,"e")=""
		}
	}
	if ($$$IAmSuperUser) || ($$$SQLSecurityOff) { RETURN 0 }
	if 'ok {
		set %msg=$$$FormatText($$$Text("User %1 is not privileged for the operation","%SQL.Server"),$$$aid) 
		do Audit99^%SYS.SQLSEC(%msg,,auditaction,audittype,auditrelation,auditfields) 
		RETURN -99 ; -99 = privilege violation
	}
	RETURN 0
}
.
GetType(t) [] PUBLIC {
		#; ONLY the following statement types are preserved in the cache, the rest are purged after execution:
		#;   SELECT, INSERT, UPDATE, DELETE, COMMIT, ROLLBACK, SET TP, START TP, %INTRANSACTION, %BEGTRANS, %INTRANS, GET, CALL   // $s(stmttype>6&&(stmttype<20):1,stmttype>25&&(stmttype'=45):1,1:0)
		#; Return numerical value for SQL statement type
		#;  *** When this list changes, when we add new statement types:
		#;        - Remember to keep this list in sync with the $$$mtStatementType node documented in the following file: ../internal/docs/sql/mt.txt
		#;        - Remember to check GenerateAuditCode^%qaqcasl to see if the new statement type should be included in Embedded SQL Auditing
		#;        1               5                   10                  15                  20                                     25                                 30                      35                  40                  45                  50                   55                         60                                            65                       70                     75                               80
	set t=$l($p("~SEL~INS~UPD~DEL~COM~ROL~GRA~REV~CRT~ALT~DRT~CRV~ALV~DRV~CRI~ALI~DRI~CRR~DRR~SET TP~START TP~%INTRANSACTION~%BE~%IN~GET~SET OPTION~STATISTICS~%CH~CRUS~ALUS~DRUS~%CHSP~GRP~RVP~CRF~CRM~CRP~CRQ~DRF~DRM~DRP~DRQ~CRG~DRG~CAL~SAV~LCK~ULK~CRD~DRD~USD~TUN~DEC~CMDL~DMDL~TMDL~AMDL~VMDL~SET ML~CMLCONFIG~AMLCONFIG~DMLCONFIG~FREEZE~UNFREEZE~PURGE~BUILD~CRA~DRA~LOAD~CRS~DRS~CRSV~ALSV~DRSV~CRFT~ALFT~DRFT~CANCELQRY~EXPLAIN~THR~ALS~BUILDDEFERRED~","~"_t_"~"),"~")
	RETURN:t<83 t
	RETURN 0
}
GetTypen(t,&sqlStmtTypes) [] PUBLIC {
		#; Return name for SQL statement type given type number
		#;  *** When this list changes, when we add new statement types:
		#;        - Remember to check GenerateAuditCode^%qaqcasl to see if the new statement type should be included in Embedded SQL Auditing
		#;            1                           5                                         10                                                      15                                                        20                                                                  25                                               30                                           35                                                                        40                                                                45                                                     50                                                         55                                                       60                                                                                               65                                                     70                                                               75                                                                               80
	set sqlStmtTypes="SELECT~INSERT~UPDATE~DELETE~COMMIT~ROLLBACK~GRANT~REVOKE~CREATE TABLE~ALTER TABLE~DROP TABLE~CREATE VIEW~ALTER VIEW~DROP VIEW~CREATE INDEX~ALTER INDEX~DROP INDEX~CREATE ROLE~DROP ROLE~SET TRANSACTION~START TRANSACTION~%INTRANSACTION~%BEGTRANS~%INTRANS~GET~SET OPTION~STATISTICS~%CHECKPRIV~CREATE USER~ALTER USER~DROP USER~%CHECKPRIV~GRANT~REVOKE~CREATE FUNCTION~CREATE METHOD~CREATE PROCEDURE~CREATE QUERY~DROP FUNCTION~DROP METHOD~DROP PROCEDURE~DROP QUERY~CREATE TRIGGER~DROP TRIGGER~CALL~SAVEPOINT~LOCK TABLE~UNLOCK TABLE~CREATE DATABASE~DROP DATABASE~USE DATABASE~TUNE TABLE~DECLARE~CREATE MODEL~DROP MODEL~TRAIN MODEL~ALTER MODEL~VALIDATE MODEL~SET ML~CREATE ML CONFIGURATION~ALTER ML CONFIGURATION~DROP ML CONFIGURATION~FREEZE PLANS~UNFREEZE PLANS~PURGE~BUILD INDEX~CREATE AGGREGATE~DROP AGGREGATE~LOAD~CREATE SCHEMA~DROP SCHEMA~CREATE SERVER~ALTER SERVER~DROP SERVER~CREATE FOREIGN TABLE~ALTER FOREIGN TABLE~DROP FOREIGN TABLE~CANCEL QUERY~EXPLAIN~THROUGH~ALTER SCHEMA~BUILD DEFERRED~"
	RETURN $p(sqlStmtTypes,"~",t)
}
 
 
	// Define a cached query as being Stale
	// Called from DeleteExtentCQ
DefineCQAsStale(class,lock=1,ns="",purgeShards=1,skipltt=0) [] PUBLIC {
		#; Make stale this CQ
	set gotlock=0,transflag=0,sc=$$$OK
	try {
		set:ns="" ns=$namespace
			#; Get data without any locks
		set cqdata=$get($$$CQns("QueryRoutine",class))
			#; If nothing defined, just return
		RETURN:cqdata="" 1
		set $lg(cqver,cqhash,,,,,,cqlock,,,,,,,caller)=cqdata
		if $case(cqver,8:0,9:0,11:0,:1) { do PurgeRtn(class,1,ns) goto exit }	// These cq versions do not support regeneration
		elseif cqver=8 {
			set queryData=$$$CQns("Query",cqver,cqhash,class)
			if $ll(queryData)<2 { do PurgeRtn(class,1,ns) goto exit }	// These cq are %SQL.ResultSet and do not support regeneration
			if $lg(queryData,8)="DOCTYPE" { do PurgeRtn(class,1,ns) goto exit }	// These cqs are dialect=DOCTYPE (JSON_TABLE) and do not support regeneration
		}
		if cqver=11,caller[($$$CQRoutinePrefix_"TEMPj") { do PurgeRtn(class,1,ns) goto exit }	// Embedded SQL from RunTempCode temp cached routines will not be regenerated
		set:cqlock="" cqlock=cqhash
			#; Now if we have lock node information use it to lock just this one query rather than locking everything
		if lock {
			set gotlock=1
			lock +$$$CQns("Query",cqver,cqlock):$$$CQGetLockTO
			if '$test { set gotlock=0 quit }
				#; Get out if the CQ no longer exists
			quit:$get($$$CQns("QueryRoutine",class))=""	// CQ has been purged
		}
		goto:$d($$$CQns("Stale",class)) exit	// alredy Stale
			#;  If this call is performed as part of a transaction, we don't want the CQ returning to non-Stale if there is a ROLLBACK
		$$$SuspendAllTrans(transflag)
		$$$AddAllRoleTemporaryInTry
		if '$d($$$CQns("RTQ",class)),'$d($$$CQns("RTQ2",class)) {	// Not an RTPC utility CQ or an RTPC runtime CQ
			set $$$CQns("Stale",class)=$zu(188)
			if cqver=9,$d($$$srv),$$$logging { do ##class(%SYS.DBSRV).logappend("CQ "_class_" marked as Stale") }
		} else {
			do PurgeRtn(class,1,ns)
		}
		if cqver'="",cqhash'="",$data($$$CQns("Query",cqver,cqhash,class,"LTT"),ltt)#10=1 {
			set $$$CQns("OrphanLTT",ltt,lock)=""
		}
			#; If we are called with lock=0 then the caller can call job PurgeOrphanLTT when it has all the queries marked as stale
		if lock,'skipltt,$data($$$CQns("OrphanLTT")) {
				#; We want a separate job to do the purge do it does not share any locks with this process
			set queue=$system.WorkMgr.Initialize("",.sc)
			if $isobject(queue) {
					#; Free lock in case PurgeOrphanLTT is trying to modify this CQ
				if gotlock { lock -$$$CQns("Query",cqver,cqlock)#"I" set gotlock=0 }
				set sc=queue.Queue("$$PurgeOrphanLTT^%SYS.SQLSRV",ns)
				set sc=queue.Sync("-d")
			} else {
				set sc=$$PurgeOrphanLTT(ns)
			}
		}
	} catch {
		set sc=$$$ERROR($$$ObjectScriptError,$zerror)
	}
exit
	if transflag { $$$ResumeAllTrans(transflag) }
	if gotlock { lock -$$$CQns("Query",cqver,cqlock)#"I" }
	RETURN $$$ISOK(sc)
}
.
Purge(days=0,ns="",purgeShards=1,nsdelete=0,regenerate=0) [] PUBLIC {
		#; Purge all cached queries in the namespace passed in 'ns' - days is obsolete, always perform as if days=0
		#; no variables need be defined when calling $$purge()
		#; If regenerate=1 do not purge, but regenerate the cached statement
		#; return: nothing
 
 	set $ztrap="error"
	$$$SuspendAllTrans(flag)
	set:ns="" ns=$namespace
		#; If we wish to purge in a non local namespace then try swapping to %SYS, if it works we have permissions to do this anyway
	if ns'=$namespace,$namespace'="%SYS" {
		try {
			new $namespace
			set $namespace="%SYS"
		} catch {
			set %qrc=114,%msg=$$$Text("A non local namespace may only be purged if this process has privileges to switch to the %SYS namespace","%SQL.Server") Goto exit
		}
	}
.
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
.
		#; If we can not get a lock someone else in purging this namespace already so just exit
	lock +$$$CQns("PurgeRunning"):0 if '$test { goto exit }
		#; Only purge cached queries not prepared in the last 'days' days
	set rtn="" 
	new %SNInPurge set %SNInPurge=1
	for  {
		set rtn=$o($$$CQns("QueryRoutine",rtn)) q:rtn=""
		if days,($h-days)'>$$$CQns("LastPrepare",rtn) { continue }  // cached query was last Prepared with in the last 'days' days, do not purge it
		if regenerate {
			set sc=$SYSTEM.SQL.RegenerateQuerySource(rtn)
			if $$$ISERR(sc) { set purged=$$PurgeRtn(rtn,1,ns,,1) }	// Regenerate failed, make sure it is purged
		} else {
			set purged=$$PurgeRtn(rtn,1,ns,,1)
		}
	}
	
		#; Remove the pre-parse cache
	$$$KillRootNode(^IRIS.Temp.StatementHashPP)
.
	if $data($$$CQns("OrphanLTT")) {
			#; We want a separate job to do the purge do it does not share any locks with this process
		set queue=$system.WorkMgr.Initialize("",.sc)
		if $isobject(queue) {
			set sc=queue.Queue("$$PurgeOrphanLTT^%SYS.SQLSRV",ns,nsdelete)
			set sc=queue.Sync("-d")
		} else {
			set sc=$$PurgeOrphanLTT(ns,nsdelete)
		}
	}
	kill $$$CQns("SQLPreparse")
		#; Purge any sp_executesql cached procedures (DPV3314)
	set hash="" 
	for  {
		set hash=$o($$$CQns("sp_executesql",hash),1,data) quit:hash=""
		do $SYSTEM.OBJ.Delete($lg(data),"-d")
	}
	kill $$$CQns("sp_executesql")
		#;  Now Purge $$$CQ("LastError",$J) nodes which are no longer 'active'
	set job=""
	for {
		set job=$o($$$CQns("LastError",job)) quit:job=""
		try {
				#; $zu(67,pid)=0 means the job no longer exists. This is better than $v(-1) (from Steve Clay, email, 09/24/2009)
			kill:$zu(67,job)=0 $$$CQns("LastError",job)
		}
		catch {}	// Don't worry about an error, just continue on
	}
	do PurgeCheckDeleted()
	do:purgeShards Purge^%SYS.SHARDSRV(days,ns)
		#; Can we tidy up the globals if nothing is left?
	if $order($$$CQns("QueryRoutine",""))="" { do PurgeClean(ns) }
.
exit	// get out
	lock -$$$CQns("PurgeRunning")#"I"
	$$$ResumeAllTrans(flag)
	RETURN
error	set $ztrap=""
	do BACK^%ETN
	goto exit
}
.
PurgeClean(ns) {
 	set $ztrap="error"
 		#; If we can not quickly get this lock then someone else is doing something in here so leave these extra nodes
 		#; around, we do not have to purge them, it is just a 'would be nice' situation.
	lock +$$$CQns("Query"):1 RETURN:'$test
	if $order($$$CQns("QueryRoutine",""))'="" Goto exit
		#; They purged all cached queries in the namespace
		#; Go ahead and clean up the cached query global for this namespace in case there is garbage in it.
		#; This will help prevent cases where multiple cached queries use the same cq routine.
	kill $$$CQns("Query"),$$$CQns("QueryRoutine"),$$$CQns("QueryText"),$$$CQns("Package"),$$$CQns("NextRtn"),$$$CQns("NextCls"),$$$CQns(2),$$$CQns("LastPrepare"),$$$CQns("RTQ"),$$$CQns("RTQ2"),$$$CQns("Stale")
exit	lock -$$$CQns("Query")#"I"
	QUIT
error	set $ztrap=""
	Do BACK^%ETN
	goto exit
}
.
#; Are there any entries from namespaces that no longer exist
PurgeCheckDeleted() {
	Do List^%SYS.NAMESPACE(.nslist)
	Set ns=0
	For {
		Set ns=$order($$$CQroot(ns)) Quit:ns=""
		#; Ignore implied namespace entries which is what the 's' check does
		If $extract(ns)'="s",'$data(nslist(ns)),ns'=$namespace {
			#; If here then we have $$$CQ entry for a namespace that no longer exists
			#; So remove everything in here, we already have %All from the caller
			#; Need to be in %SYS so we can see all the routines/classes
			If $namespace'="%SYS" New $namespace Set $namespace="%SYS"
.
	 		#; If we can not quickly get this lock then someone else is doing something in here so leave these extra nodes
			lock +$$$CQns("Query"):0 continue:'$test
			#; Now double check namespace is still deleted
			Kill nslist Do List^%SYS.NAMESPACE(.nslist)
			If $data(nslist(ns)) Lock -$$$CQns("Query")#"I" Continue
.
			#; Remove any routine/classes with this prefix, 
			Set rtnprefix=$$$CQRoutinePrefixns,clsprefix=$$$CQPackagens
			Set cls=clsprefix
			For {
				Set cls=$order(^oddDEF(cls)) Quit:cls=""||($extract(cls,1,$length(clsprefix))'=clsprefix)
				set sc=$$Delete^%apiOBJ(cls,"-d")
			}
			Set rtn=rtnprefix
			For {
				Set rtn=$order(^rINDEX(rtn)) Quit:rtn=""||($extract(rtn,1,$length(rtnprefix))'=rtnprefix)
				Do RtnDelete(rtn,1)
			}
			Kill $$$CQroot(ns)
			Lock -$$$CQns("Query")#"I"
		}
	}
}
.
PurgeRtn(rtn,lock=1,ns="",purgeShards=1,skipltt=0) [] PUBLIC {
	#; Do not fire any source control hooks below this point
	new %SourceControl
	if ns="" {
		set ns=$namespace
	} else {
		#; We either purge in %SYS or in the current namespace
		if $namespace'="%SYS",ns'=$namespace { ZT "PurgeNS" }
	}
		#; purge this routine.  First delete it from $$$CQ
	set flag=0,$ztrap="PurgeRtnError",sc=$$$OK
		#; Get data without any locks
	set cqdata=$get($$$CQns("QueryRoutine",rtn))
		#; If nothing to purge just return
	RETURN:cqdata="" 1
	set cqver=$listget(cqdata,1),cqhash=$listget(cqdata,2),extentlist=$listget(cqdata,4),cqlock=$listget(cqdata,8,cqhash),dblist=$listget(cqdata,9)
	if cqlock="" { set cqlock=cqhash }
		#; Now if we have lock node information use it to lock just this one query rather than locking everything
	if lock {
			// We no longer wait here for the lock timeout.  If the CQ is locked, just don't purge it.
			// Purging is not as important as it once was.  If the CQ is stale, the RandomSig check in the %OnNew of the CQ instantiation will catch it.
		lock +$$$CQns("Query",cqver,cqlock):0	//$$$CQGetLockTO
		if '$test { set lock=0 GOTO exit }
			#; If data no longer matches someone else much have purged the routine and maybe recreated it so we can return
		if cqdata'=$get($$$CQns("QueryRoutine",rtn)) { GOTO exit }
	}
		#; clean up RTPC runtime queries associated with this rtn
	do PurgeRtqs^%SYS.SQLRTUMAKER(rtn,ns) ; Purge the RTPC runtime queries associated with this rtn JSL5032,JSL5046
		#; clean up any SQLStats that might have been generated
	if $$$namespaceExists(ns) { // --- Conditionally Invoke PTools/SQLStats Methods ---
		set status=$$PurgeRtn^%SYS.PToolsDEP(ns,rtn)			// MRP963  [DEPRECATED]
		set status2=$$clearStatsSQL^%SYS.PTools(ns,rtn,0,1,1,0)
	}
		#;  If this Purge is performed as part of a transaction, 
		#;  we don't want the CQ coming back into existence if there is a ROLLBACK.
	set flag=0 
	$$$SuspendAllTrans(flag)
		#; DPV2749 $$$DisableJournal
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	if cqver'="",cqhash'="",$data($$$CQns("Query",cqver,cqhash,rtn,"LTT"),ltt)#10=1 {
		set $$$CQns("OrphanLTT",ltt,lock)=""
	}
		#; For CRS (cached result sets) don't touch $$$CQ unless the class is successfully deleted
		#; Delete^%apiOBJ will also kill off some $$$CQ items
	if cqver>7 {
		try {
			kill $$$CQns("Stale",rtn)	// If we are going to delete it, first unmark it as Stale
			set sc=$$Delete^%apiOBJ(rtn,"-d",,1)
				#; make class name available for reuse if it starts with current classname prefix
			set i=$$$CQPackagens_".cls"
			set thisrtn=rtn
			if $e(thisrtn,1,$l(i))=i { set $e(thisrtn,1,$l(i))="" if thisrtn=+thisrtn { set $$$CQns("NextCls",thisrtn)=1955 }}
		}
		catch tException {
			throw tException
		}
		goto:$$$ISERR(sc) exit
	}
	set ptr=0,dbptr=0
	while $listnext(extentlist,ptr,extent) {
		if dblist'="",$listnext(dblist,dbptr,extentdb) {
		} else {
			set extentdb=$$$ExtentDBNS(ns,extent),dblist=""
		}
		kill $$$CQns(2,extentdb,extent,rtn),$$$CQPackageIndexns($$$AllButLastPiece(extent,"."),$$$LastPiece(extent,"."),rtn)
	}
	kill $$$CQns("LastPrepare",rtn),$$$CQns("QueryRoutine",rtn),$$$CQns("QueryText",rtn)
		#; DPV2749 i cqver=""||(cqhash="") d:cqver'=8 RtnDelete(rtn,1,ns) l:lock -$$$CQns("Query")#"I" If flag { $$$ResumeTrans } $$$EnableJournal QUIT
	if cqver=""||(cqhash="") {
		do:cqver&&(cqver<8) RtnDelete(rtn,1,ns)
		goto exit
	}
	kill $$$CQns("Query",cqver,cqhash,rtn)
	if cqver=9,$d($$$srv),$$$logging { do ##class(%SYS.DBSRV).logappend("CQ "_rtn_" Purged") }
	do:cqver&&(cqver<8) RtnDelete(rtn,0,ns)
	#; If we are called with lock=0 then the caller can call job PurgeOrphanLTT when it has all the queries removed
	if lock,'skipltt,$data($$$CQns("OrphanLTT")) {
			#; We want a separate job to do the purge do it does not share any locks with this process
		set queue=$system.WorkMgr.Initialize("",.sc)
		if $isobject(queue) {
			#; Free lock in case PurgeOrphanLTT is trying to modify this CQ
			if lock { lock -$$$CQns("Query",cqver,cqlock)#"I" set lock=0 }
			set sc=queue.Queue("$$PurgeOrphanLTT^%SYS.SQLSRV",ns)
			set sc=queue.Sync("-d")
		} else {
			set sc=$$PurgeOrphanLTT(ns)
		}
	}
exit
	if flag { $$$ResumeAllTrans(flag) } 
	if lock { lock -$$$CQns("Query",cqver,cqlock)#"I" }
.
	RETURN $$$ISOK(sc)
PurgeRtnError
	set $ztrap=""
	set sc=$$$ERROR($$$ObjectScriptError,$zerror)
	goto exit
}
.
PurgeOrphanLTT(ns,nsdelete=0) public {
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	If $namespace'=ns,'nsdelete {
		#; Try using the target namespace, but fall back to %SYS if we can not swap here
		New $namespace
		Try {
			Set $namespace=ns
			If $data(^dummyGbl)
		} Catch {
			Set $namespace="%SYS"
		}
	}
	$$$SuspendErrorCount  ; If an error in Delete happens we do not want to count or report it, never purge will remove this LTT
	Set ltt=""
	For {
		Set ltt=$order($$$CQns("OrphanLTT",ltt)) Quit:ltt=""
		#; Delete will fail if there is still a shared lock on the LTT class
		Set sc=$$Delete^%apiOBJ(ltt,"l-d",,1)
		If $$$ISERR(sc) Continue
		Kill $$$CQns("OrphanLTT",ltt)
	}
	Quit $$$OK
}
 
RtnDelete(rtn,noreset=0,ns="") [] PUBLIC {
	If ns="" {
		Set ns=$namespace
	} Else {
		#; We either purge in %SYS or in the current namespace
		If ns'="%SYS",ns'=$namespace ZT "PurgeNS"
	}
	Set $ztrap="trap"
	#;  If this Purge is performed as part of a transaction, 
	#;  we don't want the CQ coming back into existence if there is a ROLLBACK.
	$$$SuspendAllTrans(flag)	// DPV2006=
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	#; Delete routine code
	$$$AuditRtnPurge(ns,rtn)
	k ^rMAC(rtn),^rMAP(rtn),^rMACSAVE(rtn),^ROUTINE(rtn),^rOBJ(rtn),^rINDEX(rtn,"OBJ"),^("MAC"),^("INT"),^("BAS")	// DPV2905
	do:$d($$$SQLIndex(2,rtn)) DeleteSQLIndex(rtn)
	if noreset { goto exit }
	#; make routine name available for reuse if it starts with current routine prefix
	s i=$$$CQRoutinePrefixns
	if $e(rtn,1,$l(i))=i {
		set $e(rtn,1,$l(i))="" 
		set:rtn=+rtn $$$CQns("NextRtn",rtn)=1955
	}
exit	$$$ResumeAllTrans(flag)	// DPV2006=
	Quit
trap
	Set $ztrap=""
	Set sc=$$$ERROR($$$ObjectScriptError,$zerror)
	Goto exit
}
.
#; This is called when we activate a namespace
PurgeOneNamespace(ns="",job=1,purgeShards=1,nsdelete=0,days=0,regenerate=0) public {
	set sc=$$$OK
	try {
		if job {
			job Purge^%SYS.SQLSRV(days,ns,purgeShards,nsdelete,regenerate)::5 if '$test { do Purge(days,ns,purgeShards,nsdelete,regenerate) }
		} else {
			do Purge(days,ns,purgeShards,nsdelete,regenerate)
		}
	} catch {
		set sc=$$$ERROR($$$ObjectScriptError,$ze)
	}
	RETURN sc
}
.
PurgeAllNamespaces(purgeShards=1,days=0,regenerate=0) [] PUBLIC {
		#; Purge all cached queries in all namespaces on this system that have not had a Prepare in the last 'days' days.  
		#; If days=0, then purge all Cached Queries.
		#; If days is not specified, then the default is 0 (All)
		#; if regenerate=1, regenerate the CQs instead of purging them
		#; no variables need be defined when calling $$purge()
		#; return: nothing
 
	set cqNamespace=$$GetCacheDatabase()
	set ns="",tZE=$ze
	for  {
		set ns=$o($$$CQrootExtended(cqNamespace)(ns)) quit:ns=""
		do PurgeOneNamespace(ns,0,purgeShards,,days,regenerate)
	}
	RETURN
}
.
.
PurgeAllNamespacesUpgrade() [] PUBLIC {
		#; Purge all cached queries in all namespace on this system
		#; Called during Upgrade or when system is not in use, for example when the system is upgraded.
		#; Assume no server processes running and assume this function is not called from within a transaction
		#; return: nothing
		#;  Assume this API is ONLY called with a user that has the %All role!!!
		
	set ns=$$DatabaseByName^%SYS.CONFIG("IRISLOCALDATA") // Can't use $$GetCacheDatabase here, per Steve Clay May 19,2010
	QUIT:ns=""
		
	try {
			#; delete all CLASSES in the IRISLOCAL database - brute force!
		kill ^|ns|oddCOM,^|ns|oddDEF,^|ns|oddEXT,^|ns|oddEXTR,^|ns|oddMAP,^|ns|oddPKG,^|ns|oddPROC,^|ns|oddSQL,^|ns|oddStudioDocument,^|ns|oddStudioMenu,^|ns|rINDEXCLASS,^|ns|rINDEXSQL
		#; delete all ROUTINES in the CACHE database - brute force!
		kill ^|ns|rMAC,^|ns|rMAP,^|ns|rMACSAVE,^|ns|ROUTINE,^|ns|rINDEX
		#; Kill the rOBJ global. We must do this one by one because of routine invalidation
		f  { s rtn=$o(^|ns|rOBJ("")) q:rtn=""  k ^|ns|rOBJ(rtn) }
		#; delete ^%sqlcq global
		kill ^|ns|%sqlcq
		#;Reset the index timestamp
		s ^|ns|rINDEX=$ztimestamp
		s ^|ns|rINDEXCLASS=$ztimestamp
.
			#; UCQ cached queries against tables in IRISSYS end up in %SYS.sqlcq.* cached query classes.  These live in IRISSYS, not IRISLOCALDATA
			#; The brute-force kill of the CQ metadata above propbably left some orphaned %SYS.sqlcq classes, which we will delete now
			#; Note, we should already be in the IRISSYS database when this is called from INSTALL...
			#; At first I tried a DeletePackage call here, but a CQ that does not save source is Deployed, and DeletePackage skips deployed classes.
		set class="%SYS.SQLCQ."
		for  {
			set class=$o(^rINDEXCLASS(class),1,data) quit:class=""  quit:class'[".SQLCQ."
			do $system.OBJ.Delete($lg(data,2),"-d")
		}
		QUIT:ns=""
	}
	catch {
		$$$SevereMsg("Error Purging Cached Queries from IRISLOCALDATA database "_ns_":  $ZERROR = "_$ze_", $zu(56,2)="_$zu(56,2))
	}
	QUIT
}
.
PurgeUpgrade() [] PUBLIC {
		#; Purge all OLD ^mcq cached queries in the current namespace
		#; Called during Upgrade when system is not in use, for example when the system is upgraded.
		#; Assume no server processes running and assume this function is not called from within a transaction
		#; return: nothing
 
		#; move any ^mcq("init code") into its new home
	if $g(^mcq("init code"))'="" set $$$SQLServerInitCode=^mcq("init code") kill ^mcq("init code")
	if $zu(12,"")'="",$g(^%SYS("sql","server","init code",$zu(12,"")))'="" set $$$SQLServerInitCode=^%SYS("sql","server","init code",$zu(12,"")) kill ^%SYS("sql","server","init code",$zu(12,""))
		#; move any ^mcq("disconnect code") into its new home 
	if $g(^mcq("disconnect code"))'="" set $$$SQLServerDisconnectCode=^mcq("disconnect code") kill ^mcq("disconnect code")
	if $zu(12,"")'="",$g(^%SYS("sql","server","disconnect code",$zu(12,"")))'="" set $$$SQLServerDisconnectCode=^%SYS("sql","server","disconnect code",$zu(12,"")) kill ^%SYS("sql","server","disconnect code",$zu(12,""))
.
	s rtn="" for  s rtn=$o(^mcq("QueryRoutine",rtn)) q:rtn=""  set purged = $$PurgeUpgradeRtn(rtn)
		#; They are Purging all cached queries in the namespace
		#; Go ahead and clean up the cached query global for this namespace in case there is garbage in it.
		#; This will help prevent cases where multiple cached queries use the same cq routine.
.
	k ^mcq("Query"),^mcq("QueryRoutine"),^mcq("QueryText"),^mcq("Package"),^mcq("NextRtn"),^mcq("LastError")
	s extent="" f  s extent=$o(^oddEXTR(extent)) q:extent=""  s rtn="" f  s rtn=$o(^oddEXTR(extent,"cq",$zu(110),$namespace,rtn)) q:rtn=""  Do:'$$GlobalInReadOnlyDB("oddEXTR",extent) KillCQClassxRef(extent,rtn)
.
		#; Purge any sp_executesql cached procedures (DPV3314)
	s hash="" for  { set hash=$o(^mcq("sp_executesql",hash),1,data) q:hash=""  do $SYSTEM.OBJ.Delete($lg(data),"-d") } kill ^mcq("sp_executesql")
	QUIT
}
.
PurgeUpgradeRtn(rtn) [] PUBLIC {
		#; purge this routine.  First delete it from $$$CQ
	set flag=0,$ztrap="PurgeUpgradeRtnError"
	set cqdata=$get(^mcq("QueryRoutine",rtn)),cqver=$listget(cqdata,1),cqhash=$listget(cqdata,2),extentlist=$listget(cqdata,4)
		#; For CRS (cached result sets) don't touch $$$CQ unless the class is successfully deleted
		#; Delete^%apiOBJ will also kill off some $$$CQ items
	if cqver>7 {
		kill ^mcq("DynamicSQLPreparse")
		try {
			set sc=$$Delete^%apiOBJ(rtn,"-d")
		}
		catch tException {
			throw tException
		}
		QUIT:('sc) $Select($d(^oddCOM(rtn)):0,1:1)
	}
	for i=1:1:$listlength(extentlist) do:'$$GlobalInReadOnlyDB("oddEXTR",$list(extentlist,i)) KillCQClassxRef($list(extentlist,i),rtn) kill ^mcq("Package",$p($list(extentlist,i),".",1,$l($list(extentlist,i),".")-1),$p($list(extentlist,i),".",$l($list(extentlist,i),".")),rtn)
	kill ^mcq("QueryRoutine",rtn),^mcq("QueryText",rtn)
	if cqver=""||(cqhash="") do:cqver<8 RtnDeleteUpgrade(rtn) QUIT 1
	kill ^mcq("Query",cqver,cqhash,rtn)
	do:cqver<8 RtnDeleteUpgrade(rtn)
	QUIT 1
 
PurgeUpgradeRtnError
	s $zt="" QUIT 1
}
.
RtnDeleteUpgrade(rtn) [] PUBLIC {
	  #; Delete routine code
	$$$AuditRtnPurge($namespace,rtn)
	kill ^rMAC(rtn),^rMAP(rtn),^rMACSAVE(rtn),^ROUTINE(rtn),^rOBJ(rtn),^rINDEX(rtn,"OBJ"),^("MAC"),^("INT"),^("BAS")
	do DeleteSQLIndex(rtn)
	QUIT
}
.
/// Run periodically by daemon instantiated in WQMSRV^STU1
/// 
/// Loops over all of the namespaces on the system and switches into them if they're available (i.e. if entering that namespace would not cause an
/// unmounted database to be mounted.
///
/// In each namespace, we check for any conversion listed in ^IRIS.ConversionCleanup(conversionID) so that we can cleanup (delete) the old data for
/// table conversions that were never cleaned up originally. This global is local to each namespace, hence looping over the namespaces.
/// To do this, we loop over the global and try to acquire a lock on each conversion ID. If we do, then we also just cross reference that the CONVERSIONCLEANUP parameter on
/// the class associated with that conversion ID is equal to that conversion ID. Then we will proceed with running the cleanup routine. When we succeed with that we will delete the routine.
/// 
/// *************** !! IMPORTANT NOTE !! ***************
/// This procedure is run periodically as set up by WQMSRV^STU1 during startup. WQMSRV^STU1 establishes that periodic behavior with a security context,
/// and for this action it will have %All context -- so this will always be run with the %All role by the WQM!! Any additions to this procedure should keep this
/// in mind and make sure that we're only doing things in here that we are ok with being done with %All!!
/// 
/// The format of ^IRIS.ConversionCleanup is below. Recall that this is local to each namespace:
/// 
/// ^IRIS.ConversionCleanup = incrementing counter
/// ^IRIS.ConversionCleanup(conversionID) = "row" | "columnar"       specifies type of conversion "row" = col->row, "columnar" = row->col
/// ^IRIS.ConversionCleanup(conversionID, "classname") = name of the associated class that this cleanup is for
/// ^IRIS.ConversionCleanup(conversionID, "tablename") = name of the associated table that this cleanup is for
/// ^IRIS.ConversionCleanup(conversionID, "columnMapArray", col#1) = for columnar conversion, need to clean up an old row so this is an array of the specific columns that need to be cleaned
/// ^IRIS.ConversionCleanup(conversionID, "columnMapArray", col#2) = This (plus any other idx under columnMapArray) will be merged into a %d array for the cleanup logic
/// ^IRIS.ConversionCleanup(conversionID, "ranges", ...) = again meant to be merged into a local var, contains the ranges for breaking the cleanup amongst various workers
/// ^IRIS.ConversionCleanup(conversionID, "noclean") = 1 if we should not run the automatic cleanup setup by WQMSRV^STU1
/// ^IRIS.ConversionCleanup(conversionID, "error") = error text describing why the last attempted cleanup failed
/// ^IRIS.ConversionCleanup(conversionID, "attempts") = # of attempted cleanups
/// ^IRIS.ConversionCleanup(conversionID, "lastattempt") = the day (+$h) this cleanup was last attempted
/// ^IRIS.ConversionCleanup(conversionID, "code") = array of INT code that will be used to build a routine to run (use merge into/out of)
/// 
CleanUnfinishedConversions() [ranges, %check, %d] PUBLIC {
	set errors = $$$OK, sc = $$$OK
	try {
		// Get a list of all of the namespaces. We'll loop over that because all of the cleanups are kept in a namespace-specific global
		do List^%SYS.NAMESPACE(.nslist)
		new $namespace // To make sure we end up back in the original namespace after we leave this procedure
		set ns = ""
		for { // loop over namespaces
			set ns = $o(nslist(ns))
			QUIT:ns=""
			// swapNS returns the number of days since we were last able to use ns
			// If swapNS switched to ns, it returns "", so nsIsUnavailable will be a positive integer (i.e. true) if the namespace isn't able to be used
			set nsIsUnavailable = $$swapNS(ns)
			if 'nsIsUnavailable { // $namespace is now ns! 
				// If nothing is there for this namespace just go to the next one
				continue:($d($$$ConversionCleanupCount)<10)
				// Loop over ^IRIS.ConversionCleanup and check for unfinished conversions
				set conversionID = ""
				for {
					// ConversionCleanupType is also the base node to loop over (it contains the type of conversion)
					set conversionID = $o($$$ConversionCleanupType(conversionID))
					QUIT:conversionID=""
					// The routine that calls cleanUpConversion^%apiDDL should always handle locking!!
					lock +$$$ConversionCleanupType(conversionID):$$$LockTimeout
					CONTINUE:'$test
					// The noclean node is the only node in the ^IRIS.ConversionCleanup that this procedure really has to handle, the rest is handled directly
					// in cleanUpConversion^%apiDDL. That procedure will do two important things: (1) if we attempted this one already and it failed, we'll 
					// switch to trying it only once a day. Then (2) if we've had a week straight of daily failures, it will set the "noclean" node and will log 
					// an error message to messages.log because we will stop trying to autoclean and the user should investigate. Investigate in this case
					// means checking ^IRIS.ConversionCleanup(conversionID). We report the conversionID in the message to do so
					// noclean will also be set if the user runs ALTER TABLE...CONVERT...%NODELDATA, meaning they must run an explicit ALTER TABLE...CLEANUP
					CONTINUE:$g($$$ConversionCleanupNoClean(conversionID))
					// If successful procedure will delete the cleanup routine, dequeue the cleanup, and remove the CONVERSIONCLEANUP param from the class
					set sc = $$cleanUpConversion^%apiDDL(conversionID)
					do:$$$ISERR(sc) $system.Status.AppendStatus(errors, sc)
					lock -$$$ConversionCleanupType(conversionID)
				}
			} else {
				continue
			}
		}
	} catch ex {
		lock:$g(conversionID) -$$$ConversionCleanupType(conversionID) // we might have a lock out
		do $system.Status.AppendStatus(errors, ex.AsStatus())
	}
	RETURN errors
}
.
.
	// I don't see where this is called anymore (DPV 02/13/2014)
#IF 0	;
SetCompileMode(mode) [] PUBLIC {	// DPV1991+
		#;  Set the %SQLCompileMode flag to "RUNTIME", or "ODBC"
		#;  If RUNTIME, set the process runtime mode in $zu(115,5)
		#;  $zu(115,5) == RUNTIME Mode
		#;          0:  LOGICAL mode
		#;          1:  ODBC mode
		#;          2:  DISPLAY mode
	  i $g(mode)="" k %SQLCompileMode QUIT
	  s %SQLCompileMode=$$$UPPER(mode) 
	  If %SQLCompileMode'="ODBC" {
		  If %SQLCompileMode="DISPLAY"     { d $zu(115,5,2) }
		  ElseIf %SQLCompileMode="LOGICAL" { d $zu(115,5,0) }
		  Else                             { d $zu(115,5,1) }  // Use ODBC mode even if they supplied garbage for mode
		  s %SQLCompileMode="RUNTIME"
	  }
		  
	  QUIT
	}	// DPV1991-
#ENDIF
	
 
	// Called from:
	// - GetRTHash()
	// - %qaqqt
	// - %SYS.PTools
	// - %qaqplansave
	// - %SYS.PTools.SQLUtilities.PossiblePlans() method
Hash(str,sqltext,sqlHVarTypes) [] PUBLIC {
		#;  Take a str and an array of SQL Text and return a hash value
		#;  str should be a $List already
		#;  sqltext() is PBR and is an array of strings.  We'll put them in lists
		#;  sqlHVarTypes() is PBR and is an array of $Lists.  
		#;
		#;  You feed the hash a binary stream so if it contains Unicode then $zwunpack
		#;  it first, or $lb it. With this hash you can hash the entire SQL string and
		#;  not just the first 10k (or whatever the current limit is). As the hash it 20
		#;  bytes you can assume if there is a match then you do not need to check the
		#;  actual string, so the cache will not have the original SQL in it (or at
		#;  least the part of the cache where you are looking up referenced will not,
		#;  you may have a pointer to the original SQL for reporting purposes but this
		#;  is never used in the lookup). This makes the cache very dense and therefore
		#;  fast.
 
 	Do $System.Encryption.SHAHashReset(160)
	Do $system.Encryption.SHAHashInput(160,str)
	s i="" For  { s i=$o(sqltext(i),1,tmp) q:i=""  Do $system.Encryption.SHAHashInput(160,$lb(tmp)) }
	s i="" For  { s i=$o(sqlHVarTypes(i),1,tmp) q:i=""  Do $system.Encryption.SHAHashInput(160,tmp) }
	QUIT $System.Encryption.Base64Encode($System.Encryption.SHAHashResult(160))
}
.
	#; Internal version of hash to create two hashes without duplicating work.
	;# 	hash1 returned by reference includes 'defaultschema'
	#;  hash2 does not. 
	#; Arguments otherwise are same as $$Hash above 
	#; Called from Prepare
hash(&hash1,&hash2,defaultschema,str,&sqltext) PRIVATE {
	do $System.Encryption.SHAHashReset(160)
	do $system.Encryption.SHAHashInput(160,str)
	set i="" For  { set i=$o(sqltext(i),1,tmp) quit:i=""  do $system.Encryption.SHAHashInput(160,$lb(tmp)) }
	set hash2=$zstrip($System.Encryption.Base64Encode($System.Encryption.SHAHashResult(160)),">","=")
	set hash1=$zstrip($System.Encryption.Base64Encode($System.Encryption.SHA1Hash($lb(hash2,defaultschema))),">","=")
	RETURN
}
 
 
	#;  The following functions are used when access to Dynamic SQL Cached Query metadata is needed.
	#;  Since CQ metadata is stored in CACHESYS, it must be referenced from a %SYS routine.
 
#define CachedQueryVersion      7
 
	#; Called from
	#;    %occResultSet, %ourQuery
GetCQNode(version,hash,rtn,node) [] PUBLIC { QUIT $$$CQ("Query",version,hash,rtn,node) }
 
	#; Called from
	#;    %occResultSet
GetCQColumn(version,hash,rtn,column) [] PUBLIC { QUIT $$$CQ("Query",version,hash,rtn,3,column) }
 
	#; Called from
	#;    %Library.SQLCatalog.GetCachedQueryTableCount
GetCQForTableCount(extentname) [] PUBLIC { s c=0,rtn="",extentdb=$$$ExtentDB(extentname) For  { s rtn=$o($$$CQ(2,extentdb,extentname,rtn)) q:rtn=""  s c=c+1 } QUIT c }
 
	#; Called from
	#;    %Library.DynamicQuery.Close
PurgeDDL(rtn) [] PUBLIC { If $lg($g($$$CQ("QueryRoutine",rtn)),5) { d PurgeRtn(rtn) } QUIT  }
 
	#; Called from
	#;    %SQL.Manager.Catalog.NamespacesWithXdbcErrorsFetch
CQErrorInNamespace(ns) [] PUBLIC { QUIT $o($$$CQns("LastError",""))'="" }
 
	#; Called from
	#;    %SQL.Manager.Catalog.SchemasFetch(package)
CQPackageIndexDefined(package) [] PUBLIC { QUIT $d($$$CQPackageIndex(package)) }
 
		#;  Given an extent name, delete all Cached Queries using this extent
		#;  Note, cached queries may be in other namespaces on this machine.
		#;  We don't worry about cached queries on other systems.
		#;  If markAsStale=1, instead of purging we will mark as stale
		#; If regenerate=1, we called from PurgeForTable^%apiSQL and we want to regenerate instead of Purge
		#;		If regenerate=2, regenerate in the background asynchronously
DeleteExtentCQ(extent,purgeShards=1,markAsStale=0,regenerate=0) [] PUBLIC {
		#; Called from:
		#;  PurgeForTable^%apiSQL  							Do DeleteExtentCQ^%SYS.SQLSRV(ext)
		#;  DropTable/DropView^%ocsSQLRTDict()				Do DeleteExtentCQ^%SYS.SQLSRV(extentname)
		#;  DeleteClassRuntime^%occClass					Do DeleteExtentCQ^%SYS.SQLSRV(classname,pTempDrop)
		#;  PostTune/ImportTuneStats^%qarTune				Do DeleteExtentCQ^%SYS.SQLSRV(extentname,1)
		#;  DropAggregate^%apiDDL							Deleting a UDAF
		#;  %SQL.Manager.Catalog							Multiple methods calls, DeleteExtentCQ^%SYS.SQLSRV(...,1)
		#;  %SYSTEM.SQL.SetFieldSelectivity()				do DeleteExtentCQ^%SYS.SQLSRV(extent,1)
		#;  %SYSTEM.SQL.Stats.Table...()					Multiple methods calls, DeleteExtentCQ^%SYS.SQLSRV(extent,1)
		#;  %ML.Model.%Train()								DeleteExtentCQ^%SYS.SQLSRV(..DefaultTrainedModel.ModelName)
		#;  %ML.TrainedModel.%DeleteTrainedModelTrigger()	DeleteExtentCQ^%SYS.SQLSRV({ModelName})
		#;  PurgeRtn may involve the deletion of a routine or class definition.
#if $$$SNRBDebug // JMM1152+
	if $g($$$SNRBCP)=0.2 {
		$$$SNRBDebugTrace("DeleteExtentCQ 1 "_$g(^IRIS.SM.Shard))
		s $$$SNRBCP="DeleteExtentCQ 1"_$g(^IRIS.SM.Shard)
	}
	elseif $g($$$SNRBCP)["DeleteExtentCQ 1" {
		$$$SNRBDebugTrace("DeleteExtentCQ 2"_$g(^IRIS.SM.Shard))
		$$$SNRBCheckpoint("DeleteExtentCQ 2"_$g(^IRIS.SM.Shard))
	}
	elseif $g($$$SNRBCP)["DeleteExtentCQ 2" {
		$$$SNRBDebugTrace("DeleteExtentCQ 3"_$g(^IRIS.SM.Shard))
		$$$SNRBCheckpoint("DeleteExtentCQ 3"_$g(^IRIS.SM.Shard))
	}
	elseif $g($$$SNRBCP)["DeleteExtentCQ 3" {
		$$$SNRBDebugTrace("DeleteExtentCQ 4"_$g(^IRIS.SM.Shard))
		$$$SNRBCheckpoint("DeleteExtentCQ 4"_$g(^IRIS.SM.Shard))
	}
	elseif $g($$$SNRBCP)["DeleteExtentCQ" {
		s num=$e($$$SNRBCP,16)
		$$$SNRBDebugTrace("DeleteExtentCQ "_(num+1)_$g(^IRIS.SM.Shard))
		$$$SNRBCheckpoint("DeleteExtentCQ 4"_$g(^IRIS.SM.Shard))
	}
#endif // JMM1152-
	// Propagate this call to shards, if we're not already within a call to Purge or
	// DeleteExtentCQ, and we haven't been specifically requested not to propagate this call,
	// and extent is not a cached query class (we can't propagate those, because there's no
	// predictable mapping between query classnames on the master and on shards)
	if '$d(%SNInPurge) {
		// Avoid propagating any indirectly nested calls 
		new %SNInPurge
		set %SNInPurge=1
		if purgeShards&&($extract(extent,1,6)'="%sqlcq"){
			do DeleteExtentCQ^%SYS.SHARDSRV(extent)
		}
	}
	set $zt="Error"
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	set ns="",extentdb=$$$ExtentDB(extent)
		// Do not regenerate CQs for sharded tables.  Compilation of SQL against sharded tables relies on public variables 
		// set by the shard server when preparing dynamic SQL statements.  Variables like %ISCSNRemoteTables and %ISCSNShardMapVersion.  
		// If the CQ regeneration does not have these variables defined, the compiled CQ will have the wrong code.  
	set tabinfo=$g($$$EXTsqlinfo($$$rEXT,extent))
	if $$$SQLLocTableSharded(tabinfo) { set markAsStale=0,regenerate=0 }	// if Sharded = 1 or 2, do not mark as Stale or Regenerate
	if $g(^%SYS("sql","sys","cqnoregen"),0) { set markAsStale=0,regenerate=0 }	// System is set to not perform CQ regeneration
	new $namespace
	for  { 
		set ns=$o($$$CQrootsys(ns)) quit:ns=""  
		set rtn="",cnt=0
		for  {	
			set rtn=$o($$$CQrootsys(ns,2,extentdb,extent,rtn)) quit:rtn=""
			if $namespace'=ns,$get(triedns)'=ns {
				try {
					set triedns=ns,$namespace=ns
				} catch {
					set $namespace="%SYS"
				}
			}
			if markAsStale||(regenerate=2) {	// regenerate=2 means regenerate in background
				do DefineCQAsStale(rtn)
				set cnt=cnt+1
			} elseif regenerate=1 {	// regenerate now
				set sc=$$RegenerateQuerySource(rtn,1,"")
				if $$$ISERR(sc) { do PurgeRtn(rtn,1,ns) }
			} else {
				do PurgeRtn(rtn,1,ns)
			}
		}
		if regenerate=2,cnt {
				// Kick off a daemon to recompile any "Stale" CQs in this namespace.  Ignore if there is any error
			set sc=$$QueueSystem^%SYS.WorkQueueMgr(,"$$RegenerateStaleCQsSingleNS^%SYS.SQLSRV")
		}
	}
	RETURN
Error
	set $zt=""
	#; *** Should we actually report an error???
	RETURN
}
.
	// Called from %SYSTEM.SQL.RegenerateQuerySource, RegenerateStaleCQsSingleNS, and DeleteExtentCQ
RegenerateQuerySource(classname="",purgeOnError=1,keepSource="") [] PUBLIC {
	RETURN:classname="" $$$ERROR($$$ClassNameRequired)
	set sc=$$$OK
	if '$d($$$CQ("QueryRoutine",classname),cqdata) {
		RETURN $$$ERROR($$$CachedQueryClassNotDefined,classname)
	}
	set $lg(type,hash)=cqdata
		#; At this time we do not support regernation for RTPC utility or runtime CQs
	if $d($$$CQ("RTQ",classname))||($d($$$CQ("RTQ2",classname))) {
		do PurgeRtn(classname,1,$namespace)
	}
	if type=9 { set sc=$$Regenerate(classname,purgeOnError,keepSource,1) }					// xDBC type cached query
	elseif type=8,$ll($$$CQ("Query",type,hash,classname))>2 { set sc=$$Regenerate^%SYS.DynamicStatement(classname,purgeOnError,keepSource) }		// %SQL.Statement type cached query (%SQL.ResultSet has only 1 list item)
	elseif type=11 { set sc=$$RegenerateUCQ(classname,purgeOnError,keepSource) }			// Embedded SQL cached statement
	else { do PurgeRtn(classname,1,$namespace) }	// Regeneration not supported for these CQ types, just Purge
	#; 	#; Now Regenerate any RTPC runtime cached statements
	#; set runtimeClass=""
	#; for {
	#; 	set runtimeClass=$o($$$CQ("RTQ",classname,runtimeClass)) quit:runtimeClass=""
	#; 	set rtsc=$$RegenerateQuerySource(runtimeClass)
	#; 	if $$$ISERR(rtsc) { set sc=$$$ADDSC(rtsc,sc) }
	#; }
	RETURN sc
}
.
CompileExtentCQ(extent,pMessages) [] PUBLIC { 
		#; Called from:
		#;  %qarTune
		#;  PurgeRtn may involve the deletion of a routine or class definition.
		#;  pMessages passed by reference, form is pMessages=<# of messages>, pMessage(1)=first message, etc.
		
	set $zt="Error"
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	set ns="",extentdb=$$$ExtentDB(extent)
	kill pMessages set pMessages=0
	new $namespace
	set cachens=$$GetCacheDatabase()
	for  { 
		set ns=$o(^|cachens|%sqlcq(ns)) quit:ns=""  
		set rtn="" 
		for  {	
			set rtn=$o(^|cachens|%sqlcq(ns,2,extentdb,extent,rtn)) quit:rtn=""
			try { set $namespace=ns } catch { set $namespace="%SYS" do PurgeRtn(rtn,1,ns) continue }	// Ignore any namespace we can't get to.  Might be <NETWORK> or <NAMESPACE> or ???
.
			set tCQData=$$$CQ("QueryRoutine",rtn)
			do
			. if $lg(tCQData)=9 new %caller set %caller="xDBC"
			. set sc=$$CompileRecurse^%apiOBJ(rtn,$select($$$CQSaveMAC:"k",1:"")_"-d")
			if $$$ISERR(sc) { 
				set pMessages=pMessages+1,pMessages(pMessages)=$$$FormatText($$$Text("Cached Query Class %1 could not be recompiled, it has been Purged.","%SQL.TuneTable"),rtn)
				do PurgeRtn(rtn,1,ns)
			}
			else {	// Class compiled OK, if not keeping CQ source, make the class deployed
				set pMessages=pMessages+1,pMessages(pMessages)=$$$FormatText($$$Text("Cached Query Class %1 has been recompiled.","%SQL.TuneTable"),rtn)
				do:'$$$CQSaveMAC MakeClassDeployed^%apiOBJ(rtn,"",,1)
			}
		}
	}
	QUIT
Error
	s $zt=""
	#; *** Should we actually report an error???
	QUIT
}
.
	#;  The following functions are used when access to Cached Query metadata is needed for catalog queries
	#;  Since CQ metadata is stored in CACHESYS, it must be referenced from a %SYS routine.
	
GetCacheDatabase() [] PUBLIC {
	Set ns="^^:ds:IRISLOCALDATA"
	try {
		if $data(^|ns|gbl)
	} catch {	
		set ns=""
	}
	RETURN ns
}
 
CachedQueryColumnMetadata(qh,cachedQuery,%caller) [] PUBLIC {
	try {
		set sc=$$$OK,rtnname=""
		set rtndata=$g($$$CQ("QueryRoutine",cachedQuery)) RETURN:rtndata="" $$$OK
		set ver=$lg(rtndata)
		if ver'=8,ver'=9,ver'=10 { RETURN $$$OK }	// not cached query type we support here
		set serverProtocol=$lg(rtndata,10)
		set hash=$lg(rtndata,2)
		if ver=9 {
			merge sqltext=$$$CQ("QueryText",cachedQuery)
			set firstToken=$$firstToken2^%qaqpreparser(.sqltext)
			set isSelect=(",SELECT,DECLARE,"[(","_firstToken_","))
			set serverProtocol=$lg(rtndata,10)
			set fastSelect=$lg(rtndata,12)
			set md=$$$CQ("Query",ver,hash,cachedQuery,0)
			set ptr=0 
			if isSelect {
				if fastSelect {
					if $listnext(md,ptr,statementOptions),$listnext(md,ptr,value),$listnext(md,ptr,numcols)
				} else {  // not fastSelect, if serverProtocol>8, we have statementOptions
					if serverProtocol>8,$listnext(md,ptr,statementOptions)
					set numcols=0
					if $listnext(md,ptr,numcols) {}
				}
				for ii=1:1:numcols {         // get metadata for each column
					set row=$lb(ii)
					for i=1:1:8 {
						if $listnext(md,ptr,value)
						if i=2,$$GetODBCTypeInfo^%ourODBC(value,.value)     // Turn type# into type string
						set row=row_$lb(value)
					}
					if $listnext(md,ptr,value)	// skip column catalog, always ""
					if $listnext(md,ptr,value)      // 10th column, $c(1)/$c(0) string
					for j=1:1:12 {
						set row=row_$lb($s($a(value,j)=1:1,1:0))
					}
					if fastSelect,$listnext(md,ptr,value) set row=row_$lb(value)     // 11th column, slot position
					set ^IRIS.Temp(qh,$i(^IRIS.Temp(qh)))=row
				}
			}
		} elseif ver=8 {
			#dim col As %SQL.StatementColumn
			set sqltext = $$$CQ("QueryText",cachedQuery,0)
			for i=1:1:sqltext { set sqltext(i)=$$$CQ("QueryText",cachedQuery,i) }
			set stmt=##class(%SQL.Statement).%New()
			set sc=stmt.%Prepare(.sqltext)
			if $$$ISERR(sc) { RETURN sc }
			set x=stmt.%Metadata.columns.Count()
			for ii=1:1:x {
				set col=stmt.%Metadata.columns.GetAt(ii)
				set type="",j=$$GetODBCTypeInfo^%ourODBC(col.ODBCType,.type)
				set ^IRIS.Temp(qh,$i(^IRIS.Temp(qh)))=$lb(ii,col.colName,type,col.precision,col.scale,col.isNullable,col.label,col.tableName,col.schemaName,col.isAutoIncrement,col.isCaseSensitive,col.isCurrency,col.isReadOnly,col.isRowVersion,col.isUnique,col.isAliased,col.isExpression,col.isHidden,col.isIdentity,col.isKeyColumn,col.isRowId)
			}
		} elseif ver=10 {
			#dim result As %Library.ResultSet
			set sqltext=$$$CQ("QueryText",cachedQuery,1)
			set sqltext=$p(sqltext,"~",1,$l(sqltext,"~")-3)	// Just give the Query Text
			set result=##class(%Library.ResultSet).%New("%DynamicQuery:SQL")
			set sc=result.Prepare(sqltext)
			if $$$ISERR(sc) { RETURN sc }
			set md=result.%Metadata
			set ptr=0,numcols=0
			if $listnext(md,ptr,numcols) {}
			for ii=1:1:numcols {         // get metadata for each column
				set row=$lb(ii)
				for i=1:1:8 {
					if $listnext(md,ptr,value)
					if i=2,$$GetODBCTypeInfo^%ourODBC(value,.value)     // Turn type# into type string
					set row=row_$lb(value)
				}
				if $listnext(md,ptr,value)	// skip column catalog, always ""
				if $listnext(md,ptr,value)      // 10th column, $c(1)/$c(0) string
				for j=1:1:12 {
					set row=row_$lb($s($a(value,j)=1:1,1:0))
				}
				set ^IRIS.Temp(qh,$i(^IRIS.Temp(qh)))=row
			}
		}
		RETURN $$$OK
	} catch {
		kill ^IRIS.Temp(qh) $$$RemoveTempNode(^IRIS.Temp(qh))
		RETURN $$$ERROR($$$CacheError,$ze)
	}
}
.
CachedQueryColumnMetadataBasic(qh,cachedQuery,%caller) [] PUBLIC {
	try {
		set sc=$$$OK,rtnname=""
		set rtndata=$g($$$CQ("QueryRoutine",cachedQuery)) RETURN:rtndata="" $$$OK
		set ver=$lg(rtndata)
		if ver'=8,ver'=9,ver'=10 { RETURN $$$OK }	// not cached query type we support here
		set hash=$lg(rtndata,2)
		if ver=9 {
			merge sqltext=$$$CQ("QueryText",cachedQuery)
			set firstToken=$$firstToken2^%qaqpreparser(.sqltext)
			set isSelect=(",SELECT,DECLARE,"[(","_firstToken_","))
			set serverProtocol=$lg(rtndata,10)
			set fastSelect=$lg(rtndata,12)
			set md=$$$CQ("Query",ver,hash,cachedQuery,0)
			set ptr=0
			if isSelect {
				if fastSelect {  // get statement options
					if $listnext(md,ptr,statementOptions),$listnext(md,ptr,value),$listnext(md,ptr,numcols)
				} else {  // not fastSelect, if serverProtocol>8, we have statementOptions
					if serverProtocol>8,$listnext(md,ptr,statementOptions)
					set numcols=0
					if $listnext(md,ptr,numcols) {}
				}
				for ii=1:1:numcols {         // get metadata for each column
					set row=$lb(ii)
					for i=1:1:8 {
						if $listnext(md,ptr,value)
						if i=2,$$GetODBCTypeInfo^%ourODBC(value,.value)     // Turn type# into type string
						set row=row_$lb(value)
					}
					if $listnext(md,ptr,value)	// skip column catalog, always ""
					if $listnext(md,ptr,value)      // 10th column, $c(1)/$c(0) string
					if fastSelect,$listnext(md,ptr,value)      // 11th column, slot position, skip
					set ^IRIS.Temp(qh,$i(^IRIS.Temp(qh)))=row
				}
			}
		} elseif ver=8 {
			#dim col As %SQL.StatementColumn
			set sqltext = $$$CQ("QueryText",cachedQuery,0)
			for i=1:1:sqltext { set sqltext(i)=$$$CQ("QueryText",cachedQuery,i) }
			set stmt=##class(%SQL.Statement).%New()
			set sc=stmt.%Prepare(.sqltext)
			if $$$ISERR(sc) { RETURN sc }
			set x=stmt.%Metadata.columns.Count()
			for ii=1:1:x {
				set col=stmt.%Metadata.columns.GetAt(ii)
				set type="",j=$$GetODBCTypeInfo^%ourODBC(col.ODBCType,.type)
				set ^IRIS.Temp(qh,$i(^IRIS.Temp(qh)))=$lb(ii,col.colName,type,col.precision,col.scale,col.isNullable,col.label,col.tableName,col.schemaName)
			}
		} elseif ver=10 {
			#dim result As %Library.ResultSet
			set sqltext=$$$CQ("QueryText",cachedQuery,1)
			set sqltext=$p(sqltext,"~",1,$l(sqltext,"~")-3)	// Just give the Query Text
			set result=##class(%Library.ResultSet).%New("%DynamicQuery:SQL")
			set sc=result.Prepare(sqltext)
			if $$$ISERR(sc) { RETURN sc }
			set md=result.%Metadata
			set ptr=0,numcols=0
			if $listnext(md,ptr,numcols) {}
			for ii=1:1:numcols {         // get metadata for each column
				set row=$lb(ii)
				for i=1:1:8 {
					if $listnext(md,ptr,value)
					if i=2,$$GetODBCTypeInfo^%ourODBC(value,.value)     // Turn type# into type string
					set row=row_$lb(value)
				}
				if $listnext(md,ptr,value)	// skip column catalog, always ""
				if $listnext(md,ptr,value)      // 10th column, $c(1)/$c(0) string
				set ^IRIS.Temp(qh,$i(^IRIS.Temp(qh)))=row
			}
		}
		RETURN $$$OK
	} catch {
		kill ^IRIS.Temp(qh) $$$RemoveTempNode(^IRIS.Temp(qh))
		RETURN $$$ERROR($$$CacheError,$ze)
	}
}
.
CachedQueryParameterMetadata(qh,cachedQuery,%caller) [] PUBLIC {
	try {
		set sc=$$$OK,rtnname=""
		set rtndata=$g($$$CQ("QueryRoutine",cachedQuery)) RETURN:rtndata="" $$$OK
		set ver=$lg(rtndata)
		if ver'=8,ver'=9,ver'=10 { RETURN $$$OK }	// not cached query type we support here
		set hash=$lg(rtndata,2)
		if ver=9 {
			merge sqltext=$$$CQ("QueryText",cachedQuery)
			set firstToken=$$firstToken2^%qaqpreparser(.sqltext)
			set isSelect=(",SELECT,DECLARE,"[(","_firstToken_","))
			set isInsert=(",INSERT,"[(","_firstToken_","))
			set serverProtocol=$lg(rtndata,10)
			set fastSelect=$lg(rtndata,12)
			set md=$$$CQ("Query",ver,hash,cachedQuery,0)
			set ptr=0
			if isSelect {
				if fastSelect {  // get statement options
					if $listnext(md,ptr,statementOptions),$listnext(md,ptr,value),$listnext(md,ptr,numcols) { set columns=11 }
				} else {  // not fastSelect, if serverProtocol>8, we have statementOptions
					if serverProtocol>8,$listnext(md,ptr,statementOptions)
					set numcols=0,columns=10
					if $listnext(md,ptr,numcols) {}
				}
				for ii=1:1:numcols {         // skip columns
					for i=1:1:columns {
						if $listnext(md,ptr,value)
					}
				}
			}
			if isInsert {
				set fastInsert=$lg(rtndata,13)
				if fastInsert {
					if $listnext(md,ptr,statementOptions) {} // get statement options
					if $listnext(md,ptr,numkeys) {}          // get number of key columns
					if $listnext(md,ptr,slotcnt) {}          // get number of slots
				}
			} else { set fastInsert=0 }
			if $listnext(md,ptr,numparams)
			for ii=1:1:numparams {
				set row=$lb(ii)
				if $listnext(md,ptr,value)
				if $$GetODBCTypeInfo^%ourODBC(value,.value)     // Turn type# into type string
				set row=row_$lb(value)
				for j=1:1:3 { if $listnext(md,ptr,value) { set row=row_$lb(value) }}   // precision / scale / nullable
				if fastInsert {
					if $listnext(md,ptr,value) {}  // skip storage slot
					if $listnext(md,ptr,value) {}  // skip truncate flag
					if $listnext(md,ptr,value) {}  // skip MINVAL/MINLEN
					if $listnext(md,ptr,value) {}  // skip MAXVAL
				}
				set ^IRIS.Temp(qh,$i(^IRIS.Temp(qh)))=row
			}
		} elseif ver=8 {
			#dim par As %SQL.StatementParameter
			set sqltext = $$$CQ("QueryText",cachedQuery,0)
			for i=1:1:sqltext { set sqltext(i)=$$$CQ("QueryText",cachedQuery,i) }
			set stmt=##class(%SQL.Statement).%New()
			set sc=stmt.%Prepare(.sqltext)
			if $$$ISERR(sc) { RETURN sc }
			set x=stmt.%Metadata.parameters.Count()
			for ii=1:1:x {
				set par=stmt.%Metadata.parameters.GetAt(ii)
				set type="",j=$$GetODBCTypeInfo^%ourODBC(par.ODBCType,.type)
				set ^IRIS.Temp(qh,$i(^IRIS.Temp(qh)))=$lb(ii,type,par.precision,par.scale,par.isNullable)
			}
		} elseif ver=10 {
			set ^IRIS.Temp(qh,$i(^IRIS.Temp(qh)))=$lb($$$Text("Parameter metadata display not supported for %Library.ResultSet cached queries","%SQL.Server")) RETURN $$$OK
		}
		RETURN $$$OK
	}
	catch {	
		kill ^IRIS.Temp(qh) $$$RemoveTempNode(^IRIS.Temp(qh))
		RETURN $$$ERROR($$$CacheError,$ze)
	}
}
.
	// Called from:
	//  - %Library.SQLCatalog.SQLCachedQueryInfoExecute() method
	//  - %SQL.Manager.Catalog.CachedQueryInfoExecute() method
CQInfoExecute(qh,package,%caller,AllPackages=0,stripOptions=0,excludeEmbedded=0) [] PUBLIC {
	set $zt="CQInfoExecuteError"
	set sc=$$$OK,rtnname="",idx=0
	for  {
		set rtnname=$Order($$$CQ("QueryRoutine",rtnname),1,data) quit:rtnname=""
		set ver=$lg(data),clist=$lg(data,4)
		if ver'=8,ver'=9,ver'=10,ver'=$$$CQEmbedVersion { continue }	// not an ODBC Cached Query or a Dynamic Query or ResultSet or UCQ
		if excludeEmbedded,ver=$$$CQEmbedVersion { continue }
	
			#;  Make sure this Cached Query either has no tables it uses or uses tables from the schema specified.
		if clist'="",'AllPackages {
			set ok=0
			for i=1:1:$ll(clist) {
				if $piece($lg(clist,i),".",1,*-1)=package { set ok=1 quit  }
			}
			continue:'ok
		}
	
		if '$$$IAmSuperUser,$$$SQLSecurityOn {
			set ok=1
		 	set hash=$lg(data,2)
			set loginroleshash=$$$Hash($roles)
				#; In order to see the info for a UCQ, the caller muct have %Develment:"U" resource
			if ver=$$$CQEmbedVersion,'$SYSTEM.Security.Check($$$DevelopmentResourceName,$$$PermUseName) { continue }
			if ver'=$$$CQEmbedVersion,$d($$$CQ("Query",ver,hash,rtnname,"priv")),'$d(^($zu(110),"pu",$$$Hash($$$aid),loginroleshash)) {
		 		set obj="" 
		 		for  {	// For each SQL Object
		 			set obj=$o($$$CQ("Query",ver,hash,rtnname,"priv",obj)) quit:obj=""
		 			set p=""
		 			for  {
			 			set fields="",p=$o($$$CQ("Query",ver,hash,rtnname,"priv",obj,p),1,fields) quit:p=""
		 				if '$$priv^%SYS.SQLSEC(obj,p,$namespace,0,$g(fields)) { set ok=0 quit  }
		 			}
					quit:'ok
		 		}
		 		if ok { do UpdatePUNode }
		 	}
		 	if 'ok { continue }	// not privileged
		}
	
			#; get data for query (first 80 characters)
		set query=$$GetCachedQueryInfo(rtnname,.create,.source,.querytype,.cost,stripOptions,.statementOptions)
		set:$L(query)>256 query=$E(query,1,253)_"..."
		set ^||%SQL.QueryInfo(qh,$i(idx))=$LB(rtnname,query,create,source,querytype,$s(querytype=9:"ODBC/JDBC Statement",querytype=10:"%Library.ResultSet Dynamic SQL",querytype=8:"%SQL.Statement Dynamic SQL",querytype=$$$CQEmbedVersion:"Embedded cached SQL",1:"??? Unknown"),cost,statementOptions)
	}
	RETURN sc
CQInfoExecuteError
	set $zt=""
	kill ^||%SQL.QueryInfo(qh)
	RETURN $$$ERROR($$$ObjectScriptError,$ze)
.
UpdatePUNode
	$$$AddAllRoleTemporary
	lock +$$$CQ("Query",ver,hash,rtnname):$$$CQGetLockTO
	if '$t { set sc=$$$ERROR($$$LockFailedToAcquireExclusive,$name($$$CQ("Query",ver,hash,rtnname))),%msg=$$$Text("Lock Timeout attempting to acquire exclusive lock on Cached Query metadata for Cached Query Table Catalog","%SQL.Server") RETURN }
	set $$$CQ("Query",ver,hash,rtnname,$zu(110),"pu",$$$Hash($$$aid),loginroleshash)="" 
	lock -$$$CQ("Query",ver,hash,rtnname)#"I"
	RETURN
}
 
 
CQTreeExecute(qh,%caller) [] PUBLIC {
	set $zt="CQTreeExecuteError"
	set sc=$$$OK,rtnname="",idx=0
	set loginroles=$roles
	set IAmSuperUser=$$$IAmSuperUser
	set:'IAmSuperUser loginroleshash=$$$Hash($roles)
	for  {
		set rtnname=$Order($$$CQ("QueryRoutine",rtnname),1,data) q:rtnname=""
		if $case($lg(data),8:0,9:0,10:0,$$$CQEmbedVersion:0,:1)  continue	// not an ODBC Cached Query or a Dynamic Query or ResultSet or UCQ
	
		if '$$$IAmSuperUser,$$$SQLSecurityOn {
			set ok=1
		 	set ver=$lg($$$CQ("QueryRoutine",rtnname)),hash=$lg($$$CQ("QueryRoutine",rtnname),2)
				#; In order to see the info for a UCQ, the caller muct have %Develment:"U" resource
			if ver=$$$CQEmbedVersion,'$SYSTEM.Security.Check($$$DevelopmentResourceName,$$$PermUseName) { continue }
			if ver'=$$$CQEmbedVersion,$d($$$CQ("Query",ver,hash,rtnname,"priv")),'$d(^($zu(110),"pu",$$$Hash($$$aid),loginroleshash)) {
		 		set obj="" 
		 		for  {	// For each SQL Object
		 			set obj=$o($$$CQ("Query",ver,hash,rtnname,"priv",obj)) q:obj=""
		 			set p=""
		 			for  {
			 			set fields="",p=$o($$$CQ("Query",ver,hash,rtnname,"priv",obj,p),1,fields) quit:p=""
		 				if '$$priv^%SYS.SQLSEC(obj,p,$namespace,0,$g(fields)) { set ok=0 quit  }
		 			}
					quit:'ok
		 		}
		 		if ok { do UpdatePUNode }
		 	}
		 	continue:'ok
		}
	
			#; get data for query (first 80 characters)
		set ^||%SQL.QueryInfo(qh,$i(idx))=$LB(rtnname)
	}
	RETURN sc
CQTreeExecuteError
	set $zt=""
	kill ^||%SQL.QueryInfo(qh)
	RETURN $$$ERROR($$$ObjectScriptError,$ze)
.
UpdatePUNode
	lock +$$$CQ("Query",ver,hash,rtnname):$zu(115,4)  e  s sc=$$$ERROR($$$LockFailedToAcquireExclusive,$name($$$CQ("Query",ver,hash,rtnname))),%msg=$$$Text("Lock Timeout attempting to acquire exclusive lock on Cached Query metadata for Cached Query Tree Catalog","%SQL.Server") q
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	set $$$CQ("Query",ver,hash,rtnname,$zu(110),"pu",$$$Hash($$$aid),$$$Hash(loginroles))=""
	set $roles=""
	lock -$$$CQ("Query",ver,hash,rtnname)#"I"
	RETURN
}
 
 
CQTableExecute(qh,classname,%caller,stripOptions=0) [] PUBLIC {
	set $zt="CQTableExecuteError",rtnname="",extentdb=$$$ExtentDB(classname)
	set IAmSuperUser=$$$IAmSuperUser
	set:'IAmSuperUser loginroleshash=$$$Hash($roles)
	set idx=0
	For  {
		set rtnname=$o($$$CQ(2,extentdb,classname,rtnname)) quit:rtnname=""
		if $d($$$CQ("QueryRoutine",rtnname),queryData)#10=0 {  		// Cached Query no longer exists
			kill $$$CQ(2,extentdb,classname,rtnname),$$$CQPackageIndex($$$AllButLastPiece(classname,"."),$$$LastPiece(classname,"."),rtnname)
			continue
		}
		if $case($lg(queryData),8:0,9:0,10:0,$$$CQEmbedVersion:0,:1) { continue	} // not an SQL Statement, ODBC Cached Query or a Dynamic Query, or UCQ
		if ('IAmSuperUser),$$$SQLSecurityOn {
			set ok=1
			set ver=$lg(queryData),hash=$lg(queryData,2)
				#; In order to see the info for a UCQ, the caller muct have %Develment:"U" resource
			if ver=$$$CQEmbedVersion,'$SYSTEM.Security.Check($$$DevelopmentResourceName,$$$PermUseName) { continue }
			if ver'=$$$CQEmbedVersion,$d($$$CQ("Query",ver,hash,rtnname,"priv")),'$d(^($zu(110),"pu",$$$Hash($$$aid),loginroleshash)) {
				set obj="" 
		 		for  {	// For each SQL Object
		 			set obj=$o($$$CQ("Query",ver,hash,rtnname,"priv",obj)) quit:obj=""
		 			set p=""
		 			for  {
			 			set fields="",p=$o($$$CQ("Query",ver,hash,rtnname,"priv",obj,p),1,fields) quit:p=""
		 				if '$$priv^%SYS.SQLSEC(obj,p,$namespace,0,$g(fields)) { set ok=0 quit  }
		 			}
					quit:'ok
		 		}
		 		do:ok UpdatePUNode
		 	}
			continue:'ok	// User is not privileged to see this CQ info
		}
	
		set query=$$GetCachedQueryInfo(rtnname,.create,.source,.querytype,.cost,stripOptions,.statementOptions)
		set:$L(query)>256 query=$E(query,1,253)_"..."
		set ^||%SQL.QueryInfo(qh,$i(idx))=$LB(rtnname,query,create,source,querytype,$s(querytype=9:"ODBC/JDBC Statement",querytype=10:"%Library.ResultSet Dynamic SQL",querytype=8:"%SQL.Statement Dynamic SQL",querytype=$$$CQEmbedVersion:"Embedded cached SQL",1:"??? Unknown"),cost,statementOptions)
	}
	RETURN $$$OK
CQTableExecuteError
	set $zt="" kill ^||%SQL.QueryInfo(qh)
	RETURN $$$ERROR($$$ObjectScriptError,$ze)
.
UpdatePUNode
	$$$AddAllRoleTemporary
	lock +$$$CQ("Query",ver,hash,rtnname):$$$CQGetLockTO
	if '$t { set sc=$$$ERROR($$$LockFailedToAcquireExclusive,$name($$$CQ("Query",ver,hash,rtnname))),%msg=$$$Text("Lock Timeout attempting to acquire exclusive lock on Cached Query metadata for Cached Query Table Catalog","%SQL.Server") RETURN }
	set $$$CQ("Query",ver,hash,rtnname,$zu(110),"pu",$$$Hash($$$aid),loginroleshash)="" 
	lock -$$$CQ("Query",ver,hash,rtnname)#"I"
	RETURN
}
 
XdbcErrorsExecute(qh,ns,%caller,&%q) [] PUBLIC {
		#;  Macro CQns requires a namespace name in the 'ns' variable
	set $zt="XdbcErrorsExecuteError"
	set cqdb=$$GetCacheDatabase()
	if '$d($$$CQrootExtended(cqdb)(ns,"LastError"),x) s AtEnd=1,Row="" QUIT $$$OK // No errors in this namespace
	set tPid="" 
	for  {
		set tPid=$o($$$CQrootExtended(cqdb)(ns,"LastError",tPid),1,x) q:tPid=""
		set tRow=$lb($p(x," ["),tPid,$p($P(x,"SQLCODE: ",2),"]"),$p($p(x,"Error: <",2),">]"),$p($p(x,"Location: <",2),">"),$p($p(x,"%msg: <",2),">"),tPid,$p($p(x,"Client info: <",2),">"),$p($p(x,"%protocol: <",2),">"))
		set tROW=$$$UPPER(tRow)
		if $g(%q("sfilter")) {
			set ok=0
			for i=1:1:%q("sfilter") { if tROW?@(".E"_%q("sfilter",i)_".E") { set ok=1 quit  }}
			continue:'ok 	// Error string does not match any of the positive patterns specified
		}
		if $g(%q("sfilter2")) {	// NOT pattern matches
			set ok=1
			for i=1:1:%q("sfilter2") { if tROW?@(".E"_%q("sfilter2",i)_".E") { set ok=0 quit  }}
			continue:'ok	// Error string does match one of the NOT patterns specified, don't report it
		}
		set ^IRIS.Temp(qh,$p(x," [")_"*"_$i(^IRIS.Temp(qh)))=tRow
	}
	Quit $$$OK
XdbcErrorsExecuteError
	s $zt="" k ^IRIS.Temp(qh) $$$RemoveTempNode(^IRIS.Temp(qh))
	QUIT $$$ERROR($$$ObjectScriptError,$ze)
}
 
 
GetCachedQueryInfo(Routine,&CreateTime,&Source,&QueryType,&Cost,stripOptions=0,&statementOptions) [] PUBLIC {
		#;  Get data for cached query
		#;    Routine is the name of the cached query routine or class routine name
	set statementOptions=""
	Set x=$$$CQ("QueryRoutine",Routine)
	Set QueryType=$lg(x,1)
	Set CreateTime=$zdt($LI(x,3),3)
	set LastPrepareTime=$zdt($$$CQ("LastPrepare",Routine),3)
	set Source=($d(^rINDEX(Routine_".1","INT"))'=0)
	Set Cost=$lg(x,7)
	If QueryType=9 {
			#; For xDBC, there may be multiple lines of query text.  Just return the first
		Set QueryText=$$$CQ("QueryText",Routine,1)
		if stripOptions { set QueryText=$p(QueryText," /*#OPTIONS",1) }
			#; Now turn :%qpar(...) into '?'
		s pos=1 f  s pos=$find(QueryText,":%qpar(",pos) q:'pos  s QueryText=$e(QueryText,1,pos-8)_"?"_$p($e(QueryText,pos,*),")",2,*) set pos=pos-8	// DPV2933=
		set hash=$lg(x,2)
		set metadata=$$$CQ("Query",9,hash,Routine,0)
		if $lg(x,11) { set statementOptions=statementOptions_$e(" ",statementOptions'="")_"fastFetch" }
		if $lg(x,12) { set statementOptions=statementOptions_$e(" ",statementOptions'="")_"fastSelect" }
		if $lg(x,13) { set statementOptions=statementOptions_$e(" ",statementOptions'="")_"fastInsert" }
	} ElseIf QueryType=10 {
			#; For Dynamic SQL, there is only 1 line of query text
		Set QueryText=$$$CQ("QueryText",Routine,1)
		Set QueryText=$p(QueryText,"~",1,$l(QueryText,"~")-3)	// Just give the Query Text
	} ElseIf QueryType=8 {
			#; For Cached ResultSets,there may be multiple lines of query text.  Just return the first
		Set QueryText=$g($$$CQ("QueryText",Routine,1))
	} ElseIf QueryType=$$$CQEmbedVersion {
		set QueryText=""
		for i=1:1 {
			If '$data($$$CQ("QueryText",Routine,i),line) QUIT
			set QueryText=QueryText_line_" "
		}
		Set QueryText=$e(QueryText,1,*-1)
	} Else {
		s QueryText=""
	}
	Quit QueryText
}
 
 
 
	#;  The following functions are used when access to Cached Query metadata is needed for cached classes
 
#define CachedQueryVersion      8
 
	#; called from DeleteClassRuntime^%occClass and buildEmbeddedDirect
RemoveClassFromCQLib(classname) [] PUBLIC {
		#; If this class is the implementation of a cached statement then purge the cached statement from the statement cache.
	If $Data($$$CQ("QueryRoutine",classname),data) {
		$$$AddAllRoleTemporary ; verified 9/26/16 STC
		Set qtlist = $ListGet($get(data),4)
		Set ptr=0 While $listnext(qtlist,ptr,qa) {
			Kill $$$CQ(2,$$$ExtentDB(qa),qa,classname),$$$CQPackageIndex($$$AllButLastPiece(qa,"."),$$$LastPiece(qa,"."),classname)	// DPV3391
		}
		kill $$$CQ("LastPrepare",classname)
		kill $$$CQ("QueryRoutine",classname)
		kill $$$CQ("Stale",classname)
		if $lg(data)'="",$lg(data,2)'="" kill $$$CQ("Query",$list(data),$list(data,2),classname)
		kill $$$CQ("QueryText",classname)
	}
	QUIT
}
 
minit() s $zt="miniterr"
	x:$d($$$SQLServerInitCode) $$$SQLServerInitCode
	QUIT 0
miniterr QUIT 453  ; error in user initialization code
 
 
Logerr(rc,ze="",info,&%msg,zu56="",fatalErrorNoHalt=0) [] PUBLIC {
		#; Store last server error in $$$CQ("LastError",$j) and %lasterr local
		#; ze should always be defined, even if ""
	set tflag=0,$zt="LogerrError" // DPV2749 (remove jflag=0)
	if ze="<SYNTAX>ep+2^%qaqperr" { set ze="" }	// Suppress $ze if went through SQL error trap
	if ze["<SYNTAX>errdone+",ze["%qaqqt" { set ze=""	} // Suppress $ze if went through SQL error trap
	set:ze="" zu56=""
	set rc=$s(rc>0&(rc'=100):-rc,1:rc)		// Sometimes the rc is positive, make sure it is negative for SQLCODE value
	if (ze["<DATABASE")||(ze["<DISKHARD")||(ze["<SYSTEM") {
		set %msg=$g(%msg)_$s($g(%msg)'="":$$$NL,1:"")_$$$Text("Your session has encountered a serious error!  If possible, you should attempt to save any work and close the client connection.  This server process is now unstable and results are unpredictable.","%SQL.Server")
		//GOTO BACK^%ETN  // DPV2957 - record process state in error trap if these severe errors occur
	}
		#; If this is a communication issue, don't report fatal error (-400), but -461.  There is a really good chance the client program simply did not disconnect gracefully
	if (ze["<WRITE")||(ze["<READ")||(ze["<DISCONNECT")||(ze["<DSCON")||(ze["<NOTOPEN") {
		if rc=-400 { set rc=-461 }
		if $g(%msg)="" { set %msg="Server encountered an error communicating with the client application" }
	}
		// clientinfo should be in $listbuild format and contain information about the client connection
	set clientinfo=$lb("Username: "_$zu(67,11,$j)," Node Name: "_$zu(67,12,$j)," IP Address: "_$zu(67,15,$j)," Executable Name: "_$zu(67,13,$j)," Internal Function: "_$g(%qfun,"<not defined>"))
	set %lasterr=$zdt($h,3)_" [SQLCODE: <"_rc_">:<"_$$sqlcode(rc)_">]"_$s(ze'="":$c(13,10)_"[Error: <"_ze_">]",1:"")_$c(13,10)_"[Location: <"_info_">]"_$s($g(%msg)'="":$c(13,10)_"[%msg: <"_%msg_">]",1:"")_$c(13,10)_"[Client info: <"_$listtostring(clientinfo)_">]"_$s($g(%protocol)'="":$c(13,10)_"[%protocol: <"_%protocol_">]",1:"")
	$$$SuspendAllTrans(tflag)
	#; DPV2749 $$$DisableJournal
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	set $$$CQ("LastError",$j)=%lasterr_$s(zu56'="":$c(13,10)_zu56,1:"")
	set $$$CQ("LastError")=%lasterr_$s(zu56'="":$c(13,10)_zu56,1:"")
	set:$g($$$CQ("AllErrors"))=1 $$$CQ("AllErrors",$j,$zh)=%lasterr_$s(zu56'="":$c(13,10)_zu56,1:"")
	$$$ResumeAllTrans(tflag) // DPV2749 $$$EnableJournal
	if (ze["<WRITE")||(ze["<READ")||(ze["<DISCONNECT")||(ze["<DSCON")||(ze["<NOTOPEN")||(ze["<RESJOB") {
		if $g($$$SQLServerDisconnectCode)'="" { set $zt="ErrorHalt" X $$$SQLServerDisconnectCode }
		if $$$logging,$$$srv.ConnectionLimit { do ##class(%SYS.DBSRV).logappend("Decrementing xDBC Server connection counter") }
		do:$$$srv.ConnectionLimit $i(^IRIS.Temp.xDBCConCount,-1)	// decrement xDBC connection counter
		if fatalErrorNoHalt {	// Called from Python, don't halt the process
			do:$$$logging ##class(%SYS.DBSRV).logappend("Server Process RETURNING!!!")
		} else {
			do:$$$logging ##class(%SYS.DBSRV).logappend("Server Process HALTING!!!")
			HALT  ; Avoid infinit looping if Client communication lost
		}
	}
	set %msg="",$ze=""	// Clear out the message (%msg passed by reference)	// DPV2114 (11/25/2003) clear $ze
	RETURN
LogerrError
	set $zt=""
	if tflag { $$$ResumeAllTrans(tflag) } 
	#; DPV2749 $$$EnableJournal
	RETURN
 
ErrorHalt	//
	set $zt=""
	if fatalErrorNoHalt {
		do:$$$logging ##class(%SYS.DBSRV).logappend("Server Process RETURNING!!!")
	} else {
		do:$$$logging ##class(%SYS.DBSRV).logappend("Server Process HALTING!!!")
	}
	if $$$logging,$$$srv.ConnectionLimit { do ##class(%SYS.DBSRV).logappend("Decrementing xDBC Server connection counter") }
	do:$$$srv.ConnectionLimit $i(^IRIS.Temp.xDBCConCount,-1)	// decrement xDBC connection counter
	if 'fatalErrorNoHalt { HALT }
}
 
Showerr ; Show last recorded error
	n err s err=$g($$$CQ("LastError",$j))
	i err="" w !,"No error recorded under $$$CQ(""LasteError"",$J)",!,"LastError in $$$CQ(""LastError"") is:",!,$g($$$CQ("LastError")),! QUIT
	w !,$TR(err,$c(13,10)),!
	QUIT
.
	#; Note, this API is only used for the old ^mcq cached queries, called from PurgeUpgrade
KillCQClassxRef(extent,rtn) [] PRIVATE { $$$AddAllRoleTemporary Kill $$$EXTCQcq($$$rEXT,extent,$zu(110),$namespace,rtn) QUIT  }	// DPV2842 ; verified 9/26/16 STC
 
	// called from %CSP.UI.Portal.xDBCErrorNamespaces.Delete() and %CSP.UI.System.ExpResultPage.DeleteError()
KillLastErrorAll(ns) [] PUBLIC {
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	try {
		set cqNamespace=$$GetCacheDatabase()
		kill $$$CQrootExtended(cqNamespace)(ns,"LastError")
	}
	catch {}	// return/report no error
	QUIT
}
.
KillLastErrorOne(processId) [] PUBLIC { $$$AddAllRoleTemporary kill $$$CQ("LastError",processId) QUIT  } ; verified 9/26/16 STC
.
	#; This procedure is only intended to be used by storage type conversion code in %apiDDL. That code makes use of RunTempCode extensively
	#; but it does not require a user to have %All in order to run a storagetype conversion. This procedure will just check that the caller of RunTempCode
	#; is %apiDDL and, if it is, temporary escalate to %All in order to run the temp code needed for the table conversion.
RunTempCodeForConversion(&code,label="",&%status,&SQLCODE,&%msg,location="Temporary SQL Routine",args="",pCompileError=0,pCodeReturnsStatus=0,collectSQLStats=0,&%SQLStats,runMode=1,&rtn,useUCQ=1) [backgrnd,comerr,comperr] PUBLIC {
	
	// $zu(96,9) is the calling routine
	if $zu(96,9) = "%apiDDL" {
		$$$AddAllRoleTemporary
		do RunTempCode(.code,label,.%status,.SQLCODE,.%msg,location,args,pCompileError,pCodeReturnsStatus,collectSQLStats,.%SQLStats,runMode,.rtn,useUCQ)
	}
	
	RETURN
}
.
	#; Given some code, define a temp "cached query" routine.
	#; Not a true cached query, but a temp routine that is used once and discarded.
	#; We do this from the DDL API, TuneTable, etc.
	#; Routine is not cached, but created, run, deleted.
	#; Only users with the %All role can call this code.  
	#; The runMode parameter is a flag that lets us pick how far we take RunTempCode. For now it's only used with a specialized value for
	#; storage type conversions to avoid reinventing the wheel w.r.t. temporary routines. Note for runMode<4 the caller must delete the routine The levels are:
	#; 		1 (default) - allocate, compile, run, & delete routine 
	#; 		2 			- allocate, compile, & run routine. Routine name is returned in PBR rtnName param
	#; 		3 			- allocate & compile routine. Routine name is returned in PBR rtnName param
	#; 		4 			- allocate routine (with provided code). Routine name is returned in PBR rtnName param
RunTempCode(&code,label="",&%status,&SQLCODE,&%msg,location="Temporary SQL Routine",args="",pCompileError=0,pCodeReturnsStatus=0,collectSQLStats=0,&%SQLStats,runMode=1,&rtn,useUCQ=1) [backgrnd,comerr,comperr] PUBLIC {
		#; %status, SQLCODE, and %msg are passed by reference and returned to the caller
		#; pCodeReturnsStatus - if TRUE, the code we call will return a %Status value
		#; collectSQLStats         > 0 - Don't turn SQLStats Off
		#; %SQLStats()                 - Pass By Reference array for collecting SQLStats data
		#;   $d(%SQLStats("GetStats")) - Called from GetStats^%SYS.PTools() so invoke ^%qarmac() with special parameters
	if '$$$IOwnAllRole { set SQLCODE=-99,%msg=$$$FormatText($$$Text("Insufficient Privilege For Operation at location: %1","%SQL.Server"),location),%status=$$$ERROR($$$InsufficientPrivilegeForOperation) do Audit99^%SYS.SQLSEC(%msg) QUIT  }
	new backgrnd,comerr,comperr
.
		#; This temporary routine (psuedo cached query) will not be part of the transaction (if any)
		#; If tFlag=0, we have not suspended the current transaction
		#; If tFlag=1, we have suspended the current transaction
	set %status=$$$OK
	$$$SuspendAllTrans(tFlag)
	
		#; Code to define the routine is in the code() array
		#; code(0) = # of lines, code(1) = first line, etc.
	set rtn=$$TempRtnAlloc(.sc, (runMode>1))
	set:$d(%SQLStats("GetStats"))&&collectSQLStats $LIST(%SQLStats("GetStats"),1)=rtn
	try {
			#; #sqlcompile mode=embedded will mean the embedded SQL in the code is generated in a UCQ. For col->row table conversions we want
			#; the code compiled directly into the routine so we won't set this directive
		if useUCQ {
			set compMode ="#sqlcompile mode=embedded", rsize=$length(compMode), ^rMAC(rtn,0,0) = code(0) + 1, ^rMAC(rtn,0,1) = compMode, directiveOffset = 1
		} else {
			set (directiveOffset, rsize) = 0, ^rMAC(rtn,0,0) = code(0)
		}
.
		for i=1:1:code(0) {
			set ^rMAC(rtn,0,i+directiveOffset) = code(i)
			set rsize = rsize+$length(code(i))
		}
		set ^rMAC(rtn,0)=$h
		set ^rMAC(rtn,0,"GENERATED")=1,^rMAC(rtn,0,"SIZE")=rsize
		set ^rINDEX(rtn,"MAC")=$lb($zdt($h,3),rsize,1)
	}
	catch { 
		set SQLCODE=-400,%msg=$$$FormatText($$$Text("Error defining code for %1:  %2","%SQL.Server"),location,$ze)
		set %status=$$$ERROR($$$GeneralError,%msg)
		$$$ResumeAllTrans(tFlag)
		set rtn = "" // don't return routine name if never allocated
		QUIT
	}
	
		#; Quit after allocating the routine
	if runMode = 4 { 
		$$$ResumeAllTrans(tFlag) 
		RETURN 
	}
	
		#; Do not generate SQLStats for psuedo cached queries
	if 'collectSQLStats $$$setSQLStatsFlagOFF(SQLStats)  // Turn OFF/Disable SQLState for current JOB
	 
	set comperr="comerr",@comperr@(0)=0,backgrnd=1
 	if $d(%SQLStats("GetStats"))&&collectSQLStats { 
  		new %statsStartStop
 		do ^%qarmac(rtn,"","","",0,comperr,"","","","","","",,,,$s(collectSQLStats=3:"ShowPlan4",1:"xDBC"))
 	}
	else { 
		do ^%qarmac(rtn,"","","",0,comperr,"","","","","","") 
	}
	
		#; return SQLStats back to old value
	if 'collectSQLStats $$$resetSQLStatsFlag(SQLStats)   // Reset SQLStats flag for current JOB to original value
.
		#; OK to resume transaction here.  RtnDelete will suspend it again if needed
	$$$ResumeAllTrans(tFlag)
	if @comperr@(0) {
		if @comperr@(0)=$g(@comperr@("sql")) { // just SQL Errors so give 1st one
			set SQLCODE=+$p(@comperr@(1),"SQLCODE=",2),%msg=@comperr@(1)
		}
		else {
			set SQLCODE=-400,%msg=$$$FormatText($$$Text("There are %1 errors in routine %2","%SQL.Server"),(@comperr@(0)\2),rtn)
			for i=1:1:@comperr@(0) { set %msg=%msg_$$$NL_@comperr@(i) }
		}
		set %status=$$$ERROR($$$RoutineCompilationErrorWithInfo,rtn,%msg)
		set pCompileError=1
		do RtnDelete(rtn)
		If tFlag { $$$ResumeAllTrans(tFlag) }
		set rtn = "" // don't return routine name if it's deleted
 		QUIT
	}
.
		#; Quit after compiling the routine
	RETURN:runMode=3
	
	try {
		if pCodeReturnsStatus {
			x ("set %status=$$"_label_"^"_rtn_"("_args_")")
		}
		else {
			if args="" { do @(label_"^"_rtn) }
			else { do @(label_"^"_rtn_"("_args_")") }
		}
	}
	catch {
		set SQLCODE=-400,%msg=$$$FormatText($$$Text("Error executing code for %1:  %2","%SQL.Server"),location,$ze)
		set %status=$$$ERROR($$$GeneralError,%msg)
		do RtnDelete(rtn)
		set rtn = "" // don't return routine name if deleted
		QUIT
	}
	#; --- Potentially collect UCQ details ---
	if $data(%SQLStats("GetStats")), collectSQLStats, ("||"_%SQLStats("LastRow"))'[("||"_rtn_"||") {
		set $list(%SQLStats("GetStats"),1) = $piece(%SQLStats("LastRow"),"||",$select($$$collectOriginalSQLStats:1,1:3))
	}
	
		#; Quit after running the routine (leave it around)
	RETURN:runMode=2
	
	try {
		do RtnDelete(rtn)
		set rtn = "" // don't PBR a routine name if it was already deleted
	}
	catch { 
		set SQLCODE=-400,%msg=$$$FormatText($$$Text("Error deleting temp routine for %1:  %2","%SQL.Server"),location,$ze)
		set %status=$$$ERROR($$$GeneralError,%msg)
		QUIT
	}
	QUIT
}
.
GetCursorNumber() [] PUBLIC {
		#; Bumps/returns the SQL cursor counter number
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	set tCursorCnt=$i(^%SYS("sql","cursor counter")) set:tCursorCnt>9999999999 ^%SYS("sql","cursor counter")=0,tCursorCnt=$i(^%SYS("sql","cursor counter"))
	QUIT tCursorCnt
}
.
/// Bumps/Returns a Unique SQL Statement Identifier 'SQLStatementID' (INTEGER) which can
/// be used to identify each SQL Statement that is stored in the SQL Statement Index (SSI)...
///
GetSQLStatementID() [] PUBLIC {
	RETURN $$GetSQLStatementIDPriv()
}
GetSQLStatementIDPriv() [] PRIVATE {
	$$$AddAllRoleTemporary
	set SQLStatementID=$i(^%SYS("sql","statement id"))  // Bump Counter!
	if SQLStatementID>9999999999 { // --- Reset Circular Counter ---
		set ^%SYS("sql","statement id")=0
		set SQLStatementID=$i(^%SYS("sql","statement id"))
	}
	RETURN SQLStatementID
}
.
/// Returns the 'SQLStatementID' value associated with the SQL Statement Index (SSI)
/// specified by the 'hash' paramter...
/// 
/// Parameters:
///  - hash :: passed by value, input
///     A hash IDKEY for the SQL Statement
///
/// Return value:
///   The 'SQLStatementID' value for the given 'hash' or the empty string ("")
///   if no SQL Statement Index entry exists for the given 'hash'
///
GetSQLStatementIDByHash(hash="") [] PUBLIC {
	RETURN $s(hash="":"",1:$LG($g($$$SQLIndex(1,hash,0)),6))
}
.
/// Returns the 'hash' value associated with the SQL Statement Index (SSI)
/// specified by the 'SQLStatementID' paramter...
/// 
/// Parameters:
///  - SQLStatementID :: passed by value, input
///     A Unique SQL Statement Identifier for the SQL Statement
///
/// Return value:
///   The 'hash' IDKEY value for the given 'SQLStatementID' or the empty string ("")
///   if no SQL Statement Index entry exists for the given 'SQLStatementID'
///
GetHashBySQLStatementID(SQLStatementID="") [] PUBLIC {
	RETURN $s(SQLStatementID="":"",1:$o($$$SQLIndex(4,SQLStatementID,"")))
}
.
/// Adds/Returns a new 'SQLStatementID' to the SQL Statement Index (SSI) specified
/// by the 'hash' paramter...
/// 
/// Parameters:
///  - hash :: passed by value, input
///     A hash IDKEY for the SQL Statement
///  - tSC  :: passed by reference, output
///     The status of the invocation of this method
///
/// Return value:
///   If the specified SQL Statement Index already has a valid 'SQLStatementID'
///   return this value; Otherwise, return a new 'SQLStatementID' value.
///   If the specified 'hash' value is the empty string (""), or if there is
///   no SQL Statement Index entry for the specified 'hash' value, then
///   return the empty string ("")
///
AddSQLStatementID(hash="",tSC="") [SQLCODE] PUBLIC {
	
	new %msg,SQLCODE
	
 	set tSC=$$$OK,$ZE=""
 	set SQLStatementID=""
	
 try {
	if hash="" { set tSC=$$$ERROR($$$ObjectScriptError,"The 'hash' parameter must be specified") THROW }
	if '$d($$$SQLIndex(1,hash)) { set tSC=$$$ERROR($$$ObjectScriptError,"No SQL Statement Index entry exists for the specified hash: "_hash) THROW }
	
	set SQLStatementID=$LG($g($$$SQLIndex(1,hash,0)),6)
	if SQLStatementID="" { // --- Add a new 'SQLStatmentID' to the given SQL Statement Index ---
		set SQLStatementID=$$GetSQLStatementIDPriv()
		set SQLCODE=0,%msg=""
		set status=$$UpdateSQLIndex(hash,,,,,,,SQLStatementID)
		if 'status { // --- The 'UpdateSQLIndex(...)' method Failed with an error ---
			set SQLStatementID=""
			set updSC=$$$ERROR($$$SQLError,SQLCODE,%msg)
			set tSC=$$$ERROR($$$ObjectScriptError,"The 'UpdateSQLIndex(...)' method failed to update the SQL Statement with the specified hash: "_hash)
			set tSC=$$$ADDSC(tSC,updSC)
			THROW
		}
	}
 }
 catch {
	set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
 }
	RETURN SQLStatementID
}
.
.
	// Record a SQL statement's location and information in the SQL Statement Index (SSI),
	// which has the following global structure:
	//
	//  $$$SQLIndex(...) = ^rINDEXSQL("sqlidx",...)
	//
	//  ^rINDEXSQL("sqlidx",1)  // Statement Index metadata version number - used to check if the statement index metadata is an old or current version
	//  ^rINDEXSQL("sqlidx",1,hash) // not defined, but used as the lock reference
	//  ^rINDEXSQL("sqlidx",1,hash,0) = $LIST(...)  // Compile Information from %qaqqt.MAC:  [If the SQL was fully qualified, $g(%sqlSchemaPath) and $g(%defschema) are ""]
	//                      1) mt("sqlcomp")        // SQL Compilation Mode (Normalized) - $case($g(%switch),"Runtime":"%Runtime","ODBC":"%ODBC","IntExt":"%INTEXT","Text":"%EXTERNAL","FDBMS":"%FDBMS",:"") [See: MIT063]
	//                      2) $g(%sqlSchemaPath)   // SQL Schema Path - used to define a search path of schemas to look up an unqualified table name [See: DPV3410]
	//                      3) $g(%defschema)       // SQL Default Schema - $LB(schema-names) that are the default schemas for this statement. Could be derived from 'packages' $LIST(...) if supplied. [e.g. $LB($$$DEFAULTSCHEMA) = $LB("SQLUSER")] [See: DPV1310]
	//                      4) $g(packages)         // SQL Packages - $LB(...) of class package names to turn into a current schema(s) list [See: DPV3372 & DPV4002]
	//                      5) $g(%switch)          // SQL Compilation Mode - { Runtime | ODBC | IntExt | Text | FDBMS | "" }  // NOTE: Text = Display; "" = Logical Mode [See: MIT063]
	//                      6) SQLStatementID       // Unique SQL Statement Identifier (INTEGER) - $$GetSQLStatementID^%SYS.SQLSRV() [See: MRP1312]
	//                      7) Object Insert/Update/Delete       // $lb(class,(0:update,1:insert,2:delete)) this is only for Insert/Update/Delete via Object API
	//  ^rINDEXSQL("sqlidx",1,hash,1) = # of lines of SQL Statement
	//  ^rINDEXSQL("sqlidx",1,hash,1,n) = SQL Statement line n
	//  ^rINDEXSQL("sqlidx",1,hash,2) = Information about the user that triggered compile :: $LB($username,client name,client ip,client exe, $LB(call stack))
	//  ^rINDEXSQL("sqlidx",1,hash,"child",child-statement-hash) = ""
	//  ^rINDEXSQL("sqlidx",1,hash,"rtu",rtu-statement-hash) = ""
	//  ^rINDEXSQL("sqlidx",1,hash,"err",...) = error string
	//  ^rINDEXSQL("sqlidx",1,hash,"plan") = # of query plan lines
	//  ^rINDEXSQL("sqlidx",1,hash,"plan",n) = query plan line n
	//  ^rINDEXSQL("sqlidx",1,hash,"planinfo") = $LIST()
	//                      1) Frozen flag (3/2/1/0) 3 - unfrozen/parallel, 2 - frozen implcitly after upgrade, 1 - frozen explicitly, 0 - not frozen
	//                      2) timestamp for when the statement plan was last saved
	//                      3) product version string for this plan
	//                      4) parent hash - If this is a parallel recursive compile, this is the hash of the SQL Statement that caused this statement to be compiled.
	//                      5) Natural query (so simple no need to record stats)
	//                      6) Frozen plan different to current plan
	//                      7) timestamp for last frozen plan updated check
	//                      8) product version when we last checked frozen plan updated
	//  ^rINDEXSQL("sqlidx",1,hash,"priv") = privileges needed to execute this statement
	//  ^rINDEXSQL("sqlidx",1,hash,"rel",relation) = ""
	//  ^rINDEXSQL("sqlidx",1,hash,"rtn",routine) = $LB(code-container-type,runtimeLocation)  ; For UCQ runtimeLocation is the UCQ classname which is different from the containers name
	//  ^rINDEXSQL("sqlidx",2,routine,hash) = ""
	//  ^rINDEXSQL("sqlidx",3,relation,hash) = ""
	//  ^rINDEXSQL("sqlidx",4,SQLStatementID,hash) = ""
	//		-=-=-=- DPV6568 MOVED THE STATS out of the "1" node to new section of the global -=-=-=-
	//  ^rINDEXSQL("sqlidx",5,hash,"stat") = $LIST()
	//                      1) Count how many times called
	//                      2) Total time running this query
	//                      3) Variance of stats
	//                      4) +$HOROLOG when we first recorded stats for this query
	//                      5) Total rowcount
	//                      6) Total commands executed
	//  ^rINDEXSQL("sqlidx",5,hash,"stat",+$h) = $LB(count,totaltime,variance,totalrowcount,totalcommands) individual day stats, keeps last 400 days worth
	//  ^rINDEXSQL("sqlidx",5,hash,"stat",+$h,hour) = $LB(count,totaltime,variance,totalrowcount,totalcommands) individual hourly stats, keeps last 400 days worth
	//  ^rINDEXSQL("sqlidx",6,+$h,hash) = ""	// day index for stats
	//	^rINDEXSQL("sqlidx","statsversion")=2
	// 
	// Parameters:
	//  - pHash :: passed by value, input
	//     A hash IDKEY for the SQL Statement
	//  - pSQL  :: passed by reference, input
	//     An array of SQL text with the following format:
	//       pSQL=# of lines of the SQL Statement
	//       pSQL(n)=SQL Statement line n
	//  - pRoutine :: passed by value, input
	//     is the name of the routine or class the SQL is in.  
	//     A value of "%Freeze%Plan" means this is being called from the SMP UI to freeze a plan and we do not need to record the location.
	//  - pRelations :: pssed by value, input
	//     A $LIST(...) of relation names that are used by this SQL Statement.  Relation name is in the format: $$$UPPER(IQN)
	//  - pPlan :: passed by reference, input
	//     An array of this SQL Statement plan with the following format:
	//       pPlan=# of lines of the SQL Statement Plan
	//       pPlan(n)=SQL Statement Plan line n
	//  - pPrivs :: passed by reference, input
	//     The SQL privileges needed to execute this SQL Statement
	//  - pFrozen :: passed by value, input
	//     A plan state for this SQL Statement: 0, 1, 2, 3
	//     NOTE: The value of this parameter should only be called with 0 or 3, for now!
	//  - pCompileOptions :: passed by value, input
	//     A $LIST(...) of information stored in the following global reference: ^rINDEXSQL("sqlidx",1,hash,0)
	//     NOTE: For details regarding each $LIST(...) element, see the global reference definition above
	//  - pCodeContainer :: passed by value, input
	//     The code container for this SQL Statement: RTN = Routine; CLS = Class
	//  - pParentHash :: passed by value, input
	//     A hash for the parent parallel SQL Statement if this SQL Statement is a parallel child 
	//  - pNatural :: passed by value, input
	//     A flag specifying if this SQL Statement is a Natural Query: 0 = False | 1 = True
	//
	// Return value:
	//   1 = Successful Invocation; 0 = Error Occurred
	//   If error, then SQLCODE and %msg are set.
	//
	// Called From:
	//   - end^%qaqqt
	//     This method is called in two ways: 
	//       - To save a new entry
	//       - To update an existing entry, but only passing the following parameters:
	//           pHash, pRoutine, pCodeContainer
	//
SaveSQLIndex(pHash,&pSQL,pRoutine,pRelations,&pPlan,&pPrivs,pFrozen=0,pCompileOptions,pCodeContainer="RTN",pParentHash="",pNatural=0) [SQLCODE] PUBLIC {
	try {
		set return=1
		set savezu139=$zu(139,0)	// transaction may be suspended if this is compiling a cached query, we don't want transaction to be suspened for writing to ^rINDEXSQL.
		if $g($$$SQLIndexVersion)<$$$SQLIndexCurrentVersion { do DeleteEntireSQLIndex() }
.
		if +$g($$$SQLIndex("statsversion"))<2 {
			set sc=$$QueueSystem^%SYS.WorkQueueMgr(,"$$ConvertSIStatsV2^%SYS.SQLSRV")
			if $$$ISERR(sc) { goto end }	// should we reoprt a failure here?
		}
.
			#; There have been multiple ProdLogs that this lock fails occasionlly in a sharded environment.  PL 154738 and 151209
			#; These are almost impossible to reproduce consisttantly.
			#; I have seen other tests that change the lock timeout to something 2 or even <2, and then locks on a very busy system can sometimes fail to acquire.
			#; For this lock timeout, I am changing it to use MAX(20,$zu(115,4)) to hopefully eliminate this lock timeout from the shard test cases.
			#; NOTE:  This lock could get a <PROTECT> error if on a mirror db and the db is read-only and we are not an async member
		$$$lockexclusive($$$SQLIndex(1,pHash),$s($zu(115,4)<20:20,1:$zu(115,4)),gotlock)
		if '$g(gotlock) {
			set SQLCODE=-114,%msg=$$$FormatText($$$Text("Unable to acquire exclusive lock to save SQL Statement Index entry with ID '%1'. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),pHash,$system,$namespace,$job),return=0
			GOTO end
		}
		set savets=$zu(188),savets=$zdt(savets,3,1,$l($p(savets,".",2))),runtimelocation=pRoutine
