#; Get bbsiz (maximum memory per process)
#; This method should only be called from sql internal %qaq* rtn
Getbbsiz() [SQLCODE] public {
	try{
		set callRoutine=$zu(96,9),callDatabase=$zu(96,10)
		if callDatabase=$zu(12,$p($g(^%SYS("DBRefByName","IRISLIB")),"^",3)),($e(callRoutine,1,4)="%qaq") {
			$$$AddAllRoleTemporaryInTry
		} 
		RETURN $system.Config.Modifybbsiz()
	} catch tException{
		set SQLCODE=-400,%msg=$$$FormatText($$$Text("Error getting maximum memory per process: '%1'","%SYS.SQLSRV"),$ze)
		throw tException
 	}
 	RETURN ""
}
