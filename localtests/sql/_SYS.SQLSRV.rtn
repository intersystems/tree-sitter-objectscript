				set $$$SQLIndex(2,pRoutine,pHash)=""
			}
			if $d(pPlan) {
				merge $$$SQLIndex(1,pHash,"plan")=pPlan
				set $$$SQLIndex(1,pHash,"planinfo")=$lb(pFrozen,savets,$zv,pParentHash,pNatural)
			} else {
				set $$$SQLIndex(1,pHash,"planinfo")=$lb(,savets)
			}
			if $d(pPrivs) {
				merge $$$SQLIndex(1,pHash,"priv")=pPrivs
			}
			set ptr=0
			while $listnext(pRelations,ptr,relation) { 
				set $$$SQLIndex(1,pHash,"rel",relation)=""
				set $$$SQLIndex(3,relation,pHash)=""
			}
			if pParentHash'="" { if '$$UpdateSQLIndex(pParentHash,,,pHash,pRoutine,pCodeContainer) {} }
		}
		else {				// update log entry
			if pRoutine'="",pRoutine'="%Freeze%Plan" {
				set $$$SQLIndex(1,pHash,"rtn",pRoutine)=$lb(pCodeContainer,runtimelocation)
				set $$$SQLIndex(2,pRoutine,pHash)=""
			}
			if $case($lg($g($$$SQLIndex(1,pHash,"planinfo")),1),1:0,2:0,"":0,:1) {	// only update a non-frozen statement entry.  frozen plans remain frozen and are never updated, whether in error state or not.
				if $d(pCompileOptions) { // --- Update the 'pCompileOptions' Value ---
					set oldSQLStatementID=$LG($g($$$SQLIndex(1,pHash,0)),6)
					
					set $$$SQLIndex(1,pHash,0)=pCompileOptions
					kill:oldSQLStatementID'="" $$$SQLIndex(4,oldSQLStatementID,pHash)  // Kill old 'SQLStatementID' Index!
					set:$LG(pCompileOptions,6)'="" $$$SQLIndex(4,$LG(pCompileOptions,6),pHash)="" // Set 'SQLStatementID' Index!
				}
				merge:$d(pSQL) $$$SQLIndex(1,pHash,1)=pSQL
				if $d(pPlan) {
					kill $$$SQLIndex(1,pHash,"plan")	// Just in case old plan has more data than new plan
					merge $$$SQLIndex(1,pHash,"plan")=pPlan
					set $$$SQLIndex(1,pHash,"planinfo")=$lb(pFrozen,savets,$zv,pParentHash,pNatural)
				} else {
					set $li($$$SQLIndex(1,pHash,"planinfo"),2)=savets
				}
				if $d(pPrivs) {
					merge $$$SQLIndex(1,pHash,"priv")=pPrivs
				}
				set ptr=0
				while $listnext(pRelations,ptr,relation) {
					set $$$SQLIndex(1,pHash,"rel",relation)=""
					set $$$SQLIndex(3,relation,pHash)=""
				}
				if $g(pParentHash)'="" { if '$$UpdateSQLIndex(pParentHash,,,pHash,pRoutine,pCodeContainer) {} }
			}
		}
