				set columns=columns_")"
				set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"quit:$zobjexport("_columns_",60)")
			}
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"set x=$zobjexport(+%qmsgid,1),x=$zobjexport(+$g(%qebqacn,%qacn),2) do:%0IRISServer.Logging ##class(%SYS.DBSRV).logappend(""Write Header:  %qmsgid ""_+%qmsgid_"",  %qacn: ""_+$g(%qebqacn,%qacn)) if $zobjexport(""%col"",56) { kill %datax(%qacn) merge %datax(%qacn)=%col quit  }")
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"} while 1")
		}
		else {	// Single column query
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"do {")
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"&sql(FETCH C)")
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"set x=$zobjexport(+%qmsgid,1),x=$zobjexport(+$g(%qebqacn,%qacn),2) do:%0IRISServer.Logging ##class(%SYS.DBSRV).logappend(""Write Header:  %qmsgid ""_+%qmsgid_"",  %qacn: ""_+$g(%qebqacn,%qacn))") // WriteHeader again in case FETCH made a re-entrant call
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"if SQLCODE { set %qrc=SQLCODE set:%qrc<0 %qrc=-%qrc if %qrc=100 { Set x=$zobjexport(100,8) do:%0IRISServer.Logging ##class(%SYS.DBSRV).logappend(""~Flushing 100~"") } else { do ##class(%SYS.DBSRV).FlushError(""ServerLoop - Query Fetch"") } quit }")
			if pStream {
