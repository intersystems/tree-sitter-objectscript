	// Record this SQL statement's location in SQL Statement Index ($$$SQLIndex(...))
	// This API is only called when importing an SQL Statement
	//
	// Parameters:
	//  - pHash :: passed by value, input
	//     hash IDKEY for the SQL Statement
	//  - pSQL  :: passed by reference, input
	//     an array of SQL text
	//  - pRelations :: pssed by value, input
	//     a $list of relation names that are used by the statement.  Relation name is in $$$UPPER(IQN) format
	//  - pPlan :: passed by reference, input
	//         is the plan array to save for this statement
	//  - pPrivs :: passed by reference, input
	//         is the sql privileges needed to execute this statement
	//  - pNode0 :: passed by value, input
	//     information stored in the 0 node, contains values of mt("sqlcomp"), %sqlSchmaPath, and %defschema this statement was compiled with
	//  - pPlanInfo :: passed by value, input
	//     information stored in the "planinfo" node
	//  - pStatementVersion :: passed by value, input
	//     Internal Statement Version, don't allow import of statement from older internal version
	//  - pCodeContainer :: passed by value, input
	//     RTN for Routine, CLS for Class
	//  - pChildren :: passed by reference, input
	//         is the parallel children for this parent statement
	//  - pStats :: passed by value, input
	//
SaveSQLIndexImport(pHash,&pSQL,pRelations,&pPlan,&pPrivs,pNode0,pPlanInfo,pStatementVersion="",pCodeContainer="RTN",&pChildren,pStats) [SQLCODE] PUBLIC {
	try {
		set return=1
		try {
			$$$lockexclusive($$$SQLIndex(1,pHash),$s($zu(115,4)<20:20,1:$zu(115,4)),gotlock)
		} catch {
			if $ze["<PROTECT" { set gotlock=0 quit }
			throw
		}
		if 'gotlock {
			set SQLCODE=-114,%msg=$$$FormatText($$$Text("Unable to acquire exclusive lock to save SQL Statement Index entry with ID '%1'. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),pHash,$system,$namespace,$job),return=0
			quit
		}
			#; Make sure the statement being imported is not from an older internal version than the current statement index version
		if pStatementVersion<$$$SQLIndexCurrentVersion {
			set SQLCODE=-400
			set %msg=$$$FormatText($$$Text("Cannot import SQL Statements that were exported by an earlier version of the SQL Statement Index.  Current SQL Statement Index version is '%1'.  Version being imported is '%2'.","%SQL.Server"),$$$SQLIndexCurrentVersion,$s(pStatementVersion:pStatementVersion,1:$$$Text("Pre-release","%SQL.Server")))
			//"Attempt to import SQL index entry that was exported with an older version of the SQL index"
			set return=0
			GOTO end
		}
		set $$$SQLIndex(1,pHash,0)=pNode0
		merge $$$SQLIndex(1,pHash,1)=pSQL
		if $g(pPlan) { merge $$$SQLIndex(1,pHash,"plan")=pPlan }
		if pPlanInfo'="" { set $$$SQLIndex(1,pHash,"planinfo")=pPlanInfo }
		else { 
		set savets=$zu(188),savets=$zdt(savets,3,1,$l($p(savets,".",2)))
			set $$$SQLIndex(1,pHash,"planinfo")=$lb(,savets)
		}
		if $d(pPrivs) {	merge $$$SQLIndex(1,pHash,"priv")=pPrivs }
		if $d(pChildren) {
			set child=""
			for  {
				set child=$o(pChildren(child)) quit:child=""
				set $$$SQLIndex(1,pHash,"child",child)=""
			}
		}
		if $d(pStats) { set $$$SQLIndex(5,pHash,"stat")=pStats }
		set ptr=0
		while $listnext(pRelations,ptr,relation) { 
			set $$$SQLIndex(1,pHash,"rel",relation)=""
			set $$$SQLIndex(3,relation,pHash)=""
		}
		set:$LG(pNode0,6)'="" $$$SQLIndex(4,$LG(pNode0,6),pHash)="" // Set 'SQLStatementID' Index!
.
end		$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock)
	} catch {
		try {
			$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock) // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
			if $ze["<EXTERNAL INTERRUPT" { throw } // If we were interrupted externally, unlock and throw the same EI error.  Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
			elseif $ze["<PROTECT" {}	// Ignore <PROTECT> errors, user does not have permission to write to SQL index, so this entry will not be updated
			else { set SQLCODE=-400,%msg=$$$FormatText($$$Text("Unexpected error in attemptng to save SQL statement index during import, $ze = %1. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),$ze,$system,$namespace,$job),return=0 }
		} catch {
			$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock) // 	There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
			if $ze["<EXTERNAL INTERRUPT" { throw }	// If we were interrupted externally in the catch(), unlock and throw the same EI error.  Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
				#; it should be almost impossible to get here.  An error within the error handler and neither were EI errors, reset setting and release locks and report error
			set SQLCODE=-400,%msg=$$$FormatText($$$Text("Unexpected error in attemptng to save SQL statement index during import, $ze = %1. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),$ze,$system,$namespace,$job),return=0
		}
	}
	RETURN return
}
