	// Note, DPV6423 moved sendInterrupt and executeRemoteCommand here from %apiSQL because in order to escalate to the 
	// %All role temporarily, the routine must live in the IRISSYS database, which %SYS.* routines do.
sendInterrupt(pid = "", intReason = "", timeout = 10, interface = 9, metadata = "", SQLStatementID = "") [] PUBLIC {
#IF 0   ;------------------------------------------------------------------------------
 ; METHOD: sendInterrupt
 ; 
 ; DESCRIPTION:
 ;    Send an Interrupt to the given IRIS Process (pid)...
 ;    
 ;    NOTE: The External Interrupt issued by this method to the given 
 ;          process ID (pid) is roughly analogous to that of the Ctrl-C 
 ;          key mechanism for manual interruption of program execution.
 ;
 ;          For further details, refer to the DevLog that implemented
 ;          this feature: 
 ;             LRS876 (12/15/2004) - Implement process external interrupts
 ;
 ; PARAMETERS:
 ;   pid            - The process ID ($JOB) to which to send the interrupt
 ;   intReason      - This is an optional parameter to be passes as the
 ;                    'reason' parameter to the 'SendInterrupt(pid[,reason])'
 ;                    method
 ;   timeout        - The maximum number of seconds to process the interrupt     [DEFAULT: 10]
 ;   interface      - The Interface to interrupt:
 ;                      0 = Embedded SQL
 ;                      1 = Cached Query
 ;                      2 = SQL Server/xDBC
 ;                      3 = CSP (e.g. SMP SQL Page)
 ;                      9 = General-Purpose                                      [DEFAULT: 9]
 ;                    NOTE: This is an optional value that may help to optimize
 ;                          the interrupt for the specified Interface
 ;   metadata       - An optional string that must be matched to successfully
 ;                    interrupt the specified process (pid) for the specified
 ;                    'intReason'
 ;                    InterSystems INTERNAL USE ONLY:
 ;                      $c(0) = Ensure that this parameter is not passed to the
 ;                              following method and is omitted entirely so
 ;                              that it is not used to conditionally interrupt
 ;                              the specified 'pid' based on the 'Application
 ;                              Metadata Stack':
 ;                                $SYSTEM.Util.SendInterrupt(pid,intReason[,metadata])
 ;                      This will send and interrupt to the specified 'pid'
 ;                      regardless of what that process is executing.
 ;   SQLStatementID - [For details about this parameters, refer to the           [DEFAULT: ""]
 ;                     description specified in the 'SQLInterrupt(...)' method,
 ;                     as this parameter will only be used for error reporting
 ;                     and will have no material effect on this method whatsoever]
 ;    
 ; RETURN Value: The status of this method's execution
#ENDIF  ;------------------------------------------------------------------------------
	
	new %objlasterror
	set tSC=$$$OK
	try {
		set callRoutine=$zu(96,9),callDatabase=$zu(96,10)
		if callDatabase=$zu(12,$p($g(^%SYS("DBRefByName","IRISLIB")),"^",3)),callRoutine="%apiSQL" {
			$$$AddAllRoleTemporaryInTry
		}
		if pid="" { set tSC=$$$ERROR($$$ObjectScriptError,"The 'pid' parameter must be specified with a valid IRIS Process ID") THROW }
		set pidNS=$SYSTEM.Process.NameSpace(pid)
		if pidNS=0 { set tSC=$$$ERROR($$$ObjectScriptError,"No such IRIS Process ID exists (pid: "_pid_")") THROW }
		
		set:intReason="" intReason=$$$UserInitiatedInterrupt  // Indicates a User-Initiated <EXTERNAL INTERRUPT>
		
		// --- Process External Interrupt ---
		if metadata=$c(0) { set int1SC=$SYSTEM.Util.SendInterrupt(pid,intReason) }  // First attempt: If it works, no additional processing required!
		else { set int1SC=$SYSTEM.Util.SendInterrupt(pid,intReason,metadata) }      // First attempt: If it works, no additional processing required!
		if ",1,2,3,"[(","_int1SC_",") { // --- Additional Processing Required ---
			// --- Prime External Interrupt Settings ---
			set timeoutIter=timeout*100 // The maximum number of iterations to timeout in .01 second intervals
			set sieSC=$$$OK  // 'SetInterruptEnable()' Status
			set:int1SC=3 sieSC=$$executeRemoteCommand(pid,"set "_$name($$$processInterruptStatePPG($JOB))_"=$SYSTEM.Util.SetInterruptEnable(1)",timeout,interface)  // Enable Interrupts on Remote Process (pid)
			for iter=0:1:timeoutIter { // --- Try External Interruption for 'timeout' Seconds ---
				if metadata=$c(0) { set intSC=$SYSTEM.Util.SendInterrupt(pid,intReason) }
				else { set intSC=$SYSTEM.Util.SendInterrupt(pid,intReason,metadata) }
				QUIT:intSC=0  // Successful Interrupt!
				HANG .01      // Keep trying until success: Interval Hang (Total Hange Time = timeoutIter * .01 secs)
			}
			// --- Only reset 'SetInterruptEnable()' if 'SendInterrupt()' failed, since 'SendInterrupt()' sets this value to 0 (OFF) if it succeeded to send a successful <EXTERNAL INTERRUPT> ---
			set:(int1SC=3)&&$$$ISOK(sieSC)&&(intSC'=0) sieSC=$$executeRemoteCommand(pid,"set "_$name($$$processInterruptStatePPG($JOB))_"=$SYSTEM.Util.SetInterruptEnable(+$g("_$name($$$processInterruptStatePPG($JOB))_"))",timeout,interface)  // Reset Interrupts on Remote Process (pid)
		}
		else { set intSC=int1SC }
		
		if intSC'=0 { // --- External Interrupt Failed ---
			set errMsg1="External Interrupt request failed with an error: "
			if intSC=1 { set errMsg2="The target process 'pid' does not exist" }
			elseif intSC=2 { set errMsg2="The target process 'pid' did not respond" }
			elseif intSC=3 { set errMsg2="The target process 'pid' has not (re)enabled external interrupts, or is halting" }
			elseif intSC=4 { set errMsg2="The target process 'pid' is at a command prompt" }
			elseif intSC=5 { set errMsg2="There is no match for the specified '"_$s(SQLStatementID'="":"SQLStatementID",1:"metadata")_"' parameter" }
			elseif intSC=6 { set errMsg2="The target process 'pid' cannot be the current process" }
			elseif intSC=7 { set errMsg2="The specified 'metadata' is too long (> 1716 characters)" }
			else { set errMsg2="Unknown result ("_intSC_") returned from SendInterrupt()" }
			set errMsg2=errMsg2_" [Process ID (pid): "_pid_"; intErr: "_intSC_"]"
			set errMsg=errMsg1_errMsg2
		
			set tSC=$$$ERROR($$$ExternalInterruptionFailure,errMsg2) THROW
		}
	} catch {
		set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
	}
	RETURN tSC
}
.
executeRemoteCommand(pid = "", command = "", timeout = 10, interface = 9) [] PRIVATE {
#IF 0   ;------------------------------------------------------------------------------
 ; METHOD: executeRemoteCommand
 ; 
 ; DESCRIPTION:
 ;    Send the specified (command) to the given process (pid) for Remote
 ;    Command Execution (RCE)...
 ;
 ;    NOTE: For further details, refer to the DevLog that implemented
 ;          this feature: 
 ;             JLK003 (11/12/1998) - Add remote command execution
 ;
 ; PARAMETERS:
 ;   pid         - The process ID ($JOB) to which to send the interrupt
 ;   command     - An ObjectScript Command to be executed by the specified
 ;                 Remote Process (pid)
 ;   timeout     - The maximum number of seconds to execute the Remote Command    [DEFAULT: 10]
 ;   interface   - The Interface to interrupt:
 ;                   0 = Embedded SQL
 ;                   1 = Cached Query
 ;                   2 = SQL Server/xDBC
 ;                   3 = CSP (e.g. SMP SQL Page)
 ;                   9 = General-Purpose                                          [DEFAULT]
 ;                 NOTE: This is an optional value that may help to optimize
 ;                       the RCE for the specified Interface
 ;    
 ; RETURN Value: The status of this method's execution
#ENDIF  ;------------------------------------------------------------------------------
	
	new %objlasterror
	set tSC=$$$OK
	try {
		if pid="" { set tSC=$$$ERROR($$$ObjectScriptError,"The 'pid' parameter must be specified with a valid IRIS Process ID") THROW }
		set pidNS=$SYSTEM.Process.NameSpace(pid)
		if pidNS=0 { set tSC=$$$ERROR($$$ObjectScriptError,"No such IRIS Process ID exists (pid: "_pid_")") THROW }
		if command="" { set tSC=$$$ERROR($$$ObjectScriptError,"The 'command' parameter must be specified with a valid ObjectScript Command") THROW }
		
		// --- Process Remote Command Execution (RCE) ---
		set timeoutIter=timeout*100 // The maximum number of iterations to timeout in .01 second intervals
		for iter=0:1:timeoutIter { // --- Try Remote Command Execution for 'timeout' Seconds ---
			set intSC=$ZU(145,pid,command)
			QUIT:intSC=0  // Successful Remote Command Execution!
			HANG .01      // Keep trying until success: Interval Hang (Total Hange Time = timeoutIter * .01 secs)
		}
		
		if intSC'=0 { // --- Remote Command Execution Failed ---
			set errMsg1="Remote Command Execution failed with an error: "
			if intSC=1 { set errMsg2="Another command is already scheduled and waiting" }
			elseif intSC=2 { set errMsg2="Command is too long" }
			elseif intSC=3 { set errMsg2="Invalid command" }
			elseif intSC=4 { set errMsg2="Too many error catches" }
			elseif intSC=5 { set errMsg2="Execution error" }
			elseif intSC=6 { set errMsg2="No space on argstack" }
			elseif intSC=7 { set errMsg2="Response is too long" }
			elseif intSC=8 { set errMsg2="Broadcast error" }
			elseif intSC=9 { set errMsg2="Invalid type" }
			else { set errMsg2="Unknown result ("_intSC_") returned" }
			set errMsg2=errMsg2_" (Process ID: "_pid_")"
			set errMsg=errMsg1_errMsg2
			
			set tSC=$$$ERROR($$$RemoteCommandExecutionFailure,errMsg2) THROW
		}
	} catch {
		set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
	}
	RETURN tSC
}
.
#; Get RTPC runtime query for RTPC Show Plan
#; This method should only be called from %apiSQL rtn
GetShowPlanRTPCSQL(&code,&sqlparms,&SQLrtpcsql) [err] public {
	try{
		set callRoutine=$zu(96,9),callDatabase=$zu(96,10)
		if callDatabase=$zu(12,$p($g(^%SYS("DBRefByName","IRISLIB")),"^",3)),(callRoutine="%apiSQL") {
			$$$AddAllRoleTemporaryInTry
		}
		set sc=$$$OK
		do RunTempCode(.code,"Main",.sc,,,"Getting RTPC Query",".sqlparms,.SQLrtpcsql")
		throw:$$$ISERR(sc)||('$d(SQLrtpcsql))
	} catch tException{
		set err="GetShowPlanRTPCSQL",%msg=$$$FormatText($$$Text("Error getting RTPC runtime query in ShowPlan.","%SYS.SQLSRV"))
		throw tException
 	}
 	RETURN
}
.
	// Function that can be called to see if the server support Columnar fastInser Phase II
	// If you call this and get a <NOLINE>, the server does not have DPV6511
HasDPV6511() [] PUBLIC {
	RETURN 1
}
.
#; Save SQL statement index for object insert/update/delete
AddObjIUDSQLIndex(hash) [SQLCODE] PUBLIC {
	set cls=$e(hash,2,*-2),type=$e(hash,*)
	$$$comClassKeyGetLvar(table,cls,$$$cCLASSsqltablename)
	Return:table=""
	$$$comClassKeyGetLvar(schema,cls,$$$cCLASSsqlschemaname)
	Return:schema=""
	set iqn=$$$BuildIQN(schema,table)
	set sql($i(sql))="Object "_$case(type,1:"insert",2:"delete",:"update")_" for "_iqn
	set privs("1,"_iqn,$case(type,1:"i",2:"d",:"u"))=""
	//								pHash,&pSQL,pRoutine,pRelations,&pPlan,&pPrivs,pFrozen,pCompileOptions,pCodeContainer
	return $$SaveSQLIndex^%SYS.SQLSRV(hash,.sql,cls,$lb(iqn),,.privs,0,$lb(,,,,,,$lb(cls,type)),"CLS") 
}
.
#; Check if a object insert/update/delete SQL statement index neeeds to be deleted
NeedDeleteObjIUDSQLIdx(hash) PUBLIC {
	set node=$g($$$SQLIndex(1,hash,0))
	set objIUD=$lg(node,7)
	RETURN:objIUD="" 0
	set cls=$lg(objIUD)
	RETURN:cls="" 1 // should not happen
	RETURN '$d($$$defClassRaw(cls)) // this class does not exist
}
.
