			}
			$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock) // There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
			set:$g(savezu139) savezu139=$zu(139,savezu139)
			if $ze["<PROTECT" {}	// Ignore <PROTECT> errors, user does not have permission to write to SQL index, so this entry will not be updated
			else { set SQLCODE=-400,%msg=$$$FormatText($$$Text("Unexpected error in attempting to save SQL statement index, $ze = %1. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),$ze,$system,$namespace,$job),return=0 }
		} catch {
			if $ze["<EXTERNAL INTERRUPT" {
					#; If we were interrupted externally in the catch(), unlock, restore zu139, and throw the same EI error
					#; Because we got an EI, $SYSTEM.Util.GetInterruptEnable() is now 0
				$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock) // 	There is a very small chance gotlock=1 even though we did not lock if an async error occurred after locktime and before setting gotlock=0, but unlocking again should not hurt
				set:$g(savezu139) savezu139=$zu(139,savezu139)
				throw
			} elseif $ze'["<PROTECT" {
					#; it should be almost impossible to get here.  An error within the error handler and neither were EI errors, reset setting and release locks and report error
				$$$unlockexclusive($$$SQLIndex(1,pHash),I,gotlock)
			} else { quit } // don't report error for <PROTECT> on unlock
			do:$g(savezu139) $zu(139,savezu139)
			set SQLCODE=-400,%msg=$$$FormatText($$$Text("Unexpected error in attempting to save SQL statement index, $ze = %1. System:Instance: %2, Namespace: %3, $Job: %4","%SQL.Server"),$ze,$system,$namespace,$job),return=0
		}
	}
	RETURN return
}
