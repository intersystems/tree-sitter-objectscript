.
GenerateClose(pClassName,&sequence) PUBLIC {
	set method="%OnClose"
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHplaceafter,"%Open")
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHprocedureblock,1)
	// SQLCODE is a public variable returned implicitly
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHpubliclist,"SQLCODE")
	set code=0
	#; Check $$$FetchStatus to see if we need to call CLOSE or not, check if whole of %qsc is undefind in case this public array was removed in HALT handling
	#; before this oref %OnClose was called so we will still call CLOSE here. If we call cursor CLOSE when it was already closed the cursor logic handles this anyway, so skipping
	#; calling this is just an optimization.
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"if i%%qacn'="""",i%%qacn'=""ParallelWorker"",$g(%qsc(i%%qacn,0))||('$d(%qsc(i%%qacn))) { &sql(CLOSE C) Kill %qsc(i%%qacn,0) } Else { Set SQLCODE=0 }")
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code)
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHsequencenumber,$increment(sequence))
	QUIT $$$OK
}
