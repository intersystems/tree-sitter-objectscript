	if pColumns>0 {
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"set r=r+1,"_$$$tFileQ_"(s,r,1)="_$s($g(%qinfo("fastFetch")):"i%%col1",1:"%col(1)")_" for c=2:1:"_pColumns_" { set ^(c)="_$s($g(%qinfo("fastFetch")):"@(""i%%col""_c)",1:"%col(c)")_" }")
	}
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"}")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"set "_$$$tFileQ_"(s)=r,sqlcode=SQLCODE &sql(CLOSE C)")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"QUIT sqlcode")
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code)
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHsequencenumber,$increment(sequence))
