.
GenerateQACNProperty(class,&sequence) PUBLIC {
	Set property="%qacn"
	If $$$nameIsNameInvalid(property) Quit $$$ERROR($$$PropertyNameInvalid,property)
	If $Length(property)>$$$MAXNAMELENGTH Quit $$$ERROR($$$PropertyNameTooLong,property,$$$MAXNAMELENGTH)
	$$$defMemberSet(class,$$$cCLASSproperty,property,"")
	$$$defMemberKeySet(class,$$$cCLASSproperty,property,$$$cPROPtype,"%Integer")
	$$$defMemberKeySet(class,$$$cCLASSproperty,property,$$$cPROPmultidimensional,1)
	$$$defMemberKeySet(class,$$$cCLASSproperty,property,$$$cPROPsequencenumber,$increment(sequence))
}
.
GenerateColumnProperties(class,count,&sequence) PUBLIC {
	for cnt=1:1:count {
		set property="%col"_cnt
		if $$$nameIsNameInvalid(property) { RETURN $$$ERROR($$$PropertyNameInvalid,property) }
		if $l(property)>$$$MAXNAMELENGTH { RETURN $$$ERROR($$$PropertyNameTooLong,property,$$$MAXNAMELENGTH) }
		$$$defMemberSet(class,$$$cCLASSproperty,property,"")
		$$$defMemberKeySet(class,$$$cCLASSproperty,property,$$$cPROPtype,"%SQL.Literal")
		$$$defMemberKeySet(class,$$$cCLASSproperty,property,$$$cPROPprivate,1)
			#; This is place the proreties at the "bottom" of the cached query class when viewed in the editor.
			#; May need to be adjusted if we ever have more than 1000 other items in an xDBC cached query
		$$$defMemberKeySet(class,$$$cCLASSproperty,property,$$$cPROPsequencenumber,$increment(sequence))
	}
	RETURN
}
.
GenerateDispatchQuery(pClassName, &nRTP,&hashstr, &sequence) {
	set method="Query"
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHprocedureblock,1)
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHreturntype,"%RegisteredObject")
	#; dispatchFunc: 0:dispatch only, return rtoref; 1: do %Open; 2: do Query
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHformalspec,"funcFD:%Boolean=0,dispatchFunc:%Integer=2")
	set code=0
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"try { ")
	for i=1:1:nRTP("dispatch-code","rtexpr") {
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_nRTP("dispatch-code","rtexpr",i))
	}
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"} catch SQLrtpcerr {")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"If $p($p($ze,"">""),""<"",2)'="""" { ")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg)")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"throw ##class(%Exception.SQL).CreateFromSQLCODE(SQLCODE,%msg)") 
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"} else { ") 
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"throw SQLrtpcerr")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"} ") 	
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"}")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"set SQLrtpcrthash="_$$$Base64SHACode("$lb("""_nRTP("preparedSQLHash")_""","_nRTP("rtexprStr")_")",10))	
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"set SQLrtpcrtclassname=""%sqlcq.""_$tr($namespace,""%_-$@:/\[]^ ."",""pudssssssssss"")_""."_$p(pClassName,".",*)_"""_"".H""_SQLrtpcrthash")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"try { ")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"set SQLrtpcrtoref=$classmethod(SQLrtpcrtclassname,""%New"")")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"if $IsObject(SQLrtpcrtoref) {")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"if (dispatchFunc=2) { do SQLrtpcrtoref.Query(funcFD) } elseif (dispatchFunc=1) { do SQLrtpcrtoref.%Open() }")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"return SQLrtpcrtoref")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"}")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"}")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"catch SQLrtpcerr {")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"if (SQLrtpcerr.Name'=""<CLASS DOES NOT EXIST>""){")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"If $p($p($ze,"">""),""<"",2)'="""" { ")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9,9)_"do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg)")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9,9)_"throw ##class(%Exception.SQL).CreateFromSQLCODE(SQLCODE,%msg)") 
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"} else { ") 
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9,9)_"throw SQLrtpcerr")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"} ") 
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"}")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"}")
	set serverProtocol=$LI(hashstr,2)
	set hashstr = $LTS(hashstr)
	for i=1:1:nRTP("dispatch-code","sql") {
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,nRTP("dispatch-code","sql",i))
	}
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"set SQLrtpcrtoref=$$CreateNewRunTimeQuery^%SYS.SQLRTUMAKER(SQLrtpcrtclassname,$lb("_hashstr_"),.SQLrtpcsql,"""_nRTP("comp")_""","_serverProtocol_",$classname(),.SQLrtpcerr,.SQLrtpcStatus)")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"if +SQLrtpcStatus=0 {  throw ##class(%Exception.StatusException).CreateFromStatus(SQLrtpcStatus) } ")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"if (dispatchFunc=2) { do SQLrtpcrtoref.Query(funcFD) } elseif (dispatchFunc=1) { do SQLrtpcrtoref.%Open() }")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"return SQLrtpcrtoref")
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code)
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHsequencenumber,$increment(sequence))
	do GenerateRTPCHelperMethod(pClassName,method,.nRTP)
	RETURN $$$OK
}
.
GenerateRTPCHelperMethod(pStatementClass,currentMethodName,&nRTP) PUBLIC {
	quit:'$d(nRTP("dispatch-code","helper"))
	set methodName=""
	for {
		set methodName=$O(nRTP("dispatch-code","helper",methodName),1,value) q:methodName=""
		set procedureBlock=$s($g(nRTP("dispatch-code","helper",methodName,"procedureBlock"))=0:0,1:1)
		kill nRTP("dispatch-code","helper",methodName,"procedureBlock")
		set methodCodeIdx="",code=0
		if (methodName["UDF"){
			// UDF needs to be put inside the current classmethod since UDF may need variables in this classmethod
			// For example %rtpcUDF() try {function(SQLrtpcv28)} catch{...}
			set code = $$$defMemberKeyGet(pStatementClass,$$$cCLASSmethod,currentMethodName,$$$cMETHimplementation)
		}
		for {
			set methodCodeIdx=$O(nRTP("dispatch-code","helper",methodName,methodCodeIdx),1,methodCode) q:methodCodeIdx=""
			if (methodCodeIdx = 1)&&(methodName["Helper") {
				$$$defMemberKeySet(pStatementClass,$$$cCLASSmethod,methodName,$$$cMETHformalspec,$e(methodCode,2,*-1))
				$$$defMemberKeySet(pStatementClass,$$$cCLASSmethod,methodName,$$$cMETHprocedureblock,procedureBlock)
			} else {
				$$$defMemberArraySet(pStatementClass,$$$cCLASSmethod,$s((methodName["Helper"):methodName,1:currentMethodName),$$$cMETHimplementation,$i(code),methodCode)
			}
		}
		if code {
			$$$defMemberKeySet(pStatementClass,$$$cCLASSmethod,$s((methodName["Helper"):methodName,1:currentMethodName),$$$cMETHimplementation,code)
		}
	}
	quit
}
.
	// Called from Compile
AddUniqueClass(pClassName,pForce=0,pDescription="Cached statement created with server version:") [] PRIVATE {
		#; This function create a class with a guaranteed unique name. First, the class name index is checked to see if a class by the same name
		#; already exists. A lock taken out prior to this check remains in place after the check so that no concurrency hole is
		#; opened. If the check fails then the ID portion of the name is mangled by inserting a mangle string at the end of the significant portion
		#; of the class name (class names must be unique in the first 25 positions) until a unique name is found. The mangle string starts with 'A'.
		#; This value is 'incremented' by adding one to the character ascii value, up to 'Z'. 'A'+1='B', 'B'+1='C', etc. 'Z'+1='AA' and so on.
		#; This process will continue until the mangle string exceeds the significant length of the classname (currently 25 characters).
		#; Three character mangle strings have > 18,000 combinations so it is unlikely we will ever fail to generate a unique class name.
		#; 
		#; Pass clsNew by reference to return the mangled class name.
	set sc=$$CreateClass(pClassName,pDescription,pForce)
		#; If an error occurs we assume it is because a class of this name already exists
	if $$$ISERR(sc) {
		set tShortClass = $$$ClassShortName(pClassName)
		set tNewPackage = $$$ClassPackageName(pClassName)
		set tMangle="A"
		while tMangle'="" {
			set pClassName=tNewPackage_"."_$e(tShortClass,1,25-$l(tMangle))_tMangle
			set sc=$$CreateClass(pClassName,pDescription,pForce)
			if $$$ISOK(sc) { quit }
				#; I'm using an alphabetic addition algorithm to produce the mangled name which means we can have a
				#; twentyfive digit base 26 number of possible unique values.
				#; If a class name conflict occurs (won't happen in our lifetime) then use the ClassAlreadyExist error.
			else { set tMangle=$$increment(tMangle) if $l(tMangle)>25 { set tMangle="", sc=$$$ERROR($$$ClassAlreadyExist,pClassName) } }
		}
	}
	RETURN sc
}
 
	#; Add one to a string where ""+1="A", "A"+1="B", "Z"+1="AA"
increment(pNum) {
	set tLen=$l(pNum)
	if tLen {
		set tDigit=$a($e(pNum,tLen))+1
			#; Check for add with carry...
		if tDigit'>90 { set $e(pNum,tLen) = $c(tDigit) }
			#; Carry the digit by incrementing the previous digit and changing this one to "A"
		else { set pNum=$$increment($e(pNum,1,tLen-1))_"A" }
	}
		#; The first number is "A"
	else { set pNum="A" }
	Quit pNum
} 
 
	// Create a new cached statement class
	// Called from %SYS.SQLRTUMAKER,buildEmbeddedDirect, and AddUniqueClass
CreateClass(pClassName="",pDescPrefix="Cached query created with server version:",delete=0) [] public { // Used by %SYS.SQLRTUMAKER
	QUIT:pClassName="" $$$ERROR($$$ClassNameRequired)
	set pClassName=$$$NormalizeClassname(pClassName)
	set sc=$$IsClassnameValid^%occName("",pClassName) QUIT:$$$ISERR(sc) sc
	set sc = $$LockOneClass^%occLock(pClassName,0,1,2) QUIT:$$$ISERR(sc) sc
	if $$$IsClassDefined(pClassName) {
		if delete {
			set sc=$$Delete^%apiOBJ(pClassName,"-d",,1)
		}
		if $$$IsClassDefined(pClassName) set rc=$$$ERROR($$$ClassAlreadyExist,pClassName),sc=$$$ADDSC(sc,rc)
	}
	if $$$ISOK(sc) {
		set sc=$$IsClassnameConflict^%occName(pClassName)
		if $$$ISOK(sc) {
			$$$AddAllRoleTemporary ; verified 9/26/16 STC
			$$$defClassKeySet(pClassName,$$$cCLASSname,pClassName)
			$$$defClassKeySet(pClassName,$$$cCLASStimecreated,$zutil(188))
			$$$defClassKeySet(pClassName,$$$cCLASSdescription,pDescPrefix_$$$NL_$c(9)_$zv_$$$NL_"Create timestamp:"_$$$NL_$c(9)_$zdatetime($zu(188),3,1,3))
			$$$defClassVersionSet(pClassName,$$$CLASSDEFINITIONVERSION)
		}
	}
	if $$$ISERR(sc) set rc=$$UnlockOneClass^%occLock(pClassName,0,1)
	QUIT sc
}
.
	#;----------------------------------------
UpdateMethods(pClassName,sql,user,GenAGK=0,agkmd="",fastInsert) ; generate a class for all NON-SELECT statements
	set $zt="upderr",$ze=""
	new %qdata,%qi,%qinclist2,%qj,%qln,%qsize,insertClassname,tVersionTS,sc,sc2
	set %qln=0,%qsize=0
	
	if $g(importPackages)'="" { $$$defClassKeySet(pClassName,$$$cCLASSimport,importPackages) }
	$$$defClassKeySet(pClassName,$$$cCLASSfinal,1)
	$$$defClassKeySet(pClassName,$$$cCLASSgeneratedby,"%SYS.SQLSRV.MAC")
	$$$defClassKeySet(pClassName,$$$cCLASSclasstype,$$$cCLASSCLASSTYPESYSTEM)
 
		#;  Here we get a list of include files from the class and include them at the
		#;  beginning of the Cached Query class  These are needed if the user uses
		#;  macro references defined in these files in OdbcToLogical, StorageToLogical,
		#;  Computed field code, etc.
	set %qi=""
	for  {
		set %qi=$o(%qinfo("table",%qi),1,%qdata) quit:%qi=""
		set %qdata=$p(%qdata,$c(1),4)	// %qdata is now the extentname
		if fastInsert { set insertClassname=%qdata }	// remember name of the class of the table we are inserting into
		if %qdata'="" {
			set %qj=""
			for  {
				set %qj=$$$comClassArrayNext(%qdata,$$$cCLASSincludecodeall,%qj) quit:%qj=""  
				set:%qj'="%occSqlfunc" %qinclist2(%qj)=""
			}
		}
	}
		#; Add include files from datatypes of select list items that use non-% datatype classes
	set %qi=""
	for  {
		set %qi=$o(mtc(0,0,"select",%qi)) quit:%qi=""
		set %qdata=$g(mtc(0,0,"select",%qi,1))
		if %qdata'="" {
			set %qdata=$p(%qdata,$c(1),13)	// data is now the extentname
			set %qj=""
			for  {
				set %qj=$$$comClassArrayNext(%qdata,$$$cCLASSincludecodeall,%qj) quit:%qj=""
				set:%qj'="%occSqlfunc" %qinclist2(%qj)=""
			}
		}
	}
		#;  If a DDL statement that can contain ObjectScript code with macros, include %occInlcude so the common macros like $$$OK will compile OK. (DPV3026)
	set:$Case(stmttype,9:1,10:1,12:1,13:1,35:1,36:1,37:1,38:1,43:1,:0) %qinclist2("%occInclude")=""
	if $d(%qinclist2) {
		set %qdata=""
		set %qi="" for  set %qi=$o(%qinclist2(%qi)) quit:%qi=""  set %qdata=%qdata_","_%qi
		if %qdata'="" $$$defClassKeySet(pClassName,$$$cCLASSincludecode,$e(%qdata,2,*))
	}
 
	set sc=$$GenerateOnNew(pClassName) //if $$$ISERR(sc) { throw ##class(%Exception.StatusException).CreateFromStatus(sc) }	///***
	do GenerateQACNProperty(pClassName)
	if fastInsert {	set sc=$$GenerateFastInsert(pClassName,.sql,GenAGK,agkmd,insertClassname) }
	set sc=$$GenerateExecute(pClassName,.sql,GenAGK,agkmd,stmttype,fastInsert)
.
	set tVersionTS=$zu(188)
	$$$defClassKeySet(pClassName,$$$cCLASStimechanged,tVersionTS)
	do RebuildItemIndex^%R(pClassName,"CLS")
		#; This should never fail!
	set sc2=$$UnlockOneClass^%occLock(pClassName,3,1)	// We locked the class in CreateClass
	QUIT 0
upderr	set $ztrap=""
	set %msg=$$$FormatText($$$Text("Error generating update methods: %1","%SQL.Server"),$zerror)
	set sc2=$$UnlockOneClass^%occLock(pClassName,3,1)	// We locked the class in CreateClass
	QUIT 400
.
GenerateExecute(pClassName,pSQL,pGenAGK,pAgkmd,stmttype,fastInsert) [mtc] PUBLIC {
.
	set method="Execute"
	set code=0
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHprocedureblock,0)
	set code=0
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,"#SQLCOMPILE SELECT="_$case($g(%SQLCompileMode,1),1:"ODBC",:"RUNTIME"))
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,"#EXECUTE s %msqlvar=""i%%""")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,"#SQLCOMPILE path=DEFAULT_SCHEMA")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"new firstMsg,firstSQLCODE kill %qerror set %qparsets=$zobjexport(12)"_$s(fastInsert:",%qerror=0,%qerrorcnt=0",1:""))	// %qerror and %qerrorcnt will be killed in srvPU after logging
	if stmttype=2 {  // if INSERT
		if %protocol>=67 {
				$$$defMemberKeySet(pClassName,$$$cCLASSparameter,"BATCHERRORFEATURE",$$$cPARAMdefault,1)
		}
		set tab=$o(%qinfo("table",""),1,data)
		if $p(data,$c(1),10)'="",$$$SSRebalancingInProgress {  // If shardmaster table name is defined, and shard cluster rebalancing is in progress
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,"#include %BigData.ShardingManager")
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"if $$$SSPreventIUDDuringRebalancing { set SQLCODE=-400,%msg=""Operation not permitted while rebalancing is in progress."" RETURN SQLCODE }")
  		}
	}
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"new:%0IRISServer.Auditing pAudit,sAudit")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"set %qpars=$zobjexport(12)")
	if stmttype=2,$g(mtc(0,0,"columnar-insert")) {
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"new %bufferedColumns set %bufferedColumns=(%qparsets>1)")	// Turn on buffered columnar filing if batched insert
	}
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"for %qi=1:1:%qparsets {")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"for %qj=1:1:%qpars { set %qpar(%qj)=$zobjexport(12) } ")
.
	if pSQL=1 {
				#;  Split each $c(10) segment into a different line
			if $l(pSQL(1),$c(10))=1 { 
				set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"&sql"_$$$CQSQLMarker_"("_pSQL(1))
				set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_")"_$$$CQSQLMarkerR)
			}
			else { 
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"&sql"_$$$CQSQLMarker_"("_$tr($p(pSQL(1),$c(10)),$c(13)))
					for %qi=2:1:$l(pSQL(1),$c(10))-1 {
				set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_$tr($p(pSQL(1),$c(10),%qi),$c(13)))
					}
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_$tr($p(pSQL(1),$c(10),%qi+1),$c(13)))
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_")"_$$$CQSQLMarkerR)
			}
	} else  { 
			#;  Assume that if there are mulitple lines we don't have $c(13,10) embedded in the lines.
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"&sql"_$$$CQSQLMarker_"("_pSQL(1))
		for %qi=2:1:pSQL-1 {
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_pSQL(%qi))
		}
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_pSQL(pSQL))
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_")"_$$$CQSQLMarkerR)
	}
	if fastInsert {
			// The only time the Execute method would be called for a fastInsert batch (%qparsets>1) would be for a batch insert which encountered a 404 condition.
			// For this case, we will report the errors for the batchInsert using the new-style fastInsert/basthInsert error format.
			// For fastInsert batchInsert result reporting, we will return the following:
			//    $lb() list:
			//  - # of errors (hopefully 0)
			//  - SQLCODE (if error)
			//  - %msg (error message text) if error
			//  - Row number (if error)
			//  - Row number 2 (if two or more errors)
			//        ...
			//    Row number N (if there are N errors
			// If there are more than ~740,000 statements that error, we cannot report them all because %qerror string will be too long.  Just report what we can.
		if $d(mtc(0,0,"option","SQLLoadDataID"),SQLLoadDataID) {
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"if SQLCODE<0 {")
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"do ##class(%SQL.Diag.Result).addDiagMessage("_SQLLoadDataID_",""server"",SQLCODE,$g(%msg),3)")
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"if %qparsets>1 {")
			if %protocol>=67 {	// New error reporting for INSERT batch
				set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9,9)_"set %qerror($i(%qerror))=$lb(%qi,-SQLCODE,""<""_$$sqlcode^%apiSQL(SQLCODE)_""> <""_%msg_"">""),%msg=""""")
			} else {
				set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9,9)_"if '%qerrorcnt { set %qerror=$lb(-SQLCODE,%msg,%qi),%qerrorcnt=1 } else { if $l(%qerror)'>("_$$$MaxLocalLength_"-1000) { set %qerror=%qerror_$lb(%qi),%qerrorcnt=%qerrorcnt+1 } else { new msg set msg=$lg(%qerror,2) if msg'[""- MAXIMUM NUMBER"" { set $li(%qerror,2)=msg_"" - MAXIMUM NUMBER OF ERRORS RECORDED"" }}}")
			}
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"}")
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"}")
		} else {
			if %protocol>=67 {	// New error reporting for INSERT batch
				set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"if %qparsets>1,SQLCODE<0 { set %qerror($i(%qerror))=$lb(%qi,-SQLCODE,""<""_$$sqlcode^%apiSQL(SQLCODE)_""> <""_%msg_"">""),%msg="""" }")
			} else {
				set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"if %qparsets>1,SQLCODE<0 { if '%qerrorcnt { set %qerror=$lb(-SQLCODE,%msg,%qi),%qerrorcnt=1 } else { if $l(%qerror)'>("_$$$MaxLocalLength_"-1000) { set %qerror=%qerror_$lb(%qi),%qerrorcnt=%qerrorcnt+1 } else { new msg set msg=$lg(%qerror,2) if msg'[""- MAXIMUM NUMBER"" { set $li(%qerror,2)=msg_"" - MAXIMUM NUMBER OF ERRORS RECORDED"" }}} }")
			}
		}
	} else {  // not fastInsert
		if $d(mtc(0,0,"option","SQLLoadDataID"),SQLLoadDataID) {
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"if SQLCODE<0 { do ##class(%SQL.Diag.Result).addDiagMessage("_SQLLoadDataID_",""server"",SQLCODE,$g(%msg),3) }")
		}
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"if %qparsets>1 {")
		if stmttype=2,%protocol>=67,$g(%qinfo("insertin2linked"))="" {	// New error reporting for INSERT batch (not for insert inot a linked table!)
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"if SQLCODE<0 { set %qerror($i(%qerror))=$lb(%qi,-SQLCODE,""<""_$$sqlcode^%apiSQL(SQLCODE)_""> <""_%msg_"">"") set:'$d(firstSQLCODE) firstSQLCODE=-SQLCODE,firstMsg=%msg set %msg="""" }")
		} else {
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"set %qy(%qi)=$s(SQLCODE'<0:%ROWCOUNT,1:-3) set:(SQLCODE<0)&&('$d(firstSQLCODE)) firstSQLCODE=SQLCODE,firstMsg=%msg")
		}
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"}")
	}
.
	if pGenAGK=0 {	// No auto-generated keys for this table
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"set:('SQLCODE&&($d(%qsc(%qacn,17))#2)&&(%qsc(%qacn,17)'=0)) %qsc(%qacn,17)=0") 	// DPV2708=
	} else {	// Potentially need to return auto generated keys
		set:pAgkmd="" pAgkmd=""""""
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"if 'SQLCODE,$d(%qsc(%qacn,17))#2,%qsc(%qacn,17)'=0 { if %qsc(%qacn,17)=-1||(%qsc(%qacn,17)="_$li(pGenAGK)_")||(%qsc(%qacn,17)="_$$quoter($li(pGenAGK,2))_") { set %qsc(%qacn,17,$i(%qsc(%qacn,17,0)))=%ROWID,%qsc(%qacn,17,-1)="_pAgkmd_" } else { set %qsc(%qacn,17)=0 }}")
	}
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"}	// %qparsets loop") 
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"set x=$zobjexport(+%qmsgid,1),x=$zobjexport(+$g(%qebqacn,%qacn),2)")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"if %0IRISServer.Logging {")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"do ##class(%SYS.DBSRV).logappend(""%qparsets: ""_%qparsets)")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"do ##class(%SYS.DBSRV).logappend(""Write Header:  %qmsgid ""_+%qmsgid_"",  %qacn: ""_+$g(%qebqacn,%qacn))")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"}")
.
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"if %qparsets=1 { set %qx=$zobjexport(%ROWCOUNT,3) RETURN SQLCODE }")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"else {")
	if stmttype=2,$g(mtc(0,0,"columnar-insert")) {
		set tab=$o(mtc(0,0,"table",""),1,classname),classname=$p(classname,$c(1),5)
		if mtc(0,0,"columnar-insert")=2 { // %NOJOURN, turn journalling off
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"set jflag=##class(%SYS.ProcessQuery).DisableJournalInt() $$$SuspendAllTrans(tflag)")
		}
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"set sc=##class("_$$$QN(classname)_").%SQLInsertBufferedColumns(.%bufferedColumns) if 'sc { for %qi=2:1:%qparsets { if $g(%qy(%qi))'=-3 { set %qy(%qi)=-3 }} set firstSQLCODE=-400 set:$ze[""<MAXSTRING>"" %msg=%msg_"" Probably attempting to store too much data in the columnar column"",firstMsg=%msg }")
		if mtc(0,0,"columnar-insert")=2 { // %NOJOURN, turn journally on
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"try { if jflag { do ##class(%SYS.ProcessQuery).EnableJournalInt() kill jflag } } catch { do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) }")
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"try { if $d(tflag) { $$$ResumeAllTrans(tflag) kill tflag } } catch { do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) }")
		}
	}
	if stmttype=2,%protocol>=67,$g(%qinfo("insertin2linked"))="" {	// New batch error reporting for INSERT batch
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"if '$g(%qerror) { set %qx=$zobjexport(0,18) }")	// No errors, write $lb(0) on the wire
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"else { set %qx=$zobjexport(%qerror,18) for %qx=1:1:%qerror { set %qy=$zobjexport(%qerror(%qx),18) }}") // write the errors
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"RETURN 0") // Return 0 here (no error) for batch case, any failures will be in the error list in PU's return.
	} else {
		if fastInsert {
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"if %qparsets=1 { set %qx=$zobjexport(%ROWCOUNT,3) RETURN SQLCODE }")
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"set %qx=$zobjexport(%qerrorcnt,18) set:%qerrorcnt %qx=$zobjexport(%qerror,5)")
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"RETURN 0") // Return 0 here (no error) for batch case, any failures will be in the error list.
		} else {
			set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"for j=1:1:%qparsets { set %qx=$zobjexport(%qy(j),18) }")
		}
	}
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"}")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"if $d(firstSQLCODE) { set SQLCODE=firstSQLCODE,%msg=firstMsg }")
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"RETURN SQLCODE")
.
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code)
	RETURN $$$OK
}
.
.
GenerateFastInsert(pClassName,pSQL,pGenAGK,pAgkmd,insertClassname) [mtc] PUBLIC {
.
#define NOCHECK '$lg($g(%qinfo("fastInsertSettings")),1)
#define NOLOCK '$lg($g(%qinfo("fastInsertSettings")),2)
#define NOINDEX '$lg($g(%qinfo("fastInsertSettings")),3)
#define KEYSLOTS $lg($g(%qinfo("fastInsertSettings")),4)
#define NUMNODES $lg($g(%qinfo("fastInsertSettings")),5)
#define NOJOURN $lg($g(%qinfo("fastInsertSettings")),11)
#define FASTCOLUMNARINSERT $lg($g(%qinfo("fastInsertSettings")),12)
.
	$$$defMemberKeySet(pClassName,$$$cCLASSparameter,"FASTINSERT",$$$cPARAMdefault,1)
	
	set method="FastInsert"
	set code=0
	$$$defMemberKeySet(pClassName,$$$cCLASSmethod,method,$$$cMETHprocedureblock,0)
	
	do filer^%ocsCacheSQLFiler(insertClassname,.sc,0,.ficode,1,.newlist,.setlist,.getold,$g(%qinfo("fastInsertSettings")),.ficompcode,.precode,.postcode,.generateFKeyUnlocks)
	
	set code=0
	set setlist=setlist_$e(",",setlist'="")_"%qerror=0,%qerrorcnt=0"
	if getold { set newlist("%qrowvalue")="" }
	if $$$NOLOCK { set newlist("locking")="",newlist("%ls")="",newlist("pAudit")="",newlist("sAudit")="",newlist("msg")="",setlist=setlist_$e(",",setlist'="")_"locking=1" }   // %NOLOCK NOT specified
	set ptr="" 
	for {
		set ptr=$o(newlist(ptr)) quit:ptr=""
		set newlist=newlist_","_ptr
	}
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"new "_$e(newlist,2,*))
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"set "_setlist)
	set tab=$o(%qinfo("table",""),1,data)
	if $p(data,$c(1),10)'="",$$$SSRebalancingInProgress {  // If shardmaster table name is defined, and shard cluster rebalancing is in progress
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,"#include %BigData.ShardingManager")
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"if $$$SSPreventIUDDuringRebalancing { set SQLCODE=-400,%msg=""Operation not permitted while rebalancing is in progress."" RETURN SQLCODE }")
 	}
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9)_"try {")
	if $$$NOJOURN {
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"if '($view(0,-1,4)\1024#2) { set %qJournalOff=##class(%SYS.ProcessQuery).DisableJournalInt() }")
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"$$$SuspendAllTrans(%qTransOff)")
	}
		#; %qpars will be the total number of reads to perform to get the data needed to field the row.
		#; This is the number of key fields plus the number of nodes.  I don't really use this information here because I know the number of key fields and number of nodes from the compiler
	set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"set %qpars=$zobjexport(12)")  // for fastInsert, %qparsets is set in srvPU
.
	set code=code+1
	$$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"//precode begin")
	for i=1:1:$g(precode) {
		set code=code+1
		$$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_precode(i))
	}
	set code=code+1
	$$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"//precode end")
.
	if $$$FASTCOLUMNARINSERT {
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"set %qi=0")
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"for %d1=minid:1:maxid {")
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9,9)_"set %qi=%qi+1")
	} else {
		set code=code+1 $$$defMemberArraySet(pClassName,$$$cCLASSmethod,method,$$$cMETHimplementation,code,$c(9,9)_"for %qi=1:1:%qparsets {")
	}
.
