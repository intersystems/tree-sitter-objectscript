			set SQLCODE=-99,%msg=$$$FormatText($$$Text("User '%1' is not privileged to change SQL LOCK_ESCALATION_THRESHOLD setting","%SYS.SQLSRV"),$username)
			do Audit99^%SYS.SQLSEC(%msg)
