%qaqpsq1^MAC^^^0
%qaqpsq1	// SQL parser overflow
	;; COMPONENTS :: SQL/Parser
	#;
#INCLUDE %occInclude
#INCLUDE %occODBC
#IF 0   ;-------------------------------------------------------------
	; Description:   SQL parser overflow
	; Author:        Aviel Klausner
	; Date Started:  September 09 1987
	;
	;  MRP1271 (10/23/2021) - [DP-409627] Enhance <explain> statement to support INTO <param> (Complex Variable) rather than INTO <host ref>
