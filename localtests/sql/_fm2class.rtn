====
fm2class
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%fm2class^MAC^^^0
%fm2class 	// VA FileMan -> InterSystems Class Mapper
 #;
#include %msql
#include %occConstant
#include %fm2class
 #;
#IF 0    ;
	#;---------------------------------------------------------------------
	#; Description:   New Fileman to Class Interface
	#; Author:        David Van De Griek
	#; Date:          July 2008
	#; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ] 
	#;
	#;  DPV3958 (12/05/2011) - Corect field MAXLEN issue (2.07)
	#;  DPV3957 (12/05/2011) - Implement $$$variablePointerValueField setting (2.06)
	#;                         Implement $$$expandPointers=3 setting
	#;  DPV3628 (05/05/2010) - Correct filing (insert) into Sub-File, allow FileMan to define IEN (1.21)
	#;  DPV3600 (03/18/2010) - Retain class enhancements (1.18)
	#;  DPV3579 (02/16/2010) - Define ability to have Required properties for required fields or required identifiers (1.17)
	#;                         Don't create fkeys for SOC tables added by v1.16
	#;                         Allow SC fields to be defined as String and not EnumString
	#;  DPV     (02/01/2010) - Allow SetOfCodes to be set up in a separate table and linked via a fkey (1.16)
	#;  DPV3432 (06/12/2009) - Correct index map subscripts (%fm2class version 1.12)
	#;  DPV3398 (04/23/2009) - Correct problem building classes with too many properties (1.11)
	#;  DPV3343 (01/15/2009) - Make %fm2class smaller (1.09)
	#;  DPV3317 (11/25/2008) - Use conditional index maps when $E({field},1,N) subscript expression is used (1.07)
	#;  DPV3305 (10/30/2008) - Enhancements to date/datetimedatatype mappings (1.06)
	#;                         Don't delete old classes if package changed
	#;  DPV3287 (10/08/2008) - Translate <FILENUMBER> "." to "_", not "d" (1.05)
	#;  DPV3235              - Implement new utility %fm2class
	#; --------------- Changes below were from %fm2cache ----------------------
	#;  DPV3217 (07/08/2008) - Improve performance of class creation (.815)
	#;                         Add FILEMANFILENAME and FILEMANFILENUMBER class parameters
	#;  DPV3159 (05/13/2008) - Correct <MAXSTRING> in trxtofname with field name containing X_ (.814)
	#;  DPV3126 (03/17/2008) - Default String field length is now 255.    (.813)
	#;                         Use %String for IEN fields.
	#;                         Define MINLEN on %String fields where appropriate
	#;                         Fix <UNDEFINED> error with fid in index2
	#;                         Perform one save of entire class instead of saving each class item
	#;                         Field names longer the 50 characters are now supported
	#;  DPV3084 (12/13/2007) - Use %EnumString datatype for multiple choice fields (.812)
	#;  DPV3069 (11/07/2007) - Add $$$retainClass parameter to not completely delete the class definition (.811)
	#;  DPV3068 (11/06/2007) - Generate index maps from new style cross references (.810)
	#;  DPV3017 (09/13/2007) - Generate Foreign Keys for PointerToFile fields
	#;  DPV3013 (09/10/2007) - Add ;PREV logic to Next code, move multpc to %fm2cache2
	#;  DPV3008 (08/27/2007) - Fix Variable Pointers
	#;  DPV2963 (06/19/2007) - Fix Delete of classes, use 60 for class name length
	#;  DPV2877 (03/09/2007) - Allow class Owner to be passed in, default is $Username
	#;  DPV2845 (01/23/2007) - Enhance ConvertFiles entry point
	#;  DPV2802 (11/29/2006) - Use ";" for VALUELIST/DISPLAYLIST separator instead of ","
	#;  DPV2801 (11/28/2006) - ConvertFiles entry point
	#;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	#;  DPV2449 (06/28/2005) - First checkin of utility
	#;---------------------------------------------------------------------
	#;                     I N F O R M A T I O N
	#;---------------------------------------------------------------------
	#;
	#; DOCUMENTATION
	#; initialize fileman preferences
	#; initialize name mapping variables
	#; $$$wpIsList = (Word-Proc as List collection (1) or child table (0) or both (2)
	#; %fmQueueCount = queue count - the number of tables queued for creation
	#;
	#; STRUCTURES:
	#;  TABLE Definition to create class for
	#;     ^IRIS.TempFM($j,filen)=$lb()
	#;		1. tabname
	#;		2. description
	#;		3. owner
	#;		4. 1/0 ReadOnly
	#;		5. <Y/N RowID Based on fields?>
	#;		6. "RowId"
	#;		7. <$lb physical based on fields>
	#;		8. <$lb logical based on fields>
	#;		9. <RowID Field name>
	#;		10. RowID Initial Expression
	#;		11. SqlRowIdPrivate 1/0 default is 0
	#;		12. IEN Field Name for the IEN field in this table
	#;
	#;	^IRIS.TempFM($j,filen,"f",fieldname)=$lb() Field Definition
	#;		1. FieldName
	#;		2. Description
	#;		3. Datatype
	#;		4. Required Flag
	#;		5. max length
	#;		6. Collation
	#;		7. SQL Computed Flag
	#;		8. Calculated Flag
	#;		9. SQL Compute Code
	#;		10. SQL Compute On Change
	#;		11. Relationship
	#;		12. Cardinality
	#;		13. Inverse
	#;		14. Property parameters
	#;		15. icol
	#;		16. Reference Flag
	#;		17. Default Value
	#;		18. Collection
	#;		19. RedOnly flag
	#;		20. FileMan Field Number
	#;		21. FileMan Field Name
	#;		22. Input Transform logic
	#;
	#;	^IRIS.TempFM($j,filen,"m",MAPNAME)=$lb(mapname,globalname,master map (Y/N))
	#;
	#;	^IRIS.TempFM($j,filen,"m",MAPNAME,"s",level)=$lb() // Map Subscripts
	#;		1. qualified field name if this subscript is a field
	#;		2. map subscript expression 
	#;		3. $lb() of lines of invalid conditions
	#;		4. $lb() of lines of NEXT code
	#;		5. AccessType (default is 'Sub')
	#;		6. delimiter for piece subscript
	#;	
	#;	^IRIS.TempFM($j,filen,"fk",<FKey name>)=$lb() // Foreign Key definitions
	#;		1. referenced table name
	#;		2. referenced field name
	#;		3. description
	#;		4. reference key name
	#;		5. Nocheck flag, default 0
	#;
	#;	^IRIS.TempFMI($j,"msgs","E",filen,i)	// Error messages for mapping this file
	#;	^IRIS.TempFMI($j,"msgs","W",filen,i)	// Warning messages for mapping this file
	#;	^IRIS.TempFMI($j,"fileman-update")
	#;	^IRIS.TempFMI($j,"fileman-update-field")
	#;	^IRIS.TempFMI($j,"fmtemp")
	#;	^IRIS.TempFMI($j,"rv",$$$UPPER(tabname))=filen
	#;	^IRIS.TempFMI($j,"fm",filen)=$lb(tabname,desc)
	#;	^IRIS.TempFMI($j,"desref",tabname,fldnm)=$lb(zfil,fktype,fldnm,%fmRecursionLevel)	// for dt=10, fktype=1 for Variable Pointer Reference, 2 for Pointer Reference
	#;	^IRIS.TempFMI($j,"fid",filensub,fid)=$lb(fldnm,desc,+$g(SQLComputed)+$g(Calculated),datype="8W",icol,ReadOnly,inputTransform)
	#;---------------------------------------------------------------------
#ENDIF   ;
	RETURN
.
	#;	MACROS DEFINED IN %fm2class.INC:
	#;
	#;  $$$childTableNameFormat	= Format of the child table name based on the file name and number
	#;	$$$ClassParameters		= Dynamic Object.  Key is class parameter name and value is parameter value.
	#; 							   For example:  {"%JSONENABLED":1,"%JSONREFERENCE":"OBJECT"}
	#;  $$$compile				= 1/0 1 means compile the classes, 0 means don't compile.
	#;  $$$compileQSpec			= Class compiler flags
	#;  $$$ComputedAlwaysJSONINCLUDE - Internal only, comes from $$$JSONAdaptor for Calculated/SqlComputed property parameter setting
	#;  $$$datetimeType			= IRIS Datatype to use for FileMan DATETIME fields
	#;  $$$dateType				= IRIS Datatype to use for FileMan DATE fields
	#;  $$$defineVASITE			= 1/0 flag.  1 means define a computed VASITE/VA_SITE property/field in each class.  Default is 0
	#;  $$$display				= 0/1/2 flag.  0 = No screen display, 1 = minimal screen display, 2 = full screen display
	#;  $$$executeInputTransform = 0/1 flag.  
	#;							  0 means do not execute a field's input transformation code
	#;							  1 means we do execute a field's input transformation code before calling the FileMan filer for INSERT/UPDATE
	#;							  This setting does not apply unless $$$readonly=0
	#;  $$$extendedMapping		= A string to be inserted into the global name in the map definitions for extended
	#;								mapping purposes.  For example, you might specify ["SD"] and your global will be 
	#;								mapped as ^["SD"]LR(...) instead of ^LR(...).  This can be any valid string that can be
	#;								used for extended global mapping, include the [...] or |...| brackets.
	#;  $$$expandPointers		= 1/0 flag.  1 means for each pointer field mapped we will also create a computed property
	#;								that expands the pointer field and is equal to the NAME (.01) field in the referenced file
	#;								0 means this field will not be created.
	#;  $$$expandSetOfCodes		= 1/0 flag.  1 means for field of type SET OF CODES the mapping utility will create a separate 
	#;								class/table that contains fields CODE and MEANING for the codes this field can be set to.
	#;								There is also a foreign key constraint defined in the table that references to SetOfCodes table for the field.
	#;								The SetOfCodes field is not defined as a reference, it is still defined as a EnumString.
	#;								0 means this SetOfCodes table will not be created.
	#;  $$$fieldNameFormat		= Format of the SQL Field name based on the file's field name (Exact,Upper,Lower,Pascal,Camel)
	#;  $$$fmQueueCount			= Queue Count, value passed by reference, the number of classes queued for creation.
	#;  $$$ienFieldName			= Name of the IEN field.  IEN is defualt.
	#;  $$$IENType				= The datatype of the IEN field
	#;	$$$JSONAdaptor			= Dynamic Object.  Should this class extent %JSON.Adaptor and parameter values for the class and properties:
	#; 							  { "%JSONENABLED":1,						// 1 is the default is not specified
	#; 								"%JSONIGNOREINVALIDFIELD":0				// 0 is the default is not specified
	#; 								"JSONNULL":0							// 0 is the default is not specified
	#; 								"%JSONIGNORENULL":0						// 0 is the default is not specified
	#; 								"%JSONREFERENCE":"OBJECT"				// "OBJECT" is the default is not specified, other options are "ID" ,"OID", and "GUID"
	#; 								"ComputedAlwaysJSONINCLUDE:"OUTPUTONLY"	// For Calculated/SqlComputed fields, %JSONINCLUDE property parameter value.  
	#; 																		//  "OUTPUTONLY" is the default.  Other options are "INOUT", "INPUTONLY", and "NONE"
	#; 							  }
	#;  $$$logFile				= Name of a file to log optput of the %fm2class utility
	#;  $$$mapMUMPSCrossReferences = 0/1/2 flag
	#;                               0 (default) means the MUMPS cross references will not be defined as index maps in the class.
	#;                               1 means that a MUMPS cross reference will be mapped as an index in the class if possible and as long as this is not an "A" cross reference.  
	#;                                 "A" cross references are defined for sorting, not fully supported for lookups.
	#;                                 The cross references SET code still needs to be in the form S ^...="" in order for the index map to be defined in the class.
	#;                               2 means that a MUMPS cross reference will be mapped as an index in the class if possible, including "A" cross references.  
	#;                                 The cross references SET code still needs to be in the form S ^...="" in order for the index map to be defined in the class.
	#;                            WARNING: Using options 1 or 2 might result in an index defined in the class/table 
	#;                                     that is for a partial index, which means it might not include all record in 
	#;                                     the table/file and queries potentially could produce wrong results.  
	#;                                     This setting should only be used on files you know the MUMPS cross references are full indexes.
	#;  $$$nameLength			= Maximum length of property, trigger, and foreign key names in the generated class definition.
	#;								The default is currently 180 characters.  The 180 character length was introduced with FM2Class 2.13.
	#;								Prior to 2.13 the name length was 31.  If you prefer the name length to remain 31, set nameLength to 31.
	#;								You may want the name length to remain 31 if you have application code that references the property names and do not want to have to update this code.
	#;  $$$owner				= Username to use as the owner of the classes created.  The default is $Username
	#;  $$$package				= Name of the package to create the classes in
	#;  $$$readonly				= 1/0 1 means generate readonly classes, 0 means generate read/write classes
	#;  $$$recursion"           = 0/1/2 flag, or "DEPTH=#"
	#;                            0 means no recursion will occur.  Only this file is converted, no Sub-Files or Pointers converted
	#;                            1 means partial recursion.  Only one level of Sub-File and Pointers will be converted.
	#;                            2 (default) means full recursion.  All Sub-Files and Pointers converted
	#;                            An exact depth can also be specified by using the string "DEPTH=#", for example, "DEPTH=2"
	#;                            Which means 2 levels of recursion for sub-files and pointers are mapped.
	#;                            Calling the all entrypoint implies %fm("recursion")=2
	#;  $$$retainClass			= 1/0 1 means that if the class already exists we will not recreate the entire class, just the properties, storage, indexes, foreign keys, etc.
	#;  $$$requiredType	= 1/0 flag.  1 means FileMan fields marked as required are defined as required properties (default)
	#;								0 means only FileMan fields defined as Required Identifiers are defined as required properties.
	#;  $$$setOfCodesEnum		= 1/0 flag.  1 means Set Of Codes type fields map to %Library.EnumString (default)
	#;								0 means they map to %Library.String
	#;								0 means we delete and recreate the class, SQL privileges and any add-ons to the class will be lost
	#;  $$$superClasses			= String with a comma list of super class(es) each mapped class should extend
	#;  $$$strictData			= If $$$dateType is %Library.FilemanDate, defines if the STRICTDATA type parameter is 0 (default) or 1.
	#;								If $$$dateType is %Library.FilemanTimeStamp, defines if the STRICTDATA type parameter is 0 (default) or 1.
	#;  $$$tableNameFormat		= Format of the table name based on the file name and number
	#;  $$$wholeFileScreen      = 1/0 0 means the mapped class storage will NOT filter results using the File's whole-file-screen (if defined)
	#;                                1 means the mapped class storage WILL filter results using the File's whole-file-screen (if defined).  
	#;                                  Rows will only be returned from the table when the whole-file-screen filter condition is TRUE
	#;  $$$wpIsList				= 1/0 0 means convert word-processing fields as child tables
	#;                                1 means convert word-processing fields as list collections
	#;                                2 means convert word-processing fields as both list collection and child tables
	#;                                3 means convert word-processing fields as a long-string computed varchar field
	#;								    When using the %fm("isWpList")=3 setting, the WP field is stored in memory within the IRIS property or field as a long string.  
	#;									Each line of text in the WP field is delimited by $c(13,10) in the in-memory value.  When writing the field back to FileMan 
	#;									(SQL INSERT, UPDATE, or Object %Save()), the value will be put back into the FileMan database global via the do WP^DIE(...) 
	#;									call and the wproot() array passed in will contain one line for each $c(13,10) delimited segment of the in-memory value.
	#;								  
 	
.
defineSettings() [] PUBLIC {
	Set ^%SYS("sql","fm2class","childTableNameFormat")="sub_<FILENAME>"
	Set ^%SYS("sql","fm2class","compile")=1
	Set ^%SYS("sql","fm2class","display")=1
	Set ^%SYS("sql","fm2class","compileQSpec")="/display=all/lock=0"
	Set ^%SYS("sql","fm2class","dateType")="%Library.FilemanDate"
	Set ^%SYS("sql","fm2class","datetimeType")="%Library.FilemanTimeStamp"
	Set ^%SYS("sql","fm2class","defineVASITE")=0
	Set ^%SYS("sql","fm2class","deleteQSpec")="/display=none"
	Set ^%SYS("sql","fm2class","executeInputTransforms")=0
	Set ^%SYS("sql","fm2class","expandPointers")=1
	Set ^%SYS("sql","fm2class","expandSetOfCodes")=0
	Set ^%SYS("sql","fm2class","extendedMapping")=""
	Set ^%SYS("sql","fm2class","fieldNameFormat")="Exact"
	Set ^%SYS("sql","fm2class","ienFieldName")="IEN"
	Set ^%SYS("sql","fm2class","mapMUMPSCrossReferences")=0
	Set ^%SYS("sql","fm2class","logFile")="C:\Temp\fm2class.log"
	Set ^%SYS("sql","fm2class","nameLength")=$$$MAXNAMELENGTH
	Set ^%SYS("sql","fm2class","owner")="_SYSTEM"
	Set ^%SYS("sql","fm2class","package")="FM"
	Set ^%SYS("sql","fm2class","readonly")=0
	Set ^%SYS("sql","fm2class","recursion")=2
	Set ^%SYS("sql","fm2class","requiredType")=1
	Set ^%SYS("sql","fm2class","retainClass")=1
	Set ^%SYS("sql","fm2class","setOfCodesEnum")=1
	Set ^%SYS("sql","fm2class","strictData")=0
	Set ^%SYS("sql","fm2class","superClasses")="%XML.Adaptor"
	Set ^%SYS("sql","fm2class","tableNameFormat")="<FILENAME>"
	Set ^%SYS("sql","fm2class","variablePointerValueField")=0
	Set ^%SYS("sql","fm2class","wholeFileScreen")=0
	Set ^%SYS("sql","fm2class","wpIsList")=0
	set ^%SYS("sql","fm2class","IENType")="%Library.String"
	set ^%SYS("sql","fm2class","JSONAdaptor")=""
	set ^%SYS("sql","fm2class","ClassParameters")=""
	RETURN
}
.
.
getSettings() [] PUBLIC {
	#; load the settings from ^%SYS("sql","fm2class",<setting>) into the %fm() array.
	#; %fm values passed in to the API always override what is defined in the configuration settings.
	
	if '$d($$$childTableNameFormat) s $$$childTableNameFormat=$g(^%SYS("sql","fm2class","childTableNameFormat"),"<FILENAME>")
	if '$d($$$compile) s $$$compile=$g(^%SYS("sql","fm2class","compile"),1)
	if '$d($$$compileQSpec) s $$$compileQSpec=$g(^%SYS("sql","fm2class","compileQSpec"),"/display=all/lock=0")
	if '$d($$$dateType) s $$$dateType=$g(^%SYS("sql","fm2class","dateType"),"%Library.FilemanDate")
	if '$d($$$datetimeType) s $$$datetimeType=$g(^%SYS("sql","fm2class","datetimeType"),"%Library.FilemanTimeStamp")
	if '$d($$$defineVASITE) s $$$defineVASITE=$g(^%SYS("sql","fm2class","defineVASITE"),0)
	if '$d($$$deleteQSpec) s $$$deleteQSpec=$g(^%SYS("sql","fm2class","deleteQSpec"),"/display=all")
	if '$d($$$display) s $$$display=$g(^%SYS("sql","fm2class","display"),2)
	if '$d($$$executeInputTransforms) set $$$executeInputTransforms=$g(^%SYS("sql","fm2class","executeInputTransforms"),0)
	if '$d($$$expandPointers) s $$$expandPointers=$g(^%SYS("sql","fm2class","expandPointers"),"")
	if '$d($$$expandSetOfCodes) s $$$expandSetOfCodes=$g(^%SYS("sql","fm2class","expandSetOfCodes"),"")
	if '$d($$$extendedMapping) s $$$extendedMapping=$g(^%SYS("sql","fm2class","extendedMapping"),"")
	if '$d($$$fieldNameFormat) s $$$fieldNameFormat=$g(^%SYS("sql","fm2class","fieldNameFormat"),"Exact")
	if '$d($$$ienFieldName) s $$$ienFieldName=$g(^%SYS("sql","fm2class","ienFieldName"),"IEN")
	if '$d($$$mapMUMPSCrossReferences) s $$$mapMUMPSCrossReferences=$g(^%SYS("sql","fm2class","mapMUMPSCrossReferences"),0)
	if '$d($$$logFile) s $$$logFile=$g(^%SYS("sql","fm2class","logFile"),"")
	if '$d($$$nameLength) s $$$nameLength=$g(^%SYS("sql","fm2class","nameLength"),$$$MAXNAMELENGTH) set:$$$nameLength="" $$$nameLength=$$$MAXNAMELENGTH
	if '$d($$$owner) s $$$owner=$g(^%SYS("sql","fm2class","owner"),$Username)
	if '$d($$$package) s $$$package=$g(^%SYS("sql","fm2class","package"),"User")
	if '$d($$$readonly) s $$$readonly=$g(^%SYS("sql","fm2class","readonly"),0)
	if '$d($$$recursion) s $$$recursion=$g(^%SYS("sql","fm2class","recursion"),2)
	if '$d($$$requiredType) s $$$requiredType=$g(^%SYS("sql","fm2class","requiredType"),1)
	if '$d($$$retainClass) s $$$retainClass=$g(^%SYS("sql","fm2class","retainClass"),1)
	if '$d($$$setOfCodesEnum) s $$$setOfCodesEnum=$g(^%SYS("sql","fm2class","setOfCodesEnum"),1)
	if '$d($$$strictData) s $$$strictData=$g(^%SYS("sql","fm2class","strictData"),0)
	if '$d($$$superClasses) s $$$superClasses=$g(^%SYS("sql","fm2class","superClasses"),"")
	if '$d($$$tableNameFormat) s $$$tableNameFormat=$g(^%SYS("sql","fm2class","tableNameFormat"),"<FILENAME>")
	if '$d($$$variablePointerValueField) s $$$variablePointerValueField=$g(^%SYS("sql","fm2class","variablePointerValueField"),0)
	if '$d($$$wholeFileScreen) s $$$wholeFileScreen=$g(^%SYS("sql","fm2class","wholeFileScreen"),0)
	if '$d($$$wpIsList) s $$$wpIsList=$g(^%SYS("sql","fm2class","wpIsList"),0)
	if $$$display<2,$$$compileQSpec'["display=none" s $$$compileQSpec=$$$compileQSpec_"/display=none"	// Only display compilation messages if $$$display=2
	if '$d($$$IENType) s $$$IENType=$g(^%SYS("sql","fm2class","IENType"),"%Library.String")
	if '$d($$$JSONAdaptor) set $$$JSONAdaptor=$g(^%SYS("sql","fm2class","JSONAdaptor"),"")
	if '$d($$$ClassParameters) set $$$ClassParameters=$g(^%SYS("sql","fm2class","ClassParameters"),"")
.
		#; Turn the class parmeters into a dynamic Object
	if '$isobject($$$ClassParameters) {
		if $$$ClassParameters="" { set ClassParameters={} }
		else { set ClassParameters=##class(%DynamicAbstractObject).%FromJSON($$$ClassParameters) }
	} else { set ClassParameters=$$$ClassParameters }
.
			#; If JSONAdaptor is defined, we are going to Extend from class %JSONAdaptor, possible define some class parameters, 
			#; and possible define a property parameter for all Calculated / SqlComputed fields.
	if $$$JSONAdaptor'="" {
		set JSONAdaptor=##class(%DynamicAbstractObject).%FromJSON($$$JSONAdaptor)
		set iter=JSONAdaptor.%GetIterator()
		while iter.%GetNext(.key,.val) {
			if $e(key,1,5)="%JSON",'ClassParameters.%IsDefined(key) { do ClassParameters.%Set(key,val) }	// Add the %JSON* class parameters
			elseif key="ComputedAlwaysJSONINCLUDE" { set $$$ComputedAlwaysJSONINCLUDE=val }
		}
		if (","_$$$superClasses_",")'[(",%JSON.Adaptor,") { set $$$superClasses=$$$superClasses_$e(",",$$$superClasses'="")_"%JSON.Adaptor" }
	}
	set $$$ClassParameters=ClassParameters
.
	RETURN	
}
.
.
loadSettings() [] PUBLIC {
	#; load the settings from ^%SYS("sql","fm2class",<setting>) into the %fm() array.
	#; This is called for the GUI API for the settings page
	
	set $$$childTableNameFormat=$g(^%SYS("sql","fm2class","childTableNameFormat"),"<FILENAME>")
	set $$$compile=$g(^%SYS("sql","fm2class","compile"),1)
	set $$$compileQSpec=$g(^%SYS("sql","fm2class","compileQSpec"),"/display=all/lock=0")
	set $$$dateType=$g(^%SYS("sql","fm2class","dateType"),"%Library.FilemanDate")
	set $$$datetimeType=$g(^%SYS("sql","fm2class","datetimeType"),"%Library.FilemanTimeStamp")
	set $$$defineVASITE=$g(^%SYS("sql","fm2class","defineVASITE"),0)
	set $$$deleteQSpec=$g(^%SYS("sql","fm2class","deleteQSpec"),"/display=all")
	set $$$display=$g(^%SYS("sql","fm2class","display"),2)
	set $$$executeInputTransforms=$g(^%SYS("sql","fm2class","executeInputTransforms"),0)
	set $$$expandPointers=$g(^%SYS("sql","fm2class","expandPointers"),0)
	set $$$expandSetOfCodes=$g(^%SYS("sql","fm2class","expandSetOfCodes"),0)
	set $$$extendedMapping=$g(^%SYS("sql","fm2class","extendedMapping"),"")
	set $$$fieldNameFormat=$g(^%SYS("sql","fm2class","fieldNameFormat"),"Exact")
	set $$$ienFieldName=$g(^%SYS("sql","fm2class","ienFieldName"),"IEN")
	set $$$logFile=$g(^%SYS("sql","fm2class","logFile"),"")
	set $$$mapMUMPSCrossReferences=$g(^%SYS("sql","fm2class","mapMUMPSCrossReferences"),0)
	set $$$nameLength=$g(^%SYS("sql","fm2class","nameLength"),$$$MAXNAMELENGTH) set:$$$nameLength="" $$$nameLength=$$$MAXNAMELENGTH
	set $$$owner=$g(^%SYS("sql","fm2class","owner"),$Username)
	set $$$package=$g(^%SYS("sql","fm2class","package"),"User")
	set $$$readonly=$g(^%SYS("sql","fm2class","readonly"),0)
	set $$$recursion=$g(^%SYS("sql","fm2class","recursion"),2)
	set $$$requiredType=$g(^%SYS("sql","fm2class","requiredType"),1)
	set $$$retainClass=$g(^%SYS("sql","fm2class","retainClass"),1)
	set $$$setOfCodesEnum=$g(^%SYS("sql","fm2class","setOfCodesEnum"),1)
	set $$$strictData=$g(^%SYS("sql","fm2class","strictData"),0)
	set $$$superClasses=$g(^%SYS("sql","fm2class","superClasses"),"")
	set $$$tableNameFormat=$g(^%SYS("sql","fm2class","tableNameFormat"),"<FILENAME>")
	set $$$variablePointerValueField=$g(^%SYS("sql","fm2class","variablePointerValueField"),0)
	set $$$wholeFileScreen=$g(^%SYS("sql","fm2class","wholeFileScreen"),0)
	set $$$wpIsList=$g(^%SYS("sql","fm2class","wpIsList"),0)
	set $$$IENType=$g(^%SYS("sql","fm2class","IENType"),"%Library.String")
	set $$$JSONAdaptor=$g(^%SYS("sql","fm2class","JSONAdaptor"),"")
	set $$$ClassParameters=$g(^%SYS("sql","fm2class","ClassParameters"),"")
	RETURN
}
.
.
output(str,lf=1,indent=0,screen) [] PUBLIC {
	if screen { f i=1:1:lf { w ! } w:indent ?indent w str }
	if %fmLog { use $$$logFile f i=1:1:lf { w ! } w:indent ?indent w str use 0 }
	QUIT
}
.
 
Compile(%fm) [] PUBLIC {
	do getSettings()
	s:$e($$$package,$l($$$package))'="." $$$package=$$$package_"."
	d Compile^%fm2class3($$$package,.%fm)
}
.
.
all(%fm,%fmQueueCount,caller="all^%fm2class") [classname,SOCClasses,SQLCODE] PUBLIC {
	#; CONVERT ALL FILES TO CLASSES
	#; User Entry Point - Parameters
	#;  1. %fm = Array of configuration settings, passed by reference
	#;     Entries in the array can be:
	#;       %fm("childTableNameFormat") = Format of the child table name based on the file name and number
	#;       %fm("ClassParameters")      = Dynamic Object.  Key is class parameter name and value is parameter value.
	#;                                     For example:  {"%JSONENABLED":1,"%JSONREFERENCE":"OBJECT"}
	#;       %fm("compile")              = 1/0 1 means compile the classes, 0 means don't compile.
	#;       %fm("compileQSpec")         = IRIS compiler flags
	#;       %fm("dateType")             = IRIS Datatype to use for FileMan DATE fields
	#;       %fm("datetimeType")         = IRIS Datatype to use for FileMan DATETIME fields
	#;       %mf("defineVASITE")         = 1/0 flag to determine if a SqlComputed VA_SITE field is added to the mapped class
	#;       %fm("display")              = 0/1/2 flag.  0 = No screen display, 1 = minimal screen display, 2 = full screen display
	#;		 %fm("executeInputTransform") = 0/1 flag.  
	#;									  0 means do not execute a field's input transformation code
	#;									  1 means we do execute a field's input transformation code before calling the FileMan filer for INSERT/UPDATE
	#;									  This setting does not apply unless $$$readonly=0
	#;       %fm("expandPointers")       = 3/2/1/0 flag.  
	#;                                     0 means this field will not be created.
	#;                                     1 means for each pointer field mapped we will also create a computed property
	#;                                       that expands the pointer field and is equal to the NAME (.01) field in the referenced file
	#;                                    2 Same as 1 but the names of the fields will be different.
	#;                                      Reference field will be named <Field>_ID.
	#;                                       Expanded field will be named <Field>.  This is a computed field equal to the .01 field of the referenced table
	#;                                    3 Same as 2 but the names of the fields will be different.
	#;                                      Reference field will be named <Field>_f<pointed-to-file-id#>ID.
	#;                                      Expanded field will still be named <Field>.  This is a computed field equal to the .01 field of the referenced table
	#;       %fm("expandSetOfCodes")     = 1/0 flag.  
	#;                                     1 means for field of type SET OF CODES the mapping utility will create a separate 
	#;                                       class/table that contains fields CODE and MEANING for the codes this field can be set to.
	#;                                       There is also a foreign key constraint defined in the table that references to SetOfCodes table for the field.
	#;                                       The SetOfCodes field is not defined as a reference, it is still defined as a EnumString.
	#;                                     0 means this SetOfCodes table will not be created.
	#;       %fm("extendedMapping")      = A string to be inserted into the global name in the map definitions for extended
	#;                                     mapping purposes.  For example, you might specify ["SD"] and your global will be 
	#;                                     mapped as ^["SD"]LR(...) instead of ^LR(...).  This can be any valid string that can be
	#;                                     used for extended global mapping, include the [...] or |...| brackets.
	#;       %fm("fieldNameFormat")      = Format of the SQL Field name based on the file's Field name (Exact, Upper, Lower, Pascal, Camel)
	#;       %fm("ienFieldName")         = Name of the IEN field.  IEN is defualt.
	#;       %fm("ienType")              = The datatype of the IEN field
	#;       %fm("JSONAdaptor")          = Dynamic Object.  Should this class extent %JSON.Adaptor and parameter values for the class and properties:
	#;                                     { "%JSONENABLED":1,              // 1 is the default is not specified
	#;                                       "%JSONIGNOREINVALIDFIELD":0    // 0 is the default is not specified
	#;                                       "JSONNULL":0                   // 0 is the default is not specified
	#;                                       "%JSONIGNORENULL":0            // 0 is the default is not specified
	#;                                       "%JSONREFERENCE":"OBJECT"      // "OBJECT" is the default is not specified, other options are "ID" ,"OID", and "GUID"
	#;                                       "ComputedAlwaysJSONINCLUDE:"OUTPUTONLY"   // For Calculated/SqlCOmputed fields, %JSONINCLUDE property parameter value.  
	#;                                                                                 //  "OUTPUTONLY" is the default.  Other options are "INOUT", "INPUTONLY", and "NONE"
	#;                                     }
	#;       %fm("logFile")              = Name of a file to log optput of the %fm2class utility
	#;       %fm("mapMUMPSCrossReferences") = 0/1/2 flag
	#;                                    0 (default) means the MUMPS cross references will not be defined as index maps in the class.
	#;                                    1 means that a MUMPS cross reference will be mapped as an index in the class if possible and as long as this is not an "A" cross reference.  
	#;                                      "A" cross references are defined for sorting, not fully supported for lookups.
	#;                                      The cross references SET code still needs to be in the form S ^...="" in order for the index map to be defined in the class.
	#;                                    2 means that a MUMPS cross reference will be mapped as an index in the class if possible, including "A" cross references.  
	#;                                      The cross references SET code still needs to be in the form S ^...="" in order for the index map to be defined in the class.
	#;                                 WARNING: Using options 1 or 2 might result in an index defined in the class/table 
	#;                                          that is for a partial index, which means it might not include all record in 
	#;                                          the table/file and queries potentially could produce wrong results.  
	#;                                          This setting should only be used on files you know the MUMPS cross references are full indexes.
	#;       %fm("nameLength")           = Maximum length of property, trigger, and foreign key names in the generated class definition.
	#;                                     The default is currently 180 characters.  The 180 character length was introduced with FM2Class 2.13.
	#;                                     Prior to 2.13 the name length was 31.  If you prefer the name length to remain 31, set nameLength to 31.
	#;                                     You may want the name length to remain 31 if you have application code that references the property names and do not want to have to update this code.
	#;       %fm("owner")                = Username to use as the owner of the classes created.  The default is $Username
	#;       %fm("package")              = Name of the package to create the classes in
	#;       %fm("readonly")             = 1/0 1 means generate readonly classes, 0 means generate read/write classes
	#;       %fm("recursion")            = 0/1/2 flag, or "DEPTH=#"
	#;                                     0 means no recursion will occur.  Only this file is converted, 
	#;                                       no Sub-Files or Pointers converted
	#;                                     1 means partial recursion.  Only one level of Sub-File and Pointers will be converted.
	#;                                     2 (default) means full recursion.  All Sub-Files and Pointers converted
	#;                                     an exact depth can also be specified by using the string "DEPTH=#", for example, "DEPTH=2"
	#;                                     Which means 2 levels of recursion for sub-fiels and references are mapped.
	#;                                     Calling the all entrypoint implys      %fm("recursion=2
	#;       %fm("requiredType")         = 1/0 flag.  1 means FileMan fields marked as required are defined as required properties (default)
	#;                                     0 means only FileMan fields defined as Required Identifiers are defined as required properties.
	#;       %fm("retainClass")         = 1/0 1 means that if the IRIS class already exists we will not recreate the entire class, 
	#;                                          just the properties, storage, indexes, foreign keys, etc.
	#;                                         0 means we delete and recreate the class, SQL privileges and any add-ons to the 
	#;                                           class will be lost
	#;       %fm("setOfCodesEnum")       = 1/0 flag.  1 means Set Of Codes type fields map to %Librar.EnumString (default)
	#;                                     0 means they map to %Library.String
	#;      %fm("strictData")           = If $$$dateType is %Library.FilemanDate, defines if the STRICTDATA type parameter is 0 (default) or 1.
	#;                                    If $$$dateType is %Library.FilemanTimeStamp, defines if the STRICTDATA type parameter is 0 (default) or 1.
	#;      %fm("superClasses")         = String with a comma list of super class(es) each mapped class should extend
	#;      %fm("tableNameFormat")      = Format of the table name based on the file name and number
	#;      %fm("variablePointerValueField") = 0/1 flag:
	#;                                     0 means this field will not be created.
	#;                                     1 means for each variable pointer field mapped we will also create a computed property
	#;                                       that expands the variable pointer field value and is equal to the 01 field in the referenced file
	#;                                       This field will be named <Varible_Pointer_Field_VALUE>.
	#;                                       For exmaple:
	#;                                       An FM variable pointer field is configured to point to either the EMPLOYEE file or the PATIENT file. 
	#;                                       FM2class creates two fields that point to the EMPLOYEE file and another one that points to the PATIENT file. 
	#;                                       If this setting is 1, a third field is created that would return the .01 field of the EMPLOYEE record if the EMPLOYEE field has an IEN or 
	#;                                       the .01 field of the PATIENT record if the PATIENT field has an IEN
	#;       %fm("wholeFileScreen")       = 1/0 0 means the mapped class storage will NOT filter results using the File's whole-file-screen (if defined)
	#;                                         1 means the mapped class storage WILL filter results using the File's whole-file-screen (if defined).  
	#;                                           Rows will only be returned from the table when the whole-file-screen filter condition is TRUE
	#;       %fm("wpIsList")             = 3/2/1/0 0 means convert word-processing fields as child tables (default)
	#;                                     1 means convert word-processing fields as list collections
	#;                                     2 means convert word-processing fields as list collections and child tables
	#;                                     3 means convert word-processing fields as a long-string computed varchar field
	#;       ANY %fm() ENTRIES NOT DEFINED WHEN PASSED IN TO THE all ENTRYPOINT WILL BE LOADED FROM THE %fm2class CONFIGURATION
	#;       SETTINGS STORED IN ^%SYS("sql","fm2class",<settings>).  IF NOTHING IS PASSED IN TO THE %fm() PARAMETER, ALL CONFIG
	#;       SETTING WILL COME FROM ^%SYS("sql","fm2class,<settings>")
	#;
	#;  2. %fmQueueCount                 = Queue Count, value passed by reference, the number of classes queued for creation.
	#;  3. caller                        = Internal use.  Specifies how this API was called
		
	new %0CacheLock,classname,%fmLog,%fmLogOpen,%fmRecursionLevel,%ROWCOUNT,%ROWID,SOCClasses,SQLCODE 
	set %fmLog=0,%fmLogOpen="",%fmRecursionLevel=0
	do getSettings()
	s:$$$owner="" $$$owner=$Username
	s $$$recursion=2 	// all emtrypoint implies FULL Recursion
	if $$$logFile'="" {
		Open $$$logFile:"WNS":5  e  w !,"Unable to open for WRITE log file "_$$$logFile QUIT
		Set %fmLog=1,%fmLogOpen="all"
	}
	Do header^%fm2class2(caller)
	If '$$$retainClass {
		s zh2=$zh
		$$$output1("Deleting all Previously mapped classes...",2,0)
		s autoCommitMode=$zu(115,1,1)
		&sql(declare fm cursor for select classname, SOCClasses into :classname, :SOCClasses from %FileMan.MappedFilePackage)
		&sql(open fm)
		if SQLCODE<0 {
			$$$output2("ERROR opening %FileMan.MappedFile table",2,0)
			$$$output2("SQLCODE = "_SQLCODE_", %msg = "_$g(%msg),2,0) kill %msg
		} else {
		for  {
			&sql(fetch fm) q:SQLCODE=100
			if SQLCODE<0 {
				$$$output2("ERROR fetching row from %FileMan.MappedFile table",2,0)
				$$$output2("SQLCODE = "_SQLCODE_", %msg = "_$g(%msg),2,0) kill %msg
				quit
			}
			if $g(SOCClasses)'="" {
				for i=1:1:$ll(SOCClasses) {
					set SOCClass=$lg(SOCClasses,i)
					if $d(^oddDEF(SOCClass)) { 
						$$$output2("Deleting class "_SOCClass,1,2)
						Do Delete^%apiOBJ(SOCClass,$$$deleteQSpec,,1)					
						$$$output2("DONE",0,75)
					}
				}
			}
			if classname'="",$d(^oddDEF(classname)) { 
				$$$output2("Deleting class "_classname_"...",1,2)
				do Delete^%apiOBJ(classname,$$$deleteQSpec,,1)
				$$$output2("DONE",0,75)
			}
			&sql(delete from %FileMan.MappedFilePackage where current of fm)
		}
		&sql(close fm)
		}
		s t2=$zh-zh2 $$$output1("Previously mapped classes deleted in "_$s(t2>60:(t2\60)_" minutes ",1:"")_(t2#60)_" seconds.",1+($$$display=2),0)
		s autoCommitMode=$zu(115,1,autoCommitMode)
	}
	d QueueClasses("0:999999999",.%fm,,.%fmQueueCount)
	d MakeClasses(.%fm)
	if %fmLog,%fmLogOpen="all" close $$$logFile
	QUIT 1
}
.
 
ConvertFiles(fmlist,%fm,%fmFields,%fmQueueCount,caller="ConvertFiles^%fm2class") [] PUBLIC {
	#; CONVERT LIST OF FILES TO CLASSES
	#;  When ConvertFiles entry point is used, the entire package is not deleted, only the classes that are being converted.
	#; User Entry Point
	#;  1. fmfiles       = List of files to convert
	#;               Each item in the list must have the following syntax:
	#;               1. from fileman file #:to fileman file # | action
	#;               2. fileman file # | action
	#;               3. fileman file #^ fielman field # | action | action is an optional parameter it must have one of the following
	#;          values:
	#;               i - INSERT, u - UPDATE, d - DELETE
	#;          examples:  9.4:10         (No action specified - figure it out)
	#;                     9.4            (Determine if INSERTING or UPDATING file)
	#;                     9.4^2|i        (INSERT field 2 in FILE # 9.4)
	#;                     9.4^4|d,9.4^2  (Delete field 4 in FILE 9.4 and determine
	#;                                     if UPDATING or INSERTING field 2)
	#;
	#;          NOTE: When ranges are specified, we only deal with TOP level FILES
	#;                To map subfiles, the file number must be uniquely sepcified.
	#;  2. %fm           = Array of configuration settings, passed by reference - see all() API for full documentation
	#;  3. %fmFields     = Optional, PBR.  Array of fields to map.  If defined, only fields in this array and any required fields in the file are mapped.
	#;                     Structure of array is (%fmFields(File#,Field#)=""
	#;  4. %fmQueueCount = Queue Count, value passed by reference, the number of classes queued for creation.
	#;  5. caller        = Internal use.  Specifies how this API was called
	
	new %fmRecursionLevel set %fmRecursionLevel=0
	if $d(fmlist)>9 s item="" f  s item=$o(fmlist(item)) q:item=""  s fmlist=$g(fmlist)_$e(",",$g(fmlist)'="")_item
	do getSettings()
	if '$g(%fmLog) {
		new %fmLog set %fmLog=0
		if $$$logFile'="" {
			new %fmLogOpen
			open $$$logFile:"WNS":5  e  w !,"Unable to open for WRITE log file "_$$$logFile QUIT
			set %fmLog=1,%fmLogOpen="ConvertFiles"
		}
	}
	s:$$$owner="" $$$owner=$Username
	Do header^%fm2class2(caller,fmlist)
	d QueueClasses(fmlist,.%fm,.%fmFields,.%fmQueueCount)
	d MakeClasses(.%fm)
	if %fmLog,%fmLogOpen="ConvertFiles" close $$$logFile
	QUIT 1
}
 
QueueClasses(fmlist="0:999999999",%fm,%fmFields,%fmQueueCount) [] PUBLIC {
	#; User Entry Point
	#;  1. fmfiles		       = List of files to convert
	#;               Each item in the list must have the following syntax:
	#;               1. from fileman file #:to fileman file # | action
	#;               2. fileman file # | action
	#;               3. fileman file #^ fielman field # | action | action is an optional parameter it must have one of the following
	#;          values:
	#;               i - INSERT, u - UPDATE, d - DELETE
	#;          examples:  9.4:10         (No action specified - figure it out)
	#;                     9.4            (Determine if INSERTING or UPDATING file)
	#;                     9.4^2|i        (INSERT field 2 in FILE # 9.4)
	#;                     9.4^4|d,9.4^2  (Delete field 4 in FILE 9.4 and determine
	#;                                     if UPDATING or INSERTING field 2)
	#;
	#;          NOTE: When ranges are specified, we only deal with TOP level FILES
	#;                To map subfiles, the file number must be uniquely sepcified.
	#;  2. %fm           = Array of configuration settings, passed by reference - see all() API for full documentation
	#;  3. %fmFields     = Optional, PBR.  Array of fields to map.  If defined, only fields in this array and any required fields in the file are mapped.
	#;                     Structure of array is (%fmFields(File#,Field#)=""
	#;  4. %fmQueueCount = Queue Count, value passed by reference, the number of classes queued for creation.
 
	//d api(.4_":"_1,1,0)
	do getSettings()
	if '$g(%fmLog),$$$logFile'="" {
		new %fmLog,%fmLogOpen
		open $$$logFile:"WNS":5  e  w !,"Unable to open for WRITE log file "_$$$logFile QUIT
		set %fmLog=1,%fmLogOpen="QueueClasses"
	}
	$$$output1("Queuing FileMan files for creation of classes...",2,0) s zh=$zh
	s %fmQueueCount=0 s:$$$owner="" $$$owner=$Username
	k ^IRIS.TempFM($j),^IRIS.TempFMI($j),^IRIS.TempFMI($j,"msgs")
	s:$e($$$package,$l($$$package))'="." $$$package=$$$package_"."
	d api(fmlist)
	if $g(^IRIS.TempFMI($j,"msgs","E")) {
		$$$output2(^IRIS.TempFMI($j,"msgs","E")_" Errors reported during file analyzation:",2,0)
		s filen="" 
		f  { s filen=$o(^IRIS.TempFMI($j,"msgs","E",filen)) q:'filen  s i="" f  s i=$o(^IRIS.TempFMI($j,"msgs","E",filen,i),1,d) if 'i { $$$output2("",1,0) q  }  $$$output2(d,1,2) }
		
	}
	if $g(^IRIS.TempFMI($j,"msgs","W")) {
		$$$output2(^IRIS.TempFMI($j,"msgs","W")_" Warnings reported during file analyzation:",2,0)
		s filen="" 
		f  { s filen=$o(^IRIS.TempFMI($j,"msgs","W",filen)) q:'filen  s i="" f  s i=$o(^IRIS.TempFMI($j,"msgs","W",filen,i),1,d) if 'i { $$$output2("",1,0) q  }  $$$output2(d,1,2) }
		
	}
	k ^IRIS.TempFMI($j,"msgs")
	$$$output1(%fmQueueCount_" classes queued for creation in "_($zh-zh)_" seconds.",1,0)
	if %fmLog,%fmLogOpen="QueueClasses" close $$$logFile
	QUIT
}
.
 
MakeClasses(%fm,DeleteQueue=1) [] PUBLIC {
	#; User Entry Point
	#;  1. %fm           = Array of configuration settings, passed by reference - see all() API for full documentation
	#;  5. DeleteQueue   = 1/0 1 means delete classes queued for creation.  0 means retain them
.
	do getSettings()
	if '$g(%fmLog),$$$logFile'="" {
		open $$$logFile:"WNS":5  e  w !,"Unable to open for WRITE log file "_$$$logFile QUIT
		new %fmLog,%fmLogOpen Set %fmLog=1,%fmLogOpen="MakeClasses"
	}
	if $$$IENType'="%Library.String",'$$$defClassDefined($$$IENType) {
		$$$output1("Creating IEN datatype class """_$$$IENType_"""...",2,0)
		set sc=$$DefineUniqueIDType($$$IENType)
		if $$$ISERR(sc) { write !,"Unable to define class "_$$$IENType_":  "_$$GetErrorText^%apiOBJ(sc) RETURN }
	}
	$$$output1("Creating classes...",2,0) s zh=$zh
	s:$e($$$package,$l($$$package))'="." $$$package=$$$package_"."
	d MakeClasses^%fm2class3($$$compile)
	k:DeleteQueue ^IRIS.TempFM($j),^IRIS.TempFMI($j)
	s t2=$zh-zh $$$output1("Classes created "_$s($$$compile:"and compiled ",1:"")_"in "_$s(t2>60:(t2\60)_" minutes ",1:"")_(t2#60)_" seconds",2,0)
	if %fmLog,%fmLogOpen="MakeClasses" close $$$logFile
	QUIT
}
.
.
		#;  FileMan files into IRIS classes
api(fmlist) [] PUBLIC {
		#; list is a comma delimited list
		#; Each item in the list must have the following syntax:
		#;  1. from fileman file #:to fileman file # | action
		#;  2. fileman file # | action
		#;  3. fileman file #^ fielman field # | action
		#; | action is an optional parameter it must have one of the following
		#;          values:
		#;    i - INSERT, u - UPDATE, d - DELETE
		#; examples:  9.4:10         (No action specified - figure it out)
		#;            9.4            (Determine if INSERTING or UPDATING file)
		#;            9.4^2|i        (INSERT field 2 in FILE # 9.4)
		#;            9.4^4|d,9.4^2  (Delete field 4 in FILE 9.4 and determine
		#;                            if UPDATING or INSERTING field 2)
		#;
		#; NOTE: When ranges are specified, we only deal with TOP level FILES
		#;       To map subfiles, the file number must be uniquely sepcified.
		#; 
	q:$g(fmlist)=""
	k ^IRIS.TempFMI($j,"fileman-update"),^IRIS.TempFMI($j,"fileman-update-field")
	f i=1:1:$l(fmlist,",") {
		s x=$p(fmlist,",",i) 
		i x'="" {
			s y=x,action=$p(x,"|",2),x=$p(x,"|")
			i x[":" {	// do range
				s filen=+$p(x,":") s:filen'=0 filen=$o(^DIC(filen),-1)
				s x=$p(x,":",2) s:x="" x=$o(^DIC(" "),-1)
				for  {
					s filen=$o(^DIC(filen)) q:filen>x  q:filen'=+filen
					i $d(^DD(filen,0,"UP")) d log2("File #"_filen_", Skipping file because its DD is already used for a subfile","W",,,filen) continue
					i '$d(^DD(filen)) d log2("File #"_filen_", Skipping file because its ^DD entry does not exist","W",,,filen) continue
					d addmtemp(filen,action,y)
				}
			continue
			}
		}
		s filen=$p(x,"|"),fid=$p(filen,"^",2),filen=$p(filen,"^")
		i x'[":",'$d(^DIC(filen)) d log2("File #"_filen_", Skipping file because its ^DIC entry does not exist","W",,,filen) continue
		s syntax=$$syntax(filen,fid) continue:syntax=""  ; invalid
		d addmtemp(syntax,action,y)
	}
.
		#; init name map vars
	s flevl=1
	k ^IRIS.TempFMI($j,"fmtemp")
	s nextid="",anydata=0
userifct ; entry point to continue when userif bombs out
	f  s nextid=$o(^IRIS.TempFMI($j,"fileman-update",nextid),1,data) q:nextid=""  d  k ^IRIS.TempFMI($j,"fileman-update",nextid)
	. s (filen,topfil)=$p(data,$c(1)),anydata=1
	. s updatex=($p(data,$c(1),3)="Y")
	. s oper=$p(data,$c(1),2),$p(oper,",",4)=""
	. s oper=$p("insert^update^delete^ignore","^",$l($p(oper,"X"),","))
	. s data=$g(^(nextid,1)),fid=$$getFileName(filen)
	. s:fid="" fid=filen s ok=$e(oper,1,$l(oper)-1)
	. i $s(oper'="ignore":1,'updatex:1,1:0) s:$e(oper,$l(oper))'="e" ok=ok_$e(oper,$l(oper)) s ok=ok_"ing "
	. s ok=ok_"fileman File # "_fid_"  "_$$setext(data)
	. s:updatex ok=ok_" - Updating indices"
	. s fid="" i data'="" s ok=$l(data,"->") d
	. . s filen=$p(data,"->",ok),fid=$p(filen,"^",2),filen=$p(filen,"^")
	. . q:fid'=""  q:oper'="insert"  ; get previous file if inserting
	. . s filen=$p(data,"->",ok-1),fid=$p(filen,"^",2),filen=$p(filen,"^")
	. i "^insert^delete^"[("^"_oper_"^") s updatex=1
	. i oper="insert" d  q
	. . i fid["W" s fid=+fid
	. . s ok=$s(fid="":$$add(filen,topfil),1:$$addfield(topfil,filen,fid))
	. . d:'ok log("insert",nextid)
#IF 0
	. i oper="delete" d  q
		#; if deleting a Word-Processing Field redefine filen and fid
	. . i fid["W" s:$d(^IRIS.TempFMI($j,"fid",filen,+fid)) fid=+fid d:fid["W"
	. . . n y s y=+$p($g(^DD(filen,+fid,0)),"^",2),filen=y,fid=""
	. . s ok=$s(fid="":$$delete(filen),1:$$delfld(filen,fid))
	. . d:'ok log("delete",nextid)
	. i oper="update" d  q
	. . i fid["W" s ok=$$updsubf(filen,+fid,updatex,topfil,+$p($g(^DD(filen,+fid,0)),"^",2)) i 1
	. . e  s ok=$s(fid="":$$update(filen,updatex,topfil),1:$$updfld(filen,fid,updatex))
	. . d:'ok log("update",nextid)
	. i updatex,fid'["W" d  q
	. . s ok=$s(fid="":$$updatex(filen),1:$$updfldx(filen,fid))
	. . d:'ok log("update indices",nextid)
#ENDIF
	q:'anydata
		#; convert references
	d References^%fm2class2()
	k ^IRIS.TempFMI($j,"fmtemp")
	k ^IRIS.TempFMI($j,"fileman-update"),^IRIS.TempFMI($j,"fileman-update-field")
	QUIT
}
.
.
syntax(filen,fid) [] PUBLIC {
	s syntax="",fid=$g(fid)
	i fid'="",'$d(^DD(filen,fid)) QUIT syntax
	i fid="" i $p($g(^DD(filen,.01,0)),"^",2)["W" { s syntax="W" } Else { s syntax=filen } d syntaxup QUIT syntax
	s y=$p($g(^DD(filen,fid,0)),"^",2)
		#; deal with word-processing fields
	if y?.n.1"."1.n.e,$p($g(^DD(+y,.01,0)),"^",2)["W" { s y=$c(1)_"W"_$c(1) }
		#; multiple field
	if y?.1"."1.n.e { s syntax=filen_"^"_fid_"->"_(+y) }
	else  {	//  last level, not a multiple filed
		if fid=.01,y["W" { s syntax="W" }  		// Word Processing
		else { s syntax=filen_"^"_fid_$s(y=($c(1)_"W"_$c(1)):"W",1:"") }
	}
	d syntaxup
	QUIT syntax
 
syntaxup ;
	for  {
		s up=$g(^DD(filen,0,"UP")) q:up=""
		s fid=$o(^DD(up,"SB",filen,"")) i fid="" s syntax="" continue
		s filen=up,syntax=filen_"^"_fid_$s(syntax'="W":"->",1:"")_syntax
		q:syntax=""
	}
	QUIT
}
.
.
addfield(topfil,filen,fid) ; e.p. to link one fileman field to IRIS
	q  n SQLCODE,anydata,compil,err,flevl,nextid,nocon,ok
	d basic QUIT:'ok 0
	s irn=2 d onefield^%qadlfls i err!SQLCODE QUIT 0
	i +$g(nocon) QUIT 0 ; Field Not Converted
	d doit^%qadlnx i err!SQLCODE QUIT 0
	d addlist(filen)
	QUIT 1
 
 
addmtemp(syntax,action,parameter) [] PUBLIC {
		#; add filen and syntax to ^mtemp1($j global
	s action=$$validact^%fm2class2(syntax,action)
	i action="error" d log2("Invalid parameter '"_parameter_"' using mapping API '"_syntax_"|"_action_"'","E") QUIT
	s data(2)=$p(syntax,"^")
	s:syntax=+syntax syntax=""
	s data(3)=syntax
	set:action="i" data(4)="X"
	set:action="u" data(5)="X",data(7)="Y"
	set:action="d" data(6)="X"
	s data(1)=$i(^IRIS.TempFMI($j,"fileman-update"))
	s ^IRIS.TempFMI($j,"fileman-update",data(1))=data(2)_$c(1)_$g(data(4))_","_$g(data(5))_","_$g(data(6))_$c(1)_$g(data(7))
	s:$g(data(3))'="" ^IRIS.TempFMI($j,"fileman-update",data(1),1)=data(3)
	QUIT
}
 
 
getFileName(filen) [] PUBLIC {
		#;extrinsic function to return the fileman table name (From %qadltb)
	QUIT:'$d(^DD(filen)) ""
	s up=$g(^DD(filen,0,"UP")) i $g(up) s fid=$o(^DD(up,"SB",filen,""))
	i $g(fid) s btabnm=$p($g(^DD(up,fid,0)),"^")
	e  s btabnm=$p($g(^DIC(filen,0)),"^")
	s:btabnm="" btabnm="fmtab"
	QUIT btabnm
}
 
 
getTableName(fileName,filen,child=0,parfil,parentFileName) [] PRIVATE {
		#; return a unique table name
	if 'child { s key=$$$tableNameFormat } else { s key=$$$childTableNameFormat }
	set:key["<FILENAME>" key=$$strrep(key,"<FILENAME>",fileName)
	set:key["<PASCALFILENAME>" key=$$strrep(key,"<PASCALFILENAME>",$$pascal(fileName))
	set:key["<CAMELFILENAME>" key=$$strrep(key,"<CAMELFILENAME>",$$pascal(fileName,1))
	set:key["<FILENUMBER>" key=$$strrep(key,"<FILENUMBER>",$tr(filen,".","_"))
	if child {
		set:key["<PARFILENAME>" key=$$strrep(key,"<PARFILENAME>",parentFileName)
		set:key["<CAMELPARFILENAME>" key=$$strrep(key,"<CAMELPARFILENAME>",$$pascal(parentFileName,1))
		set:key["<PASCALPARFILENAME>" key=$$strrep(key,"<PASCALPARFILENAME>",$$pascal(parentFileName))
		set:key["<PARFILENUMBER>" key=$$strrep(key,"<PARFILENUMBER>",$tr(parfil,".","_"))
	}
	s key=$tr(key,".","_")
	s key=$$keycomp^%fm2class2(key,128) i key="" s key="fmtab"_"_"_$tr($g(filen),".","_")
	i "*"'[key s key=$$unique^%fm2class2(key,"^IRIS.TempFMI($j,""rv"")",128,,,,filen)
	QUIT key
}
 
 
pascal(pStr,camel=0) [] PUBLIC {
	set tReturn="",tFirst='camel
	for i=1:1:$l(pStr) {
		set tChar=$e(pStr,i)
		if tChar?1A { if tFirst { set tReturn=tReturn_$$$UPPER(tChar),tFirst=0 } else { set tReturn=tReturn_$$$LOWER(tChar) } }
		elseif tChar?1N { set tReturn=tReturn_tChar set:'tFirst tFirst=1 }
		else { set:'tFirst tFirst=1 }
	}
	QUIT tReturn
}
.
ddfield(key,filen,fid="reference",pConvertCase=1,nocheck=0) [] PUBLIC {
		#; return a unique field name
	if pConvertCase {
		if $$$fieldNameFormat="Upper" { set key=$$$UPPER(key) }
		elseif $$$fieldNameFormat="Lower" { set key=$$$LOWER(key) }
		elseif $$$fieldNameFormat="Pascal" { set key=$$pascal(key) }
		elseif $$$fieldNameFormat="Camel" { set key=$$pascal(key,1) }
	}
	set key=$$keycomp^%fm2class2(key,128)
		#; check for non-mapping names
	set:filen["OVF" filen=""""_filen_""""
	if 'nocheck,"*"'[key set key=$$unique^%fm2class2(key,"^IRIS.TempFM($j,"_filen_",""f"")",128,,"ddfield",fid)
	QUIT key
}
 
ddfield2(key,key2,filen,fid="reference",nocheck=0) [] PUBLIC {
		#; key is already formatted, just format key2
		#; return a unique field name
	if $$$fieldNameFormat="Upper" { set key2=$$$UPPER(key2) }
	elseif $$$fieldNameFormat="Lower" { set key2=$$$LOWER(key2) }
	elseif $$$fieldNameFormat="Pascal" { set key2=$$pascal(key2) }
	elseif $$$fieldNameFormat="Camel" { set key2=$$pascal(key2,key="") }
	set key=key_key2
	s key=$$keycomp^%fm2class2(key,128)
		#; check for non-mapping names
	s:filen["OVF" filen=""""_filen_""""
	i 'nocheck,"*"'[key s key=$$unique^%fm2class2(key,"^IRIS.TempFM($j,"_filen_",""f"")",128,,"ddfield",fid)
	QUIT key
}
 
setext(path) [] PUBLIC {
	s ext=""
	for i=1:1 s x=$p(path,"->",i) q:x=""  q:$p(x,"^",2)=""  s ext=ext_$p(^DD($p(x,"^"),+$p(x,"^",2),0),"^")_"->"
	QUIT $e(ext,1,$l(ext)-2)
}
 
 
add(filenum,topfil) [] PUBLIC {
	#; CREATE NEW BASE TABLE(S) FROM FILE # filenum
	s flevl=1,ok='$$CreateTable(filenum,"",topfil)
	QUIT ok
}
 
 
CreateTable(filen,dflg,topfil,fromfile) [] PUBLIC {
	#; Create Base Table From FileMan File
	#;
	#; Called as extrinsic function
	#; Input Parameters - filen = FileMan File # (ref to ^DIC)
	#;                    dflg  >0 (creating a designated table)
	#;                             (dflg indicates level of nesting)
	#;                    topfil = file # of top level file
	#; Returns          - 0 = success, >0 = error code
	#;
	#; Global variables used in pgm:
	#; btabnm = base table name
	#; gloref = full global reference of master map
	#; level  = level of subscripting in master master
	#; 
		#; Setup some stuff
	s err=0,SQLCODE=0
	s dflg=+$g(dflg) i 'dflg d
	. s topfil=filen
	. q:$g(jobfm)  ; don't reset the job for fileman
	. k ^IRIS.TempFMI($j,"fmtemp")
	if +dflg { do log2("Analyzing Pointer from File "_$g(fromfile,"???")_" ("_$$getFileName(fromfile)_") to File "_filen_" ("_$$getFileName(filen)_")","M",3*dflg) }
	else { do log2("Analyzing File "_filen_" ("_$$getFileName(filen)_")","M",3*dflg) }
	s tabname=$$table(filen,.err)
	QUIT:err=1 0 	// Already queued
	g:err error
	s mapname=$$map(filen,tabname,.gloref) g:err error
	d mapsubs(filen,tabname,mapname,gloref,.level,.err) g:err error
	d maprowid(filen,tabname,mapname,level) g:err error
	s RowIDDefault=$$nextdef(filen,mapname) i err s err=14 g error
	set IENType=$$$IENType
	set:IENType="" IENType="%Library.String"
	if filen'=1.1 {
			#;Define IDKEY IEN (Internal Entry Number) field
		set tIENName=$lg(^IRIS.TempFM($j,filen),12)
		s ^IRIS.TempFM($j,filen,"f",tIENName)=$lb(tIENName,"Internal Entry Number",IENType,1,,,,,,,,,,$lb($lb("COLLATION","EXACT"),$lb("TRUNCATE",0)),2,0,RowIDDefault,)
			#; Create IDKey index for IEN field
		s ^IRIS.TempFM($j,filen,"i","IDKEYINDEX")=$lb("IDKeyIndex","idkey",$lb(tIENName))
	}
	else {
			#; The AUDIT (1.1) file has an extra subscript level that is part of the IDKEY.  It is equal to the File Number of the file being audited 
			#;Define IDKEY IEN (Internal Entry Number) field
		set tIENName=$lg(^IRIS.TempFM($j,filen),12)
		s ^IRIS.TempFM($j,filen,"f",tIENName)=$lb(tIENName,"Internal Entry Number",IENType,1,,,,,,,,,,$lb($lb("COLLATION","EXACT"),$lb("TRUNCATE",0)),2,0,RowIDDefault,)
			#;Define IDKEY DIA field
		s ^IRIS.TempFM($j,filen,"f","DIA")=$lb("DIA","DIA Entry Number","%Library.String",1,,,,,,,,,,$lb($lb("COLLATION","EXACT"),$lb("TRUNCATE",0)),,0,,)
			#; Create IDKey index for IEN field
		s ^IRIS.TempFM($j,filen,"i","IDKEYINDEX")=$lb("IDKeyIndex","idkey",$lb("DIA",tIENName))
	}
	new %truncate
	do fields(filen,tabname,mapname,+dflg,topfil,gloref,,,,,,,.icol) //i err g error
	if $$$defineVASITE { set icol=icol+1 do addVASITEField(filen,icol) }
	//d index(filen,tabname,.err) i err s err=12 g error
	if $d(%truncate) {
			#; Here we will see if any fields are indexed with $$TRUNCATE(field,length).  If so, define the collation
			#; of the field to be TRUNCATE(len) where len is the maximum length used in the truncation.
			#; We only do this for %String fields
		set field=""
		for  {
			set field=$o(%truncate(field)) q:field=""
			set fdata=$g(^IRIS.TempFM($j,filen,"f",field))
			continue:fdata=""	//???
			continue:$case($lg(fdata,3),"%Library.String":0,"%Library.EnumString":0,:1)	// Not a string
			set length=$o(%truncate(field,""),-1)
			if $$$UPPER($lg(fdata,6))="EXACT" set $li(^IRIS.TempFM($j,filen,"f",field),6)="TRUNCATE("_length_")"
			set params=$lg(fdata,14)
			set cp=$listfind(params,$LB("COLLATION","EXACT"))
			if cp { set $li(params,cp)=$lb("COLLATION","TRUNCATE("_length_")") }
			else { set params=params_$lb($lb("COLLATION","TRUNCATE("_length_")")) }
			set $li(^IRIS.TempFM($j,filen,"f",field),14)=params
		}
	}
	do crossReferences(filen,tabname,gloref)  	// new-style cross references
	If '$$$readonly d CreateFMFilingTriggers^%fm2class2(filen,gloref,0)
	#; d log2("Table '"_tabname_"' queued for creation (File #"_filen_")","M",3*dflg)
	s %fmQueueCount=%fmQueueCount+1
	QUIT 0 ; success
.
error 	If err=1 d log2("Cannot Create Index Map.","E")
	If err=2 d log2("File #"_filen_", Field #(s)"_$e(fids,2,$l(fids))_", Cross Reference #"_crid_"; Cannot create Index Map Subscripts.","E",,,filen)
	If err=3 d log2("File #"_filen_", Name"_$$getFileName(filen)_", Unique table name cannot be determined for file, file omitted.","W",,,filen)
	If err=4 d log2("Cannot Create Index Map Row ID.","E")
	If err=5 d log2("Cannot Create Post-Insert Trigger For Non-Regular Index.","E")
	If err=6 d log2("Cannot Create Post-Update Trigger For Non-Regular Index.","E")
	If +err=7 d log2("File #"_filen_", Field #.01, cannot determine datatype for NAME field (field characteristics: "_$p(err,$c(1),2)_"), file omitted","E",,,filen)
	If err=8 d log2("File #"_filen_", Field #(s)"_$e(fids,2,$l(fids))_", Cross Reference #"_crid_"; Cannot create indices for omitted field(s).","W",,,filen)
	If +err=9 d log2("Cannot Create Indices For $E(field) expressions: "_$p(err,$c(1),2)_".","W")
	If err=10 d log2("File #"_filen_", Field #.01, does not exist.  No table created for this file.","E",,,filen)
	If err=12 d log2("File #"_filen_", Field #(s)"_$e(fids,2,$l(fids))_", Cross Reference #"_crid_"; Cannot create indices for omitted field(s).","W",,,filen)
	If err=16 d log2("File #"_filen_", Name"_$$getFileName(filen)_", File name cannot be mapped to table name, file omitted.","W",,,filen)
	QUIT err
}
 
 
table(filen,err) [] PUBLIC {
		#; create base table
	i $d(^IRIS.TempFM($j,filen)) s err=1 QUIT ""
	i '$d(^DD(filen,.01,0)) s err=10 QUIT ""
	s tabname=$$getFileName(filen)	// tabname is now FileMan table name
	s tabname=$$getTableName(tabname,filen) i "*"[tabname s err=$s(tabname="":3,1:16) QUIT "" ; check if not mapping on purpose
	s datype=$$datype^%fm2class2($p(^DD(filen,.01,0),"^",2))
	i datype="" s err=7_$c(1)_$p(^DD(filen,.01,0),"^",2) QUIT "" ; unsupp. datatype for 'Name' field
	s desc="Generated class for FileMan File Number: '"_filen_"'  File Name: '"_$o(^DD(filen,0,"NM",""))_"'   Class generated by %fm2class version "_$$GetVersion()
	f i=1:1:$p($g(^DIC(filen,"%D",0)),"^",3) s desc=desc_$$$NL_$g(^DIC(filen,"%D",i,0))	// File description
	set tIENName=$$$ienFieldName
	set:tIENName["<TABLENAME>" tIENName=$$strrep(tIENName,"<TABLENAME>",tabname)
	s ^IRIS.TempFM($j,filen)=$lb(tabname,desc,$$$owner,,"Y","RowId",$lb(tabname_"."_tIENName),$lb(tabname_"."_tIENName),"RowId",,,tIENName)
	s ^IRIS.TempFMI($j,"rv",$$$UPPER(tabname))=filen
	s ^IRIS.TempFMI($j,"fm",filen)=$lb(tabname,desc)
	QUIT tabname
}
 
 
map(filen,tabname,gloref,topfile="",filensub="") [] PUBLIC {
		#; create master map
		#; gloref returned - PBR
	s:topfile="" topfile=filen s:filensub="" filensub=filen
	s gloref=^DIC(topfile,0,"GL")
	s:$$$extendedMapping'="" gloref="^"_$$$extendedMapping_$e(gloref,2,$l(gloref))
	s mapname=tabname_" Data Map"
	s ^IRIS.TempFM($j,filensub,"m",$$$UPPER(mapname))=$lb(mapname,$p(gloref,"("),"Y")
	QUIT mapname
}
.
 
mapsubs(filen,tabname,mapname,gloref,level,err) [] PUBLIC {
		#; Create Map Subscripts
		#; Map simple table with no parents
		#; FIRST DO LITERAL SUBSCRIPTS
		#;  ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"s",level) = $lb(<optional FieldName>,<subscript expression>,<invcond>,<nextsub>)
	set level=0,i=0,savegloref=gloref
	set:filen=1.1 gloref=gloref_"{DIA},"
	set subs=$e(gloref,$f(gloref,"("),*-1)
	if subs'="" {
		do lexan^%fm2class2(gloref,.subs,.level)
		for i=1:1:level {
			set subi=level(i)
			if $e(subi)="""",$e(subi,$l(subi))="""" { set subi=""""_$tr(subi,"""")_"""" }
			set ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"s",i)=$lb(,subi)
			set gloref=gloref_$$quoter(subi)_","
		}
	}
		#; THEN DO VARIABLE SUBSCRIPT
	set level=i+1
	if filen=1.1 {
		set invcond=$lb("{L"_(level-1)_"}'>0")
		set nextsub=$lb("set:{L"_(level-1)_"}="""" {L"_(level-1)_"}=0 set {L"_(level-1)_"}=$o(^({L"_(level-1)_"})) set:'{L"_(level-1)_"} {L"_(level-1)_"}=""""",";PREV","set:{L"_(level-1)_"}="""" {L"_(level-1)_"}=$c(0) set {L"_(level-1)_"}=$o(^({L"_(level-1)_"}),-1) set:'{L"_(level-1)_"} {L"_(level-1)_"}=""""")
		set ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"s",level-1)=$lb(tabname_".DIA","{"_tabname_".DIA}",invcond,nextsub)
	}
	set invcond=$lb("{L"_level_"}'>0")
	if $$$wholeFileScreen { set fileScreenCode=$g(^DD(filen,0,"SCR")) } else { set fileScreenCode="" }
	if fileScreenCode'="" {
		if fileScreenCode["X" {	// might need 01 field (NAME) value
			set namefielddata=$g(^DD(filen,.01,0))
			if namefielddata'="" {
				set node=$p($p(namefielddata,"^",4),";",1)
				set piece=$p($p(namefielddata,"^",4),";",2)
				set namefieldref="$p("_savegloref_"DA,"_node_"),""^"","_piece_")"
			}
		} else { set namefieldref="" }
			// Addition invalid condition
		set invcond=invcond_$lb("'$$SCR^%fm2class4({L"_level_"},"_$$quoter(namefieldref)_","_$$quoter(fileScreenCode)_")")
			// NEXT logic
		set nextsub=$lb("set:{L"_level_"}="""" {L"_level_"}=0 set {L"_level_"}=$o(^({L"_level_"})) if '{L"_level_"} set {L"_level_"}="""" quit")
		set nextsub=nextsub_$lb("goto:'$$SCR^%fm2class4({L"_level_"},"_$$quoter(namefieldref)_","_$$quoter(fileScreenCode)_") NEXT")
			// PREV logic
		set nextsub=nextsub_$lb(";PREV","set:{L"_level_"}="""" {L"_level_"}=$c(0) set {L"_level_"}=$o(^({L"_level_"}),-1) if '{L"_level_"} set {L"_level_"}="""" quit")
		set nextsub=nextsub_$lb("goto:'$$SCR^%fm2class4({L"_level_"},"_$$quoter(namefieldref)_","_$$quoter(fileScreenCode)_") PREV")
	} else {	// nofilescreen
			#; For the PREV code, start at $c(0) and reverse $order to pick up all the numeric subscript values.
		set nextsub=$lb("set:{L"_level_"}="""" {L"_level_"}=0 set {L"_level_"}=$o(^({L"_level_"})) set:'{L"_level_"} {L"_level_"}=""""")
		set nextsub=nextsub_$lb(";PREV","set:{L"_level_"}="""" {L"_level_"}=$c(0) set {L"_level_"}=$o(^({L"_level_"}),-1) set:'{L"_level_"} {L"_level_"}=""""")
	}
	set tIENName=$lg(^IRIS.TempFM($j,filen),12)
	set ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"s",level)=$lb(tabname_"."_tIENName,"{"_tabname_"."_tIENName_"}",invcond,nextsub)
	set gloref=gloref_$c(1)_","
	RETURN
}
 
 
maprowid(filen,tabname,mapname,level) [] PUBLIC {
		#; Create Map Row Id
	set tIENName=$lg(^IRIS.TempFM($j,filen),12)
	s ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"r",level)=$lb(tIENName,"{L"_level_"}")
	QUIT
}
 
 
CreateMapRowid(filen,mapname,level) [] PUBLIC {	// Create Map Row Id Info
		#; get row-id physical based-on field names
	s based=$lg(^IRIS.TempFM($j,filen),7)
	s MAPNAME="" f  s map=$o(^IRIS.TempFM($j,filen,"m",map),1,data) q:MAPNAME=""  i $lg(data,3)="Y" q
	s ilev="" For  {
		s ilev=$o(^IRIS.TempFM($j,filen,"m",MAPNAME,"s",ilev),1,data)
		If '$lf(based,$lg(data,1)) continue	// Based on field not at this subscript level
		s ^IRIS.TempFM($j,filen,"m",MAPNAME,"r",$i(^IRIS.TempFM($j,filen,"m",MAPNAME,"r")))=$lb($lg(data,1),"{L"_ilev_"}")
	}
	QUIT
}
 
 
nextdef(filen,mapname,err) [] PUBLIC {
		#; returns initialexpression of rowid field
	s glo=$lg(^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname)),2),pcount=0
	s ilev=0 f  s ilev=$o(^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"s",ilev),1,data) q:'ilev  s level($i(level))=$lg(data,2)
	s ifn=$tr(level(level),"{}") ; get bottom level ifn
	s ref=glo_"("
	f ilev=1:1:level-1 d
	. s ref=ref_$s($e(ref,$l(ref))="(":"",1:",")
	. i level(ilev)'["{" d  q
	.. i +$p(level(ilev),$c(1))'=$p(level(ilev),$c(1)) d
	... i $e(level(ilev))="""" s ref=ref_""""_$tr($p(level(ilev),$c(1)),"""")_""""
	... ; no special handling for MUMPS expressions
	... e  s ref=ref_$p(level(ilev),$c(1))
	.. e  s ref=ref_$p(level(ilev),$c(1))
	. s pcount=pcount+1
	. s ref=ref_"$p(%d(0),""||"","_pcount_")"
	s ref=ref_$s($e(ref,$l(ref))="(":"",1:",")_"0)"
	s ref="$p("_ref_",""^"",3)"
	s ref="$$next^%apiSQL("_$$quoter(ref)_")"
	i $l(ref)>250 s err=1 QUIT ""
	QUIT ref
}
 
 
fields(filen,tabname,mapname,flevl,topfil,gloref,childtable=0,parfil="",fldfid="",pfilensub="",wp="",partabname="",&icol) [] PUBLIC {
	#; Create Base Table Fields
	#; This subroutine loops through all of the fields for a FileMan file
	#; If the field is a pointer, we recursively call the base table
	#; creation routine to establish the designated table.  If the field
	#; points to a sub-file, we recursively call the child table creation
	#; routine to establish the child, and its descendents.
	#;
	#; Parameters - flevl=level of recursive call
	#;
	set fid=.000099,icol=2,savetabname=tabname,filensub=filen,fldCount=0,ovfCount=0,savegloref=gloref
	for  {
		set fid=$o(^DD(filen,fid)) quit:'fid
		set fldCount=fldCount+1,fieldsAdded=0
		do:$d(^DD(filen,fid,0)) onefield
		set fldCount=fldCount+fieldsAdded
		if fldCount>900 {
			set fldCount=0,ovfCount=ovfCount+1,tabname=savetabname_"_OVF"_ovfCount,filensub=filen_"_OVF"_ovfCount
			if '$d(saveicol) { set saveicol=icol }
			set icol=2
			do overflowTable(filen,filensub,tabname,mapname,savegloref,savetabname,topfil,childtable,parfil,fldfid,pfilensub,wp,partabname)
		}
		if fid>.0099,$d(^DD(filen,fid,1)) {
			set err=0
			do indexit(filen,filensub,tabname,fid,savegloref,.err)
			do:err error set err=0
		}
	}
	if $d(saveicol) { set icol=saveicol }
	RETURN
 
 
onefield ; Create One Field Given filen and fid
		#; STEP 1: DEFINE FIELD
		#; DETERMINE DATA TYPE
	kill Collection,DisplayList,fldnm,desc,maxlen,ReadOnly,required,SQLComputed,Calculated,SQLComputedCode,type,TypeParam,ValueList
	set nocon=0,ReadOnly=0
	if '$d(^DD(filen,fid,0)) { set nocon=1 d log2("File #"_filen_", Field #"_fid_"; Omitting field - missing 0 node.","W",,,filen) RETURN }
	set stuff=^DD(filen,fid,0) // get field specs.
	if $$$requiredType {
		set required=($p(stuff,"^",2)["R")				// Required
	}
	else {	// Set property required if fid=.01 or it is a required identifier
		if fid=.01 { set required=1 }
		elseif $d(^DD(filen,0,"ID",fid)),$d(^DD(filen,"RQ",fid)) { set required=1 }
		else { set required=0 }
	}
	if $d(%fmFields(filen)),'required,'$d(%fmFields(filen,fid)) { RETURN }  	// Field not required and not requested to be mapped, skip it
	set flength=$g(^DD(filen,fid,30))
	set fmtype=$p(stuff,"^",2)
	set datype=$$datype^%fm2class2(fmtype)
	if datype="" { set nocon=1 do log2("File #"_filen_", Field #"_fid_"; Omitting field - unsupported data type.","W",,,filen) RETURN }
	set inputTransform=$p(stuff,"^",5,*)
	if inputTransform="",fmtype["D",'fmtype,fmtype'="Dt15" { set nocon=1 do log2("File #"_filen_", Field #"_fid_"; Omitting field - null input transform on a DATE field.","W",,,filen) RETURN }
 
		#;
		#;IF CHILD TABLE and not Word-Proc: SAVE symbol, Create Child and Quit
		#;   if Word-Proc act according to preferences
	set:datype=100 wp=($p($g(^DD(+fmtype,.01,0)),"^",2)["W")
	if datype=100,$s('wp:1,$$$wpIsList=0:1,$$$wpIsList=2:1,1:0) {
		if $$$recursion=0 {
			if 'wp { d log2("File #"_filen_", Field #"_fid_"; Sub-File/Multiple Field omitted because of option RECURSION=NONE.","W",,,filen) }
			else   { d log2("File #"_filen_", Field #"_fid_"; Word-Processing Field omitted because of option RECURSION=NONE and WORD PROC FIELD IS LIST?=NO.","W",,,filen) }
			RETURN
		}
		if $$$recursion=1,%fmRecursionLevel=1 { 
			if 'wp { d log2("File #"_filen_", Field #"_fid_"; Sub-File/Multiple Field omitted because of option RECURSION=PARTIAL.","W",,,filen) }
			else   { d log2("File #"_filen_", Field #"_fid_"; Word-Processing Field omitted because of option RECURSION=PARTIAL and WORD PROC FIELD IS LIST?=NO.","W",,,filen) }
			RETURN
		} elseif $p($$$UPPER($$$recursion),"=",1)="DEPTH",%fmRecursionLevel=+$p($$$recursion,"=",2) {
			if 'wp { do log2("File #"_filen_", Field #"_fid_"; Sub-File/Multiple Field omitted because of option RECURSION="_$$$recursion_".","W",,,filen) }
			else   { do log2("File #"_filen_", Field #"_fid_"; Word-Processing Field omitted because of option RECURSION="_$$$recursion_" and WORD PROC FIELD IS LIST?=NO.","W",,,filen) }
			RETURN
		}
		set %fmRecursionLevel=%fmRecursionLevel+1
		set ret=$$ChildTable(tabname,filen,fid,flevl+1,,topfil,wp,filensub)
		set %fmRecursionLevel=%fmRecursionLevel-1
		if '(ret=1) { do log2("File #"_filen_", Field #"_fid_"; Field has invalid Sub-File/Multiple - Omitted.","W",,,filen) }
		if 'wp || ($$$wpIsList=0) { RETURN }
	}
		// datype=100 is a fake type for a child table
	set:datype=100 datype="8W"
		#;
		#; GET BASIC INFORMATION FOR FIELD
	if +datype=10,$$$expandPointers>1 { 
			#; for references with expandPointer option 2, the name will be the reference_ID
			#; for references with expandPointer option 3, the name will be the reference_f<file id#>ID
		if $$$expandPointers=2 { s fldnm=$$ddfield($p(stuff,"^")_"_ID",filensub,fid) }
		else {	// $$$expandPointers=3
			s x=$p(stuff,"^",2),y=$f(x,"P"),zfil="",ok=1
			f j=y:1:$l(x) q:$e(x,j)'?.1n.1"."  s zfil=zfil_$e(x,j)
			s fldnm=$$ddfield($p(stuff,"^")_"_f"_$s(zfil:zfil,1:"")_"ID",filensub,fid)
		}
	}
	else { set fldnm=$$ddfield($p(stuff,"^"),filensub,fid) }
	
	if "*"[fldnm {
		set x="File #"_filen_", Field #"_fid_"; Omitting Field - "
		set x=x_$s(fldnm="*":"Non - mapping",1:"Non - unique or invalid")
		set x=x_" field name" d log2(x,"W",,,filen)
		RETURN
	}
	set dt=+datype 					// DataType ; PNT004 (datype = 8-> for mult pointer)
 
		#;
		#; MULTIPLE CHOICE DATA TYPE
	if dt=6 {  ; Multi-Choice Data Type
		if $g($$$expandSetOfCodes) {
				#; Create a separate table with the Set Of Codes data and a foreign key from this field to that table
				#; This allows business logic tools to see the SetOfCode values associated with this field
			set ok=$$SoCTable^%fm2class2(savetabname,filen,fid,fldnm,flevl+1,.soctabname)
			#; if ok { set type=soctabname }
			#; else { b  }
			#; //set ^IRIS.TempFMI($j,"desref",tabname,fldnm)=$lb(zfil,2,fldnm)
		}
		if $$$setOfCodesEnum { set type="%Library.EnumString" }
		else { set type="%Library.String" }
		set x=$p(stuff,"^",3) 
		if x'="" {
			for j=1:1:$l(x,";") {
				set y=$p(x,";",j) quit:y=""
				set:$g(maxlen)<$l($p(y,":",2)) maxlen=$l($p(y,":",2))
				set $p(DisplayList,";",j)=$p(y,":",2)
				set $p(ValueList,";",j)=$p(y,":")
			}
			set TypeParam("VALUELIST")=";"_ValueList
			set TypeParam("DISPLAYLIST")=";"_DisplayList
			set TypeParam("COLLATION")="EXACT"
			set:maxlen TypeParam("MAXLEN")=maxlen
		} elseif fmtype="St11" {	// new BOOLEAN datatype defined in DATA TYPE (.81) file, with IEN 11
			set TypeParam("VALUELIST")=";0;1"
			set TypeParam("DISPLAYLIST")=";NO;YES"
			set TypeParam("COLLATION")="EXACT"
			set TypeParam("MAXLEN")=3
		} else {
			//w !?100,fmtype
			set type="%Library.String"
		}
	}
 
		#;
		#; DESIGNATIVE REFERENCE DATA TYPE
	if dt=10 {
		if $$$recursion=0 {
			do log2("File #"_filen_", Field #"_fid_"; Pointer Field omitted because of option RECURSION=NONE.","W",,,filen)
			RETURN
		} elseif $$$recursion=1,%fmRecursionLevel=1 {
			do log2("File #"_filen_", Field #"_fid_"; Pointer Field omitted because of option RECURSION=PARTIAL.","W",,,filen)
			RETURN
		} elseif $p($$$UPPER($$$recursion),"=",1)="DEPTH",%fmRecursionLevel=+$p($$$recursion,"=",2) {
			do log2("File #"_filen_", Field #"_fid_"; Pointer Field omitted because of option RECURSION="_$$$recursion_".","W",,,filen)
			RETURN
		}
		set x=$p(stuff,"^",2),y=$f(x,"P"),zfil="",ok=1
		for j=y:1:$l(x) { quit:$e(x,j)'?.1n.1"."  set zfil=zfil_$e(x,j) }
		if 'zfil { set ok=0 do log2("File #"_filen_", Field #"_fid_"; Invalid Pointer omitted.","W",,,filen) RETURN }
			#; IF DESIGNATED TABLE ALREADY EXISTS, JUST GET ITS ROW-ID
			#;  store des refs and make text field temporarily
		set type="%Library.String"	// Text Data Type         
	}
	
		#;
		#; THEN ADD INFO FROM FILE-MAN FIELD SPECIFICATION
	if +datype=8 {
			#; Function (default 'EXACT' for text flds)
		set type="%Library.String"	// Text Data Type
		if datype="8W",$$$wpIsList'=3 { set Collection="list" }
		set TypeParam("COLLATION")="EXACT"
		set TypeParam("TRUNCATE")=0
		if fmtype="Ft12" {	   // LABEL REFERENCE DATATYPE
			set TypeParam("MAXLEN")=99
		} elseif fmtype="Ft13" {   // TIME
			set type="%Library.FilemanTime"
			kill TypeParam
		} elseif fmtype="Ft18" {   // RATIO
			set TypeParam("MAXLEN")=23
		} else {
			set TypeParam("MAXLEN")=255
		}
		#;s:datype="8->" ReadOnly=1	// DPV3008
	}
	
	if fmtype["W" { set TypeParam("MAXLEN")=32000 } // Word Processing Data Type
	elseif datype="8W",$$$wpIsList=3 { set TypeParam("MAXLEN")=32000 }	// Word Processing Data Type stored in a single string field
	elseif inputTransform["$L(X)>",dt'=10 { 
		set x=inputTransform set:+$p(x,"$L(X)>",2) TypeParam("MAXLEN")=+$p(x,"$L(X)>",2) // MaxLen
		set:+$p(x,"$L(X)<",2) TypeParam("MINLEN")=+$p(x,"$L(X)<",2) 			 // MinLen
	} elseif $g(type)="%Library.String",dt'=10 {
		set TypeParam("MAXLEN")=$get(maxlen,255)
	}
	if dt=5,fmtype="Dt14" {	        // YEAR datatype
		set type="%Library.FilemanYear",flength=7
	} elseif  dt=5,fmtype="Dt15" {	// UNIVERSAL TIME datatype
		set type="%Library.FilemanTimeStampUTC",flength=17
	} elseif inputTransform'="",inputTransform'="Q" {
		set x=inputTransform 
		if fmtype["D" { kill TypeParam("MAXLEN"),TypeParam("MINLEN") set:'flength flength=19 do fmdate^%fm2class2(x,fmtype,flength,.type,.TypeParam) }
	}
	if fmtype["Q" {}		// MUMPS Code DataType (no-op)
	if fmtype["J" {
		set x=$e(fmtype,$f(fmtype,"J"),$l(fmtype)) set:+$p(x,",",2) TypeParam("SCALE")=+$p(x,",",2) 	// NuDeci
	}
		#;	If $d(^DD(filen,fid,"DEL")),fmtype'["R" {	// Maybe Required - no-op for now
		#;		s data(9)="M" ; Required = 'Maybe'
		#;		s data(10)="$$execute^%qadlutl("_filen_","_fid_")"
		#;	}
	if dt=5,fmtype'["D" {	// numeric data type (Exclude date/time)
		set type="%Library.Numeric",flength=0
		kill TypeParam("MAXLEN"),TypeParam("MINLEN")
		if fmtype?.e1","1n.n.e { set TypeParam("SCALE")=+$p(fmtype,",",2) } ; Nu decPlaces
		set x=$p(^DD(filen,fid,0),"^",5)
			// *** i x["S:X[""$""" s data(26)="$" ; NuLeadPn
		if x["(X>" { set y1=$f(x,"(X>"),y2=$f(x,")",y1),z=$e(x,y1,y2-2) set:$isvalidnum(z) TypeParam("MAXVAL")=z,flength=$l(z) } ; NuMax
		if x["(X<" { set y1=$f(x,"(X<"),y2=$f(x,")",y1),z=$e(x,y1,y2-2) if $isvalidnum(z) { set TypeParam("MINVAL")=z set:flength<$l(z) flength=$l(z) }} ; NuMin
		if 'flength { set flength=20 }
		else { set:$g(TypeParam("SCALE")) flength=flength+TypeParam("SCALE")+1 }
	}
		#; if .001 field make computed equal to RowId or Sub
	if fid=.001 {
		set type="%Library.String"
		kill TypeParam
		set TypeParam("COLLATION")="EXACT",TypeParam("TRUNCATE")=0
		set SQLComputed=1
		set Calculated=1
		set logical=$lg(^IRIS.TempFM($j,filensub),8)
		set SQLComputedCode=$lb(" Set {*}={"_$$$LastPiece($li(logical,$ll(logical)),".")_"}")
	}
 
		#;
		#; INSERT FIELD INFO INTO FIELD TABLE
	set:$g(type)=""&&(dt'=10) type="%Library.String",TypeParam("MAXLEN")=255
	if $d(TypeParam) {
		set TypeParam=""
		set p=""
		for {
			set p=$o(TypeParam(p),1,d) quit:p=""
			set TypeParam=TypeParam_$lb($lb(p,d))
		}
	}
	if dt=10 {
			#; k TypeParam
		set ^IRIS.TempFMI($j,"desref",tabname,fldnm)=$lb(zfil,2,fldnm,%fmRecursionLevel+1)	// This reference is one recursion level higher than the current file
		set:$$$expandPointers fieldsAdded=fieldsAdded+1
	}
 
		#;
		#; NOW ADD MORE INFO TO BASIC FIELD DEFINITION
		#; Fixed length fields must be made computed
	if $p($p(stuff,"^",4),";",2)?1"E".e { set fmtype="C"_fmtype }
	if fmtype["C" {	// Set Up Computed Field Stuff
		set SQLComputed=1,err="" // CompField
		if $p($p(stuff,"^",4),";",2)'?1"E".e {
				#; Compute Real Computed Fields
			set Calculated=1		// ComEqualValue
			set compCode=$$codeopt^%fm2class2(inputTransform)
			if $e(compCode,1,5)="S X=$" {	// Assume it is just setting X to an expression with no other calls
				set dCode="" 
				set dCode="set U=""^"""
				set:compCode["DT" dCode=dCode_$s(dCode'="":",",1:"set ")_"X=$zdate(+$h),%DT=""X"" do ^%DT set DT=Y"
				set:fmtype["Cm" dCode=dCode_$s(dCode'="":",DIA={DIA}",1:"set DIA={DIA}")
				set:filen=1.1 dCode=dCode_$s(dCode'="":",DICMX=""""",1:"set DICMX=""""")
				for i=0:1:20 { if compCode[("D"_i) { set dCode=dCode_$s(dCode'="":",",1:"set ")_"D"_i_"=$piece({RowId},""||"","_(i+1)_")" }}	// Set up any D# variables
					//s $e(compCode,1,5)=dCode_$s(dCode'="":",",1:"set ")_"{"_fldnm_"}=$"
				set SQLComputedCode=$lb(dCode_$e(" ",dCode'="")_compCode)
				set SQLComputedCode=SQLComputedCode_$lb("set {"_fldnm_"}=X")
			}
			else {
				set dCode=""
				set dCode=dCode_"set U=""^"""_$s(fmtype["Cm":",DICMX=""""",1:"")_",X=$zd($h),%DT=""X"" do ^%DT set DT=Y "	// Needed because some FileMan compute code uses the current DATE in the DT variable
				if filen'=1.1 {
					set SQLComputedCode=$lb(dCode_"for i=1:1:$l({RowId},""||"") set @(""D""_(i-1))=$p({RowId},""||"",i)")
				}
				else {
					set SQLComputedCode=$lb(dCode_"set DIA={DIA},D0=$p({RowId},""||"",2)")
				}
				//s SQLComputedCode=SQLComputedCode_$lb("set Y={"_fldnm_"}")
				set SQLComputedCode=SQLComputedCode_$lb(compCode)
				set SQLComputedCode=SQLComputedCode_$lb("set {"_fldnm_"}=X")
			}
			//i $s(fmtype["D":1,fmtype[",":1,1:0) s SQLComputedCode=SQLComputedCode_$lb("q:X="""" ")
		}
		Else {
				#; Compute Fixed Length Fields
			set gloref=$$GlobalRef^%fm2class2(filen,mapname)
			set node=$p($p(stuff,"^",4),";",1)
			if +node'=node { set node=""""_node_"""" }
			set x=$p($p(stuff,"^",4),";",2)
			set x=$e(x,$f(x,"E"),$l(x))
			set ext1=$p(x,",",1),ext2=$p(x,",",2)
			set gloref=$e(gloref,1,$l(gloref)-1)_","_node_")"
			do find^%fm2class2(filen,gloref,.nodename)
			if nodename="" { set nodename=$$makenode(filen,stuff,fldnm,fid,gloref,.icol),fieldsAdded=fieldsAdded+1 }
			set exp="$e({"_nodename_"},"_ext1_","_ext2_")"
			set Calculated=1		// ComEqualValue
			set SQLComputedCode=$lb("s {"_$$quoter2(fldnm)_"}="_exp)
		}
	}
	set fieldlength=flength s:$g(TypeParam("MAXLEN")) fieldlength=TypeParam("MAXLEN")
	
	set description="FileMan Field Label: '"_$p(stuff,"^")_"'  FileMan Field Number: '"_fid_"'"
	if $d(^DD(filen,fid,.1)) { set description=description_$$$NL_^(.1) }		// Was converted to FDBMS Caption
	set x=0
	for {
		set x=$o(^DD(filen,fid,21,x)) quit:x'=+x
		set description=description_$$$NL_$g(^DD(filen,fid,21,x,0))	// Was converted to FDBMS Long Help
	}
	set ^IRIS.TempFM($j,filensub,"f",$$$UPPER(fldnm))=$lb(fldnm,description,type,required,fieldlength,$g(TypeParam("COLLATION")),$g(SQLComputed),$g(Calculated),$g(SQLComputedCode),,,,,$g(TypeParam),$i(icol),0,,$g(Collection),ReadOnly,fid,$p(stuff,"^"),inputTransform)
	set ^IRIS.TempFMI($j,"fid",filensub,fid)=$lb(fldnm,desc,+$g(SQLComputed)+$g(Calculated),datype="8W",icol,ReadOnly,inputTransform)
		#;  This code is needed if we want expanded Set Of Codes to be references
		#; if dt=6,$g(%fmExpandSOC) {
		#; 	s $li(^IRIS.TempFM($j,filensub,"f",$$$UPPER(fldnm)),14)=""	// Clear Type Parameters
		#; 	s $li(^IRIS.TempFM($j,filensub,"f",$$$UPPER(fldnm)),16)=1	// IsAReference
		#; }
.
		#;
		#; STEP 2: ADD FIELD TO MAPPED DATA
	if fmtype["C" { RETURN }  	// Computed fields not mapped
	if fid=.001 { RETURN }  	// .001 field is NEVER mapped
	kill node,piece,delimiter,RetrievalCode
	set MAPNAME=$$$UPPER(mapname)	// mapname is the name of the data map      $o(^IRIS.TempFM($j,filen,"m",""))	// Only 1 map defined at this time
	if datype="8->" {
		set gloref=$lg(^IRIS.TempFM($j,filen,"m",MAPNAME),2)_"("
		set sub="" for { set sub=$o(^IRIS.TempFM($j,filen,"m",MAPNAME,"s",sub)) quit:sub=""  set gloref=gloref_"{S"_sub_"}," }
		set node=$p($p(stuff,"^",4),";",1)
		set:node'=+node node=""""_node_""""
		set piece=$p($p(stuff,"^",4),";",2) ; Piece
		set gref="$p($g("_gloref_node_")),""^"","_piece_")"
		do multpc^%fm2class2(filen,fid,tabname,fldnm,fldnm,.icol,MAPNAME,gref,.fieldsAdded)	// multiple pointer fields
	}
	if datype="8W" {
		set node=$p($p(stuff,"^",4),";",1) set:node'=+node node=""""_node_""""
			// DPV4916 changed this code to not use naked references and to not rely on {%row} at run time.
		set wpfgloref=$$BuildGloRef(filen,MAPNAME)
		set qfname=$$quoter2(fldnm)
		if $$$wpIsList=3 {
			set RetrievalCode=$lb("new data,i,node set {"_qfname_"}="""" merge data="_wpfgloref_node_") set node=0 for i=1:1 { set node=$o(data(node)) quit:'node  set {"_qfname_"}={"_qfname_"}_$s(i=1:"""",1:$c(32,13,10))_$g(data(node,0))}")
		} else {
			set RetrievalCode=$lb("new data,node set {"_qfname_"}="""" merge data="_wpfgloref_node_") set node=0 for  { set node=$o(data(node)) quit:'node  set {"_qfname_"}={"_qfname_"}_$lb($g(data(node,0))) }")
		}
	}
	else {
		set node=$p($p(stuff,"^",4),";",1) ; Node
		if +node'=node { set node=""""_node_"""" }
		if fmtype'["W" {
			set piece=$p($p(stuff,"^",4),";",2) ; Piece
			set delimiter="""^""" ; Delimiter
		}
	}
	set ^IRIS.TempFM($j,filensub,"m",MAPNAME,"d",$i(^IRIS.TempFM($j,filensub,"m",MAPNAME,"d")))=$lb(fldnm,$g(node),$g(piece),$g(delimiter),$g(RetrievalCode))
	kill node,piece,delimiter,RetrievalCode
	RETURN
}
.
	/// Define the VASITE/VA_SITE computed property/field
addVASITEField(filen,icol) [icol] PRIVATE {
	set fldnm="VA_SITE",filensub=filen,fid="vasite"
	set description="SqlComputed field that computes the VA_SITE for this table's File"
	set type="%Library.String"
	set SQLComputedCode=$lb("if $g(%ISCFM2ClassSVASiteID($namespace))="""" { new X set X=""NOW"" do ^%DT set DT=Y set ({*},%ISCFM2ClassSVASiteID($namespace))=$p($$SITE^VASITE,""^"",3) } else { set {*}=%ISCFM2ClassSVASiteID($namespace) }")
	set required=1
	set TypeParam("MAXLEN")=50,fieldlength=50
	set TypeParam("COLLATION")="EXACT"
	set TypeParam=""
	set p="" for  { set p=$o(TypeParam(p),1,d) quit:p=""  set TypeParam=TypeParam_$lb($lb(p,d)) }
	set ^IRIS.TempFM($j,filensub,"f",$$$UPPER(fldnm))=$lb(fldnm,description,type,required,fieldlength,$g(TypeParam("COLLATION")),1,1,$g(SQLComputedCode),,,,,$g(TypeParam),icol,0,,,1,fid,"vasite")
	set ^IRIS.TempFMI($j,"fid",filensub,fid)=$lb(fldnm,desc,2,0,icol,1)
	RETURN
}
.
	// Given a file# and a map name, build the global reference defined so far
BuildGloRef(filen,MAPNAME) [] PRIVATE {
	set gloref=$lg($g(^IRIS.TempFM($j,filen,"m",MAPNAME)),2)_"("	// Global name, for example ^LRO
	set ilev=""
	for  {
		set ilev=$o(^IRIS.TempFM($j,filen,"m",MAPNAME,"s",ilev),1,msdata) quit:ilev=""
		if $lg(msdata,1)="" { set gloref=gloref_$lg(msdata,2)_"," }
		else		    { set gloref=gloref_"{S"_ilev_"}," }
	}
	RETURN gloref
}
 
 
overflowTable(filen,filensub,tabname,mapname,gloref,roottabname,topfile,childtable=0,parfil,fldfid,pfilensub,wp,partabname) [] PUBLIC {
	s err=0
	s desc="Generated overflow class for FileMan File Number: '"_filen_"'  File Name: '"_$o(^DD(filen,0,"NM",""))_"'   Class generated by %fm2class version "_$$GetVersion()
	for i=1:1:$p($g(^DIC(filen,"%D",0)),"^",3) { set desc=desc_$$$NL_$g(^DIC(filen,"%D",i,0)) }	// File description
	set tIENName=$lg(^IRIS.TempFM($j,filen),12)
	if childtable {
		s parprof=^DD(parfil,fldfid,0)
		s err=0
		do CreateChildTable(filen,filensub,parfil,partabname,parprof,$$getFileName(parfil),wp,.btabnm,.err,tabname,pfilensub) if err { goto error }
		do CreatePCRelationship(parfil,filen,partabname,tabname,wp,.parrefname,pfilensub,filensub)
		set mapnameovf=$$map(filen,roottabname,.gloref,topfile,filensub) g:err error
		do MapSubsChild^%fm2class2(pfilensub,filensub,tabname,mapnameovf,.gloref,parprof,.level,.err) if err { goto error }
	}
	else {
		s ^IRIS.TempFM($j,filensub)=$lb(tabname,desc,$$$owner,,"Y","RowId",$lb(tabname_"."_tIENName),$lb(tabname_"."_tIENName),"RowId",,,tIENName)
		s ^IRIS.TempFMI($j,"rv",$$$UPPER(tabname))=filensub
		s ^IRIS.TempFMI($j,"fm",filensub)=$lb(tabname,desc)
		s mapnameovf=$$map(filen,roottabname,.gloref,topfile,filensub) g:err error
		d mapsubs(filensub,tabname,mapname,gloref,.level,.err) g:err error
	}
	d maprowid(filensub,tabname,mapname,level) g:err error
	s RowIDDefault=$$nextdef(filen,mapname) i err s err=14 g error
		#;Define IDKEY IEN (Internal Entry Number) field
	s ^IRIS.TempFM($j,filensub,"f",tIENName)=$lb(tIENName,"Internal Entry Number","%Library.String",1,,,,,,,,,,$lb($lb("COLLATION","EXACT"),$lb("TRUNCATE",0)),2,0,RowIDDefault,)
		#; Create IDKey index for IEN field
	s ^IRIS.TempFM($j,filensub,"i","IDKEYINDEX")=$lb("IDKeyIndex","idkey",$lb(tIENName))
	QUIT
.
error 	If err=1 d log2("Cannot Create Index Map.","E")
	If err=2 d log2("File #"_filen_", Field #(s)"_$e(fids,2,$l(fids))_", Cross Reference #"_crid_"; Cannot create Index Map Subscripts.","E",,,filen)
	If err=3 d log2("File #"_filen_", Name"_$$getFileName(filen)_", Unique table name cannot be determined for file, file omitted.","W",,,filen)
	If err=4 d log2("Cannot Create Index Map Row ID.","E")
	If err=5 d log2("Cannot Create Post-Insert Trigger For Non-Regular Index.","E")
	If err=6 d log2("Cannot Create Post-Update Trigger For Non-Regular Index.","E")
	If +err=7 d log2("File #"_filen_", Field #.01, cannot determine datatype for NAME field (field characteristics: "_$p(err,$c(1),2)_"), file omitted","E",,,filen)
	If err=8 d log2("File #"_filen_", Field #(s)"_$e(fids,2,$l(fids))_", Cross Reference #"_crid_"; Cannot create indices for omitted field(s).","W",,,filen)
	If +err=9 d log2("Cannot Create Indices For $E(field) expressions: "_$p(err,$c(1),2)_".","W")
	If err=10 d log2("File #"_filen_", Field #.01, does not exist","E",,,filen)
	If err=12 d log2("File #"_filen_", Field #(s)"_$e(fids,2,$l(fids))_", Cross Reference #"_crid_"; Cannot create indices for omitted field(s).","W",,,filen)
	If err=16 d log2("File #"_filen_", Name"_$$getFileName(filen)_", File name cannot be mapped to table name, file omitted.","W",,,filen)
	QUIT err
}
.
.
swap(x) [] PUBLIC {
		#; swap every {###} not within quotes for DA(#)
	s pz=1,sub=0
swapexp s a=$p(x,"{",1,pz),b=$p(x,"{",pz+1,999) QUIT:b="" x 
	s field=$p(b,"}"),b=$p(b,"}",2,999)
		#; if {} within quotes or contents not a field skip it 
	If $l(a,"""")#2=0 { s pz=pz+1 g swapexp } s sub=sub+1,x=a_"DA("_sub_")"_b g swapexp
}
.
.
makenode(filen,stuff,fldnm,fid,gloref,icol) [] PUBLIC {
		#; Establish Computed Field For Node That Fixed Length
		#; Fields Are Extracted From
		#;
		#; Input  - gloref = global reference for computed field
		#; Output - fldnm  = name of newly created field
	s fldnm="NODE_"_$p($p(stuff,"^",4),";",1)
	s fldnm=$$ddfield(fldnm,filen,fid)
	s desc="Computed Field For Node "_$p($p(stuff,"^",4),";",1)	// Description
	s type="%Library.String"
	s TypeParam=$lb($lb("MAXLEN",255),$lb("COLLATION","EXACT"),$lb("TRUNCATE",0))
	s SQLComputed=1 ; CompField
	s Calculated=1 ; ComEqualValue
	s SQLComputedCode=$lb("s {"_$$quoter2(fldnm)_"}=$g("_$$fixglref^%fm2class2(filen,gloref)_")")
	s ^IRIS.TempFM($j,filen,"f",$$$UPPER(fldnm))=$lb(fldnm,desc,type,0,255,"Exact",$g(SQLComputed),$g(Calculated),$g(SQLComputedCode),,,,,TypeParam,$i(icol),0,,,,)
	s ^IRIS.TempFMI($j,"fid",filen,fid)=$lb(fldnm,desc,+$g(SQLComputed)+$g(Calculated),0,icol)
	QUIT fldnm
}
 
 
	/*
index(filen,tabname,err) [errmsg] PUBLIC {
	new errmsg
		#; CREATE CROSS REFERENCE INDEXES
	set err=0,fid=.0099 ; DPV1723 = New ixname,mapindex,skipit
iloop	set fid=$o(^DD(filen,fid)) quit:+fid=0
	goto iloop:'$d(^DD(filen,fid,1))
	do indexit(filen,tabname,fid,.err) do:err error set err=0
	goto iloop
}
	*/
.
indexit(filen,filensub,tabname,fid,mastergloref,&err) [errmsg] {	// THE MEAT OF THE MATTER
		#; Check if field has a sub-file: if so, don't look for indices
		#; error trapping without exiting
	if $p($g(^DD(filen,fid,0)),"^",2)?.1"."1.n.e { set err="" quit }
		#; Don't give any error message for Non-Mapping flds
	if '$d(^IRIS.TempFMI($j,"fid",filensub,fid)) { set err="" quit }
	set ndx=0
nloop	set ndx=$o(^DD(filen,fid,1,ndx)) quit:'ndx
	set crdata=^DD(filen,fid,1,ndx,0)
	set xreftyp=$p(crdata,"^",3)
	//if xreftyp'="","^BULLETIN MESSAGE^FUNCTION^KWIC^MNEMONIC^MULTIPLE^SOUNDEX^TRIGGER^"[("^"_xreftyp_"^") { goto nloop }
	//if $case(xreftyp,"":0,"MUMPS":0,:1) { goto nloop }
	set ixname=$p(crdata,"^",2)
		#; Whether or not we define an index map for a MUMPS cross reference depends on the $$$mapMUMPSCrossReferences setting.  
	if xreftyp="MUMPS" {
		if '$$$mapMUMPSCrossReferences {	// 0 means no MUMPS xref index maps
			do log2("File #"_filen_", Field #"_fid_", Index #"_ndx_" ("_ixname_"); Because setting mapMUMPSCrossReferences="_$$$mapMUMPSCrossReferences_", cannot create indices for "_xreftyp_" cross reference because there is no gaurantee the index is fully populated","W",,,filen)
			goto nloop
		} elseif $$$mapMUMPSCrossReferences=1,$e(ixname)="A" { 	// "A"* cross references are sorting only and should not be used for lookup
			do log2("File #"_filen_", Field #"_fid_", Index #"_ndx_" ("_ixname_"); Because setting mapMUMPSCrossReferences="_$$$mapMUMPSCrossReferences_", cannot create indices for MUMPS cross reference 'A*' indices as the index may not be fully populated.","W",,,filen)
			goto nloop
		}
	} elseif xreftyp'="" {
		do log2("File #"_filen_", Field #"_fid_", Index #"_ndx_" ("_ixname_"); Cannot create indices for "_xreftyp_" cross reference because there is no gaurantee the index is fully populated","W",,,filen)
		goto nloop
	}
	if $p(crdata,"^")="" { set err=9 do error set err="" goto nloop } ; invalid ndx spec.
	// this was only needed in the old %fm2cache mapper if we were IRIS was handling the filing // i $p(^DD(filen,fid,1,ndx,0),"^")'=filen g nloop	// index for another file?
	/*
	if xreftyp="MUMPS",$e(ixname)="A" { 	// "A"* cross references are sorting only and should not be used for lookup
		do log2("File #"_filen_", Field #"_fid_", Index #"_ndx_" ("_ixname_"); Cannot create indices for MUMPS cross reference 'A*' indices.","W",,,filen)
		goto nloop
	}
	set mapped=0,j=0
jloop	set j=$o(^DD(filen,fid,1,ndx,j))
	goto:j="" nloop
	if +j'=j { break  goto jloop }
	set mapped=0
	*/
	set code=$g(^DD(filen,fid,1,ndx,1))
	if code="" { goto nloop }
	/*
	i xreftyp="KWIC" s code="S ^"_$p(code,"S ^",2) f k=1:1:$l(code,",") i $p(code,",",k)="I" s $p(code,",",k)="X"
	i xreftyp="MNEMONIC" break  s code=$p(code," "),code="S "_$p(code,"$D(",2),code=$e(code,1,$l(code)-1)_"="""""
	i xreftyp="MULTIPLE",code'["S ^" g nloop
	i xreftyp="MULTIPLE" d  g:skipit nloop g dmap
	. s skipit=0  ; DPV1723= ; Flag indicates index already created for this multiple cross reference on another field
	. s fldrefs=$p(^DD(filen,fid,1,ndx,0),"^",6)
	. i $d(mapindex(fldrefs)) s skipit=1 q  ; DPV1723 skip index if already defined from another field
	. s mapindex(fldrefs)=""                ; DPV1723 record the index to avoid duplicates
	. s (code,ocode)="S ^"_$p(code,"S ^",2)
	. f k=1:1:$l(code,",") q:$p(code,",",k)?1"Y"1n
	. s code=$p(code,",",1,k-1)_")="""""
	. d lexanC^%fm2class2(code,.glo,.level)
	. s ocode=$p(ocode,",",k,99)
	. s l=1 
	.  ; If this field is the first field in the index, bump the fldrefs marker
	. s:code["$E(X"&($p(fldrefs,",",l+1)=fid) l=l+2
	. f k=1:1 q:$p(ocode,",",k)="DA)="""""  d  q:skipit  
	.. i $p(ocode,",",k)="$E(X" s level=level+1 s level(level)=$p(ocode,",",k,k+$l($p($p(ocode,"$E(X",2),")"),",")-1),k=k+$l($p($p(ocode,"$E(X",2),")"),",")-1,l=l+$l($p($p(ocode,"$E(X",2),")"),",")-1 q
	.. s fmfile=$p(fldrefs,",",l),l=l+1,fmfld=$p(fldrefs,",",l),l=l+1
	.. set:fmfile=filen fmfile=filensub	// in case it is in an overflow class
	.. ; if fmfile or fmfld is NULL, there was most likely something in the index code other than the global set (DPV 11/15/2004)
	.. i fmfile=""||(fmfld="") s skipit=2 q
	.. ; if field has not yet been linked, define it as a trigger.  It must be index of a field in another file.
	.. i '$d(^IRIS.TempFMI($j,"fid",fmfile,fmfld)) s skipit=2 q  
	.. s level=level+1,level(level)="{"_$lg(^IRIS.TempFMI($j,"fid",fmfile,fmfld))_"}"
	. s level=level+1,level(level)="DA"
	. s j=99 ;To stop the code from looking at the rest of the mul code
		#; Not setting an index node in the following 2 conditions
	*/
	if $e(code,1,3)'="S ^"||($e(code,*-2,*)'="=""""") { 
		do log2("File #"_filen_", Field #"_fid_", Cross Reference #"_ndx_" ("_ixname_"); Cannot create index map for cross reference when logic to SET is not a simple S ^GLO(...)="""", code='"_code_"'.","W",,,filen)
		goto nloop
	}
	do lexanC^%fm2class2(code,.glo,.level)
	
dmap	
		#; create index map
	s gloref="^"_$$$extendedMapping_glo
	s fldnm=$lg(^IRIS.TempFMI($j,"fid",filensub,fid),1)
	//s mapname="index"_$g(ixname),mapname=$e(fldnm,1,26-$l(mapname))_mapname
	set mapname=ixname_"CrossReference"
	s ^IRIS.TempFM($j,filensub,"m",$$$UPPER(mapname))=$lb(mapname,$p(gloref,"("),"N")
 
		#; create index map subs
	s fields(1)=fid
	do IndexMapSubs(filensub,tabname,.fields,mapname,.level,mastergloref,.err) if err { do delmap(filensub,mapname),error set err="" goto nloop }
	
		#;  If we can't generate MapRowIDSpecs for this map, it can't be indexed.  Use a trigger
	s physical=$lg(^IRIS.TempFM($j,filensub),7)
	If physical'="" {
		s ok="" f i=1:1:$ll(physical) s ok=$$FindFieldInMap(filensub,$$$UPPER(mapname),$lg(physical,i)) q:ok=""
		i ok="" {
				#;  Won't be able to generate good map rowid specs at class compilation time, so delete index map
			k ^IRIS.TempFM($j,filensub,"m",$$$UPPER(mapname))
			g nloop
		}
	}
	
	s mapped=1
	g nloop
 
error 	If err=1 d log2("Cannot Create Index Map.","E")
	If err=2 d log2("File #"_filen_", Field #"_fid_", Index #"_ndx_"; Cannot create index map subscripts, index omitted","W",,,filen)
	If +err=3 d log2("File #"_filen_", Field #"_fid_", Index #"_ndx_"; Invalid FileMan index, Map Subscript for '"_$p(err,$c(1),2)_"' not supported, omitting index.","W",,,filen)
	If err=4 d log2("Cannot Create Index Map Row ID.","E")
	If err=5 d log2("Cannot Create Post-Insert Trigger For Non-Regular Index.","E")
	If err=6 d log2("Cannot Create Post-Update Trigger For Non-Regular Index.","E")
	If err=7 d log2("Cannot Create Post-Delete Trigger For Non-Regular Index.","E")
	If err=8 d log2("File #"_filen_", Field #"_fid_", Cross Reference #"_ndx_"; Cannot create index map for omitted field.","W",,,filen)
	If err=9 d log2("File #"_filen_", Field #"_fid_", Cross Reference #"_ndx_"; Omitting index, no File Number defined for Cross Reference","W",,,filen)
	QUIT
}
 
 
crossReferences(filen,tabname,mastergloref,&err) [errmsg] PUBLIC {
	new errmsg
		#; CREATE NEW STYLE CROSS REFERENCE INDEXES
	set err=0,crid=""
iloop	set crid=$o(^DD("IX","B",filen,crid)) QUIT:crid=""
	kill d0
	goto iloop:'$d(^DD("IX",crid,0),d0)	// Main index node not defined
	set ixname=$p(d0,"^",2)
	if ($p(d0,"^",4)'="R") {                // Not a regular index
		//do log2("File #"_filen_", Index #"_crid_" ("_ixname_"); Cannot create index map for index that is not a regular index (type is '"_$p(d0,"^",4)_"')	.","W",,,filen)
		goto iloop
	}
	if ($p(d0,"^",9)'=filen) {	// Root file not this file
		do log2("File #"_filen_", Index #"_crid_" ("_ixname_"); Cannot create index map for index whose root file is not this file ("_$p(d0,"^",9)_").","W",,,filen)
		goto iloop
	}
	if $g(^DD("IX",crid,1.3))'="" {		// SET CONDITION defined for this cross references
		do log2("File #"_filen_", Index #"_crid_" ("_ixname_"); Cannot create index map for index that uses SET CONDITION logic.","W",,,filen)
		goto iloop
	}
	if $g(^DD("IX",crid,1.4))'="" { 	// SET CONDITION CODE defined for this cross references
		do log2("File #"_filen_", Index #"_crid_" ("_ixname_"); Cannot create index map for index that has SET CONDITION CODE defined.","W",,,filen)
		goto iloop
	}
	if $g(^DD("IX",crid,2.3))'="" {		// KILL CONDITION defined for this cross references
		do log2("File #"_filen_", Index #"_crid_" ("_ixname_"); Cannot create index map for index that uses KILL CONDITION logic.","W",,,filen)
		goto iloop
	}
	if $g(^DD("IX",crid,2.4))'="" {		// KILL CONDITION CODE defined for this cross references
		do log2("File #"_filen_", Index #"_crid_" ("_ixname_"); Cannot create index map for index that has KILL CONDITION CODE defined.","W",,,filen)
		goto iloop
	}
		// see if there are any Index subscripts with TRANSFORM ON STORAGE logic.  If so, don't map the index
	set ok=1,ordnum=0
	for {
		set ordnum=$o(^DD("IX",crid,11.1,ordnum)) quit:'ordnum
		if $g(^DD("IX",crid,11.1,ordnum,2))'="" { set ok=0 quit }	// TRANSFORM ON STORAGE found
	}
	if 'ok {
		do log2("File #"_filen_", Index #"_crid_" ("_ixname_"); Cannot create index map for index that uses TRANSFORM ON STORAGE logic.","W",,,filen)
		goto iloop
	}
	do doit
	goto iloop
 
doit	// THE MEAT OF THE MATTER
	set j=0,code=$g(^DD("IX",crid,1))
	/*
	if $e(ixname)="A" { 	// "A"* cross references are sorting only and should not be used for lookup
		break
		do log2("File #"_filen_", Cross Reference #"_crid_" ("_ixname_"); Cannot create indices for cross references that are type 'A' indexes.","W",,,filen)
		QUIT
	}
	*/
	if $e(code,1,3)'="S ^"||($e(code,*-2,*)'="=""""") {
		do log2("File #"_filen_", Index #"_crid_" ("_ixname_"); Cannot create index map for index where logic to SET is not a simple S ^GLO(...)="""".  code='"_code_"'.","W",,,filen)
		QUIT
	}
	do lexanC^%fm2class2(code,.glo,.level)
.
dmap	// create index map
	set gloref="^"_$$$extendedMapping_glo
		#; Build fields() fields(ORDER_NUMBER)=FIELD_ID  ORDER_NUMBER cooresponds with X(ORDER_NUMBER)
	set allFields=1,crsub=0,fids=""
	for  {
		set crsub=$o(^DD("IX",crid,11.1,crsub)) quit:'crsub
		set data=$g(^DD("IX",crid,11.1,crsub,0))
		if $p(data,"^",2)'="F" { set allFields=0 q  }
		set fields(+data)=$p(data,"^",4),fids=fids_","_$p(data,"^",4)
	}
	QUIT:'allFields
	set mapname=ixname_"NewStyleCrossReference"
	set ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname))=$lb(mapname,$p(gloref,"("),"N")
 
		#; create index map subs
	do IndexMapSubs(filen,tabname,.fields,mapname,.level,mastergloref,.err) i err d delmap(filen,mapname) d error s err="" QUIT
	
		#;  If we can't generate MapRowIDSpecs for this map, it can't be indexed.  Use a trigger
	set physical=$lg(^IRIS.TempFM($j,filen),7)
	if physical'="" {
		s ok="" f i=1:1:$ll(physical) s ok=$$FindFieldInMap(filen,$$$UPPER(mapname),$lg(physical,i)) q:ok=""
		i ok="" {
				#;  Won't be able to generate good map rowid specs at class compilation time, so delete index map
			k ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname))
			q
		}
	}
	
	set mapped=1
	QUIT
 
error 	If err=1 d log2("Cannot Create Index Map.","E")
	If err=2 d log2("File #"_filen_", Field #(s)"_$e(fids,2,$l(fids))_", Index #"_crid_" ("_ixname_"); Cannot create Index Map Subscripts, omitting index mapping","W",,,filen)
	If +err=3 d log2("File #"_filen_", Field #(s)"_$e(fids,2,$l(fids))_", Index #"_crid_" ("_ixname_"); Invalid index, Map Subscript for '"_$p(err,$c(1),2)_"' not supported, omitting index mapping","W",,,filen)
	If err=4 d log2("Cannot Create Index Map Row ID.","E")
	If err=5 d log2("Cannot Create Post-Insert Trigger For Non-Regular Index.","E")
	If err=6 d log2("Cannot Create Post-Update Trigger For Non-Regular Index.","E")
	If err=7 d log2("Cannot Create Post-Delete Trigger For Non-Regular Index.","E")
	If err=8 d log2("File #"_filen_", Field #(s)"_$e(fids,2,$l(fids))_", Index #"_crid_" ("_ixname_"); Cannot create indices for omitted field(s), omitting index mapping","W",,,filen)
	If +err=9 d log2("Cannot Create Indices For $E(field) expressions: "_$p(err,$c(1),2)_".","W")
	QUIT
}
 
 
FindFieldInMap(filen,MAPNAME,field) [] PRIVATE {
	s ilev="",val=""
	For  {
		s ilev=$o(^IRIS.TempFM($j,filen,"m",MAPNAME,"s",ilev),1,data) q:ilev=""
		If $lg(data)=field s val="{L"_ilev_"}" q
	}
	QUIT val
}
.
.
delmap(filen,mapname) [] { k ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname)) q  }
.
.
IndexMapSubs(filen,tabname,fields,mapname,level,mastergloref,&err) [] {
		#; Create Index Map Subscripts
	s ilev=-1
	s tinfo=$g(^IRIS.TempFM($j,filen))
	If $lg(tinfo,7)="" { 
		s rowsubs=$lg(tinfo,9),maxsubs=1 
		s list(0)=rowsubs
	} 
	Else { 
		s rowsubs=$lg(tinfo,7),maxsubs=$ll(rowsubs)
		f ilev=0:1:maxsubs-1 s list(ilev)=$lg(rowsubs,maxsubs-ilev)
	}
	If rowsubs="" s err=2 q
	i $g(fields(1))="" s err=8 QUIT
	s fldnm=$lg($g(^IRIS.TempFMI($j,"fid",filen,fields(1))),1)
	i fldnm="" s err=8 QUIT
	s maxlen=$lg($g(^IRIS.TempFM($j,filen,"f",$$$UPPER(fldnm))),5)
	if 'maxlen,$d(^IRIS.TempFMI($j,"desref",$lg(tinfo),fldnm),refinfo) {	// if no maxlen and this is a reference
		s maxlen=20	// Use a maxlen of 20 since I don't think the IEN counter field in the referenced file can be bigger than 20
	}
	s nlev=0,DAargs=""
levloop s nlev=$o(level(nlev)) q:nlev=""  
	s subi=level(nlev),fieldname="",Subscript="",invcond="",nextsub="",extractLen=0
	if subi["$E(X(" { s subi=$$extchk2^%fm2class2(subi,filen,.fields,"$E(X(",.err,.extractLen) q:err }
	if subi["X("    { s subi=$$trxtofname2(filen,subi,.fields,.err) q:err }
	if subi["$E(X,",maxlen { s subi=$$extchk^%fm2class2(subi,maxlen,.extractLen) }
	if subi["X"     { s subi=$$trxtofname(subi,fldnm) }
	if subi=+subi||(($e(subi)="""")&&(($e(subi,*)=""""))) {	// LITERAL SUBSCRIPT
		s Subscript=subi		// Subscript
	}
	ElseIf subi[("{"_$$quoter2(fldnm)_"}") {		// expression with '{fieldname}'
		s fieldname=fldnm
		s Subscript=subi
		If subi?1"$E({"1.e1"}".e { 
			if subi?1"$E({"1.e1"},1,"1.n1")" { 
				set extractLen=$p($p(subi,",1,",2),"}",1)
				set Subscript="$$TRUNCATE({"_$p($p(subi,"{",2,999),"}")_"},"_extractLen_")"
				set %truncate(fieldname,extractLen)=""
			}
			set $li(^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname)),4)="conditional"
			set $li(^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname)),5)="{"_$p($p(subi,"{",2),"}")_"}'="""""
		}
	}
	ElseIf subi?1"DA".e {  ; ALL OTHER DA* VARIABLE SUBSCRIPTS
		if subi="DA" { set subi="DA(0)" }
		elseif $e(subi,1,3)="DA_" { set subi="DA(0)_"_$e(subi,4,$l(subi)) }
		set slev=$p($p(subi,"(",2),")",1)
		if '$d(list(slev)) { set err=3_$c(1)_subi quit }
		set fieldname=list(slev)		// Fieldname
		set Subscript="{"_list(slev)_"}" 	// Subscript
		set DAargs="{L"_nlev_"}"_$e(",",DAargs'="")_DAargs
		if subi="DA(0)",$$$wholeFileScreen { set fileScreenCode=$g(^DD(filen,0,"SCR")) } // Only look for whole file screen for this file, not parent files
		else { set fileScreenCode="" }
		set invcond=$lb("{L"_nlev_"}'>0")	// SpecInvalCondOver (counter)
		// Don't need this is not file screen   set nextsub=$lb("set:{L"_nlev_"}="""" {L"_nlev_"}=0 set {L"_nlev_"}=$o(^({L"_nlev_"})) set:'{L"_nlev_"} {L"_nlev_"}=""""",";PREV","set:{L"_nlev_"}="""" {L"_nlev_"}=$c(0) set {L"_nlev_"}=$o(^({L"_nlev_"}),-1) set:'{L"_nlev_"} {L"_nlev_"}=""""")
			#; Handle any whole file screen conditions
		if fileScreenCode'="" {
			if fileScreenCode["X" {	// might need 01 field (NAME) value
				set namefielddata=$g(^DD(filen,.01,0))
				if namefielddata'="" {
					set node=$p($p(namefielddata,"^",4),";",1)
					set piece=$p($p(namefielddata,"^",4),";",2)
					set namefieldref="$p("_mastergloref_"DA,"_node_"),""^"","_piece_")"
					if namefieldref[$c(1) {	// Fill in DA() references
						for i=$l(namefieldref,$c(1))-1:-1:1 {
							set namefieldref=$p(namefieldref,$c(1),1)_"DA("_i_")"_$p(namefieldref,$c(1),2,*)
						}
					}
				}
			} else { set namefieldref="" }
			set invcond=invcond_$lb("'$$SCR^%fm2class4({L"_nlev_"},"_$$quoter(namefieldref)_","_$$quoter(fileScreenCode)_$e(",",DAargs'="")_DAargs_")")
				// NEXT logic
			set nextsub=$lb("set:{L"_nlev_"}="""" {L"_nlev_"}=0 set {L"_nlev_"}=$o(^({L"_nlev_"})) if '{L"_nlev_"} set {L"_nlev_"}="""" quit")
			set nextsub=nextsub_$lb("goto:'$$SCR^%fm2class4({L"_nlev_"},"_$$quoter(namefieldref)_","_$$quoter(fileScreenCode)_$e(",",DAargs'="")_DAargs_") NEXT")
				// PREV logic
			set nextsub=nextsub_$lb(";PREV","set:{L"_nlev_"}="""" {L"_nlev_"}=$c(0) set {L"_nlev_"}=$o(^({L"_nlev_"}),-1) if '{L"_nlev_"} set {L"_nlev_"}="""" quit")
			set nextsub=nextsub_$lb("goto:'$$SCR^%fm2class4({L"_nlev_"},"_$$quoter(namefieldref)_","_$$quoter(fileScreenCode)_$e(",",DAargs'="")_DAargs_") PREV")
		}
	}
	ElseIf +subi'=subi,'($l($p(subi," "),"""""")#2) {	// assume a variable
		s:$e(subi)'="$" subi="$g("_subi_")" 	// DPV 11/15/2002= Make sure it is not an expression before adding $Get
		s Subscript=subi			// Subscript
	}
	ElseIf subi?1"{"1.e1"}" { s Subscript=subi }
	ElseIf subi?1"$E({"1.e1"}".e { 
		if subi?1"$E({"1.e1"},1,"1.n1")" {
			set extractLen=$p($p(subi,",1,",2),"}",1)
			set Subscript="$$TRUNCATE({"_$p($p(subi,"{",2,999),"}")_"},"_extractLen_")"
			set %truncate($p($p(subi,"{",2,999),"}"),extractLen)=""
		}
		else { set Subscript=subi }
	}
	//ElseIf $e(subi,1,3)="$E(" { b  s err=9_$c(1)_subi q  }	// Don't create index when subscript expression has $Extract
	elseif subi="DUZ(9)"||(subi?1"+$G(".e.1")") { 
		/* Alow DUZ(9) or +$G(...) as map subscript.  Assume they have it defined in init code */
		set Subscript=subi
	}
	else { set err=3_$c(1)_subi q  }
	set ^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"s",nlev)=$lb(fieldname,Subscript,invcond,nextsub)
	goto levloop
}
 
 
trxtofname(x,fieldname) [] {
		#; translate string containing 'X' to '{fieldname}'
	s inst=1
	f  s p1=$p(x,"X",1,inst) q:p1=x  s p2=$p(x,"X",inst+1,*) d
	. i '($l(p1,"""")#2) s inst=inst+1 q  ; in quotes
	. i '($l(p1,"{")#2) s inst=inst+1 q  ; in a {FieldName}
	. i p1'="",$e(p1,$l(p1))'?1p s inst=inst+1 q  ; X not a variable
	. i p2'="",$e(p2)'?1p s inst=inst+1 q  ; X not a variable
	. s x=p1_"{"_$$quoter2(fieldname)_"}"_p2
	QUIT x
}
.
 
trxtofname2(filen,x,fields,err) [] {
		#; translate string containing 'X(FIELD_ORDER)' to '{fieldname}'
	set inst=1
	for  {
		set p1=$p(x,"X(",1,inst) quit:p1=x  
		set p2=$p(x,"X(",inst+1,*)
		set fieldOrder=+p2
		set p2=$p(p2,")",2,*)
		if '($l(p1,"""")#2) { set inst=inst+1 continue }  ; in quotes
		set fid=$g(fields(fieldOrder))
		if fid="" { set inst=inst+1 continue }
		set fieldname=$lg($g(^IRIS.TempFMI($j,"fid",filen,fid)),1)
		if fieldname="" { set err=8 quit }
		if p1'="",$e(p1,$l(p1))'?1p { set inst=inst+1 continue }  ; X not a variable
		if p2'="",$e(p2)'?1p { set inst=inst+1 continue }  ; X not a variable
		set x=p1_"{"_$$quoter2(fieldname)_"}"_p2
	}
	QUIT x
}
 
 
ChildTable(partabname,parfil,fldfid,clevel,btabnm,topfile,wp,pfilensub) [] {
		#; Create Child Table From FileMan File
		#; Called as extrinsic function
		#; Input Parameters - partabname = name of parent table
		#;                    parfil = File # Of FileMan Parent File
		#;                    fldfid = fid of multi-answer field
		#;                    clevel = Child Level
		#;                    btabnm = optional var to pass back new child table name
		#; Returns          - 0 = success, >0 = error code
		#;                    btabnm = name of new table (passed by ref)
		#;
		#; Global variables used in pgm:
		#; filen = FileMan File# For Sub-Field/Multi-Line Field
		#; tabirn = row id of base table
		#; btabnm = base table name
		#; rowifn = ifn of row id field
		#; childifn = ifn of childsub field
		#; mapid  = row id of master map
		#; parprof = sub-field profile from parent table
		#; topfil = file # of top level file
		#; wp      = 1/0 if this is a word processing field child table
 
	s parprof=^DD(parfil,fldfid,0)
	s filen=+$p(parprof,"^",2)
	d log2("Analyzing Sub-File/Multiple "_filen_" ("_$$getFileName(filen)_")","M",clevel*3,1)
	s err=0
	d CreateChildTable(filen,filen,parfil,partabname,parprof,$$getFileName(parfil),wp,.btabnm,.err,,pfilensub) if err { goto error }
	d CreatePCRelationship(parfil,filen,partabname,btabnm,wp,.parrefname,pfilensub,filen)
	s mapname=$$map(filen,btabnm,.gloref,topfile)
	d MapSubsChild^%fm2class2(pfilensub,filen,btabnm,mapname,.gloref,parprof,.level,.err) i err g error
		#;  If this is a word-processing or sub-file child table and we are usng the FileMan Filer,
		#;  Just set the IEN to the constant -999.  This is so FileMan filer bumps the appropriate counter
		#;  node and the rest ofthe fields in the counter node are set properly.
		#;  It does mean the IEN and RowID value of this row are probably not correct until the Fileman
		#;  Filer is called in the BEFORE INSERT trigger.
	s IENDefault=-999
		#;Else { s IENDefault=$$nextdef(filen,mapname,.err) }
	If err { d log2("Can't Generate Default Value For IEN field. No Inserts Allowed."_$s(SQLCODE:" - SQLCODE="_SQLCODE,1:""),"W",,,filen) s err=0 }
	Else { 
		set tIENName=$lg(^IRIS.TempFM($j,filen),12)
		s $li(^IRIS.TempFM($j,filen,"f",tIENName),17)=IENDefault
	}
	new %truncate
	do fields(filen,btabnm,mapname,+clevel,topfile,gloref,1,parfil,fldfid,pfilensub,wp,partabname,.icol)
	if $$$defineVASITE { set icol=icol+1 do addVASITEField(filen,icol) }
	//d index(filen,btabnm,.err) i err QUIT 0
	if $d(%truncate) {
			#; Here we will see if any fields are indexed with $$TRUNCATE(field,length).  If so, define the collation
			#; of the field to be TRUNCATE(len) where len is the maximum length used in the truncation.
			#; We only do this for %String fields
		set field=""
		for  {
			set field=$o(%truncate(field)) q:field=""
			set fdata=$g(^IRIS.TempFM($j,filen,"f",field))
			continue:fdata=""	//???
			continue:$case($lg(fdata,3),"%Library.String":0,"%Library.EnumString":0,:1)	// Not a string
			set length=$o(%truncate(field,""),-1)
			if $$$UPPER($lg(fdata,6))="EXACT" set $li(^IRIS.TempFM($j,filen,"f",field),6)="TRUNCATE("_length_")"
			set params=$lg(fdata,14)
			set cp=$listfind(params,$LB("COLLATION","EXACT"))
			if cp { set $li(params,cp)=$lb("COLLATION","TRUNCATE("_length_")") }
			else { set params=params_$lb($lb("COLLATION","TRUNCATE("_length_")")) }
			set $li(^IRIS.TempFM($j,filen,"f",field),14)=params
		}
	}
	d crossReferences(filen,btabnm,gloref,.err) i err QUIT 0  	// new-style cross references
	If '$$$readonly {
		If wp { d CreateFMFilingTriggers^%fm2class2(filen,gloref,2,parrefname,parfil,fldfid) }
		Else  { d CreateFMFilingTriggers^%fm2class2(filen,gloref,1,parrefname) }
		
	}
	#;d log2("Child Table '"_btabnm_"' queued for creation","M",clevel*3)
	s %fmQueueCount=%fmQueueCount+1
	QUIT 1 ; success
 
error 	If err=1 {
		set message="File #"_parfil_", Field #"_fldfid_"; More than one multiples fields are using the same Sub-File.  Field omitted."
			#; Log which multiples fields reference the sam Sub-File
		set message=message_$$$NL_"    The following fields are multiples using the same subfile:"
		set file=0
		for  {
			set file=$o(^DD(file)) quit:'file
			set fid=0
			for  {
				set fid=$o(^DD(file,fid)) quit:'fid
				set stuff=$g(^DD(file,fid,0)) continue:stuff=""
				if +$p(stuff,"^",2)=filen { set message=message_$$$NL_"      File #"_file_", Field #"_fid_" ("_$p(stuff,"^",1)_") is a Multiple that is using Sub-File #"_filen_" ("_$p($g(^DD(filen,0)),"^",1)_")" }
			}
		}
		do log2(message,"E",,1,parfil)
			
	}
	If err=3 d log2("File #"_parfil_"; cannot obtain a unique name for this file. File omitted.","W",,,parfil)
	If err=7 d log2("File #"_filen_"; NAME field has unsupported data type. Sub-File/Multiple omitted.","W",,,filen)
	If err=17 d log2("File #"_parfil_", field #"_fldfid_"; Error creating Map Subscripts for child table.  No master map of parent table found.  Field Omitted.","E",,,parfil)
	QUIT 0
}
 
.
CreateChildTable(filen,filensub,parfil,ParentTableName,parprof,parentFileName,wp,btabnm,err,tabname="",pfilensub) [] {
		#; create child base table
	if $d(^IRIS.TempFMI($j,"fm",filensub)) { set err=1 QUIT }
	if tabname="" {
		set btabnm=$$getTableName($p(parprof,"^"),filen,1,parfil,parentFileName)
		if "*"[btabnm { set err=$s(btabnm="":3,1:18) QUIT }
	}
	else { set btabnm=tabname }
	s datype=$$datype^%fm2class2($p($g(^DD(filen,.01,0)),"^",2))
	i datype="" s err=7 QUIT  ; unsupp. datatype for 'Name' field
	i 'wp { s desc="Generated class for FileMan Sub-File/Multiple Number: '"_filen_"'  Sub-File/Multiple Name: '"_$$getFileName(filen)_"'   Class generated by %fm2class version "_$$GetVersion() }
	i wp  { s desc="Generated class for FileMan Word Processing Field: '"_filen_"'  Name: '"_$$getFileName(filen)_"'   Class generated by %fm2class version "_$$GetVersion() }
	s parphys=$lg(^IRIS.TempFM($j,pfilensub),7)
	set tIENName=$$$ienFieldName
	set:tIENName["<TABLENAME>" tIENName=$$strrep(tIENName,"<TABLENAME>",btabnm)
	s ^IRIS.TempFM($j,filensub)=$lb(btabnm,desc,$$$owner,,"Y","RowId",parphys_$lb(btabnm_"."_tIENName),$lb(btabnm_"."_ParentTableName,btabnm_"."_tIENName),"RowId",,,tIENName)
	s ^IRIS.TempFMI($j,"rv",$$$UPPER(btabnm))=filensub
	s ^IRIS.TempFMI($j,"fm",filensub)=$lb(tabname,desc)
	QUIT
}
 
 
CreatePCRelationship(pfilen,cfilen,ParentTableName,ChildTableName,wp,ref2parent,pfilensub,cfilensub) [] { 
		#; Create Relationships for Parent/Child
		#; This is the relationship in the parent class
	s ref2child=$$ddfield(ChildTableName,pfilensub,,0)
	s ref2parent=$$ddfield(ParentTableName,cfilensub,,0)
	set tIENName=$lg(^IRIS.TempFM($j,cfilensub),12)
	s ^IRIS.TempFM($j,pfilensub,"f",$$$UPPER(ref2child))=$lb(ref2child,"Relationship for "_$s(wp:"Word-Processing Field",1:"Sub-File/Multiple to file name "_$$getFileName(cfilen))_" child"_$s(cfilensub["OVF":" (overflow class)",1:""),ChildTableName,0,,,,,,,1,"children",ref2parent,,,1)
		#; This is the relationship in the child class (Parent reference field)
	s ^IRIS.TempFM($j,cfilensub,"f",$$$UPPER(ref2parent))=$lb(ref2parent,"Relationship to parent (file name "_$$getFileName(pfilen)_")",ParentTableName,1,,,,,,,1,"parent",ref2child,,,1)
	s ^IRIS.TempFM($j,cfilensub,"f",tIENName)=$lb(tIENName,"Child Counter Field","%Library.String",1,,,,,,,,,,$lb($lb("COLLATION","EXACT"),$lb("TRUNCATE",0)),2,,)
		#; Create child's IENS field, computed off of RowId
	s SQLComputedCode=$lb("Set {*}="""" New i For i=$l({RowId},""||""):-1:1 s {*}={*}_$p({RowId},""||"",i)_"",""")
	s TypeParam=$lb($lb("COLLATION","EXACT"))
	s ^IRIS.TempFM($j,cfilensub,"f",tIENName_"S")=$lb(tIENName_"S","IENS Field","%Library.String",1,,"Exact",1,1,SQLComputedCode,,,,,TypeParam)
		#; Create child's IDKey index
	s ^IRIS.TempFM($j,cfilensub,"i","IDKEYINDEX")=$lb("IDKeyIndex","idkey",$lb(tIENName))
	QUIT
}
 
 
 
#IF 0 
delete(filenum) ; DELETE BASETABLE (& DESCENDENTS) ASSOCIATED WITH FILE
	n ok s ok='$$^%qadldel(filenum) 
	QUIT ok
 
delfld(filen,fid) ; Delete a field from IRIS that is linked to fileman
	n anydata,compil,ifn,nextid,ok
	s ifn=$p($g(^mdd(1,"fmfld",filen,fid)),$c(1),2)
	QUIT:'ifn 0
	s ok=$$field^%qadlfdl(ifn,"","DX")
	i ok d addlist(filen)
	QUIT ok
 
update(filen,updatex,topfil) ; update a file
	n SQLCODE,anydata,compil,da12,err,fid,flevl,ifn,irn,mapid,nextid,nocon
	n ok,okany,oper,stuff,tabirn
	d basic q:'ok 0
		#; rename table if has to be renamed and set number of rows
	d rename^%qadltb(filen,tabirn),setrow^%qcrsapi(tabirn_"|500000")
		#; First delete deleted subfiles
	f ok=1:1 s fid=$p($g(^mdd(1,tabirn,21)),"_",ok) q:'fid  d
	. s fid=$p($g(^mdd(1,fid,34)),$c(1))
	. i fid,'$d(^DD(fid)) s fid=$$delete(fid) ; delete deleted sub-files
	s fid=.000099,okany=0
	f  s fid=$o(^DD(filen,fid)) q:+fid=0  d
	. ; delete deleted fields
	. f  s ifn=$o(^mdd(1,"fmfld",filen,fid),-1) q:'ifn  q:$d(^DD(filen,ifn,0))  s ok=$$delfld(filen,ifn)
	. s stuff=$p($g(^DD(filen,fid,0)),"^",2),oper="update"
	. i stuff?.n.1"."1.n.e s ok=$$updsubf(filen,fid,updatex,topfil,+stuff) i 1
	. e  i '$d(^mdd(1,"fmfld",filen,fid)) s ok=$$addfield(topfil,filen,fid),oper="insert" i 1
	. e  s ok=$$updfld(filen,fid,updatex)
	. i ok s okany=okany+1
	. e  d log2("Couldn't "_oper_" File # "_filen_" field "_fid,"E",,,filen)
	i okany d addlist(filen)
	q okany
 
 
updfld(filen,fid,updatex) ; e.p. to update one field
	n SQLCODE,anydata,compil,da12,err,flevl,irn,mapid,nextid,nocon
	n ok,okany,oper,stuff,tabirn
	d basic q:'ok 0
	i '$d(^mdd(1,"fmfld",filen,fid)) q 0 ; does not exist
	s irn=2,ifn=$p($g(^(fid)),$c(1),2),ok=0
	q:'ifn 0
	s ok=$$field^%qadlfdl(ifn,"","U"_$e("X",updatex)) ; cleanup
	q:'ok 0 s ok=$$updatef^%qadlflu(filen,fid,updatex) q:'ok 0
	i updatex d doit^%qadlnx s ok='(err!SQLCODE)
	i ok d addlist(filen)
	q ok
 
 
updsubf(filen,fid,updatex,topfil,stuff) ; update sub-files
	n ok s stuff=+$g(stuff),fid=+fid
	i $$wordproc^%qadlutl(stuff) s fid=fid_"W" d  g:fid["W" updsubfq
	. i $d(^mdd(1,"fmfld",filen,+fid)) d  q
	. . i $$$wpIsList s ok=$$updfld(filen,+fid,updatex) q
	. . s ok=$$delfld(filen,+fid) i 'ok d log("delete",nextid) q
	. . s ok=$$addfield(topfil,filen,+fid) d:'ok log("insert",nextid)
	. i '$$$wpIsList||($$$wpIsList=2) s fid=+fid q
	. i $d(^IRIS.TempFM($j,stuff)) s ok=$$delete(stuff) i 'ok d log("delete",nextid) q
	. s ok=$$addfield(topfil,filen,+fid) i 'ok d log("insert",nextid)
	i '$d(^IRIS.TempFM($j,stuff)) s ok=$$addfield(topfil,filen,fid) g updsubfq
		#;  update recursively child tables 
	s ok=$$update(stuff,updatex,topfil) 
	d:'ok log("update",nextid)
updsubfq q ok
 
 
updatex(filen) ; update indices for a file
	n SQLCODE,anydata,compil,da12,err,fid,flevl,irn,mapid,nextid,nocon
	n ok,okany,oper,stuff,tabirn
	d basic q:'ok 0
	s fid=.000099,okany=0
	f  s fid=$o(^DD(filen,fid)) q:+fid=0  d 
	. s stuff=$p(^DD(filen,fid,0),"^",2)
		#; no inserting only updating indices
		#;  update indices recursively child tables
	. i stuff?.1"."1.n.e  q:'$d(^IRIS.TempFM($j,+stuff))  s ok=$$updatex(+stuff)
	. e  q:'$d(^mdd(1,"fmfld",filen,fid))  s ok=$$updfldx(filen,fid)
	. i ok s okany=okany+1
	. e  d log2("Couldn't update indices File # "_filen_" field "_fid,"E",,,filen)
	i okany d addlist(filen)
	q okany
 
 
updfldx(filen,fid) ; update indices for a field
	n SQLCODE,anydata,compil,da12,err,flevl,irn,mapid,nextid,nocon
	n ok,okany,oper,stuff,tabirn
	d basic q:'ok 0
	i '$d(^mdd(1,"fmfld",filen,fid)) q 0 ; does not exist
	s irn=2,ifn=$p($g(^(fid)),$c(1),2),ok=0
	q:'ifn 0
	s ok=$$field^%qadlfdl(ifn,"","X") ; cleanup
	q:'ok 0 d doit^%qadlnx s ok='(err!SQLCODE)
	i ok d addlist(filen)
	q ok
#ENDIF 
.
basic ; e.p. to check and set basic info for insert, update and updatex
		; *** fix
	i '$d(^IRIS.TempFM($j,stuff)) s ok=0 q  ; table not linked
	s flevl=1,err="",SQLCODE="",ok=1
	QUIT
 
 
addlist(filen) [] PUBLIC {
		#; add filen to list of irns to be recompiled
	s x=$p(^IRIS.TempFM($j,stuff),$c(1),1),y=$p(^mdd(1,x,1),$c(1),1)
	QUIT
}
.
 
err	d err1 q 0
err1 	s $zt=""
	i +$g(err)=0||($ze'="") d log2("Program Error: "_$ze,"E","",3) d ^%ET s $ze=""
	QUIT
 
error 	s x=$t(errtbl+err),errtyp=$p(x,";;",2),@("errmsg="_$p(x,";;",3))
	if err=12 d log2("Could Not Create Index Map.","W") QUIT err
	d log2(errmsg_$s(SQLCODE:" - SQLCODE="_SQLCODE,1:""),errtyp)
	QUIT err  ; no need to force another error
.
errtbl ; Table Of Error/Warning Messages
	;;W;;"This File Manager File Already Mapped Into A Base Table."
	;;W;;"Dictionary Points To Non-Existent File # "_filen_". File Omitted."
	;;W;;"Cannot Obtain A Unique Name For This File Manager File. File Omitted."
	;;E;;"Cannot Create Base Table."
	;;E;;"Cannot Create Master Map."
	;;E;;"Cannot Create Map Subscripts."
	;;W;;"Name Field Has Unsupported Data Type."
	;;W;;"Field Has Unsupported Data Type. Omitted."
	;;E;;"Cannot Create Base Table Fields."
	;;E;;"Cannot Compile Base Table."
	;;E;;"Could Not Create Child Table."
	;;E;;"Could Not Create Index Map."
	;;E;;"Could Not Create Designated Table."
	;;W;;"Could Not Generate Default Value For New Row."
	;;E;;"Could Not Generate Filing Code For Fixed Length Fields."
	;;W;;"File starts with NON-Mapping Name. File Omitted."
  
log2(msg,typ,tab=0,nl=1,filen=-1) [] PUBLIC {	// Create Error Log Entries and display
		#; tab = tab stop  nl = Number of new lines by default 1
	s $p(x,"!",nl+1)=""
	i typ'="M" {
		i typ="E",$tr(msg,"ero ","ERO")'["ERROR:" s msg="ERROR: "_msg
		i typ="W",$tr(msg,"warnig ","WARNIG")'["WARNING:" s msg="WARNING: "_msg
		if typ="E2" set typ="E"
		s ^IRIS.TempFMI($j,"msgs",typ,filen,$i(^IRIS.TempFMI($j,"msgs",typ)))=msg		// Save to display at end of Queuing, order by file number
	}
	else { $$$output2(msg,nl,tab) }
	QUIT
}
 
.
log(oper,nextid) [] PUBLIC {
		#; update fileman log with approppriate message
	s data=$g(^IRIS.TempFMI($j,"fileman-update",nextid,1))
	s data=""
	if data'="" { s data=$$setext(data) }
	else {
		s data=$p($g(^IRIS.TempFMI($j,"fileman-update",nextid)),$c(1),1)
		s x=$$getFileName(data),data=$s(x'="":"File# "_data_" ("_x_")",1:"File #"_data)
	}
	d log2("Could not "_oper_" "_data,"E")
	QUIT
}
	
	// Display the FM2Class version information
Version() [] PUBLIC {
	w !,"InterSystems Corporation FM2Class utility version '"_$$GetVersion()_"'"
	w !,$SYSTEM.Version.Format(4)
	QUIT $$GetVersion()
}
.
	// Returns the FM2Class version string
GetVersion() [] PUBLIC {
	QUIT $tr($$$FM2SQLVersion,"'")
}
.
quoter(x,QuoteNumbers) PUBLIC { Quit $select(('$get(QuoteNumbers))||(x'=+x):$select(x=$char(0):"$c(0)",1:$zu(144,1,x)),1:""""_x_"""") }
.
quoter2(x,extraquote) PUBLIC { Quit $select(($zname($e(x))||($e(x)="_"))&&($zname($tr("%"_$e(x,2,$l(x)),"_@#$")))&&('($p($g(^%qSQL("reservewords",$zcvt(x,"U"))),$c(1),2)="Y")):x,x=$c(0):"$c(0)",x=+x:""""_x_"""",$g(extraquote):$$quoter3($zu(144,1,x)),1:$zu(144,1,x)) }
.
quoter3(x) PRIVATE { Quit """"_$zu(144,1,$extract(x,2,$l(x)-1))_"""" }
.
strrep(str,replace,with,noquote=0) PUBLIC {
		Set pos=0
loop    Set pos=$find(str,replace,pos) QUIT:'pos str GOTO loop:noquote&&(($L($E(str,1,pos-1),"""")+1#2)) Set str=$extract(str,1,pos-$length(replace)-1)_with_$extract(str,pos,$l(str)),pos=pos+($length(with)-$length(replace)) Goto loop
}
 	QUIT
.
	// Define a datatype to be used as the IEN that will return a unique id value across all VA sites by appending the VASITE number to the IEN value
	// Calling this function will define the datatype class and set the IENType setting to use this class.
	// Returns a %Status code
	// ^VASITE documentation:
	//		w $$SITE^VASITE
	//		17032^WEST PALM BEACH VAMC^548
 	//		
	//		VASITE   ;ALB/AAS - TIME SENSETIVE VA STATION NUMBER UTILITY ; 4/22/92
	//		;;5.3;Registration;**134**;Aug 13, 1993
	//		;
	//		SITE(DATE,DIV) ;
	//		;       -Output= Institution file pointer^Institution name^station number with suffix
	//		;
	//		;       -Input (optional) date for division, if undefined will use DT
	//		;       -      (optional) medical center division=pointer in 40.8
DefineUniqueIDType(classname) [] PUBLIC {
.
	try {
		set sc=$$$OK
		#dim class=##class(%Dictionary.ClassDefinition).%New()
		RETURN:$$$ISERR(class) class
		set class.ClassType="datatype"
		set class.Description="Used by FM2Class.  The datatype to be used for the IEN field to provide unique IDs across sites"
		set class.Name=classname
		set class.Super="%Library.String"
		set class.TimeCreated=$zu(188)
		set class.TimeChanged=$zu(188)
			#; Define LoficalToOdbc method
		#dim l2o=##class(%Dictionary.MethodDefinition).%New()
		RETURN:$$$ISERR(l2o) l2o
		set l2o.Name="LogicalToOdbc"
		set l2o.parent=class
		set l2o.ServerOnly=1
		set l2o.ClassMethod=1
		set l2o.FormalSpec="%val:%String"
		set l2o.ReturnType="%Library.String"
		#dim l2ocode=##class(%Stream.TmpCharacter).%New()
		RETURN:$$$ISERR(l2ocode) l2ocode
		do l2ocode.Write($c(9)_"QUIT:%val="""" """" if '$g(%ISCFM2ClassSVASiteID($namespace)) { new X set X=""NOW"" d ^%DT set DT=Y set %ISCFM2ClassSVASiteID($namespace)=$p($$SITE^VASITE,""^"",3) } QUIT %val_""|""_%ISCFM2ClassSVASiteID($namespace) ")
		set l2o.Implementation=l2ocode
			#; Define LoficalToDisplay method
		#dim l2d=##class(%Dictionary.MethodDefinition).%New()
		RETURN:$$$ISERR(l2d) l2d
		set l2d.Name="LogicalToDisplay"
		set l2d.parent=class
		set l2d.ServerOnly=1
		set l2d.ClassMethod=1
		set l2d.FormalSpec="%val:%String"
		set l2d.ReturnType="%Library.String"
		#dim l2dcode=##class(%Stream.TmpCharacter).%New()
		RETURN:$$$ISERR(l2dcode) l2dcode
		do l2dcode.Write($c(9)_"QUIT:%val="""" """" if '$g(%ISCFM2ClassSVASiteID($namespace)) { new X set X=""NOW"" d ^%DT set DT=Y set %ISCFM2ClassSVASiteID($namespace)=$p($$SITE^VASITE,""^"",3) } QUIT %val_""|""_%ISCFM2ClassSVASiteID($namespace) ")
		set l2d.Implementation=l2dcode
		set sc=class.%Save()
	} catch ex {
		set sc=ex.AsStatus()
	}
	RETURN sc
}
.
---
