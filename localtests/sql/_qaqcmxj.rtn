qaqcmxj
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqcmxj^MAC^^^0
%qaqcmxj	// code generation for non-SELECT statements using jdbc
	;; COMPONENTS :: SQL/CodeGeneration
	#;
#INCLUDE %msql
#IF 0   ;-------------------------------------------------------------
	; Description:   Code generator for ext tables using jdbc
	;
	;  AK878   (05/28/2013) - GWQ: Host variables for new JDBC linked query
	;  AK877   (04/16/2013) - GWQ: Use new generated query text for JDBC
	;  BJB507  (09/06/2011) - new M SQL Module Variables for Non Cursor based SQL Gateway queries
	;  AK762   (12/02/2009) - GWQ: fix overflow lines for long query
	;  BJB394  (09/11/2008) - Linked table query over 4000 char get extra char
	;  BJB486  (05/25/2011) - Move K %JCACHE to make sure the kill is only done when stmt is defined
	;
#ENDIF  ;-------------------------------------------------------------
#define odbcgatewayHandle "%SQLGateway"
 $$$Abort  ;  Not an Entry Point!!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK877
buildhq()  ;  SQL query text for JDBC linked tables (temporary code)
	n dsn,m,idlist,jj,val,datyp,vars,irn,ifn,sets,fn,fnv  ;  AK878
	s dsn=$g($$$mtDSNConnection),m=1
	s prm=""  ;  output prm=$LIST(val) of all parameters
	#;  *** prm must be in order of appearance, otherwise we must fix it!
	QUIT $$buildsubq^%qaqcmh(1)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK877-
.
	// Main entry point from %qaqqt for external table query code generation for ODBC SELECT statements and all JDBC statements.  
	// Non-select JDBC come in from exsel^%qaqcmx
exsel n array,cflag,ctr,datag,disconnectOnClose,ext,qerrt,extb,i,ib,icol,idlist,mod,lines,line,iarr,st,tag,val,vars,jj,param,tagpre,tmp,dt,prec,scale,numpars,uv,killtag,nm,ReverseOJ,dtj,tmpstr,jj,sqlstr,chunksize, bStream, odbcType, uniStream, needLEN,useCAST, useCASTCHAR,sc,connectionName
	n useCOAL,isJDBC,nCONV,dnQ,noconcat,nvl
	set sc=$$getFlags^%apiGTW($g($$$mtDSNConnection),.ReverseOJ,.isJDBC,.useCAST,.dnQ, .nCONV, .useCOAL, .needLEN, .uniStream, .useCASTCHAR,.noconcat,.nvl,,.disconnectOnClose) 
	if 'sc {
		set connectionName=$g($$$mtDSNConnection)
		do error^%qaqperr(162)
		QUIT
	}
.
	//s uv=$$GetUV^%apiGTW()
	set param=0
	set tagpre=gtag,datag=0
	do buildIdlist^%qaqcmx(.idlist) 
	;d open^%qacsub
		#;---------- no need to copy if SQLCODE'=0 ----------
	set cflag=mcurs'=""&'mcurs
	set call=$s(cflag:$$$MSQLModuleTag,1:gtag),call=call_"o^"_$c(1)_call_"f^"_$c(1)_call_"c^"
	set mod=1,lines=0,(line,tag)="",tag=$p($p(call,$c(1),1),"^") ;
	new verr,vsql,vhstmt,vconn,vrind s verr=$$$getVarName("err"),vsql=$$$getVarName("sql"),vhstmt=$$$getVarName("hstmt"),vconn=$$$getVarName("conn"),vrind=$$$getVarName("rind")
	set qerrt=gtag_"qe"
	set killtag=gtag_"kl"
	if ($$$SQLCompileOption("xDBC")=1)&&($case($g($$$mtStatementType),"INS":1,"UPD":1,"DEL":1,:0)) {
		// %qi is row number. Perform connection and prepare statement if it's the first row.
		$$$liin("if %qi=1 {")
	}
	If 'cflag $$$liin($$msqlvars^%qaqcas2(cflag,,"n"))
 	if cflag { set mtc(mcurs,"errtag")=gtag_"err" }
 	else { $$$liin("set $zt="""_gtag_"err""") } //  set error trap
 	$$$liin("s SQLCODE=0,%msg="""","_verr_"=0")
 
	//d liin("s "_vsql_"="_$$buildq^%qaqcmxc())
 	//****************
	#; AK877
	i ($$$mtStatementType="SEL")||($$$mtStatementType="DEC") { n prm s sqlstr=$$buildhq() f param=1:1:$ll(prm) { s param(param)=$e($$$mtV($li(prm,param)),3,*) } s param=$ll(prm) }  ;  AK878
	else {
		s sqlstr=$$buildq^%qaqcmxc()
	}
	s $$$mtSql(1)=sqlstr
	#; AK877-
	s chunksize=2000
	#; AK762
	f jj=1:chunksize:$l(sqlstr) $$$liin("s "_vsql_"="_$s(jj>1:vsql_"_",1:"")_$$quoter($e(sqlstr,jj,jj+chunksize-1)))
	d sqlact^%qaqcmx(.sql,.iarr)
	$$$liin("new status set "_vconn_"=$$GetJConnection^%apiGTW("""_$$$mtDSNConnection_""",,,,.status),"_vhstmt_"=""""")
	$$$liin("if 'status { set "_verr_"=-1,%msg=$$GetErrorText^%apiOBJ(status) goto "_qerrt_ "}")
	$$$liin("if "_vconn_"="""" { set "_verr_"=-1 goto "_qerrt_ "}")
.
		#; If this statement is for the ObjectFiler then search for a suitable entry in the statement cache (DLP2024)
	set classname=$$targetClassName(.mt)
	try {
		if classname'="",$parameter(classname,"EXTERNALGENERATEDKEYS")=0 { set extGeneratedKeys=0 } else { set extGeneratedKeys=1 }  // default is autogeneratedkeys=1, parameter must be defined and =0 if they want no autogenerated keys
	} catch { 
		set extGeneratedKeys=0
	}
	if $Data(%msqlObjectFiler) {
		$$$liin("if $data(%JDBCGateway.StatementCache("_vconn_","""_$li(%msqlObjectFiler,1)_""","""_$li(%msqlObjectFiler,2)_""")) { s "_vhstmt_"=%JDBCGateway.StatementCache("_vconn_","""_$li(%msqlObjectFiler,1)_""","""_$li(%msqlObjectFiler,2)_""") }")
		$$$liin("else { s "_vhstmt_"=%JDBCGateway.prepareStatement("_vconn_","_vsql_"), %JDBCGateway.StatementCache("_vconn_","""_$li(%msqlObjectFiler,1)_""","""_$li(%msqlObjectFiler,2)_""") = "_vhstmt_" }")
	}
	else {
		if ($G($$$mtStatementType)="INS"),'$g(%inssel),extGeneratedKeys {
				// %inssel check above means INSERT...SELECT will not look to return generated keys...
			$$$liin("s "_vhstmt_"=%JDBCGateway.prepareStatementGK("_vconn_","_vsql_") ")  
		}
		elseif (($G($$$mtStatementType)="SEL")||($G($$$mtStatementType)="DEC")||($$$SQLCompileOption("xDBC")'=1)) {
			$$$liin("s "_vhstmt_"=%JDBCGateway.prepareStatement("_vconn_","_vsql_") ")  
		}
		else {
				// ... unless explicitly requested by an xDBC connection
			$$$liin("if '$g(%qsc(%qacn,17)) {")
			$$$liin($c(9)_"s "_vhstmt_"=%JDBCGateway.prepareStatement("_vconn_","_vsql_") ")  
			$$$liin("}")
			$$$liin("else {")
			$$$liin($c(9)_"s "_vhstmt_"=%JDBCGateway.prepareStatementGK("_vconn_","_vsql_") ")  
			$$$liin("}")
		}
	}
	$$$liin("i "_vhstmt_"<0 { ") //reconnect on error
	$$$liin($c(9)_"set %msg=%JDBCGateway.getErrorText()")
	$$$liin($c(9)_"if ##class(%SQLGatewayConnection).IsTextNetworkError(%msg)||%JDBCGateway.Gateway.Closed||%JDBCGateway.Gateway.%LostConnectionCleanup() { ")
	$$$liin($c(9,9)_"kill %JDBCGateway("""_$$$mtDSNConnection_""")")
  	$$$liin($c(9,9)_"set "_vconn_"=$$GetJConnection^%apiGTW("""_$$$mtDSNConnection_""",,,,.status),"_vhstmt_"=""""")
	$$$liin($c(9,9)_"if 'status { set "_verr_"=-1,%msg=$$GetErrorText^%apiOBJ(status) goto "_qerrt_ "}")
	$$$liin($c(9,9)_"if "_vconn_"="""" { set "_verr_"=-1 goto "_qerrt_" }")
		#; If this statement is for the ObjectFiler then search for a suitable entry in the statement cache (DLP2024)
	if $Data(%msqlObjectFiler) {
		$$$liin($c(9,9)_"if $data(%JDBCGateway.StatementCache("_vconn_","""_$li(%msqlObjectFiler,1)_""","""_$li(%msqlObjectFiler,2)_""")) { s "_vhstmt_"=%JDBCGateway.StatementCache("_vconn_","""_$li(%msqlObjectFiler,1)_""","""_$li(%msqlObjectFiler,2)_""") }")
		$$$liin($c(9,9)_"else { set "_vhstmt_"=%JDBCGateway.prepareStatement("_vconn_","_vsql_"), %JDBCGateway.StatementCache("_vconn_","""_$li(%msqlObjectFiler,1)_""","""_$li(%msqlObjectFiler,2)_""") = "_vhstmt_" }")
	}
	else {
		
		if (($G($$$mtStatementType)="SEL")||($G($$$mtStatementType)="DEC")||($$$SQLCompileOption("xDBC")'=1)) {
			$$$liin($c(9,9)_"s "_vhstmt_"=%JDBCGateway.prepareStatement("_vconn_","_vsql_") ")  
		}
		else {
			$$$liin($c(9,9)_"if '$g(%qsc(%qacn,17)) {")
			$$$liin($c(9,9,9)_"s "_vhstmt_"=%JDBCGateway.prepareStatement("_vconn_","_vsql_") ")  
			$$$liin($c(9,9)_"}")
			$$$liin($c(9,9)_"else {")
			$$$liin($c(9,9,9)_"s "_vhstmt_"=%JDBCGateway.prepareStatementGK("_vconn_","_vsql_") ")  
			$$$liin($c(9,9)_"} ")
		}
	}
.
	$$$liin($c(9)_"}")
	$$$liin("}")
.
	$$$liin("i "_vhstmt_"<0 "_"{ s "_verr_"=-1 "_"g "_qerrt_" }")
	if ($$$SQLCompileOption("xDBC")=1)&&($case($g($$$mtStatementType),"INS":1,"UPD":1,"DEL":1,:0)) {
	    // %qpars is the number of parameter pairs, %qparsets is the number of parameter sets
		// args is the second argument in executeParametersBatch which is called if %qparsets>1
		$$$liin("if (%qparsets>1) { set args=$lb(%qpars, %qparsets) }")
		$$$liin("}")
	}	
.
 
	if param { do GetTypes^%qaqcmxc(.dt,.prec,.scale,.numpars) }
	set bStream=$$bStream()
	if 'bStream {
		if mt("sqlcomp")="%Runtime" {
			set tmpstr="" 
			for j=1:1:param {
				set tmp=$$getParamType(param(j),.iarr)
				set @("dtj=$Li("_dt_",j)")
				if tmp=9 { set tmpstr=tmpstr_","_"$s($zu(115,5)=0:$s("_param(j)_"="""":"""",1:$zd("_param(j)_",3)),1:"_param(j)_"),"_dtj continue }  ;What to do in Display?
				if tmp=10  { set tmpstr=tmpstr_","_"$s($zu(115,5)=0:$s("_param(j)_"="""":"""",1:$zt("_param(j)_")),1:"_param(j)_"),"_dtj continue }
				set tmpstr=tmpstr_","_param(j)_","_dtj
			}
		}
		if mt("sqlcomp")="" {
			s tmpstr=""
			for j=1:1:param {
				set @("dtj=$Li("_dt_",j)")
				set tmp=$$getParamType(param(j),.iarr)
				if tmp=9  { set tmpstr=tmpstr_","_"$s("_param(j)_"="""":"""",1:$zd("_param(j)_",3)),"_dtj continue }
				if tmp=10 { set tmpstr=tmpstr_","_"$s("_param(j)_"="""":"""",1:$zt("_param(j)_")),"_dtj continue }
				set tmpstr=tmpstr_","_param(j)_","_dtj
			}
		}
		
		if (mt("sqlcomp")'="")&&( mt("sqlcomp")'="%Runtime") {
			s tmpstr="" 
			if ($$$SQLCompileOption("xDBC")=1)&&($case($g($$$mtStatementType),"INS":1,"UPD":1,"DEL":1,:0)) { n tmpdt }
			f j=1:1:param {
				s @("dtj=$Li("_dt_",j)")       
				s tmpstr=tmpstr_","_param(j)_","_dtj
				if ($$$SQLCompileOption("xDBC")=1)&&($case($g($$$mtStatementType),"INS":1,"UPD":1,"DEL":1,:0)) { s tmpdt(j)=dtj }
			}
		}
		if param {
			if ($$$SQLCompileOption("xDBC")=1)&&($case($g($$$mtStatementType),"INS":1,"UPD":1,"DEL":1,:0)) {
				for j=1:1:param {
					$$$liin("if (%qparsets>1) { set args=args_$lb("_tmpdt(j)_","_param(j)_") }")
					$$$liin("else {")
					$$$liin($c(9)_"set "_verr_"=%JDBCGateway.setValues("_vhstmt_","_param_",$lb("_$e(tmpstr,2,99999)_"))")
					$$$liin($c(9)_"if "_verr_"<0 "_"{ set "_verr_"=-1 "_"goto "_qerrt_" }")
					$$$liin("}")
				}
			}
			else {
				$$$liin("set "_verr_"=%JDBCGateway.setValues("_vhstmt_","_param_",$lb("_$e(tmpstr,2,99999)_"))")
				$$$liin("if "_verr_"<0 "_"{ set "_verr_"=-1 "_"goto "_qerrt_" }")
			}
		}
	}
	else {
		if mt("sqlcomp")="%Runtime" {
			for j=1:1:param {
				set tmp=$$getParamType(param(j),.iarr) 
				if tmp=-4 { $$$liin("set "_verr_"=$$setStreamJ^%apiGTW("_vhstmt_","_j_","_param(j)_",1)") continue  }
				if tmp=-1 { $$$liin("set "_verr_"=$$setStreamJ^%apiGTW("_vhstmt_","_j_","_param(j)_",0)") continue  }
				set @("dtj=$Li("_dt_",j)")
				if tmp=9 { $$$liin("do %JDBCGateway.setValue("_vhstmt_","_j_",$s($zu(115,5):$s("_param(j)_"="""":"""",1:$zd("_param(j)_",3)),1:"_param(j)_"),"_dtj_")") continue  }   ;What to do in Display?
				if tmp=10 { $$$liin("do %JDBCGateway.setValue("_vhstmt_","_j_",$s($zu(115,5):$s("_param(j)_"="""":"""",1:$zt("_param(j)_")),1:"_param(j)_"),"_dtj_")") continue  }
				$$$liin("d %JDBCGateway.setValue("_vhstmt_","_j_","_param(j)_","_dtj_")")
			}
		}
		if mt("sqlcomp")="" {
			for j=1:1:param {
				set tmp=$$getParamType(param(j),.iarr)
				if tmp=-4 { $$$liin("s "_verr_"=$$setStreamJ^%apiGTW("_vhstmt_","_j_","_param(j)_",1)") continue  }
				if tmp=-1 { $$$liin("s "_verr_"=$$setStreamJ^%apiGTW("_vhstmt_","_j_","_param(j)_",0)") continue  }
				set @("dtj=$Li("_dt_",j)")
				if tmp=9 { $$$liin("d %JDBCGateway.setValue("_vhstmt_","_j_",$s("_param(j)_"="""":"""",1:$zd("_param(j)_",3)),"_dtj_")") continue  }
				if tmp=10 { $$$liin("d %JDBCGateway.setValue("_vhstmt_","_j_",$s("_param(j)_"="""":"""",1:$zt("_param(j)_")),"_dtj_")") continue  }
				$$$liin("d %JDBCGateway.setValue("_vhstmt_","_j_","_param(j)_","_dtj_")")
			}
		}
	
		if (mt("sqlcomp")'="")&( mt("sqlcomp")'="%Runtime") {
			for j=1:1:param {
				set tmp=$$getParamType(param(j),.iarr)
				if tmp=-4 { $$$liin("s "_verr_"=$$setStreamJ^%apiGTW("_vhstmt_","_j_","_param(j)_",1)") continue  }
				if tmp=-1 { $$$liin("s "_verr_"=$$setStreamJ^%apiGTW("_vhstmt_","_j_","_param(j)_",0)") continue  }
				set @("dtj=$Li("_dt_",j)")       
				$$$liin("d %JDBCGateway.setValue("_vhstmt_","_j_","_param(j)_","_dtj_")")
			}
		}
	
	}
 
 
 
 	//*********************************
	if ($$$SQLCompileOption("xDBC")=1)&&($case($g($$$mtStatementType),"INS":1,"UPD":1,"DEL":1,:0)) {
		// Perform the execution if it's the last row
		$$$liin("if %qi=%qparsets {")
	}
	if (($G($$$mtStatementType)="SEL")||($G($$$mtStatementType)="DEC")) {
		$$$liin("s "_verr_"=%JDBCGateway.execQuery("_vhstmt_")")
		$$$liin("i "_verr_"<0 "_"{ s "_verr_"=-1 "_"g "_qerrt_" }")
	}
	else {
		if ($$$SQLCompileOption("xDBC")=1)&&($case($g($$$mtStatementType),"INS":1,"UPD":1,"DEL":1,:0)) {
			$$$liin("if (%qparsets>1) {")
			$$$liin($c(9)_"s res = %JDBCGateway.executeParametersBatch("_vhstmt_",args)")
			$$$liin($c(9)_"for j=1:1:%qparsets { set %qy(j)=$zobjexport($lg(res,j),18) }")
			$$$liin($c(9)_"for i=1:1:%qparsets { if $lg(res,i)=-3 { set "_verr_"=-1 "_"goto "_qerrt_" } }")
			$$$liin("}")
			$$$liin("else {")
			$$$liin($c(9)_"s %ROWCOUNT=%JDBCGateway.execUpdate("_vhstmt_")")
			$$$liin($c(9)_"i %ROWCOUNT=-1 "_"{ set "_verr_"=-1 "_"goto "_qerrt_" }")
			$$$liin("}")
		}
		else {
			$$$liin("s %ROWCOUNT=%JDBCGateway.execUpdate("_vhstmt_")") 
			$$$liin("i %ROWCOUNT=-1 "_"{ set "_verr_"=-1 "_"goto "_qerrt_" }")
		}
		if ($$$SQLCompileOption("xDBC")=1) {
			$$$liin("if $g(%qsc(%qacn,17)) {")
			$$$liin($c(9)_"set "_verr_"=%JDBCGateway.getGeneratedKeys("_vhstmt_") ") 
			$$$liin($c(9)_"if "_verr_"=0 {")
			$$$liin($c(9,9)_"set %qsc(%qacn,17,-1)=$$getJMetaDataString^%apiGTW("_vhstmt_",1)") 
.
			$$$liin($c(9,9)_"set "_verr_"='(%JDBCGateway.next("_vhstmt_"))")
			$$$liin($c(9,9)_"if "_verr_"=0 { set %qsc(%qacn,17,$i(%qsc(%qacn,17,0)))=%JDBCGateway.getString("_vhstmt_",1) }")
 
			$$$liin($c(9)_"}")
			$$$liin("}")
		}
			// If this is an insert, if the linked table returns GeneratedKeys, request the generated key value and place it in %ROWID.  
			// If no generated key was returned, %ROWID="" to indicate unknown generated key value
			// %inssel check means INSERT...SELECT will not look to return generated keys
		elseif $g($$$mtStatementType)="INS",'$g(%inssel),extGeneratedKeys {
			$$$liin("set %ROWID="""","_verr_"=%JDBCGateway.getGeneratedKeys("_vhstmt_") ") 
			$$$liin("if "_verr_"=0 {")
			$$$liin($c(9)_"set "_verr_"='(%JDBCGateway.next("_vhstmt_"))")
			$$$liin($c(9)_"if "_verr_"=0 { set %ROWID=%JDBCGateway.getString("_vhstmt_",1) }")
 			$$$liin("}")
		}
	}
		#; We have connected, set CursorState=1 to signal CLOSE will remove the statement
	if $case($g($$$mtStatementType),"SEL":1,"DEC":1,:0) {
		$$$liin("set "_$$$getVarName("CursorState")_"=1")
	}
 
	if ($G($$$mtStatementType)="DEC") { $$$liin("RETURN") }
.
		; fetch
	do newvar^%qaqutility("rowcnt")
	if ($G($$$mtStatementType)="SEL")||($G($$$mtStatementType)="DEC") {
		set tag=$p($p(call,$c(1),2),"^")
		$$$liin("i $g("_vhstmt_")="""" { s SQLCODE=-102 g "_killtag_" }")
		set vars=""
		//d liin("s "_verr_"='(%JDBCGateway.rnext("_vhstmt_"))")
		$$$liin("set SQLCODE=0,"_$$$getVarName("CursorState")_"=10")
		if 'bStream {
			$$$liin("if $g(%JCACHE("_vhstmt_",""c""))<$g(%JCACHE("_vhstmt_")) {")
			$$$liin($c(9)_"set %JCACHE("_vhstmt_",""c"")=%JCACHE("_vhstmt_",""c"")+1")
			$$$liin($c(9)_"set "_verr_"=(%JCACHE("_vhstmt_")'>0)")
			$$$liin("}")
			$$$liin("else {")
				// DPV5825+
				// getRows return 1 if successful and 0 if there was an error.  
				// If an error, there might be some error in %msg.  If not, report the error in $ze
				// If we wait until qerrt and %JDBCGateway.getErrorText(), we will probably just get -1 in %msg
				// If this change is approved to port to Cache/Ensemble, the forrect fix will be slightly different:
				//	$$$liin($c(9)_"set %msg="""" if %JDBCGateway.getRows("_$$$MakeMSQLModuleVarArray("d","hstmt")_")=0  { set:$g(%msg)="""" %msg=""Unexpected error in JDBC Gateway getRows() call: ""_$ze goto "_qerrt_" }")
				// DPV5825-
			$$$liin($c(9)_"set %msg="""" if %JDBCGateway.getRows("_vhstmt_")=0  { set:$g(%msg)="""" %msg=""Unexpected error in JDBC Gateway getRows() call: ""_$ze goto "_qerrt_" }")
			$$$liin($c(9)_"set "_verr_"=(%JCACHE("_vhstmt_")'>0)")
			$$$liin("}")
		}
		if bStream $$$liin("s "_verr_"='(%JDBCGateway.next("_vhstmt_"))")
 
		$$$liin("set:"_verr_" SQLCODE=100")
		if $G($$$mtStatementType)="DEC" $$$liin("i SQLCODE { set %ROWCOUNT=+$g("_$$$VarName("rowcnt")_"),"_$$$getVarName("CursorState")_"=100 q }")
		if $G($$$mtStatementType)="SEL" $$$liin("i SQLCODE { s "_verr_"=SQLCODE,%ROWCOUNT=+$g("_$$$VarName("rowcnt")_"),"_$$$getVarName("CursorState")_"=100 g "_$p($p(call,$c(1),3),"^")_" }")
  
		if $G($$$mtSelectInto)'="" {
			s vars=$p($$$mtSelectInto,"^",2)
			$$$liin("s "_vrind_"=($g(%JCACHE("_vhstmt_",""c""))-1)*$g(%JCACHE("_vhstmt_",""n""))")
			for i=1:1 {
				quit:'$p(vars,",",i)
				//d liin("set "_$p($$$mtV($p(vars,",",i)),"^",2)_"=%JDBCGateway.rgetString("_vhstmt_","_i_")")
				set tmp=iarr(0,0,"select",i)
				set odbcType=""
				if $p(tmp,$c(1),7)'="",$p(tmp,$c(1),8)'="" { s odbcType=$$$smdColxDBCType(1,$p(tmp,$c(1),7),$p(tmp,$c(1),8)) }
 
				if 'bStream { $$$liin("set "_$p($$$mtV($p(vars,",",i)),"^",2)_"=$g(%JCACHE("_vhstmt_","_vrind_"+"_i_"))") }
				if bStream,'((odbcType="LONGVARCHAR")||(odbcType="LONGVARBINARY")||(odbcType="VARBINARY")) { $$$liin("set %msg="""","_$p($$$mtV($p(vars,",",i)),"^",2)_"=%JDBCGateway.getString("_vhstmt_","_i_") if %msg'="""" { set "_verr_"=-1 "_"goto "_qerrt_" }") }
				if bStream,(odbcType="VARBINARY") { $$$liin("set %msg="""","_$p($$$mtV($p(vars,",",i)),"^",2)_"=%JDBCGateway.getBinary("_vhstmt_","_i_") if %msg'="""" { set "_verr_"=-1 "_"goto "_qerrt_" }") }
				if bStream,((odbcType="LONGVARCHAR")||(odbcType="LONGVARBINARY")) {
					$$$liin("set %msg="""","_$p($$$mtV($p(vars,",",i)),"^",2)_"=$$createTempStreamJ^%apiGTW("_vhstmt_","_i_",$g(%qacn),"_(odbcType="LONGVARBINARY")_",$zbitget($zversion(0),1)) if %msg'="""" { set "_verr_"=-1 "_"goto "_qerrt_" }")  ;copy stream, assign oid to var
					If $$$SQLCompileOption("xDBC")=1 { $$$liin("if $isobject("_$p($$$mtV($p(vars,",",i)),"^",2)_") s %qobjhandle(%qacn,"_$p($$$mtV($p(vars,",",i)),"^",2)_")="_$p($$$mtV($p(vars,",",i)),"^",2)) }
					if mcurs'="" { do apndc^%qaqcasl(",,"_$p($$$mtV($p(vars,",",i)),"^",2)) }
					continue
				}
 
				if mt("sqlcomp")="" {
					do GenMethod^%qaqcmx($p(tmp,$c(1),8),$p(tmp,$c(1),7),"OdbcToLogical",$p($$$mtV($p(vars,",",i)),"^",2))
				}
				if mt("sqlcomp")="%Runtime" {
					do GenMethod^%qaqcmx($p(tmp,$c(1),8),$p(tmp,$c(1),7),"ODBCToRuntime",$p($$$mtV($p(vars,",",i)),"^",2))
				}
				//if odbcType="VARBINARY" d liin("s qq= ""dd""")
				if mcurs'="" { do apndc^%qaqcasl(",,"_$p($$$mtV($p(vars,",",i)),"^",2)) }
			}
		}
		if $G($$$mtSelectInto)="" {
			new varcount
			set varcount=$l($$$mtOutputVals($g($$$mtOutput(1))),",")-1
			$$$liin("s "_vrind_"=($g(%JCACHE("_vhstmt_",""c""))-1)*$g(%JCACHE("_vhstmt_",""n""))")
			for i=1:1:varcount {
				do newvar^%qaqutility("res"_i)
				set tmp=iarr(0,0,"select",i)
				set odbcType=""
				if $p(tmp,$c(1),7)'="",$p(tmp,$c(1),8)'="" { s odbcType=$$$smdColxDBCType(1,$p(tmp,$c(1),7),$p(tmp,$c(1),8)) }
				if bStream,'((odbcType="LONGVARCHAR")||(odbcType="LONGVARBINARY")||(odbcType="VARBINARY")) { $$$liin("set %msg="""","_$$$VarName("res"_i)_"=%JDBCGateway.getString("_vhstmt_","_i_") if %msg'="""" { set "_verr_"=-1 "_"goto "_qerrt_" }") }
				if bStream,(odbcType="VARBINARY") { $$$liin("set %msg="""","_$$$VarName("res"_i)_"=%JDBCGateway.getBinary("_vhstmt_","_i_") if %msg'="""" { set "_verr_"=-1 "_"goto "_qerrt_" }") }
				if bStream,((odbcType="LONGVARCHAR")||(odbcType="LONGVARBINARY")) {
					$$$liin("set %msg="""","_$$$VarName("res"_i)_"=$$createTempStreamJ^%apiGTW("_vhstmt_","_i_",$g(%qacn),"_(odbcType="LONGVARBINARY")_",$zbitget($zversion(0),1)) if %msg'="""" { set "_verr_"=-1 "_"goto "_qerrt_" }")  ;copy stream, assign oid to var
					If $$$SQLCompileOption("xDBC")=1 { $$$liin("set:$isobject("_$$$VarName("res"_i)_") %qobjhandle(%qacn,"_$$$VarName("res"_i)_")="_$$$VarName("res"_i)) }
				}
.
				if 'bStream { $$$liin("set "_$$$VarName("res"_i)_"=$g(%JCACHE("_vhstmt_","_vrind_"+"_i_"))") }
				#;$$$liin("set "_verr_"=%JDBCGateway.wasError() goto:"_verr_" "_qerrt)
				if mt("sqlcomp")="" {
					do GenMethod^%qaqcmx($p(tmp,$c(1),8),$p(tmp,$c(1),7),"OdbcToLogical",$$$VarName("res"_i))
				}
				if mt("sqlcomp")="%Runtime" {
					do GenMethod^%qaqcmx($p(tmp,$c(1),8),$p(tmp,$c(1),7),"ODBCToRuntime",$$$VarName("res"_i))
				}
				if mcurs'="" { do apndc^%qaqcasl(",,"_$$$VarName("res"_i)) }
			}
		}
 
		$$$liin("s %ROWCOUNT=$i("_$$$VarName("rowcnt")_")")
		if $G($$$mtStatementType)="DEC" { $$$liin("q") }
	}
.
.
	 ; close
	set tag=$p($p(call,$c(1),3),"^")
	if $g($$$mtStatementType)="DEC" {
		$$$liin("set SQLCODE=0")
	} else {
		$$$liin(";")
	}
.
	set tag=$p($p(call,$c(1),3),"^")_1  //  tag c1 
	$$$liin("if $g("_vhstmt_")="""" { set SQLCODE=-102 goto "_killtag_" }")    ; 
	if $G($$$mtStatementType)'="DEC" { $$$liin("set:"_verr_"=0 SQLCODE=0") }
	set tag=$p($p(call,$c(1),3),"^")_2  //  tag c2
	if ($G($$$mtStatementType)="SEL")||($G($$$mtStatementType)="DEC") {
		$$$liin("set %ROWCOUNT="_$s(cflag||mcurs:"+$g("_$$$VarName("rowcnt")_")",1:"'SQLCODE"))
	}
	if '$Data(%msqlObjectFiler) { $$$liin("set:$isobject($g(%JDBCGateway)) "_verr_"=%JDBCGateway.removeStatement("_vhstmt_")") }
	$$$liin("kill %JCACHE("_vhstmt_")")
	set tag=killtag
	$$$liin("kill "_$$$getVarName("CursorState")_","_vconn_","_verr_","_vsql_","_vhstmt_","_vrind_","_$$$VarName("rowcnt"))
		// we increment the connection name anytime something grabs the connection so we should decrement it when done
	$$$liin("do:$d(%JDBCGateway) $i(%JDBCGateway("""_$$$mtDSNConnection_""",""activeconnections""), -1)")
		// Users can specify that a SQL Gateway connection is such that it should disconnect after no linked tables are using that connection anymore,
		// first we will check if there are any active uses of it though
	if $g(disconnectOnClose) {
		$$$liin("if ($g(%JDBCGateway("""_$$$mtDSNConnection_""", ""activeconnections"")) '= """") && (%JDBCGateway("""_$$$mtDSNConnection_""", ""activeconnections"") < 1 ) { do %JDBCGateway.removeConnection(%JDBCGateway("""_$$$mtDSNConnection_""")) kill %JDBCGateway("""_$$$mtDSNConnection_""")}")
	}
	$$$liin("quit")
.
	 ; SQL error
	s tag=qerrt
	//d liin("i 0") //_verr_"=-1,$g("_vhstmt_")'="""" // s %msg=$li($zf(-5,"_$$$odbcgatewayHandle_",12,"_$$$MakeMSQLModuleVariable("hdbc")_","_vhstmt_"))")
	//d liin("e  d")
	$$$liin("if $g("_vhstmt_")="""" { if %msg="""" { set %msg=""Connection error"" } set SQLCODE=-461 goto "_killtag_" }")
	$$$liin("else { set:$g(%msg)="""" %msg=%JDBCGateway.getErrorText() if %msg="""" { set %msg=""Gateway error"" } set SQLCODE=-400 }")
	$$$liin("goto "_$p($p(call,$c(1),3),"^")_1)
	//d liin("q")
  
	; set up standard error handler
	s tag=gtag_"err"  ;  Set-Up Error Trap
	if cflag { $$$liin("set SQLCODE=-400,%msg=$ze,$ze="""","_verr_"=-3 do "_$p($p(call,$c(1),3),"^")_"2 quit") }
	else     { $$$liin("set $zt="""",SQLCODE=-400,%msg=$ze,$ze="""","_verr_"=-3 g "_$p($p(call,$c(1),3),"^")) }
	if ($$$SQLCompileOption("xDBC")=1)&&($case($g($$$mtStatementType),"INS":1,"UPD":1,"DEL":1,:0)) { $$$liin("}") }
.
	QUIT
.
	// Given the name of a parameter and an mtc(), return the type number of the parameter
	// Returns "" if the parameter pName is not found
getParamType(pName,&mtc) [] PUBLIC {
	set tPtr="",tType=""
	for  {
		set tPtr=$o(mtc(0,0,"parameter",tPtr),1,tData)
		if $p(tData,$c(1),1)=pName { set tType=$p(mtc(0,0,"parameter",tPtr,1),$c(1),2) quit }
	}
	QUIT tType
	
}
.
	// Given an mlabel value, return the name of the class that projected the table
targetClassName(&mt) [] PRIVATE {
	RETURN:'($d($$$mtTarget)#2) ""
	RETURN $$$GetClassNameFromIQN($$$mtFromTableName($$$mtTarget))
}
.
	// Return 1 if there is a stream parameter or field
	// Also return true if there are binary fields, we do not currently support caching of binary values
bStream()
	new rc,i,tmp,odbcType,vars,varcount
	set rc=0
	do sqlact^%qaqcmx(.sql,.iarr)
	for j=1:1:param {
		set tmp=$$getParamType(param(j),.iarr)
		if (tmp=-4)||(tmp=-1) { set rc=1 quit } 
	}
.
	if 'rc,($G($$$mtStatementType)="SEL")||($G($$$mtStatementType)="DEC") {
		if $G($$$mtSelectInto)'="" { 
			set vars=$p($$$mtSelectInto,"^",2)
			set varcount = $l(vars,",")-1
		}
		else {
			set varcount=$l($$$mtOutputVals($g($$$mtOutput(1))),",")-1
		}
		for i=1:1:varcount {
			set tmp=iarr(0,0,"select",i)
			set odbcType=""
			if $p(tmp,$c(1),7)'="",$p(tmp,$c(1),8)'="" { set odbcType=$$$smdColxDBCType(1,$p(tmp,$c(1),7),$p(tmp,$c(1),8)) }
			if (odbcType="LONGVARCHAR")||(odbcType="LONGVARBINARY")||(odbcType="VARBINARY") { set rc=1  quit }
		}
	}
	QUIT rc
	
	
getbin(str) PUBLIC 
{
	s ret=""
	for ii=1:2:$l(str-1) {
		s ret=ret_$c($zh($e(str,ii,2)))
	}
	quit ret
}
#INCLUDE %fcalpha 
#INCLUDE %quoter
squoter(x) ; $$ Func to wrap single quotes around x, x may already contain quotes
 QUIT:x=+x x n a,i s a="" f i=1:1:$l(x,"'") s a=a_"'"_$p(x,"'",i)_"'"
 QUIT a
---
