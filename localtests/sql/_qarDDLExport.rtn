====
qarDDLExport
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qarDDLExport^MAC^^^0
	#;-------------------------------------------------------------
	#;
	#; Used *only* by CompileTable^%ocsSQLRTDict (for backwards compatibility).
	#;
	#; This entrypoint should not be used otherwise.
	#; Use instead Export^%qarDDLExport (via $SYSTEM.SQL.Schema.ExportDDL)
	#;
	#; The maintained,non-deprecated entrypoints of ^%qarDDLExport are
	#;     - Export^%qarDDLExport
	#;     - ExportSQL^%qarDDLExport
	#;
	#;-------------------------------------------------------------
%qarDDLExport(schema="",table="",&ddl,pretty=0) [] PUBLIC {
	;; COMPONENTS :: SQL/Runtime
	#;
#INCLUDE %msql
#define COSString2SQLString(%s) $replace(%s,"'","''")
	kill ddl
	set ddl($increment(ddl)) = ""
	set pretty = ''$get(pretty)
	return:($get(table) = "")
	set iqn = $$$GetExactIntQualifiedName(schema,table)
	return:(iqn = "")
		#; Gets exact case of names
	set schema     = $$$SchemaFromIQN(iqn)
	set table      = $$$TableFromIQN(iqn)
	set extentname = $$$GetExtentNameFromTableName(schema,table)
	set ddl(ddl)   = "CREATE TABLE "_$$quoter2(schema)_"."_$$quoter2(table)_" ("
		#; Export fields
	set i = ""
	for {
		set i = $order(^oddSQL(schema,table,8,i),1,data)
		quit:(i = "")
		set fldname  = $listget(data,4)
		set datatype = $$datatype(data)
		set nullable = $listget(data,11)
		set ddl(ddl) = ddl(ddl) _ " " _ $$quoter2(fldname) _ " " _ datatype _ $select(nullable: ",", 1:" NOT NULL,")
	}
		#; Do UNIQUE/PRIMARY KEY constraints
	set con = ""
	for {
		set con = $order($$$EXTCONS($$$pEXT,extentname,con))
		quit:(con = "")
		set coninfo = $$$EXTCONSsqlinfo($$$pEXT,extentname,con)
			#; Not a real constraint
		continue:($extract($listget(coninfo)) = "%")
		if $listget(coninfo,2) = "PKEY" {
			set ddl(ddl) = ddl(ddl) _ " CONSTRAINT " _ $$quoter2($listget(coninfo)) _ " PRIMARY KEY (" _ $listget(coninfo,3) _ "),"
		} elseif $listget(coninfo,2) = "UNIQUE" {
			set ddl(ddl) = ddl(ddl) _ " CONSTRAINT " _ $$quoter2($listget(coninfo)) _ " UNIQUE (" _ $listget(coninfo,3) _ "),"
		}
	}
		#; Replace last comma with closing ")"
	set $extract(ddl(ddl),*) = ")"
	return
}
	#;-------------------------------------------------------------
	#; Description: Utility to generate only the DDL statements to recreate a IRIS SQL table or view.
	#;
	#; Parameters:
	#;     schema 				- Name of the schema. Optional. Default is "". If schema = "", then we will qualify
	#;              			the table with the default schema ($$GetDefaultSchema^%SYS.CONFIG()).
	#;     table  				- Name of the table or view to export. Required. Default is "". If table = "", then
	#;              			this function is a no-op.
	#;     ddl    				- PBR. Local array to store the exported DDL statements.
	#;     pretty 				- 1/0 Flag. Default is 0. If FALSE, each separate DDL statement will be a single string.
	#;     eos    				- Script file statement delimiter. Default is "".
	#;     isISC  				- 1/0 Flag. Default is 0. If TRUE, the export target is an InterSystems product (IRIS).
	#; 	   exportForeignTables 	- 1/0, if 1 we need to export foreign tables, otherwise just return for a foreign table. This requires the classname, thus better to do here
	#; 	   isForeignServer		- 1/0, if 1 this IS a foreign server. These are stored in a separate structure and can thus be checked by the caller easily
	#;
	#; Return Value:
	#;     %Status
	#;
	#; Used By:
	#;     Export^%qarDDLExport
	#;     ^%qarDDLExport
	#;
	#;-------------------------------------------------------------
ExportDefinition(schema="",table="",&ddl,pretty=0,eos="",isISC=1,exportForeignTables=1,isForeignServer=0) [] PRIVATE {
#define DEFAULTCOLLATION "SQLUPPER"
		#; No table, no-op
	return:(table = "") $$$OK
	set:(schema="") schema = $$$GetDefaultSchema
	GOTO:isForeignServer exportForeignServer 						// make this a tag in this proc so the logic lives in this private proc and can reuse append() etc.
	set iqn = $$$GetExactIntQualifiedName(schema,table)
	return:(iqn = "") $$$ERROR($$$TableDoesNotExist, schema _ "." _ table)
	set pretty = ''pretty
	set:('pretty) ddl($increment(ddl)) = ""
	set schema       = $$$SchemaFromIQN(iqn)						##; Get the exact case of schema
	set table        = $$$TableFromIQN(iqn)							##; Get the exact case of table
	set tablename    = $$quoter2(schema) _ "." _ $$quoter2(table)
	set classname    = $$$GetClassNameFromTableName(schema,table)
	set extentname   = $$$GetExtentNameFromTableName(schema,table)
	set tabinfo      = $$$EXTsqlinfo($$$rEXT,extentname)			##; Defined by AddTable^%ocsSQLRTDict
	set rowidfld     = $get($$$EXTidentity($$$pEXT,extentname))
	set rowidprivate = $$$comClassKeyGet(classname, $$$cCLASSsqlrowidprivate)
	set isForeignTable = $$$IsAForeignTable(classname)
	set ddlWarnings=""
	RETURN:isForeignTable&&'exportForeignTables $$$OK
.
	if $$$defClassKeyDefined(classname,$$$cCLASSquery) {
		set ddlWarnings=ddlWarnings_$LB($$$Text("Warning. Class Queries from '","%SQL.Export")_classname_$$$Text("' will not be captured by DDLExport.","%SQL.Export"))
	}
.
	if $$$defClassKeyDefined(classname,$$$cCLASSmethod) {
		set ddlWarnings=ddlWarnings_$LB($$$Text("Warning. Instance Methods and Class Methods from '","%SQL.Export")_classname_$$$Text("' will not be captured by DDLExport.","%SQL.Export"))
	}
.
	if $$$defClassKeyDefined(classname,$$$cCLASSsuper) && '(($$$defClassKeyGet(classname,$$$cCLASSsuper)="%Persistent")||($$$defClassKeyGet(classname,$$$cCLASSsuper)="%Library.Persistent")) {
		set ddlWarnings=ddlWarnings_$LB($$$Text("Warning. Class inheritance from '","%SQL.Export")_$$$defClassKeyGet(classname,$$$cCLASSsuper)_$$$Text("' will not be properly captured by DDLExport.","%SQL.Export"))
	}
.
	set storageDefName = ""
	for {
		set storageDefName = $$$defClassArrayNext(classname,$$$cCLASSstorage,storageDefName)
		quit:(storageDefName="")
		if (storageDefName'="Default") || ($$$defMemberKeyGet(classname,$$$cCLASSstorage,storageDefName,$$$cSDEFtype)="%Storage.SQL") {
			set ddlWarnings=ddlWarnings_$LB($$$Text("Warning. Non-default storage definition '","%SQL.Export")_storageDefName_$$$Text("' will not be captured by DDLExport.","%SQL.Export"))
		}
	}
.
	set classIndexName = ""
	for {
		set classIndexName = $$$defClassArrayNext(classname,$$$cCLASSindex,classIndexName) 
		quit:(classIndexName="")
		if $$$defMemberKeyDefined(classname,$$$cCLASSindex,classIndexName,$$$cINDEXproperties) && $$$defMemberKeyDefined(classname,$$$cCLASSindex,classIndexName,$$$cINDEXidkey) && (rowidprivate=0) {
			set ddlWarnings=ddlWarnings_$LB($$$Text("Warning. Use of the IdKey Index Keyword on the index '","%SQL.Export")_$$$defMemberKeyGet(classname,$$$cCLASSindex,classIndexName,$$$cINDEXproperties)_$$$Text("' without the SqlRowIdPrivate Class Keyword in the class '","%SQL.Export")_classname_$$$Text("' will cause a failure in DDLImport.","%SQL.Export"))
		}
	}
.
	set storageParamName = ""
	for {
		set storageParamName = $$$defClassArrayNext(classname,$$$cCLASSparameter,storageParamName)
		quit:(storageParamName="")
		if storageParamName'="USEEXTENTSET" {
			set ddlWarnings=ddlWarnings_$LB($$$Text("Warning. Parameter '","%SQL.Export")_storageParamName_$$$Text("' will be captured by DDLExport, but will fail DDLImport unless using IRIS SQL.","%SQL.Export"))
		}
	}
.
		#; View export is simpler than table export
	if $$$GetTableTypeFromTableName(schema,table) = 3 {
		set viewexport = "CREATE VIEW " _ tablename
		merge viewQuery = $$$EXTsqlviewqueryRoot($$$rEXT,extentname)
		set firstLineIsColumnList = $$viewQueryStartsWithColumnList^%ocsSQLRTDict(.viewQuery)
		if '$$$SQLLocViewAliasListGenerated(tabinfo), firstLineIsColumnList {
			// user specified create view v1 (c1, ...) so generate same thing
			set viewexport = viewexport _ $$$EXTsqlviewquery($$$rEXT,extentname,1)
		}
		do append(viewexport _ " AS")
		set start = $s(firstLineIsColumnList: 2, 1:1)
		for i=start:1:$$$EXTsqlviewquery($$$rEXT,extentname,0) {
			do append($$$StripLeadingWhiteSpace($$$EXTsqlviewquery($$$rEXT,extentname,i)),1)
		}
		do:('$$$SetSQLLocViewUpdateable(tabinfo)) append("WITH READ ONLY")
		do:($$$SQLLocViewCheckOption(tabinfo) '= "") append("WITH LOCAL CHECK OPTION")
		if pretty {
			set ddl($increment(ddl)) = eos
			set:(eos '= "") ddl($increment(ddl)) = ""
		}
		return $$$OK
	}
	do:('isISC && $$$SQLLocTableSharded(tabinfo)) append("-- This table is sharded, but the shard specification is omitted for DDL exports to non-InterSystems products")
	// easier to just do FTs separate than to carve out all the exceptions below
	if isForeignTable {
		// We will need the server class so grab it now and error if it doesn't exist
		set server = $$$comMemberKeyGet(classname, $$$cCLASSparameter, "SERVER", $$$cPARAMdefault)
		if server = "" {
			RETURN $$$ERROR($$$CannotExport, "server for foreign table '" _ tablename _ "'")
		}
		do append("CREATE FOREIGN TABLE "_tablename_"(")
		set sqlcolnum = "", fields = 0, maxfldnamelen = 0
		for {	##; Export SQL fields (i.e. export the <telem> list)
			set sqlcolnum = $order(^oddSQL(schema,table,8,sqlcolnum),1,flddata)
			quit:(sqlcolnum = "")
			set fldname = $listget(flddata,4)
			set colinfo  = $$$EXTSQLCOLsqlinfo($$$rEXT,extentname,fldname)
			set propname = $$$SQLLocColPropertyName(colinfo)
			set proptype = $get($$$EXTPROPtype($$$pEXT,extentname,propname))
			
			set datatype = $$datatype(flddata)
			if datatype = "BIGINT" {	##; Check for %RowVersion, %AutoIncrement and %Counter and for %Persistent subclasses
				if isISC, proptype'="", $$$comClassKeyGet(proptype,$$$cCLASSclasstype) = $$$cCLASSCLASSTYPEDATATYPE {
					set datatype = $case(proptype,
						"%Library.RowVersion"    : "ROWVERSION",
						"%Library.Counter"       : "SERIAL",
						: datatype)
				}
			}
			set qfldname = $$quoter2(fldname)
			if pretty {
					#; Keep a track of the largest fieldname so we appropriate the correct amount of spaces later
				set:($length(qfldname) > maxfldnamelen) maxfldnamelen = $length(qfldname)
				set fields($increment(fields)) = $listbuild(qfldname, datatype)
			} else {
				do append(qfldname _ " " _ datatype _",", 1)
			}
		}
		// this will only happen if pretty=1
		for i=1:1:fields {
			set fldname = $listget(fields(i))
			do append(fldname _ $justify("", maxfldnamelen - $length(fldname) + 4) _ $listtostring($list(fields(i),2,*), "") _ ",",1)
		}
		// close the list of column names/types
		if pretty {
			set $extract(ddl(ddl), $length(ddl(ddl))) = ""
			set ddl($increment(ddl)) = ")"
		} else {
			set $extract(ddl(ddl), $length(ddl(ddl))) = ")"
		}
		// add the parameters
		// server will be the class name so get the sql name
		set serverSchema = $$$comClassKeyGet(server, $$$cCLASSsqlschemaname)
		set serverSql = $$$comClassKeyGet(server, $$$cCLASSsqltablename)
		do append(" SERVER " _ $$quoter2(serverSchema) _ "." _ $$quoter2(serverSql), 1)
		set type = $$$comMemberKeyGet(server, $$$cCLASSparameter, "TYPE", $$$cPARAMdefault)
		set tableOrFileName = $$$comMemberKeyGet(classname, $$$cCLASSparameter, "TABLE", $$$cPARAMdefault)
		// TABLE doesn't always have to be filled out. Similar to QUERY this could theoretically have a single quote (within a delimited identifier) and TABLE gets wrapped in single quotes so double any internally
		do:tableOrFileName'="" append($s(type="FILE":" FILE", 1:" TABLE") _ " '" _ $replace(tableOrFileName, "'", "''") _ "'", 1)
		// QUERY parameter
		set query = $$$comMemberKeyGet(classname, $$$cCLASSparameter, "QUERY", $$$cPARAMdefault)
		// since the QUERY param is inside single quotes for the DDL statement, any single quote inside should be doubled up to escape it
		do:query'="" append(" QUERY '"_$replace(query, "'", "''")_"'", 1)
		
		// COLUMNS parameter, also need to loop over COLUMNSTYPES because the COLUMNS clause takes in types too
		// It's a comma delimited list of names
		set colClauseNames = $$$comMemberKeyGet(classname, $$$cCLASSparameter, "COLUMNS", $$$cPARAMdefault)
		if colClauseNames '= "" {
			do append(" COLUMNS (", 1)
			set colClauseTypes = $$$comMemberKeyGet(classname, $$$cCLASSparameter, "COLUMNSTYPES", $$$cPARAMdefault)
			set colClauseTypes = $lfs(colClauseTypes, ",", 2) // 2 flag because they're quoted, to prevent getting confused by commas inside type names
			set colClauseName = "", maxColNameLen = 0, colClauseEntries = 0
			for i=1:1:$l(colClauseNames,",") {
				set colClauseName = $$quoter2($p(colClauseNames, ",", i))
				set colClauseType =  $lg(colClauseTypes, i)
				if pretty {
					#; Keep a track of the largest COLUMNS clause entry so we appropriate the correct amount of spaces later
					set:($length(colClauseName) > maxColNameLen) maxColNameLen = $length(colClauseName)
					set colClauseEntries($increment(colClauseEntries)) = $listbuild(colClauseName, colClauseType)
				} else {
					do append(colClauseName _ " " _ colClauseType _",", 2)
				}
			}
			for i=1:1:colClauseEntries {
				set entry = $listget(colClauseEntries(i))
				do append(entry _ $justify("", maxColNameLen - $length(entry) + 4) _ $listtostring($list(colClauseEntries(i),2,*), "") _ $s(i < colClauseEntries:", ", 1:""), 2)
			}
			// close the COLUMNS clause
			do append(")", 1)
		}
		// VALUES parameter
		set values = $$$comMemberKeyGet(classname, $$$cCLASSparameter, "VALUES", $$$cPARAMdefault)
		if values '= "" {
			do append(" VALUES (", 1)
			// We don't need an array for 'pretty' handling because VALUES is just a name, so there's nothing to $justify
			// append() will handle putting on a new line or not for 'pretty'
			set len = $l(values, ",")
			for i=1:1:len {
				do append($$quoter2($p(values, ",", i)) _ $s(i<len: ", ", 1:""), 2)
			}
			// close the values clause
			do append(")", 1)
		}
		// USING clause, we can just put this directly in
		set using = $$$comMemberKeyGet(classname, $$$cCLASSparameter, "USING", $$$cPARAMdefault)
		do:(using'=""&&(using'="{}")) append(" USING "_using, 1)
.
		// close the statement
		if pretty {
			set ddl($increment(ddl)) = eos
			set:(eos '= "") ddl($increment(ddl)) = ""
		}
		RETURN $$$OK
	}
.
	do append("CREATE TABLE " _ tablename _ "(")
		#; Check for a table description and if it exists, replace $char(13,10) with a single whitespace and escape single quotes
	do:(isISC && ($$$comClassKeyGet(classname,$$$cCLASSdescription) '= "")) append("%DESCRIPTION '" _ $translate($$$COSString2SQLString($$$comClassKeyGet(classname,$$$cCLASSdescription)),$char(13,10)," ") _ "',", 1)
		#; ^oddSQL(schema,table,8,sqlcolnum) is defined in FinalizeTableDefinition^%ocsSQLRTDict
		#; ^oddEXTR ($$$rEXT) is documented by AddField^%ocsSQLRTDict
		#;
		#; ^oddSQL is an "index" of ^oddEXTR, so we iterate over ^oddSQL, but most information comes from ^oddEXTR
	set sqlcolnum = "", fields = 0, maxfldnamelen = 0
	for {	##; Export SQL fields (i.e. export the <telem> list)
		set sqlcolnum = $order(^oddSQL(schema,table,8,sqlcolnum),1,flddata)
		quit:(sqlcolnum = "")
		set fldname = $listget(^(sqlcolnum),4)
		if isISC, 'rowidprivate, $listget($$$EXTSQLrowidcolumnlist($$$pEXT,extentname)) = fldname {
			do append("%PUBLICROWID,",1)
			continue
		}
		set colinfo  = $$$EXTSQLCOLsqlinfo($$$rEXT,extentname,fldname)
		set propname = $$$SQLLocColPropertyName(colinfo)
		set proptype = $get($$$EXTPROPtype($$$pEXT,extentname,propname))
			#; propdesc will usually be the description of the property except in the case of %SerialObject expansion
		set propdesc = ""
			#; proptype can be "" in the event of a %SerialObject flattening/expansion
		if proptype = "", $$$SQLLocColContainerType(colinfo) '= "" {
			set proptype = $get($$$EXTPROPtype($$$pEXT,$$$SQLLocColContainerType(colinfo),propname))
			set propdesc = " %DESCRIPTION 'Exported from an embedded object ''" _ $$$COSString2SQLString(tablename) _ "::" _ $$$COSString2SQLString($$$SQLLocColContainerField(colinfo)) _ "'''"
		}
		if $$$defMemberKeyDefined(classname,$$$cCLASSproperty,propname,$$$cPROPsqlcomputecode) {
            if $$$defMemberKeyGet(classname,$$$cCLASSproperty,propname,$$$cPROPdescription)[";" {
                set ddlWarnings=ddlWarnings_$LB($$$Text("Warning. Property '","%SQL.Export")_propname_$$$Text("' uses COMPUTECODE functionality and has a semicolon in its description, which will cause a failure upon import.","%SQL.Export"))
            }
        }
			#; Handle projecting the IDENTITY column
		set datatype = $select($$$SQLLocColIdentity(colinfo): "IDENTITY", 1: $$datatype(flddata))
		if datatype = "BIGINT" {	##; Check for %RowVersion, %AutoIncrement and %Counter and for %Persistent subclasses
			if isISC, proptype'="", $$$comClassKeyGet(proptype,$$$cCLASSclasstype) = $$$cCLASSCLASSTYPEDATATYPE {
				set datatype = $case(proptype,
					"%Library.RowVersion"    : "ROWVERSION",
					"%Library.AutoIncrement" : "BIGINT AUTO_INCREMENT",
					"%Library.Counter"       : "SERIAL",
					: datatype)
			} elseif proptype'="", $$$comClassKeyGet(proptype,$$$cCLASSclasstype) = $$$cCLASSCLASSTYPEPERSISTENT {
				if isISC {
					set datatype = proptype
				} else {
					#; TODO: project the implicit FKEYs for standard non-IRIS SQL
				}
			}
		}
		if datatype="VARCHAR(-1)" {
			if ddlWarnings'["User-defined DDL mappings" { set ddlWarnings=ddlWarnings_$LB($$$Text("Warning. User-defined DDL mappings cannot be properly represented by DDL Export.","%SQL.Export")) }
		}
		if datatype [ "VARCHAR", isISC, proptype'="",$$checkDataType^%apiDDL2(proptype,$lb("%Library.Vector")) {	##; Check for VECTOR
			set ddlWarnings=ddlWarnings_$LB($$$Text("Warning. The VECTOR datatype captured by DDL Export will not be properly recreated by DDL Import unless using IRIS SQL.","%SQL.Export"))
			set datatype = "VECTOR("_$$$SQLLocColVectorDatatype(colinfo)_$s($$$SQLLocColVectorLength(colinfo)'="":","_$$$SQLLocColVectorLength(colinfo),1:"")_")"
		}
		set nullable = $select($$$SQLLocColRequired(colinfo) = "Y": " NOT NULL", 1: "")
		try {
			if datatype = "IDENTITY", $$$comMemberKeyGet(classname,$$$cCLASSproperty,propname,$$$cPROPinitialexpression) = """""" {
					#; Skips exporting the autogenereated default value for IDENTITY (i.e. the $increment of DATALOCATIONGLOBAL)
					#; Otherwise, the default expression for IDENTITY is either a scalar (which always fail after the first insert)
					#; or an expression that's only valid for exports to other IRIS products (by use of OBJECTSCRIPT).
				set default  = ""
			} else {
				set default = $$ExportDefault($$$SQLLocColDefaultValue(colinfo),isISC)
			}
		} catch ex {
			return $$$EMBEDSC($$$ERROR($$$CannotExport, "default value for '" _ tablename _ "::" _ fldname _ "'"), ex.AsStatus())
		}
			#; Export Collation
		set collation = ##class(%SQL.Manager.Catalog).CollationEnumToString($$$SQLLocColCollation(colinfo))
		if collation '= "" {
				#; Disambiguate from default collation and explicitly defined collation that happens to be default collation
				#; $$rEXT and $$$pEXT will resolve a collation, but ^oddCOM does not and will be "" if not specified
			set:(collation = $$$DEFAULTCOLLATION) collation = $$$comMemberArrayGet(classname,$$$cCLASSproperty,propname,$$$cPROPparameter,"COLLATION")
			set:(collation '= "") collation = " COLLATE " _ collation
		}
			#; See if the field/property specifies STORAGEDEEFAULT.  If so, that will be generated for the column in the WITH STORAGETYPE clause
		set propStorageDefault=$$$LOWER($$$comMemberArrayGet(extentname,$$$cCLASSproperty,propname,$$$cPROPparameter,"STORAGEDEFAULT"))
		if propStorageDefault="row" { set storageDefault=" WITH STORAGETYPE = ROW"}
		elseif propStorageDefault="columnar" { set storageDefault=" WITH STORAGETYPE = COLUMNAR"}
		else { set storageDefault="" }
.
			#; Export %DESCRIPTION for the property (if one is not already set)
		if isISC, (propdesc = "") {
			set propdesc = $$$comMemberKeyGet(classname,$$$cCLASSproperty,propname,$$$cPROPdescription)
				#; Escape any single quotes for SQL string literals and replace $char(13,10) (newlines) with whitespace
			set:(propdesc '= "") propdesc = " %DESCRIPTION '" _ $translate($$$COSString2SQLString(propdesc),$char(13,10)," ") _ "'"
		}
		set computecode="", transience = 0
		if $$$SQLLocColComputedAlways(colinfo) = "Y" {
			set transience = 1 + $$$comMemberKeyGet(classname,$$$cCLASSproperty,propname,$$$cPROPcalculated)
			return:('isISC) $$$ERROR($$$ISCExclusiveFeature,$select(transience=1: "TRANSIENT", 1: "CALCULATED") _ " property '" _ tablename _ "::" _ propname _ "'")
				#; Do not use $$$EXTSQLCOLsqlcomputecode($$$rEXT,extentname,fldname) as it's already in a format
				#; suitable for MAC code generation and is difficult to reverse-translate back to standard SQL
			set computecode = " COMPUTECODE {" _ $zstrip($$$comMemberKeyGet(classname,$$$cCLASSproperty,propname,$$$cPROPsqlcomputecode),"<>W") _ "} " _ $select(transience=1: "TRANSIENT", 1: "CALCULATED")
		} elseif $$$SQLLocColComputed(colinfo) = "Y" {
			set deferToSqlComputed = 1
			if $$$SQLLocColComputedTriggerFields(colinfo) = $listbuild("%%UPDATE") {
				try {
					set computecode = $$ExportOnUpdate($$$comMemberKeyGet(classname,$$$cCLASSproperty,propname,$$$cPROPsqlcomputecode))
					set deferToSqlComputed = 0
				} catch ex { /* Do nothing; defer to the SQLCOMPUTED export below to throw any exceptions */ }
			}
			if deferToSqlComputed {
				return:('isISC) $$$ERROR(ISCExclusiveFeature,"SQLCOMPUTED property '" _ tablename _ "::" _ propname _ "'")
				set computecode = " COMPUTECODE {" _ $zstrip($$$comMemberKeyGet(classname,$$$cCLASSproperty,propname,$$$cPROPsqlcomputecode),"<>W") _ "}"
				if $$$SQLLocColComputedTriggerFields(colinfo) '= "" {
					set computecode = computecode _ " COMPUTEONCHANGE("
					for i=1:1:$listlength($$$SQLLocColComputedTriggerFields(colinfo)) {
						set computecode = computecode _ $$quoter2($listget($$$SQLLocColComputedTriggerFields(colinfo),i)) _ ","
					}
					set $extract(computecode,*) = ")"
				}
			}
		}
		set qfldname = $$quoter2(fldname)
		if pretty {
				#; Keep a track of the largest fieldname so we appropriate the correct amount of spaces later
			set:($length(qfldname) > maxfldnamelen) maxfldnamelen = $length(qfldname)
			set fields($increment(fields)) = $listbuild(qfldname, datatype, nullable, default, collation, propdesc, computecode, storageDefault)
		} else {
			do append(qfldname _ " " _ datatype _ nullable _ default _ collation _ propdesc _ computecode _ storageDefault _",", 1)
		}
	}
	for i=1:1:fields {
		set fldname = $listget(fields(i))
		do append(fldname _ $justify("", maxfldnamelen - $length(fldname) + 4) _ $listtostring($list(fields(i),2,*), "") _ ",",1)
	}
	set con = ""
	for {	##; Export constraints
		set con = $order($$$EXTCONS($$$pEXT,extentname,con))
		quit:(con = "")
		continue:con=$$$PartitionIdKeyName
		set coninfo = $get($$$EXTCONSsqlinfo($$$pEXT,extentname,con))
			#; "%1" is an internal IDKEY based on %ID/RowId
		continue:($listget(coninfo) = "%1")
		set consqlname = $listget(coninfo,4)
		if $listget(coninfo,2) = "PKEY" {
			do append("CONSTRAINT " _ consqlname _ " PRIMARY KEY(" _ $listget(coninfo,3) _ "),",1)
		} elseif $listget(coninfo,2) = "UNIQUE" {
				#; Do not export an implicit/system-assigned IdKey (i.e. the %ID/ROWID or IDENTITY)
			if (con = $$$EXTidkey($$$pEXT,extentname)) {
				continue:((rowidfld '= "") || $listget(coninfo,5))
				return $$$ERROR($$$IndexIdNotBasedOnIdentity,classname,con)
			}
				#; Unique indices project themselves as unique constraints, but they manifest differently
				#; We process constraints first as they are part of the <telem> list, but for unique constraints
				#; we need to defer them until after the processing of indices
			set uniques(consqlname) = $listget(coninfo,3)
		} elseif $listget(coninfo,2) = "FKEY" {
			set fkeyinfo = $listget(coninfo,3)
				#;---- The below code is adapted from ##class(%SQL.Manager.Catalog).ConstraintsFetch() ----
			set fkeyflds = $listget(fkeyinfo)
			for i=1:1:$length(fkeyflds,",") {
				set $piece(fkeyflds,",",i) = $$quoter2($piece(fkeyflds,",",i))
			}
			set refkeyflds = $listget(fkeyinfo,3)
			for i=1:1:$length(refkeyflds,",") {
				set $piece(refkeyflds,",",i) = $$quoter2($piece(refkeyflds,",",i))
			}
				#;---- End of the adaptation from ##class(%SQL.Manager.Catalog).ConstraintsFetch() ----
			set fkeyspec = "CONSTRAINT " _ consqlname _ " FOREIGN KEY(" _ fkeyflds _ ")"
			set fkeyspec = fkeyspec _ " REFERENCES " _ $listget(fkeyinfo,2) _ "(" _ refkeyflds _ ")"
			for event="UPDATE", "DELETE" {
				set rule = $case($listget(fkeyinfo, $select($extract(event)="U":6, 1: 7)),
					"cascade"   : "CASCADE",
					"setdefault": "SET DEFAULT",
					"setnull"   : "SET NULL",
					            : ""
				)
				set:(rule'="") fkeyspec = fkeyspec _ " ON " _ event _ " " _ rule
			}
			do append(fkeyspec _ ",",1)
		}
	}
		#; Process non-constraint indices; do this now because we cannot close the <telem> list without resolving
		#; the uniqueness ambiguity
	set idx = "", indices = 0
	for {
			#; $$$EXTSQLMAP($$$rEXT,...) and $$$EXTSQLMAPsqlinfo($$$rEXT,...) defined in AddMap^%ocsSQLRTDict
		set idx = $order($$$EXTSQLMAP($$$rEXT,extentname,idx))
		quit:(idx = "")
		set mapinfo = $$$EXTSQLMAPsqlinfo($$$rEXT,extentname,idx)
			#; Skip any internal indices.
		continue:(($extract(idx) = "$") || ($extract(idx) = "%"))
			#; Skip the MDI (master data index/master data map), and primary key index as they are already processed during constraints export
		continue:($$$SQLLocMapMaster(mapinfo) = "Y")
			#; Skip columnar data maps
		continue:($$$SQLLocMapIndexType(mapinfo) = "CD")
		if $$$SQLLocMapIndexName(mapinfo) '= "" {
			continue:$get($$$EXTIDXprimarykey($$$pEXT,extentname,$$$SQLLocMapIndexName(mapinfo)))
		} else {
			continue:$get($$$EXTIDXprimarykey($$$pEXT,extentname,idx))
		}
			#; Generate the index field list
		set idxflds = ""
		if $$$SQLLocMapIndexFields(mapinfo) '= "" {
			for i=1:1:$listlength($$$SQLLocMapIndexFields(mapinfo)) {
				set idxflds = idxflds _ $$quoter2($listget($$$SQLLocMapIndexFields(mapinfo),i)) _ ","
			}
			set:(idxflds'="") $extract(idxflds,*) = ""
		} else {
				#;---- Adapted from ##class(%SQL.Manager.Catalog).IndicesFetch()
			set ilev = ""
			for {
				set ilev = $order($$$EXTSQLMAPSUB($$$rEXT,extentname,idx,ilev))
				quit:(ilev="")
				set msinfo = $$$EXTSQLMAPSUBsqlinfo($$$rEXT,extentname,idx,ilev)
				set field  = $$$SQLLocMapSubFieldName(msinfo)
				if $$$SQLLocMapSubFieldSchema(msinfo) = "", $$$SQLLocMapMaster(mapinfo) '= "Y" {
						#; Skip any rowID based fields
					continue:(($$$SQLLocTableRowIDField(tabinfo) = field) || $listfind($$$SQLLocTableRowIDLogicalFields(tabinfo),field))
				}
					#; The $select is IDKeyFieldNameFromIDField from ##class(%SQL.Manager.Catalog).IndicesFetch()
				set:(field '= "") idxflds = idxflds _ $select(
					($$$SQLLocTableRowIDBased(tabinfo)'="Y"): field,
					($listlength($$$SQLLocTableRowIDLogicalFields(tabinfo)) '= 1): field,
					($$$SQLLocTableRowIDField(tabinfo) = field): $listget($$$SQLLocTableRowIDLogicalFields(tabinfo)),
					1: field
				) _ ","
			}
			#;---- End of adaptation from ##class(%SQL.Manager.Catalog).IndicesFetch()
			set $extract(idxflds,*) = ""
		}
		set partitioned=""
		if isISC {
			if $$$SQLLocTablePartitioned(tabinfo),'$$$SQLLocMapPartitioned(mapinfo) {
				set partitioned="NONPARTITIONED "
			}
			if '$$$SQLLocTablePartitioned(tabinfo),$$$SQLLocMapPartitioned(mapinfo) {
				set partitioned="PARTITIONED "
			}
		}
			#;---- Adapted from ##class(%SQL.Manager.Catalog).IndicesFetch()
		if $$$SetSQLLocMapUnique(mapinfo), $data(uniques(idx)) {
			set indices($increment(indices)) = "CREATE UNIQUE " _ partitioned _ "INDEX " _ idx
			kill uniques(idx)
		} else {
			set indextype = $$$SQLLocMapIndexType(mapinfo)
			if $case(indextype, "B": 1, "S": 1, "BE": 1, "C": 1, :0) {
				set indextype = $case(indextype, "B": "BITMAP ", "S": "BITSLICE ", "BE": "BITMAPEXTENT ", "C": "COLUMNAR ")
				return:('isISC) $$$ERROR($$$ISCExclusiveFeature,indextype _ " INDEX '" _ tablename _ "::" _ idx _ "'")
				set indices($increment(indices)) = "CREATE " _ indextype _ partitioned _ "INDEX " _ idx
			}
			elseif $extract(indextype,1,2) = "FI" {
				return:('isISC) $$$ERROR($$$ISCExclusiveFeature,"Functional Index '" _ tablename _ "::" _ idx _ "'" _ $extract(indextype,3,*))
				set indices($increment(indices)) = "CREATE INDEX " _ idx
				set indices(indices, $extract(indextype,5,*-1)) = ""	##; Record the FI typeclass
				// Record parameters for functional indices (e.g. CREATE INDEX ix On (prop) As %iFind.Index.Basic(IGNOREPUNCTUATION=1)
				// Use oddDEF - oddCOM will include all of the parameters that are added as defaults during compilation
				set paramName = ""
				for {
					set paramName = $$$defSubMemberNext(extentname, $$$cCLASSindex, idx, $$$cINDEXparameter, paramName)
					QUIT:paramName=""
					set paramValue = $$$defMemberArrayGet(extentname, $$$cCLASSindex, idx, $$$cINDEXparameter, paramName)
					if paramValue '= "" {	// just to make sure
						// The current structure of indices() doesn't make it the best place to extend so use a new structure for
						// index params
						set indexParams(indices, paramName) = paramValue
					}
				}
.
			}
			else {
				set indices($increment(indices)) = "CREATE " _ partitioned _ "INDEX " _ idx
			}
		}
			#;---- End of adaptation from ##class(%SQL.Manager.Catalog).IndicesFetch()
		set indices(indices) = indices(indices) _ " ON " _ tablename _ "(" _ idxflds _ ")"
		if isISC {
			set fiType = $order(indices(indices,""))
			if fiType '= ""{
				set indices(indices) = indices(indices) _ " AS " _ fiType
				if $d(indexParams(indices)) {		// generate params: ... AS fiType (PARAMNAME = PARAMVALUE)
					set indices(indices) = indices(indices) _ "("
					set paramName = ""
					for {
						set paramName = $o(indexParams(indices, paramName), 1, paramValue)
						QUIT:paramName=""
						if $isvalidnum(paramValue) {	// don't quote numerics
							set indices(indices) = indices(indices) _ paramName _ "=" _ paramValue _ ", "
						} else {	// quote with single (SQL-style) quotes
							set indices(indices) = indices(indices) _ paramName _ "='" _ $$$COSString2SQLString(paramValue) _ "', "
						}
					}
					// $e() - remove the trailing ", " from the parameter list
					set indices(indices) = $e(indices(indices), 1, *-2) _ ")"
				}
			}
			set dataflds = ""
				#; Generate the data field list by iterating over $$$EXTIDXdata($$$pEXT)
			for i=1:1:$get($$$EXTIDXdata($$$pEXT,extentname,idx)) {
					#; Skip "%%CLASSNAME" which is defined for regular indices onto a property
				if $extract($$$EXTIDXDATA($$$pEXT,extentname,idx,i)) '= "%" {
						#; $$$EXTIDXDATA has property names, but we need to export the SqlColumnName
					set dataflds = dataflds _ $$quoter2($$$EXTPROPsqlcolumnname($$$pEXT,extentname,$$$EXTIDXDATA($$$pEXT,extentname,idx,i))) _ ","
				}
			}
			set:(dataflds '= "") indices(indices) = indices(indices) _ " WITH DATA(" _ $extract(dataflds,1,*-1) _ ")"
		}
	}
		#; Close the <telem> list
	if pretty {
		set $extract(ddl(ddl), $length(ddl(ddl))) = ""
		set ddl($increment(ddl)) = ")"
	} else {
		set $extract(ddl(ddl), $length(ddl(ddl))) = ")"
	}
		#; Export the <topt> list
	if isISC {	##; Export Class Parameters
		if $$$SQLLocTableSharded(tabinfo) {
			if $$$SQLLocTableShardKey(tabinfo) = "" {
				do append("SHARD",1)
			} else {
				set shardkeyspec = "SHARD KEY("
				for i=1:1:$listlength($$$SQLLocTableShardKey(tabinfo)) {
					set shardkeyspec = shardkeyspec _ $$quoter2($listget($$$SQLLocTableShardKey(tabinfo),i)) _ ","
				}
				set $extract(shardkeyspec,*) = ")"
				if $$$SQLLocCoshardWith(tabinfo) '= "" {
						// $$$SQLLocCoshardWith is a classname
					set coshard=$$$SQLLocCoshardWith(tabinfo)
					set coshardsql=$$$comClassKeyGet(coshard,$$$cCLASSsqlqualifiednameQ)
					set shardkeyspec = shardkeyspec _ " COSHARD WITH " _ coshardsql
				}
				do append(shardkeyspec,1)
			}
		}
		set partkey=$$partitionkey(classname)
		if partkey'="" {
			set partition="PARTITION BY "
			for i=1:1:$l(partkey,"^")-1 {
				set pk=$p(partkey,"^",i)
				set pfield=$p(pk,"|")
				set ptype=$p(pk,"|",2)
				set partition=partition_$s(i=1:"",1:", ")_$s(ptype="l":"LIST",ptype="h":"HASH",ptype="r":"RANGE",1:"")_"("_pfield_")"
				if ptype="r" {
					set partition=partition_" INTERVAL "_ $p(pk,"|",3)_$s($p(pk,"|",4)="":"",1:" "_$ZCVT($p(pk,"|",4),"U"))
				}
				elseif ptype="h" {
					set partition=partition_" IN "_ $p(pk,"|",3)_" PARTITIONS"
				}
			}
			do append(partition,1)
		}
		elseif $$$SQLLocTablePartitioned(tabinfo) {
			do append("PARTITION",1)
		}
.
		set param = "", classparams = 0
		for {
			set param = $$$comClassArrayNext(classname,$$$cCLASSparameter,param)
			quit:(param = "")
			if $$$SQLLocTableSharded(tabinfo) {
					#; Skip parameters required by sharding
				continue:($extract($$$UPPER(param),1,10) = "SHARDLOCAL")
					#; See CreateTable^%apiDDL, but do not set the DEFAULTCONCURRENCY for sharded tables
				continue:(param = "DEFAULTCONCURRENCY")
			}
				#; Export only those parameters that are not defined by a % or system class
			if ^(param,$$$cXXXXorigin) '? 1(1"%Library.",1"%Storage.",1"%").E, $$$comClassKeyGet(^($$$cXXXXorigin),$$$cCLASSclasstype) '= $$$cCLASSCLASSTYPESYSTEM {
				set paramdefault = $$$comMemberKeyGet(classname,$$$cCLASSparameter,param,$$$cPARAMdefault)
					#; if $$$cPARAMtaggenerator is defined, then it's a compile-time expression and don't export it
				if paramdefault '= "", '$$$comMemberKeyDefined(classname,$$$cCLASSparameter,param,$$$cPARAMtaggenerator) {
						#; Skip USEEXTENTSET unless it's deliberately unset
					continue:((param = "USEEXTENTSET") && paramdefault)
					set classparams(param) = $select(+paramdefault = paramdefault: +paramdefault, 1: "'" _ paramdefault _ "'")
					set classparams = $increment(classparams)
				}
			}
		}
		if classparams {
			do append("WITH")
			if $data(classparams("STORAGEDEFAULT")), $$$UPPER(classparams("STORAGEDEFAULT")) '= "ROW" {
				do append("STORAGETYPE = " _ $extract(classparams("STORAGEDEFAULT"),2,*-1) _ ",",1)
				kill classparams("STORAGEDEFAULT")
			}
			for {
				set param = $order(classparams(param),1,paramdefault)
				quit:(param = "")
				do append("%CLASSPARAMETER " _ param _ " = " _ paramdefault _ ",",1)
			}
			set $extract(ddl(ddl),*)=""		##; Remove trailing comma
		}
	}
	if pretty {
		set ddl($increment(ddl)) = eos
		set:(eos '= "") ddl($increment(ddl)) = ""
	}
	for i=1:1:indices {
		set ddl($increment(ddl)) = indices(i)
		if pretty {
			set ddl($increment(ddl)) = eos
			set:(eos '= "") ddl($increment(ddl)) = ""
		}
	}
		#; Export triggers
	set trigger = ""
	for {
		set trigger = $$$comClassArrayNext(classname,$$$cCLASStrigger,trigger)
		quit:(trigger="")
			#; Skip any internal triggers like %OBJGUID
		continue:($extract(trigger) = "%")
		set ddlWarnings=ddlWarnings_$LB($$$Text("Warning. Trigger creation for '","%SQL.Export")_trigger_$$$Text("' will not be properly captured by DDLExport and will cause a failure in DDLImport. ","%SQL.Export"))
		kill code
		for i=1:1:$length($$$comMemberKeyGet(classname,$$$cCLASStrigger,trigger,$$$cTRIGGERcode),$char(13,10)) {
			set code($increment(code)) = $piece($$$comMemberKeyGet(classname,$$$cCLASStrigger,trigger,$$$cTRIGGERcode),$char(13,10),i)
		}
		set codeidx = 1
		set isLangSQL = 1
		set time  = " " _ $$$comMemberKeyGet(classname,$$$cCLASStrigger,trigger,$$$cTRIGGERtime)
		set event = " " _ $translate($$$comMemberKeyGet(classname,$$$cCLASStrigger,trigger,$$$cTRIGGERevent),"/",",")
			#; UPDATE OF no longer projects to $$$cTRIGGERupdatecolumnlist, it's a line of code in the generated mac routine now
			#; and if UPDATE OF is used, the first line of the trigger method body will terminate with the comment
			#; "From UPDATE OF field list" (see trigger^%qaqpDDLParser2)
			#; The regex string will ascertain that this was indeed generated by the DDL Parser
		if event = " UPDATE" {
			if $match($$$UPPER(code(codeidx)),"\s*IF '\((\{[^\}]+\*C\}\|\|)*\{[^\}]+\*C\}\) QUIT  // FROM UPDATE OF FIELD LIST") {
				set updatelist = ""
				set fieldextractor = ##class(%Regex.Matcher).%New("\{[^\}]+\*C\}",code(codeidx))
				while fieldextractor.Locate() {
					set propname = $$LookUpPropertyNameCom^%apiDDL2(classname,$zstrip($extract(fieldextractor.Group,2,*-3),"<>",""""),1)
						#; propname should not be ""
					set updatelist = updatelist _ $$quoter2($$$EXTPROPsqlcolumnname($$$pEXT,extentname,propname)) _ ","
					set:(updatelist '= "") event = " UPDATE OF " _ $extract(updatelist,1,*-1)
				}
				set codeidx = codeidx + 1
			} else {	##; Not autogenerated, cannot guarantee that it is language SQL
				set isLangSQL = 0
			}
		}
		do append("CREATE TRIGGER " _ $$quoter2($$$comMemberKeyGet(classname,$$$cCLASStrigger,trigger,$$$cTRIGGERsqlname)) _ time _ event)
		do:(+$$$comMemberKeyGet(classname,$$$cCLASStrigger,trigger,$$$cTRIGGERorder)) append("ORDER " _ ^($$$cTRIGGERorder),1)
		do append("ON " _ tablename, 1)
		set oldtable = $$$comMemberKeyGet(classname,$$$cCLASStrigger,trigger,$$$cTRIGGERoldtable)
		set newtable = $$$comMemberKeyGet(classname,$$$cCLASStrigger,trigger,$$$cTRIGGERnewtable)
			#; Can only be equal iff oldtable = newtable = "", else one is "" while the other is not or both are defined
		do:(oldtable '= newtable) append("REFERENCING OLD ROW AS " _ $$quoter2(oldtable) _ " NEW ROW AS " _ $$quoter2(newtable),1)
			#; See trigger^%qaqpDDLParser2, but SQL -> ObjectScript is not a bijective mapping thus it's not worth (or even possible?)
			#; to map the ObjectScript WHEN condition back to "standard" SQL. In other words, do not export a WHEN clause.
		set:($get(code(codeidx)) [ "From WHEN condition") isLangSQL = 0
		do append("FOR EACH " _ $case($$$comMemberKeyGet(classname,$$$cCLASStrigger,trigger,$$$cTRIGGERforeach), "row/object": "ROW_AND_OBJECT", "statement": "STATEMENT", :"ROW"),1)
		set savecodeidx = codeidx
		if isLangSQL {
				#; If isLangSQL is TRUE, then the "first" line of code must be the NEW list (see trigger^%qaqpDDLParser2)
			if code(codeidx) = ($char(9)_"New SQLCODE,%ROWID,%ROWCOUNT") {
					#; If we get this far, check for the following pattern: &sql(...) followed by a SQLCODE/%ok check/set
				kill triggerbody
				set triggerbody = 0
				for {
					set esql = $$ExtractEmbeddedSQL(.code,.codeidx,oldtable,newtable,.isLangSQL)
					set:(esql '= "") triggerbody($increment(triggerbody)) = esql
					quit:('isLangSQL || (codeidx = ""))
				}
				if isLangSQL {
					do append("LANGUAGE SQL")
					do append("BEGIN")
					for i=1:1:triggerbody {
						do append(triggerbody(i) _ ";",1)
					}
					do append("END")
				}
			} else {
				set isLangSQL = 0
			}
		}
		if 'isLangSQL {
			return:'isISC $$$ERROR($$$ISCExclusiveFeature, "a trigger defined with LANGUAGE OBJECTSCRIPT")
			set codeidx = savecodeidx
			do append("LANGUAGE OBJECTSCRIPT")
			do append("{")
			for codeidx=codeidx:1:code {
				do append(code(codeidx))
			}
			do append("}")
		}
		if pretty {
			set ddl($increment(ddl)) = eos
			set:(eos '= "") ddl($increment(ddl)) = ""
		}
	}
	if ddlWarnings'="" {
		for dW=1:1:$LL(ddlWarnings) { set ddl($increment(ddl)) = "-- "_$LG(ddlWarnings,dW)_"--" }
		set ddl($increment(ddl)) = $$$Text("-- Please consider using Class Export instead of DDL Export if you are concerned about any of the preceding warnings.--","%SQL.Export"), ddl($increment(ddl)) = "", ddl($increment(ddl)) = ""
	}
	return $$$OK
.
exportForeignServer
	set pretty = ''pretty
	set:('pretty) ddl($increment(ddl)) = ""
	// note for servers, we already pass in the schema/server name in exact case
	// so schema = exact, table = exact server name
	set serverInfo = $g($$$FSIDXServer($$$UPPER(schema), $$$UPPER(table)))
	set classname = $lg(serverInfo, 1)
	set fullyQualServerName = $$quoter2(schema) _ "." _ $$quoter2(table)
	
	do append("CREATE FOREIGN SERVER "_fullyQualServerName)
	set fdw = $$getFDWShorthandFromClassName^%apiSQL($$$comMemberKeyGet(classname, $$$cCLASSparameter, "FDWNAME", $$$cPARAMdefault))
	do append(" FOREIGN DATA WRAPPER "_fdw, 1)
	if fdw = "CSV" {
		set host = $$$comMemberKeyGet(classname, $$$cCLASSparameter, "HOST", $$$cPARAMdefault)
		do append(" HOST '" _ host _ "'", 1)
	} elseif fdw = "JDBC" || (fdw = "ODBC") {
		set connection = $$$comMemberKeyGet(classname, $$$cCLASSparameter, "CONNECTION", $$$cPARAMdefault)
		do append(" CONNECTION '" _ connection _ "'", 1)
		set delimitedids = $$$comMemberKeyGet(classname, $$$cCLASSparameter, "DELIMITEDIDS", $$$cPARAMdefault)
		do:delimitedids'="" append($s('delimitedids:" NODELIMITEDIDS", 1:" DELIMITEDIDS"), 1)
	} else {
			// custom wrapper class, we allow them to enter anything at parse time
		set host = $$$comMemberKeyGet(classname, $$$cCLASSparameter, "HOST", $$$cPARAMdefault)
		do:host'="" append(" HOST '" _ host _ "'", 1)
		set connection = $$$comMemberKeyGet(classname, $$$cCLASSparameter, "CONNECTION", $$$cPARAMdefault)
		do:connection'="" append(" CONNECTION '" _ connection _ "'", 1)
		set delimitedids = $$$comMemberKeyGet(classname, $$$cCLASSparameter, "DELIMITEDIDS", $$$cPARAMdefault)
		do:delimitedids'="" append($s('delimitedids:" NODELIMITEDIDS", 1:" DELIMITEDIDS"), 1)
	}
	if pretty { // close the statement
		set ddl($increment(ddl)) = eos
		set:(eos '= "") ddl($increment(ddl)) = ""
	}
.
	RETURN $$$OK
	#;-------------------------------------------------------------
append(text="",tablevel=0,tabstop=4)
	if pretty {
		set ddl($increment(ddl)) = $justify("", tabstop * tablevel) _ text
	} else {
		set ddl(ddl) = $select(ddl(ddl) = "": text, 1: ddl(ddl) _ " " _ text)
	}
	quit
}
	#;-------------------------------------------------------------
	#; Handle parsing DEFAULT expressions
	#;
	#; !!! ANY CODE CHANGES HERE SHOULD PROBABLY BE MADE IN $$ExportOnUpdate AS WELL. !!!
	#;
	#;     1. Check for simple numeric literals
	#;     2. Check for simple string literals
	#;     3. Attempt to reverse transpile the expression to the well-
	#;        known keyword/function list (e.g. CURRENT_TIMESTAMP)
	#;            * See $$setdef^%qaqpDDLParser
	#;            * See $$TranslateDefaultValue^%apiDDL
	#;     4. Use 'OBJECTSCRIPT' or throw an error if isISC = 0
	#;
	#; Parameters:
	#;     expr  - the expression to parse, should come from $$$rEXT
	#;     isISC - 0/1 flag that says whether or not the export is for
	#;             an InterSystems product. If FALSE, then this function
	#;             _may_ throw an exception.
	#;
	#; Returns:
	#;     The DEFAULT expression in standard SQL prepended with a space
	#;     e.g. " DEFAULT 1"
	#;-------------------------------------------------------------
ExportDefault(expr="",isISC=1) [] PRIVATE {
	return:(expr = "") ""
	set oexpr = expr
	set expr = $$$LOWER($zstrip(expr,"<>W"))
		#; Remove as many surrounding pairs of parentheses as possible
	while $extract(expr) = "(", $extract(expr,*) = ")" {
		set expr = $extract(expr,2,*-1)
	}
		#; Check if simple numeric literal
	return:($isvalidnum(expr)) " DEFAULT " _ (+expr)
		#; Check if simple string literal
	if $extract(expr) = """" {
		for i=2:1:$length(expr) {
			quit:($extract(expr,i) = """" && ($extract(expr,$increment(i)) '= """"))
		}
		return:(i >= $length(expr)) " DEFAULT '" _ $$$COSString2SQLString($extract(expr,2,*-1)) _ "'"
	}
		#; If we get this far, the default expression is a non-trivial literal.
		#; Attempt to reverse-transpile.
	if expr = "$username" {
		return " DEFAULT CURRENT_USER"
	}
	elseif (expr = "$c(0)") || (expr = "$char(0)") {
		return " DEFAULT ''"
	}
	elseif (expr = "$c(34)") || (expr = "$char(34)") {
		return " DEFAULT '""'"
	}
	elseif $extract(expr,1,7) = "$double" {
		set arg = $extract(expr,8,$locate(expr,"\)",8)-1)
		if (arg = "inf") || (arg = "nan"), 'isISC { return "" }
		return " DEFAULT " _ $$$UPPER(arg)
	}
		#; The regexes are for ObjectScript completeness of shorthands and whitespace ignorance
	elseif $match(expr,"\$zu(til)?\(\s*67\s*,\s*11\s*,\s*\$j(ob)?\s*\)") {
		return " DEFAULT SYSTEM_USER"		##; This is T-SQL and ISC dialect specific?
	}
	elseif (expr = "+$h") || $match(expr,"\$p(iece)?\(\s*\+?\$h(orolog)?(\s*,\s*"",""(\s*,\s*1){0,2})?\)") {
		return " DEFAULT CURRENT_DATE"
	}
	elseif $match(expr,"\$p(iece)?\(\s*\+?\$h(orolog)?\s*,\s*"",""(\s*,\s*2){1,2}\)") {
		return " DEFAULT CURRENT_TIME"
	}
	elseif $match(expr,"\$fn(umber)?\(\s*\$p(iece)?\(\s*\+?\$zu(til)?\(188\)\s*,\s*"",""(\s*,\s*2){1,2}\),("""")?,\d+\)") {
		return:$locate(expr,"\d+\)$",,,prec) " DEFAULT CURRENT_TIME(" _ $extract(prec,1,*-1) _ ")"
	}
	elseif ($extract(expr,1,4) = "$zdt") || ($extract(expr,1,10) = "$zdatetime") {
		set pstart = $locate(expr,"\(")
		set h = $extract(expr,pstart+1,$locate(expr,",",pstart)-1)
		set regex = ##class(%Regex.Matcher).%New("\s*,\s*3,\s*1(,\s*(\d+))?\)",$extract(expr,pstart+$length(h)+1,*))
		if h = "$now(0)" {	##; This is T-SQL and ISC dialect specific?
			return:(regex.Locate()) " DEFAULT GETUTCDATE(" _ $select(regex.Group(1) = "": "", 1: +regex.Group(2)) _ ")"
		} elseif $match(h,"\$zu(til)?\(188\)") {
			return:(regex.Locate()) " DEFAULT CURRENT_TIMESTAMP(" _ $select(regex.Group(1) = "": "", 1: +regex.Group(2)) _ ")"
		}
	}
	elseif $match(expr,"^##class\(\%(library\.)?posixtime\).*") {
		set fstart = $select(expr["%l": 29, 1: 21)
		set pstart = $locate(expr, "\(", fstart)
		set func = $extract(expr, fstart, pstart - 1)
		if func = "currenttimestamp" {
			set prec = $extract(expr,pstart+1,*-1)
			return:(+prec=prec) " DEFAULT CURRENT_TIMESTAMP(" _ +prec _ ")"
		}
		elseif func = "currentutctimestamp" {	##; This is T-SQL and ISC dialect specific?
			set prec = $extract(expr,pstart+1,*-1)
			return:(+prec=prec) " DEFAULT GETUTCDATE(" _ +prec _ ")"
		}
	}
	elseif (expr [ "^%qarfunc") || ($extract(expr,8,22) = ".sql.functions.") {
		if expr [ "$$" {
			set func = $$$UPPER($extract(expr,$locate(expr,"\$\$") + 2, $locate(expr,"\^\%") - 1))
			set ptr = $locate(expr, "\^\%") + 10
		} else {
			set func = $extract(expr,$locate(expr,"\$") + 22, $locate(expr,"\(",22) - 1)
			set ptr = $locate(expr,"\(",22) + 1
		}
		if func = "TODATE" || (func = "TOTIMESTAMP") {
				#; Extract arguments
			set arg1 = "", arg2 = "",state=0
			for ptr=ptr:1:$length(expr) {
				set ch = $extract(expr,ptr)
				if state = 0 {	##; Skip any leading whitespace
					continue:((ch = " ") || (ch = $char(9)))
					quit:(ch '= """")
					set state = $select(arg1 = "": 1, 1: 2)
				} elseif state = 1 {
					if ch = """" {
						if $extract(expr,$increment(ptr)) = """" {
							set arg1 = arg1 _ """"""
							continue
						} else {
							quit:($extract(expr,ptr) '= ",")
							set state = 0
						}
					} else {
						set arg1 = arg1 _ ch
					}
				} elseif state = 2 {
					if ch = """" {
						if $extract(expr,$increment(ptr)) = """" {
							set arg2 = arg2 _ """"""
							continue
						} else {
							quit:($extract(expr,ptr) '= ")")
							return " DEFAULT TO_" _ $extract(func,3,*) _ "('" _ $$$COSString2SQLString(arg1) _ "', '" _ $$$COSString2SQLString(arg2) _ "')"
						}
					} else {
						set arg2 = arg2 _ ch
					}
				}
			}
		}
	}
		#; Only permit trivial literals and numerics for non-ISC exports
	throw:('isISC) ##class(%Exception.StatusException).CreateFromStatus($$$ERROR($$$ISCExclusiveFeature, "DEFAULT OBJECTSCRIPT '" _ $$$COSString2SQLString(oexpr) _ "')"))
		#; Escape single quotes when using DEFAULT OBJECTSCRIPT
	return " DEFAULT OBJECTSCRIPT '" _ $$$COSString2SQLString(oexpr) _ "'"
}
	#;-------------------------------------------------------------
	#; Handle parsing ON UPDATE expressions.
	#;
	#; !!! ANY CODE CHANGES HERE SHOULD PROBABLY BE MADE IN $$ExportDefault AS WELL. !!!
	#;
	#;     1. Check for simple numeric literals
	#;     2. Check for simple string literals
	#;     3. Attempt to reverse transpile the expression to the well-
	#;        known keyword/function list (e.g. CURRENT_TIMESTAMP)
	#;            * See $$setdef^%qaqpDDLParser
	#;            * See $$TranslateComputeCode^%apiDDL
	#;
	#; Parameters:
	#;     expr  - the expression to parse, should come from $$$rEXT
	#;     isISC - 0/1 flag that says whether or not the export is for
	#;             an InterSystems product. If FALSE, then this function
	#;             _may_ throw an exception.
	#;
	#; Returns:
	#;     The ON UPDATE segment in standard SQL prepended with a space
	#;     e.g. " ON UPDATE 1"
	#;-------------------------------------------------------------
ExportOnUpdate(expr="",isISC=1) [] PRIVATE {
	return:(expr = "") ""
	set expr = $$$LOWER($zstrip(expr,"<>W"))
	if $extract(expr,1,8) = "set {*}=" {
		set expr = $extract(expr,9,*)
			#; Remove as many surrounding pairs of parentheses as possible
		while $extract(expr) = "(", $extract(expr,*) = ")" {
			set expr = $extract(expr,2,*-1)
		}	
			#; Check if simple numeric literal
		return:($isvalidnum(expr)) " ON UPDATE " _ (+expr)
			#; Check if simple string literal
		if $extract(expr) = """" {
			for i=2:1:$length(expr) {
				quit:($extract(expr,i) = """" && ($extract(expr,$increment(i)) '= """"))
			}
			return:(i >= $length(expr)) " ON UPDATE '" _ $$$COSString2SQLString($extract(expr,2,*-1)) _ "'"
		}
			#; If we get this far, the default expression is a non-trivial literal.
			#; Attempt to reverse-transpile.
		if expr = "$username" {
			return " ON UPDATE CURRENT_USER"
		}
		elseif (expr = "$c(0)") || (expr = "$char(0)") {
			return " ON UPDATE ''"
		}
		elseif (expr = "$c(34)") || (expr = "$char(34)") {
			return " ON UPDATE '""'"
		}
		elseif $extract(expr,1,7) = "$double" {
			set arg = $extract(expr,8,$locate(expr,"\)",8)-1)
			if (arg = "inf") || (arg = "nan"), 'isISC { return "" }
			return " ON UPDATE " _ $$$UPPER(arg)
		}
			#; The regexes are for ObjectScript completeness of shorthands and whitespace ignorance
		elseif $match(expr,"\$zu(til)?\(\s*67\s*,\s*11\s*,\s*\$j(ob)?\s*\)") {
			return " ON UPDATE SYSTEM_USER"		##; This is T-SQL and ISC dialect specific?
		}
		elseif (expr = "+$h") || $match(expr,"\$p(iece)?\(\s*\+?\$h(orolog)?(\s*,\s*"",""(\s*,\s*1){0,2})?\)") {
			return " ON UPDATE CURRENT_DATE"
		}
		elseif $match(expr,"\$p(iece)?\(\s*\+?\$h(orolog)?\s*,\s*"",""(\s*,\s*2){1,2}\)") {
			return " ON UPDATE CURRENT_TIME"
		}
		elseif $match(expr,"\$fn(umber)?\(\s*\$p(iece)?\(\s*\+?\$zu(til)?\(188\)\s*,\s*"",""(\s*,\s*2){1,2}\),("""")?,\d+\)") {
			return:$locate(expr,"\d+\)$",,,prec) " ON UPDATE CURRENT_TIME(" _ $extract(prec,1,*-1) _ ")"
		}
		elseif ($extract(expr,1,4) = "$zdt") || ($extract(expr,1,10) = "$zdatetime") {
			set pstart = $locate(expr,"\(")
			set h = $extract(expr,pstart+1,$locate(expr,",",pstart)-1)
			set regex = ##class(%Regex.Matcher).%New("\s*,\s*3,\s*1(,\s*(\d+))?\)",$extract(expr,pstart+$length(h)+1,*))
			if h = "$now(0)" {	##; This is T-SQL and ISC dialect specific?
				return:(regex.Locate()) " ON UPDATE GETUTCDATE(" _ $select(regex.Group(1) = "": "", 1: +regex.Group(2)) _ ")"
			} elseif $match(h,"\$zu(til)?\(188\)") {
				return:(regex.Locate()) " ON UPDATE CURRENT_TIMESTAMP(" _ $select(regex.Group(1) = "": "", 1: +regex.Group(2)) _ ")"
			}
		}
		elseif $match(expr,"^##class\(\%(library\.)?posixtime\).*") {
			set fstart = $select(expr["%l": 29, 1: 21)
			set pstart = $locate(expr, "\(", fstart)
			set func = $extract(expr, fstart, pstart - 1)
			if func = "currenttimestamp" {
				set prec = $extract(expr,pstart+1,*-1)
				return:(+prec=prec) " ON UPDATE CURRENT_TIMESTAMP(" _ +prec _ ")"
			}
			elseif func = "currentutctimestamp" {	##; This is T-SQL and ISC dialect specific?
				set prec = $extract(expr,pstart+1,*-1)
				return:(+prec=prec) " ON UPDATE GETUTCDATE(" _ +prec _ ")"
			}
		}
		elseif (expr [ "^%qarfunc") || ($extract(expr,8,22) = ".sql.functions.") {
			if expr [ "$$" {
				set func = $$$UPPER($extract(expr,$locate(expr,"\$\$") + 2, $locate(expr,"\^\%") - 1))
				set ptr = $locate(expr, "\^\%") + 10
			} else {
				set func = $extract(expr,$locate(expr,"\$") + 22, $locate(expr,"\(",22) - 1)
				set ptr = $locate(expr,"\(",22) + 1
			}
			if func = "TODATE" || (func = "TOTIMESTAMP") {
					#; Extract arguments
				set arg1 = "", arg2 = "",state=0
				for ptr=ptr:1:$length(expr) {
					set ch = $extract(expr,ptr)
					if state = 0 {	##; Skip any leading whitespace
						continue:((ch = " ") || (ch = $char(9)))
						quit:(ch '= """")
						set state = $select(arg1 = "": 1, 1: 2)
					} elseif state = 1 {
						if ch = """" {
							if $extract(expr,$increment(ptr)) = """" {
								set arg1 = arg1 _ """"""
								continue
							} else {
								quit:($extract(expr,ptr) '= ",")
								set state = 0
							}
						} else {
							set arg1 = arg1 _ ch
						}
					} elseif state = 2 {
						if ch = """" {
							if $extract(expr,$increment(ptr)) = """" {
								set arg2 = arg2 _ """"""
								continue
							} else {
								quit:($extract(expr,ptr) '= ")")
								return " ON UPDATE TO_" _ $extract(func,3,*) _ "('" _ $$$COSString2SQLString(arg1) _ "', '" _ $$$COSString2SQLString(arg2) _ "')"
							}
						} else {
							set arg2 = arg2 _ ch
						}
					}
				}
			}
		}
	}
	throw ##class(%Exception.StatusException).CreateFromStatus($$$ERROR($$$ISCExclusiveFeature, "custom ON UPDATE code"))
}
	#; Code is adapted from ReplaceFieldReferences^%apiDDL except the goal
	#; is to extract the SQL from the embedded SQL and externalize the {*O}
	#; and {*N} contexts while simultaneously checking if the code is actually
	#; generated from SQL as opposed from ObjectScript
ExtractEmbeddedSQL(&code, &line, oldref, newref, &isLangSQL) [] PRIVATE {
	#define ReadToken(%pos) set token = $extract(loc, %pos), newcode = newcode _ token
	#define ReadToEOL set newcode = newcode _ $extract(loc,i,*), line = line + 1
	
	set newcode = "", inString = 0, inBlockComment = 0, inESQL = 0, parenCount = 0
	set stringDelim = """" ##; this will be conditionally replaced with "'" if inESQL
	for {
		set line = $order(code(line),1,loc)
		return:(line = "") ""
		for i=1:1:$length(loc) {
			$$$ReadToken(i)
			if inString {
				if token = stringDelim {
					set inString = 0
					set stringDelim = """"
				}
			}
			elseif inBlockComment {
				if token = "*" {
					$$$ReadToken($increment(i))
					set:(token = "/") inBlockComment = 0
				}
			}
			elseif inESQL {
				if token = "/" {
					$$$ReadToken($increment(i))
					set:(token = "*") inBlockComment = 1
				}
				elseif token = "-" {
					$$$ReadToken($increment(i))
					if token = "-" { $$$ReadToEOL }
				}
				elseif (token = "'") || (token = """") {
					set stringDelim = token
					set inString = 1
				}
				elseif token = "(" {
					set parenCount = parenCount + 1
				}
				elseif token = ")" {
					return:('$increment(parenCount,-1)) $extract(newcode,1,*-1)
				}
				elseif token = ":" {
					set $extract(newcode,*) = ""
					set token = $extract(loc, $increment(i))
						#; Host variables are only allowed in an ObjectScript context
					if token '= "{" {
						set isLangSQL = 0
						return ""
					}
					set ref = ""
					set token = $extract(loc, $increment(i))
					if token = """" { ##; Go to the closing delimiter
						set ref = $extract(loc, i, $locate(loc, """", i + 1))
						set token = $extract(loc, $increment(i, $length(ref)))
					} else { ##; build the ref token by token
						while token '= "*", token '= "}" {
							set ref = ref _ token
							set token = $extract(loc, $increment(i))
						}
					}
					set:(token = "*") context = $extract(loc, $increment(i))
					set ref = $case(context, "O": oldref _ ".", "N": newref _ ".", 1: "") _ ref
					set newcode = newcode _ ref
					while (token '= "}") { set token = $extract(loc,$increment(i)) }
				}
			}
			else {
				if token = """" {
					set inString = 1
				}
				elseif token = "&" {
					$$$ReadToken($increment(i))  continue:(token '= "s")
					$$$ReadToken($increment(i))  continue:(token '= "q")
					$$$ReadToken($increment(i))  continue:(token '= "l")
					$$$ReadToken($increment(i))  continue:(token '= "(")
					set $extract(newcode,*-4,*) = ""
					set inESQL = 1
					set parenCount = 1
				}
				elseif token = ";" {
					$$$ReadToEOL
				}
				elseif token = "/" {
					$$$ReadToken($increment(i))
					if token = "*" {
						set inBlockComment = 1
					} elseif token = "/" {
						$$$ReadToEOL
					}
				}
			}
		}
		if 'parenCount {
			set isLangSQL = (newcode = ($char(9)_"If SQLCODE<0 Set %ok=0 Quit"))	##; see trigger^%qaqpDDLParser2
			return ""
		}
		set newcode = newcode _ $char(13,10,9)
	}
}
	#;-------------------------------------------------------------
	#; API to create a IRIS SQL DDL Export file of definitions. Used by %SYSTEM.SQL.Schema.ExportDDL
	#;
	#; Parameters:
	#;     schema      		- Name of the schema to export privileges on. Use "*" for all schemas. Default is "*".
	#;     table       		- Name of the table to export privileges on. Use "*" for all tables within the given schema(s). Default is "*".
	#;			         	If schema="*", whatever argument provided is ignored and export all tables/views/procedures.
	#;     file        		- PBR. Optional. Name of the file to write the privileges to. Default is "". If file = "", treat it as a local
	#;                   	array to store the output.
	#;     fopenparms  		- Optional. Parameters to open the file with. Default is "WNS".
	#;     definitions 		- 1/0 Flag. Default is 1. If TRUE, output the table/view definitions
	#;     privileges  		- 1/0 Flag. Default is 1. If TRUE, output the table/view/procedure privileges
	#;     users       		- 1/0 Flag. Default is 1. If TRUE, output the user definitions
	#;     roles       		- 1/0 Flag. Default is 1. If TRUE, output the role definitions
	#;     sysprivs    		- 1/0 Flag. Default is 1. If TRUE, output the system privileges for any users/roles exported.
	#;     eos         		- Script file statement delimiter. Default is "GO".
	#; 	   foreigntables	- 1/0 flag, Default is 1. If TRUE, output foreign table definitions AND privileges
	#; 	   foreignservers	- 1/0 flag, Default is 0. If TRUE, output foreign server definitions AND privileges
	#;
	#; Return Value:
	#;     %Status
	#;
	#;-------------------------------------------------------------
Export(schema="*",table="*",&file="",fopenparms="WNS",definitions=1,privileges=1,users=0,roles=1,sysprivs=1,eos="GO",foreigntables=1,foreignservers=0) [] PUBLIC {
		#; User requested to export nothing...
	return:('(definitions||privileges||users||roles||sysprivs)) $$$OK
	set:(table = "") table = "*"
	set:(schema = "") schema = $$$DefaultSchemaQ
	set ddl = "", lastgrantor="", fobj = $$$NULLOREF, sc = $$$OK
	if file '= "" {
		set fobj = ##class(%Library.File).%New(file)
		$$$QuitOnError(fobj.Open(fopenparms))
	}
	try {
		set ddl($increment(ddl)) = "-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --"
		set:(fobj) ddl($increment(ddl)) = "-- File: " _ $select(fobj.CanonicalName'="":fobj.CanonicalName, 1: file)
		set ddl($increment(ddl)) = "-- IRIS SQL DDL Export"
		set ddl($increment(ddl)) = "-- Date: " _ $zdatetime($horolog,2)
		set ddl($increment(ddl)) = "-- Export of:" _ $select(users:" USERS",1:"") _ $select(roles:" ROLES",1:"") _ $select(definitions:" TABLES/VIEWS",1:"") _ $select(privileges:" PRIVILEGES",1:"")
		set ddl($increment(ddl)) = "-- From Namespace: " _ $namespace
		set ddl($increment(ddl)) = "-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --"
		set ddl($increment(ddl)) = ""
		set:(users) sc = $$ExportUsers^%SYS.SQLSEC(.ddl,sysprivs,eos)
		throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
		set:(roles) sc = $$ExportRoles^%SYS.SQLSEC(.ddl,sysprivs,eos)
		throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
		if definitions || privileges {
			// we'll need to check the $$$FSIDXServer global a few places so we might as well make sure it's the latest version now and update it if not
			if foreignservers, $$$FSIDXGetLowestCommonVersion < $$$FSIDXLatestVersion {
				$$$ThrowOnError($$updateForeignServerIndex^%SYS.SQLSEC)
			}
			set exportMsgPrefix = "-- Export of all " _ $select(definitions&&privileges:"Definitions and Privileges", definitions:"Definitions", privileges:"Privileges")
			if schema = "*" {
					#; Export from all schemas except "%" schemas and INFORMATION_SCHEMA
				set SCHEMA = "&"
				for {
					set SCHEMA = $order(^rINDEXSQL("schema",SCHEMA))
					quit:(SCHEMA = "")
					continue:(SCHEMA = "INFORMATION_SCHEMA" || $$$IsAShardLocalSchema(SCHEMA))
						#; Get exact schema name
					set sch = ^rINDEXSQL("schema",SCHEMA)
					set ddl($increment(ddl)) = exportMsgPrefix _" for schema '" _ sch _ "' --", ddl($increment(ddl)) = ""
					// We should do foreign servers first -- if they want to export FS and foreign tables, then we should make sure the DDL statements for servers get output
					// on top such that they can import in order and have the servers defined early enough to not throw errors for the FT definitions.
					if foreignservers {
						// Reading the surrounding code comments, some seem to imply sch is already exact case, whereas other places take sch and explicitly look for the exact
						// case. I'm guessing a relic of the past -- we'll assume it is exact case as seems to be the case when looking at the global node it's pulled from
						set SERVER = ""
						for {
							set SERVER = $o($$$FSIDXServer(SCHEMA, SERVER), 1, serverInfo)
							quit:(SERVER = "")
							set server = $lg(serverInfo, 5)
							set:(definitions) sc = $$ExportDefinition(sch,server,.ddl,1,eos,1,0,1)
							throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
							if privileges {
								set sc = $$ExportPrivileges^%SYS.SQLSEC(sch, server,7,.ddl,.lastgrantor,eos)
								throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
							}
						}
					}
					set tab = ""
					for {
						set tab = $order(^rINDEXSQL("TABLE",sch,tab))
						quit:(tab = "")
						set:(definitions) sc = $$ExportDefinition(sch,tab,.ddl,1,eos,1,foreigntables,0)
						throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
						if privileges {
								#; Use the exact case of sch and tab
							set iqn = $$$GetExactIntQualifiedName(sch,tab)
							set sc = $$ExportPrivileges^%SYS.SQLSEC($$$SchemaFromIQN(iqn), $$$TableFromIQN(iqn),1,.ddl,.lastgrantor,eos)
							throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
						}
					}
					set view = ""
					for {
						set view = $order(^rINDEXSQL("VIEW",sch,view))
						quit:(view = "")
						set:(definitions) sc = $$ExportDefinition(sch,view,.ddl,1,eos,1,0,0)
						throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
						if privileges {
								#; Use the exact case of sch and tab
							set iqn = $$$GetExactIntQualifiedName(sch,view)
							set sc = $$ExportPrivileges^%SYS.SQLSEC($$$SchemaFromIQN(iqn),$$$TableFromIQN(iqn),3,.ddl,.lastgrantor,eos)
							throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
						}
					}
					set PROC = ""
					for {
						set PROC = $order(^oddPROC(SCHEMA,PROC))
						quit:(PROC = "")
						continue:($get($$$PROChidden($$$pPROC,SCHEMA,PROC)))
						set:(privileges) sc = $$ExportPrivileges^%SYS.SQLSEC($get($$$PROCschema($$$pPROC,SCHEMA,PROC)),$get($$$PROCname($$$pPROC,SCHEMA,PROC)),9,.ddl,.lastgrantor,eos)
						throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
					}
				}
			} else {
					#; Export from a single schema
					#; Get the exact schema name
				// in the process of doing MJG260, found this previously didn't throw an error if the schema wasn't found, but we should or we'll just get a <SUBSCRIPT> error 
				// Previous code overwrites schema with the exact name, if $d() is zero it won't overwrite the schema variable so we can use it in the error msg
				if '$d(^rINDEXSQL("schema",$$$IDName(schema)), schema) {
					RETURN $$$ERROR($$$SQLError, -473, $$sqlcode^%apiSQL(-473))
				}
				if table = "*" {
						#; Export all tables within a schema
					set ddl($increment(ddl)) = exportMsgPrefix _" for schema '" _ schema _ "' --", ddl($increment(ddl)) = ""
					set SCHEMA = $$$UPPER(schema)
					// we should do foreign servers first -- if they want to export FS and foreign tables, then we should make sure the DDL statements for servers get output
					// first such that they can import in order and have the servers defined early enough to not throw errors for the FT definitions.
					if foreignservers {
						// Reading the surrounding code comments, some seem to imply sch is already exact case, whereas other places take sch and explicitly look for the exact
						// case. I'm guessing a relic of the past -- we'll assume it is exact case as seems to be the case when looking at the global node it's pulled from
						set SERVER = ""
						for {
							set SERVER = $o($$$FSIDXServer(SCHEMA, SERVER), 1, serverInfo)
							quit:(SERVER = "")
							set server = $lg(serverInfo, 5)
							set:(definitions) sc = $$ExportDefinition(schema,server,.ddl,1,eos,1,0,1)
							throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
							if privileges {
								// 3rd argument = table type. for privileges, servers take the type # 7
								set sc = $$ExportPrivileges^%SYS.SQLSEC(schema, server,7,.ddl,.lastgrantor,eos)
								throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
							}
						}
					}
					set tab = ""
					for {
						set tab = $order(^rINDEXSQL("TABLE",schema,tab))
						quit:(tab = "")
						set:(definitions) sc = $$ExportDefinition(schema,tab,.ddl,1,eos,1,foreigntables,0)
						throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
						set:(privileges) sc = $$ExportPrivileges^%SYS.SQLSEC(schema,tab,1,.ddl,.lastgrantor,eos)
						throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
					}
					set view = ""
					for {
						set view = $order(^rINDEXSQL("VIEW",schema,view))
						quit:(view = "")
						set:(definitions) sc = $$ExportDefinition(schema,view,.ddl,1,eos,1,0,0)
						throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
						set:(privileges) sc = $$ExportPrivileges^%SYS.SQLSEC(schema,view,3,.ddl,.lastgrantor,eos)
						throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
					}
					set PROC = ""
					for {
						set PROC = $order(^oddPROC(SCHEMA,PROC))
						quit:(PROC = "")
						continue:($get($$$PROChidden($$$pPROC,SCHEMA,PROC)))
						set:(privileges) sc = $$ExportPrivileges^%SYS.SQLSEC(schema,$get($$$PROCname($$$pPROC,SCHEMA,PROC)),9,.ddl,.lastgrantor,eos)
						throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
					}
				} else {
						#; Export a single table from a single schema
					set SCHEMA = $$$UPPER(schema)
					set iqn = $$$GetExactIntQualifiedName(schema,table)
					if iqn '= "" {
						set table = $$$TableFromIQN(iqn)
						set ttype = $$$GetTableTypeFromIQN(iqn)
					} elseif $data(^oddPROC(SCHEMA,$$$IDName(table))) {
						set table = $get($$$PROCname($$$pPROC,SCHEMA, $$$IDName(table)))
						set ttype = 9
					} elseif foreignservers, $d($$$FSIDXServer(SCHEMA, $$$UPPER(table)), serverInfo) { // it's a foreign server
						set isForeignServer = 1
						set schema = $lg(serverInfo, 4)		// get exact case
						set table = $lg(serverInfo, 5)		// get exact case
						set ttype = 7
					} else {
						return $$$EMBEDSC($$$ERROR($$$TableDoesNotExist, schema _ "." _ table), $$$ERROR($$$GeneralError, "No object matched the criteria for export; please review schema name, object name, and export flags"))
					}
					set ddl($increment(ddl)) = exportMsgPrefix _ " for '" _ schema _ "." _ table _ "' --", ddl($increment(ddl)) = ""
					set:(definitions) sc = $$ExportDefinition(schema,table,.ddl,1,eos,1,foreigntables,+$g(isForeignServer)) 
					throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
					set:(privileges) sc = $$ExportPrivileges^%SYS.SQLSEC(schema,table,ttype,.ddl,.lastgrantor,eos)
					throw:($$$ISERR(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)
				}
			}
		}
		if fobj {
			for i=1:1:ddl {
				do fobj.WriteLine(ddl(i))
			}
		} else {
			merge file = ddl
		}
	} catch ex {
		set sc = $$$ERROR($$$DDLExportFailed,"'" _ schema _ "." _ table _ $select($isobject(fobj): "' to " _ $select(fobj.CanonicalName'="": "'" _ fobj.CanonicalName _ "'", 1: file), 1:"'"))
		set sc = $$$EMBEDSC(sc, ex.AsStatus())
	}
	do:(fobj) fobj.Close()
	return sc
}
	#;-------------------------------------------------------------
	#; Standalone utility implemented by DPV3372 for Quest Diagnostics / Care360
	#;
	#; Exports queries from the current namespace to a SQL script file or to $principal.
	#;
	#; Parameters:
	#;     file          : Name of the file to export the SQL statements to. Default is "".
	#;                     If "", write to the current principal device ($principal).
	#;     fopenparms    : Parameters to open the file with. Default is "WNS".
	#;     eos           : Script file statement delimiter. Default is "GO".
	#;     cachedQueries : 1/0 Flag. Default is 1. If 1, export SQL queries from cached queries
	#;     classQueries  : 1/0 Flag. Default is 1. If 1, export SQL queries from SQL class queries
	#;     classMethods  : 1/0 Flag. Default is 1. If 1, export embedded SQL queries from class methods
	#;     routines      : 1/0 Flag. Default is 1. If 1, export embedded SQL queries from MAC routines (excluding system routines)
	#;     display       : 1/0 Flag. Default is 0. If 1, display progress of the export on the screen
	#;     mapped        : 1/0 Flag. Default is 1. If 1, export queries from mapped classes. If 0, export only from local classes.
	#;
	#;-------------------------------------------------------------
ExportSQL(file="",fopenparms="WNS",eos="GO",cachedQueries=1,classQueries=1,classMethods=1,routines=1,display=0,mapped=1) [SQLCODE,%ROWID,%ROWCOUNT,name,class,query] PUBLIC {
	new %classname, class, %methodname, name, query, %ROWCOUNT, %ROWID, SQLCODE
	set qCount = 0
	if file '= "" {
		set fobj = ##class(%Library.File).%New(file)
		$$$QuitOnError(fobj.Open(fopenparms))
	} else {
		set file = $principal
	}
	try {
		if cachedQueries {
			set rtn = ""
			for {
				set rtn = $order($$$CQ("QueryText",rtn))
				quit:(rtn = "")
				set ok = 0
				for i=1:1:$get($$$CQ("QueryText",rtn,0)) {
					set sql = $$$UPPER($$$StripLeadingWhiteSpace($get($$$CQ("QueryText",rtn,i))))
					continue:($extract(sql,1,2) = "--") ##; Skip SQL comments
					if $case($extract(sql,1,6),"SELECT":1,"INSERT":1,"UPDATE":1,"DELETE":1,:0) {
						set ok = 1
						quit
					}
				}
				continue:('ok)	##; Not a SELECT/INSERT/UPDATE/DELETE query
				set qCount = qCount + 1
				write:(display) !, "Export SQL Text for Cached Query: " _ rtn _ ".."
				use file
				write !,"  -- SQL statement from Cached Query " _ rtn
				use $principal
				if $get($$$CQ("QueryText",rtn,0))=1 {
					set sql=$g($$$CQ("QueryText",rtn,1))
					for i = "RUNTIME","LOGICAL","DISPLAY","ODBC" {
						if sql[("~"_i_"~") {
							set sql = $piece(sql,"~"_i_"~")
							quit
						}
					}
					use file
					write !,sql
					use $principal
				}
				elseif $get($$$CQ("QueryText",rtn,0))>1 {
					for i=1:1:$$$CQ("QueryText",rtn,0) {
						use file
						write !,$get($$$CQ("QueryText",rtn,i))
						use $principal
						write:(display) "."
					}
				}
				use file
				write !,eos
				use $principal
				write:(display) ?72,"Done"
			}
		}
		set tDest = $$$GBLDB(^oddDEF)
		if classQueries {
			&sql(DECLARE expcq CURSOR FOR
			     SELECT Name, parent, SqlQuery
			     INTO :name, :class, :query
			     FROM %Dictionary.QueryDefinition
			     WHERE SqlQuery IS NOT NULL
			     AND NOT (parent %STARTSWITH '%')
			)
			&sql(OPEN expcq)
			for {
				&sql(FETCH expcq)
				quit:(SQLCODE)
					#; This class is not defined in the local database, so it must be mapped
				if 'mapped, '$data(^|tDest|rINDEXCLASS(class)) { continue }
				set qCount = qCount + 1
				write:(display) !, "Export SQL statement for Class Query: " _ class _ "." _ name _ "..."
				use file
				write !, "  -- SQL statement from Class Query " _ class _ "." _ name
				write !, "#import ", $$$AllButLastPiece(class,".")
				write !, $$$StripTrailingWhiteSpace($$$StripLeadingWhiteSpace(query)), !, eos
				use $principal
				write:(display) ?72, "Done"
			}
			&sql(CLOSE expcq)
		}
		if classMethods {
			new %codein, %codeout
			set lastclass = ""
			&sql(DECLARE expcm CURSOR FOR
			     SELECT Name, parent
			     INTO :name, :class
			     FROM %Dictionary.MethodDefinition
			     WHERE ClassMethod = 1
			     AND CodeMode = 'code'
			     AND NOT (parent %STARTSWITH '%')
			     AND parent->Hidden NOT= 1
			)
			&sql(OPEN expcm)
			for {
				&sql(FETCH expcm)
				quit:(SQLCODE)
					#; This class is not defined in the local database, so it must be mapped
				if 'mapped,'$data(^|tDest|rINDEXCLASS(class)) { continue }
					#; Now get the code for this method
				kill %codein, ^||%sql.extract
				set %classname = class
					#; Add class context
				set %codein($i(%codein(0))) = "#classcontext " _ class
					#; If the class has been compiled, get the include files for the class from COM
				set systeminclude=0
				if $$$comClassKeyDefined(class,$$$cCLASSincludecodeall) {
					set inc = ""
					for {
						set inc = $$$comClassArrayNext(class,$$$cCLASSincludecodeall,inc)
						quit:(inc = "")
						set %codein($increment(%codein(0))) = "#include " _ inc
						if inc="%systemInclude" { set systeminclude=1 }
					}
				}
					#; Otherwise get the include files from the definition
				else {
					set includes = $$$defClassKeyGet(class,$$$cCLASSincludecode)
					if includes '= "" {
						for i=1:1:$length(includes,",") {
							set %codein($increment(%codein(0))) = "#include " _ $piece(includes,",",i)
							if $piece(includes,",",i)="%systemInclude" { set systeminclude=1 }
						}
					}
				}
				if 'systeminclude { set %codein($increment(%codein(0))) = "#include %systemInclude" }	// Always include %systemInclude
				set tSomeCode = 0, tSomeSQL = 0
				for i=1:1:$$$defMemberKeyGet(class,$$$cCLASSmethod,name,$$$cMETHimplementation) {
					set tLine = $$$defMemberArrayGet(class,$$$cCLASSmethod,name,$$$cMETHimplementation,i)
					set %codein($increment(%codein(0))) = tLine
					set:$$$UPPER(tLine)["&SQL"||($$$UPPER(tLine)["##SQL") tSomeSQL = 1
					set:(i = 1) tSomeCode = 1
				}
					#; Skip method with no code
				continue:('tSomeCode)
					#; Skip method with no SQL code
				continue:('tSomeSQL)
				set %methodname = name
				set %codein($increment(%codein(0))) = "#endclasscontext " _ class
				do LINES^%qarmac("%codein","%codeout",,,,1,,,,,,,,,,,,.success)
					#; Skip if there is no SQL to output
				continue:'$data(^||%sql.extract)
				write:display !, "Export SQL statement from Class Method: " _ class _ "." _ name _ "..."
				use file
				write !, "  -- SQL statement(s) from Class Method " _ class _ "." _ name
				write !, "#import " _ $$$AllButLastPiece(class,".")
				for i=1:1:^||%sql.extract {			##; For each statement
					set ok = 1
					for j=1:1:^||%sql.extract(i) {	##; For each line
						if j = 1 {
							set sql = $$$UPPER($$$StripTrailingWhiteSpace($$$StripLeadingWhiteSpace(^||%sql.extract(i,j))))
							if $case($extract(sql,1,6),"SELECT":0,"UPDATE":0,"DELETE":0,"DECLAR":0,:1) {
								set ok = 0
								quit
							}
							set qCount = qCount + 1
								#; Remove 'DECLARE <XXX> CURSOR FOR '
							if $extract(sql,1,7) = "DECLARE" {
								if sql [ "SELECT" {
									write !, "SELECT" _ $piece(sql,"SELECT",2,*)
									continue
								}
								set sql2 = $$$StripTrailingWhiteSpace($$$StripLeadingWhiteSpace(^||%sql.extract(i,j+1)))
									#; Remove the entire first line; SELECT begins on line two
								continue:($$$UPPER($extract(sql2,1,6)) = "SELECT")
									#; Remove the entire first line and 'FOR ' from the second line; SELECT begins after the 'FOR ' on line two
								if $$$UPPER($extract(sql2,1,10)) = "FOR SELECT" {
									set ^||%sql.extract(i,j+1) = $extract($$$StripTrailingWhiteSpace($$$StripLeadingWhiteSpace(^||%sql.extract(i,j+1))),5,*)
									continue
								}
							}
						}
							#; Output the line
						write !, $$$StripTrailingWhiteSpace($$$StripLeadingWhiteSpace(^||%sql.extract(i,j)))
					}
					write:(ok) !,eos
				}
				use $principal
				write:(display) ?72, "Done"
			}
			&sql(CLOSE expcm)
		}
		set tDest = $$$GBLDB(^rMAC)
		if routines {
			new %codein, %codeout
			set rtn = "&"
			for {
				set rtn = $order(^rMAC(rtn))
				quit:(rtn = "")
					#; Continue if not a MAC routine
				continue:('$data(^rINDEX(rtn,"MAC"),data))
					#; Skip cached queries
				continue:($$$CQPrefix = $extract(rtn,1,$length($$$CQPrefix)))
					#; This routine is not defined in the local database, so it must be mapped
				if 'mapped, '$data(^|tDest|rINDEX(rtn,"MAC")) continue
					#; Now get the code for this routine
				kill %codein, ^||%sql.extract
				merge %codein = ^rMAC(rtn,0)
				do LINES^%qarmac("%codein","%codeout",,,,2)
					#; Skip if there is no SQL to output
				continue:('$get(^||%sql.extract))
				write:(display) !, "Export SQL statement(s) from routine: " _ rtn _ ".MAC..."
				use file
				write !, "  -- SQL statement(s) from Routine " _ rtn _ ".MAC"
				write !, "#import " _ $$$DefaultSchemaQ
				for i=1:1:^||%sql.extract {			##; For each statement
					set ok = 1, lookingForSQL = 1
					kill output
					for j=1:1:^||%sql.extract(i) {	##; For each line
						set line = ^||%sql.extract(i,j)
						if lookingForSQL, $extract(line) '= "#" {
							set lookingForSQL = 0
							set sql = $$$UPPER($$$StripTrailingWhiteSpace($$$StripLeadingWhiteSpace(line)))
							if $case($extract(sql,1,6),"SELECT":0,"UPDATE":0,"DELETE":0,"DECLAR":0,:1) {
								set ok = 0
								quit
							}
							set qCount = qCount+1
								#; Remove 'DECLARE <XXX> CURSOR FOR '
							if $extract(sql,1,7) = "DECLARE" {
								if sql [ "SELECT" {
									write !, "SELECT" _ $piece(sql,"SELECT",2,*)
									continue
								}
								set sql2 = $$$StripTrailingWhiteSpace($$$StripLeadingWhiteSpace(^||%sql.extract(i,j+1)))
									#; Remove the entire first line; SELECT begins on line two
								continue:($$$UPPER($extract(sql2,1,6)) = "SELECT")
									#; Remove the entire first line and 'FOR ' from the second line; SELECT begins after the 'FOR ' on line two
								if $$$UPPER($extract(sql2,1,10)) = "FOR SELECT" {
									set ^||%sql.extract(i,j+1) = $extract($$$StripTrailingWhiteSpace($$$StripLeadingWhiteSpace(^||%sql.extract(i,j+1))),5,*) continue	// remove 'DECLARE <XXX> CURSOR FOR ' (First entire line and 'FOR ' from second line, SELECT begins after FOR on line two)
								}
							}
						} elseif lookingForSQL, $extract(line) = "#" {
							set output($increment(output)) = line
							continue
						}
						if $data(output) {
							for ii=1:1:output { write !, output(ii) }
							kill output
						}
							#; Output the line
						write !,$$$StripTrailingWhiteSpace($$$StripLeadingWhiteSpace(^||%sql.extract(i,j)))
					}
					write:(ok) !,eos
				}
				use $principal
				write:(display) ?72,"Done"
			}
		}
		use file
		write !!, qCount _ " SQL statements in this script file.", !, "<End Of File>"
		use $principal
		write:(display) !!,qCount _ " SQL statements exported to script file " _ file,!
		close file
		return $$$OK
	} catch ex {
		use $principal
		if display {
			write !!,"An unexpected error occurred:  ",ex.AsSystemError()
			write:($get(SQLCODE) < 0) !,"SQLCODE = " _ SQLCODE _ "  " _ $$sqlcode^%apiSQL(SQLCODE)
			write:($get(%msg) '= "") !, "%msg = " _ %msg
		}
		close file
		return ex.AsStatus()
	}
}
.
datatype(data) [] PRIVATE {
	return $case($listget(data,5),
		-7: "BIT",
		-6: "TINYINT",
		-5: "BIGINT",
		-4: "LONGVARBINARY",
		-3: "VARBINARY",
		-1: "LONGVARCHAR",
		 2: "NUMERIC(" _ $listget(data,7) _ "," _ $listget(data,9) _ ")",
		 4: "INTEGER",
		 5: "SMALLINT",
		 8: "DOUBLE",
		 9: "DATE",
		10: "TIME",
		11: "TIMESTAMP",
		  : "VARCHAR(" _ $listget(data,8) _ ")"
	)
}
.
partitionkey(classname)
	new index,partkey,pk,pp,pt
	set index="",partkey="",pk="",pp="",pt=""
	for  { 
		set index=$$$defMemberNext(classname,$$$cCLASSindex,index)
		quit:index=""
		continue:$$$defMemberKeyGet(classname,$$$cCLASSindex,index,$$$cINDEXpartitionkey)=0
		set partkey=$$$defMemberKeyGet(classname,$$$cCLASSindex,index,$$$cINDEXproperties)
		quit
	}
	RETURN:index="" ""
	set partkey=$tr(partkey,"()","^")
	for index=1:1:$l(partkey,",") {
		set pp=$p(partkey,",",index)
		set pk=pk_$p(pp,"^")_"|"
		set pt=$e($p(pp,"^",2))
		set pk=pk_pt_"|"
		if pt="l" {
			set pk=pk_"|^"
			continue
		}
		set pt=$p(pp,"^",3)
		set pk=pk_$p(pt," ")_"|"_$p(pt," ",2)
		set pk=pk_"^"
	}
	RETURN pk
.
#INCLUDE %quoter
---
