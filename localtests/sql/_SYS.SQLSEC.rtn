VerifyUserList(User) PUBLIC {
	s User=$$$UPPER(User)
	s VUsers=""
	$$$AddSecurityRoleTemporary
	f i=1:1:$L(User,",") {
		s user=$P(User,",",i)
		s exists=$$$SecurityUsersExists(user,data)
		s:exists=0 exists=$$$SecurityRolesExists(user,data)
		if exists s VUsers=VUsers_","_user
		else  s VUsers="" quit
	}
	q VUsers
 }
	// Record an Audit entry for an SQLCODE=-99 error
Audit99(eventdata,description,priv,type,relation,fields) [] PUBLIC {
	set:$g(description)="" description="SQLPrivilege error, User '"_$Username_"' not Privileged"
	set addeddesc=""
	if $g(priv)'="" { set addeddesc=$$$NL_"SQL Privilege: "_$$privname(priv) }
	if $g(type)'="" { set addeddesc=addeddesc_$$$NL_"SQL Object Type: "_$case(type,1:"TABLE",3:"VIEW",4:"CUBE",5:"SCHEMA",6:"ML_CONFIGURATION",9:"STORED PROCEDURE",:"<UNKNOWN>") }
	if $g(relation)'="" { set addeddesc=addeddesc_$$$NL_"SQL Object Name: "_relation }
	if $g(fields)'="" { set addeddesc=addeddesc_$$$NL_"SQL Object's Fields: "_$listtostring(fields) }
	d $SYSTEM.Security.AuditID($$$AUDITSQLPRIVILEGEFAILURE,eventdata_addeddesc,description)
	RETURN
}
.
/// Convert single-character action code to SQL privilege name
/// used for auditing
ActionToName(action) {
    RETURN $case(action,
        "s":"SELECT",
        "i":"INSERT",
        "u":"UPDATE",
        "d":"DELETE",
        "r":"REFERENCES",
        "a":"ALTER",
        "e":"EXECUTE",
        "l":"USE",
        :"UnknownAction")
}
.
/// Convert numeric object type to SQL object type name
/// used for auditing
ObjectTypeToName(type) {
    RETURN $case(type,
        1:"TABLE",
        3:"VIEW",
        4:"CUBE",
        5:"SCHEMA",
        6:"ML_CONFIGURATION",
        7:"FOREIGN SERVER",
        9:"PROCEDURE",
        :"UnknownObjectType")
}
.
/// Audit a Grant event if it needs to be audited.
/// Make sure to call "$$$AddSecurityRoleTemporary" before calling this function, because this contains the $$$SecurityUsersExists().
/// Parameters:
///        isSystem         - 0/1 for Object Privileges (0) or System Privileges (1)
///        user             - the user being granted
///        grantor   		- username granting this privilege
///        act              - the privilege being granted
///        object           - on which object is the privilege being granted
///        withGrantOption  - 0/1 for WITH GRANT OPTION
///        noAudit          - same as 'noAudit' flag, 0/1 suppress audit logging (for %ExecDirectNoAudit)
auditGrant(isSystem=0,user,grantor,act,object="",withGrantOption=0,noAudit=0) {
	if isSystem { // system privilege, no 'withGrantOption' or 'object'.
		if $$$SecurityRolesExists($$$LOWER(user),data) { // this is a role
			set auditEvent=$$$AUDITROLECHANGE
			// See if need to audit, early return if don't need to audit
			// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) RoleChange event is enabled
			set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","RoleChange")
			RETURN:'audit
			set roleName=$$$GetSecurityRolesName(data)
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedSystemPrivilegeToRole",grantor,act,roleName)
		} elseif $$$SecurityUsersExists($$$LOWER(user),data) { // this is a user
			// Note that $$$SecurityRolesExists() has embedded "$$$AddSecurityRoleTemporary" but not this $$$SecurityUsersExists(), so make sure to call "$$$AddSecurityRoleTemporary" before calling this auditGrant()!
			set auditEvent=$$$AUDITUSERCHANGE
			// See if need to audit, early return if don't need to audit
			// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) UserChange event is enabled
			set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","UserChange")
			RETURN:'audit
			set userName=$$$GetSecurityUsersName(data)
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedSystemPrivilegeToUser",grantor,act,userName)
		} else {
			RETURN
		}
		do $SYSTEM.Security.AuditID(auditEvent,auditMsg,$$$FormatMsg($$$AuditMsg,"SystemPrivilegeGranted"))
		RETURN
	} else { //object privilege
		set objectNameWithType=$$ObjectTypeToName($p(object,",",1))_" "_$p(object,",",2)
		if $$$SecurityRolesExists($$$LOWER(user),data) { // this is a role
			set auditEvent=$$$AUDITROLECHANGE
			// See if need to audit, early return if don't need to audit
			// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) RoleChange event is enabled
			set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","RoleChange")
			RETURN:'audit
			set roleName=$$$GetSecurityRolesName(data)
			if withGrantOption {
				set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedObjectPrivilegeToRoleWithGrantOption",grantor,$$ActionToName(act),objectNameWithType,roleName)
			} else {
				set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedObjectPrivilegeToRole",grantor,$$ActionToName(act),objectNameWithType,roleName)
			}
		} elseif $$$SecurityUsersExists($$$LOWER(user),data) { // this is a user
			// Note that $$$SecurityRolesExists() has embedded "$$$AddSecurityRoleTemporary" but not this $$$SecurityUsersExists(), so make sure to call "$$$AddSecurityRoleTemporary" before calling this auditGrant()!
			set auditEvent=$$$AUDITUSERCHANGE
			// See if need to audit, early return if don't need to audit
			// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) UserChange event is enabled
			set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","UserChange")
			RETURN:'audit
			set userName=$$$GetSecurityUsersName(data)
			if withGrantOption {
				set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedObjectPrivilegeToUserWithGrantOption",grantor,$$ActionToName(act),objectNameWithType,userName)
			} else {
				set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedObjectPrivilegeToUser",grantor,$$ActionToName(act),objectNameWithType,userName)
			}
		} else {
			RETURN
		}
		do $SYSTEM.Security.AuditID(auditEvent,auditMsg,$$$FormatMsg($$$AuditMsg,"ObjectPrivilegeGranted"))
		RETURN
	}
}
.
/// Audit a Grant on some field event if it needs to be audited.
/// Make sure to call "$$$AddSecurityRoleTemporary" before calling this function, because this contains the $$$SecurityUsersExists().
/// Parameters:
///        user             - the user being granted
///        grantor   	    - username granting this privilege
///        act              - the privilege being granted
///        object           - on which object is the privilege being granted
///        field            - on which field of the object is the privilege being granted
///        withGrantOption  - 0/1 for WITH GRANT OPTION
///        noAudit          - same as 'noAudit' flag, 0/1 suppress audit logging (for %ExecDirectNoAudit)
auditGrantField(user,grantor,act,object,field="",withGrantOption=0,noAudit=0) {
	set objectNameWithType=$$ObjectTypeToName($p(object,",",1))_" "_$p(object,",",2)
	if $$$SecurityRolesExists($$$LOWER(user),data) { // this is a role
		set auditEvent=$$$AUDITROLECHANGE
		// See if need to audit, early return if don't need to audit
		// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) RoleChange event is enabled
		set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","RoleChange")
		RETURN:'audit
		set roleName=$$$GetSecurityRolesName(data)
		if withGrantOption {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedFieldToRoleWithGrantOption",grantor,$$ActionToName(act),field,objectNameWithType,roleName)
		} else {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedFieldToRole",grantor,$$ActionToName(act),field,objectNameWithType,roleName)
		}
	} elseif $$$SecurityUsersExists($$$LOWER(user),data) { // this is a user
	    // Note that $$$SecurityRolesExists() has embedded "$$$AddSecurityRoleTemporary" but not this $$$SecurityUsersExists(), so make sure to call "$$$AddSecurityRoleTemporary" before calling this auditGrantField()!
		set auditEvent=$$$AUDITUSERCHANGE
		// See if need to audit, early return if don't need to audit
		// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) UserChange event is enabled
		set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","UserChange")
		RETURN:'audit
		set userName=$$$GetSecurityUsersName(data)
		if withGrantOption {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedFieldToUserWithGrantOption",grantor,$$ActionToName(act),field,objectNameWithType,userName)
		} else {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedFieldToUser",grantor,$$ActionToName(act),field,objectNameWithType,userName)
		}
	} else {
		RETURN
	}
	do $SYSTEM.Security.AuditID(auditEvent,auditMsg,$$$FormatMsg($$$AuditMsg,"ObjectPrivilegeGranted"))
	RETURN
}
.
/// Audit an update of Grant Option of some existing privilege event if it needs to be audited.
/// Make sure to call "$$$AddSecurityRoleTemporary" before calling this function, because this contains the $$$SecurityUsersExists().
/// Parameters:
///        user             - the user being granted
///        grantor   		- username granting this privilege
///        act              - the privilege being granted
///        object           - on which object is the privilege being granted
///        withGrantOption  - 0/1 for WITH GRANT OPTION
///        noAudit          - same as 'noAudit' flag, 0/1 suppress audit logging (for %ExecDirectNoAudit)
auditGrantOptUpdate(user,grantor,act,object,withGrantOption,noAudit=0) {
	set objectNameWithType=$$ObjectTypeToName($p(object,",",1))_" "_$p(object,",",2)
	if $$$SecurityRolesExists($$$LOWER(user),data) { // this is a role
		set auditEvent=$$$AUDITROLECHANGE
		// See if need to audit, early return if don't need to audit
		// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) RoleChange event is enabled
		set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","RoleChange")
		RETURN:'audit
		set roleName=$$$GetSecurityRolesName(data)
		if withGrantOption {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedGrantOptionToRole",grantor,$$ActionToName(act),objectNameWithType,roleName)
			do $SYSTEM.Security.AuditID(auditEvent,auditMsg,$$$FormatMsg($$$AuditMsg,"ObjectPrivilegeGranted"))
			RETURN
		} else {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedGrantOptionFromRole",grantor,$$ActionToName(act),objectNameWithType,roleName)
			do $SYSTEM.Security.AuditID(auditEvent,auditMsg,$$$FormatMsg($$$AuditMsg,"ObjectPrivilegeRevoked"))
			RETURN
		}
	} elseif $$$SecurityUsersExists($$$LOWER(user),data) { // this is a user
		// Note that $$$SecurityRolesExists() has embedded "$$$AddSecurityRoleTemporary" but not this $$$SecurityUsersExists(), so make sure to call "$$$AddSecurityRoleTemporary" before calling this auditGrantOptUpdate()!
		set auditEvent=$$$AUDITUSERCHANGE
		// See if need to audit, early return if don't need to audit
		// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) UserChange event is enabled
		set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","UserChange")
		RETURN:'audit
		set userName=$$$GetSecurityUsersName(data)
		if withGrantOption {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedGrantOptionToUser",grantor,$$ActionToName(act),objectNameWithType,userName)
			do $SYSTEM.Security.AuditID(auditEvent,auditMsg,$$$FormatMsg($$$AuditMsg,"ObjectPrivilegeGranted"))
			RETURN
		} else {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedGrantOptionFromUser",grantor,$$ActionToName(act),objectNameWithType,userName)
			do $SYSTEM.Security.AuditID(auditEvent,auditMsg,$$$FormatMsg($$$AuditMsg,"ObjectPrivilegeRevoked"))
			RETURN
		}
	}
	RETURN
}
.
/// Audit a Revoke event if it needs to be audited.
/// Make sure to call "$$$AddSecurityRoleTemporary" before calling this function, because this contains the $$$SecurityUsersExists().
/// Parameters:
///        isSystem         - 0/1 for Object Privileges (0) or System Privileges (1)
///        user             - the user being revoked
///        grantor   		- username revoking this privilege
///        act              - the privilege being revoked
///        object           - on which object is the privilege being revoked
///        casc             - 0/1 for restrict(default mode) (0) or 'with CASCADE.' (1)
///        noAudit          - same as 'noAudit' flag, 0/1 suppress audit logging (for %ExecDirectNoAudit)
auditRevoke(isSystem=0,user,grantor,act,object="",casc=0,noAudit=0) {
	if isSystem { // system privilege, no 'Cascade' or 'object'.
		if $$$SecurityRolesExists($$$LOWER(user),data) { // this is a role
			set auditEvent=$$$AUDITROLECHANGE
			// See if need to audit, early return if don't need to audit
			// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) RoleChange event is enabled
			set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","RoleChange")
			RETURN:'audit
			set roleName=$$$GetSecurityRolesName(data)
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedSystemPrivilegeFromRole",grantor,act,roleName)
		} elseif $$$SecurityUsersExists($$$LOWER(user),data) { // this is a user
		    // Note that $$$SecurityRolesExists() has embedded "$$$AddSecurityRoleTemporary" but not this $$$SecurityUsersExists(), so make sure to call "$$$AddSecurityRoleTemporary" before calling this auditRevoke()!
			set auditEvent=$$$AUDITUSERCHANGE
			// See if need to audit, early return if don't need to audit
			// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) UserChange event is enabled
			set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","UserChange")
			RETURN:'audit
			set userName=$$$GetSecurityUsersName(data)
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedSystemPrivilegeFromUser",grantor,act,userName)
		} else {
			RETURN
		}
		do $SYSTEM.Security.AuditID(auditEvent,auditMsg,$$$FormatMsg($$$AuditMsg,"SystemPrivilegeRevoked"))
		RETURN
    } else { // object privilege
		set objectNameWithType=$$ObjectTypeToName($p(object,",",1))_" "_$p(object,",",2)
		if $$$SecurityRolesExists($$$LOWER(user),data) { // this is a role
			set auditEvent=$$$AUDITROLECHANGE
			// See if need to audit, early return if don't need to audit
			// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) RoleChange event is enabled
			set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","RoleChange")
			RETURN:'audit
			set roleName=$$$GetSecurityRolesName(data)
			if casc {
				set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedObjectPrivilegeFromRoleCascade",grantor,$$ActionToName(act),objectNameWithType,roleName)
			} else {
				set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedObjectPrivilegeFromRole",grantor,$$ActionToName(act),objectNameWithType,roleName)
			}
		} elseif $$$SecurityUsersExists($$$LOWER(user),data) { // this is a user
			// Note that $$$SecurityRolesExists() has embedded "$$$AddSecurityRoleTemporary" but not this $$$SecurityUsersExists(), so make sure to call "$$$AddSecurityRoleTemporary" before calling this auditRevoke()!
			set auditEvent=$$$AUDITUSERCHANGE
			// See if need to audit, early return if don't need to audit
			// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) UserChange event is enabled
			set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","UserChange")
			RETURN:'audit
			set userName=$$$GetSecurityUsersName(data)
			if casc {
				set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedObjectPrivilegeFromUserCascade",grantor,$$ActionToName(act),objectNameWithType,userName)
			} else {
				set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedObjectPrivilegeFromUser",grantor,$$ActionToName(act),objectNameWithType,userName)
			}
		} else {
			RETURN
		}
		do $SYSTEM.Security.AuditID(auditEvent,auditMsg,$$$FormatMsg($$$AuditMsg,"ObjectPrivilegeRevoked"))
		RETURN
    }
}
.
/// Audit a Revoke on some field event if it needs to be audited.
/// Make sure to call "$$$AddSecurityRoleTemporary" before calling this function, because this contains the $$$SecurityUsersExists().
/// Parameters:
///        isSystem         - 0/1 for Object Privileges (0) or System Privileges (1)
///        user             - the user being revoked
///        grantor   	    - username revoking this privilege
///        act              - the privilege being revoked
///        object           - on which object is the privilege being revoked
///        field            - on which field of the object is the privilege being revoked
///        casc             - 0/1 for restrict(default mode) (0) or 'with CASCADE.' (1)
///        noAudit          - same as 'noAudit' flag, 0/1 suppress audit logging (for %ExecDirectNoAudit)
auditRevokeField(user,grantor,act,object,field,casc=0,noAudit=0) {
	set objectNameWithType=$$ObjectTypeToName($p(object,",",1))_" "_$p(object,",",2)
	if $$$SecurityRolesExists($$$LOWER(user),data) { // this is a role
		set auditEvent=$$$AUDITROLECHANGE
		// See if need to audit, early return if don't need to audit
		// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) RoleChange event is enabled
		set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","RoleChange")
		RETURN:'audit
		set roleName=$$$GetSecurityRolesName(data)
		if casc {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedFieldFromRoleCascade",grantor,$$ActionToName(act),field,objectNameWithType,roleName)
		} else {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedFieldFromRole",grantor,$$ActionToName(act),field,objectNameWithType,roleName)
		}
	} elseif $$$SecurityUsersExists($$$LOWER(user),data) { // this is a user
		// Note that $$$SecurityRolesExists() has embedded "$$$AddSecurityRoleTemporary" but not this $$$SecurityUsersExists(), so make sure to call "$$$AddSecurityRoleTemporary" before calling this auditRevokeField()!
		set auditEvent=$$$AUDITUSERCHANGE
		// See if need to audit, early return if don't need to audit
		// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) UserChange event is enabled
		set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","UserChange")
		RETURN:'audit
		set userName=$$$GetSecurityUsersName(data)
		if casc {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedFieldFromUserCascade",grantor,$$ActionToName(act),field,objectNameWithType,userName)
		} else {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedFieldFromUser",grantor,$$ActionToName(act),field,objectNameWithType,userName)
		}
	} else {
		RETURN
	}
	do $SYSTEM.Security.AuditID(auditEvent,auditMsg,$$$FormatMsg($$$AuditMsg,"ObjectPrivilegeRevoked"))
	RETURN
}
.
/// Audit each combination of users (user and roles) + privilege; if each needs audit
/// Make sure to call "$$$AddSecurityRoleTemporary" before calling this function, because this contains the $$$SecurityUsersExists() underneath it.
/// Parameters:
///        isGrant          - 0/1 for Granting (0) or Revoking (1)
///        actualUsers      - comma delimited list of users to grant/revoke to/from of the privileges in 'privs'. Format: username,[username,...]
///        privs            - Bit string of privileges to GRANT or REVOKE from the users. Reference the sysprv() description for its format.
///        grantor          - username granting/revoking this system privilege
///        noAudit          - same as 'noAudit' flag, 0/1 suppress audit logging (for %ExecDirectNoAudit)
auditSysPrivPermutations(isGrant,actualUsers,privs,grantor,noAudit) {
	for m=1:1 { // iterate through all user/role
		set user=$p(actualUsers,",",m) QUIT:user=""
		for j=1:1:$$$privcnt { // iterate through all system privileges Granted/Revoked
			if $bit(privs,j) {
				set privName=$lg($$$AdminPrivsLB,j)
				// Note that privName here doesn't need to be convered using $$ActionToName like object privileges.
				// Also for system privileges, there are no 'object's or 'withGrantOption's or 'Cascade's.
				if isGrant {
					do auditGrant(1,user,grantor,privName,,,noAudit)
				} else {
					do auditRevoke(1,user,grantor,privName,,,noAudit)
				}
			}
		}
	}
}
.
/// Audit a Grant role on a user/role event if it needs to be audited.
/// Parameters:
///        type             - "user" or "role" for the receiving user/role
///        user             - the user/role being granted
///        grantor          - username granting this role (to this user/role)
///        role             - the role being granted (to this user/role)
///        admin            - 0/1 for "with ADMIN option"
///        noAudit          - same as 'noAudit' flag, 0/1 suppress audit logging (for %ExecDirectNoAudit)
auditGrantRole(type,user,grantor,role,admin,noAudit=0) {
	if type="user" { // a new role is being granted to a user
		set auditEvent=$$$AUDITUSERCHANGE
		// See if need to audit, early return if don't need to audit
		// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) UserChange event is enabled
		set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","UserChange")
		RETURN:'audit
		if admin {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedRoleToUserWithAdmin",grantor,role,user)
		} else {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedRoleToUser",grantor,role,user)
		}
	} else { // a new role is being granted to a role
		set auditEvent=$$$AUDITROLECHANGE
		// See if need to audit, early return if don't need to audit
		// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) RoleChange event is enabled
		set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","RoleChange")
		RETURN:'audit
		if admin {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedRoleToRoleWithAdmin",grantor,role,user)
		} else {
			set auditMsg=$$$FormatMsg($$$AuditMsg,"UserGrantedRoleToRole",grantor,role,user)
		}
	}
	do $SYSTEM.Security.AuditID(auditEvent,auditMsg,$$$FormatMsg($$$AuditMsg,"RoleGranted"))
	RETURN
}
.
/// Audit a Revoke role on a user/role event if it needs to be audited.
/// Parameters:
///        type             - "user" or "role" for the receiving user/role
///        user             - the user/role being revoked
///        grantor          - username revoking this role (from this user/role)
///        role             - the role being revoked (from this user/role)
///        noAudit          - same as 'noAudit' flag, 0/1 suppress audit logging (for %ExecDirectNoAudit)
auditRevokeRole(type,user,grantor,role,noAudit=0) {
	if type="user" { // a role is being revoked from (stripped off of) a **user**
		set auditEvent=$$$AUDITUSERCHANGE
		// See if need to audit, early return if don't need to audit
		// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) UserChange event is enabled
		set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","UserChange")
		RETURN:'audit
		set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedRoleFromUser",grantor,role,user)
	} else { // a role is being revoked from (stripped off of) a **role**
		set auditEvent=$$$AUDITROLECHANGE
		// See if need to audit, early return if don't need to audit
		// Only audit if: (1) noAudit flag not set, (2) audit DB exists, (3) RoleChange event is enabled
		set audit = 'noAudit && $$$AuditingIsOn && $$$EventAuditIsOn("%System","%Security","RoleChange")
		RETURN:'audit
		set auditMsg=$$$FormatMsg($$$AuditMsg,"UserRevokedRoleFromRole",grantor,role,user)
	}
	do $SYSTEM.Security.AuditID(auditEvent,auditMsg,$$$FormatMsg($$$AuditMsg,"RoleRevoked"))
	RETURN
}
.
.
