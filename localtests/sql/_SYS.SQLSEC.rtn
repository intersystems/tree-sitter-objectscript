	;  DPV3415 (05/27/2009) - Display SQLRoleUserExecute usernames in $$$LOWER(username) order
	;  DPV3407 (05/12/2009) - Fix AnySchemaTablePriv and AnySchemaViewPriv to chekc all cases of the schema name
	;  STC1529 (02/27/2009) - Macros to Save and Restore Namespace 
	;  DPV3342 (01/15/2009) - Support REVOKE ... AS <grantor>
	;  DPV3340 (01/13/2009) - Drop all privs on the object when it is deleted
	;  DPV3332 (01/05/2009) - Export column level privileges too when exporting a table's privileges
	;  DPV3316 (11/25/2008) - Support SELECT privileges for CUBES
	;  SML1081 (11/24/2008) - Simon Li, Support single namespace activation and reduce usage of mapping memory.
	;  DPV3300 (10/22/2008) - Implement LOCK/UNLOCK TABLE statements
	;  BJB395  (10/16/2008) - fix Typo in AddUser with %%ENCRYPTED 
	;  YSD2058 (10/09/2008) - SMP - Column level privileges - fix minor errors
	;  DPV3275 (09/30/2008) - Improve performance of CachedQueryPrivReset
	;  DPV3237 (08/06/2008) - Correct calls to AnyPrivObj when checking if the schema has any privileges
	;  DPV3219 (07/10/2008) - SQL Privs: Only return columns user is privileged for in catalog queries 
	;  DPV3209 (06/27/2008) - Correct AnyPrivObj when the user has privilege on a column of a table/view.
	;  DPV3193 (06/12/2008) - Add privilege checking to some catalog queries that were missing it
	;  DPV3183 (06/09/2008) - Correct problem revoking column privileges from all users
	;  DPV3157 (05/13/2008) - Fixes for grant of column level privileges
	;  DPV3108 (02/20/2008) - Add column level privilege support to SQLTablePrivs and SQLColumnPrivs
	;  DPV3100 (02/08/2008) - Add non-% roles to GetSpecialListUserlist
	;  DPV3095 (01/22/2008) - Support for column-level privileges
	;  DPV3041 (10/02/2007) - Quote username in Privilege export file if needed
	;  DPV3032 (09/26/2007) - Add Grantor argument to setup1 to revoke privilege granted by another user
	;  DPV3029 (09/26/2007) - In SMP don't display schemas/objects to grant unless user has grant option
	;  DPV3020 (09/19/2007) - Check EXECUTE privilege on procedure when user defined function is called
	;  DPV3018 (09/17/2007) - Grant SELECT on DocBook.book to _PUBLIC
	;  DPV2984 (07/23/2007) - Implement RoleExists
	;  DPV2981 (07/20/2007) - Implement GrantDocbook
	;  DPV2978 (07/18/2007) - Fix DPV2941, which allowed a priv to be granted with the priv holder did not have the grant option
	;  DPV2950 (06/06/2007) - Don't report a Role's SQL privileges twice in SQLUserPrivsExecute^%SYS.SQLSEC
	;  DPV2949 (06/04/2007) - Pass namespace to upgrant instead of using $namespace
	;				         SQL Fix ProdLog 58375: delete roles doesn't delete it's sql privilege
	;  DPV2941 (05/30/2007) - Allow grant of SQL privilege if privilege was granted with grant option to role or _PUPLIC.
	;				         Allow display of another user's privileges if this user has %Admin_Secure:"USE"
	;				         SQL Fix ProdLog 58197: Can't grant table privileges if you have admin rights through a role
	;  DPV2931 (05/09/2007) - Add system flag to SQLUserPrivsExecute function
	;  DPV2901 (04/04/2007) - Use $$$MaxLocalLenth for length checking in GetSpecialListUserlist
	;  DPV2883 (03/14/2007) - Fix TPExecute to properly report privileges granted via roles
	;  DPV2861 (02/22/2007) - Don't display tables from % schemas unless in %SYS for TablePrivileges
	;  DPV2843 (01/18/2007) - Fix TPExecute to not get an <UNDEFINED> error on tsql metadata in ^oddSQL()
	;  DPV2825 (12/27/2006) - New CheckSchemaIndex function to clean up a schema entry in ^rINDEXSQL("schema") if no more items exist in the schema
	;  DPV2823 (12/22/2006) - Fix privilege reporting for Roles granted to Roles.
	;				         SQL Fix ProdLog 51884: Roles in Roles do not list Privs
	;  DPV2799 (11/27/2006) - Alter User fix.
	;				         SQL Fix ProdLog 49555, 54801: ALTER USER IDENTIFY BY allows e.g. a %Developer to change any password
	;  DPV2797 (11/22/2006) - SQL Priv fix: Don't report SP's as tables in SQL Tables table of user definition in SMP
	;  DPV2777 (10/31/2006) - Unlock ^mcq("Query) in CachedQueryPrivReset
	;				         SQL Fix ProdLog 54262: process is hung in a run state on multiple unix platforms
	;  DPV2759 (10/13/2006) - SQL Fix ProdLog 53928: SQL Schema is not removed on deleting all tables
	;  DPV2757 (10/11/2006) - Allow users with %Admin_Secure:"U" to see the RoleUsers and RolePrivileges data
	;  DPV2749 (09/29/2006) - SQL Fix ProdLog 51811: ProcessJournalOn and Off appear in audit log
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  STC995  (05/08/2006) - Move RolesCreate and RolesDelete functions to %SYS.SQLSEC 
	;  DPV2612 (04/03/2006) - Implement exporting of procedure privileges
	;				         SQL Implement ProdLog 49144: Role export in ^SECURITY does not export SQL information
	;  DPV2561 (12/13/2005) - In CachedQueryPrivReset, skip over namespaces that get <DIRECTORY> sic errors
	;				         SQL Fix ProdLog 47757:  unable to delete user roles
	;  DPV2559 (12/08/2005) - Use $SYSTEM.Security.ChangePassword to alter a user's password
	;				         SQL Fix ProdLog 47711: using alter user to change password leads to unknown password
	;  DPV2553 (11/16/2005) - SQL Fix ProdLog 47282: <PROTECT> when Read-Only user browses SQL Schemas in SMP
	;  DPV2551 (11/08/2005) - SQL Enh: Add ADMIN_OPTION to %SQL.Manager.CatalogPriv.RoleUser catalog query
	;  DPV2530 (10/05/2005) - Eliminate use of $$$GeneralError
	;  DPV2524 (09/22/2005) - Moved Cached Query metadata back to ^mcq
	;  DPV2515 (09/13/2005) - Avoid <MAXSTRING> error in GetSpecialListUserlist
	;				         SQL Fix ProdLog 42815:  MAXSTRING Error because of SQL Users    ;  MXT748  (08/26/2005) - Improve include performance for $$$ERROR
	;  DPV2498 (10/05/2005) - Suspend writing to the journal file when creating/deleting cached query definitions
	;  DPV2497 (08/24/2005) - Cleanup Cached Query and SQL Privilege metadata from %SYS when a namespace is deleted.
	;  DPV2475 (07/29/2005) - Don't export system users and roles
	;				         SQL Fix ProdLog 43831: Issues with importing/exporting privileges
	;  DPV2474 (07/28/2005) - Reset cached query privileges when a role is removed from a user or role
	;				         SQL Fix ProdLog 44183: Use of cached query does not check table privilege
	;  DPV2423 (04/28/2005) - SQL Fix ProdLog 42185: -112 error tryint to revoke role with %Admin_Secure
	;  DPV2409 (04/12/2005) - Stored procedure names in exact case in privilege global
	;				         SQL Fix ProdLog 42494: GRANT EXECUTE doesn't work
	;  DPV2408 (04/11/2005) - Don't let non-defined user increment error count if checking if superuser
	;				         SQL Fix ProdLog 42477: Compilation errors occur when compile upgraded view
	;  DPV2405 (04/07/2005) - Check EXECUTE privilege for Stored Procedures
	;  DPV2391 (03/18/2005) - Give admin parameter in haspriv a default of 0
	;				         SQL Fix ProdLog 41580: <UNDEFINED>^%SYS.SQLSEC occurs when %CHECKPRIV a privilege that has been granted
	;  DPV2390 (03/17/2005) - Display SQL System Privileges for SuperUsers
	;				         SQL Fix ProdLog 41922:  SQL catalog queries for system privileges return empty result set for a user with %All role
	;  DPV2377 (03/07/2005) - Fix <UNDEFINED> error when asking for user privs of undefined user
	;				         SQL Fix ProdLog 41660: <<UNDEFINED>SQLUserPrivsExecute+9^%SYS.SQLSEC error
	;  DPV2375 (03/01/2005) - Fix privilege checking for CreateRole and DropRole.
	;				         SQL Fix ProdLog 41562: User who has been granted a role with admin option cannot drop the role
	;  DPV2373 (02/23/2005) - Fix DropRole to check properly if the user is privleged to drop it
	;				         Fix the granting of the role to the user in CreateRole.
	;				         SQL Fix ProdLog 41466: Privilege Violation occurs when user who is %Manager DROPs role
	;  DPV2366 (02/09/2005) - Create GetSpecialListUserlist() function for %qccServer
	;				         Studio Fix ProdLog 40902: <PROTECT> occurs when use source control for the first time
	;  DPV2364 (02/07/2005) - Support Grant/Revoke to/from *
	;				         SQL Fix ProdLog 36544: GRANT to * won't find a SQL user
	;  DPV2363 (02/07/2005) - Don't need to change namespace in catalog query execute code
	;				         SQL Fix ProdLog 41056: %Library.SQLCatalogPriv returns no results and <PROTECT> occurs for user who is %Developer
	;  DPV2359 (02/03/2005) - Implement GrantSamples procedure
	;  DPV2358 (02/02/2005) - Fix scope of SQLCODE in some functions.  Fixed hasrvprv.
	;				         SQL Fix ProdLog 40988: SQLCODE is 0 when REVOKE fails
	;  DPV2353 (01/31/2005) - Move privilege catalog query execute code here.
	;				         SQL Fix ProdLog 40896: <UNDEFINED> occurs in SQLCatalogPriv
	;  DPV2350 (01/26/2005) - Support export of user/roles with new security structure
	;  DPV2346 (01/19/2005) - SQL Security: Fixes to granting/revoking delimited identifier roles
	;  STC748  (01/18/2005) - Macroize Security global 
	;  DPV2336 (01/06/2005) - SQL Fix ProdLog 40355: Run-time error occurs when create user who already exists
	;  DPV2327 (12/08/2004) - Fix GrantRole and RevokeRole
	;  DPV2324 (11/24/2004) - Eliminate %msqlgrp for SQL Role list, use $Roles now
	;  DPV2323 (11/24/2004) - Move %qarPrivileges and %qadUsers into %SYS.SQLSEC
	;  DPV2321 (11/10/2004) - Use new %SYS.CONFIG API for SQL Configuration settings
	;  STC666  (10/24/2004) - CACHESYS/CACHELIB split, replace $SYSTEM.Security calls
	;  DPV2310 (10/20/2004) - SQL Security:  Pass namespace to GetSecuritySQLSysPrivData macro
	;  DPV2307 (10/08/2004) - SQL Security:  Make granting of roles via SQL and ^SECURITY compatible
	;  STC658  (10/07/2004) - Change MakeMeAll
	;  DPV2304 (10/01/2004) - Fix user-with-no-roles logon
	;  DPV2280 (09/09/2004) - Implement DeleteSQLPrivs(ns) to delete all privs in a namespace.
	;  JLF016  (07/27/2004) - Row-Level Security
	;  DPV2273 (08/26/2004) - Implement GRANT/REVOKE or EXECUTE privileges for Procedures
	;  DPV2271 (08/20/2004) - Eliminate THRESHOLD
	;  DPV2264 (08/11/2004) - Move SQL System privileges to per-namespace, eliminate system-wide privieges
	;  DPV2261 (08/11/2004) - Provide AnyPriv function to be called from xDBC Logon Authentication
	;  DPV2256 (08/04/2004) - Move SQL privileges to $$$SecurityGlobal,"SQL","priv",<database>,...)
	;  DPV2249 (07/19/2004) - SQL Security:  Completely merge SQL and System Users and Roles
	;  DPV2237 (06/18/2004) - Remove support for Namespace Security Access
	;  DPV2236 (06/17/2004) - Restore SQL System privileges in SQL User definition
	;  DPV2234 (06/16/2004) - Use $SYSTEM.Security.Users.SQLExists() instead of Exists()
	;  DPV2229 (06/10/2004) - Make sure username is qualified in userstuf
	;				         SQL Fix ProdLog 37402, 37403: can not do INSERT as a user with INSERT granted
	;  DPV2227 (06/08/2004) - Remove IsASuperUser function - use system function, just not during ^build
	;  DPV2198 (03/17/2004) - Use $Username instead of %msql, use new privilege global
	;  DPV2122 (11/13/2003) - Fix iudr Privilege checking against Views in priv()
	;  DPV2010 (10/28/2003) - New gr, role, x in roleset
	;  DPV2090 (10/03/2003) - Continued ^mdd elimination
	;  DPV2053 (07/25/2003) - Fix privileges checking with privileges granted indirectly through roles
	;  DPV2044 (07/17/2003) - Fix rolset when non-exact case of username is passed in
	;  DPV1997 (03/23/2003) - Fix checking of %GRANT_ALL_PRIVILEGES in haspriv
	;  DPV1972 (04/14/2003) - Make privilege functions use new SQL metadata
	;  DPV1958 (03/10/2003) - Move ^mdd(7) metadata to $$$EXTCQ($$$rEXT,<class name>,<cached query>)
	;  DPV1950 (03/04/2003) - Fix sysprv calls to syspriv and hasrvprv
	;  DPV1898 (12/13/2002) - Add ADMIN option parameter to GrantRole function
	;  DPV1747 (06/12/2002) - Move revthrus code to %qarPrivileges to avoid <LABELREDEF> errors
	;  DPV1746 (06/12/2002) - Fix RevokeRole to actually revoke the Role
	;  DPV1745 (06/12/2002) - Fix Namespace Access security for Roles
	;  DPV1742 (06/10/2002) - Support DB Object Definition system privileges
	;  DPV1739 (06/05/2002) - Unlock ^mcq global immediately in CachedQueryPrivReset
	;  DPV1705 (05/03/2002) - Support INSERT, UPDATE, DELETE, REFERENCE privileges on views
	;  DPV1640 (01/08/2002) - Allow role names with spaces in Grant/RevokeRole
	;  DPV1618 (11/15/2001) - Add Grant/RevokeThreshld entry points for SQL Manager
	;  BJB194  (06/01/2001) - Quadramed - If a user or role does not have a
	;				          a threshold value they should pass the check
	;  DPV1370 (08/21/2000) - Check SQL privileges for dynamic queries
	;  DPV1319 (06/07/2000) - Schema changes for privileges
	;  DPV1210 (12/08/1999) - Accept (but don't support) granting of INSERT, UPDATE,
	;				         and DELETE privileges on Views.
	;  DPV1208 (12/07/1999) - Support REVOKE ... RESTRICT
	;  DPV1147 (09/24/1999) - Check privileges on Cached Queries when they are reused.
	;  DPV1120 (08/06/1999) - Add CheckPriv,GrantRole,RevokeRole entrypoints
	;  DPV1100 (07/06/1999) - Support ODBC Namespace Access privilege
	;  DPV1025 (03/26/1999) - Retain '_' in username
	;  DPV1021 (03/25/1999) - handle leading '_' on '_SYSTEM'
	;  DPV1007 (03/17/1999) - Preserve '_' in identifier names
	;  DPV876  (10/08/98)   - New Routine - Handle object provilege granting
	;
	;---------------------------------------------------------------------
	;				     I N F O R M A T I O N
	;---------------------------------------------------------------------
	;
	;   SQL Privileges metadata
	;   $$$SecurityGlobal,"SQL","priv",<database>,<grant opt>,(<reltype>,<name>),<priv-code>,<grantee>,<grantor>)=<grant opt>
	;---------------------------------------------------------------------
#ENDIF  ;
	$$$Abort  ; Not an Entry Point!!
.
	#; given an sql query, perform the hash that is used in accessing $$$CQ("Query",5,hash,...)
#define Hash(%str) $System.Encryption.Base64Encode($System.Encryption.SHA1Hash(%str))
#define privcnt ##SafeExpression($ll($$$AdminPrivsLB))
#define noprivuser(%user,%obj,%act,%dir,%grant,%roles,%sc) '$$$IsASuperUser(%user,.%sc),'$d($$$SecurityGlobalSQLPriv(%dir,%grant,%obj,%act,%user)),'$d(^("_PUBLIC")),$$$SQLSecurityOn,$$rolechekuser(%dir,%grant,%obj,%act,%user,%roles),$$SchemaCheckUser(%dir,%obj,%grant,%act,%user,%roles),$$OwnerCheckUser(%user,%roles,%obj,%act)
	; Same as noprivuser, but we know the user is not a superuser
#define noprivuser2(%user,%obj,%act,%dir,%grant,%roles) '$d($$$SecurityGlobalSQLPriv(%dir,%grant,%obj,%act,%user)),'$d(^("_PUBLIC")),$$$SQLSecurityOn,$$rolechekuser(%dir,%grant,%obj,%act,%user,%roles),$$SchemaCheckUser(%dir,%obj,%grant,%act,%user,%roles),$$OwnerCheckUser(%user,%roles,%obj,%act)
 
#; Centralized configuration update counter is set by caller (userstuf)
setup(acts,type,&objs,users,withGrantOption,%check,grantor="",fields="",pNS="",noAudit=0) [SQLCODE] PUBLIC {
	  #;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="setup",^|"%SYS"|RJWTEST(n,"acts")=$g(acts),^|"%SYS"|RJWTEST(n,"typ")=$g(typ),^|"%SYS"|RJWTEST(n,"objs")=$g(objs),^|"%SYS"|RJWTEST(n,"users")=$g(users),^|"%SYS"|RJWTEST(n,"g")=$g(g),^|"%SYS"|RJWTEST(n,"%check")=$g(%check),^|"%SYS"|RJWTEST(n,"gr")=$g(gr),^|"%SYS"|RJWTEST(n,"fields")=$g(fields) ;rjwtestlog
	  #;   Parameters:
	  #;       acts     - actions to grant.  * for all actions
	  #;				    a for Alter
	  #;				    d for Delete
	  #;					e for Execute
	  #;				    l for USE (ML Configurations and Foreign Servers)
	  #;				    i for Insert
	  #;				    r for References
	  #;				    s for Select
	  #;				    u for Update
	  #;				 				    or any combination
	  #;       type      			- 1 for table, 3 for view, 4 for cube, 5 for Schemas, 6 for ML Configurations, 7 for Foreign Servers, 9 for procedure
	  #;       objs     			- * for all objects, else local array of object names to $o over (e.g. objs("sch.tab")="")
	  #;       users    			- comma delimited list of users
	  #;       withGrantOption      - 0/1 for WITH GRANT OPTION
	  #;       %check   			- 0/1 check to make sure user has grantable priv
	  #;       grantor  			- username granting this privilege.  If "", use $Username
	  #;       fields   			- optional, $List of field names to grant the privs on in the objs
	  #;       noAudit              - 0/1 suppress audit logging (for %ExecDirectNoAudit)
.
	if $$$aid="" { set SQLCODE=-112 RETURN  }  	// for embedded SQL, quit and set an error if user undefined
	set:grantor="" grantor=$$$aid
	set:pNS="" pNS=$Namespace
	set sysuser=($$$IsASuperUser($$$aid)),actstar=0
	// The old API (pre-wildcards) had objs as a $lb - this is just to allow old callers to continue doing that. Most old callers of this kind are just $lb(oneobject) so this is a quick transformation
	if objs'="", $listvalid(objs) {
		set ptr = 0
		while $listnext(objs, ptr, listitem) {
			set objs(listitem) = ""
		}
	}
	if acts'="*",objs'="*" {
		do checkTypeForValidPrivilege(type,acts,.SQLCODE,.%msg) RETURN:SQLCODE<0
	}
	If acts'="*",'sysuser,objs'="*",+$g(%check) {
		do checkTypeForValidPrivilege(type,acts,.SQLCODE,.%msg) RETURN:SQLCODE<0
		do check(.objs,type,acts,grantor,fields,pNS)
		if SQLCODE=-112 {
			set %msg="User "_$$$aid_" does not have required privileges to grant the privilege(s)"
			RETURN
		}
	}
	// add "l" to type=5 (schema) so we can have USE granted on foreign servers in the schema. ML configs don't have schemas so can't apply
	If acts="*" { set acts=$s(type<4:"asiudr",type=5:"asiudrel",type=4:"s",type=6:"l",type=7:"l",1:"e"),actstar='sysuser }	// actstar=1 means to check for actions
		#; validate actions for this type
  	$$$AddSecurityRoleTemporary
	If users="*" {
			#;  Grant to * users means grant to all users that are not SuperUsers.
		set user="",users=""
		For  set user=$o($$$SecurityGlobalUsers(user),1,data) quit:user=""  set:'$$$GetSecurityUsersSuperUser(data)&&(user'="_public") users=users_","_$$$GetSecurityUsersName(data)
	}
	set:$e(users)="," users=$e(users,2,*)
.
	set TYPE=$s(type=1:"TABLE",type=4:"CUBE",type=5:"SCHEMA",type=6:"ML_CONFIGURATION",type=7:"SERVER",type=9:"PROCEDURE",1:"VIEW"),schema="",table="",proc="",serverUpper="",schemaUpper=""
	set confignames="",configptr=0
	for i=1:1:$l(acts) {	// for each action
		set action=$e(acts,i),j="",object=$s(objs="*":type_",0", 1:""),oldObject=""
		for {		// for each object
			if objs'="*" {	// Not all objects
				set object = $o(objs(oldObject))
				QUIT:object=""
				// Since switching to $o loop for wildcard capabilities, this objs() list needs a way to differentiate the looping subscript object from the type,object
				// This is the easiest way to not affect the other looping logic below
				set oldObject = object
				if type<4 {	// table or view
					set object=type_","_$$$GetExactIntQualifiedName($$$SchemaFromIQN(object),$$$TableFromIQN(object))
				} elseif type=5||(type=4)||(type=6) {	// Schema or Cube or ML_Configuration
					set object=type_","_$$$UPPER(object)
				} elseif type=7 { // Foreign Server
					set object=type_","_object
				} else {		// procedure
					set PSCHEMA=$$$UPPER($$$SchemaFromIQN(object))
					set PNAME=$$$UPPER($$$TableFromIQN(object))
					set schema=$g($$$PROCschema($$$pPROC,PSCHEMA,PNAME))
					set name=$g($$$PROCname($$$pPROC,PSCHEMA,PNAME))
					set object=type_","_schema_"."_$tr(name,".",$c(2))
				}
			} elseIf sysuser {	// granting to all objects. If sysuser grant to all objects
				if type<4 {	// table or view
					set:table="" schema=$o(^rINDEXSQL(TYPE,schema))
					if schema'="" set table=$o(^rINDEXSQL(TYPE,schema,table)) If table="" set schema=$o(^rINDEXSQL(TYPE,schema)) set:schema'="" table=$o(^rINDEXSQL(TYPE,schema,table))
					if schema="" { set object="" }
					else { set object=type_","_$$$GetExactIntQualifiedName(schema,table) } 
				}
				elseif type=4 {
					set SQLCODE=-400,%msg=$$$Text("granting privileges to all Cubes not supported","%SQL.Security") QUIT
				}
				elseif type=5 {
					set SQLCODE=-400,%msg=$$$Text("granting privileges to all Schemas not supported","%SQL.Security") QUIT
				}
				elseif type=6 {	// ML_Confiuration
					if confignames="" {
						set confignames=##class(%SYS.ML.Configuration).%GetListOfAllConfigNames(.SQLCODE,.%msg)
						quit:SQLCODE<0
					}
					if confignames="" { set object="" quit  }
					if $listnext(confignames,configptr,name) { set object="6,"_$$$UPPER(name) }
					else { set object="" }
				} elseif type=7 { // Foreign Server
					set:serverUpper="" schemaUpper=$o(^rINDEXSQL(TYPE,schemaUpper))
					if schemaUpper'="" {
 						set serverUpper = $o(^rINDEXSQL(TYPE,schemaUpper,serverUpper),1,serverData) 
						if serverUpper = "" {
							set schemaUpper = $o(^rINDEXSQL(TYPE,schemaUpper)) 
							set:schemaUpper'="" serverUpper = $o(^rINDEXSQL(TYPE,schemaUpper,serverUpper),1,serverData)
						}
					}
					if schemaUpper="" { set object="" }
					else { set object=type_","_$lg(serverData, 4)_"."_$lg(serverData, 5) } 
				}
				else {		// procedure
					set:proc="" schema=$o(^oddPROC(schema))
					If schema'="" set proc=$o($$$PROC($$$pPROC,schema,proc)) If proc="" set schema=$o(^oddPROC(schema)) set:schema'="" proc=$o($$$PROC($$$pPROC,schema,proc))
					continue:schema'=""&&(proc'="")&&($g($$$PROChidden($$$pPROC,schema,proc)))
					If schema="" { set object="" }
					Else { set object=9_","_$$$BuildIQN($g($$$PROCschema($$$pPROC,schema,proc)),$g($$$PROCname($$$pPROC,schema,proc))) } 
				}
			} else { 		//  Not SuperUser, Grant privileges on all objects with grantable privs
				for  {
					set object=$o($$$SecurityGlobalSQLPriv(pNS,1,object)) quit:+object'=type  quit:$d($$$SecurityGlobalSQLPriv(pNS,1,object,action,grantor))
				}
				set:+object'=type object=""
			}
			QUIT:object=""
			do:sysuser||'actstar||$d($$$SecurityGlobalSQLPriv(pNS,1,object,action,grantor)) userstuf(users,object,action,grantor,withGrantOption,fields,pNS,noAudit)
		}
	}
	RETURN
}
 
userstuf(users,object,action,grantor,withGrantOption,fields,pNS="",noAudit=0) [SQLCODE] PRIVATE {
	#;s n=$I(^|"%SYS"|RJWTEST),^RJW(n)="userstuf",^|"%SYS"|RJWTEST(n,"users")=$g(users),^|"%SYS"|RJWTEST(n,"o")=$g(o),^|"%SYS"|RJWTEST(n,"a")=$g(a),^|"%SYS"|RJWTEST(n,"gr")=$g(gr),^|"%SYS"|RJWTEST(n,"g")=$g(g),^|"%SYS"|RJWTEST(n,"fields")=$g(fields) ;rjwtestlog
 	$$$AddSecurityRoleTemporary
	set update=0
	set:pNS="" pNS=$Namespace
	for m=1:1 {
		set user=$p(users,",",m) quit:user=""
		set x=$$$LOWER(user)
		if x="public" { set user="_PUBLIC" }
		elseif x'="",$$$SecurityRolesExists(x,data) { set user=$$$GetSecurityRolesName(data) }
		elseif x'="",$$$SecurityUsersExists(x,data) { set user=$$$GetSecurityUsersName(data) }
		if '$d($$$SecurityGlobalSQLPriv(pNS,0,object,action,user,grantor)) { do grant(object,action,user,grantor,withGrantOption,pNS,fields,noAudit) set SQLCODE=0,update=1 }
		elseif withGrantOption,'$d($$$SecurityGlobalSQLPriv(pNS,1,object,action,user,grantor)) { do upgrant(object,action,user,grantor,withGrantOption,pNS,noAudit) set SQLCODE=0,update=1 }
	}
	if update { $$$SetSecuritySQLUpdate(pNS) }
	RETURN
}
 
check(&objs,typ,acts,gr,FIELDS,pNS) [SQLCODE] PRIVATE {
	set fields="", object="", oldObject = ""
	for {
		set object = $o(objs(oldObject)) 
		QUIT:object=""
		set oldObject = object
		if FIELDS'="" {	// Get proper case of fields
			set ptr=0,extent=$$$GetExtentNameFromIQN(object)
			while $listnext(FIELDS,ptr,field) {
				set field=$g($$$EXTsqlcolumnidx($$$rEXT,extent,field)) continue:field=""
				set fields=fields_$lb(field)
			}
		}
		set object=typ_","_object
		For j=1:1:$l(acts) { 
			set action=$e(acts,j) 
			if '$$privNoSchema(object,action,pNS,1,fields) { set SQLCODE=-112 quit  }	// DPV3157
		}
		Quit:SQLCODE=-112  
	}
	RETURN
}
 
setup1(acts,type,&objs,users,withGrantOption,casc,AsSuperUser=0,ns="",gr="",fields="",pAllMappedNS=0,noAudit=0) [SQLCODE] PUBLIC {
	  #;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="setup1",^|"%SYS"|RJWTEST(n,"acts")=$g(acts),^|"%SYS"|RJWTEST(n,"typ")=$g(typ),^|"%SYS"|RJWTEST(n,"objs")=$g(objs),^|"%SYS"|RJWTEST(n,"users")=$g(users),^|"%SYS"|RJWTEST(n,"g")=$g(g),^|"%SYS"|RJWTEST(n,"casc")=$g(casc),^|"%SYS"|RJWTEST(n,"ns")=$g(ns),^|"%SYS"|RJWTEST(n,"AsSuperUser")=$g(AsSuperUser),^|"%SYS"|RJWTEST(n,"gr")=$g(gr),^|"%SYS"|RJWTEST(n,"fields")=$g(fields) ;rjwtestlog
	  #;   Paramaters:
	  #;      1 acts     - actions to revoke  * for all actions
	  #;				    a for Alter
	  #;				    s for Select
	  #;				    i for Insert
	  #;				    u for Update
	  #;				    d for Delete
	  #;				    r for References
	  #;				    e for Execute
	  #;				    l for USE (ML Configurations and Foreign Servers)
	  #;				 				    or any combination
	  #;      2 type      - 1 for table, 3 for view, 4 for cube, 5 for Schemas, 6 for ML Configurations, 7 for Foreign Servers, 9 for procedure
	  #;      3 objs     - * for all objects, else local array of qualified object names (e.g. objs(object) = ""
	  #;      4 users    - comma delimited list of users
	  #;      5 withGrantOption        - 0/1 for WITH GRANT OPTION
	  #;      6 casc     - 0/1 cascade revoke?
	  #;      7 AsSuperUser - perform the action with %All Role
	  #;      8 ns       - namespace
	  #;      9 gr       - grantor.  Revoke the priv granted by this grantor.  Default is $$$aid (DPV3032)
	  #;     10 fields   - optional, $List of field names to revoke the privs on
	  #;	 11 pAllMappedNS - option 1/0, if TRUE, also perform the revoke in any potential mapped namespaces for the obj.
	  #;				   This is done when the privs are removed from the object when it is deleted.
	  #;
	  #;     12 noAudit              - 0/1 suppress audit logging (for %ExecDirectNoAudit)
	  #;	DPV4280 - in addition to adding schema level privileges, I changed setup1 to be all or nothing (if error).
	  #;	restrict was not behaving properly here.  If we were revoking all privs from an object, and the user had granted one of the privs to another user, restrict caught this but the error was not
	  #;	reported, we went right to the next priv.  I now use a transaction to undo any revokes that occurred before we get an error (probably -126), and stop if we do get an error.
 
	if AsSuperUser {
			#; Make sure the caller is from one of our internal routines calling with AsSuperUser == TRUE
			#; $zu(96,9) is the calling routine, $zu(96,10) is the calling database
		set callRoutine=$zu(96,9)
		if $$$CallingDBIsIRISLIB,$case(callRoutine,"%occProcedure":1,"%ocsSQLRTDict":1,"%apiDDL":1,:0) {
			$$$AddAllRoleTemporary
		} elseif callRoutine="%SYS.ML.Configuration.1",$$$CallingDBIsMgrDB {
			$$$AddAllRoleTemporary
		} 
	}
	if $$$aid="" { set SQLCODE=-99,%msg="$Username is not defined, attempting to revoke an SQL privilege" do Audit99(%msg) RETURN  }		; quit if user undefined
	set:gr="" gr=$$$aid
	// add "l" to type=5 (schema) so we can have USE granted on foreign servers in the schema. ML configs don't have schemas so can't apply
	if acts="*" { set acts=$s(type<4:"asiudr",type=5:"asiudrel",type=4:"s",type=6:"l",type=7:"l",1:"e") }
	set:ns="" ns=$namespace
.
	set:'$d(SQLCODE) SQLCODE=100	// Start by assuming nothing changed, realrev will set SQLCODE=0 or error.
	do checkTypeForValidPrivilege(type,acts,.SQLCODE,.%msg) RETURN:SQLCODE<0
.
		#; If the user is not a super user and does not have Admin-Secure, we can't revoke a privilege granted by someone else (DPV3342)
	set mustBeGrantor = ('($$$IAmSuperUser) && '$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName))
	if mustBeGrantor, gr'=$$$aid { set SQLCODE=-99,%msg="User '"_$Username_"' is not privileged to revoke an SQL privilege granted by another user" do Audit99(%msg) QUIT }
	// The old API (pre-wildcards) had objs as a $lb - this is just to allow old callers to continue doing that. Most old callers of this kind are just $lb(oneobject) so this is a quick transformation
	if objs'="", $listvalid(objs) {
		set ptr = 0
		while $listnext(objs, ptr, listitem) {
			set objs(listitem) = ""
		}
	}
.
	set oldObject = ""
  	$$$AddSecurityRoleTemporary
	
	TSTART
	try {
		// updated the actionAuditList for audit if needed
		if fields'="" {
			set object=type_","_$o(objs("")),ptr=0,extent=$$$GetExtentNameFromIQN($p(object,",",2,999))
			while $listnext(fields,ptr,field) {
				set field=$g($$$EXTsqlcolumnidx($$$rEXT,extent,field)) continue:field=""
				set fieldObject=object_"."_field
				if $d($$$SecurityGlobalSQLPriv(ns,withGrantOption,fieldObject)) {
					do revokeEverythingForOneObject(fieldObject, object, ns,noAudit)	// relies on shared local variables!
					QUIT:SQLCODE<0
				}
			}
		}
		else { 
			set object = $s(objs="*": type_",%", 1:"")
			for j=1:1 {
				set object=$$nextobject 
				QUIT:object=""
					
					#; for object we now delete privs in 'acts' at the table level.
				if $d($$$SecurityGlobalSQLPriv(ns,withGrantOption,object)) {	// revoke object privilege
					do revokeEverythingForOneObject(object, $p(object,".",1,2), ns,noAudit)	// relies on shared local variables!
					QUIT:SQLCODE<0
				}
					
					#; We also have to make sure to delete the privs for 'object' at the field level.
					#;  REVOKE <priv> FROM <table/view> should also revoke any column level privileges for the grantflag/action/user
				set fieldObject=object
				for  {
					set fieldObject=$o($$$SecurityGlobalSQLPriv(ns,withGrantOption,fieldObject)) 
					QUIT:$e(fieldObject,1,$l(object)+1)'=(object_".")  	// only fields for this object
					do revokeEverythingForOneObject(fieldObject, object, ns,noAudit)	// relies on shared local variables!
					QUIT:SQLCODE<0
				}
			}
		}
		QUIT:SQLCODE<0		// quits the TRY block
		
			#; Revoke the privs on this object from other namespaces this object was mapped to
			#;  We don't easily know where this object is mapped to, so we will look at any namespace that has privs defined for this object
		if pAllMappedNS,type'=6 {
				#; if pAllMappedNS=1, we know objs is going to be a single table/view/proc and that fields will be ""
			set tNamespace="",object=$o(objs("")),tSchema=$$$SchemaFromIQN(object),tName=$$$TableFromIQN(object),tRef="^|"_$$quoter(ns)_"|oddSQL("_$$quoter(tSchema)_","_$$quoter(tName)_")"
			set tDest=$$GetGlobalSourceDatabase^%SYS.SECURITY(tRef)
			for  {
				set tNamespace=$o($$$SecurityGlobalSQLPriv(tNamespace))
				quit:tNamespace=""
				continue:tNamespace=ns	// Already revoked in this namespace
				set tRef2="^|"_$$quoter(tNamespace)_"|oddSQL("_$$quoter(tSchema)_","_$$quoter(tName)_")"
					#; if this give any error for a namespace global reference, just try the next namespace
				try { set tDest2=$$GetGlobalSourceDatabase^%SYS.SECURITY(tRef2) } catch { continue  }
				continue:tDest'=tDest2	// This obj in namespace tNamespace is not the same object as the one in the original namespace (ns)
				
					#; for object we now delete privs in 'acts' at the table level.
				set object=type_","_object
				if $d($$$SecurityGlobalSQLPriv(tNamespace,withGrantOption,object)) {
					do revokeEverythingForOneObject(object, $p(object,".",1,2), tNamespace,noAudit)		// relies on shared local variables!
					QUIT:SQLCODE<0
				}
					
					#; We also have to make sure to delete the privs for 'object' at the field level.
					#;  REVOKE <priv> FROM <table/view> should also revoke any column level privileges for the grantflag/action/user
				set fieldObject=object
				for  {
					set fieldObject=$o($$$SecurityGlobalSQLPriv(tNamespace,withGrantOption,fieldObject)) 
					QUIT:$e(fieldObject,1,$l(object)+1)'=(object_".")  	// only fields for this object
					do revokeEverythingForOneObject(fieldObject, object, tNamespace,noAudit)	// relies on shared local variables!
					QUIT:SQLCODE<0
				}
			}
		}
	}	// try
	catch {
		set SQLCODE=-400,%msg="Unexpected error revoking SQL privilege: "_$ze
	}
	if SQLCODE<0 {
		TROLLBACK 1 
		kill updated
	}
	else {
		TCOMMIT
	}
#if $$$USENSFORSQLUPDATE
	set updated="" for  { set updated=$o(updated(updated)) quit:updated=""  $$$SetSecuritySQLUpdate(updated) }
#else
	if $d(updated) { $$$SetSecuritySQLUpdate("xyz") }
#endif
	RETURN
.
/// Encapsulates logic used by setup1() in various places to revoke the SQL privileges associated with one object. 
/// Potentially revokes for multiple actions. The object could be a number of things such as a field (e.g. sch.tab.field1)
/// and the associatedTableName is an object type concatenated with the name of the associated table that the object belongs to. 
/// In the sch.tab1.field1 case, that would be 1,sch.tab1 where 1 is the type associated with a table. But if the object is itself a table then object will equal table
///
///	Parameters:
///		object					- string of the format type^objectName  e.g. for a table it could be "1^sch.tab". This is how
///									objects are represented in the security global.
///		associatedTableObject	- string of the format type^objectName. For example, if we are revoking privs associated
///									with a field, 'object' might be "1^sch.tab.field" and 'associatedTableObject' would be
///									"1^sch.tab"
///		namespace				- namespace in which to work within, which is a subscript of the security global.
///     noAudit                 - 0/1 suppress audit logging (for %ExecDirectNoAudit)
/// THIS IS A SUBTAG OF setup1(). IT ASSUMES SOME SHARED LOCAL VARIABLES
revokeEverythingForOneObject(object, associatedTableObject, namespace,noAudit=0)
	///	Implicit local variables shared with setup1: acts, gr, grantor, k, kk, mustBeGrantor, SQLCODE, updated, user, withGrantOption
	for i=1:1:$l(acts) {
		set action=$e(acts,i) 
		if $d($$$SecurityGlobalSQLPriv(namespace,withGrantOption,object,action)) {
			set user=""
			for k=1:1 {
				set user=$$nextu(object,namespace) 
				QUIT:user=""  
				set grantor=""
				for kk=1:1 {		// DPV3340
					set grantor=$$nextgrantor(object,user,namespace) 
					QUIT:grantor=""
					if $d($$$SecurityGlobalSQLPriv(namespace,withGrantOption,object,action,user,grantor)) { 	// *** Assumes NO "." in schema, or table name itself!!!
						do realrev(object,associatedTableObject,grantor,namespace,noAudit) 
						set updated(namespace)=1
					} else {
						
						/* Grantor usernames are stored in the security global in the exact-case of the username (although
							usernames are generally case insensitive in IRIS). It is possible that the exact-case username of 
							the grantor corresponds to a previous user, who has since been recreated with a different 
							exact-case. In such cases, the above $d() check fails and so the privilege is not revoked.
.
							For example, create user 'test'. User 'test' assigns privilege to user 'target'. User 'test'
							is deleted. Created user 'TEST'. User 'TEST' has exact-case name that does not match the case
							of 'test' who is marked as the grantor in the security global, so the above check fails.
.
							This can only happen for users with %All or %Admin_Secure:USE. For regular users, they can
							only grant privileges for objects on which they have a GRANT OPTION. When regular users are
							deleted, we revoke all privileges assigned to them, and in the process we cascade to revoke
							all privileges that *they* have assigned to other users by virtue of having GRANT OPTION on
							those objects. For super users, they can grant on anything. This means superuser 'test' may
							grant a priv on some object 't1', and when 'test' is deleted, it doesn't have its own explicit
							priv on 't1' (because it is a super user and does not need GRANT OPTION to grant privs), and
							so there is no way for us to cascade on the super user. This leads to the orphaned privileges
							explained above.
.
							If the user running this is a super user, they have the ability to revoke privileges from 
							anyone they want, in this case we should just allow them to revoke from the actual grantors
							if it's a case-insensitive match of the grantor by whom we are trying to revoke this 
							privilege on behalf of. If not a super user throw an error to that effect.
						 */
						set actualGrantor = ""
						for {
							set actualGrantor = $o($$$SecurityGlobalSQLPriv(namespace,withGrantOption,object,action,user,actualGrantor))
							QUIT:actualGrantor=""
							if $$$UPPER(actualGrantor)=$$$UPPER(grantor) {
								if 'mustBeGrantor {
									do realrev(object,associatedTableObject,actualGrantor,namespace,noAudit) 
									set updated(namespace)=1
								} else {
										// maybe original user was a super user, got deleted, and now a non-super-user
										// with different case name was created. Tell them to have super user do it
									set SQLCODE=-387,%msg=$$$FormatText($$$Text("SQL privilege granted by user that differs from current user ('%1') only in letter case. A super user must revoke this privilege", "%SQL.Security"), $$$aid)
								}
								QUIT
							}
						}
					}
					QUIT:SQLCODE<0
				}
				QUIT:SQLCODE<0
			}
		}
		QUIT:SQLCODE<0
	}
	RETURN
 
nextobject() 
	if objs'="*" {
		set object=$o(objs(oldObject))
		set oldObject = object
		RETURN:object="" ""
		RETURN type_","_$s(type'=6:object,1:$$$UPPER(object))
	}
	set object=$o($$$SecurityGlobalSQLPriv(ns,withGrantOption,object))
	RETURN $s(+object'=type:"",1:object)
 
nextu(object,ns) //
	if users'="*" {
		set returnUser=$p(users,",",k),x=$$$LOWER(returnUser)
		RETURN:x="public" "_PUBLIC"
		RETURN:x="" ""
		If $$$SecurityRolesExists(x,data) { RETURN $$$GetSecurityRolesName(data) }
		If $$$SecurityUsersExists(x,data) { RETURN $$$GetSecurityUsersName(data) }
		RETURN returnUser
	}
	RETURN $o($$$SecurityGlobalSQLPriv(ns,withGrantOption,object,action,user))
 
nextgrantor(object,user,ns) //
	if gr'="*" {		// DPV3340
		set gruser=$p(gr,",",kk),x=$$$LOWER(gruser)
		QUIT:x="public" "_PUBLIC"
		QUIT:x="" ""
		If $$$SecurityRolesExists(x,data) { QUIT $$$GetSecurityRolesName(data) }
		If $$$SecurityUsersExists(x,data) { QUIT $$$GetSecurityUsersName(data) }
		QUIT gruser
	}
	QUIT $o($$$SecurityGlobalSQLPriv(ns,withGrantOption,object,action,user,grantor))
.
#; Note:  Implicit arguments - action, withGrantOption, user, ns, casc, SQLCODE
#; Centralized configuration update counter is set by caller (setup1)
realrev(object,relationName,grantor,ns,noAudit=0) ;
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="realrev",^|"%SYS"|RJWTEST(n,"o")=$g(o),^|"%SYS"|RJWTEST(n,"obj")=$g(obj),^|"%SYS"|RJWTEST(n,"gr")=$g(gr) ;rjwtestlog
	set SQLCODE=0
	if withGrantOption {		// revoke grant option
		do upgrant(object,action,user,grantor,0,ns,noAudit)
			#;  Delete Grantable (Conditional) Index Map (Node may not exist)
		kill $$$SecurityGlobalSQLPriv(ns,1,object,action,user,grantor)
		QUIT:SQLCODE<0
	}
	else {		// revoke privilege
		do revoke(object,action,user,grantor,casc,ns,relationName,noAudit) QUIT:SQLCODE<0
	}
	if casc { do cascade(user,relationName,noAudit) QUIT:SQLCODE<0  }
	QUIT
 
#; Note:  Implicit arguments - withGrantOption, object, action, ns, casc, SQLCODE,
#; Centralized configuration update counter is set by caller (setup1)
cascade(grantingUser,obj,noAudit=0) ;
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="cascade",^|"%SYS"|RJWTEST(n,"u")=$g(u),^|"%SYS"|RJWTEST(n,"obj")=$g(obj) ;rjwtestlog
	QUIT:$d($$$SecurityGlobalSQLPriv(ns,withGrantOption,object,action,grantingUser))  ;  if granted from smb. else
	set revokeFromUser=""
	for  {
		set revokeFromUser=$o($$$SecurityGlobalSQLPriv(ns,withGrantOption,object,action,revokeFromUser)) quit:revokeFromUser=""
		if $d($$$SecurityGlobalSQLPriv(ns,withGrantOption,object,action,revokeFromUser,grantingUser)) {
			do revoke(object,action,revokeFromUser,grantingUser,casc,ns,obj,noAudit)
			quit:$g(SQLCODE)<0
			do cascade(revokeFromUser,obj,noAudit)
			quit:$g(SQLCODE)<0
		}
	}
	RETURN
}
 
.
/// checkTypeForValidPrivilege
/// Given a type and actions, make the privileg(s) are valid for this type
/// If invalid, SQLCODE/%msg will be set
checkTypeForValidPrivilege(type,acts,&SQLCODE,&%msg) [] PRIVATE {
	if type=1 {
		if acts["e" { set SQLCODE=-169,%msg=$$$Text("EXECUTE privilege is not supported for base tables", "%SQL.Security") RETURN }
		if acts["l" { set SQLCODE=-169,%msg=$$$Text("USE privilege is not supported for base tables", "%SQL.Security") RETURN }
	}
	if type=3 {
		if acts["e" { set SQLCODE=-169,%msg=$$$Text("EXECUTE privilege is not supported for views", "%SQL.Security") RETURN }
		if acts["l" { set SQLCODE=-169,%msg=$$$Text("USE privilege is not supported for views", "%SQL.Security") RETURN }
	}
	if type=6 {
		if acts["a" { set SQLCODE=-169,%msg=$$$Text("%ALTER privilege is not supported for ML Configurations","%SQL.Security") RETURN }
		if acts["d" { set SQLCODE=-169,%msg=$$$Text("DELETE privilege is not supported for ML Configurations","%SQL.Security") RETURN }
		if acts["e" { set SQLCODE=-169,%msg=$$$Text("EXECUTE privilege is not supported for ML Configurations","%SQL.Security") RETURN }
		if acts["i" { set SQLCODE=-169,%msg=$$$Text("INSERT privilege is not supported for ML Configurations","%SQL.Security") RETURN }
		if acts["r" { set SQLCODE=-169,%msg=$$$Text("REFERENCES privilege is not supported for ML Configurations","%SQL.Security") RETURN }
		if acts["s" { set SQLCODE=-169,%msg=$$$Text("SELECT privilege is not supported for ML Configurations","%SQL.Security") RETURN }
		if acts["u" { set SQLCODE=-169,%msg=$$$Text("UPDATE privilege is not supported for ML Configurations","%SQL.Security") RETURN }
	}
	if type=7 {
		if acts["a" { set SQLCODE=-169,%msg=$$$Text("%ALTER privilege is not supported for foreign servers","%SQL.Security") RETURN }
		if acts["d" { set SQLCODE=-169,%msg=$$$Text("DELETE privilege is not supported for foreign servers","%SQL.Security") RETURN }
		if acts["e" { set SQLCODE=-169,%msg=$$$Text("EXECUTE privilege is not supported for foreign servers","%SQL.Security") RETURN }
		if acts["i" { set SQLCODE=-169,%msg=$$$Text("INSERT privilege is not supported for foreign servers","%SQL.Security") RETURN }
		if acts["r" { set SQLCODE=-169,%msg=$$$Text("REFERENCES privilege is not supported for foreign servers","%SQL.Security") RETURN }
		if acts["s" { set SQLCODE=-169,%msg=$$$Text("SELECT privilege is not supported for foreign servers","%SQL.Security") RETURN }
		if acts["u" { set SQLCODE=-169,%msg=$$$Text("UPDATE privilege is not supported for foreign servers","%SQL.Security") RETURN }
	}
	if type=9 {
		if acts["a" { set SQLCODE=-169,%msg=$$$Text("%ALTER privilege is not supported for stored procedures","%SQL.Security") RETURN }
		if acts["d" { set SQLCODE=-169,%msg=$$$Text("DELETE privilege is not supported for stored procedures","%SQL.Security") RETURN }
		if acts["i" { set SQLCODE=-169,%msg=$$$Text("INSERT privilege is not supported for stored procedures","%SQL.Security") RETURN }
		if acts["l" { set SQLCODE=-169,%msg=$$$Text("USE privilege is not supported for stored procedures","%SQL.Security") RETURN }
		if acts["i" { set SQLCODE=-169,%msg=$$$Text("INSERT privilege is not supported for stored procedures","%SQL.Security") RETURN }
		if acts["r" { set SQLCODE=-169,%msg=$$$Text("REFERENCES privilege is not supported for stored procedures","%SQL.Security") RETURN }
		if acts["s" { set SQLCODE=-169,%msg=$$$Text("SELECT privilege is not supported for stored procedures","%SQL.Security") RETURN }
		if acts["u" { set SQLCODE=-169,%msg=$$$Text("UPDATE privilege is not supported for stored procedures","%SQL.Security") RETURN }
	}
	RETURN
}
.
	// Called from:  %SYS.SQLSRV, %apiDDL2, %ourProcedure, and generated %CHECKPRIV code.
priv(obj,act,ns="",grant,fields="") [] PUBLIC {
		#; Return 1 if the user is privileged, otherwise return 0
		#;  obj is the object type,name; like 1,Sample.Person
		#;  act is the action: s, i, u, d, r, a
		#;  ns is an optional alternate namespace to check for the privilege in
		#;  grant - 1/0 flag.  If 1 check if the user is privileged to grant this privilege
		#;  fields - optional, $list of fields to check for column level security
		#;           Of course if the user is privileged on the entire table no need to go that far.
  	$$$AddSecurityRoleTemporary
	s:ns="" ns=$namespace 
	If $$$nopriv(obj,act,ns,grant) { 
		QUIT:fields="" 0
		s ok=1,ptr=0 
		while $listnext(fields,ptr,field) { s fobj=obj_"."_field If $$$nopriv2(fobj,act,ns,grant) s ok=0 q  }
		QUIT ok
	}
	QUIT 1
}
.
privNoSchema(obj,act,ns="",grant,fields="") [] PRIVATE {
		#; Return 1 if the user is privileged, otherwise return 0
		#;  obj is the object type,name; like 1,Sample.Person
		#;  act is the action: s, i, u, d, r, a
		#;  ns is an optional alternate namespace to check for the privilege in
		#;  grant - 1/0 flag.  If 1 check if the user is privileged to grant this privilege
		#;  fields - optional, $list of fields to check for column level security
		#;           Of course if the user is privileged on the entire table no need to go that far.
		#;  This is called from $$check and does not check to see if the user is granted the privilege at the schema level.
  	$$$AddSecurityRoleTemporary
	set:ns="" ns=$namespace 
	If $$$noprivnoschema(obj,act,ns,grant) {
		QUIT:fields="" 0
		set ok=1,ptr=0
		while $listnext(fields,ptr,field) { set fobj=obj_"."_field if $$$nopriv2noschema(fobj,act,ns,grant) { set ok=0 quit  }  }
		QUIT ok
	}
	QUIT 1
}
.
.
/// This procedure updates the metadata indexed in ^rINDEXSQL("SERVER") from the currentVersion to the targetVersion
/// Starting with MJG216 the metadata in this node will be versioned, beginning with version 1, which updates the 
/// index to be all uppercase, storing the original case schema/server name in the $lb at each server node.
/// 
/// This procedure should be called by logic that has already checked that the global is not at the most recent version
/// 
/// This procedure is designed to dispatch incrementally to smaller procedures that each update only from the immediately preceding version. this
/// is for the future, although right now there will only be one version. This allows for e.g. updating from 1 to 3, by simply updating 1->2, then 2->3
/// not requiring specific logic for each potential upgrade jump
/// 
/// The version in ^rINDEXSQL("SERVER") is the **lowest** version present in the server index. For example, I may have one server whose metadata
/// is at version 1 and one server whose MD is version 0 (aka undefined). Then the version in the base node will still be undefined. Only after and
/// update is run and the entire update to V1 has been completed (and thus we know every row is at least V1) will ^rINDEXSQL("SERVER") be set to 1.
/// This should behave likewise for any future versions. As of version 1, the version number for a specific server's MD will be stored in the 3 rd index of
/// the $lb stored for the server
updateForeignServerIndex() PUBLIC {
	#; These routines live in IRISLIB
	if '$$$IAmSuperUser && ('(($$$CallingRoutineIsOneOf(",%apiDDL,%apiDDL2,%Library.SQLCatalogPriv.1,%occClass,%occCompile,%ocsSQLRTDict,%qaqpqo,%SQL.Manager.CatalogPriv.1,%SYSTEM.SQL.Security.1,") && $$$CallingDBIsIRISLIB) || ($$$CallingRoutineIs("%SYS.SQLSEC") && $$$CallingDBIsMgrDB))) { 
		RETURN $$$ERROR($$$InvalidCallingRoutine, "updateForeignServerIndex^%SYS.SQLSEC", $zu(96,9))
	}
	$$$AddAllRoleTemporary
	// the caller should only call if this version is below but just in case, check if it's already updated
	// FSIDX = foreign server index 
	try {
		RETURN:$$$FSIDXGetLowestCommonVersion=$$$FSIDXLatestVersion $$$OK
		RETURN:'$d($$$FSIDXBaseNode) $$$OK // not even populated yet
.
		for version=($$$FSIDXGetLowestCommonVersion+1):1:$$$FSIDXLatestVersion {
			// when there's more than one version increment, can use this $case for the loop instead of a bunch of if statements
			#; set sc = $case(version,
			#; 	1:$$updateForeignServerIndexV1()
			#; )
			if version = 1 {
				set sc = $$updateForeignServerIndexV1()
			}
			RETURN:$$$ISERR(sc) sc // if something went wrong tell the caller that we couldn't fully convert
		}
	} catch ex {
		RETURN ex.AsStatus()
	}
	RETURN $$$OK
}
.
/// - Change index (i.e. the global keys) to be upper case
/// - Store the version of that particular server in the $lb(3), the original case schema/server in the $lb(4) and $lb(5) pieces of the $lb stored at the server node
/// The version of the node in the $lb(3) is in case some servers are in one format and others are in a different format. This will allow us to skip
/// that particular node if they're at a version past the version we're converting to in order to make sure we're not messing up existing index entries
/// RETURN: 1 if converted successfully, 0 if not
/// 
/// This should only be called via updateForeignServerMetadata()
updateForeignServerIndexV1() [] PRIVATE {
	// This may have been called in the process of some action by a user that is not privileged to change ^rINDEXSQL so
	// escalate to the %All role
	set tSC = $$$OK
	$$$AddAllRoleTemporary
	#define updateToVersion 1
	try {
		TSTART
		set lock = 1
		lock +$$$FSIDXBaseNode:$$$LockTimeout // make sure we don't file into/kill from here while converting
		if '$test {
			set lock = 0
			set tSC = $$$ERROR($$$LockFailedToAcquireExclusive, $$$FormatText($$$Text("Could not acquire exclusive lock when updating foreign server index", "%SQL.Security")))
			THROW
		}
		set schemaOriginal = ""
		for {
			set schemaOriginal = $o($$$FSIDXSchema(schemaOriginal))
			quit:schemaOriginal=""
			set schemaUpper = $$$UPPER(schemaOriginal)
			set serverOriginal = ""
			for {
				set serverOriginal = $o($$$FSIDXServer(schemaOriginal, serverOriginal), 1, originalServerMetadata)
				quit:serverOriginal=""
				// This ~specific~ server might already be at/above the version we're updating to
				// Note: (Below case should not happen because we update the index when inserting an FT) 
				// Just in case an FT was added under this server with version 1 before the server index was updated to version 1, then that V1 FT node would have the server in all caps 
				// but there'd be no corresponding $lb under the all caps server name so first let's just make sure ^rINDEXSQL("SERVER", schemaOriginal, serverOriginal) has server index 
				// data at that actual node before checking the $lb. The first condition here is true if the node is undefined, in which case we should just continue
				if '($d($$$FSIDXServer(schemaOriginal, serverOriginal))#2) || ($$$FSIDXServerGetVersion(schemaOriginal, serverOriginal) >= $$$updateToVersion) {
					CONTINUE
				}
				set serverUpper = $$$UPPER(serverOriginal)
				set $$$FSIDXServer(schemaUpper, serverUpper) = originalServerMetadata _ $lb($$$updateToVersion, schemaOriginal, serverOriginal)
				// If the original case of both the schema/server names are upper already, we just have to update the $lb at the base node as above
				// and then continue on, or else we risk killing the node below (and an unnecessary merge operation)
				if schemaUpper = schemaOriginal, serverUpper = serverOriginal {
					CONTINUE
				}
				// Merge whole substructure of FTs indexed under this server (if any) & add extra metadata to the $lb that version 1 calls for.
				merge $$$FSIDXServerFTBaseNode(schemaUpper, serverUpper) = $$$FSIDXServerFTBaseNode(schemaOriginal, serverOriginal)
				// Something might go wrong on a future entry, but we kill the old indices on a per-server basis after that entire server is done
				// So the data is already stored in the new format for that server. If remaining server metadata is left in intermediate state still, we can 
				// later return to finish the update on the rest of the items because the lowest common version only gets updated when all the servers are handled.
				kill $$$FSIDXServer(schemaOriginal, serverOriginal)
			}
		}
	} catch ex {
		lock:lock -$$$FSIDXBaseNode
		TROLLBACK 1
		RETURN $select($$$ISERR(tSC): tSC, 1:ex.AsStatus())
	}
	set $$$FSIDXBaseNode = $$$updateToVersion
	lock:lock -$$$FSIDXBaseNode
	TCOMMIT
	RETURN $$$OK
}
.
noprivuser(owner,obj,act,ns,grant,fields="") [] PUBLIC { 
		#; return 1 if the user in 'owner' is NOT privileged
		#; return 0 if the user in 'owner' IS privileged
	$$$SuspendErrorCount
	set sc=$$$OK
	set roles=$zstl($s($$$LOWER(owner)=$$$LOWER($username):$roles,1:$$roleset(owner)))
  	$$$AddSecurityRoleTemporary
	If $$$noprivuser(owner,obj,act,ns,grant,roles,sc) { 
		If fields="" { QUIT 1 } // user is not privileged
		s ok=0,ptr=0	// assume they will be privileged
		while $listnext(fields,ptr,field) { 
			set fobj=obj_"."_field 
			if $$$noprivuser2(owner,fobj,act,ns,grant,roles) set ok=1 quit  // found a field they do not have privilege on, stop looking any further
		}
		QUIT ok
	}
		#; If we get here, the user was privileged at the table level
	QUIT 0
}
.
 
AnyPrivObj(obj,grantOnly=0,tablePriv) [] PUBLIC { 	// DPV3029 (grantOnly)	// DPV3193	// DPV3219 (tablePriv)
		#; tablePriv is passed by reference
		#; return 1 if the user is privileged for the object at the table/view level, otherwise return 0
	if $$$IAmSuperUser { set tablePriv=1 RETURN 1 }
	set grantOnly=''grantOnly,tablePriv=0
	if +obj<4 {	// Tables and Views
		set a="",p=0 
		for a="s","i","u","d","r","a" {
			if $$priv(obj,a,$namespace,grantOnly) { set p=1,tablePriv=1 quit  }
		}
		if 'p { // See if the user is privileged for any field for this table/view (DPV3209)
  			$$$AddSecurityRoleTemporary
			set nobj=obj
			for  {
				set nobj=$o($$$SecurityGlobalSQLPriv($namespace,grantOnly,nobj)) quit:($e(nobj,1,$l(obj)+1))'=(obj_".")
				for a="s","i","u","r" { if $$priv(nobj,a,$namespace,grantOnly) { s p=1 quit  } }
			}
		}
	}
	elseif +obj=4 { set p=0 set:$$priv(obj,"s",$namespace,grantOnly) p=1 }
	elseif +obj=6 { set p=0 set:$$priv(obj,"l",$namespace,grantOnly) p=1 }
	elseif +obj=7 { set p=0 set:$$priv(obj,"l",$namespace,grantOnly) p=1 }
	else { set p=0 set:$$priv(obj,"e",$namespace,grantOnly) p=1 }
	RETURN p
}
.
AnyPrivObjS(obj,grantOnly=0,tablePriv) [] PUBLIC { 	// DPV3300
		#; tablePriv is passed by reference
		#; return 1 if the user has SELECT privilege for the object at the table/view level, or on any field in the table/view
	If $$$IAmSuperUser s tablePriv=1 QUIT 1
	s grantOnly=''grantOnly,tablePriv=0
	if +obj<4 {	// Tables and Views
		s p=0 
		i $$priv(obj,"s",$namespace,grantOnly) { s p=1,tablePriv=1 }
		if 'p { // See if the user is privileged for any field for this table/view (DPV3209)
  			$$$AddSecurityRoleTemporary
			s nobj=obj
			f  { s nobj=$o($$$SecurityGlobalSQLPriv($namespace,grantOnly,nobj)) q:($e(nobj,1,$l(obj)+1))'=(obj_".")  i $$priv(nobj,"s",$namespace,grantOnly) { s p=1 q  } }
		}
	}
	QUIT p
}
.
AnyPrivObjIUD(obj,grantOnly=0,tablePriv) [] PUBLIC { 	// DPV3300
		#; tablePriv is passed by reference
		#; return 1 if the user has INSERT, UPDATE, or DELETE privilege for the object at the table/view level, or on any field in the table/view
	If $$$IAmSuperUser s tablePriv=1 QUIT 1
	s grantOnly=''grantOnly,tablePriv=0
	if +obj<4 {	// Tables and Views
		s a="",p=0 
		f a="i","u","d" { i $$priv(obj,a,$namespace,grantOnly) s p=1,tablePriv=1 q  }
		if 'p { // See if the user is privileged for any field for this table/view (DPV3209)
  			$$$AddSecurityRoleTemporary
			s nobj=obj
			f  { s nobj=$o($$$SecurityGlobalSQLPriv($namespace,grantOnly,nobj)) q:($e(nobj,1,$l(obj)+1))'=(obj_".")  f a="i","u" { i $$priv(nobj,a,$namespace,grantOnly) s p=1 q  } }
		}
	}
	else { s p=0 s:$$priv(obj,"e",$namespace,grantOnly) p=1 }
	QUIT p
}
.
AnyPrivTable(obj,grantOnly=0) [] PUBLIC {	// DPV3219
		#; Return 1 if the current user has any table-level privilege on the table or view
		#; They may or may not be privileged at the column level, but this can be called to tell us if we need to call AnyPrivField
	QUIT:$$$IAmSuperUser 1
	s grantOnly=''grantOnly
	s a="",p=0 f a="s","i","u","d","r","a" { i $$priv(obj,a,$namespace,grantOnly) s p=1 q  }
	QUIT p
}
 
AnyPrivField(obj,field,grantOnly=0) [] PUBLIC {	// DPV3219
		#; Return 1 if the current user has any field-level privilege on the field in the table or view specified in obj
		#; We probably only called this is AnyPrivTable returned 0
	QUIT:$$$IAmSuperUser 1
	s grantOnly=''grantOnly
	s a="",p=0 f a="s","i","u","r" { i $$priv(obj_"."_field,a,$namespace,grantOnly) s p=1 q  }
	QUIT p
}
.
	#; for a given schema, see if the user has any priv (or grant option) on any table in the schema (DPV3029)
AnySchemaTablePriv(pSchema,pGrantOnly=0,%q) [] PUBLIC { 
	s ok=0,tSCHEMA=$$$UPPER(pSchema)
	if $e(pSchema)'="%" { set tSchema="&" } else { set tSchema="" }
		#;  have to be careful when looping over schemas here.  We need to pick up schemas in all cases, but some locales
		#;  lower case will collate before mixed case (Czech Unicode is one example).  So I just loop over all the schemas
		#;  and check which ones match pSchema.  Should still be pretty fast to check.
	for  { 
		set tSchema=$$GetNextSubscript("^rINDEXSQL(""TABLE"")",tSchema) quit:tSchema=""
		set tSchemaU=$$$UPPER(tSchema)
		continue:tSchemaU'=tSCHEMA
		set tTable=""
		for  { 
			s tTable=$o(^rINDEXSQL("TABLE",tSchema,tTable)) q:tTable=""
			set tTableU=$$$UPPER(tTable)
			if $g(%q("tfilter")) {
				set ok=0
				for i=1:1:%q("tfilter") { if tTableU?@%q("tfilter",i) { set ok=1 quit  }}
				continue:'ok 	// Table does not match any of the positive patterns specified
			}
			if $g(%q("tfilter2")) {	// NOT pattern matches
				set ok=1
				for i=1:1:%q("tfilter2") { if tTableU?@%q("tfilter2",i) { set ok=0 quit  }}
				continue:'ok	// Table does match one of the NOT patterns specified, don't report it
			}
			set ok=$$AnyPrivObj("1,"_tSchema_"."_$tr(tTable,".",$c(2)),pGrantOnly) quit:ok
		}
		quit:ok
	}
	QUIT ok 
}
 
	#; for a given schema, see if the user has any priv (or grant option) on any view in the schema (DPV3029)
AnySchemaViewPriv(pSchema,pGrantOnly=0,%q) [] PUBLIC { 
	s ok=0,tSCHEMA=$$$UPPER(pSchema)
	if $e(pSchema)'="%" { set tSchema="&" } else { set tSchema="" }
		#;  have to be carefull when looping over schemas here.  We need to pick up schemas in all cases, but some locales
		#;  lower case will coolate before mixed case (Czech Unicode is one example).  So I just loop over all the schemas
		#;  and check which ones match pSchema.  Should still be pretty fast to check.
	for  { 
		set tSchema=$$GetNextSubscript("^rINDEXSQL(""VIEW"")",tSchema) q:tSchema=""
		continue:$$$UPPER(tSchema)'=tSCHEMA
		set tView=""
		for  { 
			s tView=$o(^rINDEXSQL("VIEW",tSchema,tView)) q:tView=""
			set tViewU=$$$UPPER(tView)
			if $g(%q("tfilter")) {
				set ok=0
				for i=1:1:%q("tfilter") { if tViewU?@%q("tfilter",i) { set ok=1 quit  }}
				continue:'ok 	// Table does not match any of the positive patterns specified
			}
			if $g(%q("tfilter2")) {	// NOT pattern matches
				set ok=1
				for i=1:1:%q("tfilter2") { if tViewU?@%q("tfilter2",i) { set ok=0 quit  }}
				continue:'ok	// Table does match one of the NOT patterns specified, don't report it
			}
			s ok=$$AnyPrivObj("3,"_tSchema_"."_$tr(tView,".",$c(2)),pGrantOnly) q:ok
		}
		q:ok
	}
	QUIT ok 
}
 
	#; for a given schema, see if the user has any priv (or grant option) on any procedure in the schema (DPV3029)
AnySchemaProcPriv(schema,grantOnly=0,%q) [] PUBLIC { 
	set SCHEMA=$$$UPPER(schema),ok=0,PROC="" 
	for  { 
		set PROC=$$GetNextSubscript("^oddPROC("""_SCHEMA_""")",PROC) q:PROC=""  
		//continue:$g($$$PROChidden($$$pPROC,SCHEMA,PROC))
		continue:'$g($$$PROCprojected($$$pPROC,SCHEMA,PROC))  
		if $g(%q("tfilter")) {
			set ok=0
			for i=1:1:%q("tfilter") { if PROC?@%q("tfilter",i) { set ok=1 quit  }}
			continue:'ok 	// Table does not match any of the positive patterns specified
		}
		if $g(%q("tfilter2")) {	// NOT pattern matches
			set ok=1
			for i=1:1:%q("tfilter2") { if PROC?@%q("tfilter2",i) { set ok=0 quit  }}
			continue:'ok	// Table does match one of the NOT patterns specified, don't report it
		}
		set proc=$g($$$PROCname($$$pPROC,SCHEMA,PROC))
		set ok=$$ExecutePriv("9,"_$$$BuildIQN(schema,proc),grantOnly) q:ok
	}
	QUIT ok }
 
ExecutePriv(obj,grantOnly=0) [] PUBLIC { i $$priv(obj,"e",$namespace,grantOnly) { QUIT 1 } QUIT 0 }	// DPV2405=	// DPV3029 (grantOnly)
 
roleset(user,type="") [] PUBLIC {
		#; Given a user name, return the Login $Roles value for that user
	s $zt="Error"
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	n $namespace d $zu(5,"%SYS")
	s roles="",type=$$$LOWER(type)
	if type="user" { d ##class(Security.Users).GetRoleSet(user,.roles) } 
	elseif type="role" { d ##class(Security.Roles).RecurseRoleSet(user,.roles) }
	else {	// don't know if it is a role or user
		if $$$SecurityUsersExists($$$LOWER(user),data) { d ##class(Security.Users).GetRoleSet(user,.roles) }  // User???
		elseif $$$SecurityRolesExists($$$LOWER(user),data) { d ##class(Security.Roles).RecurseRoleSet(user,.roles) }  // Role???
	}
	QUIT roles
Error	s $zt=""
	QUIT ""
}
.
	#; rolechek::  return 0 if allowed, 1 otherwise
	;   SQL Privileges metadata
	;   $$$SecurityGlobal,"SQL","priv",<database>,<grant opt>,(<reltype>,<name>),<priv-code>,<grantee>,<grantor>)=<grant opt>
rolechek(dir,obj,act,grant) [] PUBLIC {
  	$$$AddSecurityRoleTemporary
	set nok=1
	for i=1:1:$l($Roles,",") {
		set role=$p($Roles,",",i) kill exactrole
		set roledata=$g($$$SecurityGlobalRoles(role))
		set:roledata'="" exactrole=$lg(roledata,4)
		if $d($$$SecurityGlobalSQLPriv(dir,grant,obj,act,$g(exactrole,role))) { set nok=0 quit  }
	}
	QUIT nok
}
 
	#; rolechekuser::  return 0 if allowed, 1 otherwise
rolechekuser(dir,grant,obj,act,user,roles) [] PUBLIC { 
  	$$$AddSecurityRoleTemporary
	QUIT:roles="" 1
	set nok=1
	for i=1:1:$ll(roles) {
		set role=$lg(roles,i)  kill exactrole
		set roledata=$g($$$SecurityGlobalRoles(role))
		set:roledata'="" exactrole=$lg(roledata,4)
		if $d($$$SecurityGlobalSQLPriv(dir,grant,obj,act,$g(exactrole,role))) { set nok=0 quit  }
	}
	QUIT nok
}
.
	#; RoleCheckList::  return 0 if allowed, 1 otherwise
RoleCheckList(dir,grant,obj,act,roles) [] PUBLIC { 
  	$$$AddSecurityRoleTemporary
	set nok=1 
	for i=1:1:$ll(roles) {
		set role=$lg(roles,i) kill exactrole
		set roledata=$g($$$SecurityGlobalRoles(role))
		set:roledata'="" exactrole=$lg(roledata,4)
		if $d($$$SecurityGlobalSQLPriv(dir,grant,obj,act,$g(exactrole,role))) { set nok=0 quit  }
	}
	QUIT nok
}
.
	// Check to see if the user, _PUBLIC, any of the user's roles has the privilege on the schema
	// Return 0 if privileged, 1 otherwise
SchemaCheck(pDir,pObj,pGrant,pAction) [] PUBLIC {
  	$$$AddSecurityRoleTemporary
	set tSchema="5,"_$$$UPPER($$$SchemaFromIQN($e(pObj,3,*)))
	QUIT:$d($$$SecurityGlobalSQLPriv(pDir,pGrant,tSchema,pAction,$$$aid)) 0			// See if this user has privilege on the schema
	QUIT:$d(^("_PUBLIC")) 0									// See if _PUBLIC has privilege on the schema
	QUIT $$rolechek(pDir,tSchema,pAction,pGrant)									// See if any of the user's roles has privilege on the schema
}
.
	// Check to see if the given user, _PUBLIC, any of the user's roles has the privilege on the schema
	// Return 0 if privileged, 1 otherwise
SchemaCheckUser(pDir,pObj,pGrant,pAction,pUser,pRoles) [] PUBLIC {
  	$$$AddSecurityRoleTemporary
	set tSchema="5,"_$$$UPPER($$$SchemaFromIQN($e(pObj,3,*)))
	QUIT:$d($$$SecurityGlobalSQLPriv(pDir,pGrant,tSchema,pAction,pUser)) 0			// See if the user has privilege on the schema
	QUIT:$d(^("_PUBLIC")) 0									// See if _PUBLIC has privilege on the schema
	QUIT $$rolechekuser(pDir,pGrant,tSchema,pAction,pUser,pRoles)				// See if any of the user's roles has privilege on the schema
}
.
	// Check the owner of the object to see if the owner is the current user or a role the user has been granted
	// Note, we check $roles for the user's roles for this...
	// Note, we assume this is never called if the user has the %All role
	// Return 0 if privileged, 1 otherwise
	// We will also check if the SQL items projected by the class has defined the SQLPUBLICSECURITY parameter to see if the operation should be allowed.
	// The parameter is defined as a JSON string with the following format:
	// Parameter SQLPUBLICSECURITY = {"sql_name":"priv_list",...}
	// sql_name = the name of the SQL table, view, or procedure
	// priv_list = comma-list of SQL privileges
	// For example:
	// 		Parameter SQLPUBLICSECURITY = {"%SQL_Diag.Message":"S","%SQL_Diag.add_diag_result":"E"};
	// 
	// RETURNS 0 if this user is the "owner" of the object, OR if the object's class defines this object as SQLPUBLICSECURITY
	// Otherwise return 1
	// 
	// Called from:
	// - StatementIndexPrivileged
	// - CQPrivCheck^%SYS.SQLSRV
	// - $$$Error404SP (defined in %SYS.DBSRV.inc)
	// - $$nopriv, $$$noprivnoschema, $$$nopriv2, $$$nopriv2noschema (defined in %msql.inc)
OwnerCheck(pObj,acts) [] PUBLIC {
	set tType=+pObj,tObj=$e(pObj,3,*)
	if 'tType || (pObj="") { RETURN 1 }
	if tType<4 {	// table object or view object
			#; We will first try to get the owner from $$$smd in case the table does not have a class definition
		set irn=$p($g(^||%sql.smd("rv",$zu(28,tObj,5))),$c(1),2)
		if irn { set tOwner=$$$smdOwner(tType,irn) }
			#; If smd is not defined or there is no owner, get the owner from the class definition
		if $g(tOwner)="" { set tOwner=$$$LOWER($lg($g(^rINDEXSQL("rv",$$$UPPER($$$SchemaFromIQN(tObj)),$$$UPPER($$$TableFromIQN(tObj)))),6)) }
		set classname=$$$GetClassNameFromIQN(tObj)
			#; See if the SQLPUBLICSECURITY class parameter give everyone access to this table/view priv
		if $$SQLPUBLICSECURITYCheck(classname,$$$LOWER($$$TableFromIQN(tObj)),acts) { RETURN 0 }
	} elseif tType=6 {	// ML Configuration
		set tOwner=##class(%SYS.ML.Configuration).%GetOwner(tObj)
	} elseif tType=7 {
		do updateForeignServerIndex()
		set schemaUpper = $$$UPPER($p(tObj,".",1))
		set serverUpper = $$$UPPER($p(tObj,".",2))
		RETURN:'$d($$$FSIDXServer(schemaUpper, serverUpper)) 1
		set className = $$$FSIDXServerGetClassName(schemaUpper, serverUpper)
		set tOwner = $s(className'="": $$$comClassKeyGet(className,$$$cCLASSowner), 1:"")
	} elseif tType=9 {	// procedure object
			// If this is a User Defied Aggregate, the owner is in the aggreate definition, there is no class.
		if $$$PROCtype($$$pPROC,$$$UPPER($$$SchemaFromIQN(tObj)),$$$UPPER($$$TableFromIQN(tObj)))=$$$cPROCTYPEUDAF {
			set tOwner=$$$PROCudafowner($$$pPROC,$$$UPPER($$$SchemaFromIQN(tObj)),$$$UPPER($$$TableFromIQN(tObj)))
		} else {
			set classname=$$$PROCclass($$$pPROC,$$$UPPER($$$SchemaFromIQN(tObj)),$$$UPPER($$$TableFromIQN(tObj)))
			RETURN:classname="" 1
				#; See if the SQLPUBLICSECURITY class parameter give everyone access to this procedure
			if $$SQLPUBLICSECURITYCheck(classname,$$$LOWER($$$TableFromIQN(tObj)),acts) { RETURN 0 }
			set tOwner=$$$comClassKeyGet(classname,$$$cCLASSowner)
		}
	}
	RETURN:$g(tOwner)="" 1	// Need something for Cubes???
	RETURN:$$$LOWER($$$aid)=$$$LOWER(tOwner) 0			// This user is the object's owner
	RETURN:$$$LOWER("_PUBLIC")=$$$LOWER(tOwner) 0			// Table owner is _PUBLIC
	RETURN:(","_$$$LOWER($roles)_",")[(","_$$$LOWER(tOwner)_",") 0	// One of this user's roles is the objects owner
	RETURN 1
}
.
	// Check the owner of the object to see if the owner is the pUser or a role the pUser has been granted
	// Note, we assume this is never called if pUser has the %All role
	// Return 0 if privileged, 1 otherwise
	// 
	// Called from:
	// Called from:
	// - SQLUserPrivsExecute
	// - $$$noprivuser, $$$noprivuser2, CQnopriv (defined in %SYS.SQLSEC.inc)
OwnerCheckUser(pUser,pRoles,pObj,acts) [] PRIVATE {
	set tType=+pObj,tObj=$e(pObj,3,*)
	if tType<4 {	// table object or view object
			#; We will first try to get the owner from $$$smd in case the table does not have a class definition
		set irn=$p($g(^||%sql.smd("rv",$zu(28,tObj,5))),$c(1),2)
		if irn { set tOwner=$$$smdOwner(tType,irn) }
			#; If smd is not defined or there is no owner, get the owner from the class definition
		if $g(tOwner)="" { set tOwner=$$$LOWER($lg($g(^rINDEXSQL("rv",$$$UPPER($$$SchemaFromIQN(tObj)),$$$UPPER($$$TableFromIQN(tObj)))),6)) }
		set classname=$$$GetClassNameFromIQN(tObj)
			#; See if the SQLPUBLICSECURITY class parameter give everyone access to this table/view priv
		if $$SQLPUBLICSECURITYCheck(classname,$$$LOWER($$$TableFromIQN(tObj)),acts) { RETURN 0 }
	} elseif tType=6 {	// ML Configuration
		set tOwner=##class(%SYS.ML.Configuration).%GetOwner(tObj)
	} elseif tType=7 {	// Foreign Servers
		// need to get the exact schema/server name
		do updateForeignServerIndex()
		set schemaUpper = $$$UPPER($p(tObj,".",1))
		set serverUpper = $$$UPPER($p(tObj,".",2))
		RETURN:'$d($$$FSIDXServer(schemaUpper, serverUpper)) 1
		set className = $$$FSIDXServerGetClassName(schemaUpper,serverUpper)
		set tOwner = $s(className'="": $$$comClassKeyGet(className,$$$cCLASSowner), 1:"")
	} elseif tType=9 {	// procedure object
		set classname=$$$PROCclass($$$pPROC,$$$UPPER($$$SchemaFromIQN(tObj)),$$$UPPER($$$TableFromIQN(tObj)))
		RETURN:classname="" 1
				#; See if the SQLPUBLICSECURITY class parameter give everyone access to this procedure
		if $$SQLPUBLICSECURITYCheck(classname,$$$LOWER($$$TableFromIQN(tObj)),acts) { RETURN 0 }
		set tOwner=$$$comClassKeyGet(classname,$$$cCLASSowner)
	}
	RETURN:$g(tOwner)="" 1
	RETURN:$$$LOWER(pUser)=$$$LOWER(tOwner) 0				// This user is the object's owner
	RETURN:$$$LOWER("_PUBLIC")=$$$LOWER(tOwner) 0			// Table owner is _PUBLIC
	RETURN:(","_$$$LOWER($ListToString(pRoles))_",")[(","_$$$LOWER(tOwner)_",") 0	// One of this user's roles is the objects owner
	RETURN 1
}
.
	// Return 1 if the privilege requested is defined as PUBLIC in the SQLPUBLICSECURITY parameter of the class
	// We only check the unqualified "short" name of the SQL item
SQLPUBLICSECURITYCheck(classname,sqlname,priv) [] PRIVATE {
	#dim classPublicPrivs As %Library.DynamicObject
	try { set classPublicPrivs=$parameter(classname,"SQLPUBLICSECURITY") } catch { set $ze="" RETURN 0 }
	if classPublicPrivs'="" {
		try {
			set classPublicPrivs=##class(%Library.DynamicObject).%FromJSON($$$LOWER(classPublicPrivs))
			set paramprivs=classPublicPrivs.%Get($$$LOWER(sqlname))
				#; SQLPUBLICSECURITY allows us to define a security resource check that is required to have privilege for the sql object
				#; The syntax for the privilege is "Requires:ResourceName:Permission"
				#; For example, "Requires:%Development:USE"
				#; This means any user with %Development:USE system privilege will be able to access this SQL Object
			if $p(paramprivs,":",1)="requires" {
				RETURN ##class(%SYSTEM.Security).Check($p(paramprivs,":",2),$p(paramprivs,":",3))
			}
			if priv'["," { if (","_paramprivs_",")[(","_$$$LOWER(priv)_",") { RETURN 1 } }	// single privilege we are checking
			else {
				set ok=1
				for i=1:1:$l(priv,",") {
					set p=$p(priv,",",i) continue:p=""
					if (","_paramprivs_",")'[(","_$$$LOWER(p)_",") { set ok=0 quit }	// required privilege is not in the param priv list
				}
				if ok { RETURN 1 }	// all required privileges are public in the SQLPUBLICSECURITY parameter
			}
		} catch {}
	}
	RETURN 0
}
 
	// Check the owner to see if the owner is the current user or a role the current user has
	// Return 1 if the current user is the "owner", otherwise 0
	// 
	// Called from CheckDropPriv^%apiDDL2
OwnerCheckUser2(owner) [] PUBLIC {
	RETURN:$g(owner)="" 0
	set owner=$$$LOWER(owner)
	RETURN:$$$LOWER($$$aid)=owner 1				// This user is the owner
	RETURN:$$$LOWER("_PUBLIC")=owner 1			// owner is _PUBLIC
	RETURN:(","_$$$LOWER($roles)_",")[(","_owner_",") 1	// One of this user's roles is the owner
	RETURN 0
}
.
grant(obj,act,user,grantor,grantable,ns="",fields="",noAudit=0) [SQLCODE] PRIVATE {
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="grant",^|"%SYS"|RJWTEST(n,"act")=$g(act),^|"%SYS"|RJWTEST(n,"obj")=$g(obj),^|"%SYS"|RJWTEST(n,"user")=$g(user),^|"%SYS"|RJWTEST(n,"grantor")=$g(grantor),^|"%SYS"|RJWTEST(n,"grantable")=$g(grantable),^|"%SYS"|RJWTEST(n,"ns")=$g(ns),^|"%SYS"|RJWTEST(n,"fields")=$g(fields) ;rjwtestlog
		#;  Grant Privilege 'act' on object 'obj' to user 'user'
		#;  Granted By 'grantor', with grant Option 'grantable'
		#;  If fields is specified, only grant on that list of fields, not the entire table
		#;
	s $zt="granterr"
  	$$$AddSecurityRoleTemporary
	s:ns="" ns=$namespace
	if fields'="" {
		s ptr=0,extent=$$$GetExtentNameFromIQN($p(obj,",",2,999))
		while $listnext(fields,ptr,field) {
			s field=$g($$$EXTsqlcolumnidx($$$rEXT,extent,field)) continue:field=""
			s objf=obj_"."_field
				#;  Define Master Map
			s $$$SecurityGlobalSQLPriv(ns,0,objf,act,user,grantor)=grantable
				#;  Define Grantable (Conditional) Index Map
			s:grantable $$$SecurityGlobalSQLPriv(ns,1,objf,act,user,grantor)=grantable
				#;  Define Object User Index Map
			s $$$SecurityGlobalSQLPriv(ns,"m",user,objf_"||"_act_"||"_user_"||"_grantor)=""
			do auditGrantField(user,grantor,act,obj,field,grantable,noAudit)
		}
		s SQLCODE=0 QUIT
	}
		#;  Define Master Map
	s $$$SecurityGlobalSQLPriv(ns,0,obj,act,user,grantor)=grantable
		#;  Define Grantable (Conditional) Index Map
	s:grantable $$$SecurityGlobalSQLPriv(ns,1,obj,act,user,grantor)=grantable
		#;  Define Object User Index Map
	s $$$SecurityGlobalSQLPriv(ns,"m",user,obj_"||"_act_"||"_user_"||"_grantor)=""
	do auditGrant(0,user,grantor,act,obj,grantable,noAudit)
	s SQLCODE=0
	QUIT
 
granterr s $zt="",SQLCODE=-400,%msg=$ze QUIT
 
}
 
upgrant(obj,act,user,grantor,grantable,ns="",noAudit=0) [SQLCODE] PRIVATE {	// DPV2949=
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="upgrant",^|"%SYS"|RJWTEST(n,"act")=$g(act),^|"%SYS"|RJWTEST(n,"obj")=$g(obj),^|"%SYS"|RJWTEST(n,"user")=$g(user),^|"%SYS"|RJWTEST(n,"grantor")=$g(grantor),^|"%SYS"|RJWTEST(n,"grantable")=$g(grantable),^|"%SYS"|RJWTEST(n,"ns")=$g(ns) ;rjwtestlog
	  #;  Update grant option for privilege a pre-existing privilege definition
	  #;
  	$$$AddSecurityRoleTemporary
	try {
		set:ns="" ns=$namespace
			#;  Does the Privilege exist?
		if '$d($$$SecurityGlobalSQLPriv(ns,0,obj,act,user,grantor)) { set SQLCODE=-109 QUIT  }
		if $$$IsASuperUser(user)||(user="") QUIT
			#;  Update Master Map
		set $$$SecurityGlobalSQLPriv(ns,0,obj,act,user,grantor)=grantable
			#;  Define Grantable (Conditional) Index Map
		if grantable { set $$$SecurityGlobalSQLPriv(ns,1,obj,act,user,grantor)=grantable }
		do auditGrantOptUpdate(user,grantor,act,obj,grantable,noAudit) // upgrant() updates an existing privilege to have grant option or no longer have grant option. The former case it's called from userstuf() and the latter case it's called from realrev().
		set SQLCODE=0
	}
	catch {
		set SQLCODE=-400,%msg=$ze
	}
	QUIT
}
 
revoke(obj,act,user,grantor,casc=0,ns="",relname,noAudit=0) [SQLCODE] PRIVATE {
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="revoke",^|"%SYS"|RJWTEST(n,"act")=$g(act),^|"%SYS"|RJWTEST(n,"obj")=$g(obj),^|"%SYS"|RJWTEST(n,"user")=$g(user),^|"%SYS"|RJWTEST(n,"grantor")=$g(grantor),^|"%SYS"|RJWTEST(n,"casc")=$g(casc),^|"%SYS"|RJWTEST(n,"ns")=$g(ns),^|"%SYS"|RJWTEST(n,"relname")=$g(relname) ;rjwtestlog
	  #;  Revoke a privilege
	  #;  Centralized configuration update counter is set by callers (CachedQueryPrivReset & setup1)
.
	try {
  		$$$AddSecurityRoleTemporaryInTry
		set:ns="" ns=$namespace
		if 'casc,$d($$$SecurityGlobalSQLPriv(ns,1,obj,act,user)) {
				#;  Handle RESTRICT... - user has GRANT option, see if they actually granted a privilege
			set i="",restrict=0
			for  {
				set i=$o($$$SecurityGlobalSQLPriv(ns,0,obj,act,i)) quit:i=""
				if $d($$$SecurityGlobalSQLPriv(ns,0,obj,act,i,user)) { set restrict=1 quit  }
			}
			if restrict { set SQLCODE=-126,%msg=$$$Text("REVOKE failed because CASCADE not specified and a privilege has been granted by revokee","%SQL.Security") QUIT  }
		}
			#;  Delete Master Map
		kill $$$SecurityGlobalSQLPriv(ns,0,obj,act,user,grantor)
			#;  Delete Grantable (Conditional) Index Map (Node may not exist)
		kill $$$SecurityGlobalSQLPriv(ns,1,obj,act,user,grantor)
			#;  Define Object User Index Map
		kill $$$SecurityGlobalSQLPriv(ns,"m",user,obj_"||"_act_"||"_user_"||"_grantor)
			#;  Mark all Cached Queries which use the obj to rebuild privilege user/role
			#;  list next time the query is used.
		set x=$$$LOWER(user)
		set tIsRole=0
		if $$$SecurityRolesExists(x,data) { set tIsRole=1 }
		do CachedQueryPrivReset(relname,.sc,$s('tIsRole:user,1:""),ns)		// DPV3020 (All privs, not just NOT"e")
		QUIT:$$$ISERR(sc)
		set SQLCODE=0
		set isFieldLevel = 0
    	set type = +obj
		if type<4, $g(relname)'="" { // table or view
			if ($l(obj)>$l(relname)) {
				set isFieldLevel=1
				set fieldName=$e(obj, $l(relname)+2, *)
			}
		}
		if isFieldLevel {
			do auditRevokeField(user,grantor,act,relname,fieldName,casc,noAudit)
		} else {
			do auditRevoke(0,user,grantor,act,obj,casc,noAudit)
		}
	}
	catch {
		set SQLCODE=-400,%msg=$ze
	}
	QUIT
}
 
GrantRole(userlist,rolelist,thisuser,admin=0,&%msg,noAudit=0) [SQLCODE] PUBLIC {
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="GrantRole",^|"%SYS"|RJWTEST(n,"userlist")=$g(userlist),^|"%SYS"|RJWTEST(n,"rolelist")=$g(rolelist),^|"%SYS"|RJWTEST(n,"thisuser")=$g(thisuser),^|"%SYS"|RJWTEST(n,"admin")=$g(admin),^|"%SYS"|RJWTEST(n,"%msg")=$g(%msg),^|"%SYS"|RJWTEST(n,"fromSMP")=$g(fromSMP) ;rjwtestlog
	  #;   Function:      GrantRole^%SYS.SQLSEC
	  #;   Description:   Grant one or more Roles to one or more users
	  #;				  Called from SQL GUI Utility
	  #;   Called From:   CreateRole
	  #;				  Generated SQL code (%qaqcmn) for GRANT statement
	  #;				  %SQL.Manager.API.GrantRole() method
	  #;   Parameters:
	  #;      userlist - Comma delimited list of users/roles to grant the 
	  #;				 role(s) to (required)
	  #;      rolelist - $list of roles to grant (required)
	  #;      thisuser - User granting the role(s) (required)
	  #;      admin    - Grant Role with ADMIN option (1/0)	// DPV1898=
	  #;      %msg     - PBR - used to return error message
	  #;      noAudit  - 0/1 suppress audit logging (for %ExecDirectNoAudit)
	  #;   Returns:      SQLCODE value.  0 means success, otherwise 
	  #;				 some -### for error
	  #;-------------------------------------------------------------------
	
	s $zt="GrantRoleError"
	i $g(thisuser)="" QUIT -112
	TSTART
  	$$$AddSecurityRoleTemporary
	s SQLCODE=0
		#;  Allow the user to perform the grant if they have %Admin Secure:"U" resource, or the %All role
	if '$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName),'$$$IAmSuperUser {
			#;  If we get here, we have to make sure the user was granted the role(s) with admin option or the user created the role(s)
		for i=1:1 {
			set role=$$$LOWER($lg(rolelist,i)) quit:role=""  
	  		if role'="",$$$SecurityRolesExists(role,data) { set role=$$$GetSecurityRolesName(data) }
	  		if role="" { set SQLCODE=100 quit  }
	  		#; if not granted the role with admin option?       and      not owner of the role?
	  		if $g($$$SecurityGlobalSQLUserRole(thisuser,role))'=1,$$$SecurityRolesOwnerDirect(role)'=thisuser { set SQLCODE=-112,%msg=$$$FormatText($$$Text("User %1 does not have privilege to grant role %2","%SQL.Security"),thisuser,role) quit  }	
		}
	}
	If SQLCODE { TROLLBACK 1 QUIT SQLCODE }
	s SQLCODE=100,Status=$$$OK
	If userlist="*" {
			#;  Grant to * users means grant to all users that are not SuperUsers.
		s u="",userlist=""
		For  s u=$o($$$SecurityGlobalUsers(u),1,data) q:u=""  s:'$$$GetSecurityUsersSuperUser(data)&&(u'="_public") userlist=userlist_","_$$$GetSecurityUsersName(data)
	}
	s:$e(userlist)="," userlist=$e(userlist,2,*)
.
	For i=1:1 {
		s role=$$$LOWER($lg(rolelist,i)) q:role=""
		if role=$$$LOWER($$$SQLTuneTableRoleName) { set SQLCODE=-112,%msg=$$$FormatText($$$Text("Role %1 is a reserved system role that may not be granted","%SQL.Security"),$$$SQLTuneTableRoleName) quit }
		If '$$$SecurityRolesExists(role,data) { q  } Else { s role=$$$GetSecurityRolesName(data) }
	  	f j=1:1 {
			s user=$p(userlist,",",j) q:user=""
			s x=$$$LOWER(user)
			i x'="" {
		  		If $$$SecurityRolesExists(x,data) { s user=$$$GetSecurityRolesName(data),type="role" }
				ElseIf $$$SecurityUsersExists(x,data) { s user=$$$GetSecurityUsersName(data),type="user" }
				Else { s SQLCODE=-118,%msg=$$$FormatText($$$Text("A User named %1 does not exist","%SQL.Security"),$p(userlist,",",j)) q  }
			}
				#; If we get this far, the user has permission to grant the role.
			set sc=$$AddTheRole(type,user,role,admin)
	  		if $$$ISERR(sc) {
				set %msg=$$ProcessError(sc,.SQLCODE)
				QUIT
			} else {
				do auditGrantRole(type,user,thisuser,role,admin,noAudit)
			}
			set:SQLCODE SQLCODE=0
		}
		QUIT:SQLCODE<0
	}
  	If SQLCODE<0 {
		TROLLBACK 1
	} Else {
		TCOMMIT
	}
	QUIT SQLCODE
 
GrantRoleError
	s $zt="",SQLCODE=-400,%msg=$$$FormatText($$$Text("ERROR::  Unexpected Error in GrantRole:  %1","%SQL.Security"),$ze)
	TROLLBACK 1
	QUIT SQLCODE
}
.
AddTheRole(type,user,role,admin) PRIVATE {
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	new $namespace
	do $zu(5,"%SYS")
	if type="user" { set sc=##class(Security.Users).AddRoles(user,role,admin) } 
	else           { set sc=##class(Security.Roles).AddRoles(user,role,admin) }
	QUIT sc
}
.
RevokeRole(userlist,rolelist,thisuser,noAudit=0) [SQLCODE] PUBLIC {
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="RevokeRole",^|"%SYS"|RJWTEST(n,"userlist")=$g(userlist),^|"%SYS"|RJWTEST(n,"rolelist")=$g(rolelist),^|"%SYS"|RJWTEST(n,"thisuser")=$g(thisuser),^|"%SYS"|RJWTEST(n,"nocheck")=$g(nocheck),^|"%SYS"|RJWTEST(n,"type")=$g(type),^|"%SYS"|RJWTEST(n,"fromSMP")=$g(fromSMP) ;rjwtestlog
	  #;   Function:      RevokeRole^%SYS.SQLSEC
	  #;   Description:   Revoke one or more Roles from one or more users
	  #;				  Called from SQL GUI Utility
	  #;   Parameters:
	  #;      userlist - Comma delimited list of users to revoke the 
	  #;				 role(s) from (required)
	  #;      rolelist - $list of roles to revoke (required)
	  #;      thisuser - User revoking the role(s) (required)
	  #;      noAudit  - 0/1 suppress audit logging (for %ExecDirectNoAudit)
	  #;   Returns:      SQLCODE value.  0 means success, otherwise some 
	  #;				 -### for error
	  #;-------------------------------------------------------------------
	i $g(thisuser)="" QUIT -112
	s $zt="RevokeRoleError"
  	$$$AddSecurityRoleTemporary
	TSTART
	set SQLCODE=0
		#;  Allow the user to perform the revoke if they have %Admin Secure:"U" resource, or they have the %All role
	if '$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName),'$$$IAmSuperUser {
			#;  If we get here, we have to make sure the user was granted the role(s) with admin option or the user created the role(s)
		for i=1:1 {
			set role=$$$LOWER($lg(rolelist,i)) quit:role=""  
			if role'="",$$$SecurityRolesExists(role,data) { set role=$$$GetSecurityRolesName(data) }
			if role="" { set SQLCODE=100 quit  }
	  		#; if not granted the role with admin option?       and      not owner of the role?
			if $g($$$SecurityGlobalSQLUserRole(thisuser,role))'=1,$$$SecurityRolesOwnerDirect(role)'=thisuser { set SQLCODE=-112,%msg=$$$FormatText($$$Text("User %1 does not have privilege to revoke role %2","%SQL.Security"),thisuser,role) quit  }
		}
	}
	If SQLCODE { TROLLBACK 1 QUIT SQLCODE }
	s SQLCODE=100
.
	f i=1:1 {
		s role=$$$LOWER($lg(rolelist,i)) q:role=""
			#; Don't quit here if the role does not exist.  It could be a role was granted to a user that does not exist and now we want to revoke it.
		If '$$$SecurityRolesExists(role,data) { set role=$lg(rolelist,i) } Else { s role=$$$GetSecurityRolesName(data) }
		If userlist="*" {
				#;  Grant to * users means grant to all users that are not SuperUsers.
			set u="",userlist=""
			for  { set u=$o($$$SecurityGlobalUsers(u),1,data) quit:u=""  set:'$$$GetSecurityUsersSuperUser(data)&&(u'="_public") userlist=userlist_","_$$$GetSecurityUsersName(data) }
		}
		set:$e(userlist)="," userlist=$e(userlist,2,*)
		f j=1:1 {
			s user=$p(userlist,",",j) q:user=""
			s x=$$$LOWER(user)
			If $$$SecurityRolesExists(x,data) { s user=$$$GetSecurityRolesName(data),type="role" }
			ElseIf $$$SecurityUsersExists(x,data) { s user=$$$GetSecurityUsersName(data),type="user" }
			Else { s SQLCODE=-118,%msg=$$$FormatText($$$Text("A User or Role named %1 does not exist","%SQL.Security"),$p(userlist,",",j)) q  }
  		  		#; If we get this far, the user has permission to remove the role.
			set sc=$$RemoveTheRole(type,user,role)
			if $$$ISERR(sc) {
				set %msg=$$ProcessError(sc,.SQLCODE)
				QUIT
			} else {
				do auditRevokeRole(type,user,thisuser,role,noAudit)
			}
			set:SQLCODE=100 SQLCODE=0
		}
	}
  	#; DPV2474= d CachedQueryPrivReset("*")	// DPV2053= Reset privileges on all CQs so they are re-checked upon prepare
  	If SQLCODE<0 {
		TROLLBACK 1
	} Else {
		TCOMMIT
	}
	QUIT SQLCODE
	  
RevokeRoleError
	s $zt="",SQLCODE=-400,%msg=$$$FormatText($$$Text("ERROR::  Unexpected Error in RevokeRole:  %1","%SQL.Security"),$ze)
	TROLLBACK 1
}
.
RemoveTheRole(type,user,role) PRIVATE {
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	new $namespace
	do $zu(5,"%SYS")
	if type="user" { set sc=##class(Security.Users).RemoveRoles(user,role) } 
	else           { set sc=##class(Security.Roles).RemoveRoles(user,role) }
	QUIT sc
}
.
/// Check the list of other users that the user is attempting to grant privilege(s) to so that it only contains
/// actually existing users. If yes, return 1 else return 0. This was previously done directly in the %SYSTEM.SQL.Security.GrantPrivilege() method
/// but could lead to a <PROTECT> error. Returns the name of the bad user in the PBR param badUser
/// Called from %SYSTEM.SQL.Security methods GrantPrivilege(), GrantPrivilegeWithGrant(), RevokePrivilege()
CheckAllUsersExist(users, &badUser) [] PUBLIC {
	$$$AddSecurityRoleTemporary	// the key part to prevent <PROTECT>, %All will be popped after this procedure returns
	for i=1:1:$L(users,",") {
		set user = $P(users,",",i)
		if user = "" {
			set badUser = ""
			RETURN 0
		}
		set exists = $$$SecurityUsersExists(user,data)
		set:exists=0 exists = $$$SecurityRolesExists(user,data)
		if 'exists {
			set badUser = user
			RETURN 0
		}
	}
	RETURN 1
}
 
CheckPriv(user,%obj,%act,%dir,%grant) [] PUBLIC {
	#;   Function:      CheckPriv^%SYS.SQLSEC
	#;   Description:	Check objects privleges for a user
	#;					Called from:
	#;						%Library.SQLAPI.CheckPriv
	#;						%SQL.Manager.API.CheckPriv
	#;						%SYSTEM.SQL.CheckPriv
	#;   Parameters:
	#;      user    - Cache SQL user name (required)
	#;      %obj    - <object type>,<qualified object name>
	#;                <object type> = 1 for table, 3 for view
	#;                Examples: "1,_User.MyTable" or "3,_User.MyView" 
	#;                Required
	#;      %act    - Comma string of actions to check privileges for
	#;                'a','s','i','u','d','r','e','l' (in any order)
	#;                ALTER, SELECT, INSERT, UPDATE, DELETE, REFERENCES, EXECUTE, USE
	#;                Example "i,u,d" checks INSERT, UPDATE, and DELETE priv
	#;                Required
	#;      %dir    - Namespace object resides in (optional)
	#;                default current namespace
	#;      %grant  - 1/0 flag - check grant privilege (optional)
	#;                default is 0)
	#;                If 1, checks for grant option on privilege
	#;                If 0, checks for actual privilege
	#;   Returns:   1 if the user has the privilege, otherwise 0
	#;-------------------------------------------------------------------
	QUIT:$g(user)="" 0 QUIT:$g(%obj)="" 0 QUIT:$tr($g(%act),",","")="" 0 QUIT:user="" 0
	set:user="PUBLIC" user="_PUBLIC"
	set:$g(%dir)="" %dir=$namespace
	set sc=$$$OK
	set roles=$zstl($s($$$LOWER(user)=$$$LOWER($username):$roles,1:$$roleset(user)))
	set tOK=1
	set:+%obj=6 %obj=$$$UPPER(%obj)
  	$$$AddSecurityRoleTemporary
	for i=1:1:$l(%act,",") {
		set tAct=$p(%act,",",i)
		continue:tAct=""								// handle i,,d,,u gracefully
		if $$$noprivuser(user,%obj,tAct,%dir,%grant,roles,sc) set tOK=0		// Not Privileged
		if $$$ISERR(sc) { $$$DecErrorNum } 
		quit:'tOK
	}
	QUIT tOK  ; Has the Privilege
}
 
sysprv(grant,userlist,privs,grantopt=0,noAudit=0) [SQLCODE] PUBLIC {
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="sysprv",^|"%SYS"|RJWTEST(n,"grant")=$g(grant),^|"%SYS"|RJWTEST(n,"userlist")=$g(userlist),^|"%SYS"|RJWTEST(n,"privs")=$g(privs),^|"%SYS"|RJWTEST(n,"grantopt")=$g(grantopt),^|"%SYS"|RJWTEST(n,"$j")=$j,^|"%SYS"|RJWTEST(n,"$namespace")=$namespace ;rjwtestlog
	  #; GRANT/REVOKE <sys priv> API	// DPV1742 reworte this whole function
	  #;   Paramaters:
	  #;       grant    - 1 if GRANTing, 0 if REVOKEing (required)
	  #;       userlist - username,[username,...] list of users to grant/revoke to/from (required)
	  #;       privs    - Bit string of privileges to GRANT or REVOKE from the users.  (required).  Format is:
	  #;				  $Bit(privs,1)  = %CREATE_FUNCTION
	  #;				  $Bit(privs,2)  = %DROP_FUNCTION
	  #;				  $Bit(privs,3)  = %CREATE_METHOD
	  #;				  $Bit(privs,4)  = %DROP_METHOD
	  #;				  $Bit(privs,5)  = %CREATE_PROCEDURE
	  #;				  $Bit(privs,6)  = %DROP_PROCEDURE
	  #;				  $Bit(privs,7)  = %CREATE_QUERY
	  #;				  $Bit(privs,8)  = %DROP_QUERY
	  #;				  $Bit(privs,9)  = %CREATE_TABLE
	  #;				  $Bit(privs,10) = %ALTER_TABLE
	  #;				  $Bit(privs,11) = %DROP_TABLE
	  #;				  $Bit(privs,12) = %CREATE_VIEW
	  #;				  $Bit(privs,13) = %ALTER_VIEW
	  #;				  $Bit(privs,14) = %DROP_VIEW
	  #;				  $Bit(privs,15) = %CREATE_TRIGGER
	  #;				  $Bit(privs,16) = %DROP_TRIGGER
	  #;				  $Bit(privs,17) = %NOCHECK
	  #;				  $Bit(privs,18) = %NOTRIGGER
	  #;				  $Bit(privs,19) = %NOINDEX
	  #;				  $Bit(privs,20) = %NOLOCK
	  #;				  $Bit(privs,21) = %BUILD_INDEX
	  #;				  $Bit(privs,22) = %CREATE_ML_CONFIGURATION
	  #;				  $Bit(privs,23) = %ALTER_ML_CONFIGURATION
	  #;				  $Bit(privs,24) = %DROP_ML_CONFIGURATION
	  #;				  $Bit(privs,25) = %MANAGE_MODEL
	  #;				  $Bit(privs,26) = %USE_MODEL
	  #;				  $Bit(privs,27) = %DROP_UNOWNED
	  #;				  $Bit(privs,28) = %NOJOURN
	  #;				  $Bit(privs,29) = %CANCEL_QUERY
	  #;				  $Bit(privs,30) = %MANAGE_FOREIGN_SERVER
	  #;				  $Bit(privs,31) = %USE_EMBEDDING
	  #;				  $Bit(privs,32) = %DEFER
	  #;				   value of 1 means to perform grant/revoke, value of 0 or "" take no action
	  #;			!!! IMPORTANT !!!: if adding an admin privilege and thus modifying the above bitstring, please also
	  #;						modify the AdminPrivs macro in %msql.inc to match the name of the added privilege.
	  #;       grantopt - For GRANT only.  Value of 1 means we are GRANTing with admin option. (optional).
	  #;       noAudit  - 0/1 suppress audit logging (for %ExecDirectNoAudit)
	  #;   This function may modify SQLCODE if an error is encountered
	  #;--------------------------------------------------------------------
		#;%Admin_Secure:Use allows user to manipulate SQL privileges. Give them %All to do this.
.
 	$$$AddSecurityRoleTemporary
	set SQLCODE=0
	set user=$$$aid
	if user="" { set SQLCODE=-99 do Audit99("$Username is not defined, attempting to grant an SQL admin privilege") QUIT 0  } ; User not logged in
		#; Convert privileges from $Bit to ","-list
	for i=1:1:$$$privcnt { set:$Bit(privs,i) $p(pchk,",",i)=1 }
	if userlist="*" {
			#;  Grant to * users means grant to all users that are not SuperUsers.
		set u="",userlist=""
		for  {
			set u=$o($$$SecurityGlobalUsers(u),1,data) quit:u=""
			set:'$$$GetSecurityUsersSuperUser(data)&&(u'="_public") userlist=userlist_","_$$$GetSecurityUsersName(data)
		}
	}
.
	// If %System/%Security/Rolechange or %System/%Security/Userchange auditing is enabled, it's possible that some auditing events should happen and therefore worth to build and loop over the roleAuditList, userAuditList, and privAuditList.
	set checkAudit = 'noAudit && $$$AuditingIsOn && ($$$EventAuditIsOn("%System","%Security","RoleChange") || $$$EventAuditIsOn("%System","%Security","UserChange"))
.
	set:$e(userlist)="," userlist=$e(userlist,2,*)
	if grant {
			#; First, make sure if user has privilege to do these GRANTs
		if '$$haspriv(user,pchk,1) { set SQLCODE=-99,%msg="User '"_$Username_"' is not privileged to grant the SQL admin privilege(s): "_$$adminpriv(privs) do Audit99(%msg) RETURN 0 }
			#; Then make sure the user list is valid
		if '$$usrlstok(userlist,.users2) { set SQLCODE=-118 QUIT 0  }
			#; Then perform the GRANTs for uech user/role
		for i=1:1 {
			set gruser=$p(users2,",",i) quit:gruser=""
			$$$GetSecuritySQLSysPrivData(gruser,data,$namespace)
			for j=1:1:$$$privcnt { set:$Bit(privs,j) $li(data,j)=(1+grantopt) }
			$$$SetSecuritySQLSysPrivData(gruser,data,$namespace)
			set update=1
		}
.
		// If worth looking, loop through the combinations of users (user and roles) + privilege to check if each needs audit, if so, audit each event.
		do:checkAudit auditSysPrivPermutations(1,users2,privs,user,noAudit)
		
		if $g(update) { $$$SetSecuritySQLUpdate($namespace) }
		RETURN 1
	}
 
		#; Handle REVOKE <system privilege>
	if '$$hasrvprv(user,pchk) { set SQLCODE=-99,%msg=$Username_" is not privileged to revoke an SQL admin privilege(s): "_$$adminpriv(privs) do Audit99(%msg) RETURN 0 }
	if '$$usrlstok(userlist,.users2) { set SQLCODE=-118 QUIT 0  }
	for i=1:1 {
		set gruser=$p(users2,",",i) quit:gruser=""
		$$$GetSecuritySQLSysPrivData(gruser,data,$namespace)
		set sysprivs=""
		for j=1:1:$$$privcnt { 
			if $Bit(privs,j) {
				set $li(data,j)=0
				if j>16 { set $li(sysprivs,j-16)=1 } 
			}
		}
		if sysprivs'="" {
			set tIsRole=0
			if ($$RoleExists^%SYS.SECURITY($zcvt(gruser,"L"))) { set tIsRole=1 }
			do CachedQuerySysPrivReset(sysprivs,$s('tIsRole:gruser,1:""),$namespace,.pSc)
		}
		$$$SetSecuritySQLSysPrivData(gruser,data,$namespace)
		set update=1
	}
.
	do:checkAudit auditSysPrivPermutations(0,users2,privs,user,noAudit)
.
	if $g(update) { $$$SetSecuritySQLUpdate($namespace) }
	RETURN 1
}
 
haspriv(user,privs,admin=0) [] PUBLIC {	//DPV2391
	  #; Does user have privileges for item(s) in priv?	// DPV1742 rewrote this function
	  #;  Paramaters:
	  #;         user:  Username
	  #;         privs: "," List of privileges to check.  Each ',' position and value has meaning:
	  #;				 1 - %CREATE_FUNCTION
	  #;				 2 - %DROP_FUNCTION
	  #;				 3 - %CREATE_METHOD
	  #;				 4 - %DROP_METHOD
	  #;				 5 - %CREATE_PROCEDURE
	  #;				 6 - %DROP_PROCEDURE
	  #;				 7 - %CREATE_QUERY
	  #;				 8 - %DROP_QUERY
	  #;				 9 - %CREATE_TABLE
	  #;				 10 - %ALTER_TABLE
	  #;				 11 - %DROP_TABLE
	  #;				 12 - %CREATE_VIEW
	  #;				 13 - %ALTER_VIEW
	  #;				 14 - %DROP_VIEW
	  #;				 15 - %CREATE_TRIGGER
	  #;				 16 - %DROP_TRIGGER
	  #;				 17 - %NOCHECK
	  #;				 18 - %NOTRIGGER
	  #;				 19 - %NOINDEX
	  #;				 20 - %NOLOCK
	  #;				 21 - %BUILD_INDEX
	  #;				 22 - %CREATE_ML_CONFIGURATION
	  #;				 23 - %ALTER_ML_CONFIGURATION
	  #;				 24 - %DROP_ML_CONFIGURATION
	  #;				 25 - %MANAGE_MODEL
	  #;				 26 - %USE_MODEL
	  #;				 27 - %DROP_UNOWNED
	  #;				 28 - %NOJOURN
	  #;				 29 - %CANCEL_QUERY
	  #;				 30 - %MANAGE_FOREIGN_SERVER
	  #;				 31 - %USE_EMBEDDING
	  #;				 32 - %DEFER
	  #;                ',' piece value of 1 means check the privilege
	  #;         admin: 1 if checking WITH ADMIN OPTION, otherwise 0 or ""
 
  	$$$AddSecurityRoleTemporary
	QUIT:$g(user)="" 0 						// Unknown user
	set luser=$$$LOWER(user),superuser=0
	if luser="public" { set user="_public" }
	elseif $$$SecurityRolesExists(luser,data) { set user=$$$GetSecurityRolesName(data) }
	elseif '$$UsersSQLExists(luser,.user,.superuser) { QUIT 0 /* No such user */ }
	
	QUIT:superuser 1					// user's SuperUser property is set to 1
	QUIT:luser=$$$LOWER($username)&&($$$IAmSuperUser) 1	// looking for current user and current user has %All role
	
	$$$GetSecuritySQLSysPrivData(user,data,$namespace)
	$$$GetSecuritySQLSysPrivData("_public",dataPublic,$namespace)
 
	set (ok,okchk)="00000000000000000000000000000000"
	for i=1:1:$$$privcnt {
		if $p(privs,",",i)=1 {
			set $e(okchk,i)=1 	// Check priv in position i
					#;    Check to see if privilege was granted to user
			if $lg(data,i) { if 'admin { set $e(ok,i)=1 } else { set:$lg(data,i)=2 $e(ok,i)=1 } }
					#;    Check to see if privilege was granted to _PUBLIC
			elseif $lg(dataPublic,i) { if 'admin { set $e(ok,i)=1 } else { set:$lg(dataPublic,i)=2 $e(ok,i)=1 } }
			else {	// Check to see if privilege was granted to a role granted to user
				for user=user,"_PUBLIC" {
					set tRoleList=$s($$$LOWER(user)=$$$LOWER($username):$roles,1:$$roleset(user))
					if tRoleList'="" {
						for j=1:1 {
							quit:$p(tRoleList,",",j)=""
							$$$GetSecuritySQLSysPrivData($p(tRoleList,",",j),data,$namespace)
							if $lg(data,i) { if 'admin { set $e(ok,i)=1 quit  } else { if $lg(data,i)=2 { set $e(ok,i)=1 quit  } } }
						}
					}
				}
			}
		}
	}
		#;    If user has privilege(s), ok should equal okchk
	QUIT ok=okchk
}
 
 
	// Called from:   %SQL.Manager.API.HasRvPriv()
	//                syspriv^%SYS.SQLSEC
hasrvprv(user,privs) [] PUBLIC {
	  #; Does user have priv to REVOKE this privilege?
	  #;  Paramaters:
	  #;         user:  Username
	  #;         privs: "," List of privileges to check.  Each ',' position and value has meaning:
	  #;				 1 - %CREATE_FUNCTION
	  #;				 2 - %DROP_FUNCTION
	  #;				 3 - %CREATE_METHOD
	  #;				 4 - %DROP_METHOD
	  #;				 5 - %CREATE_PROCEDURE
	  #;				 6 - %DROP_PROCEDURE
	  #;				 7 - %CREATE_QUERY
	  #;				 8 - %DROP_QUERY
	  #;				 9 - %CREATE_TABLE
	  #;				 10 - %ALTER_TABLE
	  #;				 11 - %DROP_TABLE
	  #;				 12 - %CREATE_VIEW
	  #;				 13 - %ALTER_VIEW
	  #;				 14 - %DROP_VIEW
	  #;				 15 - %CREATE_TRIGGER
	  #;				 16 - %DROP_TRIGGER
	  #;				 17 - %NOCHECK
	  #;				 18 - %NOTRIGGER
	  #;				 19 - %NOINDEX
	  #;				 20 - %NOLOCK
	  #;				 21 - %BUILD_INDEX
	  #;				 22 - %CREATE_ML_CONFIGURATION
	  #;				 23 - %ALTER_ML_CONFIGURATION
	  #;				 24 - %DROP_ML_CONFIGURATION
	  #;				 25 - %MANAGE_MODEL
	  #;				 26 - %USE_MODEL
	  #;				 27 - %DROP_UNOWNED
	  #;				 28 - %NOJOURN
	  #;				 29 - %CANCEL_QUERY
	  #;				 30 - %MANAGE_FOREIGN_SERVER
	  #;				 31 - %USE_EMBEDDING
	  #;				 32 - %DEFER
	  #;
	  #; To revoke a system privilege, the user must have been granted the
	  #; privilege or role with admin option.
	  #; -------------------------------------------------------------------
 
  	$$$AddSecurityRoleTemporary
	QUIT:$g(user)="" 0 						// Unknown user
	set luser=$$$LOWER(user)
	if luser="public" { set user="_public" }
	elseif $$$SecurityRolesExists(luser,data) { set user=$$$GetSecurityRolesName(data) }
	elseif '$$UsersSQLExists(luser,.user,.superuser) { QUIT 0 /* No such user */ }
 
	QUIT:superuser 1					// user's SuperUser property is set to 1
	QUIT:luser=$$$LOWER($username)&&($$$IAmSuperUser) 1	// looking for current user and current user has %All role
 
	$$$GetSecuritySQLSysPrivData(user,data,$namespace)
	$$$GetSecuritySQLSysPrivData("_public",dataPublic,$namespace)
 
	set (ok,okchk)="00000000000000000000000000000000"
	for i=1:1:$$$privcnt {
		if $p(privs,",",i)=1 {
			set $e(okchk,i)=1 	// Check priv in position i
				  #;    Check to see if privilege was granted to user with admin option
			if $lg(data,i)=2 { set $e(ok,i)=1 }
					#;    Check to see if privilege was granted to _PUBLIC with admin option
			elseif $lg(dataPublic,i)=2 { set $e(ok,i)=1 }
			else {	// Check to see if privilege was granted to a role granted to user
				for user=user,"_PUBLIC" {
					set tRoleList=$s($$$LOWER(user)=$$$LOWER($username):$roles,1:$$roleset(user))
					if tRoleList'="" {
						for j=1:1 {
							quit:$p(tRoleList,",",j)=""
							$$$GetSecuritySQLSysPrivData($p(tRoleList,",",j),data,$namespace)
							if $lg(data,i)=2 { set $e(ok,i)=1 quit  }
						}
					}
					quit:$e(ok,i)=1  // Already know the user was granted the user with the admin option
				}
			}
		}
	}
 
	QUIT ok=okchk  	// If user has privilege to revoke everything requested, ok should equal okchk
}
 
	// Given a bitstring of SQL Admin Privleges, return a string of SQL Admin Privilege names
adminpriv(pchk) [] PRIVATE {
	set str="", privs=$$$AdminPrivsLB
	for i=1:1:$$$privcnt { set:$Bit(pchk,i) str=str_$e(",",str'="")_$lg(privs,i) }
	RETURN str	
}
 
usrlstok(users,users2) [] PRIVATE {
		#; Is the user list a valid list of users/roles?
		#;  Also builds actual user name list in users2
		#;  users2 is passed by reference
	s ok=1,users2=""
	f i=1:1 s user=$p(users,",",i) q:user=""  d  q:'ok
	. s x=$$$LOWER(user) i x="" s ok=0 q
	. i x="public"||(x="_public") s users2=users2_"_PUBLIC," q
	. i $$$SecurityRolesExists(x,data) s user=$$$GetSecurityRolesName(data)
	. e  i $$UsersSQLExists(x,.user)
	. e  s user=""
	. i user="" s ok=0 q
	. s users2=users2_user_","
	QUIT ok
}
 
CQPrivileges(privacts,rellist) [] PUBLIC {
	  #;   Function:      CQPrivileges^%SYS.SQLSEC
	  #;   Description:   Build a list of users who have access to a Cached Query
	  #;   Parameters:
	  #;      privacts - Comma list if privilges to check on (a, i, u, etc)
	  #;      rellist  - $lb list of relations to check privileges on
	  #;				 Each element is a $c(1) delimited list:
	  #;				    1.  1 or Table, 3 for View
	  #;				    2   Relation name
	  #;   Returns:      $lb list of users with the privileges on the objects
	  #;-------------------------------------------------------------------
 
#DEFINE CQnopriv(%obj,%act,%u) '$d($$$SecurityGlobalSQLPriv($namespace,0,%obj,%act,%u)),'$d(^("_PUBLIC")),$$RoleCheckList(UserRoles),$$OwnerCheckUser(%u,UserRoles,%obj,%act)
 
  	$$$AddSecurityRoleTemporary
	QUIT:rellist="" "" QUIT:privacts="" ""
	QUIT:$$$SQLSecurityOff ""
		#;  Start with a list of all defined users
	s users="",ulist="" 
	For  s users=$o($$$SecurityGlobalUsers(users),1,data) q:users=""  s:$$$GetSecurityUsersSuperUser(data)&&(users'="_public") ulist=ulist_$lb($$$GetSecurityUsersName(data))
		#;  Now for each relation we'll check each user in the list to see if they are privileged for the privacts on the 
		#;  relation.  If not, I remove them from the ulist.
		#;  At the end, the users left in the ulist have privileges to run this Cached Query.
	For k=1:1:$ll(ulist) {	// For each user defined
		s r=""
			#;  Set up UserRoles for this user
		s role="",UserRoles="" For  s role=$o($$$SecurityGlobalSQLUserRole($li(ulist,k),role)) q:role=""  d CQgrpset(role)
		k:UserRoles="" UserRoles	// No roles granted to this user
		For i=1:1:$ll(rellist) {	// For each relation to check
			s r=$tr($li(rellist,i),$c(1),",")
			For j=1:1:$l(privacts,",") {	// For each privilege to check
				If $p(privacts,",",j)'="",$$$CQnopriv(r,$p(privacts,",",j),$li(ulist,k)) s $li(ulist,k)="" q
			}
			q:$li(ulist,k)=""	// Next user
		}
	}
		#;  Now we should have a list of users with privileges (privacts) to the tables/views in rellist.
		#;  Compress the list
	s ulist2="" f i=1:1:$ll(ulist) s:$li(ulist,i)'="" ulist2=ulist2_$lb($li(ulist,i))
	QUIT ulist2
 
CQgrpset(role)
		#;  Given a role, set this role into UserRoles list (if not already there) and then check any roles granted this this role
	QUIT:$lf(UserRoles,role)
	Set UserRoles=UserRoles_$lb(role)
	s gr="" For  s gr=$o($$$SecurityGlobalSQLUserRole(role,gr)) q:gr=""  d CQgrpset(gr)
	s gr="" For  s gr=$o($$$SecurityGlobalSQLUserRole("_PUBLIC",gr)) q:gr=""  d CQgrpset(gr)	// Also roles granted to _PUBLIC
	QUIT
}
 
CachedQueryPrivReset(obj,sc,pUsername="",pNamespace) [SQLCODE] PUBLIC {
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="CachedQueryPrivReset",^|"%SYS"|RJWTEST(n,"obj")=$g(obj),^|"%SYS"|RJWTEST(n,"sc")=$g(sc) ;rjwtestlog
		#;   Function:      CachedQueryPrivReset^%SYS.SQLSEC
		#;   Description:   Kill the list of users with privileges to use 
		#;				  a cached query for each cached query used by this
		#;				  table or view (in obj).
		#;				  If obj="*", we are dropping a role and need to reset
		#;				  privs on cached queryes in all namespaces.
		#;   Parameters:
		#;      obj       - <type>,<qualified relation name> <type> ::= 1 or 3, or "*" for all objects
		#;      sc        - PBR. Return status code to determine success/failure
		#;      pUsername - If defined, reset privileges on cached queries for only this username
		#;	    ns        - Namespace revoke is being done in, only used is obj'="*"
		#;-------------------------------------------------------------------
 
 	set $zt="Error"
	set sc=$$$OK
	RETURN:+obj=4	// Nothing to do
	RETURN:+obj=6	// Nothing to do for ML Configuration privileges
	RETURN:+obj=7	// Nothing to do for foreign server privileges?
	set tflag=0,ns=""
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	$$$SuspendAllTrans(tflag)
	if pUsername'="" set tHashUser=$$$Hash(pUsername)
	set cqdb=$$GetCacheDatabase^%SYS.SQLSRV()
		#; If we have revoked a schema privilege, just reset privs on all cached queries.
		#; It is too much work to go through each one and figure out the schemas used by the statement.
	If obj'="*",+obj'=5 {	// Reset privs for a single extent
		set ns=$g(pNamespace,$namespace)
		if '$d($$$CQ("Query")) $$$ResumeAllTrans(tflag) QUIT  // Nothing to do
		if +obj=9 {	// EXECUTE privilege on a procedure
			s obj=$p(obj,",",2),schema=$$$AllButLastPiece(obj,"."),proc=$tr($$$LastPiece(obj,"."),$c(2),".")
			set extent=$g(^|ns|oddPROC($zu(28,schema,5),$zu(28,proc,5),1))	// Should probably define a macro for this???
		}
		elseif +obj<4 {	// Priv on table or view
			s obj=$p(obj,",",2),extent=$$$GetExtentNameFromIQNNS(ns,obj)
		}
		if extent="" $$$ResumeAllTrans(tflag) QUIT  // Dropping corrupt/missing table definition???
		set extentdb=$$$ExtentDBNS(ns,extent)
		set rtn="" 
		for  {
			set rtn=$o($$$CQrootExtended(cqdb)(ns,2,extentdb,extent,rtn)) quit:rtn=""
			set cqdata=$get($$$CQrootExtended(cqdb)(ns,"QueryRoutine",rtn))
			if cqdata="" CONTINUE
			set cqver=$listget(cqdata,1),cqhash=$listget(cqdata,2),cqlock=$listget(cqdata,8,cqhash)
			if cqlock="" set cqlock=cqhash
			if cqhash'="" {
				lock +$$$CQrootExtended(cqdb)(ns,"Query",cqver,cqlock):$$$CQGetLockTO set lock=$test
				if 'lock {
					set SQLCODE=-114,%msg=$$$FormatText($$$Text("Unable to get lock on Cached Query '%1' in namespace '%2'","%SQL.Security"),cqver_":"_cqlock,ns)
				}
				try {
					if $d(tHashUser) { kill $$$CQrootExtended(cqdb)(ns,"Query",cqver,cqhash,rtn,$zu(110),"pu",tHashUser) }
					else             { kill $$$CQrootExtended(cqdb)(ns,"Query",cqver,cqhash,rtn,$zu(110),"pu") }
					set update(ns)=1
				} catch {
					lock:lock -$$$CQrootExtended(cqdb)(ns,"Query",cqver,cqlock)#"I"
					throw
				}
				lock:lock -$$$CQrootExtended(cqdb)(ns,"Query",cqver,cqlock)#"I"
			}
		}
		$$$ResumeAllTrans(tflag)
#if $$$USENSFORSQLUPDATE
		set update="" f  s update=$o(update(update)) q:update=""  $$$SetSecuritySQLUpdate(update)
#else
		if $d(update) $$$SetSecuritySQLUpdate("xyz")
#endif
		#; DPV2749 $$$EnableJournal
		QUIT
	}
.
	s ns=""									// DPV3275-
Loop	;
	s $zt="Error2"
	For  {
		s ns=$o($$$CQrootExtended(cqdb)(ns)) q:ns=""
		set rtn=""
		For  {	// Reset privs for all CQ's 
			s rtn=$o($$$CQrootExtended(cqdb)(ns,"QueryRoutine",rtn),1,cqdata) q:rtn=""
			if cqdata="" CONTINUE
			set cqver=$listget(cqdata,1),cqhash=$listget(cqdata,2),cqlock=$listget(cqdata,8,cqhash)
			if cqlock="" set cqlock=cqhash
			if cqhash'="" {
				lock +$$$CQrootExtended(cqdb)(ns,"Query",cqver,cqlock):$$$CQGetLockTO set lock=$test
				if 'lock {
					set SQLCODE=-114,%msg=$$$FormatText($$$Text("Unable to get lock on Cached Query '%1' in namespace '%2'","%SQL.Security"),cqver_":"_cqlock,ns)
				}
				try {
					if $d(tHashUser) { kill $$$CQrootExtended(cqdb)(ns,"Query",cqver,cqhash,rtn,$zu(110),"pu",tHashUser) }
					else             { kill $$$CQrootExtended(cqdb)(ns,"Query",cqver,cqhash,rtn,$zu(110),"pu") }
				} catch {
					lock:lock -$$$CQrootExtended(cqdb)(ns,"Query",cqver,cqlock)#"I"
					throw
				}
				lock:lock -$$$CQrootExtended(cqdb)(ns,"Query",cqver,cqlock)#"I"
			}
		}
	}
	$$$ResumeAllTrans(tflag)
#if $$$USENSFORSQLUPDATE
	s update="" f  s update=$o(update(update)) q:update=""  $$$SetSecuritySQLUpdate(update)
#else
	i $d(update) $$$SetSecuritySQLUpdate("xyz")
#endif
	QUIT
.
Error
	set $zt="",ze=$ze
	$$$ResumeAllTrans(tflag)
	set SQLCODE=-400,%msg=$$$FormatText($$$Text("Error resetting Cached Query SQL Privilege information in namespace '%1':  %2","%SQL.Security"),$g(ns),ze)
	QUIT $$$ERROR($$$ObjectScriptError,ze)
.
Error2
	s $zt="",ze=$ze
		#;  DPV2561 - If the error is one of the following and we are in the namespace loop, just go on to the next namespace.
	If ns'="" { If ze["<FUNCTION>"||(ze["<DIRECTORY>")||(ze["<NAMESPACE>")||(ze["<NOTOPEN>")||(ze["<PROTECT>") { GOTO Loop }	}
	$$$ResumeAllTrans(tflag)
	s SQLCODE=-400,%msg=$$$FormatText($$$Text("Error resetting Cached Query SQL Privilege information in namespace '%1':  %2","%SQL.Security"),$g(ns),ze)
	QUIT $$$ERROR($$$ObjectScriptError,ze)
}
 
 
CachedQuerySysPrivReset(pSysPriv,pUsername="",pNamespace,pSc) [SQLCODE] PUBLIC {
		#;   Function:      CachedQuerySysPrivReset^%SYS.SQLSEC
		#;   Description:   Kill the list of users with privileges to use 
		#;				  a cached query for each cached query that use this system privilege
		#;   Parameters:
		#;      pSysPriv   - $list(#,#,#,#,#,,,,#) string where pos 1 is %NOCHECK, 2 is %NOTRIGGER, 3 is %NOINDEX, 4 is %NOLOCK, 5 is %NOJOURN, 9 is %USE_MODEL, 32 iis %DEFER
		#;      pUsername  - If defined, reset privileges on cached queries for only this username, otherwise all users
		#;	    pNamespace - Namespace revoke is being done in, only used is obj'="*"
		#;      pSc        - PBR. Return status code to determine success/failure
		#;   Returns nothing, called with DO
		#;-------------------------------------------------------------------
 
 	try {
		set pSc=$$$OK
		RETURN:pSysPriv=""	// Nothing to do
		$$$AddAllRoleTemporaryInTry ; verified 9/26/16 STC
		$$$SuspendAllTrans(tflag)
		set:pUsername'="" tHashUser=$$$Hash(pUsername)
		set cqdb=$$GetCacheDatabase^%SYS.SQLSRV()
.
		set rtn=""
		for  { 
			set rtn=$o($$$CQrootExtended(cqdb)(pNamespace,"QueryRoutine",rtn),1,cqdata) quit:rtn=""
			if cqdata="" CONTINUE
			set cqver=$listget(cqdata,1),cqhash=$listget(cqdata,2),cqlock=$listget(cqdata,8,cqhash)
			if cqlock="" set cqlock=cqhash
			if cqhash'="" {
				set lock=0
				lock +$$$CQrootExtended(cqdb)(pNamespace,"Query",cqver,cqlock):$$$CQGetLockTO set lock=$test
				if 'lock {
					set SQLCODE=-114,%msg=$$$FormatText($$$Text("Unable to get lock on Cached Query '%1' in namespace '%2'","%SQL.Security"),cqver_":"_cqlock,pNamespace)
				}
				try {
					if $d($$$CQrootExtended(cqdb)(pNamespace,"Query",cqver,cqhash,rtn,"syspriv"),tData) {
						//  CQ uses %NOCHECK and we revoked %NOCHECK or CQ uses %NOTRIGGER and we revoked %NOTRIGGER or
						//  CQ uses %NOINDEX and we revoked %NOINDEX or CQ uses %NOLOCK and we revoked %NOLOCK or CQ uses %NOJOURN and we revoked %NOJOURN or 
						//  CQ uses %USE_MODEL and we revoked %USE_MODEL, remove the users from the CQ
						//	CQ uses %DEFER and we revoke %DEFER, remove users from the CQ
						if '( ($lg(pSysPriv,1)&&$lg(tData,1)) 
						   || ($lg(pSysPriv,2)&&$lg(tData,2)) 
						   || ($lg(pSysPriv,3)&&$lg(tData,3)) 
						   || ($lg(pSysPriv,4)&&$lg(tData,4)) 
						   || ($lg(pSysPriv,5)&&$lg(tData,5)) 
						   || ($lg(pSysPriv,9)&&$lg(tData,9)) 
						   || ($lg(pSysPriv,9)&&$lg(tData,32)) ) { 
								lock:lock -$$$CQrootExtended(cqdb)(pNamespace,"Query",cqver,cqlock)#"I" continue
						}
						if $d(tHashUser) { kill $$$CQrootExtended(cqdb)(pNamespace,"Query",cqver,cqhash,rtn,$zu(110),"pu",tHashUser) }
						else             { kill $$$CQrootExtended(cqdb)(pNamespace,"Query",cqver,cqhash,rtn,$zu(110),"pu") }
					}
				} catch {
					lock:lock -$$$CQrootExtended(cqdb)(pNamespace,"Query",cqver,cqlock)#"I"
					throw
				}
				lock:lock -$$$CQrootExtended(cqdb)(pNamespace,"Query",cqver,cqlock)#"I"
			}
		}
		$$$ResumeAllTrans(tflag)
#if $$$USENSFORSQLUPDATE
		set update="" for  { set update=$o(update(update)) quit:update=""  $$$SetSecuritySQLUpdate(update) }
#else
		if $d(update) { $$$SetSecuritySQLUpdate("xyz") }
#endif
 	}
 	catch {
		set ze=$ze
		$$$ResumeAllTrans(tflag)
		set SQLCODE=-400,%msg=$$$FormatText($$$Text("Error resetting Cached Query SQL Privilege information in namespace '%1':  %2","%SQL.Security"),pNamespace,ze)
 	}
	QUIT
}
.
	// Called from:
	// - Security.Users.CheckBindingsAccess method
	// - ListImplied^%SYS.NAMESPACE
	// - List^%SYS.NAMESPACE
AnyPriv(ns="") [] PUBLIC {
		#;  Does user <user> have any SQL privileges (system or object) in this namespace?
		#;  Also check if the user is the owner of any SQL object, or the owner is _PUBLIC or a role the user holds
		#;  Return 1 if yes, 0 if no
  	$$$AddSecurityRoleTemporary
	set:ns="" ns=$namespace
	set user=$username
	 	// See if the user has at least one privilege granted to them other than the privilege on %TSQL_sys.snf
	set data="",ok=0
	for  {
		set data=$o($$$SecurityGlobalSQLPriv(ns,"m",user,data)) quit:data=""
		continue:data["1,%TSQL_sys.snf||"
		set ok=1 quit
	}
	RETURN:ok 1  // User was granted a privilege
	set value=""
	for  {
		set value=$o($$$SecurityGlobalSQLPriv(ns,"m","_PUBLIC",value)) quit:value=""
		if $e(value,3,9)'="%sqlcq_" { RETURN 1 }   	// _PUBLIC has at least one privilege on something other than an %sqlcq_<NAMESPACE>.LTT table / extent query
	}
	$$$GetSecuritySQLSysPrivData(user,UserSysPrivs,ns)
	set ok=0,p=0
	while $listnext(UserSysPrivs,p,val) { if $g(val) { set ok=1 quit  }} RETURN:ok 1   // user has at least one SQL System Privilege
	$$$GetSecuritySQLSysPrivData("_public",UserSysPrivs,ns)
	set ok=0,p=0
	while $listnext(UserSysPrivs,p,val) { if $g(val) { set ok=1 quit  }} RETURN:ok 1  // _PUBLIC has at least one SQL System Privilege
		
	set ok=0
	if $Roles'="" {
		for i=1:1:$l($Roles,",") {
				#; unfortunately, the role name in $Roles may not be the exact case of the role name defined in the Role and Privilege databases,
				#; so we have to get the exact rolename here (pl #127122).
			set role=$p($roles,",",i) kill exactrole
			set roledata=$g($$$SecurityGlobalRoles(role))
			set:roledata'="" exactrole=$lg(roledata,4)
			if $d($$$SecurityGlobalSQLPriv(ns,"m",$g(exactrole,role))) { set ok=1 quit  } 	// User's role has at least one privilege
			$$$GetSecuritySQLSysPrivData($g(exactrole,role),RoleSysPrivs,ns)
			set p=0
			while $listnext(RoleSysPrivs,p,val) { if $g(val) { set ok=1 quit  }} quit:ok  	// User's role has at least one SQL System Privilege
	  	}
	}
	RETURN:ok 1
		#; If we get here, there are no explicitly granted privileges for this user in this namespace.
		#; We need to see if this user, any of the user's roles, or _PUBLIC, are the owners of any SQL objects in this namespace.
	set userlist=","_$$$LOWER(user)_","_$$$LOWER($roles)_",_public,"
	set schema=""
	for  {
		set schema=$$GetNextSubscript("^rINDEXSQL(""rv"")",schema) quit:schema=""
		continue:$case(schema,"INFORMATION_SCHEMA":1,"%SYSTEM_SQL":1,"%STUDIO":1,"%UNITTEST_RESULT":1,:0)	// Must have ownership on something other than INFORMATION_SCHEMA or %SYSTEM_SQL schemas
		continue:$e(schema,1,7)="%SQLCQ_"		// Must have ownership on something other than %sqlcq_<NAMESPACE> LTT tables
		continue:$e(schema,1,8)="%DEEPSEE"		// Must have ownership on something other than %DEEPSEE.* tables/views
		continue:$e(schema,1,10)="%WEBSTRESS"	// Must have ownership on something other than %WEBSTRESS.* tables/views
		set relation=""
		for  {
			set relation=$o(^rINDEXSQL("rv",schema,relation),1,rvdata) quit:relation=""
			set owner=$$$LOWER($lg(rvdata,6))
			if owner'="",userlist[(","_owner_",") { RETURN 1 }   // we found an SQL objects owned by the user, a role the user has, or _PUBLIC
		}
	}
		#; Now check ownership for any procedures
	set schema=""
	for  {
		set schema=$$GetNextSubscript("^oddPROC",schema) quit:schema=""
		continue:$case(schema,"INFORMATION_SCHEMA":1,"%LIBRARY":1,"%TSQL":1,"%SQL_UTIL":1,"%CSP":1,"%UNITTEST_RESULT":1,:0)	// Must have ownership on something other than in schemas listed here
		continue:$e(schema,1,7)="%SYSTEM"		// Must have ownership on something other than %SYSTEM* stored procedures
		continue:$e(schema,1,7)="%SQLCQ_"		// Must have ownership on something other than %sqlcq_<NAMESPACE> LTT tables
		continue:$e(schema,1,8)="%DEEPSEE"		// Must have ownership on something other than %DEEPSEE.* stored procedures
		continue:$e(schema,1,10)="%WEBSTRESS"	// Must have ownership on something other than %WEBSTRESS.* tables/views
		continue:$e(schema,1,8)="%ATELIER"		// Must have ownership on something other than %ATELIER.* tables/views
		continue:$e(schema,1,7)="%STUDIO"		// Must have ownership on something other than %ATELIER.* tables/views
		set proc=""
		for  {
			set proc=$o($$$PROC($$$pPROC,schema,proc)) quit:proc=""
			continue:($g($$$PROChidden($$$pPROC,schema,proc)))
			continue:(schema="%REPORT" && (proc="AUTHEXTERNALUSER_VALIDATETOKEN"))
			set class=$g($$$PROCclass($$$pPROC,schema,proc))
			continue:class=""
			set owner=$$$LOWER($$$comClassKeyGet(class,$$$cCLASSowner))
			continue:owner=""
			if userlist[(","_owner_",") { RETURN 1 }   // we found an SQL procedure owned by the user, a role the user has, or _PUBLIC
		}
	}
	RETURN 0
}
 
DeleteSQLPrivs(ns) [] PUBLIC {	// DPV2280=
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="DeleteSQLPrivs",^|"%SYS"|RJWTEST(n,"ns")=$g(ns) ;rjwtestlog
		#;  Given a namespace, delete all the SQL Privileges defined in the namespace
	Kill $$$SecurityGlobalSQLPriv($$$UPPER(ns))
	Kill $$$SecurityGlobalSQLSysPriv($$$UPPER(ns))
	$$$SetSecuritySQLUpdate($$$UPPER(ns))
	QUIT
}
	 
 
ValidUser(username) [] PUBLIC {
	  #; ------------------------------------------------------------------
	  #; Function to determine if the username is an actual user
	  #; Input Parameters -
	  #;   username - user to check
	  #; 
	  #; Notes:
	  #;  This is not a password check/login facility.  We assume that
	  #;  has already occurred.
	  #;
	  #; RETURNS:
	  #;  1 - Valid User
	  #;  0 - Unknown User
	  #; ------------------------------------------------------------------
 
	s $zt="ValidUserError"
	QUIT:$g(username)="" 0
	QUIT $$UsersSQLExists(username)
 
ValidUserError s $zt="" QUIT 0
 
}
 
 
AddUser(username,password,FullUsername="",SQLCODE,%msg) [] PUBLIC {
	  #; ------------------------------------------------------------------
	  #; Function to add a user.
	  #; Input Parameters -
	  #;   username - user to add
	  #;   password - password for user to log in with
	  #;   FullUsername     - User description
	  #;   SQLCODE  - PBR
	  #;   %msg     - PBR
	  #; 
	  #; Notes:
	  #;  New users are created with no system privileges.  All privileges
	  #;  have to be granted to the new user.
	  #;  Any errors will be reported in SQLCODE
	  #;
	  #; RETURNS:
	  #;  1 - success
	  #;  0 - failure
	  #;
	  #;   User definition:
	  #;   Master Map (See Security.Users)
	  #;      ^SECURITY("UsersD",username) = $List pieces
	  #; ------------------------------------------------------------------
 
 	set SQLCODE=-400	// Assume failure
	if $$UsersSQLExists(username) {
		set SQLCODE=-118,%msg=$$$FormatText($$$Text("A User named '%1' already exists","%SQL.Security"),username)
		QUIT 0  // User Already exists
	}
	#;  User needs %Admin_Secure:USE or %Admin_UserEdit:USE to Create User definitions
	If ('$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) && '$SYSTEM.Security.Check($$$AdminUserEditResourceName,$$$PermUseName)) {
		s SQLCODE=-99,%msg=$$$Text("%Admin_Secure:USE privilege or %Admin_UserEdit:USE privilege is required to create a user","%SQL.Security")
		do Audit99(%msg)
		QUIT 0
	}
	
	if $e(password,1,12)="%%ENCRYPTED(" {
		set password=$p($p(password,"(",2),")"),password=$$PasswordFromXSD(password)	//BJB395
	}
 
	set:FullUsername="" FullUsername=username
 
	#;	$SYSTEM.Security.Roles( ClassMethod Create(
	#;		Name As %String,		// Name of the role to create
	#;		Description As %String,		// Description of the role
	#;		Resources As %List) As %Status	// List format of resource/permission pairs to assign to the role
	#;						// Resources are in the format:<br>
	#;						// $lb(ResourceName,Permission)_$lb(ResourceName,Permission)<br>
	#;						// For example:<br>
	#;						// s Resources=$lb("MyResource","RW")_$lb("MyResource1","Read,Write,Use")<br>
 
	#;	$SYSTEM.Security.Users.Create(
	#;		Username As %String,
	#;		Roles As %List,
	#;		Password As %String,
	#;		FullName As %String,
	#;		NameSpace As %String,
	#;		Routine As %String) As %Status
	
 
	set Status=$$UsersCreate(username,,password,FullUsername,$namespace)
	if $$$ISERR(Status) { set %msg=$$ProcessError^%apiDDL(Status,.SQLCODE) QUIT 0 }
	s SQLCODE=0	// A-OK
	QUIT 1
}
 
 
AltUser(username,password,FullUsername,&SQLCODE,&%msg) [] PUBLIC {
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="AltUser",^|"%SYS"|RJWTEST(n,"username")=$g(username),^|"%SYS"|RJWTEST(n,"password")=$g(password),^|"%SYS"|RJWTEST(n,"FullUsername")=$g(FullUsername),^|"%SYS"|RJWTEST(n,"SQLCODE")=$g(SQLCODE),^|"%SYS"|RJWTEST(n,"%msg")=$g(%msg) ;rjwtestlog
	  #; ------------------------------------------------------------------
	  #; Function to alter a user's password
	  #; Input Parameters -
	  #;   username - user to alter
	  #;   password - new password for user to log in with
	  #;   FullUsername     - new FullUsername for user.  If FullUsername not defined, keep old FullUsername
	  #;              Description changed by GUI utility (DPV1117)
	  #;   SQLCODE  - PBR
	  #;   %msg     - PBR, errr message (passed by reference)
	  #; 
	  #; Notes:
	  #;  Any errors will be reported in SQLCODE
	  #;
	  #; RETURNS:
	  #;  1 - success
	  #;  0 - failure
	  #; ------------------------------------------------------------------
	
	  
	#;	ClassMethod Get(
	#;		Username As %String,
	#;		ByRef Properties As %String) As %Status
	#;      Properties returns:
	#;		Properties - Array of properties<
	#;		Properties("AuthenticationDomain") - Authentication domain
	#;		Properties("Enabled") - 0=Disabled, 1=Enabled
	#;		Properties("EventFlags") - List of valid EventFlags
	#;		EventFlags are in the format:
	#;			$lb(EventFlag1,EventFlag2)
	#;			For example:
	#;			s Properties("EventFlags")=$lb("%SYSTEM/%LOGIN/LOGIN","%SYSTEM/%LOGIN/LOGOUT")
	#;		Properties("ExpirationDate") - Expiration date of account 0=no expiration
	#;		Properties("FullName") - Full name of the user
	#;		Properties("InvalidLoginAttempts") - Number of invalid login attempts since last success
	#;		Properties("InvalidLoginDateTime") - $h value of last invalid login attemp
	#;		Properties("InvalidLoginDevice") - Last device for invalid login attempt
	#;		Properties("InvalidLoginStatus") - Last error status for an invalid login attempt
	#;		Properties("InvalidLoginService") - Last service used for an invalid login attempt
	#;		Properties("LegacyPassword") - Legacy password for Cache Direct
	#;		Properties("LoginDateTime") - $h value for last valid login attempt
	#;		Properties("LoginDevice") - Last valid login device
	#;		Properties("LoginService") - Last valid login service
	#;		Properties("NameSpace") - Default Namespace for terminal login
	#;		Properties("Password") - Cache Authentication password
	#;		Properties("Roles")- List format of roles
	#;			Roles are in the format:
	#;			,role1,role2,role3
	  
 	set SQLCODE=-400	// Assume failure
	set Status=$$UsersGet(username,.uResources) 
	if '$$$ISOK(Status) {
		s %msg=$$ProcessError^%apiDDL(Status,.SQLCODE) QUIT 0
		s SQLCODE=-118,%msg=$$$FormatText($$$Text("A User named '%1' does not exist","%SQL.Security"),username)
		QUIT 0  // No such user
	}
 
	#;	ClassMethod Modify(
	#;		Username As %String,
	#;		ByRef Properties As %String) As %Status
	  
		#;  Don't use $$$UsersModify to change Password.  This no longer works.
		
	kill uResources
	if $d(password) {
			#; 1) If the user to change is the same as the requester ($username), allow it to be changed.
			#; 2) If the user is not the same, then allow them to change if they own the %Admin_Secure:USE or %Admin_UserEdit:USE permission.
		if $$$LOWER(username)'=$$$LOWER($Username),'$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) {	// not this user and user does not have %Admin_Secure:"U"
			if $SYSTEM.Security.Check($$$AdminUserEditResourceName,$$$PermUseName) {	// User has %Admin_UserEdit:"U"
					#; Make sure the user with $$$AdminUserEditResourceName created this user - This disallows editing of any user's password, only allow the users we created
				if '$$CreatedUser($username,username) {
					set SQLCODE=-99,%msg=$$$FormatText($$$Text("User %1 does not have privileges required to change the password of user %2","%SQL.Security"),$Username,username) do Audit99(%msg)
					RETURN 0
				}
			} else {	// User does not have %Admin_UserEdit:"U"
				set SQLCODE=-99,%msg=$$$FormatText($$$Text("User %1 does not have privileges required to change the password of user %2","%SQL.Security"),$Username,username) do Audit99(%msg)
				RETURN 0
			}
		}
			// It is this user, or the user has %Admin_Securit, or the user has %Admin_EditUser and is changing the password of a user they created
		set Status=$SYSTEM.Security.ChangePassword(username,password)
	}
	if $$$ISERR(Status) { set %msg=$$ProcessError^%apiDDL(Status,.SQLCODE) RETURN 0 }
	if $d(FullUsername) {
		set uResources("FullName")=FullUsername
		set Status=$$UsersModify(username,.uResources)
		if $$$ISERR(Status) { set %msg=$$ProcessError^%apiDDL(Status,.SQLCODE) RETURN 0 }
	}
	set SQLCODE=0	// A-OK
	RETURN 1
}
 
 
DropUser(username,cascade,SQLCODE,%msg,ifexists=0) [] PUBLIC {
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="DropUser",^|"%SYS"|RJWTEST(n,"username")=$g(username),^|"%SYS"|RJWTEST(n,"cascade")=$g(cascade),^|"%SYS"|RJWTEST(n,"SQLCODE")=$g(SQLCODE),^|"%SYS"|RJWTEST(n,"%msg")=$g(%msg) ;rjwtestlog
	  #; ------------------------------------------------------------------
	  #; Function to delete a user
	  #; Input Parameters -
	  #;   username - user to delete
	  #;   cascade  - Delete all user's objects (1/0)
	  #;   SQLCODE  - Passed by reference.  Returns SQLCODE error/success code
	  #;   %msg     - Passed by reference.  Returns contents of error message (if error)
	  #;   ifexists - 1/0 Flag. Default value is 0. If TRUE, suppress SQLCODE -118 as a warning
	  #;
	  #; NOTES:
	  #;  For now cascade means nothing.  We really can't do anything
	  #;  until there are users and privileges at the Object level.
	  #;  We could find all the users tables and delete all the classes
	  #;  the tables bind to, but do we want to do this???
	  #;  Any errors will be reported in SQLCODE
	  #;
	  #; RETURNS:
	  #;  1 - success
	  #;  0 - failure
	  #; ------------------------------------------------------------------
 
	set SQLCODE=0,%msg=""
 	if '$$UsersSQLExists(username) {
		if ifexists {
			set SQLCODE = 0, %msg = ""
		} else {
			set SQLCODE = -118, %msg = $$$FormatText($$$Text("A User named '%1' does not exist","%SQL.Security"),username)
		}
		RETURN 0  // No such user
	}
		#;  User needs %Admin_Secure:USE or %Admin_UserEdit:USE to Drop User definitions
	If ('$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) && '$SYSTEM.Security.Check($$$AdminUserEditResourceName,$$$PermUseName)) {
		set SQLCODE=-99,%msg=$$$FormatText($$$Text("User does not have permission to drop user %1","%SQL.Security"),$$$IDName(username))
		do Audit99(%msg)
		RETURN 0
	}
	set Status=$$UsersDelete(username)
	if $$$ISERR(Status) { set %msg=$$ProcessError^%apiDDL(Status,.SQLCODE) RETURN 0 }
 
	RETURN 1
}
 
 
CreateRole(rolename,SQLCODE,%msg) [] PUBLIC {
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="CreateRole",^|"%SYS"|RJWTEST(n,"rolename")=$g(rolename),^|"%SYS"|RJWTEST(n,"SQLCODE")=$g(SQLCODE),^|"%SYS"|RJWTEST(n,"%msg")=$g(%msg) ;rjwtestlog
	  #; ------------------------------------------------------------------
	  #; Function to Create a Role
	  #; Input Parameters -
	  #;   rolename - Name of Role to Create
	  #;   SQLCODE  - Passed by reference - returns SQLCODE value
	  #;
	  #;   Role definition:
	  #;   Global Metadata:
	  #;	$$$SecurityGlobal,"RolesD",$$$LOWER(rolename))=$LB(%%CLASSNAME,Description,Name,Audit,$$$LOWER(name))
	  #;	$$$SecurityGlobal,"RolesD",$$$LOWER(rolename),1)=$LB(rolename,owner)
	  #; ------------------------------------------------------------------
	  #;
	
		#;  User needs %Admin_Secure:USE or %Admin_RoleEdit:USE to Create Role definitions
	If ('$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) && '$SYSTEM.Security.Check($$$AdminRoleEditResourceName,$$$PermUseName)) {
		s SQLCODE=-99,%msg=$$$Text("%Admin_Secure:USE privilege or %Admin_RoleEdit:USE privilege is required to create a role","%SQL.Security")
		do Audit99(%msg)
		QUIT
	}
.
  	$$$AddSecurityRoleTemporary
	If $d($$$SecurityGlobalRoles(rolename)) {
		s SQLCODE=-118,%msg=$$$FormatText($$$Text("A role named %1 already exists","%SQL.Security"),$$$IDName(rolename))
		QUIT
	}
 
	  #; Define Main Role Information
	  #;  Role starts with no SQL SYSTEM privileges
	s $zt="CreateRoleError",SQLCODE=0
	TSTART
	s Status=$$RolesCreate(rolename,"SQL Role "_rolename)
	i $$$ISERR(Status) {
		s ok=$$DecomposeStatus^%apiOBJ(Status,.errors)
		If errors(1,"code")=$$$ERRORCODE($$$RoleAlreadyExists) { s SQLCODE=-118,%msg=$$$FormatText($$$Text("A role named %1 already exists","%SQL.Security"),$$$IDName(rolename)) TROLLBACK 1 QUIT  }
		Else { s %msg=$$ProcessError^%apiDDL(Status,.SQLCODE) TROLLBACK 1 QUIT  }
	}
 
	  #; Grant the Role (with Admin Option) to the user creating the Role
	If '$$$IsASuperUser($$$aid) {
		s %msg="",SQLCODE=$$GrantRole($$$aid,$lb(rolename),$$$aid,1,.%msg)
		i SQLCODE s %msg=$$$FormatText($$$Text("Unable to grant role %1 to user %2.  %3","%SQL.Security"),rolename,$$$aid,$g(%msg)) TROLLBACK 1 QUIT
	}
 	TCOMMIT
	s SQLCODE=0
	QUIT
	
CreateRoleError
	s $zt="",SQLCODE=-400,%msg=$$$FormatText($$$Text("ERROR::  Unexpected Error in CreateRole:  ","%SQL.Security"),$ze)
	TROLLBACK 1
	QUIT
}
 
 
DropRole(rolename,SQLCODE,%msg,ifexists=0) [] PUBLIC {
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="DropRole",^|"%SYS"|RJWTEST(n,"rolename")=$g(rolename),^|"%SYS"|RJWTEST(n,"SQLCODE")=$g(SQLCODE) ;rjwtestlog
	#; ------------------------------------------------------------------
	#; Function to Delete a Role
	#; Input Parameters -
	#;   rolename - Name of Role to Create
	#;   SQLCODE  - Passed by reference - returns SQLCODE value
	#;   %msg     - Passed by reference.  Returns contents of error message (if error)
	#;   ifexists - 1/0 Flag. Default is 0. If TRUE, suppress SQLCODE -118 as a warning
	#; ------------------------------------------------------------------
 
	set SQLCODE=0,%msg=""
	$$$AddSecurityRoleTemporary
	 
		#;  Find Real Role Name
		#;   Maybe no such Role, but can't tell them that yet - might not be privileged
	if $d($$$SecurityGlobalRoles(rolename),data) { set actualrolename=$lg(data,4) } else { set actualrolename="?" }
		#; For system roles (%* roles), if the user did not create the Role, then they need %Admin_Secure:"U" in order to delete it
		#; For non-system roles (not % roles), If the user was not granted Role with ADMIN option and the user did not create the Role, then they need %Admin_Secure:"U" or %Admin_RoleEdit:"U" in order to delete it
	if $e(rolename)="%" {
		if '$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName),$lg($g($$$SecurityGlobalRolesExt(rolename)),2)'=$$$aid {
			set SQLCODE=-99,%msg=$$$FormatText($$$Text("User does not have permission to drop role %1","%SQL.Security"),$$$IDName(rolename))
			do Audit99(%msg)
			RETURN
		}
	} elseif $$$LOWER(rolename)="sqladminrole" {	// Special case for the SQLAdminRole, require %Admin_Secure to delete it so the the SQLAdmin user cannot delete this role
		if '$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) {
			set SQLCODE=-99,%msg=$$$FormatText($$$Text("User does not have permission to drop role %1","%SQL.Security"),$$$IDName(rolename))
			do Audit99(%msg)
			RETURN
		}
	} else {	// not a %* system role
		if '$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName),'$SYSTEM.Security.Check($$$AdminRoleEditResourceName,$$$PermUseName),'$g($$$SecurityGlobalSQLUserRole($$$aid,actualrolename)),$lg($g($$$SecurityGlobalRolesExt(rolename)),2)'=$$$aid {
			set SQLCODE=-99,%msg=$$$FormatText($$$Text("User does not have permission to drop role %1","%SQL.Security"),$$$IDName(rolename))
			do Audit99(%msg)
			RETURN
		}
 
	}
	
	  #;  Does the role exist
	if actualrolename="?" {
		if ifexists {
			set SQLCODE = 0, %msg = ""
		} else {
			set SQLCODE = -118, %msg = $$$FormatText($$$Text("A role named %1 does not exist","%SQL.Security"),$$$IDName(rolename))
		}
		RETURN
	}
 
		#;  User needs %Admin_Secure:USE or %Admin_RoleEdit:USE to Drop Role definitions
		#;  If we get this far, we need to escalate the user privs if they don't have %Admin_Secure:USE or %Admin_RoleEdit:USE
	if ('$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) && '$SYSTEM.Security.Check($$$AdminRoleEditResourceName,$$$PermUseName)) {
		$$$AddAllRoleTemporary ; verified 9/26/16 STC
	}
 
		#;  Delete Main Role Information
	set Status=$$RolesDelete(rolename)
	if $$$ISERR(Status) {
		set ok=$$DecomposeStatus^%apiOBJ(Status,.errors)
		if errors(1,"code")=$$$ERRORCODE($$$RoleDoesNotExist) { set SQLCODE=-118,%msg=$$$FormatText($$$Text("A role named %1 does not exist","%SQL.Security"),$$$IDName(rolename)) RETURN }
		else { set %msg=$$ProcessError^%apiDDL(Status,.SQLCODE) RETURN  }
	}
	
	RETURN
}
 
/// DDL API to create a database and namespace with given options.
/// This API will create two databases, one for routines and one for globals.
/// The names will be: <pDBName>C (for Code) and <pDBName>D (for Data)
/// We will also create a namespace named <pDBName> which uses these two databases.
/// For example, creating a database FOO will create Config.Database entries FOOC and FOOD and a namespace FOO
///
/// Arguments:
///	pDBName - Name of the database to create
///	SQLCODE - PBR, returns SQLCODE which can be used to determine success of the operation
///	%msg    - PBR, returns descriptive error message is SQLCODE<0
///
///  Properties which can be set for database creation are:
///  	*Directory
/// 	BlockSize
/// 	*EncryptedDB
///  	EncryptionKeyID
///  	Size
///  	ExpansionSize
///  	MaxSize
///  	*GlobalJournalState
///  	NewGlobalCollation
///  	NewGlobalIsKeep
///  	NewGlobalGrowthBlock
///  	NewGlobalPointerBlock
///  	ClusterMountMode
///  	ResourceName
///  At this time we only support the ones marked with *
///
/// 
CreateDatabase(pDBName,pDirectory="",pProperties,SQLCODE,%msg,createDatabaseFile=0) [] PUBLIC { // JMM1298=
.
	#dim tDB As SYS.Database
	#dim tSC,tSC2 As %Library.Status
	#dim tlevel As %Library.Integer
	#dim tProgress As %String
	#dim tDB As Config.Databases
	
		#; The user must have %Admin_Maage resource to create a new database.
		#; Other restrictions may be enorced by the SYS.Database class.
	new %objlasterror	// some of the system utilities leave this dirty
	set tSC=$$$OK
	if '$SYSTEM.Security.Check($$$AdminManageResourceName,$$$PermUseName) { set SQLCODE=-99,%msg="User "_$username_" does not contain the required resources for the CREATE DATABASE operation" do Audit99(%msg) QUIT  }
	try {
		$$$AddAllRoleTemporaryInTry ; verified 9/26/16 STC
		new $namespace 
		set $namespace="%SYS"
		
			#; See if the namespace pDBName already exists
		if 'createDatabaseFile && ##class(Config.Namespaces).Exists(pDBName,,,"",7) { // JMM1298=
			set SQLCODE=-341,%msg="Cannot create namespace named "_$$$UPPER(pDBName)_".  A namespace with that name already exists." quit  
		}
.
			#; If the caller did not specify a directory, use the manager's directory ($zu(12)) adding on the name of the database
		if pDirectory="" {
			set pDirectory=##class(%Library.File).SubDirectoryName($zu(12),pDBName)
		}
			#; create the directory for the root directory of the database files
		if '##Class(%Library.File).CreateDirectoryChain(pDirectory) { set SQLCODE=-400,%msg="Unable to create root directory ("_pDirectory_") for database directories" quit  }
		for tSubName="C","D" {	// code and data databases
				#; create the directory for the root directory of the database files
			if createDatabaseFile { // JMM1298+
				set tSubDirectoryName=pDirectory
			}
			else { // JMM1298-
				set tSubDirectoryName=##class(%Library.File).SubDirectoryName(pDirectory,tSubName)
			} // JMM1298=
			if '##Class(%Library.File).DirectoryExists(tSubDirectoryName) {
				if '##Class(%Library.File).CreateDirectory(tSubDirectoryName) { set SQLCODE=-400,%msg="Unable to create subdirectory ("_tSubName_") under database directory ("_pDirectory_")" quit  }
				set tProgress("createdir",tSubDirectoryName)=""
			}
				#; Create the database file
			if ##class(%Library.File).Exists(##class(%Library.File).NormalizeFilename($$$UCFILENAME_".DAT",tSubDirectoryName)) {
				set SQLCODE=-341,%msg="Cannot create database file for database "_pDBName_", file "_##class(%Library.File).NormalizeFilename($$$UCFILENAME_".DAT",tSubDirectoryName)_") already exists." quit  
			}
			set tSC=##Class(SYS.Database).CreateDatabase(tSubDirectoryName,,,($g(pProperties("EncryptedDB"))=1),,$s($g(pProperties("GlobalJournalState"))=3:3,1:2))
			//set:$d(pProperties("ResourceName")) tDB.ResourceName=pProperties("ResourceName")
			quit:$$$ISERR(tSC)
			
			set tProgress("dbfile",tSubDirectoryName)=""
				#; Create the local database config entry
			set tDBConfigProperties("Directory")=tSubDirectoryName
			if createDatabaseFile { // JMM1298+
				set tDBName=pDBName
			} 
			else { // JMM1298-
				set tDBName=pDBName_tSubName
			} // JMM1298=
			set:$e(tDBName)="%" $e(tDBName)="_"	// If name begins with %, change first character to _
			set tSC=##Class(Config.Databases).Create(tDBName,.tDBConfigProperties)
			if $$$ISERR(tSC) {
				set ecode=$$$GETERRORCODE(tSC)
				if ecode=42 { set SQLCODE=-343,%msg="'"_tDBName_"' is an invalid database name",$ze="" }
				quit
			}
			set tProgress("dbname",tDBName)=""
			if createDatabaseFile { // JMM1298+
				quit
			}
			else { // JMM1298-
				set:tSubName="D" tNSProperties("Globals")=tDBName
				set:tSubName="C" tNSProperties("Routines")=tDBName
			} // JMM1298=
		}
		quit:$$$ISERR(tSC)||(SQLCODE<0)
		if 'createDatabaseFile { // JMM1298=
				#; Now create the namespace definition
			set tSC=##Class(Config.Namespaces).Create(pDBName,.tNSProperties)
			quit:$$$ISERR(tSC)
			set tProgress("nspace",pDBName)=""
		} // JMM1298=
	}
	catch {
		set SQLCODE=-400
		set %msg="Unexpected error in CreateDatabase: "_$ze
		do Cleanup()
	}
	if SQLCODE<0 {
		do Cleanup()
	}
	elseif $$$ISERR(tSC) {
		set SQLCODE=-400
		do DecomposeStatus^%apiOBJ(tSC,.tErrorList)
		set ecode=$$$GETERRORCODE(tSC)
		if ecode=921||(ecode=922)||(ecode=923) { set SQLCODE=-99 }
		for i=1:1:$g(tErrorList) { set %msg=tErrorList(i)_$s(i>1:$$$NL,1:"") }
		do Audit99(%msg)
		do Cleanup(.tErrorList)
	}
	QUIT
	
Cleanup(pErrorList)
		#; Now let us undo anything we have created, delete any namespaces, then local database entries, then database files we created.
	set tDBName=""
	set:'$g(pErrorList) pErrorList=0
	for  {
		set tDBName=$o(tProgress("dbname",tDBName)) quit:tDBName=""
		set tSC2=##Class(Config.Databases).Delete(tDBName)
		if $$$ISERR(tSC2) {
			do DecomposeStatus^%apiOBJ(tSC2,.tErrorList2)
			for i=pErrorList+1:1:pErrorList+1+$g(tErrorList2) { set %msg=tErrorList2(i)_$s(i>1:$$$NL,1:"") }
		}
	}
	set tDBFile=""
	for  {
		set tDBFile=$o(tProgress("dbfile",tDBFile)) quit:tDBFile=""
		set tSC2=##class(SYS.Database).DeleteDatabase(tDBFile)
		if $$$ISERR(tSC2) {
			do DecomposeStatus^%apiOBJ(tSC2,.tErrorList2)
			for i=pErrorList+1:1:pErrorList+1+$g(tErrorList2) { set %msg=tErrorList2(i)_$s(i>1:$$$NL,1:"") }
		}
	}
	set tDirectory=""
	for  {
		set tDirectory=$o(tProgress("createdir",tDirectory)) quit:tDirectory=""
		set tSC2=##class(%Library.File).RemoveDirectoryTree(tDirectory)
		if $$$ISERR(tSC2) {
			do DecomposeStatus^%apiOBJ(tSC2,.tErrorList2)
			for i=pErrorList+1:1:pErrorList+1+$g(tErrorList2) { set %msg=tErrorList2(i)_$s(i>1:$$$NL,1:"") }
		}
	}
	set tNSName=""
	for  {
		set tNSName=$o(tProgress("nspace",tNSName)) quit:tNSName=""
		set tSC2=##class(Config.Namespaces).Delete(tNSName)
		if $$$ISERR(tSC2) {
			do DecomposeStatus^%apiOBJ(tSC2,.tErrorList2)
			for i=pErrorList+1:1:pErrorList+1+$g(tErrorList2) { set %msg=tErrorList2(i)_$s(i>1:$$$NL,1:"") }
		}
	}
	kill tProgress
.
	QUIT
}
.
/// DDL API to delete a database and namespace.
/// This API will delete the namespace definition, the Routines and Globals databases (probably nameC and nameD if they were created with CREATE DATABASE) entries for the definition, and possibly the .DAT files for these definitions.
/// The user must have %Admin_Manage and must also hold the database resource in order to delete the database.
/// 
/// For example, creating a database FOO will create Config.Database entries FOOC and FOOD and a namespace FOO
///
/// Arguments:
///	pDBName		- Name of the database to create
///	pRetainFiles	- 1/0 flag.  Default is 0.  If TRUE, do not delete the database's .DAT files
///	SQLCODE		- PBR, returns SQLCODE which can be used to determine success of the operation
///	%msg		- PBR, returns descriptive error message is SQLCODE<0
/// ifexists	- 1/0 flag. Default is 0. If TRUE and the database does not exist, report SQLCODE 1 instead of -340.
/// 
DeleteDatabase(pDBName,pRetainFiles=0,SQLCODE,%msg,ifexists=0) [] PUBLIC {
.
	#dim tDB As SYS.Database
	#dim tSC As %Library.Status
	#dim tlevel As %Library.Integer
	#dim tProgress As %String
	#dim tDB As Config.Databases
	
		#; The user must have %Admin_Manage resource to create a new database.
		#; Other restrictions may be enorced by the SYS.Database class.
	new %objlasterror	// some of the system utilities leave this dirty
	set tSC=$$$OK,SQLCODE=0
	if $$$UPPER(pDBName)=$namespace { set SQLCODE=-344,%msg="Cannot drop database ("_pDBName_") you are currently using or connected to" QUIT  }
	if '$SYSTEM.Security.Check($$$AdminManageResourceName,$$$PermUseName) { set SQLCODE=-99,%msg="User "_$username_" does not contain the required resources for the CREATE DATABASE operation" do Audit99(%msg) QUIT  }
	try {
			#; Determine which database definitions to delete
		do GetNamespaceDatabases(pDBName,.tGlobalsDB,.tRoutinesDB,.SQLCODE,ifexists)
		if ((SQLCODE < 0) || ($get(tGlobalsDB) = "")) { quit }
		
			#; Determine the directory for the globals database
		do GetDatabaseDirectory(tGlobalsDB,.tGlobalsDirectory,.tGlobalsResource,.SQLCODE)
		quit:SQLCODE<0
		
			#; Determine the directory for the routines database
		if tRoutinesDB=tGlobalsDB { set tRoutinesDirectory=tGlobalsDirectory,tRoutinesResource=tGlobalsResource }
		else { do GetDatabaseDirectory(tRoutinesDB,.tRoutinesDirectory,.tRoutinesResource,.SQLCODE) }
		quit:SQLCODE<0
		
		if '$SYSTEM.Security.Check(tGlobalsResource,$$$PermReadAbrev) { set SQLCODE=-99,%msg="User "_$username_" does have privileges for the database resource of the default globals database for the '"_pDBName_"' namespace" do Audit99(%msg) QUIT  }
		if '$SYSTEM.Security.Check(tRoutinesResource,$$$PermReadAbrev) { set SQLCODE=-99,%msg="User "_$username_" does have privileges for the database resource of the default routines database for the '"_pDBName_"' namespace" do Audit99(%msg) QUIT  }
.
		$$$AddAllRoleTemporaryInTry ; verified 9/26/16 STC
		new $namespace 
		set $namespace="%SYS"
		
			#; Make sure the GlobalsDB and RoutinesDB are only used by this namespace, otherwise we don't delete the databases
		set tSC=##class(Config.Namespaces).NamespacesByDB(pDBName,.tNSList,0,,)
		if $$$ISERR(tSC) {
			set SQLCODE=-400
			do DecomposeStatus^%apiOBJ(tSC,.tErrorList)
			set ecode=$$$GETERRORCODE(tSC)
			for i=1:1:$g(tErrorList) { set %msg=tErrorList(i)_$s(i>1:$$$NL,1:"") }
			quit
		}
		
			#; Now attempt to delete the Namespace
		set tSC=##class(Config.Namespaces).Delete(pDBName)
		if $$$ISERR(tSC) {
			set SQLCODE=-400
			do DecomposeStatus^%apiOBJ(tSC,.tErrorList)
			set ecode=$$$GETERRORCODE(tSC)
			if ecode=434 { set SQLCODE=-342 }
			for i=1:1:$g(tErrorList) { set %msg=tErrorList(i)_$s(i>1:$$$NL,1:"") }
			quit
		}
		
		if tNSList'="",tNSList'=pDBName { quit  }
.
			#; Now attempt to dismount the Globals database 
		set tSC=##Class(SYS.Database).DismountDatabase(tGlobalsDirectory)
		if $$$ISERR(tSC) {
			set SQLCODE=-400
			do DecomposeStatus^%apiOBJ(tSC,.tErrorList)
			for i=1:1:$g(tErrorList) { set %msg=tErrorList(i)_$s(i>1:$$$NL,1:"") }
			quit
		}
			#; Now attempt to dismount the Routines database  (if it is different than the Globals database)
		if tGlobalsDirectory'=tRoutinesDirectory {
			set tSC=##Class(SYS.Database).DismountDatabase(tRoutinesDirectory)
			if $$$ISERR(tSC) {
				set SQLCODE=-400
				do DecomposeStatus^%apiOBJ(tSC,.tErrorList)
				for i=1:1:$g(tErrorList) { set %msg=tErrorList(i)_$s(i>1:$$$NL,1:"") }
				quit
			}
		}
.
			#; Now attempt to delete the Globals database definition
		set tSC=##Class(Config.Databases).Delete(tGlobalsDB)
		if $$$ISERR(tSC) {
			set SQLCODE=-400
			do DecomposeStatus^%apiOBJ(tSC,.tErrorList)
			for i=1:1:$g(tErrorList) { set %msg=tErrorList(i)_$s(i>1:$$$NL,1:"") }
			quit
		}
			#; Now attempt to delete the Routines database definition (if it is different than the Globals database)
		if tGlobalsDB'=tRoutinesDB {
			set tSC=##Class(Config.Databases).Delete(tRoutinesDB)
			if $$$ISERR(tSC) {
				set SQLCODE=-400
				do DecomposeStatus^%apiOBJ(tSC,.tErrorList)
				for i=1:1:$g(tErrorList) { set %msg=tErrorList(i)_$s(i>1:$$$NL,1:"") }
				quit
			}
		}
		
		if 'pRetainFiles {
				#; Now attempt to delete the database definition
			set tSC=##Class(SYS.Database).DeleteDatabase(tGlobalsDirectory)
			if $$$ISERR(tSC) {
				set SQLCODE=-400
				do DecomposeStatus^%apiOBJ(tSC,.tErrorList)
				for i=1:1:$g(tErrorList) { set %msg=tErrorList(i)_$s(i>1:$$$NL,1:"") }
				quit
			}
			if tGlobalsDirectory'=tRoutinesDirectory {
					#; Now attempt to delete the database definition
				set tSC=##Class(SYS.Database).DeleteDatabase(tRoutinesDirectory)
				if $$$ISERR(tSC) {
					set SQLCODE=-400
					do DecomposeStatus^%apiOBJ(tSC,.tErrorList)
					for i=1:1:$g(tErrorList) { set %msg=tErrorList(i)_$s(i>1:$$$NL,1:"") }
					quit
				}
			}
		}
	}
	catch {
		set SQLCODE=-400
		set %msg="Unexpected error in DeleteDatabase: "_$ze
	}
	if 'SQLCODE,$$$ISERR(tSC) {
		set SQLCODE=-400
		do DecomposeStatus^%apiOBJ(tSC,.tErrorList)
		set ecode=$$$GETERRORCODE(tSC)
		if ecode=921||(ecode=922)||(ecode=923) { set SQLCODE=-99 }
		for i=1:1:$g(tErrorList) { set %msg=tErrorList(i)_$s(i>1:$$$NL,1:"") }
		do Audit99(%msg)
	}
	QUIT
}
.
	/// Given a namespace, if the namespace exists return the Routine database and the Globals database
GetNamespaceDatabases(pNamespace,pGlobalsDB,pRoutinesDB,SQLCODE,ifexists) [] PRIVATE {
	
	#dim tNSOref As Config.Namespaces
	
	set pGlobalsDB="",pRoutinesDB="",tSC=$$$OK,SQLCODE=0
	try {
		$$$AddAllRoleTemporaryInTry ; verified 9/26/16 STC
		new $namespace
		set $namespace="%SYS"
		set tNSOref=##class(Config.Namespaces).Open(pNamespace,,,.tSC)
		if $$$ISERR(tSC) {
			set SQLCODE=-400
			do DecomposeStatus^%apiOBJ(tSC,.tErrorList)
			set ecode=$$$GETERRORCODE(tSC)
			if ecode=5809 {
				if ifexists {
					set SQLCODE = 0, %msg=""
				} else {
					set SQLCODE = -340, %msg=$$$FormatText($$$Text("Database named '%1' not found","%SQL.Security"),pNamespace)
				}
				quit
			}
			if ecode=921||(ecode=922)||(ecode=923) { set SQLCODE=-99 }
			for i=1:1:$g(tErrorList) { set %msg=tErrorList(i)_$s(i>1:$$$NL,1:"") }
			do Audit99(%msg)
			quit
		}
		set pGlobalsDB=tNSOref.Globals
		set pRoutinesDB=tNSOref.Routines
	}
	catch {
		set SQLCODE=-400
		set %msg="Unexpected error in looking up namespace's default routines and globals databases: "_$ze
	}
	QUIT
}
.
	/// Given a datbase definition, return the Directory of the database
	/// Also returns the resource for this database
GetDatabaseDirectory(pDatabase,pDirectory,pResource,SQLCODE) [] PRIVATE {
	
	#dim tNSOref As Config.Databases
	#dim tDB As SYS.Database
	#dim tSC As %Library.Status
	
	new %objlasterror
	set pDirectory="",tSC=$$$OK,SQLCODE=0
	try {
		$$$AddAllRoleTemporaryInTry ; verified 9/26/16 STC
		new $namespace
		set $namespace="%SYS"
		set pDirectory=##class(Config.Databases).GetDirectory(pDatabase)
		set tDB=##Class(SYS.Database).%OpenId(pDirectory,,.tSC)
 		if '$$$ISOK(tSC) {
			set SQLCODE=-400
			do DecomposeStatus^%apiOBJ(tSC,.tErrorList)
			set ecode=$$$GETERRORCODE(tSC)
			for i=1:1:$g(tErrorList) { set %msg=tErrorList(i)_$s(i>1:$$$NL,1:"") }
			quit
 		}
 		set pResource=tDB.ResourceName
	}
	catch {
		set SQLCODE=-400
		set %msg="Unexpected error in looking up database's directory: "_$ze
	}
	QUIT
}
.
/// DDL API to USE a database, which for us means to switch to the namespace
///
/// Arguments:
///	pDBName - Name of the database (namespace) to switch to
///	SQLCODE - PBR, returns SQLCODE which can be used to determine success of the operation
///	%msg    - PBR, returns descriptive error message is SQLCODE<0
///
///
/// 
UseDatabase(pDBName,SQLCODE,%msg) [] PUBLIC {
	try {
		set xDBC=0
		if $d(%protocol),$d(%qsc) {	// This is an xDBC connection
				// This is the $$$RoutineChange macro used in the %SYS.DBSRV code
				// It causes the cached query created for the USE <DATABASE> statement to get Purged now, before we leave this namespace
			If $g($$$CQClassname)'="",$LG($G(^%sqlcq($s($e($namespace)'="^":$namespace,1:$$$NameSpaceTranslationRC($namespace)),"QueryRoutine",$$$CQClassname)),5) { 
				set zu139=$ZU(139,2)
				do PurgeRtn^%SYS.SQLSRV($$$CQClassname)
				do $ZU(139,zu139) kill zu139
			}
			set xDBC=1
			do ##class(%SYS.DBSRV).CloseAllStatements()
			#; Run disconnect code
			if $g($$$SQLServerDisconnectCode) X $$$SQLServerDisconnectCode
		}
		set $namespace=pDBName
		if xDBC,$g($$$SQLServerInitCode) X $$$SQLServerInitCode
	}
	catch {
		if $ze["<NAMESPACE>" { set SQLCODE=-400,%msg="No such namespace: "_$g(pDBName),$ze="" }
		elseif $ze["<PROTECT>" { set SQLCODE=-99,%msg="No such namespace, or no privileges to access namespace: "_$g(pDBName),$ze="" do Audit99(%msg) }
		else { set SQLCODE=-400,%msg="Error attempting to use database "_$g(pDBName)_":  "_$ze }
		do:$d(zu139) $zu(139,zu139)
	}
	QUIT
}
.
ProcessError(sc,SQLCODE) [] PUBLIC {
	#; ------------------------------------------------------------------
	#; Function:     ProcessError
	#; Purpose:      Given a sc status code, build %msg with an error msg
	#; Parameters:
	#;   sc         - Status code
	#;   SQLCODE     - SQL Status Code, passed by reference
	#; ------------------------------------------------------------------
	#;
	s errlist="",SQLCODE=-400
	d DecomposeStatus^%apiOBJ(sc,.errlist)
	f i=1:1:errlist s %msg=errlist(i)_$s(i>1:"  ",1:"")
	QUIT $g(%msg)
}
.
GetNextSubscript(global, loopingSubscript, direction = 1, &row) [] PUBLIC {
	#; No reason to use this instead of $o unless we might need to escalate roles so make sure 
	#; the caller is from %Library.ODBCCatalog right off the bat
	#; $zu(96,9) is the calling routine, $zu(96,10) is the calling database
	#; Another part of the code also checks calling database matches current databases but this would almost always fail? ($zu(96,10)=$zu(12))
	set caller=$zu(96,9)
	if " %Library.ODBCCatalog.1 %Library.JDBCCatalog.1 %Library.SQLCatalog.1 %apiDDL2 %apiDDL %SQL.Manager.Catalog.1 %SQL.Manager.CatalogPriv.1 %occLibrary %Library.SQLCatalogPriv.1 "'[(" "_caller_" ") && (caller'["%sqlcq.") && (caller'["%SYS.sqlcq.") { 
		RETURN ""
	}
	
	set originalRoles = $roles
	// do not audit <PROTECT> error
	set oldval=$zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,0)
	for {
		try {
			if '$d(escalated) { // first try just the $o and quit if it succeeds w/o error
				set loopingSubscript = $o(@global@(loopingSubscript), direction, row)
				QUIT
			} else {
				QUIT:$d(@global@(loopingSubscript),row)
			}
		} catch ex {
			if ex.Name="<PROTECT>" {
				set escalated = 1
				$$$AddAllRoleTemporary
				set loopingSubscript = $o(@global@(loopingSubscript), direction)
				// reset the roles
				set $roles = originalRoles
				QUIT:loopingSubscript=""
				continue
			} else {
				do:$d(oldval) $zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,oldval)  // restore <PROTECT> error auditing setting		
				throw ex
			}
		}
		// if we ever make it here, we must've QUIT out of the TRY or CATCH because we found a subscript to return
		do:$d(oldval) $zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,oldval)  // restore <PROTECT> error auditing setting
		RETURN loopingSubscript
	}
}
.
.
/// Takes internal qualified name of a table and returns the name of the class associated with that table
/// If we get a <PROTECT> error when trying to access data (e.g. they do not have permissions on the database that the 
/// table is mapped from) then we will return "" and will not throw the error. There will be no auditing for <PROTECT> errors.
/// This must be done from a %SYS.* routine so that we can temporarily disable auditing of <PROTECT> errors regardless of user permissions.
GetClassNameFromIQNNoProtect(iqn) [] PUBLIC {
	set oldAuditVal = $zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,0)
	try {
		set className = $lg($g(^rINDEXSQL("rv",$$$UPPER($$$SchemaFromIQN(iqn)),$$$UPPER($$$TableFromIQN(iqn)))))
	} catch ex {
		if ex.Name="<PROTECT>" {
			set className = ""
		} else {
			do:$d(oldAuditVal) $zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,oldAuditVal)
			throw ex
		}
	}
	do:$d(oldAuditVal) $zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,oldAuditVal)
	RETURN className
}
.
.
