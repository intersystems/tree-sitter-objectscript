.
.
#; This is a copy of BuildSuperTree that will only be called if the original one encounters a <PROTECT> error
#; We do the same thing but instead of using the global iterator we will just use GetNextSubscript
#; Much slower!!! Should only be used if the original encounters a <PROTECT>!!!
BuildSuperTreeNoProtect(newhash,normcache) {
	Set sc=$$$OK,ns=$namespace,normcache=1
	Kill $$$tSUPERTREE(ns)
	Set $$$tSUPERTREE(ns)=newhash
	set classUpper = ""
	For  {
		set classUpper = $$GetNextSubscript("^rINDEXCLASS", classUpper, 1, .data)
		QUIT:classUpper=""
		Set superlist=$lg(data,7),classExact=$list(data,2)
		For no=1:1:$length(superlist,",") {
			Set item=$zstrip($piece(superlist,",",no),"<>W")
			If item="" CONTINUE
			If item'["." {
				If $extract(item)="%" {
					Set item="%Library."_$extract(item,2,*)
				} Else {
					Set rc=$$NormalizeClassnameByDef^%occName(.item,item,classExact,.normcache) If $$$ISERR(rc) Continue  ; Ignore errors
				}
			}
			Set $$$tSUPERTREE(ns,item,classExact)=$select(no=1:1,1:"")
		}
	}
	RETURN $$$OK
}
.
#; Build a complete list of subclasses
BuildSuperTree(newhash,normcache) [] PUBLIC {
	Set sc=$$$OK,ns=$namespace,normcache=1
	Kill $$$tSUPERTREE(ns)
	Set $$$tSUPERTREE(ns)=newhash
	Set iterator=##class(%Iterator.Global).%New($name(^rINDEXCLASS),1,0,"",""),cookie=iterator.getzu113Cookie()
	set oldval=$zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,0)
	try {
		For  {
			If '$zu(113,cookie,.data) quit
			Set superlist=$lg(data,7),cls=$list(data,2)
			For no=1:1:$length(superlist,",") {
				Set item=$zstrip($piece(superlist,",",no),"<>W")
				If item="" CONTINUE
				If item'["." {
					If $extract(item)="%" {
						Set item="%Library."_$extract(item,2,*)
					} Else {
						Set rc=$$NormalizeClassnameByDef^%occName(.item,item,cls,.normcache) If $$$ISERR(rc) Continue  ; Ignore errors
					}
				}
				Set $$$tSUPERTREE(ns,item,cls)=$select(no=1:1,1:"")
			}
		}
	} catch ex {
		if ex.Name = "<PROTECT>" {
			do BuildSuperTreeNoProtect(newhash,normcache)
		} else {
			do:$d(oldval) $zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,oldval)  // restore <PROTECT> error auditing setting		
			throw ex
		}
	}
	do:$d(oldval) $zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,oldval)  // restore <PROTECT> error auditing setting		
	RETURN $$$OK
}
.
	#; Called by Export^%qarDDLExport
	#; Returns a %Status
	#; This code DOES NOT WORK (according to PL76118 / DP-165295)
ExportUsers(&ddl, includeSysPrivs=1, eos="") [] PUBLIC {
	if '$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) {
		return $$$ERROR($$$InsufficientPrivilegeForOperationReq,$$$AdminSecureResourceName _ ":" _ $$$PermUseAbrev)
	}
  	$$$AddSecurityRoleTemporary
	set ddl($increment(ddl)) = "-- Export of all User definitions --"
	set ddl($increment(ddl)) = ""
	set user = "", cnt = 0, sysprivs = $$$AdminPrivsLB
	for {
			#; The user key is always lowercase; $$$GetSecurityUsersName will return exact case
		set user = $order($$$SecurityGlobalUsers(user),1,data)
		quit:(user = "")
		set User = $$$GetSecurityUsersName(data)
			#; Skip any special users
		continue:($case($piece(User,$$$DomainDelim),
			$$$SuperUserUsername  : 1,
			$$$AdminUsername      : 1,
			$$$UnknownUserUsername: 1,
			$$$pSystemUsername    : 1,
			$$$CSPSystemUsername  : 1,
			$$$SYSTEMUsername     : 1,
			$$$PUBLICUsername     : 1,
			: 0
		))
		set password = $$$GetSecurityUsersPassword(data)
			#; It's necessary to export support for delimited identifies because the encrypted password
			#; specification uses a delimited identifier
		if $increment(cnt) = 1 {
			set ddl($increment(ddl)) = "SET OPTION SUPPORT_DELIMITED_IDENTIFIERS = TRUE"
			set ddl($increment(ddl)) = eos
			set:(eos '= "") ddl($increment(ddl)) = ""
		}
		set ddl($increment(ddl)) = "CREATE USER " _ $$quoter2(User) _ $select((password '= ""):" IDENTIFIED BY """ _ $$PasswordToXSD(password) _ """",1:"")
		set ddl($increment(ddl)) = eos
		set:(eos '= "") ddl($increment(ddl)) = ""
		continue:('includeSysPrivs)
			#; data will be populated iff $data = 1 or 11
		if $data($$$SecurityGlobalSQLSysPriv($namespace,user),data)#2 {			
			set grantList = "", grantAdminList = ""
			for i=1:1:$$$privcnt {
				if $listget(data,i) = 1 { set grantList = grantList _ $list(sysprivs,i) _ "," }
				elseif $listget(data,i) = 2 { set grantAdminList = grantAdminList _ $list(sysprivs,i) _ "," }
			}
			if grantList '= "" {
				set ddl($increment(ddl)) = "GRANT " _ $extract(     grantList,1,*-1) _ " TO " _ $$quoter2(User)
				set ddl($increment(ddl)) = eos
				set:(eos '= "") ddl($increment(ddl)) = ""
			}
			if grantAdminList '= "" {
				set ddl($increment(ddl)) = "GRANT " _ $extract(grantAdminList,1,*-1) _ " TO " _ $$quoter2(User) _ " WITH ADMIN OPTION"
				set ddl($increment(ddl)) = eos
				set:(eos '= "") ddl($increment(ddl)) = ""
			}
		}
	}
	return $$$OK
}
 
	#; Take an excrypted password and turn it into a non-control character str for output
	#; Used only by ExportUsers^%SYS.SQLSEC
PasswordToXSD(str) [] PRIVATE {	
	try {
		new $namespace
		set $namespace = "%SYS"
		return "%%ENCRYPTED(" _ ##class(Security.Users).PasswordLogicalToXSD(str) _ ")"
	} catch {
		return ""
	}
}
 
 
PasswordFromXSD(str) [] PRIVATE {
		#;  Take an excrypted password and turn it into a non-control character str for output
	s $zt="Error" 
	n $namespace d $zu(5,"%SYS")
	s val=##class(Security.Users).PasswordXSDToLogical(str)
	QUIT val
Error	s $zt=""
	QUIT ""
}
 
	#; Called by Export^%qarDDLExport
	#; Returns a %Status
ExportRoles(&ddl, includeSysPrivs=1, eos="") [] PUBLIC {
	if '$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) {
		return $$$ERROR($$$InsufficientPrivilegeForOperationReq,$$$AdminSecureResourceName _ ":" _ $$$PermUseAbrev)
	}
  	$$$AddSecurityRoleTemporary
	set ddl($increment(ddl)) = "-- Export of all Role definitions --"
	set ddl($increment(ddl)) = ""
	set role = "", creator = "", lastcreator="" , cnt = 0, sysprivs = $$$AdminPrivsLB
	for {
		set role = $order($$$SecurityGlobalRoles(role),1,data)
		quit:(role = "")
		set sqldata = $get($$$SecurityGlobalRolesExt(role))
		set Role = $$$GetSecurityRolesName(data)
			#; Skip any system defined roles
		continue:($extract(Role) = "%")
		set creator = $$$GetSecurityRolesSQLOwner(sqldata)
		continue:($$$IsSystemRole(Role)||$$$IsSystemLegacyRole(Role))
		if creator '= lastcreator {
			set ddl($increment(ddl)) = "SETUSER " _ creator
			set ddl($increment(ddl)) = eos
			set:(eos '= "") ddl($increment(ddl)) = ""
			set lastcreator = creator
		}
		set ddl($increment(ddl)) = "CREATE ROLE " _ $$quoter2(Role)
		set ddl($increment(ddl)) = eos
		set:(eos '= "") ddl($increment(ddl)) = ""
		continue:('includeSysPrivs)
		if $data($$$SecurityGlobalSQLSysPriv($namespace,role),data)#2 {
			set grantList = "", grantAdminList = ""
			for i=1:1:$$$privcnt {
					if $listget(data,i) = 1 { set grantList      = grantList      _ $list(sysprivs,i) _ "," }
				elseif $listget(data,i) = 2 { set grantAdminList = grantAdminList _ $list(sysprivs,i) _ "," }
			}
			if grantList '= "" {
				set ddl($increment(ddl)) = "GRANT " _ $extract(     grantList,1,*-1) _ " TO " _ $$quoter2(Role)
				set ddl($increment(ddl)) = eos
				set:(eos '= "") ddl($increment(ddl)) = ""
			}
			if grantAdminList '= "" {
				set ddl($increment(ddl)) = "GRANT " _ $extract(grantAdminList,1,*-1) _ " TO " _ $$quoter2(Role) _ " WITH ADMIN OPTION"
				set ddl($increment(ddl)) = eos
				set:(eos '= "") ddl($increment(ddl)) = ""
			}
		}
			#; Now grant the role to users/roles
		set user = "", userlist = ""
		for {
			set user = $order($$$SecurityGlobalSQLRoleUser(Role,user))
			quit:(user = "")
			set userlist = userlist _ $$quoter2(user) _ ","
		}
		if userlist '= "" {
			set ddl($increment(ddl)) = "GRANT " _ $$quoter2(Role) _ " TO " _ $extract(userlist,1,*-1)
			set ddl($increment(ddl)) = eos
			set:(eos '= "") ddl($increment(ddl)) = ""
		}
	}
	return $$$OK
}
 
	#; Export all the privileges for the given table/view/procedure
	#; Called by Export^%qarDDLExport
	#; Returns a %Status
ExportPrivileges(schema,table,ttype,&ddl,&lastgrantor="",eos="") [] PUBLIC {
	if '$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) {
		return $$$ERROR($$$InsufficientPrivilegeForOperationReq,$$$AdminSecureResourceName _ ":" _ $$$PermUseAbrev)
	}
  	$$$AddSecurityRoleTemporary
		#; No table/view/procedure = no-op
	return:($get(table) = "") $$$OK
	set:($get(schema) = "") schema = $$$GetDefaultSchema
		#; If the iqn is "", then the table doesn't exist.
		#; If ttype = 9, "table" is actually a procedure so check ^oddPROC for existence
	if $$$GetExactIntQualifiedName(schema,table) = "",((ttype '= 9) || '$data(^oddPROC($$$IDName(schema),$$$IDName(table)))), ((ttype '= 7) || '$d($$$FSIDXServer($$$IDName(schema),$$$IDName(table)))) {
		return $$$ERROR($select(ttype=9: $$$ERRORCODE($$$ProcedureNotFound), 1: $$$ERRORCODE($$$TableDoesNotExist)), schema _ "." _ table)
	}
	set iqn = schema _ "." _ $translate(table,".",$char(2))
	set obj = ttype _ "," _ iqn
		#; Table level privileges
	set priv = ""
	for {
		set priv = $order($$$SecurityGlobalSQLPriv($namespace, 0, obj, priv))
		quit:(priv = "")
		set grantee = ""
		for {
			set grantee = $order($$$SecurityGlobalSQLPriv($namespace, 0, obj, priv, grantee))
			quit:(grantee = "")
			set grantor = ""
			for {
					#; First order the GRANT statements by grantor so we don't have to generate many SETUSER statements
				set grantor = $order($$$SecurityGlobalSQLPriv($namespace,0, obj, priv, grantee, grantor),1,data)
				quit:(grantor = "")
				set temp(grantor, $increment(temp(grantor))) = $listbuild(priv,schema,table,grantee,data)
			}
		}
	}
		#; Column level privileges (DPV3332)
	set objStart = obj, priv = ""
	for {
		set obj = $order($$$SecurityGlobalSQLPriv($namespace,0,obj))
		quit:(obj = "")
			##; Not a field in this table
		quit:($extract(obj,1,$length(objStart) + 1) '= (objStart_"."))
		set field = $piece(obj, objStart _ ".", 2)
		for {
			set priv = $order($$$SecurityGlobalSQLPriv($namespace,0,obj,priv))
			quit:(priv = "")
			set grantee = ""
			for {
				set grantee = $order($$$SecurityGlobalSQLPriv($namespace,0,obj,priv,grantee))
				quit:(grantee = "")
				set grantor = ""
				for {
						#;  First order the GRANT statements by grantor so we don't have to generate many SETUSER statements
					set grantor = $order($$$SecurityGlobalSQLPriv($namespace,0,obj,priv,grantee,grantor),1,data)
					quit:(grantor = "")
					set temp(grantor,$increment(temp(grantor))) = $lb(priv,schema,table,grantee,data,field)
				}
			}
		}
	}
	set grantor = ""
	for {
		set grantor = $order(temp(grantor))
		quit:(grantor = "")
		if (grantor '= lastgrantor) {
			set ddl($increment(ddl)) = "SETUSER " _ grantor
			set ddl($increment(ddl)) = eos
			set:(eos '= "") ddl($increment(ddl)) = ""
			set lastgrantor = grantor
		}
		for i=1:1:temp(grantor) { ##; DPV3041
			set ddl($increment(ddl)) = "GRANT " _ $$privname($list(temp(grantor,i)))
			set ddl(ddl) = ddl(ddl) _ $select($listget(temp(grantor,i),6)'="":" (" _ $$quoter2($list(temp(grantor,i),6)) _ ")",1:"")
			set ddl(ddl) = ddl(ddl) _ " ON " _ $select(ttype=7: "SERVER ", 1:"") _ $$quoter2($list(temp(grantor,i),2)) _ "." _ $$quoter2($list(temp(grantor,i),3))
			set ddl(ddl) = ddl(ddl) _ " TO " _ $$quoter2($list(temp(grantor,i),4))
			set ddl(ddl) = ddl(ddl) _ $select($list(temp(grantor,i),5):" WITH GRANT OPTION",1:"")
			set ddl($increment(ddl)) = eos
			set:(eos '= "") ddl($increment(ddl)) = ""
		}
	}
	return $$$OK
}
 
privname(p) [] PRIVATE {
		#; Turn a privilege abbreviation into the full name
	RETURN $case(p,"a":"%ALTER","i":"INSERT","d":"DELETE","u":"UPDATE","s":"SELECT","r":"REFERENCES","e":"EXECUTE","l":"USE",1:"???")
}
 
 
SQLPrivNamespaceCleanup(ns="") [] PUBLIC {
		#;  This function is called from Config.DataStorage.%OnAfterSave if a namespace has been deleted from the active configuration
		#;  This cleans up the $$$SecurityGlobal,"SQL",...,ns) globals for this namespace.
	QUIT:ns=""
	$$$AddSecurityRoleTemporary
	k $$$SecurityGlobalSQLPriv(ns),$$$SecurityGlobalSQLSysPriv(ns)
	$$$SetSecuritySQLUpdate(ns)
	QUIT
}
 
GetSpecialListUserlist() [] PUBLIC {
		#; This function is called from GetSpecialList^%qccServer for userlist to get a list of users.
		#; It has to be here for Security purposes
		#; Code is from %qccServer and %qccStringList.INC
		
#def1arg LB(%args) $$ListBuild(%args)
 
	$$$AddSecurityRoleTemporary
	s list="",u="",maxLocalLen=($$$MaxLocalLength-100)
		#; First Users
	For  { s u=$o($$$SecurityGlobalUsers(u),1,data) q:u=""  s x=$$$LB($$$GetSecurityUsersName(data)) If ($l(list)+$l($lb(x)))>maxLocalLen { s list=list_$$$LB("[TRUNCATED]") q  } s list=list_x }	// DPV2515=
		#; Then Roles
	For  { s u=$o($$$SecurityGlobalRoles(u),1,data) q:u=""  s x=$$$GetSecurityRolesName(data) if $e(x)'="%" { s x=$$$LB(x) if ($l(list)+$l($lb(x)))>maxLocalLen { s list=list_$$$LB("[TRUNCATED]") q  } s list=list_x }}	// DPV2515=
	QUIT list
 
ListBuild(args...) Set l="" For i=1:1:args { Set l=l_$Length($Get(args(i)))_":"_$Get(args(i)) } Quit l
}
 
 
CheckSchemaIndex(schema) [] PUBLIC {
	set $zt="CheckSchemaIndexError",SCHEMA=$$$UPPER(schema) $$$AddAllRoleTemporary ; verified 9/26/16 STC
	if $d(^rINDEXSQL("schema",SCHEMA),schema)=1,schema'="" {
		if $$$FSIDXGetLowestCommonVersion<$$$FSIDXLatestVersion {
			GOTO:'$$updateForeignServerIndex CheckSchemaIndexError
		}
		if '$d(^oddPROC(SCHEMA)),'$d(^oddSQL(schema)),'$d($$$FSIDXSchema(SCHEMA)),$$GetGlobalPermission^%SYS.SECURITY(,"rINDEXSQL","""schema"","""_SCHEMA_"""",1)["WRITE" {
			kill ^rINDEXSQL("schema",SCHEMA)
		}
	}
	QUIT
CheckSchemaIndexError
	s $zt="" QUIT
}
 
	#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  The functions below are called from SQL Catalog Queries 
	#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
SchemasExecuteKillLoop(system) [] PUBLIC {
	try {
			#; Make sure the caller is from one of our internal routines
			#; $zu(96,9) is the calling routine, $zu(96,10) is the calling database
		if '( ($zu(96,9)="%SQL.Manager.Catalog.1") && $$$CallingDBIsIRISLIB ) { RETURN }
		$$$AddAllRoleTemporaryInTry ; verified 9/26/16 STC
		set SCHEMA=$e("&",'system) 
		for  {
			set SCHEMA=$o(^rINDEXSQL("schema",SCHEMA),1,schema) quit:SCHEMA=""
			continue:'system&&(SCHEMA="INFORMATION_SCHEMA")
			if '$d(^oddPROC(SCHEMA)),'$d(^oddSQL(schema)),$$GetGlobalPermission^%SYS.SECURITY(,"rINDEXSQL","""schema"","""_SCHEMA_"""",1)["WRITE" { Kill ^rINDEXSQL("schema",SCHEMA) }	// DPV2759
		}
	} catch {}
	RETURN
}
 
SQLRolesExecute(%q,%roles,%caller="") [] PUBLIC {
		#;  %roles(%q,rolename) = $lb(rolename,description,createdby)
	set $ztrap="SQLRolesExecuteError"
	$$$AddSecurityRoleTemporary
	set r=""
	for  {
		set r=$o($$$SecurityGlobalRoles(r),1,data) quit:r=""
		continue:r=$$$LOWER($$$SQLTuneTableRoleName)	// This is an internal role for TuneTable which should never be granted
		set data1=$get($$$SecurityGlobalRolesExt(r))
		set %roles(%q,r)=$listbuild($$$GetSecurityRolesName(data),$$$GetSecurityRolesDescription(data),$$$GetSecurityRolesSQLOwner(data1),$$$GetSecurityRolesEscalationOnly(data))
	}
	QUIT $$$OK
SQLRolesExecuteError
	s $zt="" QUIT $$$ERROR($$$ObjectScriptError,$ze)
}
 
 
SQLRolePrivilegesExecute(%q,role,%p,%caller) [] PUBLIC {
		#;  %r(%q) = loop counter
		#;  %p(%q,%r(%q)) = ROWSPEC
		#; Returns information for the current namespace.  %caller argument is unused. 
	s $zt="SQLRolePrivilegesExecuteError" 
	$$$AddSecurityRoleTemporary
		#;  Get real role name
	i $g(role)'="",$$$SecurityRolesExists(role,data) s role=$$$GetSecurityRolesName(data)
		#;  Don't let user see privileges if not SuperUser and not granted the role and does not have %Admin_Secure:"USE" Resource
	i '$$$IAmSuperUser,'$d($$$SecurityGlobalSQLUserRole($$$aid,role)),'$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) QUIT $$$OK  // DPV2757
		#;  Get all the SQL Privs grated directly to the role
	s pid=""
	For  {
		s pid=$o($$$SecurityGlobalSQLPriv($namespace,"m",role,pid)) q:pid=""
		s p=$p(pid,"||",2),p=$$privname(p)
		s go=+$g($$$SecurityGlobalSQLPriv($namespace,0,$p(pid,"||"),$p(pid,"||",2),$p(pid,"||",3),$p(pid,"||",4)))
		s %p(%q,$i(%p(%q)))=$lb($case(+pid,1:"TABLE",3:"VIEW",4:"CUBE",5:"SCHEMA",6:"ML_CONFIGURATION",7:"FOREIGN SERVER",9:"STORED PROCEDURE",:"???"),$p($p(pid,"||"),",",2),p,$p(pid,"||",4),$s(go=1:"Yes",1:"No"))
	}
	QUIT $$$OK
SQLRolePrivilegesExecuteError
	s $zt="" QUIT $$$ERROR($$$ObjectScriptError,$ze)
}
 
  
SQLRoleUserExecute(%q,role,%p,%caller) [] PUBLIC {
		#;  %r(%q) = loop counter
		#;  %p(%q,%r(%q)) = ROWSPEC
	s $zt="SQLRoleUserExecuteError" 
	$$$AddSecurityRoleTemporary
		#;  Get real role name
	s escalationOnlyRole=0, sc=$$$OK
	i $g(role)'="",$$$SecurityRolesExists(role,data) s role=$$$GetSecurityRolesName(data)
		#;  Don't let user see privileges if not SuperUser and not granted the role and does not have %Admin_Secure:"USE" Resource
	i '$$$IAmSuperUser,'$d($$$SecurityGlobalSQLUserRole($$$aid,role)),'$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) QUIT $$$OK  // DPV2757
	#;  Get all the SQL Privs grated directly to the role
	s u=""
	For  {
		s u=$o($$$SecurityGlobalSQLRoleUser(role,u)) q:u=""
		If $$$SecurityRolesExists($$$LOWER(u),data) { s t="ROLE" } ElseIf $$$SecurityUsersExists($$$LOWER(u),data) { s t="USER" } Else { s t="???" }
		s ao=+$g($$$SecurityGlobalSQLUserRole(u,role))
		s %p(%q,$$$LOWER(u))=$lb(u,t,ao)	// DPV3415
	}
.
	QUIT sc
SQLRoleUserExecuteError
	s $zt="" QUIT $$$ERROR($$$ObjectScriptError,$ze)
}
 
 
SQLUsersExecute(%q,%users,%caller) [] PUBLIC {
		#;  %u(%q)     = Loop counter
		#;  %users(%q,username) = $lb(username,description)
	set $zt="SQLUsersExecuteError" 
	$$$AddSecurityRoleTemporary
	set lblYes = $$$Text("Yes","%Utility")
	set lblNo = $$$Text("No","%Utility")
	set u="" 
	for  {
		set u=$o($$$SecurityGlobalUsers(u),1,data) quit:u=""
		if '($$$IAmSuperUser),'$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) {
			if $$$LOWER(u)'=$$$LOWER($$$aid),'$$CreatedUser($username,u) { continue }
		}
		set flags=$$$GetSecurityUsersFlags(data)
		set type=""
		if $zb(flags,$$$NormalUser,1) { set type=type_$$$GetMsg($$$UsersMsg,"FlagsCache")_"," }
		if $zb(flags,$$$LDAPUser,1) { set type=type_$$$GetMsg($$$UsersMsg,"FlagsLDAP")_"," }
		if $zb(flags,$$$DelegatedUser,1) { set type=type_$$$GetMsg($$$UsersMsg,"FlagsDelegated")_"," }
		if $zb(flags,$$$KerberosUser,1) { set type=type_$$$GetMsg($$$UsersMsg,"FlagsKerberos")_"," }
		if $zb(flags,$$$OSUser,1) { set type=type_$$$GetMsg($$$UsersMsg,"FlagsOS")_"," }
		set type=$e(type,1,*-1)
		set %users(%q,u)=$lb($$$GetSecurityUsersName(data),$$$GetSecurityUsersFullName(data),$Case($$$GetSecurityUsersEnabled(data),1:lblYes,:lblNo),$$$GetSecurityUsersNameSpace(data),$$$GetSecurityUsersRoutine(data),type)
	}
	RETURN $$$OK
SQLUsersExecuteError
	set $zt=""
	RETURN $$$ERROR($$$ObjectScriptError,$ze)
}
 
 
SQLUserExistsExecute(%q,user,%users,%caller) [] PUBLIC {
		#;  %users(%q) = $lb(username)
		#;  Note:  %caller argument seems to be unused.
	s $zt="SQLUserExistsExecuteError" 
	$$$AddSecurityRoleTemporary
	i $$$SecurityUsersExists($$$LOWER(user),data) s %users(%q)=$lb($$$GetSecurityUsersName(data))
	QUIT $$$OK
SQLUserExistsExecuteError
	s $zt="" QUIT $$$ERROR($$$ObjectScriptError,$ze)
}
 
 
SQLUserPrivsExecute(%q,user,%p,%caller,system=0) [] PUBLIC {
		#;  %r(%q) = loop counter
		#;  %p(%q,%r(%q)) = ROWSPEC
		#;  NOTE:  The data goes into ^IRIS.Temp(%q,rownum), not into %p as stated above
	s $zt="SQLUserPrivsExecuteError"
	$$$AddSecurityRoleTemporary
	s su=$$$IsASuperUser(user),iamsu=$$$IAmSuperUser
		#;  Get real user/role name
	If $g(user)="" { }
	ElseIf $$$SecurityUsersExists($$$LOWER(user),data) { s user=$$$GetSecurityUsersName(data),type="user" }  // User???
	ElseIf $$$SecurityRolesExists($$$LOWER(user),data) { s user=$$$GetSecurityRolesName(data),type="role" }  // Role???
	Else { QUIT $$$OK }
	QUIT:user="" $$$OK
	if type'="role"	{ s ulist=$s(user'="_PUBLIC":$lb(user,"_PUBLIC"),1:$lb(user))_$zstl($$roleset(user,"user")) }
	else 		{ s ulist=$zstl($$roleset(user,"role")) }
 
		#;  If a user, don't let this user see privileges if not SuperUser and not the user themselves and they don't have USE permission on the %Admin_Secure resource
	i type="user",'iamsu,$$$aid'=user,'$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) s AtEnd=1 QUIT $$$OK
	s schema=""
	For  {
		s schema=$o(^oddSQL(schema)) q:schema=""
		if $e(schema)="%"||(schema="INFORMATION_SCHEMA") { set tIsASystemTable=1 } else { set tIsASystemTable=0 }
		s table=""
		For {
			s data="",table=$o(^oddSQL(schema,table),1,data) q:table=""
			continue:data=""||((tIsASystemTable&&'system))		// Not a table OR (System table/view AND don't display system classes), skip it
			s tinfo=$lg(data,6)					// Type,Name
				#; See if this tables has any column level privileges
			s colPrivs=0,tablePrivs=0
			For priv="a","d","i","r","s","u" {
				If su { s ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb($s(+tinfo=1:"TABLE",+tinfo=3:"VIEW",1:"???"),schema_"."_table,$p(",%ALTER,DELETE,INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",priv)),$$$SystemSuperUser,"Yes","SuperUser",colPrivs),tablePrivs=1 }
				Else {
					if $d($$$SecurityGlobalSQLPriv($namespace,0,tinfo,priv)) {
						#; OK, we know the privilege exists, see if any of the users/roles in the user list are privileged
						s p=0 While $ListNext(ulist,p,thisuser) { 
							If $d($$$SecurityGlobalSQLPriv($namespace,0,tinfo,priv,thisuser)) {
								s grantedby=$o($$$SecurityGlobalSQLPriv($namespace,0,tinfo,priv,thisuser,""),1,go)
								s go=$s(go:"Yes",1:"No")
								s grantedvia=$case(thisuser,user:"Direct","_PUBLIC":"Public",:"Role:"_thisuser)
								set:'colPrivs&&$$AnyColumnPriv(tinfo,thisuser) colPrivs=1
								s ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb($s(+tinfo=1:"TABLE",+tinfo=3:"VIEW",1:"???"),schema_"."_table,$p(",%ALTER,DELETE,INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",priv)),grantedby,go,grantedvia,colPrivs),tablePrivs=1
							}
						}
					}
					if $d($$$SecurityGlobalSQLPriv($namespace,0,"5,"_$$$UPPER(schema),priv)) {
						#; OK, we know the privilege exists, see if any of the users/roles in the user list are privileged
						s p=0 While $ListNext(ulist,p,thisuser) { 
							If $d($$$SecurityGlobalSQLPriv($namespace,0,"5,"_$$$UPPER(schema),priv,thisuser)) {
								s grantedby=$o($$$SecurityGlobalSQLPriv($namespace,0,"5,"_$$$UPPER(schema),priv,thisuser,""),1,go)
								s go=$s(go:"Yes",1:"No")
								s grantedvia="Schema Privilege"
								//set:'colPrivs&&$$AnyColumnPriv(tinfo,thisuser) colPrivs=1
								s ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb($s(+tinfo=1:"TABLE",+tinfo=3:"VIEW",1:"???"),schema_"."_table,$p(",%ALTER,DELETE,INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",priv)),grantedby,go,grantedvia,0),tablePrivs=1
							}
						}
					}
					if ( +tinfo=1 || ( +tinfo=3 && ( "as"[priv ))) && '$$OwnerCheckUser(user,ulist,tinfo,priv) {
						set ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb($s(+tinfo=1:"TABLE",+tinfo=3:"VIEW",1:"???"),schema_"."_table,$p(",%ALTER,DELETE,INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",priv)),$$$SystemSuperUser,"Yes","Owner Privilege",0),tablePrivs=1
					}
				}
			}
			if 'tablePrivs {
					#; There are no table privileges granted to this user, but there may be column privileges, if so, report that
				s p=0 While $ListNext(ulist,p,thisuser) {
					if $$AnyColumnPriv(tinfo,thisuser) set ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb($s(+tinfo=1:"TABLE",+tinfo=3:"VIEW",1:"???"),schema_"."_table,"","","","",1) quit
				}
			}
		}
		s proc="",SCHEMA=$$$UPPER(schema)
		For  {
			s proc=$o(^oddPROC(SCHEMA,proc)) q:proc=""
			//continue:$$$PROChidden($$$pPROC,SCHEMA,proc)
			continue:tIsASystemTable&&('system)			// is this a system procedure?
			continue:$g($$$PROCtype($$$pPROC,SCHEMA,proc))=$$$cPROCTYPEUDAF
			continue:'$g($$$PROCprojected($$$pPROC,SCHEMA,proc))	// Is this procedure projected?  Might not be if it is from a class query
			set pschema=$$$PROCschema($$$pPROC,SCHEMA,proc),pname=$$$PROCname($$$pPROC,SCHEMA,proc)
			if su { set ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb("STORED PROCEDURE",schema_"."_pname,"EXECUTE",$$$SystemSuperUser,"Yes","SuperUser",0) }
			set tinfo="9,"_$$$BuildIQN(pschema,pname)
			if $d($$$SecurityGlobalSQLPriv($namespace,0,tinfo,"e")) {
				set p=0 
				While $ListNext(ulist,p,thisuser) {
					if $d($$$SecurityGlobalSQLPriv($namespace,0,tinfo,"e",thisuser)) {
						s grantedby=$o($$$SecurityGlobalSQLPriv($namespace,0,tinfo,"e",thisuser,""),1,go)
						s go=$s(go:"Yes",1:"No")
						s grantedvia=$case(thisuser,user:"Direct","_PUBLIC":"Public",:"Role:"_thisuser)
						s ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb("STORED PROCEDURE",pschema_"."_pname,"EXECUTE",grantedby,go,grantedvia,0)
					}
				}
			}
			if $d($$$SecurityGlobalSQLPriv($namespace,0,"5,"_SCHEMA,"e")) {
				set p=0 
				While $ListNext(ulist,p,thisuser) {
					if $d($$$SecurityGlobalSQLPriv($namespace,0,"5,"_SCHEMA,"e",thisuser)) {
						set grantedby=$o($$$SecurityGlobalSQLPriv($namespace,0,"5,"_SCHEMA,"e",thisuser,""),1,go)
						set go=$s(go:"Yes",1:"No")
						set grantedvia="Schema Privilege"
						set ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb("STORED PROCEDURE",pschema_"."_pname,"EXECUTE",grantedby,go,grantedvia,0)
					}
				}
			}
			if '$$OwnerCheckUser(user,ulist,tinfo,"e") {
				set ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb("STORED PROCEDURE",pschema_"."_pname,"EXECUTE",$$$SystemSuperUser,"Yes","Owner Privilege",0)
			}
		}
	}
	set mlconfig=""
	for  {
		set mlconfig=$o(^%SYS("ml","configuration","d",mlconfig),1,mldata) quit:mlconfig=""
		set mlconfigname=$lg(mldata,2)
		if su { set ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb("ML CONFIGURATION",mlconfigname,"USE",$$$SystemSuperUser,"Yes","SuperUser",0) }
		set tinfo="6,"_$$$UPPER(mlconfigname)
		if $d($$$SecurityGlobalSQLPriv($namespace,0,tinfo,"l")) {
			set p=0
			while $ListNext(ulist,p,thisuser) {
				if $d($$$SecurityGlobalSQLPriv($namespace,0,tinfo,"l",thisuser)) {
					set grantedby=$o($$$SecurityGlobalSQLPriv($namespace,0,tinfo,"l",thisuser,""),1,go)
					set go=$s(go:"Yes",1:"No")
					set grantedvia=$case(thisuser,user:"Direct","_PUBLIC":"Public",:"Role:"_thisuser)
					set ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb("ML CONFIGURATION",mlconfigname,"USE",grantedby,go,grantedvia,0)
				}
			}
		}
	}
	set sc = $$updateForeignServerIndex
	if $$$ISOK(sc) {
		set schemaUpper = ""
		for  {
			set schemaUpper = $o(^rINDEXSQL("SERVER", schemaUpper))
			quit:schemaUpper=""
			set serverUpper = ""
			for {
				set serverUpper = $o(^rINDEXSQL("SERVER", schemaUpper, serverUpper), 1, serverData) 
				quit:serverUpper=""
				set fullServerName = $lg(serverData, 4)_"."_$lg(serverData, 5), objectName = "7,"_fullServerName
				if su { 
					set ^IRIS.Temp(%q,$i(^IRIS.Temp(%q))) = $lb("FOREIGN SERVER",fullServerName,"USE",$$$SystemSuperUser,"Yes","SuperUser",0)
				} else {
					if $d($$$SecurityGlobalSQLPriv($namespace,0,objectName,"l")) {
						#; OK, we know the privilege exists, see if any of the users/roles in the user list are privileged
						set p=0 
						while $ListNext(ulist,p,thisuser) { 
							if $d($$$SecurityGlobalSQLPriv($namespace,0,objectName,"l",thisuser)) {
								set grantedby=$o($$$SecurityGlobalSQLPriv($namespace,0,objectName,"l",thisuser,""),1,go)
								set go=$s(go:"Yes",1:"No")
								set grantedvia=$case(thisuser,user:"Direct","_PUBLIC":"Public",:"Role:"_thisuser)
								set ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb("FOREIGN SERVER",fullServerName,"USE",grantedby,go,grantedvia,0)
							}
						}
					}
					if $d($$$SecurityGlobalSQLPriv($namespace,0,"5,"_schemaUpper,"l")) {
						#; OK, we know the privilege exists, see if any of the users/roles in the user list are privileged
						s p=0 While $ListNext(ulist,p,thisuser) { 
							If $d($$$SecurityGlobalSQLPriv($namespace,0,"5,"_schemaUpper,"l",thisuser)) {
								s grantedby=$o($$$SecurityGlobalSQLPriv($namespace,0,"5,"_schemaUpper,"l",thisuser,""),1,go)
								s go=$s(go:"Yes",1:"No")
								s grantedvia="Schema Privilege"
								//set:'colPrivs&&$$AnyColumnPriv(tinfo,thisuser) colPrivs=1
								s ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb("FOREIGN SERVER",fullServerName,"l",grantedby,go,grantedvia,0)
							}
						}
					}
					if '$$OwnerCheckUser(user,ulist,objectName,"l") {
						set ^IRIS.Temp(%q,$i(^IRIS.Temp(%q)))=$lb("FOREIGN SERVER",fullServerName,"USE",$$$SystemSuperUser,"Yes","Owner Privilege",0)
					}
				}
			}
		}
	} else {
		set $ze = "Error updating foreign server index"
		GOTO SQLUserPrivsExecuteError
	}
	RETURN $$$OK
SQLUserPrivsExecuteError
	s $zt="" k ^IRIS.Temp(%q) $$$RemoveTempNode(^IRIS.Temp(%q))
	QUIT $$$ERROR($$$ObjectScriptError,$ze)
}
.
AnyColumnPriv(tinfo,user) [] PRIVATE {
	$$$AddSecurityRoleTemporary
		#; Given the tinfo data for a table/view ("1,Sample.Person"), see if there are any column privileges granted 
		#; to any columns on this toable to the user/role specified in the user argument.
	set nextTab=$o($$$SecurityGlobalSQLPriv($namespace,0,tinfo))
		#; if nextTab="", there are no more tables
		#;   if nextTab does not start with "type,schema.table.", there is no column priv on this table at all
	QUIT:nextTab=""||($e(nextTab,1,$l(tinfo)+1)'=(tinfo_".")) 0
		#; Loop over all the column privileges that exist for this table/view.  See if any priv has been granted to the user/role for any column
	set colPriv=0	// Assume no privileges
	for priv="a","d","i","r","s","u" { if $d($$$SecurityGlobalSQLPriv($namespace,0,nextTab,priv,user)) { set colPriv=1 quit  } }
	QUIT:colPriv 1
		#; OK, we have checked the first column of the table, no column privilege found for this user.
		#; Try the rest of the columns for the table
	for  {
		set nextTab=$o($$$SecurityGlobalSQLPriv($namespace,0,nextTab))
		quit:nextTab=""||($e(nextTab,1,$l(tinfo)+1)'=(tinfo_"."))	// No more tables, or no more privileges on columns of this table
		for priv="a","d","i","r","s","u" { if $d($$$SecurityGlobalSQLPriv($namespace,0,nextTab,priv,user)) { set colPriv=1 quit  } }
	}
	QUIT colPriv
}
 
 
SQLUserColumnPrivsExecute(%q,schema,table,user,%p,%caller,system=0) [] PUBLIC {
		#;  %r(%q) = loop counter
		#;  %p(%q,%r(%q)) = ROWSPEC
		#;  NOTE:  The data goes into ^IRIS.Temp(%q,n), not into %p()
	s $zt="SQLUserColumnPrivsExecuteError"
	$$$AddSecurityRoleTemporary
	s su=$$$IsASuperUser(user),iamsu=$$$IAmSuperUser
		#;  Get real user/role name
	If $g(user)="" { }
	ElseIf $$$SecurityUsersExists($$$LOWER(user),data) { s user=$$$GetSecurityUsersName(data),type="user" }  // User???
	ElseIf $$$SecurityRolesExists($$$LOWER(user),data) { s user=$$$GetSecurityRolesName(data),type="role" }  // Role???
	Else { QUIT $$$OK }
	QUIT:user="" $$$OK
	if type'="role"	{ s ulist=$s(user'="_PUBLIC":$lb(user,"_PUBLIC"),1:$lb(user))_$zstl($$roleset(user,"user")) }
	else 		{ s ulist=$zstl($$roleset(user,"role")) }
 
		#;  If a user, don't let this user see privileges if not SuperUser and not the user themselves and they don't have USE permission on the %Admin_Secure resource
	i type="user",'iamsu,$$$aid'=user,'$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) s AtEnd=1 QUIT $$$OK
	s tdata=$g(^oddSQL(schema,table))
	if $e(schema)="%"||(schema="INFORMATION_SCHEMA") { set tIsASystemTable=1 } else { set tIsASystemTable=0 }
	Quit:tdata=""||((tIsASystemTable&&'system)) $$$OK	// Not a table OR (System table/view AND don't display system classes), skip it
	s tinfo=$lg(tdata,6)				// Type,Name
	s column=""
	For  {
		s cdata="",column=$o(^oddSQL(schema,table,11,column),1,cdata) q:column=""
		s cinfo=tinfo_"."_column
		For priv="i","r","s","u" {
			If su { s ^||%sql.sqlcat(%q,$i(^||%sql.sqlcat))=$lb(column,$p(",INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",priv)),$$$SystemSuperUser,"Yes","SuperUser") }
			ElseIf $d($$$SecurityGlobalSQLPriv($namespace,0,cinfo,priv)) {
				#; OK, we know the privilege exists, see if any of the users/roles in the user list are privileged
				s p=0 While $ListNext(ulist,p,thisuser) { 
					If $d($$$SecurityGlobalSQLPriv($namespace,0,cinfo,priv,thisuser)) {
						s grantedby=$o($$$SecurityGlobalSQLPriv($namespace,0,cinfo,priv,thisuser,""),1,go)
						s go=$s(go:"Yes",1:"No")
						s grantedvia=$case(thisuser,user:"Direct","_PUBLIC":"Public",:"Role:"_thisuser)
						s ^||%sql.sqlcat(%q,$i(^||%sql.sqlcat(%q)))=$lb(column,$p(",INSERT,REFERENCES,SELECT,UPDATE",",",$f("irsu",priv)),grantedby,go,grantedvia)
					}
				}
			}
		}
	}
	QUIT $$$OK
SQLUserColumnPrivsExecuteError
	s $zt="" k ^||%sql.sqlcat(%q)
	QUIT $$$ERROR($$$ObjectScriptError,$ze)
}
.
.
SQLUserRoleExecute(%q,user,%roles,%caller) [] PUBLIC {
		#;  %r(%q)     = Loop counter
		#;  %roles(%q,rolename) = admin-option
	s $zt="SQLUserRoleExecuteError" 
	$$$AddSecurityRoleTemporary
	i $g(user)'="",$$$SecurityUsersExists($$$LOWER(user),data) s user=$$$GetSecurityUsersName(data)
	s r="" f  s r=$o($$$SecurityGlobalSQLUserRole(user,r),1,d) q:r=""  s %roles(%q,$i(%roles(%q)))=$lb(r,''d)
	QUIT $$$OK
SQLUserRoleExecuteError
	s $zt="" QUIT $$$ERROR($$$ObjectScriptError,$ze)
}
.
SQLUserEscalationRoleExecute(%q,user,%roles,%caller) [] PUBLIC {
		#;  %r(%q)     = Loop counter
		#;  %roles(%q,counter) = $lb(rolename)
	s $zt="SQLUserEscalationRoleExecuteError" 
	$$$AddSecurityRoleTemporary
	i $g(user)'="",$$$SecurityUsersExists($$$LOWER(user),data){
		s sysroles = $$$GetSecurityUsersEscalationRoles(data)
		s i=0 while $listnext(sysroles,i,role) {
			i '$$$SecurityRolesExists(role,data1) continue
			set role = $$$GetSecurityRolesName(data1)
			s %roles(%q,$i(%roles(%q)))=$lb(role)
		}
	}
	QUIT $$$OK
SQLUserEscalationRoleExecuteError
	s $zt="" QUIT $$$ERROR($$$ObjectScriptError,$ze)
}
.
 
SQLUserSysPrivsExecute(%q,user,%p,%caller) [] PUBLIC {
		#;  %r(%q) = loop counter
		#;  %p(%q,%r(%q)) = ROWSPEC
		#; ROWSPEC = "PRIVILEGE:%Library.String,ADMIN_OPTION:%Library.String,GRANTED_VIA:%Library.String"
	s $zt="SQLUserSysPrivsExecuteError" 
	$$$AddSecurityRoleTemporary
		#;  Get real user/role name
	If $g(user)="" { }
	ElseIf $$$SecurityUsersExists($$$LOWER(user),data) { s user=$$$GetSecurityUsersName(data) }  // User???
	ElseIf $$$SecurityRolesExists($$$LOWER(user),data) { s user=$$$GetSecurityRolesName(data) }  // Role???
	QUIT:user="" $$$OK
	$$$GetSecuritySQLSysPrivData(user,priv,$namespace)
	$$$GetSecuritySQLSysPrivData("_public",pubpriv,$namespace)
	s plist=$$$AdminPrivsLB
	s sysuser=($$$IsASuperUser(user))
		#; build orders list of sys privs
	for i=1:1:$$$privcnt { set privName($lg(plist,i))=i }
	set privName=""
	for {
		set privName=$o(privName(privName),1,i) quit:privName=""
		if sysuser { set %p(%q,$i(%p(%q)))=$lb(privName,"Yes","SuperUser") }	// DPV2390
		elseif $lg(priv,i) { s %p(%q,$i(%p(%q)))=$lb(privName,$s($lg(priv,i)=2:"Yes",1:"No"),"Direct") }
		elseif $lg(pubpriv,i) { s %p(%q,$i(%p(%q)))=$lb(privName,$s($lg(pubpriv,i)=2:"Yes",1:"No"),"_PUBLIC") }
		else {	// Maybe granted to a Role
			set tRoleList=$$roleset(user)
			for j=1:1 {
				set r=$p(tRoleList,",",j) quit:r=""
				$$$GetSecuritySQLSysPrivData(r,data,$namespace) 
				if $lg(data,i) { set %p(%q,$i(%p(%q)))=$lb(privName,$s($lg(data,i)=2:"Yes",1:"No"),"Role - "_r) quit  }
			}
		}
	}
	RETURN $$$OK
SQLUserSysPrivsExecuteError
	set $zt=""
	RETURN $$$ERROR($$$ObjectScriptError,$ze)
}
 
 
UserRoleInfoExecute(%q,user,%users,%caller) [] PUBLIC {
		#;  %users(%q) = $lb(name,type)
	s $zt="UserRoleInfoExecuteError"
	$$$AddSecurityRoleTemporary
	If $g(user)="" { }
	Else { s %u(%q)="" i $$$SecurityUsersExists($$$LOWER(user),data) s %users(%q)=$lb($$$GetSecurityUsersName(data),"USER") }		// User
	If %u(%q)="",$$$SecurityRolesExists($$$LOWER(user),data) { s %users(%q)=$lb($$$GetSecurityRolesName(data),"ROLE") }		// or Role?
	QUIT $$$OK
UserRoleInfoExecuteError
	s $zt="" QUIT $$$ERROR($$$ObjectScriptError,$ze)
}
.
.
/// Builds qHandle("data",idx) = $lb(subjectName, subjectType, privilegeName, objectType, objectName, granted_by, has_grant_option, granted_via, has_column_priv)
/// 	subjectName 		:= name of user/role
///		subjectType 		:= USER or ROLE
///		privilegeName 		:= name of the SQL privilege assigned. Either object privilege (e.g. SELECT) or admin privilege (e.g. %CREATE_TABLE).
///		privilege_type		:= ADMIN or OBJECT
///		objectType 			:= TABLE/VIEW/PROCEDURE etc. based on what type of object the privilege applies to (null for admin privs)
///		objectName 			:= If an object privilege (e.g. SELECT), name of the object (e.g. table/view/procedure etc) that 
///								privilege applies to. Null for admin privs.
///		granted_by			:= The user that granted the privilege to the subjectName
///		has_grant_option	:= "Yes" or "No" if this use is able to grant this privilege to other uses
///		granted_via 		:= How the subject obtained the privilege (e.g. was assigned it directly (Direct), super user, role, schema privilege, owner privilege, _PUBLIC)
///		has_column_priv 	:= 1 if the object the privilege is granted on has column level privileges
///
///		The list includes info about this namespace for all the SQL privileges assigned to:
///		1) Current user, _public, and all roles assigned to current user
///		2) All users/roles, if current user has %All role or %Admin_Secure:USE resource
///
///		qHandle is passed ByRef from the class query that calls this so that it can be populated with the rows
///
///	Parameters:
///		objectFilter	- Optional, default=""; For object privileges, limit the objects returned. The default
///							value will return all objects according to the rules above that determine whether the
///							user is able to see certain privilege information. Offers limited wildcard support, where 
///							the filter may contain a suffix of '*' to imply every name sorted after the given prefix.
///							This filter may appear in the schema and/or the table name, and it may not contain a suffix
///							(sch*.tab* and sche*.* are valid; sch*ma.ta*le are not). Any object type that does not have
///							schemas will ignore the schema portion. Any filter that does not include a period separator
///							is interpreted as a schema wildcard. Any object for which the user is not privileged to view 
///							will be skipped.
///		privilegeType	- Optional, If 'ADMIN' only return ADMIN privileges (e.g. %CREATE_TABLE). If 'OBJECT' only return 
///							OBJECT privileges (e.g. SELECT on <table>). Anything else, return both types
///		system			- Optional, default=0; Whether to include system tables/views.
///
/// Returns a status value
SQLAllPrivilegesExecute(objectFilter="", privilegeType="", system=0, &qHandle) [] PUBLIC {
	set tSC = 1
	$$$AddSecurityRoleTemporary	
	try {
		set canSeeEveryone = ($$$IAmSuperUser || $SYSTEM.Security.Check($$$AdminSecureResourceName, $$$PermUseName))
		set callingUserRoles = $zstl($$roleset($$$aid, "user"))
		for type="ROLE","USER" {
			set subject = ""
			for {
				// subject = user OR role we are looking at
				set subject = $case(type, "USER":$o($$$SecurityGlobalUsers(subject),1,data), :$order($$$SecurityGlobalRoles(subject),1,data))
				QUIT:subject=""
				set subject = $case(type, "USER":$$$GetSecurityUsersName(data), "ROLE":$$$GetSecurityRolesName(data))
				if 'canSeeEveryone, type="USER", subject'=$$$aid, subject'=$$$PUBLICUsername { // if not called by super user, only show privs for this user and _PUBLIC
					CONTINUE
				} elseif 'canSeeEveryone, type="ROLE", '$listfind(callingUserRoles,subject) { // if not called by super user, only show privs for this user's roles
					CONTINUE
				}
				set privilegeType = $$$UPPER($zstrip(privilegeType,"<>W"))
				set (includeObjectPrivs, includeAdminPrivs) = 1
				if privilegeType = "ADMIN" {
					set includeObjectPrivs = 0
				} elseif privilegeType = "OBJECT" {
					set includeAdminPrivs = 0
				}
				do:includeAdminPrivs getAllAdminPrivsForSubject(.qHandle, type, subject, 0)
				do:includeObjectPrivs getAllObjectPrivsForSubject(.qHandle, type, subject, 0, objectFilter, system)
			}
		}
	} catch ex {
		set tSC = ex.AsStatus()
	}
	RETURN tSC
}
.
.
/// Helper for SQLAllPrivilegesExecute(), which will populate the qHandle() multidimensional array with admin/sys SQL 
/// privs for the given 'subject'. See SQLAllPrivilegesExecute() for description of the qHandle structure.
///
///	Parameters:
///		qHandle				- (PBR) multidimensional array for the results
///		type 				- 'USER' or 'ROLE'. The type of subject we are looking at
///		subject				- The user or role name
///		checkIfPermitted	- 1/0, check whether the current user can see the privs for given subject.
getAllAdminPrivsForSubject(&qHandle, type, subject, checkIfPermitted=1) [] PRIVATE {
	RETURN:subject=""
	if checkIfPermitted {
		set canSeeEveryone = ($$$IAmSuperUser || $SYSTEM.Security.Check($$$AdminSecureResourceName, $$$PermUseName))
		if 'canSeeEveryone, type="USER", subject'=$$$aid, subject'=$$$PUBLICUsername { // if not called by super user, only show privs for this user and _PUBLIC
			RETURN
		} elseif 'canSeeEveryone, type="ROLE", '$listfind($zstl($$roleset($$$aid, "user")),subject) { // if not called by super user, only show privs for this user's roles
			RETURN
		}
	}
	if $case(type, "USER": $$$IsASuperUser(subject), :0) {		// super users have them all
		for i=1:1:$$$privcnt {
			set qHandle("data",$i(qHandle)) = $lb(subject,type,$lg($$$AdminPrivsLB, i),"ADMIN","","","","Yes",$$$SuperUserUsername,"")
		} 
	}
	// do all the subjects (Direct, Public, roles) separate so that we only have to get each admin privs list from
	// the global node once. We for SQLAllPrivileges() we return all the modes they might have these privs so don't
	// break the loop in the middle
	set subjectList = $case(type, "USER": $lb(subject, "_PUBLIC"), :"")_$zstl($$roleset(subject,type))
	set ptr = 0
	while $listnext(subjectList,ptr,subjectListItem) {
		$$$GetSecuritySQLSysPrivData(subjectListItem,adminPrivs,$namespace)
		set grantedVia = $case(subjectListItem, subject:"Direct", $$$PUBLICUsername: "Public", :"Role:"_subjectListItem)
		for i=1:1:$$$privcnt {
			if $lg(adminPrivs,i) { 
				set hasAdminOption=($lg(adminPrivs,i)=2)
				set qHandle("data",$i(qHandle)) = $lb(subject,type,$lg($$$AdminPrivsLB, i),"ADMIN","","","",$s(hasAdminOption:"Yes",1:"No"),grantedVia,"")
			}
		}
	}
	
	RETURN
}
.
.
/// Helper for SQLAllPrivilegesExecute(), which will populate the qHandle() multidimensional array with object SQL privs
/// for the given 'subject'. See SQLAllPrivilegesExecute() for description of the qHandle structure.
///
///	Parameters:
///		qHandle				- (PBR) multidimensional array for the results
///		type 				- 'USER' or 'ROLE'. The type of subject we are looking at
///		subject				- The user or role name to get the privileges of
///		checkIfPermitted	- 1/0, whether to check that the current calling user can see the privs for given subject
///		objectFilter		- String to filter object names with limited wildcard support. See SQLAllPrivilegesExecute() for information
///		system				- 1/0, whether to return system tables/views
getAllObjectPrivsForSubject(&qHandle, type, subject, checkIfPermitted=1, objectFilter="", system=0) [] PRIVATE {
	RETURN:subject=""
	set type = $$$UPPER(type)
	if checkIfPermitted {
		set canSeeEveryone = ($$$IAmSuperUser || $SYSTEM.Security.Check($$$AdminSecureResourceName, $$$PermUseName))
		if 'canSeeEveryone, type="USER", subject'=$$$aid, subject'=$$$PUBLICUsername { // if not called by super user, only show privs for this user and _PUBLIC
			RETURN
		} elseif 'canSeeEveryone, type="ROLE", '$listfind($zstl($$roleset($$$aid, "user")),subject) { // if not called by super user, only show privs for this user's roles
			RETURN
		}
	}
	// Have to check every potential source of the priv, so create a list that contains every route through which the 
	// current subject could have received an object priv. I.e. create a list of the subject itself, any roles they have, 
	// and _PUBLIC (everyone can gets what _PUBLIC has)
	if type="USER", subject'=$$$PUBLICUsername {
		set subjectList = $lb(subject,$$$PUBLICUsername)
	} else {	// ROLE
		set subjectList = ""	// $$roleset below will include the role itself for roles
	}
	set subjectList = subjectList_$zstl($$roleset(subject,type)) 
	// Resolve the filter passed in for potential schema filtering
	set:objectFilter=$c(0) objectFilter = "*"	// if user invoked like SQLAllPrivileges('')
	set objectFilter = $$$UPPER(objectFilter)
	set schemaFilter = $p(objectFilter, ".", 1)
	set:schemaFilter="" schemaFilter = "*"
	do resolveWildcardFilterForLooping(schemaFilter, "^rINDEXSQL(""schema"")", .schema, .schemaPrefix, .exactWildcardMatch)
	set prefixLength = $l(schemaPrefix)
		// or view filter, or server filter...the non-schema portion
	set tableFilter = $p(objectFilter, ".", 2)
	set:tableFilter="" tableFilter = "*"
	for  {	// all the objects based on schema in this loop
		set schema = $$GetNextSubscript("^rINDEXSQL(""schema"")", schema)
		QUIT:schema=""||($e(schema,1,prefixLength) '= schemaPrefix)
		QUIT:exactWildcardMatch&&(schema'=schemaFilter)
		CONTINUE:(($e(schema)="%" || (schema="INFORMATION_SCHEMA"))&&'system)
.
		do getAllTableViewPrivsBySchemaForSubject(.qHandle, type, subject, subjectList, schema, tableFilter)
		do getAllProcedurePrivsBySchemaForSubject(.qHandle, type, subject, subjectList, schema, tableFilter)
		do getAllForeignServerPrivsBySchemaForSubject(.qHandle, type, subject, subjectList, schema, tableFilter)
	}
	do getAllMLConfigPrivsForSubject(.qHandle, type, subject, subjectList, system)	// do not have a schema
	
}
.
.
/// Given some (potential wildcard) filter from logic used by SQLAllPrivilegesExecute(), return by reference the value
/// to use as initial input to a $o loop over the target global, along with the prefix of the wildcard
resolveWildcardFilterForLooping(filter="", targetGlobal, &loopInit, &prefix, &exactMatch) [] PRIVATE {
	set:filter="" filter = "*"
	set exactMatch = 0
	try {	// prevent <PROTECT>
		if $d(@targetGlobal@(filter)) {		// Exact match overrides wildcard, handle here
			set loopInit = $$GetNextSubscript(targetGlobal, filter, -1)	// go back one step from the whole filter
			set prefix = filter	// allows for easy exit after one loop that will match other exit condition
			set exactMatch = 1
			RETURN
		}
	} catch {}
	// resolve the wildcard
	set prefix = $p(filter, "*", 1)	// ignore any suffix
	if prefix = "" {
		set loopInit = ""
	} else {
		set loopInit = $$GetNextSubscript(targetGlobal, prefix, -1)	// go back one level to start looping
	}
}
.
/// Caller should check that the current user is privileged for this operation or this logic should change
///
/// Parameters:
///		qHandle			- (PBR) mutldimensional array to return info in. See SQLAllPrivilegesExecute() for structure
///		type			- 'USER' or 'ROLE'. The type of subject we are looking at
///		subject			- The subject we are looking at
///		subjectList		- The list of all roles/usernames that we are checking for. This represents the list of all sources
///							from which the subject could derive privileges
///		schema			- The schema for which to check all tables/views in
///		tableFilter		- (optional) String, potentially containing * wildcard, to limit the objects to return. See
///							SQLAllPrivilegesExecute() for more information
getAllTableViewPrivsBySchemaForSubject(&qHandle, type="USER", subject="", subjectList="", schema="", tableFilter="") [] PRIVATE {
	RETURN:schema=""||(subject="")
	set type = $$$UPPER(type)
	set lookingAtSuperUser = $case(type, "USER": $$$IsASuperUser(subject), :0)
	set tableFilter = $$$UPPER(tableFilter)
	do resolveWildcardFilterForLooping(tableFilter, "^rINDEXSQL(""rv"","""_schema_""")", .table, .tablePrefix, .exactWildcardMatch)
	set prefixLength = $l(tablePrefix)
	for {
		set data=""	// reset
		set table=$o(^rINDEXSQL("rv",schema,table),1,data) 	// initial table looping var set by resolveWildcard() above
		QUIT:(table=""||($e(table,1,prefixLength) '= tablePrefix))
		QUIT:exactWildcardMatch&&(table'=tableFilter)	// if filter was an exact match then stop once we've past that object
		CONTINUE:data="" // Not a table
		set objectName = $lg(data,4)
		set objectTypeAndName = +$lg(data,3)_","_objectName // has the format "ObjectType,Name" e.g. "1,SQLUser.t1". Tables type 1, views type 3
		set objectType = $s(+objectTypeAndName=1:"TABLE",+objectTypeAndName=3:"VIEW",1:"???")
			// See if this table has any column level privileges
		set colPrivs=0, hadTablePrivs=0
		for i=1:1:$l($$$actionLetters) {
			set actionLetter = $e($$$actionLetters,i)
			set privName = $$$getActionName(actionLetter)
			if lookingAtSuperUser {
				set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, "OBJECT", objectType, objectName, $$$SystemSuperUser, "Yes", $$$SuperUserUsername, 0)
				set hadTablePrivs=1
			}
			if $d($$$SecurityGlobalSQLPriv($namespace,0,objectTypeAndName,actionLetter)) {	// know the privilege exists, see if any of the users/roles in the subject list are privileged
				set ptr = 0
				while $listnext(subjectList, ptr, subjectListItem) {  // subjectListItem != user always! could be role
					if $d($$$SecurityGlobalSQLPriv($namespace,0,objectTypeAndName,actionLetter,subjectListItem)) {
						set grantor = "", hasGrantOption=0, grantedBy = ""
						for {
							set grantor = $o($$$SecurityGlobalSQLPriv($namespace,0,objectTypeAndName,actionLetter,subjectListItem,grantor), 1, oneGrantOption)
							QUIT:grantor=""
							set grantedBy = grantedBy_$lb(grantor)
							set:'hasGrantOption hasGrantOption = oneGrantOption
						}
						set hasGrantOption = $s(hasGrantOption:"Yes", 1:"No")
						set grantedVia = $case(subjectListItem,  subject: "Direct",  $$$PUBLICUsername: "Public",  : "Role:"_subjectListItem)
						set colPrivs = $$AnyColumnPriv(objectTypeAndName,subjectListItem)
						set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, "OBJECT", objectType, objectName, grantedBy, hasGrantOption, grantedVia, colPrivs)
						set hadTablePrivs=1
					}
				}
			}
			set schemaTypeAndName = "5,"_$$$UPPER(schema)
			if $d($$$SecurityGlobalSQLPriv($namespace,0,schemaTypeAndName,actionLetter)) {	// privs on this object because there are schema level privileges
				set ptr = 0 
				while $listnext(subjectList,ptr,subjectListItem) { 
					if $d($$$SecurityGlobalSQLPriv($namespace,0,schemaTypeAndName,actionLetter,subjectListItem)) {
						set grantor="", hasGrantOption=0, grantedBy=""
						for {
							set grantor = $o($$$SecurityGlobalSQLPriv($namespace,0,schemaTypeAndName,actionLetter,subjectListItem,grantor),1,oneGrantOption)
							QUIT:grantor=""
							set grantedBy = grantedBy_$lb(grantor)
							set:'hasGrantOption hasGrantOption = oneGrantOption
						}
						set hasGrantOption = $s(hasGrantOption:"Yes", 1:"No")
						set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, "OBJECT", objectType, objectName, grantedBy, hasGrantOption, "Schema Privilege", 0)
						set hadTablePrivs = 1
					}
				}
			}
				// User could have implicit privileges because they own the object
				// ** OwnerCheckUser returns 0 if subject *is* the owner ** 	(thumbs down emoji)
			if (+objectTypeAndName=1 || (+objectTypeAndName=3 && ( "as"[actionLetter ))) && (type = "USER") && '$$OwnerCheckUser(subject,subjectList,objectTypeAndName,actionLetter) {
				set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, "OBJECT", objectType, objectName, $$$SystemSuperUser, "Yes", "Owner Privilege", 0)
				set hadTablePrivs = 1
			}
		}
		if 'hadTablePrivs {		// no table privileges, but might be column privileges
			set ptr = 0
			while $listnext(subjectList,ptr,subjectListItem) {
				if $$AnyColumnPriv(objectTypeAndName,subjectListItem) {
					set grantedVia = $case(subjectListItem, subject: "Direct",  "_PUBLIC": "Public",  : "Role:"_subjectListItem)
					set qHandle("data",$i(qHandle)) = $lb(subject, type, "", "OBJECT", objectType, objectName, "", "", grantedVia, 1)
					QUIT
				}
			}
		}
	}
}
.
.
/// Caller should check that the current user is privileged for this operation or this logic should change. Helper for
/// getAllObjectPrivsForSubject() to get procedure privileges
///
/// Parameters:
///		qHandle			- (PBR) mutldimensional array to return info in. See SQLAllPrivilegesExecute() for structure
///		type			- 'USER' or 'ROLE'. The type of subject we are looking at
///		subject			- The subject we are looking at
///		subjectList		- The list of all roles/usernames that we are checking for. This represents the list of all sources
///							from which the subject could derive privileges
///		schema			- The schema for which to check all procedures in
///		procedureFilter	- (optional) String, potentially containing * wildcard, to limit the objects to return. See
///							SQLAllPrivilegesExecute() for more information
getAllProcedurePrivsBySchemaForSubject(&qHandle, type="USER", subject="", subjectList="", schema="", procedureFilter="") [] PRIVATE {
	RETURN:schema=""||(subject="")
	set type = $$$UPPER(type)
	set lookingAtSuperUser = $case(type, "USER": $$$IsASuperUser(subject), :0)
	set privName = "EXECUTE"
	set privType = "OBJECT"
	set objectType = "STORED PROCEDURE"
	set SCHEMA=$$$UPPER(schema)
	set procedureFilter = $$$UPPER(procedureFilter)
	do resolveWildcardFilterForLooping(procedureFilter, "^oddPROC("""_SCHEMA_""")", .procedure, .procedurePrefix, .exactWildcardMatch)
	set prefixLength = $l(procedurePrefix)
	for  {
		set procedure=$o(^oddPROC(SCHEMA,procedure)) 	// initial procedure looping var set by resolveWildcard() above
		QUIT:(procedure=""||($e(procedure,1,prefixLength) '= procedurePrefix))
		QUIT:exactWildcardMatch&&(procedure'=procedureFilter)	// if filter was an exact match then stop once we've past that object
		CONTINUE:$g($$$PROCtype($$$pPROC,SCHEMA,procedure))=$$$cPROCTYPEUDAF
		CONTINUE:'$g($$$PROCprojected($$$pPROC,SCHEMA,procedure))	// Is this procedure projected to SQL?  Might not be if it is from a class query
		set schemaExact = $$$PROCschema($$$pPROC,SCHEMA,procedure)
		set fullNameExact = $$$BuildIQN(schemaExact,$$$PROCname($$$pPROC,SCHEMA,procedure))
		if lookingAtSuperUser { 
			set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, privType, objectType, fullNameExact, $$$SystemSuperUser, 1, $$$SuperUserUsername, 0)
		}
		set objectTypeAndName="9,"_fullNameExact
		if $d($$$SecurityGlobalSQLPriv($namespace,0,objectTypeAndName,"e")) {
			set ptr = 0 
			while $listnext(subjectList,ptr,subjectListItem) {
				if $d($$$SecurityGlobalSQLPriv($namespace,0,objectTypeAndName,"e",subjectListItem)) {
					set grantor="", hasGrantOption=0, grantedBy=""
					for {
						set grantor = $o($$$SecurityGlobalSQLPriv($namespace,0,objectTypeAndName,"e",subjectListItem,grantor), 1, oneGrantOption)
						QUIT:grantor=""
						set grantedBy = grantedBy_$lb(grantor)
						set:'hasGrantOption hasGrantOption = oneGrantOption
					}
					set hasGrantOption = $s(hasGrantOption:"Yes", 1:"No")
					set grantedVia = $case(subjectListItem,  subject: "Direct",  $$$PUBLICUsername: "Public",  : "Role:"_subjectListItem)
					set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, privType, objectType, fullNameExact, grantedBy, hasGrantOption, grantedVia, 0)
				}
			}
		}
		set schemaTypeAndName = "5,"_SCHEMA
		if $d($$$SecurityGlobalSQLPriv($namespace,0,schemaTypeAndName,"e")) {
			set ptr = 0 
			while $listnext(subjectList,ptr,subjectListItem) {
				if $d($$$SecurityGlobalSQLPriv($namespace,0,schemaTypeAndName,"e",subjectListItem)) {
					set grantor="", hasGrantOption=0, grantedBy=""
					for {
						set grantor = $o($$$SecurityGlobalSQLPriv($namespace,0,schemaTypeAndName,"e",subjectListItem,grantor),1,oneGrantOption)
						QUIT:grantor=""
						set grantedBy = grantedBy_$lb(grantor)
						set:'hasGrantOption hasGrantOption = oneGrantOption
					}
					set hasGrantOption = $s(hasGrantOption:"Yes", 1:"No")
					set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, privType, objectType, fullNameExact, grantedBy, hasGrantOption, grantedVia, 0)
				}
			}
		}
		// $$OwnerCheckUser returns 0 for "is owner"
		if type="USER", '$$OwnerCheckUser(subject,subjectList,objectTypeAndName,"e") {
			set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, privType, objectType, fullNameExact, $$$SystemSuperUser, "Yes", "Owner Privilege", 0)
		}
	}
	RETURN
}
.
.
/// Caller should check that the current user is privileged for this operation or this logic should change. Helper for
/// getAllObjectPrivsForSubject() to get foreign server privileges
///
/// Parameters:
///		qHandle			- (PBR) mutldimensional array to return info in. See SQLAllPrivilegesExecute() for structure
///		type			- 'USER' or 'ROLE'. The type of subject we are looking at
///		subject			- The subject we are looking at
///		subjectList		- The list of all roles/usernames that we are checking for. This represents the list of all sources
///							from which the subject could derive privileges
///		schema			- the schema to search within
///		serverFilter	- See SQLAllPrivilegesExecute()
getAllForeignServerPrivsBySchemaForSubject(&qHandle, type="USER", subject="", subjectList="", schema="", serverFilter="") [] PRIVATE {
	RETURN:subject=""
	set type = $$$UPPER(type)
	set lookingAtSuperUser = $case(type, "USER": $$$IsASuperUser(subject), :0)
	set privName = "USE"
	set privType = "OBJECT"
	set objectType = "FOREIGN SERVER"
	do updateForeignServerIndex
	set schemaUpper = $$$UPPER(schema)
	set serverFilter = $$$UPPER(serverFilter)
	do resolveWildcardFilterForLooping(serverFilter, "^rINDEXSQL(""SERVER"","""_schemaUpper_""")", .serverUpper, .serverPrefix, .exactWildcardMatch)
	set prefixLength = $l(serverPrefix)
	set serverUpper = ""
	for {
		set serverUpper = $o(^rINDEXSQL("SERVER", schemaUpper, serverUpper), 1, serverData) 
		QUIT:(serverUpper=""||($e(serverUpper,1,prefixLength) '= serverPrefix))
		QUIT:exactWildcardMatch&&(serverUpper'=serverFilter)
		set fullServerName = $lg(serverData, 4)_"."_$lg(serverData, 5)
		set objectTypeAndName = "7,"_fullServerName
		if lookingAtSuperUser {
			set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, privType, objectType, fullServerName, $$$SystemSuperUser, "Yes", $$$SuperUserUsername, 0)
		}
		if $d($$$SecurityGlobalSQLPriv($namespace,0,objectTypeAndName,"l")) {
			set ptr=0 
			while $listnext(subjectList,ptr,subjectListItem) { 
				if $d($$$SecurityGlobalSQLPriv($namespace,0,objectTypeAndName,"l",subjectListItem)) {
					set grantor="", hasGrantOption=0, grantedBy=""
					for {
						set grantor = $o($$$SecurityGlobalSQLPriv($namespace,0,objectTypeAndName,"l",subjectListItem,grantor), 1, oneGrantOption)
						QUIT:grantor=""
						set grantedBy = grantedBy_$lb(grantor)
						set:'hasGrantOption hasGrantOption = oneGrantOption
					}
					set hasGrantOption = $s(hasGrantOption:"Yes",1:"No")
					set grantedVia = $case(subjectListItem,  subject:"Direct",  "_PUBLIC":"Public",  :"Role:"_subjectListItem)
					set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, privType, objectType, fullServerName, grantedBy, hasGrantOption, grantedVia, 0)
				}
			}
		}
		set schemaTypeAndName = "5,"_schemaUpper
		if $d($$$SecurityGlobalSQLPriv($namespace,0,schemaTypeAndName,"l")) {
			set ptr=0 
			while $listnext(subjectList,ptr,subjectListItem) { 
				If $d($$$SecurityGlobalSQLPriv($namespace,0,schemaTypeAndName,"l",subjectListItem)) {
					set grantor="", hasGrantOption=0, grantedBy=""
					for {
						set grantor = $o($$$SecurityGlobalSQLPriv($namespace,0,schemaTypeAndName,"l",subjectListItem,grantor), 1, oneGrantOption)
						QUIT:grantor=""
						set grantedBy = grantedBy_$lb(grantor)
						set:'hasGrantOption hasGrantOption = oneGrantOption
					}
					set hasGrantOption = $s(hasGrantOption:"Yes",1:"No")
					set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, privType, objectType, fullServerName, grantedBy, hasGrantOption, "Schema Privilege", 0)
				}
			}
		}
		// $$OwnerCheckUser returns 0 for "is owner"
		if type = "USER", '$$OwnerCheckUser(subject,subjectList,objectTypeAndName,"l") {
			set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, privType, objectType, fullServerName, $$$SystemSuperUser, "Yes", "Owner Privilege", 0)
		}
	}
	RETURN
}
.
.
/// Caller should check that the current user is privileged for this operation or this logic should change. Helper for
/// getAllObjectPrivsForSubject() to get ML Config object privileges
///
/// Parameters:
///		qHandle			- (PBR) mutldimensional array to return info in. See SQLAllPrivilegesExecute() for structure
///		type			- 'USER' or 'ROLE'. The type of subject we are looking at
///		subject			- The subject we are looking at
///		subjectList		- The list of all roles/usernames that we are checking for. This represents the list of all sources
///							from which the subject could derive privileges
///		system			- 1/0 whether to return system procedure information
getAllMLConfigPrivsForSubject(&qHandle, type="USER", subject="", subjectList="", system=0) [] PRIVATE {
	RETURN:subject=""
	set type = $$$UPPER(type)
	set lookingAtSuperUser = $case(type, "USER": $$$IsASuperUser(subject), :0)
	set objectType = "ML CONFIGURATION"
	set privName = "USE"
	set privType = "OBJECT"
	set mlconfig = ""
	for  {
		set mlconfig=$o(^%SYS("ml","configuration","d",mlconfig),1,mldata) 
		QUIT:mlconfig=""
		set mlConfigName=$lg(mldata,2)
		if lookingAtSuperUser { 
			set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, privType, objectType, mlConfigName, $$$SystemSuperUser, "Yes", $$$SuperUserUsername, 0)
		}
		set objectTypeAndName="6,"_$$$UPPER(mlConfigName)
		if $d($$$SecurityGlobalSQLPriv($namespace,0,objectTypeAndName,"l")) {
			set ptr = 0
			while $listnext(subjectList,ptr,subjectListItem) {
				if $d($$$SecurityGlobalSQLPriv($namespace,0,objectTypeAndName,"l",subjectListItem)) {
					set grantor="", hasGrantOption=0, grantedBy=""
					for {
						set grantor = $o($$$SecurityGlobalSQLPriv($namespace,0,objectTypeAndName,"l",subjectListItem,grantor), 1, oneGrantOption)
						QUIT:grantor=""
						set grantedBy = grantedBy_$lb(grantor)
						set:'hasGrantOption hasGrantOption = oneGrantOption
					}
					set hasGrantOption = $s(hasGrantOption:"Yes",1:"No")
					set grantedVia = $case(subjectListItem,  subject:"Direct",  "_PUBLIC":"Public",  :"Role:"_subjectListItem)
					set qHandle("data",$i(qHandle)) = $lb(subject, type, privName, privType, objectType, mlConfigName, grantedBy, hasGrantOption, grantedVia, 0)
				}
			}
		}
	}
	RETURN
}
 
TPExecute(qh,name,schema,%caller="") [] PUBLIC {
	s $zt="TPExecuteError"
	$$$AddSecurityRoleTemporary
	s su=($$$IAmSuperUser)
	s ulist=$lb($Username,"_PUBLIC")_$zstl($Roles)	// DPV2883
	s:name="" name="%" s TablePattern=$zcvt(##class(%ODBCCatalog).MakePat(name,"\"),"U")
	s:$g(schema)="" schema="%" s SchemaPattern=$zcvt(##class(%ODBCCatalog).MakePat(schema,"\"),"U")
	set schema=$e("&",$namespace'="%SYS") 
	for  {	// DPV2861
		set schema=$$GetNextSubscript("^oddSQL",schema) quit:schema=""
		continue:$$$UPPER(schema)'?@SchemaPattern
		continue:$$$IsAShardLocalSchema(schema)
		set table=""
		for {
			// if we get here they had privileges on ^oddSQL(schema) so we don't need $$GetNextSubscript again
			s data="",table=$o(^oddSQL(schema,table),1,data) q:table=""  continue:data=""||($$$UPPER(table)'?@TablePattern)
			s tinfo=$li(data,6),SCHEMA=$$$UPPER(schema),TABLE=$$$UPPER(table)
			set extentname=$$$GetExtentNameFromTableName(schema,table)
			set tabinfo=$$$EXTsqlinfo($$$rEXT,extentname)
			set owner=$$$UPPER($$$SQLLocTableOwner(tabinfo))
			//i 'su continue:tinfo=""||('$d($$$SecurityGlobalSQLPriv($namespace,0,tinfo)))
			if su || (tinfo'="" && $d($$$SecurityGlobalSQLPriv($namespace,0,tinfo)) ) {
				For priv="a","d","i","r","s","u" {
					If su { s ^||%sql.cattp(qh,SCHEMA,TABLE,priv,$$$SystemSuperUser,$i(^||%sql.cattp(qh,SCHEMA,TABLE,priv,$$$SystemSuperUser)))=$lb("",schema,table,$$$SystemSuperUser,$$$SystemSuperUser,$P(",ALTER,DELETE,INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",priv)),"YES") }
					continue:'$d($$$SecurityGlobalSQLPriv($namespace,0,tinfo,priv))
					s grantee="" For  {
						s grantee=$o($$$SecurityGlobalSQLPriv($namespace,0,tinfo,priv,grantee)) q:grantee=""
						s grantor="" For  {
							s grantor=$o($$$SecurityGlobalSQLPriv($namespace,0,tinfo,priv,grantee,grantor),1,go) q:grantor=""
							continue:grantee'=$$$aid&&('$lf(ulist,grantee))&&(grantor'=$$$aid)    // DPV2883	// DPV3991
							s GRANTEE=$$$UPPER(grantee)
							s ^||%sql.cattp(qh,SCHEMA,TABLE,priv,GRANTEE,$i(^||%sql.cattp(qh,SCHEMA,TABLE,priv,GRANTEE)))=$lb("",schema,table,$s(%caller="%Library.ODBCCatalog::tpExecute"&&($$$UPPER(grantee)=owner):$$$SystemSuperUser,1:grantor),grantee,$P(",ALTER,DELETE,INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",priv)),$s(go:"YES",1:"NO"))
						}
					}
				}
			}
			if 'su,tinfo'="" {
				s obj=tinfo_"." k tp
				for  {
					s obj=$o($$$SecurityGlobalSQLPriv($namespace,0,obj)) q:obj=""  q:$e(obj,1,$l(tinfo_"."))'=(tinfo_".")
					for priv="a","d","i","r","s","u" {
						continue:'$d($$$SecurityGlobalSQLPriv($namespace,0,obj,priv))
						s grantee="" For  {
							s grantee=$o($$$SecurityGlobalSQLPriv($namespace,0,obj,priv,grantee)) q:grantee=""
							s grantor="" For  {
								s grantor=$o($$$SecurityGlobalSQLPriv($namespace,0,obj,priv,grantee,grantor),1,go) q:grantor=""
								continue:grantee'=$$$aid&&('$lf(ulist,grantee))&&(grantor'=$$$aid)    // DPV2883	// DPV3991
								s tp(schema,table,$s(%caller="%Library.ODBCCatalog::tpExecute"&&($$$UPPER(grantee)=owner):$$$SystemSuperUser,1:grantor),grantee,priv,go)=""
							}
						}
					}
				}
				s o="" f  s o=$o(tp(o)) q:o=""  s t="" f  s t=$o(tp(o,t)) q:t=""  s go="" f  s go=$o(tp(o,t,go)) q:go=""  s ge="" f  s ge=$o(tp(o,t,go,ge)) q:ge=""  s p="" f  s p=$o(tp(o,t,go,ge,p)) q:p=""  s ^||%sql.cattp(qh,$$$UPPER(o),$$$UPPER(t),p,$$$UPPER(ge),$i(^||%sql.cattp(qh,$$$UPPER(o),$$$UPPER(t),p,$$$UPPER(ge))))=$lb("",o,t,go,ge,$P(",ALTER,DELETE,INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",p)),$s($d(tp(o,t,go,ge,p,1)):"YES",1:"NO"))
			}
				#; Now see if the user is privileged at the schema level
			if 'su,tinfo'="" {
				s obj="5,"_SCHEMA kill tp
				for priv="a","d","i","r","s","u" {
					continue:'$d($$$SecurityGlobalSQLPriv($namespace,0,obj,priv))
					set grantee=""
					for  {
						set grantee=$o($$$SecurityGlobalSQLPriv($namespace,0,obj,priv,grantee)) quit:grantee=""
						set grantor=""
						for  {
							set grantor=$o($$$SecurityGlobalSQLPriv($namespace,0,obj,priv,grantee,grantor),1,go) quit:grantor=""
							continue:grantee'=$$$aid&&('$lf(ulist,grantee))&&(grantor'=$$$aid)    // DPV2883	// DPV3991
							set tp(schema,table,$s(%caller="%Library.ODBCCatalog::tpExecute"&&($$$UPPER(grantee)=owner):$$$SystemSuperUser,1:grantor),grantee,priv,go)=""
						}
					}
				}
				s s="" f  s s=$o(tp(s)) q:s=""  s t="" f  s t=$o(tp(s,t)) q:t=""  s go="" f  s go=$o(tp(s,t,go)) q:go=""  s ge="" f  s ge=$o(tp(s,t,go,ge)) q:ge=""  s p="" f  s p=$o(tp(s,t,go,ge,p)) q:p=""  s ^||%sql.cattp(qh,$$$UPPER(s),$$$UPPER(t),p,$$$UPPER(ge),$i(^||%sql.cattp(qh,$$$UPPER(s),$$$UPPER(t),p,$$$UPPER(ge))))=$lb("",s,t,go,ge,$P(",ALTER,DELETE,INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",p)),$s($d(tp(s,t,go,ge,p,1)):"YES",1:"NO"))
			}
				#; Make sure if the owner of the table is in ulist, that we report the owner has all privileges
			if $$$UPPER($username)=owner {
				for priv="a","d","i","r","s","u" {
					if 1||'$d(^||%sql.cattp(qh,SCHEMA,TABLE,priv,owner)) {
						set ^||%sql.cattp(qh,SCHEMA,TABLE,priv,owner,$i(^||%sql.cattp(qh,SCHEMA,TABLE,priv,owner)))=$lb("",schema,table,$$$SystemSuperUser,owner,$P(",ALTER,DELETE,INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",priv)),"YES")
					}
				}
			}
			
.
		}
	}
	QUIT $$$OK
TPExecuteError
	s $zt="" k ^||%sql.cattp(qh) QUIT $$$ERROR($$$ObjectScriptError,$ze)
}
 
CPExecute(qh,schema,table,column,%caller) [] PUBLIC {
	s $zt="CPExecuteError"
	$$$AddSecurityRoleTemporary
	s su=($$$IAmSuperUser)
	s ulist=$lb($Username,"_PUBLIC")_$zstl($Roles)
	s:column="" column="%" s ColumnPattern=$zcvt(##class(%ODBCCatalog).MakePat(column,"\"),"U")
	s data=$g(^oddSQL(schema,table)) QUIT:data="" $$$OK
	s tinfo=$li(data,6),col="",SCHEMA=$$$UPPER(schema),TABLE=$$$UPPER(table)
	for  {
		s col=$$GetNextSubscript("^oddSQL("""_schema_""","""_table_""",8)",col,1,.data) q:col=""
		s colname=$li(data,4),COLNAME=$$$UPPER(colname)
		continue:$zcvt(colname,"U")'?@ColumnPattern 		// Not correct column
		For priv="a","d","i","r","s","u" {
			if su {
				set ^||%sql.catcp(qh,SCHEMA,TABLE,COLNAME,priv,$i(^||%sql.catcp(qh,SCHEMA,TABLE,COLNAME,priv)))=$lb("",schema,table,colname,$$$SystemSuperUser,$$$SystemSuperUser,$P(",ALTER,DELETE,INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",priv)),"YES")
				continue
			}
			set schemaObj="5,"_SCHEMA
			if $d($$$SecurityGlobalSQLPriv($namespace,0,schemaObj,priv)) {	// priv at the schema level
				set grantee=""
				for  {
					set grantee=$o($$$SecurityGlobalSQLPriv($namespace,0,schemaObj,priv,grantee)) quit:grantee=""
					set grantor="" 
					for  {
						set grantor=$o($$$SecurityGlobalSQLPriv($namespace,0,schemaObj,priv,grantee,grantor),1,go) quit:grantor=""
						continue:grantee'=$$$aid&&('$lf(ulist,grantee))&&(grantor'=$$$aid)    // DPV2883	// DPV3991
						set ^||%sql.catcp(qh,SCHEMA,TABLE,COLNAME,priv,$i(^||%sql.catcp(qh,SCHEMA,TABLE,COLNAME,priv)))=$lb("",schema,table,colname,grantor,grantee,$P(",ALTER,DELETE,INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",priv)),$s(go:"YES",1:"NO"))
					}
				}
			}
			if $d($$$SecurityGlobalSQLPriv($namespace,0,tinfo,priv)) {	// priv at the table level
				s grantee="" 
				for  {
					s grantee=$o($$$SecurityGlobalSQLPriv($namespace,0,tinfo,priv,grantee)) q:grantee=""
					s grantor="" 
					for  {
						s grantor=$o($$$SecurityGlobalSQLPriv($namespace,0,tinfo,priv,grantee,grantor),1,go) q:grantor=""
						continue:grantee'=$$$aid&&('$lf(ulist,grantee))&&(grantor'=$$$aid)    // DPV2883	// DPV3991
						s ^||%sql.catcp(qh,SCHEMA,TABLE,COLNAME,priv,$i(^||%sql.catcp(qh,SCHEMA,TABLE,COLNAME,priv)))=$lb("",schema,table,colname,grantor,grantee,$P(",ALTER,DELETE,INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",priv)),$s(go:"YES",1:"NO"))
					}
				}
			}
			s cinfo=tinfo_"."_colname
			if $d($$$SecurityGlobalSQLPriv($namespace,0,cinfo,priv)) { // priv at the column level
				s grantee="" 
				for  {
					s grantee=$o($$$SecurityGlobalSQLPriv($namespace,0,cinfo,priv,grantee)) q:grantee=""
					s grantor="" 
					for  {
						s grantor=$o($$$SecurityGlobalSQLPriv($namespace,0,cinfo,priv,grantee,grantor),1,go) q:grantor=""
						continue:grantee'=$$$aid&&('$lf(ulist,grantee))&&(grantor'=$$$aid)    // DPV2883	// DPV3991
						s ^||%sql.catcp(qh,SCHEMA,TABLE,COLNAME,priv,$i(^||%sql.catcp(qh,SCHEMA,TABLE,COLNAME,priv)))=$lb("",schema,table,colname,grantor,grantee,$P(",ALTER,DELETE,INSERT,REFERENCES,SELECT,UPDATE",",",$f("adirsu",priv)),$s(go:"YES",1:"NO"))
					}
				}
			}
		}
	}
	QUIT $$$OK
CPExecuteError
	s $zt="" k ^||%sql.catcp(qh) QUIT $$$ERROR($$$ObjectScriptError,$ze)
}
.
.
RolesCreate(Name,Description="",Resources="",GrantedRoles="") Private {
	s $zt="Error"
	i ('$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) && '$SYSTEM.Security.Check($$$AdminRoleEditResourceName,$$$PermUseName)) q $$$ERROR($$$OperationRequires2,$$$PermUseName,$$$AdminSecureResourceName,$$$AdminRoleEditResourceName)
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	n $namespace d $zu(5,"%SYS")
	s Status=##Class(Security.Roles).Create(Name,Description,Resources,GrantedRoles)
	q Status
Error s $zt=""
	q $$$ERROR($$$ObjectScriptError,$ze)
} 
 
RolesDelete(Name) Private {
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="RolesDelete",^|"%SYS"|RJWTEST(n,"Name")=$g(Name) ;rjwtestlog
	s $zt="Error"
	i ('$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) && '$SYSTEM.Security.Check($$$AdminRoleEditResourceName,$$$PermUseName)) q $$$ERROR($$$OperationRequires2,$$$PermUseName,$$$AdminSecureResourceName,$$$AdminRoleEditResourceName)
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	n $namespace d $zu(5,"%SYS")
	s Status=##Class(Security.Roles).Delete(Name)
	q Status
Error s $zt=""
	q $$$ERROR($$$ObjectScriptError,$ze)
} 
 
UsersCreate(Username,Roles="",Password,FullName="",NameSpace="",Routine="",ExpirationDate="",ChangePassword=0,Enabled=1) Private {
	s $zt="Error"
	i ('$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) && '$SYSTEM.Security.Check($$$AdminUserEditResourceName,$$$PermUseName)) q $$$ERROR($$$OperationRequires2,$$$PermUseName,$$$AdminSecureResourceName,$$$AdminUserEditResourceName)
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	new $namespace 
	set $namespace="%SYS"
	s Status=##Class(Security.Users).Create(Username,Roles,Password,FullName,NameSpace,Routine,ExpirationDate,ChangePassword,Enabled)
	q Status
Error s $zt=""
	q $$$ERROR($$$ObjectScriptError,$ze)
}
 
	/// Called from DropUser
UsersDelete(Username) Private {
	set $zt="Error"
		#; If the user does not have %Admin_Secure:U and does not have %Admin_UserEdit:U - don't allow the DROP USER
	if '$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) {
		if $SYSTEM.Security.Check($$$AdminUserEditResourceName,$$$PermUseName) {
				#; Make sure the user with $$$AdminUserEditResourceName created this user - This disallows deletion of any user, including itself.
			if '$$CreatedUser($username,Username) {
				RETURN $$$ERROR($$$OperationRequires2,$$$PermUseName,$$$AdminSecureResourceName,$$$AdminUserEditResourceName)
			}
		} else {	// Does not have $$$AdminSecureResourceName or $$$AdminUserEditResourceName
			RETURN $$$ERROR($$$OperationRequires2,$$$PermUseName,$$$AdminSecureResourceName,$$$AdminUserEditResourceName)
		}
	}
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	new $namespace
	set $namespace="%SYS"
	RETURN ##Class(Security.Users).Delete(Username)
Error set $zt=""
	RETURN $$$ERROR($$$ObjectScriptError,$ze)
}
	/// Given a creator-username and another user name, return 1 if the creator created this user, or created the user that created this user (etc.).
CreatedUser(creator,username) [] PRIVATE {
	try {
		$$$AddAllRoleTemporaryInTry
		new $namespace
		set $namespace="%SYS"
		set creator=$$$LOWER(creator)
		set user=##class(Security.Users).%OpenId($$$LOWER(username),,.sc)
		if user=$$$NULLOREF { RETURN 0 }		// No such user
		if $$$ISERR(sc) { RETURN 0 }			// %OpenId failed
		if user.CreateUsername="" { RETURN 0 }	// User has no known creator
		if $$$LOWER(user.CreateUsername)=creator { RETURN 1 }	// creator created this user
		RETURN $$CreatedUser(creator,user.CreateUsername)	// Recusion, see if creator created the user that created username
	} catch { }	// No reporting of the error, just return 0
	RETURN 0
}
 
UsersGet(Username,Resources) Public {
	s $zt="Error"
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	n $namespace d $zu(5,"%SYS")
	s Status=##Class(Security.Users).Get(Username,.Resources)
	q Status
Error s $zt=""
	q $$$ERROR($$$ObjectScriptError,$ze)
} 
 
UsersModify(Username,Resources) Private {
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="UsersModify",^|"%SYS"|RJWTEST(n,"Username")=$g(Username),^|"%SYS"|RJWTEST(n,"Resources")=$g(Resources) ;rjwtestlog
	s $zt="Error"
	i ('$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) && '$SYSTEM.Security.Check($$$AdminUserEditResourceName,$$$PermUseName)) q $$$ERROR($$$OperationRequires2,$$$PermUseName,$$$AdminSecureResourceName,$$$AdminUserEditResourceName)
	$$$AddAllRoleTemporary ; verified 9/26/16 STC
	n $namespace d $zu(5,"%SYS")
	s Status=##Class(Security.Users).Modify(Username,.Resources)
	q Status
Error s $zt=""
	q $$$ERROR($$$ObjectScriptError,$ze)
}
 
	#; User exists.
	#;  This method checks for the existence of a user in the security database.
	#; Parameters:
	#; 	Username - Name of the user to check existence of
	#; Return values:
	#; 	If Value of the method = 0 (User does not exist, or some error occured)
	#; 	ActualUserName = ""
	#; 	If Value of the method = 1 (User exists)
	#; 	ActualUserName = exact-case of user's name (used by SQL)
	#; 	SuperUser = can optionally be passed by reference to determine if the user is a super user
UsersSQLExists(Username,ActualUserName,SuperUser) Public {
		#; ActualName will return the actual case of the username
	try {
		set ActualUserName="",SuperUser=0
			#; Take the passed username, and parse out the domain and username from it.
		set Status=$$ParseUsername^%SYS.SECURITY(Username,.Name,,.UserRecord)
		if '$$$ISOK(Status)||(Name="")||(UserRecord="") { RETURN 0 }
		set ActualUserName=Name
		set SuperUser=$$$GetSecurityUsersSuperUser(UserRecord)
		RETURN 1
	}
	catch {
		set Status=$$$ERROR($$$ObjectScriptError,$ze)
	}
	QUIT 0
}
 
	#; Role exists. (DPV2984)
	#;  This method checks for the existence of a role in the security database.
	#; Parameters:
	#; Rolename - Name of the role to check existence of
	#; Return values:
	#; If Value of the method = 0 (Role does not exist, or some error occured)
	#; If Value of the method = 1 (Role exists)
RoleExists(roleName="") Public {
	s $zt="Error" 
	$$$AddSecurityRoleTemporary
	QUIT:roleName="" 0 QUIT $d($$$SecurityGlobalRoles(roleName))#2 
Error s $zt="",Status=$$$ERROR($$$ObjectScriptError,$ze) QUIT 0
}
 
.
	// Given an SQL statement, return 1 if the current user is privileged to prepare/execute the statement, or 0 if they are not
SQLStatementPrivCheck(&query) [backgrnd,mcurs,mtag,mtc,SQLCODE] PUBLIC {
	new backgrnd,mcurs,mtag,mtc,%msg,%qinfo,SQLCODE,%switch
	set backgrnd=1,%switch="Logical"
	if $d(query)=1 {
		set input=1,input(1)=query
	} elseif $d(query)>1 {
		merge input=query set input=$o(input(""),-1)
	} else {
		RETURN 0	// no query text
	}
	try { do comp^%qaqqt("query",.input,"info","",0,"",,,,,,,"xDBC") }
	catch {
		RETURN 0
	}
	merge %qinfo=mtc(0,0)
	RETURN ($$CheckPriv^%SYS.SQLSRV(1,.mtc,.%qinfo)=0)	// Check SELECT privs on query
}
.
UsersSQLPrivilegeConvert(ns) PUBLIC {
	#;s n=$I(^|"%SYS"|RJWTEST),^|"%SYS"|RJWTEST(n)="UsersSQLPrivilegeConvert",^|"%SYS"|RJWTEST(n,"ns")=$g(ns) ;rjwtestlog
	 s $zt="Error"
	 i '$SYSTEM.Security.Check($$$AdminSecureResourceName,$$$PermUseName) q $$$ERROR($$$OperationRequires,$$$AdminSecureResourceName_":"_$$$PermUseName)
	 $$$AddSecurityRoleTemporary
	 s:ns="" ns=$namespace
		#; Convert the ^mpriv/^oddPRIV global in the database 'ns' to $$$SecurityGlobal,"SQL","priv",ns
	 If $d(^|ns|mpriv) {
		 For t=1,0 {
			s o=""
			For  {
				s o=$o(^|ns|mpriv(t,o)) q:o=""
				s p=""
				For  {
					s p=$o(^|ns|mpriv(t,o,p)) q:p=""
					s grantee=""
					For  {
						s grantee=$o(^|ns|mpriv(t,o,p,grantee)) q:grantee=""
						s Status=$$ParseUsername^%SYS.SECURITY(grantee,.newgrantee)
						s grantor=""
						For  {
							s grantor=$o(^|ns|mpriv(t,o,p,grantee,grantor)) q:grantor=""
							s Status=$$ParseUsername^%SYS.SECURITY(grantor,.newgrantor)
							s $$$SecurityGlobalSQLPriv(ns,t,o,p,newgrantee,newgrantor)=^|ns|mpriv(t,o,p,grantee,grantor)
						}
					}
				}
			}
		 }
		 s grantee=""
		 For {
			s grantee=$o(^|ns|mpriv("m",grantee)) q:grantee=""
			s o=""
			For  {
				s o=$o(^|ns|mpriv("m",grantee,o)) q:o=""
				s Status=$$ParseUsername^%SYS.SECURITY(grantee,.newgrantee)
				s grantor=$p(o,"||",4)
				s Status=$$ParseUsername^%SYS.SECURITY(grantor,.newgrantor)
				s newo=$p(o,"||",1,2)_"||"_newgrantee_"||"_newgrantor
				s $$$SecurityGlobalSQLPriv(ns,"m",newgrantee,newo)=""
			}
		 }
		 Kill ^|ns|mpriv
	 }
	 If $d(^|ns|oddPRIV) {
		 For t=1,0 {
			s o=""
			For  {
				s o=$o(^|ns|oddPRIV(t,o)) q:o=""
				s p=""
				For  {
					s p=$o(^|ns|oddPRIV(t,o,p)) q:p=""
					s grantee=""
					For  {
						s grantee=$o(^|ns|oddPRIV(t,o,p,grantee)) q:grantee=""
						s Status=$$ParseUsername^%SYS.SECURITY(grantee,.newgrantee)
						s grantor=""
						For  {
							s grantor=$o(^|ns|oddPRIV(t,o,p,grantee,grantor)) q:grantor=""
							s Status=$$ParseUsername^%SYS.SECURITY(grantor,.newgrantor)
							s $$$SecurityGlobalSQLPriv(ns,t,o,p,newgrantee,newgrantor)=^|ns|oddPRIV(t,o,p,grantee,grantor)
						}
					}
				}
			}
		 }
		 s grantee=""
		 For {
			s grantee=$o(^|ns|oddPRIV("m",grantee)) q:grantee=""
			s o=""
			For  {
				s o=$o(^|ns|oddPRIV("m",grantee,o)) q:o=""
				s Status=$$ParseUsername^%SYS.SECURITY(grantee,.newgrantee)
				s grantor=$p(o,"||",4)
				s Status=$$ParseUsername^%SYS.SECURITY(grantor,.newgrantor)
				s newo=$p(o,"||",1,2)_"||"_newgrantee_"||"_newgrantor
				s $$$SecurityGlobalSQLPriv(ns,"m",newgrantee,newo)=""
			}
		 }
		 Kill ^|ns|oddPRIV
	 }
	 QUIT $$$OK
Error s $zt=""
	Quit $$$ERROR($$$ObjectScriptError,$ze)
}
.
.
	// Given a SQL Statement Index hash, see if the user is privileged to run the statement
	//  Arguments:
	//	- pHash :: passed by value, input
	//	   Hash IDKEY for the Statement
	//
	// Return value:	
	//   Returns 1 if privileges, 0 if not
	//  If the user is not SuperUser,
	//    AND Security is turned ON, 
	//        AND this statement requires privileges
	//  Return 1 if the user is privileged, otherwise return 0
StatementIndexPrivileged(pHash) [] PUBLIC {
	try {
		set return=1
		quit:'$d($$$SQLIndex(1,pHash,"priv"))	// No privileges for this statement
		quit:$SYSTEM.Security.Check($$$DevelopmentResourceName,$$$PermUseName)	// users with "USE" permission on the %Development resource can see all statements and [un]freeze plans.
 		$$$AddSecurityRoleTemporaryInTry
		if '$$$IAmSuperUser,$$$SQLSecurityOn {
				#; unfortunately, the role name in $Roles may not be the exact case of the role name defined in the Role and Privilege databases,
				#; so we have to get the exact rolename here (pl #127122).
			set tRoles=$Roles
			if tRoles'="" {		// It is possible that $Roles="" (pl134809)
				for r=1:1:$l(tRoles,",") {
					set tRole=$LG($g($$$SecurityGlobalRoles($p(tRoles,",",r))),4)	// Just in case something in $Roles not found in the role db, don't put a "" entry in tRoles.
					set:tRole'="" $p(tRoles,",",r)=tRole
				}
			}
			set obj="",ok=1
			for  {	// For each SQL Object
				set obj=$o($$$SQLIndex(1,pHash,"priv",obj)) quit:obj=""
					#;  Now check to see if the user has privileges to execute this statement
					#;  For each SQL object
					#;    For each privilege required on that object
					#;      First check to see if this user is privileged
					#;      Else, see if _PUBLIC is privileged
					#;      Else, check if the user has been granted a role which is privileged
				set act="",fields=""
				for  {	// For each SQL Action
					set act=$o($$$SQLIndex(1,pHash,"priv",obj,act),1,fields) quit:act=""
						// $$OwnerCheck returns 0 if the Owner is privileged.  Careful!!! Naked references!!!
					if '$d($$$SecurityGlobalSQLPriv($namespace,0,obj,act,$$$aid)),'$d(^("_PUBLIC")) {
						set ok=0
						if tRoles'="" { for r=1:1:$l(tRoles,",") { if $d(^($p(tRoles,",",r))) set ok=1 quit  } }
						if 'ok && ('$$SchemaCheck($namespace,obj,0,act) || '$$OwnerCheck(obj,act)) { set ok=1 }
					}
					if 'ok {	// If don't have priv for entire object, check individual fields
						set ptr=0 while $listnext(fields,ptr,field) {	// For each field-object
							set fobj=obj_"."_field
							set ok=1
							if '$d($$$SecurityGlobalSQLPriv($namespace,0,fobj,act,$$$aid)),'$d(^("_PUBLIC")) {
								set ok=0
								if tRoles'="" { for r=1:1:$l(tRoles,",") { if $d(^($p(tRoles,",",r))) set ok=1 quit  } }
							}
							quit:'ok
						}
					}
					quit:'ok
				}
				quit:'ok	// User is not privileged to use this statement
			}
			set:'ok return=0
		}
	}
	catch {
		ztrap $ze
	}
	QUIT return
}
.
	// Set the $$$EXTsqltableviewidx for a view without auditing a potential <PROTECT> error
	// $zu(179) requires privileges, that is why it is here in a %SYS routine
SetEXTsqltableviewidx(tableExtent,viewExtent) [] PUBLIC {
  	try {
	  	set oldval=$zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,0)				  // do not audit <PROTECT> error
  		set $$$EXTsqltableviewidx($$$rEXT,tableExtent,viewExtent)=""
  	}
  	catch {
  		#; if error is <PROTECT> just continue on, the table must be in a database this user does not have write access to
	  	if $ze'["<PROTECT>" {
  		  	do:$d(oldval) $zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,oldval)  // restore <PROTECT> error auditing setting
		  	set $$$EXTsqltableviewidx($$$rEXT,tableExtent,viewExtent)=""	 // try it again and report the real error
	  	}
  	}
  	do:$d(oldval) $zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,oldval)				  // restore <PROTECT> error auditing setting
  	RETURN
} 
.
	// Set the $$$EXTsqlviewviewsidx for a virew without auditing a potential <PROTECT> error
	// $zu(179) requires privileges, that is why it is here in a %SYS routine
SetEXTsqlviewviewsidx(view1,view2) [] PUBLIC {
  	try {
	  	set oldval=$zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,0)				  // do not audit <PROTECT> error
  		set $$$EXTsqlviewviewsidx($$$rEXT,view1,view2)=""
  	}
  	catch {
  		#; if error is <PROTECT> just continue on, the table must be in a database this user does not have write access to
	  	if $ze'["<PROTECT>" {
  		  	do:$d(oldval) $zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,oldval)  // restore <PROTECT> error auditing setting
		  	set $$$EXTsqlviewviewsidx($$$rEXT,view1,view2)=""	 // try it again and report the real error
	  	}
  	}
  	do:$d(oldval) $zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,oldval)				  // restore <PROTECT> error auditing setting
  	RETURN
} 
.
	// Kill the $$$EXTsqlviewvieswidx for a view without auditing a potential <PROTECT> error
