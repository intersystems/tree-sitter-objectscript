	try {
		set tableName = $lg($g(^rINDEXSQL("rv",$$$UPPER($$$SchemaFromIQN(iqn)),$$$UPPER($$$TableFromIQN(iqn)))),3)
	} catch ex {
		if ex.Name="<PROTECT>" {
			set tableName = ""
		} else {
			do:$d(oldAuditVal) $zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,oldAuditVal)
			throw ex
		}
	}
	do:$d(oldAuditVal) $zu(179,$$$AUDITEFFECTIVE,$$$AUDITPROTECT,oldAuditVal)
	RETURN tableName
}
.
.
