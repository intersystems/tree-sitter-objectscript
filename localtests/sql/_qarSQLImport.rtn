====
qarSQLImport
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qarSQLImport^MAC^^^0
%qarSQLImport	// InterSystems IRIS SQL DDL Import Utility
	;; COMPONENTS :: SQL/Runtime
	#;
#INCLUDE %msql
#INCLUDE %occDS
	#;
#IF 0   ;
	;-------------------------------------------------------------
	; Description:   InterSystems IRIS SQL DDL Import Utility
	; Author:        David Van De Griek
	; Date:          January 4, 1999
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;  DPV3372 (03/12/2009) - Implement utilities to extract SQL and perform ShowPlan on a script
	;  BJB404  (11/21/2008) - Support DROP VIEW for Cache DDLImport
	;  DPV3288 (10/08/2008) - Correct Sybase DDL Import with UPDATE, Oracle import with "go" end-of-statement marker
	;  DPV3266 (09/23/2008) - DDL IMPORT: Cach mode, process with Dynamic SQL
	;  DPV3263 (09/22/2008) - Support MySQL DDL Script file import
	;  DPV2915 (04/25/2007) - Remove BREAK in code for MS SQL Server
	;                         SQL Fix ProdLog 56800: DDLImport BREAKs on error
	;  DPV2897 (04/02/2007) - Support UPDATE statement in CACHE file Import
	;  DPV2847 (01/23/2007) - Handle SETUSER better in CACHE file import
	;                         SQL Fix ProdLog 55791:  $system.SQL.DDLImport("CACHE",... generates wrong unsupported statements file
	;  DPV2819 (12/12/2006) - Fix ORACLE and INFORMIX import with End-Of-Statement delimiter of more than 1 character
	;  DPV2816 (12/11/2006) - New SaveUser
	;  BJB329  (12/05/2006) - Support Create Trigger from $SYSTEM.SQL.DDLImport 
	;  DPV2794 (11/20/2006) - Support CREATE GLOBAL TEMPORARY TABLE for Sybase and SQL Server
	;  STC1094 (10/28/2006) - Add routine change audit
	;  DPV2730 (09/12/2006) - Support CREATE BITMAP <NL> INDEX...
	;  DPV2719 (08/24/2006) - Support DROP TABLE/VIEW for Sybase and MSSQLServer
	;                         SQL Enhancement 52885: MSSQL DDL Import doesn't support Drop
 	;  DPV2715 (08/15/2006) - Support UPDATE in MSSQLServer import
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  DPV2672 (06/23/2006) - Add support for statement level triggers
	;  DPV2477 (07/29/2005) - Fix writing to no-sup file for mode CACHE
	;                         SQL Fix ProdLog 43797: $system.SQL.DDLImport is not logging all errors/unsupported stmts
	;  DPV2350 (01/26/2004) - Support export of user/roles with new security structure
	;  DPV2321 (11/10/2004) - Use new %SYS.CONFIG API for SQL Configuration settings
	;  DPV2320 (11/10/2004) - Rename server routines
	;  DPV2306 (10/06/2004) - SQL Fix: Fix DDL Import of CREATE BITMAP INDEX statement for Cach mode
 	;  DPV2247 (07/14/2004) - Call MPP with SPlitSQL flag = 1 so the generated routine can be split
	;  DPV2198 (03/17/2004) - Use $Username instead of %msql, use new privilege global
	;  DPV2126 (12/05/2003) - Add support for CACHE mode
	;  DPV2120 (11/07/2003) - Handle extra whitespace in Oracle import
	;  DPV2119 (11/06/2003) - Various fixes for MS SQL Server and Sybase
	;  DPV1930 (02/06/2003) - Allow CREATE BITMAP INDEX for Oracle
	;  DPV1870 (11/05/2002) - DDL Import enhancements for Oracle and MS SQL Server
	;  DPV1868 (10/30/2002) - Allow whitespace before statement in Sybase
	;  DPV1810 (08/27/2002) - Support DROP VIEW in Oracle, disallow GRANT ALTER
	;  DPV1568 (07/13/2001) - Allow quoted identifiers in Oracle an InterBase imports
	;  DPV1553 (06/14/2001) - Handle whitespace after end of statement marker
	;  DPV1505 (03/08/2001) - Add support for ^rINDEX global
	;  DPV1469 (12/12/2000) - Support DDLImport^%apiSQL entry point
	;  DPV1459 (11/29/2000) - Support DROP TABLE, DROP INDEX, UPDATE for Oracle
	;                         Handle extra white space at end of statement
	;  DPV1443 (11/02/2000) - Don't strip " characters from SQL/DDL text
	;  DPV1337 (07/12/2000) - Support CREATE USER/ROLE in Oracle
	;  DPV1292 (04/06/2000) - Support InterBase, many other enhancements.
	;  DPV1216 (12/13/1999) - Translate TABS to SPACE.  
	;                         Skip over ALTER TABLE ... PARTITION ... in Sybase
	;  DPV1195 (11/20/1999) - Many Oracle enhancements.
	;  DPV1118 (08/03/1999) - Fix oneline problem with FDBMS
	;  DPV1108 (07/19/1999) - Sybase enhancements.
	;  DPV1088 (06/15/1999) - For MS SQL Server, strip out []
	;  DPV1067 (05/18/1999) - More Informix support
	;  DPV1062 (05/13/1999) - Many Informix, MSSQLServer, Sybase compatibiliy enhancements
	;  DPV1043 (04/14/1999) - Support $ZEOF command
	;  DPV994  (03/05/99)   - Add support for more syntax
	;  DPV990  (03/05/99)   - Allow Cache' SQL user of other than system
	;
	;-------------------------------------------------------------
	;                     I N F O R M A T I O N
	;-------------------------------------------------------------
	;-------------------------------------------------------------
#ENDIF  ;
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#DEFINE DisplaySQLLine f w=0:74:((($l(sql)\74)+1)*74) i $e(sql,w+1,w+74)'="" w !?5,$e(sql,w+1,w+74)
#DEFINE InitTime s time1=$zh
#DEFINE ElapsedTime s time1=$zh-time1 w !!,"Elapsed time: "_$s(time1>60:(time1\60)_" minutes ",1:"")_(time1#60)_" seconds.  "
#DEFINE Stripper(%s) $zcvt($zstrip(%s,"*W"),"U")
#DEFINE Stripper2(%s) $zcvt($zstrip(%s,"<=W"),"U")
#DEFINE MSSQLServerCharStrip(%s) $tr(%s,"[]"_$c(9),""""" ")
#DEFINE CacheCharStrip(%s) $tr(%s,$c(9)," ")
#DEFINE SybaseCharStrip(%s) $tr(%s,$c(9)," ")
#DEFINE StripTrailingWhiteSpace(%s) $zstrip(%s,">W")
	#;  For little endian Unicode files from MS SQL Server
#DEFINE UnicodeStrip(%s) $tr(%s,$c(0,254,255))
 
FDBMS	; Load DDL File created by FDBMS DDL Export utility
	n %DDLMode s %DDLMode=$$$SQLDIALECTFDBMS g common
 
 
Cache	; Load DDL File created by IRIS or Cache' SQL Export utility
IRIS	n %DDLMode,deos s %DDLMode="IRIS",deos="GO"
	w !,"The InterSystems IRIS SQL DDL Import Utility supports the following statements:"
	w !!,"   CREATE [GLOBAL TEMPORARY] TABLE ..."
	w !,"   CREATE VIEW ..."
	w !,"   ALTER TABLE ..."
	w !,"   DROP TABLE ..."
	w !,"   CREATE [ { UNIQUE | BITMAP } ] INDEX ..."
	w !,"   INSERT ..."
	w !,"   UPDATE ..."
	w !,"   DELETE ..."
	w !,"   SET OPTION ..."
	w !,"   SETUSER ..."
	w !,"   CREATE ROLE ..."
	w !,"   CREATE USER ..."
	w !,"   GRANT"
	w !,"   REVOKE ..."
	w !!,"Statements other than the ones above are not handled by the"
	w !,"utility and must be added to your IRIS application manually"
	w !,"(if applicable).",!
	w !,"The end-of-statement marker for IRIS script files defaults to"
	w !,"the string GO, and must be on a line by itself, not"
	w !,"at the end of the last line of the statement."
	g common
 
 
Informix ; Load DDL/DML File created by Informix schema utility
	n %DDLMode,deos s %DDLMode=$$$SQLDIALECTINFORMIX,deos=";" g common
	. w !,"The Informix DDL Import Utility supports the following statements:"
	. w !!,"   CREATE TABLE ..."
	. w !,"   CREATE PROCEDURE ..."
	. w !,"   ALTER TABLE ..."
	. w !,"   CREATE INDEX ..."
	. w !,"   CREATE VIEW ..."
	. w !,"   SET OPTION ..."
	. w !,"   GRANT { ALTER | SELECT | INSERT | UPDATE | DELETE | REFERENCES | ALL PRIVILEGES } ..."
	. w !!,"Statements other than the ones above are not handled by the"
	. w !,"utility and must be added to your IRIS application manually"
	. w !,"(if applicable).",!
 
ISPL ; Load DDLDML File, dialect = Informix but procedure language target is ISPL and not COS.
	n %DDLMode,%DDLMethodLanguage,deos s %DDLMode=$$$SQLDIALECTINFORMIX, %DDLMethodLanguage=$$$cMETHLANGUAGEISPL,deos=";" g common
	. w !,"The Informix DDL Import Utility supports the following statements:"
	. w !!,"   CREATE TABLE ..."
	. w !,"   CREATE PROCEDURE ...(method target language=ispl)"
	. w !,"   ALTER TABLE ..."
	. w !,"   CREATE INDEX ..."
	. w !,"   CREATE VIEW ..."
	. w !,"   SET OPTION ..."
	. w !,"   GRANT { ALTER | SELECT | INSERT | UPDATE | DELETE | REFERENCES | ALL PRIVILEGES } ..."
	. w !!,"Statements other than the ones above are not handled by the"
	. w !,"utility and must be added to your IRIS application manually"
	. w !,"(if applicable).",!
 
InterBase ; Load DDL File created by InterBase Export utility
	n %DDLMode,deos s %DDLMode=$$$SQLDIALECTINTERBASE,deos=";" d  g common
	. w !,"The InterBase DDL Import Utility supports the following statements:"
	. w !!,"   CREATE TABLE ..."
	. w !,"   ALTER TABLE ..."
	. w !,"   CREATE VIEW ..."
	. w !,"   CREATE [UNIQUE] INDEX ..."
	. w !,"   CREATE ROLE ..."
	. w !!,"Statements other than the ones above are not handled by the"
	. w !,"utility and must be added to your IRIS application manually"
	. w !,"(if applicable).",!
 
 
MSSQLServer ; Load DDL File created by MS SQL Server Export utility
	n %DDLMode,deos s %DDLMode=$$$SQLDIALECTMSSQL,deos="GO" d  g common
	. w !,"The Microsoft SQL Server Import Utility supports common statements. Refer to IRIS"
	. w !,"documentation for more information."
	. w !!,"Unsupported syntax is either reported as a <SYNTAX> error in the output log"
	. w !,"or in the unsupported statement log.",!
 
 
Sybase	; Load DDL File created by DBArtisan
	n %DDLMode,deos s %DDLMode=$$$SQLDIALECTSYBASE,deos="GO" d  g common
	. w !,"The Sybase Import Utility supports common statements. Refer to IRIS"
	. w !,"documentation for more information."
	. w !!,"Unsupported syntax is either reported as a <SYNTAX> error in the output log"
	. w !,"or in the unsupported statement log.",!
 
 
Oracle	; Load DDL File created by Oracle Export utility
	n %DDLMode,deos 
	s %DDLMode=$$$SQLDIALECTORACLE,deos=";"
	w !,"The Oracle DDL Import Utility supports the following statements:"
	w !!,"   CREATE TABLE ..."
	w !,"   CREATE VIEW ..."
	w !,"   CREATE USER ..."
	w !,"   CREATE ROLE ..."
	w !,"   ALTER TABLE ..."
	w !,"   CREATE [ UNIQUE | BITMAP ] INDEX ..."
	w !,"   DROP TABLE ..."
	w !,"   DROP INDEX ..."
	w !,"   DROP VIEW ..."	// DPV1810=
	w !,"   INSERT ..."
	w !,"   UPDATE ..."
	w !,"   DELETE ..."
	w !,"   SET OPTION ..."
	w !,"   GRANT { ALTER | SELECT | INSERT | UPDATE | DELETE | REFERENCES | ALL PRIVILEGES } ..."
	w !!,"Statements other than the ones above are not handled by the"
	w !,"utility and must be added to your IRIS application manually"
	w !,"(if applicable).",!
	g common
 
 
common	; 
	n %ANS,cnt,code,eos,errpause,i,j,infile,IO,IOBS,IOF,IOM,IOPAR,IOSL,IOST,IOT,mode0,mode1,MSYS,nocheck,nosup,nosupfile,outfile,RMSDF,POP,QUIT,rtn,sql,sqllines,success,tDialect,time1,w
	s cnt=0,mode0=$c(27,91,109),mode1=$c(27,91,49,109),nosup=0,nosupfile="",QUIT=0
	i '$g(%sqldebug) n %sqldebug s %sqldebug=0
	i %DDLMode'=$$$SQLDIALECTFDBMS,'$$$GetDelimitedIds d  i $e(i)'="Y" QUIT
	. w !,"Support for delimited identifiers is currently turned off."
	. w !,"If any Statements in this script file contain delimited"
	. w !,"(quoted or bracketed) identifiers, the statements will not compile"
	. w !!,"Continue anyway?  Y=> " r i s:i="" i="Y" s i=$zcvt(i,"U")
		// Normalize the dialect value
	set tDialect = $ListFind($$$SQLDIALECTDYNAMICUPPER,$zconvert(%DDLMode,"U"))
		// Temporary redirect - send IRIS dialect to custom crafted importer instead of letting it go to dynamic SQL.
		// If the position of "CACHE" changes in the SQLDIALECTDYNAMICUPPER string changes then this test will be invalid.
		// Positions 1, 2, and 3 are NULL, IRIS,  and CACHE.
	if tDialect&&(tDialect>3) {
		set tDialect = $ListGet($$$SQLDIALECTDYNAMIC,tDialect)
		do ##class(%SQL.Util.Import).interactive(tDialect)
		QUIT
	}
	#; DPV2198= i $g(%msql)="" n %msql d AskForLogin QUIT:QUIT
	#;  Prompt for and Open the input file
	w !,"Enter DDL File Name to Import: "
	d IN^%IS QUIT:POP  s infile=IO kill %ANS,IO,IOBS,IOF,IOM,IOPAR,IOSL,IOST,IOT,MSYS,POP,RMSDF
	#;  Prompt for and Open the output file
	w !!,"Enter the file name to record any errors in: "
	d OUT^%IS QUIT:POP  s outfile=IO kill %ANS,IO,IOBS,IOF,IOM,IOPAR,IOSL,IOST,IOT,MSYS,POP,RMSDF
	i %DDLMode'=$$$SQLDIALECTFDBMS d
	. w !!,"Many script files contain statements not supported by InterSystems IRIS SQL."
	. w !,"Would you like to log the statements not supported to a file so they"
	. w !,"can be dealt with manually, if applicable?   Y=> "
	. r nosup s:nosup="" nosup="Y" s nosup=$zcvt(nosup,"U"),nosup=($e(nosup)="Y") 
	. i nosup w !,"Enter the file name to record non-supported statements in: " d OUT^%IS QUIT:POP  s:IO'="" nosupfile=IO kill %ANS,IO,IOBS,IOF,IOM,IOPAR,IOSL,IOST,IOT,MSYS,POP,RMSDF
	. i nosup u nosupfile d
	.. w !,"This file contains text not handled by the InterSystems IRIS SQL script"
	.. w !,"import utility for the script file:"
	.. w !?5,infile
	.. w !,"Note, this file may contain line comments for statements that were imported."
	.. w !,"----------------------------------",!
	.. u 0
	i %DDLMode'=$$$SQLDIALECTFDBMS w !!,"Please enter the end-of-statement delimiter (Default is '"_deos_"'):  "_deos_"=>" r eos s:eos="" eos=deos s eos=$zcvt(eos,"U")
	w !!,"Pause how many seconds after error?   5 => " r errpause s:errpause="" errpause=5
entry	; Enter here from DDLImport^%apiSQL
	new ErrorCount,isLastLine,mlcomment,ok,status,WarningCount
	set $zt="DDLerror^"_$zn
	if verbose {
		w !!,$$$Text("Importing SQL Statements from file: ","%SQL.Import")_infile,!
		i outfile w !!,$$$Text("Recording any errors to principal device and log file: ","%SQL.Import")_outfile,!
		i nosup w !!,$$$Text("Recording unsupported statements to file: ","%SQL.Import")_nosupfile,!
	}
	$$$InitTime
 
	#;-------------------------------------------------------------------
	#;   InterSystems IRIS SQL
	#;     Statements supported (If the statement begins with the following, it is supported):
	#;		CREATE ...
	#;		DROP ...
	#;		TRUNCATE TABLE ...
	#;		ALTER ...
	#;		INSERT ...
	#;		UPDATE ...
	#;		DELETE ...
	#;		SET OPTION ...
	#;		SETUSER [=] ... // NOTE:  NOT "SET USER ..."
	#;		GRANT ...
	#;		REVOKE ...
	#;		SELECT  // for optimizer plan mode only
	#; 		LOAD DATA...
	#; 		USE [DATABASE] ...
	#; 		TUNE TABLE ...
	#; 		FREEZE ...
	#; 		UNFREEZE ...
	#; 		LOCK ...
	#; 		UNLOCK ...
	#; 		BUILD INDEX ...
	#;-------------------------------------------------------------------
	set ErrorCount=0,WarningCount = 0
	If (%DDLMode=$$$SQLDIALECTIRIS) || (%DDLMode=$$$SQLDIALECTCACHE) {
		new %msg,%plan,%pln,%ROWCOUNT,%ROWID,atend,endStatus,lineBeforeEos,NewUser,package,rs,SaveUser,sc,SQLCODE,stop,viewext
		set SaveUser=$Username,nocheck="",package="", endStatus = $$$OK
		for  {
			use infile read sql q:$zeof=-1  use 0
			set sql=$$$UnicodeStrip(sql),sql=$p(sql,"--")
			//if $$$Stripper(sql)="" continue	// blank line or comment-only line
			//If '(($e($$$Stripper(sql),1,11)="CREATETABLE")||($e($$$Stripper(sql),1,9)="DROPTABLE")||($e($$$Stripper(sql),1,26)="CREATEGLOBALTEMPORARYTABLE")||($e($$$Stripper(sql),1,10)="ALTERTABLE")||($e($$$Stripper(sql),1,10)="CREATEVIEW")||($e($$$Stripper(sql),1,9)="ALTERVIEW")||($e($$$Stripper(sql),1,8)="DROPVIEW")||($e($$$Stripper(sql),1,6)="INSERT")||($e($$$Stripper(sql),1,6)="UPDATE")||($e($$$Stripper(sql),1,6)="DELETE")||($e($$$Stripper(sql),1,9)="SETOPTION")||($e($$$Stripper(sql),1,7)="SETUSER")||($e($$$Stripper(sql),1,12)="CREATEUNIQUE")||($e($$$Stripper(sql),1,11)="CREATEINDEX")||($e($$$Stripper(sql),1,12)="CREATEBITMAP")||($e($$$Stripper(sql),1,5)="GRANT")||($e($$$Stripper(sql),1,6)="REVOKE")||($e($$$Stripper(sql),1,10)="CREATEROLE")||($e($$$Stripper(sql),1,10)="CREATEUSER")||($e($$$Stripper(sql),1,8)="DROPUSER")||($e($$$Stripper(sql),1,13)="CREATETRIGGER")||($e($$$Stripper(sql),1,6)="SELECT")||($e($$$Stripper(sql),1,7)="#IMPORT"))  { If nosup,$$$Stripper(sql)'="" { u nosupfile w !,sql } continue  }	// DPV2477
			if '(($e($$$Stripper(sql),1,6)="CREATE")
				||($e($$$Stripper(sql),1,4)="DROP")
				||($e($$$Stripper(sql),1,5)="ALTER")
				||($e($$$Stripper(sql),1,6)="INSERT")
				||($e($$$Stripper(sql),1,6)="UPDATE")
				||($e($$$Stripper(sql),1,6)="DELETE")
				||($e($$$Stripper(sql),1,9)="SETOPTION")
				||($e($$$Stripper2(sql),1,7)="SETUSER")	// SETUSER has to be one token
				||($e($$$Stripper(sql),1,5)="GRANT")
				||($e($$$Stripper(sql),1,6)="REVOKE")
				||($e($$$Stripper(sql),1,6)="SELECT")
				||($e($$$Stripper(sql),1,13)="TRUNCATETABLE")
				||($e($$$Stripper(sql),1,8)="LOADDATA")
				||($e($$$Stripper(sql),1,3)="USE")
				||($e($$$Stripper(sql),1,9)="TUNETABLE")
				||($e($$$Stripper(sql),1,6)="FREEZE")
				||($e($$$Stripper(sql),1,8)="UNFREEZE")
				||($e($$$Stripper(sql),1,4)="LOCK")
				||($e($$$Stripper(sql),1,6)="UNLOCK")
				||($e($$$Stripper(sql),1,10)="BUILDINDEX")
				||($e($$$Stripper(sql),1,7)="#IMPORT"))  { 
					if nosup,$$$Stripper(sql)'="" { use nosupfile write !,sql } 
					continue
			}
			if $e($$$Stripper(sql),1,7)="#IMPORT" {
				set package=$lb($p($zstrip(sql,"<W")," ",2))
				continue
			}
			if $e($$$Stripper2(sql),1,7)="SETUSER" {
				if sql["=" { set NewUser=$zstrip($p(sql,"=",2,*),"<>W") }
				else { set NewUser=$zstrip($e(sql,8,*),"<>W") }
				if NewUser'="" { set x=$SYSTEM.Security.Users.PrincipalNameSet(NewUser) }	// Change $Username, retain $Roles
				else { set x=$SYSTEM.Security.Users.PrincipalNameSet(SaveUser) }		// Return to login $Username
					#; Handle the GO line after the SETUSER line
				use infile read sql // Line should have been the End-Of-Statement for SETUSER - ignore it
				continue
			}
			kill code,sqllines 
			if verbose { write ! }
			set cnt=cnt+1
			if verbose { u 0 w !?2,mode1_$$$Text("SQL statement to process (number ","%SQL.Import")_cnt_"):"_mode0 }
			set isLastLine=$$find^%qarmac($$$UPPER(sql),eos,1,$l(sql),.mlcomment,"SQL")
			if $$LastNonWhiteChar($$$UPPER(sql),$l(eos))=eos {		// First, Last, and only line of statement
				set lineBeforeEos=$$$AllButLastPiece(sql,eos)
				if lineBeforeEos'="" {
					set code(1)=$$$CacheCharStrip(lineBeforeEos),sqllines($i(sqllines))=lineBeforeEos
					if verbose { u 0 $$$DisplaySQLLine }
				}
			}
			else {	// First line of multi-line statement
					#; There is no eos on the first line
				set code(1)=$$$CacheCharStrip(sql),sqllines($i(sqllines))=sql
				if verbose { u 0 $$$DisplaySQLLine }
					#; Get lines 2 through N for the statement
					
				if $zcvt($zstrip(sql,"*W",,eos),"U")'=eos {	// if line is not the eos marker
					f i=2:1 {
						use infile read sql set sql=$$$UnicodeStrip(sql) use 0 // ,sql=$p(sql,"--")
						set isLastLine=1
						for  {
							set isLastLine=$$find^%qarmac($$$UPPER(sql),eos,isLastLine,$l(sql),.mlcomment,"SQL")
							quit:'isLastLine	// eos not found
							if $case($e($$$StripLeadingWhiteSpace($e(sql,isLastLine,*)),1,2),"":1,"--":1,"/*":1,:0)	{ quit } // eos found at end of line, or at end before comment
						}
						quit:$zcvt($zstrip(sql,"*W",,eos),"U")=eos		// This line is the EOS marker
						if isLastLine {						// Last line of statement
							set lineBeforeEos=$e(sql,1,isLastLine-($l(eos)+1))
							if lineBeforeEos'="" {
								set code(i)=$$$CacheCharStrip(sql),sqllines($i(sqllines))=lineBeforeEos
								if verbose { $$$DisplaySQLLine }
							}
							quit
						}
						set code(i)=$$$CacheCharStrip(sql),sqllines($i(sqllines))=sql
						if verbose { $$$DisplaySQLLine }
						}
					}
			}
.
			/*
			s code(1)=$$$CacheCharStrip(sql),sqllines($i(sqllines))=sql  u 0 $$$DisplaySQLLine
			If $zcvt($zstrip(sql,"*PW",,eos),"U")'=eos {
				For i=2:1 {
					u infile r sql 
					s sql=$$$UnicodeStrip(sql),sql=$p(sql,"--") 
					u 0 q:$zcvt($zstrip(sql,"*PW",,eos),"U")=eos  
					s code(i)=$$$CacheCharStrip(sql),sqllines($i(sqllines))=sql 
					$$$DisplaySQLLine
				}
			}
			*/
			if $g(%optPlan) {	// DPV3372=
				try {
						#; get the plan for this query
					kill %plan,%pln set:$g(SQLCODE)<0 SQLCODE=0
					u 0 w !?2,mode1_$$$Text("Generating query plan...","%SQL.Import")_mode0
					do ShowPlan^%apiSQL(.sqllines,1,1,,package,$g(schemapath))	// sets %plan implicitly
						#; Minimize the plan text (returns %pln())
					do:$d(%plan) pln^%qaqplan
					if '$d(%pln) {
						w !?3,$$$Text("***** NO PLAN PRODUCED FOR STATEMENT *****","%SQL.Import"),!
						if 'table {
							u outfile
							w !?3,$$$Text("***** NO PLAN PRODUCED FOR STATEMENT *****","%SQL.Import")
							w !,$$$Text("SQL Text:","%SQL.Import") for i=1:1:$g(sqllines) { w !?5,$g(sqllines(i)) } w !?2,"---"
							w !,"######" u 0
						}
						continue
					}
					if 'table { use outfile for i=1:1:%pln { w !,%pln(i) } w !,"######" u 0 }
					u 0 w mode1_$$$Text("Done","%SQL.Import")_mode0
				}
				catch {
					w !,$$$Text("An error occurred during Optimizer Plan Processing...","%SQL.Import")
					if $ze'["<SYNTAX>errdone+" w !,"$ZE = "_$ze
					if $g(SQLCODE)<0 w !?3,"SQLCODE = "_SQLCODE,?21,$$sqlcode^%apiSQL(SQLCODE)
					i $g(err)'="",err'="qaqperr" w !?3,"err = "_$g(err)
					i $g(%msg)'="" w !?3,"%msg = "_$g(%msg)
					u outfile
					w !,$$$Text("An error occurred during Optimizer Plan Processing...","%SQL.Import")
					w !,"SQL:" for i=1:1:$g(sqllines) { w !?2,$g(sqllines(i)) } w !?2,"---"
					if $ze'["<SYNTAX>errdone+" w !,"$ZE = "_$ze
					if $g(SQLCODE)<0 w !?3,"SQLCODE = "_SQLCODE,?21,$$sqlcode^%apiSQL(SQLCODE)
					i $g(err)'="",err'="qaqperr" w !?3,"err = "_$g(err) k err
					i $g(%msg)'="" w !?3,"%msg = "_$g(%msg) k %msg
					w !,"######" u 0
				}
				continue
			}
.
			s rs=##class(%ResultSet).%New("%DynamicQuery:SQL")
			set rs.RuntimeMode=$zu(115,5)
			if verbose { u 0 w !?6,mode1_$$$Text("Preparing SQL statement...","%SQL.Import")_mode0 }
			s sc=rs.Prepare(.sqllines)
			i $$$ISERR(sc) {
				set ErrorCount=ErrorCount+1
				if verbose { d DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) }
				if 'table {
					use outfile
					w !,$$$Text("An error occurred during Prepare:","%SQL.Import"),!,"TIMESTAMP: ",$zdt($h,3),!,"USER: ",?12,$username,!,"NAMESPACE: ",$namespace,!,"STATEMENT:"
					set i=1 do { w !?4,code(i) set i=i+1 } while $d(code(i))
					w ! d DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) w !!,"-------------------------------------------------------------------------",!
					use 0
				}
				if resultid { do ##class(%SQL.Diag.Result).addDiagMessage(resultid,"DDL File Import",$SYSTEM.Status.StatusToSQLCODE(sc),$SYSTEM.Status.GetErrorText(sc),3) }
				if 'ignoreerrors {
					set endStatus =  $$GetLastError^%apiOBJ()
					QUIT
				}
				continue
			}
			u 0
			if verbose { w !?6,mode1_$$$Text("Executing SQL statement...","%SQL.Import")_mode0 }
			i sc s sc=rs.Execute(.sqllines) 
			i $$$ISERR(sc) {
				set ErrorCount=ErrorCount+1
				if verbose { d DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) }
				if 'table {
					use outfile
					w !,$$$Text("An error occurred during Execute:","%SQL.Import"),!,"TIMESTAMP: ",$zdt($h,3),!,"USER: ",?12,$username,!,"NAMESPACE: ",$namespace,!,"STATEMENT:"
					set i=1 do { w !?4,code(i) set i=i+1 } while $d(code(i))
					w ! d DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) w !!,"-------------------------------------------------------------------------",! 
					use 0
				}
				d rs.Close()
				if resultid { do ##class(%SQL.Diag.Result).addDiagMessage(resultid,"DDL File Import",$SYSTEM.Status.StatusToSQLCODE(sc),$SYSTEM.Status.GetErrorText(sc),3) }
				if 'ignoreerrors { 
					set endStatus =  $$GetLastError^%apiOBJ()
					QUIT
				}
				continue
			}
			i sc s sc=rs.Close() 
			i $$$ISERR(sc) {
				set ErrorCount=ErrorCount+1
				d DisplayError^%apiOBJ($$GetLastError^%apiOBJ())
				if 'table {
					use outfile
					w !,$$$Text("An error occurred during Close:","%SQL.Import"),!,"TIMESTAMP: ",$zdt($h,3),!,"USER: ",?12,$username,!,"NAMESPACE: ",$namespace,!,"STATEMENT:"
					set i=1 do { w !?4,code(i) set i=i+1 } while $d(code(i))
					w ! d DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) w !!,"-------------------------------------------------------------------------",! 
					use 0
				}
				if resultid { do ##class(%SQL.Diag.Result).addDiagMessage(resultid,"DDL File Import",$SYSTEM.Status.StatusToSQLCODE(sc),$SYSTEM.Status.GetErrorText(sc),3) }
				if 'ignoreerrors {
					set endStatus =  $$GetLastError^%apiOBJ()
					QUIT
				}
				continue
			}
			//s code(i)=" ) w !?7,""SQLCODE = ""_$g(SQLCODE)_"" ""_$$sqlcode^%qarSQLImport($g(SQLCODE))"
			//d DefineRemainingCode(i,.sqllines,.code)
			//u 0 w !?6,mode1_"Executing SQL statement..."_mode0
			//d BuildRoutine(rtn,.code)
			//d CompileRoutine(rtn,.sqllines) q:QUIT
			//d RunRoutine(rtn)
			//d:'%sqldebug DeleteRoutine(rtn)
			if verbose { w !?2,mode1_"DONE"_mode0 }
			if resultid { do ##class(%SQL.Diag.Result).addDiagMessage(resultid,"DDL File Import",0,"Success",0) }
		}
		set:SaveUser'=$Username x=$SYSTEM.Security.Users.PrincipalNameSet(SaveUser)	// Restore $username if SETUSER changed it
		goto end
	}
 
	#;-------------------------------------------------------------------
	#;   FDBMS
	#;-------------------------------------------------------------------
	if %DDLMode=$$$SQLDIALECTFDBMS do FDBMSLoad(infile)
 
	#;-------------------------------------------------------------------
	#;   MS SQL Server
	#;     Statements supported:
	#;      CREATE [GLOBAL TEMPORARY] TABLE
	#;      DROP TABLE
	#;      ALTER TABLE
	#;      CREATE VIEW
	#;      DROP VIEW
	#;      INSERT ...
	#;      DELETE ...
	#;      UPDATE ...
	#;      SET OPTION ...
	#;      CREATE [ { UNIQUE | CLUSTERED | NONCLUSTERED } ] INDEX ...
	#;      CREATE TRIGGER
	#;      GRANT { %ALTER | SELECT | INSERT | UPDATE | DELETE | REFERENCES | ALL PRIVILEGES } ...
	#;-------------------------------------------------------------------
	if %DDLMode=$$$SQLDIALECTMSSQL {
		new lineBeforeEos
		s nocheck="" 
		for  {
			u infile r sql q:$zeof=-1  u 0
			s sql=$$$UnicodeStrip(sql),sql=$p(sql,"--")
			if $$$UPPER(sql)[" NOCHECK CONSTRAINT" s nocheck=1 continue
			if $$$UPPER(sql)[" CHECK CONSTRAINT" s nocheck=0 continue
				#; Skip over CREATE PROCEDURE statements (may get confused by CREATE TABLE inside CREATE PROCEDURE)
			if $e($$$Stripper(sql),1,15)="CREATEPROCEDURE" {
				if nosup u nosupfile w !,sql
				f  u infile r sql s sql=$$$UnicodeStrip(sql) u 0 i nosup { u nosupfile w !,sql } q:$zcvt($zstrip(sql,"*PW",,eos),"U")=eos 
				continue
			}
				#;  Multi line statements
			if $e($$$Stripper(sql),1,11)="CREATETABLE"||($e($$$Stripper(sql),1,26)="CREATEGLOBALTEMPORARYTABLE")||($e($$$Stripper(sql),1,9)="DROPTABLE")||($e($$$Stripper(sql),1,10)="ALTERTABLE")||($e($$$Stripper(sql),1,10)="CREATEVIEW")||($e($$$Stripper(sql),1,8)="DROPVIEW")||($e($$$Stripper(sql),1,6)="INSERT")||($e($$$Stripper(sql),1,6)="UPDATE")||($e($$$Stripper(sql),1,6)="DELETE")||($e($$$Stripper(sql),1,9)="SETOPTION")||($e($$$Stripper(sql),1,12)="CREATEUNIQUE")||($e($$$Stripper(sql),1,11)="CREATEINDEX")||($e($$$Stripper(sql),1,15)="CREATECLUSTERED")||($e($$$Stripper(sql),1,18)="CREATENONCLUSTERED")||($e($$$Stripper(sql),1,13)="CREATETRIGGER") {
				k code,sqllines w !
				if nocheck,$e($$$Stripper(sql),1,6)="INSERT" s sql="INSERT %NOCHECK "_$p(sql,"INSERT",2,*)
				if nocheck,$e($$$Stripper(sql),1,6)="DELETE" s sql="DELETE %NOCHECK "_$p(sql,"DELETE",2,*)
				s cnt=cnt+1 s rtn="zZZzCacheSqlDDL"_$s(%sqldebug:cnt,1:"") d DeleteRoutine(rtn)
				s code(1)=rtn_" n %msg,%ROWCOUNT,SQLCODE,stop s $ze="""""
				u 0 w !?2,mode1_$$$Text("SQL statement to execute (number ","%SQL.Import")_cnt_"):"_mode0
				set isLastLine=$$find^%qarmac($$$UPPER(sql),eos,1,$l(sql),.mlcomment,"SQL")
				if $$LastNonWhiteChar($$$UPPER(sql),$l(eos))=eos {		// First, Last, and only line of statement
					set lineBeforeEos=$$$AllButLastPiece(sql,eos)
					if lineBeforeEos'="" {
						s code(2)=" &sql("_$$$MSSQLServerCharStrip(lineBeforeEos),sqllines($i(sqllines))=lineBeforeEos,i=2
						$$$DisplaySQLLine
					}
				}
				else {	// First line of multi-line statement
					s code(2)=" &sql("_$$$MSSQLServerCharStrip(sql),sqllines($i(sqllines))=sql,i=2
					$$$DisplaySQLLine
						#; Get lines 2 through N for the statement
					if $zcvt($zstrip(sql,"*W",,eos),"U")'=eos {
						f i=3:1 {
							u infile r sql s sql=$$$UnicodeStrip(sql),sql=$p(sql,"--") u 0 
							q:$zcvt($zstrip(sql,"*W",,eos),"U")=eos			// This line is the EOS marker
							if $$LastNonWhiteChar($$$UPPER(sql),$l(eos))=eos {	// Last line of statement
								set lineBeforeEos=$$$AllButLastPiece(sql,eos)
								set lineBeforeEos=$e(sql,1,isLastLine-2)
								if lineBeforeEos'="" {
									s code(i)=" "_$$$MSSQLServerCharStrip(lineBeforeEos),sqllines($i(sqllines))=lineBeforeEos
									$$$DisplaySQLLine
								}
								q
							}
							s code(i)=" "_$$$MSSQLServerCharStrip(sql),sqllines($i(sqllines))=sql
							$$$DisplaySQLLine
						}
					}
				}
				s code(i)=$g(code(i))_" ) w !?7,""SQLCODE = ""_$g(SQLCODE)_"" ""_$$sqlcode^%qarSQLImport($g(SQLCODE))"	// DPV2915
				d DefineRemainingCode(i,.sqllines,.code)
				u 0 w !?6,mode1_$$$Text("Executing SQL statement...","%SQL.Import")_mode0
				d BuildRoutine(rtn,.code)
				d CompileRoutine(rtn,.sqllines) q:QUIT
				d RunRoutine(rtn)
				d:'%sqldebug DeleteRoutine(rtn) w !?2,mode1_"DONE"_mode0
				if nosup u nosupfile w !,sql
			}
		}
	}
	
	#;-------------------------------------------------------------------
	#;   Sybase
	#;-------------------------------------------------------------------
	i %DDLMode=$$$SQLDIALECTSYBASE s nocheck="" f  u infile r sql q:$zeof=-1  u 0 d  q:QUIT=1
	. i $$$UPPER(sql)[" ALTER TABLE ",$$$UPPER(sql)[" PARTITION " i nosup { u nosupfile w !,sql } q
	. i $$$UPPER(sql)[" NOCHECK CONSTRAINT" s nocheck=1 q
	. i $$$UPPER(sql)[" CHECK CONSTRAINT" s nocheck=0 q
	#;  Supported statements
	#;      CREATE [GLOBAL TEMPORARY] TABLE
	#;	DROP TABLE
	#;      ALTER TABLE
	#;      CREATE VIEW
	#;      DROP VIEW
	#;      CREATE [ { UNIQUE | CLUSTERED | NONCLUSTERED } ] INDEX ...
	#;      CREATE TRIGGER
	#;      INSERT ...
	#;      DELETE ...
	#;      UPDATE ...
	#;      SET OPTION ...
	#;      GRANT CONNECT ...   (Same as CREATE USER)
	#;      GRANT { ALTER | SELECT | INSERT | UPDATE | DELETE | REFERENCES | ALL PRIVILEGES } ...
	. i $e($$$Stripper(sql),1,11)="CREATETABLE"||($e($$$Stripper(sql),1,26)="CREATEGLOBALTEMPORARYTABLE")||($e($$$Stripper(sql),1,9)="DROPTABLE")||($e($$$Stripper(sql),1,10)="ALTERTABLE")||($e($$$Stripper(sql),1,10)="CREATEVIEW")||($e($$$Stripper(sql),1,8)="DROPVIEW")||($e($$$Stripper(sql),1,12)="CREATEUNIQUE")||($e($$$Stripper(sql),1,11)="CREATEINDEX")||($e($$$Stripper(sql),1,15)="CREATECLUSTERED")||($e($$$Stripper(sql),1,18)="CREATENONCLUSTERED")||($e($$$Stripper(sql),1,13)="CREATETRIGGER")||($e($$$Stripper(sql),1,6)="INSERT")||($e($$$Stripper(sql),1,6)="UPDATE")||($e($$$Stripper(sql),1,6)="DELETE")||($e($$$Stripper(sql),1,9)="SETOPTION")||($e($$$Stripper(sql),1,5)="GRANT") d  q
	.. i $e($$$Stripper(sql),1,8)="GRANTDBA"          i nosup { u nosupfile w !,sql } q  ; Don't support GRANT DBA ...
	.. i $e($$$Stripper(sql),1,13)="GRANTRESOURCE"    i nosup { u nosupfile w !,sql } q  ; Don't support GRANT RESOURCE ...
	.. i $e($$$Stripper(sql),1,10)="GRANTGROUP"       i nosup { u nosupfile w !,sql } q  ; Don't support GRANT GROUP ...
	.. i $e($$$Stripper(sql),1,15)="GRANTMEMBERSHIP"  i nosup { u nosupfile w !,sql } q  ; Don't support GRANT MEMBERSHIP IN GROUP ...
	.. i $e($$$Stripper(sql),1,12)="GRANTEXECUTE"     i nosup { u nosupfile w !,sql } q  ; Don't support GRANT EXECUTE ...
	.. i $e($$$Stripper(sql),1,12)="GRANTCONNECT",sql'["IDENTIFIED" q  i nosup { u nosupfile w !,sql } q  ; Don't support GRANT EXECUTE ... with no password
	.. i nocheck,$e($$$Stripper(sql),1,6)="INSERT" s sql="INSERT %NOCHECK "_$p(sql,"INSERT",2,*)
	.. i nocheck,$e($$$Stripper(sql),1,6)="DELETE" s sql="DELETE %NOCHECK "_$p(sql,"DELETE",2,*)
	.. i $e($$$Stripper(sql),1,12)="GRANTCONNECT" d
	... s sql="CREATE USER "_$p(sql," ",4,*)  ; Turn 'GRANT CONNECT TO user ...' into 'CREATE USER user ...'
	... i $$$Stripper(sql)["ENCRYPTED",sql["\" s sql=$p(sql,"IDENTIFIED")_"IDENTIFY BY xxx" ; Turn encrypted passwords into 'xxx' - don't know how to convert them
	... s sql=$$strrep(sql,"IDENTIFIED","IDENTIFY",1)
	.. k code,sqllines w !
	.. s cnt=cnt+1 s rtn="zZZzCacheSqlDDL"_$s(%sqldebug:cnt,1:"") d DeleteRoutine(rtn)
	.. s code(1)=rtn_" n %msg,%ROWCOUNT,SQLCODE,stop s $ze="""""
	.. u 0 w !?2,mode1_$$$Text("SQL statement to execute (number ","%SQL.Import")_cnt_"):"_mode0
	.. s code(2)=" &sql("_$$$SybaseCharStrip(sql),sqllines($i(sqllines))=sql u 0 $$$DisplaySQLLine
	.. s i=3
	.. if $zcvt($zstrip(sql,"*PW",,eos),"U")'=eos do  // Not a one-line statement
	... f i=3:1 u infile r sql d  u 0 q:$zcvt($zstrip(sql,"*PW",,eos),"U")=eos  s code(i)=" "_sql $$$DisplaySQLLine
	.... s SQL=$$$UPPER(sql)
	.... i SQL["DEFAULT CURRENT USER" s sql=$e(sql,1,$l($p(SQL,"DEFAULT CURRENT USER")))_"DEFAULT CURRENT_USER"_$e(sql,$l($p(SQL,SQL_"DEFAULT CURRENT USER")),*)
	.... i SQL["DEFAULT CURRENT DATE" s sql=$e(sql,1,$l($p(SQL,"DEFAULT CURRENT DATE")))_"DEFAULT CURRENT_DATE"_$e(sql,$l($p(SQL,SQL_"DEFAULT CURRENT DATE")),*)
	.... i SQL["DEFAULT CURRENT TIMESTAMP" s sql=$e(sql,1,$l($p(SQL,"DEFAULT CURRENT TIMESTAMP")))_"DEFAULT CURRENT_TIMESTAMP"_$e(sql,$l($p(SQL,SQL_"DEFAULT CURRENT TIMESTAMP")),*)
	.... i SQL["DEFAULT GETDATE(*)" s sql=$e(sql,1,$l($p(SQL,"DEFAULT GETDATE(*)")))_"DEFAULT GETDATE()"_$e(sql,$l($p(SQL,SQL_"DEFAULT GETDATE(*)")),*)
	.... s sqllines($i(sqllines))=sql,sql=$$$SybaseCharStrip(sql)
	.. s code(i)=" ) w !?7,""SQLCODE = ""_$g(SQLCODE)_"" ""_$$sqlcode^%qarSQLImport($g(SQLCODE))"
	.. d DefineRemainingCode(i,.sqllines,.code)
	.. u 0 w !?6,mode1_$$$Text("Executing SQL statement...","%SQL.Import")_mode0
	.. d BuildRoutine(rtn,.code)
	.. d CompileRoutine(rtn,.sqllines) q:QUIT
	.. d RunRoutine(rtn)
	.. d:'%sqldebug DeleteRoutine(rtn) w !?2,mode1_"DONE"_mode0
	. i nosup,$zstrip(sql,"*W")'="" u nosupfile w !,sql
	
	#;-------------------------------------------------------------------
	#;   Oracle
	#;     Statements supported:
	#;      CREATE TABLE
	#;      ALTER TABLE
	#;      DROP TABLE
	#;      DROP INDEX
	#;      CREATE VIEW
	#;      DROP VIEW   (DPV1810)
	#;      CREATE [ { UNIQUE | BITMAP } ] INDEX ...	// DPV1930 (BITMAP)
	#;      INSERT ...
	#;      UPDATE ...
	#;      DELETE ...
	#;      SET OPTION ...
	#;      CREATE USER
	#;      CREATE ROLE
	#;      GRANT { SELECT | INSERT | UPDATE | DELETE | REFERENCES | ALL PRIVILEGES } ...
	#;-------------------------------------------------------------------
	new StripSQL
	if %DDLMode=$$$SQLDIALECTORACLE do OracleLoad(infile,nosup,nosupfile)
 
	#;-------------------------------------------------------------------
	#;   Informix
	#;-------------------------------------------------------------------
	i %DDLMode=$$$SQLDIALECTINFORMIX Do InformixLoad(infile,outfile,deos)
.
	#;-------------------------------------------------------------------
	#;   InterBase
	#;-------------------------------------------------------------------
	if %DDLMode=$$$SQLDIALECTINTERBASE do InterBaseLoad^%SYS.SECURITY(infile,nosup,nosupfile) 
	
	c infile,outfile if nosup c nosupfile
end	$$$ElapsedTime
	close infile if (($g(outfile)'="") && ($g(outfile)'=0)) { close outfile } if nosup { close nosupfile }
	if verbose {
		write !!!,$$$Text("Statements","%SQL.Import")
		write !,$$$Text(".................compiled: ","%SQL.Import")_cnt
		write !,$$$Text(".....with errors reported: ","%SQL.Import")_ErrorCount
		write !,$$$Text("...with warnings reported: ","%SQL.Import")_WarningCount
	}
	RETURN endStatus
	
OracleLoad(infile,nosup,nosupfile)
	do OracleLoad^%SYS.SECURITY(infile,nosup,nosupfile)
	QUIT
.
OracleLoad2(infile,nosup,nosupfile)
	s cnt=0,mode0=$c(27,91,109),mode1=$c(27,91,49,109),nosup=0,nosupfile="",QUIT=0,$ze=""
	for  u infile r sql q:$zeof=-1  u 0 d  q:QUIT
	. s SQL=$$$StripLeadingWhiteSpace($$$UPPER(sql))	// DPV1810 strip white space
	. s StripSQL=$$$Stripper(SQL)
	. if $e(StripSQL,1,2)="--" quit  // comment line, no need to put in nosup file
	. i $e(StripSQL,1,11)="CREATETABLE"||($e(StripSQL,1,10)="ALTERTABLE")||($e(StripSQL,1,9)="DROPTABLE")||($e(StripSQL,1,10)="CREATEVIEW")||($e(StripSQL,1,12)="CREATEBITMAP")||($e(StripSQL,1,17)="CREATEUNIQUEINDEX")||($e(StripSQL,1,11)="CREATEINDEX")||($e(StripSQL,1,9)="DROPINDEX")||($e(SQL,1,6)="INSERT")||($e(SQL,1,6)="UPDATE")||($e(SQL,1,6)="DELETE")||($e(SQL,1,5)="GRANT")||($e(StripSQL,1,9)="SETOPTION")||($e(StripSQL,1,10)="CREATEUSER")||($e(StripSQL,1,10)="CREATEROLE")||($e(StripSQL,1,9)="DROPTABLE")||($e(StripSQL,1,8)="DROPVIEW") d  q  	// DPV1810 (DROP VIEW)	// DPV1930 (CREATE BITMAP INDEX)
	.. i StripSQL["CREATEORREPLACETRIGGER" i nosup { u nosupfile w !,sql } q
	.. i StripSQL["GRANTCONNECT"||(StripSQL["GRANT""CONNECT""") i nosup { u nosupfile w !,sql } q
	.. i StripSQL["GRANTCREATE" i nosup { u nosupfile w !,sql } q
	.. i StripSQL["GRANTALTER"  i nosup { u nosupfile w !,sql } q  	// DPV1810=
	.. i StripSQL["GRANTEXECUTE"  i nosup { u nosupfile w !,sql } q  	// DPV1870=
	.. i StripSQL["GRANTINDEX"  i nosup { u nosupfile w !,sql } q  	// DPV1870=
	.. n type s type=""
	.. i StripSQL["CREATEINDEX"||(StripSQL["CREATEUNIQUEINDEX")||(StripSQL["CREATEBITMAPINDEX") s type="CRI"	// DPV1930 (BITMAP)
	.. i StripSQL["CREATETABLE" s type="CRT"
	.. i StripSQL["CREATEUSER" s type="CRU"
	.. i StripSQL["ALTERTABLE" s type="ALT"
	.. k code,sqllines w !
	.. s cnt=cnt+1 //s rtn="zZZzCacheSqlDDL"_$s(%sqldebug:cnt,1:"") d DeleteRoutine(rtn)
	.. s code(1)=" n %msg,%ROWCOUNT,SQLCODE,stop s $ze="""""
	.. u 0 w !?2,mode1_"SQL statement to execute (number "_cnt_"):"_mode0
 
	.. s sql=$$$StripTrailingWhiteSpace($tr(sql,$c(9)," ")) d  	// LINE 1 of Statement
	... i type="CRI",sql[")" s sql=$p(sql,")")_")"_$s($e(StripSQL,*-$l(eos)+1,*)=$$$UPPER(eos):eos,1:"") ; everything after the ')' in CREATE INDEX is stripped
	... q:type'="CRT"&&(type'="ALT")
	... n j,SQL s SQL=$$$UPPER(sql)
	... i SQL[" DEFAULT SYSDATE " d  ; some assumptions here, date field, no mixed case, etc...
	.... i sql[" sysdate " s sql=$$strrep(sql," sysdate "," OBJECTSCRIPT '+$H' ",1),SQL=$$strrep(SQL," SYSDATE "," OBJECTSCRIPT '+$H' ",1) q
	.... i sql[" SYSDATE " s sql=$$strrep(sql," SYSDATE "," OBJECTSCRIPT '+$H' ",1),SQL=$$strrep(SQL," SYSDATE "," OBJECTSCRIPT '+$H' ",1)
	... i SQL[" NOT NULL ENABLE" d	 // DPV1870=
	.... i sql[" not null enable" s sql=$$strrep(sql," not null enable"," not null",1),SQL=$$strrep(SQL," NOT NULL ENABLE"," NOT NULL",1) q
	.... i sql[" NOT NULL ENABLE" s sql=$$strrep(sql," NOT NULL ENABLE"," NOT NULL",1),SQL=$$strrep(SQL," NOT NULL ENABLE"," NOT NULL",1)
	.. set isLastLine=$$find^%qarmac($$$UPPER(sql),eos,1,$l(sql),.mlcomment,"SQL")
	.. s code(2)=" &sql("_$s('isLastLine:sql,1:$e(sql,1,isLastLine-2)_")"),sqllines($i(sqllines))=sql u 0 $$$DisplaySQLLine
 
	.. s i=2 if 'isLastLine d  	// LINEs 2 through N of Statement
	... f i=3:1 u infile r sql s sql=" "_$tr(sql,$c(9)," ") d  set isLastLine=$$find^%qarmac($$$UPPER(sql),eos,1,$l(sql),.mlcomment,"SQL") q:isLastLine
	.... i type="CRI" i sql[")" s sql=$p(sql,")")_")"_eos ; everything after the ')' in CREATE INDEX is stripped
	.... i type'="CRT"&&(type'="ALT") u 0 set isLastLine=$$find^%qarmac($$$UPPER(sql),eos,1,$l(sql),.mlcomment,"SQL") q:isLastLine  s code(i)=" "_sql,sqllines($i(sqllines))=sql $$$DisplaySQLLine
	.... q:type'="CRT"&&(type'="ALT")
	.... n j,SQL s SQL=$$$UPPER(sql)
	.... i SQL[" DEFAULT SYSDATE " d  ; some assumptions here, date field, no mixed case, etc...
	..... i sql[" sysdate " s sql=$$strrep(sql," sysdate "," OBJECTSCRIPT '+$H' ",1),SQL=$$strrep(SQL," SYSDATE "," OBJECTSCRIPT '+$H' ",1) q
	..... i sql[" SYSDATE " s sql=$$strrep(sql," SYSDATE "," OBJECTSCRIPT '+$H' ",1),SQL=$$strrep(SQL," SYSDATE "," OBJECTSCRIPT '+$H' ",1)
	.... i SQL[" NOT NULL ENABLE" d	 // DPV1870=
	..... i sql[" not null enable" s sql=$$strrep(sql," not null enable"," not null",1),SQL=$$strrep(SQL," NOT NULL ENABLE"," NOT NULL",1) q
	..... i sql[" NOT NULL ENABLE" s sql=$$strrep(sql," NOT NULL ENABLE"," NOT NULL",1),SQL=$$strrep(SQL," NOT NULL ENABLE"," NOT NULL",1)
	.... u 0 set isLastLine=$$find^%qarmac($$$UPPER(sql),eos,1,$l(sql),.mlcomment,"SQL") q:isLastLine  s code(i)=" "_$s('isLastLine:sql,1:$e(sql,1,isLastLine-2)),sqllines($i(sqllines))=sql $$$DisplaySQLLine
	... s code(i)=" "_$e(sql,1,$l($$$StripTrailingWhiteSpace(sql))-$l(eos))_")" u 0 $$$DisplaySQLLine
 
	.. s i=i+1 s code(i)=" w !?7,""SQLCODE = ""_$g(SQLCODE)_"" ""_$$sqlcode^%qarSQLImport($g(SQLCODE))"
	.. d DefineRemainingCode(i,.sqllines,.code)
	.. u 0 w !?6,mode1_"Executing SQL statement..."_mode0
	.. n tCompileError set tCompileError=0
	.. do RunTempCode^%SYS.SQLSRV(.code,,.status,.sqlcode,.%msg,"DDL Import (Oracle)",,.tCompileError)
	.. if tCompileError,outfile'=$p use outfile do  use 0
	... w !!,"Error processing the following SQL statement (number "_cnt_"):"
	... i $g(sqllines) d
	.... f j=1:1:sqllines QUIT:j=40  w !?5,$$quoter^%qaqcasl(sqllines(j))
	.... i sqllines>40 w !?7,"<REST OF SQL STATEMENT DISPLAY TRUNCATED>"
	... w !?7,"SQLCODE = "_$g(SQLCODE)_" "_$$sqlcode^%qarSQLImport($g(SQLCODE))
	... i SQLCODE=-400 w !?7,"$ze = "_$ze
	... i $g(%msg)'="" w !?7,"%msg = " n w f w=0:64:((($l(%msg)\64)+1)*64) i $e(%msg,w+1,w+64)'="" w:w ! w ?15,$e(%msg,w+1,w+64)
	.. if 'status do  q:QUIT
	... if $ze'="" w !?7,"$ze = "_$ze
	... if sqlcode<0 w !?7,"SQLCODE = ",sqlcode
	... i $g(%msg)'="" w !?7,"%msg = " n w f w=0:64:((($l(%msg)\64)+1)*64) i $e(%msg,w+1,w+64)'="" w:w ! w ?15,$e(%msg,w+1,w+64)
	... w !?7,"Pausing "_errpause_" seconds - read error message!  (Type Q to Quit)" r stop:errpause i $zcvt($e(stop),"U")="Q" s QUIT=1
	.. w !?2,mode1_"DONE"_mode0
	. i nosup u nosupfile w !,sql
	QUIT
	
FDBMSLoad(infile)
	do FDBMSLoad^%SYS.SECURITY(infile)
	QUIT
.
FDBMSLoad2(infile)
	s cnt=0,mode0=$c(27,91,109),mode1=$c(27,91,49,109),nosup=0,nosupfile="",QUIT=0,$ze=""
	f  u infile r sql q:$zeof=-1  u 0 d  q:QUIT=1
	. i $e($$$UPPER($tr(sql," ")),1,6)="CREATE"||($e($$$UPPER($tr(sql," ")),1,6)="ALTER")||($e($$$UPPER(sql),1,10)="SET OPTION") d
	.. k code,sqllines w ! s oneline=0
	.. s cnt=cnt+1 //s rtn="zZZzCacheSqlDDL"_$s(%sqldebug:cnt,1:"") d DeleteRoutine(rtn)
	.. s code(1)=" n %msg,%ROWCOUNT,SQLCODE,stop s $ze="""""
	.. i $e(sql,*)=";" s sql=$e(sql,1,*-1),sqllines($i(sqllines))=sql,oneline=1
	.. u 0 w !?2,mode1_"SQL statement to execute (number "_cnt_"):"_mode0
	.. i oneline s i=2,code(2)=" &sql("_sql_")" u 0 $$$DisplaySQLLine
	.. i 'oneline d
	... s code(2)=" &sql("_sql  u 0 $$$DisplaySQLLine
	... f i=3:1 u infile r sql s sql=$tr(sql,$c(9)) u 0 q:$e(sql,*)=";"  s code(i)=" "_sql,sqllines($i(sqllines))=sql $$$DisplaySQLLine
	... s code(i)=" "_$e(sql,1,*-1)_")"  u 0 $$$DisplaySQLLine
	.. s i=i+1 s code(i)=" w !?7,""SQLCODE = ""_$g(SQLCODE)_"" ""_$$sqlcode^%qarSQLImport($g(SQLCODE))"
	.. d DefineRemainingCode(i,.sqllines,.code)
	.. u 0 w !?6,mode1_"Executing SQL statement..."_mode0
	.. do RunTempCode^%SYS.SQLSRV(.code,,.status,.sqlcode,.%msg,"DDL Import (FDBMS)")
	.. if 'status do  q:QUIT
	... if $ze'="" w !?7,"$ze = "_$ze
	... if sqlcode<0 w !?7,"SQLCODE = ",sqlcode
	... i $g(%msg)'="" w !?7,"%msg = " n w f w=0:64:((($l(%msg)\64)+1)*64) i $e(%msg,w+1,w+64)'="" w:w ! w ?15,$e(%msg,w+1,w+64)
	... w !?7,"Pausing "_errpause_" seconds - read error message!  (Type Q to Quit)" r stop:errpause i $zcvt($e(stop),"U")="Q" s QUIT=1
	QUIT
.
InterBaseLoad(infile,nosup,nosupfile)
	do InterBaseLoad^%SYS.SECURITY(infile,nosup,nosupfile)
	QUIT
.
InterBaseLoad2(infile,nosup,nosupfile)
	s cnt=0,mode0=$c(27,91,109),mode1=$c(27,91,49,109),nosup=0,nosupfile="",QUIT=0,$ze=""
	for  u infile r sql q:$zeof=-1  u 0 d  q:QUIT
	#;  Multi line statements
	#;      CREATE TABLE
	#;      ALTER TABLE
	#;      CREATE VIEW
	#;      CREATE [ UNIQUE ] INDEX ...
	#;      CREATE ROLE
	. i $e($$$UPPER(sql),1,6)="CREATE"!($e($$$UPPER(sql),1,11)="ALTER TABLE") d  q
	.. i $$$UPPER(sql)["CREATE DATABASE"  i nosup { u nosupfile w !,sql } q
	.. i $$$UPPER(sql)["CREATE DOMAIN"    i nosup { u nosupfile w !,sql } q
	.. i $$$UPPER(sql)["CREATE EXCEPTION" i nosup { u nosupfile w !,sql } q
	.. i $$$UPPER(sql)["CREATE GENERATOR" i nosup { u nosupfile w !,sql } q
	.. i $$$UPPER(sql)["CREATE PROCEDURE" i nosup { u nosupfile w !,sql } q
	.. i $$$UPPER(sql)["CREATE TRIGGER"   i nosup { u nosupfile w !,sql } q
	.. k code,sqllines w !
	.. s cnt=cnt+1 //s rtn="zZZzCacheSqlDDL"_$s(%sqldebug:cnt,1:"") d DeleteRoutine(rtn)
	.. s code(1)=" n %msg,%ROWCOUNT,SQLCODE,stop s $ze="""""
	.. u 0 w !?2,mode1_"SQL statement to execute (number "_cnt_"):"_mode0
	.. s sql=$$$StripTrailingWhiteSpace($p($tr(sql,$c(9)," "),"--"))
	.. set isLastLine=$$find^%qarmac($$$UPPER(sql),eos,1,$l(sql),.mlcomment,"SQL")
	.. s code(2)=" &sql("_$s('isLastLine:sql,1:$e(sql,1,isLastLine-2)_")"),sqllines($i(sqllines))=sql u 0 $$$DisplaySQLLine
	.. i 'isLastLine d
	... f i=3:1 u infile r sql s sql=" "_$$$StripTrailingWhiteSpace($p($tr(sql,$c(9)," "),"--")) u 0 set isLastLine=$$find^%qarmac($$$UPPER(sql),eos,1,$l(sql),.mlcomment,"SQL") q:isLastLine  s code(i)=" "_sql,sqllines($i(sqllines))=sql $$$DisplaySQLLine
	... s code(i)=" "_$e(sql,1,isLastLine-2)_")" u 0 $$$DisplaySQLLine
	.. s i=i+1 s code(i)=" w !?7,""SQLCODE = ""_$g(SQLCODE)_"" ""_$$sqlcode^%qarSQLImport($g(SQLCODE))"
	.. d DefineRemainingCode(i,.sqllines,.code)
	.. u 0 w !?6,mode1_"Executing SQL statement..."_mode0
	.. do RunTempCode^%SYS.SQLSRV(.code,,.status,.sqlcode,.%msg,"DDL Import (InterBase)")
	.. if 'status do  q:QUIT
	... if $ze'="" w !?7,"$ze = "_$ze
	... if sqlcode<0 w !?7,"SQLCODE = ",sqlcode
	... i $g(%msg)'="" w !?7,"%msg = " n w f w=0:64:((($l(%msg)\64)+1)*64) i $e(%msg,w+1,w+64)'="" w:w ! w ?15,$e(%msg,w+1,w+64)
	... w !?7,"Pausing "_errpause_" seconds - read error message!  (Type Q to Quit)" r stop:errpause i $zcvt($e(stop),"U")="Q" s QUIT=1
	. i nosup u nosupfile w !,sql 
	QUIT
	
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
DeleteRoutine(rtn,audit=1) public {
	#;  Given a routine name, delete it
	if audit $$$AuditRtnDelete("",rtn)
	if $d(^rMAC(rtn)) k ^rMAC(rtn),^rINDEX(rtn,"MAC") $$$DocJrnAdd("MAC",rtn,ns)
	if $d(^ROUTINE(rtn)) k ^ROUTINE(rtn),^rINDEX(rtn,"INT"),^rINDEX(rtn,"BAS") $$$DocJrnAdd("INT",rtn,ns)
	if $d(^rOBJ(rtn)) k ^rOBJ(rtn),^rINDEX(rtn,"OBJ")
}
BuildRoutine(rtn,code) public {
	#;  Build a routine 'rtn' using the code defined in the code array
	d DeleteRoutine(rtn,0)
	s tim=$zutil(188),^rMAC(rtn,0)=tim
	s size=0
	f i=0:1:code(0) s:$g(code(i))'="" ^rMAC(rtn,0,i)=code(i),size=size+$l(code(i))
	set ^rMAC(rtn,0,"GENERATED")=1,^rMAC(rtn,0,"SIZE")=size
	set ^rINDEX(rtn,"MAC")=$lb($$$TimeToODBC(tim),size,1)
	$$$DocJrnAdd("MAC",rtn,ns)
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
CompileRoutine(rtn,sqllines,success) ;
	#;  Given a routine name, compile it
	n mppmsg,%msg,SQLCODE,stop s $ze="",success=1
	d ^%qarmac(rtn,,,0,0,"mppmsg",.success,,,,,,,1)	// DPV2247 (Allow routine splitting)
	i success QUIT
	i outfile'=$p d
	. u outfile
	. w !!,"Error compiling the following SQL statement (number "_cnt_"):"
	. f j=1:1:sqllines w !?5,sqllines(j)
	. i $g(mppmsg(0)) f j=1:1:mppmsg(0) w !?2,$g(mppmsg(j))
	. i $ze'="" w !?7,"$ze = "_$ze
	. i $g(%msg)'="" w !?7,"%msg = " n w f w=0:64:((($l(%msg)\64)+1)*64) i $e(%msg,w+1,w+64)'="" w:w ! w ?15,$e(%msg,w+1,w+64)
	. u 0 
	i $g(mppmsg(0)) f j=1:1:mppmsg(0) w !?2,$g(mppmsg(j))
	i $ze'="" w !?7,"$ze = "_$ze
	i $g(%msg)'="" w !?7,"%msg = " n w f w=0:64:((($l(%msg)\64)+1)*64) i $e(%msg,w+1,w+64)'="" w:w ! w ?15,$e(%msg,w+1,w+64)
	w !?7,"Pausing "_errpause_" seconds - read error message!  (Type Q to Quit)" r stop:errpause i $zcvt($e(stop),"U")="Q" s QUIT=1
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
RunRoutine(rtn) ;
	#;  Given a routine name, run it
	i '$d(^rOBJ(rtn)) QUIT  ; Must have been a compiation error    ; w !?10,"Routine "_rtn_" does not exist" QUIT
	d @("^"_rtn)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
DefineRemainingCode(i,sqllines,code) 
	s code($i(i))=" QUIT:$g(SQLCODE)'<0"
	s code($i(i))=" i outfile'=$p u outfile d  u 0"
	s code($i(i))=" . w !!,""Error processing the following SQL statement (number "_cnt_"):"""
	i $g(sqllines) d
	. f j=1:1:sqllines QUIT:j=40  s code($i(i))=" . w !?5,"_$$quoter^%qaqcasl(sqllines(j))
	. i sqllines>40 s code($i(i))=" . w !?7,""<REST OF SQL STATEMENT DISPLAY TRUNCATED>"""
	s code($i(i))=" . w !?7,""SQLCODE = ""_$g(SQLCODE)_"" ""_$$sqlcode^%qarSQLImport($g(SQLCODE))"
	s code($i(i))=" . i SQLCODE=-400 w !?7,""$ze = ""_$ze"
	s code($i(i))=" . i $g(%msg)'="""" w !?7,""%msg = "" n w f w=0:64:((($l(%msg)\64)+1)*64) i $e(%msg,w+1,w+64)'="""" w:w ! w ?15,$e(%msg,w+1,w+64)"
	s code($i(i))=" i SQLCODE=-400 w !?7,""$ze = ""_$ze"
	s code($i(i))=" i $g(%msg)'="""" w !?7,""%msg = "" n w f w=0:64:((($l(%msg)\64)+1)*64) i $e(%msg,w+1,w+64)'="""" w:w ! w ?15,$e(%msg,w+1,w+64)"
	s code($i(i))=" i SQLCODE<0 w !?7,""Pausing "_errpause_" seconds - read error message!  (Type Q to Quit)"" r stop:"_errpause_" i $zcvt($e(stop),""U"")=""Q"" s QUIT=1"
	s code($i(i))=" QUIT"
	s code(0)=i
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
LastNonWhiteChar(str,len=1) ;
	#;  Given a string of Characters return the last [len] non-whitespace character
	s str=$tr(str,$c(9,32)) QUIT:len=1 $e(str,*)  QUIT $e(str,*-len+1,*)
.
FixNullCon(str) ;
	#;  Informix uses the syntax NOT NULL CONSTRAINT <conname>
	#;  rather than CONSTRAINT <conname> NOT NULL
	#;  This code will twist it around into something we like.
	n i,end,pos,replace,with
	s pos=$f(str,"not null constraint") ; now pos is one past 'constraint'
	#;  Skip all spaces between CONSTRAINT and conname
	f  q:$e(str,pos)'=" "  s pos=pos+1
	#;  Find the constraint name (go until space or comma)
	f i=pos:1 i " ,"[$e(str,i) s end=i-1 q
	s replace="not null constraint "_$e(str,pos,end)
	s with="constraint "_$e(str,pos,end)_" not null"
	QUIT $$strrep(str,replace,with,1)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
FixPrimaryKey(str) ;
	#;  Informix uses the syntax PRIMARY KEY (fldlist) CONSTRAINT <conname>
	#;  rather than CONSTRAINT <conname> PRIMARY KEY (fldlist)
	#;  This code will twist it around into something we like.
	n i,end,pos,replace,with
	s pos=$f(str,") constraint") ; now pos is one past 'constraint'
	#;  Skip all spaces between CONSTRAINT and conname
	f  q:$e(str,pos)'=" "  s pos=pos+1
	#;  Find the constraint name (go until space or comma)
	f i=pos:1 i " ,"[$e(str,i) s end=i-1 q
	s cname=$e(str,pos,end)
	s replace="not null constraint "_$e(str,pos,end)
	s with="constraint "_$e(str,pos,end)_" not null"
	QUIT $$strrep(str,replace,with,1)
.
ISPLLoadDir(dir,pLogFile="",deos=";") public {
	new %DDLMethodLanguage
	set %DDLMethodLanguage=$$$cMETHLANGUAGEISPL
	do InformixLoadDir(.dir,.pLogFile,.deos)
}
.
	// Called from:
	// - locally
	// Used to get all files within a directory, recursively, for a DDL Directory Import
LoadFiles(pDirectory, pExtension, pTempNode, pRecurse) [] {
		// Get the requested files for this directory
	set sc = $$$OK
	for i=1:1 {
		set ext=$PIECE(pExtension,",",i)
		QUIT:ext=""
		s sc=$$GetFiles^%apiOBJ(pDirectory,"*."_ext,pTempNode) i $$$ISERR(sc) d DecomposeStatus^%occSystem(sc,.errorlog,.qstruct) QUIT
	}
	if $$$ISERR(sc) QUIT sc
	if pRecurse {
		set tDirNode = $increment(^IRIS.Temp) kill ^IRIS.Temp(tDirNode)
		set sc = $$GetDirs^%apiOBJ(pDirectory,"*",tDirNode)
		if $$$ISERR(sc) QUIT sc
		set tDirectory = $Order(^IRIS.Temp(tDirNode,""))
		while tDirectory '= "" {
			set sc = $$LoadFiles(tDirectory,.pExtension,pTempNode,1)  if $$$ISERR(sc) QUIT
			set tDirectory = $Order(^IRIS.Temp(tDirNode,tDirectory))
		}
		kill ^IRIS.Temp(tDirNode)
	}
	QUIT sc
}
.
InformixLoadDir(dir,pLogFile="",deos=";",extensions="sql",recurse=0,verbose=0,ignoreErrors=1,resultID=0) [] PUBLIC {
		// Load all *.sql files from the directory (or from another file extension(s) if specified)
	n %DDLMode
	s %DDLMode=$$$SQLDIALECTINFORMIX
	s sc=$$$OK
	s tempnode=$increment(^IRIS.Temp) k ^IRIS.Temp(tempnode),^||%isc.imperr
	if 'pLogFile { set newLogFile=0 do:pLogFile'="" ##class(%Library.File).Delete(pLogFile) } else { set newLogFile=1 }
	set tOverallCounts = $lb(0,0,0), tFileCount=0, tTime = $zh
	set sc = $$LoadFiles(dir,extensions,tempnode,recurse)
	if $$$ISERR(sc) RETURN sc
	s file=""
	for  {
		s file=$o(^IRIS.Temp(tempnode,file)) q:file=""
		if extensions="sql" { If $zconvert($piece(file,".",$length(file,".")),"l")'="sql" continue }
		s sc=$$InformixLoad(file,pLogFile,deos,newLogFile,.tOverallCounts,,verbose,ignoreErrors,resultID),tFileCount=tFileCount+1
		m classlist=onelist
		if ('ignoreErrors && $$$ISERR(sc)) { RETURN sc }
	}
	k ^IRIS.Temp(tempnode)
.
	if verbose {
		write !!!,$$$Text("------  DIRECTORY LOAD TOTALS  ------","%SQL.Import")
		write !!,$$$Text("Files loaded:              ","%SQL.Import"),tFileCount
		write !,$$$Text("Statements:","%SQL.Import")
		write !,$$$Text(".................compiled: ","%SQL.Import")_$li(tOverallCounts,1)
		write !,$$$Text(".....with errors reported: ","%SQL.Import")_$li(tOverallCounts,2)
		write !,$$$Text("...with warnings reported: ","%SQL.Import")_$li(tOverallCounts,3)
	}
	if newLogFile=0 {
		set tLog = ##class(%XSQL.Log).%New(pLogFile,0)
		if $Get(^||%isc.imperr) {
			do tLog.write("---------------------- ",2)
			do tLog.write($$$Text("ERROR/WARNING Summary for all files ","%SQL.Import"))
			do tLog.write("---------------------- ")
			for i=1:1:^||%isc.imperr do tLog.write(^||%isc.imperr(i))
		}
		set tTime=($zh-tTime),tTimeString=""
		If tTime>3600 s tTimeString=(tTime\3600)_" hours ",tTime=tTime-((tTime\3600)*3600)
		If tTime>60   s tTimeString=tTimeString_(tTime\60)_" minutes " s tTime=tTime-((tTime\60)*60)
		If tTime      s tTimeString=tTimeString_tTime_" seconds"
		do tLog.write($$$Text("------  DIRECTORY LOAD TOTALS  ------","%SQL.Import"),3)
		do tLog.write($$$Text("Files loaded:              ","%SQL.Import")_tFileCount,2)
		do tLog.write($$$Text("Statements:","%SQL.Import"))
		do tLog.write($$$Text(".................compiled: ","%SQL.Import")_$li(tOverallCounts,1))
		do tLog.write($$$Text(".....with errors reported: ","%SQL.Import")_$li(tOverallCounts,2))
		do tLog.write($$$Text("...with warnings reported: ","%SQL.Import")_$li(tOverallCounts,3))
		do tLog.write($$$Text(".............elapsed time: ","%SQL.Import")_(tTimeString))
		k ^||%isc.imperr
	}
	quit $$$OK
}
.
	// Called from:
	// - DDLImport^%apiSQL
	// - locally
InformixLoad(pInputFile,pLogFile="",deos=";",newLogFile=1,tOverallCounts="",TranslateTable="",verbose=0,ignoreErrors=1,resultID=0) [] PUBLIC {
		#; if newLogFile=0, we might are probably doing a LoadDir and logging all results to one file
	try {
		s:'$d(%DDLMode) %DDLMode=$$$SQLDIALECTINFORMIX
		if verbose { write %DDLMode_$$$Text(" Conversion Utility (v3)","%SQL.Import"),!,$$$Text("Reading source from file: ","%SQL.Import"),pInputFile }
		if ((pLogFile '= "") && (pLogFile '= 0)) {
			if +pLogFile { set pLogFile = $Piece(pInputFile,".",1,$Length(pInputFile,".")-1) _ ".log" }
			set tLog = ##class(%XSQL.Log).%New(pLogFile,newLogFile), tLogActive = 1
			if verbose { write $$$Text(", logging activity to: ","%SQL.Import"),pLogFile }
		} else { set tLog = "", tLogActive = 0 }
		$$$createQueue(tErrorQ)
		if verbose { write ! }
		set tStatus = $$$OK
		if tLogActive { do tLog.write($$$Text("++++++  Processing SQL script file: ","%SQL.Import") _ pInputFile _"  +++++       "_$ZDateTime($Horolog),1,2) }
		set tStatementCount = 0, tStatementCount = 0, tErrorCount = 0, tWarningCount = 0, tCount = 0
		set tBatch = ##class(%Stream.FileCharacter).%New()
		close pInputFile
		if TranslateTable'="" { set tBatch.TranslateTable=TranslateTable }
		do tBatch.LinkToFile(pInputFile)
		set tBatch.LineTerminator = $Char(13,10)
		set tMLCommentCnt=0
		do {
			set tSourceLine = tBatch.ReadLine() 
			set tCount = tCount + 1
			if %DDLMode=$$$SQLDIALECTINFORMIX { 
				if $e($$$Stripper2(tSourceLine))="{" set tMLCommentCnt=tMLCommentCnt+1 continue
				if tSourceLine["}" {
					set tBracePos=$$find^%qarmac(tSourceLine,"}",1,$l(tSourceLine),0,"SQL")
					if tBracePos {
						set tMLCommentCnt=tMLCommentCnt-1
						if $$$Stripper2($e(tSourceLine,tBracePos,*))="" continue
					}
				}
				continue:tMLCommentCnt	// We are within a multi-line comment - get next line
			}
			if %DDLMode=$$$SQLDIALECTINFORMIX,$e($$$Stripper2(tSourceLine),1,16)="CREATE PROCEDURE" {
					#; read a batch
				set tStatementCount = tStatementCount + 1, tLineCount = 1, tInProc = 1
				set tSource = ##class(%Stream.GlobalCharacter).%New()
				set tSource.LineTerminator = $Char(10)
				do tSource.WriteLine(tSourceLine)
					#; Get the schema.proc from the CREATE PROCEDURE line
				set tSchemaProc = $Piece($Translate($ZStrip($Extract(tSourceLine,17,*),"<>W")," (,"_$Char(9),$Char(0,0,0,0)),$Char(0),1)
				if verbose {
					write !!,tStatementCount,". ",tSchemaProc
					write !,$Justify(tLineCount,4),". ",tSourceLine
				}
				if tLogActive {
					do tLog.write(tStatementCount_". "_tSchemaProc,2)
					do tLog.write($Justify(tLineCount,4)_". "_tSourceLine,1,1)
				}
					#; Now read the input stream until END PROCEDURE; is found
				do {
					set tSourceLine = tBatch.ReadLine()
					set tCount = tCount + 1, tLineCount = tLineCount + 1
					set tSourceLine = $tr(tSourceLine,$c(9)," ")
					use 0
					set tEndToken = $Extract($ZConvert($ZStrip($Piece(tSourceLine,"--"),"*W"),"u"),*-13,*)
					if (tEndToken [ "ENDPROCEDURE") || (tBatch.AtEnd) { set tInProc = 0 }
					do tSource.WriteLine(tSourceLine)
					if verbose { write !,$Justify(tLineCount,4),". ",tSourceLine }
					if tLogActive { do tLog.write($Justify(tLineCount,4)_". "_tSourceLine) }
				} while ((tInProc) || ($Extract(tEndToken,*) '= deos)) && ('tBatch.AtEnd)
				kill tCode
				set tCode = 0, errFound = 0, tStatus = $$$OK
				if verbose { write ! }
				do tSource.Rewind()
				if $get(%DDLMethodLanguage) = $$$cMETHLANGUAGEISPL {
						// just create a shell and load the ISPL source
					do loadISPLSource(tSchemaProc,tSource,pInputFile)
				} else {
					try {
						set tStatus = ##class(%Compiler.Informix.COS).compileStream(tSource,$$GetPackage^%apiDDL($$$DefaultSchema),.tCode,.warning)
					} catch tException {
						set tStatus = tException.AsStatus()
					}
					if $$$ISERR(tStatus) {
						set errFound = 1
						if verbose { do $system.OBJ.DisplayError(tStatus) }
						if resultID { do ##class(%SQL.Diag.Result).addDiagMessage(resultID, "DDL File Import", $SYSTEM.Status.StatusToSQLCODE(tStatus), $SYSTEM.Status.GetErrorText(tStatus), 3) }
						if tLogActive {
							do tLog.write("ERRORS: ",2)
							set tStatusCount =  tLog.logStatus(tStatus)
						}
						else {
							kill tErrorList
							do DecomposeStatus^%apiOBJ(tStatus,.tErrorList)
							set tStatusCount = +$Get(tErrorList)
						}
						set tErrorCount = tErrorCount + tStatusCount
						$$$queue(tErrorQ,$Listbuild(tStatementCount,tSchemaProc,tStatus,tStatusCount,1))
						if 'ignoreErrors { RETURN tStatus }
					}
					if $$$ISERR(warning) {
						$$$queue(tErrorQ,$Listbuild(tStatementCount,tSchemaProc,warning,0))
						write !,"WARNINGS: ",!
						if verbose { do $system.OBJ.DisplayError(warning) }
						if tLogActive {
							do tLog.write("WARNINGS: ",2)
							set tStatusCount =  tLog.logStatus(warning)
						}
						else {
							kill tErrorList
							do DecomposeStatus^%apiOBJ(warning,.tErrorList)
							set tStatusCount = +$Get(tErrorList)
						}
						set tWarningCount = tWarningCount + tStatusCount
						$$$queue(tErrorQ,$Listbuild(tStatementCount,tSchemaProc,warning,tStatusCount,1))
					}
						#; if there's generated code then create the procedure as a classmethod in some class - that class is determined in createProc.
					if $Get(tCode) {
						set tStatus = $$createInformixProcedure(.tCode,tSource,tLog,pInputFile)
						if $$$ISERR(tStatus) {
							set errFound = 1
							if verbose { do $system.OBJ.DisplayError(tStatus) }
							if resultID { do ##class(%SQL.Diag.Result).addDiagMessage(resultID, "DDL File Import", $SYSTEM.Status.StatusToSQLCODE(tStatus), $SYSTEM.Status.GetErrorText(tStatus), 3) }
							if tLogActive {
								do tLog.write("ERRORS: ",2)
								set tStatusCount =  tLog.logStatus(tStatus)
							}
							else {
								kill tErrorList
								do DecomposeStatus^%apiOBJ(tStatus,.tErrorList)
								set tStatusCount = +$Get(tErrorList)
							}
							set tErrorCount = tErrorCount + tStatusCount
							$$$queue(tErrorQ,$Listbuild(tStatementCount,tSchemaProc,tStatus,tStatusCount,1))
							if 'ignoreErrors { RETURN tStatus }
						}
					}
					if 'errFound && resultID { do ##class(%SQL.Diag.Result).addDiagMessage(resultID,"DDL File Import",0,"Success",0) }
				}
			}
			elseif	 $e($$$Stripper2(tSourceLine),1,12)="CREATE TABLE" || 
					($e($$$Stripper2(tSourceLine),1,11)="CREATE VIEW") || 
					($e($$$Stripper2(tSourceLine),1,12)="CREATE INDEX") || 
					($e($$$Stripper2(tSourceLine),1,19)="CREATE UNIQUE INDEX") || 
					($e($$$Stripper2(tSourceLine),1,11)="ALTER TABLE") || 
					(%DDLMode = $$$SQLDIALECTMYSQL && ($e($$$Stripper2(tSourceLine),1,18)="ALTER ONLINE TABLE")) || 
					(%DDLMode = $$$SQLDIALECTMYSQL && ($e($$$Stripper2(tSourceLine),1,19)="ALTER OFFLINE TABLE")) || 
					(%DDLMode = $$$SQLDIALECTMYSQL && ($e($$$Stripper2(tSourceLine),1,18)="ALTER IGNORE TABLE")) || 
					(%DDLMode = $$$SQLDIALECTMYSQL && ($e($$$Stripper2(tSourceLine),1,25)="ALTER ONLINE IGNORE TABLE")) || 
					(%DDLMode = $$$SQLDIALECTMYSQL && ($e($$$Stripper2(tSourceLine),1,26)="ALTER OFFLINE IGNORE TABLE")) || 
					($e($$$Stripper2(tSourceLine),1,10)="DROP TABLE") || 
					($e($$$Stripper2(tSourceLine),1,7)="INSERT ") || 
					($e($$$Stripper2(tSourceLine),1,7)="UPDATE ") || 
					($e($$$Stripper2(tSourceLine),1,6)="GRANT ") || 
					($e($$$Stripper2(tSourceLine),1,7)="REVOKE ") {
					#; read a batch
				set tStatementCount = tStatementCount + 1, tLineCount = 1
				if 0,%DDLMode = $$$SQLDIALECTMYSQL {
					if $e($$$Stripper2(tSourceLine),1,18)="ALTER ONLINE TABLE"  { set $p(tSourceLine,"TABLE")="ALTER " }
					elseif $e($$$Stripper2(tSourceLine),1,19)="ALTER OFFLINE TABLE" { set $p(tSourceLine,"TABLE")="ALTER " }
					elseif $e($$$Stripper2(tSourceLine),1,18)="ALTER IGNORE TABLE"  { set $p(tSourceLine,"TABLE")="ALTER " }
					elseif $e($$$Stripper2(tSourceLine),1,25)="ALTER ONLINE IGNORE TABLE"  { set $p(tSourceLine,"TABLE")="ALTER " }
					elseif $e($$$Stripper2(tSourceLine),1,26)="ALTER OFFLINE IGNORE TABLE" { set $p(tSourceLine,"TABLE")="ALTER " }
				}
				set tEndToken = $$GetLastToken(tSourceLine) //$Extract($ZConvert($ZStrip($Piece(tSourceLine,"--"),"*W"),"u"),*)
				if $lg(tEndToken)=deos { set tSourceLine=$e(tSourceLine,1,$lg(tEndToken,2)-1) }
				set tEndToken=$lg(tEndToken)
				set tSourceLine = $tr(tSourceLine,$c(9)," ")
				if %DDLMode=$$$SQLDIALECTMYSQL set:tSourceLine["\'" tSourceLine=$replace(tSourceLine,"\'","''")
				set tSource = ##class(%Stream.GlobalCharacter).%New()
				set tSource.LineTerminator = $Char(10)
				do tSource.WriteLine(tSourceLine)
					#; Get this out for logging purposes
				set tSchemaProc = $Piece(tSourceLine," ",1,2)
				if verbose {
					write !!,tStatementCount,". ",tSchemaProc
					write !,$Justify(tLineCount,4),". ",tSourceLine
				}
				if tLogActive {
					do tLog.write(tStatementCount_". "_tSchemaProc,2)
					do tLog.write($Justify(tLineCount,4)_". "_tSourceLine,1,1)
				}
					#; Now read the input stream until a line ends with ';' (or the deos value) is found
				while tEndToken '= deos {
					set tSourceLine = tBatch.ReadLine()
					set tCount = tCount + 1, tLineCount = tLineCount + 1
					set tSourceLine = $tr(tSourceLine,$c(9)," ")
					if %DDLMode=$$$SQLDIALECTMYSQL set:tSourceLine["\'" tSourceLine=$replace(tSourceLine,"\'","''")
					use 0
					set tEndToken = $Extract($ZConvert($ZStrip($Piece(tSourceLine,"--"),"*W"),"u"),*)
					do tSource.WriteLine($p(tSourceLine,"--"))
					if verbose { write !,$Justify(tLineCount,4),". ",tSourceLine }
					if tLogActive { do tLog.write($Justify(tLineCount,4)_". "_tSourceLine) }
					q:tBatch.AtEnd	// Quit While loop if at the end of the batch file
				}
				kill tCode
				set tCode = 0
				if verbose { write ! }
				do tSource.Rewind()
				set sql=tSource.Read($$$MaxLocalLength)
				s sql=$tr($zstrip(sql,">W",$c(10)_";"),$c(10)," ")
				s rs=##class(%ResultSet).%New("%DynamicQuery:SQL")
				s tStatus=rs.Prepare(sql)
				if '$$$ISERR(tStatus) s tStatus=rs.Execute(sql)
				if $$$ISERR(tStatus) {
					if verbose { do $system.OBJ.DisplayError(tStatus) }
					if resultID { do ##class(%SQL.Diag.Result).addDiagMessage(resultID, "DDL File Import", $SYSTEM.Status.StatusToSQLCODE(tStatus), $SYSTEM.Status.GetErrorText(tStatus), 3) }
					if tLogActive {
						do tLog.write("ERRORS: ",2)
						set tStatusCount =  tLog.logStatus(tStatus)
					}
					else {
						kill tErrorList
						do DecomposeStatus^%apiOBJ(tStatus,.tErrorList)
						set tStatusCount = +$Get(tErrorList)
					}
					set tErrorCount = tErrorCount + tStatusCount
					$$$queue(tErrorQ,$Listbuild(tStatementCount,tSchemaProc,tStatus,tStatusCount,1))
					if 'ignoreErrors { QUIT }
				} else {
					if resultID { do ##class(%SQL.Diag.Result).addDiagMessage(resultID,"DDL File Import",0,"Success",0) }
					if verbose { write ?6,"Success!",! }
				}
				k rs
			}
			elseif $Translate(tSourceLine," "_$Char(9)) '= "" {
				if verbose { write !,$Justify($g(tLineCount),4),$$$Text(". SKIPPING non-SQL SOURCE: ","%SQL.Import"),tSourceLine }
				if tLogActive { do tLog.write($Justify(tCount,4)_$$$Text(". SKIPPING non-SQL SOURCE: ","%SQL.Import")_tSourceLine) }
			}
		} while 'tBatch.AtEnd
	}
	catch tException {
		set tStatus = tException.AsStatus()
		do $system.OBJ.DisplayError(tStatus)
		if $Get(tLogActive) { if $IsObject(tLog) { do tLog.logStatus(tStatus) } else { do ##class(%XSQL.Log).logStatus(tStatus) } }
		RETURN tStatus
	}
	if verbose {
		write !!!,$$$Text("Statements","%SQL.Import")
		write !,$$$Text(".................compiled: ","%SQL.Import")_tStatementCount
		write !,$$$Text(".....with errors reported: ","%SQL.Import")_tErrorCount
		write !,$$$Text("...with warnings reported: ","%SQL.Import")_tWarningCount
	}
	s:newLogFile=0 $li(tOverallCounts,1)=$li(tOverallCounts,1)+tStatementCount
	s:newLogFile=0 $li(tOverallCounts,2)=$li(tOverallCounts,2)+tErrorCount
	s:newLogFile=0 $li(tOverallCounts,3)=$li(tOverallCounts,3)+tWarningCount
	if tLogActive {
		$$$dequeue(tErrorQ,tError)
		if $Get(tError) '= "" {
			do tLog.write("---------------------- ",2)
			do tLog.write($$$Text("ERROR/WARNING Summary for file: ","%SQL.Import")_pInputFile)
			do tLog.write("---------------------- ")
			set tLastProc = "", tProcedureErrorCount = 0
			do {
				set tProcedureNbr = $List(tError,1), tSchemaProc = $List(tError,2), tErrorStatus = $List(tError,3), tStatusCount = $List(tError,4), tErrorSeverity = $List(tError,5)
				if tLastProc '= tProcedureNbr {
					if tLastProc { do tLog.write(tProcedureErrorCount_$$$Text(" errors/warnings encountered","%SQL.Import")) s:newLogFile=0 ^||%isc.imperr($i(^||%isc.imperr))=tProcedureErrorCount_$$$Text(" errors/warnings encountered","%SQL.Import") }
					do tLog.write(tProcedureNbr_$$$Text(". statement/procedure '","%SQL.Import")_tSchemaProc_$$$Text("' in file ","%SQL.Import")_pInputFile,2) 
					s:newLogFile=0 ^||%isc.imperr($i(^||%isc.imperr))="",^||%isc.imperr($i(^||%isc.imperr))=tProcedureNbr_$$$Text(". statement/procedure '","%SQL.Import")_tSchemaProc_$$$Text("' in file ","%SQL.Import")_pInputFile
					set tProcedureErrorCount = 0
					set tLastProc = tProcedureNbr
				}
				do tLog.logStatus(tErrorStatus)
				if newLogFile=0 {
					s ^||%isc.imperr($i(^||%isc.imperr))="-----",^||%isc.imperr($i(^||%isc.imperr))=""
					If $Get(Message)'="" { s ^||%isc.imperr($i(^||%isc.imperr))=Message }
					Kill errorlist
					Do DecomposeStatus^%apiOBJ(tErrorStatus,.errorlist)
					For i=1:1:$Get(errorlist) { s ^||%isc.imperr($i(^||%isc.imperr))=errorlist(i) }
					If $Data(Outcome)\10 { s ^||%isc.imperr($i(^||%isc.imperr))="["_##class(%XSQL.Format).Flatten(.Outcome)_"]" }
					s ^||%isc.imperr($i(^||%isc.imperr))="-----"
				}
				set tProcedureErrorCount = tProcedureErrorCount + tStatusCount
				$$$dequeue(tErrorQ,tError)
			} while tError '= ""
		}
		do tLog.write($$$Text("Statements","%SQL.Import"),3)
		do tLog.write($$$Text(".................compiled: ","%SQL.Import")_tStatementCount)
		do tLog.write($$$Text(".....with errors reported: ","%SQL.Import")_tErrorCount)
		do tLog.write($$$Text("...with warnings reported: ","%SQL.Import")_tWarningCount)
	}
	quit tStatus
}
.
createInformixProcedure(pCode,pSource,pLog,pInputFile = "") [] PUBLIC {
	#dim pSource as %Stream.Object
	try {
		if $IsObject($Get(pLog)) { set tLogActive = 1 } else { set tLogActive = 0 }
			#; The first three lines of the code generated by %Compiler.Informix.COS are expected to be:
			#;	#CREATEPROCEDURE:<name>
		set tCode = $Get(pCode(1))
		set procedureType = $case($piece(tCode,":",1),
									"#CREATEPROCEDURE"	: "p",
									"#ITERATORFUNCTION"	: "i",
														: "p"
								)
		set schemaProc = $case(procedureType,
									"p"	: $extract(pCode(1),$find(pCode(1),":"),*),
										: pCode(2)
								)
		do SeparateQualifiedId(schemaProc,.tSchemaName,.tProcedureName)
		if tSchemaName = "" {
			set tSchemaName = $$$DefaultSchema
		}
		if procedureType = "p" {
			do generateInformixProcedureClass(tSchemaName,tProcedureName,procedureType,.pCode,.pSource,.pLog,pInputFile,.tClassName,.tMethodName,.tFormalSpec,.tReturnType)
		} elseif procedureType = "i" {
			if $Isobject($Get(pCode)) {
				set pCode.Description = "Generated by IRIS Informix SPL Converter - " _ $zdt($h)
				if pInputFile '= "" { set pCode.Description = pCode.Description _  $$$NL _ $$$NL _ "Loaded from: " _ pInputFile _ $$$NL }
				set pCode.Description = pCode.Description _  $$$NL _ $$$NL _ "Source: " _ $$$NL
				do {
					set tDescription = pSource.ReadLine()
					if (tDescription '= "") || ('pSource.AtEnd) {
						set pCode.Description = pCode.Description _ tDescription _ $$$NL
						if ($Length(pCode.Description)) > 32000 {
							set pCode.Description = $Extract(pCode.Description,1,32000) _ $$$NL _ "<<source truncated>>"
							set pSource.AtEnd = 1
						}
					}
				} while '(pSource.AtEnd)
					#; This call will throw an exception if an error is encountered. No need to do additional error processing
				do ##class(%Compiler.Informix.ImportedObject).SaveImportedObject("R",tSchemaName,tProcedureName,pCode,pInputFile)
			}
			else { throw ##class(%Exception.StatusException).CreateFromStatus($$$ERROR($$$GeneralError,"Invalid code generation: "_pCode(1))) }
			set tClassName = pCode.Name
			set tProcedureName = schemaProc
			set tMethodName = $Get(pCode(3))
			set tFormalSpec = $Get(pCode(4))
			set tReturnType = "RESULTSET"
		}
		else { throw ##class(%Exception.StatusException).CreateFromStatus($$$ERROR($$$GeneralError,"Invalid code generation: "_pCode(1))) }
		set tStatus = $system.OBJ.Compile(tClassName,"-dk")
		write !!,"Created class: ",tClassName,":",tMethodName
		write !,"     sql name: ",tProcedureName
		write !,"      formals: ",tFormalSpec
		write !,"       return: ",tReturnType
		write !,"     compiled: ",$Select($$$ISOK(tStatus):"success",1:$system.OBJ.DisplayError(tStatus)),!
		if tLogActive {
			do pLog.write("Created class: "_tClassName_":"_tMethodName,2,1)
			do pLog.write("     sql name: "_tProcedureName)
			do pLog.write("      formals: "_tFormalSpec)
			do pLog.write("       return: "_tReturnType)
		}
	}
	catch tException {
		set tStatus = tException.AsStatus()
		if $Get(tLogActive) { if $IsObject(pLog) { do pLog.logStatus(tStatus) } }
	}
	quit tStatus
}
.
generateInformixProcedureClass(schema,proc,procedureType,pCode,pSource,pLog,pInputFile,pClassName,pMethodName,pFormalSpec,pReturnType) [] public {
		set SCHEMA = $$$ucase(schema), PROC = $$$ucase(proc)
			#; Find out what class name and method name we should use
		set tCreateClass = 0
			#; Find out what class name and method name we should use
		if $Data($$$PROC($$$pPROC,SCHEMA,PROC)) {
			set pClassName = $$$PROCclass($$$pPROC,SCHEMA,PROC)
			set pMethodName = $$$PROCprocedure($$$pPROC,SCHEMA,PROC)
			set tClass = ##class(%Dictionary.ClassDefinition).IDKEYOpen(pClassName)
			if '$IsObject(tClass) { set tClass = "", tCreateClass = 1 }
		}
		else {
			#dim tClass as %Dictionary.ClassDefinition
			set tPackageName = $$GetPackage^%apiDDL(schema)
			set pClassName = tPackageName _ "." _ $Translate(proc,$$$GetIdTrxFrom,$$$GetIdTrxTo)
			if ##class(%Dictionary.ClassDefinition).%ExistsId(pClassName) {
				set tClass = ##class(%Dictionary.ClassDefinition).IDKEYOpen(pClassName)
				if '$IsObject(tClass) { set tClass = "", tCreateClass = 1 }
				else  {
					#;  class exists and is now open.  See if this class actually has the procedure already, or another procedure.
					#;  It may have another procedure if you create proc a_b_c and then a_bc
					set pMethodName = $Extract($Translate(proc,$$$GetIdTrxFrom,$$$GetIdTrxTo),1,31)
					set tMethod = ##class(%Dictionary.MethodDefinition).IDKEYOpen(pClassName,pMethodName)
					if '$IsObject(tMethod) {  }	// class exists, but not with this method - ok to use the class??? we do for now
					elseif tMethod.SqlName '= proc { set tClass = "", tCreateClass = 1 }	// class exists, method exists, but it is for a different procedure; use new class
				}
			}
			else { set tCreateClass = 1 }
		}
		if tCreateClass {
			set tStatus = $$AddUniqueClass^%SYS.ResultSet(.pClassName)
			if $$$ISERR(tStatus) { throw ##class(%Exception.StatusException).CreateFromStatus(tStatus) }
			set tClass = ##class(%Dictionary.ClassDefinition).%OpenId(pClassName)
			set tClass.Description = "Generated by Informix CREATE PROC " _ schema _ "." _ proc
			set tClass.Abstract = 1
			set tClass.IncludeCode = "%occInclude,%occErrors,%occXSQLCommands"
			set tClass.Owner = $Username
			set tClass.DdlAllowed = 1
		}
		set pMethodName = $Extract($Translate(proc,$$$GetIdTrxFrom,$$$GetIdTrxTo),1,31)
		if 'tCreateClass {
			do ##class(%Dictionary.MethodDefinition).IDKEYDelete(pClassName,pMethodName)
			do ##class(%Dictionary.QueryDefinition).IDKEYDelete(pClassName,"lifx"_pMethodName)
			do ##class(%Dictionary.ParameterDefinition).IDKEYDelete(pClassName,"INFORMIXLEGACY")
			if tClass.IncludeCode '[ "%occXSQLCommands" { set tClass.IncludeCode = tClass.IncludeCode _ $Select(tClass.IncludeCode'="":",",1:"")_"%occXSQLCommands" }
		}
		set tClass.Description = "Generated by IRIS Informix SPL Converter - " _ $zdt($h)
		if pInputFile '= "" { set tClass.Description = tClass.Description _  $$$NL _ $$$NL _ "Loaded from: " _ pInputFile _ $$$NL }
		set tClass.Description = tClass.Description _  $$$NL _ $$$NL _ "Source: " _ $$$NL
.
			#; Now the method definition directives: (formalspec comes from above)
		set tMethod = ##class(%Dictionary.MethodDefinition).%New()
		set tMethod.parent = tClass
		set tMethod.Name = pMethodName
		set tMethod.ClassMethod = 1
		set tMethod.SqlName = proc
		set tMethod.CodeMode = $$$cMETHCODEMODECODE
		set tMethod.SqlProc = 1
			// Copy the ISPL Source to the description is the method language is not 'ispl'
		do {
			set tDescription = pSource.ReadLine()
			if (tDescription '= "") || ('pSource.AtEnd) {
				set tClass.Description = tClass.Description _ tDescription _ $$$NL
				if ($Length(tClass.Description)) > 32000 {
					set tClass.Description = $Extract(tClass.Description,1,32000) _ $$$NL _ "<<source truncated>>"
					set pSource.AtEnd = 1
				}
			}
		} while '(pSource.AtEnd)
.
.
			#;	#FORMALSPEC:<fspec>
			#;	#RETURNING:<return cardinality>
			#;	#RETURNTYPE:<returntype>
			#;	#INTERFACE:[procedure|function|iteratorfunction]
			#;	#RETURNRESULTSETS:[1|0]
			#;  #DESCRIPTION:<description>
			#;	#METHODNAME:<lvar name>
			#;	#PUBLICLIST: <lvar comma list>
	#; TODO: Have %Compiler.Informix.COS report if any result sets are returned by the procedure: if tProcType = 1 { set tMethod.ReturnResultsets = 1 }
			#; if it's a method OR it's a query ..
		if $Extract(pCode(2),1,12) = "#FORMALSPEC:" {
			set tFormalSpec = $Extract(pCode(2),13,*)
			set tStart = 3
		}
		else { set tFormalSpec = "", tStart = 2 }
		if $Extract(pCode(tStart),1,11) = "#RETURNING:" {
			set tReturnCardinality = $Extract(pCode(tStart),12,*)
			set tStart = tStart + 1, tFetchFormal = "", tFetchSet = "set"
			for tPtr = 1:1:tReturnCardinality {
				if $Extract(pCode(tStart),1,12) = "#RETURNTYPE:" {
					set tReturnSpec = $Extract(pCode(tStart),13,*)
					set tReturnValue(tPtr) = $Piece(tReturnSpec,":",1)
					set tReturnType(tPtr) = $Piece(tReturnSpec,":",2,*)
					if $Extract(tReturnType(tPtr),1,16) = "%Library.String(" { set tReturnType(tPtr) = $Piece(tReturnType(tPtr),"(",1) _ "(COLLATION=""SqlString""," _ $Piece(tReturnType(tPtr),"(",2,*) }
					set tFetchFormal = tFetchFormal _ ",*" _ tReturnValue(tPtr) _ ":" _ tReturnType(tPtr)
					set tStart = tStart + 1
				}
				else {
						#; Shouldn't happen!
					quit
				}
			}
				#; Check for the special case of a single return value. If so then it is a simple function interface
			if tReturnCardinality = 1 {
				set tReturnType = $Piece(tReturnType(1),"(",1)
				set tReturnTypeParms = $Extract($Piece(tReturnType(1),"(",2,*),1,*-1)
				set tFetchFormal = ""
			}
			else { set tReturnType = "", tReturnTypeParms = "" }
		}
		else {
			#; Shouldn't happen!
		}
			#;	#INTERFACE:[procedure|function|iteratorfunction]
		if $Extract(pCode(tStart),1,11) = "#INTERFACE:" {
			set tInterface = $Extract(pCode(tStart),12,*)
			if tInterface = "function" { set tMethod.ReturnType = tReturnType, tMethod.ReturnTypeParams = tReturnTypeParms }
			set tStart = tStart + 1
		}
			#;	#RETURNRESULTSETS:[1|0]
		if $Extract(pCode(tStart),1,18) = "#RETURNRESULTSETS:" {
			if $Extract(pCode(tStart),19,*) { set tMethod.ReturnResultsets = 1 }
			set tStart = tStart + 1
		}
			#;  #DESCRIPTION:<description>
		if $Extract(pCode(tStart),1,13) = "#DESCRIPTION:" {
			set tMethod.Description = $ListToString($Extract(pCode(tStart),14,*))
			set tStart = tStart + 1
		}
		
			#;	#PUBLICLIST:<lvar list>
		if $Extract(pCode(tStart),1,12) = "#PUBLICLIST:" {
			set tPublicList = $Extract(pCode(tStart),13,*)
			if tPublicList '= "" {
				set tMethod.PublicList = tPublicList
				do tMethod.Implementation.WriteLine($Char(9)_"new "_tPublicList)
			}
			set tStart = tStart + 1
		}
			#;	#METHODNAME:<lvar name>
		if $Extract(pCode(tStart),1,12) = "#METHODNAME:" {
			set tMethodNameLvar = $Extract(pCode(tStart),13,*)
			if tMethodNameLvar '= "" { do tMethod.Implementation.WriteLine($Char(9)_"set "_tMethodNameLvar_" = "_$zu(144,1,tClass.Name_"."_tMethod.Name)) }
			set tStart = tStart + 1
		}
		if tInterface = "function" { set tMethod.FormalSpec = tFormalSpec _ $Select(tFormalSpec'="":tFetchFormal,1:$Extract(tFetchFormal,2,*)) }
		else { set tMethod.FormalSpec = tFormalSpec }
.
		for tPtr = tStart:1:pCode { if $Extract(pCode(tPtr),1,14) '= "#ENDPROCEDURE;" { do tMethod.Implementation.WriteLine(pCode(tPtr)) } else { quit } }
		/*
			#; define the %Fetch method
		set tMethod = ##class(%Dictionary.MethodDefinition).%New()
		set tMethod.parent = tClass
		set tMethod.Name = "%Fetch"
		set tMethod.CodeMode = $$$cMETHCODEMODECODE
		set tMethod.FormalSpec = $Extract(tFetchFormal,2,*)
		do:tFetchSet'="set" tMethod.Implementation.WriteLine($Char(9)_$Extract(tFetchSet,1,*-1))
		do tMethod.Implementation.WriteLine($Char(9)_"quit")
		*/
			#; If the FUNCTIONRETURNSSET configuration option is true then generate the query wrapper for
			#; Informix legacy function calls
		if (tInterface = "function") && ($Get(^%SYS("xsql","informix","FUNCTIONRETURNSSET"))) {
				#; define the call statement
			do parseFormal^%occName("DDLImport",pMethodName,tFormalSpec,.tFormalArgs)
			if tFormalArgs {
				set tCallArgs = "."_tFormalArgs(1)
				for tPtr = 2:1:tFormalArgs { set tCallArgs = tCallArgs _ ",." _ tFormalArgs(tPtr) }
			}
			else { set tCallArgs = "" }
			if tReturnCardinality = 1 {
				set tCall = "set " _ tReturnValue(1) _ " = .." _ pMethodName _ "(" _ tCallArgs _ ")"
				set tRowSpec = tReturnValue(1) _ ":" _ tReturnType(1)
				set tSelect = "select :" _ tReturnValue(1) _ " as " _ tReturnValue(1)
			}
			else {
				set tCall = "do .." _ pMethodName _ "(" _ $Select(tFormalArgs:tCallArgs _ ",.",1:".") _ tReturnValue(1)
				set tSelect = "select :" _ tReturnValue(1) _ " as " _ tReturnValue(1)
				set tRowSpec = tReturnValue(1) _ ":" _ tReturnType(1)
				for tPtr = 2:1:tReturnCardinality { set tCall = tCall _ ",." _ tReturnValue(tPtr), tSelect = tSelect _ ", :" _ tReturnValue(tPtr) _ " as " _ tReturnValue(tPtr), tRowSpec = tRowSpec _ "," _ tReturnValue(tPtr) _ ":" _ tReturnType(tPtr) }
				set tCall = tCall _ ")"
			}
				#dim tQuery as %Dictionary.QueryDefinition
			set tQuery = ##class(%Dictionary.QueryDefinition).%New()
			set tQuery.parent = tClass
			set tQuery.Name = "lifx" _ pMethodName
			set tQuery.Type = "%XSQL.Informix.FunctionQuery"
			do tQuery.Parameters.SetAt(tRowSpec,"ROWSPEC")
			do tQuery.Parameters.SetAt(tCall,"INFORMIXCALL")
			set tQuery.SqlQuery = tSelect
			set tQuery.SqlProc = 1
			set tQuery.SqlName = "lifx_" _ proc
			set tQuery.FormalSpec = tFormalSpec
			#dim tParameter as %Dictionary.ParameterDefinition
			set tParameter = ##class(%Dictionary.ParameterDefinition).%New()
			set tParameter.parent = tClass
			set tParameter.Name = "INFORMIXLEGACY"
			set tParameter.Default = tQuery.SqlName
		}
		set pFormalSpec = tMethod.FormalSpec, pReturnType = tMethod.ReturnType
		set tStatus = tClass.%Save()
		if $$$ISERR(tStatus) {
			throw ##class(%Exception.StatusException).CreateFromStatus(tStatus)
		}
		quit tClass.Name
}
.
/// This function support %DDLMethodLanguage = 'ispl' - it simply loads the procedure source into a classmethod with language = 'ispl' in a shell class.
loadISPLSource(schemaProc,source,sourceFile) public {
		do SeparateQualifiedId(schemaProc,.schema,.proc)
		if schema = "" {
			set schema = $$$DefaultSchema
		}
		set packageName = $$GetPackage^%apiDDL(schema)
		set className = packageName _ "." _ $Translate(proc,$$$GetIdTrxFrom,$$$GetIdTrxTo)
		set status = $$AddUniqueClass^%SYS.ResultSet(.className)
		set class = ##class(%Dictionary.ClassDefinition).IDKEYOpen(className)
		if $$$ISERR(status) { throw ##class(%Exception.StatusException).CreateFromStatus(tStatus) }
		set class.Abstract = 1
		set class.Owner = $Username
		set methodName = $Extract($Translate(proc,$$$GetIdTrxFrom,$$$GetIdTrxTo),1,31)
		set class.Description = "Generated by IRIS Informix SPL Converter - " _ $zdt($h)_ $$$NL _ "Source file: "_sourceFile
		set method = ##class(%Dictionary.MethodDefinition).%New()
		set method.parent = class
		set method.Name = methodName
		set method.ClassMethod = 1
		set method.CodeMode = $$$cMETHCODEMODECODE
		set method.Language = $$$cMETHLANGUAGEISPL
		do {
			set line = source.ReadLine()
			if (line '= "") || ('source.AtEnd) {
				do method.Implementation.WriteLine(line)
			}
		} while '(source.AtEnd)
		set status = class.%Save()
		if $$$ISERR(status) {
			$$$ThrowStatus(status)
		}
		$$$THROWONERROR(status,class.%Save())
		return $$$OK
}
.
SeparateQualifiedId(identifier,schema,id) [] PUBLIC {
.
	If $Get(identifier) = "" { Set schema = "" Set id = "" Quit $$$OK }
	If identifier '[ """" {
			#; Process normal identifiers...
		If identifier '[ "." {
			Set schema = ""
			Set id = identifier
		}
		Else {
			Set schema = $Piece(identifier,".",1)
			Set id = $Piece(identifier,".",2)
		}
	}
	Else {
			#; Process delimited identifiers
		Set sc=$$SeparateIdentifier(identifier,.schema,.id)
		If $$$ISERR(sc) { QUIT sc }
	}
	Quit $$$OK
}
.
SeparateIdentifier(identifier,qualifier,name) [] PUBLIC {
	Set instring=0
	Set valray=""
	Set value=""
	Set ptr = 1
	While ptr '> $l(identifier) {
		Set char=$e(identifier,ptr),look=$e(identifier,ptr+1)
		If (char="""") && (look'="""") Set instring='instring
		If (char=".")&('instring) {
			Set valray=valray+1,valray(valray)=$s($e(value)'="""":value,1:$e(value,2,$l(value)-1)),value=""
		}
		Else {
			Set value=value_char
		}
		Set ptr = ptr + $Select(char'="""":1,look'="""":1,1:2)
	}
		#; If any characters remain in the value buffer put them in the array
	s:value'="" valray=valray+1,valray(valray)=$s($e(value)'="""":value,1:$e(value,2,$l(value)-1))
		#; If state is set it means that quotes are unbalanced
	QUIT:instring $$$ERROR($$$InvalidIdentifierFormat)
	If valray = 1 {
		Set qualifier = ""
		Set name = valray(1)
	}
	Else {
		Set qualifier = valray(1)
		Set name = valray(2)
	}
		#; Normal termination
	QUIT $$$OK
}
.
parseType(pTypeSpec,pType,pParm) [] PUBLIC {
		#;		<type> ::= identifier
		#;		<typeparameterlist> ::= <parametername> = <parametervalue> | <typeparameterlist> , <parametername> = <parametervalue>
		#;		<parametername> ::= identifier
		#;		<parametervalue> ::= literal
		#;
	set $ZTrap = "CatchError"
	kill pParm
	set pType = $Piece(pTypeSpec,"(",1), tParameters = $Extract($Piece(pTypeSpec,"(",2,*),1,*-1)
	if tParameters = "" { quit }
	set len = $Length(tParameters), trParameters = $Translate(tParameters,":=(),""",$Char(0,0,0,0,0,0))
 	set lexptr = 1
		#;		<typeparameterlist> ::= <typeparameter> | <typeparameterlist> , <typeparameter>
	while (lexptr '> len) {
		#;			<typeparameter>  ::= <parametername> = <parametervalue>
		#;			<parametername>  ::= identifier
		#;			<parametervalue> ::= literal
		set lexstart = lexptr, lexptr = $find(trParameters,$Char(0),lexptr) If 'lexptr set lexptr = len + 2
	 	Set parmname = $ZStrip($Extract(tParameters,lexstart,lexptr - 2),"<>W")
			#; better be an assignment...
		If $Extract(tParameters,lexptr-1) = "=" {
			Do literalValue(.parmvalue)
			Set pParm(parmname) = parmvalue
	 	}
	}
	quit
 
literalValue(litval)
	If lexptr > len Set litval = "" Quit
	Set bracket = 0, litval = "", lexstart = lexptr
hloop	Set lexptr = $Find(trParameters,$Char(0),lexptr) Set:'lexptr lexptr = $$$MaxLocalLength+1 Goto $Case($extract(tParameters,lexptr-1),"""":hquote,",":hcomma,"(":haddb,")":hsubb,":":hcomma,"":hexit,:herr)
hquote	Set lexptr = $Find(tParameters,"""",lexptr) Goto hloop
haddb	Set bracket=bracket+1 Goto hloop
hsubb	Set bracket=bracket-1 If bracket '< 0 Goto hloop
		Goto hexit
hcomma	If bracket'=0 goto hloop
hexit	Set litval = $ZStrip($extract(tParameters,lexstart,lexptr - 2),"<>W") Quit
herr	Set sc = $$$ERROR($$$GeneralError,"Error parsing type spec - expected: '""', ',', '(' or ')' [OFFSET="_(lexptr - 1)_"]") ZTrap "CC"
CatchError Set $ZTrap=""
	Set sc = $Select($Extract($ZERROR,2,4)="ZCC":sc,1:$$$ERROR($$$ObjectScriptError,$zerror))
	Quit sc
}
.
	// Given a line of SQL statement text in input, return a value of $lb(last-token,fsave position)
	// This is used to determine if the last token of the line is the End-of-Statement delimiter, and if so, we can extract the portion of the statement prior to the End-OfStatement token
GetLastToken(input) [backgrnd,c,callname,f,fsave,hcLnBrkChar,input,label,line,lineprev,logic,lower,m,mask,maybeCOS,more,n,name,p,pprev,prevtoken,qr,rv,SQLCODE,sql,token,val,value] PUBLIC {
 
	#; Sample Input:
	#; s input(1) = """aviel"" aviel.sas :vv from a"
	#; s input(2)="where f=4 and z=? order by 2 ff"
	#; s input(1) = "a"
	#; s input=2
	
	new backgrnd,c,callname,%compOptions,%compTags,%COSParse,%delid,%context,f,fsave,hcLnBrkChar,%inMLComment,label,line,lineprev,logic,lower,m,mask,maybeCOS,more,n,name,p,pprev,prevtoken,qr,rv,sql,token,val,value
	set %compOptions=0,hcLnBrkChar="",%compTags=0
	try {
		set input(1)=input,input=1,PreviousToken=""
		set line=0,more=0,f=0,p=0,callname="info",sql=input,backgrnd=1,tt=0,%context=$system.Context.SQLCompile(),%delid=%context.DelimitedIdentifiers
		do first:'input
		do lext
		quit:token=$c(1)
		set tt=tt+1,tt(tt)=$lb(token,fsave)
		for  { do lext set tt=tt+1,tt(tt)=$lb(token,fsave) quit:token=$c(1) }
	}
	catch {
		if '$g(SQLCODE) { set SQLCODE=-400,%msg="Error occurred in GetLastToken  "_$ze }
		set PreviousToken=""
	}
	QUIT $lb($lg(tt(tt-1)),$lg(tt(tt),2))
}
.
.
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
DDLerror	//
	use 0 set $zt=""
	if $d(SaveUser),SaveUser'=$Username { set x=$SYSTEM.Security.Users.PrincipalNameSet(SaveUser) }	// Restore $username if SETUSER changed it
	close $g(infile)
	if (($g(outfile)'="") && ($g(outfile)'=0)) { close $g(outfile) }
	if $g(nosup) { close $g(nosupfile) }
	if $ze["<ENDOFFILE>" { set $ze="" goto end }
	write !,"Error: "_$ze
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#INCLUDE %sqlcode
#INCLUDE %stringreplace
#INCLUDE %qaqplex
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
