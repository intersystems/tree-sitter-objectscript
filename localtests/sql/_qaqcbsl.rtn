====
qaqcbsl
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqcbsl^MAC^^^0
%qaqcbsl	// BSL code generation (Aviel 5/3/2k2)
	;; COMPONENTS :: SQL/CodeGeneration
	#;
#include %msql
#IF 0   ;-------------------------------------------------------------
	; Description:   BSL code generation
	; Author:        Aviel Klausner
	; Date Started:  May 3, 2002
	;
	;  AK938   (07/29/2015) - Sharded joins
	;  AK841   (12/21/2011) - Use extended local arrays for some temp-files
	;  AK885   (08/20/2013) - Apply conversions before copy(6) NULL-marker
	;  AK688   (01/24/2008) - Abstract index/filter conditions
	;  BJB548  (05/17/2011) - bsl with %ID LIKE '%xx' gets <SUBSCRIPT> error
	;  AK732   (04/03/2009) - Compute %EXTERNAL/%ODBCOUT/collations ASAP
	;  AK700   (05/12/2008) - Implement BSL streamless "pretest" condition
	;  AK673   (01/29/2007) - Fix BSL variable clash for bitmap id looping
	;  DPV2839 (01/17/2007) - SQL: Various performance improvements to SQL/Routine compilers
	;  MAK1841 (07/27/2006) - Remove hard coded 32767, 9999, 32000, 99999 etc. limits of string size
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  DPV2593 (02/21/2006) - SQL Enhancement: Use private global for SQL instead of ^mtemp0
	;  JLF015  (12/06/2005) - Replaced smd mapid references with mt("smdimp",mapid)
	;  AK631   (09/02/2005) - Fix BSL accounting for IDKEY fields
	;  AK602   (07/19/2004) - BSL for default structure inherited index
	;  JLF015  (05/01/2004) - %ANYOF, =>, and collection indexes
	;  AK593   (02/22/2004) - BSL with rowid and data conditions
	;  AK551   (12/12/2002) - Suppress looping below a KEY level
	;  AK588   (12/10/2003) - Fix truncated long BSL "init" line
	;  AK580   (10/21/2003) - Mark BSL temp-file for $SORTEND
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  AK575   (09/08/2003) - Set IDKEY fields from BSL
	;  DPV1828 (01/02/2003) - Optimize code generation of conversion code
	;  AK539   (10/17/2002) - Use $BITCOUNT for COUNT(*) on BSL
	;  AK513   (03/19/2002) - BSL code generation
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
#ENDIF  ;-------------------------------------------------------------
	$$$Abort  ; Not an Entry Point!!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  col# for given ifn.  qno, str had better be set.
#define instream(%ifn) $p($g(mts(qno,str,"ATT",%ifn)),"^",5)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
bsl	new idval,init,last,line1,ndata
	set init="",last=$o($$$aslK(mod,""),-1)
	#; AK575
	n stuff,str,qno,irn,based,jj,icol
	s stuff=$$$aslKId(mod,last),str=$$$aslIdStrNum(stuff),qno=$$$aslIdQb(stuff)
	s irn=+$$$mtR(str),based=$p(mts(qno,str),"^",6)
	#; AK575-
	#; AK593
	s idval=$$idval(qno,str)
	#; AK588
	f ndata=1:1:last i $l(init)>1500 { $$$liin("s "_$e(init,2,*)) s init="" } s init=init_$$init(ndata)  ;  collect all init code
	$$$liin("s "_$e(init,2,*))
	#; AK588-
	s line1=" g "_bottom  ;  where to go if failed
	#; AK551
	#;  if DISTINCT loop suppression starts at this BSL, use current
	#;      "bottom" tag ("dun") to get the next group, don't loop below -
	#;      set up "GOTO bottom" line for all modules involved up to bmod
	i $$$aslIdLoopSupprSubscript($$$aslKId(mod,1)) { n bmod,var1 s bmod=$$$aslIdLoopSupprDecisionMod($$$aslKId(mod,1))
		i bmod=mod { s grup(bmod,"found")="g "_bottom }
		else { s var1=$$$getVarName("found"_bmod),grup(bmod,"found")="s "_var1_"=1"
			$$$liin("s "_var1_"=""""")
			f  s bmod=$p($$$aslMod(bmod),$c(1),2),grup(bmod)=":'"_var1 q:bmod=mod } }
	#; AK551-
	s bottom=tagpre_"k1"  ;  tag for NEXTING
	$$$liin("g "_bottom)  ;  skip over the BSL code
	f ndata=1:1:last d bslit  ;  generate here code for all BSL items
	;  1. outermost loop
	s tag=bottom  ;  Now set up the REAL LOOP, Right HERE!!!
	$$$liin("d "_tagpre_"ft"_last)  ;  next id.  Note - "at" never called!
	$$$liin("i "_$$$getVarName("bsl"_mod_"sb"_last)_"="""""_line1)  ;  no more id's
	Do genCodePartitionCondition
	
	#; AK885
	s vset=""  ;  nothing really set yet
	#; AK575
	QUIT:$$$aslIdLoopOnChunks(stuff)  ;  done if streaming chunks  ;  AK539
	#; AK732
	d vset^%qaqcdt(idval,$$$getVarName("bsl"_mod_"sb"_last))  ;  set id and its
	#;  collations, conversions, do the same for all its based-on fields
	f jj=2:1:$l(based,",")-1 d vset^%qaqcdt($$$instream($p(based,",",jj)),$$based(idval,$$ddidpcs(2,jj-1)))
	#;  *** should also allow for computed fields based on these!
	#; AK732-
	#; AK575-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK575
based(idval,pcs)  ;  $$:  code to get IDKEY field value from rowid value
	QUIT:pcs=0 pti(idval)  ;  the whole value needed
	QUIT "$p("_pti(idval)_",""||"""_pcs_")"
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddidpcs(i,pos) n pcs  ;  $$:  rowid $P() args 3[+4] for this IDKEY position,
	#;  0 if no $P() needed, empty if $P(1), i=1/2 for physical/logical
	#;  assume irn is defined
	If i=1 { s pcs=$$$smdPhysicalNumright(1,irn) }  ;  irn must be set!
	Else   { s pcs=$$$smdLogicalNumright(1,irn) }
	s pos=$p(pcs,"^",pos)
	QUIT $s(pcs=pos:0,pos="1":"",1:","_pos)
dircomp(var1, op, var2) [ dir ] public {
	RETURN $s(dir="-1":var2_op_var1,1:var1_op_var2)
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK575-
idval(qno,str)  ;  $$:
	QUIT $p(mts(qno,str,"ATT",$p(mts(qno,str),"^",5)),"^",5)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
init(ndata)  ;  $$:  SET Code to initialize BSL item asl(mod,2,ndata)
	n id s id=$$$aslKId(mod,ndata)
	QUIT ","_$$$getVarName("bsl"_mod_"sb"_ndata)_"="""""_$S($p(id,$c(1))="map":","_$$$getVarName("bsl"_mod_"st"_ndata)_"=1",$p(id,$c(1))="convert"&&$p(id,$c(1),8):","_$$$getVarName("bsl"_mod_"ch"_ndata)_"=""""",1:"")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
bslit	;  Generate Code for BSL item asl(mod,2,ndata)
	n dir,stuff,flag,mapid,tempid,str,qno,chid,optinfo,next1,arg1,arg2,vsb,vch
	n cgc d cgcInit^%qaqcasl()
	s stuff=$$$aslKId(mod,ndata)
	set flag=$$$aslIdKeyAccessType(stuff)
	set mapid=$$$aslIdMapId(stuff)
	set tempid=$$$aslIdTfBuildLoc(stuff)
	set str=$$$aslIdStrNum(stuff)
	set qno=$$$aslIdQb(stuff)
	set chid=$$$aslIdLoopOnChunks(stuff)
	set dir=$$$aslIdTfType(stuff)
	s optinfo=$g($$$aslKBslTopOptInfo(mod,2,ndata))
	s next1=$$$aslKNext(mod,ndata,1)
	set vsb=$g(pti(+next1))
	set arg1=$$$aslNextSkipNull(next1)
	set arg2=$p(arg1,",",2)
	set arg1=+arg1
	s:chid vch=$g(pti(+$$$aslNextChunkDataVar(next1)))
	d:flag="map" map
	d:flag="temp" temp
	d:flag="or" or
	d:flag="and" and
	d:flag="convert" unpack
	d:flag="bstopfilt" bstopfilt
	d:flag="bsrangefilt" bsrangefilt
	d:flag="set" set
	d:flag="single" single
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
map	;  2/3. map, streaming id's/chunks
	n vst,gt,bottom,ref,switch,smdimp
	s smdimp=$g(mt("smdimp",mapid),mapid)
	s vsb=$$$getVarName("bsl"_mod_"sb"_ndata),vst=$$$getVarName("bsl"_mod_"st"_ndata)
	#;  determine whether tag gt needed, i.e. id streaming, additional
	#;  testing/processing needed after the id subscript
	s bottom=tagpre_"qt"_ndata,tag=bottom $$$liin("s "_vsb_"="""" q")  ;  pre-test failed
	s tag=tagpre_"pt"_ndata $$$liin("s "_vst_"=0")  ;  pre-test
	#; AK700
	d nextcond($g($$$aslKBslPretestConds(mod,ndata)))
	#; AK593
	;  Get the Global Reference ref, generate subscript conditions
	n asc,atype,constant,ilev,keycol,next2,vsub,nulsub,vcn,vhi,vlo
	n idlup,idcode,idbase,pos s idlup="",idcode="",idbase=based  ;  was id found in a subscript?
	s next2=0 ; counter to spin thru asl(mod,2,ndata,"next",next2)
	#; AK688
	n filter i $d(mt("filterm",smdimp),filter) { } s filter=$p($g(filter),",",2)
	#;  if it's a filter "map" then compute the oref (once), and
	#;  skip right ahead to processing the bitmap layer
	i filter d davalue^%qaqcpr(filter)
	s:'filter ref=$$$smdMapGlobal(smdimp)_"(",atype=""
	#; AK688-
	#; AK938
	d shref^%qaqcky(.ref)  ;  maybe use ^|"ext^ref"| to other shard servers
	f ilev=1:1 d maplev QUIT:asc=""
	#; AK688
	if 'idlup $$$liin($$dodch("g "_bottom_":'",atype="Bit"&&'chid,vsb,"",$e(ref,1,*-1)_")",filter))
	;  d fields^%qaqcdt  ;  *** make this work!  ref ends with ","!
	$$$liin("q")
	d restore(.switch)  ;  restore pti() to original state
	QUIT:idlup
	s tag=tagpre_"at"_ndata $$$liin(";")
	s tag=tagpre_"ft"_ndata $$$liin("g "_tagpre_"pt"_ndata_":"_vst)
	$$$liin("g "_bottom)
	#; AK593-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
maplev	; Get the Next Subscript Level from a MAP
	#; AK688
	i filter,ilev=1 s ilev=2,ref="77",next2=1
	set next2=$o($$$aslKNext(mod,ndata,next2),1,stuff)
	set asc=$$$aslNextLoopingType(stuff)
	#; AK593
	i next2="" s asc="" QUIT
	#; JLF015
	If '$d($$$smd(12,smdimp,6,ilev)) {
		s ifn=$p(mts(qno,str),"^",5),constant="",atype="Bit",nulsub=""
	}
	Else {
		s ifn=$$$smdMSFieldIfn(smdimp,ilev),constant=$$$smdMSConstant(smdimp,ilev),atype=$$$smdMSAccessType(smdimp,ilev)
		s nulsub=$$$smdMSNullMarker(smdimp,ilev)
	}
	i constant'="" d adref(constant) QUIT
	#; AK593
	s keycol=+stuff
	i keycol=idval { d switch(.switch,idval,vsb) s var1=vsb } else { s var1=$$adsw(.switch,keycol) }
	i asc'="u",(keycol=idval)||($e(asc)="h") s idlup=1 GOTO idlup
	s nulsub=$$nulsub(keycol,nulsub)  ;  use correct NULL marker, if any
	s vsub=$s(nulsub="":var1,1:$$scratch^%qaqcpr(,0,"vsub"_mod))
	i asc="u"
	{
		if keycol=idval $$$liin("g "_bottom_":"_$$dircomp(var1,"]]",pti($$$aslNextLoopingLowLimOrSetVar(stuff))))
		$$$liin("s "_var1_"="_pti($$$aslNextLoopingLowLimOrSetVar(stuff)))
		i nulsub="" { $$$liin("g "_tagpre_"qt"_ndata_":"_vsub_"=""""") }
		else { $$$liin("s "_vsub_"="_$$tomark^%qaqcpr(var1,nulsub)) }
	} else
	{
	#;  next 3 lines $ORDER on a non-id, unresolved (unrestrained),
	#;  but already unique subscript (there can be at most one value
	#;  found here), since we've already passed some "u" subscripts,
	#;  corresponding to a UNIQUE key
		$$$liin("s "_vsub_"=$o("_ref_"""""))")  ;  get (single) next value
		$$$liin("g "_bottom_":"_vsub_"=""""")
		i nulsub'="" $$$liin("s "_var1_"="_$$tonull^%qaqcpr(vsub,nulsub))
	}
	s pos=$p(idbase,(","_ifn_","))
	i pos'=idbase  ;  ifn found, use this subscript to build the rowid
	{
		s pos=$l(pos,","),$p(idcode,"_""||""_",pos)=var1,$p(idbase,",",pos+1)=""
		#;  check to see if we got all of the rowid components
		i $tr(idbase,",")="" s pos=$$scratch^%qaqcpr(,1) $$$liin("s "_pos_"="_idcode_" g "_bottom_":"_vsb_"]]"_pos_" s "_vsb_"="_pos)
	}
	#; AK593-
	d adref(vsub),nextcond($$$aslNextAdditionalCondsOnSubscript(stuff))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adref(x)  ;  build ref with a new MapSubs access entry x
	d adrefsub(x) s ref=ref_","
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adrefsub(x)  ;  build ref with a new subscript x, record {Si} in ref(i)
	s ref=ref_x,ref(ilev)=x
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	// Called from map and maplev
nulsub(fval,nulsub)  ;  null marker (or "") for map subscript fval
	s:nulsub="" nulsub=$$$NULLSubscriptMarkerq
	if '$$nullreplace^%qaqcct(fval) QUIT ""  ; If value can never be null return "" as null marker
	QUIT nulsub  ;  use NULL-substitute
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK593
idlup	;  generate at/ft code for looping over the id
	#;  CASE B
	#;  determine whether tag gt needed, i.e. id streaming, additional
	#;  testing/processing needed after the id subscript
	s gt='chid  ;  ... & (need to test conditions at this id level or lower)
	#;  *** also set to 0 if this id subscript is the last one, and
	#;      there are no conditions at or after this id level
	s:chid vch=$$$getVarName("bsl"_mod_"ch"_ndata)
	i $$idbm s vcn=$$$getVarName("bsl"_mod_"cn"_ndata),vch=$$$getVarName("bsl"_mod_"ch"_ndata),vhi=$$$getVarName("bsl"_mod_"hi"_ndata),vlo=$$$getVarName("bsl"_mod_"lo"_ndata)
	#;  ref ends with "," or "(" after each maplev iteration
	d adrefsub($s($$idbm:vcn,1:vsb))
	#;  calculate the range values - start value, inclusive or not, stop
	#;  conditions, %STARTSWTIH line
	n start,qistart,stop,qistop,stopcond s start="",stop="",qistart=0,qistop=0,stopcond=""
	i 'chid,$c(1,1,1)'[$p(stuff,$c(1),3,6) d strtstop
	d setstart
	s tag=tagpre_"at"_ndata $$$liin("g "_tagpre_"pt"_ndata_":"_vst)
	if $$idbm { $$$liin($$gebit(vsb,vcn,ref)) }
	#; AK688
	else  { $$$liin($$dodch($s(gt:"g "_tagpre_"gt"_ndata,1:"q")_":",0,vsb,$s(chid:vch,1:""),$s(asc="y":start,1:ref_")"),filter)) }
	s tag=tagpre_"ft"_ndata $$$liin("g "_tagpre_"pt"_ndata_":"_vst)
	if $$idbm { $$$liin($$ftbit(vsb,vcn,ref)) $$$liin("g "_tagpre_"qt"_ndata_":"_vcn_"=""""") }
	#; AK688
	else { $$$liin("s "_$$dorch(vsb,$s(chid:vch,1:""),$s(asc="y":start,1:ref_")"),filter)) }  ;  loop to next value
	i 'gt s ref=ref_"," QUIT
	if '$$idbm $$$liin("q:"_vsb_"=""""")
	if stopcond'="" $$$liin(stopcond)
	s tag=tagpre_"gt"_ndata
	s bottom=tagpre_"ft"_ndata  ;  from here on, if fails get the next one
	#; AK602
	n code  ;  "invalid" override
	d getinv  ;  get "invalid" override into code(1:code)
	d:code=1 subcls  ;  maybe optimize default inherited index condition
	f code=1:1:code $$$liin("i "_code(code)_" g "_bottom)
	#; AK602-
	#; AK688
	if asc="y" $$$liin($$dodch("g "_bottom_":'",atype="Bit",vsb,"",ref_")",filter))
	d nextcond($$$aslNextAdditionalCondsOnSubscript(stuff))
	s ref=ref_","
	QUIT
idbm() [ asc, atype, chid ] public {
	RETURN (asc'="y")&&(atype="Bit")&&'chid	
}
setstart() [ start, stop, dir, asc, vcn, tagpre, ndata, vsb, qistart, qistop, ref ] public {
	s fetchCmd = "g "_tagpre_"ft"_ndata
	s reverse = (dir=-1)
	s bound=$s(reverse:stop,1:start)
	s boundI=$s(reverse:qistop,1:qistart)
	s boundICond=$s(reverse:"("_vsb_"="""")||("_vsb_"]]"_bound_")",1:bound_"]]"_vsb)
	s boundECond=$s(reverse:"("_vsb_"="""")||("_bound_"']]"_vsb_")",1:vsb_"']]"_bound)
	//Initialize bit-looping variables
	i bound=""||boundI,$$idbm { $$$liin($$ntbit(vcn)) }
	//No start value
	i bound=""||(asc="y") { $$$liin(fetchCmd_":"_vsb_"=""""") RETURN }
	//Inclusive
	i boundI { $$$liin("i "_boundICond_"{ s "_vsb_"="_bound_"} else { "_fetchCmd_":"_vsb_"="""" }")  RETURN }
	//Exclusive
	i reverse $$$liin("s:"_vsb_"="""" "_vsb_"="_bound)
	$$$liin("i "_boundECond_" s "_vsb_"="_bound_$s($$idbm:$$gtbit(vsb,vcn,ref),1:"")_" "_fetchCmd)
}
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK602
subcls	n cref,cls,var  ;  optimize default inherited index condition
	s cref=$p(code(1),"'[($e("),cls=$p(code(1),cref,3)
	QUIT:(cref_"'[($e("_cref_cls_cref_"))")'=code(1)  ;  not default test
	s code=0,var=$$$getVarName("scratch")  ;  used in context of this line only
	#;  add line:  s v=gref g TAGft:v'[($e(v)_class_$e(v))
	$$$liin("s "_var_"="_cref_" g "_bottom_":"_var_"'[($e("_var_cls_var_"))")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getinv	;  get "invalid" code/override - should replace code in mstart^%qaqcky!
	d getlines($$$smdMSOverrideInvalidCondition(smdimp,ilev))
	d:'code getlines($$$smdMSDefaultInvalidConditions(smdimp,ilev))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getlines(i) n i5  ;  get code lines, i=1/2/3/4 for invalid/next code/override
	s code=0
	f i5=1:1:$ll(i) d code($$nxtline($lg(i,i5)))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nxtline(line) n jj  ;  $$:  replace {Si} for ref(i) in line i5 of user code
	f jj=1:1:ilev s line=$replace(line,"{S"_jj_"}",ref(jj))
	QUIT line
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
code(line) s code($i(code))=line  ;  add line to the code
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK602-
strtstop  ;  set up start,qistart,stopcond,swline
	i asc="y" s start=$$adsub(pti($$$aslNextLoopingLowLimOrSetVar(stuff)),vsb) QUIT
	n numeric
	set start=$$$aslNextLoopingLowLimOrSetVar(stuff)
	set qistart=$$$aslNextLoopingLowLimExcl(stuff)
	set stop=$$$aslNextLoopingUpLim(stuff)
	set qistop=$$$aslNextLoopingUpLimExcl(stuff)
	If qistart>4 { set qistart=qistart-5,qistop=qistop-5} // If this is a partition condition, normalize qistart and qistop to 0/1
	;  s loopinit=$s(ilev:$$loopinit(mapid,ilev,slev,vsb,atype),1:"")  ; Loop Initialization Value 
	#;  Use Binary Sorts-after (]]) operator
	s:start start=pti(start)
	s:stop stop=pti(stop)
	i dir'=-1,stop'="" {
		s stopcond="g "_bottom_":"_$s(qistop:vsb_"]]"_stop,1:stop_"']]"_vsb) QUIT
	}
	i dir=-1,start'="",qistart'=2 {
		s stopcond="g "_bottom_":"_$s(qistart:start_"]]"_vsb,1:vsb_"']]"_start) QUIT
	}
	QUIT:qistart'=2  ;  handle %STARTSWITH - check the SQL Category
	s numeric="^INTEGER^DATE^DOUBLE^NUMERIC^TIME^"[("^"_$$GetFieldCategory^%qaqcct($p(mts(qno,str),"^",5))_"^")
	i numeric s stopcond="g:'"_$$swex(vsb,start)_" "_tagpre_"ft"_ndata QUIT
	s stopcond="g:"_start_"=+"_start_" "_bottom_":"":""']"_vsb_" g:'"_$$swex(vsb,start)_" "_tagpre_"ft"_ndata_":("_start_"=+"_start_"),"_bottom
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ntbit(vcn)  ;  init code if no lower bound (vch,vlo implicit)
	QUIT "s "_vcn_"="""","_vch_"="""","_vlo_"="_$s(dir="-1":"64000",1:"1")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
gtbit(vid,vcn,ref)  ;  init code for id>"startafter" (vch,vhi,vlo implicit)
	#;  id>x:  s:id<0 id=0 s sub=id+1\64000+1,ch=$g(^G(subs,sub)),lo=id+1#64000,hi=id-lo+1
	#; AK688
	QUIT " s:"_vid_"<0 "_vid_"=0 s "_vcn_"="_vid_"+1\64000+1,"_vch_"="_$$getch(vcn,ref,filter)_","_vlo_"="_vid_"+1#64000,"_vhi_"="_vid_"-"_vlo_"+1"  ;  _$s($$ebmfilter():","_$$ebmand(vch,vcn),1:"")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
gebit(vid,vcn,ref)  ;  init code for id>="startat" (vch,vhi,vlo implicit)
	#;  id>=x: s:id<1 id=1 s:id["." id=id\1+1 s sub=id\64000+1,ch=$g(^G(subs,sub)),lo=id#64000,hi=id-lo
	#; AK688
	QUIT "s:"_vid_"<1 "_vid_"=1 s:"_vid_"[""."" "_vid_"="_vid_"\1+1 s "_vcn_"="_vid_"\64000+1,"_vch_"="_$$getch(vcn,ref,filter)_","_vlo_"="_vid_"#64000"_$s(dir="-1":"+2",1:"")_","_vhi_"="_vid_"-"_vlo_$s(dir="-1":"+2",1:"")  ;  _$s($$ebmfilter():","_$$ebmand(vch,vcn),1:"")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ftbit(vid,vcn,ref)  ;  loop to get next id from bitmap level (vch,vhi,vlo implicit)
	#;  f  s lo=$BITFIND(ch,1,lo+1) i lo {s id=hi+lo-1 QUIT} s sub=$o(^G(subs,sub),1,ch) QUIT:sub=""  s hi=sub-1*64000
	#; AK688
	QUIT "f  s "_vlo_"="_$s(dir="-1":"$s("_vlo_">1:",1:"")_"$BITFIND("_vch_",1,"_vlo_$s(dir=-1:"-1",1:"+1")_$s(dir="-1":",-1",1:"")_")"_$s(dir="-1":",1:0)",1:"")_" i "_vlo_"{s "_vid_"="_vhi_"+"_vlo_"-1"_" q} s "_$$dorch(vcn,vch,ref_")",filter)_" q:"_vcn_"=""""  s "_vhi_"="_vcn_"-1*64000"_$s(dir="-1":","_vlo_"=64001",1:"")  ;  _$s($$ebmfilter():","_$$ebmand(vch,vcn),1:"")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ifbit(vid,ref)  ;  look in bitmap level for the given id (vch,vhi,vlo implicit)
	#;  $BIT(^G(subs,id\64000+1),id#64000+1)
	#; AK688
	QUIT "$bit("_$$getch(vid_"\64000+1",ref_"\64000+1",filter,1)_","_vid_"#64000+1)"  ;  _$s($$ebmfilter():"||'$bit($g("_$$ebmsub(vid_"\64000+1")_"),"_vid_"#64000+1)",1:"")  :  MAK4147
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK688
getch(vsb,ref,filter="",bit=0)  ;  $$: code to retrieve the actual bitmap string
	#;  from a node of a bit map ref subscripted by chunk# vsb, but
	#;  if filter provided, then use the filter method
	QUIT:'filter $s(bit=0:"$g("_ref_"))",1:ref_")")  ;  MAK4147
	QUIT pti(filter)_".GetChunk("_vsb_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dorch(vsb,vch,ref,filter="")  ;  $$: code to traverse a bit map ref using
	#;  $ORDER() to loop over chunk# vsb in subscript, and to get the
	#;  actual bitmap string from the node into vch (if provided),
	#;  but if filter provided (and we're not looping on a list of
	#;  values in a local array 'start') then use the filter method
	QUIT:'ref vsb_"=$o("_ref_$s(vch'="":","_$s(dir="-1":"-1",1:1)_","_vch,1:$s(dir="-1":",-1",1:""))_")"  ;  actual reference - use the normal $ORDER()
	d vNEW^%qaqcasl("%sqlup")  ;  by-ref requires an unsubscripted variable
	QUIT "%sqlup="_vsb_$S(vch="":" d ",1:","_vch_"=")_pti(filter)_".NextChunk(.%sqlup) s "_vsb_"=%sqlup"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dodch(cmdif,ifbit,vsb,vch,ref,filter="")  ;  $$: code to apply cmdif with
	#;  post-conditional of $$ifbit() (if ifbit), or of $DATA() on a
	#;  bit map ref, using chunk# vsb in subscript, and to get the actual
	#;  bitmap string from the node into vch (if provided), but if
	#;  filter provided (and we're not looping on a list of values in
	#;  a local array 'start') then use the filter method
	QUIT:ifbit cmdif_$$ifbit(vsb,$e(ref,1,*-1))  ;  if it's a bitmap, but we're looking for individual id's
	QUIT:'ref cmdif_"$d("_ref_$s(vch'="":","_vch,1:"")_")"  ;  actual reference - use the normal $DATA()
	s filter=pti(filter)_".GetChunk("_vsb_")"
	QUIT:vch="" cmdif_"("_filter_"'="""")"
	QUIT "s "_vch_"="_filter_" "_cmdif_"("_vch_"'="""")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK688-
swex(a,b)  ;  generate a %STARTSWITH b
	QUIT "("_b_"=$e("_a_",1,$l("_b_")))"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adsub(var,sub)  ;  $$:  add subscript sub to variable var
	QUIT $s($e(var,*)=")":$e(var,1,*-1)_",",1:var_"(")_sub_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK593-
nextcond(op) n i5,log  ;  Code-Generate the 'next' Conditions
	#;  *** might need to do vset(sub/id) if op has conversions!  ;  AK732
	#; Don't evaluate the same expression more than once in this context
	#;  n cgc d cgcInit^%qaqcasl()  ;  TRW1449  ;  removed by AK1090
	f i5=1:1 s log=$p(op,",",i5) q:log=""  $$$liin("i '"_$$cond^%qaqcpr(log)_" g "_bottom)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adsw(switch,val)  ;  switch val with scratch substitute, record in .switch
	d:'$d(switch(val)) switch(.switch,val,$$scratch^%qaqcpr(,0))
	QUIT pti(val)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
switch(switch,val,sub)  ;  switch val with given substitute, record in .switch
	s switch(val)=pti(val),pti(val)=sub
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
restore(switch)  ;  restore pti() to original values using .switch
	m pti=switch
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
temp	;  4/5. temp-file, streaming id's/chunks
	n modtemp,modn,modref,ref,calltemp
	s modtemp=+tempid,modn=$p(tempid,"^",2),modref=$$$aslActTfToBuild($$$aslAct(modtemp,modn))
	#; AK841
	s ref=$g($$$mtTref(tempid))
	s calltemp=$$calltemp($$headmod(modtemp),1)  ;  call only "once"
	#; AK580
	if ($$glotf^%qaqcpre(modref)){
		s:$$$aslActSort($$$aslAct(modtemp,modn)) filenum(modref)=1,calltemp=calltemp_" i $sortend("_ref_"))"
	}
	s tag=tagpre_"at"_ndata $$$liin(calltemp)
	$$$liin("q:$d("_$s($e(ref,*)="(":ref,1:ref_",")_vsb_")"_$s(chid:","_vch,1:"")_")")
	s tag=tagpre_"ft"_ndata $$$liin(calltemp)
	$$$liin("s "_vsb_"=$o("_$s($e(ref,*)="(":ref,1:ref_",")_vsb_")"_$s(chid||(dir="-1"):","_$s(dir="-1":"-1",1:"1"),1:"")_$s(chid:","_vch,1:"")_") q")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
headmod(mod)  ;  $$: call module - top module that nests this ASL Module
	n hd f  s hd=mod,mod=$p($g($$$aslMod(mod)),$c(1),2) RETURN:'mod hd
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
calltemp(mod,once)  ;  $$: We'll call another ASL Module
	QUIT $s(once:$$once^%qaqcpr(,"once"_mod),1:"")_"d "_$$modpre^%qaqcasl(mod)_"Mod"  ;  Do the Module
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
or	;  6/7. (a OR b) , streaming id's/chunks
	n vsb1,vch1,vsb2,vch2
	s vsb1=$$$getVarName("bsl"_mod_"sb"_arg1),vsb2=$$$getVarName("bsl"_mod_"sb"_arg2)
	s:chid vch1=$$$getVarName("bsl"_mod_"ch"_arg1),vch2=$$$getVarName("bsl"_mod_"ch"_arg2)
	s tag=tagpre_"at"_ndata $$$liin("i "_vsb1_"="""","_vsb2_"="""" s "_vsb1_"="_vsb_" d "_tagpre_"at"_arg1_" s "_vsb2_"="_vsb_" d "_tagpre_"at"_arg2_" g "_tagpre_"gt"_ndata)
	$$$liin("i "_vsb1_"'="""","_$$dircomp(vsb,"]]",vsb1)_" s "_vsb1_"="_vsb_" d "_tagpre_"at"_arg1)
	$$$liin("i "_vsb2_"'="""","_$$dircomp(vsb,"]]",vsb2)_" s "_vsb2_"="_vsb_" d "_tagpre_"at"_arg2)
	$$$liin("g "_tagpre_"gt"_ndata)
	s tag=tagpre_"ft"_ndata  ;  {sb=min(sba,sbb)}
	$$$liin("d "_tagpre_"ft"_arg1_":"_vsb1_"="_vsb_","_tagpre_"ft"_arg2_":"_vsb2_"="_vsb)
	s tag=tagpre_"gt"_ndata  ;  set sb=min(sba,sbb)
	i 'chid $$$liin("s "_vsb_"=$S("_vsb1_"="""":"_vsb2_","_vsb2_"="""":"_vsb1_","_$$dircomp(vsb2,"]]",vsb1)_":"_vsb1_",1:"_vsb2_") q") QUIT
	$$$liin("i "_vsb1_"'="""","_vsb2_"=""""||("_$$dircomp(vsb2,"]]",vsb1)_") s "_vsb_"="_vsb1_","_vch_"="_vch1_" q")
	$$$liin("s "_vsb_"="_vsb2_" s:"_vsb_"'="""" "_vch_"=$s("_vsb_"="_vsb1_":$bitlogic("_vch1_"|"_vch2_"),1:"_vch2_") q")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	;  8. (a(id) OR b(chunk)) , giving a stream of chunks
	;  Convert a to chunks (Step 13) and OR with b (Step 7) *** could be optimized?!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
and	;  9/10. (a AND b) , streaming id's/chunks
	n vsb1,vch1,vsb2,vch2
	s vsb1=$$$getVarName("bsl"_mod_"sb"_arg1),vsb2=$$$getVarName("bsl"_mod_"sb"_arg2)
	s:chid vch1=$$$getVarName("bsl"_mod_"ch"_arg1),vch2=$$$getVarName("bsl"_mod_"ch"_arg2)
	s tag=tagpre_"at"_ndata  ;  {sba=sbb<sb}
	$$$liin("s "_vsb1_"="_vsb_" d "_tagpre_"at"_arg1)
	$$$liin("i "_vsb1_"="""" s "_vsb_"="""" q")
	$$$liin("g "_tagpre_"lt"_ndata)
	s tag=tagpre_"ft"_ndata  ;  {sb=sba=sbb}
	$$$liin("d "_tagpre_"ft"_arg1)
	$$$liin("i "_vsb1_"="""" s "_vsb_"="""" q")  ;  Note - ftb never called!
	s tag=tagpre_"lt"_ndata  ;  {sbb<sba}
	$$$liin("s "_vsb2_"="_vsb1_" d "_tagpre_"at"_arg2)
	$$$liin("i "_vsb2_"="""" s "_vsb_"="""" q")
	;  {sba<=sbb}
	$$$liin("i "_$$dircomp(vsb2,"]]",vsb1)_" s "_vsb1_"="_vsb2_" d "_tagpre_"at"_arg1_" i "_vsb1_"="""" s "_vsb_"="""" q")
	;  {sbb<=sba}
	$$$liin("i "_vsb1_"="_vsb2_" s "_vsb_"="_vsb1_$s(chid:","_vch_"=$bitlogic("_vch1_"&"_vch2_")",1:"")_" q")
	$$$liin("g "_tagpre_"lt"_ndata)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	;  11. (a(chunk) AND b(id)) , giving a stream of id's
	;  Convert a to id's (Step 12) and AND with b (Step 9) *** could be optimized?!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
unpack	;  12. transform a stream of chunks into a stream of id's
	GOTO:chid pack
	n vts,vhi,vlo,vsb1,vch1
	s vts=$$$getVarName("bsl"_mod_"ts"_ndata),vhi=$$$getVarName("bsl"_mod_"hi"_ndata),vlo=$$$getVarName("bsl"_mod_"lo"_ndata),vsb1=$$$getVarName("bsl"_mod_"sb"_arg1),vch1=$$$getVarName("bsl"_mod_"ch"_arg1)
	s tag=tagpre_"at"_ndata 
	$$$liin("s "_vts_"="_vsb_"\64000+1")
	$$$liin("i "_vsb1_"'="_vts_" s "_vsb1_"="_vts_" d "_tagpre_"at"_arg1_" i "_vsb1_"="""" {s "_vsb_"="""" q} g:"_vsb1_"'="_vts_" "_tagpre_"gt"_ndata_" s "_vhi_"="_vsb1_"-1*64000")
	$$$liin("s "_vlo_"="_vsb_"#64000"_$s(dir="-1":"+2",1:""))  ;  possibly start from the given id
	#; The vlo+/-1 in the $BITFIND is a "double entendre": In an "at" call it represents a correction to the (off-by-one) conversion from vsb->vlo
	#; performed in the lines above. In the "ft" call it represents an increment of the previous vlo value to "crank the gears" of the BSL.
	s tag=tagpre_"ft"_ndata $$$liin("i "_vsb1_"'="""""_$s(dir="-1":","_vlo_">1",1:"")_" s "_vlo_"=$BITFIND("_vch1_",1,"_vlo_$s(dir=-1:"-1",1:"+1")_$s(dir="-1":",-1",1:"")_")"_" i "_vlo_" s "_vsb_"="_vhi_"+"_vlo_"-1"_" q")
	$$$liin("d "_tagpre_"ft"_arg1)
	$$$liin("i "_vsb1_"="""" s "_vsb_"="""" q")
	s tag=tagpre_"gt"_ndata  ;  new chunk, output all id's from the beginning of this chunk
	$$$liin("s "_vhi_"="_vsb1_"-1*64000,"_vlo_"="_$s(dir=-1:64001,1:0)_" g "_tagpre_"ft"_ndata)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
pack	;  13. transform a stream of id's into a stream of chunks
	n vts,vsb1
	s vts=$$$getVarName("bsl"_mod_"ts"_ndata),vsb1=$$$getVarName("bsl"_mod_"sb"_arg1)
	s tag=tagpre_"at"_ndata $$$liin("i "_vch_"'="""","_vsb1_"=""""||("_$$dircomp(vsb,"']]",vts)_") g "_tagpre_"gt"_ndata)
	;  start with the given sb
	$$$liin("s "_vsb1_"=("_vsb_"-1)*64000 d "_tagpre_"at"_arg1)
	$$$liin("s "_vts_"="_vsb1_"\64000+1")
	s tag=tagpre_"ft"_ndata $$$liin("i "_vsb_"="""" d "_tagpre_"ft"_arg1_" q:"_vsb1_"=""""  s "_vts_"="_vsb1_"\64000+1")
	s tag=tagpre_"gt"_ndata $$$liin("i "_vsb1_"="""" s "_vsb_"="""" q")
	$$$liin("s "_vsb_"="_vts_","_vch_"=""""")
	s tag=tagpre_"lt"_ndata $$$liin("s $BIT("_vch_","_vsb1_"#64000+1)=1")
	$$$liin("d "_tagpre_"ft"_arg1)
	$$$liin("i "_vsb1_"="""" q")  ;  done with this chunk, will exit next time
	$$$liin("s "_vts_"="_vsb1_"\64000+1 q:"_vsb_"'="_vts_"  g "_tagpre_"lt"_ndata)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
set	;  14. transform a SET into a stream of id's
	n setsub s setsub=$$adsub^%qaqcpr(pti($p(next1,$c(1),3)),vsb)
	s tag=tagpre_"at"_ndata $$$liin("q:$d("_setsub_")")
	s tag=tagpre_"ft"_ndata $$$liin("s "_vsb_"=$o("_setsub_") q")  ;  loop to next value
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
single	;  15. transform a singleton id value into a stream of id's
	n vid s vid=pti($p(next1,$c(1),3))
	s tag=tagpre_"at"_ndata $$$liin("s "_vsb_"=$s("_vsb_"']]"_vid_":"_vid_",1:"""") q")
	s tag=tagpre_"ft"_ndata $$$liin("s "_vsb_"=$s("_vsb_"="""":"_vid_",1:"""") q")
	QUIT
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; Note that these functions have not been updated to support a reverse BSL ("dir=-1"). In %qaqpmod
	#; we prevent the bsfilt optimizations from kicking in for the reverse BSL case.
bsfiltprefix(optinfo)
	s vts=$$$getVarName("bsl"_mod_"ts"_ndata),vhi=$$$getVarName("bsl"_mod_"hi"_ndata),vlo=$$$getVarName("bsl"_mod_"lo"_ndata),vsb1=$$$getVarName("bsl"_mod_"sb"_arg1),vch1=$$$getVarName("bsl"_mod_"ch"_arg1)
	s tag=tagpre_"at"_ndata $$$liin("s "_vts_"="_vsb_"\64000+1")
	s tempid = $li(optinfo,1)
	$$$liin("i "_vsb1_"'="_vts_" s "_vsb1_"="_vts_" d "_tagpre_"at"_arg1_" i "_vsb1_"="""" {s "_vsb_"="""" q} g:"_vsb1_"'="_vts_" "_tagpre_"gt"_ndata_" s "_vhi_"="_vsb1_"-1*64000")
	$$$liin("s "_vlo_"="_vsb_"#64000")  ;  possibly start from the given id
	s vwinded = $$$getVarName("bsl"_mod_"winded"_ndata)
	d initvar^%qaqcasl(vwinded,0)
	s tag=tagpre_"ft"_ndata
	$$$liin("if '"_vwinded_" {")
	$$$liin("   for {")
	$$$liin("      do "_tagpre_"ft"_arg1_" if "_vsb1_"="""" quit")
	$$$liin("      set "_$$tfref^%qaqcpre(tempid,1)_vsb1_")="_vch1)
	$$$liin("   }")
	$$$liin("   set "_vwinded_"=1")
	$$$liin("   set "_vch1_"=""""")
	QUIT
bsfiltsuffix
	$$$liin("}")
	$$$liin("if "_vch1_"="""" {")
	$$$liin("   set "_vsb1_"=$o("_$$tfref^%qaqcpre(tempid,1)_vsb1_"),1,"_vch1_") if "_vsb1_"="""" set "_vsb_"="""" quit")
	$$$liin("   set "_vlo_"=0,"_vhi_"="_vsb1_"-1*64000")
	$$$liin("}")
	$$$liin("set "_vlo_"=$BITFIND("_vch1_",1,"_vlo_"+1) if "_vlo_" set "_vsb_"="_vhi_"+"_vlo_"-1 quit")
	$$$liin("set "_vch1_"="""" g "_tagpre_"ft"_ndata)
	s tag=tagpre_"gt"_ndata  ;  new chunk, output all id's from the beginning of this chunk
	$$$liin("s "_vhi_"="_vsb1_"-1*64000,"_vlo_"=0 g "_tagpre_"ft"_ndata)
	QUIT
bstopfilt	;  17. (why do we need numbers? :) ) wind the BSL to insert a stream of chunks into a fully-populated tempfile, use a bitslice top filter, then read it out on fetches
	n vts,vhi,vlo,vsb1,vch1,vwinded
	d bsfiltprefix(optinfo)
	d bstopfilt^%qaqcpre(optinfo)
	d bsfiltsuffix
	QUIT
bsrangefilt	;  17. (why do we need numbers? :) ) wind the BSL to insert a stream of chunks into a fully-populated tempfile, use a bitslice top filter, then read it out on fetches
	n vts,vhi,vlo,vsb1,vch1,vwinded
	//Assumes same tf's used for all optimizations
	d bsfiltprefix($li(optinfo,1))
	for jj=1:1:$ll(optinfo) {
		Do bsrangefilt^%qaqcpre($li(optinfo,jj))
	}
	d bsfiltsuffix
	QUIT
.
/// Generate code for parallel partition conditions
genCodePartitionCondition
	New qstart,qistart,qstop,qistop,nextstuff,dir
	Set nextstuff=$GET($$$aslKNext(mod,last,1))
	Set qstart=$$$aslNextLoopingLowLimOrSetVar(nextstuff)
	Set qistart=$$$aslNextLoopingLowLimExcl(nextstuff)
	Quit:qistart<=4 ; Quit if this is not a parallel partition conditions
	Set qstop=$$$aslNextLoopingUpLim(nextstuff)
	Set qistop=$$$aslNextLoopingUpLimExcl(nextstuff)
	Set dir=$SELECT($GET(mt("sbslrev",m)):-1,1:1) // dir=-1 when reverseBsl special ASL hack (TRW1615) was used for this query block
.
	New gobottom Set gobottom = " g "_bottom
.
	If qistop=5 {
		; add exclusive ending condition (dir=1) or exclusive beginning condition (dir=-1) for partition condition
		; if (id>=stop) { dir=1: quit ; dir=-1: go to next id (id-1)}
		$$$liin("i ("_$$$getVarName("bsl"_mod_"sb"_last)_"]]"_pti(qstop)_")||("_pti(qstop)_"="_$$$getVarName("bsl"_mod_"sb"_last)_")"_$SELECT(dir=-1:gobottom,1:line1))
	} ElseIf qistop=6 {
		; add inclusive ending condition (dir=1) or inclusive beginning condition (dir=-1) for partition condition
		; if (id>stop) { dir=1: quit ; dir=-1: go to next id (id-1)}
		$$$liin("i "_$$$getVarName("bsl"_mod_"sb"_last)_"]]"_pti(qstop)_$SELECT(dir=-1:gobottom,1:line1))  
	}
	If qistart=5 {
		; add the exclusive beginning condition (dir=1) or exclusive ending condition (dir=-1) for APE partition condition
		; if (id<=start) { dir=1: go to next id (id+1) ; dir=-1: quit}
		$$$liin("i ("_pti(qstart)_"]]"_$$$getVarName("bsl"_mod_"sb"_last)_")||("_pti(qstart)_"="_$$$getVarName("bsl"_mod_"sb"_last)_")"_$SELECT(dir=-1:line1,1:gobottom))
	} ElseIf qistart=6 {
		; add the inclusive beginning condition (dir=1) or inclusive ending condition (dir=-1) for APE partition condition
		; if (id<start) { dir=1: go to next id (id+1) ; dir=-1: quit}
		$$$liin("i "_pti(qstart)_"]]"_$$$getVarName("bsl"_mod_"sb"_last)_$SELECT(dir=-1:line1,1:gobottom))  
	}
.
	Quit
.
.
---
