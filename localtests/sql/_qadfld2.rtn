%qadfld2^MAC^^^0
%qadfld2	// Field Data Type Parameter Utilities
	;; COMPONENTS :: SQL/Code Generation
	#;
#INCLUDE %msql
	#;
#IF 0   ;
	;---------------------------------------------------------------------
	; Description:   Field Data Type Parameter utilities
	; Author:        Dan Pasco
	; Date:          May 13, 1996
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;  DPV2186 (03/02/2004) - Fix <UNDEFINED> Preparing COUNT(*) query against external table
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  DPV1298 (04/25/2000) - In GetType, get the Collection type for list attributes instead of using the ADT.
	;  DPV1027 (04/06/1999) - Start with clean dtparam list
	;  DLP003  (05/13/96)   - New Routine
	;
	;---------------------------------------------------------------------
	;                     I N F O R M A T I O N
	;--------------------------------------------------------------------;
	; $$GetType(irn,ifn)                                                 ;
	; |         |   |                                                    ;
	; |         |   |                                                    ;
	; |         |   `> Internal field number                             ;
	; |         `> table row-id                                          ;
	; |                                                                  ;
	; `> This function returns the ADT of field ifn if successful, Null  ;
	;    if not.                                                         ;
	;                                                                    ;
	; $$GetParms(irn,ifn,daparm)                                         ;
	; |          |   |   `> Parameter array - daparm(parm name)=value    ;
	; |          |   |      (Returned)                                   ;
	; |          |   `> Internal field number                            ;
	; |          `> table row-id                                         ;
	; |                                                                  ;
	; `> This function returns true if successful, false if some error   ;
	;    condition exists. daparm is a call by reference array. It will  ;
	;    be contain a node subscripted by a parameter name and equal to  ;
	;    the parameter value for each parameter that exists for the      ;
	;    field identified by irn and ifn.                                ;
	;                                                                    ;
	;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#ENDIF  ;
	$$$Abort  ; Not an Entry Point!!
 
GetType(irn,ifn) [] PUBLIC {
		#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
		#; irn - table id - required
		#; ifn - field ifn - required
		#; get the ADT for field (irn,ifn), returns null if not defined
		#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
	RETURN:$g(irn)=""||($g(ifn)="") ""
	set datype=$$$smdColListCollectionType(1,irn,ifn)
	RETURN:datype'="" datype
	set datype=$$$smdColDatatype(1,irn,ifn)
	RETURN datype
}
 
 
GetParms(irn,ifn,daparma) [] PUBLIC {
		#;-------------------------------------------------------------------;
		#; This function returns an array, daparm, nodes are subscripted by  ;
		#; the parm name and are equal to the parm value.                    ;
		#;-------------------------------------------------------------------;
	RETURN:$g(irn)=""||($g(ifn)="") ""
	set parm=""
	for  {
		set parm=$o($$$smd(1,irn,2,ifn,"adtp",parm),1,d) quit:parm=""
		set daparma(parm)=d
	}
	RETURN 1
}
---
