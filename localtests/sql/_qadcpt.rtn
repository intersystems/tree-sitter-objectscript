====
qadcpt
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qadcpt^MAC^^^0
%qadcpt(extent,backgrnd,%ok,qstruct,%sc,debug=0)	// Compile the SQL Filer Methods
	;; COMPONENTS :: OBJECTS/ClassCompiler
	#;
#INCLUDE %msql
	#;
#IF 0   ;---------------------------------------------------------------------
	; Description:   Compile Queries for a Base Table
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;  DPV3164 (05/19/2008) - Remove INSERT code from cached queries
	;  DPV3131 (03/25/2008) - DD Lookup and Table compiler performance improvements
	;  DPV2930 (05/08/2007) - Fix <UNDEFINED> %mv issue in %insert code in cached query
	;  DPV2864 (02/23/2007) - Change $$dummy check to check against master/data map
	;                         SQL Fix ProdLog 37550: Compiler does not complain about a property not being correctly mapped
	;  DPV2804 (11/30/2006) - Don't go into ExtractInsertCode if the compiler got an error
	;  DPV2583 (02/01/2006) - Implement MVIndex tables
	;  DPV2318 (10/28/2004) - Support INSERT filing code in-line in xDBC Cached Queries
	;  DPV2198 (03/17/2004) - Use $Username instead of %msql, use new privilege global
	;  DPV2069 (09/10/2003) - New %SYSTEMINCLUDE here, not in %qadctab
	;  DPV1990 (05/22/2003) - Eliminate ^mdd from table compiler
	;  DPV1963 (03/14/2003) - Get routine prefix directly from extent definition
	;  DPV1952 (03/14/2003) - Fix error reporting from table compiler
	;  DPV1916 (01/16/2003) - Don't project SQL Triggers to ^mdd, pass %sc back from table compiler
	;  DPV1907 (01/03/2003) - Pass qstruct through so it is defined later in %qaccpq2 calls to %urmaco
	;  DPV1853 (10/16/2002) - Don't validate any BitMap index's RowIDSpecs
	;  DPV1838 (10/02/2002) - Some error reporting fixes
	;  DPV1806 (08/26/2002) - Don't validate BitMapExtent index map's RowIDSpecs
	;  DPV1581 (08/31/2001) - Pop the macro definition stack when done compiling read-only tables
	;  DPV1279 (03/14/2000) - Perform dummy field check here.
	;  DPV1042 (04/14/1999) - Report syntax errors properly to class compiler
	;  DPV1007 (03/17/1999) - Preserve '_' in identifier names
	;  DPV982  (02/19/99)   - Support table owners
	;  DPV896  (10/27/98)   - Error trap cleanup - no change keys in code
	;  DPV877  (09/23/98)   - Don't Write *7 if error - screws up Studio
	;  DPV822  (02/27/98)   - New table filer
	;  DPV811  (02/03/98)   - Eliminate ^mlock global, license checking
	;  DPV758  (01/19/97)   - New Base Table Triggers
	;  DPV789  (10/30/97)   - Remove dependency on %omserr routine
	;  DPV694  (11/21/96)   - Fix BJB029 - Avoid UNDEFINED error when
	;                         compiling in Italian.
	;  BJB056  (11/20/96)   - Unlock after error in function compile
	;  DPV691  (10/03/96)   - Make background compiles quiet
	;  MRP635  (08/06/96)   - Allow Table Compilation Using a Function...
	;  DPV655  (08/02/96)   - Allow compilations messages to print in 
	;                         Application mode
	;  DPV634  (06/19/96)   - Allow import to work with run-time only license
	;  DPV597  (02/23/96)   - Eliminate duplicate tags, fixed SYNTAX errors
	;  BJB029  (11/07/95)   - Time Read on M/VX with the NULL device
	;  VM026   (01/13/95)   - Provide the ability to quit out from 
	;                         table compilation when asked "Compile
	;                         in the background?"
	;  DPV334  (01/04/95)   - Set success flag to 0 if we error trap
	;  PRT015  (07/18/94)   - Pass tagchar by reference  
	;  DPV210  (06/14/94)   - Display warning(s) for unmapped fields.
	;                         Clean up code.  Copy of %macpt Pre-DPV210 in
	;                         /dbms/new/dev as zmacpt.
	;  VGG105  (12/20/93)   - setup return flag properly
	;  DPV074  (04/21/93)   - Timed READ on error
	;  RLL261  (04/08/93)   - Don't run if not licensed
	;  DPV007  (08/12/92)   - Fixed a <SYNTAX> error
	;  EYT141;ALL003;ALL005;MRP217;RLL129;RLL137;RLL139;RLL142;RLL206
	;  RLL225
	;---------------------------------------------------------------------
	; Note: backgrnd=0 display messages on the principle device
	;               =1 hide messages
	;        
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#ENDIF  ;
	new:'debug %display
	new %ccall,%dir,%line,bytect,d,db,entry,extinfo,file,file1,%keepsource,lis,ncnt,noextra,ortname,rt7name,rtname,rtnct,%substk,syn,%synerr,tagchar,%taglst,v,where,xx,%SYSTEMINCLUDE
	set backgrnd=+$g(backgrnd),%keepsource=$$$qualifierGetValue(qstruct,"keepsource")
		#;  %display=0  Suppress messages
		#;  %display=1  Called from class compile and displayerror is TRUE, display error messages
		#;  %display=2  Called table compile direct (debugging), display all messages
	if 'debug {
		if $d($$$qualifierGetValue(qstruct,"displayerror")) { s %display=$$$qualifierGetValue(qstruct,"displayerror") } ElseIf 'backgrnd { s %display=2 } Else { s %display=0 }	// DPV1952=
	}
	else { set %display=2 }
	s extinfo=$g($$$EXTsqlinfo($$$rEXT,extent))
	i %display=2 w !,"Compiling Table: ",$$$SQLLocTableSchema(extinfo)_"."_$$$SQLLocTableName(extinfo),"  (Extent = ",extent,") ."
	s %ok=1 s:$$$SQLLocTableType(extinfo)'="MVINDEX" %ok=$$valid(extent,extinfo) i %ok,%display=2 w ".."
	i '%ok w:%display=2 !!,$p(%ok,$c(1),2) QUIT
		#;  Don't set error trap here.  Let errors take us back to Compile^%ocsSQLRTDict
	s %ccall="basetable" ;Inform QP caller is BT compiler
	s rtnct=0,ortname="",rt7name=$$$nameTableRoutinePrefixGet(extent),tagchar="A"
		#;  Delete old generated routines (just in case)
	d delete(rt7name)
		#;  Prepare to do a bunch of compiling:
	d start^%qacsub,open^%qacsub
	$$$nsqline
		#;  Generate filing entry points
	d filer^%ocsCacheSQLFiler(extent,.%sc)
quit	i %display=2 w "."
	d close^%qacsub,end^%qacsub
	n iref,oref s iref(1)="" d LINES^%qarmac("iref","oref",,,,,,3,,,,,,,,,,,$g(%caller))
	#; DPV3164 d:'($$$ISERR(%sc))&&($$$SQLLocTableType(extinfo)'="MVINDEX") ExtractInsertCode(extent,$$$nameTableRoutinePrefixGet(extent))	// DPV2318=
	i %display=2,'$g(%synerr),'$$$ISERR(%sc) w ".. Done"
	i $g(%synerr) s %ok=0_$c(1)_"Errors compiling table "_$$$SQLLocTableSchema(extinfo)_"."_$$$SQLLocTableName(extinfo)_".  See compilation output for details."
	$$$popsqline
	QUIT
 
.
 
 
valid(extent="",extinfo) [] PRIVATE {
 	
		#; entry point to validate relation
	  n %ok, %msg
	  s %ok=1,%msg=""
	  If extent="" s %ok=0,%msg=$$$FormatMessage(,"%Compiler","SQLTableNameMissing",,) QUIT %ok_$c(1)_%msg
 
		#; Make sure there is a master map
	  s map=""
	  For  s map=$o($$$EXTSQLMAP($$$rEXT,extent,map)) q:map=""  s mapinfo=$$$EXTSQLMAPsqlinfo($$$rEXT,extent,map) q:$$$SQLLocMapMaster(mapinfo)="Y"
	  If map="" s %ok=0,%msg=$$$FormatMessage(,"%Compiler","SQLDataMapMissing",,$$$SQLLocTableSchema(extinfo),$$$SQLLocTableName(extinfo)) QUIT %ok_$c(1)_%msg
	  
	  	#; make sure the table has a valid lock reference
	  if $$$SQLLocTableLockReference(extinfo)="" {
		  set %ok=0
		  set %msg="Table "_$$$SQLLocTableSchema(extinfo)_"."_$$$SQLLocTableName(extinfo)_" is missing the lock reference that should have been defined earlier in the class compilation"
		  QUIT %ok_$c(1)_%msg
	  }
 
		#; Check for dummy fields
		#; At this point, map is the name of the table's master map
		set storageDefault=$$$LOWER($$$comMemberKeyGet(extent,$$$cCLASSparameter,"STORAGEDEFAULT",$$$cPARAMdefault))
		if storageDefault'="columnar" {
			set badfields="",field="",i=0 
			For  {
				set field=$o($$$EXTSQLCOL($$$rEXT,extent,field)) q:field=""
				continue:'$$dummy(field,extent,extinfo,map)
				set $p(badfields,", ",$i(i))=field
		  	}
		  	if badfields'="" { 
				  set %ok=0,%msg=$$$FormatMessage(,"%Compiler","SQLUnmappedFields",,$$$SQLLocTableSchema(extinfo),$$$SQLLocTableName(extinfo),badfields)
				  RETURN %ok_$c(1)_%msg
			}
		}
 
		#; Test that Row ID based-on order equals subscript order
	  If $$$SQLLocTableRowIDBased(extinfo)="Y" {
		set PhysFieldList=$$$SQLLocTableRowIDPhysicalFields(extinfo)
		set map=""
		for  {
			set map=$o($$$EXTSQLMAP($$$rEXT,extent,map)) quit:map=""  
			set mapinfo=$$$EXTSQLMAPsqlinfo($$$rEXT,extent,map)
				#;  Don't check Bitmap, BitmapExtent, or BitSlice indices
			continue:$case($$$SQLLocMapIndexType(mapinfo),"B":1,"BE":1,"S":1,"C":1,"CD":1,:0)
			if PhysFieldList'=$$MapRowIDFieldList(extent,map) {
				set %ok=0,%msg=%msg_$s(%msg'="":$$$NL,1:"")_$$$FormatMessage(,"%Compiler","SQLBadRowIDSpecs",,$$$SQLLocTableSchema(extinfo),$$$SQLLocTableName(extinfo),map)
			}
		}
		QUIT:'%ok %ok_$c(1)_%msg
	  }
 
		#; Make sure all children have master maps:
	  If $d($$$EXTchildren($$$rEXT,extent)) {
		For i=1:1:$ll($$$EXTchildren($$$rEXT,extent)) {
			s x=$lg($$$EXTchildren($$$rEXT,extent),i)
			s cext=$$$GetExtentNameFromIQN(x)
			If cext="" s %ok=0,%msg=$$$FormatMessage(,"%Compiler","SQLMissingChildTable",,$$$SQLLocTableSchema(extinfo),$$$SQLLocTableName(extinfo),x) q
			s map=""
			For  s map=$o($$$EXTSQLMAP($$$rEXT,cext,map)) q:map=""  s mapinfo=$$$EXTSQLMAPsqlinfo($$$rEXT,cext,map) q:$$$SQLLocMapMaster(mapinfo)="Y"
			If map="" s %ok=0,%msg=$$$FormatMessage(,"%Compiler","SQLMissingChildTableDataMap",,$$$SQLLocTableSchema(extinfo),$$$SQLLocTableName(extinfo),x) q
		}
		If '%ok QUIT %ok_$c(1)_%msg
	  }
	  QUIT %ok
	}
 
MapRowIDFieldList(ext,map) [] PUBLIC {
		#; Returns a list of fields in MapRowIDSpecs for a given map
	  s ilev="",list=""
	  For  {
		  s ilev=$o($$$EXTSQLMAPROWIDSPEC($$$rEXT,ext,map,ilev)) q:ilev=""
		  s ridinfo=$$$EXTSQLMAPROWIDSPECsqlinfo($$$rEXT,ext,map,ilev)
		  s list=list_$lb($lb($$$SQLLocMapRowIDSpecFieldExtent(ridinfo),$$$SQLLocMapRowIDDpecFieldName(ridinfo)))
	  }
	  QUIT list
	}
 
 
	// Entry point to determine if a field is dummy or not.  We answer 1 if dummy 0 if not dummy
	// It is a dummy it it is not computed, not the rowid, not storage type columnar, and not defined on the master map
dummy(field,extent,extinfo,masterMapName) [] PRIVATE {
	set fldinfo=$g($$$EXTSQLCOLsqlinfo($$$rEXT,extent,field))
	RETURN:fldinfo="" 1
	set property=$$$SQLLocColPropertyName(fldinfo)
	if $$$LOWER($$$comMemberArrayGet(extent,$$$cCLASSproperty,property,$$$cPROPparameter,"STORAGEDEFAULT"))="columnar" { RETURN 0 } // columnar storage type field is not a dummy field
	set computed=$$$SQLLocColComputed(fldinfo)="Y"
	set onmap=$s($$$EXTSQLCOLOnMapSub($$$rEXT,extent,field,masterMapName):1,$$$EXTSQLCOLOnMapData($$$rEXT,extent,field,masterMapName):1,1:0)
		#; check if rowid (if icol=1) or inrowid
	set rowid=($$$SQLLocColNumber(fldinfo)=1)
	set inrowid=$lf($$$SQLLocTableRowIDLogicalFields(extinfo),field)
	set parid=($$$SQLLocColNumber(fldinfo)=0)	// maybe it's the parent id
		#; if not comp and not on map and not(rowid or in rowid) it's dummy
	if 'computed,'onmap,'(rowid||inrowid||parid) { RETURN 1 }
		#; it's not dummy
	RETURN 0
}
 
 
delete(prfx) [] PRIVATE {
		#;Delete routines beginning with prfx
	  QUIT:$g(prfx)=""
	  For i=49:1:57,65:1:90,97:1:122 s rtn=prfx_$c(i) q:'$d(^rMAC(rtn))  k ^rMACSAVE(rtn),^rMAC(rtn),^ROUTINE(rtn),^rOBJ(rtn),^rINDEX(rtn,"MAC"),^rINDEX(rtn,"INT"),^rINDEX(rtn,"BAS"),^rINDEX(rtn,"OBJ")
	  QUIT
	}
 
 
table(schema,table="",qspec) [qstruct] PUBLIC {
		#;  Compile a single table
	  $$$qualifierParseFull(%sc,qspec,qstruct)
	  set:table="" table=$$$TableFromIQN(schema),schema=$$$SchemaFromIQN(schema)
	  s ext=$$$GetExtentNameFromTableName(schema,table)
	  i ext=""||('$d($$$EXT($$$rEXT,ext))) w !,"No such table '"_schema_"."_table_"'" QUIT
	  do %qadcpt(ext,0,.ok,.qstruct,.%sc,1)
	  QUIT
	}
 
 
all(qspec)	;entry point to compile all tables -----
	w !,"Stopping Journaling" d DISABLE^%SYS.NOJRN()
	n ext,qspec,qstruct,schema,table,tcount,zh
	$$$qualifierParseFull(%sc,qspec,qstruct)
	s qstruct("displayerror")=2
	s zh=$zh,schema="&",tcount=0
	s $zt="allError^%qadcpt"
loop	For  {
		s schema=$o(^rINDEXSQL("TABLE",schema)) q:schema=""
		s table=""
		For  {
			s table=$o(^rINDEXSQL("TABLE",schema,table)) q:table=""
			s ext=$$$GetExtentNameFromTableName(schema,table)
			d %qadcpt(ext,0,,.qstruct,.%sc,1)
			s tcount=tcount+1
		}
	}
	w !!,tcount," tables compiled in ",($zh-zh)," seconds."
	w !,"Re-Starting Journaling" d ENABLE^%SYS.NOJRN()
	QUIT
allError w !!,"Error:  "_$ze,!!
	g loop  // try next table
 
 
#INCLUDE %sqlcode
#INCLUDE %fcalpha
---
