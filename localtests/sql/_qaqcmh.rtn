====
qaqcmh
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqcmh^MAC^^^0
%qaqcmh	// code generation for non-SELECT statements
	;; COMPONENTS :: SQL/CodeGeneration
	#;
#INCLUDE %msql
#IF 0   ;-------------------------------------------------------------
	; Description:   Code generator for ext tables
	;
	;  JMM1134 (12/22/2021) - Consistently use shard map screening, or not, in all shard-local queries of a given sharded query
	;  AK1047  (10/06/2021) - Columnar WHERE filter for "onerow"/GROUP BY
	;  AK850   (11/30/2020) - Implement lateral join
	;  AK1038  (02/04/2021) - Query reconstruction for "onerow"/"empty"
	;  JMM996  (08/12/2020) - Online sharded cluster rebalancing
	;  AK1021  (08/05/2020) - Compute streamless expressions on the master
	;  AK992   (11/29/2018) - Literals in ODBC date/time escape sequences
	;  JMM912  (09/14/2018) - Recognize cosharded correlated subqueries and execute them locally
	;  JMM861  (03/21/2018) - Avoid <UNDEFINED> error for mt("shtop",qn) in sharded queries
	;  JMM858  (03/15/2018) - Fix queries with sharded subqueries in select list, for unified shard databases
	;  JMM837  (12/27/2017) - Unified routine and globals databases for sharded cluster
	;  AK971   (10/17/2017) - View row identifiers for sharded outer join
	;  AK969   (10/03/2017) - Handle SELECT-no-FROM for sharding
	;  AK968   (09/19/2017) - More fixes to mt("v") clobbering
	;  AK932   (05/28/2015) - GENQ: Produce "?" for outer correlated fields
	;  AK949   (03/07/2016) - GENQ: Generate %VID
	;  AK943   (12/08/2015) - Fix %PATTERN query reconstruction
	;  AK938   (07/29/2015) - Sharded joins
	;  AK907   (04/29/2014) - Use $$SplitSize() for %PARALLEL partitioning
	;  AK915   (08/29/2014) - GWQ: Suppress LIKE-implied %STARTSWITH in WHERE
	;  PVA309  (06/20/2014) - Fix behavior of MVR and MINUS collation with DISTINCT, GROUP BY, and MAX/MIN
	;  AK881   (06/12/2014) - Check for %SQLGateway before closing connection
	;  PVA303  (04/22/2014) - Regenerate FROM hints for regenerated sql (for gateway or %parallel) 
	;  AK889   (10/02/2013) - GWQ: Quote field name for first IDKEY field
	;  AK785   (08/19/2010) - GWQ: Double-paren constants in GW queries
	;  AK849   (01/18/2012) - Parallel processing for UNION
	;  AK817   (07/21/2011) - GWQ: Handle Communication link error -461
	;  AK804   (12/07/2010) - GWQ: Use AS for field and table aliases
	;  AK774   (06/02/2010) - GWQ: Use actual SCALE to bind Numeric param
	;  AK772   (05/20/2010) - GWQ: Evaluate DECODE arguments correctly
	;  MIT1000 (05/20/2010) - Support LIST(DISTINCT...) in linked tables
	;  AK765   (12/23/2009) - GWQ: fix ORDER BY in subqueries
	;  AK762   (12/02/2009) - GWQ: fix overflow lines for long query
	;  AK754   (10/19/2009) - GWQ: No SELECT alias for scalar subquery
	;  AK751   (10/01/2009) - EXTQGEN: Don't generate TOP ALL for main query
	;  AK745   (08/10/2009) - Fixes to DISTINCT/GROUP and external queries
	;  PVA183  (05/26/2009) - Pre-optimizer support for TOP...ORDER BY in subqueries
	;  AK729   (03/xx/2009) - EXTQGEN: fix ORDER BY generation
	;  AK731   (03/19/2009) - EXTQGEN: Show external queries in Plan
	;  AK722   (02/17/2009) - EXTQGEN: fix rowid and SELECT aliases
	;  AK724   (02/17/2009) - Fix external query generation for IN with ?
	;  BJB402  (11/19/2008) - if dnQ=1 make sure field names and Aliases do not start with "%"
	;  AK714   (11/17/2008) - Fix linked queries with OUTER JOIN
	;  BJB401  (11/15/2008) - Correct case of Field for View against a linked table
	;  BJB399  (11/13/2008) - Only use Field Alias when needed for linked table queries
	;  BJB394  (08/05/2008) - Linked table query over 4000 char get extra char
	;  AK707   (07/01/2008) - Generate NOT[ correctly in linked queries
	;  PVA157  (05/01/2008) - Support faster DISTINCT while preserving case (i.e. with FASTDISTINCT OFF )
	;  AK691   (02/14/2008) - Implement heterogeneous queries
	;  AK695   (03/19/2008) - Gateway SELECT code-generation improvements
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  JMM004  (11/02/2004) - Support INSERT INTO <tablename> DEFAULT VALUES
	;  AK590   (12/30/2003) - EXTAB: FROM with multiple OUTER JOIN
	;  DPV2114 (11/03/2003) - Don't set $ze="" in Generated SQL code
	;  DPV2091 (10/16/2003) - Final ^mdd elimination
	;  DPV2090 (10/10/2003) - Make mt public in buildIdList
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  AK478   (06/15/2001) - EXTAB: use exact casing for field name
	;  AK395   (?9/?3/1999) - External tables
	;
#ENDIF  ;-------------------------------------------------------------
#define odbcgatewayHandle "%SQLGateway"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK691
gendsn	;  [public: mod,mt,asl,lines,tag]  generate loop on gateway query m for dsn
	n param,dsn,m,vsql,vhdbc,vwide,vhstmt,verr,ReverseOJ,isJDBC,useCAST,dnQ,nCONV,useCOAL,needLEN,uniStream,useCASTCHAR,noconcat,idlist,prm,corrm,sqlstr,chunksize,jj,val,datyp,vars,irn,ifn,sets,fn,fnv,sc,connectionName
	s dsn=asl(mod,funk,ndata,"id"),m=$p(dsn,$c(1),7),dsn=$p(dsn,$c(1),9)
	s vsql=$$$getVarName("sql"_mod),vhdbc=$$$getVarName("hdbc"_mod),vwide=$$$getVarName("wide"_mod),vhstmt=$$$getVarName("hstmt"_mod),verr=$$$getVarName("err"_mod)
	s $$$mtGatewayMod=$g($$$mtGatewayMod)_$lb(mod)
	s sc=$$getFlags^%apiGTW(dsn,.ReverseOJ,.isJDBC,.useCAST,.dnQ,.nCONV,.useCOAL,.needLEN,.uniStream,.useCASTCHAR,.noconcat)
	if 'sc {
	 s connectionName=dsn
	 d error^%qaqperr(162)
	 quit
 }
.
		// heterogeneous queries via JDBC are not currently supported
	if isJDBC { set connectionName=dsn do error^%qaqperr(163) quit }	// d exsel^%qaqcmxj q
	s prm="",corrm=$lfs($$$mtPCorrelatedFields($$$mtP(m)))_$$latm^%qaqpre2(m)  ;  AK932 ; AK850
	#;  prm=$LIST(val) of all parameters, generated by call as side-effect
	#;  corrm=$LIST(val)  ;  correlated fields used witnin m's context
	#;  *** prm must be in order of appearance, otherwise we must fix it!
	s sqlstr=$$buildsubq(m)
	#; AK731
	s $$$mtSql(m)=sqlstr
 s chunksize=2000
	#; AK762
	f jj=1:chunksize:$l(sqlstr) $$$liin("s "_vsql_"="_$s(jj>1:vsql_"_",1:"")_$$quoter($e(sqlstr,jj,jj+chunksize-1)))
	i 0 d sqlact^%qaqcmx(.sql,.iarr)  ;  *** maybe not needed???
	$$$liin("s "_vhdbc_"=$$GetConnection^%apiGTW("""_dsn_"""),"_vwide_"=%SQLGateway(""-uv"")&&$zbitget($zversion(0),1)")
	#; AK817
	$$$liin("i "_vhdbc_"="""" s %msg=""Connection '"_dsn_"': Can't get connection"",SQLCODE=-221 ztrap ""GWSQ""")  ;  GetConnection()
	$$$liin("i "_vhstmt_"="""" "_$$gwzf5(vhstmt,",5,"_vhdbc))  ;  AllocStatement()
	$$$liin("i "_vhstmt_"="""" s "_vhdbc_"=$$Reconnect^%apiGTW("""_dsn_""") "_$$gwzf5(vhstmt,",5,"_vhdbc)_" "_$$doerr(vhstmt_"=""""",222,"Allocate statement"))  ;  AllocStatement()  ; AK817
	$$$liin($$gwzf5(verr,",$s(%SQLGateway(""-uv""):37,1:3),"_vhstmt_","_vsql))  ;  Prepare[W]()
	$$$liin($$doerr(verr,223,"Prepare(""_"_$$quoter($e(sqlstr,1,45)_$s($l(sqlstr)>45:"...",1:""))_"_"")"))  ; AK817
	i prm'="" {
		n precs,datyps,scales,ones s $p(ones,"1,",$ll(prm))=1
	#; AK774
		#;  for Numeric (=2) param, use scale of actual runtime value
		f jj=$ll(prm):-1:1 s val=$li(prm,jj),ifn=$$$VTRgetifn(val),datyp=$$$VTRgetdt(val),datyp=$s(ifn="":$$definfo^%qaqpif2($s(datyp="":"%Library.String",1:datyp)),1:$$finfo^%qaqpif2(ifn)),$p(precs,",",jj)=$p(datyp,$c(1),4),$p(datyps,",",jj)=$p(datyp,$c(1),2),$p(scales,",",jj)=$s($p(datyp,$c(1),2)=2:"$l($p("_pti(val)_",""."",2))",1:$p(datyp,$c(1),5))
	#; AK774-
		$$$liin($$gwzf5(verr,",8,"_vhstmt_",$lb("_precs_"),$lb("_datyps_"),$lb("_scales_"),$lb("_ones_"),$lb("_precs_")"))  ;  BindParameters()
		$$$liin($$doerr(verr,225,"Bind parameters"))  ; AK817
		f jj=1:1:$ll(prm) { s val=$li(prm,jj),datyp=$$$VTRgetdt(val)
			s val=$s(datyp="%Library.Date":"$s("_pti(val)_"="""":"""",1:$zd("_pti(val)_",3))",datyp="%Library.Time":"$s("_pti(val)_"="""":"""",1:$zt("_pti(val)_"))",1:pti(val))
			$$$liin($$gwzf5(verr,","_$select(datyp="%Library.Binary":65,1:9)_","_vhstmt_",$lb("_val_"),"_jj))  ;  SetParameter()
		}
	}
	$$$liin($$gwclosecursor(verr,vhstmt)_" "_$$gwzf5(verr,",4,"_vhstmt))  ;  CloseCursor()+Execute()
	$$$liin($$doerr(verr,226,"Execute"))  ; AK817
	s line1=bottom,bottom=tagpre_"k1",tag=bottom  ;  "next" tag
	$$$liin($$gwzf5("SQLCODE",",7,"_vhstmt))  ;  Fetch()
	$$$liin("i SQLCODE=100 "_$$gwclosecursor(verr,vhstmt)_" g "_line1)  ;  no more rows - CloseCursor()
	$$$liin($$doerr("SQLCODE",227,"Fetch (server error: ""_SQLCODE_"")"))  ; AK817
	f jj=1:1:$ll($$$mtAlphaUpAliases(m)) {
		s val=$p($$$mtOutputVals($$$mtOutput(m)),",",jj),vars=pti(val),irn=$$$VTRgetirn(val),ifn=$$$VTRgetifn(val),datyp=""
		continue:$$$mtVType($$$mtV(val))="t" // if constant, either null output (leads to error) or would've been pulled out and set locally anyway
		s:$d($$$mtVirf(+ifn)) irn="",ifn=""
		i irn'="",ifn'="" s datyp=$$$smdColxDBCType(1,irn,ifn)
		i (datyp="LONGVARCHAR")!(datyp="LONGVARBINARY") $$$liin("s "_vars_"=$$createTempStream^%apiGTW("_vhstmt_","_jj_",$g(%qacn),"_(datyp="LONGVARBINARY")_","_vwide_")") CONTINUE  ;  copy stream, assign oref to var
		if (datyp'="BINARY")&&(datyp'="VARBINARY") {
			$$$liin($$gwzf5(vars,",$s("_vwide_":50,1:25),"_vhstmt_","_jj_",$s("_vwide_":-8,1:1)"))  ;  GetData[W]()
		}
		else {
			$$$liin($$gwzf5(vars,",25,"_vhstmt_","_jj_",-2"))  ;  GetData[W]()
		}
	#; AK817
		$$$liin($$gwzf5(verr,",13")_" "_$$doerr(verr,228,"GetData(C"_jj_")"))  ;  WasError(), because data was returned
		d GenMethod^%qaqcmx(ifn,irn,"OdbcToLogical",vars)
		s sets="",fn=""  ;  set all "unary" functions on val
		f  s fn=$o(mt("unary",val,fn),1,fnv) q:fn=""  d adset(pti(fnv),$s($$$mtVType($$$mtV(fnv))'="f":$$opval^%qaqcpre(fn,val,vars),1:$$gencoll^%qaqcpre(fn,vars)))
		d setin
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
gwclose	;  gateway queries CLOSE code (drop statements) - from close/error^asl
	#; AK849
	#;  reuse the query task cleanup/%EndQuery() line in CLOSE/errtag
	n jj f jj=1:1:$g(mt("quq")) if (jj=1)&&cflag&&(ltf="") { $$$liin("n %sqlup") } $$$liin(mt("quq",jj))
	#; AK849-
	QUIT:$g($$$mtGatewayMod)=""  ;  no gateway queries
	n verr,jj,vhstmt s verr=$$$getVarName("err"_$li($$$mtGatewayMod))
	f jj=1:1:$ll($$$mtGatewayMod) s vhstmt=$$$getVarName("hstmt"_$li($$$mtGatewayMod,jj)) $$$liin("i "_vhstmt_"'="""",$g("_$$$odbcgatewayHandle_") { "_$$gwzf5(verr,",16,"_vhstmt)_" }")  ;  DropStatement()
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
gwzf5(var,x)  ;  set into var result of gateway call with parameter(s) x
	QUIT "s "_var_"=$zf(-5,"_$$$odbcgatewayHandle_x_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
gwclosecursor(verr="",vhstmt="") [mod] PUBLIC {
	s:vhstmt="" vhstmt=$$$getVarName("hstmt"_mod)
	s:verr="" verr=$$$getVarName("err"_mod)
	QUIT $$gwzf5(verr,",17,"_vhstmt)
}
lasterr()  ;  gateway LastError() call
	QUIT "$li($zf(-5,"_$$$odbcgatewayHandle_",12,"_vhdbc_","_vhstmt_"))"  ;  GetSQLErrors()
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK817
doerr(cond,sqlcode,msg)  ;  [public: dsn,vhdbc,vhstmt]  handle gateway error
	QUIT "d:"_cond_" GWQError^%apiSQL("""_dsn_""","_sqlcode_","""_msg_""","_vhdbc_","_vhstmt_")"
	#; AK817-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddcon(irn) QUIT $$$smdConnection(1,irn)  ;  connection information	// DPV3500
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adset(into,from)  ;  add a SET argument to the sets line
	QUIT:into=from
	d:$l(sets)+$l(into)+$l(from)-20>$$$complength setin s sets=sets_","_into_"="_from
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setin	if sets'="" $$$liin("s "_$e(sets,2,*)) s sets=""  ;  add SETs line
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK691-
buildsubq(qn)  ;  generate external query for subquery qn
	n ftGen,ftFakeStream,i,iloc,j,jp,loj,pos,repl,res,thvloc,tsql,vars,vn
	i 0,$d($$$mtRecordParamsRoot) d ohvloc^%qaqcmxc(.mt)
	if $d($$$FTRegeneratedQueryBlock(qn), ftFakeStream)	{
		// use throughout to know if we are generating this query for ft
		set ftGen = 1
		// typically done in gendsn() but we don't go there for ft
		new prm, useCOAL
		set prm = ""
		set useCOAL = 0
	}
	s param=0
	s loj=0
	s res=$$gensel(qn,$ll($g($$$mtUnionTopDSN(qn)))>1)
	if res="" f i=1:1:sql s res=res_" "_sql(i)
	i 0,$g(mt("hvloc"))'="" s j=2 f  d  q:jp=($ll(mt("hvloc"))+1)  s j=jp+1
	. s jp=$lf(mt("hvloc"),"*",j)
	. if jp'>j s jp=$ll(mt("hvloc"))+1
	. s vn=" ? "
	. i jp-j=4 d
	. . s repl($li(mt("hvloc"),j+1),$li(mt("hvloc"),j+2))=$lb(vn,$li(mt("hvloc"),j+1),$li(mt("hvloc"),j+2)+$l(vn)-1)
	. i jp-j=6 d
	. . i $li(mt("hvloc"),j+1)=$li(mt("hvloc"),j+4) s pos=$li(mt("hvloc"),j+5)-1
	. . i $li(mt("hvloc"),j+1)'=$li(mt("hvloc"),j+4) s pos=$l(sql($li(mt("hvloc"),j+1)))
	. . s repl($li(mt("hvloc"),j+1),$li(mt("hvloc"),j+2))=$lb(vn,$li(mt("hvloc"),j+4)-1,pos)
	. . s param=param+1,param(param)=$p($$$mtV($li(mt("hvloc"),j+3)),"^",2)
	d repldts^%qaqcmxc(.res)
	if $g(ftGen) {
		set $$$FTFakeStreamQueryParameters(ftFakeStream) = prm
	}
	QUIT res   ;$tr(res,$c(0),"""")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
quoterU(x)
 n bF,i 
 s bF=0
 for i=1:1:$l(x) { 
 	if $a($e(x,i,i))>127 {
	 	s bF=1
	 	q
 	}
 }
 QUIT:bF $zu(144,1,x) 
 if $g(dnQ)>0 Quit $tr(x,".","_")   //Quit $$quoter2(x) 
	QUIT $$quoter(x,1)  ;  MIT815
 
 
getLPat(str) n lpat,jj s lpat=""
 f  d  q:str=""
 . i $e(str,1,2)="1E" s lpat=lpat_"_",$e(str,1,2)="" QUIT
 . i $e(str,1,2)=".E" s lpat=lpat_"%",$e(str,1,2)="" QUIT
 . f jj=3:1:$l(str)+2 i $e(str,jj)'="""",$l($e(str,1,jj),"""")#2 QUIT
 . i $e(str,1,2)'="1"""!(jj>($l(str)+1)) s lpat="",str="" QUIT  ;  not from LIKE
 . s @("lpat=lpat_"_$e(str,2,jj-1)),$e(str,1,jj-1)=""
 if lpat="" QUIT ""
 QUIT $$squoter(lpat)
.
toper(op) 
     QUIT:(op="%EXACT"&&'$g(ftGen)) ""
     QUIT:op="%ODBCIN" ""
     QUIT:op="'=" "<>"
     QUIT:op="'<" ">="  
     QUIT:op="'>" "<=" 
	#; AK707
	QUIT:op="'[" "NOT["  
	QUIT:op="']" "NOT]" 
	#; AK707-
     //QUIT:op="%PLUS" "+" 
     //QUIT:op="%MINUS" "-"
     QUIT:op="_" "||" 
     QUIT:op="&" "AND" 
     QUIT:op="!" "OR" 
     QUIT:op="'" "NOT" 
     QUIT:op="%L2SW" "" 
     QUIT:op="FOR SOME" "exists"
     QUIT:op="NOTEXISTS:=" "not in"
     if $p(op,".")="METHOD:%Collation" {
	     new mop set mop=$p(op,".",2)
	     QUIT:$case(mop,"TSEQDate":1,"MVDEQDate":1,"TSEQMVDate":1,"FMTSEQTS":1,"FMDEQTS":1,"FMTSEQDate":1,"FMDEQDate":1,"FMTSEQPT":1,"PTEQDate":1,"PTEQTS":1,"FMDEQPT":1,:0) "="
	     QUIT:$case(mop,"TSNEDate":1,"MVDNEDate":1,"TSNEMVDate":1,"FMTSNETS":1,"FMDNETS":1,"FMTSNEDate":1,"FMDNEDate":1,"FMTSNEPT":1,"PTNEDate":1,"PTNETS":1,"FMDNEPT":1,:0) "<>"
	     QUIT:$case(mop,"TSGTDate":1,"MVDGTDate":1,"TSGTMVDate":1,"FMTSGTTS":1,"FMDGTTS":1,"FMTSGTDate":1,"FMDGTDate":1,"FMTSGTPT":1,"PTGTDate":1,"PTGTTS":1,"FMDGTPT":1,:0) ">"
	     QUIT:$case(mop,"TSGEDate":1,"MVDGEDate":1,"TSGEMVDate":1,"FMTSGETS":1,"FMDGETS":1,"FMTSGEDate":1,"FMDGEDate":1,"FMTSGEPT":1,"PTGEDate":1,"PTGETS":1,"FMDGEPT":1,:0) ">="
	     QUIT:$case(mop,"TSLTDate":1,"MVDLTDate":1,"TSLTMVDate":1,"FMTSLTTS":1,"FMDLTTS":1,"FMTSLTDate":1,"FMDLTDate":1,"FMTSLTPT":1,"PTLTDate":1,"PTLTTS":1,"FMDLTPT":1,:0) "<"
	     QUIT:$case(mop,"TSLEDate":1,"MVDLEDate":1,"TSLEMVDate":1,"FMTSLETS":1,"FMDLETS":1,"FMTSLEDate":1,"FMDLEDate":1,"FMTSLEPT":1,"PTLEDate":1,"PTLETS":1,"FMDLEPT":1,:0) "<="
     }
     if $e(op,1,$l("METHOD:"))="METHOD:",$e(op,$l(op)-$l(".TimeStamp.LogicalToTimeStamp")+1,$l(op))=".TimeStamp.LogicalToTimeStamp" s op=""
     if $e(op,1,$l("METHOD:"))="METHOD:",$e(op,$l(op)-$l(".Date.LogicalToDate")+1,$l(op))=".Date.LogicalToDate" s op=""
     #; These are conterintuitively parsed
     QUIT:op="%INBIT" "%FIND"
     QUIT:op="%FIND" "%INSET"
     QUIT op 
localEval(vIdx) [mt] public {  ;  AK1021
	#; returns locally evaluated expression id
	s v=$$$mtV(vIdx)
	RETURN:$e(v,1,11)="v^SET:LIST^" $$$mtVExprOperand1(v)
	RETURN:$e(v,1,9)="v^%SPACE^" $$$mtVExprOperand1(v)
	RETURN vIdx
} 
vertVal(mt, vIdx, exact=1)
	if vIdx="" quit ""
	if $DATA($$$mtV(vIdx))=0 quit ""
	new res,arg1,arg2,arg3,arg4,op,func,val,dist,tf,tmp,tname,tt,i,len,qn,tn1,sn1,ifn,irn,stn,schemae,alias,vqn
	#; AK691
	n v s v=$$$mtV(vIdx)
        set res="",tt=0
        if $$$mtVType(v)="f" {
        	s stn=$$$mtVFieldQbOrStream(v),ifn=+$$$mtVFieldLabelOrIFN(v)
        	//Non-numeric ifn means an external field
			if ifn=0 QUIT $$parseExtField^%qaqcmx(.mt, vIdx)
			if $g(ftGen) QUIT $$parseFTField(vIdx, ifn, stn)
		s qn=$$$mtRQb($$$mtR(stn)),irn=$$$mtRIrn($$$mtR(stn))
		QUIT:v["_" $$coll($p(v,"_",2,3),$$vertVal(.mt,$p(mts(qn,stn,"ATT",ifn),"^",5),0 /* already collated */))
        	s alias="T"_stn
        	set vqn=$G($$$mtRVirtual(stn))
	#; AK722
	#; AK949
		i vqn'="" { s res=vIdx-$$$mtPViewIDVal($$$mtP(vqn)) RETURN alias_"."_$s(res:"C"_res,1:"%VID") }
	#; AK849
		if $$$smdColCollation(1,irn,ifn)="" set exact = 0 //no need for %EXACT if no default collation
		QUIT:$tr($g($$$mtDSNLinkedTable(qn))," ")="" $s(exact:"%EXACT ",1:"")_alias_"."_$$quoter2($$$smdGetFieldName(ifn))
	#; AK849-
	#; AK691
		n irn s irn=+$$$mtR(stn)
	#; AK722
			#;  rowid may require special construction
		QUIT:ifn=$p(mts(qn,stn),"^",5) $$buildIdFromName^%qaqcmx($p($$$smd(8,ifn),$c(1),11),$p($$$smd(8,ifn),$c(1),9),alias)
	#; AK722-
	#; AK691
			#;  use exact case (for Sybase) of original field name
		s tf=$$$smdColExternalFieldName(1,irn,ifn)
	#; AK691-
        	quit alias_"."_$$quoterU(tf)
	}
	if $$$mtVType(v)="t" {
	#; AK785
		s $e(v,1,2)=""
		QUIT:v="" "NULL"  ;  do we need ((NULL))?
		QUIT:v=$c(0) "((''))"
		If ($$$mtVType(v)=0)&&($l(v)>1) {
			QUIT:$g(asOriginal) $$constantInLogical(vIdx)
			QUIT "(('"_$$escQuotes(v)_"'))"
		}
		QUIT:$isvalidnum(v)&&$g(mt("noquconst",vIdx)) "(("_v_"))"
		//%PARALLEL and other Cache-to-Cache queued queries always
		//use logical constants, as they'll run in logical mode
		QUIT:$g(asOriginal) $$constantInLogical(vIdx)
		QUIT "(('"_$$escQuotes(v)_"'))"
		#; AK785-
	}
	RETURN:v="x^0" ""  ;  indicates missing argument in a function
	i $$$mtVType(v)="x",v=("x^"_+$$$mtVParam(v)) { s val=$$$mtVParam(v)  ;  lateral field  ;  AK850
		RETURN:'$lf($g(corrm),val) $$vertVal(.mt,val)
		RETURN $$adprm(vIdx)
	}
	#; AK691
	#;  collect list of parameters (must be in order!)
	RETURN:$$$mtVType(v)="x" $$adprm(vIdx)
	i $$$mtVType(v)="n" { s val=$$$mtVCorrVal(v) RETURN:'$lf($g(corrm),val) $$vertVal(.mt,val) RETURN $$adprm(vIdx) }  ;  AK932
	RETURN:$$$mtVType(v)="a" $$aggregate(v)
	if $$$mtVType(v)="v" {
		set op=$$$mtVExprOperator(v)
		#; %MATCHES2PAT is added during parsing for code generation, remove when regenerating
		if op="%MATCHES2PAT" {
			n qval
			Set arg1 = $$vertVal(.mt, $$$mtVExprOperand1(v))
			Set arg2 = $$vertVal(.mt, $$$mtVExprOperand2(v))
			Set qval = arg1
			If arg2 '="" Set qval = qval _ " ESCAPE " _ arg2
			QUIT qval
		}
		if op="%L2PAT" {
			Set arg1 = $$vertVal(.mt, $$$mtVExprOperand1(v))
			Set arg2 = $$vertVal(.mt, $$$mtVExprOperand2(v))
			QUIT op_" "_arg1_$s(arg2'="":" ESCAPE "_arg2,1:"")
		}
		if $e(op,1,7)="SYSVAR:"{
			Quit $p(op,":",2)
		}
	}
	RETURN:$e(v,1,6)="l^L2V^" $$parseCond(.mt,$p(v,"^",4),0)
	#;  evaluate streamless expressions on the master,
	#;  it can have no correlated fields other than corrm, it could
	#;  have subqueries (that are already marked for master evaluation),
	#;  but no fields or aggregates (except within subqueries)
	#;  also no oref's (e.g. %FIND), special case for SET:LIST/%SPACE
	i $p(v,"^",3)=",",'$bit($g(mt("localoref")),vIdx),$$nogenval("v",vIdx) { RETURN $$adprm($$localEval(vIdx)) }  ;  AK1021
	if $$$mtVType(v)="v" {
		if $$$mtVExprOperator(v)="CASE" {
			s tmp="CASE "
			n num,jj,idx1,idx2 s num=($length(v,"^")-5)
			for jj=1:2:num {
				s idx1= $piece(v,"^",3+jj) 
				s idx2= $piece(v,"^",3+jj+1)
				s tmp=tmp_" WHEN "_$$vertVal(.mt,idx1)_" THEN "_$$vertVal(.mt,idx2) 
			}
			s tmp=tmp_" ELSE "_$$vertVal(.mt,$piece(v,"^",num+4))
			quit tmp_" END "
		}
		set op=$$$mtVExprOperator(v)
		if $p(op,":",1)="%WINDOW_FUNCTION" RETURN $$windowFunction(vIdx)
		RETURN:$e(op,1,7)="%VFVID:" "T"_$e(op,8,*)_".VID"  ;  AK971
		i op="%VHASH" {  ;  AK971
			n jj s res=""
			f jj=4:1:$l(v,"^")-1 { s res=res_","_$$vertVal^%qaqcmh(.mt,$p(v,"^",jj)) }
			RETURN:(res=",((0))")||(res=",(('0'))") "((0))"  ;  for "onerow"  *** maybe more cases to optimize
			RETURN "%VHASH("_$e(res,2,*)_")"
		}
		i op="%BARS" {
			n jj s res = ""
			f jj=4:1:$l(v,"^")-1 {
				s res = res _ "||'||'||"_"("_$$vertVal^%qaqcmh(.mt,$p(v,"^",jj))_")"
			}
			RETURN $e(res,9,*)
		}
		if (op="LISTBUILD") || (op="LISTSAME") {
			n qval 
			s qval="$"_$ZCONVERT(op, "L")_"("
			n i,vl f i=4:1:$l(v,"^")-1 s vl=$p(v,"^",i) if vl'="" { s vl=$$vertVal^%qaqcmh(.mt,$p(v,"^",i)),qval=qval_$e(",",i>4)_vl } else { s qval=qval_"," }
			s qval=qval_")"
			QUIT qval
		}
		if op="COALESCE" {
			n qval 
			s qval="COALESCE("
			n i,vl f i=4:1:$l(v,"^")-1 s vl=$p(v,"^",i) if vl'="" { s vl=$$vertVal^%qaqcmh(.mt,$p(v,"^",i)),qval=qval_$e(",",i>4)_vl } else { s qval=qval_"," }
			s qval=qval_")"
			QUIT qval
		}
		#;"v^USERDEFINEDFUNCTION:SQL.Parallel.Keys.BaseFunctionality.DelimData:tvf delim:SQL_PARALLEL_KEYS_BASEFUNCTIONALITY.DELIMDATA_TVF DELIM^,2,^2^"
		if $e(op,1,20)="USERDEFINEDFUNCTION:" {
			#;HSU298+
			#; $$$mtV(3)="v^USERDEFINEDFUNCTION:SQL.Parallel.Keys.BaseFunctionality.DelimData:tvf delim:SQL_PARALLEL_KEYS_BASEFUNCTIONALITY.DELIMDATA_TVF DELIM^,2,^2^"
			#; always add delimited identifier quotes to stored procedures., in this example, "DELIMDATA_TVF DELIM"
			n qval
			n op4 s op4 = $p(op,":",4) 
			if $l(op4,".")=2 { 
				s $p(op4,".",2) = $$quoter2($p(op4,".",2))
				s qval=op4_"("
			}
			else{
				set:'$$isSearchIndex(vIdx,v, .qval) qval=$p(op,":",4)_"("
			}
			#;HSU298-
			n i,vl f i=4:1:$l(v,"^")-1 s vl=$p(v,"^",i) if vl'="" { s vl=$$vertVal^%qaqcmh(.mt,$p(v,"^",i)),qval=qval_$e(",",i>4)_vl } else { s qval=qval_"," }
			s qval=qval_")"
			QUIT qval
		}
		#; %SPACE collation is always implicit. Regenerated query will re-apply it during parsing
		if op="%SPACE" QUIT $$vertVal(.mt, $$$mtVExprOperand1(v))
		#; parameterized ops like %TRUNCATE(10) should become %TRUNCATE(arg1,10)
		#; remaining "user defined functions" like MSCONVERT: can be identified by their ":"
		if (op [ "(") && (op'[":") {
			QUIT $$coll(op,$$vertVal^%qaqcmh(.mt,$$$mtVExprOperand1(v)))
		}
		QUIT:(op="%RMLSP"||(op="%RMVR")||(op="%RMINUS")) "%SYSTEM.RevM"_$e(op,4,*)_"("_$$vertVal(.mt,$$$mtVExprOperand1(v))_")"		// YCL294 Use uncollate(coll(f)) explicitly in the reconstructed query	
		i op="%ODBCIN" {  ;  AK992;TRW1640;AK994
			n asOriginal s asOriginal = 0
			RETURN:$$$VTRgetcat($$$mtVExprOperand1(v))="DATE" "{d "_ $$vertVal(.mt,$$$mtVExprOperand1(v))_"}"
			RETURN:$$$VTRgetcat($$$mtVExprOperand1(v))="TIME" "{t "_ $$vertVal(.mt,$$$mtVExprOperand1(v))_"}"
			RETURN:$$$VTRgetcat($$$mtVExprOperand1(v))="TIMESTAMP" "{ts "_ $$vertVal(.mt,$$$mtVExprOperand1(v))_"}"
			RETURN "%ODBCIN(" _ $$vertVal(.mt,$$$mtVExprOperand1(v)) _ ")"
		}
		
		RETURN:op="USER" "USER"
		i op="/0" {  ;  AVG(s) - normally "/0"(SUM(s),COUNT(s)), but if s is
			#;  streamless, either might have gone through AK1047 stag conversion
			s arg1=$$$mtV($$$mtVExprOperand1(v))
			i $e(arg1,1,6)'="a^sum^" {  ;  converted, use AVG(s)
				s v=$$$mtV($$$mtVAggOperand(v))
				#;  count(s) must have been converted to IFNULL(s,...)
				RETURN "AVG("_$$vertVal(.mt,$p(v,"^",$s($e(v,1,8)="a^count^":5,1:4)),$$needsExact(op))_")"
			}
		}
		if op = "XMLFUNC" { Return $$xmlUnflatten($p(v,"^",6, *-1), vIdx)}
		set arg1=$$vertVal(.mt, $$$mtVExprOperand1(v), $$needsExact(op))
		QUIT:op="/0" "AVG"_$e(arg1,4,*)				// DPV4377  reconstruct AVG()
		i op="DECODE" n jj s res="DECODE("_arg1 f jj=5:1:$l(v,"^")-1 { set res=res_","_$$vertVal(.mt,$p(v,"^",jj)) } QUIT res_")"	// AK772
		QUIT:op="SET:LIST" arg1
		set arg2=$$vertVal(.mt, $PIECE(v,"^",5))
		set arg3=$$vertVal(.mt, $PIECE(v,"^",6))
		if op="DATEPART" { QUIT "DATEPART("_$tr(arg1,"(')")_","_arg2_")" }
		if op="DATENAME" { QUIT "DATEPART("_$tr(arg1,"(')")_","_arg2_")" }
		if op="DATEADD"  { d adcast(.arg3,$p(v,"^",6)) RETURN "DATEADD("_$tr(arg1,"(')")_","_arg2_","_arg3_")" }
		if op="DATEDIFF"  { QUIT "DATEDIFF("_$tr(arg1,"(')")_","_arg2_","_arg3_")" }
		if op="DATETRUNC"  { QUIT "DATETRUNC("_$tr(arg1,"(')")_","_arg2_")" }
		if op="SUBSTR" { QUIT "SUBSTR("_arg1_","_arg2_$select(arg3="":"",1:","_arg3) _")" }
		if op="CHARLEN" { QUIT "CHAR_LENGTH("_arg1_")" }
		if op="POSITION" { QUIT "POSITION("_arg2_" IN "_arg1_")" }
		if op="NULLIF" { QUIT "NULLIF("_arg1_","_arg2_")" }
		if op="IFNULL" { QUIT "IFNULL("_arg1_","_arg2_$select(arg3="":"",1:","_arg3) _")" }
		#;  parameter argument datatypes of SUBSTRING(%String,%Integer,%Integer)
		#;  Could be SUBSTRING or SUBSTRING:STREAM
		d:$e(op,1,9)="SUBSTRING" dtset^%qaqpdt($p(v,"^",4),"%Library.String"):$tr(arg1,"%EXACT ")="?",dtset^%qaqpdt($p(v,"^",5),"%Library.Integer"):$tr(arg2,"%EXACT ")="?",dtset^%qaqpdt($p(v,"^",6),"%Library.Integer"):$tr(arg3,"%EXACT ")="?"	// AK691
		set arg4=$$vertVal(.mt, $PIECE(v,"^",7))  //??
		set tmp=$$scalFunc^%qaqcmxc(v, $g(ftGen))  ;  *** problem with DECODE
		QUIT:tmp'="" tmp
		s op=$$toper(op)
		if arg2="" quit op_"("_arg1_")"
		quit "("_arg1_" "_op_" "_arg2_")"
	}
	if $$$mtVType(v)="e" {
		QUIT $$extrinsicFunction(v)
	}
	i $$$mtVType(v)="q" {  ;  AK1021
		n qn,unlocal,unsend s qn=$$$mtVQb(v),unlocal="",unsend=""
		d unlegs(qn)  ;  construct $LIST(m) of local/sent UNION legs
		i unlocal="" { d ktop1un(qn) RETURN "("_$$gensel(qn)_")" }
		#;  for UNION:  7+(A(f2) UNION B UNION C(f3) UNION D)
		#;  gives:  unlocal=$LIST(B,D), unsend=$LIST(A,C)
		#;  generate code:  SET d5=eval(B UNION D)
		#;  and reconstruct query:  7+COALESCE(:d5,(A(f2) UNION C(f3)))
		#;  RETURN:unsend="" $$adprm(vIdx)  ;  cannot happen
		d reunion(unlocal),reunion(unsend)  ;  redo mt("union"/"untop")
		RETURN "COALESCE("_$$adprm($$$mtPQbVal($$$mtP($li(unlocal))))_",("_$$gensel($li(unsend))_"))"
	}
	QUIT ""
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
aggregate(v) [ mt ] PUBLIC {
	set func=$$$mtVAggFunc(v)
	set val=$$vertVal(.mt, $$$mtVAggOperand(v),0)
	if val="",func="count" { set val="*" }
	if func="distinctlist" { RETURN "LIST(DISTINCT "_val_")" }
	if func="distinct%dlist" { RETURN "%DLIST(DISTINCT "_val_")" }
	if $e(func,1,4)="udaf" {
		set args=""
		if $$$mtVAggUDAFOrKeyVal(v)'="" {
			set argvals=$$$mtVAggUDAFOrKeyVal(v)
			for i=1:1:$l(argvals,",") { 
				Quit:$p(argvals,",",i)=""
				set args=args_","_$$vertVal^%qaqcmh(.mt,$p(argvals,",",i)) 
			}
		}
		RETURN $$quoter2($p(func,$c(2),2))_"."_$$quoter2($p(func,$c(2),3))_"("_val_args_")"
	}
	RETURN func_"("_$s($$$mtVAggDistinctList(v)'="":"DISTINCT ",1:"")_val_")"
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
unlegs(untop) [unsend, unlocal, mt] PUBLIC {  ;  list all UNION legs m of untop in 2 $LIST(m), 'unlocal' of
	#;  legs m that can be precomputed on the master, and 'unsend' for all the rest
	RETURN:'$g(corrm("localxpr"))
	RETURN:'$g($$$mtUnionTopQb(untop))
	s qn=""
	f  s qn=$o($$$mtUnionTopQb(qn)) q:qn=""  i $$$mtUnionTopQb(qn)=untop { i $$sendqb^%qaqpnl(qn,corrm) { s unsend=unsend_$lb(qn) d ktop1(qn) } else { s unlocal=unlocal_$lb(qn) } }
	RETURN
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ktop1un(qn)  ;  remove "TOP 1" from qn (PVA183)  ;  AK1021
	d ktop1(qn)  ;  (probably added by us) and all its UNION legs (AK751)
	i $d($$$mtUnion(qn)) { f i=1:1:$$$mtPNumQbs d:$g($$$mtUnionTopQb(i))=qn ktop1(i) }
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ktop1(qn)  ;  remove "TOP 1" from qn (probably added by us)  ;  AK1021
	KILL:($g($$$mtV(+$g($$$mtTopArg(qn))))="t^1" && $g($$$mtTopPreoptHint(qn))) $$$mtTopArg(qn) // only remove TOP added for optimization ('preoptHint' flag)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
reunion(unlist)  ;  restructure unlist=$LIST(m) of UNION legs m as
	#;  a single UNION ALL, by modifying mt("union"/"untop")
	RETURN:unlist=""
	n untop,li s untop=$li(unlist)
	i $ll(unlist)=1 { KILL $$$mtUnion(untop),$$$mtUnionTopQb(untop) RETURN }
	f li=1:1:$ll(unlist) KILL $$$mtUnion($li(unlist,li)) s $$$mtUnionTopQb($li(unlist,li))=untop,$li(unlist,li)=$li(unlist,li)_"a"
	s $$$mtUnion(untop)=$li(unlist,2,*)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nogenval(type,val)  ;  $$: 1/0 if val can be evaluated on the master and does not
	#;  need reconstruction - no fields, aggs, or corr. fields outside corrm
	#;  only from shard()/parag(), not Gateway or UNION %PARALLEL
	RETURN:('$g(corrm("localxpr"))) 0
	#;  if CAST, keep it and maybe compute its argument on the master
	RETURN:"^CAST^CONV"[$e(mt(type,val),2,6) 0
	n call,found s call="noagfcorr^%qaqcmh",found=0
	d lvtree^%qaqpnl(type,val)
	RETURN 'found
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
noagfcorr  ;  find any agg, field, correlated field outside of corrm, or
	#;  obsolete subq (=sent), called from nogenval->lvtree with type,val,v,ev
	RETURN:found  ;  already found
	i "af"[ev { s found=1 RETURN }  ;  found it - set 'found'
	i ev="n" { s:'$lf($g(corrm),$$$mtVCorrVal(v)) found=1 RETURN }
	i ev="x",v=("x^"_+$$$mtVParam(v)),v'="x^0" { s:'$lf($g(corrm),$$$mtVParam(v)) found=1 RETURN }  ;  AK850
	i ev="q",$$remove^%qaqpmod($$$mtPCorrelatedFields($$$mtP($p(v,"^",2))),$lts(corrm)) { s found=1 RETURN }
	i ev="q" { s:$$inext^%qaqpnl($$$mtVQb(v)) found=1 RETURN }
	GOTO lvarg^%qaqpnl  ;  recurse down
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adprm(val)  ;  [public: prm] $$: append val to prm and return "%EXACT ?"
	new globalDSN
	s prm=$g(prm)_$lb(val)
	RETURN:$tr($g($$$mtDSNLinkedTable($g(queryNum,$g(m,1))))," ")'="" "?"  ;  AK1087
	RETURN:($d($$$mtDSNConnection, globalDSN)=1 && (globalDSN'="")) "?" 	; Need to check for INS/UPD that just have one global DSN, do $d()=1 as this is the only case where the parent node is defined and no children are
	RETURN:$g(ftGen) "?"  ; MJG257
	RETURN:$$$mtVExprOperator($$$mtV(val))="TO_VECTOR" "?" ; MJG262 - might be computing streamless TO_VECTOR() on the master which shouldn't take %EXACT collation
	RETURN "%EXACT ?"  ;  AK1086
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
removeExact(exp) public {  ;  AK1086
	RETURN:$e(exp,1,7)="%EXACT " $e(exp,8,*)
	RETURN exp
}
 // only generating TOP clause, for the "TOP" style
 // RETURN the syntax that appears before the FROM clause
genTop(val) [mt,ftGen] public {  ;  AK1086
	// e.g. topParameter = (?) for fts, ? for non-fts
	set topParameter = $s($g(ftGen):"(",1:"")_$s($$$mtVType($$$mtV(val))="t":$e($$$mtV(val),3,*),1:$$removeExact($$vertVal(.mt,val)))_$s($g(ftGen):")",1:"")
	RETURN "TOP "_topParameter_" "
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 // generate the pagination clause of the SQL query for LIMIT or ANSI style, including OFFSET
 // RETURN the syntax that appears after a potential ORDER BY clause, could be end of query as well
 // qn - query block number
genPagination(qn) [mt,ftGen,res] PUBLIC { 
	if $g(qn)="" { // outermost query layer has pagination clause
	// check if this is set even for only rowoffset
		set topStyle=$g($$$mtRowlimitStyle)
		RETURN:topStyle="" "" // not populated, meaning that mt("rowlimit") and mt("rowoffset") are populated from %ROWLIMIT/%ROWOFFSET syntax, do not generate the query
		set topVal=$g($$$mtRowlimit), offsetVal=$g($$$mtRowOffset)
	} else { // for a specific query block
		set topVal=$g($$$mtTopArg(qn)), offsetVal=$g($$$mtOffset(qn))
		RETURN:'topVal "" // not populated, no pagination clause to generate
		set topStyle=$g($$$mtTopStyle(qn),"TOP")
	}
.
	RETURN:topStyle="TOP" "" // this is only for LIMIT or ANSI style. Generate nothing if it is TOP style.
.
	// e.g. topParameter and offsetParameter is (?) for foreign tables, ? for non-foreign tables
	set returnValue=""
	// generate potential OFFSET clause
	if $g(offsetVal) {
		set offsetParameter = $s($e($$$mtV(offsetVal))="t":$e($$$mtV(offsetVal),3,*),1:$$removeExact($$vertVal(.mt,offsetVal)))
		set returnValue = "OFFSET "_offsetParameter_" ROW "
	}
	if $g(topVal) { // if also LIMIT/FETCH clause, OFFSET appears in different place for each style
		set topParameter = $s($g(ftGen):"(",1:"")_$s($e($$$mtV(topVal))="t":$e($$$mtV(topVal),3,*),1:$$removeExact($$vertVal(.mt,topVal)))_$s($g(ftGen):")",1:"")_" "
		set returnValue = $case(topStyle, 
								"LIMIT": "LIMIT "_topParameter_returnValue,
								"ANSI": returnValue_"FETCH FIRST "_topParameter_"ROWS ONLY ") // syntax choice for FT compatibility
	}
	
	// Spacing: all string handling in this procedure leaves a trailing space so take it away, and add leading space if
	// the query text before this in 'res' does not contain a space at the end.
	RETURN $s($e(res,*)=" ": "", 1: " ")_$e(returnValue,1,*-1)
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
constantInMode(v, method) [ mt ] PUBLIC {
	Set val = $$$mtV(v)
	RETURN:$e(val)'="t" ""	//not a constant!
	Set const = $e(val, 3, *)
	Set result = "(('"_$$escQuotes(const)_"'))"
	Set class = $$$VTRgetdt(v)
	Set exists = ##class(%Dictionary.CompiledMethod).%ExistsId(class_"||"_method)
	RETURN:'exists result //no such method
	Set md = ##class(%Dictionary.CompiledMethod).%OpenId(class_"||"_method)
	RETURN:'md.ClassMethod result //not a class method
	Set result = $CLASSMETHOD(class, method, const)
	If $LISTVALID(result) {
		Set list = "$LISTBUILD("
		For i=1:1:$LL(result) {
			Set list = list _ "(('"_$$escQuotes($LI(result,i))_"')),"
		}
		Set list = $e(list,1,*-1) _ ")"
		Set result = list
	}
	Else {
		Set result = "(('"_$$escQuotes(result)_"'))"
	}
	RETURN result
}
constantInLogical(v) [ mt ] PUBLIC {
	Set mode = $g(mt("sqlcomp"))
	If mode="%EXTERNAL" QUIT $$constantInMode(v, "DisplayToLogical")
	If mode="" QUIT $$constantInMode(v, "") //No conversion
	QUIT $$constantInMode(v, "OdbcToLogical") 
}
escQuotes(str) public {
	Set out = ""
	For i=1:1:$l(str) {
		Set char = $e(str,i)
		Set out = out _ $s(char="'":"''",1:char)
	}
	QUIT out
}
    #;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    #; Some operators act as if their arguments always have their default collation
    #; even when that collation is not present in the parse tree. They should not
    #; have their arguments wrapped in %EXACT.
needsExact(op) {
	QUIT:op="%L2PAT" 0
	QUIT:op="%L2SW" 0
	#; OID operates on uncollated ID values, %EXACT by default
	QUIT:op="%OID" 0
	#; %EXACT doesn't need it re-applied, of course
	QUIT:op="%EXACT" 0
	QUIT 1
}
.
#; xmlUnflatten reconstructs the query text for XMLELEMENT or XMLFOREST function from scratch=$p(v,"^",6, *-1)
#; The implementation of this funciton is based on xmlFlatten^%qaqpslx, XMLELEMENT^%qaqpslx and XMLFOREST^%qaqpslx
xmlUnflatten(scratch, vIdx)[mt] private {
	// Scratch contains the flattened output of this XML function, therefore we can reconstruct the arguments of the the XML function from it
	If $g($$$mtVtrName(vIdx)) = "XMLFOREST" {
		Return $$xmlforest(scratch, vIdx)
	} Elseif $g($$$mtVtrName(vIdx)) = "XMLELEMENT" {
		Return $$xmlelement(scratch, vIdx)
	}
	Return "" // this case should not happen
}
.
#; xmlelement reconstructs query text of the XMLELEMENT function
xmlelement(scratch, vIdx)[mt] private {
	// reconstruct the label text from the last ^ entry of scratch
	// this is the first argument of the XMLELEMENT function
	Set label = """"_$zcvt($e($p($$$mtV($p(scratch, "^",*)),"^",2),3,*-1),"I", "XML")_""""
	Set attribute = ""
	Set sidx = 2 // sidx records the starting poistion of unprocessed $p(scratch, "^") entry
	
	// check if the function has XMLATTRIBUTES
	If $e($$$mtV($p(scratch, "^",1)),*)'=">" {
		// reconstruct the XMLATTRIBUTES funciton
		Set atttag = """"_$e($$$mtV($p(scratch, "^",2)),3,*-2)_""""
		Set attvar = $$vertVal(.mt, $p(scratch, "^",3))
		Set sidx = 6
		Set attribute = ", XMLATTRIBUTES("_attvar_" AS "_atttag_")"
	}
.
	// reconstruct the rest of the arguments of the XMLELEMENT function from the second to second to last entry of scratch
	Set args = ""
	While sidx < $l(scratch,"^") { //go though the "^" entries in scratch
		// check if $p(scratch,"^",sidx,*) contains a flattened XML variable
		Set nestedvIdx = $$nestedXMLvidx($p(scratch,"^",sidx,*), vIdx)
		If nestedvIdx {
			// has flattened XML variable, reconstruct the nested XML function recursively using xmlUnflatten
			Set nestedscratch = $p($$$mtV(nestedvIdx),"^",6, *-1)
			Set args = args_","_$$xmlUnflatten(nestedscratch,nestedvIdx)
			Set sidx = sidx+$l(nestedscratch, "^")
		} Else {
			// no flattened XML variable, constuct the argument using vertVal
			Set args = args_","_$$vertVal(.mt,$p(scratch,"^",sidx))
			Set sidx = sidx+1
		}	
	}
	Return "XMLELEMENT("_label_args_attribute_")"
}
.
#; xmlforest reconstructs the query text of XMLFOREST function
xmlforest(scratch, vIdx)[mt] private {
	Set sidx = 1 // sidx records the starting poistion of unprocessed $p(scratch, "^") entry
	Set rst = "XMLFOREST("
	Set intag = 0
.
	While sidx <= $l(scratch,"^") { //go though the "^" entries in scratch
		Set vid = $p(scratch,"^",sidx)
	
		If ($e($$$mtV(vid),1,3) = "t^<"), 'intag{
			// this is the beginning of an "... AS label" argument
			Set intag = 1
			Set label = """"_$zcvt($e($$$mtV(vid),4,*-1),"I", "XML")_"""" // reconstruct the label text
			Set sidx = sidx+1
		} Elseif ($e($$$mtV(vid),1,4) = "t^</"), intag{
			// this is the end of an "... AS label" argument
			Set intag = 0
			Set:sidx'=$l(scratch,"^") rst = rst_"," // add "," to rst if this is not the last argument
			Set sidx = sidx+1
		} Else {
			// reconstruct the ... part of this "... AS label" argument
			
			// check if $p(scratch,"^",sidx,*) contains a flattened XML variable
			Set nestedvIdx = $$nestedXMLvidx($p(scratch,"^",sidx,*), vIdx)
			If nestedvIdx {
				// has flattened XML variable, reconstruct the nested XML function recursively using xmlUnflatten
				Set nestedscratch = $p($$$mtV(nestedvIdx),"^",6, *-1)
				Set rst = rst_$$xmlUnflatten(nestedscratch,nestedvIdx)_" AS "_label
				Set sidx = sidx+$l(nestedscratch, "^")
			} Else {
				// no flattened XML variable, reconstruct the argument using vertVal
				Set rst = rst_$$vertVal(.mt,$p(scratch,"^",sidx))_" AS "_label
				Set sidx = sidx+1
			}
		}
	}
	Return rst_")"
}
.
#; nestedXMLvidx checks if scratch starts with a flattened XML variable. 
#; If so, nestedXMLvidx returns the vidx of the variable; otherwise it returns 0 
nestedXMLvidx(scratch, vIdx) [mt] private {
	For i = vIdx-1:-1:1 { // search backward on mt("v"), starting from vIdx-1
		If $e($$$mtV(i),1,10) = "i^XMLFUNC^" {
			If $e(scratch_"^",1,$l($p($$$mtV(i),"^",6,*))) = $p($$$mtV(i),"^",6,*) {
				Return i
			}
		}
	}
	Return 0
}
.
#;--- Windowing Functions /BEGIN
windowFunction(v) [ mt ] public {
	Set val = $$$mtV(v)
	Set op = $p($p(val,"^",2),":",2)
	Set frame = $p($p(val,"^",2),":",3)
	Set args = ""
	For i=8:1 {
		Set argv = $p(val,"^",i) QUIT:argv=""
		Set args = args_$$vertVal(.mt, argv)_","
	}
	Set $e(args,*) = "" //drop final ","
	If op="COUNT",args="" Set args="*"
	Set over = $$windowFunctionOver($p(val,"^",4),$p(val,"^",5), $S(frame="ROWS":$p(val,"^",6,7),1:""))
	RETURN op_"("_args_")"_$s(over'="":" ",1:"")_over
}
windowFunctionOver(partv, ordv, rowsvs) [ mt ] public {
	Set part = $$windowFunctionPartitionBy(partv)
	Set ord = $$windowFunctionOrderBy(ordv)
	Set rows = $s(rowsvs:$$windowFunctionRows($p(rowsvs,"^",1),$p(rowsvs,"^",2)),1:"")
	If (part'="")||(ord'="") RETURN "OVER("_part_$s(ord'="":" ",1:"")_ord_$s(rows="":"",1:" ")_rows_")"
	RETURN ""
}
.
windowFunctionPartitionBy(v) [ mt ] public {
	Set val = $$$mtV(v)
	Set part = ""
	For i=4:1 {
		Set argv = $p(val,"^",i) QUIT:argv=""
		Set part = part_$$vertVal(.mt, argv)_","
	}
	Set $e(part,*) = "" //drop final ","
	RETURN $s(part'="":"PARTITION BY ",1:"")_part
}
windowFunctionOrderBy(v) [ mt ] public {
	Set val = $$$mtV(v)
	Set ord = ""
	For i=4:2 {
		Set argv = $p(val,"^",i) QUIT:argv=""
		Set ordv = $p(val,"^",i+1)
		Set ordval = $$$mtV(ordv)
		Set desc = $p(ordval,"^",2)="d"
		Set ord = ord_$$vertVal(.mt, argv)_$s(desc:" DESC",1:"")_","
	}
	Set $e(ord,*) = "" //drop final ","
	RETURN $s(ord'="":"ORDER BY ",1:"")_ord	
}
windowFunctionRows(begin,end) [ mt ] public {
	Set f("a") = $p($$$mtV(begin),"^",2)
	Set f("b") = $p($$$mtV(end),"^",2)
	For x = "a", "b" {
		If f(x) = 0 {
			Set f(x) = "CURRENT ROW"
		}
		ElseIf f(x) > 0 {
			Set f(x) = f(x) _ " FOLLOWING"
		}
		Else {
			Set f(x) = -f(x) _ " PRECEDING"
		}
	}
	Set rows = "ROWS BETWEEN "_ f("a") _ " AND "_ f("b")
	RETURN rows
}
.
#;--- Windowing Functions /END
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
extrinsicFunction(v) [ mt ]
{
	Set name = $p(v,"^",5,*)
	Set call = "$$"_name_"("
	Set args = $p(v,"^",4)
	For i=1:1:$l(args,",")-1 {
		Set call = call _ $$vertVal(.mt, $p(args,",",i)) _","
	}
	//0 args
	If $e(call,*) = "(" {
		Set call = call _ ")"
	}
	//>0 args, overwrite final comma
	Else {
		Set call = $e(call,1,*-1) _ ")"
	}
	QUIT call
}
uncollate(v) ;
	n val s val = $p(v,"^",4)
	s v=$$$mtV(val)
	i $$$mtVType(v)="a" {
		s $p(v,"^",5) = $$uncoll($p(v,"^",5))
		QUIT $$$newval(v,1)
	}
	QUIT $$uncoll(val)
uncoll(val) ;
	New v Set v = $$$mtV(val)
	RETURN:$$$mtVType(v)="f" $p(mts($$$mtRQb($$$mtR($$$mtVFieldQbOrStream(v))),$$$mtVFieldQbOrStream(v),"ATT",+$$$mtVFieldLabelOrIFN(v)),"^",5)
	//Peer through any "n" indirection or "v" collation functions
	//YCL129 - Ensure v node is a collation function in $$uncoll^%qaqcmh
	i $$$mtVType(v)="v"&&('(($$$SQLCOLLATIONS[(","_$p($$$mtVExprOperator(v),"(",1)_","))||($$$ISENCODEDCOLLATE($p($$$mtVExprOperator(v),"(",1))))) RETURN val
	If "vn"[$$$mtVType(v) RETURN $$uncoll($p(v,"^",4))
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK722
coll(fun,arg)  ;  apply collation to argument
	QUIT:fun="%UPPER" "UPPER("_arg_")"
	QUIT:fun="%SPACE" arg
	QUIT:fun["%ALPHAUP(" arg //must be implicit, %ALPHAUP with arg not supported
	if $$$ISENCODEDCOLLATE(fun){
		new parm1,parm2
		do decodeCollate^%qaqcpre(fun,.parm1,.parm2)
		QUIT "%COLLATE"_"("_arg_",'"_parm1_"'"_$s(parm2="":")",1:","_parm2_")")
	}
	#; AK785
	#;  if fun=%SQLUPPER(10), generate %SQLUPPER(arg,10)
	i fun["(" {
		n carg
		s carg = $p($p(fun,"(",2),")")
		#; n# means collation parameter is in val n
		i $e(carg,*) = "#" {
			s carg = $$vertVal(.mt, +carg)
		}
		else {
			s carg = "(("_carg_"))"
		}
		QUIT $p(fun,"(")_"("_arg_","_carg_")"  ;
	}  
	#; AK785-
	QUIT fun_"("_arg_")"  ;  they better support it
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fn(op,arg) QUIT "{fn "_op_"("_arg_")}"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK722-
 
checkLike(val,op) ;
 n val1,val2,v1,v2,v
 if op '="AND" quit ""
 if $DATA($$$mtL($PIECE(val,"^",4)))=0 quit ""
 if $DATA($$$mtL($PIECE(val,"^",5)))=0 quit ""
 set val1=$$$mtL($PIECE(val,"^",4))
 set val2=$$$mtL($PIECE(val,"^",5))
 if $PIECE(val1,"^",2)'="%PATTERN" quit ""
 if $PIECE(val2,"^",2)'="%STARTSWITH" quit ""
 s v1=$g($$$mtV($PIECE(val1,"^",5)))
 if $p(v1,"^",2)'="%L2PAT" quit $$vertVal(.mt, $PIECE(val1,"^",4))_" LIKE "_$$getLPat($PIECE(v1,"^",2))
 s v2=$g($$$mtV($PIECE(val2,"^",5)))
 if $p(v2,"^",2)'="%L2SW" quit ""
 if $p(v2,"^",4)'=$p(v1,"^",4) quit ""
 if $p(v2,"^",4)="" quit ""
 if $DATA($$$mtV($p(v2,"^",4)))=0 quit ""
 quit $$vertVal(.mt, $PIECE(val1,"^",4))_" LIKE "_$$vertVal(.mt,$p(v2,"^",4))
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JMM1159 - Pass %NOINDEX hint to shard-local queries
#define AddNoIndex(%tmp) if noindex'=""&&'(%tmp["%NOINDEX") { if $e(%tmp,1,1)="(" { s %tmp="("_noindex_$e(%tmp,2,*) } else { s %tmp=noindex_%tmp }}
parseCond(mt, logNum,dummypc=0, pHasQuantifier=0)
	if $g(logNum)="" quit ""
	if $DATA($$$mtL(logNum))=0 quit ""
	new arg1,arg2,arg3,i,noindex,op,qn,temp,tl,tmp,val
	set val=$$$mtL(logNum)
	if $d($$$mtLNoIndex(logNum)) { // JMM1159+
		s noindex="%NOINDEX "
	}
	else {
		s noindex=""
	} // JMM1159-
	#; Restore original condition for %FIND/%INSET filters
	set val = $$invertFilter(logNum)
	#; Remove implicit collations on LIKE arguments
	set val = $$removePatternCollation(val)
	#; Don't regenerate %STARTSWITH conditions that were implied by a LIKE
	if $$isImpliedStartsWith(val) QUIT ""
	#; Don't regenerate implied NOT NULL conditions
	if $g(mt("nncond",logNum)) QUIT ""
	if $p(val,"^",2)="=*" QUIT ""
	#; YCL450 - Don't regenerate implied internal NCNUL conditions
	if $e(val,1,8)="v^NCNUL^" QUIT ""
	#;  evaluate streamless condition on the master,
	#;  it can have no correlated fields other than corrm, it could
	#;  have subqueries (that are already marked for master evaluation),
	#;  but no fields or aggregates (except within subqueries)
	i $p(val,"^",3)=",",$$nogenval("l",logNum) { RETURN "("_noindex_$$adprm($$$newval("l^L2V^,^"_logNum_"^"))_"<>((0)))" }  ;  AK1021
	i $e(val,1,10)="v^FOR SOME" {  ;  AK941;AK1021
		n qn,unlocal,unsend s qn=$p($$$mtV($p(val,"^",4)),"^",2),unlocal="",unsend=""
		d unlegs(qn)  ;  construct $LIST(m) of local/sent UNION legs
		#;  PVA183: kill unnecessary TOP probably added by Cache - in case remote server doesn't support it
		i unlocal="" { d ktop1un(qn) RETURN noindex_"EXISTS("_$$gensel(qn)_")" }
		#;  for UNION:  EXISTS(A(f2) UNION B UNION C(f3) UNION D)
		#;  gives:  unlocal=$LIST(B,D), unsend=$LIST(A,C)
		#;  generate code:  SET d5=eval(EXISTS(B UNION D))
		#;  and reconstruct query:  (:d5=1 OR EXISTS(A(f2) UNION C(f3)))
		#;  RETURN:unsend="" $$adprm(vIdx)  ;  cannot happen
		d reunion(unlocal),reunion(unsend)  ;  redo mt("union"/"untop")
		RETURN "("_noindex_$$adprm($$$mtPQbVal($$$mtP($li(unlocal))))_"=1 OR EXISTS("_$$gensel($li(unsend))_"))"
	}
	if $PIECE(val,"^",1)="v" {
		set op=$PIECE(val,"^",2)  ;  PVA183+
		i " %INBIT %INSUB %FIND"[(" "_op) s $bit(mt("localoref"),$p(val,"^",5))=1
		#; Don't regenerate dummy BAT legacy ID extraction conditions
		if op = "%BATPULL" QUIT ""
	#; AK907
		i op="ONEOF" {
			#; See undoSideEffects^%qaqpre3 for the ptv flag that identifies whether null is in the ONEOF set.
			n nullinset s nullinset = $p($p($g(mt("ptv",($p(val,"^",4)))),"^",$$$PTVRANGEINFO),",",2)
			s tmp=$$parseCond(.mt,$$undoONEOF^%qaqpre3(logNum,nullinset),,pHasQuantifier) // JMM1159+
			$$$AddNoIndex(tmp)
			QUIT tmp // JMM1159-
		}
		i op="INSET" { s arg2=$$$mtV($p(val,"^",5)),op=$p(arg2,"^",2)
			QUIT "("_noindex_$$vertVal(.mt,$s(op="SET:LIST":$p(val,"^",4),1:$$uncoll($p(val,"^",4))),0)_" %INLIST ("_$$vertVal(.mt,$p(arg2,"^",4))_"))"
		}
	#; AK907-
		#;HSU280+
		i $$toper(op)="%FIND" {
			#;Given query:"select * from iFind2 where %ID %FIND search_index(iFindIdx,'Boston')"
			#;$$$mtL(1)="v^=^,8,^8^9^"   ; v^=^,SQLUser.iFIND2.%%FakeComp38[irn=7],
			#;$$$mtV(8)="f^1^38"   ; SQLUser.iFIND2.%%FakeComp38[ifn=38][irn=7]
			#;$$$mtV(9)="t^1"
			#;$$$mtFilter(38)="%INBIT,6,25"
			#;mt("filterm",30)="%INBIT,6,25"
			#;$$$mtV(6)="v^USERDEFINEDFUNCTION:User.iFIND2:iFindIdxFind"_$c(1)_"^,^5^"
			#;$$$mtV(5)="t^Boston" or $$$mtV(5)="x^%CallArg(1)"
			#;$$vertVal(.mt, $p(vv,"^",4))
			#;mts(1,1)="100000^6534^^20^25^"
			#;w !,$$ifn^%qaqpnice(25)
			#;SQLUser.iFIND2.ID[ifn=25][irn=7]
			
			#;The mt() does not contain the info about how we get from "search_index(...)" to "iFindIdxFind" (or vise versa),
			#;So I have to create this translation on the fly.
			n v s v = $p(val,"^",4)
			n ifn s ifn = $p($$$mtV(v),"^",3)
			n str s str = $p($$$mtV(v),"^",2)
			#; This implementation expects to find the filter from the pre-invertFilter condition, so
			#; we'll rebuild the filter here.
			n findarg s findarg = op_","_$p(val,"^",5)_","_ifn
			i $p(findarg,",",2)'="",$g($$$mtV($p(findarg,",",2)))'="",$p($$$mtV($p(findarg,",",2)),"^",2)["USERDEFINEDFUNCTION:"{
				n index s index = $p($p($$$mtV($p(findarg,",",2)),"^",2),":",2)_"."_$p($p($$$mtV($p(findarg,",",2)),"^",2),":",3) // qualify index name with class name to avoid ambiguous name error
				i $e(index,$l(index)-$l("Find"_$c(1))+1,$l(index))=("Find"_$c(1)){
					s index = $e(index,1,$l(index)-$l("Find"_$c(1)))                                       //should iteratate this 4.
					n func s func = "search_index("_index_","
					n arg,operand f arg=4:1:($l($$$mtV($p(findarg,",",2)),"^")-1){ 
						s operand = $$vertVal(.mt, $p($$$mtV($p(findarg,",",2)),"^",arg)) 
						s func = func_operand_","
					}
					#; remove the tail comma
					s func = $e(func,1,$l(func)-1)
					s func = func _ ")"
					#; finally check refering to %ID
					// Make sure T[str] alias is always prepended to %ID, to avoid ambiguity between tables
					i $p(findarg,",",3)=$p(mts($$$mtRQb($$$mtR(str)),str),"^",5) RETURN noindex_"T"_str_".%ID %FIND "_func
				}
			} 
		}
		#;HSU280-
		//If op="%PATTERN", we deliberately stripped the collation.
		//Don't ask for %EXACT to be reapplied: Not desired
		#;HSU309+
		#;set arg1=$$vertVal(.mt, $PIECE(val,"^",4), op'="%PATTERN")
		set arg1=$$vertVal(.mt, $PIECE(val,"^",4), (op'="%PATTERN") && (op'="%MATCHES") ) 
		#;HSU309-
		set arg2=$$vertVal(.mt, $PIECE(val,"^",5))
		set arg3=$$vertVal(.mt, $PIECE(val,"^",6))
		if arg1?.e1"%ANYOF"1.nN1"(".e.1")" {	// turn '...%ANYOF#(val) arg2...' into 'FOR SOME %ELEMENT(val) (%VALUE op arg2...)'
			
			// process the collation function in arg1, if any
			// checking $g(corrm("localxpr")) as AK1021 is only for only from shard()/parag(), not Gateway or UNION %PARALLEL
			n valueStr s valueStr = $s($g(corrm("localxpr"))&&(arg1["_"):$p(arg1,"_")_"(%VALUE)",1:"%VALUE")
.
			if op="IN" {
				set tmp=$s(arg2="":"",1:arg2_",")_$s(arg3="":"",1:arg3_",")
				for i=7:1:$l(val,"^")-1 set tmp=tmp_$$vertVal(.mt,$p(val,"^",i))_","
				set arg2="("_$e(tmp,1,*-1)_")"
			}
			elseif op="%PATTERN" { 
				set tmp=$$%PATTERN(valueStr)
				set op=$p(tmp," ",2),arg2=$p(tmp," ",3,*)
			}
			set op=$$toper(op)
				#; if pHasQuantifier, this call is from a ANYOFAND log for a piece after the first FOR SOME %ELEMENT
			if pHasQuantifier { QUIT " "_noindex_valueStr_" "_op_" "_arg2_" " }
			QUIT " FOR SOME %ELEMENT("_$e($p(arg1,"(",2,*),1,*-1)_") ("_noindex_valueStr_" "_op_" "_arg2_")"
		}
		if arg1?.e1"%ANYOFKEY"1.nN1"(".e.1")" {	// turn '...%ANYOFKEY#(val) arg2...' into 'FOR SOME %ELEMENT(val) (%KEY op arg2...)'
			// process the collation function in arg1, if any
			// checking $g(corrm("localxpr")) as AK1021 is only for only from shard()/parag(), not Gateway or UNION %PARALLEL
			n keyStr s keyStr = $s($g(corrm("localxpr"))&&(arg1["_"):$p(arg1,"_")_"(%KEY)",1:"%KEY")
			if op="IN" {
				set tmp=$s(arg2="":"",1:arg2_",")_$s(arg3="":"",1:arg3_",")
				for i=7:1:$l(val,"^")-1 set tmp=tmp_$$vertVal(.mt,$p(val,"^",i))_","
				set arg2="("_$e(tmp,1,*-1)_")"
			}
			elseif op="%PATTERN" { 
				set tmp=$$%PATTERN(keyStr)
				set op=$p(tmp," ",2),arg2=$p(tmp," ",3,*)
			}
			set op=$$toper(op)
				#; if pHasQuantifier, this call is from a ANYOFAND log for a piece after the first FOR SOME %ELEMENT
			if pHasQuantifier { QUIT " "_noindex_keyStr_" "_op_" "_arg2_" " }
			QUIT " "_noindex_"FOR SOME %ELEMENT("_$e($p(arg1,"(",2,*),1,*-1)_") ("_keyStr_" "_op_" "_arg2_")"
		}
		d castcomp(.arg1,$p(val,"^",4),op)  ;  use CAST(?)  ;  AK1021
		d castcomp(.arg2,$p(val,"^",5),op)
			#;  (f<op>?) - get parameter datatype, if field also get irn and ifn, for ODBC  (AK691) (DPV4496 irn)
			#;  *** need to handle IN???  SETOF???
		if op'="[",op'="LIKE",$l(val,"^")=6 {
			n var,fld,tirn
			set:$tr(arg1,"%EXACT ")="?" var=$p(val,"^",4),fld=$p(val,"^",5)
			set:$tr(arg2,"%EXACT ")="?" var=$p(val,"^",5),fld=$p(val,"^",4)
			if $g(var) {
				do dtset^%qaqpdt(var,$$$VTRgetdt(fld))
				set tirn=$$$VTRgetirn(fld),fld=$$$VTRgetifn(fld)
				set:fld&&'$d($$$mtVirf(fld)) $$$VTRirn(var)=tirn,$$$VTRifn(var)=fld
			}
		}
		if op="LIKE" {
			QUIT " "_noindex_ arg1 _ " LIKE " _ arg2 _ $S($L(arg3):" ESCAPE " _ arg3,1:"") 
		}
		set tmp=$$scalFunc^%qaqcmxc(val,$g(ftGen))  ;  *** problem with DECODE
		if tmp'="" { // JMM1159+
			$$$AddNoIndex(tmp)
			QUIT tmp
		} // JMM1159-
		
		if op="%PATTERN" { // JMM1159+
			s tmp=$$%PATTERN(arg1)
			$$$AddNoIndex(tmp)
			QUIT tmp
		} // JMM1159-
		
		#; If we're not rebuilding for Cache, we convert a %STARTSWITH to a LIKE
		if (op="%STARTSWITH")&&('$g(asOriginal)) {
			set op="LIKE"
			if ('useCOAL) { set arg2="{fn CONCAT({fn RTRIM("_arg2_")},'%')}" }
			else          { set arg2="COALESCE({fn CONCAT({fn RTRIM("_arg2_")},'%')},'%')" }
		}
		
		; NOTEXISTS has reversed arguments from "not in"
		if op["NOTEXISTS" {
			s tmp=arg1,arg1=arg2,arg2=tmp
		}
		s op=$$toper(op)
		if op="IN" d  QUIT tmp  // AK724=
		. s tmp="("_noindex_arg1_" IN("_$s(arg2="":"",1:arg2_",")_$s(arg3="":"",1:arg3_",")
		. f i=7:1:$l(val,"^")-1 s tmp=tmp_$$vertVal(.mt,$p(val,"^",i))_","
		. s $e(tmp,$l(tmp))="))"
		if op="AND",arg2="" {
			$$$AddNoIndex(arg1)
			QUIT arg1
		}
		if op="AND",arg1="" {
			$$$AddNoIndex(arg2)
			QUIT arg2
		}
		if arg2="" quit noindex_op_" "_arg1
		quit "("_noindex_arg1_" "_op_" "_arg2_")"
	}               
	if $PIECE(val,"^",1)="l" {
		set op=$PIECE(val,"^",2)
		set op=$$toper(op)
		set temp=$$checkLike(val,op)
		if temp'="" {
			$$$AddNoIndex(temp)
			QUIT temp
		}
		set arg1=$$parseCond(.mt, $PIECE(val,"^",4),, pHasQuantifier)
		if ($E(arg1,1,11) = " FOR SOME %")&&(op="ANYOFAND") set pHasQuantifier = 1
		if op="%STARTSWITH" {
			if ('useCOAL){ s arg2="{fn CONCAT({fn RTRIM("_arg2_")},'%')}" }
			else { s arg2="COALESCE({fn CONCAT({fn RTRIM("_arg2_")},'%')},'%')" }
		}
		if op="ANYOFAND" {
			set arg2=""
			for i=5:1:$l(val,"^")-1 {
				set arg2=arg2_" AND"_$$parseCond(.mt, $PIECE(val,"^",i),, pHasQuantifier)
			}
			QUIT noindex_$e(arg1,1,*-1)_" "_arg2_")"
		}
		set arg2=$$parseCond(.mt, $PIECE(val,"^",5),, pHasQuantifier)
		if op="AND",arg2="" {
			$$$AddNoIndex(arg1)
			QUIT arg1
		}
		if op="AND",arg1="" {
			$$$AddNoIndex(arg2)
			QUIT arg2
		}
		if arg2="" QUIT noindex_op_" "_arg1
		$$$AddNoIndex(arg1)
		QUIT "("_arg1_" "_op_" "_arg2_")"
	}
	QUIT ""
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adcast(arg,val)  ;  if .arg (by ref) is a locally evaluated  ;  AK1021
	#;  expressions (probably a date/timestamp), then add
	#;  CAST(? AS ...) into this datatype to preserve proper semantics
	#;  If the argument's data type is DATE/TIME/POSIXTIME, then add
	#;  additional CAST(? AS INT) to preserve proper conversion
	RETURN:'val
	RETURN:$tr(arg,"%EXACT ")'="?" ;  expression that was replaced with '?' or '%EXACT ?'  ;  AK1087
	RETURN:$$$mtVType($$$mtV(val))="x"  ;  was originally a parameter
	#;  try to translate the datatype to its CAST equivalent
	s dt=$$$VTRgetdt(val)
	n op,arg1 s op="CONVERT:"_dt,arg1=$s("%Library.Date,%Library.Time,%Library.PosixTime,"[dt_",":"CAST(? AS INT)",1:arg)
	s arg1=$$scalFunc^%qaqcmxc("")
	s:$e(arg1,1,4)="CAST" arg=arg1
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
castcomp(arg,val,op)  ;  if .arg (by ref) is a locally evaluated expressions  ;  AK1021
	#;  that's a date/timestamp argument to a =/<>/range comparison,
	#;  then add CAST(? AS ...) to its datatype to preserve proper semantics
	RETURN:$p(op,".")'="METHOD:%Collation"
	RETURN:$a($tr($$toper(op),"<=>",$C(1,1,1)))'=1  ;  one of 66 different methods
	d adcast(.arg,val)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-"TIMESTAMP"=-=-=-=-=-=-=-=-=-=-=-=-
%PATTERN(arg1)
	RETURN:$e(arg2,1,6)="%L2PAT" "("_arg1_" LIKE "_$e(arg2,7,*)_")"  ;  AK943
	set tl=$$getLPat($p($g($$$mtV($PIECE(val,"^",5))),"^",2))
	QUIT:tl'="" "("_arg1_" LIKE "_tl_")"
	set tl="("_arg1_" "_op_" "_arg2_")"
	QUIT tl
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; If necessary, rewrites condition cond (mt("l") node) into 
	#; its original, pre-filter^%qaqpnl form (minus $p(,"^",3), which
	#; isn't needed).
invertFilter(log) [ mt, mts ] PUBLIC {
	Set cond = $$$mtL(log)
	//Undo conversion to %FIND function from fake = at the end of %qaqpag
	If $d(mt("filtereq",log),eqcond) {
		Set cond = eqcond
	}
	Set arg1 = $p(cond, "^", 4)
	QUIT:'arg1 cond
	Set val = $g($$$mtV(arg1))
	//Must be a field
	Set type = $p(val,"^",1)
	QUIT:type'="f" cond
	//Is it a fake field as recorded in mt("filter")?
	Set ifn = $p(val,"^",3)
	Set filter = $G($$$mtFilter(ifn))
	QUIT:filter="" cond
	//Restore original operator
	Set $p(cond,"^",2) = $p(filter,",",1)
	//Clear piece 3, unused
	Set $p(cond,"^",3) = ""
	//Restore original row ID value
	Set str = $p(val,"^",2)
	//Set irn = $$$mtRIrn($$$mtR(str))
	Set qn = $$$mtRQb($$$mtR(str))
	Set idifn = $p(mts(qn,str),"^",5)
	Set $p(cond,"^",4) = $p(mts(qn,str,"ATT",idifn),"^",5)
	//Restore original oref val
	Set $p(cond,"^",5) = $p(filter,",",2)
	s $bit(mt("localoref"),$p(filter,",",2))=1
	QUIT cond
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; A constant argument to LIKE may have been wrapped in
	#; an implicit collation function. We don't want to regenerate that
	#; collation wrapper, because the resulting query will not be
	#; parsed in the same way, notably the LIKE->%STARTSWITH optimization
	#; may be triggered when it was not in the original (because the
	#; constant pattern had no prefix).
	#; We also need an uncollated value on the left hand side, so it's
	#; regenerated without a collation.
removePatternCollation(cond) [ mt, mts ] PUBLIC {
	//Only applies to %PATTERN
	Set op = $p(cond, "^", 2)
	QUIT:op'="%PATTERN" cond
	//Only applies when RHS is a LIKE pattern
	Set l2patv = $p(cond, "^", 5)
	QUIT:'l2patv cond
	Set l2pat = $g($$$mtV(l2patv))
	QUIT:$p(l2pat, "^", 2)'="%L2PAT" cond
	//Only applies when arg of RHS is a value applying a function...
	Set collf = $g($$$mtV($p(l2pat, "^", 4)))
	QUIT:$p(collf, "^", 1)'="v" cond
	Set coll = $p(collf, "^", 2)
	QUIT:coll="" cond
	//...to the LIKE parameter
	Set lpatv = $p(collf, "^", 4)
	QUIT:'lpatv cond
	//And collation must match LHS
	Set lhsv = $p(cond, "^", 4)
	QUIT:'lhsv cond
	Set lhs = $g($$$mtV(lhsv))
	QUIT:$p(lhs, "^", 3)'[("_"_coll) cond
	
	//OK, let's rewrite the condition to point directly at the constant
	//Need to un-collate LHS and create a new %L2PAT var for the RHS that does this
	Set $p(cond, "^", 4,5) = $$uncoll(lhsv)_"^"_$$$newval($p(l2pat,"^",1,3)_"^"_lpatv_"^"_$p(l2pat,"^",5)_"^")
	QUIT cond
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; If cond value is a %STARTSWITH implied by a LIKE or %MATCH and not present in the
	#; original query, return 1, otherwise 0
isImpliedStartsWith(cond) [ mt ] PUBLIC {
	Set op = $p(cond,"^",2)
	If op'="%STARTSWITH" QUIT 0
	Set arg2 = $g($$$mtV($p(cond,"^",5)))
	QUIT $$isL2SW(arg2)||$$isMatches2SW(arg2)
}
	#; Is this val or its child (as a collation) using operator op?
isOp(val, op) [ mt ] PUBLIC {
	If $e(val) '= "v" QUIT 0
	If $p(val,"^",2) = op QUIT 1
	QUIT $$isOp($g($$$mtV($p(val,"^",4))), op)
}
	#; Is this val or its child (as a collation) an %L2SW?
isL2SW(val) [ mt ] PUBLIC {
	QUIT $$isOp(val, "%L2SW")
}
	#; Is this val or its child (as a collation) an %L2SW?
isMatches2SW(val) [ mt ] PUBLIC {
	QUIT $$isOp(val, "%MATCHES2SW")
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; Regenerate a WHERE clause from the parse tree for query number <queryNum>
	#; If <asOriginal>=1, don't perform transformations to eliminate our SQL extensions.
parseWhere(queryNum)
	#; empty queries must return no rows
	QUIT:$g($$$mtEmpty(queryNum)) " WHERE (((1))=((0)))"
	QUIT:$g($$$mtWhere(queryNum))="" ""
	// INSERT and UPDATE have not "fixed up" the mt("w") list to be ^ post-pended
	If $e($$$mtWhere(queryNum),*) '= "^" s $$$mtWhere(queryNum) = $$$mtWhere(queryNum) _ "^"
	n str,ii,log,v s str=""
		#; PVA157: filter out DISTINCT pseudo-condition; it is always directly in mt("w"). 
	for ii=1:1:$l($$$mtWhere(queryNum),"^")-1 {
		s log=$p($$$mtWhere(queryNum),"^",ii),v=$$$mtL(log)
		continue:$p(v,"^",2)="DISTINCT"
		continue:$$IsInANYOFAND(log)	// if this log is also in an ANYOFAND log, it will be handled when ANYOFLOG is processed
	#; AK915
		#;  skip LIKE-implied %STARTSWITH(%L2SW())
		CONTINUE:($e(v,1,14)="v^%STARTSWITH^")&&($e($$$mtV($p(v,"^",5)),1,8)="v^%L2SW^")
	#; AK915-
	#; AK907
		CONTINUE:($e(v,1,6)="v^TOP:")  ;  skip added TOP conditions
		n cond s cond = $$parseCond(.mt,log)
		s:cond'="" str=str_"AND("_cond_")"
	}
	QUIT:str="" ""
	QUIT " where "_$e(str,4,*)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
IsInANYOFAND(log)
	new data,l,ret
	set ret=0,l=""
	for  {
		set l=$o($$$mtL(l),1,data) quit:l=""
		if $e(data,1,11)="l^ANYOFAND^",$p(data,"^",3,*)[("^"_log_"^") { set ret=1 quit }
	}
	QUIT ret
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK754
gengroup(queryNum)
 if $DATA($$$mtGroupDistinctList(queryNum))=0 quit ""
 //Don't regenerate synthetic groups
 if $d(mt("gsynth",queryNum)) quit ""
 new lst,ii,idx,res,first
 s first=1
	s lst=$$$mtGroupDistinctList(queryNum),ii=1,res=" GROUP BY "  ;  AK754
        set idx=$PIECE(lst,",",ii)
 while (idx'="") {
                 if first s first=0
                 e  set res=res_" , "
         if idx'="" set res=res_$$vertVal(.mt, idx), ii=ii+1
         set idx=$PIECE(lst,",",ii)
 }
	QUIT:res=" GROUP BY 1" ""
 quit res
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
gensel(queryNum,noun="",internalIris=0)  ;  generate SQL text for query block queryNum,
	#;  noun=1 means do NOT follow with UNION.
	#;  query reconstruction is used in:
	#;  buildsubq() for Gateway
	#;  parag^%qaqpagg(), quq^%qaqcpre() for parallel
	#;  shard^%qaqpagg(), qush^%qaqcpre() for sharding
	#;  shardup^%qaqcmn() for sharded UPDATE/DELETE
	#;  shinsel^%qaqcmn() for sharded INSERT-SELECT
	#;  in addition to recursive calls for UNION, EXISTS, FROM, and scalar subqueries
	RETURN:$g($$$mtEmpty(queryNum)) $$empty(queryNum,noun)  ;  AK1038
	n res,colsIdxLst,ii,un,top,topStyle
	s res="select "_$$genRTPCHint(queryNum,0)
	s colsIdxLst=$g($$$mtOutput(queryNum))
	#; AK745
	i $g($$$mtDistinct(queryNum),"none")="" s res=res_"DISTINCT "
	#; AK785
	set top=$g($$$mtTopArg(queryNum)), topStyle = $g($$$mtTopStyle(queryNum)) 
	if top, topStyle = "TOP" {
		do adgen($$genTop(top))
	}
	#; PVA183
         #; PVA183: put in TOP ALL where Cache requires. No current support for this
         #;         capability against any other dbms.
	#; MJG291 - FT pushdown logic handles excluding ORDER BY for regen, never put TOP ALL so other DBMS don't complain
	#; AK751
	s:'$d($$$mtTopArg(queryNum))&&$d($$$mtSequencersQb(queryNum))&&(queryNum'=1 || $d($$$mtUnionTopQb(queryNum)) || ($d($$$mtSequencers)#10))&&'$g(ftGen) res=res_"TOP ALL "
	#; PVA183-
         set colsIdxLst=$PIECE(colsIdxLst,"^",2)
	#; AK754
	#;  use alias if outer query, FROM subquery, UNION leg, or has ORDER BY
	s un=$$$mtPViewIDVal($$$mtP(queryNum))||$g($$$mtUnionTopQb(queryNum))||$g($$$mtSequencersQb(queryNum))||($$getDSN(queryNum)'=$$getDSN(+$$$mtP(queryNum)))
	f ii=1:1:$l(colsIdxLst,",")-1 s res=res_$s(ii=1:"",1:",")_$$vertVal(.mt,$p(colsIdxLst,",",ii))_$s(un:" AS C"_ii,1:"")  ;  AK804
	#; AK754-
	s:colsIdxLst="" res=res_" 1"  ;  special case; select *
	#; AK754
	#; AK849
	d quqint(queryNum)  ;  maybe also select unconverted sort fields
	s:$g(mt("viewid",queryNum)) res=res_","_$$vertVal(.mt,mt("viewid",queryNum))_" VID"  ;  AK971
	s res=res_$$genfrom(queryNum,internalIris)_$$parseWhere(queryNum)_$$gengroup(queryNum)
	#; AK849-
	s:$g($$$mtHaving(queryNum)) res=res_" HAVING "_$$parseCond(.mt,$$$mtHaving(queryNum))
	#; AK729
	i 'noun {
	set un=$g($$$mtUnion(queryNum))
	for ii=1:1:$ll(un) s res=res_$s($li(un,ii)["d":" UNION ",1:" UNION ALL ")_$s($$isUnionParallel(queryNum):"%PARALLEL ",1:"")_$$gensel(+$li(un,ii))
	#; AK729
	}
	#;  ORDER BY - $$$mtSequencers=LIST(val,), or for UNION mt("uns")=LIST(pos,)
	d genord($g($$$mtSequencersQb(queryNum)),0) // PVA183: ORDER BY in subquery
	d:queryNum=1 genord($g($$$mtSequencers),0),genord($g($$$mtUnionOrderBy),1):'noun
	// support LIMIT or ANSI style pagination, if present
	// topStyle cannot be empty (no $$$mtTopArg(queryNum)) or "TOP"
	do:topStyle'["TOP" adgen($$genPagination(queryNum))
	#; AK729-
	QUIT res
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
empty(queryNum,noun)  ;  for mt("empty") we can simplify:  ;  AK1038
	#;  for "onerow" with no aggregates:
	#;  SELECT [ TOP ? ] <select-list> [ HAVING <cond> ]
	#;  SELECT NULL, ..., NULL WHERE ((1))=((0))  ;  for all other "empty"
	#;  plus some additional special situations
	new colsIdxLst,ii,res,row,top,topStyle,un
	set row=$g($$$mtOneRow(queryNum))&&($p($g($$$mtP(queryNum)),"^",3)="")
	set res="SELECT ", colsIdxLst=$$$mtOutputVals($$$mtOutput(queryNum))
	set top = $g($$$mtTopArg(queryNum)), topStyle = $g($$$mtTopStyle(queryNum))
	if row,top,topStyle="TOP" { // generate TOP clause
		do adgen($$genTop(top)) 
	}
	#;  use alias if outer query, FROM subquery, UNION leg, or has ORDER BY
	s un=$$$mtPViewIDVal($$$mtP(queryNum))||$g($$$mtUnionTopQb(queryNum))||($$getDSN(queryNum)'=$$getDSN(+$$$mtP(queryNum)))
	f ii=1:1:$l(colsIdxLst,",")-1 s res=res_$e(",",ii>1)_$s(row:$$vertVal(.mt,$p(colsIdxLst,",",ii)),1:"NULL")_$s(un:" AS C"_ii,1:"")  ;  AK804
	d quqint(queryNum)  ;  maybe also select unconverted sort fields  ;  AK849
	s:$g(mt("viewid",queryNum)) res=res_","_$$vertVal(.mt,mt("viewid",queryNum))_" VID"  ;  AK971
	i 'row { s res=res_" WHERE ((1))=((0))" }
	else { s:$g($$$mtHaving(queryNum)) res=res_" HAVING "_$$parseCond(.mt,$$$mtHaving(queryNum)) }
	i 'noun {
		s un=$g($$$mtUnion(queryNum))
		f ii=1:1:$ll(un) s res=res_$s($li(un,ii)["d":" UNION ",1:" UNION ALL ")_$s($$isUnionParallel(queryNum):"%PARALLEL ",1:"")_$$gensel(+$li(un,ii))
		d:queryNum=1 genord($g($$$mtUnionOrderBy),1)
	}
	if row,top,topStyle'="TOP" { // generate pagination clause not in TOP style
		do adgen($$genPagination(queryNum)) 
	}	
	RETURN res
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; Generates only the prefix of the "SELECT". Now always adds %NOLOCK as parallel/shard queries do not work with read committed so no need to generate this code
genSELECT(queryNum) [ mt ] PUBLIC {
	RETURN "SELECT %NOLOCK"_$$genRTPCHint(queryNum,1)
}
isUnionParallel(qn) [ mt ] PUBLIC {
	Set top = $g($$$mtUnionTopQb(qn))
	RETURN:'top 0
	RETURN $g($$$mtUnionTopDSN(top)) = $lb(" "," ")
}
	#; AK849
quqint(qn)  ;  if queued query at a top-level UNION with ORDER BY, and if in
	#;  non-LOGICAL mode, then append %INTERNAL(ORDER-BY) to SELECT-list
	i mt("sqlcomp")'="",$g($$$mtDSNLinkedTable(qn))=" ",$g($$$mtUnionTopQb(qn))=1,'$$isExternal^%qaqpqo(qn) f ii=1:1:$l($g($$$mtUnionOrderBy),",")-1 d adgen(",%INTERNAL("_$$vertVal(.mt,$p(colsIdxLst,",",$p($$$mtUnionOrderBy,",",ii)))_")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getDSN(qn)  ; Returns the DSN for a query number
	//If there's one listed directly for this qn, great.
	if $g($$$mtDSNLinkedTable(qn)) '="" QUIT $$$mtDSNLinkedTable(qn)
	//If there's no mt("r") structure, then use the "global" DSN: Pure external UPDATE/INSERT
	if '$d($$$mtRNumStreams) QUIT $g($$$mtDSNConnection)
	//Otherwise, no DSN
	QUIT ""
	
adgen(x) set res=res_x QUIT  ;  append x to the reconstructed query text in res
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK849-
genorder(qn,colsIdxLst)  ; Generate the ORDER BY clause directly from a query # and the output columns
	n res, noun, queryNum
	s queryNum = qn
	s res = ""
	s noun = $ll($g($$$mtUnionTopDSN(qn)))>1
	d genord($g($$$mtSequencersQb(qn)),0,1)
	i qn = 1 {
		d genord($g($$$mtSequencers),0,1)
		d:'noun genord($g($$$mtUnionOrderBy),1,1)
	}
	q res
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK729
genordvals(qn,vals,colsIdxLst)  ; Generate the ORDER BY clause directly from a query #, list of order by values, and the output columns
	n res, noun, queryNum
	s queryNum = qn
	s res = ""
	d genord(vals,0,1)
	q res
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
genord(s,pos,ordonly=0)  ;  add to res sort list s=LIST(x,), pos=1 if x=ordinal position
	f ii=1:1:$l(s,",")-1 s res=res_$s(ii=1:" ORDER BY ",1:",")_$$genordd($p(s,",",ii),pos,ordonly)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
genordd(x,pos,ordonly=0)  ;  $$: generated ORDER BY item with [d] => DESC
	QUIT $$genordit(+x,pos,ordonly)_$s(x["d":" DESC",1:"")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
genordit(x,pos,ordonly=0)  ;  $$: ORDER item, pos=0/1 if x=val#/SELECT ordinal position
	QUIT:pos $s(ordonly:"",1:"C")_x
	#;  if found in SELECT list, use Ci alias, o/w evaluate expression
	#; AK765
	s pos=$l($p(","_colsIdxLst,","_x_","),",")
	if ordonly {
		QUIT:pos>=$l(colsIdxLst,",") $$vertVal(.mt,x)
		QUIT pos
	}
	QUIT:pos>$ll($$$mtAlphaUpAliases(queryNum)) $$vertVal(.mt,x)
	QUIT "C"_pos
	#; AK765-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK729-
	#; AK714
genfrom(qn,internalIris=0)  ;  generate the FROM clause
	n lgi,log,ptlg,str,lv,res,cross,cycle s res ="",cross=$s($g($$$mtLeftOuterJoins(qn)):" CROSS JOIN ",1:", ")
	if $d($$$mtOnRoot(qn)) {
		set res = res _ ", " _ $$genNewJoin^%qaqcmxc(.mt,qn)
	}
	elseif '$d($$$mtRNumStreams) && $d($$$mtFromRoot) {
		//An mt("f") FROM structure without an mt("r") means we're parsing an external query
 		QUIT $$parseExtFrom^%qaqcmx(.mt, qn)
	}
	else {
		n loj  ;  Lateral order join and LEFT OUTER JOIN - partial order
		#;  loj(rt,lt) means FROM-item stream rt must be listed after lt
		#;  loj(rt)=LIST(cond,) - ON conditions for LEFT OUTER JOIN,
		#;  loj(rt)="" for lateral dependencies
		s str=""  ;  LATERAL dependencies
		f  { s str=$o(mts(qn,str)) q:str=""
			s lv=$g(mts(qn,str,"lateral"))
			f lgi=1:1:$ll(lv) s loj(str)="",loj(str,$li(lv,lgi))=""
		}
		f lgi=1:1:$l($g($$$mtLeftOuterJoins(qn)),",")-1 {  ;  OUTER JOIN
			s log=$p($$$mtLeftOuterJoins(qn),",",lgi),ptlg=$$$mtL(log),str=$p($$$mtV($p(ptlg,"^",5)),"^",2),lv=$$$mtV($p(ptlg,"^",4))
			s loj(str)=$g(loj(str))_log_","  ;  list of conditions
			s:$e(lv)="f" loj(str,$p(lv,"^",2))=""  ;  not if constant
		}
		#;  generate all the regular joins of the left sides
		f str=1:1:$o($$$mtR(""),-1)  s:qn=+$$$mtRQb($$$mtR(str))&&'$d(loj(str)) res=res_cross_$$fromit(qn,str,internalIris)
		s str=""  ;  now generate the left-outer-joins
		f cycle=1:1:1000 {
			q:'$d(loj)
			s str=$o(loj(str))
			i str'="",$d(loj(str))=1 {
				s res=res_$s(loj(str)="":cross_$$fromit(qn,str),1:" LEFT OUTER JOIN "_$$fromit(qn,str)_" ON "_$$genOn(loj(str),.mt))
				KILL loj(str)
			}
		}
		QUIT:cycle>999 "[ERROR:  Irresolvable cycle in LEFT OUTER JOIN]"
	}
	QUIT:($e(res,1,17)=", %TSQL_sys.snf T")&&($e(res,19,*)'[" ") ""  ;  SELECT with no FROM clause
	QUIT:res="" " "
	#; PVA303: use genhints
	QUIT " FROM "_$$genhints(qn,internalIris)_" "_$e(res,$l(cross)+1,*)  ;  remove the first " CROSS JOIN " or comma
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA303: create genhints
genhints(qn,internalIris=0)
	RETURN:$g(ftGen) ""
	n hint,hintv,hintstr,i
	if $d(mt("hintsave",qn)) { k mt("hint",qn) merge mt("hint",qn)=mt("hintsave",qn) }
	s (hint,hintstr)="" for 
	{  s hint=$o(mt("hint",qn,hint),1,hintv) q:hint="" 
	   if hint="%FIRSTTABLE"||(hint="%STARTTABLE") { s hintstr=hintstr_" %FIRSTTABLE "_"T"_$li(mts("streamorder",qn))}
	   elseif hint="%INORDER",'internalIris {continue}
	   elseif ",%IGNOREINDICES,%IGNOREINDEX,"'[(","_hint_",") { s hintstr=hintstr_" "_hint } 
	   else 
	   {  s hintstr=hintstr_" "_hint
	      for i=1:1:$ll(hintv) { s hintstr=hintstr_$s(i>1:","_$li(hintv,i),1:" "_$li(hintv))}}
	}
	#;HSU291+
	if $g($$$mtParallelByAuto(qn)),hintstr["%PARALLEL"  s hintstr = $replace(hintstr,"%PARALLEL"," ")
	if $g(mt("%PARALLELGROUPBY",qn)),hintstr["%PARALLEL" s hintstr = $replace(hintstr,"%PARALLEL","%NOPARALLEL")
	#;HSU291-
	QUIT hintstr
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; Returns 1 if this subquery or any of its parent subqueries
	#; will be queued for parallel processing. 0 otherwise.
hasParagAncestry(qn) [ mt] PUBLIC {
	if $g($$$mtParag(qn)) '= "" QUIT 1
	set parentqn = +$g($$$mtP(qn))
	if parentqn,$$hasParagAncestry(parentqn) QUIT 1
	QUIT 0
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	//FROM clause item reconstruction from parse tree 1 for
	//INSERTS/UPDATES/DELETES that haven't gone through preprocessing
	//and optimization
fromit1(qn, label) [ mt, dnQ ] public {
	Set table = $$$mtFromTableName(qn_"^"_label)
	If $e(table,1,3) = "%%Q" {
		Set table = "(" _ $$gensel($e(table,4,*)) _ ")"
	}
	ElseIf $d($$$mtDSNConnection) {
	 	Set table = $$ExternalTableName^%apiSQL(table,$g(dnQ))
	}
	QUIT table _ " "_$$quoter2^%apiSQL(label)
 }
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fromit(qn,str,internalIris=0)  ;  $$:  return generated text for str, and
	new rt
	set rt=""  ;  remove it from left-side of loj()
	for  { set rt=$o(loj(rt)) quit:rt=""  kill loj(rt,str) }
	set rt=$g($$$mtRVirtual(str))
	set prm("streams")=$g(prm("streams"))_$lb(str)
	QUIT:rt "("_$$gensel(rt,,internalIris)_") T"_str	// subquery
	new irn
	set irn=$$$mtRIrn($$$mtR(str))
	set rt=$$$smd(1,irn)
	#; AK938
	d shtab(qn,str,irn)  ;  collect table info for Shard Manager
	if $g(ftGen) { // is a foreign table
		RETURN $$foreignTableName(str)
	}
	if $tr($g($$$mtDSNLinkedTable(qn))," ")="" {	// Not an external table, but union parallel
		if $$$smdIsATVF(1,irn) {
				// here we need to get the arguments to the TVF query.
				// get the parameter list directly from the mt("tvf","str"str) entry 
			set tParams=$g($$$mtTvfParams(str)),tParameters=""
			if tParams'=$c(0) {
				for i=1:1:$ll(tParams) {
					if $lg(tParams,i) { set tParameters=tParameters_","_$$vertVal(.mt,($lg(tParams,i))) }
					else { set tParameters=tParameters_"," }	// missing/null parameter
				}
			}
			set:tParameters'="" tParameters=$e(tParameters,2,*)	// strip leading ","
			QUIT $$quoter2($li(rt,1))_"."_$$quoter2($li(rt,2))_"("_tParameters_") T"_str	// AK849
		}
		RETURN:$li(rt,1,2)=$lb("%TSQL_sys","snf") "(SELECT 1 ID) T"_str  ;  AK969
		if $$$smdSharded(1,irn)&&($d($$$mtShard(qn))||$d(mt("coshsubq",qn))&&('$lf($g(mt("eval")),$$$mtPQbVal($$$mtP(qn))))) QUIT $$getShardLocalTableName^%SYS.SHARDSRV($li(rt,1)_"."_$li(rt,2),1,1,.mt,1)_" T"_str // AK849 JMM837 JMM858 JMM861 JMM912 JMM996 JMM1134 JMM1223
		QUIT $$quoter2($li(rt,1))_"."_$$quoter2($li(rt,2))_" T"_str	// AK849
	}
	QUIT $$ExternalTableName^%apiSQL($li(rt,1)_"."_$li(rt,2),$g(dnQ))_" T"_str
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK714-
	#; AK938
shtab(m,str,irn)  ;  [public: mt] set mt("sql",shtop,"shnot")=$LB(sch.tab) for
	#;  non-sharded table, and mt("sql",shtop,"shtab")=$LB(str) if sharded
	RETURN:'$g(mt("shtop",m))  ;  not a sharding situation
	i $$$smdSharded(1,irn) { s:mt("shtop",m)=m mt("sql",m,"shtab")=$g(mt("sql",m,"shtab"))_$lb(str) RETURN }
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK938-
shnot(shtop,schtab)  ;  [public: mt] set mt("sql",shtop,"shnot")=$LB(sch.tab)
	#;  for non-sharded tables, except that system tables already mapped
	i $e(schtab)'="%",$p(schtab,".")'="INFORMATION_SCHEMA",'$lf($g(mt("sql",shtop,"shnot")),schtab) {
		s mt("sql",shtop,"shnot")=$g(mt("sql",shtop,"shnot"))_$lb(schtab) }
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
genOn(conds,mt)  ;  $$:  return generated conditions with AND
	n res,jj,vv s res =""
	f jj=1:1:$l(conds,",")-1 s vv=$$$mtL($p(conds,",",jj)),res=res_" AND "_$$vertVal(.mt, $p(vv,"^",4))_" = "_$$vertVal(.mt, $p(vv,"^",5))
	QUIT $e(res,6,*)  ;  remove the first " AND "
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
qd2(val)
	QUIT:val["." val
	QUIT $$quoterU(val)
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; Generate entire query text to send to external FT server. All the information
	#; needed about the foreign table can be gathered via the stream number and the parse tree.
	#; The query generated is a simple query consisting of the form
	#; 
	#; 		SELECT [columns] FROM [table] T[stream] WHERE [conditions]
	#; 
	#; where the [columns] are all the columns needed for the query, using external column
	#; names for the columns and replacing any columns not needed with NULLs to prevent unnecessary
	#; fetching of column data. Note that this column list does not only include the columns present in 
	#; mt("o") because we may need to get other columns back into IRIS for local processing (non-pushable WHEREs, ORDER BY etc).
	#; T[stream] in this case is an alias based on stream number, e.g. T1
	#; 
	#; If the foreign table was created with a default query (i.e. mt("ft", 1, str, "query") is populated) then for now we just return
	#; that query. In the future, we may generate the query as
	#; 
	#; 		(query text from default query) T[str] WHERE [conditions]
	#; 
	#; i.e. turning the default query into a subquery view and appending on the conditions.
	#; 
	#; ***Note that we need to make sure the order is maintained correctly. The fields go into the ROWSPEC in a certain order,
	#; and our generated code will expect them to come back *in that order*. This means if we're select columns 1 and 3 we need 
	#; to generate the select list as:
	#; 
	#; 		SELECT col1, NULL, col3 ...
	#; 
	#; PARAMETERS: 
	#; 		- stream 
	#; 				Stream number of the FT we are generating the query for
	#; 		- ftParams (passed by reference)
	#; 				If logical conditions to push down, contains the parameters in the conditions that have been parameterized with ? and
	#; 				need to be replaced at runtime. Will be a string that is a comma-delimited list of $lb's
	#; 				where first element = datatype of the parameter and second element = runtime variable name of that param in the cached query
	#; 		- showPlan 
	#; 				1/0 if this is being called for Show Plan purposes
	#; PUBLIC VARS: 
	#; 		- mt (parse tree)
	#; 		- prm (list of parameters replaced by ? in condition text). This is populated through calls to parseCond and then we'll
	#; 		  make use of it
	#; 		- pti (runtime CQ variable names)
	#; RETURNS: 
	#; 		full query text. 
	#; 		NB: If this result is to be added to code gen, you should call $$quoter on the returned text
	#; 		to wrap it in quotes and double any quotes inside!
	#; 
	#; NOTES:
	#; 		If extending this procedure, whenever you modify the query text you should put in a leading space with
	#; 		whatever text you're adding to the query to help prevent bugs where a previous modification forgot to leave a space at the end
	#; 		of the string
generateFTQuery(stream, &ftParams, showPlan=0) [ mt, prm, pti ]  PUBLIC {
	set irn = $$$mtRIrn($$$mtR( stream))
	if $d($$$mtFtQuery(stream)) {
		set table = "("_$$$mtFtQuery(stream)_") T"_stream
	} else {
		set table = $$quoteFTIdentifier($$$smdFTTableName(1, irn), stream)_" T"_stream
	}
	// we have to generate the select-list. Not just mt("o"), so it's probably easiest to just loop
	// over mt("v") and grab any field that belongs to the FT stream
	// cols starts as $lb() so that if there are NO columns (like a COUNT(*)), then the logic that builds the select-list will just generate SELECT NULL
	set val = "", query = "SELECT", cols = $lb()
	for {
		set val = $order($$$mtV(val), 1, mtv)
		quit:val=""
		// keep looping if not a field or a field that doesn't belong to FT
		continue:($e(mtv)'="f"||($p(mtv, "^", 2)'=stream))
		set ifn = $p(mtv, "^", 3)
		set externalColName = $$$smdColFTExternalColName(1, irn, ifn)
		continue:externalColName="" // this should only happen with internal FTID
		set $li(cols, $$$smdColNumber(1, irn, ifn) - 1) = $$quoteFTIdentifier(externalColName, stream)
	}
.
	// We have the select list in a $lb and any field not needed will be omitted from that list, we replace the omitted elements with NULLs
	// Note the external field name will already be quoted as needed based on the DELIMITEDIDS value of the server
	set ptr = 0
	while $listnext(cols, ptr, val) {
		set query = query_" "_$s($g(val)="":"NULL", 1:val)_","
	}
	set $e(query,*)="" // get rid of trailing comma in select-list
.
	set query = query_" FROM "_table
.
	if $d($$$mtTvfFtConds(stream),condString) { // this FT has logical conditions that need to be regenerated (predicate pushdown)
		set numConds = $l(condString,"^")-1, prm = "", ftAlias = "T"_stream
		for cond=1:1:numConds {
			set clause = $g(clause)_$$parseCond(.mt,$p(condString,"^",cond))_" AND "
		}
		set clause = $e(clause,1,*-5) // strip trailing " AND "
		// ShowPlan makes use of this procedure to grab the query for the plan, but this portion is only needed to return information
		// by reference for code generation, which is not necessary for plan details (pti might be undefined and lead to errors)
		if 'showPlan {
			// ftParams will be comma delimited list of the query parameters
			for i=1:1:$ll(prm) { // NOTE: prm is public and set by way of parseCond^%qaqcmh above 
				set val = $li(prm,i), dataType = $$$VTRgetdt(val)
				set dataType=$case($p(dataType,".",2),"Boolean":-7,"TinyInt":-6,"BigInt":-5,"Numeric":2,"Integer":4,"SmallInt":5,"Double":8,"Date":9,"Time":10,"TimeStamp":11,"PosixTime":11,:12)
				set ftParams = $g(ftParams)_",$lb("_dataType_","_pti(val)_")"
			}
			set $e(ftParams) = "" // remove leading comma
		}
		set query = query_" WHERE "_clause
	}
.
	RETURN query	
}
.
.
/// Generate table name in this query for the provided foreign table stream
foreignTableName(stream) [ mt ] PRIVATE {
	RETURN:'$$$IsFTStream(stream) ""
	set defaultQuery = $$$FTDefaultQueryByOriginalStream(stream)
	if defaultQuery '= "" {
		// FT defined a QUERY clause so that stands in for the table. Quoting already taken care of within there.
		RETURN "("_defaultQuery_") T"_stream
	} else {
		set irn = $$$mtRIrn($$$mtR( stream))
		RETURN $$quoteFTIdentifier($$$smdFTTableName(1, irn), stream)_" T"_stream
	}	
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; called from vertVal^%qaqcmh
	#; Parameters
	#; 		vIdx   - index in mt("v") of the field in question
	#; 		ifn    - ifn aka uniquely identifying number for the field
	#; 		stream - stream the field is associated with
	#; 
	#; Returns
	#; 		A reference to the field in the form of [alias].[fieldname], potentially 
	#; 		quoted as a delimited identifier
	#; 
	#; Public Vars
	#; 		mt 	- need parse tree info
parseFTField(vIdx, ifn, stream) [ mt ] {
	RETURN:vIdx="" ""
	RETURN:'$d($$$mtV(vIdx)) ""
	RETURN:$$$mtVType($$$mtV(vIdx))'="f" ""
	
	// at this point we know this is a field for a foreign table and we have
	// the subscript of mt("v") that represents this field
	// quoterU(fld, 1) will wrap the field name in quotes if it can't be a regular identifier OR if we quote
	// delimited identifiers by default for this foreign table
	RETURN "T"_stream_"."_$$quoteFTIdentifier($$$smdColFTExternalColName(1,$$$mtRIrn($$$mtR(stream)),ifn), stream)
}
.
#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; Return the appropriate quoting for the given identifier for the given FT stream.
	#; We do this by calling the QuoteIdentifier() class method of the foreign data wrapper that will
	#; be used to wrap the source type of this FT
	#; Parameters
	#; 		identifier   	- the identifier (table name, field name) to be quoted
	#; 		stream     		- stream number of the foreign table the identifier belongs to
	#; 
	#; Returns
	#; 		The identifier, quoted as needed by the source
	#; 
	#; Public Vars
	#; 		mt 	- need parse tree info
quoteFTIdentifier(identifier, stream) [ sql, mt ] {
	RETURN:'$$$IsFTStream(stream) identifier
	set server = $$$FTServerByOriginalStream(stream)
	RETURN:server="" identifier
	set fdwClass = $$$FTServerFDWClass(server)
	RETURN $s(+$g($$$FTServerSupportsDelIds(server)): $CLASSMETHOD(fdwClass, "delimitIdentifier", identifier), 1: identifier)
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#INCLUDE %fcalpha
	#; AK395
#INCLUDE %quoter
squoter(x) ; $$ Func to wrap single quotes around x, x may already contain quotes
	QUIT:x=+x x n a,i s a="" f i=1:1:$l(x,"'") s a=a_"'"_$p(x,"'",i)_"'"
	QUIT a
	#; AK395-
 #; If v is from search_index function, isSearchIndex returns 1 and reconstruct 
 #; the SEARCH_INDEX qval in vertVal. Otherwise, isSearchIndex returns 0.
isSearchIndex(vIdx,v,qval)[mt] PRIVATE {
	If $data(mt("search_index"))=10{
		Set idxName = ""
		For {
			Set idxName = $o(mt("search_index",idxName))
			Quit:idxName=""
			If $data(mt("search_index",idxName,vIdx)){
				Set qval = "SEARCH_INDEX("_idxName_$s($p(v,",",2)="^":"",1:",")
				Return 1
			}
		}
	}
	Return 0
}
.
#; generate RTPC query hints: %NORUNTIME and/or %DORUNTIME if needed
genRTPCHint(qn,prependSpace=0)[mt] PUBLIC {
	RETURN:$tr($g($$$mtDSNLinkedTable(qn))," ")'="" ""
	RETURN $s(($g(mt("noruntime")))||(%caller="DynamicQuery"):$s(prependSpace:" %NORUNTIME",1:"%NORUNTIME "),1:"")_$s($g(mt("doruntime")):$s(prependSpace:" %DORUNTIME",1:"%DORUNTIME "),1:"") 
}
.
---
