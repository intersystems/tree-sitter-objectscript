	if 'find,lcat="DATE,POSIXTS",narg=2 {
		If ($p(ldt,",")="%Library.Date")&&(($e($$$mtV($p(larg,",")))="f")||($$$VTRgetname($p(larg,",",2))="CURRENT_TIMESTAMP")){  ; If the LHS is a %Date field, convert the posixtime to a %Date 
			// Convert posixtime to a modified logical date (MLD) format 
			// the MLD is a numeric value representing a timestamp, whose integer part is the same as its $h counterpart
			// the decimal part of MLD is the fraction of the day. e.g. the MLDF of "04/02/2023 06:00:00" would be 66566.25,
			// which correpsonds to the "66566,21600" logical date value
			// If px is a posixtime value, then the MLD value is MLD= ((px-(2**60))/100000)/86400+47117 = (px-1148850595806846976)/86400000000
			new t1v,t2v,t3v
			do putval^%qaqpslx("t^1148850595806846976") s t1v=val
			do create(t1v,"const","%Library.Numeric",,,,1148850595806846976)
			do putval^%qaqpslx("t^86400000000") s t2v=val
			do create(t2v,"const","%Library.Numeric",,,,86400000000)
			do putval^%qaqpslx("v^-^^"_$p(larg,",",2)_"^"_t1v_"^") s t3v=val
			do create(t3v,"op","%Library.Numeric",,,,"-")
			do putval^%qaqpslx("v^/^^"_t3v_"^"_t2v_"^")
			do create(val,"op","%Library.Numeric",,,,"/")
			set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Numeric")
			set $$$mtLOperand2($$$mtL(log))=val
		} 
		else{
			do putval^%qaqpslx("v^CONVERT:%Library.PosixTime^^"_$p(larg,",",1)_"^")
			do create(val,"op","%Library.PosixTime",,,,"Convert")
