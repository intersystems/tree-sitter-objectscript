====
qaqpdt
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpdt^MAC^^^0
%qaqpdt	// Query processor ADT/opt (categories) (Aviel 10/29/96 AK286)
	;; COMPONENTS :: SQL/Parser
	#;
#include %occODBC
#INCLUDE %msql
#IF 0   ;-------------------------------------------------------------
	; Description:   Query processor ADT/Operation Table (categories)
	; Author:        Aviel Klausner
	; Date Started:  October 29, 1996
	;
	;  AK850   (11/30/2020) - Implement lateral join
	;  DPV3330 (12/30/2008) - Correct type information for SUBSTRING function
	;  DPV3270 (09/25/2008) - Correct type returned for XMLAGG columns
	;  DPV3230 (08/01/2008) - Correct DATE <op> TIMESTAMP when user-defined datatypes are used 
	;  DPV3220 (07/15/2008) - Improve PRECISION and SCALE reporting for Aggregates and other functions
	;  DPV3191 (06/11/2008) - Report error for SUM() on DATE, TIME, or TIMESTAMP values
	;  DPV3173 (06/09/2008) - Reduce use of %Library.Float, some functions return DOUBLE or NUMERIC
	;  DPV3174 (05/28/2008) - Perform string-op-string operations for ], %PATTERN, and %STARTSWITH
	;  DPV3170 (05/23/2008) - Perform Normalization on literal and host variable input values
	;  AK667   (12/21/2006) - Recompute mt("unary") entries
	;  DPV3131 (03/25/2008) - DD Lookup and Table compiler performance improvements
	;  DPV3060 (10/26/2007) - Fixes for %FilemanDate and %FilemanTimeStamp datatypes in SQL
	;  DPV3053 (10/16/2007) - For COALESCE function return best compatible type
	;  DPV3045 (10/03/2007) - Correct type information for CASE, other functions.
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  DPV2768 (10/19/2006) - SQL Fix ProdLog 53024: New Case for DPV2463 - Subquery output in correct mode
	;  DPV2527 (09/28/2005) - SQL Fix: Fix <SUBSCRIPT> in putvardt^%qaqpdt from AK630
 	;  AK630   (08/23/2005) - Fix datatype determination in subqueries
	;  PVA076  (04/01/2005) - SELECT DISTINCT or SELECT of GROUP BY columns no failed to invoke LogicalToODBC.
	;  DPV2463 (07/19/2005) - Set column datatype properly for subquery in SELECT clause
	;  DPV2312 (10/26/2004) - Fix type reported for functions NVL, ISNULL, IFNULL, NULLIF, and COALESCE
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  AK562   (04/25/2003) - Apply correct %ODBCIN to IN parameters
	;  BJB242  (10/16/2002) - Correct BJB237, change = to '= in $Select
	;  BJB237  (08/27/2002) - Avoid <MAXNUMBER> error in SQL constants
	;  DPV1801 (08/21/2002) - Hard-code more TimeStamp/Date/Time conversions for IN
	;  DPV1638 (01/07/2002) - Use field's type parameters for input value ODBCToLogical conversion
	;                         Change @mt@( to mt(
	;  DPV1431 (10/24/2000) - Changed all %Date to %Library.Date, %Time[Stamp] to %Library.Time[Stamp], etc
	;  AK446   (05/31/2000) - View stream processing
	;  AK378   (07/02/1999) - CCS: Hard-code operation %TimeStamp=%Date
	;  AK361   (04/29/1999) - ODBC datatype reporting and conversion
	;  DPV1033 (04/09/1999) - Translate constant valeus from ODBC to Logical mode when 
	;                         compiling with #sqlcompile select=odbc
	;  AK347   (01/06/1999) - Input conversion
	;  AK333   (10/23/1998) - Change hard-coded %STRING/%MVALUE to %String/STRING
	;  AK306   (01/12/98)   - Use %String as default datatype
	;  AK304   (01/06/98)   - List-fields in the Query Processor
	;  AK289   (04/07/97)   - Restructure INSERT/UPDATE
	;  AK286   (10/29/96)   - Use operation table (SQL categories) in QP
	;                        (routine created)
	;
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
	;  This program implements the query processor code to use the
	;  category API and apply it.  It also generates a new structure
	;  in the parse tree, the list of value tree objects (vtr).
	;
	;  Functions implemented here to be used as external entry-points:
	;       docats - main e.p. to process all operations in the parse
	;                tree, based on the category table.
	;       $$getdtvar(vtr) - get the datatype of the given host variable
	;
	;-------------------------------------------------------------
	;               External entry points used in this routine
	;  findopt^%qadop - searches the
	;      category/operations table and returns its findings
	;  cast^%qadop - search for CAST, actually calls
	;       findopt("CAST",2,from_","_to,...)
	;  GetType^%qadfld2(irn,ifn) - the datatype of the given DD field
	;
#ENDIF  ;-------------------------------------------------------------
	$$$Abort  ; Not an Entry Point!!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  Value tree property macros - moved to %msql.INC  ;  AK304
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;                       Query processor code
docats	;  main e.p. - process all operations in the parse tree, based on
		#;  the category table.  Also, set up the vtr objects (value tree)
		#;  for all val# and log#
		#;  called from ^qo, after calling 'linx', before calling 'not'
	new i,log,val
		#;  process mt("v",val) and create a new vtree object for each val
	for val=1:1:$$$maxv { do createval(val) }
		#;  process mt("l",log) and create a new vtree object for each log
	for log=1:1:$$$maxl { do createlog(log) }
		#;	For any TVF arguments (varcons), assign the type based on the type defined for the procedure parameters
	if $d(mt("tvf")) {
		new m,paramtype,pos,ptr,tvfname,tvfparams
		set m=""
		for {
			set m=$o(mt("tvf",m)) quit:'m
			set tvfname=""
			for  {
				set tvfname=$o(mt("tvf",m,tvfname),1,tvfparams) quit:tvfname=""
				continue:tvfparams=$c(0)	// no parameters for this TVF
				continue:tvfname="JSON_TABLE"
				set ptr=0,pos=0
				while $listnext(tvfparams,ptr,val) {
					set pos=pos+1	// parameter position
					continue:'$d(val)
					if val,"tx"[$e($g(mt("v",val))) {	// value is a varcon
						set paramtype=$$getTVFParamType(tvfname,pos)
						set $$$VTRdt(val)=paramtype
						set $$$VTRcat(val)=$$getcat(paramtype)
					}
				}
.
			}
		}
	}
		#;  For INSERT/UPDATE SET f1=:v1, assign f1's datatype and mlv to v1
	for i=1:1 {
		set val=$p($g($$$mtFList),",",i) quit:'val
		do putvardt($p($g($$$mtNewVals),",",i),val,1,1)
	}
	if $d(mt("union")) {
		new unf do defineunf^%qaqpifo
		if $d(unf) {
			new unflist
			set val="",unflist=""
			for  { set val=$o(unf(val)) quit:val=""  set unflist=unflist_val_"," }
			if $g($$$mtNewVals)=unflist {
					#; The values being INSERTed/UPDATEd are the same as the first leg of a union query
					#; Perform the same putvardt call for the nuval items with the other legs of the union
				new pos,valf
				for i=1:1 {
					set val=$p($g($$$mtNewVals),",",i) quit:'val
					set valf=$p($g($$$mtFList),",",i)
					for pos=2:1:$ll(unf(val)) { do putvardt($lg(unf(val),pos),valf,1,1) }
				}
			}
		}
	}
		#; AK289-
		#;  Now pass the whole list again, to mark undeclared variables
		#;      (if not assigned already as part of an expr) as %Library.String  ;  AK306;AK333
	for val=1:1:$$$maxv { do:$$$VTRgetdt(val)="" dtset(val,"%Library.String") }
	RETURN  ;--- docats
/// Given a qualified procedure name (UPPER CASE) and a position, return the ObjectScript type of the procedure parameter for that position
getTVFParamType(PROC,pos) PRIVATE {
	set SCHEMA=$$$UPPER($p(PROC,".",1))
	set PROC=$$$UPPER($p(PROC,".",2))
	set columns=$Get($$$PROCcolumn($$$pPROC,SCHEMA,PROC))
	set colPosition=0
	for column=1:1:columns {
		set colType=$Get($$$PROCCOLtype($$$pPROC,SCHEMA,PROC,column))
		continue:$case(colType,$$$SQLRESULTCOL:1,$$$SQLRETURNVALUE:1,:0)
		set colPosition=colPosition+1
		continue:colPosition'=pos
			// We found the proc parameter we are looking for
		set type=$$$PROCCOLdatatype($$$pPROC,SCHEMA,PROC,column)
		quit
	}
	RETURN $g(type)
 }
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getcat(dt="") [] PUBLIC { 
		#;  return category of given datatype, or STRING if error
	RETURN:dt="" "STRING"
	set cat=$$$comClassKeyGet(dt,$$$cCLASSsqlcategory) set:cat="" cat="STRING"
	RETURN cat
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getodbc(dt="") [] PRIVATE { ;  return ODBCTYPE of given datatype, or VARCHAR if error
	RETURN:dt="" "VARCHAR"
	set odbc=$$$comClassKeyGet(dt,$$$cCLASSodbctype) set:odbc="" odbc="VARCHAR"
	RETURN odbc
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
declared(var)  ;  declared dt of the local var (via SQL or ##class), or NULL
	#;  for now, always return NULL
	#;  DPV3053 - for now always return %Library.String
	RETURN "%Library.String"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;              Value tree (vtr) object implementation
	#;  PROPERTIES:
	#;      type - bool/compare/ignore/field/const/var/op/extfun/meth/
	#;             agg/subq/oldname(?)/as/mexpr(?)/unk(?)
	#;             (maybe also select/where/join/order/into/group/having)
	#;      dt - datatype
	#;      cat - category
	#;      qno - subquery it's part of (maybe not always filled yet)
	#;      narg - number of arguments
	#;      larg - LIST(val,val) of narg arguments
	#;      lpar - LIST(vtr,vtr) where used - back-pointer to larg
	#;             (incl. SELECT-list, WHERE, etc.?)
	#;      str - stream# - for field
	#;      irn - for field
	#;      ifn - for field
	#;      omsinfo - information for ODBC client-server
	#; AK304
	#;      IsLF - Whether it is a list-field ("Y") or not
	#;      LFDel - Serialized format delimiter, or NULL for $LIST
	#;      LFStorage - Storage type, serialized (1) or one-per-node (2)
	#; AK304-
	#;  (Other properties, to be added later to make mt("v") obsolete:)
	#;      name - operator (for log/comp/const/var/op/extfun/meth?/agg/as
	#;      lfld - LIST(,val,) of fields used (also subq's, agg's?)
	#;      lstr - LIST(str,) of streams used (esp. for type field)
	#;      agginfo - information for agg
	#;      qinfo - information for subq
	#;  METHODS:
	#;    class methods:
	#;      create(vtr,type,dt,qno,narg,larg,name) - make new entry
	#;      createval(val) - for the given old val#
	#;      createlog(log) - for the given old log#
	#;    instance methods:
	#;      $$exist() - whether such object exists
	#;      $$dtset(%val) - SET method for dt - also sets cat
	#;      $$getdtvar(vtr) - return the dt of a host variable/"?"
	#;  IMPLEMENTATION:
	#;  Stored in array mt("vtr",%this), where %this corresponds to
	#;  mt("v") subscripts.  for log/comp, -%this corresponds to
	#;  mt("l") subscripts.
	#;  The top node stores properties in $P(;):
	#;      mt("vtr",vtr) = type;dt;cat;qno;str;irn;ifn;narg
	#;  Other properties are stored in subscript nodes:
	#;      mt("vtr",vtr,propname) = propvalue for these properties:
	#;           name,larg,lpar,lfld,lstr,agginfo,qinfo,omsinfo
	#;
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;              value tree methods implementation
create(vtr,type="",dt="",qno="",narg="",larg="",name="",scale="",precision="",convertOnClient="")  ;  create new vtr entry,
		#;  with the given property values
	set $$$VTRtype(vtr)=type
	do dtset(vtr,dt)  ;  to also set cat
	set $$$VTRqno(vtr)=qno
	set $$$VTRnarg(vtr)=narg
	set $$$VTRname(vtr)=name
	set:scale'="" $$$VTRscale(vtr)=scale	// DPV3173
	if precision'="" { set $$$VTRprecision(vtr)=precision } else { set $$$VTRprecision(vtr)=$p($$definfo^%qaqpif2(dt),$c(1),4) }
	set:convertOnClient'="" $$$VTRconvertonclient(vtr)=convertOnClient
	#; AK347
	RETURN  ;  remove unused subnodes, for now
	set $$$VTRlarg(vtr)=larg
	RETURN  ;--- create
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
createval(vtr)  ;  for the given old val#
	RETURN:$g($$$mtVtr(vtr))'="" ;  already created
	new larg,ldt,narg,op,v
	set v=$$$mtV(vtr)
	RETURN:v="junk"
	if $e(v)="i" { do create(vtr,"ignore") RETURN }  ;  ignore (map subscripts?)
	if $e(v)="f" {		//  field
		RETURN:$l(v,"^")=4  ;  PT-1 entry, nothing to do yet  ;  AK1068
		new convertOnClient,ifn,irn,str
		set str=$p(v,"^",2),ifn=+$p(v,"^",3),irn=+$$$mtR(str)
			#;  virtual stream - copy datatype/irn/ifn!
		set convertOnClient=$$$smdColConvertL2OOnClient(1,irn,ifn)
		if $d(mt("union")) {
			set:$$unionLegField^%qaqcpr(vtr) convertOnClient=0
		}
		if $g($$$mtRVirtual(str)) {
			set v=$g($$$mtVirf(ifn)),op=$lg(v,2)
			do createval(op):op,create(vtr,"field",$s(v="":"%Library.String",$li(v)=0:"%Library.Integer",1:$$$VTRgetdt(op)),$$$mtRQb($$$mtR(str)),,,,,,convertOnClient)
			set:op ifn=$$$VTRgetifn(op),irn=$$$VTRgetirn(op),$$$VTRscale(vtr)=$$$VTRgetscale(op),$$$VTRprecision(vtr)=$$$VTRgetprecision(op),$$$VTRconvertonclient(vtr)=$$$VTRgetconvertonclient(op)
			set $$$VTRifn(vtr)=ifn,$$$VTRirn(vtr)=irn
			RETURN
		}
		do create(vtr,"field",$$GetType^%qadfld2(irn,ifn),$$$mtRQb($$$mtR(str)),,,,$p($g($$$smd(8,+ifn)),$c(1),5),$p($g($$$smd(8,+ifn)),$c(1),4),convertOnClient)
		set $$$VTRifn(vtr)=ifn  ;  ,$$$VTRlfld(vtr)=","_vtr_",",$$$VTRlstr(vtr)=str_","  ;  remove unused subnodes, for now  ;  AK347
		set $$$VTRirn(vtr)=irn,$$$VTRIsLF(vtr)=$$$smdColListCollection(1,irn,ifn)
		set $$$VTRLFDel(vtr)=$$$smdColListDelimiter(1,irn,ifn)
		set:$$$VTRgetIsLF(vtr)="Y" $$$VTRLFStorage(vtr)=$$$smdColListType(1,irn,ifn)
		 ;  s $$$VTRomsinfo(vtr)="***"  ;  ***  for all cases!  ;  remove unused subnodes, for now  ;  AK347
		RETURN
	}
	if $e(v)="t" {		//  constant
		new const
		set const=$p(v,"^",2,*)
		do create(vtr,"const",$s(+$Number(const)'=const:"%Library.String",const[".":"%Library.Numeric",1:"%Library.Integer"),,,,const,$s(+$Number(const)'=const:"",const[".":$l($p(const,".",2)),1:0))	// DPV3173 (Numeric, not Float)
		 ;  s $$$VTRlfld(vtr)=","  ;  remove unused subnodes, for now  ;  AK347
		RETURN
	}
	if $e(v)="x" {  ;  host variable
			#; LATERAL field reference  ;  AK850
		if v=("x^"_+$e(v,3,*)),v'="x^0" {
			set op=$e(v,3,*)
			do createval(op)
			do create(vtr,"lateral",$$$VTRgetdt(op),,,,$$$VTRgetname(op),$$$VTRgetscale(op),$$$VTRgetprecision(op),)
			RETURN
		}
		new var
		set var=$p(v,"^",2,*)
		do create(vtr,"var",$$declared(var),,,,var)
		;  s $$$VTRlfld(vtr)=","  ;  remove unused subnodes, for now  ;  AK347
  		RETURN
	}
	if $e(v)="a" {	// Aggregate:  count, sum, avg, max, min, list, xmlagg, %dlist
		new aggArgument, aggOp, convertOnClient, datatype, precision, scale
		set (convertOnClient,datatype,precision,scale) = ""
		set aggOp = $p(v,"^",2)
		set aggArgument = $p(v,"^",5)
		do:aggArgument createval(aggArgument)		// if arg present, recurse so that arg's info is definitely present
		if (aggOp="xmlagg") || (aggOp["list") {
			set datatype = "%Library.String"
		} elseif aggOp="count" {
			set datatype = "%Library.BigInt"
			set scale = 0
		} elseif aggOp="avg" {
			if aggArgument && ($$$VTRgetcat(aggArgument)="DOUBLE") {
				set datatype = "%Library.Double"
			} else {
				set datatype = "%Library.Numeric"
			}
			set scale = 17
		} elseif (aggOp="sum") && aggArgument && $case($$$VTRgetcat(aggArgument), "DATE":1, "TIME":1, "TIMESTAMP":1, :0) { // SUM of DATE/TIME/TIMESTAMP report type of numeric
			set datatype = "%Library.Numeric"
		} elseif aggArgument { 	// sum, max, min etc, base info on the argument's info (if not streamless)
			set convertOnClient = $$$VTRgetconvertonclient(aggArgument)
			set datatype = $$$VTRgetdt(aggArgument)
			set precision = $$$VTRgetprecision(aggArgument)
			set scale = $$$VTRgetscale(aggArgument)
		}
		do create(vtr,"agg",datatype,,,,,scale,precision,convertOnClient)
		set:info $$$VTRomsinfo(vtr)=$$definfo^%qaqpif2(datatype,,precision,scale) 
		RETURN
	}
	if $e(v)="q" {	// DPV2463+
		new dt,ovals
		set dt="%Library.String"
			#; If this sub-query outputs 1 field and this query is output by the main query, set the proper type for this sub-query
		if $d($$$mtOutput($p(v,"^",2)),ovals),$p(ovals,",",2)="",$p($p(ovals,","),"^",2) {	// DPV2768 (no m>1)
			/*,(","_$$$mtOutputVals($g($$$mtOutput(1)))_",")[(","_vtr_",")*/ 	// DPV3842, not just subqs output by outermost select
			new subval
			set subval=$p($p(ovals,","),"^",2)
			if '$d($$$mtVtr(subval)) { do createval(subval) }
			set dt=$$$VTRgetdt(subval)
			do copydt(vtr,subval)
		}
		do create(vtr,"subq",dt,,,,)
		RETURN
	}	// DPV2463-
	if $e(v)="n" { 
		do create(vtr,"as",,,,,)
		do copydt(vtr,$p($$$mtV(vtr),"^",4))
		RETURN
	}
		#;  *** other cases - functions, $$extfuns, methods, others?
	if $e(v)'="v" { do create(vtr,$e(v),,,,,) RETURN }
	set op=$p(v,"^",2)
	new origop set origop=op
	if $p(op,":",1)="%WINDOW_FUNCTION" {
		new datatype,precision,scale,windowFuncOp,windowFuncOpCommas
		set windowFuncOp = $p(op,":",2), windowFuncOpCommas = (","_windowFuncOp_",")
		set (datatype,precision,scale) = ""
		if (",LAG,LEAD,"[windowFuncOpCommas) && $p(v,"^",10) {
			set datatype = "%Library.String"
			RETURN
		} elseif (",ROW_NUMBER,RANK,DENSE_RANK,CUME_DIST,"[windowFuncOpCommas) {
			set datatype = "%Library.BigInt"
		} elseif (",PERCENT_RANK ,"[windowFuncOpCommas) {
			set datatype = "%Library.Double"
		} else {	//Assume (for now) dynamic window function type is type of first arg
			new windowFuncFirstArg
			set windowFuncFirstArg = $p(v,"^",8)
			if windowFuncFirstArg {
				do createval(windowFuncFirstArg)
				set datatype = $$$VTRgetdt(windowFuncFirstArg)
				set precision = $$$VTRgetprecision(windowFuncFirstArg)
				set scale = $$$VTRgetscale(windowFuncFirstArg)
			}
		}
		do create(vtr,"op",datatype,,,,windowFuncOp,scale,precision)
		set:info $$$VTRomsinfo(vtr)=$$definfo^%qaqpif2(datatype,,precision,scale)
		RETURN
	}
	if op="CASE_AGG" { set op="CASE" } elseif op="/AGG" { set op="/" } elseif op="SQRT_AGG" { set op="SQRT" }	// could be a standard deviation aggregate
	
		/* *** From this point on, once args is called, any sub values of the mt("v") being processed should automatically 
				be added recursively to mt("vtr"), so it can be assumed vtr info of subvals exists *** */
	do args ;  set narg,larg,ldt, uses v, process arguments recursively
	if op="%ODBCOUT" {
		new targarg
		set targarg=$p(larg,",")
		do copydt(vtr,targarg)				//  use argument's datatype
		if $d(mt("union")) {
			new convertOnClient
			set convertOnClient=$s($$unionLegField^%qaqcpr(vtr):0,1:$$$VTRgetconvertonclient(targarg))
			set $$$VTRconvertonclient(vtr)=convertOnClient
		}
		RETURN
	}
	if op="/0" { 	// DPV4377 AVG
			// This is a special agg case for AVG we have turned into SUM /0 COUNT
			// If the first arg is DOUBLE, the original statement was AVG(double), so we return DOUBLE, otherwise return NUMERIC
		do create(vtr,"agg",$s($$$VTRgetcat(+larg)="DOUBLE":"%Library.Double",1:"%Library.Numeric"),,,,,17)
	} elseif $case(origop,"CASE_AGG":1,"SQRT_AGG":1,"/AGG":1,:0) {
		do create(vtr,"agg",$s($$$VTRgetcat(mt("agg-orig-argval",vtr))="DOUBLE":"%Library.Double",1:"%Library.Numeric"),,,,,17)
	}
	do create(vtr,"op",,,narg,larg,op)
		#;  need to also set irn/ifn for these cases!
	if op="COALESCE" { do UseBestCompatibleType(vtr,larg,op) }
	elseif $Case(op,"BIGGER":1,"GREATEST":1,"LEAST":1,"SET:SETOF":1,:0) { do UseBestCompatibleTypeAll(vtr,larg,op) }
	elseif op="IFNULL" { do UseBestCompatibleTypeAll(vtr,$p(larg,",",2,*),op) }
	elseif op="MOD" { do NumericOrDouble(vtr,$p(larg,","),21,19,18) }														//  use DOUBLE or NUMERIC based on first argument's datatype, default len/prec/scale
	elseif $Case(op,"ACOS":1,"ASIN":1,"COS":1,"SIN":1,:0) { do NumericOrDouble(vtr,$p(larg,","),21,19,18) }										//  use DOUBLE or NUMERIC based on first argument's datatype (DPV3173)
	elseif $Case(op,"ATAN":1,"ATAN2":1,"COT":1,"DEGREES":1,"EXP":1,"LOG":1,"LOG10":1,"POWER":1,"RADIANS":1,"SQRT":1,"TAN":1,:0) { do NumericOrDouble(vtr,$p(larg,","),38,36,18) }	//  use DOUBLE or NUMERIC based on first argument's datatype (DPV3173)
	elseif $Case(op,"%ODBCIN":1,"ABS":1,"CEILING":1,"FLOOR":1,"ISNULL":1,"NVL":1,"NULLIF":1,:0) { do copydt(vtr,$p(larg,",")) }							//  use first argument's datatype (DPV3045)	// DPV3330 (SUBSTRING)
	elseif op="%INTERNAL" {
		if $$$VTRgetcat($p(larg,",",1))="DATE" {	// If the 1st argument to the %INTERNAL is of category DATE, return type is %Library.Integer
			do create(vtr,"op","%Library.Integer",,,,"%INTERNAL")
			set:info $$$VTRomsinfo(vtr)=$$definfo^%qaqpif2("%Library.Integer")
		}
		if $$$VTRgetcat($p(larg,",",1))="TIME" {	// If the 1st argument to the %INTERNAL is of category TIME, return type is %Library.Numeric, prec=15, scale=9
			do create(vtr,"op","%Library.Numeric",,,,"%INTERNAL",9)
			set:info $$$VTRomsinfo(vtr)=$$definfo^%qaqpif2("%Library.Numeric",15,15,9)
		}
	}
	elseif op="DATEADD" {
		if $$$VTRgetcat($p(larg,",",3))="POSIXTS" {	// If the 3rd argument to the DATEADD is of category POSIXTS, return type is %Library.PosixTime
			do create(vtr,"op","%Library.PosixTime",,,,"DATEADD")
			set:info $$$VTRomsinfo(vtr)=$$definfo^%qaqpif2("%Library.PosixTime")
		}
		else {		// Otherwise it is a %TimeStamp
			do create(vtr,"op","%Library.TimeStamp",,,,"DATEADD")
			set:info $$$VTRomsinfo(vtr)=$$definfo^%qaqpif2("%Library.TimeStamp")
		}
	}
	elseif op="DATETRUNC" {
		if $$$VTRgetcat($p(larg,",",2))="POSIXTS" {	// If the 2rd argument to the DATEADD is of category POSIXTS, return type is %Library.PosixTime
			do create(vtr,"op","%Library.PosixTime",,,,"DATETRUNC")
			set:info $$$VTRomsinfo(vtr)=$$definfo^%qaqpif2("%Library.PosixTime")
		}
		else {		// Otherwise it is a %TimeStamp
			do create(vtr,"op","%Library.TimeStamp",,,,"DATETRUNC")
			set:info $$$VTRomsinfo(vtr)=$$definfo^%qaqpif2("%Library.TimeStamp")
		}
	}
	elseif op="SUBSTRING" {
		if $$$VTRgetcat($p(larg,","))="STRING" {	// If the first argument to the SUBSTRING is of category STRING, use the type info from the first argument, otherwise the return type of SUBSTRING has to be STRING
			do copydt(vtr,$p(larg,","))
		}
		else {
			do create(vtr,"op","%Library.String",,,,"SUBSTRING")
		}
	}
	elseif op="CASE" {
		new i,v1,larg2
		set larg2="" for i=2:2 set v1=$p(larg,",",i) if v1'="" { s larg2=larg2_v1_"," } else { set v1=$p(larg,",",i-1),larg2=larg2_v1_"," q  }
		do UseBestCompatibleTypeAll(vtr,larg2,op)
	}
	elseif op="ROUND"||(op="TRUNCATE") {
		do copydt(vtr,$p(larg,","))			//  use first argument's datatype
			#; Try to find a good SCALE for ROUND and TRUNCATE
			#; Hopefully the second argument to ROUND or TRUNCATE was a literal value and we can get the SCALE directly from that
		new scale,v5
		set v5=$p(v,"^",5) 
		if $e($g($$$mtV(v5)))="t" {
			set scale=$normalize($p($$$mtV(v5),"^",2),0)
			set scale=$s(scale>0:scale,1:0)
			set $$$VTRscale(vtr)=scale
			if scale { do dtset(vtr,"%Library.Numeric") }
		}
	}
	elseif ",+,-,*,/,\,#,"[(","_op_",") {
		do NumericOrDouble2(vtr,$p(larg,",",1),$p(larg,",",2),op)
	}
	elseif op="TSQL_PLUS" { do UseBestCompatibleTypeAll(vtr,$p(larg,",",2,*),op) }
	elseif op="DECODE" { do copydt(vtr,$p(larg,",",3)) }								//  use third argument's datatype (DPV3444) 
	elseif op="%EXACT" { do dtset(vtr,$p(ldt,",")) } ; use arg's data type.  PVA076: use arg's type for %EXACT
	elseif op="VECTOR_COSINE"||(op="VECTOR_DOT_PRODUCT") { // the return type is the same if as either argument, and default to double
		// find the return datatype
		new vdt
		set vdt=$$GetVecFuncReturnType^%qaqpif2(op,$p(larg,","),$p(larg,",",2)) // get the return data type
		do dtset^%qaqpdt(vtr,$s(vdt=2:"%Library.Numeric",(op="VECTOR_DOT_PRODUCT")&&(vdt=-5):"%Library.BigInt",1:"%Library.Double"))
		if info,vdt=2 { set $$$VTRomsinfo(vtr)=$$definfo^%qaqpif2("%Library.Numeric",,,4) } // set scale=4 for numeric
	}
		#;  search in Operation Table
	new find,gcode,kind,ptarr,retdt,rev
	set find=$$findopt^%qadop(op,narg,ldt,.kind,.gcode,.retdt,.rev,.ptarr)
	RETURN:'find  ;  for now, just leave it as is
	if kind="ERROR" { do error(95) RETURN }  ;  "Operation disallowed by Operation Table"
	do dtset(vtr,retdt)  ;  set in the resulting datatype
		#;  if rev then reverse the arguments (must be narg=2)
	if rev { set larg=$p(larg_","_larg,",",2,3),$$$VTRlarg(vtr)=larg,$p($$$mtV(vtr),"^",4,5)=$tr(larg,",","^") }
		#;  if operator given, just set in the new operator
	if kind="oper" { set $$$VTRname(vtr)=gcode,$p($$$mtV(vtr),"^",2)=gcode RETURN }
		#;  the following have to be added to ^pre, checking $$$VTRname(vtr)!
	if kind="expr" { set $$$VTRname(vtr)="expr:"_gcode RETURN }
	if kind="method" { set $$$VTRname(vtr)="method:"_gcode RETURN }
	RETURN  ;--- createval
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
createlog(log)  ;  for the given old log#
	#;  a log only has type,name,qno,narg,larg,lpar,lfld,lstr
	QUIT:''$d($$$mtVtr(-log))  ;  already created
	n i,larg,lcat,ldt,narg,op,v
	s v=$$$mtL(log),op=$p(v,"^",2)
	i $e(v)="i" d create(-log,"ignore") QUIT  ;  ignore
	if op="CASE_AGG" { set op="CASE" } elseif op="/AGG" { set op="/" } elseif op="SQRT_AGG" { set op="SQRT" }	// could be a standard deviation aggregate
	d args  ;  set narg,larg,ldt, uses v, process log arguments recursively
	#;  *** for AND/OR/NOT fill in qno,lpar,lfld,lstr later!
	i $e(v)="l" d create(-log,"bool",,,narg,larg,op) QUIT
	#;  *** what about subqueries?
	#;  comparison and other logicals on values
	d create(-log,"compare",,,narg,larg,op)
	#;  search in Operation Table
	n find,gcode,kind,ptarr,rev
	s find=$$findopt^%qadop(op,narg,ldt,.kind,.gcode,,.rev,.ptarr,.lcat)			// DPV3230
.
		#; If an item is a DATE category, but not %Library.Date type, 
		#; or a TIMESTAMP category, but not a %Library.TimeStamp type, the datatype class may
		#; have a LogicalToDate or LogicalToTimeStamp method that will convert the type to DATE or TIMESTAMP.
		#; Iff this method exists and is runnable, go ahead and call it to convert the method now.
		#; Except... don't do this conversion if both arguments are of the same datatype.
	for i=1:1:2 {
		if $p(lcat,",",i)="DATE",$p(ldt,",",i)'="%Library.Date",$$$VTRname($p(larg,",",i))'="CURRENT_DATE",$p(ldt,",",1)'=$p(ldt,",",2) {	// DPV3591
			if $$$comMemberDefined($p(ldt,",",i),$$$cCLASSmethod,"LogicalToDate"),$$runnable^%qadadt($p(ldt,",",i),"LogicalToDate") {
				d putval^%qaqpslx("v^METHOD:"_$p(ldt,",",i)_".LogicalToDate^^"_$p(larg,",",i)_"^")
				d create^%qaqpdt(val,"op",$p(ldt,",",i),,,,"LogicalToDate") 
				s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Date")
				s $p($$$mtL(log),"^",3+i)=val,$p(larg,",",i)=val
			}
		}
		if $p(lcat,",",i)="TIMESTAMP",$p(ldt,",",i)'="%Library.TimeStamp",$$$VTRname($p(larg,",",i))'="CURRENT_TIMESTAMP",$p(ldt,",",1)'=$p(ldt,",",2) {	// DPV3591
			if $$$comMemberDefined($p(ldt,",",i),$$$cCLASSmethod,"LogicalToTimeStamp"),$$runnable^%qadadt($p(ldt,",",i),"LogicalToTimeStamp") {
				d putval^%qaqpslx("v^METHOD:"_$p(ldt,",",i)_".LogicalToTimeStamp^^"_$p(larg,",",i)_"^")
				d create^%qaqpdt(val,"op",$p(ldt,",",i),,,,"LogicalToTimeStamp") 
				s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
				s $p($$$mtL(log),"^",3+i)=val,$p(larg,",",i)=val
			}
		}
	}
		#; At this point all values with Category DATE, MVDATE, or FMDATE should have an actual DATE, MVDATE, or FMDATE value.
	i 'find,lcat="MVDATE,DATE",narg=2 {				// DPV3451=
		If op="="      { s find=1,kind="oper",gcode="METHOD:%Collation.MVDEQDate",rev=0 }
		ElseIf op=">"  { s find=1,kind="oper",gcode="METHOD:%Collation.MVDGTDate",rev=0 }
		ElseIf op="'<" { s find=1,kind="oper",gcode="METHOD:%Collation.MVDGEDate",rev=0 }
		ElseIf op="<"  { s find=1,kind="oper",gcode="METHOD:%Collation.MVDLTDate",rev=0 }
		ElseIf op="'>" { s find=1,kind="oper",gcode="METHOD:%Collation.MVDLEDate",rev=0 }
		ElseIf op="'=" { s find=1,kind="oper",gcode="METHOD:%Collation.MVDNEDate",rev=0 }
	}
	i 'find,lcat="DATE,MVDATE",narg=2 {				// DPV3451=
		If op="="      { s find=1,kind="oper",gcode="METHOD:%Collation.MVDEQDate",rev=1 }
		ElseIf op=">"  { s find=1,kind="oper",gcode="METHOD:%Collation.MVDLTDate",rev=1 }
		ElseIf op="'<" { s find=1,kind="oper",gcode="METHOD:%Collation.MVDLEDate",rev=1 }
		ElseIf op="<"  { s find=1,kind="oper",gcode="METHOD:%Collation.MVDGTDate",rev=1 }
		ElseIf op="'>" { s find=1,kind="oper",gcode="METHOD:%Collation.MVDGEDate",rev=1 }
		ElseIf op="'=" { s find=1,kind="oper",gcode="METHOD:%Collation.MVDNEDate",rev=1 }
	}
	i 'find,lcat="DATE,DATE",narg=2 {
			// If we have VAL <op> CURRENT_DATE, and VAL is category DATE, but not type %Date, and VAL's type has DateToLogical method defined, convert CURRENT_DATE to Logical Date for this date type
		if $p(ldt,",",1)'="%Library.Date",$$$VTRname($p(larg,",",2))="CURRENT_DATE" {
			if $$$comMemberDefined($p(ldt,",",1),$$$cCLASSmethod,"DateToLogical"),$$runnable^%qadadt($p(ldt,",",1),"DateToLogical") {
				do putval^%qaqpslx("v^METHOD:"_$p(ldt,",",1)_".DateToLogical^^"_$p(larg,",",2)_"^")
				do create^%qaqpdt(val,"op",$p(ldt,",",2),,,,"DateToLogical") 
				set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Date")
				set $p($$$mtL(log),"^",3+2)=val,$p(larg,",",2)=val
			}
		}
			// If we have CURRENT_DATE <op> VAL, and VAL is category DATE, but not type %Date, and VAL's type has DateToLogical method defined, convert CURRENT_DATE to Logical Date for this date type
		elseif $p(ldt,",",2)'="%Library.Date",$$$VTRname($p(larg,",",1))="CURRENT_DATE" {
			if $$$comMemberDefined($p(ldt,",",2),$$$cCLASSmethod,"DateToLogical"),$$runnable^%qadadt($p(ldt,",",2),"DateToLogical") {
				do putval^%qaqpslx("v^METHOD:"_$p(ldt,",",2)_".DateToLogical^^"_$p(larg,",",1)_"^")
				do create^%qaqpdt(val,"op",$p(ldt,",",1),,,,"DateToLogical") 
				set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Date")
				set $p($$$mtL(log),"^",3+1)=val,$p(larg,",",1)=val
			}
		}
	}
	i 'find,lcat="TIMESTAMP,TIMESTAMP",narg=2 {
			// If we have VAL <op> CURRENT_TIMESTAMP, and VAL is category TIMESTAMP, but not type %TimeStamp, and VAL's type has TimeStampToLogical method defined, convert CURRENT_TIMESTAMP to Logical TimeStamp for this date type
		if $p(ldt,",",1)'="%Library.TimeStamp",$$$VTRname($p(larg,",",2))="CURRENT_TIMESTAMP" {
			if $$$comMemberDefined($p(ldt,",",1),$$$cCLASSmethod,"TimeStampToLogical"),$$runnable^%qadadt($p(ldt,",",1),"TimeStampToLogical") {
				do putval^%qaqpslx("v^METHOD:"_$p(ldt,",",1)_".TimeStampToLogical^^"_$p(larg,",",2)_"^")
				do create^%qaqpdt(val,"op",$p(ldt,",",2),,,,"TimeStampToLogical") 
				set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
				set $p($$$mtL(log),"^",3+2)=val,$p(larg,",",2)=val
			}
		}
			// If we have CURRENT_TIMESTAMP <op> VAL, and VAL is category TIMESTAMP, but not type %TimeStamp, and VAL's type has TimeStampToLogical method defined, convert CURRENT_TIMESTAMP to Logical TimeStamp for this date type
		elseif $p(ldt,",",2)'="%Library.TimeStamp",$$$VTRname($p(larg,",",1))="CURRENT_TIMESTAMP" {
			if $$$comMemberDefined($p(ldt,",",2),$$$cCLASSmethod,"TimeStampToLogical"),$$runnable^%qadadt($p(ldt,",",2),"TimeStampToLogical") {
				do putval^%qaqpslx("v^METHOD:"_$p(ldt,",",2)_".TimeStampToLogical^^"_$p(larg,",",1)_"^")
				do create^%qaqpdt(val,"op",$p(ldt,",",1),,,,"TimeStampToLogical") 
				set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
				set $p($$$mtL(log),"^",3+1)=val,$p(larg,",",1)=val
			}
		}
	}
	i 'find,lcat="TIMESTAMP,MVDATE",narg=2 {				// DPV3451=
		if $$$VTRgetname($p(larg,",",1))="CURRENT_TIMESTAMP" {	// CURRENT_TIMESTAMP<op>MVDateval, convert CURRENT_TIMESTAMP to MVDATE
			do putval^%qaqpslx("v^CONVERT:%MV.Date^^"_$p(larg,",",1)_"^")
			do create(val,"op","%MV.Date",,,,"Convert")
			set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%MV.Date")
			set $$$mtLOperand1($$$mtL(log))=val
		}
		elseif op="="      { s find=1,kind="oper",gcode="METHOD:%Collation.TSEQMVDate",rev=0 }
		ElseIf op=">"  { s find=1,kind="oper",gcode="METHOD:%Collation.TSGTMVDate",rev=0 }
		ElseIf op="'<" { s find=1,kind="oper",gcode="METHOD:%Collation.TSGEMVDate",rev=0 }
		ElseIf op="<"  { s find=1,kind="oper",gcode="METHOD:%Collation.TSLTMVDate",rev=0 }
		ElseIf op="'>" { s find=1,kind="oper",gcode="METHOD:%Collation.TSLEMVDate",rev=0 }
		ElseIf op="'=" { s find=1,kind="oper",gcode="METHOD:%Collation.TSNEMVDate",rev=0 }
	}
	i 'find,lcat="MVDATE,TIMESTAMP",narg=2 {				// DPV3451=
		if $$$VTRgetname($p(larg,",",2))="CURRENT_TIMESTAMP" {	// MVDateVal<op>CURRENT_TIMESTAMP, convert CURRENT_TIMESTAMP to MVDATE
			do putval^%qaqpslx("v^CONVERT:%MV.Date^^"_$p(larg,",",2)_"^")
			do create(val,"op","%MV.Date",,,,"Convert")
			set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%MV.Date")
			set $$$mtLOperand2($$$mtL(log))=val
		}
		elseif op="="      { s find=1,kind="oper",gcode="METHOD:%Collation.TSEQMVDate",rev=1 }
		ElseIf op=">"  { s find=1,kind="oper",gcode="METHOD:%Collation.TSLTMVDate",rev=1 }
		ElseIf op="'<" { s find=1,kind="oper",gcode="METHOD:%Collation.TSLEMVDate",rev=1 }
		ElseIf op="<"  { s find=1,kind="oper",gcode="METHOD:%Collation.TSGTMVDate",rev=1 }
		ElseIf op="'>" { s find=1,kind="oper",gcode="METHOD:%Collation.TSGEMVDate",rev=1 }
		ElseIf op="'=" { s find=1,kind="oper",gcode="METHOD:%Collation.TSNEMVDate",rev=1 }
	}
	new dts
	if (lcat="DATE,TIMESTAMP")||(lcat="TIMESTAMP,DATE"){
		set dts=$select(lcat="DATE,TIMESTAMP":1,1:0)
	}
	i 'find,$d(dts),narg=2 {
		; we treat both cases "DATE,TIMESTAMP" and "TIMESTAMP,DATE" at the same time, we destinguish both cases using the variable dts
		if $$TSVSDATEOPT(op,log,dts,larg,m){
			; if we have a date field to be compared to a static timestamp expression, converting the date to a timestamp would slow down the query
			; notation used in the comments: d is the date and ts is a timestamp with D(ts) as a datepart and T(ts) is the time part
			n hval,dval,tval,delval,twoval,log1,log2,log3,log4,a,zeroval
			do putval^%qaqpslx("v^CONVERT:%Library.Horolog^^"_$p(larg,",",$s(dts:2,1:1))_"^")
			do create(val,"op","%Library.Horolog",,,,"Convert")
			set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Horolog")
			s hval=val
			; compute the date portion of a timestamp in the $h representation
			d putval^%qaqpslx("t^,")
			s delval=val
			d putval^%qaqpslx("v^PIECE^^"_hval_"^"_delval_"^^")
			do create(val,"op","%Library.Numeric",,,,"Convert")
			set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Numeric")
			s dval=val
			if ((",=,<,'<,"[(","_op_","))&& dts) || ((",=,>,'>,"[(","_op_","))&& (1-dts)) { ; only these cases require the computation of the time portion of a timestamp in the $h representation
				d putval^%qaqpslx("t^2")
				s twoval=val
				d putval^%qaqpslx("v^PIECE^^"_hval_"^"_delval_"^"_twoval_"^")
				do create(val,"op","%Library.Numeric",,,,"Convert")
				set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Numeric")
				s tval=val
			}
			if op="="{
				; (d EQ ts) <=> (d=D(ts)) AND (T(ts)=0)
				;	 log    <=>	   log1   AND   log2
				d putval^%qaqpslx("t^0") ; the time portion for a $h date will be zero. 
				s zeroval=val
				d putlog^%qaqpslx($$$mtL(log))
				s log1=val,$p($$$mtL(log1),"^",$s(dts:5,1:4))=dval
				d putlog^%qaqpslx("v^=^^"_tval_"^"_zeroval_"^")
				s log2=val
				s $$$mtL(log)="l^&^^"_log1_"^"_log2_"^"
				d:(($p($$$mtV($p(v,"^",4)),"^",2))="CURTS")||(($p($$$mtV($p(v,"^",5)),"^",2))="CURTS") error483
			}elseif (((op="'>")||(op=">")) && dts) || (((op="'<")||(op="<")) && (1-dts)) {
				; (d GT ts) <=> (d>D(ts))
				; (d LE ts) <=> (d<=D(ts))
				; (ts GE d) <=> (D(ts)>=d)
				; (ts LT d) <=> (D(ts)<d)
				set $p($$$mtL(log),"^",$s(dts:5,1:4))=dval
			} elseif (((op="'<")||(op="<")) && dts) || (((op="'>")||(op=">")) && (1-dts)) {
				n posw,poslog
				; (d GE ts) <=> (d>=D(ts)) AND ((d>D(ts)) OR (T(ts)=0))
				; (d LT ts) <=> (d<=D(ts)) AND ((d<D(ts)) OR (T(ts)>0))
				; (ts GT d) <=> (D(ts)>=d) AND ((D(ts)>d) OR (T(ts)>0))
				; (ts LE d) <=> (D(ts)<=d) AND ((D(ts)<d) OR (T(ts)=0))
				;	 log    <=>	   log1    AND (  log2    OR    log3  )
				;  	 log    <=>	   log1    AND           log4
				; define log1
				d putlog^%qaqpslx($$$mtL(log))
				s log1=val,$p($$$mtL(log1),"^",$s(dts:5,1:4))=dval
				s:(op="<") $$$mtLOperator($$$mtL(log1))="'>"
				s:(op=">") $$$mtLOperator($$$mtL(log1))="'<"
				; define log2
				d putlog^%qaqpslx($$$mtL(log1))
				s log2=val,$$$mtLOperator($$$mtL(log2))=$s(op="'<":">",op="<":"<",op=">":">",op="'>":"<",1:op) ; to be simplified 
				; define log3
				d putval^%qaqpslx("t^0") ; the time portion for a $h date will be zero. 
				s zeroval=val
				d putlog^%qaqpslx("v^"_$s(op="'<":"=",op="<":">",op=">":">",op="'>":"=",1:op)_"^^"_tval_"^"_zeroval_"^")
				s log3=val
				; define log4
				d putlog^%qaqpslx("l^!^^"_log2_"^"_log3_"^")
				s log4=val
				; define log
				s posw=$f("^"_$g($$$mtWhere(m)),"^"_log_"^")
				if posw { ; new top-level AND conditions
					s poslog=$l($p("^"_$g($$$mtWhere(m)),"^"_log_"^"))+1
					s $e($$$mtWhere(m),poslog,poslog+$l(log))=log1_"^"_log4_"^"
				} else {
					s $$$mtL(log)="l^&^^"_log1_"^"_log4_"^"
				}
				d:'($p($$$mtV($p(v,"^",5)),"^",2)="CURDATE")&&'($p($$$mtV($p(v,"^",4)),"^",2)="CURDATE") error483
			}
			s mt("dtsopt",m)=1
		} else {
			do putval^%qaqpslx("v^CONVERT:%Library.TimeStamp^^"_$p(larg,",",$s(dts:1,1:2))_"^")
			do create(val,"op","%Library.TimeStamp",,,,"Convert")
			set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
			set $p($$$mtL(log),"^",$s(dts:4,1:5))=val
			if '($p($$$mtV($p(v,"^",5)),"^",2)="CURDATE") && '($p($$$mtV($p(v,"^",4)),"^",2)="CURDATE") && (
			(((op="'<")||(op="<")) && dts) || (((op="'>")||(op=">")) && (1-dts)) || 
			(((op ="'=") || (op ="=")) && ((($p($$$mtV($p(v,"^",4)),"^",2))="CURTS") || (($p($$$mtV($p(v,"^",5)),"^",2))="CURTS"))) ) {
