	#;  the following have to be added to ^pre, checking $$$VTRname(-log)!
	i kind="expr" s $$$VTRname(-log)="expr:"_gcode QUIT
	i kind="method" s $$$VTRname(-log)="method:"_gcode QUIT
	#;  *** if not findopt, should also look for NOT(op)!
	QUIT  ;--- createlog
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
args	;  set narg,larg,ldt, uses v, process arguments recursively
	#;  also sets datatype for undeclared :var in binary operations
	#;  op is already defined as $p(v,"^",2)
	#;  v is already defined as $$$mtV(vtr) or $$$mtL(log)
	n arg
	s larg="",ldt=""
	for narg=0:1 {
		set arg=$p(v,"^",narg+4) quit:'arg
		if $e(v)="l" { set $p(larg,",",narg+1)=-arg do createlog(arg) continue  }
		set $p(larg,",",narg+1)=arg
		do createval(arg)
	}
	#; AK630 . s $p(ldt,",",narg+1)=$$$VTRgetdt(arg)
	QUIT:$e(v)="l"	// AK630
		#;  set datatype of :var in case :var<oper><expr>
		#;   AK562 = exclude "contains" ('[') operator, do IN
		#;   AK630 = exclude "FOR SOME" operator
		#;   DPV3170 = exclude ROUND operator
		#;   DPV3174 = exclude %STARTSWITH, "]", and %PATTERN - they should always be done as string operations
		#;   DPV3541 = exclude %MATCHES - they should always be done as string operations
	if $e(v)="v" {
		if narg=1 {
			if op="-"||(op="+") {
					#; We don't need this IMO.  Just because we have +/- operator, the argument to the operator does not have to be numeric.
					#; If this came from a pre-processed statement where we know the type of the literal we replaced, we are losing information
					#; about the original argument type!
				//do:$e($g($$$mtV($p(larg,",",1))))="x" dtset($p(larg,",",1),"%Library.Numeric")
			}
		} elseif narg=2 {
			if $case(op,"[":0,"%BARS":0,"FOR SOME":0,"ROUND":0,"%STARTSWITH":0,"]":0,"%PATTERN":0,"%MATCHES":0,"LIKE":0,"_":0,"TRUNCATE":0,"%WINDOW_ORDER":0,"%WINDOW_PARTITION":0,"DATETRUNC":0,"LIST":0,"LISTBUILD":0,"LISTDATA":0,"LISTFIND":0,"LISTFROMSTRING":0,"LISTGET":0,"LISTTOSTRING":0,"TOCHAR":0,"TODATE":0,"TOPOSIXTIME":0,"TOTIMESTAMP":0,"DATEPART":0,"DATENAME":0,:1),",+,-,*,/,\,#,"'[(","_op_","),(op'["CONVERT") { for narg=1,2 { do putvardt($p(larg,",",narg),$p(larg,",",3-narg)) }}
		} else {
				#; We have more than 2 arguments.
				#; For some functions, we want to find the best compatible type of non-variable arguments, and assign that type to the variables.
				#; For example, IFNULL(:var1, CURRENT_DATE, :var2), we want the type of var1 and var2 to be DATE, which matches the most compatible type of all the non variable arguments
			if op="IFNULL" { do putvardt($p(larg,",",1),$p(larg,",",2)),putvardt($p(larg,",",2),$p(larg,",",1)),putvardt($p(larg,",",2),$p(larg,",",3)),putvardt($p(larg,",",3),$p(larg,",",2)) }
		}
		
	}
		#;  set datatype of :var for IN operator
	i $e(v,1,5)="v^IN^" f arg=2:1:narg d putvardt($p(larg,","),$p(larg,",",arg))
	i $e(v,1,5)="v^IN^" f arg=2:1:narg d putvardt($p(larg,",",arg),$p(larg,","))
		#;  account for datatype changes by putvardt() (AK630)
	f arg=1:1:narg s $p(ldt,",",arg)=$$$VTRgetdt($p(larg,",",arg))
	QUIT  ;--- args
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	// Marked as PUBLIC, but putvardt is only called from this routine
putvardt(arg1,arg2,mlv,insupd=0) [mt] PUBLIC {
	#;  if arg1 is variable/const/op without a datatype, then assign
	#;  it the datatype of arg2 (or %Library.String if none)
	#;  If $g(mlv), then also copy whether it's a multi-line value
	#;  insupd is 1 when called for the transformation of inputput arguments with their cooresponding fields (DPV305*)
	RETURN:arg1=""  ;  *** This fixes INSERT-SELECT - should not be here!  ;  AK304, DPV2527= move up above AK630
	set:$e($$$mtV(arg1))="n" arg1=$p($$$mtV(arg1),"^",4)  ;  peek thru correlated expr	// AK630=
	set:$e($$$mtV(arg2))="n" arg2=$p($$$mtV(arg2),"^",4)  ;  ... or field			// AK630=
		#;  do it in 5 cases:  
		#;    <x><op><var> - <var> gets <x>.datatype;  and
		#;    <x><op><const> - <const> gets <x>.datatype    and
		#;    <field><op>%ODBCIN(<y>) - %ODBCIN(<y>) gets <field>.datatype   and
		#;    <field><op>CURTS - CURTS get <field>.datatype if <field>.category is FMTIMESTAMP or POSIXTS
		#;    <field><op>CURDATE - CURDATE get <field>.datatype if <field>.category is FMDATE OR MVDATE OR POSIXTS
	if $$$VTRgettype(arg1)'="var",$$$VTRgettype(arg1)'="const",$$$VTRgettype(arg1)'="op" { RETURN }
	if $$$VTRgettype(arg1)="op" {
		set ok=0
		if $$$VTRgetname(arg1)="%ODBCIN",$$$VTRgettype(arg2)="field" { set ok=1 }
		if $$$VTRgetname(arg1)="CURRENT_TIMESTAMP",$case($$$VTRgetcat(arg2),"FMTIMESTAMP":1,"POSIXTS":1,:0) { set ok=1 }
		if $$$VTRgetname(arg1)="CURRENT_DATE",$case($$$VTRgetcat(arg2),"FMDATE":1,"MVDATE":1,"POSIXTS":1,:0) { set ok=1 }
		if $$$VTRgetname(arg1)="CURRENT_TIMESTAMP",$$$VTRgetcat(arg2)="TIMESTAMP" { set ok=1 }
		if $$$VTRgetname(arg1)="CURRENT_DATE",$$$VTRgetcat(arg2)="DATE" { set ok=1 }
		if $$$VTRgetname(arg1)="%EXACT" { set ok=(",var,const,op,"[(","_$$$VTRgettype($p($$$mtV(arg1),"^",4))_",")) }
		RETURN:'ok
	}
	do copydt(arg1,arg2)	// AK630
	do:$$$VTRgetname(arg1)="%EXACT" copydt($p($$$mtV(arg1),"^",4),arg2)  ;  AK1087
	set:$g(mlv) $$$VTRIsLF(arg1)=$$$VTRgetIsLF(arg2),$$$VTRLFDel(arg1)=$$$VTRgetLFDel(arg2),$$$VTRLFStorage(arg1)=$$$VTRgetLFStorage(arg2)
	RETURN  ;--- putvardt
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
exist(%this)  ;  whether such object exists
	RETURN ''$d($$$mtVtr(%this))  ;--- $$exist
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
copydt(%this,%that)  ;  copy %that's datatype (if not empty) to %this, (AK360)
		#;  Also set the ifn/irn from %that to %this - This is needed so we
		#;  can acquire the proper type parameters later when doing conversions
		#;  for this const/var/op value based on the corresponding field's type
	set $$$VTRirn(%this)=$$$VTRgetirn(%that)
	set $$$VTRifn(%this)=$$$VTRgetifn(%that)
	RETURN:$$$VTRgetdt(%that)=""  ;  %this might already have a better value!
	do dtset(%this,$$$VTRgetdt(%that))
		#; Now see if we have any "n" values that reference %this and update its type too
    new v
    for v=1:1:$$$maxv {
        if $e($g($$$mtV(v)))="n",$p($$$mtV(v),"^",4)=%this { do dtset(v,$$$VTRgetdt(%this)) }
    }
	RETURN  ;--- copydt
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
NumericOrDouble(%this,%that,len,prec,scale) [info,mt] PRIVATE {	// DPV3173=
		#; Define %this as a DOUBLE if %that is a DOUBLE, otherwise as a NUMERIC
	if $$$VTRgetdt(%that)="%Library.Float" { d dtset(%this,"%Library.Float") QUIT }
	set thatType=$$$GetOdbcTypeNumber($$getodbc($$$VTRgetdt(%that)))	// thatType is now ODBC datatype number
	if thatType=8 { 
		do dtset(%this,"%Library.Double")
		set:info $$$VTRomsinfo(%this)=$$definfo^%qaqpif2("%Library.Double",len,prec,scale)
		RETURN
	}
	do dtset(%this,"%Library.Numeric")
	set:info $$$VTRomsinfo(%this)=$$definfo^%qaqpif2("%Library.Numeric",len,prec,scale)
	RETURN
}
.
/// This is called for arithmetic operators to determine the best type to report for the operator
///	If arg1 or arg2 are a double, report the op as double
///	Otherwise, report the op as numeric
///     Note this logic is not nearly as comprehensive as the logic in %qaqpif2.
///	The important thing here is to get the type as accurate as we can (it was reporting %String).
///	We will try to get the SCALE as correct as possible for the LogicalToDisplay method.
///	For Dynamic SQL this is tough at this time because literals are converted to host variables and we lose the type information.
NumericOrDouble2(pVal,pArg1,pArg2,pOp) [info,mt] PUBLIC {
	if pArg2="" {		// Unary + or - or TO_NUMBER(xepr)
		if $$$VTRgetdt(pArg1)="%Library.Float" { 
			do dtset(pVal,"%Library.Float")
			set:info $$$VTRomsinfo(pVal)=$$definfo^%qaqpif2("%Library.Float")
			RETURN
		}
		set tArg1Type=$$$GetOdbcTypeNumber($$getodbc($$$VTRgetdt(pArg1)))	// pArg1Type is now ODBC datatype number
		if tArg1Type=8 { 
			do dtset(pVal,"%Library.Double")
			set:info $$$VTRomsinfo(pVal)=$$definfo^%qaqpif2("%Library.Double")
			RETURN
		}
		do dtset(pVal,"%Library.Numeric")
		if pOp="+"||(pOp="-") {		// Unary + and - and TO_NUMBER(expr)
			set tPrecision="",tScale=""
			if ",-6,-5,4,5,9,"[(","_tArg1Type_",") {	// Arg is INT type
				set tPrecision=$$$VTRgetprecision(pArg1),$$$VTRprecision(pVal)=$$$VTRgetprecision(pArg1)
				set tScale=0,$$$VTRscale(pVal)=0
				set:info $$$VTRomsinfo(pVal)=$$definfo^%qaqpif2("%Library.Numeric",,36,0)
			} elseif tArg1Type=12 {	// Converting a string to a numeric, use large precision/scale to avod data truncation
				set tPrecision=36,$$$VTRprecision(pVal)=36
				set tScale=17,$$$VTRscale(pVal)=17
				set:info $$$VTRomsinfo(pVal)=$$definfo^%qaqpif2("%Library.Numeric",36,36,10)
			} else {  // Convertion other types to numeric
				set:$$$VTRgetprecision(pArg1)'="" tPrecision=$$$VTRgetprecision(pArg1),$$$VTRprecision(pVal)=$$$VTRgetprecision(pArg1)
				set:$$$VTRgetscale(pArg1)'="" tScale=$$$VTRgetscale(pArg1),$$$VTRscale(pVal)=$$$VTRgetscale(pArg1)
			}
			set:info $$$VTRomsinfo(pVal)=$$definfo^%qaqpif2("%Library.Numeric",tPrecision,tPrecision,tScale)
		}
		RETURN
	}
	if $$$VTRgetdt(pArg1)="%Library.Float"||($$$VTRgetdt(pArg2)="%Library.Float") { 
		d dtset(pVal,"%Library.Float")
		set:info $$$VTRomsinfo(pVal)=$$definfo^%qaqpif2("%Library.Float")
		RETURN
	}
	set tArg1Type=$$$GetOdbcTypeNumber($$getodbc($$$VTRgetdt(pArg1)))	// pArg1Type is now ODBC datatype number
	set tArg2Type=$$$GetOdbcTypeNumber($$getodbc($$$VTRgetdt(pArg2)))	// pArg2Type is now ODBC datatype number
	if tArg1Type=8||(tArg2Type=8) { 
		d dtset(pVal,"%Library.Double")
		set:info $$$VTRomsinfo(pVal)=$$definfo^%qaqpif2("%Library.Double")
		RETURN
	}
	d dtset(pVal,"%Library.Numeric")
		#; Try to find an accurate SCALE
	set tScale=17	// by default use a scale of 17, including the '/' operator
	set tPrecision=""
	if pOp="+"||(pOp="-")||(pOp="*") {		// For +,- the scale will be max(scale1, scale2)
		if ",-6,-5,4,5,9,"[(","_tArg1Type_","),",-6,-5,4,5,9,"[(","_tArg2Type_",") { set tScale=0 }	// Both args are INT types
		else { 
			if pOp="*" { set tScale=$$add($$$VTRgetscale(pArg1),$$$VTRgetscale(pArg2),tScale) }
			else { set tScale=$$max($$$VTRgetscale(pArg1),$$$VTRgetscale(pArg2),tScale) }
		}
	}
	elseif pOp="\"||(pOp="#") { set tScale=0 }		// For \,# the scale will be 0
	elseif pOp="/" {
			#; For / the precision will be prec1 - scale1 + scale2 + max(6, scale1 + prec2 + 1)
		set tPrecision = $$$VTRgetprecision(pArg1) - $$$VTRgetscale(pArg1) + $$$VTRgetscale(pArg2) + $$max(6,$$$VTRgetscale(pArg1)+$$$VTRgetprecision(pArg2)+1)
			#; For / the scale will be max(6, scale1 + prec2 + 1)
		set tScale=$$max(6,$$$VTRgetscale(pArg1)+$$$VTRgetprecision(pArg2)+1)
	}
	set:tScale>17 tScale=17
	set $$$VTRscale(pVal)=tScale
	set:tPrecision>36 tPrecision=36
	set $$$VTRprecision(pVal)=tPrecision
	set:info $$$VTRomsinfo(pVal)=$$definfo^%qaqpif2("%Library.Numeric",36,36,17)
	RETURN
}
.
UseBestCompatibleType(%this,vlist,funcName) ;  copy the best compatible type's datatype (if not empty) to %this,
	#;  Also set the ifn/irn from bct to %this - This is needed so we
	#;  can acquire the proper type parameters later when doing conversions
	#;  for this const/var/op value based on the corresponding field's type
		#; vlist is a ',' list of values
		#; Given this list of values, return the val# of the value with the best compatibile datatype of all the types of the values in the list
	new allString,bct,firstType,i,retval,t1,t2,thisType,val,vinfo
	set t1(8)=6,t1(2)=5,t1(-5)=4,t1(4)=3,t1(5)=2,t1(-6)=1,t1(-99)=0,bct="",firstType="",retval=+vlist,allString=1
	for i=1:1 {
		set val=$p(vlist,",",i) quit:val=""
		set thisType=$$$VTRgetdt(val) continue:thisType=""
		set thisType=$$$GetOdbcTypeNumber($$getodbc(thisType))	// thisType is now ODBC datatype number
		set vinfo=$g($$$mtV(val))
		set:thisType'=12 allString=0
		if vinfo="t^" { set thisType=-99 }
		elseif $p(vinfo,"^",1,2)="v^%EXACT",$g($$$mtV($p(vinfo,"^",4)))="t^" { set thisType=-99 }
		if firstType="" { set (bct,firstType)=thisType,retval=val continue }  // First item in list
		if $case(firstType,-6:1,-5:1,2:1,4:1,5:1,8:1,-99:1,:0),$case(thisType,-6:1,-5:1,2:1,4:1,5:1,8:1,-99:1,:0) { set:t1(thisType)>t1(bct) bct=thisType,retval=val continue }	// Numeric types and null
		if bct'=thisType,'allString { new null1,null2 set null1=0,null2=0 set:bct=-99 bct=12,null1=1 set:thisType=-99 thisType=12,null2=1 set retval="",t1=$$$GetOdbcTypeName(bct)_$s(null1:" (NULL)",1:""),t2=$$$GetOdbcTypeName(thisType)_$s(null2:" (NULL)",1:"") do error(378) }
		if firstType'=thisType,firstType'=-99,thisType'=-99,'allString { set retval="",t1=$$$GetOdbcTypeName(firstType),t2=$$$GetOdbcTypeName(thisType) do error(378) }
	}
	set $$$VTRirn(%this)=$$$VTRgetirn(retval)
	set $$$VTRifn(%this)=$$$VTRgetifn(retval)
	RETURN:$$$VTRgetdt(retval)=""  ;  %this might already have a better value!
	do dtset(%this,$$$VTRgetdt(retval))
	RETURN  ;--- UseBestCompatibleType
.
UseBestCompatibleTypeAll(%this,vlist,funcName) ;  copy the best compatible type's datatype (if not empty) to %this,
	#;  Also set the ifn/irn from bct to %this - This is needed so we
	#;  can acquire the proper type parameters later when doing conversions
	#;  for this const/var/op value based on the corresponding field's type
		#; vlist is a ',' list of values
		#; Given this list of values, return the val# of the value with the best compatibile datatype of all the types of the values in the list
		#; Datatype precedense is defined as:
		#;  LONGVARBINARY LONGVARCHAR VARBINARY VARCHAR GUID TIMESTAMP DOUBLE NUMERIC BIGINT INTEGER POSIXTIME DATE TIME SMALLINT TINYINT BIT
		#; if op is 'CASE', then if there are types that don't interact correctly, throw error
		#; for example. if 
	new i,val,bct,bestprec,bestscale,firstType,retval,t1,t2,thisType,caseTypeList
	set t1(-4)=16,t1(-1)=15,t1(-3)=14,t1(12)=13,t1(-11)=12,t1(11)=11,t1(8)=10,t1(2)=9,t1(-5)=8,t1(4)=7,t1(1093)=6,t1(9)=5,t1(10)=4,t1(5)=3,t1(-6)=2,t1(-7)=1,t1(-99)=0,bct="",firstType="",retval=+vlist,bestprec="",bestscale="",caseTypeList=","
	for i=1:1 {
		set val=$p(vlist,",",i) quit:val=""  
		set thisType=$$$VTRgetdt(val) continue:thisType=""
		set thisType=$$$GetOdbcTypeNumber($s($$checkDataType^%apiDDL2(thisType,$lb("%Library.PosixTime")):"POSIXTIME",1:$$getodbc(thisType)))	// thisType is now ODBC datatype number
		set:$g($$$mtV(val))="t^" thisType=-99
		if op="CASE" {
			if caseTypeList'[(","_thisType_","),thisType'=-99 {
				set caseTypeList=caseTypeList_thisType_","
			}
			if '$$checkCaseExpressionTypes(thisType,caseTypeList) {
				set %msg="Invalid combination of data types in CASE value expressions" s t1=$s(firstType=1093:"POSIXTIME",1:$$$GetOdbcTypeName(firstType)), t2=$s(thisType=1093:"POSIXTIME",1:$$$GetOdbcTypeName(thisType)) do error(378) RETURN
			}
		}
		if firstType="" set (bct,firstType)=thisType,retval=val continue  // First item in list
		if t1(thisType)>t1(bct) {
			set bct=thisType,retval=val
			if bct=2 {
				if $$$VTRgetprecision(val)>bestprec { set bestprec=$$$VTRgetprecision(val) }
				if $$$VTRgetscale(val)>bestscale { set bestscale=$$$VTRgetscale(val) }
			}
		}
		continue
	}
	if retval=-99 { do dtset(%this,12) RETURN }	// All values are NULL, use VARCHAR
	set $$$VTRirn(%this)=$$$VTRgetirn(retval)
	set $$$VTRifn(%this)=$$$VTRgetifn(retval)
	QUIT:$$$VTRgetdt(retval)=""  ;  %this might already have a better value!
	do dtset(%this,$$$VTRgetdt(retval))
	if $$$VTRgetcat(%this)="NUMERIC" {
		set:bestprec $$$VTRprecision(%this)=bestprec
		set:bestscale $$$VTRscale(%this)=bestscale
	}
	RETURN  ;--- UseBestCompatibleTypeAll
.
/// Check whether a given type can be mixed in with the other types
/// of a CASE expression's value expressions (return values). For example,
/// a CASE expression should not mix a TIME value expression with a SMALLINT, as
/// the latter will be converted/reported to xDBC clients as though it were the former
/// even though they are not interchangeable.
///
/// INPUTS: 
///		'type' - ODBC type number that we want to check the validity of, e.g. 4 for integer
///		'typeList' - comma-delimited list of types, e.g. ',4,2,' for a CASE expression with integers and numerics
///		NOTE: a type number is only appended if not already represented, i.e. ',4,2,' is the same whether 
///		there's 1 integer value expression or 5
/// RETURN: 1 if types can be mixed, 0 if not
checkCaseExpressionTypes(type, typeList) [mt] {
	RETURN:type=-99 1 // NULL combines with everything
	set commaDelimitedType = ","_type_","
.
	if ",-4,-1,9,10,1093,"[commaDelimitedType { // all value expressions should be same type
		RETURN commaDelimitedType = typeList
	} elseif ",-11,-3,"[commaDelimitedType { // GUID and VARBINARY are compatible with GUI VARBINARY and VARCHAR
		RETURN typeList?.(1",-3",1",-11",1",12")1","
	} elseif commaDelimitedType=",11," { // timestamp and varchar compatible
		RETURN typeList?.(1",12",1",11")1","
	} elseif commaDelimitedType=",12," { // varchar and timestamp compatible
		RETURN typeList?.(1",-7",1",-6",1",-5",1",2",1",4",1",5",1",8",1",12",1",11")1","
	} elseif ",-7,-6,-5,2,4,5,8,"[commaDelimitedType { // numeric types/bit compatible
		RETURN typeList?.(1",-7",1",-6",1",-5",1",2",1",4",1",5",1",8",1",12")1","
	}
.
	RETURN 0
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
TSVSDATEOPT(op,log,dts,larg,m) [mt] PUBLIC{
	QUIT:'(",=,<,'<,>,'>,"[(","_op_",")) 0 ; only sargeable operators will benefit from the transform
	QUIT:'$f("^"_$g($$$mtWhere(m)),"^"_log_"^") 0 ; optimization is safe for WHERE clause conditions. ON-clause conditions need a special treatment 
	s vdate=$$$mtV($p(larg,",",$s(dts:1,1:2)))
	QUIT:$e(vdate)="f" 1 ; if the %Date expression is a field, and the above conditions are satisifed, do the optimization!
	QUIT 0
}
.
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dtset(%this,%val)  ;  SET method for dt - also sets cat and vectype
	RETURN:%this<0  ;  for log
		;  RETURN:%val=""
	set $$$VTRdt(%this)=%val
		;  *** should check when is this possible %val=""
	set $$$VTRcat(%this)=$$getcat(%val)  ;  *** only if %val'=""
	set $$$VTRvectype(%this)=$$vtcat($$$VTRgetcat(%this))  ;  AK1067
	RETURN  ;--- dtset
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
vtcat(cat)  ;  $$: vector type for a given category  ;  AK1067
	RETURN $case(cat,"INTEGER":"integer","DATE":"integer","NUMERIC":"decimal","TIME":"decimal","DOUBLE":"double","POSIXTS":"timestamp",:"string")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;                      Datatype of host variable
getdtvar(val,mlv)  ;  $$:  return the dt of a host variable/"?"
		#;  return in .mlv (by reference) whether a multi-line value
	set mlv=($$$VTRgetIsLF(val)="Y")
	RETURN $$$VTRgetdt(val)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	/// Given a and b, return the greater value as long as both values are non-NULL
max(a,b,nullReturn="") [] PUBLIC { RETURN:a=""||(b="") nullReturn RETURN:a>b a RETURN b }
	/// Given a and b, return value of a+b as long as both values are non-NULL
add(a,b,nullReturn="") [] PUBLIC { RETURN:a=""||(b="") nullReturn RETURN a+b }
error483
	new dateName,tsName
    set dateName=$$val^%qaqplan($p(larg,",",$s(dts:1,1:2))),tsName=$$val^%qaqplan($p(larg,",",$s(dts:2,1:1))),mt("IBA053",log)=$lb(dateName,tsName)
	do:$$$PreventNewDateVsTimestampComparisons&&(%caller'["ShowPlan")&&(%caller'="") error(483)
error(e) g ^%qaqperr
---
