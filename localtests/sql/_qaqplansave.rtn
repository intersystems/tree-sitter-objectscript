====
qaqplansave
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqplansave^MAC^^^0
%qaqplansave	// Utilities for saving and restoring query plans
	;; COMPONENTS :: SQL/Optimizer
	#;
#INCLUDE %msql
#INCLUDE %qaqplex
#include %sqlEngineObjs
#IF 0   ;-------------------------------------------------------------
 ; Description:   Utilities for saving and restoring query plans
 ; Author:        Paul V. Allen
 ; Date:          May 2015
 ;
 ;  JSL5087 (05/17/2017) - RTPC outlier support
 ;  PVA353  (03/25/2016) - Fix saving of validation information for unqualified arrow refs in stored plan dictionaty 
 ;  PVA351  (03/18/2016) - Check SetMapSelectability as part of map validation for a frozen plan. 
 ;  PVA344  (01/19/2016) - Fix : <UNDEFINED>hiloop+3^%qaqchi when using certain frozen plans 
 ;  PVA339  (10/27/2015) - Ignore virtual OR field when saving plans 
 ;  PVA331  (09/06/2015) - Support %nofplan directive, display whether a shown plan is frozen, and various other frozen plan changes 
 ;  PVA329  (08/25/2015) - Use new loadgetirn with metadata argument, support saving plans without generating code 
 ;  PVA320  (05/10/2015) - Initial Query Plan save/use facility 
 ;-------------------------------------------------------------
 ;                       I N F O R M A T I O N
 ;-------------------------------------------------------------
 ;
 ;  Only plans, no information.
 ;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
SavePlan() [] PUBLIC
{  d SavePlanar(.myary)
   s pno=$i(^fplan)
   merge ^fplan(pno)=myary 
.
}
	// Called from %qaqqt
SavePlanar(strary,encode=1) [pdict,mt,mts,mcurs,mtc,mtag,ojfilter,omscost,sql] PUBLIC { //encode: use base64 encoding
	set pdict("version")=1
	if $case($$$mtStatementType,"DEL":1,"UPD":1,"INS":1,"DEC":1,:0) { set pdict("mcurs")=mcurs merge pdict("mtc")=mtc(mcurs) }
		//if $g(mtag)]"" {s pdict("mtag")=mtag}
	if $g(omscost)]"" { set pdict("omscost")=omscost }
	set str=""
	for {	// Save fully qualified base table names and corresponding irns required by the saved asl etc.
		s str=$o($$$mtR(str)) q:str=""  
		if '$d($$$mtRVirtual(str)) {	// base table or TVF (including linked tables)
			CONTINUE:$g($$$FTFakeStream(str))	// fake stream created for foreign tables
			s irn=$$$mtRIrn($$$mtR(str)) continue:'irn
			s istvf=$g($$$mtTvfParams(str)) s:istvf]"" istvf=$c(0) // we don't really care about the real arg; this convention means function, but no args
			s iqn=$$$smdGetIqnFromIrn(irn) // This works for TVFs
			if istvf { s parent="" }
			else { s parent=$$$smdParentTable(1,irn) } // PVA355: save parent info
			set pdict("tbl",iqn)=$lb(irn,istvf,parent,$$$smdSharded(1,irn))
			if $$$smdSharded(1,irn) { // JMM1136+
				s pdict("tbl",iqn)=pdict("tbl",iqn)_$lb($$$smdShardKey(1,irn),$$$smdShardMapOwner(1,irn))
			} // JMM1136-
		}
	}
		#; Also, for $$$mtTarget -> mtc(mcurs) for INS/UPD/DEL
	set irn=""
	if mcurs { s irn=$p($g(mtc(mcurs,"f")),",",2) }
	if irn {
		set iqn=$$$smdGetIqnFromIrn(irn) 
		set pdict("tbl",iqn)=$lb(irn,"",$$$smdParentTable(1,irn),$$$smdSharded(1,irn)) // PVA355: save parent info
		if $$$smdSharded(1,irn) { // JMM1136+
			s pdict("tbl",iqn)=pdict("tbl",iqn)_$lb($$$smdShardKey(1,irn),$$$smdShardMapOwner(1,irn))
		} // JMM1136-
	}
		#; PVA356: view references may have left incomplete pdict tbl entries. Complete them now.
	set iqn=""
	for {
		set iqn=$o(pdict("tbl",iqn),1,info) q:iqn=""
		if info="" {
			set irn=$$$smdGetIrn(iqn),iqnstd=$$$smdGetIqnFromIrn(irn) 
			kill:iqn'=iqnstd pdict("tbl",iqn)
			set pdict("tbl",iqnstd)=$lb(irn,"","",$$$smdSharded(1,irn))
			if $$$smdSharded(1,iqnstd) { // JMM1136+
				s pdict("tbl",iqnstd)=pdict("tbl",iqn)_$lb($$$smdShardKey(1,irn),$$$smdShardMapOwner(1,irn))
			} // JMM1136-
		}
	}
	set val=""
	for {
		set val=$o($$$mtV(val),1,vinfo) quit:val=""
			#; Note: we skip the ifind dummy fields in mt("filter")
		if $e(vinfo)="f" {
			s str=$p(vinfo,"^",2) continue:$d($$$mtRVirtual(str))  continue:$g($$$FTFakeStream(str))
			s ifn=$p(vinfo,"^",3) continue:$d($$$mtFilter(ifn))  continue:$d($$$mtVirtualOrFields(ifn)) // PVA339: ignore "vor" field
			s irn=$$$mtRIrn($$$mtR(str))
			s irn2 = $$$smdGetIrnFromIfn(+ifn)
			if irn'=irn2 {	// This should only happen for parent idkey fields added for child tables during asl construction
				s irn=irn2
				s iqn=$$$smdGetIqnFromIrn(irn) // This works for TVFs
				set pdict("tbl",iqn)=$lb(irn,"",$$$smdParentTable(1,irn),$$$smdSharded(1,irn)) // PVA355: save parent info
				if $$$smdSharded(1,irn) { // JMM1136+
					s pdict("tbl",iqn)=pdict("tbl",iqn)_$lb($$$smdShardKey(1,irn),$$$smdShardMapOwner(1,irn))
				} // JMM1136-
			}
				#; Per createval setup, usages from vtr rather than smd, not derived from other info
				#;    type,collation(implicitly sensitive to change),scale,
				#;  PVA355: Add save of referenced table information
			s pdict("fld",irn,$$$smdGetFieldName(+ifn))=$lb(+ifn,$$GetType^%qadfld2(irn,+ifn),$$$smdColCollation(1,irn,+ifn),$p($g($$$smd(8,+ifn)),$c(1),5),$$$smdColListCollection(1,irn,+ifn),$$$smdColListType(1,irn,+ifn),$$$smdColListDelimiter(1,irn,+ifn),$$$smdColReferencedTable(1,irn,+ifn) )
		}
	}
		#; insert ... select might have cases where there are ifn/fields referenced in mt("vtr"), but they are not in mt("v").
		#; This can lead to mt()/$$$smd ifn mis-matches if we do not record their info in pdict
		#; Note, I have not investigated if all types of queries might have this issue.  So far, I have only seen it for insert ... select.  
		#; I don't want to change all queries because this will lead to different frozen plans and I would rather the plans stay the same for most statements.
	if $$$mtStatementType="INS" {
		set val=""
		for {
			set val=$o($$$mtVtr(val),1,vinfo) quit:val=""
			if $$$VTRgetifn(val) {
				set irn=$$$VTRgetirn(val)
				continue:'$$$smdTType(irn)	// Probably a virtual table
				set iqn=$$$BuildIQN($$$smdSchema(1,irn),$$$smdName(1,irn))
				if '$d(pdict("tbl",iqn)) { 
					set pdict("tbl",iqn)=$lb(irn,"",$$$smdParentTable(1,irn),$$$smdSharded(1,irn))
					if $$$smdSharded(1,irn) { // JMM1136+
						s pdict("tbl",iqn)=pdict("tbl",iqn)_$lb($$$smdShardKey(1,irn),$$$smdShardMapOwner(1,irn))
					} // JMM1136-
				}
				set ifn=+$$$VTRgetifn(val)
				continue:$d($$$mtVirtualOrFields(ifn))  	// Virtual OR field
				continue:$d($$$mtFilter(ifn))	// adhoc computd field
				if '$d(pdict("fld",irn,$$$smdGetFieldName(ifn))) {
					set pdict("fld",irn,$$$smdGetFieldName(ifn))=$lb(ifn,$$GetType^%qadfld2(irn,ifn),$$$smdColCollation(1,irn,ifn),$p($g($$$smd(8,ifn)),$c(1),5),$$$smdColListCollection(1,irn,ifn),$$$smdColListType(1,irn,ifn),$$$smdColListDelimiter(1,irn,ifn),$$$smdColReferencedTable(1,irn,ifn) )
				}
.
			}
		}
	}
	set maps=$$findmaps() // Record map info
	for i=1:1:$ll(maps) {
		continue:$d(mt("filterm",$li(maps,i)))  // mt("filterm",<imp>) defines dummy ifind maps that are not in SMD and don't have any plausible validation.
		continue:$g($$$FTimpFromFakeStream($li(maps,i))) // fake map for a foreign stream created for foreign tables
		if $d(mt("smdimp",$li(maps,i)),impmap) {  // collection index usage
			set maps=maps_$lb(impmap),pdict("map",$$$smdMapName(impmap),$$$smdGetIqnFromIrn($$$smdMapIrn(impmap)))=impmap
		} else {
			set pdict("map",$$$smdMapName($li(maps,i)),$$$smdGetIqnFromIrn($$$smdMapIrn($li(maps,i))))=$li(maps,i)
		}
	}
		#; no need to record map subscript info, because for the used maps, that can validated via mts. 
.
		#; Save information for SELECT * validation
		#; Don't care about views or FROM subqueries because 
		#; any change to view must reject fplan, that detected elsewhere,
		#;  and * applied to FROM subquery has no relevance to schema change
		#; For compactness, it might be nice to save ifn's, but we only arrange for recreation of ifn values
		#;   for fields used in the query. It is quite possible (e.g. view output optimization) for a 
		#;   SELECT * field not to end up being used. Yet changes can still affect the validation. Consider, as 
		#;   an example, the change of field from being not hidden to hidden. Its direct use in the parse tree 
		#;   remains valid, however, if it were selected from a subquery that used SELECT *, you would have a 
		#;   case where the query without frozen plan produces an error while the frozen plan would work. I 
		#;   define such behavior changes to require invalidating the frozen plan. 
	set irn=""
	for {
		set irn=$o(mt("starbase",irn)) q:irn=""
		merge pdict("*",irn)=mt("starbase",irn)
	}
	kill mt("starbase") // don't save extra garbage; ultimately, need to do much pruning if mt() which has
.
		#; become more and more of garbage dump for temparary information
		#; Save information to re-check unqualified table names
		#; ==> This validation is done for any names that use schema path, e.g. Tvfs, views, tables.
		#; pdict("unqtbl",<unqualified table name as parsed>)=<name as finalized by ddtab>
	merge pdict("unqtbl")=mt("pdunqtbl") 
	kill mt("pdunqtbl")
		#; NOTE: Checking schema path is pointless. Suppose name1 resolved to the second schema in path before, but a
		#;       another table of same name now added to first path on schema list. MUST check 
		#;       actual resolution against the schema path. As a result, there is no need to remember or
		#;       validate the schema path per se.
.
		#; Similarly for unqualified function invocations
	merge pdict("unqfunc")=mt("pdunqfunc")
	kill mt("pdunqfunc")
.
		#; Gather information to validate meaning of unqualified column references
		#; ==>Based on issues/discussion under views, the only things needed here are irn's for base tables and TVFS.
		#;     Thus, the following is sufficient. 
	merge pdict("unqcol")=mt("pdunqcol")
	kill mt("pdunqcol")
	set fname=""
	for {
		set fname=$o(pdict("unqcol",fname)) q:fname=""
		set iqn=""
		for {
			set iqn=$o(pdict("tbl",iqn),1,tbinfo) q:iqn=""
			set irn=$li(tbinfo)
			set ifn=$$$smdGetIfn(1,irn,fname)
			if ifn { set pdict("unqcol",fname)=pdict("unqcol",fname)_$lb(irn)}
		}    // validation will ensure that a given uqualified column exists for exactly the same set of irns as at plan save time
	}
.
		#; ==> Information for validiating pseudocolumns resolve the same way is stored directly in pdict by 
		#;     by column^%qaqpsql when saveplan flag is active.
		   
		#; Similarly (but not identically) for unqualified arrow references:
		#;    Save all base table irns containing ref as either reference field or child table, 
		#;      with indicator as to which. If both, we don't store the irn (a reference resolving to this
		#;      irn would produce an ambiguity error). Similarly, on validation, we treat finding as both as
		#;      equivalent to not found. What we are saying here is that if a table the unqref couldn't have 
		#;      resolved to changes from have nothing relevant (would have produced not found error) to
		#;      having both (ambiguity error), we don't care. 
	merge pdict("unqref")=mt("pdunqref") k mt("pdunqref")
	set rname=""
	for  {
		set rname=$o(pdict("unqref",rname)) q:rname=""
		set iqn=""
		for {  // PVA353: fix missing loop level
			set iqn=$o(pdict("tbl",iqn),1,tbinfo) q:iqn=""
			set irn=$li(tbinfo)
			set idb=$$$smdRowIDLogicalFields(1,irn),idifn=$$$smdRowIDField(1,irn)
			set ifn=$$$smdGetIfn(1,irn,rname)
			if ifn=idifn,idb]"",idb'["," { set ifn=idb } // allow ID to be used as a reference if it is based on a single field which is a reference 
			if $g($$$smd(1,irn,23))[("^"_ifn_",") { set isref=1 } else { set isref=0 }
			set kids=$$$smdKids(1,irn),iskid=0
			for i=1:1:$ll(kids) { if $tr(rname,".",$c(2))=$$$UPPER($p($li(kids,i),".",2)) { set iskid=1 quit }}
			continue:isref=iskid
			set pdict("unqref",rname)=pdict("unqref",rname)_$lb(irn)
		}
	}
	if $d(ojfilter) { merge pdict("ojfilter")=ojfilter }
	
		#; We will need to validate field refs not stored in mt("v") in updating statements.
	
	
		#; How to computed fields, e.g. are they still available in the same maps? SMD doesn't provide this (?)
		#;    directly. Must derive, as done in qo1. 
		#;==> ALSO: maps fields available in; If was available in a USED map before, it must still be.    
.
		#; Userdefined functions: We do no validation. There is no SMD to set up for them. All information
		#;      needed to code generate for them is in mt(),asl(). If one is dropped, a compile time error
		#;      in a routine without frozen plan becomes a run time error - compiling the frozen plan doesn't 
		#;      notice it is missing. This seems  ok - the run time error is descriptive: <class does not exist>. 
   
   
		#; Detect view definition changes. Direct approach: store hash view class query + viewschema
		#;   and validate on fplan usage. 
.
		#; TEMP TABLES ??!! There may be no problems here...
	kill buffer
	merge mtstemp=mts
	if '$g(mt("rtpc","outliersexist")) { // JSL5087, add this if condition
			#; prune unneeded parts of mts
		set qno="" 
		for {
			set qno=$o(mts(qno)) q:qno=""
			set str=""
			for {
				set data="",str=$o(mts(qno,str),1,data) quit:str=""
					#; The RowID ifn in piece #5 - make sure we record it
				if $p(data,"^",5) {
					set ifn=$p(data,"^",5)
					if ifn {
						set irn=$$$smdGetIrnFromIfn(ifn)
						if irn {
							set fname=$$$smdGetFieldName(ifn)
							if '$d(pdict("fld",irn,fname)) {
								set pdict("fld",irn,fname)=$lb(ifn,$$GetType^%qadfld2(irn,ifn),$$$smdColCollation(1,irn,ifn),$p($g($$$smd(8,ifn)),$c(1),5),$$$smdColListCollection(1,irn,ifn),$$$smdColListType(1,irn,ifn),$$$smdColListDelimiter(1,irn,ifn),$$$smdColReferencedTable(1,irn,ifn) )
							}
						}
					}
				}
					#; The ifn's in "^" piece 6 - make sure these fields are recorded in pdict("fld")
				set data=$p(data,"^",6)
				for ptr=2:1 {
					set ifn=$p(data,",",ptr) quit:ifn=""
					set irn=$$$smdGetIrnFromIfn(ifn)
					set fname=$$$smdGetFieldName(ifn)
					if '$d(pdict("fld",irn,fname)) {
						set pdict("fld",irn,fname)=$lb(ifn,$$GetType^%qadfld2(irn,ifn),$$$smdColCollation(1,irn,ifn),$p($g($$$smd(8,ifn)),$c(1),5),$$$smdColListCollection(1,irn,ifn),$$$smdColListType(1,irn,ifn),$$$smdColListDelimiter(1,irn,ifn),$$$smdColReferencedTable(1,irn,ifn) )
					}
					
				}
				set type=""
				for {
					set type=$o(mts(qno,str,type)) q:type=""
					if " CON COMP JOIN MREL "[(" "_type_" ") { kill mts(qno,str,type) }
					if type="MAP" {
						set map=""
						for {
							set map=$o(mts(qno,str,"MAP",map)) q:map=""
							kill:'$lf(maps,map) mts(qno,str,"MAP",map)
						}
					}
				}
			} 
		}
	} else { // JSL5087 - different pruning for RTPC outlier support
			#; prune unneeded parts of mts, everything unneeded except type ATT
		set qno=""
		for {
			set qno=$o(mts(qno)) q:qno=""
			set str=""
			for {
				set data="",str=$o(mts(qno,str),1,data) quit:str=""
					#; The ifn's in "^" piece 6 - make sure these fields are recorded in pdict("fld")
				set data=$p(data,"^",6)
				for ptr=2:1 {
					set ifn=$p(data,",",ptr) quit:ifn=""
					set irn=$$$smdGetIrnFromIfn(ifn)
					set fname=$$$smdGetFieldName(ifn)
					if '$d(pdict("fld",irn,fname)) {
						set pdict("fld",irn,fname)=$lb(ifn,$$GetType^%qadfld2(irn,ifn),$$$smdColCollation(1,irn,ifn),$p($g($$$smd(8,ifn)),$c(1),5),$$$smdColListCollection(1,irn,ifn),$$$smdColListType(1,irn,ifn),$$$smdColListDelimiter(1,irn,ifn),$$$smdColReferencedTable(1,irn,ifn) )
					}
					
				}
				set type=""
				for {
					set type=$o(mts(qno,str,type)) q:type=""
					if '(" ATT "[(" "_type_" ")) { kill mts(qno,str,type) }
				}
			}
		}
	}
		#; w !!,"SERIALIZING pdict()...,  pdict=" zw pdict w !!,"sql()",! zw sql
	do SerializeArray("pdict",.strary,encode,0,.buffer) 
	do SerializeArray("mt",.strary,encode,0,.buffer) 
	do SerializeArray("asl",.strary,encode,0,.buffer) 
	do SerializeArray("mts",.strary,encode,1,.buffer) 
	kill mts
	merge mts=mtstemp
	kill mtstemp
		#; Can prune mts: only keep required map entries; Following currently used: ATT,MAP,RANGE,(qno,str) node
		#;    Unused MAPs seems the only thing possibly worth pruning.
	kill pdict
}
.
#define maxlistsize 10000
SerializeArray(ary,strary,encode,final=1,buffer) PUBLIC // strary - output - array of output strings; strary root has count of elements
{
	set oary=ary,arylen=$l(ary)+1,size=0
	set buffer=$get(buffer)_$lb(0,ary)
		#; Setup initial ary,data values for the for loop
	set:$data(@ary,data)#10=0 ary=$query(@ary,1,data)
	for {
		set parts=$l(data)\$$$maxlistsize
		set buffer=buffer_$lb($e(ary,arylen,*))_$s(parts>0:$lb(parts),1:$lb())
		for chunk=0:1:parts {
			set tmp=$lb($e(data,chunk*$$$maxlistsize+1,chunk+1*$$$maxlistsize))
			if $l(buffer)+$l(tmp)>($$$maxlistsize*2+2000) {
				set junk=$system.Util.Compress(buffer,"zstd")
				set strary($i(strary))=$s(encode:$system.Encryption.Base64Encode(junk,1),1:junk),size=size+$l(strary(strary))
				set buffer=$lb(0,oary)
			}
			set buffer=buffer_tmp
		}
		set ary=$query(@ary,1,data) quit:ary=""
	}
	if buffer'="" {
		if final {
			set junk=$system.Util.Compress(buffer,"zstd")
			set strary($i(strary))=$s(encode:$system.Encryption.Base64Encode(junk,1),1:junk),size=size+$l(strary(strary))
		} else {
			set buffer=buffer_$lb("")
		}
	}
	RETURN size
}
.
ConstructArray(strary,encode) PUBLIC {
	set ptr=0,state=1,strary=0
	for {
		quit:'$data(strary($i(strary)),buffer)
		set buffer=$system.Util.Decompress($s(encode:$system.Encryption.Base64Decode(buffer),1:buffer))
		set ptr=0
next		if '$listnext(buffer,ptr,version)||('$listnext(buffer,ptr,ary)) { quit }
		for i=1:1 {
			quit:'$listnext(buffer,ptr,val)
			if state=1 {
				if val="",i>1 { GOTO next }
				set node=ary_val,state=2
				quit:'$listnext(buffer,ptr,val)
				set parts=+$get(val),state=3,data=""
				quit:'$listnext(buffer,ptr,val)
				set data=data_val
				#; If we have all the data then set the node
				if $increment(parts,-1)<0 {
					set @(node)=data
					set state=1
				}				
			} elseif state=2 {
				set parts=+$get(val),state=3,data=""
			} elseif state=3 {
				set data=data_val
				#; If we have all the data then set the node
				if $increment(parts,-1)<0 {
					set @(node)=data
					set state=1
				}
			}
		}
	}
}
.
viewhash(gvinput,viewschema) [] PUBLIC {// PVA356: created
	do NormalizeSQL^%qaqqt(.gvinput,.normvdef)
	RETURN $$Hash^%SYS.SQLSRV($lb(viewschema),.normvdef,"")
}
.
findmaps() [mt,lmods,modun,maps] PUBLIC { // based on qaqplan
	new lmods,modun,maps
	set modun="",maps="",lmods=""
	for mmm=1:1:$$$mtPNumQbs { // d subq(mmm,.maps)  
			#; PVA344: following all need to be continue, not quit. 
		continue:'$$$mtPQbIsActive(mmm)  ;  skip merged subqueries
		continue:$$$mtPVirtStreamModule($$$mtP(mmm))  ;  virtual streams are integrated - skip!
		continue:$g($$$mtUnionTopQb(mmm),mmm)'=mmm  ;  UNION is integrated - skip!
		set lmods=""
		do mod($select($$$topWorkerModule(mmm)=$$$mtPFirstASLModule($$$mtP(mmm)):$$$topParentModule(mmm),1:$$$mtPFirstASLModule($$$mtP(mmm))),0,"")  ;  MAIN mod for this subquery
		for  { quit:lmods=""  set mod=$li(lmods) do mod(mod,1,"") set $li(lmods,1,1)="" }
	}
	QUIT maps
}
.
mod(mod,top,ind) [modun] PUBLIC {
	QUIT:$e(modun,mod)
	set $e(modun,mod)=1  ;  process shared module only once
	do pkey(mod,1),key(mod),pkey(mod,3),action(mod,ind)
}
.
pkey(mod,funk)[asl] PUBLIC {
	set item=""  ;  process PREKEY/POSTKEY
	for  { set item=$o($$$aslPk(mod,funk,item)) quit:item=""  do pkit(mod,funk,item) } 
	QUIT
}
.
pkit(mod,funk,item) [asl,maps,lmods] PUBLIC {   
	set info=$g($$$aslPkId(mod,funk,item))
	QUIT:$$hash^%qaqplan($p(info,$c(1),3))
	if info'="" && $p(info,$c(1),2) { set maps=maps_$lb($$$aslIdMapId(info)) } 
	set info=+$g($$$aslPkCallAnotherMod(mod,funk,item))  ;  call a module
	if info { set lmods=lmods_$lb(info) QUIT  }
	set objAsl = $$$oXasl
	if $d($$$aslPkBmChunk(mod,funk,item)) && 'objAsl.Mod(mod).Pk(funk,item).BitChunk().TempFile() {
		set maps=maps_$lb(objAsl.Mod(mod).Pk(funk,item).BitChunk().Map())
	}
	QUIT
}
.
key(mod) [maps,asl,lmods] PUBLIC { 
	GOTO:$g($$$aslKRoot(mod))="bsl" bsl
	QUIT:$g($$$aslKRoot(mod))="dsn" 
	QUIT:'$d($$$aslK(mod,1))
	set info=$g($$$aslKId(mod,1))
	set parq=$g($$$aslKParQueriesInfo(mod,2,1))
	if parq { do parq(mod,info,parq) } // PVA355: don't quit for "parq"; may be a map underneath
	elseif $$$aslIdKeyAccessType(info)="single" { quit }
	if $$$aslIdMapId(info) { set maps=maps_$lb($$$aslIdMapId(info)) } 
	QUIT
bsl 
	set last=$o($$$aslK(mod,""),-1)
	for item=1:1:last {
		set modit=$$$aslIdTfBuildLoc($$$aslKId(mod,item))
		if modit { set lmods=lmods_$lb(+modit) }
	} 
	do bslit(last,mod)  ;  BSL expression
}
.
parq(mod,id,parq) [lmods,mt] {
	set m=$$$aslKParQueriesSubq(parq)
	if $$$useAPE(m) {
		set lmods=lmods_$lb($$$topWorkerModule(m))
	}
	RETURN
}
.
bslit(item,mod) [asl,maps] PUBLIC {
	set info=$$$aslKId(mod,item),flag=$$$aslIdKeyAccessType(info),arg=$$$aslNextSkipNull($$$aslKNext(mod,item,1))
	if flag="map" { set maps=maps_$lb($$$aslIdMapId(info)) }
	if flag="or" { do bslit(+arg,mod), bslit($p(arg,",",2),mod) }
	if flag="and" { do bslit(+arg,mod),bslit($p(arg,",",2),mod) }
	if flag="convert" { do bslit(arg,mod) }
	QUIT
}
.
action(mod,ind) [asl] PUBLIC {
	set item=""  
	for  { set item=$o($$$aslAct(mod,item)) quit:item=""  do actit(mod,item,ind) }
	QUIT
}
.
actit(mod,item,ind) [asl,lmods] PUBLIC { 
	set info=$$$aslAct(mod,item),actyp=$$$aslActAction(info)
	//if actyp="n" { do mod($p(info,$c(1),2),0,ind) QUIT  }  ;  NEST
	if actyp="n" { set lmods=lmods_$lb($$$aslActNestingModOrIpqVars(info))  }  ;  NEST
	if actyp="s" { set lmods=lmods_$lb($$$aslActNestingModOrIpqVars(info)) } 
	QUIT
}
.
	#; strary - input by reference - array of compressed strings; root node must be count
	// Called from fplan()
fplanar(strary,encode=1,hkey,planVersion="") [pdict,mt,mts,asl,m,mcurs,mtc,mtag,ojfilter,omscost,input] PUBLIC { 
	set $ztrap="err"
	merge savmt=mt  // in case bad frozen plan
	merge savmcurs=mcurs
	merge savmtc=mtc
	//m savmtag=mtag
	merge savomscost=omscost
	set soft=0 // all errors except map selectability are 'hard'
	do ConstructArray(.strary,encode)
.
		#;	With DPV6550 the format of mt("vtr") changed from a delimited string to a list.  Fix that up here...
	set val=0
	for {
		set val=$o($$$mtVtr(val),1,data) quit:val=""
		if data'="",'$listvalid(data) { set $$$mtVtr(val)=$listfromstring(data,";") }
	}
	
		#; w !!,"CONSTRUCTED pdict()...,  pdict=" zw pdict w !!,"input()",! zw input
	if pdict("version")'=1 { set msg="plan version not supported" goto fplanerr }
	set:$d(pdict("mcurs")) mcurs=pdict("mcurs")
	merge:$d(pdict("mtc")) mtc(mcurs)=pdict("mtc")
	//s:$d(pdict("mtag")) mtag=pdict("mtag")
	set:$d(pdict("omscost")) omscost=pdict("omscost")
	set mt("frozen")=""  // Allow ShowPlan to detect a frozen plan
	if $$$mtStatementType="DEC" { set mtc(mcurs,"modvar")=%msqlvar }
	merge:$d(pdict("ojfilter")) ojfilter=pdict("ojfilter")
	
		#; if the plan is from before 2017.1 (DPV4971), see if TRIM function is used.  If it is, just mark the plan in an error state because the order of the arguments for TRIM in mt("v") have changed
	if planVersion<2017.1 {
		set val="",data=""
		for  {
			set val=$o($$$mtV(val),1,data) quit:val=""
			if $e(data,1,6)="v^TRIM" { set msg="Statement from version prior to 2017.1 that uses TRIM function cannot use frozen plan." goto fplanerr }
		}
	}
.
	#; Rebuild relevant parts of SMD from pdict information
	
	#; First set up new meta() array for special LoadGetIrn
	set iqn=""
	for {
		set iqn=$o(pdict("tbl",iqn),1,irninfo) q:iqn=""
		set irn=$li(irninfo)
		set meta(iqn)=irn
		set fn=""
		for {
			set fn=$o(pdict("fld",irn,fn),1,ifninf) q:fn=""
			set meta(iqn,"f",fn)=$li(ifninf)
		}
	}
	set mn=""
	for {
		set mn=$o(pdict("map",mn)) q:mn=""
		set iqn=""
		for {
			set iqn=$o(pdict("map",mn,iqn),1,imp) q:iqn=""
			set meta(iqn,"m",mn)=imp
		}
	}
		// Must start fresh, restored plan must use particular irn/ifn values from saved plan
	if '%0SQLCompileLevel { set i=$zu(68,28,0) kill $$$smdRoot do $zu(68,28,i) }
	else                  { do:'$d(%smdpushed) pushsmd^%qaqqt(2) }	// recursive compile, need a clean $$$smd while preserving the old $$$smd.  Don't push $$$smd on the stack if we already did for his compile in %qaqqt
	#; Next, build the matching SMD	
	new %msg
	set iqn=""
	for {
		set iqn=$o(pdict("tbl",iqn),1,irninfo) q:iqn=""
		set $lg(irn,istvf,parent,sharded,shardKey,shardMapOwner)=irninfo // JMM1136
		if $$$smdLoadGetIrn(iqn,istvf,.meta,.SQLCODE)'=irn {
			if $g(SQLCODE)<0,$g(%msg)'="" { set msg=%msg }
			else { set msg="table, tvf or field not found for : "_iqn }
			goto fplanerr
		}
			#; PVA355: check for change of parent. 
		if 'istvf && (parent'=$$$smdParentTable(1,irn)) { set msg = "table changed parent: "_iqn goto fplanerr }
			#; JMM1136: check for change of sharded/non-sharded status, shard key, or shard map owner
		if sharded'=$$$smdSharded(1,irn) { 
			if sharded { set msg = "table changed from sharded to nonsharded: "_iqn goto fplanerr }
			else { set msg = "table changed from nonsharded to sharded: "_iqn goto fplanerr }
		}
		elseif sharded {
			if shardKey'=$$$smdShardKey(1,irn) { set msg = "table changed shard key: "_iqn goto fplanerr }
			elseif shardMapOwner'=$$$smdShardMapOwner(1,irn) { set msg = "table changed shard key type: "_iqn goto fplanerr } 
		}
			
	}
		#; Check for change of view definition (PVA356)
	set vname=""
	for {
		set vname=$o(pdict("view",vname),1,info) q:vname=""
		set m=$li(info,2),i=$$ddtab^%qaqpsq(.vname,.gvinput,.viewschema),curhash=$$viewhash(.gvinput,.viewschema)
		if curhash'=$li(info) { set msg= "view definition changed for view: "_vname goto fplanerr }
	}
		#; Check if the current col # are still the same as the col # stored in mt("arrcol") for select into array query
	if $d(mt("arrcol")) {
		if '$LISTSAME($$arrcol^%qaqpnl(),mt("arrcol")) {
			set msg="column numbers have been changed" goto fplanerr
		}
	}
		#; FOR LINKED TABLES: verify still linked (and also nonlinked table not now linked??), and ODBC <-> JDBC
		#;    - different things supported for ODBC versus JDBC. 
	set irn="" 
	for  {
		set irn=$o(pdict("fld",irn)) quit:irn=""
		set fn="" 
		for  {
			set fn=$o(pdict("fld",irn,fn),1,ifninf) quit:fn=""
			set ifn=$li(ifninf)
			if $$$smdGetIfn(1,irn,fn)'=ifn { set msg="field not found: "_fn goto fplanerr }
			set currentDT=$$GetType^%qadfld2(irn,ifn)
			if currentDT'=$li(ifninf,2) {
				if currentDT="%Library.BigInt",$li(ifninf,2)="%Library.Integer" {
				} elseif currentDT="%Library.RawString",$li(ifninf,2)="%Library.CacheString" {	// ProdLog 156841 C/E->IRIS upgrade, allow this dt change as it is simply a name change
				} elseif currentDT="%Dictionary.Classname",$li(ifninf,2)="%Dictionary.CacheClassname" {	// ProdLog 156841 C/E->IRIS upgrade, allow this dt change as it is simply a name change
				} else {
					set msg="Datatype of field "_fn_" changed from '"_$li(ifninf,2)_"' to '"_currentDT_"'" goto fplanerr
				}
			}
			if $$$smdColCollation(1,irn,ifn)'=$li(ifninf,3) {s msg="Collation of field "_fn_" changed from '"_$li(ifninf,3)_"' to '"_$$$smdColCollation(1,irn,ifn)_"'" g fplanerr }
			if $p($g($$$smd(8,ifn)),$c(1),5)'=$li(ifninf,4) { // scale
					#; If this is a time field and the old scale is 0 and the new scale is "", that is ok.  This was changed by DPV5355
				if currentDT="%Library.Time",$li(ifninf,4)=0,$p($g($$$smd(8,ifn)),$c(1),5)="" {}
				else { set msg="Scale of field "_fn_" changed from '"_$li(ifninf,4)_"' to '"_$p($g($$$smd(8,ifn)),$c(1),5)_"'" goto fplanerr }
			}
			if $$$smdColListCollection(1,irn,ifn)'=$li(ifninf,5) {s msg="List collection setting for field "_fn_" changed from '"_$li(ifninf,5)_"' to '"_$$$smdColListCollection(1,irn,ifn)_"'" g fplanerr }
			if $$$smdColListType(1,irn,ifn)'=$li(ifninf,6) {s msg="List collection type for field "_fn_" changed from '"_$li(ifninf,6)_"' to '"_$$$smdColListType(1,irn,ifn)_"'"  g fplanerr } 
			if $$$smdColListDelimiter(1,irn,ifn)'=$li(ifninf,7) {s msg="List collection delimiter for field "_fn_" changed from '"_$li(ifninf,7)_"' to '"_$$$smdColListDelimiter(1,irn,ifn)_"'" g fplanerr}
			if $$$smdColReferencedTable(1,irn,ifn)'=$li(ifninf,8) {s msg = "reference column changed referenced table: "_fn g fplanerr} // PVA355
		}
	}
		#; SELECT *,T.* validation
	set irn=""
	for  {
		set irn=$o(pdict("*",irn),1) quit:irn=""
		set sflist=pdict("*",irn)              // plan's SELECT * field list for this table
		set flist=$$$smdAllExactFields(1,irn)  // current SELECT * field list for this table
		if '$listsame(flist,sflist) { set msg="select * expansion change for "_$$$smdGetIqnFromIrn(irn) goto fplanerr }
	}
.
   #; pdict("unqtbl",<unqualified table/tvf/view name as parsed>)=<name as finalized by ddtab>
   s utn="" for
   {  s utn=$o(pdict("unqtbl",utn),1,fname) q:utn=""
      s utnl=$lb(utn)
      d stname^%qaqpsq(.utnl,1)
      s m=$li(fname,2)
      	#; mt("savef") is only defined for insert/select.  If this is a frozen insert/select, there is no need to call setshard in ddtab()
      s tt=$$ddtab^%qaqpsq(.utnl,.gvinput,.viewschema,'$d($$$mtSaveF))
      if (utnl'=$li(fname)) {s msg="unqualifed table/tvf/view changed resolution: "_utn g fplanerr}
   }
   #; pdict("unqfunc",<unqualified procname>)=<schema>
   s ufn="" for
   {  s ufn=$o(pdict("unqfunc",ufn),1,schema) q:ufn=""
      s procs=$$ResolveProcName^%qaqpsq1(ufn,.newschema)
      s msg="unqualified function: "_ufn_" may have changed resolution" // PVA355: set error message for this case
      g:(procs'=1) fplanerr
      g:newschema'=schema fplanerr
   }
   #; Validate unqualified columns against possible change of meaning
   s fname="" for
   {  s fname=$o(pdict("unqcol",fname),1,irnlst) q:fname=""
      s iqn="" for 
      {  s iqn=$o(pdict("tbl",iqn),1,tbinfo) q:iqn=""
         s irn=$li(tbinfo)
         s ifn=$$$smdGetIfn(1,irn,fname)
         if (ifn && ('$lf(irnlst,irn))) { s msg="possible resolution change for unqualied column "_fname g fplanerr }
         if ('ifn && ($lf(irnlst,irn))) {s msg="possible resolution change for unqualied column "_fname g fplanerr}
      }
   }
   #; Validate unqualified arrow refs against possible change of meaning
   s rname="" for
   {  s rname=$o(pdict("unqref",rname),1,irnlst) q:rname=""
      s iqn="" for
      {  s iqn=$o(pdict("tbl",iqn),1,tbinfo) q:iqn=""
         s irn=$li(tbinfo)
         s idb=$$$smdRowIDLogicalFields(1,irn),idifn=$$$smdRowIDField(1,irn)
         s ifn=$$$smdGetIfn(1,irn,rname)
         if ifn=idifn,idb]"",idb'["," s ifn=idb // allow ID to be used as a reference if it is based on a single field which is a reference 
         if $g($$$smd(1,irn,23))[("^"_ifn_",") {s isref=1} else {s isref=0}
         s kids=$$$smdKids(1,irn),iskid=0
         for i=1:1:$ll(kids) { if $tr(rname,".",$c(2))=$$$UPPER($p($li(kids,i),".",2)) {s iskid=1 quit }}
         if (isref'=iskid && '$lf(irnlst,irn)) {s msg="possible resolution change for unqualifed arrow reference "_rname g fplanerr}
         if (isref=iskid && $lf(irnlst,irn)) {s msg="possible resolution change for unqualifed arrow reference "_rname g fplanerr}
      }
   }
.
    #; Validate that pseudo-colmns expand the same way
    s iqn="" for 
    {  s iqn=$o(pdict("%CLASSNAME",iqn),1,cname) q:iqn=""
       if $$$GetClassNameFromIQN(iqn)'=cname {s msg="%classname change for "_iqn g fplanerr }
    }
    s iqn="" for 
    {  s iqn=$o(pdict("%TABLENAME",iqn),1,tname) q:iqn=""
       s lit=$$$GetExactIQNFromIQN(iqn),lit=$$$SchemaFromIQN(lit)_"."_$$$TableFromIQN(lit) 
       if lit'=tname {s msg="%tablename change for "_iqn g fplanerr}
    }
    s iqn="" for 
    {  s iqn=$o(pdict("%ID",iqn),1,iname) q:iqn=""
       s irn=$li(pdict("tbl",iqn))
       s lname=$$$smdRowIDFieldName(1,irn),lname=$$$UPPER(lname)
       if lname'=iname {s msg="%id change for "_iqn g fplanerr}
    }
.
	set mn=""
	for {
		set mn=$order(pdict("map",mn)) quit:mn=""
		set iqn=""
		for  {
			set iqn=$order(pdict("map",mn,iqn),1,imp) quit:iqn=""
			set irn=$$$smdGetIrn(iqn)
				#; Validate subscripts against mts
			set mapfound=0
			set qno=""
			for  {
				set qno=$order(mts(qno)) quit:qno=""
				set str=""
				for  {
					set str=$order(mts(qno,str)) quit:str=""
					continue:$$$mtRIrn($$$mtR(str))'=irn
					continue:'$d(mts(qno,str,"MAP",imp)) // maybe only used in other stream (allowing for pruning saved mts)
.
						#; Make sure all fields in mts are also in $$$smd
					set data=$p(mts(qno,str),"^",6)
					for ptr=2:1 {
						set ifn=$p(data,",",ptr) quit:ifn=""
						set irn=$$$smdGetIrnFromIfn(ifn)
						if irn="" { set msg="field with ifn="_ifn_" is referenced in map (mts("_qno_","_str_") ""^"" piece 6), but was not a field that was frozen in $$$smd().",soft=1 goto fplanerr }
					}
					
					set mapfound=1
						#; PVA351: Check for MapSelectability
					if $$$smdMapMaster(imp)'="Y"&&($d(^rINDEXEXT("MS",$$$smdSchema(1,irn),$$$smdName(1,irn),$$$UPPER(mn)))||$d(^oddSQL($$$smdSchema(1,irn),$$$smdName(1,irn),"MS",$$$UPPER(mn),$namespace))) { set msg="map "_mn_" is marked not selectable",soft=1 goto fplanerr }
					set subno="",ilev=0,mtssubcnt=0,smdsubcnt=0
					for  {
						set subno=$order(mts(qno,str,"MAP",imp,subno),1,subinfo)
						set ilev=$order($$$smd(12,imp,6,ilev))
						if subno="" { set:ilev smdsubcnt=smdsubcnt+1 quit }
						set mtssubcnt=mtssubcnt+1
						quit:'ilev
						set smdsubcnt=smdsubcnt+1
						set ifn=$$$smdMSFieldIfn(imp,ilev)
							#; in mts() the parent id physical fields are replaced with the single parent reference logical field
							#; We have to make the same concession when comparing mts() to $$$smd
						if ifn,$$$smdMapParIDInSub(imp)="Y",$$$smdMapParIDStartLev(imp)=ilev,$$$smdMapParIDInOrder(imp)="Y",$$$smdParentRefField(1,irn)'="" {
							set ilev=$$$smdMapParIDLastLev(imp)
							set ifn=$$$smdGetIfn(1,irn,$$$smdParentRefField(1,irn))
						}
						continue:$p(subinfo,"^")=0 // Don't care about changes to uninteresting subscripts?
						if 'ifn && ($piece(subinfo,"^")>1) && ($piece(subinfo,"^")<7) { set msg="map subscript "_ilev_" in map "_mn_" changed.  mts subinfo is type "_$piece(subinfo,"^",1)_", but ifn = '"_ifn_"'" goto fplanerr} // really many messy special cases to test here
						continue:'ifn // Will add special case validations later; Ideally, way to share code with $$sub in %qaqpqo1
						if ifn='$piece(subinfo,"^",2) { set msg="map subscript "_ilev_" (ifn from "_$piece(subinfo,"^",2)_" to "_ifn_") in map "_mn_" changed" goto fplanerr } // agree on ifn ?
						set fx=$$$smdMSFunction(imp,ilev),collate=""
						if fx'="" {
							if fx["UPPER"||(fx["STRING")||(fx["ALPHAUP")||(fx["MVR")||(fx["SPACE")||(fx["PLUS")||(fx["MINUS")||(fx["TRUNCATE") { set collate=$select($extract(fx,1,2)'="$$":"%"_fx,1:$select(fx?1"$$"3.9A1"(":"%"_$translate(fx,"$("),1:"~"_fx)) } Else { set collate="~"_fx }
						}
						if collate'=$piece(subinfo,"^",6) { set msg="map subscript "_ilev_" collation ("_$piece(subinfo,"^",6)_" to "_collate_") in map "_mn_" changed" goto fplanerr } // agree on collation ? (perhaps we don't rely on this, but no way to tell)
							#; NOTE: if this subscript used for anything other than 'loop over all', then
							#; field validation should take care of other things, e.g. data type check
					}
					if $e($$$smdMapIndexType(imp))="B"||($$$smdMapIndexType(imp)="S") { set mtssubcnt=mtssubcnt-1 }
					if mtssubcnt<smdsubcnt { set msg="For map '"_mn_"', the number of map subscripts in the frozen plan is less than the number of map subscripts in the current map definition." goto fplanerr }
					if mtssubcnt>smdsubcnt { set msg="For map '"_mn_"', the number of map subscripts in the frozen plan is more than the number of map subscripts in the current map definition." goto fplanerr }
					quit:mapfound // map recorded many times in mts; only need to find one for validation
				}
				quit:mapfound
			}
			if 'mapfound { set msg="map not found in mts "_mn goto fplanerr }
		}
	}
	kill pdict // not needed anymore
	QUIT 1
.
fplanerr	//
	do UpdateSQLIndex^%SYS.SQLSRV(hkey,msg,soft)
		// Need to cleanup $$$smd
	if '%0SQLCompileLevel||($g(%smdpushed)=1) { set i=$zu(68,28,0) kill $$$smdRoot do $zu(68,28,i) }		// Not a recursive SQL compile, or recursive and we have already pushed $$$smd on the stack om %qaqqt, just kill it
	elseif $g(%smdpushed)=2                   { do popsmd^%qaqqt() }	// We just pushed $$$smd on the stack in fplanar, but we got an error using the frozen plan and will not be using it, go ahead and pop $$$smd from the stack
	kill mt,asl,mts,pdict,mcurs,mtc,ojfilter,omscost	// ,mtag
	merge mt=savmt
	merge mcurs=savmcurs
	merge mtc=savmtc
	//m mtag=savmtag
	merge omscost=savomscost
	QUIT 0
.
err	set $ztrap=""
	if $zerror'["ep+2^%qaqperr" zt $zerror
	set msg=%msg
	GOTO fplanerr
}
.
#; NEED FPLAN VERSION FOR INSERT/DELETE/UPDATE
.
	// Called from %qaqpsq1
	// See if we are to use a frozen plan
	// Return 1 if the frozen plan is to be used, otherwise 0.
fplan() [%defschema,%sqlSchemaPath,begline,begtoken,endline,endtoken,fplan,indexline,input,lineprev,lower,mt,pprev,prevtoken,saveplan,sqlidxhash,switch,token,V,value] PUBLIC {
	// s st=0  -- old version of fplan
	new begline,begtoken,endline,endtoken,indexline,lineprev,pprev,prevtoken
	if $get(saveplan)=-1 { set fplan=0 RETURN 0 }
	set hashkey=$$GetStatementPlan^%qaqqt(.input,,.qplanar,mt("sqlcomp"),$g(%sqlSchemaPath),%defschema,.error,.planVersion)
	if (hashkey="") { set fplan=0 RETURN 0 }
	set (st,fplan)=$$fplanar(.qplanar,0,hashkey,planVersion)
	set sqlidxhash=hashkey	// Used in %qaqqt
		#; AK776 need to rewrite frozen plans to avoid 'given-ids' asl construct
	do updategivenids()
	RETURN st 
} 
.
pconst()
 n pnum,litval,%context s pnum=0,%context=$system.Context.SQLCompile()
 while $$check("(") {if $i(pnum)}
 s litval=value d skip(9) 
 while pnum { d skip(")") s pnum=pnum-1 }  
 QUIT litval
.
updategivenids() [asl,mod,MAIN,str,m,PREKEY,KEY,POSTKEY,ACTION,idval,V] {
	new mod,MAIN,str,m,PREKEY,KEY,POSTKEY,ACTION,idval,V
	set PREKEY=1,KEY=2,POSTKEY=3,ACTION=4
	set V=$c(1)
	for mod=1:1 {
		QUIT:'$d($$$aslMod(mod))
		if $g($$$aslPkCopy(mod,POSTKEY,1))["**all rowids**" {
			set idval=$$$aslPkCopyTarget($$$aslPkCopy(mod,POSTKEY,1))
			set wdata=$s($d($$$aslPkObsoleteGivenIds(mod,POSTKEY,2)):2,1:3)
			set allrowid=$$$aslPkObsoleteGivenIds(mod,POSTKEY,wdata)
			for npk=1:1 quit:$data($$$aslPkId(mod,POSTKEY,npk),aslid)
			set str=$$$aslIdStrNum(aslid)
			set m=$$$aslIdQb(aslid)
			set MAIN=$$$aslTopSubqMod(mod)
			kill $$$aslPkObsoleteGivenIds(mod,POSTKEY,wdata)
			for npk=2:1 {
				kill $$$aslPk(mod,POSTKEY,npk-1)
				merge $$$aslPk(mod,POSTKEY,npk-1)=$$$aslPk(mod,POSTKEY,npk)
				QUIT:'$data($$$aslPk(mod,POSTKEY,npk))
			}
			f j=1:1:$l(allrowid,"~") set $p(allrowid,"~",j)=$$$newval("v^%BARS^,^"_$tr($p(allrowid,"~",j),",","^")_"^",1)
			s other=$$$newval("v^SET:SETOF^,^"_$tr(allrowid,"~","^")_"^",1)
			do calc^%qaqpmod(other)
			s $$$aslKId(mod,1)="set"_V_V_V_V_V_str_V_m
			#; set $$$aslIdKeyAccessType($$$aslKId(mod,1))="set"
			#; set $$$aslIdStrNum($$$aslKId(mod,1))=str
			#; set $$$aslIdQb($$$aslKId(mod,1))=m
			set $$$aslKNext(mod,1,1)=idval_V_"y"_V_other
			#; set $$$aslNextSubscriptVal($$$aslKNext(mod,1,1))=idval
			#; set $$$aslNextLoopingType($$$aslKNext(mod,1,1))="y"
			#; set $$$aslNextLoopingLowLimOrSetVar($$$aslKNext(mod,1,1))=other
		}
	}
}
---
