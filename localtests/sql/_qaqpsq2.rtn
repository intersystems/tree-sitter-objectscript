qaqpsq2
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpsq2^MAC^^^0
%qaqpsq2	// SQL parser overflow
	;; COMPONENTS :: SQL/Parser
	#;
#INCLUDE %msql
	#;
#IF 0   ;-------------------------------------------------------------
	; Description:   SQL parser overflow...
	; Author:        Aviel Klausner
	; Date Started:  September 09 1987
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;  MRP822  (12/08/2014) - Add proper SQLCODE & Msg for too many arguments to scalar functions (Part 1)
	;  MRP777  (09/06/2013) - Implement $JUSTIFY | $TRANSLATE
	;  PVA223  (05/11/2010) - Un-reserve timestamp keyword 
	;  DPV3401 (05/01/2009) - Support NCHAR and NVARCHAR as CAST types
	;  DPV3342 (01/15/2009) - Support REVOKE ... AS <grantor>
	;  DPV3316 (12/02/2008) - Support privileges on Cubes
	;  DPV3231 (08/05/2008) - Use process private global for ptln, ptrel
	;  DPV3220 (07/15/2008) - Improve PRECISION and SCALE reporting for Aggregates and other functions
	;  DPV3207 (06/25/2008) - Implement support for $LISTBUILD, $LISTFROMSTRING, $LISTTOSTRING scalar functions
	;  DPV3184 (06/09/2008) - Correct problem granting different privs on different columns in same statement
	;  DPV3176 (05/29/2008) - INFORMIX:  MATCHES Support
	;  DPV3157 (05/13/2008) - Fixes for grant of column level privileges
	;  DPV3122 (03/12/2008) - new val3
	;  DPV3095 (01/22/2008) - Support for column-level privileges
	;  DPV2916 (04/26/2007) - Fix CAST to CHAR[ACTER] [VARYING] with length specified.
	;                         SQL Fix ProdLog 57589: cast as char varying(n) fails to compile
	;  DPV2882 (03/13/2007) - TSQL:  Support NEWID() function, Caché SQL:  Implement $TSQL_NEWID() function
	;  DPV2852 (02/01/2007) - Support CAST to SMALLDATETIME and an alias for CAST to TIMESTAMP
	;  DPV2851 (01/31/2007) - Implement $TSQL_RAND() function
	;  DPV2779 (10/31/2006) - Fix putval calls for some $XXX() functions to not have more than one trailing "^"
	;  DPV2747 (09/28/2006) - TSQL:  Implement support for TSQL bitwise operators &, |, ^, and ~
	;  DPV2746 (09/27/2006) - TSQL: Implement OBJECT_ID() function
	;  DPV2743 (09/22/2006) - TSQL: Implement support for TSQL function INDEX_COL
	;  DPV2740 (09/20/2006) - TSQL: Implement support for COL_NAME function
 	;  DPV2726 (09/05/2006) - TSQL: Implement support for OBJECT_NAME function
	;  DPV2721 (08/28/2006) - Fix ALTER VIEW compilations to not crash with non-table fields in view query
	;                         SQL Fix ProdLog 52961:  ALTER VIEW crashes
	;  DPV2688 (07/05/2006) - Support CAST AS REAL as an alias for CAST AS FLOAT
	;  DPV2667 (06/01/2006) - SQL: CAST Enhancements and fixes
	;  DPV2658 (05/22/2006) - TSQL:  Re-do support for $TSQL_LIKE
	;  DPV2656 (05/19/2006) - Support CAST to DATETIME and an alias for CAST to TIMESTAMP
	;  DPV2653 (05/17/2006) - Move CAST parsing to %qaqpsq2
	;  DPV2630 (05/02/2006) - TSQL:  Add support for $TSQL_TEXTPTR()
	;  DPV2624 (04/26/2006) - TSQL:  Add support for $TSQL_PLUS() for + handling
	;  DPV2620 (04/19/2006) - Add support for $TSQL_XXX() functions
	;  DPV2615 (04/07/2006) - Add support for scalar function CHARINDEX and STUFF
	;  DPV2436 (05/20/2005) - Fix TRIM function
	;                         SQL Fix ProdLog 43567: <UNDEFINED> for certain TRIM clause
	;                         SQL Fix ProdLog 33103: TRIM function does not return null when string-expression-1 is NULL
	;  DPV2288 (09/15/2004) - Add Support for STR(float-expr[, length [, decimal ]]) - Move TRIM code here.
	;  DPV2273 (08/26/2004) - Implement GRANT/REVOKE or EXECUTE privileges for Procedures
	;  DPV2271 (08/20/2004) - Eliminate THRESHOLD
	;  DPV2264 (08/11/2004) - Move SQL System privileges to per-namespace, eliminate system-wide privieges
	;  DPV2237 (06/18/2004) - Remove support for Namespace Security Access
	;  DPV2100 (10/20/2003) - Implement $EXTRACT, $FIND, and $LENGTH functions
	;  DPV2093 (10/20/2003) - Implement $LIST, $LISTDATA, $LISTFIND, $LISTGET, $LISTLENGTH, and $PIECE functions
	;  DPV2052 (07/25/2003) - Allow reserved words for user/role
	;  DPV1760 (07/08/2002) - Eleiminate rword and reserved functions as they are not called by anyone
	;  DPV1742 (06/10/2002) - Support DB Object Definition system privileges
	;  DPV1705 (05/03/2002) - Support INSERT, UPDATE, DELETE, REFERENCE privileges on views
	;  DPV1324 (06/19/2000) - #import sets current schema(s)
	;  DPV1319 (06/07/2000) - Support for schemas in privileges
	;  DPV1208 (12/06/1999) - Support RESTRICT for REVOKE
	;  DPV1106 (07/15/1999) - Allow ODBC namespace Access on namespaces with reserved words
	;  DPV1100 (07/06/1999) - Support ODBC Namespace Access privilege
	;  DPV1094 (06/28/1999) - Fix parsing of %ALTER...
	;  AK362   (05/13/1999) - CCS: ODBC scalar functions
	;  DPV1021 (03/25/1999) - handle leading '_' on identifier names
	;  DPV1007 (03/17/1999) - Preserve '_' in identifier names
	;  DPV987  (03/04/1999) - Make ADMIN not a reserved word
	;  AK335   (11/02/1998) - Empty string and NULL
	;  DPV900  (11/04/98)   - Support <user>,<catalog>.<schema>.<tablename>
	;                         in privilege statements.
	;  DPV876  (06/01/98)   - Allow GRANTing of some system privileges
	;  AK326   (07/23/98)   - Replace ?<pat> with %PATTERN <const>
	;  AK325   (07/21/98)   - Korea: Allow spaces in $$ a ^ b ()
	;  DPV835  (04/29/98)   - Support GRANT ALL [PRIVILEGES] ...
	;  MRP597  (03/03/96)   - Consolidate the SQL Reserved Word List...
	;                         (Copy of routine in 'zqapsql2')
	;  MRP588  (03/20/96)   - Support SQL92 CURRENT_TIMESTAMP Function...
	;  MRP587  (03/20/96)   - Support SQL92 CURRENT_TIME Function...
	;  MRP586  (03/20/96)   - Support SQL92 CURRENT_DATE Function...
	;  MRP585  (03/19/96)   - Support SQL92 TRIM Function...
	;  MRP584  (03/19/96)   - Support SQL92 UPPER & LOWER Functions...
	;  MRP583  (03/19/96)   - Support SQL92 CHAR[ACTER]_LENGTH Function...
	;  MRP582  (03/19/96)   - Support SQL92 POSITION Function...
	;  MRP580  (03/18/96)   - Support SQL92 SUBSTRING Function...
	;  PRT030  (09/06/95)   - Allow With Admin Option for %THRESHOLD
	;  AK277   (08/01/95)   - Fix Exponential notation in tag expo
	;  DPV490  (06/28/95)   - Fix UNDEFINED (caused by PRT002) with 
	;                         %CHECKPRIV query and Roles
	;                         Cleaned up Routine
	;  RLL600  (05/10/95)   - Support %ROWCOUNT (rw(%ROWCOUNT))...
	;  MRP427  (08/08/94)   - Support %INTERNAL (rw(%INTERNAL))...
	;  MRP400  (05/10/94)   - Set Grant/Revoke into the "info" list: 
	;                         mtc(0,0,"g/r actions")=
	;                            "comma list of action identifiers" ...
	;  MRP397  (05/04/94)   - Support the SQL Concatenation operator || ...
	;  MRP393  (04/11/94)   - Add 'ESCAPE' to the reserve word list...
	;  AK275   (11/20/93)   - rw(%EXTERNAL)
	;  PRT002  (10/12/93)   - code for GRANT REVOKE Roles
	;  PRT003  (10/18/93)   - GRANT/REVOKE %THRESHOLD
	;  MRP329  (08/27/93)   - Add Privilages for Menu Objects...
	;  EYT099;AK167;MRP129;ALL003;ALL006;RLL035;AK234;MRP293
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
	;  overflow routine for GRANT,REVOKE,%CHECKPRIV statements
	;
#ENDIF  ;-------------------------------------------------------------
	$$$Abort  ;  Not an Entry Point!!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
grant	;
	  #; <grant> ::=  GRANT <privil> TO <grntee> [ WITH GRANT OPTION ]
	  #;     |  GRANT <role> TO <grntee> [ WITH ADMIN OPTION ]
	  #;     -- DPV2271=|  GRANT %TRESHOLD <constant> TO <grntee> [ WITH ADMIN OPTION ]
	  #;     |  GRANT <system privilege> TO <grntee> [ WITH ADMIN OPTION ]
	  #;     -- DPV2237=|  GRANT ACCESS ON <namespacelist> TO <userlist> [ WITH GRANT OPTION ]   ;DPV1100
	  #;
	new role
	set role=""
	  #; First see if it is a system privilege being granted
	if $e(value)="%",value'="%ALTER" {
		do ParseSystemPrivs  // Won't parse anything if a sys priv not found
		if $d($$$mtKSysPriv) { // If not a sys priv, must be a % Role name
			set $$$mtStatementType="GRP"
			set:%delid %delid=3
			do skip("TO")
			do grntee
			set:%delid=3 %delid=1
			if $$check("WITH") { do skipid("ADMIN"),skip("OPTION") set $$$mtKGrantOption($$$mtK)=1 }
			QUIT
		}
	}
	do privil
	set:%delid %delid=3
	do skip("TO")
	do grntee
	set:%delid=3 %delid=1
	if $$check("WITH") { do skipid($s(role'="yes":"GRANT",1:"ADMIN")),skip("OPTION") set $p($$$mtK,I,3)=1 }
	RETURN
 
.
revok	;
	#; <revok> ::= REVOKE [ GRANT OPTION FOR ] <privil>
	#;                                FROM <grntee> [ CASCADE ] [ AS <grantor> ]			// DPV3342 (AS <grantor>)
	#;           | REVOKE <role> FROM <grantee>
	#;         -- DPV2271=  | REVOKE %THRESHOLD FROM <grantee>
	#;           | REVOKE <system privilege> FROM <grntee>  ; DPV876
	#;         -- DPV2237=  | REVOKE [ GRANT OPTION FOR ] ACCESS ON <namespace list> FROM <userlist>  ; DPV1100
	#;
	new role s role=""
	  #; First see if it is a system privilege(s) being revoked
	  #; User can't mix system privileges with roles and objects privileges
	If $e(value)="%",value'="%ALTER",token'="GRANT"{
		Do ParseSystemPrivs  		// Won't parse anything if a sys priv not found
		If $d($$$mtKSysPriv) { 	// If not a sys priv, must be a % Role name
			s $$$mtStatementType="RVP"
			d skip("FROM"),grntee
			QUIT
		}
	}
	if $$check("GRANT") { d skip("OPTION"),skip("FOR") s $p($$$mtK,I,3)=1,role="no" }
	do privil
	set:%delid %delid=3
	do skip("FROM")
	if $$check("*") { set $$$mtUsers="*" } else { do grntee }
	set:%delid %delid=1
	if role'="yes" {
		if $$check("CASCADE") { s $p($$$mtK,I,4)=1 }
		else {
			if $$check("RESTRICT")
			s $p($$$mtK,I,4)=0  ; Default is restrict
		}
		if $$check("AS") if $$check("*") { s mt("grantor")="*" } else { do grantor }	// DPV3342=
	}
	else { s $p($$$mtK,I,4)=1 } 	//  only temporary ; no cascade for roles
	QUIT
.
.
chkprv	; <chkprv> ::= %CHECKPRIV [ GRANT OPTION FOR ] <action> 
	#;                      ON <objct>
	n role s role=""
	If $$checkid("ADMIN")   { d skip("OPTION"),skip("FOR") s $p($$$mtK,I,3)=1 }
	elseif $$check("GRANT") { d skip("OPTION"),skip("FOR") s $p($$$mtK,I,3)=1 }
	If $e(value)="%",value'="%ALTER" {
		Do ParseSystemPrivs  		// Won't parse anything if a sys priv not found
		If $d($$$mtKSysPriv) { 	// If not a sys priv, must be a % Role name
			s $$$mtStatementType="%CHSP"
			QUIT
		}
	}
	d action // DPV3059- i $d($$$mtV(2)) d error(59)
	d skip("ON"),object
	QUIT
.
.
ParseSystemPrivs	//
	do {
		if $$checkid("%DB_OBJECT_DEFINITION")		{ new i for i=1:1:16 { s $Bit($$$mtKSysPriv,i)=1 } }
		elseIf $$checkid("%CREATE_FUNCTION")		{ set $Bit($$$mtKSysPriv,1)=1 }
		elseIf $$checkid("%DROP_FUNCTION")			{ set $Bit($$$mtKSysPriv,2)=1 }
		elseIf $$checkid("%CREATE_METHOD")			{ set $Bit($$$mtKSysPriv,3)=1 }
		elseIf $$checkid("%DROP_METHOD")			{ set $Bit($$$mtKSysPriv,4)=1 }
		elseIf $$checkid("%CREATE_PROCEDURE")		{ set $Bit($$$mtKSysPriv,5)=1 }
		elseIf $$checkid("%DROP_PROCEDURE")			{ set $Bit($$$mtKSysPriv,6)=1 }
		elseIf $$checkid("%CREATE_QUERY")			{ set $Bit($$$mtKSysPriv,7)=1 }
		elseIf $$checkid("%DROP_QUERY")				{ set $Bit($$$mtKSysPriv,8)=1 }
		elseIf $$checkid("%CREATE_TABLE")			{ set $Bit($$$mtKSysPriv,9)=1 }
		elseIf $$checkid("%ALTER_TABLE")			{ set $Bit($$$mtKSysPriv,10)=1 }
		elseIf $$checkid("%DROP_TABLE")				{ set $Bit($$$mtKSysPriv,11)=1 }
		elseif $$checkid("%CREATE_VIEW")			{ set $Bit($$$mtKSysPriv,12)=1 }
		elseif $$checkid("%ALTER_VIEW")				{ set $Bit($$$mtKSysPriv,13)=1 }
		elseif $$checkid("%DROP_VIEW")				{ set $Bit($$$mtKSysPriv,14)=1 }
		elseif $$checkid("%CREATE_TRIGGER")			{ set $Bit($$$mtKSysPriv,15)=1 }
		elseif $$checkid("%DROP_TRIGGER")			{ set $Bit($$$mtKSysPriv,16)=1 }
		elseif $$checkid("%NOCHECK")				{ set $Bit($$$mtKSysPriv,17)=1 }
		elseif $$checkid("%NOTRIGGER")				{ set $Bit($$$mtKSysPriv,18)=1 }
		elseif $$checkid("%NOINDEX")				{ set $Bit($$$mtKSysPriv,19)=1 }
		elseif $$checkid("%NOLOCK")					{ set $Bit($$$mtKSysPriv,20)=1 }
		elseIf $$checkid("%BUILD_INDEX")			{ set $Bit($$$mtKSysPriv,21)=1 }
		elseif $$checkid("%CREATE_ML_CONFIGURATION"){ set $Bit($$$mtKSysPriv,22)=1 }
		elseif $$checkid("%ALTER_ML_CONFIGURATION")	{ set $Bit($$$mtKSysPriv,23)=1 }
		elseif $$checkid("%DROP_ML_CONFIGURATION")	{ set $Bit($$$mtKSysPriv,24)=1 }
		elseif $$checkid("%MANAGE_MODEL")			{ set $Bit($$$mtKSysPriv,25)=1 }
		elseif $$checkid("%USE_MODEL")				{ set $Bit($$$mtKSysPriv,26)=1 }
		elseif $$checkid("%DROP_UNOWNED")			{ set $Bit($$$mtKSysPriv,27)=1 }
		elseif $$checkid("%NOJOURN")				{ set $Bit($$$mtKSysPriv,28)=1 }
		elseif $$checkid("%CANCEL_QUERY")			{ set $Bit($$$mtKSysPriv,29)=1 }
		elseif $$checkid("%MANAGE_FOREIGN_SERVER")	{ set $Bit($$$mtKSysPriv,30)=1 }
		elseif $$checkid("%USE_EMBEDDING")			{ set $Bit($$$mtKSysPriv,31)=1 }
		elseif $$checkid("%DEFER")					{ set $Bit($$$mtKSysPriv,32)=1 }
		quit:'$d($$$mtKSysPriv)
	} while $$check(",")
	RETURN
.
.
privil	; <privil> ::= <actions> ON <objcts> 
	#; <privil> ::= <LIST,role>
	if role'="yes" { do actions }
	if role'="yes" {
		new hold1,hold2,op
		do skip("ON")
		do holdcur^%qaqpsl2(.hold1)			// DPV3316+
		if $$checkid("CUBE") {	// Granting a privilege on a CUBE
			new action for action="INSERT","UPDATE","DELETE","REFERENCES","%ALTER","EXECUTE" i $d($$$mtKAction(action)) n name s name="CUBE" d error(56) QUIT
			if $$check(".") {				// GRANT ... ON CUBE.<something>, not a CUBE privilege
				do setold^%qaqpsl2(.hold1)
			}
			else {
				do holdcur^%qaqpsl2(.hold2)
				if $$check("TO") {			// GRANT ... ON CUBE TO ..., not a CUBE privilege
					do setold^%qaqpsl2(.hold1)
				}
				else {					// It IS grant of a privilege on a CUBE
					set $$$mtKAction("CUBE")=""
					do setold^%qaqpsl2(.hold2)	// go back to CUBE name beginning
				}
			}
		}
		elseif $$checkid("CUBES") {	// Granting privileges on CUBES
			new action for action="INSERT","UPDATE","DELETE","REFERENCES","%ALTER","EXECUTE" i $d($$$mtKAction(action)) n name s name="CUBE" d error(56) QUIT
			if $$check(".") {				// GRANT ... ON CUBES.<something>, not a CUBE privilege
				do setold^%qaqpsl2(.hold1)
			}
			else {
				do holdcur^%qaqpsl2(.hold2)
				if $$check("TO") {			// GRANT ... ON CUBES TO ..., not a CUBE privilege
					do setold^%qaqpsl2(.hold1)
				}
				else {					// It IS grant of a privilege on CUBES
					set $$$mtKAction("CUBE")=""
					do setold^%qaqpsl2(.hold2)	// go back to CUBE name list beginning
				}
			}
		} elseif $$anyid(" FOREIGN SERVER SERVERS ",.op) {
			if $$any(" . TO FROM ") {				
				/* This statement is actually something like:
					GRANT ... ON SERVER.<something> or "FOREIGN".<something>, not a SERVER privilege
					{ GRANT | REVOKE } ... ON SERVER { TO | FROM } ... or GRANT ON "FOREIGN" TO ..., (SERVER is unqualified object name)
					
					so it's not an actual grant/revoke of server privs
				*/
				do setold^%qaqpsl2(.hold1)
			} else {
				new action 
				// In here means this IS grant of a privilege on a foreign server
				for action="%ALTER","SELECT","INSERT","UPDATE","DELETE","REFERENCES","EXECUTE" {
					// Only allow USE for foreign servers
					if $d($$$mtKAction(action)) {
						new name 
						set name="SERVER" 
						do error(56)
						QUIT
					}
				}
				// if they specified FOREIGN skip either SERVER or SERVERS
				if op="FOREIGN", '$$checkid("SERVERS") {
					do skipid("SERVER")		// do skip on SERVER so the error message contains singular
				}
				set $$$mtKAction("SERVER")=""
			}
		} else {	// Not granting a privilege on a CUBE or SERVER
			do setold^%qaqpsl2(.hold1)
		}						// DPV3316-
		do objcts
		RETURN
	}
	do roles
	RETURN
.
.
actions ; <actions> ::= ALL PRIVILEGES | <LIST,action>
	if $$check("ALL") {
		set role=$$check("PRIVILEGES"),$$$mtKAction("*")="",role="no"
		set:$g(info) mtc(0,0,"g/r actions")=$g(mtc(0,0,"g/r actions"))_$$actid("*")_","
		RETURN
	}
	if $$check("*") {
		set $$$mtKAction("*")="",role="no"
		set:$g(info) mtc(0,0,"g/r actions")=$g(mtc(0,0,"g/r actions"))_$$actid("*")_","
		RETURN
	}
	for  {
		do action
		quit:'$$check(",")
		quit:role="yes"
	}
	RETURN
.
.
action	; <action> ::= <actyp> [ ( <LIST,colmn> ) ] | <spactyp> | <ml_config_actiontype>
		#; <actyp> ::= %ALTER | SELECT | INSERT | UPDATE | DELETE | REFERENCES
		#; <spactyp> ::= EXECUTE
		#; <ml_config_actiontype> ::= USE
	if $$check("EXECUTE") {
		set $$$mtKAction("EXECUTE")=""
		set:$g(info) mtc(0,0,"g/r actions")=$g(mtc(0,0,"g/r actions"))_"e,"
		RETURN
	}
	if $$checkid("USE") {
		set $$$mtKAction("USE")=""
		set:$g(info) mtc(0,0,"g/r actions")=$g(mtc(0,0,"g/r actions"))_"l,"
		RETURN
	}
	if role="" { set role=$s(" %ALTER DELETE SELECT INSERT UPDATE REFERENCES "'[(" "_token_" "):"yes",1:"no") quit:role="yes" }
	do error(60):'$$chose(" %ALTER DELETE SELECT INSERT UPDATE REFERENCES ",.label)
	set $$$mtKAction(label)=""
	new actid set actid=""	// DPV3184
	if $g(info) { set actid=$$actid(label),mtc(0,0,"g/r actions")=$g(mtc(0,0,"g/r actions"))_actid_"," }	// DPV3184
		#;  check for column-list, except after %ALTER/DELETE
	if "%D"'[$e(label),$$check("(") {
		for  {
			do colmn(actid)
			set $$$mtKAction(label)=$$$mtKAction(label)_val_II
			if '$$check(",") { do skip(")") quit  }
		}
	}
	RETURN
.
.
actid(action) ; Return the action identifier given the full privilege...
	RETURN:$g(action)="" ""
	new actlist,id,idlist
	set actlist="%ALTER|DELETE|SELECT|INSERT|UPDATE|REFERENCES|*"
	set idlist="a|d|s|i|u|r|a,d,s,i,u,r|"
	set id=$p(idlist,"|",$l($p(actlist,action),"|"))
	RETURN id
.
.
colmn(actid)	;     column::  colmn  ::=  [ field ]
	new lname
	set name=value,lname=lower
	do skip("ID")
	set val=$g($$$ptln(1,name))
	RETURN:val
	do putval("f"_"^"_1_"^"_name) 
	set $$$ptln(1,name)=val
	if $g(info) { set mtc(0,0,"g/r fields",actid)=$g(mtc(0,0,"g/r fields",actid))_$lb(lname) }	// DPV3157	// DPV3184
	RETURN
.
.
objcts	; <objcts> ::= <LIST,object> |
	#;             * |
	#;             SCHEMA <LIST,schema> |
	#;             <LIST,ML_Configuration_name>  -- If USE privilege without SERVER keyword
	if $d($$$mtV(1)) { do object QUIT  }  	// Only one object if granting column privileges
	if $$check("*") {
		set $$$mtFromTableName(1_I_"*")="*"
		RETURN
	}
	if $$check("SCHEMA") {
		set $$$mtKAction("zzzSCHEMA")=""
		for  {
			set $$$mtFromTableName(1_I_value)=value
			do skip("ID")
			quit:'$$check(",")
		}
		RETURN
	}
	// USE is for ML configurations and foreign servers but ML configs are always unqualified so handled specially. USE for servers can be applied to schemas!
	if $d($$$mtKAction("USE")), '$d($$$mtKAction( "SERVER")), '$d($$$mtKAction( "zzzSCHEMA")) {
		for  { do mlconfig quit:'$$check(",") }
		RETURN
	}
	for  { do object quit:'$$check(",") }
	QUIT
.
.
object	; <object> ::= [ [ [ <owner>. ] <catalog>. ] <schema>. ] <object name>
	new i,tval
	do stname^%qaqpsq(.tval)  ; Parse schema.table
	if $d($$$mtKAction("CUBE"))||($d($$$mtKAction("USE")) && '$d($$$mtKAction( "SERVER")) && '$d($$$mtKAction( "zzzSCHEMA"))) { set tval=$$$LastPiece(tval,"."),$$$mtFromTableName(1_I_tval)=tval RETURN  }	// Cubes and ML Configurations do not have schema names
	// 1^name is for tables/views, 7^name is for foreign servers (and other numbers for other object types, but those are not taken care of here...)
	set $$$mtFromTableName($select($d($$$mtKAction( "SERVER")):7,1:1)_I_tval)=tval
	RETURN
.
mlconfig	; <ml_configuration_name> ::= <object name>
	set $$$mtFromTableName("6^"_lower)=lower
	do skip("ID")
	RETURN
.
grntee	; <grntee> ::= <LIST,user>
	i $$check("*") s $$$mtUsers="*" QUIT
	f  d user("u") q:'$$check(",")
	QUIT
.
.
grantor	; <grantor> ::= <LIST,user>				// DPV3342=
	i $$check("*") s mt("grantor")="*" QUIT
	f  d user("grantor") q:'$$check(",")
	QUIT
.
.
user(type="u")	; <user> ::= PUBLIC | <username>		// DPV3342=
	If role="yes" {
		s role=$zcvt(lower,"U")
		If II_$zcvt($g($$$mtRoles),"U")[(II_role_II) { d error(55) }
		Else { s role="yes" }
	}
	if $$check("PUBLIC") { set mt(type)=$g(mt(type))_"_PUBLIC"_II QUIT }
	new i
	set i=$$check("_"),mt(type)=$g(mt(type))_lower_II
	set:%delid %delid=3
	do skip("ID")
	set:%delid=3 %delid=1
	QUIT
.
.
roles	; <roles> ::= <LIST,role>
	f  d role q:'$$check(",")
	QUIT
.
.
role	; <role> ::= <rolename>
		#; system privileges cannot be mixed with roles
	if $e(value)="%",$case(value,"%CREATE_METHOD":1,"%DROP_METHOD":1,"%CREATE_FUNCTION":1,"%DROP_FUNCTION":1,"%CREATE_PROCEDURE":1,"%DROP_PROCEDURE":1,"%CREATE_QUERY":1,"%DROP_QUERY":1,"%CREATE_TABLE":1,"%ALTER_TABLE":1,"%DROP_TABLE":1,"%CREATE_VIEW":1,"%ALTER_VIEW":1,"%DROP_VIEW":1,"%CREATE_TRIGGER":1,"%DROP_TRIGGER":1,"%DB_OBJECT_DEFINITION":1,"%NOCHECK":1,"%NOTRIGGER":1,"%NOINDEX":1,"%NOLOCK":1,"%BUILD_INDEX":1,"%CREATE_ML_CONFIGURATION":1,"%ALTER_ML_CONFIGURATION":1,"%DROP_ML_CONFIGURATION":1,"%MANAGE_MODEL":1,"%USE_MODEL":1,"%DROP_UNOWNED":1,"%NOJOURN":1,"%CANCEL_QUERY":1,"%MANAGE_FOREIGN_SERVER":1,"%USE_EMBEDDING":1,"%DEFER":1,:0) {
		new t,token
		set t="ROLE NAME",token="ADMINISTRATIVE-LEVEL PRIVILEGE IDENTIFIER ("_value_")" do error(1)
		QUIT
	}
	set $$$mtRoles=$g($$$mtRoles)_lower_II
	set:%delid %delid=3
	do skip("ID")
	set:%delid=3 %delid=1
	QUIT
.
.
 
CAST	;  Parse CAST specification here  ; MRP602
	#;---------------------------------------------------------------------
	#;  BNF:
	#;
	#;    <cast speciication> ::= CAST (<cast operand> AS <cast target>)
	#;    <cast operand> ::= <value expression> | NULL
	#;    <cast target> ::= <domain name> | <data type>
	#;    <domain name> ::= <qualified name>
	#;    <qualified name> ::= [ <schema name>. ] <qualified identifier>
	#;    <qualified identifier> ::= <identifier>
	#;    <identifier> ::= [ <introducer><character set specification> ]
	#;                      <actual identifier>
	#;    <introducer> ::= <underscore>
	#;    <data type> ::= <character string type> [ CHARACTER SET
	#;                    <character set specification> ]
	#;                  | <national character string type>
	#;                  | <bit string type>
	#;                  | <numeric type>
	#;                  | <datetime type>
	#;                  | <interval type>
	#;                  | <binary type>
	#;    <character string type> ::= CHARACTER [ (<length>) ]
	#;                              | CHAR [ (<length>) ]
	#;                              | CHARACTER VARYING (<length>)
	#;                              | CHAR VARYING (<length>)
	#;                              | VARCHAR (<length>)
	#;    <binary type> ::= BINARY [ (<length>) ]
	#;                              | BINARY VARYING [ (<length>) ]
	#;                              | VARBINARY [ (<length>) ]
	#;    <numeric type> ::= <exact numeric type> 
	#;                     | <approximate numeric type>
	#;    <exact numeric type> ::= 
	#;          NUMERIC [ (<precision [ ,<scale> ] ) ]
	#;        | DECIMAL [ (<precision [ ,<scale> ] ) ]
	#;        | DEC [ (<precision [ ,<scale> ] ) ]
	#;        | INTEGER
	#;        | INT
	#;        | SMALLINT
	#;    <approximate numeric type> ::=
	#;          FLOAT [ (<precision) ]
	#;        | REAL
	#;        | DOUBLE PRECISION
	#;    <length> ::= <unsigned integer>
	#;
	#;  NOTE:
	#;  
	#;    Currently <cast operand> must only be a <value expression>
	#;    and <cast target> must only be:
	#;         { NUMERIC[p[,s]] | FLOAT | DECIMAL[p[,s]] | DEC[p[,s]] | SMALLMONEY | MONEY | REAL
	#;           INTEGER | INT | BIGINT | SMALLINT | TINYINT | BIT |
	#;           CHAR[(len)] | CHARACTER[(len)] | NCHAR[{len)] |
	#;           VARCHAR[(len)] | CHAR VARYING[(len)] | CHARACTER VARYING[(len)] | NVARCHAR[(len)] |
	#;           DATE | TIME | TIMESTAMP | DATETIME | SMALLDATETIME | POSIXTIME
	#;           VARBINARY[(len)] | BINARY VARYING[(len)] | BINARY[(len)] |
	#;	     GUID
	#;	}
	#;
	#;---------------------------------------------------------------------
	#;  At this point, 'CAST' has been parsed
	new type,val1,val2 s type="",val2=""
	d skip("("),scalx^%qaqpslx() s val1=val d skip("AS")
	if $$IsAStream^%qaqpslx(val1) n fn,ft s ft="Scalar",fn="CAST" d error(37)  // DPV1738=
	new castas  // store cast t-to type in castas variable, then advance token
	if token="ID" { set castas=value } else { set castas=token }
	do lext
		#; if this is TSQL, there might be a systype defined via sp_addtype that the castas value needs to be swapped with.
	if $g(mt("options","source-tsql")) { set castas=$$TSQLUserType^%qarfunc(castas) }
	if castas="FLOAT"||(castas="REAL") d  d skip(")") QUIT
	. d putval("v^CAST_NUMERIC^^"_val1_"^")
	. d create^%qaqpdt(val,"op","%Library.Numeric",,,,"CAST",9) s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Numeric",,18,9)	// DPV3173 (Numeric, not Float)	// DPV3220 (18/9)
	if castas="DOUBLE" d  d skip(")") QUIT
	. d putval("v^CAST_DOUBLE^^"_val1_"^")	// DPV2667=
	. d create^%qaqpdt(val,"op","%Library.Double",,,,"CAST") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Double")
	if castas="MONEY"||(castas="SMALLMONEY") d  d skip(")") QUIT
	. d putval("v^CAST_CURRENCY^^"_val1_"^")	// DPV2667=
	. d create^%qaqpdt(val,"op","%Library.Currency",,,,"CAST") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Currency")
	if castas="NUMERIC"||(castas="DECIMAL")||(castas="DEC") {
		new prec,scale,val2,val2 s scale=15	// DPV2642=
		if $$check("(") { 
			s prec=value d scalx^%qaqpslx() s val2=val 
			If '$$check(",") { d skip(")") d putval("v^CAST_NUMERIC^^"_val1_"^"_val2_"^") } 
			Else { n val3 d scalx^%qaqpslx() s val3=val,scale=value d skip(")") d putval("v^CAST_NUMERIC^^"_val1_"^"_val2_"^"_val3_"^") } 
		}
		else { d putval("v^CAST_NUMERIC^^"_val1_"^") }
		d create^%qaqpdt(val,"op","%Library.Numeric",,,,"CAST",scale) s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Numeric",$g(prec,15),$g(prec,15),scale)
		d skip(")")
		QUIT
	}
	if castas="INTEGER"||(castas="INT") d  d skip(")") QUIT
	. d putval("v^CAST_INT^^"_val1_"^")
	. d create^%qaqpdt(val,"op","%Library.Integer",,,,"CAST") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
	if castas="BIT" d  d skip(")") QUIT
	. d putval("v^CAST_BIT^^"_val1_"^")
	. d create^%qaqpdt(val,"op","%Library.Boolean",,,,"CAST") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Boolean")
	if castas="BIGINT" d  d skip(")") QUIT
	. d putval("v^CAST_INT^^"_val1_"^")
	. d create^%qaqpdt(val,"op","%Library.BigInt",,,,"CAST") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.BigInt")
	if castas="SMALLINT" d  d skip(")") QUIT
	. d putval("v^CAST_INT^^"_val1_"^")
	. d create^%qaqpdt(val,"op","%Library.SmallInt",,,,"CAST") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.SmallInt")
	if castas="TINYINT" d  d skip(")") QUIT
	. d putval("v^CAST_INT^^"_val1_"^")
	. d create^%qaqpdt(val,"op","%Library.TinyInt",,,,"CAST") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TinyInt")
	if castas="CHAR"||(castas="CHARACTER")||(castas="NCHAR") d  d skip(")") QUIT
	. i $$check("VARYING") d  q
	.. n len s len=30,val=""
	.. i $$check("(") d scalx^%qaqpslx(),skip(")") If $e($$$mtV(val),1,2)="t^" { s len=$p($$$mtV(val),"^",2) } Else { s len=$$vallength^%qaqpslx(val) }
	.. d putval("v^CAST_VARCHAR^^"_val1_"^"_$s(val="":"",1:val_"^"))
	.. d create^%qaqpdt(val,"op","%Library.String",,,,"CAST") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",len,len)
	. n len s len=1
	. i $$check("(") d scalx^%qaqpslx(),skip(")") s val2=val If $e($$$mtV(val),1,2)="t^" { s len=$p($$$mtV(val),"^",2) } Else { s len=$$vallength^%qaqpslx(val) }
	. d putval("v^CAST_CHAR^^"_val1_"^"_$s(val2:val2_"^",1:""))
	. d create^%qaqpdt(val,"op","%Library.String",,,,"CAST") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",len,len)
	if castas="VARCHAR"||(castas="NVARCHAR") d  d skip(")") QUIT
	. n len s len=30,val=""	// DPV2667
	. i $$check("(") d scalx^%qaqpslx(),skip(")") If $e($$$mtV(val),1,2)="t^" { s len=$p($$$mtV(val),"^",2) } Else { s len=$$vallength^%qaqpslx(val) }
	. d putval("v^CAST_VARCHAR^^"_val1_"^"_$s(val="":"",1:val_"^"))
	. d create^%qaqpdt(val,"op","%Library.String",,,,"CAST") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",len,len)
	if castas="DATE" {
		d putval("v^CAST_DATE^^"_val1_"^")
		d create^%qaqpdt(val,"op","%Library.Date",,,,"CAST") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Date")
		d skip(")")
		QUIT
	}
	if castas="TIME" {
		d putval("v^CAST_TIME^^"_val1_"^")
		d create^%qaqpdt(val,"op","%Library.Time",,,,"CAST") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Time")
		d skip(")")
		QUIT
	}
	if castas="TIMESTAMP" {
		do putval("v^CAST_TIMESTAMP^^"_val1_"^")
		do create^%qaqpdt(val,"op","%Library.TimeStamp",,,,"CAST")
		set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
		d skip(")")
		QUIT
	}
	if castas="DATETIME" {
		do putval("v^CAST_DATETIME^^"_val1_"^")
		do create^%qaqpdt(val,"op","%Library.TimeStamp",,,,"CAST")
		set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
		d skip(")")
		QUIT
	}
	if castas="SMALLDATETIME" {
		do putval("v^CAST_SMALLDATETIME^^"_val1_"^")
		do create^%qaqpdt(val,"op","%Library.TimeStamp",,,,"CAST")
		set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
		d skip(")")
		QUIT
	}
	if castas="POSIXTIME" {
		do putval("v^CAST_POSIXTIME^^"_val1_"^")
		do create^%qaqpdt(val,"op","%Library.PosixTime",,,,"CAST")
		set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.PosixTime")
		do skip(")")
		QUIT
	}
	if castas="BINARY" {
		new len,val2 set val2=""
		if $$check("VARYING") {
			set len=30,val=""
			if $$check("(") {
				do scalx^%qaqpslx(),skip(")")
				if $e($$$mtV(val),1,2)="t^" { set len=$p($$$mtV(val),"^",2) }
				else { set len=$$vallength^%qaqpslx(val) }
			}
			do putval("v^CAST_VARBINARY^^"_val1_"^"_$s(val="":"",1:val_"^"))
		}
		else {
			set len=1
			if $$check("(") {
				do scalx^%qaqpslx(),skip(")")
				set val2=val
				if $e($$$mtV(val),1,2)="t^" { set len=$p($$$mtV(val),"^",2) } 
				else { set len=$$vallength^%qaqpslx(val) }
			}
			do putval("v^CAST_BINARY^^"_val1_"^"_$s(val2:val2_"^",1:""))
		}
		do create^%qaqpdt(val,"op","%Library.Binary",,,,"CAST")
		set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Binary",len,len)
		do skip(")")
		QUIT
	}
	if castas="VARBINARY" {
		new len,val2
		set len=30,val2=""
		if $$check("(") {
			do scalx^%qaqpslx(),skip(")")
			set val2=val
			if $e($$$mtV(val),1,2)="t^" { set len=$p($$$mtV(val),"^",2) } 
			else { set len=$$vallength^%qaqpslx(val) }
		}
		do putval("v^CAST_VARBINARY^^"_val1_"^"_$s(val2:val2_"^",1:""))
		do create^%qaqpdt(val,"op","%Library.Binary",,,,"CAST")
		set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Binary",len,len)
		do skip(")")
		QUIT
	}
	if castas="GUID" {
		do putval("v^CAST_GUID^^"_val1_"^")
		do create^%qaqpdt(val,"op","%Library.UniqueIdentifier",,,,"CAST") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.UniqueIdentifier")
		do skip(")")
		QUIT
	}
	do error(376)  ; Not a supported cast target
	QUIT
 
 
DollarEXTRACT	; Parse EXTRACT Function - ObjectScript $Extract (DPV2093)
	#;---------------------------------------------------------------------
	#;  BNF:
	#;
	#;    <string expression> ::=
	#;       $EXTRACT (<string expression> [,<from> [,<to>]] )
	#;
	#;  At this point, '$EXTRACT(' has been parsed
	#;
	n from,lstr,to s from="",to=""
	d scalx^%qaqpslx()	// Parse string
	i $$IsAStream^%qaqpslx(val) n fn,ft s ft="Scalar",fn="$EXTRACT (arg1)" d error(37)
	s lstr=val 
	i $$check(",") { 		// From
		d scalx^%qaqpslx() 
		If $$IsAStream^%qaqpslx(val) { n fn,ft s ft="Scalar",fn="$EXTRACT (arg2)" d error(37) } 
		s from=val 
		If $$check(",") { 	// To
			d scalx^%qaqpslx() 
			If $$IsAStream^%qaqpslx(val) { n fn,ft s ft="Scalar",fn="$EXTRACT (arg3)" d error(37) } 
			s to=val 
		}
	}
	d skip(")")
	d putval("v^$EXTRACT^^"_lstr_"^"_$s(from="":"",1:from_"^")_$s(to="":"",1:to_"^"))	// DPV2779
	d create^%qaqpdt(val,"op","%Library.String",,,,"$EXTRACT")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String")
	QUIT
 
 
DollarFNUMBER ; Parse $FNUMBER Function - ObjectScript $FNumber
	#;---------------------------------------------------------------------
	#;  BNF:
	#;
	#;    <string expression> ::=
	#;       $FNUMBER (<string expression> ,<sub-string expression> [,<position>] )
	#; 
	#;  At this point, '$FNUMBER(' has been parsed
	#;
	new decimal,expr,format
	set format="",decimal=""
	do scalx^%qaqpslx()	// Parse expr
	if $$IsAStream^%qaqpslx(val) { new fn,ft set ft="Scalar",fn="$FIND (arg1)" do error(37) }
	set expr=val
	if $$check(",")	{	// parse format
		if $$check(",") {	// $fnumber(expr,,... - format empty, now check decimal
			if $$check(")") {	// $fnumber(expr,,) - format and decimal empty, we are done
			} else {	// $fnumber(expr,,decimal) - parse decimal
				do scalx^%qaqpslx() 
				if $$IsAStream^%qaqpslx(val) { new fn,ft set ft="Scalar",fn="$FIND (arg3)" do error(37) } 
				set decimal=val
				do skip(")")
			}
		} elseif $$check(")") {	// $fnumber(expr,) - format empty, we are done
		} else { // $fnumber(expr,... - parse format
			do scalx^%qaqpslx() 
			if $$IsAStream^%qaqpslx(val) { new fn,ft set ft="Scalar",fn="$FIND (arg2)" do error(37) }
			if $$$mtV(val)'="t^" { set format=val }	// if null was specified for the format, treat it the same as not specifying anything
			if $$check(")") {	// $fnumber(exp,format), decimal empty, we are done
			} elseif $$check(",") {	// $fnumber*expr,format, - parse decimal
				if $$check(")") {	// $fnumber(exp,format,) - decimal empty, we are done
				} else {	// $fnumber(expr,format,decimal) - we are done
					do scalx^%qaqpslx() 
					if $$IsAStream^%qaqpslx(val) { new fn,ft set ft="Scalar",fn="$FIND (arg3)" do error(37) } 
					if $$$mtV(val)'="t^" { set decimal=val }	// if null was specified for the decimal, treat it the same as not specifying anything
					do skip(")")
				}
			}
		}
	} else {	// $fnumber(expr) - we are done
		do skip(")")
	}
	if format="",decimal="" { do putval("v^$FNUMBER^^"_expr_"^") }
	elseif decimal=""       { do putval("v^$FNUMBER^^"_expr_"^"_format_"^") }
	elseif format=""        { do putval("v^$FNUMBER2^^"_expr_"^"_decimal_"^") }
	else                    { do putval("v^$FNUMBER^^"_expr_"^"_format_"^"_decimal_"^") }
	do create^%qaqpdt(val,"op","%Library.String",,,,"$FNUMBER")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String")
	RETURN
 
DollarFIND ; Parse $FIND Function - ObjectScript $Find (DPV2093)
	#;---------------------------------------------------------------------
	#;  BNF:
	#;
	#;    <string expression> ::=
	#;       $FIND (<number expression> [, [<format>] [, [<decimal>]]] )
	#;
	#;  At this point, '$FIND(' has been parsed
	#;
	n pos,str,substr s pos=""
	d scalx^%qaqpslx()	// Parse string
	i $$IsAStream^%qaqpslx(val) n fn,ft s ft="Scalar",fn="$FIND (arg1)" d error(37)
	s str=val
	d skip(",")		// Search value
	d scalx^%qaqpslx() 
	i $$IsAStream^%qaqpslx(val) { n fn,ft s ft="Scalar",fn="$FIND (arg2)" d error(37) } 
	s substr=val
	If $$check(",") {	// Start After
		d scalx^%qaqpslx() 
		i $$IsAStream^%qaqpslx(val) { n fn,ft s ft="Scalar",fn="$FIND (arg3)" d error(37) } 
		s pos=val 
	}
	d skip(")")
	d putval("v^$FIND^^"_str_"^"_substr_"^"_$s(pos="":"",1:pos_"^"))	// DPV2779
	d create^%qaqpdt(val,"op","%Library.SmallInt",,,,"$FIND")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.SmallInt")
	QUIT
 
DollarLENGTH ; Parse $LENGTH Function - ObjectScript $Length (DPV2100)
	#;---------------------------------------------------------------------
	#;  BNF:
	#;
	#;    <string expression> ::=
	#;       $LENGTH (<expression> [,<delimiter>] )
	#;
	#;  At this point, '$LENGTH(' has been parsed
	#;
	n lstr,del s del=""
	d scalx^%qaqpslx()	// Parse string
	i $$IsAStream^%qaqpslx(val) n fn,ft s ft="Scalar",fn="$LENGTH (arg1)" d error(37)
	s lstr=val
	i $$check(",") {		// Position
		d scalx^%qaqpslx() 
		i $$IsAStream^%qaqpslx(val) { n fn,ft s ft="Scalar",fn="$LENGTH (arg2)" d error(37) } 
		s del=val
	}
	d skip(")")
	d putval("v^$LENGTH^^"_lstr_"^"_$s(del="":"",1:del_"^"))	// DPV2779
	d create^%qaqpdt(val,"op","%Library.SmallInt",,,,"$LENGTH")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.SmallInt")
	QUIT
 
 
DollarJUSTIFY   ; Parse $JUSTIFY Function (MRP777)
	#;---------------------------------------------------------------------
	#;  BNF:
	#;
	#;    <justify expression> ::=
	#;       $JUSTIFY (<expression>, <width> [, <decimal>] )
	#;
	#;  At this point, '$JUSTIFY(' has been parsed
	#;
	new decimal,justifyExp,width
	set decimal=""
	do scalx^%qaqpslx()	// Parse <expression>
	if $$IsAStream^%qaqpslx(val) {new fn,ft set ft="Scalar",fn="$JUSTIFY (<expression>)" do error(37)}
	set justifyExp=val 
	if '$$check(",") { new fn,fp,ft set fp=2,ft="Scalar",fn="$JUSTIFY(<expression>, <width> [, <decimal>])" do error(380) } 
	do scalx^%qaqpslx() if $$IsAStream^%qaqpslx(val) { new fn,ft set ft="Scalar",fn="$JUSTIFY (<width>)" do error(37) } set width=val 	       // <width>
	if $$check(",") {
		do scalx^%qaqpslx() if $$IsAStream^%qaqpslx(val) { new fn,ft set ft="Scalar",fn="$JUSTIFY (<decimal>)" do error(37) } set decimal=val   // <decimal>
	}
	if '$$check(")") { new fn,fp,ft set fp=4,ft="Scalar",fn="$JUSTIFY(<expression>, <width> [, <decimal>])" do error(381) }
	do putval("v^JUSTIFY^^"_justifyExp_"^"_width_"^"_$s(decimal'="":decimal_"^",1:""))
	do create^%qaqpdt(val,"op","%Library.String",,,,"JUSTIFY")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String")
	QUIT
.
DollarLIST	; Parse LIST Function - ObjectScript $List (DPV2093)
	#;---------------------------------------------------------------------
	#;  BNF:
	#;
	#;    <$LIST expression> ::=
	#;       $LIST (<list value expression> [,<from> [,<to>]] )
	#;
	#;  At this point, '$LIST(' has been parsed
	#;
	new from,lstr,to
	set from="",to=""
	do scalx^%qaqpslx()	// Parse string
