		if $$IsAStream^%qaqpslx(val) { new fn,ft set ft="Scalar",fn="$TSQL_OBJECT_ID" do error(37) }
		do putval("v^TSQL_OBJECT_ID^^"_val1_"^"_val_"^")
	}
	else { do putval("v^TSQL_OBJECT_ID^^"_val1_"^") }
	if info { set $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",128) }
	do create^%qaqpdt(val,"op","%Library.String",,,,"TSQL_OBJECT_ID")
	do skip(")")
	QUIT
 
 
	#;---------------------------------------------------------------------
	#;  Parse $TSQL_OBJECT_NAME( object_id ) Function (DPV2726)
	#;  BNF:
	#;
	#;       $TSQL_OBJECT_NAME( expression1 )
	#;
	#;  At this point, '$TSQL_OBJECT_NAME(' has been parsed
	#;
DollarTSQLOBJECTNAME		// Return object name given object id
	n pvstring s pvstring=""
	d scalx^%qaqpslx()
	i $$IsAStream^%qaqpslx(val) n fn,ft s ft="Scalar",fn="$TSQL_OBJECT_NAME" d error(37)
	d putval("v^TSQL_OBJECT_NAME^^"_val_"^")
	i info s $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",128)
	d create^%qaqpdt(val,"op","%Library.String",,,,"TSQL_OBJECT_NAME")
	d skip(")")
	QUIT
 
 
	#;---------------------------------------------------------------------
	#;  Parse $TSQL_PLUS() Function (DPV2624)
	#;  BNF:
	#;
	#;       $TSQL_PLUS( expression1 , expression2 [ { , expressionN } ])
	#;
	#;  At this point, '$TSQL_PLUS(' has been parsed
	#;
DollarTSQLPLUS		// Run-time check for + operator, may be + or ||
	n pvstring s pvstring=""
	For  { 
		d scalx^%qaqpslx()
		i $$IsAStream^%qaqpslx(val) n fn,ft s ft="Scalar",fn="$TSQL_PLUS" d error(37)
		s pvstring=pvstring_val_"^" 
		q:'$$check(",")  
	}
	d putval("v^TSQL_PLUS^^"_pvstring)
	#; i info s $$$VTRomsinfo(val)=$$definfo^%qaqpif2(type)	will be set later in %qaqpif2 so we know the type of the argument	// DPV2312+
	#;  create^%qaqpdt(val,"op",type,,,,"TSQL_PLUS") will be called later for this function in docats^%qaqpdt			// DPV2312-
	d skip(")")
	QUIT
 
	#;---------------------------------------------------------------------
	#;  Parse $TSQL_LIKE() Function (DPV2628)
	#;  BNF:
	#;
	#;       $TSQL_LIKE( expression , like_expression [ , escape_expressio ] )
	#;
	#;  At this point, '$TSQL_LIKE(' has been parsed
	#;
DollarTSQLLIKE		// Run-time TSQL LIKE check
	n esc,exp,like d scalx^%qaqpslx() s exp=val d skip(","),scalx^%qaqpslx() s like=val
	s esc="" i $$check(",") d scalx^%qaqpslx() s esc=val
	d skip(")"),putval("v^TSQL_LIKE^^"_exp_"^"_like_$s(esc'="":"^"_esc,1:"")_"^")	//,create^%qaqpdt(val,"op","%Library.TimeStamp",,,,op)
	//s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
	QUIT
 
	#;---------------------------------------------------------------------
	#;  Parse $TSQL_RTRIM_SYBASE( string-expr )
	#;  BNF:
	#;
	#;       $TSQL_RTRIM_SYBASE( expression )
	#;
	#;  At this point, '$TSQL_RTRIM_SYBASE(' has been parsed
	#;
DollarTSQLRTRIMSYBASE
	new pvstring set pvstring=""
	do scalx^%qaqpslx()
	if $$IsAStream^%qaqpslx(val) { new fn,ft set ft="Scalar",fn="$TSQL_RTRIM_SYBASE" do error(37) }
	do putval("v^TSQL_RTRIM_SYBASE^^"_val_"^")
	if info { set $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String") }
	do create^%qaqpdt(val,"op","%Library.String",,,,"TSQL_RTRIM_SYBASE")
	do skip(")")
	RETURN
 
 
	#;---------------------------------------------------------------------
	#;  Parse $TSQL_TEXTPTR() Function (DPV2630)
	#;  BNF:
	#;
	#;       $TSQL_TEXTPTR( expression )
	#;
	#;  At this point, '$TSQL_TEXTPTR(' has been parsed
	#;
DollarTSQLTEXTPTR
	d scalx^%qaqpslx(),skip(")"),putval("v^TSQL_TEXTPTR^^"_val_"^"),create^%qaqpdt(val,"op","%Library.String",,,,op)
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String")
	QUIT
	
	#;---------------------------------------------------------------------
	#;  Parse $XSQL_MATCHES() Function (DPV3176)
	#;  BNF:
	#;
	#;       $XSQL_MATCHES( expression , matches_expression [ , escape_expression ] )
	#;
	#;  At this point, '$XSQL_MATCHES(' has been parsed
	#;
DollarXSQLMATCHES	// Run-time XSQL MATCHES check
	n esc,exp,like d scalx^%qaqpslx() s exp=val d skip(","),scalx^%qaqpslx() s like=val
	s esc="" i $$check(",") d scalx^%qaqpslx() s esc=val
	d skip(")"),putval("v^XSQL_MATCHES^^"_exp_"^"_like_$s(esc'="":"^"_esc,1:""))	//,create^%qaqpdt(val,"op","%Library.TimeStamp",,,,op)
	//s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
	QUIT
