STUFF	; Parse STUFF function here (Transact-SQL)		// DPV2615
	#;---------------------------------------------------------------------
	#;	Deletes a specified length of characters and inserts another set of characters at a specified starting point
	#;   Syntax:	STUFF ( character_expression , start , length , character_expression )
	#;   Arguments:
	#;   character-expression
	#;   	Is an expression of character data. character_expression can be a constant, variable, or column of either character or binary data.
	#;   start
	#;   	Is an integer value that specifies the location to begin deletion and insertion. If start or length is negative, a null string is returned. 
	#;	If start is longer than the first character_expression, a null string is returned.
	#;   length
	#;   	Is an integer that specifies the number of characters to delete. If length is longer than the first character_expression, 
	#;	deletion occurs up to the last character in the last character_expression.
	#;   
	n origStr,start,length
	d scalx^%qaqpslx() i $$IsAStream^%qaqpslx(val) n fn,ft s ft="Scalar",fn="STUFF (arg1)" d error(37)
	s origStr=val
	d skip(","),scalx^%qaqpslx() i $$IsAStream^%qaqpslx(val) n fn,ft s ft="Scalar",fn="STUFF (arg2)" d error(37)
	s start=val
	d skip(","),scalx^%qaqpslx() If $$IsAStream^%qaqpslx(val) n fn,ft s ft="Scalar",fn="STUFF (arg3)" d error(37)
	s length=val
	d skip(","),scalx^%qaqpslx() If $$IsAStream^%qaqpslx(val) n fn,ft s ft="Scalar",fn="STUFF (arg4)" d error(37)
	d putval("v^STUFF^^"_origStr_"^"_start_"^"_length_"^"_val_"^")
	d create^%qaqpdt(val,"op","%Library.String",,,,"STUFF") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String")
	d skip(")")
	QUIT
 
 
TRIM	;  Parse TRIM function here ; MRP585 ; DPV1113 Made this not a built-in function
	#;---------------------------------------------------------------------
	#;  BNF:
	#;
	#;    <trim function>  ::= TRIM(<trim operands>)
	#;    <trim operands>  ::= [[<trim specification>][<trim character>]
	#;                           FROM] <trim source>
	#;    <trim specification> ::= LEADING | TRAILING | BOTH
	#;    <trim source>    ::= <character value expression>
	#;    <trim character> ::= <character value expression>
	#;
	#;  At this point 'TRIM' has been parsed
	#;
	new notrimspec,trimchar,trimsource,trimspec
	set trimchar=0,trimspec="",notrimspec=0
	do skip("(")                                            // Must have <paren> token
	if ",LEADING,TRAILING,BOTH,"[(","_token_",") { set trimspec=token do lext }   // <trim spec>
	else { set trimspec="BOTH",notrimspec=1 }               // default trimspec
	if token="FROM" {
		if notrimspec { do error(75) }                  // cannot just have TRIM(FROM <trim source>)
		do putval("t^ ") set trimchar=val               // trimchar not specified, default to space
	}
	else {  // see if this is the <trim character> OR <trim source>
		do scalx^%qaqpslx()
		if $$IsAStream^%qaqpslx(val) { new fn,ft set ft="Scalar",fn="TRIM" do error(37) }
		if token=")" { set trimsource=val }             // val is <trim source>
		else { set trimchar=val }                       // val is <trim character>
	}
	if trimchar {                                           // parse <trim source>
		do skip("FROM")                                 // Must have <FROM> token
		do scalx^%qaqpslx()                             // val is now <trim source>
		if $$IsAStream^%qaqpslx(val) { new fn,ft set ft="Scalar",fn="TRIM" do error(37) }
		set trimsource=val
	}
	do skip(")")                                            // Must have <paren> token
	if 'trimchar { do putval("v^TRIMSPACE_"_trimspec_"^^"_trimsource_"^") }	// default trimchar is " ", TRIM(<trimspec> <trimsource>) was specified
	else { do putval("v^TRIM_"_trimspec_"^^"_trimchar_"^"_trimsource_"^") }
	do create^%qaqpdt(val,"op","%Library.String",,,,"TRIM")	// DPV2436=
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String")
	QUIT
 
