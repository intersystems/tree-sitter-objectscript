	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
LEAST	; generate symbol-table LEAST entry
	#;    LEAST(<expression> { , <expression>  ... })
