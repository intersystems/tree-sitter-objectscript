	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
LEFT	;  generate symbol-table LEFT entry (ODBC scalar function, Sybase Compatibility)
	#;   LEFT(<string-expression>,<numeric-expression>)
