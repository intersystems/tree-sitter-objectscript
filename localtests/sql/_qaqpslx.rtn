	d putval("v^%OBJECT^^"_val_"^"),create^%qaqpdt(val,"op","%Stream.Object",,,,"%OBJECT"),skip(")")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Stream.Object")
