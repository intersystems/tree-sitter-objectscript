	d skip(")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
IFNULL	; generate symbol-table IFNULL entry (Sybase??? Compatibility)
	#;   IFNULL(<expression1>,<expression2>[,<expression3>])
	#;  At this point, 'IFNULL(' has been parsed
	n val1,val2 
