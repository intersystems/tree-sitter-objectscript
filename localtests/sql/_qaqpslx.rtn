	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
%OBJECT	;  generate symbol-table %OBJECT entry 	// DPV2994=
	#;   %OBJECT(<value expression>)
