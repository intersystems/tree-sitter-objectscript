	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ISNULL	;  generate symbol-table ISNULL entry (MS SQL Server Compatibility)
NVL	;  generate symbol-table NVL entry (ORACLE Compatibility)
	#;   ISNULL(<check_expression>,<replacement_value>)
	#;   NVL(<check_expression>,<replacement_value>)
	#;  At this point, 'ISNULL(' or 'NVL(' has been parsed
	n val1 d scalx() i $$IsAStream(val) n fn,ft s ft="Scalar",fn=op_", first argument," d error(37)  // DPV1738=
	s val1=val 
	$$$lexskip(",") d scalx() i $$IsAStream(val) n fn,ft s ft="Scalar",fn=op_", second argument," d error(37)  // DPV1738=
	$$$lexputval("v^NVL^^"_val1_"^"_val_"^")
	s:info $$$VTRomsinfo(val)=$$$VTRgetomsinfo(val1) // Type of NVL function is the same as the type of the first argument		// DPV2904=
	#; i info s $$$VTRomsinfo(val)=$$definfo^%qaqpif2(type)	will be set later in %qaqpif2 so we know the type of the argument	// DPV2312+
	#;  create^%qaqpdt(val,"op",type,,,,"NVL") will be called later for this function in docats^%qaqpdt				// DPV2312-
