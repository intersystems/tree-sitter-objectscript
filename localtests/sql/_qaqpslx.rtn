		#;  if the argument is a numeric value, we wat to use the precision for the length
	if info {
		new overlen
		if $e($$$mtV(val),1,2)="t^" { set overlen=$l($zstrip($p($$$mtV(val),"^",2),"<W")) } 
		else { new overprec set overlen=$$vallength(val,.overprec) set:overprec>overlen overlen=overprec }
	}
	new val1 set val1=val 
	d skip(","),scalx()
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="LPAD (arg2)" d error(37)
	new val2 set val2=val 
	if $$check(",") {	// optional 3rd argument
