		i $$IsAStream(val) n fn,ft s ft="Scalar",fn="LPAD (arg3)" d error(37)
		d putval("v^LPAD^^"_val1_"^"_val2_"^"_val_"^")
	}
	else {
		d putval("v^LPAD^^"_val1_"^"_val2_"^")
	}
	d create^%qaqpdt(val,"op","%Library.String",,,,"LPAD"),skip(")")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",overlen,overlen)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
LTRIM	; generate symbol-table LTRIM entry  LTRIM(<character value expression>) (Business Objects Compatibility)
