		#;  if the argument is a numeric value, we wat to use the precision for the length
	if info {
		new overlen
		if $e($$$mtV(val),1,2)="t^" { set overlen=$l($p($$$mtV(val),"^",2)) }
		else { new overprec set overlen=$$vallength(val,.overprec) set:overprec>overlen overlen=overprec }
	}
	$$$lexputval("v^LCASE^^"_val_"^") $$$lexskip(")")
	d create^%qaqpdt(val,"op","%Library.String",,,,"LCASE")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",overlen,overlen)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
LPAD	; generate symbol-table LPAD entry  LPAD(<character value expression>, <length>, [ <character value expression> ]) (Informix)
	#;  At this point, 'LPAD(' has been parsed
	d scalx()
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="LPAD (arg1)" d error(37)
