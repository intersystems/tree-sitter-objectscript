%qaqpslx	// most of SQL select-expr
	;; COMPONENTS :: SQL/PreOptimizer
	#;
#INCLUDE %msql
#IF 0   ;-------------------------------------------------------------
	; Description:   Most of SQL select-exp
	; Author:        Aviel Klausner
	; Date Started:  September 09 1987
	; 
	;  AK971   (10/17/2017) - View row identifiers for sharded outer join
	;  AK690   (02/15/2017) - Extensions for SQL manipulation of bitmaps
	;  JSL5032 - Define %NORUNTIME for use in run time plan choice implementation
	;  JSL5024 - Define marktoken routine, leave Aviel's mark alone though marktoken is almost the same logic
	;  PVA341  (12/02/2015) - Fix parsing and sqlbnf.txt for collatioins with truncation
	;  PVA304  (04/23/2014) - Support %PARTITION BY for use by parallel work units
	;  MRP777  (09/06/2013) - Implement $JUSTIFY | $TRANSLATE
	;  PVA280  (08/09/2013) - Remve CATALOG as a reserved word + many reserved word cleanups
	;  AK862   (04/02/2012) - "findname" for all tables and fields
	;  AK688   (01/24/2008) - Abstract index/filter conditions
	;  PVA242  (07/28/2011) - Support a hint (%noindex) to not use indexes to satisfy the indicated condition
	;  PVA240  (07/19/2011) - Fix problem with CREATE VIEW: <UNDEFINED>addvinf+9^%qaqpslx
	;  BJB449  (05/18/2010) - Support %PLUS and %MINUS in the query Optimizer
	;  PVA204  (10/27/2009) - Make ORDER a non reserved word
	;  AK745   (08/10/2009) - Fixes to DISTINCT/GROUP and external queries
	;  PVA183  (05/26/2009) - Pre-optimizer support for TOP...ORDER BY in subqueries
	;  PVA180  (05/19/2009) - Parse TOP ... ORDER BY in subqueries
	;  PVA181  (05/19/2009) - Allow ALL, DISTINCT, and BY to function properly as delimited identifiers
	;  DPV3382 (03/30/2009) - Support ORDER BY in INSERT...SELECT TOP ... query, correct issue with DPV3341
	;  PVA171  (03/06/2009) - Fix: 'Complex' queries with two argument form of IFNULL could produce <SUBSCRIPT> errors
	;  DPV3358 (02/03/2009) - Support GETUTCDATE
	;  DPV3341 (01/15/2009) - Support TOP clause in INSERT/SELECT, report error if TOP used in subquery
	;  DPV3336 (01/08/2009) - Implement LCASE as a regular scalar function, not just an ODBC scalar
	;  DPV3335 (01/06/2009) - Implement support for TO_TIMESTAMP Scalar function
	;  DPV3334 (01/06/2009) - Implement support for INSTR Scalar function
	;  DPV3331 (01/05/2009) - Return BINARY type for SUBSTRING(<LongVarBinary>)
	;  DPV3330 (12/30/2008) - Correct type information for SUBSTRING function
	;  DPV3284 (10/06/2008) - Correct <UNDEFINED> in ddflst in deferred compile mode
	;  DPV3261 (09/12/2008) - Allow %INTERNAL(<streamField>) as this is a no-op
	;  DPV3258 (09/11/2008) - Avoid <SUBSCRIPT> error if $p(v,"^",2,3) is long because of -> joins
	;  DPV3231 (08/05/2008) - Use process private global for ptln, ptrel
	;  DPV3220 (07/15/2008) - Improve PRECISION and SCALE reporting for Aggregates and other functions
	;  DPV3207 (06/25/2008) - Implement support for $LISTBUILD, $LISTFROMSTRING, $LISTTOSTRING scalar functions
	;  DPV3196 (06/13/2008) - Support SELECT with no from clause - implied FROM clause of %TSQL_sys.snf
	;  AK703   (06/04/2008) - Don't use "onerow" if correlated fields used
	;  DPV3173 (06/02/2008) - Some functions return Numeric or Double based on their argument
	;  DPV3176 (05/29/2008) - INFORMIX:  MATCHES Support
	;  DPV3095 (01/22/2008) - Support for column-level privileges
	;  PVA149  (10/15/2007) - Restore support of arrow syntax from view columns in post 2007.1 versions
	;  DPV3059 (10/24/2007) - Implement support for %OID() function
	;  DPV3058 (10/22/2007) - Implement support for LAST_DAY() function
	;  DPV3057 (10/22/2007) - Report error -313 if stream field found in a condition
	;  DPV3052 (10/11/2007) - {fn MOD(...)} returns %Library.Numeric, not %Library.Integer
	;  DPV3050 (10/05/2007) - Support CHAR(int-expr) scalar function
	;  DPV3046 (10/03/2007) - Allow ROUND() function in select list against table linked to SQL Server or Oracle, mark second argument as INTEGER
	;  DPV3045 (10/03/2007) - Correct type information for CASE, other functions.
	;  DPV3024 (09/24/2007) - Fix ROUND() function to return type of first argument
	;  DPV2994 (08/06/2007) - Revert stream oref change.  Implement %OBJECT()
	;  DPV2990 (08/01/2007) - Support SELECT %NOLOCK
	;  DPV2980 (07/15/2007) - Turn off POSITION as a reserved word
	;  DPV2904 (04/11/2007) - Fix return type of ISNULL/NVL
	;  DPV2903 (04/05/2007) - New type in DECODE
	;  DPV2882 (03/13/2007) - TSQL:  Support NEWID() function, Caché SQL:  Implement $TSQL_NEWID() function
	;  PVA129  (02/23/2007) - <UNDEFINED>clone+3^%qaqpnl when compiling CREATE VIEW of full outer join of two comples full outer joins
	;  DPV2851 (01/31/2007) - Implement $TSQL_RAND() function
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  JLF127  (10/27/2007) - Make treatment of %CONTAINS consistent with FOR [SOME | ALL] %ELEMENT
	;  DPV2766 (10/19/2006) - Change TO_DATE to only support conversion of string to date
	;  DPV2757 (10/11/2006) - Implement DATALENGTH as an alias for CHAR_LENGTH
	;  DPV2747 (09/28/2006) - TSQL:  Implement support for TSQL bitwise operators &, |, ^, and ~
	;  DPV2746 (09/27/2006) - TSQL: Implement OBJECT_ID() function
	;  DPV2743 (09/22/2006) - TSQL: Implement support for TSQL function INDEX_COL
	;  DPV2740 (09/20/2006) - TSQL: Implement support for COL_NAME function
	;  DPV2727 (09/07/2006) - Implement LAST_IDENTITY() function
	;  DPV2726 (09/05/2006) - TSQL: Implement support for OBJECT_NAME function
	;  DPV2724 (09/01/2006) - Enhancments and Fixes to CONVERT.  SMALLDATETIME, CHAR; Column metadata
	;  DPV2721 (08/28/2006) - Fix ALTER VIEW compilations to not crash with non-table fields in view query
	;                         SQL Fix ProdLog 52961:  ALTER VIEW crashes
	;  DPV2713 (08/11/2006) - Add support for SYSDATE
	;                         SQL Enhancement 33586: Enhancement Request - SYSDATE
	;  DPV2709 (08/02/2006) - Use default length of 30 instead of 1 for some type lengths in CONVERT
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  DPV2686 (07/05/2006) - Implement scalar function REPLACE
	;  DPV2668 (06/01/2006) - MONTH scalar function returns INTEGER, not SMALLINT
	;                         SQL Fix ProdLog 40811: MONTH function returns wrong type in metadata
	;  DPV2653 (05/17/2006) - Move CAST parsing to %qaqpsq2
	;  DPV2642 (05/09/2006) - CAST:  Use a default SCALE of 15 when CAST to DECIMAL/NUMERIC
	;                         SQL Fix ProdLog 49408: CAST as DECIMAL tests fail
	;  DPV2632 (05/02/2006) - TSQL:  Add support for CHARLEN for streams)
	;  DPV2630 (05/02/2006) - TSQL:  Add support for $TSQL_TEXTPTR()
	;  DPV2628 (04/28/2006) - TSQL:  Add support for $TSQL_LIKE()
	;  DPV2624 (04/26/2006) - TSQL:  Add support for $TSQL_PLUS() for + handling
	;  DPV2620 (04/19/2006) - Add support for $TSQL_XXX() functions
	;  DPV2618 (04/11/2006) - Add support for scalar function PATINDEX
	;  DPV2615 (04/07/2006) - Add support for scalar function CHARINDEX and STUFF
	;  DPV2614 (04/04/2006) - Fix the ROUND function
	;                         SQL Fix ProdLog 49968:  SQL ROUND function
	;  DPV2613 (04/03/2006) - Implement {fn DAY(...)} function
	;                         SQL Fix ProdLog 49961:  Can't implement year, month, day for Hibernate
	;  DPV2607 (03/07/2006) - Handle fup and xac lists that are greater than 32K in length
	;  DPV2600 (02/24/2006) - Fix output conversion values of LIST aggregates
	;                         SQL Fix ProdLog 49267: LIST function fails with a list field in DocBook/Studio
	;  DPV2578 (01/25/2006) - Make TOP a reserved word
	;                         SQL Fix ProdLog 48567: Can't use top as column name
 	;  DPV2574 (01/17/2006) - Support prec/scale for DEC, DECIMAL, NUMERIC in CAST
	;                         SQL Fix ProdLog 41412: Support for Parameters for DECIMAL Datatype
	;  DPV2546 (11/08/2005) - Implement new MVR collation function.  Change collation implementations to use $zu(28)
	;  DPV2534 (10/12/2005) - Fix <UNDEFINED> in star1 when upp not defined
	;  DPV2531 (10/05/2005) - Support BIGINT in CAST
	;  DPV2312 (10/26/2004) - Fix type reported for functions NVL, ISNULL, IFNULL, NULLIF, and COALESCE
	;  DPV2309 (10/14/2004) - Fix <SUBSCRIPT> error when compiling unqualified CREATE VIEW as SELECT * ... from class method
	;  PVA070  (09/30/2004) - 'SELECT *' query with joins on single column idkey columns does not work properly. 
	;  DPV2288 (09/15/2004) - Add Support for STR(float-expr[, length [, decimal ]])
	;  DPV2287 (09/15/2004) - Add Support for ISNUMERIC(expr)
	;  DPV2286 (09/14/2004) - Add Support for LEN(string-expr)
	;  DPV2285 (09/14/2004) - Add Support for REPLICATE(string-expr,integer-expr)
	;  DPV2284 (09/14/2004) - Add Support for REVERSE(string-expr)
	;  DPV2282 (09/14/2004) - Add support for new TSQL functions POWER, CEILING, FLOOR, ASCII, YEAR, MONTH, DAY
