	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
JSONOBJECT        ; generate symbol-table JSON_OBJECT entry
	#;  <JSON object constructor> ::=
	#;    JSON_OBJECT <left paren>
	#;        [ <JSON name and value> [ { <comma> <JSON name and value> }... ]
	#;        [ <JSON object null clause> ] ]
	#;        [ <JSON output clause> ]				// ** NOT SUPPORTED AT THIS TIME **
	#;        <right paren>
	#;  <JSON name and value> ::=
	#;    <JSON name> <colon> <JSON value expression>
	#;  <JSON name> ::=
	#;    <character value expression>
	#;  <JSON object null clause> ::=
	#;      NULL ON NULL
	#;    | ABSENT ON NULL
	#;
	#;  <JSON output clause> ::=					// ** NOT SUPPORTED AT THIS TIME **
	#;    RETURNING <data type> [ FORMAT <JSON representation> ]
	#;  <JSON representation> ::=
	#;      JSON [ ENCODING { UTF8 | UTF16 | UTF32 } ]
	#;    | <implementation-defined JSON representation option>
	#;  <implementation-defined JSON representation option> ::=
	#;  !! See the Syntax Rules.
	#;	
	#;  At this point JSON_OBJECT( has been parsed
	#;  For now JSON_OBJECT always returns a VARCHAR
	#;    Builds $$$mtV(val)=v^JSON_OBJECT^^key1^val1^key2^val2^...^keyN^valN
	#;     or
	#;    Builds $$$mtV(val)=v^JSON_OBJECT_ABSENT^^key1^val1^key2^val2^...^keyN^valN
	new conversion,func,pvstring
	set pvstring="",func="JSON_OBJECT"
	if $$check(")") { 	// JSON_OBJECT()
		do putval("t^")
		set pvstring=val_"^"
	}
	else {
		new %mmmJSONOBJECT
		set conversion=$Case(mt("sqlcomp"),"%ODBC":"%ODBCOUT","%EXTERNAL":"%EXTERNAL","%Runtime":"%RUNTIMEOUT","%FDBMS":"%EXTERNAL",:"")
		for  {
			set %mmmJSONOBJECT=1
			do scalx()
			if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="JSON_OBJECT" do error(37) }
			set:conversion'="" val=$$putunary(val,conversion)
			set pvstring=pvstring_val_"^" 
			do skip(":")
			kill %mmmJSONOBJECT
			do scalx()
			if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="JSON_OBJECT" do error(37) }
			set:conversion'="" val=$$putunary(val,conversion)
			set pvstring=pvstring_val_"^"
			if '$$check(",") { quit }
		}
		if $$check("NULL") { do skip("ON"),skip("NULL") }
		elseif $$checkid("ABSENT") { do skip("ON"),skip("NULL") set func="JSON_OBJECT_ABSENT" }
		do skip(")")
	}
	do putval("v^"_func_"^^"_pvstring)
	do create^%qaqpdt(val,"op","%Library.String",,,,"JSON_OBJECT")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
JSONARRAY        ; generate symbol-table JSON_ARRAY entry
	#;
	#;  <JSON array constructor by enumeration> ::=
	#;    JSON_ARRAY <left paren>
	#;        [ <JSON value expression> [ { <comma> <JSON value expression> }... ]
	#;        [ <JSON array null clause> ] ]
	#;        [ <JSON output clause> ]		// ** NOT SUPPORTED AT THIS TIME **
	#;        <right paren>
	#;
	#;  <JSON array null clause> ::=
	#;      NULL ON NULL
	#;    | ABSENT ON NULL
	#;
	#;  <JSON array constructor by query> ::=	// ** NOT SUPPORTED AT THIS TIME **
	#;    JSON_ARRAY <left paren>
	#;        <query expression>
	#;        [ <JSON input clause> ]
	#;        [ <JSON array null clause> ]
	#;        [ <JSON output clause> ]
	#;  
	#;      <right paren>
	#;  
	#;  <JSON output clause> ::=			// ** NOT SUPPORTED AT THIS TIME **
	#;    RETURNING <data type> [ FORMAT <JSON representation> ]
	#;  <JSON representation> ::=
	#;      JSON [ ENCODING { UTF8 | UTF16 | UTF32 } ]
	#;    | <implementation-defined JSON representation option>
	#;  <implementation-defined JSON representation option> ::=
	#;  !! See the Syntax Rules.
	#;  
	#;	-- NULL ON NULL is default behavior
	#;
	#;  At this point JSON_ARRAY( has been parsed
	#;  For now JSON_ARRAY always returns a VARCHAR
	#;    Builds $$$mtV(val)=v^JSON_ARRAY^^val1^val2^...^valN
	#;     or
	#;    Builds $$$mtV(val)=v^JSON_ARRAY_ABSENT^^val1^val2^...^valN
.
	new conversion,func,pvstring
	set pvstring="",func="JSON_ARRAY"
	if $$check(")") { 	// JSON_ARRAY()
		do putval("t^")
		set pvstring=val_"^"
	}
	else {
		set conversion=$Case(mt("sqlcomp"),"%ODBC":"%ODBCOUT","%EXTERNAL":"%EXTERNAL","%Runtime":"%RUNTIMEOUT","%FDBMS":"%EXTERNAL",:"")
		for  {
			do scalx()
			if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="JSON_ARRAY" do error(37) }
			set:conversion'="" val=$$putunary(val,conversion)
			set pvstring=pvstring_val_"^" 
			if '$$check(",") { quit }
		}
		if $$check("NULL") { do skip("ON"),skip("NULL") }
		elseif $$checkid("ABSENT") { do skip("ON"),skip("NULL") set func="JSON_ARRAY_ABSENT" }
		do skip(")")
	}
	do putval("v^"_func_"^^"_pvstring)
	do create^%qaqpdt(val,"op","%Library.String",,,,"JSON_ARRAY")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String")
	QUIT
