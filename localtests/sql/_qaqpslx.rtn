	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="IFNULL (arg1)" d error(37)  // DPV1738=
	s val2=val 
	d skip(","),scalx() 
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="IFNULL (arg2)" d error(37)  // DPV1738=
	s val1=val,val=""
	If $$check(",") d scalx() If $$IsAStream(val) n fn,ft s ft="Scalar",fn="IFNULL (arg3)" d error(37)
	d putval("v^IFNULL^^"_val2_"^"_val1_"^"_$s(val:val_"^",1:""))
	#; i info s $$$VTRomsinfo(val)=$$definfo^%qaqpif2(type)	will be set later in %qaqpif2 so we know the type of the argument	// DPV2312+
	#;  create^%qaqpdt(val,"op",type,,,,"IFNULL") will be called later for this function in docats^%qaqpdt				// DPV2312-
	d skip(")")
