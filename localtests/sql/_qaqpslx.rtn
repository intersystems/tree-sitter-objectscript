	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
PREDICT	; Parse PREDICT function here.  PREDICT is part of the machine language functions
	#;  
	#;   PREDICT ( model-name [ <use> ][ <predict-with> ] )
	#;              <use> ::= USE trained-model-name
	#;		<predict-with> ::= WITH value-name = field-expr { , value-name2 = field-expr2 }
	#;                                 | WITH ( field-expr { , field-expr2 } )
	#;      model-name ::= <ident>
	#;
	#;  At this point, 'PREDICT(' has been parsed
	#;
PROBABILITY	;
	#; Parse PROBABILITY function here.  PROBABILITY is part of the machine language functions
	#;  
	#;   PROBABILITY ( model-name [ <use> ] [ <for> ] [ <predict-with> ] )
	#;              <use> ::= USE trained-model-name
	#;              <for> ::= FOR <expression>
	#;		<predict-with> ::= WITH value-name = field-expr { , value-name2 = field-expr2 }
	#;                                 | WITH ( field-expr { , field-expr2 } )
	#;      model-name ::= <ident>
	#;
	#;  At this point, 'PROBABILITY(' has been parsed
	#;
	new col,for,i,model,modelname,pctype,provider,providerIoC,trainedmodelname,use,vallist,valuename,withnames
		#; parse model name
.
	set modelname=lower
	do putval("t^"_lower)
	do skip("ID")
	set model=val
		#; parse optional USE <trained-mode-name>
	if $$checkid("USE") {
		set trainedmodelname=lower
		do putval("t^"_lower)
		do skip("ID")
	} else { 
		set trainedmodelname=""
		do putval("t^")
	}
	set use=val
	if op="PROBABILITY" {
		if $$check("FOR") { do varcon } else { do putval("t^1") }
		set for=val
	}
	set vallist=""
	
		// look up whether or not this trained model (or the default trained model) use Inversion of Control (IoC)
	if 'info {
		set providerIoC=$$GetProviderIoC^%apiDDL(modelname,trainedmodelname,.provider) 
		if providerIoC=$c(0) { do error(181) }
		if providerIoC=$c(1) { do error("181b") }
		if providerIoC=$c(2) { do error(184) }
		if providerIoC=$c(3) { do error(191) }
	} else {
		new actualtrainedmodelname
		set providerIoC=$$GetProviderIoC^%apiDDL(modelname,trainedmodelname,.provider,.actualtrainedmodelname)
		if providerIoC=$c(0),$g(callname)'="tablist" { do error(181) }
		if providerIoC=$c(1),$g(callname)'="tablist" { do error("181b") }
		if providerIoC=$c(2),$g(callname)'="tablist" { do error(184) }
		if providerIoC=$c(3),$g(callname)'="tablist" { do error(191) }
		set mtc(0,0,"model",$$$UPPER(actualtrainedmodelname))=modelname_$c(1)_actualtrainedmodelname
		set:info $li(mtc(0,0,"syspriv"),9)=1		// %USE_MODEL priv flag
	}
	
	if $$check("WITH") {
			#; withnames is primed with the model's with columns
			#; Now will will fill in the val numbers for the expressions for each column specified in PREDICT
			#; the columns not specified we will inject into the PREDICT function as if they were specified
			#; the format of the withname() is:
			#;	withnames(0,$$$LOWER(with-column-name))=withexpr (withexpr will be turned into with-expr-val# in %qaqpslx)
			#;	withnames(0,$$$LOWER(with-column-name),1)=withtype
			#;	withnames(1,with-column-position)=with-column-name
		set i=$$GetModelWithColumns^%apiDDL(modelname,1,.withnames,.pctype)
		if i=$c(0),$g(callname)'="tablist" { do error(181) }
				
		if $$check("(") {		// WITH ( field-expr { , field-expr2 } )
			set col=0,vallist="^"
			do {
				set col=col+1
				if '$d(withnames(1,col)),$g(callname)'="tablist" { new t set t="<End of WITH expression list>" do error(1) }  // too many with expression values
				if $case(token,",":1,")":1,:0) {	// empty with expression, use expression from model for this position
					set valuename=withnames(1,col)
					set withexpr=$g(withnames(0,$$$LOWER(valuename)))
					set:withexpr="" withexpr=1
					do parseInject(withexpr,.vallist)
				} else {
					do scalx() if $$IsAStream(val) { new fn,ft set ft="Scalar",fn=op_" (...,field-expr)" do error(37) }
					set vallist=vallist_val_"^"
					set valuename=withnames(1,col)
					set $$$mtQuickMLValTypeCheck(val)=$g(withnames(0,$$$LOWER(valuename),1))	// check in %qaqpqo if the type of this value matches the WithColumnType
				}
			} while $$check(",")
			if $d(withnames(1,col+1)) { new t set t="<More WITH expressions>" do error(1) }  // too few with expression values
			do skip(")")
			if (op="PREDICT") { do putval("v^PREDICT^^"_model_"^"_use_vallist) } 		// vallist should have a leading "^" 
			else            { do putval("v^PROBABILITY^^"_model_"^"_use_"^"_for_vallist) }	// vallist should have a leading "^"
			set $$$mtQuickML(m)=$g($$$mtQuickML(m))_$LB(val)
		} else {			// WITH value-name = field-expr { , value-name2 = field-expr2 }
			do {
					#; parse and record the explicit with-column-name and expression
				set valuename=lower
				do skip("ID")
				do skip("=")
				do scalx()		// parse field-expr
				if $$IsAStream(val) { new fn,ft set ft="Scalar",fn=op_" (... WITH ... field-expr)" do error(37) }
				set withnames(0,$$$LOWER(valuename))=val
				set $$$mtQuickMLValTypeCheck(val)=$g(withnames(0,$$$LOWER(valuename),1))	// check in %qaqpqo if the type of this value matches the WithColumnType
			} while $$check(",")
				#; withnames() includes all of the with columns and the expression vals explicitly specified in PREDICT
				#; We now need to get the names of any with-columns from the model definition that are missing and inject them into the function
			set valuename=""
			for  {
				set valuename=$o(withnames(0,valuename)) quit:valuename=""
				continue:withnames(0,valuename)	// positive value means this is already a val# and this with-name was specified in PREDICT
				do parseInject(withnames(0,valuename),.vallist)
				set withnames(0,valuename)=+vallist
			}
				#; Now get the list of values for predict in the correct order
			set vallist="^"
			for  {
				set valuename=$o(withnames(1,valuename)) quit:valuename=""
				set vallist=vallist_withnames(0,$$$LOWER(withnames(1,valuename)))_"^"
			}
			if (op="PREDICT") { do putval("v^PREDICT^^"_model_"^"_use_vallist) }
			else            { do putval("v^PROBABILITY^^"_model_"^"_use_"^"_for_vallist) }
			set $$$mtQuickML(m)=$g($$$mtQuickML(m))_$LB(val)
		}
	} else {	// no given WITH clause
		new withcolumnlist
		set withcolumnlist=$$GetModelWithColumns^%apiDDL(modelname,,,.pctype)
		if withcolumnlist=$c(0),$g(callname)'="tablist" { do error(181) }
		if withcolumnlist'="" {
			do parseInject(withcolumnlist,.vallist)
		}
		if (op="PREDICT") { do putval("v^PREDICT^^"_model_"^"_use_"^"_vallist) } /////////
		elseif (op="PROBABILITY") { do putval("v^PROBABILITY^^"_model_"^"_use_"^"_for_"^"_vallist) }
		set $$$mtQuickML(m)=$g($$$mtQuickML(m))_$LB(val)
	}
	do skip(")") /////////
	if (op="PREDICT") {
		set pctype=$$GetIRISTypeName^%ourODBC($lg(pctype))
		do create^%qaqpdt(val,"op",pctype,,,,"PREDICT")
		if info { set $$$VTRomsinfo(val)=$$definfo^%qaqpif2(pctype) }
			// This GUID is the index we will use to hold ML Model and TrainedModel oref(s) for this PREDICT function.
		else { set mt("qmlcontext",val)=$$newval("t^"_$SYSTEM.Util.CreateGUID()) }
	} elseif (op="PROBABILITY") {
		do create^%qaqpdt(val,"op","%Library.Double",,,,"PROBABILITY")
		set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Double")
	}
	RETURN
.
		// parse a comma list of field names as if they were specified next in the statement
parseInject(fieldlist,&vallist)
	new c,f,floc,input,label,likeerr,likeesc,likepat,line,lineprev,logic,lower,mask,more,n,name,p,pprev,prevtoken,rest,rw,sql,sldst,switch,token,val,value,i,ext,setqexp,jointype,tsq,firsttbl,lexp
	set floc=""
	//kill $$$ptlnRoot // Just in case, we used to NEW ptln here
	set input=1,(input(1),sql)=fieldlist,line=1,more=0,f=0,p=0
	do first,lext
	do {
		do scalx()
		set vallist=vallist_val_"^"
	} while $$check(",")
	RETURN
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
RADIANS	;   Returns the corresponding angle in RADIANS for an angle specified in degrees
	#;   Syntax    RADIANS ( numeric_expression )
	#;   Arguments:
	#;       numeric_expression - Degrees to be converted to radians
	#;  At this point RADIANS( has been parsed
	#;
	Do PGen1ArgInt("RADIANS",$c(0),0) QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
REPEAT	; generate symbol-table REPEAT entry   REPEAT(<character value expression>,<integer expression>) (Sybase Compatibility)
REPLICATE ; Parse REPLICATE(<character value expression>,<integer expression>) (TSQL Compatibility)	// DPV2285
	#;  At this point, 'REPEAT(' or 'REPLICATE(' has been parsed
	d scalx() 
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn=op_", first argument," d error(37)  // DPV1738=
	n val1 s val1=val d skip(","),scalx()
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn=op_", second argument," d error(37)  // DPV1738=
	#;  Try to get an accurate length for the column
	if info {
		new overlen s overlen=255
		if $e($$$mtV(val),1,2)="t^"&&($e($$$mtV(val1),1,2)="f^") { 
			set overlen=$$vallength(val1,.overprec)
			set:overprec>overlen overlen=overprec
			set overlen=overlen*$p($$$mtV(val),"^",2)
		}
		elseif $e($$$mtV(val),1,2)="t^"&&($e($$$mtV(val1),1,2)="t^") {
			set overlen=$p($$$mtV(val1),"^",2)*$p($$$mtV(val),"^",2)
		}
	}
	d putval("v^REPEAT^^"_val1_"^"_val_"^")
	d create^%qaqpdt(val,"op","%Library.String",,,,"REPEAT"),skip(")")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",overlen,overlen)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
REPLACE	;   Replaces all occurrences of the second given string expression in the first string expression with a third expression. (DPV2686)
	#;   Syntax    REPLACE ( string_expression1 , string_expression2 , string_expression3 )
	#;   Arguments:
	#;	'string_expression1'
	#;		Is the string expression to be searched. string_expression1 can be of character or binary data.
	#;	'string_expression2'
	#;		Is the string expression to try to find. string_expression2 can be of character or binary data.
	#;	'string_expression3'
	#;		Is the replacement string expression string_expression3 can be of character or binary data.
	#;
	n exp1,exp2
	d scalx() i $$IsAStream(val) n fn,ft s ft="Scalar",fn="REPLACE (arg1)" d error(37)
	s exp1=val 
	d skip(","),scalx() i $$IsAStream(val) n fn,ft s ft="Scalar",fn="REPLACE (arg2)" d error(37)
	s exp2=val
	d skip(","),scalx() i $$IsAStream(val) n fn,ft s ft="Scalar",fn="REPLACE (arg3)" d error(37)
	d putval("v^REPLACE^^"_exp1_"^"_exp2_"^"_val_"^")
	d create^%qaqpdt(val,"op","%Library.String",,,,"REPLACE")
	if info {
		new overlen,overprec
		set overlen=$case($e($$$mtV(exp1),1,2),"t^":$l($p($$$mtV(val),"^",2)),"f^":$$vallength(exp1,.overprec),:255)
		set:$g(overprec)>overlen overlen=overprec
		set $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",overlen,overlen)
	}
	d skip(")")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
REVERSE	;   Returns the reverse of a character expression. (DPV2284)
	#;   Syntax    REVERSE ( character_expression )
	#;   Arguments:
	#;       character_expression - Is an expression of type %String
	#;
	Do PGen1ArgInt("REVERSE","%Library.String",0) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
RIGHT	; generate symbol-table RIGHT entry (ODBC scalar function, Sybase Compatibility)
	#;   RIGHT(<string-expression>,<numeric-expression>)
	#;  At this point, 'RIGHT' has been parsed
	n val1 d skip("("),scalx() 
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="RIGHT (arg1)" d error(37)  // DPV1738=
	s val1=val d skip(","),scalx(),skip(")")
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="RIGHT (arg2)" d error(37)  // DPV1738=
	d putval("v^RIGHT^^"_val1_"^"_val_"^"),create^%qaqpdt(val,"op","%Library.String",,,,"RIGHT")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ROUND	; generate symbol-table ROUND entry (ODBC scalar function, Sybase & SQL Server Compatibility)
	#;   RIGHT(<numeric-expression>,<integer-expression>[,<integer-expression>])
	#;  At this point, 'ROUND(' has been parsed
	#;    From TSQL Docs:
	#;     ROUND ( numeric_expression , length [ , function ] )
	#;     	numeric_expression
	#;     		Is an expression of the exact numeric or approximate numeric data type category, except for the bit data type.
	#;      length
	#;     		Is the precision to which numeric_expression is to be rounded. length must be tinyint, smallint, or int. 
	#;		When length is a positive number, numeric_expression is rounded to the number of decimal places specified by length. 
	#;		When length is a negative number, numeric_expression is rounded on the left side of the decimal point, as specified by length.
	#;      function
	#;     		Is the type of operation to perform. function must be tinyint, smallint, or int. When function is omitted or has a value of 0 (default), 
	#;		numeric_expression is rounded. When a value other than 0 is specified, numeric_expression is truncated.
	#;
	n val1,val2 d scalx() // numeric-expression
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="ROUND (arg1)" d error(37)  // DPV1738=
	s val1=val d skip(","),scalx()	// integer-expression (length)
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="ROUND (arg2)" d error(37)  // DPV1738=
	s val2=val,val=0
	i $$check(",") d scalx() i $$IsAStream(val) n fn,ft s ft="Scalar",fn="ROUND (arg2)" d error(37)	// integer-expression (function) (DPV2614)
	d skip(")")
	d putval("v^ROUND^^"_val1_"^"_val2_"^"_$s(val:val_"^",1:""))	// DPV3024 ,create^%qaqpdt(val,"op","%Library.Float",,,,"ROUND") will be set later in %qaqpif2 so we know the type of the argument
		#; Mark the second argument to ROUND an an Integer in the parser tree - fixes ProdLog 51569
	d create^%qaqpdt(val2,,"%Library.Integer",,,,"ROUND") s:info $$$VTRomsinfo(val2)=$$definfo^%qaqpif2("%Library.Integer")	// DPV3046
	#; DPV3024 s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Float") - will be called later for this function in docats^%qaqpdt
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
RPAD	; generate symbol-table RPAD entry  RPAD(<character value expression>, <length>, [ <character value expression> ]) (Informix)
	#;  At this point, 'RPAD(' has been parsed
	d scalx()
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="RPAD (arg1)" d error(37)
		#;  Try to get an accurate length for the column
		#;  if the argument is a numeric value, we wat to use the precision for the length
	if info {
		new overlen
		if $e($$$mtV(val),1,2)="t^" { set overlen=$l($zstrip($p($$$mtV(val),"^",2),"<W")) } 
		else { new overprec set overlen=$$vallength(val,.overprec) set:overprec>overlen overlen=overprec }
	}
	new val1 set val1=val 
	d skip(","),scalx()
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="RPAD (arg2)" d error(37)
	new val2 set val2=val 
	if $$check(",") {	// optional 3rd argument
		d scalx()
		i $$IsAStream(val) n fn,ft s ft="Scalar",fn="RPAD (arg3)" d error(37)
		d putval("v^RPAD^^"_val1_"^"_val2_"^"_val_"^")
	}
	else {
		d putval("v^RPAD^^"_val1_"^"_val2_"^")
	}
	d create^%qaqpdt(val,"op","%Library.String",,,,"RPAD"),skip(")")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",overlen,overlen)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
RTRIM	; generate symbol-table RTRIM entry   RTRIM(<character value expression>) (Business Objects Compatibility)
	#;  At this point, 'RTRIM(' has been parsed
	d scalx()
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="RTRIM" d error(37)  // DPV1738=
		#;  Try to get an accurate length for the column
	if info {
		new overlen
		if $e($$$mtV(val),1,2)="t^" { set overlen=$l($zstrip($p($$$mtV(val),"^",2),">W")) }
		else { new overprec set overlen=$$vallength(val,.overprec) set:overprec>overlen overlen=overprec }
	}
	$$$lexputval("v^RTRIM^^"_val_"^")
	d create^%qaqpdt(val,"op","%Library.String",,,,"RTRIM") $$$lexskip(")")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",overlen,overlen)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
SEARCHINDEX	;  generate symbol-table SEARCH_INDEX entry  SEARCH_INDEX(<index_name> { , <scalx> ... })
	#;  At this point, 'SEARCH_INDEX(' has been parsed
	new indexName,pvstring
	set pvstring=""
	set indexName=$$parseIndexRef^%qaqpsq(0)	// Parse the index name
	for  {
		quit:'$$check(",")
		do scalx()
		set pvstring=pvstring_val_"^"
	}
	d putval("v^SEARCH_INDEX:"_indexName_"^^"_pvstring)
	set mt("search_index", indexName, val) = m // add entry to mt to keep track of query block of search_index statements
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")	// The ODBCTYPE of %SQL.AbstractFind is INTEGER, I wonder if this is OK?
	do create^%qaqpdt(val,"op","%Library.Integer",,,,"SEARCH_INDEX")
	do skip(")")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
SIGN	;  generate symbol-table SIGN entry  SIGN(<numeric_exp>)
	#;  At this point, 'SIGN(' has been parsed
	Do PGen1ArgInt("SIGN","%Library.SmallInt",0) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
%SIMILARITY
	new val1,val2,fval1,fval2
	do scalx() set fval1=val
	do skip(",")
	do scalx() set fval2=val
	do skip(")")
	if ($$$mtVType($$$mtV(fval1))'="f"),($$$mtVType($$$mtV(fval2))="f") {
		do putval("v^CreateQList^^"_fval1_"^^")
		do putval("v^METHOD:*Similarity^^"_fval2_"^"_val_"^") 
	} else {
		do putval("v^CreateQList^^"_fval2_"^^")
		do putval("v^METHOD:*Similarity^^"_fval1_"^"_val_"^") 
	}
	do create^%qaqpdt(val,"op","%Library.Numeric",,,,"%SIMILARITY",18) 			// DPV3228
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Numeric",21,19,18)		// DPV3238
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
SPACE	; generate symbol-table SPACE entry  SPACE(<integer_exp>)
	#;  At this point, 'SPACE' has been parsed
	n val1
	d skip("("),scalx()
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="SPACE" d error(37)  // DPV1738=
	d putval("v^SPACE^^"_val_"^"),create^%qaqpdt(val,"op","%Library.String",,,,"SPACE")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String")
	d skip(")")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
SQRT	;  generate symbol-table SQRT entry  SQRT(<numeric_exp>)
	#;  At this point, 'SQRT(' has been parsed
	Do PGen1ArgInt("SQRT",$c(0),0) QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
SQUARE	;  generate symbol-table SQUARE entry  SQUARE(<numeric_exp>)
	#;  At this point, 'SQUARE(' has been parsed
	#;  We'll treat SQUARE(x) the same as x*x
	do scalx()
	if $$IsAStream(val) n fn,ft s ft="Scalar",fn="SQUARE" d error(37)
	do putval("v^*^^"_val_"^"_val_"^")
	d skip(")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
STR	; generate symbol-table STR entry  STR ( float-expr [ , length [ , decimal ] ] )	// DPV2288
	#;  At this point, 'STR(' has been parsed
	n lenval,val1 s lenval=""
	d scalx()
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="STR(arg1)" d error(37)
	s val1=val_"^" 
	If $$check(",") {	// Length
		d scalx() s lenval=val
		i $$IsAStream(val) n fn,ft s ft="Scalar",fn="STR (arg2)" d error(37)
		s val1=val1_val_"^"
		If $$check(",") {	// Decimal
			d scalx()
			i $$IsAStream(val) n fn,ft s ft="Scalar",fn="STR (arg3)" d error(37)
			s val1=val1_val_"^"
		}
	}
	  #;  Try to get an accurate length for the column
	If lenval="" { s overlen=10 }
	ElseIf $e($$$mtV(lenval),1,2)="t^" { s overlen=$p($$$mtV(lenval),"^",2) }
	Else { s overlen=31 }	// Choose 31 as length for case where len argument is not a constant.
	d putval("v^STR^^"_val1),create^%qaqpdt(val,"op","%Library.String",,,,"STRING")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",overlen,overlen)
	d skip(")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
STRING	; generate symbol-table STRING entry  STRING(<string1>[,string2,...,stringN])
	#;  At this point, 'STRING(' has been parsed
	n i,val1
	d scalx()
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="STRING (arg1)" d error(37)  // DPV1738=
	s val1=val_"^" 
	For i=2:1 {	// DPV1942=
		q:'$$check(",")  
		d scalx() 
		i $$IsAStream(val) n fn,ft s ft="Scalar",fn="STRING (arg"_i_")" d error(37)  // DPV1738=
		s val1=val1_val_"^"
	}
	d putval("v^STRING^^"_val1),create^%qaqpdt(val,"op","%Library.String",,,,"STRING")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String")
	d skip(")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
STUFF	GOTO STUFF^%qaqpsq2		// DPV2615
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
SUBSTR	; Parse SUBSTR function here ; DPV1113 - Implemented for compatibility with Oracle
	#;---------------------------------------------------------------------
	#;  BNF:
	#;
	#;       SUBSTR (<character value expression> ',' <start position> [ ',' <string length> ] )
	#;    <start position> ::= <numeric value expression>
	#;    <string length>  ::= <numeric value expression>
	#;
	#;  Returns a portion of charvalexp, beginning at character 
	#;  <start position>, <string length> characters long. 
	#;  If <start position> is 0, it is treated as 1. 
	#;  If <start position> is positive, Oracle7 counts from the beginning of <character value expression>
	#;  to find the first character. If <start position> is negative, Oracle7 counts backwards from the end 
	#;  of <character value expression>. If <string length> is omitted, Oracle7 returns all characters to the end of 
	#;  <character valeu expression>. If <string length> is less than 1, a NULL is returned.
	#;  Floating point numbers passed as arguments to SUBSTR are automatically converted to integers.
	#;
	#;  At this point 'SUBSTR(' has been parsed
	#;
	new toend,v1,v2,v3
	d scalx() s v1=val
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="SUBSTR (arg1)" d error(37)  // DPV1738=
	$$$lexskip(",")
	d scalx() s v2=val
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="SUBSTR (arg2)" d error(37)  // DPV1738=
	i $$check(")") d putval("t^"_$$$MaxLocalLength) s v3=val,toend=1
	e  $$$lexskip(",") d scalx() $$$lexskip(")") s v3=val,toend=0 i $$IsAStream(val) n fn,ft s ft="Scalar",fn="SUBSTR (arg3)" d error(37)  // DPV1738=
		#;  Try to get an accurate length for the column
	if info {
		new overlen,overprec
		if $$$mtV(v3)?1"t^".n,'toend { set overlen=$p($$$mtV(v3),"^",2) }
		else { set overlen=$$vallength(v1,.overprec) set:overprec>overlen overlen=overprec }
	}
	$$$lexputval("v^SUBSTR^^"_v1_"^"_v2_"^"_v3_"^") d create^%qaqpdt(val,"op","%Library.String",,,,"SUBSTR")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",overlen,overlen)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
SUBSTRING       ; Parse SUBSTRING function here ; MRP580 ; DPV1113 - Made it not a built-in function
	#;---------------------------------------------------------------------
	#;  BNF:
	#;
	#;    <character value function> ::=
	#;       SUBSTRING (<character value expression> { FROM | ',' } <start position>
	#;                 [ { FOR | ',' } <string length> ] )
	#;    <start position> ::= <numeric value expression>
	#;    <string length>  ::= <numeric value expression>
	#;
	#;  At this point 'SUBSTRING' has been parsed
	#;
	n flag,overlen,stream,streamType,toend,v1,v2 s flag=0,stream=0
	$$$lexskip("(") d scalx() s v1=val
	set streamType=$$IsAStream(val) set:streamType stream=1	// DPV2994=n fn,ft s ft="Scalar",fn="SUBSTRING (arg1)" d error(37)  // DPV1738=	// DPV3331
	$$$lexcheck("FROM") s flag=1 ; FROM is optional for Cache', but required for the standard
	if flag=0 $$$lexskip(",")
	d scalx() s v2=val
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="SUBSTRING (arg2)" d error(37)  // DPV1738=
	set toend=0 $$$lexcheck(")") $$$lexputval("t^"_$$$MaxLocalLength) set toend=1
	  #; FOR is required if FROM was specified
	if 'toend {
		if flag { $$$lexskip("FOR") } else { $$$lexskip(",") }
		d scalx()
		$$$lexskip(")") 
		i $$IsAStream(val) n fn,ft s ft="Scalar",fn="SUBSTRING (arg3)" d error(37)  // DPV1738=
	}
		#;  Try to get an accurate length for the column
	if info {
		new overlen
		if $$$mtV(val)?1"t^".n,'toend { set overlen=$p($$$mtV(val),"^",2) }
		else { new overprec set overlen=$$vallength(v1,.overprec) set:overprec>overlen overlen=overprec }
	}
	if 'stream { $$$lexputval("v^SUBSTRING^^"_v1_"^"_v2_"^"_val_"^") }									// DPV3330
	else {
		$$$lexputval("v^SUBSTRING:STREAM^^"_v1_"^"_v2_"^"_val_"^") d create^%qaqpdt(val,"op",$s(streamType=-4:"%Library.Binary",1:"%Library.String"),,,,"SUBSTRING")	// DPV3330	// DPV3331=
	}
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2($s(streamType=-4:"%Library.Binary",1:"%Library.String"),overlen,overlen)		// DPV3331
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
SYSDATE ;  generate symbol-table SYSDATE entry (Oracle compatibility)
	#;
	#;  At this point 'SYSDATE' has been parsed
	#;
	d putval("v^CURTS^^"),create^%qaqpdt(val,"op","%Library.TimeStamp",,,,"CURRENT_TIMESTAMP")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
TOCHAR	; Process Oracle TO_CHAR function converts number/date to string
	#;   TO_CHAR ( <expression> [ , <format> ] )
	#;  At this point 'TO_CHAR(' has been parsed
	n val1 d scalx() 
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="TOCHAR (arg1)" d error(37)  // DPV1738=
	s val1=val,val="" 
	if $$check(",") {
		do scalx() 
		if $$IsAStream(val) n fn,ft s ft="Scalar",fn="TOCHAR (arg2)" d error(37)  // DPV1738=
		$$$lexputval("v^TOCHAR^^"_val1_"^"_val_"^") d create^%qaqpdt(val,"op","%Library.String",,,,"TOCHAR")
	}
	else {
		$$$lexputval("v^TOCHAR^^"_val1_"^") d create^%qaqpdt(val,"op","%Library.String",,,,"TOCHAR")	// DPV3559
	}
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",50,50)
	$$$lexskip(")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
TODATE	; Process Oracle TO_DATE function converts character to oracle date
	#;   TO_DATE ( <expression> [ , <format> ] )
	#;  At this point 'TO_DATE(' has been parsed
	n val1 d scalx() 
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="TODATE (arg1)" d error(37)  // DPV1738=
	s val1=val,val=""
	if $$check(",") {
		do scalx() 
		if $$IsAStream(val) n fn,ft s ft="Scalar",fn="TODATE (arg2)" d error(37)  // DPV1738=
		do putval("v^TODATE^^"_val1_"^"_$s(val:val_"^",1:"")),create^%qaqpdt(val,"op","%Library.Date",,,,"TODATE")	// DPV2766
	}
	else {
		do putval("v^TODATE^^"_val1_"^"),create^%qaqpdt(val,"op","%Library.Date",,,,"TODATE")	// DPV2766	// DPV3559
	}
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Date")	// DPV2766
	d skip(")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
TONUMBER        ; Process Oracle TONUMBER function as unary '+' function
	#;   TONUMBER(expression)
	#;  Treat TONUMBER the same as unary '+' function
	set op="+"
	do unary,skip(")") 
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
TOPOSIXTIME	; Process TO_POSIXTIME function converts string to %PosixTime value
	#;   TO_POSIXTIME ( <expression> [ , <format> ] )
	#;  At this point 'TO_POSIXTIME(' has been parsed
	new val1
	do scalx()
	if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="TO_POSIXTIME (arg1)" do error(37) }
	set val1=val,val=""
	if $$check(",") { do scalx() if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="TO_POSIXTIME (arg2)" do error(37) }}
	do putval("v^TOPOSIXTIME^^"_val1_"^"_$s(val'="":val_"^",1:""))
	do create^%qaqpdt(val,"op","%Library.PosixTime",,,,"TOPOSIXTIME")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.PosixTime")
	do skip(")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
TOTIMESTAMP	; Process Oracle TO_TIMESTAMP function converts string to timestamp	// DPV3335=
	#;   TO_TIMESTAMP ( <expression> [ , <format> ] )
	#;  At this point 'TO_TIMESTAMP(' has been parsed
	n val1 d scalx()
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="TO_TIMESTAMP (arg1)" d error(37)
	s val1=val,val=""
	i $$check(",") d scalx() i $$IsAStream(val) n fn,ft s ft="Scalar",fn="TO_TIMESTAMP (arg2)" d error(37)
	d putval("v^TOTIMESTAMP^^"_val1_"^"_$s(val'="":val_"^",1:"")),create^%qaqpdt(val,"op","%Library.TimeStamp",,,,"TOTIMESTAMP")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
	d skip(")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
TOVECTOR        ;  Returns a %Vector value the has been converted from a JSON array of %String  
	#;   Syntax    TO_VECTOR ( array, [ <type> , [ <length> ] ] )
	#;   Arguments:
	#;       array - Is a JSON array of type %String
	#;		 type  - Is the vector element type
	#;
	#;  At this point "TO_VECTOR()" has been parsed
	new vecLengthVal,rtype,typeVal,vecType,vecTypeVal,vecVal
	set op = "TO_VECTOR", rtype = "%Library.Vector", vecLengthVal = "", vecType = ""
	do scalx()
	set vecVal = val
	if $$check(",") { // type and length not required
		$$$lexanyid(" DECIMAL DOUBLE FLOAT INT INTEGER STRING ",vecType) 
		if ",DOUBLE,DECIMAL,FLOAT,INT,INTEGER,STRING,"'[(","_vecType_",") { // these are reserved words
			new reason 
			set reason = $$$Text("Vector type must be one of DOUBLE, DECIMAL, FLOAT, INT, INTEGER, STRING", "%SQL.Parser")
			do error(262) // only allow certain datatypes for vector type
		}
		if $$check(",") {
			do scalx()
			set vecLengthVal = val
		}
	}
	do putval("t^"_$s(vecType="":"FLOAT",1:vecType))
	do create^%qaqpdt(val,"const","%Library.String",,,,op)
	set vecTypeVal = val
	do putval("v^"_op_"^^"_vecVal_"^"_vecTypeVal_"^"_$s(vecLengthVal="":"",1:vecLengthVal_"^"))
	do create^%qaqpdt(val,"op",rtype,,,,op)
	do skip(")")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2(rtype)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
TRIM	GOTO TRIM^%qaqpsq2
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
UCASE	; Process UCASE function (upper cases letters)  For ODBC scalar function, Sybase compatibility
	#;   UCASE ( <expression> )
	#;  At this point 'UCASE(' has been parsed
	d scalx()
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="UCASE" d error(37)  // DPV1738=
		#;  Try to get an accurate length for the column
	if info {
		new overlen
		if $e($$$mtV(val),1,2)="t^" { set overlen=$l($p($$$mtV(val),"^",2)) }
		else { new overprec set overlen=$$vallength(val,.overprec) set:overprec>overlen overlen=overprec }
	}
	d putval("v^UCASE^^"_val_"^"),create^%qaqpdt(val,"op","%Library.String",,,,"UCASE"),skip(")")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",overlen,overlen)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
UNIXTIMESTAMP	; Process UNIX_TIMESTAMP function that returns unix timestamp value, the number of seconds since 01 Jan 1970 UTC time
		#;   UNIX_TIMESTAMP ( [ <expression> ] )
		#;  At this point 'UNIX_TIMESTAMP(' has been parsed
	if '$$check(")") {
		do scalx()
		if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="UNIX_TIMESTAMP (arg1)" do error(37) }
		do putval("v^UNIXTIMESTAMPDATE^^"_val_"^")
		do skip(")")
	}
	else {
		do putval("v^UNIXTIMESTAMP^^")
	}
	do create^%qaqpdt(val,"op","%Library.Numeric",,,,"UNIXTIMESTAMP")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Numeric")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
VECTORCOSINE       ;  Returns a %Vector value the has been converted from a JSON array of %String  
	#;   Syntax    VECTOR_COSINE ( expression1, expression2 )
	#;   Arguments:
	#;       expression 1, 2 - Is an expression of type %Vector
	#;
	#;  At this point "VECTOR_COSINE" has been parsed
	new rtype,val1,val2
	set op = "VECTOR_COSINE"
	do scalx() 
	if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="VECTOR_COSINE (arg1)" do error(37) }
	set val1=val 
	do skip(","),scalx() 
	if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="VECTOR_COSINE (arg2)" do error(37) }
	set val2=val,val=""
	do putval("v^"_op_"^^"_val1_"^"_val2_"^")
	do create^%qaqpdt(val,"op",,,,,op)
	do skip(")")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
VECTORDOTPRODUCT       ;  Returns a %Vector value the has been converted from a JSON array of %String  
	#;   Syntax    VECTOR_DOT_PRODUCT ( expression1, expression2 )
	#;   Arguments:
	#;       expression 1, 2 - Is an expression of type %Vector
	#;
	#;  At this point "VECTOR_DOT_PRODUCT" has been parsed
	new rtype,val1,val2
	set op = "VECTOR_DOT_PRODUCT"
	do scalx() 
	if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="VECTOR_DOT_PRODUCT (arg1)" do error(37) }
	set val1=val 
	do skip(","),scalx() 
	if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="VECTOR_DOT_PRODUCT (arg2)" do error(37) }
	set val2=val,val=""
	do putval("v^"_op_"^^"_val1_"^"_val2_"^")
	do create^%qaqpdt(val,"op",,,,,op)
	do skip(")")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
%VHASH	d funcsv("%VHASH","%Library.Binary")  ;  AK971
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
xmlTagName(val)
	n v
	s v=$$$mtV(val)
	if $e(v)="t" QUIT $zcvt($e(v,3,*),"O","XML")
	if $e(v)="f" QUIT $zcvt($p(v,"^",4),"O","XML")
	QUIT ""
.
XMLELEMENT
	#; XMLELEMENT ( [NAME] tagName , XmlAttributes | valueExpr [, valueExpr ]* )
	#; 
	n val1,valExpr,startTag,endTag,nullStr,tagName,prefixVal,attrVal,namespaces,tagVal,zcvtArg2,zcvtArg3
	if '$d(xmlelementlevel) { set xmlelementlevel=0 } else { set xmlelementlevel=xmlelementlevel+1 }   // xmlelementlevel is new'd in %qaqqt
	d putval("t^O") s zcvtArg2=val
	d putval("t^XML") s zcvtArg3=val
	s attrVal="",prefixVal="",namespaces="",tagName="",tagVal=""
	d putval("t^"_$c(0)) s nullStr=val		// Internal representation of SQL empty string 
	s:(%delid'=2)&&$$checkxmlid("NAME") tagName = "Name"	// optional NAME keyword - if %delid=2 then it's not NAME keyword, user specified XML tag "name"
	if '$$check(",")
	{	; Apparently we found NAME "string", so verify that we found delimited identifier "string".
		// if "?:"[token d var^%qaqpop s tagVal=val
		if (%delid=2) { s tagName=$zcvt(lower,"O","XML"),token="ID" d skipxmlid(value) } elseif (tagVal="") { s t="ID" d error(1) QUIT }
	}
	else 
	{	d XMLVALUE }
	
	while($$check(",")) { d XMLVALUE }
	if 'attrVal 
	{	if tagVal="" 
		{	d putval("t^<"_tagName_">") }
		else 
		{	d putval("t^<") s val1=val,val=tagVal d under s val1=val
			d putval("t^>") d under
		}
	}
	else
	{	if tagVal="" 
		{	d putval("t^<"_tagName_" ") s val1=val }
		else 
		{	d putval("t^ ") s val1=tagVal d under s val1=val }
		s val=attrVal d under s val1=val
		d putval("t^>"),under 
	}
	s startTag=val
	
	if tagVal="" 
	{	d putval("t^</"_tagName_">") }
	else
	{	d putval("t^</") s val1=val,val=tagVal d under s val1=val
		d putval("t^>") d under
	}
	
	if 'prefixVal 
	{	s val1=startTag d under }
	else
	{	s val1=prefixVal d under
		s val1=startTag d under
		d putval("v^NVL^^"_val_"^"_nullStr_"^")
	}
	d skip(")")
		#; Here we will flatten the XMLELEMENT series of values into a single XMLELEMENT value
	new returnType
	set returnType="%Library.String"	// might be changed in xmlFlatten to a CLOB
	do xmlFlatten
	if 'xmlelementlevel { kill xmlelementlevel } else { set xmlelementlevel=xmlelementlevel-1 }
		#; at this point, val should the the output value of a XMLELEMENT.  We record this in mt("xmlelement",m,val)
	set mt("xmlvalue",m,val)=""
	do create^%qaqpdt(val,"op",returnType,,,,"XMLELEMENT")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2(returnType)
	QUIT
.
xmlFlatten
	new escape,escapevals,saveval,scratch,scratch2,streamvals
	set scratch=$$xmlElementFlatten(val),escapevals="",streamvals=""
	for val1=1:1:$l(scratch,"^") {
		set scratch2=$p(scratch,"^",val1)
		if scratch2["*e" set escapevals=escapevals_","_(val1+2)
		if scratch2["*s" set streamvals=streamvals_","_(val1+2) set returnType="%Stream.GlobalCharacter"
		if scratch2["*" set $p(scratch,"^",val1)=+scratch2
	}
	set saveval=val
	do putval("t^"_$e(escapevals,2,*)) set escapevals=val
	do putval("t^"_$e(streamvals,2,*)) set streamvals=val
	do putval("v^XMLFUNC^^"_escapevals_"^"_streamvals_"^"_scratch_"^")
	QUIT
.
	// Give an val# for a XMLELEMENT function, we will flatten this function into a single mt("v") entry
	// An XMLELEMENT function is typically made up of NVL, "_", INTFUN:$zcvt, and other value types
	// We will turn these into a simple v^XMLELEMENT value list	
xmlElementFlatten(val) [mt,iter,retval,vinfo,xmlelementlevel] PUBLIC {
	set return=""
	set return=$$doit(val)
	QUIT return
.
doit(val,escape=0)
	new vinfo
	set vinfo=$$$mtV(val)
	if $e(vinfo,1,5)="v^NVL"{
		do makeScratch($p(vinfo,"^",5))
		do makeScratch(val)
		QUIT $$doit($p(vinfo,"^",4),escape)_$s(escape:"*e",1:"")
	}
	if $e(vinfo,1,3)="v^_"{
		do makeScratch(val)
		QUIT $$doit($p(vinfo,"^",4),escape)_$s(escape:"*e",1:"")_"^"_$$doit($p(vinfo,"^",5),escape)_$s(escape:"*e",1:"")
	}
	if $e(vinfo,1,14)="v^INTFUN:$zcvt" {
		do makeScratch($p(vinfo,"^",5))
		do makeScratch($p(vinfo,"^",6))
		do makeScratch(val)
		if 1 { QUIT $$doit($p(vinfo,"^",4),1)_"*e" }
		else                { QUIT $$doit($p(vinfo,"^",4),0) }
	}
	if $e(vinfo,1,10)="v^XMLFUNC^" {
		new iter,retval
		set retval=""
		set escapeVals=$p($$$mtV($p(vinfo,"^",4)),"^",2)
		for iter=6:1 {
			quit:$p(vinfo,"^",iter)=""
			set itemEscape=escape if 'itemEscape if (","_escapeVals_",")[(","_(iter-3)_",") { set itemEscape=1 }
			set retval=retval_"^"_$$doit($p(vinfo,"^",iter),itemEscape)_$s(itemEscape:"*e",1:"")
		}
		do makeScratch($p(vinfo,"^",4))
		do makeScratch($p(vinfo,"^",5))
		do makeScratch(val)
		QUIT $e(retval,2,*)
	}
	QUIT val_$s(''$$IsAStream(val):"*s",1:"")_$s(escape:"*e",1:"")
	
makeScratch(val)
	set $$$mtVType($$$mtV(val))="i"
	QUIT
}
.
XMLVALUE
	if (attrVal="") && $$checkid("XMLATTRIBUTES") 
	{ 	d skip("("),XMLATTRIBUTES s attrVal=val
	}
	else
	{	if $$checkid("XMLELEMENT") { d skip("("),XMLELEMENT }
		elseif $$checkid("XMLFOREST") { d skip("("),XMLFOREST }
		elseif $$checkid("XMLCOMMENT") { do skip("("),XMLCOMMENT }
		elseif $$checkid("XMLCONCAT") { do skip("("),XMLCONCAT }
		else 			// any scalar value expression
		{	do scalx()
			new escape
			if $$$mtVType($$$mtV(val))="q" {
				new subq,subqval
				set subq=+$p($$$mtV(val),"^",2),subqval=+$$$mtOutputVals($g($$$mtOutput(subq)))
					#; see if subqval is an XMLELEMENT, if it is, escape=0
				set escape='$d(mt("xmlvalue",subq,subqval))
			} else { set escape=($e($$$mtV(val),1,9)'="a^xmlagg^") }
				#; Escape & with &amp, > with &gt, etc. UNLESS this is an XMLAGG
			do:escape putval("v^INTFUN:$zcvt^^"_val_"^"_zcvtArg2_"^"_zcvtArg3_"^")
		}
		d putval("v^NVL^^"_val_"^"_nullStr_"^")
		i prefixVal'="" s val1=prefixVal d under 	// set prefixVal = expr(prefixVal) _ expr(val)
		s prefixVal=val
	}
	QUIT
	
XMLATTRIBUTES
	new ASReqd,attrName,attrValue,escape,quoteSpace,prefixVal,subq,subqval,val1
	set prefixVal=""
	d putval("t^' ") s quoteSpace=val
	do
	{	d scalx() s attrValue=val,attrName=val
		if $$$mtVType($$$mtV(val))="q" {
			set subq=+$p($$$mtV(val),"^",2),subqval=+$$$mtOutputVals($g($$$mtOutput(subq)))
				#; see if subqval is an XMLELEMENT, if it is, escape=0
			set escape='$d(mt("xmlvalue",subq,subqval))
		} else { set escape=($e($$$mtV(val),1,9)'="a^xmlagg^") }
		set ASReqd=("f"'=$$$mtVType($$$mtV(val)))
		if ASReqd { d skip("AS") } else { s:$$checkid("AS") ASReqd=1 }
		if ASReqd { s attrName=$zcvt(lower,"O","XML") d skipxmlid(value) } else { s attrName = $$xmlTagName(attrValue) }
		d putval("t^"_attrName_"='") s val1=val
			#; Escape & with &amp, > with &gt, etc., UNLESS the value expression is an XMLAGG
		if escape { d putval("v^INTFUN:$zcvt^^"_attrValue_"^"_zcvtArg2_"^"_zcvtArg3_"^") } else { s val=attrValue }
		d under
		s val1=val,val=quoteSpace d under
		if prefixVal'="" { set val1=prefixVal do under } 	// set prefixVal = expr(prefixVal) _ expr(val)
		set prefixVal=val
	} while($$check(","))
	do skip(")")
	set mt("xmlvalue",m,val)=""
	QUIT
	
XMLFOREST
	new ASReqd,attrVal,escape,nullStr,prefixVal,subq,subqval,tagName,val1,valExpr,zcvtArg2,zcvtArg3
	if '$d(xmlelementlevel) { set xmlelementlevel=0 } else { set xmlelementlevel=xmlelementlevel+1 }   // xmlelementlevel is new'd in %qaqqt
	d putval("t^O") s zcvtArg2=val
	d putval("t^XML") s zcvtArg3=val
	set tagName="",attrVal="",prefixVal=""	
	do putval("t^"_$c(0)) s nullStr=val		// Internal representation of SQL empty string
	do
	{	do scalx()
		set ASReqd=("f"'=$$$mtVType($$$mtV(val)))
		if $$$mtVType($$$mtV(val))="q" {
			set subq=+$p($$$mtV(val),"^",2),subqval=+$$$mtOutputVals($g($$$mtOutput(subq)))
				#; see if subqval is an XMLELEMENT/XMLFOREST value, if it is, escape=0
			set escape='$d(mt("xmlvalue",subq,subqval))
		} else { set escape=($e($$$mtV(val),1,9)'="a^xmlagg^") }
		set tagName=val
			#; Escape & with &amp, > with &gt, etc.
		do:escape putval("v^INTFUN:$zcvt^^"_val_"^"_zcvtArg2_"^"_zcvtArg3_"^") set valExpr=val
		if ASReqd { do skip("AS") } else { set:$$checkid("AS") ASReqd=1 }
		if ASReqd { set tagName=$zcvt(lower,"O","XML") do skipxmlid(value) } else { set tagName = $$xmlTagName(tagName) }
		do putval("t^<"_tagName_">")
		set val1=val,val=valExpr d under s val1=val
		do putval("t^</"_tagName_">")
		do under
		do putval("v^NVL^^"_val_"^"_nullStr_"^")
		if prefixVal { set val1=prefixVal do under set prefixVal=val } else { set prefixVal=val }
	} while($$check(","))
	do skip(")")
		#; Here we will flatten the XMLFOREST series of values into a single XMLFOREST value
	new returnType
	set returnType="%Library.String"	// might be changed in xmlFlatten to a CLOB
	do xmlFlatten
	if 'xmlelementlevel { kill xmlelementlevel } else { set xmlelementlevel=xmlelementlevel-1 }
		#; at this point, val should the the output value of a XMLFOREST.  We record this in mt("xmlelement",m,val)
	set mt("xmlvalue",m,val)=""
	do create^%qaqpdt(val,"op",returnType,,,,"XMLFOREST")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2(returnType)
	QUIT
	
XMLCONCAT
	n val1,valExpr,prefixVal
	s prefixVal=""	
	do
	{	if $$checkid("XMLELEMENT") { d skip("("),XMLELEMENT }
		elseif $$checkid("XMLFOREST") { d skip("("),XMLFOREST }
		elseif $$checkid("XMLCOMMENT") { do skip("("),XMLCOMMENT }
		else { QUIT }
		if prefixVal { s val1=prefixVal d under s prefixVal=val } else { s prefixVal=val }
	} while($$check(","))
	d skip(")")
	QUIT
XMLCOMMENT
	n val1,startComment
	n zcvtArg2,zcvtArg3
	d putval("t^O") s zcvtArg2=val
	d putval("t^XML") s zcvtArg3=val
	d putval("t^<!-- ") s val1=val
	d scalx()
	d putval("v^INTFUN:$zcvt^^"_val_"^"_zcvtArg2_"^"_zcvtArg3_"^")	
	d under s val1=val
	d putval("t^ -->")
	d under
	d skip(")")
	QUIT
XMLNAMESPACES
	n defaultFound,explicitNoDefault,status
	s defaultFound="",explicitNoDefault=""
	do { s status=$$XMLNAMEDECLITEM() QUIT:'status } while($$check(",")) 	
	QUIT:'status ""			// namespace uri is specified more than once
 	d skip(")")
	QUIT   
XMLNAMEDECLITEM
	n uri,prefix s uri="",prefix=""
	if 'defaultFound && $$checkid("NO") 
	{	if $$checkid("DEFAULT") { s explictNoDefault=1 QUIT 1 } 
		s uri="NO"
	}
	elseif 'defaultFound && $$checkid("DEFAULT") 
	{ 	s defaultName=lower d skipid(value) 
		QUIT 1 
	}
	else
	{	d scalx()		// tbd: need to restrict this to a character string literal here
		s uri=lower 
		QUIT:(uri="") ""
		QUIT:('$$checkid("AS")) ""
		d scalx()		// read namespace prefix (alias)
		s prefix=lower
		QUIT:(prefix="") ""
	}
	d skipid(value)
	// tbd: need to generate " xmlns:"_prefix_"="""_uri_""" " in the output stream
	if $lf(namespaces,uri)=0 { s namespaces = namespaces _ $lb(prefix_"^"_uri) QUIT 1 }
	QUIT ""
	
YEAR	;   Returns an integer that represents the year part of a specified date.
	#;   Syntax    YEAR ( date_expression )
	#;   Arguments:
	#;       date_expression - Is an expression of type %Date
	#;
	Do PGen1ArgInt("YEAR","%Library.Integer",0) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 
CONVERT	; Process CONVERT ( data_type [ ( length ) ] , expression [ , style ] ) for MS SQL Server compatibility	// DPV1920+
	  #;  At this point CONVERT has been parsed
#DEFINE ParmDel "$!$"
	do skip("(")
	new dt,expr,paramsSpecified,StreamType
	set dt=$$datyp^%qaqpDDLParser(1,,,.paramsSpecified)
	if $e(dt)="%",dt'["." { set dt="%Library."_$e(dt,2,*) }  // turn %type into %Library.type
	do skip(",")
	do scalx()
	set StreamType=$$IsAStream(val)
	set expr=val
	if $$check(",") {
		//There's an optional 'style' argument. It must be an integer.
		do scalx()
		do create^%qaqpdt(val,"var","%Library.Integer",,,,"style")
		if info { set $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer") }
		do putval("v^MSCONVERT:"_dt_":"_StreamType_"^^"_expr_"^"_val_"^") 
		do create^%qaqpdt(val,"op",dt,,,,"Convert")
	} else {
			#; we will try to optimize some CONVERT calls by changing them to CAST if there is not style value specified
		if 'StreamType {
			if $case(dt,"%Library.TinyInt":1,"%Library.SmallInt":1,"%Library.Integer":1,"%Library.BigInt":1,:0) {
				do putval("v^CAST_INT^^"_expr_"^")
				do create^%qaqpdt(val,"op",dt,,,,"CAST")
			} elseif dt["%Library.Numeric" {
				new dtshort,parm,prec,precval,scale,scaleval
				set parm=$p(dt,"(",2,*),dtshort=$p(dt,"(")
				if paramsSpecified="" {
					do putval("v^CAST_NUMERIC^^"_expr_"^")
				} elseif paramsSpecified'[$$$ParmDel {
					if parm["MAXVAL=" { set prec=$p($p($p(parm,"MAXVAL=",2),","),")"),prec=$l(prec)-(prec[".") } else { set prec=15 }
					do putval("t^"_prec) set precval=val
					do putval("v^CAST_NUMERIC^^"_expr_"^"_precval_"^")
				} else {
					if parm["MAXVAL=" { set prec=$p($p($p(parm,"MAXVAL=",2),","),")"),prec=$l(prec)-(prec[".") } else { set prec=15 }
					if parm["SCALE=" { set scale=+$p(parm,"SCALE=",2) } else { set scale=0 }
					do putval("t^"_prec) set precval=val
					do putval("t^"_scale) set scaleval=val
					do putval("v^CAST_NUMERIC^^"_expr_"^"_precval_"^"_scaleval_"^")
				}
				do create^%qaqpdt(val,"op",dtshort,,,,"CAST")
			} elseif dt="%Library.Double" {
				do putval("v^CAST_DOUBLE^^"_expr_"^")
				do create^%qaqpdt(val,"op",dt,,,,"CAST")
			} elseif dt="%Library.Currency" {
				do putval("v^CAST_CURRENCY^^"_expr_"^")
				do create^%qaqpdt(val,"op",dt,,,,"CAST")
			} elseif dt="%Library.Boolean" {
				do putval("v^CAST_BIT^^"_expr_"^")
				do create^%qaqpdt(val,"op",dt,,,,"CAST")
			} elseif 0,dt["%Library.String" {
				new dtshort,parm,maxlen,maxlenval
				set parm=$p(dt,"(",2,*),dtshort=$p(dt,"(")
				if parm["MAXLEN=" { set maxlen=+$p(parm,"MAXLEN=",2) } else { set maxlen=30 }
				do putval("t^"_maxlen) set maxlenval=val
				do putval("v^CAST_VARCHAR^^"_expr_"^"_maxlenval_"^")
				do create^%qaqpdt(val,"op",dtshort,,,,"CAST")
			} elseif 0,dt["%Library.Binary" {
				new dtshort,parm,maxlen,maxlenval
				set parm=$p(dt,"(",2,*),dtshort=$p(dt,"(")
				if parm["MAXLEN=" { set maxlen=+$p(parm,"MAXLEN=",2) } else { set maxlen=30 }
				do putval("t^"_maxlen) set maxlenval=val
				do putval("v^CAST_VARBINARY^^"_expr_"^"_maxlenval_"^")
				do create^%qaqpdt(val,"op",dtshort,,,,"CAST")
			} elseif 0,dt="%Library.Date" {
				do putval("v^CAST_DATE^^"_expr_"^")
				do create^%qaqpdt(val,"op",dt,,,,"CAST")
			} elseif 0,dt="%Library.Time" {
				do putval("v^CAST_TIME^^"_expr_"^")
				do create^%qaqpdt(val,"op",dt,,,,"CAST")
			} elseif 0,dt="%Library.TimeStamp" {
				do putval("v^CAST_TIMESTAMP^^"_expr_"^")
				do create^%qaqpdt(val,"op",dt,,,,"CAST")
			} elseif 0,dt="%Library.PosixTime" {
				do putval("v^CAST_POSIXTIME^^"_expr_"^")
				do create^%qaqpdt(val,"op",dt,,,,"CAST")
			} else {
				do putval("v^MSCONVERT:"_dt_":"_StreamType_"^^"_expr_"^")
				do create^%qaqpdt(val,"op",dt,,,,"Convert")
			}
		} else {
			do putval("v^MSCONVERT:"_dt_":"_StreamType_"^^"_expr_"^")
			do create^%qaqpdt(val,"op",dt,,,,"Convert")
		}
	}
	if info {
		if dt["(" {
			new len,parm,prec,scale
			set parm=$p(dt,"(",2,*),dt=$p(dt,"(")
			if dt="%Library.Float" {
				if parm["MAXVAL=" { s prec=$p($p($p(parm,"MAXVAL=",2),","),")"),len=$l(prec),prec=$l(prec)-(prec[".") } else { s prec=15,len=15 }
				set $$$VTRomsinfo(val)=$$definfo^%qaqpif2(dt,len,prec,0)
			}
			elseif dt="%Library.Numeric" {
				if parm["SCALE=" { s scale=+$p(parm,"SCALE=",2) } else { s scale=0 }
				if parm["MAXVAL=" { s prec=$p($p($p(parm,"MAXVAL=",2),","),")"),len=$l(prec),prec=$l(prec)-(prec[".") } else { s prec=15,len=15 }
				set $$$VTRomsinfo(val)=$$definfo^%qaqpif2(dt,len,prec,scale)
			}
			elseif dt="%Library.String"||(dt="%Library.Binary") {
				if parm["MAXLEN=" { s len=+$p(parm,"MAXLEN=",2) } else { s len=0 }
				set $$$VTRomsinfo(val)=$$definfo^%qaqpif2(dt,len,len)
			}
			else { s $$$VTRomsinfo(val)=$$definfo^%qaqpif2(dt) }
		}
		else { set $$$VTRomsinfo(val)=$$definfo^%qaqpif2(dt) }
	}
	do skip(")")
	RETURN  ; -- CONVERT
 
convert ;  generate symbol-table CONVERT entry (for {fn CONVERT()})
	$$$lexcheckid("SQL_TIMESTAMP") $$$lexputval("v^CONVERT:%Library.TimeStamp^^"_val_"^") d create^%qaqpdt(val,"op","%Library.TimeStamp",,,,"Convert") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp") QUIT
	$$$lexcheckid("SQL_POSIXTIME") $$$lexputval("v^CONVERT:%Library.PosixTime^^"_val_"^") d create^%qaqpdt(val,"op","%Library.PosixTime",,,,"Convert") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.PosixTime") QUIT
	$$$lexcheckid("SQL_TIME") $$$lexputval("v^CONVERT:%Library.Time^^"_val_"^") d create^%qaqpdt(val,"op","%Library.Time",,,,"Convert") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Time") QUIT
	$$$lexcheckid("SQL_DATE") $$$lexputval("v^CONVERT:%Library.Date^^"_val_"^") d create^%qaqpdt(val,"op","%Library.Date",,,,"Convert") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Date") QUIT
	$$$lexcheckid("SQL_VARCHAR") $$$lexputval("v^CONVERT:%Library.String^^"_val_"^") d create^%qaqpdt(val,"op","%Library.String",,,,"Convert") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String") QUIT
	$$$lexcheckid("SQL_INTEGER") $$$lexputval("v^CONVERT:%Library.Integer^^"_val_"^") d create^%qaqpdt(val,"op","%Library.Integer",,,,"Convert") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer") QUIT
	$$$lexcheckid("SQL_TINYINT") $$$lexputval("v^CONVERT:%Library.TinyInt^^"_val_"^") d create^%qaqpdt(val,"op","%Library.TinyInt",,,,"Convert") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TinyInt") QUIT  	// DPV3651
	$$$lexcheckid("SQL_SMALLINT") $$$lexputval("v^CONVERT:%Library.SmallInt^^"_val_"^") d create^%qaqpdt(val,"op","%Library.SmallInt",,,,"Convert") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.SmallInt") QUIT  // DPV3651
	$$$lexcheckid("SQL_BIGINT") $$$lexputval("v^CONVERT:%Library.BigInt^^"_val_"^") d create^%qaqpdt(val,"op","%Library.BigInt",,,,"Convert") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.BigInt") QUIT  	// DPV3651
	$$$lexcheckid("SQL_DOUBLE") $$$lexputval("v^CONVERT:%Library.Double^^"_val_"^") d create^%qaqpdt(val,"op","%Library.Double",,,,"Convert") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Double") QUIT  	// DPV2021=	// DPV3173
	d error(40)  ;  ODBC escape extension not supported
	QUIT  ;--- convert
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
under	;
	if $$IsAStream(val),'$d(xmlelementlevel)  { new fn,ft set ft="Scalar",fn="CONCAT (arg1)" do error(37) }
	if $$IsAStream(val1),'$d(xmlelementlevel) { new fn,ft set ft="Scalar",fn="CONCAT (arg2)" do error(37) }
	do putval("v^_^^"_val1_"^"_val_"^"),create^%qaqpdt(val,"op","%Library.String",,,,"CONCAT")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String") 
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
orafunc(func)  ; Determine if the given function is a valid ORACLE function
	QUIT (",DECODE,TODATE,"[(","_func_",")) 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
unary	;  Process UNARY operators here
	new overlen,lxloc
	if op="UPPER" { set opName=op,op="%UPPER" }
	set sflag=""
	#; DPV1151
	If (($$$ISENCODEDCOLLATE(op))||(",%STRING,%SQLSTRING,%SQLUPPER,%TRUNCATE,%COLLATE,"[(","_op_","))) && ( token="(" )
	{   set lxloc=$$lexmark^%qaqpsq() $$$lexskip("(") // PVA341: look ahead for SELECT
	    if token="SELECT" { d lexgo^%qaqpsq(lxloc) set:op="%TRUNCATE" op="%EXACT" d term }
	    else
	    {
		   do scalx()
		   if $$IsAStream(val) { new fn,ft set ft="Unary",fn=$s($g(opName)'="":opName,1:op) do error(37) }
		   if $$check(",") {
			   if op="%COLLATE" {
					new parm1,parm2,realOverlen
					set overlen = $$coltrun
					set parm1 = $$$quote(overlen)
					if token'=")" {
				  	 	set token = overlen
				  	 	if $$check(overlen) {
							set realOverlen = (+$$coltrun)
							set overlen=parm1_","_realOverlen
						}
					}
					else{
						set overlen=parm1
					}
					set op=op_"("_overlen_")"
					set op = $$encodeCollate^%qaqcpre(op)	
					if $D(realOverlen) {set overlen = realOverlen} 
					else {kill overlen}
			       
			   }
			   else{
				  set overlen=$$coltrun
			   	  set op=op_"("_overlen_")"
			      kill:overlen'=+overlen overlen	// not a number means it was not a literal value in the length
			   }
			   
		   }
		   elseif " %COLLATE %TRUNCATE "[(" "_op_" ") { set op="%EXACT" }	// DPV3644 Treat %TRUNCATE(field) the same as %EXACT(field)
		   $$$lexskip(")")
	    }
	}
	Else { 
		set:" %COLLATE %TRUNCATE "[(" "_op_" ") op="%EXACT" // DPV3644 Treat %TRUNCATE(field) the same as %EXACT(field)
		d term 
	}
	#; DPV1151-
	#; AK493
	#;  simplify +/- of a constant in the parse-tree
	i $$$mtVType($$$mtV(val))="t","+-"[op n x s x=$e($$$mtV(val),3,*) QUIT:x=""  s $$$mtV(val)="t^"_$s(op="-":-x,1:+x) QUIT
	#; AK493-
	#; JLF015
	if ("%ANYOF,%ANYOFKEY,%INTERNAL"'[op),$$IsAStream(val) { new fn,ft set ft="Unary",fn=$s($g(opName)'="":opName,1:op) do error(37) } // DPV3261 allow %INTERNAL(stream), it is a no-op
	s val=$$putunary(val,op)
	s:info&&($d(overlen)) $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",overlen,overlen)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF015
validANYOFOperand(val)
	; This function returns 1 if val supports a buildValueArray method, else ""
	;
	n v s v = $$$mtV(val)
	QUIT:(("v"=$e(v))&&("USERDEFINEDFUNCTION:"=$e($p(v,"^",2),1,$l("USERDEFINEDFUNCTION:")))) 1
	QUIT:("f"'[$e(v)) ""
	; tbd:  need to check if it is truly multi-valued: QUIT $$$smdIsMultiValued($p(v,"^",2), $p(v,"^",3))
	QUIT 1
	#; JLF015-
	#; AK441
coltrun() n val  ;  $$:  constant (integer), or val#_"#" of host-variable
	if "?:"[token { do var^%qaqpop QUIT val_"#" } ;  maybe a host-variable
	do pint  ;  must be an integer
	QUIT val
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK441-
	// Parse [ (... ] <integer> [ )... ]
	// Sets local variable val which is the integer constant
pint	if $$check("(") { do pint,skip(")") QUIT  }
	set val=value do skip(9)  ;  integer constant
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
putunary(fval,op)  ;  Mark the UNARY operatory in the Parse Tree
	n val
	
	#; JLF015
	n elementRef s elementRef=",%ANYOF,%ANYOFKEY,"[(","_op_",")
	if 'elementRef { s val=$g(mt("unary",fval,op)) QUIT:val val } 
	elseif $g(label)'="" { s val=$g(mt("unary",fval,op,label)) QUIT:val val }
	#; JLF015-
	#; --- Force op(field) to have at most one mt("v") entry ---
	$$$lexputval("v^"_op_"^^"_fval_"^")
	#; PVA050: eliminate setting of ptln here. This was never used anyway.
	#; JLF015
	if 'elementRef 
	{ s mt("unary",fval,op)=val } 
	else 
	{ n other s mt("unary",fval,op,label)=val
	  s other=$g(mt("unary",fval,$s(op="%ANYOF":"%ANYOFKEY",1:"%ANYOF"),label))
	  i other { s mt("anyofOther",val)=other,mt("anyofOther",other)=val }
	}
	#; JLF015-
	i op="%INTEXT",$$putunary(fval,"%EXTERNAL")  ;  must have %EXTERNAL
	QUIT val
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
paren	;  <paren> ::= <query> | <prdct> | <scalx>
	#; PVA050: 3d argument added to query to distinguish FROM containment from other containment.
	i token="SELECT" d query^%qaqpsq(m,1,m) QUIT  ; MRP121 Moved this line up one
	i sflag=1 d prdct(1) QUIT  ; MRP121  Relpaced "log" with 1
	d scalx()
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
vallength(val,precision)  ;
		#;  Given a val entry, if it is a field, return the field's length
		#;  Otherwise, return 255
		#;  We don't care about the field's length when parsing a view's query for CREATE VIEW
		#;  precision is passed by reference, return the precision by reference and the length as the return value (DPV3549)
	if $$$mtVType($$$mtV(val))'="f"||($$$mtStatementType="CRV")||($$$mtStatementType="ALV") set precision=255 QUIT 255  // Not a field  (DPV2721)
	new ifn,v 
	set v=$$$mtV(val)
	do vfollow^%qaqpif2(.val,.v)					// DPV3935 - must follow streamed view fields to underlying vals
	set ifn=$$pathifn^%qaqpif2(v,1)
	if ifn="" set precision=255 QUIT 255
	new info set info=$$$smd(8,ifn),precision=$p(info,$c(1),4)
	QUIT $p(info,$c(1),3)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
IsAStream(val) ;	DPV1738+
	  #;  $$ function which determines if val entry is a field and if so, is it a stream field.
	  #;  some functions are not permitted on stream fields
	  #;  Returns 1 if the val entry is for a stream value, otherwise 0
	  #;    We don't care when parsing a view's query for CREATE VIEW
	QUIT:($$$mtStatementType="CRV")||($$$mtStatementType="ALV")||($$$mtStatementType="CRG") 0  // CREATE VIEW or ALTER VIEW or CREATE TRIGGER
	n data set data=$$$mtV(val)
	QUIT:$p(data,"^",2)="%OBJECT" 1  	// DPV2994 - stream oref
	if $p(data,"^",1,2)="v^XMLFUNC",$g($$$mtV($p(data,"^",5)))?1"t^"1n.e { QUIT 1 }
		#; See if this subquery returns a stream
	if $e(data)="q" {
		new subq
		set subq=+$p(data,"^",2)
		QUIT $$IsAStream(+$$$mtOutputVals($g($$$mtOutput(subq))))
	}
		#; See if NVL or "_" op returns a stream (This should only happen for XMLELEMENT/XMLFOREST functions)
	if $case($p(data,"^",1,2),"v^NVL":1,"v^_":1,:0) { if $$IsAStream($p(data,"^",4))||($$IsAStream($p(data,"^",5))) { QUIT 1 } else { QUIT 0 }}
		#; See if INTFUN:$zcvt op returns a stream (This should only happen for XMLELEMENT/XMLFOREST functions)
	if $p(data,"^",1,2)="v^INTFUN:$zcvt" { QUIT $$IsAStream($p(data,"^",4)) }
	QUIT:$e(data)'="f" 0
	new ifn,v
	set v=data
	do vfollow^%qaqpif2(.val,.v)					// DPV3935 - must follow streamed view fields to underlying vals
		#; if this is an XMLFUNC function, the 5th "^" piece will be a list of argument positions for any stream arguments.  If this val info has t^#..., the XMLFUNC returns a stream.  If no stream arguments, it returns a string.
	QUIT:val=""||($$$mtVType($$$mtV(val))'="f") 0
	set ifn=$$pathifn^%qaqpif2(v,1) QUIT:ifn="" 0
	QUIT $Case($p($$finfo^%qaqpif2(ifn),$c(1),2),-4:-4,-1:-1,:0)	// Type -4 is LONGVARBINARY, -1 is LONGVARCHAR	// DPV2206 (return type if Stream, not just 1)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
IsAIdField(val) ;
	  #;  $$ function which determines if val entry is an ID field
	  #;  some functions only allow ID field arguments (%OID)
	  #;  Returns 1 if the val entry is for a ID field, otherwise 0
	  #;  ID field has icol=1 or if it is a reference field, references store ID values.
	  #;    We don't care when parsing a view's query for CREATE VIEW
	QUIT:($$$mtStatementType="CRV")||($$$mtStatementType="ALV") 1  // A field or CREATE VIEW or ALTER VIEW
	if $$$mtVType($$$mtV(val))="f" {
		new ifn,v
		set v=$$$mtV(val)
		do vfollow^%qaqpif2(.val,.v)				// DPV3935 - must follow streamed view fields to underlying vals
		set ifn=$$pathifn^%qaqpif2(v,1) QUIT:ifn="" 0
		QUIT:val=""||($$$mtVType($$$mtV(val))'="f") 0
		QUIT:$$$smdGetIcolFromIfn(ifn)<2 1  			// ID or Parent ID field
		new irn s irn=$$$smdGetIrnFromIfn(ifn) QUIT:'irn 0
		QUIT:$$$smdColReferencedTable(1,irn,ifn)'="" 1		// Reference field
	}
	QUIT 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	/// Given an $$$mtV(val) value, if the val represents a field with non-Exact collation, return the collation
HasNonExactCollation(val) ;
	RETURN:($$$mtStatementType="CRV")||($$$mtStatementType="ALV")||($$$mtStatementType="CRG") ""   // A field or CREATE VIEW or ALTER VIEW
	if $$$mtVType($$$mtV(val))="f" {
		new ifn,v
		set v=$$$mtV(val)
		do vfollow^%qaqpif2(.val,.v)                 // must follow streamed view fields to underlying vals
		RETURN:$$$mtVType($$$mtV(val))'="f" ""		     // val may have changed, so make sure it is still a field
		set ifn=$$pathifn^%qaqpif2(v,1)
		RETURN:ifn="" ""
		RETURN:val=""||($$$mtVType($$$mtV(val))'="f") ""
		new irn
		set irn=$$$smdGetIrnFromIfn(ifn)
		RETURN:'irn ""
		new collation
		set collation=$$$smdColCollation(1,irn,ifn)
		RETURN:collation=""||(collation="E") ""	    // collation not defined, or Exact
		RETURN collation
	}
	RETURN ""
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
not	;  apply NOT to condition val, return val implicitly
	#; AK487
	i $p($$$mtL(val),"^",1,2)="v^NULL" s $$$mtLOperator($$$mtL(val))="'NULL" QUIT  ;  optimize NOT(IS NULL)
	$$$lexputlog("l^'^^"_val_"^")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
agg	;  aggregate:
	#;
	#;	<agg> ::= <agg func> ( <agg arg> ) | COUNT (*)
	#;	<agg func> ::= AVG | SUM | MAX | MIN | COUNT | LIST | XMLAGG | %DLIST | VAR_POP | VAR_SAMP | VARIANCE | STDDEV | STDDEV_POP | STDDEV_SAMP | JSON_ARRAYAGG | JSON_OBJECTAGG
	#;	<agg arg> ::= [ <dist> ] <scalx> [ %FOREACH <list> ] [ %AFTERHAVING ] [ ORDER BY <list> ]
	#;		-- ORDER BY <list> only allowed or XMLAGG
	#;
	#;   Parse Tree entry for aggregates:
	#;	$$$mtV(val#) = a column or (sub-)expression , either of:
	#;	    "a"^... - aggregate function in $P "^" delimited list as follows:
	#;		2) function, either of "sum", "avg", "count", "max", "min", "list", "xmlagg", "udaf"_$c(2)_schemaname_$c(2)_functionname
	#;		3) --- empty
	#;		4) [1] - if AFTER-HAVING (the default is BEFORE-HAVING)
	#;		5) val# - the function is applied to this value, can be * in PT-1
	#;		6) LIST(val#,) - group-list (FOREACH), if exists
	#;		7) LIST(val#,) - DISTINCT-list, if exists
	#;		8) LIST(val#,) - ORDER BY list, if exists (for XMLAGG ONLY)
	#;		9) val# for value of key-value pair (JSON_OBJECTAGG only)
	#;			This could also be a LIST(val#,) for UDAF for arguments 2 through N to the UDAF
	#;			This is parsed and defined in UserDefinedFunction^%qaqpsq1
.
	new agdst,list,saveusef,tAfterHaving,tListDelVal,val1,val2,inagg
	set inagg=m
	set saveusef=$g($$$mtCorrFieldUsed(m))  ;  mask correlated field usage	// AK703
	do error(4):op="IN",error(19):$g(where) $$$lexskip("(")
	set levag=levag+1  ;  aggregate nesting level
	set op=$TR(op,"AVGCOUNTSMIXLDRPEJYBHK","avgcountsmixldrpejybhk")
	set agdst="",list=""
	if op="count",$$check("*") { set val="",val1="" } ;  count(*)
	else {
		do dist(.agdst),scalx()
		set val1=val
		if op="json_objectagg" { do skip(","),scalx() set val2=val }
			#; if this is a stream and it is not COUNT([ALL] ...), report an error
		if (op'="count"||(agdst'="")),$$IsAStream(val) {
			new fn,ft set ft="Aggregate",fn=$zcvt(op,"U") do error(37)  // DPV1738=	// DPV3721
		}
		if agdst="d" {
			if op="list" { set agdst="",op="distinctlist" }
			elseif op="%dlist"  { set agdst="",op="distinct%dlist" }
			else { set agdst=val_"," }
		}
	}
	$$$lexcheckid("%FOREACH") do commalist($$$UPPER(op),"Aggregate") set:agdst agdst=agdst_list
	if $case(op,"list":1,"distinctlist":1,"%dlist":1,"distinct%dlist":1,"json_arrayagg":1,"json_objectagg":1,:0)&&(mt("sqlcomp")'="") {
		new u
		set u=$Case(mt("sqlcomp"),"%ODBC":"%ODBCOUT","%EXTERNAL":"%EXTERNAL","%Runtime":"%RUNTIMEOUT","%FDBMS":"%EXTERNAL",:"")
		if u'="" {
			set val1=$$putunary(val1,u)
			set:op="json_objectagg" val2=$$putunary(val2,u)
		}
	}	// DPV2600-
	set tAfterHaving="" $$$lexcheckid("%AFTERHAVING") set tAfterHaving=1
	if op="avg" {
			#; DPV4377=
			#; Instead of AVG we will change AVG(<aggbody>), at parse time, into (SUM(<aggbody>) "/0" COUNT(<aggbody>))
			#; Prior to this change, this happened at ASL construction time (AK214)
			#; This will aloow us to take advantage of JLF009 optimizations, to combine redundant aggregates, which takes place in the pre-optimizer.
			#; It will also help our parallelization efforts for aggregates
			#; The new aggregates would inherit all the aggregate qualifiers in <aggbody>, including any %FOREACH list, any DISTINCT BY list, and the %AFTERHAVING flag, 
			#; in addition to the aggregate argument.  
.
		new tCountVal,tSumVal
		$$$lexputval("a^sum^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst)
		set tSumVal=val
		$$$lexputval("a^count^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst)
		set tCountVal=val
		set:levag=1 laggs=laggs_tSumVal_","_tCountVal_","  ;  top-level agg list
		$$$lexputval("v^/0^^"_tSumVal_"^"_tCountVal_"^")
	}
	elseif op="approx_count_distinct" {
		do putval("a^"_op_"^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst)
		do putval("v^HLL^^"_val_"^")
	}
		#;  Some of these aggregates will appear as function/expressions in the parse tree.  We need to be able to refer back to the original
		#;  argument to the aggregate function to determine the type to return for the function (most likly NUMERIC or DOUBLE)
		#;  I record this val mapping in set mt("agg-orig-argval",val) = val1
		#;  set mt("agg-orig-argval",val) is referenced in %qaqpif2 and %qaqpdt
	elseif op="variance" {	// DPV4536
			#; Instead of VARIANCE we will change VARIANCE(<aggbody>), at parse time, into CASE COUNT(X) WHEN 1 THEN 0 ELSE VAR_SAMP(X)
		new t0,t1,t2,tCount,tDiff1,tDiff2,tMult1,tMult2,tPower1,tPower2,tSum1,tSum2,tVarSamp
		do putval("t^0") set t0=val							set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("t^1") set t1=val							set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("t^2") set t2=val							set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("v^POWER^^"_val1_"^"_t2_"^") set tPower1=val
		do putval("a^count^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst) set tCount=val
		do putval("a^sum^^"_tAfterHaving_"^"_tPower1_"^"_list_"^"_agdst) set tSum1=val
		do putval("a^sum^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst) set tSum2=val
		do putval("v^POWER^^"_tSum2_"^"_t2_"^") set tPower2=val
		do putval("v^*^^"_tSum1_"^"_tCount_"^") set tMult1=val
		do putval("v^-^^"_tMult1_"^"_tPower2_"^") set tDiff1=val			// If this is negative, it is most likely due to COS rounding issues and it should really be a 0
		do putval("v^BIGGER^^"_tDiff1_"^"_t0_"^") set tDiff1=val
		do putval("v^-^^"_tCount_"^"_t1_"^") set tDiff2=val				set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("v^*^^"_tCount_"^"_tDiff2_"^") set tMult2=val
		do putval("v^/^^"_tDiff1_"^"_tMult2_"^") set tVarSamp=val
		do putlog("v^=^^"_tCount_"^"_t1_"^")
		do putval("l^L2V^^"_val_"^")
		set:levag=1 laggs=laggs_tCount_","_tSum1_","_tSum2_","  ;  top-level agg list
		do putval("v^CASE_AGG^^"_val_"^"_t0_"^"_tVarSamp_"^")
		set mt("agg-orig-argval",val)=val1
	}
	elseif op="stddev" {	// DPV4536
			#; Instead of STDDEV we will change STDDEV(<aggbody>), at parse time, into CASE COUNT(X) WHEN 1 THEN 0 ELSE SQRT(VAR_SAMP(X))
		new t0,t1,t2,tCount,tDiff1,tDiff2,tMult1,tMult2,tPower1,tPower2,tSqrt,tSum1,tSum2,tVarSamp
		do putval("t^0") set t0=val							set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("t^1") set t1=val							set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("t^2") set t2=val							set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("v^POWER^^"_val1_"^"_t2_"^") set tPower1=val
		do putval("a^count^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst) set tCount=val
		do putval("a^sum^^"_tAfterHaving_"^"_tPower1_"^"_list_"^"_agdst) set tSum1=val
		do putval("a^sum^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst) set tSum2=val
		do putval("v^POWER^^"_tSum2_"^"_t2_"^") set tPower2=val
		do putval("v^*^^"_tSum1_"^"_tCount_"^") set tMult1=val
		do putval("v^-^^"_tMult1_"^"_tPower2_"^") set tDiff1=val			// If this is negative, it is most likely due to COS rounding issues and it should really be a 0
		do putval("v^BIGGER^^"_tDiff1_"^"_t0_"^") set tDiff1=val
		do putval("v^-^^"_tCount_"^"_t1_"^") set tDiff2=val				set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("v^*^^"_tCount_"^"_tDiff2_"^") set tMult2=val
		do putval("v^/^^"_tDiff1_"^"_tMult2_"^") set tVarSamp=val
		do putval("v^SQRT^^"_tVarSamp_"^") set tSqrt=val
		do putlog("v^=^^"_tCount_"^"_t1_"^")						
		do putval("l^L2V^^"_val_"^")
		set:levag=1 laggs=laggs_tCount_","_tSum1_","_tSum2_","  ;  top-level agg list
		do putval("v^CASE_AGG^^"_val_"^"_t0_"^"_tSqrt_"^")
		set mt("agg-orig-argval",val)=val1
	}
	elseif op="stddev_pop"||(op="var_pop") {	// DPV4536
			#; Instead of VAR_POP we will change VAR_POP(<aggbody>), at parse time, into (( SUM(X**2) * COUNT(X) ) - ( SUM(X)**2 )) / ( COUNT(X))**2 )
			#; Instead of STDDEV_POP we will change STDDEV_POP(<aggbody>), at parse time, into SQRT((( SUM(X**2) * COUNT(X) ) - ( SUM(X)**2 )) / ( COUNT(X))**2 )), which is SQRT(VAR_POP(X))
		new t0,t2,tCount,tDiff,tDiff1,tMult,tPower1,tPower2,tPower3,tSum1,tSum2
		do putval("t^0") set t0=val							set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("t^2") set t2=val							set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("v^POWER^^"_val1_"^"_t2_"^") set tPower1=val
		do putval("a^count^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst) set tCount=val	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("a^sum^^"_tAfterHaving_"^"_tPower1_"^"_list_"^"_agdst) set tSum1=val
		do putval("a^sum^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst) set tSum2=val
		do putval("v^POWER^^"_tSum2_"^"_t2_"^") set tPower2=val
		do putval("v^*^^"_tSum1_"^"_tCount_"^") set tMult=val
		do putval("v^-^^"_tMult_"^"_tPower2_"^") set tDiff=val				// If this is negative, it is most likely due to COS rounding issues and it should really be a 0
		do putval("v^BIGGER^^"_tDiff_"^"_t0_"^") set tDiff1=val
		do putval("v^POWER^^"_tCount_"^"_t2_"^") set tPower3=val
		set:levag=1 laggs=laggs_tCount_","_tSum1_","_tSum2_","  ;  top-level agg list
		do putval("v^/AGG^^"_tDiff1_"^"_tPower3_"^")
		set mt("agg-orig-argval",val)=val1
		if op="stddev_pop" {
			do putval("v^SQRT_AGG^^"_val_"^")
			set mt("agg-orig-argval",val)=val1
		}
	}
	elseif op="stddev_samp"||(op="var_samp") {	// DPV4536
			#; Instead of VAR_SAMP we will change VAR_SAMP(<aggbody>), at parse time, into:
			#;   VAR_SAMP ==  (( SUM(X**2) * COUNT(X) ) - ( SUM(X)**2 )) / ( COUNT(X)) * ( COUNT(X) - 1 ) )
			#; Instead of STDDEV_SAMP we will change STDDEV_SAMP(<aggbody>), at parse time, into SQRT((( SUM(X**2) * COUNT(X) ) - ( SUM(X)**2 )) / ( COUNT(X)) * ( COUNT(X) - 1 ) )), which is SQRT(VAR_SAMP(X))
		new t0,t1,t2,tCount,tDiff1,tDiff2,tDiv,tEqual,tMult1,tMult2,tNull,tPower1,tPower2,tSum1,tSum2
		do putval("t^0") set t0=val							set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("t^1") set t1=val							set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("t^2") set t2=val							set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("t^") set tNull=val							set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("v^POWER^^"_val1_"^"_t2_"^") set tPower1=val
		do putval("a^count^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst) set tCount=val	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		do putval("a^sum^^"_tAfterHaving_"^"_tPower1_"^"_list_"^"_agdst) set tSum1=val
		do putval("a^sum^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst) set tSum2=val
		do putval("v^POWER^^"_tSum2_"^"_t2_"^") set tPower2=val
		do putval("v^*^^"_tSum1_"^"_tCount_"^") set tMult1=val
		do putval("v^-^^"_tMult1_"^"_tPower2_"^") set tDiff1=val			// If this is negative, it is most likely due to COS rounding issues and it should really be a 0
		do putval("v^BIGGER^^"_tDiff1_"^"_t0_"^") set tDiff1=val
		do putval("v^-^^"_tCount_"^"_t1_"^") set tDiff2=val
		do putval("v^*^^"_tCount_"^"_tDiff2_"^") set tMult2=val
		do putlog("v^=^^"_tCount_"^"_t1_"^")
		do putval("l^L2V^^"_val_"^") set tEqual=val
		do putval("v^/^^"_tDiff1_"^"_tMult2_"^") set tDiv=val
		if op="stddev_samp" {
			new tSqrt
			do putval("v^SQRT^^"_tDiv_"^") set tSqrt=val
			set:levag=1 laggs=laggs_tCount_","_tSum1_","_tSum2_","  ;  top-level agg list
			do putval("v^CASE_AGG^^"_tEqual_"^"_tNull_"^"_tSqrt_"^")
		}
		else {	// var_samp
			set:levag=1 laggs=laggs_tCount_","_tSum1_","_tSum2_","  ;  top-level agg list
			do putval("v^CASE_AGG^^"_tEqual_"^"_tNull_"^"_tDiv_"^")
		}
		set mt("agg-orig-argval",val)=val1
.
	}
	elseif op="json_arrayagg" {
			#; DPV4803=
			#; Instead of JSON_ARRAYAGG we will change JSON_ARRAYAGG(<aggbody>), at parse time, into (JSON_ARRAY(%DLIST(<aggbody>)))
		new tListVal
		do putval("a^%dlist^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst)
		set tListVal=val
		do putval("v^JSON_ARRAY_AGG^^"_tListVal_"^")
		set mt("jsonarrayagg",tListVal)=val1   // record the 'real' value of the json_array arrgregate - so we can determine the 'type' in %qaqcpr
		set:levag=1 laggs=laggs_tListVal_","  ;  top-level agg list
	}
	elseif op="json_objectagg" {
		do putval("a^"_op_"^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst_"^^"_val2_"^")
	}
	else {
		$$$lexputval("a^"_op_"^^"_tAfterHaving_"^"_val1_"^"_list_"^"_agdst)
	}
	if op="xmlagg" && $$checkid("ORDER") && $$checkid("BY") { 	// JLF012
		set val1=val
		do commalist($$$UPPER(op),"Aggregate ORDER BY")
		set $$$mtV(val1) = $$$mtV(val1)_list_"^"
	}
	$$$lexskip(")")
	set levag=levag-1 
	if $case(op,"avg":0,"stddev":0,"stddev_pop":0,"stddev_samp":0,"var_pop":0,"var_samp":0,"variance":0,"json_arrayagg":0,:1) { set:'levag laggs=laggs_val_"," }		// top-level agg list, already set if this is an AVG, STDDEV*, JSON_ARRAYAGG, or  VAR*
	if op="distinctlist" {
		new collation
		set collation=$$HasNonExactCollation(val1)
		if collation'="" { set val=$$putunary(val,"%DISTINCTLIST_COLLATE:"_collation) }
	}
	elseif op="distinct%dlist" {
		new collation
		set collation=$$HasNonExactCollation(val1)
		if collation'="" { set val=$$putunary(val,"%DISTINCT%DLIST_COLLATE:"_collation) }
	}
	set $$$mtCorrFieldUsed(m)=saveusef									// fields in agg's should not affect "onerow"	AK703=
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dist(&list)  ;---------- process DISTINCT, return d-list by reference - 3 cases
	#; PVA181: These keywords all must be reserved (all optional). Thus $$check required.
	$$$lexcheck("DISTINCT") GOTO gotdistinct
	$$$lexcheck("ALL")  ;  ALL is the default
	QUIT
gotdistinct	$$$lexcheck("BY") d commalist q
	s list="d"
	QUIT
	
#; Window functions /BEGIN
.
window(op) [ token, value, val, m, inselect, inorderby, inwindow, inagg, ft, fn ] public {
	Set supported=$lb("ROW_NUMBER","RANK","DENSE_RANK","PERCENT_RANK","CUME_DIST","NTILE","SUM","FIRST_VALUE","COUNT","AVG","MIN","MAX","LAG","LEAD","NTH_VALUE","LAST_VALUE")
	If '$lf(supported,op) Do errorUnsupported(op)
	If $g(inselect) '= m, $g(inorderby) '= m Do error(367)
	If ($g(inwindow) = m)||($g(inagg) = m) Do error(369)
	New inwindow Set inwindow = m,agdst = ""
	Set wfdef = ##class(%SQL.QP.WindowFunction).ByName(op)
	$$$lexskipid(op)
	$$$lexskip("(")
	If op="COUNT"{
		if token="*" {
			$$$lexskip("*")
		} else {
			do dist(.agdst) 
		}
	}
	Set args = $$windowArgs(wfdef)
	$$$lexskip(")")
	
	//check if the aggregate (MIN, MAX, SUM, AVG, COUNT) is valid
	if ((",SUM,AVG,MIN,MAX,"[(","_op_","))||(agdst'="")),$$IsAStream(val) { 
		new fn,ft set ft="Aggregate",fn=$zcvt(op,"U")
		do error(37)
	}
	
	//check arg count
	Set pvals="",ovals="",fstart="",fend=""
	If token="ID",value="OVER" {
		$$$lexskipid("OVER")
		If token'="(" Do errorExpected("(")
		$$$lexskip("(")
		If token="PARTITION" {
			$$$lexskipid(value)
			If (token'="BY") Do errorExpected("BY")
			$$$lexskip(token)
			Set pvals=$$cslist()
		}
		If token="ID",value="ORDER" {
			$$$lexskipid(value)
			If (token'="BY") Do errorExpected("BY")
			$$$lexskip(token)
			Set ovals=$$csorderlist()	
		}
		If token="ROWS" {
			$$$lexskip(token)
			Set op = op_":ROWS"
			If token="BETWEEN" {
				$$$lexskip(token)
				Set fstart = $$windowFrameBound()
				If (token'="AND") Do errorExpected("AND")
				$$$lexskip(token)
				Set fend = $$windowFrameBound()
			}
			Else {
				Set fstart = $$windowFrameBound()
				Set fend = $$windowFrameDefaultBound()
			}
		}
		If token'=")" Do errorExpected(")")
		$$$lexskip(")")
	}
	If $p(op,":",1)="AVG" {
		Set $p(op,":",1)="SUM"
		Set sumVal = $$windowVal(op,args,pvals,ovals,fstart,fend)
		Set $p(op,":",1)="COUNT"
		Set countVal = $$windowVal(op,args,pvals,ovals,fstart,fend)
		Do putval("v^/0^^"_sumVal_"^"_countVal_"^")
		RETURN
	}
	//TODO: range support, arg support
	Set val = $$windowVal(op,args,pvals,ovals,fstart,fend)
}
windowFrameDefaultBound() [ val ] public {
	New val
	Do putval("t^0")
	RETURN val
}
windowFrameBound() [ token, value, val ] public {
	New val //contain our new parse tree nodes
	If token="ID",value="UNBOUNDED" {
		$$$lexskipid(value)
		If token="ID",value="PRECEDING" {
			$$$lexskipid(value)
			Do putval("t^<")
			RETURN val
		}
		ElseIf token="ID",value="FOLLOWING" {
			$$$lexskipid(value)
			Do putval("t^>")
			RETURN val
		}
		Else {
			Do errorExpected("PRECEDING | FOLLOWING")
		}
	}
	ElseIf token=9,+value=value,value'[".",value'["-" {
		Set num = value
		$$$lexskip(token)
		If token="ID",value="PRECEDING" {
			$$$lexskipid(value)
			Do putval("t^-"_num)
		}
		ElseIf token="ID",value="FOLLOWING" {
			$$$lexskipid(value)
			Do putval("t^"_num)
		}
		Else {
			Do errorExpected("PRECEDING | FOLLOWING")
		}
		RETURN val
	}
	ElseIf token="CURRENT" {
		$$$lexskip(token)
		If (token'="ID")||(value'="ROW") {
			Do errorExpected("ROW")
		}
		$$$lexskipid(value)
		Do putval("t^0")
		RETURN val
	}
	Do errorExpected("UNBOUNDED | CURRENT ROW | <non-negative integer>")
}
windowArgs(wfdef) [ token, val ] public {
	Set vals = ""
	Set argc = 0
	For  {
		If token = ")" {
			If argc < wfdef.MinArgCount() Do error(12)
			QUIT
		}
		Set argc = argc + 1
		If argc > wfdef.MaxArgCount() Do errorExpected(")")
		Do scalx
		Set vals = vals_val_","
		//TODO: we want to error on the "," for an unexpected argument,
		//but could we check argc only once in this loop?
		If token = ",", argc+1 > wfdef.MaxArgCount() Do errorExpected(")")
		$$$lexnotcheck(",",QUIT)
	}
	RETURN vals
}
windowVal(op, args, pvals, ovals, fstart, fend) [ val, info, mt ] public {
	New val //to capture putval's side-effect, so this can be a PROPER function ;)
	Set pargs=$translate(pvals,",","^")
	Do putval("v^%WINDOW_PARTITION^^"_pargs)
	Set partition=val
	Set oargs=""
	For i=1:1 {
		Set oval=$p(ovals,",",i) QUIT:oval=""
		Set oargs=oargs_+oval_"^"
		Do putval("t^"_$s($e(oval,*)="d":"d",1:"a"))
		Set oargs=oargs_val_"^"
	}
	Do putval("v^%WINDOW_ORDER^^"_oargs)
	Set order=val
	If fstart = "" {
		Do putval("t^")
		Set fstart=val
	}
	If fend = "" {
		Do putval("t^")
		Set fend=val
	}
	//TODO: range support
	Set args = $translate(args,",","^")
	Do putval("v^%WINDOW_FUNCTION:"_op_"^^"_partition_"^"_order_"^"_fstart_"^"_fend_"^"_args)
	Set wfdef = ##class(%SQL.QP.WindowFunction).ByName(op)
	Set optype = wfdef.ValueType()
	If optype'="" {
		Do create^%qaqpdt(val,"op",optype,,,,op)
		Set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2(optype)
	}
	RETURN val
}
errorUnsupported(op) [ op ] public {
	Do error(368)
}
errorExpected(expected) [ t ] public {
	Set t = expected Do error(1)
}
.
.
#; We need to distinguish ordinary aggregate functions from window functions
#; and the OVER clause from an "OVER" column alias.
#; 
#; Peek ahead in the lex stream for:
#; - an open paren P
#; - a series of tokens
#; - a close paren matching P
#; - OVER
#; - an open paren Q
peekForOverClause() [ token, value ] public {
	Set overFound = 0
	Do holdcur^%qaqpsl2(.savedPosition)
	//Scope we can QUIT to restore the saved position at any time.
	Do {
		//skip to the next token
		$$$lexskipid(value)
		//look for the open paren
		QUIT:token'="("
		Set level = 1
		//match parens until we're back at 0
		For  {
			Do JSONParm^%qaqpsq(token,value,.jsonParen)
			Do lext
			QUIT:token=$c(1) //EOQ
			If token = "(" Set level = level + 1
			If token = ")" Set level = level - 1
			If level = 0 {
				$$$lexskip(")")
				If token="ID",value="OVER" Set overFound=1
				QUIT
			}
		}
		
	} While(0)
	Do setold^%qaqpsl2(.savedPosition)
	RETURN overFound
}
.
#; Window functions /END
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
commalist(fn,ft)	;---------- process list separated by commas ----------
		#; this is called for %FOREACH and ORDER BY in aggregates
		#; DPV3721 added a check to make sure this is not a stream field specified.
	$$$lexskip("(") 
	for  {
		do scalx()
		do:$$IsAStream(val) error(37)	// DPV3721
		set list=list_val_","
		$$$lexnotcheck(",",QUIT)
	}
	$$$lexskip(")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
funcsv(fun,ft)  ;  <funcsv> ::= <fun> ( <cslist> )  ;  AK971
	#;  already processed "<fun>("
	d putval("v^"_fun_"^^"_$tr($$cslist(),",","^"))
	d skip(")"),optyp(fun,ft)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
optyp(fun,ft)  ;
	d create^%qaqpdt(val,"op",ft,,,,fun)
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2(ft)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cslist()  ;  $$: LIST(val,) of comma separated list (at least one)
	#;  <cslist> ::= <scalx> { , <scalx> }
	n csv s csv=""
	f  d scalx(),error(37):$$IsAStream(val) s csv=csv_val_"," RETURN:'$$check(",") csv
	RETURN
csorderlist()  ;  $$: LIST(val [ ASC | DESC ],) of comma separated list (at least one)
	#;  <cslist> ::= <scalx> { , <scalx> }
	n csv s csv=""
	f  {
		d scalx(),error(37):$$IsAStream(val)
		s val = val_$s($$checkid("DESC"):"d",$$checkid("ASC")!1:"")
		s csv=csv_val_","
		RETURN:'$$check(",") csv
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  Moved opsome,forex,forcnd from here to '%qaqpop'
apndo(val)  ;  append val to $$$mtOutput(m)
	#; AK564
	i 'info,$$$mtVType($$$mtV(val))="s" s val=$p($$$mtV(val),"^",4)  ;  remove "s"
	s $$$mtOutput(m)=$g($$$mtOutput(m))_val_","
	QUIT
selinfo(pass,asused)  ;  [public: m,val,name,value,lower] Gather SELECT-List Info
	#;---------------------------------------------------------------------
	#;                    I N F O R M A T I O N
	#;---------------------------------------------------------------------
	#;  selinfo
	#;  =======
	#;      selinfo("sel",mod#)=SELECT-List Position Counter
	#;                      mod#,0,pos)= $c(1) Pieces:
	#;                                      1) Field Name
	#;                                      2) val#
	#;                                      3) Alias Name (If one Exists)
	#;                      mod#,"val",val#)=pos  (Index Per mod#)
	#;      selinfo("sel","val",val)#= $c(1) Pieces: (Index)
	#;                                      1) mod#
	#;                                      2) pos
	#;      selinfo("sel","as-val",+$p($$$mtV(val),"^",4))=val ;MRP683
	#;      selinfo("sel","as-mod",mod,alias)=pos                ;MRP698
	#;      WHERE:  mod#  = Query Number
	#;              val#  = The val# into the Parse Tree $$$mtV(val#)
	#;              pos   = The Position of the Field in the SELECT-List
	#;              alias = Alias name for the Field (<field> AS <alias>)
	#;              
	#;---------------------------------------------------------------------
	n pos s asused=+$g(asused),pos=+$g(selinfo("sel",m))
	i pass=1 d pass1(pos) QUIT
	e  d pass2(pos,asused)
	QUIT
	; ------
pass1(pos)  ;  Handle Pass 1: (The Real <column-name>)
	s pos=pos+1,selinfo("sel",m)=pos  ; Bump the Counter
	#; PVA050: collapse arrow syntax
	s selinfo("sel",m,0,pos)=$s($g(name)'="":$tr($$$LastPiece($$$LastPiece(name,"."),"->"),$c(2),"."),1:value)
	QUIT
	; ------
pass2(pos,asused)  ;  Handle Pass 2: (Possibly the Alias <column-name>)
	n oldval s oldval=$p($g(selinfo("sel",m,0,pos)),$c(1)) QUIT:oldval=""
	s $p(selinfo("sel",m,0,pos),$c(1),2)=val,selinfo("sel","val",+val)=m_$c(1)_pos_$c(1)
	QUIT:'asused  ; No Alias Defined
	#;  The next 2 lines were left in, even though they are clearly
	#;      incorrect:  The first uses lower instead of aup, the
	#;      second mixes different aliases that may be assigned to
	#;      the same actual field in different subqueries
	#; AK415
	s $p(selinfo("sel",m,0,pos),$c(1),3)=value
	s selinfo("sel","as-val",+$p($$$mtV(val),"^",4))=val
	#; MRP698 (Fix ORDER BY Alias)..
	#; PVA050: unrelated bugfix: use upper cased 'value' rather than exact case 'lower'.
	s selinfo("sel","as-mod",m,value)=pos
	#; MRP698 (Fix ORDER BY Alias)..-
	QUIT
.
ParseDatePart(caller,&type)  ;
	  #;  Parse the DATEPART for the DATE* functions
	  #;  Datepart         Abbreviations 
	  #;  year             yy, yyyy 
	  #;  quarter          qq, q 
	  #;  month            mm, m 
	  #;  dayofyear        dy, y 
	  #;  day              dd, d 
	  #;  weekday          dw, w
	  #;  week             wk, ww 
	  #;  hour             hh 
	  #;  minute           mi, n 
	  #;  second           ss, s 
	  #;  millisecond      ms 
	  #;  microsecond      mcs
	  #;  nanosecond       ns
	  #;
	  #; Argument pReturnType is passed by reference.  It returns the type of argument the DatePart will return.
	  #;  This is %Library.Integer for all dateparts excep for sts, which will have DATEPART return a %Library.TimeStamp.
	  #;   Here we handle parsing the DATEPART as a host variable
	new i,tParenCount set tParenCount=0
	set type="%Library.Integer"
	for { quit:'$$check("(")  set tParenCount=tParenCount+1 }
	if token=":"||(token="?") {  // DPV1573
		do scalx()
		for i=1:1:tParenCount { do skip(")") }
		RETURN val
	}
	  #;   Here we will handle parsing the DATEPART token or literal
	new VALUE s VALUE=$$$UPPER(value)
	if VALUE="YY"||(VALUE="YYYY")||(VALUE="YEAR") { set value="yy",lower="DATEPART",token=9 do scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") }
	elseif caller'="DATEDIFF",VALUE="QQ"||(VALUE="Q")||(VALUE="QUARTER") { set value="qq",lower="DATEPART",token=9 do scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") }
	elseif VALUE="MM"||(VALUE="M")||(VALUE="MONTH") { set value="mm",lower="DATEPART",token=9 d scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") }
	elseif VALUE="DY"||(VALUE="Y")||(VALUE="DAYOFYEAR") { set value="dy",lower="DATEPART",token=9 d scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") }
	elseif VALUE="DD"||(VALUE="D")||(VALUE="DAY") { set value="dd",lower="DATEPART",token=9 do scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") }
	elseif VALUE="DW"||(VALUE="WEEKDAY")||(VALUE="W") { set value="dw",lower="DATEPART",token=9 do scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") }
	elseif VALUE="WK"||(VALUE="WW")||(VALUE="WEEK") { set value="wk",lower="DATEPART",token=9 do scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") }
	elseif VALUE="HH"||(VALUE="HOUR") { set value="hh",lower="DATEPART",token=9 do scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") }
	elseif VALUE="MI"||(VALUE="N")||(VALUE="MINUTE") { set value="mi",lower="DATEPART",token=9 do scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") }
	elseif VALUE="SS"||(VALUE="S")||(VALUE="SECOND") { set value="ss",lower="DATEPART",token=9 do scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") }
	elseif VALUE="MS"||(VALUE="MILLISECOND") { set value="ms",lower="DATEPART",token=9  d scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") }
	elseif VALUE="MCS"||(VALUE="MICROSECOND") { set value="mcs",lower="DATEPART",token=9  d scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") }
	elseif VALUE="NS"||(VALUE="NANOSECOND") { set value="ns",lower="DATEPART",token=9  d scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") }
	elseif caller="DATEPART",VALUE="STS"||(VALUE="SQLTIMESTAMP") { set value="sts",lower="DATEPART",token=9 do scalx(),create^%qaqpdt(val,"const","%Library.String",,,,"DATEADD") set type="%Library.TimeStamp" }
		#;  If we get here it was an invalid DATEPART
	else { do error(8) QUIT "" }
	for i=1:1:tParenCount { do skip(")") }
	RETURN val
.
#INCLUDE %qaqplex
---
