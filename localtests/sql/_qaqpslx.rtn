	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
NULLIF	; generate symbol-table NULLIF entry 
	#;   NULLIF(<value expression> , <value expression>)
	#;  At this point, 'NULLIF' has been parsed
	n val1 d skip("("),scalx() 
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="NULLIF (arg1)" d error(37)  // DPV1738=
	s val1=val d skip(","),scalx(),skip(")")
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="NULLIF (arg2)" d error(37)  // DPV1738=
	d putval("v^CASE^^"_$$newval("l^L2V^^"_$$newlog("v^=^^"_val1_"^"_val_"^")_"^")_"^"_$$newval("t^")_"^"_val1_"^")
	#; i info s $$$VTRomsinfo(val)=$$definfo^%qaqpif2(type)	will be set later in %qaqpif2 so we know the type of the argument	// DPV2312+
	#;  create^%qaqpdt(val,"op",type,,,,"NULLIF") will be called later for this function in docats^%qaqpdt				// DPV2312-
