	;  AK234;AK248;AK265
	;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
selct()	;  select-clause
	new trtpc
	Set trtpc=$g(%rtpc)
	for {
		$$$lexcheck("%NOLOCK") set $$$mtKNoLockFlag($$$mtK)=1 continue
		$$$lexcheckid("%PROFILE") set mt("pTools")=1 continue
		$$$lexcheckid("%PROFILE_ALL") set mt("pTools")=2 continue
		$$$lexcheckid("%PROFILE_NONE") set mt("pTools")=-2 continue
		$$$lexcheckid("%NOFPLAN") if m=1,$$$mtStatementType'="INS" { set saveplan=0 } continue
		$$$lexcheckid("%NORUNTIME") if $g(mt("doruntime")) {s %msg="Cannot use both %NORUNTIME and %DORUMTIME keyword options." d error(400)}  set mt("noruntime")=1 continue
		$$$lexcheckid("%DORUNTIME") if $g(mt("noruntime")) {s %msg="Cannot use both %NORUNTIME and %DORUMTIME keyword options." d error(400)}  set mt("doruntime")=1 continue
		if m=1 {
			if '$d($$$mtRowlimit) $$$lexcheckid("%ROWLIMIT") do varcon set $$$mtRowlimit=val continue
			if '$d($$$mtRowOffset) $$$lexcheckid("%ROWOFFSET") do varcon set $$$mtRowOffset=val continue
		}
		QUIT
	}
.
	if $$check("WITH") { // WITH must be followed by PREDICTIONS, then do time series parsing
		do skipid("PREDICTIONS"), tsml
	}
.
	#; JLF090
	n nsav s nsav=$g(negate) n negate s negate=0
	s sldst="" d dist(.sldst)  ;  SELECT [ DISTINCT [ BY ( sldst ) ] ]
	#; AK531
	s:sldst'="" $$$mtDistinct(m)=$s(sldst="d":"",1:sldst)
	s:sldst $$$mtGroupDistinctList(m)=sldst s $$$mtOutput(m)=$S(sldst'="":"d",1:"")_"^"
	#; AK387
	#;  [ TOP <var> | TOP <const> | TOP ALL ]
	$$$lexcheck("TOP") do // PVA180: Allow top for subqueries; allow TOP ALL
	. if '$d($$$mtTopArg(m)) { set $$$mtTopStyle(m)="TOP" } elseif $$$mtTopStyle(m)'="TOP" { do error(386) } // do not allow mixing of TOP with other styles in the same query block
	. $$$lexcheck("ALL") s $$$mtTopArg(m)="" QUIT // Just a syntax marker: we'll get rid of it later
	. do varcon s $$$mtTopArg(m)=val
	#; AK387-
	#; AK483
	#;  set the title of each SELECT-item into mtc(0,0,"select",1:n)
	#;  Allow AS on a SELECT-item, not on an arbitrary  ;  AK278
	#;  expression (we should separately implement %ALIAS as a way to
	#;  give an arbitrary expression a name for reuse within the query,
	#;  so the expression is written AND gets evaluated only once)
	#; AK517
	i info,m=1 k mtc(0,0,"select") s infocnt=0
	n seln  ;  SELECT-item counter, used in as
	f seln=1:1 {
		d selit
		$$$lexnotcheck(",",QUIT)  ;  SELECT-List items
	}
	if m=1 {
		#; we only use into i%%sqlcol() if this is a simple select * from single table query 
		if info {
			set mtc(0,0,"only select star") = ($g(mtc(0,0,"only select star"))=0)&&($ll($$$mtFromList(m))=1)&&($g(mtc(0,0,"only select star","tbl")))
			kill mtc(0,0,"only select star","tbl")
		} else {
			#; we don't want to populate mtc(0,0) which is info compile metadata, so we move this information to mt
			set $$$mtOnlySelectStar = ($g($$$mtOnlySelectStar)=0)&&($ll($$$mtFromList(m))=1)&&($g(mt("only select star","tbl")))
			kill mt("only select star","tbl")	
		}
	}
	if $d(mt("tsml",m)), $d(selinfo("sel",m)) {
		set tsmlCols=mt("tsml",m,"colNames")
		set selV=""
		for {
			set selV=$o(selinfo("sel",m,0,selV),1,selData)
			quit:selV=""
			if tsmlCols[("^"_$p(selData,$c(1))_"^") {
				set tsmlCols = $replace(tsmlCols,"^"_$p(selData,$c(1))_"^","^")
			}
		}
		if tsmlCols'="^" {d error(195)}
	}
.
	#; AK483-
	#;  mark location of FROM/INTO clause
	i info,m=1 d  ; Assign the location of the 'FROM' clause
	. s mtc(0,0,"sf")=$g(input(line-1))
	. i $$$UPPER($e(mtc(0,0,"sf"),$l(mtc(0,0,"sf"))-3,*))="FROM" s mtc(0,0,"sf")=(line-1)_"^"_($l(mtc(0,0,"sf"))-3)
	. e  d
	.. s:trtpc begline=line,begtoken=f
	.. i trtpc $$$lexcheckid("INTO") d
	... f  d blist^%qaqpsq1(2-$$param^%qaqpsq1) $$$lexnotcheck(",",QUIT)
	.. s:trtpc endline=line,endtoken=f
	.. i trtpc f indexline=begline:1:endline d
	... i indexline=begline,endline=begline d  s $e(input(begline),begtoken,endtoken-1)=""
	.... s mt("rtpc","into")=$e(input(begline),begtoken,endtoken-1)
	... e  i indexline=begline,endline'=begline s $e(input(begline),begtoken,*)=""
	... e  i indexline'=begline,indexline'=endline s input(indexline)=""
	... e  i indexline'=begline,indexline=endline s $e(input(endline),1,endtoken-1)=""
	.. s:trtpc line=begline,f=begtoken
	.. s mtc(0,0,"sf")=line_"^"_(f-$S(line>1:$L(sql)-$L(input(line)),1:0))
	i one,$L($$$mtOutput(m),",")'=2 d error(10)
	#; AK395
	i m=1,$$$mtStatementType'="INS" d mark:extab,targt^%qaqpsq1 i extab s mt("intoloc")=$LB(l1,m1) d mark s $li(mt("intoloc"),3,4)=$LB(l1,m1)
	$$$lexcheckid("FROM") do switch^%qaqpsq(switch)	// DPV3196 FROM is optional
	#;---------- where-clause, group-clause, having-clause
	$$$lexcheckid("WHERE") d where
	$$$lexcheckid("%PARTITION") d partition
	$$$lexcheckid("GROUP") d group
	$$$lexcheckid("HAVING") d having
	
	if $d($$$mtTopArg(m)) { d order^%qaqpsq1(0) } // only parse order in subquery if there is top
	do limit^%qaqpsq1, offset^%qaqpsq1, fetch^%qaqpsq1 //process LIMIT, OFFSET, FETCH
	kill:$g($$$mtTopArg(m))="" $$$mtTopArg(m) // PVA180 // PVA183; TOP ALL has served its disambiguation purpose; no longer needed
	#;  moved Further Processing,imply,$$getno to ^sql
	QUIT
tsml ; TimeSeries (modelname) ; verify model name, set up
	#; mt("tsml",m) = model-name ^ trained-model-name ^ date-val ^ channel1-val ^ channel2-val ^ ... ^ channelN-val
	n mname,tsmlf,lexm,li,vals
	d skip("(")
	s mt("tsml",m)=lower,mname=value
	d skip("ID")
	s mt("tsml",m)=mt("tsml",m)_"^"
	$$$lexcheckid("USE") s mt("tsml",m)=mt("tsml",m)_lower d skip("ID")
	s mt("tsml",m,"colNames")="^"
	s lexm=$$lexmark^%qaqpsq()
	s tsmlf=$$GetTSModel^%apiDDL(mname) ; returns $LIST(datef,ch1f,ch2f,...)
	f li=1:1:$ll(tsmlf) {
		s lower=$li(tsmlf,li),value=$ZCVT($li(tsmlf,li),"U")
		s mt("tsml",m,"colNames")=mt("tsml",m,"colNames")_value_"^"
		d colmn^%qaqpsl2,lexgo^%qaqpsq(lexm)
		s mt("tsml",m)=mt("tsml",m)_"^"_val
	}
	s vals = $p(mt("tsml",m),"^",3,*)_"^"
	d skip(")")
	RETURN
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK483
selit	;  SELECT-item, including */T.*
	if m=1 {
		if info {
			set mtc(0,0,"only select star")=$g(mtc(0,0,"only select star"))-1
		} else {
			set $$$mtOnlySelectStar=$g($$$mtOnlySelectStar)-1	
		}
	}
	$$$lexcheck("*") GOTO star  ;  SELECT *
	new inselect
	set inselect=m  ; Flag to say processing SELECT-List
	set lcval="" ; colmn records the val associated with the name variable here.
	if info {
		do mark
		set seln(seln)=$lb(l1,m1)  ;  stack them
	}
	do scalx()
	if info {
		new selectItemText
		do mark
			// grab the select item text
		set selectItemText=$zstrip($e($s('input:input,1:input(l1)),$li(seln(seln),2),m1-1),">W")	// put in mtc() in title
		set l1=$li(seln(seln)),m1=$li(seln(seln),2)
	}
		#;  for SELECT T.*, make sure was not used improperly (val=lcval)
	if $g(mt("tstar")) {
		do error(29):val'=lcval
		new sqn
		set sqn=0,val=$$$mtV(val)
		do star1($e(val,3,*))
		kill mt("tstar")
		QUIT
	}
	do selinfo(1)
	do as,title:info
	do apndo(val)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA304: create partition tag
partition
	$$$lexskip("BY")
	s where=1
	n saveusef s saveusef=$g($$$mtCorrFieldUsed(m))  ;  mask correlated field usage
	d prdct() s $$$mtPartitionPredicates(m)=val
	s $$$mtCorrFieldUsed(m)=saveusef  ;  fields in WHERE should not affect "onerow"
	s where=0
	QUIT	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
star	n jj,sqn s sqn=0  ;  loop over mt("from") and add all fields
	#;  sqn - last merged subquery - could have >1 entries in a row
	f jj=1:1:$ll($$$mtFromList(m)) d star1($li($$$mtFromList(m),jj))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA050: add new of qlbl
star1(frmit) n tname,upp,xac,nn,qlbl  ;  process a single SLAB in FROM
	#;  if it's a merged subq/view, add the SELECT list of the merged
	#;  subquery sqn, but only if not already added - several SLAB's
	#;  together from the same subq is possible, also remember sqn for
	#;  the next SLAB
	#; PVA050: add ftolbl call
	if m=1 {
		if info{
			do $I(mtc(0,0,"only select star"))
		} else {
			do $I($$$mtOnlySelectStar)	
		}
	}
	s qlbl=$$ftolbl(m,frmit) ; get exposed correlation name.
	i frmit?1.n1",".e QUIT:sqn=+frmit  s sqn=+frmit GOTO adsq
	s tname=$$$mtFromTableName(m_"^"_frmit)  ;  get the table name
	i tname?1"%%Q"1.n s sqn=$e(tname,4,*) GOTO advf  ;  it's a virtual stream
	if $g(callname)'="tablist" { do ddflst(tname,.upp,.xac) } else { set upp="",xac="" } ;  it's a basetable - get field lists,
	#;  add val# for frmit.fname (possibly assign it) to SELECT-list
	#; PVA050: tptfln now takes qlbl argument
	new qtbl set qtbl=$$ftotbl(m,frmit)
	f nn=1:1:$ll(upp) { d adsel($$tfptln(m,frmit,qlbl,$li(upp,nn)),$li(upp,nn),$li(xac,nn)) } d:($g(inview)="")&&($g(callname)'="tablist") addPrivFields(qtbl,xac)	// DPV3095
	i $d(upp(1)) { n nd s nd="" f  { s nd=$o(upp(nd)) f nn=1:1:$ll(upp(nd)) { d adsel($$tfptln(m,frmit,qlbl,$li(upp(nd),nn)),$li(upp(nd),nn),$li(xac(nd),nn)) } d:($g(inview)="")&&($g(callname)'="tablist") addPrivFields(qtbl,xac(nd)) }}	// DPV2607=	// DPV3095
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adsq	new nn  ;  add the SELECT list of the merged subquery sqn to this one
	#; PVA050: added vptln call here
	set:info qlbl=$$ftotbl(m,frmit) ; get table name.
		#; if $g(callname)'="tablist", mt("AS") may not be defined (DPV3639)
	for nn=1:1:$ll($g($$$mtAlphaUpAliases(sqn))) {
		do vptln(qlbl,sqn,$li($$$mtAlphaUpAliases(sqn),nn))
		do adsel($p($$$mtOutputVals($$$mtOutput(sqn)),",",nn),$li($$$mtAlphaUpAliases(sqn),nn),$lg($g($$$mtAliases(sqn)),nn))
	}
	do:($g(inview)="")&&($g(callname)'="tablist") addPrivFields(qlbl,$g($$$mtAliases(sqn)),$g($$$mtAlphaUpAliases(sqn)))	// DPV3095
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
advf	n nn  ;  add to the SELECT list the virtual fields of a virtual stream
	#; PVA050: added vptln call
		#; if $g(callname)'="tablist", mt("AS") may not be defined (DPV3639)
	for nn=1:1:$ll($g($$$mtAlphaUpAliases(sqn))) {
		do vptln(qlbl,sqn,$li($$$mtAlphaUpAliases(sqn),nn))
		do adsel($$$mtPViewIDVal($$$mtP(sqn))+nn,$li($$$mtAlphaUpAliases(sqn),nn),$lg($g($$$mtAliases(sqn)),nn))
	}
	QUIT
	#; PVA050: new routine: vptln
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
addPrivFields(tab,fields,fields2)	; add fields in $List fields to mtc(0,0,"select privs",tab)
	RETURN:$$$LOWER($$$LastPiece(tab,"."))?1"tsq"1.n1"%"
	do:'$d(mtc(0,0,"select privs",tab,"realname")) realname^%qaqpsq(tab)
	new field,ptr,ptr2
	set ptr=0
	for ptr2=1:1 {
		quit:'$listnext(fields,ptr,field)
		if '$d(field),$d(fields2) { set field=$lg(fields2,ptr2) }
		continue:$g(field)=""  // possible?  If so, should this be an error?
		set:'$lf($g(mtc(0,0,"select privs",tab)),field) mtc(0,0,"select privs",tab)=$g(mtc(0,0,"select privs",tab))_$lb(field)
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
vptln(qlbl,sqn,fname) ; new style ptln maintenance for views 
	n vinf
	s vinf=%viewinfo("vcols",sqn,fname) QUIT:vinf="" ; fname exposed twice by table subquery, so don't record in ptln
	s $$$ptln(m,qlbl_"."_$tr(fname,".",$c(2)))=$li(vinf,2) ; could check if already there, but why bother? - just more code to same effect
	QUIT	
	#; PVA050: new routine: ftolbl	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ftolbl(m,flbl) ; returns most qualified label corresponding to flbl. That is, correlation name if one used, else schema.table.
	#; m - input - query number
	#; flbl - intput - $$$mtFromTableName(...) label, i.e. without the initial m^
	n qlbl,found,fitem,tinf s found=0
	s qlbl="" for  { q:found  s qlbl=$o($$$mtFLabelsSaveNode(m,qlbl)) 
		s fitem="" for  { s fitem=$o($$$mtFLabels(m,qlbl,fitem),1,tinf) q:fitem=""
		    #; the following circumlocution for comparingn flbl and fitem is to
		    #;   support the incomplete flbl's constructed for X.* for merged views.
			if $p($p(fitem,"^",2),",")=$p(flbl,",") s found=1,qlbl=$s($li(tinf,2):$tr(qlbl,".",$c(2)),1:$li(tinf)) quit 
		}
	}
	QUIT qlbl	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ftotbl(m,flbl) ; returns table name corresponding to flbl.
	#; m - input - query number
	#; flbl - intput - $$$mtFromTableName(...) label, i.e. without the initial m^
	n qlbl,found,fitem,tinf s found=0
	s qlbl="" for  { q:found  s qlbl=$o($$$mtFLabelsSaveNode(m,qlbl)) 
		s fitem="" for  { s fitem=$o($$$mtFLabels(m,qlbl,fitem),1,tinf) q:fitem=""
		    #; the following circumlocution for comparingn flbl and fitem is to
		    #;   support the incomplete flbl's constructed for X.* for merged views.
			if $p($p(fitem,"^",2),",")=$p(flbl,",") s found=1,qlbl=$li(tinf) quit
		}
	}
	QUIT qlbl	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA050: add qlbl arg for new style ptln maintenance
tfptln(m,label,qlbl,fname) n val  ;  $$: val# for label.fname, possibly assign it
	#;  manage ptln() data structure for [t.]f lookup:
	#; PVA050: eliminate all special entries and usage of ptln for detecting ambiguous column
	#;    references. That is now all done directly by colmn. Ptln now has only simple, fully
	#;    qualified entries. 
	#;  ptln(m,<EXTERNAL LABEL>.FNAME)=val  ;  this qualified field name used
	#; PVA070: just use 'column' so the double ptln entry convention for single column idkey
	#;    is properly set up if the first reference to is from a 'SELECT *'. 
	do column^%qaqpsl2(1,m,m,qlbl,fname,tname,m_"^"_label,0,"")
	QUIT val
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adsel(val,fname,low)  ;  add val to SELECT-list mt("o"), update seln, mt("AS"/"as")
	set:low="" low=fname  ;  needed?
	set:$$$mtVType($$$mtV(val))="s" val=$p($$$mtV(val),"^",4)  ;  for merged case with AS - should we reset fname=$p(2),low=$p(5)?
	set seln=$l($$$mtOutput(m),",")
	do addas(m,seln,fname,low)
	if info { new selectItemText set selectItemText=low do title }
	do apndo(val)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
addas(m,pos,value,lower) ;  maintain mt("AS"/"as")
	new cteFldAlias,name
	#;  NOTE: name,value,lower (as well as m,val) are necessary for selinfo!
	#; PVA050: added following comment:
	#;  NOTE; value, lower are expected to be simple identifiers, as this is only currently 
	#;        used for star processing which lists simple exposed names. Does not have to 
	#;        worry about expressions, arrow syntax, etc. the way the tag 'as' does.
	set name=value
	do selinfo(1)  ;  maintain selinfo() for now
	#;  handle external AS if any
	#; PVA050: eliminate all viewinfo usage; maintain new style view structures by calling the new addvinf.
	set cteFldAlias=""  // Default the CTE's alias as unspecified ("")!
	if cteWQNList'="",cteQBm=m,$ld($g($$$mtCTEColumnList(withQryName)),pos,cteFldAlias) {} // --- If an alias is used for a CTE's <with clause> in the current query block 'm', then set the CTE's alias 'cteFldAlias' accordingly ---
	if (cteFldAlias'="")||($lg($g($$$mtAliases(m)),pos)'="") { // --- Process either a CTE's Alias or a Traditional Alias ---
		if cteFldAlias'="" { // --- Process the CTE's <with column name> Alias --- 
			set lower=cteFldAlias,value=$$$UPPER(cteFldAlias),$li($$$mtAliases(m),pos)=cteFldAlias,$li($$$mtAlphaUpAliases(m),pos)=value
		} else { // --- Process the Traditional Alias ---
			set lower=$li($$$mtAliases(m),pos),value=$li($$$mtAlphaUpAliases(m),pos)
		}
		do:$g(genview)'="" addvinf(m,val,value)
		do putval("s^"_value_"^^"_val_"^"_lower_"^")
		do selinfo(2,1)
		RETURN
	}
	set $li($$$mtAlphaUpAliases(m),pos)=value,$li($$$mtAliases(m),pos)=lower
	if $g(genview)'="" { do addvinf(m,val,$li($$$mtAlphaUpAliases(m),pos)) }
	do selinfo(2)
	QUIT
	#; PVA050: new routine addvinf.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
addvinf(m,val,colname) // Add new stype view/query column information
	#; m - input - current query number
	#; val - input - val# for current select item (MUST BE val# from before $$$mtSequencersQb() entry is added)
	#; colname - input - exposed column name of select item, i.e. the AS name, if present
	n fqucol,tname,bcol,vnum s fqucol="" ; fqucol: fully qualified underlying column, if there is one.
	#; test of colname exposed twice by view -> this will be marked as an ambiguous column by having
	#;    its info be empty.
	if $d(%viewinfo("vcols",m,colname)) s %viewinfo("vcols",m,colname)="" QUIT
	if $$$mtVType($$$mtV(val))="f" {
		#; PVA149: new place to get tname for arrow syntax
		#; DPV3258 s tname=$g($$$mtFromTableName($p($$$mtV(val),"^",2,3))) s:tname="" tname=$$$LastPiece($p($$$mtV(val),"^",3),"->")
		if $p($$$mtV(val),"^",2,3)["->" { s tname=$$$LastPiece($p($$$mtV(val),"^",3),"->") }
		else { s tname=$g($$$mtFromTableName($p($$$mtV(val),"^",2,3))) }
		s bcol=$p($$$mtV(val),"^",4)
		#; PVA149: Enable streamed view support of fqucol
		if $e(tname,1,3)="%%Q" {
			s vnum=$p(tname,"Q",2)
			if '$d($$$mtUnion(vnum)) s fqucol=$lg($g(%viewinfo("vcols",vnum,bcol))) // PVA240: tolerate garbage parse tree for CRV compile etc.
		}
		else {s fqucol=tname_"."_$tr(bcol,".",$c(2))}
	}
	s %viewinfo("vcols",m,colname)=$lb(fqucol,val)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;---------- DATA DICTIONARY ACCESS ----------
ddflst(tname,FLIST,flist) [callname,mt] PUBLIC {
		#;  return (by ref) non-hidden field lists
		#;
		#;  DPV2007=
		#;  We need to make sure we handle the case where the table is not defined
		#;  This might happen compiling a CREATE VIEW statement against a table not [yet] defined.
		#;  The table does not have to be defined at the time the CREATE VIEW is compiled, 
		#;  only when the CREATE VIEW is executed.
		#;  In case we can ever get here when the table is not defined outside the scope of CREATE VIEW,
		#;  I added a call to error(30) if the table des not exist.
		#;  DPV2060=
		#;  use new metatdata structure
 
	set FLIST="",flist=""	// DPV2534=
	QUIT:$g(callname)="tablist"	// DPV3284
	if $e(tname)=$c(1)&&($$$mtStatementType="CRV"||($$$mtStatementType="ALV")) { QUIT  }  	// DPV2309 - Could be unqualified table name, avoid <SUBSCRIPT> error  (DPV2721)
	set tabinfo=$$$GetRVIdxDataFromIQN(tname)
	if tabinfo="" {	// see if there are any table functions
		set irn=""
		if $d($$$mtTvfRoot) {
			set m="" 
			for  {
				set m=$o($$$mtTvfQbNode(m)) quit:'m
				set irn=$$$smdLoadGetIrn(tname,$g($$$mtTvf(m,tname)))
				quit:irn	// table function found
			}
			
		}
		if irn="" {
			if $$$mtStatementType'="CRV",$$$mtStatementType'="ALV" { d error(30) }
			else { QUIT  }
		}
		set ttype=1
	}
	else {
		set irn=$$$smdLoadGetIrn(tname)
		set ttype=$lg(tabinfo,3)
	}
	set FLIST=$$$smdAllUpperFields(ttype,irn)
	set flist=$$$smdAllExactFields(ttype,irn),mt("starbase",irn)=flist	// DPV2607 (Merge, not Set), mt("starbase",irn) is used in SavePlanar^%qaqplansave
	QUIT
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK483-
where	s where=1
	#; JLF015
	n anyofctx s anyofctx=""
	#; AK703
	n saveusef s saveusef=$g($$$mtCorrFieldUsed(m))  ;  mask correlated field usage
	d prdct(),andwhere(val,m)
	#; AK703
	s $$$mtCorrFieldUsed(m)=saveusef  ;  fields in WHERE should not affect "onerow"
	s where=0
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
andwhere(val,m) n wh  ;  AND condition val to the WHERE clause of query m
	s wh=$g($$$mtWhere(m))  ;  might be nothing there
	i wh $$$lexputlog("l^&^^"_wh_"^"_val_"^")
	s $$$mtWhere(m)=val
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
group	;  Process the <group by clause> here...						// AK745
	do skipid("BY")
	set where=1,group=1  // Start tracking the scope of the <where clause> & <group by clause> via the following globally-scoped variables: where | group
	for  do scalx() set $$$mtGroupDistinctList(m)=$g($$$mtGroupDistinctList(m))_val_"," $$$lexnotcheck(",",QUIT)
	set where=0,group=0  // Stop tracking the scope of the <where clause> & <group by clause>!
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
having	;  Process the <having clause> here...
	s having=1  // Start tracking the scope of the <having clause> via the following globally-scoped variable: having
	do prdct()
	#; PVA060: Defer moving predicates from the <having clause> to the <where clause> until
	#;         after uncollate(collate(..)) transformation is done (PVA057).
	#; i laggs="" d andwhere(val,m) QUIT  ;  Everything in WHERE if no aggregates
	set $$$mtHaving(m)=val
	set having=0  // Stop tracking the scope of the <having clause>!
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mark	;  if it is the main query
	s l1=line,m1=f  ;  mark the beginning of the expression
	QUIT:line<2  ;  no overflow on first (or only) line
	#;  note that sql = <k last characters from line-1> _ input(line)
	s m1=m1-$L(sql)+$L(input(l1))  ; compensate for previous line overflow
	#; AK457
	f  q:m1>0  s l1=l1-1,m1=m1+$L(input(l1))+1  ;  might actually be in prev. lines
	QUIT
	
	; marktoken is just like mark but can be used to calculate information of previous tokens
	; line1 - putative line on which token is found
	; f1 - putative start of token
	; p1 - putative one beyond end of token
	; l1 - "real" line where token found
	; m1 - "real" beginning of token in input(l1)
	; p1 - real one beyond end of token in input(11)
	; sql and input are public variables set in the parsing process
marktoken(line1,f1,p1,l1,m1,n1) [ sql, input ] public {	 ;  if it is the main query
	s l1=line1,m1=f1  ;  mark the beginning of the expression
	s n1=p1-1 ; mark the end of the expression JSL5024
#if 1	
	QUIT:line1<2  ;  no overflow on first (or only) line
	#;  note that sql = <k last characters from line-1> _ input(line)
	s m1=m1-$L(sql)+$L(input(l1))  ; compensate for previous line overflow
	s n1=n1-$L(sql)+$L(input(l1))  ; ditto
	;s n1=n1+t1 ; JSL5024, calculate end of expression
	; AK457= (to calculate m1 and l1) and JSL5024 (to calculate end of expression)
	f  {  
		q:m1>0
		s t2=+$L($g(input(l1)))+1 ; JSL5024 from AK457
		s m1=m1+t2 ;  might actually be in prev. lines
		s n1=n1+t2 ; JSL5024
		s l1=l1-1
	}
	QUIT
#endif	
}
	
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
title	;  expression end - produce title and save it (if the main query)
	#; AK517
	QUIT:m'=1
	set infocnt=infocnt+1,mtc(0,0,"select",infocnt)=$$cut
	set $p(mtc(0,0,"select",infocnt),$c(1),11)=val
	set $p(mtc(0,0,"select",infocnt),$c(1),12)=$g(selectItemText)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cut()	n as,l2,m2,ival  ;  $$:  return the expression that ends here
	s n=$$$mtV(val),as=$S($e(n)="s":$p(n,"^",5),1:"")_$c(1)  ;  AS x
	#; DPV1414-
	#;  If not Field [AS x], look for external AS clause already processed
	#; DPV1475
	#; AK483
	i as=$c(1) n v,d s v=val f  s v=$o($$$mtV(v),1,d) q:v=""  i $e(d)="s",$p(d,"^",4)=val,$p(d,"^",2)=$p(selinfo("sel",m,0,seln),$c(1)) s n=d,as=$p(n,"^",5)_$c(1) q
	#; PVA129: use sviewfollows to set up 'as' for streamed views and also handle 's' nodes
	s ival=val,as=$$sviewfollow(as,.ival)
	if $$$mtVType($$$mtV(ival))="f" QUIT as
	#; i $e($s(as=$c(1):n,1:$$$mtV($p(n,"^",4))))="f" QUIT as  ; Agg/Field/Expression [AS x] //pva129 subsumed by above
	#; DPV1414--
	#; AK483
	QUIT as_"aK"_seln  ;  should never appear in actual Prepare() results
	#; PVA129: create sviewfollows
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
sviewfollow(as,val) // follow val through s node and one or more levels of
		#; streamed view. val is updated (if passed by reference) to
		#; be the val underlying the levels of streamed view ifn. 
		#; The 'as' value returned is the first one encountered on the 
		#; val traversal, with input counting as 'first' if supplied. 
	new v,j,qn
	for  {
		set v=$$$mtV(val)
		if $e(v)="s" { set val=$p(v,"^",4) continue }
		quit:$e(v)'="f"
		quit:$p(v,"^",2,3)["->"||('$d($$$mtFromTableName($p(v,"^",2,3)))) // PVA149: arrow syntax	// DPV3258 Avoid <SUBSCRIPT> error if $p(v,"^",2,3) is long because of -> joins
		quit:$e($$$mtFromTableName($p(v,"^",2,3)),1,3)'="%%Q"
		set qn=$e($$$mtFromTableName($p(v,"^",2,3)),4,*)
		set j=val-$$$mtPViewIDVal($$$mtP(qn))
		quit:'j  // val is the %VID field for this qn
		set:as=$c(1) as=$lg($g($$$mtAliases(qn)),j)_$c(1)
		set val=$p($$$mtOutputVals($$$mtOutput(qn)),",",j)
	}
	QUIT as	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
prdct(pflag)  ;  <prdct> ::= <cond> { AND <cond> | OR <cond> }
	#; 'pflag' - If 1 : The predicate is allowed to be Non-Logical;
	#;                  Otherwise, the predicate must be Logical.
	#;         -------- Called From 'paren' with 1 - Has parenthases
	s pflag=$G(pflag) d cond 
	QUIT:'logic
	n val1,op s pflag=""
	#; AK281
	#; JLF090
	n val2,nsav s nsav=$g(negate) n negate s negate=+nsav
	d and  ;  precedence - do all the AND's first
	#; PVA093: eliminate support for '!
	f
	{	$$$lexnotchose("OR!",op,QUIT) 
		s val1=val d cond,and
		$$$lexputlog("l^"_$s(negate:"&",1:"!")_"^^"_val1_"^"_val_"^") 
		s negate=+nsav
	}
	#; JLF090-
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
and	n val1,op  ;  <and> ::= <cond> { AND <cond> }
	#; JLF090
	n val2,nsav s nsav=$g(negate) n negate s negate=+nsav
	#; PVA093: eliminate support for '&
	f
	{	$$$lexnotchose("AND&",op,QUIT)
		s val1=val d cond 
		$$$lexputlog("l^"_$s(negate:"!",1:"&")_"^^"_val1_"^"_val_"^") 
		s negate=+nsav
	}
	#; JLF090-
	#; AK281-
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cond	;--- <cond> ::= <scalx> [ <op>  <compr> | <logop> ] | NOT <cond> |
	#;               EXISTS  (  selex  ) | FOR <forex>
	#;  <op> ::= [']= | [']< | [']> | ] | '] | [ | '[ | %STARTSWITH
	#; MRP126+  Move the following lines up to <cond> from <lterm>
	#; JLF090
		n nsav s nsav=$g(negate) n negate s negate=nsav
	$$$lexcheckid("NOT") s negate='negate d cond d:'logic error(15) QUIT
	n noindex s noindex=0 $$$lexcheck("%NOINDEX") set noindex=1 // PVA242
	$$$lexcheckid("EXISTS") d xists^%qaqpop,not:negate,noindex:noindex  QUIT // PVA242
	#; JLF090-
	$$$lexcheckid("FOR") d forex^%qaqpop(m),noindex:noindex QUIT  ;  FOR expression // PVA242
	n anyofVal s anyofVal=""
	s:$d(anyofctx) anyofctx=1 d scalx($s(noindex:0,1:1)) // PVA242
	s:$d($$$mtV(val))&&(",%ANYOF,%ANYOFKEY,"[(","_$p($$$mtV(val),"^",2)_",")) anyofVal=val
	QUIT:logic
	n op,val1,val2 s val1=val
	#; AK688
	#;  <cond> ::= <scalx> <filter> <scalx> [ <sizehint> ]
	#;  <filter> ::= %FIND | %INSUB | %INSET
	$$$lexanyid(" %FIND %INSUB %INSET ",op) do  QUIT
	. d scalx()
	. $$$lexputlog("v^"_$s(op="%INSET":"%FIND",op="%FIND":"%INBIT",1:op)_"^^"_val1_"^"_val_"^"_$$sizepc())
	. d not:negate,noindex:noindex
	#; AK688-
	#; AK690
	$$$lexcheckid("%SETINCHUNK") d scalx() $$$lexputlog("v^"_$E("'",negate)_"%SETINCHUNK^^"_val1_"^"_val_"^") do noindex:noindex RETURN
	#;  AK405 - restore original code
	#; JLF090
	#; PVA242: support noindex below
	$$$lexcheckid("%CONTAINSTERM") d containsterm^%qaqpsl2,not:negate,noindex:noindex QUIT
	$$$lexcheckid("%CONTAINS") d contains,not:negate,noindex:noindex QUIT
	$$$lexchose("'='<'>']'[%STARTSWITH",op) GOTO gotoperator
	d logop^%qaqpop,noindex:noindex QUIT
	#; JLF090-
	#; We don't support %ANYOF(x) = ANY (SELECT ...)
	#;  <compr>  ::= <scalx> | ( ALL | ANY | SOME ) ( <query> )
gotoperator	if 'anyofVal
	{	$$$lexany(" ALL ANY SOME ",val2) d skip("("),query^%qaqpsq(m,1,m),skip(")"),opsome^%qaqpop(op,val2,val),noindex:noindex QUIT // pva242
	}
	s:('anyofVal && $d(anyofctx) && anyofctx'=0) anyofctx=1	// anyofctx=0 means that we're doing an outer join
	d scalx() s:($p($$$mtV(val),"^",2)["%ANYOF") anyofVal=val
	do:$g(callname)'="tablist"&&($$IsAStream(val)||($$IsAStream(val1))) error(313)	// DPV3057=
	#; JLF090
	#; If negated and there is a deMorgan operator, then flip the operator, else put an explicit NOT
	n dop i negate { s dop=$s($e(op)="'":$e(op,2,*),"=<>[]"[op:"'"_op,1:op) } else { s dop=op }
	$$$lexputlog("v^"_dop_"^^"_val1_"^"_val_"^") 
	if op=dop&&negate $$$lexputlog("l^'^^"_val_"^")
	d:noindex noindex // PVA242
	#; d:negate not
	#; JLF090-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  <sizehint> ::= SIZE <pconst>
sizepc() RETURN:'$$checkid("SIZE") ""
	do pconst
	RETURN:$e($$$mtV(val),3,*)'>0 ""
	RETURN val_"^"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
pconst	if $$check("(") { do pconst,skip(")") RETURN } ;  <pconst> ::= ( <pconst> ) | <const>
const	;
	set:"'"""'[$e(sql,f) mt("noquconst",val)=1  ;  AK544
	do putval("t^"_value),skip(9)  ;  constant
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK688-
	#; created by PVA242
noindex 
	set $$$mtLOperator($$$mtL(val))=$$$mtLOperator($$$mtL(val))_"%NOINDEX"
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
contains
	RETURN:$$$mtVType($$$mtV(val))'="f"
	new aoa,basecoll,canonCollVal,canonPatternVal,ChooseSearchKeyFn,coll,contVal,inVAval,op,prevLog,rawPatternVal,sep,StandardizeFn,val1
	set prevLog="",StandardizeFn="",ChooseSearchKeyFn=""
	set basecoll=val
	set aoa=""
	set ChooseSearchKeyFn="METHOD:*ChooseSearchKey"
	set StandardizeFn="METHOD:*Standardize"
	do putval("v^"_StandardizeFn_"^^"_basecoll_"^") set canonCollVal = val
	do skip("(")
	for i=1:1 {
		set op="%ANYOFKEY:"_$i($$$mtNumAnyOf)
		set coll=$$putunary(basecoll,op)  // coll = mt("unary",basecoll,op)
		do scalx()
		set rawPatternVal = val
		do putval("v^"_StandardizeFn_":"_op_"^^"_rawPatternVal_"^") s canonPatternVal = val
		do putval("v^"_ChooseSearchKeyFn_":"_op_"^^"_rawPatternVal_"^")
		do putlog("v^=^^"_coll_"^"_val_"^")		//  %ANYOFKEY(coll) = ChooseSearchKey(pattern)
		do putlog("l^ANYOFAND^^"_val_"^") d:aoa putlog("l^&^^"_aoa_"^"_val_"^") s aoa=val
		do putlog("v^[^^"_canonCollVal_"^"_canonPatternVal_"^")
		do complexlog^%qaqpnl(m,val)
		do:prevLog'="" putlog("l^&^^"_prevLog_"^"_val_"^") 
		set prevLog=val 
		quit:'$$check(",")
	}
	do skip(")")
	do putlog("l^&^^"_prevLog_"^"_aoa_"^")
	set logic=1
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
scalx(sflag,pCallArg=0)  ;---------- <scalx> ::= <term> { <arith> <term> } | <scalxansi>
	#;  switch to scalxansi if ^%SYS("sql","sys","ansi operator precedence") set
	#;  <arith> ::=  +  |  -  |  *  |  /  |  \  |  #  |  _
	#; 'sflag' - If 1 : The predicate is allowed to be Logical
	#;                  Otherwise, the predicate must be Non-Logical.
	#;         -------- Called From 'cond' with 1
	#; pCallArg=1 if this scalx is processing the argument to a procedure in a CALL statement.  No columns are allowed here for this case.
	#;	If someone accidently double quotes a literal with delimited identifiers, this will report a better error and not get an <UNDEFINED> in colmn
	new agdst,list,sldst
	if ($$$ANSIPrecedenceContext(%context)=1) { 
		do scalxansi($G(sflag),pCallArg)
		RETURN
	}
	set sflag=$G(sflag)
	do term
	RETURN:logic  ;  error(11) could never happen!
	new op,val1
	set sflag=""
	for  { 
		$$$lexnotchose("+-*/\#_",op,RETURN)
		set val1=val
		do term
		$$$lexputval("v^"_op_"^^"_val1_"^"_val_"^")
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
scalxansi(sflag,pCallArg=0)  ;---------- <scalxansi> ::= <product> { <scal_second_op> <product> }
		#;  <scal_second_op> ::=  +  |  -  | _ 
		#; 'sflag' - If 1 : The predicate is allowed to be Logical
		#;                  Otherwise, the predicate must be Non-Logical.
		#;         -------- Called From 'cond' with 1
		#; pCallArg=1 if this scalx is processing the argument to a procedure in a CALL statement.  No columns are allowed here for this case.
		#;	If someone accidently double quotes a literal with delimited identifiers, this will report a better error and not get an <UNDEFINED> in colmn
	
	set sflag=$G(sflag)
	do product(sflag,pCallArg)
	RETURN:logic  ;  error(11) could never happen!
	new op,val1
	set sflag=""
	for  {
		$$$lexnotchose("+-_",op,RETURN)
		set val1=val
		do product(sflag,pCallArg)
		$$$lexputval("v^"_op_"^^"_val1_"^"_val_"^")
	}
	RETURN
	
product(sflag,pCallArg=0)  ;------------ <term> { <scal_first_op> <term> }
		#;  <scal_first_op> ::=  *  |  /  |  \  |  # 
		#; 'sflag' - If 1 : The predicate is allowed to be Logical
		#;                  Otherwise, the predicate must be Non-Logical.
		#;         -------- Called From 'cond' with 1
		#; pCallArg=1 if this scalx is processing the argument to a procedure in a CALL statement.  No columns are allowed here for this case.
		#;	If someone accidently double quotes a literal with delimited identifiers, this will report a better error and not get an <UNDEFINED> in colmn
	set sflag=$g(sflag) do term
	RETURN:logic  ;  error(11) could never happen!
	new op,val1
	set sflag=""
	for  { 
		$$$lexnotchose("*/\#",op,RETURN)
		set val1=val
		do term
		$$$lexputval("v^"_op_"^^"_val1_"^"_val_"^")
	}
	RETURN
.
as	;  As Qualified Field
	new asext,asint,cteFldAlias,lxloc,templv
		#;  Whether an internal AS alias (following the SELECT-item) was provided, an external 
		#;  one (renaming as part of a view definition), and storage to stack $LIST(lower,value)
	if token="ID" {
		if value="ORDER" { // PVA204: disambiguate possible ORDER
			s lxloc=$$lexmark^%qaqpsq()
			$$$lexskip("ID")
			s asint=1
			$$$lexcheck("BY") s asint=0
			d lexgo^%qaqpsq(lxloc)
		} elseif ",LIMIT,OFFSET,"[(","_value_",") { // disambiguate possible LIMIT and OFFSET
			set lxloc=$$lexmark^%qaqpsq()
			$$$lexskip("ID")
			for { if token="(" { do lext } else { quit } } // skip through all the left paranthesis
			if ("?:9"[token)||(token="ALL") { // if literal or variable or parameter, this is a LIMIT or OFFSET clause
				set asint=0
				do lexgo^%qaqpsq(lxloc)
			} else { 
				set asint=1 
			} 
		} else {
			set asint=1
		}
	} else {
		set asint=0
		$$$lexcheck("AS") s asint=1
	}
		#; AK862
		#;  record alias identical to the DD field name
	i asint,callname="findname" s templv=$g(mt("namapv",val)) i $p(templv,".",3)=value n floc s floc="" d getloc^%qaqpsl2,namap^%qaqpsl2("f",templv,floc)
		#; AK862-
	set asext=$ld($g($$$mtAliases(m)),seln)
	set cteFldAlias=""  // Default the CTE's alias as unspecified ("")!
	if cteWQNList'="",cteQBm=m,$ld($g($$$mtCTEColumnList(withQryName)),seln,cteFldAlias) {} // --- If an alias is used for a CTE's <with clause> in the current query block 'm', then set the CTE's alias 'cteFldAlias' accordingly ---
	if (cteFldAlias'="")||asext||asint { // --- Process either a CTE's Alias or a Traditional Alias (ext/int) ---
		if asext { set templv=$lb(lower,value),lower=$li($$$mtAliases(m),seln),value=$li($$$mtAlphaUpAliases(m),seln) }
			#;  fill mt("as"/"AS") from the internal alias
		elseif asint { set $li($$$mtAliases(m),seln)=lower,$li($$$mtAlphaUpAliases(m),seln)=value }
		set:(cteFldAlias'="") lower=cteFldAlias,value=$$$UPPER(cteFldAlias),$li($$$mtAliases(m),seln)=cteFldAlias,$li($$$mtAlphaUpAliases(m),seln)=value  // CTE alias <with column name> within the <with column list> takes precedence!
			#; PVA050: eliminate viewinfor usage; maintain new style view structure with addvinf.
		do:($g(genview)'="")&&(value'="") addvinf(m,val,value)
		$$$lexputval("s^"_value_"^^"_val_"^"_lower_"^")
		do selinfo(2,1)
		set:asext lower=$li(templv),value=$li(templv,2)
		if asint { $$$lexskip("ID") }
		RETURN
	}
		#;  no alias used - fill mt("AS") from the SELECT-list
		#; PVA050: do this based on the 'name' variable, and collapse arrow syntax to simple name
	if val=lcval { ; if val from scalx is the same as the val (lcval) associate with name,
	               #; left by last colmn call, then name applied to this select item.
		set $li($$$mtAlphaUpAliases(m),seln)=$tr($$$LastPiece($$$LastPiece(name,"."),"->"),$c(2),".")
	}
	else { set $li($$$mtAlphaUpAliases(m),seln)="%%C"_seln }
		#; PVA050: eliminate viewinfo usage and maintain new structures with addvinf.
	do:$g(genview)'="" addvinf(m,val,$li($$$mtAlphaUpAliases(m),seln))
		#; --- Record SELECT-List Information --- 
	do selinfo(2)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
term	;  <term> ::= const | colmn | var | xtfun | agg | window | unary | USER | ( <paren> ) | NULL
	new found,op,opName
	set found = 0
	if token=9 {	// constant
		$$$lexputval("t^"_value)
		if "'"""'[$e(sql,f) {	// not a quoted constant
			set mt("noquconst",val)=1
			new type
			if value["." {	// Numeric
				do create^%qaqpdt(val,"const","%Library.Numeric",,,,value)
				set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Numeric",$s($l(value)'=0:$l(value),1:1),$s($Number(value)'="":$l($p($Number(value),".",1))+$l($p($Number(value),".",2)),1:$s($l(value)'=0:$l(value),1:1)),$l($p(value,".",2)),0)	// matches values in literal^%qaqpif2
			} else {	// Integer
				new type
				if value>=-2147483648,value<=2147483647 {	// not going to worry about SmallInt of TinyInt...
					set type="%Library.Integer"
				} else {
					set type="%Library.BigInt"
				}
				do create^%qaqpdt(val,"const",type,,,,value)
				set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2(type,$s($l(value)'=0:$l(value),1:1),$s($Number(value)'="":$l($Number(value)),1:$s($l(value)'=0:$l(value),1:1)),,0)	// matches values in literal^%qaqpif2
			}
		} else {	// quoted literal
			new type
			if value'=$c(0) { set type="%Library.RawString" } else { set type="%Library.String" }	// RawString so that we do not perform needless conversions for non-'' values
			do create^%qaqpdt(val,"const",type,,,,value)
			set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2(type,$s($l(value)'=0:$l(value),1:1),$s($l(value)'=0:$l(value),1:1),,value="")	// matches values in literal^%qaqpif2
		}
		GOTO lext
	}
	if token="ID",%delid=2 {
		set %sqlColPriv="s"
		GOTO colmn^%qaqpsl2
	}
		#;  These items are reserved words and there should be no ambiguity if found
	$$$lexany(" CAST CHAR CHARACTER_LENGTH CHAR_LENGTH COALESCE CONVERT CURRENT_DATE CURRENT_TIME CURRENT_TIMESTAMP DATE DAY LEFT LOWER MONTH NULLIF RIGHT SPACE SUBSTRING SYSDATE TRIM ",op) set opName=op,op=$tr(op,"_") goto @op   	// DPV1499 (NULLIF)	// DPV1920 (CONVERT)	// DPV2713 (SYSDATE)	// DPV2980 (POSITION no longer reserved)	// DPV3050 (CHAR)
		#;  These items are not reserved words and they might signify a function or a field name
	if token="ID",",ABS,ASCII,%BITPOS,CEILING,CHARINDEX,%CHUNK,DATALENGTH,DATEADD,DATEDIFF,DATE_TRUNC,DATENAME,DATEPART,DAY,DECODE,DEGREES,EMBEDDING,FLOOR,GETDATE,GETUTCDATE,GREATEST,HASHBYTES,IFNULL,INSTR,ISNULL,ISNUMERIC,JSON_ARRAY,JSON_OBJECT,LAST_DAY,LAST_IDENTITY,LCASE,LEAST,LEN,LENGTH,LPAD,LTRIM,MOD,MONTH,NOW,NVL,%OBJECT,%OID,PATINDEX,POSITION,POWER,PREDICT,PROBABILITY,RADIANS,REPEAT,REPLACE,REPLICATE,REVERSE,ROUND,RPAD,RTRIM,SEARCH_INDEX,SIGN,%SIMILARITY,SQRT,SQUARE,STR,STRING,SUBSTR,STUFF,TOCHAR,TO_CHAR,TODATE,TO_DATE,TONUMBER,TO_NUMBER,TO_POSIXTIME,TO_TIMESTAMP,TO_VECTOR,UCASE,UNIX_TIMESTAMP,VECTOR_COSINE,VECTOR_DOT_PRODUCT,%VHASH,XMLELEMENT,XMLFOREST,XMLCONCAT,XMLCOMMENT,YEAR,"[(","_value_",") {	// DPV2282 (ASCII, CEILING, DAY, FLOOR, MONTH, POWER, YEAR)	// DPV2284 (REVERSE)	// DPV2285 (REPLICATE)	// DPV2286 (LEN)	// DPV2287 (ISNUMERIC)	// DPV2288 (STR)	// DPV2615 (CHARINDEX,STUFF) // DPV2618 (PATINDEX)	// DPV2686 (REPLACE)	// DPV2727 (LAST_IDENTITY)	// DPV2756 (DATALENGTH)	// DPV2980 (POSITION no longer reserved)	// DPV2994 (%OBJECT)	// DPV3058 (LAST_DAY)	// DPV3059 (%OID)	// DPV3334 (INSTR)	// DPV3335 (TO_TIMESTAMP)	// DPV3336 (LCASE)	// DPV3358 (GETUTCDATE)	// DPV3515 (NOW) // DPV4107 (DEGREES,RADIANS,SQRT,SQUARE) // CPG060 (HASHBYTES)
		set op=""
		new call,holdvals
		do holdcur^%qaqpsl2(.holdvals)		// Save current parse information
		$$$lexanyid(" ABS ASCII %BITPOS CEILING CHARINDEX %CHUNK DATALENGTH DATEADD DATEDIFF DATE_TRUNC DATENAME DATEPART DAY DECODE DEGREES EMBEDDING FLOOR GETDATE GETUTCDATE GREATEST HASHBYTES IFNULL INSTR ISNULL ISNUMERIC JSON_ARRAY JSON_OBJECT LAST_DAY LAST_IDENTITY LCASE LEAST LEN LENGTH LPAD LTRIM MOD MONTH NOW NVL %OBJECT %OID PATINDEX POSITION POWER PREDICT PROBABILITY RADIANS REPEAT REPLACE REPLICATE REVERSE ROUND RPAD RTRIM SEARCH_INDEX SIGN %SIMILARITY SQRT SQUARE STR STRING SUBSTR STUFF TOCHAR TO_CHAR TODATE TO_DATE TONUMBER TO_NUMBER TO_POSIXTIME TO_TIMESTAMP TO_VECTOR UCASE UNIX_TIMESTAMP VECTOR_COSINE VECTOR_DOT_PRODUCT %VHASH XMLELEMENT XMLFOREST XMLCONCAT XMLCOMMENT YEAR ",op) set found=1	// One of the supported functions	// DPV2282 (ASCII, CEILING, DAY, FLOOR, MONTH, POWER, YEAR)	// DPV2284 (REVERSE)	// DPV2285 (REPLICATE)	// DPV2286 (LEN)	// DPV2287 (ISNUMERIC)	// DPV2288 (STR)	// DPV2615 (CHARINDEX,STUFF) // DPV2618 (PATINDEX)	// DP2686 (REPLACE)	// DPV2727 (LAST_IDENTITY)	// DPV2756 (DATALENGTH)	// DPV2980 (POSITION no longer reserved)	// DPV2994 (%OBECT)	// DPV3058 (LAST_DAY)	// DPV3059 (%OID)	//DPV3334 (INSTR)	// DPV3335 (TO_TIMESTAMP)	// DPV3336 (LCASE)	// DPV3358 (GETUTCDATE)	// DPV3515 (NOW) // DPV4107 (DEGREES,RADIANS,SQRT,SQUARE) // CPG060 (HASHBYTES)
		if found {
			$$$lexcheck("(") set opName=op,op=$tr(op,"_") GOTO @op
			do setold^%qaqpsl2(.holdvals) set op=""  ;  Must be a field name, not a function.  colmn will handle this below	// DPV2038 (pass by reference)
		}
	}
		// Support ODBC function extensions without {fn ...} syntax. Note some handled above already, this adds ones not already supported that way
		// Note that we PEEK ahead here -- don't lext if we find what we want, funext will do that
		// Reserved words means we can go right to funext and let it handle because no amibiguity if something's a field name/UDF or not
	$$$peekany(" HOUR MINUTE RIGHT SECOND ") GOTO funext
	$$$peekanyid($$$ODBCFunctionExtensions) set found = 1
		// We peeked ahead and found an ambiguous {fn ...} function (without the brackets), but need to be sure it's a function. funext() can assume the function name
		// is ODBC function regardless of paren because it assumes {fn...} was parsed. We need to check here for "(" b/c e.g. pi could be a column name OR a function
		// OR a constant inside {fn ... }, but we can't let it be a constant without {fn ...}
	if found {
		new holdvals,isFunction,schema,udf set isFunction = 0
			// the non-reserved words could be unqualified user-defined functions. if they are we will just ignore 
			// this and they'll be handled later
		set udf = $$ResolveProcName^%qaqpsq1(value,.schema)
		if 'udf {
			do holdcur^%qaqpsl2(.holdvals)		// Save current parse information so we can reset it for funext if we dispatch there
			// need to lex ahead so we can check for '(' and be certain this is a function call
			$$$lexanyid($$$ODBCFunctionExtensions,op)
			$$$peek("(") set isFunction = 1 // if this isn't a function it might just be a field name, so we just reset the parser location and continue along
			do setold^%qaqpsl2(.holdvals)
			GOTO:isFunction funext
		}
	}
	if token="$" {	// DPV2093+
		set op=""
		new holdvals
		do holdcur^%qaqpsl2(.holdvals)		// Save current parse information
		$$$lexskip("$")
		$$$lexanyid(" EXTRACT FIND FNUMBER JUSTIFY LENGTH LIST LISTBUILD LISTDATA LISTFIND LISTFROMSTRING LISTGET LISTLENGTH LISTSAME LISTTOSTRING MVFMT MVFMTS MVICONV MVICONVS MVOCONV MVOCONVS PIECE TRANSLATE TSQL_BIT_AND TSQL_BIT_NOT TSQL_BIT_OR TSQL_BIT_XOR TSQL_COL_NAME TSQL_ERROR TSQL_GETUTCDATE TSQL_FETCH_STATUS TSQL_INDEX_COL TSQL_LIKE TSQL_LOCK_TIMEOUT TSQL_LTRIM_SYBASE TSQL_NESTLEVEL TSQL_NEWID TSQL_OBJECT_ID TSQL_OBJECT_NAME TSQL_PLUS TSQL_RAND TSQL_RTRIM_SYBASE TSQL_SERVERNAME TSQL_SPID TSQL_SQLSTATUS TSQL_TRANCOUNT TSQL_VERSION TSQL_DB_NAME TSQL_HOST_NAME TSQL_TEXTPTR XSQL_MATCHES ",op) $$$lexcheck("(") set opName="$"_op goto @("Dollar"_$tr(op,"_")_"^%qaqpsq2")	// One of the supported $xxx functions	// DPV2100 (EXTRACT, LENGTH) // DPV2620 (TSQL_XXX() Support) // DPV2624 (TSQL_PLUS() support) //DPV2630 (TSQL_TEXTPTR()) // DPV2726 (TSQL_OBJECT_NAME)	// DPV2740 (TSQL_COL_NAME)	// DPV2743 (TSQL_INDEX_COL)	// DPV2746 (TSQL_OBJECT_ID)	// DPV2747 (TSQL_BIT_*)	// DPV2851 (TSQL_RAND)	// DPV2882 (TSQL_NEWID)	// DPV3176 (XSQL_MATCHES)	// DPV3207 (LISTBUILD, LISTFROMSTRING, LISTTOSTRING)	// DPV3454 (MV%%%) // MRP777 (JUSTIFY | TRANSLATE)
		$$$lexanyid(" H HOROLOG J JOB NAMESPACE TL TLEVEL USERNAME ZH ZHOROLOG ZJ ZJOB ZNSPACE ZPI ZTIMESTAMP ZTIMEZONE ZTS ZTZ ZV ZVERSION ",op) GOTO simplefun	// DPV3455=	// DPV3501 ($NAMESPACE)
		do setold^%qaqpsl2(.holdvals) set op=""  //  Not one of the supported $xxx functions, continue
	}	// DPV2093-
	new reservedAggs Set reservedAggs=" AVG SUM MAX MIN COUNT "
	new unreservedAggs Set unreservedAggs=" %BITMAPCHUNK %BITMAP %DLIST LIST XMLAGG STDDEV STDDEV_POP STDDEV_SAMP VAR_POP VAR_SAMP VARIANCE JSON_ARRAYAGG JSON_OBJECTAGG APPROX_COUNT_DISTINCT "
	new exclusiveWindowFuncs Set exclusiveWindowFuncs = " ROW_NUMBER RANK DENSE_RANK PERCENT_RANK CUME_DIST NTILE LAG LEAD FIRST_VALUE LAST_VALUE NTH_VALUE "
	new windowFuncs Set windowFuncs = exclusiveWindowFuncs _ reservedAggs _ unreservedAggs
		//If it's unambiguously a window function, it doesn't require an OVER clause
		//but check for ( to distinguish fields, etc.
	if token="ID",exclusiveWindowFuncs[(" "_value_" ") {
		new holdvals
		do holdcur^%qaqpsl2(.holdvals) 
		$$$lexskipid(value)
		if token'="(" {
			do setold^%qaqpsl2(.holdvals)
		} else {
			do setold^%qaqpsl2(.holdvals)
			do window(value)
			RETURN
		}
	}
		//Check for OVER clause to disambiguate from aggregates
	if token="ID",windowFuncs[(" "_value_" "),$$peekForOverClause() {
		do window(value)
		RETURN
	}
	if reservedAggs[(" "_token_" "),$$peekForOverClause() {
		do window(token)
		RETURN
	}
		#;  First check for aggregates functions that are not reserved words
	if token="ID",unreservedAggs[(" "_value_" ") {
		new holdvals
		do holdcur^%qaqpsl2(.holdvals) 
		$$$lexskipid(value)
		if token'="(" { do setold^%qaqpsl2(.holdvals) set op="" }	// must be a field name, column will handle this below	// DPV2038 (pass by reference)
		else { set op=value GOTO agg } 		 			// it is one of these aggregates
	}
		#; These aggregate functions are reserved words
	$$$lexanyid(reservedAggs,op) GOTO agg
		#; if $g(anyofctx)>0 GOTO unary:$$anyid(" %ANYOF %ANYOFKEY ",.op)	// JLF015, PVA280: obsolete
		#; PVA280: Use $$any to enforce that any unary must be a reserved word: SELECT <unary> <column> and SELECT <column> <alias> are indistinguishable
	$$$lexany(" + - %ALPHAUP %EXACT %EXTERNAL %INTERNAL %INTEXT %MINUS %MVR %ODBCIN %ODBCOUT %PLUS %RUNTIMEIN %RUNTIMEOUT %SQLSTRING %SQLUPPER %STRING %TRUNCATE %UPPER UPPER %COLLATE ",op) GOTO unary     //BJB449
	if $$$ISENCODEDCOLLATE(token) {
		set op = token
		do lext
		GOTO unary
	}     //BJB449
	set %sqlColPriv="s"
		#; PVA280: handle pseudo-columns as reserved words
	if " %CLASSNAME %ID %REALID %KEY %TABLENAME %VALUE %VID ID "[(" "_token_" ") { // JMM1327=
		GOTO colmn^%qaqpsl2
	}
	GOTO var^%qaqpop:"?:"[token
	GOTO xtfun^%qaqpop:token="$$"
	$$$lexcheckid("NULL") $$$lexputval("t^") RETURN
	$$$lexcheckid("CASE") GOTO case
	$$$lexcheck("{") d dts $$$lexskip("}") RETURN  ;  ODBC escape syntax
	$$$lexcheckid("USER") $$$lexputval("v^USER^^") d create^%qaqpdt(val,"op","%Library.String",,,,"USER") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",40,40) RETURN
	$$$lexcheck("(") d paren $$$lexskip(")") RETURN
	do error(12):sflag'=1 do error(4)
	
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; DPV1499
case	;  Searched CASE Expression ::=
	#;         CASE 
	#;           WHEN <prdct> THEN <scalx>
	#;           [ WHEN <prdct> THEN <scalx> ... ]
	#;           [ ELSE <scalx> ] 
	#;         END
	#;  Simple CASE Expression ::=
	#;         CASE <scalx>
	#;           WHEN <scalx> THEN <scalx>
	#;           [ WHEN <scalx> THEN <scalx> ... ]
	#;           [ ELSE <scalx> ] 
	#;         END
	#;
	n nsav s nsav=$g(negate) n negate s negate=0	// Don't propagate negate state through a CASE expression
	n case,casevalue,type s case="v^CASE^^",type=""
	If token'="WHEN" {	// Simple CASE Expression
		d scalx() s casevalue=val
		For  {
			$$$lexnotcheckid("WHEN",QUIT)
			d scalx() $$$lexputlog("v^=^^"_casevalue_"^"_val_"^") $$$lexputval("l^L2V^^"_val_"^") 
			s case=case_val_"^" $$$lexskipid("THEN") d scalx() s case=case_val_"^"
			#; DPV3045 s:type="" type=$$$VTRgetdt(val)					// DPV2145=
		}
	}
		#;  Searched CASE expression
	Else {
		For  {
			$$$lexnotcheckid("WHEN",QUIT)
			d prdct() $$$lexputval("l^L2V^^"_val_"^") 
			s case=case_val_"^" $$$lexskipid("THEN") d scalx() s case=case_val_"^"
			#; DPV3045 s:type="" type=$$$VTRgetdt(val)					// DPV2145=
		}
	}
	d else $$$lexputval(case_val_"^") $$$lexskipid("END")
	#; DPV3045 s:type="" type="%Library.String"							// DPV2145=
	#; DPV3045 d create^%qaqpdt(val,"op",type,,,,"CASE")
	#; DPV3045 s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2(type)					// DPV2145=\
	#; DPV3045 i $$check("CASE")
	#; DPV1499-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
else	$$$lexcheckid("ELSE") d scalx() QUIT
	$$$lexputval("t^")  ;  default NULL if no ELSE
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
simplefun
	$$$lexputval("v^SYSVAR:$"_op_"^")
	new optype set optype="%Library.String"
	set:$case(op,"TL":1,"TLEVEL":1,"ZJ":1,"ZJOB":1,"ZTIMEZONE":1,"ZTZ":1,:0) optype="%Library.Integer"
	if $case(op,"ZH":1,"ZHOROLOG":1,"ZPI":1,:0) {
		if op="ZPI" {
			do create^%qaqpdt(val,"op","%Library.Numeric",,,,"PI",18)
			s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Numeric",21,19,18)
		}
		else {
			do create^%qaqpdt(val,"op","%Library.Numeric",,,,"ZH",6)
			s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Numeric",21,19,6)
		}
		QUIT
	}
	d create^%qaqpdt(val,"op",optype,,,,"$"_op)
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2(optype)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dts	n dts,dtstype
	s dts=value
	$$$lexskip("ID")
	GOTO funext:dts="FN"  ; AK362
	i dts'="D",dts'="T",dts'="TS" d error(40) QUIT  ;  ODBC escape extension _dts_ not supported
	s dtstype=token                  ;  remember whether constant or variable
	d varcon  ;  only constant or variable allowed here
	#;  mark the value with the given datatype
	s dts=$s(dts="D":"%Library.Date",dts="T":"%Library.Time",1:"%Library.TimeStamp")
	d createval^%qaqpdt(val),dtset^%qaqpdt(val,dts)
	s:info dtstype="Val_"_val_$$definfo^%qaqpif2(dts),$$$VTRomsinfo(val)=dtstype
	s val=$$putunary(val,"%ODBCIN")  ;  apply %OdbcIn() to the value
	d createval^%qaqpdt(val),dtset^%qaqpdt(val,dts) // DPV1811=
	s:info $$$VTRomsinfo(val)=dtstype
	QUIT  ;--- dts
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK473
varcon	;  allow only constant or ?/host-variable
	$$$lexcheck("(") d varcon $$$lexskip(")") QUIT  ;  AK555
	i "?:"[token { d var^%qaqpop QUIT  }	;  variable
	$$$lexputval("t^"_value) $$$lexskip(9)		;  constant
	s:"'"""'[$e(sql,f) mt("noquconst",val)=1  ;  mark if constant quoted  ;  AK555
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK473-
funext	;  ODBC scalar function extentions (Lets keep them in alphabetic order...)
	$$$lexcheckid("ABS") $$$lexskip("(") g ABS
	  #; The following functions take 1 argument and return type %Library.Numeric or %Library.Double
	i $$anyid(" ACOS ASIN ATAN COS COT DEGREES EXP LOG LOG10 RADIANS SIN SQRT TAN ",.op) {
		d skip("("),scalx()
		i $$IsAStream(val) n fn,ft s ft="Scalar",fn=op d error(37)
		$$$lexputval("v^"_op_"^^"_val_"^") $$$lexskip(")")	// DPV3173= ,create^%qaqpdt(val,"op","%Library.Float",,,,op)
		#; DPV3173= s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Float") 
		QUIT
	}
	  #; The following functions take 1 argument and return type %Library.Integer
	i $$anyid(" DAY DAYOFMONTH DAYOFWEEK DAYOFYEAR HOUR MINUTE QUARTER SECOND WEEK YEAR ",.op) {	// DPV1873 (Remove LENGTH)	// DPV2613 (DAY)	// DPV3443 (YEAR)
		$$$lexskip("(") d scalx()
		i $$IsAStream(val) n fn,ft s ft="Scalar",fn=op d error(37)
		$$$lexputval("v^"_op_"^^"_val_"^") d create^%qaqpdt(val,"op","%Library.Integer",,,,op) $$$lexskip(")")
		s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
		QUIT
	}
	  #; The following functions take 1 argument, they are also parsed as stand-alone scalar functions
	  #; The first group are not reserved words, we parse the "(" here
	i $$anyid(" ASCII CEILING FLOOR MONTH YEAR ",.op) $$$lexskip("(") g @op	// DPV2282=
	  #; The second group are reserved words, we parse the "(" later
	//i $$any(" MONTH YEAR ",.op) g @op	// DPV2282=
	
	
	  #; The following functions take 1 argument and return type %Library.String
	i $$anyid(" DAYNAME MONTHNAME ",.op) {	// DPV3443 (remove YEAR, move CHAR below)
		$$$lexskip("(") d scalx()
		i $$IsAStream(val) n fn,ft s ft="Scalar",fn=op d error(37)
		$$$lexputval("v^"_op_"^^"_val_"^") d create^%qaqpdt(val,"op","%Library.String",,,,op) $$$lexskip(")")
		s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",15,15)
		QUIT
	}
	i $$checkid("CHAR") {	// DPV3443
		$$$lexskip("(") d scalx()
		i $$IsAStream(val) n fn,ft s ft="Scalar",fn=op d error(37)
		$$$lexputval("v^CHAR^^"_val_"^") d create^%qaqpdt(val,"op","%Library.String",,,,"CHAR") $$$lexskip(")")
		s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",1,1)
		QUIT
	}
	$$$lexcheckid("CONCAT") n val1 $$$lexskip("(") d scalx() s val1=val $$$lexskip(",") d scalx(),under $$$lexskip(")") QUIT  ; PYD001
	i $$checkid("CONVERT") {
		$$$lexskip("(") d scalx()
		i $$IsAStream(val) n fn,ft s ft="Scalar",fn="CONVERT" d error(37)
		$$$lexskip(",") d convert $$$lexskip(")") 
		QUIT
	}
	i $$checkid("CURDATE") d skip(")"):$$check("("),CURRENTDATE QUIT  ; AK362
	i $$checkid("CURTIME") d skip(")"):$$check("("),CURRENTTIME QUIT  ; AK362
	i $$checkid("DATABASE") {	// DPV2001+
		d skip(")"):$$check("(")
		d putval("v^DATABASE^^"),create^%qaqpdt(val,"op","%Library.String",,,,"DATABASE") 
		s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",40,40)
		QUIT
	}	// DPV2001=
	i $$checkid("IFNULL") d skip("(") g NVL ; DPV1103
	i $$checkid("LCASE") g LOWER  ; DPV1103
	i $$checkid("LEFT") g LEFT  ; PYD001, DPV1354
	i $$checkid("LENGTH") d skip("(") g LENGTH  ;  DPV1873
	i $$checkid("LTRIM") d skip("(") g LTRIM
	i $$checkid("ATAN2"){
		new val1
		do skip("("),scalx() 
		if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="ATAN2 (arg1)" do error(37) }
		set val1=val d skip(","),scalx()
		if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="ATAN2 (arg2)" do error(37) }
		do putval("v^ATAN2^^"_val1_"^"_val_"^")
		do skip(")")
		QUIT
	}
	i $$checkid("MOD") {
		new val1
		do skip("("),scalx() 
		if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="MOD (arg1)" do error(37) }
		set val1=val d skip(","),scalx()
		if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="MOD (arg2)" do error(37) }
		do putval("v^MOD^^"_val1_"^"_val_"^")
		//do create^%qaqpdt(val,"op","%Library.Numeric",,,,"MOD")
		do skip(")")
		//set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Numeric")
		QUIT
	}
	i $$checkid("NOW") d skip(")"):$$check("("),CURRENTTIMESTAMP QUIT  ; AK362
	i $$checkid("PI") d skip(")"):$$check("("),putval("v^PI^^"),create^%qaqpdt(val,"op","%Library.Numeric",,,,"PI",18) s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Numeric",21,19,18) QUIT  ; DPV1103	// DPV3173	// DPV3220
	i $$checkid("POWER") d skip("(") g POWER	// DPV2283 (move logic to POWER)
	i $$checkid("REPEAT") d skip("(") g REPEAT  ; DPV1339
	i $$checkid("RIGHT") g RIGHT  ; PYD001 ; DPV1354
	i $$checkid("ROUND") d skip("(") g ROUND  ; DPV1354
	i $$checkid("RTRIM") d skip("(") g RTRIM
	i $$checkid("SIGN") d skip("(") g SIGN ; DPV1103
	i $$checkid("SPACE") g SPACE  ; DPV1339
	i $$checkid("SUBSTRING") g SUBSTRING ; DPV1113
	i $$checkid("TIMESTAMPADD") {
		n interval,intexp,tsexp
		d skip("(")
		If value="SQL_TSI_YEAR"        { s value="yy",lower="TIMESTAMPADD",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_QUARTER" { s value="qq",lower="TIMESTAMPADD",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_MONTH"   { s value="mm",lower="TIMESTAMPADD",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_WEEK"    { s value="wk",lower="TIMESTAMPADD",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_DAY"     { s value="dd",lower="TIMESTAMPADD",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_HOUR"    { s value="hh",lower="TIMESTAMPADD",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_MINUTE"  { s value="mi",lower="TIMESTAMPADD",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_SECOND"  { s value="ss",lower="TIMESTAMPADD",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_FRAC_SECOND"  { s value="ms",lower="TIMESTAMPADD",token=9 d scalx() s interval=val }	// DPV2192=
		Else { n t s t="SQL_TSI_YEAR, SQL_TSI_QUARTER, SQL_TSI_MONTH, SQL_TSI_WEEK, SQL_TSI_DAY, SQL_TSI_HOUR, SQL_TSI_MINUTE, SQL_TSI_SECOND, or SQL_TSI_FRAC_SECOND" d error(1) }	// DPV2112 (enhance error reporting for invalid parameter)	// DPV2192=
		do skip(","),scalx()
		set intexp=val
		do skip(","),scalx()
		set tsexp=val
		if $$IsAStream(interval) { n fn,ft s ft="Scalar",fn="TIMESTAMPADD (arg1)" d error(37) }
		if $$IsAStream(intexp) { n fn,ft s ft="Scalar",fn="TIMESTAMPADD (arg2)" d error(37) }
		if $$IsAStream(tsexp) { n fn,ft s ft="Scalar",fn="TIMESTAMPADD (arg3)" d error(37) }
		do putval("v^DATEADD^^"_interval_"^"_intexp_"^"_tsexp_"^") //create^%qaqpdt(val,"op","%Library.TimeStamp",,,,"DATEADD")
		do skip(")")
		QUIT
	}
	i $$checkid("TIMESTAMPDIFF") {
		n interval,tsexp1,tsexp2
		d skip("(")
		If value="SQL_TSI_YEAR"       { s value="yy",lower="TIMESTAMPDIFF",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_MONTH"  { s value="mm",lower="TIMESTAMPDIFF",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_WEEK"   { s value="wk",lower="TIMESTAMPDIFF",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_DAY"    { s value="dd",lower="TIMESTAMPDIFF",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_HOUR"   { s value="hh",lower="TIMESTAMPDIFF",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_MINUTE" { s value="mi",lower="TIMESTAMPDIFF",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_SECOND" { s value="ss",lower="TIMESTAMPDIFF",token=9 d scalx() s interval=val }
		ElseIf value="SQL_TSI_FRAC_SECOND" { s value="ms",lower="TIMESTAMPDIFF",token=9 d scalx() s interval=val }	// DPV2192=
		Else { n t s t="SQL_TSI_YEAR, SQL_TSI_MONTH, SQL_TSI_WEEK, SQL_TSI_DAY, SQL_TSI_HOUR, SQL_TSI_MINUTE, SQL_TSI_SECOND, SQL_TSI_FRAC_SECOND" d error(1) }	// DPV2112 (enhance error reporting for invalid parameter)	// DPV2192=
		d skip(","),scalx() s tsexp1=val d skip(","),scalx() s tsexp2=val
		i $$IsAStream(interval) n fn,ft s ft="Scalar",fn="TIMESTAMPDIFF (arg1)" d error(37)
		i $$IsAStream(tsexp1) n fn,ft s ft="Scalar",fn="TIMESTAMPDIFF (arg2)" d error(37)
		i $$IsAStream(tsexp2) n fn,ft s ft="Scalar",fn="TIMESTAMPDIFF (arg3)" d error(37)
		do putval("v^DATEDIFF^^"_interval_"^"_tsexp1_"^"_tsexp2_"^") //,create^%qaqpdt(val,"op","%Interval",,,,"DATEDIFF")
		do skip(")")
		QUIT
	}
	i $$checkid("TRUNCATE") {
		n val1 d skip("("),scalx() 
		i $$IsAStream(val) n fn,ft s ft="Scalar",fn="TRUNCATE (arg1)" d error(37)
		s val1=val d skip(","),scalx()
		i $$IsAStream(val) n fn,ft s ft="Scalar",fn="TRUNCATE (arg2)" d error(37)
		d putval("v^TRUNCATE^^"_val1_"^"_val_"^")	// DPV3173,create^%qaqpdt(val,"op","%Library.Float",,,,"TRUNCATE")
		d skip(")") 
		#; DPV3173 s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Float") 
		QUIT
	}
	i $$checkid("UCASE") d skip("(") g UCASE  ; DPV1103
	i $$checkid("USER") {	// DPV2001+
		d skip(")"):$$check("(")
		d putval("v^USER^^"),create^%qaqpdt(val,"op","%Library.String",,,,"USER") 
		s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",40,40)
		QUIT  
	}	// DPV2001=
	d error(40)  ;  ODBC escape extension not supported
	QUIT  ;--- funext
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
PGen1ArgInt(op,rtype="%Library.Integer",Parse1stParen=1) // DPV2282=
	#; General parsing of a single scalar function that takes one argument and returns an <rtype> value
	#;   For example:  YEAR(date_exp)
	#;   At this point the function name has been parsed
	do:Parse1stParen skip("(") d scalx()
	if $$IsAStream(val) { new fn,ft set ft="Scalar",fn=$s(opName'="":opName,1:op) do error(37) }
	do putval("v^"_op_"^^"_val_"^")
	do:rtype'=$c(0) create^%qaqpdt(val,"op",rtype,,,,op)
	do skip(")")
	set:info&&(rtype'=$c(0)) $$$VTRomsinfo(val)=$$definfo^%qaqpif2(rtype)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ABS	;  Parse ABS function here ; DPV1113 - Made it not a unary function
	#;---------------------------------------------------------------------
	#;  BNF:
	#;
	#;    ABS(<numeric value expression>)
	#;
	#;  At this point 'ABS(' has been parsed
	#;
	Do PGen1ArgInt("ABS",$c(0),0) QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ASCII	;   Returns the ASCII code value of the leftmost character of a character expression. (DPV2282)
	#;   Syntax    ASCII ( character_expression )
	#;   Arguments:
	#;       character_expression - Is an expression of type %String
	#;
	Do PGen1ArgInt("ASCII","%Library.SmallInt",0) QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK690
%BITPOS	d scalx(),putval("v^%BITPOS^^"_val_"^"),skip(")")
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK690-
CAST	GOTO CAST^%qaqpsq2
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
CEILING	; Parse CEILING Function (DPV2282)
	#;   Returns the smallest integer greater than, or equal to, the given numeric expression.
	#;   Syntax    CEILING ( numeric_expression )
	#;   Arguments:
	#;       numeric_expression - Is an expression of the exact numeric or approximate numeric data type category
	#;
	Do PGen1ArgInt("CEILING",$c(0),0) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
CHAR	;  Parse CHAR function here (DPV3050)
	#;  Returns the character equivalent of an integer
	#;---------------------------------------------------------------------
	#;  BNF:
	#;
	#;    CHAR(<integer expression>)
	#;
	#;  At this point 'CHAR' has been parsed
	#;
	Do PGen1ArgInt("CHAR","%Library.String",1) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
CHARINDEX	; Parse CHARINDEX function here (Transact-SQL)		// DPV2615
	#;	Returns the starting position of the specified expression in a character string
	#;   Syntax:	CHARINDEX ( expression1 , expression2 [ , start_location ] )
	#;   Arguments:
	#;   expression1
	#;   	Is an expression containing the sequence of characters to be found. expression1 is an expression of the short character data type category.
	#;   expression2
	#;   	Is an expression, usually a column searched for the specified sequence. expression2 is of the character string data type category.
	#;   start_location
	#;   	Is the character position to start searching for expression1 in expression2. 
	#;	If start_location is not given, is a negative number, or is zero, the search starts at the beginning of expression2.
	#;   
	n val1,val2 
	d scalx() i $$IsAStream(val) n fn,ft s ft="Scalar",fn="CHARINDEX (arg1)" d error(37)
	s val2=val 
	d skip(","),scalx() i $$IsAStream(val) n fn,ft s ft="Scalar",fn="CHARINDEX (arg2)" d error(37)
	s val1=val,val=""
	If $$check(",") d scalx() If $$IsAStream(val) n fn,ft s ft="Scalar",fn="CHARINDEX (arg3)" d error(37)
	d putval("v^CHARINDEX^^"_val2_"^"_val1_"^"_$s(val="":"",1:val_"^"))
	d create^%qaqpdt(val,"op","%Library.Integer",,,,"CHARINDEX") s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
	d skip(")")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
CHARACTERLENGTH ; Parse CHAR[ACTER]_LENGTH function here ; MRP583  ; DPV1113 moved this from built-in functions
CHARLENGTH      ;
	#;---------------------------------------------------------------------
	#;  BNF:
	#;
	#;    <char length expression> ::=
	#;       { CHAR_LENGTH | CHARACTER_LENGTH } (<string value expression>)
	#;
	#;  At this point CHAR_LENGTH or CHARACTER_LENGTH has been parsed
	#;
	d skip("(")
DATALENGTH	; DPV2756 (Sybase/SQL Server compatibility)
	d scalx()
	If '$$IsAStream(val) { d putval("v^CHARLEN^^"_val_"^"),create^%qaqpdt(val,"op","%Library.Integer",,,,"CHARLEN"),skip(")") }	// DPV2632= 
	Else                 { d putval("v^CHARLEN:STREAM^^"_val_"^"),create^%qaqpdt(val,"op","%Library.Integer",,,,"CHARLEN"),skip(")") }	// DPV2632= 
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK690
%CHUNK	d scalx(),putval("v^%CHUNK^^"_val_"^"),skip(")")
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK690-
COALESCE        ; generate symbol-table COALESCE entry
	#;    COALESCE(<expression> { , <expression>  ... })
	#;  At this point COALESCE has been parsed
	n pvstring s pvstring="" d skip("(") 
	For  { 
		d scalx() 
		i $$IsAStream(val) n fn,ft s ft="Scalar",fn="COALESCE" d error(37)  // DPV1738=
		s pvstring=pvstring_val_"^" 
		q:'$$check(",")  
	}
	d putval("v^COALESCE^^"_pvstring)
	#; i info s $$$VTRomsinfo(val)=$$definfo^%qaqpif2(type)	will be set later in %qaqpif2 so we know the type of the argument	// DPV2312+
	#;  create^%qaqpdt(val,"op",type,,,,"COALESCE") will be called later for this function in docats^%qaqpdt			// DPV2312-
	d skip(")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
CURRENTDATE     ;  genrate symbol-table CURRENT_DATE entry
	#;  BNF:
	#;
	#;    <current date value function> ::= CURRENT_DATE
	#;    <date string>    ::= "<date value>"
	#;    <date value>     ::= <year value> - <months value> - <days value>
	#;    <year value>     ::= <datetime value>
	#;    <months value>   ::= <datetime value>
	#;    <days value>     ::= <datetime value>
	#;    <datetime value> ::= <unsigned integer>
	#;
	#;  At this point 'CURRENT_DATE' has been parsed
	#;
	d putval("v^CURDATE^^"),create^%qaqpdt(val,"op","%Library.Date",,,,"CURRENT_DATE")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Date")
	QUIT  ;--- curdate
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
CURRENTTIME     ;  generate symbol-table CURRENT_TIME entry
	#;  BNF:
	#;
	#;    <current time value function> ::= 
	#;       CURRENT_TIME [ (<time precision>) ]
	#;    <time string>    ::= "<time value> [ <time zone interval> ]"
	#;    <time value>     ::= <hours value> : <minutes value> : 
	#;                         <seconds value>
	#;    <time zone interval> ::= <sign> <hours value> : <minutes value>
	#;    <hours value>    ::= <datetime value>
	#;    <minutes value>  ::= <datetime value>
	#;    <seconds value>  ::= <datetime value>
	#;    <datetime value> ::= <unsigned integer>
	#;    <sign>           ::= + | -
	#;    <time precision> ::= <time fractional seconds precision>
	#;    <time fractional seconds precision> ::= <unsigend integer>
	#;
	#;  At this point 'CURRENT_TIME' has been parsed
	#; DPV1599
	#;
	If $$check("(") {
		do scalx()
		if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="CURRENT_TIME (arg1)" do error(37) }
		do skip(")")
		do putval("v^CURTIME^^"_val_"^")
	}
	Else { d putval("v^CURTIME^^") }
	d create^%qaqpdt(val,"op","%Library.Time",,,,"CURRENT_TIME")
	#; DPV1599-
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Time")
	QUIT  ;--- curtime
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
CURRENTTIMESTAMP        ;  generate symbol-table CURRENT_TIMESTAMP entry
	#;  BNF:
	#;
	#;    <current timestamp value function> ::= 
	#;       CURRENT_TIMESTAMP [ (<timestamp precision>) ]
	#;    <timestamp string> ::= "<date value> <space> <time value>
	#;                            [ <time zone interval> ]"
	#;    <date value>     ::= <year value> - <months value> - <days value>
	#;    <year value>     ::= <datetime value>
	#;    <months value>   ::= <datetime value>
	#;    <days value>     ::= <datetime value>
	#;    <time value>     ::= <hours value> : <minutes value> : 
	#;                         <seconds value>
	#;    <time zone interval> ::= <sign> <hours value> : <minutes value>
	#;    <hours value>    ::= <datetime value>
	#;    <minutes value>  ::= <datetime value>
	#;    <seconds value>  ::= <datetime value>
	#;    <datetime value> ::= <unsigned integer>
	#;    <sign>           ::= + | -
	#;    <timestamp precision> ::= <time fractional seconds precision>
	#;    <time fractional seconds precision> ::= <unsigend integer>
	#;
	#;  At this point 'CURRENT_TIMESTAMP' has been parsed
	#;
	#;   See if there is a <timestamp precision>
	If $$check("(") {
		do scalx()
		if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="CURRENT_TIMESTAMP (arg1)" do error(37) }
		do skip(")")
		do putval("v^CURTS^^"_val_"^")
	}
	Else { d putval("v^CURTS^^") }
	d create^%qaqpdt(val,"op","%Library.TimeStamp",,,,"CURRENT_TIMESTAMP")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
DATEADD ; generate symbol-table DATEADD entry (MS SQL Server & Sybase Compatibility)
	#;    DATEADD(<datepart>, <number>, <dateexp>)
	#;  At this point DATEADD( has been parsed
	new datepart,number s datepart=$$ParseDatePart("DATEADD") 
	do skip(","),scalx() 
	if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="DATEADD (arg2)" do error(37) }
	set number=val
	do skip(","),scalx()
	if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="DATEADD (arg3)" do error(37) }
	do putval("v^DATEADD^^"_datepart_"^"_number_"^"_val_"^")	//,create^%qaqpdt(val,"op","%Library.TimeStamp",,,,"DATEADD")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
	do skip(")")
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
DATEDIFF        ; generate symbol-table DATEDIFF entry (MS SQL Server & Sybase Compatibility)
	#;    DATEDIFF(<datepart>, <startdate>, <enddate>)
	#;  At this point DATEDIFF( has been parsed
	new datepart,startdate
	set datepart=$$ParseDatePart("DATEDIFF")
	do skip(","),scalx()
	if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="DATEDIFF (arg2)" do error(37) }
	set startdate=val
	do skip(","),scalx()
	if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="DATEDIFF (arg3)" do error(37) }
	do putval("v^DATEDIFF^^"_datepart_"^"_startdate_"^"_val_"^")
	do create^%qaqpdt(val,"op","%Library.Integer",,,,"DATEDIFF")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
	do skip(")")
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
DATENAME        ; generate symbol-table DATENAME entry (MS SQL Server & Sybase Compatibility)
	#;    DATENAME(<datepart>, <dateexp>)
	#;  At this point DATENAME( has been parsed
	new val1
	set val1=$$ParseDatePart("DATENAME")
	do skip(","),scalx()
	if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="DATENAME (arg2)" do error(37) }
	do putval("v^DATENAME^^"_val1_"^"_val_"^")
	do create^%qaqpdt(val,"op","%Library.String",,,,"DATENAME")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.String",20,20)
	do skip(")")
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
DATEPART        ; generate symbol-table DATEPART entry (MS SQL Server & Sybase Compatibility)
	#;    DATEPART(<datepart>, <dateexp>)
	#;  At this point DATEPART( has been parsed
	new type,val1
	set val1=$$ParseDatePart("DATEPART",.type)
	do skip(","),scalx()
	if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="DATEPART (arg2)" do error(37) }
	do putval("v^DATEPART^^"_val1_"^"_val_"^")
	do create^%qaqpdt(val,"op",type,,,,"DATEPART")
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2(type)
	do skip(")")
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
DATETRUNC        ; generate symbol-table DATE_TRUNC entry 
	#;    DATE_TRUNC(<datepart>, <dateexp>)
	#;  At this point DATE_TRUNC( has been parsed
	new val1 set val1=$$ParseDatePart("DATETRUNC")
	do skip(","),scalx()
	if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="DATETRUNC (arg2)" do error(37) }
	do putval("v^DATETRUNC^^"_val1_"^"_val_"^") // mt("vtr") info will be filed at createval^%qaqpdt
	do skip(")")
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
DATE	;   Returns an %Date value the has been extracted from a DATE, TIMESTAMP, or STRING/TIMESTAMP value
	#;   Syntax    DATE ( expression )
	#;   Arguments:
	#;       expression - Is an expression of type %Date, %TimeStamp, %Integer, or %String
	#;
	#;  At this point "DATE" has been parsed
	Do PGen1ArgInt("CAST_DATE","%Library.Date",1) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
DAY	;   Returns an integer that represents the day part of a specified date
	#;   Syntax    DAY ( date_expression )
	#;   Arguments:
	#;       date_expression - Is an expression of type %Date
	#;
	Do PGen1ArgInt("DAYOFMONTH","%Library.SmallInt",0) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
DECODE	; generate symbol-table DECODE entry (Oracle Compatibility)
	#;    DECODE(<expression>, { <search>, <result>, ... }  [,<default>])
	#;  At this point DECODE( has been parsed
	#;    To evaluate this expression, compare <expression> to each search value one by one. 
	#;    If <expression> is equal to a <search>, return the corresponding <result>. 
	#;    If no match is found, return default, or, if default is omitted, returns null.
	#;  Returns a type the same as the first result, calculated later in %qaqpdt and %qaqpif2.
	n pvstring,type s pvstring="" // DPV2903 (new type)
	For  {
		d scalx() 
		i $$IsAStream(val) n fn,ft s ft="Scalar",fn="DECODE" d error(37)  // DPV1738=
		s pvstring=pvstring_val_"^" 
		q:'$$check(",")
	}
	d putval("v^DECODE^^"_pvstring)
	d skip(")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
DEGREES	;   Returns the corresponding angle in DEGREES for an angle specified in radians.
	#;   Syntax    DEGREES ( numeric_expression )
	#;   Arguments:
	#;       numeric_expression - Radians to be converted to degrees
	#;  At this point DEGREES( has been parsed
	#;
	Do PGen1ArgInt("DEGREES",$c(0),0) QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
EMBEDDING; Returns a %Vector value that was generated from passing text into an embedding model
	#; Syntax EMBEDDING( text [, configName ] )
	#; Arguments: 
	#;       text - Input to the embedding model, of type %String
	#;		 configName - Name of %Embedding.Config entry, of type %String
	new text, op, rtype
	set op = "EMBEDDING", rtype ="%Library.Vector"
	do scalx()
	set text=val
	if $$check(","){
		do scalx()
		do putval("v^"_op_"^^"_text_"^"_val_"^") // val holds the configName
	}
	else{
		do putval("v^"_op_"^^"_text_"^") // If configName is not provided, we'll check the %Library.Embedding field in qaqcpr 
	}
	do create^%qaqpdt(val,"op",rtype,,,,op)
	set:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2(rtype)
	set:info $li(mtc(0,0,"syspriv"),15)=1		// %USE_EMBEDDING priv flag
	do skip(")")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
FLOOR	; Parse FLOOR Function (DPV2282)
	#;   Returns the largest integer less than or equal to the given numeric expression
	#;   Syntax    FLOOR ( numeric_expression )
	#;   Arguments:
	#;       numeric_expression - Is an expression of the exact numeric or approximate numeric data type category
	#;
	Do PGen1ArgInt("FLOOR",$c(0),0) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
GETDATE ; generate symbol-table GETDATE entry (MS SQL Server & Sybase Compatibility)
	#;    GETDATE([<time precision>])
	#;  Treat the same as CURRENT_TIMESTAMP
	#;  At this point GETDATE( has been parsed
	If '$$check(")") {
		do scalx()
		if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="GETDATE (arg1)" do error(37) }
		do skip(")")
		do putval("v^CURTS^^"_val_"^")
	}
	Else { d putval("v^CURTS^^") }
	d create^%qaqpdt(val,"op","%Library.TimeStamp",,,,"CURRENT_TIMESTAMP")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
GETUTCDATE ; generate symbol-table GETUTCDATE entry (MS SQL Server & Sybase Compatibility)
	#;    GETUTCDATE([<time precision>])
	#;  Returns the datetime value that represents the current UTC time.
	#;  The current UTC time is derived from the current local time and the time zone setting
	#;  in the operating system of the computer on which the instance of Cache' is running.
	#;  At this point GETUTCDATE( has been parsed
	If '$$check(")") {
		do scalx()
		if $$IsAStream(val) { new fn,ft set ft="Scalar",fn="GETUTCDATE (arg1)" do error(37) }
		do skip(")")
		do putval("v^CURUTCTS^^"_val_"^")
	}
	Else { d putval("v^CURUTCTS^^") }
	d create^%qaqpdt(val,"op","%Library.TimeStamp",,,,"CURRENT_TIMESTAMP")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.TimeStamp")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
GREATEST	; generate symbol-table GREATEST entry
	#;    GREATEST(<expression> { , <expression>  ... })
	#;  At this point GREATEST( has been parsed
	new pvstring set pvstring=""
	for  {
		do scalx()
		if $$IsAStream(val) new fn,ft set ft="Scalar",fn="GREATEST" do error(37)
		set pvstring=pvstring_val_"^"
		quit:'$$check(",")
	}
	do putval("v^GREATEST^^"_pvstring)
	do skip(")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
HASHBYTES	; Parse HASHBYTES function here
	#;  
	#;   HASHBYTES ( algo , input )
	#;      algo    - Is the hash function we want to utilize
	#;      input   - Is the input text we want to hash
	#;
	#;  At this point, 'HASHBYTES(' has been parsed
	#;
	n val1 d scalx() i $$IsAStream(val) n fn,ft s ft="Scalar",fn="HASHBYTES (arg1)" d error(37)
	s val1=val d skip(","),scalx() i $$IsAStream(val) n fn,ft s ft="Scalar",fn="HASHBYTES (arg2)" d error(37)
	d putval("v^HASHBYTES^^"_val1_"^"_val_"^")
