	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
INSTR	; generate symbol-table INSTR entry (Oracle Compatibility)	// DPV3334=
	#;   INSTR ( string , substring [, position [, occurrence ] ] )
	#;  At this point, 'INSTR(' has been parsed
	n string,substring,position,putstr
	d scalx()
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="INSTR (arg1)" d error(37)
	s string=val
	d skip(","),scalx()
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="INSTR (arg2)" d error(37)
	s substring=val,position="",val=""
	set putstr="v^INSTR^^"_string_"^"_substring_"^"
	If $$check(",") {
		d scalx() If $$IsAStream(val) n fn,ft s ft="Scalar",fn="INSTR (arg3)" d error(37)		// position
		s position=val,val=""
		set putstr=putstr_position_"^"
		If $$check(",") {
			d scalx() If $$IsAStream(val) n fn,ft s ft="Scalar",fn="INSTR (arg4)" d error(37)	// occurrence
			set putstr=putstr_val_"^"
		}
	}
	d putval(putstr)
	d create^%qaqpdt(val,"op","%Library.Integer",,,,"INSTR")
	s:info $$$VTRomsinfo(val)=$$definfo^%qaqpif2("%Library.Integer")
	d skip(")")
