	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
MOD	;   Returns an integer that represents the month part of a specified date
	#;   Syntax    MOD ( expr1, expr2 )
	#;   Arguments:
	#;       expr1 - Is a numeric expression
	#;       expr2 - Is a numeric expression
