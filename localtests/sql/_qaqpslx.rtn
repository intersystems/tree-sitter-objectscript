	$$$lexskip("(")
	#;   LCASE ( <expression> )
	#;  	At this point 'LCASE(' has been parsed
LCASE	d scalx()		// DPV3336=
	i $$IsAStream(val) n fn,ft s ft="Scalar",fn="LOWER/LCASE" d error(37)  // DPV1738=
