	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ISNUMERIC	;   Determines whether an expression is a valid numeric type. (DPV2287)
	#;   Syntax    ISNUMERIC ( expression )
