	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
%OID	;  generate symbol-table %OID entry 	// DPV3059=
	#;   %OID(<value expression>)
