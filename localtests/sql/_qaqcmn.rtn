====
qaqcmn
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqcmn^MAC^^^0
%qaqcmn	// code generation for non-SELECT statements (Aviel 5/2/88)
	;; COMPONENTS :: SQL/CodeGeneration
	#;
#INCLUDE %msql
#IF 0   ;-------------------------------------------------------------
	; Description:   Code generator for non-SELECT statements
	; Author:        Aviel Klausner
	; Date:          May 02, 1988
	;
	;  JMM1134 (12/22/2021) - Consistently use shard map screening, or not, in all shard-local queries of a given sharded query
	;  JMM996  (08/12/2020) - Online sharded cluster rebalancing
	;  JMM1035 (04/14/2020) - Force insert/select to insert locally on shards with undocumented ISCShardLocalInsert query option
	;  JMM1016 (02/05/2020) - Fix problem with sharded cluster rebalancing for UDSK tables
	;  AK1006  (08/21/2019) - Remove mtc("f") target str# for INSERT-SELECT
	;  AK1001  (07/09/2019) - Mark ojfilter() cases as not free-sharded
	;  AK999   (06/20/2019) - Remove mt("ptrel") for INSERT-SELECT
	;  JMM905  (08/12/2018) - Offline sharded cluster rebalancing
	;  JMM860  (03/21/2017) - Always pass master class name to %InsertRow()
	;  JMM837  (12/27/2017) - Unified routine and globals databases for sharded cluster
	;  AK962   (05/02/2017) - Fix INSERT for single-field IDKEY shard key
	;  MRP955  (04/02/2017) - Fix SQL variable leaking for INSERT INTO <table> VALUES <values> with <values> containing concatenation (||) values
	;  AK959   (01/12/2017) - Implement sharded multi-row INSERT
	;  AK957   (09/01/2016) - Implement sharded UPDATE and DELETE
	;  BJB547  (05/14/2012) - support #sqlcompile Select = FDBMS for :array() with INSERT and UPDATE
	;  AK839   (12/07/2011) - INSERT OR UPDATE statement
	;  AK789   (09/15/2010) - More INSERT-SELECT mt() cleanup for RLS
	;  JLF240  (02/12/2009) - Make ROLLBACK recognize the start of a SQL transaction
	;  DPV3342 (01/15/2009) - Support REVOKE ... AS <grantor>
	;  DPV3324 (12/16/2008) - Report error for INSERT statements with a subquery
	;  DPV3316 (12/02/2008) - Support privileges on Cubes
	;  DPV3231 (08/05/2008) - Use process private global for ptln, ptrel
	;  DPV3164 (05/19/2008) - Remove INSERT code from cached queries
	;  DPV3161 (05/15/2008) - Error trapping in generated INSERT code, changes to error -104 and Fileman datatypes
	;  DPV3211 (03/11/2008) - tag name changes for class compiler performance improvements
	;  DPV3104 (02/13/2008) - Fix filing of stream through Objects with %CacheSQLStorage
	;  DPV3095 (01/22/2008) - Support for column-level privileges
	;  DPV3076 (11/30/2007) - Changes to ^||%sql.smd lifetime, fixes for views updated WHERE CURRENT OF
	;  DPV3060 (10/26/2007) - Fixes for %FilemanDate and %FilemanTimeStamp datatypes in SQL
	;  DPV3031 (09/26/2007) - Correct problem grant/revoke of role to user with "." in the username
	;  DPV2958 (06/14/2007) - New "d" variabe in insert if it might be used (WRC 661091 & 659214)
	;  DPV2935 (05/16/2007) - Add support for %USECHECKVARIABLE for use in Deleting child rows
	;                         SQL Fix ProdLog 50689: %check value in trigger with parent-child relationship
	;  DPV2908 (04/19/2007) - Support override of datatype methods for a property
	;  DPV2888 (03/20/2007) - Support SAVEPOINT through xDBC/Dynamic SQL
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  DPV2783 (11/01/2006) - New datag and tagpre in insrt.  SQL Fix ProdLog 53848: local variables remain after compiling if using NEW
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  DPV2672 (06/23/2006) - Add support for statement level triggers
	;  DPV2524 (09/22/2005) - Moved Cached Query metadata back to ^mcq
	;  DPV2442 (06/13/2005) - No more %edit, no need to NEW or Kill it.
	;  DPV2426 (05/06/2005) - Fix UPDATE/DELETE of multiple rows to be within a single transaction when AUTOCOMMIT_ON
	;  DPV2364 (02/07/2005) - Support Grant/Revoke to/from *
	;                         SQL Fix ProdLog 36544: GRANT to * won't find a SQL user
	;  DPV2346 (01/19/2005) - SQL Security: Fixes to granting/revoking delimited identifier roles
	;  DPV2327 (12/08/2004) - Fix rolestr when > 1 role
	;  DPV2323 (11/24/2004) - Move %qarPrivileges and %qadUsers into %SYS.SQLSEC
	;  DPV2321 (11/10/2004) - Use new %SYS.CONFIG API for SQL Configuration settings
	;  DPV2318 (10/28/2004) - Support INSERT filing code in-line in xDBC Cached Queries
	;  DPV2314 (10/26/2004) - Implement support for INSERT INTO <table> DEFAULT VALUES
	;  DPV2273 (08/26/2004) - Implement GRANT/REVOKE or EXECUTE privileges for Procedures
	;  DPV2271 (08/20/2004) - Eliminate THRESHOLD
	;  DPV2256 (08/04/2004) - Move SQL privileges to $$$SecurityGlobal,"SQL","priv",<database>,...)
	;  DPV2237 (06/18/2004) - Remove support for Namespace Security Access
	;  DPV2198 (03/17/2004) - Use $Username instead of %msql, use new privilege global
	;                         Use $zu(115,7) for ^%SYS("sql","sys","no filer referential checks") flag
	;  DPV2126 (12/05/2003) - Import CREATE ROLE error reporting.
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  DPV2053 (07/25/2003) - Fix privileges checking with privileges granted indirectly through roles
	;  PVA050  (02/12/2003) - ensure use of rowid based on one field, and the field itself are equally optimized. 
	;  DPV1963 (03/14/2003) - Eliminate binding of routine prefix to ^mdd
	;  MIT219  (12/09/2002) - Support INSERT SELECT for external tables
	;  BJB249  (12/06/2002) - pass parameter for RunTime Mode 
	;  DPV1833 (09/20/2002) - Support oref.prop as host variable
	;  DPV1829 (09/17/2002) - Fix GRANT/REVOKE of non-existing Role
	;  DPV1808 (08/27/2002) - Support %NOTRIGGER
	;  DPV1763 (07/10/2002) - Treat undefined input variables as NULL rather than give UNDEFINED error
	;  DPV1747 (06/12/2002) - Move revthrus code to %qarPrivileges to avoid <LABELREDEF> errors
	;  DPV1742 (06/10/2002) - Support DB Object Definition system privileges
	;  DPV1707 (05/03/2002) - Fix %CHECKPRIV - $$$mtR(typ) is a $List of "*"
	;  DPV1693 (03/28/2002) - Support updatable views
	;  DPV1638 (01/07/2002) - Use field's type parameters for input value ODBCToLogical conversion
	;  DPV1583 (09/13/2001) - Handle streams in INSERT ... SELECT
	;  DPV1575 (08/20/2001) - Eliminate %0slt variable, $zu(115,4) now used.
	;  DPV1514 (04/02/2001) - Filer Performance Improvements.
	;  DPV1324 (06/19/2000) - #import sets current schema(s)
	;  AK433   (03/13/2000) - SISINF: Clear %CacheLock on TSTART
	;  AK417   (12/17/1999) - INSERT OdbcIn(const) in ODBC mode
	;  DPV1176 (10/28/1999) - Fix users/roles as delimited identifiers
	;  DPV1134 (09/02/1999) - DropUser^%qadUsers now returns %msg
	;                         as parameter passed by reference.
	;  AK387   (08/03/1999) - EMIS: TOP, %ROWCOUNT
	;  DPV1100 (07/06/1999) - Support ODBC Namespace Access privilege
	;  DPV1094 (06/28/1999) - Fix problems with Roles
	;  DPV1081 (06/04/1999) - Implement %NOINDEX
	;  DPV1047 (04/20/1999) - Retain '_' in SQL functions
	;  DPV1025 (03/26/1999) - Retain '_' in username
	;  AK348   (01/13/1999) - CCS: Multirow INSERT - copy %insel
	;  AK346   (01/04/1999) - Fix INSERT expressions
	;  AK336   (11/03/1998) - Support method call as v^METH:c.m
	;  DPV889  (10/20/98)   - New privilege definitions
	;  DPV876  (06/01/98)   - Handle Granting/Revoking of system privileges
	;  DPV858  (08/17/98)   - Support functions in INSERT/UPDATE/etc
	;  DPV849  (07/09/98)   - new ALPHAUP function
	;  AK304   (01/06/98)   - List-fields in the query processor
	;  DPV802  (01/20/97)   - Eliminate ##vendor functions
	;  MIT067  (08/06/97)   - Fix UPDATE for Logical and ODBC mode
	;  DPV751  (06/23/97)   - Created routine - derived from %aaaman*
	;                         Changed II's to ",", I's to "^", V's to $c(1)
	;  MRP694  (06/18/97)   - Support Expressions in INSERT VALUE-List
	;  MIT066  (04/09/97)   - apply methods for INSERT
	;  AK289   (04/07/97)   - Restructure INSERT/UPDATE
	;  MRP570c (03/01/97)   - Replace '%mtpmode' with $zu(115) & Optimize TP
	;                         for Windows NT & Windows 95 M platforms...
	;  MRP673  (02/18/97)   - Implement %NOLOCK Enhancement...
	;  DPV710  (02/11/97)   - Allow generated line lengths of 511
	;  MIT063  (01/24/97)   - added #sqlcompile statement
	;  DPV700  (01/21/97)   - Change call to qapqo^%qaqqt2 to ^%qaqpqo
	;  MRP659  (12/06/96)   - Count all Rows Processed...
	;  MRP643  (10/02/96)   - Modularize Embedded SQL Code: 'gvar' to 
	;                         '$$$MSQLModuleVariable'...
	;  MRP631  (07/25/96)   - Initialize INTO variables for COUNT(...)...
	;  MRP615  (06/03/96)   - Count the number of Rows FETCHed with
	;                         GET <cursor> <host-var> = %ROWCOUNT...
	;  MRP592  (03/25/96)   - Fix problems with (INSERT...SELECT...) when
	;                         when parsing with (info) set...
	;  DPV603  (03/06/96)   - Make 'in' a local call
	;  MRP570  (01/29/96)   - Transaction Processing...
	;  MRP535  (10/20/95)   - Support SET <field> = <value expression>
	;  PRT030  (09/06/95)   - Allow With Admin Option for %THRESHOLD
	;  MRP511  (07/03/95)   - Add proper ALPHAUP(val,remove) to table code..
	;  DPV486  (06/16/95)   - Remove comments from generated code to decrease
	;                         routine size and increase performance
	;                         Cleaned up code.
	;  RLL600  (05/10/95)   - Support FETCH %ROWCOUNT=<rowcnt>
	;  RLL577  (02/14/95)   - Support vendorized TP commands
	;
#ENDIF  ;-------------------------------------------------------------
	$$$Abort  ;  Not an Entry Point!!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fetch	n array,ctr,ext,extb,i,ib,icol,mod,lines,line,tag,val,cached,var,cgc
		#;---------- no need to copy if SQLCODE'=0 ----------
	do initag
	if $d(mtc(mcurs,"cached"),cached) {
		$$$liin("if $isobject($g("_mtc(mcurs,"modvar")_"))'=1 { s SQLCODE=-102 } else { do "_mtc(mcurs,"modvar")_".FET()")
		#; Copy variables from cached query into 'declare cursor into' variables
		set line="",i=0
		for i=1:2:$ll(cached) {
			set var=$li(cached,i+1)
			if $e(var)="." do adset($e(var,2,*),mtc(mcurs,"modvar")_"."_$li(cached,i))
		}
		do:line'="" setin
	} else {
		$$$liin("try { do "_$$$MSQLModuleTag_"f if SQLCODE'=0 { quit }")  ;  AK198;AK200;MRP643
	}
	if $d($$$mtSelectInto) {	// There is an INTO clause in FETCH
		if $d(mt("into$list")) {
			set i=0,ext=0
			if $d(mtc(mcurs,"o","only select star")) {
				set sqlcolkey = $$$getVarName("sqlcolkey"), sqlcolval = $$$getVarName("sqlcolval")
				set line="s "_sqlcolkey_"="""" f {s "_sqlcolkey_"=$o("_mtc(mcurs,"o","only select star")_"("_sqlcolkey_"),1,"_sqlcolval_") q:"_sqlcolkey_"=""""  s $list("_$p($$$mtV(mt("into$list")),"^",2,*)_","_sqlcolkey_")="_sqlcolval_"}"
			} else{
				new listVarName
				set listVarName = $p($$$mtV(mt("into$list")),"^",2,*)
				set line="set "_listVarName_"=$lb("
				for {
					set val=$$nextc(mcurs) quit:val=""
					// If building the $lb() on one line would make this line too long, break it up
					// Subtract one - we need room to add the closing paren
					if ($l(line) + $l($p(val, ",", 3, *))) > ($$$MaxRtnLineLength - 1) {
						set $e(line, *) = ")"	// the last char would've been a trailing comma
						$$$liin(.line)
						set line="set "_listVarName_"="_listVarName_"_$lb("
					}
					set line=line_$p(val,",",3,*)_","
				}
				set $e(line,*)=")"
			}
			$$$liin(.line)
		} else {
			#;---------- copy from code-generated vars to the FETCH-INTO vars
			#;  for FETCH INTO x(), saved also col# for target var
			set array=$p($g($$$mtV(+$g($$$mtSelectInto))),"^",2,*)  ;  array name and leading subs
			set line="",i=0,ext=0,ib=0,extb=0
			#;  *** error if not the same length!
			if $d(mtc(mcurs,"o","only select star"))&&(array'="") {
				set line = "if SQLCODE=0 { m "_$e(array,1,*-1)_"="_mtc(mcurs,"o","only select star")_"}"
				$$$liin(.line)
			} else{
				for  {
					set val=$$nextc(mcurs) quit:val=""
					do adset($S(array'=""&($e(val)?1n):array_+val_")",1:$p($$$mtV($$nextb),"^",2,*)),$p(val,",",3,*))
				}
				do:line'="" setincond("SQLCODE=0")
			}
			
		}
	}
	if $d(cached) {
		$$$liin("}")
	} else {
		$$$liin("} catch { do "_mtc(mcurs,"errtag")_" }")
	}
genq	$$$liin("q")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
updel	n mod,lines,line,tag,tstate,cgc  ;  from aa+13,+17^qaqt - cursor DELETE or UPD
	#; DPV3076
	if '$d(mtc(mcurs,"f")) {  ; Will not be defined for universal cached queries
		set $p(mtc(mcurs,"f"),",",3)=$$$mtFromTableName($o($$$mtFromTableName("1^")))
	} else {
		d error(61):$p(mtc(mcurs,"f"),",",3)'=$$$mtFromTableName($o($$$mtFromTableName("1^"))) 
	}
	if $$$mtStatementType="DEL" {s $p(mtc(mcurs,"f"),",",2)=$$$smdLoadGetIrn($$$mtKViewName($$$mtK))} // Needs resetting of declare cursor frozen and saved from different routine
	elseif $$$mtStatementType="UPD" {s $p(mtc(mcurs,"f"),",",2)=$$$mtRIrn($$$mtR(1))} // mt("k") cleared by ddtab in this case for some strange reason
	d initag
	set tstate=$s($g(%msqlCurrentOf)="":$$$getVarName("CursorState"),1:%msqlCurrentOf_".CursorState")
	$$$liin("i '$g("_tstate_") { s SQLCODE=-102 q  } i "_tstate_"'=10 { s SQLCODE=-103 q  } s "_tstate_"=2")	// DPV2198= s:'$d(%0snrc) %0snrc=+$g(^%SYS(""sql"",""sys"",""no filer referential checks""))")
	i $$$mtStatementType="DEL" d delete g genq
	d nuvar("%data,%soid"),copy("%data("),update g genq	// DPV2442 (No more %edit)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
upcop	d nuvar("%data,%soid") QUIT  		// DPV2442 (No more %edit)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
action	;  from output^%qaqcct - to be done for each record found
	goto delete:$$$mtStatementType="DEL"
		#;  multirow INSERT code generated into %insel, copy to %insert
	if $$$mtStatementType="INS" { $$$liin("k %insert m %insert=%insel") goto insert }
		#;  for searched UPDATE SET field=nuval, see start+3^qo
	$$$liin("k %data"),copy("%data("),update		// DPV2442 (No more %edit)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
insrt	new %SQLCodeGenTabIndent,datag,extent,irn,from,lines,line,mod,savetag,sharded,shardkey,tag,tagpre,var,cgc  ;  INSERT VALUES, from aa+11^qaqt
	do initag
	set savetag=tag,tagpre=gtag,datag=0
	set irn=$p(mtc(mcurs,"f"),",",2)
	set var=$$$getVarName("AMSInfo")
	if $e(var,1,2)'="i%" { $$$liin("new "_var) }
	do InitAMSInfo^%qaqcasl  // Initialize 'Application Metadata Stack' (AMS) Information!
	GOTO:$g(mt("shtop",1)) shardins  ;  AK957
	set sharded=$$$smdSharded(1,irn)	// sharded=1 means this is on the shard master, sharded=2 means this is on the shard server
	#; // set tag=tag_"("_$$tagArgs^%qaqcasl(.sqlvarsThisStatement)_")" do liin("[SQLCODE] PUBLIC {")
	$$$liin("try { ")
	set %SQLCodeGenTabIndent=1
	if ($$$mtKNoJournalFlag($g($$$mtK))=1) || ($g(mt("options","DML_PARALLEL"))=1) { set line="set "_$$$getVarName("JournalFlag")_"=##class(%SYS.ProcessQuery).DisableJournalInt() $$$SuspendAllTrans("_$$$getVarName("TransFlag")_")" $$$liin(.line) }
	new sqlAuditVars
	do GetSqlAuditVars^%qaqcasl(.sqlAuditVars)
	do generateSQLStartCode^%qaqcasl()
.
		#; %sqlmode is defind in the MPP.  If this is a deferred sqlmode, we might have a global private temp table to resolve accessing the global temp table's data
		#; mt("gptname") is defined in stname^%qaqpsq
	if $d($$$mtGptTableRoot) {
		$$$liin("if $d(%processcontext),$isobject(%processcontext) {")
		new gptname set gptname=""
		for  {
			set gptname=$o($$$mtGptTable(gptname)) quit:gptname=""
			$$$liin($c(9)_"do %processcontext.ResolveTableName("_$$quoter(gptname)_")")
		}
		$$$liin("}")
	}
	if sharded'=1 $$$liin("if $zu(115,1)=1||('$TLEVEL&&($zu(115,1)=2)) { TSTART "_" s "_$$$getVarName("TSTART")_"=1 }")	// should we be doing this if shard=2?
	if ('sharded) { do BeforeStatementTriggers^%qaqcasl }
	set extent=$$$smdExtent(1,irn)
	do nuvar("%i"_$case(sharded,1:",%sc,%zu115",2:",%zu115",:""))
	do copy("%i(",1)
	if $g($$$mtKCheckOptionCodeCounter) {	// Code generate CHECK OPTION Validation code
		new %sqlParallelInfo // In case there is embedded SQL in this code, it is a recursive compile not under any current parallel unbrella
		set $$$mtKCheckOptionCode($i($$$mtKCheckOptionCodeCounter))=" q  "
		set from=$$subroutn^%qacsub("mt(""k"",""check option code"")",gtag_"CheckOption",,1)	// DPV3122
	}
	
		#; if this is a TSQL insert, we perform an extra pre-filer normalization for datetime fields in case they need to be converted from a Sybase string format
	if 0,$g(mt("options","source-tsql"))=1 {
		new fval,inscol,nuval
		for ibov=1:1 {
			set fval=$p($g($$$mtFList),",",ibov) quit:fval=""
			set nuval=$p($g($$$mtNewVals),",",ibov)
			if $case($$$VTRgetcat(fval),"TIMESTAMP":1,"POSIXTS":1,:0) {
				set inscol=$$ddcol(fval)
				$$$liin("set:$g(%i("_inscol_"))'="""" %i("_inscol_")=$$ConvertDATETIMEToTIMESTAMP^%qarfunc("_"%i("_inscol_")"_",,,,"_($$$VTRgetcat(fval)="POSIXTS")_")")
			}
		}
	}
	if sharded'=1 {
		if $g(mt("options","xDBCColumnarBufferedInsert"))=0 {
			$$$liin("set %bufferedColumns=1")	// Used in the generated xDBC cached query code
			$$$liin("set %ROWID=##class("_$$$smdClassname(1,irn)_").%SQLInsert(.%i,"_$$check_",,"_$s($g(from)'="":""""_from_"^""_$zn",1:"")_","_$s($g(mt("options","DML_PARALLEL")):0,$g(mt("options","parallelQuery")):0,1:"'$g("_$$$getVarName("TSTART")_")")_",,.%bufferedColumns),%ROWCOUNT='SQLCODE")
		} else {
			$$$liin("set %ROWID=##class("_$$$smdClassname(1,irn)_").%SQLInsert(.%i,"_$$check_",,"_$s($g(from)'="":""""_from_"^""_$zn",1:"")_","_$s($g(mt("options","DML_PARALLEL")):0,$g(mt("options","parallelQuery")):0,1:"'$g("_$$$getVarName("TSTART")_")")_"),%ROWCOUNT='SQLCODE")
		}
	} else { 
		#;  ClassMethod %InsertRow(
		#;  	pClassName As %String,
		#;  	pShardKey As %List = "",
		#;  	ByRef pData,
		#;  	pCheck As %String,
		#;  	pInsSel As %Integer = 0,
		#;  	pTstart As %Integer = 0,
		#;  	ByRef pSQLCODE As %Integer,
		#;  	ByRef pRowId As %String,
		#;  	pBatch As %Integer = 0
		#;      pAllowTx As %Integer = 0) As %Status
		
		$$$liin("set %zu115=$zu(115,1,0)")
			// We need to get the Shardkey, if there is one, and pass the values in to the %InsertRow method
		if $$$smdShardKey(1,irn)'="" {
			new sk
			set sk=$$$smdShardKey(1,irn)
			if sk'["," {
					// If the ShardKey is the RowID field, it may not have been explicitly defined this way.  We may have mapped the RowID field to the ShardKey
					// in FinalizeTableDefinition.  If the RowID/Shardkey is not defined, we need to pass "" to %InsertRows, not $lb("")
				if $$$smdColNumber(1,irn,sk)=1||($$$smdColIsIdentityColumn(1,irn,sk)) { set shardkey="$s('$d(%i("_$$$smdGetIcolFromIfn(sk)_")):"""",1:$lb(%i("_$$$smdGetIcolFromIfn(sk)_")))" }
				else { set shardkey="$lb(%i("_$$$smdGetIcolFromIfn(sk)_"))" }
			}
			else {	// multi-field shardkey
				new i
				set shardkey="$lb("
				for i=1:1:$l(sk,",") {
					set shardkey=shardkey_"%i("_$$$smdGetIcolFromIfn($p(sk,",",i))_"),"
				}
				set $e(shardkey,*)=")"
			}
		}
		else { set shardkey="" }
		$$$liin("set %sc=##class(%BigData.ShardedSQL).%InsertRow("_$$quoter($$getMasterClassName^%SYS.SHARDSRV($$$smdClassname(1,irn)))_","_shardkey_",.%i,"_$$check_",0,0,.SQLCODE,.%ROWID,0)") // JMM837 JMM860
		$$$liin("do $zu(115,1,%zu115)")
	}
	set tagpre=gtag,datag=0
	if ('sharded) { do AfterStatementTriggers^%qaqcasl }
	if sharded'=1 $$$liin("if $zu(115,1)=1,$g("_$$$getVarName("TSTART")_") { TCOMMIT:SQLCODE'<0  TROLLBACK:SQLCODE<0 1 }")	// should we be doing this if shard=2?
	kill %SQLCodeGenTabIndent
	$$$liin("}")
	if sharded'=1 { $$$liin("catch { do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) if $zu(115,1)=1,$g("_$$$getVarName("TSTART")_") { TROLLBACK 1 } }") }
	else          { $$$liin("catch { do:$d(%zu115) $zu(115,1,%zu115) do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) }") }
	if ($$$mtKNoJournalFlag($$$mtK)=1) || ($g(mt("options","DML_PARALLEL"))=1) { 
		set line="try { if $g("_$$$getVarName("JournalFlag")_") { do ##class(%SYS.ProcessQuery).EnableJournalInt() kill "_$$$getVarName("JournalFlag")_" } } catch { do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) } " $$$liin(.line) 
		set line="try { if $d("_$$$getVarName("TransFlag")_") { $$$ResumeAllTrans("_$$$getVarName("TransFlag")_") kill "_$$$getVarName("TransFlag")_" } } catch { do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) } " $$$liin(.line) 
	}
	do generateSQLEndCode^%qaqcasl(1,,,.sqlAuditVars)
	$$$liin("quit  // From "_savetag)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
insel	new begline,begtoken,c,endline,endtoken,f,indexline,line,lineprev,mask,more,p,pprev,prevtoken,sql,token,value
	#;---------- ep from asign+6^%qaqpsq1, for case of INSERT ... SELECT
	#;  VERY PROBLEMATIC!!!  While in mid-parsing, we call here ^qo to
	#;                       set stuff for the inserted table and its
	#;  fields.  Then we clean-up the parsing environment - kill $$$ptln,
	#;  mt("f"), $$$mtRNumStreams, mt("v"), reset maxm to 0, and then resume
	#;  parsing from the same spot, all while maintaining the value of
	#;  the above variables.
	#;  NOTE:  Once subqueries work, this would be unnecessary, since
	#;         the SELECT query may be processed as query# 2.
	QUIT:$g(info)  ; Don't do this for 'info' parsing... 
	#; MIT219
	QUIT:extab 
	#;  a sharded target table should not confuse the SELECT sharding logic
	if $g(mt("shtop",1)) { set $$$mtTargetShard=1 kill mt("shtop") }  ;  AK959
	do ^%qaqpqo
	set ib=0,extb=0
	#; AK348
	for  { set val=$$nextb quit:val=""  set $$$mtV(val)="i^%insel("_$$ddcol(val)_")" }
	set $$$mtSelectInto="^"_$g($$$mtSelectInto)
	for val=1:1:$$$maxv { ;  maybe for arrow->syntax???
		set:'$lf($g($$$mtCTEParams),val) $$$mtVType($$$mtV(val))="i" // vals in mt("cteparm"), parameters in CTE definition, should not be scratched at this point
	} 
	#; PVA050: kill mt("flbls",..),mt("from"), and %viewinfo as well 
	KILL $$$ptlnRoot,%viewinfo,mts(1)
	set $$$mtPActiveQbs=""
	MERGE $$$mtSaveF=$$$mtFromRoot,$$$mtSaveFlbls=$$$mtFLabelsRoot	// used for building mtc(0,0,...) privilege metadata for SQL Statement Index in %qaqqt
	for val="anyof","collidx","colnul","corr","dsn","dups","f","from","flbls","hj","l","nfo","ptrel","qbo","r","smdimp","unary","w" { KILL mt(val) }  ;  AK789;AK999
	#;  *** might be better to instead KILL everything EXCEPT some list - "t","k","sqlcomp","sqtar","b","v","target"
	s $p(mtc(mcurs,"f"),",")=""  ;  remove target stream#  ;  AK1006
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
initag	;  initialize code generation and tags
	s mod=1,lines=0,line="",tag="",mtag=gtag_"o",tag=mtag
	d cgcInit^%qaqcasl  ;  AK1090
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nuvar(param)	;    NEW variables for UPDATE/INSERT
	$$$liin("n "_param_$S($E($g($$$mtV(+$g($$$mtSelectInto))))="i":",icol,ir",1:""))
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
copy(into,insert=0)	;      copy new values into into(icol)
	n ibov s ibov=0
	#;---------- SET { <colmn> = <nuval> , } ----------
	QUIT:$$$mtKInsertDefaultFlag($g($$$mtK))=1  	// DPV2314= INSERT INTO <table> DEFAULT VALUES
	g:$E($g($$$mtV(+$g($$$mtSelectInto))))'="i" colset
	#;---------- %VALUEARRAY ----------
		#; We are inputing values from an array
		#; See if any of the input values need to be converted to Logical mode
	if $case(mt("sqlcomp"),"%Runtime":1,"%ODBC":1,"%EXTERNAL":1,"%FDBMS":1,:0) {
		new collection,from,from2,icol,ifn,irn,sqllistdel,tFieldClassname	//  copy from from(icol) to into(icol)
		set from=$p($$$mtV(+$g($$$mtSelectInto)),"^",2,*)
		set icol=""
		for  {
			set icol=$o($$$smd(1,$p(mtc(mcurs,"f"),",",2),"col",icol),1,ifn) quit:icol=""
				#; Use the input column's associated field paramater settings when determining any conversion logic
			set irn=$$$smdGetIrnFromIfn(ifn)
			do GetParms^%qadfld2(irn,ifn,.param)
			set collection=$s($$$smdColListCollection(1,irn,ifn)="Y":"l",$$$smdColArrayCollection(1,irn,ifn):"a",1:"")
			set sqllistdel=$s(collection="l"&&($$$smdColListDelimiter(1,irn,ifn)'=""):$$$smdColListDelimiter(1,irn,ifn),1:"")
			if $$$smdColContainerField(1,irn,ifn)'="" {
					#; if this is a serial field, we need to use the serial classname, not this classname so we call the correct conversion code
				set tFieldClassname=$$$smdColContainerType(1,irn,ifn)			// tFieldClassname is now the serial field's type
			}
			else { set tFieldClassname=$$$smdClassname(1,irn) }
			set from2=$$genmeth^%qaqcpr($$$smdColDatatype(1,irn,ifn),$s(mt("sqlcomp")="%ODBC":"OdbcToLogical",mt("sqlcomp")="%EXTERNAL":"DisplayToLogical",mt("sqlcomp")="%FDBMS":"FDBMSToLogical",1:"RuntimeToLogical"),.param,from_icol_")",tFieldClassname,$$$smdColPropertyName(1,irn,ifn),collection,sqllistdel,,,$e($$$mtV(+$g($$$mtSelectInto))))
			kill param
			$$$liin("set:$d("_from_icol_"))#2 "_into_icol_")="_from2)
		}
	}
	else {
		new from	//  copy from from(icol) to into(icol)
		s from=$p($$$mtV(+$g($$$mtSelectInto)),"^",2,*)_"icol",into=into_"icol"
		$$$liin("f icol=0:1:"_$o($$$smd(1,$p(mtc(mcurs,"f"),",",2),"col",""),-1)_" i $d("_from_")) s "_into_")="_from_")")
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
colset	;  for an explicit set of icols, copy the new values to into(icol).
	new collection,datag,from,ibov,ifn,intocol,irn,opflag,param,setfrom,sqllistdel,tagpre,tFieldClassname,v,val
	s line="",i=0,ext=0,ib=0,extb=0,opflag=0,tagpre=gtag,datag=0
	//All this evaluation happens in the same code generation context, so expressions
	//need not be evaluated twice
	#;  n cgc do cgcInit^%qaqcasl  ;  TRW1449  ;  removed by AK1090
		#;  set up pti() so $$ptvalue() can be used for expressions
	for val=1:1 {
		set v=$g($$$mtV(val)) quit:v=""  continue:$d(pti(val))
		if $e(v)="t" { set pti(val)=$$quoter($p(v,"^",2,*)) continue  }
		if $e(v)="x" { set pti(val)=$e(v,3,*) continue  }
		if $e(v)="f" { do addpti^%qaqutility("colset"_val,val,0) }	// No need to NEW variables for field entries in the parse tree for INSERT
		else { do addpti^%qaqutility("colset"_val,val,insert) }
	}
	For ibov=1:1 {
		s icol=$p($g($$$mtFList),",",ibov) q:icol=""  
		s val=$p($g($$$mtNewVals),",",ibov)
		s intocol=into_$$ddcol(icol)_")"
		  #;  this should work in all cases
		  #;  NOTE:  for now, :var in IntExt mode needs the var name itself!
		s from=$$ptvalue^%qaqcpr(val),v=$$$mtV(val),setfrom=from
		if $e(v)="x",($p(v,"^",2,*)'[".") {  // if a variable, and not a oref.prop reference
			if $$$mtStatementType="INS",$$$SQLCompileOption("xDBC")=1,from?1"%qpar("1.n.1")" {}	// Not need for $get if this is xDBC INSERT, %qpar(#) will all be defined
			else { set from="$g("_from_")" }
		}
			#; For UPDATE, if the source of the input value is a subquery or a field that is a stream, set the flag that will allow a stream Oid for this stream field
		if $$$mtStatementType="UPD" {
			if $e(v)="f" {
				new targetirn,targetifn,sourceirn,sourceifn
				set targetirn=$$$VTRgetirn(icol),targetifn=$$$VTRgetifn(icol)
				set sourceirn=$$$VTRgetirn(val),sourceifn=$$$VTRgetifn(val)
				if $$$smdColStream(1,targetirn,targetifn),$$$smdColStream(1,sourceirn,sourceifn) do adset("%soid("_$$ddcol(icol)_")",1)
			}
			elseif $e(v)="q" {
				new targetirn,targetifn,sourceodbctype
				set targetirn=$$$VTRgetirn(icol),targetifn=$$$VTRgetifn(icol)
				do getdt^%qadadt($$$VTRgetdt(val),,,,.sourceodbctype)
				if $$$smdColStream(1,targetirn,targetifn)&&(sourceodbctype="LONGVARCHAR"||(sourceodbctype="LONGVARBINARY")) do adset("%soid("_$$ddcol(icol)_")",1)
			}
		}
			
		  #;  for MLF=constant, treat it as the first line
		  #;  *** defer this feature for now - might be useful
		  #;  *** probably should be before previous line!?
		  #;  . . i $$$IsLF(icol),$$$LFdel="" s from="$lb("_from_")"  ;  AK304
		  #;  temporarily, special case for IntExt vars - let filer handle
		  #;  as before;  should fix to copy into pti() correctly
		If ( $e(v)="x" || ( $e(v)="t" ) ) && ( $$$mtStatementType="INS" ) {
				#;  DPV2908 - Pass classname/propertyname below to $$genmeth
			if $case(mt("sqlcomp"),"%Runtime":1,"%ODBC":1,"%EXTERNAL":1,"%FDBMS":1,:0) {
				  #; Use the input column's associated field paramater settings when determining any conversion logic
				set irn=$$$VTRgetirn(icol),ifn=$$$VTRgetifn(icol)
				do GetParms^%qadfld2(irn,ifn,.param)
				set collection=$s($$$smdColListCollection(1,irn,ifn)="Y":"l",$$$smdColArrayCollection(1,irn,ifn):"a",1:"")
				set sqllistdel=$s(collection="l"&&($$$smdColListDelimiter(1,irn,ifn)'=""):$$$smdColListDelimiter(1,irn,ifn),1:"")
				if $$$smdColContainerField(1,irn,ifn)'="" {
						#; if this is a serial field, we need to use the serial classname, not this classname so we call the correct conversion code
					set tFieldClassname=$$$smdColContainerType(1,irn,ifn)			// tFieldClassname is now the serial field's type
				}
				else { set tFieldClassname=$$$smdClassname(1,irn) }
				if $case($$$VTRgetcat(val),"TIMESTAMP":1,"POSIXTS":1,:0) { 	// New values for TIMESTAMP or POSIXTIME for TSQL statement, normalize from TSQL value first
					if $g(mt("options","source-tsql"))=1 {
						if $e(v)="t" {
							if from'="""""" { set from="$$ConvertDATETIMEToTIMESTAMP^%qarfunc("_from_",,,,"_($$$VTRgetcat(val)="POSIXTS")_")" }
						} else {
							set from="$s("_from_"="""":"""",1:$$ConvertDATETIMEToTIMESTAMP^%qarfunc("_from_",,,,"_($$$VTRgetcat(val)="POSIXTS")_"))"
						}
					}
				}
				set from=$$genmeth^%qaqcpr($$getdtvar^%qaqpdt(val),$s(mt("sqlcomp")="%ODBC":"OdbcToLogical",mt("sqlcomp")="%EXTERNAL":"DisplayToLogical",mt("sqlcomp")="%FDBMS":$S($e(v)="x":"FDBMSToLogical",1:"DisplayToLogical"),1:"RuntimeToLogical"),.param,from,tFieldClassname,$$$smdColPropertyName(1,irn,ifn),collection,sqllistdel,,,$e(v))
				kill param
			} elseif $g(mt("options","source-tsql"))=1,$case($$$VTRgetcat(val),"TIMESTAMP":1,"POSIXTS":1,:0) {
				if $e(v)="t" {
					if from'="""""" { set from="$$ConvertDATETIMEToTIMESTAMP^%qarfunc("_from_",,,,"_($$$VTRgetcat(val)="POSIXTS")_")" }
				} else {
					set from="$s("_from_"="""":"""",1:$$ConvertDATETIMEToTIMESTAMP^%qarfunc("_setfrom_",,,,"_($$$VTRgetcat(val)="POSIXTS")_"))"
				}
			}
		}
		elseif $e(v,1,9)="v^CURDATE" {	// In INS CURRENT_DATE into DATE category field, possibly convert %Date to user-defined DATE (DPV3060)
			new dt s dt=$$$VTRgetdt(val)
			if $$$VTRgetcat(val)="DATE" {
				  #; Use the input column's associated field paramater settings when determining any conversion logic (DPV3591)
				new ifn,irn set irn=$$$VTRgetirn(icol),ifn=$$$VTRgetifn(icol)
				do GetParms^%qadfld2(irn,ifn,.param)
				set from=$$genmeth^%qaqcpr(dt,"DateToLogical",.param,from,$$$smdClassname(1,irn),$$$smdColPropertyName(1,irn,ifn))
				kill param
			}
		}
		elseif ($$$VTRgetcat(icol)="FMDATE"||($$$VTRgetcat(icol)="DATE"))&&($$$VTRgetcat(val)="DATE") {	// In INS/UPD a DATE value into a DATE or FMDATE Category field, Convert Date to FilemanDate or other logical "date" format
			  #; Use the input column's associated field paramater settings when determining any conversion logic (DPV3591)
			set irn=$$$VTRgetirn(icol),ifn=$$$VTRgetifn(icol)
			do GetParms^%qadfld2(irn,ifn,.param)
			set from=$$genmeth^%qaqcpr($$$VTRgetdt(icol),"DateToLogical",.param,from,$$$smdClassname(1,irn),$$$smdColPropertyName(1,irn,ifn))
			kill param
		}
		elseif ($$$VTRgetcat(icol)="FMDATE"||($$$VTRgetcat(icol)="TIMESTAMP"))&&($$$VTRgetcat(val)="TIMESTAMP") {	// In INS/UPD a TIMESTAMP value into a FMDATE or TIMESTAMP Category field, Convert TIMESTAMP to FilemanDate or "timestamp" logical format
			  #; Use the input column's associated field paramater settings when determining any conversion logic (DPV3591)
			set irn=$$$VTRgetirn(icol),ifn=$$$VTRgetifn(icol)
			do GetParms^%qadfld2(irn,ifn,.param)
			set from=$$genmeth^%qaqcpr($$$VTRgetdt(icol),"TimeStampToLogical",.param,from,$$$smdClassname(1,irn),$$$smdColPropertyName(1,irn,ifn))
			kill param
		}
		elseif ($$$VTRgetcat(icol)="FMTIMESTAMP")&&($$$VTRgetcat(val)="TIMESTAMP") {	// In INS/UPD a TIMESTAMP value into a FMTIMESTAMP Category field, Convert TIMESTAMP to FilemanTimeStamp logical format
			  #; Use the input column's associated field paramater settings when determining any conversion logic (DPV3591)
			set irn=$$$VTRgetirn(icol),ifn=$$$VTRgetifn(icol)
			do GetParms^%qadfld2(irn,ifn,.param)
			set from=$$genmeth^%qaqcpr($$$VTRgetdt(icol),"OdbcToLogical",.param,from,$$$smdClassname(1,irn),$$$smdColPropertyName(1,irn,ifn))
			kill param
		}
		if $$$mtStatementType="INS",$e(v)="q" d error(144)	// DPV3324=
		d adset(intocol,from)
	}
	g:line'="" setin QUIT
 
adsub(val) [] PUBLIC {
		#;  $$:  enable adding a subscript to variable val
	QUIT:$E(val,*)=")" $E(val,1,*-1)_","
	QUIT val_"("  ;  variable without subscripts
}
 
adset(into,from)	        ;  add a SET argument to the line
	s line=line_","_into_"="_from QUIT:$l(line)'>$$$complength
setin	s line="s "_$E(line,2,*) $$$liin(.line) QUIT ;  add line with many SETs
setincond(cond) s line="i "_cond_" { s "_$E(line,2,*)_" }" $$$liin(.line) QUIT ;  add line with many SETs and a condition to apply
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 
update	;
	n from
	If $g($$$mtKCheckOptionCodeCounter) {	// Code generate CHECK OPTION Validation code
		new %sqlParallelInfo // In case there is embedded SQL in this code, it is a recursive compile not under any current parallel unbrella
		s $$$mtKCheckOptionCode($i($$$mtKCheckOptionCodeCounter))=" q  "
		s from=$$subroutn^%qacsub("mt(""k"",""check option code"")",gtag_"CheckOption",,1)	// DPV3122
	}
	if $$$smdHasColumnarMaps(1,$p(mtc(mcurs,"f"),",",2)),$g(mt("maxonerow"))'=1,'$$tableHasAfterRowTrigger($$$smdClassname(1,$p(mtc(mcurs,"f"),",",2)),"UPDATE") {
		set mt("columnarBufferedFiling")=$p(mtc(mcurs,"f"),",",2)
		$$$liin("set "_$$$getVarName("bufferedColumns")_"=1")
		$$$liin("do ##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLUpdate("_mtc(mcurs,"rid")_","_$$check_",.%data"_$s($g(from)'="":","""_from_"^""_$zn",1:",")_","_$s($g(mt("options","DML_PARALLEL")):0,$g(mt("options","parallelQuery")):0,1:"'$g("_$$$getVarName("TSTART")_")")_",,,.%soid,."_$$$getVarName("bufferedColumns")_",."_$$$getVarName("bufferedColumnsDel")_")")
	} else {
		$$$liin("do ##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLUpdate("_mtc(mcurs,"rid")_","_$$check_",.%data"_$s($g(from)'="":","""_from_"^""_$zn",1:",")_","_$s($g(mt("options","DML_PARALLEL")):0,$g(mt("options","parallelQuery")):0,1:"'$g("_$$$getVarName("TSTART")_")")_",,,.%soid)")
	}
	QUIT
 
insert	; multi-row insert
	new from
	if $g($$$mtKCheckOptionCodeCounter) {	// Code generate CHECK OPTION Validation code
		new %sqlParallelInfo // In case there is embedded SQL in this code, it is a recursive compile not under any current parallel unbrella
		set $$$mtKCheckOptionCode($i($$$mtKCheckOptionCodeCounter))=" q  "
		set from=$$subroutn^%qacsub("mt(""k"",""check option code"")",gtag_"CheckOption",,1)	// DPV3122
	}
		#; AK959
		#;  case A - call %InsertRow() from the shard master for each row
	new irn set irn=$p(mtc(mcurs,"f"),",",2)
		#;  also case D on shard server - sharded target with user shard key
		#; JMM905 Don't treat shard-local table as special case here during rebalancing
	if $$$smdSharded(1,irn)=2,$$$smdShardKey(1,irn),'+$g(mt("options","ISCSNRebalancing")),'+$g(mt("options","ISCShardLocalInsert")) { set $$$mtTargetShard=2 } // JMM1035
		#;  *** in the future this call should be "batched"
	if $g($$$mtTargetShard) {  // JMM837 JMM860
		$$$liin("set:'##class(%BigData.ShardedSQL).%InsertRow("_$$quoter($$getMasterClassName^%SYS.SHARDSRV($$$smdClassname(1,irn)))_","_$$shkvals("%insert")_",.%insert,"_$$check_",1,'$g("_$$$getVarName("TSTART")_"),.SQLCODE,.%ROWID,,,1) SQLCODE=-253,%msg=""Sharded INSERT error: ""_%msg")
		RETURN
	}
		#; AK959-
		#; if this is a TSQL insert, we perform an extra pre-filer normalization for datetime fields in case they need to be converted from a Sybase string format
	if $g(mt("options","source-tsql"))=1 {
		new fval,inscol,nuval
		for ibov=1:1 {
			set fval=$p($g($$$mtFList),",",ibov) quit:fval=""
			set nuval=$p($g($$$mtNewVals),",",ibov)
			if $case($$$VTRgetcat(fval),"TIMESTAMP":1,"POSIXTS":1,:0) {
				set inscol=pti(nuval),inscol=+$p(inscol,"(",2) // extract the proper array value from %insel.
				$$$liin("set:$g(%insert("_inscol_"))'="""" %insert("_inscol_")=$$ConvertDATETIMEToTIMESTAMP^%qarfunc("_"%insert("_inscol_")"_",,,,"_($$$VTRgetcat(fval)="POSIXTS")_")")
			}
		}
	}
	if $$$smdHasColumnarMaps(1,$p(mtc(mcurs,"f"),",",2)),'$$tableHasAfterRowTrigger($$$smdClassname(1,$p(mtc(mcurs,"f"),",",2)),"INSERT") {
		set mt("columnarBufferedFiling")=irn
		$$$liin("set "_$$$getVarName("bufferedColumns")_"=1")
		$$$liin("set %ROWID=##class("_$$$smdClassname(1,irn)_").%SQLInsert(.%insert,"_$$check_",1"_$s($g(from)'="":","""_from_"^""_$zn",1:",")_","_$s($g(mt("options","DML_PARALLEL")):0,$g(mt("options","parallelQuery")):0,1:"'$g("_$$$getVarName("TSTART")_")")_",,."_$$$getVarName("bufferedColumns")_")")
	} else {
		$$$liin("set %ROWID=##class("_$$$smdClassname(1,irn)_").%SQLInsert(.%insert,"_$$check_",1"_$s($g(from)'="":","""_from_"^""_$zn",1:",")_","_$s($g(mt("options","DML_PARALLEL")):0,$g(mt("options","parallelQuery")):0,1:"'$g("_$$$getVarName("TSTART")_")")_")")
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
delete	;
	if $$$smdHasColumnarMaps(1,$p(mtc(mcurs,"f"),",",2)),$g(mt("maxonerow"))'=1,'$$tableHasAfterRowTrigger($$$smdClassname(1,$p(mtc(mcurs,"f"),",",2)),"DELETE") {
		set mt("columnarBufferedFiling")=$p(mtc(mcurs,"f"),",",2)
		$$$liin("set "_$$$getVarName("bufferedColumns")_"=1")
		$$$liin("do ##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLDelete("_mtc(mcurs,"rid")_","_$$check_","_$s($g(mt("options","DML_PARALLEL")):0,$g(mt("options","parallelQuery")):0,1:"'$g("_$$$getVarName("TSTART")_")")_",,,."_$$$getVarName("bufferedColumns")_")")
	} else {
		$$$liin("do ##class("_$$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))_").%SQLDelete("_mtc(mcurs,"rid")_","_$$check_","_$s($g(mt("options","DML_PARALLEL")):0,$g(mt("options","parallelQuery")):0,1:"'$g("_$$$getVarName("TSTART")_")")_")")
	}
	RETURN
.
	// If the given class/table has any row or row/object AFTER triggers for the given event, return 1, otherwise return 0
	// I'm assuming the trigger is runnable.
	// Should be rare that a table with CDMs is using AFTER row triggers anyway, and this is only for filing optimization
	// Also, the %OBJ* triggers defined in %Library.Persistent do not count
tableHasAfterRowTrigger(class,event) PUBLIC {
		set trigger=""
		for  {
			set trigger=$$$comMemberNext(class,$$$cCLASStrigger,trigger) quit:trigger=""
			$$$comMemberKeyGetLvar(origin,class,$$$cCLASStrigger,trigger,$$$cTRIGGERorigin)
			continue:origin="%Library.Persistent"	// skip the %OBJ* triggers
			$$$comMemberKeyGetLvar(time,class,$$$cCLASStrigger,trigger,$$$cTRIGGERtime)
			continue:time'="AFTER"
			$$$comMemberKeyGetLvar(foreach,class,$$$cCLASStrigger,trigger,$$$cTRIGGERforeach)
			continue:foreach'["row"
			$$$comMemberKeyGetLvar(event,class,$$$cCLASStrigger,trigger,$$$cTRIGGERevent)
			if event[$$$UPPER(event) { RETURN 1 }
		}
		RETURN 0
}
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK957
shardup	;  called from ^qaqt
	#;  TRY {  ;  generate code for sharded UPDATE/DELETE
	#;  n v1,v2 s v1=%parm(1),v2=%parm(2)  ;  also conversions etc.
	#;  s:'##class(%BigData.ShardedSQL).%ShardIUD("sch.sht",
	#;    "DELETE FROM sch.sht T1 WHERE x=? AND y=?",$LB(v1,v2),
	#;    $LB($LB($LB("T1"),2)),,.SQLCODE,.%ROWID,
	#;    .%ROWCOUNT) SQLCODE=-253,%msg="Sharded DELETE error: "_%msg
	#;  } CATCH { d SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) }
	#;  QUIT
	new datag,jj,line,lines,mod,prm,sql,tag,tagpre,useCAST,useCOAL,cgc
	do initag
	set tagpre=gtag,datag=0
	MERGE mts=$$$fsave("mts")  ;  restore removed nodes
	set $$$mtShard(1)="plain"
	$$$liin("try {")
	set prm="",useCAST=1,useCOAL=1  ;  calls accumulate prm=$LB(parm)
	set sql=$s($$$mtStatementType="UPD":"UPDATE ",1:$s($$$mtKTruncateFlag($g($$$mtK))=1:"TRUNCATE TABLE ",1:"DELETE "))
	set:$$$mtKNoCheckFlag($g($$$mtK))=1 sql=sql_"%NOCHECK "
	set:$$$mtKNoLockFlag($g($$$mtK))=1 sql=sql_"%NOLOCK "
	set:$$$mtKNoIndexFlag($g($$$mtK))=1 sql=sql_"%NOINDEX "
	set:$$$mtKNoTriggerFlag($g($$$mtK))=1&&('$$$mtKTruncateFlag($g($$$mtK))) sql=sql_"%NOTRIGGER "
	set sql=sql_$$fromit^%qaqcmh(1,+mtc(mcurs,"f"))
	if $$$mtStatementType="UPD" {
		set sql=sql_" SET "
		for jj=1:1:$l($$$mtFList,",")-1 {
			set sql=sql_$e(",",jj>1)_$$vertVal^%qaqcmh(.mt,$p($$$mtFList,",",jj),0)_"="_$$removeExact^%qaqcmh($$vertVal^%qaqcmh(.mt,$p($$$mtNewVals,",",jj)))  ;  AK1087
		}
	}
	set sql=sql_$$updelfrom(+mtc(mcurs,"f"))_$$parseWhere^%qaqcmh(1)
	if $$$mtKTruncateFlag($g($$$mtK))=1 { $$$liin($c(9)_"set "_$$$getVarName("trxmode")_"=$zu(115,1,0)") }	// truncate table always uses auto_transaction="none"
	set options="" // JMM1134+
	s shardScreenOption=$$$SQLCompileOption("ISCShardScreen")
	if shardScreenOption'="" { set options=options_" /*#OPTIONS {""ISCShardScreen"":"_shardScreenOption_"} */" }
	s sql=sql_options // JMM1134-
	$$$liin($c(9)_"set:'##class(%BigData.ShardedSQL).%ShardIUD("_$$quoter(mt("shardext",1))_","_$$quoter(sql)_","_$$setprm(prm)_","_$$pjt(1,$$$ptrel($$$mtTarget))_",,.SQLCODE,.%ROWID,.%ROWCOUNT) SQLCODE=-253,%msg=""Sharded "_$e(sql,1,6)_" error: ""_%msg")
	if $$$mtKTruncateFlag($g($$$mtK))=1 {	// truncate
		$$$liin($c(9)_"do $zu(115,1,"_$$$getVarName("trxmode")_") set:%ROWCOUNT<(-1) %ROWCOUNT=-1")
		$$$liin("} catch { do $zu(115,1,"_$$$getVarName("trxmode")_") do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) }")
	} else {
		$$$liin("} catch { do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) }")
	}
	$$$liin("q")
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK959
shinsel	  ;  called from ^qaqt
	#;  TRY {  ;  sharded INSERT-SELECT case B, send whole INSERT to shards
	#;  n v1,v2 s v1=%parm(1),v2=%parm(2)  ;  also conversions etc.
	#;  s:'##class(%BigData.ShardedSQL).%ShardIUD("sch.sht",
	#;    "INSERT INTO sch.sht(x,y) SELECT name,age FROM tt2 
	#;    WHERE %ID>? AND age<?",$LB(v1,v2),,,.SQLCODE,.%ROWID,
	#;    .%ROWCOUNT) SQLCODE=-253,%msg="Sharded INSERT error: "_%msg
	#;  } CATCH { d SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) }
	#;  QUIT
	new datag,irn,jj,line,lines,prm,mod,sql,tag,tagpre,useCAST,useCOAL,cgc
	do initag
	set tagpre=gtag,datag=0
	MERGE mts=$$$fsave("mts")  ;  restore removed nodes
	s $$$mtShard(1)="plain"
	$$$liin("try {")
	s prm="",useCAST=1,useCOAL=1  ;  calls accumulate prm=$LB(parm)
	s jj=mtc(mcurs,"f"),irn=$p(jj,",",2)  ;  jj = 1 , irn , sch.tname
	s jj=$p(jj,",",3)
	s:$$$smdSharded(1,irn) jj=$$getShardLocalTableName^%SYS.SHARDSRV(jj,1,1,.mt,1) // JMM837+ JMM996= JMM1134= JMM1223=
	set sql="INSERT "
	set:$$$mtKNoCheckFlag($g($$$mtK))=1 sql=sql_"%NOCHECK "
	set:$$$mtKNoLockFlag($g($$$mtK))=1 sql=sql_"%NOLOCK "
	set:$$$mtKNoIndexFlag($g($$$mtK))=1 sql=sql_"%NOINDEX "
	set:$$$mtKNoTriggerFlag($g($$$mtK))=1 sql=sql_"%NOTRIGGER "
	set sql=sql_"INTO "_jj_"("  ;  jj = SCH.TNAME                                     // JMM837-
	#;  if the target table is non-sharded, add it to pjt
	s:'$$$smdSharded(1,irn) mt("sql",1,"shnot")=$lb(jj)
	#;  $$$mtFList=val1,val2,...,valn  ;  $$$mtV(vali)="i^%insel(col#)"
	f jj=1:1:$l($$$mtFList,",")-1 s sql=sql_$e(",",jj>1)_$$quoter2($$$smdGetNameFromIcol(1,irn,+$p($$$mtV($p($$$mtFList,",",jj)),"(",2)))
	s sql=sql_") "_$$gensel^%qaqcmh(1)
	set options="" // JMM1035+
	if $$$SQLCompileOption("ISCShardLocalInsert")=1 { set options=options_" /*#OPTIONS {""ISCShardLocalInsert"":1} */" }
	if $$$SQLCompileOption("DML_PARALLEL")=1 { set options=options_" /*#OPTIONS {""DML_PARALLEL"":1} */" }
	s shardScreenOption=$$$SQLCompileOption("ISCShardScreen") // JMM1134+
	if shardScreenOption'="" { set options=options_" /*#OPTIONS {""ISCShardScreen"":"_shardScreenOption_"} */" } // JMM1134-
	s sql=sql_options // JMM1035-
	$$$liin("s:'##class(%BigData.ShardedSQL).%ShardIUD("_$$quoter(mt("shardext",1))_","_$$quoter(sql)_","_$$setprm(prm)_","_$$pjt(1)_",,.SQLCODE,.%ROWID,.%ROWCOUNT) SQLCODE=-253,%msg=""Sharded INSERT error: ""_%msg")
	$$$liin("} catch { d SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) }")
	$$$liin("q")
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK959-
shardins  ;  single-row sharded INSERT, called from ^qaqt
	#;  TRY {  ;  generate code for sharded single-row INSERT, such as:
	#;  n %i  ;  &SQL(INSERT INTO sch.sht SET x=?, y=?)
	#;  s %i(2)=%parm(1),%i(4)=%parm(2)  ;  copy() - convert/normalize etc.
	#;  s:'##class(%BigData.ShardedSQL).%InsertRow("sch.sht",[$LB(
	#;     $G(%i(3)),$G(%i(4)))],.%i,$C(0,0,0,0,0,0,0),,,.SQLCODE,.%ROWID,
	#;     .%ROWCOUNT) SQLCODE=-253,%msg="Sharded INSERT error: "_%msg
	#;  } CATCH { d SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) }
	#;  QUIT
	$$$liin("try {")
	d nuvar("%i")
	d copy("%i(")  ;  copies provided values (or from array) into %i(col#)
	#;  maybe add here CHECK OPTION validation code??? ***
	#;  ClassMethod %InsertRow(
	#;  	pClassName As %String,    ;  from mt("shardext",1)
	#;  	pShardKey As %List = "",  ;  use only if user-specified shard key
	#;  	ByRef pData,              ;  %i() array with field data
	#;  	pCheck As %String,        ;  $C(0,0,0,0,0,0,0)  options
	#;  	pInsSel As %Integer = 0,  ;  (not used)
	#;  	pTstart As %Integer = 0,  ;  (not used)
	#;  	ByRef pSQLCODE As %Integer,
	#;  	ByRef pRowId As %String,
	#;  	ByRef pRowCount As %Integer,
	#;  	pBatch As %Integer = 0) As %Status  ;  (not used)
 	$$$liin("s:'##class(%BigData.ShardedSQL).%InsertRow("_$$quoter($$getMasterClassName^%SYS.SHARDSRV($$$smdClassname(1,$p(mtc(mcurs,"f"),",",2))))_","_$$shkvals("%i")_",.%i,"_$$check_",,,.SQLCODE,.%ROWID,.%ROWCOUNT) SQLCODE=-253,%msg=""Sharded INSERT error: ""_%msg") // JMM837 JMM860
	$$$liin("} catch { d SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) }")
	$$$liin("q")
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK959
shkvals(arr) n irn,sk,jj  ;  $$: generated $LIST() of shard key values within
	#;  array arr(col#), "" if it's a system-generated rowid
	s irn=$p(mtc(mcurs,"f"),",",2),sk=$$$smdShardKey(1,irn)  ;  comma-list of ifn's
	RETURN:'sk ""  ;  system-generated rowid shard key
	RETURN:$$$smdColIsIdentityColumn(1,irn,sk) ""   ; identity column - system generated single field idkey
	if $$$smdGetIcolFromIfn(sk)=1,$$$smdRowIDBased(1,irn)="Y" { set jj=$$$smdRowIDLogicalFields(1,irn) if jj'["," { RETURN:$$$smdColIsIdentityColumn(1,irn,jj) "" } }  ; sk is single-field IDKEY based on identity column - this is system assigned
	#;  if single-field IDKEY, use the IDKEY field  ;  AK962
	i sk'[",",$$$smdGetIcolFromIfn(sk)=1,$$$smdRowIDBased(1,irn)="Y" { s jj=$$$smdRowIDLogicalFields(1,irn) i jj'["," { s sk=jj } }
	f jj=1:1:$l(sk,",") s $p(sk,",",jj)=arr_"("_$$$smdGetIcolFromIfn($p(sk,",",jj))_")"
	RETURN "$lb("_sk_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
freesh(m)  ;  $$: whether subquery m is free-sharded, i.e. its result is the
	#;  same as the combined result of running the query on all shard
	#;  servers, e.g. no GROUP BY, aggregates, pagination (TOP/LIMIT/FETCH and/or OFFSET), AK939 OJ logic etc.
	#;  i.e. no post-join processing required on the master
	RETURN ('$g($$$mtGroupDistinctList(m))&&'$p(mt("p",m),"^",3)&&'$$hasPagination^%qaqpsq(m)&&($g($$$mtShard(m))'="rows")&&'$g(mt("shrows",m))&&'$d(ojfilter(m)))||($$$SQLCompileOption("ISCShardLocalInsert")=1) // JMM1035
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK959-
updelfrom(target) n str  ;  $$: FROM clause for the UPDATE/DELETE, if needed
	#;  see if $$$mtRNumStreams for m=1 contains any stream other than the target
	f str=1:1:$o($$$mtR(""),-1) i str'=target,$$$mtRQb($$$mtR(str))=1 { RETURN $$genfrom^%qaqcmh(1) }
	RETURN ""
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setprm(prm)  ;  NEW, SET, and convert variables for parameters, return the
	#;  'params' actual argument
	#;  n v1,v2 s v1=%parm(1),v2=%parm(2) ; also conversions etc.
	#;  d:%ShardIUD(...,$LB(v1,v2),...)
	RETURN:prm="" ""  ;  no parameters used
	n jj,quq,var,val
	f jj=1:1:$ll(prm) s $p(quq,",",jj)="%sqldata"_jj_"v"
	$$$liin($c(9)_"n "_quq)  ;  copy each variable, and convert if needed
	f jj=1:1:$ll(prm) s var=$p(quq,",",jj),val=$li(prm,jj) $$$liin($c(9)_"s "_var_"="_$$dget($e($$$mtV(val),3,*))_$$sconvert(var,val))
	RETURN "$LB("_quq_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dget(var)  ;  $$:  apply $G(prm) to prm, but not if it's an oref!
	RETURN $s(var[".":var,1:"$g("_var_")")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
sconvert(var,val) n meth  ;  $$:  ",var=convert(var)" based on VTR(val) datatype
	if 0,$$$VTRgetdt(val)["Stream" { //***
			#; if the input value is to a stream field, we support 3 tpes of values.
			#;   1) literal
			#;   2) oref / streing-oref to temp stream object
			#;   3) Oid of temp stram object
			#; We need to make sure we are always using the Oid for a sharded table, and that the stream is stored in a global that is not private to this system
		RETURN " if $isobject("_var_") { do:"_var_".%IsModified "_var_".%Save() set "_var_"="_var_".%Oid() } elseif ("_var_"?1.n1""@""1.e) { try { new ts set ts=$zobjref("_var_") if $isobject(ts),ts.%IsA(""%Stream.Object""),(("_var_"_"""")=(ts_"""")) { do:ts.%IsModified() ts.%Save() set "_var_"=ts.%Oid()} } catch { set $ze="""" }}"
	}
	RETURN:$d(mt("unary",val,"%ODBCIN")) ""  ;  {d ?} - keep it as ODBC
	set meth=$case(mt("sqlcomp"),"%Runtime":"RuntimeToLogical","%ODBC":"OdbcToLogical","%EXTERNAL":"DisplayToLogical",:"")
	RETURN:meth="" ""  ;  logical mode, no conversion needed
	s meth=$$appmeth^%qaqcpr(var,meth,val)
	RETURN:meth=var ""  ;  no conversion found
	RETURN ","_var_"="_meth
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
pjt(m,target="") n pjt,jj,tabs,li s pjt=""  ;  $$: pJoinTables argument for
	#;  generated calls %ShardIUD(,,,pjt) and %ShardQuery(,,,,pjt)
	#;  turn mt("cosh",m)=$LB($LB(7,9),$LB(8)) (str# for cosharded groups)
	#;  and mt("sql",m,"shnot")=$LB("a.b","c.d") (non-sharded tables) into
	#;  $LB($LB($LB("T7","T9"),3),$LB($LB("T8"),2),$LB($LB("a.b"),1),$LB($LB("c.d"),1))
	#;  for normal UPD/DEL of a sharded table with no FROM clause, pjt=""
	s jj=$ll(mt("cosh",m))  ;  number of cosharded groups
	#;  if there is non-cosharding, list all sharded tables, in coshard
	#;  groups, with type=2 (for singleton groups) or 3, with
	#;  weight=1000 for the group containing the target table
	i jj>1 { f jj=1:1:jj { s tabs=$li(mt("cosh",m),jj),pjt=pjt_",$LB($LB(" f li=1:1:$ll(tabs) { s pjt=pjt_$e(",",li>1)_"""T"_$li(tabs,li)_""""  } s pjt=pjt_"),"_((li>1)+2)_$s($lf(tabs,target):",1000)",1:")") } }
	#;  list all non-sharded tables, if any, under type=1
	f jj=1:1:$ll($g(mt("sql",m,"shnot"))) s pjt=pjt_",$LB($LB("""_$li(mt("sql",m,"shnot"),jj)_"""),1)"
	RETURN:pjt="" ""  ;  no non-sharded tables, and no non-cosharding
	RETURN "$LB("_$e(pjt,2,*)_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
	;  The %check flag:
	;    $a(%check)   = TRUE means %NOCHECK
	;    $a(%check,2) = TRUE means %NOLOCK
	;                     For UPDATE and DELETE $a(%check,2)=1 if %NOLOCK, 2 if the lock is performed before the filer.
	;    $a(%check,3) = TRUE means %NOINDEX
	;    $a(%check,4) = TRUE means %NOTRIGGER
	;    $a(%check,5) = TRUE means %NOSTREAM
	;    $a(%check,6) = TRUE means %OBJECTFILER
	;    $a(%check,7) = TRUE means INSERT OR UPDATE
	;    $a(%check,8) = TRUE means %NONORMALIZE (DPV5614)
	;    $a(%check,9) = TRUE means %DEFER (DPV6636) - INSERT only
check()	[mt] PUBLIC {	 // Check the parse tree for %NOCHECK and/or %NOLOCK and/or %NOINDEX and/or %NOTRIGGER and/or %NOSTREAM...
	RETURN:$$$mtKUseCheckVariable($g($$$mtK))=1 "$g(%check)"	// DPV2935=
		#;  $E(%check,7) used for "OR UPDATE" option in INSERT
		#; If this UPD or DEL is parallel, the select code will not lock the row.  We change the lock flag from 2 to 0 so the filer will lock the row
	if $d($$$mtParag(1)),$$$mtKNoLockFlag($g($$$mtK))=2,$case($$$mtStatementType,"UPD":1,"DEL":1,:0) { set $$$mtKNoLockFlag($$$mtK)=0 }
	RETURN "$c("_+$$$mtKNoCheckFlag($g($$$mtK))_","	// %NOCHECK
				_+$$$mtKNoLockFlag($g($$$mtK))_","		// %NOLOCK
				_+$$$mtKNoIndexFlag($g($$$mtK))_","		// %NOINDEX
				_+$$$mtKNoTriggerFlag($g($$$mtK))_","	// %NOTRIGGER
				_+$$$mtKNoStream($g($$$mtK))_","	// %NOSTREAM
				_+$$$mtKObjectFiler($g($$$mtK))_","	// %OBJECTFILER
				_+$g(mt("orupdate"))_","		// INSERT OR UPDATE
				_+$$$mtKNoNormalizeFlag($g($$$mtK))_","	// %NORMALIZE
				_+$$$mtKDefer($g($$$mtK))_")"	// %%DEFER
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddflrt() [mcurs,mtc] PUBLIC { QUIT "^"_$$$smdTableRoutinePrefix($p(mtc(mcurs,"f"),",",2))_1 }
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddcol(val) [mt] PUBLIC { QUIT $$$smdGetIcolFromIfn($p($$$mtV(val),"^",3)) }
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nextc(mcurs)	s i=i+1  ;  $$:  get the next entry from mtc(mcurs,"o")
	q $p(mtc(mcurs,"o"),$c(1),i)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nextb()	set ib=ib+1  ;  $$:  get the next entry from $p(mt("b"),"^",1|2)
	QUIT $tr($p($g($$$mtSelectInto),",",ib),"^")  ;  found in main node
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
error(e)	g ^%qaqperr  ;e is error#
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
chkprv	; Do code generation for SQL %CHECKPRIV
	new action,grantOption,lines,line,list,mod,obj,tag,typ
chkset	set mod=1,lines=0,line="",tag="",mtag=gtag_"priv",tag=mtag
	if $g($$$mtKSysPriv)'="" {
		new bstr,i set bstr=""
		for i=1:1:$bitcount($$$mtKSysPriv) { set bstr=bstr_$bit($$$mtKSysPriv,i)_"," }
		$$$liin($c(9)_"set SQLCODE=0 set:'$$haspriv^%SYS.SQLSEC($Username,"""_$e(bstr,1,*-1)_""""_$s($$$mtKGrantOption($g($$$mtK))=1:",1",1:"")_") SQLCODE=100 quit")
		RETURN
	}
		#;
		#; set parameters
	set grantOption=+$$$mtKGrantOption($g($$$mtK))      // sets GRANT flag
	set typ=$o($$$mtR(""))            // sets object type
	if $d($$$mtKAction("USE")) { set action="l",list="" }
	else { set action=$tr($e($o($$$mtKAction(""),1,list)),"%SIUDRE","asiudre") }	// sets action, optional list of fields
	set obj=typ_","_$lg($$$mtR(typ))					// sets object in form: "type,objname"
	if list'="" {
		new extent,f,fields,i 
		set fields="",extent=$$$GetExtentNameFromIQN($p(obj,",",2,*))
		for i=1:1 {
			set val=$p(list,",",i)
			quit:val=""
			set f=$g($$$EXTsqlcolumnidx($$$rEXT,extent,$p($$$mtV(val),"^",3)))
			if f="" { set tname=$p(obj,",",2,*),fname=$p($$$mtV(val),"^",3) do error(31) }
			set fields=fields_$lb(f)
		}
		$$$liin("set SQLCODE=0 set:'$$priv^%SYS.SQLSEC("""_obj_""","""_action_""",$namespace,"_grantOption_","_$s(fields="":"",1:$$RecomposeList(fields))_") SQLCODE=100 quit")
	} else { $$$liin("set SQLCODE=0 set:'$$priv^%SYS.SQLSEC("""_obj_""","""_action_""",$namespace,"_grantOption_") SQLCODE=100 quit") }
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
grtrev	; Do code generation for SQL GRANT, REVOKE
	new cascade,grantOption,grantors,grtrev,lines,line,mod,tag,typ,users
init	set mod=1,lines=0,line="",tag="",cascade=1
	set mtag=gtag_"priv",tag=mtag
	set grtrev=$$$mtStatementType           ; sets GRANT/REVOKE flag
	set users=$$$mtUsers            ; sets user list
	set grantors=$g(mt("grantor"))  ; sets grantors list (DPV3342)
	set grantOption=+$$$mtKGrantOption($g($$$mtK)) ; sets grant flag
	set typ=$o($$$mtR(""))       ; sets object type
		#; set CASCADE flag if REVOKE
	set:grtrev="REV" cascade=+$$$mtKCascadeOption($$$mtK)
	goto:typ="" rolestr
	new action,acts,objs,star,list
	set action="",acts=""
tabacts	;               sets up list of actions
	do GenerateAuditCode^%qaqcasl(%sqlAudit)
	$$$liin("set SQLCODE=100 if $zu(115,1)=1 { TSTART  } else { if '$TLEVEL,$zu(115,1)=2 { TSTART  }}")
	set star=(acts="*"||($g($$$mtR(1))="*"))
	for  {
		set action=$o($$$mtKAction(action),1,list) quit:action=""
		continue:action="zzzSCHEMA"	// continue, not quit since on some collations "z" collates before "%"
		continue:action="SERVER"
		if action="USE" { set acts=acts_"l" }	// "l" is the action for USE, u already in use by Update, S by Select, and E by Execute...
		else {
			set:list="" acts=acts_$tr($e(action),"%SIUDREC","asiudre")
			do fields:list'=""	// DPV3316, Cubes just do SELECT
		}
	}
tabgen	; generate lines for tables and views and procedures
	if acts'="" {
		for typ=1,3,9,5,4,6,7 {	// DPV3316 (type 4 is CUBE)	// 5 is SCHEMA // 6 is ML Configuration
			set objs=$g($$$mtR(typ)) 
			continue:objs=""
			do setline(grtrev,acts,typ,objs,users,grantOption,cascade,,grantors) 
			if typ=1,'star $$$liin("g:SQLCODE<0 "_mtag_"e")
		}
	}
	set tag=mtag_"e"
		#; If doing autocommit and a failure occurs, then rollback just to the start of this unit of work
	$$$liin("if $zu(115,1)=1,$TLEVEL { TCOMMIT:SQLCODE'<0  if SQLCODE<0 { TROLLBACK 1 }} RETURN")
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fields	; sets up field object list
	n act,fields,i,typ,val
	s fields="",act=$tr($e(action),"%SIUDRE","asiudre")
	f i=1:1 s val=$p(list,",",i) q:val=""  s fields=fields_$lb($p($$$mtV(val),"^",3))
	s objs=$g($$$mtR(1)),typ=1 s:objs="" objs=$g($$$mtR(3)),typ=3	// table or view
	d setline(grtrev,act,typ,objs,users,grantOption,cascade,fields,grantors) 
	if typ=1,'star $$$liin("g:SQLCODE<0 "_mtag_"e")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setline(grtrev,acts,typ,objs,users,grantOption,cascade,fields="",grantors="")	;  generate lines	// DPV3342 (grantors)
	if grtrev="GRA" { set line="do setup^%SYS.SQLSEC("""_acts_""","_typ_","_$s(objs="*":"""*""",1:$$RecomposeList(objs))_","_$$quoter(users)_","_grantOption_","_cascade_",,"_$s(fields="":"",1:$$RecomposeList(fields))_",,..#%statementnoaudit"_")" }								// DPV5014
	else            { set line="do setup1^%SYS.SQLSEC("""_acts_""","_typ_","_$s(objs="*":"""*""",1:$$RecomposeList(objs))_","_$$quoter(users)_","_grantOption_","_cascade_",,,"_$s(grantors="":"",1:$$quoter(grantors))_","_$s(fields="":"",1:$$RecomposeList(fields))_",,..#%statementnoaudit"_")" }		// DPV5014
	$$$liin(.line) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
rolestr	// DPV2271= i $d(mt("THR")) g treshold
	n i,line,rolelist,roles,user,userlist,users,wao
	s wao=+$$$mtKGrantOption($g($$$mtK)),tag=mtag
	s rolelist="",roles=$g($$$mtRoles),userlist=""
	f i=1:1 q:$p(roles,",",i)=""  s rolelist=rolelist_$e(",",i>1)_$$quoter($p(roles,",",i))
	s users=$$$mtUsers
	i users'="*" { s userlist=users	} // DPV3031 f i=1:1 s user=$p(users,",",i) q:user=""  s $p(userlist,",",i)=$$quoter2(user,1)
	Else { s userlist="*" }		// DPV2364=
	s userlist=$p(userlist_",,",",,")
	do GenerateAuditCode^%qaqcasl(%sqlAudit)
	If grtrev="GRA" {
		$$$liin("n roles,users s SQLCODE=0,roles=$lb("_rolelist_"),users="_$$quoter(userlist))			// DPV5014
		$$$liin("s SQLCODE=$$GrantRole^%SYS.SQLSEC(users,roles,$Username,"_$s(wao:1,1:0)_",.%msg,..#%statementnoaudit) q")
	}
	If grtrev="REV" {
		$$$liin("n roles,users s SQLCODE=0,roles=$lb("_rolelist_"),users="_$$quoter(userlist))			// DPV5014
		$$$liin("s SQLCODE=$$RevokeRole^%SYS.SQLSEC(users,roles,$Username,..#%statementnoaudit) q")
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
crdrrole	;             generate code for CREATE/DROP ROLE
	n crdr,lines,line,mod,role,tag,typ
	s mod=1,lines=0,(line,tag)=""
	s mtag=gtag_"cdrl",tag=mtag ; set tag to create drop role
	s crdr=$$$mtStatementType ; sets CREATE/DROP flag
	s role=$$$mtRoles ; sets user list
	do GenerateAuditCode^%qaqcasl(%sqlAudit)
	if crdr="CRR" $$$liin("do CreateRole^%SYS.SQLSEC("_$$quoter(role)_",.SQLCODE,.%msg) q") QUIT		// DPV5014
	if crdr="DRR" $$$liin("do DropRole^%SYS.SQLSEC("_$$quoter(role)_",.SQLCODE,.%msg,"_$get($$$mtRoleExists)_") q")			// DPV5014
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
grsysprv	;             Grant/Revoke System Privileges
	n lines,line,mod,role,tag
	s mod=1,lines=0,(line,tag)=""
	s mtag=gtag_"sp",tag=mtag ; set tag to alter a user's system privilege
	#;  Or just a standard system privilege
	n %line,bstr,i s bstr=""
	f i=1:1:$bitcount($$$mtKSysPriv) s bstr=bstr_$bit($$$mtKSysPriv,i)
	s %line="n %mmmi,%mmm1,%mmm2 s %mmm1="""_bstr_""" f %mmmi=1:1:$l(%mmm1) { s $Bit(%mmm2,%mmmi)=+$e(%mmm1,%mmmi) } "
	do GenerateAuditCode^%qaqcasl(%sqlAudit)
	$$$liin($c(9)_%line_"q:'$$sysprv^%SYS.SQLSEC("_($$$mtStatementType="GRP")_","_$$quoter($$$mtUsers)_",%mmm2"_$s($$$mtStatementType="GRP":","_($$$mtKGrantOption($g($$$mtK))=1)_",..#%statementnoaudit",1:",,..#%statementnoaudit")_")  s SQLCODE=0 q")	// DPV5014
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
quit	$$$liin("q") QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getgen	; Code Generate the GET Statement...
	n lines,line,mod,tag,tagpre
	s mod=1,lines=0,(line,tag)=""
	s tagpre=$s($g(mcurs)'="":mcurs,1:gtag)
	s tag=tagpre_"g(type,diaghead,ddetail)"
	$$$liin("; --- GET Information ---")
	i $p($$$mtGetStatementRowCount,"^")="%ROWCOUNT" d  ; --- GET %ROWCOUNT ---
	. n counter,hostvar s mtag=tagpre_"g(""%rowcount"")"
	. s counter=$p($$$mtV($p($$$mtOutputVals($$$mtOutput(1)),",")),"^",2)
	. s hostvar=$p($$$mtV($p($p($$$mtSelectInto,"^",2),",")),"^",2)
	. $$$liin("i type=""%rowcount"" s "_hostvar_"=$g("_counter_") q")
	. d quit
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tp	;	        Transaction Processing Code Generation...
	n line,lines,mod,mode,tag
	s mod=1,lines=0,line="",tag="",mtag=gtag_"o",tag=mtag
		#; COMMIT statement
		#; Iteratively commit back to the $tlevel of the previous START TRANSACTION  // JLF186
		#;
	if $$$mtStatementType="COM" {
		$$$liin("f  { TCOMMIT:$tlevel  q:'$d(%0CacheSavePt($tlevel+1))  KILL %0CacheSavePt($tlevel+1) } s SQLCODE=0 q") 
		QUIT
	}
	
		#;  ROLLBACK [ WORK | TO SAVEPOINT <savepointName> ]
	if $$$mtStatementType="ROL" { 
			#; Iteratively roll back to the $tlevel of the previous START TRANSACTION  // JLF240
		if '$d(mt("savept")) {
			$$$liin("for  { quit:'$tlevel  TROLLBACK 1  quit:'$d(%0CacheSavePt($tlevel+1))  kill %0CacheSavePt($tlevel+1) }") 
		} elseif mt("savept")'="" {
			$$$liin("for  { quit:'$tlevel  TROLLBACK 1  quit:($g(%0CacheSavePt($tlevel+1))="_$$quoter(mt("savept"))_")  kill %0CacheSavePt($tlevel+1) }")
			$$$liin("if ($g(%0CacheSavePt($tlevel+1))="_$$quoter(mt("savept"))_") { kill %0CacheSavePt($tlevel+1) } else { set SQLCODE=-375,%msg=""Cannot ROLLBACK to unestablished savepoint '"_$$quoter2(mt("savept"),1)_"'"" quit }")
		} else {
			$$$liin("for  { quit:'$tlevel  TROLLBACK 1  quit:$g(%0CacheSavePt($tlevel+1))'=""SYS0"" kill %0CacheSavePt($tlevel+1) }")
			$$$liin("kill:$d(%0CacheSavePt($tlevel+1)) %0CacheSavePt($tlevel+1)")
		}
.
		$$$liin("set SQLCODE=0 quit")
		kill mt("savept")
		QUIT
	}
	
	#;  SAVEPOINT <savepointName> statement
	if $$$mtStatementType="SAV" {
		$$$liin("TSTART  set %0CacheSavePt($tlevel)="_$$quoter(mt("savept"))_" new %0CacheLev for %0CacheLev=1:1:$tlevel-1 { if $g(%0CacheSavePt(%0CacheLev))=%0CacheSavePt($tlevel) { set %0CacheSavePt(%0CacheLev)=""SYS0"" quit } } kill %0CacheLev set SQLCODE=0 quit")	// DPV2888
		kill mt("savept")
		QUIT
	}
	
		#;  %INTRANS[ACTION] statements
	if $e($$$mtStatementType,1,3)="%IN" { $$$liin("s SQLCODE=$s($tlevel:0,1:100) quit") QUIT  }
		#;  %BEGTRANS statement
	if $$$mtStatementType="%BE" { $$$liin("TSTART:'$tlevel  set SQLCODE=0 quit") QUIT  }
		#;  START/SET TRANSACTION statements
	$$$liin("TSTART:'$tlevel"):$e($$$mtStatementType,1,3)="STA"
	$$$liin("i $zu(115,1,0)"):$g($$$mtTransaction)["N-"  ;  no auto transaction
	$$$liin("i $zu(115,1,1)"):$g($$$mtTransaction)["I-"  ;  autocommit on
	$$$liin("i $zu(115,1,2)"):$g($$$mtTransaction)["E-"  ;  autocommit off
	$$$liin("i $zu(115,2,0)"):$g($$$mtTransaction)["i-RU-"  ;  read uncommitted
	$$$liin("i $zu(115,2,1)"):$g($$$mtTransaction)["i-RC-"  ;  committed read
	$$$liin("i $zu(115,2,2)"):$g($$$mtTransaction)["i-RR-"  ;  repeatable read - not supported
	$$$liin("i $zu(115,2,3)"):$g($$$mtTransaction)["i-RV-"  ;  read verified
		#;  "read only" transaction implies read uncommitted
	if $g($$$mtTransaction)["t-RO-",$$$mtTransaction'["i-" { $$$liin("if $zu(115,2,0)") }
		#;  "read write" transaction implies committed read
	if $g($$$mtTransaction)["t-RW-",$$$mtTransaction'["i-" { $$$liin("if $zu(115,2,1)") }
	$$$liin("set SQLCODE=0 quit")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
RecomposeList(list)	;    Given a $List string, return a $lb(...) command to recreate it
	QUIT:$g(list)="" ""  ; No list, empty string
	n i,retval,t s retval="$lb("
	f i=1:1:$ll(list) s t=$lg(list,i),retval=retval_$s(t="":"",t=+t:t,1:$$quoter(t))_","
	s $e(retval,$l(retval))=")" ; replace last comma with )
	QUIT retval
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#INCLUDE %fcalpha
#INCLUDE %quoter
---
