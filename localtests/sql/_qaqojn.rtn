====
qaqojn
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqojn^MAC^^^0
%qaqojn	// QO - Cost formulas for joins
	;; COMPONENTS :: SQL/Optimizer
	#;
#INCLUDE %msql
#INCLUDE %qao
	#;---------------------------------------------------------------------
 ; Description:   QO - Cost formulas for joins
 ; Author:        Terry Ragon
 ; Date:          September 18, 1987
 ; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
 ;
 ;  PVA319  (02/24/2015) - Make cost rounding consistent between initial stream and join algorithms 
 ;  PVA219  (03/12/2010) - Fix optimizer avoiding sort files in certain cases (e.g. DISTINCT) when a join is on the recid 
 ;  PVA154  (09/01/2008) - Improve optimizer cost model : distinguish selectivity for complex conditions on map subscripts from that on map data
 ;  AK428   (03/02/2000) - CCS#110: Optimizer <DIVIDE> on 0 tuples
 ;
 ;---------------------------------------------------------------------
 ;                     I N F O R M A T I O N
 ;---------------------------------------------------------------------
	#; 
	#;  $$join^%qaqojn(...)
	#;  input parameters:
	#;      alg: the low level algorithm name
	#;      intuples: # of input tuples
	#;      recid: 1 if joining on record id
	#;      qoouter: 1 if outer join, 0 if inner (normal) join
	#;      ordinput: 1 if ordered input is required
	#;      nocdmap0 :  1 if map 0 blocks have already been accessed due
	#;               to this stream being stored with a child/parent
	#;      abp:  available buffer pool (# buffers available for this join)
	#;  input variables:
	#;      form:  input array for cost formulas
	#;  return:       cost ^ number of tuples
	#;      where cost is expressed in the format:
	#;            total cost,disc accesses,global gets,global sets
	#; 
	#; 
	#;  *****When using JALG1, ignore range on JA since it will be migrated
	#;    (not migrated for initial stream algorithms, whose cost formulas
	#;    closely parallel the join cost formulas, so be careful in writing
	#;     cost formulas.
	#; 
	#;  Note that the description of each join algorithm is described in
	#;  the "Low Level Algorithm" paper
	#; 
	#;  in the joins, the following is usually true:
	#;      form($$$SL2B)*form($$$SSJASUB) = % of time that for a given 
	#;                    JA in B we
	#;                 find the JA in the index given the higher sub rest
	#;      form($$$SL2B)*form($$$SSJASUB)*form($$$SSJAADD) = % of time
	#;                that for a given JA in A we find the JA in the
	#;                index given the higher level subscript tests AND
	#;                the possibility that A has a bigger domain for
	#;                the JA attribute than B does
	#;      form($$$SL2B)*form($$$SSJASUB)*form($$$SSJAADD)*form($$$SZB) =
	#;                 average # of tuples in B stream per input tuple
	#; 
	#; ---------------------------------------------------------------------
.
join(alg,intuples,recid,qoouter,ordinput,nocdmap0,abp) ;
	new a,b,c,x,y,z,cd,cgg,cgs,numtup,rilowsub,riother,rbother,qd g @alg
		#;  now add cgg cost of accessing map 0
		#; 
J1	g J7
		#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
		#;  J2
		#;   Iterative loop on stream-B.  Use a  map that contains all of
		#;   the necessary data ordered on the JA.  There may be a
		#;   B-only equals restriction above or on the JA.  Consider
		#;   all the nodes under the JA as candidates, subject to
		#;   satisfying all restrictions
J2	g J6
		#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
		#;  J3
		#;   like J2 except also have to go to map 0
J3	g J7
		#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
		#;  J4
		#;   Like J2, except also have an equals restriction in a
		#;   subscript below the JA
J4	g J6
		#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
		#;  J5
		#;   Like J4, except we must also goto map0
J5	g J7
		#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
		#;  J6
		#;   like J2, except also have a range restriction in a
		#;   subscript below the JA
J6	s a=form($$$SL2B)*form($$$SSJASUB)*form($$$SSJAADD),rilowsub=form($$$SSE3)*form($$$SSR),b=a*form($$$SZB)*rilowsub,riother=form($$$SSOI)*form($$$SSOIMUL)
	s numtup=intuples*b*riother*form($$$SSOID)*form($$$SSOIMULD) // PVA154
		#; 
		#;  i qoouter, have more output tuples
		#;  1-a = % of input tuples that failed to find a JA that matches
		#;         high level equals restrictions
		#;  d = % of input tuples that found a join attribute that passed
		#;         high level equals restrictions but failed
		#;         other restrictions in the index
		#; 
		#;  PVA154: also include new form() entries in numtup augmentation for outer join
	i qoouter s d=form($$$SZB)*rilowsub*riother*form($$$SSOID)*form($$$SSOIMULD),d=$s(d<1:1-d,1:0),numtup=intuples*(1-a+d)+numtup
	s:numtup>5 numtup=numtup+.5\1  // PVA319: change rounding
		#;  calculate cgg cost for index accesses:
		#;  If joining on record id,
		#;  then index access cost = 
		#;      1 $D per input tuple if there's no data to pick up in index
		#;      or 1 $D + 1 $G per input tuple if there's data to pick up in 
		#;                  index
		#;             + ($$$SGPi-1) for each of those that pass any additional 
		#;                           test
		#;   else:  (also assume the next subscript is the record id)
		#;      2 $O per input tuple ($O at JA level + extra $O at id level)
		#;            ( 3 if there's a range, $G + $O)
		#;      + 2 ($O and a get) per B tuple that matches that JA and pases 
		#;                         sub rest
		#;      + ($$$SGPi - 1) per B tuple that matches that JA and passes 
		#;                      sub rest
		#;          i.e.: intuples*((form($$$SSR)<1)+2+(2*b)+
		#;                       (b*riother*(form($$$SGPi)-1)))
		#;  PVA219: use b instead of rilowsub in recid case, like other case, to pick up join selectivity
	i recid s cgg=$s(form($$$SGPi)>0:riother*b*(form($$$SGPi)-1)+2,1:1)*intuples
	e  s cgg=intuples*((form($$$SSR)<1)+2+(b*(2+$s(form($$$SGPi)>1:riother*(form($$$SGPi)-1),1:0))))
		#;  calculate disk access
	i nocdmap0 s cd=0 g J6x
		#; 
		#;  qd  = # of index blocks read for each join attribute that
		#;  passes any higher level equals restrictions
		#;  it considers the possibility of reading a portion of each block
		#; 
	i form($$$SGPi)>1 s qd=form($$$SNiblk)*rilowsub/form($$$SL2B)+1
	e  s qd=1
		#;  s cd = form($$$SNiblk) - # index blocks skipped due to $$$SSE3
	i rilowsub<1 s y=form($$$SNiblk)/form($$$SL2B)*(1-rilowsub)-1 ; # blocks per JA disqualified due to $$$SSE3 & $$$SSR
	i  s cd=form($$$SNiblk)-$s(y>0:y*form($$$SL2B)\1,1:0)
	e  s cd=form($$$SNiblk)
		#; 
		#;  i intuples<form($$$SL2B) then don't need to read all of the blocks
		#;  only read qd blocks per input tuple
		#; 
	i intuples<form($$$SL2B),cd>(qd*intuples) s cd=qd*intuples // PVA319: don't round away most sig. digits
		#;  if all index blocks can't fit in buffer pool at once and we aren't
		#;  processing in JA order, then calculate cost of reading all blocks,
		#;  sometimes multiple times
		#;  (apb/qd)*qd is initial cost to fill buffer pool
		#;  (1-(abp/cd)) is the probability of finding a needed block
		#;      in the buffer pool once it has been initially filled
		#;  (intuples-(apb/qd))*qd represents disk references needed not
		#;      counting those that initially fill the buffer pool
		#;  ((intuples-(abp/qd))*(1-(abp/cd))+(abp/qd))*qd
	i cd>abp,'ordinput s cd=(cd-abp)*(1-(abp/cd))+abp
		#;  PVA319: don't round away most sig. digits
	s:cd>5 cd=cd\1
J6x	s:cgg>5 cgg=cgg\1 
	RETURN ((cd*CDFACTOR)+(cgg*CGGFACTOR))_","_cd_","_cgg_",0"_"^"_numtup
		#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
		#;  J7
		#;   same as J6, except that we must also goto map0
J7	n abpi,abpb,cd,cdi,cdb,d,e,f
	s a=form($$$SL2B)*form($$$SSJASUB)*form($$$SSJAADD),rilowsub=form($$$SSE3)*form($$$SSR),b=a*form($$$SZB)*rilowsub,riother=form($$$SSOI)*form($$$SSOIMUL),rbother=form($$$SSO0)*form($$$SSO0MUL)
	s numtup=intuples*b*riother*form($$$SSOID)*form($$$SSOIMULD)*rbother // PVA154
		#; 
		#;  i qoouter, have more output tuples
		#;  1-a = % of input tuples that failed to find a JA that matches
		#;         high level equals restrictions in index
		#;  d = % of input tuples that found a join attribute that passed
		#;         high level equals restrictions but failed
		#;         other restrictions in the index or map0
		#; 
		#;  PVA154: also include new form() entries in numtup augmentation for outer join
	i qoouter s d=form($$$SZB)*rilowsub*riother*form($$$SSOID)*form($$$SSOIMULD)*rbother,d=$s(d<1:1-d,1:0),numtup=intuples*(1-a+d)+numtup
	s:numtup>5 numtup=numtup+.5\1  // PVA319: change rounding
		#;  calculate cgg cost for index accesses:
		#;  If joining on record id,
		#;  then index access cost = 
		#;      1 $D per input tuple if there's no data to pick up in index
		#;      or 1 $D + 1 $G per input tuple if there's data to pick up in 
		#;                   index
		#;            (which is needed to pass a test)
		#;           + ($$$SGPi - 1) for each of those that pass that first test
		#;  else  if no extra restrictions to process in index:
		#;         (assume the next subscript is the record id & we do $O on it)
		#;      2 $O per input tuple ($O at JA level + extra $O at id level)
		#;                      (3 if there's a range: 1 $G + 1 $O)
		#;      + 1 $O per B tuple that matches that join attribute and
		#;             passes subscript restrictions
		#;   else:  (also assume the next subscript is the record id)
		#;      2 $O per input tuple ($O at JA level + extra $O at id level)
		#;               (3 if there's a range: 1 $G + 1 $O)
		#;      + 2 ($O and a get) per B tuple that matches that JA and pases 
		#;                         sub rest
		#;      + ($$$SGPi - 1) per B tuple that matches that JA and passes 
		#;                      sub rest
		#;          i.e.: intuples*((form($$$SSR)<1)+2+(2*b)
		#;                    +(b*riother*(form($$$SGPi)-1)))
		#;  PVA219: use b instead of rilowsub in recid case, like other case, to pick up join selectivity
	i recid s cgg=$s(form($$$SGPi)>0:riother*b*(form($$$SGPi)-1)+2,1:1)*intuples
		#;  PVA154: No plausible reason for this case. Index access for IS7 should
		#;     be no different than IS6. Further, whether riother is <1 has nothing to 
		#;     do with whether data nodes in the index need fetching (currently this must
		#;     be asssumed, as there is no determination of this).
       	#;  e  i riother=1 s cgg=intuples*((form($$$SSR)<1)+2+b)
		#;  e  i riother=1 s cgg=intuples*(form($$$SSR)<1+2+b)
	e  s cgg=intuples*((form($$$SSR)<1)+2+(b*(2+$s(form($$$SGPi)>1:riother*(form($$$SGPi)-1),1:0))))
		#;  + add cgg cost for map0
		#;  PVA154: rbother selectivity applied to this cgg computation. That is wrong, because
		#;          the SGPb cost must be paid before you have data to test rbother conditions.
	s cgg=intuples*b*riother*form($$$SSOID)*form($$$SSOIMULD)*$s(form($$$SGPb)>1:form($$$SGPb),1:1)+cgg
		#; 
		#;  qd  = # of index blocks read for each join attribute that
		#;  passes any higher level equals restrictions
		#;  it considers the possibility of reading a portion of each block
		#; 
	i form($$$SGPi)>1 s qd=form($$$SNiblk)*rilowsub/form($$$SL2B)+1
	e  s qd=1
		#;  s y = form($$$SNiblk) - # index blocks skipped due to $$$SSE3
	i rilowsub<1 s y=form($$$SNiblk)/form($$$SL2B)*(1-rilowsub)-1 ; # blocks per JA disqualified due to $$$SSE3 & $$$SSR
	i  s y=form($$$SNiblk)-$s(y>0:y*form($$$SL2B)\1,1:0)
	e  s y=form($$$SNiblk)
		#;  PVA319: don't round away most sig. digits
	i intuples<form($$$SL2B),y>(qd*intuples) s y=qd*intuples
		#;  now y = total # of index blocks needed
	i ordinput s cdi=y,abpb=abp-2 g J7y ; do we have ordered input?
	i nocdmap0 s cdb=0,abpi=abp g J7x ; are map0 blocks already in memory?
		#; 
		#;  find what % of abp is used by index blocks and what % by map 0
		#;  calculate abpi (buffer pool size for index) and abpb 
		#;   (map0 buffer pool size)
		#;  s e = likelihood of finding, for a JA that satisfies high level
		#;      equals, an entry that satisfies all subscript restrictions 
		#;      in index
		#; 
	s e=form($$$SZB)*rilowsub s:e>1 e=1
		#;  For each input tuple,
		#;  when don't find a join attribute, or don't meet subscript
		#;  restrictions, the index gets 1 block
		#;  when we do find a join attribute that passes all
		#;  subscript restrictions, the index uses 'qd' blocks
		#;  and map 0 uses min(max(1,form($$$SZB)*rilowsub),form($$$SNbblk))
		#;  note: (1-a) = % of time we don't find a JA given high level equals 
		#;        res
		#;  set f =   (for a given input tuple)
		#;     # index disk blocks referenced for each input tuple
		#;       (this is useful for calculating % of buffer pool used
		#;       by index, but it doesn't represent physical disk accesses)
		#;    =  % of time don't find JA given higher level equal res
		#;     + % of time find JA but don't pass lower level equal res
		#;     + (qd * % of time we find JA and pass all subscript res)
		#;  s f=(1-a)+(a*(1-e))+(qd*a*e)
	s f=1+(a*e*(qd-1)),z=b*riother i z>form($$$SNbblk) s z=form($$$SNbblk) ; z = # map0 blocks referenced per input tuple
	s f=f/(f+z) ; f = % of buffer pool used by index
	s abpi=f*abp s:abpi<y abpi=y s:abpi<2 abpi=2 s abpb=abp-abpi
		#;  calculate disk cost of accessing the index
J7x	i y'>abpi s cdi=y,abpb=abp-y ; needed idx blcks all fit in buffer pool
	e  s cdi=(y-abpi)*(1-(abpi/y))\1+abpi ; needed index blocks won't all fit in buffer pool
		#; 
		#;  calculate disk cost of accessing map 0
		#;  set cdb = # times we have to access B map 0
		#; 
J7y	i nocdmap0 s cdb=0 g J7z
		#;  PVA154: New form() entries needed here
	s cdb=intuples*b*riother*form($$$SSOID)*form($$$SSOIMULD) g J7z:cdb<form($$$SNbblk) ; initially assume 1 disk access per tuple
	i ordinput,recid s cdb=form($$$SNbblk) g J7z ; if ordered input and joining on record id, don't have to read more than the # of B file blocks
	i form($$$SNbblk)<abpb s cdb=form($$$SNbblk) g J7z ; will all B blocks fit in memory at once?
	i recid,form($$$SSRM)=1,cdb>(intuples*a*form($$$SNbblk)) s cdb=intuples*a*form($$$SNbblk) ; if joining on record id, can't be more blocks read than the # of blks in b * the # of passes through the b file
	i cdb>abpb s cdb=(cdb-abpb)*(1-(abpb/cdb))\1+abpb ; random access of map 0
		#;  PVA319: don't round away most sig. digits
J7z	s cd=cdi+cdb s:cd>5 cd=cd\1 s:cgg>5 cgg=cgg\1 
	q ((cd*CDFACTOR)+(cgg*CGGFACTOR))_","_cd_","_cgg_",0"_"^"_numtup
		#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
J8	g J6
		#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
		#;  CURRENTLY THIS IS NOT REACHED. Will need much updating if merge join ever really supported.
J9	; entry for alg 'J9' is 'jmerge'
jmerge(intuples,inblks,insl2b,innodes,domain) ;
		#; 
		#;  merge loop join algorighm
		#;  input variables:
		#;      intuples: form($$$SNitup) of the first sort file
		#;      inblks: form($$$SNiblk) of the first sort file
		#;      insl2b: form($$$SL2B) of the first sort file
		#;      innodes: form($$$SGPi) of the first sort file
		#;      domain: domain size of JA = form($$$SSJACOND) / 
		#;              min(sel of 1st file's JA ifn, sel of 2nd file's JA ifn)
		#; 
	n x,y,match,cd,cgg,a,b
	s x=insl2b/domain ; % of 2nd sort file (B) tuples that will find a match of JA in 1st sort file (A)
	s y=form($$$SL2B)/domain ; % of A tuples that will find a match in B
	s match=y*insl2b ; matches at JA subscript level
		#; 
		#;  calculate cgg
		#;  first calculate 1st subscript level $O
		#;  = (lessor of $$$SL2B and insl2b)*2
		#;    - (match * (lessor of $$$SL2B and insl2b) / 
		#;                           (greater of $$$SL2B and insl2b))
		#;    *2
		#;  multiply time 2 to account for $D at 1st level or 1st $O at 2nd 
		#;  level of other file
		#; 
	s cgg=2-(match/$s(insl2b>form($$$SL2B):insl2b,1:form($$$SL2B)))*$s(insl2b'>form($$$SL2B):insl2b,1:form($$$SL2B))*2
		#; 
		#;  add:  intuples*y  ; 2nd level $O in 1st file
		#;           form($$$SNitup)*x  ; 2nd level $O in 2nd file
		#;           intuples*y*innodes ; to retrieve data from 1st file
		#;           form($$$SNitup)*x*form($$$SGPi) ; to retrieve data from 
		#;                                             2nd file
		#; 
	s cgg=cgg+(intuples*y*(1+innodes))+(form($$$SNitup)*x*(1+form($$$SGPi)))\1 s:cgg<1 cgg=1
	s cd=inblks+form($$$SNiblk) ; assume have to read all blocks of both sort files
		#; AK428+
		#;   if for the previous join #tuples=0, e.g. if many many conditions
		#;   accumulated, then +costprev,c, and b in jmerge^%qaqoco are all 0,
		#;   and so are intuples and insl2b instead of being epsilon.  set them
		#;   to 1 to prevent <DIVIDE>, while preserving the original formula
	i intuples=insl2b s intuples=1,insl2b=1
	s numtup=match*form($$$SZB)*intuples/insl2b+.5\1 i numtup<1 s numtup=1 ; = m*form($$$SZB)* (the form($$$SZB) of the 1st sort file)
	RETURN ((cd*CDFACTOR)+(cgg*CGGFACTOR))_","_cd_","_cgg_",0"_"^"_numtup
		#; -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
---
