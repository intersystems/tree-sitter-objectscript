====
qaqpop
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpop^MAC^^^0
%qaqpop	// various SQL operations (4/18/87)
	;; COMPONENTS :: SQL/Parser
	#;
#INCLUDE %msql
#INCLUDE %BigData.ShardingManager
#IF 0   ;-------------------------------------------------------------
	; Description:   Various SQL operations
	; Author:        Aviel Klausner
	; Date Started:  April 18, 1987
	;
	;  JMM996  (08/12/2020) - Online sharded cluster rebalancing
	;  JSL5139 (07/20/2017) - mark beginning and end of %INLIST for RTPC
	;  JSL5073 (04/19/2017) - problems with processing "in" because the negative sign is a token
	;  JSL5071 (04/18/2017) - set mt("varposmap") to disambiguate case where same hostvar used more than once
	;  JSL5032 (03/10/2017) - add to $LB at end, which is value of mt("varmap"), an indication if this is a SIZE constant after %INLIST
	;  JSL5024 (01/23/2017) - Put in mt("varmap") information about where host variable or question mark parameter is located in sql
	;  PVA281  (08/14/2013) - Require parentheses around <tables> in FOR SOME predicate. 
	;  PVA242  (07/28/2011) - Support a hint (%noindex) to not use indexes to satisfy the indicated condition. 
	;  PVA235  (02/10/2020) - New syntax for optimizer list size hint for %inlist 
	;  PVA232  (12/03/2010) - Support optional second argument of %inlist() to provide a selectivity hint 
	;  PVA211  (11/30/2009) - Fix query block 'up pointer' for query block moved by pushtop^%qaqpop 
	;  AK755   (10/22/2009) - Use correct SELECT item in AK545 GROUP BY opt
	;  PVA184  (06/14/2009) - Optimizer support for TOP... ORDER BY in subqueries. 
	;  PVA183  (05/26/2009) - Pre-optimizer support for TOP...ORDER BY in subqueries 
	;  PVA176  (04/06/2009) - Remove support for FOR ALL statement, including FOR ALL %ELEMENTS. 
	;  DPV3318 (12/01/2008) - Correct type reporting for replaced xDBC host variables
	;  DPV3198 (06/19/2008) - Improvements to precision/scale reporting for numeric values and expressions 
	;  DPV3093 (01/11/2008) - Better support for parameter datatypes
	;  DPV3080 (12/10/2007) - Fix problem with :i%<%field> name (example, i%%MyProperty)
	;  DPV2939 (05/29/2007) - Fix parsing of object reference in host variable when property is missing
	;                         SQL Fix ProdLog 34480: Compile process inf loop
	;  AK653   (08/01/2006) - Apply collation to LIKE
	;  PVA137  (03/20/2007) - FOR SOME/ALL statement broken since 5.0.11
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  JLF090  (10/27/2006) - Fix [NOT] FOR ALL [%ELEMENT] [NOT] negation bug
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  PVA090  (06/09/2006) - Give error instead of cartesian product for unsupported use of arrow on right side of =*
	;  PVA087  (02/01/2006) - Extended Outer Join Support: Any ON clause for LEFT JOIN from base tables to a base table.
	;  JLF078  (01/23/2006) - Fix svso subquery optimization
	;  AK630   (08/23/2005) - Fix datatype determination in subqueries
	;  DPV2492 (08/18/2005) - More i%property fixes.  Allow i%<name> where <name> is an SQL Reserved word.
	;                         SQL Fix ProdLog 45275:  Error #5475 when link to SAMPLES Cinema schema
	;  DPV2470 (07/27/2005) - Fix inifinite loop on WHERE %ID = :i
	;                         SQL Fix ProdLog 40164: where %ID=:i causes compile hang/loop
	;  DPV2468 (07/26/2005) - Don't allow $$tag^|"%SYS"|%ROUTINE call
	;                         SQL Fix ProdLog 36373: Loophole for calling % extrinsic functions
	;  DPV2321 (11/10/2004) - Use new %SYS.CONFIG API for SQL Configuration settings
	;  JLF015  (05/01/2004) - %ANYOF, =>, and collection indexes
	;  DPV2240 (06/23/2004) - Support :oref.prop(...) as host variable for mulitdimensional arrays
	;  DPV2162 (01/30/2004) - Pass qstruct through to DotSyn^%qarmac calls
	;  DPV2038 (07/11/2003) - Avoid <MAXSTRING> error in hold holdcur()
	;  PVA050  (02/12/2003) - ensure use of rowid based on one field, and the field itself are equally optimized. 
	;  DPV1892 (12/10/2002) - Support oref.prop[.prop2...] for embedded property references.
	;  DPV1887 (12/03/2002) - Support expressiosn beginning with '(' in first IN clause argument
	;  AK545   (11/07/2002) - Move correlated condition from HAVING to WHERE
	;  DPV1833 (09/18/2002) - Support oref.prop as host variable
	;  DPV1743 (06/11/2002) - Only allow $$tag^rtn if system is configured for it
	;  PVA34   (03/15/2002) - Use more than one index per table for restriction.
	;  AK499   (12/12/2001) - SHD: IN subquery with aggregates
	;  DPV1425 (10/19/2000) - Support class instance variables in host variables
	;  DPV1284 (03/30/2000) - Use $$any() instead of $$anyid() for reserved words
	;  AK424   (01/19/2000) - CCS#86: Allow expressions in the IN list
	;  AK423   (01/18/2000) - Ottools: IN with one item
	;  AK418   (12/06/1999) - Anton: Fix LIKE constant optimization
	;  AK412   (12/06/1999) - Reimplement LIKE, %PATTERN
	;  AK405   (11/01/1999) - Dynamic host variables
	;  AK390   (08/20/1999) - CCS#48: UNION in subquery
	;  DPV1125 (09/23/1999) - Support Sybase orthogonal RIGHT OUTER JOIN operator: *=
	;  AK381   (07/13/1999) - Dan: Report variable name in mtc()
	;  AK365   (05/18/1999) - CCS: expr IN subq
	;  AK361   (04/29/1999) - ODBC datatype reporting and conversion
	;  MRP742  (06/24/1998) - Record Parameter Information for Subqueries
	;  AK338   (12/02/1998) - Lexical analyzer moved to %qaqplex.INC
	;  AK305   (01/08/1998) - Fix $$getbval input
	;  AK335   (11/02/1998) - Empty string and NULL
	;  AK326   (07/23/98)   - Replace ?<pat> with %PATTERN <const>
	;  AK325   (07/21/98)   - Korea: Allow spaces in $$ a ^ b ()
	;  DPV700  (02/03/97)   - Optimize IS NOT NULL in the parse tree logicals
	;  MRP642  (09/18/96)   - Robust Stored Procedure Information...
	;  MRP640  (08/26/96)   - Fix Multiple ANDed LIKE :hostvar Problems...
	;  MRP597  (03/03/96)   - Consolidate the SQL Reserved Word List...
	;  MRP562  (12/18/95)   - Allow LIKE <multiple-choice-field>... (** Information Only **)
	;  MRP540  (11/03/95)   - Don't repeat LIKE pattern condition for JOINed queries...
	;  MRP533  (10/13/95)   - Optimize non-correlated subqueries using the IN predicate...
	;  AK277   (08/01/95)   - Fix Exponential notation in tag expo
	;  MRP507  (06/19/95)   - Mark original <pattern> & "<escape>" for LIKE with ALPHAUP...
	;  MRP503  (05/31/95)   - Fixed IN <subquery> & Don't use 'opsome'...
	;  MRP496  (04/08/95)   - Support Optimized LIKE {<const> | <host var>}
	;  MRP397  (05/04/94)   - Support the SQL Concatenation operator || ...
	;  MRP393  (04/11/94)   - Support: LIKE <pattern> [ ESCAPE <escape> ]
	;  AK052;AK064;EYT100;AK167;AK178;MRP121;MRP129;AK183;MRP154
	;  ALL003;ALL006;AK234
	;
#ENDIF  ;-------------------------------------------------------------
	$$$Abort  ;  Not an Entry Point!!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
logop	;  <logop>  ::=  IS  [ NOT ]  NULL  | 
	#;               [ <JSON input clause> ] IS [NOT] JSON [ <JSON predicate type constraint> ] [ <JSON predicate uniqueness constraint> ] |  
	#;               pttrn  |
	#;               [ NOT ]  IN  in  |
	#;               [ NOT ] BETWEEN <scalx> AND scalx | 
	#;               [ NOT ] LIKE <scalx> [ ESCAPE <scalx> ]
	#;
	#;	<JSON input clause> ::=
	#;	  FORMAT <JSON representation>
	#;	<JSON representation> ::=
    	#;	  JSON [ ENCODING { UTF8 | UTF16 | UTF32 } ]	-- for now, we support FORMAT JSON, no support for parsing optional ENCODING clause yet.
	#;	  | <implementation-defined JSON representation option>
	#;	<JSON predicate uniqueness constraint> ::=	-- NOT SUPPORTED AT THIS TIME
    	#;	  WITH UNIQUE [ KEYS ]
	#;	  | WITHOUT UNIQUE [ KEYS ]
	#;	<JSON predicate type constraint> ::=
	#;	    VALUE
	#;	  | ARRAY
	#;	  | OBJECT
	#;	  | SCALAR
	#;
	#;  val1 passed in implicitly - the first operand
	new nsav set nsav=$g(negate)
	new negate set negate=nsav
	if '$g(anyofVal) {
			#; PVA090: do some simple validation on legacy outer join operands, both =* and *= direction
		new starJoinOp
		if $$any(" =* *= ", .starJoinOp) {
			do:$d(inONClause) error(68)		// PVA087: legacy outer join syntax inside of ON clause is bogus.
			do scalx^%qaqpslx()
			new leftOperand, rightOperand
			set leftOperand = $s(starJoinOp="=*": val1, 1: val)
			set rightOperand = $s(starJoinOp="=*": val, 1: val1)
			do:$$badoj(leftOperand, rightOperand) error(94)
			do putlog("v^=*^^"_leftOperand_"^"_rightOperand_"^") 
			set anyofctx = 0 
			RETURN
		}
	}
	GOTO:$$checkid("IS") null		// null also handled JSON
	GOTO:$$checkid("%PATTERN") patrn
	set:$$checkid("NOT") negate='negate  ;  op passed in implicitly to the following
	if $$checkid("LIKE") { 
		do l2p
		do:negate not
		RETURN
	}
	if $$check("%MATCHES") { 
		do matches
		do:negate not
		RETURN
	}  	// DPV3541=
	GOTO:$$checkid("BETWEEN") btwen
	GOTO:$$checkid("IN") in
	GOTO:$$checkid("%INLIST") inlist
		#; JSON...
		#;  To support <expr> FORMAT <JSON representation> IS [ NOT JSON ] 
		#; Paul and I both believe there is no need to make FORMAT reserved here - no ambiguity.
	if $$checkid("FORMAT") { 
		// only JSON representation supported for now, maybe in the future we add PVA, BSON, etc.
		do skipid("JSON")
		do skipid("IS") 
		GOTO null 
	}
	do:'pflag error(14)
	RETURN
	#; PVA090: New tag badoj to validate =* operands
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
badoj(lv,rv) // Do a few simple validations for legacy outer joins
	n t,v
	i $g(noindex) QUIT 1 // PVA242
	i info QUIT 0 // since view's not streamed during info compile, no validations possible
	s t=$e($g($$$mtV(lv))) // QUIT:t'="t"&(t'="f")&(t'="x") 1
	s v=$g($$$mtV(rv)),t=$e(v) // QUIT:t'="t"&(t'="f")&(t'="x") 1
	QUIT:t="f"&&($p(v,"^",4)["->") 1
	QUIT 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	// Handle IS [NOT] NULL and IS [NOT] JSON
null	new nsav
	set nsav=$g(negate)
	new negate
	set negate=nsav
	set:$$checkid("NOT") negate='negate
	if $$checkid("JSON") {
		new predtype,op
		set predtype=""
		if $$anyid(" ARRAY OBJECT SCALAR VALUE ",.op) { set predtype="*"_$e(op) }
		do putlog("v^"_$s(negate:"'",1:"")_"JSON"_predtype_"^^"_val_"^")
		QUIT
	}
	do skipid("NULL"),putlog("v^"_$s(negate:"'",1:"")_"NULL^^"_val_"^")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
patrn	;  <pttrn> ::= %PATTERN <const>
	n nsav s nsav=$g(negate) n negate s negate=nsav
	d scalx^%qaqpslx()
	d putlog("v^%PATTERN^^"_val1_"^"_val_"^")
	d:negate putlog("l^'^^"_val_"^")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF090
btwen
	i 'negate
	{	d scalx^%qaqpslx(),putlog("v^'<^^"_val1_"^"_val_"^") s val2=val
		d skipid("AND"),scalx^%qaqpslx(),putlog("v^'>^^"_val1_"^"_val_"^"),putlog("l^&^^"_val2_"^"_val_"^")
	}
	else	; deMorganize
	{	d scalx^%qaqpslx(),putlog("v^<^^"_val1_"^"_val_"^") s val2=val
		d skipid("AND"),scalx^%qaqpslx(),putlog("v^>^^"_val1_"^"_val_"^"),putlog("l^!^^"_val2_"^"_val_"^")
	}
	#; JLF090-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK412
l2p	;  <like> ::= <scalx> [ NOT ] LIKE <scalx> [ ESCAPE <scalx> ]
	n arg,esc,ft,pat,sw,tlog
	d scalx^%qaqpslx()
	s arg=val,esc=""
	i $$checkid("ESCAPE") d scalx^%qaqpslx() s esc=val
.
	i ($g($$$mtDSNConnection)'="")||($g($$$mtDSNLinkedTable(m))'="")||$d($$$QueryBlockContainsFTs(m)) {
		//Don't rewrite LIKE clauses for external queries
		d putlog("v^LIKE^^"_val1_"^"_arg_"^"_$s(esc:esc_"^",1:"")) QUIT
	}
	#;  if not constants, must evaluate at run-time:
	#;      %PATTERN(val1,%L2PAT(arg[,esc])) AND %STARTSWITH(val1,%L2SW(arg[,esc]))
	#; AK653
#define Const(%v) ($$$mtVType($$$mtV(%v))="t")
	if $$$Const(arg)&&(esc=""||$$$Const(esc)) {
	#;  arguments are constant, so some conversion may occur at compile-time
	#;  get the effective prefix and the rest of the pattern
	n n s pat=$e($$$mtV(arg),3,*),sw=$$l2sw(pat,$e($g($$$mtV(+esc)),3),.n),pat=$e(pat,n,*)
	#;  if no wildcards, maybe replace LIKE with equality or %STARTSWITH
	i "%"[pat s $$$mtV(arg)="t^"_sw s:esc $$$mtVType($$$mtV(esc))="i^t" d putlog($s(pat="":"v^=^^",1:"v^%STARTSWITH^^")_val1_"^"_arg_"^") QUIT
	i sw="" n negate s negate=1  ;  hint to prevent useless %SW below
	}
	s:esc esc=esc_"^"
	d putlog("v^%PATTERN^^"_val1_"^"_$$newval("v^%L2PAT^^"_arg_"^"_esc)_"^")
	#;  record in ptlikeimp which %PATTERN logs implied a %STARTSWITH -
	#;  because of selectivity dependence, for use in GetSel^%qaqomul  ;  PVA034
	#;  but not if under negation  ;  JLF090
    #; PVA242: don't bother adding startswith if noindex
	if 'negate&&'noindex s $bit(ptlikeimp,val)=1 d putlog("l^&^^"_val_"^"_$$newlog("v^%STARTSWITH^^"_val1_"^"_$$newval("v^%L2SW^^"_arg_"^"_esc)_"^")_"^")
	#; AK653-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
l2pat(s,e) n p,q,n,c s p="",q=""  ;  convert LIKE argument s [ and ESCAPCE e ]
	#;  into a COS pattern argument - used only for constant s [ and e ]
	f n=1:1 s c=$e(s,n) q:c=""  d
	. i "_%"[c s p=p_q_$s(c="%":".E",1:"1E"),q="" QUIT
	. s:c=e n=n+1,c=$e(s,n) s p=p_$s(q="":"1""",1:"")_$s(c="""":"""""",1:c),q=""""
	QUIT p_q
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
l2sw(s,e,n) n p,c s p=""  ;  convert LIKE argument s [ and ESCAPCE e ]
	#;       into a %STARTSWITH argument
	#;       also return in .n (by ref) position in s where stopped  ;  AK653
	f n=1:1 s c=$e(s,n) q:"_%"[c  s:c=e n=n+1,c=$e(s,n) s p=p_c
	QUIT p
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK412-
.
matches	;  <matches> ::= <scalx> [ NOT ] MATCHES <scalx> [ ESCAPE <scalx> ]	// DPV3541=
#define Const(%v) ($$$mtVType($$$mtV(%v))="t")
	new arg,esc,pat,sw,tlog
	do scalx^%qaqpslx()
	set arg=val,esc=""
	if $$check("ESCAPE") do scalx^%qaqpslx() set esc=val
		#;  if not constants, must evaluate at run-time:
		#;      %MATCHES(val1,%MATCHES2PAT(arg[,esc])) AND %STARTSWITH(val1,%MATCHES2SW(arg[,esc]))
	if $$$Const(arg)&&(esc=""||$$$Const(esc)) {
			#;  arguments are constant, so some conversion may occur at compile-time
			#;  get the effective prefix and the rest of the pattern
		new n 
		set pat=$e($$$mtV(arg),3,*),sw=$$matches2sw(pat,$e($g($$$mtV(+esc)),3),.n),pat=$e(pat,n,*)
			#; If VAL %MATCHES '*', treat the same as VAL IS NOT NULL
		if pat="*",sw="" d putlog("v^'NULL^"_$s($$$mtVType($$$mtV(val1))="f":","_val1_",",1:$p($$$mtV(val1),"^",3))_"^"_val1_"^") QUIT  ;  (putlog resets val!)
			#;  if no wildcards (remaining pattern is "*" or ""), maybe replace %MATCHES with equality or %STARTSWITH
		if "*"[pat set $$$mtV(arg)="t^"_sw set:esc $$$mtVType($$$mtV(esc))="i^t" do putlog($s(pat="":"v^=^^",1:"v^%STARTSWITH^^")_val1_"^"_arg_"^") QUIT
		if sw="" new negate set negate=1	//  hint to prevent useless %SW below
	}
	set:esc esc=esc_"^"
	do putlog("v^%MATCHES^^"_val1_"^"_$$newval("v^%MATCHES2PAT^^"_arg_"^"_esc)_"^")
		#;  record in ptlikeimp which %MATCHES logs implied a %STARTSWITH -
		#;  because of selectivity dependence, for use in GetSel^%qaqomul  ;  PVA034
		#;  but not if under negation  ;  JLF090
    #; PVA242: don't bother adding startswith if noindex
	if 'negate&&'noindex set $bit(ptlikeimp,val)=1 do putlog("l^&^^"_val_"^"_$$newlog("v^%STARTSWITH^^"_val1_"^"_$$newval("v^%MATCHES2SW^^"_arg_"^"_esc)_"^")_"^")
	QUIT
.
	#;  convert %MATCHES argument pString [ and ESCAPCE pEsc ] into a %STARTSWITH argument
	#;  also return in .pCnt (by ref) position in pString where stopped
matches2sw(pString,pEsc,pCnt) [] PUBLIC {
	#dim tChar,tReturn As %String
	set tReturn="" set:pEsc="" pEsc="\"
	for pCnt=1:1 {
		set tChar=$e(pString,pCnt) quit:"?*["[tChar  
		set:tChar=pEsc pCnt=pCnt+1,tChar=$extract(pString,pCnt)
		set tReturn=tReturn_tChar
	}
	QUIT tReturn
}
.
	#; JLF139
    #; PVA232: optional second argument for selectivity hint
inlist
	#; [NOT] %INLIST <listValuedExp> [ SIZE  {(} <const> {)} ]
	#; //expects a value expression that returns a $list
	#;
 ; JSL5032 variables
 ; bl - beginning line
 ; bbt - beginning of token on beginning line
 ; el - end line for variable (a host variable can span multiple lines)
 ; eet - end of token on end line
 ; t1 - dummy temp variable
 new bl, bbt, el, ebt, eet,t1,btel, pop ; JSL5032, JSL7071
.
 new rtpchostvar,isSize ; $$$mtV(rtpchostvar) is the list variable or expression in %INLIST
 n pnum s pnum=0
 
 Set isSize = 0
 
 Set pop="%INLIST"
 d scalx^%qaqpslx()
 d putval("v^SET:LIST^,^"_val_"^")
 
 do marktoken^%qaqpslx(lineprev,f,pprev,.bl,.bbt,.t1) ; JSL5032, JSL5078, JSL5139
 if $$checkid("SIZE") 
 {  
 	Set isSize=1 ; JSL5032	
 	s val2=val
    while $$check("(") {if $i(pnum)}
    d size($g(rtpchostvar)) ; JSL5032, handle negative size now that inlist can have a negative size as a hint to optimizer
    while pnum { d skip(")") s pnum=pnum-1 }  
    d putlog("v^INSET^^"_val1_"^"_val2_"^"_val_"^")
    #;do marktoken^%qaqpslx(lineprev,fsave,pprev,.el,.t1,.eet) // JSL5032, JSL5078
    do marktoken^%qaqpslx(lineprev,fsave,pprev,.el,.btel,.eet) // JSL5180
    if $g(rtpchostvar) set rtpc("inlist",rtpchostvar) = $g(rtpc("inlist",rtpchostvar))_$LB(bl, bbt, el, eet) ; val is set by putval in %qaqlexl.inc, JSL5032
	if $$$RTPCGLOBSETTING,'$g(mt("noruntime")) { //JSL5180, make sure -1 is set
		 // use $$$mtV(-1) which is never set, as special place to allow calculation of start and finish of inline
	 	Set rtpc("varmap",-1,bl, bbt) = $LB(el,eet,op,btel) ; val1 is set by putval in %qaqlexl.inc, JSL5032
		Set rtpc("varposmap",bl,bbt)=-1 ; JSL5139
	}
.
 }
 else {
	 Set:$g(rtpchostvar) rtpc("inlist",rtpchostvar)=$LB("","","","","")
	 do marktoken^%qaqpslx(lineprev,fsave,pprev,.el,.btel,.eet) ; JSL5139
	 d putlog("v^INSET^^"_val1_"^"_val_"^")
	 if $$$RTPCGLOBSETTING,'$g(mt("noruntime")) { 
	 	// use $$$mtV(-1) which is never set, as special place to allow calculation of start and finish of inline
	 	Set rtpc("varmap",-1,bl, bbt) = $LB(el,eet,op,btel) ; val1 is set by putval in %qaqlexl.inc, JSL5032
		Set rtpc("varposmap",bl,bbt)=-1 ; JSL5139
    }
 }
 d not:negate 
 QUIT
	#; JLF139-
in	;  in  ::=  ( <query> | <LIST,const> )
	d skip("(")
	  #;  MRP121  Parse [NOT] IN to [NOT] FOR SOME  ;  MRP154 'opsome' local now
	#; JLF015+
	if ($g(anyofVal) && (token="SELECT")) { d error(12) QUIT }	// term expected
	#; DPV1887=
	n query,rtpcquery s query=(token="SELECT")
	i token="(" {	// Might be subquery or might be beginning of scalar expression
		n holdvals d holdcur^%qaqpsl2(.holdvals)
		f  q:'$$check("(")  	// skip all "("
		#; JLF015=
		i '$g(anyofVal),$$check("SELECT") s query=1
		d setold^%qaqpsl2(.holdvals)	// DPV2038 (pass by reference)
	}
	#; PVA050: Add new arg to query to distinguish containment in FROM clause from other cases.
	#; JLF090=
	i query { 
		d query^%qaqpsq(m,1,m),
		skip(")"),
		opsome("=","SOME",val) 
		QUIT 
	}
	new pop ; JSL5073
	Set pop="IN" ; JSL5073
	f  { 
		d scalx^%qaqpslx() 
		s val1=val1_"^"_val 
		// JSL5071 - subscripts to varmap because a host variable can appear more than once
		q:'$$check(",")  ;  AK234
	}
	d skip(")")
	#;  if only one item, just use =
	#; JLF090=
	i $l(val1,"^")=2  {
		d putlog("v^"_$s(negate:"'",1:"")_"=^^"_val1_"^")
		QUIT
	}
	d putlog("v^IN^^"_val1_"^")
	if $p($$$mtV($p(val1,"^",1)),"^",2)["%ANYOF" d complexlog^%qaqpnl(m,val)
	d not:negate
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
not	d putlog("l^'^^"_val_"^")
	QUIT
	#; PVA183: create top1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
top1(qn)  ; Assert top(1) for existential queries
    new val // ensure no side effect
	#; This will have little effect until changes are made in set up for optimizer and optimizer
	#;   to decouple 'time to first row' optimizations from 'special predicate' optimizations
	#;   for TOP ... ORDER BY. 	
	kill $$$mtSequencersQb(qn) // order never matters for EXISTS
	set:'$d($$$mtTopArg(qn)) $$$mtTopArg(qn)=$$newval("t^1"), $$$mtTopPreoptHint(qn)=1, $$$mtTopStyle(qn)="TOP"
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
xists	;  <xists> ::= EXISTS ( <subq> )
	#; PVA050: Add new arg to query to distinguish containment in FROM clause from other cases.
	d skip("("),query^%qaqpsq(m,0,m),skip(")")
	n un1,unj
	s un1=$p($$$mtV(val),"^",2)  ;  q#
	d noutput(un1)  ;  No select list allowed/needed
	d top1(un1) // PVA183: assert TOP 1
	f unj=un1+1:1:$$$mtPNumQbs if $g($$$mtUnionTopQb(unj))=un1 {d noutput(unj),top1(unj)}
	d unflat(un1)
	d putlog("v^FOR SOME^^"_val_"^")  ; Parse EXISTS into FOR SOME...
	#; JLF090
	s val=$$$maxl
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
opsome(op,val2,qval)  ;  transforms  "val1 op ANY (qval : SELECT x ...)"  to
	#;          "EXISTS (qval : SELECT * ... AND     (supq.val1 op x))"
	#;                      and  "val1 op ALL (qval : SELECT x ...)"  to
	#;      "NOT EXISTS (qval : SELECT * ... AND NOT (supq.val1 op x))"
	#;  val1 - passed in implicitly - left side of comparison, moved
	#;         into the subquery as a correlated value
	#;  val  - returned implicitly
	n qnum,unj
	s qval=$$preserveRows(qval,m) // PVA183: If query has TOP, can't add predicate to it without
	                         #;   changing answer, so create another query layer
	                         #;   to apply condition outside of TOP. TRW: Ditto for Window functions
	s qnum=$p($$$mtV(qval),"^",2)
	#; AK630
	s val=val1  ;  "n" = correlated value from superquery
	s:"n"=$$$mtVType($$$mtV(val)) val=$p($$$mtV(val),"^",4)  ;  if itself correlated
	d:"tx"'[$$$mtVType($$$mtV(val)) putval("n^^^"_val_"^")  ;  but not for const/?
	#; AK630-
	#; JLF090
	s op="v^"_$s(((val2="ALL" && negate)||(val2'="ALL")):op,$e(op)="'":$e(op,2,$l(op)),1:"'"_op)_"^^"_val_"^"	; "supq.val1 op"
	d adcorr(qnum),top1(qnum) // PVA183: assert TOP 1 for existential queries
	#;  for UNION, apply to the whole UNION level (also flatten it!)
	f unj=qnum+1:1:$$$mtPNumQbs d:$g($$$mtUnionTopQb(unj))=qnum adcorr(unj),top1(unj)
	d unflat(qnum)
	#;  $p(5) used in cond^pre to call settemp, so that the (expr) val1
	#;      would get evaluated and set before calling the subquery qval
	d putlog("v^FOR SOME^^"_qval_"^"_val1_"^")
	#; JLF090
	if ((val2="ALL" && 'negate)||((val2'="ALL") && negate)) d not 
	QUIT
	#; PVA183: create pushtop
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	// wrap qval in another query layer if it has TOP or other constructs (window functions) that
	// require avoiding any changes to the original view "row production" from a new correlated condition
preserveRows(qval,supq,multiOutput=0) 
	new hasPagination,label,m,name,nm,ul,xqlbl
	QUIT:info qval // never want to stream a view for info compile
	s name=$p($$$mtV(qval),"^",2)
	#; check if name (or any union legs) have TOP
	if $$hasPagination^%qaqpsq(name) {
		set hasPagination=1
	} else {
		set hasPagination=0 
		kill $$$mtSequencersQb(name)
	}
	for ul=1:1:$l(mt("p")) {
		if $g($$$mtUnionTopQb(ul))=name {
			if $$hasPagination^%qaqpsq(ul) {
				set hasPagination=1
			} else { kill $$$mtSequencersQb(ul) }
		}
	}
	#; check if first result column depends on a window function
	n oval,haswindows,i
	if 'multiOutput{
		s oval = +$$$mtOutputVals($$$mtOutput(name))
		s haswindows = +$$windows^%qaqpagg(oval)
	} else {
		for i=1:1:($l($$$mtOutputVals($$$mtOutput(name)),",")-1){
			s oval = +$p($$$mtOutputVals($$$mtOutput(name)),",",i)
			s haswindows = +$$windows^%qaqpagg(oval)
			quit:haswindows
		}
	}
	if hasPagination||haswindows
	{  s $$$mtPActiveQbs=$$$mtPActiveQbs_1,m=$$$mtPNumQbs
	   s $$$mtP(m)=supq  
	   s $$$mtCorrParentQb(m)=supq ; corr must be same as syntax containment for quantified subq
	   s $p($$$mtP(name),"^")=m //PVA211
	   #; repoint and clean up any union legs
	   for ul=1:1:$$$mtPNumQbs 
	   {  if $g($$$mtUnionTopQb(ul))=name
	      {  s $p($$$mtP(ul),"^")=m 
	      }
	   }
	   // set up label,xqlbl for vstr
	   s nm="tsq"_$i(tsq)_"%",label=$li(%defschema)_"."_nm,xqlbl=$lb(nm,label,0)
	  
	   if 'multiOutput { 
	   		// set up view information for SELECT item of subquery (name)
	   		d addvinf^%qaqpslx(name,$p($$$mtOutputVals($$$mtOutput(name)),","),$li($$$mtAlphaUpAliases(name),1))
	   		// stream the view
	   		d vstr^%qaqpsq
	   		// make mt("o")
	   		s $$$mtOutput(m)="^"_$li(%viewinfo("vcols",name,$li($$$mtAlphaUpAliases(name),1)),2)
	   		s $$$mtAlphaUpAliases(m)=$li($$$mtAlphaUpAliases(name),1,1)
	   		d vptln^%qaqpslx(label,name,$li($$$mtAlphaUpAliases(name),1)) // need to set up ptln
	   } else {
			for i=1:1:($l($$$mtOutputVals($$$mtOutput(name)),",")-1){
				d addvinf^%qaqpslx(name,$p($$$mtOutputVals($$$mtOutput(name)),",",i),$li($$$mtAlphaUpAliases(name),i))
			}  
			d vstr^%qaqpsq 
			for i=1:1:($l($$$mtOutputVals($$$mtOutput(name)),",")-1){
				s $$$mtOutput(m)=$g($$$mtOutput(m))_$li(%viewinfo("vcols",name,$li($$$mtAlphaUpAliases(name),i)),2)_","
	   			s $$$mtAlphaUpAliases(m)=$li($$$mtAlphaUpAliases(name),i)
			}
			s $$$mtAlphaUpAliases(m)=$$$mtAlphaUpAliases(name)
			s $$$mtOutput(m)="^"_$$$mtOutput(m)
	   }
	   d putval("q^"_m)
	   s qval=val
	   s $p($$$mtP(m),"^",2,4)=val_"^^"  
	   d unflat(name) // here since opsome won't find the union
	}
	QUIT qval
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK390
adcorr(m)  ;  move " [ NOT ] (supq.val1 op SELECT-list)" into subquery m
	#; AK755
	n selit s selit=+$$$mtOutputVals($$$mtOutput(m))
	d putlog(op_selit_"^")
	#; AK755-
	d noutput(m)  ;  Select list not needed anymore
	#; JLF078
	#; JLF090
	if ((val2="ALL" && 'negate)||((val2'="ALL") && negate))
	{
		n nulllog,corrlog,toplog s corrlog=val
		d putlog("v^NULL^^"_$$$mtLOperand1($$$mtL(corrlog))_"^") s nulllog=val
		d putlog("v^NULL^^"_$$$mtLOperand2($$$mtL(corrlog))_"^")
		d putlog("l^!^^"_nulllog_"^"_val_"^")
		d putlog("l^!^^"_corrlog_"^"_val_"^")
	}
	#; JLF090-
	#; AK755
	d andwhav(val,m,$s($$$mtPAggList($$$mtP(m))="":"w",","_$g($$$mtGroupDistinctList(m))[(","_selit_","):"w",1:"h"))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
noutput(m)  ;  remove SELECT-list of query m
	s $$$mtOutput(m)="^",$$$mtAlphaUpAliases(m)=""
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
unflat(m) n unum,un2  ;  flatten the whole UNION level to a single UNION
	#;  Assert:  by now they should all already have m as untop,
	#;           and all should have the same supq as m
	f unum=1:1 s un2=+$lg($g($$$mtUnion(m)),unum) q:'un2  s $li($$$mtUnion(m),unum,unum)=$li($$$mtUnion(m),unum,unum)_$g($$$mtUnion(un2)) k $$$mtUnion(un2)
	#; PVA183: suppress all duplicate elmination; don't care for existential condition
	for i=1:1:$ll($g($$$mtUnion(m))) s $li($$$mtUnion(m),i)=+$li($$$mtUnion(m),i)_"a"
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
andwhav(val,m,hw) n old  ;  AND condition val to the WHERE/HAVING clause
	#;  (if hw="w"/"h") of query m
	QUIT:'val  ;  nothing to do
	s old=$g(mt(hw,m))  ;  might be nothing there
	d:old putlog("l^&^^"_old_"^"_val_"^")
	s mt(hw,m)=val
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK390-
	#;  Parse FOR expression...
forex(supq)  ;  <forex> ::= <quant> tables [ <forcnd> ]
	#; <quant> ::= SOME | ALL
	#; tables  ::= frmit { , frmit }
	n m,val1,op,where,levag,laggs
	#; JLF090
	n nsav s nsav=$g(negate) n negate s negate=nsav
	#; DPV1284
	i '$$any(" SOME ",.op) d error(16) // PVA176: Disable ALL until we want to make it really work
	#;  $$$mtPActiveQbs is a string of 1's, $E(,m)=0 if subquery obsolete
	s where=0,levag=0,laggs="",$$$mtPActiveQbs=$$$mtPActiveQbs_1,m=$$$mtPNumQbs
	s $$$mtP(m)=supq  ; Make sure the first part is here for 'colmn+6' check of parent query...
	s $$$mtCorrParentQb(m)=supq // PVA137
	#; JLF015
	n elementof s elementof=""
	if ($$checkid("%ELEMENT") || (op="ALL" && $$checkid("%ELEMENTS")))
	{ s elementof=1
	  do skip("(") do colmn^%qaqpsl2
	  s v=$g($$$mtV(val)) // assert ($e(v)="n")
	  
	  #; check if it is multi-valued: do:'$$$smdIsMultiValued($p(v,"^",2), $p(v,"^",3)) error(116)
	  #; n irn,ifn,pkgdotcls,methname s irn=$$$mtRQb($$$mtR($p($$$mtV(val),"^",2))),ifn=$p($$$mtV(val),"^",3)
	  #; s pkgdotcls=$$$smdClassname($$$smdTType(irn),irn),methname=$$$smdColPropertyName($$$smdTType(irn),irn,ifn)_"BuildValueArray"
	  #; if '('$$$comMemberKeyGet(pkgdotcls,$$$cCLASSmethod,methname,$$$cMETHstub) &&
	  #;       $$$comMemberKeyGet(pkgdotcls,$$$cCLASSmethod,methname,$$$cMETHrunnable))
	  #; { d error(116) }
	  
	  do skip(")") s seln=1 do as^%qaqpslx
	  s label = $p($$$mtV($p(v,"^",4)),"^",3)_"."_$p($$$mtV($p(v,"^",4)),"^",4)
	  s $$$mtForSomeElementTarget($li($$$mtAlphaUpAliases(m)))=val
	  s $$$mtQbHasForSomeElement(m)=""
	  s $$$mtFromTableName(m_"^"_label)=name  ; Record General View Table
	  s $$$mtFLabels(m,$li($$$mtAlphaUpAliases(m)),m_"^"_label)=$lb(name,$li($$$mtAlphaUpAliases(m))]"")
	  s $$$mtFromList(m)=$g($$$mtFromList(m))_$lb(label)
	} 
	else 
	{ do skip("("),tables^%qaqpsq,skip(")"),top1(m) } // PVA183: Assert TOP 1 for existential queries
	#; JLF015-
	#; JLF127
	#; FOR ALL negates both the inner and the outer query block: NOT FOR ALL () => NOT FOR SOME NOT()
	if op="ALL" { s negate=1 } else { s negate=0 }
	#; JLF127-
	d:token="("!(op="ALL") forcnd
	d putval("q^"_m)
	s $p($$$mtP(m),"^",2,4)=val_"^"_laggs_"^"
	#; JLF015
	d putlog("v^FOR SOME"_$s(elementof:" ELEMENT",1:"")_"^^"_val_"^")
	d complexlog^%qaqpnl(m,val)
	#; JLF015-
	#; JLF090
	s negate=nsav	; restore to state prior to parsing the FOR SOME
	d:(((op="ALL")&&'negate)||((op'="ALL")&&negate)) not
	#; JLF090-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
forcnd	;  <forcnd> ::= ( [ <prdct> ] [ GROUP BY <LIST,colmn> ] 
	#;    [ HAVING <prdct> ] )  - NOTE: [ <prdct> ] 
	#;    and/or [ HAVING <prdct> ] must be chosen...
	#;---------- <prdct> Clause, GROUP BY Clause, HAVING Clause
	d skip("("),where^%qaqpslx:",GROUP,HAVING,"'[(","_token_","),group^%qaqpslx:$$check("GROUP"),having^%qaqpslx:$$check("HAVING")
	#;-------------------- further processing --------------------
	i '$g($$$mtWhere(m)),'$g($$$mtHaving(m)) d error(17)
	d skip(")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
var	;  host variable
	; JSL5024 variables
	; bl - beginning line
	; bbt - beginning of token on beginning line
	; el - end line for variable (a host variable can span multiple lines)
	; eet - end of token on end line
	; t1 - dummy temp variable
	; btel - beginning of token on end of line
	; query, set by tag in, if query is 1 in a allowed RTPC comparison, then RTPC transformation will not take place
	// Called from:
	//   call^%qaqpDDLParser2 for argument to USING
	//   term^%qaqpslx for ? or :var
	//   varcon^%qaqpslx
	//   coltrun^%qaqpslx (length specification for collation function)
	new bl, bbt,btel,el,ebt,eet,name,op,t1 ; JSL5024, JSL7071
	#; AK405
		#;  if external table, keep host-variable location info
	Set op=$s($g(pop)'="":pop,1:prevtoken) ; JSL7071
	if callname'="recount" && ($$$mtStatementType="CRV"||($$$mtStatementType="ALV")||(callname["view")) { do error(148) }
	if extab { d mark^%qaqpslx s mt("hvloc")=$g(mt("hvloc"))_$LB("*",value,l1,m1) }
	do marktoken^%qaqpslx(line,f,pprev,.bl,.bbt,.t1) ; JSL5024
	set name=$$varname()
	// These statements do not allow ? parameters. Easiest to just check if mt("ddl") is set for ddl commands
	if name="?" && ($d(mt("ddl")) || $lf($lb("CRT", "GRA", "REV", "SET", "SET TP", "SET ML", "LOAD", "LCK", "TUN", "PURGE", "FREEZE", "UNFREEZE"),$$$mtStatementType)) {
		do error(158)
	}
	// If the variable is already parsed and mapped, retrieve instead of creating a new mt("v") entry
	do mark^%qaqpslx
	if '$d($$$mtRecordParams(l1*100000+m1),val) { do putval("x^"_name) } ;  AK178;AK234;YWH015
	else {set logic=0} // we set logic in putval ;YWH015
	do marktoken^%qaqpslx(lineprev,fsave,pprev,.el,.btel,.eet) ; JSL5024
	// JSL7071 - a host var can appear more than once in the same SQL statement
	// JSL5078 - only record values in varmap and varposmap if noruntime
	if $$$RTPCGLOBSETTING,'$g(mt("noruntime")),bl>0 { // JSL5078
		Set rtpc("varmap",val,bl, bbt) = $LB(el,eet,op,btel) ; val1 is set by putval in %qaqlexl.inc, JSL5032
		Set rtpc("varposmap",bl,bbt)=val ; JSL5071
		Set rtpchostvar=val
	}
		#; %inwerop is defined in werop^%qaqpsq1 to signal we are in the WHERE clause of an UPDATE statement
	if $g(%sqlHVarTypes),($data(mtc(0,0,"inssel"))||$case($$$mtStatementType,"INS":0,"UPD":''$g(%inwerop),:1)) {
		new len,varType
		set varType=$$paramType(+$p(name,"(",2),.len)
		if $g(varType)'="" {
			do create^%qaqpdt(val,"var",varType,,,,name) 
			if info {
				if $d(len) { set $$$VTRomsinfo(val)=$$definfo^%qaqpif2(varType,len,len) }
				elseif varType="%Library.Numeric" { set $$$VTRomsinfo(val)=$$definfo^%qaqpif2(varType,38,36,17),$$$VTRscale(val)=17 }	// DPV3198 (len 20, prec, 18, scale 9)
				else { set $$$VTRomsinfo(val)=$$definfo^%qaqpif2(varType) }
			}
		}
	}
	// record the beginning position of host variable
	// line number l1 and position number m1 (sometimes recorded as f during parsing) comes from mark^%qaqpslx
	// code also in cte^%qaqpsq1 for CTE parameters
	do mark^%qaqpslx set $$$mtRecordParams(l1*100000+m1)=val  ;  sort them by location
		#;  if external table, keep host-variable location info
	if extab { set mt("hvloc")=mt("hvloc")_$LB(val,l1,m1) }
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	// called from var
varname() ;  $$:  return the variable name, including subscripts
	new name
	QUIT:$$check("?") "?"  ;  dynamic variable
	set name=value 
	do lext
	QUIT:token=$c(1) name
	new savedelid set savedelid=%delid new %delid set %delid=savedelid
	if name="i"&&($e(lower)="%") || (name="r"&&($e(lower)="%")) { 	// Support i%prop/r%prop	// DPV2162 (qstruct)
		if lower="%" {  // may be %prop name or delimited property name
			do lext
			if '$zname(lower,6) { set name=name_"%"_$$$SQLquoter(lower)_"" } else { set name=name_"%"_lower }
		}
		else {
			if '$zname(lower,6) { set name=name_""""_lower_"""" } else { set name=name_lower }
		}
		do lext
		if token="(" {  // Multidimentional property i%prop(...)
			set %delid=0
			do skip("(")
			set name=name_"("
			for  { 
				do sub^%qaqpsq1 
				set name=name_token
				if token=")" { set %delid=savedelid do skip(")") quit }
				do skip(",")
			}
		}
		set name=$$DotSyn^%qarmac(name,.qstruct,,,1,1)  ; Pass '1' to ignore class context as this can be parsing SQL code that will be generated into cached class and not inserted here directly
		QUIT name
	}
	elseif token="." { // Support oref.prop[.prop2...]	// DPV1892=
		for  { 
			quit:token'="."  
			set name=name_"."
			do skip(".") if token=$c(1) { set t="<Property Name>" do error(1) }	// DPV2939=
			if '$zname(lower,6) { set name=name_$$$SQLquoter(lower) } else { set name=name_lower }
			do lext
			if token="(" {  // Multidimentional property oper.prop(...)
				set %delid=0
				do skip("(")
				set name=name_"("
				for  { 
					do sub^%qaqpsq1 
					set name=name_token
					if token=")" { set %delid=savedelid do skip(")") quit }
					do skip(",")
				}
				quit
			}
		}
		QUIT name
	}
	if token'="(" { QUIT:'$$check("(") name }  //  host var, no subscripts
	set %delid=0
	do skip("(")
	set name=name_"("  ;  build the subscripts  ;  AK178
	for  {
		do sub^%qaqpsq1
		set name=name_token
		if token=")" { set %delid=savedelid do skip(")") quit }
		do skip(",")
	}
	QUIT name
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
paramType(entry,len) [mt] PUBLIC {
		#; This function will return the param type information from the $$$SQLCompileOption("xDBCVarTypes")
		#; $$$SQLCompileOption("xDBCVarTypes") is defined as a comma-list of types for parameters from literal replacements on the client.
		#;  The each type is one of:
		#;     CAST_CHAR32 = 1
		#;     CAST_CHAR128 = 2
		#;     CAST_CHAR512 = 3
		#;     CAST_CHAR = 4
		#;     CAST_INT = 10
		#;     CAST_NUM = 11
		#; 
	RETURN:$$$SQLCompileOption("xDBCVarTypes")="" ""
	set datatype=$p($$$SQLCompileOption("xDBCVarTypes"),",",entry)
	if datatype=1 { set datatype="%Library.String",len=32 RETURN datatype }
	if datatype=2 { set datatype="%Library.String",len=128 RETURN datatype }
	if datatype=3 { set datatype="%Library.String",len=512 RETURN datatype }
	if datatype=4 { set datatype="%Library.String",len=4096	RETURN datatype }
	if datatype=10 { set datatype="%Library.Integer" RETURN datatype }
	if datatype=11 { set datatype="%Library.Numeric" RETURN datatype }
	RETURN ""
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK405-
xtfun	;  extrinsic function:  xtfun  ::=  xcall  [  scalx {  , scalx  }  ]
	If $$$SQLCompileOption("xDBC")=1||($$$SQLCompileOption("DynamicSQL")=1) {	// DPV1743+
		#; JMM996:Shard map screening during rebalancing uses a reserved extrinsic function name 
		#; in shard-local queries, which is always allowed.
		If '$$$AllowExtrinsicFunctions && '($e(value,1,17)=$$$SSShardMapScreenExtFunc) { // JMM996+
			d error(372)
		} // JMM996-
	}
	If $e($p(value,"^",2))="|",$e($$$LastPiece($p($p(value,"^",2),"("),"|"))="%" d error(373)	// DPV2468=
	If $e($p(value,"^",2))="%" d error(373)	// DPV1743-
	s op=value_"," d lext
	i '$$check(")") f  d scalx^%qaqpslx() s op=op_val_"," i '$$check(",") d skip(")") q  ;  AK234
	d putval("e^^^"_$p(op,",",2,*)_"^"_$p(op,","))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
size(rtpchostvar="")
	if token="-" {
		d skip("-") ; JSL5032
		d putval("t^"_(-value)) ; JSL5032
	} else {
		d putval("t^"_value)
	}
	Set:rtpchostvar rtpc("inlist",rtpchostvar)=$LB(value) ; JSL5032
	d skip(9) ; constant
	QUIT
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#INCLUDE %qaqplex
#INCLUDE %quoter
---
