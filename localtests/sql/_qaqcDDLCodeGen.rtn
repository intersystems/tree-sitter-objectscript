			$$$liin("set %mmmsc = $$ConvertStoragetype^%apiDDL("_$$quoter($$$tname(tab))_","_$$quoter($p($$$tConversionType(tab),$c(1),2))_","_$$quoter($$$tConversionColumns(tab))_","_$s($$$tdeldata(tab)="%NODELDATA":1, 1:0)_", .SQLCODE)")	
