.
			$$$liin("set %mmmsc=$$convertToSharded^%SYS.SHARDSRV("_$$quoter(tab)_","_$$quoter($$$tShardKey(tab))_","_$$quoter($$$tShardReference(tab))_","_'+$$$tConvertDefer(tab)_",0)")
		}
		elseif $p($$$tConversionType(tab),$c(1))="STORAGETYPE" {
