					$$$liin(". i %mmmoch n %msgsave s %msgsave=$g(%msg),%mmmclist=2 d compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) s %msg=$g(%msgsave)")
