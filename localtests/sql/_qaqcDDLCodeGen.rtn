					}
				}
				if clearPrefix {
					set prefixList=""
				}
				else {
					set prefixList=prefixList_")"
				}
			}
			else {
				set prefixList=""
			}
			set partitionSpec=partitionSpec_prefixList
			
			if start'="" {
