createaggregate(handle)
	do initag
		#;    call:  CreateAggregate(udafSchema,udafFunction,replace,initfunction,iterfunction,mergefunction,finalfuntion,returntype,parameters,&SQLCODE,%msg)
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin($c(9)_"TSTART")
	$$$liin($c(9)_"try {")
	$$$liin($c(9,9)_"set SQLCODE=0")
	$$$liin($c(9,9)_"do CreateAggregate^%apiDDL("_$$quoter($$$UDAFSchema(handle))_","_$$quoter($$$UDAFName(handle))_","_$$$UDAFreplace(handle)_","_$$quoter($$$UDAFInitFunc(handle))_","_$$quoter($$$UDAFIterFunc(handle))_","_$$quoter($$$UDAFMergeFunc(handle))_","_$$quoter($$$UDAFFinalFunc(handle))_","_$$quoter($$$UDAFReturnType(handle))_","_$$quoter($$$UDAFParams(handle))_",.SQLCODE,.%msg)")
	$$$liin($c(9)_"} catch { set SQLCODE=-400,%msg=""Unexpected error executing CREATE AGGREGATE: ""_$ze }")
	$$$liin($c(9)_"if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin($c(9)_"RETURN")
	RETURN
.
