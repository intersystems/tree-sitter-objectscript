space(x) ;  $$: make sure continuation lines start with space
	f  q:$e(x)'=" "  s x=$e(x,2,*)  ;  remove extra spaces prefix
	s x=" "_x QUIT x
 
 
RecomposeList(list) [] PRIVATE {
	    #; Given a $List string, return a $lb(...) command to recreate it
	  QUIT:$g(list)="" ""  ; No list, empty string
	  s retval="$lb("
	  f i=1:1:$ll(list) s t=$lg(list,i),retval=retval_$s(t="":"",t=+t:t,1:$$quoter(t))_","
	  s $e(retval,$l(retval))=")" ; replace last comma with )
	  QUIT retval
	}
.
#IF 0	; DPV2350+
setuser	; Code generation for SETUSER <username>	// DPV2126=
	#;  DPV2198**** What to do??? ***
	n i,line,lines,tag d initag  ;  initialize code generation
	$$$liin("n %mmmold s %mmmold=$g(%msql) s SQLCODE=0,%msql="_$$quoter(mt("user")))
	$$$liin("i '$d(^%SYS(""sql"",""users"",""name"",$zcvt(%msql,""U""))) s SQLCODE=-118,%msg=""No such user ""_%msql,%msql=%mmmold q")
	$$$liin("s %msql=$o(^%SYS(""sql"",""users"",""name"",$zcvt(%msql,""U""),""""))")
	$$$liin("q")
	QUIT
#ENDIF	; DPV2350-
 
initag	;  initialize code generation and tags
	set mod=1,lines=0,line="",tag="",mtag=gtag_"o",tag=mtag
	RETURN
