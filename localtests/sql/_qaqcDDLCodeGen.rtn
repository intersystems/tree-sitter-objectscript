load ; Code generation for LOAD
	new bottom,classname,hasDeferred,line,lines,localhints,sharded,tag,tname
	do initag set bottom=mtag_"dun"
	#; Find out if we are loading Data or SQL
	if mtd("load","request").%IsDefined("sql") { 
        #; qualifiers = {
        #;  "dialect": "IRIS",   // or any of the other supported dialects *c
        #;  "separator": ";"     // does not automatically change based on dialect? *c
        #;  "log": "table",      // to write output to %SQL_Diag, other allowed value is "file"
        #;  "logFile": null,     // if "log"="file" or not set, this will make it write log to the specified file. *c
        #;                          // if "log"="file" and "logFile"=null or "", uses "_Errors.log" suffix
        #;  "extensions": ["sql"],  // array of file extensions to load. only for LoadSQLDir()
        #;  "recurse": 0,        // only for LoadSQLDir()
        #;  "verbose": 0,        // combines legacy echoMode and messageMode *O relevant to all work
        #;  "ignoreErrors": 1    // if 0, stop on first error *O can set this up through Import.cls I think
        #; }
		$$$liin("new %0IRISLoadData,%0IRISServer,%protocol,buildrset,commitmode,jflag,lflag,request,result,sc,statement,tflag,tstart")
		$$$liin("set SQLCODE=0,%ROWCOUNT=0")
		$$$liin("try {")
		$$$liin($c(9) _ "set statement= "_$$quoter(%normsql(1)))
		$$$liin($c(9) _ "set request = " _ $$$LoadRequestAsJSON)
		$$$liin($c(9) _ "set request.resultid = ##class(%SQL.Diag.Result).addDiagResult((request.sql.from.file.ignoreerrors'=1) && (request.sql.from.directory.ignoreerrors'=1))")
		$$$liin($c(9) _ "do ##class(%SQL.Diag.Result).updateStatement(request.resultid,.statement)")	// Put the statement into the request record before we being the LOAD
		set loadMethod = "LoadSQL", mtdData = mtd("load","request").sql.from.file, suffixArguments = ""
        if mtd("load","request").sql.from.file="" { set loadMethod = "LoadSQLDir", mtdData = mtd("load","request").sql.from.directory, suffixArguments = ",""extensions"":"""_mtdData.extensions_""",""recurse"":"""_mtdData.recurse_"""" }
        $$$liin($c(9) _ "set outStatus = $SYSTEM.SQL.Schema."_loadMethod_"("""_$SELECT(loadMethod = "LoadSQL":mtdData.file,loadMethod = "LoadSQLDir":mtdData.directory)_""",{""dialect"":"""_$SELECT(mtdData.dialect="":"IRIS",1:mtdData.dialect)_""",""separator"":"""_mtdData.delimiter_""",""log"":"""_$SELECT(mtdData.logtofile="":"table",1:"file")_""",""logFile"":"""_$REPLACE($CASE(mtdData.logtofile,"":"","1":"",:mtdData.logtofile),"\","\\")_""",""verbose"":"""_mtdData.verbose_""",""ignoreErrors"":"""_mtdData.ignoreerrors_""""_suffixArguments_",""resultid"": (request.resultid)},)")
		$$$liin($c(9) _ "if outStatus = 1 {")
		$$$liin($c(9,9) _ "do ##class(%SQL.Diag.Result).updateStatus(request.resultid,""Complete"")")
		$$$liin($c(9) _ "}")
		$$$liin($c(9) _ "else {")
		$$$liin($c(9,9) _ "do ##class(%SQL.Diag.Result).updateStatus(request.resultid,""Failed Imported SQL Statement"")")
		$$$liin($c(9,9) _ "do ##class(%SQL.Diag.Result).updateResult(request.resultid,,$listget($listget($extract(outStatus,3,*)),2,0))")
		$$$liin($c(9) _ "}")
		$$$liin($c(9) _ "set %ROWID=request.resultid")
		$$$liin("} catch {")
		$$$liin($c(9) _ "set SQLCODE = -400, %msg = ""Unexpected error executing LOAD SQL: "" _ $ze")
		$$$liin($c(9) _ "try {")
		$$$liin($c(9,9)_"do ##class(%SQL.Diag.Result).updateResult(request.resultid,"""",SQLCODE)")
		$$$liin($c(9,9)_"do ##class(%SQL.Diag.Result).updateStatus(request.resultid,""Failed"")")
		$$$liin($c(9)_"} catch{}")
		$$$liin("}")
		$$$liin("set SQLCODE=0")
	}
	else {
			#; Make sure the target class/table exists.  If it does, we report the error here at Prepare/Compile time
		set tname=mtd("load","request").data.into.table
		set classname=$$$GetClassNameFromIQN(tname)
		if classname="" { do error(30) }
		set sharded=$$$comClassKeyGet(classname,$$$cCLASSsharded)
		set hasDeferred=$$$SQLLocTableHasDeferred($g($$$EXTsqlinfo($$$rEXT,classname)))
.
		do InitDDLAMSInfo
		do generateSQLStartCode^%qaqcasl()
		$$$liin("new %0IRISLoadData,%0IRISServer,%protocol,buildrset,commitmode,jflag,lflag,request,result,sc,statement,tflag,tstart")
		$$$liin("set SQLCODE=0,%ROWCOUNT=0,commitmode=$zu(115,1),%0IRISLoadData=42")
		$$$liin("try {")
		set localhints=mtd("load","request").data.into.hints
		if hasDeferred,$l(localhints," ")=5 {	// 4 hints specified means LOAD BULK, mark this table as currently being bulk loaded
			$$$liin($c(9)_"set $li(^rINDEXEXT(""D"","_$$$quote(classname)_",-1E19),2)=1")
		}
		if localhints["%NOJOURN" {
				#; If %NOJOURN is specified, we turn off journalling and suspend transactions and set auto_commit=none
			$$$liin($c(9)_"set jflag=##class(%SYS.ProcessQuery).DisableJournalInt(),tflag=$zu(139,2) do $zu(115,1,0)")
			set mtd("load","request").data.into.hints=$replace(mtd("load","request").data.into.hints,"%NOJOURN","")	// so the INSERTs do not perform %NOJOURN
			if localhints'["%NOLOCK" {	// If %NOJOURN and not %NOLOCK, acquire a table level lock and then perform inserts without a lock
				$$$liin($c(9)_"set lflag=1 do ##class("_classname_").%SQLAcquireTableLock(0,.SQLCODE,$zu(115,4)) if SQLCODE<0 { set lflag=0,%msg=""Unable to acquire exclusive table-level lock for table '"_tname_"'"" goto "_bottom_" }")
				set mtd("load","request").data.into.hints=mtd("load","request").data.into.hints_" %NOLOCK "	// so the INSERTs do not perform locking
			}
		} elseif 'sharded {
				#; If AUTO_COMMIT_ON or AUTO_COMMIT_OFF and not in a transaction, start a transaction
			$$$liin($c(9)_"if $zu(115,1)=1||('$TLEVEL&&($zu(115,1)=2)) { TSTART "_" set tstart=1 }")
		}
		if $$$LoadChangeMapSelectability {
				#; We are doing LOAD BULK or LOAD %NOINDEX, set all the index maps to Not Selectable
			$$$liin($c(9)_"do SetAllIndexMapSelectability^%apiDDL("_$$quoter(tname)_",0,.SQLCODE,.%msg) quit:SQLCODE<0")
		}
		$$$liin($c(9) _ "set statement= "_$$quoter(%normsql(1)))
		$$$liin($c(9) _ "set statement= "_$$quoter(%normsql(1)))
		$$$liin($c(9) _ "set request = " _ $$$LoadRequestAsJSON)
		$$$liin($c(9) _ "set request.resultid = ##class(%SQL.Diag.Result).addDiagResult(request.data.using.maxerrors)")
		$$$liin($c(9) _ "do ##class(%SQL.Diag.Result).updateStatement(request.resultid,.statement)")	// Put the statement into the request record before we being the LOAD
		$$$liin($c(9) _ "set result = ##class(%SQL.Util.Loader).load(request)")
		$$$liin($c(9) _ "if $isobject(result) { set SQLCODE = +result.%SQLCODE, %msg = result.%Message, %ROWCOUNT = result.%ROWCOUNT, %ROWID = result.%ROWID  }")
		$$$liin($c(9) _ "do ##class(%SQL.Diag.Result).updateResult(request.resultid,%ROWCOUNT,SQLCODE)")
		$$$liin($c(9) _ "do ##class(%SQL.Diag.Result).updateStatus(request.resultid,""Complete"")")
		$$$liin($c(9) _ "set %ROWID=request.resultid")
		if $$$LoadBuildIndex {
				// tname was parsed originally by ParseIdentifer^%qaqpDDLParser, will be of the form schema.table and will be fully qualified!
			$$$liin($c(9)_"set buildrset=##class(%SQL.Statement).%ExecDirectNoPriv(,""BUILD INDEX %NOLOCK FOR TABLE " _ $$quoter2($p(tname, "."), 1)_"."_$$quoter2($p(tname, ".", 2), 1) _ """)")
			$$$liin($c(9)_"if $isobject(buildrset),buildrset.%SQLCODE<0 { ")
			$$$liin($c(9,9)_"set SQLCODE=+buildrset.%SQLCODE,%msg=buildrset.%Message")
			$$$liin($c(9,9)_"do ##class(%SQL.Diag.Result).addDiagMessage(request.resultid,""server"",SQLCODE, $$FormatText^%occMessages("_ $$quoter($$$Text("Failed BUILD INDEX: %1", "%SQL")) _", %msg), 3)")
			$$$liin($c(9)_"}")
			if $$$LoadChangeMapSelectability=1 {
				$$$liin($c(9)_"if SQLCODE>=0 { do SetAllIndexMapSelectability^%apiDDL("_$$quoter(tname)_",1,.SQLCODE,.%msg) }")
			}
		}
		$$$liin("} catch {")
		$$$liin($c(9) _ "set SQLCODE = -400, %msg = ""Unexpected error executing LOAD DATA: "" _ $ze")
		$$$liin($c(9) _ "do $zu(115,1,commitmode)")	// load() may have changed the commit mode, restore it
		$$$liin($c(9) _ "try {")
		$$$liin($c(9,9)_"do ##class(%SQL.Diag.Result).updateResult(request.resultid,"""",SQLCODE)")
		$$$liin($c(9,9)_"do ##class(%SQL.Diag.Result).updateStatus(request.resultid,""Failed"")")
		$$$liin($c(9)_"} catch{}")	// try to record the failure in the Result record
		$$$liin("}")
		set tag=bottom
		if hasDeferred,$l(localhints," ")=5 {	// 4 hints specified means LOAD BULK, mark this table as currently being bulk loaded
			$$$liin("try { set $li(^rINDEXEXT(""D"","_$$$quote(classname)_",-1E19),2)=0 } catch {}")	// Mark this class as not having a LOAD BULK DATA in progress
		}
		if localhints["%NOJOURN" {
			if localhints'["%NOLOCK" {	// If %NOJOURN and not %NOLOCK, release the table level lock
				$$$liin("if $g(lflag) { do ##class("_classname_").%SQLReleaseTableLock(0) }")
			}
			$$$liin("try { if $g(jflag) { do ##class(%SYS.ProcessQuery).EnableJournalInt() kill jflag } } catch { do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) }")
			$$$liin("try { if $d(tflag)#2 { do $zu(139,tflag) kill tflag } } catch { do SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) }")
			$$$liin("do $zu(115,1,commitmode)")	// restore commitmode
		} elseif 'sharded {
			$$$liin("if $zu(115,1)=1,$g(tstart) { TCOMMIT:SQLCODE'<0  TROLLBACK:SQLCODE<0 1 }")	// if AUTO_COMMIT_ON, end the Transaction
		}
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("RETURN")
	}
	RETURN
.
createSchema(schema) ; Code generation for CREATE SCHEMA
	new line,lines,tag
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("TSTART")
	$$$liin("set SQLCODE=0,%ROWCOUNT=0")
	$$$liin("try {")
	$$$liin($c(9)_"do CreateSchema^%apiDDL("""_schema_""","_$$$sifexists(schema)_",.SQLCODE,.%msg)")
	$$$liin("} catch {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error executing CREATE SCHEMA:""_$ze" )
	$$$liin("}")
	$$$liin("if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
.
dropSchema(schema) ; Code generation for DROP SCHEMA
	new line,lines,tag
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("set SQLCODE=0,%ROWCOUNT=0")
	$$$liin("try {")
	$$$liin($c(9)_"do DropSchema^%apiDDL("""_schema_""","_$$$sifexists(schema)_","_$$$scascade(schema)_",.SQLCODE,.%msg)")
	$$$liin("} catch {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error executing DROP SCHEMA:""_$ze" )
	$$$liin("}")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
.
cancelQuery ; Code generation for: CANCEL QUERY <pid spec> [ <cancel query scope> ] [ <timeout scope> ]
	new line,lines,param1,param2,param3,paramPos,tag,val
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	 
	set param1=$g($$$mtCancelQuery("pid"))      // pid
	set param2=$g($$$mtCancelQuery("sql-id"))   // SQLStatementID
	set param3=$g($$$mtCancelQuery("timeout"))  // timeout
	
	for paramPos=1:1:3 { // --- Process Each Parameters ---
		set val=@("param"_paramPos)
		set @("param"_paramPos)=$s(val="":"",$e(val,1)=":":"$g("_$e(val,2,*)_")",$isvalidnum(val):val,1:$$$quote(val))
	}
	
	$$$liin("new %mmmerr,%mmmsc")
	$$$liin("try {")
	$$$liin($c(9)_"set SQLCODE=0")
	$$$liin($c(9)_"set %mmmsc=$$SQLInterrupt^%apiSQL("_param1_",,"_param3_",,,"_param2_",.SQLCODE)")
	$$$liin($c(9)_"if '%mmmsc { set:SQLCODE=0 SQLCODE=-400 set %mmmerr=$LG($e(%mmmsc,3,*),1),%msg=$LG(%mmmerr,$s($LG(%mmmerr,1)=5521:3,1:2)) }")
	$$$liin("} catch {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error executing CANCEL QUERY:""_$ze" )
	$$$liin("}")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
.
InitDDLAMSInfo() [sql,sqlidxhash,cflag] PUBLIC {
	RETURN:'$$$SQLPushAMSInfo  // Don't Initialize 'Application Metadata Stack' (AMS) Information!
	if '$d(sqlidxhash) {	// should this ever be true???
		new sqlidxhash
		set sqlidxhash = $lb($$Hash^%SYS.SQLSRV("",.sql,""))
	}
	set var=$$$getVarName("AMSInfo")
	if $e(var,1,2)'="i%" { $$$liin("new "_var) }
	do InitAMSInfo^%qaqcasl  // Initialize 'Application Metadata Stack' (AMS) Information!
}
.
#INCLUDE %quoter
.
---
