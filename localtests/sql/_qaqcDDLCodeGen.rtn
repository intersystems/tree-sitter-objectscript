		$$$liin("}")
		$$$liin("set %mmmrenamefield("_$$quoter($$$tname(tab))_","_$$quoter(fld)_")=""""")
		$$$liin("if $$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE,,,,,.%mmmrenamefield) { TCOMMIT } else { TROLLBACK 1 }") ; // compile should have closed %mmmch
		set tag=bottom
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("RETURN")
		RETURN
	}
	 
	if $p($$$Top(tab),$c(1))="alteraddforeignkey" {  ; ALTER TAB - ADD FOREIGN KEY
		new key set key=$p($$$Top(tab),$c(1),2)
		$$$liin("new %mmmch,%mmmsc,%mmmclassname set SQLCODE=0,%mmmch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",.SQLCODE,1,,1,.%mmmclassname,,"_$select($$$SQLCompileOption("xDBC")=1:1, $$$SQLCompileOption("DynamicSQL")=1:1, 1:0)_",1) goto:((SQLCODE<0)||(%mmmch=0)) "_bottom)	// DPV2427 lock table
		$$$liin("if $$IsDerivedFrom^%occLibrary(%mmmclassname,""%Library.AbstractForeignTable"") { do Close^%apiDDL(%mmmch) set SQLCODE = -30, %msg=""Table '"_$$$tname(tab)_"' is a foreign table. Use ALTER FOREIGN TABLE instead"" goto "_bottom_" } ")
	         #;   Should have one FKEY constraint!
		set con=$$$nextcon("")
		if con'="" { $$$liin("s %mmmsc=$$AddConstraint^%apiDDL(%mmmch,"_$$quoter($$$Cname(con))_","""_$$$Ctype(con)_""","_$$quoter($$$CinfoFKEYFlds(con))_","_$$quoter($$$tname($$$CinfoFKEYRefTab(con)))_","_$$quoter($$$CinfoFKEYRefFlds(con))_","_$$quoter($s($$$CinfoFKEYRAUpdate(con)'="":$$$CinfoFKEYRAUpdate(con),1:"NO ACTION"))_","_$$quoter($s($$$CinfoFKEYRADelete(con)'="":$$$CinfoFKEYRADelete(con),1:"NO ACTION"))_","_$$$CinfoFKEYNoCheck(con)_",.SQLCODE,"_$select($$$SQLCompileOption("xDBC")=1:1, $$$SQLCompileOption("DynamicSQL")=1:1, 1:0)_") if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }") }
		$$$liin("new %mmmclist,%mmmoch set %mmmoch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",,,1),%mmmclist=1 if '$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE,.%mmmclist) d  q")
		$$$liin(". if %mmmoch n %msgsave s %msgsave=$g(%msg),%mmmclist=2 d compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) s %msg=$g(%msgsave)")
		$$$liin("do:%mmmoch Close^%apiDDL(%mmmoch) set SQLCODE=0")
		set tag=bottom
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("RETURN")
		RETURN
	}
.
	if $p($$$Top(tab),$c(1))="alteraddprimarykey" {  ; ALTER TABLE - ADD PRIMARY KEY
		new key set key=$p($$$Top(tab),$c(1),2)
		$$$liin("new %mmmbi,%mmmch,%mmmcn,%mmmsc,%mmmclassname")
		$$$liin("set SQLCODE=0,%mmmcn="_$$quoter($$$consname(tab,key))_",%mmmch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",.SQLCODE,1,,1,.%mmmclassname,,"_$select($$$SQLCompileOption("xDBC")=1:1, $$$SQLCompileOption("DynamicSQL")=1:1, 1:0)_",1) goto:((SQLCODE<0)||(%mmmch=0)) "_bottom)
		$$$liin("if $$IsDerivedFrom^%occLibrary(%mmmclassname,""%Library.AbstractForeignTable"") { do Close^%apiDDL(%mmmch) set SQLCODE = -30, %msg=""Table '"_$$$tname(tab)_"' is a foreign table. Use ALTER FOREIGN TABLE instead"" goto "_bottom_" } ")
		$$$liin("set %mmmbi=1,%mmmsc=$$AddKey^%apiDDL(%mmmch,.%mmmcn,"""",""P"","_$$quoter($$$KLIST(tab,key))_",.SQLCODE,1,.%mmmbi) if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }")
	         #;   Should have one PKEY constraint!
		$$$liin("new %mmmclist,%mmmoch set %mmmoch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",,,1),%mmmclist=1 if '$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE,.%mmmclist) {")
		$$$liin($c(9)_"if %mmmoch new %msgsave set %msgsave=$g(%msg),%mmmclist=2 do compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) set %msg=$g(%msgsave)")
		$$$liin($c(9)_"goto "_bottom)
		$$$liin("}")
		$$$liin("if %mmmbi,'$$BuildIndices^%apiDDL("_$$quoter($$$tname(tab))_",$lb(%mmmcn),.SQLCODE) {")
		$$$liin($c(9)_"do PurgeIndices^%apiDDL("_$$quoter($$$tname(tab))_",$lb(%mmmcn))") 
		$$$liin($c(9)_"if %mmmoch new %msgsave set %msgsave=$g(%msg),%mmmclist=2 do compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) set %msg=$g(%msgsave)")
		$$$liin($c(9)_"goto "_bottom)
		$$$liin("}")
		$$$liin("do:%mmmoch Close^%apiDDL(%mmmoch) set SQLCODE=0")
		set tag=bottom
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("RETURN")
		RETURN
	}
	 
	if $p($$$Top(tab),$c(1))="alteraddunique" {  ; ALTER TABLE - ADD UNIQUE CONSTRAINT
		new key set key=$p($$$Top(tab),$c(1),2)
		$$$liin("new %mmmbi,%mmmch,%mmmcn,%mmmsc,%mmmclassname")
		$$$liin("set SQLCODE=0,%mmmcn="_$$quoter($$$consname(tab,key))_",%mmmch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",.SQLCODE,1,,1,.%mmmclassname,,"_$select($$$SQLCompileOption("xDBC")=1:1,$$$SQLCompileOption("DynamicSQL")=1:1, 1:0)_",1) goto:((SQLCODE<0)||(%mmmch=0)) "_bottom)
		$$$liin("if $$IsDerivedFrom^%occLibrary(%mmmclassname,""%Library.AbstractForeignTable"") { do Close^%apiDDL(%mmmch) set SQLCODE = -30, %msg=""Table '"_$$$tname(tab)_"' is a foreign table. Use ALTER FOREIGN TABLE instead"" goto "_bottom_" } ")
		$$$liin("set %mmmbi=1,%mmmsc=$$AddKey^%apiDDL(%mmmch,.%mmmcn,"""",""U"","_$$quoter($$$KLIST(tab,key))_",.SQLCODE,1,.%mmmbi) if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }")
		$$$liin("new %mmmclist,%mmmoch set %mmmoch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",,,1),%mmmclist=1")
		$$$liin("if '$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE,.%mmmclist) {")
		$$$liin($c(9)_"if %mmmoch { new %msgsave set %msgsave=$g(%msg),%mmmclist=2 do compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) set %msg=$g(%msgsave) }")
		$$$liin($c(9)_"goto "_bottom)
		$$$liin("}")
		$$$liin("if %mmmbi,'$$BuildIndices^%apiDDL("_$$quoter($$$tname(tab))_",$lb(%mmmcn),.SQLCODE) {")
		$$$liin($c(9)_"do PurgeIndices^%apiDDL("_$$quoter($$$tname(tab))_",$lb(%mmmcn))") 
		$$$liin($c(9)_"if %mmmoch { new %msgsave set %msgsave=$g(%msg),%mmmclist=2 do compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) set %msg=$g(%msgsave) }")
		$$$liin($c(9)_"goto "_bottom)
		$$$liin("}")
		$$$liin("do:%mmmoch Close^%apiDDL(%mmmoch) set SQLCODE=0")
		set tag=bottom
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("RETURN")
		RETURN
	}
	 
	if $$$Top(tab)="alterdropforeignkey" {  ; ALTER TABLE DROP FOREIGN KEY
		new key set key=$$$nextkey(tab,"")
		$$$liin("new %mmmch,%mmmsc,%mmmclassname")
		$$$liin("set SQLCODE=0,%mmmch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",.SQLCODE,1,,,.%mmmclassname,,"_$select($$$SQLCompileOption("xDBC")=1:1,$$$SQLCompileOption("DynamicSQL")=1:1,1:0)_",1) goto:((SQLCODE<0)||(%mmmch=0)) "_bottom)
		$$$liin("if $$IsDerivedFrom^%occLibrary(%mmmclassname,""%Library.AbstractForeignTable"") { do Close^%apiDDL(%mmmch) set SQLCODE = -30, %msg=""Table '"_$$$tname(tab)_"' is a foreign table. Use ALTER FOREIGN TABLE instead"" goto "_bottom_" } ")
		$$$liin("set %mmmsc=$$DropKey^%apiDDL(%mmmch,"_$$quoter($$$consname(tab,key))_",""F"","""","""","""",.SQLCODE) if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }")
		$$$liin("goto:SQLCODE<0 "_bottom)
		$$$liin("new %mmmclist,%mmmoch set %mmmoch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",,,1),%mmmclist=1 if '$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE,.%mmmclist) d  goto "_bottom)
		$$$liin(". if %mmmoch new %msgsave set %msgsave=$g(%msg),%mmmclist=2 d compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) set %msg=$g(%msgsave)")
		$$$liin("do:%mmmoch Close^%apiDDL(%mmmoch) set SQLCODE=0")
		set tag=bottom
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("RETURN")
		RETURN
	}
.
	if $$$Top(tab)="alterdropprimarykey" {  ; ALTER TABLE DROP PRIMARY KEY
		new key set key=$$$nextkey(tab,"")
		$$$liin("new %mmmch,%mmmsc,%mmmclassname")
		$$$liin("set SQLCODE=0,%mmmch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",.SQLCODE,1,,,.%mmmclassname,,"_$select($$$SQLCompileOption("xDBC")=1:1,$$$SQLCompileOption("DynamicSQL")=1:1,1:0)_",1) goto:((SQLCODE<0)||(%mmmch=0)) "_bottom)
		$$$liin("if $$IsDerivedFrom^%occLibrary(%mmmclassname,""%Library.AbstractForeignTable"") { do Close^%apiDDL(%mmmch) set SQLCODE = -30, %msg=""Table '"_$$$tname(tab)_"' is a foreign table. Use ALTER FOREIGN TABLE instead"" goto "_bottom_" } ")
		$$$liin("set %mmmsc=$$DropKey^%apiDDL(%mmmch,"""",""P"","""","""","""",.SQLCODE) if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }")
		$$$liin("new %mmmclist,%mmmoch set %mmmoch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",,,1),%mmmclist=1 if '$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE,.%mmmclist) d  goto "_bottom)
		$$$liin(". if %mmmoch new %msgsave set %msgsave=$g(%msg),%mmmclist=2 do compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) set %msg=$g(%msgsave)")
		$$$liin("do:%mmmoch Close^%apiDDL(%mmmoch) set SQLCODE=0")
		set tag=bottom
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("RETURN")
		RETURN
	}
	 
	if $$$Top(tab)="alterdropconstraint" {  ; ALTER TABLE DROP CONSTRAINT
		new con set con=$$$nextcon("")
		$$$liin("new %mmmch,%mmmsc,%mmmclassname")
		$$$liin("set SQLCODE=0,%mmmch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",.SQLCODE,1,,,.%mmmclassname,,"_$select($$$SQLCompileOption("xDBC")=1:1,$$$SQLCompileOption("DynamicSQL")=1:1,1:0)_",1) goto:((SQLCODE<0)||(%mmmch=0)) "_bottom)
		$$$liin("if $$IsDerivedFrom^%occLibrary(%mmmclassname,""%Library.AbstractForeignTable"") { do Close^%apiDDL(%mmmch) set SQLCODE = -30, %msg=""Table '"_$$$tname(tab)_"' is a foreign table. Use ALTER FOREIGN TABLE instead"" goto "_bottom_" } ")
		$$$liin("set %mmmsc=$$DropConstraint^%apiDDL2(%mmmch,"_$$quoter($$$Cname(con))_",.SQLCODE) if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }")
		$$$liin("new %mmmclist,%mmmoch set %mmmoch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",,,1),%mmmclist=1 if '$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE,.%mmmclist) d  goto "_bottom)
		$$$liin(". if %mmmoch new %msgsave set %msgsave=$g(%msg),%mmmclist=2 do compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) set %msg=$g(%msgsave)")
		$$$liin("do:%mmmoch Close^%apiDDL(%mmmoch) set SQLCODE=0")
		set tag=bottom
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("RETURN")
		RETURN
	}
	
	if $$$Top(tab)="alterrename" { ; ALTER TABLE RENAME
		$$$liin("set SQLCODE=0")
		$$$liin("new %mmmch,%mmmReleaseTableLock,%mmmclassname")
		$$$liin("set %mmmch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",.SQLCODE,1,,1,.%mmmclassname,,"_$select($$$SQLCompileOption("xDBC")=1:1,$$$SQLCompileOption("DynamicSQL")=1:1,1:0)_",1)")
		$$$liin("goto:((SQLCODE<0)||(%mmmch = 0)) "_bottom)
		$$$liin("if $$IsDerivedFrom^%occLibrary(%mmmclassname,""%Library.AbstractForeignTable"") { do Close^%apiDDL(%mmmch) set SQLCODE = -30, %msg=""Table '"_$$$tname(tab)_"' is a foreign table. Use ALTER FOREIGN TABLE instead"" goto "_bottom_" } ")
		$$$liin("do:('$$RenameTable^%apiDDL(%mmmch,"_$$quoter($$$tnewname(tab))_",.SQLCODE)) Close^%apiDDL(%mmmch)")
		set tag=bottom
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("RETURN")
		RETURN
	}
	
	if $$$Top(tab)="alternoop" $$$liin("set SQLCODE=0")
	set tag=bottom
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN	;--- altgen ---
 
 
genAlterAlter	;
		#;  alter the field
		#;   Call:  AlterColumn^%apiDDL(class,fldname,defvalue,typeinfo,required,.indexlist,collate,deferred,.SQLCODE,killPropParams=0,&CheckFieldValid,&BuildDeferred)
	set alteralterCnt=alteralterCnt+1
	do generateSQLStartCode^%qaqcasl()
	$$$liin("new %mmmbd,%mmmivfn")
	$$$liin("set %mmmsc=$$AlterColumn^%apiDDL(%mmmch,"_$$quoter($$$fname(tab,fld))_","_$$quoter($$$default(tab,fld))_","""_$$$datatype(tab,fld)_""","""_$$$required(tab,fld)_""",.%mmmil,"_$$quoter($$$collate(tab,fld))_","_$$$deferred(tab,fld)_",.SQLCODE,,.%mmmivfn,.%mmmbd) if '%mmmsc { do Close^%apiDDL(%mmmch) quit }")
	set con=""
	For  { 
		set con=$$$nextcon(con) quit:con=""
		if $$$Ctype(con)="FKEY" {
			$$$liin("set %mmmsc=$$AddConstraint^%apiDDL(%mmmch,"_$$quoter($$$Cname(con))_","""_$$$Ctype(con)_""","_$$quoter($$$CinfoFKEYFlds(con))_","_$$quoter($$$tname($$$CinfoFKEYRefTab(con)))_","_$$quoter($$$CinfoFKEYRefFlds(con))_","_$$quoter($s($$$CinfoFKEYRAUpdate(con)'="":$$$CinfoFKEYRAUpdate(con),1:"NO ACTION"))_","_$$quoter($s($$$CinfoFKEYRADelete(con)'="":$$$CinfoFKEYRADelete(con),1:"NO ACTION"))_","_$$$CinfoFKEYNoCheck(con)_",.SQLCODE,"_$select($$$SQLCompileOption("xDBC")=1:1, $$$SQLCompileOption("DynamicSQL")=1:1, 1:0)_") if '%mmmsc { do Close^%apiDDL(%mmmch) quit }")
		}
	}
		// If we have changed any field from deferred to not deferred, %mmmbd will contain the classname of the class we need to call %BuildDeferred on before proceeding
	$$$liin("if $g(%mmmbd)'="""" { set %mmmsc=$classmethod(%mmmbd,""%BuildDeferred"",0,1,0) if '%mmmsc { do Close^%apiDDL(%mmmch) quit }}") 	// If needed, call %BuildDeferred for this class to fill any deferred items, call with nolock=1 since we have a table lock
	$$$liin("if %mmmil'="""",'$$PurgeIndices^%apiDDL("_$$quoter($$$tname(tab))_",.%mmmil,.SQLCODE) { do Close^%apiDDL(%mmmch) quit }")	// Purge old index values if needed
	$$$liin("new %mmmclist,%mmmerr")
	$$$liin("set %mmmerr=0")
	if alteralterCnt=1 { $$$liin("new %mmmoch set %mmmoch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",,,1)") }
	$$$liin("set %mmmclist=1")
		#;  Compile the table, if error save/compile old version and maybe rebuild indices
	$$$liin("if '$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE,.%mmmclist,,1) {")
	$$$liin($c(9)_"if %mmmoch { new %msgsave set %msgsave=$g(%msg),%mmmclist=2 do compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) if %mmmil'="""" { do BuildIndices^%apiDDL("_$$quoter($$$tname(tab))_",%mmmil) } set %msg=$g(%msgsave) }")
	$$$liin($c(9)_"do Close^%apiDDL(%mmmch) quit")
	$$$liin("}")
		#;  Table compiled OK, so now validate any new field datatypes with existing data.  If error, try to undo it all
	$$$liin("if $g(%mmmivfn)'="""",'$$FieldIsValid^%apiDDL("_$$quoter($$$tname(tab))_",%mmmivfn,.SQLCODE,.%msg) {")
	$$$liin($c(9)_"if %mmmoch { new %msgsave set %msgsave=$g(%msg),%mmmclist=2 do compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) if %mmmil'="""" { do BuildIndices^%apiDDL("_$$quoter($$$tname(tab))_",%mmmil) } set %msg=$g(%msgsave) }")
	$$$liin($c(9)_"do Close^%apiDDL(%mmmch) quit")
	$$$liin("}")
		#;  Table compiled OK, so now rebuild the indices.  If error, try to undo it all
	$$$liin("if %mmmil'="""",'$$BuildIndices^%apiDDL("_$$quoter($$$tname(tab))_",%mmmil,.SQLCODE) {")
	$$$liin($c(9)_"do PurgeIndices^%apiDDL("_$$quoter($$$tname(tab))_",%mmmil)") 
	$$$liin($c(9)_"if %mmmoch { new %msgsave set %msgsave=$g(%msg),%mmmclist=2 do compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) if %mmmil'="""" { do BuildIndices^%apiDDL("_$$quoter($$$tname(tab))_",%mmmil) } set %msg=$g(%msgsave) }")
	$$$liin($c(9)_"do Close^%apiDDL(%mmmch) quit")
	do generateSQLEndCode^%qaqcasl() //***
	$$$liin("}")
	QUIT
 
 
drtgen(tab)  ;  generate DROP TABLE code for table handle tab
	new ddflag,quotab
	set quotab=""_$$quoter($$$tname(tab))_""  ;  a-up of table name in quotes
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	set ddflag=$s($$$tdeldata($$$Dtab)="%DELDATA":1,$$$tdeldata($$$Dtab)="%NODELDATA":0,1:"")
		#;
		#;  Drop a Table
		#;   Call:  DropTable(tablename,behave,deldata,.SQLCODE,noddlcheck,ifexists,isshardexport,nojourn)	
		#;
	$$$liin("set SQLCODE=0 do DropTable^%apiDDL("_quotab_","""_$$$tbehave($$$Dtab)_""","_ddflag_",.SQLCODE,,"_$$$tifexists($$$Dtab)_",0,"_$$$mtKNoJournalFlag($g($$$mtK))_")")
	if $g(%DDLMode)="MySQL" { $$$liin("set:(SQLCODE>0) SQLCODE=0") }
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN  ;--- drtgen ---
	
.
createForeignTableGen(tab) ; generate CREATE FOREIGN TABLE code for table handle tab. This implies creating the PROJECTING class and compiling that which will in turn create/compile the actual FT
	new checkpriv,fld,fldord,tParamName,tParamValue
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	if $$$SQLCompileOption("xDBC")=1||($$$SQLCompileOption("DynamicSQL")=1) { set checkpriv=1 } else { set checkpriv=0 }
	
	$$$liin("TSTART")
	$$$liin("try {")
	$$$liin($c(9)_"new classParams,columnInfo,i,%mmmch,tableName")
	$$$liin($c(9)_"set SQLCODE=0")
.
.
		#; create an array of the class parameters to pass in the call to CreateForeignTable^%apiDDL2 later
		#; note that this loops always ends the line with a comma, to keep setting into classParams
		#; then the manual addition of the server param will not include the comma to end the line!
	set tParamName=""
	set line=$c(9)_"set "
	for i=1:1 {
		set tParamName=$$$FTNextParameter(tab,tParamName,tParamValue) quit:tParamName=""
		set line=line_$s(i>1:",",1:"")_"classParams("_$$$QuoteName(tParamName)_")="_$$$QuoteName(tParamValue)
	}
	$$$liin(line)
	// if we import schema, we will set VALUES later when we got the metadata
	if '$$$FTGetImportSchema(tab) { 
		$$$liin($c(9)_"set classParams(""VALUES"")="_$$$QuoteName($$$FTGetValues(tab))) 
	}
	$$$liin("set tableName="_$$quoter($$$tname(tab)))
.
	if '$$$FTGetImportSchema(tab) { 
		$$$liin($c(9)_"new columnInfo")
		set fldord="" 
		for i=2:1 {
			$$$nextfld(tab,fldord,fld) 
			QUIT:fld=""
			$$$liin($c(9)_"set columnInfo($i(columnInfo)) = $lb("_$$quoter($$$fname(tab,fld))_","_$$quoter($$$fdesc(tab,fld))_","_$$quoter($$$datatype(tab,fld))_")")
		}
	}
.
	$$$liin($c(9)_"set %mmmch = $$CreateForeignTable^%apiDDL2(.tableName,$Username,.classParams,"_+$$$tifexists(tab)_",.SQLCODE,"_checkpriv_",.columnInfo,"_+$$$FTGetNOVALIDATE(tab)_","_$$quoter($$$FTGetServer(tab))_")")
	$$$liin($c(9)_"QUIT:'%mmmch")	// would quit the TRY{}
		#;
		#;  Compile the table
		#;
	$$$liin($c(9)_"if '$$compile^%apiDDL(tableName,%mmmch,.SQLCODE) { }")
	$$$liin($c(9)_"do:%mmmch Close^%apiDDL(%mmmch)")
	$$$liin("} catch ex {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error occurred in generated CREATE FOREIGN TABLE code:""_ex.AsSQLMessage()" )
	$$$liin("}")
	$$$liin("if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
.
alterForeignTableGen(tab)  ;  generate ALTER FOREIGN TABLE code for foreign table handle tab
	new checkpriv,fld,fldord,quotab
	set quotab=""""_$$$TNAME(tab)_""""  ;  a-up of table name in quotes
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	if $$$SQLCompileOption("xDBC")=1||($$$SQLCompileOption("DynamicSQL")=1) { set checkpriv=1 } else { set checkpriv=0 }
	if $$$Top(tab)["," { // ALTER FOREIGN TABLE - MODIFY (rename or datatype)
		$$$liin("TSTART")
		$$$liin("try {")
		$$$liin($c(9)_"new %mmmch,%mmmsc set SQLCODE=0")
		for i=1:1:$l($$$Top(tab),",") {
			set fld = $p($p($$$Top(tab),",",i),$c(1),2)
			if $p($p($$$Top(tab),",",i),$c(1))="alterFTrenamefield" {  // RENAME
				$$$liin($c(9)_"set %mmmsc = $$RenameFTField^%apiDDL(.%mmmch,"_$$$QuoteName($$$tname(tab))_","_$$$QuoteName(fld)_","_$$$QuoteName($$$fnewname(tab,fld))_","_$$$QuoteName($$$FTGetValuesRename(tab,fld))_",.SQLCODE,"_checkpriv_") if '%mmmsc quit")
			} elseif $p($p($$$Top(tab),",",i),$c(1))="alterFTalter" { // ALTER DATATYPE
				$$$liin($c(9)_"set %mmmsc = $$AlterFTField^%apiDDL(.%mmmch,"_$$$QuoteName($$$tname(tab))_","_$$$QuoteName(fld)_","_$$$QuoteName($$$datatype(tab,fld))_",.SQLCODE,"_checkpriv_") if '%mmmsc quit")
			}
		}
		$$$liin($c(9)_"if '$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE) {}")
		$$$liin("} catch {")
		$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error executing ALTER FOREIGN TABLE, ALTER COLUMN:""_$ze" )
		$$$liin("}")
		$$$liin("if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("QUIT")
		RETURN
	}
	
	If $p($$$Top(tab),$c(1))="alterFTalter" {	//ALTER FOREIGN TABLE - ALTER COLUMN (datatype)
		set fld=$p($$$Top(tab),$c(1),2)
.
		$$$liin("TSTART")
		$$$liin("try {")
		$$$liin($c(9)_"new %mmmch,%mmmsc set SQLCODE=0")
		$$$liin($c(9)_"set %mmmsc = $$AlterFTField^%apiDDL(.%mmmch,"_$$$QuoteName($$$tname(tab))_","_$$$QuoteName(fld)_","_$$$QuoteName($$$datatype(tab,fld))_",.SQLCODE,"_checkpriv_") if '%mmmsc quit")
.
		$$$liin($c(9)_"if '$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE) {}")
		$$$liin("} catch {")
		$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error executing ALTER FOREIGN TABLE, ALTER COLUMN:""_$ze" )
		$$$liin("}")
		$$$liin("if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("QUIT")
		RETURN
	}
	
	if $piece($$$Top(tab), $c(1)) = "alterFTrenamefield" { //ALTER FOREIGN TABLE - ALTER COLUMN (rename field)
		set fld = $piece($$$Top(tab), $c(1), 2)
		
		$$$liin("TSTART")
		$$$liin("try {")
		$$$liin($c(9)_"new %mmmch,%mmmsc set SQLCODE=0")
		$$$liin($c(9)_"set %mmmsc = $$RenameFTField^%apiDDL(.%mmmch,"_$$$QuoteName($$$tname(tab))_","_$$$QuoteName(fld)_","_$$$QuoteName($$$fnewname(tab,fld))_","_$$$QuoteName($$$FTGetValuesRename(tab,fld))_",.SQLCODE,"_checkpriv_") if '%mmmsc quit")
.
		$$$liin($c(9)_"if '$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE) {}")
		$$$liin("} catch {")
		$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error executing ALTER FOREIGN TABLE, ALTER COLUMN:""_$ze" )
		$$$liin("}")
		$$$liin("if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("QUIT")
		RETURN
		
	}
.
	RETURN
 
 
dropForeignTableGen(tab) ; generate DROP FOREIGN TABLE code for table handle tab
	// Post EEE018, this will directly delete the foreign table class when it is being dropped (no projector-related logic)
	new behave,checkpriv,tablename 
	set behave="RESTRICT" set:$$$tbehave(tab)'="" behave=$$$tbehave(tab)
	set tablename=""""_$$$tname(tab)_""""  ;  table name in quotes, which will be the view name (not alpha-up)
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	
	$$$liin("TSTART")
	$$$liin("try {")
		#; drop the view
	$$$liin($c(9)_"n %sc s SQLCODE=0,%sc=$$DropForeignTable^%apiDDL2("_tablename_","_$$quoter(behave)_","_+$$$tifexists(tab)_",.SQLCODE,0) q:'%sc")
		#; delete the class with the TVF 
	$$$liin("} catch {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error occurred in generated DROP FOREIGN TABLE code:""_$ze" )
	$$$liin("}")
	$$$liin("if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("QUIT")
	RETURN
	
.
	; generate CREATE SERVER code for server handle server
createForeignServerGen(server)
	new tParamName,tParamValue
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	
	// This will be a class that holds information about a foreign server in class parameters
	$$$liin("TSTART")
	$$$liin("try {")
	$$$liin($c(9)_"n %mmmch,%mmmoch,%mmmsc s SQLCODE=0,%mmmch=$$CreateForeignServer^%apiDDL2("_$$$QuoteName($$$FTSname(server))_",$Username,"_$$$QuoteName($$$FTSGetFDW(server))_","_$$$QuoteName($$$FTSGetConnection(server))_","_$$$QuoteName($$$FTSGetDelimitedIds(server))_","_$$$FTSGetPassthrough(server)_",.SQLCODE,"_+$$$FTSGetIfExists(server)_") quit:'%mmmch")
.
		#;   loop and add/set each class parameter
		#;   call: AddParameter^%apiDDL(classoref,parameter)
		#;   call: SetParameter(classoref,parameter,keyword,value)
	set tParamName=""
	for i=1:1 {
		set tParamName=$$$FTSNextParameter(server,tParamName,tParamValue) 
		QUIT:tParamName=""
		$$$liin($c(9)_"s %mmmsc=$$AddParameter^%apiDDL(%mmmch,"_$$quoter(tParamName)_","_$$quoter(tParamValue)_",.SQLCODE) i '%mmmsc d Close^%apiDDL(%mmmch) q")
	}
	#;  Compile the server
	#;  If there is an error compiling, we try to delete the class.
	$$$liin($c(9)_"if '$$compile^%apiDDL("_$$quoter(server)_",%mmmch,.SQLCODE) { }")           // Compile failed for server class.  SQLCODE should have been set if error
	$$$liin($c(9)_"do:%mmmch Close^%apiDDL(%mmmch)")
	$$$liin("} catch {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error occurred in generated CREATE SERVER code:""_$ze" )
	$$$liin("}")
	$$$liin("if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	
	RETURN
	
alterForeignServerGen(server)  ;  generate ALTER FOREIGN TABLE code for foreign table handle tab
	new conn, delids, line, tParamName, tParamValue
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	if $$$FTSGetOp(server)="alter foreign server" {	// ALTER SERVER
		// the nature of a CONNECTION is different than other server params because it requires extra checks so
		// for that we actually use a specialized function, the others can be
		$$$liin("TSTART")
		$$$liin("try {")
		$$$liin($c(9)_"new %mmmch,%mmmsc,%classname,%mmmparams set SQLCODE=0")
		set conn = $$$FTSGetConnection(server)
		set delids = $$$FTSGetDelimitedIds(server)
		if conn '= "" {
			$$$liin($c(9)_"set %mmmparams(""CONNECTION"")="_$$$QuoteName(conn))
		} else {
			set tParamName=""
			set line=$c(9)_"s "
			for i=1:1 {
				set tParamName=$$$FTSNextParameter(server,tParamName,tParamValue) quit:tParamName=""
				set line=line_"%mmmparams("_$$$QuoteName(tParamName)_")="_$$$QuoteName(tParamValue)_","
			}
			if delids'="" {
				set line = line_"%mmmparams(""DELIMITEDIDS"")="_delids // delimited ids is just a 1/0 flag so don't need to quote
			} else {
				set $e(line,*)="" // get rid of trailing comma
			}
			$$$liin(line) // *-1 because of trailing comma
		}
		$$$liin($c(9)_"set %mmmch = $$AlterForeignServer^%apiDDL("_$$$QuoteName($$$FTSname(server))_",.%mmmparams,.%classname,.SQLCODE) if '%mmmch quit")
		$$$liin("if '$$compile^%apiDDL("_$$quoter(server)_",%mmmch,.SQLCODE) {}")
		$$$liin("} catch {")
		$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error executing ALTER FOREIGN SERVER:""_$ze" )
		$$$liin("}")
		$$$liin("if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("QUIT")
	}
	 
	RETURN
.
.
dropForeignServerGen(server) ; generate DROP SERVER code for table handle tab
	// when a foreign table is dropped, we start by dropping the view associated, then deleting the class that holds the TVF
	new behave, servername 
	set behave = $$$FTSGetBehave(server)
	set:behave="" behave="RESTRICT"
	set servername = $$$QuoteName($$$FTSname(server))
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	
	$$$liin("TSTART")
	$$$liin("try {")
		#; DropServer^%apiDDL2 will drop the server AND if behave=CASCADE, will also drop all Foreign Tables under it;
		#; if restrict, only drop this server if there's no foreign table under it, otherwise error
	$$$liin($c(9)_"n %sc s SQLCODE=0,%sc=$$DropServer^%apiDDL2("_servername_","_$$quoter(behave)_",.SQLCODE,0,.%msg,"_+$$$FTSGetIfExists(server)_") q:'%sc")
	$$$liin("} catch {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error occurred in generated DROP SERVER code:""_$ze" )
	$$$liin("}")
	$$$liin("if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("QUIT")
	RETURN
 
 
drigen(index) ; Generate DROP INDEX... code for index handle index
		#;
		#;  Drop an Index
		#;   Generate Call to:
		#;     $$DropIndex^%apiDDL(ixname,&class,tablename,&SQLCODE,checkalterpriv,openclass=1,ifexists=0,nojourn=0,&%msg)
		#;
	new bottom
	do initag set bottom=mtag_"dun"
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("new %mmmch,%mmmsc,%mmmtn")
	$$$liin("set SQLCODE=0,"_$s($$$itable(index)'="":"%mmmtn="_$$quoter($$$itable(index))_",",1:"")_"%mmmsc=$$DropIndex^%apiDDL("_$$quoter($$$iname(index))_",.%mmmch,.%mmmtn,.SQLCODE,"_$select($$$SQLCompileOption("xDBC")=1:1, $$$SQLCompileOption("DynamicSQL")=1:1, 1:0)_",,"_$$$idropifexists(index)_","_$$$mtKNoJournalFlag($g($$$mtK))_",.%msg) if '%mmmsc||(SQLCODE<0) { do:$g(%mmmch) Close^%apiDDL(%mmmch) goto "_bottom_" }")
		#; If '$g(%mmmch), the class was not opened or altered.  Getting this far means they tried to drop an
		#; index that didn't exist and ^%SYS("sql","ddl","no333") was set to 1, DDL is not allowed on the table
	$$$liin("goto:'$d(%mmmch) "_bottom)
	$$$liin("new %mmmclist,%mmmoch set %mmmoch=$$Open^%apiDDL(%mmmtn,,,1),%mmmclist=1 if '$$compile^%apiDDL(%mmmtn,%mmmch,.SQLCODE,.%mmmclist) d  goto "_bottom)
	$$$liin(". if %mmmoch new %msgsave set %msgsave=$g(%msg),%mmmclist=2 do compile^%apiDDL(%mmmtn,%mmmoch,,.%mmmclist) set %msg=$g(%msgsave)")
	$$$liin("do:%mmmoch Close^%apiDDL(%mmmoch) set SQLCODE=0")
	set tag=bottom
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN  ;--- drigen ---
 
 
crigen(index) ;
		#;
		#;  Create an Index (Default Structure only)
		#;   Generate Call to:
		#;     $$AddIndex^%apiDDL(tabname,collist,ixname,uniqueflag,bitmapflag,bitsliceflag,bitmapextent,columnar,datafields,.SQLCODE,shardkey,coshardwith,typeclass,parameters,collations="",partitionkey=0,partparams="",partitioned=0,deferred=0)
		#;
	new bottom,collations,comma,datafields,fields,i,j
	do initag set bottom=mtag_"dun"
	do InitDDLAMSInfo()
	do generateSQLStartCode^%qaqcasl()
	$$$liin("new classHandle,classList,className,indexName,oldClassHandle,sc")
	$$$liin("set SQLCODE=0,classHandle=$$Open^%apiDDL("_$$quoter($$$itable(index))_",.SQLCODE,1,,1,.className,1,"_$select($$$SQLCompileOption("xDBC")=1:1, $$$SQLCompileOption("DynamicSQL")=1:1, 1:0)_")")
	$$$liin("goto:SQLCODE<0||(classHandle=0) "_bottom)
	set i=0,fields="",collations=""
	for j=0:1 { set i=$$$NextIndexField(index,i) quit:i=""  set fields=fields_$s(j:",",1:"")_$$$IndexField(index,i), collations=collations_$s(j:",",1:"")_$$$icollation(index,i) }
	set i=0,datafields=""
	for j=0:1 { set i=$$$NextIndexDataField(index,i) quit:i=""  set datafields=datafields_$s(j:",",1:"")_$$$IndexDataField(index,i) }
	$$$liin("set indexName="_$$quoter($$$iname(index))_",sc=$$AddIndex^%apiDDL(classHandle,"_$$quoter(fields)_",.indexName,"_$$$iunique(index)_","_$$$ibitmap(index)_","_$$$ibitslice(index)_","_$$$ibitmapextent(index)_","_$$$icolumnar(index)_","_$$quoter(datafields)_",.SQLCODE,,,"""_$$$itypeclass(index)_""","""_$$$iparameters(index)_""","_$$quoter(collations)_",,,"_$$$ipartitioned(index)_","_$$$ideferred(index)_")")
	$$$liin("if 'sc||(SQLCODE<0) { do Close^%apiDDL(classHandle),Unlock^%apiDDL(classHandle,className) goto "_bottom_" }") 
	$$$liin("s sc=$SYSTEM.SQL.Util.SetMapSelectability("_$$quoter($$$itable(index))_","_$$quoter($$$iname(index))_",0)") // mark as not selectable until build is complete
	$$$liin("if 'sc { d SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) goto "_bottom_" }")
	$$$liin("set oldClassHandle=$$Open^%apiDDL("_$$quoter($$$itable(index))_",,,1)")
	$$$liin("set classList=1")
	$$$liin("if '$$compile^%apiDDL("_$$quoter($$$itable(index))_",classHandle,.SQLCODE,.classList,1) {")	// 5th argument=1 means do not unlock class data in compile(), unlock before we quit
	$$$liin($c(9)_"if oldClassHandle { new %msgsave set %msgsave=$g(%msg),classList=2 do compile^%apiDDL("_$$quoter($$$itable(index))_",oldClassHandle,,.classList) set %msg=$g(%msgsave) }",,1)
	$$$liin($c(9)_"do Unlock^%apiDDL(classHandle,className)",,1)
	$$$liin($c(9)_"goto "_bottom,,1)
	$$$liin("}")
	if $$$ibuild(index) {
		$$$liin("if '$$BuildIndices^%apiDDL("_$$quoter($$$itable(index))_",$lb(indexName),.SQLCODE) {")
		$$$liin($c(9)_"do PurgeIndices^%apiDDL("_$$quoter($$$itable(index))_",$lb(indexName))",,1) 
		$$$liin($c(9)_"if oldClassHandle { new %msgsave set %msgsave=$g(%msg),classList=2 do compile^%apiDDL("_$$quoter($$$itable(index))_",oldClassHandle,,.classList) set %msg=$g(%msgsave) }",,1)
		$$$liin($c(9)_"do Unlock^%apiDDL(classHandle,className)",,1)
		$$$liin($c(9)_"goto "_bottom,,1)
		$$$liin("}")
		$$$liin("s sc=$SYSTEM.SQL.Util.SetMapSelectability("_$$quoter($$$itable(index))_","_$$quoter($$$iname(index))_",1)") 
		$$$liin("if 'sc { d SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg) goto "_bottom_" }")
	}
	$$$liin("do:oldClassHandle Close^%apiDDL(oldClassHandle,1) do Unlock^%apiDDL(classHandle,className)")	// Here we unlock the class data before the end of a succcessful Create Index
	$$$liin("set SQLCODE=0")
	set tag=bottom
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
.
setopt	goto:$d(mt("set ml")) setml
	new %line,line,lines,mod,tag ;Setup in initag
	do initag
	if $g(mt("set option"))=$lb("COMPILEMODE","DEFERRED") { $$$liin("kill ^mtemp2($namespace) set SQLCODE=0,^mtemp2($namespace,""Deferred Compile Mode"")=1 RETURN") RETURN }
	if $g(mt("set option"))=$lb("COMPILEMODE","INSTALL") { $$$liin("kill ^mtemp2($namespace) set SQLCODE=0,^mtemp2($namespace,""Deferred Compile Mode"")=2 RETURN") RETURN }
	if $g(mt("set option"))=$lb("COMPILEMODE","NOCHECK") { $$$liin("kill ^mtemp2($namespace) set SQLCODE=0,^mtemp2($namespace,""Deferred Compile Mode"")=3 RETURN") RETURN }
	if $g(mt("set option"))=$lb("COMPILEMODE","IMMEDIATE") { $$$liin("do CompileDeferredList^%apiDDL2(.SQLCODE) set ^mtemp2($namespace,""Deferred Compile Mode"")=0 RETURN") RETURN }
.
	if $lg($g(mt("set option")))="LOCK_TIMEOUT" { $$$liin("do $zu(115,4,"_$lg($g(mt("set option")),2)_") set SQLCODE=0 RETURN") RETURN }
	if $lg($g(mt("set option")))="PKEY_IS_IDKEY" { $$$liin("new %mmmsc set %msg="""",%mmmsc=$$SetDDLPKeyNotIDKey^%apiSQL("_'$lg($g(mt("set option")),2)_") if %mmmsc=1 { set SQLCODE=0 } else { set:$g(%msg)="""" %msg=$$ProcessError^%apiDDL(%mmmsc,.SQLCODE) } kill %mmmsc RETURN") RETURN }
	if $lg($g(mt("set option")))="SUPPORT_DELIMITED_IDENTIFIERS" { $$$liin("new %mmmsc set %msg="""",%mmmsc=$$SetDelimitedIdentifiers^%apiSQL("_$lg($g(mt("set option")),2)_") if %mmmsc=1 { set SQLCODE=0 } else { set:$g(%msg)="""" %msg=$$ProcessError^%apiDDL(%mmmsc,.SQLCODE) } kill %mmmsc RETURN") RETURN }
	if $lg($g(mt("set option")))="AUTO_PARALLEL_THRESHOLD" { $$$liin("new %mmmsc set %msg="""",%mmmsc=$$SetAutoParallelThreshold^%apiSQL("_$lg($g(mt("set option")),2)_") if %mmmsc=1 { set SQLCODE=0 } else { set:$g(%msg)="""" %msg=$$ProcessError^%apiDDL(%mmmsc,.SQLCODE) } kill %mmmsc RETURN") RETURN }
	if $lg($g(mt("set option")))="DEFAULT_SCHEMA" { $$$liin("new %mmmsc set %msg="""",%mmmsc=$$SetDefaultSchema^%apiSQL("""_$lg($g(mt("set option")),2)_""") if %mmmsc=1 { set SQLCODE=0 } else { set:$g(%msg)="""" %msg=$$ProcessError^%apiDDL(%mmmsc,.SQLCODE) } kill %mmmsc RETURN") RETURN }
	if $lg($g(mt("set option")))="EXACT_DISTINCT" { $$$liin("new %mmmsc set %msg="""",%mmmsc=$$SetFastDistinct^%apiSQL("_'$lg($g(mt("set option")),2)_") if %mmmsc=1 { set SQLCODE=0 } else { set:$g(%msg)="""" %msg=$$ProcessError^%apiDDL(%mmmsc,.SQLCODE) } kill %mmmsc RETURN") RETURN }
	if $lg($g(mt("set option")))="LOCK_ESCALATION_THRESHOLD" { $$$liin("new %mmmsc set %msg="""",%mmmsc=$$SetLockThreshold^%apiSQL("_$lg($g(mt("set option")),2)_") if %mmmsc=1 { set SQLCODE=0 } else { set:$g(%msg)="""" %msg=$$ProcessError^%apiDDL(%mmmsc,.SQLCODE) } kill %mmmsc RETURN") RETURN }
		#;  Check for any of the Locale settings:
	if ",AM,DATE_FORMAT,DATE_MAXIMUM,DATE_MINIMUM,DATE_SEPARATOR,DECIMAL_SEPARATOR,MIDNIGHT,MINUS_SIGN,MONTH_ABBR,MONTH_NAME,NOON,NUMERIC_GROUP_SEPARATOR,NUMERIC_GROUP_SIZE,PM,PLUS_SIGN,TIME_FORMAT,TIME_PRECISION,TIME_SEPARATOR,WEEKDAY_ABBR,WEEKDAY_NAME,YEAR_OPTION,"[(","_$lg($g(mt("set option")))_",") {
		new prop,val
		set prop=$tr($lg($g(mt("set option"))),"_")
		set val=$lg($g(mt("set option")),2)
		$$$liin("set SQLCODE=$$SetDCFormat^%SYS.NLS("""_prop_""","_$$quoter(val)_"),SQLCODE=$s(SQLCODE<0:-129,1:0) set:SQLCODE=-129 %msg=""Illegal value ('"_val_"') for locale property '"_prop_"'"" RETURN") 
		RETURN
	}
	$$$liin("set SQLCODE=0 RETURN")   // No OP - for Oracle Support
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setml	; code generate SET ML ... commands.
	// For now we only support SET ML CONFIGURATION <name>
	new %line,line,lines,mod,tag ;Setup in initag
	do initag
		#;    call:  ##class(%SYS.ML.Configuration).%SetDefault(configname)
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin($c(9)_"try {")
	$$$liin($c(9,9)_"do ##class(%SYS.ML.Configuration).%SetDefaultSQL("_$$quoter(mt("set ml","configuration"))_",.SQLCODE,.%msg)")
	$$$liin($c(9)_"} catch {")
	$$$liin($c(9,9)_"set SQLCODE=-400,%msg=""Unexpected error executing SET ML CONFIGURATION: ""_$ze" )
	$$$liin($c(9)_"}")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin($c(9)_"RETURN")
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
users(user) ;
	new line,lines,tag
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	if $$$UserOperation(user)="create user" { $$$liin("do AddUser^%SYS.SQLSEC("_$$quoter($$$UserName(user))_","_$$quoter($$$UserPassword(user))_",,.SQLCODE,.%msg)") }
	elseif $$$UserOperation(user)="alter user" { $$$liin("do AltUser^%SYS.SQLSEC("_$$quoter($$$UserName(user))_","_$$quoter($$$UserPassword(user))_",,.SQLCODE,.%msg)") }
		#; Must be DROP USER
	else { $$$liin("do DropUser^%SYS.SQLSEC("_$$quoter($$$UserName(user))_","_$$$UserDropCascade(user)_",.SQLCODE,.%msg,"_$$$UserDropIfExists(user)_")") }
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
 
 
method(method) ;
	new bottom,i,line,lines,tag
	do initag set bottom=mtag_"dun"
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("TSTART")
	$$$liin("try {")
	$$$liin($c(9)_"new %mc,%mmmch,%mmmsc")
	if $$$ProcMethodCodeLineCount(method) {
		for i=1:1:$$$ProcMethodCodeLineCount(method) {
			set xx=$$$StripTrailingWhiteSpace($$quoter($$$ProcMethodCode(method,i)))
			$$$liin($c(9)_"set %mc("_i_")="_xx)
		}
		$$$liin($c(9)_"set %mc="_i)
	}
	$$$liin($c(9)_"set SQLCODE=0,%mmmch="_$$quoter($$$ProcClassName(method)))
	if $$$ProcTempDrop(method)'="" {
		new what
		set what=$zconvert($piece($$$ProcTempDrop(method)," ",2),"W")
		if what="Proc" {
			#; DropProc^%apiDDL2(classname,sqlprocname,classdeleted,SQLCODE,%msg,No300Check=0,ifexists=0,tempdrop=0)
			$$$liin($c(9)_"set %mmmch=$$Drop"_what_"^%apiDDL2(%mmmch,"_$$quoter($$$ProcName(method))_",,.SQLCODE,.%msg,,,1)")
		} else {
			#; (DropMethod|DropQuery)^%apiDDL(classname,sqlname,classdeleted,SQLCODE,ifexists=0,tempdrop=0)
			$$$liin($c(9)_"set %mmmch=$$Drop"_what_"^%apiDDL(%mmmch,"_$$quoter($$$ProcName(method))_",,.SQLCODE,,1)")
		}
		$$$liin($c(9)_"quit:(SQLCODE<0)")
		$$$liin($c(9)_"set:(%mmmch=0) %mmmch="_$$quoter($$$ProcClassName(method)))
	}
		#;
		#; CreateMethod(classname,sqlmethodname,formalspec,code,sqlproc,returntype,owner,final,private,placeafter,pReturnResultSets,language,external,externalRoutinename,externallanguage,.SQLCODE)
		#;
	$$$liin($c(9)_"set SQLCODE=0,%mmmch=$$CreateMethod^%apiDDL(%mmmch,"_$$quoter($$$ProcName(method))_","_$$quoter($$$ProcParams(method))_",.%mc,"_+$$$ProcProcedure(method)_","_$$quoter($$$ProcReturnType(method))_",$Username,"_+$$$ProcFinal(method)_","_+$$$ProcPrivate(method)_",,"_+$$$ProcReturnResultSets(method)_","""_$$$ProcLanguage(method)_""","_+$$$ProcExternal(method)_","_$$quoter($$$ProcExternalRoutineName(method))_","_$$quoter($$$ProcExternalLanguage(method))_",.SQLCODE) quit:SQLCODE<0")
	$$$liin($c(9)_"do CompileClass^%apiDDL(%mmmch,1,.SQLCODE,1)")
	$$$liin("} catch {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error occurred creating method '"_$$$ProcName(method)_"':""_$ze" )
	$$$liin("}")
	$$$liin("if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	set tag=bottom
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
 
 
dropmethodquery(thing,apitag) ; 
	new bottom,line,lines,tag
	do initag set bottom=mtag_"dun"
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("new %mmmcd,%mmmch,%mmmoch")
	if apitag="DropProc" {
		#; DropProc^%apiDDL2(classname,sqlprocname,classdeleted,SQLCODE,%msg,No300Check=0,ifexists=0,tempdrop=0)
		$$$liin("set SQLCODE=0,%mmmch=$$"_apitag_"^%apiDDL2("_$$quoter($$$ProcClassName(thing))_","_$$quoter($$$ProcName(thing))_",.%mmmcd,.SQLCODE,.%msg,,"_$$$ProcDropIfExists(thing)_")")
	} else {
		#; (DropMethod|DropQuery)^%apiDDL(classname,sqlqueryname,classdeleted,SQLCODE,ifexists=0,tempdrop=0)
		$$$liin("set SQLCODE=0,%mmmch=$$"_apitag_"^%apiDDL("_$$quoter($$$ProcClassName(thing))_","_$$quoter($$$ProcName(thing))_",.%mmmcd,.SQLCODE,"_$$$ProcDropIfExists(thing)_")")
	}
	$$$liin("goto:(('%mmmch)||(%mmmcd)) "_bottom)
	$$$liin("set %mmmoch=$$Open^%apiCDL("_$$quoter($$$ProcClassName(thing))_")")
	$$$liin("if '$$CompileClass^%apiDDL(%mmmch,1,.SQLCODE) {")
	$$$liin($c(9)_"if %mmmoch { new %msgsave set %msgsave=$get(%msg) do CompileClass^%apiDDL(%mmmoch,1) set %msg=$g(%msgsave) }")
	$$$liin($c(9)_"goto "_bottom)
	$$$liin("}")
	$$$liin("do:(%mmmoch) Close^%apiCDL(%mmmoch) set SQLCODE=0")
	set tag=bottom
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
 
 
query(query) ;
	new bottom,i,line,lines,tag
	do initag set bottom=mtag_"dun"
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("new %mmmch,%mmmoch")
	$$$liin("set SQLCODE=0,%mmmch=" _ $$quoter($$$ProcClassName(query)))
	if $$$ProcTempDrop(query)'="" {
		new what
		set what=$zconvert($piece($$$ProcTempDrop(query)," ",2),"W")
		if what="Proc" {
			#; DropProc^%apiDDL2(classname,sqlprocname,classdeleted,SQLCODE,%msg,No300Check=0,ifexists=0,tempdrop=0)
			$$$liin("set %mmmch=$$Drop"_what_"^%apiDDL2(%mmmch,"_$$quoter($$$ProcName(query))_",,.SQLCODE,.%msg,,,1)")
		} else {
			#; (DropMethod|DropQuery)^%apiDDL(classname,sqlname,classdeleted,SQLCODE,ifexists=0,tempdrop=0)
			$$$liin("set %mmmch=$$Drop"_what_"^%apiDDL(%mmmch,"_$$quoter($$$ProcName(query))_",,.SQLCODE,,1)")
		}
		$$$liin("goto:(SQLCODE<0) "_bottom)
		$$$liin("set:(%mmmch=0) %mmmch=" _ $$quoter($$$ProcClassName(query)))
	}
	if '$$$ProcMethodCodeLineCount(query) {	##; Must be a %Query
		if $$$ProcGetInfoCodeLineCount(query) {
			$$$liin("new %mcgi set %msci="_$$$ProcGetInfoCodeLineCount(query))
			for i=1:1:$$$ProcGetInfoCodeLineCount(query) {
				$$$liin("set %mcgi("_i_")="_$$quoter($$$ProcGetInfoCode(query,i)))
			}
		}
		if $$$ProcExecuteCodeLineCount(query) {
			$$$liin("new %mce set %mce="_$$$ProcExecuteCodeLineCount(query))
			for i=1:1:$$$ProcExecuteCodeLineCount(query) {
				$$$liin("set %mce("_i_")="_$$quoter($$$ProcExecuteCode(query,i)))
			}
		}
		if $$$ProcFetchCodeLineCount(query) {
			$$$liin("new %mcf set %mcf="_$$$ProcFetchCodeLineCount(query))
			for i=1:1:$$$ProcFetchCodeLineCount(query) {
				$$$liin("set %mcf("_i_")="_$$quoter($$$ProcFetchCode(query,i)))
			}
		}
		if $$$ProcFetchRowsCodeLineCount(query) {
			$$$liin("new %mcfr set %mcfr="_$$$ProcFetchRowsCodeLineCount(query))
			for i=1:1:$$$ProcFetchRowsCodeLineCount(query) {
				$$$liin("set %mcfr("_i_")="_$$quoter($$$ProcFetchRowsCode(query,i)))
			}
		}
		if $$$ProcCloseCodeLineCount(query) {
			$$$liin("new %mcc set %mcc="_$$$ProcCloseCodeLineCount(query))
			for i=1:1:$$$ProcCloseCodeLineCount(query) {
				$$$liin("set %mcc("_i_")="_$$quoter($$$ProcCloseCode(query,i)))
			}
		}
		$$$liin("set %mmmch=$$CreateQuery^%apiDDL(%mmmch,"_$$quoter($$$ProcName(query))_","_$$quoter($$$ProcParams(query))_","_$$quoter($$$ProcRowSpec(query))_","""","""_$$$ProcQueryType(query)_""","_+$$$ProcProcedure(query)_",$Username,"_+$$$ProcFinal(query)_","_$$$ProcContainId(query)_","_$$quoter($$$ProcSelectMode(query))_",.SQLCODE) goto:(SQLCODE<0) "_bottom)
		if $$$ProcGetInfoCodeLineCount(query)   $$$liin("do CreateMethod^%apiDDL(%mmmch,"_$$quoter($$$ProcName(query)_"GetInfo")_","_$$quoter($$$ProcGetInfoParams(query))_",.%mcgi,0,""%Library.Status"","""","_+$$$ProcFinal(query)_","_+$$$ProcPrivate(query)_",,,,,,,.SQLCODE) goto:(SQLCODE<0) "_bottom)	// DPV1876 (%Library.Status return type)
		if $$$ProcExecuteCodeLineCount(query)   $$$liin("do CreateMethod^%apiDDL(%mmmch,"_$$quoter($$$ProcName(query)_"Execute")_","_$$quoter($$$ProcExecuteParams(query))_",.%mce,0,""%Library.Status"","""","_+$$$ProcFinal(query)_","_+$$$ProcPrivate(query)_",,,,,,,.SQLCODE) goto:(SQLCODE<0) "_bottom)	// DPV1876 (%Library.Status return type)
		if $$$ProcFetchCodeLineCount(query)     $$$liin("do CreateMethod^%apiDDL(%mmmch,"_$$quoter($$$ProcName(query)_"Fetch")_","_$$quoter($$$ProcFetchParams(query))_",.%mcf,0,""%Library.Status"","""","_+$$$ProcFinal(query)_","_+$$$ProcPrivate(query)_","_$$quoter($$$ProcName(query)_"Execute")_",,,,,,.SQLCODE) goto:(SQLCODE<0) "_bottom)	// DPV1876 (%Library.Status return type)
		if $$$ProcFetchRowsCodeLineCount(query) $$$liin("do CreateMethod^%apiDDL(%mmmch,"_$$quoter($$$ProcName(query)_"FetchRows")_","_$$quoter($$$ProcFetchRowsParams(query))_",.%mcfr,0,""%Library.Status"","""","_+$$$ProcFinal(query)_","_+$$$ProcPrivate(query)_",,,,,,,.SQLCODE) goto:(SQLCODE<0) "_bottom)	// DPV1876 (%Library.Status return type)
		if $$$ProcCloseCodeLineCount(query)     $$$liin("do CreateMethod^%apiDDL(%mmmch,"_$$quoter($$$ProcName(query)_"Close")_","_$$quoter($$$ProcCloseParams(query))_",.%mcc,0,""%Library.Status"","""","_+$$$ProcFinal(query)_","_+$$$ProcPrivate(query)_","_$$quoter($$$ProcName(query)_"Fetch")_",,,,,,.SQLCODE) goto:(SQLCODE<0) "_bottom)	// DPV1876 (%Library.Status return type)
	}
	else {  ##;  Must be a %SQLQuery query
		$$$liin("new %mc set %mc="_$$$ProcMethodCodeLineCount(query))
		for i=1:1:$$$ProcMethodCodeLineCount(query) {
			$$$liin("set %mc("_i_")="_$$quoter($$$ProcMethodCode(query,i)))
		}
		$$$liin("set %mmmch=$$CreateQuery^%apiDDL(%mmmch,"_$$quoter($$$ProcName(query))_","_$$quoter($$$ProcParams(query))_","_$$quoter($$$ProcRowSpec(query))_",.%mc,"""_$$$ProcQueryType(query)_""","_+$$$ProcProcedure(query)_",$Username,"_+$$$ProcFinal(query)_","_$$$ProcContainId(query)_","_$$quoter($$$ProcSelectMode(query))_",.SQLCODE) goto:(SQLCODE<0) "_bottom)
	}
	$$$liin("set %mmmoch=$$Open^%apiCDL("_$$quoter($$$ProcClassName(query))_")")
	$$$liin("if '$$CompileClass^%apiDDL(%mmmch,1,.SQLCODE,1) {")
	$$$liin($c(9)_"if %mmmoch { new %msgsave set %msgsave=$get(%msg) do CompileClass^%apiDDL(%mmmoch,1) set %msg=$get(%msgsave) }")
	$$$liin($c(9)_"goto "_bottom)
	$$$liin("}")
	$$$liin("do:(%mmmoch) Close^%apiCDL(%mmmoch) set SQLCODE=0")
	set tag=bottom
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
 
