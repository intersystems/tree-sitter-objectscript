	$$$liin($c(9)_"try {")
	$$$liin($c(9,9)_"set SQLCODE=0")
	$$$liin($c(9,9)_"do DropAggregate^%apiDDL("_$$quoter($$$UDAFSchema(handle))_","_$$quoter($$$UDAFName(handle))_",.SQLCODE,.%msg,"_$$$UDAFDropIfExists(handle)_")")
	$$$liin($c(9)_"} catch { set SQLCODE=-400,%msg=""Unexpected error executing DROP AGGREGATE: ""_$ze }")
	$$$liin($c(9)_"if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin($c(9)_"RETURN")
	RETURN 
	
	
createtrigger(th) ;
	new bottom,i,line,lines,tag
	do initag set bottom=mtag_"dun"
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("new %tc,%mmmch,%mmmcn,%mmmoch")
	if $$$TriggerCodeLineCount(th) {
		$$$liin("set %tc=" _ $$$TriggerCodeLineCount(th))
		for i=1:1:$$$TriggerCodeLineCount(th) {
			$$$liin("set %tc("_i_")="_$$quoter($$$TriggerCode(th,i)))
		}
	} else {
		$$$liin("new %mmmch,%mmmcn,%mmmoch")
	}
		#; %mmmch is the tablename initially
		#; %mmmch is replaced with a class handle after calling DropTrigger or CreateTrigger
	$$$liin("set SQLCODE=0,%mmmch="_$$quoter($$$TriggerTable(th)))
	if $$$TriggerDropIfExists(th) {
			#; DropTrigger^%apiDDL2(tablename,sqltriggername,trigschema,tabschema,classname,SQLCODE,checkalterpriv=0,ifexists=0,tempdrop=0)
		$$$liin("set %mmmch=$$DropTrigger^%apiDDL2(%mmmch,"_$$quoter($$$TriggerName(th))_","_$$quoter($$$TriggerTrigSchema(th))_","_$$quoter($$$TriggerTabSchema(th))_",.%mmmcn,.SQLCODE,"_$select($$$SQLCompileOption("xDBC")=1:1, $$$SQLCompileOption("DynamicSQL")=1:1, 1:0)_",,1)")
		$$$liin("goto:(SQLCODE<0) "_bottom)
			#; If a class handle is not opened, reset it back to the tablename for CreateTrigger
		$$$liin("set:(%mmmch=0) %mmmch="_$$quoter($$$TriggerTable(th)))
	}
	$$$liin("set %mmmch=$$CreateTrigger^%apiDDL2(%mmmch,"_$$quoter($$$TriggerTrigSchema(th))_","_$$quoter($$$TriggerTabSchema(th))_","_$$quoter($$$TriggerName(th))_","""_$$$TriggerEvent(th)_""","""_$$$TriggerTime(th)_""","""_$$$TriggerOrder(th)_""","""_$$$TriggerLevel(th)_""","""_$$$TriggerLanguage(th)_""","""_$$$TriggerNewName(th)_""","""_$$$TriggerOldName(th)_""",.%tc,.%mmmcn,.SQLCODE,"_$select($$$SQLCompileOption("xDBC")=1:1, $$$SQLCompileOption("DynamicSQL")=1:1, 1:0)_")")
	$$$liin("goto:(SQLCODE<0) "_bottom)
	$$$liin("set %mmmoch=$$Open^%apiCDL(%mmmcn)")
	$$$liin("if '$$CompileClass^%apiDDL(%mmmch,1,.SQLCODE) {")
	$$$liin($c(9)_"if %mmmoch { new %msgsave set %msgsave=$get(%msg) do CompileClass^%apiDDL(%mmmoch,1) set %msg=$get(%msgsave) }")
	$$$liin($c(9)_"goto "_bottom)
	$$$liin("}")
	$$$liin("do:(%mmmoch) Close^%apiCDL(%mmmoch) set SQLCODE=0")
	set tag=bottom
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
 
 
droptrigger(th) ;
	new bottom,i,line,lines,tag
	do initag set bottom=mtag_"dun"
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
		#; DropTrigger^%apiDDL2(tablename,sqltriggername,trigschema,tabschema,classname,SQLCODE,checkalterpriv=0,ifexists=0,tempdrop=0)
	$$$liin("new %mmmch,%mmmcn,%mmmoch")
	$$$liin("set SQLCODE=0,%mmmch=$$DropTrigger^%apiDDL2("_$$quoter($$$TriggerTable(th))_","_$$quoter($$$TriggerName(th))_","_$$quoter($$$TriggerTrigSchema(th))_","_$$quoter($$$TriggerTabSchema(th))_",.%mmmcn,.SQLCODE,"_$select($$$SQLCompileOption("xDBC")=1:1, $$$SQLCompileOption("DynamicSQL")=1:1, 1:0)_","_$$$TriggerDropIfExists(th)_")")
	$$$liin("goto:(%mmmch=0) "_bottom)
	$$$liin("set %mmmoch=$$Open^%apiCDL(%mmmcn)")
	$$$liin("if '$$CompileClass^%apiDDL(%mmmch,1,.SQLCODE) {")
	$$$liin($c(9)_"if %mmmoch { new %msgsave set %msgsave=$get(%msg) do CompileClass^%apiDDL(%mmmoch,1) set %msg=$get(%msgsave) }")
	$$$liin($c(9)_"goto "_bottom)
	$$$liin("}")
	$$$liin("do:(%mmmoch) Close^%apiCDL(%mmmoch) set SQLCODE=0")
	set tag=bottom
	do generateSQLEndCode^%qaqcasl(1)
	RETURN
 
 
call(call) ;
	new i,j,line,lines,tag
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	if ($$$CallContextObject(call)'="") && ($$$CallContextObject(call)'="%sqlcontext") {
		new using
		set using=$$ptvalue^%qaqcpr($$$CallContextObject(call))
		$$$liin("new %sqlcontext"_$$$Calllvars(call)_" set %sqlcontext=$g("_using_") if '$isobject($g("_using_")) { set %sqlcontext=##class(%Library.ProcedureContext).%New() set "_using_"=%sqlcontext }")		// DPV3244 - use %sqlcontext instead of %mmmqh
		for j=1:1:$$$CallCodeLineCount(call) $$$liin($$$CallCode(call,j))
		$$$liin("set SQLCODE=%sqlcontext.%SQLCODE,%ROWCOUNT=%sqlcontext.%ROWCOUNT,%msg=%sqlcontext.%Message kill %sqlcontext")
	}
	else {
		$$$liin($Select($$$Calllvars(call)'="":"new "_$e($$$Calllvars(call),2,*)_" ",1:"")_"if '$isobject($g(%sqlcontext)) { set %sqlcontext=##class(%Library.ProcedureContext).%New() } else { set %sqlcontext.%SQLCODE=0,%sqlcontext.%ROWCOUNT=0,%sqlcontext.%ROWID="""",%sqlcontext.%Message="""" }")		// DPV3244 - use %sqlcontext instead of %mmmqh
		for j=1:1:$$$CallCodeLineCount(call) $$$liin($$$CallCode(call,j))
		$$$liin("set SQLCODE=%sqlcontext.%SQLCODE,%ROWCOUNT=%sqlcontext.%ROWCOUNT,%msg=%sqlcontext.%Message")
	}
	new sqlAuditVars
	do GetSqlAuditVars^%qaqcasl(.sqlAuditVars)
	do generateSQLEndCode^%qaqcasl(,,,.sqlAuditVars)
	$$$liin("RETURN")
	RETURN
 
.
lock(tab) // DPV3300=
	new code,extent,i,j,line,lines,lockMode,tag
	do initag
	set extent=$$$GetExtentNameFromIQN($$$tname(tab))
	if extent="" { new tname set tname=$$$tname(tab) do error(30) }
	set lockMode=($$$tLockMode(tab)="s")
	set code="try { new %mmmsc set SQLCODE=0,%mmmsc=##class("_extent_").%SQLAcquireTableLock("_lockMode_",.SQLCODE,"_$$$tLockTimeout(tab)_") set:SQLCODE<0 %msg=""Unable to acquire "_$s(lockMode:"shared",1:"exclusive")_" table-level lock for table '"_$$$tname(tab)_"'""} "
	set code=code_"catch { set SQLCODE=-400,%msg=""Unexpected error attempting to LOCK TABLE "_$$$tname(tab)_" :: ""_$ze }"
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin(code)
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
 
.
unlock(tab) // DPV3300=
	new code,extent,i,j,line,lines,lockMode,tag,unlockMode
	do initag
	set extent=$$$GetExtentNameFromIQN($$$tname(tab))
	if extent="" { new tname set tname=$$$tname(tab) do error(30) }
	set lockMode=($$$tLockMode(tab)="s")
	set unlockMode=($$$tUnlockMode(tab)="i")
	set code="try { new %mmmsc set SQLCODE=0,%mmmsc=##class("_extent_").%SQLReleaseTableLock("_lockMode_","_unlockMode_") }"
	set code=code_"catch { set SQLCODE=-400,%msg=""Unexpected error attempting to UNLOCK TABLE "_$$$tname(tab)_" :: ""_$ze }"
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin(code)
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
.
.
tune(name)
	new code,extent,func,i,j,line,lines,lockMode,schema,tag
	do initag
	set schema=$$$SCHECKop(name,"tune")
	if 'schema {
		set extent=$$$GetExtentNameFromIQN($$$tname(name))
		if extent="" { new tname set tname=$$$tname(name) do error(30) }
		set func="do TuneTable^%apiSQL("_$$$QN($$$tname(name))_",1,0,.%mmmmsg,"_$$$tTuneKeepUpToDate(name)_","_$$$tTuneClearValues(name)_",,,"_$$$tTuneRecompileCQ(name)_","_$$$tTuneSamplePercent(name)_",.SQLCODE)"
	} else {
		set func="do TuneSchema^%apiSQL("_$$$QuoteName(name)_",1,0,.%mmmmsg,,0,,0,"_$$$tTuneSamplePercent(name)_")"
	}
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("try {")
	$$$liin($c(9)_"new %mmmmsg set SQLCODE=0 "_func)
	$$$liin($c(9)_"if SQLCODE=0,$g(%mmmmsg)'="""" { set SQLCODE=-400,%msg=%mmmmsg }")
	$$$liin("} catch {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error attempting to collect statistics for "_$s(schema:"schema '"_name,1:"table '"_$$$tname(name))_"' :: ""_$ze")
	$$$liin("}")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
 
dropStats(name)
	new code,extent,i,j,line,lines,tag,schema
	do initag
	set schema=($$$Dop="drop schema stats")
	if 'schema {
		set extent=$$$GetExtentNameFromIQN($$$tname(name))
		if extent="" { new tname set tname=$$$tname(name) do error(30) }
	}
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("try {")
	$$$liin($c(9)_"new %mmmmsg set SQLCODE=0 do Tune"_$s(schema:"Schema^%apiSQL("_$$$QuoteName(name),1:"Table^%apiSQL("_$$$QN($$$tname(name)))_",1,0,.%mmmmsg,1,1,,,"_$s(schema:",.SQLCODE)",1:"0,,.SQLCODE)"))
	$$$liin($c(9)_"if $g(%mmmmsg)'="""" { set %msg=%mmmmsg  set:SQLCODE=0 SQLCODE=-400 }")
	$$$liin("} catch {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error attempting to drop "_$s(schema:"schema",1:"table")_" statistic '"_$s(schema:name,1:$$$tname(name))_"' :: ""_$ze")
	$$$liin("}")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
.
fixStats(name)
	new code,extent,i,j,line,lines,tag,schema
	do initag
	set schema=($$$Dop="fix schema stats")
	if 'schema {
		set extent=$$$GetExtentNameFromIQN($$$tname(name))
		if extent="" { new tname set tname=$$$tname(name) do error(30) }
	}
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("try {")
	$$$liin($c(9)_"new %mmmmsg,%mmmsc set SQLCODE=0 set %mmmsc=$$Set"_$s(schema:"Schema",1:"Table")_"FixedStats^%qarTune("_$$$QuoteName(name)_")")
	$$$liin($c(9)_"if '%mmmsc { set SQLCODE=$system.Status.StatusToSQLCODE(%mmmsc),%msg=$system.Status.GetErrorText(%mmmsc) RETURN }")
	$$$liin("} catch {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error attempting to fix "_$s(schema:"schema",1:"table")_" statistic '"_$s(schema:name,1:$$$tname(name))_"' :: ""_$ze")
	$$$liin("}")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
.
setTableStatsProp(name)
	new code,cls,prop,value,i,j,line,lines,tag,schema
	do initag
	set schema=($$$Dop="set schema stats prop")
	if 'schema{
		set cls=$$$GetClassNameFromIQN($$$tname(name))
		if cls="" { new tname set tname=$$$tname(name) do error(30) }
	}
	if $$$tTableStatsProp(name,"IGNOREFIXEDSTATS")'=""{
		set prop="IgnoreFixedStats"  
		set value=$$$tTableStatsProp(name,"IGNOREFIXEDSTATS")
	} else {
		set prop="SkipAutomaticStatsCollection" 
		set value=$$$tTableStatsProp(name,"SKIPAUTOMATICSTATSCOLLECTION")
	}
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("try {")
	$$$liin($c(9)_"new %mmmsc  set SQLCODE=0")
	$$$liin($c(9)_"set %mmmsc=$$Set"_$s(schema:"Schema",1:"Table")_"RuntimeTableStatsProp^%qarTune("_$$$QuoteName(name)_","""_prop_""","_value_")")
	$$$liin($c(9)_"if '%mmmsc { set SQLCODE=-400,%msg=$system.Status.GetErrorText(%mmmsc) RETURN }")
	$$$liin("} catch {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error attempting to set "_prop_" to "_$s(value:"TRUE",1:"FALSE")_" for "_$s(schema:"schema '"_name,1:"table '"_$$$tname(name))_"' :: ""_$ze")
	$$$liin("}")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
.
CreateDatabase(pDB,createDatabaseFile=0) // DPV4293= JMM1298=
	new code,line,lines,tag,tDirectory,tProperties
	do initag
	set tDirectory=$$$DatabaseDirectory(pDB)
	set tProperties=""
	if $$$EncryptedDB(pDB)'="" { set tProperties=tProperties_"set %mmmdbprop(""EncryptedDB"")=1" }
	if $$$GlobalJournalState(pDB)'="" { set tProperties=tProperties_$e(" ",tProperties'="")_"set %mmmdbprop(""GlobalJournalState"")="_$$$GlobalJournalState(pDB) }
	$$$liin(" // CREATE DATABASE "_$$$DatabaseName(pDB))
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("try {")
	$$$liin($c(9)_"set SQLCODE=0 new %mmmdbprop")
	if tProperties'="" { $$$liin($c(9)_tProperties) }
	$$$liin($c(9)_"do CreateDatabase^%SYS.SQLSEC("_$$quoter($$$DatabaseName(pDB))_","_$$quoter(tDirectory)_",.%mmmdbprop,.SQLCODE,.%msg,"_createDatabaseFile_")") // JMM1298=
	$$$liin("}")
	$$$liin("catch {")
	$$$liin("set SQLCODE=-400,%msg=""Unexpected error attempting to CREATE DATABASE "_$$$DatabaseName(pDB)_" :: ""_$ze")
	$$$liin("}")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
.
DropDatabase(pDB) // DPV4293=
	new code,line,lines,tag,tDirectory
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	do GenerateAuditCode^%qaqcasl(%sqlAudit)
	set tDirectory=$$$DatabaseDirectory(pDB)
	$$$liin(" // DROP DATABASE "_$$$DatabaseName(pDB))
	$$$liin("try {")
	$$$liin($c(9)_"set SQLCODE=0 do DeleteDatabase^%SYS.SQLSEC("_$$quoter($$$DatabaseName(pDB))_","_($$$RetainFiles(pDB)=1)_",.SQLCODE,.%msg,"_$$$DatabaseDropIfExists(pDB)_")")
	$$$liin("}")
	$$$liin("catch {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error attempting to DROP DATABASE "_$$$DatabaseName(pDB)_" :: ""_$ze")
	$$$liin("}")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
.
UseDatabase(pDB) // DPV4333=
	new code,line,lines,tag,tDirectory
	do initag
	set tDirectory=$$$DatabaseDirectory(pDB)
	set code=" // USE DATABASE "_$$$DatabaseName(pDB) $$$liin(code)
	set code="try {" $$$liin(code)
	set code=$c(9)_"set SQLCODE=0 do UseDatabase^%SYS.SQLSEC("_$$quoter($$$DatabaseName(pDB))_",.SQLCODE,.%msg)" $$$liin(code)           // DPV5014
	set code="}" $$$liin(code)
	set code="catch {"  $$$liin(code)
	set code=$c(9)_"set SQLCODE=-400,%msg=""Unexpected error attempting to USE DATABASE "_$$$DatabaseName(pDB)_" :: ""_$ze"  $$$liin(code)
	set code="}" $$$liin(code)
	do GenerateAuditCode^%qaqcasl(%sqlAudit)
	set code="QUIT" $$$liin(code)
	QUIT
.
.
vugen	new compileafter,i,j,line,lines,mod,NAME,name,tag  ;  CREATE/ALTER/DROP VIEW code
	do initag  ;  initialize code generation
	set NAME=$o(mt("view","")),name=mt("view",NAME)
	#; Code generate CREATE VIEW
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	if $$$mtStatementType="CRV" {
		$$$liin("TSTART")
		$$$liin("try {")
		$$$liin($c(9)_"new %mmmqt")
			#;  --- Append AS-List Lines To Top ---
		if $d(%viewas("as")) { for i=1:1:%viewas("as") { $$$liin($c(9)_"set %mmmqt("_i_")="_$$quoter(%viewas("as",i))) }}
		
		// If the view query is too long we need to break it up or the cached query won't be compiled
		// We'll just concatenate the same node of %mmmqt on different lines
		new lineOffset, lineLength
		for i=1:1:$$$mtQueryCount { 
			$$$liin($c(9)_"set %mmmqt("_(i+$g(%viewas("as")))_")="_$$quoter($$space($e($$$mtQueryText(i),1,$$$MaxRtnLineLength)))) // set the first chunk
			set lineLength = $l($$$mtQueryText(i))
			for lineOffset=($$$MaxRtnLineLength+1):$$$MaxRtnLineLength { 
				quit:lineOffset>lineLength
				$$$liin($c(9)_"set %mmmqt("_(i+$g(%viewas("as")))_")=%mmmqt("_(i+$g(%viewas("as")))_")_"_$$quoter($e($$$mtQueryText(i),lineOffset,lineOffset+$$$MaxRtnLineLength-1)))
			}
			
		}
		set compileafter="",i="" 
		for  {
			set i=$o($$$mtFromTableName(i)) quit:i=""  
			if $e($$$mtFromTableName(i),1,3)'="%%Q",$e($$$mtFromTableName(i))'=$c(1),$p($$$mtFromTableName(i),".",1,$l($$$mtFromTableName(i),".")-1)'="" { set j=$$$GetClassNameFromIQN($$$mtFromTableName(i)) set:j'="" compileafter(j)="" }
		}
		set i=""
		for j=1:1 { set i=$o(compileafter(i)) quit:i=""  set $p(compileafter,",",j)=$$quoter(i) }
		set compileafter="$lb("_compileafter_")"
			#;    call:  CreateView^%apiDDL2(viewname,owner,.query,compileafter,checkoption,readonly,pReplaceView,pExistingClassHandle,.SQLCODE)
		$$$liin($c(9)_"set %mmmqt="_($$$mtQueryCount+$g(%viewas("as")))_",SQLCODE=0")
		$$$liin($c(9)_"new %mmmch,%mmmoch,%mmmsc")
		$$$liin($c(9)_"set %mmmoch=$$Open^%apiDDL("_$$quoter(name)_",,,1)")
		$$$liin($c(9)_"set %mmmch=$$CreateView^%apiDDL2("_$$quoter(name)_",$Username,.%mmmqt,"_compileafter_","_$$quoter($g(mt("view",NAME,"check option")))_","_($g(mt("view",NAME,"updatable"))=0)_","_($g(mt("view",NAME,"replace"))=1)_",%mmmoch,.SQLCODE)")
		$$$liin($c(9)_"if '%mmmch { do:%mmmoch Close^%apiDDL(%mmmoch) quit }")                                                // CreateView failed, get out
			#;  Compile the class
			#;  If there is an error compiling the class, we try to delete the class.
		$$$liin($c(9)_"if '$$compile^%apiDDL("_$$quoter(name)_",%mmmch,.SQLCODE,,,,"_$$quoter($g(%caller))_") { }")           // Compile failed for view class.  SQLCODE should have been set if error
		$$$liin($c(9)_"do:%mmmoch Close^%apiDDL(%mmmoch)")
		$$$liin($c(9)_"do:%mmmch Close^%apiDDL(%mmmch)")
		$$$liin("} catch {")
		$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error occurred in generated CREATE VIEW code:""_$ze" )
		$$$liin("}")
		$$$liin("if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("RETURN")
		RETURN
	}
	
	#; Code Generate DROP VIEW   Call:  DropView^%apiDDL(viewname,behave,deldata,.SQLCODE,ifexists)
	#;	DropView(viewname,behave,SQLCODE,noddlcheck)	
 
	if $$$mtStatementType="DRV" {
		new behave
		set behave="RESTRICT"
		set:$g(mt("view",NAME,"behave"))'="" behave=mt("view",NAME,"behave")
		$$$liin("new %sc set SQLCODE=0,%sc=$$DropView^%apiDDL("_$$quoter(name)_","_$$quoter(behave)_",.SQLCODE,0,.%msg,"_mt("view",NAME,"check exists")_")")
		do generateSQLEndCode^%qaqcasl(1)
		$$$liin("RETURN")
		RETURN
	}
	
	  #; Code Generate ALTER VIEW
	new classname
	$$$liin("TSTART")
	$$$liin("try {")
	$$$liin($c(9)_"new %mmmch")
	$$$liin($c(9)_"set SQLCODE=0,%mmmch=$$Open^%apiDDL("_$$quoter(name)_",.SQLCODE,,,1,,,,3) quit:SQLCODE<0||(%mmmch=0)")
	$$$liin($c(9)_"new %mmmqt,%mmmsc")
	if $d(%viewas("as")) {
		for i=1:1:%viewas("as") { $$$liin($c(9)_"set %mmmqt("_i_")="_$$quoter(%viewas("as",i))) }
	}
	for i=1:1:$$$mtQueryCount { $$$liin($c(9)_"set %mmmqt("_(i+$g(%viewas("as")))_")="_$$quoter($$space($$$mtQueryText(i)))) }
	set compileafter="",i=""
	for  {
		set i=$o($$$mtFromTableName(i)) quit:i=""  
		if $e($$$mtFromTableName(i),1,3)'="%%Q" { set classname=$$$GetClassNameFromIQN($$$mtFromTableName(i)) set:classname'="" compileafter(classname)="" }
	}
	set i=""
	for j=1:1 { set i=$o(compileafter(i)) quit:i=""  set $p(compileafter,",",j)=$$quoter(i) }
	set compileafter="$lb("_compileafter_")"
		#;    call:  AlterView^%apiDDL2(viewname,classhandle,.query,compileafter,checkoption,readonly,.SQLCODE)
	$$$liin($c(9)_"set %mmmqt="_($$$mtQueryCount+$g(%viewas("as"))))
	$$$liin($c(9)_"set %mmmsc=$$AlterView^%apiDDL2("_$$quoter(name)_",%mmmch,.%mmmqt,"_compileafter_","_$$quoter($g(mt("view",NAME,"check option")))_","_($g(mt("view",NAME,"updatable"))=0)_",.SQLCODE)")
	$$$liin($c(9)_"if '%mmmsc { do Close^%apiDDL(%mmmch) quit }")
	$$$liin($c(9)_"if '$$compile^%apiDDL("_$$quoter(name)_",%mmmch,.SQLCODE) {}")          // compile should have closed %mmmch
	$$$liin("} catch {")
	$$$liin($c(9)_"set SQLCODE=-400,%msg=""Unexpected error occurred in generated CREATE VIEW code:""_$ze" )
	$$$liin("}")
	$$$liin("if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
 
 
createmodel(model) ;  generate CREATE MODEL [ IF NOT EXISTS ] code
	new checkpriv,colctr,datafields,fields,fld,fldord,flist,i,index,j,key,psize,quotab,ref,tParam,xx,withcol,withcoltype
	do initag
		#;   now start the actual processing - 
		#;   first define the model class
		#;    call:  CreateModel(modelname,modelcolumn,modelcolumntype,&withcolumns,&query,using,&SQLCODE,&%msg)
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin($c(9)_"set SQLCODE=0")
	if $$$ModelIfExists(model) { $$$liin($c(9)_"RETURN:(##class(%ML.Model).NameIndexExists("_$$quoter(model)_"))") }
	$$$liin($c(9)_"TSTART")
	$$$liin($c(9)_"try {")
	$$$liin($c(9,9)_"new %mmmquery,%mmmusing,%mmmwithcols")
	set colctr=""
	for  {
		set colctr=$o(mtd("model",model,"with",colctr)) quit:colctr=""
		set withcol=mtd("model",model,"with",colctr,"column")
		set withcoltype=mtd("model",model,"with",colctr,"columntype")
		$$$liin($c(9,9)_"set %mmmwithcols("_colctr_")=$lb("_$$quoter(withcol)_","_$$quoter(withcoltype)_")")
	}
	for i=1:1:$g($$$mtQueryCount) { // should be only 1 query per model, but perhaps some day we allow more?
		$$$liin($c(9,9)_"set %mmmquery("_i_")="_$$quoter($$$mtQueryText(i)))
	}
	if $$$ModelUsing(model)'="" {
		$$$liin($c(9,9)_"set %mmmusing="_$$quoter($$$ModelUsing(model)))
	}
	if $$$SQLCompileOption("xDBC")=1||($$$SQLCompileOption("DynamicSQL")=1) { set checkpriv=1 } else { set checkpriv=0 }
	$$$liin($c(9,9)_"do CreateModel^%apiDDL("_$$quoter($$$ModelName(model))_","_$$quoter($$$ModelColumn(model))_","_$$quoter($$$ModelColumnType(model))_",.%mmmwithcols,.%mmmquery,$g(%mmmusing),"_$$quoter($$$ModelTSSelected(model))_","_$$quoter($$$ModelDateColumn(model))_","_checkpriv_",.SQLCODE,.%msg)")
	$$$liin($c(9)_"} catch ex { set SQLCODE=ex.AsSQLCODE(),%msg=ex.SQLMessageString() }")
	$$$liin($c(9)_"if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin($c(9)_"RETURN")
	RETURN
.
altermodel(model) ;  generate ALTER MODEL code
	do initag
		#;    call:  AlterModel(modelname,purgedays="",trainedmodelname,&SQLCODE,&%msg)
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin($c(9)_"TSTART")
	$$$liin($c(9)_"try {")
	$$$liin($c(9,9)_"set SQLCODE=0")
	$$$liin($c(9,9)_"do AlterModel^%apiDDL("_$$quoter($$$ModelName(model))_","_$$quoter($$$ModelPurgeDays(model))_","_$$quoter($$$ModelDefaultTrainedModel(model))_",.SQLCODE,.%msg)")
	$$$liin($c(9)_"} catch {")
	$$$liin($c(9,9)_"set SQLCODE=-400,%msg=""Unexpected error executing ALTER MODEL: ""_$ze" )
	$$$liin($c(9)_"}")
	$$$liin($c(9)_"if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin($c(9)_"RETURN")
	RETURN
.
dropmodel(model) ;  generate DROP MODEL code
	do initag
		#;    call:  DropModel(modelname,&SQLCODE,&%msg,ifexists=0)
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin($c(9)_"TSTART")
	$$$liin($c(9)_"try {")
	$$$liin($c(9,9)_"set SQLCODE=0")
	$$$liin($c(9,9)_"do DropModel^%apiDDL("_$$quoter($$$ModelName(model))_",.SQLCODE,.%msg,"_$$$ModelIfExists(model)_")")
	$$$liin($c(9)_"} catch {")
	$$$liin($c(9,9)_"set SQLCODE=-400,%msg=""Unexpected error executing DROP MODEL: ""_$ze" )
	$$$liin($c(9)_"}")
	$$$liin($c(9)_"if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin($c(9)_"RETURN")
	RETURN
.
trainmodel(model) ;  generate TRAIN MODEL code
	new checkpriv,cnt,colctr,selectreplace,withcol,withcolexpr,withcoltype
	do initag
		#;    call:  TrainModel(modelname,modelcolumnname,&withcolumns,&query,using="",trainedname="",notdefault=0,&SQLCODE,&%msg) [defaultquery,modelid,modelname,provider]
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	//$$$liin($c(9)_"TSTART")
	$$$liin($c(9)_"try {")
	$$$liin($c(9,9)_"new %mmmquery,%mmmusing,%mmmwithcols")
	$$$liin($c(9,9)_"set SQLCODE=0")
	set colctr="",selectreplace=0,cnt=0
	for {
		set colctr=$o(mtd("model",model,"with",colctr)) quit:colctr=""
		set withcol=$$$ModelWithColumn(model,colctr),cnt=cnt+1
		set withcolexpr=$$$ModelWithColumnExpression(model,colctr)
		if withcolexpr'="" { set selectreplace=2 $$$liin($c(9,9)_"set %mmmwithcols("_$$quoter($$$UPPER(withcol))_")=$lb("_$$quoter(withcol)_","_$$quoter(withcolexpr)_")") }	// WITH cvalue=expr,...		replaced named select-list items
		else               { set selectreplace=1 $$$liin($c(9,9)_"set %mmmwithcols("_colctr_")=$lb("_$$quoter(withcol)_")") }							// WITH (expr,...)		replacing entire select list
	}
	if selectreplace=1 { $$$liin($c(9,9)_"set %mmmwithcols="_cnt) }
	for i=1:1:$g($$$mtQueryCount) { // should be only 1 query per model, but perhaps some day we allow more?
		if i=1 { $$$liin($c(9,9)_"set %mmmquery="_$g($$$mtQueryCount)) }
		$$$liin($c(9,9)_"set %mmmquery("_i_")="_$$quoter($$$mtQueryText(1)))
	}
	if $$$ModelUsing(model)'="" {
		$$$liin($c(9,9)_"set %mmmusing="_$$quoter($$$ModelUsing(model)))
	}
	if $$$SQLCompileOption("xDBC")=1||($$$SQLCompileOption("DynamicSQL")=1) { set checkpriv=1 } else { set checkpriv=0 }
	$$$liin($c(9,9)_"do TrainModel^%apiDDL("_$$quoter($$$ModelName(model))_","_$$quoter($$$ModelColumn(model))_",.%mmmwithcols,.%mmmquery,$g(%mmmusing),"_$s($$$ModelTrainedName(model)="":"",1:$$quoter($$$ModelTrainedName(model)))_","_''$$$ModelTrainNotDefault(model)_","_checkpriv_",.SQLCODE,.%msg)")
	$$$liin($c(9)_"} catch {")
	$$$liin($c(9,9)_"set SQLCODE=-400,%msg=""Unexpected error executing TRAIN MODEL: ""_$ze" )
	$$$liin($c(9)_"}")
	//$$$liin($c(9)_"if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin($c(9)_"RETURN")
	RETURN
	
	
validatemodel(model) ;  generate VALIDATE MODEL code
	new checkpriv,cnt,colctr,selectreplace,withcol,withcolexpr,withcoltype
	do initag
		#;    call:  ValidateModel(modelname,&withcolumns,&query,using="",trainedname="",&SQLCODE,&%msg) [defaultquery,modelid,modelname,provider]
	//$$$liin($c(9)_"TSTART")
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin($c(9)_"try {")
	$$$liin($c(9,9)_"new %mmmquery,%mmmusing,%mmmwithcols")
	$$$liin($c(9,9)_"set SQLCODE=0")
	set colctr="",selectreplace=0
	for cnt=1:1 {
		set colctr=$o(mtd("model",model,"with",colctr)) quit:colctr=""
		set withcol=$$$ModelWithColumn(model,colctr)
		set withcolexpr=$$$ModelWithColumnExpression(model,colctr)
		if withcolexpr'="" { set selectreplace=2 $$$liin($c(9,9)_"set %mmmwithcols("_$$quoter($$$UPPER(withcol))_")=$lb("_$$quoter(withcol)_","_$$quoter(withcolexpr)_")") }	// WITH cvalue=expr,...		replaced named select-list items
		else               { set selectreplace=1 $$$liin($c(9,9)_"set %mmmwithcols("_colctr_")=$lb("_$$quoter(withcol)_")") }							// WITH (expr,...)		replacing entire select list
	}
	if selectreplace=1 { $$$liin($c(9,9)_"set %mmmwithcols="_cnt) }
	for i=1:1:$g($$$mtQueryCount) { // should be only 1 query per model, but perhaps some day we allow more?
		if i=1 { $$$liin($c(9,9)_"set %mmmquery="_$g($$$mtQueryCount)) }
		$$$liin($c(9,9)_"set %mmmquery("_i_")="_$$quoter($$$mtQueryText(1)))
	}
	if $$$ModelUsing(model)'="" {
		$$$liin($c(9,9)_"set %mmmusing="_$$quoter($$$ModelUsing(model)))
	}
	if $$$SQLCompileOption("xDBC")=1||($$$SQLCompileOption("DynamicSQL")=1) { set checkpriv=1 } else { set checkpriv=0 }
	$$$liin($c(9,9)_"do ValidateModel^%apiDDL("_$$quoter($$$ModelName(model))_","_$s($$$ModelTrainedName(model)="":"",1:$$quoter($$$ModelTrainedName(model)))_",.%mmmwithcols,.%mmmquery,$g(%mmmusing),"_$s($$$ModelValidationName(model)="":"",1:$$quoter($$$ModelValidationName(model)))_","_checkpriv_",.SQLCODE,.%msg)")
	$$$liin($c(9)_"} catch {")
	$$$liin($c(9,9)_"set SQLCODE=-400,%msg=""Unexpected error executing VALIDATE MODEL: ""_$ze" )
	$$$liin($c(9)_"}")
	//$$$liin($c(9)_"if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin($c(9)_"RETURN")
	RETURN
.
createmlconfig(mlconfig) ;  generate CREATE [ OR REPLACE ] ML CONFIGURATION code
	new provider
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin($c(9)_"TSTART")
	$$$liin($c(9)_"try {")
	$$$liin($c(9,9)_"new %mmmsc,%mmmusing")
	$$$liin($c(9,9)_"set SQLCODE=0")
	if $$$MLConfigurationIfExists(mlconfig),##class(%SYS.ML.Configuration).NameIndexExists($$$MLConfigurationName(mlconfig)) {
			#; Adapted from dropmlconfig
		$$$liin($c(9,9)_"set %mmmsc=##class(%SYS.ML.Configuration).%Remove("_$$quoter($$$MLConfigurationName(mlconfig))_", 1)")
		$$$liin($c(9,9)_"if '%mmmsc {")
		$$$liin($c(9,9,9)_"set %msg = $$ProcessError^%apiDDL(%mmmsc,.SQLCODE)")
		$$$liin($c(9,9,9)_"TROLLBACK 1")  ##; Do something to close the transaction
		$$$liin($c(9,9,9)_"RETURN")
		$$$liin($c(9,9)_"}")
	}
	if $$$MLConfigurationUsingDefined(mlconfig) {
		$$$liin($c(9,9)_"set %mmmusing="_$$quoter($$$MLConfigurationUsing(mlconfig)))
	}
	set provider=$$$LOWER($$$MLConfigurationProvider(mlconfig))
	if provider="datarobot" {
		$$$liin($c(9,9)_"set %mmmsc=##class(%SYS.ML.DataRobot.Configuration).%Create("_$$quoter($$$MLConfigurationName(mlconfig))_","_$$quoter($$$MLConfigurationDescription(mlconfig))_",$g(%mmmusing),$username,"_$$quoter($$$MLConfigurationUrl(mlconfig))_","_$$quoter($$$MLConfigurationApiToken(mlconfig))_")")
	} else {
		if $$$MLConfigurationUrl(mlconfig)'="" { new option set option="url" do error(188) }			// only allowed for DataRobot
		if $$$MLConfigurationApiToken(mlconfig)'="" { new option set option="apiToken" do error(188) }		// only allowed for DataRobot
	}
	if provider="h2o" {
		$$$liin($c(9,9)_"set %mmmsc=##class(%SYS.ML.H2O.Configuration).%Create("_$$quoter($$$MLConfigurationName(mlconfig))_","_$$quoter($$$MLConfigurationDescription(mlconfig))_",$g(%mmmusing),$username,"_$$quoter($$$MLConfigurationJavaTLSConfigFile(mlconfig))_")")
	} else {
		if $$$MLConfigurationJavaTLSConfigFile(mlconfig)'="" { new option set option="javaTLSConfigFile" do error(188) }  // only allowed for H2O
	}
	if provider="automl" {
		$$$liin($c(9,9)_"set %mmmsc=##class(%SYS.ML.AutoML.Configuration).%Create("_$$quoter($$$MLConfigurationName(mlconfig))_","_$$quoter($$$MLConfigurationDescription(mlconfig))_",$g(%mmmusing),$username)")
	} elseif provider="pmml" {
		$$$liin($c(9,9)_"set %mmmsc=##class(%SYS.ML.PMML.Configuration).%Create("_$$quoter($$$MLConfigurationName(mlconfig))_","_$$quoter($$$MLConfigurationDescription(mlconfig))_",$g(%mmmusing),$username)")
	}
	$$$liin($c(9,9)_"if '%mmmsc {")
	$$$liin($c(9,9,9)_"if $lg($lg($e(%mmmsc,3,*)),1,0)=5808 { set SQLCODE=-192,%msg=""ML Configuration '""_"_$$quoter($$$MLConfigurationName(mlconfig))_"_""' is not unique"" }")
	$$$liin($c(9,9,9)_"else { set %msg=$$ProcessError^%apiDDL(%mmmsc,.SQLCODE) }")
	$$$liin($c(9,9)_"}")
	$$$liin($c(9)_"} catch ex { set SQLCODE=ex.AsSQLCODE(),%msg=ex.SQLMessageString() }")
	$$$liin($c(9)_"if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin($c(9)_"RETURN")
	RETURN
.
altermlconfig(mlconfig) ;  generate ALTER ML CONFIGURATION code
	new call
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin($c(9)_"TSTART")
	$$$liin($c(9)_"try {")
	$$$liin($c(9,9)_"new %mmmex,%mmmusing")
	$$$liin($c(9,9)_"set SQLCODE=0")
	if $$$MLConfigurationUsingDefined(mlconfig) {
		$$$liin($c(9,9)_"set %mmmusing="_$$quoter($$$MLConfigurationUsing(mlconfig)))
	}
	set call="set SQLCODE=##class(%SYS.ML.Configuration).%SQLAlter("_$$quoter($$$MLConfigurationName(mlconfig))_","
	set call=call_$s($$$MLConfigurationProviderDefined(mlconfig):$$quoter($$$MLConfigurationProvider(mlconfig)),1:"")_","
	set call=call_$s($$$MLConfigurationDescriptionDefined(mlconfig):$$quoter($$$MLConfigurationDescription(mlconfig)),1:"")_","
	set call=call_$s($$$MLConfigurationUsingDefined(mlconfig):"%mmmusing",1:"")_","
	set call=call_$s($$$MLConfigurationJavaTLSConfigFileDefined(mlconfig):$$quoter($$$MLConfigurationJavaTLSConfigFile(mlconfig)),1:"")_","
	set call=call_$s($$$MLConfigurationUrlDefined(mlconfig):$$quoter($$$MLConfigurationUrl(mlconfig)),1:"")_","
	set call=call_$s($$$MLConfigurationApiTokenDefined(mlconfig):$$quoter($$$MLConfigurationApiToken(mlconfig)),1:"")_","
	$$$liin($c(9,9)_call_".%msg)")
	$$$liin($c(9)_"} catch %mmmex { set SQLCODE=%mmmex.AsSQLCODE(),%msg=%mmmex.SQLMessageString() }")
	$$$liin($c(9)_"if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin($c(9)_"RETURN")
	RETURN
.
dropmlconfig(mlconfig) ;  generate DROP ML CONFIGURATION code
	do initag
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin($c(9)_"TSTART")
	$$$liin($c(9)_"try {")
	$$$liin($c(9,9)_"new %mmmsc")
	$$$liin($c(9,9)_"set SQLCODE=0")
	$$$liin($c(9,9)_"set %mmmsc=##class(%SYS.ML.Configuration).%Remove("_$$quoter($$$MLConfigurationName(mlconfig))_")")
	$$$liin($c(9,9)_"if '%mmmsc {")
	if $$$MLConfigurationIfExists(mlconfig) {
		$$$liin($c(9,9,9)_"if $lg($lg($e(%mmmsc,3,*)),1,0)=2823 { set SQLCODE=0,%msg="""" }")
	} else {
		$$$liin($c(9,9,9)_"if $lg($lg($e(%mmmsc,3,*)),1,0)=2823 { set SQLCODE=-187,%msg=""ML Configuration '""_"_$$quoter($$$MLConfigurationName(mlconfig))_"_""' not found"" }")
	}
	$$$liin($c(9,9,9)_"elseif $lg($lg($e(%mmmsc,3,*)),1,0)=2825 { set SQLCODE=-189,%msg=""Cannot DROP ML Configuration '""_"_$$quoter($$$MLConfigurationName(mlconfig))_"_""' because it is the system default configuration"" }")
	$$$liin($c(9,9,9)_"else { set %msg=$$ProcessError^%apiDDL(%mmmsc,.SQLCODE) }")
	$$$liin($c(9,9)_"}")
	$$$liin($c(9)_"} catch {")
	$$$liin($c(9,9)_"set SQLCODE=-400,%msg=""Unexpected error executing DROP MODEL: ""_$ze" )
	$$$liin($c(9)_"}")
	$$$liin($c(9)_"if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin($c(9)_"RETURN")
	RETURN
