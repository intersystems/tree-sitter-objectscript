====
qaqcDDLCodeGen
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqcDDLCodeGen^MAC^^^0
%qaqcDDLCodeGen	// IRIS SQL Code Generation for DDL
	;; COMPONENTS :: SQL/CodeGeneration/DDL
	#;
#INCLUDE %msql
#INCLUDE %qapddl  ;  DDL parse tree inlcude file
	#;
#IF 0   ;
	;-------------------------------------------------------------
	; Description:   Code generator for IRIS SQL DDL
	; Author:        David Van De Griek
	; Date:          December 30, 1997
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;  DPV3361 (02/17/2009) - Enhancements for CALL support
	;  DPV3337 (01/08/2009) - New index in crttab
	;  DPV3300 (10/22/2008) - Implement LOCK/UNLOCK TABLE statements
	;  DPV3263 (09/22/2008) - Support MySQL DDL Script file import
	;  DPV3244 (08/11/2008) - SQL: Embedded CALL statement NEW's %sqlcontext 
	;  DPV3102 (02/11/2008) - Support ALTER TABLE <tabname> ALTER COLUMN <colname> COLLATE <collation>
	;  DPV3083 (12/13/2007) - Remove FetchODBC methods
	;  DPV3016 (09/12/2007) - Fix FOR SOME %ELEMENT(Field) in WHERE clause of CREATE VIEW statement
	;  DPV2881 (03/14/2007) - Report error in AddIndex if field does not exist, Move DropConstraint to %apiDDL2
	;  DPV2816 (12/11/2006) - Don't set error variables when opening class we don't care if it exists
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  DPV2672 (06/23/2006) - Add support for statement level triggers
	;  DPV2664 (05/26/2006) - New xx in method
	;  DPV2619 (04/12/2006) - Add support for Global Temporary Tables
	;  DPV2571 (01/13/2005) - Add support for NOCHECK DDL CompileMode
	;  DPV2532 (10/11/2005) - Fix CALL with expressions passed as arguments
	;                         SQL Fix ProdLog 46406: Compiling SQL: <UNDEFINED>davalue+2^%qaqcpr
	;  DPV2512 (09/09/2005) - Restructure mt("view")
	;                         SQL Fix ProdLog 45792: View Creation WITH CHECK OPTION FAILS
	;  DPV2507 (09/02/2005) - Support RESTRICT and CASCADE for Drop View
	;  DPV2405 (08/31/2005) - Fix checking for ownership of class for Stored Proc - pass %msg by ref
	;                         SQL Fix ProdLog 45421: stored procedures: security hole IV: user can DROP PROCEDURE without having a privilege to do that
	;  DPV2438 (05/31/2005) - Move UpdateField code to %apiDDL2
	;  DPV2427 (05/10/2005) - Lock table before altering or dropping table.
	;  DPV2399 (04/04/2005) - Fix missing=2 on setting of %mmmclist.
	;                         SQL Fix ProdLog 42295: alter table add constraint gives Fatal Error
	;  DPV2389 (03/17/2005) - Fix extra comma in one of the %mmmclist parameters added by DPV2369
	;                         SQL Fix ProdLog 41919: ALTER TABLE results in <PARAMETER>compile^%apiDDL
	;  DPV2383 (03/11/2005) - Return error code for SET OPTIONs that require privileges
	;                         SQL Fix ProdLog 41574:  In ODBC, user without %Manager can modify configuration setting
	;  DPV2380 (03/08/2005) - Fix SQLCODE error reported by bad SET OPTION
	;  DPV2369 (02/17/2005) - Recompile all view classes which project views that use the table being altered if the initial alter compilation fails
	;                         SQL Fix ProdLog 41342:  DDLPKey is IDKey: create bitmap index statement results in a problem
	;  DPV2350 (01/26/2004) - Remove support for SETUSER
	;  DPV2338 (01/07/2006) - SQL Fix ProdLog 40232: <SUBSCRIPT> occurs when ALTER VIEW
 	;  DPV2336 (01/06/2005) - SQL Fix ProdLog 40355: Run-time error occurs when create user who already exists
	;  DPV2324 (11/24/2004) - Eliminate %msqlgrp for SQL Role list, use $Roles now
	;  DPV2323 (11/24/2004) - Move %qarPrivileges and %qadUsers into %SYS.SQLSEC
	;  DPV2321 (11/10/2004) - Use new %SYS.CONFIG API for SQL Configuration settings
	;  LFT1320 (11/02/2004) - Laura Tillem, %SYS.NLS
	;  JMM001  (10/22/2004) - Enable support for IDENTITY fields (previously turned off)	;  DPV2309 (10/14/2004) - Fix <SUBSCRIPT> error when compiling unqualified CREATE VIEW as SELECT * ... from class method
	;  DPV2198 (03/17/2004) - Use $Username instead of %msql, use new privilege global
	;  DPV2134 (12/02/2003) - CompileDeferredList is in %apiDDL2, not %apiDDL
	;			  SQL Fix ProdLog 34862:  SET OPTION COMPILEMODE=IMMEDIATE fails
	;  DPV2126 (11/14/2003) - Support SETUSER <username>
	;  DPV2078 (09/30/2003) - All CREATE TABLE/VIEW when security is off and not logged in
	;  DPV2034 (07/09/2003) - Fix reporting of error message when initial compile fails of CREATE TABLE
	;  DPV2009 (06/06/2003) - Eliminate ^mdd references
	;  DPV1934 (05/22/2003) - Fix <LIST> error in AlterColumn caused by DPV1917 - parameter alignment problem
	;  DPV1932 (02/10/2003) - In CALL set %msg to the contents of %sqlcontext.Message
	;  DPV1917 (01/21/2003) - Rebuild indices are after datatype has changed to/from a string via DDL
	;  DPV1901 (12/17/2002) - Handle READONLY/CHECKOPTION in ALTER VIEW
	;  DPV1899 (12/16/2002) - Pass name of view to AlterView^%apiDDL2 to check ALTER view privileges.
	;  DPV1876 (11/06/2002) - Define a return type of %Library.Status for CREATE QUERY with COS code.
	;  DPV1864 (10/28/2002) - Fix ALTER TABLE ADD constraint list when aa PKEY constraint is mixed with other constraints
	;  DPV1824 (09/10/2002) - Fix checking of trigger schema name
	;  DPV1708 (05/03/2002) - Support SET OPTION PKEY_IS_IDKEY = TRUE/FALSE, SUPPORT_DELIMITED_IDENTIFIERS = TRUE/FALSE
	;  DPV1693 (03/27/2002) - Support updatable views
	;  DPV1664 (01/29/2002) - Fix call to DropTable^%apiDDL in DROP VIEW
	;  DPV1626 (12/05/2001) - Add support for CREATE BITMAP INDEX through DDL
	;  DPV1620 (11/27/2001) - Use list of class names in compilaeafter list for views instead of table names
	;  DPV1601 (10/15/2001) - Support SET OPTION LOCK_TIMEOUT = <timeout value>
	;  PYD041  (10/09/2001) - fix undefined on Create Procedure when line>$$$MaxRtnLineLength 
	;  DPV1591 (10/01/2001) - Change TriggerSchema to TriggerPackage
	;  DPV1561 (07/02/2001) - Fix ALTER TABLE when PKey index and Uniue index added at once.
	;  DPV1560 (07/03/2001) - Support code > 32K for CREATE PROC/QUERY/METH/FUNC/TRIGGER
	;  DPV1509 (03/16/2001) - Implement CALL Statement
	;  DPV1504 (03/09/2001) - Implement CREATE TRIGEGR
	;  DPV1486 (01/19/2001) - Implement CREATE FUNCTION/METHOD/PROCEDURE/QUERY
	;  DPV1442 (11/02/2000) - Don't place derived table names %%Q# in view's compileafter list, eliminate duplicates
	;  DPV1429 (10/23/2000) - When ALTER ADD a BLOB field, update all existing rows with NULL (-1).
	;  DPV1378 (08/23/2000) - If CreateTable or CreateView fails, close the class if we opened it.
	;  DPV1377 (08/23/2000) - Fix setting of SQLCODE in CREATE TABLE's AddColumn call
	;  DPV1344 (07/18/2000) - Add support for INSTALL compile mode
	;  DPV1331 (07/18/2000) - SET OPTION for Locales and SUPPORT_BLOB
	;  DPV1328 (06/22/2000) - Fixes for DROP TABLE
	;  DPV1274 (03/09/2000) - Fix SET OPTION COMPILEMODE through ODBC
	;                         Add $namespace as first subscript to ^mtemp2, since its stored in CacheTemp
	;  DPV1240 (01/20/2000) - Support Foriegn Key referential actions
	;  DPV1243 (01/12/2000) - Initialize SQLCODE=0 at the beginning of CREATE TABLE, DROP INDEX, and CREATE VIEW
	;  DPV1234 (12/30/1999) - When a primary key field is added to a table definition, 
	;                         make all the primary key fields required.
	;  DPV1224 (12/16/1999) - Fix ALTER TABLE ADD <many columns>
	;  DPV1174 (10/27/1999) - Fix ALTER TABLE ADD FKEY generated syntax error
	;  DPV1162 (10/14/1999) - Create views as classes
	;  DPV1145 (09/21/1999) - Populate NOT NULL fields wit default valeus when they
	;                         are added through ALTER TABLE
	;  DPV1134 (09/02/1999) - DropUser^%qadUsers now return SQLCODE and %msg
	;                         as parameters passed by reference.
	;  DPV1131 (08/27/1999) - Drop partially created table if create table returns error
	;                         Revert to original definition if alter table fails.
	;  DPV1121 (08/13/1999) - Support IDENTITY Columns (TURNED OFF FOR NOW)
	;  DPV1109 (07/20/1999) - Support delimited identifiers
	;  DPV1088 (06/16/1999) - Support ALTER TABLE DROP CONSTRAINT
	;  DPV1082 (06/08/1999) - Support Build/Purge of index data
	;  DPV1062 (05/13/1999) - Support ALTER ADD UNIQUE
	;  DPV1038 (04/14/1999) - UNIQUE index now really creates a unique index
	;  DPV999  (03/11/1999) - Son't set up single field foreign key
	;                         as reference type here.  Handle it in
	;                         the DDL API - we have to make sure the FKey
	;                         references an IDKey.
	;  DPV995  (03/05/1999) - Support deleting a table's data upon drop
	;  DPV993  (03/05/1999) - Fix AddKey call for Primary Key put SQLCODE param in correct place
	;  DPV964  (02/02/1999) - Fix column constraint in ALTER TABLE ADD COLUMN
	;  DPV957  (01/22/1999) - Support Deferred Compilation Mode
	;  DPV955  (01/20/1999) - Fix unnamed constraints in ALTER TABLE
	;  AK345   (12/31/1998) - Nicer $C(0) (SQL empty string) in $$quoter
	;  DPV931  (12/10/98)   - Build all keys via AddKey API entry point.
	;  DPV910  (11/25/98)   - Foreign Key Support
	;                         Removed all prior change codes. (ZqaqcDDLCodeGen)
	;  MRP732  (10/30/98)   - Support Standard Syntax: CREATE VIEW <view-name> (<column-list>) AS ... 
	;  DPV895  (10/27/98)   - Preserve column number order
	;  DPV892  (10/26/98)   - Don't specify CLASSNAME=0 in reference, its the default
	;  DPV876  (09/23/98)   - Support CREATE/ALTER/DROP Users
	;  DPV863  (08/25/98)   - Add support for Constraints (NOT YET COMPLETE!)
	;  DPV854  (07/14/98)   - Rewrite code generation of CREATE/ALTER/DROP VIEW
	;  DPV850  (07/09/98)   - Support as a no-op ALTER TABLE LOCK MODE (ROW)
	;  AFH305  (06/03/98)   - Sybase primary key syntax
	;  AFH300  (06/03/98)   - DROP or DELETE, DROP Foreign key
	;  AFH294  (06/03/98)   - Code Generate SET OPTION statements - no-op
	;  DPV797  (12/30/97)   - Initial creation of entire routine.  Derived from %qaqcddl (%aaaddl)
	;  ----------
	;  Changes from %qaqcddl in DEV
	;  DPV796  (12/19/97)   - DDL Enhancments for OMNUS 7 client (Swiss)
	;  DPV785  (10/28/97)   - Enhanced DDL for Full DD support
	;  DPV751  (06/24/97)   - Renamed %aaa* to %qcg*.  Derived from %aaaddl
	;  DPV691  (10/16/96)   - Code generate DDL stuff
	;  AK280   (02/14/96)   - Routine created
	;
	;-------------------------------------------------------------
	;                     I N F O R M A T I O N
	;-------------------------------------------------------------
	;
	;  This program uses the DDL parse tree (through the parse tree
	;  API in ^%qaqpddl.inc), after the analysis step, to generate
	;  M code, which consists of calls to the DDL run-time API.
	;
	;-------------------------------------------------------------
#ENDIF  ;
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; Macro defintions
	 
	new %line,line,lines,mod,tag ;Setup in initag
	if $$$Dop="create" d crtgen($$$Dtab) RETURN				//  CREATE TABLE
	if $$$Dop="ctas" d ctasgen($$$Dtab) RETURN				//  CREATE TABLE AS SELECT
	if $$$Dop="alter" d altgen($$$Dtab) RETURN				//  ALTER TABLE
	if $$$Dop="drop" d drtgen($$$Dtab) RETURN				//  DROP TABLE
	if $$$Dop="create foreign table" d createForeignTableGen($$$Dtab) RETURN // CREATE FOREIGN TABLE
	if $$$Dop="create foreign server" d createForeignServerGen($$$Dtab) RETURN // CREATE FOREIGN SERVER
	if $$$Dop="alter foreign table" d alterForeignTableGen($$$Dtab) RETURN // ALTER FOREIGN TABLE
	if $$$Dop="alter foreign server" d alterForeignServerGen($$$Dtab) RETURN // ALTER FOREIGN SERVER
	if $$$Dop="drop foreign table" d dropForeignTableGen($$$Dtab) RETURN				//  DROP FOREIGN TABLE
	if $$$Dop="drop foreign server" d dropForeignServerGen($$$Dtab) RETURN				//  DROP FOREIGN SERVER
	if $$$Dop="drop index" d drigen($$$Dtab) RETURN				//  DROP INDEX
	if $$$Dop="create index" d crigen($$$Dtab) RETURN			//  CREATE INDEX
	if $$$Dop["user" d users($$$Dtab) RETURN				//  CREATE/DROP USER
	if $$$Dop="create method" d method($$$Dtab) RETURN			//  CREATE FUNCTION/METHOD/PROCEDURE
	if $$$Dop="create query" d query($$$Dtab) RETURN			//  CREATE FUNCTION/PROCEDURE/QUERY
	if $$$Dop="drop method" d dropmethodquery($$$Dtab,"DropMethod") RETURN	//  DROP METHOD/FUNCTION
	if $$$Dop="drop query" d dropmethodquery($$$Dtab,"DropQuery") RETURN	//  DROP QUERY
	if $$$Dop="drop proc" d dropmethodquery($$$Dtab,"DropProc") RETURN		//  DROP PROCEDURE
	if $$$Dop="create trigger" d createtrigger($$$Dtab) RETURN				//  CREATE TRIGGER
	if $$$Dop="drop trigger" d droptrigger($$$Dtab) RETURN					//  DROP TRIGGER
	if $$$Dop="call" d call($$$Dtab) RETURN									//  CALL <Procedure>
	if $$$Dop="lock" d lock($$$Dtab) RETURN									//  LOCK TABLE
	if $$$Dop="unlock" d unlock($$$Dtab) RETURN								//  UNLOCK TABLE
	if $$$Dop="create database" { do CreateDatabase($$$Dtab) RETURN }		//  CREATE DATABASE
	if $$$Dop="create database file" { do CreateDatabase($$$Dtab,1) RETURN } // CREATE DATABASE FILE JMM1298=
	if $$$Dop="drop database" { do DropDatabase($$$Dtab) RETURN }			//  DROP DATABASE
	if $$$Dop="use database" { do UseDatabase($$$Dtab) RETURN }				//  USE DATABASE
	if $$$Dop="tune" { do tune($$$Dtab) RETURN  }						//  TUNE TABLE
	if $$$Dop="create model" { do createmodel($$$Dtab) RETURN }				//  CREATE MODEL
	if $$$Dop="alter model" { do altermodel($$$Dtab) RETURN }				//  ALTER MODEL
	if $$$Dop="drop model" { do dropmodel($$$Dtab) RETURN }					//  DROP MODEL
	if $$$Dop="train model" { do trainmodel($$$Dtab) RETURN }				//  TRAIN MODEL
	if $$$Dop="validate model" { do validatemodel($$$Dtab) RETURN }			//  VALIDATE MODEL
	if $$$Dop="create mlconfig" { do createmlconfig($$$Dtab) RETURN }		//  CREATE ML_CONFIGURATION
	if $$$Dop="alter mlconfig" { do altermlconfig($$$Dtab) RETURN }			//  ALTER ML_CONFIGURATION
	if $$$Dop="drop mlconfig" { do dropmlconfig($$$Dtab) RETURN }			//  DROP ML_CONFIGURATION
	if $$$Dop="create aggregate" { do createaggregate($$$Dtab) RETURN }		//  CREATE AGGREGATE
	if $$$Dop="drop aggregate" { do dropaggregate($$$Dtab) RETURN }			//  DROP AGGREGATE
	if $$$Dop="create schema" { do createSchema($$$Dtab) RETURN }			//  CREATE SCHEMA
	if $$$Dop="drop schema" { do dropSchema($$$Dtab) RETURN }				//  DROP SCHEMA
	if $case($$$Dop,"drop table stats":1,"drop schema stats":1,:0) { do dropStats($$$Dtab) RETURN }	 //  ALTER TABLE/SCHEMA x DROP FIXED STATISTICS
	if $case($$$Dop,"fix table stats":1,"fix schema stats":1,:0) { do fixStats($$$Dtab) RETURN }	//  ALTER TABLE/SCHEMA x FIX STATISTICS	
	if $case($$$Dop,"set table stats prop":1,"set schema stats prop":1,:0) { do setTableStatsProp($$$Dtab) RETURN } //  ALTER TABLE/SCHEMA x SET RUNTIME IGNOREFIXEDSTATS/SKIPAUTOMATICSTATSCOLLECTION = [ TRUE | FALSE ]
	RETURN
	
crtgen(tab) ;  generate CREATE TABLE code for table handle tab
	new bottom,datafields,fields,fld,fldord,flist,i,index,j,key,psize,quotab,ref,tParam,xx
	set quotab=""""_$$$TNAME(tab)_""""  ;  alphaup of table name in quotes
	do initag set bottom=mtag_"dun"
		#;   now start the actual processing - 
		#;   first add a basetable entry
		#;    call:  CreateTable^%apiDDL(tabname,desc,defstr,owner,filename,
		#;                               numrows,rtnprefx,SQLCODE,temptype,.ltTableName,.classname,publicrowid,sharded)
	// DPV2078= d liin("i '$$ValidUser^%qadUsers($p($g(%msql),$c(1))) s SQLCODE=-99 q")
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("new %mmmbebuild,%mmmcc,%mmmch,%mmmclassname,%mmmin,%mmmoch,%mmmsc,%mmmltname")
	$$$liin("set SQLCODE=0,%mmmbebuild=1,%mmmoch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",,,1)")
	if $$$tifexists($$$Dtab) { $$$liin("if %mmmoch { do Close^%apiDDL(%mmmoch) set SQLCODE=0,%msg=""""  goto "_bottom_" }") }
	$$$liin("set %mmmch=$$CreateTable^%apiDDL("_$$quoter($$$tname(tab))_","_$$quoter($$$tdesc(tab))_",$Username,"""_$$$tfile(tab)_""","""_$$$tnumrows(tab)_""","""_$$$troutine(tab)_""",.SQLCODE,"""_$$$tTempType(tab)_""",.%mmmltname,.%mmmclassname,"_+$$$tpublicrowid(tab)_","_+$$$tShard(tab)_",,"_+$$$tPartition(tab)_")")
	$$$liin("if '%mmmch { do:%mmmoch Close^%apiDDL(%mmmoch) goto "_bottom_" }")
.
		#;   loop and add each class parameter
		#;    call:  AddParameter^%apiDDL(class,parametername,parameter_default,.SQLCODE)
	set tParam=""
	for i=1:1 {
		set tParam=$$$nextparameter(tParam) quit:tParam=""
		continue:($$$tTempType(tab)'=""&&(tParam="USEEXTENTSET"))
		set line="set %mmmsc=$$AddParameter^%apiDDL(%mmmch,"_$$quoter($$$pname(tParam))_","_$$quoter($$$pdefault(tParam))_",.SQLCODE) if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }"
		$$$liin(line)
	}
.
		#;   loop and add each field and add the field
		#;    call:  AddColumn^%apiDDL(class,fldname,desc,typeinfo,req,keytype,defvalue,collate,multiln,colnum,
		#;                             identity,computecode="",transient=0,calculated=0,reftab,matchtyp,updrule,delrule,tocol,SQLCODE,alteradd,&pBEDefine,&propname,private=0,usePropName=0,deferred=0)
	set fldord="" 
	for i=2:1 {
		$$$nextfld(tab,fldord,fld) q:fld=""
		if $$$computecode(tab,fld)'="" {
			set line=""
			for j=1:1:$ll($$$computecode(tab,fld)) {
				set xx=$$quoter($$$StripTrailingWhiteSpace($li($$$computecode(tab,fld),j)))
				if $l(line)+$l(xx)>($$$MaxRtnLineLength-10) { $$$liin(line) set line="" }
				set line=line_$s(line="":"set ",1:",")_"%mmmcc("_j_")="_xx
			}
			if line'="" $$$liin(line) set line=""
			if $$$computelanguage(tab,fld)="python" { $$$liin("set %mmmcc(""lang"")=""python""") }
		}
		#;  add the field
		#;    call:  AddColumn^%apiDDL(class,fldname,desc,typeinfo,req,keytype,defvalue,collate,multiln,colnum,
		#;                             identity,computecode="",transient=0,calculated=0,reftab,matchtyp,updrule,delrule,tocol,nocheck=0,SQLCODE,,alteradd,&pBEDefine,&propname,private=0)
		set line="set %mmmsc=$$AddColumn^%apiDDL(%mmmch,"_$$quoter($$$fname(tab,fld))_","_$$quoter($$$fdesc(tab,fld))_","""_$$$datatype(tab,fld)_""","_+($$$required(tab,fld))
					_","""_$$$funique(tab,fld)_""","_$$quoter($$$default(tab,fld))_","_$$quoter($$$collate(tab,fld))_","_$$$multiline(tab,fld)_","_i_","_($$$fIdentity(tab,fld)'="")_","
					_$s($$$computecode(tab,fld)="":"",1:".%mmmcc")_","_$$$transient(tab,fld)_","_$$$calculated(tab,fld)_",,,,,,.SQLCODE,0,.%mmmbebuild,,"_$$$private(tab,fld)_",,"_$$$deferred(tab,fld)_") "
					_$s($$$computecode(tab,fld)="":"",1:"kill %mmmcc ")_"if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }"
		$$$liin(line)
	}
.
		#;   loop and add any SqlComputeOnChange for computed fields.  Has to be done after all fields are added because the property names need to be known.
		#;    call:  AddComputeOnChange^%apiDDL(class,fldname,computeonchange,SQLCODE)
	set fldord="" 
	for i=2:1 {
		$$$nextfld(tab,fldord,fld) q:fld=""
		if $$$computeonchange(tab,fld)'="" {
			set line="set %mmmsc=$$AddComputeOnChange^%apiDDL(%mmmch,"_$$quoter($$$fname(tab,fld))_","_$$RecomposeList($$$computeonchange(tab,fld))_",.SQLCODE) if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }"
			$$$liin(line)
		}
	}
.
		#;   Loop and generate Keys entries for the new table
		#;   Add the Keys entry
		#;    call:  AddKey^%apiDDL(tabname,keyname,keydesc,keytype,fromcol,.SQLCODE,alteradd,.pBuildIndex,.pBEDefine)
	set key=""  ;  initialize handle to the key
	for  {
		set key=$$$nextkey(tab,key) quit:key=""
			#;      first add the primary key and the unique keys, ...
		if "PU"[$$$ktype(tab,key) {
			$$$liin("set %mmmsc=$$AddKey^%apiDDL(%mmmch,"_$$quoter($$$consname(tab,key))_",""DDL "_$s($$$ktype(tab,key)="P":"Primary",1:"Unique")_" Key Specification"","""_$$$ktype(tab,key)_""","_$$quoter($$$KLIST(tab,key))_",.SQLCODE,,,.%mmmbebuild) if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }")
		}
	}
.
		#;   Loop and generate Constraint entries for the new table
		#;   Add the Constraint entry(s)
		#;    call:  AddConstraint^%apiDDL(tabname,conname,contype,coninfo,fkeyreftab,fkeyrefflds,updrule,delrule,SQLCODE,checkpriv=0)
	set con=""
	for  {
		set con=$$$nextcon(con) quit:con=""
			#;  . i ",NOTNULL,CHECK,"[(","_$$$Ctype(con)_",") $$$liin("s %mmmsc=$$AddConstraint^%apiDDL(%mmmch,"_$$quoter($$$Cname(con))_","""_$$$Ctype(con)_""","_$$quoter($$$Cinfo(con))_",.SQLCODE) i '%mmmsc d Close^%apiDDL(%mmmch) q") q
		if $$$Ctype(con)="FKEY" {
			$$$liin("set %mmmsc=$$AddConstraint^%apiDDL(%mmmch,"_$$quoter($$$Cname(con))_","""_$$$Ctype(con)_""","_$$quoter($$$CinfoFKEYFlds(con))_","_$$quoter($$$tname($$$CinfoFKEYRefTab(con)))_","_$$quoter($$$CinfoFKEYRefFlds(con))_","_$$quoter($s($$$CinfoFKEYRAUpdate(con)'="":$$$CinfoFKEYRAUpdate(con),1:"NO ACTION"))_","_$$quoter($s($$$CinfoFKEYRADelete(con)'="":$$$CinfoFKEYRADelete(con),1:"NO ACTION"))_","_$$$CinfoFKEYNoCheck(con)_",.SQLCODE,"_$select($$$SQLCompileOption("xDBC")=1:1, $$$SQLCompileOption("DynamicSQL")=1:1, 1:0)_") if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }")
		}
	}
.
		#;   Loop and generate index (KEY) entries for the new table
		#;   This is for MySQL only, where KEY is a synonym for INDEX
		#;    call:  AddIndex^%apiDDL(class,collist,ixname,unique,bitmap,bitslice,bitmapextent,columnar,datalist,&SQLCODE,shardkey,coshardwith="",typeclass="",parameters="",collations="",partitionkey=0,partparams="",partitioned=0,deferred=0)
	set index=""
	for  {
		set index=$$$nextindex(index) quit:index=""
		set i=0,fields=""
		for j=0:1 {
			set i=$$$NextIndexField(index,i) quit:i="" 
			set fields=fields_$s(j:",",1:"")_$$$IndexField(index,i)
		}
		set i=0,datafields=""
		for j=0:1 {
			set i=$$$NextIndexDataField(index,i) quit:i=""
			set datafields=datafields_$s(j:",",1:"")_$$$IndexDataField(index,i)
		}
		$$$liin("set %mmmin="_$$quoter($$$iname(index))_",%mmmsc=$$AddIndex^%apiDDL(%mmmch,"_$$quoter(fields)_",.%mmmin,"_$$$iunique(index)_","_$$$ibitmap(index)_","_$$$ibitslice(index)_","_$$$ibitmapextent(index)_","_$$$icolumnar(index)_","_$$quoter(datafields)_",.SQLCODE) if '%mmmsc!(SQLCODE<0) { do Close^%apiDDL(%mmmch) goto "_bottom_ "}")
	}
		#;
		#;  Possibly define a Bitmap Extent Index
		#;
	if $$$tTempType(tab)="" {
		$$$liin("set:%mmmbebuild %mmmsc=$$AddBitmapExtentIndex^%apiDDL(%mmmch,.SQLCODE) if '%mmmsc||(SQLCODE<0) { do Close^%apiDDL(%mmmch) goto "_bottom_" }")
	}
		#;
		#;  Possibly define a ShardKey Index
		#;
	if $$$tShardKey(tab)'="" {
		$$$liin("set %mmmin=""%ShardKey"",%mmmsc=$$AddIndex^%apiDDL(%mmmch,"_$$quoter($$$tShardKey(tab))_",.%mmmin,0,0,0,0,0,"""",.SQLCODE,1,"_$$quoter($$$tShardReference(tab))_") if '%mmmsc||(SQLCODE<0) { do Close^%apiDDL(%mmmch) goto "_bottom_" }")
	}
		#;
		#;  Possibly define a PartitionKey Index
		#;
	if $$$tPartition(tab)'="" {
		n i,field,partparams s i="",field="",partparams=""
		for {
			$$$nextpartition(tab,i,field) quit:field=""
			s partparams=partparams_$s(i=1:"",1:",")_$$$tPartitionField(tab,i)_"("_$$$tPartitionType(tab,i)_$s($$$tPartitionType(tab,i)="LIST":"",1:"("_$$$tPartitionValue(tab,i)_$s($$$tPartitionDTInterval(tab,i)="":"",1:" ")_$$$tPartitionDTInterval(tab,i)_")")_")"
		}
		if partparams'="" {
			$$$liin("new %mmmin,%mmmsc") // JMM1311=
			$$$liin("set %mmmin="""_$$$PartitionKeySqlName_""",%mmmsc=$$AddIndex^%apiDDL(%mmmch,"_$$quoter($$$tPartitionFields(tab))_",.%mmmin,0,0,0,0,0,"""",.SQLCODE,,,,,,1,"_$$quoter($ZCVT(partparams,"l"))_") if '%mmmsc||(SQLCODE<0) { do Close^%apiDDL(%mmmch) goto "_bottom_" }") // JMM1279=
		}
	}
		#;
		#;  Compile the table
		#;
		#;  If there is an error compiling the class, we try to delete the class.
	if $$$tTempType(tab)="l"||($$$tTempType(tab)="gp") {
		$$$liin("if '$$compile^%apiDDL(%mmmltname,%mmmch,.SQLCODE) {")
		$$$liin($c(9)_"new %msgsave set %msgsave=$lb($g(%msg),$ze) if '%mmmoch { new %SNDropIgnoreError set %SNDropIgnoreError=1 do DropTable^%apiDDL(%mmmltname) set %msg=$li(%msgsave),$ze=$li(%msgsave,2) goto "_bottom_" }")
		$$$liin($c(9)_"do compile^%apiDDL(%mmmltname,%mmmoch) set %msg=$li(%msgsave),$ze=$li(%msgsave,2) goto "_bottom) 
		$$$liin("}")
		$$$liin("do:%mmmoch Close^%apiDDL(%mmmoch) set SQLCODE=0 set:$d(%mmmltname) %msg=$lb(%mmmclassname,%mmmltname) goto "_bottom)
	} else {
		#; Here we call the new class's %InitExtent() method to define the global(s) for the class.  
		#; If this errors, we will not report a failure.  This is only a conveinance for ECP mapped or mirrowd data (See https://usjira.iscinternal.com/browse/DP-407588)
		#; this is the 1 to the 9th parameter of compile()
		$$$liin("if '$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE,,,,,,1) {")
			#; %SNDropIgnoreError=1 means if there is a shard projection, and the shard drop projection logic may get an error, to not report the error.
			#; This is the behavior we want here because we are "rolling back" a CREATE TABLE
		$$$liin($c(9)_"new %msgsave set %msgsave=$lb($g(%msg),$ze) if '%mmmoch { new %SNDropIgnoreError set %SNDropIgnoreError=1 do DropTable^%apiDDL("_$$quoter($$$tname(tab))_") set %msg=$li(%msgsave),$ze=$li(%msgsave,2) goto "_bottom_" }")
		$$$liin($c(9)_"do compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch) set %msg=$li(%msgsave),$ze=$li(%msgsave,2) goto "_bottom) 
		$$$liin("}")
		$$$liin("do:%mmmoch Close^%apiDDL(%mmmoch) set SQLCODE=0 goto "_bottom)
	}
	set tag=bottom
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
	 
ctasgen(tab) ;  generate CREATE TABLE AS <query> for table handle tab
	new bottom,i,tParam
	do initag set bottom=mtag_"dun"
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	$$$liin("set SQLCODE=0")
	if $$$tifexists($$$Dtab) {
		$$$liin("if $$LookUpClassName^%apiDDL2("_$$quoter($$$tname(tab))_")'="""" {")
		$$$liin($c(9)_"set SQLCODE=0,%msg=""""")
		$$$liin($c(9)_"goto "_bottom )
		$$$liin("}")
	}
	$$$liin("new %mmmch,%mmmqt,%mmmtc,%mmmflist,%mmmilist,%mmmsqlcomp,ex,sc")
	$$$liin("set %mmmqt="_$$$mtQueryCount)
	$$$liin("set %mmmsqlcomp="_$$quoter($case(mt("sqlcomp"),"%Runtime":"Runtime", "%ODBC":"ODBC", "%EXTERNAL":"Display", "%FDBMS": "FDBMS", :"Logical")))
	for i=1:1:$$$mtQueryCount { $$$liin("set %mmmqt("_i_")="_ $$quoter($$space($$$mtQueryText(i)))) }
	$$$liin("goto:('$$Prepare^%qarCopyTable(.%mmmqt, .%mmmtc)) "_bottom)
	// Query preparation succeeded so create the table
	$$$liin("TSTART")
	$$$liin("try {")
	$$$liin($c(9)_"set %mmmch=$$CreateTable^%apiDDL("_$$quoter($$$tname(tab))_","""",$Username,"""","""","""",.SQLCODE,"""_$$$tTempType(tab)_""",,,,"_+$$$tShard(tab)_",,"_+$$$tPartition(tab)_")")
	$$$liin($c(9)_"throw:('%mmmch)")
	set tParam=""
	for  {
		set tParam=$$$nextparameter(tParam) quit:tParam=""  // Loop and add each class parameter
		$$$liin($c(9)_"throw:('$$AddParameter^%apiDDL(%mmmch,"_$$quoter($$$pname(tParam))_","_$$quoter($$$pdefault(tParam))_",.SQLCODE))")
	}
	$$$liin($c(9)_"set sc=$$AddColumnsFromRSMetaData^%qarCopyTable(%mmmch,.%mmmtc,.%mmmflist,.%mmmilist) throw:('(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)")
	if $$$tShardKey(tab)'="" {	// Possibly define a ShardKey Index
		$$$liin($c(9)_"throw:('$$AddIndex^%apiDDL(%mmmch,"_$$quoter($$$tShardKey(tab))_",""%ShardKey"",0,0,0,0,0,"""",.SQLCODE,1,"_$$quoter($$$tShardReference(tab))_"))")
	}
	#;  Possibly define a PartitionKey Index
	if $$$tPartition(tab)'="" {
		n i,field,partparams s i="",field="",partparams=""
		for {
			$$$nextpartition(tab,i,field) quit:field=""
			s partparams=partparams_$s(i=1:"",1:",")_$$$tPartitionField(tab,i)_"("_$$$tPartitionType(tab,i)_$s($$$tPartitionType(tab,i)="LIST":"",1:"("_$$$tPartitionValue(tab,i)_$s($$$tPartitionDTInterval(tab,i)="":"",1:" ")_$$$tPartitionDTInterval(tab,i)_")")_")"
		}
		if partparams'="" {
			$$$liin($c(9)_"throw:('$$AddIndex^%apiDDL(%mmmch,"_$$quoter($$$tPartitionFields(tab))_","""_$$$PartitionKeySqlName_""",0,0,0,0,0,"""",.SQLCODE,,,,,,1,"_$$quoter($ZCVT(partparams,"l"))_"))") // JMM1279=
		}
	}
		#;  Possibly define a Bitmap Extent Index
	if $$$tTempType(tab)="" $$$liin("throw:('$$AddBitmapExtentIndex^%apiDDL(%mmmch,.SQLCODE))")
.
.
		#; Here we call the new class's %InitExtent() method to define the global(s) for the class.  
		#; If this errors, we will not report a failure.  This is only a conveinance for ECP mapped or mirrowd data (See https://usjira.iscinternal.com/browse/DP-407588)
		#; this is the 1 to the 9th parameter of compile()
	$$$liin($c(9)_"throw:('$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE,,,,,,1))")
.
	if '$$$tShard(tab),'($$$mtKNoJournalFlag($g($$$mtK))) {	// Sharded filing operations do not support transactions yet, NOT %NOJOURN, perform data copy (INS/SEL) outside trx.
		$$$liin($c(9)_"set sc=$$CopyData^%qarCopyTable(.%mmmqt,"_$$quoter($$$tname(tab))_",.%mmmflist,.%mmmilist,.%ROWCOUNT,.%ROWID,,0,1) throw:('(sc)) ##class(%Exception.StatusException).CreateFromStatus(sc)")
	}
	$$$liin($c(9)_"TCOMMIT")
	$$$liin("} catch ex {")
		// Set SQLCODE and %msg if it wasn't already set.
	$$$liin($c(9)_"if ex.%IsA(""%Exception.StatusException"") { set SQLCODE=ex.AsSQLCODE(),%msg=ex.OnAsSQLMessage() }")
	$$$liin($c(9)_"set:(SQLCODE>=0) SQLCODE=-400,%msg=""Unexpected error occurred in generated CREATE TABLE AS <query> code:""_$ze")
	$$$liin($c(9)_"TROLLBACK 1")
	$$$liin("}")
	if +$$$tShard(tab) {
		$$$liin($c(9)_"goto:(SQLCODE<0) "_bottom)
		$$$liin("if '$$CopyData^%qarCopyTable(.%mmmqt,"_$$quoter($$$tname(tab))_",.%mmmflist,.%mmmilist,.%ROWCOUNT,.%ROWID,,,1) {")
		$$$liin($c(9)_"new %SNDropIgnoreError")
		$$$liin($c(9)_"set %SNDropIgnoreError=1")
		$$$liin($c(9)_"do DropTable^%apiDDL("_$$quoter($$$tname(tab))_")")
		$$$liin("}")
	} elseif $$$mtKNoJournalFlag($g($$$mtK))=1 {	// %NOJOURN
		$$$liin($c(9)_"goto:(SQLCODE<0) "_bottom)
		$$$liin("if '$$CopyData^%qarCopyTable(.%mmmqt,"_$$quoter($$$tname(tab))_",.%mmmflist,.%mmmilist,.%ROWCOUNT,.%ROWID,,1,1) {")
		$$$liin($c(9)_"do DropTable^%apiDDL("_$$quoter($$$tname(tab))_")")
		$$$liin("}")
	}
	set tag=bottom
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
 
altgen(tab)  ;  generate ALTER TABLE code for table handle tab
	new alteralterCnt,bottom,con,fld,fldord,hasfkeydfn,j,key,keysdone,pkey,quotab
	set alteralterCnt=0
	set quotab=""""_$$$TNAME(tab)_""""  ;  a-up of table name in quotes
	do initag set bottom=mtag_"dun"
	do InitDDLAMSInfo
	do generateSQLStartCode^%qaqcasl()
	if $$$Top(tab)["," {         ;MULTPLE ALTER TABLE ADD Commands
		set con="",fldord="",key="",pkey="",hasfkeydfn=0
		$$$liin("new %mmmcc,%mmmch,%mmmil,%mmmin,%mmmsc,%mmmclist,%mmmclassname,%mmmivfn,%mmmrenamefield set SQLCODE=0,%mmmil="""",%mmmch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",.SQLCODE,1,,1,.%mmmclassname,,"_$select($$$SQLCompileOption("xDBC")=1:1, $$$SQLCompileOption("DynamicSQL")=1:1, 1:0)_",1) goto:((SQLCODE<0)||(%mmmch=0)) "_bottom)
		$$$liin("if $$IsDerivedFrom^%occLibrary(%mmmclassname,""%Library.AbstractForeignTable"") { do Close^%apiDDL(%mmmch) set SQLCODE = -30, %msg=""Table '"_$$$tname(tab)_"' is a foreign table. Use ALTER FOREIGN TABLE instead"" goto "_bottom_" } ")
		for i=1:1:$l($$$Top(tab),",") {
			if $p($p($$$Top(tab),",",i),$c(1))="alteradd" {  ;ALTER TABLE - ADD COLUMN
				set fld=$p($p($$$Top(tab),",",i),$c(1),2)
					#; see if this is a computed field...
				if $$$computecode(tab,fld)'="" {
					set line="" 
					for j=1:1:$ll($$$computecode(tab,fld)) {
						set xx=$$quoter($$$StripTrailingWhiteSpace($li($$$computecode(tab,fld),j)))
						if $l(line)+$l(xx)>($$$MaxRtnLineLength-10) $$$liin(line) set line=""
						set line=line_$s(line="":"set ",1:",")_"%mmmcc("_j_")="_xx
					}
					if line'="" { $$$liin(line) set line="" }
					if $$$computelanguage(tab,fld)="python" { $$$liin("set %mmmcc(""lang"")=""python""") }
				}
					#;  add the field
					#;    call:  AddColumn^%apiDDL(class,fldname,desc,typeinfo,req,keytype,defvalue,collate,multiln,colnum,identity,computecode="",transient=0,calculated=0,reftab,matchtyp,updrule,delrule,tocol,SQLCODE,alteradd,&pBEDefine,&propname,private=0,usePropName=0,deferred=0)
				$$$liin("set %mmmsc=$$AddColumn^%apiDDL(%mmmch,"_$$quoter($$$fname(tab,fld))_","_$$quoter($$$fdesc(tab,fld))_","""_$$$datatype(tab,fld)_""","_+($$$required(tab,fld))_","""_$$$funique(tab,fld)_""","_$$quoter($$$default(tab,fld))_","_$$quoter($$$collate(tab,fld))_","_$$$multiline(tab,fld)_",,,"_$s($$$computecode(tab,fld)="":"",1:".%mmmcc")_","_$$$transient(tab,fld)_","_$$$calculated(tab,fld)_",,,,,,.SQLCODE,1,,,"_$$$private(tab,fld)_",,"_$$$deferred(tab,fld)_") "_$s($$$computecode(tab,fld)="":"",1:"kill %mmmcc ")_"if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }")
			}
			elseif $p($p($$$Top(tab),",",i),$c(1))="alteraddforeignkey" {  ; ALTER TAB - ADD FOREIGN KEY
				set hasfkeydfn = 1
			}
			elseif $p($p($$$Top(tab),",",i),$c(1))="alteraddprimarykey" {  ; ALTER TABLE - ADD PRIMARY KEY
				set pkey=$p($p($$$Top(tab),",",i),$c(1),2)
				continue:pkey=""  // ??? How did this happen ???
				$$$liin("set %mmmin="_$$quoter($$$consname(tab,pkey))_",%mmmsc=$$AddKey^%apiDDL(%mmmch,.%mmmin,"""",""P"","_$$quoter($$$KLIST(tab,pkey))_",.SQLCODE,1) set %mmmil=%mmmil_$lb(%mmmin) if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }")
				set keysdone($$$LOWER(pkey))=""
			}
			elseif $p($p($$$Top(tab),",",i),$c(1))="alteraddunique" {  ; ALTER TABLE - ADD UNIQUE CONSTRAINT
				set key=$p($p($$$Top(tab),",",i),$c(1),2)
				continue:key=""  // ??? How did this happen ???
				$$$liin("set %mmmin="_$$quoter($$$consname(tab,key))_",%mmmsc=$$AddKey^%apiDDL(%mmmch,.%mmmin,"""",""U"","_$$quoter($$$KLIST(tab,key))_",.SQLCODE) set %mmmil=%mmmil_$lb(%mmmin) if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }")
				set keysdone($$$LOWER(key))=""
			}
			elseif $p($p($$$Top(tab),",",i),$c(1))="alteralter" {  ; ALTER TABLE - MODIFY DEFAULT VALUE
				set fld=$p($p($$$Top(tab),",",i),$c(1),2)
				do genAlterAlter
			}
			elseif $p($p($$$Top(tab),",",i),$c(1))="alterrenamefield" {  ; ALTER TABLE - MODIFY RENAME
				set fld = $piece($piece($$$Top(tab), ",", i), $c(1), 2)
				$$$liin("if ('$$RenameSQLField^%apiDDL(%mmmch," _ $$quoter(fld) _ "," _ $$quoter($$$fnewname(tab,fld)) _ ", .SQLCODE)) { do Close^%apiDDL(%mmmch) goto "_bottom_" } set %mmmrenamefield("_$$quoter($$$tname(tab))_","_$$quoter(fld)_")=""""")
			}
		}
	
			#;  For each field added that has COMPUTEONCHANGE code, add it now
		set fldord="" 
		for i=1:1:$l($$$Top(tab),",") {
			if $p($p($$$Top(tab),",",i),$c(1))="alteradd" {  ;ALTER TABLE - ADD COLUMN
				set fld=$p($p($$$Top(tab),",",i),$c(1),2)
				if $$$computeonchange(tab,fld)'="" {
					set line="set %mmmsc=$$AddComputeOnChange^%apiDDL(%mmmch,"_$$quoter($$$fname(tab,fld))_","_$$RecomposeList($$$computeonchange(tab,fld))_",.SQLCODE)  if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }"
					$$$liin(line)
				}
			}
		}
		
		#; No explicit CONSTRAINT or FOREIGN KEY, but it could be implied
		if 'hasfkeydfn {
			for {
				set con = $$$nextcon(con)
				quit:con=""
				if $$$Ctype(con) = "FKEY" {
					set hasfkeydfn = 1
					quit
				}
			}
		}
		
			#;   Loop and generate keys entry for field constraints
			#;   Add the Keys entry
			#;    call:  AddKey^%apiDDL(tabname,keyname,keydesc,keytype,fromcol,.SQLCODE,alteradd,.pBuildIndex,.pBEDefine)
		set key=""  ;  initialize handle to the key
		for  {
			set key=$$$nextkey(tab,key) quit:key=""
				#;      add the primary key and the unique keys, but only if they were not added as an explicit constraint...
			if "PU"[$$$ktype(tab,key),'$d(keysdone($$$LOWER(key))) {
				$$$liin("set %mmmsc=$$AddKey^%apiDDL(%mmmch,"_$$quoter($$$consname(tab,key))_",""DDL "_$s($$$ktype(tab,key)="P":"Primary",1:"Unique")_" Key Specification"","""_$$$ktype(tab,key)_""","_$$quoter($$$KLIST(tab,key))_",.SQLCODE,,,.%mmmbebuild) if '%mmmsc { do Close^%apiDDL(%mmmch) goto "_bottom_" }")
			}
		}
.
		#; %mmmoch is set in genAlterAlter if alteralterCnt '= 0
		if 'alteralterCnt { $$$liin("new %mmmoch set %mmmoch=$$Open^%apiDDL("_$$quoter($$$tname(tab))_",,,1)") }
		$$$liin("set %mmmclist=1 if '$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE,.%mmmclist,,"_hasfkeydfn_",,.%mmmrenamefield) d  goto "_bottom)
		$$$liin(". i %mmmoch n %msgsave s %msgsave=$g(%msg),%mmmclist=2 d compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) s %msg=$g(%msgsave)")
.
		if hasfkeydfn {
			set con = ""
			for {
				set con = $$$nextcon(con)
				quit:con=""
				if $$$Ctype(con) = "FKEY" {
					$$$liin("set %mmmsc=$$AddConstraint^%apiDDL(%mmmch,"_$$quoter($$$Cname(con))_","""_$$$Ctype(con)_""","_$$quoter($$$CinfoFKEYFlds(con))_","_$$quoter($$$tname($$$CinfoFKEYRefTab(con)))_","_$$quoter($$$CinfoFKEYRefFlds(con))_","_$$quoter($s($$$CinfoFKEYRAUpdate(con)'="":$$$CinfoFKEYRAUpdate(con),1:"NO ACTION"))_","_$$quoter($s($$$CinfoFKEYRADelete(con)'="":$$$CinfoFKEYRADelete(con),1:"NO ACTION"))_","_$$$CinfoFKEYNoCheck(con)_",.SQLCODE,"_$select($$$SQLCompileOption("xDBC")=1:1, $$$SQLCompileOption("DynamicSQL")=1:1, 1:0)_")")
					$$$liin("if '%mmmsc { if %mmmoch { new %msgsave set %msgsave=$g(%msg),%mmmclist=2 do compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) set %msg=$g(%msgsave) } do Close^%apiDDL(%mmmch) goto "_bottom_" }")
				}
			}
			$$$liin("set %mmmclist=1")
			$$$liin("if '$$compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmch,.SQLCODE,.%mmmclist) {")
			$$$liin($c(9)_"if %mmmoch { new %msgsave set %msgsave=$g(%msg),%mmmclist=2 do compile^%apiDDL("_$$quoter($$$tname(tab))_",%mmmoch,,.%mmmclist) set %msg=$g(%msgsave) }")
			$$$liin($c(9)_"goto "_bottom)
			$$$liin("}")
		}
			#;  For each field added that is required and has a default value,
			#;  populate any existing rows with the default value for the field
		set fldord="" 
		for i=1:1:$l($$$Top(tab),",") {
			if $p($p($$$Top(tab),",",i),$c(1))="alteradd" {  ;ALTER TABLE - ADD COLUMN
				set fld=$p($p($$$Top(tab),",",i),$c(1),2)
				if (+$$$required(tab,fld)>0&&($$$default(tab,fld)'="")) {
