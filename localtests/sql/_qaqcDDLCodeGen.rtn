		($p($$$Top(tab),$c(1))="alterarchive") { // ALTER TABLE - ARCHIVE PARTITION
 
 		new clearPrefix,end,ii,moveToDatabase,partitionId,partitionSpec,prefix,prefixList,separator,start,activateOption // JMM1311= JMM1343=
		if $$$tPartition(tab) {
