				if partitionId {
					set separator="||"
				}
				else {
					set separator=","
				}
				for ii=1:1:$l(prefix,separator) {
					// If only prefix was specified, treat as equivalent to prefix consisting of leftmost
					// elementCount-1 elements of prefix, between rightmost element of prefix and rightmost element of prefix.
					if ii=$l(prefix,separator) && (start="") && (end="") && partitionId {
