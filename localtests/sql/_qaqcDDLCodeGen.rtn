	$$$liin("TSTART")
	$$$liin("try {")
	$$$liin("set SQLCODE=0,%ROWCOUNT=0")
	if mt("freeze","scope")="ALL" { $$$liin($c(9)_"do ActionStatementAll^%SYS.SQLSRV(1,,,.%ROWCOUNT,.SQLCODE,.%msg)") }
	elseif mt("freeze","scope")="TABLE" { $$$liin($c(9)_"do ActionStatementRelation^%SYS.SQLSRV("""_mt("freeze","value")_""",1,,,.%ROWCOUNT,.SQLCODE,.%msg)")  }
	elseif mt("freeze","scope")="SCHEMA" { $$$liin($c(9)_"do ActionStatementSchema^%SYS.SQLSRV("""_mt("freeze","value")_""",1,,,.%ROWCOUNT,.SQLCODE,.%msg)") }
	elseif mt("freeze","scope")="ID" { 
		$$$liin($c(9)_"do FreezePlan^%SYS.SQLSRV("""_mt("freeze","value")_""",,.SQLCODE,.%msg)") 
		$$$liin($c(9)_"if SQLCODE=0 { set %ROWCOUNT=1 }")
	}
	$$$liin("} catch {")
	$$$liin($char(9)_"set SQLCODE=-400,%msg=""Unexpected error executing FREEZE PLANS:""_$ze" )
	$$$liin("}")
	$$$liin("if 'SQLCODE { TCOMMIT } else { TROLLBACK 1 }")
	do generateSQLEndCode^%qaqcasl(1)
	$$$liin("RETURN")
	RETURN
