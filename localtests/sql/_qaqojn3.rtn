====
qaqojn3
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqojn3^MAC^^^0
%qaqojn3	// QO - %qaqojn2 continued
	;; COMPONENTS :: SQL/Optimizer
	#;
#INCLUDE %msql
#INCLUDE %qao
#IF 0   ;-------------------------------------------------------------
	; Description:   QO - %qaqojn2 continued
	; Author:        Terry Ragon
	; Date:          April 22, 1988
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;  PVA279  (02/12/2014) - Enhance ptres handling for longstanding defects 
	;  PVA278  (07/03/2013) - Fix another ancient problem in management of replicated condition selectivity, exposed by PVA277 
    ;  PVA260  (06/07/2012) - Remove special case optimization for idkey joins that is superseded by PVA258, and also improve edge case. 
 	;  PVA258  (05/09/2012) - Optimize multi-key joins 
    ;  PVA256  (03/27/2012) - Enhance TOP .... ORDER BY optimization to use partial indexes more often 
    ;  PVA248  (12/19/2011) - Fix cases where %noindex hint changed the query answer.
    ;  PVA242  (07/28/2011) - Support a hint (%noindex) to not use indexes to satisfy the indicated condition. 
	;  PVA216  (01/26/2010) - Fix optimization problem with inequality collection conditions and joins 
	;  PVA194  (07/28/2009) - Remove obsolete tests for map population type in the optimizer. 
    ;  PVA177  (05/06/2009) - Fix undesired plan bias for DISTINCT queries when there is no good index for DISTINCT 
    ;  PVA154  (09/01/2008) - Improve optimizer cost model : distinguish selectivity for complex conditions on map subscripts from that on map data
	;  PVA157  (05/01/2008) - Support faster DISTINCT while preserving case (i.e. with FASTDISTINCT OFF )
    ;  PVA152  (11/08/2007) - Query Optimization improved for text and collection predicates
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  PVA086  (01/13/2006) - SQL Optimizer: maintain condition lists in intended order
	;  PVA083  (11/18/2005) - Minor discrepancy in selectivity handling
	;  PVA077  (05/05/2005) - Incorrect slow query plan being chosen
 	;  PVA072  (11/10/2004) - Support pseudo conditions implied by TOP... ORDER BY in optimizer
	;  PVA063  (07/01/2004) - Outer join with complex condition on the right operand table, may return the wrong answer.
	;  PVA056  (09/30/2003) - Another case of outer join acting like inner join 
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  PVA32   (02/06/2002) - Apply range optimizations to unrestricted index components
	;  PVA023  (10/24/2001) - Optimizer fails to prevent testing of some unnecessary conditions. 
	;  PVA025  (08/28/2001) - Fix mistake in pva016 
	;  PVA019  (10/18/2000) - CSM: Fix some cases of bad choice of join plan.
	;  PVA015  (09/20/2000) - IS NULL test will not be applied to an index being used for a join.
	;  PVA016  (09/15/2000) - Telecommunications Consulting: IS NULL test with outer join gives wrong result.
	;  PVA014  (09/13/2000) - Support CON as optional OR of constant = conditions.
	;  AK379   (07/08/1999) - Phil: Apply non-OUTER JOIN conditions
	;  DPV702  (01/03/1997) - initial creation of routine from existing code
	;                         in old routines %qaoj1 and %qaoj4
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
	; Process additional "JOIN", "CON", "RANGE", "COMP", and "MREL"
	; restrictions on this map for this join attribute
	;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	// process conditions on non-ANYOF ifns, then ANYOFAND, then conditions on ANYOF ifns
	// BUT generate the conditions in the REVERSE of the desired evaluation order
	n aoa,ifns,extracost,extdistcost
	f aoa=0:1:1
	{	continue:aoa&&'$d($$$mtNumAnyOf)
		#; Generate the ANYOFAND conditions
		if aoa
		#; PVA242: check noindex map; PVA248: move to inside other^%qaqojn3		
		{	s a="" f  { s a=$o(mts(qoqn,qosn,"COMP",a)) q:a=""  continue:$p($$$mtLOperator($$$mtL(a)),"%NOINDEX")'="ANYOFAND"  d comother }
			s a="" f  { s a=$o(mts(qoqn,qosn,"MREL",a)) q:a=""  continue:$p($$$mtLOperator($$$mtL(a)),"%NOINDEX")'="ANYOFAND"  d mother }
		}
 
		#; process additional restrictions in "JOIN"
		s ifn="" f  { s ifn=$o(mts(qoqn,qosn,"JOIN",ifn)) q:ifn=""  continue:(('aoa&&(ifn["%ANYOF"))||(aoa&&(ifn'["%ANYOF")))  s a="" f  s a=$o(mts(qoqn,qosn,"JOIN",ifn,a)) q:a=""  d jother }
		#; process restrictions in "CON" not satisfied by a subscript
		s ifn="" f  { s ifn=$o(mts(qoqn,qosn,"CON",ifn)) q:ifn=""  continue:(('aoa&&(ifn["%ANYOF"))||(aoa&&(ifn'["%ANYOF")))  d cother }
		#; process restrictions in "RANGE" not satisfied by a subscript
		#; note that we either process all or none of the range
		#; restrictions for a single ifn.  Furthermore, we only use the
		#; first of these restrictions to indicate whether or not they
		#; should all be unwound from cost formula
		#;
		s ifn="" f  { s ifn=$o(mts(qoqn,qosn,"RANGE",ifn)) q:ifn=""  continue:(('aoa&&(ifn["%ANYOF"))||(aoa&&(ifn'["%ANYOF")))  d rother }
		#; process additional restrictons in "COMP"
		#; PVA242: check noindex map; PVA248: move to inside other^%qaqojn3				
		s a="" f  { s a=$o(mts(qoqn,qosn,"COMP",a)) q:a=""  continue:$p($$$mtLOperator($$$mtL(a)),"%NOINDEX")="ANYOFAND"  continue:aoa'=$$hasAnyofIfn(a)  d comother }
		#; process additional restrictons in "MREL"
		s a="" f  { s a=$o(mts(qoqn,qosn,"MREL",a)) q:a=""  continue:$p($$$mtLOperator($$$mtL(a)),"%NOINDEX")="ANYOFAND"  continue:aoa'=$$hasAnyofIfn(a)  d mother } 
	}
	QUIT
hasAnyofIfn(log) n val,k,found,ifns,ifn s ifns=$$$mtLColVals($$$mtL(log)),found=0 f k=2:1 { s val=$p(ifns,",",k) q:val=""  if $$$mtV(val)["%ANYOF" { s found=1 quit }} QUIT found
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
jother	;
#IF 0    ; check to see if this join restriction has already been
	; processed.  If not, treat it as a "MREL" restriction
	; Also:
	; if the domain of the A stream is greater than the domain of the
	; B stream, then we must treat the selectivity of the join 
	; restriction as being the lesser of (more restrictive of) the
	; selectivity of the A or B ifn or expression.  In the case of a
	; restriction that is part of the join, if we have either a known or
	; partial match on a subscript, then we account for the additional
	; selectivity by the cost formula subscript $$$SSJAADD
	; Otherwise we just modify the selectivity of the restriction
#ENDIF   ;
	s x=mts(qoqn,qosn,"JOIN",ifn,a)
	i $p(x,"^",2)>$p(x,"^",6) s y=$p(x,"^",6),z=y/$p(x,"^",2) ;y = restriction selectivity, z = extra selectivity if domain of a > domain of b
	e  s y=$p(x,"^",2),z=1
	s b=$$resdone(a),c=","_ifn_",",d=","_a_"," ; see if restriction already processed
	#; if this restriction is in the set of join restrictions,
	#; and we have already either a known or partial match already
	#; based on a subscript, then store additional selectivity (if any)
	#; in form($$$SSJAADD)
	#; PVA077: also maintian ptform
	i jarest[d,b'=-2,z'=1 s form($$$SSJAADD)=form($$$SSJAADD)*z,ptform($$$SSJAADD)=ptform($$$SSJAADD)*z,y=$p(x,"^",2)
	QUIT:b=-1
	s extracost=$p(x,"^",7),extdistcost=0 // PVA152, PVA157, PVA177
	d other(d,y/$s(b>0:b,1:1),y,c,$p(x,"^",3),+x,0) ; TR04: added 0
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cother	; check to see if this "CON" restriction has already been
	#; processed with a subscript.  If not, process it.
	s x=mts(qoqn,qosn,"CON",ifn)
	s b=$$resdone($p($p(x,"^",2),",",2)) ; see if already processed
	QUIT:b=-1
	s extracost=$p(x,"^",7),extdistcost=0 // PVA152, PVA157, PVA177
	d other($p(x,"^",2),x/$s(b>0:b,1:1),+x,","_ifn_",","",0,+$p(x,"^",3)) ; IS NULL test is
	                                 ; a CON and must be processed after outer join
	                                 ; row available.
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
rother	; check to see if this "RANGE" restriction has already been
	#; processed with a subscript.  If not, process it.
	s e=mts(qoqn,qosn,"RANGE",ifn),f=$s(e<1:+e,1:1)
	#; either all restrictions have been applied or none have
	s b=$$resdone($p($p(e,"^",2),",",2))
	QUIT:b=-1
	s extracost=$p(e,"^",7),extdistcost=0 // PVA152,PVA157, PVA177, PVA216
	if qoouter,$e($$$mtLOperator($g($$$mtL($p($p(e,"^",2),",",2)))),1,3)="TOP"{
        #; the TOP..ORDERY BY condition would be translated into mt(....RANGE), however, mts(...RANGE) does not have
        #; entry to indicate whther this RANGE condition could be pass the condition when it is null tuple.
        #; When it is actually TOP condition, that is it actually pass the condition even if it is null tuple,
        #; always pass 0 to other() seems ignores this fact. HSU250
        d other($p(e,"^",2),f/$s(b>0:b,1:1),f,","_ifn_",","",0,1) ; TR04: added last 0
    }
    else{
        d other($p(e,"^",2),f/$s(b>0:b,1:1),f,","_ifn_",","",0,0) ; TR04: added last 0
    }
    QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
comother	; Process a complex single stream restriction
    s x=mts(qoqn,qosn,"COMP",a)
	s b=$$resdone(a) ; see if restriction already processed
	QUIT:b=-1
	s extracost=$p(x,"^",7),extdistcost=0 // PVA152, PVA157, PVA177
	#; PVA157: collectcost->extracost; add a cost for consulting distinct temp file
	#; PVA177: save the distinct cost in extdistcost in case it needs to be moved
	s:$$$mtLOperator($$$mtL(a))="DISTINCT" extracost=extracost+(CDFACTOR/CGGFACTOR),extdistcost=(CDFACTOR/CGGFACTOR) //PVA157
	#;HSU279+
	d other(","_a_",",x/$s(b>0:b,1:1),+x,$p(x,"^",2),"",0,+$p(x,"^",3)||($$$mtLOperator($$$mtL(a))["TOP")) ; TR04: added +$p(x,"^",3)
	#;HSU279-
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mother	; Process a multiple relation restriction
	s x=mts(qoqn,qosn,"MREL",a)
	s b=$$resdone(a) ; see if restriction already processed
	QUIT:b=-1
	s extracost=$p(x,"^",7),extdistcost=0 // PVA152, PVA157, PVA177
	#; PVA157: collectcost->extracost; add it a cost for consulting distinct temp file
	#; PVA177: save the distinct cost in extdistcost in case it needs to be moved
	s:$$$mtLOperator($$$mtL(a))="DISTINCT" extracost=extracost+(CDFACTOR/CGGFACTOR),extdistcost=(CDFACTOR/CGGFACTOR) //PVA157
	#;HSU279+
	d other(","_a_",",x/$s(b>0:b,1:1),+x,$p(x,"^",2),$p(x,"^",3),0,+$p(x,"^",4)||($$$mtLOperator($$$mtL(a))["TOP"))
	#;HSU279-
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
resdone(res) ;
	#;  Also called from qojinit
	#; See if this restriction has already been processed
	#; input parameter: restriction # (not bracketed)
	#; output:
	#;          -1 already processed
	#;          -2 not yet processed
	#;           0 < value < 1  partially processed
	#;                   the value represents the partial selectivity
	#;                   that was previously applied
	#; first see if we know we have processed this restriction
	#;                               no - have we partially processed it?
	#;                                                                no - indicate not at all processed yet
	QUIT:(resknown[(","_res_",")) -1 QUIT:$d(respar(res)) respar(res) QUIT -2
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
other(resall,sel,maxsel,ifnlist,streams,rid,x) ;
#IF 0    ;
	; Process this restriction.
	; If outer join, store restriction with cost formula subscipt $$$SSOE.
	; Else, if all ifns in 'ifnlist' are in this map (or this is map 0)
	; store the restriction with cost formula subscript $$$SSOI or (if
	; rest requires oth strms to already have been processed) $$$SSOIMUL.
	; Else store it with subscript $$$SSO0 or $$$SSO0MUL.  
	; This indicates whether
	; this is an "other" restriction that can be satisfied in the
	; index or in map 0 (but not by a subscript.)
	; In the ALG() array this will appear in the 'resknown'
	; or 'resmaybe' field and in the 'ressub' field with subscript
	; "index", "indexmul", "map0", "map0mul", or "outer"
	; input parameters:
	;     resall:   bracketed list of restriction #s
	;               (only "CON" and "RANGE" can pass more than
	;               one restriction, and it always calls 'known',
	;               not 'maybe')
	;     sel:      selectivity to be applied for restriction(s)
	;               This may be less than maxsel since restriction may
	;               already have been partially satisifed in a subscript
	;     maxsel:   Full selectivity of restriction(s)
	;     ifnlist:  list of ifns needed from this stream: 
	;     streams:  bracketed list of other required streams
	;     rid:      1 if this is a "JOIN" restriction on the
	;               record id (hence it must be in this map)
	;     x:         1 if this is a COMP or MREL restriction that
	;                can be passed by a nul tuple
#ENDIF   ;
	n a,b,c,fsub
	#; are all the ifns in this map?
	#; PVA154: this routine (other) sets the new post subscript form() entries
	s fsub=$$$SSOID,mapsub="index" i streams]"" s fsub=$$$SSOIMULD,mapsub="indexmul"
	i 'rid f i=2:1:$l(ifnlist,",")-1 i $p(mts(qoqn,qosn,"ATT",$p(ifnlist,",",i)),"^",7)'[(","_map_",") s fsub=$s(streams="":$$$SSO0,1:$$$SSO0MUL),mapsub=$s(streams="":"map0",1:"map0mul") q
	#; PVA248: check noindexmap, 
	if 'map0&&$bit(noindexmap,$p(resall,",",2)) s allinmap=0,fsub=$s(streams="":$$$SSO0,1:$$$SSO0MUL),mapsub=$s(streams="":"map0",1:"map0mul")
	#;
	#; PVA152: record collection cost (usually 0) in appropriate data node cost bucket
	#; PVA157: collectcost->extracost
	#; PVA177: record distinct cost component in either movdistcost or movdistcostb
 	if mapsub="index"||(mapsub="indexmul") {s form($$$SGPi)=$g(form($$$SGPi))+extracost,ptform($$$SGPi)=$g(ptform($$$SGPi))+extracost,movdistcost=extdistcost}
 	else {s form($$$SGPb)=$g(form($$$SGPb))+extracost,ptform($$$SGPb)=$g(ptform($$$SGPb))+extracost,movdistcostb=extdistcost}
	#; if this is a COMP or MREL restriction, and if a nul tuple can
	#; pass this restriction and if this is an outer join, then this
	#; restriction can only be applied to the output of the outer join
	#;
    #; when this is OUTER JOIN and this tuple could pass condition when it is null-tuple,
    #; we should test test condition after join happesn. For PL150407, the mapsub would be changed from mapsub=index to mapsub=outer
	i x,qoouter s fsub=$$$SSOE,mapsub="outer"
	#;
	#; make change to cost formula input parameter
	#; must first decide if we know that we have already processed
	#; the necessary streams, in which case we use 'know', or if
	#; there are other needed streams, in which case we use 'maybe'
	#;
	s c=",",b=$p(jainfo,"^",3) ; b = streams required for this join
	f i=2:1:$l(streams,",")-1 s a=","_$p(streams,",",i)_"," i b'[a s c=c_$e(a,2,*)
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	i c="," d known(maxsel,"",fsub,resall) QUIT  ; TR09 changed yqaojin to yqaoj4
	d maybe(sel,fsub,resall,c)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
maybe(sel,fsub,resall,stream) ;
#IF 0    ;
	; make change to cost formula input parameter, use resmaybe
	; input parameters:
	;     sel: selectivity factor
	;     fsub: cost array subscript
	;     resall: bracketed list of restrictions being satisfied
	;         format is ,res1,res2,...,
	;     stream: list of other streams that must already be present
	;             for restriction to be applied
	; Input variables:
	;     mapsub: subscript of condition in map
	; Since these restrictions are never used in determining
	; the distribution of nodes in a map, we don't need
	; a 'fsubmax' and 'fsub' as in 'known()' and 'partial()'
#ENDIF   ;
	n a,toplog,topsel,restSel,restConds,distlog,distsel //PVA077, PVA157
	#; PVA077: factorTOP needed for 'maybe' conditions because a TOP pseudo condition can 
	#;         span tables and possibly need streams that are not 'required' for the current
	#;         controlling join. 
	d factorTOPdist(sel,resall) // PVA157: factorTOP->factorTOPdist
	#; PVA077: maintain ptform as well as form, analogous to 'known' tag. 
	s form(fsub)=form(fsub)*sel ; increase selectivity
	s ptform(fsub)=ptform(fsub)*restSel ; increase selectivity
	s ptform($$$SSO0MUL)=ptform($$$SSO0MUL)*topsel*distsel // PVA157
	#; create list of restrictions with streams that are needed
	#;     for them to be satisfied
	f i=2:1:$l(resall,",")-1 s a=$p(resall,",",i),resmaybe=resmaybe_"*"_a_":"_stream
	#; PVA023: Any 'maybe' restriction can end up in nores for some join order. Thus it should be recorded 
	#;   in change() so its selectivity can be factored out if needed. Also eliminated spurious 
	#;   setting of sel to one. There is only one caller of this routine, and sel is not passed by
	#;   reference, so this operation is meaningless.
	#; PVA077: Each change() entry now has two pieces, one for form() one for ptform()
	s a=$p(resall,",",2) i a]"" {
		s change(a)=$g(change(a))_"^"_fsub_":"_(1/sel)_":"_(1/restSel) ; only want to subtract out selectivity once later
		s:(topsel'=1||(distsel'=1)) change(a)=$g(change(a))_"^"_$$$SSO0MUL_":"_1_":"_(1/topsel/distsel) // PVA157
	}
	s:$e(resmaybe)="*" resmaybe=$e(resmaybe,2,*)
	#; indicate restrictions processed on this subscript
	#; PVA086: Maintain condition lists in order. 
	s ressubm(mapsub)=$g(ressubm(mapsub),",")_$e(resall,2,*)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
%qaoj4 ;  Now process the map subscripts
	n rsub s rsub=0 ; IBA082: add rsub to keep track of higher level range conditions
	f mapsub=begsub:1 s x=$g(mts(qoqn,qosn,"MAP",map,mapsub)) q:x=""  d dosub
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dosub	;process this subscript
	s a=+x,ifn=$p(x,"^",2)
	i a=1 s qonjsub=qonjsub-1 QUIT
#IF 0    ; qojc: 1 => there is a CON or a join with this jaifnlst on
	;       this subscript
	;        used for setting 'qoorder' flag
	; qojcr: 1 => there is a CON, RANGE, or a join with this jaifnlst
	;       on this sub; the subscript could be a function of the
#ENDIF   ;       underlying ifn; used for setting 'qosubdone' flag
	s qojc=0,qojcr=0
	#; PVA32: set sel so properly initialized always for subdone.
	s sel=1
	GOTO exactifn:a=2,manyfun:(a>2)&(a<6)
	d checkid
	g:qoouter subdone //PVA063
	d conrid:conrid]""
	GOTO ordifn:a=6,subdone
exactifn	; we have a subscript that is an exact ifn that satisfies
	#; either a "JOIN, "CON", or "RANGE" (or several) on that ifn.
	#; This subscript cannot be used to satisfy a function on the ifn.
	s mapsubifn=mapsubifn_ifn_","
	GOTO exact1:jasub]""
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	i mapsub>0,$$testja s:'qosubdone jasub=mapsub,qojcr=1,qojc=(+x=2)!(+x=3) d known($p(jainfo,"^",2),"",$$$SSJASUB,jarest) GOTO exact1 ; TR01: deleted if $p(jaifnlst,",",2)=ifn
	i map0,qojrid,mapsub>0,jasub="" s:'qosubdone jasub=mapsub,qojcr=1 d known($p(jainfo,"^",2),"",$$$SSJASUB,jarest) GOTO exact1
	d checkid ; check to see if idsub flag is set
	#; PVA258: With multi-key joins, even if current subscript exact, later ones may be functions,
	#;         and partial matching of conditions desirable.
	GOTO exact1:jasub]""
	i mapsub>0,$$testmany s:'qosubdone jasub=mapsub,qojcr=1,qojc=0 s c=$p(jainfo,"^",2)*1.2,c=$s(c>$p(x,"^",3)&(c<1):c,1:$p(x,"^",3)) d partial(c,$p(jainfo,"^",2),"",$$$SSJASUB,jarest) GOTO exact1
	#; check for "CON" restriction - Skip all non join conditions on subscripts if outer join.
exact1	g:qoouter subdone s sel=1,b=$g(mts(qoqn,qosn,"CON",ifn))
	#; if "CON" exists, the $S(...mts) in the following allows for the
	#; possibility that it was migrated to other streams through a join
	#; Also make sure that this CON restriction isn't a comparison with
	#; a null string, which can't be done with a subscript
	#;
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	#; PVA014: Don't set qojc if the CON is an OR generalized CON. 
	i b]"" { ; there is a CON condition
		d known(+b, ; +b is the selectivity of b condition
				$s((jasub="")&rsub:"",jasub="":$$$SSE1M,jasub=mapsub:$$$SSE2M,1:$$$SSE3M), ; fsubmax
				$s((jasub="")&rsub:$$$SSOI,jasub="":$$$SSE1,jasub=mapsub:$$$SSE2,1:$$$SSE3), ; fsub
				$p(b,"^",2)) ; $p(b,"^",2) is the log
		s:'$p(b,"^",4) qojc=(+x=2)!(+x=3) s sel=-1,qojcr=1 ; $p(b,"^",4) CON represents an IN condition
	}
	d conrid:conrid]"" ; check for possible CON on record id
	#; check for range selectivity
	s b=$g(mts(qoqn,qosn,"RANGE",ifn)) s:(b]"") rsub=1
	GOTO chkcomp:b=""
	s qojcr=1
	#; PVA083: Following logic removed:  if sel = -1, we had a "CON" cond, don't apply any more selectivity
	#; PVA32: Moved setting of rangesub to subdone because now includes case of an unrestricted subscript
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	d known(+b,$s(mapsub>0:$$$SSRM,1:$$$SSE1M),$s(mapsub>0:$$$SSR,1:$$$SSE1),$p(b,"^",2))
chkcomp	s a=""  ; See if there is a complex restriction that can now be processed
#IF 0   ; AK379+
	f i=1:1 s a=$o(mts(qoqn,qosn,"COMP",a)) q:a=""  d chkcomp1
#ELSE   ; AK379=
	#;  if outer join, don't process these in subscripts, they'll
	#;      go into mapsub "outer" in comother->other
	#; PVA016: following check now done higher up, to cover CON and RANGE as well.
	#; PVA025: Oops - we want to get rid of the qoouter test here, but keep the COMP loop
	f  s a=$o(mts(qoqn,qosn,"COMP",a)) q:a=""  d:(map0||'$bit(noindexmap,a)) chkcomp1 // PVA242: check noindexmap
#ENDIF  ; AK379-
subdone	i 'qojc,jasub="" s qoorder=0
	#; PVA32: rangesub now set here so it applies to unbounded subscripts
	i sel'=-1,mapsub>0,rangesub="",'qosubdone s rangesub=mapsub,rangeifn=ifn
	s qonjsub=qonjsub-1 i 'qojcr,qonjsub<0 s qosubdone=1
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
chkcomp1	; see if this complex restriction can be performed on this subscript
	s b=mts(qoqn,qosn,"COMP",a),c=$p(b,"^",2)
	#; see if all needed subscripts are present
	f i=2:1:$l(c,",")-1 GOTO chkcomp2:mapsubifn'[(","_$p(c,",",i)_",")
	#; this complex condition can be processed now
	s c=$$resdone(a) ; see if restriction already processed
	QUIT:c=-1
	d distcost(a,1) //PVA157
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	d known(+b,"",$$$SSOI,","_a_",")
chkcomp2	QUIT
	#; We have an interesting order ifn or a subscript on which we can
	#; process a complex condition.  The subscript must be an exact
	#; ifn or a known function (e.g. %ALPHAUP) of an ifn
ordifn	s mapsubifn=mapsubifn_ifn_$s($p(x,"^",6)="":"",1:"_"_$p(x,"^",6))_","
	GOTO chkcomp
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA157: create distcost
distcost(log,join)
	n mapsub,x,type,ifn,ifnv,ifnvlist,ifnvbit,b
	quit:$$$mtLOperator($$$mtL(log))'="DISTINCT"
	#; PVA177: set movdistcost
	if join {s form($$$SGPi)=$g(form($$$SGPi))+(CDFACTOR/CGGFACTOR),ptform($$$SGPi)=$g(ptform($$$SGPi))+(CDFACTOR/CGGFACTOR),movdistcost=(CDFACTOR/CGGFACTOR) QUIT} // bad case cost
	#; Unless this analysis is moved to solution generation, there is not enough
	#; information to ever determine that a DISTINCT after the initial stream
	#; can avoid use of a temp table. 
	s ifnvlist=$$$mtLColVals($$$mtL(log)),ifnvbit=$$pctobit^%qaqomul(ifnvlist)
	// If map is not a collection index (even bit slice ok), and ifnvlist contains only the
	// rowid, idkey components, or any primary key components, then map should unilaterally
	// be costed as not requiring distinct temp file. This is deferred for the future since
	// it can only arise from nonstandard sql (see devlog for 
	// details).
	f mapsub=begsub:1 
	{  s x=$g(mts(qoqn,qosn,"MAP",map,mapsub)) q:x=""  s type=+x
	   continue:type=1  continue:type=9 // type=9 is equivalent to equality on subscript, for this purpose
	   quit:type<2||(type>6) // not a field; currently no way to match distinct expression with subscript expression
	   s ifn=$p(x,"^",2)_$s($p(x,"^",6)="":"",1:"_"_$p(x,"^",6)),ifnv=$p($g(mts(qoqn,qosn,"ATT",ifn)),"^",5)
	   if ifnv=""||($bit(ifnvbit,ifnv)=0 )
	   {  // if simple (not IN type) CON, continue
	   	  s b=$g(mts(qoqn,qosn,"CON",ifn_"_"_$p(x,"^",6)))
	   	  continue:b]""&&'$p(b,"^",4)
	   	  #; can't do conrid analysis without changing how conrid tag works; currently it kills
	   	  #;  the necessary information, and is called before distcost is reached. Minor
	   	  #;   lost optimizer opportunity.
	   	  #; 
	   	  #; We ignore the map populate tests. They are obsolete and should be removed from 
	   	  #; the main code (since not null maps were converted to conditional maps, 
	   	  #; with pre-qualification). 
	   	  s b=$g(mts(qoqn,qosn,"CON",ifn)) // partially satisfied CON
	   	  continue:b]""&&'$p(b,"^",4)
	   	  #; 
	   	  #; If we handle joins in the future (see above), then an equijoin is also good
		  quit
	   } 
	   else {s $bit(ifnvbit,ifnv)=0 
	   }
	}
	#; PVA177: set movdistcost and dgood 
	if $bitcount(ifnvbit,1)>0 // couldn't satisfy all of the distinct values	- temp cost
	 {s form($$$SGPi)=$g(form($$$SGPi))+(CDFACTOR/CGGFACTOR),ptform($$$SGPi)=$g(ptform($$$SGPi))+(CDFACTOR/CGGFACTOR),movdistcost=(CDFACTOR/CGGFACTOR)} 
	else {s ptform($$$SGPi)=$g(ptform($$$SGPi))+(CDFACTOR/CGGFACTOR),movdistcost=(CDFACTOR/CGGFACTOR),dgood=1 } // good case - no temp file cost unless index used prepprocess
	  #; Note that in the 'good case' for index usage, but with index used in a preprocess
	  #; the temp file cost enhancement will apply when the index map is used in the 
	  #; preprocess (incorrect) while the DISTINCT selectivity will be applied in the
	  #; main process (correct). This is accepted as a tolerable inaccuracy. The primary 
	  #; effect of favoring strategies for which no temp file is necessary still occurs. 
	QUIT	
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
manyfun	; we have a subscript that is a many-to-one function of an ifn
	#; and there is a "JOIN", "CON", or "RANGE" on either the exact
	#; ifn or this function of the ifn.
	#; Processing is similar to 'exactifn', except this subscript
	#; can be used on restrictions on the function or on
	#; restrictions on the exact ifn.
	s mapsubifn=mapsubifn_ifn_"_"_$p(x,"^",6)_"," ; TR05 added
	GOTO many1:jasub]""
	#; check for join on this function of this ifn
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	i mapsub>0,$$testja s:'qosubdone jasub=mapsub,qojcr=1,qojc=1 d known($p(jainfo,"^",2),"",$$$SSJASUB,jarest) GOTO many1
	#; see if 'idsub' is set
	d checkid
	GOTO many1:jasub]""
	#;
	#; If it is the same ifn, allow for a join on the exact ifn
	#;  to be partially satisfied by this function of an ifn
	#; If it is a one-to-one function, we can exactly satisfy
	#; the restriction.
	#; If this is a many to one function, we have partial satisfaction
	#; of this restriction with a selectivity of the greater of
	#; 1.2 * join attribute selectivity and that specified
	#;     in mts(..."MAP",...)
	#; First, see if jaifnlst is exactly 1 entry and it is the exact ifn
	#;
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	#; PVA056: Don't consider using an index that only partially satisfies join if it is outer join
	#;          add: 'qoouter||(+x'=5) // see knowpart for basis of this test.
	i jaifnlst=(","_ifn_","),mapsub>0 s:'qosubdone jasub=mapsub,qojcr=1,qojc=+x=3 s c=$p(jainfo,"^",2)*1.2,c=$s(c>$p(x,"^",3)&(c<1):c,1:$p(x,"^",3)) d knowpart(c,$p(jainfo,"^",2),"",$$$SSJASUB,jarest) GOTO many1
	#; Then, see if the set of entries in jaifnlst could be satisfied by 
	#; this and subsequent subscripts except for the many-to-one
	#; aspect of this and subsequent subscripts
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	#; PVA056: Don't consider using an index that only partially satisfies join if it is outer join
	#;          add: 'qoouter
	#; PVA258: eliminate spurious condition on calling testmany: $p(jaifnlst,",",2)=ifn
	i mapsub>0,$$testmany s:'qosubdone jasub=mapsub,qojcr=1,qojc=0 s c=$p(jainfo,"^",2)*1.2,c=$s(c>$p(x,"^",3)&(c<1):c,1:$p(x,"^",3)) d partial(c,$p(jainfo,"^",2),"",$$$SSJASUB,jarest) GOTO many1
many1	; check for "CON" restriction
	g:qoouter subdone s sel=1,b=$g(mts(qoqn,qosn,"CON",ifn_"_"_$p(x,"^",6)))
	#;
	#; if "CON" exists, the $S(...mts) in the following code allows for
	#; the possibility that it was migrated to other streams through a
	#; join.  Make sure that this CON restriction isn't a comparison with
	#;
	#; a null string, which can't be done with a subscript
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	#; PVA014: Don't set qojc if the CON is an OR generalized CON. 
	i b]"" d known(+b,$s((jasub="")&('rsub):$$$SSE1M,jasub=mapsub:$$$SSE2M,1:$$$SSE3M),$s((jasub="")&('rsub):$$$SSE1,jasub=mapsub:$$$SSE2,1:$$$SSE3),$p(b,"^",2)) s:'$p(b,"^",4) qojc=1 s sel=-1,qojcr=1
	#; check for range selectivity
	s b=$g(mts(qoqn,qosn,"RANGE",ifn_"_"_$p(x,"^",6)))
	GOTO many2:b=""
	s qojcr=1
	#; PVA083: Remove following logic: if sel = -1, we had a "CON" cond so don't apply any more selectiv
	#; PVA32: Rangesub set moved to subdone to pick up unbounded subscripts
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	d known(+b,$s(mapsub>0:$$$SSRM,1:$$$SSE1M),$s(mapsub>0:$$$SSR,1:$$$SSE1),$p(b,"^",2))
	#; PVA32: Don't override sel becoming -1; this is a one time change; so introduce sel2 to remember 
	#;        partial selectivity. 
many2	n sel2 s sel2=$p(x,"^",3) s b=$g(mts(qoqn,qosn,"CON",ifn)) ; sel2 = selectivity of partial rest
	#;
	#; $s(...mts) allows for migration of restriction to another joined 
	#; stream
	#; Also make sure that this CON restriction isn't a comparison with
	#; a null string, which can't be done with a subscript
	#;
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	#; PVA32: Use sel2 for partial selectivity, preserving sel as flag.
	i b]"" d knowpart(sel2,+b,$s(jasub="":$$$SSE1M,jasub=mapsub:$$$SSE2M,1:$$$SSE3M),$s(jasub="":$$$SSE1,jasub=mapsub:$$$SSE2,1:$$$SSE3),$p(b,"^",2)) s sel=-1,qojcr=1
	d conrid:conrid]"" ; check for possible CON on record id
	#; check for range selectivity if type = 3
	GOTO many3:x-3
	s b=$g(mts(qoqn,qosn,"RANGE",ifn)) s:b]"" rsub=1
	GOTO many3:b="" s qojcr=1
	#; PVA32: Moved setting of rangesub to subdone to pick up unbounded subscripts
	#;        Also use sel2 for partial selectivity, preserving sel as flag.
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	#; PVA32: Use sel2 for partial selectivity, preserving sel as flag.
	#; PVA072: Knowpart changed to known since when x=3 they are the same.
	#;         This means setting sel2 no longer needed. 
	d known(+b,$s(mapsub>0:$$$SSRM,1:$$$SSE1M),$s(mapsub>0:$$$SSR,1:$$$SSE1),$p(b,"^",2))
many3	GOTO chkcomp
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA023: Eliminate last argument of known, partial, and knowpart
known(sel,fsubmax,fsub,resall) ;
#IF 0    ; make change to cost formula input parameter, use resknown
	; input parameters:
	;     sel: selectivity factor
	;     fsubmax: cost array subscript that is used in determing
	;              node distribution
	;     fsub: cost array subscript  (Selectivity factor is applied to
	;          both fsub and fsubmax, but it is only removed from
	;          fsub if restriction is already processed)
	;     resall: bracketed list of restrictions being satisfied
	;         format is ,res1,res2,...,
	; Input variables:
	;       mapsub: subscript being considered in this map
	;     qosubdone
	; if we have already encountered an uninteresting subscript,
	; don't let this restriction be treated as occurring on a subscript
	; for cost formula purposes, but still record on which subscript
	; the restriction can be processed.
#ENDIF   
	#; PVA023: Minor fix to comment and SSOI override fix added for PVA019
	#;      Sometimes this called for $$$SSJASUB when qosubdone and mapsub >0. This
	#;       should not be overwriten with $$$SSOI ever. 
	#;      Doing so would imply they could be applied BEFORE the join, in building a temp file. 
	#; PVA072: add toplog,topsel,restSel,restConds
	#; PVA023: 'new' resnum since no longer an argument
	n b,resnum,toplog,topsel,restSel,restConds,distlog,distsel,sel2,resnum2,res3
	i qosubdone,mapsub s fsubmax="",fsub=$g(fsub) s:fsub'=$$$SSJASUB fsub=$$$SSOI
	d factorTOPdist(sel,resall) //PVA072,PVA157
	s b=$$resdone($p(resall,",",2))
	GOTO known1:b=-1 ; allow for already processed
	#; PVA072: Now mainain restSel+sel, ptform+form
	if fsubmax'="" {
		set form(fsubmax)=form(fsubmax)*sel,ptform(fsubmax)=ptform(fsubmax)*restSel
		set formlog(fsubmax)=$g(formlog(fsubmax))_resall
		#; IBA164 - check for unique constraints for combined selectivity estimation
		do:$d(mts(qoqn,qosn,"UNIQUECON")) combineSelectivities(fsubmax,qoqn,qosn)
	}
	s:b>0 restSel=restSel/b s:b>0 sel=sel/b ; already partially processed 
	#;   Note re above:  partial processing cannot apply to topsel or distsel
	if fsub'="" {
		s form(fsub)=form(fsub)*sel,ptform(fsub)=ptform(fsub)*restSel,formlog(fsub)=$g(formlog(fsub))_resall ; increase selectivity
		#; IBA164 - check for unique constraints for combined selectivity estimation
		do:$d(mts(qoqn,qosn,"UNIQUECON")) combineSelectivities(fsub,qoqn,qosn)
	}
	s ptform($$$SSO0MUL)=ptform($$$SSO0MUL)*topsel*distsel // PVA157
	#; PVA086: Maintain condition lists in order. 
	s resknown=$e(resknown,1,*-1)_resall ; restrictions we know we can satisfy
	#; PVA023: Set resnum the way argument was previously set by callers
	#; PVA072: Each change() entry now has two pieces, one for form() one for ptform()
	s resnum=$p(resall,",",2) i resnum]"",$d(ptres(resnum)),'$$impliedByAnyofand(resnum) {
		s change(resnum)=$g(change(resnum))_"^"_fsub_":"_(1/sel)_":"_(1/restSel) ; leaves extra ^ at front
	#; PVA278: If SSE2 selectivity adjusted, also adjust SL2B, because join cost formulas only use SSE2 as encoded
	#;    in SL2B. Both numtup, global, and disk access computations are incorrect for replicated constant=
	#;    conditions testid on joinsub unless this is done. 
	#;    NOTE: if f1=f2 as subscript limiting condition ever done, then for initial stream usage,
	#;        - both SSE1 and SSE2 change() entries may occur
	#;        - all of the following may need adjustment, as if recomputed from scratch: SNitup,SNiblk,SL2B,SZB
	#;          (Alternatively, cost formulas could be revamped to make direct, correct, use of SSE1/SSE2. Currently,
	#;           the plain version of these (rather than SSE1M,SSE2M) are never used at all!).
		s:fsub=$$$SSE2 change(resnum)=$g(change(resnum))_"^"_$$$SL2B_":"_(1/sel)_":"_(1/restSel)
		s:(topsel'=1||(distsel'=1)) change(resnum)=$g(change(resnum))_"^"_$$$SSO0MUL_":"_1_":"_(1/topsel/distsel) // PVA157
	}
	i resnum]"" && (b=-2) && $d(seladj(resnum)) 
	{  // PVA279
	   #; b=-2 means condition never seen before. Unlike for ptres, seladj conditions that are partially
	   #;    processed, then fully processed, are only adjusted during partial^%qaqojn3. 
	   #; Note: impliedbyanyofand not relevant, and collection predicates never participate in seladj
	   #; Accumulate all adjustments for resnum. We assume (and is true for current uses) that when one is
	   #;   applicable, all are. If this ceases to be true, something more than the change() array/ adjsel
	   #;   scheme would be needed [would need change(a,b), and adjsel would be a list of change specs to used, e.g. (a,b).
	   #;   We also assume that seladj entries do not currently exist for ranges,
	   #;   which is the only case where resall includes multiple conditions. Finally, we assume that we 
	   #;   never adjust a condition's selectivity BY join selectivity. Join conditions are not present in
	   #;   seldict, and ptv no longer exists (thus $$GetSel would fail), and there are two selectivities associated with joins 
	   #;   (one for each two mt("JOIN") entries created for one join condition. 
	   s res3="",sel2=1 for 
	   {  s res3=$o(seladj(resnum,res3),1,resnum2) q:res3=""
	      s sel2 = sel2*$$GetSel^%qaqomul(resnum2) 
	   }
	   s change(resnum)=$g(change(resnum))_"^"_fsub_":"_(1/$s(sel2<sel:sel,1:sel2))_":"_(1/$s(sel2<restSel:restSel,1:sel2))
	   s:fsub=$$$SSE2 change(resnum)=$g(change(resnum))_"^"_$$$SL2B_":"_(1/$s(sel2<sel:sel,1:sel2))_":"_(1/$s(sel2<restSel:restSel,1:sel2))
	   #; TOP/DISTINCT preds may be implied, and may need to adjust an equality, but themselves never
	   #;   need seladj treatment.
	}
	#; indicate restrictions processed on this subscript
	#; PVA086: Maintain condition lists in order. 
known1	i $g(ressubk(mapsub))'[resall s ressubk(mapsub)=$g(ressubk(mapsub),",")_$e(resall,2,*)
	#; PVA157: If distinct satisfiable on index map, record this fact
	if ",map0,map0mul,outer,"'[(","_mapsub_","),$$$mtLOperator($$$mtL($p(resall,",",2)))="DISTINCT" s hasdist=1
	#; PVA256: If top range condition satisfiable on index map, record this fact
	if ",map0,map0mul,outer,"'[(","_mapsub_","),$$toprange(resall) s hastoprange=1
	#; PVA072: maintain tressubk as well
	s:$g(tressubk(mapsub))'[restConds tressubk(mapsub)=$g(tressubk(mapsub),",")_$e(restConds,2,*)
	s:toplog]""&&($g(tressubk("map0mul"))'[(","_toplog_",")) tressubk("map0mul")=$g(tressubk("map0mul"),",")_toplog_","
	#; PVA157: Also for distlog
	s:distlog]""&&($g(tressubk("map0mul"))'[(","_distlog_",")) tressubk("map0mul")=$g(tressubk("map0mul"),",")_distlog_","
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    #; PVA256: create toprange function
toprange(resall) // See if resall contains a TOP range predicate
	#; Note there are TOP comp and mrel predicates as well
 	n found,i,log,op,rng,logs s found=0
 	f i=2:1 
 	{  s log=$p(resall,",",i) q:log=""  
 	   if $$$mtL(log)["TOP:" s found=1 quit
 	}
 	if found 
 	{  s rng="",found=0 f   // now must verify it is a range
 	   {  s rng=$o(mts(qoqn,qosn,"RANGE",rng),1,logs) q:rng=""
 	      i $p(logs,",",2)=$p(resall,",",2) s found=1 q
 	   }
 	}
	QUIT found 		
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
impliedByAnyofand(log)
    n implist,found s found=0
    #; PVA242: %noindex handling
    s implist="" f  s implist=$o(ptres(log,implist)) q:implist=""  continue:$l(implist,",")'=3  if $p($$$mtLOperator($$$mtL($p(implist,",",2))),"%NOINDEX")="ANYOFAND" { s found=1 quit }
	QUIT found
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA023: Eliminate last argument of known, partial, and knowpart
partial(sel,maxsel,fsubmax,fsub,resall) ;
#IF 0    ; make change to cost formula input parameter, use respar
	; input parameters:
	;     sel:   selectivity factor given that this is only partial
	;              satisfaction of this restriction
	;     maxsel:  selectivity of restriction
	;     fsubmax: cost array subscript that is used in determining
	;              node distribution
	;     fsub: cost array subscript (Selectivity factor is applied to
	;          both fsub and fsubmax, but it is only removed from
	;          fsub if restriction is already processed)
	;     resall: bracketed list of restrictions being satisfied
	;         format is ,res1,res2,...,
	; Input variables:
	;        mapsub: subscript being examined for this map
	;     qosubdone
	; if we have already encountered an uninteresting subscript,
	; don't let this restriction be treated as occurring on a subscript
	; for cost formula purposes, but still record on which subscript
	; the restriction can be processed.
#ENDIF   ;
	#; PVA023: Minor fix to comment and SSOI override fix added for PVA019
	#;      Sometimes this called for $$$SSJASUB when qosubdone and mapsub >0. This
	#;       should not be overwriten with $$$SSOI ever. 
	#;      Doing so would imply they could be applied BEFORE the join, in building a temp file. 
	i qosubdone,mapsub s fsubmax="",fsub=$g(fsub) s:fsub'=$$$SSJASUB fsub=$$$SSOI
	#; PVA023: 'new' resnum since no longer an argument; also set it the same way callers used to
	n b,resnum,sel2,resnum2,res3 s resnum=$p(resall,",",2),b=$$resdone(resnum)
	GOTO partial1:b=-1  ; allow for already processed
	#; PVA077: Maintain ptform as well as form()
	i fsubmax'="" {
		s form(fsubmax)=form(fsubmax)*sel
		s ptform(fsubmax)=ptform(fsubmax)*sel
	}
	i b>0,sel*b<maxsel s sel=maxsel/b ; already partially processed
	i fsub'="" { 
		s form(fsub)=form(fsub)*sel ; increase selectivity
		s ptform(fsub)=ptform(fsub)*sel
	}
	#; PVA086: Maintain condition lists in order. 
	s respar=$e(respar,1,*-1)_resall ; restrictions we know we can partially satisfy
	#; PVA077: Change() array now has an additional piece in each entry.
	i resnum]"",$d(ptres(resnum)),'$$impliedByAnyofand(resnum) {
		s change(resnum)=$g(change(resnum))_"^"_fsub_":"_(1/sel)_":"_(1/sel) ; leaves extra ^ at beg
	#; PVA278: If SSE2 selectivity adjusted, also adjust SL2B, because join cost formulas only use SSE2 as encoded
	#;    in SL2B. Both numtup, global, and disk access computations are incorrect for replicated constant=
	#;    conditions testid on joinsub unless this is done. 
	#;    NOTE: if f1=f2 as subscript limiting condition ever done, then for initial stream usage,
	#;        - both SSE1 and SSE2 change() entries may occur
	#;        - all of the following may need adjustment, as if recomputed from scratch: SNitup,SNiblk,SL2B,SZB
	#;          (Alternatively, cost formulas could be revamped to make direct, correct, use of SSE1/SSE2. Currently,
	#;           the plain version of these (rather than SSE1M,SSE2M) are never used at all!).
		s:fsub=$$$SSE2 change(resnum)=$g(change(resnum))_"^"_$$$SL2B_":"_(1/sel)_":"_(1/sel)
	}
    i resnum]"" && (b=-2) && $d(seladj(resnum)) 
    {   
       #; PVA279: see detailed comments in known^%qaqojn3
 	   s res3="",sel2=1 for 
	   {  s res3=$o(seladj(resnum,res3),1,resnum2) q:res3=""
	      s sel2 = sel2*$$GetSel^%qaqomul(resnum2) s:sel2<sel sel2=sel
	   }
	   s change(resnum)=$g(change(resnum))_"^"_fsub_":"_(1/sel2)_":"_(1/sel2)
	   s:fsub=$$$SSE2 change(resnum)=$g(change(resnum))_"^"_$$$SL2B_":"_(1/sel2)_":"_(1/sel2)
	}
	#; keep track of partial selectivity of this restriction
	s b=$p(resall,",",2),respar(b)=$s($d(respar(b)):respar(b),1:1)*sel
	#; indicate restrictions processed on this subscript
	#; PVA086: Maintain condition lists in order. 
partial1	i $g(ressubp(mapsub))'[resall s ressubp(mapsub)=$g(ressubp(mapsub),",")_$e(resall,2,*)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA023: Eliminate last argument of known, partial, and knowpart
knowpart(a,b,c,d,e) ;
	#; If one-to-one correspondence function, use known()
	#; Else, its many-to-one and we use partial()
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	i +x=5 d partial(a,b,c,d,e) QUIT
	d known(b,c,d,e)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
testja() ;
#IF 0    ;
	; See if this and immediately following subscripts (except for
	;    intervening constants) form the join
	;    attribute.  There must be a one-to-one correspondence, although
	;     one-to-one functions are allowed on the subscripts.
	; return: 1 if subscript(s) = jaifnlst
	;     also, if return a 1, then set:
	;         qonjsub = # of sub used for the set of join attributes
	;     qonumjasub = ,s1,s2,...,
	;       where sx = # subs used for corresponding join restriction
#ENDIF   ;
	n a,b,c,d,f,sub,ifn s a=1,sub=mapsub,d=",",f=1
	f i=2:1:$l(jaifnlst,",")-1 s ifn=$p(jaifnlst,",",i),c=sub d testja1 q:'a  s d=d_(sub-c)_","
	i a s qonjsub=sub-mapsub,qonumjasub=d s:'f&'qosubdone&'jasub qoorder=0 QUIT 1
	QUIT 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
testja1	s b=$g(mts(qoqn,qosn,"MAP",map,sub)),sub=sub+1
	i +b=1 GOTO testja1 ; skip constant subscript
	#; Check for %id matching idkey representation (PVA260)
	i $p(b,"^",4)>0 && (ifn=$p(mts(qoqn,qosn),"^",5)) {s sub=sub+$p(b,"^",4)-1 QUIT }
	#; if ifn in jaifnlst is a function, then the subscript should
	#; also be the same function of the ifn
	i ifn'=+ifn s a=$p(b,"^",2)_"_"_$p(b,"^",6)=ifn QUIT
	#; ifn in jaifnlst is an exact ifn, make sure this subscript is
	#; the same ifn
	i $p(b,"^",2)'=ifn s a=0 QUIT
	#; if exact ifn or one-one function, then we pass
	i (+b=2)!(+b=3) QUIT
	#; if one-to-one function with different order, indicate not in order
	i +b=4 s f=0 QUIT
	s a=0
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
testmany() ;
	#; See if this and immediately following subscripts (except for
	#;      intervening constants) form the join
	#;     attribute except for possible many to one (or one to one)
	#;     functions.
	#; return: 1 if subscript(s) = jaifnlst or a function of them
	#;     also, if return a 1, then set:
	#;         qonjsub = # of sub used for the set of join attributes
	#;     qonumjasub = ,s1,s2,...,
	#;     where sx = # subscripts used for corresponding join restriction
	#;
	n a,b,c,d,f,sub,ifn s a=1,sub=mapsub,d=",",f=1
	f i=2:1:$l(jaifnlst,",")-1 s ifn=$p(jaifnlst,",",i),c=sub d testman1 q:'a  s d=d_(sub-c)_","
	i a s qonjsub=sub-mapsub,qonumjasub=d s:'f&'qosubdone qoorder=0 QUIT 1
	QUIT 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
testman1	s b=$g(mts(qoqn,qosn,"MAP",map,sub)),sub=sub+1
	i +b=1 GOTO testman1 ; skip constant subscript
	#; Check for %id matching idkey representation (PVA260)
	i $p(b,"^",4)>0 && (ifn=$p(mts(qoqn,qosn),"^",5)) {s sub=sub+$p(b,"^",4)-1 QUIT }
	#; if wrong ifn or type = 6, no match
	i ($p(b,"^",2)'=+ifn)!(b>5) s a=0 QUIT  
	#; if ifn in jaifnlst is a function, then the subscript should
	#; also be the same function of the ifn
	i ifn'=+ifn s a=$p(b,"^",2)_"_"_$p(b,"^",6)=ifn QUIT
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
checkid	; See if idsub flag is set, which indicates that this set of
	#; subscripts is in one-to-one correspondence with the record id.
	#; If so, and the join is on the record id, we can do the join
	#; on these subscripts
	#;
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	i qojrid,$p(x,"^",4)!map0,qonjsub<1,'jasub,'qosubdone s qonjsub=$p(x,"^",4),qonumjasub=","_qonjsub_"," d known($p(jainfo,"^",2),"",$$$SSJASUB,jarest) s jasub=mapsub,qojcr=1 i '$p(x,"^",5) s qoorder=0
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
conrid	; if there is a CON condition on the record id, and this is the
	#; 1st subscript of map0 or it is a subscript in another map that
	#; has the idsub flag set, then we can process the CON condition
	QUIT:conrid=""
	i 'map0,'$p(x,"^",4) q
	#; if restriction already satisfied, don't worry about it
	s c=$p($p(conrid,"^",2),",",2)
	i resknown[(","_c_",") s conrid="" QUIT
	#; PVA023: Eliminate last argument of known, partial, and knowpart
	i '$p(conrid,"^",3) d known(+conrid,$s(jasub="":$$$SSE1M,jasub=mapsub:$$$SSE2M,1:$$$SSE3M),$s(jasub="":$$$SSE1,jasub=mapsub:$$$SSE2,1:$$$SSE3),$p(conrid,"^",2)) s sel=-1,qojc=0,qojcr=1,conrid=""
	QUIT
 	#; PVA072: new function factorTOP	
 	#; PVA157: generalized to factorTOPdist
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
factorTOPdist(sel, conds)
	#; Implicit inputs : qoqn
	#; Implicit outputs: toplog,topsel,restSel,restConds,distlog,distsel
	#; 
 	#; If any of the conditions is TOP or DISTINCT, then factor it out
 	#;
	n i,lnum
 	s toplog="",topsel=1,restSel=sel,restConds=conds,distlog="",distsel=1
 	#; PVA177: don't factor special preds if outer join - must always test 
 	#;         after padding
 	if mapsub'="outer",$d($$$mtTopLimit(qoqn)) {
 		for i=2:1 { s lnum=$p(restConds,",",i) quit:lnum=""  
 		  if $e($$$mtL(lnum),1,6)="v^TOP:" {
 			  s toplog=lnum,topsel=$$GetSel^%qaqomul(lnum),restSel=restSel/topsel
 			  s $p(restConds,",",i,i+1)=$p(restConds,",",i+1)
 			  quit		// Rely on there being only one TOP in the list
 		  }
 		}
 	}
 	if mapsub'="outer",$d($$$mtGroupDistinctList(qoqn))
 	{  for i=2:1 
 	   { s lnum=$p(restConds,",",i) quit:lnum=""  
 	     if $e($$$mtL(lnum),1,11)="v^DISTINCT^"
 	     { s distlog=lnum,distsel=$$GetSel^%qaqomul(lnum),restSel=restSel/distsel
 	       s $p(restConds,",",i,i+1)=$p(restConds,",",i+1)
 		   quit		// Rely on there being only one DISTINCT in a query block
 	     }
 	   }
	}
 	s:restConds="," restConds=""
 	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    #; This function updates the combined selectivities in form(sub) and ptfom(sub)
	#; when there these two conditions are satisfied:
	#; 1. There is a unique index on two or more fields
	#; 2. There is equal 'CON' condition on each one of these fields
	#; in this case, the combined selectivity of these conditions should be 1/extentsize
	#; because of the uniqueness constraint.
combineSelectivities(sub,qoqn,qosn) [mts,form,ptform,formlog] PUBLIC {
	set listLogs=$p(mts(qoqn,qosn,"UNIQUECON"),"^",2),uniqueFound=1
	for cnt=2:1:$l(listLogs,",")-1 {
		set log=$p(listLogs,",",cnt)
		set:formlog(sub)'[(","_log_",") uniqueFound=0
	}
	#; if there is a unique constraint on a unique index, replace the combined selectivity by 1/extentsize
	if uniqueFound {
		#; update form. tform may get these updates if we copy form(sub) into tform(sub)
		set form(sub)=form(sub)/mts(qoqn,qosn)/$p(mts(qoqn,qosn,"UNIQUECON"),"^",3)
		#; update ptform. tform may get these updates if we copy ptform(sub) into tform(sub)
		set ptform(sub)=ptform(sub)/mts(qoqn,qosn)/$p(mts(qoqn,qosn,"UNIQUECON"),"^",3)
	}
	QUIT
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
---
