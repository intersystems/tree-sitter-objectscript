====
qaqpcmp
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpcmp^MAC^^^0
%qaqpcmp(imp)	// $$: use conditional map (9/21/87)
	;; COMPONENTS :: SQL/Optimization
	#;
#INCLUDE %msql
	#;
#IF 0   ;-------------------------------------------------------------
	; Description:   Determine whether or not to use Conditinal Map
	; Author:        Aviel Klausner
	; Date Started:  September 21, 1987
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;  PVA296  (11/08/2013) - Fix possible <SUBSCRIPT> error when TOP..ORDER BY used on a conditional map with a range condtion on same field as ORDER BY 
    ;  PVA272  (02/15/2013) - Support separate selectivity for frequent outlier value 
	;  DPV3337 (01/08/2009) - New collate
	;  BJB385  (06/04/2008) - Correct IF logic in con+8^%qaqpcmp 
	;  BJB384  (05/13/2008) - Fix <UNDEFINED>collate+7^%qaqpcmp *whatever for conditional map
	;  PVA153: (11/07/2007) - NOT NULL conditional map was not used when null test is EXACT and qualifying query predicates are collated.
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  DPV2546 (11/08/2005) - Implement new MVR collation function.  Change collation implementations to use $zu(28)
	;  PVA058  (12/17/2003) - <UNDEFINED> in range+19^%qaqpcmp 
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  PVA049  (01/13/2003) - undo dpv1902, fix $$tag with no parens correctly 
	;  DPV1902 (12/18/2002) - Allow $$tag^rtn in conditional map expression [without ()]
	;  PVA044  (10/29/2002) - Conditional indexes don't work with collated properties. 
	;  PVA38   (07/18/2002) - Conditional maps with column'="" condition should be usable with almost any 
	;                         WHERE clause condition on the column.
	;  PVA37   (07/11/2002) - Conditional maps not used when they should be. 
	;  DPV1300 (05/01/2000) - Fix <NOLINE> and syntax errors.
	;  DPV1149 (09/28/1999) - Remove internal id number dependencies for parent-child relationships
	;  AK326   (07/23/98)   - Replace ?<pat> with %PATTERN <const>
	;  DPV837  (05/13/98)   - Eliminate colinfo function
	;  MRP701  (07/15/97)   - Fix <UNDEFINED> for Conditional Map Resolution
	;  DPV700  (02/03/97)   - IS NOT NULL now becomes an easy condition to
	;                         test for.  Allow maps found to be OK through
	;                         $$easy be selected by QO.
	;  MRP667  (02/03/97)   - Fix Conditional Maps for IS NOT NULL Conditions...
	;  DPV696  (12/05/96)   - Fix UNDEFINED at check for complex conditions
	;  MRP649  (10/07/96)   - Allow Cond. Maps for JOINs on Des Ref Fields
	;  MRP644  (10/04/96)   - Use Conditional Maps for Index Expression Fields...
	;  MRP639  (08/23/96)   - Allow Conditional Map for Complex RANGE Specifications...
	;  MRP638  (08/22/96)   - Allow override host variable comparisons...
	;  MRP637  (08/13/96)   - Allow Cond. Maps for: 
	;                           WHERE <field> <cond> <host var>...
	;  MRP624  (06/30/96)   - Use Conditional Map for qualifying conditions.
	;  DPV597  (02/27/96)   - Fix <NOLINE> potential - pttrn
	;  MRP568  (01/25/96)   - Fix the Parser for 'Fields'
	;  MRP501  (05/10/95)   - All the query optimizer to consider the Conditional Map...
	;
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
	;  RETURN:  1 - If Conditional Map can be used
	;           0 - If Not
	;
	;  INPUT:   cmap - Map Conditions w/o "i "
	;  OUTPUT:  list=LIST(log#,) of fully satisfied conditions, if any
	;           MRP501 (Alway Set 'list=""' for QO to consider)
	;
	;  Variables Already Defined:  m,str,irn,idifn,imp0,imp,mname
	;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	  #; PVA044: add new of cmap2,p2,p3,const2,partial
	n a,b,c,cmap,cmap2,collate,complist,const,const2,db,f,logs,mask,op,p,p2,p3,paren,partial,token,usemap,value	// DPV3337 (collate)
	n begline,begtoken,endline,endtoken,indexline,prevtoken,pprev,lineprev,pprev
	  #; PVA38: comment added:
	  #; I think complist is supposed to be conditions partially satisfied by conditional map
	  #; conditions. This information is no longer stored, thus 'new'ed above. Maintenance kept 
	  #; in case this is revived. 
	s cmap=$$$smdMapConditionalCode(imp),complist="",db=$c(1),list="",paren=0
	s const="",op=""
	  #; PVA044: In cmap, change $$<collate>({ifn}) into {ifn_<collate>}. Also translate
	  #; $$<collate>(<literal>) to the result of its evaluation. In both cases, handle
	  #; optional length argument of collate functions.
		#; PVA049: mask aplha characters for easier function name lexical processing in cosex
	s mask=$tr(cmap,"123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz","000000000xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")_" "
	s p=1,cmap2="",p3=1
	d lext 
	f  {
	  f  q:token="$$"  q:token=""  d lext
	  q:token=""
	  if $$$ISENCODEDCOLLATE(value) d lext continue
	  if ",ALPHAUP,MVR,UPPER,STRING,SQLSTRING,SQLUPPER,TRUNCATE,COLLATE,"'[(","_value_",") d lext continue
	  s const="",p2=f-1,collate=value,const2=""
		#; PVA049: add extra lext to eat parenthesis that is no longer consumed by cosex	  
	  d lext,lext  ; we unilaterally assume & skip parenthesis if we found collation function
	  if $$check("fld",.ifn) {  ;field case
	    if $$check(",") continue:'$$check(9,.const)
	    continue:'$$check(")")
	 s cmap2=cmap2_$e(cmap,p3,p2)
	 s cmap2=cmap2_"{"_ifn_"_%"_collate_$s(const]"":"("_const_")",1:"")_"}"
	 s p3=f
	    }
	  elseif $$check(9,.const)  { ; literal case
	    if $$check(",") continue:'$$check(9,.const2)
	    continue:'$$check(")")
	  	 s cmap2=cmap2_$e(cmap,p3,p2)
	  	 s cmap2=cmap2_$$quoter^%qaqcasl($$collate(collate,const,const2))
	  	 s p3=f
	 }
	  }
	s:cmap2]"" cmap2=cmap2_$e(cmap,p3,*),cmap=cmap2
	s const="" ; set up for 'hard' tag 
	  #; PVA38: $$notnull case added
	QUIT:$$notnull 1 ; simple case rules of map condition is {fld}'=""  (fld is not null)
	QUIT:$$easy 1
	  #; PVA38: Fix bug where complist was assigned into list. This overwrote query conditions that are fully 
	  #;        satisfied by map conditions with those that are only partly satisfied.
	s usemap=$$hard 
	QUIT usemap
	  #; PVA044: add collation function
	  #; PVA272: make it complete to use for testing conditions agains outlier values
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
collate(collation,str,len="") // no EXACT, since killexact should eliminate those before this called
	if collation="SQLUPPER" {QUIT:'len $$$SQLUPPER(str) QUIT $$$SQLUPPERT(str,len) }
	if collation="SQLSTRING" {QUIT:'len $$$SQLSTRING(str) QUIT $$$SQLSTRINGT(str,len)}
	if collation="STRING" {QUIT:'len $$$STRING(str) QUIT $$$STRINGT(str,len)}
	if $$$ISENCODEDCOLLATE(collation) {
		new parm1
		do decodeCollate^%qaqcpre(collation,.parm1)
		if len'="" {
			QUIT $$$COLLATET(str,parm1,len)	
		}
 		QUIT $$$COLLATE(str,parm1) 
 	}
	if collation="ALPHAUP" QUIT $$$ALPHAUP(str)
	if collation="UPPER" QUIT $$$UPPER(str) 
	if collation="MVR" QUIT $$$MVR(str) 
	if collation="SPACE" QUIT " "_str
	if collation="PLUS" QUIT +str
	if collation="MINUS" QUIT -str
	if collation="TRUNCATE" {QUIT:'len $$$TRUNCATE(str) QUIT $$$TRUNCATET(str,len) }
	QUIT whatever ; one way to do a bug trap
	  #; PVA38: added notnull and nnull tags
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
notnull() ; special case handling for <field> NOT NULL as complete map condition
  #; PVA044: fix 'parsing' below to handle non-numeric ifn (for collation).
	n c
	s a=$p(cmap,"{"),ifn=$p($p(cmap,"{",2),"}"),b=$p(cmap,"}",2)
	QUIT:a_"{"_ifn_"}"_b'=cmap 0 ;  more than one {ifn} instance. Note, braces
	                                    #; in literal strings will throw this
	                                    #; off. Probably other exotics as well.
	  #; PVA044: extract collation and look for 'null type condition matching collation
	s c=$p($p(ifn,"%",2),"(") 
	if c'="",",MVR,STRING,SQLUPPER,SQLSTRING,"[(","_c_",") {QUIT:b'="'="" """ 0 }		// DPV2546 MVR cannot return SQL NULL (According to Scott)
	elseif $$$ISENCODEDCOLLATE(c){
		new parm1,parm2
		do decodeCollate^%qaqcpre($p(ifn,"%",2),.parm1,.parm2)
		QUIT:b'="'="""_##class(%Library.Collation).Collate("",parm1,parm2)_"""" 0 
	}
	else {  QUIT:b'="'=""""" 0}   ; only interested in {fld}'="" or " " as complete map condition
	QUIT $$nnull
nnull()  ; also used by 'hard' tag 
	n xlog,info,cifn
	if $$comphv s list=list_xlog_II QUIT 1 ; this is the only case notnull finds a fully satisfied condition
	                                      #; thus it goes on list
	  #; PVA044: enhance following to realize that ifn(any collation) not null is 
	  #;         consistent with most any condition on any (other) collation of the 
	  #;         same ifn.
	#; PVA153: fix lookups for related collations to work reliably if ifn is uncollated
	if $d(mts(m,str,"RANGE",+ifn)) QUIT 1 ; RANGE conditions are never true for null
	s cifn=$o(mts(m,str,"RANGE",+ifn_"_")) QUIT:+cifn=+ifn 1
	s info=$g(mts(m,str,"CON",+ifn)) if info]"",$p(info,"^",3)=0 QUIT 1 ; CON does not pass null, so compatible with 'null map condition
	s cifn=$o(mts(m,str,"CON",+ifn_"_"),1,info) if +cifn=+ifn,$p(info,"^",3)=0 QUIT 1
	if $d(mts(m,str,"JOIN",+ifn)) QUIT 1 ; For now, all joins reject null in target ifn (even though may
	                                    #; padded with null for outer join. 
	s cifn=$o(mts(m,str,"JOIN",+ifn_"_")) QUIT:+cifn=+ifn 1
	  #; Ideally, COMP and MREL should be analyzed to see if they would invariably reject a
	  #; null value of this ifn. If so, then they are compatible with this map condition. 
	QUIT 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
easy() ; Try satisfying the condition the easy way...
	  #; PVA044: fix parsing  below to account for non-numeric ifn
	s a=$p(cmap,"{"),ifn=$p($p(cmap,"{",2),"}"),b=$p(cmap,"}",2)
	QUIT:a_"{"_ifn_"}"_b'=cmap 0           ;  more than one {ifn} instance
	QUIT:'$$con 0                          ;  {ifn}=var or {ifn} IS NULL
	QUIT:'log 0                            ;  no CON condition
	  #; PVA044: eliminat test for con'["'=""""" as this was never really returned by $$con
	i con["""" QUIT 0                      ;  x will not work
	s:+con'=con con=""""_con_""""          ;  supply " if not numeric
	  #; PVA044: only add to list if CON is fully satisfied
	i con_"="=a,""=b s:'partial list=log_II QUIT 1  ;  const={ifn}
	i ""=a,"="_con=b s:'partial list=log_II QUIT 1  ;  {ifn}=const
	x "s log=0 i "_a_con_b_" s log=1"
	QUIT log
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
hard() ; The hard way, also sets list of direct hits...
	n indxexp
 #; PVA049: mask aplha characters for easier function name lexical processing in cosex
	s mask=$tr(cmap,"123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz","000000000xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")_" "
	s p=1 d lext
 #; PVA049: elimate $$check for $$, as cosex no longer consumes a parenthesis.
	i $$check("(") s paren=paren+1
cond	i $$check("fld",.ifn) QUIT:'$$chose("'='<'>",.op) 0 QUIT:'$$check(9,.const) 0 g order
	QUIT:'$$check(9,.const) 0           ;  must be const-op-{ifn}
	QUIT:'$$chose("'='<'>",.op) 0
	QUIT:'$$check("fld",.ifn) 0
	s op=$TR(op,"<>","><")              ;  reverse to {ifn}-op-const
	  #; PVA38: Intercept and handle 'not null' map conditions and handle separately from others
	  #; PVA044: Form of null constant in map condition depends on collation
order	if op="'=",const=$s(",MVR,STRING,SQLUPPER,SQLSTRING,"[(","_$p($p(ifn,"%",2),"(")_","):" ",1:"") { if $$nnull {g ok} else {quit 0} }
	if op="'=",$$$ISENCODEDCOLLATE($p($p(ifn,"%",2),"(")){
		new parm1,parm2
		do decodeCollate^%qaqcpre($p(ifn,"%",2),.parm1,.parm2)
		if const=##class(%Library.Collation).Collate("",parm1,parm2){ 
			if $$nnull {g ok} else {quit 0} 
		}
	}
	QUIT:'$$con 0                       ;  {ifn}=variable or {ifn} IS NULL
	i 'log q:op="=" 0 q:const["""" 0 d  g:logs'="" range QUIT 0 ; g comp ; PVA044: comp, join now obsolete
	. s logs=$p($g(mts(m,str,"RANGE",ifn)),"^",2)
	. i logs="",$d(%fldinfo("f",ifn)) d  ; --- Check Index Expressions ---
	.. n len,sub s len=$l(ifn),sub=ifn
	.. f  s sub=$o(%fldinfo("f",sub)) q:$e(sub,1,len)'=ifn  d  q:logs'=""
	... s logs=$p($g(mts(m,str,"RANGE",sub)),"^",2)
	... s:logs'="" indxexp=$p(sub,ifn_"_",2,*)  ; Use later in 'range'..
	  #; PVA044: only add to list if fully satisfied
	i op="=" q:const'=con 0 s:'partial list=list_log_II g ok  ;  direct hit!
	i op="'=" q:const=con 0                    g ok
	q:const_con["""" 0 x "s log="""_con_""""_op_""""_const_"""" q:'log 0
ok	; --- Condition Satisfied, Check the rest ---
	i paren,$$check(")") s paren=paren-1
	i $$chose(",&") d  g cond  ; Condition satisfied, look for next one
 #; PVA049: elimate $$check for $$, as cosex no longer consumes a parenthesis.
	. i $$check("(") s paren=paren+1
	q token=""
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
range	; Check Range...
	s logs=$p(logs,II,2,*),log=+logs q:'log 0
	  #; PVA38: 'new' xlog, now returned by $$comphv.
	n xlog,holdlog,clt,cop,len s holdlog=log
	s log=$$$mtL(log),cop=$p(log,I,2),log=$$$mtV($p(log,I,5))
	  #; PVA044: support collate of parameter and collate of literal
	if $e(log)="v" { 
	  s clt=$p($p(log,"^",2),"%",2) s:clt]"" len=$p($p(clt,"(",2),")"),clt=$p(clt,"(") 
	  if (($$$ISENCODEDCOLLATE(clt))||(",ALPHAUP,UPPER,STRING,SQLSTRING,SQLUPPER,MVR,TRUNCATE,"[(","_clt_","))),"xt"[$e($$$mtV($p(log,"^",4))) {	// DPV2546
	 s log=$$$mtV($p(log,"^",4))
	 s:$e(log)="t" $e(log,3,*)=$$collate(clt,$e(log,3,*),len)
	 } 
	  }
	  #; PVA37: remove argument from $$comphv; test node piece 13 agains 1 not "Y" for Cache SQL
	i $e(log)="x",$$comphv()  ; OK to Continue ...
	e  i $e(log)="x",$$$smdMapConditionalHostVariables(imp)=1  ; OK to Continue (Override)...
	e  i $e(log)="v",$g(indxexp)'="",indxexp=$p(log,"^",2) ; OK Index Expr
	e  g range:"t"'=$E(log)
	  #; ------ op/cop give 16 cases, 8 of them are incompatible ------
	  #; ------ (next line), the other 8 depend on log/const ------
	i "'="'=op,$L($TR(op_cop,"<"))#2 g range  ;  sorry, but it works
	#; PVA044: eliminate some osolete code
	#; PVA058: At query compile time, the following tests are only safe with literals. 
	g:$e(log)'="t" range
	s log=$E(log,3,*) i log="" g range
	i op=cop,const=log s list=list_+logs_II,complist=complist_holdlog_"," g ok  ;  direct hit!
	i op=cop,op["'" x "s log="_log_cop_const g range:'log s complist=complist_holdlog_"," g ok
	x "s log="""_const_""""_cop_log g range:log s complist=complist_holdlog_"," g ok
	q
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA058: Clarify outputs of this function.
	#;  return 0 if an unusable CON found, 1 otherwise (no CON, or usable CON).
	#;    A usable CON will have log set for the CON, and con set to a compile time 
	#;    known value. The variable 'partial' is set for the caller as described below.
con() 
	  #; PVA38: 'new' xlog, now returned by $$comphv.
	n xlog,clt,len s partial=0
	  #; PVA044: mostly rewrite this function, allowing the case of a CON on exact ifn being
	  #;        useful when the conditional map condition refers to a callation of the ifn.
	  #;        this case sets 'partial' because the CON is NOT satisfied by use of the 
	  #;        conditional map, though it enables use of the conditional map. Support collation
	  #;        of literals. Remove erroneous code that assumed a NOT NULL
	  #;        condition could be represented as a CON (such a condition is always a COMP).
	  #; Make sure there is a CON condition
	s log=$p($p($g(mts(m,str,"CON",ifn)),I,2),II,2) 
	if 'log s log=$p($p($g(mts(m,str,"CON",+ifn)),I,2),II,2) QUIT:'log 1 s partial=1
	  #; Make sure condition is not {ifn} IS NULL. This not handled yet- could be, needing
	  #;    similar stuff to what what do with 'NULL around collations: looking for "" vs
	  #;    " " in map condition.
	i $p($g(mts(m,str,"CON",ifn)),I,3) QUIT 0
	s con=$$$mtV($p($$$mtL(log),I,5))
	if $e(con)="v" { 
	#; PVA058: Only collation of a literal is good.
	  s clt=$p($p(con,"^",2),"%",2) s:clt]"" len=$p($p(clt,"(",2),")"),clt=$p(clt,"(") 
	  if (($$$ISENCODEDCOLLATE(clt))||(",ALPHAUP,UPPER,STRING,SQLSTRING,SQLUPPER,MVR,TRUNCATE,"[(","_clt_","))),"t"[$e($$$mtV($p(con,"^",4))) {	// DPV2546
	 	s con=$$$mtV($p(con,"^",4))
	 	if $e(con)="t" s $e(con,3,*)=$$collate(clt,$e(con,3,*),len)
	 	else  QUIT 0
	 	} 
	  else { QUIT 0 }
	  }
	#; PVA058: only a literal value is available at query compile time:
	if $e(con)'="t" QUIT 0
	if partial s $e(con,3,*)=$$collate($p($p(ifn,"%",2),"("),$e(con,3,*),$p($p($p(ifn,"%",2),"(",2),")"))
	s con=$e(con,3,*)
	QUIT 1
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
check(t,x) ; Advance if t encountered, return its value in x
	i t=token s x=$g(value) d lext q 1
	QUIT 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
chose(tlist,x) ; Advance if a token in tlist encountered, return it in x
	i token'="",tlist[token s x=token d lext QUIT 1
	QUIT 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
lext	; Lexical Processor...
	  #; PVA044: move f=p setting to beginning so it is updated for last lext call.
	  #;         This needed for string manipulations at top of %qaqpcmp. 
	s f=p i p'<$L(mask) s token="" QUIT
	s c=$E(mask,p),token="X"
	#; AK326
	  #; PVA044: eliminate pttrn tag - it never worked and was never used if it did
	g digit:c=0,strng:""""=c,field:c="{"
	#; AK326-
	i c=".",$E(mask,p+1)=0 g digit     ;  a number such as ".56"
	  #; PVA044: Support $$func( as token for $$<collation>
	g cosex:$e(mask,p,p+1)="$$"
	s token=c,p=p+1
	s:token="'" token="'"_$E(mask,p),p=p+1
	QUIT
 #; PVA049: rewrite cosex - now completely different from qaqplex version.
 #; PVA044: shamelessly steal from qaqplex (but simplify) a little
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cosex	;  COS extrinsic function call (unlike in qaqplex, does not eat a possible "(" )
    for p=p+2:1 s c=$e(mask,p) q:c=""  q:"0x^%."'[c
	s token="$$",value=$e(cmap,f+2,p-1)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
field	;---------- {ifn} ----------
	  #; PVA044: fix to parse non-numeric ifns. 
	f p=p+1:1 q:$E(mask,p)="}"  q:$E(mask,p)=""
	QUIT:$E(mask,p)'="}"  s token="fld",value=$E(cmap,f+1,p-1),p=p+1
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
digit	;---------- numerical constant ----------
	f p=p:1 q:$E(mask,p)'=0
	i $E(mask,p)=".",$E(mask,p+1)=0 f p=p+2:1 q:$E(mask,p)'=0
	i $E(cmap,p)="E" s:"+-"[$E(mask,p+1) p=p+1 q:$E(mask,p+1)'=0  f p=p+2:1 q:$E(mask,p)'=0
	s token=9,value=+$E(cmap,f,p-1)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
strng	;---------- string constant ----------
	f loop=0:0 s p=$F(cmap,c,p+1) q:$E(cmap,p)'=c
	QUIT:'p  s token=9,value=$E(cmap,f,p-1) x "s value="_value
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	  #; PVA044: eliminate pttrn tag - it never worked and was never used if it did
	#; DPV1300
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
error(e) GOTO ^%qaqperr  ; -- e is error# --
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; DPV1300-
	  #; PVA37: Remove argument from comphv (it was always the same), and make separate routine
	  #;        (prior method of fallin into comp didn't work and was incomprehensible)
comphv() ; Check for a NOT NULL Condition on the given 'ifn'
	  #; PVA38: return 'null log for callers who want it as xlog
	n good,log,loginfo,oper,ifns
	s good=0,log=""
	  #; PVA044: Allow for ifn_collate1 'null to imply ifn_collate2 'null (for a map condition
	  #;    based on ifn_collate2).
	f  s log=$o(mts(m,str,"COMP",log)) q:'+log  d  q:good
	.  s ifns=$p(mts(m,str,"COMP",log),"^",2)
	.  q:$l(ifns,",")'=3  q:+$p(ifns,",",2)'=+ifn
	.  s loginfo=$g($$$mtL(log))
	.  s oper=$p(loginfo,"^",2)
	.  s:oper="'NULL"&&($$$mtVType($$$mtV($p(loginfo,"^",4)))="f") good=1 ; defensively code against future support for expr(ifn)not null
	.                                        ; such expression could be one that maps nulls to not null values
	  #; PVA38: return 'null log for callers who want it as xlog
	s:good xlog=log
	QUIT good
	  #;PVA044: The comp and joins tags are obsolete after pv044. At some 
	  #;        point they should be eliminated (or disabled features of them that would cover
	  #;        new cases should be fixed up and re-enabled).
comp	; Check for COMPlex Conditions here..
	n good,log,loginfo,not,null,oper,valinfo
	n oldlist s oldlist=complist
	s log="",(good,not,null)=0
	f  s log=$o(mts(m,str,"COMP",log)) q:'+log  i (","_ifn_",")[$p(mts(m,str,"COMP",log),"^",2) d  q:'good   ; --- Check Proper Conditions ---
	. s loginfo=$g($$$mtL(log))
	. i $e(loginfo)="l" d  ; --- Logical ---
	.. s:$p(loginfo,"^",2)="'" not=1
	.. s loginfo=$g($$$mtL(+$p(loginfo,"^",4)))
	.. s oper=$p(loginfo,"^",2)
	     #; PVA37: remove line only used for old approach to comphv
	.. i oper="IN" q  ; Process Later...
	.. i oper="NULL" s null=1 q  ; NULL found
	.. i oper="=" s null=($p($g($$$mtV(+$p(loginfo,"^",5))),"^",2)="") q
	.. i oper'="=" s null=($p($g($$$mtV(+$p(loginfo,"^",5))),"^",2)'="") q
	.. s null=0  ; Couldn't set NULL since not found
	. e  d  ; -- Condition ---
	.. s oper=$p(loginfo,"^",2)
	     #; PVA37: remove line only used for old approach to comphv
	.. i oper="IN" q  ; Process Later...
	.. s not=(oper="'=")
	.. s null=($p($g($$$mtV(+$p(loginfo,"^",5))),"^",2)="")
	. i oper="IN" d  ; --- Process IN ---
	.. q  ; ******* DON'T ALLOW 'TILL IN FIXED ********
	.. n ii,sub
	.. f ii=5:1 s sub=$p(loginfo,"^",ii) q:'+sub  d  q:null  ; Find NULL
	... s valinfo=$g($$$mtV(sub))
	... i $e(valinfo)'="t" s null=1 q  ; Not allowed...
	... s null=($p(valinfo,"^",2)="")
	.. i ifn=+ifn,op="'=",const="" s good=$s('not&'null:1,not&null:1,1:0)
	.. e  ; *** Other Tests Here ***
	. e  s good=$s(not&null&(op="'=")&(const=""):1,1:0)
	. s complist=complist_log_","
	s:'good complist=oldlist
	  #; PVA37: remove line only used for old approach to comphv
	g:good ok
joins	QUIT:$$$smdColReferencedTable(1,$$$smdGetIrnFromIfn(+ifn),+ifn)="" 0
	  #; It is a Designative Reference field
	n good,log,stream
	s good=0,stream=""
	f  s stream=$o(mts(m,str,"JOIN",+ifn,stream)) q:'+stream  d  q:'good   ; --- Check Proper JOIN Conditions ---
	. s log=$p($p($g(mts(m,str,"JOIN",+ifn,stream)),"^",3),",",2)
	. q:'log  ; No Logical Applied
	. i ifn=+ifn,op="'=",const="" s complist=complist_log_"," s good=1  ; {field}'=""
	g:good ok
	QUIT 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#INCLUDE %fcmask        
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
---
