====
qaqosn2
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqosn2^MAC^^^0
%qaqosn2  // QO - %qoasin continued (Terry 4/22/88)
	;; COMPONENTS :: SQL/Optimizer
	#;
#INCLUDE %msql         
#INCLUDE %qao 
#IF 0   ;-------------------------------------------------------------
 ; Description:   QO - %qoasin continued
 ; Author:        Terry Ragon
 ; Date Started:  22 April 1988
 ; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
 ;
 ;  JMM758  (09/27/2016) - Don't create initial stream sort temp file algorithm for TOP queries
 ;  PVA348  (03/01/2016) - PVA348 - Support Lateral references in JSON_TABLE through optimizer 
 ;  PVA256  (03/27/2012) - Enhance TOP .... ORDER BY optimization to use partial indexes more often 
 ;  PVA248  (12/19/2011) - Fix cases where %noindex hint changed the query answer.
 ;  PVA213  (07/09/2011) - A new hint %ALLINDEX is provided to request that 'all indexes' be used for the first table in the join order. 
 ;  PVA212  (05/01/2011) - Multi-index optimization will now use indexes for all 'efficient' equality conditions, by default. 
 ;  PVA177  (05/06/2009) - Fix undesired plan bias for DISTINCT queries when there is no good index for DISTINCT 
 ;  PVA154  (09/01/2008) - Improve optimizer cost model : distinguish selectivity for complex conditions on map subscripts from that on map data
 ;  PVA157  (05/01/2008) - Support faster DISTINCT while preserving case (i.e. with FASTDISTINCT OFF )
 ;  PVA152  (11/08/2007) - Query Optimization improved for text and collection predicates
 ;  PVA073  (01/28/2005) - Avoid unnecessary data map access for "TOP n id .... ORDER BY id" queries; also for idkey columns. Also, additional TOP bugs.
 ;  PVA072  (11/10/2004) - Support pseudo conditions implied by TOP... ORDER BY in optimizer
 ;  PVA066  (08/25/2004) - Initial optimizer support for bit slice indexes 
 ;  PVA039  (08/07/2002) - sql: viewtest: an <UNDEFINED>%qaqosn2+5^%qaqosn2 error 
 ;  PVA36   (06/27/2002) - Query processor uses temp files too often. 
 ;  PVA34   (03/15/2002) - Use more than one index per table for restriction.
 ;  PVA33   (03/08/2002) - Consider an index if it contains join or ORDER BY attribute as data. 
 ;  PVA32   (02/06/2002) - Apply range optimizations to unrestricted index components
 ;  PVA31   (02/01/2002) - Consider using indexes even when no WHERE or ORDER BY clauses
 ;  PVA023  (10/24/2001) - Optimizer fails to prevent testing of some unnecessary conditions. 
 ;  PVA030  (09/28/2001) - poor index selection for join
 ;  PVA029  (09/13/2001) - DeutcheBank: Fix MRP699 and related projects causing cust. benchmark disaster. 
 ;  PVA020  (10/25/2000) - Fix case where ORDER BY and range on a column didn't use index. 
 ;                         (Accidental side effect of PVA012). 
 ;  PVA012  (08/10/2000) - Improve performance of some range queries.
 ;  AK430   (03/06/1999) - BERNE: Disable temp-files on virtual fields
 ;  AK392   (09/02/1999) - Query Optimizer alg() counter
 ;  DPV890  (10/21/98)   - Fix MRP699, avoid <SUBSCRIPT> in validlog
 ;  MRP699  (07/02/97)   - Allow Index Maps for COMPlex Conditions...
 ;   MRP639 (08/23/96) - Allow Conditional Map for Complex RANGE 
 ;                       Specifications...
 ;   MRP625 (07/01/96) - Use Map for qualifying IN conditions...
 ;   MRP624 (06/30/96) - Use Conditional Map for qualifying conditions.
 ;
 ;   TR001;AK263
 ;
 ;-------------------------------------------------------------
 ;                       I N F O R M A T I O N
 ;-------------------------------------------------------------
 ;
 ; Collect additional information about this map and interesting order
 ;
 ; input variables:
 ;  as described at top of qojinit:
 ;     qoqn,qojsn,qosn,form(),
 ;     resknown,resmaybe,respar,ressubk(),ressubm(),ressubp(),change()
 ;  also created in qojinit:
 ;     rangeifn: ifn of range (or unbounded) subscript
 ;     qoridifn: record id ifn ^ comma bracketed list of component 
 ;               ifns of record id
 ;     jasub: subscript at which interesting order is found (or starts)
 ;            (null string if not found)
 ;     rangesub: sub at which range is found (null string if none). Note, unbounded 
 ;               sub is also considered a rangesub (PVA32). 
 ;     map: map # being considered
 ;     map0: 1 if this is map 0
 ;     qojrid: 1 if JA is record id
 ;     qoouter: 1 if outer join
 ;     jaifnlst: interesting order ifn list, bracketed by , (or null)
 ;     qoorder: map automatically produces an interesting order
 ;     qoio: list of col #s that form interesting order (, bracketed)
 ;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: Setting of ressub moved here from jfile because needed for setresalready2 call and also 
 #;   there is no need to compute it for every jfile call. It is constant over a given call to 
 #;   %qaqosn2. Also, 'new' savchange, savform
 #; get list of restrictions by subscript
 n ressub,savchange,savform,tressub
 #; get list of restrictions by subscript
 s ressub="" f i=$o(mts(qoqn,qosn,"MAP",map,"")):1:$o(mts(qoqn,qosn,"MAP",map,""),-1),"index","indexmul","map0","map0mul","outer" s ressub=ressub_"*"_i_":"_$g(ressubk(i))_":"_$g(ressubm(i))_":"_$g(ressubp(i))
 s ressub=$p(ressub,"*",2,99)
 #; PVA072; Now need a tressub for algorithms with a pre-process step
 s tressub="" f i=$o(mts(qoqn,qosn,"MAP",map,"")):1:$o(mts(qoqn,qosn,"MAP",map,""),-1),"index","indexmul","map0","map0mul","outer" s tressub=tressub_"*"_i_":"_$g(tressubk(i))_":"_$g(ressubm(i))_":"_$g(ressubp(i))
 s tressub=$p(tressub,"*",2,99)
  #; PVA023: make a copy of current change() for easy restoration after adjustment when temp algs 
 #;   generated
 s i="" f  s i=$o(change(i)) q:i=""  s savchange(i)=change(i)
 #; is the JA in the map?  If so, set jainmap = 1
 #; PVA039: eliminate '+' in front of $p(jaifnlst..) for lookup in mts(  ,"ATT", ). This was always wrong
 #;     not consistent with similar code elsewhere in the optimizer. 
 i 'qojrid f i=2:1:$l(jaifnlst,",")-1 i $p(mts(qoqn,qosn,"ATT",$p(jaifnlst,",",i)),"^",7)'[(","_map_",") s jainmap=0 g b
 s jainmap=1
 #;
 #; find out how much is in this map and how much must
 #; be obtained from map 0
 #; set map0read or mapiread to indicate:
 #;           # fields read
 #; mapiread represents data contained in this map,
 #;     map0read represents other needed data
 #;     If this is map0, then mapiread is used for all data
 #; allinmap = 1 if everything is in this map
 #; calculate outnodes: (data needed to produce sort file)
 #;     # nodes to output , max total data length per tuple , average 
 #;       total data length per tuple
 #;     Don't include 7 bytes needed to store node overhead
 #; PVA248: move initialization of allinmap to map^%qaqosn.
b s map0read="",mapiread="",outnodes="1,0,0",d=0 
 #; PVA030: use nodes^%qaqojn2 instead of duplicating
 s a="" f i=1:1 s a=$o(mts(qoqn,qosn,"ATT",a)) q:a=""  d nodes^%qaqojn2
 #; PVA030: remove completely bogus way of telling if data is in subscripts
 #; setup other form() parameters
 s a=mts(qoqn,qosn,"MAP",$p(mts(qoqn,qosn),"^",4))
 #; PVA072: Now maintain ptform() as well as form
 s form($$$SNbtup)=$p(a,"^",2),form($$$SNbblk)=+a
 s ptform($$$SNbtup)=form($$$SNbtup),ptform($$$SNbblk)=form($$$SNbblk)
 #; calculate # tuples in 'index map' after satisfying all
 #; high level equals and implicit map restrictions.
 #; = # tuples in index * form($$$SSE1M)*form($$$SSE2M) / sel of 
 #;   implicit rest
 #; = # tuples in map 0 * form($$$SSE1M)*form($$$SSE2M)
 #; PVA072: Now maintain ptform() as well as form - note SSE1M and 2M
 #;         cannot be affectged by TOP: predicates.
 s form($$$SNitup)=$p(a,"^",2)*form($$$SSE1M)*form($$$SSE2M)
 #; PVA073: Fix ptform maintenance to compute from ptform entries;
 #;         in some special situations TOP selectivity can be 
 #;         recorded in SSE1M/2M 
 s ptform($$$SNitup)=$p(a,"^",2)*ptform($$$SSE1M)*ptform($$$SSE2M)
 #; # blocks used in index (after satisfying all high level
 #; equals and implicit map restrictions.)
 #; = # blks in index * form($$$SSE1M)*form($$$SSE2M) / sel of 
 #;   implicit rest
 s b=mts(qoqn,qosn,"MAP",map)
 #; MRP639+
 #; --- Multiply by the % of Rows Specified by Conditional Map ---
 #; PVA072: Now maintain ptform() as well as form - note SSE1M and 2M
 #;         cannot be affectged by TOP: predicates.
 s form($$$SNiblk)=b*form($$$SSE1M)*form($$$SSE2M)*($p(b,"^",2)/$p(a,"^",2))
 #; PVA073: Fix ptform maintenance to compute from ptform entries;
 #;         in some special situations TOP selectivity can be 
 #;         recorded in SSE1M/2M 
 s ptform($$$SNiblk)=b*ptform($$$SSE1M)*ptform($$$SSE2M)*($p(b,"^",2)/$p(a,"^",2))
 #; MRP639-
 #; # data nodes we need to retrieve per tuple in index map
 #; PVA072: Now maintain ptform() as well as form
 #; PVA152: Allow for possibility [pt]form(SGP{i/b}) already has a collection cost recorded
 s form($$$SGPi)=1+$g(form($$$SGPi))
 s ptform($$$SGPi)=form($$$SGPi)
 #; # data nodes we need to retrieve per tuple in map 0
 #; PVA072: Now maintain ptform() as well as form
 s form($$$SGPb)=1+$g(form($$$SGPb))
 s ptform($$$SGPb)=form($$$SGPb)
 #; if interesting order ifn is a subscript, calculate distribution
 #; of nodes.
 #; form($$$SL2B) = # of nodes at the interesting order subscript level
 #;        ('jasub') in which the node passes all $$$SSE1M and $$$SSE2M
 #;        restrictions (i.e. equals restrictions at and
 #;        above the JA)
 #; form($$$SZB)  = # of nodes at subscript level 'jasub'+1 (i.e.
 #;              immediately following the interesting order 
 #;              subscript level) for each node at the 'jasub' level
 #; form($$$SL2B)*form($$$SZB) = % of time that for a given JA we will
 #;     find the JA in the index under the specified higher
 #;     level equals restrictions (not counting restrictions on JA)
 #; Don't consider selectivity of a restriction on the JA,
 #;   since we are only concerned about distribution here.
 #; PVA072: Now maintain ptform() as well as form
 i 'jasub s form($$$SL2B)=1,form($$$SZB)=1,ptform($$$SL2B)=1,ptform($$$SZB)=1 g c
 s c=(form($$$SNitup)/form($$$SSE2M))*form($$$SSJASUB) 
 #; i c>1, there is at least one tuple for each JA that passes all
 #;        high level restrictions (other than restrictions on the JA)
 i c>1 s form($$$SZB)=c,form($$$SL2B)=form($$$SSE2M)/form($$$SSJASUB)
 e  s form($$$SZB)=1,form($$$SL2B)=form($$$SNitup)
 #; PVA073: Fix ptform maintenance to compute from ptform entries;
 #;         in some special situations TOP selectivity can be 
 #;         recorded in SSE1M/2M 
 s c=(ptform($$$SNitup)/ptform($$$SSE2M))*ptform($$$SSJASUB) 
 #; i c>1, there is at least one tuple for each JA that passes all
 #;        high level restrictions (other than restrictions on the JA)
 i c>1 s ptform($$$SZB)=c,ptform($$$SL2B)=ptform($$$SSE2M)/ptform($$$SSJASUB)
 e  s ptform($$$SZB)=1,ptform($$$SL2B)=ptform($$$SNitup)
 #;*******Above formulas for $$$SZB and $$$SL2B don't work if
 #;*******there's a range above the JA (setting 'done' should
 #;*******keep this case from happening?)
 #;********$$$SZB and $$$SL2B probably don't matter in this case
c 
 #; Select a set of initial stream algorithms
 #; If jaifnlst]"" then it is a list of ifns that produce the 
 #;    interesting order
 #; Else, just find the fastest algorithm
 #;
 #; INPUT VARIABLES:
 #;   described at top of qojinit:
 #;      qoqn,qojsn,qosn,form(),
 #;      resknown,resmaybe,respar,ressubk(),ressubm(),ressubp(),change()
 #;   described at top of qoj2:
 #;      jasub,rangesub,map,map0,qojrid,qoouter,jaifnlst
 #;      rangeifn,qoridifn,qoio,qoorder
 #;   also created in qoj2:
 #;      jainmap: 1 if JA in map
 #;      allinmap: 1 if all needed ifns are in map (or this is map0)
 #;      mapiread: data contained in map
 #;      map0read: data that must be obtained from map 0
 #;          format of mapiread & map0read:
 #;               # fields ^ max total length ^ ave total length
 #;      outnodes: amount of data needed to produce sort file
 n high,onestrm,str,anysort,anyfiled //PVA073: new str
 #; PVA072: Set up onestrm flag for testing whether a sort build is really
 #;         pre-process or not
 s onestrm=0,str="" f   {s str=$o(mts(qoqn,str)) q:str=""  if onestrm { s onestrm=0 quit  } else {s onestrm=1} }
 s anysort=0,anyfiled=0 // PVA348: We want to ensure some sort temp file alg is created for possible use by cartesian product
 d pushdefaultalg:jaifnlst=""
 g nojalist:jaifnlst=""
 g nojasub:jasub="",range:rangesub
 #;
 #; we have JA as a subscript(s), there is no range subscript
 #; do subscripts below the JA include an equals restriction?
 #;
 #; PVA072: For initial streams, without range processing (see 'range' tag)
 #;         with the IA provided in given map, only Isalg1x options make
 #;         any sense. Cases left over from history and analogy with join
 #;         case removed rather than upgraded for TOP issues. 
 i form($$$SSE3M)-1 d isalg12 g done 
 d isalg11 g done
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
range ; we have JA as a subscript(s) and we have a range subscript
 #; is JA preceeded by a range subscript?
 i jasub>rangesub d isalg23,isalg34b g done
 #; do subscripts below JA include a range restriction?
 #; PVA072: removed following - can't see how they could ever
 #;         win for initial stream: ,isalg24:jainmap,isalg33b
 i jasub<rangesub d isalg13 g done
 #;
 #; range is on the (first) JA subscript
 #; ***When using ISALG1, don't ignore range in cost formulas 
 #;    (it won't be migrated as it will in join algorithms)
 #; For index or sort creation:
 #;        increase $$$SSE1M and $$$SSE1 by $$$SSRM,$$$SSR
 #;        set rangesub="", $$$SSRM=1, $$$SSR=1 (i.e., ignore range)
 #;        reduce $$$SL2B by $$$SSRM, keep $$$SZB the same
 #;     ****Alternatively, we could modify cost formulas to
 #;         reflect these w/o change form().  Check cost
 #;         formulas to insure we aren't double booking
 #;         by increasing $$$SSE1 and decreasing $$$SL2B
 #;     ****modify descriptions of index/sort creation algorithms
 #;         to allow this (S4,S5, S9,S10 )
 #;
 #;i form($$$SSE3M)-1 d isalg12,isalg33a g done
 #;d isalg11,fix,isalg33a
 #;
 #; PVA072: removed following - can't see how they could ever
 #;         win for initial stream: ,isalg33a
 d fix,isalg13 g done
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fix s rangesub=""
 s form($$$SSE1)=form($$$SSE1)*form($$$SSRM),form($$$SSE1M)=form($$$SSE1M)*form($$$SSRM),form($$$SL2B)=form($$$SL2B)*form($$$SSRM)
 s form($$$SNiblk)=form($$$SNiblk)*form($$$SSRM),form($$$SNitup)=form($$$SNitup)*form($$$SSRM)
 s form($$$SSRM)=1,form($$$SSR)=1 
 #; PVA072: Also transform ptform
 s ptform($$$SSE1)=ptform($$$SSE1)*ptform($$$SSRM),ptform($$$SSE1M)=ptform($$$SSE1M)*ptform($$$SSRM),ptform($$$SL2B)=ptform($$$SL2B)*ptform($$$SSRM)
 s ptform($$$SNiblk)=ptform($$$SNiblk)*ptform($$$SSRM),ptform($$$SNitup)=ptform($$$SNitup)*ptform($$$SSRM)
 s ptform($$$SSRM)=1,ptform($$$SSR)=1 
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nojasub ; is there a range subscript?
 #; PVA072: rework the range case substantially to account for the TOP 
 #;         situations
 #; PVA154: Use SSOID as well for tests of index benefit
 if rangesub]""{
   if onestrm {
	 i form($$$SSOI)*form($$$SSOID)*form($$$SSRM)*form($$$SSE1M)<1 ||allinmap d isalg34a
	 i ptform($$$SSOI)*ptform($$$SSOID)*ptform($$$SSRM)*ptform($$$SSE1M)<1 ||allinmap || jainmap { d isalg23 }
   }
   else {
     if ptform($$$SSOI)*ptform($$$SSOID)*ptform($$$SSRM)*ptform($$$SSE1M)<1 ||allinmap { d isalg23,isalg34a g done } ; yes   
     if jainmap d isalg23 
   }
   g done
 }
 #; no - is there an equals subscript?
 i form($$$SSE1M)-1 d isalg22,isalg32 g done // SSE1M same in form() and ptform()
 #; Don't consider this map unless this is map 0 -- actually, presumabley never
 #;     get here because map0 implies allinmap, and first unrestricted
 #;     subscript is now considered a rangesub.
 i map0 d isalg21,isalg31 g done ; if this is map0, perform JALG-2-1, JALG-3-1
 #; PVA32: PVA31 change merged with rangesub case above
done // PVA348: ensure some sort alg filed for possible use by cartesian product
 #; JMM758: Don't create sort temp file alg for TOP queries
 if 'anysort && anyfiled && (jaifnlst="") && ('timefirst(qoqn)) d isalg34a
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nojalist ; no jaifnlst    Therefore find fastest unordered output  
 #; PVA31: With pva021 and also consideration of indexes for any case where there is any 
 #;   selectivity associated with the index (pva31), the last vestiges of MRP625 and MRP699 
 #;   are obsolete, so remove variables okcomp,inorcomp; tags anlcomp,inor; and all use of them.
 #;   This also obsoletes much of PVA029, which was a correction to these.
 #; PVA072: unordrng now takes arg on whether to apply selectivity criterion
 i rangesub]"" g:$$unordrng(1) done
 #; PVA212: check MIfound 
 #; PVA213: but allow if %allindex found only one useful index
 i form($$$SSE1M)-1 s high="isalg4" d jfile("IS8",.form,.change,ressub,map0,"","","","",""):allinmap,jfile("IS9",.form,.change,ressub,1,"","","","",""):('allinmap&&('MIfound||MWonly)) g done
 #; MRP624+ (Use Conditional Map for qualifying conditions)...
 #; PVA072: unordrng now takes arg on whether to apply selectivity criterion
 i $p($g(b),"^",3)'="",resknown[$p(b,"^",3) s high="isalg5" g:$$unordrng(0) done
 #; MRP624-
 #; This case probably no longer reached, because map0 implies allinmap
 #;   and an unrestriced subscript is now a rangesub. 
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
 i map0 s high="isalg6" d jfile("IS12",.form,.change,ressub,1,"","","","","")
 g done
 #; PVA31: New tag unordrng
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA072: new argument testsel, plus function return whether 
 #;        any algorithm filed.
unordrng(testsel)  ; Unordered range type processing
 n qjrdsav,jaifnsav
 #; PVA072: if testsel, do test pushed into unordrng (so form or ptform
 #;         can be used depending on the algorithm
 #; PVA154: Use SSOID as well for tests of index benefit
 if testsel,form($$$SSOI)*form($$$SSOID)*form($$$SSRM)*form($$$SSE1M)'<1,'allinmap QUIT 0
 s high="isalg5" 
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
 i allinmap d jfile("IS10",.form,.change,ressub,map0,"","","","","") QUIT 1  
 #; PVA32: Obsolete comment from PVA029 removed.
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
 #; PVA157: Consider 'thrash risk' strategy if distinct filtering applies to this
 #;         initial map; risk reduced and should be costed against alternatives.
 #;         When multi-stream DISTINCT optimized, similar adjustment probably needed
 #;         for join algorithm selection.
 #; PVA213: allow if %allindex found only one useful index
 i ($$rifn()&&('MIfound||MWonly))||hasdist||hastoprange d jfile("IS11",.form,.change,ressub,1,"","","","","") QUIT 1
 QUIT:(MIfound&&'MWonly) 0 // PVA212
 #;        If not allinmap, and range is not in record id, then use same two step process
 #;        as for S12/13, S7/S8, IC5/IC6 decisions. This avoids major disk thrashing risk.   
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
 #; PVA36: force qojrid to 1 so "IS1" will be costed assuming map0 access is in rowid order
 #; PVA072: if testsel, do test pushed into unordrng (so form or ptform
 #;         can be used depending on the algorithm
 #; PVA154: Use SSOID as well for tests of index benefit
 if testsel,ptform($$$SSOI)*ptform($$$SSOID)*ptform($$$SSRM)*ptform($$$SSE1M)'<1 QUIT 0
 s high="isalg23",qjrdsav=qojrid,qojrid=1,jaifnsav=jaifnlst,jaifnlst=","_+qoridifn_"," d prepform^%qaqojn2("IC4"),jfile("IS1",.tform,.tchange,tressub,1,"IC4",$$ic4^%qaqoidx,"","",""),temprestore^%qaqojn2 s qojrid=qjrdsav,jaifnlst=jaifnsav 
 QUIT 1
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; Initial stream algorithm names correspond to printed papers on 
 #; this topic
isalg11 q:'qoorder  ; ISALG1 is only applicable when the tuples are in order
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
 s high="isalg11" i allinmap d jfile("IS2",.form,.change,ressub,map0,"","","","","") q
 d jfile("IS3",.form,.change,ressub,1,"","","","","") q
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
isalg12 q:'qoorder  ; ISALG1 is only applicable when the tuples are in order
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
 s high="isalg12" i allinmap d jfile("IS4",.form,.change,ressub,map0,"","","","","") q
 d jfile("IS5",.form,.change,ressub,1,"","","","","") q
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
isalg13 q:'qoorder  ; ISALG1 is only applicable when the tuples are in order
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
 s high="isalg13" i allinmap d jfile("IS6",.form,.change,ressub,map0,"","","","","") q
 d jfile("IS7",.form,.change,ressub,1,"","","","","") q
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
isalg21 s high="isalg21" d prepform^%qaqojn2("IC1"),jfile("IS1",.tform,.tchange,tressub,1,"IC1",$$ic1^%qaqoidx,"","",""),temprestore^%qaqojn2 q
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
isalg22 s high="isalg22" i jainmap d prepform^%qaqojn2("IC2"),jfile("IS1",.tform,.tchange,tressub,1,"IC2",$$ic2^%qaqoidx,"","",""),temprestore^%qaqojn2 q
 d prepform^%qaqojn2("IC3"),jfile("IS1",.tform,.tchange,tressub,1,"IC3",$$ic3^%qaqoidx,"","",""),temprestore^%qaqojn2 q
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
isalg23 s high="isalg23" i jainmap d prepform^%qaqojn2("IC4"),jfile("IS1",.tform,.tchange,tressub,1,"IC4",$$ic4^%qaqoidx,"","",""),temprestore^%qaqojn2 q
 #;
 #; if range restriction is part of the record id and if
 #; the 1st part of the record id isn't stored below the
 #; range subscript, skip extra index and use IC5; else use IC6
 #;
 i $$rifn d prepform^%qaqojn2("IC5"),jfile("IS1",.tform,.tchange,tressub,1,"IC5",$$ic5^%qaqoidx,"","",""),temprestore^%qaqojn2 q
 d prepform^%qaqojn2("IC6"),jfile("IS1",.tform,.tchange,tressub,1,"IC6",$$ic6^%qaqoidx,"","",""),temprestore^%qaqojn2 q
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
isalg24 s high="isalg24" d prepform^%qaqojn2("IC7"),jfile("IS1",.tform,.tchange,tressub,1,"IC7",$$ic7^%qaqoidx,"","",""),temprestore^%qaqojn2 q
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
isalg31 d prepform^%qaqojn2("S1") s high="isalg31",x=$$s1^%qaqosrt d jfile("IS13",.tform,.tchange,$s(onestrm:ressub,1:tressub),0,"S1",x,"","",""),temprestore^%qaqojn2 q
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
isalg32 s high="isalg32" i allinmap d prepform^%qaqojn2("S2") s x=$$s2^%qaqosrt,y="S2"
 i 'allinmap d prepform^%qaqojn2("S3") s x=$$s3^%qaqosrt,y="S3"
 d temprestore^%qaqojn2
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
 d jfile("IS13",.tform,.tchange,$s(onestrm:ressub,1:tressub),0,y,x,"","","") QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
isalg33a s high="isalg33a" i allinmap d prepform^%qaqojn2("S4") s x=$$s4^%qaqosrt,y="S4"
 i 'allinmap d prepform^%qaqojn2("S5") s x=$$s5^%qaqosrt,y="S5"
 d temprestore^%qaqojn2
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
 d jfile("IS13",.tform,.tchange,$s(onestrm:ressub,1:tressub),0,y,x,"","","") QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
isalg33b s high="isalg33b" i allinmap d prepform^%qaqojn2("S6") s x=$$s6^%qaqosrt,y="S6" i 1
 #;
 #; if range restriction is part of the record id and if
 #; the 1st part of the record id isn't stored below the
 #; range subscript, skip extra index and use S7; else use S8
 #;
 e  i $$rifn d prepform^%qaqojn2("S7") s x=$$s7^%qaqosrt,y="S7" i 1
 e  d prepform^%qaqojn2("S8") s x=$$s8^%qaqosrt,y="S8"
 d temprestore^%qaqojn2
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
 d jfile("IS13",.tform,.tchange,$s(onestrm&&(y'="S8"):ressub,1:tressub),0,y,x,"","","") QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
isalg33c s high="isalg33c" i allinmap d prepform^%qaqojn2("S9") s x=$$s9^%qaqosrt,y="S9" i 1
 e  d prepform^%qaqojn2("S10") s x=$$s10^%qaqosrt,y="S10"
 d temprestore^%qaqojn2
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
 d jfile("IS13",.tform,.tchange,$s(onestrm:ressub,1:tressub),0,y,x,"","","") QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
isalg34a s high="isalg34a" i allinmap d prepform^%qaqojn2("S11") s x=$$s11^%qaqosrt,y="S11" i 1
 e  i $$rifn d prepform^%qaqojn2("S12") s x=$$s12^%qaqosrt,y="S12" i 1
 e  d prepform^%qaqojn2("S13") s x=$$s13^%qaqosrt,y="S13"
 d temprestore^%qaqojn2
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
 d jfile("IS13",.tform,.tchange,$s(onestrm&&(y'="S13"):ressub,1:tressub),0,y,x,"","","")
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA023: use new routines (prepform, temprestore) to adjust change/formula for in stream equivalences - needed whenever tempalg used
isalg34b s high="isalg34b" i allinmap d prepform^%qaqojn2("S14") s x=$$s14^%qaqosrt,y="S14" i 1
 e  i $$rifn d prepform^%qaqojn2("S12") s x=$$s12^%qaqosrt,y="S12" i 1
 e  d prepform^%qaqojn2("S13") s x=$$s13^%qaqosrt,y="S13"
 d temprestore^%qaqojn2
 #; PVA023: jfile now gets change array argument for initial streams, just like joins.
 d jfile("IS13",.tform,.tchange,$s(onestrm&&(y'="S13"):ressub,1:tressub),0,y,x,"","","") QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; PVA072: Add ressub argument so caller selects which to use
 #; PVA34: Add preflt,precost,clsfilt arguments, and changed all callers.
 #; PVA023: Add chgarr argument. Initial streams (and temp algs) always had cases of
 #;   replicated conditions that shouldn't be tested; they were just never detected before
 #;   (in the optimizer - though set up in ptres by the pre-optimizer).
 #; PVA066: add aggmaps arg, defaulted to ""  
jfile(procalg,cfarr,chgarr,ressub,nocdmap0,tempalg,tcost,preflt,precost,clsfilt,aggmaps="") ;
 #;
 #; jfile:  File an initial stream algorithm
 #; input parameters:
 #;     procalg: low level initial stream algorithm # (after sort
 #;              or index is created, if needed)
 #;     cfarr: cost formula array (.form if no temp file,
 #;             else .tform)
 #; PVA023: add chgarr argument.
 #;     chgarr: change array that is used to backout selectivity
 #;             (.change if no temp file, else .tchange)
 #;     ressub: caller chooses tressub (preprocess) or ressub
 #;     nocdmap0: with this algorithm, map 0 blocks are still
 #;               in the buffer pool for subsequent joins,
 #;               assuming the output of this and intervening
 #;               joins isn't stored in a temp file
 #;     tempalg: index or sort creation alg #, or null
 #;     tcost: cost of temp file creation (or null)
 #;     preflt: Mult-map algorithm for producing a filtered set of IDs
 #;     precost: cost of preflt algorithm
 #;     clsflt: Whether the preflt algorithm result needs to be filtered against the
 #;             class bit map.
 #; input variables:
 #;     all previously defined variables may be used
 #; AK430+
 QUIT:vorused&&(tempalg'="")  ;  can't build temp-file on virtual field
 #; AK430-
 #; PVA023: 'new' of ressub moved to %qaqosn2. 
 n a,algnum,b,c,serializedFormlog,x,y
 #; AK392+
 s algnum=$g($$$Malg(0))+1,$$$Malg(0)=algnum
 s $$$Ptinits(qoqn,qojsn,qosn,algnum)=""
 s:",IS31,IS32,"'[(","_procalg_",") anyfiled=1
 s:(tempalg]"" && ($e(tempalg)="S")) anysort=1 // PVA348
 #; PVA177: move distinct cost charge later, depending on algorithm situation.
 if (" IS1 IS3 IS5 IS7 IS9 IS11"[(" "_procalg_" "))&&(tempalg="")&&(preflt="")&&'dgood s cfarr($$$SGPb)=cfarr($$$SGPb)+movdistcost,cfarr($$$SGPi)=cfarr($$$SGPi)-movdistcost
 #; Prior list of IS algs are those using SGPb
 s c=$$trunc(cfarr(1)) f i=2:1:$$$SUBMAX s c=c_","_$$trunc(cfarr(i))
 s serializedFormlog=$g(formlog(1)) f i=2:1:$$$SUBMAX s serializedFormlog=serializedFormlog_"||"_$g(formlog(i))
 i tcost'="" f i=1:1:4 s $P(tcost,",",i)=$$trunc($P(tcost,",",i))
 #; PVA023: Move setting of ressub 'up higher'. Now needed for setresalready2 call for temp alg
 #;    costing. Also, it is the same for all the algorithms for a given map, for a given join condition.
 #;    Thus, there is no need to computed it so many times. 
 s a="" i $e(tempalg,1)="S" s a=outnodes*7+$p(outnodes,",",3) 
 If $$$CostBabyFile {
 i a s a=($$$DBBlockSize*3\4)*BABYBLK\a i a<20 s a=20 ; a = # tuples per temp sort file
 }
 #;
 #; if produce tempalg's sort file with an algorithm that processes
 #; tuples in order, then don't need to use baby files when store
 #; sort file output since access them in order
 #;
 s:qoorder&&(",S4,S5,S6,S7,S9,S10,"[(","_tempalg_",")) a=""
 #;
 #; Algorithms S8 and S13 produce an index file and then a sort file
 #; If the desired order is the same as the record id, then the index
 #; is in the desired order and hence we don't need baby files for
 #; output
 #; *****If we change the definition of the subscripts for temp index
 #; such that subcase A is when map 0 subscripts = JA rather than when
 #; RID = JA, then this test should be altered to test if the desired
 #; order is the same as the map 0 subscripts.
 #;
 i qojrid,(tempalg="S8")||(tempalg="S13") s a=""
 s x="2^"_jaifnlst_"^"_qojrid_"^^^^"_resknown_"^"_resmaybe_"^"_respar_"^"_ressub_"^0^"_map_"^"_tempalg_"^"_procalg_"^"_high_"^"_tcost
 #; PVA066: file aggmaps information
 s y=a_"^"_outnodes_"^"_qoio_"^"_nocdmap0_"^^"_preflt_"^"_clsfilt_"^^"_precost_"^"_aggmaps
 s $$$Malg(algnum)=x_"^"_c_"^"_y_"^"_serializedFormlog
 #;
 #; PVA023: This now done for initial streams
 #; setup info to remove selectivity impact on cost formulas
 #; of migrated restrictions 
 #;
 s a="" f  s a=$o(chgarr(a)) q:a=""  s $$$Malg(algnum,a)=$p(chgarr(a),"^",2,99)
 QUIT
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #;  $$:  truncate to 5 significant digits (x>0 only!)
 #;                   no-op          make an integer
trunc(x) [] PRIVATE { QUIT:x'["." x  QUIT:$f(x,".")>6 $p(x+.5,".") QUIT:$e(x)'="." +$e(x,1,6) QUIT +$e(x,1,3+$f(x,$e($tr(x,".0")))) }
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
pushdefaultalg()
 #;HSU243: when the global of map0 is under some other global, we should give the indices a chance. 
 if $g(mts(qoqn,qosn))'="",$p(mts(qoqn,qosn),"^",4)'="",$$$smdMapExists($p(mts(qoqn,qosn),"^",4)),$$$smdMapParentMapUnder($p(mts(qoqn,qosn),"^",4)){
 	s high="isalg5"
 	d jfile("IS11",.form,.change,ressub,1,"","","","","")
 }
 quit
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
rifn() ; return 1 if range restriction is part of the record id
 #;     and if the 1st part of the record id isn't stored
 #;     below the range subscript.
 #;
 #; quit if range subscript isn't part of rid
 i rangeifn'=$p(qoridifn,"^"),qoridifn'[(","_rangeifn_",") QUIT 0 
 i qojrid QUIT jasub'>rangesub ; interesting order is record id
 #;
 #; interesting order is not rec id, see if 1st ifn of record id is in
 #;    a subscript below the rangesub in the map
 #;
 QUIT:rangeifn=$p(qoridifn,"^") 1 ; q 1 if rangeifn is record id
 n a s a=$p(qoridifn,",",2) QUIT:a=rangeifn 1 ; a = ifn of 1st part of the record id
 n b,c s b="" f i=1:1 s b=$o(mts(qoqn,qosn,"MAP",map,b)) q:b=""  s c=mts(qoqn,qosn,"MAP",map,b) q:'c||($p(c,"^",2)=a)||($p(c,"^",2)=rangeifn)
 QUIT:b]""&&($p(c,"^",2)=a)&&c 1
 QUIT 0
 #; PVA030: eliminate duplicate nodes function; use version in %qaqojn2
 
.
---
