====
qaqo1
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqo1^MAC^^^0
%qaqo1(qno=0)   // driver for query optimizer
	;; COMPONENTS :: SQL/Optimizer
	#;
#INCLUDE %msql
#INCLUDE %qao
#IF 0  	#;-------------------------------------------------------------
	#; Description:   Driver for Query Optimizer
	#; Author:        Terry Ragon
	#; Date:          April 19, 1988
	#;
	#;  PVA316  (02/04/2015) - Make cost based decision for or->union optimization for multi-table OR condition case 
	#;  PVA279  (02/12/2014) - Enhance ptres handling for longstanding defects 
	#;  PVA258  (05/09/2012) - Optimize multi-key joins 
	#;  PVA242  (07/28/2011) - Support a hint (%noindex) to not use indexes to satisfy the indicated condition. 
	#;  AK739   (06/18/2009) - ASL for TOP/ORDER BY in subqueries
	#;  PVA185  (06/16/2009) - Optimization for TOP without ORDER BY 
	#;  PVA184  (06/14/2009) - Optimizer support for TOP... ORDER BY in subqueries. 
	#;  DPV3337 (01/08/2009) - New par
	#;  PVA154  (09/01/2008) - Improve optimizer cost model : distinguish selectivity for complex conditions on map subscripts from that on map data
	#;  PVA072  (11/10/2004) - Support pseudo conditions implied by TOP... ORDER BY in optimizer
	#;  PVA066  (08/25/2004) - Initial optimizer support for bit slice indexes 
	#;  PVA062  (03/10/2004) - Outer join to with multiple collated conditions may not use a corresponding index. 
	#;  AK557   (01/10/2003) - Remove fixidsub from the optimizer
	#;  PVA36   (06/27/2002) - Query processor uses temp files too often. 
	#;  PVA34   (03/15/2002) - Use more than one index per table for restriction.
	#;  PVA028  (08/28/2001) - Remove ptjorder/ptjouter structures from optimizer
	#;  DPV1265 (02/24/2000) - NEW mapifns and subord
	#;  AK315   (05/12/1998) - CCS: Multifield outer-join
	#;  TR700   (10/07/1998) - Update optimizer cost constants
	#;  TR02;TR09;RGG072;AK093;ALL001;EYT168;AK196
	#;-------------------------------------------------------------
	#;                       I N F O R M A T I O N
	#;-------------------------------------------------------------
	#;
	#;  I.  For each join set:
	#;        for each stream in the join set:
	#;             1. create entries in the ptj array to process joins.
	#;                There are several entries for each join of each 
	#;                stream
	#;  II. For each join set:
	#;        for each stream in the join set:
	#;             1. get a list of interesting orders
	#;             2. create entries in the INITIAL array to process
	#;                the initial stream.  There are several entries for
	#;                each interesting order and for the fastest unordered
	#;                algorithms
	#;  III. For each join set, create the COST array.  For 'numstreams'
	#;         equal 1, then 2, then 3, etc, calculate all possible
	#;         combinations of stream order for that number of streams.
	#;
	#; setup cost formula subscripts
	#; ---------------------------------------------
	#; Document subscripts of cost formula
	#; #   NAME     MEANING
	#;
	#; 1   SSE1     Selectivity of equals rest above JA and above range
	#;               Maybe reduced by migration of restriction.
	#; 2   SSE1M    Max "".  Prior to considering effect of migration
	#; 3   SSE2     Selectivity of equals rest on JA.  Maybe reduced
	#;               by migration.
	#; 4   SSE2M    Max "". Prior to considering effect of migration.
	#;               (affects index/sort creation but not node
	#;               distribution and not join cost)
	#; 5   SSE3     Selectivity of equals rest below JA
	#;               Maybe reduced by migration.
	#; 6   SSE3M    Max "".  Prior to considering effect of migration
	#; 7   SSJA     Selectivity of join attribute
	#; 8   SSJASUB  Selectivity of join attribute in subscript.  Used for
	#;               calculating subscript distributions.  Calculated prior
	#;               to considering effect of migration
	#; 9   SSJAADD  Additional selectivity to be applied to join
	#;               attribute restriction due to situation in which
	#;               join attribute appears in a subscript, and domain
	#;               of the 2nd (B) relation is smaller than the domain
	#;               of the attribute in the 1st (A) relation, hence
	#;               many join combinations will automatically fail on
	#;               the attempt to access the indexd
	#; 10  SSJAADDM Maximum value that would be taken by the SSJAADD
	#;                (i.e. the value that would occur if the JA ifn
	#;                appears exactly as a subscript in the index)
	#; 11  SSR      Selectivity of a range restriction.  Maybe reduced
	#;               by migration.
	#; 12  SSRM     Max "".  Maybe reduced by migration.
	#; 13  SSOI     Selectivity of other subscript
	#;              restrictions satisfied in 'index map' that don't
	#;              require data from any other stream
	#; 14  SSOID    Selectivity of other non-subscript
	#;              restrictions satisfied in 'index map' that don't
	#;              require data from any other stream
	#; 15  SSOIMUL    Selectivity of other subscript
	#;                restrictions that can be satisfied by the index
	#;                map but require other streams to already have
	#;                been processed.  Hence, these restrictions cannot
	#;                be used in index creation or sort file creation or
	#;                initial stream processing
	#; 16  SSOIMULD   Selectivity of other non-subscript
	#;                restrictions that can be satisfied by the index
	#;                map but require other streams to already have
	#;                been processed.  Hence, these restrictions cannot
	#;                be used in index creation or sort file creation or
	#;                initial stream processing
	#; 17  SSO0     Selectivity of other restrictions satisfied in map 0
	#;               that don't require data from any other stream
	#;               Hence it can be used in sort file creation.
	#; 18  SSO0MUL   Selectivity of other restrictions satisfied in map 0
	#;               that require other streams to already have been
	#;               processed.  Hence these restrictions cannot be used
	#;               in index creation or sort file creation or initial
	#;               stream processing.
	#; 19   SSOE   selectivity to be applied to output tuples of outer
	#;             join (can arise due to outer joins with restrictions
	#;             that can be passed by nul tuples)
	#; 20  SNbtup   # tuples in map 0 of 'B' stream
	#; 21  SNbblk   # blocks in map 0 of 'B' stream
	#; 22  SNitup   # tuples in 'index map' of 'B' stream that satisfy all
	#;              implicit restrictions, SSE1, and SSE2
	#; 23  SNiblk   # blocks in 'index map' that satisfy all high level
	#;              and JA equals restrictions (satisfy SSE1M and SSE2M
	#;              restrictions)
	#; 24  SGPi     # nodes per tuple to retrieve from 'index map'
	#; 25  SGPb     # nodes per tuple to retrieve from map 0
	#; 26  SL2B     # nodes at the join attribute subscript level ('jasub')
	#;              for the 'index map' of 'B' stream for which the node
	#;              passes all SSE1M and SSE2M restrictions (i.e. equals
	#;              restrictions at and above the JA)
	#; 27  SZB      average # of nodes below the 'jasub' level for each
	#;              node at the 'jasub' level
	#; 28  SSJAIN     Selectivity of input column for a join (1 if initial stream)
	#; 29  SSJACOND   Selectivity of a "RANGE" or "CON" restriction on the JA
	#;
#ENDIF	// -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
		#; PVA72: add new for ptform
		#; PVA34: New variables: fully,ic8m,ivfnval
		#; PVA028: eliminate ptjouter and ptjorder.
		#; PVA279: adjsel
	new adjsel,allinmap,cartes,cd,CDFACTOR,cgg,CGGFACTOR,cgs,CGSFACTOR,cost3,cost8,costprev,costtemp,extradata,fastsort,form,fully,ic8m,ifnval,jainmap,mapiread,mapread,newstream,nocartes,nojord,nores,noresmay,numtup,order,outnodes,outseq,outsort,par,parchild,PBP,PBP3,PBP8,ptform,ptinits,qoalg,qoio,qoja,qojar,qojcr,qojsn,qonumstr,qoout8,qoouter,qoprev,qoqn,qoridifn,qoslist,qosn,rangeifn,readcost,reqslist,resalready,resknown,resmaybe,resprev,resslit,set,setdata,TEMPCD,TEMPCGG,TEMPCGS,tform,timefirst,z,z2
		#; setup other commonly needed variables
start   // entry point to return to after news
		#; we are assuming that qjob is defined here if not it's a BUG (ric)
		#; TR700
.
		#; physical buffer pool size
	s PBP=$$$AVAILBUFFER
	s PBP3=PBP*$g(^%SYS("sql","optimizer","parameter","PBP3 FACTOR"),0.3)\1
	s PBP8=PBP*$g(^%SYS("sql","optimizer","parameter","PBP8 FACTOR"), 0.4)\1 	// PVA36: Reduce temp file bials: change 8\10 to 4\10
.
		#; cost factors - X .0001 msec.
	s CDFACTOR=$g(^%SYS("sql","optimizer","parameter","CDFACTOR"),200)
	s CGGFACTOR=$g(^%SYS("sql","optimizer","parameter","CGGFACTOR"),2)
	s CGSFACTOR=$g(^%SYS("sql","optimizer","parameter","CGSFACTOR"),3)
		#; TR700-
		#; init overhead costs to allocate and delete a temp file
	s TEMPCD=1,TEMPCGG=1,TEMPCGS=2	// ***assumes allocate by s temp=$zp(^temp...(""))+1,^temp(temp)="" and later eliminate by K ^temp...(temp)
	If $$$CostBabyFile{
		new BABYBLK,BABYINDEX
		s BABYBLK=10	// # blocks per baby sort file
		s BABYINDEX=2000	// # tuples per baby file when create a temp index 
	}
	k $$$PtinitsItself	// init arrays
		#; produce ptj(qoqn,qojsn,qosn)=""
	if qno { s qoqn=qno s qojsn="" f  s qojsn=$o(ptj(qoqn,qojsn)) q:qojsn=""  d x} // PVA316
	else { s qoqn="" f  s qoqn=$o(ptj(qoqn)) q:qoqn=""  s qojsn="" f  s qojsn=$o(ptj(qoqn,qojsn)) q:qojsn=""  d x}
		#; loop through strms of join sets to produce list of join algorithms
		#; for ALL queries
		#; PVA185: set timefirst for each query
	if qno {s nojord=1} else {s nojord=0} // PVA316
a	//---------- Join algorithms
	if qno {s qoqn=qno s timefirst(qoqn)=$$timefirst(qoqn)  d query } // PVA316
	else { s qoqn="" f  s qoqn=$o(ptj(qoqn),-1) q:qoqn=""  continue:'$e(mt("p"),qoqn)  s timefirst(qoqn)=$$timefirst(qoqn)  d query}
		#; produce list of initial streams for ALL queries
b	//---------- Initial Stream algorithms
		#; PVA316: qno arg->quickcost, only one query block
	if qno {s qoqn=qno s qojsn="" f  s qojsn=$o(ptj(qoqn,qojsn)) q:qojsn=""  s qosn="" f  s qosn=$o(ptj(qoqn,qojsn,qosn)) q:qosn=""  d ^%qaqosn }
	else {s qoqn="" f  s qoqn=$o(ptj(qoqn),-1) q:qoqn=""  continue:'$e(mt("p"),qoqn)  s qojsn="" f  s qojsn=$o(ptj(qoqn,qojsn)) q:qojsn=""  s qosn="" f  s qosn=$o(ptj(qoqn,qojsn,qosn)) q:qosn=""  d ^%qaqosn}
		#; calculate cost for each query's join set
c	//---------- Create cost array
	 if qno {s qoqn=qno s qojsn="" f  s qojsn=$o(ptj(qoqn,qojsn)) q:qojsn=""  d ^%qaqoco} // PVA316
	else { s qoqn="" f  s qoqn=$o(ptj(qoqn),-1) q:qoqn=""  continue:'$e(mt("p"),qoqn)  s qojsn="" f  s qojsn=$o(ptj(qoqn,qojsn)) q:qojsn=""  d ^%qaqoco}
		#; PVA242: eliminate %noindex before asl/codegen
		#; PVA316: DON'T do this for quick cost
		#; JMM1159: Save %noindex in mt("l",i,"noindex"), so it can be used in generating shard-local queries
	if 'qno {s i="" f  {s i=$o($$$mtL(i)) q:i=""  s:$e($$$mtLOperator($$$mtL(i)),*-7,*)="%NOINDEX" $$$mtLNoIndex(i)="" s $$$mtLOperator($$$mtL(i))=$p($$$mtLOperator($$$mtL(i)),"%NOINDEX")}}
d	//----------- Propagate subquery cost
	QUIT:qno	// skip for quickcosting
	new subqLog
	s qoqn="" f  s qoqn=$o(ptj(qoqn),-1) q:qoqn=""  continue:'$e(mt("p"),qoqn)  QUIT:$o($$$Mcost(qoqn,1,""),-1)'=1  continue:'$d($$$mtLogSubqueryQbNode(qoqn))  s qojsn="" f  s qojsn=$o(ptj(qoqn,qojsn)) q:qojsn=""  s subqLog="" f  s subqLog=$o($$$mtLogSubquery(qoqn,subqLog)) q:subqLog=""  d propagateSubqCost^%qaqoco(subqLog)
	QUIT
 		#; PVA185: create timefirst
 #;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
timefirst(qoqn)
 	QUIT:$d($$$mtTopLimit(qoqn)) 1 // TOP...ORDER BY analyzed by pre-optimizer
 	QUIT:($d($$$mtTopArg(qoqn))&& '$$$mtPAggList($$$mtP(qoqn))) 1 // TOP, no OBY, no aggregates
 	QUIT 0
 #;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #;pva028: eliminate kill of ptjouter
query 
 	#; process join algorithms for all streams on one query
	#; AK315    removed by AK557
	s qojsn="" f  s qojsn=$o(ptj(qoqn,qojsn)) q:qojsn=""  s qosn="" f  s qosn=$o(ptj(qoqn,qojsn,qosn)) q:qosn=""  d ^%qaqojn2
		#; pva028: Eliminate transform of ptjouter into ptjorder. 
	QUIT
 #;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; given a stream list, create ptj(qoqn,qojsn,qosn)=""
x	s a=$p(ptj(qoqn,qojsn),"^",2) f i=2:1:$l(a,",")-1 s ptj(qoqn,qojsn,$p(a,",",i))=""
	QUIT
 #;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 	#; PVA258: eliminate mapifns,ojmaps,callmap.
---
