====
qaqpnice
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpnice^MAC^^^0
%qaqpnice  ;  pretty descriptions for SQL elements (Aviel 5/24/2k17)
	;; COMPONENTS :: SQL
	#;
#include %msql
#include %sqlEngineObjs
#IF 0   ;-------------------------------------------------------------
	; Description:   provide debug descriptions for QP elements
	; Author:        Aviel Klausner
	; Date Started:  March 1, 2001
	;  IBA     (04/22/2021)  clean up the code: simplify some expressions, merge duplicate functions, and remove obsolete procedures
	;  HSU206  (06/09/2017)[SQL] syntax tree analyzer
	;  AK964   (05/24/2017) - Debug descriptions for compilation elements
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
#ENDIF  ;-------------------------------------------------------------
	$$$Abort  ; Not an Entry Point!!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  dlev - descripton level:
	#;  0 - short, for inclusion in other descriptions
	#;  1 (default) - normal description
	#;  2 - detail, additional information added
	#;  3 - dump, include all components
	#;  4 - variable name
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
help() public
{
	w !,"$$val(val) returns mt(val) info"
	w !,"$$var(var) returns mt(var) info"
	w !,"$$log(log) returns mt(log) info"
	w !,"$$str(str) and $$irn(irn) return ^||%sql.smd(1,irn) info"
	w !,"$$ifn(ifn) returns ^||%sql.smd(1,""ifn"",ifn) info"
	w !,"$$imp(imp) returns ^||%sql.smd(12,imp) info"
	w !,"$$frmit(m) returns mt(f) info"
	w !,"$$sel(m) returns mt(o) info"
	w !,"$$group(m) returns mt(g) info"
	w !,"$$have(m) returns mt(h) info"
	w !,"$$top(m) returns mt(top) info"
	w !,"$$offset(m) returns mt(offset) info"
	w !,"$$con(str) returns mts(1,str,""CON"") info"
	w !,"$$range(str) returns mts(1,str,""RANGE"") info"
	w !,"$$comp(str) returns mts(1,str,""COMP"") info"
}
val(val,dlev=1,norecurse=0) n v,ev,tmp,com,str,collation,m  ;  $$: description for $$$mtV(val) symbol table entry
	RETURN:(val="") "NOVAL"
	s v=$g($$$mtV(val)),ev=$e(v)
	if dlev=4 set v=$zstrip(v,">",",^")
	if v="" {
		RETURN $s(dlev=4:"NVAL",1:"(no entry)")_val
	} elseif ev="f" {
		RETURN:(dlev=4) $$ifn($p($p(v,"^",3),"_",1),4)
		s str=$p(v,"^",2),collation=$p($p(v,"^",3),"_",2,3),com=$$ifn($p($p(v,"^",3),"_",1),1,str,collation)
		RETURN $$paren(val,com,norecurse)
	} elseif ev="t" {
		RETURN:(dlev=4) "c"_$$Quote^%qcr($tr($e(v,3,*),"""()"))_val 
		s com="const:"_$$Quote^%qcr($e(v,3,*))
		RETURN $$paren(val,com,norecurse)
	} elseif ev="x" {
		RETURN:(dlev=4) "P"_$e(v,3,*)
		s com="param:"_$e(v,3,*)
		RETURN $$paren(val,com,norecurse)
	} elseif ev="q" {
		set m=$p(v,"^",2)
		if '$d($$$mtP(m)){
			RETURN:(dlev=4) "NSUBQ"_m_val
			RETURN ""
		}
		RETURN:(dlev=4) "S"_$s($e($$$mtP(m)):"",1:"OBS")_m_val
		RETURN $$paren(val,"qb:"_m,norecurse)
	} elseif ev="i" {
		if $e(v,1,3)="i^^",$d(mt("var",$p(v,"^",4))),dlev=4{
			RETURN $$var($p(v,"^",4),dlev)}
		RETURN:(dlev=4) "I"_v
		RETURN:(v="i^tempID") "ivar:counter"
		RETURN:($e(v,1,10)="i^^i^parag") "ivar:parallel aggregate"
		RETURN $$paren(val,"ivar:"_v,norecurse)
	} elseif ev="a" {
		RETURN:(dlev=4) $p(v,"^",2)_$s($p(v,"^",5):$$var($p(v,"^",5),4),1:$p(v,"^",3,*))
		s com="agg:"_$p(v,"^",2)_"("_$$val($p(v,"^",5),1,1)_")"
		RETURN $$paren(val,com,norecurse)
	} elseif (ev="v")&&($p(v,",",2)'="")&&($p(v,"^",4)'="") {
		if $p($p(v,"^",2),":")="USERDEFINEDFUNCTION"{
			RETURN:(dlev=4) "UF"_$p($p(v,"^",2),":",*)_$$val($p(v,"^",4),4,1)
			s com="UF:"_$p($p(v,"^",2),":",*)
			RETURN $$paren(val,com,norecurse)
		}
		if dlev=4 {
			RETURN:(norecurse) $tr(v,"^%,")
			set tmp=$replace($replace($replace($replace($tr($p(v,"^",2),":"),"*","mult"),"+","plus"),"-","minus"),"/","div")
			set tmp=$replace($replace(tmp,">","greater"),"<","less")
			if $p(v,"^",5)'="" RETURN "v"_tmp_$$val($p(v,"^",4),dlev,1)_"x"_$$val($p(v,"^",5),dlev,1)
			RETURN "v"_tmp_$$val($p(v,"^",4),dlev,1)
		}
		if (ev="v")&&( ",/,*,-,+,/0," [(","_$p(v,"^",2)_",")){
			if $p(v,"^",2)="-",$p(v,"^",5)=""{
				s com="-("_$$val($p(v,"^",4),1,1)_")"
			}else{
				s com=$$val($p(v,"^",4),1,1)_" "_$p(v,"^",2)_" "_$$val($p(v,"^",5),1,1)
			}
			RETURN $$paren(val,com,norecurse)
		}
		else {
			s com=$p(v,"^",2)_"("_$$val($p(v,"^",4),1,1)_")"
			RETURN $$paren(val,com,norecurse)
		}
	}elseif ev="n" {
		s com="ref:"_$$val($p(v,"^",4),1,1)
		RETURN $$paren(val,com,norecurse)
	}
	RETURN:(dlev=4) v
	RETURN v
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
var(var,dlev=1) n v  ;  $$: var("varname") - description for named variable
	#;  entry in mt("var",var)/$$$mtV(var) (name or number)
	i $d($$$mtV(var),v),$e(v,1,3)="i^^",$d(mt("var",$p(v,"^",4)),var) {
		RETURN $$var($p(v,"^",4),dlev)}
	RETURN:$d(mt("var",var),v) $s(dlev=4:"V"_var_v,1:"var")
	RETURN $s(dlev=4:"NVAR"_var,1:"")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dlev1(typ,x,d)
	if d=4 {
		RETURN x
	} elseif d {
		RETURN "["_typ_"="_x_"]"
	}
	RETURN ""
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
paren(val,com,norecurse=0) PUBLIC {
	QUIT:norecurse "v"_val_"("_com_")"
	QUIT com
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
log(log,dlev=1)[mt,asl] PUBLIC { ;  $$: description for $$$mtL(log) condition entry
	set v=$g($$$mtL(log)),ev=$e(v)
	RETURN:v="" $s(dlev=4:"NLOG"_log,1:"")
	set info = $$$mtL(log)
	if $e(info,1) '= "v" quit info
	set operator = $p(info,"^",2)
	if ",=,'=,>,'>,<,'<,%STARTSWITH,%PATTERN,[,"[(","_operator_","){
		s lhs=$$val($p(info,"^",4),1,1)
		s rhs=$$val($p(info,"^",5),1,1)
		RETURN lhs_" "_operator_" "_rhs
	}elseif operator="'NULL"{
		s operand=$$val($p(info,"^",4),1,1)
		RETURN "'NULL("_operand_")"
	}
	set operands = ""
	set i = $l(info,"^") - 1
	while ($p(info,"^",i)'="") && ('( $p(info,"^",i) [ ",")){
		set operands = $$val($p(info,"^",i)) _ "," _operands
		set i = i - 1
	}
	RETURN "operator:"_operator_" , operands:"_operands
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
str(str,dlev=1) n p,v  ;  $$: description for $$$mtR(str) stream entry
	s p=$$dlev1("str",str,dlev),v=$g($$$mtR(str))
	RETURN:v="" $s(dlev=4:"NSTR",1:"(no entry)")_p
	RETURN $$irn(+v,0)_$s(dlev:"[m="_$p(v,"^",2)_"]",1:"")_p
	;  *** handle streamed views, add irn, m for dlev=2
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
irn(irn,dlev=1) n p,v,ev  ;  $$: description for SMD(1,irn) DD table# entry
	s p=$$dlev1("irn",irn,dlev),v=$g(^||%sql.smd(1,irn))
	RETURN:v="" $s(dlev=4:"NIRN",1:"(no entry)")_p
	RETURN $li(v,1)_"."_$li(v,2)_$s(dlev=4:"",1:p)
	;  *** handle virtual table, add class name for dlev=2
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ifn(ifn,dlev=1,str,collation) n p,v,com  ;  $$: description for SMD(1,"ifn",ifn) DD field# entry
	s v=$g(^||%sql.smd(1,"ifn",ifn))
	if dlev=4 {
		RETURN:v="" "NIFN"
		RETURN $p(v,$C(1))
	}
	RETURN:($lg($g($$$mtVirf(ifn)),1)=0) "vfld:%VID[str="_str_"]"
	RETURN:($d($$$mtVirf(ifn))) "vfld:"_$s(collation="":"",1:collation_"(")_$$val($lg($$$mtVirf(ifn),2),1,1)_$s(collation="":"",1:")")_"[str="_str_"]"
	s com="fld:"_$s(collation="":"",1:collation_"(")_$$irn($p(v,$C(1),2),0)_"."_$p(v,$C(1))_"[ifn="_ifn_",str="_str_",irn="_$p(v,$C(1),2)_"]"_$s(collation="":"",1:")")
	RETURN com
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
imp(imp,dlev=1) n p  ;  $$: description for SMD(12,imp) DD map# entry
	s p=$$dlev1("imp",imp,dlev)
	RETURN:'$d(^||%sql.smd(12,+imp)) $s(dlev=4:"NIMP",1:"(no entry)")_p
	RETURN $p($$map(imp)," ",3-dlev-dlev,3)_p
	;  also virtual maps
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
frmit(m=0,frmit=0,dlev=1)  ;  $$: description for $$$mtFromTableName(frmit) FROM entry
	quit "zw mt(""f"") is sufficient"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
sel(m,dlev=1)[mt,asl] PUBLIC  ;  $$: description for $$$mtOutput(m) SELECT-list entries
{	
	s p=$$dlev1("sel",m,dlev),v=$g($$$mtOutput(m))
	RETURN:v="" $s(dlev=4:"NSEL",1:"(no entry)")_p
	set fields = $$$mtOutput(m)
	set fields = $p(fields,"^",2)
	set lines = ""
	for i=1:1:$l(fields,","){
		set field = $p(fields,",",i)
		set:(field'="") lines = lines_$$val(field)_", "
	}
	quit lines
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
group(m,dlev=1)[mt,asl] public  ;  $$: description for $$$mtGroupDistinctList(m) GROUP BY entries
{
	s p=$$dlev1("group",m,dlev),v=$g($$$mtGroupDistinctList(m))
	RETURN:v="" $s(dlev=4:"NGRP",1:"(no entry)")_p
	quit $$val($p($$$mtGroupDistinctList(m),",",1))
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
hav(m,dlev=1)[mt,asl] public  ;  $$: description for $$$mtHaving(m) HAVING entry
{
	s p=$$dlev1("having",m,dlev),v=$g($$$mtHaving(m))
	RETURN:v="" $s(dlev=4:"NHAV",1:"(no entry)")_p
	quit $$log($$$mtHaving(m))
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
top(m,dlev=1)[mt,asl] public  ;  $$: description for $$$mtTopArg(m) TOP entry
{
	s p=$$dlev1("top",m,dlev),v=$g($$$mtTopArg(m))
	RETURN:v="" $s(dlev=4:"NTOP",1:"(no entry)")_p
	quit $$val($$$mtTopArg(m))
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
offset(m,dlev=1)[mt,asl] public  ;  $$: description for mt("offset",m) OFFSET entry
{
	s p=$$dlev1("offset",m,dlev),v=$g($$$mtOffset(m))
	RETURN:v="" $s(dlev=4:"NOFFSET",1:"(no entry)")_p
	quit $$val($$$mtOffset(m))
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
map(imp) [mt,value] public  {  ;  identify map:  master/index map "s.t.m"
#IF 1   ; AK688+
	i $d(mt("filterm",imp),filter) QUIT "given "_$s($e(filter,1,6)="%INBIT":"bitmap ",1:"")_"filter for "_$$irn(+$$$mtR($p(value,$c(1),6)),0)_".%ID"
#ENDIF  ; AK688-
	s smdimp=$s($d(mt("smdimp",imp)):mt("smdimp",imp),1:imp)
	s it=$$$smdMapIndexType(smdimp)
	s node=$s($$$smdMapMaster(smdimp)="Y":"master map ",it="BE":"extent bitmap ",it="B":"bitmap index ",it="S":"bitslice index ",$e(it)="C":"columnar index ",1:"index map ")
	QUIT node_$$irn($$$smdMapIrn(smdimp),0)_"."_$$$smdMapName(smdimp)
}
.
con(str,dlev=1,id="CON")[mt,info,mts] PUBLIC
{
	s p=$$dlev1(id,str,dlev)
	RETURN:'$d(mts(1,str,id)) $s(dlev=4:"NCON",1:"(no entry)")_p
	set lines = ""
	set ifn = ""
	for{
		set ifn = $o(mts(1,str,id,ifn),1,info)
		quit:(ifn="")
		set line = "selectivity is "_$p(info,"^",1)_" "_ $$log($p($p(info,"^",2),",",2))
		set lines = lines _line _" "
	}
	quit lines
}
.
range(str,dlev=1)[mt,info,mts] PUBLIC
{
	quit $$con(str,dlev,"RANGE")
}
.
comp(str,dlev=1)[mt,info,mts] PUBLIC
{
	s p=$$dlev1("comp",str,dlev)
	RETURN:'$d(mts(1,str,"COMP")) "(no entry)"_p
.
	set lines = ""
	set log = ""
	for{
		set log = $o(mts(1,str,"COMP",log),1,info)
		quit:(log="")
		set line = "selectivity is "_$p(info,"^",1)_" "_ $$log(log)
		set lines = lines _line _" "
	}
	quit lines
}
.
findActualValue(val,default) [mt,asl] public
{
	set i = ""
	for{
		set i = $o($$$mtV(i),1,info)
		quit:i=""
		quit:info=val
	}
	if i = "" quit default
	quit i
}
.
annotateMTS2() [mts,mt] public
{	
	set subscripts = %subscripts
	set value = %value	
	set subscripts = $e(subscripts,3,$l(subscripts)-1)
	set info = ""
	q:(value="")
	#; mts(qb,str)
	if $l(subscripts,",")=2,+$p(subscripts,",",1)'=0{
		s qb=$p(subscripts,",",1),str=$p(subscripts,",",2)
		s title=$$alias(qb,str)
		s info=info_title_","
		s info = info_"s1="_$p(subscripts,",",1)_":qb,s2="_$p(subscripts,",",2)_":str,"
		s value1=$p(value,"^",1),value2=$p(value,"^",2),value3=$p(value,"^",3),value4=$p(value,"^",4),value5=$p(value,"^",5),value6=$p(value,"^",6)
		s:(value1'="") info = info_"p1="_value1_":#tuples,"
		s:(value2'="") info = info_"p2="_value2_":#blocks,"
		s:(value3'="") info = info_"p3="_value3_":list of str#,"
		s:(value4'="") info = info_"p4="_value4_":imp of master map,"
		s:(value5'="") ifnname=$p($g($$$smd(1,"ifn",value5)),$c(1),1), info = info_"p5="_value5_":ifn"_$case(ifnname,"":",",:" of "_ifnname_",") 
		s:(value6'="") info = info_"p6="_value6_":list of ifns of p5,"
	}
	#; mts(qb,str,"MAP",imp)
	elseif ($l(subscripts,",")=4) && ($p(subscripts,",",3)="""MAP""") && (value'=""){
		s qb=$p(subscripts,",",1),str=$p(subscripts,",",2),imp=$p(subscripts,",",4)
		i ($g($$$smd(12,imp))="") s info="cloned map of ",imp=$g(mt("smdimp",imp))
		s title=$$alias(qb,str)
		i title=""{
			s irn=$$$smdMapIrn(imp)
			s schemaMapName=$$$smdSchema(1,irn)_"."_$$$smdName(1,irn)_"."_$lg($$$smd(12,imp),1)
		}
		else{
			s:($d($$$smd(12,imp))) schemaMapName=title_"."_$lg($$$smd(12,imp),1)			
		}
		s:($d(schemaMapName)) info=info_schemaMapName_","
		s info = info_"s1="_$p(subscripts,",",1)_":qb,s2="_$p(subscripts,",",2)_":str,s4="_$p(subscripts,",",2)_":imp,"
		s value1=$p(value,"^",1),value2=$p(value,"^",2),value3=$p(value,"^",3),value4=$p(value,"^",4),value5=$p(value,"^",5),value6=$p(value,"^",6),value9=$p(value,"^",9),value10=$p(value,"^",10)
		s:(value1'="") info = info_"p1="_value1_":#blocks,"
		s:(value2'="") info = info_"p2="_value2_":#tuples,"
		s:(value3'="") nlogs=$l(value3,","),info = info_"p3="_value3_$case(nlogs,3:":log,",:":logs,")
		s:(value5'="") info = info_"p5="_$case(value5,0:"0:inherited",1:"1:from this table",:"")
		s:(value6'="") info = info_",p6="_value6_$select(value6="I":":Standard Index,",value6="B":":Bitmap,",value6="BE":":Bitmap Extent,",value6="S":":Bitslice,",$extract(value6,1,2)="FI":"Function Index,",value6="CI":":Columnar Index,",1:",")
		s:(value9'="") info = info_"p9="_value9_":ifn"_$s(value9["_":"_coll",1:"")_" if columnar,"
		s:(value10'="") info = info_"p10="_value10_":ifn"_$s(value10["_":"_coll",1:"")_" if BMCON,"
	}
	#; mts(qb,str,"MAP",imp,sub)
	elseif ($l(subscripts,",")=5) && ($p(subscripts,",",3)="""MAP""") && (value'=""){
		s qb=$p(subscripts,",",1),str=$p(subscripts,",",2)
		s imp=$p(subscripts,",",4),s5=$p(subscripts,",",5)
		i ($g($$$smd(12,imp))="") s info="cloned map of ",imp=$g(mt("smdimp",imp))
		s title=$$alias(qb,str)
		i title=""{
			s irn=$$$smdMapIrn(imp)
			s schemaMapName=$$$smdSchema(1,irn)_"."_$$$smdName(1,irn)_"."_$lg($$$smd(12,imp),1)
		}
		else{
			s schemaMapName=title_"."_$lg($$$smd(12,imp),1)			
		} 
		s nsub=$o(mts(qb,str,"MAP",imp,""),-1)
		s value6=$p(value,"^",6)
		s namefromifn=$p($g($$$smd(1,"ifn",$p(value,"^",2))),$c(1))
		s subname=$case($e(value6),"%":value6_"("_namefromifn_")",:namefromifn) // add collation if there is any
		s:(subname="") subname=$lg($g($$$smd(12,imp,6,s5)),2,"")
		s:(subname="") subname="Bitmap"
		s subnamecoma=""
		s $p(subnamecoma,",",nsub)=""
		s $p(subnamecoma,",",s5)=subname
		s info=info_schemaMapName_"["_subnamecoma_"],"
		s info = info_"s1="_$p(subscripts,",",1)_":qb,s2="_$p(subscripts,",",2)_":str,s4="_$p(subscripts,",",4)_":imp,"
		s info = info_"s5="_s5_":sub#,"
		s value1=$p(value,"^",1), value2=$p(value,"^",2), value3=$p(value,"^",3), value4=$p(value,"^",4), value5=$p(value,"^",5),value6=$p(value,"^",6)
		s info = info_"p1="_value1_$case(value1,1:":constant,",2:":sargeable,",3:":1-1 to sargeable,",4:":unordered 1-1 to sargeable,",5:":many-1 sargeable,",6:":in ORDER BY,",0:":uninteresting,",:",")
		s:(value2'="") ifnname=$p($g($$$smd(1,"ifn",value2)),$c(1),1),info = info_"p2="_value2_":ifn,"
		s:(value3'="") info = info_"p3="_$e(value3,1,5)_":selectivity,"
		s:(value4'="") info = info_"p4="_value4_":id,"
		s:(value5'="") info = info_"p5="_value5_$s(value5=2:":in order",value5=0:":unordered,",1:",")
		s:(value6'="") info = info_"p6="_value6_":collation"
	}
	#; mts(qb,str,"ATT",sub)
	elseif ($l(subscripts,",")=4) && ($p(subscripts,",",3)="""ATT"""){
		s qb=$p(subscripts,",",1),str=$p(subscripts,",",2)
		s s1=$p(subscripts,",",1),s4=$p(subscripts,",",4)
		s title=$$alias(qb,str)
		s collation=""
		i ($f(s4,"_")>0) {
			s collation=$e($p(s4,"_",2),1,*-1)
			s ifn=+$e(s4,2,*) 
			s sub4=s4_":ifn_collation,"
		} else {s ifn=s4, sub4=ifn_":ifn,"}
		s ifnname=$p($g($$$smd(1,"ifn",ifn)),$c(1),1)
		s irn=$p($$$smd(1,"ifn",ifn),$c(1),2)
		s schemaMapName=$$$smdSchema(1,irn)_"."_$$$smdName(1,irn)
		s title=title_"."_ifnname
		s:(collation'="") title=collation_"("_title_")"
		s info = info_title_",s1="_$p(subscripts,",",1)_":qb,s2="_$p(subscripts,",",2)_":str,s4="_sub4
		s value1=$p(value,"^",1), value2=$p(value,"^",2), value3=$p(value,"^",3), value4=$p(value,"^",4), value5=$p(value,"^",5),value6=$p(value,"^",6),value7=$p(value,"^",7),value8=$p(value,"^",8),value9=$p(value,"^",9),value10=$p(value,"^",10)
		s info = info_$s(value1=0:"p1=0:needed for output or agg,",value1=2:"p1=2:needed for join,",value1=1:"p1=1:not needed for output/join,",1:"")
		s:(value2'="") info = info_"p2="_value2_":join to str,"
		s:(value3'="") nlogs=$l(value3,","),info = info_"p3="_value3_$case(nlogs,3:":join log,",:":join logs,")
		s:(value4'="") info = info_"p4="_value4_":max length,"
		s:(value5'="") info = info_"p5="_value5_":"_"val,"
		s:(value6'="") info = info_"p6="_$e(value6,1,5)_":selectivity,"
		s:(value7'="") info = info_"p7="_value7_":list of maps,"
		s:(value8'="") info = info_"p8="_value8_":avg field length,"
		s:(value9'="") info = info_"p9="_value9_":columnar imp,"
		s:(value10'="") info = info_"p10="_value10_":BMCON imp,"
	}
	elseif ($l(subscripts,",")=4) && ($p(subscripts,",",1)="""AGG""") {
		s info=info_value_"("_$$val($p(subscripts,",",3),1,1)_")  "
		s info = info_"s2="_$p(subscripts,",",2)_":qb,s3="_$p(subscripts,",",3)_":ifn val,s4="_$p(subscripts,",",4)_":agg val"
		
	}
	elseif ($l(subscripts,",")=4) && ($p(subscripts,",",3)="""CON""") {
		s info = info_"s1="_$p(subscripts,",",1)_":qb,s2="_$p(subscripts,",",2)_":str,s4="_$p(subscripts,",",4)_":ifn,"
		s value1=$p(value,"^",1), value2=$p(value,"^",2), value3=$p(value,"^",3), value4=$p(value,"^",4),value7=$p(value,"^",7)
		s:(value1'="") info=info_"p1="_value1_":selectivity,"
		s:(value2'="") info=info_"p2="_value2_":log,"
		s:(value3'="") info=info_"p3="_value3_$case(value3,1:":IS NULL condition,",0:":not IS NULL condition,",:",")
		s:(value4'="") info=info_"p4="_value4_":number of IN terms,"
		s:(value7'="") info=info_"p7="_value7_":extra cost,"
	}
	elseif ($l(subscripts,",")=4) && ($p(subscripts,",",3)="""RANGE""") {
		s info = info_"s1="_$p(subscripts,",",1)_":qb,s2="_$p(subscripts,",",2)_":str,s4="_$p(subscripts,",",4)_":ifn,"
		s value1=$p(value,"^",1), value2=$p(value,"^",2), value3=$p(value,"^",3),value7=$p(value,"^",7)
		s:(value1'="") info=info_"p1="_$e(value1,1,5)_":combined selectivity,"
		s:(value2'="") info=info_"p2="_value2_":list of logs,"
		//s:(value3'="") value3=$p(value3,$c(1),1)_$c(95,36,99,40,49,41,95)_$p(value3,$c(1),2),info=info_"p3="_value3_":range specification for asl(""next""),"
		s p3p1=$p(value3,$c(1),1),p3p2=$p(value3,$c(1),2),p3p3=$p(value3,$c(1),3),p3p4=$p(value3,$c(1),4)
		s:(p3p1'="") info=info_"p3p1="_p3p1_":lowerlimit(val),"
		s:(p3p2'="") info=info_"p3p2="_p3p2_$case(p3p2,0:":exclusive",1:":inclusive",2:":%STARTSWITH",3:":TOP inclusive",4:":TOP exclusive",1:"")_","
		s:(p3p3'="") info=info_"p3p3="_p3p3_":upperlimit(val),"
		s:(p3p4'="") info=info_"p3p4="_p3p4_$case(p3p4,0:":exclusive",1:":inclusive",3:":TOP inclusive",4:":TOP exclusive",1:"")_","
		s:(value7'="") info=info_"p7="_value7_":collection cost,"
	}
	elseif ($l(subscripts,",")=4) && ($p(subscripts,",",3)="""COMP""") {
		s info = info_"s1="_$p(subscripts,",",1)_":qb,s2="_$p(subscripts,",",2)_":str,s4="_$p(subscripts,",",4)_":log,"
		s value1=$p(value,"^",1), value2=$p(value,"^",2), value3=$p(value,"^",3)
		s:(value1'="") info=info_"p1="_value1_":min(selectivity of flds in log),"
		s:(value2'="") info=info_"p2="_value2_":list of ifns,"
		s:(value3'="") info=info_"p3="_value3_$case(value3,1:":possibly satisfied by NULL,",0:":not satisfied by NULL,",:",")
	}
	elseif ($l(subscripts,",")=5) && ($p(subscripts,",",3)="""JOIN""") {
		s info = info_"s1="_$p(subscripts,",",1)_":qb,s2="_$p(subscripts,",",2)_":str,s4="_$p(subscripts,",",4)_":ifn,s5="_$p(subscripts,",",5)_":log,"
		s value1=$p(value,"^",1), value2=$p(value,"^",2), value3=$p(value,"^",3), value4=$p(value,"^",4), value5=$p(value,"^",5), value6=$p(value,"^",6)
		s:(value1'="") info=info_"p1="_value1_$case(value1,1:":recrod-ID,",0:":not record-ID,")	
		s:(value2'="") info=info_"p2="_value2_":selectivity,"
		s:(value3'="") info=info_"p3="_value3_":list of other ifns,"
		s:(value4'="") info=info_"p4="_value4_$case(value4,1:":outer join,",0:":not outer-join,")
		s:(value5'="") info=info_"p5="_value5_":val of joining expression,"
		s:(value6'="") info=info_"p6="_value6_":min(selectivity of flds in join expression),"
	}
	elseif ($l(subscripts,",")=4) && ($p(subscripts,",",3)="""MREL""") {
		s info = info_"s1="_$p(subscripts,",",1)_":qb,s2="_$p(subscripts,",",2)_":str,s4="_$p(subscripts,",",4)_":log,"
		s value1=$p(value,"^",1), value2=$p(value,"^",2), value3=$p(value,"^",3), value4=$p(value,"^",4)
		s:(value1'="") info=info_"p1="_value1_":min(selectivity of flds in log),"
		s:(value2'="") info=info_"p2="_value2_":list of ifns,"
		s:(value3'="") info=info_"p3="_value3_":list of other steams,"
		s info=info_"p4="_value4_$case(value4,1:":possibly satisfied by NULL,",0:":not satisfied by NULL,",:",")
	}
	#; eliminate trailing comas
	i $e(info,*-1,*)=", " s info=$e(info,1,*-2)
	i $e(info,*)="," s info=$e(info,1,*-1)
	s info=" ; "_info
	set:(info'="") %qaqnicecomment = info
}
.
alias(qb,str)[mt] public {
	s nextqbalias="",title=""
	f{
		s nextqbalias =$next(mt("ptrel",nextqbalias))
		q:(nextqbalias=-1)
		s qba=$p(nextqbalias,"^",1)
		s stra=mt("ptrel",nextqbalias)
		i ((qba_","_stra)=(qb_","_str)){
			if ($p(nextqbalias,"^",2)'=$$$mtFromTableName(nextqbalias)){ //there is an alias/label
				s title=$p(nextqbalias,"^",2)_"("_$$$mtFromTableName(nextqbalias)_")"
			}
			else {s title=$$$mtFromTableName(nextqbalias)}
		}					
	}
	quit title	
}
				
///This function is registed for ZWRITE, check build.rtn
///%subscripts: the subscript of mt array
///%value: the value for mt(%subscripts)
///%value may be modified
annotateMT2() [mt,asl] public
{	
	set subscripts = %subscripts
	set value = %value
	
	;set idx = $o($$$mtV(idx),1,info)
	set subscripts = $e(subscripts,3,$l(subscripts)-1)
	set info = ""
	if ($l(subscripts,",")=2) && ($p(subscripts,",",1)="""v""") && (value'=""){
		s info = $$val($p(subscripts,",",2),1)
	}
	elseif ($l(subscripts,",")=2) && ($p(subscripts,",",1)="""r""") && (value'="")
	{
		set irn=$p(value,"^",1),qb=$p(value,"^",2)
        if qb=0,irn=0{
	  		set info = info_"(killed stream)"
	  	}else{
		  	set info = $$irn(irn)
        	set info = info _ "[queryblock="_qb_"]"
	  	}
		
.
	}
	elseif ($l(subscripts,",")=3) && ($p(subscripts,",",1)="""r""") && (value'="")
	{
		if $p(subscripts,",",3)= """q"""{
			set str = $p(subscripts,",",2)
			set qb = value
			set info = "stream "_str_" is generated by query block "_qb
		}
	}
	elseif ($l(subscripts,",")=1) && ($p(subscripts,",",1)="""p""") && (value'="")
	{
		set info = "the number of query blocks:"_$l(value)
		set active = 0
		f i=1:1:$l(value) i $e(value,i,i)="1" s active = $i(active)
		set info = info _ ","_" the active ones are "_active
	}
	elseif ($l(subscripts,",")=2) && ($p(subscripts,",",1)="""p""") && (value'="")
	{
		set info = $s(+value=0:"p1=0:top qb",1:"p1="_+value_":the child of qb "_+value)
		set p2 = $p(value,"^",2),p3=$p(value,"^",3),p4=$p(value,"^",4),p5=$p(value,"^",5),p6=$p(value,"^",6),p7=$p(value,"^",7),p8=$p(value,"^",8)
		set info = info _", p2="_p2_":val"
		set:(p3'="") info = info _", p3="_p3_":list(val,) of aggs"
		set:(p4'="") info = info _", p4="_p4_":list(,val,) of flds"
		set:(p5'="") info = info _", p5="_p5_":top asl mod#"
		set:(p6'="") info = info _", p6="_p6_":bottom asl mod#"
		set:(p7'="") info = info _", p7="_p7_":view nesting mod#"
		set:(p8'="") info = info _", p8="_p8_":%VID val (if view)"
	}
	elseif ($l(subscripts,",")=2) && ($p(subscripts,",",1)="""g""") && (value'="")
	{
		set temp = ""
		for i=1:1:$l(value,","){
			set v = $p(value,",",i)
			if v'="" set temp = temp _ ";"_$$val(v)
		}
		set:(temp'="") info = "group-list or select distinct list "_temp
	}
	elseif ($l(subscripts,",")=2) && ($p(subscripts,",",1)="""w""") && (value'="")
	{
		set temp = ""
		for i=1:1:$l(value,"^"){
			set log = $p(value,"^",i)
			if log'="" set temp = temp _"  "_$$log(log)
		}
		set:(temp'="") info = "WHERE conds: "_temp
	}
	elseif ($l(subscripts,",")=2) && ($p(subscripts,",",1)="""h""") && (value'="")
	{
		set log = value
		set info = $$log(log)
	}
	elseif (($l(subscripts,",")=2) && ($p(subscripts,",",1)="""c""") && (value'=""))
	{
		set temp = ""
		for i=1:1:$l(value,","){
			set log = $p(value,",",i)
			if log'="" set temp = temp _ ";"_$$log(log)
		}
		set:(temp'="") info = "top-level-AND streamless conditions "_temp
	}
	elseif (($l(subscripts,",")=2) && ($p(subscripts,",",1)="""j""") && (value'=""))
	{
		set temp = ""
		for i=1:1:$l(value,","){
			set log = $p(value,",",i)
			if log'="" set temp = temp _ ";"_$$log(log)
		}
		set:(temp'="") info = "left-outer-join equality conditions "_temp
	}
	elseif ($l(subscripts,",")=2) && ($p(subscripts,",",1)="""l""") && (value'=""){
		//should avoid scratch value in mt("l")
		if $e(value,1,1) = "i" { 
			set %qaqnicecomment = "" 
			quit
		}
		set info = $$log($p(subscripts,",",2),1)
	}	
	elseif ($l(subscripts,",")=2) && ($p(subscripts,",",1)="""dsn""") && (value'="")
	{
		if value = " " set info = "run in parallel "
		set qb = $p(subscripts,",",2)
		set con = mt("ext",qb)
		if con '= "" set info = info_"using connection "_con
	} elseif ($l(subscripts,",")=2) && ($p(subscripts,",",1)="""tf""") && (value'="") {
		set info=$s($p(value,"^",16):"bitmap ",$p(value,"^",12):$s($p(value,"^")="dist":"hybrid ",1:"local "),1:"global ")_$case($p(value,"^"),"dist":"distinct table","temp":"temp table","corr":"correlated table",:"<unknown>")_$s($p(value,"^",2)'="":" mod="_$p(value,"^",2),1:"")
		if $p(value,"^",3)'="" set info=info_" npk="_$p(value,"^",3)
		if $p(value,"^",10)'="" {
			set icols=$p(value,"^",10)
			set info=info_" on fields "
			for i=1:1:$l(icols,",")-1 {
				set info=info_" "_$$annotateField(i,$p(icols,",",i))_","
			}
			set info=$e(info,1,*-1)
		}
		if $p(value,"^",13)'="" set info=info_" estimated tuples="_$p($p(value,"^",13),",",1)_" avg row length="_$p($p(value,"^",13),",",2)
		set tmp=""
		if $p(value,"^",11)'="",$p($p(value,"^",11),"^",2)="" set tmp=tmp_"short,"
		if $p(value,"^",6) set tmp=tmp_"sortend,"
		if tmp'="" set info=info_" ["_$e(tmp,1,*-1)_"]"
	} elseif (($l(subscripts,",")=2) && ($p(subscripts,",",1)="""top""") && (value'="")){
		set qb=$p(subscripts,",",2),info = "s2="_qb_":qb,p1="_value_":va" // "top mt("_$c(34)_v_$c(34)_","_value_") condition on queryblock="_qb
	} elseif (($l(subscripts,",")=2) && ($p(subscripts,",",1)="""ptrel""") && (value'="")){
		set s2=$p(subscripts,",",2),info = "s2="_s2_":qb^streamname,p1="_value_":str" 
	}
	elseif (($l(subscripts,",")=2) && ($p(subscripts,",",1)="""f""") && (value'="")){
		set s2=$p(subscripts,",",2),info = "s2="_s2_":qb^label,p1="_value_":table name" //
	}
	elseif (($l(subscripts,",")=3) && ($p(subscripts,",",1)="""APE""") && (value'="")) {
		If $p(subscripts,",",3)="""parent""" {
			Set info = "modules "_$lg(value,1)_" to "_$lg(value,2)_" are parent ASL modules for %SQLparallel"_$p(subscripts,",",2)
		} ElseIf $p(subscripts,",",3)="""worker""" {
			Set info = "modules "_$lg(value,1)_" to "_$lg(value,2)_" are worker ASL modules for %SQLparallel"_$p(subscripts,",",2)
		} ElseIf $p(subscripts,",",3)="""ipqoutputs""" {
			Set info = "values to be sent via ipq: "
			for i=1:1:$l($p(value,$c(1),2),",") Set info = info_$s(i=1:"",1:",")_"<"_$$val($p($p(value,$c(1),2),",",i))_">"
		} Elseif $p(subscripts,",",3)="""prm""" {
			Set info = "values passed to the workers from the parent process: "
			For i=1:1:$ll(value) Set info = info_$s(i=1:"",1:",")_"<"_$$val(+$lg(value, i))_">"
		} Elseif $p(subscripts,",",3)="""TopLimitWorkerTF"""  {
			Set info = "temp file number for TOP/%LIMIT in the worker ASL modules"
		} Elseif $p(subscripts,",",3)="""partval"""  {
			Set info = "partitioning on "_$$val(value)
		}
	}
	elseif (($l(subscripts,",")=2) && ($p(subscripts,",",1)="""vtree""") && (value'="")) {
		Set info = "values (positive numbers) and conditions (negative numbers) evaluated using vector operations"
	}
	elseif (($l(subscripts,",")=2) && ($p(subscripts,",",1)="""vtop""") && (value'="")) {
		Set info = "top-level values (positive numbers) and conditions (negative numbers) evaluated using vector operations"
	}
	elseif (($l(subscripts,",")=2) && ($p(subscripts,",",1)="""xtree""") && (value'="")) {
		Set info = "values (positive numbers) and conditions (negative numbers) evaluated, in the order of execution"
	}
	elseif (($l(subscripts,",")=2) && ($p(subscripts,",",1)="""xtop""") && (value'="")) {
		Set info = "top-level values (positive numbers) and conditions (negative numbers) evaluated, in the order of execution"
	} elseif (($l(subscripts,",")=2) && ($p(subscripts,",",1)="""ntuplen""") && (value'="")) {
		Set info = "estimated number of output tuples and average output tuple length for each call of subquery "_$p(subscripts,",",2)
	} elseif (($l(subscripts,",")=3) && ($p(subscripts,",",1)="""sharedtf""") && (value'="")) {
		If $p(subscripts,",",2)="""tfnum""" { 
			Set info = $s(value:"tempfile "_$p(subscripts,",",3)_" is a shared global temp-file",1: "tempfile "_$p(subscripts,",",2)_" is not a shared global temp-file")
		} Elseif $p(subscripts,",",2)="""tfmod"""{
			Set info = "ASL module "_$p(subscripts,",",3)_" generates shared global temp-file "_value
		} Elseif $p(subscripts,",",2)="""uselocalcache"""{
			Set info = "if a local array will be used to cache temp-file "_$p(subscripts,",",3)
		}
	}
.
	set:(info'="") %qaqnicecomment = "  ; "_info
}
.
.
annotateField(idx,v){
	quit:v="" ""
	set ret = ""
	try{
		set ret = $$val(+v,0)
	}
	catch(ex){
		set ret = "?"
	}
	quit:ret="" ""
	quit "[p"_idx_"="_v_"]="_ret
}
.
annotateDistinct(v) {
	set ret="distinct on"
	s icols=$p(v,$c(1),1)
	for i=1:1:$l(icols,",")-1 {
		set ret=ret_" "_$$annotateField(i,$p(icols,",",i))_","
	}
	s distf=$p(v,$c(1),2)
	RETURN $e(ret,1,*-1)_" in table "_distf
}
.
annotateTemp(v) {
	set ret=""
	if $p(v,$c(1),1)'="" {
		//set ret=ret_"call temp[p1="_$p(v,$c(1),1)_"]"
		set ret=ret_"p1="_$p(v,$c(1),1)_":call module, "
	}
	if $p(v,$c(1),2)="1" {
		set ret=ret_"p2=1:once"
	}
	if $p(v,$c(1),3)'="" {
		set ret=ret_" insert M[p3="_$p(v,$c(1),3)_"]"
	}
	/* if $p(v,$c(1),4)'="" {
		set ret=ret_" set vals "
		set icols=$p(v,$c(1),4)
		for i=1:1:$l(icols,",")-1 {
			set ret=ret_" "_$$annotateField(i,$p(icols,",",i))_","
		}
		set ret=$e(ret,1,*-1)
	}*/
	if $p(v,$c(1),4)'="" {
		set ret=ret_"p4="_$p(v,$c(1),4)_":evaluate "
		set icols=$p(v,$c(1),4)
		for i=1:1:$l(icols,","){
			set val=$p(icols,",",i)
			set:(val) ret=ret_$$val(val,1,1)_", "}
	}
	RETURN $zstrip(ret,"<W")
}
.
///asl(mod,ACTION,ntry,nn)
annotateBuildTF(value){
	set line = ""
	if $p(value,$c(1),1)="s" {
		if $p(value,$c(1),2)="" {
			set line = "[p1=s]=literal subscript[p3="_$p(value,$c(1),3)_"]"
		} else {
			set line = "[p1=s]=looping on subscripts,"
			set line = line_",[p2="_$p(value,$c(1),2)_"]="_$$val($p(value,$c(1),2),0)
		}
	} elseif $p(value,$c(1),1)="" {
		set line = "node data "_$$val(+$p(value,$c(1),2),0)
	}
	;set:($p(value,$c(1),8)'="") line = ",[p8="_$p(value,$c(1),8)_"]"
	;set:($p(value,$c(1),9)'="") line = ",p[9="_"set $BIT for this bitmap subscript"_"]"
	quit line
}
.
/// asl(mod,ACTION,ntry), $PIECE($c(1)):
/// asl.txt does not have the complete info for this entry
annotateACTION(value) {
	
	set line = ""
	set:($p(value,$c(1),1)="a") line = "aggregate" 
	set:($p(value,$c(1),1)="n") line = "nesting; "_"p2="_$p(value,$c(1),2)_":nested module"
	set:($p(value,$c(1),1)="o") line = "output row"
	set:($p(value,$c(1),1)="b") line = "build temp file; p6="_$p(value,$c(1),6)_":tempid"
	If ($p(value,$c(1),1)="ipq") {
		Set line = "p1=""ipq"":output vals in p2 to ipq, p2="_$p(value,$c(1),2)_":"
		for i=1:1:$l($p(value,$c(1),2),","){
			Set line = line_$s(i=1:"",1:",")_"<"_$$val($p($p(value,$c(1),2),",",i))_">"
		}
	}
	
	quit line
}
.
///asl(mod,KEY,nn,"id") =  $P($c(1)):  ;  BSL entry nn:
annotateID(idx,v) {
	set meanings = $lb("map type ",
					   "mapid ",
					   "tempid ",
					   "list of logical conditions to pretest ",
					   "padding ",
					   "str# ",
					   "q# ",
					   "chunks/ids ",
					   "sn ",
					   "nestmod ",
					   "bitslice negative chunk ",
					   "q# queued ",
					   "tfn# queued ")
	
	quit:v="" ""
	set oldv = v
	;set:idx=2 v = $$map(+v)
	set:idx=2 $li(meanings,idx) = $$map(+v)
	;set:idx=3 v = "generated by ( ntry "_$p(v,"^",2)_" of mod "_$p(v,"^",1)
	quit "[p"_idx_"="_oldv_"]="_$lg(meanings,idx)
}
annotateID2(v) [PUBLIC]{
	Set A=""
	// For i=1:1:13 Set var="p"_i,@var=$Piece(v,$c(1),i) ; indirection did not work
	Set p1=$Piece(v,$c(1),1),p2=$Piece(v,$c(1),2),p3=$Piece(v,$c(1),3),p4=$Piece(v,$c(1),4),p5=$Piece(v,$c(1),5),p6=$Piece(v,$c(1),6),p7=$Piece(v,$c(1),7),p8=$Piece(v,$c(1),8)
	Set:(p1'="") A=A_"p1="_p1_$Select(p1="temp":":temp-file, ",1:", ")
	Set:(p2'="") A=A_"p2="_p2_":imp of "_$$map(p2)_", "
	Set:(p3'="") A=A_"p3="_p3_":built in asl("_$Piece(p3,"^")_",4,"_$Piece(p3,"^",2)_"), "
	Set:(p4'="") A=A_"p4"_p4_"list of logs to pretest, "
	Set:(p5'="") A=A_"p5"_p5_"padding, "
	Set:(p6'="") A=A_"p6="_p6_":str, "
	Set:(p7'="") A=A_"p7="_p7_":qb, "
	QUIT A
}
.
.
.
///asl(mod,KEY,nn,"next",sn) = $P($c(1))
annotateNext(idx,v) {
	
	set SUBSTYPE("c") = "CONSTANT" set SUBSTYPE("u") = "UNIQUE GIVEN VALUE" set SUBSTYPE("a") = "ASCENDING" set SUBSTYPE("d") = "DESCDENDING"
	set SUBSTYPE("y") = "OVER A SET ASCENDING" set SUBSTYPE("h") = "OVER ID CHUNKS ASCENDING"
	set SUBSTYPE("y-") = "OVER A SET DESCENDING" set SUBSTYPE("h-") = "OVER ID CHUNKS DESCENDING"
	
	set LIMITTYPE(0) = "exclusive" set LIMITTYPE(1) = "inclusive" set LIMITTYPE(2) = "%STARTSWITH"
	set LIMITTYPE(5) = "exclusive (partition)" set LIMITTYPE(6) = "inclusive (partition)"
	
	set meanings = $lb("looping on subscript ",
					   "looping type ",
					   "lower limit ",
					   "lower limit type ",
					   "upper limit ",
					   "upper limit type ",
					   "list of logical conditions to test ",
					   "copy ",
					   "real val to loop over ",
					   "target for node/chunk data ",
					   "bitmap/bitslice power subscript ",
					   "nonul")
	quit:v="" ""
	set oldv = v
	set:idx=1 v = $$val(v,0)
	set:idx=2 v = $g(SUBSTYPE(v),"unknown")
	set:((idx=4) || (idx=6)) v = LIMITTYPE(+v) 
 	;quit $li(meanings,idx)_" p["_idx_"]"_"="_v
	quit "[p"_idx_"="_oldv_"]="_v
}
.
///put the annotated result in asl too.
///This function is registerd for ZWRITE, check build.rtn 
annotateASL2() [asl] public 
{
	//%(3,4,-1,"bd",13) for subscripts
	// annotate subscipts
	set subscripts = %subscripts, value = %value
	;remove %( and )
	set subscripts = $e(subscripts,3,$l(subscripts)-1)
	set output(1) = $p(subscripts,",",1)_" /*mod*/"
	set KEYMAP(1) = "PREKEY" set KEYMAP(2) = "KEY" set KEYMAP(3) = "POSTKEY" set KEYMAP(4) = "ACTION"	
	for i=2:1:$l(subscripts,","){
		set idx = $p(subscripts,",",i)
		if i = 2 {
			set:(($g(KEYMAP(+idx))'="")) output(i) = $p(subscripts,",",i)_" "_"/*"_KEYMAP(+idx)_"*/"
		}
	}
	set newsubs = output(1)
	for i=2:1:$l(subscripts,","){
		set newsubs = newsubs_","_$get(output(i),$p(subscripts,",",i))
	} 
	//annotate value
	//if $g(asl(md,k,1,"id"))
	set line = ""
	//if ($l(subscripts,",") = 4) && ($p(subscripts,",",3)="1") && ($p(subscripts,",",4)=,) && (value '= ""){
	if ($l(subscripts,",") = 4) && ($p(subscripts,",",4)="""id""") && (value '= ""){
        set line = line _" "_$$annotateID2(value)
        //set line = line _" "_$$annotateID2(value)
        //for i=1:1:$l(value,$c(1)){
		//	set line = line _" "_$$annotateID(i,$p(value,$c(1),i))_","
		//}
	} elseif ($l(subscripts,",") = 3) && ($p(subscripts,",",2)= 4) {//ACTION
		set line = $$annotateACTION(value)
	} elseif ($l(subscripts,",") = 4) && ($p(subscripts,",",2)= 4){ // the detailed info about builded temp file
		;set:($p(value,$c(1),1)="s") line = "looping on subscripts p[1] "_$$val($p(value,$c(1),2))_" p[2]"	
		set line = $$annotateBuildTF(value)
	} elseif ($l(subscripts,",") = 5) && ($p(subscripts,",",4)="""next"""){
		for i=1:1:$l(value,$c(1)){
			set line = line _" "_$$annotateNext(i,$p(value,$c(1),i))_","
		}
	} elseif ($l(subscripts,",") = 4) && ($p(subscripts,",",4)="""fields"""){
		for i=1:1:$l(value,",")-1{
			//set line = line _" "_$$annotateField(i,$p(value,",",i))_","
			set line=line_"p"_i_"="_$p(value,",",i)_":"_$$val($p(value,",",i),1,1)_", "
		}
	} elseif ($l(subscripts,",") = 4) && ($p(subscripts,",",4)="""dist""") {
		set line=line_" "_$$annotateDistinct(value)
	} elseif ($l(subscripts,",") = 4) && ($p(subscripts,",",4)="""temp""") {
		set line=line_" "_$$annotateTemp(value)
	} elseif ($l(subscripts,",") = 4) && ($p(subscripts,",",4)="""nmod""") {
		set line=line_"nesting"
	} elseif ($l(subscripts,",") = 1) && ($l(value,$c(1))=2) {
		i $p(value,$c(1),1)=""{
			set line=line_"module "_subscripts_" is nested in module "_$p(value,$c(1),2)
		}elseif $p(value,$c(1),1)="s"{
			set line=line_"module "_subscripts_" is shared between modules "_$p(value,$c(1),2)
		}
	} elseif ($l(subscripts,",") = 4) && ($p(subscripts,",",4)="""parq"""){
		set p1=$p(value,","),p2=$p(value,",",2)
		set line=line_"parallel query; "_"p1="_p1_":val, p2="_p2_":q#"
	} elseif ($l(subscripts,",") = 4) && ($p(subscripts,",",4)="""quq"""){
		set p1=$p(value,","),p2=$p(value,",",2)
		set p1=$p(value,"^")
		set line=line_"send query to shard servers/seperate process; "_"p1="_p1_":q#"
	} elseif ($l(subscripts,",") = 5) && ($p(subscripts,",",3)="""ent"""){
		set line="estimated number of tuples"
	} elseif ($l(subscripts,",") = 4) && ($p(subscripts,",",4)="""unary"""){
		set line="set all unary functions on fields in str "_value
	}
	set %subscripts = "%("_newsubs_")"
	set:(line'="") %qaqnicecomment = "  ; "_line
}
.
Alg(n)[%malg] PUBLIC { ; IBA41 to be called directly from the terminal to explain the algorithm entries in %malg
	; input is the algorithm number to be explained from %malg
	QUIT:'n
	QUIT:$g(%malg(n))=""
	w:$p(%malg(n),"^",1)'="" "$p1="_$p(%malg(n),"^",1)_"   : algtype is "_$case($p(%malg(n),"^",1),0:"regular join",
																								   1:"right stream of left outer join",
																								   2:"initial stream",
																								   3:"cartesian product"),!
	w "$p2="_$p(%malg(n),"^",2)_"   : JAlist: list of join attribute ifns",!
	w "$p3="_$p(%malg(n),"^",3)_"   : recid (1 if ID)",!
	w:$p(%malg(n),"^",4)'="" "$p4="_$p(%malg(n),"^",4)_"   : qoslist: list of earlier streams",!
	w:$p(%malg(n),"^",5)'="" "$p5="_$p(%malg(n),"^",5)_"   : jointo: list of columns to which this stream is joined",!
	w:$p(%malg(n),"^",6)'="" "$p6="_$p(%malg(n),"^",6)_"   : joinres: list of restrictions used for this join",!
	w "$p7="_$p(%malg(n),"^",7)_"   : resknown: list of restrictions list of restrictions we know we can process with this stream",!
	w:$p(%malg(n),"^",8)'="" "$p8="_$p(%malg(n),"^",8)_"   : resmaybe",!
	w:$p(%malg(n),"^",9)'="" "$p9="_$p(%malg(n),"^",9)_"   : respartial: ""CON"" and ""RANGE""",!
	w:$p(%malg(n),"^",10)'="" "$p10="_$p(%malg(n),"^",10)_"   : ressubscript: specifies when each restriction is processed",!
	w "$p11="_$p(%malg(n),"^",11)_"   : ordinput: 1 if preordered input ",!
	w:$p(%malg(n),"^",12)'="" "$p12="_$p(%malg(n),"^",12)_"   : map: "_$$map^%qaqplan($p(%malg(n),"^",12)),!
	w:$p(%malg(n),"^",13)'="" "$p13="_$p(%malg(n),"^",13)_"   : tempalg",!
	w "$p14="_$p(%malg(n),"^",14)_"   : processalg",!
	w "$p15="_$p(%malg(n),"^",15)_"   : alghigh",!
	w:$p(%malg(n),"^",16)'="" "$p16="_$p(%malg(n),"^",16)_"   : createcost: COST,CD,CGG,CGS",!
	w "$p17="_$p(%malg(n),"^",17)_"   : costparam: the form array",!
	QUIT
}
---
