====
SYS.SQLStreamSRV
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%SYS.SQLStreamSRV^MAC^^^0
#include %SYS.DBSRV
#include %msql
 
 // Sends a Cache Stream to the client (%qfun="JS")
ReadStream() PUBLIC { 
	try {
		Set strhandle=$$$ReadNext,length=$$$ReadNext
		$$$WriteHeader
		RETURN:'$$PrepareStream(.strhandle,"ReadStream::PrepareStream",1)
	  	Set %qrc=$$ReadAStream(strhandle,length,.%msg)
		if $$$logging { 
			do ##class(%SYS.DBSRV).logappend("ReadStream - sends a stream to the client.  strhandle="_strhandle_", length="_length)
			do ##class(%SYS.DBSRV).logappend("strhandle.%Oid()=",strhandle.%Oid()_", strhandle.Size="_strhandle.Size)
		}
		If '%qrc {
			$$$Flush0
			RETURN
		}
		do:$$$logging ##class(%SYS.DBSRV).logappend("ReadStream - error  %qrc="_%qrc_", %msg="_$g(%msg))
		throw ##class(%Exception.General).%New()
	}
	catch ex {
		do ##class(%SYS.DBSRV).logappend("ReadStream ERROR!!  ex.DsiaplyString=",ex.DisplayString())
		do ##class(%SYS.DBSRV).FlushError("ReadStream")
		if ex.%IsA("%Exception.General") {	// if we fell into this error
			try {
				if $g($$$SQLServerDisconnectCode)'="" X $$$SQLServerDisconnectCode
			}
			catch { HALT }
		}
		RETURN  	// We got here because ReadStream encountered an error - no halt
	}
	HALT	// We got here because we fell through into the error code
}
 
 // Sends a Cache Stream to the client (used for ODBC only protocol > 42) (%qfun="AS")
ReadStreamODBC() PUBLIC {
	try {
		Set strhandle=$$$ReadNext,length=$$$ReadNext
		$$$WriteHeader
		If (%protocol>48) {
				#; JCN1225 added this logic to kill all the stream handles when we got to the first stream of the next row.
				#; This does not work for streams selected where we send the oref to the client in the resultset instead of the oid.
				#; When we send the oref, we have already defined %qobjhandle(%qacn,+oref)=oref.
				#; So we get to the first "AS" call and we end up killing all the stream orefs!
				#; I'm changing (DPV4220) this to mark each stream that has been processed through "AS", then if newRow is TRUE, we only kill 
				#; streams that have already been read.
			Set newRow=$$$ReadNext
			if newRow {
				set tStr=""
				for {
					set tStr=$o(%qobjhandle(%qacn,tStr)) quit:tStr=""
					kill:$d(%qobjhandle(%qacn,tStr,1)) %qobjhandle(%qacn,tStr)
				}
				kill %qstrhandle(%qacn)
			}
		}
		do:$$$logging ..logappend("ReadStreamODBC    strhandle: "_strhandle_", length:"_length_", newrow:"_$g(newrow))
		RETURN:'$$PrepareStream(.strhandle,"ReadStreamODBC::PrepareStream",1,.strhandleSub)
		If strhandle.Size=0 {
			$$$WriteData(0)
			Set x=$zobjexport($C(0),5)
			Set x=$zobjexport(418,8)
			Kill %qobjhandle(%qacn,strhandleSub)
			RETURN
		}
		set %qobjhandle(%qacn,strhandleSub,1)=1	// Mark this stream entry as having been read
		Set:'$G(%qobjhandle(%qacn,strhandleSub,0)) %qobjhandle(%qacn,strhandleSub,0)=strhandle.Size
			#; if length > length left, this is last chunk; read only length bytes
		Set:length>=%qobjhandle(%qacn,strhandleSub,0) length=%qobjhandle(%qacn,strhandleSub,0)
		$$$WriteData(+%qobjhandle(%qacn,strhandleSub,0))
		If length=0 { $$$Flush0 RETURN  }
		Set %qrc=$$ReadAStream(strhandle,length,.%msg)
		If '%qrc {
			Set size=$increment(%qobjhandle(%qacn,strhandleSub,0),-length)
			If size>0 { $$$Flush0 } Else { Set x=$zobjexport(418,8) Kill %qobjhandle(%qacn,strhandleSub) }
			RETURN
		}
		throw ##class(%Exception.General).%New()
	}
	catch ex {
		do ##class(%SYS.DBSRV).FlushError("ReadStreamODBC")
		if ex.%IsA("%Exception.General") {	// if we fell into this error
			try {
				if $g($$$SQLServerDisconnectCode)'="" X $$$SQLServerDisconnectCode
			}
			catch { HALT }
		}
		RETURN  	// We got here because ReadStreamODBC encountered an error - no halt
	}
	HALT	// We got here because we fell through into the error code
}
 
 // Open and return stream size (%qfun="SS")
GetStreamSize() PUBLIC {
	try {
			#; strhandle is the stream identifier coming from the client.  This might be an Oref or an Oid.
			#; If it is an Oid, we must open the stream to get the oref, but the oref is not sent back to the client here.
			#; If we do open the stream, we go ahead and record the stream Oid in the %qobjhandle() array so we know it has already been opened.
			#; But we have to be careful because the stream Oid might be too long to fit in a single local array subscript.
			#; Thus the NormalizeStreamId() call which might hash the stream Oid for us if it is longer than a certain length.
		set strhandle=$$$ReadNext,strid=strhandle,strhandleSub=$$$NormalizeStreamId(strhandle)
		do:$$$logging ##class(%SYS.DBSRV).logappend("GetStreamSize - strhandle="_strhandle)
		$$$WriteHeader
		if ('$D(%qobjhandle(%qacn,strhandleSub)) || '$isobject(%qobjhandle(%qacn,strhandleSub))) { 
			set:strid&&('$listvalid(strid)) x=$zobjref(strid)
			do:$$$logging ##class(%SYS.DBSRV).logappend("GetStreamSize - Calling %Strem.Object.%Open()")
			set strhandle=$S($isobject(x):x,1:##class(%Stream.Object).%Open(strid))
		}
		else { Set strhandle=%qobjhandle(%qacn,strhandleSub) }
		do:$$$logging ##class(%SYS.DBSRV).logappend("GetStreamSize - $isobject(strhandle)="_$isobject(strhandle))
		set checkstream=$$CheckStream(strhandle,"GetStreamSize")
		do:$$$logging ##class(%SYS.DBSRV).logappend("GetStreamSize - $$CheckStream="_checkstream_", %qrc="_%qrc)
		RETURN:'checkstream
		set x=$zobjexport(strhandle.Size,18)
		set x=$zobjexport(0,8)
		set size=strhandle.Size
		do:$$$logging ##class(%SYS.DBSRV).logappend("GetStreamSize - Return stream size = "_size)
			#; DPV6720 - We no longer keep the stream oref open after leaving the SS function is we opened it in SS
		if size'=0 {
		#; 	//Set %qobjhandle(%qacn,strhandleSub)=strhandle
		#; 	//Set %qobjhandle(%qacn,strhandleSub,0)=size
			do strhandle.Rewind()
		}
	}
	catch {
		set %qrc=412
		do ##class(%SYS.DBSRV).FlushError("GetStreamSize")
	}
	RETURN
}
 
 // Sends length bytes of a Cache Stream (starting at position position) (%qfun="GB")
GetStreamBytes() PUBLIC { 
	try {
		Set strhandle=$$$ReadNext,position=$$$ReadNext,length=$$$ReadNext
		$$$WriteHeader	
		RETURN:'$$QuickPrepareStream(.strhandle,"GetStreamBytes::QuickPrepareStream")	
		do:$$$logging ##class(%SYS.DBSRV).logappend("GetStreamBytes - position: "_position_", length: "_length)
	 	Set %qrc=$$ReadStreamAt(strhandle,position,length,.%msg)
		If '%qrc {
			$$$Flush0
			RETURN
		}
		throw ##class(%Exception.General).%New()
	}
	catch ex {
		set:%qrc'=412 %qrc=400
		do ##class(%SYS.DBSRV).FlushError("GetStreamBytes")
		if ex.%IsA("%Exception.General") {	// if we fell into this error
			try {
				if $g($$$SQLServerDisconnectCode)'="" X $$$SQLServerDisconnectCode
			}
			catch { HALT }
		}
		RETURN  	// We got here because getStreamBytes encountered an error - no halt
	}
	HALT	// We got here because we fell through into the error code
}
 
  // Updates an existing Cache Stream (starting at position position) (%qfun="SZ")
SetStreamBytes() PUBLIC {
	try {
		set strhandle=$$$ReadNext,position=$$$ReadNext,length=$$$ReadNext
		$$$WriteHeader
		do:$$$logging ##class(%SYS.DBSRV).logappend("SetStreamBytes - position: "_position_", length: "_length)
		RETURN:'$$QuickPrepareStream(.strhandle,"SetStreamBytes::QuickPrepareStream")
	 	set %qrc=$$SetBytesAt(strhandle,position,length,.written) //,.%msg)
		if '%qrc {
			$$$WriteData(written)
			$$$Flush0
			RETURN
		}
		throw ##class(%Exception.General).%New()
	}
	catch ex {
		set %qrc=412 
		do ##class(%SYS.DBSRV).FlushError("SetStreamBytes")
	}
	RETURN
}
 
 // Truncates an existing Cache Stream at position length (%qfun="SX")
TruncateStream() PUBLIC {
	try {
		set strhandle=$$$ReadNext,length=$$$ReadNext
		$$$WriteHeader
		do:$$$logging ##class(%SYS.DBSRV).logappend("TruncateStream - length: "_length)
		RETURN:'$$QuickPrepareStream(.strhandle,"TruncateStream::QuickPrepareStream")
	 	set %qrc=$$Truncate(strhandle,length)
		if '%qrc { 
			$$$Flush0
			RETURN
		}
		throw ##class(%Exception.General).%New()
	}
	catch ex {
		set %qrc=412 
		do ##class(%SYS.DBSRV).FlushError("Truncate")
	}
	RETURN
}
 
  // Returns the first occurence of the given pattern (%qunf="GP")
GetStreamPatternPosition() PUBLIC {
	try {
		set strhandle=$$$ReadNext,position=$$$ReadNext,pattern=$$$ReadNext
		$$$WriteHeader
		do:$$$logging ##class(%SYS.DBSRV).logappend("GetStreamPatternPosition - position: "_position_", pattern: "_pattern)
		RETURN:'$$QuickPrepareStream(.strhandle,"GetStreamPatternPosition::PrepareStream")
		$$$WriteData(strhandle.FindAt(position,pattern))
		$$$Flush0
	}
	catch {
		set %qrc=412 
		do ##class(%SYS.DBSRV).FlushError("GetStreamPatternPosition")
	}
	RETURN
}
.
  // Unlock the shared lock on a stream (%qfun="SR")
  // AND1352, among other things, correctly stopped sending CLOSE_STREAM messages 
  // when InputStream/Reader objects (obtained by calling  Blob/Clob.getBinaryStream/getCharacterStream) were closed. 
  // A corresponding change (DPV4157) added the server side code to release read (shared) locks for all streams 
  // read to the end (when AtEnd=true). 
  // Even though a vast majority of streams are indeed read to the end, there is still a remore possibility that a stream is not 
  // read all the way to the end (and thus there is no implicit unlock of the read lock) 
  // and that the user calls close on the same stream. With AND1352 in place, the close message (correctly) does not get sent, but that leaves a possibility 
  // of a read lock remaining open. This change closes that small loophole by adding a new RELEASE_READ_LOCK message which gets sent in above described situation.
ReleaseStreamLock(strhandle) PUBLIC {
	try {
		Set strhandleSub=$$$NormalizeStreamId(strhandle)
		Set strhandle=%qobjhandle(%qacn,strhandleSub)
		do:strhandle.%Locked strhandle.%UnlockStream(1)
	}
	catch {	// just return.  SR does not return anything to the client so if something is sent it will cause a message sequence error
		Quit
	}
	QUIT
}
 
 // Set up strhandle.  
 // strhandle is the stream identifier coming from the client.  
 // This might be an Oref or an Oid, but we have to be careful because the stream Oid might be too long to fit in a single local array subscript.
 // Thus the NormalizeStreamId() call which might hash the stream Oid for us if it is longer than a certain length.
 // We then either Open the stream if it is not already open, or simply return the oref of the already opened stream.
 // strhandle is passed by reference and will contain the stream oref when returning from this function
 // If we get an error, PrepareStream returns 0, %qrc has been set up and FlushError already called.
PrepareStream(strhandle,pCaller,pRecordStreamOref=0,strhandleSub) PUBLIC {
	try {
		set tReturn=1
		set strhandleSub=$$$NormalizeStreamId(strhandle)
		if ('$data(%qobjhandle(%qacn,strhandleSub)) || '$isobject(%qobjhandle(%qacn,strhandleSub))) { 
			set strid=strhandle,x=""
			set:strid&&('$listvalid(strid)) x=$zobjref(strid) 
			set strhandle=$select($isobject(x):x,1:##class(%Stream.Object).%Open(strid))
		 	set:pRecordStreamOref %qobjhandle(%qacn,strhandleSub)=strhandle
		} 
		else {
			set strhandle=%qobjhandle(%qacn,strhandleSub)
		}
		RETURN:'$$CheckStream(strhandle,"PrepareStream") 0
	}
	catch {
		set %qrc=412,tReturn=0
		do ##class(%SYS.DBSRV).FlushError(pCaller)
	}
	QUIT tReturn
}
.
 // Set up strhandle.  
 // strhandle is the stream identifier coming from the client.  
 // This might be an Oref or an Oid, but we have to be careful because the stream Oid might be too long to fit in a single local array subscript.
 // Thus the NormalizeStreamId() call which might hash the stream Oid for us if it is longer than a certain length.
 // We assume here the stream has already been opened, and we just need to get the oref of the stream out of %qobjhandle
 // strhandle is passed by reference and will contain the stream oref when returning from this function
 // If we get an error, QuickPrepareStream returns 0, %qrc has been set up and FlushError already called.
QuickPrepareStream(strhandle,pCaller) PUBLIC {
	try {
		set tReturn=1
		set strhandleSub=$$$NormalizeStreamId(strhandle)
			#; DPV6720 - We no longer keep the stream oref open after leaving the SS function, so may need to open it here.
		if ('$data(%qobjhandle(%qacn,strhandleSub)) || '$isobject(%qobjhandle(%qacn,strhandleSub))) { 
			set strid=strhandle,x=""
			set:strid&&('$listvalid(strid)) x=$zobjref(strid)
			do:$$$logging ##class(%SYS.DBSRV).logappend("QuickPrepareStream - opening strea, with Oid: "_strid)
			set strhandle=$select($isobject(x):x,1:##class(%Stream.Object).%Open(strid))
		 	set %qobjhandle(%qacn,strhandleSub)=strhandle
		} 
		else {
			do:$$$logging ##class(%SYS.DBSRV).logappend("QuickPrepareStream - stream already open "_strhandleSub)
			set strhandle=%qobjhandle(%qacn,strhandleSub)
		}
		RETURN:'$$CheckStream(strhandle,"QuickPrepareStream") 0
	}
	catch {
		set %qrc=412,tReturn=0
		do ##class(%SYS.DBSRV).FlushError(pCaller)
	}
	RETURN tReturn
}
.
 // CheckStream - see if the stream is defined, null, empty, etc.
 // Return 1 if the caller should continue on (stream exists and is non-null/non-empty)
 // Return 0 if the caller should stop because the stream is NULL/Empty
 // If this code errors, %qrc has been set up and FluchError already called
CheckStream(strhandle,pCaller="") PUBLIC {
	try {
		set tReturn=1
		if '$isobject(strhandle)    { do:$$$logging ##class(%SYS.DBSRV).logappend("CheckStream - strhandle is not an oref: "_strhandle) set x=$zobjexport(411,8),tReturn=0 set tReturn=0 quit }
		elseif (strhandle.IsNull()) { do:$$$logging ##class(%SYS.DBSRV).logappend("CheckStream - strhandle.IsNull is TRUE: "_strhandle) set x=$zobjexport(403,8),tReturn=0 kill strhandle set tReturn=0 quit }
		elseif (strhandle.Size<0)   { do:$$$logging ##class(%SYS.DBSRV).logappend("CheckStream - strhandle.Size<0: "_strhandle) set x=$zobjexport(412,8),tReturn=0 kill strhandle set tReturn=0 quit }
		do:$$$logging ##class(%SYS.DBSRV).logappend("CheckStream - strhandle is OK: "_strhandle)
	}
	catch {
		set %qrc=412,tReturn=0
		do ##class(%SYS.DBSRV).FlushError(pCaller_"->CheckStream")
	}
	RETURN tReturn
}
 // receives and stores a Stream (%qfun="SB" or %qfun="SM")
StoreStream() PUBLIC {
	#dim ex As %Exception.SQL
	try {
		$$$WriteHeader
		Set strhandle=$$$ReadNext
		Set length=$zobjexport(4,13)
		Set length=$zla(length)	
	 	If strhandle=0 {    // create stream object
	 		do:$$$logging ##class(%SYS.DBSRV).logappend("StoreStream,  creating new stream object.  length="_length_", Target Sharded = "_$g($$$ShardedTableIU))
	 		if $g($$$ShardedTableIU) {
		 		set strhandle=$s(%qfun="SM":##class(%Stream.GlobalCharacter).%New("Shard"),1:##class(%Stream.GlobalBinary).%New("Shard"))
		 		set %qstrhandle(%qacn,strhandle)=strhandle.%Oid()
	 		} else {
		 		set strhandle=$s(%qfun="SM":##class(%Stream.GlobalCharacter).%New(),1:##class(%Stream.GlobalBinary).%New())
		 		set %qstrhandle(%qacn,strhandle)=strhandle
	 		}
	 		do:$$$logging ##class(%SYS.DBSRV).logappend("StoreStream,  str.%Location="_strhandle.%Location)
	 	}
	 	Else {
	 		do:$$$logging ##class(%SYS.DBSRV).logappend("StoreStream,  getting existing stream object.  length="_length)
			If %qacn=0 { 
				Set strhandle=$zobjref(strhandle) 
			} 
			Else { 
				Set strhandleSub=$$$NormalizeStreamId(strhandle)
				Set strhandle=%qstrhandle(%qacn,strhandleSub)
			}
	 	}
	 	if '$isobject(strhandle) { set x=$zobjexport(411,8) quit }
		Set %qrc=$$WriteStream(strhandle,length,.%msg)
 		do:$$$logging ##class(%SYS.DBSRV).logappend("StoreStream,  $$WriteStream returned %qrc="_%qrc)
	 	If '%qrc {
			if $g($$$ShardedTableIU) {
					#; if the stream is to be stored in a sharded table, we must use the Oid of this temp stream and not an Oref
		 		set sc=strhandle.%Save()
		 		do:$$$logging ##class(%SYS.DBSRV).logappend("StoreStream,  insert INS/UPD into sharded table, strhandle.%Save()="_sc)
		 		if $$$ISERR(sc) { throw ##class(%Exception.SQL).CreateFromSQLCODE(-412,"An error occurred saving a temp stream: "_$SYSTEM.Status.GetErrorTest(sc) ) }
				set soid=strhandle.%Oid()
				$$$WriteData(soid)
		 		set %qstrhandle(%qacn,soid)=soid
		 		do:$$$logging ##class(%SYS.DBSRV).logappend("StoreStream,  insert INS/UPD into sharded table, soid="_soid)
			} else {
				do:$$$logging ##class(%SYS.DBSRV).logappend("StoreStream,  NOT insert INS/UPD into sharded table, sending strhandle to client")
				$$$WriteData(strhandle)
			}
			$$$Flush0
			quit
	 	}
	}
	catch ex {
		if ex.%IsA("%Exception.SQL") { set %qrc=ex.AsSQLCODE(),%msg=ex.AsSQLMessage() }
		do ##class(%SYS.DBSRV).FlushError("StoreStream")
	}
	RETURN
}
.
 // WriteStream
 //   Arguments:
 // 	pHandle As %Stream.Object,
 //	pLen As %Integer,
 //	ByRef pMsg As %String
 //   Returns %qrc value, 0 if success, 412 if error
WriteStream(pHandle,pLen,&pMsg) [] PUBLIC {
	try {
	 	if pHandle.IsCharacter() {
			set x=$zu(96,18,2,"UTF8") 
			set tRC=$$InputFromDevice(pHandle,.pLen) 
			set x=$zu(96,18,2,"RAW") 
	 	} 
	 	else {
	 		set tRC=$$InputFromDevice(pHandle,.pLen)
	 	}
		do:$$$logging ##class(%SYS.DBSRV).logappend("WriteStream,  $$InputFromDevice returned tRC="_tRC)	}
	catch {
		RETURN 412
	}
 	RETURN:tRC 0
 	set pMsg=$$GetError(tRC)
 	RETURN 412
}
.
 // InputFromDevice
 //   Arguments:
 // 	pHandle As %Stream.Object,
 //	ByRef pLen As %Integer = 0,
 //   Returns status code
InputFromDevice(pHandle,pLen) [] PUBLIC {
	try {
		set tSC=$$$OK
		do:$$$logging ##class(%SYS.DBSRV).logappend("InputFromDevoce, called with pLen="_pLen)
		RETURN:pLen=0 pHandle.Write("")
		for  {
			set tData=$zobjexport($select(pLen>$$$MaxLocalLength:$$$MaxLocalLength,1:pLen),13)
			set tSC=pHandle.Write(tData)
			set pLen=pLen-$length(tData)
			quit:pLen=0||($$$ISERR(tSC))
		}
		set:pLen'=0 tSC=$select($$$ISOK(tSC):$$$ERROR($$$FileDoesNotExist),1:tSC)
	}
	catch {
		RETURN $$$ERROR($$$ObjectScriptError,$ZE)
	}
	RETURN tSC
}
.
 // Close Stream (%qfun="CS") 
CloseStream(acn) [] PUBLIC {
	try {
		Set strhandle=$$$ReadNext,strhandleSub=$$$NormalizeStreamId(strhandle)
		do:$$$logging ##class(%SYS.DBSRV).logappend("Closing stream with strhandle="_strhandle_", acn="_acn)
		If strhandle=0 { kill %qstrhandle(acn),%qobjhandle(acn) } 
		Else	       { kill %qstrhandle(acn,strhandleSub),%qobjhandle(acn,strhandleSub) }
	}
	catch {	// just return.  CS does not return anything to the client so if something is sent it will cause a message sequence error
		QUIT
	}
}
.
 // Opens a Cache Stream (used for protocols <= 42) (%qfun="OS")
OpenStream() PUBLIC {
	try {
		$$$WriteHeader
		Set id=$$$ReadNext,strhandle=##class(%Stream.Object).%Open(id)
		RETURN:'$$CheckStream(strhandle,"OpenStream")
		$$$WriteData(strhandle)
		$$$WriteData(strhandle.Size) 
		If (strhandle.Size'=0) {
			Set %qobjhandle(%qacn,strhandle)=strhandle
			Set %qobjhandle(%qacn,strhandle,0)=strhandle.Size
		}
		$$$Flush0
	}
	catch {
		Set %qrc=412 
		do ##class(%SYS.DBSRV).FlushError("OpenStream") 
	}
	QUIT
}
.
 // ReadAStream
 //   Arguments:
 // 	pHandle As %Stream.Object,
 //	pLen As %Integer,
 //	ByRef pMsg As %String
 //   Returns %qrc value, 0 if success, 412 if error
ReadAStream(pHandle,pLen,pMsg) [] PUBLIC {
	try {
		set tRC=$$$OK
		do:$$$logging ..logappend("ReadAStream    IsCharacter: "_pHandle.IsCharacter())
		if pHandle.IsCharacter() {
			Set x=$zu(96,18,2,"UTF8") 
			Set tRC=$$OutputToDevice(pHandle,pLen) 
			Set x=$zu(96,18,2,"RAW") 
	 	} 
	 	else {
			Set tRC=$$OutputToDevice(pHandle,pLen)
	 	}
	}
	catch {
		RETURN 412
	}
 	RETURN:tRC 0
 	set pMsg=$$GetError(tRC)
 	RETURN 412
}
.
 // ReadStreamAt
 //   Arguments:
 // 	pHandle As %Stream.Object,
 //	pPosition As %Integer,
 //	pLen As %Integer,
 //	ByRef pMsg As %String
 //   Returns %qrc value, 0 if success, 412 if error
ReadStreamAt(pHandle,pPosition,pLen,pMsg) [] PUBLIC {
 	try {
	 	set tReturn=0
	 	do pHandle.MoveTo(pPosition)
 		set tReturn=$$ReadAStream(pHandle,pLen,.pMsg)
 	}
 	catch {
	 	RETURN 412
 	}
 	QUIT tReturn
}
.
 // OutputToDevice
 //   Arguments:
 // 	pHandle As %Stream.Object,
 //	pLen As %Integer = -1,
 //   Returns status code
OutputToDevice(pHandle,pLen=-1) [] PUBLIC {
	#dim pHandle as %Stream.Object
	try {
		do:$$$logging ##class(%SYS.DBSRV).logappend("OutputToDevoce, pLen="_pLen)
		RETURN:pLen=0 $$$OK
		set tSC=$$$OK
		if pLen=-1 {
			set tSC=pHandle.Rewind() RETURN:$$$ISERR(tSC) tSC
			for  {
				quit:pHandle.AtEnd 
				set tRC=$zobjexport(pHandle.Read(,.tSC),5)
				quit:$$$ISERR(tSC)
			}
			set:$$$ISOK(tSC) tSC=pHandle.Rewind()
		}
		else {
			set tTotal=0
			for  {
				do:$$$logging ##class(%SYS.DBSRV).logappend("OutputToDevoce, pHandle.AtEnd="_pHandle.AtEnd)
				quit:pHandle.AtEnd
				set tChunk=$select(pLen-tTotal>$$$MaxLocalLength:$$$MaxLocalLength,1:pLen-tTotal)
				do:$$$logging ##class(%SYS.DBSRV).logappend("OutputToDevoce, sending next tChunk="_pLen_" character of the stream to the client")
				set tRC=$zobjexport(pHandle.Read(tChunk,.tSC),5) quit:$$$ISERR(tSC)
				set tTotal=tTotal+tChunk
				quit:tTotal=pLen
			}
		}
	}
	catch {
		RETURN $$$ERROR($$$ObjectScriptError,$ZE)
	}
	RETURN tSC
}
.
 // AppendFromDevice
 //   Arguments:
 // 	ByRef pHandle As %Stream.Object,
 //	pLen As %Integer,
 //	ByRef written As %Integer
 //   Returns status code
AppendFromDevice(pHandle,pLen,pWritten) [] PUBLIC {
	try {
		set tSC=$$$OK
		set pWritten=0
		for  {
			set tData=$zobjexport($select(pLen>$$$MaxLocalLength:$$$MaxLocalLength,1:pLen),13)
			set tSC=pHandle.Write(tData)
			set pLen=pLen-$length(tData)
			set pWritten=pWritten+$length(tData)
			quit:pLen=0||($$$ISERR(tSC))
		}
		set:pLen'=0 tSC=$select($$$ISOK(tSC):$$$ERROR($$$FileDoesNotExist),1:tSC)
	}
	catch {
		RETURN $$$ERROR($$$ObjectScriptError,$ZE)
	}
	QUIT tSC
}
.
 // CopyFrom
 //   Arguments:
 //	pSource As %Stream.Object,
 //	ByRef pTarget As %Stream.Object,
 //	pOffset As %Integer,
 //	pLen As %Integer
 //   Returns status code
CopyFrom(pSource,pTarget,pOffset,pLen) [] PUBLIC {
	try {
		RETURN:pSource=$$$NULLOREF $$$ERR($$$OrefInvalid)	
		set tSC=$$$OK
		RETURN:pOffset>pSource.Size $$$OK
		if pSource.IsCharacter() { set pTarget=##class(%Stream.GlobalCharacter).%New() }
		else                     { set pTarget=##class(%Stream.GlobalBinary).%New() }
		set:pLen>pSource.Size pLen=pSource.Size
		do pSource.MoveTo(pOffset)
		while (pLen>0) {
			quit:(pSource.AtEnd)
			if (pLen>$$$MaxLocalLength) { set tLen=$$$MaxLocalLength,pLen=pLen-$$$MaxLocalLength } else { set tLen=pLen,pLen=0 }
			set tData=pSource.Read(tLen,.tSC) quit:$$$ISERR(tSC)
			set tSC=pTarget.Write(tData) quit:$$$ISERR(tSC)
		}
	}
	catch {
		RETURN $$$ERROR($$$ObjectScriptError,$ZE)
	}
	QUIT tSC
}
.
 // Truncate
 //   Arguments:
 //	pSource As %Stream.Object,
 //	pLen As %Integer
 //   Returns %qrc value, 0 if success, 412 if error
Truncate(pSource,pLen) [] PUBLIC {
	try {
		RETURN:pSource=$$$NULLOREF $$$ERR($$$OrefInvalid)
		set tSC=$$$OK
		RETURN:pLen>pSource.Size 0
		if pSource.IsCharacter() { set tTemp=##class(%Stream.GlobalCharacter).%New() }
		else                     { set tTemp=##class(%Stream.GlobalBinary).%New() }
		do pSource.Rewind()
		while (pLen>0) {
			quit:(pSource.AtEnd)
			if (pLen>$$$MaxLocalLength) { set tLen=$$$MaxLocalLength,pLen=pLen-$$$MaxLocalLength } else { set tLen=pLen,pLen=0 }
			set tData=pSource.Read(tLen,.tSC) quit:$$$ISERR(tSC)
			set tSC=tTemp.Write(tData) quit:$$$ISERR(tSC)
		}
		if $$$ISERR(tSC) set %msg=$$GetError(tSC) RETURN 412
		set tSC=pSource.CopyFrom(tTemp)
		if $$$ISERR(tSC) set %msg=$$GetError(tSC) RETURN 412
		do pSource.Rewind()
		set tSC=pSource.%Save()
		if $$$ISERR(tSC) set %msg=$$GetError(tSC) RETURN 412
	}
	catch {
		set %msg=$$GetError(tSC) RETURN 412
	}
	QUIT 0
Error
}
.
 // SetBytesAt
 //   Arguments:
 //	ByRef pSource As %Stream.Object,
 //	pOffset As %Integer,
 //	pLen As %Integer
 //	ByRef pWritten As %Integer
 //   Returns %qrc value, 0 if success, 412 if error
SetBytesAt(pSource,pOffset,pLen,pWritten) [] PUBLIC {
	try {
		set tSC=$$CopyFrom(pSource,.pTarget,0,pOffset)
		if $$$ISERR(tSC) set %msg=$$GetError(tSC) RETURN 412
		set tSC=$$AppendFromDevice(.pTarget,pLen,.pWritten)
		if $$$ISERR(tSC) set %msg=$$GetError(tSC) RETURN 412
		if pWritten<pSource.Size {
			set pOffset=pOffset+pWritten+1
			do pSource.MoveTo(pOffset)
		}
		set tSC=$$$OK,tRC=$$$OK
		for  {
			quit:(pSource.AtEnd)||($$$ISERR(tRC))
			set tLen=$$$MaxLocalLength,tRC=pTarget.Write(pSource.Read(tLen,.tSC))
			if $$$ISERR(tSC) set tRC=tSC quit
		}
		if $$$ISERR(tRC) set %msg=$$GetError(tRC) RETURN 412
		set tRC=pSource.CopyFrom(pTarget)
		if $$$ISERR(tSC) set %msg=$$GetError(tSC) RETURN 412
		set tRC=pSource.%Save() if $$$ISERR(tSC) set %msg=$$GetError(tSC) RETURN 412
		set tRC=pSource.Rewind() if $$$ISERR(tSC) set %msg=$$GetError(tSC) RETURN 412
	}
	catch {
		set %msg="Unexpected error in SetBytesAt: "_$ZE RETURN 412
	}
	QUIT 0
}
.
.
 // GetError
 //   Arguments:
 //	pRC As %Status
 //   Returns message string
GetError(pRC) [] PUBLIC {
	try {
		set tMsg=$$DecomposeStatus^%apiOBJ(pRC,.tMsg)
 		set:tMsg tMsg=$g(tMsg(1))
	}
	catch {
		set tMsg="ERROR in GetError: "_$ZE_$s($d(tMsg):",tMsg = "_$g(tMsg),1:"")
	}
 	QUIT tMsg
}
.
 // CopyFileFromStream
 //   Arguments:
 //	pSource As %Stream.FileBinary,
 //	pDest As %Stream.Object
 //   Returns nothing
CopyFromFileStream(pSource,pDest) [] PUBLIC {
	try {
		do pSource.%Save()
		set tFilename = pSource.Filename
		set pSource = ##class(%Stream.FileCharacter).%New()
		do pSource.LinkToFile(tFilename)
		do pDest.CopyFrom(pSource)
		do pSource.Clear()
	}
	catch {	// report no error at this time
	}
}
---
