	;-------------------------------------------------------------
	;                     I N F O R M A T I O N
	;-------------------------------------------------------------
	;
	;  This program parses the SQL DDL statement CREATE TABLE.
	;  It stores the results in the DDL parse tree, using the
	;  parse tree API in ^%qaqpddl.inc.
	;
	; -------------------------
	; CREATE INDEX NOTES
	; -------------------------
	;
	;  The full MS SQL Server 6.5 CREATE INDEX syntax is:
	;   CREATE [UNIQUE] [CLUSTERED | NONCLUSTERED] INDEX index_name
	;       ON [[database.]owner.]table_name (column_name [, column_name]...)
	;    [WITH
	;       [FILLFACTOR = x]
	;       [[,] IGNORE_DUP_KEY]
	;       [[,] {SORTED_DATA | SORTED_DATA_REORG}]
	;       [[,] {IGNORE_DUP_ROW | ALLOW_DUP_ROW}]]
	;    [ON segment_name]
	;
	;  We support:
	;   CREATE [ { BITMAP | UNIQUE } [ CLUSTERED | NONCLUSTERED ] ] INDEX index_name
	;       ON [TABLE] [[[owner.]catalog.]schema.]table_name 
	;       (column_name [ ASC | DESC ] [, column_name [ ASC | DESC ] ] ...)
	;
	;     BITMAP will mark the index as type=Bitmap
	;     UNIQUE will mark the index as being unique
	;     CLUSTERED, NONCLUSTERED, ASC, and DESC tokens are no-ops
	;     [[[owner.]catalog.]schema.] is also no-ops
	;
	; -------------------------
	; CREATE VIEW NOTES
	; -------------------------
	; 
	;  The SQL99 syntax:
	;	<view definition> ::=
	;	CREATE [ RECURSIVE ] VIEW <table name>
	;		<view specification>
	;		AS <query expression>
	;		[ WITH [ <levels clause> ] CHECK OPTION ]
	;
	;	<view specification> ::=
	;		<regular view specification>
	;		| <referenceable view specification>
	;
	;	<regular view specification> ::=
	;	[ <left paren> <view column list> <right paren> ]
	;
	;	<referenceable view specification> ::=
	;		OF <user-defined type> [ <subview clause> ] [ <view element list> ]
	;
	;	<subview clause> ::= UNDER <table name>
	;
	;	<view element list> ::= 
	;		<left paren> 
	;		[ <self-referencing column specification> <comma> ]
	;		<view element> [ { <comma> <view element> }... ]
	;		<right paren>
	;
	;	<view element> ::= <view column option>
	;
	;	<view column option> ::= <column name> WITH OPTIONS <scope clause>
	;
	;	<levels clause> ::= CASCADED | LOCAL
	;
	;	<view column list> ::= <column name list>
	;
	;
	;  The full Oracle 7.0 CREATE VIEW syntax is:
	;   CREATE [ OR REPLACE ] [ { FORCE | NO FORCE } ] VIEW [ schema. ] view_name
	;       [ '(' fild_alias_list ')' ] AS subquery
	;       [ WITH { READ ONLY | CHECK OPTION [ CONSTRAINT constraint_name ] } ]
	;
	;  We support:
	; DPV1693+
	;   CREATE [ OR REPLACE ] VIEW [[[owner.]catalog.]schema.]view_name
	;       [ '(' field_alias_list ')' ] AS subquery
	;       [ WITH { READ ONLY | CHECK OPTION [ CONSTRAINT constraint_name ] } ]
	;     OR REPLACE, WITH CHECK OPTION, [[[owner.]catalog.]schema.] are no-ops
	;     All IRIS SQL Views are read-only.
	; DPV1693=
	;   CREATE [ OR REPLACE ] VIEW [[[owner.]catalog.]schema.]view_name
	;       [ '(' field_alias_list ')' ] AS subquery
	;       [ WITH { READ ONLY | CHECK [ <levels clause> OPTION [ CONSTRAINT constraint_name ] } ]
	;     OR REPLACE, [[owner.]catalog.] are no-ops
  	;	<levels clause> ::= CASCADED | LOCAL
	; DPV1693-
	; 
	; ----------------------------
	; FOREIGN KEY CONSTRAINT NOTES
	; ----------------------------
	; 
	;   [CONSTRAINT constraint_name] FOREIGN KEY  
	;     ['('] constraint_fieldname [ { constraint_fieldname, ... } ] 
	;     REFERENCES [[[owner.]catalog.]schema.]table_name 
	;     [ ['('] referenced_fieldname [ { referenced_fieldname, ... } ] ] 
	;     [ MATCH { FULL | PARTIAL } ] 
	;     [ ON UPDATE { CASCADE | SET NULL | SET DEFAULT | NO ACTION } ] 
	;     [ ON DELETE { CASCADE | SET NULL | SET DEFAULT | NO ACTION } ] 
	;
	;   If the referenced_fieldname list is empty, the referenced fields are equal 
	;    to the Primary Key fields of the referenced table. 
	;   The MATCH clause is supported in the parser only, the actual constraint 
	;    checking always behaves as if no MATCH clause was defined. 
	;   The ON UPDATE and ON DELETE clauses are supported in the parser only. 
	;    They are ignored be the table referential integrity checking. 
	;    Referential Constraint actions are not currently supported in IRIS SQL. 
	;   When the Foreign Key constraint is defined as a column constraint, the 
	;    syntax supported begins with the REFERENCES clause.  
	;  
	;-------------------------------------------------------------
#ENDIF  ;
	#; MaxPrecision is maximum number of digits in a number
	#; MaxScale is the maximum number of digits to the right of the decimal
#DEFINE MaxPrecision 38
#DEFINE MaxScale 38
#DEFINE MaxNameLength 96
#DEFINE MaxCharLength 32767
#DEFINE ParmDel "$!$"
#DEFINE MaxNum 999999999999999999
#DEFINE ZeroMask "0000000000000000000000000000000000"
#DEFINE OneByteNum 128
#DEFINE TwoByteNum 32768
#DEFINE FourByteNum 2147483648
#DEFINE MaxLongCharLength $$$FourByteNum-1
#DEFINE normalize(%s) $tr(%s,"_")
#define InQuote(%s,%p) ($l($e(%s,1,%p-1),"""")+1#2)
	#;
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; TUNE TABLE <tablename> { %KEEP_UP_TO_DATE | %CLEAR_VALUES | %SAMPLE_PERCENT <sample_percent_value> | %RECOMPILE_CQ }
	#; COLLECT <stats> FOR TABLE <tablename> [ %SAMPLE_PERCENT <sample_percent_value> ]
	#; COLLECT <stats> FOR SCHEMA <schemaname> [ %SAMPLE_PERCENT <sample_percent_value> ]
	#; <stats> ::= STATISTICS || STATS
	#;	<sample_percent_value> ::= <percent value>
	#;	<percent_value> ::= .nn || nn%
	#;    %KEEP_UP_TO_DATE, is specified, would call TuneTable with the KeepClassUpToDate=1.  When KeepClassUpToDate=1, the class definition will be/updated with the new EXTENTSIZE, SELECTIVITY, etc. values, but the class definition will be kept as up-to-date.  The default is KeepClassUpToDate=0, so not specifying this option would provide default TuneTable behavior.
	#;    %CLEAR_VALUES, if specified, would call TuneTable with the ClearValues=1.  When ClearValues=1, the SELECTIVITY, EXTENTSIZE, etc. will be cleared from the class and table definition.  The default is ClearValues=0, so not specifying this option would provide the default TuneTable behavior.
	#;    %SAMPLE_PERCENT <sample_percent_value>     This would define the value passed to the SamplePercent argument of TuneTable.  The percentage of rows of the table to be used for sampling the data for the TuneTable utility.  This percentage can be specified as .## or ##%.  For example .12 or 12% will cause TuneTable to use 12% of the rows in the table when sampling the data. This value does not usually need to be specified when calling TuneTable.  Only specify this value when potential outlier values for a field are not evenly distributed among rows throughout the table.  Note, for any table with an extentsize < 1000, the entire extent will be used by TuneTable.
	#;    %RECOMPILE_CQ, if  specified, would call TuneTable with the RecompileCQ=1.  When RecompileCQ=1, instead of purging cached queries for the table that was tunes, TuneTable will instead recompile the cached query classes.  The default is RecompileCQ=0, so not specifying this option would provide the default TuneTable behavior.
tune
	new ptr,sampPercent,tabid,tlow,tval,colStats
	set colStats=(val="COLLECT")
	set $$$mtStatementType="TUN"
	if colStats {
		do:'$$check("STATISTICS") skipid("STATS")
		do skip("FOR")
		if $$checkid("TABLE"){
			do ParseIdentifier(.tval,.tlow)
			$$$Tmake(tval,tlow,tabid)
			$$$TSETop(tabid,"tune")
			if callname="tablist" { set mtc(0,0,"tablist",tlow)="" }
			set:info mtc(0,0,"tune priv")=tlow
		} elseif $$checkid("SCHEMA") {
			$$$SSETop(lower,"tune")
			set tabid=lower
			do skip("ID")
		} else {
			new t set t="TABLE or SCHEMA" do error(1) 	
		}
	} else {
		do skip("TABLE")
		do ParseIdentifier(.tval,.tlow)
		$$$Tmake(tval,tlow,tabid)
		$$$TSETop(tabid,"tune")
		if callname="tablist" { set mtc(0,0,"tablist",tlow)="" }
		set:info mtc(0,0,"tune priv")=tlow
	}
	
	for ptr=1:1:4 {
		if ('colStats)&&$$checkid("%KEEP_UP_TO_DATE") { do:$$$tTuneKeepUpToDate(tabid)'="" error(326)  $$$TSETTuneKeepUpToDate(tabid,1)  } 
		if ('colStats)&&$$checkid("%CLEAR_VALUES")    { do:$$$tTuneClearValues(tabid)'="" error(326)   $$$TSETTuneClearValues(tabid,1)   }
		if ('colStats)&&$$checkid("%RECOMPILE_CQ")    { do:$$$tTuneRecompileCQ(tabid)'="" error(326)   $$$TSETTuneRecompileCQ(tabid,1)   }
		if $$checkid("%SAMPLE_PERCENT")  { 
			if $$$tTuneSamplePercent(tabid)'="" { set value="%SAMPLE_PERCENT" do error(326) }
			set sampPercent=value do skip(9)
			if $$checkid("%")||($e(sampPercent,*)="%") { set sampPercent=sampPercent/100 }
			if sampPercent'>0||(sampPercent>1) { new t set t="<Percentage range (0 to 1]",token="<"_sampPercent_">" do error(1) }
			$$$TSETTuneSamplePercent(tabid,sampPercent)
		}
	}
	RETURN
.
	#; LOCK [TABLE] <tablename> IN { SHARE | EXCLUSIVE } MODE [ WAIT <literal-seconds> ]
lock	n tabid,tlow,tval				// DPV3300=
	s $$$mtStatementType="LCK"
	if $$check("TABLE")
	d ParseIdentifier(.tval,.tlow)
	$$$Tmake(tval,tlow,tabid)
	$$$TSETop(tabid,"lock")
	i callname="tablist" s mtc(0,0,"tablist",tlow)=""
	do skip("IN")
	if $$checkid("SHARE") { 
		$$$TSETLockMode(tabid,"s")
		set:info mtc(0,0,"lock priv")=$lb("s",tlow)
	} 
	else { 
		d skipid("EXCLUSIVE") $$$TSETLockMode(tabid,"e")
		set:info mtc(0,0,"lock priv")=$lb("e",tlow)
	}
	do skipid("MODE")
	if $$checkid("WAIT") { $$$TSETLockTimeout(tabid,value) d skip(9) }
	q
.
	#; UNLOCK [TABLE] <tablename> IN { SHARE | EXCLUSIVE } MODE [IMMEDIATE]
unlock	n tabid,tlow,tval				// DPV3300=
	s $$$mtStatementType="ULK"
	if $$check("TABLE")
	d ParseIdentifier(.tval,.tlow)
	$$$Tmake(tval,tlow,tabid)
	$$$TSETop(tabid,"unlock")
	i callname="tablist" s mtc(0,0,"tablist",tlow)=""
	do skip("IN")
	if $$checkid("SHARE") { $$$TSETLockMode(tabid,"s") } else { d skipid("EXCLUSIVE") $$$TSETLockMode(tabid,"e") }
	do skipid("MODE")
	if $$check("IMMEDIATE") { $$$TSETUnlockMode(tabid,"i") }
	q
	
ddl	new fldid,keyid,op,replaceAggregate,tabid,tabidshort,timeseries,tlow,tReplaceView,tval,tChkExists
	if token="ID" {
		if value="VIEW" { set token="VIEW" }
		if val="TRAIN" { set $$$mtStatementType="TMDL" }  // val is set in stat^%qaqpsq1 when TRAIN is parsed
		if val="VALIDATE" { set $$$mtStatementType="VMDL" }
	}
	if $g(%DDLMode)="MySQL",$e($$$mtStatementType,1,2)="AL" {
		if $$checkid("ONLINE"),$$checkid("IGNORE") {}
		elseif $$checkid("OFFLINE"),$$checkid("IGNORE") {}
		elseif $$checkid("IGNORE") {}
	}
	if $$checkid("DATABASE") { 	// CREATE DATABASE, DROP DATABASE, USE DATABASE
		set $e($$$mtStatementType,3)="D"	// CRD or DRD
		goto database
	}
	elseif $$$mtStatementType="USD" { goto database }	// USE <database>
	
	do checkid("TIME") // Optional word
	set timeseries = $$checkid("SERIES") // Is this a timeseries model?
	if $$checkid("MODEL") {  // CREATE MODEL, DROP MODEL
		if $$$mtStatementType="CRE" {
			set $$$mtStatementType="CMDL"
		 	set mt("timeseries", "selected") = timeseries
		}
		elseif $$$mtStatementType="ALT" { set $$$mtStatementType="AMDL" }
		elseif $$$mtStatementType="DRO" { set $$$mtStatementType="DMDL" }
		goto model
	}
.
	if $$checkid("ML") {  // CREATE/ALTER/DROP ML CONFIGURATION
		do skipid("CONFIGURATION")
		if $$$mtStatementType="CRE" { set $$$mtStatementType="CMLCONFIG" }
		elseif $$$mtStatementType="ALT" { set $$$mtStatementType="AMLCONFIG" }
		elseif $$$mtStatementType="DRO" { set $$$mtStatementType="DMLCONFIG" }
		goto mlconfiguration
	}
.
	if $$checkid("SERVER") { // can also optionally be CREATE FOREIGN SERVER, but standard says CREATE SERVER
		if $$$mtStatementType = "CRE" { set $$$mtStatementType="CRSV" }
		elseif $$$mtStatementType = "ALT" { set $$$mtStatementType = "ALSV" }
		elseif $$$mtStatementType = "DRO" { set $$$mtStatementType = "DRSV" }
		do foreignServer()
		RETURN
	}
	
	if $$checkid("FOREIGN") { // CREATE/ALTER/DROP FOREIGN SERVER/TABLE
		if $$checkid("SERVER") {
			if $$$mtStatementType = "CRE" { set $$$mtStatementType="CRSV" }
			elseif $$$mtStatementType = "ALT" { set $$$mtStatementType = "ALSV" }
			elseif $$$mtStatementType = "DRO" { set $$$mtStatementType = "DRSV" }
			do foreignServer()
			RETURN
		}
.
		do skipid("TABLE")
		if $$$mtStatementType = "CRE" { set $$$mtStatementType="CRFT" }
		elseif $$$mtStatementType = "ALT" { set $$$mtStatementType = "ALFT" }
		elseif $$$mtStatementType = "DRO" { set $$$mtStatementType = "DRFT" }
		do foreignTable()
		RETURN
	}
	
	  #;  type - CRT/ALT/DRT, CRV/ALV/DRV, CRI/CRU/DRI, CRR/DRR, CRUS/DRUS, CRF/CRM/CRP/CRQ, DRF/DRM/DRP/DRQ, CRG/DRG
	set $$$mtStatementType=$e($$$mtStatementType,1,2)_$e(token,1,(token="USER")+1)
	if token="ROLE" {
		set:%delid %delid=3
		if $$check("ROLE") { do role }
		set:%delid=3 %delid=1
		QUIT
	}
	
	if $$checkid("VIEW") { set tReplaceView=0 goto view }
.
	if $$checkid("AGGREGATE") {
		set replaceAggregate=0
		set $e($$$mtStatementType,3)="A"	// CRA or DRA
		goto aggregate
	}
.
	if $$checkid("SCHEMA") { // CREATE SCHEMA or DROP SCHEMA or ALTER SCHEMA s DROP FIXED STATISTIC or ALTER SCHEMA s FIX STATISTICS or ALTER SCHEMA s SET RUNTIME IGNOREFIXEDSTATS/SKIPAUTOMATICSTATSCOLLECTION = TRUE/FALSE
		if $$$mtStatementType="ALS" {
			new schema
			set schema=lower
			do skip("ID")
			if $$check("DROP"){
				do checkid("FIXED")
				$$$SSETop(schema,"drop schema stats")
				do:'$$check("STATISTICS") skipid("STATS")
			} elseif value="FIX" {
				do skip("ID")
				$$$SSETop(schema,"fix schema stats")
				do:'$$check("STATISTICS") skipid("STATS")
			} elseif $$check("SET")&&(value="RUNTIME")  {
				d skip("ID")
				$$$SSETop(schema,"set schema stats prop")
				if $lf($lb("IGNOREFIXEDSTATS","SKIPAUTOMATICSTATSCOLLECTION"),value) {
					new prop
					set prop=value
					d skip("ID")
					d skip("=")
					if $$check("TRUE") {
						$$$tSETTableStatsProp(schema,prop,1)
					} elseif $$check("FALSE"){
						$$$tSETTableStatsProp(schema,prop,0)
					} else {
						new t set t="TRUE or FALSE" do error(1)  
					}
				} else {
					new t set t="IGNOREFIXEDSTATS or SKIPAUTOMATICSTATSCOLLECTION" do error(1) 
				}
			}
			RETURN	
		}
		set $e($$$mtStatementType,3)="S" // CRS or DRS
		goto schema
	}
.
		#; Might be CREATE OR REPLACE VIEW...
		#;       or CREATE OR REPLACE AGGREGATE...
		#;       or CREATE OR REPLACE { FUNCTION | PROC[EDURE] | METHOD | QUERY }...
		#;       or CREATE OR REPLACE TRIGGER
		#;       or CREATE OR REPLACE ML CONFIGURATION
	if $$$mtStatementType="CRO",$$check("OR") {
		do skipid("REPLACE")
		if $$checkid("VIEW") { set $$$mtStatementType="CRV",tReplaceView=1 goto view }
		if $$checkid("AGGREGATE") {
			set $e($$$mtStatementType,3)="A"	// CRA or DRA
			set replaceAggregate=1
			goto aggregate
		}
		if $$anyid(" FUNCTION METHOD PROC PROCEDURE QUERY ",.op) {
			set $$$mtStatementType="CR"_$extract(op), tChkExists = 1
			goto procedure
		}
		if $$checkid("TRIGGER") {
			set tChkExists = 1
			set $extract($$$mtStatementType,3)="G"
			goto trigger^%qaqpDDLParser2
		}
		if $$checkid("ML") {
			do skipid("CONFIGURATION")
			set $$$mtStatementType="CMLCONFIG", tChkExists = 1
			goto mlconfiguration
		}
		do error(51)
	}
.
	if $e($$$mtStatementType,1,2)="DR",$$anyid(" FUNCTION METHOD PROC PROCEDURE QUERY ",.op) { set $$$mtStatementType="DR"_$e(op) goto dropproc }
	if $$anyid(" FUNCTION METHOD PROC PROCEDURE QUERY ",.op) { set $$$mtStatementType="CR"_$e(op) goto procedure }
	if $$checkid("STATIC") { do skipid("METHOD") set op="METHOD",$$$mtStatementType="CRM" goto procedure }
	if $$checkid("TRIGGER") {
		set $extract($$$mtStatementType,3) = "G"
		goto:($$$mtStatementType = "CRG") trigger^%qaqpDDLParser2
		goto droptrigger^%qaqpDDLParser2
	}
.
	if token="USER" {
		set:%delid %delid=3
		if $$check("USER") { do user^%qaqpDDLParser2 }
		set:%delid=3 %delid=1
		RETURN
	}
	  #;  Might be DROP INDEX
	if $$$mtStatementType="DRI" { do skipid("INDEX") goto index }
	  #;  Might be CREATE INDEX
	set:($$$mtStatementType="CRU"||($$$mtStatementType="CRB")||($$$mtStatementType="CRD")) $$$mtStatementType="CRI"
	if $$check("GLOBAL") {
		if $$checkid("PRIVATE")	{ d skip("TEMPORARY") s $$$mtStatementType="CRT" n tempTable s tempTable="gp" }	// DPV3139
		else { d skip("TEMPORARY") s $$$mtStatementType="CRT" n tempTable s tempTable="g" }	// DPV2619
	}
	elseIf $$checkid("PRIVATE") { d skip("TEMPORARY") s $$$mtStatementType="CRT" n tempTable s tempTable="l" }	// DPV2619
	if $$$mtStatementType="CRI" {
		#;  idxtype = 0 : regular index
		#;  idxtype = 1 : unique index
		#;  idxtype = 2 : bitmap index
		#;  idxtype = 3 : bitslice index
		#;  idxtype = 4 : bitmapextent
		#;  idxtype = 5 : columnar
		new idxdeferred,idxpartitioned,idxtype
		set idxdeferred=0,idxtype=0,idxpartitioned=0
		if $$check("DEFERRED") { set idxdeferred=1 } 
		if $$checkid("NONPARTITIONED") { set idxpartitioned=-1 } 
		elseif $$checkid("PARTITIONED") { set idxpartitioned=1 } 
		if $$check("UNIQUE") {
			set idxtype=1
			if $$checkid("CLUSTERED") {}
			elseIf $$checkid("NONCLUSTERED") {}
		}
		elseif $$checkid("BITMAP") { set idxtype=2 } 
		elseif $$checkid("BITSLICE") { set idxtype=3 } 
		elseif $$checkid("BITMAPEXTENT") { set idxtype=4 } 
		elseif $$checkid("COLUMNAR") { set idxtype=5 }
		elseif $$checkid("CLUSTERED") {}
		elseif $$checkid("NONCLUSTERED") {}
		do skipid("INDEX")
		goto index
	}
	do:'$$check("TABLE") error(51)
	if $$$mtStatementType'="ALT" {
		new holdvals
		do holdcur^%qaqpsl2(.holdvals)
		if $$checkid("IF") {
			if $$$mtStatementType="CRT" { if $$check("NOT") { do skip("EXISTS") set tChkExists=1 } else { do setold^%qaqpsl2(.holdvals) }}	// CRT
			else { if $$check("EXISTS") { set tChkExists=1 } else { do setold^%qaqpsl2(.holdvals) }}								// DRT
		}
		if $$checkid("%NOJOURN") { 
			set $$$mtKNoJournalFlag($$$mtK)=1
			set:info $li(mtc(0,0,"syspriv"),12)=1
		}
	}
	  #; Handle <owner>.<catalog>.<schema>.<table>
	do ParseIdentifier(.tval,.tlow)
	$$$Tmake(tval,tlow,tabid)
	$$$TSETifexists(tabid,$get(tChkExists))
	set tabidshort=$tr($p(tabid,".",*),$c(2),"_")	// Short table name without '.'s, use for default constraint names
	new tabschema
	set tabschema=$p(tabid,".",1,*-1)				// Table's schema
	goto:$$$mtStatementType="DRT" dropt
	goto:$$$mtStatementType="ALT" altt
	
		#;  <table-def> ::= CREATE TABLE <tabname> ...
	$$$TSETop(tabid,"create")
	$$$TSETTempType(tabid,$g(tempTable))
	if $$check("(") {  ;  ... ( <telem> { , <telem> } )
		// %NOJOURN only supported for CREATE TABLE AS
		if $$$mtKNoJournalFlag($g($$$mtK)) {
			set token="("
			do error2(1, "AS")
		}
		for { do telem quit:'$$check(",") }
		do skip(")")	
	} else {
		$$$TSETop(tabid,"ctas")
		// CREATE TABLE AS originally supported %NOJOURN after the table name, but other commands support it before
		// This is left here for backwards compatibility though CTAS also supports %NOJOURN before tname now
		if $$checkid("%NOJOURN") { 
			set $$$mtKNoJournalFlag($$$mtK)=1
			set:info $li(mtc(0,0,"syspriv"),12)=1
		}
		do skip("AS"), mark
		$$$lexcheckid("WITH") do cte^%qaqpsq1(1) // parse CTE definition that comes at the beginning of the query following AS
		do query^%qaqpsq(0,0,0),order^%qaqpsq1,copyq
	}
	if $g(%DDLMode)="Oracle" {
		For  { 
			If $$anyid(" LOGGING NOLOGGING PCTFREE PCTUSED INITRANS MAXTRANS MONITORING STORAGE TABLESPACE ",.op) {	// DPV2730 (MONITORING)
				Do OraclePhysicalAttributesClause^%qaqpDDLParser2(op)
			}
			ElseIf $$anyid(" PARALLEL NOPARALLEL ",.op) {
				Do OracleParallelClause^%qaqpDDLParser2(op)
			}
			Else {
				d:'$$checkid("CACHE") checkid("NOCACHE") 
				Quit  
			}
		}
	} // Oracle
	If $g(%DDLMode)="Sybase" {
			#; From CREATE TABLE Documentation for Sybase Adaptive Server Enterprise 11.9.2
			#;  [lock {datarows | datapages | allpages }]
			#;  [with { max_rows_per_page = num_rows ,
			#;          exp_row_size = num_bytes ,
			#;          reservepagegap = num_pages } ] 
			#;  [on segment_name]
			#;  [ [ external table ] at pathname ]
		If $$checkid("LOCK") {
			If '$$checkid("DATAROWS") { If '$$checkid("DATAPAGES") { Do skipid("ALLPAGES") } }
		}
		If $$checkid("WITH") {
			For {
				If $$checkid("MAX_ROWS_PER_PAGE") { d skip("="),skip(9) }
				ElseIf $$checkid("EXP_ROW_SIZE") { d skip("="),skip(9) }
				ElseIf $$checkid("RESERVEPAGEGAP") { d skip("="),skip(9) }
				q:'$$check(",")
			}
		}
		If $$check("ON") { i token=$c(1) { d error(1) q  } d skip(token) }
			#;  Not worrying about external table for now
	} // Sybase
	If $g(%DDLMode)="MySQL" {
		For  {
			if $$checkid("TABLESPACE") {		// Items that are of the format <option> <value>
				do lext continue
			}
				#; Items that are of the format <option> [=] <value>
				#; The older TYPE option was synonymous with ENGINE. TYPE was deprecated in MySQL 4.0, and removed in MySQL 5.2. 
				#; When upgrading to MySQL 5.2 or later, you must convert existing applications that rely on TYPE to use ENGINE instead. 
			if $$anyid(" AUTO_INCREMENT AVG_ROW_LENGTH CHARSET CHECKSUM COLLATE COMMENT CONNECTION DELAY_WRITE_KEY ENGINE INSERT_METHOD KEY_BLOCK_SIZE MAX_ROWS MIN_ROWS PACK_KEYS PASSWORD ROW_FORMAT TYPE UNION ",.op) {
				if $$check("=")
				do lext continue
			}
			if $$checkid("DATA") {			// Items that are of the format DATA DICTIONARY [=] <value>
				do skipid("DICTIONARY") if $$check("=")
				do lext continue
			}
			if $$checkid("INDEX") {			// Items that are of the format INDEX DICTIONARY [=] <value>
				do skipid("DICTIONARY") if $$check("=")
				do lext continue
			}
			if $$check("DEFAULT") {
				if $$check("CHARACTER") {
					d skip("SET") if $$check("=")
					d lext continue
				}
				if $$checkid("CHARSET") {
					if $$check("=")
					d lext continue
				}
				if $$check("COLLATE") {
					if $$check("=")
					d lext continue
				}
			}
			if $$check("CHARACTER") {
				d skip("SET") if $$check("=")
				d lext continue
			}
			q	// for loop
		}
	} // MySQL
	
	// Parse <table_option_list>
	do chkShard(2,,2) // JMM1244=
	do tblpart
	new %storagedefault
	if $$check("WITH") {
		for { 
			do tableopt
			quit:'$$check(",")
		}
	}
	if '$d(%storagedefault) {	// WITH STORAGETYPE [=] {ROW | COLUMNAR]} was not specified, so if there is a schema default STORAGETYPE to use
		new sdef
		if $d(^rINDEXSQL("schema",$$$UPPER(tabschema),"settings","STORAGETYPE"),sdef) {	// The schema is defined with a STORAGEDETYPE to use for all new tables
			if $$$UPPER($g(sdef))="ROW" {
				$$$Pmake("STORAGEDEFAULT","STORAGEDEFAULT")
				$$$PSETdefault("STORAGEDEFAULT", "row")
			}
			elseif $$$UPPER($g(sdef))="COLUMNAR" {
				$$$Pmake("STORAGEDEFAULT","STORAGEDEFAULT")
				$$$PSETdefault("STORAGEDEFAULT", "columnar")
			}
			else {} // ^rINDEXSQL("schema",$$$UPPER(tabschema),"settings","STORAGETYPE") is something other than ROW or COLUMNAR, ignore.
		}
	}
	
	// All of these options are no-ops for compatibility with non-standard 3rd party extensions.
	if $$chose(" IN ON ") {	// "IN dbspace" clause is for SYBASE & Informix compatibility
		if token=$c(1) {	// "ON {filegroup | DEFAULT}" clause is for MSSQL Server compatibility
			do error(1)
			quit
		}
		do skip(token)
	}
	// The following are all for Informix compatibility - just parse and ignore...
	if $$checkid("EXTENT") {
		do skipid("SIZE")
		do skip(9)
	}
	if $$check("NEXT") {
		do skipid("SIZE")
		do skip(9)
	}
	if $$check("LOCK"){
		do skipid("MODE")
		if '$$checkid("ROW") {
			do checkid("PAGE")
		}
	} // end of 3rd party compatibility
	
	i token'=$c(1),token'=";" d error(25)	// DPV1915 ";" check
	  #; Check that all fields fully defined.
	new tmpfld, keyfld
	set (fldid,i)="" 
	$$$nextfld(tabid,i,fldid)
	while (i '= "") {
		set keyfld = 0
		if $extract(fldid,1,5)="%key%" {
			set keyfld = 1
			set fldid = $extract(fldid, 6, 50)
		}
		if $data(tmpfld(fldid)) {
			if keyfld { 				// If field already in list and this is a keyfld, delete keyfld
				$$$KillFieldOrderNode(tabid,i) 
				quit
			} elseif tmpfld(fldid) {	// If field already in list and this is not a keyfld and one in list is a keyfld, delete keyfld from field order.	
				$$$KillFieldOrderNode(tabid,tmpfld(fldid))
				quit
			}
		}
		// If field not in list and this is a keyfld, mark it as a keyfld
		set tmpfld(fldid) = $select(keyfld:i, 1:"")
		if $$$datatype(tabid,fldid)="", $$$Dop'="ctas" { do error(86) }
		$$$nextfld(tabid,i,fldid)
	}
quit	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
telem	;Parse table element
		#;  table element - table constraint or column definition
	new CNAME,cname,PNAME,pname s cname="",CNAME=""
		#;  <telem> ::= <uniq> | <prime> | <desig> | <tdesc> | <file> |
		#;              <numr> | <rtn> | <column> | <shard>
		#;  <condef> ::= CONSTRAINT <cname>
.
	if $g(%DDLMode)="MySQL" {
		n iname,INAME,indexid
		s iname="",INAME=""
		if $$check("CONSTRAINT") if token'="UNIQUE",token'="PRIMARY",token'="FOREIGN" s cname=lower,CNAME=value d skip("ID")
		if $$check("UNIQUE") {
			if '$$checkid("KEY"),'$$checkid("INDEX")
			if token="(" {	// No index_name given
				i cname="" s cname=$e(tabidshort,1,20)_"Unique"_$$$GetConstraintCount,CNAME=$$$IDName(cname)
			}
			else {
				s cname=lower,CNAME=value d skip("ID")
			}
			#; *** index_type???
			$$$Cmake(CNAME,cname) $$$CSETtype(CNAME,"UNIQUE") d nukey(tabid,"","U",cname,.keyid)
			#; *** index_options???
			QUIT
		}
		if $$check("PRIMARY") {
			do skipid("KEY")
			#; *** index_type???
			i cname="" s cname=$e(tabidshort,1,20)_"PrimaryKey"_$$$GetConstraintCount,CNAME=$$$IDName(cname)
			$$$Cmake(CNAME,cname) $$$CSETtype(CNAME,"PKEY") d nukey(tabid,"","P",cname,.keyid)
			#; *** index_options???
			QUIT
		}
		if $$checkid("KEY")||($$checkid("INDEX")) {
			if token="(" {	// No index_name given
				i iname="" s iname=$e(tabidshort,1,20)_"Index"_$$$GetConstraintCount,INAME=$$$IDName(iname)
			}
			else {
				s iname=lower,INAME=value d skip("ID")
			}
			#; *** index_type???
			d nuindex(tabid,iname,INAME,.indexid)
			#; *** index_options???
			QUIT
		}
		if $$checkid("FULLTEXT")||($$checkid("SPATIAL")) {
			if $$checkid("KEY")
			if $$checkid("INDEX")
			if token="(" {	// No index_name given
				i iname="" s iname=$e(tabidshort,1,20)_"Index"_$$$GetConstraintCount,INAME=$$$IDName(iname)
			}
			else {
				s iname=lower,INAME=value d skip("ID")
			}
			#; *** index_type???
			d nuindex(tabid,iname,INAME,.indexid,1)
			#; *** index_options???
			QUIT
		}
		#; *** FOREIGN KEY???
	} // MySQL
.
	set:%delid %delid=3
	if $$check("CONSTRAINT") { set cname=lower,CNAME=value do skip("ID") }
	set:%delid=3 %delid=1
		#;  <uniq> ::= [ <condef> ] UNIQUE <flist>
		#;
		#;  For some reason the designers at Informix had their head up their asses when the defined the constraint
		#;  grammar.  They decided to put the CONSTRAINT <conname> clause AFTER! the constraint definition?????
		#;  So if we are running DDL from the Informix^%apiSQL entry point, be aware of this issue.
		#;
	if $$check("UNIQUE") {
		if $$checkid("CLUSTERED") {}    	// MS SQL Server Support / Sybase
		elseif $$checkid("NONCLUSTERED") {}	// MS SQL Server Support / Sybase
		if cname="" { s cname=$e(tabidshort,1,20)_"Unique"_$$$GetConstraintCount,CNAME=$$$IDName(cname) }
		$$$Cmake(CNAME,cname) $$$CSETtype(CNAME,"UNIQUE") d nukey(tabid,"","U",cname,.keyid)
		if $g(%DDLMode)="Informix",$$check("CONSTRAINT") { n C,c f  { s i=$$check("_"),c=lower,C=value d skip("ID") q:'$$check(".")  } $$$KSETconsname(tabid,keyid,C) $$$Crename(CNAME,C) }
		if $g(%DDLMode)="Sybase" {	// DPV3294=
			#;        [with {fillfactor = pct,
			#;               max_rows_per_page = num_rows,}
			#;               reservepagegap = num_pages}]
			#;          [on segment_name]
			#;
			
			If $$check("WITH") { 
				if $$checkid("FILLFACTOR")||($$checkid("MAX_ROWS_PER_PAGE"))||($$checkid("RESERVEPAGEGAP")) { do skip("="),skip(9) }
			}
			if $$check("ON") { if token=$c(1) { d error(1) q  } d skip(token) }
		} // Sybase
		If $g(%DDLMode)="MSSQL" {
			#;          [ 
			#;            WITH FILLFACTOR = fillfactor 
			#;           | WITH ( <index_option> [ , ...n ] ) 
			#;        ]
			#;        [ ON { partition_scheme_name (partition_column_name)
			#;            | filegroup | "default" } ] 
			#;			
			#; <index_option> ::=
			#; { 
			#;     PAD_INDEX = { ON | OFF } 
			#;   | FILLFACTOR = fillfactor 
			#;   | IGNORE_DUP_KEY = { ON | OFF } 
			#;   | STATISTICS_NORECOMPUTE = { ON | OFF } 
			#;   | ALLOW_ROW_LOCKS = { ON | OFF} 
			#;   | ALLOW_PAGE_LOCKS ={ ON | OFF} 
			#; }
			
			If $$check("WITH") { 
				if $$checkid("FILLFACTOR") { do skip("="),skip(9) }
				else {
					d skip("(")
					For  {
						if $$anyid(" PAD_INDEX IGNORE_DUP_KEY STATISTICS_NORECOMPUTE ALLOW_ROW_LOCKS ALLOW_PAGE_LOCKS ",.op) {
							d skip("=") d:'$$check("ON") skipid("OFF")
						}
						elseif $$checkid("FILLFACTOR") { do skip("="),skip(9) }
						else { Quit  }
						q:'$$check(",")
					}
					d skip(")")
				}
			}
			if $$check("ON") { if token=$c(1) { d error(1) q  } d skip(token) }
		} // MSSQL
		RETURN
	} // UNIQUE
.
	#;  <prime> ::= [ <condef> ] PRIMARY KEY <flist>
	If $$check("PRIMARY") {
		d skipid("KEY")
		If $$checkid("CLUSTERED") {}		// MS SQL Server Support
		ElseIf $$checkid("NONCLUSTERED") {}	// MS SQL Server Support
		If cname="" { s cname=$e(tabidshort,1,20)_"PKey"_$$$GetConstraintCount,CNAME=$$$IDName(cname) }
		$$$Cmake(CNAME,cname) $$$CSETtype(CNAME,"PKEY") d nukey(tabid,"","P",cname,.keyid)
		If $g(%DDLMode)="Informix",$$check("CONSTRAINT") {
			n C,c f  { s i=$$check("_"),c=lower,C=value d skip("ID") q:'$$check(".")  } $$$KSETconsname(tabid,keyid,C) $$$Crename(CNAME,C)
		}
		If $g(%DDLMode)="Oracle" {
			d:$$check("USING") skipid("INDEX")
			For  { 
				If $$anyid(" NOSORT LOGGING NOLOGGING PCTFREE INITRANS MAXTRANS STORAGE TABLESPACE ",.op) {
					Do OraclePhysicalAttributesClause^%qaqpDDLParser2(op)
				}
				Else { Quit  }
			}
		} // Oracle
		If $g(%DDLMode)="MSSQL" {
			#;          [ 
			#;            WITH FILLFACTOR = fillfactor 
			#;           | WITH ( <index_option> [ , ...n ] ) 
			#;        ]
			#;        [ ON { partition_scheme_name (partition_column_name)
			#;            | filegroup | "default" } ] 
			#;			
			#; <index_option> ::=
			#; { 
			#;     PAD_INDEX = { ON | OFF } 
			#;   | FILLFACTOR = fillfactor 
			#;   | IGNORE_DUP_KEY = { ON | OFF } 
			#;   | STATISTICS_NORECOMPUTE = { ON | OFF } 
			#;   | ALLOW_ROW_LOCKS = { ON | OFF} 
			#;   | ALLOW_PAGE_LOCKS ={ ON | OFF} 
			#; }
			
			If $$check("WITH") { 
				if $$checkid("FILLFACTOR") { do skip("="),skip(9) }
				else {
					d skip("(")
					For  {
						if $$anyid(" PAD_INDEX IGNORE_DUP_KEY STATISTICS_NORECOMPUTE ALLOW_ROW_LOCKS ALLOW_PAGE_LOCKS ",.op) {
							d skip("=") d:'$$check("ON") skipid("OFF")
						}
						elseif $$checkid("FILLFACTOR") { do skip("="),skip(9) }
						else { Quit  }
						q:'$$check(",")
					}
					d skip(")")
				}
			}
			if $$check("ON") { if token=$c(1) { d error(1) q  } d skip(token) }
		} // MSSQL
		If $g(%DDLMode)="Sybase" {	// DPV3294=
			#;        [with {fillfactor = pct,
			#;               max_rows_per_page = num_rows,}
			#;               reservepagegap = num_pages}]
			#;          [on segment_name]
			#;
			
			If $$check("WITH") { 
				if $$checkid("FILLFACTOR")||($$checkid("MAX_ROWS_PER_PAGE"))||($$checkid("RESERVEPAGEGAP")) { do skip("="),skip(9) }
			}
			if $$check("ON") { if token=$c(1) { d error(1) q  } d skip(token) }
		} // Sybase
		RETURN
	}  // PRIMARY KEY
 
		#;  <desig> ::= [ <condef> ] FOREIGN KEY <flist> <ref>
	if $$check("FOREIGN") {
		do skipid("KEY")
		if cname="" { set cname=$e(tabidshort,1,20)_"FKey"_$$$GetConstraintCount,CNAME=$$$IDName(cname) }
		$$$Cmake(CNAME,cname) $$$CSETtype(CNAME,"FKEY") do nukey(tabid,"","F",cname,.keyid),skip("REFERENCES"),ref(keyid,CNAME)
		if $g(%DDLMode)="Informix",$$check("CONSTRAINT") { new C,c for  { set i=$$check("_"),c=lower,C=value do skip("ID") quit:'$$check(".")  } $$$KSETconsname(tabid,keyid,C) $$$Crename(CNAME,C) }
		RETURN
	}
		#;  Temporarily just parse and discard CHECK constraints
	if $$check("CHECK") {
		set:cname="" cname=tabidshort_"_CHECK"_$$$GetConstraintCount,CNAME=$$$IDName(cname) $$$Cmake(CNAME,cname) d chkparse(CNAME)
		if $g(%DDLMode)="Informix",$$check("CONSTRAINT") { for  { set i=$$check("_"),cname=lower,CNAME=value do skip("ID") quit:'$$check(".") }}
		RETURN
	}
		#;  <tdesc> ::= %DESCRIPTION <const>
	if $$checkid("%DESCRIPTION") {
		do:$$$tdesc(tabid)'="" error(82)
		$$$TSETdesc(tabid,value)
		do skip(9)
		RETURN
	}
		#;  <file> ::= %FILE <gname>
	if $$checkid("%FILE") {
		do:$$$tfile(tabid)'="" error(83) 
		$$$TSETfile(tabid,value)
		do skip(9)
		RETURN
	}
		#;  <numr> ::= %NUMROWS <integer> | %EXTENTSIZE <integer>
	if $$checkid("%NUMROWS") {
		do:$$$tnumrows(tabid)'="" error(84) 
		$$$TSETnumr(tabid,value)
		do skip(9)
		RETURN
	}
	if $$checkid("%EXTENTSIZE") {
		do:$$$tnumrows(tabid)'="" error(84) 
		$$$TSETnumr(tabid,value)
		do skip(9)
		RETURN
	}
		#;  <rtn> ::= %ROUTINE <rname>
	if $$checkid("%ROUTINE") {
		do:$$$troutine(tabid)'="" error(85) 
		$$$TSETrtn(tabid,value)
		do skip(9)
		RETURN
	}
	if $$checkid("%PUBLICROWID") {
		if $$$tpublicrowid(tabid)'="" { set t="<table element>",token="<duplicate %PUBLICROWID specification>" do error(1) }
		$$$TSETpublicrowid(tabid,1)
		RETURN
	}
	if $$checkid("%CLASSPARAMETER") {
		set pname=value	// name of the parameter
		set PNAME=$$$IDName(pname)
		$$$Pmake(PNAME,pname)
		do skip(token)
		if $$check("=")	// optional =
		$$$PSETdefault(PNAME,value)
		do skip(9)
		RETURN
	}
	if $$chkShard(1) RETURN
	#;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
tecdef	; Table Element Column Definition entry point from altt, or fall through from telem above
		#;  Must be a column definition <column> ::= <fname> ...
		#;  returns field handle fldid
	new rwPrefix
	if $g(%DDLMode)="Informix",$d(^%SYS("xsql","informix","RESERVEDWORDPREFIX"),rwPrefix),rwPrefix'="",$$$SQLReservedWordForParsing(value) {
		set value=$$$UPPER(rwPrefix)_value,lower=rwPrefix_lower
	}
	$$$Fmake(tabid,value,lower,fldid) d skip("ID")
	$$$FSETtype(tabid,fldid,$$datyp())
		#;  [ <collate clause> ]
		#;		<collate clause> ::= 	[%]ALPHAUP | 
		#;				[%]EXACT | 
		#;				[%]MINUS | 
		#;				[%]MVR | 
		#;				[%]PLUS | 
		#;				[%]SPACE | 
		#;				[%]SQLSTRING['('<length>')'] | 
		#;				[%]SQLUPPER['('<length>')'] | 
		#;				[%]STRING['('<length>')'] | 
		#;				[%]UPPER | 
		#;				[%]TRUNCATE['('<length>')'] 
		#;				[%]COLLATE['Transform-spec','('<length>')']
		#;  [ %DESCRIPTION <desc> ]
		#;  [ <default clause> ]
		#;		<default clause> ::= DEFAULT <default option>
		#;			<default option> ::= <literal> | NULL | <date time value function> | USER | CURRENT_USER | SESSION_USER | SYSTEM_USER | %MCODE <m expresion>
		#;  [ <character set> ]:: = CHARACTER SET <character set name>
		#;  [ <collation definition> ]:: = COLLATE <collation>
		#;  [ COMPUTECODE ] ::= <compute clause>
		#;  [ COMPUTEONCHANGE ::= ( Field [ , Field ... ] )
		#;  [ TRANSIENT ]
		#;  [ CALCULATED ]
		#;  [ DEFERRED ]
		#;  [ AUTO_INCEMENT ]
		#;  [ ON UPDATE <update value> ]
		#;  [ PRIVATE ]
		#;  <update value> :: = CURRENT_TIMESTAMP |
		#;                      CURRENT_DATE |
		#;                      CURRENT_TIME |
		#;  <compute clause> ::= [ LANGUAGE ] [ <compute-language> ] <compute-code> 
		#;  <compute-language> ::= OBJECTSCRIPT | COS | PYTHON
		#;  <compute-code> ::= '{' <COS-Code> | <Python-Code> '}'
		#;  [ WITH <column_with_clause> ]
		#;		<column_with_clause> ::= STORAGETYPE = COLUMNAR
	
	for  {
		set:%delid %delid=3
		if $$check("CONSTRAINT") { set:%delid=3 %delid=1 set op="CONSTRAINT" do fcon continue }
		set:%delid=3 %delid=1
		quit:'$$anyid(" %ALPHAUP ALPHAUP AUTO_INCREMENT CALCULATED CHARACTER CHECK %COLLATE COLLATE COMPUTECODE COMPUTEONCHANGE DEFAULT DEFERRED %DESCRIPTION %EXACT EXACT IDENTITY %MINUS MINUS %MVR MVR NOT NULL ON %PLUS PLUS PRIMARY PRIVATE REFERENCES %SPACE SPACE %SQLSTRING SQLSTRING %SQLUPPER SQLUPPER %STRING STRING TRANSIENT %TRUNCATE TRUNCATE UNIQUE %UPPER UPPER WITH ",.op)
		if " CHECK IDENTITY NOT NULL PRIMARY REFERENCES UNIQUE "[(" "_op_" ") { do fcon }	// fcon will handle NOT DEFERRED too
		elseif op="AUTO_INCREMENT" {
			if $g(%DDLMode)="MySQL" { $$$FSETtype(tabid,fldid,"%Library.Counter") }
			else { $$$FSETtype(tabid,fldid,"%Library.AutoIncrement") }
		}
			#; Here we handle the optional collation to use for the field.
			#; The COLLATE keyword is optional, and we allow the collation name with or without the '%', which means for the new SQL generic collation %COLLATE, we technically allow COLLATE COLLATE (...), yuch!
			#; First check for collation names without length arguments
		elseif " %ALPHAUP %EXACT %MINUS %MVR %PLUS %SPACE %UPPER ALPHAUP EXACT MINUS MVR PLUS SPACE UPPER "[(" "_op_" ") { $$$FSETcoll(tabid,fldid,op) }
			#; and now collations that support an optional length argument
		elseif $case(op,"%SQLSTRING":1,"%SQLUPPER":1,"%STRING":1,"%TRUNCATE":1,"SQLSTRING":1,"SQLUPPER":1,"STRING":1,"TRUNCATE":1,:0) {
			If $$check("(") { s op=op_"("_value_")"	d skip(9),skip(")") }
			$$$FSETcoll(tabid,fldid,op)
			#; And now the [%]COLLATE collation, being careful about the COLLATE COLLATE(...) quirk!
		} elseif " %COLLATE COLLATE "[(" "_op_" ") {
				If $$check("(") {	// If this is true they are specifying the %COLLATE collation with no COLLATE keyword
					new valueStr
					set valueStr = $$quoter(value) d skip(9)
					if $$check(",") { set valueStr = valueStr_","_value do skip(9) }
					set op=op_"("_valueStr_")"
					do skip(")") 
					$$$FSETcoll(tabid,fldid,op)
				} elseif op="COLLATE" { 	// COLLATE keyword ws specified
					$$$FSETcoll(tabid,fldid,$$collate())
				} else {	// %COLLATE collation was specified with no arguments, I guess this is legal???
					$$$FSETcoll(tabid,fldid,op)
				}
		} elseif op="%DESCRIPTION" { $$$FSETdesc(tabid,fldid,value) do skip(9) }
		elseif op="DEFAULT" { $$$FSETdef(tabid,fldid,$$setdef()) }
		elseif op="CHARACTER" { d skip("SET"),skip("ID") } 	// Parse and ignore CHARACTER SET <charset>
		elseif op="CALCULATED" { $$$FSETcalculated(tabid,fldid,1) }
		elseif op="DEFERRED" { $$$FSETdeferred(tabid,fldid,1) }
		elseif op="TRANSIENT" { $$$FSETtransient(tabid,fldid,1) }
		elseif op="PRIVATE" { $$$FSETprivate(tabid,fldid,1) }
		elseif op="COMPUTEONCHANGE" {
			do skip("(")
			new tComputeOnChange set tComputeOnChange=""
			for  {
				set tComputeOnChange=tComputeOnChange_$lb(value)
				do skip("ID")
				quit:'$$check(",")
			}
			do skip(")")
			$$$FSETcomputeonchange(tabid,fldid,tComputeOnChange)
		} elseif op="COMPUTECODE" {
			if $$$computecode(tabid,fldid)'="" { set t="<column element>",token="<duplicate ComputeCode/ON UPDATE specification>" do error(1) }
			new lang set lang=""
			do requireDevelopmentPrivilege()
			if $$checkid("LANGUAGE") {}
			if $$anyid(" OBJECTSCRIPT COS PYTHON ",.lang) {}
			else { set lang="" }
			if lang="PYTHON" {
				new code
				do ParsePythonCode(.code)
				new codelist set codelist=""
				for i=1:1:$g(code) { set codelist=codelist_$lb(code(i)) }
				$$$FSETcomputecode(tabid,fldid,codelist)
				$$$FSETcomputelanguage(tabid,fldid,"python")
			} else {  // lang was not specified, or was specified as OBJECTSCRIPT
				new cbcnt,COScode,COScode1
				set cbcnt=0
				do ParseCOSCode
				if $g(COScode) {
					set COScode1=""
					for i=1:1:COScode set COScode1=COScode1_$lb(COScode(i))
					$$$FSETcomputecode(tabid,fldid,COScode1)
					$$$FSETcomputelanguage(tabid,fldid,"objectscript")
				}
				kill COScode,COScode1
			}
		} elseif op="ON" {
			if $$$computecode(tabid,fldid)'="" { set t="<column element>",token="<duplicate ComputeCode/ON UPDATE specification>" do error(1) }
			do skip("UPDATE")
			$$$FSETcalculated(tabid,fldid,0)
			$$$FSETtransient(tabid,fldid,0)
			$$$FSETcomputeonchange(tabid,fldid,$lb("%%UPDATE"))
			$$$FSETcomputecode(tabid,fldid,$lb("set {*}=("_$$setupdate()_")"))
		} elseif op="WITH" {
			new dt,storagedefault
			do skipid("STORAGETYPE")
			do skip("=")
			if $$anyid(" COLUMNAR ROW ",.storagedefault)
			set dt=$$$datatype(tabid,fldid)
			if dt["(" { 
					// sometimes the parameter delimiter is $c(1), sometimes "," depending on if an ObjectScript type of SQL type is given
				if dt[$c(1) { set dt=$e(dt,1,*-1)_$c(1)_"STORAGEDEFAULT="_$$$UPPER(storagedefault)_")" }	// *** Need to worry about st alreadt containing s STORAGEDEFAULT?
				else { set dt=$e(dt,1,*-1)_","_"STORAGEDEFAULT="_$$$UPPER(storagedefault)_")" }
			}
			else { set dt=dt_"(STORAGEDEFAULT="_$$$UPPER(storagedefault)_")" }
			$$$FSETtype(tabid,fldid,dt)
		}
	} // for loop
	RETURN  ;--- telem ---
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tableopt	; Parse table_option; This does not handle any dialect except for IRIS
			#;  <table_option> ::= <classparameter>
			#;                   | STORAGETYPE [ = ] <storage_type> -- sets STORAGEDEFAULT parameter
			#;  <storage_type> ::= row | column
	new pname, PNAME
	if $$checkid("%CLASSPARAMETER") {
		set pname=value, PNAME=$$$IDName(pname)
		do:$$$pexists(PNAME) error2(327, "%CLASSPARAMETER " _ PNAME)
		$$$Pmake(PNAME, pname)
		do:(token=$c(1)) error2(1, "IDENTIFIER ('%CLASSPARAMETER')")
		do skip(token)
		do check("=")
		$$$PSETdefault(PNAME, value)
		do skip(9)
		RETURN
	}
	if $$checkid("STORAGETYPE") {
		do:$$$pexists("STORAGEDEFAULT") error2(327, "STORAGETYPE")
		set pname="STORAGEDEFAULT", PNAME=$$$IDName(pname)
		$$$Pmake(PNAME, pname)
		do check("=")
		if $$checkid("ROW") { $$$PSETdefault(PNAME, "") set %storagedefault="row" }
		elseif $$checkid("COLUMNAR") { $$$PSETdefault(PNAME, "columnar") set %storagedefault="columnar" }
		else { do error2(1, "ROW or COLUMNAR") }
		RETURN
	}
	do error2(1, "%CLASSPARAMETER or STORAGETYPE")
	RETURN  ;--- tableopt ---
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fcon	n CNAME,cname  ;  field constraints
.
	#;  <fcon> ::= [ <condef> ] NOT NULL | UNIQUE | PRIMARY KEY | <ref> | CHECK <search condition>
	#;  <condef> ::= CONSTRAINT <cname>
	#;  Informix allows [schema.]constraint-name, maybe others?
	i op="CONSTRAINT" d  q
	. new tlow,tval
	. set:%delid %delid=3
	. f  s i=$$check("_"),tlow=lower,tval=value d skip("ID") q:'$$check(".")
	. set cname=tlow,CNAME=tval
	. set:%delid=3 %delid=1
		#;   For some reason, SQL Server allows DEFAULT specifications through CONSTRAINTS!
	. i $$check("DEFAULT") $$$FSETdef(tabid,fldid,$$setdef()) q
	. $$$Cmake(CNAME,cname) d  q
	.. i $$check("NOT") $$$FSETreq(tabid,fldid,1) d skip("NULL") $$$CSETtype(CNAME,"NOTNULL") $$$CSETinfo(CNAME,fldid) q
	.. i $$check("UNIQUE") d  q
	... i $$checkid("CLUSTERED") i 1          ;   No-op for MS SQL Server support
	... e  i $$checkid("NONCLUSTERED")        ;   No-op for MS SQL Server support
	... i $$$fIdentity(tabid,fldid)=fldid q   ;   Don't create unique constraint for identity column
	... $$$CSETtype(CNAME,"UNIQUE")
	... d nukey(tabid,fldid,"U",cname,.keyid) 
	.. i $$check("PRIMARY") d skipid("KEY") d  q
	... i $$checkid("CLUSTERED") i 1          ;   No-op for MS SQL Server support
	... e  i $$checkid("NONCLUSTERED")        ;   No-op for MS SQL Server support
	... i $$$fIdentity(tabid,fldid)=fldid q   ;   Don't create primary key constraint for identity column
	... $$$CSETtype(CNAME,"PKEY")
	... d nukey(tabid,fldid,"P",cname,.keyid)
	.. i $$check("REFERENCES") $$$CSETtype(CNAME,"FKEY") d nukey(tabid,fldid,"F",cname,.keyid),ref(keyid,CNAME) q
		#;  Temporarily just parse and discard CHECK constraints
	.. i $$check("CHECK") $$$Cmake(CNAME,cname) d chkparse(CNAME) q
	.. d error(81) ;They must have a constraint definition
.
	if op="NULL" { $$$FSETreq(tabid,fldid,-1) QUIT }  ;Field not required - no op
.
		#;  Constraint name not specified, generate one
		#;   <identity clause> ::= IDENTITY [ '(' <seed> [',' <increment> ] ')' [ NOT FOR REPLICATION ] ]
		#;   <seed> ::= <integer constant>      ; Is the value that is used for the very first row loaded into the table.
		#;   <increment> ::= <integer constant> ; Is the incremental value that is added to the identity value of the previous row that was loaded. 
		#;   [ NOT FOR REPLICATION ] is an MS SQL Server extention.  We only support this for parsing purposes.
		#;     MS SQL Server documentation for NOT FOR REPLICATION:
		#;       Indicates that the IDENTITY property should not be enforced when a replication login such as sqlrepl inserts data into the table. 
		#;
	i op="IDENTITY"||(op="AUTO_INCREMENT") d
	. i $$$tIdentity(tabid)'="" d error(308) ; JMM001 *** This is an error, only one per table allowed.
	. $$$FSETIdentity(tabid,fldid) $$$TSETIdentity(tabid,fldid)
	. i $$check("(") d
	.. $$$FSETIdentitySeed(tabid,fldid,value) d skip(9)
	.. i $$check(",") $$$FSETIdentityIncrement(tabid,fldid,value) d skip(9)
	.. d skip(")")
	.. i $$check("NOT") d  	// DPV2560
	... If $$check("NULL") $$$FSETreq(tabid,fldid,1) s cname=tabidshort_"_NOTNULL"_$$$GetConstraintCount,CNAME=$$$IDName(cname) $$$Cmake(CNAME,cname) $$$CSETtype(CNAME,"NOTNULL") $$$CSETinfo(CNAME,fldid) q
	... d skip("FOR"),skipid("REPLICATION")
.
		#;  For some reason the designers at Informix had their head up their asses when the defined the constraint
		#;  grammar.  They decided to put the CONSTRAINT <conname> clause AFTER! the constraint definition?????
		#;  So if we are running DDL from the Informix^%apiSQL entry point, be aware of this issue.
		#;
		#; - NOT NULL Constraint
	if op="NOT" {
		if $$check("DEFERRED") { $$$FSETdeferred(tabid,fldid,0) RETURN }
		$$$FSETreq(tabid,fldid,1)
		do skip("NULL")
		if $g(%DDLMode)="Informix",$$check("CONSTRAINT") {
			for  { set i=$$check("_"),cname=lower,CNAME=value do skip("ID") quit:'$$check(".")  }
		} else {
			set cname=tabidshort_"_NOTNULL"_$$$GetConstraintCount,CNAME=$$$IDName(cname)
		}
		$$$Cmake(CNAME,cname)
		$$$CSETtype(CNAME,"NOTNULL")
		$$$CSETinfo(CNAME,fldid)
		RETURN
	}
.
		#; - UNIQUE Constraint
	if op="UNIQUE" {
		if $$checkid("CLUSTERED") {}					// No-op for MS SQL Server
		elseif $$checkid("NONCLUSTERED") {}				// No-op for MS SQL Server
		if $$$fIdentity(tabid,fldid)=fldid {RETURN }	// Don't create unique constraint for identity column - it is implied
		if $g(%DDLMode)="Informix",$$check("CONSTRAINT") {
			for  { set i=$$check("_"),cname=lower,CNAME=value do skip("ID") quit:'$$check(".") }
		} else  {
			set cname=tabidshort_"_"_fldid_$s($l(tabidshort)<20:"_UNIQUE",1:"_U")_$$$GetConstraintCount,CNAME=$$$IDName(cname)
		}
		$$$Cmake(CNAME,cname) $$$CSETtype(CNAME,"UNIQUE")
		do nukey(tabid,fldid,"U",cname,.keyid)
		RETURN
	}
.
		#; - PRIMARY KEY Constraint
	if op="PRIMARY" {
		do skipid("KEY")
		if $$checkid("CLUSTERED") {}					// No-op for MS SQL Server
		elseif $$checkid("NONCLUSTERED") {}				// No-op for MS SQL Server
		if $$$fIdentity(tabid,fldid)=fldid { RETURN }	// Don't create primary key constraint for identity column
		set cname=tabidshort_"_PKEY"_$$$GetConstraintCount,CNAME=$$$IDName(cname)
		$$$Cmake(CNAME,cname) $$$CSETtype(CNAME,"PKEY") 
		do nukey(tabid,fldid,"P",cname,.keyid)
		if $g(%DDLMode)="Informix",$$check("CONSTRAINT") {
			for  { set i=$$check("_"),cname=lower,CNAME=value do skip("ID") quit:'$$check(".") }
		}
		RETURN
	}
.
		#; - REFERENCE (Foreign Key) Constraint
	i op="REFERENCES" d  QUIT
	. s cname=$e(tabidshort,1,20)_"FKey"_$$$GetConstraintCount,CNAME=$$$IDName(cname)
	. $$$Cmake(CNAME,cname) $$$CSETtype(CNAME,"FKEY")
	. d nukey(tabid,fldid,"F",cname,.keyid),ref(keyid,CNAME)
	. i $g(%DDLMode)="Informix",$$check("CONSTRAINT") n C,c f  { s i=$$check("_"),c=lower,C=value d skip("ID") q:'$$check(".")  } $$$KSETconsname(tabid,keyid,C) $$$Crename(CNAME,C)
.
		#; - CHECK Constraint
		#;  Temporarily just parse and discard CHECK constraints
	i op="CHECK" d  QUIT
	. s cname=$e(tabidshort,1,20)_"Check"_$$$GetConstraintCount,CNAME=$$$IDName(cname)
	. $$$Cmake(CNAME,cname)
	. d chkparse(CNAME)
	. i $g(%DDLMode)="Informix",$$check("CONSTRAINT") d
	.. f  s i=$$check("_"),cname=lower,CNAME=value d skip("ID") q:'$$check(".")
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
chkShard(i,keyword="SHARD",allowWith=0) ; Parse SHARD specification   JMM1152 - add keyword argument JMM1241 - add allowWith argument
			#; <shard> ::= SHARD [ KEY ( <field> { , <field> } ) [ COSHARD [ WITH ] ( <table> ) ]]
	new requireKey,t
	if $$checkid(keyword) {	// DPV4623=  JMM1152=
		if $$$tShard(tabid)'="" {
			if (i = 1) {
				set t="<table element>", token="<duplicate SHARD specification>"
				do error(1)
			} elseif (i = 2){
				do error2(327,"SHARD")
			}
			RETURN 1 // so telem doesn't fall through to tecdef
		}
		$$$TSETShard(tabid,1)
		// In "ALTER TABLE t CONVERT SHARD", optional keyword WITH is allowed between SHARD[ED} and KEY, and
		// if specified, must be followed by KEY.
		// allowWith=1 when called from ALTER TABLE t CONVERT SHARD.
		// allowWith=2 when called from CREATE TABLE, in context where next token could be WITH, as part of 
		// "WITH STORAGETYPE=...".
		// allowWith=0 when called from CREATE TABLE, in context where next token cannot be WITH.
		if allowWith<2 && $$checkid("WITH") { // JMM1241+  JMM1244=
			if allowWith {
				set requireKey=1
			}
			else {
				set t="KEY", token="WITH"
				do error(1)
			}
		} 
		else {
			set requireKey=0
		} // JMM1241-
		if $$checkid("KEY") {
			new flist set flist=""
			do skip("(")
			for  {
				$$$Fgetid(tabid,value,fldid,1)
				set flist=flist_fldid d skip("ID")
				quit:'$$check(",")
				set flist=flist_","
			}
			do skip(")")
			$$$TSETShardKey(tabid,flist)
			if $$checkid("COSHARD") {
				new paren set paren=0
				if $$check("WITH")
				if $$check("(") { set paren=1 }
				do ParseIdentifier(.tval)
					#;  Tgetid() returns referenced table handle tref
				$$$Tgetid(tval,tref)
				$$$TSETShardReference(tabid,tref)
				do:paren skip(")")
			}
		}
		elseif requireKey { // JMM1241+
			set t="KEY"
			do error(1)
		} // JMM1241-
		RETURN 1 // so telem doesn't fall through to tecdef
	}
	RETURN 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tblpart  ; Parse table PARTITION option
	#; <partition option> ::= PARTITION [OFF] |
	#;                        PARTITION BY <partition specification list>
	#; <partition specification list> ::= <partition specification> [ ,<partition specification> ]
	;  in the initial release the PARTITION is OFF by default
	;  when default value changes to ON, the OFF in the syntax above should not be optional
.
	new t,ps
	if $$check("PARTITION") {
		if $$checkid("OFF") { QUIT
		}
		elseif $$checkid("BY") {
			$$$TSETPartition(tabid,1)
			for ps=1:1 {
				do partspec
				quit:'$$check(",")
			}
		}
		else {
			;  in the initial release the PARTITION is OFF by default
			;  when default value changes to ON, enable the error message below
			$$$TSETPartition(tabid,1)
			;  set t="<PARTITION option>"
			;  do error(1)
		}
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
partspec  ; Parse table PARTITION specification
	#; <partition specification> ::= RANGE ( <field> ) INTERVAL <positive integer> [ <datetime interval> ] | 
	#;                               HASH ( <field> ) IN <positive integer> PARTITIONS | 
	#;                               LIST ( <field> )
	#; <datetime interval> ::= YEAR[S] | MONTH[S] | DAY[S] | HOUR[S] | MINUTE[S]
	new t,num,dt
	if $$checkid("RANGE") {
		$$$TSETPartitionType(tabid,ps,"RANGE")
		do skip("(")
		$$$TSETPartitionField(tabid,ps,value)
		do skip("ID")
		do skip(")")
		if $$checkid("INTERVAL") {
			$$$TSETPartitionValue(tabid,ps,value)
			do skip(9)
			if $$anyid(" YEAR YEARS MONTH MONTHS DAY DAYS HOUR HOURS MINUTE MINUTES ",.dt) {
				$$$TSETPartitionDTInterval(tabid,ps,dt)
			}
		}
		else {
			set t="<PARTITION INTERVAL>"
			do error(1)		
		}
		QUIT
	}
	elseif $$checkid("HASH") {
		$$$TSETPartitionType(tabid,ps,"HASH")
		do skip("(")
		$$$TSETPartitionField(tabid,ps,value)
		do skip("ID")
		do skip(")")
		if $$checkid("IN") {
			$$$TSETPartitionValue(tabid,ps,value)
			$$$TSETPartitionDTInterval(tabid,ps,"PARTITIONS")
			do skip(9)
			if '$$checkid("PARTITIONS") {
				set t="<IN n PARTITIONS>"
				do error(1)		
			}
		}
		else {
			set t="<IN n PARTITIONS>"
			do error(1)		
		}
		QUIT
	}
	elseif $$checkid("LIST") {
		$$$TSETPartitionType(tabid,ps,"LIST")
		do skip("(")
		$$$TSETPartitionField(tabid,ps,value)
		do skip("ID")
		do skip(")")
		QUIT
	}
	else {
		set t="<PARTITION specification>"
		do error(1)
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
chkNonSharded(i) ; Parse NONSHARDED specification  JMM1152
	new t
	if $$checkid("NONSHARDED") {
		if $$$tShard(tabid)'="" {
			if (i = 1) {
				set t="<table element>", token="<duplicate SHARD specification>"
				do error(1)
			} elseif (i = 2){
				do error2(327,"SHARD")
			}
			RETURN 1 // so telem doesn't fall through to tecdef
		}
		$$$TSETShard(tabid,-1)
		RETURN 1
	}
	RETURN 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
chkDefer() ; Parse NONSHARDED specification  JMM1152
	new t
	if $$checkid("DEFER") {
		$$$TSETConvertDefer(tabid,1)
		RETURN 1
	}
	RETURN 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
chkImmediate() ; Parse NONSHARDED specification  JMM1152
	new t
	if $$checkid("IMMEDIATE") {
		$$$TSETConvertDefer(tabid,0)
		RETURN 1
	}
	RETURN 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 
chkparse(CNAME) ; Parse CHECK CONSTRAINT
	$$$CSETtype(CNAME,"CHECK_COMPLEX")  ; default
	new check1,check2,fldref,plev
	set check1="",check2="",fldref="",plev=1
	do skip("(")
	for  {
		set:token="(" plev=plev+1
		set:token=")" plev=plev-1
		quit:token=")"&(plev=0)
		if token="ID",value'="LENGTH" { $$$Fgetid(tabid,value,fldref,1) }
		if token=9 { set fldref=value set:fldref'=+fldref fldref="'"_fldref_"'" }
		if token'="ID",token'=9 { set fldref=token }
		set check1=check1_token_" ",check2=check2_fldref_" "
		do skip(token)
	}
	do skip(")")
	set check1=$e(check1,1,*-1),check2=$e(check2,1,*-1)
	if check1="ID IS NOT NULL" { $$$CSETtype(CNAME,"CHECK_NOTNULL") $$$CSETinfo(CNAME,$p(check2," ")) $$$FSETreq(tabid,$p(check2," "),1) quit } 
	set t="<table element> or <field constraint>",token="CHECK" do error(1)
	$$$CSETinfo(CNAME,check2)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ref(keyid,CNAME) ;  <ref> ::= REFERENCES <tname> [ ( <fname> { , <fname> } ) ]
	#;  [ MATCH <mtype> ] [ <onup> [ <ondel> ] | <ondel> [ <onup> ] ] [ NOCHECK ]
	new kref, tref  ;  referenced table handle and referenced key handle
	#; Handle <owner>.<catalog>.<schema>.<table>
	do ParseIdentifier(.tval)
	#;  Tgetid() returns referenced table handle tref
	$$$Tgetid(tval,tref) $$$KSETrtab(tabid,keyid,tref)
	if $data(CNAME) $$$CSETinfoFKEYRefTab(CNAME,tref)
	If token="(" {	//  process the referenced key
		do nukey(tref,"","R",$g(cname),.kref)
		  #;  referencing key and referenced key must be the same size
		if ($$$ksize(tabid,keyid) '= $$$ksize(tref,kref)) do error(79)
		$$$KSETrkey(tabid,keyid,kref)
	}
	#;  <mtype> ::= FULL | PARTIAL
	if $$check("MATCH") {
		$$$KSETmatch(tabid,keyid,value)
		do:'$$check("FULL") skip("PARTIAL")
	}
	#;  [ ON UPDATE <reftrig> | ON DELETE <reftrig> ]
	if $$check("ON") {
		n refop, refact
		s refop = value
		do:'$$check("UPDATE") skip("DELETE")
		#;  <reftrig> ::= CASCADE | SET NULL | SET DEFAULT | NO ACTION
		if $$check("NO") {
			do skipid("ACTION")
		} else {
			set refact = value
			if '$$check("CASCADE") {
				do skip("SET")
				set refact = "SET " _ value
				do:'$$check("NULL") skip("DEFAULT")
			}
			if (refop="UPDATE") $$$CSETinfoFKEYRAUpdate(CNAME,refact)
			if (refop="DELETE") $$$CSETinfoFKEYRADelete(CNAME,refact)
		}
		QUIT:'$$check("ON")
		#; One more time...
		new refop2
		set refop2 = value
		do skip($select(refop="UPDATE":"DELETE",1:"UPDATE"))
		if $$check("NO") {
			do skipid("ACTION")
			QUIT
		}
		set refact = value
		if '$$check("CASCADE") {
			do skip("SET")
			set refact = "SET " _ value
			do:'$$check("NULL") skip("DEFAULT")
		}
		if (refop2="UPDATE") $$$CSETinfoFKEYRAUpdate(CNAME,refact)
		if (refop2="DELETE") $$$CSETinfoFKEYRADelete(CNAME,refact)
	}
	$$$CSETinfoFKEYNoCheck(CNAME,$$checkid("NOCHECK"))
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nuindex(tabid,iname,INAME,indexid,parseOnly=0)
	#;  This is only called if %DDLMode="MySQL"!!!
	#;  make a new index entry, return .indexid
	#;  flist is either a field handle, if it's <fcon> within <column>,
	#;      or it is NULL, if it's a table constraint <prime>, in which
	#;      case we should go ahead and read the field list!
	n field,fldid,flist,i s flist="",indexid=""
	d skip("(")
	f  {
		$$$Fgetid(tabid,value,fldid,1)
		s flist=flist_fldid d skip("ID")
		if $$check("(") d skip(9),skip(")")	// s indexid=-1 q  	// We do not support indexes on %STARTSWITH (column), parse and ignore
		if '$$check("ASC"),$$check("DESC") {}	// ignore ASC | DESC clause
		q:'$$check(",")  s flist=flist_","
	}
	QUIT:indexid=-1
	d skip(")")
	QUIT:parseOnly 
	$$$Imake(INAME,iname,indexid)           ;Create Index Handle
	$$$ISETunique(indexid,0)		;Set index's unique flag
	f i=1:1 s field=$p(flist,",",i) q:field=""  $$$ISETfield(indexid,i,field)
	QUIT
.
nukey(tabid,flist,ktype,cname,keyid) ;  make a new key entry, return .keyid
	#;  flist is either a field handle, if it's <fcon> within <column>,
	#;      or it is NULL, if it's a table constraint <prime>, in which
	#;      case we should go ahead and read the field list!
	d:flist="" flist
	i ktype="R" $$$CSETinfoFKEYRefFlds(CNAME,flist)
	e  i ktype'="F" $$$CSETinfo(CNAME,flist)
	e  $$$CSETinfoFKEYFlds(CNAME,flist)
	$$$Kmake(tabid,flist,ktype,cname,keyid)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
flist	;  sets  flist = fldid { , fldid }
	n fldid  ;  <flist> ::= ( <fname> { , <fname> } )
	i $$check("(") n hasparen s hasparen=1
	if flist="", $$$Ctype(CNAME)="FKEY", $$checkid("%ID") {
		if $$check(",") { set token="reserved word %ID" do error2(1,"ID") }
	} else {
		f  {
			$$$Fgetid(tabid,value,fldid,1)
			s flist=flist_fldid d skip("ID")
			do:$g(%DDLMode)="MySQL"&&($$check("(")) skip(9),skip(")")	// We do not support indexes on %STARTSWITH (column), parse and ignore
			if $g(%DDLMode)="MSSQL",'$$check("ASC"),$$check("DESC") {}	// ignore ASC | DESC clause for MSSQLServer
			q:'$$check(",")  s flist=flist_","
		}
	}
	i '$g(hasparen),token="(" s flist="" g flist
	i $g(hasparen) d skip(")")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
datyp(fromConvert=0, returnDatatype=0, &isStreamType=0,&paramsSpecified=0,doubleQuotes=1) ;  Parse the datatype
	#;  These are the datatypes we support:
	#;
	#; CHARACTER TYPES:
	#;     CHAR [ (max-length) ]
	#;     | CHARACTER [ (max-length) ]
	#;     | CHARACTER VARYING ( max-length )
	#;     | CHAR VARYING ( max-length )
	#;     | LONGVARCHAR  [ ( max-length ) ]
	#;     | LONG VARCHAR  [ ( max-length ) ]
	#;     | LONG
	#;     | NATIONAL CHAR [ (max-length) ]
	#;     | NATIONAL CHARACTER [ (max-length) ]
	#;     | NATIONAL CHARACTER VARYING  ( max-length )
	#;     | NATIONAL VARCHAR  ( max-length )
	#;     | NCHAR ( max-length )
	#;     | NVARCHAR ( max-length [, reserve ] )
	#;     | NTEXT
	#;     | TEXT
	#;     | VARCHAR ( max-length [, reserve ] )
	#;     | VARCHAR2 ( max-length )
	#;
	#;    Descriptions:
	#;       CHARACTER, CHAR, NCHAR:  
	#;                  Maps to IRIS as %String(MAXLEN='max-length')
	#;                  'max-length' is optional, defaults to 1
	#;                  IRIS does not pad spaces in data to keep data length
	#;                   equal to 'max-length' (unlike SQL Standard).
	#;       CHARACTER VARYING, CHAR VARYING, NVARCHAR, VARCHAR, VARCHAR2:
	#;                  Maps to IRIS as %String(MAXLEN='max-length')
	#;                  'max-length' is required.
	#;                  VARCHAR2 is for Oracle compatibility.
	#;                  NVARCHAR is for MS SQL Server compatibility
	#;                  The optional reserve parameter for VARCHAR and
	#;                   NVARCHAR is for Informix compatibility
	#;       LONGVARCHAR, LONG VARCHAR, LONG, TEXT:
	#;                  Maps to IRIS as CharacterStream <field>
	#;                  'max-length' is ignored.
	#;                  LONG VARCHAR is for Sybase compatibility.
	#;                  LONG is for Oracle compatibility.
	#;                  NTEXT, TEXT is for MS SQL Server compatibility.
	#;
	#; NUMERIC TYPES:
	#;     INTEGER
	#;     | INT
	#;     | SMALLINT
	#;     | TINYINT
	#;     | NUMERIC [ (precision [, scale ] ) ]
	#;     | NUMBER [ (precision [, scale ] ) ]
	#;     | DECIMAL [ (precision [, scale ] ) ]
	#;     | DEC [ (precision [, scale ] ) ]
	#;     | FLOAT [ ( precision ) ]
	#;     | REAL
	#;     | DOUBLE
	#;     | DOUBLE PRECISION
	#;
	#;    Descriptions:
	#;       INTEGER, INT:
	#;                  Maps to IRIS as %Integer(MAXVAL=2147483647,MINVAL=-2147483648)
	#;       SMALLINT:
	#;                  Maps to IRIS as %SmallInt(MAXVAL=32767,MINVAL=-32768)
	#;       TINYINT:
	#;                  Maps to IRIS as %SmallInt(MAXVAL=127,MINVAL=-128)
	#;       DECIMAL, DEC, NUMERIC, NUMBER
	#;                  Maps to IRIS as %Numeric, possibly with MAXVAL and MINVAL
	#;                   parameters depending on any precision and scale
	#;                  DOUBLE is supported for Sybase compatibility
	#;                  NUMBER is for Oracle compatibility
	#;       REAL, DOUBLE, DOUBLE PRECISION
	#;                  Maps to IRIS as %Float
	#;                  DOUBLE is supported for Sybase compatibility
	#;       FLOAT
	#;                  Maps to IRIS as %Float, possibly with MAXVAL and MINVAL
	#;                   parameters depending on any precision.
	#;
	#; DATE and TIME TYPES:
	#;     DATE
	#;     | TIME
	#;     | TIMESTAMP
	#;
	#;    Descriptions:
	#;       DATE
	#;                  Maps to IRIS as %Date
	#;       TIME
	#;                  Maps to IRIS as %Time
	#;       TIMESTAMP
	#;                  Maps to IRIS as %Timestamp
	#;
	#; BINARY TYPES:
	#;     BINARY ( max-length )
	#;     | VARBINARY ( max-length )
	#;     | LONGVARBINARY [ ( max-length ) ]
	#;     | RAW ( max-length )
	#;     | IMAGE
	#;
	#;    Descriptions:
	#;       BINARY
	#;                  Maps to IRIS as %Binary(MAXLEN=max-length)
	#;                  BINARY is for MS SQL Server compatibility
	#;       VARBINARY
	#;                  Maps to IRIS as %Binary(MAXLEN=max-length)
	#;                  VARBINARY is for MS SQL Server compatibility
	#;       LONGVARBINARY, IMAGE
	#;                  Maps to IRIS as BinaryStream <field>, max-length is ignored
	#;                  IMAGE is for MS SQL Server compatibility
	#;       RAW
	#;                  Maps to IRIS as %Binary(MAXLEN=max-length)
	#;                  RAW is for Oracle compatibility
	#;----------------------------------------------------------------------------------------
	n %dummy,fromConvertLen30,len,%parseDatatypeParams s len="",fromConvertLen30=0
	i token="(" d skip("(") d  s token="CHAR"
	. f  d skip("#") q:'$$check("#")
	n cachetype,datatype,exacttype,i,params,plst,savedatatype 
		#; Datatype is optional for IDENTITY column.  If we've already encountered the token "IDENTITY",
		#; set datatype to INTEGER and don't skip this token.
	s exacttype=lower
	set isStreamType = 0
	if value="IDENTITY" { s datatype="BIGINT" } 
	elseif token=$c(1) { d error(1) q  } 
	else { s datatype=value d skip(token) }
		#;  Handle datatypes with package specified
	f  q:'$$check(".")  s datatype=datatype_"."_value,exacttype=exacttype_"."_lower i token=$c(1) { d error(1) q  } d skip(token)
		#;  Some datatypes are more than one 'word'
	i datatype="BINARY" s fromConvertLen30=1 i $$check("VARYING") s datatype="BINARY VARYING"
	i datatype="CHAR" s fromConvertLen30=1 i $$check("VARYING") s datatype="CHAR VARYING"
	i datatype="CHARACTER" s fromConvertLen30=1 i $$check("VARYING") s datatype="CHARACTER VARYING"
	i datatype="DATETIME",$g(%DDLMode)="Informix" {
		n largeQualifier,smallQualifier s largeQualifier=""
		if $$checkid("YEAR") {
			s largeQualifier="YEAR" d skip("TO")
			if $$checkid("DAY") { s datatype="DATE" GOTO datypContinue2 }
			if $$anyid(" YEAR MONTH HOUR MINUTE SECOND FRACTION ",.smallQualifier)
		}
		elseif $$checkid("HOUR") {
			s largeQualifier="HOUR" d skip("TO")
			if $$checkid("SECOND") { s datatype="TIME" GOTO datypContinue2 }
			if $$anyid(" HOUR MINUTE FRACTION ",.smallQualifier)
		}
		if largeQualifier="" {
			if $$checkid("MONTH")        { s largeQualifier="MONTH" d skip("TO") if $$anyid(" MONTH DAY HOUR MINUTE SECOND FRACTION ",.smallQualifier) }
			elseif $$checkid("DAY")      { s largeQualifier="DAY" d skip("TO") if $$anyid(" DAY HOUR MINUTE SECOND FRACTION ",.smallQualifier) }
			elseif $$checkid("MINUTE")   { s largeQualifier="MINUTE" d skip("TO") if $$anyid(" MINUTE SECOND FRACTION ",.smallQualifier) }
			elseif $$checkid("SECOND")   { s largeQualifier="SECOND" d skip("TO") if $$anyid(" SECOND FRACTION ",.smallQualifier) }
			elseif $$checkid("FRACTION") { s largeQualifier="FRACTION" d skip("TO") d skipid("FRACTION") s smallQualifier="FRACTION" }
		}
			#; TODO, handle FRACTION(n)
		if largeQualifier'="" {
			s datatype="%Library.InformixTimeStamp",exacttype="%Library.InformixTimeStamp",plst="LARGEQUAL="_largeQualifier_$$$ParmDel_"SMALLQUAL="_smallQualifier
			GOTO datypContinue
		}
	}
	i datatype="DOUBLE" i $$checkid("PRECISION") s datatype="DOUBLE PRECISION"
	i datatype="LONG" d
	. i $$checkid("BINARY") s datatype="LONG BINARY" q
	. i $$check("VARCHAR") s datatype="LONG VARCHAR" q
	. i $$checkid("RAW") s datatype="LONG RAW"
	i datatype="NATIONAL" {
		s fromConvertLen30=1
		i $$check("CHAR") s datatype="NATIONAL CHAR" i $$check("VARYING") s datatype="NATIONAL CHAR VARYING"
		i $$check("CHARACTER") s datatype="NATIONAL CHARACTER" i $$check("VARYING") s datatype="NATIONAL CHARACTER VARYING"
		i $$check("VARCHAR") s datatype="NATIONAL VARCHAR"
	}
	s:'fromConvertLen30 fromConvertLen30=$Case(datatype,"VARCHAR":1,"NCHAR":1,"NVARCHAR":1,"VARBINARY":1,:0)
	// VECTOR or VECTOR(type, [length])
	// type is a keyword (identifier or reserved word, no literals). length is an integer
	if datatype="VECTOR" {
		set plst = ""
		if $$check("(") { // allows but doesn't require params
			// NB: value is always upper case
			set plst = value
			if ",DECIMAL,DOUBLE,FLOAT,INT,INTEGER,"[(","_value_",") { // these are reserved words
				do skip(token)
			} elseif value="STRING" {     //  condition when we intro timestamp: ",TIMESTAMP,STRING,"[(","_value_","){ // just IDs, not reserved
				do skip("ID")
			} else {
				new reason 
				set reason = $$$Text("Vector type must be one of DOUBLE, DECIMAL, FLOAT, INT, INTEGER, STRING", "%SQL.Parser")
				do error(262) // only allow certain datatypes for vector type
			}
			if $$check(",") {
				if '$ISVALIDNUM(value,,1,10000) || (value[".") { // MJG205
					new reason 
					set reason = $$$Text("Vector length must be an integer between 1 and 10000", "%SQL.Parser")
					do error(262)
				}
				set plst = plst_$$$ParmDel_value
				do skip(9)
			}
			do skip(")")
		}
		set paramsSpecified = plst
		GOTO datypContinue
	}
	
	// For the parser, make sure we allow things like DATATYPE(SELECTIVITY=100%) without quotes.
	// For the preparser we'll make use of %mmmNo28Check instead of %parseDatatypeParams
	set %parseDatatypeParams = 1
		#;  Get a list of any parameters
	set plst="",paramsSpecified=""
	if $$check("(") {
		new pcnt,savedelid
			#; Don't treat any "..." strings as delimited identifiers in type parameters, this avoids issues if parameters have illegal characters for delimited ids
		set pcnt=0,savedelid=%delid,%delid=0
		For  {
			i token="(" d skip("(") s pcnt=pcnt+1 continue
			i token=")",pcnt d skip(")") s pcnt=pcnt-1 continue
			q:token=")"||(token=$c(1))
			s plst=plst_$s(token=",":$$$ParmDel,token="=":"=",token="-":"-",1:value) 
			d skip(token)
		}
		do skip(")")
		set paramsSpecified=plst
		set %delid=savedelid
	}
	ElseIf fromConvert,fromConvertLen30 { set plst=30 }
	set %parseDatatypeParams = 0
datypContinue
	if plst["=" {
		set plst=$$strrep(plst,$$$ParmDel,$c(1),1)
		set plst=$replace(plst,$c(0),"""""")
		set isStreamType = ($$$comClassKeyGet(exacttype,$$$cCLASSclasstype)=$$$cCLASSCLASSTYPESTREAM)
		set cachetype=exacttype_"("_plst_")"
		set:(cachetype[""""&&doubleQuotes) cachetype=$$qdouble(cachetype)
		QUIT cachetype
	}
	i plst'="" d
	. f i=1:1:$l(plst,$$$ParmDel) s params(i)=$p(plst,$$$ParmDel,i)
	. s params=i
		#;  First see if there is a datatype with this exact parameter
	s savedatatype=datatype
	i $d(params) s datatype=datatype_"(" f i=1:1:params s datatype=datatype_params(i)_","
	i $d(params) s datatype=$e(datatype,1,*-1)_")"
	//set:datatype="VARCHAR(MAX)" plst="",datatype="LONGVARCHAR"
	//set:datatype="NVARCHAR(MAX)" plst="",datatype="LONGVARCHAR"
		#;  Either no params or an exact match on params, is there a match?  If so, use it
	set cachetype=$$$GetSysDatatypes(datatype) 
	set:cachetype="" cachetype=$$$GetUserDatatypes(datatype)
	if cachetype'="" { 
		set isStreamType = ($$$comClassKeyGet(cachetype,$$$cCLASSclasstype)=$$$cCLASSCLASSTYPESTREAM)
		QUIT:returnDatatype datatype
		set:(cachetype[""""&&doubleQuotes) cachetype=$$qdouble(cachetype) QUIT cachetype
	}
		#;  Must be using paramaterized parameters, or user defined/cache system type not in mapping table
	s datatype=savedatatype
	i $d(params) s datatype=datatype_"(" f i=1:1:params s datatype=datatype_"%"_i_","
	i $d(params) s datatype=$e(datatype,1,*-1)_")"
		#;  Now we have a datatype that might match an entry in the datatype mapping table
datypContinue2
	set cachetype=$$$GetSysDatatypes(datatype)
	set:cachetype="" cachetype=$$$GetUserDatatypes(datatype)
	if cachetype'="" {
		set isStreamType = ($$$comClassKeyGet(cachetype,$$$cCLASSclasstype)=$$$cCLASSCLASSTYPESTREAM)
		if returnDatatype {
			if $data(params) {
				for i=1:1:params { set datatype=$replace(datatype,"%"_i,$case(params(i),$c(0):"""""",:$s(params(i)'[",":params(i),1:$$quoter^%apiSQL(params(i))))) }
			}
			QUIT datatype
		}
		If $d(params) {
			for i=1:1:params { set cachetype=$replace(cachetype,"%"_i,$case(params(i),$c(0):"""""",:$s(params(i)'[",":params(i),1:$$quoter^%apiSQL(params(i))))) }
			i cachetype["<|'" n %mmmcall,%mmmval f  q:cachetype'["<|'"  s %mmmcall="s %mmmval="_$p($p(cachetype,"<|'",2),"'|>") x %mmmcall s cachetype=$replace(cachetype,"<|'"_$p(%mmmcall,"=",2,*)_"'|>",%mmmval)
		}
	}
	elseif savedatatype="ENUM",$g(%DDLMode)="MySQL" {
		n enums f i=1:1:params s $p(enums,",",i)=params(i)
		s cachetype="%Library.EnumString(VALUELIST="","_enums_""")"
	}
	elseif savedatatype="SET",$g(%DDLMode)="MySQL" {
		#;n enums f i=1:1:params s $p(enums,",",i)=params(i)
		s cachetype="%Library.String"
	}
	else { 	// must be user defined type not in the mapping table.
		if $e(exacttype)="%",exacttype'["." { set exacttype = "%Library."_$e(exacttype,2,*) }
		set cachetype=exacttype
	}
	
	if $g(%DDLMode)="MySQL" {
		if $$checkid("UNSIGNED") {
			if $$$LOWER(exacttype)="tinyint" { s cachetype=$replace(cachetype,"MINVAL=-8388608","MINVAL=0"),cachetype=$replace(cachetype,"MAXVAL=8388607","MAXVAL=16777215") }
			if $$$LOWER(exacttype)="mediumint" { s cachetype=$replace(cachetype,"MINVAL=-8388608","MINVAL=0"),cachetype=$replace(cachetype,"MAXVAL=8388607","MAXVAL=16777215") }
		}
	}
		#;  Now we set the field's datatype information
	s:(cachetype[""""&&doubleQuotes) cachetype=$$qdouble(cachetype)
	RETURN cachetype
.
GetDatatype(sqltype, &isStreamType=0,doubleQuotes=1) ;
		#; This API can be called with an SQL datatype specification and we will parse it (just like through DDL) and look up the IRIS type name and return it.
	new begline,begtoken,c,%delid,endline,endtoken,f,fsave,%inMLComment,indexline,lineprev,lower,mask,more,p,pprev,prevtoken,sql,token,value,%context
	set lower=$p(sqltype,"("),(token,value)=$$$UPPER(lower),f=1,p=$l(token)+1,more=0,mask=$$MASK(sqltype)_$c(1),sql=sqltype,%context=$system.Context.SQLCompile(),%delid=%context.DelimitedIdentifiers
	QUIT $$datyp(sqltype,,.isStreamType,,doubleQuotes)
	
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dropt	;  <drop-table> ::= DROP TABLE [ IF EXISTS ] [ %NOJOURN ] <tabname> <drop-behave>
	$$$TSETop(tabid,"drop")
	#;  <drop-behave> ::= [ RESTRICT | CASCADE ] [ %DELDATA | %NODELDATA ]
	i $$chose(" RESTRICT CASCADE ",.op) $$$TSETbehave(tabid,op)
	i $$chose(" %DELDATA %NODELDATA ",.op) $$$TSETdeldata(tabid,op)
	i token'=$c(1) d error(25)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setupdate()   // Handle setting the value for ON UPDATE <...>
	#; <update clause>
	#; <update clause> ::= ON UPDATE <update option>
	#; <update option> ::= <literal> 
	#;                      | NULL 
	#;                      | <date time value function> 
	#;                      | <user value>
	#; <date time value function> ::= CURRENT_DATE | CURRENT_TIME[(precision)] | CURRENT_TIMESTAMP[(precision)] | GETDATE([prec]) | GETUTCDATE([prec]) | SYSDATE
	#; <user value> ::= USER | CURRENT_USER | SESSION_USER | SYSTEM_USER
	#;
	
	new prec,updatevalue
	
	if $$check("NULL") { RETURN """""" }
	if $$check("CURRENT_DATE") { RETURN "+$h" }
	if $$check("CURRENT_TIME") {
		set prec=$$$GetTimePrecision
		if $$check("(") { set prec=value do skip(9),skip(")") }
		RETURN $c(2)_"%%CURRENT_TIME**"_prec_$c(2)
	}
	if $$check("CURRENT_TIMESTAMP") {
		set prec=$$$GetTimePrecision
		if $$check("(") { set prec=value do skip(9),skip(")") }
		RETURN $c(2)_"%%CURRENT_TIMESTAMP**"_prec_$c(2)
	}
		#;    GETDATE() is a synonym for CURRENT_TIMESTAMP
	if $$checkid("GETDATE") {
		do skip("(")
		if token=9 {
			set prec=value do skip(9)
			do skip(")")
			RETURN $c(2)_"%%CURRENT_TIMESTAMP**"_prec_$c(2)
		}
		else {
			do skip(")")
			RETURN $c(2)_"%%CURRENT_TIMESTAMP"_$c(2)
		}
	}
		#;    GETUTCDATE() returns current timestamp of UTC/GMT
	if $$checkid("GETUTCDATE") {		// DPV3358
		d skip("(")
		if token=9 { 
			set prec=value do skip(9)
			do skip(")")
			RETURN $c(2)_"%%CURRENT_UTC_TIMESTAMP**"_prec_$c(2)
		}
		else {
			do skip(")")
			RETURN $c(2)_"%%CURRENT_UTC_TIMESTAMP"_$c(2)
		}
	}
		#;    SYSDATE is a synonym for CURRENT_TIMESTAMP
	if $$check("SYSDATE") { RETURN $c(2)_"%%CURRENT_TIMESTAMP"_$c(2) }
	if $$chose(" USER CURRENT_USER SESSION_USER ",.op) { RETURN "$Username"	}
		#;    Code to get the SYSTEM_USER borrowed from INT^%USER
	if $$check("SYSTEM_USER") { RETURN "$ZU(67,11,$j)" }
.
	  #; must be a literal
	if $$check("-") { set updatevalue="-"_value }	// Support -#
	else {
		try {
			if value=+value { set updatevalue=value }
			elseif value="""" { set updatevalue="$c(34)" }	// Handle a default value of '"'
			else { set updatevalue=""""_value_"""" }
		}
		catch {	// Assume +value failed, perhaps with <MAXNUMBER> error
			if value="""" { set updatevalue="$c(34)" }		//  Handle a default value of '"'
			else { set updatevalue=""""_value_"""" }
		}
	}
	do skip(9)
	if updatevalue=$c(34,0,34) { RETURN "$c(0)" }
	RETURN updatevalue
.
setdef() ; Handle setting the defualt of a field
	#; <default clause>
	#; <default clause> ::= DEFAULT <default option>
	#; <default option> ::= <literal> 
	#;                      | NULL 
	#;                      | <date time value function> 
	#;                      | <user value> 
	#;                      | <IRIS ObjectScript exapression>
	#; <date time value function> ::= CURRENT_DATE | CURRENT_TIME[(precision)] | CURRENT_TIMESTAMP[(precision)] | GETDATE([prec]) | GETUTCDATE([prec]) | SYSDATE
	#; <user value> ::= USER | CURRENT_USER | SESSION_USER | SYSTEM_USER
	#; <scalar function> :: TO_DATE(<literal>[,<literal>]) |
	#;                      TO_TIMESTAMP(<literal>[,<literal>])
	#; <IRIS ObjectScript expression> ::= %COS <IRIS Objects script code>  ; enclosed in quotes
	#;                                      | %MCODE <IRIS Objects script code>  ; enclosed in quotes
	#;                                      | OBJECTSCRIPT <IRIS Objects script code>  ; enclosed in quotes  (DPV1714)
	#; 
	n defval,pcount s pcount=0 f  q:'$$check("(")  s pcount=pcount+1
	i $$check("NULL") s defval="~~~@@@MakeItNULL@@@~~~" d:pcount skipmany(")",pcount) QUIT defval
	i $$check("CURRENT_DATE") s defval="+$h" d:pcount skipmany(")",pcount) QUIT defval
	if $$check("CURRENT_TIME") {
		new prec
		set prec=$$$GetTimePrecision
		if $$check("(") { set prec=value do skip(9),skip(")") }
		set defval="{CURRENT_TIME("_prec_")}"
		do:pcount skipmany(")",pcount)
		QUIT defval
	}
	i $$check("CURRENT_TIMESTAMP") {
		new prec
		s prec=$$$GetTimePrecision					// DPV3271+
		if $g(%DDLMode)="Oracle" { s prec=6 }	// default precision in Oracle mode is 6
		if $$check("(") s prec=value d skip(9),skip(")")
		s defval="{CURRENT_TIMESTAMP("_prec_")}"			// DPV3271-
		d:pcount skipmany(")",pcount)
		QUIT defval
	}
		#;    GETDATE() is a synonym for CURRENT_TIMESTAMP
	if $$checkid("GETDATE") {
		do skip("(")
		if token=9 { 
			new prec set prec=value do skip(9)
			do skip(")") set defval="{CURRENT_TIMESTAMP("_prec_")}"
		}
		else {
			do skip(")") set defval="{CURRENT_TIMESTAMP}" 
		}
		do:pcount skipmany(")",pcount)
		QUIT defval
	}
		#;    GETUTCDATE() returns current timestamp of UTC/GMT
	if $$checkid("GETUTCDATE") {		// DPV3358
		d skip("(")
		if token=9 { 
			n prec s prec=value d skip(9)
			d skip(")") s defval="{CURRENT_UTC_TIMESTAMP("_prec_")}"
		}
		else {
			d skip(")") s defval="{CURRENT_UTC_TIMESTAMP}"
		}
		d:pcount skipmany(")",pcount) 
		QUIT defval  	
	}
		#;    SYSDATE is a synonym for CURRENT_TIMESTAMP
	i $$check("SYSDATE") s defval="{CURRENT_TIMESTAMP}" d:pcount skipmany(")",pcount) QUIT defval 	// DPV2713=
		#;    
	i $$chose(" USER CURRENT_USER SESSION_USER ",.op) s defval="$Username" d:pcount skipmany(")",pcount) QUIT defval  // DPV3010
		#;    Code to get the SYSTEM_USER borrowed from INT^%USER
	i $$check("SYSTEM_USER") s defval="$ZU(67,11,$j)" d:pcount skipmany(")",pcount) QUIT defval
	i $$check("$") {
		if $$checkid("TSQL_NEWID") d skip("("),skip(")") s defval="$System.Util.CreateGUID()" d:pcount skipmany(")",pcount) QUIT defval  // DPV2882
	}
	i $$checkid("OBJECTSCRIPT") s defval=value d skip(9) d:pcount skipmany(")",pcount) do requireDevelopmentPrivilege() QUIT defval  	//DPV1714
	i $$checkid("%COS") s defval=value d skip(9) d:pcount skipmany(")",pcount) do requireDevelopmentPrivilege() QUIT defval
	i $$checkid("%MCODE") s defval=value d skip(9) d:pcount skipmany(")",pcount) do requireDevelopmentPrivilege() QUIT defval
 	i $$checkid("TO_DATE") {	// DPV2857
		n v1,v2 d skip("(") s v1=value d skip(9)
		if $$check(",") set v2=value d skip(9) 
		d skip(")")
		d:pcount skipmany(")",pcount)
		QUIT "$$todate^%qarfunc("_$$quoter(v1)_","_$$quoter(v2)_")"
	}
 	i $$checkid("TO_TIMESTAMP") {	// DPV3450
		n v1,v2 d skip("(") s v1=value d skip(9)
		if $$check(",") set v2=value d skip(9) 
		d skip(")")
		d:pcount skipmany(")",pcount)
		QUIT "$$totimestamp^%qarfunc("_$$quoter(v1)_$s($d(v2):","_$$quoter(v2),1:"")_")"
	}
	if $$check("-") { s defval="-"_value }	// Support -#
	else {
		try {
			if value=+value { set defval=value }
			elseif value="""" { set defval="$c(34)" }	// Handle a default value of '"'
			else { set defval=""""_value_"""" }
		}
		catch {	// Assume +value failed, perhaps with <MAXNUMBER> error
			if value="""" { set defval="$c(34)" }		//  Handle a default value of '"'
			else { set defval=""""_value_"""" }
		}
	}
	d skip(9)
	d:pcount skipmany(")",pcount)
	If defval=$c(34,0,34) s defval="$c(0)"	// DPV2118=
	QUIT defval
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
altt	;  <alter-table> ::= ALTER TABLE <tabname> [ WITH { CHECK | NOCHECK } ] <alt-act>
	#; <alt-act>     ::= ADD ['('] <alter add definition> 
	#;                       [ { ',' <alter add definition> } ... ] [')']
	#;                   | ALTER <alter alter definition>
	#;                   | MODIFY ['('] <column name> <alter modify definition> [')']
	#;                       [ { ',' <alter modify definition> ... } ]
	#;                   | { DROP | DELETE } <alter drop definition>
	#;                   | LOCK <lock mode definition>
	#;                   | RENAME <ident>
	#;		             | CONVERT <convert clause>       JMM1152
	#; 					 | CLEANUP
	#;                   | MOVE <move spec>     JMM1232
	#;                   | { DROP | DELETE } <partition range spec>   JMM1246+
	#;                   | { DROP | DELETE } ALL PARTITIONS
	#;                   | TRUNCATE <partition range spec>  JMM1246-
	#;
	#;  <alter add definition> ::= <table constraint definition>
	#;                             | <column definition>
	#;  <table constraint definition> ::= ;See CREATE TABLE syntax
	#;  <column definition> ::= ;See CREATE TABLE syntax
	#;
	#;  <alter alter definition> ::= [ COLUMN ] <column name>
	#;                               { <alter default clause>
	#;                                 | <drop default clause>
	#;                                 | <alter column constraint>
	#;                                 | <alter column datatype> 
	#;                                 | <alter column collation>
	#;                                 | <alter colunn name> }
	#;  <alter default clause> ::= [ SET ] DEFAULT <default specification>
	#;  <drop default clause> ::= DROP DEFAULT
	#;  <alter column constraint> ::= { NULL | NOT NULL }
	#;  <alter column datatype> ::= <datatype specification>
	#;  <alter column collation> ::= COLLATE <collate clause>
	#;  <alter column name> ::= RENAME <new column name>
	#;  <collate clause> ::= 	[%]ALPHAUP | 
	#;				[%]EXACT | 
	#;				[%]MINUS | 
	#;				[%]MVR | 
	#;				[%]PLUS | 
	#;				[%]SPACE | 
	#;				[%]SQLSTRING['('<length>')'] | 
	#;				[%]SQLUPPER['('<length>')'] | 
	#;				[%]STRING['('<length>')'] | 
	#;				[%]UPPER | 
	#;				[%]TRUNCATE['('<length>')'] 
	#;				[%]COLLATE['('<Transform-spec>','<length>')']
	#;
	#;  <alter modify definition> ::= { [ <datatype specification> ] [ DEFAULT <default specification> ] [ CONSTRAINT <constraint name> ] [ NOT ] NULL ]
	#;                              | RENAME <new column name> }
	#;       -- ALTER TABLE <table name> MODIFY <datatype specification> ... is supported for Oracle and Sybase compatibility.
	#;
	#;  <alter drop definition> ::= { <drop foreign key>
	#;                                | <drop primary key>
	#;                                | <drop column>
	#;                                | <drop constraint>
	#;  <drop foreign key> ::= FOREIGN KEY <constraint name>
	#;  <drop primary key> ::= PRIMARY KEY
	#;  <drop column> ::= [ COLUMN ] <column name> [ <cascade option> ] [ <data option> ] { , <column name> [ <cascade option> ] [ <data option> ] }
	#;  <drop constraint> ::= CONSTRAINT <constraint name>
	#;
	#;   <cascade option> ::= RESTRICT | CASCADE 
	#;   <data option> ::= %DELDATA | %NODELDATA
	#;
	#;  <lock mode definition> ::= MODE '(' { ROW | PAGE } ')'
	#;     <lock mode definition> is supported for Informix compatibility.
	#;        LOCK MODE does not pertain to the IRIS database, and the
	#;        statment is a no-op.
	#;
	#;		JMM1152 / MJG139
	#;  <convert clause> ::= [ TO ] <shard convert clause> [ DEFER | IMMEDIATE ] | <storagedefault convert clause> [ %DELDATA | %NODELDATA ]
	#;                       | <partition convert clause>   JMM1334=
    #;  <shard convert clause> ::= <shard> | <sharded> | NONSHARDED           JMM11512
    #;  <partition convert clause> ::= PARTITION [ON/OFF] |                            JMM1334+
	#;                                 PARTITION BY <partition specification list>  JMM1334-
	#;			MJG139
	#;	<storagedefault convert clause> 			::= 	<storagedefault conversion type> | <column storagedefault conversion>
	#;	<storagedefault conversion type spec> 		::= 	[ TO ] STORAGETYPE = <storagedefault conversion type>
	#;	<storagedefault conversion type> 			::= 	ROW | COLUMNAR
	#;	<column storagedefault conversion> 			::= 	COLUMN[S] <ident> {, <ident>} <storagedefault conversion type spec>
	#; 
	#;  <move spec> ::= [ <partition range spec> ] TO <database_name> [ <activate spec> ]  JMM1232+ JMM1343=
	#;  <partition range spec> ::= PARTITION ID [ <partition id prefix> ] BETWEEN <partition id> AND <partition id>  |
	#;			   PARTITION ID <partition id prefix> |
	#;			   PARTITION [ <partition prefix> ] BETWEEN <partition field value> AND <partition field value> |
	#;			   PARTITION <partition prefix> BETWEEN <partition field value> AND <partition field value> 
	#;  <partition id prefix> ::= <quote symbol><partition id> { "||"<partition id> }<quote symbol>
	#;   NOTE: <partition id prefix> is actually parsed as <literal>, semantic checking is done in 
	#;   $system.ExtentMapper.MoveExtent()
	#;  <partition prefix> ::= "(" <partition field value> { ","<partition field value> } ")"
	#;  <partition id> ::= <literal>
	#;  <partition field value> ::= <literal>                          JMM1232-
	#;  <activate spec> ::= [ FORCE | DEFER ] ACTIVATE [ MAPPINGS ]    JMM1343=
.
	#;  The optional WITH { CHECK | NOCHECK } clause is only parsed for MS SQL Server compatibility
	#;
	#;------------------------------------------------------------
	$$$TSETop(tabid,"alter")
	new CNAME,cname,hasparen, hasinnerparen, op, conversionColumns, storageType
	new activateOption, foundActivate // JMM1343=
	set cname="",CNAME="",conversionColumns=""
	  #;   WITH NOCHECK is a no-op - we parse it for MS SQL Server
	i $$check("WITH") i '$$check("CHECK") d skipid("NOCHECK")
	if $g(%DDLMode)="Sybase",$$check("PARTITION") do skip(9) $$$TSETopItselfList(tabid,"alternoop") QUIT  // DPV3294
	  #; Maybe it is CONVERT  JMM1152
	if $$check("CONVERT") { // JMM1152+
		$$$TSETopItself(tabid,"alterconvert")
		if $$anyid(" COLUMNS COLUMN ",.op) { // MJG139 - storagedefault conversion can specify individual COLUMNS
			for {
				set conversionColumns = conversionColumns_$select(conversionColumns="":"",1:",")_lower
				do skip("ID")
				quit:'$$check(",")
			}
			$$$TSETConversionColumns(tabid, conversionColumns)
		}
		#; Skip optional "TO"
		d check("TO")
		s shard=0
		if $$chkShard(1,,1) { // JMM1241=
			s shard=1
		}
		elseif $$chkShard(1,"SHARDED",1) { // JMM1241=
			s shard=1
		}
		elseif $$chkNonSharded(1) {
			s shard=-1
		}
		elseif $$checkid("STORAGETYPE") {
			do skip("=")
			// if there was no COLUMN[S} specified then they want to convert all the columns
			if $$$tConversionColumns(tabid)="" { 
				$$$TSETConversionColumns(tabid,"*") 
			}
.
			// For now just converting to columnar, add ROW back to support ROW
			if $$anyid(" ROW COLUMNAR ", .storageType) { 
				//do:storageType="ROW" error2(1, "COLUMNAR") 
				$$$TSETConversionType(tabid, "STORAGETYPE"_$c(1)_storageType)
			} else {
				do error2(1,"ROW or COLUMNAR") // only storagetypes to convert
			}
			// Give the user the option to not automatically clean up the old data, allowing them to only do it manually when they choose to
			// The default will be %DELDATA
			if $$chose(" %DELDATA %NODELDATA ",.op) {
				$$$TSETdeldata(tabid,op)
			}
		}
		elseif $$checkid("PARTITION") { // JMM1334+
			$$$TSETConversionType(tabid, "PARTITION")
			if $$checkid("OFF") { 
				$$$TSETPartition(tabid,0)
				QUIT
			}
			elseif $$checkid("ON") {
				$$$TSETPartition(tabid,1)
				QUIT
			}
			elseif $$checkid("BY") {
				$$$TSETPartition(tabid,1)
				for ps=1:1 {
					do partspec
					quit:'$$check(",")
				}
			}
			else {
				$$$TSETPartition(tabid,1)
				QUIT
			}				
		} // JMM1334-
		else {
			#; Currently, "shard", "sharded", "nonsharded", "storagetype", or "partition" are the only conversion options supported  JMM1334=
			set t="SHARD, SHARDED, NONSHARDED, STORAGETYPE, or PARTITION" do error(1) // JMM1334=
		}
		if shard {
			if conversionColumns '= "" { // COLUMN[S] should've only been parsed for storagetype conversions, if this condition is true they specified COLUMNS for a shard conversion
				do error2(1, "STORAGETYPE")
			}
			#; Shard/nonsharded conversion supports IMMEDIATE/DEFER, IMMEDIATE is the default.
			#; Other conversions may not support both of these options.
			if $$chkDefer() {
			}
			elseif $$chkImmediate() {
			}
		}
	} // JMM1152-
.
	// MJG139, following %NODELDATA in the ALTER...CONVERT statement, allow user to explicitly cleanup
	if $$checkid("CLEANUP") {
		$$$TSETopItself(tabid,"alterconvertcleanup")
		do:(token'=$c(1)) error(25)
		RETURN
	}
	  #; Maybe it is ADD COLUMN/CONSTRAINT
	if $$check("ADD") {
		set hasparen = $$check("(")
		do {
			set cname="", CNAME=""
			set:%delid %delid=3
			if $$check("CONSTRAINT"), $get(%DDLMode)'="Informix" {
				do {
					do check("_")
					set cname=lower, CNAME=value
					do skip("ID")
				} while $$check(".")
				$$$Cmake(CNAME,cname)
			}
			set:%delid=3 %delid=1
			set hasinnerparen = $$check("(")
			if $$check("FOREIGN") { ##; FOREIGN KEY
				//$$$TSETopItselfList(tabid,"alteraddforeignkey")	// DPV1864
				do skipid("KEY")
				if cname="" {
					if token="ID" {
						set cname = lower
						set CNAME = value
						do skip("ID")
					} else {
						set cname = tabidshort _ "_FKEY" _ $$$GetConstraintCount
						set CNAME = "#" _ $$$IDName(cname)
					}
				}
				$$$Cmake(CNAME,$select($extract(CNAME,1)="#":"#"_cname,1:cname))
				$$$CSETtype(CNAME,"FKEY")
				do nukey(tabid,"","F",$extract("#",$extract(CNAME)="#")_cname,.keyid)
				do skip("REFERENCES")
				do ref(keyid, CNAME)
				$$$TSETopItselfList(tabid,"alteraddforeignkey"_$c(1)_keyid)	// DPV1864
				if $get(%DDLMode)="Informix", $$check("CONSTRAINT") {
					new C,c
					for  { s i=$$check("_"),c=lower,C=value d skip("ID") q:'$$check(".")  }
					$$$KSETconsname(tabid,keyid,C)
					$$$Crename(CNAME,C)
				}
				do:hasinnerparen skip(")")
					#;   The ON clause is a no-op.  For compatibility with non-standard 3rd party extensions (MS SQL Server).  Just parse and ignore...
				if $get(%DDLMode)="Sybase", $$check("ON") do skip("ID")	// Sybase - option ON segment_name clause (DPV3294)
				if $$check("ON") i '$$check("DEFAULT") i token=$c(1) { d error(1) q  } d skip(token)
			}
			
			elseif $$check("UNIQUE") { ##; UNIQUE CONSTRAINT
				//$$$TSETopItselfList(tabid,"alteraddunique")	// DPV1864=
				do checkid("CLUSTERED"), checkid("NONCLUSTERED")  ##; MS SQL Server Support
				if cname="" {
					set cname = $extract(tabidshort,1,20) _ "_Unique" _ $$$GetConstraintCount
					set CNAME="#" _ $$$IDName(cname)
				}
				$$$Cmake(CNAME,cname)
				$$$CSETtype(CNAME,"UNIQUE")
				do nukey(tabid,"","U",cname,.keyid)
				$$$TSETopItselfList(tabid,"alteraddunique"_$c(1)_keyid)	// DPV1864=
				if $get(%DDLMode) = "Informix", $$check("CONSTRAINT") {
					new C,c
					f  { s i=$$check("_"),c=lower,C=value d skip("ID") q:'$$check(".")  }
					$$$KSETconsname(tabid,keyid,C) $$$Crename(CNAME,C)
				}
				do:hasinnerparen skip(")")
				do:$$check("WITH") skipid("FILLFACTOR"), skip("="), skip(9)  ; MS SQL Server Support
					#;   The ON clause is a no-op.  For compatibility with non-standard 3rd party extensions (MS SQL Server).  Just parse and ignore...
				if $get(%DDLMode)="Sybase", $$check("ON") do skip("ID")	// Sybase - option ON segment_name clause (DPV3294)
				if $$check("ON") i '$$check("DEFAULT") i token=$c(1) { d error(1) q  } d skip(token)
			}
			
			elseif $$check("PRIMARY") { ##; PRIMARY KEY
				//$$$TSETopItselfList(tabid,"alteraddprimarykey")	// DPV1864=
				if cname = "" {
					set cname = tabidshort _ "_PKEY" _ $$$GetConstraintCount
					set CNAME = "#" _ $$$IDName(cname)
				}
				$$$Cmake(CNAME,cname)
				$$$CSETtype(CNAME,"PKEY")
				do skipid("KEY")
				do:(token '= "(") skip("ID") ##; Specified keyname
				do nukey(tabid,"","P",cname,.keyid)
				$$$TSETopItselfList(tabid,"alteraddprimarykey"_$c(1)_keyid)	// DPV1864=
				if $get(%DDLMode) = "Informix", $$check("CONSTRAINT") {
					new C,c
					f  { s i=$$check("_"),c=lower,C=value d skip("ID") q:'$$check(".")  }
					$$$KSETconsname(tabid,keyid,C)
					$$$Crename(CNAME,C)
				}
				do:hasinnerparen skip(")")
				do:$$check("WITH") skipid("FILLFACTOR"), skip("="), skip(9)  ; MS SQL Server Support	// DPV1870
					#;   The ON clause is a no-op.  For compatibility with non-standard 3rd party extensions (MS SQL Server).  Just parse and ignore...
				if $get(%DDLMode)="Sybase", $$check("ON") do skip("ID")	// Sybase - option ON segment_name clause (DPV3294)
				if $$check("ON") i '$$check("DEFAULT") i token=$c(1) { d error(1) q  } d skip(token)
			}
				#;   MS SQL Server allows DEFAULT values as constraints.
				#;   We will handle this here, but we won't allow dropping
				#;   a default value with a DROP CONSTRAINT statement.
			elseif $$check("DEFAULT") { ##; DEFAULT CONSTRAINT
				//$$$TSETopItselfList(tabid,"alteralter")	// DPV1864=
				new defval
				set defval = $$setdef()
				do skip("FOR")
				new rwPrefix
				if $get(%DDLMode)="Informix", $data(^%SYS("xsql","informix","RESERVEDWORDPREFIX"),rwPrefix), rwPrefix'="", $$$SQLReservedWordForParsing(value) {
					set value = $$$UPPER(rwPrefix) _ value
					set lower = rwPrefix _ lower
				}
				$$$Fmake(tabid,value,lower,fldid)
				do skip("ID")
				$$$FSETdef(tabid,fldid,defval)
				$$$TSETopItselfList(tabid,"alteralter"_$c(1)_fldid)	// DPV1864=
				if cname="" {
					set cname = tabidshort _ "_DEFAULT" _ $$$GetConstraintCount
					set CNAME = "#"_$$$IDName(cname)
				}
				$$$Cmake(CNAME,cname)
				$$$CSETtype(CNAME,"DEFAULT")
			}
			
			elseif $$check("CHECK") { ##; CHECK CONSTRAINT
				$$$TSETopItselfList(tabid,"alternoop")
				if cname="" {
					set cname = $extract(tabidshort,1,20) _ "Check" _ $$$GetConstraintCount
					set CNAME = $$$IDName(cname)
				}
				$$$Cmake(CNAME,cname)
				do chkparse(CNAME)
				if $get(%DDLMode)="Informix", $$check("CONSTRAINT") {
					f  s i=$$check("_"),cname=lower,CNAME=value d skip("ID") q:'$$check(".")
				}
			}
			
			else {
				do checkid("COLUMN") ##; COLUMN is optional
				//$$$TSETopItselfList(tabid,"alteradd")	// DPV1864=
				new optparen  set optparen = $$check("(") ##; Optional parentheses for tecdef
				do tecdef
				$$$TSETopItselfList(tabid,"alteradd"_$c(1)_fldid)	// DPV1864=
				do:optparen skip(")") ##; Optional parentheses for tecdef
				do:hasinnerparen skip(")") ; DPV1118+
			}
		} while $$check(",")
		do:(hasparen) skip(")") 
		do:(token'=$c(1)) error(25)
		QUIT
	}
	if value="FIX" {
		d skip("ID")
		do:'$$check("STATISTICS") skipid("STATS")
		set $$$Dop="fix table stats"
		RETURN
	} elseif $$check("SET")&&(value="RUNTIME")  {
		d skip("ID")
		set $$$Dop="set table stats prop"
		if $lf($lb("IGNOREFIXEDSTATS","SKIPAUTOMATICSTATSCOLLECTION"),value) {
			new prop
			set prop=value
			d skip("ID")
			d skip("=")
			if $$check("TRUE") {
				$$$tSETTableStatsProp(tabid,prop,1)
			} elseif $$check("FALSE"){
				$$$tSETTableStatsProp(tabid,prop,0)
			} else {
				new t set t="TRUE or FALSE" do error(1)  
			}	
		} else {
			new t set t="IGNOREFIXEDSTATS or SKIPAUTOMATICSTATSCOLLECTION" do error(1) 
		}
		RETURN
	}
		#; Maybe it is DROP COLUMN
	If $$chose(" DROP DELETE ") {
		if value="FIXED" {
			set lexp=$$lexmark^%qaqpsq() ;  save current location
			do skip("ID")	// skip "FIXED" identifier
			if value="STATISTICS" {
				set $$$Dop="drop table stats"
				do skip("STATISTICS")
				RETURN
			} elseif $$checkid("STATS") {
				set $$$Dop="drop table stats"
				RETURN
			} else {
				d lexgo^%qaqpsq(lexp) ;  restore lexical context lexp
			}
		}
		$$$TSETopItself(tabid,"alterdrop")
		i $$check("ALL") { // JMM1246+
			if $$checkid("PARTITIONS") {
				$$$TSETopItself(tabid,"alterdropallpartitions")
				QUIT
			}
		}
		i $$check("PARTITION") {
			$$$TSETopItself(tabid,"alterdroppartition")
			d parsePartitionSpec()
			QUIT
		} // JMM1246-
		i $$check("FOREIGN") {
			$$$TSETopItself(tabid,"alterdropforeignkey") 
			set:%delid=1 %delid=3
			d skipid("KEY") 
			s cname=lower,CNAME=$$$IDName(cname) $$$Cmake(CNAME,cname) $$$CSETtype(CNAME,"FKEY")
			d skip("ID")				// DPV1931=
			set:%delid=3 %delid=1
			$$$Kmake(tabid,"","F",cname,keyid)	// DPV1931=
			//d nukey(tabid," ","F",CNAME,.keyid)	// DPV1931= removed this line
			$$$KSETconsname(tabid,keyid,CNAME)
			QUIT
		}
		i $$check("PRIMARY") $$$TSETopItself(tabid,"alterdropprimarykey") d skipid("KEY") QUIT
		set:%delid=1 %delid=3
		if $$check("CONSTRAINT") {
			$$$TSETopItself(tabid,"alterdropconstraint")
			set cname=lower,CNAME=$$$IDName(cname) $$$Cmake(CNAME,cname)
			do skip("ID")
			set:%delid=3 %delid=1
			QUIT
		}
		set:%delid=3 %delid=1
			#; Must be DROP [COLUMN] <fname> [ RESTRICT | CASCADE ]...
		if $$checkid("COLUMN") {}  // handle [ COLUMN ] token
		new rwPrefix
		if $g(%DDLMode)="Informix",$d(^%SYS("xsql","informix","RESERVEDWORDPREFIX"),rwPrefix),rwPrefix'="",$$$SQLReservedWordForParsing(value) { set value=$$$UPPER(rwPrefix)_value,lower=rwPrefix_lower }
		for {
			$$$Fmake(tabid,value,lower,fldid) d skip("ID")
			if $$chose(" RESTRICT CASCADE ",.op) { $$$FSETbehave(tabid,fldid,op) }
			if $$chose(" %DELDATA %NODELDATA ",.op) { $$$FSETdeldata(tabid,fldid,op) }
			quit:'$$check(",")
		}
		do:token'=$c(1) error(25)
		QUIT
	}
 
		#;  Lock mode is for Informix compatibility
	i $$checkid("LOCK") d  QUIT
	. $$$TSETopItself(tabid,"alternoop")
	. d skipid("MODE"),skip("(")
	. i $$checkid("ROW") d skip(")") q
	. d skipid("PAGE"),skip(")")
 
	i $$check("CHECK")!$$checkid("NOCHECK") d  QUIT
	. $$$TSETopItself(tabid,"alternoop")
	. d skip("CONSTRAINT"),skip("ALL")
		#; Maybe be ALTER COLUMN
 
	i $$check("ALTER") {
		i $$checkid("COLUMN") ; Handle [ COLUMN ] token
		new rwPrefix if $g(%DDLMode)="Informix",$d(^%SYS("xsql","informix","RESERVEDWORDPREFIX"),rwPrefix),rwPrefix'="",$$$SQLReservedWordForParsing(value) { s value=$$$UPPER(rwPrefix)_value,lower=rwPrefix_lower }
		$$$Fmake(tabid,value,lower,fldid) d skip("ID")
		if $$checkid("RENAME") {
			$$$TSETopItselfList(tabid,"alterrenamefield" _ $c(1) _ fldid)
			set $$$fnewname(tabid, fldid) = lower
			do skip("ID")
			quit
		}
		$$$TSETopItself(tabid,"alteralter"_$c(1)_fldid)	// DPV1864=
			#; Setting column's default value, maybe NULL
		i $$check("SET") d skip("DEFAULT") $$$FSETdef(tabid,fldid,$$setdef()) d:token'=$c(1) error(25) QUIT
		i $$check("DEFAULT") $$$FSETdef(tabid,fldid,$$setdef()) d:token'=$c(1) error(25) QUIT
			#; Dropping Column default value?
		i $$check("DROP") d skip("DEFAULT") $$$FSETdef(tabid,fldid,"~~~@@@MakeItNULL@@@~~~") d:token'=$c(1) error(25) QUIT
			#; Maybe altering field's required flag?
		i $$check("NULL") $$$FSETreq(tabid,fldid,-1) d:token'=$c(1) error(25) QUIT
		if $$check("NOT") {
			if $$check("DEFERRED") { $$$FSETdeferred(tabid,fldid,0) do:token'=$c(1) error(25) }
			else { do skip("NULL") $$$FSETreq(tabid,fldid,1) do:token'=$c(1) error(25) }
			RETURN
		}
			#; Maybe altering the field's collation parameter?
		if $$check("COLLATE") { // DPV3102
			$$$FSETcoll(tabid, fldid, $$collate())
			d:token'=$c(1) error(25) QUIT
		}
.
			#; Must be altering the field's datatype
		$$$FSETtype(tabid,fldid,$$datyp())
		if $$check("COLLATE") { // MJG109 - maybe there's a collation here too
			$$$FSETcoll(tabid, fldid, $$collate())
		}
		QUIT
	}
 
	if $$checkid("MODIFY") {
		new checkdatatype,hasparen,rwPrefix
		set hasparen=$$check("(")
		for i=1:1 {
			if $g(%DDLMode)="Informix",$d(^%SYS("xsql","informix","RESERVEDWORDPREFIX"),rwPrefix),rwPrefix'="",$$$SQLReservedWordForParsing(value) { s value=$$$UPPER(rwPrefix)_value,lower=rwPrefix_lower }
			$$$Fmake(tabid,value,lower,fldid) d skip("ID")
			if $$checkid("RENAME") {
				$$$TSETopItselfList(tabid, "alterrenamefield" _ $c(1) _ fldid)
				set $$$fnewname(tabid, fldid) = lower
				do skip("ID")
				quit:'$$check(",")
				continue
			}
			set checkdatatype=1
			$$$TSETopItselfList(tabid,"alteralter"_$c(1)_fldid)
			if $$check("DEFAULT") $$$FSETdef(tabid,fldid,$$setdef()) s checkdatatype=0
			if $$check("CONSTRAINT") d skip("ID") s checkdatatype=0
			if $$check("NULL") $$$FSETreq(tabid,fldid,-1) s checkdatatype=0
			if $$check("NOT") d skip("NULL") $$$FSETreq(tabid,fldid,1) s checkdatatype=0
			if 'checkdatatype quit:'$$check(",")  continue
			$$$FSETtype(tabid,fldid,$$datyp())
			if $$check("DEFAULT") $$$FSETdef(tabid,fldid,$$setdef())
			if $$check("CONSTRAINT") d skip("ID")
			if $$check("NULL") $$$FSETreq(tabid,fldid,-1)
			if $$check("NOT") d skip("NULL") $$$FSETreq(tabid,fldid,1)
			quit:'$$check(",")
		}
		do:hasparen skip(")")
		QUIT
	}
	
	if $$checkid("RENAME") {
		$$$TSETopItself(tabid,"alterrename")
		set $$$tnewname(tabid) = lower
		do skip("ID")
		if $$check(".") set token="qualified table name" do error2(1,"Unqualified table name")
	}	
.
	#; JMM1232 change has been factored into JMM1246 change.
	new alterMove,alterTruncate,alterArchive // JMM1311=
	set alterMove=0,alterTruncate=0,alterArchive=0 // JMM1246+
	if $$checkid("MOVE") {
		set alterMove=1
		$$$TSETopItself(tabid,"altermove")
	}
	if $$checkid("TRUNCATE") {
		set alterTruncate=1
		$$$TSETopItself(tabid,"altertruncate")
	}
#if 0 // Disable ALTER TABLE ... ARCHIVE PARTITION for initial release of partitioning
	elseif $$checkid("ARCHIVE") {
		set alterArchive=1
		$$$TSETopItself(tabid,"alterarchive")
	}
#endif
	if alterMove || alterTruncate || alterArchive {
		if $$check("PARTITION") {
			d parsePartitionSpec()
		}
		if alterMove { // JMM1264+ 
			if $$check("TO") { // JMM1264-
				if $$peek($c(1)) { // JMM1264+
					do error2(1,"TO <database>")
				}
				else { // JMM1264-
					$$$TSETMoveToDatabase(tabid,value)
					d skip(token)
				} // JMM1264=
			}
			else { // JMM1264+
				do error2(1,"TO")
			} // JMM1264-
			set foundActivate=0,activateOption=""
			if $$peek($c(1)) { // JMM1343
				set activateOption="immediate"
			}
			elseif value="FORCE" { // JMM1343+
				set activateOption="force"
			}
			elseif value="DEFER" {
				set activateOption="defer"
			}
			elseif value="ACTIVATE" {
				set activateOption="immediate"
				set foundActivate=1
			}
			do:(activateOption="force"||(activateOption="defer")||foundActivate) skip(token)
			if activateOption="force" || (activateOption="defer") {
				if value'="ACTIVATE" {
					do error2(1,"ACTIVATE")
				}
				else {
					set foundActivate=1
					do skip(token)
				}
			}
			if foundActivate {
				if value="MAPPINGS" {
					do skip(token)
				}
			}
			$$$TSETActivateOption(tabid,activateOption)
		}
		if alterArchive && $$check("TO") {
			$$$TSETArchiveToLocation(tabid,value)
			d skip(token)
		}
	} // JMM1246-
	QUIT  ;--- altt ---
.
	#; JMM1267 Check for possible + or - before literal representing partition ID or partition key value.
	#; If minus sign is found, negate the value.
parsePartitionValue() // JMM1267+
	if $$check("-") {
		s value=-value
	}
	elseif $$check("+") {
	}
	if token'=9 { // JMM1315+
		new t set t = "<literal>" do error(1)
	} // JMM1315-
	QUIT // JMM1267-
.
	#; Parse PARTITION specification JMM1246
parsePartitionSpec() // JMM1246+
	new foundBetween,prefix // JMM1311=
	$$$TSETPartition(tabid,1)
	if $$check("ID") {
		$$$TSETPartitionId(tabid,1)
		set foundBetween=$$check("BETWEEN")
		if 'foundBetween {
			d parsePartitionValue() // JMM1267=
			$$$TSETPartitionPrefix(tabid,value)
			d skip(token)
		}
	}
	else {
		s foundBetween=0
		if $$check("(") {
			set prefix=""
			while '$$check(")") {
				set:prefix'="" prefix=prefix_","
				d parsePartitionValue() // JMM1267=
				set prefix=prefix_value
				d skip(token)
				if $$check(",") {
				}
			}
			$$$TSETPartitionPrefix(tabid,prefix)
		}
	}
	if foundBetween || $$check("BETWEEN") {
		d parsePartitionValue() // JMM1267=
		$$$TSETPartitionStart(tabid,value)
		d skip(token)
		if $$check("AND") {
			d parsePartitionValue() // JMM1267=
			$$$TSETPartitionEnd(tabid,value)
			d skip(token)
		}
		else {
		}
	}
	else {
	}
	QUIT ;--- parsePartitionSpec --- JMM1246-
.
	#; Parse COLLATE for collation function, typically called after parsing COLLATE keyword.
	#; If you're calling this function, a collation function is EXPECTED to be parsed or else we error
	#; Called from: altt, index
	#; Need $$check for lexing so implement as a function
	#; 
	#; NOTE: if you're updating this, you may need to update tecdef as well, which has some collation parsing
	#; that doesn't lend itself to using this function
	#; 
	#; Returns: collation function that follows COLLATE in the DDL statement
collate()
	new collation, valueStr
	if '$$anyid(" %ALPHAUP %COLLATE %EXACT %MINUS %MVR %PLUS %SPACE %SQLSTRING %SQLUPPER %STRING %TRUNCATE %UPPER ALPHAUP COLLATE EXACT MINUS MVR PLUS SPACE SQLSTRING SQLUPPER STRING TRUNCATE UPPER ",.collation) { 
		new t set t = "Collation Name (One of ALPHAUP, COLLATE, EXACT, MINUS, MVR, PLUS, SPACE, SQLSTRING, SQLUPPER, STRING, TRUNCATE, or UPPER)" do error(1) 
	}
	// some collations can specify a parameter, e.g. TRUNCATE(10)
	if " %SQLSTRING %SQLUPPER %STRING %TRUNCATE SQLSTRING SQLUPPER STRING TRUNCATE "[(" "_collation_" ") {
		if $$check("(") { 
			if '$isvalidnum(value)||(value<0)||(value[".") {
				new t set t = "<positive integer>" do error(1)
			}
			set collation=collation_"("_value_")" do skip(9),skip(")") 
		}
	} elseif " %COLLATE COLLATE "[(" "_collation_" ") {
		If $$check("(") {
			set valueStr = $$quoter(value) d skip(9)
			if $$check(",") { set valueStr = valueStr_","_value do skip(9) }
			set collation=collation_"("_valueStr_")"
			do skip(")") 
		}
	} // if neither of the above ifs got hit, it's just a parameter-less function like %EXACT, stored in collation variable via PBR from $$anyid
	RETURN collation
.
 
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
index	; Handle CREATE INDEX & DROP INDEX
	new i,idxid,junk,rwPrefix
	#; DRI is DROP INDEX, BNF:
	#;   DROP INDEX [ IF EXISTS ] [ %NOJOURN ] <index name> [ ON [ TABLE ] <table name>]
	#; OR
	#;   DROP INDEX [ IF EXISTS ] [ %NOJOURN ] [ <schemaname> . ] <table name> . <index name>
	#;
	if $$$mtStatementType="DRI"{ ##; DROP INDEX
		new ixname, ixnamel
		set tval="",tlow=""
		new holdvals
		do holdcur^%qaqpsl2(.holdvals)
		if $$checkid("IF") {
			if $$check("EXISTS") { set tChkExists=1 } else { do setold^%qaqpsl2(.holdvals) }
		}
		if $$checkid("%NOJOURN") { 
			set $$$mtKNoJournalFlag($$$mtK)=1
			set:info $li(mtc(0,0,"syspriv"),12)=1
		}
		set ixname=value,ixnamel=lower
		do skip("ID")
		if $$check(".") {	##; Must be at least <table>.<index>
			set tval=ixname, tlow=ixnamel
			set ixname=value, ixnamel=lower
			do skip("ID")
		}
		if $$check(".") {	##; Must be <schema>.<table>.<index>
			set tval=tval_"."_$translate(ixname,".",$char(2))
			set tlow=tlow_"."_$translate(ixnamel,".",$char(2))
			set ixname=value, ixnamel=lower
			do skip("ID")
		} elseif tval'="" {	##; <schema> is not specified; use default schema
			set tval=$$$DEFAULTSCHEMACGQ_"."_$translate(tval,".",$c(2))
			set tlow=$$$DefaultSchemaCGQ_"."_$translate(tlow,".",$c(2))   
		}
		$$$Imake(ixname,ixnamel,idxid)				##; Create Index Handle
		$$$ISetDropIfExists(idxid,$get(tChkExists))	##; Set IF EXISTS flag
		$$$ISETop(idxid,"drop index")				##; Define Index Option
		if tlow'="" { $$$ISETtable(idxid,tlow) }	##; Drop index on this Table
		quit:(token=$char(1))						##; End if no ON [ TABLE ] Clause
		do skip("ON") if $$check("TABLE")			##; [ TABLE ] is optional
		#; Handle <owner>.<catalog>.<schema>.<table>
		do ParseIdentifier(.tval,.tlow)
		$$$ISETtable(idxid,tlow)					##; Drop index on this Table
		do:(token'=$char(1)) error(25)				##; Should've been the end
		quit
	}
	#;
	#; Must be CREATE INDEX, BNF:
	#;   CREATE [NONPARTITIONED|PARTITIONED] <indextype>
	#;       INDEX [[[owner.]catalog.]schema.]index_name
	#;       ON [TABLE] [[[owner.]catalog.]schema.]table_name 
	#;       (column_name [ ASC | DESC ] [, column_name [ ASC | DESC ] ] ...)
	#; 		 [ AS index_class_name [ WITH parameter_name = parameter_value, ... | ( parameter_name = parameter_value, ... ) ] ]
	#;       [WITH [PAD_INDEX] [[,] FILLFACTOR = fillfactor] [[,] IGNORE_DUP_KEY] [[,] DROP_EXISTING] [[,] STATISTICS_NORECOMPUTE] ]
	#;       [ { ON | IN } dbspace ]
	#;       [ { IMMEDIATE | DEFER } [ BUILD ] ]
	#;
	#;     <indextype> ::=
	#;		UNIQUE [ CLUSTERED | NONCLUSTERED ] |
	#;		BITMAP |
	#;		BITSLICE |
	#;		BITMAPEXTENT |
	#;		COLUMNAR |
	#;		CLUSTERED |
	#;		NONCLUSTERED
	#;
	#;	If indextype is BITMAPEXTENT, stop last token in statement must be the table name
	#;     UNIQUE will mark the index as being unique
	#;     CLUSTERED, NONCLUSTERED, ASC, and DESC tokens are no-ops
	#;     [[[owner.]catalog.]schema.] is also no-ops
	#;     WITH clause is a no-op for MS SQL Server compatibility
	#;     ON dbspace  is a no-op for MS SQL Server compatibility
	#;     IN dbspace  is a no-op for Informix compatibility
	#;	If indextype is COLUMNAR, only one column_name is supported
	#;
	for  { set i=$$check("_"),tval=value,tlow=lower do skip("ID") quit:'$$check(".") }
	$$$Imake(tval,tlow,idxid)                ;Create Index Handle
	$$$ISETop(idxid,"create index")          ;Define Index Option
	$$$ISETunique(idxid,(+$g(idxtype)=1))    ;Set index's unique flag (idxtype=1 means UNIQUE)
	$$$ISETbitmap(idxid,(+$g(idxtype)=2))    ;Set index's bitmap flag (idxtype=2 means Type =Bitmap)
	$$$ISETbitslice(idxid,(+$g(idxtype)=3))  ;Set index's bitslice flag (idxtype=3 means Type =Bitslice)
	$$$ISETbitmapextent(idxid,(+$g(idxtype)=4))  ;Set index's bitmapextent flag (idxtype=4 means Type =Bitmapextent)
	$$$ISETcolumnar(idxid,(+$g(idxtype)=5))  ;Set index's columnar flag (idxtype=5 means Type =Columnar)
	$$$ISETdeferred(idxid,(+$g(idxdeferred)))    ;Set index's deferred flag
	$$$ISETpartitioned(idxid,(+$g(idxpartitioned)))    ;Set index's partitioned flag
	do skip("ON")                             ;Skip 'ON' token
	if $$check("TABLE")                       ;Skip optional 'TABLE' token
	#; Handle <owner>.<catalog>.<schema>.<table>
	do ParseIdentifier(.tval,.tlow)
	$$$ISETtable(idxid,tlow)                 ;Create index on this Table
	if idxdeferred {
		if idxtype=1 { new type set type="Unique" do error(167) }
		if idxtype=3 { new type set type="BitSlice" do error(167) }
		if idxtype=4 { new type set type="BitmapExtent" do error(167) }
		if idxtype=5 { new type set type="Columnar" do error(167) }
	}
	goto:$$$ibitmapextent(idxid) createIndexBuild		// Nothing else to parse for bitmapextent indices except the final [ { IMMEDIATE | DEFER } [ BUILD ] ] clause
	do skip("(")                             ;Skip '(', start of fld list
	#; Get each field in the index, store in the order given
	#; Skip over optional ASC DESC clauses.
	f i=1:1 {
		if $g(%DDLMode)="Informix",$d(^%SYS("xsql","informix","RESERVEDWORDPREFIX"),rwPrefix),rwPrefix'="",$$$SQLReservedWordForParsing(value) { s value=$$$UPPER(rwPrefix)_value,lower=rwPrefix_lower }
		if $g(%DDLMode)="" {
			new tFieldValue, valueStr set tFieldValue=value
			do skip("ID")		// Fieldname
			if $$check("(") {	// Field(ELEMENTS) or Field(KEYS)
				if $$checkid("ELEMENTS") { set tFieldValue=tFieldValue_"(ELEMENTS)" }
				else { do skipid("KEYS") set tFieldValue=tFieldValue_"(KEYS)" }
				do skip(")")
			}
			if $$check("COLLATE") { // user specified a collation for the indexed field, currently supports legacy collations...
				// no custom collation on a unique index
				do:$$$iunique(idxid) error(335)
				
				// It's better to set the collation later in AddIndex^%apiDDL. We could set tFieldValue = tFieldValue_":"_collation here,
				// but then we'd have to use ":" as a delimiter to remove the collation portion in AddIndex when we look up the field name but
				// delimited identifiers can have a colon character.
				// Use $$quoter -- need to do $lfs(,,2) in AddIndex^%apiDDL, don't want commas from %COLLATE messing with list delimiting commas. Note we also
				// use $$quoter on the %COLLATE first string parameter -- this is correct, that needs to be additionally quoted
				$$$ISETcollation(idxid, i, $$quoter($$collate()))
			}
			$$$ISETfield(idxid,i,tFieldValue)
		}
		else {
			$$$ISETfield(idxid,i,value) d skip("ID")
			if $g(%DDLMode)="MySQL" if $$check("(") d skip(9),skip(")")	// We do not support indexes on %STARTSWITH (column), parse and ignore (DPV3513)
		}
		set junk=$$check("ASC"),junk=$$check("DESC")
		quit:'$$check(",")
		if idxtype=5 { new moreinfo set t="')'",token="','",moreinfo=" (Multiple fields in a columnar index are not supported)" do error(1) }
	}
	d skip(")")                              ;Skip ')', end of field list
	if $g(%DDLMode)="Oracle" {	// DPV2730+
		For  { 
			If $$anyid(" LOGGING NOLOGGING PCTFREE PCTUSED INITRANS MAXTRANS MONITORING STORAGE TABLESPACE ",.op) {
				Do OraclePhysicalAttributesClause^%qaqpDDLParser2(op)
			}
			ElseIf $$anyid(" PARALLEL NOPARALLEL ",.op) {
				Do OracleParallelClause^%qaqpDDLParser2(op)
			}
			Else {
				d:'$$checkid("CACHE") checkid("NOCACHE") 
				Quit  
			}
		}
	}	// DPV2730-
	elseif $g(%DDLMode)="Sybase" {
		if $$check("WITH") {  // DPV3294
			if $$checkid("FILLFACTOR")||($$checkid("MAX_ROWS_PER_PAGE")) d skip("="),skip(9) i $$check(",")
			if $$checkid("IGNORE_DUP_KEY") i $$check(",")
			if $$checkid("SORTED_DATA") i $$check(",")
			if $$checkid("IGNORE_DUP_ROW")||($$checkid("ALLOW_DUP_ROW"))
		}
			#;   ON ... clause is for MS SQL Server
		if $g(%DDLMode)="Sybase",$$check("ON") do skip("ID")	// Sybase - option ON segment_name clause (DPV3294)
	}
	else {	// IRIS and others...
		if $$check("AS") { //AS index_class_name [ WITH parameter_name = parameter_value, ... | ( parameter_name = parameter_value, ... ) ]
			new typeclass
			set typeclass=lower
			do skip("ID")
			while $$check(".") {
				set typeclass=typeclass_"."_lower
				do skip("ID")
			}
			$$$ISETtypeclass(idxid,typeclass) ; set index type class for functional indices
			new openparen s openparen=$$check("(") 
			if openparen||($$check("WITH")) {
				new params,param
				set params=""
				for i=1:1 {
					set param=value
					if $$checkid(param) {
						do skip("=") 
						set params=params_$lb($lb(param,value)) 
						do skip(9) 
					} else { d:'openparen error(1) }
					quit:'$$check(",")
				}
				$$$ISETparameters(idxid,params)
				do:openparen skip(")")
			}
		}
		if $$check("WITH") {
			if $$checkid("DATA") {
				do skip("(")
				for i=1:1 {
					$$$ISETDataField(idxid,i,value) d skip("ID")
					quit:'$$check(",")
				}
				do skip(")")
			}
			if $$checkid("PAD_INDEX") i $$check(",")
			if $$checkid("FILLFACTOR") d skip("="),skip(9) i $$check(",")
			if $$checkid("IGNORE_DUP_KEY") i $$check(",")
			if $$checkid("DROP_EXISTING") i $$check(",")
			if $$checkid("STATISTICS_NORECOMPUTE") i $$check(",")
		}
	}
	if $$check("ON") i token=$c(1) { d error(1) q  } d skip(token) i 1
	#;   IN ... clause is for Informix
	e  i $$check("IN") i token=$c(1) { d error(1) q  } d skip(token) 
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;-----  CREATE INDEX's ending [ { IMMEDIATE | DEFER } [ BUILD ] ] segment  -----
createIndexBuild
	new idxbuild s idxbuild = 1
	if $$checkid("DEFER") { s idxbuild = 0 do checkid("BUILD") }
	elseif $$check("IMMEDIATE") { d checkid("BUILD") } //already set idxbuild=1 as the default
	$$$ISETbuild(idxid,$g(idxbuild))    ;Set index's build flag (idxbuild=1 means IMMEDIATE, 0 means DEFER)
	d:token'=$c(1) error(25)                 ;Should've been the end
	QUIT  ;--- index ---
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;-----  VIEW  -----
view	;  process view
	if $$$mtStatementType="DRV" {
		new holdvals
		do holdcur^%qaqpsl2(.holdvals)
		if $$checkid("IF") {
			if $$check("EXISTS") { set tChkExists=1 } else { do setold^%qaqpsl2(.holdvals) }
		}
	}
	do ParseIdentifier(.tval,.tlow)
	set mt("view",tval)=tlow 
	if $$$mtStatementType="DRV" {	// DPV2507=
		set mt("view",tval,"check exists") = $get(tChkExists)
		set:$$chose(" RESTRICT CASCADE ",.op) mt("view",tval,"behave")=op
		quit
	}
	set:tReplaceView mt("view",tval,"replace")=1	// DPV3919=
	i $$check("(") {  // --- Process <as-field> List --- 
		s %viewas("as")=1,%viewas("as",1)="("
		f i=1:1 {
			s %viewas("as",%viewas("as"))=$g(%viewas("as",%viewas("as")))_$s(i>1:", ",1:"")_$s(%delid=2:$$quoter(lower),1:lower) 
			d skip("ID") 
			q:'$$check(",")  
			s:$l(%viewas("as",%viewas("as")))>150 %viewas("as")=%viewas("as")+1
		}
		s %viewas("as",%viewas("as"))=%viewas("as",%viewas("as"))_")"
		d skip(")")
	}
	#; PVA050: query now has a third argument. 
	d skip("AS"),mark
	// --- Making sure this is a <select statement> only OR a CTE <with clause> followed by a <select statement> --- 
	// code also appears in gview^%qaqpsq
	if token="WITH" { // --- Process the CTE's <with clause> ---
		do skip("WITH"), cte^%qaqpsq1(1) // Skip over the CTE's <with clause> ::= WITH <with list>  [See 'sqlbnf.txt' for details]
	}
	do query^%qaqpsq(0,0,0)
	  #;  This allows ORDER BY in the fake CREATE VIEW statement Dan compiles with "recount"
	  #;  when determining the ROWSPEC of an %SQLQuery query
	if callname="recount"  ; AK456
	   {d order^%qaqpsq1}
	else {do:value="ORDER"&&(token="ID") error(143)} // PVA243, PVA266
	d copyq
	If $$check("WITH") {  // DPV1693+
		If $$check("READ") { d skip("ONLY") s mt("view",tval,"updatable")=0 }
		ElseIf $$check("CASCADE") { s mt("view",tval,"check option")="C" d skip("CHECK"),skip("OPTION") }
		ElseIf $$checkid("CASCADED") { s mt("view",tval,"check option")="C" d skip("CHECK"),skip("OPTION") }
		ElseIf $$check("LOCAL") { s mt("view",tval,"check option")="L" d skip("CHECK"),skip("OPTION") }
		ElseIf $$check("CHECK") { s mt("view",tval,"check option")="C" d skip("OPTION") i $$check("CONSTRAINT") d skip("ID") }
	}  // DPV1693-
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
copyq	n l2,m2  ;  copy the query that ends here
	s l2=line,m2=f-1  ;  f = <beginning of next token>
	f m2=m2:-1 q:$e(sql,m2)'=" "  ;  skip spaces backwards at the end
	i l1=l2 d addq(sql,m1+$S(input:$L(sql)-$L(input(l1)),1:0),m2) q
	s m2=m2-$L(sql)+$L($g(input(l2)))  ; compensate for previous line overflow	// DPV2111 $Get()
	s:m2<0 m2=0	// DPV1772=
	#; end of last token may be a few lines up, as in "select a  |from| b"
	f  q:m2>0  s l2=l2-1,m2=m2+$L(input(l2)) f m2=m2:-1 q:$e(input(l2),m2)'=" "
	#;  extract:  from input(l1) position m1, to input(l2) position m2
	f l1=l1:1:l2 d addq(input(l1),m1,$S(l1=l2:m2,1:$$$MaxStringLength)) s m1=1	// DPV2246 (Use Max str length instead of 999)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mark	s l1=line,m1=f  ;  mark the beginning of the expression
	QUIT:line<2     ;  no overflow on first (or only) line
	#;  note that sql = <k last characters from line-1> _ input(line)
	s m1=m1-$L(sql)+$L(input(l1))  ; compensate for previous line overflow
	f  q:m1>0  s l1=l1-1,m1=m1+$L(input(l1))  ;  might be in prev. lines
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
addq(x,m1,m2) ;  extract from x, positions m1:m2, and add to mt("query")
	s $$$mtQueryCount=$g($$$mtQueryCount)+1,$$$mtQueryText($$$mtQueryCount)=$e(x,m1,m2) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
role	if $$$mtStatementType="ALR" { new action,name set action="ALTER",name="ROLE" do error(56) RETURN }
	if $$$mtStatementType="DRR" {
		new holdvals
		do holdcur^%qaqpsl2(.holdvals)
		if $$checkid("IF") {
			if $$check("EXISTS") { set $$$mtRoleExists=1 } else { do setold^%qaqpsl2(.holdvals) }
		}
	}
	set $$$mtRoles=lower
	do skip("ID")
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#IF 1   ; DPV1486+
procedure ; Parse CREATE [ OR REPLACE ] FUNCTION/METHOD/PROCEDURE/QUERY
	new %COSParse,COScode,dt,externalSupported,item,item2,lang,ph,plow,pval,quit,savedelid,schema  // DPV1683 (dt)
		#;  Parse the FUNCTION/METHOD/PROCEDURE/QUERY name
	do ParseIdentifier(.tval,.tlow)
	set schema=$$$AllButLastPiece(tlow,".")
	if schema'="_CURRENT_USER" { set schema=$$GetPackage^%apiDDL(schema) } // schema is now actually a package name
	set tval=$tr($$$LastPiece(tval,"."),$c(2),"."),tlow=$tr($$$LastPiece(tlow,"."),$c(2),".")
	$$$MakeProc(tval,tlow,ph)
	if $$$mtStatementType="CRP" { $$$SetProcType(ph,"create proc") }
	if $$$mtStatementType="CRM"||($$$mtStatementType="CRF") { $$$SetProcType(ph,"create method") }
	if $$$mtStatementType="CRQ" { $$$SetProcType(ph,"create query") }
		#; tChkExists is TRUE for CREATE OR REPLACE ...
		#; Capture the $$$ProcType before it's changed later as we want to call the proper drop function
	if $get(tChkExists) { $$$SetProcTempDrop(ph) }
	
		#;
		#;  Parse the parameter list
		#;       <parameter list> ::= '(' <parameter declaration> [ { ',' <parameter declaration> }... ] ')'
		#;       <parameter declaration> ::= [ IN | INOUT | OUT ] <parameter-name> <data-type> [ <default clause> ]
		#;                                   // use the DDL Datatype mapping table to determine the Object type
		#;                                   // If parameter mode is omitted, the default is IN
		#;       <default clause> ::= '=' <expression> | DEFAULT <expression>
		#;
	$$$SetProcParams(ph,$$ParseParameters())
		#;
		#;  Parse the method-query characteristics
		#;        <method-query characteristics> ::= 
		#;                                 [ RETURNS <data type> ]
		#;                                 | [ RESULTS <result set clause> ] // Not for methods
		#;				   | [ RESULT SETS ]		     			// CREATE METHOD, CREATE PROC only, ReturnResultSets, same as DYNAMIC RETURN SETS <n>
		#;				   | [ [ DYNAMIC ] RESULT SETS [ <integer> ] ]		// CREATE METHOD, CREATE PROC only, ReturnResultSets, same as RESULT SETS
		#;                                 | [ CONTAINID = <integer> ]       // Only for statements creating a query
		#;                                 | [ SELECTMODE <select mode> ]    // DPV1737 OK for methods!  ;;Only for statements creating a query
		#;                                 | [ FOR <qualified classname> ]
		#;                                 | [ FINAL ]
		#;                                 | [ PRIVATE ]
		#;                                 | [ PROC[EDURE] [ <qualified SPname> ] ]
		#;                                        // optional FOR clause to specify the class name is for all cases
		#;                                        // optional PROC clause declares a method or a query as a SP,
		#;                                        // and optionally provides an SP name
		#;        
		#;        <result set clause> ::= ( <result column> [ { ',' <result column> } ... ] | DYNAMIC )
		#;                                // DYNAMIC not supported for now
		#;        <result column> ::= <column-name> <data-type>
		#;        <select mode> ::= RUNTIME | ODBC | LOGICAL | DISPLAY
		#;
	for  {
		if $$checkid("CONTAINID") { if $$$ProcContainId(ph)'="" { set item="CONTAINID" do error(44) } $$$SetProcContainId(ph,value) do skip(9) continue }
		if $$checkid("FINAL") { if $$$ProcFinal(ph)'="" { set item="FINAL" do error(44) } $$$SetProcFinal(ph,1) continue }
		set:%delid %delid=3
		if $$check("FOR") {
			if $$$ProcClassName(ph)'="" { set item="FOR" do error(44) }
			set op="" for i=1:1 { set op=op_$e(".",op'="")_lower do lext quit:'$$check(".") }
			if $l(op,".")=1 { set op=schema_"."_op }
			$$$SetProcClassName(ph,op)
			set:%delid=3 %delid=1
			continue
		}
		set:%delid=3 %delid=1
		if $$checkid("PRIVATE") { if $$$ProcPrivate(ph)'="" { set item="PRIVATE" do error(44) } $$$SetProcPrivate(ph,1) continue }
		if $$checkid("PROC")||$$check("PROCEDURE") { if $$$ProcProcedure(ph)'="" { set item="PROCEDURE" do error(44) } $$$SetProcProcedure(ph,1) continue }
		if ($$$mtStatementType="CRM"||($$$mtStatementType="CRP")),$$checkid("RESULT") { do skipid("SETS") if $$$ProcReturnResultSets(ph)'="" { set item="RESULTS SETS" do error(44) } $$$SetProcReturnResultSets(ph,1) continue }
		if ($$$mtStatementType="CRM"||($$$mtStatementType="CRP")),$$checkid("DYNAMIC") { do skipid("RESULT"),skipid("SETS") if $$check(9) {} if $$$ProcReturnResultSets(ph)'="" { set item="RESULTS SETS" do error(44) } $$$SetProcReturnResultSets(ph,1) continue }
		if $$checkid("RESULTS") {
			if $$$ProcRowSpec(ph)'="" { set item="RESULTS" do error(44) }
			do skip("(") $$$SetProcRowSpec(ph,"")
			for  {
				set i=lower d lext
				set dt=$$datyp()
				set:dt="CStream%String" dt="%Library.GlobalCharacterStream"
				set:dt="BStream%String" dt="%Library.GlobalBinaryStream"
				$$$SetProcRowSpec(ph,$$$ProcRowSpec(ph)_$e(",",$$$ProcRowSpec(ph)'="")_i_":"_dt)
				if '$$check(",") { do skip(")") quit }
			}
			continue
		}
		if $$checkid("RETURNS") {
			if $$$ProcReturnType(ph)'="" { set item="RETURNS" do error(44) } 
			set dt=$$datyp()
			set:dt="CStream%String" dt="%Library.GlobalCharacterStream"
			set:dt="BStream%String" dt="%Library.GlobalBinaryStream"
			$$$SetProcReturnType(ph,dt)
			continue
		}
		if $$checkid("SELECTMODE") { if $$$ProcSelectMode(ph)'="" { set item="SELECTMODE" do error(44) } set i=$$anyid(" RUNTIME ODBC LOGICAL DISPLAY ",.op) $$$SetProcSelectMode(ph,op) continue }
		quit  ; No [more] method-query characteristics found
	}
 
	  #;  CREATE PROC and CREATE FUNC always creates a stored procedure
	set externalSupported=0
	if $$$mtStatementType="CRP"||($$$mtStatementType="CRF") { set externalSupported=1 $$$SetProcProcedure(ph,1) }
 
		#;
		#;  Parse the code body
		#;              <code body> ::= [ LANGUAGE SQL ] <sql method body>
		#;                        | LANGUAGE OBJECTSCRIPT <COS method body>
		#;                        | LANGUAGE COS <COS method body>
		#;                        | LANGUAGE PYTHON <Python method body>
		#;                        | LANGUAGE OBJECTSCRIPT <COS query body>
		#;                        | LANGUAGE COS <COS query body>
		#;                              | LANGUAGE <external-language> <external-code-body>  -- CREATE FUNCTION/PROCEDURE only
		#;        <sql method body> ::= BEGIN { <sql statement> ';' } ... END
		#;                              // A beginning of supporting SQL procedural language
		#;                              // For a query, it's only one SELECT statement
		#;        <COS query body> ::= [ GETINFO <parameter list> <COS method body> ]
		#;                             EXECUTE <parameter list> <COS method body>
		#;                             FETCH <parameter list> <COS method body>
		#;                             [ FETCHROWS <parameter list> <COS method body> ]
		#;                             [ CLOSE <parameter list> <COS method body> ]
		#;        <COS method body> ::= '{' <one or more lines of COS code> '}'
		#;        <Python method body> ::= '{' <one or more lines of Python code> '}'
		#;
		#;        <external-language> ::= JAVA | PYTHON | DOTNET
		#;        <external code body> ::= EXTERNAL [ NAME <external routine name> ]
		#;            [ <parameter style clause> ]            -- Not supported in initial version
		#;            [ <transform group specification> ]     -- Not supported in initial version
		#;            [ <external security clause> ]          -- Not supported in initial version
		#;        <external routine name> ::= <string_literal>
		#;
	if $$check("LANGUAGE") {
		if externalSupported {
			if '$$anyid(" SQL OBJECTSCRIPT COS JAVA PYTHON DOTNET ",.lang) { new t set t="'SQL', 'OBJECTSCRIPT', 'JAVA', 'PYTHON', or 'DOTNET'" do error(1)	}
		} else {
			if $$$ProcType(ph)="create query" { if '$$anyid(" SQL OBJECTSCRIPT COS ",.lang) { new t set t="'SQL', or 'OBJECTSCRIPT'" do error(1) }}				// query does not support python
			else                              { if '$$anyid(" SQL OBJECTSCRIPT COS PYTHON ",.lang) { new t set t="'SQL', 'OBJECTSCRIPT', or 'PYTHON'" do error(1) }}	// proc / function / method supports python
		}
	} else { set lang="SQL" }
	set:lang="OBJECTSCRIPT" lang="COS"
		#; MJG029 - Mark that we need to check for %Development:USE privilege in %SYS.SQLSRV
	do:lang'="SQL" requireDevelopmentPrivilege()
.
	if $case(lang,"JAVA":1,"PYTHON":1,"DOTNET":1,:0) {
		if lang="PYTHON" {
			goto:'$$check("EXTERNAL") notexternal
		} else {
			do skip("EXTERNAL")
		}
		$$$SetProcExternal(ph,1)
		if $$checkid("NAME") {
			$$$SetProcExternalRoutineName(ph,value)
			do skip(9)
		} else {
			$$$SetProcExternalRoutineName(ph,$$$ProcName(ph))
		}
		if $$$ProcClassName(ph)'="" { set item="FOR <classname>",item2="EXTERNAL PROCEDURE/FUNCTION" do error(47) }
		$$$SetProcType(ph,"create method")	// This also sets $$$Dop
		$$$SetProcExternalLanguage(ph,lang)
	}
notexternal	//
.
		#;  Define the classname if there was no FOR clause
	if $$$ProcClassName(ph)="" { $$$SetProcClassName(ph,schema_"."_$s($$$mtStatementType="CRF":"func",$$$mtStatementType="CRM":"meth",$$$mtStatementType="CRP":"proc",1:"query")_$tr($$$ProcName(ph),$$$GetIdTrxFrom,$$$GetIdTrxTo)) }
.
	if lang="SQL" {
		new code,extab,lval,mtsave,negate,ptln,savel1,savem1,sqlcode,statementcnt,%viewinfo,vname,vType,vVal
		merge mtsave=mt
		kill code
		set code=0,extab="",vType="",vVal=""
		do skip("BEGIN")
		for statementcnt=1:1 {
			do mark    // l1,m1 now the beginning of the SQL code, save them
			set savel1=l1,savem1=m1
			kill mt,%viewinfo
			set mt="mt",mt("sqlcomp")=mtsave("sqlcomp"),$$$mtPActiveQbs="",$$$mtStatementType=$e(token,1,3)
			set:$g(value)="START" $$$mtStatementType=value
			set:$g(value)="%INTRANSACTION" $$$mtStatementType=value
			kill ptln
			merge ptln=$$$ptlnRoot
			kill $$$ptlnRoot	  // just in case, save any ptln() - although I don't think it will be defined here.
			if $$checkid("RETURN") {
				set negate=""
				if '$$check("+"),$$check("-") { set negate="-"}
				do varcon^%qaqpslx
				if vVal="" { set vType=$$$mtVType($$$mtV(val)),vVal=$p($$$mtV(val),"^",2) }
				set:negate="-" vVal="-"_vVal
			}
			else { do stat^%qaqpsq1 }          // Parse a single statement
			set l1=savel1,m1=savem1   // restore l1,m1
			kill sqlcode
			do CutCOSCode^%qaqpDDLParser2(.sqlcode) // k code s code=0
			if $$$ProcType(ph)="create method" {
				if 'code { set code($i(code))=$c(9)_"New SQLCODE,%ROWID,%ROWCOUNT" ,code($i(code))="#SQLCOMPILE SELECT="_$s($$$ProcSelectMode(ph)'="":$$$ProcSelectMode(ph),1:"LOGICAL") }
				if vVal="" { do SQLToEmbeddedSQL(.code,.sqlcode) }
			}
			if $$$ProcType(ph)="create query" { merge code=sqlcode }
			if $$$ProcType(ph)="create proc" {
				if statementcnt = 1 {
					merge code=sqlcode
				} elseif statementcnt=2 {
					new sqlcode1
					merge sqlcode1=code
					kill code
					do SQLToEmbeddedSQL(.code,.sqlcode1)
					if vVal="" { do SQLToEmbeddedSQL(.code,.sqlcode) }
				} else {
					if vVal="" { do SQLToEmbeddedSQL(.code,.sqlcode) }
				}
			}
			kill mt
			merge mt=mtsave
			kill $$$ptlnRoot
			merge $$$ptlnRoot=ptln
			kill ptln	// restore
			do skip(";")
			quit:$$check("END")
		}
	  #;  If CREATE PROC and a single select (may lead with CTEs) statement, create a query
		if $$$ProcType(ph)="create proc",statementcnt=1,$$firstToken^%qaqpreparser(.sqlcode)="SELECT" { $$$SetProcType(ph,"create query") } 
	  #;  Otherwise, create a method
		elseif $$$ProcType(ph)="create proc" {
			$$$SetProcType(ph,"create method")
			if statementcnt=1 {
				merge sqlcode=code
				kill code
				do SQLToEmbeddedSQL(.code,.sqlcode)
			}
			for i=code+2:-1:3 { set code(i)=code(i-2) }
			set code=code+2
			set code(1)=$c(9)_"New SQLCODE,%ROWID,%ROWCOUNT",code(2)="#SQLCOMPILE SELECT="_$s($$$ProcSelectMode(ph)'="":$$$ProcSelectMode(ph),1:"LOGICAL")  // Insert NEW as first line, #SQLCOMPILE as second
		}
		if $$$ProcProcedure(ph),$$$ProcType(ph)="create method" {
	   #;  If the user did specify a %SQLProcContext as the first parameter - use its variable name, otherwise %sqlcontext
			new pcvar
			if $p($p($$$ProcParams(ph),":",2),",")'="%SQLProcContext" {
				set pcvar="%sqlcontext"
			} else {
				set pcvar=$p($p($$$ProcParams(ph),":"),"(",2)
			}
			set:$e(pcvar)="&" pcvar=$e(pcvar,2,*)
			set code($i(code))=$c(9)_"If $Get("_pcvar_")'=$$$NULLOREF Set "_pcvar_".%SQLCODE=SQLCODE,"_pcvar_".%ROWCOUNT=%ROWCOUNT"
		}
		if $$$ProcType(ph)="create query" { $$$SetProcQueryType(ph,"%Library.SQLQuery") }
		if $$$ProcType(ph)="create method" {
			if vVal'="" {
				if vType="x" { set code($i(code))=$c(9)_"RETURN "_vVal }
				elseif vType="t" {
					if $isvalidnum(vVal) { set code($i(code))=$c(9)_"RETURN "_vVal }
					else { set code($i(code))=$c(9)_"RETURN """_vVal_"""" }
				}
				else { set code($i(code))=$c(9)_"RETURN """"" }
			}
			else { set code($i(code))=$c(9)_"RETURN """"" }
		}
		$$$SetProcMethodCode(ph,code)
		$$$SetProcMethodCodeLineCount(ph,code)
	}
		#;
	if lang="COS" {
		new cbcnt
		set cbcnt=0
		#; It might just be a COS method body or CREATE PROC creating a method
		if $$$ProcType(ph)="create method"||($$$ProcType(ph)="create proc"&&(token="{")) {
			do ParseCOSCode $$$SetProcMethodCode(ph,COScode) $$$SetProcMethodCodeLineCount(ph,COScode)
			if $$$ProcType(ph)="create proc" { $$$SetProcType(ph,"create method") }
		} else {
		#;  Must be a COS query body...
		#;  If CREATE PROC, it must be creating a query
			if $$$ProcType(ph)="create proc" { $$$SetProcType(ph,"create query") }
			$$$SetProcQueryType(ph,"%Library.Query")
			for  {
				if $$checkid("GETINFO")   { if $$$ProcGetInfoCodeLineCount(ph)   { set item="GETINFO" do error(45) } $$$SetProcGetInfoParams(ph,$$ParseParameters()) do ParseCOSCode $$$SetProcGetInfoCode(ph,COScode) $$$SetProcGetInfoCodeLineCount(ph,COScode) continue }
				if $$check("EXECUTE")     { if $$$ProcExecuteCodeLineCount(ph)   { set item="EXECUTE" do error(45) } $$$SetProcExecuteParams(ph,$$ParseParameters()) do ParseCOSCode $$$SetProcExecuteCode(ph,COScode) $$$SetProcExecuteCodeLineCount(ph,COScode) continue }
				if $$check("FETCH")       { if $$$ProcFetchCodeLineCount(ph)     { set item="FETCH" do error(45) } $$$SetProcFetchParams(ph,$$ParseParameters()) do ParseCOSCode $$$SetProcFetchCode(ph,COScode) $$$SetProcFetchCodeLineCount(ph,COScode) continue }
				if $$checkid("FETCHROWS") { if $$$ProcFetchRowsCodeLineCount(ph) { set item="FETCHROWS" do error(45) } $$$SetProcFetchRowsParams(ph,$$ParseParameters()) do ParseCOSCode $$$SetProcFetchRowsCode(ph,COScode) $$$SetProcFetchRowsCodeLineCount(ph,COScode) continue }
				if $$check("CLOSE")       { if $$$ProcCloseCodeLineCount(ph)     { set item="CLOSE" do error(45) } $$$SetProcCloseParams(ph,$$ParseParameters()) do ParseCOSCode $$$SetProcCloseCode(ph,COScode) $$$SetProcCloseCodeLineCount(ph,COScode) continue }
				quit
			}
		#; Execute and Fetch methods are required
			if '$$$ProcExecuteCodeLineCount(ph) { set item="EXECUTE" do error(46) }
			if '$$$ProcFetchCodeLineCount(ph)   { set item="FETCH"   do error(46) }
		}
	}
.
	if lang="PYTHON",$$$ProcExternalLanguage(ph)="" {	// Don't parse Python code block if this is an external language proc/func
		$$$SetProcLanguage(ph,"python")
		if $$$ProcType(ph)="create proc" { $$$SetProcType(ph,"create method") }
		new code
		do ParsePythonCode(.code)
		$$$SetProcMethodCode(ph,code) $$$SetProcMethodCodeLineCount(ph,code)
	} else {
		$$$SetProcLanguage(ph,"objectscript")
	}
.
	do:token'=$c(1) error(25) ; Should've been the end
		#;  Validation
	if $$$ProcType(ph)="create method" {
		if $$$ProcRowSpec(ph)'="" { set item="RESULTS",item2="METHOD" do error(47) }
		if $$$ProcContainId(ph)'="" { set item="CONTAINID",item2="METHOD" do error(47) }
	}
	if $$$ProcType(ph)="create query" {
		if $$$ProcReturnType(ph)'="" { set item="RETURNS",item2="QUERY" d error(47) }
		if $$$ProcPrivate(ph)'=""    { set item="PRIVATE",item2="QUERY" d error(47) }
	}
	RETURN
.
	//	CREATE [ OR REPLACE ] AGGREGATE name ( [ parameter-name ] parameter-data-type [, ... ] )
	//	    [ RETURNS return-data-type ]                     -- when not specified, defaults to first parameter type
	//	    [ INITIALIZE WITH initialize-function-name ] 
	//	    ITERATE WITH iterate-function-name
	//	    [ MERGE WITH merge-function-name ]               -- when not specified, the UDAF will never be parallelized
	//	    [ FINALIZE WITH finalize-function-name ]
	//
aggregate	// Parse CREATE AGGREGATE
	new handle,schema
	if $$$mtStatementType="DRA" {
		new holdvals
		do holdcur^%qaqpsl2(.holdvals)
		if $$checkid("IF") {
			if $$check("EXISTS") { set tChkExists=1 } else { do setold^%qaqpsl2(.holdvals) }
		}
	}
	do ParseIdentifier(.tval,.tlow)
	set schema=$$$AllButLastPiece(tlow,".")
	set tval=$tr($$$LastPiece(tval,"."),$c(2),"."),tlow=$tr($$$LastPiece(tlow,"."),$c(2),".")
	$$$MakeUDAF(tval,tlow,handle)
	$$$SetUDAFSchema(handle,schema)
	$$$SetUDAFreplace(handle,replaceAggregate)
	if $$$mtStatementType="DRA" {
		$$$SetUDAFop(handle,"drop aggregate")
		$$$SetUDAFDropIfExists(handle,$get(tChkExists))
		RETURN	// DROP AGGREGATE - nothing more to parse
	} else { $$$SetUDAFop(handle,"create aggregate") }
	
	$$$SetUDAFParams(handle,$$ParseUDAFParameters())
	if $$checkid("RETURNS") {
		$$$SetUDAFReturnType(handle,$$datyp())
	}
	if $$checkid("INITIALIZE") {
		do skip("WITH")
		do ParseIdentifier(.tval,.tlow)
		$$$SetUDAFInitFunc(handle,tlow)
	}
	do skipid("ITERATE")
	do skip("WITH")
	do ParseIdentifier(.tval,.tlow)
	$$$SetUDAFIterFunc(handle,tlow)
	if $$checkid("MERGE") {
		do skip("WITH")
		do ParseIdentifier(.tval,.tlow)
		$$$SetUDAFMergeFunc(handle,tlow)
	}
	if $$checkid("FINALIZE") {
		do skip("WITH")
		do ParseIdentifier(.tval,.tlow)
		$$$SetUDAFFinalFunc(handle,tlow)
	}
	RETURN
.
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ParseParameters() ;
	#;  Parse the parameter declaration and return the COS method parameter string
	n dt,foo,i,param,quit
	d skip("(") i $$check(")") s param="()" QUIT param
	s param="("
	s quit=0 f i=1:1 d  i quit s param=param_")" q
	. i $$check("IN") i 1
	. e  i $$checkid("INOUT") s param=param_"&" i 1
	. e  i $$checkid("OUT") s param=param_"*"
	. i token=$c(1) n t s t="<parameter>" d error(1) s quit=1 q  	// DPV2108=
	. s param=param_lower d lext   ; Add on variable name (<parameter name>)
	. s dt=$$datyp()
	. s:dt="CStream%String" dt="%Library.GlobalCharacterStream"
	. s:dt="BStream%String" dt="%Library.GlobalBinaryStream"
	. s param=param_":"_dt  ; Add on ":"_<data-type>
	. i $$check(")") s quit=1 q
	. i $$check(",") s param=param_"," q
	. i $$check("DEFAULT")   ; optional DEFAULT keyword
	. s foo=$$setdef() s:foo="~~~@@@MakeItNULL@@@~~~" foo=""
	. s param=param_"="_foo  ; Add on "="_<default clause>
	. i $$check(")") s quit=1 q
	. s param=param_"," d skip(",")
	RETURN param
 
ParseUDAFParameters() ;
	#;  Parse the User Defined Aggregate parameter declaration and return the IRIS method parameter string
	#; Syntax supported is:
	#; 	( <parameter_name> <datyp> { , <parameter_name> <datyp> } )
	#; Parameter names are not validated or used for anything.  Original confluence design had the panme as optional, but this is ambiguous to parse.
	#;
	new dt,i,param
	do skip("(")
	set param=""
	for i=1:1 {
		set param=param_lower		// Add on parameter name
		do skip("ID")			// skip parameter name
		set dt=$$datyp()
		set param=param_":"_dt		// Add on ":"_<data-type>
		quit:$$check(")")
		if $$check(",") { set param=param_"," }
	}
	RETURN param
 
ParseCOSCode ;
	#;  We are going to 'parse' over the COS code.  The COS code is within { ... } brackets.
	n l1,m1 s %COSParse=1
	s mask=$$MASK(sql)_$c(1)  // Reset mask for COS parser so ', " are included in mask
	d skip("{")
	i token=$c(1) n t s t="<ObjectScript code block>" d error(1) q  	// DPV1889=
	d mark ; l1,m1 now the beginning of the COS code
	For  {
		i token="}"&&(cbcnt=0)&&('$$$InQuote(input(line),p-($l(sql)-$l(input(line)))))&&($$NotInComment(input(line),"}",p-($l(sql)-$l(input(line))))) q  	// DPV2173
		s:token="}"&&('$$$InQuote(input(line),p-($l(sql)-$l(input(line)))))&&($$NotInComment(input(line),"}",p-($l(sql)-$l(input(line))))) cbcnt=cbcnt-1	// DPV2173
		s:token="{"&&('$$$InQuote(input(line),p-($l(sql)-$l(input(line)))))&&($$NotInComment(input(line),"{",p-($l(sql)-$l(input(line))))) cbcnt=cbcnt+1	// DPV2173
		d lext
		q:token=$c(1)  	// Found end of code without, must be missing a '}'
	}
	d CutCOSCode^%qaqpDDLParser2(.COScode)  ; We now know where the COS code begins and ends - get it.
	k %COSParse
	s mask=$$MASK(sql)_$c(1)  // Reset mask
	d skip("}")
	QUIT    
.
ParsePythonCode(&pycode) ;
		#;  We are going to 'parse' over the Python code.  The Python code is within { ... } brackets.
		#;  The next token to parse must be '{'
	new %PythonParse,%mmmNoDelidCheck,cbcnt,closebraceline,closebracepos,l1,m1,openbraceline,openbracepos,xx
	set pycode=0,cbcnt=0,%mmmNoDelidCheck=1
	set %PythonParse=1
	set mask=$$MASK(sql)_$c(1)  // Reset mask for COS parser so ', " are included in mask
	do mark
	set openbraceline=l1,openbracepos=m1
	do skip("{")
	if token=$c(1) { new t set t="<Python code block>" do error(1) }
	for  {
		if token="}",('$$$InQuote(input(line),p-($l(sql)-$l(input(line))))) { 
			if 'cbcnt { do mark set closebraceline=l1,closebracepos=m1 quit }
			set cbcnt=cbcnt-1
		} elseif token="{",('$$$InQuote(input(line),p-($l(sql)-$l(input(line))))) {
			set cbcnt=cbcnt+1
		}
		do lext
		quit:token=$c(1)  	// Found end of code, must be missing a '}'
	}
	kill %PythonParse
	set mask=$$MASK(sql)_$c(1)  // Reset mask
	if openbraceline=closebraceline {	// all python code is on one line
		set pycode($i(pycode))=$e(input(openbraceline),openbracepos+1,closebracepos-1)
	} else {
		for line=openbraceline:1:closebraceline {
			if line=openbraceline { set pycode($i(pycode))=$e(input(line),openbracepos+1,*) }	// grab code from position after '{' to the end of the line
			elseif line=closebraceline { set xx=$e(input(line),1,closebracepos-1) set:$zstrip(xx,"*W")'="" pycode($i(pycode))=xx }	// grab code from position 1 to positions before '}' as long as it is not just whitespace
			else { set pycode($i(pycode))=input(line) }
		}
	}
	do skip("}")
	RETURN
.
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
NotInComment(str,c,pos) [] PUBLIC {	// DPV2173+
		#;  Given a string, a substring, and a position in the string, return 1 if the substring is not in a comment
		#;  If the substring is in a comment, return 0.
	If $$find^%qarmac(str,c,1,pos)=0 QUIT 0
	QUIT 1
}	// DPV2173-
 
SQLToEmbeddedSQL(code,sqlcode) [] PUBLIC {
		#;  Copy SQL code in sqlcode() into an embedded SQL statement in code()
	if sqlcode=1 {
		set sql=$$$StripLeadingWhiteSpace(sqlcode(1))
		if sql'["--" { set code($i(code))=$c(9)_"&sql("_sql_")" }
		else { set code($i(code))=$c(9)_"&sql("_sql,code($i(code))=$c(9)_")" }	// code might end in -- comment
		RETURN
	} elseif sqlcode=2 {
		set code($i(code))=$c(9)_"&sql("_$$$StripLeadingWhiteSpace(sqlcode(1))
		set sql=sqlcode(2)
	} else {	// >2 lines of sqlcode
		set code($i(code))=$c(9)_"&sql("_$$$StripLeadingWhiteSpace(sqlcode(1))
		for i=2:1:sqlcode-1 { set code($i(code))=$c(9)_sqlcode(i) }
		set sql=sqlcode(sqlcode)
	}
		#; generate last line for > 2 lines of code
	if sql'["--" { set code($i(code))=$c(9)_sql_")" }
	else { set code($i(code))=$c(9)_sql,code($i(code))=$c(9)_")" }	// code might end in -- comment
	RETURN
}
.
dropproc ; Parse DROP FUNCTION/METHOD/PROCEDURE/QUERY
	new holdvals,op,ph,plow,pval,quit,schema,type
		#;  Parse the FUNCTION/METHOD/PROCEDURE/QUERY name
	do holdcur^%qaqpsl2(.holdvals)
	if $$checkid("IF") {
		if $$check("EXISTS") { set tChkExists=1 } else { do setold^%qaqpsl2(.holdvals) }
	}
	do ParseIdentifier(.tval,.tlow)
	set schema=$$$AllButLastPiece(tlow,".")
	set:(schema'="_CURRENT_USER") schema=$$GetPackage^%apiDDL(schema,1) // schema is now actually a package name
	set tval=$translate($$$LastPiece(tval,"."),$c(2),".")
	set tlow=$translate($$$LastPiece(tlow,"."),$c(2),".")
	$$$MakeProc(tval,tlow,ph)
	$$$SetProcDropIfExists(ph,$get(tChkExists))
	set type = $case($$$mtStatementType,
		"DRP": "drop proc",
		"DRM": "drop method",
		"DRF": "drop method",
		"DRQ": "drop query")
	$$$SetProcType(ph,type)
	new %delid set %delid=3
	if $$check("FROM") {
		set op=""
		for i=1:1 {
			set op=op_$extract(".",op'="")_lower
			do lext
			quit:'$$check(".")
		}
		if $length(op,".")=1 { set op=schema_"."_op }
		$$$SetProcClassName(ph,op)
	} else {
		$$$SetProcClassName(ph,"*"_schema)  ; * marks the classname as being the package only
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#ENDIF  ; DPV1486-
 
	#; CREATE DATABASE
	#;  At this point CREATE DATABASE has been parsed
	#;
	#;	CREATE DATABASE [ FILE ] database_name [ ON DIRECTORY [ = ] <directory_name> ] [ WITH  <option> { <option> } ]
	#;
	#;	<option> ::=
	#;		ENCRYPTED_DB |
	#;		GLOBAL_JOURNAL_STATE [ = ] { YES | NO } |
	#;
	#;	<option>s may appear in any order, but may only appear once
	#;
	#; DROP DATABASE
	#;  Parse IF EXISTS (if specified)
	#;
	#;	DROP DATABASE [ IF EXISTS ] database_name [ RETAIN_FILES ]
	#;
	#; USE DATABASE
	#;	USE DATABASE database_name
	#;
database	
	new i,createDatabaseFile,tDBHandle
	if $$$mtStatementType="DRD" {
		new holdvals
		do holdcur^%qaqpsl2(.holdvals)
		if $$checkid("IF") {
			if $$check("EXISTS") { set tChkExists=1 } else { do setold^%qaqpsl2(.holdvals) }
		}
	}
	set createDatabaseFile=($$$mtStatementType="CRD" && $$checkid("FILE")) // JMM1298=
	$$$MakeDatabase(value,lower,tDBHandle)			// Create Database Handle
	$$$SetUserName(tDBHandle,lower)
	do skip("ID")						// Database Name
.
	if $$$mtStatementType="USD" {	// USE DATABASE
		$$$SetDatabaseOperation(tDBHandle,"use database")
		$$$SetUserName(tDBHandle,lower) 
		QUIT
	}
.
	if $$$mtStatementType="DRD" {	// DROP DATABASE
		$$$SetDatabaseOperation(tDBHandle,"drop database")
		$$$SetUserName(tDBHandle,lower) 
		$$$SetDatabaseDropIfExists(tDBHandle,$get(tChkExists))
		if $$checkid("RETAIN_FILES") { $$$SetRetainFiles(tDBHandle,1) }
		QUIT
	}
		// CREATE DATABASE
	if createDatabaseFile { // JMM1298+
		$$$SetDatabaseOperation(tDBHandle,"create database file")
	}
	else { // JMM1298-
		$$$SetDatabaseOperation(tDBHandle,"create database")
	} // JMM1298=
	if $$check("ON") {
		if $$checkid("DIRECTORY") {
			if $$check("=") {}
			$$$SetDatabaseDirectory(tDBHandle,value)
			do skip(9)
		}
	}
	if $$check("WITH") {					// parse filespec (directory name)
		for i=1:1:2 {
			if $$checkid("ENCRYPTED_DB") {
				if $$$EncryptedDB(tDBHandle)'="" { set t="GLOBAL_JOURNAL_STATE",token="ENCRYPTED_DB" do error(1) }
				$$$SetEncryptedDB(tDBHandle,1)
			}
			if $$checkid("GLOBAL_JOURNAL_STATE") {
				if $$$GlobalJournalState(tDBHandle)'="" { set t="ENCRYPTED_DB",token="GLOBAL_JOURNAL_STATE" do error(1) }
				if $$check("=") {}		// optional =
				if $$check("NO") { $$$SetGlobalJournalState(tDBHandle,2) }
				elseif $$checkid("YES") { $$$SetGlobalJournalState(tDBHandle,3) }
			}
		}
	}	
	QUIT
	
	#; CREATE MODEL
	#;  At this point CREATE MODEL has been parsed
	#;
	#;  CREATE MODEL [ IF NOT EXISTS ] <model-name> PREDICTING ( <ident> [ <datyp> ] ) [ <with-clause> ] [ <model-source> ] [ <using-clause> ]
	#;
	#;  <model-name> ::= <ident>
	#;  <ident> ::= <identifier> | <delimited identifier>		see sqlbnf for more info on <identifier> and <delimited identifier>
	#;  <datyp> ::= <datyp spec>		see sqlbnf for more info
	#;
	#;	<with-clause-create> ::= WITH ( <model-column> { , <model-column> } )
	#;	<model-column> ::= <ident> <datyp>
	#;
	#;  <model-source> ::= FROM <model-source-query>
	#;  <model-source query> ::= ( <selex> ) |
	#;  		<from> [ WHERE <prdct> ] [ <group> ] [ <having> ] ] [ <order> ]		see sqlbnf for more info on <selex>, <from>, <prdct>, <group>, <having>, and <order>
	#;
	#;	<using-clause> ::= USING <alg description>
	#;	<alg description> ::= <json-string>
	#;
	#; ALTER MODEL
	#;  At this point ALTER MODEL has been parsed
	#;
	#;	ALTER MODEL <model-name> <alter-model-action>
	#;	<alter-model-action> ::= PURGE [ <scope> ]
	#;                               | <DefaultTrainedModel>
	#;	<DefaultTrainedModel> ::= DEFAULT [ TRAINED MODEL ] <trained-model-name>
	#;	<scope> ::= ALL   -- default scope
	#;                 | <integer> DAYS
	#;
	#; DROP MODEL
	#;  Paser IF EXIST (if specified)
	#;
	#;	DROP MODEL [ IF EXISTS ] <model-name>
	#;
	#; TRAIN MODEL
	#;  At this point TRAIN MODEL has been parsed
	#;
	#;	TRAIN MODEL <model-name> [ AS <model-name> ] [ NOT DEFAULT ] [ FOR <model-column> ] [ <with-clause-train> ]  [ <model-source> ]  [ <using-clause> ]
	#;	<with-clause-train> ::= WITH <train-with>
	#;	<train-with> ::= ( <model-column> { , <model-column> } )
	#;                       | <with-value-assignment>
	#;      <with-value-assignment> ::= <ident> = <expresion> { , <ident> = <expresion> }
	#; 
	#; VALIDATE MODEL
	#;  At this point VALIDATE MODEL has been parsed
	#;
	#;	VALIDATE MODEL <model-name> [ AS <model-name> ] [ USE <model-name> ] [ <with-clause-train> ]  [ <model-source> ]  [ <using-clause> ]
.
.
model	new hasfrom,modelcolumn,modelid,withcolcnt,withcolumn,withcolumnq,withlist
	if $case($extract($$$mtStatementType),"C":1,"D":1,:0) {	// CREATE or DROP
		new holdvals
		do holdcur^%qaqpsl2(.holdvals)
		if $$checkid("IF") {
			if $$$mtStatementType="CMDL" { if $$check("NOT") { do skip("EXISTS") set tChkExists=1 } else { do setold^%qaqpsl2(.holdvals) }}	// CRT
			else { if $$check("EXISTS") { set tChkExists=1 } else { do setold^%qaqpsl2(.holdvals) }}								// DRT
		}
	}
	$$$MakeModel(value,lower,modelid)
	do skip("ID")
	$$$SetModelIfExists(modelid,$get(tChkExists))
	if $$$mtStatementType="DMDL" {								// DROP MODEL
		$$$SetModelOperation(modelid,"drop model")
		RETURN
	} elseif $$$mtStatementType="AMDL" {							// ALTER MODEL
		$$$SetModelOperation(modelid,"alter model")
		if $$checkid("PURGE") {
			if token=9 {
					#; Make sure value is a positive integer
				if '$isvalidnum(value)||(value<0)||(value[".") { new t set t="<positive integer>",token=value do error(1) }
				$$$SetModelPurgeDays(modelid,value)
				do skip(9)
				do skipid("DAYS")
			} else {
				if $$check("ALL")
				$$$SetModelPurgeDays(modelid,0)	// Purge all days
			}
		} elseif $$check("DEFAULT") {
			do:$$checkid("TRAINED") skipid("MODEL")
			$$$SetModelDefaultTrainedModel(modelid,lower)
			do skip("ID")
		}
		RETURN
	}
	elseif $$$mtStatementType="TMDL" {								// TRAIN MODEL
		$$$SetModelOperation(modelid,"train model")
		if $$check("AS") {
			$$$SetModelTrainedName(modelid,lower)
			do skip("ID")
		}
		if $$check("NOT") {
			do skip("DEFAULT")
			$$$SetModelTrainNotDefault(modelid,1)
		}
		if $$check("FOR") {
			set modelcolumn=lower do skip("ID")
			if $$check(".") set modelcolumn=modelcolumn_"."_lower do skip("ID")	// qualified field
			$$$SetModelColumn(modelid,modelcolumn)
		}
	}
	elseif $$$mtStatementType="VMDL" {	 							// VALIDATE MODEL
		$$$SetModelOperation(modelid,"validate model")
		if $$check("AS") {
			$$$SetModelValidationName(modelid,lower)
			do skip("ID")
		}
		if $$checkid("USE") {
			$$$SetModelTrainedName(modelid,lower)
			do skip("ID")
		}
	} else { 									// CREATE MODEL
		$$$SetModelOperation(modelid,"create model")
		$$$SetModelTSSelected(modelid,$g(mt("timeseries","selected")))
			#; Now parse the model's column
		do skipid("PREDICTING")
		do skip("(")
		if '$g(mt("timeseries","selected")) {
			set modelcolumn=lower do skip("ID")
			if $$check(".") set modelcolumn=modelcolumn_"."_lower do skip("ID")	// qualified field
			$$$SetModelColumn(modelid,modelcolumn)
			if '$$check(")") { $$$SetModelColumnType(modelid,$$datyp()) do skip(")") }
		}
		else {
			set modelcolumns=""
			set modelcolumntypes=""
			for {
				if $$check("*") {
					set modelcolumns="*"
					if $$check(")") QUIT
				}
				set modelcolumn=lower do skip("ID")
				if $$check(".") set modelcolumn=modelcolumn_"."_lower do skip("ID")
				set modelcolumns=modelcolumns_modelcolumn
				if '$$check(",") {
					if $$check(")") QUIT
					set dtp=$$datyp()
					set modelcolumntypes=modelcolumntypes_dtp
					if $$check(")") QUIT
					do datyp()
				}
				set modelcolumns=modelcolumns_";:"
				set modelcolumntypes=modelcolumntypes_";:"
			}
			$$$SetModelColumn(modelid,modelcolumns)
			$$$SetModelColumnType(modelid,modelcolumntypes)
		}
	}
		#; Parse BY clause if timeseries is selected
	if $g(mt("timeseries","selected"))
	{
		do skipid("BY")
		do skip("(")
		set datecolumn=lower do skip("ID")
		if $$check(".") set datecolumn=datecolumn_"."_lower do skip("ID")	// qualified field
		$$$SetModelDateColumn(modelid,datecolumn)
		do skip(")")
	}
		#; Parse optional WITH clause
	set withcolcnt=0,withlist=""
	if $$check("WITH") {
		if $$$mtStatementType="CMDL" {
			do skip("(")
			do {
				set withcolcnt=withcolcnt+1
				set withlist=withlist_$e(",",withlist'="")_lower
				$$$SetModelWithColumn(modelid,lower,withcolcnt) do skip("ID")
				$$$SetModelWithColumnType(modelid,$$datyp(),withcolcnt)
			} while $$check(",")
			do skip(")")
		} else {	// TRAIN or VALIDATE
			if $$check("(") {	// ( with-col1, with-col2, ..., with-colN )
				do {
					set withcolcnt=withcolcnt+1
					if token=","||(token=")") { $$$SetModelWithColumn(modelid,"",withcolcnt) continue } // column missing, use column from model definition
					set withcolumn=lower,withcolumnq=$$quoter2(lower) do skip("ID")
					if $$check(".") {	// qualified field
						set withcolumn=withcolumn_"."_lower
						set withcolumnq=withcolumnq_"."_$$quoter2(lower)
						do skip("ID")
					}
					set withlist=withlist_$e(",",withlist'="")_withcolumnq
					$$$SetModelWithColumn(modelid,withcolumn,withcolcnt)
					//$$$SetModelWithColumnType(modelid,$$datyp(),withcolcnt)
				} while $$check(",")
				do skip(")")
			} else {		// with-col1 = <expr1>, with-col2 = <expr2>, ... , with-colN = <exprN>
				new colname,expr,expr2
				do {
					set withcolcnt=withcolcnt+1
					set colname=lower
					$$$SetModelWithColumn(modelid,lower,withcolcnt) do skip("ID")
					do skip("=")
					set expr=""
					for  {
						set expr=expr_$s(token="ID":lower,token=9:$$QuoteSQLLiteral(value),1:token)
						if %delid=2,token="ID" { set expr2=$$quoter2(expr) } else { set expr2=expr }
						do lext
						quit:$case(token,",":1,"WITH":1,"(":1,"FROM":1,$c(1):1,:0)
					}
					set withlist=withlist_$e(",",withlist'="")_expr2_" as "_$$quoter2(colname)
					$$$SetModelWithColumnExpression(modelid,expr,withcolcnt)
				} while $$check(",")
			}
		}
	}
		#; Parse model source
	set hasfrom=0
	if $$$mtStatementType="CMDL" {
		if 'withcolcnt && '$g(mt("timeseries","selected")) { do skip("FROM") set hasfrom=1 }	// FROM is required if WITH was not specified
		if $$check("FROM") { set hasfrom=1 }
	} else {  // train or validate model
		if $$check("FROM") { set hasfrom=1 }
	}
	if hasfrom {
		if $$check("(") {	// ( <selex> )
			set $$$mtStatementType="CRV"  // just temporarily!
			do mark,query^%qaqpsq(0,0,0)
			do order^%qaqpsq1
			do copyq	// query text is now in mt("query")
			set $$$mtStatementType="CMDL"
			do skip(")")
		} else {	// <from> [ WHERE <prdct> ] [ <group> ] [ <having> ] ] [ <order> ]
			new select
			if (($$$mtStatementType="TMDL")||($$$mtStatementType="VMDL")),withlist="" {
				// withlist not specified for the TRAIN / VALIDATE statement, see if there are WITHCOLUMNS for the model
				set withlist=$c(2) // place marker in query text to get the withlist from the model at runtime from a call to $$GetModelWithColumns^%apiDDL($$$Dtab)
			}
			if '$g(mt("timeseries","selected")) {
				if $$$mtStatementType="CMDL" { set select="SELECT "_$s(withlist="":"*",1:modelcolumn_", "_withlist)_" FROM " }
				else              { set select="SELECT "_$s(withlist="":"*",1:withlist)_" FROM " }
			}
			else {
				if $$$mtStatementType="CMDL" { set select="SELECT "_$s(withlist="":"*",1:$s(modelcolumns="*":"",1:$REPLACE(modelcolumns,";:",",")_", ")_datecolumn_", "_withlist)_" FROM " }
				else              { set select="SELECT "_$s(withlist="":"*",1:datecolumn_", "_withlist)_" FROM " }
			}
				// skip through the statement until we come to the end or we hit "USING" for the USING clause
			set select=select_" "_$s(token="ID":$s(%delid=2:$$quoter(lower),1:lower),token=9:$$QuoteSQLLiteral(value),1:token)
			for  {
				do lext
				quit:$case(token,$c(1):1,"USING":1,:0)
				Do JSONParm^%qaqpsq(token,value,.jsonParen)
				set select=select_" "_$case(token,"ID":$s(%delid=2:$$quoter(lower),1:lower),9:$$QuoteSQLLiteral(value),"'<":">=","'&":"NOT&","'!":"NOT!","'[":"NOT[","']":"NOT]","'>":"<=","'=":"<>","_":"||",:token)
			}
			set $$$mtQueryCount=1,$$$mtQueryText(1)=select
		}
	}
		#; Parse optional USING clause, which is a JSON style string { "key" : value { ,... } }
	if $$check("USING") {
		new %mmmJSONOBJECT,%mmmNoDelidCheck,bracecnt,jsonobj,using
		set %mmmJSONOBJECT=1,bracecnt=0,%mmmNoDelidCheck=1
		do skip("{")
		set using="{"
			// skip through the USING clause until we hit the end '}'
			// build a JSON string, and then validate it by calling %FromJSON()
		for  {
			quit:token=$c(1)	// hit end of statement
			set:token="{" bracecnt=bracecnt+1
			if token="}" { quit:'bracecnt  set bracecnt=bracecnt-1 }
			set using=using_$e(sql,f,p-1)
			do lext
		}
		kill %mmmJSONOBJECT,%mmmNoDelidCheck
		do skip("}")
		set using=$replace(using,"\""""","\""")_"}"
			#; validate the JSON string
		try {
			set jsonobj=##class(%DynamicAbstractObject).%FromJSON(using)
		} catch ex {
			set t="A valid JSON string",token=using do error(1)			
		}
		set using=jsonobj.%ToJSON()
		$$$SetModelUsing(modelid,using)
	}
	RETURN
.
QuoteSQLLiteral(x) PUBLIC { RETURN $s((x=+x):x,x=$c(0):"''",1:"'"_$replace(x,"'","''")_"'") }
.
	#; CREATE [ OR REPLACE ] ML CONFIGURATION
	#;  At this point CREATE ML CONFIGURATION has been parsed
	#;
	#;	CREATE [ OR REPLACE ] ML CONFIGURATION <mlconfiguration-name> FOR [ PROVIDER ] <provider_name> [ %DESCRIPTION <string-literal> ] [ USING <using-JSON_string> ] [ <provider_specific_settings> ]
	#;
	#;  <mlconiguration-name> ::= <ident>
	#;  <ident> ::= <identifier> | <delimited identifier>		see sqlbnf for more info on <identifier> and <delimited identifier>
	#;
	#;  <provider_name> ::= <ident>		see sqlbnf for more info
	#;
	#;	<using-clause> ::= USING <alg description>
	#;	<alg description> ::= <json-string>
	#;
	#;	<DR options> ::= <DR option> { , <DR option> }              -- DataRobot provider only
	#;	<H2O options> ::= <H2O option> { , <H2O option> }           -- H2O provider only
	#;
	#;	<DR option> ::= URL [ = ] <url_string> 
	#;	               | APITOKEN [ = ] <token_string>
	#;	<H2O option> ::= JAVATLSCONFIGFILE [ = ] <token_string>
	#;	<url_string> ::= <literal> | NULL
	#;	<token_string> ::= <literal> | NULL
	#;
	#; ALTER ML CONFIGURATION
	#;  At this point ALTER ML CONFIGURATION has been parsed
	#;
	#;	ALTER ML CONFIGURATION <mlconfiguration-name> [ USING <using-JSON_string> ] [ <provider_specific_settings> ]
	#;
	#; DROP ML CONFIGURATION
	#;  Parse IF EXISTS (if specified)
	#;
	#;	DROP ML CONFIGURATION [ IF EXISTS ] <mlconfiguration-name>
	#;
.
mlconfiguration
	new altok,mlconfigid
	set altok=0	// Make sure if ALTER ML CONFIG... the user actually is altering something
	if $$$mtStatementType="DMLCONFIG" {
		new holdvals
		do holdcur^%qaqpsl2(.holdvals)
		if $$checkid("IF") {
			if $$check("EXISTS") { set tChkExists=1 } else { do setold^%qaqpsl2(.holdvals) }
		}
	}
	$$$MakeMLConfiguration(value,lower,mlconfigid)
	do skip("ID")
	$$$SetMLConfigurationIfExists(mlconfigid,$get(tChkExists))
	if $$$mtStatementType="DMLCONFIG" {							// DROP ML_CONFIGURATION
		$$$SetMLConfigurationOperation(mlconfigid,"drop mlconfig")
		RETURN
	} elseif $$$mtStatementType="CMLCONFIG" {							// CREATE ML_CONFIGURATION
		$$$SetMLConfigurationOperation(mlconfigid,"create mlconfig")
		do skipid("PROVIDER")
		$$$SetMLConfigurationProvider(mlconfigid,lower)
		if $case($$$LOWER(lower),"automl":0,"h2o":0,"datarobot":0,"pmml":0,:1) { set t="Provider Name: AUTOML, H2O, DATAROBOT, or PMML" do error(1) }
		do skip("ID")
	} elseif $$$mtStatementType="AMLCONFIG" {							// ALTER ML_CONFIGURATION
		$$$SetMLConfigurationOperation(mlconfigid,"alter mlconfig")
		if $$checkid("PROVIDER") {
			set altok=1
			$$$SetMLConfigurationProvider(mlconfigid,lower)
			if $case($$$LOWER(lower),"automl":0,"h2o":0,"datarobot":0,"pmml":0,:1) { set t="Provider Name: AUTOML, H2O, DATAROBOT, or PMML" do error(1) }
			do skip("ID")
		}
	}
	if $$checkid("%DESCRIPTION") {
		set altok=1
		if $$check("NULL") { $$$SetMLConfigurationDescription(mlconfigid,"") }
		else {		
			$$$SetMLConfigurationDescription(mlconfigid,value)
			do skip(9)
		}
	}
	if $$check("USING") {
		set altok=1
		if $$check("NULL") { set using="" }
		else {
			new %mmmJSONOBJECT,%mmmNoDelidCheck,bracecnt,jsonobj,using
			set %mmmJSONOBJECT=1,bracecnt=0,%mmmNoDelidCheck=1
			do skip("{")
			set using="{"
				// skip through the USING clause until we hit the end '}'
				// build a JSON string, and then validate it by calling %FromJSON()
			for  {
				set:token="{" bracecnt=bracecnt+1
				if token="}" { quit:'bracecnt  set bracecnt=bracecnt-1 }
				set using=using_$e(sql,f,p-1)
				do lext
			}
			kill %mmmJSONOBJECT,%mmmNoDelidCheck
			do skip("}")
			set using=$replace(using,"\""""","\""")_"}"
				#; validate the JSON string
			try {
				set jsonobj=##class(%DynamicAbstractObject).%FromJSON(using)
			} catch ex {
				set t="A valid JSON string",token=using do error(1)			
			}
			set using=jsonobj.%ToJSON()
		}
		$$$SetMLConfigurationUsing(mlconfigid,using)
	}
	new javaTLSConfigFile,apiToken,usr,url,utl
	set javaTLSConfigFile=0,apiToken=0,url=0
	for i=1:1:2 {	// two possible provider specific settings
		if 'javaTLSConfigFile,$$checkid("JAVATLSCONFIGFILE") {
			set altok=1
			set utl=1
			if $$check("NULL") { $$$SetMLConfigurationJavaTLSConfigFile(mlconfigid,"") }
			else {
				$$$SetMLConfigurationJavaTLSConfigFile(mlconfigid,value)
				do skip(9)
			}
		}
		if 'url,$$checkid("URL") {
			set altok=1
			set utl=1
			if $$check("NULL") { $$$SetMLConfigurationUrl(mlconfigid,"") }
			else {
				$$$SetMLConfigurationUrl(mlconfigid,value)
				do skip(9)
			}
		} 
		if 'apiToken,$$checkid("APITOKEN") {
			set altok=1
			set utl=1
			if $$check("NULL") { $$$SetMLConfigurationApiToken(mlconfigid,"") }
			else {
				$$$SetMLConfigurationApiToken(mlconfigid,value)
				do skip(9)
			}
		} 
	}
	if $$$Dop="alter mlconfig",'altok { set t="PROVIDER, %DESCRIPTION, USING, JAVATLSCONFIGFILE, URL, or APITOKEN" do error(1) }
	RETURN
.
freeze
	#;---------------------------------------------------------------------
	#;    FREEZE PLANS
	#;    FREEZE PLANS BY TABLE <tname>
	#;    FREEZE PLANS BY SCHEMA <schema>
	#;    FREEZE PLANS BY ID <literal>
.
	set $$$mtStatementType="FREEZE"
	do skipid("PLANS")
	if $$checkid("BY") { 
		if $$checkid("TABLE") {
			set mt("freeze","scope")="TABLE"
			do ParseIdentifier^%qaqpDDLParser(.tval,.tlow)
			set mt("freeze","value")=tlow
			kill tval,tlow
		} elseif $$anyid(" SCHEMA ID ",.scope) {
			set mt("freeze","scope")=scope
			if (scope = "SCHEMA") {
				set mt("freeze","value")=lower
				do skip("ID")
			} else {
				set mt("freeze","value")=value
				do skip(9)
			}
			kill scope
		} else { do error(1) }
	} else {
		set mt("freeze","scope")="ALL"
	}
	QUIT
.
unfreeze
	#;---------------------------------------------------------------------
	#;    UNFREEZE PLANS [ [ FROM ] UPGRADE ]
	#;    UNFREEZE PLANS [ [ FROM ] UPGRADE ] BY TABLE <tname>
	#;    UNFREEZE PLANS [ [ FROM ] UPGRADE ] BY SCHEMA <schema>
	#;    UNFREEZE PLANS [ [ FROM ] UPGRADE ] BY ID <literal>
	#;
	set $$$mtStatementType="UNFREEZE"
	do skipid("PLANS") 
	if $$checkid("FROM") {
		if $$checkid("UPGRADE") { set mt("unfreeze","upgrade")=1 }
		else { do error(1) }
	} else {
		set mt("unfreeze","upgrade")=$$checkid("UPGRADE")
	}
	if $$checkid("BY") { 
		if $$checkid("TABLE") {
			set mt("unfreeze","scope")="TABLE"
			do ParseIdentifier^%qaqpDDLParser(.tval,.tlow)
			set mt("unfreeze","value")=tlow
			kill tval,tlow
		} elseif $$anyid($lb(" SCHEMA ID "),.scope) {
			set mt("unfreeze","scope")=scope
			if (scope = "SCHEMA") {
				set mt("unfreeze","value")=lower
				do skip("ID")
			} else {
				set mt("unfreeze","value")=value
				do skip(9)
			}
			kill scope
		} else { do error(1) }
	} else {
		set mt("unfreeze","scope")="ALL"
	}
	QUIT
.
purge
	#;---------------------------------------------------------------------
	#;    PURGE [ CACHED ] QUERIES
	#;    PURGE [ CACHED ] QUERIES BY AGE <literal>
	#;    PURGE [ CACHED ] QUERIES BY TABLE <tname>
	#;    PURGE [ CACHED ] QUERIES BY NAME <ident> { "." <ident> } { , <ident> { "." <ident> } }
	#;
	set $$$mtStatementType="PURGE"
	do checkid("CACHED")
	do skipid("QUERIES")
	if $$checkid("BY") {
		if $$checkid("AGE") {
			set mt("purge","scope")="AGE"
			set mt("purge","value")=value
			do skip(9)
		} elseif $$checkid("TABLE") {
			set mt("purge","scope")="TABLE"
			do ParseIdentifier^%qaqpDDLParser(.tval,.tlow)
			set mt("purge","value")=tlow
			kill tval,tlow
		} elseif $$checkid("NAME") { 
			set mt("purge","scope")="NAME"
			set name=""
			while token'=$c(1) {
				if $$$SQLReservedWordForParsingContext(%context,token) {
					set name=name_token
					do skipid(token)
				} elseif $$checkid(token) {
					set name=name_prevtoken
				}
				else {
					set name=name_lower
					do skip(token)
				}
			}
			set mt("purge","value")=name
		} else { do error(1) }
	} else {
		set mt("purge","scope")="ALL"
	}
	QUIT
.
build
	#;---------------------------------------------------------------------
	#;    BUILD INDEX { <build option> } FOR <build scope> [ KEEP SELECTABILITY ]
	#; 	  BUILD DEFERRED [ ALL ] [ <build-options> ] FOR <build-defer-scope>
	#;
	#;		<build scope> ::= ALL
	#;						  | SCHEMA <ident>
	#;						  | TABLE <ident> { "." <ident> } [ INDEX <ident> {, <ident> } ]
	#;
	#;		<build-defer-scope> ::= ALL 
	#; 								| SCHEMA <ident> 
	#;								| TABLE <ident> { "." <ident> } 
	#;		<build option> ::= %NOLOCK | %NOJOURN
	#;
	if $$check("DEFERRED") {
		set $$$mtStatementType="BUILDDEFERRED"
		if $$check("ALL") { set $$$mtBuildDefAllComponents=1 }
		for {
			if $$checkid("%NOJOURN") {
				set $$$mtBuildDefNoJournal=1
				set:info $li(mtc(0,0,"syspriv"),12)=1	
			} elseif $$checkid("%NOLOCK") {
				set $$$mtBuildDefNoLock=1
				set:info $li(mtc(0,0,"syspriv"),4)=1	
			} else {
				quit
			}
		}
		do skip("FOR")
		if $$check("ALL") {
			set $$$mtBuildDefScope="ALL"
		} elseif $$check("TABLE") {
			set $$$mtBuildDefScope="TABLE"
			do ParseIdentifier^%qaqpDDLParser(.tval,.tlow)
			set $$$mtBuildDefTable=tlow
			kill tval,tlow
		} elseif $$checkid("SCHEMA") {
			set $$$mtBuildDefScope="SCHEMA"
			set $$$mtBuildDefSchema=value
			if $$$SQLReservedWordForParsingContext(%context,value) { do skipid(value) }
			else { do skip("ID") }
		} else {
			do error(1)
		}
		RETURN
	}
	set $$$mtStatementType="BUILD"
	do skipid("INDEX")
	//support %NOLOCK and %NOJOURN in either order, flag for privilege checking
		// %BuildIndices LockFlag values are:
		// (0) No locks are used while filing the indices (The default %BuildIndices behavior)
		// (1) An extent lock will be acquired before the indexes are built. The lock is released after the index build is completed.
		//  (2) A lock is acquired before filing indices for that instance/record, and it is released as soon as the index(es) for that instance/record is filed.
		//  (3) A shared extent lock will be acquired before the indices are built and released upon completion.
		//
		// Via SQL we only support options (0) and (1) with (1) being the default and 0 being achieved by using the %NOLOCK hint.
		//
	set $$$mtBuildIdxLock=1	// default behavior is to lock the extent
	for {
		if $$checkid("%NOJOURN") {
			set $$$mtBuildIdxJournal=0
			set:info $li(mtc(0,0,"syspriv"),12)=1	
		} elseif $$checkid("%NOLOCK") {
			set $$$mtBuildIdxLock=0
			set:info $li(mtc(0,0,"syspriv"),4)=1	
		} else {
			quit
		}
	}
	do skipid("FOR")
	if $$checkid("ALL") {
		set $$$mtBuildIdxScope="ALL"
	} elseif $$checkid("TABLE") {
		set $$$mtBuildIdxScope="TABLE"
		do ParseIdentifier^%qaqpDDLParser(.tval,.tlow)
		set $$$mtBuildIdxTable=tlow
		kill tval,tlow
		new indices		
		set indices=""
		if $$checkid("INDEX") {
			set indices=$lb(lower)
			if $$$SQLReservedWordForParsingContext(%context,value) { do skipid(value) }
			else { do skip("ID") }
			while $$checkid(",") {
				set indices=indices_$lb(lower)
				if $$$SQLReservedWordForParsingContext(%context,value) { do skipid(value) }
				else { do skip("ID") }
			}
		}
		set $$$mtBuildIdx=indices
	} elseif $$checkid("SCHEMA") {
		set $$$mtBuildIdxScope="SCHEMA"
		set $$$mtBuildIdxSchema=value
		if $$$SQLReservedWordForParsingContext(%context,value) { do skipid(value) }
		else { do skip("ID") }
	} else {
		do error(1)
	}
	if $$checkid("KEEP") { do skipid("SELECTABILITY") set $$$mtBuildIdxSelectability=1 }
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
load
	#;---------------------------------------------------------------------
	#;
	#;    LOAD <load-spec>
	#;
	#;    <load-spec> ::= [ <load-hints> ] DATA <load-data-spec>
	#;                  | SQL <load-sql-spec>
	#; 
	#;   <load-hints> ::= { <load-hint> }
	#; 
	#;   <load-hint> ::= BULK | %NOCHECK | %NOLOCK | %NOINDEX | %NOJOURN
	#; 		-- BULK is an alias for %NOCHECK %NOLOCK %NOINDEX %NOJOURN
	#; 		-- a hint may only appear once except that:
	#; 		--	%NOJOURN can appear after BULK (legacy)
	#; 		--  %NOINDEX can appear with BULK to mean no deferred index build
	#; 		-- BULK with %NOINDEX means defer index build until the end of the LOAD
	#;
	#;    <load-data-spec> ::= <load-data-spec-inline>
	#;                       | <load-data-spec-with-using>
	#;
	#;    <load-data-spec-inline> ::= <load-data-from> <load-data-into> [ <load-data-using> ]
	#;
	#;    <load-data-spec-with-using> ::= [ <load-data-from> ] [ <load-data-into> ] <load-data-using>
	#;
	#;    <load-data-from> ::= FROM <data-source>
	#;
	#;    <data-source> ::= FILE <literal> [ COLUMNS ( <ident> <datyp> {, <ident> <datyp> } ) ]
	#;                    | JDBC <jdbc-cnxn-spec> <jdbc-data-spec>
	#;
	#;    <jdbc-cnxn-spec> ::= [ CONNECTION ] <ident> 
	#;                       | [ CONNECTION ] <%SQLConnection json template>
	#;                       | [ URL ] <literal>
	#;
	#;    <jdbc-data-spec> ::= TABLE <ident> [ {. <ident> } ]
	#;                       | QUERY <literal> ##; RESERVED FOR FUTURE
	#;
	#;    <%SQLConnection json template> ::= <literal> -- template defined later
	#;
	#;    <load-data-into> ::= INTO <tname> [ ( <ident> {, <ident> } ) ] [ VALUES ( <ident> {, <ident> } ) ]
	#;          -- VALUES is not allowed if QUERY is used in <jdbc-data-spec>
	#;
	#;    <load-data-using> ::= USING <load-options>
	#;
	#;    <load-options> ::= <load-options-name>
	#;                     | <load-options-json>
	#;
	#;    <load-sql-spec> ::= FROM <sql-source> [ <load-sql-dialect> ] [ <load-sql-delimiter> ] [ VERBOSE ] [ <load-sql-logtofile> ] [ IGNORE ERRORS ]
	#;
	#;    <sql-source> ::= FILE <literal>
	#;                   | DIRECTORY <literal> [ RECURSE ]
	#;
	#;    <load-sql-dialect> ::= DIALECT <literal>
	#;
	#;    <load-sql-delimiter> ::= DELIMITER <literal>
	#;
	#;    <load-sql-logtofile> ::= LOG TO FILE [ <literal> ]
	#;
	#;---------------------------------------------------------------------
	set $$$mtStatementType = "LOAD"
	$$$InitializeLoadRequest
.
	new bulkOrHints,hasquery,hints
	set hasquery=0,hints=""
	set $$$LoadBuildIndex=0
	set $$$LoadChangeMapSelectability=0
	if $$checkid("BULK") {
			#; We leave a trailing space after the last hint for ease of code generation of the INSERT statement in the JdbcWriter
		set hints="%NOCHECK %NOINDEX %NOLOCK %NOJOURN "
			#; After a LOAD BULK, we will build the indices
		set $$$LoadBuildIndex=1
		set $$$LoadChangeMapSelectability=1
		set bulkOrHints=1
		if info {
			set $li(mtc(0,0,"syspriv"),1)=1		// %NOCHECK
			set $li(mtc(0,0,"syspriv"),3)=1		// %NOINDEX
			set $li(mtc(0,0,"syspriv"),4)=1		// %NOLOCK
			set $li(mtc(0,0,"syspriv"),12)=1		// %NOJOURN
		}
		if $$checkid("%NOJOURN"),hints'["%NOJOURN" {	// %NOJOURN now implied by BULK
			set hints=hints_"%NOJOURN "
			set:info $li(mtc(0,0,"syspriv"),12)=1	// %NOJOURN
		}
		if $$checkid("%NOINDEX") {	// Don't build the indices after a BULK LOAD
			set $$$LoadBuildIndex=0
			set $$$LoadChangeMapSelectability=2
		}
	} else {
		for i=1:1:4 {
			if hints'["%NOCHECK",$$check("%NOCHECK") {
				set hints=hints_"%NOCHECK "
				set bulkOrHints=1
				set:info $li(mtc(0,0,"syspriv"),1)=1	// %NOCHECK
			}
			if hints'["%NOINDEX",$$check("%NOINDEX") {
				set hints=hints_"%NOINDEX "
				set bulkOrHints=1
				set:info $li(mtc(0,0,"syspriv"),3)=1	// %NOINDEX
				set $$$LoadBuildIndex=0	// Don't build indices if %NOINDEX is specified.  It is up the the user to build indices
				set $$$LoadChangeMapSelectability=2
			}
			if hints'["%NOLOCK",$$check("%NOLOCK") {
				set hints=hints_"%NOLOCK "
				set bulkOrHints=1
				set:info $li(mtc(0,0,"syspriv"),4)=1	// %NOLOCK
			}
			if hints'["%NOJOURN",$$checkid("%NOJOURN") {
				set hints=hints_"%NOJOURN "
				set bulkOrHints=1
				set:info $li(mtc(0,0,"syspriv"),12)=1	// %NOJOURN
			}
		}
	}
	if $$checkid("SQL") {
		if $d(bulkOrHints) { new t  set t = "DATA"  do error(1) }
		$$$InitializeSQL
		if $$check("FROM") {
			$$$InitializeSQLFrom
			if $$checkid("FILE") {
				$$$InitializeSQLFileLoader
				$$$SetSQLFilePath(value)
				do skip(9)
				if $$checkid("DIALECT") {
					if ",IRIS,CACHE,FDBMS,INFORMIX,INTERBASE,MSSQLSERVER,MSSQL,ORACLE,SYBASE,"[(","_$$$UPPER(value)_",") {
						$$$SetSQLDialect(value)
						do skip(9)
					}
					else { do error2(1, "IRIS or CACHE or FDBMS or INFORMIX or INTERBASE or MSSQLSERVER or MSSQL or ORACLE or SYBASE") }
				}
				if $$checkid("DELIMITER") {
					$$$SetSQLDelimiter(value)
					do skip(9)
				}
				if $$checkid("VERBOSE") { $$$SetSQLVerbose }
				if $$checkid("LOG") {
					do skip("TO")
					do skipid("FILE")
					$$$InitializeSQLLog
					set filepath = value
					if $$check(9) { $$$SetSQLLog(filepath) }
				}
				if $$checkid("IGNORE") {
					do skipid("ERRORS")
					$$$SetSQLIgnoreErrors
				}
			}
			elseif $$checkid("DIRECTORY") {
				$$$InitializeSQLDirLoader
				$$$SetSQLDirPath(value)
				do skip(9)
				if $$checkid("RECURSE") {
					$$$SetSQLRecurse
				}
				if $$checkid("EXTENSIONS") {
					$$$SetSQLExtensions(value)
					do skip(9)
				}
				if $$checkid("DIALECT") {
					if ",MSSQL,MSSQLSERVER,SYBASE,INFORMIX,"[(","_value_",") {
						$$$SetSQLDirDialect(value)
						do skip(9)
					}
					else { do error2(1, "MSSQL or MSSQLSERVER or SYBASE or INFORMIX") }
				}
				if $$checkid("DELIMITER") {
					$$$SetSQLDirDelimiter(value)
					do skip(9)
				}
				if $$checkid("VERBOSE") { $$$SetSQLDirVerbose }
				if $$checkid("LOG") {
					do skip("TO")
					do skipid("FILE")
					$$$InitializeSQLDirLog
					set filepath = value
					if $$check(9) { $$$SetSQLDirLog(filepath) }
				}
				if $$checkid("IGNORE") {
					do skipid("ERRORS")
					$$$SetSQLDirIgnoreErrors
				}
			}
			else {
				do error2(1, "FILE or DIRECTORY") ##; Only FILE or DIRECTORY for now
			}
		}
	}
	elseif $$checkid("DATA") {
		$$$InitializeData
		$$$InitializeExpectedFeatures
		new tlow, toto, totb
		if $$check("FROM") {
			$$$InitializeDataFrom
			if $$checkid("FILE") {
				$$$InitializeFileLoader
				$$$SetFilePath(value)
				$$$SetFileFieldSeparator($select((value ? .E1".csv"): ",", 1: $char(9)))
				#; $$$ISWINDOWS = ($zv(1) = 2)
				$$$SetFileRecordSeparator($select($zversion(1) = 2: $char(13,10), 1: $char(10)))
				do skip(9)
				if $$checkid("COLUMNS") {
					$$$InitializeDataColumns
					do skip("(")
					do:(token = ")") error2(1, "ID") ##; Disallow empty columns-list
					do {
						if $data(mtd("load","column",value)) { do error(306) }
														else { set mtd("load","column",value) = 1 }
						do $$$DataFromColumns.%Push($select($$$SQLReservedWordForParsing(value):$$quoter(lower), 1: lower))
						do skip("ID")
						do $$$DataFromTypes.%Push($$datyp(,1))
					} while $$check(",")
					do skip(")")
				}
			} elseif $$checkid("JDBC") {
				$$$InitializeJDBCLoader
				if $$checkid("URL") {
					$$$SetJdbcURL(value)
					do:'$$check(9) error2(1, "LITERAL ('jdbc url')")
				} else {
					do checkid("CONNECTION")
					$$$SetJdbcConnection(value)
					do:('$$check(9)) skip("ID") ##; can be either <ident> or json <literal>; <ident> is preferred/default path
				}
				if $$check("TABLE") {
					set tlow = $select($$$SQLReservedWordForParsing(value):$$quoter(lower), 1: lower)
					do skip("ID")
					if $$check(".") {
						set tlow = tlow _ "." _ $select($$$SQLReservedWordForParsing(value):$$quoter(lower), 1: lower)
						do skip("ID")
					}
					if $$check(".") {
						set tlow = tlow _ "." _ $select($$$SQLReservedWordForParsing(value):$$quoter(lower), 1: lower)
						do skip("ID")
					}
					$$$SetJdbcSourceTable(tlow)
				} elseif $$checkid("QUERY") {
					$$$SetJdbcSourceQuery(value)
					$$$SetQueryFeatureExpected(1)
					do skip(9)	// The entire query should be in a single string literal, thus the query will not be validated until execution time when sent to the source db, and cannot support parameters
					set hasquery=1
				} else {
					do error2(1, "TABLE or QUERY") ##; Only TABLE or QUERY for now
				}
			} else {
				do error2(1, "FILE or JDBC") ##; Only FILE or JDBC for now
			}
		}
.
		if $$check("INTO") {
			do ParseIdentifier(,.tlow)
			$$$InitializeDataInto(tlow)
			if hints'="" { $$$InitializeIntoHints(hints) }
			if $$check("(") {
				do:(token = ")") error2(1, "ID") ##; Disallow empty into-list
				$$$InitializeIntoColumns
				do {
					if $data(mtd("load", "into", value)) { do error(306) }
													else { set mtd("load","into",value) = 1 }
					do $$$DataIntoColumns.%Push(lower)
					do skip("ID")
				} while $$check(",")
				do skip(")")
			}
			
			if $$check("VALUES") {
				if hasquery { set token="VALUES" do error2(1,"USING or <end of statement>") }	// VALUES clause not allowed if QUERY
				do parseVALUES	
			}
		}
		#; Check first that <load-data-spec-inline> is valid (if applicable)
		if $$$DataFromIsDefined, ('$$$DataIntoIsDefined) { do error2(1, "INTO") }
		
		if $$$DataFromIsDefined {
			if $$checkid("USING") {
				if $$check("{") {
					set $$$DataUsing = ##class(%DynamicObject).%FromJSON($$parseRawJSONObj())
				} else {
					set $$$DataUsing = ##class(%DynamicObject).%FromJSON(value)
					do skip(9)
				}
			}
		} else {
			do skipid("USING")
			if $$check("{") {
				set $$$DataUsing =  ##class(%DynamicObject).%FromJSON($$parseRawJSONObj())
			} else {
				set $$$DataUsing = ##class(%DynamicObject).%FromJSON(value)
				do skip(9)
			}
		}
		if $$$DataUsing.into.jdbc.threads="" {
			new cpus
			set cpus=$System.Util.NumberOfCPUs()-2
			if cpus>1 { 
				if $$$DataUsing="" { set $$$DataUsing={} }
				if $$$DataUsing.into="" { set $$$DataUsing.into={} }
				if $$$DataUsing.into.jdbc="" { set $$$DataUsing.into.jdbc={} }
				if $$$DataUsing.into.jdbc.threads="" { set $$$DataUsing.into.jdbc.threads=cpus }
			 }
		}
		
		do:(token '= $c(1)) error2(1, $c(1)) ##; Everything should be parsed and it's an error otherwise
		
		if $$$DataIntoColumns {
			set toto = $select(	$$$DataIntoValues : $$$DataIntoValues.%Size(),
								$$$DataFromColumns: $$$DataFromColumns.%Size(),
								1: 0)
			set totb = $$$DataIntoColumns.%Size()	
			do:(toto && (toto > totb)) error(76)
		}
	} else { ##; Currently only supports LOAD DATA and LOAD SQL
		new t  set t = "DATA or SQL"  do error(1)
	}
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
parseRawJSONObj()
	#; Copied this code from model^%qaqpDDLParser
	new %mmmJSONOBJECT,%mmmNoDelidCheck,bracecnt,jsonobj,jsonstr
	set %mmmJSONOBJECT = 1, bracecnt = 0, %mmmNoDelidCheck = 1, jsonstr = "{"
	while token'=$c(1) { ##; skip through the USING clause until we hit the end '}'
		if token="{" {
			set bracecnt = bracecnt + 1
		} elseif token="}" {
			quit:('bracecnt)
			set bracecnt = bracecnt - 1
		}
		set jsonstr = jsonstr _ $extract(sql, f, p-1)
		do lext
	}
	kill %mmmJSONOBJECT, %mmmNoDelidCheck, bracecnt
	do skip("}")
	set jsonstr = $replace(jsonstr,"\""""","\""")_"}"
		#; No need to validate the object; will be done by the loader
	QUIT jsonstr
	#;---------------------------------------------------------------------
#; Parse the VALUES clause of a LOAD DATA statement.
#; This will populate mtd("load", "select", value) which is used for the SELECT from the external source as well as
#; request.into.values which is used for the INSERT in the java code.
#; We will support:
#; 		Functions (e.g. NOW()). These may contain field names (e.g. SUBSTRING(col1, 1, 4))
#; 		Literals (e.g. 10, 'catdog')
#; 		Field names -- any identifier that is not found to be a function will be considered a field name
#; Anything we parse as a field name must be present in the COLUMNS list (if there is one)
#;
#; Previously the Java code would simply build up a select-list of everything in the VALUES clause and then would 
#; build an INSERT INTO tab VALUES (?, ?, ..., ?) with a ? for each param in the LOAD DATA's VALUES clause. The return from the SELECT
#; would then be bound to each parameter in turn. Now we will GIVE java the VALUES list which would look like:
#; 		LOAD DATA:
#;			VALUES (col1, col2, SUBSTRING(col2, 1, 4), NOW(), 15, col3, 'somestr')
#;
#;		Generated INSERT:
#;			VALUES(?, ?, SUBSTRING(?, 1, 4), NOW(), 14, ?, 'somestr')
parseVALUES
	new op, parens, valuesEntry, valuesPart
	set valuesEntry = "", parens = 0
	$$$InitializeIntoValues
	$$$InitializeIntoBindings
	$$$InitializeFromSelect
	do skip("(")
	do:(token = ")") error2(1, "ID") ##; Disallow empty values-list
	// This loop will handle arithmetic expressions, although not explicitly
	// We loop over every individual token in the VALUES clause, each token is one VALUES part. When we encounter ',' or 
	// the closing ')', we will add whatever the entire current VALUES entry is to our VALUES list. In the former case we'll continue
	// looping, in the latter case we'll quit. Otherwise, we'll just add the VALUES part to our overall VALUES entry. Arithmetic symbols
	// handled by parseVALUESfunction which will just return the symbol
	for {
		if token=9 { // literal, we will later generate INSERT ... VALUES (literal)
			set valuesPart = $$parseVALUESliteral()
		} elseif token="ID" { // could be field name or function but parseVALUESidentifier will handle that
			set valuesPart = $$parseVALUESidentifier()
		} elseif $$check("(") {
			do $i(parens)
			set valuesPart = "("
		} elseif $$check(")") {
			if parens = 0 { // closing the VALUES clause
				do $$$DataIntoValues.%Push($e(valuesEntry,1,*-1)) // strip trailing space
				quit
			} else { // closing an internal paren used for grouping e.g. VALUES(col1, col2 + (col4 - col3) )
				set parens = parens - 1
				set valuesPart = ")"
			}
		} else { // reserved word (function or ODBC function extension or arithmetic symbol which will just get added as is)
			if $$chose("+-*/\#_", .op) { // arithmetic
				$$$SetExpressionsFeatureExpected(1) // arithmetic only supported starting with MJG152
				set valuesPart = op
			} else { // function
				new odbcFunExt, odbcFunType
				set odbcFunExt = 0
				if $$check("{") {
					set odbcFunExt = 1
					set odbcFunType = value // save if this is fn, d, t, ts
					do skip("ID")
				}
				set valuesPart = $$parseVALUESfunction(odbcFunExt)
				if odbcFunExt {
					set valuesPart = "{"_odbcFunType_" "_valuesPart_"}"
					do skip("}")
				}
			}
		}
		set valuesEntry = valuesEntry _ valuesPart _ " "
		if $$check(",") {
			do $$$DataIntoValues.%Push($e(valuesEntry,1,*-1)) // strip trailing space
			set valuesEntry = ""
			continue
		}
	}
.
	#; Parses an SQL function and returns the entire function(args) string. Generally takes user at their word -- do not validate function names
	#; Note functions could present as identifiers (e.g. NOW()) or reserved words (e.g. CURRENT_TIME()). 
	#; RECURSIVE FUNCTION -- if there is another function as an argument to this function, we will recurse down
	#; Handles ODBC function extension syntax ({fn functionname}) as well
	#; Special cases for CONVERT/CAST as they will have datatypes for one argument
	#; Special cases for some functions that allow unquoted format codes because they will present as identifiers but should
	#; not actually be treated as such(e.g. DATEDIFF)
parseVALUESfunction(insideOdbcFunction=0)
	$$$SetExpressionsFeatureExpected(1) // functions were only supported starting with MJG152
	new hasParen, functionName
	set hasParen = 0
	set functionName = value
	do lext // could be ID or reserved word but we have the function name so just move to the next token
	$$$peek("(") set hasParen = 1
	if hasParen {
		new argNum, functionString, functionArg, odbcFunExt, odbcFunType
		set functionString = functionName_"(", argNum = 1, functionArg = ""
		do skip("(")
		if $$check(")") RETURN functionString_")" // functions like NOW() return right away
		// This one function will only have one closing paren. If there's another open paren, we will dispatch to a new parseVALUESfunction call!
		// This loops over the arguments to the given function. It only begins treating something as a new argument when
		// it encounters a comma. Otherwise, everything gets concatenated and treated as one argument until either a 
		// comma or the closing parenthesis causes it to be "committed"
		for {
			QUIT:$$check(")")	// no more args
			if functionName="CONVERT", insideOdbcFunction, argNum = 2  {
				// when CONVERT is inside odbc extension syntax (i.e. {fn CONVERT}), the type argument
				// comes second and it will be SQL_[some datatype]. Doesn't accept params
				set functionArg = functionArg_value
				do skip("ID")
			} elseif functionName="CONVERT", 'insideOdbcFunction, argNum = 1 { // otherwise type will be first
				// first arg = fromConvert, second arg = return the SQL datatype instead of objectscript DT
				set functionArg = functionArg_$$datyp(1,1,,.params)
			} elseif functionName="CAST" { // CAST (expression AS type) -- ANNOYING!
				// since the first expression could be anything we need to account for that and we can't just loop because we need
				// to grab the 'AS type'
				if token=9 {
					set functionArg = functionArg_$$parseVALUESliteral()
				} elseif token="ID" { // could be field name or function but parseVALUESidentifier will handle that
					set functionArg = functionArg_$$parseVALUESidentifier()
				} else { // reserved word (function or ODBC function extension or arithmetic symbol which will just get added as is)
					if $$check("AS") {
						// assume this is the ...AS datatype) part of the CAST
						set functionArg = functionArg_" AS "_$$datyp(0,1,,.params)
					} elseif $$chose("+-*/\#_", .op) { // arithmetic
						set functionArg = functionArg_op
					} else { // function
						new odbcFunExt, odbcFunType
						set odbcFunExt = 0
						if $$check("{") {
							set odbcFunExt = 1
							set odbcFunType = value // save if this is fn, d, t, ts
							do skip("ID")
						}
						set argumentFunctionName = $$parseVALUESfunction(odbcFunExt)
						if odbcFunExt {
							set argumentFunctionName = "{"_odbcFunType_" "_argumentFunctionName_"}"
							do skip("}")
						}
						set functionArg = functionArg_argumentFunctionName
					}
				}
			} elseif token=9 { // literal, we will later generate INSERT ... VALUES (literal)
				set functionArg = functionArg_$$parseVALUESliteral()
			} elseif token="ID" { // could be field name or function but parseVALUESidentifier will determine that
				// some functions allow an UNQUOTED format code as FIRST argument so don't treat it as a legitimate identifier
				if argNum = 1, " DATEADD DATEDIFF DATENAME DATEPART DATE_TRUNC TIMESTAMPADD TIMESTAMPDIFF "[(" "_functionName_" ") {
					set functionArg = functionArg_value
					do skip("ID")
				} else {
					set functionArg = functionArg_$$parseVALUESidentifier()
				}
			} else { // reserved word (function OR odbc function extension) or arithmetic
				if $$chose("+-*/\#_", .op) { // arithmetic
					set functionArg = functionArg_op
				} else {
					new odbcFunExt, odbcFunType
					set odbcFunExt = 0
					// it's a function or ODBC function extension
					if $$check("{") {
						set odbcFunExt = 1
						set odbcFunType = value // save if this is fn, d, t, ts
						do skip("ID")
					}
					set argumentFunctionName = $$parseVALUESfunction(odbcFunExt)
					if odbcFunExt {
						set argumentFunctionName = "{"_odbcFunType_" "_argumentFunctionName_"}"
						do skip("}")
					}
					set functionArg = functionArg_argumentFunctionName
				}
			}
			if $$check(",") { // end of this argument
				// commit this arg to the function string, reset it, bump number of args
				set functionString = functionString_functionArg_", "
				set functionArg = ""
				set argNum = argNum + 1
			} else {
				set functionArg = functionArg_" "
			}
		} 
		// commit the last argument
		set functionString = functionString_functionArg
		set $e(functionString,*) = ")"	// this will be a space so change it to the closing paren of the function
		RETURN functionString
	} else { // reserved word function with no parens like CURRENT_DATE so just return that value
		RETURN functionName
	}
.
.
/// Parses an SQL literal. If numeric, returns it raw. If string, wraps in single quotes ('literal')
parseVALUESliteral()
	$$$SetExpressionsFeatureExpected(1) // literals were only supported starting with MJG152
	if $NUMBER(value)'="" {
		do skip(9)
		RETURN value 
	} else {
		do skip(9)
		RETURN "'"_value_"'"
	}
.
.
/// Parses an identifier for LOAD DATA. 
/// If it's followed by an open paren, it's assumed the identifier is some SQL function and thus it dispatches to parseVALUESfunction. 
/// If not, it's assumed it's some field name and will 
parseVALUESidentifier()
	new identifierValue, identifierLower, holdVals
	// peek ahead so we can see if there's an open paren and dispatch to $$parseVALUESfunction
	do holdcur^%qaqpsl2(.holdVals)
	set identifierValue = value, identifierLower = lower // avoid having to setold if we don't need to dispatch
	do skip("ID")
	$$$peek("(") do setold^%qaqpsl2(.holdVals) RETURN $$parseVALUESfunction()
.
	// Otherwise it's a field name, so we need to:
	//   - Return ? which represents how this occurence of this field will appear in the VALUES clause of the INSERT
	//   - Add the value to data.from.select if not there, so we know it has to be SELECTed from the external source
	//   - Add a mapping to data.into.bindings that flags what SELECT-list index this occurence in the VALUE clause should be bound with
	
	#; Check then that every entry in VALUES was defined in COLUMNS (if defined)
	do:$$isMissingFromCOLUMNS(identifierValue) error("29c")
	
	// We previously threw an error if the name in VALUES was already present...I'm not sure why?
	// Anyway, doesn't make as much sense for new VALUES clause support. What if I want VALUES (col1, SUBSTRING(col1, 1, 4))?
	if '$d(mtd("load","select",identifierValue)) {
		// for a column found in the VALUES we will generated INSERT... VALUES (..., ?,...) and will 
		// have the column name in the select-list for the external source
		do $$$DataFromSelect.%Push($select($$$SQLReservedWordForParsing(identifierValue):$$quoter(identifierLower), 1: identifierLower))
		// whenever this column pops up in the VALUES clause, this is the slot of the SELECT-list that should be used to bind its value to the INSERT's VALUES
		// ZERO BASED because this is ultimately for Java code, where arrays will be zero based
		set mtd("load", "select", identifierValue) = $$$DataFromSelect.%Size()-1
	} else {
		// repeating the same column name twice was only supported starting with MJG152
		$$$SetExpressionsFeatureExpected(1)
	}
	// the next column reference is being added into the VALUES clause, here we push into the bindings array to say 
	// "this occurence of a ? should be bound to Xth item of the select-list"
	do $$$DataIntoBindings.%Push(mtd("load","select",identifierValue))
	RETURN "?"
.
.
isMissingFromCOLUMNS(value) [mtd] PRIVATE {
	RETURN ($data(mtd("load","column")) && '$data(mtd("load","column",value)))
}
.
schema
	#;---------------------------------------------------------------------
	#;    CREATE SCHEMA [ IF NOT EXISTS ] <ident>
	#; 
	#; 	  DROP SCHEMA [ IF EXISTS ] <ident> [ CASCADE | RESTRICT ]
	#; 
	new schema,tChkExists
	set tChkExists=0
	new holdvals
	do holdcur^%qaqpsl2(.holdvals)
	if $$checkid("IF") {
		if $$$mtStatementType="CRS" { if $$check("NOT") { do skip("EXISTS") set tChkExists=1 } else { do setold^%qaqpsl2(.holdvals) }}	// CRS
		else { if $$check("EXISTS") { set tChkExists=1 } else { do setold^%qaqpsl2(.holdvals) }}							// DRS
	}
		#; On create, lower is always the schema name. Don't decide the package name until [Create|Drop]Schema^%apiDDL
	set schema=lower
	$$$SSETop(schema,$s($$$mtStatementType="CRS":"create schema",$$$mtStatementType="DRS":"drop schema",1:"invalid"))
	do skip("ID")
	$$$SSETifexists(schema,tChkExists)
	if $$$mtStatementType="DRS" {
		if $$checkid("CASCADE") { $$$SSETcascade(schema,1) } 
		else {
			do checkid("RESTRICT") //default behavior
			$$$SSETcascade(schema,0)
		}
	}
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
/// --------------------------------------------------------------------------------
/// Parse: CANCEL QUERY <pid spec> [ <cancel query scope> ][ <timeout scope> ]
///
/// BNF:
///      <cancel query> ::= CANCEL QUERY <pid spec> [ <cancel query scope> ]
///                                                 [ <timeout scope> ]
///
///      <cancel query scope> ::= IDENTIFIED BY <sql spec>
///
///      <timeout scope> ::= TIMEOUT <timeout spec>
///
///        <pid spec> ::= <val spec>
///             -- NOTE:  <val spec> must evaluate to a valid Process value (e.g. $JOB)
///
///        <sql spec> ::= <val spec>
///             -- NOTE:  <val spec> must evaluate to a valid SQLStatementID (INTEGER) value,
///                       a field from the 'SQL Statement Index' (SSI)
///
///        <timeout spec> ::= <val spec>
///             -- NOTE:  <val spec> must evaluate to a valid INTEGER value
///
///      <val spec> ::= <host var> | <literal>
/// --------------------------------------------------------------------------------
///
cancelQuery	; EP - Called from stat+?^%qaqpsq1
	new options,t
	
	set options=" <cancel query scope> | <timeout scope> | <end of statement> "
	set $$$mtStatementType="CANCELQRY"
	do skipid("QUERY")
	
	#; --- Process <pid spec> ---
	if token=$c(1) { set t="<pid spec>",token="<end of statement>" do error(1) }
	set $$$mtCancelQuery("pid")=$$valspec("<pid spec>",0)  // <pid spec> Value!
	
	if $$checkid("IDENTIFIED") { // --- Process <cancel query scope> ---
		do skipid("BY")
		#; --- Process <sql spec> ---
		if token=$c(1) { set t="<sql spec>",token="<end of statement>" do error(1) }
		set $$$mtCancelQuery("sql-id")=$$valspec("<sql spec>",1)  // <sql spec> Value!
		set options=$replace(options," <cancel query scope> |","")
	}
	if $$checkid("TIMEOUT") { // --- Process <timeout scope> ---
		#; --- Process <timeout spec> ---
		if token=$c(1) { set t="<timeout spec>",token="<end of statement>" do error(1) }
		set $$$mtCancelQuery("timeout")=$$valspec("<timeout spec>",1,1)  // <timeout spec>
		set options=$replace(options," <timeout scope> |","")
	}
	if token'=$c(1) { set t=$s(options["|":"{"_options_"}",1:options) do error(1) }
	
	RETURN
	
	#;-----
	
/// Helper function for 'cancelQuery' method...
/// 
valspec(elementBNF="",validateNum=0,checkSignedNum=0) ; Process and return <val spec> ::= <host var> | <literal>
	new numSign,tokenHold,valueHold,vType,vVal
	
	set numSign=1  // Positive Number (+)
 	set tokenHold=token,valueHold=value
 	if checkSignedNum { // --- Check for a Signed Number { + | - } ---
	 	if $$check("+") { set numSign=1 }
	 	elseif $$check("-") { set numSign=-1 }
 	}
	do varcon^%qaqpslx  // Parse: [(...(] { <literal> | <host var> | ? } [)...)]
	set vType=$$$mtVType($$$mtV(val)),vVal=$p($$$mtV(val),"^",2)
	set vVal=$s((vType="x")&&(vVal="?"):$s($g(%msqlvarcparm)="":"%parm("_val_")",$e(%msqlvarcparm,*)'="(":%msqlvarcparm_val,1:%msqlvarcparm_val_")"),1:vVal)
	set vVal=$s(vType="x":":",1:"")_vVal  // <val spec> used for code generation in 'cancelQuery^%qaqcDDLCodeGen'!
	
	#; --- Conditionally throw an error if the <literal> value is not a valid Integer ---
	if validateNum,vType="t",'$isvalidnum(vVal) { set token=tokenHold,value=valueHold do error(65) }
	
	#; --- Apply Number Sign for <literal> Value ---
	set:vType="t" vVal=vVal*numSign
	
	RETURN vVal
	
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
skipmany(t,c) ; Skip 't' token 'c' times
	for i=1:1:c { do skip(t) }
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ParseIdentifier(idvalue,idlower,defused,usedefschema=0,&original) ;	// DPV1824 (defused)
	  #;  Parse xxx.catalog.schema.table
	  #;   retain schema.table and return qualified name in idvalue,idlower (passed by reference)
	  #;   Set defused (PBR) to 1 if schema value not specified
	  #;   if usedefschema=1, use the contents of %defschema for unqualified names
	  #;   otherwise use $$$DEFAULTSCHEMA
	n found,sdelid,sval,slow,tdelid,th,tval,tlow s idvalue="",idlower="",defused=0,sdelid=0,tdelid=0
	s sval="",slow="",tval="",tlow="" f  s sdelid=tdelid,tdelid=%delid,sval=tval,tval=value,slow=tlow,tlow=lower,original=$g(original)_"."_lower d skip("ID") q:'$$check(".")
	if sval="USER",sdelid'=2 d error(312)	// Don't allow undelimited ID of USER for schema name (DPV2723)
	set $e(original)=""
	if sval="" {
		if 'usedefschema {	// use system defined default schema
			s sval=$$$DEFAULTSCHEMACGQ,slow=$$$DefaultSchemaCGQ,mtc(0,0,"some unqualified names")=1,defused=1  ; default schema name
			set mt("unqualified-names")=1
		}
		else {  ; default schema name from %defschema, which is probably the import list
			set found=0
			if $g(%sqlSchemaPath)'="" {	// DPV3410=
				for i=1:1:$ll(%sqlSchemaPath) {
					if $d(^oddPROC($$$UPPER($lg(%sqlSchemaPath,i)),$$$UPPER(tval))) {
						s slow=$lg(%sqlSchemaPath,i),sval=$$$UPPER(slow)
						s found=1 q  // quit for loop
					}
				}
			}
			set:'found sval=$lg(%defschema),slow=$lg(%defschema)
			set defused=1	// ,ContextDependent=1	// DPV3369
			set:info mtc(0,0,"some unqualified names")=1
			set mt("unqualified-names")=1
		}
	}
	s idvalue=sval_"."_$tr(tval,".",$c(2)),idlower=slow_"."_$tr(tlow,".",$c(2))
	QUIT
	
ml	;  SET ML ... 
	#; SEL ML has already been parsed
	set $$$mtStatementType="SET ML"
	if $$checkid("CONFIGURATION") {
		if $$check("=") {}
		set mt("set ml","configuration")=lower
		set:info mtc(0,0,"set ml configuration")=lower
		do skip("ID")
	}
	RETURN
	
	
	#;  At this point CREATE/ALTER/DROP FOREIGN TABLE has been parsed
	#;
	#; CREATE FOREIGN TABLE [IF NOT EXISTS] <tname> [ ( <ident> <datatype> { , <ident> <datatype> }* ) ] SERVER <tname> <ft-options> [ USING {json_object} ] [ NOVALIDATE ]
	
	#; <tname> ::= <ident> {. <ident> }
	#; <ident> ::= <identifier> | <delimited identifier>
	#; <ft-options> ::= <file-ft-options> | <db-ft-options> | <generic-ft-options>
	#; <file-ft-options> ::= FILE <literal> | [ COLUMNS ( <ident> <datyp> {, <ident> <datyp> }* ) ) ]
	#; <db-ft-options> ::= TABLE <literal> | QUERY <literal>
	#; <generic-ft-options> ::= [ VALUES ( <ident> { , <ident> }* ) ]
	#;
foreignTable() [lower, mt, mtd, t, token, value] PRIVATE {
	set tCheckExists = 0
	if $$$mtStatementType'="ALFT", $$checkid("IF") {
		do:$$$mtStatementType="CRFT" skip("NOT")
		do skip("EXISTS")
		set tCheckExists = 1
	}
	do ParseIdentifier(.tVal,.tLow,,,.originalTableName)
	$$$FTmake(tVal,tLow,tabID)
	if tCheckExists { $$$TSETifexists(tabID, 1)}
.
	if $$$mtStatementType="DRFT" { do dropForeignTable(tabID) RETURN }
	if $$$mtStatementType="ALFT" { do alterForeignTable(tabID) RETURN }
	
	$$$TSETop(tabID,"create foreign table")
	// column list, if not included then we will be importing the schema from the source!
	if $$check("(") {  ;  ... ( <column-def> { , <column-def> } )
		for { 
			// don't need a full tecdef, just get name and datatype
			$$$Fmake(tabID,value,lower,fldid) 
			// maintain comma-delimited list of column names for later if user doesn't specify external names
			set fieldNames = $g(fieldNames)_","_lower
			do skip("ID")
			set datatype = $$datyp(,,.isStreamType)
			do:isStreamType error2(240,$$$TNAME(tabID)_"."_fldid)
			$$$FSETtype(tabID,fldid,datatype) 
			QUIT:'$$check(",") 
		} 
		set $e(fieldNames,1) = "" // remove leading comma
		$$$FTSetNumFields(tabID,$l(fieldNames,","))
		do skip(")")
	} else { // Maybe better to use explicit keyword for import? a la CREATE FOREIGN TABLE <tab> SERVER <server> IMPORT SCHEMA?
		$$$FTSetImportSchema(tabID,1)
		$$$FTSetNumFields(tabID,0)
	}
	
	do skipid("SERVER")
	do ParseIdentifier(.sVal,.sLow) // Parse identifier of the server
	$$$FTSetServer(tabID,sLow)
	
	if $$checkid("FILE") { // is a file FT
		do:$$$FTGetImportSchema(tabID) error(236) // can't import schema from file -- can't get types
		$$$FTSetTable(tabID,value)
		$$$FTSetNOVALIDATE(tabID, 1) 	// don't validate file-based FTs
		do skip(9)
		// FILE FTs can include COLUMNS clause to provides a header (column names) for a CSV file that doesn't have a header
		// LOAD DATA has COLUMNS <fieldname> <datatype>, according to Dan the datatype is mainly to be future-proof
		if $$checkid("COLUMNS") {
			if $$$FTColumnsIsSet(tabID) { do error2(327,"COLUMNS") } 
			do skip("(")
			do:(token = ")") error2(1, "ID")
			for {
				// If there's only a COLUMNS clause (for file FT), the names there must appear in the field list for the FT, which is a construction used for csv col -> FT field reordering
				// If there's also a VALUES clause, that is not true. This var will only contain a name if there was a mismatch as we build the COLUMNS clause list so we only throw the error if no VALUES clause appears
				if (","_$$$UPPER(fieldNames)_",") '[ ("," _ value _ ",") {
					set colClauseFieldListMismatch = $s($d(colClauseFieldListMismatch): ", ", 1:"")_value
				}
				// Header column names kept in order in comma-delimited list format
				// These names cannot contain a comma (as with any identifier, hence safe to use comma-delimited list)
				set columnsClauseNames = $g(columnsClauseNames)_","_lower
				do $i(columnsClauseCount) 
				do skip("ID")
				// quote type name to prevent comma-collision in case of e.g. DECIMAL(%1,%2)
				set columnsClauseTypes = $g(columnsClauseTypes)_","_$$quoter2($$datyp(,1))
				QUIT:'$$check(",") 
			}
			do:(columnsClauseCount < $$$FTGetNumFields(tabID)) error(233)
			$$$FTSetColumns(tabID,$e(columnsClauseNames,2,*)) // strip leading comma in columnsClauseNames list when setting
			$$$FTSetColumnsTypes(tabID,$e(columnsClauseTypes,2,*))
			do skip(")")
		}
	} else { // is an external DB FT
		for  { // looping to allow any order of these options
			if $$checkid("TABLE") {
				if $$$FTTableIsSet(tabID) { do error2(327,"TABLE") } 
				// If this is an external DB, give  user a chance to specify the name of the table in
				// the external database or else we will use the same schema.table name as this in IRIS table!
				$$$FTSetTable(tabID,value)
				do skip(9)
				CONTINUE
			} 
			
			if $$checkid("QUERY") {
				if $$$FTQueryIsSet(tabID) { do error2(327,"QUERY") } 
				
				// input as a literal because we can't account for different syntax of different DBs that
				// could be used. this means we can't provide any parsing/verification (e.g. cardinality of external
				// SELECT-list matches the NUMCOLUMNS of this foreign table) as the FT is created.
				// change $c(160) (non-breaking space) into $c(32) (standard space) -- if NBSP is sent as part of the query, 
				// then the external DB might throw syntax error
				$$$FTSetQuery(tabID,$tr(value,$c(160),$c(32)))
				do skip(9)
				CONTINUE
			}
			
			QUIT
		}
	}
	// VALUES externalname1, externalname2...
	// The names of the columns in the external source (for files, the column names in the header)
	// Must map positionally to the field names in the foreign table
	if $$checkid("VALUES") {
		if $$$FTGetImportSchema(tabID) { set t="ID",value="VALUES" do error2(1,"TABLE") }
		if $$$FTValuesIsSet(tabID) { do error2(327,"VALUES") } 
		do skip("(")
		do:(token = ")") error2(1, "ID")
		// only verify that cardinality matches between the columns listed for the IRIS table
		// and the external column names. Mapping between them are expected to be put in order by the user
		KILL fieldNames
		for {
			// external column names kept in order in comma-delimited list format
			// quoting for delimited identifier functionality is handled during query processing in %qaqcmh based on information about the server
			if $$$FTColumnsIsSet(tabID),","_$$$UPPER($$$FTGetColumns(tabID))_","'[(","_$$$UPPER(lower)_",") { // name provided in VALUES better be listed in COLUMNS if it was provided!
				do error("29c") // use the LOAD DATA error
			}
			set fieldNames = $g(fieldNames)_","_lower
			do $i(numExtFields) 
			do skip("ID")
			QUIT:'$$check(",") 
		}
		$$$FTSetValues(tabID,$e(fieldNames,2,*)) // strip leading comma in fieldNames list when setting
		if $$$FTGetNumFields(tabID) '= numExtFields {
			do error(233)
		}
		do skip(")")
	} elseif $d(colClauseFieldListMismatch) {
		do error2(249, colClauseFieldListMismatch)
	}
.
	// No USING options expected for external DB FTs, but might as well leave it common to both for now
	if $$checkid("USING") {
		if $$$FTGetImportSchema(tabID) { set t="ID",value="USING" do error2(1,"TABLE") }
		if $$check("{") {
			// user entered unquote JSON so parse item by item
			$$$FTSetUsing(tabID, $$parseRawJSONObj())
		} else {
			// user entered literal that should contain JSON, just grab the value they input
			$$$FTSetUsing(tabID, value)
			do skip(9)
		}
	}
.
	// user doesn't want to validate the provided schema; this means nothing if we have to import the schema
	if $$checkid("NOVALIDATE"), '$$$FTGetImportSchema(tabID) {
		$$$FTSetNOVALIDATE(tabID, 1)
	}
	
	// if these weren't set explicitly, set to defaults
	if '$$$FTTableIsSet(tabID) { $$$FTSetTable(tabID,originalTableName) }
	if '$$$FTQueryIsSet(tabID) { $$$FTSetQuery(tabID,"") }
	if '$$$FTValuesIsSet(tabID) { $$$FTSetValues(tabID,$g(fieldNames)) } // if we are importing the schema, we'll have to set these later
	if '$$$FTColumnsIsSet(tabID) { $$$FTSetColumns(tabID,"") }
	if '$$$FTUsingIsSet(tabID) { $$$FTSetUsing(tabID, "{}") } // "{}" will later become an empty JSON object during construction of the request string
	do:token'=$c(1) error(25) // should be at the end
	RETURN
}
	
.
	#; CREATE [FOREIGN] SERVER
	#;  At this point CREATE SERVER has been parsed
	#;
	#; CREATE [FOREIGN] SERVER <server-name> [ TYPE <server-type> ] FOREIGN DATA WRAPPER <fdw-name>  { CONNECTION <literal>  | HOST <literal> ( <db-server-options> ) } [ DELIMITEDIDS | NODELIMITEDIDS ] [ { ENABLE | DISABLE } PASSTHROUGH ] [ PUSHDOWN <pushdown-type> ]
	
	#; <server-name> ::= <ident> {. <ident> }
	#; <ident> ::= <identifier> | <delimited identifier>
	
	#; <server-type> 		::= 	FILE | DB
	#; <fdw-name>    		::= 	CSV | JDBC | ODBC | <classname>
	#; <db-server-options> 	::= 	PORT <literal> DATABASE <literal> USER <literal> PASSWORD <literal>
	#; <pushdown-type> 		::=		OFF | ANSI92 | EXTENDED | IRIS
foreignServer() [lower, mt, mtd, t, token, value] PRIVATE {
	set tCheckExists = 0
	if $$$mtStatementType'="ALSV", $$checkid("IF") {
		do:$$$mtStatementType="CRSV" skip("NOT")
		do skip("EXISTS")
		set tCheckExists = 1
	}
	do ParseIdentifier(.sVal, .sLow)
	// make the mtd() for this server
	$$$FTSmake(sVal,sLow,serverID)
	if tCheckExists { $$$FTSSetIfExists(serverID,1) }
	if $$$mtStatementType="DRSV" { do dropForeignServer(serverID) RETURN }
	if $$$mtStatementType="ALSV" { do alterForeignServer(serverID) RETURN }
	// set the operation
	$$$FTSSetOp(serverID,"create foreign server")
	if $$checkid("TYPE") { // if query specifies server TYPE, record it
		if '$$$FTSTypeIsValid(value) { d error2(234,value) }
		$$$FTSSetType(serverID,value)
		do skip(9)
	}
	
	if $$checkid("VERSION") {
		$$$FTSSetVersion(serverID,value)
		do skip(9)
	}
	
	// Now parse and record the CLASS name of the Foreign Data Wrapper
	do skip("FOREIGN"),skipid("DATA"),skipid("WRAPPER")
	set fdwInput=lower
	do skip("ID")
	while $$check(".") {
		set fdwInput=fdwInput_"."_lower
		do skip("ID")
	}
.
	// if user specifies a valid shorthand, use associated system FDW. Otherwise, assume they specified a full class name
	set fdwClass = $$getFDWClassNameFromShorthand^%apiSQL(fdwInput)
	if fdwClass="",fdwInput'="" {	// valid shorthand was found
		set fdwClass = $lg($g(^rINDEXCLASS($$$UPPER(fdwInput))),2)		// CreateForeignServer^%apiDDL2 verifies that this class implements the FDW interface
	}
	if fdwClass="" { // if the FDW shortname isn't recognized, the FDW will be set to ""
		do error2(235,fdwClass)
	}
	set fdwClass = $$getNewFdwClassNameFromOldClassName^%apiSQL(fdwClass)	// in case user enters old deprecated class by name
	$$$FTSSetFDW(serverID,fdwClass) 	// FDW is a class param but kept separate from the others b/c it requires more work during code gen
	
	// This whole TYPE handling is not even ever used and is mostly a formality (and a pain!)
	// During parsing, the type will be deduced as such: CsvWrapper->file, Jdbc/OdbcWrapper->DB, anything else->CUSTOM
	// and we can fill in a better type later based on class hierarchy
	if '$$$FTSTypeIsSet(serverID) {	// but they might have specified manually
		set type = $s(fdwClass=$$$FDWCsvWrapper: "FILE", fdwClass=$$$FDWJdbcWrapper: "DB", fdwClass=$$$FDWOdbcWrapper: "DB", 1: "CUSTOM")
		do:'$$$FTSTypeIsValid(type) error2(234,type)
		$$$FTSSetType(serverID,type)
	}
	
	// Go through generic options for different server types
	// Has to be a literal because / causes problems for identifiers 
	if $$$FTSTypeIsFile(serverID) { // the server specifies a file
		do parseHost(0)
	} elseif $$$FTSTypeIsDB(serverID) {
		do parseConnection(0)	// we will require CONNECTION for now until we have better credential handling for USER, PASSWORD etc. enumeration
	} else {	// custom, let them specify whatever they want, and we will need to support USING clause eventually
		set found = $$parseHost(1)
		do parseConnection(found)	// only optional if we didn't find HOST?
	}
.
	if $$anyid(" DELIMITEDIDS NODELIMITEDIDS ",.op) { 
		if $$$FTSDelimitedIdsIsSet(serverID) { 
			do error2(328,"DELIMITEDIDS/NODELIMITEDIDS") 
		} 
		if op = "DELIMITEDIDS" { 
			$$$FTSSetDelimitedIds(serverID,1) 
		} else {
			$$$FTSSetDelimitedIds(serverID,0)
		}
	}
	// Use delimited identifiers by default
	if '$$$FTSDelimitedIdsIsSet(serverID) { $$$FTSSetDelimitedIds(serverID, 1) }
	
	if $$anyid(" DISABLE ENABLE ",.op) { //  { DISABLE | ENABLE } PASSTHROUGH
		do skipid("PASSTHROUGH")
		$$$FTSSetPassthrough(serverID, $case(op, "DISABLE":0, "ENABLE":1))
	}
	
	if $$checkid("PUSHDOWN") {
		// Has to be a type name that we support
		if '$$isValidPushdownTypeName^%qaqpftpd(value) {
			new t, token
			set t = "one of OFF, BASIC, ANSI92, EXTENDED, IRIS"
			set token = value
			do error(1)
		}
		$$$FTSSetPushdownType(serverID,value)
		do skip("ID")
	}
.
	// Support USING clause in foreign servers, creates a generic section that users can provide with information they
	// wish to link to a foreign server and that can be handed to custom foreign data wrappers that they might need which
	// we can't support with official syntax
	if $$checkid("USING") {
		if $$check("{") {
			// user entered unquote JSON so parse item by item
			$$$FTSSetUsing(serverID, $$parseRawJSONObj())
		} else {
			// user entered literal that should contain JSON, just grab the value they input
			$$$FTSSetUsing(serverID, value)
			do skip(9)
		}
	}
	
	do:token'=$c(1) error(25) // should be at the end
	
	RETURN
.
/// Used for parsing foreign server stuff
parseHost(optional=0)
	set found = 1
	if optional {
		set found = $$checkid("HOST")
		if found {
			$$$FTSSetHost(serverID,value)
			do skip(9)
		}
	} else {
		do skipid("HOST")
		$$$FTSSetHost(serverID,value)	
		do skip(9)
	}
	RETURN found
parseConnection(optional=0)
	set found = 1
	if optional {
		set found = $$check("CONNECTION")
		if found {
			$$$FTSSetConnection(serverID,value)
			do skip(9)
		}
	} else {
		do skip("CONNECTION")
		$$$FTSSetConnection(serverID,value)
		do skip(9)
	}
	RETURN found
}
	
	; DROP FOREIGN TABLE
	;
	; 	DROP FOREIGN TABLE [IF EXISTS] <tabname> <drop-behave>
dropForeignTable(tabID) [mt,mtd,token] PRIVATE {
	$$$TSETop(tabID,"drop foreign table")
	#;  <drop-behave> ::= [ RESTRICT | CASCADE ]
	if $$chose(" RESTRICT CASCADE ",.op) { $$$TSETbehave(tabID,op) }
	do:token'=$c(1) error(25)
	RETURN
}
.
	#; Code takes same general approach as altt
	#; ALTER FOREIGN TABLE table alter-action
	#;
	#; alter-action ::=
	#;  ALTER sub-alter-action
	#;  MODIFY modification-spec  [ VALUES ( newval { , newval } ) ]
	#; 
	#; sub-alter-action ::=
	#;  alter-column-action |
	#; 
	#; alter-column-action ::=
	#;  [COLUMN] field
	#;       RENAME newfieldname [ VALUES ( valuefield ) ] |
	#;       datatype 
	#; 
	#; modification-spec ::=	
	#;  oldfieldname RENAME newfieldname [ VALUES ( valuefield ) ] {, oldfieldname RENAME newfieldname [ VALUES ( valuefield ) ] } |
	#;  fieldname datatype {, fieldname datatype} |
	#; 
alterForeignTable(tabID) [lower, mt, mtd, t, token, value] PRIVATE {
	$$$TSETop(tabID,"alter foreign table")
	if $$check("ALTER") {
		// ALTER COLUMN (but COLUMN is optional)
		do checkid("COLUMN")
		$$$Fmake(tabID,value,lower,fldID) 
		do skip("ID")
		if $$checkid("RENAME") {
			$$$TSETopItself(tabID,"alterFTrenamefield" _ $c(1) _ fldID)
			set $$$fnewname(tabID, fldID) = lower
			// RENAME of a column will be defined as ONLY renaming the IRIS-side column
			// If a user wishes to change the external name they should manually specify VALUES (newValues) on this field
			do skip("ID")
			if $$checkid("VALUES") {
				do skip("(")
				$$$FTSetValuesRename(tabID, fldID, lower)
				do skip("ID")
				do skip(")")
			}
		} else { // alter datatype
			$$$TSETopItself(tabID,"alterFTalter" _ $c(1) _ fldID)
			$$$FSETtype(tabID,fldID,$$datyp())
		}
	} elseif $$checkid("MODIFY") {
		set hasparen=$$check("(")
		for i=1:1 {
			// RENAME field or datatype
			// note: fldID is set during an $$$Fmake, so if we skip("ID"), even if we're on a new token fldID
			// is set to the fldid assigned to the last field name parsed (the old field name)
			$$$Fmake(tabID,value,lower,fldID) d skip("ID")
			if $$checkid("RENAME") {
				$$$FTSETopItselfList(tabID, "alterFTrenamefield" _ $c(1) _ fldID)
				set $$$fnewname(tabID, fldID) = lower
				do skip("ID")
				if $$checkid("VALUES") {
					do skip("(")
					$$$FTSetValuesRename(tabID, fldID, lower)
					do skip("ID")
					do skip(")")
				}
				QUIT:'$$check(",")
				CONTINUE
			}
			// it's definitely datatype
			$$$FTSETopItselfList(tabID,"alterFTalter"_$c(1)_fldID)
			$$$FSETtype(tabID,fldID,$$datyp())
			QUIT:'$$check(",")
		}
		do:hasparen skip(")")
	}
	do:(token'=$c(1)) error(25)	
	RETURN
}
.
	; DROP [FOREIGN] SERVER
	;
	;	DROP [FOREIGN] SERVER <servername> <drop-behave>
dropForeignServer(serverID) [ mt, mtd, token ] PRIVATE {
	$$$FTSSetOp(serverID,"drop foreign server")
	#;  <drop-behave> ::= [ RESTRICT | CASCADE ]
	if $$chose(" RESTRICT CASCADE ",.op) { $$$FTSSetBehave(serverID,op) }
	do:token'=$c(1) error(25)
	RETURN
}
	#; ALTER [FOREIGN] SERVER server alter-action
	#;
	#; alter-action ::=
	#;  ALTER sub-alter-action
	#;  MODIFY sub-alter-action {, sub-alter-action }
	#; 
	#; sub-alter-action ::=
	#;  CONNECTION literal |
	#;  HOST literal | 
	#;  PORT literal |
	#;  USERNAME literal |
	#;  PASSWORD literal |
	#;	PUSHDOWN <pushdown-type> |
	#;  DELIMITEDIDS |
	#;  NODELIMITEDIDS
	#;
	#; <pushdown-type> ::= { OFF | ANSI92 | EXTENDED | IRIS }
	#; 
	#; NOTES:
	#; ------
alterForeignServer(serverID) [lower, mt, mtd, t, token, value] PRIVATE {
	$$$FTSSetOp(serverID,"alter foreign server")
.
	if $$check("ALTER") {
.
		if $$checkid("CONNECTION") {
			$$$FTSSetConnection(serverID,value)
			do skip(9)
			GOTO exit
		} elseif $$checkid("HOST") {
			$$$FTSSetHost(serverID,value)
			do skip(9)
			GOTO exit
		} elseif $$anyid(" DELIMITEDIDS NODELIMITEDIDS ",.op) {
			$$$FTSSetDelimitedIds(serverID,$case(op,"NODELIMITEDIDS":0,:1))
		} elseif $$checkid("PUSHDOWN") {
			// Has to be a type name that we support
			if '$$isValidPushdownTypeName^%qaqpftpd(value) {
				new t, token
				set t = "one of OFF, BASIC, ANSI92, EXTENDED, IRIS"
				set token = value
				do error(1)
			}
			$$$FTSSetPushdownType(serverID,value)
			do skip("ID")
		}
.
		GOTO exit
	}
.
	if $$checkid("MODIFY") {
		set allowConnection = 1
		for {
			if $$checkid("CONNECTION") { // CONNECTION / DELIMITEDIDS can be done together
				do:'allowConnection error(25)
				$$$FTSSetConnection(serverID,value)
				do skip(9)
				QUIT:'$$check(",")
				CONTINUE
			} elseif $$anyid(" DELIMITEDIDS NODELIMITEDIDS ",.op) {
				$$$FTSSetDelimitedIds(serverID,$case(op,"NODELIMITEDIDS":0,:1))
				QUIT:'$$check(",")
				CONTINUE
			} else {
				QUIT
			}
.
.
			if $$checkid("HOST") {
				$$$FTSSetHost(serverID,value)
				do skip(9)
				QUIT:'$$check(",")
				CONTINUE
			}
		}
		GOTO exit
	}
.
exit
	do:(token'=$c(1)) error(25)	
	RETURN
}
.
.
qdouble(text) [] PRIVATE {  // Double quotes in text
	  Do {
		  s x=$e(text,$i(i))
		  s:x="""" text=$e(text,1,i-1)_x_$e(text,i,*),i=i+1
	  } While x'=""
	  QUIT text
	}
.
	#; MJG029 - Mark that we need to check for %Development:USE privilege in %SYS.SQLSRV
requireDevelopmentPrivilege() [%caller, info, mtc] PUBLIC {
	set:info&&(",DynamicStatement,xDBC,"[(","_$g(%caller)_",")) mtc(0,0,"%development_use")=1
}
