====
SYS.XSQL
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%SYS.XSQL^MAC^^^0
%SYSXSQL	; %SYS.XSQL
	;; COMPONENTS :: SQL/Dialect
	#;
	Quit
#include %occInclude
#include %occODBC
	
#IF 0   ;
	;-------------------------------------------------------------
	; Description:   #; %XSQL.* class method overflow
	; Author:        David Van De Griek
	; Date:          January 23, 2009
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	; DPV3350 (01/23/2009) - Implement this routine
	;-------------------------------------------------------------
	;                     I N F O R M A T I O N
	;-------------------------------------------------------------
	;
	;  This routine is a repository for method code that would normally
	;  reside in %XSQL.* classes, but needs to be in a %SYS.* routine
	;  So the role escalation macros code will execute OK
	;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
.
	#; This is code from %XSQL.DSI.Call.%Generate
DSICallGenerate(importPackages,clsFrom,qryFrom,txtSQLLR,procContextClass,defaultSchema = "",hash,tables,omscost = 0,stmttype=0,callmeback=0) [] PUBLIC {
.
	set tflag=0,returnError = $$$NULLOREF, SQLCODE=0,%msg="",$ZTrap="Catch"	// DPV2749 (remove jflag=0)
	do {
		$$$AddAllRoleTemporary ; verified 9/26/16 STC
		$$$SuspendAllTrans(tflag)
		#; DPV2749 $$$DisableJournal
			#; this is the equivalent of parsing the statement. Since we constructed this statement in %Prepare we can use
			#; this primitive expression in lieu of a full parser
		set schemaproc = $zstrip($Extract(txtSQLLR,$find($$$ucase(txtSQLLR),"CALL "),*),"<>W")
		if schemaproc '= "" {
			if schemaproc '[ """" {
					#; Process normal identifiers...
				if schemaproc [ "." {
					set schema = $zstrip($Piece(schemaproc,".",1),">W")
					Set procedure = $zstrip($Piece(schemaproc,".",2),"<W")
				}
				else {
					if importPackages '= "" {
						#;  Here we have an unqualified procedure name, use the schema(s) from the package in importPackages to resolve.
						#;  If there are multiple packages in importPackages, we need to find the correct schema to use, or report an error if it is ambiguous
						if importPackages'["," {	// One package in importPackages
							set schema=$g($$$PACKAGEsqlname(importPackages)) 
							set:schema=""&&(importPackages="User") schema="SQLUser"
							set:schema="" schema=$tr(importPackages,".","_")
							set defaultSchema = schema
							set procedure = schemaproc
						}
						else {
							s procCount=0
							for i=1:1:$l(importPackages,",") {
								s package=$p(importPackages,",",i)
								set schema=$g($$$PACKAGEsqlname(package)) 
								set:schema=""&&(package="User") schema="SQLUser"
								set:schema="" schema=$tr(package,".","_")
								continue:'$Data($$$PROC($$$pPROC,$$$UPPER(schema),$$$UPPER(schemaproc))) 
								set defaultSchema = schema, procedure = schemaproc, procCount=procCount+1
							}
							if procCount=0 { set schema="",procedure="" } // and fall through to report -428 error below
							if procCount>1 {	// Ambiguous procedure found
								set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New($$$ERROR($$$StoredProcedureNameConflict,schemaproc,),-428,"Unqualified procedure name is found in more than one of the #import packages") continue
							}
							
						}
					}
					else {
						set schema = $$$DefaultSchemaQ, defaultSchema = schema
						set procedure = schemaproc
					}
				}
			}
			Else {
					#; Process delimited identifiers
				set status = $$SeparateIdentifier^%ourProcedure(schemaproc,.schema,.procedure)
				if $$$ISERR(status) { set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New(status,$Get(SQLCODE,-400),$Get(%msg,"Procedure name invalid")) continue }
				set schema = $zstrip(schema,"<>W"), procedure = $zstrip(procedure,"<>W")
				if schema '= "" { set schema = $$$DefaultSchemaQ, defaultSchema = schema }
			}
		}
		else { set schema = "", procedure = "" }
		if $Select(schema="":1,procedure="":1,1:0) { set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New($$$ERROR($$$ProcedureNotFound,schemaproc),-428,"Procedure not found: "_schemaproc) continue }
		set SCHEMA = $$$IDName(schema), PROC = $$$IDName(procedure)
		if '$Data($$$PROC($$$pPROC,SCHEMA,PROC)) && ($Extract(procedure,1,3)="sp_") && ((schema = $$$DefaultSchema) || (SCHEMA = "SYS")) { set schema = "%TSQL", SCHEMA = "%TSQL" }
		if '$Data($$$PROC($$$pPROC,SCHEMA,PROC)) { set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New($$$ERROR($$$ProcedureNotFound,schema_"."_procedure),-428,"Procedure not found: "_schema_"."_procedure) continue }
			#; construct the class name for this result set class 
		set procContextClass = $$ClassNameAlloc^%SYS.SQLSRV()
		set procedureClass = $Get($$$PROCclass($$$pPROC,SCHEMA,PROC))
		if procedureClass = "" { set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New($$$ERROR($$$GeneralError,"Procedure improperly compiled"),-400,"Procedure class invalid"_schemaproc) continue }
		$$$comClassKeyGetLvar(owner,procedureClass,$$$cCLASSowner)
		$$$comClassKeyGetLvar(schema,procedureClass,$$$cCLASSsqlschemaname)
		set status = $$AddUniqueClass^%SYS.ResultSet(.procContextClass,1)
		if $$$ISERR(status) { set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New(status,-400,"Procedure class invalid"_schemaproc) continue }
			#; GeneratedBy indicates that this class is generated
		#; $$$defClassKeySet(procContextClass,$$$cCLASShidden,1)
		if owner '= "" { $$$defClassKeySet(procContextClass,$$$cCLASSowner,owner) }
		if schema '= "" { $$$defClassKeySet(procContextClass,$$$cCLASSsqlschemaname,schema)} 
		if $get(importPackages) '= "" { $$$defClassKeySet(procContextClass,$$$cCLASSimport,importPackages) }
		$$$defClassKeySet(procContextClass,$$$cCLASSfinal,1)
		$$$defClassKeySet(procContextClass,$$$cCLASSsuper,"%XSQL.DS.ContextStatement")
		$$$defClassKeySet(procContextClass,$$$cCLASSgeneratedby,"%SQL.DynamicStatement.CLS")
		$$$defClassKeySet(procContextClass,$$$cCLASSincludecode,"%occXSQLCommands")
		set sequence = 0
				#; set the starting sequence for generated items. User defined items (from the procedure implementation) come first.
		Set staticseq = 1 ; this was the number of columns from the qinfo array.
			#; This is for function procedures only...
		set procedureName=$$$PROCprocedure($$$pPROC,SCHEMA,PROC)
		set interfaceType = $$$PROCinterface($$$pPROC,SCHEMA,PROC)
		do ##class(%XSQL.DSI.Call).AddMethod(procContextClass,"%Execute",.staticseq,.member)
		if interfaceType '= 1 {
			do ##class(%XSQL.DSI.Call).AddMethod(procContextClass,"%Next",.staticseq,.member)
			do ##class(%XSQL.DSI.Call).CompileProcedureContext(procedureClass,procedureName,.procedureCall,.procedureArgs,.tInformixFunctionType)
			if tInformixFunctionType '= "" {
				$$$defMemberSet(procedureClass,$$$cCLASSparameter,"INFORMIXFUNCTIONTYPE","")
				$$$defMemberKeySet(procedureClass,$$$cCLASSparameter,"INFORMIXFUNCTIONTYPE",$$$cPARAMdefault,tInformixFunctionType)
			}
			Set status = ##class(%XSQL.DSI.Call).GenerateProperties(procContextClass,.procedureArgs,.sequence) if $$$ISERR(status) { set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New(status,-400,"Procedure class invalid"_schemaproc) continue }
			Set status = ##class(%XSQL.DSI.Call).GenerateExecute(procedureName,procContextClass,procedureCall,.procedureArgs) if $$$ISERR(status) { set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New(status,-400,"Procedure class invalid"_schemaproc) continue }
			Set status = ##class(%XSQL.DSI.Call).GenerateByName(procedureName,procContextClass,procedureCall,.procedureArgs) if $$$ISERR(status) { set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New(status,-400,"Procedure class invalid"_schemaproc) continue }
			Set status = ##class(%XSQL.DSI.Call).GenerateNext(procContextClass,procedureCall,.procedureArgs) if $$$ISERR(status) { set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New(status,-400,"Procedure class invalid"_schemaproc) continue }
		}
		else {
			do ##class(%XSQL.DSI.Call).CompileQueryContext(procedureClass,procedureName,.procedureCall,.publicCall,.procedureArgs)
			Set status = ##class(%XSQL.DSI.Call).GenerateProperties(procContextClass,.procedureArgs,.sequence) if $$$ISERR(status) { set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New(status,-400,"Procedure class invalid"_schemaproc) continue }
			Set status = ##class(%XSQL.DSI.Call).GenerateExecuteQuery(procedureName,procContextClass,procedureCall,.procedureArgs) if $$$ISERR(status) { set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New(status,-400,"Procedure class invalid"_schemaproc) continue }
			Set status = ##class(%XSQL.DSI.Call).GenerateByNameQuery(procedureName,procContextClass,publicCall,.procedureArgs) if $$$ISERR(status) { set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New(status,-400,"Procedure class invalid"_schemaproc) continue }
		}
		Set versionts = $Horolog
		$$$defClassKeySet(procContextClass,$$$cCLASStimecreated,versionts)
		$$$defClassKeySet(procContextClass,$$$cCLASStimechanged,versionts)
			#; Compile the result set class, keep the class using the same setting as SQL queries use
		Set status = $$Compile^%apiOBJ(procContextClass,$select($$$CQSaveMAC:"k",1:"")_"o3-d")
		if $$$ISERR(status) {
			do Delete^%apiOBJ(procContextClass,"-d")
			set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New(status,-400,"Error encountered while compiling procedure context class: "_schemaproc) continue
		}
			#; link the procedure's container class with this cached statement
		set tables(1) = $Char(1,1,1,1) _ procedureClass
	} while 0
	$$$ResumeAllTrans(tflag) // DPV2749 $$$EnableJournal
	Quit returnError
Catch
	Set $ZTrap=""
	set zerror = $ZError
	if zerror="<SYNTAX>errdone+2^%qaqqt" { set status = $$$ERROR($$$SQLError,$Get(SQLCODE)_" :: "_$Get(%msg)),SQLCODE = $Get(SQLCODE,-400),%msg= $Get(%msg,"Trapped error while compiling procedure context class") }
	elseif $Extract(zerror,1,5) = "<ZRS>" { set SQLCODE = $Get(SQLCODE,-400),%msg = $Get(%msg) }
	else { set status = $$$ERROR($$$ObjectScriptError,zerror),SQLCODE = -400,%msg = $Get(%msg,"Internal Cache error while preparing procedure call") }
	If ($Get(procContextClass) '= "") { do Delete^%apiOBJ(procContextClass,"-d") }
	set procContextClass = "", returnError = ##class(%SYSTEM.Error).%New(status,SQLCODE,%msg)
	If tflag { $$$ResumeAllTrans(tflag) } // DPV2749 $$$EnableJournal
#; TODO: think about this interface and how an error might be returned!
	Quit returnError
}
 
.
---
