====
apiISQL4
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%apiISQL4^MAC^^^0
%apiISQL4
#include %occInclude
	Quit
	
POCCS	Do TestCompileBatchFile("i:\poc_cs.sql","i:\poc_cs.sql.log")
	Quit
		
CTALL	Do TestCompileBatchFile("i:\ct_all.sql","i:\ct_all.sql.log")
	Quit
		
POCCT	Do TestCompileBatchFile("i:\poc_ct.sql","i:\poc_ct.sql.log")
	Quit
		
POCCT1	Do TestCompileBatchFile("i:\poc_ct1.sql","i:\poc_ct1.sql.log")
	Quit
		
	// test-compile all the .sql files in the given directory, logging to the given file
TestCompileDirectory(inputdir,loggingfile) PUBLIC {
			
	// set up logging
	New %xsqllogging
	Do ##class(%XSQL.Reporting).InitLog(loggingfile)
 
	Write "Scanning ",inputdir," .. "
	Set dlm=$Select(inputdir["\":"\",1:"/")
 	If $Extract(inputdir,*)'=dlm {Set inputdir=inputdir_dlm}
 
 	If ##class(%File).DirectoryExists(inputdir)=0 {
		Write "Directory ",inputdir," not found",!
		Quit
 	}
 
 	Set rs=##class(%ResultSet).%New("%File:FileSet")
 	Set sc=rs.Execute(inputdir,"*.sql","")
 	If $$$ISERR(sc) {
	 	Do ReportError^%apiISQL2(sc,"Error scanning directory: "_dir,.outcome)
	 	Quit
 	}
 	If 'rs.Next() {
		Write "No .sql files in directory ",dir,!
		Quit
 	}
 
	Do {
		If rs.GetData(2)'="F" Quit
		Set inputfile=rs.GetData(1)
 
		Write "Loading input from ",inputfile," .. "
		Set input=##class(%FileCharacterStream).%New()
		Do input.LinkToFile(inputfile)
		Set input.LineTerminator=$Char(13,10)
		Do TestCompileBatch(input,logging)
		Write "done",!
		
	} While rs.Next()
 
	Do rs.Close()
}
 
	
	// test-compile the given file, logging to the given file
TestCompileBatchFile(inputfile,loggingfile) PUBLIC {
	
	Write "Loading input from ",inputfile," .. "
	Set input=##class(%FileCharacterStream).%New()
	Do input.LinkToFile(inputfile)
	Set input.LineTerminator=$Char(13,10)
	Write "done",!
	
	// set up logging
	New %xsqllogging
	Do ##class(%XSQL.Reporting).InitLog(loggingfile)
 
	Do TestCompileBatch(input,logging)
}
	
	// given SQL batches in the input stream, try compiling
	// and executing every statement in it and write the
	// results to the logging stream
TestCompileBatch(input,logging) PUBLIC {
	
	// set up logging
	New %xsqllogging
	Do ##class(%XSQL.Reporting).InitLogFromStream(logging)
	
	Kill %xsqlstats
	
	#; DPV2198- If '$Data(%msql) {New %msql Set %msql="_SYSTEM"}
	
	Kill lines Set lines=0
	While 'input.AtEnd {
		
		Set line=$ZStrip(input.ReadLine(),">W")
		
		If (line'?." ") || lines {
 
			Set lines($I(lines))=line
	
			If $Extract(line,*)=";" {
				Write lines(1)," .. "
				For i=1:1:lines {Do Log^%apiISQL(lines(i))}
				Do Log^%apiISQL("")
				Do Dispatch(.lines)
				Write "done",!
				Kill lines Set lines=0
			}
		}
	}
	
	If lines {
		Do Log^%apiISQL("")
		Do Log^%apiISQL("Ignored")
		For i=1:1:lines {Do Log^%apiISQL(" "_lines(i))}
	}
	
	Do ##class(%XSQL.Reporting).LogStats()
}
 
 
Dispatch(lines) PUBLIC {
	Set transformer=##class(%ISQL.Transformer).%New()
	Set input=##class(%Library.GlobalCharacterStream).%New()
	Set input.LineTerminator=$Char(10)
	For i=1:1:lines {Do input.WriteLine(lines(i))}
	Set settings=$Get(^%ISQL("SETTINGS"))
	Kill outcome
	Set sc=$$DoTransform^%apiISQL5(transformer,input,settings,"X",$LB("SPCLASS","SPMETHOD"),,,.outcome)
	If $$$ISERR(sc) {
		Do ReportError^%apiISQL2(sc,"Error in DoTransform",.outcome)
		Quit
	}
}
---
