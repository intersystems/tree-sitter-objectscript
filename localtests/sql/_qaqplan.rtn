	#;-----
	
/// Get the the most current 'tagOffset' whose 'tag' does not have an 
/// ending 'pSub', starting @ 'tagOffsetCurr'...
///
tagCurrOffset(tagName,tagOffsetCurr) [tag] PUBLIC {
	for { // --- Process all 'tagOffsetCurr' Values ---
		set tagOffsetCurr=$o(tag("x-tag",tagName,tagOffsetCurr),-1,tagID)
		QUIT:tagOffsetCurr=""        // No more 'tagOffsetCurr' values!
		QUIT:'+$LG(tag(+tagID),4)    // No ending 'pSub' found :)
	}
	RETURN tagOffsetCurr
}
	
	#;---
	
/// Get the parent 'tag' value to be set into the 5th $LIST(...) piece
/// of the child's 'tag(tagCurr)' array and add this child's 'tagCurr'
/// value to the paren't 6th $LIST(...) piece of children...
///
tagParentChild(tagCurr,pSub) [tag] PUBLIC {
	for tagParent=tagCurr-1:-1 { // --- Search for the Parent 'tag' ---
		QUIT:'$d(tag(tagParent))  // No Parent 'tag'!
		set $LG(,,pSubStart,pSubEnd)=tag(tagParent)
		QUIT:$s(pSubEnd:pSub<pSubEnd,1:pSub>pSubStart)  // Check for Parent 'tag'!
	}
	RETURN:'tagParent ""  // Parent 'tag' not found!
	
	set childrenList=$LG(tag(tagParent),6)
	set childrenList=childrenList_$LB(tagCurr)
	set $LIST(tag(tagParent),6)=childrenList
	
	RETURN tagParent
}
	
	#;---
	
/// Record the module/subquery Header information within the 'module(...)' array...
///
/// NOTE: The 'tag(...)' array is also update via this method.
///
recordModuleHeaderInfo(tagName,modName,modTop,pSub,display) [modCurr,module,%plan,%planHTML,tag] PUBLIC {
	// --- Process 'module(...)' used for processing Call module/subquery invocations --- 
	set modulePar=+$g(module("curr"))  // Parent 'module' value!
	set moduleTop=$s(modTop:module,1:$LG($g(module(modulePar,0)),10))  // SEE: <caller module top>
 	set $LG(callerModPar,callerPSub)=$g(module("caller",tagName,modName,+$g(module("caller",tagName,modName))))
	
	// --- Record 'module(...)' Details ---
	set module(module,0)=$LB(tagName,pSub,,$g(module("curr")),$i(module("level")),tag("stack"),tag,modName,modTop,moduleTop,%planHTML(9)+1,,,callerModPar),module("x-"_tagName,modName)=module,$LIST(tag("stack",tag("stack")),2)=module,(module("curr"),modCurr)=module,$LIST(tag(tag("x-tag",tagName,tag("curr",tagName))),7)=module
	
	// --- Additional Call module/subquery Processing ---
	if callerModPar'="" { // --- Push Stack & Set 'module("x-callName",...)' Index ---
		set module("called",$i(module("called")))=$LB(callerModPar,callerPSub)
		set module("x-callName",tagName,modName,callerModPar,modCurr)=callerPSub
	}
	if display=2.5 { // --- Special Settings When display=2.5 ---
		if modTop { // --- Set 'padLen' Information for 'module' with the attribute 'top=1' ---
			if callerPSub { set $LIST(module(module,0),20)=$s($LG(%plan("info",callerPSub),5)'="":$LG(%plan("info",callerPSub),5),$LG(%plan("info",callerPSub),3):$LG(%plan("info",callerPSub),3),1:$LG(module(modulePar,0),20))+$$$indentLen } // Use 'padLen' (+$$$indentLen) from the Call module/subquery
			else { set $LIST(module(module,0),20)=$LG(%plan("info",pSub-1),3)+$$$indentLen }  // Use 'padLen' (+$$$indentLen) from the previous original 'pLine' (pSub-1)!
		}
		else { // --- Set 'padLen' Information for 'module' with the attribute 'top=0' ---
			if modulePar>1 { set $LIST(module(module,0),20)=$LG(module(modulePar,0),20) } // Use 'padLen' from parent 'module'!
			else { // --- Set 'padLen' Information ---
				if callerPSub { set $LIST(module(module,0),20)=$s($LG(%plan("info",callerPSub),3):$LG(%plan("info",callerPSub),3),$LG(%plan("info",callerPSub),5)'="":$LG(%plan("info",callerPSub),5),1:$LG(module(modulePar,0),20))+$$$indentLen } // Use 'padLen' (+$$$indentLen) from the Call module/subquery
				else { set $LIST(module(module,0),20)=$LG(%plan("info",pSub-1),3)+$$$indentLen }  // Use 'padLen' (+$$$indentLen) from the previous original 'pLine' (pSub-1)!
			}
		}
	}
}
	
	#;---
	
/// Record the module/subquery Call information within the 'module(...)' array...
///
recordCallInfo(labTag,modCurr,callInfoList,pSub,display,padLen) [module] PUBLIC {
	RETURN:callInfoList=""  // No Call Info specified!
	
	set callInfoListAll=$LG(module(modCurr,0),13)_$LB($LB(pSub,callInfoList))
	set $LIST(module(modCurr,0),13)=callInfoListAll
	for callPos=1:1:$LL(callInfoList) { //--- Process 'callInfoList' Elements ---
		set callInfo=$LG(callInfoList,callPos)
		set $LG(callTagName,callName)=callInfo
		set module("caller",callTagName,callName,$i(module("caller",callTagName,callName)))=$LB(modCurr,pSub)
	}
	
	set:display=2.5 $LIST(%plan("info",pSub),5)=padLen  // Record the current 'padLen' when display=2.5!
	RETURN
}
	
	#;-----
	
/// This method accepts the current 'line' from the '%plan(...)' array and swaps all
/// <caller reference>s with appropriate equivalent details based on the value of
/// the 'display' parameter...
///
/// INFORMATION:
///   When the 'display' parameter is passed a value NOT equal to three (3), the 
///   following are the HTML <tag> structures created to define the SQL Plan line that 
///   contains a <caller reference> and the <called module>, as defined by the BNF 
///   definitions specified below:
///
///   LINE WITH <caller reference>:
///     <a href='#<caller id>' name='<caller name>' ...><caller name> (-)</a>
///     <pre id='<caller id>' ...>
///     <span name='<mod-subqry tag><called module>' ...>
///
///   EXAMPLES:
///     #1:
///     plan line: Call Module-F (-) ...
///     HTML line: Call <a href='#moduleF-FIRST-1' name='Module-F' ...>Module-F (-)</a>
///                <pre id='moduleF-FIRST-1' ...>
///                <span name='moduleF' ...>Module-F</span>
///
///     #2:
///     plan line: calling Subquery-E (-).
///     HTML line: calling <a href='#subqueryE-B-1' name='Subquery-E' ...>Subquery-E (-)</a>
///                <pre id='subqueryE-B-1' ...>
///                <span name='subqueryE' ...>Subquery-E</span>
///
///
/// BNF:
///   <mod-subqry tag> ::= module | subquery
///   <mod-subqry Name> ::= Module | Subquery
///   <caller module top> ::= -- The name of the parent/ancestry 'module' or 'subquery'
///                           -- of the current <caller module> whose 'top' attribute
///                           -- is set to the value '1'
///   <caller module> ::= -- The name of the 'module' or 'subquery' that contains a
///                       -- <caller reference>
///   <caller prefix> ::= "Call module " | "in module " | "subquery " | "subqueries "
///   <caller name> ::= <mod-subqry Name>-<called module>
///   <caller reference> ::= <caller prefix> <called module>
///   <caller id start> ::= <mod-subqry tag><called module>-<caller module>
///   <caller id counter> ::= -- The number of times the <caller id start> is referenced
///   <caller id> ::= <caller id start>-<caller id counter>
///   <called module> ::= -- The name of the 'module' or 'subquery' being called
///
///
/// PARAMETERS:
///   moduleID     - The value of the ID associated with the 'module(moduleID)' array
///   callModName  - The <called module> (e.g. FIRST, A...Z, 1..n) that is being called
///   line         - The line associated with the following '%plan(pSub)' array node
///   display      - A flag to determine how the 'line' associated with the '%plan(...)' 
///                  array should be processed/displayed:
///                     0 - 2.5 = See the details specified in the 'planHTML(...)' method
///                         These options will swap all <caller reference> details with
///                         a hyperlink <a>...</a> and related HTML code so that each
///                         <module>/<subquery>/etc. will be displayed in its own
///                         collapsable block, primarily within the System Management
///                         Pages (SMP)
///                     3 = Swap all <caller reference> details used to populate the 
///                         '%plan(...)' array specified as Simple-Text in Inline Plan 
///                         Format (IPF)'
///   callInfoList - A Pass By Reference (PBR) parameter used to return call information
///                  as a $LIST(...)
///
/// RETURN Value: A refactored 'line' with all <caller reference>s swapped out with 
///               appropriate equivalent details
///
swapCallerRefs(moduleID,callModName,line,display,&callInfoList = "") [module] PUBLIC {
	set lineOrig=line  // Record the original line!
	set callInfoList=""
	for swapStr="Call module ","in module ","subquery ","subqueries " { // --- Process All 'swapStr' Values ---
		set callTagName=$CASE(swapStr,"Call module ":"module","in module ":"module","subquery ":"subquery","subqueries ":"subquery",:"module")
		set callTagNameUP1=callTagName,$e(callTagNameUP1,1)=$$$UPPER($e(callTagNameUP1,1))
		
		set swapStrPos=0,swapStrWSLen=$l(swapStr," ")
		for { // --- Process All Found 'swapStr' Values ---
			set swapStrPos=$f(line,swapStr,swapStrPos)
			QUIT:'swapStrPos  // The 'line' doesn't contain any more 'swapStr' values!
			
			set linePrefix=$e(line,1,swapStrPos-$l(swapStr)-1)
			set lineSuffix=$e(line,swapStrPos,*)
			set modName=$$$StripLeadingWhiteSpace(lineSuffix)
			for pos=1:1 { QUIT:$e(modName,pos)'?1an  } // Find 'pos' of first non-AlphaNumeric character!
			set lineSuffix=$e(modName,pos,*),modName=$e(modName,1,pos-1)
			if modName'?1U,modName'?1.n { CONTINUE }  // Skip invalid module names!
			
			// --- Swap the 'modName' with a { hyperlink <a>...</a> | toggle <span>...</span> } based on the 'display' value ---
			set callerIDStart=callTagName_modName_$s(display=2.5:"-"_callModName,1:"")
			set callerID=callerIDStart_$s(display=2.5:"-"_$i(module("caller id counter",callerIDStart)),1:"")
			set callerName=callTagNameUP1_"-"_modName
			set tagPrefix="<a href='#"_callerID_"'"_$s(display=2.5:" name='"_callerName_"' data-expanded='1' onClick=""document.getElementById('"_callerID_"').style.display = this.dataset.expanded == '1' ? 'none' : 'block'; this.innerHTML = this.name + ' (' + (this.dataset.expanded == '1' ? '+' : '-') + ')'; this.dataset.expanded = this.dataset.expanded == '1' ? '0' : '1';""",1:"")_" title='Click to "_$s(display=2.5:"toggle",1:"jump to")_" the display of ("_callerName_")'>",tagSuffix="</a>"
			set linePrefix=linePrefix_$s(swapStrWSLen>2:$p(swapStr," ",1)_" ",1:"")_$s(display=3:"",1:tagPrefix)_callerName_$s(display=2.5:" (-)",1:"")_$s(display=3:"",1:tagSuffix)
			set callInfoList=callInfoList_$LB($LB(callTagName,modName))
			
			if swapStr="subqueries " { // --- Check for [, <module name>, ]* { and <module name>} Values ---
				for swapStrSQ=", "," and " { // --- Process All 'swapStrSQ' Values ---
					set swapStrSQLen=$l(swapStrSQ)
					for { // --- Process All [, <module name>]* { and <module name>} Values ---
						QUIT:$e(lineSuffix,1,swapStrSQLen)'=swapStrSQ  // No more 'swapStrSQ' values!
						
						for pos=swapStrSQLen+1:1 { QUIT:$e(lineSuffix,pos)'?1an  } // Find 'pos' of first non-AlphaNumeric character!
						set modName=$e(lineSuffix,swapStrSQLen+1,pos-1)
						
						set callerIDStart=callTagName_modName_$s(display=2.5:"-"_callModName,1:"")
						set callerID=callerIDStart_$s(display=2.5:"-"_$i(module("caller id counter",callerIDStart)),1:"")
						set callerName=callTagNameUP1_"-"_modName
						set tagPrefix="<a href='#"_callerID_"'"_$s(display=2.5:" name='"_callerName_"' data-expanded='1' onClick=""document.getElementById('"_callerID_"').style.display = this.dataset.expanded == '1' ? 'none' : 'block'; this.innerHTML = this.name + ' (' + (this.dataset.expanded == '1' ? '+' : '-') + ')'; this.dataset.expanded = this.dataset.expanded == '1' ? '0' : '1';""",1:"")_" title='Click to "_$s(display=2.5:"toggle",1:"jump to")_" the display of ("_callerName_")'>",tagSuffix="</a>"
						set linePrefix=linePrefix_$s(modName="and":",",1:swapStrSQ_$s(display=3:"",1:tagPrefix)_callerName_$s(display=2.5:" (-)",1:"")_$s(display=3:"",1:tagSuffix))
						set lineSuffix=$e(lineSuffix,$s(modName="and":2,1:pos),*)
						set:modName'="and" callInfoList=callInfoList_$LB($LB(callTagName,modName))
					}
				}
			}
			set swapStrPos=$l(linePrefix)+1  // Position on first character after ther </a> marker!
			set line=linePrefix_lineSuffix
		}
	}
	RETURN line
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
		
parseEncodedCollate(line) [] PUBLIC {
	if (+$p(line,"(",2))'=0{
		set collateStr = $p(line,"(",1,2)	
	} else{
		set collateStr = $p(line,"(",1)
	}
	if $$$ISENCODEDCOLLATE(collateStr){
			do decodeCollate^%qaqcpre(collateStr,.parm1,.parm2)
			QUIT "%COLLATE("_$$$quote(parm1)_$S(parm2:","_parm2,1:"")_")"_$p(line,collateStr,2)
	}
	RETURN line
}
	
findqn(mod) [mt,mmm] PUBLIC {
	#; find the query block number qn for module mod
	
	// loop through m in the order of decreasing mt("qbo") index to find the largest query block 
	// number such that mod is in the ASL module range of $$$mtP(m)
	Set qbo = "" 
	For {
		Set qbo = $order(mt("qbo", qbo),-1,m)
		Quit:qbo=""
		Set mtp = $$$mtP(m)
		If $p(mtp,"^",5), $p(mtp,"^",6) {
			If (mod >= $p(mtp,"^",5)) && (mod <= $p(mtp,"^",6)){
				Return m
			}
		}
	}
	RETURN mmm
}
	
alias(qb,str) [mt] PUBLIC {
	RETURN:(qb="")||(str="") ""  // One or both of the parameters are the empty-string ("")!
	
	set qbalias="",title="",alias="",stra=""
	for { // --- Process All 'mt("ptrel",qbalias)' Values ---
		set qbalias=$o(mt("ptrel",qbalias),1,stra)
		QUIT:qbalias=""  // No more 'qbalias' values!
		
		set qba=$p(qbalias,"^",1),aliasa=$p(qbalias,"^",2)
		set:aliasa["," aliasa=$p(aliasa,",",*)
		set:aliasa["_%FE" aliasa=$p(aliasa,"_%FE")
		if (qba_","_stra)=(qb_","_str),aliasa'=$g($$$mtFromTableName(qbalias)) { set alias=aliasa }
	}
	if alias["tsq",alias["%" { set alias="" }  // Don't show internally generated subquery table aliases!
	if alias["->" { // --- Process arrow syntax for implicit joins ---
	    set alias=$p(alias,"->",1,*-1)_"->"
		if $p(alias,"->")[".",$e(alias,1,8)="SQLUSER." { set alias=$e(alias,9,*) }  // If there is no user defined alias, 'SQLUSER' can be omitted from the Index Map name!
		set $p(alias,"->",1,2)=$tr($p(alias,"->",1,2),"->",".")  // Replace the first arrow reference with a dot!
	}
	RETURN alias
}
 
findFakeVectorSearchField(ifn) [mt] PUBLIC {
	RETURN:'$d(mt("vdf")) ""
	s key ="" 
	for {
		s key = $o($$$mtVecDistFunc(key),1,value) 
		q:key=""  
		set fval=$$$mtV(key) 
		if ($e(fval)="f")&&($p(fval,"^",3)=ifn) {
			RETURN $$exprname($$$mtV(value))_$$onfields($p($$$mtV(value),"^",3))
		}
	}
	RETURN ""
}
.
---
