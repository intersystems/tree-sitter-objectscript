====
qaqplan
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqplan^MAC^^^0
%qaqplan	// Show plan for SQL queries (Aviel 3/1/2k1)
	;; COMPONENTS :: SQL/RunTime
	#;
#include %msql
#include %sqlEngineObjs
#INCLUDE %SYS.PTools.Stats
#IF 0   ;-------------------------------------------------------------
	; Description:   show plan utility
	; Author:        Aviel Klausner
	; Date Started:  March 1, 2001
	;
	;  AK1047  (10/06/2021) - Columnar WHERE filter for "onerow"/GROUP BY
	;  AK1046  (07/30/2021) - Columnar aggregates with GROUP BY
	;  AK1041  (05/14/2021) - Columnar "onerow" with no WHERE
	;  AK1019  (06/30/2020) - Allow arbitrary QML function nesting
	;  AK1017  (06/18/2020) - Batch multiple ML calls
	;  AK1015  (03/03/2020) - Batch QuickML rows in all cases
	;  MRP1054 (03/20/2018) - Display ShowPlan 'Details' properly within the web-browser container element: <td class="qp-query-plan-container-body">...</td>
	;  MRP1037 (12/29/2017) - Minimize ShowPlan() output in %plan() array, but retain details with 'verbose' option - Phase II
	;  MRP1019 (09/14/2017) - Minimize ShowPlan() output in %plan() array, but retain details with 'verbose' option - Phase I
	;  JSL5140 (07/21/2017) - Process ASL for RTPC
	;  MRP954  (03/23/2017) - Display ShowPlan HTML with nicer formatting & coloring for Frozen Plans
	;  MRP953  (03/21/2017) - Display ShowPlan SQL 'Statement Text' properly within the web-browser container element: <td class="qp-query-text-body"><pre>...</pre></td>
	;  MRP948  (03/09/2017) - Display ShowPlan SQL 'Statement Text' as the canonicalized form of the query, with parameterization and no formatting
	;  MRP939  (03/02/2017) - Add 'top' property to '<subquery>' tag, similar to the 'top' property of the '<module>' tag, within the %plan() array for ShowPlan()
	;  MRP938  (02/28/2017) - Provide better bulleted/itemized line formatting for ShowPlan()
	;  MRP937  (02/27/2017) - Fix browser formatting inconsistency displaying ShowPlan()
	;  MRP924  (01/07/2017) - Retain existing %plan() structure based on (forTest=1) to keep Backward-Compatible for Regression Testing
	;  MRP917  (11/03/2016) - Remove 'DECLARE CURSOR' from SQL <select statement> within SMP: System Explorer->SQL->Execute Query->[Show Plan]
	;  MRP916  (11/03/2016) - Display original SQL Statement Text from SMP: System Explorer->SQL->Execute Query->[Show Plan]
	;  MRP904  (09/18/2016) - Handle SQL Runtime errors when processing 'GetStats()' method for 'ShowPlan()'
	;  MRP903  (09/15/2016) - Cheanup 'ShowPlan()' & enhance resulting array %plan()
	;  MRP901  (09/10/2016) - Modify 'moduleName' and 'LastRow' based on Class and Global Storage restructuring in MRP900
	;  MRP897  (09/04/2016) - Remove duplicate SQL Statements from  SQL Runtime Statistics->View Stats->Show Plan
	;  MRP896  (08/27/2016) - Rewrite and enhance GetStats() method to returns the Stats for a given SQL statement module
	;  MRP879  (06/13/2016) - Allow SQLStats data collection granularity
	;  MRP864  (03/16/2016) - Rewrite ShowPlan() method to allow extensibility for Frozen Plans & display readability
	;  MRP863  (03/16/2016) - Extend Show Plan '%plan() array' with addition details
	;  AK859   (12/28/2015) - ShowPlan for "empty", "jsv" 
	;  PVA331  (09/06/2015) - Support %nofplan directive, display whether a shown plan is frozen, and various other frozen plan changes 
	;  AK907   (02/12/2015) - Parallel partitioning with $$SplitSize
	;  AK887   (02/12/2015) - Bitslice index aggregate support with WHERE clause
	;  AK902   (02/21/2014) - Parallel GROUP BY partitioned by FROM
	;  AK688   (01/24/2008) - Abstract index/filter conditions
	;  AK849   (01/18/2012) - Parallel processing for UNION
	;  BJB524  (02/01/2012) - Change formatting of Stats for Portal Show Plan to make it more readable.
	;  AK793   (12/01/2010) - Compute %VID when and where needed
	;  BJB451  (05/31/2010) - Clean up Stats Display in Show Plan
	;  AK731   (03/19/2009) - EXTQGEN: Show external queries in Plan
	;  DPV3372 (03/12/2009) - Implement utilities to extract SQL and perform ShowPlan on a script
	;  AK671   (01/11/2007) - Upgrade ShowPlan for newer features
	;  BJB360  (08/31/2007) - ShowPlan missing subquery tag when showstats is false
	;  BJB348  (07/11/2007) - Display SQLStats in Query Plan when called from %apiSQL
	;  JLF015  (04/27/2004) - Added support for %ANYOF
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  AK541   (10/25/2002) - ShowPlan for bitmap and BSL operations
	;  AK520   (05/10/2002) - Skip READ-COMMITTED code in ShowPlan
	;  AK516   (04/10/2002) - ShowPlan fix for <expression>
	;  AK494   (11/27/2001) - ShowPlan utility
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
#ENDIF  ;-------------------------------------------------------------
	$$$Abort  ; Not an Entry Point!!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
/// This method accepts a SQL Statement via the 'sql' parameter and all of the
/// SQL Query Processor's information via the 'asl', 'mt', 'cost', and 'mts'
/// parameters, and creates a SQL Query Plan that is returned via the following
/// array:
///   %plan=# of lines/nodes
///   %plan(...)=SQL Query Plan Information
///
/// PARAMETERS:
///   sql         - A Pass By Reference (PBR) array containing the SQL Statement
///                 in the following format:
///                   sql=# of SQL Statement lines
///                   sql(n)=Each line of the SQL Statement text
///   asl         - A PBR array containing the SQL Statement's 'asl' processing
///                 information
///   mt          - A PBR array containing the SQL Statement's parse tree
///                 information
///   cost        - The SQL Query's cost information obtained during SQL Query
///                 Processing and SQL Query Optimization
///   showstats   - A flag to determine whether to generate Runtime Performance
///                 Statistics for each module within the PBR '%plan(...)' array      [DEFAULT: 0]
///                   0 = Don't generate Runtime Performance Statistics
///                   1 = Generate Runtime Performance Statistics
///   sqlOrig     - The original SQL Statement passed as either an array or a string
///   verbose     - A flag to determine how the PBR '%plan(...)' array should be
///                 populated:                                                        [DEFAULT: 0]
///                   0 = Populate the '%plan(...)' array with ONLY top-level module
///                       details, specified as Semi-XML in Linear Plan Format (LPF)
///                   1 = Populate the '%plan(...)' array with all module details,
///                       specified as Semi-XML in Linear Plan Format (LPF)
///                   2 = Populate the '%plan(...)' array with all module details,
///                       specified as Semi-XML in Inline Plan Format (IPF)
///                   3 = Populate the '%plan(...)' array with all module details,
///                       specified as Simple-Text in Inline Plan Format (IPF)
///                 NOTE: If the '%plan(...)' array is to be used as the input to
///                       the 'planHTML^%qaqplan()' method, then the 'verbose'  
///                       parameter must be equal to one (1)
///   json        - A flag to determine whether to generate a Machine Readable Query
///                 Plan (MRQP) rendered in JSON format:                              [DEFAULT: 0]
///                   0 = Don't generate an MRQP
///                   1 = Generate an MRQP
///   mts         - A PBR array containing the SQL Statement's parse tree
///                 supplemental information
///   topq        - A flag to determine if this invocation is the top call to the
///                 'ShowPlan(...)' method (not any recursive calls)
///                   [InterSystems INTERNAL USE ONLY] 
///   seldict     - A PBR array of the dictionary selectivity in the following
///                 format:
///                   seldict(log)=selectivity
///                 NOTE: This value is retrieved from the invocation of the
///                       following method: GetSel^%qaqomul(log,ngate)
///                       This value is obtained or calculated during SQL
///                       Query Processing
///
nliz(sql,asl,mt,cost="",showstats=0,sqlOrig,verbose=0,json=0,mts,topq=1,seldict) ;
	n temptables do findtemptables^%qaqcasl(.temptables)
	n modun s modun=""
	// JSL5154
	new key,value,applyRTPC,isRTQ,RTPCisON
	set key=$O(mt("options","rtpc-"),1,value),applyRTPC=0,isRTQ=0
	for {
		q:$e(key,1,5)'="rtpc-"
		if key = "rtpc-utility" {set applyRTPC = 1}
		else {set isRTQ = 1}
		set key=$O(mt("options",key),1,value) q:key=""
	}
	set RTPCisON=(applyRTPC)&&('isRTQ)
	if json{
		n lmaps,liflds,litabs,plan,tfn,tftab,pqs,pq
		Set lmaps=[],liflds=[],tftab=[],litabs=[]
		Set plan=$$jsonplan^%qaqpjson()
		Set:topq %plan=plan
		If 'topq{
			If %plan.%Get("shard query")=1{
				Do %plan.%Set("shard query",plan)	
			}Else{
				Set pq=%plan.%Get("parallel queries")
				If pq="" {Set pqs=[] Do pqs.%Push(plan),%plan.%Set("parallel-queries",pqs)
				}else{ Do pq.%Push(plan)}
			}
		}
		QUIT
	}
	//Set DML=(",INS,UPD,DEL,")[(","_$Get($$$mtStatementType)_",") //QUIT:(DML&&'($o(asl(""),-1))) // don't quit if there is insert with select
	QUIT:($g(mt("dmlnoselect")))
	new declare,ind,jj,mmm,objAsl,%pinfo,%qpar,sqlLine,sqlLineUPPER,sqlLn1,sqlStmt,statsList,tfn
	set ind=""  // Indent amount used in the 'nuln(...)' method to set the '%plan(...)' array!
	#;  analyze asl/mt, return the result implicitly in the array %plan()
	if $g(forTest) { d nuln("<plan>") }	// Backward-Compatible for Regression Testing
	else { d nuln("<plan"_$s(verbose:" verbose="""_verbose_"""",1:"")_">") }
	d nuln("<sql>")
.
	set declare=$$$UPPER($$$StripLeadingWhiteSpace($g(sqlOrig(1)))),declare=$s($e(declare,1,11)="DECLARE QRS":0,1:$e(declare,1,7)="DECLARE")
	MERGE sqlStmt=sql		// The SQL Statement Text to be added to %plan() as <sql> ... </sql>
	if 'sqlStmt { d nuln(sqlStmt) }
	else {  
		set sqlLn1=0
		for jj=1:1:sqlStmt {	// --- Process SQL Query Lines ---
			set sqlLine=sqlStmt(jj)
			if '$g(forTest)&&'sqlLn1&&'declare {	// Remove DECLARE CURSOR if not part of original SQL Statement
				set sqlLineUPPER=$$$UPPER(sqlLine)
				if $e($$$StripLeadingWhiteSpace(sqlLineUPPER),1,2)'="--" {	// --- First SQL Query Line ---
					set sqlLn1=1	// Mark that SQL Query Line 1 Processed!
					set:$e($$$StripLeadingWhiteSpace(sqlLineUPPER),1,7)="DECLARE" sqlLine=$e(sqlLine,$f(sqlLineUPPER,"CURSOR FOR")+1,*)
					CONTINUE:$tr(sqlLine," ","")=""		// Skip Empty SQL Line!
				}
			}
			do nuln(sqlLine)	// Add SQL Query Line to %plan!
		}
	}
	d nuln("</sql>")
	#;--------------------------------------------------------------------------------
	#;                     PLAN WARNINGS - <warning>...</warning>
	#;--------------------------------------------------------------------------------
	do nuln("<warning>")
	do nonDefaultSettings(1)
	do untunedTables(1)
	do dateToTimestampBehaviorChange(1)
	do collationMismatch(1)
	do nonSelectableIndexes(1)
	do deferredIndexes(1)
	do deferredFields(1)
	do complexCondIndexes(1)
	do nonVecCond(1)
	do checkRTPCError(1)
    do aliasAmbiguity(1)
    do CompatibilityCheck(1)
	do nuln("</warning>")
	if %plan(%plan-1)="<warning>" { // --- Remove Empty <warning> Tag ---
		kill %plan(%plan),%plan($i(%plan,-2)+1)
	}
	#;--------------------------------------------------------------------------------
	#;                       PLAN INFORMATION - <info>...</info>
	#;--------------------------------------------------------------------------------
	do nuln("<info>")
	do checkRTPC()
	do BMCON()
	do PPRUNE()
	do ACORN1()
	do nuln("</info>")
	if %plan(%plan-1)="<info>" { // --- Remove Empty <info> Tag ---
		kill %plan(%plan),%plan($i(%plan,-2)+1)
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	if $g(forTest) {	// Backward-Compatible for Regression Testing
		do:$d(mt("frozen"))||$g(%frozenplan) nuln("<Frozen Plan/>")
		do:cost nuln("<cost value="""_$p(cost,",",1)_"""/>") 
	}
	else { 
		do:$d(mt("frozen"))||$g(%frozenplan) nuln("<frozenPlan />")
		do nuln("<cost value="""_$p(cost,",",1)_"""/>") 
	}
	if showstats {
		set statsList=$$GetStats^%SYS.PTools(.sql,"MAIN",showstats) 
		if '$LV(statsList) { do error(statsList,ind) } 
		elseif statsList'="" { do stats(statsList,ind,verbose) }
	}
	set %pinfo("currMod")=0	// MAIN Module Processed!
	f mmm=1:1:$$$mtPNumQbs d subq(mmm)
	d nuln("</plan>")
	do:verbose>1 planInline(.%plan,verbose)  // Re-format the '%plan(...)' array from Linear Plan Format (LPF) to Inline Plan Format (IPF)!
	QUIT
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
	#;--------------------------------------------------------------------------------
	#;                   P L A N  <warning> & <info>  M E T H O D S
	#;--------------------------------------------------------------------------------
	
/// This method checks the following System-wide SQL Configuration Settings to 
/// determine whether or not their default values have changed:
///
///   SQL:
///     Setting Name               Option Name              Default
///     -------------------------  -----------------------  -------
///     AdaptiveMode               AdaptiveMode             1
///     AutoParallel               AutoParallel             1
///     AutoParallelThreshold      AutoParallelThreshold    3200
///     RTPC                       RTPC                     1
///
///     NOTE: The <Setting Name> is used to access these values within the
///           'iris.cpf' file via the following (Get/Set) method invocations:
///              GET: set val={$$$Get<Setting Name> | $$Get<Setting Name>^%SYS.CONFIG()}
///              SET: set tSC={$$$Set<Setting Name>(<new val>) | $$Set<Setting Name>^%SYS.CONFIG(,<new val>)}
///              GLO: $$$CONFGLO("SQL",<Setting Name>) = ^CONFIG("SQL",<Setting Name>)
///
///           The <Option Name> is used to access these values via the following
///           (Get/Set) method invocations:
///              GET: set val={$$$<Option Name> | $SYSTEM.SQL.Util.GetOption("<Option Name>")}
///              SET: set tSC=$SYSTEM.SQL.Util.SetOption("<Option Name>",<new value>,.oldVal)
///
///           Both the <Setting Name> and the <Option Name> are currently the
///           same for this method, but this may change over time if new
///           SQL Configuration Settings are added to the list.
///
/// If any of these settings have non-default values, which may impact the SQL Query
/// Plan, then collect/return a $LIST(...) of the settings whose values have changed
/// from their original default.  Optional second and third parameters ('default'
/// and 'value') are Pass By Reference (PBR) parameters that returns an array of 
/// default/current values for all of <Setting Name> values that are compared in this
/// method:
///
///    default(<Setting Name>)=<default value>
///    value(<Setting Name>)=<current value>
///
/// In addition, if the 'addWarning' parameter is passed the value one (1), then this
/// method will also create a corresponding <warning> message entry in the '%plan(...)'
/// array, which annotates the processing plan for the SQL Query invocation...
///
nonDefaultSettings(addWarning = 1, &default, &value) [mt] PUBLIC {
	
	set nonDefaultSettingsList=""
	
	kill default,value  // Tabula Rasa!
	
	#;--------------------------------------------------------------------------------
	#; AdaptiveMode - Determines if <Adaptive Mode> is applied to the SQL Query,
	#;                which includes the following 'inclusive options': 
	#;                  - Run Time Plan Choice (RTPC)
	#;                  - Automatic Parallelized Query Execution
	#;                  - Automatic tuning of untuned tables
	#;                  - Frozen/Upgrade query plans
	#;                  - etc.
	#;
	#; NOTE: If this setting is disable, then all of the 'inclusive options'
	#;       listed above will also be disabled.
	#;
	#;       See the following documentation for additional details:
	#;         https://docs.intersystems.com/irislatest/csp/docbook/DocBook.UI.Page.cls?KEY=RACS_AdaptiveMode
	#;
	#;       This SQL Configuration Setting can be enabled/disabled from the 
	#;       System Management Portal (SMP), by checking the following option: 
	#;       (System Administration -> Configuration -> SQL and Object Settings -> SQL [Go])
	#;         Turn off Adaptive Mode to disable run time plan choice, automatic tuning, and Frozen/Upgrade query plans [ ]
	#;
	#;       Optionally, this SQL Configuration Setting can be modified by invoking
	#;       the following method:
	#;          set tSC=$SYSTEM.SQL.Util.SetOption("AdaptiveMode",<new val>,.oldVal)
	#;--------------------------------------------------------------------------------
	set settingName="AdaptiveMode"
	set default(settingName)=$$$ADAPTIVEMODEDEFAULT
	set value(settingName)=$$$AdaptiveMode
	if value(settingName)'=default(settingName) { // --- Record this SQL Setting which has changed from its Default Value ---
		set nonDefaultSettingsList=nonDefaultSettingsList_$LB($LB(settingName,value(settingName),default(settingName)))
	}
	
	#;--------------------------------------------------------------------------------
	#; AutoParallel - Determines whether or not the SQL Query will be executed using
	#;                Parallel Processing, which is typically more efficient.  In a
	#;                sharded environment, all SQL Queries will be executed using
	#;                Parallel Processing.  If this setting is enabled in a non-
	#;                sharded environment, the SQL Processor will determine whether
	#;                or not to use Parallel Processing based on the value of 
	#;                <AutoParallelThreshold> setting.  If disabled, all SQL Queries
	#;                will be executed in a single process.
	#;
	#; NOTE: If <AutoParallel> is disabled, only SQL Queries that explicitly specify
	#;       the %PARALLEL directive will be executed using Parallel Processing,
	#;       assuming all other parallel conditions are satisfied.
	#;
	#;       This SQL Configuration Setting can be enabled/disabled from the 
	#;       System Management Portal (SMP), by checking the following option: 
	#;       (System Administration -> Configuration -> SQL and Object Settings -> SQL [Go])
	#;          Execute queries in a single process [ ]
	#;
	#;       Optionally, this SQL Configuration Setting can be modified by invoking
	#;       the following method:
	#;          set tSC=$SYSTEM.SQL.Util.SetOption("AutoParallel",<new val>,.oldVal)
	#;--------------------------------------------------------------------------------
	set settingName="AutoParallel"
	set default(settingName)=$$$AutoParallelDefault
	set value(settingName)=$$$AutoParallel
	if value(settingName)'=default(settingName) { // --- Record this SQL Setting which has changed from its Default Value ---
		set nonDefaultSettingsList=nonDefaultSettingsList_$LB($LB(settingName,value(settingName),default(settingName)))
	}
	
	#;--------------------------------------------------------------------------------
	#; AutoParallelThreshold - Determines the Threshold of the Auto Hinting %PARALLEL
	#;                         setting.  The higher the value the lower the chance
	#;                         that the SQL Query will be executed using Parallel
	#;                         Processing.  This value corresponds roughly to the 
	#;                         minimal number of tuples needed in the visited map for
	#;                         Parallel Processing to occur. 
	#;
	#; NOTE: If <AutoParallel> is disabled, this value has no effect.
	#;
	#;       This SQL Configuration Setting can be modified by invoking the 
	#;       following method:
	#;          set tSC=$SYSTEM.SQL.Util.SetOption("AutoParallelThreshold",<new val>,.oldVal)
	#;--------------------------------------------------------------------------------
	set settingName="AutoParallelThreshold"
	set default(settingName)=$$$AutoParallelThresholdDefault
	set value(settingName)=$$$AutoParallelThreshold
	if value(settingName)'=default(settingName) { // --- Record this SQL Setting which has changed from its Default Value ---
		set nonDefaultSettingsList=nonDefaultSettingsList_$LB($LB(settingName,value(settingName),default(settingName)))
	}
	
	#;--------------------------------------------------------------------------------
	#; RTPC - Determines if Run Time Plan Choice (RPTC) is applied to the SQL Query,
	#;        which performs extensive optimization of the SQL Query based on its
	#;        input values.
	#;
	#; NOTE: If <RTPC> is disabled and <Adaptive Mode> is enabled, then a <warning>
	#;        message will be generated for this condition.
	#;
	#;       See the following documentation for additional details:
	#;         https://docs.intersystems.com/irislatest/csp/docbook/DocBook.UI.Page.cls?KEY=RACS_RTPC
	#;
	#;       This SQL Configuration Setting can be enabled/disabled by invoking
	#;       the following method:
	#;          set tSC=$SYSTEM.SQL.Util.SetOption("RTPC",<new val>,.oldVal)
	#;--------------------------------------------------------------------------------
	set settingName="RTPC",settingNameFull="Run Time Plan Choice"
	set default(settingName)=$$$RTPCDefault
	set value(settingName)=$$$RTPCGLOBSETTING
	if value(settingName)'=default(settingName) { // --- Record this SQL Setting which has changed from its Default Value ---
		set nonDefaultSettingsList=nonDefaultSettingsList_$LB($LB(settingNameFull_" ("_settingName_")",value(settingName),default(settingName)))
	}
	elseif 'value(settingName),value("AdaptiveMode") { // --- Record this SQL Setting since it is Disabled while the <AdaptiveMode> Setting is Enabled ---
		set nonDefaultSettingsList=nonDefaultSettingsList_$LB($LB(settingNameFull_" ("_settingName_")",value(settingName),default(settingName)))
	}
	
	if addWarning,nonDefaultSettingsList'="" { // --- Process Non-Default SQL Settings <warning> Message(s) ---
		if $LL(nonDefaultSettingsList)>1 { set warningMsg="The following System-wide SQL Configuration Settings, which impact the SQL Query Plan, have been changed from their default values: " }  // Plural Message!
		else { set warningMsg="The following System-wide SQL Configuration Setting, which impacts the SQL Query Plan, has been changed from its default value: " }  // Singular Message!
		
		set warnOptMsg=""
		for pos=1:1:$LL(nonDefaultSettingsList) { // --- Process Each Setting Change ---
			set $LG(settingName,valCurr,valDef)=$LG(nonDefaultSettingsList,pos)
			if settingName="AutoParallelThreshold" { // --- External Value ---
				set valCurrExt=valCurr
				set valDefExt=valDef
			}
			else { // --- External Value ---
				set valCurrExt=$CASE(valCurr,0:"0 (Disabled)",1:"1 (Enabled)",:"0 (Disabled)")
				set valDefExt=$CASE(valDef,0:"0 (Disabled)",1:"1 (Enabled)",:"0 (Disabled)")
			}
			set warnOptMsg=warnOptMsg_$s(warnOptMsg'="":"; ",1:"")_settingName_": "_valCurrExt_" [DEFAULT: "_valDefExt_"]"
		}
		do nuln(warningMsg_warnOptMsg)  // Full <warning> Message!
	}
	
	RETURN nonDefaultSettingsList
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
/// This method searches through all of the tables that are used to process a given
/// SQL Query and collects/returns a $LIST(...) of all non-selectable Indexes.
/// 
/// In addition, if the 'addWarning' parameter is passed the value one (1), then this
/// method will also create a corresponding <warning> message entry in the '%plan(...)'
/// array, which annotates the processing plan for the SQL Query invocation...
/// 
nonSelectableIndexes(addWarning = 1) [mt] PUBLIC {
	
	set nonSelectableIndexList=""  // A $LIST(...) containing all non-selectable Index Names from the tables used to process the SQL Query!
	
	set str="",irnProcList=""
	for { // --- Process 'Stream Information' Array '$$$mtR(str)' ---
		set str=$o($$$mtR(str),1,strinfo)
		QUIT:str=""  // No more 'str' values!
		
		set irn=$p(strinfo,"^")
		CONTINUE:$LF(irnProcList,irn)        // Skip tables that have already been processed!
		CONTINUE:$g($$$smd(1,irn))=""        // Skip virtual tables!
		CONTINUE:$$$smdIsAFakeTable(1,irn)	// Skip fake foreign table streams
		
		set irnProcList=irnProcList_$LB(irn) // Keep a $LIST(...) of Processed Tables!
		set tabName=$s($$$smdTType(irn)'="":$$$smdGetIqnFromIrn(irn),1:"")
		set mapName="",indexProcList=""
		for { // --- Process All Table Indexes ---
			set mapName=$o($$$smd(1,irn,"map",mapName))
			QUIT:mapName=""  // No more 'mapName' values!
			set imp=$o($$$smd(1,irn,"map",mapName,""))
			CONTINUE:imp=""  // Skip empty 'imp'!
			if $SYSTEM.SQL.Util.GetMapSelectability(tabName,mapName)'=1 { // --- Record Non-Selectable Index ---
				set impMap=$$map(imp)
				set impMapNorm=$s(indexProcList="":$$$UPPER($e(impMap))_$e(impMap,2,*),1:impMap) // Capitalize the first index name (word) in the <warning> message!
				set indexProcList=indexProcList_$LB(impMapNorm)
				set nonSelectableIndexList=nonSelectableIndexList_$LB(impMap)
			}
		}
		do:(indexProcList'="")&&addWarning nuln($$commas(indexProcList)_$s($LL(indexProcList)>1:" are",1:" is")_" not selectable.")
	}
	RETURN nonSelectableIndexList
}
	
/// This method searches through all of the tables that are used to process a given
/// SQL Query and collects/returns a $LIST(...) of all Deferred Indexes.
/// 
/// In addition, if the 'addWarning' parameter is passed the value one (1), then this
/// method will also create a corresponding <warning> message entry in the '%plan(...)'
/// array, which annotates the processing plan for the SQL Query invocation...
/// 
deferredIndexes(addWarning = 1) [asl] PUBLIC {
	
	set deferredIndexList=""  // A $LIST(...) containing all Deferred Index Names from the tables used to process the SQL Query!
	set m="",impProcList=""
	for { // --- Process each asl module ---
		set m=$o($$$aslMod(m)) quit:m=""
		set key=""
		for {
			set key=$o($$$aslRoot(m,key)) quit:key=""
			set nn=""
			for {
				set nn=$o($$$aslPk(m,key,nn)) quit:nn=""
				continue:'$d($$$aslPkId(m,key,nn),data)
				continue:$$$aslIdKeyAccessType(data)'="map"	// not a map access
				set imp=$$$aslIdMapId(data)
				continue:imp=""	// possible?
				continue:'$d($$$smd(12,imp))		// Not a real map
				continue:$$$smdMapMaster(imp)="Y"
				set irn=$$$smdMapIrn(imp)
				continue:$LF(impProcList,irn)        // Skip tables that have already been processed!
				continue:$g($$$smd(1,irn))=""        // Skip virtual tables!
				continue:$$$smdIsAFakeTable(1,irn)	// Skip fake foreign table streams
			
				set impProcList=impProcList_$LB(imp) // Keep a $LIST(...) of Processed maps!
				set tabName=$s($$$smdTType(irn)'="":$$$smdGetIqnFromIrn(irn),1:"")
				set mapName=$$$smdMapName(imp) continue:mapName=""
				set extent=$$$smdExtent(1,irn) continue:extent=""
				set mapinfo=$g($$$EXTSQLMAPsqlinfo($$$rEXT,extent,mapName))
				if $$$SQLLocMapDeferred(mapinfo) {		// map is Deferred
					set deferredIndexList=deferredIndexList_$LB(tabName_"."_mapName)
				}
			}
		}
	}
	if deferredIndexList'="",addWarning {
		if $LL(deferredIndexList)>1 { do nuln("Index maps "_$$commas(deferredIndexList)_" are defined as Deferred; data may be incomplete.") }
		else						{ do nuln("Index map "_$$commas(deferredIndexList)_" is defined as Deferred; data may be incomplete.")}
	}
	RETURN deferredIndexList
}
.
/// This method searches through all of the fields that are used to process a given
/// SQL Query and collects/returns a $LIST(...) of all Deferred Fields.
/// 
/// In addition, if the 'addWarning' parameter is passed the value one (1), then this
/// method will also create a corresponding <warning> message entry in the '%plan(...)'
/// array, which annotates the processing plan for the SQL Query invocation...
/// 
deferredFields(addWarning = 1) [mt] PUBLIC {
	
	set deferredFieldList=""  // A $LIST(...) containing all Deferred Field Names from the tables used to process the SQL Query!
	set val="",ifnProcList=""
	for { // --- Process 'Stream Information' Array '$$$mtR(str)' ---
		set val=$o($$$mtV(val),1,vinfo) quit:val=""		// No more 'val' values!
		continue:$e(vinfo,1)'="f"						// not a field
		set str=$p(vinfo,"^",2)
		set irn=$$$mtRIrn($$$mtR(str))
		continue:$g($$$smd(1,irn))=""					// Skip virtual tables!
		continue:$$$smdIsAFakeTable(1,irn)				// Skip fake foreign table streams
		set ifn=$p(vinfo,"^",3)
		if ifn=""||($lf(ifnProcList,ifn)) {continue }	// Only check a field once
		set ifnProcList=ifnProcList_$LB(ifn)			// Keep a $LIST(...) of Processed Fields!
		set tabName=$s($$$smdTType(irn)'="":$$$smdGetIqnFromIrn(irn),1:"")
		set extent=$$$smdExtent(1,irn) continue:extent=""
		set fldName=$$$smdGetFieldName(ifn) continue:fldName=""
		set fldInfo=$g($$$EXTSQLCOLsqlinfo($$$rEXT,extent,fldName))
		if $$$SQLLocColDeferred(fldInfo) {				// field is Deferred
			set deferredFieldList=deferredFieldList_$LB(tabName_"."_fldName)
		}
	}
	if (deferredFieldList'="")&&addWarning {
		if $LL(deferredFieldList)>1 { do nuln("Fields "_$$commas(deferredFieldList)_" are defined as Deferred; data may be incomplete.") }
		else                        { do nuln("Field "_$$commas(deferredFieldList)_" is defined as Deferred; data may be incomplete.") }
	}
	RETURN deferredFieldList
}
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
/// This method searches through all of the tables that are used to process a given
/// SQL Query and collects/returns a $LIST(...) of all Untuned Tables. 
/// 
/// In addition, if the 'addWarning' parameter is passed the value one (1), then this
/// method will also create a corresponding <warning> message entry in the '%plan(...)'
/// array, which annotates the processing plan for the SQL Query invocation...
///
untunedTables(addWarning = 1) [mt] PUBLIC {
	
	set untunedTabList=""  // A $LIST(...) of all Untuned Table Names!
	
	set str="",irnProcList=""
	for { // --- Process 'Stream Information' Array '$$$mtR(str)' ---
		set str=$o($$$mtR(str),1,strinfo)
		QUIT:str=""  // No more 'str' values!
		
		set irn=$p(strinfo,"^")
		CONTINUE:$LF(irnProcList,irn)        // Skip tables that have already been processed!
		CONTINUE:$g($$$smd(1,irn))=""        // Skip virtual tables!
		set irnProcList=irnProcList_$LB(irn) // Keep a $LIST(...) of Processed Tables!
		set tabName=$s($$$smdTType(irn)'="":$$$smdGetIqnFromIrn(irn),1:"")
		if '$$isTuned^%qaqpsq(irn) { // --- Keep a $LIST(...) of Un-Tuned Tables ---
			set:(tabName'["%TSQL_sys") untunedTabList=untunedTabList_$LB(tabName)
		}
	}
	set untunedTabCnt=$LL(untunedTabList)
	do:untunedTabCnt&&addWarning nuln("Table"_$s(untunedTabCnt>1:"s ",1:" ")_$$commas(untunedTabList)_$s(untunedTabCnt>1:" are",1:" is")_" not tuned.")
	
	RETURN untunedTabList
}
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
/// This method checks for mismatching NLS Collation information in the SQL parsing
/// array 'mt("collationMismatch",...)', which is generated during the processing of
/// a given SQL Query, and collects/returns a $LIST(...) of globals that have an
/// NLS Collation that is different than that of the globals in the current process.
/// Each $LIST(...) element will contain the following information:
///   <gbl name> (<nls coll>)[, <gbl name> (<nls coll>)]* (Table: <table name>)
/// In the case where the NLS Collation for the globals in the 'IRISTEMP' database
/// is different than that of the globals in the current process, the $LIST(...) 
/// element will contain the following information:
///   "All globals from the 'IRISTEMP' database (<nsl coll>)"
///
/// In addition, if the 'addWarning' parameter is passed the value one (1), then this
/// method will also create a corresponding <warning> message entry in the '%plan(...)'
/// array, which annotates the processing plan for the SQL Query invocation...
///
collationMismatch(addWarning = 1) [mt] PUBLIC {
	
	RETURN:'$g($$$mtCollationMismatchMarker) ""  // There is no mismatching NLS Collation for the given SQL Query!
	
	set collationMismatchList=""  // A $LIST(...) of globals that have mismatching NLS Collation!
	
	set warningMsg=""
	set tableCnt=$$$mtCollationMismatchMarker
	set procNLSColl=$g($$$mtCollationMismatchInProcess)
	set iristempNLSColl=$g($$$mtCollationMismatchInIrisTemp)
	
	if iristempNLSColl'="" { // --- The NLS Collation for the Globals in the 'IRISTEMP' Database is different than that of the Globals in the Current Process ---
		set tableCnt=tableCnt-1 
		set warningMsg=warningMsg_$s(warningMsg="":"The",1:"the")_" NLS Collation for the globals in the 'IRISTEMP' database ("_iristempNLSColl_")"_$s('tableCnt:" is different than that of the globals in the current process ("_procNLSColl_")",1:" and ")
		set collationMismatchList=collationMismatchList_$LB("All globals from the 'IRISTEMP' database ("_iristempNLSColl_")")
	}
	
	if tableCnt { // --- The NLS Collation for the Table's Globals is different from that of the Globals in the Current Process  ---
		set irn="",warningMsgTableGbls="",gblCnt=0
		for node=1:1:tableCnt { // --- Process All Table 'irn' Values in '$$$mtCollationMismatchInTable(irn)' ---
			set irn=$o($$$mtCollationMismatchInTable(irn),1,collMismatchInfo)  // collMismatchInfo="<gbl name> (<nls coll>)[, <gbl name> (<nls coll>)]*"  for each of the Table's Index Maps with mismatching NLS Collation!
			QUIT:irn="" // No more 'irn' values! 
			
			set gblCnt=gblCnt+$l(collMismatchInfo,"),")
			set table=$$table(irn)
			set tableGbls=collMismatchInfo_" (Table: "_table_")"
			set warningMsgTableGbls=warningMsgTableGbls_tableGbls_$s(node=tableCnt:"",(node+1)=tableCnt:" and ",1:", ")
			set collationMismatchList=collationMismatchList_$LB(tableGbls)
		}
		set warningMsg=warningMsg_$s(warningMsg="":"The",1:"the")_" NLS Collation for the following global"_$s(gblCnt>1:"s",1:"")_" is different than that of the globals in the current process ("_procNLSColl_"): "_warningMsgTableGbls
	}
	
	set warningMsg=warningMsg_". This may result in wrong results."
	do:addWarning nuln(warningMsg)
	
	RETURN collationMismatchList
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
/// This method checks for SQL Queries processed via the Run Time Plan Choice (RTPC)
/// optimization, which is specified within the 'nRTP("logInfo",...)' array, and
/// creates a corresponding <info> message entry in the '%plan(...)' array, which 
/// annotates the processing plan for the SQL Query invocation...
///
/// Based on the new Run Time Plan Choice (RTPC) optimization, the SQL Query Processor
/// will be able to pick the right query plan dynamically based on the values of the
/// query's parameters.  Using the RTPC processing paradigm, the SQL Query will be
/// checked for specific condition at prepare time: e.g. if the <where clause> 
/// specifies an outlier condition or a range condition, etc.  If the condition is
/// satisfied, the query is not sent to SQL Optimizer, but instead a SQL Dispatch
/// class is generated for the query.  When the SQL Query is ultimately executed, 
/// the SQL Query Processor invokes the generated SQL Dispatch class, which analyzes
/// the query's parameter values to determine whether to create or choose a runtime 
/// Cached Query (CQ) to process the SQL Execution.  The RTPC optimization performs
/// the following phases which is checked by this method to determine whether or not
/// to generate an <info> message entry in the '%plan(...)' array:
///
///   - Phase 1: Mechanisms Instead of Conditions
///              During SQL prepare time, check for to see if the SQL Query
///              contains both a <where clause> and the following options-
///              qualifier: /*#OPTIONS {""rtpc-utility"":1} */
///              If the above conditions are satisfied, a SQL Dispatch class is
///              generated for the query which will be used at SQL execution
///              time to either create or choose a runtime CQ for SQL execution.
///   - Phase 2: Outlier Conditions
///   - Phase 3: Truth Value Conditions
///   - Phase 4: Allow Expressions (with restrictions)
///   - Phase 5: Range Conditions
///   - Phase 6: LIST Length Conditions (via %INLIST)
/// 
checkRTPC() [applyRTPC,ind,isRTQ,nRTP] PUBLIC {
	if $d(nRTP("logInfo")) { // --- Process RTPC SQL Queries that Support a Specific Condition (Phase 1) ---
		set rangeConds="",outlierConds="",truthConds=""
		
		if $d(nRTP("logInfo","range"))||$d(nRTP("logInfo","listlength")) { // --- Process RTPC SQL Queries that Support 'Range Conditions' (Phase 5) and 'List Length' Conditions (via %INLIST') (Phase 6) ---
			set condList=$g(nRTP("logInfo","range"))_$g(nRTP("logInfo","listlength"))
			set ptr=0,warnCondList=""
			for { // --- Process All $LIST(...) Elements of 'condList' ---
				QUIT:'$LISTNEXT(condList,ptr,cond)  // No more $LIST(...) elements!
				CONTINUE:'$d(cond)  // Skip empty $LIST(...) elements!
				
				set warnCondList=warnCondList_$LB($$condname($LG(cond,1),1)_" on "_$$field($LG(cond,2)))
			}
			set rangeConds="Improved selectivity estimation of "_$$commas(warnCondList)_"."
		}
		if $d(nRTP("logInfo","outlier")) { // --- Process RTPC SQL Queries that Support 'Outlier Application' Conditions (Phase 2) ---
			set condList=$g(nRTP("logInfo","outlier"))
			set ptr=0,warnCondList=""
			for { // --- Process All $LIST(...) Elements of 'condList' ---
				QUIT:'$LISTNEXT(condList,ptr,cond)  // No more $LIST(...) elements!
				CONTINUE:'$d(cond)  // Skip empty $LIST(...) elements!
				
				set warnCondList=warnCondList_$LB($$condname($LG(cond,1),1)_" on "_$$field($LG(cond,2)))
			}
			set outlierConds="Using the outlier selectivity in "_$$commas(warnCondList)_"."
		}
		if $d(nRTP("logInfo","truthvalue")) { // --- Process RTPC SQL Queries that Support 'Truth Value Application' Conditions (Phase 3) ---
			set condList=nRTP("logInfo","truthvalue")
			set ptr=0,warnCondList=""
			for { // --- Process All $LIST(...) Elements of 'condList' ---
				QUIT:'$LISTNEXT(condList,ptr,cond)  // No more $LIST(...) elements!
				CONTINUE:'$d(cond)  // Skip empty $LIST(...) elements!
				
				set ptr2=0,argList=""
				for { // --- Process All $LIST(...) Elements of 'condList' ---
					QUIT:'$LISTNEXT(cond,ptr2,arg)  // No more $LIST(...) elements!
					
					set:$e(arg,1,11)="x^%CallArgs" argList=argList_$LB("arg"_+$p(arg,"x^%CallArgs(",2))
				}
				set warnCondList=warnCondList_$LB($$condname($LG(cond,1),1)_" on "_$$commas(argList,,,1))
			}
			set truthConds="Boolean truth value of "_$$commas(warnCondList)_"."
		}
		if $d(nRTP("logInfo","vdf")) { // --- Process RTPC SQL Queries that Support 'Same vector distance function' (Phase 4) ---
			set condList=nRTP("logInfo","vdf")
			set ptr=0,warnCondList=""
			for { // --- Process All $LIST(...) Elements of 'condList' ---
				QUIT:'$LISTNEXT(condList,ptr,cond)  // No more $LIST(...) elements!
				CONTINUE:'$d(cond)  // Skip empty $LIST(...) elements!
				set warnCondList=warnCondList_$lb($LG(cond,1))
			}
			set truthConds="Boolean equivalence of vector distance function in ORDER BY and SELECT of query block "_$$commas(warnCondList)_"."
		}
		do indent("This query plan was selected based on the runtime parameter values that led to:")
		do:rangeConds'="" nuln(rangeConds)
		do:outlierConds'="" nuln(outlierConds)
		do:truthConds'="" nuln(truthConds)
	}
	elseif applyRTPC,isRTQ { // --- Process RTPC-Enabled SQL Queries With Parameter Values [More than one <rptc sub> value specified for 'mt("options",<rptc sub>)' where <rptc sub>?1"rtpc-".e (e.g. "rtpc-utility" & "rtpc-log-sel", etc.)] ---
		do nuln("This plan was selected based on the runtime parameter values.")	
	}
	elseif applyRTPC,'isRTQ { // --- Process RTPC-Enabled SQL Queries Without Parameter Values [ONLY one <rptc sub> value specified for 'mt("options",<rptc sub>)' where <rptc sub>?1"rtpc-".e (e.g. "rtpc-utility")] ---
		do nuln("Different runtime parameter values may use a different plan.")
	}
	set ind=""  // Don't indent the next '%plan(...)' node!
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
BMCON() [mt] PUBLIC {
	if $lf($g($$$mtLogOpt),"BMCON") {
		do nuln("This plan combines bitmap and columnar indexes.")
	}
}
.
ACORN1() [mt] PUBLIC {
	if $lf($g($$$mtLogOpt),"ACORN-1") {
		do nuln("This plan uses the ACORN-1 algorithm for vector search.")
	}
}
PPRUNE() [mt] PUBLIC {
	if $lf($g(mt("logopt")),"PPRUNE") {
		do nuln("This plan utilizes partition pruning.")
	}
}
.
/// This method searches through all of the tables that are used to process a given
/// SQL Query and collects/returns a $LIST(...) of all non-sargable Complex 
/// Conditional Indexes.
/// 
/// In addition, if the 'addWarning' parameter is passed the value one (1), then this
/// method will also create a corresponding <warning> message entry in the '%plan(...)'
/// array, which annotates the processing plan for the SQL Query invocation...
///
/// NOTE:
///   The term sargable is derived from a contraction of the words (s)earch and 
///   (arg)ument, with the suffix (able) added to construct the term.  
///   A condition or predicate within a SQL Query is considered sargable if there
///   exists a index within any of the query's underlying tables that can be used
///   to optimize the execution of that query.
/// 
complexCondIndexes(addWarning = 1) [asl,mt,mts] PUBLIC {
	
	set complexCondIndexList=""  // A $LIST(...) containing all non-sargable Complex Conditional Index Names from the tables used to process the SQL Query!
	
	set badCondList=""  // A $LIST(...) containing log# of Conditions -> $$$mtL(log#)
	set mod=""
	for { // --- Process All 'mod' Values within the 'asl(mod)' Array ---
		set mod=$o($$$aslMod(mod))
		QUIT:mod=""  // No more 'mod' values!
		
		#; --- Search for Complex Conditions under $p7 of 'asl(mod,2,item,"next",nextSub)' array ---
		set item=""
		for { // --- Process All Looping Subscipts 'item' --- 
			set item=$o($$$aslK(mod,item))
			QUIT:item=""  // No more 'item' values!
			CONTINUE:$g($$$aslKId(mod,item))=""  // Skip entries with no 'subscript' information!
			set mapid=$$$aslIdMapId($$$aslKId(mod,item))  // The mapid of the Map/Index that we are 'nexting' on!
			CONTINUE:mapid=""  // Skip entries that don't have a 'mapid'!
			
			set str=$$$aslIdStrNum($$$aslKId(mod,item)),m=$$$aslIdQb($$$aslKId(mod,item)),ifn=$p(mts(m,str,"MAP",mapid),"^",9)
			set nextSub=""
			for { // --- Process All Nexting Fields 'nextSub' ---
				set nextSub=$o($$$aslKNext(mod,item,nextSub),1,nextInfo)
				QUIT:nextSub=""  // No more 'nextSub' values!
				
				#; --- If there is another condition that is sargable on the same subscript, it's ok to have a Complex Condition ---
				set limits=0
				for pos=3:1:6 { if +$p(nextInfo,$c(1),pos) { set limits=1 QUIT } } // Check for rang conditions: start/stop value, etc.
				set:'limits badCondList=badCondList_$LFS($$$aslNextAdditionalCondsOnSubscript(nextInfo))
			}
		}
		CONTINUE:'$d($$$aslPostkeyRoot(mod))  // Skip entries that don't have any Pos-Key Specifications!
		
		#; --- Search for Complex Conditions under 'asl(mod,3,item,"cond")' ---
		set item=""
		for { // --- Process All Post-Key Entries 'item' ---
			set item=$o($$$aslPk(mod,3,item))
			QUIT:item=""  // No more 'item' values!
			CONTINUE:$g($$$aslPkConds(mod,3,item))=""  // Skip entries that don't have any Query Condition Specifications!
			
			set badCondList=badCondList_$LFS($$$aslPkConds(mod,3,item))
		}
	}
	
	set m=""
	for { // --- Process All Query Blocks 'm' ---
		set m=$o(mts(m))
		QUIT:'+m  // No more 'm' values!
		
		set str=""
		for { // --- Process All Streams 'str' ---
			set str=$o(mts(m,str))
			QUIT:'+str // No more 'str' values!
			
			// --- Display a warning when a collation mismatch occurs that could potentially result in a CON or RANGE condition not utilizing an Index Map ---
			for type="CON","RANGE" { // --- Process These Special Conditional Types ---
				set mismatchCondIndexList=$$checkCondVsIndexSubCollMismatch(m,str,type,1)
				set complexCondIndexList=complexCondIndexList_mismatchCondIndexList
			}
			
			CONTINUE:$p($g(mts(m,str)),"^")<10000 // Don't show a warning for complex conditions if there are less than 10,000 tuples
			
			set comp=""
			for { // --- Process All Complex Stream Restrictions 'comp' ---
				set comp=$o(mts(m,str,"COMP",comp))
				QUIT:comp=""  // No more 'comp' values!
				CONTINUE:'$LF(badCondList,comp)  // Skip if it's not a bad condition!
				
				set op=$$$mtLOperator($$$mtL(comp))    // Either a boolean or scalar operand based on the first "^" piece being "l" or "v" respectively!
				CONTINUE:",'NULL,DISTINCT,"[(","_op_",")    // Skip specific operands!
				#; Complex conditions that are multi-field are not sargable and cannot benefit from using an index. No warning needed so far
				set flds=$$$mtLColVals($$$mtL(comp))  // LIST(,val#,) for boolean operands only (e.g. first "^" piece is "l")
				CONTINUE:$l(flds,",")'=3         // Skip if not 3 comma pieces! No need to show a warning for multi-field conditions
				set val=$p(flds,",",2)           // The field upon which the boolean operand is being performed: $$$mtV(val)
				set hasCondInMapSubsIndexList=$$hasCondInMapSubs(val,m,str)
				CONTINUE:hasCondInMapSubsIndexList=""  // Skip Index Maps that can't satisfy the condition within their subscripts!
				
				set ifn=+$p($$$mtV(val),"^",3)         // 'ifn' for the parse tree 'val' (field)
				set ifnRowID=$p($g(mts(m,str)),"^",5)  // 'ifn' of the RowID
				set table=$$table(+$$$mtR(str))
				set warningMsg="Complex condition "_$$logdict(op,comp)_$$onfields(flds)_" from table "_table_" will not filter out any rows"_$s(ifn=ifnRowID:".",1:" from "_$$commas(hasCondInMapSubsIndexList,,,1)_".")
				CONTINUE:$i(warningMsg(warningMsg))>1  // Skip duplicate/redundant <warning> message!  The following is an example of a redundant condition: %CONTAINS (?,?,?) [This will be filed as 3 complex conditions.]
				do:addWarning nuln(warningMsg)
				set complexCondIndexList=complexCondIndexList_hasCondInMapSubsIndexList
				
			}
		}
	}
	RETURN complexCondIndexList
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
/// Check to see if the current parse tree 'val' (field) has an Index Map, specified by
/// the query block # 'm' and the stream # 'str', that can satisfy the condition from 
/// any of its subscripts.  If so, then return a $LIST(...) of all Index Maps that have
/// a condition-satisfying Map Subscript; Otherwise, return the empty-string ("")
///
hasCondInMapSubs(val,m,str) [asl,mt,mts] PUBLIC {
	
	RETURN:$$$mtVType($$$mtV(val))'="f" ""  // QUIT if 'val' is not a field!
	
	set ifn=$p($$$mtV(val),"^",3)  // The 'ifn' for the parse tree 'val' (field)!
	set fldIfn=+ifn
	
	set hasCondInMapSubsIndexList=""  // A $LIST(...) containing all Index Names from the tables used to process the SQL Query that has an Index Map subscript which satisfies the condition!
	set imp=""
	for { // --- Process All Index Maps 'imp' ---
		set imp=$o(mts(m,str,"MAP",imp))
		QUIT:imp=""  // No more 'imp' values!
		
		set sub=""
		for { // --- Process All Index Map Subscripts 'sub' ---
			set sub=$o(mts(m,str,"MAP",imp,sub))
			QUIT:sub=""  // No more 'sub' values!
			
			set subIfn=$p(mts(m,str,"MAP",imp,sub),"^",2)  // The 'ifn' for this Map Subscript!
			CONTINUE:subIfn'=fldIfn    // Skip this Map Subscript since its 'ifn' does not match that of the specified parse tree 'val' (field)!
			
			#; --- Found what we are looking for, since both the 'ifn' & 'collation' of this Map Subscript matches those of the specified parse tree 'val' (field) ---
			set hasCondInMapSubsIndexList=hasCondInMapSubsIndexList_$LB($$map(imp))
			QUIT  // A condition-satisfying Map Subscript has been found, so stop searching this Index Map!
		}
	}
	RETURN hasCondInMapSubsIndexList	
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
/// This method performs the following tasks in order to collects/returns a 
/// $LIST(...) of Indexes that satisfy these conditions.  In addition, if the 
/// 'addWarning' parameter is passed the value one (1), then this method
/// will also create a corresponding <warning> message entry in the '%plan(...)'
/// array, which annotates the processing plan for the SQL Query invocation:
/// 
///   - Searches through all of the Conditional Index Maps that are used to 
///     process a given SQL Query, whose index structure [mts(m,str,type)]
///     matches one of the specified 'type' values: { "CON" | "RANGE" }
///   - For each conditional index field 'ifn' that is found within this
///     structure [mts(m,str,type,ifn)], perform the following tasks:
///       - Search through all of the Index Maps that are defined for
///         the given 'm' and 'str' [mts(m,str,"MAP",imp)]
///       - For each subscript field that is used to define the Index
///         Map [mts(m,str,"MAP",imp,sub)], check to see if it matches
///         the field 'ifn' specified by Conditional Index Maps structure
///         [mts(m,str,type,ifn)] that is being searched from above
///       - If a conditional/subscript field match is found, check to 
///         see if it has a matching collation
///       - If the collation does not match, add this Index Map to the
///         'mismatchCondIndexList' $LIST(...), which is returned by
///         this method, and conditionally create a <warning> message 
///         entry in the '%plan(...)' array
///
checkCondVsIndexSubCollMismatch(m,str,type,addWarning = 1) [asl,mt,mts] PUBLIC {
	
	RETURN:'$d(mts(m,str,type)) ""  // This Index Map structure does not exist!
	
	set mismatchCondIndexList=""  // A $LIST(...) containing all Index Names from the tables used to process the SQL Query that has a subscript on the conditional field with a mismatching collation!
	
	set crSub=""  // Subscript value for either { c - "CON" | r - "RANGE" }
	for { // --- Process All 'type' Index Map Subscripts 'crSub' ---
		set crSub=$o(mts(m,str,type,crSub))
		QUIT:crSub=""  // No more 'crSub' values!
		
		set crIfn=+crSub,crColl=$p(crSub,"_",2)  // 'ifn'/'coll' values for either { c - "CON" | r - "RANGE" }
		set crIrn=$$$smdGetIrnFromIfn(crIfn)     // Table's 'irn' value!
		set:crColl=""&&crIrn crColl=$$ddifun^%qaqpagg(crIrn,crIfn)  // Set 'crSub' to default collation if unspecified!
		if $d($$$mtVirf(crIfn)) { // --- Process Virtual Field ---
			set:$LG($$$mtVirf(crIfn),2) realVal=$$thruRMLSP^%qaqpqo1($LG($$$mtVirf(crIfn),2))
			CONTINUE:$g(realVal)&&($e($$$mtV(realVal))'="f")
			set:$g(realVal) crIfn=$p($$$mtV(realVal),"^",3)
		}
		set irn=$$$smdGetIrnFromIfn(crIfn)
		CONTINUE:irn=""  // Skip empty 'irn' value!
		set datatype=$$$smdColDatatype(1,irn,crIfn)
		CONTINUE:(datatype'="%Library.String")  // Skip all non-string 'datatype' values!
		CONTINUE:crColl["%ANYOFKEY"  // Skip "%ANYOFKEY" since it's not a real collation!
		set:crColl["%ANYOF" crColl=""  // If 'crColl' contains "%ANYOF", 'crSub' has no collation so reset 'crColl' to the empty-string ("").
		
		// --- Loop on all the Index Maps/subscripts under 'mts(m,str,"MAP",...)' and check if there is a collation mismatch between the condition field and the Index Map subscript ---
		set imp=""
		for { // --- Process all Index Maps defined for the given Query Block # (m) and Stream # (str) ---
			set imp=$o(mts(m,str,"MAP",imp))
			QUIT:imp=""  // No more 'imp' values!
			CONTINUE:imp=$p(mts(m,str),"^",4)  // Skip the Master Map - no <warning> is needed!
			
			set sub=""
			for { // --- Process all subscripts for the given Index Map searching for those that matches the conditional field; once found ensure that their is no collation mismatch ---
				set sub=$o(mts(m,str,"MAP",imp,sub))
				QUIT:sub=""  // No more 'sub' values
				CONTINUE:$d(mt("smdimp",imp))  // Skip cloned collection property maps so that we don't show duplicate warnings!
				
				set subIfn=$p(mts(m,str,"MAP",imp,sub),"^",2)   // The 'ifn' for this Map Subscript! 
				CONTINUE:subIfn'=crIfn    // Skip this Map Subscript since its 'ifn' does not match that of the specified { c - "CON" | r - "RANGE" } conditional field!
				
				set subColl=$p($p(mts(m,str,"MAP",imp,sub),"^",6),"_",1)  // The 'collation' for this Map Subscript with '_%ANYOF*' removed (e.g. %SQLUPPER_%ANYOF => %SQLUPPER)
				CONTINUE:subColl["{"          // Skip collation containing "{" since it's not a real/valid collation!
				CONTINUE:subColl["%ANYOFKEY"  // Skip collation containing "%ANYOFKEY" since it's not a real/valid collation!
				set:$e(subColl,1,6)="%ANYOF" subColl=""  // This is not a valid collation, so ignore it!
				CONTINUE:subColl=crColl  // Skip this Map Subscript since its 'collation' matches that of the specified { c - "CON" | r - "RANGE" } conditional field!
				
				set mapName=$$map(imp)
				set mapNameNorm=$$$UPPER($e(mapName))_$e(mapName,2,*)  // Capitalize the first index name (word) in the <warning> message!
				set condType=$case(type,"CON":"equal","RANGE":"range",:"")
				if type="RANGE" {
					set:$p($p(mts(m,str,type,crSub),"^",3),$c(1),2)=2 condType="%STARTSWITH"
				}
				set crField=$$field(crIfn)
				set:crColl'="" crField=crColl_"("_crField_")"
				do:addWarning nuln(mapNameNorm_" cannot be used to satisfy the "_condType_" condition on "_crField_" because "_$s(subColl="":"there is no index subscript collation.",1:"the index subscript collation is "_subColl_"."))
				set mismatchCondIndexList=mismatchCondIndexList_$LB(mapName)
				QUIT  // A mismatch-condition on an Index Map subscript has been found, so QUIT searching the remaining subscripts!
			}
		}
	}
	RETURN mismatchCondIndexList
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
/// This method searches through all of the tables that are used to process a given
/// SQL Query and collects/returns a $LIST(...) of all Table Name/Index Map values 
/// if non-vectoriz{able|ed} conditions are present in the query despite the presence
/// of all the required columnar maps to process the condition.
/// 
/// In addition, if the 'addWarning' parameter is passed the value one (1), then this
/// method will also create a corresponding <warning> message entry in the '%plan(...)'
/// array, which annotates the processing plan for the SQL Query invocation...
///
nonVecCond(addWarning = 1) [asl,mt,mts] PUBLIC {
		
	set nonVecCondIndexList=""  // A $LIST(...) containing all Index Names from the tables used to process the SQL Query that has non-vectorizable conditions!
	
	set nonVecLogs=$$nonVecLogs()  // A $LIST(...) of 'log' values that are not vectorizable!
	
	set mod=""
	for { // --- Process All 'mod' Values within the 'asl(mod)' Array ---
		set mod=$o($$$aslMod(mod))
		QUIT:mod=""  // No more 'mod' values!
		
		#; non-vectorized conditions can appear in asl(mod,3,item,"cond")
		CONTINUE:'$d($$$aslPostkeyRoot(mod))  // Skip entries that don't have any Pos-Key Specifications!
		
		#; --- Search for Complex Conditions under 'asl(mod,3,item,"cond")' ---
		set item=""
		for { // --- Process All Post-Key Entries 'item' ---
			set item=$o($$$aslPk(mod,3,item))
			QUIT:item=""  // No more 'item' values!
			set logList=$LFS($g($$$aslPkConds(mod,3,item)))
			CONTINUE:logList=""  // Skip entries that don't have any Query Condition Specifications!
.
			for logPos=1:1:$LL(logList) { // --- Process All '$$$mtL(log)' Values ---
				set log=$LG(logList,logPos)
				CONTINUE:'log  // Skip empty 'log' value!
				
				set op=$$$mtLOperator($$$mtL(log)),flds=$$$mtLColVals($$$mtL(log))
				set hasColMaps=1,ifnNotRowID=0
				for valPos=2:1:$l(flds,",")-1 { // --- Process All '$$$mtV(val)' Values ---
					set val=$p(flds,",",valPos)
					CONTINUE:'val  // Skip empty 'val' value!
					
					set str=$p($$$mtV(val),"^",2)                            // Stream #
					set ifn=$p($$$mtV(val),"^",3)                            // 'ifn' for the parse tree 'val' (field)
					set m=$$$mtRQb($$$mtR(str))                              // Query # (module)
					set ifnRowID=$p(mts(m,str),"^",5)                        // 'ifn' of the RowID
					set:ifn'=ifnRowID ifnNotRowID=1                          // The 'ifn' is not the RowID
					set impCol=$p($g(mts(m,str,"ATT",ifn)),"^",9)            // 'imp' of Columnar Master Map
					set:impCol="" impCol=$p($g(mts(m,str,"ATT",+ifn)),"^",9) // 'imp' of Columnar Index Map
					set:impCol="" hasColMaps=0                               // The 'ifn' field is not in a Columnar Master/Index Map (or rowid)
				}
				if hasColMaps,ifnNotRowID { // --- Process Non-vectorized Condition ---
					set impColMap=$$map(impCol)
					set table=$$table(+$$$mtR(str))
					CONTINUE:(op="'NULL")&&$lf($g(mt("bmcon")),"L"_$g(mt("NotNullTolog",log))) ; Skip NOT NULL on a BMCON
					set warningMsg="Condition "_$$logdict(op,log)_$$onfields(flds)_" from table "_table_" is not "_"vectoriz"_$s($LF(nonVecLogs,log):"able",1:"ed")_"."
					CONTINUE:$i(warningMsg(warningMsg))>1  // Skip duplicate/redundant <warning> message!
					
					do:addWarning nuln(warningMsg)
					set nonVecCondIndexList=nonVecCondIndexList_$LB($LB(table,impColMap))
				}
			}
		}
	}
	RETURN nonVecCondIndexList
}
	
	#;-----
	
/// This method collects/returns a $LIST(...) of 'log' values from the SQL Parse Tree
/// for all conditions that are not vectorizable.  This method relies on the results
/// from the 'voptree^%qaqpag(...)' method invoked via a 'GOTO' command shown in the
/// code snipit below, to check whether or not a condition is vectorizable:
///
///    nonVecLogs+?
///       set call="voptree^%qaqpag"
///       do lvtree^%qaqpnl("l",log)
///
///    lvtree(type,val) QUIT:'val  n v,ev,lv s v=mt(type,val),ev=$e(v) GOTO @call
///
nonVecLogs() [asl,call,fldVal,idifn,log,m,mt,mts,str,vopok,voponly,vtop,vtree,xtop,xtree] PUBLIC {
	
	RETURN:$d(mts)<11 ""      // The 'mts(...)' array has no nodes!
	RETURN:$d($$$mtLRoot)<10 ""  // The 'mt("l",...)' array has no "l"ogical condition nodes!
	
	new call,fldVal,idifn,log,m,str,vopok,voponly,vtop,vtree,xtop,xtree
	
	set nonVecLogs=""  // A $LIST(...) of 'log' values that are not vectorizable!
	set voponly=1      // A flag to indicate that argument operations must be on vectors, and cannot have nested aggregates!
	set call="voptree^%qaqpag"  // Invoked via a 'GOTO' command within the 'lvtree(...)' method!
	
	set log=""
	for { // --- Process All 'log' Values ---
		set log=$o($$$mtL(log),1,logInfo)
		QUIT:log=""  // No more 'log' values!
		
		set valList=$$$mtLColVals($$$mtL(log))  // A LIST(,val#,) of val# in the query block that is not of "q" type!
		set fldValListProc=""              // A $LIST(...) of 'val#' already processed!
		for valPos=2:1:$l(valList,",")-1 { // --- Process All 'val' Values ---
			set fldVal=$p(valList,",",valPos)
			CONTINUE:fldVal=""                  // Skip unspecified 'fldVal'!
			CONTINUE:$LF(fldValListProc,fldVal) // Skip 'fldVal' already processed!
			CONTINUE:$$$mtVType($$$mtV(fldVal))'="f"    // Skip if not a 'f'ield type!
			
			set vopok=1,vtop="",vtree="",xtop="",xtree=""  // Prime vars!
			set str=$p($$$mtV(fldVal),"^",2)    // Stream #
			set m=$$$mtRQb($$$mtR(str))         // Query #/Module #
			set idifn=$p($g(mts(m,str)),"^",5)  // 'ifn' of the RowID
			do lvtree^%qaqpnl("l",log)
			set:'vopok nonVecLogs=nonVecLogs_$LB(log)  // Collect/Record this not vectorizable 'log'!
			set fldValListProc=fldValListProc_$LB(fldVal)
		}
	}
	RETURN nonVecLogs
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
/// This method checks whether the SQL Query processed via the Run Time Plan 
/// Choice (RTPC) optimization encountered an error during invocation and
/// returns the text of the SQL Query if and error was recorded.  Any RTPC
/// errors captured within the 'GetShowPlanRTPCSQL^%SYS.SQLSRV(...)' method 
/// and processed by the 'ShowPlan^%apiSQL(...)' method, are recorded in the 
/// following array node:
///    nRTP("warning")=<rtpc error>
/// The <rtpc error> is typically set to the following value:
///    "Error getting RTPC runtime query in ShowPlan."
/// 
/// In addition, if the 'addWarning' parameter is passed the value one (1), then this
/// method will also create a corresponding <warning> message entry in the '%plan(...)'
/// array, which annotates the processing plan for the SQL Query invocation...
///
checkRTPCError(addWarning = 1) [nRTP,SQLrtpcsql] PUBLIC {
	RETURN:$g(nRTP("warning"))="" ""
	
	do:addWarning nuln(nRTP("warning"))
	
	new SQLrtpcsql
	set SQLrtpcsql=""
	
 try { // --- Set the 'SQLrtpcsql' Variable which contains the Full SQL Statement with RTPC #OPTIONS ---
	set rtExprCode=""
	for ln=1:1:$g(nRTP("dispatch-code","rtexpr")) { // --- Process All of the Code from the "rtexpr" Nodes ---
		set rtExpr=nRTP("dispatch-code","rtexpr",ln)
		for pos=1:1:$l(rtExpr) { QUIT:$c(9,32)'[$e(rtExpr,pos)  }
		set rtExprCode=rtExprCode_"  "_$e(rtExpr,pos,*)
	}
	Xecute rtExprCode  // Execute the code in the "rtexpr" nodes!
	
	set sqlCode=""
	for ln=1:1:$g(nRTP("dispatch-code","sql")) { // --- Process All of the Code from the "sql" Nodes ---
		set sql=nRTP("dispatch-code","sql",ln)
		for pos=1:1:$l(sql) { QUIT:$c(9,32)'[$e(sql,pos)  }
		set sqlCode=sqlCode_" "_$e(sql,pos,*)
	}
	Xecute sqlCode  // Execute the code in the "sql" nodes which sets the 'SQLrtpcsql' variable!
 } catch { }
	
	RETURN SQLrtpcsql
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
/// This method checks to see if there are any alias ambiguities for a SQL Statement's
/// <group by clause>/<having clause> recorded in the SQL Parse Tree and collects/returns
/// a $LIST(...) of these details to be used for future processing.
/// 
/// In addition, if the 'addWarning' parameter is passed the value one (1), then this
/// method will also create a corresponding <warning> message entry in the '%plan(...)'
/// array, which annotates the processing plan for the SQL Query invocation...
///
aliasAmbiguity(addWarning=1) [mt] PUBLIC {
		
	set aliasAmbiguityList=""  // A $LIST(...) containing all alias ambiguity details!
	
	for id=1:1:$g($$$mtNumAmbiguousAliases) { // --- Process All Alias Ambiguities ---
		set aliasAmbiguityInfo=$g($$$mtAmbiguousAlias(id))
		CONTINUE:$LF(aliasAmbiguityList,aliasAmbiguityInfo)  // Skip duplicate/redundant alias ambiguities!
		
		set $LG(aliasName,fieldName,tableName,groupFlag,havingFlag)=aliasAmbiguityInfo
		
		do:addWarning nuln("The alias ("_aliasName_") used in the SQL Statement's "_$s(groupFlag&havingFlag:"<group by clause> & <having clause>",groupFlag:"<group by clause>",1:"<having clause>")_" conflicts with field ("_aliasName_") from the ("_tableName_") table. A table's <field> takes precedence over an <alias>.")
		set aliasAmbiguityList=aliasAmbiguityList_$LB(aliasAmbiguityInfo)
	}
	RETURN aliasAmbiguityList
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
/// This method checks to see if this SQL statement is affacted by any compatibility setting this customer set. 
/// In addition, if the 'addWarning' parameter is passed the value one (1), then this
/// method will also create a corresponding <warning> message entry in the '%plan(...)'
/// array, which annotates the processing plan for the SQL Query invocation...
CompatibilityCheck(addWarning=1) [mt] PUBLIC {
	RETURN:'$d(mt("compatibility"))
	if $g(mt("compatibility","PreUnionCollation")) { 
		do:addWarning nuln("The UNION collation is turned off.")
	}
	RETURN 
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
/// This method collects the list of condition that trigger a new behavior change due to IBA053.
/// 
/// In addition, if the 'addWarning' parameter is passed the value one (1), then this
/// method will also create a corresponding <warning> message entry in the '%plan(...)'
/// array, which annotates the processing plan for the SQL Query invocation...
/// 
dateToTimestampBehaviorChange(addWarning = 1) [mt] PUBLIC {
     
    set newBehaviorCondList=""  // A $LIST(...) containing all logs in mt("l") that caused a behavior change
    
    set log="",logInfo="",addedInstruction=0
    for { // --- Process conditions that trigger a behavior change due to IBA053 ---
        set log=$o(mt("IBA053",log),1,logInfo)
        QUIT:log=""
        
		set dateExpr=$lg(logInfo,1),tsExpr=$lg(logInfo,2),newBehaviorCondList=newBehaviorCondList_$LB(log)
		set warningLine="The DATE value for "_dateExpr_" will be appended with "" 00:00:00"" before comparing to the TIMESTAMP value for "_tsExpr_"."
		set:'addedInstruction warningLine=warningLine_" The result for this ANSI SQL standard output may differ from legacy IRIS SQL output. Use CAST to ensure same-datatype comparisons."_$s($$$PreventNewDateVsTimestampComparisons=1:" A system-wide flag is set to raise this as an error.",1:""),addedInstruction=1
        do:addWarning nuln(warningLine)
    }
    RETURN newBehaviorCondList
}
	 
subq(mmm) n mod,lmods,qn,colup,colmaps s lmods="",colup="",colmaps=""  ;  show plan for subquery mmm
	QUIT:'$$$mtPQbIsActive(mmm)  ;  skip merged subqueries
	QUIT:$$$mtPVirtStreamModule($$$mtP(mmm))  ;  virtual streams are integrated - skip!
	QUIT:$g($$$mtUnionTopQb(mmm),mmm)'=mmm  ;  UNION is integrated - skip!
	if mmm'=1 {
		if $g(forTest) { do nuln("<subquery>") }	// Backward-Compatible for Regression Testing
	    else { do nuln("<subquery name="""_$$name($$$mtPFirstASLModule($$$mtP(mmm)))_""" top="""_1_""">") set %pinfo("currSubQ")=mmm,%pinfo("subQ",mmm,"ind")=$g(ind) }	// 'mmm' Module Processed!
	}
	d mod($select($$$topWorkerModule(mmm)=$$$mtPFirstASLModule($$$mtP(mmm)):$$$topParentModule(mmm),1:$$$mtPFirstASLModule($$$mtP(mmm))),0,"")  ;  MAIN mod for this subquery
	f  q:lmods=""  s mod=$li(lmods) d mod(mod,1,"") s $li(lmods,1,1)=""
	d:$d(colmaps)=11 simplifycolumnar
	d:mmm'=1 nuln("</subquery>")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mod(mod,top,ind)  ;  show plan for module mod
	QUIT:$e(modun,mod)  s $e(modun,mod)=1  ;  process shared module only once
	Set qn = $select($d($$$mtAPERoot):$$findqn(mod),1:mmm)
	if $g(forTest) { do:top nuln("<module name="""_$$name(mod)_""">") }	// Backward-Compatible for Regression Testing
	elseif (top||verbose) { do nuln("<module name="""_$s(mod=$lg($$$mtMod1):"FIRST",1:$$name(mod))_""" top="""_$s(top:1,1:0)_""">") set %pinfo("currMod")=mod,%pinfo("mod",mod,"ind")=ind }	// 'mod' Module Processed!
	if showstats {
		set statsList=$$GetStats^%SYS.PTools(.sql,mod)
		do:$LV(statsList)&&(statsList'="") stats(statsList,ind_" ",verbose)
	}
	#; AK859
	if $$mpty(mod) {	// --- Whole subtree proven empty ---
		if '$g(forTest)&&(top||verbose) { set ind=$g(%pinfo("mod",mod,"ind")) do nuln("</module>") }
		RETURN
	}
	#; AK859-
	#; AK520
	#;  skip READ-COMMITTED stuff
	#; AK541
	i $d($$$asl5Root(mod)) k $$$aslPrekeyRoot(mod),$$$aslKRoot(mod) n item s item="" f  s item=$o($$$aslPk(mod,3,item)) q:item=""  q:$d($$$aslPkEndmodtagUncommitted(mod,3,item))  k $$$aslPk(mod,3,item)
	;  d nuln("[If in READ-COMMITTED mode, lock and verify the row in the master map.]")
	#; AK520-
	d pkey(mod,1),key(mod),pkey(mod,3),pad(mod),action(mod)  ;  process module mod
	if $g(forTest) { set:top ind="" do:top nuln("</module>") }	// Backward-Compatible for Regression Testing
	elseif (top||verbose) { set ind=$g(%pinfo("mod",mod,"ind")) do nuln("</module>") }
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK859
mpty(mod) [asl] PUBLIC {  ;  $$: 1 if mod or a nested module is marked "mpty",
	#;  and no more processing is needed (i.e. mod is in its train's nmod,
	#;  and not within AK676 "padtb"), maybe generating a "no rows" line
	#;  otherwise, if empty then just clear the module and propagate down
	#;  *** this whole logic should be moved to QP, e.g. end of ^agg
	i $g($$$asl0TopModForOjPadding(mod)) { d clear(mod) RETURN 0 }  ;  *** just kill 1,2,3
	s nmod=$g($$$asl0NestedMods(+$g($$$asl0TopNestingMod(mod)))),jj=$lf(nmod,mod)
	i 'jj { d clear(mod) RETURN 0 }
	s mpty=0
	f jj=jj:1:$ll(nmod) {
		s md=$li(nmod,jj)
		if md'="",$listvalid(md) { continue }
		i $g($$$asl0GenZeroRows(md)) { d clear(mod,1) s mpty=1 CONTINUE }
		i $g($$$asl0BtmModForOjPadding(md)) { s jj=$lf(nmod,$$$asl0BtmModForOjPadding(md)) CONTINUE }  ;  skip whole padded sequence
		s:$g($$$asl0TopModForOjPadding(md)) mpty=0  ;  exiting a sequence
	}
	RETURN:'mpty 0
	s mpty=$g($$$aslAct(md,1))
	d:$$$aslActAction(mpty)="o" actit(md,1,1)
	d:$$$aslActAction(mpty)="q" nuln("Subquery result NULL, found no rows.")
	RETURN 1  ;  no additional processing necessary
}
clear(mod,mpty=0) [asl] PUBLIC {  ;  if mod empty or mpty=1 passed in, then
	#;  clear mod except for ACTION, and if it's not the bottom "padtb" of
	#;  a sequence, and it nests another module x, then mark x as "empty",
	#;  and if x is the top of a sequence then cancel the sequence
	#;  *** logic should be moved to QP
	s:mpty $$$asl0GenZeroRows(mod)=1
	RETURN:'$g($$$asl0GenZeroRows(mod))
	KILL $$$aslPrekeyRoot(mod),$$$aslKRoot(mod),$$$aslPostkeyRoot(mod)
	RETURN:$g($$$asl0TopModForOjPadding(mod))
	s mod=$g($$$aslAct(mod,1))
	RETURN:$$$aslActAction(mod)'="n"
	set mod=$$$aslActNestingModOrIpqVars(mod)
	set $$$asl0GenZeroRows(mod)=1
	KILL:$g($$$asl0BtmModForOjPadding(mod)) $$$asl0TopModForOjPadding($$$asl0BtmModForOjPadding(mod)),$$$asl0BtmModForOjPadding(mod)
	RETURN
}
pad(mod) [asl] PUBLIC {  ;  indicate "jsv" module-based padding
	d:$g($$$asl0TopModForOjPadding(mod)) nuln("Generate a row padded with NULL"_$$padtabs(mod)_" if no row qualified.")
	RETURN
}
padtabs(mod) [mt,asl] PUBLIC {  ;  list of tables being padded
	s padf=$g($$$asl0PaddedFldsForOjPadding($$$asl0TopModForOjPadding(mod))),tabs="",view=0
	f jj=1:1:$l(padf,",")-1 s tab=$$table(+$$$mtR($p($$$mtV($p(padf,",",jj)),"^",2))) i tab="." { s view=1 } else { s:'$lf(tabs,tab) tabs=tabs_$lb(tab) }
	s tab=$case($ll(tabs),0:"",1:"table ",:"tables ") s:view tabs=tabs_$lb("the view")
	RETURN:tabs="" ""
	RETURN " for "_tab_$$commas(tabs,,,1)
}
	#; AK859-
pkey(mod,funk) n item,vops,vopstxt,vopline,chunks,cht,chunkline s item="",vops="",vopstxt="",vopline="",chunks="",cht="",chunkline=""  ;  process PREKEY/POSTKEY
	n info f  s item=$o($$$aslPk(mod,funk,item)) d:$d($$$asl0QueryStats(mod,funk,+item),info) nuln("ENT="_info):$g(%ent) q:item=""  d pkit(mod,funk,item)  ;  ent
	QUIT
pkit(mod,funk,item) n info,alias  ;  process PREKEY/POSTKEY item
	#;  (probably not needed for now) these generate no plan here
	#;  RETURN:$d(asl(mod,funk,item,"wfempty"))
	#;  RETURN:$d(asl(mod,funk,item,"cachedchunk"))
	#;  RETURN:$d(asl(mod,funk,item,"copy"))
	#;  RETURN:$d(asl(mod,funk,item,"init"))
	#;  RETURN:$d(asl(mod,funk,item,"compare"))
	#;  RETURN:$d(asl(mod,funk,item,"unary"))
	#;  RETURN:$d(asl(mod,funk,item,"endmodtag"))
	#;  RETURN:$d(asl(mod,funk,item,"verify"))
	#;  RETURN:$d(asl(mod,funk,item,"assign"))
	s info=$g($$$aslPkId(mod,funk,item))
	s alias=$$alias($$$aslIdQb(info),$$$aslIdStrNum(info))
	#; AK671
	QUIT:$$hash($$$aslIdTfBuildLoc(info))
	i ($$$aslIdTfType(info)="bmvar")||($$$aslIdTfType(info)="vecvar") { d chunks(info) RETURN }
	QUIT:$$$aslIdTfType(info)="convar"
	d:info'="" read(info)
	i $$$aslIdMapId(info) d apln(" using the given idkey value"),outer(info) QUIT
	i $$$aslIdTfBuildLoc(info) d apln(" using the given subscript values.") QUIT
	s info=$g($$$aslPkCallAnotherMod(mod,funk,item))  ;  call a module
	#; AK793
	#;  ignore %VID module from counter^%qaqpmod  ;  *** maybe add view name
	n vid s vid=$g($$$mtV(+$p($g($$$aslAct(+info,1)),"a"_$c(1,1),2)))  ; later
	i $lg($g($$$mtVirf(+$p(vid,"^",3))))=0 d nuln("Increment view row counter.") QUIT
	#; AK793-
	i +info {
		d nuln("Call module "_$$name(+info)_$s($p(info,$c(1),2):" once",1:"")),admod(+info),findtf(+info),apln(".")
		n duntf,li,tf,qmlp,lj s duntf=$g($$$asl0TfsWhereThisModIsTop(+info))  ;  AK1015;AK1019
		f li=1:1:$ll(duntf) {
			s tf=$$$mtTempFile($li(duntf,li)),qmlp=$p(tf,"^",15)
			if $$$parAggUsesSharedGlobal(qn) {
				// Update the shared global if used in parallel aggregation (EEE015)
				d nuln("Update the accumulated rows in "_$$mttf(,,,$$$getParAggSharedTf(qn))_" using "_$$tfn($p(tf,"^",2),$p(tf,"^",$s($p(tf,"^")="dist":3,1:4)),$p(tf,"^")="dist")_".")
			}
			f lj=1:1:$l(qmlp,",")-1 {
				i $p(qmlp,",",lj)<0 { d nuln("Apply timeseries model "_$p(mt("tsml",-$p(qmlp,",",lj)),"^")_" predictions, adding rows to "_$$tfn($p(tf,"^",2),$p(tf,"^",4))_".") CONTINUE }
				d nuln("Apply model "_$e($$$mtV($p($$$mtV($p(qmlp,",",lj)),"^",4)),3,*)_" predictions to all rows in "_$$tfn($p(tf,"^",2),$p(tf,"^",4))_".")
			}
		}
		RETURN
	}
	i $p(info,$c(1),4) { ; evaluate expression
		n li,val,found
		s info=$p(info,$c(1),4)
		f li=1:1:$l(info,",")-1 {
			s val=$p(info,",",li),found=$$listree^%qaqpagg("v",val,"q")
			CONTINUE:'found
			i $$$mtVType($$$mtV(val))="q" { d nuln("Evaluate scalar "_$$subqlist(found)_$$onfields($p($$$mtV(val),"^",3))_".") CONTINUE }
			d nuln("Evaluate "_$$exprname($$$mtV(val))_$$onfields($p($$$mtV(val),"^",3))_", calling "_$$subqlist(found)_".")
		}
		RETURN
	}	
	#; AK671
	i $d($$$aslPkDist(mod,funk,item)) d dist($$$aslPkDist(mod,funk,item)),indent("For each distinct row:")
	#; AK849
	// Use execution order for ASL conditions if ShowPlanASLCondsExecOrder is enabled
	d:$d($$$aslPkConds(mod,funk,item)) cond($s(($$$ShowPlanASLCondsExecOrder=1)&&$d($$$aslPkCondsExecOrder(mod,funk,item)):$$$aslPkCondsExecOrder(mod,funk,item),1:$$$aslPkConds(mod,funk,item)))
	d:$d($$$aslPkQueueQuery(mod,funk,item)) quq($$$aslPkQueueQuery(mod,funk,item))
	n objAsl set objAsl = $$$oXasl
	d:$d($$$aslPkBmChunk(mod,funk,item)) bmch(objAsl.Mod(mod).Pk(funk,item).BitChunk())
	d:$d($$$aslPkBmFilt(mod,funk,item)) filter(objAsl.Mod(mod).Pk(funk,item).Filter())
	d:$d($$$aslPkBslTopFilt(mod,funk,item)) bstopfilt($$$aslPkBslTopFilt(mod,funk,item))
	d:$d($$$aslPkBslRangeFilt(mod,funk,item)) bsrangefilt($$$aslPkBslRangeFilt(mod,funk,item))
	d:$d($$$aslPkVecOp(mod,funk,item)) vop($$$aslPkVecOp(mod,funk,item))
	d:$d($$$aslPkBundledVecOps(mod,funk,item)) bundledVop($$$aslPkBundledVecOps(mod,funk,item))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
vop(vop)  ;  accumulate vops and output  (possibly rewrite)  ;  AK1047
	n op s op=$lg(vop,2)
	i vopline=%plan { s %plan=%plan-1 }  ;  regenerate last line  ;  AK1080
	else { s vops="",vopstxt="" }
	s vops=vops_$lb(op),vopstxt=vopstxt_$lb($$voptxt(vop))
	i ",sumg,countg,ming,maxg,anyg,groupg,countgb,"[(","_op_","){
		d nuln("Apply vector operation"_$$commas(vopstxt,,1)_" to populate "_$$mttf($li(vop,5),0)_", subscripted by "_$$val($li(vop,3))_$s(op="groupg":"",1:" with node data of "_$s(op="countgb":"COUNT(rows)",1:$tr($e(op,1,*-1),"suminaxcoty","SUMINAXCOTY")_"("_$$val($li(vop,4))_")"))_".")
		s vops="",vopstxt="",vopline=""
		RETURN
	}
	d nuln("Apply vector"_$s($lf(vops,"&")||$lf(vops,"&~")||$lf(vops,"|"):" and bitmap",1:"")_" operation"_$$commas(vopstxt,,1)_$s($$filtop(op):" to produce a filter",1:"")_".")
	s vopline=%plan  ;  remember this line - it might need to be replaced
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
/// This method is for the plan generation when the LCCA optimization is triggered, bundling aggregations in the same loop for the LCCA (Low Cardinality Columnar Aggregation) optimization.  ;  YLM001
///
/// The format difference between this and Vop is minimal, from "sumg"/"countg"/"maxg"/"ming" to "sum"/"count"/"max"/"min". The rest of the plan format doesn't change.
/// The way of achieving this is to stripping the trailing "g" if that aggregation is optimized into the same loop in the LCCA optimization.
///
/// PARAMETERS:
///   stuff      - This parameter value is passed from the 'mt("LCCAInputs",m)' array node,
///                which was built during the invocation of the 'vagg^%qaqpag(...)' and the 
///                'LCCAFinalAgg^%qaqpag(...)' methods, and has the following format:
///                    $LB({$LB(,"{sumg | countg | maxg | ming}",groupingNum,keysNum,resultNum,bmeNum)}*n, 
///                        {$LB(,"countgb",groupingNum,keysNum,resultNum)}*n,
///                        {$LB(,"keys",resultNum)}*(0/1),
///                        {$LB(,"outlierVal",outlierValue)}*(0/1),
///                        {$LB(,"cc",cc)}*1,
///                        {$LB(,"wf",wf)}*1)
///                  WHERE *n ::= $LB(...) >=1 instances
///                        *(0/1) ::= $LB(...) { 0 } 1 } instances
///
///                  NOTE: Each entry in the 'stuff' parameter is in the same format as the 'stuff'
///                        parameter of the 'vop(...)' method above, which is a $LIST(...) containing
///                        the following pieces of information:
///                        
///                          1.  empty               - Same as the input for the 'vop(...)' method above
///                          2.  label               - { "sumg" | "countg" | "maxg" | "countgb" | "keys" | "outlierVal" | "cc" | "wf" }
///                          3.* groupingNum/cc/wf   - If label={ "countgb" | "keys" | "outlierVal" }, then there won't be a piece 3 entry; if label={ "cc" | "wf" }, this would be the 'cc' or 'wf' value.
///                          4.* keysNum             - If label={ "keys" | "outlierVal" | "cc" | "wf" }, then there won't be a piece 4 entry
///                          5.* resultNum           - If label={ "keys" | "outlierVal" | "cc" | "wf" }, then there won't be a piece 5 entry
///                          6.* bmeNum              - If label={ "keys" | "outlierVal" | "cc" | "wf" }, then there won't be a piece 6 entry
///                  Example: stuff=$LB($LB(,"sumg",15,16,17,12),$lb(,"countg",15,16,18,12),$lb(,"maxg",15,19,20,12),$lb(,"ming",15,19,21,12),$lb(,"countgb",17,19,37),$lb(,"keys",21),$lb(,"outlierVal","MA"),$lb(,"cc",6),$lb(,"wf",12))
///
/// RETURN VALUE: None
///
bundledVop(stuff) [vops,vopline,%plan,vopstxt] public {
	set hybrid=0 // flag of if it's the hybrid LCCA or just purely LCCA
	for stuffPos=1:1:$ll(stuff) { // see if it's the hybrid LCCA or just purely LCCA, needed since order of "stuff" is not guranteed.
		if $li($li(stuff,stuffPos),2) ="outlierVal" {
			set hybrid=1
			QUIT
		}
	}
	for stuffPos=1:1:$ll(stuff) {
		set vop=$LG(stuff,stuffPos)
		set op=$LG(vop,2)
		set agg=0
		if (op="cc") || (op="outlierVal") {
			CONTINUE
		} elseif op="wf" {
			set bmeName=$li(vop,3)
			CONTINUE
		} elseif op="countgb" { // not included inside the LCCA
			set:'$d(groupingName) groupingName=$li(vop,3)
		} elseif (op="sumg") || (op="countg") || (op="maxg") || (op="ming") {
			set:'$d(groupingName) groupingName=$li(vop,3)
			set op=$e(op, 1, *-1) // get rid of the trailing "g"
			set $li(vop,2)=op
			set agg=1
		} else { // if op="keys", it's the same as "groupg" when LCCA optimization turned off.
			set op="groupg"
			set vop=$lb(,"groupg",groupingName,bmeName,$li(vop,3))
		}
		if vopline=%plan { set %plan=%plan-1 }  ;  regenerate last line  ;  AK1080
		else { set vops="",vopstxt="" }
		set vops=vops_$lb(op),vopstxt=vopstxt_$lb($s((agg&hybrid):op_"/"_op_"g",1:$$voptxt(vop))) // if hybrid, use "sum/sumg" or "max/maxg" or "count/countg" or "min/ming" in the plan.
		do nuln("Apply vector operation"_$$commas(vopstxt,,1)_" to populate "_$$mttf($li(vop,5),0)_", subscripted by "_$$val($li(vop,3))_$s(op="groupg":"",1:" with node data of "_$s(op="countgb":"COUNT(rows)",1:$tr(op,"suminaxcoty","SUMINAXCOTY")_"("_$$val($li(vop,4))_")"))_".") // same format as vop but without the trailing 'g'.
		set vops="",vopstxt="",vopline=""
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
}
voptxt(vop="") [mt] PUBLIC { ; a verbose description of vop/bitmap operation
	s op=$lg(vop,2)
	if ",&,|,&~,"[(","_op_","){
		s log=$p($$$mtV($li(vop,4)),"i^^i^bmlog",2)
		RETURN:log'=+log op ; AK1078
		RETURN op_" with "_$$condname(log)_$$onfields($$$mtLColVals($$$mtL(log)))
	}
	RETURN:op="defined" "defined on "_$$val($li(vop,3))
	RETURN:op="convert" "convert to "_$li(vop,4)
	RETURN:$e(op,1,5)="ONEOF" "ONEOF"  ; AK1075
	RETURN op
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
chunks(info)  ;  accumulate chunks and output (possibly rewrite)  ;  AK1047
	i chunkline=%plan { s %plan=%plan-1 }  ;  regenerate last line  ;  AK1080
	else { s chunks="",cht="" }
	s cht=cht_$e($p(info,$c(1),15)),info=$$$mtV(+$p(info,$c(1),3)),chunks=chunks_$lb($s($e(cht,*)="v":$$val($$findVal(info)),1:"bitmap of "_$$condname($p(info,"bmlog",2))))
	n size s size=$ll(chunks)
	s cht=$e(cht)_$e($tr(cht,$e(cht)))  ;  v/b/vb/bv
	#;  Read the Salary/"+" expression/'OR' condition value from the vector chunk.
	#;  Read the values for Salary, '+' expression, Bonus, and 'SUBSTRING' expression from the vector/[ and] bitmap chunks.
	d nuln("Read the "_$$commas(chunks,,,1)_" value"_$e("s",size>1)_" from the "_$case(cht,"v":"vector","b":"bitmap","vb":"vector and bitmap",:"bitmap and vector")_" chunk"_$e("s",size>1)_".")
	s chunkline=%plan  ;  remember this line - it might need to be replaced
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
findVal(info) PUBLIC { ; extracts val from "i^^i^vec*********val" info
	RETURN:$e(info,1,8)'="i^^i^vec" ""
	set info =$p(info,"i^^i^vec",2)
	set cntCol=0
	for {
		 QUIT:$isvalidnum(info)
		 QUIT:cntCol>10 // safeguard to prevent infinite loop
		 set info=$e(info,4,*),cntCol=cntCol+1
	}
	RETURN info
.
}
filtop(op)  ;  $VOP() that generates a bitmap filter  ;  AK1047
	#;  columnar index
	RETURN " & &~ | defined undefined = != > >= < <= between v= v!= v> v>= v< v<= vbetween log2bm "[(" "_op_" ")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
subqlist(list)  ;  $$: "subquery <name>"/"subqueries list(<name>)" for given list=LIST(val,) of "q" nodes
	n li,res
	f li=1:1:$l(list,",")-1 s $li(res,li)=$$name($$$mtPFirstASLModule($$$mtP($p($$$mtV($p(list,",",li)),"^",2))))
	RETURN $s($l(list,",")=2:"subquery ",1:"subqueries ")_$$commas(res)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
onfields(list)  ;  $$: "on list(<fname>)" for given list=LIST(,fval,) of "f" nodes
	RETURN:(list=",")||(list="") ""
	n lj,val,lflds s lflds=""
	f lj=2:1:$l(list,",")-1{
		s val=$p(list,",",lj),val=$$val(val)
		if '($lf(lflds,val)) s lflds=lflds_$lb(val)}
	RETURN " on "_$$commas(lflds,,,1)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
boldifyANSI(str) // returns string in bold format
{
	RETURN $CHAR(27)_"[1m"_str_$CHAR(27)_"[0m"
}
cond(lcond) ; lcond=LIST(log,) process "cond" pkeys: show the condition operation, i.e. ">", "NOT NULL", "%STARTSWITH" etc, the used field values and the subqueries 
	new condarg,cqName,flds,found,lflds,li,log,logop,logtxt,name,onecond,op,qbnames,rowsAfter,rowsBefore,SQLRuntimeStatsRowcounts,statsPID
	set logtxt=""
	for li=1:1:$l(lcond,","){
		set log=$p(lcond,",",li)
		continue:(log="")
		set qbnames="",lflds=""
		set op=$$$mtLOperator($$$mtL(log))
		set logop=$$logdict(op,log)
		set found=$$listree^%qaqpagg("l",log,"q")
		set flds=$$$mtLColVals($$$mtL(log))
		set:($l(found)) qbnames=$$subqlist(found)
		set:($l(flds)) lflds=$$onfields(flds)
		set condarg=$s($l(lflds):lflds_$s($l(qbnames):", and calling "_qbnames,1:""),1:$s($l(qbnames):" calling "_qbnames,1:""))
		if $l(condarg)>2 {
			set onecond="the "_logop_" condition"_condarg
			// Add runtime stats for this condition if enabled
			set SQLRuntimeStatsRowcounts = ""
			if $g($$$mtOptionsSQLRuntimeStatsFlag)=1 {
			    set cqName=$o($$$SQLIndex(2,..Statement.%RTPCRuntimeCQName_".1",""))
			    set statsPID=$g($$$mtOptionsSQLRuntimeStatsPID)
			    set rowsBefore=$g($$$SQLRuntimeStatsNode(statsPID,cqName,"conditions",log,"rowsBefore"),0)
			    set rowsAfter=$g($$$SQLRuntimeStatsNode(statsPID,cqName,"conditions",log,"rowsAfter"),0)
			    // Only display stats if collection code ran at least once.
			    // If both are 0, either the condition was never reached or stats collection wasn't generated for this condition type.
				// Either case, it is okay to display nothing for this condition.
			    if rowsBefore || rowsAfter {
			        set SQLRuntimeStatsRowcounts=$$boldifyANSI(" ("_rowsBefore_" -> "_rowsAfter_" rows)")
			    }
			}
			set logtxt=logtxt_$lb(onecond_SQLRuntimeStatsRowcounts)
		}
	}
	do:($ll(logtxt)) nuln("Test "_$$commas(logtxt,,,$s($$$ShowPlanASLCondsExecOrder=1:0,1:1))_".")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
subCond(lcond) [mt] PUBLIC { ; return $list of condition on the subscript, with or without subquery calls.
	RETURN:lcond="" ""
	set logSubqTxt="",logTxt=""
	for li=1:1:$l(lcond,","){
		set log=$p(lcond,",",li)
		CONTINUE:log=""
		set logName=$$condname(log),found=$$listree^%qaqpagg("l",log,"q")
		CONTINUE:logName["NOT NULL" ; NOT NULL usually comes from null analysis
		set logTxt=logTxt_$lb(logName_$s($l(found):" calling "_$$subqlist(found),1:""))
	}
	RETURN $$commas(logTxt,,,,1) ; order the list before it is returned
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK849
quq(info)  ;  for info=qn^untop, queue query qn, return results in temp-file
	#; AK902
	new grps,join,lgrps
	if +info=0 QUIT  ; Dummy entry at end of quq set
	Set grps=$g(mt("cosh",+info)),lgrps=$ll(grps),join=""
	If lgrps{ ; describe join if there is one: cosharded vs cross-sharded
		Set join=", with a cross-sharded join of ",alltabs=""
		For i=1:1:lgrps{
			Set grp=$li(grps,i),grpsize=$ll(grp),tabs="",pos=0
			If lgrps=1{
				If grpsize>1{ Set join=", with a cosharded join of tables "
				}Else{ Set join="" CONTINUE}
			}
			For j=1:1:grpsize Set strinfo=$g($$$mtR($li(grp,j))),tabs=tabs_$lb($$table($p(strinfo,"^")))
			If grpsize=1,lgrps>1{
				For k=i+1:1:lgrps{
					If $ll($li(grps,k))=1{ Set strinfo=$g($$$mtR($li($li(grps,k),1))),tabs=tabs_$lb($$table($p(strinfo,"^"))),pos=k
					}Else { QUIT}
				}
				Set:(pos) i=pos
			}
			Set grpdes=$s(lgrps=1:$$commas(tabs),(grpsize=1)&&'pos:"sharded table "_$li(tabs,1),(grpsize=1)&&pos:"sharded tables "_$$commas(tabs),1:"cosharded tables "_$$commas(tabs)),alltabs=alltabs_$lb(grpdes)
		}
		Set join=join_$$commas(alltabs,1)
	}
	d nuln($s($g($$$mtShard(+info))="":"Send query to a separate process",1:"Distribute query to shard servers")_join_", piping results to "_$$tfn(mod+1,-1)_":")  ;  AK859
	if $d(parallelquery) { set parallelquery($i(parallelquery))=$$$mtSql(+info) }  // HSU275
	d nuln("    "_$$$mtSql(+info))  ;  generated query
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK849-
bmch(bc) {
	#dim bc As %SQL.Engine.Objects.AslPkBitChunk
	Set act = "Read a chunk from "
	Set tempfile = bc.TempFile()
	If tempfile {
		Set src = $$tfn(tempfile.Mod().Index, tempfile.BuildAction().Index)
	}
	Else {
		Set src = $$map(bc.Map())
	}
	d nuln(act _ src)
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
filter(filter) {
	#dim filter As %SQL.Engine.Objects.AslPkFilter
	Set op = "AND"
	If filter.Invert() {
		Set op = op _" NOT"
	}
	Do apln(" and perform a bitwise " _ op _ " operation.") 
}
bstopfilt(info) {
	Do nuln("Select top rows from " _ $$map($li(info,4)) _ ".")
}
bsrangefilt(info) {
	Do nuln("Limit the range of rows in temp-file " _ $$name($li(info,1)) _ " using " _ $$map($li(info,3)) _ ".")
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK671
dist(info)  ;  $$: expression for BSL item asl(mod,2,item)
	n vals s vals=$p(info,$c(1))
	d nuln("Check distinct values for "_$$clist(vals)_$s($p(info,$c(1),4):" of some rows",1:"")_" using ")  ;  AK649
	s info=$p(info,$c(1),2)  ;  see if also used for data/aggregates
	i info,$d($$$mtTfAslNode(info,2)) {
		d apln($s($$$mtTfBitmapFlag($$$mtTempFile(info)):"bitmap ",1:"")_"temp-file "_$$name(info)_","),nuln($s($p($$$mtTfHashSubscripts($$$mtTempFile(info)),",",2)="":"    subscripted by ",1:"    subscripted by a hash of the ")_$s('$p(vals,",",2):$$clist(vals,,,1)_".",1:"values."))
		do writeTfSQLRuntimeStats(info,2,,1)
		QUIT
	}
	d apln("a "_$s(info&&$$$mtTfBitmapFlag($$$mtTempFile(info)):"bitmap ",1:"")_"temp-file.")
	do writeTfSQLRuntimeStats(info,1,,1)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
hash(modit)  ;  $$: 1 if modit=mod^item is a hashed DISTINCT temp-file
	RETURN:'$p(modit,"^",2) 0
	QUIT:'modit 0
	QUIT ''$$$mtTfHashSubscripts($g($$$mtTempFile(+$$$aslActTfToBuild($$$aslAct(+modit,$p(modit,"^",2))))))
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK671-
findtf(bmod) [temptables,mt,ind] { ;  identify temp-file being generated in bmod
	if $data(temptables(bmod)) {
		set table="",names=""
		for {
			set table=$order(temptables(bmod,table)) QUIT:table=""
			set tf=$$$mtTempFile(table)
			if $p(tf,"^")="dist",$p(tf,"^",3)="" {
				#; Frozen plan on older version case, we may be able to just call $$name(table) for all cases
				set names=names_$$name(table)_", "
			} else {
				set names=names_$$tfn($p(tf,"^",2),$p(tf,"^",$s($p(tf,"^")="dist":3,1:4)),$p(tf,"^")="dist")_", "
			}
		}
		do apln(", which populates "_$e(names,1,*-2))
		set table="",names=""
		for {
			set table=$order(temptables(bmod,table)) QUIT:table=""
			do writeTfSQLRuntimeStats(table,1,1,)
		}
	}
}
/// Prints runtime statistics for a temp-file if available
/// Parameters:
///   tf              - Temp-file number
///   indentTabCount  - Number of 4-space indents to add (default 2)
///   startPeriod     - If 1, prepend a period before the stats text
///   endPeriod       - If 1, append a period after the stats text
writeTfSQLRuntimeStats(tf,indentTabCount=2,startPeriod=0,endPeriod=0) [ind,mt] {
	// Check if runtime stats are enabled and data exists
	RETURN:(($g($$$mtOptionsSQLRuntimeStatsFlag)'=1) || ('$d($$$SQLRuntimeStatsNode($g($$$mtOptionsSQLRuntimeStatsPID),$o($$$SQLIndex(2,..Statement.%RTPCRuntimeCQName_".1","")),"tf",tf))))
	// Add indentation (4 spaces per indent level)
	set indentStr = ""
	for i=1:1:indentTabCount {
		set indentStr = indentStr_"    "
	}
	set ind = ind_indentStr
	// Get statistics
	set $lb(rowCount,totalBytes) = $$$SQLRuntimeStatsNode($g($$$mtOptionsSQLRuntimeStatsPID),$o($$$SQLIndex(2,..Statement.%RTPCRuntimeCQName_".1","")),"tf",tf,"rowCountAndBytesFinal")
	set allocatedSize = $$$SQLRuntimeStatsNode($g($$$mtOptionsSQLRuntimeStatsPID),$o($$$SQLIndex(2,..Statement.%RTPCRuntimeCQName_".1","")),"tf",tf,"sizeFinal")
	// Print statistics
	do apln($s(startPeriod=1:".",1:"")_$$boldifyANSI(" (Runtime statistics for temp-file "_$$name(tf)_": "_rowCount_" rows | "_totalBytes_" bytes for keys + values | "_allocatedSize_" bytes for allocated storage)"_$s(endPeriod=1:".",1:"")))
	// Remove indentation (4 spaces * indentTabCount)
	set ind = $e(ind,1,*-(indentTabCount*4))
}
poptf(mod,item)  ;  temp-file being generated in bmod
	d apln(", which populates "_$$tfn(mod,item))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
key(mod)  ;  process KEY
	#; AK541
	GOTO:$g($$$aslKRoot(mod))="bsl" bsl
	#; AK731
	GOTO:$g($$$aslKRoot(mod))="dsn" dsn
	QUIT:'$d($$$aslK(mod,1))
	n info,llup,lgiv,ns,nin,parq,llook,alias s llup="",lgiv="",ns=0,llook=""  ;  subscript details
	s info=$g($$$aslKId(mod,1))
	s alias=$$alias($$$aslIdQb(info),$$$aslIdStrNum(info))
	s parq = $g($$$aslKParQueriesInfo(mod,2,1))
	if parq,$d(parallelquery),'$$$useAPE(qn) { set parallelquery($i(parallelquery))=$$getparallelquery(parq) }  // HSU275 [Used for ShowPlan^%apiSQL]
	i parq d parq(mod, info, parq) QUIT
	#; AK541
	i $$$aslIdKeyAccessType(info)="set" d nuln("Loop on a given set of values for "_$$val(+$$$aslKNext(mod,1,1))_"."),indent("For each value:") QUIT
	i $$$aslIdKeyAccessType(info)="ntimes" d nuln("Loop a given number of times."),indent("For each iteration:") QUIT
	QUIT:$$$aslIdKeyAccessType(info)="single"
	#; AK541-
	i $$$aslIdTfType(info)="bmvar" { d nuln("Loop on the position within the "_$s($$$mtV(+$p(info,$c(1),3))["wf":"filter",1:"extent")_" bitmap chunk."),indent("For each row:") RETURN }
	d read(info)  ;  get data from a global
	i info["vectorjoin" {  ;  vector join vj.Probe(), vj.Join  ;  AK1064
		n binfo s binfo=$$$aslAct(+$$$aslIdTfBuildLoc(info),$p($$$aslIdTfBuildLoc(info),"^",2))
		d apln(" using the given vector"_$$clist($$jkeys^%qaqpmod(+$$$aslActLeftTableKeysVec(binfo)),,1)_", and looping on the"_$CASE($$$aslActVecJoin(binfo),"vj1":" outer","vj2":" full outer",:"")_" join result vector chunks.")
		d indent("For each vector chunk:")
		RETURN
	}
	f  s ns=$o($$$aslKNext(mod,1,ns),1,nin) q:ns=""  d next
	i lgiv'="" d apln(" using the given "_$$commas(lgiv)) d:llup'=""||(llup=""&&(llook'="")) apln(", and")
	i llup'="" {d apln(" looping on "_$$commas(llup)) d:llook'="" apln(", and")}
	d:(llook'="") apln(" getting "_$$commas(llook,,,1))
	d outer(info)
	if llup'="" {d indent("For each " _ $$ldesc(llup) _ ":")}
	if $g(colup){
		n lline 
		s lline=$p(%plan(%plan),"Read columnar index ",2)
		s lline=$p(lline,", using the given chunk number.")
		s:$l(lline) colmaps(%plan)=lline_$c(1)_ind
	}
	QUIT
ldesc(llup) {
	Q:$lf(llup,"bitmap chunks") "bitmap chunk"
	Q:$lf(llup,"the subrange of bitmap chunks") "bitmap chunk"
	Q:$lf(llup,"vector chunks") "vector chunk"
	Q:$lf(llup,"bitslice chunks") "bitslice chunk"
	Q:$lf(llup,"bitslice power") "bitslice power"
	Q "row"
}
parq(mod, id, parq) [ mt ] {
	set m=$$$aslKParQueriesSubq(parq)
	set imp=$$$aslIdMapId(id)
	set set = $g(mt("sql",m,"set"))
	i $$$useAPE(m) {
		i imp{
			s chunktype=$case($$mapType^%qaqpagg(imp),$$$EXTENTBITMAP:"bitmap chunks",$$$COLUMNARDATA:"vector chunks",$$$COLUMNARINDEX:"vector chunks",$$$MASTERMAP:"IDs",:"subscript values")
			d nuln("Divide "_$$map(imp)_" into subranges of "_chunktype_".")
		}
		set topworkermod = $$$topWorkerModule(m)
		if $$$parAggUsesSharedGlobal(m) {
			// Indicate populating the shared global if used in parallel aggregation (EEE015)
			d nuln("Call module "_$$name(topworkermod)_" in parallel on each "_$s(set:"value in the given set",1:"subrange")_", which populates "_$$mttf(,,,$$$getParAggSharedTf(m))_".")
		} else {
			d nuln("Call module "_$$name(topworkermod)_" in parallel on each "_$s(set:"value in the given set",1:"subrange")_", piping results into "_$$tfn(mod+1,-1)_".")
		}
		// call the top worker module
		d admod(topworkermod)
		Return
	} else {
		#; AK859
		d nuln("Process query in parallel, partitioning "_$s(imp:$$map(imp),1:"the set")_" into")
		d nuln("    "_$s(set:"subsets",1:"subranges")_" of "_$$$mtSqlPartitionFunc(m)_" values, piping results to "_$$tfn(mod+1,-1)_":")
		#; Pre-TRW1511, $$$mtSql(m) included SELECT...FROM...WHERE.
		d nuln("    "_$g($$$mtSql(m))_$g($$$mtSqlSelect(m))_$g($$$mtSqlFrom(m))_$g($$$mtSqlWhere(m))_$s(set:" "_$$$mtSqlPartitionFunc(m)_" = [given value]",1:"")_$g($$$mtSqlGroup(m))_$g($$$mtSqlOrd(m)))
		Return
		#; AK859-
	}
}
.
getparallelquery(parq)[mt] PUBLIC {  // HSU275
	set m=$$$aslKParQueriesSubq(parq)
	set set=$g(mt("sql",m,"set"))
	RETURN $g($$$mtSql(m))_$g($$$mtSqlSelect(m))_$g($$$mtSqlFrom(m))_$g($$$mtSqlWhere(m))_$s(set:" "_$$$mtSqlPartitionFunc(m)_" = ?",1:" %PARTITION BY "_$$$mtSqlPartitionFunc(m)_" > ? AND "_$$$mtSqlPartitionFunc(m)_" <= ?")_$g($$$mtSqlGroup(m))_$g($$$mtSqlOrd(m))_" /*#OPTIONS {""parallelQuery"":""1""} */"
}
multiline(stubsql) {
	Set currpos=1
	While currpos <= $L(stubsql) {
		Set line=$e(stubsql,currpos,currpos+71) // 72 character lines
		Do nuln(line)
		If $i(currpos,72) // currpos += 72
	}
}
next	;  process a KEY "next" entry
	QUIT:$p(nin,$c(1),2)="c"  ;  constant subscript
	#; AK688
	i ns=1,$d(mt("filterm",+$p(info,$c(1),2))) QUIT  ;  skip filter computed field
	;  subscript with a given unique value
	i $p(nin,$c(1),2)="u" s lgiv=lgiv_$lb($$val($p(nin,$c(1)),"u")) QUIT
	; unique index lookup
	i $p(nin,$c(1),2)="l" s llook=llook_$lb($$val($p(nin,$c(1)))_$s($tr($p(nin,$c(1),3,6),$c(1))="":"",1:" (with a"_$s($p(nin,$c(1),4)=2:" %STARTSWITH",1:"")_" range condition)")) QUIT
	;  looping on chunks
	i $p(nin,$c(1),2)="h" {
		n maptype,chunktype
		s maptype=$$mapType^%qaqpagg($p(info,$c(1),2))
		s chunktype=$case(maptype,$$$EXTENTBITMAP:"bitmap chunks",$$$COLUMNARDATA:"vector chunks",$$$COLUMNARINDEX:"vector chunks",:"")
		i chunktype'="" s llup=llup_$lb($s($$$isWorkerModule(mod,qn)&&($p(nin,$c(1),4)=5):"the subrange of ",1:"")_chunktype) Return
	}
	new subCondList set subCondList=$$subCond($p(nin,$c(1),7))
	;  looping on a subscript, possibly with RANGE conditions
	s llup=llup_$lb($s($$$isWorkerModule(mod,qn)&&($p(nin,$c(1),4)=5):"the subrange of "_$$val($p(nin,$c(1))),
					1:$$val($p(nin,$c(1)))_$s(($p(info,$c(1))="map")&&($$$IsVectorSearchIndex($p(info,$c(1),2))):"",
					$p(nin,$c(1),2)["y":" (with a given set of values)",
					$tr($p(nin,$c(1),3,6),$c(1))="":$s($ll(subCondList):" (with "_$$commas(subCondList,,,1)_")",1:""),
					1:" (with "_$$commas($lb("a"_$s($p(nin,$c(1),4)=2:" %STARTSWITH",1:"")_" range condition")_subCondList)_")")))
	i $lg(llup)["the hash" s llup=$lb("the hash subscript")
	n optInfo
	i $d($$$aslNextBslTopFilt(mod,2,1,ns),optInfo) {
		s $li(llup,*)=$li(llup,*)_", selecting top rows using " _ $$map($li(optInfo,4))
	}
	For jj=1:1 {
		i $d($$$aslNextBslRangeFilt(mod,2,1,ns,jj),optInfo) {
			s $li(llup,*)=$li(llup,*)_$s(jj=1:", limiting the range using ",1:" and ") _ $$map($li(optInfo,3))
		}
		else {
			QUIT
		}
	}
	QUIT
read(info)  ;  read map or temp-file
	i $p(info,$c(1),2) {
		If $$$IsFTStream($p(info, $c(1), 6)) {
			new fakeAlias, fakeIRN, fakeTableName, ftIRNStreamCombo,ftIRNsandStreams,ftName,ftStream,line,newQb,oldQb,ptr,query
			set ftStream = $p(info, $c(1), 6)
			if +$g($$$FTFakeStream(ftStream)) {
				// fake streams, specify the FTs inside and that they are represented by fake stream
				new originalStream
				set originalStream = "", ftIRNsandStreams=""
				for {
					set originalStream = $o($$$FTFakeStreamOneUnderlyingStream(ftStream,originalStream))
					QUIT:originalStream=""
					set ftIRNsandStreams = ftIRNsandStreams_$lb($lb($$$mtRIrn($$$mtR( originalStream)), originalStream))
				}
				set query = $$$FTFakeStreamQuery(ftStream)
				set oldQb = $$$mtRQb($$$mtR(ftStream))				// query block the fake stream lives in
				set newQb = $$$FTFakeStreamQueryBlock(ftStream)		// query block the original logic was moved into which the fake stream represents
				set fakeIRN = +$$$mtR(ftStream)
				set fakeTableName = $$$smdSchema(1, fakeIRN) _ "." _ $$$smdName(1, fakeIRN)
				set fakeAlias = $$alias(oldQb, ftStream)
			} else {
				set ftIRNsandStreams = $lb($lb($$$smdMapIrn($p(info,$c(1),2)), $p(info,$c(1),6)))
				set (oldQb, newQb) = $p(info,$c(1),7)
			}
.
			set ptr=0, line="Read foreign table"_$s($ll(ftIRNsandStreams)>1:"s ",1:" ")
			while $listnext(ftIRNsandStreams,ptr,ftIRNStreamCombo) {
				set ftName = $$$smdSchema(1, $li(ftIRNStreamCombo,1)) _ "." _ $$$smdName(1, $li(ftIRNStreamCombo,1))
				set alias = $$alias(newQb, $li(ftIRNStreamCombo,2))
				set line = line_ftName_$s(alias'="":"("_alias_")",1:"")_", "
			}
			set $e(line,*-1,*)="" // remove comma
			if $d(fakeTableName) {
				set line = line_", represented as pushdown table "_fakeTableName_$s($g(fakeAlias)'="": "("_fakeAlias_")", 1:"")
			}
			
			do nuln(line)
			
			if $d(query) { // if the table is queryable, generate the query we'd send
				do apln(" sending query:"), nuln("    "_query), nuln("and")
			}
		}Else{
			d nuln("Read "_$$map($p(info,$c(1),2))_",")
		}
		QUIT}
	d nuln("Read ")
	RETURN:$p(info,$c(1),15)="bmvar"
	i $p(info,$c(1),3) {
		if $$$parAggUsesSharedGlobal(qn) && (mod=$p($g($$$mtAPESharedGlobal(qn)),"^",6)) {
			// Post-EEE015, we read from shared global in parallel aggregation (if used), not worker-private temp-file
			d apln($$mttf(,,,$$$getParAggSharedTf(qn))_",")
		} else {
			d apln($$tfn(+$p(info,$c(1),3),$p($p(info,$c(1),3),"^",2))_",")
		}
	}
	QUIT
outer(info)  ;  padding for outer join
	d:$p(info,$c(1),5)="p" apln(","),nuln("    generating a row padded with nulls if none found")
	d apln(".")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK731
dsn	;  send query to xDBC connection
	n dsn,m,isJDBC
	s dsn=$$$aslKId(mod,1),m=$$$aslIdQb(dsn),dsn=$$$aslIdLoopSupprSubscript(dsn)
	d getFlags^%apiGTW(dsn,,.isJDBC)
	d nuln("Send query to "_$s(isJDBC:"J",1:"O")_"DBC connection '"_dsn_"':")
	d nuln("    "_$$$mtSql(m))  ;  generated query
	d indent("For each row:")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK731-
	#; AK541
bsl	;  process BSL
	n last,chid,item,modit,idval s last=$o($$$aslK(mod,""),-1),chid=$s($$$aslIdLoopOnChunks($$$aslKId(mod,last)):"bitmap chunk",1:"idkey value")
	#;  call modules to build temp-files
	f item=1:1:last s modit=$$$aslIdTfBuildLoc($$$aslKId(mod,item)) i modit d nuln("Call module "_$$name($$headmod^%qaqcbsl(+modit))_" once"),admod($$headmod^%qaqcbsl(+modit)),poptf(+modit,$p(modit,"^",2)),apln(".")
	d nuln("Generate a stream of "_chid_"s using the multi-index combination:")
	d nuln("    "_$$bslit(last))  ;  BSL expression
	d indent("For each "_chid_":")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
bslit(item)  ;  $$: expression for BSL item asl(mod,2,item)
	n info,out,optinfo,flag,arg,i,alias
	set info=$$$aslKId(mod,item)
	set optinfo=$g($$$aslKBslTopOptInfo(mod,2,item))
	set flag=$$$aslIdKeyAccessType(info)
	set arg=$$$aslNextSkipNull($$$aslKNext(mod,item,1))
	s:(flag="map") alias=$$alias($$$aslIdQb(info),$$$aslIdStrNum(info))
	QUIT:flag="map" "("_$$map($$$aslIdMapId(info))_")"
	QUIT:flag="temp" "("_$$tfn(+$$$aslIdTfBuildLoc(info),$p($$$aslIdTfBuildLoc(info),"^",2))_")"
	QUIT:flag="or" "("_$$bslit(+arg)_" UNION "_$$bslit($p(arg,",",2))_")"
	QUIT:flag="and" "("_$$bslit(+arg)_" INTERSECT "_$$bslit($p(arg,",",2))_")"
	QUIT:flag="convert" $$bslit(arg)
	QUIT:flag="bstopfilt" $$bslit(arg)_", selecting top rows from " _ $$map($li(optinfo,4))_"."
	If flag="bsrangefilt" {
		Set out = $$bslit(arg)_",  limiting the range using "
		For i=1:1:$ll(optinfo) {
			Set out = out _ $s(i=1:"",1:" and ") _ $$map($li($li(optinfo,i),3))
		}
		Set out = out _"."
		QUIT out
	}
	QUIT:flag="set" "(given set of values)"
	QUIT:flag="single" "(single given value)"
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK541-
action(mod) n item s item=""  ;  process ACTION
	f  s item=$o($$$aslAct(mod,item)) q:item=""  d actit(mod,item)
	QUIT
actit(mod,item,mpty) 
	n info,actyp  ;  process ACTION item
	s info=$$$aslAct(mod,item),actyp=$$$aslActAction(info)
	#;  "output" action at the very "bottom", incl. UPDATE/DELETE/INSEL
	i actyp="o" d nuln($s($$$mtStatementType="INS":"Insert",$$$mtStatementType="UPD":"Update",$$$mtStatementType="DEL":"Delete",1:"Output")_$s($g(mpty):" no rows.",1:" the row.")) RETURN  ;  AK859
	i actyp="n" d mod($p(info,$c(1),2),0,ind) QUIT  ;  NEST
	i actyp="s" d nuln("Combine results in module "_$$name($p(info,$c(1),2))_"."),admod($p(info,$c(1),2)) QUIT  ;  SHARE
	#; AK541
	i actyp="a" d nuln("Accumulate the "_$s($p(info,$c(1),4)="bitcount":"count(bits)",1:$$val($p(info,$c(1),3)))_".") QUIT  ;  AGGREGATE
	i actyp="b" d build(mod,item) QUIT  ;  BUILD
	i actyp="q" d nuln("Determine subquery result.") QUIT  ;  QUIT
	i actyp="ipq" {
		New vals, ldat, line,i
		Set vals = $p(info, $c(1),2)_","
		Set ldat = ""
		for i=1:1:($l(vals,",")-1){
			Set ldat = ldat_$lb($$val($p(vals,",",i)))
		}
		
		Set line = "Add a row to "_$$tfn($$$topParentModule(qn)+2,-1)_", subscripted by a counter, with "_$s(ldat="":"no node data.",1:"node data of "_$$commas(ldat,,,1)_".")
		Do nuln(line)
		Quit
	}
	QUIT  ;  LOCK/UNLOCK
build(mod,item) n lsub,ldat,bldi,bin s lsub="",ldat="",bldi=0  ;  temp-file details
	n tf,tftype,tfhash,gothash s tf=+$$$aslActTfToBuild($$$aslAct(mod,item)),tftype=$p($g($$$mtTempFile(tf)),"^"),tfhash=$p($p($g($$$mtTempFile(tf)),"^",11),","),gothash=0
	n qmlp s qmlp=$$$mtTfPredictNode($g($$$mtTempFile(+$$$aslActTfToBuild($$$aslAct(mod,item)))))
	f  s bldi=$o($$$aslActNode(mod,item,bldi),1,bin) q:bldi=""  d blde
	i $p(info,$c(1),13)'="" {  ;  build vector join  ;  AK1064
		n k,f s k=$$jkeys^%qaqpmod(+$p(info,$c(1),16)),f=$$remove^%qaqpmod($$unveclist^%qaqpmod($p(info,$c(1),17)),k)
		d nuln("Add to "_$$tfn(mod,item)_$s(f="":" key vector",1:" vector"_$$clist(f,,1,1)_", with key vector")_$$clist(k,,1,1)_".")
		RETURN
	}
	#; AK541
	#;  *** better use 'info'
	i $p(info,$c(1),8)="bit" s ldat=$s(ldat="":"Add "_$li(lsub,$ll(lsub))_" bit to ",1:"OR the bitmap chunk into "),lsub=$li(lsub,1,$ll(lsub)-1) d nuln(ldat_$$tfn(mod,item)_$s(lsub="":"",1:", subscripted by "_$$commas(lsub))_".") QUIT
	#; AK541-
	#; AK671
	i $lg(ldat)["the accumulated ",gothash d nuln("Update "_$$commas(ldat)_" in "_$$tfn(mod,item)_","),nuln("    subscripted by "_$$commas(lsub)) QUIT
	d nuln("Add a row to "_$$tfn(mod,item)_$s(lsub="":"",1:", subscripted by "_$$commas(lsub))_",")
	d nuln("    with "_$s(ldat="":"no node data.",1:"node data of "_$$commas(ldat,,,1)_"."))
	QUIT
blde	;  one BUILD entry
	QUIT:$$$aslActNodeConstSubscriptVar(bin)'=""  ;  constant subscript
	;  subscript
	#; AK671
	i $e(bin)="s" {
		s:'gothash lsub=lsub_$lb($$val($p(bin,$c(1),2)))
		if tftype="dist",$$$aslActNodeSubscriptVar(bin)=tfhash set gothash=1
		QUIT
	}
	;  node data - grouped aggregate or regular field
	#; AK541
	i $p(bin,$c(1),6)="orbit" s ldat=1 QUIT  ;  OR of bitmap chunk
	i (","_qmlp)[(","_$p(bin,$c(1),2)_",") { s ldat=ldat_$lb("[expression]") RETURN }  ;  AK1015;AK1019
	s ldat=ldat_$lb($s($c(1)'[$p(bin,$c(1),6,7):"the accumulated ",1:"")_$$val($p(bin,$c(1),2)))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
stats(statsList,ind,verbose=0) [ind] PUBLIC {	// --- Add the Statistics to the Plan ---
	QUIT:'$LV(statsList)||(statsList="")	// Stats are either an error or empty!
	
	if $LG(statsList,1)="MESSAGE" { // --- Add Message to the Output ---
		do nuln("<nostats>")
		do nuln(" "_$LG(statsList,2))
		do nuln("</nostats>")
	}
	else { // --- Add Runtime Statistics to the Output ---
		do nuln("<stats>")
		for statPos=1:1:$LL(statsList) {	// --- Add the Statistical Details ---
			set statsInfo=$LG(statsList,statPos)
			set statsProp=$LG(statsInfo,1),statsCap=$LG(statsInfo,2),statsVal=$LG(statsInfo,3)
			do nuln(" <"_statsProp_$s(verbose:" caption="""_statsCap_"""",1:"")_">"_statsVal_"</"_statsProp_">")
		}
		do nuln("</stats>")
	}
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
error(error,ind) [] PUBLIC {
	do DecomposeStatus^%apiOBJ(error,.errDetail,"-d")
	QUIT:$g(errDetail(1))=""	// No Error Found! 
	do nuln("<error>")
	for pos=$l(errDetail(1),";"):-1:1 do nuln($$$StripLeadingWhiteSpace($p(errDetail(1),";",pos)))
	do nuln("</error>")
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
	#;--- service functions ---
indent(foreach)  ;  increase the indentation
	d nuln(foreach)
	s ind=ind_"    "
	QUIT
unindent(line) ; remove indentation and add line
	s ind = $E(ind,1,*-4)
	d nuln(line)
	QUIT
nuln(line)  ;  add a new line to the output
	s %plan($i(%plan))=ind_line
	QUIT
apln(line)  ;  append to the current output line
	s %plan(%plan)=%plan(%plan)_line
	QUIT
clist(list,with=0,plural=0,order=0) n res,nn s res=""  ;  $$: identify $LIST items into a comma-list
	f nn=1:1:$l(list,",")-1 s res=res_$lb($$val($p(list,",",nn)))
	QUIT $$commas(res,with,plural,order)
val(val,given="")  ;  $$: identify symbol-table entry
	QUIT:'val "rows"  ;  for COUNT(*)
	if $d($$$mtVecDistFunc(val)) {
		s val=$$$mtVecDistFunc(val)
		RETURN $$exprname($$$mtV(val))_$$onfields($p($$$mtV(val),"^",3))
	}
	s val=$$$mtV(val)
	QUIT:val="i^tempID" "a counter"
	QUIT:$e($tr(val,"^"),1,5)="iunlb" "$LIST of UNION column values"
	QUIT:$e(val,1,8)="i^unout^" "UNION column #"_$p(val,"^%%C",2)
	if $e(val,1,6)="a^udaf" { RETURN "User Defined Aggregate Function "_$p($p(val,"^",2),$c(2),2)_"."_$p($p(val,"^",2),$c(2),3)_"("_$$val($p(val,"^",5))_")" }
	QUIT:$e(val)="a" $p(val,"^",2)_"("_$$val($p(val,"^",5))_")"
	#; AK541
	i $e(val,1,5)="i^^i^",val["sb" {s:given="u" colup=1 RETURN $s(given="u":"chunk number",val["vsb":"vector chunks",1:"bitmap chunks") }
	i $e(val,1,8)="i^^i^vec"{
		new v
		s val=$e($p(val,"i^^i^vec",2),4,*)
		f  { QUIT:val  s $e(val,1,3)="" }
		s v=$$$mtV(val)
		RETURN $s($p(v,"^")="f":$$val(val),$p(v,"^")="v":"expression"_$$onfields($p(v,"^",3)),$p(v,"^")="x":"a parameter",1:"[vector variable]")
	}
	RETURN:$e(val,1,2)="v^" $$exprname(val)
	QUIT:val?1"i^".E1"^dist"1.N1"prefix" "the hash"
	QUIT:val?1"i^".E1"^dist"1.N1"cnt" "the hash bucket"
	QUIT:val[".power" "bitslice power"
	QUIT:val[".aggPower" "aggregate for the power"
	QUIT:val[".sub" "bitslice chunks"
	QUIT:val[".chunkSub" "bitmap chunks"
	QUIT:$e(val)'="f" "[value]"
	n qb,str,fd,alias
	s str=$p(val,"^",2),qb=$p($g($$$mtR(str)),"^",2),alias=$$alias(qb,str)
	#; AK516-
	s val=$p(val,"^",3)  ;  it's a field - use the ifn
	#; JLF015
	#; QUIT:((val["_")&&($p(val,"_",2)'["%ANY")) $p(val,"_",2)_"("_$$field(+val)_")"
	QUIT:val["_" $s($e($p(val,"_",2),1,6)="%ANYOF":"%EXACT(Subvalue",1:$$parseEncodedCollate($p(val,"_",2))_$s($e($p(val,"_",3),1,6)="%ANYOF":"(Subvalue",1:""))_"("_$$field(+val)_")"_$s(val["_%ANYOF":")",1:"")
	#; JLF015-
	s fd=$$field(val)
	RETURN:$e(fd,1,14)="x__partitionid" "partition id "_$e(fd,15,*)
	RETURN:$e(fd,1,11)="x__bucketid" "bucket"
	RETURN:$e(fd,1,9)="x__prowid" "partition row id"
	QUIT $s(($l($g(alias))&&(fd'[" ")&&(alias'["->")):alias_"."_fd,1:fd)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
exprname(val)  ;  $$: expression name for val
	RETURN:($e(val,1,10)="v^PREDICT^")||($e(val,1,14)="v^PROBABILITY^") $p(val,"^",2)_"()"  ;  AK1015
	#; AK516
	RETURN:$e(val,1,9)="v^%VHASH^" "a hash of "_$$clist($tr($p(val,"^",4,*),"^",","),,,1)
	RETURN:$e(val,1,5)="v^/0^" "AVG"
	RETURN:$e(val,1,9)="v^%RMLSP^" "the uncollate expression"
	RETURN:$e(val,1,8)="v^%BARS^" "the concatenate expression"
	RETURN:$e(val,1,8)="v^%PBAR^" "$piece"
	RETURN:$e(val,1,8)="v^CURTS^" "CURRENT_TIMESTAMP" ; GETDATE() and CURRENT_TIMESTAMP expressions
	RETURN:$e(val,1,10)="v^CURDATE^" "CURRENT_DATE"
	RETURN "the '"_$p(val,"^",2)_"' expression"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
condname(log,isop=0)  ;  $$: condition name for log
	#; isop=1 when op is the operation and not the log number
	set log=$$logdict($s(isop:log,1:$$$mtLOperator($$$mtL(log))),log)
	RETURN $select("AEIOU"[$e(log):"an ",1:"a ")_log_" condition"
logdict(op,log) [mt] PUBLIC {
	if $lf($lb("=",">","<","[","NULL","%STARTSWITH","%PATTERN","%MATCHES","DISTINCT"),op) { ; common conditions that don't need translation
		RETURN op
	}
	set opsql=$case(op,
	"'":"NOT","'NULL":"NOT NULL","'=":"<>","'>":"<=","'<":">=",
	"&":"AND","!":"OR","'&":"NAND","'!":"NOR","ONEOF":"IN","ANYOFAND":"FOR SOME %ELEMENT","FOR SOME":"EXISTS",
	"JSON*A":"IS JSON ARRAY","JSON*O":"IS JSON OBJECT","JSON*S":"IS JSON SCALAR","JSON":"IS JSON",
	"'JSON*A":"IS NOT JSON ARRAY","JSON*O":"IS NOT JSON OBJECT","JSON*S":"IS NOT JSON SCALAR","JSON":"IS NOT JSON",
	"%VC":"virtual","'EMPTY":"NOT EMPTY","%BATPULL":"BAT ID extraction","%FIND":"IN","'[":"NOT [","INSET":"IN SET",
	:"")
	if opsql="" {
		if $e(op,1,3)="TOP" { ; this can be "TOP:'=.'=.'=.'=.'=.'=.'=.<", "TOP:'=.'>", etc
			RETURN "TOP"
		} elseif $e(op,1,17)="METHOD:%Collation" {
			RETURN "date/time comparison"
		} elseif $e(op,1,6)="EXISTS" { ; this can be "EXISTS:'=", "EXISTS:=,=", EXISTS:'< etc
			RETURN "EXISTS"
		} elseif $e(op,1,9)="NOTEXISTS" { ; this can be "NOTEXISTS:'=", "NOTEXISTS:<" etc
			RETURN "NOT EXISTS"
		}
	} elseif opsql="NOT" {
		set notLog=$$$mtLOperand1($$$mtL(log))
		RETURN "NOT "_$$logdict($$$mtLOperator($$$mtL(notLog)),notLog)
	} else {
		RETURN opsql
	}
	; all other cases, don't translate
	RETURN op
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
map(imp) [mt,info,alias] PUBLIC {  ;  identify map:  master/index map "s.t.m"  *** check for virtual map!  JLF015
	#; AK688
	i $d(mt("filterm",imp),filter) QUIT "given "_$s($e(filter,1,6)="%INBIT":"bitmap ",1:"")_"filter for "_$$table(+$$$mtR($p(info,$c(1),6)))_".%ID"
	s smdimp=$s($d(mt("smdimp",imp)):mt("smdimp",imp),1:imp)
	s it=$$$smdMapIndexType(smdimp),mapalias=$g(alias)
	s node=$s($$$smdMapMaster(smdimp)="Y":"master map ",it="BE":"extent bitmap ",it="B":"bitmap index ",it="S":"bitslice index ",$e(it)="C":"columnar index ",1:"index map ")
	QUIT:($l(mapalias)&&(mapalias'["%")) node_$$table($$$smdMapIrn(smdimp))_"("_mapalias_")"_"."_$$$smdMapName(smdimp)
	QUIT node_$$table($$$smdMapIrn(smdimp))_"."_$$$smdMapName(smdimp)
}
table(irn) [] PUBLIC {  //  identify table
	QUIT $$$smdSchema(1,irn)_"."_$$$smdName(1,irn)
}
field(ifn)  ;  identify field
	RETURN:$$findFakeVectorSearchField(ifn)'="" $$findFakeVectorSearchField(ifn)
	i $d($$$mtVirf(ifn),ifn){ ; s ifn=$li(ifn) QUIT $s(ifn:"VIEW column #"_ifn,1:"VIEW counter")
		n ifnval,valias s ifnval=$li(ifn,2)
		QUIT:'$li(ifn) "VIEW counter"
		if $e($g($$$mtV(ifnval+1)),1,2)="s^"{s valias=$p($$$mtV(ifnval+1),"^",2) QUIT "VIEW column "_valias } ; "VIEW column on "_$$val(ifnval)_" AS "_valias
		else {QUIT "VIEW column on "_$$val(ifnval)}
	} elseif $d(str), $$$IsFTStream(str), $$$smdGetFieldName(ifn)=$$$smdRowIDFieldName(1, $$$mtRIrn($$$mtR(str))) {
		RETURN "pseudo-ID"
	}
	
	QUIT $$$smdGetFieldName(ifn)
commas(list,with=0,plural=0,ordered=0,returnOrderedList=0) PUBLIC { ; $$: properly comma items in $LIST
	; list to be turned into a string
	; with=1 if the returned string will start with "with"
	; plural=1 if the returned string will add an "s" to the previous noun to make it plural
	; ordered=1 to order list in subscript collation order, usually to avoid non-determinism
	; returnOrderedList=1 use this function just for ordering and return a list instead of a string
	if ordered || returnOrderedList {
		set ordlist="",item=""
		for li=1:1:$ll(list) set:($li(list,li)'="") ordlist($li(list,li))="" 
		for  set item=$o(ordlist(item)) QUIT:item=""  set ordlist=ordlist_$lb(item)
		RETURN:returnOrderedList ordlist
		set list=ordlist
	}
	set res=""
	for ii=$ll(list):-1:1 {
		set res=$$parseEncodedCollate($li(list,ii))_$s(ii=$ll(list):"",(ii=1)&&with:" with ",1:$s(2=$ll(list):" ",1:", ")_$s(ii+1=$ll(list):"and ",1:""))_res
	}
	QUIT $s('plural:"",$ll(list)=0:"",$ll(list)=1:$s($list(list,1)="":"",1:" "),1:"s ")_res
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tfn(mod,item,dist)  ;  $$: temp-file name for build action mod,item
	#; AK671
	s:'$d(tfn(mod,item)) tfn(mod,item)=$$mttf(mod,item,.dist)
	QUIT tfn(mod,item)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mttf(mod,item,dist=0,tfNumber=0) n tf  ;  $$:  text for temp-file, from mt("tf",tf#,"text")
	if tfNumber'=0 {
		// This if-branch was originally intended for the shared global temp-file when used in parallel aggregation (EEE015)
		set tf = tfNumber
		set:'$d($$$mtTfText(tf)) $$$mtTfText(tf)=$s($$$getParAggSharedTf(qn)=tf:"shared ",1:"")_"temp-file "_$$name(tf)
	} else {
		i 'item { s:'$d(mt("oatfn",mod),tf) (tf,mt("oatfn",mod))=$$nutemp("plan^"_mod_"^^"_item),$$$mtTfText(tf)="array temp-file "_$$name(tf) }
		elseif dist {
			set tf=$$$aslPkDistTf($$$aslPkDist(mod,3,item))
			s:'$d($$$mtTfText(tf)) $$$mtTfText(tf)=$s($$$mtTfBitmapFlag($$$mtTempFile(tf)):"bitmap ",1:"")_"temp-file "_$$name(tf)
		} else {
			s:'$$$aslActTfToBuild($$$aslAct(mod,item)) $$$aslActTfToBuild($$$aslAct(mod,item))=$$nutemp("plan^"_mod_"^^"_item)
			s tf=$$$aslActTfToBuild($$$aslAct(mod,item))
			#;  [ bitmap | vector-join ] temp-file A"  ;  AK1064
			s:'$d($$$mtTfText(tf)) $$$mtTfText(tf)=$s($$$aslActVecJoin($$$aslAct(mod,item))'="":"vector-join ",$$$aslActIsBmTf($$$aslAct(mod,item))="bit":"bitmap ",1:"")_"temp-file "_$$name(tf)
		}
	}
	QUIT $$$mtTfText(tf)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nutemp(x)  ;  $$:  newly allocated temp-file#, with info x
	s $$$mtTempFile($i($$$mtLatestTempFileNum))=x
	QUIT $$$mtLatestTempFileNum
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK671-
name(var) [] PUBLIC {	//  $$:  letter name:  A,B,...,Z,27,28,...
	QUIT:var<27 $c(64+var) QUIT var
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
admod(mod)  ;  append mod to list of pending modules
	s lmods=lmods_$lb(mod)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
simplifycolumnar
	n simp,pline,litem,nlines,todelete,newitem
	s simp="",pline="",litem="",todelete=""
	f  {
		s newitem=$o(colmaps(litem))
		if newitem="",$ll(simp)>1{ ; we have lines to delete and we finished looping on colmaps
			s %plan(pline)=$p(colmaps(litem),$c(1),2)_"Read columnar indexes "_$$commas(simp,,,1)_", using the given chunk number."}
		q:newitem=""
		if newitem=(litem+1){ ; we have lines to deleye 
			s:$ll(simp) todelete=todelete_newitem_","
			s simp=simp_$lb($p(colmaps(newitem),$c(1)))
		}elseif $ll(simp)>1{ ; we have lines to delete and there could be more
			s %plan(pline)=$p(colmaps(litem),$c(1),2)_"Read columnar indexes "_$$commas(simp,,,1)_", using the given chunk number."
			s:newitem pline=newitem,simp="",simp=simp_$lb($p(colmaps(newitem),$c(1)))
		}elseif litem=""{ 
			s pline=newitem,simp=simp_$lb($p(colmaps(newitem),$c(1)))
		}else{ ; this means that newitem>litem+1, we cannot merge the lines
			s pline=newitem,simp="",simp=simp_$lb($p(colmaps(newitem),$c(1)))
		}
		s litem=newitem
	}
	n i,newplan
	s newplan=""
	for i=1:1:%plan{
		if i=+todelete{ s todelete=$p(todelete,",",2,*)}else{ s newplan($i(newplan))=%plan(i)}}
	k %plan merge %plan=newplan 
	QUIT
nlizFromHash(hash,json) [asl,mt,mts,pdict]  PUBLIC { ; return query plan from binary plan
	new %plan
	set plan=""
	merge binaryPlanInfo=$$$SQLIndex(1,hash,"plan")
	// restore mt, asl, mts and pdict from the binary plan data
	do ConstructArray^%qaqplansave(.binaryPlanInfo,0)
	// populate meta to map table, map and field names to their internal numbers
	set iqn=""
	for {
		set iqn=$o(pdict("tbl",iqn),1,irnInfo) q:iqn=""
		set irn=$li(irnInfo)
		set meta(iqn)=irn
		set fn=""
		for {
			set fn=$o(pdict("fld",irn,fn),1,ifnInfo) q:fn=""
			set meta(iqn,"f",fn)=$li(ifnInfo)
		}
	}
	set mn=""
	for {
		set mn=$o(pdict("map",mn)) q:mn=""
		set iqn=""
		for {
			set iqn=$o(pdict("map",mn,iqn),1,imp) q:iqn=""
			set meta(iqn,"m",mn)=imp
		}
	}
	try {
		set oldZU68c28=$zu(68,28,0) kill $$$smdRoot do $zu(68,28,oldZU68c28)
		set iqn=""
		// reconstruct smd from meta
		for {
			set iqn=$o(pdict("tbl",iqn),1,irnInfo) q:iqn=""
			set $lg(irn,istvf)=irnInfo
			if $$$smdLoadGetIrn(iqn,,.meta,.SQLCODE)'=irn {
				RETURN "" ; table, tvf or field not found for : "_iqn
			}	
		}
		merge sql=$$$SQLIndex(1,hash,1) 
		// generate ShowPlan output
		do nliz^%qaqplan(.sql,.asl,.mt,$g(pdict("omscost")),,,,$g(json),.mts)
		if $g(json) {
			set formatter = ##class(%JSON.Formatter).%New()
			do formatter.FormatToString(%plan,.plan)
		} else {
 			set plan=$p($p($SYSTEM.SQL.RefactorSQLPlan("%plan","ShowPlan"),"<plans>",2,*),"</plans>",1,*-1)
 		}
		set oldZU68c28=$zu(68,28,0) kill $$$smdRoot do $zu(68,28,oldZU68c28)
	} catch {
		; "encountered an error generating the plan from the statement index"
	}
	RETURN plan
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;-------------------------------------------------------------
	#;                       I N F O R M A T I O N
	#;  Line choices:
	#;  <plan>		=>	<pln>
	#;  </plan>		=>	</pln>
	#;  <sql>			same
	#;  sql text			same
	#;  </sql>			same
	#;  <cost ...			remove
	#;  Time in ...			remove  ;  GetStats()
	#;  Failed to ...		remove  ;  GetStats()
	#;  <subquery>			same
	#;  </subquery>			same
	#;  <module ...			remove  (unless shared via "Combine")
	#;  </module>			remove  (unless shared via "Combine")
	#;  <module ...		=>	<module>  (if shared via "Combine")
	#;  </module>			same  (if shared via "Combine")
	#;  Call module ...	=>	inline module contents
	#;  Check distinct ...	=>	Check distinct using a temp-file.
	#;  subscripted ...		remove
	#;  Read ...		=>	Read the temp-file.  (if temp-file)
	#;  Read ...		=>	Read ... (only up to "using"/"looping")
	#;  generating ...		remove
	#;  Generate ...		remove
	#;  (...		=>	just remove temp-file names (BSL)
	#;  Loop ...			remove
	#;  For each ...		remove
	#;  Insert the row.		remove
	#;  Update the row.		remove
	#;  Delete the row.		remove
	#;  Output the row.		remove
	#;  Combine ...			remove (module processed separately)
	#;  Accumulate ...		remove
	#;  Determine ...		remove
	#;  Add ...		=>	Update the temp-file.
	#;  OR ...		=>	Update the temp-file.
	#;  Update ...		=>	Update the temp-file.
	#;  with ...			remove
	#;-------------------------------------------------------------
	#;  [public:%plan,%pln]  ;  reduce array %plan() to array %pln()
	#;  skipmod = $LIST() of modules to skip - already inlined
	#;  start - line# where the current plan starts
.
pln	n jj,skipmod,start s skipmod="",start=1				// DPV3372 (implemented by AK)
	f jj=1:1:%plan d pline($zstrip(%plan(jj),"<W"))
	QUIT
.
pline(line)  ;  process the ShowPlan line
	QUIT:$$replace("<plan>","<pln>")
	QUIT:$$replace("</plan>","</pln>")
	i line="<sql>" d sqltxt QUIT  ;  inline module contents
	QUIT:$$same("<subquery>")
	QUIT:$$same("</subquery>")
	i $e(line,1,12)="Call module " d inmod($p($p($p($e(line,13,*),"."),",")," ")) QUIT  ;  inline module contents
	i $lf(skipmod,line) d skipmod QUIT  ;  skip module if already inlined
	QUIT:$$replacest("<module ","<module>")
	QUIT:$$same("</module>")
	QUIT:$$replacest("Check distinct ","Check distinct using a temp-file.")
	QUIT:$$replacest("Read ",$s(line["temp-file":"Read the temp-file.",1:$p(line,",")_"."))
	QUIT:$$replacest("(",$$notfn(line))  ;  BSL - remove temp-file names
	QUIT:$$replacest("Add ","Update the temp-file.")
	QUIT:$$replacest("OR ","Update the temp-file.")
	QUIT:$$replacest("Update ","Update the temp-file.")
	QUIT  ;  skip anything else
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	QUIT:$$removest("<cost ")
	QUIT:$$removest("Time in ")  ;  GetStats()
	QUIT:$$removest("Failed to ")  ;  GetStats()
	QUIT:$$removest("subscripted ")
	QUIT:$$removest("generating ")
	QUIT:$$removest("Generate ")
	QUIT:$$removest("Loop ")
	QUIT:$$removest("For each ")
	QUIT:$$remove("Insert the row.")
	QUIT:$$remove("Update the row.")
	QUIT:$$remove("Delete the row.")
	QUIT:$$remove("Output the row.")
	QUIT:$$removest("Combine ")
	QUIT:$$replacest("Combine ","Combine results in shared module.")
	QUIT:$$removest("Accumulate ")
	QUIT:$$removest("Determine ")
	QUIT:$$removest("with ")
.
sqltxt	;  just copy the whole SQL text
	f jj=jj:1:%plan d nuln2(%plan(jj)) q:%plan(jj)="</sql>"
	s skipmod="",start=jj  ;  initialize for starting a new plan
	QUIT
.
inmod(mod) n jj  ;  inline here module 'mod', skip it later
	s mod="<module name="""_mod_""">",skipmod=skipmod_$LB(mod)
	f jj=start:1:%plan q:%plan(jj)=mod
	QUIT:%plan(jj)'=mod  ;  couldn't find module - something wrong!
	f jj=jj+1:1:%plan q:%plan(jj)="</module>"  d pline($zstrip(%plan(jj),"<W"))
	QUIT
.
skipmod ;  skip the whole module starting at current line (advance jj)
	f jj=jj+1:1:%plan q:%plan(jj)="</module>"
	QUIT
.
notfn(line) n p s p=0  ;  $$: remove temp-file names from line
	f  s p=$f(line,"temp-file",p) q:'p  s $e(line,p,$f(line,")",p)-2)=""
	QUIT line
.
same(x)		if line=x { d nuln2(line) QUIT 1 } QUIT 0
samest(x)	if $e(line,1,$l(x))=x { d nuln2(line) QUIT 1 } QUIT 0
remove(x)	QUIT line=x
removest(x)	QUIT $e(line,1,$l(x))=x
replace(x,y)	if line=x { d nuln2(y) QUIT 1 } QUIT 0
replacest(x,y)	if $e(line,1,$l(x))=x { d nuln2(y) QUIT 1 } QUIT 0
nuln2(line)	s %pln($i(%pln))=line QUIT  // add a new line to the output
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
/// This method accepts a SQL Query Plan via the '%plan' parameter and re-formats the
/// Linear Plan Format (LPF) of this array into an Inline Plan Format (IPF).
/// The content of the '%plan' array will be further formatted as either Semi-XML
/// or Simple-Text based on the value of the 'planFormat' parameter.
///
/// PARAMETERS:
///   %plan       - A Pass By Reference (PBR) array containing the SQL Query Plan
///                 specified in Linear Plan Format (LPF), which will be returned 
///                 re-formatted to an Inline Plan Format (IPF), with the following 
///                 structure:
///                   %plan=# of lines/nodes
///                   %plan(...)=SQL Query Plan Information
///   planFormat  - This value, which is based on the 'verbose' parameter passed to
///                 the {ShowPlan | ShowPlanAlt | Explain | GetSQLPlan (via the 
///                 'qualifiers' parameter)}(...) methods within the '%SYSTEM.SQL.CLS'
///                 class, or passed to the {ShowPlan | ShowPlanRtn
///                 | ShowPlanAlt | getSQLPlan (via the 'qualifiers' parameter)}(...)
///                 methods within the '%apiSQL.MAC' routine, and ultimately passed 
///                 to the 'nliz(...)' method within this routine, is a flag to 
///                 determine the content format for the '%plan' array:               [DEFAULT: 3]
///                   2 - The '%plan' array will be further formatted as Semi-XML
///                   3 - The '%plan' array will be further formatted as Simple-Text
///   %planOrig   - A Pass By Reference (PBR) array containing the original SQL Query
///                 Plan in Linear Plan Format (LPF)
///
planInline(&%plan, planFormat = 3, &%planOrig) [] PUBLIC {
	
	set tSC=$$$OK,$ZE=""
	
 try {
	merge %planOrig=%plan  // Save a copy of the original '%plan(...)' array!
	
	// --- Generate All Plan Information Arrays ---
	set tSC=$$planHTML^%qaqplan(.%plan,,,,,,,0,,.tag,.module) $$$THROWONERROR(tSC,tSC)
	
	// --- Generate the 'planOut(...)' array in Inline Plan Format (IPF) ---
	do makeIPF(1,0,.%plan,.tag,.module,.planOut)
	
	// --- Remove & Replace the '%plan(...)' array in Linear Plan Format (LPF) with the 'planOut(...)' array in Semi-XML Inline Plan Format (IPF) ---
	kill %plan,planOut("info")  // Remove the old '%plan' array and the new "info" node that is used for processing!
	
	if planFormat=2 { // --- Replace the '%plan' array with the 'planOut' array in Semi-XML Inline Plan Format (IPF) ---
		merge %plan=planOut
	}
	elseif planFormat=3 { // --- Convert & Replace the '%plan' array format with Simple-Text Linear Plan Format (LPF) ---
		set tSC=$$planHTML^%qaqplan(.planOut,,,,,,,0,,.tag,.module)
		set tSC=$$planHTMLtoText(.planOut,.tag,.module,.%plan)
	}
 }
 catch tException {
	set tSC=tException.AsStatus()
 }
	RETURN tSC
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
#DEFINE indentLen 2
	
/// Method: makeIPF [(I)nline (P)lan (F)ormat]
///
/// This method takes the '%plan(...)' array in Linear Plan Format (LPF), and all 
/// associated Plan Information arrays, and generates the 'planOut(...)' array in
/// Inline Plan Format (IPF), such that all tag/module elements are properly formatted 
/// based on their parent/child relationship.  Additionally, all Call module/subquery 
/// elements will be embedded inline directly under their respective Call line,
/// as specified by the BNF definitions in the 'swapCallerRefs(...)' method...
///
/// PARAMETERS:
///   tagID       - The ID value associated with appropriate node of the 'tag(tagID)'
///                 array
///   level       - The depth level for each descendant 'tagID' from the 'tag(tagID)'
///                 array.  This value also helps to calculate the whitespace padding
///                 'padWS' to be concatenated at the beginning of the tag line
///   %plan       - A Pass By Reference (PBR) array containing the SQL Query Plan
///                 specified in Linear Plan Format (LPF)
///   tag         - A PBR array parameter of all 'tag' information used to process
///                 the SQL Query Plan contained within the '%plan(...)' array
///   module      - A PBR array parameter of all 'module' information used to process
///                 the SQL Query Plan contained within the '%plan(...)' array
///   planOut     - A PBR array parameter of the '%plan(...)' array re-formatted
///                 from a Linear Plan Format (LPF) to an Inline Plan Format (IPF), 
///                 with the following structure:
///                   planOut=# of lines/nodes
///                   planOut(...)=SQL Query Plan Information
/// 
makeIPF(tagID = 1, level = 0, &%plan, &tag, &module, &planOut) [pSub,tagIDChild] PUBLIC {
	
	new pSub,tagIDChild
	
	if 'level { kill tag("skip"),planOut set tag("processed")="" }  // Tabula Rasa!
	set tagInfo=$g(tag(tagID))
	RETURN:tagInfo=""  // No information specified for the given 'tagID'!
	
	set padWS="",$p(padWS," ",level*$$$indentLen)=" "
	set $LG(sTag,sTagOffset,pSubStart,pSubEnd,tagIDParent,tagChildren,moduleID)=tagInfo
	set getTagIDChild=""
	for childPos=1:1:$LL(tagChildren) { // --- Process All Direct Child Tags ---
		set tagChild=$LG(tagChildren,childPos)
		set getTagIDChild=getTagIDChild_$s(childPos>1:",",1:"")_"(pSub'<"_$LG(tag(tagChild),3)_")&&(pSub'>"_$LG(tag(tagChild),4)_"):"_tagChild
	}
	set tagIDChild="" set:getTagIDChild'="" getTagIDChild="set tagIDChild="_"$s("_getTagIDChild_",1:"""")"
	
	set callInfoList=$LG($g(module(+moduleID,0)),13)
	for callPos=1:1:$LL(callInfoList) { // --- Process All Call module/subquery Elements (child tag) Invocations ---
		set callInfo=$LG(callInfoList,callPos)
		set callMod($LG(callInfo,1))=$LG(callInfo,2)  // Record the line 'pSub' for each Call module/subquery Elements (child tag) invocation!
	}
	
	for pSub=pSubStart:1:pSubEnd { // --- Process All Lines for the given 'tag(tagID)' ---
		if $d(tag("skip",pSub)),pSub'=pSubStart { set pSub=tag("skip",pSub) CONTINUE }  // If we are not repeating a Call to a module/subquery, then skip over this tag/module/subquery, since it's already been processed!
		// --- Check to see if we are processing a Child Tag based on the 'pSub' tha we are processing ---
		try { Xecute:getTagIDChild'="" getTagIDChild } catch { }
		if tagIDChild {  // --- Process the 'tag(tagIDChild)' level ---
			set pSub=$$makeIPF(tagIDChild,level+1,.%plan,.tag,.module,.planOut)
			CONTINUE
		}
		set planOut($i(planOut))=padWS_%plan(pSub)  // Record the new SQL Plan lines!
		
		// --- Record Vital Information about the Current '%plan(psub)' Node ---
		for lastWSPos=0:1 { QUIT:$e(%plan(pSub),lastWSPos+1)'=" "  }  // Determine the current space indentation level!
		set planOut("info",planOut)=$LB(tagID,level,lastWSPos,$l(padWS))
		
		for callPos=1:1:$LL($g(callMod(pSub))) { // --- Process Each Call module/subquery Elements (child tag) Invocations ---
			set callInfo=$LG(callMod(pSub),callPos)
			set $LG(callTagName,callName)=callInfo
			set tagIDCall=$LG(module(module("x-"_callTagName,callName),0),7)
			set pSubCall=$$makeIPF(tagIDCall,level+(lastWSPos+(lastWSPos#$$$indentLen)\$$$indentLen)+1,.%plan,.tag,.module,.planOut)
			set tag("skip",$LG(tag(tagIDCall),3))=pSubCall  // Set a flag to skip over this tag/module altogether, since it's already been processed!
		}
	}
	set $LIST(tag("processed"),tagID)=1       // Set a flag to indicate that this 'tagID' has been processed!
	kill:'level tag("processed"),tag("skip")  // Remove these temporary nodes after processing all 'tag(1...n)' nodes!
	RETURN pSub
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
/// This method takes the '%plan(...)' array, which is specified either in Linear 
/// Plan Format (LPF) or more typically in Inline Plan Format (IPF), with its content
/// further formatted as HTML/Semi-XML, and converts the content into a Simple-Text
/// format.  The newly formatted array is returned via the Pass By Reference (PBR)
/// parameter 'planOut'...
///
/// PARAMETERS:
///   %plan       - A Pass By Reference (PBR) array containing the SQL Query Plan
///                 specified either in Linear Plan Format (LPF) or more typically
///                 in Inline Plan Format (IPF), with the content formatted as 
///                 HTML/Semi-XML
///   tag         - A PBR array parameter of all 'tag' information used to process
///                 the SQL Query Plan contained within the '%plan(...)' array
///   module      - A PBR array parameter of all 'module' information used to process
///                 the SQL Query Plan contained within the '%plan(...)' array
///   planOut     - A PBR array parameter of the '%plan(...)' array re-formatted
///                 from a Linear Plan Format (LPF) to an Inline Plan Format (IPF), 
///                 with the following structure:
///                   planOut=# of lines/nodes
///                   planOut(...)=SQL Query Plan Information
/// 
planHTMLtoText(&%plan, &tag, &module, &planOut) PUBLIC {
	
	set tSC=$$$OK,$ZE=""
	kill planOut  // Tabula Rasa!
	
 try {
	set modName="MAIN"  // DEFAULT: The first top <module> is always the 'MAIN' module!
	set modTop=1        // DEFAULT: The first top <module> always has the property (top='1')!
	set padWSNext=""    // The WS Padding for the next <module> following the one that has the property (top='1')!
	
	set pSub=""
	for { // --- Process All '%plan(pSub)' Nodes ---
		set pSub=$o(%plan(pSub),1,pLine)
		QUIT:pSub'=+pSub  // No more 'pSub' values!
		
		if pLine["<" { // --- Check for 'Start Tag' (<tag) or 'End Tag' (</tag) Line ---
			set padWS=$p(pLine,"<",1)
			
			if $tr(padWS," ","")="" { // --- Process 'Start/End Tag' Line ---
				set tagLine=$p(pLine,"<",2,*)
				set tagName=$p($p($e(tagLine,$s($e(tagLine,1)="/":2,1:1),*)," ",1),">",1)
				
				if ",module,subquery,"[(","_tagName_",") { // --- Special Processing for <module>/<subquery> Tags ---
					set modName=$$attributeVal(tagLine,"name")
					set modTop=$s(modName="FIRST":1,1:$$attributeVal(tagLine,"top"))  // Ensure that the 'FIRST' module, or a module with the attribute (top='1'), is always a Top Module!
					set padWSNext=$s(modTop:"",padWSNext="":padWS,1:padWSNext)  // Determine the WS Padding for the next <module> following the one that has the property (top='1')!
				}
				set tagHeader=$CASE(tagName,"plan":"Plan","sql":"SQL","warning":"Warning","info":"Info","frozenPlan":"Frozen Plan","cost":"Cost","module":"Module-"_modName,"stats":"Stats","nostats":"No Stats","subquery":"Subquery-"_modName,"expression":"Expression","value":"Value","error":"ERROR",:tagName)
				
				if $e(tagLine,1)'="/" { // --- Process 'Start Tag' Line ---
					set tagInfo(tagName,"id")=+$g(tag("x-tag",tagName,$i(tagInfo(tagName,"offset"))))  // Obtain 'tagName' specific ID values!
					
					if tagName="plan" { // --- Process <plan>...</plan> Tag ---
						set planOut($i(planOut))="<plan>"
						CONTINUE
					}
					if tagName="cost" { // --- Process <cost ...> Tag ---
						set planOut($i(planOut))=padWS_"Cost: "_$$attributeVal(tagLine,"value")
						set planOut($i(planOut))=padWS
						CONTINUE
					}
					if tagName="stats" { // --- Process <stats>...</stats> Tag ---
						for { // --- Process All '%plan(pSub)' Nodes for <stats>... </stats> Properties/Elements ---
							set pSub=$o(%plan(pSub),1,pLine)
							QUIT:pSub'=+pSub  // No more 'pSub' values!
							QUIT:pLine["</stats>"  // Finished processing the <stats>...</stats> Tag!
							
							set statsProp=$p($p(pLine,"<",2)," ",1),statsVal=$p($p(pLine,">",2),"<",1)
							set stats(statsProp)=statsVal
						}
						
						CONTINUE:'modTop  // Skip all <stats>...</stats> if the associated 'module(...)' has the property (top='0')!
						
						set planOut($i(planOut))=padWS_"Stats: "
						set padWS=padWS_"  "  // Adjust the Padding WhiteSpaces (WS)!
						
						for statsProp="ModuleName","RowCount","TimeSpent","GlobalRefs","CommandsExecuted","DiskWait" { // --- Process Displayable Stats Properties ---
							set statsVal=$g(stats(statsProp)) 
							CONTINUE:(",ModuleName,RowCount,"[(","_statsProp_","))&&(stats("ModuleName")'="MAIN")  // Skip this property if not the 'MAIN' Module!
							
							set statsCaption=$CASE(statsProp,"ModuleName":"Module","RowCount":"Rows Returned","TimeSpent":"Performance","GlobalRefs":"Global Refs","CommandsExecuted":"Commands Exec","DiskWait":"Read Latency",:"")
							set statsVal=$s(statsProp="TimeSpent":$fn(statsVal,",",5),1:statsVal)
							set planOut($i(planOut))=padWS_statsCaption_":"_$j(" ",15-$l(statsCaption))_statsVal_$CASE(statsProp,"TimeSpent":" secs","DiskWait":" ms",:"")
						}
						set planOut($i(planOut))=padWS
						CONTINUE
					}
					if ",module,subquery,"[(","_tagName_",") { // --- Processing <module>/<subquery> Tag ---
						set moduleID=$LG($g(tag(tagInfo(tagName,"id"))),7)  // The ID value for the current 'module(moduleID)' array node!
 						set callInfoList=$LG($g(module(+moduleID,0)),13)    // A $LIST(...) of all <module>/<subquery> details that the current 'module' calls/invokes!
						for callPos=1:1:$LL(callInfoList) { // --- Process All Call module/subquery Elements (child tag) Invocations ---
							set callInfo=$LG(callInfoList,callPos)
							set callMod($LG(callInfo,1))=$LG(callInfo,2)    // Record the line 'pSub' for each Call module/subquery (child tag) call/invocation!
						}
					}
					
					set planOut($i(planOut))=padWS_tagHeader_":"
				}
				else { // --- Process 'End Tag' Line ---
					set:tagName'="module" planOut($i(planOut))=$s(tagName="plan":pLine,1:padWS)
				}
			}
			else { // --- Process '<tag>...</tag>' Body Line ---
				set planOut($i(planOut))=pLine
			}
		}
		else { // --- Process '<tag>...</tag>' Body Line ---
			set planOut($i(planOut))=$s($d(callMod(pSub)):$$swapCallerRefs(moduleID,modName,pLine,3),1:pLine)  // Swap <caller reference>s when appropriate!
		}
	}
	if $g(planOut),planOut(planOut)="" { kill planOut($i(planOut,-1)+1) }  // Remove Empty Last Node!
 }
 catch tException {
	set tSC=tException.AsStatus()
 }
	RETURN tSC
}
	
	#;---
	
///	This method accepts a <tag> line 'tagLine' and returns the value for the specified 
/// 'attribute', either as a numeric value or an un-quoted string value...
///
/// NOTE: To make this method as simple as possible, it assumes that there are no 
///       whitespaces within the 'tagLine' value between the 'attribute' name and
///       its value, given that all <tag> lines are generated by the 'planHTML(...)'
///       method:
///          GOOD:  <module name="FIRST">
///          BAD:   <module name = "FIRST">
///
/// PARAMETERS:
///   tagLine     - A line, typically from the '%plan(...)' array, which contains
///                 a <tag>...</tag> with attributes
///   attribute   - The name of the attribute within the <tag ...> contained in
///                 the 'tagLine' whose value will be returned
///
attributeVal(tagLine = "", attribute = "") [] PUBLIC {
	set attrVal=$p(tagLine,attribute_"=",2,*)
	
	RETURN:$e(attrVal,1)'="""" $p($p(attrVal," ",1),">",1)  // Numeric value!
	
	// --- Process "Quoted" 'attribute' Value ---
	for pos=2:1 { if $e(attrVal,pos)="""" { if $e(attrVal,pos+1)="""" { set pos=pos+1 } else { QUIT } } }
	
	RETURN $replace($e(attrVal,2,pos-1),"""""","""")  // Un-quoted string value!
}
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
#DEFINE pTextHTML(%text) $$$TextHTML(%text,"%Utility")
#DEFINE swapCallerRefsCheck(%line) ($f(%line," module ")||$f(%line,"subquery ")||$f(%line,"subqueries "))
#DEFINE planHTMLset(%section,%moduleID,%line) set:%createHTML %planHTML(0,%section,%moduleID,$i(%planHTML(0,%section,%moduleID)))=%line,%planHTML(9,$i(%planHTML(9)))=$LB(%section,%moduleID,%planHTML(0,%section,%moduleID))
#DEFINE calledMaxLevel 12
	
planHTML(&%plan,cssLinkHref = "/csp/sys/intersystems.css",frozenPlan = 0,minStats = 0, noStmtTxt = 0, calledBy = "", ph7 = "", display = 1, &%planHTML, &tag, &module)	; 
#IF 0   ;------------------------------------------------------------------------------
	; Given the SQL Plan details in the '%plan(...)' array, which is specified in the
	; traditional Linear Plan Format (LPF), either output the details as an HTML page
	; in a format specified by the 'display' parameter, or return SQL Plan information
	; in the PBR arrays [%planHTML(...), tag(...) & module(...)], which can be used by 
	; other methods for additional processing...
	;
	; NOTE-1: This method is now dual purpose, based on the value of the 'display'
	;         parameter.  It can either display the contents of the '%plan(...)'
	;         array in an HTML format, or it can return SQL Plan information in
	;         the aforementioned PBR arrays, such that further processing can be
	;         performed by other methods [MRP1430]
	;
	; NOTE-2: The '%plan' array is in the following format:
	;            %plan=# of lines from 1 to n
	;            %plan(#)=SQL Plan line
	;
	; RESTRICTION:  For this method to work correctly, the '%plan()' array must be
	;               created with the 'verbose' parameter equal to one (1) during the
	;               invocation of the 'nliz()' method, via one of the following
	;               interface method calls:
	;                  - ShowPlan^%apiSQL()
	;                  - ShowPlanAlt^%apiSQL()
	;                  - ShowPlanRtn^%apiSQL()
	;
	; PARAMETERS:
	;    %plan       - An array of the SQL Plan details specified in the traditional 
	;                  Linear Plan Format (LPF)
	;                  [See NOTE-2 from above]
	;    cssLinkHref - The 'href' value for the CSS <link> tag
	;    frozenPlan  - A flag to determine the following:                             [DEFAULT: 0]
	;                    0 = Don't use Frozen Query Plan
	;                    1 = Use Frozen Query Plan
	;                    x = ... Other Codes ...
	;    minStats    - A flag to determine which stats should be displayed:           [DEFAULT: 0]
	;                    0 = Display all of the <stats>..</stats> details
	;                    1 = Display only the generated <stats> that have one
	;                        or more of the following conditions:
	;                          - The associated 'module(...)' has the property
	;                            (top='1')
	;                          - The associated 'module(...)' is invoked by a
	;                            Calling module/subquery
	;                  NOTE: The value of this parameter only applies if <stats>
	;                        information is generated and present within the
	;                        '%plan(...)' array
	;                  [See the subsequent NOTE-2 from the 'display' parameter]
	;    noStmtTxt	 - A flag to determine if the SQL Statement shouldn't be shown    [DEFAULT: 0]
	;                    0 = Show the SQL Statement Text via the HTML Output
	;                    1 = Don't show the SQL Statement Text via the HTML Output
	;    calledBy    - The '[method^]routine' name (e.g. [ShowPlan^]%apiSQL) or the 
	;                  originating CSP/ZEN class (e.g. %CSP.UI.Portal.SQL.Home.zen)
	;                  (obtained from %request.CgiEnvs("HTTP_REFERER")) which
	;                  ultimately invoked this method
	;                  NOTE: This information may be used to size certain HTML
	;                        display tags/elements
	;    ph7         - Placeholder Parameter
	;    display     - A flag to determine how the PBR '%plan(...)' array should be
	;                  processed/displayed:
	;                    0 = Don't display anything from the '%plan(...)' array.
	;                        Typically, this value means this methods is being
	;                        invoked to retrieve the following Plan Information
	;                        PBR array parameters:
	;                           tag(...) & module(...)
	;                   .5 = This is an enhanced version of option zero (0), as
	;                        nothing will be displayed, but the following PBR
	;                        array will also be generated in addition to those
	;                        for option zero (0):
	;                           %planHTML(...)  
	;                    1 = Display the '%planHTML(...)' array, after it has been    [DEFAULT: 1]
	;                        generated from the '%plan(...)' array, with all module 
	;                        details in the traditional Linear Plan Format (LPF)
	;                    2 = Generate the '%planHTML(...)' array after processing
	;                        the '%plan(...)' array, and display all module
	;                        details in a new Inline Plan Format (IPF) by invoking
	;                        this method and passing this 'display' parameter the
	;                        'internal' value 2.5
	;                  2.5 = This is an 'internal' version of options (2 & .5) with
	;                        the following details:
	;                          - The '%plan(...)' array parameter has previously
	;                            been processed by this method with the 'display'
	;                            parameter passed the value 2
	;                          - The '%plan(...)' array parameter has previously
	;                            been processed by the 'makeIPF(...)' method to 
	;                            re-format it into an Inline Plan Format (IPF)
	;                          - The '%planHTML(...)' array will be generated for
	;                            this Passed By Reference (PBR) parameters
	;                          - Display the '%planHTML(...)' array that was
	;                            processed and generated from the '%plan(...)'
	;                            array, as specified by the previous steps
	;
	;                  NOTE-1: This parameter has a direct correlation to the
	;                          'verbose' parameter that is used in methods like
	;                          'ShowPlan(...)', 'ShowPlanAlt(...)', 'Explain(...)',
	;                          'nliz(...)', etc., and also a direct correlation to
	;                          the 'PlanFormat' property that is used in the following
	;                          CSP interface classes:
	;                             - %SQL.Manager.ShowPlan.CLS
	;                             - %CSP.UI.Portal.SQL.Home.CLS
	;                             - %CSP.UI.Portal.SQL.QButtons.RuntimeStats.CLS
	;                             - %CSP.UI.Portal.SQL.QButtons.ShowPlanOutput.CLS
	;                             - %CSP.UI.Portal.SQL.QButtons.RuntimeStatsDetails.CLS
	;                             - %CSP.UI.Portal.SQL.QButtons.ShowPlanAlt.CLS 
	;                  NOTE-2: Whenever this parameters is passed the value 2, the
	;                          value of the 'minStats' parameter will be set to the
	;                          value 1 and processed thusly
	;
	;    The following SQL Plan Information Arrays can be used by other methods
	;    for post-processing of the output from this method's invocation:
	;
	;    %planHTML   - A PBR array parameter of the HTML representation of the 
	;                  '%plan(...)' array
	;    tag         - A PBR array parameter of all 'tag' information used to process
	;                  the SQL Query Plan contained within the '%plan(...)' array
	;    module      - A PBR array parameter of all 'module' information used to process
	;                  the SQL Query Plan contained within the '%plan(...)' array
	;
	;    NOTE: For details about these information arrays, please see the 
	;          associated DevChange/JIRA: MRP1430/DP-440068
	;
	; RETURN Value: Status
	;
#ENDIF  ;------------------------------------------------------------------------------
	;
	if '$o(%plan(0)) { // --- No '%plan(...)' Array Specified ---
		set tSC=$$$ERROR($$$GeneralException,"No SQL Show Plan details were specified in the '%plan()' array!")
		RETURN tSC
	}
	
	new %objlasterror
	new callInfoList,char1WS,col,colVal,colorHEX,%createHTML,error,eTag,Hexcept,label,labTag,lastWSPos,modCurr,modName,modSub,modTitle,modTop,moduleID,peekAheadLine,planAlt,pLine,pLineOrig,pLinePrev,pos,pStr,pSub,qCost,section,skipStats,SQLCODE,sTag,sTagOffset,stats,statsProp,statsVal,subQName,subQTitle,subQTop,tagName,tagNameCurr,tagCurr,tSC
	new callerID,callerIDStart,levelOrig,lastWSPosOrig,padLen,padLenNew,padWS  // Used primarily when display=2.5
	
	kill %planHTML,tag,module set %planHTML(9)=0,tag=0,tag("stack")=0,tag("stack",0)="",module="",module("called")="",modCurr="",pLine=""  // Tabula Rasa!
	set %createHTML=$CASE(display,.5:1,1:1,2.5:1,:0)    // A flag to determine whether the '%planHTML(...)' array will be set during method invocation!
	set minStats=$CASE(display,2:1,2.5:1,:minStats)
	set:calledBy="" calledBy=$$$CallingRoutine          // Default to the calling routine if unspecified!
	
	set tSC=$$$OK,$ZE=""
	
 try {
	#; --- Convert each %plan line to HTML format & return text when string exceeds 5000 chars ---
	
	do:%createHTML addCSS(display)  // Add All Cascading Style Sheet (CSS) Definitions!
	
	set pSub=""
	for { // --- Process All '%plan(pSub)' Nodes ---
		set pLinePrev=pLine,pLine=""
		set pSub=$o(%plan(pSub),1,pLine)
		QUIT:pSub'=+pSub  // No more 'pSub' values!
		
		set pLineOrig=pLine  // Record the original unmodified line!
		if $o(%plan(pSub),1,peekAheadLine)  // Set next '%plan(...)' line into 'peekAheadLine' variable!
		if $LV(pLine) { GOTO Hlist }                        // --- Process PlanAlt Instance ---
		elseif $e($$$StripLeadingWhiteSpace(pLine),1)="<" { // --- Process Start/End Tag ---
			set pLine=$$$StripLeadingAndTrailingWhiteSpace(pLine)
			set sTag=$p($p($e(pLine,2,*)," "),">")
			if $e(sTag,1)'="/" { // --- Process 'Start' Tag ---
				set sTagOffset=$i(tag("cnt",sTag)),tag($i(tag))=$LB(sTag,sTagOffset,pSub,,$$tagParentChild(tag,pSub)),tag("x-tag",sTag,sTagOffset)=tag,tag("curr",sTag)=sTagOffset
				if $e(pLine,*-1,*)="/>" { set $LIST(tag(tag),4)=pSub,tag("curr",sTag)=$$tagCurrOffset(sTag,sTagOffset) } // Single-line tag!
				else { set tag("stack",$i(tag("stack")))=$LB(sTag) }
				set eTag=""
				set label="H",tagName=sTag,labTag=label_tagName
				TRY { GOTO @(labTag) }
				CATCH Hexcept { set labTag=label_"except" GOTO @labTag }
			}
			else { // --- Process 'End' Tag ---
				set eTag=$e(sTag,2,*)
				set tagCurr=$g(tag("x-tag",eTag,+$g(tag("curr",eTag))))
				set:tagCurr $LIST(tag(tagCurr),4)=pSub,tag("curr",eTag)=$$tagCurrOffset(eTag,+$g(tag("curr",eTag)))
				set tag("stack",tag("stack"))=""
				set sTag=$LG($g(tag("stack",$i(tag("stack"),-1))),1)  // Parent tag name!
				set label="T",tagName=eTag,labTag=label_tagName
				TRY { GOTO @labTag }
				CATCH Texcept { set labTag=label_"except" GOTO @labTag }
			}
		}
		elseif $e(pLinePrev,*-1,*)="/>" { set eTag=sTag,sTag=$LG($g(tag("stack",tag("stack"))),1) }
		
		if display=2.5 { // --- Special Settings When display=2.5 ---
			set $LG(,levelOrig,lastWSPosOrig,padLenNew)=%plan("info",pSub)
			set char1WS=lastWSPosOrig>0
			set lastWSPos=lastWSPosOrig+padLenNew
			set padLen=$s((",plan,module,subquery,"[(","_sTag_","))&&module("called"):$LG(module(modCurr,0),20)+lastWSPosOrig,1:lastWSPosOrig),padWS="",$p(padWS," ",padLen)=" "
		}
		else { // --- Determine WS [$c(32)] Information ---
			set char1WS=($e(pLine,1)=" ")
			for lastWSPos=0:1 { QUIT:$e(pLine,lastWSPos+1)'=" "  }
			set padLen=lastWSPos,padWS="",$p(padWS," ",padLen)=" "
		}
		
		set label="B",tagName=sTag,labTag=label_tagName
		TRY { GOTO @labTag }  // Process all code within <tag>...</tag>
		CATCH Bexcept { set labTag=label_"except" GOTO @labTag }
		
		#;----------------------------------------------------------------------
		#;                  COS Structure for Show Plan <tag>s
		#;----------------------------------------------------------------------
		#; Label        COS Code
		#; ----------   ------------------------------------------------------
		#; H<tagName>   // Header code to process for <tagName> line
		#; B<tagName>   // Body code to process between <tagName>...</tagName>
		#; T<tagName>   // Trailer code to process for </tagName> line
		#;
		#; NOTE:
		#;  Much of the processing for 'B<tagName>' data is based on the
		#;  original WS padding (padLen), so it's important to keep that
		#;  in mind if any changes are made to this code (for 'module' &
		#;  'subquery' especially).
		#;----------------------------------------------------------------------
		
		#;--- Tag: <planAlt $LB> ---
Hlist	// --- <planAlt $LB> Header Code ---
		set planAlt($i(planAlt),0)=pLine
		CONTINUE
		#;--- Tag: <plan> ---
Hplan	// --- <plan> Header Code ---
		do $i(module) // Bump 'module'!
		set modName="MAIN",modTop=1,modTitle="Plan"
		set module(module,0)=$LB(tagName,pSub,,$g(module("curr")),$i(module("level")),tag("stack"),tag,modName,modTop,module,%planHTML(9)+1),$LIST(tag("stack",tag("stack")),2)=module,(module("curr"),modCurr)=module  // Record information arrays and reset the current values for: module("curr") & modCurr
		$$$planHTMLset(labTag,modCurr,"<table id='query-plan-container' class='qp-query-plan-container'>")
		
		CONTINUE
Bplan	// --- <plan> ... </plan> Body Code ---
		set pLine=$$$HTMLENCODE(pLine)
		if $$$swapCallerRefsCheck(pLine) { // --- Process Call to module/subquery/etc. ---
			set pLine=$$swapCallerRefs(modCurr,modName,pLine,display,.callInfoList)
			do:callInfoList'="" recordCallInfo(labTag,modCurr,callInfoList,pSub,display,padLen)  // Record module/subquery Call Information!
		}
		
		$$$planHTMLset(labTag,modCurr,padWS_$s('char1WS:"&bull;&nbsp;",1:"")_$e(pLine,lastWSPos+1,*))
		CONTINUE
Tplan	// --- </plan> Trailer Code ---
		$$$planHTMLset(labTag,modCurr,"</td></tr>")
		$$$planHTMLset(labTag,modCurr,"</table>")
		
		set $LIST(module(modCurr,0),3)=pSub,$LIST(module(modCurr,0),12)=%planHTML(9),module("level")=$i(module("level"),-1),(module("curr"),modCurr)=+$LG($g(tag("stack",tag("stack"))),2),modName=$LG($g(module(+modCurr,0)),8),modTop=$LG($g(module(+modCurr,0)),9),modTitle="Plan"  // Record information arrays and reset the current values for: module("curr"), modCurr, modName, modTop & modTitle
		CONTINUE 
		
		#;--- Tag: <sql> ---
Hsql	// --- <sql> Header Code ---
		CONTINUE:noStmtTxt
		
		$$$planHTMLset(labTag,modCurr,"<tr class='qp-header qp-query-text-header'><td>"_$$$pTextHTML("Statement Text")_"</td></tr>")
		$$$planHTMLset(labTag,modCurr,"<tr><td class='qp-query-text-body'><pre>")
		CONTINUE
Bsql	// --- <sql> ... </sql> Body Code ---
		CONTINUE:noStmtTxt
		set pLine=$$$HTMLENCODE($s(char1WS:$e(pLine,2,*),1:$e(pLine,lastWSPos+1,*)))
		$$$planHTMLset(labTag,modCurr,pLine)
		CONTINUE
Tsql	// --- </sql> Trailer Code ---
		if 'noStmtTxt { $$$planHTMLset(labTag,modCurr,"</pre></td></tr>") }
		GOTO:"<warning<info"'[$p($p($$$StripLeadingWhiteSpace(peekAheadLine),">")," ") HplanDetail  // No following <warning> or <info> tag!
		CONTINUE
		
		#;--- Tag: <warning> ---
Hwarning	// --- <warning> Header Code ---
		$$$planHTMLset(labTag,modCurr,"<tr class='qp-header qp-query-warning-header'><td>"_$$$pTextHTML("Warning")_"</td></tr>")
		$$$planHTMLset(labTag,modCurr,"<tr><td class='qp-query-plan-container-body'>")
		CONTINUE
Bwarning	// --- <warning> ... </warning> Body Code ---
		set pLine=padWS_$s('char1WS:"&bull;&nbsp;",1:"")_$$$HTMLENCODE($e(pLine,lastWSPos+1,*))
		$$$planHTMLset(labTag,modCurr,pLine)
		CONTINUE
Twarning	// --- </warning> Trailer Code ---
		$$$planHTMLset(labTag,modCurr,"</td></tr>")
		GOTO:"<info"'[$p($p($$$StripLeadingWhiteSpace(peekAheadLine),">")," ") HplanDetail  // No following <info> tag!
		CONTINUE
		
		#;--- Tag: <info> ---
Hinfo	// --- <info> Header Code ---
		$$$planHTMLset(labTag,modCurr,"<tr class='qp-header qp-query-info-header'><td>"_$$$pTextHTML("Information")_"</td></tr>")
		$$$planHTMLset(labTag,modCurr,"<tr><td class='qp-query-plan-container-body'>")
		CONTINUE
Binfo	// --- <info> ... </info> Body Code ---
		set pLine=padWS_$s('char1WS:"&bull;&nbsp;",1:"")_$$$HTMLENCODE($e(pLine,lastWSPos+1,*))
		$$$planHTMLset(labTag,modCurr,pLine)
		CONTINUE
Tinfo	// --- </info> Trailer Code ---
		$$$planHTMLset(labTag,modCurr,"</td></tr>")
		GOTO HplanDetail
		
		#;--- Tag: <frozenPlan> ---
HfrozenPlan	// --- <frozenPlan> Header Code ---
		$$$planHTMLset(labTag,modCurr,"<div class='qp-frozen-plan'>"_"Frozen Plan"_"</div>")
		CONTINUE
		
		#;--- Tag: <cost> ---
Hcost	// --- <cost> Header Code ---
		set qCost=$tr($p($p(pLine,"value=",2),"/>",1),"""")
		set pStr=$$$pTextHTML("Relative Cost")_$s(+qCost>0:" = "_qCost,1:" "_$$$pTextHTML("Unavailable"))
		
		if +qCost>0 {$$$planHTMLset(labTag,modCurr,"<span class='qp-relative-cost'>"_pStr_"</span>") }
		else { $$$planHTMLset(labTag,modCurr,"<span class='qp-relative-cost-unavailable'>"_pStr_"</span>") }
		CONTINUE
		
		#;--- Virtual-Tag: <planDetail> ---
HplanDetail	// --- <planDetail> Header Code ---
		if $case(frozenPlan,0:1,3:1,:0) {
			$$$planHTMLset(labTag,modCurr,"<tr class='qp-header qp-query-plan-header'><td title='The Query Plan represents the total statistics collected for the OPEN, FIRST (fetch), and CLOSE modules.'>"_$$$pTextHTML("Query Plan")_"</td></tr>")
		}
		else {
			$$$planHTMLset(labTag,modCurr,"<tr class='qp-header qp-query-text-frozen-header'><td title='The Frozen Query Plan represents the total statistics collected for the OPEN, FIRST (fetch), and CLOSE modules.'>"_$$$pTextHTML("Frozen Query Plan")_"</td></tr>")
		}
		$$$planHTMLset(labTag,modCurr,"<tr><td class='qp-query-plan-container-body'>")
		CONTINUE
		
		#;--- Tag: <module> ---
Hmodule	// --- <module> Header Code ---
		do $i(module) // Bump 'module'!
		set modName=$p($p(pLine," name=",2),"""",2)
		set modTop=$p($p(pLine," top=",2),"""",2) set:modTop="" modTop=1
		set modTitle="Module"
		
		do recordModuleHeaderInfo(tagName,modName,modTop,pSub,display)
		
		if modTop { // --- Process 'module' with the attribute 'top=1' ---
			if 0&&($LG(module(modCurr,0),3)="")&&($LG(module(modCurr,0),9)=1) { // Close Implicit Modules
				$$$planHTMLset(labTag,modCurr,"</td></tr>")
			}
			
			if display=2.5 { // --- Process 'module' in the New Inline Plan Format (IPF) ---
 				set padLen=$LG(module(modCurr,0),20),padWS="",$p(padWS," ",padLen)=" "
 				set colorHEX=$ZHEX(240-((module("called")#$$$calledMaxLevel+$s(module("called")<$$$calledMaxLevel:-1,1:1))*10)),colorHEX=colorHEX_colorHEX_colorHEX
				set callerIDStart=tagName_modName_$s($LG(module(modCurr,0),14):"-"_$LG(module($LG(module(modCurr,0),14),0),8),1:"")
				set callerID=callerIDStart_$s($d(module("caller id counter",callerIDStart)):"-"_module("caller id counter",callerIDStart),1:"")
				$$$planHTMLset(labTag,modCurr,padWS_"<pre id='"_callerID_"' class='qp-query-plan-container-body' style='background-color: #"_colorHEX_";' title='"_$s(modCurr=1:"The FIRST module represents the total statistics collected for the FETCH module (which includes all nested module invoked from within this module), minus the OPEN &amp; CLOSE modules.",1:"The "_modName_" module represents the total statistics collected for this module (which includes all nested module invoked from whithin this module).")_"'>")
				$$$planHTMLset(labTag,modCurr,padWS_"<span name='"_(tagName_modName)_"' class='qp-header'>"_modTitle_"-"_modName_$s(modCurr=1:" (fetch)",1:"")_"</span>")
			}
			else { // --- Process 'module' in the Traditional Linear Plan Format (LPF) ---
				$$$planHTMLset(labTag,modCurr,"<tr class='qp-header qp-module-header'><td title='"_$s(modCurr=1:"The FIRST module represents the total statistics collected for the FETCH module (which includes all nested module invoked from within this module), minus the OPEN &amp; CLOSE modules.",1:"The "_modName_" module represents the total statistics collected for this module (which includes all nested module invoked from whithin this module).")_"'><a class='modlink' name='"_(tagName_modName)_"'>"_modTitle_"-"_modName_$s(modCurr=1:" (fetch)",1:"")_"</a></td></tr>")
				$$$planHTMLset(labTag,modCurr,"<tr><td class='qp-query-plan-container-body'>")
			}
		}
		
		CONTINUE
Bmodule	// --- <module> ... </module> Body Code ---
		set pLine=$$$HTMLENCODE(pLine)
		if $$$swapCallerRefsCheck(pLine) { // --- Process Call to module/subquery/etc. ---
			set pLine=$$swapCallerRefs(modCurr,modName,pLine,display,.callInfoList)
			do:callInfoList'="" recordCallInfo(labTag,modCurr,callInfoList,pSub,display,padLen)  // Record module/subquery Call Information!
		}
		
		if 'char1WS { // --- Display Bullet Lines ---
			$$$planHTMLset(labTag,modCurr,padWS_"&bull;&nbsp;"_$e(pLine,lastWSPos+1,*))
			
			set:$i(module(modCurr,"bullets")) module("action")="bullets"  // Count the number of bullet-item lines per 'module'
		}
		else {	// --- Display Indented Lines ---
			$$$planHTMLset(labTag,modCurr,padWS_$s($e(pLine,lastWSPos+1)?1U:$case($s(display=2.5:$LG(%plan("info",pSub),3),1:padLen)/4#2,0:"&middot;",1:"-",:"-")_"&nbsp;",1:"")_$e(pLine,lastWSPos+1,*))
		}
		CONTINUE
Tmodule	// --- </module> Trailer Code ---
		
		if $LG(module(modCurr,0),9)=1 { //--- Process 'module' with the attribute 'top=1' ---
			if display=2.5 { // --- Process 'module' in the New Inline Plan Format (IPF) ---
 				set padLen=$LG(module(modCurr,0),20),padWS="",$p(padWS," ",padLen)=" "
				$$$planHTMLset(labTag,modCurr,padWS_"</pre>")
			}
			else { // --- Process 'module' in the Traditional Linear Plan Format (LPF) ---
				$$$planHTMLset(labTag,modCurr,padWS_"</pre>")
			}
		}
		
		// --- Record <module> Trailer Information into 'module(...)' ---
		set $LIST(module(modCurr,0),3)=pSub,$LIST(module(modCurr,0),12)=%planHTML(9),module("level")=$i(module("level"),-1)
		if $LG(module(modCurr,0),14) { // --- Pop 'Call' Stacks ---
			kill module("caller",tagName,modName,$i(module("caller",tagName,modName),-1)+1)
			kill:'module("caller",tagName,modName) module("caller",tagName,modName)
			kill module("called",$i(module("called"),-1)+1)
		}
		set (module("curr"),modCurr)=$LG(tag("stack",tag("stack")),2),tagNameCurr=$LG(module(modCurr,0),1)
		if tagNameCurr="module" { // --- Record information arrays and reset the current values for: module("curr"), modCurr, modName, modTop & modTitle ---
			set modName=$LG(module(modCurr,0),8),modTop=$LG(module(modCurr,0),9),modTitle="Module"
		}
		elseif tagNameCurr="subquery" { // --- Record information arrays and reset the current values for: module("curr"), modCurr, subQName, subQTop & subQTitle ---
			set subQName=$LG(module(modCurr,0),8),subQTop=$LG(module(modCurr,0),9),subQTitle="Subquery"
		}
		CONTINUE
		
		#;--- Tag: <stats> ---
Hstats	// --- <stats> Header Code ---
		set skipStats=$s(minStats:$s(modCurr<3:0,$LG(module(modCurr,0),9):0,$LG(module(modCurr,0),14)'="":0,$d(module("x-callName",$CASE($LG(module(modCurr,0),1),"module":"subquery",:"module"),$LG(module(modCurr,0),8))):0,1:1),1:0)
		GOTO:skipStats Bstats
		
		if $g(module(modCurr,"stats"))&&((pSub-$LG(module(modCurr,"stats",module(modCurr,"stats"),0),2))>1) { $$$planHTMLset(labTag,modCurr,"<hr style='border-style: hidden; border-width: 1px; margin: 0 0 0 0;'/>") }
		elseif $g(module("action"))="bullets" { $$$planHTMLset(labTag,modCurr,"<hr style='border-style: hidden; border-width: 1px; margin: 0 0 0 0;'/>") }
		
		$$$planHTMLset(labTag,modCurr,"<table class='qp-query-stats'"_$s(display=2.5:" style='width: "_$s(calledBy["%CSP.UI.Portal.SQL.QButtons.ShowPlanAlt":"80%",1:"45%")_"; margin-left: "_$s(modCurr<3:0,1:($LG(module(modCurr,0),20)*3.5))_"px;",1:"")_">")
		$$$planHTMLset(labTag,modCurr,"<tr class='qp-query-stats-header'>")
		$$$planHTMLset(labTag,modCurr,"<td title='Sections of the SQL statement used to distinguish blocks of code within the SQL generated COS code.'>Module</td>")
		$$$planHTMLset(labTag,modCurr,"<td title='The number or rows returned by the given module of the SQL query.'>Rows Returned</td>")
		$$$planHTMLset(labTag,modCurr,"<td title='The number of seconds spent in the given module.&#13;Time represents the cumulative value for this module and all nested modules..'>Performance (secs)</td>")
		$$$planHTMLset(labTag,modCurr,"<td title='The number of globals referenced within the given module.&#13;Count represents the cumulative value for this module and all nested modules..'>Global Refs</td>")
		$$$planHTMLset(labTag,modCurr,"<td title='The number of Object Script command executed within the given module.&#13;Count represents the cumulative value for this module and all nested modules..'>Commands Exec</td>")
		$$$planHTMLset(labTag,modCurr,"<td title='The number of milliseconds spent waiting for Disk Reads in the given module.&#13;Time represents the cumulative value for this module and all nested modules.'>Read Latency (ms)</td>")
		$$$planHTMLset(labTag,modCurr,"</tr>")
		$$$planHTMLset(labTag,modCurr,"<tr>")
		
		kill stats
		set module(modCurr,"stats",$i(module(modCurr,"stats")),0)=$LB(pSub)
Bstats	// --- <stats> ... </stats> Body Code ---
		for { // --- Process All Stats Properties/Elements ---
			set pLinePrev=pLine,pLine=""
			set pSub=$o(%plan(pSub),1,pLine)
			QUIT:(pLine["</stats>")||(pSub'=+pSub)
			
			set statsProp=$p($p(pLine,"<",2)," ",1),statsVal=$p($p(pLine,">",2),"<",1)
			set stats(statsProp)=statsVal
		}
		set:pLine["</stats>" pSub=$o(%plan(pSub),-1),pLine=pLinePrev
		CONTINUE
Tstats	// --- </stats> Trailer Code ---
		if skipStats { kill skipStats,stats CONTINUE }  // Skip <stats>...</stats> Processing!
		
		for col="ModuleName","RowCount","TimeSpent","GlobalRefs","CommandsExecuted","DiskWait" { 
			set colVal=$g(stats(col)) 
			if (col="RowCount")&&(stats("ModuleName")'="MAIN") { set colVal="" }  // Only display for MAIN Module!
			$$$planHTMLset(labTag,modCurr,"<td>"_colVal_"</td>") 
		}
		$$$planHTMLset(labTag,modCurr,"</tr>")
		$$$planHTMLset(labTag,modCurr,"</table>")
		
		set $LIST(module(modCurr,"stats",module(modCurr,"stats"),0),2)=pSub
		set module("action")="stats"
		CONTINUE
		
		#;--- Tag: <nostats> ---
Hnostats	// --- <nostats> Header Code ---
		$$$planHTMLset(labTag,modCurr,"<div class='qp-stats-unavailable'>")
		$$$planHTMLset(labTag,modCurr,"NOTE:")
		CONTINUE
Bnostats	// --- <nostats> ... </nostats> Body Code ---
		set pLine=$$$HTMLENCODE(pLine)
		
		$$$planHTMLset(labTag,modCurr,padWS_$s('char1WS:"&bull;&nbsp;",1:"")_$e(pLine,lastWSPos+1,*))
		CONTINUE
Tnostats	// --- </nostats> Trailer Code ---
		$$$planHTMLset(labTag,modCurr,"</div>")
		CONTINUE
		
		
		#;--- Tag: <subquery> ---
Hsubquery	// --- <subquery> Header Code ---
		do $i(module) // Bump 'module'!
		if 0&&($LG(module(module,0),3)="")&&($LG(module(module,0),9)=1) {   // Close Implicit Modules
			$$$planHTMLset(labTag,module,"</td></tr>") 
		}
		
		set subQName=$p($p(pLine," name=",2),"""",2)
		set subQTop=$p($p(pLine," top=",2),"""",2) set:subQTop="" subQTop=1
		set subQTitle="Subquery"
		
		do recordModuleHeaderInfo(tagName,subQName,subQTop,pSub,display)
		
		if display=2.5 { // --- Process 'subquery' in the New Inline Plan Format (IPF) ---
			set padLen=$LG(module(modCurr,0),20),padWS="",$p(padWS," ",padLen)=" "
 			set colorHEX=$ZHEX(240-((module("called")#$$$calledMaxLevel+$s(module("called")<$$$calledMaxLevel:-1,1:1))*10)),colorHEX=colorHEX_colorHEX_colorHEX
			set callerIDStart=tagName_subQName_$s($LG(module(modCurr,0),14):"-"_$LG(module($LG(module(modCurr,0),14),0),8),1:"")
			set callerID=callerIDStart_$s($d(module("caller id counter",callerIDStart)):"-"_module("caller id counter",callerIDStart),1:"")
			$$$planHTMLset(labTag,modCurr,padWS_"<pre id='"_callerID_"' class='qp-query-plan-container-body' style='background-color: #"_colorHEX_";' title='"_"The "_subQName_" subquery module represents the total statistics collected for this module (which includes all nested module invoked from whithin this module)."_"'>")
			$$$planHTMLset(labTag,modCurr,padWS_"<span name='"_(tagName_subQName)_"' class='qp-header'>"_subQTitle_"-"_subQName_$s(modCurr=1:" (fetch)",1:"")_"</span>")
		}
		else { // --- Process 'subquery' in the Traditional Linear Plan Format (LPF) ---
			$$$planHTMLset(labTag,modCurr,"<tr class='qp-header qp-subquery-header'><td><a class='modlink' name='"_(tagName_subQName)_"'>"_subQTitle_"-"_subQName_"</a></td></tr>")
			$$$planHTMLset(labTag,modCurr,"<tr><td class='qp-query-plan-container-body'>")
		}
		
		CONTINUE
Bsubquery	// --- <subquery> ... </subquery> Body Code ---
		set pLine=$$$HTMLENCODE(pLine)
		if $$$swapCallerRefsCheck(pLine) { // --- Process Call to module/subquery/etc. ---
			set pLine=$$swapCallerRefs(modCurr,subQName,pLine,display,.callInfoList)
			do:callInfoList'="" recordCallInfo(labTag,modCurr,callInfoList,pSub,display,padLen)  // Record module/subquery Call Information!
		}
		
		if 'char1WS { // --- Display Bullet Lines ---
			$$$planHTMLset(labTag,modCurr,"&bull;&nbsp;"_pLine)
			
			set:$i(module(modCurr,"bullets")) module("action")="bullets"  // Count the number of bullet-item lines per 'module'
		}
		else { // --- Display Indented Lines ---
			$$$planHTMLset(labTag,modCurr,padWS_$s($e(pLine,lastWSPos+1)?1U:$case($s(display=2.5:$LG(%plan("info",pSub),3),1:padLen)/4#2,0:"&middot;",1:"-",:"-")_"&nbsp;",1:"")_$e(pLine,lastWSPos+1,*))
		}
		CONTINUE
Tsubquery	// --- </subquery> Trailer Code ---
		
		if $LG(module(modCurr,0),9)=1 { //--- Process 'subquery' with the attribute 'top=1' ---
			if display=2.5 { // --- Process 'subquery' in the New Inline Plan Format (IPF) ---
 				set padLen=$LG(module(modCurr,0),20),padWS="",$p(padWS," ",padLen)=" "
				$$$planHTMLset(labTag,modCurr,padWS_"</pre>")
			}
			else { // --- Process 'subquery' in the Traditional Linear Plan Format (LPF) ---
				$$$planHTMLset(labTag,modCurr,"</td></tr>")
			}
		}
		
		// --- Record <subquery> Trailer Information into 'module(...)' ---
		set $LIST(module(modCurr,0),3)=pSub,$LIST(module(modCurr,0),12)=%planHTML(9),module("level")=$i(module("level"),-1)
		if $LG(module(modCurr,0),14) { // --- Pop 'Call' Stacks ---
			kill module("caller",tagName,subQName,$i(module("caller",tagName,subQName),-1)+1)
			kill:'module("caller",tagName,subQName) module("caller",tagName,subQName)
			kill module("called",$i(module("called"),-1)+1)
		}
		set (module("curr"),modCurr)=$LG(tag("stack",tag("stack")),2),tagNameCurr=$LG(module(modCurr,0),1)
		if tagNameCurr="module" { // --- Record information arrays and reset the current values for: module("curr"), modCurr, modName, modTop & modTitle ---
			set modName=$LG(module(modCurr,0),8),modTop=$LG(module(modCurr,0),9),modTitle="Module"
		}
		elseif tagNameCurr="subquery" { // --- Record information arrays and reset the current values for: module("curr"), modCurr, subQName, subQTop & subQTitle ---
			set subQName=$LG(module(modCurr,0),8),subQTop=$LG(module(modCurr,0),9),subQTitle="Subquery"
		}
		CONTINUE
		
		#;--- Tag: <expression> ---
Hexpression	// --- <expression> Header Code ---
		CONTINUE
Bexpression	// --- <expression> ... </expression> Body Code ---
		set pLine=$$$HTMLENCODE(pLine)
		
		$$$planHTMLset(labTag,modCurr,padWS_$s('char1WS:"&bull;&nbsp;",1:"")_$e(pLine,lastWSPos+1,*))
		CONTINUE
Texpression	// --- </expression> Trailer Code ---
		CONTINUE
		
		#;--- Tag: <value> ---
Hvalue	// --- <value> Header Code ---
		CONTINUE
Bvalue	// --- <value> ... </value> Body Code ---
		set pLine=$$$HTMLENCODE(pLine)
		
		$$$planHTMLset(labTag,modCurr,padWS_$s('char1WS:"&bull;&nbsp;",1:"")_$e(pLine,lastWSPos+1,*))
		CONTINUE
Tvalue	// --- </value> Trailer Code ---
		CONTINUE
		
		#;--- Tag: <error> ---
Herror	// --- <error> Header Code ---
		$$$planHTMLset(labTag,modCurr,"<div class='qp-general-error'>")
		$$$planHTMLset(labTag,modCurr,$$$pTextHTML("Error:"))
		CONTINUE
Berror	// --- <error> ... </error> Body Code ---
		set pLine=$$$HTMLENCODE(pLine)
		
		$$$planHTMLset(labTag,modCurr,"<br/>"_padWS_$s('char1WS:"&nbsp;&nbsp;&bull;&nbsp;",1:"")_$e(pLine,lastWSPos+1,*))
		CONTINUE
Terror	// --- </error> Trailer Code ---
		$$$planHTMLset(labTag,modCurr,"</div>")
		CONTINUE
		
		#;--- TRY/CATCH {H|B|T}except ---
Hexcept	// --- Header <tag> Exception ---
Bexcept	// --- Body <tag> Exception ---
Texcept	// --- Trailer <tag> Exception ---
		set SQLCODE=$$$ERRORCODE($$$GeneralException)
		set error="SQL Show Plan tag '&lt;"_labTag_"&gt;' is not defined!"
		
		if 'modCurr { $$$planHTMLset(labTag,modCurr,"<table class='qp-query-plan-container'>") } 
		else { $$$planHTMLset(labTag,modCurr,"</td></tr>") }
		$$$planHTMLset(labTag,modCurr,"<tr class='qp-header qp-error-header'><td>"_$$$pTextHTML("Error")_"</td></tr>")
		$$$planHTMLset(labTag,modCurr,"<tr><td><div class='qp-error-body'>")
		$$$planHTMLset(labTag,modCurr,"ERROR #"_SQLCODE_": General exception: '"_error_"' Code '%2' Data '%3' ["_label_"except^%qaqplan:"_$NAMESPACE_"]")
		$$$planHTMLset(labTag,modCurr,"</div></td></tr>")
		$$$planHTMLset(labTag,modCurr,"</table>")
		
		RETURN $$$ERROR($$$GeneralException,error)
	
	} //end: from-loop
 }
 catch {
		do BACK^%ETN  // Record error in the Error Trap!
		
		if 'modCurr { $$$planHTMLset(labTag,modCurr,"<table class='qp-query-plan-container'>") } 
		else { $$$planHTMLset(labTag,modCurr,"</td></tr>") }
		$$$planHTMLset(labTag,modCurr,"<tr class='qp-header qp-error-header'><td>"_$$$pTextHTML("Error")_"</td></tr>")
		$$$planHTMLset(labTag,modCurr,"<tr><td><div class='qp-error-body'>")
		$$$planHTMLset(labTag,modCurr,"ERROR #"_$$$ERRORCODE($$$GeneralError)_": General error: $ZE='"_$ZE_"' ["_$ZN_":"_$NAMESPACE_"]")
		$$$planHTMLset(labTag,modCurr,"</div></td></tr>")
		$$$planHTMLset(labTag,modCurr,"</table>")
		
		set tSC=$$$ERROR($$$GeneralError,$ZE)
 }
	
postProc	// --- Post Processing ---
	
	kill:'%createHTML %planHTML  // Remove artifacts!
	if display=1 { // --- Display the '%plan(...)' array in the traditional Linear Plan Format (LPF) ---
		for pSub=1:1:$g(%planHTML(9)) { // --- Display all processed '%plan(...)' array lines via the '%planHTML(...)' array ---
			set $LG(section,moduleID,modSub)=%planHTML(9,pSub)
			write %planHTML(0,section,moduleID,modSub),!
		}
	}
	elseif display=2 { // --- Generate & Display the '%plan(...)' array in Inline Plan Format (IPF) ---
		new planOut
		
		// --- Generate the 'planOut(...)' array in Inline Plan Format (IPF) ---
		do makeIPF(1,0,.%plan,.tag,.module,.planOut)
		
		// --- Remove & replace the '%plan(...)' array in Linear Plan Format (LPF) with 'planOut(...)' array in Inline Plan Format (IPF) ---
		kill %plan
		merge %plan=planOut
		
		// --- Generate All Plan Information Arrays & Display the '%plan(...)' array in Inline Plan Format (IPF) ---
		set tSC=$$planHTML^%qaqplan(.%plan,cssLinkHref,frozenPlan,minStats,noStmtTxt,calledBy,,2.5,.%planHTML) //$$$THROWONERROR(tSC,tSC)  [MRP: Don't THROW so we can report the error within the '%plan(...)' array]
		
		// --- Retain and Remove Processing Information ---
		merge tag("plan","info")=%plan("info")  // Retains this information for future processing!
		kill %plan("info")  // Remove "info" node that is used for processing!
	}
	elseif display=2.5 { // --- Display the '%plan(...)' array in Inline Plan Format (IPF) ---
		for pSub=1:1:$g(%planHTML(9)) { // --- Display all processed '%plan(...)' array lines via the '%planHTML(...)' array ---
			set $LG(section,moduleID,modSub)=%planHTML(9,pSub)
			write %planHTML(0,section,moduleID,modSub),!
		}
	}
	RETURN tSC
	
