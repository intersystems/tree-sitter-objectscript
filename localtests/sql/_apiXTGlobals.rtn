====
apiXTGlobals
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%apiXTGlobals^MAC^^^0
 /* %apiXTGlobals - COS portion of implementation of eXTreme Globals Internal API
  *
  * Internal state globals used by the eXTreme Globals Internal API have names beginning with
  * ^ISC.XTG or ^IRIS.Temp.XTG.  To preserve encapsulation of the eXTreme Globals Internal API,
  * these globals should be accessed and modified only by functions in %apiXTGlobals, or by C++ methods
  * that are part of the JNI implementation of the eXTreme Globals Internal API.
  */
#include %occInclude
#define XTGStateRangesSubscript "ranges"
#define TEMPXTGState ^IRIS.Temp.XTG.State
#define XTGState ^IRIS.XTG.State
#define TestUSERAccess ^IRIS.XTG.TestUSERAccess
#define XTGStateNS(%namespace) ^[%namespace]IRIS.XTG.State
#define XTGRemoteJob ^ISC.XTG.RemoteJob
#define EVENTSubscript $NAMESPACE,classname
#define NUMREMOTEJOBQUEUES 5
 
startIndexing(className) public {
	s cacheClassName=$$$NormalizeClassname(className)
	if ('$$hasIndexes($g(cacheClassName))) {
		q ""
	}
	s ecpMode=$$getECPMode($$getClassGlobalName(cacheClassName))
 	q $$startIndexingInternal(cacheClassName,ecpMode,ecpMode)
 }
 
startIndexingInternal(classname,ecpMode=0,serverSideIndexing=1) {
 	if $g(classname)=0 quit ""
 	s ii=0
 	s finished=0
 	s jobQNumber=1
 	if ecpMode=0 s serverSideIndexing=0
 	do {
		lock +($$$TEMPXTGState($$$EVENTSubscript,"runState"))
		s state = $g($$$TEMPXTGState($$$EVENTSubscript,"runState"))
		if (state="")
		{
			s $$$TEMPXTGState($$$EVENTSubscript,"runState") = "starting"
			s jobQNumber = $$getJobQNumber(ecpMode,.serverSideIndexing)
			job UpdateClassIndex(classname,ecpMode,serverSideIndexing,jobQNumber)
		}
		elseif (state = "stopping") || (state = "running")
		{
			// Verify job is really alive
			if ($d(^$job($g($$$TEMPXTGState($$$EVENTSubscript,"pid"))))=0)
			{
				k $$$TEMPXTGState($$$EVENTSubscript,"pid")
				s $$$TEMPXTGState($$$EVENTSubscript,"runState") = "starting"
				s jobQNumber = $$getJobQNumber(ecpMode,.serverSideIndexing)
				job UpdateClassIndex($$$EVENTSubscript,ecpMode,serverSideIndexing,jobQNumber)
			}
			elseif (state = "stopping")
			{
				s $$$TEMPXTGState($$$EVENTSubscript,"runState") = "running"
			}
		}
		lock -($$$TEMPXTGState($$$EVENTSubscript,"runState")#"I")
        if (state = "starting")
        {
			h .05
			s ii=ii+1
        }
        else
        {
	    	s finished=1
        }           
 	} while ((ii<1000)&&(finished=0))
 	if finished=1
 	{
		quit "" 
 	}
 	else 
 	{
	 	quit "timeout"
 	}
}
getJobQNumber(ecpMode,serverSideIndexing) {
	s jobQNumber=1
 	if (ecpMode>0 && serverSideIndexing>0) {
		if ($d($$$XTGRemoteJob("DisableServerSideIndexing"))) {
			s serverSideIndexing=0
		}
		else {
			lock +($$$XTGRemoteJob("JobQNumber"))
			if ($i($$$XTGRemoteJob("JobQNumber"))>$$$NUMREMOTEJOBQUEUES) {
				s $$$XTGRemoteJob("JobQNumber")=1
			}
			s jobQNumber = $$$XTGRemoteJob("JobQNumber")
			lock -($$$XTGRemoteJob("JobQNumber")#"I")
        }
 	}
 	q jobQNumber
}
remoteIndexingJob1() public {
	s appServerName=$$$XTGRemoteJob(1,"AppServerName")
	s classname=$$$XTGRemoteJob(1,"ClassName")
	zn $$$XTGRemoteJob(1,"Namespace")
	s id1=$$$XTGRemoteJob(1,"LowID")
	s id2=$$$XTGRemoteJob(1,"HighID")
	s $$$XTGRemoteJob(1,appServerName)="running"
	d $zobjclassmethod(classname,"%SaveIndices",id1,id2)
	s $$$XTGRemoteJob(1,appServerName)="finished"
}
remoteIndexingJob2() public {
	s appServerName=$$$XTGRemoteJob(2,"AppServerName")
	s classname=$$$XTGRemoteJob(2,"ClassName")
	zn $$$XTGRemoteJob(2,"Namespace")
	s id1=$$$XTGRemoteJob(2,"LowID")
	s id2=$$$XTGRemoteJob(2,"HighID")
	s $$$XTGRemoteJob(2,appServerName)="running"
	d $zobjclassmethod(classname,"%SaveIndices",id1,id2)
	s $$$XTGRemoteJob(2,appServerName)="finished"
}
remoteIndexingJob3() public {
	s appServerName=$$$XTGRemoteJob(3,"AppServerName")
	s classname=$$$XTGRemoteJob(3,"ClassName")
	zn $$$XTGRemoteJob(3,"Namespace")
	s id1=$$$XTGRemoteJob(3,"LowID")
	s id2=$$$XTGRemoteJob(3,"HighID")
	s $$$XTGRemoteJob(3,appServerName)="running"
	d $zobjclassmethod(classname,"%SaveIndices",id1,id2)
	s $$$XTGRemoteJob(3,appServerName)="finished"
}
remoteIndexingJob4() public {
	s appServerName=$$$XTGRemoteJob(4,"AppServerName")
	s classname=$$$XTGRemoteJob(4,"ClassName")
	zn $$$XTGRemoteJob(4,"Namespace")
	s id1=$$$XTGRemoteJob(4,"LowID")
	s id2=$$$XTGRemoteJob(4,"HighID")
	s $$$XTGRemoteJob(4,appServerName)="running"
	d $zobjclassmethod(classname,"%SaveIndices",id1,id2)
	s $$$XTGRemoteJob(4,appServerName)="finished"
}
remoteIndexingJob5() public {
	s appServerName=$$$XTGRemoteJob(5,"AppServerName")
	s classname=$$$XTGRemoteJob(5,"ClassName")
	zn $$$XTGRemoteJob(5,"Namespace")
	s id1=$$$XTGRemoteJob(5,"LowID")
	s id2=$$$XTGRemoteJob(5,"HighID")
	s $$$XTGRemoteJob(5,appServerName)="running"
	d $zobjclassmethod(classname,"%SaveIndices",id1,id2)
	s $$$XTGRemoteJob(5,appServerName)="finished"
}
UpdateClassIndex(classname,ecpMode=0,serverSideIndexing=1,jobQNumber=1) public {
	s dataloc=$$getClassGlobalName^%SYS.LCBINDSRV(classname)
	lock +($$$TEMPXTGState($$$EVENTSubscript,"runState"))
	if $g($$$TEMPXTGState($$$EVENTSubscript,"runState"))="stopping"
	{
		k $$$TEMPXTGState($$$EVENTSubscript,"runState")
		k $$$TEMPXTGState($$$EVENTSubscript,"pid")
		lock -($$$TEMPXTGState($$$EVENTSubscript,"runState")#"I")
		quit
	}
	else 
	{
		s $$$TEMPXTGState($$$EVENTSubscript,"runState")="running"
		s $$$TEMPXTGState($$$EVENTSubscript,"pid")=$job
		lock -($$$TEMPXTGState($$$EVENTSubscript,"runState")#"I")
	}
	
	// classname is a complete classname
	s stopRequested=0
	s counterSubscript=$namespace_"^"_$extract(dataloc,2,*)
loop 
	if (ecpMode=1)
	{
		lock +($$$XTGState(counterSubscript))
		s id1=+$g($$$XTGState($$$EVENTSubscript,"curId"))
		if $g(prevRangeFloor)
		{
			s rangeSubscript=$order($$$XTGState(counterSubscript,$$$XTGStateRangesSubscript,prevRangeFloor),
			   			        1)
		}
		elseif $g(id1)
		{
			s rangeSubscript=$order($$$XTGState(counterSubscript,$$$XTGStateRangesSubscript,id1+1),
			   			        -1)
		}
		else
		{
			s rangeSubscript=$order($$$XTGState(counterSubscript,$$$XTGStateRangesSubscript,""),
			   			        1)
		}
		if rangeSubscript=""
		{
			s id2=$g($$$XTGState(counterSubscript))
			k prevRangeFloor
		}
		else
		{
			if id1<rangeSubscript s id1=rangeSubscript
			s id2=$g($$$XTGState(counterSubscript,$$$XTGStateRangesSubscript,rangeSubscript))
			if id2
			{
				s prevRangeFloor=rangeSubscript
			}
			else
			{
				s id2=$g($$$XTGState(counterSubscript))
				k prevRangeFloor
			}
		}
		lock -($$$XTGState(counterSubscript)#"I")
	}
	else
	{	
		s id1=+$g($$$XTGState($$$EVENTSubscript,"curId"))
		s id2=$g(@dataloc)
	}
	while((id2>0)&&('$d(@dataloc@(id2)))) {
		s id2=id2-1
	}
	s delta=id2-id1
	if ((delta>=0)&&(id2>0))
	{
		if (serverSideIndexing > 0)
		{
			lock +($$$XTGRemoteJob(jobQNumber))
			s appServerName = $zu(131,1)
			s $$$XTGRemoteJob(jobQNumber,"AppServerName")=appServerName
			s $$$XTGRemoteJob(jobQNumber,"ClassName")=classname
			s $$$XTGRemoteJob(jobQNumber,"Namespace")=$NAMESPACE
			s $$$XTGRemoteJob(jobQNumber,"LowID")=id1
			s $$$XTGRemoteJob(jobQNumber,"HighID")=id2
			if (jobQNumber=1) { job remoteIndexingJob1^%apiXTGlobals[$NAMESPACE] }
			elseif (jobQNumber=2) { job remoteIndexingJob2^%apiXTGlobals[$NAMESPACE] }
			elseif (jobQNumber=3) { job remoteIndexingJob3^%apiXTGlobals[$NAMESPACE] }
			elseif (jobQNumber=4) { job remoteIndexingJob4^%apiXTGlobals[$NAMESPACE] }
			elseif (jobQNumber=5) { job remoteIndexingJob5^%apiXTGlobals[$NAMESPACE] }
			while ('$d($$$XTGRemoteJob(jobQNumber,appServerName))) {
				h .01
			}
			lock -($$$XTGRemoteJob(jobQNumber))
			while ($g($$$XTGRemoteJob(jobQNumber,appServerName))'="finished") {
				h .05
			}
			k $$$XTGRemoteJob(jobQNumber,appServerName)
		}
		else
		{
			d $zobjclassmethod(classname,"%SaveIndices",id1,id2)
		}
		lock +($$$XTGState($$$EVENTSubscript,"curId"))
		s $$$XTGState($$$EVENTSubscript,"curId")=id2+1
		lock -($$$XTGState($$$EVENTSubscript,"curId")#"I")
	}
	lock +($$$TEMPXTGState($$$EVENTSubscript,"runState"))
	i $g($$$TEMPXTGState($$$EVENTSubscript,"runState"))="stopping"
	{
		if ('stopRequested)
		{
			// Make an extra pass to ensure that any inserts made by the job that
			// requested us to stop have been indexed.  If multiple ranges are waiting to be 
			// indexed, make enough passes to index them all before stopping
			if ($g(prevRangeFloor)="")
			{
				s stopRequested=1
			}
		}
		else
		{
			k $$$TEMPXTGState($$$EVENTSubscript,"runState")
			k $$$TEMPXTGState($$$EVENTSubscript,"pid")
			lock -($$$TEMPXTGState($$$EVENTSubscript,"runState")#"I")
			quit
		}
	}
	lock -($$$TEMPXTGState($$$EVENTSubscript,"runState")#"I")
	i ((delta>1000)||$g(prevRangeFloor)) g loop
	h .1
	g loop
 }
stopIndexing(classname) public{
 
	i $g(classname)="" quit ""
	s ii=0
	s finished=0
 	do {
		lock +($$$TEMPXTGState($$$EVENTSubscript,"runState"))
		s state=$g($$$TEMPXTGState($$$EVENTSubscript,"runState"))
		if (state="running")
		{ 
			s $$$TEMPXTGState($$$EVENTSubscript,"runState")="stopping"
		}
		lock -($$$TEMPXTGState($$$EVENTSubscript,"runState")#"I")
		if (state = "starting")
        {
			h .05
			s ii=ii+1
        }
        else
        {
	    	s finished=1
        }
	} while ((ii<1000)&&(finished=0))
 	if finished=1
 	{
		quit "" 
 	}
 	else 
 	{
	 	quit "timeout"
 	}
}
 
hasIndexes(cacheClassName) {
	s indexList=$$GetIndexList^%SYS.LCBINDSRV(cacheClassName)
	s numIndexes=$lg(indexList)
	s pos=3
	for index=1:1:numIndexes {
		s type=$lg(indexList,pos)
		if type'="key" goto hasIndexesQuitOne 
		s pos=pos+6
		s numProps=$lg(indexList,pos)
		s pos=pos+(numProps*2)
		s numDataProps=$lg(indexList,pos)
		s pos=pos+numDataProps+1
	}
	q 0
hasIndexesQuitOne
	q 1
}
.
getClassGlobalName(cacheClassName) {
	if ('$d(%XTGclassGlobalNames($namespace,cacheClassName))) {
		s %XTGclassGlobalNames($namespace,cacheClassName)=$$getClassGlobalName^%SYS.LCBINDSRV(cacheClassName)
	}
	q $g(%XTGclassGlobalNames($namespace,cacheClassName))
}
.
cleanup() public {
	kill %XTGclassGlobalNames
	kill %XTGECPMode
}
.
setECPMode(mode) public {
	if ($g(%XTGECPMode) = "") {
		s %XTGECPMode=$g(mode)
		q "1"
	}
	else {
		q "0"
	}
}
.
getECPMode(classGlobalName) public {
    // If ECPMode hasn't already been cached for this class, determine it and cache it now.
	if ($g(%XTGECPMode($namespace,classGlobalName))="") {
		// If ECPMode has been explicitly set, use that
		if ($g(%XTGECPMode)'=""&&(%XTGECPMode>=0)) {
			s ecpMode=%XTGECPMode
		}
		else {
			// Else set ECPMode based on whether the class's extent is remote
			s globalDestination=##class(%SYS.Namespace).GetGlobalDest($namespace,classGlobalName)
    		if (($L(globalDestination)>0) && ($E(globalDestination,1)'="^")) {
				s ecpMode=1
				s %XTGECPMode=-1
    		}
    		else {
	    		s ecpMode=0
    		}
		}
		s %XTGECPMode($namespace,classGlobalName)=ecpMode
	}
    q %XTGECPMode($namespace,classGlobalName)
}
.
waitForIndexing(className, timeout, lastId) public {
	s cacheClassName=$$$NormalizeClassname(className)
	if ('$$hasIndexes($g(cacheClassName))) {
		q ""
	}
	s classGlobalName=$$getClassGlobalName(cacheClassName)
	s ecpMode=$$getECPMode(classGlobalName)
	q $$waitForIndexingInternal(ecpMode, cacheClassName, classGlobalName, timeout, lastId)
}
 
waitForIndexingInternal(ecpMode, classname, dataloc, timeout, lastId) {
	s result = 0
	if ((lastId = 0) && (ecpMode=1)) {
		s counterSubscript=$namespace_"^"_$extract(dataloc,2,*)
	}
	s count = 0
	do {
		s id1=+$g($$$XTGState($$$EVENTSubscript,"curId"))
		if (lastId > 0) {
			if (id1 > lastId) {
				s result = 1
			}
	    }
	    else {
			if (ecpMode=1){		
				s id2=+$g($$$XTGState(counterSubscript))		
			}
			else {	
				s id2=+$g(@dataloc)	
			}
			if ((id1 > id2) || (id2 = 0)) {	
				s result = 1		
			}
	    }
	    if (timeout) {	
			h .1
	    }		
		s count = count + 1
	} while ((result = 0) && ((timeout < 0) || (count < (timeout * 10))))
	q result
}
 
cleanupExtent(className, killExtent="") public {
	s cacheClassName=$$$NormalizeClassname(className)
	if ('$g(killExtent)) {
		s killExtent=""
	}
 	q $$cleanupExtentInternal(cacheClassName, $namespace, killExtent)
}
 
cleanupExtentInternal(className, nameSpace, killExtent) {
  	s $zt="Error",$ze=""
  	if $g(className)="" q "<CLASS DOES NOT EXIST>cleanupExtent+2^%apiXTGlobals "
  	if $g(nameSpace)="" q "<NAMESPACE>cleanupExtent+3^%apiXTGlobals "
  	s nameSpace=$zconvert(nameSpace,"U")
  	if $g(killExtent)'="" {
		s retval=$classmethod(className,"%DeleteExtent")
  	}
  	s classGlobalName=$$getClassGlobalName^%SYS.LCBINDSRV(className)
  	s classSubscript=nameSpace_$g(classGlobalName)
  	k $$$XTGState(classSubscript)
  	lock +($$$XTGState(nameSpace,className,"curId"))
  	kill $$$XTGState(nameSpace,className,"curId")
  	lock -($$$XTGState(nameSpace,className,"curId")#"I")
  	q ""
Error
	s $zt=""
	if $find($ze, "<CLASS DOES NOT EXIST>")=23 {
		q ""
	}
	else {
  		q $ze
	}	
}
 
 // Upgrade a Cache instance which previously used ^MDSCounter, or ^["USER"]ISC.XTG.State
 // to preserve any information, kill those old locations and convert information to
 // namespace specific ^ISC.XTG.State. This means that XEP users do not need permissions on 
 // "USER" any longer
upgradeXTGState() public {
	try {
		// throws a namespace or protect error if it doesn't exist
		s test = $d(^["User"]ISC.XTG.State)
		s $$$TestUSERAccess = ""
		k $$$TestUSERAccess
	}
	catch ex {
		return "Error returned attempting to read from USER database; please run this routine with a user that has read and write access on the User database. Error text: "_ex.DisplayString()
	}
	// If we made it this far we have access on user, which is necessary
	// Determine where this state was previously stored
	Set tOldDataLocation = ""
	if ($d(^["User"]MDSCounter)'=0)&&($d(^["User"]ISC.XTG.State)=0) {
		Set tOldDataLocation = "^[""User""]MDSCounter"
	}
	else {
		Set tOldDataLocation = "^[""User""]ISC.XTG.State"
	}
	// no-op if no state stored in the old location
	lock +@tOldDataLocation
	set nsSubscript = $o(@tOldDataLocation@(""))
	set tNSNotUpdatedList = ""
	while nsSubscript '= "" {
		// move each node into appropriate namespace
		// This needs to either be run with all, or from the right user
		try {
			lock +$$$XTGStateNS(nsSubscript)
			m $$$XTGStateNS(nsSubscript)(nsSubscript) = @tOldDataLocation@(nsSubscript)
			k @tOldDataLocation@(nsSubscript)
			lock -$$$XTGStateNS(nsSubscript)
		}
		catch {
			// ignore privilege-related errors, could be from a different namespace, i.e. we 
			// are trying to copy the state to "NS1" and we don't have permissions for "NS2"
			Set tNSNotUpdatedList = tNSNotUpdatedList _ " " _ nsSubscript
			lock -$$$XTGStateNS(nsSubscript)
		}
		set nsSubscript = $o(@tOldDataLocation@(nsSubscript))
	}
	lock -@tOldDataLocation
	// See what's left and report
	// if anything is left in the old one that is *not* in user
	// report what we were unable to move over
	// unable to update such and such
	if (tNSNotUpdatedList'="") {
		// throw a status with the given error?
		return "Unable to update the following namespaces, please run this routine with a user account that has privileges for those namespaces: "_tNSNotUpdatedList	
	}
	// Success
	q ""
}
  
GetGlobalDest(namespc,globl="",subscr="") public {
	q ##class(%SYS.Namespace).GetGlobalDest(namespc,globl,subscr)
}
---
