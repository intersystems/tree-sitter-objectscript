SetBitmapFriendlyCheck(%val,oldval) [] PUBLIC {
	#;  Function:     SetBitmapFriendlyCheck^%apiSQL(%val,.oldval)
	#;  Description:  Sets the flag to determine if the compiler should check 
	#;		  if the bitmap index is allowed in a %Storage.SQL class.
	#;  Parameters:
	#;     1.  %val   - 1/0  0 is default.  1 means check to make sure bitmap index maps are OK
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	#dim exc As %Exception.SystemException
	set tSC=$$$OK
	try {
		set oldval=$$$SQLCheckBitmapFriendly
		set ^%SYS("sql","sys","check bitmap friendly")=''%val
	}
	catch exc {
		set tSC=exc.AsStatus()
	}
	QUIT tSC
}
.
SetThresholdCodeGen(%val) [] PUBLIC {
	#;  Function:     SetThresholdCodeGen^%apiSQL(flag)
	#;  Description:  Set the flag which determines if Threshold checking
	#;                is code generated into SQL statements.
	#;                A value of TRUE enables the code generation of Threshold 
	#;                checking.  The default value IRIS is first installed 
	#;                with is FALSE (no Threshold checks are code generated).
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, code generate Threshold checks.  
	#;                A value of FALSE means Threshold checks are not code 
	#;                generated
	#;-------------------------------------------------------------------
	s %msg="SetThresholdCodeGen^%apiSQL(flag) Entry point is no longer supported!"
	QUIT
}
 
 
SetFilerRefIntegrity(flag,oldval) [] PUBLIC {
	#;  Function:     SetFilerRefIntegrity^%apiSQL(flag)
	#;  Description:  Set the flag which determines if Foreign Key
	#;                Referential Integrity checks are performed in the
	#;                SQL Filer.  A value of FALSE suppresses SQLCODE -121,
	#;                -122, -123, and -124 errors.  The default value IRIS
	#;                is first installed with is TRUE (Validation checks
	#;                are performed).
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If FALSE, set the system wide flag to
	#;                bypass foreign key referential integrity constraint
	#;                checking in the filer.  A value of TRUE turns
	#;                constraint checking on.  
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetReferentialChecks
	Do $zu(115,7,'$g(flag))
	QUIT $$$SetReferentialChecks(''$g(flag))
}
 
 
SetLockTimeout(%val,oldval) [] PUBLIC {
	#;  Function:     SetLockTimeout^%apiSQL(%val)
	#;  Description:  Set the Lock timeout for IRIS locks made during
	#;                execution of SQL statements.
	#;  Parameters:
	#;     1.  %val - Number of seconds to set the lock timeout to.
	#;                The default is 10 seconds.
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetLockTimeout
	Do $zu(115,4,+$g(%val,10))
	QUIT $$$SetLockTimeout(+$g(%val,10))
}
 
 
SetLockThreshold(%val,&oldval) [] PUBLIC {	// DPV2156=
	#;  Function:     SetLockThreshold^%apiSQL(%val)
	#;  Description:  Set the Lock Escalation Threshold for locks in the 
	#;                filer within a trasaction
	#;		  This is a system wide settings and changes the setting for ALL current and new processes.
	#;  Parameters:
	#;     1.  %val - Number of locks to acquire before escalating to a table lock
	#;                1000 is the defualt
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	RETURN $$SetLockThreshold^%SYS.SQLSRV(+$g(%val,$$$DefaultLockThreshold),.oldval)
}
 
 
SetDefaultTimePrecision(%val,oldval) [] PUBLIC {	// DPV2199=
	#;  Function:     SetDefaultTimePrecision^%apiSQL(%val)
	#;  Description:  Set the Default precision for the Time component of the 
	#;                value returned by the GETDATE(), CURRENT_TIME, and 
	#;                CURRENT_TIMESTAMP SQL Scalar functions.
	#;  Parameters:
	#;     1.  %val - Precision (number of decimal places for the millisecond 
	#;                portion of the time value).  The default is 0, milliseconds 
	#;                are not returned in the values returned by the GETDATE(), 
	#;                CURRENT_TIME, and CURRENT_TIMESTAMP functions.
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	set oldval=$$$GetTimePrecision
	set sc=$$$SetTimePrecision(+$g(%val))
	RETURN:$$$ISERR(sc) sc
	set ^%SYS("sql","sys","time precision")=+$g(%val)
	RETURN sc
}
 
 
SetRetainSQL(flag,oldval) [] PUBLIC {
	#;  Function:     SetRetainSQL^%apiSQL(flag)
	#;  Description:  Set the flag which determines if embedded SQL
	#;                statements are retained as comments in the .INT
	#;                code version of the routine.
	#;                The default is no SQL comments are retained.
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                retain the embedded SQL statement as comment 
	#;                lines in .INT code routines.
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetComments
	s sc=$$$SetComments(''$g(flag))
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","retain-sql")=''$g(flag)
	QUIT sc
}
 
 
SetDelimitedIdentifiers(flag,&oldval) [] PUBLIC {
	#;  Function:     SetDelimitedIdentifiers^%apiSQL(flag)
	#;  Description:  Set the flag which determines if double quote (")
	#;                in an SQL statement is used for delimited (quoted)
	#;                identifiers or string constants.
	#;                The default is delimited identifiers not are supported.
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                treat "..." tokens as delimited identifiers.  
	#;                Otherwise, "..." is a string constant.
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	RETURN $$SetDelimitedIdentifiers^%SYS.SQLSRV(''$g(flag),.oldval)
}
 
 
SetFastDistinct(flag,&oldval) [] PUBLIC {
	#;  Function:     SetFastDistinct^%apiSQL(flag)
	#;  Description:  If true (the default) many SQL queries involving DISTINCT (and GROUP BY) 
	#;		  will run much more efficiently by making better use of indices (if available). 
	#;		  This is an optimization added in Cache 5.1.
	#;		  The downside of this is that the values returned by such queries will be collated 
	#;		  in the same way they are stored within the index (i.e., results may be in upper case). 
	#;		  Some applications care about the case of values returned by such queries. 
	#;		  If "Fast DISTINCT" is set to false (0), the SQL will revert to its pre-5.1 
	#;		  behavior with regards to DISTINCT behavior.
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                Have DISTINCT use indices when availbale
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	RETURN $$SetFastDistinct^%SYS.SQLSRV(''$g(flag),.oldval)
}
 
 
SetQueryProcedures(flag,oldval) [] PUBLIC {
	#;  Function:     SetQueryProcedures^%apiSQL(flag)
	#;  Description:  If true all class queries will project as SQL Stored Procedures
	#;                If False (the default) only SqlProc=TRUE class queries will project as stored procedures
	#;  Parameters:
	#;     1.  flag - 1 or 0.  
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetQueryProcedures
	s sc=$$$SetQueryProcedures(''$g(flag))
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","query procedures")=''$g(flag)
	QUIT sc
}
.
.
SetECPSync(flag,oldval) [] PUBLIC {
	#;  Function:     SetECPSync^%apiSQL(flag)
	#;  Description:  Defines whether or not SQL SELECT statements perform a $system.ECP.Sync() call in the OPEN code.
	#; 		  The default is ECP Sync is OFF. The setting in on a per system basis.
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to do a ECP Sync on SELECT is ON
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	#;Set oldval=$$$GetECPSync
	set oldval=$$$ECPSync
	Do $zu(115,15,''$g(flag))
	set sc=$$$SetECPSync(''$g(flag))
	if $$$ISERR(sc) QUIT sc
	set ^%SYS("sql","sys","ECP Sync")=''$g(flag)
	QUIT $$$OK
}
.
.
SetTCPKeepAlive(flag=300,oldval) [] PUBLIC {
	#;  Function:     SetTCPKeepAlive^%apiSQL(flag)
	#;  Description:  Sets the TCP Keep Alive interval (in seconds)
	#;                This is the number of seconds between keep alive-messages.
	#;  Parameters:
	#;     1.  flag - INTEGER.  Number of seconds.  Default is 300
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetTCPKeepAlive
	s sc=$$$SetTCPKeepAlive(flag)
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","TCP Keep-Alive Interval")=flag
	QUIT sc
}
 
 
SetSQLSecurity(flag,oldval) [] PUBLIC {
	#;  Function:     SetSQLSecurity^%apiSQL(flag)
	#;  Description:  Set the flag which determines if SQL security 
	#;                is enabled.  If SQL security is ON, all IRIS SQL 
	#;                security is active.  This means: 
	#;                - Privilege-based table/view security is active.  
	#;                  user may only perform actions on a table of view they 
	#;                  have been granted privilege for. 
	#;                If SQL security is OFF, IRIS SQL security is 
	#;                inactive.  This means: 
	#;                - Privilege-based table/view security is suppressed. 
	#;                  A user may perform actions on a table or view even 
	#;                  if they have not been granted privileges to do so. 
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                turn SQL security ON.  If FALSE, set the system
	#;                wide flag to turn SQL security OFF.
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval1=$$$GetDBMSSecurity
	s sc=$$$SetDBMSSecurity(''$g(flag))
	If $$$ISERR(sc) QUIT sc
	s oldval=oldval1
	Do $zu(115,8,''$g(flag))
	QUIT sc
}
 
 
SetNamespaceSecurity(flag) [] PUBLIC {
	#;  Function:     SetNamespaceSecurity^%apiSQL(flag)
	#;  Description:  Set the flag which determines if ODBC Namespace Security 
	#;                is enabled.  If ODBC Namespace Security is ON users will only
	#;                be allowed to connect to a namespace through ODBC if the
	#;                user has been granted access to the namespace.
	#;                If ODBC Namespace Security is OFF (default), any user may access
	#;                any namespace through ODBC.
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                turn ODBC Namespace Security ON.  If FALSE, set the system
	#;                wide flag to turn ODBC Namespace Security OFF.
	#;                
	#;-------------------------------------------------------------------
	s %msg="SetNamespaceSecurity^%apiSQL(flag) Entry point is no longer supported!"
	QUIT
}
 
 
SetToDateDefaultFormat(format,&oldval) [] PUBLIC {	// DPV2169+
	#;  Function:     SetToDateDefaultFormat^%apiSQL(format)
	#;  Description:  Set the default format the SQl TO_DATE() function will return the
	#;                date value in.  The default TO_DATE() default format is "DD MON YYYY"
	#;  Parameters:
	#;     1.  format - Format code, example:  "YYYY-MM-DD"
	#;     2.  oldval - PBR. Returns old setting.
	#;                
	#;  Returns:      Status Code
	#;-------------------------------------------------------------------
	s:$g(format)="" format="DD MON YYYY"
	Set oldval=$$$GetTODATEDefaultFormat
	QUIT $$$SetTODATEDefaultFormat(format)
}
 
 
SetODBCVarCharMaxLen(%val,oldval) [] PUBLIC {
	#;  Function:	  SetODBCVarCharMaxLen^%apiSQL(%val)	
	#;  Description:  Set the ODBC VarChar MaxLen 
	#;               
	#;  Parameters:
	#;     1.  %val - number of charactor we should say we support for VARCHAR
	#;                The default is 4096.
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetODBCVarcharMaxlen
	QUIT $$$SetODBCVarcharMaxlen(+$g(%val,4096))
}
 
 
SetAutoCommit(%val) [] PUBLIC {
	#;  Function:	  SetAutoCommit^%apiSQL(%val)	
	#;  Description:  set Auto Commit  
	#;               
	#;  Parameters:
	#;     1.  %val - Auto Commit Value: 
	#;     		0: no auto transaction 
	#;			1: autocommit on 
	#;			2: autocommit off (explicit TCOMMIT)
	#;                
	#;-------------------------------------------------------------------
	i $zu(115,1,%val)
	if (%val=1) {
		do SetAutoCommit^%apiGTW(1)
	}
	else {
		do SetAutoCommit^%apiGTW(0)
	}
	QUIT
}
SetDisableNLSCollationMismatchLogging(disable=0,&oldval) [] PUBLIC {
	#;  Function:     SetDisableNLSCollationMismatchLogging^%apiSQL(disable=1,oldValue)
	#;  Description:  Define whether or not to disable logging of global NLS collation mismatches to messages.log
	#;  Parameters:
	#;     1.  disable - 1/0.  0 Is the default
	#;                If 0, NLS collation mismatches determined during query compilation will be logged to messages.log
	#;                If 1, NLS collation mismatches will be disabled and thus NOT logged for evaluation. NLS collation
	#;						mismatches can affect SQL query results.
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	set oldval = $$$GetDisableNLSCollationMismatchLogging
	set sc = $$$SetDisableNLSCollationMismatchLogging(disable)
	RETURN:$$$ISERR(sc) sc
	set ^%SYS("sql","sys","disable NLS collation mismatch logging") = $g(disable,0)
	RETURN sc
}
 
 
SetCompileModeDeferred	;
	#;  Function:     SetCompileModeDeferred^%apiSQL
	#;  Description:  Set the namespace wide flag which turns on
	#;                Deferred Compilation mode.
	#;
	#;-------------------------------------------------------------------
	s ^mtemp2($namespace,"Deferred Compile Mode")=1
	QUIT
 
 
SetCompileModeImmediate	
	#;  Function:     SetCompileModeImmediate^%apiSQL
	#;  Description:  Set the namespace wide flag which returns to
	#;                Immediate Compilation mode (The default).
	#;                If there are pending compilations, this will 
	#;                cause the classes awaitin compilation to be 
	#;                compiled immediately.
	#;
	#;-------------------------------------------------------------------
	i $g(^mtemp2($namespace,"Deferred Compile Mode"))="Compile In Progress" w !,"Deferred List Compilation in Progress, try again later" QUIT
	i $g(^mtemp2($namespace,"Deferred Compile Mode")) d CompileDeferredList^%apiDDL2(.SQLCODE) i SQLCODE<0 QUIT
	k ^mtemp2($namespace)
	QUIT
 
 
SetCompileModeInstall	;
	#;  Function:     SetCompileModeInstall^%apiSQL
	#;  Description:  Set the namespace wide flag which turns on
	#;                Deferred Compilation mode to INSTALL mode.
	#;
	#;-------------------------------------------------------------------
	s ^mtemp2($namespace,"Deferred Compile Mode")=2
	QUIT
 
 
SetCompileModeNocheck	;
	#;  Function:     SetCompileModeInstall^%apiSQL
	#;  Description:  Set the namespace wide flag which turns on
	#;                Deferred Compilation mode to NOCHECK mode.
	#;
	#;-------------------------------------------------------------------
	s ^mtemp2($namespace,"Deferred Compile Mode")=3
	QUIT
 
 
GetCompileMode() [] PUBLIC {
	#;  Function:     GetCompileMode^%apiSQL()
	#;  Description:  Function returns the current Compile Mode setting,
	#;                either Deferred or Immediate.
	#;
	#;-------------------------------------------------------------------
	i $g(^mtemp2($namespace,"Deferred Compile Mode"))=1 QUIT "Deferred"
	i $g(^mtemp2($namespace,"Deferred Compile Mode"))=2 QUIT "Install"
	i $g(^mtemp2($namespace,"Deferred Compile Mode"))=3 QUIT "Nocheck"
	QUIT "Immediate"
}
.
SetCompatibilityPreUnionCollation(flag=0,oldval) [] PUBLIC {
	#;  Function:     SetAutoStatsForEfficientSamplingTableOnly(flag,oldval)
	#;  Description:  Define whether to preserve legacy UNION collation behavior for compatibility purposes
	#;  Parameters:
	#;     1.  flag - 0 or 1.  0 is the default
	#;                If 0, apply the current UNION collation
	#;                If 1, preserve legacy collation behavior for UNION queries to maintain compatibility
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetCompatibilityPreUnionCollation
	s sc=$$$SetCompatibilityPreUnionCollation(''flag)
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","CompatibilityPreUnionCollation")=$g(flag,0)
	QUIT sc
}
 
 
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;   RELATIONAL SERVER STUFF
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 
GetServerInitCode() [] PUBLIC {
	#;  Function:     GetServerInitCode^%apiSQL()
	#;  Description:  Returns the Relational Server Initialization Code for this namespace
	#;  Parameters:
	#;-------------------------------------------------------------------
	QUIT $g($$$SQLServerInitCode)
}
.
SetServerInitCode(code) [] PUBLIC {
	#;  Function:     SetServerInitCode^%apiSQL(code)
	#;  Description:  Defines the Relational Server Initialization Code for this namespace
	#;  Parameters:
	#;     1.  code - constrains the initialization code to be executed.
	#;                Call function with code="" or missing to delete
	#;                 initialization code for this namespace.
	#;-------------------------------------------------------------------
	if $g(code)="" kill $$$SQLServerInitCode QUIT
	set $$$SQLServerInitCode=code
	QUIT
}
.
GetServerDisconnectCode() [] PUBLIC {
	#;  Function:     GetServerDisconnectCode^%apiSQL()
	#;  Description:  Returns the Relational Server Disconnect Code for this namespace
	#;  Parameters:
	#;-------------------------------------------------------------------
	QUIT $g($$$SQLServerDisconnectCode)
}
.
SetServerDisconnectCode(code) [] PUBLIC {
	#;  Function:     SetServerDisconnectCode^%apiSQL(code)
	#;  Description:  Defines the Relational Server Disconnect Code for this namespace
	#;  Parameters:
	#;     1.  code - constrains the disconnect code to be executed.
	#;                Call function with code="" or missing to delete
	#;                 disconnect code for this namespace.
	#;-------------------------------------------------------------------
	if $g(code)="" kill $$$SQLServerDisconnectCode QUIT
	set $$$SQLServerDisconnectCode=code
	QUIT
}
.
	// For all "inti code" and "disconnect code" settings, make sure the namespace exists.
	// If it does not, delete the entry
	// Returns a %Status value
	// Called from:
	//   ActivateOne^%NSPACTIVATE
	//   Activate^%NSPACTIVATE
CheckServerInitAndDisconnectNamespaces() [] PUBLIC {
	try {
		set sc=$$$OK
			#; delete server init code for any non-existing namespaces
		set ns=""
		for {
			set ns=$o(^%SYS("sql","server","init code",ns)) quit:ns=""
			if '$zu(90,10,ns) { kill ^%SYS("sql","server","init code",ns) }
		}
			#; delete server disconnect code for any non-existing namespaces
		for {
			set ns=$o(^%SYS("sql","server","disconnect code",ns)) quit:ns=""
			if '$zu(90,10,ns) { kill ^%SYS("sql","server","disconnect code",ns) }
		}
	} catch ex {
		set sc=ex.AsStatus()
	}
	RETURN sc
}
 
SetDaysBeforePurge(days,system,oldval) [] PUBLIC {
	#;  Function:     SetDaysBeforePurge^%apiSQL(days,system)
	#;  Description:  Defines how many days a Cached Query remain 
	#;                defined past it last days of use.  
	#;  Parameters:
	#;     1.  days - Number of days a Cached Query should remained 
	#;                defined after it's last date of use
	#;                before being deleted.
	#;                If days does not evaluate to a number, the
	#;                DaysBeforePurge setting will be deleted.
	#;     2.  system - 1 or 0 ("").  If TRUE, set/change the 
	#;                DaysBeforePurge setting for the entire system.
	#;                Otherwise it pertains to this namespace only.
	#;-------------------------------------------------------------------
	s %msg="SetDaysBeforePurge^%apiSQL(...)/$SYSTEM.SQL.SetDaysBeforePurge(...) Entry point is no longer supported!"
	s oldval=""
	QUIT $$$ERROR($$$FeatureNotSupported,"SetDaysBeforePurge")
}
 
 
SetCachedQuerySaveSource(flag,oldval) [] PUBLIC {
	#;  Function:     SetCachedQuerySaveSource^%apiSQL(flag)
	#;  Description:  Defines whether or not the source code (.MAC and 
	#;                .INT) is saved or not (The default is no source
	#;                is saved.  The setting in on a per system basis.
	#;  Parameters:
	#;     1.  flag - 1 or 0 ("").  If TRUE, save the Cached Query's
	#;                .MAC and .INT source, Cached Queries are saved
	#;                as .OBJ code only.
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	s oldval=$$$GetSaveMAC
	s sc=$$$SetSaveMAC(''$g(flag))
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","server","Save .MAC")=''$g(flag)
	QUIT sc
}
 
SetCachedQueryLockTimeout(timeout=120,oldval) [] PUBLIC {
	#;  Function:     SetCachedQueryLockTimeout^%apiSQL(timeout,.oldval)
	#;  Description:  Defines the lock timeout used for cached query locks
	#;		  The setting in on a per system basis.
	#;  Parameters:
	#;     1.  timeout - INTEGER.  Default is 120 seconds
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	set tSC=$$$OK
	try {
		set oldval=$g(^%SYS("sql","server","cq lock timeout"),120)
		set ^%SYS("sql","server","cq lock timeout")=timeout
		$$$SQLUpdateContext  // **NOTE: This MACRO must be placed AFTER setting the appropriate global with the new 'timeout' value!
	}
	catch tException {
		set tSC=tException.AsStatus()
	}
	RETURN tSC
}
.
	#; BJB347
SetSQLStats(actionFlag,returnActionFlag=0,collectFlag="",terminateCond=0,ptInfo) [] PUBLIC {
	#; Function:		SetSQLStats^%apiSQL(actionFlag)
	#; Description:	    This method sets the flag that controls whether or not the 
	#;                  System collects SQL Statistics about each run of a query
	#;
	#;                  You can invoke different levels of SQL Statistics collection by 
	#;                  setting the SQLStats-flag, for the System with this method.
	#;    
	#;                  The SQLStats-flag controls whether or not SQL Statistics are 
	#;                  collected for each SQL Query execution, and which performance 
	#;                  statistics to collect.
	#;    
	#;                  The SQLStats-flag is a colon (:) delimited string comprised of 
	#;                  the following individual components: 
	#;                  
	#;                     SQLStats-flag={action-flag}:{collect-flag}:{condition-flag}:{condition-value}:{terminate-flag}:{flag-type}
	#;
	#; Details:         Method details can be found in one of the following classes:
	#;                     - %SYS.PTools.StatsSQL
	#;                     - %SYSTEM.SQL
	#;
	#; Parameters
	#;    1. actionFlag       - The portion of the SQLStats-flag which is represented by the 
	#;                          1st colon (:) piece, and can have one of the following values:
 	#;                             0 = Query Compilation: Don't generator SQLStats collection 
 	#;                                                    code for any Query Modules
 	#;                                 Query Execution:   Don't collect SQLStats for any Query 
 	#;                                                    Modules
 	#;                             1 = Query Compilation: Generator SQLStats collection code for 
 	#;                                                    MAIN Query Module (Start & Stop)
 	#;                                 Query Execution:   Don't collect SQLStats for any Query 
 	#;                                                    Modules
 	#;                             2 = Query Compilation: Generator SQLStats collection code for 
 	#;                                                    MAIN Query Module (Start & Stop)
 	#;                                 Query Execution:   Collect SQLStats for MAIN Query Module 
 	#;                                                    (Start & Stop)
 	#;                             3 = Query Compilation: Generator SQLStats collection code for 
 	#;                                                    ALL Query Modules
 	#;                                 Query Execution:   Collect SQLStats for ALL Query Modules
 	#;    2. returnActionFlag - 0  = Return the entire SQLStats-flag value   [DEFAULT]
 	#;                          1  = Return only the {action-flag} value, which is the portion
 	#;                               of the SQLStats-flag represented by the 1st colon (:) piece
 	#;                               NOTE: This is the backward-compatible value
	#;    3. collectFlag      - The portion of the SQLStats-flag which is represented by the 2nd 
	#;                          colon (:) piece, and is a numeric value representing which SQL 
	#;                          Performance Statistics/Metrics to collect, with one of the 
	#;                          following values:
	#;                             "" = Collect All SQL Performance Metrics                       [DEFAULT]
	#;                             n  = Where n=SUM(MVal)                       [See Below]
	#;  
	#;                          In general, all of the following performance metrics are collected
	#;                          for each SQL module, along with a cumulative value representing
	#;                          all SQL modules, when the SQLStats-flag is turned on:
	#;  
	#;                            MVal  Metric Name                   Metric Description
	#;                            ----  ----------------------------  ----------------------------------
	#;                             1    Query Execution Time          Total number of seconds elapsed
	#;                             2    Total Global References       Total number of global references
	#;                             4    Total Lines of Code Executed  Total number of COS lines executed
	#;                             8    Total Disk Read Latency Time  Total milliseconds spent waiting 
	#;                            ====                                for Disk Reads
	#;                             15   ALL                           Collect all Performance Metrics
	#;  
	#;                          This parameter provides a mechanism by which to choose a
	#;                          combination of which performance metrics to collect, by specifying 
	#;                          a SUM of the performance metrics MVal numbers (specified above) 
	#;                          that you wish to collect.
	#;  
	#;                          EXAMPLE #1:
	#;                          The following example represents the collection of 2 performance
	#;                          metrics, 'Query Execution Time' & 'Total Disk Read Latency Time':
	#;  
	#;                            MVal  Metric Name
	#;                            ----  ----------------------------
	#;                             1    Query Execution Time
	#;                            +8    Total Disk Read Latency Time
	#;                            ===
	#;                             9    Collect both of these performance metrics
	#;  
	#;                          By passing 9 for the value of the 'collectFlag' parameter, the
	#;                          sum of the two aforementioned performance metrics MVal numbers,
	#;                          the SQLStats PTool application will only collect statistical data 
	#;                          for these two performance metrics whenever an SQL Query is invoked.
	#;  
	#;                          EXAMPLE #2:
	#;                          The following example represents the collection of 3 performance
	#;                          metrics, 'Query Execution Time', 'Total Global References' & 
	#;                          'Total Lines of Code Executed':
	#;  
	#;                            MVal  Metric Name
	#;                            ----  ----------------------------
	#;                             1    Query Execution Time
	#;                             2    Total Global References
	#;                            +4    Total Lines of Code Executed
	#;                            ===
	#;                             7    Collect both of these performance metrics
	#;  
	#;                          By passing 7 for the value of the 'collectFlag' parameter, the
	#;                          sum of the three aforementioned performance metrics MVal numbers,
	#;                          the SQLStats PTool application will only collect statistical data 
	#;                          for these two performance metrics whenever an SQL Query is invoked.
	#;    4. terminateCond    - The portion of the SQLStats-flag which is represented by the 
	#;                          5th colon (:) piece, and is determined by this parameter value.
	#;                          An optional condition to determine when to terminate the SQLStats
	#;                          collection, by turning off the SQLStats-flag (System), or by setting
	#;                          it to a specified reset value.  This parameter accepts the following
	#;                          values:
	#;                             0       No Action                                              [DEFAULT]
	#;                             M:<min>:<raf> 
	#;                                     Where <min>=# of minutes from 1..n
	#;                                        When specified, this value will terminate the SQLStats
	#;                                        collection the number of minutes <min> after the current $H
	#;                                     Where <raf>=Reset {action-flag} value from 0..3
	#;                                        When specified, this is the value to which the {action-flag}
	#;                                        portion of the SQLStats-flag will be set upon expiration
	#;                                        If not specified, default <raf> to zero (0)
	#;                                     (e.g. "M:120:1"  => Terminate 120minutes after the current $H
	#;                                                         and reset SQLStats-flag/{action-flag} to 1)
	#;                             T:<ts>:<raf>
	#;                                     Where <ts>=Timestamp with the format: YYYYMMDD HHMM
	#;                                        When specified, this value will terminate the SQLStats
	#;                                        collection after the timestamp value
	#;                                     Where <raf>=Reset {action-flag} value from 0..3
	#;                                        When specified, this is the value to which the {action-flag}
	#;                                        portion of the SQLStats-flag will be set upon expiration 
	#;                                        If not specified, default <raf> to zero (0)
	#;                                     (e.g. "T:20171018 1330:1"  => Terminate after 10/18/2017 01:30PM
	#;                                                                   and reset SQLStats-flag/{action-flag}
	#;                                                                   to 1)
	#;    5. ptInfo           - A Pass By Reference information array that returns to the user detailed 
	#;                          information in the following format:
	#;                             ptInfo(category,variable)=value
	#;                                Where category = { "current" | "terminate" | ... }
	#;                                      variable = A variable that corresponds to the given 'category'
	#;  
	#;                          Example:
	#;                             ptInfo("current","SQLStatsFlag")=The SQLStats-flag value after method execution
	#;
	#; RETURN Value: The value of the SQLStats-flag before setting it to the new value;
	#;               Otherwise, return an error message if an error occurred
	#;-------------------------------------------------------------------
	
	QUIT $$SetSQLStatsFlag^%SYS.PToolsUtil(0,actionFlag,returnActionFlag,collectFlag,,,terminateCond,.ptInfo)
 
}
	#; BJB347-
 
Purge(days=0) [] PUBLIC {
	#;  Function:     Purge^%apiSQL(days)
	#;  Description:  Purges Cached Queries
	#;  Parameters:
	#;     1.  days - Purge all Cached Queries that have not had a
	#;                Prepare in the last 'days' days.  If days=0, then
	#;                purge all Cached Queries.
	#;                If days is not specified, then the default is 0 (All)
	#;-------------------------------------------------------------------
	d Purge^%SYS.SQLSRV(days)
	QUIT
}
 
 
PurgeForRoutine(classname="",regenerate=0) [] PUBLIC {
	#;  Function:     PurgeForRoutine^%apiSQL(classname)
	#;  Description:  Purges a Cached Query by classname
	#;  Parameters:
	#;     1.  classname - The name of the Cached Query class to purge or a comma delimited list of classnames to purge
	#;               Examples:
	#;                  "%sqlcq.USER.cls5"
	#;                  "%sqlcq.USER.cls5,%sqlcq.USER.cls9,%sqlcq.USER.cls121"
	#;-------------------------------------------------------------------
	RETURN:classname=""
	for i=1:1:$l(classname,",") {
		if regenerate {
			set sc=$SYSTEM.SQL.RegenerateQuerySource(classname)
			if $$$ISERR(sc) { do PurgeRtn^%SYS.SQLSRV($p(classname,",",i)) }
		} else {
			do PurgeRtn^%SYS.SQLSRV($p(classname,",",i))
		}
	}
	RETURN
}
 
 
PurgeForTable(table,regenerate="",markAsStale="") [] PUBLIC {
	  #;  Function:     PurgeForTable^%apiSQL(table)
	  #;  Description:  Purges all Cached Query for a schema.table
	  #;  Parameters:
	  #;     1.  table  - The qualified name of the table to Purge the Cached Queries for
	  #;                  If the schema is not specified, the default schema will be used.
	  #;	 2.  regenerate - If 1, regenerate the CQs instead of purging
	  #;					  If 2, regenerate in background
	  #;	 3.  markAsStale - If 1, define the CQ as Stale
	  #;
	  #;-------------------------------------------------------------------
	RETURN:$g(table)=""
	if table'["." { set table=$$$DefaultSchemaQL_"."_$tr(table,".",$c(2)) }		// If not qualified, make it so.
	set ext=$$$GetExtentNameFromIQN(table) RETURN:ext=""
	do DeleteExtentCQ^%SYS.SQLSRV(ext,,markAsStale,regenerate)
	RETURN
}
 
 
Prepare	; This entry point will prompt for an SQL statement and then 'Prepare' it
	#;  It will leave any variables defined by the Prepare normally looked at
	#;  by the Server
 
#include %SYS.DBSRV
.
	n d,d1,data,err,i,j,mcurs,mtag,%mmmzzzr,%msg,%qscqry,pathout,%protocol,sql,SQLCODE,sqlin,%switch,%zzzmode0,%zzzmode1
	set $zt="prepareError",$ze=""
	s sql=0,%qscqry=1,%switch="ODBC" k mtc
	s %zzzmode0=$c(27,91,109),%zzzmode1=$c(27,91,49,109) ; Used in %qcr
	n %zzzmode9 s %zzzmode9=%zzzmode0  ;  fix display for "WRITE"
	set %protocol=$$$ProtocolVersion
	w !!,"Enter the SQL statement (can be multi-line) at the SQL>> prompt."
	w !,"An empty line marks the end of the SQL statement.",!
	f  r !,"SQL>>",sqlin q:sqlin=""  s sql($i(sql))=sqlin
	QUIT:sql=0
	d comp^%qaqqt("query",.sql,"info","",0,"","%qsc(%qscacn",,,,,"xDBC")
	i $g(SQLCODE)<0 GOTO prepareError
 
	w !!,"PARAMETER information from mtc():"
	For i=1:1:$g(mtc(0,0,"parameter")) {
		s d=mtc(0,0,"parameter",i),d1=$g(mtc(0,0,"parameter",i,1))
		w !!?2,"Name:",?32,$p(d,$c(1),1)
		w !?2,"ODBC Type:",?32,$p(d1,$c(1),2)
		w !?2,"Precision:",?32,$p(d1,$c(1),4)
		w !?2,"Scale:",?32,$p(d1,$c(1),5)
		w !?2,"Nullable:",?32,$p(d1,$c(1),6)
		w !?2,"mt(""v"") val# param:",?32,$p(d,$c(1),2)
		w !?2,"mt(""v"") val# compare against:",?32,$p(d,$c(1),4)
		if %protocol>56 {
			w !?2,"External SQL Type:",?32,$p(d1,$c(1),7)
			w !?2,"fastInsert Slot:",?32,$p(d1,$c(1),8)
			w !?2,"TRUNCATE flag:",?32,$p(d1,$c(1),9)
			w !?2,"MINVAL/MINLEN:",?32,$p(d1,$c(1),10)
			w !?2,"MAXVAL:",?32,$p(d1,$c(1),11)
		}
		
	}
	w !!,"SELECT information from mtc():"
	For i=1:1:$g(mtc(0,0,"select")) {
		s d=mtc(0,0,"select",i),d1=mtc(0,0,"select",i,1)
		w !!?2,"irn: ",$p(d,$c(1),7),?15,"ifn: ",$p(d,$c(1),8),?30,"val: ",$p(d,$c(1),11)
		w !?2,"Name:",?25,$p(d1,$c(1),1)
		w !?2,"ODBC Type:",?25,$p(d1,$c(1),2)
		w !?2,"Length:",?25,$p(d1,$c(1),3)
		w !?2,"Precision:",?25,$p(d1,$c(1),4)
		w !?2,"Scale:",?25,$p(d1,$c(1),5)
		w !?2,"Nullable:",?25,$p(d1,$c(1),6)
		w !?2,"ReadOnly:",?25,$p(d1,$c(1),7)
		w !?2,"Column's Schema:",?25,$p(d1,$c(1),9)
		w !?2,"Column Qualifier Name:",?25,$p(d,$c(1),10)
		w !?2,"Column's Table:",?25,$p(d1,$c(1),11)
		w !?2,"Collation Function:",?25,$p(d1,$c(1),12)
		w !?2,"IRIS Type:",?25,$p(d1,$c(1),13)
		w !?2,"Column's Property:",?25,$p(d1,$c(1),14)
		w !?2,"Column's Extent:",?25,$p(d1,$c(1),15)
		w !?2,"Column Name in Table:",?25,$p(d1,$c(1),17)
		w !?2,"Autoincrement:",?25,$p(d1,$c(1),18)
		w !?2,"IsRowVersion?:",?25,$p(d1,$c(1),19)
		w !?2,"IsUnique?:",?25,$p(d1,$c(1),20)
		w !?2,"IsExpression:",?25,$p(d1,$c(1),21)
		w !?2,"IsHidden:",?25,$p(d1,$c(1),22)
		w !?2,"IsIdentity:",?25,$p(d1,$c(1),23)
		w !?2,"IsKeyColumn:",?25,$p(d1,$c(1),24)
		w !?2,"IsRowid:",?25,$p(d1,$c(1),25)
		w !?2,"IsAliased:",?25,(($p(d1,$c(1),17)'=""&&($p(d1,$c(1),8)'=$p(d1,$c(1),17)))||($p(d1,$c(1),17)=""))
		w !?2,"Container Field:",?25,$p(d1,$c(1),26)
		w !?2,"External SQL Type",?25,$p(d1,$c(1),27)
		if %protocol>56 {
			w !?2,"Storage Slot",?25,$p(d1,$c(1),28)
		}
		w !?2,"is$List",?25,$p(d1,$c(1),29)
	}
	w !!,"TABLE information from mtc():"
	s i="" 
	For  { 
		s i=$o(mtc(0,0,"table",i),1,d) q:i=""
		w !!?2,"Table Type:",?25,$s($p(d,$c(1),1)=1:"TABLE",1:"VIEW")
		w !?2,"m:",?25,$p(i,"^")
		w !?2,"irn:",?25,$p(d,$c(1),2)
		w !?2,"Name:",?25,$$quoter2($$$AllButLastPiece($p(d,$c(1),3),"."))_"."_$$quoter2($tr($$$LastPiece($p(d,$c(1),3),"."),$c(2),"."))
		w !?2,"Extent:",?25,$p(d,$c(1),4)
		w !?2,"Class:",?25,$p(d,$c(1),5)
		w !?2,"Shard Flag:",?25,$p(d,$c(1),6)
		if $p(d,$c(1),6)=2 {
			w !?2,"Real table name:",?25,$p(d,$c(1),10)
		}
		if %protocol>56 {
			w !?2,"fastInsert supported:",?25,$p(d,$c(1),7)
			w !?2,"fastSelect supported:",?25,$p(d,$c(1),8)
			w !?2,"fastSelect Slot Count:",?25,$p(d,$c(1),9)
			w !?2,"fastInsert Slot Count:",?25,$p(d,$c(1),11)
		}
	}
	if $d(mtc(0,0,"defaults")) {
		w !!,"DEFAULT information from mtc():"
		s i="" 
		For  { 
			s i=$o(mtc(0,0,"defaults",i),1,d) q:i=""
			w !!?2,"Slot Number:",?25,$lg(d,1)
			w !?2,"Default Value:",?25,$s($lg(d,2):$lg(d,2),$lg(d,2)=0:0,1:$$quoter($lg(d,2)))
		}
	}
	w !!,"Displaying "_%zzzmode1_"mtc()"_%zzzmode0_"...",!
	d ptmvst1^%qcr("mtc") w !!,%zzzmode1_"mtc()"_%zzzmode0_" is still defined in your partition",!
	QUIT
prepareError
	s $zt=""
	w $g(%zzzmode1)
	w !!,"An error occurred during prepare..."
	if $ze'="<SYNTAX>errdone+3^%qaqqt" w !,"$ZE = "_$ze
	w !,"SQLCODE = "_$g(SQLCODE,"<NOT DEFINED>") w:$d(SQLCODE)#2 ?18,$$sqlcode(SQLCODE)
	i $g(err)'="" w !,"err = "_$g(err)
	i $g(%msg)'="" w !,"%msg = "_$g(%msg)
	w $g(%zzzmode0)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK494
ShowPlanInput(showstats=0,pPreParse=0,packages="",schemapath="",selectmode="")   ;  prompt for an SQL statement, and show its plan
	#;  Function:     ShowPlanInput^%apiSQL
	#;  Description:  Prompt for an SQL statement, and show its plan
	#;
	#;  Parameter
	#;
	#;         1.  showstats - 1 or 0.  If 1 the run the SQL query to generate stats
	#;                         and output the stats as part of the plan text
	#;         2.  pPreParse - 1 or 0.  If 1, preparse the statement first to perform host variable replacements
	#;         3.  packages = $List of package names that will be used as default packages/schemas
	#;         4.  schemapath.  If '="", set this value into %sqlSchemaPath, overriding any currently defined %sqlSchemPath
	#;         5.  selectmode - select mode to use for the compile that produces the plan.
	#;-------------------------------------------------------------------
	n sqlin,sql
	w !,"Enter the SQL statement (can be multi-line) at the SQL>> prompt."
	w !,"An empty line marks the end of the SQL statement.",!
	f  r !,"SQL>>",sqlin q:sqlin=""  s sql($i(sql))=sqlin
	d:$g(sql) ShowPlan(.sql,"","",showstats,packages,schemapath,pPreParse,selectmode)  ;  show plan for this query
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ShowPlan(sql,arr,forTest="",showstats=0,packages,schemapath="",preparse=0,selectmode="",nofplan=0,silent=0,ignoreOutliers=0,&dynargs,verbose=0,topq=1,noRTPC=0,json=0,inEXPLAIN=0,collectCost=0,&includeFiles="") ;  plan for a given query text .sql
	#;  Function:     ShowPlan^%apiSQL(sql,arr,,showstats,packages,schemapath,preparse,selectmode,nofplan,silent)
	#;  Description:  Generate a plan description for a given query text
	#;  Parameters:
	#;     1.  sql - A Pass By Reference (PBR) array/string containing the SQL Statement
	#;               in one of the following formats:
	#;                  Array:   sql=# of SQL Statement lines
	#;                           sql(n)=Each line of the SQL Statement text
	#;                  String:  sql=The SQL Statement text
	#;     2.  arr - 1 or 0 ("").  If 1, leave the resulting plan lines in the
	#;               array %plan(1:%plan), otherwise output the plan using WRITE
	#;     3.  forTest - 1 or 0 ("").  If 1, generate regression test output
	#;     4.  showstats - 1 or 0.  If 1 then run the SQL query to generate stats
	#;                     and output the stats as part of the plan text
	#;     5.  packages = $List of package names that will be used as default packages/schemas
	#;     6.  schemapath.  If '="", set this value into %sqlSchemaPath, overriding any currently defined %sqlSchemPath  %sqlSchemaPath is a $lb() of schema names
	#;     7.  preparse = 1 or 0.  If 1, first preparse the SQL statement to perform literal replacement.  The default is 0.
	#;                    The ShowPlan^%apiSQL(...) call from the SMP will call with preparse=1 so the
	#;                    Plan reflects the same execution path as the Execute Query will.
	#;     8.  selectmode - select mode to use for the compile that produces the plan.
	#;     9.  nofplan = if 1 then do not use any frozen plan
	#;    10.  silent - 1 or 0 (""). If 1, don't perform any writes within this method
	#;    11.  ignoreOutliers - 1 or 0.  If 1, just ignore outlier processing.  0 is default. If 0, show plan for SQL RTU if one exists.
	#;    12.  dynargs - passed by reference { dynargs(i) : i=1..dynargs is the parameters passed in
	#;    13.  verbose - A flag to determine how the PBR '%plan(...)' array should be
	#;                   populated:
	#;                     0 = Populate the '%plan(...)' array with ONLY top-level module
	#;                         details, specified as Semi-XML in Linear Plan Format (LPF)
	#;                     1 = Populate the '%plan(...)' array with all module details,
	#;                         specified as Semi-XML in Linear Plan Format (LPF)
	#;                     2 = Populate the '%plan(...)' array with all module details,
	#;                         specified as Semi-XML in Inline Plan Format (IPF)
	#;                     3 = Populate the '%plan(...)' array with all module details,
	#;                         specified as Simple-Text in Inline Plan Format (IPF)
	#;                   NOTE: If the '%plan(...)' array is to be used as the input to
	#;                         the 'planHTML^%qaqplan()' method, then the 'verbose'  
	#;                         parameter must be equal to one (1)
	#;    14. topq - ShowPlan supports list all the plans (including the plans for sharded queries and %PARALLEL queries). This variable indicates 
	#;        this call is the top call to ShowPlan (not any recursive call). Users should not change the topq since this acts as state variable for ShowPlan internal use. 
	#;    15. noRTPC - This variable indicates whether RTPC should be applied on this query, 1 means No RTPC should be applied, 0 (default) means RTPC should be applied.
	#;        This variable is for internal use only, it is set during showing plan from management portal (set to 1 for %Library.ResultSet Dynamic SQL Query, else 0). Users should not change the noRTPC.
	#;    16. json - 1 or 0 ("").  If 1, produce a machine readable query plan (MRQP) instead of one of the alternative
	#;                             formats (e.g. Semi-XML or Simple-Text) specified by the 'verbose' parameter
	#;    17. inEXPLAIN - 0 = Not processing an SQL <explain statement>
	#;                    1 = Processing an SQL <explain statement>
	#;                    [InterSystems INTERNAL USE ONLY]
	#;    18. collectCost - 0 = regular ShowPlan
	#;                      1 = only collect the cost from the plan, %plan will be the cost value
	#;                      [InterSystems INTERNAL USE ONLY]
	#;    19. includeFiles - An optional $LIST(...) OR array of .INC files to use when
	#;                       processing the given 'sql' statement.  This PBR parameter can be
	#;                       specified in one of the following formats:
	#;                          $LIST(<inc file>[,<inc file>]*)
	#;                             OR
	#;                          includeFiles(<inc file>)=""
	#;                             ...
	#;                          includeFiles(<inc file>)=""
	#;    nn. If you add a new parameter here, make sure to update the parameter list of 
	#;        the 'ShowPlanAlt(...)' method so that these two method's parameters are
	#;        kept in sync!
	#;-------------------------------------------------------------------
	new %msg,%msqlvarcparm,%sqlcodegen,%sqlHVarTypes2,%SQLStats,%substk,%SYSTEMINCLUDE,%topincludes,dasl,data,dcost,dint,dmac,dmlmt,dmlsql,dmt,dmts,dseldict,dsql,err,foundOutlier,i,incFile,inclist,incPos,j,listparms,macroInSQL,mcurs,methodCode,methodCodeIdx,methodName,mtag,mtc,ok,ppsql,SQLCODE,sqlErr,sqlHold,sqlINT,sqlLn,sqlMAC,sqlOrig,sqlparms,sqlStatus,value
	set ok=1
	new:'$g(arr) %plan  ;  arr indicates output into implicit array %plan()
		#;  First we need to do an info compile of the query in order to find out what include
		#;  file are needed to compile the query.
	if schemapath'="" new %sqlSchemaPath set %sqlSchemaPath=schemapath
	if '$d(sql) {	// Return blank plan when no SQL Statement was provided
		kill %plan
		set %plan=0
		RETURN
	}
	merge sqlOrig=sql  // Retain the original 'sql' value!
	if $d(sql)<10 { kill sql set sql($i(sql))=sqlOrig } // Ensure SQL Statement defined in 'sql(...)' array!
	set:$g(backgrnd)&&'silent silent=1	// Set to silent if background flag defined!
	if $d(includeFiles)'<9 { // --- Create a $LIST(...) of all 'incFile' Values ---
		set incFile="",includeFiles=""
		for { // --- Process All 'includeFiles(incFile)' Values ---
			set incFile=$o(includeFiles(incFile))
			QUIT:incFile=""  // No more 'incFiel' Values!
			
			set:'$LF(includeFiles,incFile) includeFiles=includeFiles_$LB(incFile)  // Add each unique 'incFile' to the $LIST(...)!
		}
	}
	set:'$LV(includeFiles) includeFiles=""  // Ensure valid $LIST(...) value!
	if includeFiles'="" { // --- Use the Specified 'includeFiles' Values to Expand any $$$MACROs found within the given SQL Statement 'sql' ---
		set macroInSQL=0
		for sqlLn=1:1:sql { // --- Search for any $$$MACROs Contained within the Specified SQL Statement 'sql' ---
			if sql(sqlLn)["$$$" { set macroInSQL=1 QUIT }  // Possible $$$MACRO found!
		}
		if macroInSQL { // --- Try to Expand Appropriate $$$MACROs Contained within the Specified SQL Statement 'sql' ---
			merge sqlHold=sql     // Save the original 'sql' array!
			kill ^||%sql.extract  // Tabula Rasa!
			set sqlMAC($i(sqlMAC(0)))="#INCLUDE %systemInclude"  // Primary System .INC File!
			for incPos=1:1:$LL(includeFiles) { // --- Process All .INC Files in 'includeFiles' ---
				set incFile=$LG(includeFiles,incPos)
				CONTINUE:incFile=""  // Skip Empty .INC File!
		  		
				set sqlMAC($i(sqlMAC(0)))="#INCLUDE "_incFile
				set inclist(incFile)=""  // Set for processing later!
			}
			for sqlLn=1:1:sql { // --- Add Embedded SQL Statement for Processing via 'LINES^%qarmac(...)' ---
				set sqlMAC($i(sqlMAC(0)))=$s(sqlLn=1:" &sql(",1:" ")_$g(sql(sqlLn))_$s(sqlLn=sql:")",1:"")
			}
			// --- Expand Appropriate $$$MACROs Contained within the Specified SQL Statement 'sql' ---
			do LINES^%qarmac("sqlMAC","sqlINT",,,,1,"sqlErr",,,,,,,,,,,.sqlStatus)
			
			kill sql  // Kill the original 'sql' array!
			merge:sqlStatus sql=^||%sql.extract(1)  // Set the 'sql' array with the Normalized SQL Statement from 'LINES^%qarmac(...)'!
			merge:'$d(sql) sql=sqlHold  // Restore the original 'sql' array if 'LINES^%qarmac(...)' failed!
		}
	}
	if preparse||$g(dynargs) { // --- SQL <explain statement> defaults 'preparse=1' & 'dynargs' allows for exact SQL Query plan processing ---
		try {
			set %sqlHVarTypes2=1  // Flag to record the types of any literals being replaced with host variables in {preparse | hvar}^%%qaqpreparser!
			set ppsql=$$preparse^%qaqpreparser(.sql,$s($g(dynargs):2,1:1))  // 2nd param - intovar = {1 = Don't replace :vars in INTO | 2 = Don't replace literals for other vars}
			THROW:$g(SQLCODE)<0 ##class(%Exception.SQL).CreateFromSQLCODE(SQLCODE,%msg)
			kill sql set sql($i(sql))=$LG(ppsql,1)_$s($g(dynargs)&&$LL($lG(ppsql,2)):" /*#OPTIONS {""DynamicSQLTypeList"":""1""} */",1:"")  // 'sql(...)' is now the preparsed version of the SQL Statement!
			set listparms=$lg(ppsql,2)
			new vindex
			for vindex=1:1:$LL(listparms)\2 { // --- Process each parameter within the SQL Statement ---
				if $LG(listparms,2*vindex-1)=$s($g(dynargs):"c",1:"?") { // --- Not a literal/value Substitution ---
					kill sqlparms
					quit	
				}
				set sqlparms($i(sqlparms))=$s($g(dynargs):$g(dynargs(vindex)),1:$LG(listparms,2*vindex))
			}
		}
		catch err {
			write:'silent !,"Unexpected Error:  ",err.SQLMessageString(0)
			kill %plan,sql,%plans
			set %plan=0
			set sql=1,sql(1)="Unexpected Error:  "_err.SQLMessageString(0)
			set:$g(wrtref)'="" @wrtref@($s($g(@wrtref@(0))&&'$d(@wrtref@(@wrtref@(0),"error")):@wrtref@(0),1:$i(@wrtref@(0))),"error")=$LB($ZE,$ZN,"ShowPlan","Unexpected Error:  <<<1>>>")
			set ok=0
		}
	} 
	RETURN:'ok
	if silent&&'$g(backgrnd) {
		new backgrnd set backgrnd=1
		if $g(wrtref)="" new err,showErr,wrtref set wrtref="showErr"
	}
	try {
		n nRTP
		if noRTPC { set nRTP("qType") = -1}
		else {
			set nRTP("qType") = 2*($s($g(sqlparms):-1,1:1)),nRTP("selectMode") = "Runtime" // info compile as dynamic sql
		}
		d comp^%qaqqt("query",.sql,"info","",0,"","%qsc(%qscacn",,,$g(packages),,,,,,,,.nRTP)
		
			#; If this is an EXPLAIN statement, we will check to make sure the user is privileged for the statement
		if inEXPLAIN,'$$$IAmSuperUser {
			new %qinfo merge %qinfo=mtc(0,0)
			set stmttype=$$GetType^%SYS.SQLSRV(mtc(0,0,"type"))
			set rc=$$CheckPriv^%SYS.SQLSRV(stmttype,.mtc,.%qinfo)
			if rc {
				write:'silent !,"SQL Privilege Error:  ",%msg
				kill %plan,sql,%plans
				set %plan=0
				set sql=1,sql(1)="SQL Privilege Error:  "_%msg
				set:$g(wrtref)'="" @wrtref@($s($g(@wrtref@(0))&&'$d(@wrtref@(@wrtref@(0),"error")):@wrtref@(0),1:$i(@wrtref@(0))),"error")=$LB($ZE,$ZN,"ShowPlan","SQL Privilege Error: "_%msg,rc,,%msg)
				set ok=0
				quit
			}
		}
.
		if $g(nRTP)&&$g(sqlparms) {
			n code,SQLrtpcsql
			set code($i(code(0))) = "Main(&sqlparms,&SQLrtpcsql) PUBLIC {"
			set code($i(code(0))) = $c(9)_"n %CallArgs"
			set code($i(code(0))) = $c(9)_"m %CallArgs = sqlparms"
			if (",DISPLAY,ODBC,LOGICAL,"[(","_$$$UPPER(selectmode)_",")) {
				set code($i(code(0))) = $c(9)_"n %SelectMode"
				set code($i(code(0))) = $c(9)_"s %SelectMode=$zu(115,5,"_$case($$$UPPER(selectmode),"DISPLAY":2,"ODBC":1,:0)_")"
			}
			set code($i(code(0))) = $c(9)_"try {"
			for i=1:1:nRTP("dispatch-code","rtexpr"){
				set code($i(code(0))) = $c(9)_nRTP("dispatch-code","rtexpr",i)
			}
			for i=1:1:nRTP("dispatch-code","sql"){
				set code($i(code(0))) = $c(9)_nRTP("dispatch-code","sql",i)
			}
			set code($i(code(0))) = $c(9)_"} catch SQLrtpcerr {" 
			set code($i(code(0))) = $c(9,9)_"d $zu(115,5,%SelectMode)"
			set code($i(code(0))) = $c(9,9)_"throw SQLrtpcerr"
			set code($i(code(0))) = $c(9)_"}" 
			if (",DISPLAY,ODBC,LOGICAL,"[(","_$$$UPPER(selectmode)_",")) {
				set code($i(code(0))) = $c(9)_"d $zu(115,5,%SelectMode)"
			}
			set methodName=""
			for {
				set methodName=$O(nRTP("dispatch-code","helper",methodName),1,value) q:methodName=""
				continue:(methodName'["%rtpcUDF")
				set methodCodeIdx=""
				for {
					set methodCodeIdx=$O(nRTP("dispatch-code","helper",methodName,methodCodeIdx),1,methodCode) q:methodCodeIdx=""
					set code($i(code(0))) = methodCode
				}
				kill nRTP("dispatch-code","helper",methodName)
			}
			set code($i(code(0))) = "}"
			set methodName=""
			n procedureBlock
			for {
				set methodName=$O(nRTP("dispatch-code","helper",methodName),1,value) q:methodName=""
				continue:(methodName'["%rtpcHelper")
				set methodCodeIdx=""
				set procedureBlock=$s($g(nRTP("dispatch-code","helper",methodName,"procedureBlock"))=0:0,1:1)
				kill nRTP("dispatch-code","helper",methodName,"procedureBlock")
				for {
					set methodCodeIdx=$O(nRTP("dispatch-code","helper",methodName,methodCodeIdx),1,methodCode) q:methodCodeIdx=""
					if (methodCodeIdx = 1) {
						set code($i(code(0))) = methodName_methodCode_$s(procedureBlock:" {",1:"")
					} else {
						set code($i(code(0))) = methodCode
					}
				}
				set:procedureBlock code($i(code(0))) = "}"	
			}
			do GetShowPlanRTPCSQL^%SYS.SQLSRV(.code,.sqlparms,.SQLrtpcsql)
			kill sql
			set sql = 1,sql(1) = SQLrtpcsql
		}
	}
	catch { 
		if $g(err)="qaqperr",$g(SQLCODE) { 
			write:'silent !,"SQLCODE = ",SQLCODE," ",$$sqlcode(SQLCODE),".  ",!,$g(%msg) 
			kill %plan,sql
			set %plan=0
			set sql=1,sql(1)="SQLCODE = "_SQLCODE_" "_$$sqlcode(SQLCODE)_".  "_$g(%msg)
			set:$g(wrtref)'="" @wrtref@($s($g(@wrtref@(0))&&'$d(@wrtref@(@wrtref@(0),"error")):@wrtref@(0),1:$i(@wrtref@(0))),"error")=$LB($ZE,$ZN,"ShowPlan","",SQLCODE,$$sqlcode(SQLCODE),$g(%msg))
			set ok=0
		} elseif $g(err)="GetShowPlanRTPCSQL" {
			kill nRTP
			set nRTP("warning")=%msg
		} else { 
			write:'silent !,"Unexpected Error:  ",$ze 
			kill %plan,sql
			set %plan=0
			set sql=1,sql(1)="Unexpected Error:  "_$ze
			set:$g(wrtref)'="" @wrtref@($s($g(@wrtref@(0))&&'$d(@wrtref@(@wrtref@(0),"error")):@wrtref@(0),1:$i(@wrtref@(0))),"error")=$LB($ZE,$ZN,"ShowPlan","Unexpected Error:  <<<1>>>")
			set ok=0
		}
		
	}
	RETURN:'ok
		#;  Here we get a list of include files from the class and include them at the
		#;  beginning of the code we'll compile.  These are needed if the user uses
		#;  macro references defined in these definitions in 
		#;  Computed field code, map definitions, etc.
	set i=""
	set inclist("%systemInclude")=""  // %systemInclude is automatically included in all classes
	for  {
		set i=$o(mtc(0,0,"table",i),1,data) quit:i=""  
		set data=$p(data,$c(1),4)	// data is now the extentname
		if data'="" { set j="" for  { set j=$$$comClassArrayNext(data,$$$cCLASSincludecodeall,j) quit:j=""  set inclist(j)="" }}
	}
	if $d(inclist) { set i="" for  { set i=$o(inclist(i)) quit:i=""  set dmac($i(dmac))="#INCLUDE "_i }}
		#;  put it in embedded SQL lines
	if $g(packages)'="" f i=1:1:$ll(packages) s dmac($i(dmac))="#import "_$lg(packages,i)
	if schemapath'="" s dmac($i(dmac))="#sqlcompile path="_$listtostring(schemapath)
		#; use RUNTIME mode so ShowPlan from SMP or SQL Shell will match the hash from the %SQL.Statement cached query of the same statement via SMP or the Shell.
	if selectmode'="" { set dmac($i(dmac))="#sqlcompile select="_selectmode }
	f i=1:1:$g(sql) s dmac($i(dmac))=$s(i=1:" &sql(",1:" ")_$g(sql(i))
	s dmac($i(dmac))=" )"	// DPV3472 - put closing ")" on line by itself in case SQL satemet ends with comment
		#; when we break and gather metadata, we need to make sure we break at the correct time.  If there are nested SQL compilations, we don't want to grab the
		#; metadata from the wrong query.  This can happen if there are embedded SQL queries in SQL computed fields.
		#; for the close+1, we take the last one we encounter
		#; for the +1^%qaqcasl, we take the first one
	
	d LINES^%qarmac("dmac","dint",,,,,,,,,,,,,,,,,$select(nofplan:"ShowPlan5",1:"ShowPlan1"))  ;  run the compiler and collect data
	If collectCost{
		Set %plan=$Get(dcost,0)
		RETURN
	}
	if 'json k %plan s %plan=0
	s:forTest dcost=0
	#;HSU275+ "parallelquery" would store all the generated %PARALLEL child queries in key^%qaqplan
	#;we use "topq" to denote wethere the current query is the top query: we start to generate %PARALLEL child queries for the current query.
	n parallelquery
	s parallelquery = 0
	n:topq %plans
	#;HSU275-
	i ($d(dmlmt)),'$g(dsql){ ; DML, but not insert with select
		merge dmt=dmlmt,dsql=dmlsql
		s dcost=0
		s dmt("dmlnoselect")=1}
	d:$g(dsql)||$d(dmlmt) nliz^%qaqplan(.dsql,.dasl,.dmt,dcost,showstats,.sqlOrig,verbose,json,.dmts,topq,.dseldict)  ;  analyze asl/mt
	i '$g(arr),'json f %plan=1:1:%plan w !,%plan(%plan)  ;  output results
	if json,$d(dmt("parallelquery")) m parallelquery=dmt("parallelquery")
	#;HSU275+ all the %plan would be merged into %plans. 
	#;after all recursive calls to ShowPlan finish,
	#;the top query would merge all the plans of %plans into %plan.
	#;This logic should work for both %PARALLEL and %NOPARALLEL query. 
	i $d(parallelquery)>10 { 
		#; found generated %PARALLEL plans, recursively call ShowPlan.
		#; keep the current plan in %plans($i(%plans))
		m:$d(%plan)>10 %plans($i(%plans)) = %plan
		n pplan n ii
		s pplan = 1
		#; always call ShowPlan recursively with topq = 0
		f ii=1:1:$g(parallelquery) {
			s pplan(1)=parallelquery(ii)
			d ShowPlan(.pplan,arr,forTest,showstats,$g(packages),schemapath,preparse,selectmode,nofplan,silent,ignoreOutliers,.dynargs,verbose,0,noRTPC,json)
		}
	}
	else{
		RETURN:(topq=1)*('json)
		m:($d(%plan)>10)&&'json %plans($i(%plans)) = %plan
	}
	if json,topq,$d(%plan),'silent{
		n formatter
		Set formatter = ##class(%JSON.Formatter).%New()
		Do formatter.FormatToStream(%plan,.%outplan)
	}
	if topq=1,'json{
		kill %plan 
		n i,j
		f i=1:1:%plans{
			f j=1:1:%plans(i){
				s %plan($i(%plan)) = %plans(i,j)
			}
		}
		kill %plans 
	}
	#;HSU275-
	s:'$d(%plan) %plan=0
	
	RETURN
.
CountVars(&sqlarr,type) [] public {
	Set countqm=0
	for line=1:1:sqlarr {
		Set sql=$g(sql)_" "_sqlarr(line)
	}
	Set insidequote=0
	for charindex=1:1:$L(sql) {
		if insidequote=0 {
			if $e(sql,charindex)="'" || ($e(sql,charindex)="""") {
				Set insidequote=1
				Set quotechar=$e(sql,charindex)
			} elseif ($e(sql,charindex)=type) { // : introduces a hostvar and ? is a question mark - both processed by var^%qaqpop
				If $i(countqm)
			}
		} elseif insidequote=1 {
			if $e(sql,charindex)=quotechar {
				Set insidequote=0
			}
		}
			
	}
	Return countqm
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ShowPlanRtn(rtn,arr,verbose=0) n dsql,dasl,dmt,cost,sql,asl,mt,cost,ind  ;  plan for all queries in a routine
	#;  Function:     ShowPlanRtn^%apiSQL(rtn,arr)
	#;  Description:  Generate a plan description for all queries in a routine
	#;  Parameters:
	#;     1.  rtn - The name of a routine to analyze
	#;     2.  arr - 1 or 0 ("").  If 1, leave the resulting plan lines in the
	#;               array %plan(1:%plan), otherwise output the plan using WRITE
	#;     3.  verbose - A flag to determine how the PBR '%plan(...)' array should be
	#;                   populated:
	#;                     0 = Populate the '%plan(...)' array with ONLY top-level module
	#;                         details, specified as Semi-XML in Linear Plan Format (LPF)
	#;                     1 = Populate the '%plan(...)' array with all module details,
	#;                         specified as Semi-XML in Linear Plan Format (LPF)
	#;                     2 = Populate the '%plan(...)' array with all module details,
	#;                         specified as Semi-XML in Inline Plan Format (IPF)
	#;                     3 = Populate the '%plan(...)' array with all module details,
	#;                         specified as Simple-Text in Inline Plan Format (IPF)
	#;                   NOTE: If the '%plan(...)' array is to be used as the input to
	#;                         the 'planHTML^%qaqplan()' method, then the 'verbose'  
	#;                         parameter must be equal to one (1)
	#;
	#;  NOTE:  As a side effect of this call the routine gets (re)compiled.
	#;-------------------------------------------------------------------
	n:'$g(arr) %plan  ;  arr indicates output into implicit array %plan()
	d ^%qarmac(rtn,,,,,,,,,,,,,,,"ShowPlan2")  ;  run the compiler and collect data
	k %plan s %plan=0,ind=""
	;  analyze asl/mt
	f dsql=1:1:$g(dsql) k sql,asl,mt m sql=dsql(dsql),asl=dasl(dsql),mt=dmt(dsql) d nliz^%qaqplan(.sql,.asl,.mt,$g(cost(dsql)),,.sql,verbose),nuln^%qaqplan("")
	i '$g(arr) f %plan=1:1:%plan w !,%plan(%plan)  ;  output results
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK494-
 
ShowPlanAlt(sql, arr =0, forTest="", showstats=0, packages="", schemapath="", preparse=0, idList="", silent=0, ph10, ph11, verbose=0, ph13, ph14, ph15, ph16, inEXPLAIN=0, ph18, &includeFiles="") ;  plan for a given query text .sql
	#;  Function:     ShowPlanAlt^%apiSQL(sql,arr,forTest,showstats,package,schemapath,preparse,idList,silent)
	#;  Description:  Generate a plan description for a given query text
	#;                Then list other Query Costs the user can select to see alternate Plans
	#;  Parameters:
	#;     1.  sql - A Pass By Reference (PBR) array/string containing the SQL Statement
	#;               in one of the following formats:
	#;                  Array:   sql=# of SQL Statement lines
	#;                           sql(n)=Each line of the SQL Statement text
	#;                  String:  sql=The SQL Statement text
	#;     2.  arr - 1 or 0 ("").  If 1, leave the resulting plan lines in the
	#;               array %AltPlan(CostID,1:%plan), otherwise output the plan using WRITE
	#;     3.  forTest - NOT USED, just a place holder to keep in line with ShowPlan^%apiSQL()
	#;     4.  showstats - (0,1,2,3).  0 default - do not show stats as part of the plan
	#;                                 1 run the SQL query to generate stats and output the stats as part of the plan text
	#;                                 2 means lookup the stats in %SYS.PTools.SQLStats
	#;                                 3 means generate alternate plan for the Portal
	#;     5.  packages = $List of package names that will be used as default packages/schemas
	#;     6.  schemapath.  If '="", set this value into %sqlSchemaPath, overriding any currently defined %sqlSchemPath
	#;     7.  preparse = 1 or 0.  If 1 first preparse the SQL statement to perform literal replacement.
	#;                    The default is 0, but the ShowPlan call from the SMP will call with preparse=1 so the
	#;                    Plan reflects the same execution path as the Execute Query will.
	#;     8.  idList = list of cost ids you want to generate stats for, Used by SMP, Alternate Show Plans
	#;     9.  silent - 1 or 0 (""). If 1, don't perform any writes within this method
	#;    10.  ph10    - Placeholder Parameter for JSL (ignoreOutliers)
	#;    11.  ph11    - Placeholder Parameter for JSL (dynargs)
	#;    12.  verbose - A flag to determine how the PBR '%plan(...)' array should be
	#;                   populated:
	#;                     0 = Populate the '%plan(...)' array with ONLY top-level module
	#;                         details, specified as Semi-XML in Linear Plan Format (LPF)
	#;                     1 = Populate the '%plan(...)' array with all module details,
	#;                         specified as Semi-XML in Linear Plan Format (LPF)
	#;                     2 = Populate the '%plan(...)' array with all module details,
	#;                         specified as Semi-XML in Inline Plan Format (IPF)
	#;                     3 = Populate the '%plan(...)' array with all module details,
	#;                         specified as Simple-Text in Inline Plan Format (IPF)
	#;                   NOTE: If the '%plan(...)' array is to be used as the input to
	#;                         the 'planHTML^%qaqplan()' method, then the 'verbose'  
	#;                         parameter must be equal to one (1)
	#;    13.  ph13    - Placeholder Parameter for uniformity between the <params> of the 
	#;                   'ShowPlan(<params>)' & 'ShowPlansAlt(<params>)' methods
	#;                   NOTE: Parameters (8-13) got out of sync with the 'ShowPlan(<params>)' method, so 
	#;                         Parameters (13-16) have been added to realign the <params> of these two methods!
	#;    14.  ph14    - Placeholder Parameter for (topq)
	#;    15.  ph15    - Placeholder Parameter for (noRTPC)
	#;    16.  ph16    - Placeholder Parameter for (json)
	#;    17.  inEXPLAIN - 0 = Not processing an SQL <explain statement>
	#;                     1 = Processing an SQL <explain statement>
	#;                    [InterSystems INTERNAL USE ONLY]
	#;    18.  ph18    - Placeholder Parameter for collectCost
	#;    19.  includeFiles - An optional $LIST(...) OR array of .INC files to use when
	#;                        processing the given 'sql' statement.  This PBR parameter can be
	#;                        specified in one of the following formats:
	#;                           $LIST(<inc file>[,<inc file>]*)
	#;                              OR
	#;                           includeFiles(<inc file>)=""
	#;                              ...
	#;                           includeFiles(<inc file>)=""
	#;    nn.  If you add a new parameter here, make sure to update the parameter list of 
	#;         the 'ShowPlan(...)' method so that these two method's parameters are
	#;         kept in sync!
	#;-------------------------------------------------------------------
	
	; %sqlcodegen contains the INT code for the last plan prepared.  This could be used to Run the Alternate query plan
	try {
		n %plan,%sqlcodegen,%SQLStats,%SYSTEMINCLUDE,%topincludes,cost,data,dmts,dmlmt,dmlsql,dseldict,err,exprfound,hash,Hash,i,id,incFile,incPos,level,list,macroInSQL,num,PPcost,sqlErr,sqlHold,sqlINT,sqlLn,sqlMAC,sqlOrig,sqlStatus,tSC
		n:'arr %AltPlan
		s:idList'="" idList=","_idList_","
		merge sqlOrig=sql  // Retain the original 'sql' value!
		if $d(sql)<10 { kill sql set sql($i(sql))=sqlOrig } // Ensure SQL Statement defined in 'sql(...)' array!
		if $d(includeFiles)'<9 { // --- Create a $LIST(...) of all 'incFile' Values ---
			set incFile="",includeFiles=""
			for { // --- Process All 'includeFiles(incFile)' Values ---
				set incFile=$o(includeFiles(incFile))
				QUIT:incFile=""  // No more 'incFiel' Values!
				
				set:'$LF(includeFiles,incFile) includeFiles=includeFiles_$LB(incFile)  // Add each unique 'incFile' to the $LIST(...)!
			}
		}
		set:'$LV(includeFiles) includeFiles=""  // Ensure valid $LIST(...) value!
		if includeFiles'="" { // --- Use the Specified 'includeFiles' Values to Expand any $$$MACROs found within the given SQL Statement 'sql' ---
			set macroInSQL=0
			for sqlLn=1:1:sql { // --- Search for any $$$MACROs Contained within the Specified SQL Statement 'sql' ---
				if sql(sqlLn)["$$$" { set macroInSQL=1 QUIT }  // Possible $$$MACRO found!
			}
			if macroInSQL { // --- Try to Expand Appropriate $$$MACROs Contained within the Specified SQL Statement 'sql' ---
				merge sqlHold=sql     // Save the original 'sql' array!
				kill ^||%sql.extract  // Tabula Rasa!
				set sqlMAC($i(sqlMAC(0)))="#INCLUDE %systemInclude"  // Primary System .INC File!
				for incPos=1:1:$LL(includeFiles) { // --- Process All .INC Files in 'includeFiles' ---
					set incFile=$LG(includeFiles,incPos)
					CONTINUE:incFile=""  // Skip Empty .INC File!
			  		
					set sqlMAC($i(sqlMAC(0)))="#INCLUDE "_incFile
				}
				for sqlLn=1:1:sql { // --- Add Embedded SQL Statement for Processing via 'LINES^%qarmac(...)' ---
					set sqlMAC($i(sqlMAC(0)))=$s(sqlLn=1:" &sql(",1:" ")_$g(sql(sqlLn))_$s(sqlLn=sql:")",1:"")
				}
				// --- Expand Appropriate $$$MACROs Contained within the Specified SQL Statement 'sql' ---
				do LINES^%qarmac("sqlMAC","sqlINT",,,,1,"sqlErr",,,,,,,,,,,.sqlStatus)
				
				kill sql  // Kill the original 'sql' array!
				merge:sqlStatus sql=^||%sql.extract(1)  // Set the 'sql' array with the Normalized SQL Statement from 'LINES^%qarmac(...)'!
				merge:'$d(sql) sql=sqlHold  // Restore the original 'sql' array if 'LINES^%qarmac(...)' failed!
			}
		}
		
		set tSC = $$possiblePlans^%SYS.PTools(.sql, 0, 0, 0, arr, showstats, packages, schemapath, preparse,,silent,verbose,,,,,inEXPLAIN)
		if $$$ISERR(tSC) { set %AltPlan = tSC  QUIT }
		; need to know if we are coming from ShowPlanAlt so we can get stats for the alternate plan.
		s:showstats showstats=3
		s level=$O(^||PPcost("data",1,1,""),-1)
		s cost=""
		if level'="" {
			for  {
				s cost=$O(^||PPcost("cost",level,cost))
				QUIT:cost=""
				s num=""
				for  {
					s num=$O(^||PPcost("cost",level,cost,num))
					QUIT:num=""
					do possiblePlans^%SYS.PTools(.sql, cost, num, level, 1, 0, packages, schemapath, preparse, .hash, silent, verbose,,,,,inEXPLAIN)
					; keep track of the different plans by a hash of the plan, use this to remove duplacates
					if (hash'="")&&'$D(Hash(hash)) {
						s i=$i(i)
						s list(i)=$LB(cost,num,^||PPcost("cost",level,cost,num,"map"))
						s Hash(hash)=""
					}
				}
			}
		}	
		i arr {									; no user interaction, generate an array with all possible plans
			s i=0
			f  {
				s i=$O(list(i),1,data)
				QUIT:i=""
				if idList'="" CONTINUE:idList'[(","_i_",")
				do possiblePlans^%SYS.PTools(.sql, $LG(list(i),1), $LG(list(i),2), level, arr, showstats, packages, schemapath, preparse,,silent,verbose,,,,,inEXPLAIN)
				i arr s %AltPlan=i,%AltPlan(i,0)=data m %AltPlan(i)=%plan
			}
		}
		elseif $o(list(""))'="" {				; user interaction, print selected plan to the terminal
			for {
				s i=""
				w !,"Select the ID to see the Plan for the Alternate Cost",!
				w !,?10,"ID",?15,"Cost",?25,"Map Type",?45,"Starting Map",!
				f  {
					s i=$O(list(i),1,data)
					QUIT:i=""
					w !,?10,i,?15,$LG(data,1),?25,$LG($LG(data,3),2),?45,$LG($LG(data,3),1)
				}	
				r !,"ID = ",id
				QUIT:id=""
				CONTINUE:$g(list(id))=""
				w !,!
				do possiblePlans^%SYS.PTools(.sql, $LG(list(id),1), $LG(list(id),2), level, arr, showstats, packages, schemapath, preparse,,0,verbose,,,,,inEXPLAIN)
				w !,!
			}
		}
	}
	catch {
		write:'silent !," Failed to generate alternate plans ",$ze
		set:$g(wrtref)'="" @wrtref@($s($g(@wrtref@(0))&&'$d(@wrtref@(@wrtref@(0),"error")):@wrtref@(0),1:$i(@wrtref@(0))),"error")=$LB($ZE,$ZN,"ShowPlanAlt","Failed to generate alternate plans:  <<<1>>>")
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
/// MRP1333,MRP1335,MRP1349
/// InterSystems INTERNAL USE ONLY! Do not document!
///
/// This method is invoked from the following locations and is used for
/// processing the both the <explain statement> and the 'GetSQLPlan(...)'
/// method, in addition to detailed error processing:
///    - %qaqpsq1.MAC      explain+?
///    - %SYSTEM.SQL.CLS   GetSQLPlan+? & Explain+?
///
getSQLPlan(&sql,planType="ShowPlan",&plan,callInfo="",showStats=0,qualifiers="{}",&dynArgs) [backgrnd,mt,planVal,qualObj,wrtref] PUBLIC {
#IF 0   ;------------------------------------------------------------------------------
 ; METHOD: getSQLPlan
 ; 
 ; DESCRIPTION:
 ;    Generate and return the SQL Query execution plan details for the specified
 ;    SQL Statement 'sql' and the other parameter values...
 ;    
 ;    NOTE: INTERNAL USE ONLY!
 ;
 ; Invocation:   This method can be invoked in the following ways:
 ;                  ObjectScript: $$getSQLPlan^%apiSQL(...)
 ;                           SQL: N/A
 ;
 ; PARAMETERS:
 ;   sql            - A Pass By Reference (PBR) array/string containing the SQL Statement
 ;                    in one of the following formats:
 ;                       Array:   sql=# of SQL Statement lines
 ;                                sql(n)=Each line of the SQL Statement text
 ;                       String:  sql=The SQL Statement text
 ;   planType       - The type of SQL Query plan information to return:           [DEFAULT: "ShowPlan"]
 ;                       "ShowPlan"    = The execution plan for an SQL statement
 ;                       "ShowPlanAlt" = The execution plan and all alternate execution
 ;                                       plans for an SQL statement
 ;                    NOTE: This parameter value takes precedence over any value
 ;                          passed via the 'qualifiers' parameter:
 ;                             qualifiers.all | qualifiers.alt
 ;   plan           - An Output parameter that returns the SQL Query execution plan details
 ;                    as a Refactored String (which is the default), a Dynamic Object 
 ;                    (JSON format), or an Array (if available) based on the value of the
 ;                    'qualifiers' parameter 'format' term.  This output is based on the
 ;                    given 'sql' statement and the following parameter values:
 ;                       planType, showStats & qualifiers
 ;
 ;                       IF qualObj.format["-ARRAY"
 ;                       THEN Return 'plan' as an array IFF an array is generated
 ;                          plan=# of plan lines
 ;                          plan(n)=Each line of the plan details
 ;                       ELSE Return 'plan' as a Refactored String or a <DYNAMIC OBJECT>
 ;                            based on the value of the qualifiers 'format' term
 ;                          plan=$s($isobject(planVal):planVal,1:$SYSTEM.SQL.RefactorSQLPlan("planVal",planType))
 ;
 ;                    NOTE: The qualifiers 'format' term can have the following values:
 ;                            "PRINT"             - Printable/Viewable format generates a Semi-XML
 ;                          | "LINEAR-XML"          output
 ;                                                    format-type: Refactored String, specified in
 ;                                                                 Linear Plan Format (LPF)
 ;                            "INLINE-XML"        - Printable/Viewable format generates a Semi-XML
 ;                                                  output
 ;                                                    format-type: Refactored String, specified in
 ;                                                                 Inline Plan Format (IPF)
 ;                            "INLINE-TEXT"       - Printable/Viewable format generates a Simple-Text
 ;                                                  output
 ;                                                    format-type: Refactored String, specified in
 ;                                                                 Inline Plan Format (IPF)
 ;                            "PRINT-ARRAY"       - Printable/Viewable format generates a Semi-XML
 ;                          | "LINEAR-XML-ARRAY"    output
 ;                                                    format-type: Array, specified in Linear 
 ;                                                                 Plan Format (LPF)
 ;                            "INLINE-XML-ARRAY"  - Printable/Viewable format generates a Semi-XML
 ;                                                  output
 ;                                                    format-type: Array, specified in Inline
 ;                                                                 Plan Format (IPF)
 ;                            "INLINE-TEXT-ARRAY" - Printable/Viewable format generates a Simple-Text
 ;                                                  output
 ;                                                    format-type: Array, specified in Inline
 ;                                                                 Plan Format (IPF)
 ;                            "JSON"              - JSON format generates a Machine Readable Query
 ;                                                  Plan (MRQP) rendered in a JSON format
 ;                                                    format-type: Dynamic Object
 ;
 ;                       ** The value passed to the qualifiers 'format' term takes precedence
 ;                          over any value passed to the 'qualifiers' 'verbose' term!
 ;   callInfo       - A $LIST(...) of information about who is calling this method:
 ;                       1) SQL Statement/Function    { EXPLAIN | %SYSTEM.QUERY_PLAN | 
 ;                                                      $SYSTEM.SQL.Explain | 
 ;                                                      $SYSTEM.SQL.GetSQLPlan }
 ;                       2) SQL Interface             { EMB | DYN }
 ;                       3) SQL Statement Type        { SELECT | INSERT | ... }
 ;                       4) SQL Parsing Flag          { 0 | 1 }
 ;                       5) UCQ Flag                  { 0 | 1 }
 ;                       6) SQL Preparse Flag         { 0 | 1 }
 ;                  --- Embedded SQL Statement Parsing Error Specific Information ---
 ;                      10) SQLCODE                   { -481[a] | -482[a] }
 ;                      11) %msg              ($$$FormatMessage(,"%Parser","e"_$zabs(SQLCODE),,{<args>}))
 ;                    NOTE: This information is used for error processing
 ;   showStats      - A flag to determine whether to generate Runtime Performace Statistics
 ;                    for each module within the PBR 'plan(...)' details:         [DEFAULT: 0]
 ;                       0 = Don't generate Runtime Performace Statistics
 ;                       1 = Generate Runtime Performace Statistics
 ;                    NOTE: This parameter value takes precedence over any value
 ;                          passed via the 'qualifiers' parameter:
 ;                             qualifiers.stat | qualifiers.stats
 ;   qualifiers     - Any number of command-line (qualifier) arguments in one of the
 ;                    following formats:                                          [DEFAULT: "{}"]
 ;                       Legacy String:  "/[no]<qualifier>[=<value>][.../[no]<qualifier>[=<value>]]
 ;                        Example:       "/all/verbose=0" OR "/all/noverbose"
 ;                       JSON String:    "{""<qualifier>"":<value>[...,""<qualifier>"":<value>]"
 ;                        Example:       "{""all"":1,""verbose"":""0""}"
 ;                       Dynamic Object: {"<qualifier>":<value>[...,"<qualifier>":<value>]}
 ;                        Example:       {"all":1,"verbose":"0"}
 ;
 ;                    NOTE: This parameter is only used when the 'SQL Statement/Function'
 ;                          $LG(callInfo,1) is equal to "$SYSTEM.SQL.Explain",
 ;                          "$SYSTEM.SQL.GetSQLPlan" OR ""
 ;   dynArgs        - A Pass By Reference (PBR) array of dynamic arguments for the specified 
 ;                    SQL Statement 'sql' with the following format:
 ;                       dynArgs=# of dynamic arguments
 ;                       dynArgs(n)=Each dynamic argument value
 ;
 ;                    NOTE: Each dynamic argument value will be substitute for each of the
 ;                          placeholders '?' within the specified SQL Statement 'sql'
 ;                          during SQL Query execution plan processing
 ;
 ; RETURN Value: The status of this method's invocation in the following format:
 ;                  "" = Valid invocation - no errors
 ;                  $LIST(...) of Error Information: <error detail>  (<error example>)
 ;                         1) Error             ($ZE: <SYNTAX>errdone+2^%qaqqt)
 ;                         2) Routine           ($ZN: %apiSQL)
 ;                         3) Method            (ShowPlan)
 ;                         4) General Message   (Unexpected Error:  <<<1>>>)
 ;                         5) SQLCODE           (-29)
 ;                         6) %msg - Generic    ($$sqlcode(SQLCODE): Field not found in the applicable tables)
 ;                         7) %msg - Specific   ( Field 'NAM' not found in the applicable tables^SELECT Nam FROM)
 ;                  --- EXPLAIN/ShowPLan[Alt] Specific Information ---
 ;                        10) SQLCODE           { -481[a] | -482[a] }
 ;                        11) %msg              ($$$FormatMessage(,"%Parser","e"_$zabs(SQLCODE),,{<args>}))
 ;                             [Single Quotes Doubled ('')]
 ;
#ENDIF  ;------------------------------------------------------------------------------
	
	new backgrnd,wrtref
	new %AltPlan,%plan,%planErr,planVal,qualObj
	
	set tSC=$$$OK,$ZE="",status=""
	kill plan set plan=""  // Tabula Rasa!
	
 try {
	// --- Process 'qualifiers' ---
	set verboseIsSet=$s("{}"[qualifiers:0,$isobject(qualifiers):qualifiers.verbose'="",1:$$$UPPER(qualifiers)["VERBOSE")
	set tSC=$SYSTEM.SQL.ParseQualifiers(qualifiers,.qualObj)
	if $$$ISERR(tSC) { // --- 'qualifiers' Error ---
		set $LIST(status,10,11)=$LB(-400,"'qualifiers' parameter error: "_$$$GETERRORMESSAGE(tSC))
		RETURN status
	}
	
	// --- Deconstruct the 'callInfo' $LIST(...) ---
	set:callInfo="" callInfo=$LB("getSQLPlan","DYN")
	set $LG(sqlStmtFunc,sqlInterface,sqlStmtType,sqlParsingFlag,ucqFlag,sqlPreparseFlag,,,,SQLCODE,sqlErrMsg)=callInfo
	
	// --- Don't modify the original PBR 'sql' array with errors during processing! ---
	if $d(sql)>1 { merge sqlTest=sql }
	else { for piece=1:1:$l(sql,$c(10)) { set sqlTest($i(sqlTest))=$p(sql,$c(10),piece) } } // Create 'sqlTest(...)' array from $c(10) pieces of 'sql'!
	
	if ",,UNKNOWN,"[(","_sqlStmtType_",") { // --- Probably Invoking Dynamic SQL with Host-Variable Substitution OR EXPLAIN API/Method Invocation, so Determine SQL Type ---
		set sqlStmtType=$$getSQLStmtType^%qaqpsq1(.sql)
		set $LIST(callInfo,3)=sqlStmtType
	}
	
	// --- Ensure 'qualifiers' Object 'qualObj' has Default Values ---
	set:sqlStmtFunc="" sqlStmtFunc="getSQLPlan"  // This method!
	set:sqlPreparseFlag="" sqlPreparseFlag=$s(",EXPLAIN,$SYSTEM.SQL.Explain,getSQLPlan,$SYSTEM.SQL.GetSQLPlan,"[(","_sqlStmtFunc_","):1,1:+qualObj.preparse)  // Default 'preparse' to 1 for the SQL <explain statement> and related API methods!
	set qualObj.preparse=sqlPreparseFlag
	set:planType="" planType=$s(+qualObj.all || +qualObj.alt:"ShowPlanAlt",1:"ShowPlan")
	set:showStats="" showStats=(+qualObj.stat || +qualObj.stats)
	set:qualObj.selectmode="" qualObj.selectmode=$s(sqlStmtFunc="EXPLAIN":"Logical",sqlStmtFunc="$SYSTEM.SQL.Explain":"Logical",1:"")  // Default 'selectmode' to "Logical" (0) for the <explain statement>!
	set:qualObj.silent="" qualObj.silent=$s(sqlStmtFunc="$SYSTEM.SQL.Explain":+qualObj.quiet,1:1)
	set qualObj.format=$$$UPPER(qualObj.format)  // Ensure UPPERCASE for proper comparisons later!
	set qualObj.verbose=$s(qualObj.format["PRINT":$s(verboseIsSet&&(qualObj.verbose<2):qualObj.verbose,1:0),qualObj.format["LINEAR-XML":$s(verboseIsSet&&(qualObj.verbose<2):qualObj.verbose,1:0),qualObj.format["JSON":0,qualObj.format["INLINE-XML":2,qualObj.format["INLINE-TEXT":3,verboseIsSet:+qualObj.verbose,1:3)
	set:qualObj.format="" qualObj.format=$CASE(qualObj.verbose,2:"INLINE-XML",3:"INLINE-TEXT",:"PRINT")
	set:qualObj.frozenplans="" qualObj.frozenplans=1 set:qualObj.outliers="" qualObj.outliers=1 // Default unassigned 'NOT' Parameters!
	set inEXPLAIN=$s(sqlStmtFunc="EXPLAIN":1,sqlStmtFunc="$SYSTEM.SQL.Explain":1,1:0)
	try { Xecute:$e(qualObj.packages,1)="$" "set qualObj.packages="_qualObj.packages } catch {}              // Reset 'qualObj.packages' to Correct Value!
	try { Xecute:$e(qualObj.schemapath,1)="$" "set qualObj.schemapath="_qualObj.schemapath } catch {}        // Reset 'qualObj.schemapath' to Correct Value!
	try { Xecute:$e(qualObj.includefiles,1)="$" "set qualObj.includefiles="_qualObj.includefiles } catch {}  // Reset 'qualObj.includefiles' to Correct Value!
	
	if +SQLCODE'=0 { // --- Embedded SQL Parsing Error occurred, so report it (Pass-through) ---
#IF 0	//MRP1333+	[ADD BACK AFTER ADDING <explain statement> UCQ ENHANCEMENT]
		set $LIST(status,10,11)=$LB(SQLCODE,sqlErrMsg)
		RETURN status
#ELSE	//MRP1333=	[REMOVE AFTER ADDING <explain statement> UCQ ENHANCEMENT]
		if ucqFlag||(SQLCODE[-481) { // --- Error occurred within a UCQ OR Unsupported SQL Statement Type ---
			set $LIST(status,10,11)=$LB(SQLCODE,sqlErrMsg)
			RETURN status
		}
#ENDIF	//MRP1333-
	}
	
	if ",,SELECT,UPDATE,DELETE,"'[(","_sqlStmtType_",") { // --- Process All EXPLAIN Un-Supported DML/DDL Statements ---
		set ecode=481_$s(",%SYSTEM.QUERY_PLAN,$SYSTEM.SQL.Explain,$SYSTEM.SQL.GetSQLPlan,"[(","_sqlStmtFunc_","):"a",1:""),SQLCODE="-"_ecode
		set sqlErrMsg=$s(ecode["a":$$$FormatMessage(,"%Parser","e"_ecode,,sqlStmtFunc,sqlStmtType),1:$$$FormatMessage(,"%Parser","e"_ecode,,sqlStmtType))
		set $LIST(status,10,11)=$LB(SQLCODE,sqlErrMsg) // Record EXPLAIN/ShowPLan[Alt] Specific Information!
		RETURN status
	}
	
	set backgrnd=1,wrtref="%planErr"  // Record any SQL errors in the '%planErr' array!
	
	if planType="ShowPlan" { // --- Get 'ShowPlan(...)' Details ---
		do ShowPlan^%apiSQL(.sqlTest,1,0,showStats,qualObj.packages,qualObj.schemapath,sqlPreparseFlag,qualObj.selectmode,'+qualObj.frozenplans,+qualObj.silent,'+qualObj.outliers,.dynArgs,+qualObj.verbose,,,(qualObj.format="JSON"),inEXPLAIN,,qualObj.includefiles)
		merge:'$g(@wrtref@(0)) planVal=%plan
	}
	elseif planType="ShowPlanAlt" { // --- Get 'ShowPlanAlt(...)' Details ---
		do ShowPlanAlt^%apiSQL(.sqlTest,1,0,showStats,qualObj.packages,qualObj.schemapath,sqlPreparseFlag,qualObj.ids,+qualObj.silent,,,+qualObj.verbose,,,,,inEXPLAIN,,qualObj.includefiles)
		if '$g(@wrtref@(0)) { // --- No Errors returned from the 'ShowPlanAlt^%apiSQL(...)' method invocation ---
			set planStr=$SYSTEM.SQL.RefactorSQLPlan("%AltPlan",planType)
			if planStr="<plans></plans>" { set planVal=0 }  // Empty 'planVal/plan'!
			else { merge planVal=%AltPlan }  // Valid 'planVal/plan'!
		}
	}
	
	if $d(@wrtref)>1 { // --- Process SQL Error ---
		set status=$g(@wrtref@(@wrtref@(0),"error"))
		set errMsg="SQLCODE = "_$s($LG(status,5)'="":$LG(status,5)_" : "_$LG(status,7),1:"-400 :  "_$LG(status,1))
		if $LG(status,5)=-99 { set sqlStmtFunc="EXPLAIN",ecode=99,SQLCODE="-"_ecode,%msg=$LG(status,7),sqlErrMsg=$$$FormatMessage(,"%Parser","e"_ecode,,errMsg) }
		elseif sqlStmtFunc="EXPLAIN" { set ecode=482,SQLCODE="-"_ecode,sqlErrMsg=$$$FormatMessage(,"%Parser","e"_ecode,,errMsg) }
		else { set ecode="482a",SQLCODE="-"_ecode,sqlErrMsg=$$$FormatMessage(,"%Parser","e"_ecode,,sqlStmtFunc,errMsg) }
		set $LIST(status,10,11)=$LB(SQLCODE,sqlErrMsg) // Record EXPLAIN/ShowPLan[Alt] Specific Information!
	}
	elseif '$g(planVal) { // --- Process Empty SQL Plan ---
		if sqlStmtType="" { // --- Determine the SQL Statement Type ---
			if $g($$$mtStatementType)'="" { set sqlStmtType=$$GetTypen^%SYS.SQLSRV($$GetType^%SYS.SQLSRV($$$mtStatementType)) }
			if sqlStmtType="" { set sqlStmtType=$$getSQLStmtType^%qaqpsq1(.sql) }
		}
		if sqlStmtFunc="EXPLAIN" { // --- Process Empty <explain statement> ---
			set ecode=481,SQLCODE="-"_ecode,sqlErrMsg=$$$FormatMessage(,"%Parser","e"_ecode,,sqlStmtType)
		}
		else { // --- Process Empty EXPLAIN API/Method Invocation ---
			set ecode="481a",SQLCODE="-"_ecode,sqlErrMsg=$$$FormatMessage(,"%Parser","e"_ecode,,sqlStmtFunc,sqlStmtType)
		}
		set $LIST(status,10,11)=$LB(SQLCODE,sqlErrMsg) // Record EXPLAIN/ShowPLan[Alt] Specific Information!
	}
	else { // --- Populate the Output parameter 'plan' ---
		if qualObj.format["-ARRAY",$d(planVal)>10 { // --- Return 'plan' as an Array ---
			merge plan=planVal
		} 
		else { // --- Return 'plan' as a Refactored String or a <DYNAMIC OBJECT> ---
			set plan=$s($isobject(planVal):planVal,1:$SYSTEM.SQL.RefactorSQLPlan("planVal",planType))
		}
	}
 }
 catch {
	set $LIST(status,10,11)=$LB(-400,"$ZE: "_$ZE)
 }
	RETURN status
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
TuneSchema(schema,update,display,pMessage,KeepClassUpToDate=0,ClearValues=0,pLogFile="",pRecompileCQ=0,pSamplePerc="",&sqlcode) [] PUBLIC {
	#;  Function:     TuneSchema^%apiSQL(schema,update,display)
	#;  Description:  Calculate accurate extentsize and selectivity for
	#;                all tables in a schema.
	#;  Parameters:
	#;     1.  schema  Name of a schema to tune all tables of.
	#;                 If the schema name is omitted, the default schema
	#;                 is used.
	#;     2.  update  (1 or 0 flag).  Tells tuner whether to update the
	#;                 table and class definitions with the new extentsize
	#;                 and selectivity values.
	#;                 If update=1, the values will be updated in the table
	#;                 and class definition.
	#;     3.  display (1 or 1 flag).
	#;     4.  pMessage    Passed by reference.  May return error information.
	#;     5.  KeepClassUpToDate - 
	#;	   TRUE(1)/FALSE(0) flag.  If TRUE (and <i>update</i> is TRUE), 
	#;         the class definition will be updated with the new EXTENTSIZE and SELECTIVITY values, 
	#;         but the class definition will be kept as up-to-date.  In many cases, however, it is 
	#;         desirable to recompile the class after it's table has been tunes so that queries in 
	#;         the class definition can be recompiled and the SQL query optimizer can use the updated 
	#;         data statistics.  The default is FALSE (0).
	#;          Note that if the class is deployed the class definition will not be updated.
	#;     6.  ClearValues -
	#;         TRUE(1)/FALSE(0) flag. If TRUE (and <i>update</i> is TRUE), the SELECTIVITY and EXTENTSIZE 
	#;         settings ill be cleared from the class and table definition.  Note that if the class is deployed
	#;         the class definition will not be updated.
	#;     7.  LogFile - 
	#;         Optional name of a file to log the output of the TuneTable utility to.
	#;         if display is also TRUE, output will go to the current device and the log file.
	#;	8. pRecompileCQ - Default value is 0.  Optional value, if TRUE(1) attempt to recompile cached queries instead of purging them.
	#;	    If the recompile encounters any errors, the cached query will be purged.  This will only work if the the Keep Cached Query Source SQL setting is TRUE.
	#;	    When the Keep Cached Query Source setting is FALSE the cached classes are deployed and cannot be recompiled.
	#;	9. pSamplePerc - The percentage of rows of the table to be used for sampling the data for the TuneTable utility.  This percentage can be specified as .## or ##%.  
	#;          For example .12 or 12% will cause TuneTable to use 12% of the rows in the table when sampling the data.  This value does not usually need to be specified when calling TuneTable.
	#;          Only specify this value when potential outlier values for a field are not evenly distrubuted among rows throughout the table. 
	#;          Note, for any table with an extentsize < 1000, the entire extent will be used by TuneTable.
	#;  10. sqlcode - PBR, used for the last SQLCODE if an error occurred.
	#;
.
	new %msg,%protocol
	d Schema^%qarTune($g(schema),+$g(update),+$g(display),KeepClassUpToDate,ClearValues,pLogFile,pRecompileCQ,pSamplePerc,.sqlcode)
	set:$g(%msg)'="" pMessage=%msg
	QUIT
}
.
TuneTable(table,update,display,pMessage,KeepClassUpToDate=0,ClearValues=0,pLogFile="",extentsize="",pRecompileCQ=0,pSamplePerc="",&sqlcode,&%TTNS) [SQLCODE] PUBLIC {
	#;  Function:     TuneTable^%apiSQL(table,update,display)
	#;  Description:  Calculate accurate extentsize and selectivity for
	#;                a table and it's fields.
	#;  Parameters:
	#;     1.  table   Name of a table or '*' to tune all tables.
	#;                 The name may be qualified with a schema name:
	#;                      Medical.Patient
	#;                 If the schema name is omitted, the default schema
	#;                 is used.
	#;     2.  update  (1 or 0 flag).  Tells tuner whether to update the
	#;                 table and class definitions with the new extentsize
	#;                 and selectivity values.
	#;                 If update=1, the values will be updated in the table
	#;                 and class definition.
	#;     3.  display (1 or 1 flag).
	#;     4.  pMessage - PBR
	#;     5.  KeepClassUpToDate - 
	#;	   TRUE(1)/FALSE(0) flag.  If TRUE (and <i>update</i> is TRUE), 
	#;         the class definition will be updated with the new EXTENTSIZE and SELECTIVITY values, 
	#;         but the class definition will be kept as up-to-date.  In many cases, however, it is 
	#;         desirable to recompile the class after it's table has been tunes so that queries in 
	#;         the class definition can be recompiled and the SQL query optimizer can use the updated 
	#;         data statistics.  The default is FALSE (0).
	#;          Note that if the class is deployed the class definition will not be updated.
	#;     6.  ClearValues -
	#;         TRUE(1)/FALSE(0) flag. If TRUE (and <i>update</i> is TRUE), the SELECTIVITY and EXTENTSIZE 
	#;         settings ill be cleared from the class and table definition.  Note that if the class is deployed
	#;         the class definition will not be updated.
	#;     7.  LogFile - 
	#;         Optional name of a file to log the output of the TuneTable utility to.
	#;         if display is also TRUE, output will go to the current device and the log file.
	#;     8. extentsize -
	#;	   Optional value to be used for the table ExtentSize instead of executing a COUNT(*) query to get the value.
	#;     9. pRecompileCQ - Default value is 0.  Optional value, if TRUE(1) attempt to recompile cached queries instead of purging them.
	#;	    If the recompile encounters any errors, the cached query will be purged.  This will only work if the the Keep Cached Query Source SQL setting is TRUE.
	#;	    When the Keep Cached Query Source setting is FALSE the cached classes are deployed and cannot be recompiled.
	#;    10. pSamplePerc - The percentage of rows of the table to be used for sampling the data for the TuneTable utility.  This percentage can be specified as .## or ##%.  
	#;          For example .12 or 12% will cause TuneTable to use 12% of the rows in the table when sampling the data.  This value does not usually need to be specified when calling TuneTable.
	#;          Only specify this value when potential outlier values for a field are not evenly distrubuted among rows throughout the table. 
	#;          Note, for any table with an extentsize < 1000, the entire extent will be used by TuneTable.
	#;    11. sqlcode - PBR, used for the TUNE TABLE statement, called from statement's generated code to possibly populate SQLCODE if an error occurred.
	#;
.
	new %msg,%protocol
	do ^%qarTune($g(table),+$g(update),+$g(display),KeepClassUpToDate,ClearValues,pLogFile,extentsize,pRecompileCQ,pSamplePerc,.sqlcode,.%TTNS)
	set:$g(%msg)'="" pMessage=%msg
	QUIT
}
 
 
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;   SQL UTILITY STUFF
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
FDBMS	;
	#;  Function:     FDBMS^%apiSQL
	#;  Description:  Will load an FDBMS DDL Export file
	g FDBMS^%qarSQLImport
 
IRIS	; 
Cache	;
	#;  Function:     IRIS^%apiSQL
	#;  Description:  Will load an IRIS SQL DDL Export file
	g Cache^%qarSQLImport
 
 
Oracle	;
	#;  Function:     Oracle^%apiSQL
	#;  Description:  Will load an Oracle DDL Export file
	g Oracle^%qarSQLImport
 
 
MSSQLServer	;
	#;  Function:     MSSQLServer^%apiSQL
	#;  Description:  Will load an MS SQL Server DDL Export file
	g MSSQLServer^%qarSQLImport
 
 
Sybase	;
	#;  Function:     Sybase^%apiSQL
	#;  Description:  Will load a Sybase DDL Export file
	g Sybase^%qarSQLImport
 
 
Informix	;
	#;  Function:     Informix^%apiSQL
	#;  Description:  Will load an Informix DDL Export file
	g Informix^%qarSQLImport
 
 
InterBase	;
	#;  Function:     InterBase^%apiSQL
	#;  Description:  Will load an InterBase DDL Export file
	g InterBase^%qarSQLImport
 
QOPlanner(infile,outfile,eos="GO",schemapath="")	// DPV3372
	#;  Function:     QOPlanner^%apiSQL
	#;  Description:  creates a QOPlanner file from an SQL script file
	#;
	#;  Parameters:
	#;     1.  infile  The full path name of the script file to import.  Required
	#;     2.  outfile The full path name of the file to report optimizer plans in.
	#;     3.  eos     Optional.  End of statement delimiter.  Will default to "GO"
	#;     4.  schemapath - Optional  "," list of schema names that define the schema path.  
	#;                      Can include DEFAULT_SCHEMA, bit not CURENT_SCHEMA or CURRENT_PATH
	
		// for each schema in the schema path, fold it to upper and handle DEFAULT_SCHEMA
	if schemapath'="" {
		for i=1:1 {
			set schema=$$$UPPER($p(schemapath,",",i)) quit:schema=""
			set:schema="CURRENT_SCHEMA" schema=$$$DEFAULTSCHEMA
			set $p(schemapath,",",i)=schema
		}
		set schemapath=$listfromstring(schemapath)
	}
	do DDLImport("IRIS",$username,infile,outfile,0,,eos,0,1,schemapath)
	QUIT
.
 
DDLImport(%DDLMode,%msql="",infile="",outfile=0,nosup,nosupfile="",deos,errpause,%optPlan=0,schemapath="",verbose=1,ignoreerrors=1,table=0,resultid=0)
	#;  Function:     DDLImport^%apiSQL
	#;  Description:  Non-interactive entry point for SQL script file loading
	#;
	#;  Parameters:
	#;     1.  %DDLMode Vendor from which the script file originalted.  Required
	#;                 Supported values are:
	#;                      IRIS/Cache
	#;                      FDBMS
	#;                      Informix
	#;                      Interbase
	#;                      MSSQLServer
	#;                      Oracle
	#;                      Sybase
	#;     2.  %msql   This parameter is deprecated and no longer used.  The owner of new classes is always defined as the $Username of the process that executed the DDL statement
	#;     3.  infile  The full path name of the script file to import.
	#;                 If this is a $list value, the first element is the file name and the second element is the TranslateTable for the input stream file if this is MSSQLServer, Sybase, Informix, and MySQL
	#;     4.  outfile The full path name of the file to report errors in.
	#;                 Optional.  Default is the same as the infile with a "_Errors.log" extension.
	#;     5.  nosup   Optional.  0/1 flag which determines if unsupported statements
	#;                 from the script file should be recorded in the nosupfile.
	#;     6.  nosupfile Optional.  If nosup is true, the name of the file to log
	#;                 the unsupported statements in.  Default is the same as the
	#;                 infile with a "_Unsupported.log" extension.
	#;                 If this is a $list value, the first element is the file name and the second element are the open parameters to use for the file.  The default OPEN parameters are "WNS"
	#;     7.  deos    Optional.  End of statement delimiter.  Will default to an
	#;                 appropropriate value based on the value of %DDLMode.
	#;     8.  errpause Optional.  Number of seconds to pause after an error occurs.
	#;                 The default is 5 seconds.
	#;     9.  %optPlan  Optional.  1/0 flag.  Default is 0.  If one, we are not importing
	#;                 and executing any statements, just getting the plan of each query. (DPV3372)
	#;    10.  schemapath - Optional, used only with %optPlan=1, schema path is passed through to ShowPlan
	#;    11.  verbose Optional.
	#;    12.  ignoreerrors Optional.
	#;	  13.  table   Optional. If the value of table is true, that means we will be using %SQL_Diag table instead of a log file.
	#;	  13.  resultid   Optional. ID necessary to point to the correct entry in the %SQL_Diag tables
	#;
	if $g(%DDLMode)="" {QUIT $$$ERROR($$$DDLImportDialectNotSpecified)}
	new tDynamicDialect
	set %DDLMode=$$$UPPER(%DDLMode)
	set tDynamicDialect = $Listfind($$$SQLDIALECTDYNAMICUPPER,%DDLMode)
.
	new %inparams
	if infile'="",$listvalid(infile) { set %inparams=$lg(infile,2),infile=$lg(infile,1) }
	if (table=0) && (($get(outfile)="") || ($get(outfile)=0)) { set outfile=$$$AllButLastPiece(infile,".")_"_Errors.log" }
.
		// We don't have a ObjectScript parser yet so let's leave the IRIS dialect to the ObjectScript code
	if (tDynamicDialect) && (tDynamicDialect > 3) {  // MSSQLServer and Sybase
		new eos,err,message,%msg,%protocol,tInputStream,tLog,tStatus,tUnsupportedLog
		set %DDLMode = $List($$$SQLDIALECTDYNAMIC,tDynamicDialect)
		set eos = $Get(deos,"GO")
		if $get(infile)="" { write !,"DDL Script File not specified" QUIT $$$ERROR($$$DDLScriptFileNotspecified)}
		set nosup=''$get(nosup)
		if (nosup) && ($get(nosupfile) = "") { set nosupfile = $$$AllButLastPiece(infile,".")_"_Unsupported.log" }
		set tInputStream = ##class(%Stream.FileCharacter).%New()
		if $g(%inparams)'="" { set tInputStream.TranslateTable=%inparams }
		set tStatus = tInputStream.LinkToFile(infile)
		if tInputStream.%IsNull() = 1 || (tInputStream.SizeGet() = 0) {
			write !,"Input file '"_infile_"' does not exist or is empty"
			quit $$$ERROR($$$DDLInputFileDoesNotExist,infile)
		}
		if $$$ISOK(tStatus) {
			set tInputStream.LineTerminator = $Char(13,10)
			set tLog = $CASE(table, 1:"", :##class(%XSQL.Log).%New(outfile))
			if nosup { set tUnsupportedLog = ##class(%XSQL.Log).%New(nosupfile) } else { set tUnsupportedLog = "" }
			set iStatus = ##class(%SQL.Util.Import).Import(%DDLMode, tInputStream, tLog, tUnsupportedLog,,,deos, verbose, verbose, ignoreerrors, table, resultid)
		}
		else {
			write !,"Input file is not valid. Error reported: ",!
			do $system.OBJ.DisplayError(tStatus)
			set iStatus = tStatus
		}
		QUIT iStatus
	}
	new cnt,code,eos,i,j,mode0,mode1,nocheck,QUIT,rtn,SQL,sql,sqllines,time1,w	// DPV2119 Don't new nosup, they are parameters
	set cnt=0,mode0=$c(27,91,109),mode1=$c(27,91,49,109),QUIT=0
	if '$g(%sqldebug) { new %sqldebug set %sqldebug=0 }
	if %DDLMode="FDBMS"||(%DDLMode="IRIS")||(%DDLMode="CACHE") {}
	elseif %DDLMode="ORACLE"    { set %DDLMode="Oracle" }
	elseif %DDLMode="ORACLE" { set %DDLMode="Oracle" }
	elseif %DDLMode="INTERBASE" { set %DDLMode="InterBase" }
	elseif %DDLMode="INFORMIX"  { set %DDLMode="Informix" set outputStatus = $$InformixLoad^%qarSQLImport(infile,outfile,$g(deos,";"),,,$g(%inparams),verbose,ignoreerrors,resultid) QUIT outputStatus}	
	elseif %DDLMode="MYSQL"     { set %DDLMode="MySQL" set outputStatus = $$InformixLoad^%qarSQLImport(infile,outfile,$g(deos,";"),,,$g(%inparams),verbose,ignoreerrors,resultid) QUIT outputStatus }
	if $g(deos)="" { set eos=$s(%DDLMode="Sybase"||(%DDLMode="MSSQL")||(%DDLMode="IRIS")||(%DDLMode="CACHE"):"GO",1:";") }
	else { set eos=$$$UPPER(deos) }
	if $get(infile)="" { write !,"DDL Script File not specified" QUIT $$$ERROR($$$DDLScriptFileNotspecified)}
	set nosup=''$get(nosup)
	if nosup,$get(nosupfile)="" { set nosupfile=$$$AllButLastPiece(infile,".")_"_Unsupported.log" }
	open infile:("R"):5 else  write !,"Unable to OPEN (for READ) file: "_infile QUIT $$$ERROR($$$DDLUnableToOpenInputFile,infile)
	if 'table {open outfile:("WNS"):5 else  write !,"Unable to OPEN (for WRITE) file: "_outfile close infile QUIT $$$ERROR($$$DDLUnableToOpenOutputFile,outfile)}
	if nosup { open nosupfile:("WNS"):5 else  write !,"Unable to OPEN (for WRITE) file: "_nosupfile close infile,outfile QUIT $$$ERROR($$$DDLUnableToOpenOutputFile,nosupfile) }
	goto entry^%qarSQLImport
 
 
 
QueryToTable(&query,table,display) [] PUBLIC {
	#;  Function:     QueryToTable^%apiSQL
	#;  Description:  This utility takes a query, executes the query, and
	#;                the results of the query are turned into a new table
	#;                of name 'table'. Returns a %Status to indicate success or failure.
	#;  Parameters:   query   - The query text to execute.
	#;                          Expected format is:
	#;                              query = "query text"  
	#;                          OR
	#;                              query = # of lines
	#;                              query(1) = query line 1
	#;                              query(n) = query line n
	#;                table   - the name of the new SQL table to generate
	#;                display - 0/1 flag to determine if output should be
	#;                          displayed on the terminal
	return $$%qarCopyTable^%qarCopyTable(.query, table, display)
}
 
 
DropTable(tablename,deldata,SQLCODE,%msg) ;
	#;  Function:     DropTable^%apiSQL
	#;  Description:  This entry point can be used to delete a table 
	#;                definition.
	#;  Parameters:   tablename - name of the table to delete (required)
	#;                deldata   - 1/0 flag which determine if the table's 
	#;                            data is to be deleted or not.
	#;                            If "" or undefined, use system flag to 
	#;                            determine if data should be deleted.
	#;                SQLCODE   - Passed by reference.  Returns SQLCODE 
	#;                            contains 0 (success) or number < 0 (error)
	#;                %msg      - Passed by reference.  If SQLCODE<0, 
	#;                            contains error message.
	#;
	s %msg="",SQLCODE=0
	i $g(tablename)="" s SQLCODE=-400,%msg="No table name supplied for DropTable call"
	s tablename=$$IntQualifiedName^%apiSQL(tablename)
	s deldata=$g(deldata)
	i $$DropTable^%apiDDL(tablename,"",deldata,.SQLCODE,1) QUIT
	i $g(%msg)="",SQLCODE<0 s %msg=$$sqlcode(SQLCODE)
	QUIT
 
 
DropView(viewname,&SQLCODE,&%msg,behave="RESTRICT") [] PUBLIC {
	#;  Function:     DropView^%apiSQL
	#;  Description:  This entry point can be used to delete a view 
	#;                definition.
	#;  Parameters:   viewname  - name of the view to delete (required)
	#;                SQLCODE   - Passed by reference.  Returns SQLCODE 
	#;                            contains 0 (success) or number < 0 (error)
	#;                %msg      - Passed by reference.  If SQLCODE<0, 
	#;                            contains error message.
	#;                behave    - RESTRICT or CASCADE.  Default is RESTRICT
	#;
	set %msg="",SQLCODE=0
	if $g(viewname)="" { set SQLCODE=-400,%msg="No view name supplied for DropView^apiSQL call" QUIT  }
	set viewname=$$IntQualifiedName(viewname)
	set sc=$$DropView^%apiDDL(viewname,behave,.SQLCODE,1,.%msg)
	QUIT
}
 
 
Shell	;
	#;  Function:     Shell^%apiSQL
	#;  Description:  This entry point can be used to execute SQL statements from
	#;                      the command line.
	#;
		#; DLP: Update to use the new shell.
	Do ##class(%SQL.Shell).%Go()
	#; Do Shell^%ourISQL
	QUIT
 
 
IntQualifiedName(table) ;   INTERNAL - UNDOCUMENTED FUNCTION
	#;  Function:     IntQualifiedName^%apiSQL(table)
	#;  Description:  Given a table name or unqualified table name,
	#;                return our internal qualified format of schema.table
	#;                where table's '.'s are converted to $c(2).
	#;
	
	RETURN:$g(table)="" ""
	if table'[".",$e(table)'="""" { RETURN $$$DefaultSchemaQL_"."_table }		// was unqualified name and unquoted table
	RETURN:table'["""" table							// schema and table are not quoted
	if $e(table)'="""" {	// schema is not quoted, but qualified name contains a quote character.  table might be quoted identifier
		new schema
		set schema=$p(table,".",1),table=$p(table,".",2,*)
		if $e(table)="""",$e(table,*)="""" { RETURN schema_"."_$tr($$$StripQuotes(table),".",$c(2)) }	//  schema is not quoted, table is quoted
		RETURN schema_"."_$tr(table,".",$c(2))	// schema name was not quoted and table name was not quoted but at least one contains quotes
	}
		#; if we get here table begins with a quote
	if $e(table,*)'="""" {  // table does not end with a quote, schema name is quoted, table is not
		RETURN $$$StripQuotes($p(table,".",1,$l(table,".")-1))_"."_$p(table,".",$l(table,"."))  ; schema is del id, table reg id.
	}
		#;  If we get here, we either have a delimited table name or deleimited schema and table names.
	RETURN:table'["." $$$DefaultSchemaQL_"."_$$$StripQuotes(table)			// We have delimited table name without '.'
	#;  Gotta find if any '.' is schema/table separator, or part of the name
	new found,i
	set found=0
	for i=1:1:$l(table) {
		if $e(table,i)=".",$l($e(table,1,i),"""")#2 { set found=i quit }
	}
	if found { RETURN $$$StripQuotes($e(table,1,found-1))_"."_$tr($$$StripQuotes($e(table,found+1,*)),".",$c(2)) }
	RETURN $$$DefaultSchemaQL_"."_$tr($$$StripQuotes(table),".",$c(2))
 
 
ExtQualifiedName(table) ;   INTERNAL - UNDOCUMENTED FUNCTION
	#;  Function:     ExtQualifiedName^%apiSQL(table)
	#;  Description:  Given a table name or unqualified table name,
	#;                return our external qualified format of schema.table
	#;                Use for generating a displayable qualified name given
	#;                a utility input value.
	#;                Adds the default schema to unqualified names.
	#;
	i $g(table)="" QUIT ""
	i table'["." QUIT $$$DefaultSchemaQL_"."_table   ; was unqualified name
	i table'["""" QUIT table  ; schema and table are regular identifiers
	#;  If we get here, we either have a delimited table name or deleimited schema name, or both.
	#;  Gotta find if any '.' is schema/table separator, or part of the name
	n found,i s found=0
	f i=1:1:$l(table) i $e(table,i)=".",$l($e(table,1,i),"""")#2 s found=i q
	i found QUIT table
	QUIT $$$DefaultSchemaQL_"."_table
 
 
IDFields(table,schema) [] PUBLIC {	// INTERNAL - UNDOCUMENTED FUNCTION
	  #;  Function:     IDFields^%apiSQL(table[,schema])
	  #;  Description:  Given a schema.table (schema is optional, defaults
	  #;                to the default schema), return a $List of field names which 
	  #;                make up the RowID.  If the RowID is not based on
	  #;                other fields, returns the name of the RowID itself.
	  #;
	  QUIT:$g(table)="" ""
	  s:$g(schema)="" schema=$$$DefaultSchemaQL
	  s ext=$$$GetExtentNameFromTableName(schema,table)
	  QUIT:ext="" ""
	  s extinfo=$$$EXTsqlinfo($$$rEXT,ext)
	  i $$$SQLLocTableRowIDBased(extinfo)="N" QUIT $lb($$$SQLLocTableRowIDField(extinfo))	// Not based on other fields.
	  QUIT $$$SQLLocTableRowIDLogicalFields(extinfo)
	}
 
 
ExternalTableName(table,dnQ) [] PUBLIC {
	#;  Function:     ExternalTableName^%apiSQL(table)
	#;                INTERNAL - UNDOCUMENTED FUNCTION
	#;  Description:  Given a table name or unqualified table name,
	#;                return the external table name (for the gateway)
	#;                Adds default schema to unqualified names.
	#;  Parameter:    table - Qualified or unqualified INTERNAL format
	#;                table name.  Using are internal format:
	#;                <schemaname>_"."_$tr(<tablename>,".",$c(2))
	#;                Note, if name is unqualified, any '.'s should already
	#;                be translated to $c(2).
	#;
	QUIT:table="" ""
	s:table'["." table=$$$DefaultSchema_"."_$tr(table,".",$c(2))
	s ext=$$$GetExtentNameFromIQN(table)
	QUIT:ext="" ""
	s table=$$$SQLTabExternalTableName(ext)
		#;  Note that this code is no good if we start allowing '.' in external table names.
		#;  Right now we don't support that because of how they are bound to SQL
	if ($g(dnQ)>0){
		QUIT:table'["." $$quoter2(table)  // Unqualified Name
		QUIT $$quoter2($p(table,"."))_"."_$$quoter2($p(table,".",2))  // Schema.Table
	}
	QUIT:table'["." $$quoter(table)  // Unqualified Name
	QUIT $$quoter($p(table,"."))_"."_$$quoter($p(table,".",2))  // Schema.Table
	}
 
 
TableExists(table) [] PUBLIC {	// INTERNAL - UNDOCUMENTED FUNCTION
	  #;  Function:     TableExists^%apiSQL(table)
	  #;  Description:  Given a table name or unqualified table name,
	  #;                in External format:
	  #;                   [ <possibly quoted schema> . ] <possibly quoted tablename>
	  #;                See if the table already exists or not.
	  #;                Return 1 if the table exists, otherwise 0
	  #;                By exists, we mean a class was compiled producing this table.
	  #;                I don't search for tables from uncompiled class definitions.
	  #;
	  QUIT:table="" 0
	  s table=$$IntQualifiedName($g(table))
	  QUIT:table="" 0  ; ???
	  QUIT ($$$GetExtentNameFromIQN(table)'="")
	}
 
 
ValidateTableName(table) ;   INTERNAL - UNDOCUMENTED FUNCTION
	#;  Function:     ValidateTableName^%apiSQL(table)
	#;  Description:  Given a table name or unqualified table name,
	#;                Make sure the table name is valid
	#;                Return 1 if OK, otherwise 0
	#;
	i $g(table)="" QUIT 0
	n %ok s %ok=0
	i table'["." QUIT $$ValidateSQLIdentifier(table)  ; Regular or delimiter table name without schema
	i table'["""" QUIT:'$$ValidateSQLIdentifier($p(table,".")) 0 QUIT:'$$ValidateSQLIdentifier($p(table,".",2,999)) 0 QUIT 1  ; schema.table are regular identifiers
	#;  If we get here, we either have a delimited table name or deleimited schema name, or both.
	#;  Gotta find if any '.' is schema/table separator, or part of the name
	n found,i s found=0
	f i=1:1:$l(table) i $e(table,i)=".",$l($e(table,1,i),"""")#2 s found=i q
	i found QUIT:'$$ValidateSQLIdentifier($e(table,1,found-1)) 0 QUIT:'$$ValidateSQLIdentifier($e(table,found+1,*)) 0 QUIT 1  ; schema.table specified
	QUIT $$ValidateSQLIdentifier(table)  ; delimiter table name without schema
 
 
ValidateSQLIdentifier(id) ;   INTERNAL - UNDOCUMENTED FUNCTION
	#;  Function:     ValidateSQLIdentifier^%apiSQL(id)
	#;  Description:  Given an SQL Identifier, determine if it is valid
	#;                Return 1 if OK, otherwise 0
	#;
	i $e(id,1)="""",$e(id,*)="""" QUIT $s($$$GetDelimitedIds:1,1:0)
	#;  A regular identifier must begin with a letter, '_', or '%', and be followed by letters, numbers, '_', '@', '#', or '$'
	i ($zname($e(id))||($e(id)="_")),$zname($tr("%"_$e(id,2,*),"_@#$")),'$$$SQLReservedWordForParsing($zcvt(id,"U")) QUIT 1  ; OK	//DPV1760 Use $$$SQLReserved... macro
	QUIT 0
 
 
SQLToObjectIdentifier(id,length) ; INTERNAL - UNDOCUMENTED FUNCTION
	#;  Function:     SQLToObjectIdentifier^%apiSQL(id,length)
	#;  Description:  Given an SQL Identifier and a length, come up with
	#;                a valid Object identifier within the length.
	#;                Note, this logic does not determine if the derived 
	#;                Object identifier is unique or not.
	#;
	QUIT:$g(id)="" ""
	s:$g(length)="" length=60
	s id=$tr(id,$$$GetIdTrxFrom,$$$GetIdTrxTo)
	QUIT $e($e("n",$e(id)?1n)_id,1,length)
 
 
DefaultSchema(ConfigSetting,QuoteIt=0,CodeGen=0) [] PUBLIC {  ; INTERNAL - UNDOCUMENTED FUNCTION
	#;  Function:     DefaultSchema^%apiSQL(ConfigSetting[,QuoteIt][,CodeGen])
	#;  Description:  Given the value of the Default Schema in the configuration
	#;                setting, return the default schema.  If QuoteIt is TRUE, call
	#;                quoter2 before returning the value.
	#;                If CodeGen is try the default schema will be used in generated code and the
	#;                code may need to check Username at run-time if the default schema is _CURRENT_USER
	#;                If the ConfigSetting is set to _CURRENT_USER, use the contents of
	#;                $p($Username,"@").  If $Username is not defined, use the contents of the second '/'
	#;                piece of ConfigSetting.  If there is none, use SQLUser.
	#;
	If $p($$$UPPER(ConfigSetting),"/")="_CURRENT_USER" {
		If CodeGen QUIT "_CURRENT_USER"  //DPV1655
		If $$$aid'="" QUIT $s(QuoteIt:$$quoter2($p($$$aid,"@")),1:$p($$$aid,"@"))	// DPV2232
		If $p(ConfigSetting,"/",2)'="" QUIT $s(QuoteIt:$$quoter2($p(ConfigSetting,"/",2)),1:$p(ConfigSetting,"/",2))
		QUIT "SQLUser"
	}
	QUIT $s(QuoteIt:$$quoter2(ConfigSetting),1:ConfigSetting)
	}
 
 
next(ref)	; DPV1771 Added this function
	#;  Function:     next^%apiSQL(ref)
	#;  Description:  From the FDBMS, $$next default value function
	#;                Most are converted to $Increment, but $$next("$p(...)") can be, thus this function.
	#;
	QUIT:$g(ref)="" "" QUIT:"$P$p"'[$e(ref,1,2) $i(@ref)
	n lock,i,piece,x,y s lock="",piece="" f i=4:1 s x=$e(ref,i) q:x=""  s:x="(" piece=piece+1 s:x=")" piece=piece-1 s lock=lock_x i piece=0 q
	s y="l +"_lock_" s x=$p($g("_lock_$e(ref,i,*)_" s x=x+1,"_ref_"=x l -"_lock x y QUIT x
 
 
IsList(l="") PUBLIC {
	#; Return whether l is a list (warning: some strings might be falsely reported as lists)
	#; "" is considered not to be a list.  If it is a list, return the number of elements
	QUIT:$ListValid(l) $ListLength(l) Quit 0
}
 
 
SUBSTRING(c,s,l) [] PUBLIC {	// DPV1818+
	    #;  INTERNAL FUNCTION ONLY - used for SUBSTRING function within View's CHECK OPTION condition, Trigger WHEN clause at run-time
	  q:c=""||(s="")||(l="") ""
	  s lc=$l(c),e=s+l
	  i e<s { ZTRAP "SUBS" } q:s>lc||(e<1) $c(0)
	  s:s<1 s=1 s:e>(lc+1) e=lc+1 q $e(c,s,s+(e-s)-1) 
	}
 
 
L2PAT(s,e="",collation="") [] PUBLIC {
	    #;  INTERNAL FUNCTION ONLY - used for LIKE function within View's CHECK OPTION condition, Trigger WHEN clause at run-time
	#; AK801
	#;  u=[N] - #underscores since last non-wildcard, "" if none
	#;  q=[[[.]E]1""] - "" after a non-wildcard, 1"" at the beginning,
	#;	E1"" if last was "_" and no "%" since last non-wildcard
	#;	.E1"" if last was wildcard and "%" found since last non-wildcard
	QUIT:s="" "0E"
	set p="",u="",q=1_$c(34,34)
	f n=1:1 {
		set c=$e(s,n) q:c=""
		i "_%"[c { set:"_"=c u=u+1 set:q'["." q=$e(".","%"=c)_"E1"_$c(34,34) }
		else { set:c=e n=n+1,c=$e(s,n) set:c=$c(34) c=$c(34,34) set p=p_u_q,u="",q="",$e(p,$l(p))=c_$c(34) }
	}
	set finalPattern = p_u_$p(q,1)
	// MJG020 - if pattern passed in is the empty string, change $c(0) in generated COS ? pattern to ""
	set emptystring = $c(0)
	set:collation'="" emptystring = $$applycollation^%qaqcoutlier(collation,emptystring) // collation arg is string like "%SQLUPPER" "%EXACT" etc.
	set:(s=emptystring) finalPattern = $tr(finalPattern, $c(0),"")
	QUIT finalPattern
	#; AK801-
}
.
L2SW(s,e) [] PUBLIC { 
	    #;  INTERNAL FUNCTION ONLY - used for LIKE function within View's CHECK OPTION condition, Trigger WHEN clause at run-time
	  s p="" f n=1:1 { s c=$e(s,n) q:"_%"[c  s:c=e n=n+1,c=$e(s,n) s p=p_c } QUIT p 
	}	// DPV1818-
.
L2PATAU(s,e="") [] PUBLIC {
	    #;  INTERNAL FUNCTION ONLY - used for LIKE function within View's CHECK OPTION condition, Trigger WHEN clause at run-time
	#; AK801
	#;  u=[.[N]] - "" after a non-wildcard,
	#;	. if "%" found since last non-wildcard,
	#;	.N if a sequence of N "_" since last non-wildcard
	#;  q=[[E]1""] - "" after a non-wildcard, 1"" at the beginning,
	#;	E1"" after a wildcard
	s p="",u="",q=1_$c(34,34)
	f n=1:1 {
		s c=$e(s,n) q:c=""
		i "_%"[c { s u="."_$s(("_"=c)&&(u'="."):$e(u,2,*)+1,1:""),q="E1"_$c(34,34) }
		else { s:c=e n=n+1,c=$e(s,n) s c=$ZU(28,c,6) s:c'="" p=p_u_q,u="",q="",$e(p,$l(p))=c_$c(34) }
	}
	s p=p_u_$p(q,1)
	QUIT:p="" "0E"
	QUIT p
	#; AK801-
}
 
MATCHES2SW(s="",e="") [] PUBLIC {	// DPV3541=
	    #;  INTERNAL FUNCTION ONLY - used for %MATCHES function within View's CHECK OPTION condition, Trigger WHEN clause at run-time
	  set p="" set:e="" e="\" for n=1:1 { set c=$extract(s,n) quit:"?*["[c  set:c=e n=n+1,c=$extract(s,n) set p=p_c } QUIT p 
	}
	#; AK817
GWQError(con,err,op,cnh,sth)  ;  handle all Gateway query errors except for 221
	s %msg=$li($zf(-5,%SQLGateway,12,cnh,sth))
	i (err=222)||##class(%SQLGatewayConnection).IsTextNetworkError(%msg) s:err'=222 err=461 d DropConnection^%apiGTW(con)
	d SQERror(err,"Connection '"_con_"': "_op_": "_%msg)  ;  AK849
	QUIT
	#; AK817-
	#; AK849
SQERror(e,m)  ;  handle all run-time query errors
	#;  this tag could now be explicitly called from generated code
	#;  for all generic run-time error conditions, replacing most
	#;  of the individual cases listed below in SQLRunTimeError()
	if (e=242)&&(m["<EXTERNAL INTERRUPT>")&&($SYSTEM.Util.InterruptReason()=$$$UserInitiatedInterrupt) { // --- User-Initiated <EXTERNAL INTERRUPT> ---
		set SQLCODE=-456,%msg="SQL query execution interrupted by user. Original error: SQLCODE: -"_e_" Message: "_m
	}
	else { set SQLCODE=-e,%msg=m }
	ZTRAP "SQER"
	QUIT
	#; AK849-
SQLRunTimeError(ze="",&SQLCODE,&%msg)	// DPV1814+ // MRP1327+
 #;------------------------------------------------------------------------------
 #; DESCRIPTION:
 #;   Process SQL Runtime errors...
 #;
 #; NOTE:
 #;   Since this method now uses a GOTO with indirection to quickly process each
 #;   'ecode' error, it needed to be defined as an 'old style' method.  Therefore, 
 #;   any changes to this method going forward, which introduces a new variable, must
 #;   be added to the NEW list.
 #;    
 #; PARAMETERS:
 #;   ze             - The value of the $ZE error that occurred during the SQL Query invocation
 #;   SQLCODE        - The SQL error code          [Pass By Reference]
 #;   %msg           - The SQL error message       [Pass By Reference]
 #;
 #; RETURN Value: NONE
 #;------------------------------------------------------------------------------
	
	new dzeOrig,ecode,intReason,msgOrig,SQLCODEOrig,tSC
	
	set dzeOrig=$ZE                        // Record the original value of the '$ZE' variable!
	set:$d(SQLCODE) SQLCODEOrig=SQLCODE    // Record the original value of the 'SQLCODE' parameter if it's defined!
	set:$d(%msg) msgOrig=%msg              // Record the original value of the '%msg' parameter if it's defined!
	set SQLCODE=$g(SQLCODE),%msg=$g(%msg)  // Ensure that 'SQLCODE' & '%msg' are defined!
	set ecode=$p($p(ze,">"),"<",2)
 	try {
		GOTO @("err"_$s(ecode["ZMDL":"ZMDL",1:ecode))
		
		#; ***NOTE: Please keep the following Error Tags ("err"_ecode) in Alphabetical Order:
errALARM	//
		#; If we encountered an <ALARM>, we try and add the routine name and possibly the SQL
		#; Statement text to the '%msg' parameter.  This information is useful for the xDBC Error
		#; report, to let the SYS Admin know which SQL Statement timed out.
		#; We get the routine location of the <ALARM> from $ZE. If the routine is a CachedQuery,
		#; attempt to get the SQL Statement text.
		new cqClassName,ns,rtn
		set rtn=$p($ZE,">",2,*),cqClassName=""
		if rtn[$$$CQShortRoutinePrefix { set cqClassName=($$$CQShortRoutinePrefix_$$$AllButLastPiece($p(rtn,$$$CQShortRoutinePrefix,2,*),".")),ns=$NAMESPACE }				// Non-%SYS CachedQuery
		elseif rtn[$$$CQSYSShortRoutinePrefix  { set cqClassName=($$$CQSYSShortRoutinePrefix_$$$AllButLastPiece($p(rtn,$$$CQSYSShortRoutinePrefix,2,*),".")),ns="%SYS" }	// %SYS CachedQuery
		if cqClassName'="",$g($$$CQrootExtended(ns)($$$NameSpaceTranslationG(ns),"QueryText",cqClassName,1))'="" { set rtn=rtn_", SQL: "_$$$CQrootExtended(ns)($$$NameSpaceTranslationG(ns),"QueryText",cqClassName,1) }
		set SQLCODE=-450,%msg=$$$FormatText($$$Text("SQL statement execution timed out due to user timeout in routine: %1","%SQL"),rtn)
		set:$d(%qrc) %qrc=450
		GOTO ecodePostProc																																						// DPV2421= (ALARM)
errFILEFULL	//
		set SQLCODE=-400
		set %msg="Unexpected error occurred during SQL execution:  "_ze_"  Process "_$j_" was using '"_##class(%SYS.ProcessQuery).Open($j).PrivateGlobalBlockCount_"' process private global blocks.  "
		set tSC=##class(%SYS.ProcessQuery).KillAllPrivateGlobals()
		if $$$ISERR(tSC) { set %msg=%msg_"Attempt to kill all private globals for process "_$j_" resulted in error:  "_$$GetErrorText^%apiOBJ(tSC)_".  " }
		else { set %msg=%msg_"All process private globals for process "_$j_" have now been killed.  Process private global block count is now '"_##class(%SYS.ProcessQuery).Open($j).PrivateGlobalBlockCount_"'." }
		do ##class(%SYS.System).WriteToConsoleLog(%msg)
		set:$d(%qrc) %qrc=-SQLCODE
		GOTO ecodePostProc																																						// DPV4083= (FILEFULL)
errFRAMESTACK	// --- This error performs a process HALT ---
		set SQLCODE=-400,%msg=$$$FormatText($$$Text("Unexpected error occurred during SQL execution: %1 Process HALTed","%SQL"),ze)
		do ##Class(%SYS.System).WriteToConsoleLog(%msg)
		if ($zu(67,10,$j)=1)||($zu(67,10,$j)=3) { write !,%msg HANG 3 }
		HALT																																									// DPV2812= (FRAMESTACK)
errROLLFAIL	//
		set %msg="Unexpected error occurred: "_ze_$s(SQLCODE<0:" during TROLLBACK.  Previous error:  SQLCODE="_SQLCODE_", %msg='"_%msg_"'",1:"")
		set:'SQLCODE SQLCODE=-400
		set:$d(%qrc) %qrc=-SQLCODE
		GOTO ecodePostProc																																						// DPV4642= (ROLLFAIL)
errZCHAR	set:%msg="" %msg=$$$Text("Invalid input value passed to TO_CHAR()","%SQL") set:$d(%qrc) %qrc=400 GOTO ecodePostProc
errZCOMP	set SQLCODE=-350 set:%msg="" %msg=$$$FormatText($$$Text("Unexpected error in execution of SqlCompute code: %1","%SQL"),ze) set:$d(%qrc) %qrc=400 GOTO ecodePostProc									// DPV4349=
errZCONV	set SQLCODE=-141 set:%msg="" %msg=$$$Text("Invalid input value passed to the CONVERT function","%SQL") set:$d(%qrc) %qrc=141 GOTO ecodePostProc 									// DPV1920=	// DPV2206= (Conditionally set %msg)
errZDADD	set SQLCODE=-8 set:%msg="" %msg=$$$Text("An invalid part was specified for the DATEADD() function.","%SQL") set:$d(%qrc) %qrc=8 GOTO ecodePostProc									// DPV2884=
errZDATE	set:%msg="" %msg=$$$Text("Invalid input value passed to TO_DATE()","%SQL") set:$d(%qrc) %qrc=400 GOTO ecodePostProc																	// DPV3756=
errZDAT2	set:%msg="" %msg=$$$Text("Invalid date or datetime value input","%SQL") set:$d(%qrc) %qrc=400 GOTO ecodePostProc																	// DPV5255=
errZDBL1	set SQLCODE=-104 set:%msg="" %msg=$$$Text("Invalid %Double ODBC or Display value ","%SQL") set:$d(%qrc) %qrc=104 GOTO ecodePostProc													// DPV3060=	// DPV3162=
errZDDIF	set SQLCODE=-8 set:%msg="" %msg=$$$Text("An invalid part was specified for the DATEDIFF() function.","%SQL") set:$d(%qrc) %qrc=8 GOTO ecodePostProc									// DPV2884=
errZDJUL	set SQLCODE=-400 set:%msg="" %msg=$$$Text("Illegal input value passed to TO_CHAR()","%SQL") GOTO ecodePostProc																		// DPV2997=
errZDNAM	set SQLCODE=-8 set:%msg="" %msg=$$$Text("An invalid part was specified for the DATENAME() function.","%SQL") set:$d(%qrc) %qrc=8 GOTO ecodePostProc									// DPV2884=
errZDPRT	set SQLCODE=-8 set:%msg="" %msg=$$$Text("An invalid part was specified for the DATEPART() function.","%SQL") set:$d(%qrc) %qrc=8 GOTO ecodePostProc									// DPV2884=
errZDPT2	set SQLCODE=-400 set:%msg="" %msg=$$$Text("An invalid date was specified for the DATEPART() function.","%SQL") set:$d(%qrc) %qrc=400 GOTO ecodePostProc								// DPV2884=
errZDTRC	set SQLCODE=-8 set:%msg="" %msg=$$$Text("An invalid part was specified for the DATE_TRUNC() function.","%SQL") set:$d(%qrc) %qrc=8 GOTO ecodePostProc								// IBA050=
errZDUTS	set SQLCODE=-400 set:%msg="" %msg=$$$Text("Illegal input value passed to UNIX_TIMESTAMP(...)","%SQL") GOTO ecodePostProc															// DPV2997=
errZDYNM	set SQLCODE=-400 set:%msg="" %msg=$$$Text("An invalid argument was passed into {fn DAYNAME()) function.","%SQL") set:$d(%qrc) %qrc=400 GOTO ecodePostProc							// DPV3506=
errZEXPL	if SQLCODE=-99 { set:%msg="" %msg=$$$FormatText($$$Text("User %1 is not privileged for the operation","%SQL"),$username) set:$d(%qrc) %qrc=99 GOTO ecodePostProc }
			set:SQLCODE="" SQLCODE=-482 set:%msg="" %msg=$$$Text("Unexpected error in execution of EXPLAIN statement.","%SQL") set:$d(%qrc) %qrc=482 GOTO ecodePostProc
errZFMD1	set SQLCODE=-104 set:%msg="" %msg=$$$Text("Invalid %FilemanDate or %FilemanTimeStamp ODBC or Display value","%SQL") set:$d(%qrc) %qrc=104 GOTO ecodePostProc						// DPV3060=	// DPV3161=
errZGWSQ	set:SQLCODE>=0 SQLCODE=-220 set:%msg="" %msg=$$$Text("Gateway query error","%SQL") set:$d(%qrc) %qrc=220 GOTO ecodePostProc															// AK691=
errZHBER	set SQLCODE=-145 set:%msg="" %msg=$$$Text("Requested HASHBYTES hashing function is not one of the valid options (SHA256,SHA384,SHA512)","%SQL") GOTO ecodePostProc					// CPG060
errZHLER	set SQLCODE=-400 set:%msg="" %msg=$$$Text("HyperLogLog error","%SQL") GOTO ecodePostProc
errZIFXA	set:'SQLCODE SQLCODE=-400 set:%msg="" %msg=$$$Text("Result of a datetime computation is out of range","%SQL") set:$d(%qrc) %qrc=8 GOTO ecodePostProc								// DPV3253=
errZJARY	set SQLCODE=-400 set:%msg="" %msg="Unexpected error in execution of JSON_ARRAY function: "_ze set:$d(%qrc) %qrc=400 GOTO ecodePostProc								// DPV4888=
errZJOBJ	set SQLCODE=-400 set:%msg="" %msg="Unexpected error in execution of JSON_OBJECT function: "_ze set:$d(%qrc) %qrc=400 GOTO ecodePostProc								// DPV4888=
errZLOCK	set:'SQLCODE SQLCODE=-110 set:%msg="" %msg=$$$Text("Unable to acquire lock for a row of data","%SQL") set:$d(%qrc) %qrc=110 GOTO ecodePostProc										// DPV2808=
errZLSTD	set SQLCODE=-400 set:%msg="" %msg=$$$Text("Illegal input value passed to LAST_DAY()","%SQL") GOTO ecodePostProc																		// DPV3058=
errZMDL		set SQLCODE=-400 GOTO ecodePostProc	// Called from Predict^%qarfunc with SQLCODE & %msg already defined																// DPV5618=
errZODAT	set SQLCODE=-146 set:%msg="" %msg=$$$Text("Invalid Date ODBC or Display value","%SQL") set:$d(%qrc) %qrc=146 GOTO ecodePostProc														// DPV3430=
errZOTIM	set SQLCODE=-147 set:%msg="" %msg=$$$Text("Invalid Time ODBC or Display value","%SQL") set:$d(%qrc) %qrc=147 GOTO ecodePostProc														// DPV3430=
errZPRED	set SQLCODE=-400 set:%msg="" %msg=$$$Text("Error during runtime execution of PREDICT function","%SQL") GOTO ecodePostProc															// DPV5692=
errZPTTA	set SQLCODE=-400 set:%msg="" %msg=$$$Text("Illegal input value passed to TO_POSIXTIME()","%SQL") GOTO ecodePostProc																	// DPV4885=
errZSQER	// Generic SQL ztrap error.  SQLCODE and %msg should already be set
			set:SQLCODE>=0 SQLCODE=-400
			set:%msg="" %msg=$$$FormatText($$$Text("Unexpected error occurred: %1","%SQL"),ze)
			set:$d(%qrc) %qrc=-SQLCODE
			GOTO ecodePostProc																																						// AK849= (ZSQER)
errZSUBS	set SQLCODE=-140,%msg=$$$Text("Invalid length parameter passed to the SUBSTRING function","%SQL") set:$d(%qrc) %qrc=140 GOTO ecodePostProc											// DPV1814=
errZTSTA	set SQLCODE=-400 set:%msg="" %msg=$$$Text("Illegal input value passed to TO_TIMESTAMP()","%SQL") GOTO ecodePostProc																	// DPV3335=
errZVCON	set SQLCODE=-263 set:%msg="" %msg=$$$Text("Failed to convert input to logical vector value","%SQL") set:$d(%qrc) %qrc=263 GOTO ecodePostProc									// YWH014
errZVOFL	set SQLCODE=-261 set:%msg="" %msg=$$$Text("Cannot perform vector operation due to overflow error","%SQL") set:$d(%qrc) %qrc=261 GOTO ecodePostProc									// YWH014
errZVOPL	set SQLCODE=-257 set:%msg="" %msg=$$$Text("Cannot perform vector operation on vectors of different lengths","%SQL") set:$d(%qrc) %qrc=257 GOTO ecodePostProc						// MJG195
errZVOPP	set SQLCODE=-267 set:%msg="" %msg=$$$Text("Cannot compare a vector field with a non-vector value","%SQL") set:$d(%qrc) %qrc=267 GOTO ecodePostProc									// YWH057
errZVOPT	set SQLCODE=-259 set:%msg="" %msg=$$$Text("Cannot perform vector operation on vectors of different datatypes","%SQL") set:$d(%qrc) %qrc=259 GOTO ecodePostProc						// YWH014
errZVOPV	set SQLCODE=-254 set:%msg="" %msg=$$$Text("Cannot perform vector operation on non-vectors","%SQL") set:$d(%qrc) %qrc=254 GOTO ecodePostProc											// YWH025
errZVOPX	set SQLCODE=-258 set:%msg="" %msg=$$$Text("Cannot perform vector operation on non-numerical datatypes","%SQL") set:$d(%qrc) %qrc=258 GOTO ecodePostProc								// YWH014
	} catch { // --- Fall Through Error Processing ---
		set:$ZE["<NOLINE>" $ZE=dzeOrig  // Reset $ZE to its original value for missing 'ecode' error tags/methods!
	}
	set:'$d(SQLCODE)||($g(SQLCODE)'<0) SQLCODE=-400
	set:$g(%msg)="" %msg=$$$FormatText($$$Text("Unexpected error occurred:  %1","%SQL"),$s($ze="":ze,1:$ze))
	if $$$LISTINTERRUPTERRORS[("|"_ecode_"|") { // --- Process Interrupt Errors ---																								// MAK4155= // MRP1129+
		set intReason=$SYSTEM.Util.InterruptReason() // Check to see if a 'reason' was specified from the 'SendInterrupt(pid[,reason])' invocation!
		
		if (ecode="EXTERNAL INTERRUPT")&&(intReason=$$$UserInitiatedInterrupt) { // --- User-Initiated <EXTERNAL INTERRUPT> ---
			set SQLCODE=-456,%msg=$$$Text("SQL query execution interrupted by user","%SQL")
		}
		else { // SQLCODE=-457 will ztrap this error at the end of the statement, which has now been short-circuited because of this error, but we need to cleanup locks and close transactions if needed
			set SQLCODE=-457,%msg=$$$FormatText($$$Text("SQL statement execution interrupted by error '%1'","%SQL",$ze))														// DPV6020=
		}
	}																																											// MRP1129-
	if (ecode["OBJECT DISPATCH")&&($SYSTEM.Util.InterruptReason()=$$$UserInitiatedInterrupt) { // --- User-Initiated <EXTERNAL INTERRUPT> during <OBJECT DISPATCH> ---			// MRP1297+
		set SQLCODE=-456,%msg=$$$FormatText($$$Text("SQL query execution interrupted by user. Original error: SQLCODE: -400 Message: %1","%SQL"),ze)
	}																																											// MRP1297-
	set $ZE=""  // Clear $ZE variable!
	RETURN																																										// DPV1814-
	
ecodePostProc  // --- 'SQLRunTimeError' Post Processing & Exit when 'ecode' is Defined ---																						// MRP1327+
	if ($g(msgOrig)["<EXTERNAL INTERRUPT>")&&($SYSTEM.Util.InterruptReason()=$$$UserInitiatedInterrupt) { // --- User-Initiated <EXTERNAL INTERRUPT> ---
		set %msg="SQL query execution interrupted by user."_$s((SQLCODE_%msg)'="":" Original error:"_$s(SQLCODE'="":" SQLCODE: "_SQLCODE,1:"")_$s(%msg'="":" %msg: "_%msg,1:""),1:""),SQLCODE=-456
	}
	set $ZE=""  // Clear $ZE variable!
	RETURN																																										// MRP1327-
.
	#; MRP1129+/MRP1342/MRP1347
///-----------------------------------------------------------------------------------
///                            <EXTERNAL INTERRUPT>
///-----------------------------------------------------------------------------------
/// Implementation
/// --------------
/// The 'SendInterrupt()' method, with its helper methods listed below, is 
/// an interprocess software interrupt mechanism which allows one process to
/// interrupt program execution in another process in an orderly fashion, 
/// allowing the target to take whatever action is appropriate.
///
/// The interface causes error "<EXTERNAL INTERRUPT>" to be reported in the
/// target process, much as a Ctrl-C key causes an "<INTERRUPT>" error. The
/// new error can be trapped with existing $ZTrap, try {} catch {}, and other 
/// error capture mechanisms, and can be enabled/disabled under program control.
/// The default state is "disabled", maintaining existing behavior unless the
/// new functionality is desired.
///
/// The 'SendInterrupt()' method was enhanced to allow for an optional third
/// argument 'MetaDataToMatch', which if specified must exactly match any one
/// of the entries in the process's Application Metadata Stack.
///
/// The Application Metadata Stack, which is kept in shared memory, allows
/// applications to push metadata information on the stack to define what task
/// is being performed by the process at any given time.  Information from the
/// stack is automatically discarded when the process leaves the current frame
/// (descending the frame stack).  This information can be inspected and
/// consumed by monitoring and profiling tools, such as ^%SS & the SMP, and 
/// reported to a user upon request.
///
/// During SQL Query code-generation, within the 'InitAMSInfo^%qaqcasl(...)'
/// and 'InitAMSInfoWorker^%qaqcky(...)' methods, a $LIST(...) string of
/// metadata information 'i%AMSInfo' is generated into each SQL Statement's
/// runtime code to identify the query, and to push the metadata string onto
/// the Application Metadata Stack (AMS) during the OPEN, FETCH & CLOSE, to
/// keep track of when the query is being invoked:
///
///    set i%AMSInfo=$LB($LB("%SQL",{SQLStatementID}),$LB($USERNAME,...),...)
///    do $SYSTEM.Process.AppFrameInfo(i%AMSInfo,1)
/// 
///    PARAMETERS:
///       i%AMSInfo  - The AMS String
///       1          - Flag to enable External Process Interrupts
///
///    NOTE: See the documentation of the 'InitAMSInfo()' method within the
///          '%qaqcasl.MAC' routine for additional information.
/// 
/// Given the new Application Metadata Stack and the extension to the process
/// interrupt method 'SendInterrupt(...)', the 'SQLInterrupt(...)' method can
/// now guarantee that a process is only interrupted if it is executing an SQL
/// query at the time of the interrupt.  This information can also be used to
/// identify all processes working on behalf of a single running statement 
/// (e.g. in the case of parallel or sharded queries), and optionally interrupt
/// these processes as well.
///
/// For further details, refer to the following DevLog/JIRA that implemented 
/// these features: 
///    LRS876/DP-81099   (12/15/2004) - Implement process external interrupts
///    MRP1129/DP-9089   (06/05/2019) - Create Multi-Purpose SQL Query interrupt
///                                     method: SQLInterrupt^%apiSQL()
///    CDS3313/DP-405874 (02/01/2022) - Implement Application Metadata Stack
///    CDS3480/DP-412520 (03/09/2022) - SendInterrupt if match with ApplicationMetaData
///    MRP1282/DP-412677 (03/10/2022) - Enhance the 'SQLInterrupt(...)' method
///                                     to only interrupt a running query
///    MRP1317/DP-418584 (11/16/2022) - Enhance/Optimize the Metadata string of the 
///                                     Application Metadata Stack (AMS) - A template 
///                                     for all AMS Applications
///    MRP1318/DP-418707 (11/22/2022) - Enhance the Multi-Purpose SQL Query interrupt
///                                     method 'SQLInterrupt(...)' by adding a SQL
///                                     Query Indentifier: SQLStatementID
///    MRP1324/DP-419893 (01/12/2023) - Enable external interrupts within the Refactored
///                                     SQL code-generation 'Start' & 'End' modules
///    CDS3655/DP-421891 (04/05/2023) - Setting Application Metadata can also enable
///                                     external interrupts
///    CDS3691/DP-423567 (06/23/2023) - Preserve initial interrupt status when MetaData
///                                     is replaced
///    MRP1342/DP-423506 (06/13/2023) - Enable external interrupts within the Refactored
///                                     SQL code-generation via the enhanced 
///                                     'AppFrameInfo(info,enable)' method
///    MRP1347/DP-423898 (07/01/2023) - Enhance the Multi-Purpose SQL Query interrupt
///                                     method 'SQLInterrupt(...)' by only interrupting
///                                     the parent process of a Parallel SQL Query 
///    DPV6423/DP-426369 (10/20/2023) - Implement new %CANCEL_QUERY SQL Admin Privilege
///
/// Methods
/// -------
/// $SYSTEM.Util.SendInterrupt(pid[,reason][,MetaDataToMatch])
/// $SYSTEM.Util.SetInterruptEnable(state)
/// $SYSTEM.Util.GetInterruptEnable()
/// $SYSTEM.Util.InterruptReason()
///
/// $SYSTEM.Process.AppFrameInfo(info[,enable])
///    - $ZU(222,1,info[,enable]) - Add 'info' to the Application Metadata Stack
///                                 and conditionally enable Process Interrupts
///    - $ZU(222,1)     - Remove current entry from the Application Metadata Stack
/// $SYSTEM.Process.GetAppFrameInfo(pid)
///    - $ZU(222,2,pid) - Get the entire Application Metadata Stack for the given 'pid'
///
/// 'reason' Parameter
/// ------------------
/// The following represents the values that can be specified for the 'reason'
/// parameter of the 'SendInterrupt(pid,reason)' method, and the context in
/// which these values are defined.  The 'reason' value can be obtained by the 
/// interrupted process via the 'InterruptReason()' method:
///
///-----------------------------------------------------------------------------------
/// Context                             reason
/// Routine             MACRO/Variable  Value   Description
/// ------------------  --------------  ------  --------------------------------------
/// %SYSMVI.MAC         $$$MVCHAIN       0
///                     $$$MVSTOP        1
///                     $$$MVABORT       2
///                     $$$MVEXIT        3
///                     $$$MVHALT        4
/// %SYS.DBSRV.MAC      tStatementId     %qacn  This is the Statement ID (%qacn) value 
///                                             that the process thet receives the 
///                                             ETRERNAL INTERRUPT should close up
/// %SYScspServer2.MAC  GWContext        1      Client disconnected while waiting for
///                                             a response (e.g. browser closed)
///                                      2      Request timed-out ('Server Response 
///                                             Timeout' exceeded)
///                                      3      Interrupt request dispatched from the
///                                             Gateway Management forms 
///                                             ('System Status' form)
///                                      4      Client disconnected while sending the
///                                             request payload
///                                      5      Protocol error detected between the 
///                                             Gateway and Cache/IRIS
/// %apiSQL.MAC         $$$UserInitiatedInterrupt   
///                                      69     User-Initiated <EXTERNAL INTERRUPT>
///
///-----------------------------------------------------------------------------------
///
/// Special Notes
/// -------------
/// - DPV6423 moved the 'sendInterrupt(...)' and 'executeRemoteCommand(...)' 
///   methods from this routine to the '%SYS.SQLSRV.MAC' routine since the
///   invocation of the '$$$AddAllRoleTemporary' MACRO, which temporarily 
///   escalates the value of the special '$roles' variable to '%All' 
///   (... $roles=$roles_","_"%All" ...), must be within a routine that
///   lives in the IRISSYS database as all '%SYS.*' routines do.
///
///-----------------------------------------------------------------------------------
///
SQLInterrupt(pid = "", intReason = "", timeout = 10, interface = 0, metadata = "", SQLStatementID = "", &sqlcode = 0) [] PUBLIC {
#IF 0   ;------------------------------------------------------------------------------
 ; METHOD: SQLInterrupt
 ; 
 ; DESCRIPTION:
 ;    Send an Interrupt to the given process (pid) to gracefully 
 ;    interrupt an SQL Query Invocation...
 ;    
 ;    NOTE: The SQL External Interrupt issued by this method to the given 
 ;          process ID (pid) is roughly analogous to that of the Ctrl-C 
 ;          key mechanism for manual interruption of program execution.
 ;
 ;    RESTRICTION: This method invocation requires %CANCEL_QUERY SQL Admin privilege
 ;                 if attempting to cacnel a query running as a username different 
 ;                 than the caller's
 ;
 ; Invocation:   This method can be invoked in the following ways:
 ;                  ObjectScript: $$SQLInterrupt^%apiSQL(...)
 ;                           SQL: CANCEL QUERY pid [ IDENTIFIED BY sql-id ] [ TIMEOUT timeout ]
 ;
 ; PARAMETERS:
 ;   pid            - The process ID ($JOB) to which to send the interrupt
 ;   intReason      - This is an override parameter to be passes as the
 ;                    'reason' parameter to the 'SendInterrupt(pid[,reason])'
 ;                    method.
 ;                    NOTE: In general, this parameter should never be passed
 ;                          a value.  However, a specific 'interface' may
 ;                          use a specialized value for this parameter that is
 ;                          different from the user-initiated value that is
 ;                          used by this method: $$$UserInitiatedInterrupt
 ;                            [interface=2 (SQL Server/xDBC) is one such
 ;                             interface that uses its own 'reason' value]
 ;                          Refer to the '<EXTERNAL INTERRUPT>' notes within 
 ;                          the '%apiSQL.MAC' routine for the varied 'reason'
 ;                          values that can be specified.
 ;   timeout        - The maximum number of seconds to process the interrupt     [DEFAULT: 10]
 ;   interface      - The SQL Query Interface to interrupt:
 ;                      0 = Embedded SQL                                         [DEFAULT: 0]
 ;                      1 = Cached Query
 ;                      2 = SQL Server/xDBC
 ;                      3 = CSP (e.g. SMP's SQL Page)
 ;                      9 = General-Purpose
 ;                    NOTE: This is an optional value that may help to optimize
 ;                          the interrupt for the specified SQL Interface
 ;   metadata       - An optional string that must be matched to successfully    [DEFAULT: ""]
 ;                    interrupt the SQL Query running on the specified process
 ;                    (pid) for the specified 'intReason'.
 ;                    If 'metadata' is not specified, then it will be defaulted
 ;                    to the 'Application Metadata Stack' of the current SQL 
 ;                    Query running on the specified 'pid'
 ;                       [ISC Internal: $SYSTEM.Process.GetAppFrameInfo(pid)]
 ;                    InterSystems INTERNAL USE ONLY:
 ;                      $c(0) = Ensure that this parameter is not passed to the
 ;                              following method and is omitted entirely so
 ;                              that it is not used to conditionally interrupt
 ;                              the specified 'pid' based on the 'Application
 ;                              Metadata Stack':
 ;                                $SYSTEM.Util.SendInterrupt(pid,intReason[,metadata])
 ;                      This will send and interrupt to the specified 'pid'
 ;                      regardless of what that process is executing.
 ;   SQLStatementID - An optional unique SQL Statement Identifier that must be   [DEFAULT: ""]
 ;                    matched to the 'SQLStatementID' value of the metadata 
 ;                    string, which was pushed onto the 'Application Metadata
 ;                    Stack' (AMS) of the specified process (pid), to 
 ;                    successfully interrupt the running SQL Query.
 ;                    This value, if specified, is an integer pointer to a SQL
 ;                    Statement's definition stored in the 'SQL Statement Index'
 ;                    (SSI).
 ;                    NOTE: If the 'metadata' parameters is passed a valid 
 ;                          metadata string, then this parameters will be ignored
 ;                          since the 'metadata' parameters takes precedence.
 ;    sqlcode       - Used to pass back a more specific SQLCODE value to the      [DEFAULT: 0]
 ;                    generated CANCEL QUERY statement code so we can report better 
 ;                    than a -400 error for the SQLCODE of the statement.
 ;    
 ; RETURN Value: The status of this method's execution
 ;               If an error status is returned, the invoking method can
 ;               use the following MACROs to quickly retrieve the
 ;               values for the SQLCODE & %msg variables:
 ;                  #INCLUDE %occStatus
 ;                    set SQLCODE=$$$GETERRORCODE(tSC)
 ;                    set %msg=$$$GETERRORMESSAGE(tSC)
 ; 
#ENDIF  ;------------------------------------------------------------------------------
.
	new %objlasterror
	new %msg
	set tSC=$$$OK
	set:timeout="" timeout=10  // Ensure Default Value!
	
	try {
		if '$isvalidnum(timeout)||(timeout<0) { set tSC=$$$ERROR($$$ObjectScriptError,"The 'timeout' parameter must be a valid positive Integer value: 0-n") THROW }
		set amsListPos=0
		if metadata="" { // --- Check for a matching 'SQLStatementID' value if applicable; Otherwise, Default to the 'Application Metadata Stack' of the current SQL Query running on the specified 'pid' ---
			try { set amsList=$SYSTEM.Process.GetAppFrameInfo(pid) }
			catch amsERR { // --- Error Accessing the Application Metadata Stack (AMS) ---
				if amsERR.Name["<NOJOB>" { set tSC=$$$ERROR($$$ExternalInterruptionFailure,"An interrupt cannot be issued for the given 'pid' since this process does not exist  [Process ID (pid): "_pid_"; intErr: 92]"),amsSC=amsERR.AsStatus(),tSC=$$$ADDSC(tSC,amsSC) THROW }
				else { set tSC=$$$ERROR($$$ExternalInterruptionFailure,"An interrupt cannot be issued for the given 'pid' since there was a problem accessing the 'Application Metadata Stack'  [Process ID (pid): "_pid_"; intErr: 95]"),amsSC=amsERR.AsStatus(),tSC=$$$ADDSC(tSC,amsSC) THROW }
			}
			
			// --- Get the metadata information from the AMS $LIST(...) where the 'SQLStatementID' values match ---
			set metadataInfo=$$getAMSMetadataInfo(amsList,SQLStatementID,.tSCgmd)
			set $LG(amsListPos,metadata)=metadataInfo
		}
		
		if metadata'="",$LV(metadata),$LG(metadata,$$$AMSSQLParentWQMGroupIDPos)'="",amsListPos { // --- Only Interrupt the Parent Process for Parallel SQL Queries ---
			// --- The given 'pid' is a process running a Parallel SQL Sub-Query, so lets retrieve and process the parent of the Parallel SQL Query ---
			set parentAMSInfo=$$getParentAMSInfo(pid,amsListPos,.tSCgpi)
			
			if parentAMSInfo="" { // --- Can't find AMS Infomation for the parent of the child's pocess (pid) ---
				set tSC=$$$ERROR($$$ExternalInterruptionFailure,"An interrupt cannot be issued for the given 'pid' since this process is a child of a Parallel SQL Query and the parent is not running  [Process ID (pid): "_pid_$s(SQLStatementID'="":"; SQLStatementID: "_SQLStatementID,1:"")_"; intErr: 98c]") THROW
			}
			
			// --- Use Parent Process Information ---
			set original("pid")=pid,original("amsListPos")=amsListPos,original("metadata")=metadata  // Save the original values!
			
			// --- Reset the variables (pid,amsListPos,metadata) of the child's process with those from the parent's process ---
			set $LG(pid,pSQLStatementID,amsListPos,metadata)=parentAMSInfo
		}
		
		if metadata="" { // --- Process Specific Errors ---
			if 'amsListPos { // --- The given process 'pid' is not running any SQL Queries ---
				set tSC=$$$ERROR($$$ExternalInterruptionFailure,"An interrupt cannot be issued for the given 'pid' since this process is not running an SQL Query  [Process ID (pid): "_pid_$s(SQLStatementID'="":"; SQLStatementID: "_SQLStatementID,1:"")_"; intErr: 98a]") THROW
			}
			else { // --- The given process 'pid' is running SQL Queries, but none that match conditions to be interrupted ---
				set tSC=$$$ERROR($$$ExternalInterruptionFailure,"An interrupt cannot be issued for the given 'pid' since this process is not running an SQL Query that matches "_$s(SQLStatementID'="":"the given 'SQLStatementID'",1:"the given conditions")_" [Process ID (pid): "_pid_$s(SQLStatementID'="":"; SQLStatementID: "_SQLStatementID,1:"")_"; intErr: 98b]") THROW
			}
		}
		// --- In order to cancel a query, the user must have the %CANCEL_QUERY SQL Admin Privilege, or be the same $username as the process being canceled
		// --- We have the username of the query to cancel in the AMSInfo
		if '$$$CancelQuery($username,0) {	// User does not have %CANCEL_QUERY SQL Admin Privilege
			if $lg($lg(metadata,$$$AMSSQLServerInfoListPos),$$$AMSSQLUsernameSubPos)'=$Username {	// Query to be canceled is not being run by this user
				set sqlcode=-99,%msg="User "_$Username_" does not have the SQL Admin Privilege %CANCEL_QUERY required to cancel a query executed by another user"
				do Audit99^%SYS.SQLSEC(%msg)
				set tSC=$$$ERROR($$$SQLError,sqlcode,%msg)
				THROW
			}
		}
.
		// --- Interrupt SQL Query Invocation ---
		set tSC=$$sendInterrupt^%SYS.SQLSRV(pid,intReason,timeout,interface,metadata,SQLStatementID)
		
		if $$$ISERR(tSC)&&($$$GETERRORCODE(tSC)=$$$ExternalInterruptionFailure) { // --- Create an SQL Interrupt Error from the General Interrupt Error ---
		
			set sqlcode=-454,%msg=$$sqlcode(SQLCODE),errMsg=$$GetOneErrorText^%apiOBJ(tSC)
			set tSC=$$$ERROR($$$SQLError,sqlcode,%msg,errMsg)
		}
	} catch SQLInterErr {
		if tSC=$$$OK { set tSC=$$$ERROR($$$ObjectScriptError,"An interrupt cannot be issued for the given 'pid' since there was an error  [Process ID (pid): "_pid_"; intErr: 99]"),tSC=$$$ADDSC(tSC,SQLInterErr.AsStatus()) }
	}
	RETURN tSC
}
.
.
getParentAMSInfo(cPID = "", cAMSListPos = 1, &tSC) [] PUBLIC {
#IF 0   ;------------------------------------------------------------------------------
 ; METHOD: getParentAMSInfo
 ; 
 ; DESCRIPTION:
 ;    Get the following AMS Information for the parent of a Parallel SQL Query,
 ;    based on the given child process 'cPID' and the position of the metadata
 ;    string 'cAMSListPos' within the Application Metadata Stack (AMS) $LIST(...),
 ;    and return this information in the following $LIST(...):
 ;
 ;      1) pPID            - The Process ID of the parent process
 ;      2) pSQLStatementID - The 'SQLStatementID' obtained from the
 ;                           metadata string 'pAMSInfoList' from the
 ;                           AMS $LIST(...)
 ;      3) pAMSListPos     - The position of the metadata string
 ;                           'pAMSInfoList' from the AMS $LIST(...)
 ;      4) pAMSInfoList    - The metadata string obtained from the
 ;                           'pAMSListPos' position of the AMS $LIST(...)
 ;
 ; PARAMETERS:
 ;   cPID           - The process ID ($JOB) of the child process that is
 ;                    running the parallel sub-query of a Parallel SQL Query
 ;   cAMSListPos    - The position of the metadata string within the Application
 ;                    Metadata Stack (AMS) $LIST(...), which is returned from
 ;                    the following invocation:
 ;                       $SYSTEM.Process.GetAppFrameInfo(cPID)
 ;   tSC            - A Pass By Reference (PBR) parameter that contains the
 ;                    status of this method's invocation
 ;    
 ; RETURN Value: A $LIST(...) of pieces specified in the DESCRIPTION section
#ENDIF  ;------------------------------------------------------------------------------
	
	set tSC=$$$OK,$ZE=""
	set parentInfo=""
	
 try {
	set amsList=$SYSTEM.Process.GetAppFrameInfo(cPID)
	set cAMSInfoList=$LG(amsList,cAMSListPos)
	THROW:cAMSInfoList=""  // No AMS Information for the given child PID (cPID)!     [Use Common Exit-Point: Bottom]
	THROW:$LG(cAMSInfoList,$$$AMSSQLParentWQMGroupIDPos)=""  // cPID has no parent!  [Use Common Exit-Point: Bottom]
	
	// --- Get AMS Parent Information ---
	set server=$LG($LG(cAMSInfoList,$$$AMSSQLServerInfoListPos),$$$AMSSQLServerSubPos)
	set sqlIndexHash=$LG(cAMSInfoList,$$$AMSSQLIndexHashPos)
	
	set tSC=##class(%SYS.AppMetadataStack.SQL).GetStackInfo(,,.amsInfo,,,1)
	
	set pAMSInfo=$g(amsInfo(server,cPID,sqlIndexHash,"parent"))
	THROW:pAMSInfo=""  // No Parent Information!                                     [Use Common Exit-Point: Bottom]
	
	// --- Retrieve Parent Information ---
	set $LG(pServer,pPID,pSQLIndexHash,pType)=pAMSInfo
	set (pAMSInfoList,pAMSInfoListArray)=$g(amsInfo(pServer,pPID,pSQLIndexHash,"info"))
	set appMetadataStackID=$LG(pAMSInfoList,$$$AMSSQLAppMetadataStackIDPos)
	set pSQLStatementID=$LG(appMetadataStackID,$$$AMSSQLSQLStatementIDSubPos)
	
	// --- Get the metadata string from the AMS where the 'pSQLStatementID' values match ---
	    #; NOTE: Re-retrieving the metadata string (pAMSInfoList) from the
	    #;       AMS $LIST(...) (pAMSList) ensure that the metadata $LIST(...)
	    #;       elements/format hasn't changed or been modified!
	set pAMSList=$SYSTEM.Process.GetAppFrameInfo(pPID)
	set metadataInfo=$$getAMSMetadataInfo(pAMSList,pSQLStatementID,.tSCgmd)
	set $LG(pAMSListPos,pAMSInfoList)=metadataInfo
 	
	set parentInfo=$LB(pPID,pSQLStatementID,pAMSListPos,pAMSInfoList)
 }
 catch {
	set:(tSC=$$$OK)&&($ZE'="") tSC=$$$ERROR($$$ObjectScriptError,$ze)
 }
	RETURN parentInfo
}
.
getAMSMetadataInfo(amsList = "", SQLStatementID = "", &tSC) [] PUBLIC {
#IF 0   ;------------------------------------------------------------------------------
 ; METHOD: getAMSMetadataInfo
 ; 
 ; DESCRIPTION:
 ;    Get the following AMS Metadata Information from the specified
 ;    Application Metadata Stack (AMS) $LIST(...) (amsList) where the
 ;    'SQLStatementID' values matched a specific 'metadata' string:
 ;    
 ;      1) amsListPos    - The position within the 'amsList' where the 
 ;                         'SQLStatementID' values matched
 ;      2) metadata      - The metadata string from the 'amsList' where
 ;                         the 'SQLStatementID' values matched
 ;
 ; PARAMETERS:
 ;   amsList        - The Application Metadata Stack (AMS) $LIST(...) returned
 ;                    from the following invocation:
 ;                       $SYSTEM.Process.GetAppFrameInfo(pid)
 ;   SQLStatementID - A unique SQL Statement Identifier that must be matched to
 ;                    the 'SQLStatementID' value of the metadata string within
 ;                    the specified 'amsList'
 ;   tSC            - A Pass By Reference (PBR) parameter that contains the
 ;                    status of this method's invocation
 ;    
 ; RETURN Value: A $LIST(...) of pieces specified in the DESCRIPTION section
#ENDIF  ;------------------------------------------------------------------------------
	
	new %objlasterror
	
	set tSC=$$$OK
	
	set amsListPos=0,metadata=""
 	
 try {
	for pos=1:1:$LL(amsList) { // --- Process All Metadata $LIST(...) Strings on the 'Application Metadata Stack' (AMS) ---
		set metadataList=$LG(amsList,pos)
		CONTINUE:(metadataList="")||('$LV(metadataList))   // Skip Empty/Invalid AMS Metadata $LIST(...) String!
		set appMetadataStackID=$LG(metadataList,$$$AMSSQLAppMetadataStackIDPos)
		CONTINUE:($LG(appMetadataStackID,$$$AMSSQLApplicationIDSubPos)'=$$$AMSApplicationIDSQL)  // Skip AMS Metadata $LIST(...) String that doesn't belong to the 'SQL' application!
		
		set amsListPos=pos  // The position within the 'amsList' which contains SQL metadata!
		if SQLStatementID'="" { // --- Check for a matching 'SQLStatementID' value ---
			if $LG(appMetadataStackID,$$$AMSSQLSQLStatementIDSubPos)=SQLStatementID { // --- Found a matching 'SQLStatementID' in the metadata string from the 'Application Metadata Stack' that is associated with a running SQL Query, so let's use it! ---
				set metadata=metadataList
				QUIT  // Use the metadata string for the matching 'SQLStatementID' value!
			}
		}
		else { // --- Default to the 'Application Metadata Stack' of the current SQL Query running on the specified 'pid' ---
			set metadata=metadataList
 			QUIT  // Use the first metadata string from the 'Application Metadata Stack' that is associated with a running SQL Query!
		}
	}
 }
 catch {
	set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
 }
	RETURN $LB(amsListPos,metadata)
}
.
	#;--- END: SQLInterrupt(...) & Helper Methods ---
.
/// set qset = $$qsetpart^%apiSQL(1, "select * from NYC.TRIP where duration <= 1000","select * from NYC.TRIP where duration > 1000","select * from NYC.TRIP where duration IS NULL")
qsetpart(maxFactors,queryText...) public {
	try {
		set response = ""
		set partCount = 0
		if $Get(queryText) {
			for ptr = 1:1:queryText {
				set qpart = $$qpart(.maxFactors,queryText(ptr))
				set response = response _ $list(qpart,2,*)
				set partCount = partCount + $listGet(qpart)
			}
		}
	} catch {
		set response = ""
		for ptr = 1:1:queryText {
			set response = response _ $listBuild(queryText(ptr),"","","")
		}
	}
	return $listBuild(partCount) _ response
}
.
/// InterSystems INTERNAL USE ONLY. Do not document.
/// queryText - either a simple string or a counted array of lines contain the query to be factored;
/// maxFactors - the maximum number of query factors to return per server (ip,port,namespace triple defines server);
/// Return:
/// 
/// 	$listbuild(<# of factors>,<factor>...)
/// 			where <factor> is <factorExpression>,<ip address>,<port>,<credentials>;
/// 
/// Sample of nested query:
/// 	SELECT fare_amount FROM (SELECT * FROM NYC.TRIP) WHERE trip_distance < 2
/// 
qpart(maxFactors,queryText) [ backgrnd,comperr,dasl,data,dcost,dint,dmac,dmt,dsql,mcurs,mt,mtag,mtc,mtd,ok,pathout,err,SQLCODE] public {
	try {
			// For the first implementation, let's just call an info compile to get basic info about this query
			// Assume this is a select statement
		new backgrnd,comperr,dasl,data,dcost,dint,dmac,dmt,dsql,err,mcurs,mt,mtag,mtc,mtd,ok,pathout,%msg,%qsccerr,%SNBrokerQuery,%SNShardedTable,%SNShardLocalQuery,%sqlSchemaPath,SQLCODE,%switch
		new %substk,%SYSTEMINCLUDE,%sqlcodegen
			// maybe we need to consider embedded $$$NL?
		try {
			if $Data(queryText) '> 2 {
				set sql = 1
				set sql(1) = queryText
				set returnQuery = queryText
			} elseif queryText > 0 {
				merge sql = queryText
				set returnQuery = queryText(1)
				for ptr = 1:1:sql {
					set returnQuery = returnQuery _ $$$NL _ queryText(ptr)
				}
			}
				// It appears that we call ShowPlan just to parse the query and do an initial prepare. We don't actually use any of the output 
				// other than the %SNxxxx vars that were added to the qp. 
			set %SNBrokerQuery = 1
			set backgrnd = 1
		//	do ShowPlan^%apiSQL(.sql)
.
				#;  First we need to do an info compile of the query in order to find out what include
				#;  file are needed to compile the query.
	//		if schemapath'="" new %sqlSchemaPath set %sqlSchemaPath=schemapath
			set ok = 1
			do comp^%qaqqt("query",.sql,"info","",0,"","%qsc(%qscacn",,,$g(packages))
			throw:'ok
				#;  Here we get a list of include files from the class and include them at the
				#;  beginning of the code we'll compile.  These are needed if the user uses
				#;  macro references defined in these definitions in 
				#;  Computed field code, map definitions, etc.
			set i="" 
			set inclist("%systemInclude")=""  // %systemInclude is automatically included in all classes
			for  {
				set i = $order(mtc(0,0,"table",i),1,data)
				quit:i=""  
				set data = $piece(data,$char(1),4)	// data is now the extentname
				if data '= "" {
					set j = "" for  set j=$$$comClassArrayNext(data,$$$cCLASSincludecodeall,j) quit:j=""  set inclist(j)=""
				}
			}
			if $data(inclist) {
				set include = ""
				for {
					set include = $order(inclist(include))
					quit:include=""
					set dmac($increment(dmac)) = "#INCLUDE "_include
				}
			}
					//  put it in embedded SQL lines
			if $get(packages)'="" for i=1:1:$listlength(packages) set dmac($increment(dmac))="#import "_$listget(packages,i)
				/*
				// We haven't yet discussed schemapath or other contextual settings
			if schemapath '= "" {
				set dmac($increment(dmac))="#sqlcompile path="_$listtostring(schemapath)
			}
				// Same with SELECTMODE
				#; use RUNTIME mode so ShowPlan from SMP or SQL Shell will match the hash from the %SQL.Statement cached query of the same statement via SMP or the Shell.
			if selectmode '= "" {
				set dmac($increment(dmac))="#sqlcompile select="_selectmode
			}
				*/
.
			for i=1:1:$get(sql) set dmac($increment(dmac))=$select(i=1:" &sql(",1:" ")_$get(sql(i))
			set dmac($increment(dmac))=" )"	// DPV3472 - put closing ")" on line by itself in case SQL satemet ends with comment
				#; when we break and gather metadata, we need to make sure we break at the correct time.  If there are nested SQL compilations, we don't want to grab the
				#; metadata from the wrong query.  This can happen if there are embedded SQL queries in SQL computed fields.
				#; for the close+1, we take the last one we encounter
				#; for the +1^%qaqcasl, we take the first one
			do LINES^%qarmac("dmac","dint",,,,,,,,,,,,,,,,,"ShowPlan1")  ;  run the compiler and collect data
			//Currently, we only support distributing the original query, with no combination logic.
			//When that changes, we'll have richer output we can pass back to the caller.
			if '$g(dmt("canFactor",1)) goto noFactor
			s returnQuery = dmt("sqlFactor",1)
		} catch exception {
			if (exception.Name = "<SYNTAX>") && (exception.Location = "errdone+2^%qaqqt") {
				set %msg=$get(%msg)
				if $Get(SQLCODE,0) = 0 { set SQLCODE = -400 }
				if %qsccerr { for tPtr = 1:1:%qsccerr set %msg=%msg_%qsccerr(i)_$char(13,10) }
				throw ##class(%Exception.SQL).CreateFromSQLCODE(SQLCODE,%msg)
			} else { throw exception }
		}
		set extentName = $get(%SNShardedTable)
		if ($get(extentName) '= "") && ($data($$$SSGlobal($$$SSStorageModelSQL,$$$SSEntitiesSubscript,extentName))) {
				// This is a sharded entity
			set status = ##class(%BigData.ShardedSQL).%GetShardKeyInfo($get(entityName),.extentName,.hasGeneratedId,.generatedIdIsShardKey,.shardKeyColumnNumbers,.shardKeyColumnNames)
			if $$$ISERR(status) {
				throw ##class(%Exception.StatusException).CreateFromStatus(status)
			}
.
				// If any shards are mirrored, and do not have VIPs available, connect to them
				// to ensure that the host and port returned below are those of the current
				// primary mirror member.
			if $$$SSSomeShardsAreMirrored {
				set shardCount = $$$SSShardsCounter
				set mirrorWithNoVIP = 0
				for ii=1:1:shardCount {
					if $$$SSShardIsMirrored(ii) &&('$data($$$SSGlobal($$$SSShardsSubscript,ii,$$$SSMirrorVIPSubscript))) {
						set mirrorWithNoVIP=1
						quit
					}
				}
				if mirrorWithNoVIP {
						// TBD: This should really only try to connect to shards that are mirrored,
						// and for which VIPs are not available.
					set res = $$broadcast^%SYS.SHARDSRV("")
					if res'="" {
						// If calling app has already executed any sharded SQL statements,
						// if may have already opened connections to shards, which may already
						// have been lost if any mirrored shard has failed over. If so, calling
						// broadcast a second time should re-connect to the new primary. If
						// more than one shard failed over, or the failure was due to some other
						// cause, we'll just return the error.
						set res = $$broadcast^%SYS.SHARDSRV("")
						if res '= "" {
							set status=$listget(res)
						}
					}
				}
			}
			if $$$ISERR(status) {
				throw ##class(%Exception.StatusException).CreateFromStatus(status)
			}
			set shardCount = +$get($$$SSGlobal($$$SSStorageModelSQL,$$$SSEntitiesSubscript,extentName,$$$SSShardMapSubscript,$$$SSShardCountSubscript))
			set retval = $listbuild(shardCount)
			for shardIdx = 1:1:shardCount {
				set retval = retval _ $listBuild(returnQuery) // in the future, the query processor will compute this returnQuery value for each of the query factors
				set shard = $get($$$SSShards(shardIdx))
				if $$$SSShardIsMirrored(shardIdx) {
					set vip = $get($$$SSGlobal($$$SSShardsSubscript,shardIdx,$$$SSMirrorVIPSubscript))
					if vip '= "" {
						set retval = retval_$listbuild(vip,$listget(shard,2),$listget(shard,3))
					} else {
						set retval = retval _ shard
					}
				} else {
					set host = $listget(shard)
					set retval = retval _ shard
				}
			}
			return retval
		}
	} catch exception {
			// default behavior is to simply return the original query without factoring
		// write !,"exception..."
		// do $system.OBJ.DisplayError(ex.AsStatus())
	}
noFactor
		// Entity is not sharded, but exists, or SQL call to parse statement would have returned error.
		// Return a single "shard address" that is actually the address for connecting to the master
		// namespace via the current app server, since the operation can not be sharded and must be
		// served by the master.
	set host = $$getmyhostname^%SYS.SHARDSRV()
	set port = $$getmydefaultport^%SYS.SHARDSRV()
	return $listbuild(1,returnQuery,host,port,$namespace)
}
.
	// In each namespace, if there are any IRIS.Temp.LTT### classes, delete them and delete the data too
	// This is called at startup time to delete any stale #TempTables
	// Most likely switch 10 is set because this is during STU, so we can't use the WorkQueueMgr.
DeletePoundTempTables() [] PUBLIC {
	try {
		set sc=$$$OK
		do List^%SYS.NAMESPACE(.namespaces,,0)
		set ns=""
		new $namespace
		for  {
			set ns=$o(namespaces(ns)) quit:ns=""
				#;Pass the flag to make sure we don't establish a connection
			do GetAllNSInfo^%SYS.NAMESPACE(ns,.info,1)
				#;Database must not be remote
			if ($g(info("GlobalDB","System"))'="")||($g(info("RoutineDB","System"))'="") { continue }
				#;Check for bad namepace
			continue:$g(info("GlobalDB","Directory"))=""
			set $namespace=ns  // change namespaces
				// Now delete any IRIS.Temp.LTT* classes and the data
			set class="IRIS.Temp.LTT0" // start $order value
			for  {
				set class=$o(^oddDEF(class)) quit:class=""
				quit:class]]"IRIS.Temp.LTT:"		// we found all the IRIS.Temp.LTT* classes
				try { set sc=$classmethod(class,"%KillExtent",1,1) } catch {} // don't care if it fails, simply trying to be fast
				set sc=$SYSTEM.OBJ.Delete(class,"e-d")	// Don't care about error
			}
		}
	} catch exception {
		set sc = exception.AsStatus()
	}
	RETURN sc
}
.
.
/// Helper function for foreign table logic to return the foreign data wrapper class name based on a shorthand name.
/// Returns:
///		Corresponding class name if the shorthand is valid, otherwise ""
getFDWClassNameFromShorthand(shorthand="") [] PUBLIC {
	RETURN $case($$$UPPER(shorthand),
					"CSV":		"%SQL.FDW.Wrapper.CsvWrapper",
					"JDBC":		"%SQL.FDW.Wrapper.JdbcWrapper",
					"ODBC":		"%SQL.FDW.Wrapper.OdbcWrapper",
					:			""
				)
}
.
.
/// Helper function for foreign table logic to return the foreign data wrapper shorthand name based on the class name.
/// Returns:
///		Valid accepted system shorthands based on provided classname, or the raw classname if no shorthand found
getFDWShorthandFromClassName(className="") [] PUBLIC {
	RETURN $case(className,
					"%SQL.FDW.Wrapper.JdbcWrapper": 	"JDBC",
					"%SQL.FDW.XDBC": 					"JDBC",	// old name, deprecated wrapper class
					"%SQL.FDW.Wrapper.OdbcWrapper": 	"ODBC",
					"%SQL.FDW.Wrapper.CsvWrapper": 		"CSV",
					"%SQL.FDW.CSV": 					"CSV",		// old name, deprecated wrapper class
					: 									className
				)
}
.
.
/// After switching to new FDW architecture, make sure that any old wrapper class specified by name will be interpreted
/// as the closest new wrapper class.
/// If name is not one of the old FDWs, returns the passed-in name
getNewFdwClassNameFromOldClassName(fdwClass="") [] PUBLIC {
	RETURN $case(fdwClass, "%SQL.FDW.XDBC": $$$FDWJdbcWrapper, "%SQL.FDW.CSV": $$$FDWCsvWrapper, :fdwClass)
}
.
.
/// Given the server class name, return the serialization manually. This is meant to be called when the same logic couldn't
/// be accomplished via a call to the serializeConfig() method of the given server.
///
/// Parameters:
///		serverClass			- class name of the server to be serialized
///
///	Returns:
///		JSON %DynamicObject representing serialization into the 'server' portion of the config object needed to create
///		a foreign data wrapper.
getServerConfigSerialization(serverClass="") [] PUBLIC {
	RETURN:serverClass="" ""
	set serverConfig = {}
	set connection = $PARAMETER(serverClass, "CONNECTION")
	set:(connection'="") serverConfig.connection = connection
	set delimitedIds = $PARAMETER(serverClass, "DELIMITEDIDS")
    do:(delimitedIds'="") serverConfig.%Set("delimitedIds", delimitedIds, "boolean")
	set fdwName = $$getNewFdwClassNameFromOldClassName^%apiSQL($PARAMETER(serverClass, "FDWNAME"))
    set:(fdwName'="") serverConfig.fdwName = fdwName
	set host = $PARAMETER(serverClass, "HOST")
    set:(host'="") serverConfig.host = host
	set passthrough = $PARAMETER(serverClass, "PASSTHROUGH")
    do:(passthrough'="") serverConfig.%Set("passthrough", passthrough, "boolean")
	set pushdownType = $PARAMETER(serverClass, "PUSHDOWNTYPE")
    set:(pushdownType'="") serverConfig.pushdownType = pushdownType
	RETURN serverConfig
}
.
/// Given a foreign table class name, return the serialization manually. This is meant to be called when the same logic couldn't
/// be accomplished via a call to the serializeConfig() method of the given foreign table class.
///
/// Parameters:
///		ftClass			- class name of the foreign table to be serialized
///
///	Returns:
///		JSON %DynamicObject representing serialization into a 'table' portion of the config object needed to create
///		a foreign data wrapper.
getForeignTableConfigSerialization(ftClass="") [] PUBLIC {
	RETURN:ftClass="" ""
	set tableConfig = {}
	
    // turn COLUMNS to JSON array
	set columns = $PARAMETER(ftClass,"COLUMNS")
    set columnsList = $lfs(columns,",",2), columnsArray = []
    set ptr = 0
    while $listnext(columnsList,ptr,value) {
        do columnsArray.%Push(value)
    }
    
    // turn VALUES to JSON array
	set values = $PARAMETER(ftClass,"VALUES")
    set valuesList = $lfs(values,",",2), valuesArray = []
    set ptr = 0
    while $listnext(valuesList,ptr,value) {
        do valuesArray.%Push(value)
    }
.
    // turn COLUMNSTYPES to JSON array
	set columnsTypes = $PARAMETER(ftClass,"COLUMNSTYPES")
    set typesList = $lfs(columnsTypes,",",2), typesArray = []
    set ptr = 0
    while $listnext(typesList,ptr,value) {
        do typesArray.%Push(value)
    }
.
    set:columnsArray.size() tableConfig.columns = columnsArray
    set:typesArray.size() tableConfig.columnsTypes = typesArray
    set:valuesArray.size() tableConfig.values = valuesArray
	set query = $PARAMETER(ftClass,"QUERY")
    set:(query'="") tableConfig.query = query
	set table = $PARAMETER(ftClass,"TABLE")
    set:(table'="") tableConfig.table = table
	set using = $PARAMETER(ftClass,"USING")
    set:(using'="") tableConfig.using = {}.%FromJSON(using)
.
    RETURN tableConfig
}
.
.
	/// Allocate SQL/IntegratedML/xDBC feature tracker keys
FTKeysSetup() [] PUBLIC {
	RETURN:$d($SYSTEM.Context.SQL().FTKeys)=11	// Already allocated
		// IntegratedML Feater Tracker Keys
	for key="IntegratedML.CreateModelAutoML","IntegratedML.CreateModelH2O","IntegratedML.CreateModelDR","IntegratedML.CreateModelPMML",
	        "IntegratedML.TrainModelAutoML","IntegratedML.TrainModelH2O","IntegratedML.TrainModelDR","IntegratedML.TrainModelPMML",
	        "IntegratedML.PredictAutoML","IntegratedML.PredictH2O","IntegratedML.PredictDR","IntegratedML.PredictPMML"
	{
		set $SYSTEM.Context.SQL().FTKeys(key) = $$$FTALLOCKEY(key)
	}
}
.
#INCLUDE %sqlcode
#INCLUDE %stringreplace
#INCLUDE %quoter
.
	/// Display a list of all SQL routines and the component for that routine
	/// Component comments are in the form:
	///  ;; COMPONENTS :: SQL/Parser
ComponentList() [] PUBLIC {
	set rtn="%"
	for {
		set rtn=$o(^rOBJ(rtn)) quit:$e(rtn)'="%"
		set component=$text(+2^@rtn)
		continue:component=""
		if component[";; COMPONENTS :: " {
			set component=$p(component,":: ",2,*)
			continue:$case($p(component,"/",1),"SQL":0,"IRIS":0,"OBJECTS":0,:1)	// line two is not a component line
			w !,$i(cnt)," ",rtn,?40,component
		} else {
			//if $e(rtn,1,2)="%q" { w !,rtn,?40,"***"_component }
		}
	}
	RETURN
}
.
	/// Given a routine name, return its component (if there is one)
	/// Component comments are in the form:
	///  ;; COMPONENTS :: SQL/Parser
Component(rtn) [] PUBLIC {
	set component=$text(+2^@rtn)
	if component[";; COMPONENTS :: " {
		RETURN $p(component,":: ",2,*)
	} else {
			if $e(rtn,1,2)="%q" { RETURN "***"_component }
	}
	RETURN ""
}
.
	/// Given a component, return a $listbuild of routines that are part of that component
	/// Component comments are in the form:
	///  ;; COMPONENTS :: SQL/Parser
ComponentRoutines(component) [] PUBLIC {
	set rtn="%",rtnlist="",component=$$$UPPER(component)
	for {
		set rtn=$o(^rOBJ(rtn)) quit:$e(rtn)'="%"
		set rtnComponent=$$$UPPER($text(+2^@rtn))
		continue:rtnComponent=""
		if rtnComponent[";; COMPONENTS :: " {
			if $p(rtnComponent,":: ",2,*)[component { set rtnlist=rtnlist_$lb(rtn) }
		}
	}
	RETURN rtnlist
}
.
