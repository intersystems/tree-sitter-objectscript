SetClientMaxIdleTime(time=0,&oldval) [] PUBLIC {
	#;  Function:     SetClientMaxIdleTime^%apiSQL(time,oldValue)
	#;  Description:  Set a maximum idle time for client connections
	#;  Parameters:
	#;     1.  time - non-negative integer.  0 Is the default
	#;                If 0, no maximum time for client connections to remain idle
	#;                If > 0, the amount of timem (in seconds) that client connections may sit idle before being closed
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetClientMaxIdleTime
	s sc=$$$SetClientMaxIdleTime(time)
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","ClientMaxIdleTime")=$g(time,$$$DefaultClientMaxIdleTime)
	QUIT sc
