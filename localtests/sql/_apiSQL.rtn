^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%apiSQL^MAC^^^0
%apiSQL	// IRIS SQL - API Entry Points
	;; COMPONENTS :: SQL/Runtime
	#;
#INCLUDE %msql
#INCLUDE %BigData.ShardingManager
#INCLUDE %occErrors
#INCLUDE ftdefs
	#;
#IF 0   ;--------------------------------------------------------------------
	; Description:   
	; Author:        
	; Date Started: 
	;
	;  MRP1190 (04/04/2020) - Move all 'SetSQLStats*()' & 'GetSQLStats*()' methods to '%SYS.PToolsUtil.MAC' to be used by UCQ & earlier build processing
	;  MRP1189 (03/29/2020) - Optimize PTools/SQLStats by recording the {flag-type} as the 6th colon (:) piece of the SQLStats-flag
	;  MRP1129 (06/05/2019) - Create Multi-Purpose SQL Query interrupt method: SQLInterrupt^%apiSQL()
	;  JMM837  (03/10/2017) - Unified routine and globals databases for sharded cluster
	;  MRP1028 (11/09/2017) - Support SQLStats timeout reset options via collection termination/expiration conditions (terminateCond)
	;  MRP1027 (10/31/2017) - Redesign SetSQLStats*() parameters for statistical data collection granularity
	;  MRP1026 (10/13/2017) - Add support for SQLStats collection termination/expiration conditions
	;  JSL5175 - Fix: SQL: RTPC - fix performance problems while allowing RTPC transformation of subselects
	;  JSL5173 (9/27/2017) - simplify logic for ShowPlanForOutliers, use camel case, fix bugs
	;  MRP1019 (09/14/2017) - Minimize ShowPlan() output in %plan() array, but retain details with 'verbose' option
	;  JSL5140 (07/21/2017) - The default now is ignoreoutliers=1
	;  MRP1007 (07/10/2017) - Provide method for Setting PTools SQLStats-flag by Namespace: $SYSTEM.SQL.SetSQLStatsFlagByNS()
	;  MRP1000 (07/02/2017) - Use new $ZU() bins created by JO3000 for all SQLStats flags
	;  JSL5097 (05/26/2017) - provide APIs for Run Time Plan Choice
	;  HSU200  (05/25/2017) - provide APIs for auto-hinting for %PARALLEL
	;  MRP963  (05/02/2017) - Restructure PTools Utilities for SQL Statements & Statistics
	;  JSL5087 (05/15/2017) - integrate RTPC with frozen plans
	;  JSL5085 (05/11/2017) - reimpleement outlier showplan
	;  JSL5057 (04/07/2017) - use mtc("outlierexist") to tell if SQL statement has outliers - information passed from %qaqqt
	;  JSL5048 (03/24/2017) - if run time plan choice on, and sql has outliers then only show plan for executed sql rtus
	;  MRP941  (03/03/2017) - Return correct value for all permutations of the SetSQLStats() & GetSQLStats() methods
	;  MRP940  (03/02/2017) - Fix <NOLINE>SetSQLStats+1^%apiSQL by invoking proper function: $$SetSQLStatsFlag^%SYS.PTools(0,flag)
	;  MRP924  (01/07/2017) - Retain existing %plan() structure based on (forTest=1) to keep Backward-Compatible for Regression Testing
	;  MRP916  (11/03/2016) - Display original SQL Query Text from SMP: System Explorer->SQL->Execute Query->[Show Plan]
	;  MRP870  (04/28/2016) - Fix <SUBSCRIPT> error in ShowPlanAlt^%apiSQL()
	;  MRP869  (04/28/2016) - Handle error processing gracefully within ShowPlanAlt^%apiSQL()
	;  MRP868  (04/27/2016) - Handle error processing gracefully within ShowPlan()
	;  AK817   (07/21/2011) - GWQ: Handle Communication link error -461
	;  AK801   (02/15/2008) - Improve LIKE pattern with wildcard sequence
	;  BJB444  (03/04/2010) - Support collation for LIKE with ALPHAUP
	;  DPV3396 (04/21/2009) - More CALL enhancements
	;  AK731   (03/19/2009) - EXTQGEN: Show external queries in Plan
	;  DPV3377 (03/18/2009) - Add error trapping around info compile call in ShowPlan
	;  DPV3372 (03/12/2009) - Implement utilities to extract SQL and perform ShowPlan on a script
	;  DPV3335 (01/06/2009) - Implement support for TO_TIMESTAMP Scalar function
	;  DPV3320 (12/10/2008) - Support ECPSync config setting
	;  DPV3263 (09/22/2008) - Support MySQL DDL Script file import
	;  DPV3253 (09/02/2008) - Informix DATETIME arithmetic
	;  DPV3206 (06/25/2008) - Correct ShowPlan when macro references are needed from class include files
	;  DPV3162 (05/15/2008) - Add error for invlaid double value in %Double OdbcToLogical conversion code
	;  DPV3161 (05/15/2008) - Error trapping in generated INSERT code, changes to error -104 and Fileman datatypes
	;  DPV3127 (03/18/2008) - Support for different default schemas in different namespaces
	;  DPV3092 (01/08/2008) - Support IsRowid for xDBC metadata
	;  DPV3089 (01/04/2008) - Add "TCP Keep-Alive Interval" config parameter
	;  DPV3076 (11/30/2007) - Changes to ^||%sql.smd lifetime, fixes for views updated WHERE CURRENT OF
	;  DPV3060 (10/26/2007) - Fixes for %FilemanDate and %FilemanTimeStamp datatypes in SQL
	;  DPV3058 (10/22/2007) - Implement support for LAST_DAY() function
	;  CDS1197 (10/12/2007) - IsList() uses $ListValid()
	;  DPV2997 (08/15/2007) - SQL Fix:  Correct TO_CHAR(val,'J') - Julian dates - ProdLog 58165:TO_CHAR returns inco...>
	;  DPV2994 (08/06/2008) - Revert stream oref change.  Implement %OBJECT()
	;  BJB349  (07/17/2007) - Correct Line Tag SetSQLStats
	;  BJB348  (07/11/2007) - Display SQLStats in Query Plan
	;  BJB347  (05/11/2007) - Create SQLStats code generation
	;  DPV2890 (03/21/2007) - Add IsAliased to Prepare^%apiSQL display
	;  DPV2844 (03/19/2007) - Handle all supported datepart values
	;                         SQL Fix ProdLog 54093: STS/SQLTIMESTAMP working with functions <> DATEPART
	;  DPV2815 (12/08/2006) - Set ^%SYS("sql","sys",...) settings when setting config settings.
	;  DPV2812 (12/07/2006) - HALT on <FRAMESTACK> errors
	;  DPV2808 (12/06/2006) - When a RC lock fails, ztrap "LOCK" instead of just quiting
	;                         SQL Fix ProdLog 47358:  query returns 0 rows instead of reporting lock timeout error -114
	;  DPV2717 (08/21/2006) - Allow kill $$$smdRoot even when kill of entire global is turned off
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  DPV2673 (06/07/2006) - Implement Fast DISTINCT switch
	;  DPV2580 (01/25/2006) - Improve performance of DefaultSchema macros
	;  DPV2571 (01/13/2005) - Add support for NOCHECK DDL CompileMode
	;  DPV2541 (10/24/2005) - Add isAutoIncrement, isCaseSensitive, isCurrency, IsReadOnly, IsRowVersion, IsUnique, IsAliased, IsExpression, IsHidden, IsIdentity, IsKeyColumn do xDBC metadata
	;  DPV2535 (10/13/2005) - Remove DaysBeforePurge config setting displays/API
	;                         SQL Fix ProdLog 46579: connection closed unexpectedly
	;  DPV2507 (09/02/2005) - Support RESTRICT and CASCADE for Drop View
	;  DPV2488 (08/17/2005) - Keep NextRtn node and other namespace specific cached query settings in ^mcq
	;                         SQL Fix ProdLog 45368: another <NOROUTINE> cached query related issue
	;  DPV2454 (07/19/2005) - Move ^mcq global to ^|"%SYS"|CQ[I] subscripted by namespace
	;  DPV2421 (04/26/2005) - Don't mask <ALARM> errors with -400, use -450 instead.
	;  DPV2415 (04/20/2005) - Fix SetFilerRefIntegrity setting to match SMP description
	;                         SQL Fix ProdLog 42660: Exception not thrown on batch update with referential integrity violation
	;  DPV2384 (03/15/2005) - Carlos Lopes, Fix ProdLog 41831: <PROPERTY DOES NOT EXIST>SetReferencialChecks+2^%SYS.CONFIG
	;  DPV2350 (01/26/2005) - SQL Security: default EOS marker for CACHE is "GO"
 	;  DPV2321 (11/10/2004) - Use new %SYS.CONFIG API for SQL Configuration settings
	;  DPV2320 (11/10/2004) - Rename server routines
	;  JLF022  (11/09/2004) - Modify ShowPlanInput for test output stability
	;  DPV2314 (10/26/2004) - Implement support for INSERT INTO <table> DEFAULT VALUES
	;  PWC921  (10/19/04)   - Moved Cleanup^%apiSQL to CleanupSQL^%HALT
	;  DPV2271 (08/20/2004) - Eliminate THRESHOLD
	;  DPV2253 (07/23/2004) - Report READONLY columns in mtc(), enhance Prepare display
	;  DPV2237 (06/18/2004) - Remove support for Namespace Security Access
	;  DPV2232 (06/15/2004) - Use $P($Username,"@") as default schema name
	;  DPV2225 (06/07/2004) - SQLLogin API no longer support
	;  DPV2206 (04/08/2004) - Support CONVERT(varchar(x),<StreamField>)
	;                         SQL Implement ProdLog 36589:  Add the ability to convert character stream data to String data via the Convert() function
	;  DPV2199 (03/17/2004) - Support configurable time precision specification
	;  DPV2198 (03/17/2004) - Use $Username instead of %msql, use new privilege global
	;                         Use $zu(115,7) for ^%SYS("sql","sys","no filer referential checks") flag
	;  DPV2169 (02/09/2004) - Allow the default format returned by TO_DATE() to be configurable
	;  DPV2158 (01/26/2004) - Make keeping class up-to-date a parameter to Tune Table
	;  DPV2156 (01/22/2004) - Make SQL Lock threshold configurable.
	;                         SQL Implement ProdLog 35275: Make Lock Upgrade threshold configurable
	;  DPV2146 (12/15/2003) - Use max 64-bit signed number for maxval/minval via DDL Datatype mapping API
	;                         SQL Fix ProdLog 27429:  DDL datamappings forNumeric() don't support 64 bit integers
	;  DPV2126 (12/05/2003) - Add support for CACHE mode on DDLImport, Cache import API.
	;  DPV2120 (11/07/2003) - Get proper case of username in DDLImport
	;  DPV2119 (11/06/2003) - Don't new errpause and nosub in DDLImport
	;  DPV2113 (11/03/2003) - Fix up SQLLogin in %msql PBR as the username.
	;  DPV2060 (08/21/2003) - Keep $$$smd around for ShowPlan
	;  DPV1988 (05/09/2003) - Eliminate all ^mdd references
	;  BJB251  (03/21/2003) - Create entry points for $zu(115,1) calls
	;  DPV1963 (03/14/2003) - Eliminate externaltablename binding to ^mdd
	;  DPV1920 (01/28/2003) - Add support for MS SQL Server style CONVERT(datatype, expression [,style]) function
	;  BJB247  (11/22/2002) - Added config call for ODBC VARCHAR MAXLEN
	;  DPV1886 (12/02/2002) - Fix SQLToObjectIdentifier to handle SQL identifiers which begin with a number
	;  DPV1841 (10/04/2002) - Remove ^SQLError($J) from Cleanup^%apiSQL
	;  AK535   (09/24/2002) - LIKE with a pattern of NULL
	;  DPV1818 (09/04/2002) - Added new internal functions SUBSTRING, L2PAT, L2SW
	;  DPV1814 (08/30/2002) - Implement SQLRunTimeError function for errors at SQL run-time
	;  DPV1771 (07/23/2002) - Add next() function
	;  DPV1760 (07/08/2002) - Use $$$SQLReservedWordForParsing macro in ValidateSQLIdentifier
	;  DPV1745 (06/12/2002) - Fix Namespace Access security for Roles
	;  DPV1722 (05/16/2002) - Don't return # format in Format
	;  AK494   (11/27/2001) - ShowPlan utility
	;  DPV1655 (01/24/2002) - Determine default schema at run-time for _CURRENT_USER default
	;  DPV1559 (06/20/2001) - Implement DefaultSchema function
	;  DPV1558 (06/20/2001) - Turn on Threshold entry points.
	;  DPV1547 (05/20/2001) - Change ExternalTableName to return quoted identifiers if needed.
	;  DPV1535 (05/09/2001) - Set %msql in SQLLogin after user override login
	;  DPV1485 (01/28/2001) - Provide a cleanup which %HALT can call
	;  DPV1482 (01/12/2001) - Provide an internal function to translate from SQL identifiers to Object identifiers
	;  DPV1471 (12/14/2000) - Change ExternalTableName for Misha - input is internal name
	;  DPV1469 (12/12/2000) - Support DDLImport entry point.
	;  DPV1456 (11/27/2000) - Implement ValidateTableName and ValidateSQLIdentifier
	;  DPV1392 (09/07/2000) - Support configurable default schema name
	;  DPV1382 (08/24/2000) - Add ExternalTableName entry point for Misha
	;  DPV1344 (07/18/2000) - Add support for INSTALL compile mode
	;  DPV1321 (06/09/2000) - Changed my mind (from DPV1310).  PurgeForTable now takes qualified name.
	;  DPV1310 (06/01/2000) - Support schemas - PurgeForTable
	;  DPV1291 (04/11/2000) - Allow for usernames with no passwords
	;  DPV1292 (04/06/2000) - Support InterBase entry point
	;  DPV1274 (03/09/2000) - Add $namespace as first subscript to ^mtemp2, since its stored in CacheTemp
	;  DPV1260 (02/17/2000) - Add entry point for tuning tables
	;  DPV1236 (01/06/2000) - Flag for SQL only compilation
	;  DPV1232 (12/27/1999) - Implement SetDDLNo311 entry point.
	;  DPV1231 (12/27/1999) - Implement switch for skipping referential integrity checks in the filer
	;  DPV1212 (12/09/1999) - Always set SQLCODE in DropTable and DropView.
	;                         Fix DropView now that Views are classes.
	;  DPV1130 (08/30/1999) - Suppress SetDDLDatatypes entry point for non-3.1 systems.
	;  DPV1128 (08/27/1999) - Added DropTable and Drop View entrypoints
	;  DPV1117 (08/03/1999) - Add SQL User Login (SQLLogin) function
	;                         Add description of all entry points at top
	;  DPV1111 (07/23/1999) - Added QueryToTable entry point
	;  DPV1109 (07/20/1999) - Support delimited identifiers - DDLIdentifierTranslations
	;  DPV1100 (07/06/1999) - Support ODNC Namespace Access privilege
	;  DPV1093 (06/21/1999) - Support DDL datatype table
	;  DPV1086 (06/14/1999) - Support user defined login validation code
	;  DPV1080 (06/04/1999) - Allow the options of binding DDL character
	;                         types to %ExactString.
	;  DPV1073 (05/27/1999) - New entry points:  PurgeForTable(table)
	;                                            PurgeForRoutine(rtn)
	;  DPV1062 (05/11/1999) - New Sybase and Informix entry points
	;  DPV1022 (03/25/1999) - Use proper error for no such PKey (319, not 32)
	;  DPV999  (03/10/99)   - Entry point to make DDL PKEY/IDKEY switch
	;  DPV995  (03/05/99)   - Add SetDDLDropTabDelData entry point
	;  DPV974  (02/11/99)   - Add the rest of the entry points
	;  DPV957  (01/22/99)   - Initial creation of entire routine
	;                         Derived from %qarOptionsAPI
	;
	;--------------------------------------------------------------------
	;                     I N F O R M A T I O N
	;--------------------------------------------------------------------
	;
	;  Start your information here...
	;
#ENDIF  ;--------------------------------------------------------------------
	#;
#DEFINE MaxNum 999999999999999999
	#;  These are the max/min integers supported by Cache' (64-bit signed)
#DEFINE MaxCacheInt 9223372036854775807
#DEFINE MinCacheInt -9223372036854775808
#DEFINE ZeroMask "0000000000000000000000000000000000"
	#;
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;   Display entry points documented
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
	Do $SYSTEM.SQL.Help()
	QUIT
	
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;   GET SQL CONFIGURATION SETTINGS
	#;     From %msql.INC:
	#;	GetAllowRowIDUpdate $$GetAllowRowIDUpdate^%SYS.CONFIG()
	#;	GetComments $$GetComments^%SYS.CONFIG()
	#;	GetDBMSSecurity $$GetDBMSSecurity^%SYS.CONFIG()
	#;	GetddlNo30 $$GetddlNo30^%SYS.CONFIG()
	#;	GetddlNo201 $$GetddlNo201^%SYS.CONFIG()
	#;	GetddlNo307 $$GetddlNo307^%SYS.CONFIG()
	#;	GetddlNo311 $$GetddlNo311^%SYS.CONFIG()
	#;	GetddlNo315 $$GetddlNo315^%SYS.CONFIG()
	#;	GetddlNo324 $$GetddlNo324^%SYS.CONFIG()
	#;	GetddlNo333 $$GetddlNo333^%SYS.CONFIG()
	#;	GetDDLSQLOnlyCompile $$GetDDLSQLOnlyCompile^%SYS.CONFIG()
	#;	GetDefaultSchema $$GetDefaultSchema^%SYS.CONFIG()
	#;	GetDelimitedIds $$GetDelimitedIds^%SYS.CONFIG()
	#;	GetDropDelete $$GetDropDelete^%SYS.CONFIG()
	#;	GetExtrinsicFunctions $$GetExtrinsicFunctions^%SYS.CONFIG()
	#;	GetIdKey $$GetIdKey^%SYS.CONFIG()
	#;	GetIdTrxFrom $$GetIdTrxFrom^%SYS.CONFIG()
	#;	GetIdTrxTo $$GetIdTrxTo^%SYS.CONFIG()
	#;	GetLockThreshold $$GetLockThreshold^%SYS.CONFIG()
	#;	GetLockTimeout $$GetLockTimeout^%SYS.CONFIG()
	#;	GetODBCVarcharMaxlen $$GetODBCVarcharMaxlen^%SYS.CONFIG()
	#;	GetPrefix $$GetPrefix^%SYS.CONFIG()
	#;	GetReferentialChecks $$GetReferentialChecks^%SYS.CONFIG()
	#;	GetSaveMAC $$GetSaveMAC^%SYS.CONFIG()
	#;	GetSysDatatypes(%val) $$GetSysDatatypes^%SYS.CONFIG(,%val)
	#;	GetTimePrecision $$GetTimePrecision^%SYS.CONFIG()
	#;	GetTODATEDefaultFormat $$GetTODATEDefaultFormat^%SYS.CONFIG()
	
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
CurrentSettings	; Display Current SQL Configuration Settings:
	n d
	w !!,"SQL CONFIGURATION SETTINGS"
	w !?2,"SQL OPTIONS"
	s d=$$$GetComments s:d=0 d=d_" (Default)"
	w !?4,"Retain SQL as comments:",?50,d
	s d=$$$GetECPSync s:d=0 d=d_" (Default)"
	w !?4,"ECP sync for SELECT statements: ",?50,d
	s d=$$$GetSaveMAC s:d=0 d=d_" (Default)"
	w !?4,"Cached query save source flag:",?50,d
	s d=$$$GetIdTrxFrom s:d="~ `!@#$%^&*()_+-=[]\{}|;':"",./<>?" d=d_" (Default)"
	w !?4,"Identifier translation from:",?50,d
	s d=$$$GetIdTrxTo s:d="" d=d_" (Default)"
	w !?4,"Identifier translation to:",?50,d
	s d=$$$TimePrecision s:d=0 d=d_" (Default)"
	w !?4,"Default time precision:",?50,d
	s d=$$$TCPKeepAlive s:d=1 d=d_" (Default)"
	w !?4,"TCP keep alive interval (in seconds):",?50,d
	s d=$$$QueryProcedures s:d=0 d=d_" (Default)"
	w !?4,"All class queries project as stored procs:",?50,d
	s d=$$$GetLockThreshold s:d=$$$DefaultLockThreshold d=d_" (Default)"
	w !?4,"Lock escalation threshold:",?50,d
	s d=$$$DefSchema s:d="SQLUser" d=d_" (Default)"
	w !?4,"Default schema:",?50,d
	s d=$$$GetDelimitedIds s:d=1 d=d_" (Default)"
	w !?4,"Support delimited identifiers:",?50,d
	s d=$$$AllowExtrinsicFunctions s:d=0 d=d_" (Default)"
	w !?4,"Allow extrinsic functions in SQL statements:",?50,d
	s d=$$$ANSIPrecedence s:d=0 d=d_" (Default)"
	w !?4,"Apply ANSI operator precedence :",?50,d
	s d=$$$AutoParallel s:d=1 d=d_" (Default)"
	w !?4,"Enable auto hinting for %PARALLEL :",?50,d
	s d=$$$AutoParallelThreshold s:d=3200 d=d_" (Default)"
	w !?4,"Threshold of auto hinting for %PARALLEL :",?50,d
	s d=$$$RTPCGLOBSETTING s:d=$$$RTPCDEFAULT d=d_" (Default)"
	w !?4,"Enable RTPC :",?50,d
	s d=$$$AdaptiveMode s:d=$$$ADAPTIVEMODEDEFAULT d=d_" (Default)"
	w !?4,"Enable adaptive mode :",?50,d
	s d=$$$ParamSamplingSetting s:d=$$$ParamSamplingDefault d=d_" (Default)"
	w !?4,"Enable parameter sampling :",?50,d
	s d=$$$ClientMaxIdleTimeSetting s:d=$$$DefaultClientMaxIdleTime d=d_" (Default)"
	w !?4,"Client maximum idle time :",?50,d
	s d=$$$GetLockTimeout s:d=10 d=d_" (Default)"
	w !?4,"Lock timeout:",?50,d
	s d=$$$SQLSecurityOn s:d=1 d=d_" (Default)"
	w !?4,"SQL security enabled:",?50,d
	s d=$$$GetReferentialChecks s:d=1 d=d_" (Default)"
	w !?4,"Perform referential integrity checks on",!?5,"foreign keys for INSERT, UPDATE, and DELETE:",?50,d
	s d=$$$GetODBCVarcharMaxlen s:d=4096 d=d_" (Default)"						// BJB247=
	w !?5,"ODBC VARCHAR Max Length:",?50,d								// BJB247=
	s d=$$$GetTODATEDefaultFormat s:d="DD MON YYYY" d=d_" (Default)"				// DPV2169=
	w !?5,"TO_DATE() Default Format:",?50,d								// DPV2169=
	s d=$$$AutoStatsForEfficientSamplingTableOnly s:d=1 d=d_" (Default)"
	w !?4,"Enable automatic statistics collection for tables supporting efficient sampling only :",?50,d
	s d=$$$AutoStatsForFixedStatsTable s:d=1 d=d_" (Default)"
	w !?4,"Enable automatic statistics collection for tables with fixed statistics :",?50,d
	s d=$$$AutoStatsForRemoteGlobalTable s:d=0 d=d_" (Default)"
	w !?4,"Enable automatic statistics collection for tables whose default data global maps to remote databases :",?50,d
	s d=$$$DisableNLSCollationMismatchLogging s:d=0 d=d_" (Default)"
	w !?4,"Disable NLS collation mismatch logging :",?50,d
	s d=$$$CompatibilityPreUnionCollation s:d=0 d=d_" (Default)"
	w !?4,"Preserve legacy UNION collation behavior for compatibility purposes :",?50,d
.
	w !?2,"DDL OPTIONS"
	s d=$$$GetddlNo30 s:d=0 d=d_" (Default)"
	w !?4,"Allow DDL DROP of non-existent table or view:",?50,d
	s d=$$$GetddlNo201 s:d=0 d=d_" (Default)"
	w !?4,"Allow DDL CREATE TABLE or CREATE VIEW",!?5,"for existing table or view:",?50,d
	s d=$$$GetddlNo307 s:d=0 d=d_" (Default)"
	w !?4,"Allow create primary key through DDL",!?5,"when key exists:",?50,d
	s d=$$$GetddlNo315 s:d=0 d=d_" (Default)"
	w !?4,"Allow DDL DROP of non-existent constraint:",?50,d
	s d=$$$GetddlNo324 s:d=0 d=d_" (Default)"
	w !?4,"Allow DDL CREATE INDEX for existing index:",?50,d
	s d=$$$GetddlNo333 s:d=0 d=d_" (Default)"
	w !?4,"Allow DDL DROP of non-existent index:",?50,d
	s d=$$$GetddlNo311 s:d=0 d=d_" (Default)"
	w !?4,"Allow DDL ADD foreign key constraint",!?5,"when foreign key exists:",?50,d
	s d=$$$GetDropDelete s:d=1 d=d_" (Default)"
	w !?4,"Does DDL DROP TABLE delete the table's data?:",?50,d
	s d=$$$GetIdKey s:d=1 d=d_" (Default)"
	w !?4,"Are primary keys created through",!?5,"DDL not ID keys:",?50,d
	s d=$$$GetDDLFinal s:d=1 d=d_" (Default)"
	w !?4,"Are classes created via DDL ",!?5,"CREATE TABLE statement defined as Final:",?50,d
	s d=$$$GetDDLUseSequence s:d=1 d=d_" (Default)"
	w !?4,"Do classes created by a DDL CREATE TABLE",!?5,"statement use $Sequence for ID assignment:",?50,d
	s d=$$$GetDDLDefineBitmapExtent s:d=1 d=d_" (Default)"
	w !?4,"Do classes created by a DDL CREATE TABLE",!?5,"statement define a bitmap extent index:",?50,d
	
	w !?2,"SQL OPTIMIZATION OPTIONS"	
	s d=$$$GetFastDistinct s:d=1 d=d_" (Default)"
	w !?4,"DISTINCT optimization turned on: ",?50,d
	set d=$g(^%SYS("sql","sys","parm incl outlier"),1) s:d=1 d=d_" (Default)"
	w !?4,"Bias queries as outlier: ",?50,d
	s d=+$G(^%SYS("HINT","%ALLINDEX")) s:d=0 d=d_" (Default)"
	w !?4,"%ALLINDEX hint turned on: ",?50,d
	s d=+$G(^%SYS("HINT","%NOFLATTEN")) s:d=0 d=d_" (Default)"
	w !?4,"%NOFLATTEN hint turned on: ",?50,d
	s d=+$G(^%SYS("HINT","%NOMERGE")) s:d=0 d=d_" (Default)"
	w !?4,"%NOMERGE hint turned on: ",?50,d
	s d=+$G(^%SYS("HINT","%NOSVSO")) s:d=0 d=d_" (Default)"
	w !?4,"%NOSVSO hint turned on: ",?50,d
	s d=+$G(^%SYS("HINT","%NOUNIONOROPT")) s:d=0 d=d_" (Default)"
	w !?4,"%NOUNIONOROPT hint turned on: ",?50,d
	s d=+$G(^%SYS("HINT","%NOTOPOPT")) s:d=0 d=d_" (Default)"
	w !?4,"%NOTOPOPT hint turned on: ",?50,d
	s d=+$G(^%SYS("HINT","%NOBSL")) s:d=0 d=d_" (Default)"
	w !?4,"%NOBSL hint turned on: ",?50,d
.
	w !?2,"RELATIONAL SERVER OPTIONS"
	s d=$g($$$SQLServerInitCode) s:d="" d="(NONE) (Default)"
	w !?4,"Server Initialization Code:",?50,d
	s d=$g($$$SQLServerDisconnectCode) s:d="" d="(NONE) (Default)"
	w !?4,"Server Disconnect Code:",?50,d
.
	QUIT
	
	// This call is made when allocating RowD values on sharded systems for tables with Sharded=2
	//  Arguments:
	//	- extentname	:: passed by value, input
	//	   Name of the extent for which we are getting an id
	//	- seqval	:: passed by value, input
	//	   Value the insert get for $sequence(^gloD)
	//	- suggestedId	:: passed by value, input
	//	   The ID we attempted to use, but it was beyond the end range of ids allocated to this system
	//	   The ID is seqval + ContextOffset
	//	- sqlcode	:: passed by reference, output
	//	   If there is an error, we return sqlcode here.  %msg is also set.
	// Return value:	
	//   New ID value to use for the row
	//	
GetNextIdRange(extentname,seqval,suggestedId,&sqlcode) [] PUBLIC {
	try {
		set csub=$namespace_":"_extentname,locked=0,sqlcode=0
		if '$d($system.Context.SQL().ShardIDRange(csub)) { set (procContextRange,$system.Context.SQL().ShardIDRange(csub))=$lb(0,0,0) }
		else                                             { set procContextRange=$system.Context.SQL().ShardIDRange(csub) }
		set extsubscript=extentname_".cls"
loop
			// CASE 1
			// We have gone past the process end range.
			// First see if there is already a range defined for this suggested id
	 	set newendrange=$o($$$SSShardLocalGlobal($$$SSNamespaceRangeSubscript,extsubscript,suggestedId),1,data)
		if newendrange {	// A range/offset has been defined for a endrange higher than this suggested id
				// Update process context object with new ranges/offsets
			do UpdateContextRangeValue(csub,$lg(data,1),newendrange,$lg(data,2),.procContextRange)
			set id=seqval+$lg(procContextRange,3)
		}
		else {
				// A range has not been defined for a value that includes this suggested id
				// see if we need to define one, or if a new range has already been defined by another process.
			lock +$$$SSShardLocalGlobal($$$SSNamespaceRangeSubscript,extsubscript):$s($zu(115,4)<10:10,1:$zu(115,4))				// lock the global using config setting lock timeout
			if '$t { set sqlcode=-110,%msg="Failed to acquire lock on "_$name($$$SSShardLocalGlobal($$$SSNamespaceRangeSubscript,extsubscript))_" in GetNextIdRange^%apiSQL" RETURN "" } 	// someone else has it locked, lasted too long, something is wrong, error out
			set locked=1
				// recheck to see if there is a range for this id
			set newendrange=$o($$$SSShardLocalGlobal($$$SSNamespaceRangeSubscript,extsubscript,suggestedId),1,data)
			if newendrange {	// A range/offset has been defined for a endrange higher than this suggested id
				// CASE 2
				// There is a namespace range we can use
		        	lock -$$$SSShardLocalGlobal($$$SSNamespaceRangeSubscript,extsubscript)#"I"
		        	set locked=0
					// Update process context object with new ranges/offsets
				do UpdateContextRangeValue(csub,$lg(data,1),newendrange,$lg(data,2),.procContextRange)
				set id=seqval+$lg(procContextRange,3)
			}
			else {		// CASE 3
					// namespace range is not defined or has not been updated with new values from shard master
					// get new range values
				set oldendrange=$o($$$SSShardLocalGlobal($$$SSNamespaceRangeSubscript,extsubscript,""),-1) set:oldendrange="" oldendrange=0
				set data=$g($$$SSShardLocalGlobal($$$SSNamespaceRangeSubscript,extsubscript,oldendrange))
				set sc=##class(%BigData.ShardedSQL).%NextIdRange(extentname, .beginrange, .endrange)
				if $$$ISERR(sc) { 
					set sqlcode=-400,%msg="Error requesting range of IDs to use for this sharded table.  "_$$GetErrorText^%apiOBJ(sc)
					lock -$$$SSShardLocalGlobal($$$SSNamespaceRangeSubscript,extsubscript)#"I"
					RETURN ""
				}
			       		// compute new offset
				if beginrange>1 { set offset=$lg(data,2)+beginrange-oldendrange } 	// Compute offset as old_offset + (new_begin_range - old_end_range)
				else { set offset=0 }							// Want this behavior for the first insert into the table (no namespace range defined).
				do UpdateContextRangeValue(csub,beginrange,endrange,offset,.procContextRange)
				set id=seqval+offset
				set $$$SSShardLocalGlobal($$$SSNamespaceRangeSubscript,extsubscript,endrange)=$lb(beginrange,offset)		// record offset to be used for ids < endrange
				lock -$$$SSShardLocalGlobal($$$SSNamespaceRangeSubscript,extsubscript)#"I"
				set locked=0
			}
		}
	}	// try
	catch {
		set id="",sqlcode=-400,%msg="Unexpected error encountered in GetNextIdRange^%apiSQL:  $ZError = "_$ze
		lock:locked -$$$SSShardLocalGlobal($$$SSNamespaceRangeSubscript,extsubscript)#"I"
		RETURN ""
	}
	if $g(id) > $lg(procContextRange,2) { 
			// We must make sure new id is not after the end range
			// When I have 30 processes building 4,000,000 rows each, I see this case 0% of the time (not seen once)
		set suggestedId=id
		goto loop
	}
	RETURN id
.
UpdateContextRangeValue(csub,beginrange,endrange,offset,&procContextRange)
	set (procContextRange,$system.Context.SQL().ShardIDRange(csub))=$lb(beginrange,endrange,offset)
	QUIT
.
} 
.
	// This call is made when allocating AUTO_INCREMENT field values on sharded systems for tables with Sharded=2
	//  Arguments:
	//	- extentname	:: passed by value, input
	//	   Name of the extent for which we are getting an id
	//	- seqval	:: passed by value, input
	//	   Value the insert get for $sequence(^gloD)
	//	- suggestedId	:: passed by value, input
	//	   The ID we attempted to use, but it was beyond the end range of ids allocated to this system
	//	   The ID is seqval + ContextOffset
	//	- sqlcode	:: passed by reference, output
	//	   If there is an error, we return sqlcode here.  %msg is also set.
	// Return value:	
	//   New value to use for the AI field
	//	
GetNextAIRange(extentname,seqval,suggestedId,&sqlcode) [] PUBLIC {
	try {
		set csub=$namespace_":"_extentname,locked=0,sqlcode=0
		if '$d($system.Context.SQL().ShardAIRange(csub)) { set (procContextRange,$system.Context.SQL().ShardAIRange(csub))=$lb(0,0,0) }
		else                                             { set procContextRange=$system.Context.SQL().ShardAIRange(csub) }
		set extsubscript=extentname_".cls"
loop
			// CASE 1
			// We have gone past the process end range.
			// First see if there is already a range defined for this suggested value
	 	set newendrange=$o($$$SSShardLocalGlobal($$$SSNamespaceAIRangeSubscript,extsubscript,suggestedId),1,data)
		if newendrange {	// A range/offset has been defined for a endrange higher than this suggested id
				// Update process context object with new ranges/offsets
	        	do UpdateContextRangeValue(csub,$lg(data,1),newendrange,$lg(data,2),.procContextRange)
			set id=seqval+$lg(procContextRange,3)
		}
		else {
				// A range has not been defined for a value that includes this suggested AI value
				// see if we need to define one, or if a new range has already been defined by another process.
			lock +$$$SSShardLocalGlobal($$$SSNamespaceAIRangeSubscript,extsubscript):$s($zu(115,4)<10:10,1:$zu(115,4))				// lock the global using config setting lock timeout
			if '$t { set sqlcode=-110,%msg="Failed to acquire lock on "_$name($$$SSShardLocalGlobal($$$SSNamespaceAIRangeSubscript,extsubscript))_" in GetNextAIRange^%apiSQL" RETURN "" } 	// someone else has it locked, lasted too long, something is wrong, error out
			set locked=1
				// recheck to see if there is a range for this value
			set newendrange=$o($$$SSShardLocalGlobal($$$SSNamespaceAIRangeSubscript,extsubscript,suggestedId),1,data)
			if newendrange {	// A range/offset has been defined for a endrange higher than this suggested id
				// CASE 2
				// There is a namespace range we can use
		        	lock -$$$SSShardLocalGlobal($$$SSNamespaceAIRangeSubscript,extsubscript)#"I"
		        	set locked=0
					// Update process context object with new ranges/offsets
	   		     	do UpdateContextRangeValue(csub,$lg(data,1),newendrange,$lg(data,2),.procContextRange)
				set id=seqval+$lg(procContextRange,3)
			}
			else {		// CASE 3
					// namespace range is not defined or has not been updated with new values from shard master
					// get new range values
				set oldendrange=$o($$$SSShardLocalGlobal($$$SSNamespaceAIRangeSubscript,extsubscript,""),-1) set:oldendrange="" oldendrange=0
				set data=$g($$$SSShardLocalGlobal($$$SSNamespaceAIRangeSubscript,extsubscript,oldendrange))
				set sc=##class(%BigData.ShardedSQL).%NextAIRange(extentname, .beginrange, .endrange)
				if $$$ISERR(sc) { 
					set sqlcode=-400,%msg="Error requesting range of Auto_Increment values to use for this sharded table.  "_$$GetErrorText^%apiOBJ(sc)
					lock -$$$SSShardLocalGlobal($$$SSNamespaceAIRangeSubscript,extsubscript)#"I"
					RETURN ""
				}
			       		// compute new offset
				if beginrange>1 { set offset=$lg(data,2)+beginrange-oldendrange } 	// Compute offset as old_offset + (new_begin_range - old_end_range)
				else { set offset=0 }							// Want this behavior for the first insert into the table (no namespace range defined).
				do UpdateContextRangeValue(csub,beginrange,endrange,offset,.procContextRange)
				set id=seqval+offset
				set $$$SSShardLocalGlobal($$$SSNamespaceAIRangeSubscript,extsubscript,endrange)=$lb(beginrange,offset)		// record offset to be used for ids < endrange
				lock -$$$SSShardLocalGlobal($$$SSNamespaceAIRangeSubscript,extsubscript)#"I"
				set locked=0
			}
		}
	}	// try
	catch {
		set id="",sqlcode=-400,%msg="Unexpected error encountered in GetNextAIRange^%apiSQL:  $ZError = "_$ze
		lock:locked -$$$SSShardLocalGlobal($$$SSNamespaceAIRangeSubscript,extsubscript)#"I"
		RETURN ""
	}
	if $g(id) > $lg(procContextRange,2) { 
			// We must make sure new id is not after the end range
			// When I have 30 processes building 4,000,000 rows each, I see this case 0% of the time (not seen once)
		set suggestedId=id
		goto loop
	}
	RETURN id
.
UpdateContextRangeValue(csub,beginrange,endrange,offset,&procContextRange)
	set (procContextRange,$system.Context.SQL().ShardAIRange(csub))=$lb(beginrange,endrange,offset)
	QUIT
} 
 
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;   SQL CONFIGURATION SETTINGS
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 
 
SetDDLNo30(flag,oldval) [] PUBLIC {
	#;  Function:     SetDDLNo30^%apiSQL(flag)
	#;  Description:  Set the flag which determines if an SQLCODE -30 
	#;                error is returned when the attempt is made to 
	#;                DROP a non-existing table through DDL.
	#;                The default is that an error is returned
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                not return an error an attempt is made to DROP
	#;                a non-existent table through DDL.  Otherwise,
	#;                return SQLCODE=-30.  The default is 0 (FALSE).
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetddlNo30
	s sc=$$$SetddlNo30(''$g(flag))
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","ddl","no30")=''$g(flag)
	QUIT sc
}
 
 
SetDDLNo201(flag,oldval) [] PUBLIC {
	#;  Function:     SetDDLNo201^%apiSQL(flag)
	#;  Description:  Set the flag which determines if an SQLCODE -201
	#;                error is returned when the attempt is made to 
	#;                CREATE a table through DDL that already exists.
	#;                The default is that an error is returned
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                not return an error an attempt is made to CREATE
	#;                a table through DDL that already exists.
	#;                The existing table will be dropped, and then the
	#;                CREATE TABLE will occur.
	#;                Otherwise, return SQLCODE=-201.
	#;                The default is 0 (FALSE).
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetddlNo201
	s sc=$$$SetddlNo201(''$g(flag))
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","ddl","no201")=''$g(flag)
	QUIT sc
}
 
 
SetDDLNo307(flag,oldval) [] PUBLIC {
	#;  Function:     SetDDLNo307^%apiSQL(flag)
	#;  Description:  Set the flag which determines if an SQLCODE -307
	#;                error is returned when the attempt is made to 
	#;                add a primary key constraint to a table through DDL
	#;                when a primary key constraint already exists for
	#;                the table.
	#;                The default is that an error is returned
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                not return an error an attempt is made add a
	#;                primary key constraint to a table through DDL when
	#;                a primary key constraint already exists for the 
	#;                table.  The existing primary key constraint will 
	#;                be dropped, and then new primary key constraint
	#;                added.
	#;                Otherwise, return SQLCODE=-307.
	#;                The default is 0 (FALSE).
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetddlNo307
	s sc=$$$SetddlNo307(''$g(flag))
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","ddl","no307")=''$g(flag)
	QUIT sc
}
 
 
SetDDLNo311(flag,oldval) [] PUBLIC {
	#;  Function:     SetDDLNo311^%apiSQL(flag)
	#;  Description:  Set the flag which determines if an SQLCODE -311
	#;                error is returned when the attempt is made to 
	#;                Create a Foreign Key constraint when a Foreign Key
	#;                constraint with the same name already exists for the
	#;                class.
	#;                The default is that an error is returned
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                not return an error an attempt is made to CREATE
	#;                a duplicate foreign key constraint through DDL.  
	#;                Otherwise, return SQLCODE=-311.  The default is 0 (FALSE).
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetddlNo311
	s sc=$$$SetddlNo311(''$g(flag))
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","ddl","no311")=''$g(flag)
	QUIT sc
}
 
 
SetDDLNo315(flag,oldval) [] PUBLIC {
	#;  Function:     SetDDLNo315^%apiSQL(flag)
	#;  Description:  Set the flag which determines if an SQLCODE -315
	#;                error is returned when the attempt is made to 
	#;                DROP a non-existing constraint through DDL.
	#;                The default is that an error is returned
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                not return an error an attempt is made to DROP
	#;                a non-existent constraint through DDL.  Otherwise,
	#;                return SQLCODE=-315.  The default is 0 (FALSE).
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetddlNo315
	s sc=$$$SetddlNo315(''$g(flag))
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","ddl","no315")=''$g(flag)
	QUIT sc
}
 
 
SetDDLNo324(flag,oldval) [] PUBLIC {
	#;  Function:     SetDDLNo324^%apiSQL(flag)
	#;  Description:  Set the flag which determines if an SQLCODE -324
	#;                error is returned when the attempt is made to 
	#;                CREATE an index through DDL that already exists.
	#;                The default is that an error is returned
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                not return an error an attempt is made to CREATE
	#;                an index through DDL that already exists.
	#;                The existing index will be dropped, and then the
	#;                CREATE INDEX will occur.
	#;                Otherwise, return SQLCODE=-324.
	#;                The default is 0 (FALSE).
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetddlNo324
	s sc=$$$SetddlNo324(''$g(flag))
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","ddl","no324")=''$g(flag)
	QUIT sc
}
 
 
SetDDLNo333(flag,oldval) [] PUBLIC {
	#;  Function:     SetDDLNo333^%apiSQL(flag)
	#;  Description:  Set the flag which determines if an SQLCODE -333
	#;                error is returned when the attempt is made to 
	#;                DROP a non-existing index through DDL.
	#;                The default is that an error is returned
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                not return an error an attempt is made to DROP
	#;                a non-existent index through DDL.  Otherwise,
	#;                return SQLCODE=-333.  The default is 0 (FALSE).
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetddlNo333
	s sc=$$$SetddlNo333(''$g(flag))
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","ddl","no333")=''$g(flag)
	QUIT sc
}
 
 
SetDDLDropTabDelData(flag,oldval) [] PUBLIC {
	#;  Function:     SetDDLDropTabDelData^%apiSQL(flag)
	#;  Description:  Set the flag which determines a DDL DROP TABLE
	#;                statement deletes the table's data.
	#;                By default, the data is dropped when a table
	#;                is dropped through DDL.
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                DELETE the table's data when the table is dropped.
	#;                Otherwise, the data is not deleted.
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetDropDelete
	s sc=$$$SetDropDelete(''$g(flag))
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","ddl","drop table delete data")=''$g(flag)
	QUIT sc
}
 
 
SetDDLPKeyNotIDKey(flag,&oldval) [] PUBLIC {
	#;  Function:     SetDDLPKeyNotIDKey^%apiSQL(flag)
	#;  Description:  Set the flag which determines a Primary Key
	#;                constraint specified through DDL also becomes
	#;                the IDKey index in the class definition or not.
	#;                By default, the primary key does also become the 
	#;                idkey index.  This generally gives better 
	#;                performance, but it means the Primary key fields
	#;                cannot be updated.
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                NOT make Primary Key constraints become IDKey
	#;                indices.  Otherwise, the Primary Key index will 
	#;                also become the IDKey index.
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	RETURN $$SetDDLPKeyNotIDKey^%SYS.SQLSRV(''$g(flag),.oldval)
}
 
 
SetDefaultSchema(schema,&oldval,nameSpace=0) [] PUBLIC {
	#;  Function:     SetDefaultSchema^%apiSQL(flag)
	#;  Description:  Sets the default schema used by SQL.
	#;                This setting provides the ability to define a default 
	#;                schema name other than SQLUser, the default. When an 
	#;                unqualified table name is encountered in an SQL statement 
	#;                (and there is no #import statement specified), the default 
	#;                schema will be used.  You may specify _CURRENT_USER for 
	#;                the default schema name if you wish to use the SQL username
	#;                the process logged in as the name of the default schema. 
	#;                If the process has not logged in to SQL, SQLUser will be 
	#;                used as the default schema name.  You may also specify 
	#;                _CURRENT_USER/<default name>.  In this case, if the process 
	#;                has not logged in to SQL, <default name> will be used as 
	#;                the default schema name.  
	#;                For example:  _CURRENT_USER/HMO will use HMO as the default 
	#;                schema if the process has not logged in to SQL.  This setting 
	#;                has nothing to do with the mappings between SQL schema names 
	#;                and the class package name, it only specifies the default schema.
	#;  Parameters:
	#;     1.  schema - String containing the default SQL schema name
	#;     2.  oldval - PBR. Returns old setting.
	#;     3.  nameSpace - 1/0 flag.  If TRUE, set the default schema for this namespace only 
	#;                  default is FLASE
	#;                  If you pass in schema="" and nameSpace=1, it will delete the namespace entry and this
	#;                  namespace will revert back to using system defined default.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	RETURN $$SetDefaultSchema^%SYS.SQLSRV($g(schema),.oldval,nameSpace)
}
 
 
SetDDLIdentifierTranslations(from,to,oldfrom,oldto) [] PUBLIC {
	#;  Function:     SetDDLIdentifierTranslations^%apiSQL(from,to)
	#;  Description:  Modifies the DDL Identifier Tanslation mappings.
	#;                This is for filtering/modifying valid SQL identifier
	#;                characters when translating SQL identifiers into
	#;                Objects identifiers.
	#;                When converting an SQL identifier to an Objects Identifier
	#;                at DDL run time, the characters in the 'from' list will be converted
	#;                to the characters in the 'to' list.  This is done through the
	#;                ObjectScript $Translate function.  For example:
	#;                SQL Table name = "My Table!"
	#;                from = '"! '
	#;                to = ''
	#;                Class name = $Translate("My Table!",from,to) = MyTable
	#;  Parameters:
	#;     1.  from  - A string of characters to translate from
	#;     2.  to    - A string of characters to translate to (by position in the string)
	#;                 Optional.  Default is "".
	#;     3.  oldfrom - PBR. Returns old setting of IdTrxFrom
	#;     4.  oldto - PBR.  Returns the old setting of IdxTrxTo
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldfrom=$$$GetIdTrxFrom,oldto=$$$GetIdTrxTo
	s sc=$$$SetIdTrxFrom($g(from))
	If $$$ISERR(sc) QUIT sc
	s sc=$$$SetIdTrxTo($g(to))
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","ddl","identifier translation")=$lb($g(from),$g(to))
	QUIT sc
}
 
 
SetDDLCompileSQLOnly(flag,oldval) [] PUBLIC {	//  *** NOT DOCUMENTED ***
	#;  Function:     SetCompileSQLOnly^%apiSQL(flag)
	#;  Description:  Set the flag which determines if the 'o' flag is
	#;                passed to the class compiler during class compilations
	#;                resulting from executing DDL statements.
	#;                The 'o' flag causes an 'SQL Only' class compilation to
	#;                occur
	#;  Parameters:
	#;     1.  flag - 1 or 0.  If TRUE, set the system wide flag to
	#;                perform SQL Only compiles through DDL.
	#;                A value of FALSE performs a normal class compilation
	#;                The default is FALSE (Off)
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetDDLSQLOnlyCompile
	s sc=$$$SetDDLSQLOnlyCompile(''$g(flag))
	QUIT sc
}
 
 
ListDDLDatatypes	;
	#;  Procedure:    ListDDLDatatypes^%apiSQL
	#;  Description:  Displays all the entries from the DDL Datatype
	#;                Mapping Table.
	#;-------------------------------------------------------------------
	n c,d,sys,user,w
	d GetAllSysDatatypes^%SYS.CONFIG(,.sys)
	d GetAllUserDatatypes^%SYS.CONFIG(,.user)
	m sys=user
	w !!,"DDL Datatype",?32,"Maps to IRIS' Datatype"
	w !,"------------------------------",?32,"----------------------------------------------"
	s d="" 
	For  {
		s d=$o(sys(d),1,c) q:d=""
		w !,d 
		f w=0:46:((($l(c)\46)+1)*46) i $e(c,w+1,w+46)'="" w:w ! w ?32,$e(c,w+1,w+46)
	}
	QUIT
 
 
Maxval(p,s) g maxvale
maxval(p,s) ;
maxvale	;
	#;  Function:     maxval^%apiSQL(precision,scale)
	#;  Description:  Funtion to return the value for MAXVAL for the
	#;                IRIS numeric datatypes given a precision and 
	#;                scale.
	#;  Parameters:
	#;     1. p - precision, required
	#;     2. s - scale, optional
	#;-------------------------------------------------------------------
	i '$g(s) { QUIT:p>18 $$$MaxCacheInt QUIT $e($$$MaxNum,1,p) }  ;Precision, no scale specified
	QUIT:(p-s)>18 $$$MaxCacheInt_"."_$e($$$MaxNum,1,s)
	QUIT $e($$$MaxNum,1,p-s)_"."_$e($$$MaxNum,1,s)  ; Precision & Scale specified
 
 
Minval(p,s) g minvale
minval(p,s) ;
minvale	;
	#;  Function:     minval^%apiSQL(precision,scale)
	#;  Description:  Funtion to return the value for MINVAL for the
	#;                IRIS numeric datatypes given a precision and 
	#;                scale.
	#;  Parameters:
	#;     1. p - precision, required
	#;     2. s - scale, optional
	#;-------------------------------------------------------------------
	i '$g(s) { QUIT:p>18 $$$MinCacheInt QUIT "-"_$e($$$MaxNum,1,p) } ;Precision, no scale specified
	QUIT:(p-s)>18 $$$MinCacheInt_"."_$e($$$MaxNum,1,s)
	QUIT "-"_$e($$$MaxNum,1,p-s)_"."_$e($$$MaxNum,1,s)  ; Precision & Scale specified
 
 
Format(p,s) g formate
format(p,s) ;
formate	;
	#;  Function:     format^%apiSQL(precision,scale)
	#;  Description:  Funtion to return the value for FORMAT for the
	#;                IRIS numeric datatypes given a precision and 
	#;                scale.
	#;  Parameters:
	#;     1. p - precision, required
	#;     2. s - scale, required
	#;-------------------------------------------------------------------
	QUIT ""   //$s((p-s)>0:"#",1:"")_"."_$e($$$ZeroMask,1,s)  ; Precision & Scale specified  (DPV1722)
 
 
SetAllowExtrinsicFunctions(flag=0,oldval) [] PUBLIC {
	#;  Function:     SetAllowExtrinsicFunctions^%apiSQL(flag)
	#;  Description:  Allows/disallows extrinsic functions to be used 
	#;                in SQL statements through ODBC, JDBC, and Dynamic Query.
	#;  Parameters:
	#;     1.  flag - 0 or 1.  0 Is the default
	#;                If 0, do not allow extrinsic functions in SQL statements 
	#;                      through ODBC, JDBC, or Dynamic SQL
	#;                If 1, do allow extrinsic functions in SQL statements 
	#;                      through ODBC, JDBC, or Dynamic SQL
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetExtrinsicFunctions
	s sc=$$$SetExtrinsicFunctions(''flag)
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","allow extfunc calls")=''flag
	QUIT sc
}
.
SetANSIPrecedence(flag=0,oldval) [] PUBLIC {
	#;  Function:     SetANSIPrecedence^%apiSQL(flag)
	#;  Description:  Enable/Disable ANSI operator precedence
	#;  Parameters:
	#;     1.  flag - 0 or 1.  0 Is the default
	#;                If 0, apply ANSI operator precedence
	#;                If 1, diable ANSI operator precedence
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	set oldval=$$$GetANSIPrecedence
	set tSC=$$$SetANSIPrecedence(''flag)
	RETURN:$$$ISERR(tSC) tSC
	set ^%SYS("sql","sys","ansi operator precedence")=$g(flag,0)
	$$$SQLCompileUpdateContext  // **NOTE: This MACRO must be placed AFTER setting the appropriate global with the new 'flag' value!
	RETURN tSC
}
.
SetAutoParallel(flag=0,oldval) [] PUBLIC {
	#;  Function:     SetAutoParallel^%apiSQL(flag)
	#;  Description:  Enable/Disable auto hinting for %PARALLEL
	#;  Parameters:
	#;     1.  flag - 0 or 1.  1 Is the default
	#;                If 0, disable auto hinting
	#;                If 1, enable auto hinting
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetAutoParallel
	s sc=$$$SetAutoParallel(''flag)
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","auto hinting for %parallel")=$g(flag,0)
	QUIT sc
}
.
SetAutoParallelThreshold(threshold=3200,&oldval) [] PUBLIC {
	#;  Function:     SetAutoParallelThreshold^%apiSQL(threshold)
	#;  Description:  Set the threshold for auto hinting for %PARALLEL
	#;  Parameters:
	#;     1.  threshold
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	RETURN $$SetAutoParallelThreshold^%SYS.SQLSRV(threshold,.oldval)
}
SetRTPC(flag=1,oldval) [] PUBLIC {
	#;  Function:     SetRTPC^%apiSQL(flag)
	#;  Description:  Enable/Disable Run Time Plan Choice
	#;  Parameters:
	#;     1.  flag - 0 or 1.  1 Is the default
	#;                If 0, disable RTPC
	#;                If 1, enable RTPC
	#;     2.  oldval - PBR. Returns old setting.
	#;
	#;  Returns       Status Code
	#;-------------------------------------------------------------------
	Set oldval=$$$GetRTPC
	;RETURN:flag=oldval $$$OK // no change, JSL5188, JSL5199 - back this off since this quick return causes multiple RTPC tests to fail
	s sc=$$$SetRTPC(''flag)
	If $$$ISERR(sc) QUIT sc
	s ^%SYS("sql","sys","rtpc")=$g(flag,$$$RTPCDEFAULT)
	QUIT sc
}
