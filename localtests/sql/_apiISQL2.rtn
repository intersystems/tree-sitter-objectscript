====
apiISQL2
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%apiISQL2^MAC^^^0
%apiISQL2
  Quit
 
 #include %occInclude
 
 // build an .INT routine of the given name from the given COS array
 // - the array can be given either as codearr(1..codearr) or codearr(1..,1..)
 // returns "" or $ZE
 //AC@@@@ consider doing it through global ^ROUTINE and $Compile (see ^%qarmac)
BuildIntRt(rt,codearr,header) [codearr] PUBLIC {
	
  Set $ZTrap="trap"
  If $Data(header) {
    Set epcode="ZI """_header_""" "
  }
  Else {
    Set epcode=""
  }
  If $Data(@"codearr"@(1,1)) {
    Set forloop="ZInsert:$Data(codearr(0)) codearr(0) For i=1:1 {Quit:'$Data(codearr(i))  ZInsert:$Data(codearr(i))#10 "" ;-- ""_codearr(i) For j=1:1  {Quit:'$Data(codearr(i,j))  ZInsert codearr(i,j)}}"
  }
  Else {
    Set forloop="For i=1:1:codearr {ZInsert codearr(i)}"
  }
  Set exec="ZRemove  "_epcode_"New i,j "_forloop_" ZSave "_rt
  Xecute exec
  Quit ""
trap
  Do Log^%apiISQL("Building ^"_$Get(rt,"(rt undefined)")_".INT: "_$ZError)
  Quit $ZE
}
 
  
 // report an error
 //
 // sc - pass as status code (already assumed to be an error)
 // message - pass a message to be written both to the current device and to the log (or "") (optional)
 // outcome - pass an array of stats (optional)
ReportError(sc,message="",outcome) PUBLIC {
	Do ##class(%XSQL.Reporting).ReportError(sc,message,.outcome)
}
 
 
 // purge temporary tables for the given stored procedure (class_"z"_method)
PurgeTempTables(spname) PUBLIC {
	Do PurgeTables("ISQLTEMP",spname_"z")
}
 
 
 // purge the tables in the given schema whose name begins with the given prefix
PurgeTables(schema,tablepref) PUBLIC {
	
	If '$Data(^oddSQL) Do OLDPurgeTables(schema,tablepref) Quit  // temporary: for backward compability
	
	Set ltablepref=$Length(tablepref)	
	Set table=tablepref While 1 {
		Set table=$Order(^oddSQL(schema,table)) If (table="") || ($Extract(table,1,ltablepref)'=tablepref) {Quit}
		
		Do DropTable^%apiSQL(schema_"."_table,1,.SQLCODE,.msg)
		// - we don't care whether it worked or not at this point
	}
}
 
 
 // purge the tables in the given schema whose name begins with the given prefix
 // temporary: for backward compatibility
OLDPurgeTables(schema,tablepref) PUBLIC {
	Set ltablepref=$Length(tablepref)	
	Set table=tablepref While 1 {
		Set table=$Order(^mdd(5,schema,table)) If (table="") || ($Extract(table,1,ltablepref)'=tablepref) {Quit}
		Do DropTable^%apiSQL(schema_"."_table,1,.SQLCODE,.msg)
		// - we don't care whether it worked or not at this point
	}
}
 
 
