====
apiISQL
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%apiISQL^MAC^^^0
%apiISQL
.
  Do Shell()
  Quit
 
 #include %occInclude
 
 // the ISQL shell
Shell() PUBLIC {
	
	// the object which interfaces to IRISISQL.DLL
	Set t=##class(%ISQL.Transformer).%New()
	
	// if the DLL directory is overridden, tell the interface object and the user
	If $Data(^%ISQL("BINDIR")) {
		Set t.BinDir=^%ISQL("BINDIR")
		Write "Loading DLL from ",t.BinDir,!
	}
	
	// if settings are given, note them
	If $Data(^%ISQL("SETTINGS")) {
		Set settings=^%ISQL("SETTINGS")
		Write "Using settings ",settings,!
	}
	Else {
		Set settings=""
	}
	
	#; DPV2198- If '$Data(%msql) {Set %msql="_SYSTEM"}
	
	// loop over ISQL batches
	Do {	  
		Set exit=$$ShellBatch(t,.settings,.macrtname,.intrtname)
	} While exit=""
	
	// logout if requested
	if exit="H" Halt
}
 
 
  // handle one batch, returns "Q" to quit the shell, "H" to quit and logout
  // - may update settings
ShellBatch(t,settings,macrtname,intrtname) PRIVATE {
 
  Write !	 
  Set s=##class(%Library.GlobalCharacterStream).%New()
  Set s.LineTerminator=$Char(10)
  Set i=1
  Set executeaction=""
  
  Kill %objlasterror
    
  // loop over lines
  Set exit="" // set to "Q" to quit, "H" to quit and logout
  Do {
	   
    // prompt
    Write $namespace,":ISQL> "
    Read in,!
      
    // check for common exit cues
    If (in="^") || (in="^Q") || (in="^q") {Set exit="Q" Quit}
    If (in="h") || (in="H") {Set exit="H" Quit}
    
    Set lin=$Length(in)
    
    // empty/whitespace means we have all the lines
    If $Translate(in," ","")="" {Quit}
	 
    // ? => help
    If $Extract(in,1)="?" {
      Do ShellHelp(in,settings)
    }
	 
    // !xxx => execute COS
    ElseIf $Extract(in,1)="!" {
      Do ShellExecuteCos($Extract(in,2,*))
    }   
    
    // =xxx => sets settings
    ElseIf $Extract(in)="=" {
      Set (^%ISQL("SETTINGS"), settings)=$Extract(in,2,*)
      Write "Settings updated.",!
    }
    
    // . => list INT code
    ElseIf in="." {
      Do ShellListInt(.intrtname)
    }
    
    // / => list MAC code
    ElseIf in="/" {
      Do ShellListMac(.macrtname)
    }
    
    // anything else is a code line
    Else {
	    
    	// trailing "/x" or "/X" means execute it when done
    	If ($ZCVT($Extract(in,lin-1,lin), "U")="/X") {
      		Set executeaction="X"
      		Set in=$Extract(in,1,lin-2)
    	}
    
    	// .. trailing "/c" or "/C" means compile generated COS when done ..
    	ElseIf ($ZCVT($Extract(in,lin-1,lin), "U")="/C") {
      		Set executeaction="C"
      		Set in=$Extract(in,1,lin-2)
    	}
	    
    	// <xxx => read from file
    	If $Extract(in,1)="<" {
      		Do ShellFile($Extract(in,2,*), s)
    	}
	    
    	// anything else => a single line of ISQL	 
    	Else {	     	   
      		Do s.WriteLine(in)
    	}	  
    }
  } While exit=""
  
  // if the user entered "^" or similar, quit
  If exit'="" {Quit exit}
   
  // if the user didn't enter anything, quit
  Do s.Rewind()
  If s.AtEnd {Quit "Q"}
  
  // extract method name from source stream
  Set methodname=$$ExtractMethodName(s) If methodname="" {Set methodname="METHOD"}
  Do s.Rewind()
  
  // transform the stream
  Set ocsettings=$Select(settings="":"OC",1:"OC,"_settings) // always use the old compiler - use %CPT.Callout*.cls instead of ^%apiISQL if you want a parse tree
  Set sc=$$DoTransform^%apiISQL5(t,s,ocsettings,executeaction,$ListBuild("ISQL.StoredProcedures",methodname),.macrtname,.intrtname,.outcome)
  If $$$ISERR(sc) {Do ReportError^%apiISQL2(sc,,.outcome)}
  
  Quit ""
}
 
 
 // give help on the ISQL shell
ShellHelp(in,settings) PRIVATE {
	If $ZCVT(in,"U")="?EXT" {
		Write !
		Write "ISC Extensions to ISQL",!
		Write !
		Write "CACHE <<coscode>> - includes the coscode in the generated MAC code",!
		Write "                  - CACHE <<&SQL(..)>> works too!",!
		Write !
		Write "ZZ command args - for debugging the compiler, dumps are output to",!
		Write "                  generated MAC code as comments",!
		Write !
		Write " ZZ DUMP VARS   - dump ISQL symbol table",!
		Write " ZZ DUMP GENENV - dump internal code-generator environment",!
		Write " ZZ TYPE expr   - dump the ISQL type of the given expression",!
		Write " ZZ CONSOLE     - launch the ISQL debug console",!
	}
	Else {
		Write !
		Write "?      - this help",!
		Write "?ext   - help on ISC extensions to ISQL",!
		Write !
		Write "!xxx   - execute xxx as a COS command",!
		Write "H or h - a convenient shorthand for !H (logs out)",!
		Write "=xxx   - set ^%ISQL(""SETTINGS"") to xxx",!
		Write ".      - list the generated INT code (not SPs)",!
		Write "/      - list the generated MAC code (not SPs)",!
		Write !
		Write "Anything else is taken to be ISQL code, successive lines add to the batch",!
		Write "- to input lines from file 'xxx': <xxx",!
		Write !
		Write "To process the current batch of code enter an empty line",!
		Write !
		Write "The code is compiled by ISQL using the default moniker (currently PROCEDUREBODY)",!
		Write "- to compile the translated ISQL append '/c'or '/C' to any code line",!
		Write "- for non-SPs: to compile and execute the translated ISQL append '/x'or '/X' to any code line",!
		Write !
		Write "Advanced: set ^%ISQL(""BINDIR"") to the IRISISQL.DLL directory",!
		Write !
		Write "A settings string is a comma-delimited list of key or key=value parts, these keys are supported :-",!
		Write "- GENRAW/GR (flag) to suppress some scaffolding code (the result can't be run)",!
		Write "- MESSAGELIMIT=n/ML=n (int) to limit the total number of warnings/errors in compilation output (default 40)",!
		Write "- MESSAGEPERLINELIMIT=n/MPLL=n (int) to limit the number of warnings/errors in compilation output per line (default 1)",!
		Write "- NODECLCHECK/NDC (flag) to suppress the check that all @variables are declared",!
		Write "- NORESOLVE/NR (flag) to suppress deferred-code resolution (only useful for debugging the compiler)",!
		Write "- NOOPTLAB/NOL (flag) to suppress label optimization (only useful for debugging the compiler)",!
		Write "- UNDERLINE/UL=s to specify what string should replace underline in identifiers (default is empty)",!
		Write "- SCHEMA/SC=s to specify the schema for unqualified tables (default is empty)",!
		Write "(settings keys are case-insensitive, settings are stored in ^%ISQL(""SETTINGS""))",!
		Write !
		Write "Practical settings :-",!
		Write " - to see just the essential generated code enter: =GR",!
		Write " - for code suitable for MAC compilation and execution just enter: =",!
		Write !
		Write "Current settings: ",settings,!
	}
}
 
 
 // read source from a file for ISQL shell
ShellFile(path, s) PUBLIC {
	
	Set file=##class(%File).%New(path)
	Do file.Open("RS")
	If file.IsOpen {
		Set i=1
		Do {
			Set line=file.Read(file.SizeGet())
			Write $Justify(i,3)_"> ",line,!
			Do s.WriteLine(line)
			Set i=i+1
		} While 'file.AtEnd
	}	
	Else {
		Write "File not found.",!
	}   
}
 
 
 // execute COS
ShellExecuteCos(code) PRIVATE {
	Set $ZTrap="TRAP"
	Xecute code
	Write !
	Quit
TRAP
	Write !,$ZE,!
	Quit
}
 
 
 // show error log for the ISQL shell
 //AC@@@@ use line delimiter
ShellShowErrors(errors,sourcestream) PUBLIC {
	Do Log^%apiISQL("Error log ..")
	Do ToArray^%apiISQL2(sourcestream, .s)
	Set towrite=""
	Set lf=$Char(10)
	While 'errors.AtEnd {
		Set towrite=towrite_errors.Read(32767)
		While (towrite[lf) || ((towrite'="")&&(errors.AtEnd)) {
			Set err=$Piece(towrite,lf)
			Do Log^%apiISQL("")
			Do Log^%apiISQL(err)
			If $Extract(err,1,6)="Error " {
				If err[" line " {
					Set lineno=$Piece($Piece(err," line ",2)," column ")
					Set colno=$Piece($Piece(err," column ",2),":")
					If $Data(s(lineno)) {
						Do Log^%apiISQL(s(lineno))
						Do Log^%apiISQL($J("^",colno))
					}
				}
			}
			Set towrite=$Piece(towrite,lf,2,$Length(towrite,lf))
		}
	}
}
 
 
 // show generated MAC code for the ISQL shell
ShellListMac(macrtname) PRIVATE {
	If '$Data(macrtname) {
		Do Log^%apiISQL("No MAC code")
	}
	Else {
		If '$Data(^rMAC(macrtname)) {
			Do Log^%apiISQL("MAC routine "_macrtname_" not found")
		}
		Else {
			For i=1:1 {
				If '$Data(^rMAC(macrtname,0,i)) {Quit}
				Do Log^%apiISQL($Justify(i,3)_": "_^rMAC(macrtname,0,i))
			}
		}
	}
}
 
 
 // show generated INT code for the ISQL shell
ShellListInt(intrtname) PRIVATE {
	If '$Data(intrtname) {
		Do Log^%apiISQL("No INT code")
	}
	Else {
		Set $ZTrap="trap"
		Xecute "ZLoad "_intrtname_" New i,line For i=1:1 {Set line=$Text(+i) If line="""" {Quit} Write $Justify(i,3),"": "",line,!}"
		// - nb: not sent to Log
	}
	Quit
trap
	If $ZError'["<NOROUTINE>" ZQuit
	Do Log^%apiISQL("INT routine "_intrtname_" not found")
}
 
 
 // stored-procedure compile-time hooks - invoked through #execute
 
 
 // handle table-indirection and compile-time-run for the code generated by the PREVIOUS line
 //
 // note: IRISISQL.DLL generates code which causes this procedure to be invoked at compile-time
 //
SPLineTA(tablelist, ctr, delrtc) [linearry, oline, oline2, SQLCODE] PUBLIC {
 
	// three cases involving list and ctr :-
	// (1) tablelist="", ctr=1   -- CREATE TABLE X
	// (2) tablelist'="", ctr=0  -- SELECT * FROM @T
	// (3) tablelist'="", ctr=1  -- DECLARE @T TABLE or CREATE TABLE #X
	// - tablelist="", ctr=0 is not allowed
	//
	// tablelist is $LB("table1","table2",..) for each temporary table
	//
	// delrtc is 1 to delete runtime code, 0 to leave it alone
	
	Set $ZTrap="TRAP"
	
	// if CTR is required ..
	//AC@@@@ .. AND NOT (the table already exists AND the table is not temporary)
	//          (possibly something for the DLL)
	If ctr {
	
		// copy the recently-written subroutine lines from linearry
		Kill lines Set lines=0
		For l=%isqliol2+1:1:oline2 {
			Set lines($Increment(lines))=linearry(l)
		}
		
		// write an INT routine from the lines
		Set rt=##class(%XSQL.Compile).TempRtName("ISQL")
		Set ret=$$BuildIntRt^%apiISQL2(rt,.lines)
		If ret'="" {
			Write "Error building INT routine ",rt,": ",ret,!
			;ZWrite  W !
			ZT "BINT"
		}
	
		// any temporary table should already have been purged at this point
		
		// execute the routine to perform the SQL action
		Set SQLCODE=$$RunCTR($$$SystemSuperUser, rt)
		If $Get(SQLCODE)<0 {
			Write !,"CTR: error returned by ",rt," - SQLCODE=",SQLCODE,!
			Quit  //AC@@@@ need to signal error to %qarmac in some way      
		}
		
		// prepare each table
		For t=1:1:$ListLength(tablelist) {
			Do PrepTempTable(
				##class(%ISQL.SPContext).TempSchema(),
				$List(tablelist,t)
				)
		}
		
		// if the runtime code is to be deleted ..
		If delrtc {
			
			// remove all the recently-written lines from linearry
			For l=%isqliol+1:1:oline {Kill linearry(l)}
			Set oline=%isqliol
			For l=%isqliol2+1:1:oline2 {Kill linearry(l)}
			Set oline2=%isqliol2
		}
	}
      
	Quit
  
TRAP
	Write !!,"SPLine TRAP: $ZE=",$ZE,!!
	ZQuit  ; - inelegant, but best we can do for now
}
 
 
 // extract COS-context-SQL code from what was generated by the PREVIOUS line and write
 // code to assign the resulting expression to the given destination variable
 //
 // note: IRISISQL.DLL generates code which causes this procedure to be invoked at compile-time
 //
SPLineCCS(destvar) [linearry, oline, oline2, SQLCODE] PUBLIC {
 
	Set $ZTrap="TRAP"
 
	// find the stored procedure call code in the recently-written subroutine lines from linearry
	Set curl=%isqliol2+1
	Set mark="""%ISQL.Transformer"",""SQLExpression"","
	Kill spcallline
	For curl=curl:1:oline2 {
		If linearry(curl)[mark {
			Set spcallline=linearry(curl)
			Quit
		}
	}
	If '$Data(spcallline) {
		Do Log^%apiISQL("Internal error: no SP call code line found")
		Set genline="**error" // force INT compilation failure
	}
	Else {		
		Set genline=$Piece(spcallline,mark,2,$Length(spcallline,mark))
		Set genline=" Set "_destvar_"="_$Extract(genline,1,*-1)
	}	
		
	// remove and reset the already-written code again
	For lineno=%isqliol+1:1:oline {
		Kill linearry(lineno)
	}
	Set oline=%isqliol
	For lineno=%isqliol2+1:1:oline2 {
		Kill linearry(lineno)
	}
	Set oline2=%isqliol2
	
	// write new code
	Set linearry($i(oline))=genline
	Quit
  
TRAP
	Write !!,"SPLineCCS TRAP: $ZE=",$ZE,!!
	ZQuit  ; - inelegant, but best we can do for now
}
 
 
 // finalise the stored procedure
 //
 // note: IRISISQL.DLL generates code which causes this function to be invoked at compile-time
 //
 // NOT A PROCEDURE
SPFinal() PUBLIC
	
	New i
	
	// execute compilation finalisation code
	If $Get(%isqlctcu) {
		For i=1:1:%isqlctcu {
			Xecute %isqlctcu(i)
		}
	}
 
	Quit
 
 
 //AC@@@@ runtime temporary tables for the job should be purged whenever the *first* ISQL
 //       procedure is called (i.e. %isqlsomethingorother is not defined - or some class
 //       object)
	
		
 
 // not a procedure
 // runs the given routine under the given SQL login name
RunCTR(msql, rt) PUBLIC
	#; DPV2198*** Can't change username anymore
	New %msql,SQLCODE
	Set %msql=msql
	Kill SQLCODE	
	D ^@rt	
	Quit $G(SQLCODE)
 
 
 // log a message to %xsqllogging
Log(message) PUBLIC {
	Do ##class(%XSQL.Reporting).Log(message)
}
 
 
 // prepare a table for use as a multi-homed temporary table
PrepTempTable(schema,table) PUBLIC {
 
	Set classschema=$Case($ZCVT(schema,"U"),"SQLUSER":"USER",:schema)
	Set classname=classschema_"."_table
	
	Set cls=##class(%Dictionary.ClassDefinition).%OpenId(classname)
	Set rel=cls.Storages
	If rel.Count()'=1 {ZTrap}
	Set stg=rel.GetAt(1)
	Set stg.DataLocation=stg.DataLocation_"(%isqltableid)"
	Set stg.IdLocation=stg.IdLocation_"(%isqltableid)"
	Set stg.IndexLocation=stg.IndexLocation_"(%isqltableid)"
	Set stg.StreamLocation=stg.StreamLocation_"(%isqltableid)"
	Do stg.%Save()
	
	Set (cls,rel,stg)=$$$NULLOREF
	
	Do $system.OBJ.Compile(classname)
}
 
 
 
 // clear down a table
ClearTempTable(schema,table) PUBLIC {
	Set classschema=$Case($ZCVT(schema,"U"),"SQLUSER":"USER",:schema)
	Set classname=classschema_"."_table
	
	Set cls=##class(%Dictionary.ClassDefinition).%OpenId(classname)
	If cls {
		Set rel=cls.Storages
		If rel.Count()'=1 {ZTrap}
		Set stg=rel.GetAt(1)
 
		Kill @(stg.DataLocation)
		Kill @(stg.IdLocation)
		Kill @(stg.IndexLocation)
		Kill @(stg.StreamLocation)
	}
}
 
 
 
 // return the ISQL equivalent of a CSQL error code (SQLCODE)
SQLCODEToISQL(sqlcode) PUBLIC {
	Quit $Case(sqlcode,-30:-206,:-999) // -999 is ISQL code "not implemented"
}
 
 
 
 // return the CSQL equivalent (SQLCODE) of an ISQL error code
ISQLToSQLCODE(isqlcode) PUBLIC {
	Quit $Case(sqlcode,-206:-30,:-460) // -460 is CSQL code "general error"
}
 
 
 // extract method name from given source stream - if none, return ""
 // (from the current position)
 // either way the stream position is not well defined on exit
ExtractMethodName(srcstream) PRIVATE {
	
	// set up lexer
	Set lexer=##class(%ISQL.SimpleStreamLexer).%New(srcstream)
	
	// see if first token is "CREATE"
	Set token=lexer.GetAndCrossCurrentToken()
	If $ZCVT(token,"U")'="CREATE" {Quit ""}
	
	// see if second token is "PROCEDURE"
	Set token=lexer.GetAndCrossCurrentToken()
	If $ZCVT(token,"U")'="PROCEDURE" {Quit ""}
	
	// get and return procedure (method) name
	Quit lexer.GetAndCrossCurrentToken()
}
---
 
 



