^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpre^MAC^^^0
%qaqpre	// more pre-optimizer optimizations
	;; COMPONENTS :: SQL/PreOptimizer
	#;
#INCLUDE %msql
#IF 0   ;-------------------------------------------------------------
	;
	; Description:   Pre-Optimizer Analysis
	; Author:        Jim Finnerty
	; Date Started:  10/08/2003
	;
	;  AK850   (11/30/2020) - Implement lateral join
	;  AK1036  (01/15/2021) - Apply "onerow" even when no aggregates left
	;  AK1023  (08/31/2020) - Fix EXISTS() transformations
	;  AK1022  (08/31/2020) - Subq with local shards cannot become sharded
	;  AK1005  (08/16/2019) - Enable flatten EXISTS for UPDATE/DELETE
	;  AK974   (01/25/2018) - Aviod distinct of not-exists-type outer join
	;  PVA348  (03/01/2016) - PVA348 - Support Lateral references in JSON_TABLE through optimizer
	;  PVA342  (12/15/2015) - Generate ojfilters for sharding only when really needed, and fix interaction between aggregates and outer joins (for sharding) 
	;  PVA321  (05/13/2015) - Fix a performance regression with an OR of join conditions 
	;  PVA316  (02/04/2015) - Make cost based decision for or->union optimization for multi-table OR condition case
	;  PVA279  (02/12/2014) - Enhance ptres handling for longstanding defects 
	;  PVA294  (11/04/2013) - Allow %NOTOPOPT to be set system wide. 
	;  PVA292  (10/01/2013) - Fix Exists to View optimizatio to be used when it should be
	;  PVA289  (09/26/2013) - Fix: Bad plan after Or to UNION optimization 
	;  PVA284  (09/17/2013) - Fix: Union in subquery ignores second query if first contains subquery 
	;  PVA271  (02/08/2013) - Fix: <UNDEFINED> error - intricate "Where" clause including "UNION" in the "EXISTS" query
	;  PVA270  (12/18/2012) - incorrect query return for SELECT ... INTO local array 
	;  PVA265  (10/09/2012) - rare join situation produces wrong answer 
	;  PVA264  (10/09/2012) - Fix <UNDEFINED> error compiling UPDATE, when target table is superfluous if it were a query 
	;  PVA254  (03/02/2012) - Fix inner join removal case of "remove unnecessary streams" optimization
	;  PVA250  (12/22/2011) - Fix re-factoring of removeUnnecessaryStreams 
	;  PVA247  (12/07/2011) - Fix 'remove unnecessary table' optimization 
	;  PVA245  (10/19/2011) - Fix <FRAMESTACK> caused by UNION->OR optimization 
	;  AK825   (08/31/2011) - Correct OR NULL logic for NOT EXISTS SVSO
	;  PVA242  (07/28/2011) - Support a hint (%noindex) to not use indexes to satisfy the indicated condition. 
	;  PVA213  (07/09/2011) - A new hint %ALLINDEX is provided to request that 'all indexes' be used for the first table in the join order. 
	;  PVA231  (11/30/2010) - Implement view.%id feature 
	;  PVA228  (09/01/2010) - Fix 'remove unneeded tables' optimization to work with %inorder 
	;  JLF414  (08/23/2010) - Handle special case of ORDER BY factor-OR, %STARTSWITH NULL
	;  JLF407  (08/16/2010) - Restore mt("o",*) assignment location
	;  PVA221  (04/21/2020) - PVA221 - A subquery condition on a subquery containing OR of arrow conditions (or equivalent) might return wrong answer 
	;  JLF361  (03/29/2010) - Inhibit flattening when the pqb join order is constrained
	;  JLF339  (01/15/2010) - Support cloning of collection references
	;  PVA209  (12/01/2009) - Rationalize interaction between hints. 
	;  PVA205  (11/03/2009) - Support %NOUNIONOROPT query hint 
	;  JLF301  (10/04/2009) - Test and clear viewSpConds(joinLog) in removeUnnecessaryStreams 
	;  AK727   (10/03/2009) - EXTQGEN: Disable OR2UNION optimization
	;  JLF274  (09/02/2009) - Extend remove-stream optimization for lossless inner joins and dup-sensitive query blocks
	;  JLF273  (09/01/2009) - Move HAVING clause to WHERE clause when GROUP BY is removed, and no aggregation
	;  JLF266  (08/18/2009) - Perform join analysis in DISTINCT optimization
	;  PVA195  (07/28/2009) - Fix some TOP issues for subquery optimizations 
	;  PVA192  (06/30/2009) - Inhibit 'removal of unnecessary distinct' in cases likely to make performance worse 
	;  PVA191  (06/30/2009) - Fix : a query with EXISTS fails with <UNDEFINED>ddname+23^%qaqpqo1 *mts(,,"MAP",) 
	;  PVA183  (05/26/2009) - Pre-optimizer support for TOP...ORDER BY in subqueries 
	;  JLF245  (03/22/2009) - Make calls to testSvso consistent with each other, and block correlated expressions
	;  JLF238  (02/03/2009) - Ensure that the list passed to indexed^%qaqpre3 contains only fields
	;  DPV3231 (08/05/2008) - Use process private global for ptln, ptrel
	;  DPV3131 (03/25/2008) - New pqbExpr, andList, joinOp, lj, lg, lv, sqbExpr
	;  JLF204  (03/02/2008) - Added MAXCHAR operator
	;  JLF166  (10/09/2007) - Checked that ALL correlated expressions are accounted for
	;  JLF180  (09/06/2007) - Check for FROM clause correlations in subquery transformations
	;  PVA147  (08/27/2007) - A query with an unnecessary DISTINCT and a subquery might return duplicates
	;  JLF171  (07/30/2007) - Enable subquery to view transform for correlated aggregate expressions
	;  PVA140  (06/13/2007) - Improve JLF167 to do one type of factoring earlier (as originally done)
	;  JLF167  (05/05/2007) - Moved factorCommonAnds into propagatePreds loop
	;  JLF158  (04/10/2007) - Changed subquery flattening heuristic - changed max streams to 10 from 5
	;  JLF154  (03/02/2007) - Enable subquery flattening when there are views in the containing query block
	;  JLF153  (03/02/2005) - Restore SVSO optimizations disabled by PVA099
	;  DPV2862 (02/22/2007) - New some variables that were leaking
	;                         SQL Fix ProdLog 55764:  Local variables remain after compiling
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  JLF132  (11/16/2006) - Killed mt("w",),$$$mtHaving(),$$$mtStreamlessConds() when a view stream is determined to be unnecessary
	;  PVA099  (09/14/2006) - Extend PVA087 to views on the right hand side of a left join
	;  JLF122  (09/05/2006) - Suppress distinct opt on UNION legs when outputs are not functionally determined by distincting exprs.
	;  JLF120  (09/12/2006) - Fixed $$$mtP(m) piece 4 maintenance for SVSO
	;  JLF018  (09/11/2006) - Fixed piece 3 maintenance for factor-OR optimization
	;  JLF112  (08/10/2006) - Restore 'logs' after existsToView and flattenExists
	;  JLF116  (07/26/2006) - Make addDistinctBy return a $list in the streamed view case
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  PVA092  (06/24/2006) - Modify outer join data structure to avoid subscript size limit; assorted other outer join bugs.
	;  PVA091  (06/09/2006) - Fix maintenance of ptrel in pre-optimizer query transforms
	;  JLF111  (06/09/2006) - Enable SVSO when correlating predicate is under an OR
	;  PVA087  (02/01/2006) - Extended Outer Join Support: Any ON clause for LEFT JOIN from base tables to a base table.
	;  JLF086  (02/28/2006) - Disable merge flattening (null condition on expression doesn't work correctly)
	;  JLF083  (02/23/2006) - Restrict SVSO to fields in certain cases, to detect collation at code gen time
	;  DPV2595 (02/22/2006) - SQL Fix: New some variables
	;  JLF080  (02/14/2006) - Do HAVING clause analysis after flds/lflds
	;  JLF069  (11/16/2005) - Move non-ANSI HAVING pred to WHERE clause
	;  DPV2546 (11/08/2005) - Implement new MVR collation function.  Change collation implementations to use $zu(28)	;  JLF068  (10/13/2005) - Initialize corr state variables even if 'corrToPqb
	;  JLF003  (10/06/2005) - Temporarily disable flattening optimizations for DML statements
	;  JLF062  (09/25/2005) - Treat the literal in "<literal> IN (SELECT ... )" as correlated to the parent query block 
	;  DPV2500 (08/25/2005) - Fix use of string literal 'NVL'
	;                         SQL Fix ProdLog 45345:  <SUBSCRIPT>IsNullable+2^%qaqpre *$$$mtV("")  error if query/classmethod contains NVL
	;  DPV2473 (07/29/2005) - New some variables
	;  JLF035  (05/25/2005) - IsNullable - incomplete with respect to v entries - simplify
	;  JLF040  (05/25/2005) - Fix bugs related to JLF002
	;  
	;  JLF001  (01/08/2003) - Remove redundant conjuncts
	;  JLF002  (01/09/2003) - Factor common ANDs from top-level ORs
	;  JLF003  (10/08/2003) - EXISTS subquery flattening and EXISTS subquery to view transformations
	;  JLF004  (10/08/2003) - Materialized Views
	;  JLF005  (01/12/2004) - Set-Valued Subquery Optimiztion (including NOT EXISTS optimizations)
	;  JLF006  (          ) - Semi-Join - join to EXISTS subquery transformation
	;  JLF007  (01/01/2004) - Create mts "AGG" node for aggregate optimization             
	;  JLF008  (02/01/2004) - Simplify HAVING clause
	;  JLF009  (02/01/2004) - Merge equivalent aggregates in query block m
	;  JLF010  (03/01/2004) - Simplify compile-time constant expressions
	;  JLF011  (          ) - 
	;  JLF012  (04/01/2004) - SQL/XML
	;  JLF013  (04/27/2004) - DISTINCT + left outer join optimization  (see i^redundantOJ)
	;  JLF014  (		  ) - 
	;  JLF015  (05/01/2004) - %ANYOF, =>, and collection indexes
	;  JLF016  (07/27/2004) - Row-Level Security
	;  JLF017  (07/31/2004) - SAVEPOINTs
	;  JLF018  (08/04/2004) - Factor out ORDER BY predicate from top-level OR
	;          (02/07/2005) - Handle null correlation, prodlog 41019
	;  
	;-------------------------------------------------------------
#ENDIF	
#; PVAXXX: create a new standard pattern when both positive and negative hints exist including systemwide. As of this change, only %PARALLEL/%NOPARALLEL implement this
#;         For caller, if a behavior is ON by default, check only for the negative hint; if off by default, check only for the postive hint.
#;         It is never necessary to check for both, and this code does not need change when default changes.
#;         when default changes, you only change caller's of hint() to check for the hint opposite the default. 
hint(hintString,m=0) // PVA270: default second argument for easier test of system level hints
	if (hintString = "%PARALLEL") 
	{  
	   #;HSU301 chagne (A) || (B && ('C)) to 
	   #;              (A || B) && ('C)
 	   quit:($g(mt("hint",m,"%PARALLEL"))|| $g(^%SYS("HINT","%PARALLEL")))&&('$g(mt("hint",m,"%NOPARALLEL"))) 1
	   quit 0
	}
	if (hintString = "%NOPARALLEL") 
	{  quit:$g(mt("hint",m,"%NOPARALLEL"))||($g(^%SYS("HINT","%NOPARALLEL")) && '$g(mt("hint",m,"%PARALLEL"))) 1
	   quit 0
	}
	if (hintString = "%IGNOREINDICES") QUIT $s(""'=$g(mt("hint",m,"%IGNOREINDICES")):mt("hint",m,"%IGNOREINDICES"),1:"")
	if (hintString = "%IGNOREINDEX") QUIT $s(""'=$g(mt("hint",m,"%IGNOREINDEX")):mt("hint",m,"%IGNOREINDEX"),1:"")
	if (hintString = "%NOFIXEDSTATS") QUIT $s(""'=$g(mt("hint","%NOFIXEDSTATS")):mt("hint","%NOFIXEDSTATS"),1:"")
	if (hintString = "%FLATTEN") 				quit $g(mt("hint",m,"%FLATTEN")) || $g(^%SYS("HINT","%FLATTEN"))
	if (hintString = "%NOFLATTEN")				quit $g(mt("hint",m,"%NOFLATTEN")) || $g(^%SYS("HINT","%NOFLATTEN"))
	if (hintString = "%MERGE")					quit $g(mt("hint",m,"%MERGE")) || $g(^%SYS("HINT","%MERGE"))
	if (hintString = "%NOMERGE")				quit $g(mt("hint",m,"%NOMERGE")) || $g(^%SYS("HINT","%NOMERGE"))
	if (hintString = "%NOSVSO")					quit $g(mt("hint",m,"%NOSVSO")) || $g(^%SYS("HINT","%NOSVSO"))
	if (hintString = "%SVSO")					quit $g(mt("hint",m,"%SVSO")) || $g(^%SYS("HINT","%SVSO"))
	if (hintString = "%NOUNIONOROPT")			quit $g(mt("hint",m,"%NOUNIONOROPT")) || $g(^%SYS("HINT","%NOUNIONOROPT")) // PVA205
	if (hintString = "%NOSAVEPOINTS")			quit $g(^%SYS("HINT","%NOSAVEPOINTS"))
	if (hintString = "%NOROWLEVELSECURITY")		quit $g(^%SYS("HINT","%NOROWLEVELSECURITY"))
	if (hintString = "%NOFACTORORDERBYOR")		quit $g(mt("hint",m,"%NOFACTORORDERBYOR")) || $g(^%SYS("HINT","%NOFACTORORDERBYOR"))	
	if (hintString = "%NOFACTORANDFROMOR")		quit $g(mt("hint",m,"%NOFACTORANDFROMOR")) || $g(^%SYS("HINT","%NOFACTORANDFROMOR"))	
	if (hintString = "%NOMERGEEQUIVAGG")		quit $g(^%SYS("HINT","%NOMERGEEQUIVAGG"))
	if (hintString = "%USEORDERBYINDEX")		quit (m=1 && $g(mt("hint",m,"%USEORDERBYINDEX"))) || $g(^%SYS("HINT","%USEORDERBYINDEX"))
	if (hintString = "%PATTERNEXPAND")			quit $g(mt("hint",m,"%PATTERNEXPAND")) || $g(^%SYS("HINT","%PATTERNEXPAND"))
	if (hintString = "%NOTOPOPT")               quit $g(mt("hint",m,"%NOTOPOPT")) || $g(^%SYS("HINT","%NOTOPOPT"))  // PVA294
	if (hintString = "%ALLINDEX")			    quit $g(mt("hint",m,"%ALLINDEX")) || $g(^%SYS("HINT","%ALLINDEX"))
	if (hintString = "%NOREDUCE")			    quit $g(mt("hint",m,"%NOREDUCE")) // PVA289
	if (hintString = "%NOBSL")			    	quit $g(mt("hint",m,"%NOBSL")) || $g(^%SYS("HINT","%NOBSL")) // IBA168
	
    quit $g(mt("hint",m,hintString))=1		// Handle cases such as %INORDER and %STARTTABLE that have no system-wide settings
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
ConvertCountReqField() [mt, m] public {
	#; Rewrite all COUNT(f) aggregations, where f is a field without any nulls, to
	#; COUNT(*) for for all subqueries, m, recorded in $$$mtPActiveQbs.
	#; Updates the parse tree mt("v").
	#;
	#; Even if f is a required field, it may still contain nulls in a query if it
	#; is the right field of a LEFT (outer) JOIN. We use $$ddreq^%qaqpnl, which
	#; checks nulstr and identifies streams on the right side of an outer join, to
	#; determine if f is required.
	#;
	#; Does not apply when DISTINCT is used in this aggregation.
	new m
	for m = 1:1:$$$mtPNumQbs {
		#; list of aggregates
		set ags = $$$mtPAggList($$$mtP(m))
		
		#; log any changes for each m
		set found = 0
		#; loop over each aggregate in ags
		for agi = ($length(ags, ",") - 1):-1:1 {
			#; aggregate index in mt("v")
			set val = $piece(ags, ",", agi)
			continue:($extract($$$mtV(val), 1, 8) '= "a^count^")
			#; skip if DISTINCT
			continue:($piece($$$mtV(val), "^", 7) '= "")
			#; value number that COUNT is applied to
			set val5 = $piece($$$mtV(val), "^", 5)
			#; skip COUNT(*) case
			continue:(val5 = "")
			#; skip if the argument of COUNT is not a field
			continue:($piece($$$mtV(val5), "^", 1) '= "f")
			
			#; check that the field does not contain nulls
			if $$ddreq^%qaqpnl(val5) {
				#; rewrite COUNT(f) in mt("v") to be COUNT(*)
				set $piece($$$mtV(val), "^", 5) = ""
				set:'found found = 1
				#; log the optimization
				do logopt^%qaqpagg("ConvertCountReqField", $lb(val))
			}
		}
		
		if found {
			#; update field dependencies in mt
			do:$$$mtPQbIsActive(m) flds^%qaqpnl
		}
	}
	return
}
.
stag() [mt, m] public {
	#; Rewrite all streamless aggregations as functions of COUNT(*) for all
	#; subqueries, m, recorded in $$$mtPActiveQbs. Updates the parse tree and the
	#; list of aggregates in $$$mtP(m).
	#; 
	#; rewrite as follows:				
	#; Streamless Aggregations			GROUP BY		No Grouping
	#; -----------------------------------------------------------------------
	#; COUNT(s)							IFNULL(s,0,cc)	IFNULL(s,0,cc)
	#; SUM(s)							s*cc			CASE(cc=0:NULL,1:s*cc)
	#; MIN(s),MAX(s),SUM(DISTINCT s)	s				CASE(cc=0:NULL,1:s)
	#; COUNT(DISTINCT s)				IFNULL(s,0,1)	IFNULL(s,0,cc'=0)
	
	new m
	#; rewrite streamless aggregations for each subquery
	for m = 1:1:$$$mtPNumQbs {
		#; list of group-by or select-distinct fields
		set grp = $get($$$mtGroupDistinctList( m))
		#; list of aggregates
		set ags = $$$mtPAggList($$$mtP(m))
		
		#; loop over each aggregate in ags
		for agi = ($length(ags, ",") - 1):-1:1 {
			#; aggregate index in mt("v")
			set agg = $piece(ags, ",", agi)
			#; actual aggregate string
			set agv = $$$mtV(agg)
.
			#; check if the parameter of the aggregate is streamless
			set aggparam = $$$mtVAggOperand(agv)
			#; skip count(*) case
			continue:aggparam=""
			#; skip field (i.e. stream-full) arguments unless we group on all fields used in the aggregation
			#; if aggparam is a virtual field, need to check that the thing it points to is streamless 
			#; (but also watch out for unions of streamless fields/expressions)
			continue:$$dependsOnUnion^%qaqpre(aggparam)
			kill vals
			do valDependencies^%qaqpre(aggparam, .vals)
			set streamless = 0
			set val = ""
			for {
				set val = $order(vals(val))
				QUIT:(val = "")
				// check that the vals that aggparam depends on are streamless
				set streamless = $$isStreamless^%qaqpag(val)
				QUIT:(streamless = 0)			
			}
			continue:('streamless && ($$remove^%qaqpag($e($$$mtVAggFields(agv),2,*),grp)'=""))
			#; skip DISTINCT BY case unless we group on the expression used in the DISTINCT BY
			continue:(($$$mtVAggDistinctList(agv) '= "") && ($$remove^%qaqpag(aggparam, $$$mtVAggDistinctList(agv)) '= "") && ($$remove^%qaqpag($$$mtVAggDistinctList(agv), grp) '= ""))
			#; check if this is an aggregate we can optimize
			continue:(" sum count max min " '[ (" "_$piece(agv, "^", 2)_" "))
			#; select distinct for aggregates ignored when used with group by, so skip if distinct list exists
			continue:($piece(agv, "^", 6) '= grp)
.
			#; remove the streamless aggreation from ags and $$$mtPActiveQbs
			set $p(ags, ",", agi, agi + 1) = $p(ags, ",", agi + 1)
			set $$$mtPAggList($$$mtP(m)) = ags
.
			if grp,$$$mtVAggFunc(agv)="count",$$$mtVAggDistinctList(agv) {
				#;  *** note: in the next 2 cases, $P(3)=grp even though s might be streamless!?
				#;  GROUP BY, COUNT(DISTINCT s) ==> IFNULL(s,0,1)
				s $$$mtV(agg)="v^IFNULL^"_$$$mtVAggFields(agv)_"^"_$$$mtVAggOperand(agv)_"^"_$$$newval("t^0",1)_"^"_$$$newval("t^1",1)_"^"
			}
			elseif grp,("max min"[$$$mtVAggFunc(agv))||(($$$mtVAggFunc(agv)="sum")&&$$$mtVAggDistinctList(agv)) {
				#;  GROUP BY, MIN(s)/MAX(s)/SUM(DISTINCT s) ==> s
				#;  copy the node, or use COALESCE if it's a field
				s $$$mtV(agg)=$s($e($$$mtV($$$mtVAggOperand(agv)))'="f":$$$mtV($$$mtVAggOperand(agv)),1:"v^COALESCE^"_$$$mtVAggFields(agv)_"^"_$$$mtVAggOperand(agv)_"^")
			}
			else {
				#; compute count(*) (cc) and update aggregate list in $$$mtPActiveQbs
				set cc = $$$newval("a^count^"_$$$mtVAggFields(agv)_"^^^"_grp_"^",1)
				set ags = ags_cc_","
				set $$$mtPAggList($$$mtP(m)) = ags
				
				if $$$mtVAggFunc(agv)="count",'$$$mtVAggDistinctList(agv) {
					#;  COUNT(s) ==> IFNULL(s,0,cc) (GROUP BY or not)
					s $$$mtV(agg)="v^IFNULL^"_$$$mtVAggFields(agv)_"^"_$$$mtVAggOperand(agv)_"^"_$$$newval("t^0",1)_"^"_cc_"^"
				}
				elseif grp,$$$mtVAggFunc(agv)="sum",'$$$mtVAggDistinctList(agv) {
					#;  GROUP BY, SUM(s) ==> s*cc
					s $$$mtV(agg)="v^*^"_$$$mtVAggFields(agv)_"^"_$$$mtVAggOperand(agv)_"^"_cc_"^"
				}
				elseif 'grp,$$$mtVAggFunc(agv)="count",$$$mtVAggDistinctList(agv) {
					#;  *** note: in the next 2 cases, $P(3)=grp even though s might be streamless!?
					#;  onerow, COUNT(DISTINCT s) ==> IFNULL(s,0,cc>0)  ;  cc\(cc-.1)
					s $$$mtV(agg)="v^IFNULL^,^"_$$$mtVAggOperand(agv)_"^"_$$$newval("t^0",1)_"^"_$$$newval("v^\^,^"_cc_"^"_$$$newval("v^-^,^"_cc_"^"_$$$newval("t^.1",1)_"^",1)_"^",1)_"^"
				}
				elseif 'grp,$$$mtVAggFunc(agv)="sum",'$$$mtVAggDistinctList(agv) {
					#;  onerow, SUM(s) ==> CASE(cc=0:NULL,1:s*cc)
					s $$$mtV(agg)="v^CASE^"_$$$mtVAggFields(agv)_"^"_$$$newval("l^L2V^"_$$$mtVAggFields(agv)_"^"_$$$newlog("v^=^"_$$$mtVAggFields(agv)_"^"_cc_"^"_$$$newval("t^0",1)_"^")_"^",1)_"^"_$$$newval("t^",1)_"^"_$$$newval("v^*^"_$$$mtVAggFields(agv)_"^"_$$$mtVAggOperand(agv)_"^"_cc_"^",1)_"^"
				}
				elseif 'grp,("max min"[$$$mtVAggFunc(agv))||(($$$mtVAggFunc(agv)="sum")&&$$$mtVAggDistinctList(agv)) {
					#;  onerow, MIN(s),MAX(s),SUM(DISTINCT s) ==> CASE(cc=0:NULL,1:s)
					s $$$mtV(agg)="v^CASE^"_$$$mtVAggFields(agv)_"^"_$$$newval("l^L2V^"_$$$mtVAggFields(agv)_"^"_$$$newlog("v^=^"_$$$mtVAggFields(agv)_"^"_cc_"^"_$$$newval("t^0",1)_"^")_"^",1)_"^"_$$$newval("t^",1)_"^"_$$$mtVAggOperand(agv)_"^"
				}
				else {
					#; don't update mt("v")
					continue
				}
			}
			#; update the field list in $$$mtV(agg)
			do lflds^%qaqpnl("v", agg, "do")
			#; log the optimization
			do logopt^%qaqpagg("stag", $lb(agg))
		}
	}
}
.
valDependencies(val, &leaves) [mt, call, vals] PUBLIC {
	/*
	This function returns the underlying "true" leaf val#'s that 'val' depends on in
	mt("v"). Here, "true" means that there is no dependence on virtual fields. The
	val#'s returned are leaf nodes in mt("v") because they don't point to any other
	val#.
	
	For example, val might point to an expression which is a calculated value based on
	other values/fields, or it may point to a virtual field that points to another
	field, or expression, in a view. If val depends on an expression ($p(1) = "a", "v",
	or "l"), then it is also possible that val depends on multiple val#'s. These will be
	returned too.
	
	Note that this method does not de-reference correlated fields.
	
	Inputs
	------
	val :
		A val# in mt("v", val)
	
	Outputs
	-------
	leaves : pass-by-reference
		Array of val#'s that the top-level val depends on. Has the form: vals(val#) = ""
		
	*/
	new call, vals
	set call = "valDependenciesStep^%qaqpre"
	do lvtree^%qaqpnl("v", val)
	merge leaves = vals
	
	RETURN
}
.
valDependenciesStep
	/*
	Processing step for valDependencies^%qaqpre as we move through mt("v") using
	lvtree^%qapnl. This step adds the true (non-virtual) leaf fields/values that val
	depends on. Called from valDependencies^%qaqpre.
	
	Inputs:
	-------
	val: (public)
		val#
	v: string (public)
		mt("v", val)
	ev: string (public)
		$p(val, "^", 1)
	
	Outputs:
	--------
	vals: array (public)
		Array of val#'s that the top-level val depends on, updated as we
		move down the parse tree. Has the form: vals(val) = ""
	*/
	
	// check for virtual fields
	if ev = "f" {
		// get the val that this virtual field points to
		while $data($$$mtVirf(+$$$mtVFieldLabelOrIFN(v))) {
			// check if val is a %VID (i.e. it does not point to anything else)
			QUIT:($list($$$mtVirf(+$$$mtVFieldLabelOrIFN(v)), 2) = "")
			set val = $list($$$mtVirf(+$$$mtVFieldLabelOrIFN(v)), 2)
			set v = $$$mtV(val)
			set ev = $$$mtVType(v)
		}
	}
	// Once we have a leaf val#, add it to the list of vals if necessary
	if "fxtqn" [ ev {
		set vals(val) = ""
	}
	
	GOTO lvarg^%qaqpnl
	RETURN
.
.
dependsOnUnion(val) [mt, call, unionTopQbs, dependsOnUnion] PUBLIC {
	/*
	Determine if 'val' is at least partially constructed using a union.
	
	Inputs
	------
	val :
		A val# in mt("v", val)
		
	Outputs
	-------
	dependsOnUnion: boolean
	*/
	new call, dependsOnUnion, unionTopQbs
	
	set dependsOnUnion = 0
	// create array of query blocks that are the tops of union levels
	set m = ""
	for {
		set m = $order($$$mtUnionTopQb(m), 1, unionTopQb)
		QUIT:(m = "")
		
		set unionTopQbs(unionTopQb) = ""
	}
	set call = "dependsOnUnionCheck^%qaqpre"
	do lvtree^%qaqpnl("v", val)
	RETURN dependsOnUnion
}
.
dependsOnUnionCheck
	/*
	Processing step for dependsOnUnion^%qaqpre as we move through mt("v") using
	lvtree^%qapnl. This step in the tree checks if the current val number has a stream
	that is generated from a union. If it does, it sets dependsOnUnion = 1 and quits the
	search through the tree. Called from dependsOnUnion^%qaqpre.
	
	Inputs:
	-------
	val: (public)
		val#
	v: string (public)
		mt("v", val)
	ev: string (public)
		$p(val, "^", 1)
	unionTopQbs: array (public)
		Array of query block numbers that are the tops of union levels, from mt("untop") 
	
	Outputs:
	--------
	dependsOnUnion: boolean (public var)
		True if this val comes from a stream generated by a union. 
	*/
	
	while (ev = "f") && $data($$$mtVirf(+$$$mtVFieldLabelOrIFN(v))) {
		// check if this stream comes from a union
		if $data(unionTopQbs($get($$$mtRVirtual($$$mtVFieldQbOrStream(v)), 0))) {
			set dependsOnUnion = 1
			RETURN
		}
		
		// skip if val is a %VID (virtual ID)
		QUIT:($list($$$mtVirf(+$$$mtVFieldLabelOrIFN(v)), 2) = "")
		// if no union, get the val that the virtual field points to
		set val = $list($$$mtVirf(+$$$mtVFieldLabelOrIFN(v)), 2)
		set v = $$$mtV(val)
		set ev = $$$mtVType(v)
	}
	
	GOTO lvarg^%qaqpnl
	RETURN
.
analyzeQueryBlocks
	new m, mTopo, logs, log, lgi, vals, val, vli, call
.
	#; Convert streamless aggregations to functions of count(*) in the parse tree
	do stag()
.
	#; Optimize subqueries and perform analysis of DISTINCT operations
	d distinctOpt()
  
  	#; Factor Common ANDs from top-level ORs 		- PVA140: Add back the non OBY case here.
  	f m=1:1:$$$mtPNumQbs continue:($$isLinked^%qaqpnl(m))  i $$$mtPQbIsActive(m) { s logs=$g($$$mtWhere(m)) f lgi=$l(logs,"^")-1:-1:1 s log=$p(logs,"^",lgi) d factorCommonAnds(m,log,0) }
    #; PVA342: Don't prevent for sharded query blocks because we can't know this yet and there is no reason this
    #;         should interfere with regeneration. 
	if '$$hint("%NOMERGEEQUIVAGG",0) f m=1:1:$$$mtPNumQbs continue:$$isLinked^%qaqpnl(m)  i $$$mtPQbIsActive(m) { do mergeEquivAggs^%qaqpre2(m) }
 
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
unionOrOpt()
	n mTopo,nQbs,mTopo2,m2
	for mTopo=maxm:-1:1 
	{	s m=mt("qbo",mTopo) 				; In bottom-up topological order
		continue:'$$$mtPQbIsActive(m)
		continue:$$isLinked^%qaqpnl(m)
		continue:$$isSharded^%qaqpnl(m) // Let it happen on the shard server, else many more sharded operations
		continue:((m=1)&&(",SEL,DEC,INS,"'[$g($$$mtStatementType)))		
		s nQbs = maxm
		#; NOTE: it is actually probably ok to do UnionToOr for sharded query blocks
		if $$tryOrToUnion(m) // NOTE: this gets allowed for pqb of shardedTop; We'll have to see how this works...
		    #; If this no good for pqb of shardedTOP we'll probably have to prevent this if any sharding going on
		    #; in any subq (any depth) of m.
		{	d refreshSubtree(m)
			f mTopo2=mTopo+1:1:maxm  s m2=mt("qbo",mTopo2) continue:m2<=nQbs  d:$$tryUnionToOr(m2) refreshSubtree(m2)
		}
		d:$$tryUnionToOr(m) refreshSubtree(m)
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
refreshSubtree(m)
	d calcQBOrder^%qaqpnl(m),distinctOpt(m)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tryUnionToOr(m)
	n lw,ptlg,foundEligible,sq,ssq s foundEligible = 0,sq=+$$$mtP(m)
	if $d($$$mtUnionTopQb(m)),sq>0,m=$$$mtUnionTopQb(m) // PVA245: check for "untop" rather than "union"
	{	
		#; Convert EXISTS (SELECT 1 FROM (<union legs>)) to EXISTS <union leg> OR EXISTS <union leg>
		s ssq=+$$$mtP(sq)
		if ssq>0,$$numstr^%qaqpnl(sq)=1,$g(mt("dups",sq))'=$$$SQLELIMINATEDUPS
			,$$$mtCorrParentQb(m)=ssq // PVA245: just use mt("corr"), no need for whole function
			,$g($$$mtDSNLinkedTable(ssq))=""  ;  not an external query  ;  AK727
		{	if $$$mtOutput(sq)="^",'$d($$$mtWhere(sq)),'$d($$$mtHaving(sq)),'$d($$$mtStreamlessConds(sq)),'$d($$$mtUnionTopQb(sq)) //PVA284: check "untop"
			{	for lw=1:1:$l($g($$$mtWhere(ssq)),"^")-1
				{	s ptlg = $$$mtL($p($$$mtWhere(ssq),"^",lw))
					if ($p(ptlg,"^",2)="FOR SOME"&&(sq=$p($$$mtV($p(ptlg,"^",4)),"^",2))) { s foundEligible = 1 quit }
				}
			}
			if foundEligible { s $$$mtPQbIsActive(sq) = "0" do UnionToOr(m,ssq,lw) }
		}
		
		#; Convert EXISTS (<union legs>) to EXISTS <union leg> OR EXISTS <union leg>
		#;
		if 'foundEligible
			,$$$mtCorrParentQb(m)=sq // PVA245: just use mt("corr"), no need for whole function
			,$g($$$mtDSNLinkedTable(sq))=""  ;  not an external query  ;  AK727
		{	for lw=1:1:$l($g($$$mtWhere(sq)),"^")-1
			{	s ptlg = $$$mtL($p($$$mtWhere(sq),"^",lw))
				if ($p(ptlg,"^",2)="FOR SOME"&&(m=$p($$$mtV($p(ptlg,"^",4)),"^",2))) { s foundEligible = 1 quit }
			}
			do:foundEligible UnionToOr(m,sq,lw)
		}
	}
	QUIT foundEligible
.
ifnsFromVal(val) [mt] PUBLIC {
	/*
	Return the internal field number (IFN) from a val node of mt("v") when val
	corresponds to a field. Handles the cases when val is field from a view
	stream, and may actually depend on mutliple fields from another stream. In
	that case, we return all the IFNs of the original fields.
	
	Inputs
	------
	val :
		A node in mt("v")
	
	Outputs
	-------
	ifns : "," delimited string (trailing ",")
		All IFNs on which val depends (possible with view streams). If val does
		not correspond to a field, returns the empty string ""
		
	*/
.
	set ifns = ""
	set val = $$realf^%qaqcasl(val)
	set ev = $$$mtVType($$$mtV(val))
.
	if ev = "f" {
		set ifn = $piece($$$mtV(val),"^",3)
		// need to recheck if val is virtual field when collation is used
		// becuase realf^%qaqcasl does not work with collated fields
		if $data($$$mtVirf(+ifn)) {
			set val = $listget($$$mtVirf(+ifn), 2)
			RETURN $$ifnsFromVal(val)
		}
		set ifns = ifns_ifn_","
	} elseif (ev = "v") || (ev = "a") || (ev = "l") {
		set fields = $piece($$$mtV(val), "^", 3)
		for i=2:1:($length(fields, ",") - 1) {
			set ifns = ifns_$$ifnsFromVal($piece(fields, ",", i))
		}  
	}
.
	RETURN ifns
}
.
fieldsHaveColumnarMap(vals) [mt] PUBLIC {
	/*
	Check if a ","-delimited string of fields has a columnar index map ("CI")
	or columnar data map ("CD") defined on it.
	
	If one of vals represents a field from a view stream or a virtual field,
	then we check for columnar maps on the fields that val depends on.
	
	Inputs
	------
	vals: string
		","-delimited string (leading and trailing ",") of nodes in mt("v")
		corresponding to fields.
	
	Outputs
	-------
	: boolean
		1 if this field has a columnar map, 0 if it does not.
	*/
.
	for j=2:1:($length(vals, ",") - 1) {
		set val = $piece(vals, ",", j)
		// skip if val is not a field
		CONTINUE:($piece($$$mtV(val), "^", 1) '= "f")
.
		set ifns = $$ifnsFromVal(val)
		for i=1:1:($length(ifns, ",") - 1) {
			set ifn = $piece(ifns, ",", i)
			set irn = $$$smdGetIrnFromIfn(+ifn)
			// list of ifn's with columnar maps for a given irn
			set columnarifns = $get($$$smd(1, irn, 14))
			RETURN:$listfind(columnarifns, ifn) 1
		}
	}
.
	RETURN 0
}
.
numSubqueryCalls(subqVal) [mt, ptv] PUBLIC {
	/*
	Estimate the number of times the subquery  (represented by the node
	$$$mtV(subqVal)) is called by using the selectivty of the correlated
	fields.
	
	Inputs
	------
	subqVal: int
		val subscript for the subquery block in mt("v")
	
	Outputs
	-------
	: float
		Estimated number of times the subquery is called
	*/
.
	// correlated fields within the subquery
	set corrs = $piece($$$mtV(subqVal), "^", 3)
	set lenCorrs = $length(corrs, ",")
	// if there are no correlated fields, this subquery will be called only once.
	if lenCorrs > 2 {
		// estimate the number fo the time the subquery is called by using
		// the selectivity of the correlated fields
		set totalSel = 1
		for j=2:1:(lenCorrs - 1) {
			set val = $piece(corrs, ",", j)
			set totalSel = totalSel * $piece(ptv(val), "^", $$$PTVCONEQLSEL)
		}
		RETURN 1 / totalSel
	}
.
	RETURN 1
}
.
tryOrToUnion(m)
	#; AK727
	QUIT:$g($$$mtDSNLinkedTable(m))'="" 0  ;  not on an external query
    #; PVA209: %INORDER and %STARTTABLE disable "or to union" optimization
 	QUIT:($$hint("%NOUNIONOROPT",m)||$g(mt("hint",m,"%INORDER"))||$g(mt("hint",m,"%STARTTABLE"))) 0 // PVA205
 	QUIT:$d($$$mtTopLimit(m)) 0
 	#; Parallel partition queries xfrms must match those of the original subquery. If the
 	#; original subquery had been OrToUnion'd, we wouldn't be seeing it as a partition, we'd be seeing
 	#; one of its legs. So it wasn't OrToUnion'd, so we shouldn't xfrm its partition. See DP-402197.
 	QUIT:$d($$$mtPartitionPredicates(m)) 0
	new lw,oropns,ptlg,lf,li,val,str,foundEligible,topOr,needDistinct,costno,costyes,cost,tempw,log
.
	#; determine if this subquery requires DISTINCT when performing the orToUnion transformation
	if $get($$$mtOutput(m)) = "^" {
		#; This is an EXISTS subquery
		set needDistinct = 0
	} elseif '$data($$$mtGroupDistinctList( m)) {
		#; subquery doesn't have GROUP BY
		set needDistinct = 1
	} elseif (mt("dups",m) = $$$SQLDONTCAREDUPS) {
		#; subquery doesn't care about duplicates
		set needDistinct = 0
	} elseif ($p($g($$$mtP(m)),"^",3) = "") {
		#; subquery has no aggregates
		set needDistinct = 0
	} else {
		set needDistinct = 1
	}
	
	QUIT:needDistinct&&$$containsView(m) 0
	#; Convert OR to UNION ALL + outer distinct.  First search for a top-level OR of EXISTS,
	#; but if we can't find such an OR, then search for a top-level multi-stream OR
	#;
	set foundEligible=0, topOr=0
	for lw=1:1:$l($g($$$mtWhere(m)),"^")-1 {
		set ptlg = $$$mtL($p($$$mtWhere(m),"^",lw))
		if $e(ptlg,1,4)="l^!^",'topOr {
			set topOr=lw,oropns=$$getOROperands(ptlg,.foundEligible)
			QUIT:foundEligible
		}
	}
	if 'foundEligible,topOr,$$numstr^%qaqpnl(m)>1 {	
		for lw=topOr:1:$l($g($$$mtWhere(m)),"^")-1 {
			set ptlg = $$$mtL($p($$$mtWhere(m),"^",lw))
			if $e(ptlg,1,4)="l^!^",$l($p(ptlg,"^",3),",")>3 {	
				set lf=$p(ptlg,"^",3)
				if $p(lf,",",2)'="" {
					set str = $p($g($$$mtV($p(lf,",",2))),"^",2)
					for li=3:1 {
						set val=$p(lf,",",li)
						QUIT:val=""
						if "f"=$$$mtVType($$$mtV(val)),str'=$p($$$mtV(val),"^",2) {
							set oropns=$$getOROperands(ptlg,.foundEligible)
							set foundEligible=1
							QUIT 
						}
					}
				}
			}
			QUIT:foundEligible
		}
	}
	if foundEligible { // PVA316: check if rewrite looks cost effective  
		new forSomeQNode, subqm, nSubqCalls
		set costno=$$quickcost^%qaqomul(m,0)
		set tempw=$$$mtWhere(m),costyes=0
	   	set ii=$p(tempw,"^",lw),mt("no-orlog")=$g(mt("no-orlog"))_$lb(ii) // PVA321
	   	for ii=1:1:$ll(oropns) {
		  	if ($$$mtLOperator($$$mtL($li(oropns,ii)))="FOR SOME") {
				// subquery node of FOR SOME
				set forSomeQNode = $$$mtLOperand1($$$mtL($li(oropns,ii)))
				// estimate the cost of calling subqueries multiple times
				set nSubqCalls = $$numSubqueryCalls(forSomeQNode)
				if nSubqCalls > 1 {
					set subqm = $piece($$$mtV(forSomeQNode), "^", 2)
					set costno = costno + ($$quickcost^%qaqomul(subqm, 0) * nSubqCalls)
				}
			}
			set $p(tempw,"^",lw)=$li(oropns,ii)
			set cost=$$quickcost^%qaqomul(m,0,tempw)
			set costyes=costyes+cost
		}
		if '$data(forSomeQNode) {
			// skip optimization if any attributes in the OR operands have columnar maps
			// as long as there are no FOR SOME subqueries present
		  	RETURN:$$fieldsHaveColumnarMap($$$mtLColVals($$$mtL($li(oropns, ii)))) 0
		}
		set:costyes>=costno foundEligible=0
	}
	do:foundEligible OrToUnion^%qaqpre3(m,0,lw,oropns,needDistinct)
	QUIT foundEligible
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
refsCollectionSubvalues(m)
	n found,li,lj,lf,log,logs,lw,val s logs=$g($$$mtWhere(m)),found=0
	for lw=1:1 
	{	s log=$p(logs,"^",lw) q:log=""
		s lf = $$$mtLColVals($$$mtL(log))
		for li=2:1 s val=$p(lf,",",li) q:val=""  i "f"=$$$mtVType($$$mtV(val)),$p($$$mtV(val),"^",3)["_%ANYOF" { s found=1 quit }
		q:found
	}
	if 'found,$d($$$mtLeftOuterJoins(m))
	{	for lj=1:1
		{	s log=$p($$$mtLeftOuterJoins(m),",",lj) q:log=""
			s lf = $$$mtLColVals($$$mtL(log))
			for li=2:1 s val=$p(lf,",",li) q:val=""  i "f"=$$$mtVType($$$mtV(val)),$p($$$mtV(val),"^",3)["_%ANYOF" { s found=1 quit }
			q:found
		}
	}
	QUIT found
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
UnionToOr(sqb,pqb,lwPqb)
	#; Query block sqb is the top level of a UNION tree whose parent has only
	#; one stream.  lwPqb is the "^" position of an EXISTS in mt("w",pqb) that
	#; contains the UNION tree, either directly or indirectly through a non-
	#; DISTINCT view that contains the UNION tree in its FROM clause.  In either
	#; case, convert the UNION tree into an OR in the parent query block.  The
	#; caller is responsible for removing the intervening view if it exists.
	#;
	QUIT:'$d($$$mtUnion(sqb))
	QUIT:$$hint("%NOUNIONOROPT",pqb) // PVA205
	new distinctGrp, grp, uli, ulist, v, val, log, ptlg, m, str, orlog, r s orlog = ""
	set distinctGrp = $$unlev^%qaqpag(sqb)
	s ptlg = $$$mtL($p($$$mtWhere(pqb),"^",lwPqb)), m = pqb
	for grp=1:1:$ll(distinctGrp) 
	{ 	set ulist = $li(distinctGrp,grp)
		for uli=$ll(ulist):-1:1  
		{	d putcomplexlog^%qaqpnl(m, "v^FOR SOME^^"_$$$newval("q^"_$li(ulist,uli),1)_"^"_$p(ptlg,"^",5,6))	
			s $p($$$mtP($li(ulist,uli)),"^",1,2) = pqb_"^"_$$$mtLOperand1($$$mtL(val))			
			if $$$mtPViewIDVal($$$mtP($li(ulist,uli)))'=""
			{	s str="" f  s str=$o($$$mtR(str)) q:str=""  quit:$g($$$mtRVirtual(str))=$li(ulist,uli)
				if str'=""
				{	k $$$mtRVirtual(str) 
					s $$$mtR(str)="0^0"
					s r="" f  s r=$o($$$mtV(r)) q:r=""  set:$p($$$mtV(r),"^",1,2)=("f^"_str) $$$mtV(r)="i^"_$$$mtV(r)
				}
				s $$$mtPViewIDVal($$$mtP($li(ulist,uli))) = ""
			}
			Set:orlog'="" val=$$$newlog("l^!^^"_val_"^"_orlog_"^") 
			s orlog = val
			s $$$mtOutput($li(ulist,uli))="^"
			s mt("dups",$li(ulist,uli)) = $$$SQLDONTCAREDUPS
			k $$$mtUnionTopQb($li(ulist,uli)),$$$mtUnionLegVals($li(ulist,uli)),$$$mtUnionTopDSN($li(ulist,uli))
		}
	}
	d addlog^%qaqpnl(orlog)
	d lflds^%qaqpnl("l",orlog,"do")
	k $$$mtUnion(sqb)
	s $$$mtV($p(ptlg,"^",4))="i^UnionToOr^"_$$$mtV($p(ptlg,"^",4))
	s $$$mtL($p($$$mtWhere(pqb),"^",lwPqb)) = "i^UnionToOr^"_ptlg
	s $p($$$mtWhere(pqb),"^",lwPqb,lwPqb+1) = $p($$$mtWhere(pqb),"^",lwPqb+1)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
isASubquery(m)
	QUIT ((m>1) && $d($$$mtCorrParentQb(m)) && (+$$$mtP(m)>0) && (+$$$mtP(m) = +$$$mtCorrParentQb(m)))
#; PVA245: eliminate isCorrelatedT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getOROperands(pptlg,foundEligible)
	n i,oropns,ptlg s oropns=""
	QUIT:$e(pptlg,1,4)'="l^!^" ""	
	for i=4:1:5
	{	s ptlg = $$$mtL($p(pptlg,"^",i))
		if $e(ptlg,1,4)="l^!^" 
		{	s oropns = oropns_$$getOROperands(ptlg,.foundEligible) }
		else
		{	s:$p(ptlg,"^",2)="FOR SOME" foundEligible = 1
			s oropns = oropns_$lb($p(pptlg,"^",i))
		}
	}
	
	QUIT oropns
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
topLevelAnd(log)
	quit:($$$mtLOperator($$$mtL(log))="&") $$topLevelAnd($$$mtLOperand1($$$mtL(log)))_$$topLevelAnd($$$mtLOperand2($$$mtL(log)))
	QUIT log_"^"
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
distinctOpt(mStart=1)
	new m,mp,lv,str,log,lgi,mTopo,changed s changed=0
.
	#; First set singletonSelect and uniqueBody, which we need to know for both the pqb and sqb
	#; during optimizations such as subquery-to-view
	#;
	for m=1:1:$$$mtPNumQbs
	{	continue:'$$$mtPQbIsActive(m)
		continue:($$isLinked^%qaqpnl(m))
		set singletonSelect(m) = $$isSingletonSelect(m)
		set uniqueBody(m) = singletonSelect(m) || $$singletonGroups(m)
	}
 
	#; Unless DISTINCT is specified, we initially assume that duplicates must be preserved.
	#; Well-formed subqueries never need to do duplicate elimination
	#; 
	for mTopo=1:1:maxm
	{	s m=mt("qbo",mTopo) 				; In top-down topological order
		continue:'$$$mtPQbIsActive(m)
		continue:($$isLinked^%qaqpnl(m))  // Worth doing for shard top since allows more view merging
		#; We can't affect the rows produced for a query with windows
		if $$windowsInSubq^%qaqpagg(m) {
			Set mt("dups",m) = $s(($d($$$mtDistinct(m)) || $d($$$mtGroupDistinctList(m)) || ($d($$$mtOutput(m)) && ($$$mtOutputDistinct($$$mtOutput(m)) = "d"))):$$$SQLELIMINATEDUPS,1:$$$SQLPRESERVEDUPS)
			continue
		}
		#; Require that either m=mStart or mStart is a parent query block of m
		if mStart>1,m'=mStart,m>1
		{	s mp=m f  s mp=+$$$mtP(mp)  q:mp<=1||(mp=mStart)
			continue:mp'=mStart
		}
		
		#; If the parent query block of m has been disabled, then m must be disabled also
		#; 
		set:((m>1) && ($$$mtPQbIsActive(+$$$mtP(m))=0)) $$$mtPActiveQbs = $e($$$mtPActiveQbs,1,m-1)_"0"_$e($$$mtPActiveQbs,m+1,*)
		if ($$$mtPQbIsActive(m))
		{	set:'$d(singletonSelect(m)) singletonSelect(m) = $$isSingletonSelect(m)
			set:'$d(uniqueBody(m)) uniqueBody(m) = singletonSelect(m) || $$singletonGroups(m)
			if ($g(mt("dups",m)) '= $$$SQLDONTCAREDUPS)
			{	
			    #; PVA147: use NODUPPRESENT for uniqueBody case			
				set mt("dups",m) = $s(uniqueBody(m):$$$SQLNODUPSPRESENT,($d($$$mtDistinct(m)) || $d($$$mtGroupDistinctList(m)) || ($d($$$mtOutput(m)) && ($$$mtOutputDistinct($$$mtOutput(m)) = "d"))):$$$SQLELIMINATEDUPS,1:$$$SQLPRESERVEDUPS)
				set:((m>1) && $d($$$mtCorrParentQb(m)) && (+$$$mtP(m)>0) && (+$$$mtP(m) = +$$$mtCorrParentQb(m))) mt("dups",m) = $$$SQLDONTCAREDUPS	// Subqueries don't need to do duplicate elimination
 
				#; Try to eliminate DISTINCT from streamed views
				#;  
				#; If m is a streamed view in mp, and mp does aggregation, then we may get the wrong
				#; aggregated values if we eliminate the DISTINCT in m.  For example, mp may not
				#; care about duplicate elimination because singletonSelect(mp).
				#; 
				set mp = $s(m=1:0,1:+$$$mtP(m))
				if ((mp>0) && ($g(mt("dups",mp)) = $$$SQLDONTCAREDUPS) && (mt("dups",m) '= $$$SQLDONTCAREDUPS) && '$$$mtPAggList($$$mtP(mp))) 
				{	set mt("dups",m) = $$$SQLDONTCAREDUPS
				}
				
				#; Within a UNION level, we only need to do one DISTINCT operation.  By clearing the
				#; DISTINCT from the other query blocks, we may be able to flatten more streamed views
				#; 
				do:($g($$$mtUnion(m))'="") markUnionLeg
			}
			
			#; If query block m either cannot produce duplicates or is not duplicate-sensitive, 
			#; then remove the DISTINCT operator, if present
			#;
			#; PVA147: kill DISTINCT also for new NODUPSPRESENT
			if (mt("dups",m) = $$$SQLDONTCAREDUPS || (mt("dups",m) = $$$SQLNODUPSPRESENT))
			{	if '$$$mtPAggList($$$mtP(m))&&'$g($$$mtOneRow(m))  ;  AK1036
				#;  PVA192: Aggregates dont' semantically
				#;  prevent this optimization. However this optimization
				#;  has minor benefit on top of aggregates, yet
				#;  impedes pushdown to WHERE clause of m.
				&& '$$hasPagination^%qaqpsq(m) && '$$badvidref^%qaqpre3(m) // PVA231, YWH094
				{	set $$$mtOutputDistinct($$$mtOutput(m)) = ""
					kill:($d($$$mtDistinct(m))) $$$mtDistinct(m)
					kill:($d($$$mtGroupDistinctList(m))) $$$mtGroupDistinctList(m)
					
					#; No grouping or aggregation remains, so move the HAVING clause, if any, to the WHERE clause
					#;
					if $d($$$mtHaving(m)) 
					{	set $$$mtWhere(m) = $g($$$mtWhere(m)) _ $$topLevelAnd^%qaqpre($$$mtHaving(m))
						kill $$$mtHaving(m)
					}
					
					s changed=1
				}
				#; PVA147: If NODUPSPRESENT is final reason for removal, reset dups state
				#; PVA192: We may not have killed DISTINCT. Reset NODUPSPRESENT accordingly
				if mt("dups",m)=$$$SQLNODUPSPRESENT
				{  if ($d($$$mtDistinct(m)) || $d($$$mtGroupDistinctList(m)) || ($d($$$mtOutput(m)) && ($$$mtOutputDistinct($$$mtOutput(m)) = "d"))) s mt("dups",m)=$$$SQLELIMINATEDUPS
				   else  s mt("dups",m)=$$$SQLPRESERVEDUPS
				}				
			}
		}
	}
.
	QUIT changed	
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
flattenNestedElementOf
	;  called with type,val,v,ev
	;
	QUIT:("ftsxiq"[ev)	
	n rootlog,sqb,niflg s niflg="" // PVA242: niflg
	if ev="l"&&(",&,!,ANYOFAND,"[(","_$p($p(v,"^",2),"%NOINDEX")_",")) // PVA242
	{	n i,valSave s valSave=val
		#; This is the case where the FOR SOME ELEMENT appears as an operand of a log
		#; except for the NOT FOR SOME ELEMENT case, covered below.
		#;
		f i=4:1 
		{	q:$p(v,"^",i)=""
			if $p(v,"^",i)&&($e($$$mtLOperator($$$mtL($p(v,"^",i))),1,16)="FOR SOME ELEMENT") // PVA242
			{	s log=$p(v,"^",i),sqb=$p($$$mtV($$$mtLOperand1($$$mtL(log))),"^",2)
			    s:$$$mtLOperator($$$mtL(log))["%NOINDEX" niflg=1 // PVA242
				s rootlog=$$$newlog("l^ANYOFAND^,^"),$p($$$mtL(valSave),"^",i)=rootlog
				do complexlog^%qaqpnl(sqb,rootlog)
				do notnullw^%qaqpnl(sqb,1)				// do NULL processing first!
				do flattenExists(m, sqb, 0, 1, rootlog) // log is passed implicitly
				d lflds^%qaqpnl("l",rootlog,"do")
				s:niflg $$$mtLOperator($$$mtL(rootlog))=$$$mtLOperator($$$mtL(rootlog))_"%NOINDEX" // PVA242
				s progress=1
			}
		}
		s val=valSave
	}
	elseif ev="l"&&($p(v,"^",2)="'"||($p(v,"^",2)="'%NOINDEX"))&&($e($$$mtLOperator($$$mtL($p(v,"^",4))),1,16)="FOR SOME ELEMENT") // PVA242
	{	s log=$p(v,"^",4)
		s rootlog=$$$newlog("l^ANYOFAND^,^"),$$$mtLOperand1($$$mtL(val))=rootlog
		s sqb = $p($$$mtV($$$mtLOperand1($$$mtL(log))),"^",2)
		do complexlog^%qaqpnl(sqb,rootlog)
		do notnullw^%qaqpnl(sqb,1)				// do NULL processing first!
		do flattenExists(m, sqb, 0, 1, rootlog)
		d lflds^%qaqpnl("l",rootlog,"do")
		s progress=1
	}
	elseif ev="v"&&($e($p(v,"^",2),1,16)="FOR SOME ELEMENT")&&$d($$$mtWhere(m)) // PVA242
	{	n lgWhr s lgWhr=$l($e($$$mtWhere(m),1,$find("^"_$$$mtWhere(m),"^"_val_"^")-$l(val)-3),"^")
		s log=val s:$p(v,"^",2)["%NOINDEX" niflg=1 // PVA242
		s rootlog=""
		s sqb=$p($$$mtV($$$mtLOperand1($$$mtL(val))),"^",2)
		do flattenExists(m, sqb, lgWhr, 1, rootlog)		// passes log implicitly
		s:rootlog $$$mtWhere(m)=$g($$$mtWhere(m))_rootlog_"^"
		d lflds^%qaqpnl("l",rootlog,"do")
	    s:niflg $$$mtLOperator($$$mtL(rootlog))=$$$mtLOperator($$$mtL(rootlog))_"%NOINDEX" // PVA242
		s progress=1
	}
	do lvarg^%qaqpnl	
	QUIT
	
	#; This is a singleton select if there are equality conditions on required unique fields
	#; for each stream that this query references
isSingletonSelect(m) [mt] {
	quit:$d($$$mtOneRow(m)) 1
	if $p($g($$$mtP(m)),"^",3),'$d($$$mtGroupDistinctList(m)) {
		for i=1:1  s a=$p($$$mtPAggList($$$mtP(m)),",",i) q:a=""  s v=$$$mtV(a) i $p(v,"^",6)="" { s i=0 quit }
		QUIT:i>0 0		
		QUIT 1
	}
	set mstr=$$mstr^%qaqpqo(m)
	if '$bitfind(mstr,1) RETURN 0
	set ukf=""
	#; Fields can contain 'd' for descending in ORDER BY case so remove this, this will automatically add all streamless conditions too
	do redist^%qaqpqo("",.ukf,,m)
	#; if we are unique on every stream referenced in mstr then this is unqiue
	RETURN '$bitfind($bitlogic(mstr&~ukf),1)
.
}
	
	#; PVA247: rewrote
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
removeUnnecessaryStreams(m) [mt,mts,linx,ptj,viewSpConds] Public // PVA250 - ADD viewSpConds
	#; If query block m eliminates duplicates and does not do aggregation, or is insensitive to
	#; duplicate elimination, and if there is a join from stream A to stream B that preserves the 
	#; rows of stream A and there are no other references to stream B, then stream B is redundant 
	#; and can be removed, along with the join.
	#;
	#; Even if query block m does not eliminate duplicates, if the join from A to B preserves A
	#; and has join multiplicity = 1 (making it a "lossless join", by definition), then the join
	#; from A to B, and stream B, can still be removed if there are no other references to B.
	#;
	#; Note that the presence of aggregates in the query block does not disqualify the algorithm,
	#; it only restricts it to removing streams that do not change the join multiplicity.
	#; 
	#; Note: we should scan references to a view from its containing query block and replace
	#; expressions in the view output list with constants before running this procedure in order
	#; to eliminate the maximum number of streams.
	#; 	 
 {	
 	s dupSensAgg = 0
 	if ($$$mtPAggList($$$mtP(m))'="")
	{	f s=1:1 s val=$p($$$mtPAggList($$$mtP(m)),",",s) q:val=""  quit:",min,max,"'[(","_$p($$$mtV(val),"^",2)_",")
		s:val'="" dupSensAgg=1
	}
.
 	set distinctcase = (($g(mt("dups",m))'=$$$SQLPRESERVEDUPS) && 'dupSensAgg)
.
	for
	{ s removed=0
	  s r=m_"^" for 
	  { s r=$o($$$ptrel(r)) q:r=""  q:$p(r,"^")'=m 
	    if $$chkremovestr(m,$$$ptrel(r),distinctcase) s removed=1
	  }
	  q:'removed
	}
	do redoFields^%qaqpre2 // EEE050 (patching optimization in EEE041 that broked original fix in EEE038): it's necessary to clear and redo fields after changing mt entries such as "v","l","w","c","empty" (e.g., removing conditions)
    QUIT	
 }
	#; PVA247: Wrote out of refactored pieces of old code, plus new code
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
chkremovestr(m,str,distinctcase) [mt,mts,linx,ptj,viewSpConds] // PVA250 - ADD viewSpConds
    {
	  if m_"^"_$$strtoname^%qaqpre2(str)=$g($$$mtTarget) QUIT 0 // PVA264: can't remove updating target
	  s referenced=0
	  if m=1 && $d($$$mtNewVals)
		{	for lgi=1:1 s val=$p($g($$$mtNewVals),",",lgi) q:'val  if $$refStream("v",val,str) { s referenced = 1 QUIT }
		}		
	  QUIT:referenced 0
.
	  if $d($$$mtHaving(m)) && $$refStream("l",$$$mtHaving(m),str) QUIT 0
.
	  if $d($$$mtOutput(m))
	  {	for lgi=1:1:$l($$$mtOutputVals($g($$$mtOutput(m))),",")-1
	  	{	set val = $p($$$mtOutputVals($$$mtOutput(m)),",",lgi)
			if $$refStream("v",val,str) { s referenced = 1 QUIT }
		}
	  }
	  s str1="" for  // PVA348:  Only needed for lateral, but harmless to do for all
	  {  s str1=$o($$$mtTvfParams(str1),1,arglist) q:str1=""  
	     continue:($$$mtRQb($$$mtR(str1))'=m || (arglist=$c(0)))
	     for i=1:1:$ll(arglist) {s val=$lg(arglist) if val && $$refStream("v",val,str) { s referenced = 1 QUIT }}
	     quit:referenced
	  }
	  QUIT:referenced 0
	  #; PVA183: $d() test must account for subnodes of $$$mtS
	  #; whereas $$$mtSequencers only applies to m=1
	  if m=1 && ($d($$$mtSequencers)#10)		// ORDER BY clause
	  {	s ptfjoo=$tr($g($$$mtSequencers),"d")
		for lgi=1:1:$l(ptfjoo,",")-1
		{	set val = $p(ptfjoo,",",lgi)
			if $$refStream("v",val,str) { s referenced = 1 QUIT }
		}
	  }
	  QUIT:referenced 0
.
	  #; PVA183: ORDER BY in subqueries.
	  if $d($$$mtSequencersQb(m))		// ORDER BY clause
	  {	s ptfjoo=$tr($g($$$mtSequencersQb(m)),"d")
		for lgi=1:1:$l(ptfjoo,",")-1
		{	set val = $p(ptfjoo,",",lgi)
			if $$refStream("v",val,str) { s referenced = 1 QUIT }
		}
	  }
	  QUIT:referenced 0
	  if $d($$$mtGroupDistinctList(m))		// GROUP BY /DISTINCT clause
	  {	for lgi=1:1:$l($g($$$mtGroupDistinctList(m)),",")-1
		{	set val = $p($$$mtGroupDistinctList(m),",",lgi)
			if $$refStream("v",val,str) { s referenced = 1 QUIT }
		}
	  }
	  QUIT:referenced 0
.
	  s logs = $g($$$mtWhere(m)),goodjoin=0
	  for lgi=1:1:$l(logs,"^")-1
	  {	set log = $p(logs,"^",lgi) q:'log
	    if $$refStream("l",log,str) 
	    { 
	      s ptlg=$$$mtL(log)
	      if $p(ptlg,"^",2)="=" 
	      { if goodjoin s referenced=1 quit // PVA265: if already found a good join, another counts as a reference
	                                       #;  ... until post analysis of saved joins is implementd. That is,
	                                       #; when saving joins for multi-key and implication analysis, don't quit here
	        s v5=$$$mtV($p(ptlg,"^",5)) if $e(v5)'="f" s referenced=1 quit
			s v4=$$$mtV($p(ptlg,"^",4)) if $e(v4)'="f" s referenced=1 quit
			#; PVA254: add missing parens below
			if $p(v5,"^",2)=str && ($p(v4,"^",2)'=str) && $$isFkeyToPkey(v4,v5) set goodjoin=1 continue
			if $p(v4,"^",2)=str && ($p(v5,"^",2)'=str) && $$isFkeyToPkey(v5,v4) set goodjoin=1 continue
	      }
	      // to support multi, save in joins(), analyze later 
		  //if condition has an implication whose only conditions referencing this stream 
		  //   are field to field joins to this stream, save in implicated() and continue
	      s referenced=1 quit
	    }
	  }
	  QUIT:referenced 0
	  // when supporting multi-key fk, check whether joins() form fk->uk, with 
	  //  fk required or forced NOT NULL
	  // when supporting implications, consider for each of possibly several fk->uk,
	  //    whether all other joins are implicated and any implicated conditions are 
	  //    implicated by the fk->pk joins. If so, good, else quit 0
.
	  s founduniq=0,foundoj=0
	  if (linx'="")
	  {	for lgi=1:1 
	    { s val=$p(linx,"^",lgi) q:val=""    
	      if $$refStream("l",val,str) 
	      {  s ptlg=$$$mtL(val)
	         s v5=$$$mtV($p(ptlg,"^",5)) 
	         if $p(v5,"^",2)=str // this stream is RHS
	         {  s foundoj=1
	            if distinctcase continue // any LOJ condition good in this case
				k mt("diststr") ; clear and then set mt("diststr")
				d containsDistinctKey($p(ptlg,"^",5)_",")
				if $d(mt("diststr")) s founduniq=1 
				continue
	            //   (when multikey supported, save in joins(), analyze later)
	         }
	         set referenced = 1 QUIT 
	      }
	    }
	    QUIT:referenced 0
	    if 'goodjoin && 'distinctcase && 'founduniq QUIT 0
	    // for multikey, if 'distinctcase, analyze if joins() contains any form of unique key
	  }
	  QUIT:('goodjoin && 'foundoj) 0
	  #; Now remove the stream
	  if linx'="" 
	  {
 	    for lgi=$l(linx,"^"):-1:1
	    { s val=$p(linx,"^",lgi) continue:val=""    
	      if $$refStream("l",val,str) 
	        { 
			   set $$$mtL(val) = "i^unnecessaryJoin^"_$$$mtL(val)
			   set:$bit($g(viewSpConds),val)=1 $bit(viewSpConds,val)=0		// JLF301
			   set $p(linx,"^",lgi,lgi+1)=$p(linx,"^",lgi+1)
			   set $$$mtRedoFields = 1 // $$$mtRedoFields is used by redoFields^%qaqpre2()
	        }
	    }
	  }
.
	  if $d($$$mtWhere(m))
	  {
		 s logs = $g($$$mtWhere(m))
	     for lgi=($l(logs,"^")-1):-1:1
	     {	set log = $p(logs,"^",lgi) 
	        if $$refStream("l",log,str) 
	        { 
			   set $$$mtL(log) = "i^unnecessaryJoin^"_$$$mtL(log)
			   set:$bit($g(viewSpConds),log)=1 $bit(viewSpConds,log)=0		
			   set $p(logs,"^",lgi,lgi+1)=$p(logs,"^",lgi+1)
	        }
	     }
	     if logs="" {k $$$mtWhere(m)} else {s $$$mtWhere(m)=logs}
		 set $$$mtRedoFields = 1 // $$$mtRedoFields is used by redoFields^%qaqpre2()
	  }
	  
	  #; killing an entire streamed view,
	  if $d($$$mtRVirtual(str)) 
	  {	
	     s $$$mtPQbIsActive($$$mtRVirtual(str))=0		// disable inline view
		 k $$$mtWhere($$$mtRVirtual(str))			// kill where clause
		 set $$$mtRedoFields = 1 // $$$mtRedoFields is used by redoFields^%qaqpre2()
	  }
	  #; not populated yet s logPos = $find($p(ptj(m,1),"^",1),log)
	  s strPos = $find($p(ptj(m,1),"^",2),","_str_",")
	  s $p(ptj(m,1),"^",2) = $e($p(ptj(m,1),"^",2),1,strPos-$l(","_str_","))_$e($p(ptj(m,1),"^",2),strPos,*)
	  k $$$ptrel(m_"^"_$$strtoname^%qaqpre2(str)) // PVA091: maintain ptrel
	  set $$$mtRQb($$$mtR(str)) = 0		// detach the stream from any real query block
	  k mts(m,str)						// maintain mts
	  s lp=$lf($g(mts("streamorder",m)),str)
	  if lp s mts("streamorder",m)=$li(mts("streamorder",m),1,lp-1)_$li(mts("streamorder",m),lp+1,99999999)
.
	  QUIT 1
    }
.
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
refStream(type,val,str)
	n ref,fVal,lgj
	s ref = ""
	if (type="v") && ($e(mt(type,val))="f")
	{	set:(str = $p($$$mtV(val),"^",2)) ref = 1
	}
	else
	{	for lgj=2:1:$l($p(mt(type,val),"^",3),",")-1
		{	s fVal = $p($p(mt(type,val),"^",3),",",lgj)
			if str = $p($$$mtV(fVal),"^",2)
			{	set ref = 1
				quit
			}
		}
	}
	QUIT ref
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
singletonGroups(m)
	#; Returns 1 if no group can contain more than one row, else returns 0.
	#; 
	n boundColumns,lw,str,unboundStreams s boundColumns = $g($$$mtGroupDistinctList(m))
	for lw=1:1:$l($g($$$mtWhere(m)),"^")-1
	{	s ptlg = $$$mtL($p($$$mtWhere(m),"^",lw))
.
		#; Find a simple fld=con predicate, and append "fld," to boundColumns
		continue:($e(ptlg)'="v"||($p(ptlg,"^",2)'="=")||($l($p(ptlg,"^",3),",")'=3))		; 1-field equality condition
		if ($e($$$mtV($p(ptlg,"^",4)))="f" && ("txn"[$e($$$mtV($p(ptlg,"^",5))))) { s boundColumns = boundColumns_$p(ptlg,"^",4)_"," }
		elseif ($e($$$mtV($p(ptlg,"^",5)))="f" && ("txn"[$e($$$mtV($p(ptlg,"^",4))))) { s boundColumns = boundColumns_$p(ptlg,"^",5)_"," }
	}
	
	k mt("diststr") d:boundColumns'="" containsDistinctKey(boundColumns)		; clear and then set mt("diststr")
	QUIT:'$d(mt("diststr")) 0
	s unboundStreams = "" f str=1:1:maxs i ($p($g($$$mtR(str)),"^",2)=m) && ($lf($g(mt("diststr")),str)=0) s unboundStreams = unboundStreams_str_","
	
	if unboundStreams'=""
	{
		#; No key was found for the streams in the unboundStreams list.  If we have an inner equijoin 
		#; from a stream for which a key is explicitly or implicitly determined to a unique key 
		#; of a stream in the unboundStreams list, then the stream in the unboundStreams list is
		#; also bound.
		#;
		#; If, after iteratively propagating the dependency relationships, the unboundStreams list
		#; becomes empty, then the stream returned by this query block is duplicate free.
		#;
		n foundKeyJoin,lw,ptlg,v4,v5,str4,str5,joinCols
		for
		{	k joinCols
			s foundKeyJoin=0
			for lw=1:1:$l($g($$$mtWhere(m)),"^")-1
			{	s ptlg = $$$mtL($p($$$mtWhere(m),"^",lw))
		
				#; Find a simple fld=fld inner equijoin
				continue:($e(ptlg)'="v"||($p(ptlg,"^",2)'="=")||($p(ptlg,"^",5)="")||($l($p(ptlg,"^",3),",")'=4))		; 2-field equijoin
				s v5=$$$mtV($p(ptlg,"^",5)) continue:$e(v5)'="f"
				s v4=$$$mtV($p(ptlg,"^",4)) continue:$e(v4)'="f"
			
				#; Construct a list of join fields for each stream in the unboundStreams list. 
				s str4=$p(v4,"^",2),str5=$p(v5,"^",2)
				if (","_unboundStreams)[(","_str4_","),(","_unboundStreams)'[(","_str5_",") { s joinCols($p(v4,"^",2))=$g(joinCols($p(v4,"^",2)))_$p(ptlg,"^",4)_"," }
				elseif (","_unboundStreams)[(","_str5_","),(","_unboundStreams)'[(","_str4_",") { s joinCols($p(v5,"^",2)) = $g(joinCols($p(v5,"^",2)))_$p(ptlg,"^",5)_"," }
			}
			
			#; If joinCols contains a unique key of the corresponding stream, then the multiplicity
			#; is not increased by joining to this stream, so remove the stream from unboundStreams
			#;
			s str5 = ""
			for
			{	s str5 = $o(joinCols(str5),1,boundColumns) q:str5=""
				k mt("diststr") d:boundColumns'="" containsDistinctKey(boundColumns)
				if $d(mt("diststr"))
				{	s unboundStreams=$p(unboundStreams,str5_",",1)_$p(unboundStreams,str5_",",2,*)
					s foundKeyJoin=1
					quit:unboundStreams="" 
				}
			}
.
			quit:(unboundStreams=""||('foundKeyJoin))
		}
	}
	
	k mt("diststr")
	QUIT unboundStreams=""
isFkeyToPkey(fvFK,fvPK) // Check for a NOT NULL foreign key to Primary Key reference
	/*
	
	For an FKEY constraint, $li(info,3) below should be a $List structure with the following data:
.
	  1. Foreign Key field name
	  2. Referenced table name (qualified)
	  3. Referenced field names (delimited by commas)
	  4. Referenced key name (object)
	  5. Referenced key name (sql)
	  6. Update Rule
	  7. Delete Rule
	  8. Referenced class name (object)
  	
  	*/
  	
  	#; Verify that neither field comes from a view.  In principle we could analyze inside views, too.
  	#;
	RETURN:$d($$$mtRVirtual($p(fvFK,"^",2))) 0
	RETURN:$d($$$mtRVirtual($p(fvPK,"^",2))) 0
.
	new irnPK,irnFK
	set irnPK=+$$$mtR($p(fvPK,"^",2))
	set irnFK=+$$$mtR($p(fvFK,"^",2))
	RETURN:$$nulable^%qaqpqo(irnFK,$p(fvFK,"^",3)) 0 // PVA247: check fk, not pk
	
	new coninfo,kn 
	set kn=""
	for  {
		set kn=$$GetNextFKey($$$smdExtent(1,irnFK),kn,.coninfo,irnFK) q:kn=""  
		continue:$p(fvFK,"^",3)'=$$$smdGetIfn(1,irnFK,$li($li(coninfo,3),1))	// fvFK field does not match the FKey field, try next FKey
		continue:$$$smdExtent(1,irnPK)'=$li($li(coninfo,3),8)					// PK class does not match FKey's Referenced class, try next FKey
		quit:$p(fvPK,"^",3)=$$$smdGetIfn(1,irnPK,$li($li(coninfo,3),3)) 		// PVA247: fix	// fvPK field does match the referenced field, kn defined to the found FKey
	}
	
	RETURN kn'=""
.
.
markUnionLeg		
	#; Set each UNION leg query block to do DISTINCT OPTIONAL so that the optimizer has enough 
	#; information to choose an index-based plan if such a plan is available.
	#; 
	#; Until we implement the index-based DISTINCT operation, though, it is always better 
	#; to remove the DISTINCT.
	#; 
	if ($g($$$mtUnion(m)) '= "") 
	{ 
		new distinctGrp, g, grp, legs, lm, uli, ulist
		set distinctGrp = $$unlev^%qaqpag(m)
		for grp=1:1:$ll(distinctGrp) 
		{ 
			set ulist = $li(distinctGrp,grp)
			if ($ll(ulist)>1) 
			{ 	
				for uli=1:1:$ll(ulist)
				{
					set lm = $li(ulist,uli)
	#; JLF122
					continue:'$$distinctDeterminesOutputs^%qaqpre2(lm)
					set mt("dups",lm) = $$$SQLDONTCAREDUPS					
				}
			}
		}
	}
	QUIT
.
	// Return the next FKey constraint from extent
	// Returned value is the CON, pInfo passed by reference
	//  pIrn is the FKey table's irn, used for concurrence check
GetNextFKey(pExtent,pCon,pInfo,pIrn) [] PUBLIC {
.
loop	set pInfo=""
	set pCon=$o($$$EXTCONS($$$pEXT,pExtent,pCon))
	QUIT:pCon="" ""									// No more constraints
	set pInfo=$$$EXTCONSsqlinfo($$$pEXT,pExtent,pCon)
	goto:$lg(pInfo,2)'="FKEY" loop							// Constraint is not a foreign key
	goto:$$$comMemberKeyGet(pExtent,$$$cCLASSfkey,pCon,$$$cFKEYnocheck) loop	// FKEY defined with NoCheck, don't use it
	
		#; Optimistic concurrence check
	new %ts1,%ts2
	set %ts1=$$$smd(1,pIrn,33),%ts2=$g($$$comClassKeyRaw($$$smdClassname(1,pIrn),$$$cCLASStimechanged))
	do:(%ts1'=%ts2) error("150a")	// Error message uses variable %class,%ts1,%ts2
	
	QUIT pCon
}
	
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
transformExists(pqb)
	new lv, maxji, logs, lgWhr, log, sqb, pqbExpr, pqbHasAFTERHAVING, sqbExpr, EXISTSquery, NOTEXISTSquery, m
	new decorrWhr, decorrHav, bestOp, bestExpr, doingSvso
	set maxji = 300					// Maximum number of resulting join items after merging
	quit:'$d($$$mtWhere(pqb))				// The subquery block to be flattened must appear in the WHERE clause
	quit:$$numstr^%qaqpnl(pqb)>=maxji	// Avoid combinatorial explosion during the optimizer phase
	quit:(info && (info '= "O"))		// Don't do this for info-only compilation
    
    #; Find an EXISTS or NOT EXISTS subquery in the WHERE clause of pqb that does not appear
    #; below an OR.  Assume that the AND nodes have been fully flattened above any OR.
    #; 	
    set pqbHasAFTERHAVING = $$afterHaving(pqb)
	set logs=$g($$$mtWhere(pqb)) 
	for lgWhr=$l(logs,"^")-1:-1:1 
	{
		set log=$p(logs,"^",lgWhr)
		set NOTEXISTSquery = $s(($$$mtLOperator($$$mtL(log))="'") && (",FOR SOME,"[(","_$$$mtLOperator($$$mtL($$$mtLOperand1($$$mtL(log))))_",")):1,1:"")
		set EXISTSquery = (",FOR SOME,"[(","_$$$mtLOperator($$$mtL(log))_","))
.
		if EXISTSquery || NOTEXISTSquery
		{
			new corrJoinWhr, corrJoinHav, corrToPqb, unseparableCorr, corrEquiJoinWhr, corrEquiJoinHav, nonCorrWhrPreds, orderByOpt, multiRef, sqbRestriction
			set:NOTEXISTSquery log = $$$mtLOperand1($$$mtL(log))				// log always points at the EXISTS.
			set sqb = $p($$$mtV($$$mtLOperand1($$$mtL(log))),"^",2)			// set sqb = m of subquery
 
			#; List of exclusion criteria for this transformation rule
			#; 			
			goto:(EXISTSquery && ($$numstr^%qaqpnl(sqb) + $$numstr^%qaqpnl(pqb)) > maxji) nextLgWhr	// too many join items?  ; PVA087 - $numstr
			goto:($d($$$mtUnionTopQb(sqb))) nextLgWhr	// UNION subquery
			goto:($$isSharded^%qaqpnl(pqb) && $d($$$mtOnRoot(pqb))) nextLgWhr
			goto:($$isSharded^%qaqpnl(sqb) && $d($$$mtOnRoot(sqb))) nextLgWhr
			                        
			 
			#; Determine if sqb is correlated to pqb, and if so, if there is a correlated join between them
			#; 
			set corrToPqb = (($$$mtCorrParentQb(sqb)=pqb)&&(+$$$mtP(sqb)=pqb)) // PVA245: just use mt("corr"), no need for whole function
			#; Search for simple join correlations in the WHERE or HAVING clause
			#;
			if corrToPqb 
			{	d corrJoin(pqb, sqb, .corrEquiJoinWhr, .corrEquiJoinHav, .corrJoinWhr, .corrJoinHav, .unseparableCorr, .multiRef, .sqbRestriction) }
			else
			{	s corrJoinWhr="",corrJoinHav="",unseparableCorr=0, corrEquiJoinWhr="", corrEquiJoinHav="", multiRef=0, sqbRestriction=0 }
			
			#; Set-Valued Subquery Optimization
			#; 				
			#; If there is more than one separable correlation, then create the temp index
			#; on a correlating condition that doesn't already have a useful index on it.
			#; 
			set doingSvso = ""
			set decorrWhr = "", decorrHav="", bestOp="", bestExpr="", doingSvso=""
			do:('multiRef && ($$$mtLOperand2($$$mtL(log))="" || ($e($$$mtV($$$mtLOperand2($$$mtL(log))))'="v")) && ((ndxConEql(sqb)="") && ($$constEql(pqb)=""))) testSvso
			
			#; If either sqb has no HAVING clause, or pqb has no aggregate that was (originally)
			#; computed %AFTERHAVING, then it is possible to flatten sqb into pqb; however, 
			#; flattening does not always result in a better execution plan, and sometimes
			#; it is even better to un-flatten (convert a join to a subquery).
			#; 
			#; An EXISTS subquery may be rewritten as a join with a restriction on a table formerly 
			#; inside the subquery.  If a table formerly in the subquery is selected as the first item
			#; in the join order, then the restrictions on this first table may enable an index-restricted
			#; plan to be created that improves performance.  If there is no (column relOp value) restriction 
			#; in the subquery, then flattening is less likely to result in an improved plan.
			#; 
			#; Flattening semantically requires a DISTINCT BY pqb.rowid(*), as well as adding
			#; pqb.rowid(*) to the DISTINCT BY of all aggregates in pqb, and adding sqb.rowid(*) 
			#; and %FOREACH join* to any aggregates in sqb, as well as moving correlated predicates 
			#; from sqb to pqb; consequently, if sqb doesn't do aggregation and either (a) pqb 
			#; doesn't need to preserve duplicates, or (b) sqb is guaranteed to have distinct rows, 
			#; then no additional DISTINCT cost is required; therefore the optimizer should do no 
			#; worse than it did before flattening, and may do much better.  We decided to relax
			#; this somewhat, to allow DISTINCTing of up to k = 5 rowids.
			#; 
			#; PVA087: Until set up grand scheme (propagatepreds, transformexists, propagate preds)
			#;         must disable flattening for sqb containing ON clause. Only flatten needs to be 
			#;         disabled.
			#; 
			if (EXISTSquery && '$$badtop(sqb) && '$$joinOrderConstrained(pqb) && ('$d($$$mtHaving(sqb)) || 'pqbHasAFTERHAVING) && '$$hint("%NOFLATTEN",sqb) && '$d($$$mtLeftOuterJoins(sqb)) && '$d($$$mtOnRoot(sqb)) && '$$nestedCorrToPqb(sqb,pqb) &&  ; PVA195: added badtop(), JLF361: added joinOrderConstrained
			    ('$$isShardedTop^%qaqpnl(sqb) || ($$oksubq^%qaqpagg(pqb,1) && '$$shardcontext^%qaqpre(pqb))) &&
		#;	    ((pqb>1)||(",SEL,DEC,INS,"[$g($$$mtStatementType))) &&	// Don't flatten into the top query block of a DML stmt  ;  removed by AK1005
			    ($$hint("%FLATTEN",sqb) || 
			     (
			        ($lg(corrEquiJoinWhr,1)="C") 	// require that we have at least one (pqbColumn = sqbColumn) correlation that is, or that could be, in the WHERE clause
			 		; && sqbRestriction				// we want to have at least one (relOp sqbColumn, streamlessExpr, ...) restriction
			        && ( uniqueBody(sqb) || (mt("dups",pqb) '= $$$SQLPRESERVEDUPS) || ($$numstr^%qaqpnl(pqb)<=5) )
			        && ($$numstr^%qaqpnl(pqb)<=maxji)
			        && '$d($$$mtHaving(sqb))		 		// not strictly required, but believed to generally hurt performance to flatten when the subquery needs a HAVING clause
			     )
			    )
			   )
 			{
				do flattenExists(pqb, sqb, lgWhr, "", "", corrJoinWhr, corrJoinHav)
				set logs=$g($$$mtWhere(pqb)),lgWhr=$l(logs,"^")
 			}
 			#; If there is no unseparable correlation, and either (a) there is at least one equijoin 
 			#; between a column of pqb and any expression of sqb, or (b) none of the correlations are
 			#; in the WHERE clause of sqb, and unless there are a large number of streams in pqb with
 			#; no useful index for the join columns of sqb, then convert sqb to a streamed view.
 			#; 
 			#; When single-row views can be executed early in the join order, then add the singletonSelect
 			#; as a sufficient criteria.  Currently, all Cartesian products are pushed to the end of the join order.
 			#; 
 			elseif (EXISTSquery && corrToPqb && 'unseparableCorr && '$d($$$mtLeftOuterJoins(sqb)) && '$d($$$mtOnRoot(sqb)) && '$$hint("%NOMERGE", sqb)
 			        && '$$isShardedNotTop^%qaqpnl(sqb) // No benefit conceivable, might make different decision on shard server
 					 && '$$badtop(sqb) ; PVA195: add TOP 0 test (badtop)
 					&& '$$hint("%INORDER", pqb)
			#;        && ((pqb>1)||(",SEL,DEC,INS,"[$g($$$mtStatementType))) 	// Don't flatten into the top query block of a DML stmt ;  removed by YCL136
 			        && (((corrEquiJoinWhr'="") && '$d($$$mtHaving(sqb))) || ((corrEquiJoinHav'="") && ($ll(corrJoinWhr)=0)))
 			        && (($$numstr^%qaqpnl(pqb)<=5) || $g(singletonSelect(sqb)) || ($d($$$mtHaving(sqb)) || '$$usefulIndex(sqb, $$getFList("",sqb,corrJoinWhr),"")))
 			        && ((corrJoinWhr '= "") || (corrJoinHav '= "")
					&& $$tryExistsToView())
 			       )
 			{
		 		do existsToView(pqb, sqb, lgWhr, log, corrJoinWhr, corrJoinHav)
				set logs=$g($$$mtWhere(pqb)),lgWhr=$l(logs,"^")
 			}
 			else
 			{
	 			#; If we didn't test for svso earlier, then test whether set-valued subquery
	 			#; optimization is possible.  SVSO is possible to do even in the presence of
	 			#; some unseparable correlations, but not when there are multiple references.
	 			#; When there are multiple references then it might still be possible to use
	 			#; SVSO for an equality condition plus an additional correlation, provided that
	 			#; the pqb-side reference is replaced with the equated sqb-side expression.
	 			#; Until such time as this is implemented, we just disable SVSO when there are
	 			#; ANY multiple reference correlations, which includes multiple references inside 
	 			#; query blocks that are nested inside the sqb.  This should be replaced by
	 			#; logic that excludes those pqb expressions that are multiply referenced, but
	 			#; includes any expressions that are referenced only once. (future enhancement)
	 			#; 
.
	 			if 'doingSvso && 'multiRef && ($$$mtLOperand2($$$mtL(log))="" || ($e($$$mtV($$$mtLOperand2($$$mtL(log))))'="v")) && '((ndxConEql(sqb)="") && ($$constEql(pqb)="")) do testSvso
.
				#; JLF362: SVSO is possible to do when there are multiple references to the
				#;    same pqb expression, but the replacement logic isn't set up to handle
				#;    that case, so we disable SVSO when multiRef=1
				#;
				#; PVA183: Note, toplimit should never be set for an EXISTS because
				#;    top1^%qaqpop eliminates any $$$mtSequencersQb(sqb). However, a TOP with 
				#;    parameter (which could be set to 0)
				#;    or a literal 0 prevents, svso from being valid. No loss, because
				#;    any user written TOP in an EXISTS is stupid (we put in a TOP 1
				#;    as an optimizer/codegen hint). 
				#;
 				if 'multiRef && '$$badtop(sqb) && (($ll(decorrWhr)>0 && ($ll(decorrHav)=0)) || ($ll(decorrHav)>0 && ($ll(decorrWhr)=0))) 	// svso is possible to do
 				   && '$$isSharded^%qaqpnl(sqb) && '(NOTEXISTSquery && (bestOp = "=")) // Can't do - sharded pqb would become non-regeneratable; can ALWAYS do on shard server
				{
					n oString, oList, wString, corrListW, corrListH		// declare implicit outputs
					do decorrSubquery(pqb, sqb, lgWhr, decorrWhr, decorrHav, 0, .corrListW, .corrListH)
					k oString, oList, wString		// discard unused implicit outputs
									
					#; Replace the top-level operator with ANY:op[,op...] or ALL:op[,op...].  Piece 3 is 
					#; filled in by flds (below), pieces 5 and above are the previously-correlated expression 
					#; from pqb, and piece 4 is the subquery.  Output i of the subquery positionally 
					#; corresponds to operator i and the parent query block expression in piece 4+i.
					#;
					new operators,agg,subqLog
					s bestOp = $tr(bestOp,"><","<>")	; use the original svso convention that the special bestOp operator means pqb bestOp sqb
					set operators = bestOp // $$$mtLOperator($$$mtL(bestOp))
					n li,lj
					for lj=2:1:($ll(decorrHav)+$ll(decorrWhr)) set operators = operators _ ",="
					set pqbExpr = ""
					for lj=1:1:$ll(decorrHav) s pqbExpr = pqbExpr _ $$getPqbExpr($li(decorrHav,lj)) _ "^"
					for lj=1:1:$ll(decorrWhr) s pqbExpr = pqbExpr _ $$getPqbExpr($li(decorrWhr,lj)) _ "^"
					set sqbExpr = ""
					for lj=1:1:$l($$$mtOutputVals($$$mtOutput(sqb)),",")-1 s sqbExpr = sqbExpr _ $lb($p($$$mtOutputVals($$$mtOutput(sqb)),",",lj))
					set subqLog = $s(NOTEXISTSquery:$p(logs,"^",lgWhr),1:log)
 					set $$$mtL(subqLog) = "v^"_$s(EXISTSquery:"EXISTS:",1:"NOTEXISTS:")_operators_"^^"_$$$mtLOperand1($$$mtL(log))_"^"_pqbExpr
					do complexlog^%qaqpnl(sqb,subqLog)
					#; Next, prepare to call flds to fill in the field lists in piece 3 for pqb and sqb.
					#; Unfortunately $$$mtP(sqb) piece 4 needs to be set for query block m before flds is called
					#; on query block sqb, so we need to remove all the decorrelated columns from $$$mtP(sqb) piece 4
					#;
					s $p($$$mtV($$$mtLOperand1($$$mtL(log))),"^",3) = ","
					n old,new,xpr,vv,corr,fl s old=$$$mtPCorrelatedFields($$$mtP(sqb)),new="",corr=pqbExpr,fl=","
					s:$p(old,",",1)="" $p(old,",",1,2)=$p(old,",",2)
					
					#; Collect all fields in all pqbExpr that are being decorrelated
					if corrListW'="" { f li=1:1:$ll(corrListW) s fl=fl_$li(corrListW,li)_"," }
					if corrListH'="" { f li=1:1:$ll(corrListH) s fl=fl_$li(corrListH,li)_"," }
					
					#; If we find a collated field to be uncorrelated, add the uncollated version of the field to fl
					f li=2:1
					{	q:$p(fl,",",li)=""
						s vv=$$$mtV($p(fl,",",li))
						s:($e(vv)="f")&&($p(vv,"^",3)["_") fl=fl_$p(mts($$$mtRQb($$$mtR($p(vv,"^",2))),$p(vv,"^",2),"ATT",+$p(vv,"^",3)),"^",5)_","
					}
					
					#; If a field is being decorrelated, then remove it from $$$mtP(sqb) piece 4
					f lj=1:1  
					{	q:$p(old,",",lj)="" 
						s:fl'[(","_$p(old,",",lj)_",") new=new_$p(old,",",lj)_"," 
					}
					s $$$mtPCorrelatedFields($$$mtP(sqb)) = new							// note: no leading "," as in piece 3 at pre-opt time
.
					#; If the FOR SOME had a direct reference to an outer expression, then we need
					#; to ensure that this expression is evaluated before executing the subquery.
					#; Add the additional outer expression to the end of the pqbExpr list.
					#;
					set:($$$mtLOperand2($$$mtL(log))="" || ($e($$$mtV($$$mtLOperand2($$$mtL(log))))="v")) pqbExpr = pqbExpr_$$$mtLOperand2($$$mtL(log))_"^"
					
					set:NOTEXISTSquery $$$mtL(log) = "i^"_$$$mtL(log)		// comment out the FOR SOME
					// s agg=$s(",'<,>,"[(","_bestOp_","):$s(EXISTSquery:"anymax",1:"allmax"),",'>,<,"[(","_bestOp_","):$s(EXISTSquery:"anymin",1:"allmin"),"'="=bestOp:$s(EXISTSquery:"anyneq",1:"alleql"),1:$s(EXISTSquery:"anyeql",1:"allneq"))
					s agg=$s(",'<,>,"[(","_bestOp_","):$s(EXISTSquery:"anymin",1:"allmin"),",'>,<,"[(","_bestOp_","):$s(EXISTSquery:"anymax",1:"allmax"),"'="=bestOp:$s(EXISTSquery:"anyneq",1:"alleql"),1:$s(EXISTSquery:"anyeql",1:"allneq"))
					s mt("svso",sqb) = $lb(agg,operators,pqbExpr,sqbExpr)
					#; Fix up all the field-related information in pqb and sqb
					#; 
					s m = sqb do flds^%qaqpnl 
					s m = pqb do flds^%qaqpnl
				}
 			}
		}
nextLgWhr
	}
	quit
.
	#; JLF361: created joinOrderConstrained
	#;
joinOrderConstrained(pqb) 
	QUIT:$$hint("%INORDER",pqb) 1
	QUIT:$$hint("%STARTTABLE",pqb) 1		// TBD - this is a limitation of the %STARTTABLE implementation and should be removed eventually
    n oby s oby = ((pqb=1 && ($g($$$mtSequencers)'="")) || (pqb>1 && ($g($$$mtSequencersQb(pqb))'=""))) 
	QUIT:'(oby && ($g($$$mtTopArg(pqb))'="")) 0
	n i,allfldssametbl,str s allfldssametbl = 1 f i=1:1 s v = $p($g($$$mtSequencers),",",i) q:v=""  s:i=1 str = $p($$$mtV(+v),"^",2) if '$$isTableFld^%qaqpre3(+v) || (i>1 && ($p($$$mtV(+v),"^",2)'=str)) { s allfldssametbl = 0 quit }
	QUIT:'allfldssametbl 0
	QUIT $$hint("%USEORDERBYINDEX",pqb) 
#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
	#; PVA183: create badtop
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
badtop(sqb) n t
	s t=$g($$$mtTopArg(sqb))
	QUIT:t="" 0
	QUIT:$$$mtVType($$$mtV(t))'="t" 1 // anything but a literal is bad
	QUIT $p($$$mtV(t),"^",2)<1
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
containsView(m)
	n foundView,str,v s foundView=0,str=""
	for  { s str=$o($$$mtR(str),1,v) q:str=""  if m=$$$mtRQb($$$mtR(str)),$d($$$mtRVirtual(str)) { s foundView=1 quit }}
	QUIT foundView
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF005
testSvso
    n joinOp,lj,sqbLog,sqbPqbJoinOrderIndexed,pass,maxStrmCard,str,coll
    set doingSvso = ""
    set maxStrmCard = 0
.
	if '$$hint("%NOSVSO",sqb) && '$$$mtPAggList($$$mtP(sqb)) && '$$badtop(sqb)	// no aggregation.  PVA195: add top 0 (badtop) test
	{
    	set sqbPqbJoinOrderIndexed = ""		
		set sqbLog = 1
		if ($ll(corrJoinHav) > 0)
		{
			for lj=1:1:$ll(corrJoinHav) 
			{ 
				set sqbLog = $li(corrJoinHav,lj) 
				set joinOp = $$getJoinOp(sqbLog)				
				continue:(((EXISTSquery && ("'="=joinOp))||(NOTEXISTSquery && ("'="'=joinOp)))
						  && ($e($g($$$mtV($$getSqbExpr(sqbLog))))'="f"))
.
				if (('$$IsNullable($$getSqbExpr(sqbLog)) && '$$IsNullable($$getPqbExpr(sqbLog))) || (EXISTSquery && '$$hasORISNULL(sqbExpr)) || (NOTEXISTSquery && $$hasORISNULL(sqbLog)))
				{
					if (joinOp="=") 
					{
						set decorrHav = decorrHav _ $lb(sqbLog)
					}
					elseif (bestOp="") || (joinOp="'=") ||
					       ((bestOp '= "'=") && (",>,'>,<,'<," [ (","_joinOp_",")))
					{
						set bestOp = joinOp
						set bestExpr = sqbLog
					}
				}
			}
			set:bestExpr decorrHav = $lb(bestExpr) _ decorrHav					
			set:((bestOp="") && (decorrHav'="")) bestOp = "="
		}
		if (($ll(corrJoinWhr) > 0) && '$d($$$mtHaving(sqb)))
		{
			#; On pass 1 we consider only non-indexed sqb expressions for inclusion in 
			#; the svso strategy.  If no non-indexed theta join is found in pass 1,
			#; then try to find an *indexed* theta join in pass 2.
			#; 
			for pass=1:1:2
			{	quit:((pass=2) && (((bestOp'="") && (bestOp'="=")) || ((bestOp="") && ($l($$$mtWhere(sqb),"^")=2))))
				
				#; The Cache 2010.* optimizer models multi-column joins as a single column join, and so may not use
				#; a good multi column index (for the right reasons) even if a good multi-column index is available.  
				#; We would like to encourage the use svso when there are multiple correlated equijoins, even when 
				#; this requires the construction of a temporary index from an existing index.  
				#; 
				#; This also handles the case when the multiple columns in the outer are from different streams.
				#; 
				for lj=1:1:$ll(corrJoinWhr) 
				{	set sqbLog = $li(corrJoinWhr,lj) 
					set joinOp = $$getJoinOp(sqbLog)
					continue:(((EXISTSquery && ("'="=joinOp))||(NOTEXISTSquery && ("'="'=joinOp)))
						  && ($e($g($$$mtV($$getSqbExpr(sqbLog))))'="f"))
					goto:$lf(decorrWhr,sqbLog) nextWhrPred
					if (('$$IsNullable($$getSqbExpr(sqbLog)) && '$$IsNullable($$getPqbExpr(sqbLog)))|| (EXISTSquery && '$$hasORISNULL(sqbLog)) || (NOTEXISTSquery && $$hasORISNULL(sqbLog)))
						&& ((joinOp="'=") || '$$usefulIndex(sqb, $lb($$getSqbExpr(sqbLog)),""))
						; && ((joinOp="'=") || (pass=2) || '$$usefulIndex(sqb, $lb($$getSqbExpr(sqbLog)),""))
					{	if (joinOp="=") 
						{	set decorrWhr = decorrWhr _ $lb(sqbLog)
						}
						elseif (bestOp="") || (joinOp="'=") ||
						       ((bestOp '= "'=") && (",>,'>,<,'<," [ (","_joinOp_",")))
						{	set:'$d($$$mtHaving(sqb)) bestOp = joinOp
							set bestExpr = sqbLog
						}
					}
					#; if 'sqbPqbJoinOrderIndexed && (joinOp = "=") && ($e($$$mtV($$getSqbExpr(sqbLog)))="f") && (pass = 1)
					#; {
						#; If we find any predicates that support svso, then we will need
						#; to evaluate whether it would be preferrable to flatten and then move  
						#; an sqb table earlier in the join order.  As a heuristic, if we have
						#; a predicate that could potentially be turned into an equijoin, and there 
						#; isn't a useful index on the correlated pqb expression, then we say that
						#; driving the join from sqb with this predicate doesn't look desirable.
						#; This is imprecise because the optimizer can construct a temp index from
						#; other indexes at moderate cost even if an ideal index doesn't exist.
						#;
					#; 	set pqbExpr = $$getPqbExpr(sqbLog)
					#; 	set pqbv = $$$mtV(pqbExpr),coll=""
					#; 	if (($e(pqbv)="v") && 
					#; 		($$$SQLCOLLATIONS[(","_$p($p(pqbv,"^",2),"(",1)_",")) && 
					#; 		($e($$$mtV($p(pqbv,"^",4)))="n")
					#; 	   )
					#; 	{	s coll=$p(pqbv,"^",2),pqbv=$$$mtV($p(pqbv,"^",4)) }
					#; 	set:($e(pqbv)="n") pqbExpr = $p(pqbv,"^",4)
					#; 	if $$usefulIndex(pqb,$lb(pqbExpr),coll)
					#; 	  && ($g($$$mtStatementType)="SEL")	// Don't flatten into the top query block of a DML stmt
					#; 	{
					#; 		set sqbPqbJoinOrderIndexed = 1
					#; 		if $$$mtVType($$$mtV(pqbExpr))="v",$l($p($$$mtV(pqbExpr),"^",3),",")=2		// Single-stream expression
					#; 		{	set str = $p(mt("v",$p($p($$$mtV(pqbExpr),"^",3),",",1)),"^",2)
					#; 			set:$d(mts(pqb,str)) maxStrmCard = max(maxStrmCard, $p(mts(pqb, str),"^",1))
					#; 		}
					#; 	}
					#; }
nextWhrPred
				}
			}
			if '$d($$$mtHaving(sqb))
			{
				set:bestExpr decorrWhr = $lb(bestExpr) _ decorrWhr						
				set:((bestOp="") && (decorrWhr'="")) bestOp = "="
			}
		}
		
		#; If some of the predicates in corrJoinWhr are not in decorrWhr, or if some of the
		#; predicates in corrJoinHav are not in decorrHav, then we need to ensure that there
		#; are no references to the pqb expressions that we are decorrelating in the predicates
		#; that will remain in the subquery.
		#; 
		n pqbExprInPqb,pqbExprInSqb s (pqbExprInPqb,pqbExprInSqb)=""
		if $ll(corrJoinHav)>$ll(decorrHav)
		{	for lj=1:1:$ll(corrJoinHav) 
			{	set sqbLog = $li(corrJoinHav,lj) 
				set pqbExpr = $$getPqbExpr(sqbLog)
				if '$lf(decorrHav,sqbLog) 
				{	s pqbExprInPqb=pqbExprInPqb_$lb(pqbExpr) }
				else 
				{	s pqbExprInSqb=pqbExprInSqb_$lb(pqbExpr) }
			}
		}
		if $ll(corrJoinWhr)>$ll(decorrWhr)
		{	for lj=1:1:$ll(corrJoinWhr) 
			{	set sqbLog = $li(corrJoinWhr,lj) 
				set pqbExpr = $$getPqbExpr(sqbLog)
				if '$lf(decorrWhr,sqbLog) 
				{	s pqbExprInPqb=pqbExprInPqb_$lb(pqbExpr) }
				else 
				{	s pqbExprInSqb=pqbExprInSqb_$lb(pqbExpr) }
			}
		}
 
		#; Verify that the pqb expressions that we intend to decorrelate are not
		#; also referenced by the correlations that will remain in the sqb.  This
		#; could be improved by searching for a subset of decorrelated '=' conditions 
		#; that would still make svso possible but that would eliminate the residual
		#; correlations.
		#;
		if pqbExprInPqb'="" && (pqbExprInSqb'="")
		{	n m,corrToMList,call,pList,disjoint
			set m=pqb, corrToMList="", call="corrToMList^%qaqpre"
			for lj=1:1:$ll(pqbExprInPqb) do lvtree^%qaqpnl("v",$li(pqbExprInPqb,lj))
			for lj=1:1:$ll(corrToMList) s pList($li(corrToMList,lj))=""
			s corrToMList=""
			for lj=1:1:$ll(pqbExprInSqb) do lvtree^%qaqpnl("v",$li(pqbExprInSqb,lj))
			s disjoint=1 for lj=1:1:$ll(corrToMList) if $d(pList($li(corrToMList,lj))) { s disjoint=0 quit }
			if 'disjoint { s doingSvso=0,decorrHav="",decorrWhr="" QUIT }
		}
		
		#; We now know that the set-valued subquery optimization (svso) is possible.
		#; Ordinarily we prefer to do either subquery flattening or subquery to view
		#; transformations (maybe), but in the cases below we prefer svso even if 
		#; flattening is possible.
		#; 
		#; Flattening enables the optimizer to place the subquery tables earlier
		#; in the join order, but svso provides more efficient execution of theta
		#; operators.  Non-indexed high-selectivity theta predicates in the subquery, 
		#; and the absence of indexed low selectivity predicates in the parent query 
		#; block are therefore indications that svso will be the best strategy.
		#; 				
		if ((($ll(decorrWhr)>0) || ($ll(decorrHav)>0))  		// svso is possible to do
		#; 	&& 'sqbPqbJoinOrderIndexed
		#; 	||
		#; 	  ((($$constEql(pqb)="") || (ndxConEql(pqb)=""))  	// no indexable low-selectivity predicate in pqb
		#; 	   &&
		#; 	   ( ((bestOp '= "=") &&							// at least one non-equality operator
		#; 		  (($ll(decorrWhr)+$ll(decorrHav)) >= ($l($$$mtPCorrelatedFields($$$mtP(sqb)),",")-1))	// complete decorrelation is likely
		#; 		)
		#; 		||
		#; 		( (maxStrmCard > 10000) 						// pqb side of the join is large
		#; 		  && ($$qbCard(sqb) > 0)						// statistics exist for this query block
		#; 		  && (maxStrmCard > (100 * $$qbCard(sqb)))		// candidate for semi-join optimization
		#; 		)
		#; 	   )
		#; 	  )
		#;   )
		)
		{
			set doingSvso = 1		// do svso, even if flattening is possible
		}
	}
	Quit
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF005-
qbCard(qb)
    quit 0			// tbd - return the estimated cardinality of the specified query block
getSqbExpr(log)
    quit $s($$$mtLOperator($$$mtL(log))'="!":$$$mtLOperand1($$$mtL(log)),1:$$$mtLOperand1($$$mtL($$$mtLOperand1($$$mtL(log)))))
getPqbExpr(log)
	quit $s($$$mtLOperator($$$mtL(log))'="!":$$$mtLOperand2($$$mtL(log)),1:$$$mtLOperand2($$$mtL($$$mtLOperand1($$$mtL(log)))))
getPqbExprs(logList)
	n i,pqbe s pqbe="" f i=1:1:$ll(logList)  s pqbe=pqbe_$lb($$getPqbExpr($li(logList,i)))
	QUIT pqbe
getJoinOp(log)
    quit $s($$$mtLOperator($$$mtL(log))'="!":$$$mtLOperator($$$mtL(log)),1:$$$mtLOperator($$$mtL($$$mtLOperand1($$$mtL(log)))))
hasORISNULL(log)
    quit ($$$mtLOperator($$$mtL(log))="!")
getFList(outer, qb, logList)
    new fList, lg
    set fList = ""
    for lg=1:1:$ll(logList)
    {
	    set fList = fList _ $lb($s(outer:$$getPqbExpr($li(logList,lg)),1:$$getSqbExpr($li(logList,lg))))
    }
    quit fList
	#; JLF379
	#; New function isCorrExpr, JLF379
isCorrExpr(val)
    n v s v = $$$mtV(val)
	QUIT:"n"=$e(v) 1
	QUIT:$p(v,"^",3)'="," 0
	if $e(v)="v",$l(v,"^")=5 QUIT $$isCorrExpr($p(v,"^",4))
	QUIT 0
	#; JLF379-
constEql(qb)
	#; Returns an "^" separated list of logs in qb where there is a constant = condition 
	#; in the WHERE clause
	#; 
	new lw,log,v,constEqlF
	set constEqlF = ""
	for lw=1:1:$l($g($$$mtWhere(qb)),"^")-1
	{
		s log = $p($$$mtWhere(qb),"^",lw)
		s v = $$$mtL(log)
		if (($e(v)="v") && ($p(v,"^",2) = "=" ))
		{
	#; JLF379
			if (($p(v,"^",4) && ($e($$$mtV($p(v,"^",4)))="f")) && 
				($p(v,"^",5) && '$$isCorrExpr($p(v,"^",5))))
			{
				set constEqlF = constEqlF _ $lb($p(v,"^",4))
			}
			elseif (($p(v,"^",5) && ($e($$$mtV($p(v,"^",5)))="f")) && 
				($p(v,"^",4) && '$$isCorrExpr($p(v,"^",4))))
			{
				set constEqlF = constEqlF _ $lb($p(v,"^",5))
			}
	#; JLF379-
		}
	}
    quit constEqlF
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
usefulIndex(qb,exprList,optColl)
	n i,fvals s fvals=""
	for i=1:1:$ll(exprList)  s:$e($$$mtV($li(exprList,i)))="f" fvals=fvals_$li(exprList,i)_","
	QUIT:fvals="" 0
	QUIT:$$isLinked^%qaqpnl(qb) 0
	QUIT $$indexed^%qaqpre3(qb,fvals)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 
isARowidOf(qbExpr, qb)
    new str, rowid, idifn
	quit:$d($$$mtQbHasForSomeElement(qb)) 0				// there is no rowid on an %ELEMENT subquery
	if ($$$mtVType($$$mtV(qbExpr)) = "f")
	{
		set str = $p($$$mtV(qbExpr),"^",2)
		if $g($$$mtRVirtual(str))
		{
			set rowid = $$$mtPViewIDVal($$$mtP($$$mtRVirtual(str)))
		}
		else
		{
			new m
			set m = $$$mtRQb($$$mtR(str))
			set idifn = $p(mts(qb,str),"^",5)
			set rowid = $$nufld^%qaqpqo(str,idifn)
		}
		quit:(rowid = qbExpr) 1
	}
	quit 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
afterHaving(m)
	#; Returns 1 if query block m contains an %AFTERHAVING clause in any aggregate,
	#; otherwise returns 0
	#; 
	quit:('$d($$$mtP(m)) || '$$$mtPAggList($$$mtP(m))) 0
	new agg, aggList, v
	set v = ""
	set aggList = $$$mtPAggList($$$mtP(m))
	for agg=1:1:$l(aggList,",")-1
	{
		s v = $$$mtV($p(aggList,",",agg))
		i $p(v,"^",4) quit
	}
	quit $s($p(v,"^",4):1,1:0)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 
corrJoin(pqb, sqb, corrEquiJoinWhr, corrEquiJoinHav, corrJoinWhr, corrJoinHav, unseparableCorr, multiRef, sqbRestriction)
 	new a, andList, f, fld, isCorr, joinType, lj, log, lw, nCJoins, pqbv, sqbv, m, v
.
	#; Is there a simple join between pqb and sqb?
	#;
	set corrEquiJoinWhr = ""
	set corrEquiJoinHav = ""
	set corrJoinWhr = ""
	set corrJoinHav = ""
	set unseparableCorr = 0
	set multiRef = 0
	set sqbRestriction = 0
	
	#; Construct corrJoinWhr and corrEquiJoinWhr
	#;
	#; PVA292: combine two loops over mt("w") into one, only calling corrEquiJoinType for logs passing findCorrJoin
	set nCJoins = 0
	for a=1:1:$l($g($$$mtWhere(sqb)),"^")-1 
	{	if $$findCorrJoin($p($$$mtWhere(sqb),"^",a), sqb, pqb, .unseparableCorr)
		{	set corrJoinWhr = corrJoinWhr _ $lb($p($$$mtWhere(sqb),"^",a)) 
		    s log = $p($$$mtWhere(sqb),"^",a)
		    set joinType = $$corrEquiJoinType(log)
		    if (joinType="C") { s nCJoins = nCJoins + 1 } else { s:joinType]"" corrEquiJoinWhr = $lb(joinType,0) }
		}
	}
	s:nCJoins>0 corrEquiJoinWhr = $lb("C",nCJoins)		
		
	#; Construct corrJoinHav and corrEquiJoinHav
	#;
	if ($d($$$mtHaving(sqb)))
	{
		set andList = $$topLevelAnd($$$mtHaving(sqb))
		set nCJoins = 0
		for a=1:1:$l(andList,"^")-1 
		{	if $$findCorrJoin($p(andList,"^",a), sqb, pqb, .unseparableCorr)
			{	set corrJoinHav = corrJoinHav _ $lb($p(andList,"^",a))
				set joinType = $$corrEquiJoinType($p(andList,"^",a))
				if (joinType="C") { s nCJoins = nCJoins + 1 } else { s:joinType'="" corrEquiJoinHav = $lb(joinType,0) }
			}
		}
		s:nCJoins>0 corrEquiJoinHav=$lb("C",nCJoins)
	}
	
	#; Pardon the double-negative below, but stop if we find any reference
	#; to a pqb expression that isn't in corrJoinWhr or corrJoinHav, then 
	#; call this an unseparable correlation with a multi-reference, and quit.
	#;
	#; NOTE!  In testSvso, this implies that if we remove any predicates
	#; from the correlation list, we need to check that doing so does not
	#; leave any dangling references to the pqb
	#;
	for a=1:1
	{	s pqbv = $p($$$mtPCorrelatedFields($$$mtP(sqb)),",",a) q:pqbv=""
		if '$$noOtherReferences^%qaqpre2(sqb, pqbv, corrJoinWhr_corrJoinHav)
		{	s unseparableCorr = 1, multiRef = 1 quit }		; TBD - remove the QUIT because svso can still work in this case, though flattening or subq2view cannot
	}		
		
	#; Find separable correlated join conditions in the top-level ANDs of
	#; the WHERE clause
	#; 
	if ($d($$$mtWhere(sqb)))
	{	
		#; Determine if there are any restrictions in the WHERE clause of the sqb.
		#;
		#; Require unseparableCorr=1 so that we can detect a restriction without the full
		#; overhead of exploring the tree to look for an "n" node.  If unseparableCorr=1,
		#; then we can't have an expression of the pqb plus sqb in the same operand, and if
		#; the predicate is not a join, and one side refreences the sqb, then an expression is
		#; effectively streamless if it refers to no fields in the sqb.  The expression may
		#; refer to a parent query block of pqb, but this would be a constant in this context.
		#;
		if corrJoinWhr'="",'unseparableCorr,'multiRef
		{	
			s sqbRestriction = 0
			for a=1:1:$l($$$mtWhere(sqb),"^")-1
			{	s v = $p($$$mtWhere(sqb),"^",a)
				Continue:$lf(corrJoinWhr,v)						// not a join condition, so must be an uncorrelated restriction of some kind
				s v = $$$mtL(v)
.
				#; Verify that only one field is referenced.
				#;
				if $l($p(v,"^",3),",")>3						// probably more than one distinct field, but check to be sure
				{	s fld=$p($p(v,"^",3),",",2) 				// the first field in the field list
					for f=3:1 q:$p($p(v,"^",3),",",f)'=fld		// exit the loop when we find a different field, or reach the end of the list
					Continue:$p($p(v,"^",3),",",f)'=""			// more than one distinct field in the field list?
				}
.
				Continue:$p(v,"^",2)="'="						// look for an operator other than <> to get some selectivity
				Continue:($e(v)'="v")||($l(v,"^")<6)			// with value arguments, and at least binary argument signature
				Continue:"f"'=$e($$$mtV($p(v,"^",4)))			// operand in piece 4 has the sqb field
				for lj=5:1
				{	quit:$p(v,"^",lj)=""
					continue:"tx"[$e($$$mtV($p(v,"^",lj)))
					quit:(("v"'=$e($$$mtV($p(v,"^",lj))))||($l($p($$$mtV($p(v,"^",lj)),"^",3))>2))
				}
				Continue:lj<$l(v,"^")
				s sqbRestriction = 1
				quit
			}
		}
	}
.
	#; Search for correlations to pqb in the outer join list(s)
	#; 
	set m=pqb, call="isCorrToM^%qaqpre"
	if 'unseparableCorr && $d($$$mtLeftOuterJoins(sqb))
	{	for lj=1:1:$l($$$mtLeftOuterJoins(sqb),",")-1 
		{	do lvtree^%qaqpnl("l",$p($$$mtLeftOuterJoins(sqb),",",lj))
			if isCorr {	set unseparableCorr = 1 quit }
		}
	}
	quit
	
corrEquiJoinType(log) // should only be passed logs normalized and passed by findCorrJoin
	new v, sqbv, pqbv
	s v = $$$mtL(log)
	if (($e(v)="v") && ($p(v,"^",2) = "=" ))
	{	set sqbv = $$$mtV($$getSqbExpr(log))
		set pqbv = $$$mtV($$getPqbExpr(log))
		if (($e(pqbv)="v") &&
			 (($$$SQLCOLLATIONS[(","_$p($p(pqbv,"^",2),"(",1)_","))||($$$ISENCODEDCOLLATE($p($p(pqbv,"^",2),"(",1)))) && 
			 ($e($$$mtV($p(pqbv,"^",4)))="n") 
		   ) {	s pqbv = $$$mtV($p(pqbv,"^",4)) }
		if ($e(pqbv)="n") && ("f" = $e($$$mtV($p(pqbv,"^",4))))
		{	quit $s($e(sqbv)="f":"C",'$$isStreamless(sqbv):"E",1:"")	/* "C" = column, "E" = expression */
		}
		if ($e(pqbv)="n") && ("v" = $e($$$mtV($p(pqbv,"^",4)))) && '$$isStreamless(sqbv) quit "E" // PVA292
	}
	quit ""	
#; PVA292: create isStreamless
isStreamless(v) // Is v a streamless expression?; v is an $$$mtV(...) entry
	RETURN:"txn"[$e(v) 1
  quit:$e(v)="f" 0
  #; YCL124 - Check if subqueries have correlated fields when determine IsStreamless
  if $e(v)="q" quit ($$$mtPCorrelatedFields($$$mtP($p(v,"^",2)))="")	  
  quit:$p(v,"^",3)="," 1
	RETURN:$p(v,"^",3)'="" 0
	#;  $P(3) not assigned yet in ^%qaqpnl, just recurse down  ;  2/5/2024 AK1084
	RETURN:$e(v)="a" 0
	s:$e(v)="e" v="v^EXTFUN:foobar^^"_$tr($p(v,"^",4),",","^")
	n li f li=4:1:$l(v,"^")-1 RETURN:$$findtree^%qaqpnl($e(v),$p(v,"^",li),"f") 0
	RETURN 1
findCorrJoin(log, sqb, pqb, unseparableCorr)
	#; Search for a general correlated join predicate, where one operand of a top-level-AND join
	#;  operator has only fields correlated to pqb and no fields from sqb,
	#;  and the other operand has no correlated fields from pqb.
	#; Let .4 and .5 denote piece 4 and 5 of a join operator that is a top-level AND.  Then we say
	#; that the join correlates sqb to pqb if and only if:
	#;	  corr = (pqb.4 && 'sqb.4 && 'pqb.5) || (pqb.5 && 'sqb.5 && 'pqb.4)
	new call, joinOp, pqb4, pqb5, v
	s v = $$$mtL(log)
	set call = "isCorrToM^%qaqpre"
	if ($e(v)="v") && (",=,>,'>,<,'<,'=," [ (","_$p(v,"^",2)_",") )
	{	set m = pqb, isCorr = ""
		do lvtree^%qaqpnl("v",$p(v,"^",4))	// Is .4 correlated to pqb?
		set pqb4 = isCorr, isCorr = ""
		do lvtree^%qaqpnl("v",$p(v,"^",5))	// Is .5 correlated to pqb?
		set pqb5 = isCorr
		quit:('pqb4 && 'pqb5) ""			// log is not correlated to pqb
		// set:("=" '= $p(v,"^",2)) nonEquiJoin = $s('$d(nonEquiJoin):1,1:nonEquiJoin + 1)
		if (pqb4 && pqb5)
		{	set unseparableCorr = 1			// "unseparable" if pqb is correlated to both sides
			quit ""
		}
		#; If the expression that is correlated to pqb is also correlated to sqb,
		#; then we (currently) say that the expression is not separable.
		#; 
		if ($p($$$mtV($p(v,"^",$s(pqb4:4,1:5))),"^",3)'=",")
		{	set unseparableCorr = 1
			quit ""
		}
		#; Modify log, if necessary, so that the pqb expression is in piece 5 and the sqb 
		#; expression is in piece 4.  We do this now to simplify processing later.
		#; 
		set joinOp = $p(v,"^",2)
		if pqb4
		{	set joinOp = $s(joinOp=">":"<",joinOp="<":">",joinOp="'<":"'>",joinOp="'>":"'<",1:joinOp)
			set $$$mtLOperator($$$mtL(log)) = joinOp
			set $p($$$mtL(log),"^",4,5) = $p(v,"^",5)_"^"_$p(v,"^",4)
		}
		quit 1
	}
	if ($p(v,"^",1,2)="l^!")
	{	n opJoin,opNull1,opNull2,pqbifn1,pqbifn2,sqbifn1,sqbifn2
		#; Allow IS NULL conditions to be on the sqbCol, the pqbCol, or both.  Put the OR subtree
		#; into the normalized form - either:  opJoin OR opNull1
		#; or:  opJoin OR (opNull1 OR opNull2)
		if ($p($$$mtL($p(v,"^",4)),"^",1,2) = "l^!") 
		{	s $p($$$mtL(log),"^",4,5)=$p(v,"^",5)_"^"_$p(v,"^",4),v=$$$mtL(log)
		}
		if ($p($$$mtL($p(v,"^",5)),"^",1,2) = "l^!") 
		{	if ($$$mtLOperator($$$mtL($p(v,"^",4))) = "NULL")
			{	s opNull1=$p(v,"^",4)
				s $$$mtLOperand1($$$mtL(log))=$$$mtLOperand1($$$mtL($p(v,"^",5)))
				s $$$mtLOperand1($$$mtL($p(v,"^",5)))=opNull1
				s v=$$$mtL(log)
				if ($$$mtLOperator($$$mtL($p(v,"^",4))) = "NULL")
				{	s opNull2=$p(v,"^",4)
					s $$$mtLOperand1($$$mtL(log))=$$$mtLOperand2($$$mtL($p(v,"^",5)))
					s $$$mtLOperand2($$$mtL($p(v,"^",5)))=opNull2
					s v=$$$mtL(log)
				}
				else
				{	s opNull2=$$$mtLOperand2($$$mtL($p(v,"^",5)))
				}
			}
			else
			{	s opNull1=$$$mtLOperand1($$$mtL($p(v,"^",5)))
				s opNull2=$$$mtLOperand2($$$mtL($p(v,"^",5)))
			}
		}
		elseif ($$$mtLOperator($$$mtL($p(v,"^",4))) = "NULL")
		{	s opNull1=$p(v,"^",4),opNull2=""
			s $p($$$mtL(log),"^",4,5)=$p(v,"^",5)_"^"_$p(v,"^",4),v=$$$mtL(log)
		}
		else
		{	s opNull1=$p(v,"^",5),opNull2=""
		}
		QUIT:$p($$$mtL(opNull1),"^",1,2)'="v^NULL" 0 
		QUIT:(opNull2&&($p($$$mtL(opNull2),"^",1,2)'="v^NULL")) 0
		s opJoin=$p(v,"^",4)
		QUIT:'$$findCorrJoin(opJoin,sqb,pqb,.unseparableCorr) 0
	#; AK825
		s v=$$$mtL(opJoin)  ;  to correct $$IsNullable() calls below
		#; Verify that the IS NULL conditions are effectively on the join columns
		#;  figure out the fields involved:
		#;  opJoin:pqbifn1=pqbifn2 OR (opNull1:NULL(sqbifn1) [ OR opNull2:NULL(sqbifn2) ] )
		#;  strip collations from all fields
		s pqbifn1=$$$mtV($p(v,"^",4))
		s pqbifn2=$$$mtV($p(v,"^",5))
		#;  strip collations from all fields
		s:$e(pqbifn1)="f" pqbifn1=$p(pqbifn1,"^",1,2)_"^"_+$p(pqbifn1,"^",3)
		s:$e(pqbifn2)="f" pqbifn2=$p(pqbifn2,"^",1,2)_"^"_+$p(pqbifn2,"^",3)
		s sqbifn1=$$$mtV($$$mtLOperand1($$$mtL(opNull1)))
		if opNull2'="" { s sqbifn2=$$$mtV($$$mtLOperand1($$$mtL(opNull2))) } else { s sqbifn2="" }
		s:$e(sqbifn1)="f" sqbifn1=$p(sqbifn1,"^",1,2)_"^"_+$p(sqbifn1,"^",3)
		s:$e(sqbifn2)="f" sqbifn2=$p(sqbifn2,"^",1,2)_"^"_+$p(sqbifn2,"^",3)
		QUIT:opNull2="" ((pqbifn1=sqbifn1) && '$$IsNullable($p(v,"^",5))) ||
			((pqbifn2=sqbifn1) && '$$IsNullable($p(v,"^",4)))
		QUIT ((pqbifn1=sqbifn1) && (pqbifn2=sqbifn2)) ||
			((pqbifn1=sqbifn2) && (pqbifn2=sqbifn1))
	}
	if 'unseparableCorr
	{	set m = pqb, isCorr = ""
		do lvtree^%qaqpnl("l",log)
		set unseparableCorr = isCorr
	}
	quit 0
	
existsToView(pqb, sqb, lgWhr, log, corrJoinWhr, corrJoinHav)
	#; implicit:  mt("dups",m), uniqueBody(m)
	#; 
	new fval, m, tname, str, li, call, r
	new oString, oList, wString		// implicitly set by decorrSubquery
	s $$$mtCorrParentQb(sqb) = $$$mtCorrParentQb(+$$$mtP(sqb))	// Set correlation source, skipping FROM-clause containment of the direct parent
	do decorrSubquery(pqb, sqb, lgWhr, corrJoinWhr, corrJoinHav, 1, "", "")
	#; Remove the EXISTS predicate from the WHERE clause of the parent query block
	#; 
	set $p($$$mtWhere(pqb),"^",lgWhr,lgWhr+1) = $p($$$mtWhere(pqb),"^",lgWhr+1)
	set $$$mtL(log) = "i^existsToView^"_$$$mtL(log)
	#; Create virtual rowid, virtual stream, and virtual fields
	#; 
	s fval = $$$newval("i^newVirtualRowid",1)
	s $$$mtPViewIDVal($$$mtP(sqb)) = fval
	s mt("hint",sqb,"%NOREDUCE")=1 // PVA289
	set m = pqb		
	s tname = "%%Q" _ sqb
	s str=$$nuvstr^%qaqpqo()  			; setup a new virtual stream
	f li=1:1:$ll(oList) d virf^%qaqpqo($$$newval("i^newVirf",1),str,$$nuifn^%qaqpqo())  ;  provide field with virtual ifn
	#; Replace references to sqb outputs with the corresponding virtual stream output
	n toval  ;  change any x to toval(x)
	f li=1:1:$ll(oList) s toval($li(oList,li))=fval+li
	s call="replacetoval^%qaqpre"
	f li=1:1:$l(wString,"^")-1 do lvtreemod^%qaqpnl("l",$p(wString,"^",li))
	#; Add the streamed view to the FROM list of pqb
	#; 
	new streamedViewName
	set streamedViewName = "SQLUSER."_tname
	set $$$mtFromTableName( pqb_"^"_streamedViewName) = tname
	set $$$ptrel(pqb_"^"_streamedViewName)=str  // PVA099: $$$mtFromList() not valid in preopt, 
	                                         #;    while ptrel is crucial to maintain
	#;  remove pqb correlated fields from $$$mtPActiveQbs,$p(4), and $p(3) of "q" node  ;  AK1023
	s $$$mtPCorrelatedFields($$$mtP(sqb))=$$remove^%qaqpmod($$$mtPCorrelatedFields($$$mtP(sqb)),$p($$$mtV($$$mtPQbVal($$$mtP(sqb))),"^",3))
	s $$$mtV($$$mtPQbVal($$$mtP(sqb)))="q^"_sqb
	#; Fix up all the field-related information in query block pqb, and its subqueries
	s m = pqb do flds^%qaqpnl
	s m = sqb do flds^%qaqpnl
	d logopt^%qaqpagg("existsToView",$lb(pqb,sqb,str,oList))
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
replacetoval ;  $$: return toval(val) if defined, recurse down with lvargm
	#;  lvtreemod() callback, coming in with type,val,v,ev
	i type="v",$d(toval(val)) { RETURN toval(val) }
	GOTO lvargm^%qaqpnl
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
decorrSubquery(pqb, sqb, lgWhr, corrJoinWhr, corrJoinHav, creatingStreamedView, corrListW, corrListH)
	new vfrid, m, ml, li, lj, mtList, nConj, sqbLog, sqbExpr, pqbExpr, call, corrList
	
	s corrListH = ""
	s corrListW = ""
	
	#; Implicit outputs
	#; 
	set oList = ""
	set oString = ""
	set wString = ""
	k $$$mtTopArg(sqb) // PVA195
 
	#; Move to the SELECT list each HAVING-clause expression of sqb that is joined to a
	#; correlated expression of pqb, and move the join from sqb to pqb
	s call="n2f^%qaqpre",corrList=""
	for li=1:1:$ll(corrJoinHav)
	{	set sqbLog  = $li(corrJoinHav,li)
		set pqbExpr = $$getPqbExpr(sqbLog)
		set sqbExpr = $$getSqbExpr(sqbLog)		
		set oString = oString _ sqbExpr _ ","		// add sqbExpr to the sqb SELECT list
		set oList = oList _ $lb(sqbExpr)
		set wString = wString _ sqbLog  _ "^"		// move the join to pqb WHERE clause
		#; Add sqb join expressions to the DISTINCT BY clause
		#; 
		if ($$$mtVType($$$mtV(sqbExpr)) = "a") && ('$p($$$mtV(sqbExpr),"^",6) && '$d($$$mtGroupDistinctList(sqb)) && (($ll(corrJoinHav) + $ll(corrJoinWhr)) = 1))
		{	set singletonSelect(sqb) = 1
			set $$$mtOneRow(sqb) = 1
		}	
		#; Remove the reference to sqbLog from the sqb HAVING clause
		#; 
		set mtList = $lb($lb(sqbLog)), nConj = 1
		if ($$$mtHaving(sqb) = sqbLog) { k $$$mtHaving(sqb) } else { s $$$mtHaving(sqb) = $$PruneUnaryANDOR("l",$$$mtHaving(sqb),1) }
		#; Remove correlations to pqb
		do lvtreemod^%qaqpnl("l",sqbLog)
	}
	s corrListH=corrList,corrList=""
	#; Move to the SELECT list each WHERE-clause expression of sqb that is joined to a
	#; correlated expression of pqb, and move the join (sqbLog) from sqb to pqb.
	#;
	for li=1:1:$ll(corrJoinWhr)
	{	set sqbLog  = $li(corrJoinWhr,li)
		set pqbExpr = $$getPqbExpr(sqbLog)		
		set sqbExpr = $$getSqbExpr(sqbLog)
		set oString = oString _ sqbExpr _ ","		// add sqbExpr to the sqb SELECT list
		set oList = oList _ $lb(sqbExpr)
		set wString = wString _ sqbLog  _ "^"		// move the join to pqb WHERE clause
		#; Remove the reference to sqbLog from the sqb WHERE clause
		#; 
		for lj=1:1:$l($$$mtWhere(sqb),"^")-1
		{	if ($p($$$mtWhere(sqb),"^",lj) = sqbLog) { s $p($$$mtWhere(sqb),"^",lj,*)=$p($$$mtWhere(sqb),"^",lj+1,*) q }
		}
		#; Remove correlations to pqb in the pqbExpr
		do lvtreemod^%qaqpnl("l",sqbLog)
	}
	s corrListW = corrList
	set $$$mtOutputVals($$$mtOutput(sqb)) = oString
	#; Generate a unique name for each output
	#; 
	s $$$mtAlphaUpAliases(sqb) = ""
	f li=1:1:$ll(oList) s $$$mtAlphaUpAliases(sqb) = $$$mtAlphaUpAliases(sqb) _ $lb("%%Out"_$li(oList,li))
	s:$d($$$mtAlphaUpAliases(sqb)) $$$mtAliases(sqb) = $$$mtAlphaUpAliases(sqb)
 
	#; Add DISTINCT to the outputs of sqb, unless we can guarantee in some
	#; other way that sqb's outputs will be distinct, for example if the only
	#; non-aggregated output is the rowid of the only stream in sqb.
	#; 
	#; The creatingStreamedView flag enables the subquery to view optimization to DISTINCT
	#; its outputs and moves the correlated predicates to the WHERE clause of pqb, while 
	#; the set-valued subquery optimization doesn't need to DISTINCT its outputs, (because 
	#; the subquery caching mechanism makes sqbExpr distinct), and the predicate is made
	#; part of the subquery operator rather than being moved into the parent query block.
	#; 
	if (creatingStreamedView)
	{	new ridlist set ridlist=$$makeRowidList(pqb)
		set $$$mtWhere(pqb) = $g($$$mtWhere(pqb)) _ wString				// move predicates to pqb WHERE clause
		if (singletonSelect(sqb) || uniqueBody(sqb)) { set mt("dups",sqb)=$$$SQLDONTCAREDUPS }
		else {
			set oString=""  ;; dedup and remove rowids from oList, convert to "x," list
			for li=1:1:$ll(oList) set:'$lf(ridlist,li)&&(","_oString'[","_$li(oList,li)_",") oString=oString_$li(oList,li)_","
			if oString'="" {
				set mt("dups",sqb) = $$$SQLELIMINATEDUPS
				set:'$d($$$mtDistinct(sqb)) $$$mtDistinct(sqb)=oString
				set:'($d($$$mtOutput(sqb)) || $d($$$mtOutput(sqb)) && ($$$mtOutputDistinct($$$mtOutput(sqb)) '= "d")) $$$mtOutputDistinct($$$mtOutput(sqb))="d"
				set:'$d($$$mtGroupDistinctList(sqb)) $$$mtGroupDistinctList(sqb)=oString
			}
		}
 		do addDistinctBy(sqb,pqb,ridlist,0,corrJoinWhr,corrJoinHav)
	}	
	quit
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	
flattenExists(pqb, sqb, lgWhr, elements, parentLog, corrJoinWhr="", corrJoinHav="")
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- 
	#; 
	#; log	 - (implicit input) log of the [NOT]EXISTS predicate
	#; pqb 	 - parent query block
	#; sqb	 - subquery query block
	#; lgWhr - position of [NOT]EXISTS log in mt("w",pqb)
	#; elements	- TRUE if this is an %ELEMENT subquery, else FALSE
	#; parentLog - the log that has log as an operand, if any, when lgWhr=0
	#; 
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- 
	new arglist,call,corrList,distinctBy,i,label,lv,m,mlbl,newlbl,newmlbl,output,pseudoOref,rid,str,subqLog,subqVal,v,val,whrCorr
		 
	#; Remove all correlations between pqb and sqb, but remember correlations in the WHERE clause.
	#; Note that if sqb contains a correlated reference through a collation function, then the
	#; result will also remove the correlation function and will point directly to the equivalent
	#; collated field.
	set call = "n2f^%qaqpre"
	set corrList = ""
	if $d($$$mtWhere(sqb)) for subqLog=1:1:$l($$$mtWhere(sqb),"^")-1 do lvtreemod^%qaqpnl("l",$p($$$mtWhere(sqb),"^",subqLog))
	set whrCorr = corrList
	
	if elements { k $$$mtAlphaUpAliases(sqb),$$$mtFromTableName(sqb_"^"_$lg($g($$$mtFromList(sqb)))),$$$mtFLabelsQbNode(sqb) s $$$mtFromList(sqb)="" GOTO commonPart }
	
	if $d($$$mtLeftOuterJoins(sqb)) for subqLog=1:1:$l($$$mtLeftOuterJoins(sqb),",")-1 do lvtreemod^%qaqpnl("l",$p($$$mtLeftOuterJoins(sqb),"^",subqLog))
	
	#; PVA092: clerically fix for new mt("ON",) structure, but then disable because
	#;         tested state of code never reached mt("j") model for this; further
	#;         this should really happen after xfrmON, whence mt("ON") won't exist but 
	#;         mt("j") will. 
	if $d($$$mtHaving(sqb)) do lvtreemod^%qaqpnl("l",$$$mtHaving(sqb))
	if $d($$$mtOutput(sqb)) && $$$mtOutputVals($$$mtOutput(sqb)) { for subqVal=1:1:$l($$$mtOutputVals($$$mtOutput(sqb)),",")-1 do lvtreemod^%qaqpnl("v",subqVal) }
	
	s str="" for  // PVA348: Only needed for lateral, but harmless to do for all
	{  s str=$o($$$mtTvfParams(str),1,arglist) q:str=""  
	   continue:($$$mtRQb($$$mtR(str))'=sqb || (arglist=$c(0)))
	   for i=1:1:$ll(arglist) {s val=$lg(arglist,i) s:val $li(arglist,i)=$$lvtreemod^%qaqpnl("v",val) }
	   s $$$mtTvfParams(str)=arglist
	}
					
	#; We are about to convert the sqb correlations to pqb joins, so we must ensure that either the result
	#; has the correct join multiplicity, or that the result is distinct by the rowids of pqb
	#;
	set distinctBy = $$makeRowidList(pqb)
	do addDistinctBy(sqb,pqb,distinctBy,$s($$$mtPAggList($$$mtP(sqb))'="":1,1:0),corrJoinWhr,corrJoinHav)
 
	
	#; Move the aggregates of sqb, if any, into pqb.  DISTINCT BY the rowids of sqb, unless
	#; the aggregate in sqb already included a DISTINCT BY, and add all WHERE-clause 
	#; correlations from pqb to the %FOREACH (GROUP BY) clause of each aggregate of sqb
	#;
	if ($$$mtPAggList($$$mtP(sqb)))
	{	set $$$mtPAggList($$$mtP(pqb)) = $$$mtPAggList($$$mtP(pqb)) _ $$$mtPAggList($$$mtP(sqb))
		set distinctBy = $$makeRowidList(sqb)
		do augmentAgg(sqb, whrCorr, distinctBy, 0)
	}
 
	#; If sqb has a HAVING clause, AND the root of $$$mtHaving(sqb) to $$$mtHaving(pqb)
	#; 
	if ($d($$$mtHaving(sqb)))
	{	if ('$d($$$mtHaving(pqb)))
		{	set $$$mtHaving(pqb) = $$$mtHaving(sqb)
		}
		else
		{	do nulog^%qaqpnl("l^&^^"_$$$mtHaving(pqb)_"^"_$$$mtHaving(sqb)_"^")
			set $$$mtHaving(pqb) = log		// check this...  changed 7/21/2004
		}
		kill $$$mtHaving(sqb)		// finished with $$$mtHaving(sqb)
	}
			
	#; Update labels in sqb if they are non-unique in pqb
	#;	
	f i=1:1:$ll($g($$$mtFromList(sqb))) {
		s label=$li($$$mtFromList(sqb),i)
		continue:'$lf($$$mtFromList(pqb),label)
		s mlbl=sqb_"^"_label
		continue:'$d($$$ptrel(mlbl))
		s newlbl=label_"_%FE"_$$$ptrel(mlbl),newmlbl=sqb_"^"_newlbl
		s $li($$$mtFromList(sqb),i)=newlbl
		s $$$mtFromTableName(newmlbl)=$$$mtFromTableName(mlbl) k $$$mtFromTableName(mlbl)
		s $$$ptrel(newmlbl)=$$$ptrel(mlbl) k $$$ptrel(mlbl)
	}
			
	#; Merge sqb FROM list into the FROM list of pqb
	#;	
	set $$$mtFromList(pqb) = $g($$$mtFromList(pqb)) _ $g($$$mtFromList(sqb))
	set $$$mtFromList(sqb) = ""
	set str = $o($$$mtFromTableName(""))
	while (str)
	{	if ($p(str,"^",1) = sqb) 
		{	set $$$mtFromTableName(pqb _"^"_$p(str,"^",2,*)) = $$$mtFromTableName( str)
			kill $$$mtFromTableName( str)
		}
		set str = $o($$$mtFromTableName(str))
	}
	kill $$$mtAlphaUpAliases(sqb)
		
	#; Migrate the streams in the sqb FROM clause to the pqb FROM clause
	#; 
	for str=1:1:$$getNodeCount("r") 
	{	if ($$$mtRQb($$$mtR(str))=sqb) 
		{ 
			#; PVA091: maintain ptrel as well as $$$mtR()
			s label=$$strtoname^%qaqpre2(str)
			s $$$ptrel(pqb_"^"_label)=str
			k $$$ptrel(sqb_"^"_label)
			set $$$mtRQb($$$mtR(str)) = pqb 
		}
	}
 
commonPart    
    for lv=1:1:$$$mtPNumQbs // PVA271: repoint subqueries in sqb
    {  continue:'$$$mtPQbIsActive(lv)
       s:+$$$mtP(lv)=sqb $$$mtPQbParent($$$mtP(lv))=pqb
       s:$$$mtCorrParentQb(lv)=sqb $$$mtCorrParentQb(lv)=pqb
    }
    
    #; Merge complexlog list from sqb into pqb
	set mt("complexlog",pqb) = $g(mt("complexlog",pqb))_$g(mt("complexlog",sqb))
	kill mt("complexlog",sqb)
.
	#; Merge the data in $$$mtP(sqb) into the parent, $$$mtP(pqb)
	#; 		piece 3: list of aggregate function nodes (not needed here, by restriction)
	s $$$mtPQbIsActive(sqb)=0
	#; Remove the EXISTS predicate from the WHERE clause of the parent query block
	#; 
	set:lgWhr>0 $p($$$mtWhere(pqb),"^",lgWhr,lgWhr+1) = $p($$$mtWhere(pqb),"^",lgWhr+1)
	set $$$mtL(log) = "i^flattenExists^"_$$$mtL(log)
			
	#; Move all predicates from the sqb WHERE clause to the pqb WHERE clause
	#; 
	if $d($$$mtWhere(sqb)) 
	{	if parentLog
		{	s $$$mtLOperand1($$$mtL(parentLog))=$$$mtWhere(sqb) }
		else
		{	s $$$mtWhere(pqb) = $g($$$mtWhere(pqb)) _ $$$mtWhere(sqb) }
		k $$$mtWhere(sqb)
	}
	
	#; Migrate outer joins in the subquery
	#; 
	if $d($$$mtLeftOuterJoins(sqb)) { s $$$mtLeftOuterJoins(pqb) = $g($$$mtLeftOuterJoins(pqb)) _ $$$mtLeftOuterJoins(sqb) k $$$mtLeftOuterJoins(sqb) }
 
	#; Handle streamless conditions in the subquery
	#; 
	if $d($$$mtStreamlessConds(sqb)) { s $$$mtStreamlessConds(pqb) = $g($$$mtStreamlessConds(pqb)) _ $$$mtStreamlessConds(sqb) k $$$mtStreamlessConds(sqb) }
 
	#; Merge the ptj {join} array from sqb to pqb, then kill ptj(sqb,1)
	#; 
	if $d(ptj(sqb,1)) 
	{	s $p(ptj(pqb,1),"^",2) = $p($g(ptj(pqb,1)),"^",2) _ $e($p(ptj(sqb,1),"^",2),2, $l(ptj(sqb,1)))
		k ptj(sqb,1)
	}
 
	#; Replace sqb references with pqb references in mt("vtr", pseudoOref) and $p(ptv(val),"^",$$$PTVQB)
	#; 
	for pseudoOref=1:1:$$getNodeCount("vtr") { if $$$VTRgetqno(pseudoOref)=sqb { set $$$VTRqno(pseudoOref)=pqb } }
	set val = $o(ptv(""))
	while val
	{	set:($p($g(ptv(val)),"^",$$$PTVQB) = sqb) $p(ptv(val),"^",$$$PTVQB) = pqb
		set val = $o(ptv(val))
	}
			
	#; Move mts(sqb, stream) => mts(pqb, stream)
	#; 
	set str = $o(mts(sqb,""))
	while str
	{	merge mts(pqb,str) = mts(sqb,str)
		kill mts(sqb,str)
		set str = $o(mts(sqb,str))
	}
 
	#; Fix up all the field-related information in query block pqb, and its subqueries
	#; 
	s m = pqb
	// EEE045: we have to re-calculate singletonSelect(m) here since flattening an EXISTS into a JOIN adds a new
	// stream to the query block that potentially makes it a non singleton SELECT anymore (if the added stream has
	// no equality conditions on its unique fields)
	set singletonSelect(m) = $$isSingletonSelect(m)
	set uniqueBody(m) = singletonSelect(m) || $$singletonGroups(m)
	do flds^%qaqpnl
	if 'elements && ($$isShardedTop^%qaqpnl(sqb)||$$isShardedTop^%qaqpnl(pqb)) {d shardown^%qaqpnl(pqb)} // PVA342: modify rule for when to call shardown
	d logopt^%qaqpagg("flattenExists",$lb(pqb,sqb))
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
joinedToDistinctColumn(sqb, corrJoinWhr, corrJoinHav)
	QUIT:((corrJoinWhr="") && (corrJoinHav="")) 0
	QUIT:singletonSelect(sqb) 1
	QUIT:'uniqueBody(sqb) 0
	
	#; Since 'singletonSelect(sqb) && uniqueBody(sqb), we can infer that sqb preserves
	#; a unique key.  Return TRUE if and only if the join is on a unique column of sqb
	#;
	QUIT:(corrJoinHav'="") 0				; could be generalized to handle this case
	QUIT:$$numstr^%qaqpnl(sqb)'=1 0			; could be generalized to handle this case
	QUIT:$ll(corrJoinWhr)'=1 0				; could be generalied to handle this case
	QUIT $$isARowidOf($$getSqbExpr($li(corrJoinWhr,1)), sqb)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
addDistinctBy(sqb,pqb,distinctBy,afterHaving,corrJoinWhr,corrJoinHav)
	if (mt("dups",pqb) = $$$SQLPRESERVEDUPS) && 
	   ((corrJoinWhr'="") || (corrJoinHav'="")) &&
	   '$$joinedToDistinctColumn(sqb, corrJoinWhr, corrJoinHav)
	{	set mt("dups",pqb) = $$$SQLELIMINATEDUPS
		
		#; Add the distinctBy list to the mt("distinct",*) and $$$mtGroupDistinctList(*) nodes, if and only if
		#; no DISTINCT BY is currently present, and set mt("o",*) piece 1 to "d" (for "DISTINCT")
		#; 
		if ('$d($$$mtDistinct(pqb))) 
		{	set $$$mtDistinct(pqb) = ""			// >=v5.1 DISTINCT BY representation
			n rid f rid=1:1:$ll(distinctBy) s $$$mtDistinct(pqb) = $$$mtDistinct(pqb) _ $li(distinctBy,rid) _ ","
		}
 
		if ('$d($$$mtOutput(pqb)) || $d($$$mtOutput(pqb)) && ($$$mtOutputDistinct($$$mtOutput(pqb)) '= "d")) { set $$$mtOutputDistinct($$$mtOutput(pqb)) = "d" }
		if ('$d($$$mtGroupDistinctList(pqb))) { s $$$mtGroupDistinctList(pqb) = "" f rid=1:1:$ll(distinctBy) s:((","_$$$mtGroupDistinctList(pqb)) '[ (","_$li(distinctBy,rid)_",")) $$$mtGroupDistinctList(pqb) = $$$mtGroupDistinctList(pqb) _ $li(distinctBy,rid) _ "," }
	}
 
	#; For each duplicate-sensitive aggregate in pqb, add distinctBy to the default 
	#; DISTINCT BY column set in "^" piece 7, if piece 7 does not already exist.
	#; If sqb contains aggregates also, then move pqb aggregate evaluation %AFTERHAVING
	#; Exception: if sqb is scalar subquery, then no DISTINCT is required
	#; 								
	s:'$d(singletonSelect(sqb)) singletonSelect(sqb) = $$isSingletonSelect(sqb) 
	do:'singletonSelect(sqb) augmentAgg(pqb, "", distinctBy, afterHaving)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	 
augmentAgg(m, forEach, distinctBy, afterHaving)
	new lv,v,db,aggVal,fe,aggVal
	if ($$$mtPAggList($$$mtP(m)))				// parent has aggregates?
	{	for lv=1:1:$l($$$mtPAggList($$$mtP(m)),",")-1
		{	set aggVal = $p($$$mtPAggList($$$mtP(m)),",",lv)
			set v = $$$mtV(aggVal)
			f fe=1:1:$ll(forEach) {	s:((","_$p(v,"^",6)) '[ (","_$li(forEach,fe)_",")) $p(v,"^",6) = $p(v,"^",6) _ $li(forEach,fe) _ "," }
			if ($p(v,"^",2) = "min") || ($p(v,"^",2) = "max")
			{	set $p(v,"^",7) = ""		// Remove DISTINCT BY on min or max, if present
			}
			elseif ($p(v,"^",7) = "")
			{	f db=1:1:$ll(distinctBy) {	s:((","_$p(v,"^",7)) '[ (","_$li(distinctBy,db)_",")) $p(v,"^",7) = $p(v,"^",7) _ $li(distinctBy,db) _ "," }
			}
		
			set:(afterHaving) $p(v,"^",4) = "1"
			set $$$mtV(aggVal) = v
		}
	}
	quit
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
makeRowidListOfView(m)
	#; Requirement: m produces a view.
	#; Otherwise, check the select fields of m contains all the IDs of all the referenced streams of m
	#; if so, return stream IDs, otherwise just use the view id.
	n str,strid,selectfields
	n idval,vid,found
	
	#; selectfields is comma separate (pre and post)
	s selectfields = $$$mtOutputVals($g($$$mtOutput(m)))
	s strid = ""
	s vid = $$$mtPViewIDVal($$$mtP(m))
	f str=1:1:$$getNodeCount("r") {
		i ($$$mtRQb($$$mtR(str)) = m){ 
			s idval = $$getidval^%qaqpre2(str), found = 0
			f i=1:1:$l(",",selectfields)-1 {
				i $p(selectfields,i)=idval {
					s strid = strid_$lb(vid + i), found = 1 QUIT
				}
			}
			//Didn't find one of the needed row ID's, use the %VID
			i 'found RETURN $lb( vid ) 
		} 
	}
	RETURN strid  
#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
makeRowidList(m)
	#;  returns a $list of rowids of the tables in the FROM clause of query block m
	#;  but skip tables in nodupt=$LIST(str) generating no duplicates
	n nodupt s nodupt="" d nodupt(m),logopt^%qaqpagg("nodupt",m_":"_$listtostring(nodupt)_","):nodupt'=""
	new rowidList, str, val, idifn, rowid
	set rowidList = ""
	for str=1:1:$$getNodeCount("r")
	#;  nodupt applies only for id list to be used for DISTINCT  ;  AK974
	{	if ($$$mtRQb($$$mtR(str)) = m),'$lf(nodupt,str)
		{	if $g($$$mtRVirtual(str))
			{	
				#; HSU276+: if the SELECT list of the qb:$$$mtRVirtual(str) contains all the IDs of all the streams,we
				#; could use these IDs, insteafd of vid.
				#; Restriction: none of these streams is view. Otherwise, still use vid.	
				#;s rowidList = rowidList _ $lb($$$mtPViewIDVal($$$mtP($$$mtRVirtual(str)))) 
				s rowidList = rowidList _ $$makeRowidListOfView($$$mtRVirtual(str))
				#; HSU276-
			}
			else
			{	s idifn=$p(mts(m,str),"^",5)			// the ifn of the rowid of stream str
				s rowid = $$nufld^%qaqpqo(str,idifn)
				s rowidList = rowidList _ $lb(rowid)
			}
		}
	}
	quit rowidList
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nodupt(m)  ;  [public: nodupt,nulstr] set nodupt=$LIST(str) within m  ;  AK974
	#;  that generate no duplicates, e.g. (str.reqf IS NULL) (only possible
	#;  with OJ);  also if (str.%ID=?) or (str.uniqf=?)
	n mtjlr,f4,rstr,lstr,li,log,ptlg,rf,v
	#;  preprocess mt("j") into mtjlr(lstr,rstr) for (lstr LOJ rstr) in m
	f li=1:1:$L($g($$$mtLeftOuterJoinsRoot),",")-1 {
		s log=$p($$$mtLeftOuterJoinsRoot,",",li),ptlg=$$$mtL(log),f4=$$$mtV($p(ptlg,"^",4)),rstr=$p($$$mtV($p(ptlg,"^",5)),"^",2)
		i $e(f4)="f",$$$mtRQb($$$mtR(rstr))=m { s mtjlr($p(f4,"^",2),rstr)="" }
	}
	f li=1:1:$L(logs,"^")-1 {  ;  logs set in transformExists - original pqb WHERE
		s log=$p(logs,"^",li),ptlg=$$$mtL(log)
		CONTINUE:($e(ptlg,1,7)'="v^NULL^")&&($e(ptlg,1,4)'="v^=^")
		s rf=$p(ptlg,"^",4),v=$$$mtV(rf),rstr=$p(v,"^",2)
		CONTINUE:$e(v)'="f"
		i $e(ptlg,1,7)="v^NULL^",$lf(nulstr,rstr),$$ddreqv(rf,rstr) { d ojspan(rstr) }
		#;  *** generalize to multi-field IDKEY, and to UNIQUE field(s)
		i $e(ptlg,1,4)="v^=^",$p(mts(m,rstr),"^",5)=$p(v,"^",3),$$isStreamless($$$mtV($p(ptlg,"^",5))) { s nodupt=nodupt_$lb(rstr) }
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ojspan(str)  ;  [public: nodupt] $$:  $LIST(str), as well as any  ;  AK974
	#;  R in mtjlr(L,R) if L is already on the list, recursively
	n lstr s lstr="",nodupt=nodupt_$lb(str)
	f  s lstr=$o(mtjlr(str,lstr)) q:lstr=""  d ojspan(lstr)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddreqv(fval,str)  ;  $$:  1 if fval, which is a field in stream str,  ;  AK974
	#;  is required (NOT NULL), ignoring any OJ at the fval/str level;
	#;  if str is a view, check within the view SELECT-list to see
	#;  if the returned fval couldn't be NULL
	n qb s qb=$g($$$mtRVirtual(str))  ;  if not a view, see if required
	RETURN:'qb $$ddreqi^%qaqpqo(+$$$mtR(str),+$p($$$mtV(fval),"^",3))
	s fval=fval-$$$mtPViewIDVal($$$mtP(qb))  ;  position within view SELECT-list
	RETURN:'fval 1  ;  %VID
	s fval=$p($$$mtOutputVals($$$mtOutput(qb)),",",fval),v=$g($$$mtV(+fval))
	RETURN:$e(v)="f" $$ddreq^%qaqpnl(fval)  ;  see if required field
	RETURN:$e(v)="t" v'="t^"  ;  constant other than NULL
	RETURN 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getNodeCount(type)
	quit $o(mt(type,""),-1)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
isCorrToM	; called with type, val, v, ev, isCorr
	#; If we find a correlation to pqb, do an early exit, else recurse down and quit from lvarg^%qaqpnl
	#; 
	if ("n"=ev) 
	{	set:'isCorr isCorr=$$n2m(v,m)  ;  $$nIsCorrTo(type,val,v,ev,m)
		QUIT
	}
	goto lvarg^%qaqpnl
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
corrToMList	; called with type, val, v, ev, isCorr
	#; If we find a correlation to pqb, do an early exit, else recurse down and quit from lvarg^%qaqpnl
	#; 
	if ("n"=ev) 
	{	set:$$n2m(v,m) corrToMList = $g(corrToMList)_$lb($p(v,"^",4))
		QUIT
	}
	goto lvarg^%qaqpnl
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
n2f	;  $$: return x (if from subquery pqb) for a "n"->x node;
	#;  return COLL(f) (if from subquery pqb) for a COLL("n"->f) node
	#;  lvtreemod() callback, coming in with type,val,v,ev
	#;  also collect corrList=$LB(val) of the new nodes
	i ev="n",$$n2m(v,pqb) { s corrList=corrList_$lb($p(v,"^",4)) RETURN $p(v,"^",4) }
	i (($$$SQLCOLLATIONS[(","_$p($p(v,"^",2),"(",1)_","))||($$$ISENCODEDCOLLATE($p($p(v,"^",2),"(",1)))) {
		n nv s nv=$$$mtV($p(v,"^",4))
		i $e(nv)="n",$$n2m(nv,pqb),$$n2uncoll(nv) {
			s corrList=corrList_$lb($$coll^%qaqpqo($p(nv,"^",4),$p(v,"^",2)))
			RETURN $li(corrList,*)
		}
	}
	GOTO lvargm^%qaqpnl
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
n2m(v,qn)  ;  $$: 1 if "n" node v refers to a qn field, is an expression
	s v=$$$mtV($p(v,"^",4))  ;  of qn fields, or a streamless expression
	RETURN:"f"=$e(v) $$$mtRQb($$$mtR($p(v,"^",2)))=qn
	RETURN:"xt"[$e(v) 1  ;  streamless
	s v=$p(v,",",2)  ;  first field in $P(3) field comma-list
	RETURN:'v 1  ;  streamless
	RETURN $$$mtRQb($$$mtR($p($$$mtV(v),"^",2)))=qn
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
n2uncoll(v)  ;  $$: 1 if "n" node v refers to an uncollated field
	s v=$$$mtV($p(v,"^",4))
	RETURN:"f"'=$e(v) 0  ;  not a field
	RETURN:v'["_" 1  ;  uncollated
	RETURN:$l(v,"_")=3 0  ;  collated with %ANYOF
	RETURN v["_%ANYOF"  ;  collection element, not collated
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF001
buildCanonical(type, val, returnOperandList, unboundStreams, suppressGB)
	new canonExpr, lv, operandList, op, v, ev, operandV, p9
	quit:val="" """"
	set v=mt(type,val),ev=$e(v)
	set canonExpr = ""
	if ("f"=ev) 	
	{	new strm, c
		set strm = $p(v,"^",2)
		set c=$s($p(v,"_",2)'="%ANYOF":$p(v,"_",2),1:""),c=$s(c="":"",c="%ALPHAUP":"A",c="%UPPER":"U",c="%MVR":"MV",c="%SPACE":"S",c="%PLUS":"P",c="%MINUS":"M",c="%MVR":"MV",c="%STRING":"T",c="%SQLSTRING":"SS",c="%SQLUPPER":"SU",c="%TRUNCATE":"TR",c["%STRING(":"T("_$p(c,"(",2),c["%SQLSTRING(":"SS("_$p(c,"(",2),c["%SQLUPPER(":"SU("_$p(c,"(",2),c["%TRUNCATE(":"TR("_$p(c,"(",2),1:c)
		if $$$ISENCODEDCOLLATE(c),$e(c)="%" {set c = $e(c,2,*)}
		QUIT +$p(v,"^",3)_c_$s((unboundStreams=-1)||$lf(unboundStreams, strm):"."_strm,1:"")
	}
	elseif ("t"=ev) { QUIT ($length(v)-2)_"#"_$e(v,3,*) }
	elseif ("x"=ev) { QUIT "#" _ v }
	elseif ("n"=ev) { QUIT "#" _ ev _ $p(v,"^",4) }
	elseif ("s"=ev) { QUIT $$buildCanonical("v",$p(v,"^",4),0,unboundStreams,suppressGB) }
	elseif ("q"=ev) { QUIT "#" _ ev _ val }		// tbd - canonical expr for subquery
	elseif ("e"=ev)
	{	set canonExpr = "e#" _ $p(v,"^",5,6) _ "("
		s v=$p(v,"^",4) f lv=1:1:$l(v,",")-1 { set canonExpr = canonExpr _ $s(lv=1:"",1:",")_$$buildCanonical("v",$p(v,",",lv),0,unboundStreams,suppressGB) }
		QUIT canonExpr _ ")"
	}
	elseif ("a"=ev)
	{	set op = $p(v,"^",2)
		set canonExpr = op _ "("
		set canonExpr = canonExpr _ $s('$p(v,"^",5):"*",1:$$buildCanonical("v",$p(v,"^",5),0,unboundStreams,suppressGB))
		set:$p(v,"^",4) canonExpr = canonExpr _ ":AH"		// Evaluate after HAVING clause
		set:$p(v,"^",6) canonExpr = canonExpr _ ":GB="
		f lv=1:1:$l($p(v,"^",6),",")-1 { set canonExpr = canonExpr _ $s(lv=1:"",1:",")_$$buildCanonical("v",$p($p(v,"^",6),",",lv),0,unboundStreams,suppressGB) }
		i $p(v,"^",7),op'="min",op'="max" {
			s canonExpr = canonExpr _ ":DB="
			f lv=1:1:$l($p(v,"^",7),",")-1 { set canonExpr = canonExpr _ $s(lv=1:"",1:",")_$$buildCanonical("v",$p($p(v,"^",7),",",lv),0,unboundStreams,suppressGB) }
		}
		set p9=$p(v,"^",9) // $p9 can be either a val (JSON_OBJECTAGG only) or LIST(val#,) for UDAF
		f lv=1:1:$s(p9[",":$l(p9,",")-1,1:1) {
			set canonExpr = canonExpr _","_$$buildCanonical("v",$p(p9,",",lv),0,unboundStreams,suppressGB)
		}
		QUIT canonExpr _ ")"
	}
	elseif ("vl"[ev)
	{	set operandList = ""
		set op = $p(v,"^",2)
		for lv=4:1:$l(v,"^")-1
		{	if (",+,*,!,&," [ (","_op_","))
			{	set operandV = mt(ev,$p(v,"^",lv))
				if (($p(operandV,"^",1) = "v") && ($p(operandV,"^",2) = op))
				{	set operandList = operandList _ $$buildCanonical(ev,$p(v,"^",lv),1,unboundStreams,suppressGB)
				}
				else
				{	set operandList = operandList _ $lb($$buildCanonical(ev,$p(v,"^",lv),0,unboundStreams,suppressGB))
				}
			}
			elseif ((op = ">") || (op = "'>"))
			{	set canonExpr = $$buildCanonical(ev,$p(v,"^",lv),0,unboundStreams,suppressGB)_$s(lv>4:","_canonExpr,1:"")
			}
			else
			{	set canonExpr = canonExpr _ $s(lv>4:",",1:"")_$$buildCanonical(ev,$p(v,"^",lv),0,unboundStreams,suppressGB)
			}
		}
		// If this a commutative operator, then sort the operandList
		if ('returnOperandList)
		{	new orderedOperands, operand, truncLen, truncOp
			set truncLen = 85
			if (",+,*,!,&," [ (","_op_","))
			{	set canonExpr = "" 
				for lv=1:1:$ll(operandList) set orderedOperands($e($li(operandList,lv),1,truncLen),$i(orderedOperands($e($li(operandList,lv),1,truncLen)))) = lv
				set truncOp = $o(orderedOperands(""))
				while(truncOp '= "")
				{	for lv=1:1:orderedOperands(truncOp) { set canonExpr = canonExpr _ $s(canonExpr="":"",1:",") _ $li(operandList,orderedOperands(truncOp,lv)) }
					set truncOp = $o(orderedOperands(truncOp))
				}
			}
			set op = $s(op=">":"<",op="'>":"'<",1:op)
 			set:(op = "%SQLUPPER") op = "%SU"			// To compress space, since this is common
			set canonExpr = op _ "(" _ canonExpr _ ")"
		}									
	}
	QUIT $s(returnOperandList:operandList,1:canonExpr)	
	#; JLF001-
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
factorCommonAnds(m, log, obyOpt)
	n topOR, orNode, conjuncts, commonConj, andNode, i,j,k,curOR,curAND, mtList, newConj, nConj, ORLevel, ccpos, ANDLevel
	n sortVal,sortCol,lbFound,ubFound,nlFound,lbound,ubound,lbAllEq,ubAllEq,ORISNULL,noFactor set lbound="",ubound="",lbFound="",ubFound="",nlFound="",lbAllEq=1,ubAllEq=1,ORISNULL="",noFactor=""
	
	#; We expect to be called on an OR node.  If this is not the case, then quit.
	#; 
	quit:(($$$mtLType($$$mtL(log)) '= "l") || ($$$mtLOperator($$$mtL(log)) '= "!")) 
	set mtList="",nConj=0,conjuncts="",commonConj="",ORLevel=1,topOR=log,orNode(ORLevel)=topOR
	#; JLF018
	#; ORDER BY predicate factorization.  topLog must be in the outermost qb,
	#; an ORDER BY must exist, piece 3 must reference the first ORDER BY column,
	#; and topOR must be in the mt("w",1) list.
	#;
	quit:(($$hint("%NOFACTORANDFROMOR",m)&&'obyOpt)||($$hint("%NOFACTORORDERBYOR",m)&&obyOpt))
	#; JLF018-
	#; PVA183: Extend obyOpt to ORDER BY in subqueries. 
	if obyOpt
	{	s sortVal=+$g($$$mtSequencersQb(m)) s:'sortVal&&(m=1) sortVal=+$g($$$mtSequencers)
	    if sortVal &&($$$mtLColVals($$$mtL(topOR))[(","_sortVal_","))&&($find("^"_$g($$$mtWhere(m)),"^"_topOR_"^")'=0) 
		{	set sortCol = ","_sortVal_"," quit:$e($g($$$mtV(sortVal)))'="f" }
		else 
		{	quit }
	}
FCAAddDisjunct
	s curOR=$$$mtL(orNode(ORLevel))
	s ORLevel=ORLevel-1			; pop parent off stack before processing children
	f i=4:1:$l(curOR,"^")-1
	{	s:(lbFound=1) lbFound="" 
		s:(ubFound=1) ubFound=""
		s nlFound=""
		if $$$mtLOperator($$$mtL($p(curOR,"^",i))) = "!"
		{	s orNode($i(ORLevel))=$p(curOR,"^",i) continue }
		elseif $$$mtLOperator($$$mtL($p(curOR,"^",i))) = "&"
		{	s ANDLevel=1,andNode(ANDLevel)=$p(curOR,"^",i),conjuncts=""	
FCAAddConjunct
			s curAND=$$$mtL(andNode(ANDLevel))
			s ANDLevel=ANDLevel-1			; pop parent before processing children
			f j=4:1:$l(curAND,"^")-1
			{	if $$$mtLOperator($$$mtL($p(curAND,"^",j))) = "&"
				{	s andNode($i(ANDLevel)) = $p(curAND,"^",j) continue }
				else
				{	if obyOpt
					{	do factorRange($p(curAND,"^",j),sortCol,sortVal,.lbound,.ubound,.lbFound,.ubFound,.nlFound,.lbAllEq,.ubAllEq,.ORISNULL) }
					else
					{	s newConj = $$buildCanonical("l",$p(curAND,"^",j),0,-1,"")
						s ccpos = $s(nConj:$lf(commonConj, newConj),1:0)
						if nConj = 0
						{	if $lf(conjuncts,newConj)=0
							{	s conjuncts=conjuncts_$lb(newConj)
								s mtList=mtList_ $lb($lb($p(curAND,"^",j)))
							}
						}
						elseif ccpos>0 	; add this conjunct to the equivalence list at ccpos
						{	if $lf(conjuncts,newConj)=0
							{	s conjuncts=conjuncts_$lb(newConj)
								s $li(mtList,ccpos) = $li(mtList,ccpos) _ $lb($p(curAND,"^",j)) 
							}
						}
					}
				}
			}		; End of AND-leg loop
			#; If we encountered nested AND(&) nodes, process them now
			g:ANDLevel>0 FCAAddConjunct
		}
		else
		{ ; Handle a non-AND, non-OR predicate here
			if 'obyOpt
			{	s conjuncts = conjuncts_$lb($$buildCanonical("l",$p(curOR,"^",i),0,-1,""))
				s:(nConj = 0) mtList = mtList _ $lb($lb($p(curOR,"^",i)))
			}
	#; JLF018
			else
			{	do factorRange($p(curOR,"^",i),sortCol,sortVal,.lbound,.ubound,.lbFound,.ubFound,.nlFound,.lbAllEq,.ubAllEq,.ORISNULL) 
			}
	#; JLF018-
		}
 
		#; ORDER BY predicate factorization applies only if a lower/upper bound predicate
		#; is found in every OR leg.  If no lb/ub predicate was found in this leg, then stop.
		#; Exception: if sortVal IS NULL is found on this OR leg with no other reference to sortVal,
		#; then keep going.  If there is another reference to sortVal, then it must be a range.
		#; 
		if obyOpt
		{	if '(nlFound && 'lbFound && 'ubFound)	; sortVal IS NULL with no other reference to sortVal is ok
			{	s:lbFound="" lbFound=0		; no lower bound predicate was found in this OR leg, so turn off lb factorization
				s:ubFound="" ubFound=0		; no upper bound predicate was found in this OR leg, so turn off ub factorization
				if ('lbFound && 'ubFound && 'nlFound) { s noFactor=1 quit }
			}
		}
		else
		{	d FCAIntersectConjuncts
			if nConj=0 { s noFactor=1 quit } 		; quit the OR leg loop
		}
	}		; End of OR-leg loop
 
	if noFactor'=1
	{
		#; If we encountered nested OR(!) nodes, process them now
		g:ORLevel>0 FCAAddDisjunct 
 
		#; Finally, if we found a factorable AND condition, then factor it and AND it to the OR node
		d FCARewriteMT
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-		
FCARewriteMT
	#; commonConj is now a $list that contains the factorable conjuncts inside the OR
	if (nConj > 0)
	{	new i, pos, factoredOR
		s factoredOR = $$PruneUnaryANDOR("l",topOR,1)
		if ('factoredOR) 
		{	set pos = $find("^"_$$$mtWhere(m),"^"_topOR_"^")-1
			set:pos $$$mtWhere(m) = $e($$$mtWhere(m),1,pos-$l(topOR)-2)_$e($$$mtWhere(m),pos,*)
		}
		for i=1:1:nConj s $$$mtWhere(m)=$$$mtWhere(m)_$li($li(mtList,i))_"^"
	}
 
	#; JLF018 - ORDER BY optimization
	#; 
	if obyOpt && '(lbAllEq && ubAllEq)
	{	n log,i
		if lbFound && (lbound'="")
		{	set lbound = $$$newval("v^SET:SETOF^,^"_lbound,1) d lflds^%qaqpnl("v",lbound,"do")
 
			if 1 ; 'lbAllEq
			{	s lbound = $$$newval("v^MINSET^"_$p($$$mtV(lbound),"^",3)_"^"_lbound_"^",1)
				Set val=$$$newlog("v^'<^"_sortCol_$p($p($$$mtV(lbound),"^",3),",",2,32767)_"^"_sortVal_"^"_lbound_"^")
			}
			else 
			{	Set val=$$$newlog("v^IN^"_sortCol_$p($p($$$mtV(lbound),"^",3),",",2,32767)_"^"_sortVal_"^"_lbound_"^") }
			if ORISNULL
			{	s log=val Set val=$$$newlog($$$mtL(ORISNULL))
				d nulog^%qaqpnl("l^!^"_sortCol_$p($p($$$mtV(lbound),"^",3),",",2,32767)_"^"_log_"^"_val_"^") 
			}
			else
			{	d addlog^%qaqpnl(val) }
			s ptres(log,","_topOR_",")="",seladj(topOR,","_log_",")=log // PVA279: seladj
			d complexlog^%qaqpnl(m, log)
		}
		if ubFound && (ubound'="") && '(lbFound && (lbound'="")) //PVA279: make sure only one used
		{	
	#; JLF103
			#; Implement a chewing-gum "fix" to the WIDE CHAR problem: we still have no way to know at
			#; run time if we're running on a UNICODE or 8-bit system, but at least we will generate the
			#; wide $$$mtV(*) node only if the optimization actually applies.
			#;
			if $find(ubound,"$")'=0
			{	
.
	#; JLF414
				n i,v,ub 
				f i=1:1 { s v=$p(ubound,"^",i) q:v=""  i $l(v,"$")=2 s $p(ubound,"^",i)=$$$newval("v^%SW2LE^,^"_$p(v,"$",2)_"^",1) }
	#; JLF414-
			}
	#; JLF103-
			set ubound = $$$newval("v^SET:SETOF^,^"_ubound,1) d lflds^%qaqpnl("v",ubound,"do")
			if 'ubAllEq
			{	s ubound = $$$newval("v^MAXSET^"_$p($$$mtV(ubound),"^",3)_"^"_ubound_"^",1) 
				Set val=$$$newlog("v^'>^"_sortCol_$p($p($$$mtV(ubound),"^",3),",",2,32767)_"^"_sortVal_"^"_ubound_"^") 
			}
			elseif 1 ; 'lbAllEq	; if lbAllEq, then the lb condition is identical to the ub condition
			{	Set val=$$$newlog("v^IN^"_sortCol_$p($p($$$mtV(ubound),"^",3),",",2,32767)_"^"_sortVal_"^"_ubound_"^")
				s $p(ptl,"^",log)="c"
			}
			if ORISNULL 
			{	s log=val Set val=$$$newlog($$$mtL(ORISNULL))
				d nulog^%qaqpnl("l^!^"_sortCol_$p($p($$$mtV(ubound),"^",3),",",2,32767)_"^"_log_"^"_val_"^")
			}
			else
			{	d addlog^%qaqpnl(val) }
			s ptres(log,","_topOR_",")="",seladj(topOR,","_log_",")=log // PVA279: seladj
			d complexlog^%qaqpnl(m,log)
		}
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-		
FCAIntersectConjuncts
	#; conjuncts is now a $list of canonical expressions in the current OR leg.  Use this
	#; as a filtering condition against all the other OR legs.  Every AND condition that exists
	#; in all OR legs can be factored out and ANDed to the OR.
	if (nConj = 0) { s commonConj = conjuncts, nConj = $ll(commonConj) }
	else
	{ 
		#; Intersect commonConj with conjuncts
		for k=nConj:-1:1
		{
			#; If the k'th commonConj is not in the current list of conjuncts, then it is
			#; not common to all OR terms, so remove it from the commonConj list
			#; 
			if ('$lf(conjuncts,$li(commonConj,k)))
			{	s $li(commonConj,k) = $li(commonConj,nConj)
				s $li(commonConj,nConj) = ""			// not strictly necessary, but tidy
				s $li(mtList,k) = $li(mtList,nConj)
				s $li(mtList,nConj) = ""				// not strictly necessary, but tidy
				s nConj = nConj - 1
			}
		}
	}
	s conjuncts=""
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-		
	#; JLF018
factorRange(conjunct,sortCol,sortVal,lbound,ubound,lbFound,ubFound,nlFound,lbAllEq,ubAllEq,ORISNULL)
	n v,op,ub
	#; when piece 3 references only sortCol, put log1 and log2 into the 
	#; form where piece 4 contains the val of piece 3:
	s v = $$$mtL(conjunct)
	quit:($p(v,"^",3)'[sortCol)
	
	#; Allow for the special case ((sortVal IS NULL) OR ... )
	if $p(v,"^",2)="NULL"
	{	if $p(v,"^",4)=sortVal { s ORISNULL=conjunct,nlFound=1 }
		QUIT
	}
 
	#; Allow for the special case ((sortVal rangeOp expr OR sortVal IS NULL) AND ...) OR (...)
	#; 
	if ($p(v,"^",2)="!")
	{	
		#; Remove duplicates, if any, from piece 3 of the OR, then verify that the OR references ONLY
		#; sortCol.  Subsequent tests for sortCol in pieces 4 and 5 can then use [ rather than "="
		#;
		if $l($$$mtLColVals($$$mtL(conjunct)),",")>3 { s $$$mtLColVals($$$mtL(conjunct))=","_$$distlist^%qaqcpr($e($$$mtLColVals($$$mtL(conjunct)),2,*)) }
		quit:$$$mtLColVals($$$mtL(conjunct))'=sortCol
 
		#; Verify that one side is (sortVal IS NULL), then see if the other side is a factorable range
		#;
		if ($$$mtLOperator($$$mtL($p(v,"^",4)))="NULL")&&($$$mtLColVals($$$mtL($p(v,"^",4)))[sortCol)
		{	s conjunct=$p(v,"^",5),ORISNULL=$p(v,"^",4),nlFound=1 }
		elseif ($$$mtLOperator($$$mtL($p(v,"^",5)))="NULL")&&($$$mtLColVals($$$mtL($p(v,"^",5)))[sortCol)
		{	s conjunct=$p(v,"^",4),ORISNULL=$p(v,"^",5),nlFound=1 }
		else
		{	quit }
		s v=$$$mtL(conjunct)
		quit:($p(v,"^",3)'[sortCol)	; Succeed.  We have sortVal IS NULL with no other reference to sortVal
	}
	
	#; Allow for the redundant special case (range AND sortVal IS NOT NULL)
	#; 
	if ($p(v,"^",2)="&")
	{
		#; Verify that one side is (sortVal IS NOT NULL), then see if the other side is a factorable range
		#;
		if ($$$mtLOperator($$$mtL($p(v,"^",4)))="'NULL")&&($$$mtLColVals($$$mtL($p(v,"^",4)))[sortCol)
		{	s conjunct=$p(v,"^",5) }
		elseif ($$$mtLOperator($$$mtL($p(v,"^",5)))="'NULL")&&($$$mtLColVals($$$mtL($p(v,"^",5)))[sortCol)
		{	s conjunct=$p(v,"^",4) }
		else
		{	s nlFound="" quit }		; Fail.  There is another non-range reference to sortVal
		s v=$$$mtL(conjunct)
		quit:($p(v,"^",3)'[sortCol)	; Succeed - no other references to sortVal
	}
 
	if ($e(v)="v")&&(($p(v,"^",4)=sortVal)||($p(v,"^",5)=sortVal))
	{	s op = $p(v,"^",2)
		if sortVal=$p(v,"^",5) && (",'>,'<,= ," [ (","_op_","))
		{	s $p(v,"^",5)=$p(v,"^",4),$p(v,"^",4)=sortVal
			s op=$$reflectOp(op),$p(v,"^",2)=op
			s $$$mtL(conjunct) = v
		}
 
		if lbFound'=0&&((",>,'<,=,%STARTSWITH,IN," [ (","_op_",")) && (op '= "<"))
		{	s lbound = lbound_$p(v,"^",5,*),lbFound=1 s:"IN,="'[op lbAllEq="" }
		if ubFound'=0&&((",<,'>,=,%STARTSWITH,IN," [ (","_op_",")) && (op '= ">")) 
		{	if op = "%STARTSWITH" 
			{ 
				#; %STARTSWITH 'WA' should generate an upper bound of 'WB', but instead we use the same approximation
				#; as is used in %qaqcky for %STARTSWITH descending: we append the highest char to the end of the
				#; string (twice here), and hope that we don't see this pattern in the data.
				s ub = $p(v,"^",5)
				s ubound = ubound_"$"_ub_"^"	; mark it with "$" so we can gen the ub later
			}
			else
			{	s ubound = ubound_$p(v,"^",5,*) }
			s:"IN,="'[op ubAllEq=""
			s ubFound=1
		}
	}
	s:(nlFound && 'lbFound && 'ubFound) nlFound=""		; Fail:  we found sortVal IS NULL OR x, but x is not a sortVal range
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
reflectOp(op)
	QUIT $s(op=">":"<",op="'>":"'<",op="<":">",op="'<":"'>",op="=":"=",1:"Program Error")
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF018-
PruneUnaryANDOR(type,val,boolValue)
    #;  called with mtList, nConj
    #;  
    #;  mtList contains a list of nConj lists of mt vals.  Each val in this
    #;  list is to be factored out of an AND, and replaced with TRUE.  The
    #;  TRUE not explicitly placed into the tree#; rather, the TRUE leg is
    #;  propagated up through the Boolean tree.
    #;  
    #;  a pruned conjunct appears inside an AND node, and the AND node may
    #;  either go away completely or may just be modified.  Since all AND
    #;  nodes are binary, if one of the legs is factored, then the other
    #;  leg replaces the AND, and if both legs are factored, then the other
    #;  sibling replaces the parent if the parent is an AND or or the entire
    #;  parent is replaced by TRUE if the parent is an OR.
    #;  
    #;  boolValue is the value to substitute for matching vals, so if we are
    #;  factoring out AND terms, we replace them with boolValue=1, whereas if
    #;  we are replacing (x IS NULL) where x is not nullable, then boolValue="" or 0
    #;  
    new v, ev, commentText, call
    set v = mt(type, val), commentText="PruneUnaryANDOR", call="commentOut^%qaqpre"
    set ev = $e(v)
	if "v"=ev
	{	s v=val f ev=1:1:$ll(mtList)  { if $lf($li(mtList,ev),val) { s v="" q } } quit v
	}
	elseif ("l" [ ev) && (",&,!," [ (","_$p(v,"^",2)_","))
    {	new newOpn1, newOpn2, jj
	    
	    #; If one of the factored conditions is referenced from this l or v node,
	    #; then remove the reference from the current node.
	    set newOpn1 = $p(v,"^",4)
	    set newOpn2 = $p(v,"^",5)
	    for jj=1:1:nConj
	    { if ($lf($li(mtList,jj), newOpn1)) set newOpn1 = ""
			  if ($lf($li(mtList,jj), newOpn2)) set newOpn2 = ""
	    }
	    set newOpn1 = $s(newOpn1:$$PruneUnaryANDOR(ev, $p(v,"^",4), boolValue),1:"")
	    set newOpn2 = $s(newOpn2:$$PruneUnaryANDOR(ev, $p(v,"^",5), boolValue),1:"")
	    if ('newOpn1 && 'newOpn2) 
	    { d lvtree^%qaqpnl(type, val)
	    	QUIT "" 
	    }
	    if (newOpn1 && newOpn2)
	    {
		    new valList, distinctVals, ii, alreadyInList
			
			#; Combine the field lists and make them distinct
			set valList = $p(mt(type,newOpn1),"^",3) _ $e($p(mt(type,newOpn2),"^",3),2,*)
			set distinctVals = ","
			for ii=2:1:$l(valList,",")-1
			{ set alreadyInList = 0
				for jj=2:1:$l(distinctVals,",")-1 if ($p(valList,",",ii) = $p(distinctVals,",",jj)) { set alreadyInList = 1 quit }
				if ('alreadyInList) set distinctVals = distinctVals _ $p(valList,",",ii) _ ","
			}
			set $p(mt(type,val),"^",3) = distinctVals		    
			set $p(mt(type,val),"^",4) = newOpn1
			set $p(mt(type,val),"^",5) = newOpn2				
			set $$$mtRedoFields = 1 // Used by redoFields^%qaqpre2()
			quit val
	    }
	    #; exactly one child is non-null (which means "always evaluates to <boolValue>".  
	    #; When boolValue=1, if this is an AND node, then mark the current node inoperative 
	    #; and return whichever operand is non-null.  If this is an OR node, then the entire 
	    #; OR can be removed (since one if its legs is always TRUE).  When boolValue=0, the
	    #; role of AND and OR is reversed.
	    #; 	    
	    d:('newOpn1 || ('boolValue && ($p(v,"^",2)="&"))) lvtree^%qaqpnl(ev,$p(v,"^",4))
	    d:('newOpn2 || ('boolValue && ($p(v,"^",2)="&"))) lvtree^%qaqpnl(ev,$p(v,"^",5))
	    set mt(type,val) = "i^"_commentText_$e(mt(type,val),2,*) 
		set $$$mtRedoFields = 1 // Used by redoFields^%qaqpre2()
	    quit:($p(v,"^",2)=$s(boolValue=1:"!",1:"&")) ""	   	
	    quit $s(newOpn1:newOpn1,1:newOpn2)
    }
	quit val
commentOut
	QUIT:("ftsxiq"[ev)
	
	if ((type="l")&&("vl"[ev)) 
	{	n kk,found s found=0
	
		#; The first log in each mtList element (each element is a list) is
		#; referenced by FCARewriteMT, so don't comment out the log if it is
		#; the first item in an mtList element, and don't recurse to comment
		#; out its operands, since we will reuse val when it gets factored out.
		#; 
		for kk=1:1:nConj { if val=$li($li(mtList,kk)) { s found=1 continue }}
		QUIT:found
	}
	do lvarg^%qaqpnl  //  recurse down, then return back a list of arguments in retVal	
	s:((type="l")&&("vl"[ev)) mt(type,val) = "i^"_commentText_$e(mt(type,val),2,*),$$$mtRedoFields = 1 // Used by redoFields^%qaqpre2()
	QUIT   
IsNullable(mtVIndex)
	n v
	set v = $$$mtV(mtVIndex)
	QUIT:($e(v)="f") '$$ddreq^%qaqpnl(mtVIndex)
	QUIT:($e(v)="n") $$IsNullable($p(v,"^",4))
	QUIT:($e(v)="v" && (($$$ISENCODEDCOLLATE($p($p(v,"^",2),"(",1)))||($$$SQLCOLLATIONS[(","_$p($p(v,"^",2),"(",1)_",")))) $$IsNullable($p(v,"^",4))
	if $e(v)="t" QUIT v="t^"
	#; Otherwise, assume that it could be nullable
	QUIT 1
	
	#; JLF007
#; This function does not require the fieldlist in piece 3 to be initialized
ansiAgg
	QUIT:foundNonStdAgg
	QUIT:("ftsxiq"[ev)
	if ("a"=ev)
	{   n aggcol,aggfun s aggcol=$p(v,"^",5),aggfun=$p(v,"^",2)
		set:($p(v,"^",7)&&(aggfun="min")||(aggfun="max")) $p(v,"^",7) = ""
		#; An eligible aggregate must group by the same columns as are in the GROUP BY clause, must not appear AFTER HAVING,
		#; and must either have no DISTINCT BY clause, or its DISTINCT BY clause must be equal to the agg operand: SUM(DISTINCT x)
		#; 
		if ($p(v,"^",6) '= $g($$$mtGroupDistinctList(m))) || ($p(v,"^",4) '= "") || (($p(v,"^",7) '= "") && ($p(v,"^",7) '= ($p(v,"^",5)_",")))
		{	s foundNonStdAgg = 1
		}
		
		#; Special case: if there is an aggregate with no GROUP BY, then according to SQL rules we have
		#; an implicit GROUP BY <const> and we return one row.  Cache SQL extensions provide for the
		#; ability to return an aggregate on each row, and in this extended case only, '$d(mt("onerow",m))
		#;
		if '$d($$$mtGroupDistinctList(m))&&'$d($$$mtOneRow(m)) { s foundNonStdAgg = 1 }
		QUIT
	}	
 
	do lvarg^%qaqpnl  //  recurse down the tree
	QUIT
	
#; This function requires flds to have filled in the field lists in piece 3
createMtsAGG	;  called with type,val,v,ev, m
	; n valsave s valsave=val
	; QUIT:("ftsxiq"[ev)
	if ("a"=ev)
	{	n aggcol,aggfun,aggList s aggcol=$p(v,"^",5),aggfun=$p(v,"^",2),aggList=val_","
 
		#; Push the aggregation operator below the operand, if this enables an
		#; index to be exploited for performing the aggregation.
		#; 
		if (aggfun="sum") && $p(v,"^",5) && (",+,-," [ (","_$p($$$mtV($p(v,"^",5)),"^",2)_",")) && 
		(""'=$p($g($$$mtV($p(v,"^",5))),"^",5)) &&		; not a unary minus  JLF102
		(($e($$$mtV($p($$$mtV($P(v,"^",5)),"^",4)))="f") && ($e($$$mtV($p($$$mtV($P(v,"^",5)),"^",5)))="f"))
		{
			#; There is a linear function of aggregation operations.  If none of the fields
			#; in the expression are nullable, and if a bitslice index exists on each one,
			#; then we push the aggregation operator down.  We could handle (fld + const) by
			#; simply changing the && to || above.
			#; 
			new optimizable,fldList,vli,nuval,aggPos
			set optimizable = 1
			set fldList = $p($$$mtV($p(v,"^",5)),"^",3)
			for vli=2:1:$l(fldList,",")-1 { if $$IsNullable($p(fldList,",",vli)) || '$$bitsliced($p(fldList,",",vli)) s optimizable = "" quit }
			s aggList = $$$mtPAggList($$$mtP(m))
			s aggPos = $find(","_aggList,","_val_",") - 2 - $l(val)
			if optimizable && (aggPos > 0)
			{
				#; Convert agg(op(arg4, arg5)) => op(agg(arg4),agg(arg5)) { swap nodes in-situ }
				#; 
				s nuval = $$$newval($p(v,"^",1,4)_"^"_$p($$$mtV($p(v,"^",5)),"^",4)_"^"_$p(v,"^",6,*),1)
				s $$$mtV(val) = "v^"_$p($$$mtV($p(v,"^",5)),"^",2)_"^"_$p(v,"^",3)_"^"_nuval_"^"_$p(v,"^",5)_"^"
				s $$$mtV($p(v,"^",5)) = $p(v,"^",1,4)_"^"_$p($$$mtV($p(v,"^",5)),"^",5)_"^"_$p(v,"^",6,*)
				
				#; Replace the reference to val in $$$mtP(m) with the vals of the two new aggregates
				s $e(aggList,aggPos,$l(val)) = nuval_","_$p(v,"^",5)
				s $$$mtPAggList($$$mtP(m)) = aggList
			}
			else
			{	s aggList = val_","
			}
		}
		
		#; Create an mts AGG node for each SQL-standard aggregate
		#; 
		f vli=1:1:$l(aggList,",")-1
		{	s v = $$$mtV($p(aggList,",",vli))
			set:'$d(mts("AGG",m,$s('$p(v,"^",5):"*",1:$p(v,"^",5)),$p(aggList,",",vli))) mts("AGG",m,$s('$p(v,"^",5):"*",1:$p(v,"^",5)),$p(aggList,",",vli)) = $p(v,"^",2)
		}
	}
	; s v = $$$mtV(valsave)
	; s ev = $e(v)		
	do lvarg^%qaqpnl  //  recurse down the tree
	QUIT
bitsliced(val)
	quit 1			  // until we have mv's, assume its always bitsliced	
	#; JLF007-
nestedCorrToPqb(sqb,pqb)
	n ssqb,corrFlds,fPos,retval	; a query block that is a subquery or view of query block sqb
	set retval = ""
	for ssqb=2:1:$$$mtPNumQbs
	{
		if $$$mtPQbIsActive(ssqb) && (+$$$mtP(ssqb)=sqb)
		{
			set corrFlds = $$$mtPCorrelatedFields($$$mtP(ssqb))
			for fPos=1:1:$l(corrFlds,",")-1		; trailing comma
			{
				if $$$mtRQb($$$mtR($p($$$mtV($p(corrFlds,",",fPos)),"^",2))) = pqb { set retval = 1 QUIT }
			}
		}
	}
    QUIT retval
dropMtsMaps()
	n m,str
	#; PVA191: transformExists may obsolete a query for which dummy mts map
	#;         nodes were created. To clean these up, this loop should NOT
	#;         filter on $$$mtPQbIsActive(m))
	f m=1:1:$$$mtPNumQbs  f str=1:1:maxs k:$d(mts(m,str,"CON")) mts(m,str,"CON") k:$d(mts(m,str,"MAP")) mts(m,str,"MAP")
	quit
createMtsMaps()
 	if $$$mtPNumQbs>1
 	{
		n str, mname, conF, cf
		f m=1:1:$$$mtPNumQbs i $$$mtPQbIsActive(m) s conF(m)=$$constEql(m),ndxConEql(m)=""
		#; PVA191: eliminate set of ptfjoo which isn't used and should be set here
		s mname=""  ; --- get maps info for each stream, field --------
		
		n v,m,imp,smdimp
		s str=""
		for
		{	s str=$o($$$mtR(str),1,v) q:str=""  s irn=+v,m=$p(v,"^",2)
			continue:(m=0 || $d($$$mtRVirtual(str)))
			for
			{	s mname=$o($$$smd(1,irn,"map",mname)) q:mname=""
				s imp=""
				for
				{	s imp=$o($$$smd(1,irn,"map",mname,imp)) q:imp=""
					continue:($$$smdMapConditional(imp)'="N")
					s ilev=0,smdimp=imp
					for ns=1:1 
					{	s ilev=$o($$$smd(12,imp,6,ilev)) q:'ilev
						s sub=ilev_$c(1)_$$$smdMSFieldIfn(smdimp,ilev)_$c(1)_$$$smdMSConstant(smdimp,ilev)_$c(1)_$$$smdMSFunction(smdimp,ilev)_$c(1)_$$$smdMSExpression(smdimp,ilev)
						i ($p(sub,$c(1),3)'="")	continue				;  constant
						i ($p(sub,$c(1),5)'?.e1"{".n1"}".e)	continue	;  constant expression
						s mts(m,str,"MAP",imp,ns) = $p(sub,$c(1),2)		;  just copy the field ifn
						quit											;  done - we only look at the first non-constant subscript anyway
					}
				}
			}
		}
 
		#; The ndxConEql(m) tests, which require the maps to be set up, caused an undesirable side 
		#; effect: namely, that ptv(v) for an %ANYOF ifn would be set to point to an mts entry, which
		#; was shortly thereafter thrown away, leaving ptv(v) pointing to a non-existent mts entry.
		#; Need to analyze the necessity of the ndxConEql test, but for now act as though we have no
		#; knowledge that there might be a useful index on a conEql condition in the subquery.
		// f str=1:1:maxs d maps^%qaqpqo1
		f m=1:1:$$$mtPNumQbs i $$$mtPQbIsActive(m) && (conF(m)'="") i $$usefulIndex(m,conF(m),"") s ndxConEql(m) = 1
		k conF
 	}
	quit
containsDistinctKey(dist) n li,val,str,ifn,red s red=""  ;  $$: red = LIST(val,),
	#;  a subset of dist=LIST(val,) reduced to an equivalent list -
	#;  if dist contains a key of T, remove any other T fields
	#;      red(str) = LIST(val,) of fields from the stream in dist
	#;      red(str,ifn) = val#  for any field in dist
	n nulstr s nulstr=""	// for present purposes, if b.id is in nulstr, we can still consider stream b distinct
	f li=1:1:$l(dist,",")-1 s val=$p(dist,",",li),str=$$$mtV(val) s:$e(str)'="f" red=red_val_"," i $e(str)="f" { s ifn=$p(str,"^",3),str=$p(str,"^",2),red(str)=$g(red(str))_val_"," s:'$$IsNullable^%qaqpre(val) red(str,ifn)=val }
	f str=1:1:maxs i $d(red(str))>=10 d findCollKey(str) s red=red_red(str)
	QUIT red
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
findCollKey(str) n irn,extent,info,kn  ;  see if any of the keys for str can help	// DPV2060 (extent,info)
	QUIT:$g($$$mtRVirtual(str))  ;  virtual (could theoretically go deeper...)
	s irn=+$$$mtR(str),extent=$$$smdExtent(1,irn)
	QUIT:$$collKey($$$smdRowIDField(1,irn),0)  		//  try rowid
	QUIT:$$collKey($$$smdRowIDLogicalFields(1,irn),0)  	//  try idkey (if exists)
 		#; Lock the class to make sure it is not currently being compiled
	new %class set %class=$$$smdClassname(1,irn)
	s kn=""  //  try all keys
	For  {
		s kn=$o($$$EXTCONS($$$pEXT,extent,kn)) q:kn=""  
		s info=$$$EXTCONSsqlinfo($$$pEXT,extent,kn)
		i kn'="%ROWID","UNIQUE PKEY"[$li(info,2),$$collKey($li(info,3),1) q
	}
	new %ts1,%ts2
	set %ts1=$$$smd(1,irn,33),%ts2=$g($$$comClassKeyRaw(%class,$$$cCLASStimechanged))
	do:(%ts1'=%ts2) error("150a")	// Error message uses variable %class,%ts1,%ts2
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
collKey(keyFldList,names) n keyPiece,ifn  ;  $$: 1 if all of keyFldList are in dist, if so also reset red(str) to include only the key
	QUIT:keyFldList="" 0  ;  nothing passed in
	n coll,fldOfKey,irn,ttype,v s irn=+$$$mtR(str),ttype=$$$smdTType(irn),fldOfKey=""
	f keyPiece=1:1 
	{	s fldOfKey=$p(keyFldList,",",keyPiece) q:fldOfKey=""  
		s ifn = $s(names:$$$smdGetIfn(1,irn,fldOfKey),1:fldOfKey)
		s v=$$$smdColCollation(ttype,irn,ifn)
		s coll=$s(v="A":"%ALPHAUP",v="U":"%UPPER",v="S":"%SPACE",v="P":"%PLUS",v="M":"%MINUS",v="MV":"%MVR",v="E":"",v="MV":"%MVR",v="T":"%STRING",v="SS":"%SQLSTRING",v="SU":"%SQLUPPER",v="TR":"%TRUNCATE",v["T(":"%STRING("_$p(v,"(",2),v["SS(":"%SQLSTRING("_$p(v,"(",2),v["SU(":"%SQLUPPER("_$p(v,"(",2),v["TR(":"%TRUNCATE("_$p(v,"(",2),1:v)
		if $$$ISENCODEDCOLLATE(coll) {set coll = "%"_v}
		s:((coll'="")&&(coll'="%EXACT")&&(ifn'["_")) ifn = ifn_"_"_coll
		q:'$d(red(str,ifn))  
		s $p(keyFldList,",",keyPiece)=red(str,ifn)
	}
	QUIT:fldOfKey'="" 0  		;  some part of this key was not found - can't use this key
	s red(str)=keyFldList_","  	;  good key found for this stream, use the key
	s mt("diststr")=$g(mt("diststr"))_$lb(str)
	QUIT 1	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
shardcontext(m) [mt] PUBLIC {  ;  $$: 1 if m references a local shard
	i m=1,$d(%ISCSNRemoteTables) { RETURN 1 }  ;  non-cosharded
	s ml=m_"^"  ;  loop over all tables of this subquery
	f  { s ml=$o($$$mtFromTableName(ml),1,tname) RETURN:+ml'=m 0 RETURN:$e(tname,1,11)="IRIS_SHARD_" 1 }
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tryExistsToView() [doingSvso, pqb, sqb, decorrWhr, decorrHav, mt, m, tup, vals, sql] {
	#; IBA076: heuristic developed during Junhee's CDP rotation to favor MERGE over SVSO in some cases
	// if we're not doingSVSO we should always try existsToView
	if ('doingSvso) quit 1
	
	// try to create a numerical cost heuristic for doing existsToView vs SVSO;
	// if there are MAXNUMBER errors as a result of many view joins, then assume
	// that the cost of existsToView is very high and thus don't try existsToView
	try {
		// try to calculate an approximate "cost" of doing existsToView;
.
		// first estimate the extent size of the created view using selectivities	
		// by finding the product of the sizes of the join tables in the subquery
		set sqbResultSize = 1
		set key = sqb _ "^"
		while (key '= "") {
			set key = $order($$$mtFromTableName( key), 1, sqbIqn)
			if (key = "") quit
			// for virtual tables, assume that the size is 100
			if ($find(sqbIqn, "%%Q") '= 0) {
				set sqbResultSize = sqbResultSize * 100
			} else {
				set sqbIrn = $$$smdGetIrn(sqbIqn)
				set sqbResultSize = sqbResultSize * $$$smdExtentSize(1, sqbIrn)
			}
		}
		
		// multiply sqbResultSize by the condition selectivities to estimate overall result set size;
		// since correlated conditions will be moved out of the subquery when decorrelating, only consider uncorrelated conditions
		set uncorrelatedLogs = ""
		if ($data($$$mtWhere(sqb))) {
			set whereLogs = $$$mtWhere(sqb)
			for index = 1:1:$length(whereLogs, "^") - 1 {
				set whereLog = $piece(whereLogs, "^", index)
				// if the log is correlated then it will be moved out of the subquery 
				// when creating the view, so don't consider those
				if ($listfind(decorrWhr, whereLog) = 0) {
					set uncorrelatedLogs = uncorrelatedLogs _ $listbuild(whereLog)
				}
			}
		}
		
		if ($data($$$mtHaving( sqb))) {
			set havingLogs = $$$mtHaving( sqb)
			for index = 1:1:$length(havingLogs, "^")-1 {
				set havingLog = $piece(havingLogs, "^", index)
				// if the log is correlated then it will be moved out of the subquery 
				// when creating the view, so don't consider those
				if ($listfind(decorrHav, havingLog) = 0) {
					set uncorrelatedLogs = uncorrelatedLogs _ $listbuild(havingLog)
				}
			}
		}
		
		set ptr = 0
		while $listnext(uncorrelatedLogs, ptr, uncorrelatedLog) {
			set sel = $$GetSel^%qaqomul(uncorrelatedLog)
			set sqbResultSize = sqbResultSize * sel
		}
		
		// if the estimated result size is too small, set it to a flat 10
		if (sqbResultSize < 1) set sqbResultSize = 10
.
		// calculate the size of joining the view and the pqb table
		// by using the formula (extent size of view) * (extent size of pqb table) / max (# of distinct values in join columns)
		set joins = ""
		if (decorrWhr '= "") {
			set ptr = 0
			while $listnext(decorrWhr, ptr, decorrWhrExpr) {
				set joins = joins _ $listbuild(decorrWhrExpr)
			}
		}
.
		if (decorrHav '= "") {
			set ptr = 0
			while $listnext(decorrHav, ptr, decorrHavExpr) {
				set joins = joins _ $listbuild(decorrHavExpr)
			}
		}
		
		set prodMaxDistinctVals = 1
		set currMaxDistinctVals = 1
		set primaryJoinSize = 1
		set pqbIrns = $lb()
		set maxPqbTableSize = sqbResultSize
		set minPqbTableSize = sqbResultSize
		set ptr = 0
		set tryExistsToView = ""
		while $listnext(joins, ptr, join) {
			// find correlated pqbExpr
			set pqbExpr = $$getPqbExpr(join)
.
			set pqbExpr = $$getTableColumn(pqbExpr)
			if (pqbExpr = "") {
				return 0
			}
			
			// calculate the extent size of the pqb table being joined if not already found
			set pqbIfn = $p($$$mtV(pqbExpr), "^", 3)
			set pqbIrn = $$$smdGetIrnFromIfn(+pqbIfn)
			// for views assume a size of 100
			if (pqbIrn = "") {
				set pqbTableSize = 100
			} else {
				set pqbTableSize = $$$smdExtentSize(1, pqbIrn)
			}
			if ($listfind(pqbIrns, pqbIrn) = 0) {
				set pqbIrns = pqbIrns _ $lb(pqbIrn)
				set primaryJoinSize = primaryJoinSize * pqbTableSize
.
				if (pqbTableSize > maxPqbTableSize) set maxPqbTableSize = pqbTableSize
				if (pqbTableSize < minPqbTableSize) set minPqbTableSize = pqbTableSize
			}
.
			// only consider equijoins for estimating the size of the join;
			// pessimistically assume that all other types of join don't reduce
			// the size of the join at all
			if ($$getJoinOp(join) = "=") {
				set str = $p($$$mtV(pqbExpr), "^", 2)
				set m = pqb
				do ddfldst^%qaqpqo(str, pqbIfn)
				if (vals > currMaxDistinctVals) set currMaxDistinctVals = vals
.
				// calculated the number of distinct values of sqbExpr
				set sqbExpr = $$getSqbExpr(join)
				set sqbExpr = $$getTableColumn(sqbExpr)
				if (sqbExpr = "") {
					return 0
				}
.
				set sqbIfn = $p($$$mtV(sqbExpr), "^", 3)
				set sqbIrn = $$$smdGetIrnFromIfn(+sqbIfn)
				
				set str = $p($$$mtV(sqbExpr), "^", 2)
				set m = sqb
				do ddfldst^%qaqpqo(str, sqbIfn)
.
				// use the approxmation vals(e^(vals/sqbResultSize)-1)/e^(vals/sqbResultSize)-1 to estimate number of distinct values;
				// if the expected size of the sqb result is large compared to the number of distinct vals in the sqb table col,
				// then assuming a uniform distribution amongs the distinct vals it's highly likely that all distinct vals
				// are found in the original column are found in the result set, so only do this approximation for when the ratio
				// between the estimated sqb result size to the number of distinct vals is "small"
				if (sqbResultSize/vals <= 300) {
					set e = 2.7183
					set exp = e**(sqbResultSize/vals)
					set vals = vals*(exp-1)/exp
				}
				
				if (vals > currMaxDistinctVals) set currMaxDistinctVals = vals
				
				set prodMaxDistinctVals = prodMaxDistinctVals * currMaxDistinctVals
			}
		}
.
		set estimatedJoinSize = primaryJoinSize * sqbResultSize / prodMaxDistinctVals
		set CGGFACTOR=$g(^%SYS("sql","optimizer","parameter","CGGFACTOR"),2)
		set CGSFACTOR=$g(^%SYS("sql","optimizer","parameter","CGSFACTOR"),3)
		set existsToViewCost = (CGGFACTOR+CGSFACTOR)*estimatedJoinSize
		set SVSOCost = 2*CGGFACTOR*(maxPqbTableSize - minPqbTableSize)
		return:existsToViewCost>SVSOCost 0 
.
		return 1
	} catch err {
		return 0
	}
}
getTableColumn(qbExpr) [mt]
{
	// qbExpr might point to something that is not a table column, i.e. where $$$mtV(qbExpr) = f^str#^ifn;
	// it may be a v^op^^List(val#) expr which is a calculated value based on other columns,
	// it may be a n^^^val# field that references another column,
	// or it may be a f^str#^ifn where ifn points to a virtual table column.
	// In these cases, it's necessary to do some extra logic to find the table column the qbExpr references
	set invalidQbExpr = ""
	while (($$$mtVType($$$mtV(qbExpr)) '= "f") || ($find($p($$$mtV(qbExpr), "^", 3), "_") '= 0)) {
		if ($$$mtVType($$$mtV(qbExpr)) = "f") {
			set virtualIfn = $p($$$mtV(qbExpr), "^", 3)
			set virtualIfn = $p(virtualIfn, "_")
			// if $$$mtV(qbExpr) = f^str#^ifn where ifn references a virtual table column
			// then set qbExpr to the val# that the virtual table column references
			if $data($$$mtVirf(virtualIfn)) {
				set qbExpr = $listget($$$mtVirf(virtualIfn), 2)
			} else {
				quit
			}
		} elseif ($$$mtVType($$$mtV(qbExpr)) = "n") {
			// if $$$mtV(qbExpr) = n^^^val# set qbExpr to the referenced val#
			set qbExpr = $p($$$mtV(qbExpr), "^", 4)
		} elseif ($$$mtVType($$$mtV(qbExpr)) = "v") {
			// if $$$mtV(qbExpr) = v^op^^List(val#) and there is only one operand val#, 
			// then set qbExpr to the referenced val#
			set qbExpr = $p($$$mtV(qbExpr), "^", 4)
			// if there is more than one operand val#, then don't try existsToView
			if ($find(qbExpr, ",") '= 0) {
				set invalidQbExpr = 1
				quit
			}
		} else {
			// if $$$mtV(qbExpr) is not in any of the expected forms, then don't try existsToView
			set invalidQbExpr = 1
			quit
		}	
	}
.
	if (invalidQbExpr) quit ""
	quit qbExpr
}
error(e) GOTO ^%qaqperr  ; -- e is error# --
---


