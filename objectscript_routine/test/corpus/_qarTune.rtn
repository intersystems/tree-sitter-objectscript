====
qarTune
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qarTune^MAC^^^0
%qarTune(table,update=0,display=1,KeepClassUpToDate=0,ClearValues=0,pLogFile="",extentsize="",pRecompileCQ=0,pSamplePerc="",&SQLCODE,&%TTNS,autotune="",systemTask=0,systemTaskNS="",lastNumRowsChanged="") [] PUBLIC {
	;; COMPONENTS :: SQL/TuneTable
	#;
#INCLUDE %occInclude
#INCLUDE %msql
#INCLUDE %BigData.ShardableEntity
#INCLUDE %BigData.ShardingManager
#INCLUDE %syDatabase
#INCLUDE %occSAX
.
#define SingleValueCheckRowCount 100000
#define SingleValueCheckBlockCount 1000
#define LogGlobalName ^IRIS.Tune.TTLog
#define MsgGlobalName ^IRIS.Tune.TTMsg
#define LogGlobalInReadOnlyDB      $$GlobalInReadOnlyDB("IRIS.Tune.TTLog")
#define MsgGlobalInReadOnlyDB      $$GlobalInReadOnlyDB("IRIS.Tune.TTMsg")
#define AppendErrMsg set:pParentPid $$$MsgGlobalName(pParentPid,$I($$$MsgGlobalName(pParentPid)))=%msg
#define LogGlobalRoot $$$LogGlobalName(%TTLogJob)
#define LogMessage(%indent,%message) set $$$LogGlobalName(%TTLogJob,$$$LogGlobalRoot)=$g($$$LogGlobalName(%TTLogJob,$$$LogGlobalRoot))_$lb(%indent,%message)
#define LogClear kill $$$LogGlobalRoot
#def1arg DebugTrace(%arg) if $d(^IRIS.TT.Trace) { set ^IRIS.TT.Trace($i(^IRIS.TT.Trace))=$lb($namespace,$j,%arg) }
	#;
#IF 0   ;-------------------------------------------------------------
	; Description:   Utility to gather tuning parameters from actual table data
	; Author:        David Van De Griek
	; Date:          February 9, 2000
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;  DAP003  (06/24/2020) - Update selectivity calculation to use the second order method of moments estimator
	;  DAP002  (12/04/2019) - Estimate selectivity when GetDistinctCountTwo() finds multiple distinct values
	;  DAP001  (10/08/2019) - Randomized check for more than one distinct value in GetDistinctCountTwo()
	;  JMM837  (03/10/2018) - Unified routine and globals databases for sharded cluster
	;  JMM734  (06/30/2016) - TuneSchema and TuneTable("*"): correctly log all tables tuned on shards
	;  JMM675  (10/20/2015) - Make TuneTable shard-aware 
	;  MRP843  (07/25/2015) - Correct Tune Table transposition bug in 'ComputeBlocks()' method invocation... 
	;  SJ2919  (09/30/2013) - Change call from %SYS.GSIZE to %GSIZE
	;  PVA273  (03/14/2013) - Allow tunetable extrapolation and outlier logic to work with arbitrary sample size 
	;  PVA272  (02/15/2013) - Support separate selectivity for frequent outlier value 
	;  BJB482  (04/12/2011) - Create TuneTable Property for a Class Extent
	;  PVA193  (07/20/2009) - TuneTable should Ignore Row Level Security 
	;  DPV3362 (02/19/2009) - Use Save^%apiDDL, not %apiCDL
	;  DPV3040 (10/02/2007) - SQL Fix:  If tune fails with error, clean up better so next table can succeed
	;  DPV3039 (10/02/2007) - SQL Enhancement: Add flag to TuneTable to clear values
	;  DPV2969 (06/29/2007) - Update class timestamps if they differ and the class hash does not if KeepUpToDate=1
	;  DPV2871 (03/05/2007) - Don't update class definition when tuning deployed classes
	;                         SQL Fix ProdLog 56625: TuneTable, Compiling classes in deployed mode
	;  BJB334  (02/12/2007) - Only Purge Cached Queries if KeepUpToDate = 0 
	;  STC1094 (10/28/2006) - Add routine change audit
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  DPV2593 (02/21/2006) - SQL Enhancement: Use private global for SQL instead of ^mtemp0
	;  DPV2546 (11/08/2005) - Implement new MVR collation function.  Change collation implementations to use $zu(28)
	;  DPV2482 (08/03/2005) - Don't calculate field'd SELECTIVITY of CALCSELECTIVITY=0
	;                         SQL Enhancement ProdLog 45096: Computed Fields and Selectivity
	;  DPV2471 (07/27/2005) - Fix <SUBSCRIPT> error with long UNICODE text by using a hash for strings over 70 characters long
	;                         SQL Fix ProdLog 41631: TuneTable(Calculate) generates <SUBSCRIPT> error
	;  DPV2454 (07/19/2005) - Move ^mcq global to ^|"%SYS"|CQ[I] subscripted by namespace
	;  DPV2447 (06/21/2005) - Set EXTENTSIZE in Storage, not the class parameter
	;  DPV2320 (11/10/2004) - Rename server routines
	;  BJB289  (03/26/2004) - KeepUpToDate missing in what procedure call
	;  DPV2158 (01/26/2004) - Make keeping class up-to-date a parameter to Tune Table
	;                         Implemented ProdLog 35279:  Do not tune external tables
	;  DPV2151 (01/08/2004) - Update class definition without marking class as not up-to-date
	;  DPV2090 (10/09/2003) - Completion of ^mdd elimination
	;  DPV2064 (08/25/2003) - Improve performance of setting selectivity for properties
	;  DPV1982 (05/05/2003) - Use delimited identifiers when needed on field names
	;  DPV1975 (04/29/2003) - Use new metadata structures.
	;  DPV1958 (03/10/2003) - Move ^mdd(7) metadata to $$$EXTCQ($$$rEXT,<class name>,<cached query>)
	;  DPV1956 (03/07/2003) - Move ^mdd(6) metadata to ^rINDEXSQL()
	;  DPV1945 (03/03/2003) - Set SQL selectivity to NUMROWS if selectivity=extentsize and field is UNIQUE
	;  DPV1894 (12/11/2002) - New ii, comperr, comerr, %ROWCOUNT, SQLCODE
	;  DPV1787 (08/08/2002) - Store calculated selectivity values in storage:property:selectivity
	;  DPV1773 (07/29/2002) - Some code moved from %qserver to %qsqlserver
	;  DPV1726 (05/21/2002) - Reset map statistics when TuneTable is run.
	;  DPV1689 (03/20/2002) - More TuneTable optimizations - don't use dynamic query
	;  DPV1674 (02/27/2002) - Rewrite Tune Table to avoid whole table scans and modularize for SQL Manager
	;  DPV1646 (01/16/2002) - Use appropriate $$$cPARM macros in %apiCDL calls
	;                         Enhance error reporting a bit.
	;  DPV1515 (03/28/2001) - Fix very small selectivities to not set selectivity to 0
	;  DPV1373 (08/22/2000) - Fix problem with table name in GetCounts caused by Schema support
	;  DPV1372 (08/22/2000) - Purge Dynamic SQL Cached Queries too
	;  DPV1310 (06/23/2000) - Support schemas
	;  DPV1267 (02/28/2000) - Many minor fixes and tweaks
	;  DPV1260 (02/09/2000) - Creation of new utility
	;
	;-------------------------------------------------------------
	;                     I N F O R M A T I O N
	;-------------------------------------------------------------
	;
	;   
	;
	;-------------------------------------------------------------
#ENDIF  ;
	// Called from:
	//   %apiSQL
	//	%SYSTEM.SQL.TuneTable (indirect)
	//	%Library.Populate.Populate (indirect)
	//  %qaqpsq
	
	new %SNStartTuneTableLogOnShards,%TuneParallel,%tuneCaller
	set:extentsize'=+extentsize extentsize=""
	set sc=$$$OK,tStartTime=$zh,tTabCount=0,pParentPid=$j
	if '$d(%TTNS) {
		new %TTNS 
		if $g(SSShardLocalGlobal) {
			set %TTNS=##class(%BigData.ShardingManager).%GetMasterExtendedReferencePrefix()
		} else {
			set %TTNS=$namespace
		}
	}
	new %TTLogJob set %TTLogJob=$job
	$$$SuspendErrorCount
	if $$$LogGlobalInReadOnlyDB {
		set pLogFile=""	
	} else {
		$$$LogClear
	}
	set:$$$MsgGlobalInReadOnlyDB pParentPid=0
	if pLogFile'="" {
		if $e(pLogFile,1,2)=">>" {
			set pLogFile=$e(pLogFile,3,*)
			//set sc=$$AppendToLogFile(pLogFile)
			set appendToLog=1
		}
		else {
			set sc=$$CreateLogFile(pLogFile)
			set appendToLog=0
		}
		do startTuneTable^%SYS.SHARDSRV()
	}
	if $$$ISERR(sc) { 
		set %msg=$$ProcessError(sc,.SQLCODE) 
		do logStatus(display,,sc,5) 
		kill:pParentPid $$$MsgGlobalName(pParentPid) 
		RETURN 
	}
	if pLogFile'="" {
		if appendToLog {
			do LogFileAppendSeparator(pLogFile)
		}
		else {
			do LogFileHeader(pLogFile)
		}
		do log(0,pLogFile,$$$Text("TuneTable called with arguments:","%SQL.TuneTable"))
		do log(0,pLogFile,"table: "_table,2)
		do log(0,pLogFile,"update: "_update,2)
		do log(0,pLogFile,"display: "_display,2)
		do log(0,pLogFile,"KeepClassUpToDate: "_KeepClassUpToDate,2)
		do log(0,pLogFile,"ClearValues: "_ClearValues,2)
		do log(0,pLogFile,"LogFile: "_pLogFile,2)
		do log(0,pLogFile,"Default ExtentSize:  "_extentsize,2)
		do log(0,pLogFile,"Recompile Cached Queries:  "_pRecompileCQ,2)
		do:pSamplePerc'="" log(0,pLogFile,"Sample Size Percentage:  "_pSamplePerc,2)
		do log(0,pLogFile,"")
	}
	if pLogFile'="" { 
		set sc = $$WriteToLogFile(pLogFile,%TTNS) 
		do:$$$ISERR(sc) logStatus(display,,sc,5,pParentPid)
		$$$LogClear 
	}
	  #; %tuneCaller used when loading data dictionary to determine
	  #; whether or not the load is being done by TuneTable
	  #; YCL109 - tuneTable always use WQM even for the single table case
	set %tuneCaller = "tune",%TuneParallel=1,sc=$$$OK
	
	new %objlasterror
	set queue = $SYSTEM.WorkMgr.%New("",,"Utility")
	Set:queue=$$$NULLOREF sc=$s($g(%objlasterror)'="":%objlasterror,1:$$$ERROR($$$GeneralError,"Unknown error creating work queue group $zerror="_$ze))
	if $$$ISERR(sc) {
		set %msg=$$ProcessError(sc,.SQLCODE)
		do logStatus(display,pLogFile,sc,5)
		set sc = $$FlushLog(pLogFile,1,tStartTime,tTabCount,%TTNS)
		do:$$$ISERR(sc) logStatus(display,,sc,5)
		RETURN
	}
	if table="*" {	
		set schema="&"
		for  {
			set schema=$o(^rINDEXSQL("TABLE",schema)) quit:schema=""
			set table=""
			for  {
				set table=$o(^rINDEXSQL("TABLE",schema,table)) quit:table=""
				set classname=$$$GetClassNameFromTableName(schema,table)
				set sharded=$$$comSharded(classname) // JMM1160=
				// Federated tables aren't tuned, they inherit their stats from their source tables
				continue:$$$SSIsFederated(classname)
				continue:sharded=2  // shard-local tables will be tuned when shard-master tables are tuned
				set sc=queue.Queue("tune^%qarTune",schema_"."_$tr(table,".",$c(2)),update,display,KeepClassUpToDate,ClearValues,pLogFile,extentsize,pRecompileCQ,pSamplePerc,,1,%TTNS,,,pParentPid,systemTask,systemTaskNS,lastNumRowsChanged)
				if $$$ISERR(sc) { do logStatus(display,pLogFile,sc,5,pParentPid) quit }
				set tTabCount=tTabCount+1
			}
			quit:$$$ISERR(sc)
		}
	} else {		
	    #;  Just a single table name:
	    set sc=queue.Queue("tune^%qarTune",$$IntQualifiedName^%apiSQL(table),update,display,KeepClassUpToDate,ClearValues,pLogFile,extentsize,pRecompileCQ,pSamplePerc,,1,%TTNS,,autotune,pParentPid,systemTask,systemTaskNS,lastNumRowsChanged)
		If $$$ISERR(sc) { 
			set %msg=$$ProcessError(sc,.SQLCODE)
			do logStatus(display,pLogFile,sc,5)
			set sc = $$FlushLog(pLogFile,1,tStartTime,tTabCount,%TTNS)
			do:$$$ISERR(sc) logStatus(display,,sc,5)
			kill:pParentPid $$$MsgGlobalName(pParentPid)
			RETURN 
		}
		set tTabCount=1
	}
	set sc=queue.Sync()
	if $$$ISERR(sc) {
		do logStatus(display,pLogFile,sc,5,pParentPid)
	}
	set %msg=""
	if pParentPid {
		set key=""
		for {
			set key=$O($$$MsgGlobalName(pParentPid,key),1,value) q:key=""
			set %msg=%msg_$lb(value)
		}
		kill $$$MsgGlobalName(pParentPid)
	}
	set sc = $$FlushLog(pLogFile,1,tStartTime,tTabCount,%TTNS)
	do:$$$ISERR(sc) logStatus(display,,sc,5)
	RETURN
}
.
	// Called from:
	//   %apiSQL
Schema(schema="",update=0,display=1,KeepClassUpToDate=0,ClearValues=0,pLogFile="",pRecompileCQ=0,pSamplePerc="",&SQLCODE="") [] PUBLIC {
.
	new %SNStartTuneTableLogOnShards,%TTNS,%TuneParallel
	set sc=$$$OK,tStartTime=$zh,tTabCount=0,pParentPid=$j
	if $g(SSShardLocalGlobal) {
		set %TTNS=##class(%BigData.ShardingManager).%GetMasterExtendedReferencePrefix()
	} else {
		set %TTNS=$namespace
	}
	new %TTLogJob set %TTLogJob=$job
	if $$$LogGlobalInReadOnlyDB {
		set pLogFile=""	
	} else {
		$$$LogClear
	}
	set:$$$MsgGlobalInReadOnlyDB pParentPid=0
.
	set:pLogFile'="" sc=$$CreateLogFile(pLogFile) 
	if $$$ISERR(sc) {
		set %msg=$$ProcessError(sc,.SQLCODE)
		do logStatus(display,,sc,5)
		kill:pParentPid $$$MsgGlobalName(pParentPid)
		RETURN
	}
	do:pLogFile'="" startTuneTable^%SYS.SHARDSRV()
	if pLogFile'="" {
		do LogFileHeader(pLogFile)
		do log(0,pLogFile,$$$Text("TuneSchema called with arguments:","%SQL.TuneTable"))
		do log(0,pLogFile,"schema: "_schema,5)
		do log(0,pLogFile,"update: "_update,5)
		do log(0,pLogFile,"display: "_display,5)
		do log(0,pLogFile,"KeepClassUpToDate: "_KeepClassUpToDate,5)
		do log(0,pLogFile,"ClearValues: "_ClearValues,5)
		do log(0,pLogFile,"LogFile: "_pLogFile,5)
		do log(0,pLogFile,"Recompile Cached Queries:  "_pRecompileCQ,5)
		do:pSamplePerc'="" log(0,pLogFile,"Sample Size Percentage:  "_pSamplePerc,5)
		do log(0,pLogFile,"")
	}
.
	if schema="" { set schema=$$$DefaultSchema }
	set SCHEMA=$$$UPPER(schema)
	if '$d(^rINDEXSQL("rv",SCHEMA)) {
		set SQLCODE=-473
		set %msg=$$$FormatText($$$Text("No such schema '%1'","%SQL.TuneTable"),schema)
		do log(display,pLogFile,%msg,,,pParentPid)
		set sc = $$FlushLog(pLogFile,1,tStartTime,tTabCount,%TTNS)
		if $$$ISERR(sc) {
			do logStatus(display,,sc,5)
			set:SQLCODE'="" SQLCODE=-400
		}
		kill:pParentPid $$$MsgGlobalName(pParentPid)
		RETURN
	}
	set table="",%TuneParallel=1
	new %objlasterror
	set queue = $SYSTEM.WorkMgr.%New("",,"Utility")
	Set:queue=$$$NULLOREF sc=$s($g(%objlasterror)'="":%objlasterror,1:$$$ERROR($$$GeneralError,"Unknown error creating work queue group $zerror="_$ze))
	if $$$ISERR(sc) {
		set %msg=$$ProcessError(sc,.SQLCODE)
		do logStatus(display,pLogFile,sc,5)
		set sc = $$FlushLog(pLogFile,1,tStartTime,tTabCount,%TTNS)
		do:$$$ISERR(sc) logStatus(display,,sc,5)
		kill:pParentPid $$$MsgGlobalName(pParentPid)
		RETURN
	}
	set sc = $$FlushLog(pLogFile,,,,%TTNS)
	if $$$ISERR(sc) {
		do logStatus(display,,sc,5)
		set:SQLCODE'="" SQLCODE=-400
	}
	for  {
		set table=$o(^rINDEXSQL("rv",SCHEMA,table),1,data) quit:table=""
		continue:$lg(data,3)'=1	// Not a table
		set iqn=$$$GetExactIntQualifiedName(SCHEMA,table)
		set classname=$$$GetClassNameFromIQN(iqn)
		set sharded=$$$comSharded(classname) // JMM1160=
		continue:sharded=2  // shard-local tables will be tuned when shard-master tables are tuned
		// Federated tables aren't tuned, they inherit their stats from their source tables
		continue:$$$SSIsFederated(classname)
		set sc=queue.Queue("tune^%qarTune",iqn,update,display,KeepClassUpToDate,ClearValues,pLogFile,,pRecompileCQ,pSamplePerc,,1,%TTNS,,,pParentPid)
		if $$$ISERR(sc) { do logStatus(display,pLogFile,sc,5,pParentPid) quit }
		
		set tTabCount=tTabCount+1
	}
	set sc=queue.Sync()
	if $$$ISERR(sc) {
		set:SQLCODE'="" SQLCODE=-400
		do logStatus(display,pLogFile,sc,5,pParentPid)
	}
	set %msg=""
	if pParentPid {
		set key=""
		for {
			set key=$O($$$MsgGlobalName(pParentPid,key),1,value) q:key=""
			set %msg=%msg_$lb(value)
		}
		kill $$$MsgGlobalName(pParentPid)
	}
	set sc = $$FlushLog(pLogFile,1,tStartTime,tTabCount,%TTNS)
	if $$$ISERR(sc) {
		do logStatus(display,,sc,5)
		set:SQLCODE'="" SQLCODE=-400
	}
	QUIT
}
.
#define countOneFieldDefaultSel 1000000
#define countOneFieldDefaultOutlierSel "99.9999%"
tune(table,update=0,display=1,KeepClassUpToDate=0,ClearValues=0,pLogFile="",extentsize="",pRecompileCQ=0,pSamplePerc="",&SQLCODE,%TuneParallel=0,&%TTNS,%TTLogJob,autotune="",pParentPid=0,systemTask=0,systemTaskNS="",lastNumRowsChanged="") [%mmmsqlTTavg] PUBLIC {
	   #;  Given a table name, find good tuning numbers for it
	   #;  Make sure the table exists
	   #;      KeepClassUpToDate:  1/0 flag to signal whether to keep the class up-to-date or not.  If TRUE, we edit the
	   #;                      class definition global directly.  The default is 0, don't keep it up-to-date.
	   #;      pRecompileCQ:	1/0 flag.  If 1, when possible attempt to recompile the cached query instead of purging it
	#; Turn on batch mode
	Set batch=$zu(68,25,1)
	if systemTask {
		Set cmdCnt=$zu(67,8,$J)+$system.Context.WorkMgr().CommandsExecuted
		Set physicalBlkReadCnt=$zu(67,34,$J)
		Set tuneStartTime=$zh
	}
	set noStatsOref=$s(ClearValues:1,1:0)
	$$$DebugTrace("tune^%qarTune: table="_$g(table)_", update="_update_", display="_display_", KeepClassUpToDate="_KeepClassUpToDate_", ClearValues="_ClearValues_", pLogFile="_pLogFile_", extentsize="_extentsize_", pRecompileCQ="_pRecompileCQ_", pSamplePerc="_pSamplePerc_", SQLCODE="_$g(SQLCODE)_", %TuneParallel="_%TuneParallel_", %TTNS="_$g(%TTNS)_", %TTLogJob="_$g(%TTLogJob))
	if $g($$$SSShardLocalGlobal) {
		set %TTNS=##class(%BigData.ShardingManager).%GetMasterExtendedReferencePrefix()
		$$$DebugTrace("tune^%qarTune: %TTNS set to "_%TTNS_" because we are on a shard")
	}
	if '$d(%TTLogJob) { new %TTLogJob set %TTLogJob=$job }
	if $$TuneTable^%SYS.SHARDSRV(table,update,display,KeepClassUpToDate,ClearValues,pLogFile,extentsize,pRecompileCQ,pSamplePerc,.%TTNS,,pParentPid) {
		if '$$$LogGlobalInReadOnlyDB {
			do:display DisplayLog(%TTNS)	// Write output to screen from log global
			if pLogFile="" {
				$$$LogClear
			}
		}
		goto exit
	}
	set $zt="tuneErr"
	new %mmmsqlTTavg
	// sampleType=1: traditional row based sampling
	// sampleType=2: block sampling
	// sampleType=3: bitmap extent index sampling
	set emptyTableRequested=(extentsize=0)
	set updated=0,sc=$$$OK
	set schema=$$$AllButLastPiece(table,"."),tablename=$tr($$$LastPiece(table,"."),$c(2),".")
	if schema=""||(tablename="") { 
		set SQLCODE=-30,%msg=$$$FormatText($$$Text("No such table '%1'","%SQL.TuneTable"),table)
		do log(display,pLogFile,%msg,,,pParentPid)
		goto exit
	}
	set extentname=$$$GetExtentNameFromTableName(schema,tablename)
	if extentname="" { 
		set SQLCODE=-30,%msg=$$$FormatText($$$Text("No such table '%1'","%SQL.TuneTable"),table)
		do log(display,pLogFile,%msg,,,pParentPid)
		goto exit
	}
	elseif $$$SSIsFederated(extentname) {
		// Federated tables aren't tuned, they inherit their stats from their source tables
		set SQLCODE=0
		goto exit
	}
.
	set tTableType=$$$GetTableTypeFromTableName(schema,tablename)
	if tTableType=3 {
		set %msg=$$$FormatText($$$Text("'%1' is a view, not a table. No tuning will be performed.","%SQL.TuneTable"),table)
		do log(display,pLogFile,%msg,,,pParentPid)
		goto exit
	}
	if noStatsOref&&$$GlobalInReadOnlyDB("oddEXT",extentname) {
		set %msg=$$$FormatText($$$Text("Table '%1' is mapped to a readonly datababase. No tuning will be performed.","%SQL.TuneTable"),table)
		do log(display,pLogFile,%msg,,,pParentPid)
		goto exit
	}
	set tabinfo=$g($$$EXTsqlinfo($$$rEXT,extentname))
	if tabinfo="" {
		set %msg=$$$FormatText($$$Text("No such table '%1'","%SQL.TuneTable"),table)
		do log(display,pLogFile,%msg,,,pParentPid)
		goto exit
	}
	set classname=$$$SQLLocTableClassname(tabinfo)
	set sharded=$$$SQLLocTableSharded(tabinfo)
	set:(display=1)&&(sharded=2)&&('$$$LogGlobalInReadOnlyDB) display="shard local table"
	
	  #; Determine the sampling type, for example, if this is a remote table, use the old sampling mechanism
	set iqn=$$$BuildIQN($$$SQLLocTableSchema(tabinfo),$$$SQLLocTableName(tabinfo))
	set mrirn = $$$smdLoadGetIrn(iqn)
	set CT = ""
	set sampleType = 2
	  #; CT = 1 means (partially) columnar table; not relevtant
	set noMapBlockCnt = 0
	if ('$$$SQLLocTableSupportsBlockSampling(tabinfo)){
		set sampleType = 1
	} else {
		do GetGlobalInfo(iqn, mrirn, .imp, .gName, .DIR, .ns, .DB, .DBS, .CT)
		if $listget(DBS,1)=0 {; if there is any err when getting global, use the old row-based sampling
			set sampleType = 1,noMapBlockCnt=1 
		} else {
			for i = 2:1:$listlength($get(DBS)){
				if $piece($listget($listget(DBS,i)),"^")'=""{
					set sampleType = 1,noMapBlockCnt=1 quit
				}
			}
		}
	}
	
	if (sampleType=2){
		set ttype=$$$GetTableTypeFromIQN(iqn)
		; for pure columnar table, we can sample bitmap extent index instead of block sampling of master map
		; since there is nothing in the master map
		if $$HasCDMs(extentname)&&('$$HasMasterMapDataFields(extentname,$$$SQLLocTableMasterMap(tabinfo))) {
			; if ebm is selectable, we can use sampleType=3 ebm sampling, else, use sampleType=1 row-based sampling
			set sampleType=$case($SYSTEM.SQL.Util.GetMapSelectability(iqn,$$$smdMapName($$$smdBitmapExtentMap(ttype,mrirn))),0:1,:3)
		} elseif ($$$smdBitmapExtentMap(ttype,mrirn)'="") {
			; for non-columnar table, if ebm is selectable, we can use sampleType=3 ebm sampling,  
			; else, still use sampleType=2 block sampling
			set sampleType=$case($SYSTEM.SQL.Util.GetMapSelectability(iqn,$$$smdMapName($$$smdBitmapExtentMap(ttype,mrirn))),0:2,:3)
		}
	}
	
	do log(display,pLogFile,"")
	#; YCL108 - Extend the tune table logging with timestamp info
	#; YCL195 - Extend the tune table logging with type of sampling
	do log(display,pLogFile,"Starting statistics collection using "_$s(sampleType=1:"row",sampleType=2:"block",1:"bitmap extent index")_" sampling on ")
	if sharded=1     { do log(display,pLogFile,$$$FormatText($$$Text("SHARD-MASTER TABLE: %1","%SQL.TuneTable"),table),,0) }
	elseif sharded=2 { do log(display,pLogFile,$$$FormatText($$$Text("SHARD-LOCAL TABLE: %1","%SQL.TuneTable"),table),,0) }
	else             { do log(display,pLogFile,$$$FormatText($$$Text("TABLE: %1","%SQL.TuneTable"),table),,0) }
	set process=$$$FormatText($$$Text(" at %1 in Process id %2","%SQL.TuneTable"),$zdt($h),$job)
	do log(display,pLogFile,process,,0)
	if 'noStatsOref {
    	set statsOref=##class(%ExtentMgr.TableStatsInfo).%New()
		set startTime=$zh
	}
	  #; If we can use block sampling
	  #; This calls CalculateSelectivity *before* ComputeMapBocks
 	if (sampleType=2){
	   	  #; get old extent size
		set cextentsize=$$$SQLLocTableExtentSize(tabinfo)
		set givenextentsize = extentsize
       	  #; calculate the selectivities and extent size
		do CalculateSelectivity(extentname,tabinfo,.extentsize,.cselectivity,.coutliers,.selectivity,.outliers,.cavg,.%mmmsqlTTavg,.sc,ClearValues,display,pLogFile,.tSampleSize,emptyTableRequested,.pSamplePerc,.classid,.secondSelectivity,.reducedSecondSelectivity,.gamma,.numMasterBlocks,.chist,.hist,sampleType,CT,.dataBlocksPercent,.statsOref)
		if extentsize = -1 { goto exit }
		if (extentsize = 0)&&$get(autotune) { goto exit }
		if 'ClearValues && (givenextentsize '= "") { set extentsize = givenextentsize }
		If $$$ISERR(sc) {
			do logStatus(display,pLogFile,sc,5,pParentPid)
			do:$g(%msg)'="" log(display,pLogFile,%msg,5,,pParentPid)
			goto exit
		}
		if dataBlocksPercent'=1 {
			set extentsize = extentsize\dataBlocksPercent
			set numMasterBlocks = numMasterBlocks\dataBlocksPercent
		}
	
		  #; Compute block counts for all maps
		if (extentsize>0)||ClearValues{
			set sc=$$ComputeMapBlocks(extentname,KeepClassUpToDate,update,display,.classid,1,pLogFile,ClearValues,.updated,numMasterBlocks,2,.statsOref)
			if $$$ISERR(sc) {
				do logStatus(display,pLogFile,sc,5,pParentPid)
				do:$g(%msg)'="" log(display,pLogFile,%msg,5,,pParentPid)
				goto exit
			}
		}
 	} else {
	 	  #; If table only supports the old row based sampling and caller is autotune, then skip tuning
	 	if $get(autotune),sampleType=1{
			goto exit
	 	}
	 	  #; Table is remote; cannot get map block counts.
		do:noMapBlockCnt log(display,pLogFile,$$$FormatText($$$Text("Table '%1' is (partially) remote. Map block counts will not be computed.","%SQL.TuneTable"),$$$SQLLocTableSchema(tabinfo)_"."_$$$SQLLocTableName(tabinfo)),5)
		
	   	  #; Get extentsize
		set cextentsize=$$$SQLLocTableExtentSize(tabinfo)
		if 'ClearValues {
			set SQLCODE=0
			set:extentsize="" extentsize=$$GetNumberRows(table,extentname,.SQLCODE,.%msg)
			if SQLCODE<0 {
				do log(display,pLogFile,$$$FormatText($$$Text("ERROR getting the number of rows in table: %1","%SQL.TuneTable"),table),5)
				do log(display,pLogFile,"SQLCODE = "_SQLCODE,5)
				do log(display,pLogFile,"%msg = "_$g(%msg),5)
				if $g(%msg)'="" $$$AppendErrMsg
				goto exit
			}
		} 
		else { set extentsize = "" }
 		if (sampleType=3)&&(extentsize = 0)&&$get(autotune) { goto exit }
	   	  #; If the table has no data, don't tune the table.  The data for the table has probably not been inserted yet.
		if extentsize=0,'emptyTableRequested {
			set tSampleSize = 0
			do log(display,pLogFile,$$$Text("The table has no data.  No tuning will be performed.","%SQL.TuneTable"),5)	
		} else{
			#; Determine the sample size.  Might have been passed in as a % of rows
			if pSamplePerc'="",extentsize'<1000 {
				set tSave=pSamplePerc
				set:pSamplePerc["%" pSamplePerc=pSamplePerc/100	// Turn ##% into .##
				if pSamplePerc<=0||(pSamplePerc>1) {
					if tSave["%" {
						do log(display,pLogFile,$$$FormatText($$$Text("SamplePercent size argument must be greater than 0% and not greater than 100%. %1 was passed in","%SQL.TuneTable"),tSave),5)
						goto exit
					}
					do log(display,pLogFile,$$$FormatText($$$Text("SamplePercent size argument must be greater than 0 and not greater than 1. %1 was passed in","%SQL.TuneTable"),tSave),5)
					goto exit
				}
				set tSampleSize=$normalize(extentsize*pSamplePerc,0)
			}
			else {
				if extentsize < 1000	{ set tSampleSize=extentsize } 
				else 			{ set tSampleSize = $s($normalize(3*$zsqr(extentsize),0)<1000:1000,1:$normalize(3*$zsqr(extentsize),0)) }
			}
			do CalculateSelectivity(extentname,tabinfo,.extentsize,.cselectivity,.coutliers,.selectivity,.outliers,.cavg,.%mmmsqlTTavg,.sc,ClearValues,display,pLogFile,.tSampleSize,emptyTableRequested,.pSamplePerc,.classid,.secondSelectivity,.reducedSecondSelectivity,.gamma,,.chist,.hist,sampleType,CT)
			If $$$ISERR(sc) {
				do logStatus(display,pLogFile,sc,5,pParentPid)
				do:$g(%msg)'="" log(display,pLogFile,%msg,5,,pParentPid)
				goto exit
			}
			 #; Compute block counts for all maps
			if 'noMapBlockCnt {
				set sc=$$ComputeMapBlocks(extentname,KeepClassUpToDate,update,display,.classid,1,pLogFile,ClearValues,.updated,,sampleType,.statsOref)
				If $$$ISERR(sc) {
					do logStatus(display,pLogFile,sc,5,pParentPid)
					do:$g(%msg)'="" log(display,pLogFile,%msg,5,,pParentPid)
					goto exit
				}
			}
		}
 	}
	
		#;  Before we set the class ExtentSize, we will first check to see if the ^oddDEF and ^oddCOM $H values match.			// DPV2969+
		#;  When these values match we do not check the class hash to see if the class is UpToDate.  Prior to TuneTable,
		#;  it is possible the ^oddDEF and ^oddCOM $H values don't match if an update was made to the class that did
		#;  not require a change in the timestamp - an update to a description for example.
		#;  If the class $H values don't match, the hash is always checked in isuptodate(), and if we change the EXTENTSIZE
		#;  or SELECTIVITY settings with this mismatch, there will be no way to keep the class uptodate.
		#;  This is a kludge, but it is currently the only way we can get KeepUpToDate to work
		#;
	do:KeepClassUpToDate&&(update)&&('($$$comClassKeyGet(classname,$$$cCLASSdeployed))) CheckHash(classname)					// DPV2969-
 
 	if $Case($$$SQLLocTableChildTableType(tabinfo),"A":1,"L":1,:0) {
		set tParentClass = $$$SQLLocTableParentExtent(tabinfo)
		set tCollection = $ListGet($$$comClassArrayGet(tParentClass,$$$cCLASSextents,extentname))	// tCollection is the name of the collection property
	}
	else { set tCollection = "" }
.
	  #;  Now, we have all the calculations, display them and update the new values (if needed)
.
		#; Set the extentsize
	set sc=$$SetExtentSize(extentname,tabinfo,classname,cextentsize,extentsize,display,update,.updated,.classid,1,KeepClassUpToDate,tCollection,$g(tParentClass),pLogFile,tSampleSize,.statsOref)
	If $$$ISERR(sc) {
		do logStatus(display,pLogFile,sc,5,pParentPid)
		do:$g(%msg)'="" log(display,pLogFile,%msg,5,,pParentPid)
		goto exit
	}
.
	set f="" 
	For  {
		s f=$o($$$EXTSQLCOL($$$rEXT,extentname,f)) q:f=""	// For each field in the extent...
		s fldinfo=$$$EXTSQLCOLsqlinfo($$$rEXT,extentname,f)
		s icol=$$$SQLLocColNumber(fldinfo)
		If $d(selectivity(icol))||$d(outliers(icol))||$d(%mmmsqlTTavg(icol)) {
			kill tOutlierChanged,tAverageChanged,tHistChanged
			set currentSelectivity=$s(cselectivity(icol)="NUMROWS":1,'cselectivity(icol):"<Not Specified>",1:$j((100/cselectivity(icol)),0,6)_"%")
			set newSelectivity=$s(selectivity(icol)="NUMROWS":1,selectivity(icol)="":"<Not Specified>",'selectivity(icol):0,1:$j((100/selectivity(icol)),0,6)_"%")
			set newSecondSelectivity=$s(secondSelectivity(icol)="NUMROWS":1,secondSelectivity(icol)="":"<Not Specified>",'secondSelectivity(icol):0,1:$j((100/secondSelectivity(icol)),0,6)_"%")
			set newReducedSecondSelectivity=$s(reducedSecondSelectivity(icol)="NUMROWS":1,reducedSecondSelectivity(icol)="":"<Not Specified>",'reducedSecondSelectivity(icol):0,1:$j((100/reducedSecondSelectivity(icol)),0,6)_"%")
			do log(display,pLogFile,$$$FormatText($$$Text("FIELD:  %1","%SQL.TuneTable"),f),5)
			do log(display,pLogFile,$$$Text("CURRENT SELECTIVITY = ","%SQL.TuneTable"),8),log(display,pLogFile,currentSelectivity,42,0)
			do log(display,pLogFile,$$$Text("CALCULATED SELECTIVITY = ","%SQL.TuneTable"),8),log(display,pLogFile,newSelectivity,42,0)
			do log(display,pLogFile,$$$Text("CALCULATED 2ND ORD SELECTIVITY = ","%SQL.TuneTable"),8),log(display,pLogFile,newSecondSelectivity,42,0)
			do log(display,pLogFile,$$$Text("CALCULATED REDUCED 2ND ORD SELECTIVITY = ","%SQL.TuneTable"),8),log(display,pLogFile,newReducedSecondSelectivity,42,0)
			#; write out gamma and 2nd order selectivity
			if $d(gamma(icol)){
				do log(display,pLogFile,$$$Text("CALCULATED GAMMA = ","%SQL.TuneTable"),8),log(display,pLogFile,gamma(icol),42,0)
			}
			#; do log(display,pLogFile,$$$Text("CALCULATED SELECTIVITY = ","%SQL.TuneTable"),8),log(display,pLogFile,newSelectivity,42,0)
 			if $d(coutleirs(icol))||$d(outliers(icol)) {
	 			do log(display,pLogFile,$$$Text("CURRENT OUTLIER SELECTIVITY =","%SQL.TuneTable"),8)
	 			do log(display,pLogFile,$$$FormatText($$$Text("%1, VALUE = %2","%SQL.TuneTable"),$j(($lg($g(coutliers(icol)))*100),0,4)_"%",$case($lg($g(coutliers(icol)),2),"":"<Null>",:$$quoter($lg($g(coutliers(icol)),2)))),42,0)
	 			do log(display,pLogFile,$$$Text("CALCULATED OUTLIER SELECTIVITY =","%SQL.TuneTable"),8)
	 			do log(display,pLogFile,$$$FormatText($$$Text("%1, VALUE = %2","%SQL.TuneTable"),$lg($g(outliers(icol))),$case($lg($g(outliers(icol)),2),"":"<Null>",:$$quoter($lg($g(outliers(icol)),2)))),42,0)
				do:'($d(cavg(icol))||$d(%mmmsqlTTavg(icol))) log(display,pLogFile,"",1)
				if ($j(($lg($g(coutliers(icol)))*100),0,4)_"%")'=$lg($g(outliers(icol))) || ($lg($g(coutliers(icol)),2)'=$lg($g(outliers(icol)),2)) { set tOutlierChanged=1 }
			}
			if $$$SQLLocColStream(fldinfo)'=1 && ($d(cavg(icol))||$d(%mmmsqlTTavg(icol))) {
	 			do log(display,pLogFile,$$$Text("CURRENT AVERAGE FIELD SIZE =","%SQL.TuneTable"),8)
	 			do log(display,pLogFile,$case($g(cavg(icol)),"":"<Null>",:cavg(icol)),42,0)
	 			do log(display,pLogFile,$$$Text("CALCULATED AVERAGE FIELD SIZE =","%SQL.TuneTable"),8)
	 			do log(display,pLogFile,$case($g(%mmmsqlTTavg(icol)),"":"<Null>",:%mmmsqlTTavg(icol)),42,0)
				if $g(cavg(icol))'=$g(%mmmsqlTTavg(icol)) { set tAverageChanged=1 }
			}
			if $d(cavg(icol))||$d(%mmmsqlTTavg(icol)) {
				if $g(chist(icol))'=$g(hist(icol)) { set tHistChanged=1 }
			}
 			if $d(coutleirs(icol))||$d(outliers(icol))||($$$SQLLocColStream(fldinfo)'=1 && ($d(cavg(icol))||$d(%mmmsqlTTavg(icol)))) {
				do log(display,pLogFile,"",1)
 			}
			if (update && ((((currentSelectivity'=newSelectivity) || $d(tOutlierChanged)) || $d(tAverageChanged)) || $d(tHistChanged)))||$isObject(statsOref){
				set objselectivity(icol)=$$SelectivityToObjectSelectivity(selectivity(icol))
				set sc=$$SetSelectivity(extentname,f,fldinfo,classname,extentsize,objselectivity(icol),selectivity(icol),display,.classid,1,KeepClassUpToDate,tCollection,$g(tParentClass),pLogFile,$g(outliers(icol)),$g(%mmmsqlTTavg(icol)),$g(hist(icol)),ClearValues,.statsOref)
				If $$$ISERR(sc) {
					do logStatus(display,pLogFile,sc,5,pParentPid)
					do:$g(%msg)'="" log(display,pLogFile,%msg,5,,pParentPid)
				}
				Elseif '$isObject(statsOref) { s updated=1 }
			}
		}
		quit:$$$ISERR(sc)
	}
	If $$$ISERR(sc) {
		do logStatus(display,pLogFile,sc,5,pParentPid)
		do:$g(%msg)'="" log(display,pLogFile,%msg,5,,pParentPid)
		goto exit
	}
	if $isObject(statsOref) {
		set sc = $$saveTTInfo(iqn,classname,.statsOref,startTime,$s(ClearValues:1,(+extentsize)=0:1,$normalize(tSampleSize/extentsize,6)>1:1,1:$normalize(tSampleSize/extentsize,6)),lastNumRowsChanged)
		do:$$$ISERR(sc) logStatus(display,,sc,5,pParentPid)
		do DeleteExtentCQ^%SYS.SQLSRV(extentname,,1)
		// Kick off a daemon to recompile any "Stale" CQs in this namespace.  Ignore if there is any error
		set sc=$$QueueSystem^%SYS.WorkQueueMgr(,"$$RegenerateStaleCQsSingleNS^%SYS.SQLSRV")
	} else {
			#;  Now update the Q.O. computed estimate map statistics since the EXTENTSIZE probably changed
		if updated {
			set sc=$$NumberOfTuples^%ocsSQLRTDict(extentname,ClearValues)	//DPV1726=
			If $$$ISERR(sc) {
				do logStatus(display,pLogFile,sc,5,pParentPid)
				do:$g(%msg)'="" log(display,pLogFile,%msg,5,,pParentPid)
			}
		}
.
		set tTS=$zu(188)
		If 'KeepClassUpToDate,classid {	// Save/Close the class.
			set sc=$$Save^%apiDDL(classid,1)
			If $$$ISERR(sc) {
				do logStatus(display,pLogFile,sc,5,pParentPid)
				do:$g(%msg)'="" log(display,pLogFile,%msg,5,,pParentPid)
			}
			s sc=$$Close^%apiCDL(classid)
			if $$$ISERR(sc) {
				do logStatus(display,pLogFile,sc,5,pParentPid)
				do:$g(%msg)'="" log(display,pLogFile,%msg,5,,pParentPid)
				goto exit
			}
		} else {
				#; if we are done with the class here, update the DEF/COM timestamps
			$$$defClassKeySet(classname,$$$cCLASStimechanged,tTS)
			Do RebuildItemIndex^%R(classname,"CLS",,1)
			set sc=$$KeepClassUpToDate^%occDepend(classname)
			if $$$ISERR(sc) { do logStatus(display,pLogFile,sc,5,pParentPid) }
		}
		
		if sharded=2,updated {
			#; If we just tuned a sharded table, we have measured tune statistics on the shard local table, and stored the tune stats on the shard-master class/table
			#; Now we will copy the tune stats from the shard-master class/table to the shard-local class table
			set shardMasterExtent=$$getMasterClassName^%SYS.SHARDSRV(extentname)
			set sc=$$CopyTuneStats(extentname,shardMasterExtent,KeepClassUpToDate,display,pLogFile)
		}
		#;  If we have uppdated the ^oddEXTR EXTENTSIZE & SELECTIVITY & NumberOfBlocks, Purge all Cached Queries which might be affected
		If updated { do PostTune(extentname,schema,tablename,tTS,pRecompileCQ,display,pLogFile) }
	}
exit
	Do $zu(68,25,batch)
	do:systemTask ##class(%SQL.Diag.Result).addSystemTaskDiagMessage(systemTaskNS,systemTask,"Collect Table Statistics for "_$namespace_":"_table,"commands: "_($zu(67,8,$J)+$system.Context.WorkMgr().CommandsExecuted-cmdCnt)_", physical block read: "_($zu(67,34,$J)-physicalBlkReadCnt)_", duration: "_($zh-tuneStartTime)_" secs")
	if pLogFile'="",$g(sharded)<2 { set sc = $$WriteToLogFile(pLogFile,%TTNS) do:$$$ISERR(sc) logStatus(display,,sc,5,pParentPid)}
	if $g(classid) { do Close^%apiCDL(classid) }
	set:'$d(SQLCODE) SQLCODE=0
	$$$DebugTrace("tune^%qarTune(EXIT): SQLCODE="_$g(SQLCODE,"<undef>"))
	RETURN
 
tuneErr	;         Error trap for tuning a table.
	Do $zu(68,25,batch)
	set $zt="" 
	set SQLCODE=-400,%msg="Error:  $ZE="_$ze
	$$$AppendErrMsg
	do:systemTask ##class(%SQL.Diag.Result).addSystemTaskDiagMessage(systemTaskNS,systemTask,"Collect Table Statistics for "_$namespace_":"_table,"commands: "_($zu(67,8,$J)+$system.Context.WorkMgr().CommandsExecuted-cmdCnt)_", physical block read: "_($zu(67,34,$J)-physicalBlkReadCnt)_", duration: "_($zh-tuneStartTime)_" secs, error: $ze="_$ze)
	$$$DebugTrace("tune^%qarTune(ERROR): $ze="_$ze)
	if $g(tHandle) { kill $$$tFile(tHandle) }  // clear the temp file
	do log(display,pLogFile,$$$FormatText($$$Text("An error occurred processing the table %1.%2:  %3","%SQL.TuneTable"),$g(schema,"???"),$g(tablename,"???"),$ze),5)
	if pLogFile'="" { set sc = $$WriteToLogFile(pLogFile,%TTNS) do:$$$ISERR(sc) logStatus(display,,sc,5,pParentPid)}
	set $ze=""
	RETURN
}
saveTTInfo(iqn,classname,&statsOref,startTime="",samplePerc="",lastNumRowsChanged="") [] PUBLIC {
	set sc=$$GetStorageInfo(iqn,.statsOref)
    RETURN:$$$ISERR(sc) sc
    set statsOref.UserName=$username
    set statsOref.EndTime=$ZDATETIME($ZTIMESTAMP,3,,9)
    set statsOref.Duration=$zh-startTime
    set statsOref.SamplePercent=samplePerc
	if ##class(%ExtentMgr.TableStats).%ExistsId(classname){
    	set obj=##class(%ExtentMgr.TableStats).%OpenId(classname,,.sc)
	} else {
		set obj=##class(%ExtentMgr.TableStats).%New(classname)
	}
	if lastNumRowsChanged'="" {
		set obj.LastNumRowsChanged=lastNumRowsChanged
	}
	RETURN:(obj="")||($$$ISERR(sc)) sc
    set sc=obj.TableStatsInfo.Insert(statsOref)
	RETURN:$$$ISERR(sc) sc
    set sc=obj.%Save()
	RETURN sc
}
 
.
	/// Code to execute after a table has been tuned
	/// Purge/Recompile cached queries
	/// Update ^rINDEXSQL/^oddEXTR timestamp
	/// called from: tune, %CSP.UI.Portal.SQL.TuneTable.SetSelValues()
PostTune(extentname,schema,tablename,timestamp="",pRecompileCQ=0,display,pLogFile) [] PUBLIC {
	set:timestamp="" timestamp=$zu(188)
	set $li($$$EXTsqlinfo($$$rEXT,extentname),6)=timestamp
	set $li(^rINDEXSQL("rv",$$$UPPER(schema),$$$UPPER(tablename)),5)=timestamp
	do DeleteExtentCQ^%SYS.SQLSRV(extentname,,1)
		// Kick off a daemon to recompile any "Stale" CQs in this namespace.  Ignore if there is any error
	set sc=$$QueueSystem^%SYS.WorkQueueMgr(,"$$RegenerateStaleCQsSingleNS^%SYS.SQLSRV")
	#; if 'pRecompileCQ { do DeleteExtentCQ^%SYS.SQLSRV(extentname,,1) }	///***
	#; else { 
	#; 	do CompileExtentCQ^%SYS.SQLSRV(extentname,.tMessages)
	#; 	for i=1:1:$g(tMessages) { do log(display,pLogFile,tMessages(i),5) }
	#; }
	RETURN
}
.
	// called from:
	//  tune()
	//  %SQL.Manager.Catalog.FieldCalcSelectivityExecute
CalculateSelectivity(extentname,tabinfo,&extentsize,&cselectivity,coutliers,selectivity,outliers,&cavg,&%mmmsqlTTavg,&sc,ClearValues=0,display=0,pLogFile="",&pSampleSize,emptyTableRequested=0,pSamplePerc="",classid="",secondSelectivity,reducedSecondSelectivity,&gamma,&numMasterBlocks,&chist,&hist,sampleType=1,columnar="",&dataBlocksPercent=1,&statsOref="") [%mmmsqlTTavg,SQLCODE] PUBLIC {
	do CalculateSelectivity^%SYS.SECURITY(extentname,tabinfo,.extentsize,.cselectivity,.coutliers,.selectivity,.outliers,.cavg,.%mmmsqlTTavg,.sc,ClearValues,display,pLogFile,.pSampleSize,emptyTableRequested,.pSamplePerc,.classid,.secondSelectivity,.reducedSecondSelectivity,.gamma,.numMasterBlocks,.chist,.hist,sampleType,columnar,.dataBlocksPercent,.statsOref)
	QUIT
}
	
	// Called from:
	//	CalulateSelectivity^%SYS.SECURITY
	; make sure studio can display histogram correctly, and 128 should be sufficient to calculate range sel.
#define maxBucketValLength 128
CalculateSelectivity2(extentname,tabinfo,&extentsize,&cselectivity,&coutliers,&selectivity,&outliers,&cavg,&%mmmsqlTTavg,&sc=1,ClearValues=0,display=0,pLogFile="",&pSampleSize,emptyTableRequested=0,&pSamplePerc,&classid,&secondSelectivity,&reducedSecondSelectivity,&gamma,&numMasterBlocks,&chist,&hist,sampleType,columnar,&dataBlocksPercent,&statsOref="") [%mmmsqlTTavg,%mmmsqlTTsc,SQLCODE,%mmmsqlTTallRowsArray,%mmmsqlTTrowList] PUBLIC {
		#;  Calculate the sample size for a table
		#;  Parameters:
		#;     extentname   - Table's extent name, required
		#;     tabinfo      - Table's extent sqlinfo metadata
		#;     extentsize   - PBR, extentsize for this table (calculated from block sampling)
		#;     cselectivity - PBR, array subscripted by icol of the current selectivity values
		#;     coutliers    - PBR, array subscripted by icol, of current outliers (see outliers argument)
		#;     selectivity  - PBR, array subscripted by icol of the calculated typical selectivity values
		#;     outliers     - PBR, array subscripted by icol of $lb(<outlier selectivity>, <outlier value>); not filled in unless icol has an outlier
		#;                       NOTE:selectivity for outlier is true selectivity e.g. >0, <= 1.
		#;     cavg          - PBR, array subscripted by icol of current average field size
		#;     %mmmsqlTTavg          - PBR, array subscripted by icol of measured average field size
		#;     sc           - PBR, contains status code if an error occurs
		#;     ClearValues  - 1 / 0, default 0
		#;     display      - 1 / 0, default 0
		#;     pLogFile     - default "", name of log file
		#;     pSampleSize  - PBR, number of rows sampled (calculated from pSamplePerc) 
		#;     pSamplePerc  - Sample percentage specified by user
		#;     emptyTableRequested      - 1/0 flag.  Ig 1, TuneTable was explicitly called with extentsize=0
		#;     secondSelectivity        - PBR, second order selectivity estimate, corrected for count variance (see Haas, 1996, eq 18)
		#;	   reducedSecondSelectivity - PBR, second order selectivity for outlier-free sample
		#; 	   gamma                    - PBR, coefficient of variation (measures how much occurence counts vary within the sample)
		#; 	   numMasterBlocks          - number of blocks in the master map, including big string blocks
		#; 	   chist          - array subscripted by icol of the current histogram information
		#; 	   hist          - array subscripted by icol of the calculated histogram information
		#; 	   sampleType          - 1/2/3 1 for traditional row-based sampling, 2 for block sampling, 3 for bitmap extent index sampling
		#; 	   columnar          - 1/0 if this table have columnar maps
		#;	   dataBlocksPercent	- the percentage of data block sampled in advanced data block sampling if this table is very large
		#; PVA193: hidden flag to disable RLS for tune table.
		#;         (set statment is a 'true' statement. The variable name is the square of
		#;          norls in base 26 with "a" as 0, and "z" as 25).	
.
	new %mmmsqlTTallRowsArray, %mmmsqlTTsc, %mmmsqlTTrowList, SQLCODE
	
	If $$$SQLTabConnect(extentname)'="" { 
		set %msg=$$$FormatText($$$Text("Table '%1' is external (linked through the SQL GateWay).  No SELECTIVITY Calculations will be performed.","%SQL.TuneTable"),$$$SQLLocTableSchema(tabinfo)_"."_$$$SQLLocTableName(tabinfo))
		do log(display,pLogFile,%msg)
		QUIT
	}
	
	set idField = $$$SQLLocTableRowIDField(tabinfo)
	set idFldinfo = $$$EXTSQLCOLsqlinfo($$$rEXT,extentname,idField)
	set idIcol = $$$SQLLocColNumber(idFldinfo)
	set isNumericId = $case($$$SQLLocColSQLCategory(idFldinfo),"INTEGER":1,"NUMERIC":1,"DOUBLE":1,"DATE":1,"TIME":1,"POSIXTS":1,:0) 
	set classname=$$$SQLLocTableClassname(tabinfo)
	set reSample=0
	set iqn=$$$BuildIQN($$$SQLLocTableSchema(tabinfo),$$$SQLLocTableName(tabinfo)),ttype=$$$GetTableTypeFromIQN(iqn)
	set mrirn = $$$smdLoadGetIrn(iqn)
	set hasSelectableEBM=$$$smdBitmapExtentMap(ttype,mrirn)&&$SYSTEM.SQL.Util.GetMapSelectability(iqn,$$$smdMapName($$$smdBitmapExtentMap(ttype,mrirn)))
	set skipReSample=$s(pSamplePerc'="":1,(sampleType'=2)&&('hasSelectableEBM):1,(sampleType'=2)&&(extentsize=pSampleSize):1,1:0) // skip resample if 1. user specified sample perc 2. this table does not support block sampling and there is no selectable EBM 3. the pSampleSize for non-block sampling = extentsize
	if $parameter(classname,"BIDField")'="" {
		set idName = $$quoter2($parameter(classname,"BIDField"))
		set isNumericId = 1
	} else {
		set idName = "%ID"
	}
	   #;  Now get selectivity for each field and build flist
	set field="",flist="",clist="",ilist=""
	For  {
		set field=$o($$$EXTSQLCOL($$$rEXT,extentname,field)) quit:field=""
		set fldinfo=$$$EXTSQLCOLsqlinfo($$$rEXT,extentname,field)
			#;  If the class author has defined this field to not be tuned by setting the
			#;  Property paramater CACLSELECTIVITY=0, then skip this field and all the sub-fields.
			#;  CALCSELECTIVITY=0 also means no AverageFieldSize will be measured
		continue:$$checkCALCSELECTIVITY(fldinfo,tabinfo,extentname)
		set icol=$$$SQLLocColNumber(fldinfo)
		set cselectivity(icol)=$$$SQLLocColSelectivity(fldinfo)
		set cavg(icol)=$$$SQLLocColAverageFieldSize(fldinfo)
		set chist(icol)=$$$SQLLocColHistogram(fldinfo)
		set collation(icol)=$$$SQLLocColCollation(fldinfo)
		set:$$$SQLLocColOutlierSelectivity(fldinfo)'="" coutliers(icol)=$$$SQLLocColOutlierSelectivity(fldinfo)
		if $$$SQLLocColArrayCollection(fldinfo) { set noHist(icol) = 1 }
		set fldinfo(icol) = fldinfo
		if ClearValues { 
			set (selectivity(icol),secondSelectivity(icol),reducedSecondSelectivity(icol))=$s($$$SQLLocColUnique(fldinfo)="Y":"NUMROWS",1:"")
			set extentsize = "",%mmmsqlTTavg(icol)="", numMasterBlocks="",pSampleSize="",hist(icol)=""
			continue 
		}
		elseif emptyTableRequested { set selectivity(icol)=1,%mmmsqlTTavg(icol)=0, secondSelectivity(icol)=1,reducedSecondSelectivity(icol)=1,numMasterBlocks=0,pSampleSize=0 continue }
  		  #;  UNIQUE Fields just use NUMROWS
		set fldname=$$quoter2(field)
		if ($$$SQLLocColUnique(fldinfo)="Y")||($$checkDataType^%apiDDL2($$$SQLLocColDatatype(fldinfo),$lb("%Library.Vector","%Library.DynamicArray","%Library.DynamicObject"))) {
			set selectivity(icol)="NUMROWS"
			set secondSelectivity(icol)="NUMROWS"
			set reducedSecondSelectivity(icol)="NUMROWS"
			continue:icol=idIcol
			if ($$$SQLLocColUnique(fldinfo)="Y")&&'($$checkDataType^%apiDDL2($$$SQLLocColDatatype(fldinfo),$lb("%Library.Vector","%Library.DynamicArray","%Library.DynamicObject"))) {
				set flist=flist_$e(",",flist'="")_fldname
				set clist=clist_$e(",",clist'="")_icol
				set ilist=ilist_$e(",",ilist'="")_":%ttdata("_icol_")"
			}
			set flist=flist_$e(",",flist'="")_"$length($listbuild("_fldname_"))"
			set ilist=ilist_$e(",",ilist'="")_":%ttdavg("_icol_")"
		}
		else {
	    	  #; FOR REFERENCES, WE WILL JUST COUNT THEM.  AVIEL WOULD RATHER HAVE IT
	  		  #; COUNTED BECAUSE THERE MAY BE JUST A FEW UNIQUE VALUES EVEN IF THERE ARE
  			  #; MILLIONS OF POTENTIAL ONES.
			set selectivity(icol)=""
			set secondSelectivity(icol)=""
			set reducedSecondSelectivity(icol)=""
				#; PVA272: should do DISTINCT EXACT field
			set flist=flist_$e(",",flist'="")_fldname
			set clist=clist_$e(",",clist'="")_icol
			set ilist=ilist_$e(",",ilist'="")_":%ttdata("_icol_")"
			if $$$SQLLocColStream(fldinfo)'=1 {	// Don't measure average size of stream fields
				set flist=flist_$e(",",flist'="")_"$length($listbuild("_fldname_"))"
				set ilist=ilist_$e(",",ilist'="")_":%ttdavg("_icol_")"
			}
		}
	}
	
	if (sampleType=2) {
	  	  #;  use block sampling
		QUIT:$g(flist)=""  // Nothing to query
		s rcmode=$zu(115,2) d $zu(115,2,0)  // Go into READ_UNCOMMITTED mode
		s tHandle=$i($$$tFileRoot)
		s table=$$quoter2($$$SQLLocTableSchema(tabinfo))_"."_$$quoter2($$$SQLLocTableName(tabinfo))
	  	
	  	  #; Get the number of data blocks in the global.
	  	  #; make sure table has smd entries
		set iqn=$$$BuildIQN($$$SQLLocTableSchema(tabinfo),$$$SQLLocTableName(tabinfo))
		set mrirn = $$$smdLoadGetIrn(iqn)
		do GetGlobalInfo(iqn, mrirn, .imp, .gName, .DIR, .ns, .DB, .DBS, .CT) 
		if pSamplePerc'="" {
			set tSave=pSamplePerc
			set:pSamplePerc["%" pSamplePerc=pSamplePerc/100	// Turn ##% into .##
			if pSamplePerc<=0||(pSamplePerc>1) {
				if tSave["%" {
					set %msg = $$$FormatText($$$Text("SamplePercent size argument must be greater than 0% and not greater than 100%. %1 was passed in.","%SQL.TuneTable"),tSave)
					do log(display,pLogFile,%msg,5)
					set sc=$$$ERROR($$$GeneralError,%msg) goto end
				}
				set %msg = $$$FormatText($$$Text("SamplePercent size argument must be greater than 0 and not greater than 1. %1 was passed in.","%SQL.TuneTable"),tSave)
				do log(display,pLogFile,%msg,5)
				set sc=$$$ERROR($$$GeneralError,%msg) goto end
			}
		}
		do GetDataBlocks(gName,pSamplePerc,.blockArray,.DIR,.IG,.IGL,.dataBlocksPercent)
		set numBlocks = blockArray
	  	  #; if numBlocks = -1, then there was an error getting the number of data blocks
		if numBlocks = -1 {
			set extentsize = -1, %msg=$$$Text("ERROR getting the number of blocks in table.","%SQL.TuneTable")
			set sc=$$$ERROR($$$GeneralError,%msg)
			do log(display,pLogFile,%msg,5)
			goto end
		}
	  	  #;  If the table has no data (i.e. numBlocks = 0 or numBlocks = 1 but there is no descendants for this global), don't tune the table.
	  	  #;  The data for the table has probably not been inserted yet.
		if ((numBlocks=0)||((numBlocks=1)&&($d(@gName)=1)))&&('emptyTableRequested) {
			set extentsize = 0, numMasterBlocks = 0, pSampleSize = 0
			kill selectivity	
			do log(display,pLogFile,$$$Text("The table has no data. No tuning will be performed.","%SQL.TuneTable"),5)
			if $g(classid) {
				set sc=$$Close^%apiCDL(classid)	// probably was opened in ComputeMapBlocks
				if $$$ISERR(sc) {
					do logStatus(display,pLogFile,sc,5)
					do:$g(%msg)'="" log(display,pLogFile,%msg,5)
				}
			}
			goto end
		}
	  
	  	  #; Determine the block sample size. Overall sample size might have been passed in as a % of rows.
	  	  #; The arithmetic here is:
	  	  #;
	  	  #;    pSamplePerc = blockSamplePerc * rowSamplePerc
	  	  #;
	  	  #; so an easy choice is:
	  	  #;
	  	  #;    blockSamplePerc = rowSamplePerc =
	  	  #;                    = $zsqr(pSamplePerc)
	  	  #;
	  	  #; If the user does not specify a sample percentage, we cannot do this directly because, with the
	  	  #; previous default sampling, we relied on already knowing the extent size. We had:
	  	  #;
	  	  #;    samplesize = 3*$zsqr(extentsize) ->
	  	  #;    pSamplePerc = 3*$zsqr(extentsize)/extentsize = 
	  	  #;                = 3/$zsqr(extentsize)
	  	  #;
	  	  #; Now, we no longer know the extent size a priori. Instead, we achieve the same sample percent with:
	  	  #;
	  	  #;    blockSamplePerc = $zsqr(3/numBlocks)
	  	  #;    rowSamplePerc = $zsqr(3/rowsPerBlock) ->
	  	  #;    pSamplePerc = 3/$zsqr(numBlocks * rowsPerBlock) =
	  	  #;                = 3/$zsqrt(extentsize)
 
		if pSamplePerc'="" {
			set blockSamplePerc = $s(dataBlocksPercent'=1:1,1:$zsqr(pSamplePerc)), rowSamplePerc = $zsqr(pSamplePerc)
		}
		else {
		  	  #; if few enough blocks, then sample all of them (and all of the rows)
			if numBlocks < 100	{ set blockSamplePerc = 1, rowSamplePerc = 1 } 
			else 				{ set blockSamplePerc = $s((100/numBlocks)<$zsqr(3/numBlocks):$zsqr(3/numBlocks),1:(100/numBlocks)), defaultSize = 1 }
		}
	
	  	  #; number of blocks sampled = blockSamplePerc * numBlocks
		set blockSampleSize = $normalize(blockSamplePerc * numBlocks,0)
		if (dataBlocksPercent'=1)&&(pSamplePerc="") {
			set blockSampleSizeWithoutAdvSample = $normalize($zsqr(3/(numBlocks\dataBlocksPercent))* (numBlocks\dataBlocksPercent),0)
			set blockSampleSize = $s(blockSampleSizeWithoutAdvSample>numBlocks:(blockSampleSize+numBlocks)\2,1:(blockSampleSize+blockSampleSizeWithoutAdvSample)\2)
		}
type2Sample
		set blockSampleCount = 0
		set blockSampleCountTwo = 0
		set bigBlockCounter = 0
		set i = 0
		kill:'reSample sampled // for reSample=1, we do want to keep sampled so that we can pick different block
	
	  	  #; loop over the blocks and get a list of all of the rows in the sample
	  	  #; this also lets us calculate the extent size	  
		try {
			set sLev = $$$smdMapRowIDStartLev(imp),lLev = $$$smdMapRowIDLastLev(imp),idSubLev=$O($$$smd(12,imp,6,""),-1)-(+columnar)
			kill:'reSample boundaryIds
			set idSkipLev = $s($$$SQLLocTablePartitioned(tabinfo):lLev-1,1:0)
			set isCompoundId = (lLev>sLev)
			open 63:"^^"_DIR
			for {
				set sampleThisBlock = 0
				quit:blockSampleCount=blockSampleSize
				if blockSamplePerc = 1 {
					set i = i + 1, sampleThisBlock = 1
				}
		  	  	  #; if block sampling percentage is high, then use sampling method
		  	  	  #; that avoids selecting duplicate blocks
				elseif ('reSample)&&(blockSamplePerc > .3){
					set i = i + 1
					if ($random(numBlocks - i + 1)<(blockSampleSize - blockSampleCount)){
						set sampleThisBlock = 1,sampled(i)=1
					}
				}
		  	  	  #; otherwise, just choose random blocks and try again
		  	  	  #; in case you select a duplicate
				else{
					set i=1+$random(numBlocks)
					if '$data(sampled(i)){
						set sampled(i)=1
						set sampleThisBlock = 1
					}
				}
				if sampleThisBlock {
			  	  	  #; load current block into view buffer
					set curBlock = blockArray(i)
					do $increment(blockSampleCount),$increment(blockSampleCountTwo)
					do GetIdsFromBlock(.curBlock, isNumericId, IGL, IG, .bigBlockCounter,isCompoundId,sLev,lLev,idSubLev,idSkipLev,.%mmmsqlTTallRowsArray, .rowCounter, .numTotalRows, .totalIdFieldSize,.boundaryIds)
					if rowCounter = 0 {set blockSampleCount = blockSampleCount - 1}
					quit:('reSample)&&(blockSampleCountTwo>(numBlocks/3))&&(blockSampleCountTwo>=blockSampleSize)&&($get(numTotalRows)>=100)
					quit:reSample&&(blockSampleCountTwo=blockSampleSize)
					quit:(blockSampleCount=blockSampleSize)||(blockSampleCountTwo=numBlocks)
				}
			}
		}
		catch exception{
			set %msg=$$$FormatText($$$Text("Encountered a problem getting the sample while calculating selectivity for table '%1'.","%SQL.TuneTable"),$$$SQLLocTableSchema(tabinfo)_"."_$$$SQLLocTableName(tabinfo)_"  "_exception.DisplayString())
			do log(display,pLogFile,%msg)
		}
		close 63
	  	  #; make sure smd is clean
		set i=$zu(68,28,0) kill $$$smdRoot do $zu(68,28,i)
	
	  	  #; if sampleThisBlock was never true, then we didn't get a sample,
	  	  #; thus, set extentsize and samplesize to zero and quit.
		if '$get(numTotalRows) {
			set extentsize = -1, numMasterBlocks = 0, pSampleSize = 0, %msg = $$$Text("Could not obtain a sample of rows. Table stats will not be updated.","%SQL.TuneTable")
			do log(display,pLogFile,%msg,5)
			goto end
		}
		
		if 'reSample {
		  	  #; estimate number of blocks in the master map, including big string blocks
			set numMasterBlocks = (bigBlockCounter/blockSampleSize)*numBlocks+numBlocks
		
		  	  #; now that we know the number of rows sampled, we can estimate extentsize
			set rowsPerBlock = numTotalRows/blockSampleSize
			
			
				#; if needed, set the row sample percentage
			if $get(defaultSize)&&('reSample){ // for resample=1, use the same rowSamplePerc
				if rowsPerBlock <= 4 { set rowSamplePerc = 1 } 
				else { set rowSamplePerc = $zsqr(3/rowsPerBlock)}
			}
		} else {
			set numMasterBlocks = ((firstBigBlockCounter+bigBlockCounter)/(firstBlockSampleSize+blockSampleSize))*numBlocks+numBlocks
			set rowsPerBlock = (firstNumTotalRows+numTotalRows)/(firstBlockSampleSize+blockSampleSize)
		}
		set extentsize = $normalize(rowsPerBlock*numBlocks,0)
	  	  #; now we know rowSamplePerc for certain; set the row sample size
		set rowSampleSize = $normalize(rowSamplePerc * numTotalRows,0)
		set pSampleSize = rowSampleSize
.
	  	  #; generate the code to sample rows
		set code($i(code(0)))="#define %occSqlfuncinc"
		set include="" for  set include=$$$comClassArrayNext(extentname,$$$cCLASSincludecodeall,include) quit:include=""  set code($i(code(0)))="#include "_include
		set code($i(code(0)))="#include %occInclude"
		If rowSamplePerc'=1 {
			set code($i(code(0)))="Main(%mmmsqlTTnumTotalRows,%mmmsqlTTsampleSize,%mmmsqlTTtHandle,%mmmsqlTTallRowsArray,&%mmmsqlTTavg,SQLCODE,&%mmmsqlTTsc) n %mmmsqlTTi,%mmmsqlTTii,%mmmsqlTTvalue,%ROWCOUNT,%ROWID,%mmmsqlTTsampled,%mmmsqlTTsampleThisRow,%mmmsqlTTrowList,%mmmsqlTTscnt,%mmmsqlTTsubs,%mmmsqlTTtotavg,%mmmsqlTTtotal,%ttID,%ttdata,%ttdavg,%ID,%mmmsqlTTidList"_$s('skipReSample:", %mmmsqlTTSubsetPos",1:"")_"  s %mmmsqlTTscnt=0"
			set code($i(code(0)))=" set %mmmsqlTTi = 0, %mmmsqlTTrowList = 1, %mmmsqlTTrowList(1)="""", %mmmsqlTTsc=$$$OK"_$s('skipReSample:", %mmmsqlTTSubsetPos=3",1:"")
			set code($i(code(0)))=" For {"
			set code($i(code(0)))="		set %mmmsqlTTsampleThisRow = 0"
			set code($i(code(0)))="		quit:%mmmsqlTTscnt=%mmmsqlTTsampleSize"
			set code($i(code(0)))="		if %mmmsqlTTsampleSize/%mmmsqlTTnumTotalRows > .3 {"
			set code($i(code(0)))="			set %mmmsqlTTi = %mmmsqlTTi + 1"
			set code($i(code(0)))="			if $random(%mmmsqlTTnumTotalRows - %mmmsqlTTi + 1)<(%mmmsqlTTsampleSize - %mmmsqlTTscnt){"
			set code($i(code(0)))="				set %mmmsqlTTsampleThisRow = 1"
			set code($i(code(0)))="			}"
			set code($i(code(0)))="		}"
			set code($i(code(0)))="		else {"
			set code($i(code(0)))="			set %mmmsqlTTi=1+$random(%mmmsqlTTnumTotalRows)"
			set code($i(code(0)))="			if '$data(%mmmsqlTTsampled(%mmmsqlTTi)){"
			set code($i(code(0)))="				set %mmmsqlTTsampled(%mmmsqlTTi) = 1"
			set code($i(code(0)))="				set %mmmsqlTTsampleThisRow = 1"
			set code($i(code(0)))="			}"
			set code($i(code(0)))="		}"
			set code($i(code(0)))="		if %mmmsqlTTsampleThisRow {"
			set code($i(code(0)))="			set %mmmsqlTTidList = $listbuild(%mmmsqlTTallRowsArray(%mmmsqlTTi))"
			set code($i(code(0)))="     	if $length(%mmmsqlTTrowList(%mmmsqlTTrowList))+$length(%mmmsqlTTidList)<32000 {"
			set code($i(code(0)))="     		set %mmmsqlTTrowList(%mmmsqlTTrowList) = %mmmsqlTTrowList(%mmmsqlTTrowList)_%mmmsqlTTidList"
			set code($i(code(0)))=" 		} else {"
			set code($i(code(0)))=" 			set %mmmsqlTTrowList($I(%mmmsqlTTrowList)) = %mmmsqlTTidList"
			set code($i(code(0)))=" 		}"
			set code($i(code(0)))="     	set %mmmsqlTTscnt=%mmmsqlTTscnt+1"
			set code($i(code(0)))=" 	}"
			set code($i(code(0)))=" } "
			set code($i(code(0)))=" for %mmmsqlTTi = 1:1:%mmmsqlTTrowList {"
			set code($i(code(0)))=" 	&sql(DECLARE getRows CURSOR for SELECT %NOLOCK "_flist_",%ID INTO "_ilist_",:%ID FROM "_table_" WHERE %ID %INLIST :%mmmsqlTTrowList(:%mmmsqlTTi) /*#OPTIONS { ""TuneTable"":1 } */)"
			set code($i(code(0)))=" 	&sql(OPEN getRows)"
			set code($i(code(0)))=" 	For {"
			set code($i(code(0)))=" 		&sql(FETCH getRows) if SQLCODE'=0 { s:SQLCODE<0 sc=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode^%qarTune(SQLCODE)_""::""_$g(%msg)) quit }"
			set code($i(code(0)))="     	set %mmmsqlTTsubs = $select($l(%ID)>120:$zcrc(%ID,9),1:%ID)"
			set code($i(code(0)))="			set "_$$$tFileQ_"(%mmmsqlTTtHandle,1,%mmmsqlTTsubs)=$lb(1,%ID)"
			set code($i(code(0)))="     	set %mmmsqlTTii="""""_$s('skipReSample:",%mmmsqlTTSubsetPos=$s(%mmmsqlTTSubsetPos=3:4,1:3)",1:"")
			set code($i(code(0)))="     	for { s %mmmsqlTTii=$o(%ttdata(%mmmsqlTTii),1,%mmmsqlTTvalue) q:%mmmsqlTTii=""""  "
			set code($i(code(0)))="			  s:$l(%ttdata(%mmmsqlTTii))>120 %ttdata(%mmmsqlTTii)=$zcrc(%mmmsqlTTvalue,9) s:%ttdata(%mmmsqlTTii)="""" %ttdata(%mmmsqlTTii)="_$$$NULLSubscriptMarker19
			set code($i(code(0)))="			  if '$d("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii))){s "_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii))=$lb(1,%mmmsqlTTvalue)} else {s $li("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),1)=1+$li("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),1)} " 	// DPV2471=, PVA272
			if 'skipReSample {
				set code($i(code(0)))="			  s $li("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),%mmmsqlTTSubsetPos)=1+$lg("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),%mmmsqlTTSubsetPos) " 	// DPV2471=, PVA272	
			}
			set code($i(code(0)))="     	}"
			
			set code($i(code(0)))="     	for { set %mmmsqlTTii=$o(%ttdavg(%mmmsqlTTii),1,%mmmsqlTTtotavg) quit:%mmmsqlTTii=""""  set %mmmsqlTTtotal(%mmmsqlTTii)=$g(%mmmsqlTTtotal(%mmmsqlTTii))+%mmmsqlTTtotavg }"
			set code($i(code(0)))=" 	}"
			set code($i(code(0)))=" 	&sql(CLOSE getRows)"
		} Else {
			set code($i(code(0)))="Main(%mmmsqlTTnumTotalRows,%mmmsqlTTsampleSize,%mmmsqlTTtHandle,%mmmsqlTTallRowsArray,&%mmmsqlTTavg,SQLCODE,&%mmmsqlTTsc) n %mmmsqlTTi,%mmmsqlTTii,%mmmsqlTTj,%mmmsqlTTrowList,%mmmsqlTTvalue,%ROWCOUNT,%ROWID,%mmmsqlTTsubs,%mmmsqlTTtotavg,%mmmsqlTTtotal,%ttID,%ttdata,%ttdavg,%ID,%mmmsqlTTidList"_$s('skipReSample:", %mmmsqlTTSubsetPos",1:"")
			set code($i(code(0)))=" set %mmmsqlTTrowList = 1, %mmmsqlTTrowList(1)="""", %mmmsqlTTsc=$$$OK"_$s('skipReSample:", %mmmsqlTTSubsetPos=3",1:"")
			set code($i(code(0)))=" For %mmmsqlTTi=1:1:%mmmsqlTTnumTotalRows {"
			set code($i(code(0)))="		set %mmmsqlTTidList = $listbuild(%mmmsqlTTallRowsArray(%mmmsqlTTi))"
			set code($i(code(0)))="     if $length(%mmmsqlTTrowList(%mmmsqlTTrowList))+$length(%mmmsqlTTidList)<32000 {"
			set code($i(code(0)))="     	set %mmmsqlTTrowList(%mmmsqlTTrowList) = %mmmsqlTTrowList(%mmmsqlTTrowList)_%mmmsqlTTidList"
			set code($i(code(0)))=" 	} else {"
			set code($i(code(0)))=" 		set %mmmsqlTTrowList($I(%mmmsqlTTrowList)) = %mmmsqlTTidList"
			set code($i(code(0)))=" 	}"
			set code($i(code(0)))=" }"
			set code($i(code(0)))=" for %mmmsqlTTj = 1:1:%mmmsqlTTrowList {"
			set code($i(code(0)))=" 	&sql(DECLARE getRows CURSOR for SELECT %NOLOCK "_flist_",%ID INTO "_ilist_",:%ID FROM "_table_" WHERE %ID %INLIST :%mmmsqlTTrowList(:%mmmsqlTTj) /*#OPTIONS { ""TuneTable"":1 } */)"
			set code($i(code(0)))=" 	&sql(OPEN getRows)"
			set code($i(code(0)))=" 	For {"
			set code($i(code(0)))=" 		&sql(FETCH getRows) if SQLCODE'=0 { s:SQLCODE<0 %mmmsqlTTsc=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode^%qarTune(SQLCODE)_""::""_$g(%msg)) quit }"
			set code($i(code(0)))="     	set %mmmsqlTTsubs = $select($l(%ID)>120:$zcrc(%ID,9),1:%ID)"
			set code($i(code(0)))="	    	set "_$$$tFileQ_"(%mmmsqlTTtHandle,1,%mmmsqlTTsubs)=$lb(1,%ID)"
			set code($i(code(0)))="    	 	set %mmmsqlTTii="""""_$s('skipReSample:",%mmmsqlTTSubsetPos=$s(%mmmsqlTTSubsetPos=3:4,1:3)",1:"")
			s code($i(code(0)))="     		for { s %mmmsqlTTii=$o(%ttdata(%mmmsqlTTii),1,%mmmsqlTTvalue) q:%mmmsqlTTii=""""  "
			s code($i(code(0)))="			  	  s:$l(%ttdata(%mmmsqlTTii))>120 %ttdata(%mmmsqlTTii)=$zcrc(%mmmsqlTTvalue,9) s:%ttdata(%mmmsqlTTii)="""" %ttdata(%mmmsqlTTii)="_$$$NULLSubscriptMarker19
			s code($i(code(0)))="			      if '$d("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii))){s "_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii))=$lb(1,%mmmsqlTTvalue)} else {s $li("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),1)=1+$li("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),1)} " 	// DPV2471=, PVA272
			if 'skipReSample {
				s code($i(code(0)))="			      s $li("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),%mmmsqlTTSubsetPos)=1+$lg("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),%mmmsqlTTSubsetPos) " 	// DPV2471=, PVA272	
			}
			s code($i(code(0)))="     	    }"
			set code($i(code(0)))="     	for  { set %mmmsqlTTii=$o(%ttdavg(%mmmsqlTTii),1,%mmmsqlTTtotavg) quit:%mmmsqlTTii=""""  set %mmmsqlTTtotal(%mmmsqlTTii)=$g(%mmmsqlTTtotal(%mmmsqlTTii))+%mmmsqlTTtotavg }"
			set code($i(code(0)))=" 	}"
			set code($i(code(0)))=" 	&sql(CLOSE getRows)"	
		}
		set code($i(code(0)))=" }"
		set code($i(code(0)))=" set %mmmsqlTTii="""" for  { set %mmmsqlTTii=$o(%mmmsqlTTtotal(%mmmsqlTTii)) quit:%mmmsqlTTii=""""  set %mmmsqlTTavg(%mmmsqlTTii)=$normalize(%mmmsqlTTtotal(%mmmsqlTTii)/%mmmsqlTTsampleSize,2) set:%mmmsqlTTavg(%mmmsqlTTii)=0 %mmmsqlTTavg(%mmmsqlTTii)=1 }"
  		set code($i(code(0)))=" if SQLCODE<0 s %mmmsqlTTsc=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode^%qarTune(SQLCODE)_""::""_$g(%msg))"
  		set code($i(code(0)))=" QUIT"
		set code($i(code(0)))="#undef %occSqlfuncinc"
		
	  	  #; run the temp code to sample the rows
	  	kill:'reSample $$$tFile(tHandle)
		do RunTempCode^%SYS.SQLSRV(.code,"Main",,.SQLCODE,.%msg,"Getting sample of rows from data blocks for table "_table,numTotalRows_","_rowSampleSize_","_tHandle_",.%mmmsqlTTallRowsArray,.%mmmsqlTTavg,.SQLCODE,.%mmmsqlTTsc")
		set %mmmsqlTTavg(idIcol)=$s('reSample:$normalize(totalIdFieldSize/numTotalRows,2),1:$normalize((firstTotalIdFieldSize+totalIdFieldSize)/(firstNumTotalRows+numTotalRows),2))
		if $$$ISERR(%mmmsqlTTsc) { set sc=$$$ERROR($$$SQLError,-400,"Failed to get sample of rows from data blocks for table "_table_" "_$g(%msg)) GOTO end }
	  	if SQLCODE<0 { set sc=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode(SQLCODE)_"::"_$g(%msg)) GOTO end }
	} else {
		  #; use old sampling strategy or ebm sampling
		QUIT:$g(flist)=""  // Nothing to query
	  	s rcmode=$zu(115,2) d $zu(115,2,0)  // Go into READ_UNCOMMITTED mode
	  	s tHandle=$i($$$tFileRoot)
	  	s table=$$quoter2($$$SQLLocTableSchema(tabinfo))_"."_$$quoter2($$$SQLLocTableName(tabinfo))
 		s partitionKey=$$$SQLLocTablePartitionKey(tabinfo)
type13Sample
 	  	set code($i(code(0)))="#define %occSqlfuncinc"
	  	set include="" for  set include=$$$comClassArrayNext(extentname,$$$cCLASSincludecodeall,include) quit:include=""  set code($i(code(0)))="#include "_include
	  	set code($i(code(0)))="#include %occInclude"
	  	If extentsize'=pSampleSize {
		  	if sampleType=3 {
	 			set iqn=$$$BuildIQN($$$SQLLocTableSchema(tabinfo),$$$SQLLocTableName(tabinfo))
				set mrirn = $$$smdLoadGetIrn(iqn)
				do GetGlobalInfo(iqn, mrirn, .imp, .gName,,,,,,1) 
				#; if reSample, we need to skip the id that has been sampled in the first run, 
				#; so the total number that can be sample is extentsize-firstSampleSize
				do SampleEBM(gName,$s('reSample:extentsize,1:extentsize-firstSampleSize),pSampleSize,$$$SQLLocTablePartitioned(tabinfo),partitionKey,.%mmmsqlTTrowList,.totalIdFieldSize,reSample,.sampledIds)
				set code($i(code(0)))="Main(%mmmsqlTTsampleSize,%mmmsqlTTtHandle,&%mmmsqlTTrowList,&%mmmsqlTTavg,SQLCODE,&%mmmsqlTTsc) n %mmmsqlTTi,%mmmsqlTTii,%mmmsqlTTvalue,%ROWCOUNT,%ROWID,%mmmsqlTTsubs,%mmmsqlTTtotavg,%mmmsqlTTtotal,%ttID,%ttdata,%ttdavg,%ID,%mmmsqlTTidList"_$s('skipReSample:",%mmmsqlTTSubsetPos",1:"")
	 			s code($i(code(0)))=" set %mmmsqlTTsc=$$$OK"_$s('skipReSample:", %mmmsqlTTSubsetPos=3",1:"")
	 		} else {
		 		#; sampletype=1
		  		s code($i(code(0)))="Main(%mmmsqlTTes,%mmmsqlTTss,%mmmsqlTTtHandle,&%mmmsqlTTavg,SQLCODE,&%mmmsqlTTsc) s $zt=""Error"" n %mmmsqlTTi,%mmmsqlTTii,%mmmsqlTTvalue,%ROWCOUNT,%ROWID,%mmmsqlTTscnt,%mmmsqlTTsubs,%mmmsqlTTtotavg,%mmmsqlTTtotal,%ttID,%ttdata,%ttdavg,%mmmsqlTTrowList,%mmmsqlTTidList"_$s('skipReSample:",%mmmsqlTTSubsetPos",1:"")_" s %mmmsqlTTscnt=0"
				s code($i(code(0)))=" set %mmmsqlTTi = 0, %mmmsqlTTrowList = 1, %mmmsqlTTrowList(1)="""""
		  		s code($i(code(0)))=" &sql(DECLARE tt CURSOR FOR SELECT %NOLOCK "_idName_" INTO :%ttID FROM "_table_" /*#OPTIONS { ""TuneTable"":1 } */)"
		  		s code($i(code(0)))=" s %mmmsqlTTsc=$$$OK"_$s('skipReSample:", %mmmsqlTTSubsetPos=3",1:"")
		  		s code($i(code(0)))=" &sql(OPEN tt)"
		  		s code($i(code(0)))=" if SQLCODE<0 s %mmmsqlTTsc=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode^%qarTune(SQLCODE)_""::""_$g(%msg)) quit"
		  		s code($i(code(0)))=" For %mmmsqlTTi=1:1:%mmmsqlTTes {"
		  		s code($i(code(0)))="		quit:%mmmsqlTTscnt=%mmmsqlTTss"
		  		s code($i(code(0)))="       &sql(FETCH tt)"
		  		s code($i(code(0)))="       if SQLCODE<0 s %mmmsqlTTsc=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode^%qarTune(SQLCODE)_""::""_$g(%msg)) quit"
		  		s code($i(code(0)))="       quit:SQLCODE"
		  		if reSample { // skip sampled ID
			  		s code($i(code(0)))="       if $d("_$$$tFileQ_"(%mmmsqlTTtHandle,1,%ttID)) {"
			  		s code($i(code(0)))="       	set %mmmsqlTTi=%mmmsqlTTi-1"	
			  		s code($i(code(0)))="       	continue"
			  		s code($i(code(0)))="       }"	
			  	}
		  		s code($i(code(0)))="		If $r(%mmmsqlTTes-%mmmsqlTTi+1)<(%mmmsqlTTss-%mmmsqlTTscnt) {"
				s code($i(code(0)))="     		set %mmmsqlTTidList = $listbuild("_$s(isNumericId:"+",1:"")_"%ttID), %mmmsqlTTtotal("_idIcol_")=$g(%mmmsqlTTtotal("_idIcol_"))+$length(%mmmsqlTTidList)"
				s code($i(code(0)))="     		if $length(%mmmsqlTTrowList(%mmmsqlTTrowList))+$length(%mmmsqlTTidList)<32000 {"
				s code($i(code(0)))="     			set %mmmsqlTTrowList(%mmmsqlTTrowList) = %mmmsqlTTrowList(%mmmsqlTTrowList)_%mmmsqlTTidList"
				s code($i(code(0)))=" 			} else {"
				s code($i(code(0)))=" 				set %mmmsqlTTrowList($I(%mmmsqlTTrowList)) = %mmmsqlTTidList"
				s code($i(code(0)))=" 			}"
				s code($i(code(0)))="     		set %mmmsqlTTscnt=%mmmsqlTTscnt+1"
				s code($i(code(0)))=" 		}"
				s code($i(code(0)))=" }"
		 	}
	  		s code($i(code(0)))=" for %mmmsqlTTi = 1:1:%mmmsqlTTrowList {"
			s code($i(code(0)))=" 	&sql(DECLARE getRows CURSOR for SELECT %NOLOCK "_flist_",%ID INTO "_ilist_",:%ID FROM "_table_" WHERE %ID %INLIST :%mmmsqlTTrowList(:%mmmsqlTTi) /*#OPTIONS { ""TuneTable"":1 } */)"
			s code($i(code(0)))=" 	&sql(OPEN getRows)"
			s code($i(code(0)))=" 	For {"
			s code($i(code(0)))=" 		&sql(FETCH getRows) if SQLCODE'=0 { s:SQLCODE<0 %mmmsqlTTsc=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode^%qarTune(SQLCODE)_""::""_$g(%msg)) quit }"
			if (sampleType=3)&&(partitionKey="") {
				#; ebm sampling, the ids are incremental int, so we don't need to worry about the length
				#; unless it's a parition table
				s code($i(code(0)))="		set "_$$$tFileQ_"(%mmmsqlTTtHandle,1,%ID)=$lb(1,%ID)"
			} else {
				s code($i(code(0)))="     	set %mmmsqlTTsubs = $select($l(%ID)>120:$zcrc(%ID,9),1:%ID)"
				s code($i(code(0)))="		set "_$$$tFileQ_"(%mmmsqlTTtHandle,1,%mmmsqlTTsubs)=$lb(1,%ID)"
			}
			s code($i(code(0)))="     	set %mmmsqlTTii="""""_$s('skipReSample:",%mmmsqlTTSubsetPos=$s(%mmmsqlTTSubsetPos=3:4,1:3)",1:"")
			s code($i(code(0)))="     	for { s %mmmsqlTTii=$o(%ttdata(%mmmsqlTTii),1,%mmmsqlTTvalue) q:%mmmsqlTTii=""""  "
			s code($i(code(0)))="			  s:$l(%ttdata(%mmmsqlTTii))>120 %ttdata(%mmmsqlTTii)=$zcrc(%mmmsqlTTvalue,9) s:%ttdata(%mmmsqlTTii)="""" %ttdata(%mmmsqlTTii)="_$$$NULLSubscriptMarker19
			s code($i(code(0)))="			  if '$d("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii))){s "_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii))=$lb(1,%mmmsqlTTvalue)} else {s $li("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),1)=1+$li("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),1)} " 	// DPV2471=, PVA272
			if 'skipReSample {
				s code($i(code(0)))="			  s $li("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),%mmmsqlTTSubsetPos)=1+$lg("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),%mmmsqlTTSubsetPos) " 	// DPV2471=, PVA272	
			}
			s code($i(code(0)))="     	}"
			s code($i(code(0)))="     	for { set %mmmsqlTTii=$o(%ttdavg(%mmmsqlTTii),1,%mmmsqlTTtotavg) quit:%mmmsqlTTii=""""  set %mmmsqlTTtotal(%mmmsqlTTii)=$g(%mmmsqlTTtotal(%mmmsqlTTii))+%mmmsqlTTtotavg }"
			s code($i(code(0)))=" 	} "
			s code($i(code(0)))=" 	&sql(CLOSE getRows)"
			s code($i(code(0)))=" 	if SQLCODE<0 s %mmmsqlTTsc=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode^%qarTune(SQLCODE)_""::""_$g(%msg))"
			s code($i(code(0)))=" }"
			if sampleType=1 {
				s code($i(code(0)))=" &sql(CLOSE tt)"
  	  			s code($i(code(0)))=" if SQLCODE<0 s %mmmsqlTTsc=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode^%qarTune(SQLCODE)_""::""_$g(%msg))"
			}
	  	}
	  	Else {
		  	if sampleType=3 {
				s code($i(code(0)))="Main(%mmmsqlTTsampleSize,%mmmsqlTTtHandle,&%mmmsqlTTavg,SQLCODE,&%mmmsqlTTsc) s $zt=""Error"" n %mmmsqlTTi,%mmmsqlTTii,%mmmsqlTTvalue,%ROWCOUNT,%ROWID,%mmmsqlTTsubs,%mmmsqlTTtotavg,%mmmsqlTTtotal,%ttID,%ttdata,%ttdavg"	
			} else {
	  			s code($i(code(0)))="Main(%mmmsqlTTss,%mmmsqlTTtHandle,&%mmmsqlTTavg,SQLCODE,&%mmmsqlTTsc) s $zt=""Error"" n %mmmsqlTTi,%mmmsqlTTii,%mmmsqlTTvalue,%ROWCOUNT,%ROWID,%mmmsqlTTsubs,%mmmsqlTTtotavg,%mmmsqlTTtotal,%ttID,%ttdata,%ttdavg"
			}
			s code($i(code(0)))=" 	set %mmmsqlTTsc=$$$OK"
			s code($i(code(0)))=" 	&sql(DECLARE getRows CURSOR for SELECT %NOLOCK "_flist_",%ID INTO "_ilist_",:%ID FROM "_table_" /*#OPTIONS { ""TuneTable"":1 } */)"
			s code($i(code(0)))=" 	&sql(OPEN getRows)"
			s code($i(code(0)))=" 	For {"
			s code($i(code(0)))=" 		&sql(FETCH getRows) if SQLCODE'=0 { s:SQLCODE<0 %mmmsqlTTsc=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode^%qarTune(SQLCODE)_""::""_$g(%msg)) quit }"
			if (sampleType=3)&&(partitionKey="") {
				#; ebm sampling, the ids are incremental int, so we don't need to worry about the length
				#; unless it's a parition table
				s code($i(code(0)))="		set "_$$$tFileQ_"(%mmmsqlTTtHandle,1,%ID)=$lb(1,%ID)"
			} else {
				s code($i(code(0)))="     	set %mmmsqlTTsubs = $select($l(%ID)>120:$zcrc(%ID,9),1:%ID)"
				s code($i(code(0)))="		set "_$$$tFileQ_"(%mmmsqlTTtHandle,1,%mmmsqlTTsubs)=$lb(1,%ID)"
			}
			s code($i(code(0)))="       set %mmmsqlTTtotal("_idIcol_")=$g(%mmmsqlTTtotal("_idIcol_"))+$length($listbuild("_$s(isNumericId:"+",1:"")_"%ID))"
			s code($i(code(0)))="     	set %mmmsqlTTii="""""
			s code($i(code(0)))="     	for { s %mmmsqlTTii=$o(%ttdata(%mmmsqlTTii),1,%mmmsqlTTvalue) q:%mmmsqlTTii=""""  s:$l(%ttdata(%mmmsqlTTii))>120 %ttdata(%mmmsqlTTii)=$zcrc(%mmmsqlTTvalue,9) s:%ttdata(%mmmsqlTTii)="""" %ttdata(%mmmsqlTTii)="_$$$NULLSubscriptMarker19_" if '$d("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii))){s "_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii))=$lb(1,%mmmsqlTTvalue)} else {s $li("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),1)=1+$li("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%ttdata(%mmmsqlTTii)),1)} }" 	// DPV2471=, PVA272
			s code($i(code(0)))="     	for { set %mmmsqlTTii=$o(%ttdavg(%mmmsqlTTii),1,%mmmsqlTTtotavg) quit:%mmmsqlTTii=""""  set %mmmsqlTTtotal(%mmmsqlTTii)=$g(%mmmsqlTTtotal(%mmmsqlTTii))+%mmmsqlTTtotavg }"
			s code($i(code(0)))=" 	}"
			s code($i(code(0)))=" 	&sql(CLOSE getRows)"
			s code($i(code(0)))=" 	if SQLCODE<0 s %mmmsqlTTsc=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode^%qarTune(SQLCODE)_""::""_$g(%msg))"
	  	}
	  	s code($i(code(0)))=" set %mmmsqlTTii="""" for  { set %mmmsqlTTii=$o(%mmmsqlTTtotal(%mmmsqlTTii)) quit:%mmmsqlTTii=""""  set %mmmsqlTTavg(%mmmsqlTTii)=$normalize(%mmmsqlTTtotal(%mmmsqlTTii)/"_$s(sampleType=1:"%mmmsqlTTss",1:"%mmmsqlTTsampleSize")_",2) set:%mmmsqlTTavg(%mmmsqlTTii)=0 %mmmsqlTTavg(%mmmsqlTTii)=1 }"
	  	s code($i(code(0)))=" QUIT"
	  	s code($i(code(0)))="Error s $zt="""",%mmmsqlTTsc=$$$ERROR($$$ObjectScriptError,$ze_"" : ""_$g(%msg)) "_$s((extentsize'=pSampleSize)&&(sampleType=1):"&sql(CLOSE tt)",1:"")_" s SQLCODE=-400 q"
	  	set code($i(code(0)))="#undef %occSqlfuncinc"
  		// 1 passed in to pFromTuneTable parameter parameter will cause code to get compiled with %SQLTuneTable role which bypasses row level security
	  	new %msg,%ROWCOUNT,%ROWID,SQLCODE
	  	kill:'reSample $$$tFile(tHandle)
		if extentsize'=pSampleSize {
			if sampleType=3 { 
				do RunTempCode^%SYS.SQLSRV(.code,"Main",,.SQLCODE,.%msg,"Getting sample of rows from bitmap extent index for columnar table "_table,pSampleSize_","_tHandle_",.%mmmsqlTTrowList,.%mmmsqlTTavg,.SQLCODE,.%mmmsqlTTsc")
	  			set %mmmsqlTTavg(idIcol)=$s('reSample:$normalize(totalIdFieldSize/pSampleSize,2),1:$normalize((firstTotalIdFieldSize+totalIdFieldSize)/(firstSampleSize+pSampleSize),2))
			} else {
				do RunTempCode^%SYS.SQLSRV(.code,"Main",,.SQLCODE,.%msg,"Getting Sampling of data from the table "_table,$s('reSample:extentsize,1:extentsize-firstSampleSize)_","_pSampleSize_","_tHandle_",.%mmmsqlTTavg,.SQLCODE,.%mmmsqlTTsc")
			}
		} else {
			do RunTempCode^%SYS.SQLSRV(.code,"Main",,.SQLCODE,.%msg,"Getting sample of rows from "_$s(sampleType=3:"bitmap extent index for columnar ",1:"")_"table "_table,pSampleSize_","_tHandle_",.%mmmsqlTTavg,.SQLCODE,.%mmmsqlTTsc")
		}
	  	if $$$ISERR(%mmmsqlTTsc) { set sc=$$$ERROR($$$SQLError,-400,"Failed to get sample of data from the table "_table_" "_$g(%msg)) GOTO end }
	  	if SQLCODE<0 { set sc=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode(SQLCODE)_"::"_$g(%msg)) GOTO end }
	}
	  #; use the IDs in temp file to get the true sample size
	set icol = 1,fval = "", trueSampleSize = 0
	for{
		set fval=$order($$$tFile(tHandle,icol,fval)) quit:fval=""
		set trueSampleSize = trueSampleSize + 1
	}
	if trueSampleSize=0 { set sc=$$$ERROR($$$SQLError,-400,"Failed to get sample of data from the table "_table) GOTO end }
	// no user specified sample percentage, should be block sampling or EBM sampling, this is the first run
	if ('skipReSample)&&('reSample)&&$$needResample(trueSampleSize,extentsize,tHandle,.fldinfo,.selectivity,.resamplePercent) { 
		set reSample=1,skipReSample=1 // this is resample run
		set firstSampleSize=pSampleSize
		set:sampleType'=1 firstTotalIdFieldSize=totalIdFieldSize
		merge firstAvgArr=%mmmsqlTTavg
		kill code,%mmmsqlTTavg // start from empty code for temp rtn
		if sampleType=2 {
			#; make sure smd is clean
			set i=$zu(68,28,0) kill $$$smdRoot do $zu(68,28,i)
			#; get fresh imp 
			set mrirn = $$$smdLoadGetIrn(iqn)
			set imp=$$GetImp($$$GetTableTypeFromIQN(iqn),mrirn,0)
			set firstBlockSamplePerc=blockSamplePerc
			set firstBlockSampleSize=blockSampleSize
			set firstNumTotalRows=numTotalRows
			set firstBigBlockCounter=bigBlockCounter
			kill %mmmsqlTTallRowsArray,numTotalRows,totalIdFieldSize
			// don't change row sample perc (rowSamplePerc) 
			// since we don't want to add bias for the resample block
			if resamplePercent/rowSamplePerc+firstBlockSamplePerc<1 {
				set blockSamplePerc=resamplePercent/rowSamplePerc
				set blockSampleSize = $normalize(blockSamplePerc * numBlocks,0)
			} else {
				set blockSampleSize = numBlocks-blockSampleSize
				set blockSamplePerc = blockSampleSize/numBlocks
			}
			goto:blockSamplePerc>0 type2Sample
		} else {
			set pSampleSize=resamplePercent*extentsize
			kill %mmmsqlTTrowList,totalIdFieldSize
			goto type13Sample
		}	
	} elseif reSample {
		set totalSampleSize=pSampleSize+firstSampleSize
		// update %mmmsqlTTavg
		set icol="" 
		for  { 
			set icol=$o(%mmmsqlTTavg(icol),1,tavg) quit:icol=""
			continue:(sampleType'=1)&&(icol=idIcol)
			set %mmmsqlTTavg(icol)=$normalize(((firstAvgArr(icol)*firstSampleSize)+(tavg*pSampleSize))/totalSampleSize,2) 
		}
		// accumulate pSampleSize
		set pSampleSize=totalSampleSize
	}
	set rowSampleSize = trueSampleSize
	    #; Initialize histogram bins
	kill percentiles, hist
	if trueSampleSize < 16 {
		set numBins = trueSampleSize + 1, noHist = 1
	} else {
		set numBins = 16
	}
	set:(trueSampleSize>extentsize)||((sampleType'=2)&&(extentsize=pSampleSize)) extentsize=trueSampleSize // table size might change, the table might be populated when there is a new SQL statement, for example: INFORMATION_SCHEMA.STATEMENT_PRIV_ACTIONS or INFORMATION_SCHEMA.CURRENT_STATEMENTS
	set pSampleSize=trueSampleSize
	set icol="",fcnt=0, binSize = rowSampleSize\(numBins - 1)
	for i = 0:1:numBins{
		set percentiles(i) = $normalize(i*100/(numBins - 1),2)
	}
		#; Go through the temp file and determine the selectivity for those fields
	    #; format is $$$tFile(tHandle,icol,fval) = $lb( number of occurences, value )
		#; f(i) stores the number of values that occur exactly i times in the sample 
	new %f
	
	#; sampling rate q
	set q = pSampleSize/extentsize
	
	set icol = ""
	for  {
		set icol=$order($$$tFile(tHandle,icol)) quit:icol=""
		if selectivity(icol)="NUMROWS" { continue }
		if icol = 1 { continue }
		set fval="",ocount=0,lcount=pSampleSize,gammaSum = 0, reducedGammaSum = 0, tempReducedGammaSum = 0, reducedfcnt = 0, reducedExtentSize = extentsize, reducedSampleSize = pSampleSize
			#;  Count the number of distinct values for this field; find value with max occurrences (PVA272)
			#;  lcount is the count of the least frequent value. It is used to detect if there is an outlier
		for fcnt=0:1 {
			set fval=$order($$$tFile(tHandle,icol,fval),1,numOcc) quit:fval=""
				#; i is the number of occurrences of fval in the sample
			set i = $li(numOcc,1)
			if i>ocount { set ocount=i,oval=$li(numOcc,2) }
			if i<lcount { set lcount=i }
				#; gamma (coefficient of variance) calculation;
				#; calculate sum in eq 18 of Haas, 1996
			do $increment(%f(tHandle,icol,i))
			set gammaSum = gammaSum + (i * (i - 1))
		}
		if ocount>1 {
				#; gamma sum without most common value
			set reducedGammaSum = gammaSum - (ocount * (ocount - 1))
				#; sample size without the outlier
			set reducedSampleSize = pSampleSize - ocount
				#; extent size estimation without the outlier
			set reducedExtentSize = extentsize*(1-(ocount/pSampleSize))
				#; sampling rate when outlier is excluded
			if reducedExtentSize >0{
				s reducedq = reducedSampleSize/reducedExtentSize
			}else{
				set reducedq = q
			}
			#; number of distinct values without outlier; keep general in case we want more outlier values in the future
			set reducedfcnt = fcnt - 1
		} else {
			#; there is no outlier, no need to calculated these reduced stats
			set reducedGammaSum = gammaSum, reducedSampleSize = pSampleSize, reducedExtentSize = extentsize, reducedq = q, reducedfcnt = fcnt
		}
			#;  We now know there are fcnt distinct values for this field in the pSampleSize
			#;    PVA272: logic modified to analyze outlier and typical selectivity
			#;  We think there is only one value for this field.  We need to try and find out if there is really only one value, or if we just have a field where almost all values are this one value
			#;  We will check the entire table to see how many distinct values there are for this field, 
			#;  but only if there is an index with this field as the first subscript that we can use to quickly check the entire table.
			#;  If there really is only one value for this field in the table, then there is no outlier selectivity for this field.
		if fcnt=1 { 
			if pSampleSize=extentsize { set selectivity(icol) = $$$countOneFieldDefaultSel, secondSelectivity(icol) = $$$countOneFieldDefaultSel, reducedSecondSelectivity(icol) = $$$countOneFieldDefaultSel, outliers(icol)=$lb($$$countOneFieldDefaultOutlierSel,oval) continue }
			set countOneFields(icol)=$g(oval)
		} else {
			do SetEstimators(pSampleSize,reducedSampleSize,extentsize,reducedExtentSize,fcnt,reducedfcnt,q,reducedq,gammaSum,reducedGammaSum,tHandle,icol,.secondSelectivity,.reducedSecondSelectivity,.gamma,.reducedGamma,.sc)
			If $$$ISERR(sc) {
				do logStatus(display,pLogFile,sc,5)
				do:$g(%msg)'="" log(display,pLogFile,%msg,5)
				goto end
			}
				#; store the coefficient of variation; likely useful in future selectivity updates
			set gamma(icol) = gamma
				#; Require minimum table size for outlier, outlier count should > average count, and outlier count should be at least 5 times the smallest frequency
			if (extentsize < 6)||(ocount <= (pSampleSize/fcnt))||(ocount <= 5*lcount) { set selectivity(icol)=secondSelectivity set secondSelectivity(icol) = secondSelectivity set reducedSecondSelectivity(icol) = reducedSecondSelectivity continue }
			set secondSelectivity=1/secondSelectivity
				#; correct the selectivity when there is an outlier to account for reduced sample size after removing outlier
			set reducedSecondSelectivity = 1/reducedSecondSelectivity*(1-(ocount/pSampleSize))
			set reducedSecondSelectivity(icol) = 1/reducedSecondSelectivity
			set secondSelectivity(icol) = 1/secondSelectivity
				#; set selectivities if there is an outlier
			if ocount > (5*reducedSecondSelectivity*pSampleSize) { set outliers(icol)=$lb($j(ocount/pSampleSize*100,0,4)_"%",oval),selectivity(icol)=1/reducedSecondSelectivity }
				#; set selectivities without an outlier
			else { set selectivity(icol)=1/secondSelectivity }	
		}
	}
	if $d(countOneFields) {
		merge temptFile=$$$tFile(tHandle) // keep track of current $$$tFile(tHandle), since GetDistinctCount could change it
			#; If we get here there are one or more fields that we only found a single value for, and the sample size is less than the extentsize
			#; See if any them can be checked using an index
		set icol=""
		set iqn=$$$BuildIQN($$$SQLLocTableSchema(tabinfo),$$$SQLLocTableName(tabinfo))
		for  {
			set icol=$o(countOneFields(icol),1,oval) quit:icol=""
			if $$goodindex(iqn,extentname,icol,.fieldname) {
				set selectivity=$$GetDistinctCount(extentname,$$quoter2(fieldname),table)
				if selectivity=1 { 
					set selectivity(icol)=$$$countOneFieldDefaultSel
					set outliers(icol)=$lb($$$countOneFieldDefaultOutlierSel,oval) 
				} else {
					set selectivity(icol)=pSampleSize*(selectivity-1)/.7
					set outliers(icol)=$lb($j(1-(.7/pSampleSize)*100,0,4)_"%",oval)
				}
				s secondSelectivity(icol) = selectivity(icol), reducedSecondSelectivity(icol) = selectivity(icol)
				kill countOneFields(icol)      // Remove it from the list of fields with 1 value as this has now been processed.
			} elseif fieldname="x__classname"{
				set selectivity(icol) = $$$countOneFieldDefaultSel, secondSelectivity(icol) = $$$countOneFieldDefaultSel, reducedSecondSelectivity(icol) = $$$countOneFieldDefaultSel, outliers(icol)=$lb($$$countOneFieldDefaultOutlierSel,oval)
			} else{
				set noIndex(icol)=$lb(fieldname,oval)
			}
		}
		if $d(noIndex) {
				#; If we get here there are one or more fields that we only found a single value for that do not fall into the goodindex category above
				#; We will check up to $$$SingleValueCheckBlockCount blocks to see if there is truly only one value
			set fieldcnt=0,fieldnames="",intolist=""
			set icol=""
			for  {
				set icol=$o(noIndex(icol),1,data) quit:icol=""
				set fieldcnt=fieldcnt+1
				set fieldnames=fieldnames_$e(",",fieldnames'="")_$$quoter2($li(data,1))   // build a list of field names for the query
				set intolist=intolist_$e(",",intolist'="")_":%mmmsqlTTval("_icol_")"
			}	
			if (sampleType=2) {
				  #; We will scan up to $$$SingleValueCheckBlockCount blocks of the table for more than one value for this field
				do GetDistinctCountTwo(extentname,fieldnames,intolist,table,.%mmmsqlTTcnt,.sc,extentsize,tHandle,.otlcnt,numBlocks,.blockArray,IGL,IG,DIR,tabinfo,display,pLogFile,.%msg,.numSingleCheckRows,sampleType,columnar,dataBlocksPercent)
				if $$$ISERR(sc) {
					set extentsize = -1, numMasterBlocks = 0, pSampleSize = 0, %msg = $system.Status.GetErrorText(sc)
						do log(display,pLogFile,%msg,5)
						goto end
				}
				set icol=""
				for  {
					set icol=$o(noIndex(icol),1,data) quit:icol=""
					if ('$d(%mmmsqlTTcnt(icol)))||(%mmmsqlTTcnt(icol)=0) {
						set extentsize = -1, numMasterBlocks = 0, pSampleSize = 0, %msg = $$$Text("Could not check distinct values. Table stats will not be updated.","%SQL.TuneTable")
						do log(display,pLogFile,%msg,5)
						goto end
					}
					if %mmmsqlTTcnt(icol)=1 { set selectivity(icol) = $$$countOneFieldDefaultSel, secondSelectivity(icol) = $$$countOneFieldDefaultSel, reducedSecondSelectivity(icol) = $$$countOneFieldDefaultSel, outliers(icol)=$lb($$$countOneFieldDefaultOutlierSel,$lg(data,2)) }	// We search up to $$$SingleValueCheckBlockCount blocks and only found 1 value for the field
					else {   // We searched all rows (up to $$$SingleValueCheckBlockCount blocks) and actually found more than one value so define it as an outlier
						set selectivity(icol)=1/%mmmsqlTTcnt(icol)
						if selectivity(icol)>extentsize { set selectivity(icol)=extentsize }
						  #; Set the outlier selectivity
						set outliers(icol)=$lb($j(otlcnt(icol)/numSingleCheckRows*100,0,4)_"%",$lg(data,2))
						set secondSelectivity(icol) = selectivity(icol), reducedSecondSelectivity(icol) = selectivity(icol)
					}
				}
			} else {
				#; sampleType=1 or 3
				do GetDistinctCountTwo(extentname,fieldnames,intolist,table,.%mmmsqlTTcnt,.sc,extentsize,tHandle,.otlcnt,,,,,,tabinfo,display,pLogFile,.%msg,.numSingleCheckRows,sampleType,columnar)
				if $$$ISERR(sc) {
					set extentsize = -1, numMasterBlocks = 0, pSampleSize = 0, %msg = $system.Status.GetErrorText(sc)
					do log(display,pLogFile,%msg,5)
					goto end	
				}
				set icol=""
				for {
					set icol=$o(noIndex(icol),1,data) quit:icol=""
					if ('$d(%mmmsqlTTcnt(icol)))||(%mmmsqlTTcnt(icol)=0) {
						set extentsize = -1, pSampleSize = 0, %msg = $$$Text("Could not check distinct values. Table stats will not be updated.","%SQL.TuneTable")
						do log(display,pLogFile,%msg,5)
						goto end
					}
					if %mmmsqlTTcnt(icol)=1 { set selectivity(icol) = $$$countOneFieldDefaultSel, secondSelectivity(icol) = $$$countOneFieldDefaultSel, reducedSecondSelectivity(icol) = $$$countOneFieldDefaultSel, outliers(icol)=$lb($$$countOneFieldDefaultOutlierSel,$lg(data,2)) }	// We search up to $$$SingleValueCheckRowCount rows and only found 1 value for the field
					else {   // We searched all rows (up to $$$SingleValueCheckRowCount) and actually found more than one value so define it as an outlier
						set selectivity(icol)=1/%mmmsqlTTcnt(icol)
						if selectivity(icol)>extentsize { set selectivity(icol)=extentsize }
						  #; NB use the minimum of extentsize and $$$SingleValueCheckRowCount
						  #; to correctly set the outlier selectivity
						set outliers(icol)=$lb($j(otlcnt(icol)/$select(extentsize<$$$SingleValueCheckRowCount:extentsize,1:$$$SingleValueCheckRowCount)*100,0,4)_"%",$lg(data,2))
						s secondSelectivity(icol) = selectivity(icol), reducedSecondSelectivity(icol) = selectivity(icol)
					}
				}
			}
		}
		k $$$tFile(tHandle)
		merge $$$tFile(tHandle)=temptFile // revert $$$tFile(tHandle) back, since we need to use it in the histogram calculation
	}
	for {
		set icol=$order($$$tFile(tHandle,icol)) quit:icol=""
		  #; decide whether or not the field can be numerically interpolated
		  #; for histogram range selectivity purposes
		set numericInterp = $case($$$SQLLocColSQLCategory(fldinfo(icol)),"INTEGER":1,"NUMERIC":1,"DOUBLE":1,"DATE":1,"TIME":1,"POSIXTS":1,:0) 
		  #; get the collation for this column.
		  #; if collation = truncate, then get truncation length and apply when building histogram below
		if collation(icol)'["(" {
			set collNum=$Case(collation(icol),"S":1,"MV":2,"P":3,"M":4,"U":5,"A":6,"SU":7,"SS":8,"T":9,:0)
			set trueCollation = collation(icol)
			set truncateLength = 0
		}
		  #; collation is %COLLATION(N) where N is truncation length for collations other than "C"
		  #; collation is %COLLATE( transformation-spec [ , truncate-length ] ) for "C" collation
		else {
			set trueCollation = $piece(collation(icol),"(",1)
			set truncateLength = +$piece(collation(icol),"(",2)
			set collNum=$Case(trueCollation,"S":1,"MV":2,"P":3,"M":4,"U":5,"A":6,"SU":7,"SS":8,"T":9,"C":10,"TR":11,1:0)
		}
		set fval = "",useSorted = ""
		  #; if collation is not exact, then create a version of the sample
		  #; that is sorted in collation order
		if ($get(collNum))&&($$$SQLLocColListCollection(fldinfo(icol))'="Y") {
			if collNum=10 {
				k parm1,parm2
				do getCollateParms^%qaqcpre(collation(icol),.parm1,.parm2)
				set colNul=##class(%Library.Collation).Collate("",parm1,parm2)
			} else {
				set colNul=$Case(collNum,1:" ",2:" 5",3:0,4:0,5:"",6:"",7:" ",8:" ",9:" ",11:"",1:"")
			}
			set useSorted = 1
			kill sortedSample, valuesList, percentilesList, commonList, intBoundsList
			  #; sortedSample is the tunetable sample sorted in collation order
			for {
				set fval=$order($$$tFile(tHandle,icol,fval),1,numOccList) quit:fval=""
				set fvaltwo = $listget(numOccList,2)
				  #; check that collation supports truncate length argument
				if $listfind($listbuild(7,8,9),collNum){
					set colFvaltwo = ##class(%SYSTEM.Util).Collation(fvaltwo,collNum,$select('truncateLength:120,1:truncateLength))
				} elseif collNum = 10 {
					set colFvaltwo = ##class(%Library.Collation).Collate(fvaltwo,parm1,parm2)
				} elseif collNum = 11 {
					set colFvaltwo = ##class(%Library.Collation).Truncate(fvaltwo,$select('truncateLength:120,1:truncateLength))
				} else { 
					#; if collation does not support truncate length, do not apply truncate length
					set colFvaltwo = ##class(%SYSTEM.Util).Collation(fvaltwo,collNum)
				}
				set:colFvaltwo=colNul colFvaltwo = $$$NULLSubscriptMarker19
				set sortedSample(colFvaltwo) = $li(numOccList,1) + $g(sortedSample(colFvaltwo))
			}
		}
		set bigBinsRemaining = rowSampleSize#(numBins-1), curBin = 1, lastBound = 0, total = 0, numNull = 0
		  #; now that we have created sortedSample, go through it and create the histogram
		for fcnt=0:1 {
			if $get(useSorted){
				  #; using collation other than exact truncate
				set fval=$order(sortedSample(fval),1,numOcc) quit:fval=""
				set fvaltwo = fval
			} else {
				  #; collation is exact
				set fval=$order($$$tFile(tHandle,icol,fval),1,numOccList) quit:fval=""
				set $listget(numOcc,fvaltwo)=numOccList
				set:fvaltwo="" fvaltwo = $$$NULLSubscriptMarker19
			}
			  #; turn nul values into -1E19
			if fval=$$$NULLSubscriptMarker19{
				set fvaltwo = fval
			}
			  #; save percentiles
			  #; total: number of values we have seen so far
			set total=total+numOcc
			  #; since number of bins may not divide the sample size evenly,
			  #; the first few bins may have to be one larger than the rest
			if fcnt=0,'$data(noHist(icol)) {
				  #; count the null buckets
				if fvaltwo = $$$NULLSubscriptMarker19{
					set numNull = numNull + 1
				}
				set $list(percentilesList,1) = 0
				set $list(valuesList,1) = $s(numericInterp:+$extract(fvaltwo,1,$$$maxBucketValLength),1:$extract(fvaltwo,1,$$$maxBucketValLength))
			}
			if bigBinsRemaining{
				  #; this bin is a big one
				set plusOne = 1
			} else {
				  #; this bin is normal-sized
				set plusOne = 0
			}
			  #; boundary between this bin and next = lastBound + binSize + plusOne
			  #; decide whether or not the current value crosses into the next bin
			  #; note that one value can span multiple bins if it occurs frequently enough
			while total >= (lastBound + binSize + plusOne) {
				if '$data(noHist(icol)){
					  #; count the null buckets
					if fvaltwo = $$$NULLSubscriptMarker19 {
						set numNull = numNull + 1
					}
					set $list(percentilesList,curBin+1) = $g(percentiles(curBin))
					set $list(valuesList,curBin+1) = $s(numericInterp:+$extract(fvaltwo,1,$$$maxBucketValLength),1:$extract(fvaltwo,1,$$$maxBucketValLength))
				}
				set curBin = curBin + 1
				set lastBound = lastBound + binSize + plusOne
				if bigBinsRemaining{
					set bigBinsRemaining = bigBinsRemaining - 1
					if 'bigBinsRemaining{
						set plusOne = 0
					}
				}
			}
		}
		  #; get count of shared leading characters in valuesList
		set commonList = "", intBoundsList = "", valuesListLength = $listlength($get(valuesList))
		if valuesListLength > 1{
			for k = 1:1:(valuesListLength-1){
				set commonCount = 0, subtractOne = 0
				set str1 = ##class(%Global).Quote($list(valuesList,k)),str2 = ##class(%Global).Quote($list(valuesList,k+1))
				if str1 = str2 {
					set commonCount = $length(str1)
					set:($extract(str1,1)="""") subtractOne = 1
				} else{
					while $extract(str1,commonCount+1) = $extract(str2,commonCount+1) {
						quit:commonCount=$length(str1)
					 	 #; don't count leading quotes for strings
						if (commonCount = 0),($extract(str1,1)=""""){
							set subtractOne = 1
						}
						set commonCount = commonCount+1
					}
				}
				set $list(commonList,k) = commonCount - subtractOne
				if 'numericInterp {
					if k = 1 {
						set $list(intBoundsList,2*k-1) = $$IntFromStr($list(valuesList,k),0)
						set $list(intBoundsList,2*k) = $$IntFromStr($list(valuesList,k),$list(commonList,k))
					} else {
						set $list(intBoundsList,2*k-1) = $$IntFromStr($list(valuesList,k),$list(commonList,k-1))
						set $list(intBoundsList,2*k) = $$IntFromStr($list(valuesList,k),$list(commonList,k))
					}
				}
			}
			set:'numericInterp $list(intBoundsList,2*valuesListLength-1) = $$IntFromStr($list(valuesList,valuesListLength),$list(commonList,valuesListLength-1))
			set:'numericInterp $list(intBoundsList,2*valuesListLength) = $$IntFromStr($list(valuesList,valuesListLength),0)
		}
		  #; store the histogram. Format is:
		  #; $lb(bin width, numerically interpoatable, numNull, values, common characters, bounds converted to ints)
		if '$data(noHist),'$data(noHist(icol)) { set hist(icol) = ##class(%Global).Quote($lb(1/(numBins-1),numericInterp,numNull,valuesList,commonList,intBoundsList)) }
.
	}
	
end	do $zu(115,2,rcmode) // restore RC mode
	kill $$$tFile(tHandle)  // clear the temp file
	set i=$zu(68,28,0) kill $$$smdRoot do $zu(68,28,i) // make sure smd is clean
	QUIT
	}
	
	// Convert strings to ints for interpolation purposes in range selectivity calculation
	// Used when generating histograms to store integer versions of bucket boundaries.
IntFromStr(str,common=0)[]PUBLIC{
	  #; strip shared leading characters
	set str = $extract(str,common+1,*)
	  #; convert unicode if necessary
	if $ziswide(str){set str=$zconvert(str,"O","UTF8")}
	  #; pad with $c(0) if string is too short
	  #; then convert into an intereger
	set str=$S($length(str)>4:$reverse($extract(str,1,4)),1:$reverse(str_$tr($j("",4-$length(str))," ",$Char(0)))) return $zla(str)
}
	
	// Given an SQL Selectivity value, return an Object Selectivity value (The value you see in the class definition / SMP / export)
SelectivityToObjectSelectivity(selectivity="") [] PRIVATE {
	if selectivity {
		set objselectivity=$j((100/selectivity),0,4)_"%"
		set:'objselectivity objselectivity=$zstrip($j(100/selectivity,0,19),">W","0")_"%"
	}
	if selectivity="NUMROWS"||'selectivity { set objselectivity=1 }
	set:selectivity="" objselectivity=""
	RETURN objselectivity
}
.
	// Check for an index with leading subscript that of field for this icol.  Make sure collations match too.
	// Returns 1 if there is an index that can be used, otherwise 0.
	// Return fieldname by reference, used in GetDistinctCount()
goodindex(iqn,extentname,icol,&fieldname) [] PUBLIC {
		// Find the name of the field we are looking for
	set fieldname="",collation="",good=0
	for  {
		set fieldname=$o($$$EXTSQLCOL($$$rEXT,extentname,fieldname)) quit:fieldname=""
		set fldinfo=$$$EXTSQLCOLsqlinfo($$$rEXT,extentname,fieldname)
		if icol=$$$SQLLocColNumber(fldinfo) { set collation=$$$SQLLocColCollation(fldinfo) quit }
	}
	QUIT:fieldname="" 0	// Field not found?
		// Now see if the field is indexed, the first field subscripted in a fullly populated index map
	set mapname="" 
	for  {
		set mapname=$o($$$EXTSQLMAP($$$rEXT,extentname,mapname)) quit:mapname=""		// For each map in the table
		set mapinfo=$$$EXTSQLMAPsqlinfo($$$rEXT,extentname,mapname)
		continue:$$$SQLLocMapMaster(mapinfo)="Y"						// Don't want the master map
		continue:$$$SQLLocMapPopulateType(mapinfo)'=1						// Only want fully populated index maps
		continue:$$$SQLLocMapIndexOnCollection(mapinfo)						// Collation map cannot help count distinct 
		continue:'$SYSTEM.SQL.Util.GetMapSelectability(iqn,mapname) 		// Skip unselectable map
		set ilev=""
		for  {
			set ilev=$o($$$EXTSQLMAPSUB($$$rEXT,extentname,mapname,ilev)) quit:ilev=""	// For each map subscript in the map
			set msinfo=$$$EXTSQLMAPSUBsqlinfo($$$rEXT,extentname,mapname,ilev)
			continue:$$$SQLLocMapSubConstant(msinfo)'=""					// Skip leading contant subscripts
			set mapfield=$$$SQLLocMapSubSwappedFieldName(msinfo)
			set:mapfield="" mapfield=$$$SQLLocMapSubFieldName(msinfo) 			// Get fieldname
			quit:mapfield=""||(mapfield'=fieldname)						// not a field, or not the field we are looking for; try next index
			//w !,"mapname = ",mapname,"fieldname = ",fieldname,?40,"mapfield = ",mapfield,?70,"collation = ",collation,?90,"map collation = ",$$$SQLLocMapSubFunction(msinfo),?130,"mapname = ",mapname,!
			
			if $$$ISENCODEDCOLLATE($p($$$SQLLocMapSubFunction(msinfo),"(",1)) {
				set mapcollation = $p($$$SQLLocMapSubFunction(msinfo),"(",1)
			}
			else{
				set mapcollation=$case($p($$$SQLLocMapSubFunction(msinfo),"(",1),"SQLUPPER":"SU","SQLSTRING":"SS","STRING":"T","ALPHAUP":"A","UPPER":"U","MVR":"MV","TRUNCATE":"TR","":"E",:"")
			}
			set:$$$SQLLocMapSubFunction(msinfo)["(" mapcollation=mapcollation_"("_$p($$$SQLLocMapSubFunction(msinfo),"(",2,*)
			//w !,"fieldname = ",fieldname,?40,"mapfield = ",mapfield,?70,"collation = ",collation,?90,"map collation = ",mapcollation,?130,"mapname = ",mapname,!
			if mapfield=fieldname,$tr(collation,"E")=$tr(mapcollation,"E") { set good=1 quit }		// Bingo!
		}
		quit:good
	}
	QUIT good
}
.
	// issue: select count(*) from (select distinct %exact(<column>) from <table>)
	// dont' use count(distinct..) because some distinct optimizations not done for that case
	// also can't use count(distinct..) because it doesn't count null value
	// Called from:
	//   CalculateSelectivity2()
GetDistinctCount(extentname,fieldname,table,&SQLCODE,&%msg,&pSC) [SQLCODE] PUBLIC {
	    #;  Calculate the number of rows currently in the table
	QUIT $$GetDistinctCount^%SYS.SECURITY(extentname,fieldname,table,.SQLCODE,.%msg,.pSC)
}
.
	// Called from:
	//	GetDistinctCount^%SYS.SECURITY
GetDistinctCount2(extentname,fieldname,table,&SQLCODE,&%msg,&pSC) [%mmmsqlTTcnt,SQLCODE] PUBLIC {
	    #;  Calculate the number of rows currently in the table
	new %mmmsqlTTcnt,%msg,%ROWID,%ROWCOUNT
	set pSC=$$$OK
	set code(0)=0
	set code(0)=code(0)+1,code(code(0))="#define %occSqlfuncinc"
	set include=""
	for  {
		set include=$$$comClassArrayNext(extentname,$$$cCLASSincludecodeall,include) quit:include=""
		set code(0)=code(0)+1,code(code(0))="#include "_include
	}
	set code(0)=code(0)+1,code(code(0))="#include %occInclude"
	set code(0)=code(0)+1,code(code(0))="Main(%mmmsqlTTcnt) &sql(SELECT COUNT(*) INTO :%mmmsqlTTcnt FROM ( SELECT DISTINCT "_fieldname_" FROM "_table_") /*#OPTIONS { ""TuneTable"":1 } */) quit"
	set code(0)=code(0)+1,code(code(0))="#undef %occSqlfuncinc"
		// 1 passed in to pFromTuneTable parameter parameter will cause code to get compiled with %SQLTuneTable role which bypasses row level security
	do RunTempCode^%SYS.SQLSRV(.code,"Main",,.SQLCODE,.%msg,"Getting count of distinct values for a particular field for TuneTable",".%mmmsqlTTcnt")
	if SQLCODE<0 { set pSC=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode(SQLCODE)_"::"_$g(%msg)),%mmmsqlTTcnt="" }
	if SQLCODE=100 { set %mmmsqlTTcnt="" }
	QUIT $g(%mmmsqlTTcnt)
}
.
GetDistinctCountTwo(extentname,fieldnames,intolist,table,&%mmmsqlTTcnt,&pSC,extentsize,tHandle,&otlcnt,numBlocks,&blockArray,IGL="",IG="",DIR,tabinfo,display=0,pLogFile="",&msg,&numTotalRows,sampleType,columnar,dataBlocksPercent) [%mmmsqlTTcnt,SQLCODE,%mmmsqlTTgetDistinctRowsArray] PRIVATE {
	    #;  Determine if there is more than one distinct value for this field - no good index to use, but few enough rows to scan the table
	new %msg,%ROWID,%ROWCOUNT,%mmmsqlTTgetDistinctRowsArray
	set pSC=$$$OK
	set include=""
	set i = 0
	kill sampled, numTotalRows
	if (sampleType=2) {
		set iqn=$$$BuildIQN($$$SQLLocTableSchema(tabinfo),$$$SQLLocTableName(tabinfo))
		set imp=$$GetImp($$$GetTableTypeFromIQN(iqn),$$$smdLoadGetIrn(iqn))
	  	#; Sample up to $$$SingleValueCheckBlockCount blocks
		try{
			set sLev = $$$smdMapRowIDStartLev(imp),lLev = $$$smdMapRowIDLastLev(imp),idSubLev=$O($$$smd(12,imp,6,""),-1)-(+columnar)
			set idSkipLev = $s($$$SQLLocTablePartitioned(tabinfo):lLev-1,1:0)
			set isCompoundId = (lLev>sLev)
			kill boundaryIds
			open 63:"^^"_DIR
			if $$$SingleValueCheckBlockCount < numBlocks {
				set blockSampleCount = 0, blockSampleCountTwo = 0
				for {
					set sampleThisBlock = 0
					if $$$SingleValueCheckBlockCount/numBlocks > .3{
						set i = i + 1
						if $random(numBlocks - i + 1)<($$$SingleValueCheckBlockCount - blockSampleCount){
							set sampleThisBlock = 1
						}
					}
					else{
						set i=1+$random(numBlocks)
						if '$data(sampled(i)){
							set sampled(i)=1
							set sampleThisBlock = 1
						}
					}
					if sampleThisBlock {
			  	  	  	  #; load current block into view buffer
						set curBlock = blockArray(i)			
						do $increment(blockSampleCountTwo),$increment(blockSampleCount)
						do GetIdsFromBlock(.curBlock,,IGL,IG,-1,isCompoundId,sLev,lLev,idSubLev,idSkipLev,.%mmmsqlTTgetDistinctRowsArray,.rowCounter,.numTotalRows,,.boundaryIds)
						if rowCounter = 0 {set blockSampleCount = blockSampleCount - 1}
						quit:(blockSampleCount=$$$SingleValueCheckBlockCount)||(blockSampleCountTwo=numBlocks)||((blockSampleCountTwo>(numBlocks/3))&&(blockSampleCountTwo>=$$$SingleValueCheckBlockCount)&&($get(numTotalRows)>=100))
					}
				}
				throw:'$d(numTotalRows)
			} elseif (dataBlocksPercent'=1) {
				set blockSampleCount = numBlocks
				for i = 1:1:numBlocks{
					set curBlock = blockArray(i)
					do GetIdsFromBlock(.curBlock,,IGL,IG,-1,isCompoundId,sLev,lLev,idSubLev,idSkipLev,.%mmmsqlTTgetDistinctRowsArray,,.numTotalRows,,.boundaryIds)
				}
				throw:'$d(numTotalRows)
			}
		}
		catch exception{
			set %msg=$$$FormatText($$$Text("Encountered a problem obtaining a sample of rows for checking distinct values.","%SQL.TuneTable"),$$$SQLLocTableSchema(tabinfo)_"."_$$$SQLLocTableName(tabinfo))
			set i=$zu(68,28,0) kill $$$smdRoot do $zu(68,28,i)  // make sure smd is clean
			do log(display,pLogFile,%msg)
			close 63
			set i=$zu(68,28,0) kill $$$smdRoot do $zu(68,28,i)  // make sure smd is clean
			RETURN
			
		}
		close 63
		set i=$zu(68,28,0) kill $$$smdRoot do $zu(68,28,i)  // make sure smd is clean
		
		if ($$$SingleValueCheckBlockCount < numBlocks)||(dataBlocksPercent'=1) {
			set code($i(code(0)))="#define %occSqlfuncinc"
			set include="" for  set include=$$$comClassArrayNext(extentname,$$$cCLASSincludecodeall,include) quit:include=""  set code($i(code(0)))="#include "_include
			set code($i(code(0)))="#include %occInclude"
			set code($i(code(0)))="Main(%mmmsqlTTnumTotalRows,%mmmsqlTTtHandle,&%mmmsqlTTgetDistinctRowsArray,&SQLCODE) n %mmmsqlTTi,%mmmsqlTTii,%mmmsqlTTval,%mmmsqlTTvalue,%ROWCOUNT,%ROWID,%mmmsqlTTtotal,%ttID,%ttdata,%ttdavg,%ID,%mmmsqlTTrowList,%mmmsqlTTidList"
			set code($i(code(0)))=" set %mmmsqlTTrowList = 1, %mmmsqlTTrowList(1)="""""
			set code($i(code(0)))=" For %mmmsqlTTi=1:1:%mmmsqlTTnumTotalRows {"
			set code($i(code(0)))="    set %mmmsqlTTidList = $listbuild(%mmmsqlTTgetDistinctRowsArray(%mmmsqlTTi))"
			set code($i(code(0)))="    if $length(%mmmsqlTTrowList(%mmmsqlTTrowList))+$length(%mmmsqlTTidList)<32000 {"
			set code($i(code(0)))="    		set %mmmsqlTTrowList(%mmmsqlTTrowList) = %mmmsqlTTrowList(%mmmsqlTTrowList)_%mmmsqlTTidList"
			set code($i(code(0)))="    } else {"
			set code($i(code(0)))=" 		set %mmmsqlTTrowList($I(%mmmsqlTTrowList)) = %mmmsqlTTidList"
			set code($i(code(0)))="    }"
			set code($i(code(0)))=" } "
			set code($i(code(0)))=" for %mmmsqlTTi = 1:1:%mmmsqlTTrowList {"
			set code($i(code(0)))=" 	&sql(DECLARE getRows CURSOR for SELECT "_fieldnames_" INTO "_intolist_" FROM "_table_" WHERE %ID %INLIST :%mmmsqlTTrowList(:%mmmsqlTTi) /*#OPTIONS { ""TuneTable"":1 } */)"
			set code($i(code(0)))=" 	&sql(OPEN getRows)"
			set code($i(code(0)))=" 	For {"
			set code($i(code(0)))=" 		&sql(FETCH getRows) if SQLCODE'=0 { quit }"
			set code($i(code(0)))="    		set %mmmsqlTTii="""""
			set code($i(code(0)))="	   		for  { set %mmmsqlTTii=$o(%mmmsqlTTval(%mmmsqlTTii),1,%mmmsqlTTvalue) q:%mmmsqlTTii=""""  set:$l(%mmmsqlTTvalue)>120 %mmmsqlTTvalue=$zcrc(%mmmsqlTTvalue,9) set:%mmmsqlTTvalue="""" %mmmsqlTTvalue="_$$$NULLSubscriptMarker19_" do $increment("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%mmmsqlTTvalue)) } "  	// DPV2471=, PVA272
			set code($i(code(0)))=" 	}"
			set code($i(code(0)))=" 	&sql(CLOSE getRows)"
			set code($i(code(0)))=" }"
  			set code($i(code(0)))=" k %mmmsqlTTgetDistinctRowsArray"
  			set code($i(code(0)))=" QUIT"
			set code($i(code(0)))="#undef %occSqlfuncinc"
.
	  		  #; run the temp code to sample the rows
	  		kill $$$tFile(tHandle)
			do RunTempCode^%SYS.SQLSRV(.code,"Main",,.SQLCODE,.%msg,"Determining if distinct values for a particular field for TuneTable is > 1",numTotalRows_","_tHandle_",.%mmmsqlTTgetDistinctRowsArray,.SQLCODE")
			if SQLCODE<0 { set pSC=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode(SQLCODE)_"::"_$g(%msg)) }
		}else{
			set code($i(code(0)))="Main(%mmmsqlTTtHandle)"
			set code($i(code(0)))=" new %mmmsqlTTii,%mmmsqlTTnumTotalRows,%mmmsqlTTval,%mmmsqlTTvalue"
			set code($i(code(0)))=" &sql(declare dc2 cursor for SELECT "_fieldnames_" into "_intolist_" FROM "_table_" /*#OPTIONS { ""TuneTable"":1 } */)"
			set code($i(code(0)))=" &sql(open dc2)"
			  #; read values and occurence counts into tempfile, as above
			set code($i(code(0)))=" quit:SQLCODE'=0 // OPEN failed"
			set code($i(code(0)))=" for {"
			set code($i(code(0)))=$c(9)_"&sql(fetch dc2) quit:SQLCODE"
			set code($i(code(0)))=$c(9)_"d $I(%mmmsqlTTnumTotalRows)"
			set code($i(code(0)))=$c(9)_"set %mmmsqlTTii="""""
			set code($i(code(0)))=$c(9)_"for  { set %mmmsqlTTii=$o(%mmmsqlTTval(%mmmsqlTTii),1,%mmmsqlTTvalue) q:%mmmsqlTTii=""""  set:$l(%mmmsqlTTvalue)>120 %mmmsqlTTvalue=$zcrc(%mmmsqlTTvalue,9) set:%mmmsqlTTvalue="""" %mmmsqlTTvalue="_$$$NULLSubscriptMarker19_" do $increment("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%mmmsqlTTvalue)) } "  	// DPV2471=, PVA272
			set code($i(code(0)))=" }"
			set code($i(code(0)))=" &sql(close dc2)"
			set code($i(code(0)))=" set "_$$$tFileQ_"(%mmmsqlTTtHandle,""cnt"") = %mmmsqlTTnumTotalRows"
			kill $$$tFile(tHandle)
			do RunTempCode^%SYS.SQLSRV(.code,"Main",,.SQLCODE,.%msg,"Determining if distinct values for a particular field for TuneTable is > 1",""_tHandle)
			set numTotalRows = $$$tFile(tHandle,"cnt")
			kill $$$tFile(tHandle,"cnt")
		}
	} else {
		for  {
			set include=$$$comClassArrayNext(extentname,$$$cCLASSincludecodeall,include) quit:include=""
			set code($i(code(0)))="#include "_include
		}
		set code($i(code(0)))="#include %occInclude"
	
		  #; if extentsize is larger than $$$SingleValueCheckRowCount, then sample up to
		  #; $$$SingleValueCheckRowCount rows in order to check for multiple distinct values.
		  #; if extentsize is less than/equal to $$$SingleValueCheckRowCount, then scan the
		  #; entire table to check for multiple distinct values.
		if $$$SingleValueCheckRowCount < extentsize {
			set code($i(code(0)))="Main(%mmmsqlTTes,%mmmsqlTTtHandle) "
			set code($i(code(0)))=" new %cntOneID,%mmmsqlTTfirstRow,%mmmsqlTTii,%row,%mmmsqlTTrow,%mmmsqlTTrowNum,%mmmsqlTTsecondRow,%mmmsqlTTtmp,%mmmsqlTTval,%mmmsqlTTvalue,%mmmsqlTTrows,%mmmsqlTTrowList,%mmmsqlTTidList "
			set code($i(code(0)))=" &sql(DECLARE dc2 CURSOR FOR SELECT %ID INTO :%cntOneID FROM "_table_" /*#OPTIONS { ""TuneTable"":1 } */)"		
			set code($i(code(0)))=" set %mmmsqlTTscnt=0,%mmmsqlTTrowList=1,%mmmsqlTTrowList(1)="""""
			  #; first, get array of IDs that will then be randomized
			set code($i(code(0)))=" &sql(open dc2)"
			set code($i(code(0)))=" quit:SQLCODE'=0 // OPEN failed"
			set code($i(code(0)))=" for %mmmsqlTTrowNum = 1:1:%mmmsqlTTes {"
			set code($i(code(0)))=$c(9)_"quit:%mmmsqlTTscnt="_$$$SingleValueCheckRowCount
			set code($i(code(0)))=$c(9)_"&sql(fetch dc2)"
			set code($i(code(0)))=$c(9)_"quit:SQLCODE"
			set code($i(code(0)))=$c(9)_"If $r(%mmmsqlTTes-%mmmsqlTTrowNum+1)<("_$$$SingleValueCheckRowCount_"-%mmmsqlTTscnt) {"
			set code($i(code(0)))=$c(9,9)_"set %mmmsqlTTidList = $listbuild(%cntOneID)"
			set code($i(code(0)))=$c(9,9)_"if $length(%mmmsqlTTrowList(%mmmsqlTTrowList))+$length(%mmmsqlTTidList)<32000 {"
			set code($i(code(0)))=$c(9,9,9)_"set %mmmsqlTTrowList(%mmmsqlTTrowList) = %mmmsqlTTrowList(%mmmsqlTTrowList)_%mmmsqlTTidList"
			set code($i(code(0)))=$c(9,9)_"} else {"
			set code($i(code(0)))=$c(9,9,9)_"set %mmmsqlTTrowList($I(%mmmsqlTTrowList)) = %mmmsqlTTidList"
			set code($i(code(0)))=$c(9,9)_"}"
			set code($i(code(0)))=$c(9,9)_"set %mmmsqlTTscnt=%mmmsqlTTscnt+1"
			set code($i(code(0)))=$c(9)_"}"
			set code($i(code(0)))=" }"
			set code($i(code(0)))=" &sql(close dc2)"
			  #; sample $$$SingleValueCheckCountRows; write result to tempfile
			  #; format is $$$tFile(tHandle,icol,fval) = $lb( number of occurences, value )
			set code($i(code(0)))=" for %mmmsqlTTi = 1:1:%mmmsqlTTrowList {"
			set code($i(code(0)))=$c(9)_"&sql(DECLARE getRows CURSOR for SELECT "_fieldnames_" INTO "_intolist_" FROM "_table_" WHERE %ID %INLIST :%mmmsqlTTrowList(:%mmmsqlTTi) /*#OPTIONS { ""TuneTable"":1 } */)"
			set code($i(code(0)))=$c(9)_"&sql(OPEN getRows)"
			set code($i(code(0)))=$c(9)_"For {"
			set code($i(code(0)))=$c(9,9)_"&sql(FETCH getRows) if SQLCODE'=0 { quit }"
			set code($i(code(0)))=$c(9,9)_"set %mmmsqlTTii="""""
			set code($i(code(0)))=$c(9,9)_"for  { set %mmmsqlTTii=$o(%mmmsqlTTval(%mmmsqlTTii),1,%mmmsqlTTvalue) q:%mmmsqlTTii=""""  set:$l(%mmmsqlTTvalue)>120 %mmmsqlTTvalue=$zcrc(%mmmsqlTTvalue,9) set:%mmmsqlTTvalue="""" %mmmsqlTTvalue="_$$$NULLSubscriptMarker19_" do $increment("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%mmmsqlTTvalue)) } "  	// DPV2471=, PVA272
			set code($i(code(0)))=$c(9)_"}"
			set code($i(code(0)))=$c(9)_"&sql(CLOSE getRows)"
			set code($i(code(0)))=" }"
		} else{
			set code($i(code(0)))="Main(%mmmsqlTTes,%mmmsqlTTtHandle)"
			set code($i(code(0)))=" new %mmmsqlTTii,%mmmsqlTTrow,%mmmsqlTTval,%mmmsqlTTvalue"
			set code($i(code(0)))=" &sql(declare dc2 cursor for SELECT "_fieldnames_" into "_intolist_" FROM "_table_" /*#OPTIONS { ""TuneTable"":1 } */)"
			set code($i(code(0)))=" &sql(open dc2)"
			  #; read values and occurence counts into tempfile, as above
			set code($i(code(0)))=" quit:SQLCODE'=0 // OPEN failed"
			set code($i(code(0)))=" for %mmmsqlTTrow=1:1:%mmmsqlTTes {"
			set code($i(code(0)))=$c(9)_"&sql(fetch dc2) quit:SQLCODE"
			set code($i(code(0)))=$c(9)_"set %mmmsqlTTii="""""
			set code($i(code(0)))=$c(9)_"for  { set %mmmsqlTTii=$o(%mmmsqlTTval(%mmmsqlTTii),1,%mmmsqlTTvalue) q:%mmmsqlTTii=""""  set:$l(%mmmsqlTTvalue)>120 %mmmsqlTTvalue=$zcrc(%mmmsqlTTvalue,9) set:%mmmsqlTTvalue="""" %mmmsqlTTvalue="_$$$NULLSubscriptMarker19_" do $increment("_$$$tFileQ_"(%mmmsqlTTtHandle,%mmmsqlTTii,%mmmsqlTTvalue)) } "  	// DPV2471=, PVA272
			set code($i(code(0)))=" }"
			set code($i(code(0)))=" &sql(close dc2)"
		}
		set code($i(code(0)))=" QUIT"
		// 1 passed in to pFromTuneTable parameter parameter will cause code to get compiled with %SQLTuneTable role which bypasses row level security
		kill $$$tFile(tHandle)
		do RunTempCode^%SYS.SQLSRV(.code,"Main",,.SQLCODE,.%msg,"Determining if distinct values for a particular field for TuneTable is > 1",""_extentsize_","_tHandle)
		if SQLCODE<0 { set pSC=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode(SQLCODE)_"::"_$g(%msg)) kill otlcnt }
	}
	    #;  Go through the temp file and determine the selectivity for each field therein
	set icol=""
	for j=1:1:$l(intolist,",") {
		set icol=+$p($p(intolist,",",j),"(",2)
		set fval="",ocount=0,fcnt=0
			#;  Count the number of distinct values for this field; find value with max occurrences (PVA272)
		for fcnt=0:1 {
				#; fval = current value, count = # occurrences of fval
				#; oval = most frequent value, ocount = # occurrences of oval
			set fval=$o($$$tFile(tHandle,icol,fval),1,count) quit:fval=""
			if count>ocount { set ocount = count }
		}
		if fcnt=0 { 
			set pSC=$$$ERROR($$$SQLError,-400,"Failed to get sample of data for checking distinct values from the table "_table) 
			RETURN
		}
			#; otlcount stores the number of outliers for each field in the tempfile
			#; %mmmsqlTTcnt stores the selectivities (modified because of outlier) of each field in the tempfile
		set otlcnt(icol) = ocount
		if (sampleType=2) {
			  #; found only one value
			if fcnt=1 {
				set %mmmsqlTTcnt(icol) = 1
			  #; read whole table and found multiple values	
			} elseif $$$SingleValueCheckBlockCount>=numBlocks {
				set tselectivity = 1/fcnt*(1-(ocount/numTotalRows))
				set %mmmsqlTTcnt(icol) = tselectivity
			  #; sampled the table and found multiple values
			} else {
				  #; estimate selectivity in the presence of outlier; correct for reduced sample size
				if '$G(newcheck){
				set tselectivity = $$extrapolate(fcnt-1,numTotalRows-ocount,$normalize(extentsize*(1-(ocount/numTotalRows)),4))
				set tselectivity=1/tselectivity*(1-(ocount/numTotalRows))
				set %mmmsqlTTcnt(icol) = tselectivity
				} else {
				set tselectivity = $$extrapolate(fcnt-1,numTotalRows-ocount,$normalize(extentsize*(1-(ocount/numTotalRows)),4))
				set tselectivity=1/tselectivity*(1-(ocount/numTotalRows))
				set %mmmsqlTTcnt(icol) = tselectivity
				}
			}
		} else {
			if fcnt=1 {
				set %mmmsqlTTcnt(icol) = 1
			  #; read whole table and found multiple values		
			} elseif $$$SingleValueCheckRowCount>=extentsize {
				set tselectivity = 1/fcnt*(1-(ocount/extentsize))
				set %mmmsqlTTcnt(icol) = tselectivity
			  #; sampled the table and found multiple values
			} else {
				  #; estimate selectivity in the presence of outlier; correct for reduced sample size
				set tselectivity = $$extrapolate(fcnt-1,$$$SingleValueCheckRowCount-ocount,$normalize(extentsize*(1-(ocount/$$$SingleValueCheckRowCount)),4))
				set tselectivity=1/tselectivity*(1-(ocount/$$$SingleValueCheckRowCount))
				set %mmmsqlTTcnt(icol) = tselectivity
			}
		}
	}
.
	RETURN
}
 
extrapolate(dvals,samplesize,extentsize) [] PRIVATE {
	    #; extentsize - cardinality of a table, 
	    #; samplesize - sample size, 
	    #; dvals -  # distinct values 
	  s eps=0.00001,dvals=dvals\1,samplesize=samplesize\1,extentsize=extentsize\1
	  #;i dvals'>0||(samplesize'>0)||(extentsize'>0) QUIT 0
	  i samplesize=extentsize QUIT dvals
	  i dvals=samplesize QUIT extentsize
	  s d0=dvals
	  i dvals<(samplesize/2) { s d1=samplesize } Else { set d1=10*samplesize*samplesize/9 }
eloop	  If d1-d0<eps {
		s t=$zln(1-(1/d1))*extentsize
		s res=$s(t<-140:d1,1:d1*(1-$zexp(t))) s:res>extentsize res="NUMROWS" QUIT res
	  }
	  s d2=(d0+d1)/2,t=$zln(1-(1/d2))*samplesize
	  If $s(t<-140:d2,1:d2*(1-$zexp(t)))>dvals { set d1=d2 } Else { set d0=d2 }
	  goto eloop
	}
	
	// Called from:
	//   CalculateSelectivity2()
SetEstimators(pSampleSize,reducedSampleSize,extentsize,reducedExtentSize,fcnt,reducedfcnt,q,reducedq,gammaSum,reducedGammaSum,tHandle,icol,&secondSelectivity,&reducedSecondSelectivity,&gamma,&reducedGamma,&pSC) [] PUBLIC {
		#; Setting selectivity estimate using the second order unsmoothed estimator given in equation 18 of
		#; Research Report: Estimating the number of classes in a finite population, "Peter J. Haas," Computer Science, 1996.
		#; This accounts for variation in occurrence counts of different values within the sample
		#; Also set the reduced selectivity, which is the selectivity of a column when the outlier is removed
		#; 
		#; Parameters:
		#; 		pSampleSize              - sample size
		#; 		reducedSampleSize        - sample size with outlier removed
		#; 		extentsize               - number of rows in column/table
		#; 		reducedExtentSize        - estimated number of rows in column after removing outlier
		#; 		fcnt                     - number of distinct values
		#; 		reduced fcnt             - number of distinct values after removing outlier (currently fcnt - 1, but could change if we keep track of more values)
		#; 		q                        - sampling rate = pSampleSize/extentsize
		#; 		reduced q                - sampling rate without outlier = reducedSampleSize/reducedExtentSize
		#; 		gammaSum                 - for coefficient of variation calculation (see Haas, 1996, equation 16)
		#; 		reducedGammaSum          - for coefficient of variation calculation for the outlier-free sample
		#; 		tHandle                  - name of table
		#; 		icol                     - column number
		#; 		secondSelectivity        - PBR, second order selectivity estimate, corrected for count variance (see Haas, 1996, eq 18)
		#; 		reducedSecondSelectivity - PBR, second order selectivity for outlier-free sample
		#; 		gamma                    - PBR, coefficient of variation (measures how much occurence counts vary within the sample)
		#; 		reducedGamma             - PBR, gamma for outlier-free sample
		#;      pSC                      - PBR, contains status code if an error occurs
	  
		#; case when we are sampling the whole extent
		#; set all selectivities (first order, second order, etc) to exact values
	if pSampleSize=extentsize{
		s secondSelectivity = fcnt
		s reducedSecondSelectivity = fcnt - 1
		s simpleSelectivity= fcnt
		s reducedSimpleSel = fcnt - 1
		s gamma = (simpleSelectivity/(pSampleSize**2) * gammaSum) + (simpleSelectivity/extentsize) - 1			
		if gamma < 0 { set gamma = 0 }
	}else{
			#; f1 = number of singletons, i.e. values that appear exactly once in the sample
			#; f1 is needed for first order selectivity estimate (simpleSelectivity)
		if $d(%f(tHandle,icol,1),f1){} else { set f1 = 0 }
			#; simpleSelectivity is the first order selectivity estimate (no correction for variance)
		set simpleSelectivity= fcnt/(1-(((1-q)*f1)/pSampleSize))
			#; gamma is coefficient of variation for full sample
			#; use first order selectivity to generate gamma
		set gamma = (simpleSelectivity/(pSampleSize**2) * gammaSum) + (simpleSelectivity/extentsize) - 1			
		if gamma < 0 { set gamma = 0 }
			#; use gamma to generate the second order (variance-corrected) selectivity estimate for the entire sample
		set secondSelectivity = 1/(1 - ((f1*(1-q))/pSampleSize))*(fcnt-((f1*(1-q)*$zln(1-q)*gamma)/q))
		if pSampleSize'=reducedSampleSize { 
				#; reducedSimpleSel is the first order selectivity estimate with the outlier excluded
			set reducedSimpleSel = reducedfcnt/(1-(((1-reducedq)*f1)/reducedSampleSize))
				#; reducedGamma is coefficient of variation with outlier excluded
				#; use reduced first order selectivity to generate reducedGamma
			set reducedGamma = (reducedSimpleSel/(reducedSampleSize**2) * reducedGammaSum) + (reducedSimpleSel/reducedExtentSize) - 1
			if reducedGamma < 0 {
				set reducedGamma = 0
			}
				#; reducedSecondSelectivity is the 2nd order cardinality estimate (variance-corrected) with the outlier excluded
			set reducedSecondSelectivity = 1/(1 - ((f1*(1-reducedq))/reducedSampleSize))*(reducedfcnt-((f1*(1-reducedq)*$zln(1-reducedq)*reducedGamma)/reducedq))
		} else { 
				#; if all the values in the sample are unique
			set reducedSimpleSel = simpleSelectivity, reducedGamma = gamma, reducedSecondSelectivity = secondSelectivity
		}
	}
}
.
	// Called from:
	//   tune()
	//   %SQL.Manager.Catalog.GetCalcTableExtentSize
GetNumberRows(table,extentname="",SQLCODE,%msg,&pSC,&shardnumber) [SQLCODE] PUBLIC {
	    #;  Calculate the number of rows currently in the table
	QUIT $$GetNumberRows^%SYS.SECURITY(table,extentname,.SQLCODE,.%msg,.pSC,.shardnumber)
}
.
	// Called from:
	//	GetNumberRows^%SYS.SECURITY
	//	table is the iqn of the table name
GetNumberRows2(table,extentname="",&SQLCODE,&%msg,&pSC,&shardnumber) [%mmmsqlTTcnt,SQLCODE] PUBLIC {
	    #;  Calculate the number of rows currently in the table
	new %mmmsqlTTcnt,%msg,%ROWID,%ROWCOUNT
	set pSC=$$$OK
	set:extentname="" extentname=$$$GetExtentNameFromIQN(table)
	set schema=$$$AllButLastPiece(table,"."),tablename=$tr($$$LastPiece(table,"."),$c(2),".")
	set tableInQuery=$$quoter2(schema)_"."_$$quoter2(tablename)
	set sharded=$$$comSharded(extentname) // JMM1160=
	if sharded {
		if sharded=1 {  // table is a shard-master table
			set shardnumber=$$tuneTableShard^%SYS.SHARDSRV(tableInQuery,.bigcount,.SQLCODE,.%msg)   // returns in bigcount the number of rows for the shard-local table on the shard with the most rows
			RETURN bigcount
		} else {	// table is a shard-local table
			set shardMasterExtent=$$getMasterClassName^%SYS.SHARDSRV(extentname)
			set tabinfo=$g($$$EXTsqlinfo($$$rEXT,shardMasterExtent))
			if tabinfo="" { set SQLCODE=-30,%msg=$$$FormatText($$$Text("No defined shard-master table for shard-local table'%1'","%SQL.TuneTable"),table) RETURN "" }
			set tableInQuery=$$quoter2($$$SQLLocTableSchema(tabinfo))_"."_$$quoter2($$$SQLLocTableName(tabinfo))
			set shardnumber=$$tuneTableShard^%SYS.SHARDSRV(tableInQuery,.bigcount,.SQLCODE,.%msg)   // returns in bigcount the number of rows for the shard-local table on the shard with the most rows
			RETURN bigcount
		}
	}
	set code(0)=0
	set code(0)=code(0)+1,code(code(0))="#define %occSqlfuncinc"
	set include=""
	for  {
		set include=$$$comClassArrayNext(extentname,$$$cCLASSincludecodeall,include) quit:include=""
		set code(0)=code(0)+1,code(code(0))="#include "_include
	}
	set code(0)=code(0)+1,code(code(0))="#include %occInclude"
	set code(0)=code(0)+1,code(code(0))="Main(%mmmsqlTTcnt) &sql(SELECT COUNT(*) INTO :%mmmsqlTTcnt FROM "_tableInQuery_"  /*#OPTIONS { ""TuneTable"":1 } */) quit"
	set code(0)=code(0)+1,code(code(0))="#undef %occSqlfuncinc"
		// 1 passed in to pFromTuneTable parameter parameter will cause code to get compiled with %SQLTuneTable role which bypasses row level security
	do RunTempCode^%SYS.SQLSRV(.code,"Main",,.SQLCODE,.%msg,"Getting Numer Of Rows for TuneTable",".%mmmsqlTTcnt")
	if SQLCODE<0 { set pSC=$$$ERROR($$$SQLError,SQLCODE,$$sqlcode(SQLCODE)_"::"_$g(%msg)),status=0 }
	QUIT $g(%mmmsqlTTcnt)
}
 
	// Called from:
	//   %SQL.Manager.Catalog.SetTableExtentSize
	//   tune
	//   ImportTuneStats
	//   CopyTuneStats
SetExtentSize(extentname,tabinfo,classname,oldextentsize="",newextentsize,display=0,update=1,&updated,classid="",leaveopen=0,KeepClassUpToDate=0,pCollection="",pParentClass="",pLogFile="",pSampleSize="",&statsOref="") [] PUBLIC {
	    #;  Set the EXTENTSIZE of the given class
	    #;  Also called from %SQL.Manager.Catalog.SetTableExtentSize method
	    #;  Parameters:
	    #;      extentname:     Name of table's extent
	    #;      tabinfo:        Data from extent's sqlinfo node
	    #;      classname:      Name of the class to update, required
	    #;      oldextentsize:  Optional
	    #;      newextentsize:  Required
	    #;      display:        Display any option flag, optional, default is FALSE
	    #;      update:         Actually do the update flag, default is TRUE
	    #;      updated:        PBR, flag to indicate an update has occurred, optional
	    #;      classid:        PBR, the oref of the class definition
	    #;      leaveopen:      1/0 flag to signal not to close the class definition object
	    #;      KeepClassUpToDate:  1/0 flag to signal whether to keep the class up-to-date or not.  If TRUE, we edit the
	    #;                      class definition global directly.  The default is 0, don't keep it up-to-date.
	    #;      pCollection:    If this is a child table projected by a collection, pCollection is the name of the property that projected the table.
	    #;      pParentClass:   If this is a child table projected by a collection, pParentClass is the name of the parent table's class
	    
	$$$DebugTrace("SetExtentSize^%qarTune: extentname="_$g(extentname)_", tabinfo="_$g(tableinfo)_", classname="_$g(classname)_", oldextentsize="_oldextentsize_", newextentsize="_$g(newextentsize)_",display="_display_", update="_update_", updated="_$g(updated)_", classid="_classid_", leaveopen="_leaveopen_", KeepClassUpToDate="_KeepClassUpToDate_", pCollection="_pCollection_", pParentClass="_pParentClass_", pLogFile="_pLogFile_", pSampleSize="_pSampleSize)
	do log(display,pLogFile,$$$Text("EXTENTSIZE:","%SQL.TuneTable"),5)
	do log(display,pLogFile,$$$Text("CURRENT = ","%SQL.TuneTable"),8),log(display,pLogFile,$j($fn(oldextentsize,","),27),22,0)
	do log(display,pLogFile,$$$Text("CALCULATED = ","%SQL.TuneTable"),8),log(display,pLogFile,$j($fn(newextentsize,","),27),22,0)
	set:pSampleSize="" pSampleSize=$s(newextentsize<1000:newextentsize,1:$normalize(3*$zsqr(newextentsize),0))
	do log(display,pLogFile,$$$Text("SAMPLESIZE","%SQL.TuneTable"),8),log(display,pLogFile,$j($fn(pSampleSize,","),27),22,0)
	set sc=$$$OK
	$$$comMemberKeyGetLvar(defaultExtentSize,classname,$$$cCLASSparameter,"EXTENTSIZE",$$$cPARAMdefault)
	if $isObject(statsOref) {
		set statsOref.ExtentSize=newextentsize
	} elseif update&&$s(newextentsize'=oldextentsize:1,newextentsize=defaultExtentSize:1,1:0) {
		set $$$SetSQLLocTableExtentSize(tabinfo)=$s(newextentsize="":defaultExtentSize,1:newextentsize)
		set $$$EXTsqlinfo($$$rEXT,extentname)=tabinfo	// Stores the value in the table metadata
		set updmsg=$$$Text("Table","%SQL.TuneTable")
		if pParentClass="" {
			if '($$$comClassKeyGet(classname,$$$cCLASSdeployed)) {
				do SetClassExtentSize(classname,newextentsize,.sc,.classid,leaveopen,KeepClassUpToDate,.pCollection)
				if $$$ISERR(sc) {
					do logStatus(display,pLogFile,sc,5)
					goto exit
				}
				else { set updmsg=$$$Text("Table & class","%SQL.TuneTable") }
			}
		}
		else {
			if '($$$comClassKeyGet(pParentClass,$$$cCLASSdeployed)) {
				do SetClassExtentSize(pParentClass,newextentsize,.sc,.classid,leaveopen,KeepClassUpToDate,.pCollection)
				if $$$ISERR(sc) {
					do logStatus(display,pLogFile,sc,5)
					goto exit
				}
				else { set updmsg=$$$Text("Table & class","%SQL.TuneTable") }
			}
		}
		if newextentsize'=oldextentsize {
			do log(display,pLogFile,$$$Text("Updated","%SQL.TuneTable"),60,0)
			set updated=1
		}
		
	}
exit	$$$DebugTrace("SetExtentSize^%qarTune(EXIT): sc="_sc_", updated="_$g(updated))
	QUIT sc
}
.
	// Given a table and field name, return sql tune stats information for the field
	// Data is retrieved from SQL definition, so if the class is not compiled no metadata will be found
	// Return value is:  $lb(FieldSelectivity,OutlierSelectivity,BiasQueriesAsOutlier,AverageFieldLength)
	//   OutlierSelectvity is in the form $lb(OutlierSelectivity,OutlierValue)
	// If "" is returned, check %msg value for a reason
GetFieldTuneStats(table,field,&%msg) [] PUBLIC {
	set %msg=""
	set schema=$$$AllButLastPiece(table,"."),tablename=$tr($$$LastPiece(table,"."),$c(2),".")
	if schema=""||(tablename="") { set %msg="schema and/or table name not specified" QUIT "" }
	set extentname=$$$GetExtentNameFromTableName(schema,tablename)
	if extentname="" { set %msg="Table "_schema_"."_tablename_" is not defined, or projecting class not compiled" QUIT "" }
	set f=""
	for  {
		set f=$o($$$EXTSQLCOL($$$rEXT,extentname,f)) quit:f=""  quit:$$$UPPER(f)=$$$UPPER(field)
	}
	if f="" { set %msg="Field "_schema_"."_tablename_"."_field_" not found" QUIT "" }
	set fldinfo=$$$EXTSQLCOLsqlinfo($$$rEXT,extentname,f)
	if fldinfo="" { set %msg="Field metadata for "_schema_"."_tablename_"."_field_" not found" QUIT "" }
	QUIT $lb($$SelectivitySqlToObject($$$SQLLocColSelectivity(fldinfo)),$$$SQLLocColOutlierSelectivity(fldinfo),$$$SQLLocColBiasQueriesAsOutlier(fldinfo),$$$SQLLocColAverageFieldSize(fldinfo))
	
}
.
	// Given an SQL selectivity value, convert it to an Object selectivity value
SelectivitySqlToObject(sqlsel) [] PRIVATE {
	if sqlsel {
		set objsel=$j((100/sqlsel),0,4)_"%" 
		set:'objsel objsel=$zstrip($j(100/sqlsel,0,19),">W","0")_"%"
	}
	if sqlsel="NUMROWS"||'sqlsel { set objsel=1 }
	QUIT objsel
}
.
	// Called from:
	//  tune
	//  ImportTuneStats
	//  %SQL.Manager.Catalog.SetFieldSelectivity
	//  %SYSTEM.SQL.SetFieldSelectivity
SetSelectivity(extentname,field,fldinfo,classname,extentsize,objselectivity,sqlselectivity,display=0,classid="",leaveopen=0,KeepClassUpToDate=0,pCollection="",pParentClass="",pLogFile="",pOutlier="",pAverageFieldSize="",pHistogram="",ClearValues=0,&statsOref="") [] PUBLIC {
	    #;  The selectivity value passed in here is the Object selectivity
	    #;      class:          PBR, the oref of the class definition
	    #;      leaveopen:      1/0 flag to signal not to close the class definition object
	    #;      KeepClassUpToDate:  1/0 flag to signal whether to keep the class up-to-date or not.  If TRUE, we edit the
	    #;                      class definition global directly.  The default is 0, don't keep it up-to-date.
	    #;      pCollection:    If this is a child table projected by a collection, pCollection is the name of the property that projected the table.
	    #;      pParentClass:   If this is a child table projected by a collection, pParentClass is the name of the parent table's class
	    #;      	 
	set:sqlselectivity=extentsize&&($$$SQLLocColUnique(fldinfo)) sqlselectivity="NUMROWS"
	set $$$SetSQLLocColSelectivity(fldinfo)=sqlselectivity
	set tOutlier=""
	if pOutlier'="" {
			#; An outlier selectivity will always be a decimal percentage between 0 and 1 (.85 for 85%)
		set tOutlier=$lg(pOutlier)
		if tOutlier>1,tOutlier=+tOutlier { set tOutlier=tOutlier/extentsize }		// Approx # of rows with this value
		elseif tOutlier["%" { set tOutlier=tOutlier/100 }				// % of rows with this value
		set tOutlier=$lb(tOutlier,$lg(pOutlier,2))
		set $$$SetSQLLocColOutlierSelectivity(fldinfo)=tOutlier
	}
	else {
		set $$$SetSQLLocColOutlierSelectivity(fldinfo)=""
	}
	if '$isObject(statsOref){
		set $$$SetSQLLocColAverageFieldSize(fldinfo)=pAverageFieldSize
		set $$$SetSQLLocColHistogram(fldinfo)=pHistogram
		set $$$EXTSQLCOLsqlinfo($$$rEXT,extentname,field)=fldinfo
	}
	set updmsg=$$$Text("Table","%SQL.TuneTable")
	set sc=$$$OK
	if pParentClass="" {
		if '($$$comClassKeyGet(classname,$$$cCLASSdeployed)) {
			do SetPropertySelectivity(classname,field,fldinfo,objselectivity,extentsize,.sc,display,.classid,leaveopen,KeepClassUpToDate,pCollection,tOutlier,pAverageFieldSize,pHistogram,ClearValues,.statsOref)	// DPV2871
			if $$$ISOK(sc) { set updmsg=$$$Text("Table & class","%SQL.TuneTable") }
		  	else { QUIT sc }
		}
	}
	else {
		if '($$$comClassKeyGet(pParentClass,$$$cCLASSdeployed)) {
			do SetPropertySelectivity(pParentClass,field,fldinfo,objselectivity,extentsize,.sc,display,.classid,leaveopen,KeepClassUpToDate,pCollection,tOutlier,pAverageFieldSize,pHistogram,ClearValues,.statsOref)	// DPV2871
			if $$$ISOK(sc) { set updmsg=$$$Text("Table & class","%SQL.TuneTable") }
		  	else { QUIT sc }
		}
	}
	do:'$isObject(statsOref) log(display,pLogFile,$$$Text("Updated","%SQL.TuneTable"),60,0)
	QUIT sc
}
 
	// Called from:
	//   SetExtentSize
SetClassExtentSize(classname,value,&sc,&classid="",leaveopen=0,KeepClassUpToDate=0,pCollection="") [] PRIVATE {
		#;  Given a class and a value, set the Class's EXTENTSIZE to the value
		#;  Ignoring errors for now ***
		#;      classid:        PBR, the oref of the class definition
		#;      leaveopen:      1/0 flag to signal not to close the class definition object
		#;      KeepClassUpToDate:  1/0 flag to signal whether to keep the class up-to-date or not.  If TRUE, we edit the
		#;                      class definition global directly.  The default is 0, don't keep it up-to-date.
		#;      pCollection:    If this is a child table projected by a collection, pCollection is the name of the property that projected the table.
	$$$DebugTrace("SetClassExtentSize^%qarTune: classname="_$g(classname)_", value="_$g(value)_", sc="_$g(sc)_", classid="_classid_", leaveopen="_leaveopen_", KeepClassUpToDate="_KeepClassUpToDate_", pCollection="_pCollection)
	RETURN:$g(classname)=""
	if 'KeepClassUpToDate {
		if 'classid { set classid=$$Open^%apiCDL(classname,,5) if $$$ISERR(classid) { set sc=classid goto exit }}
		set storage=$o($$$SDEF($$$sWRK,classname,""))
		if pCollection'="" {
				#; this is a collection child table.  Don't record the extensize in the Extentsize setting for the table, 
				#; but in the ChildExtentsize setting for the collection property (DPV3516)
			if value'="" { $$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,pCollection,$$$cSTORAGEPROPERTYchildextentsize,value) }
			else { $$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,pCollection,$$$cSTORAGEPROPERTYchildextentsize) }
		}
		else {
			//s i=$g(%objlasterror),sc=$$AddParameter^%apiCDL(classid,"EXTENTSIZE") s:i'="" %objlasterror=i k:i="" %objlasterror // An error is OK here because we may get a duplicate parameter error
			//s sc=$$SetParameter^%apiCDL(classid,"EXTENTSIZE",$$$cPARAMdefault,value) i $$$ISERR(sc) d Close^%apiCDL(classid) QUIT
			if value'="" { $$$editMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFextentsize,value) }
			else { $$$editMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFextentsize) }
				#; Delete the class parameter now that we have defined it in storage
			set sc=$$DeleteParameter^%apiCDL(classid,"EXTENTSIZE")
		}
		if 'leaveopen {
			set sc=$$Save^%apiDDL(classid) if $$$ISERR(sc) { do Close^%apiCDL(classid) goto exit }
			set sc=$$Close^%apiCDL(classid)
		}
	}
	else {
		set storage=$o($$$SDEF($$$sWRK,classname,""))
		if pCollection'="" {
				#; this is a collection child table.  Don't record the extensize in the Extentsize setting for the table, 
				#; but in the ChildExtentsize setting for the collection property (DPV3516)
			$$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,pCollection,$$$cSTORAGEPROPERTYchildextentsize,value)
		}
		else {
			if value'="" { $$$defMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFextentsize,value) }
			else { $$$defMemberKeyKill(classname,$$$cCLASSstorage,storage,$$$cSDEFextentsize) }
				#; Delete the class parameter now that we have defined it in storage
			$$$defMemberKill(classname,$$$cCLASSparameter,"EXTENTSIZE")
		}
			#; if we are done with the class here, update the DEF/COM timestamps
		if 'leaveopen {
			set tTS=$zu(188)
			$$$defClassKeySet(classname,$$$cCLASStimechanged,tTS)
			do RebuildItemIndex^%R(classname,"CLS",,1)
			set sc=$$KeepClassUpToDate^%occDepend(classname)
			if $$$ISERR(sc) { do logStatus(display,pLogFile,sc,5) }
		}
	}
exit	$$$DebugTrace("SetClassExtentSize^%qarTune(END): sc="_$g(sc))
	RETURN
}
 
 
CheckHash(classname)  [] PRIVATE {														// DPV2969+
	Set timeDEF=$g($$$defClassKeyRaw(classname,$$$cCLASStimechanged))
	QUIT:$g($$$comClassKeyRaw(classname,$$$cCLASStimecreated))=timeDEF		// $H for ^oddDEF and ^oddCOM match
	Set currentHash=$listget($get(^rINDEXCLASS($zconvert(classname,"U"))),13)
	Set oldHash=$$$comClassKeyGet(classname,$$$cCLASShash)
	If oldHash'=currentHash Quit							// Hashes don't match, class is already not uptodate
		#; Now we know the hash match, but the $H are different so update ^oddCOM
	$$$comClassKeySet(classname,$$$cCLASStimecreated,timeDEF)
	QUIT
}																		// DPV2969-
 
SetPropertySelectivity(classname,field,fldinfo,value,extentsize,sc,display=0,classid="",leaveopen=0,KeepClassUpToDate,pCollection="",pOutlier="",pAverageFieldSize="",pHistogram="",ClearValues=0,&statsOref="") [] PUBLIC {
	    #;  Given a class a fldname and a value, set the property's selectivity parameter to the value
	    #;      value:          Selectivity value of the field
	    #;      classid:        PBR, the oref of the class definition
	    #;      leaveopen:      1/0 flag to signal not to close the class definition object
	    #;      KeepClassUpToDate:  1/0 flag to signal whether to keep the class up-to-date or not.  If TRUE, we edit the
	    #;                      class definition global directly.  The default is 0, don't keep it up-to-date.
	    #;      pOutlier:	    Outlier Selectivity, of the form $lb(selectivity,value), we turn this into selectivity:value for regular fields,
	    #;                      and propertyname:selectivity:value for serial properties.  
	    #;                      The outlier selectvity for all serial sub-fields are stored in the storageproperty value of the root serial property
	set sc=1
	QUIT:$g(classname)=""  QUIT:field=""
	if pCollection = "" { set tQualifier = "" }
	else { set tQualifier = pCollection _ "." }
	if $isObject(statsOref){
		set tOrefField=##class(%ExtentMgr.FieldStatsInfo).%New()
		set tOrefField.Name=field
		if 'ClearValues{
			set tOrefField.Selectivity=value
			if pOutlier'="" {
				set tOrefField.OutlierValue=##class(%Library.Global).Quote($lg(pOutlier,2))
				set tOrefField.OutlierSelectivity=+$lg(pOutlier,1)
			}
			set tOrefField.AverageFieldSize=pAverageFieldSize
			set tOrefField.Histogram=pHistogram
		}
		do statsOref.Fields.Insert(tOrefField)
	} elseif 'KeepClassUpToDate {
		If 'classid { set classid=$$Open^%apiCDL(classname,,5) if $$$ISERR(classid) { set sc=classid QUIT  }}
		If $$$SQLLocColContainerField(fldinfo)="" {  // Not a serial subfield
			s propname=$$$SQLLocColPropertyName(fldinfo)
			i propname="" {
				if 'leaveopen { set sc=$$Close^%apiCDL(classid) }
				QUIT
			}
			set storage=$o($$$SDEF($$$sWRK,classname,""))
			if ClearValues{
				$$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYselectivity)
			} else{
				set currentObjSel=$$$editStorageSubMemberKeyGet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYselectivity)
				if currentObjSel["," {  // possible serial field, has selectivity for serial sub-fields already defined
					set $p(currentObjSel,",",1)=value
					$$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYselectivity,currentObjSel)
				} else {                // non-serial field, or existing object selectivity not defined
					if value'="" { $$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYselectivity,value) }
					else         { $$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYselectivity) }
				}
			}
				// Outlier data in the class global can't be $list(), so we translate to a string delimited by ":"
				// The first ":" piece will be the selectivity, the second through Nth piece will be the value
			if ClearValues{
				$$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYoutlierselectivity)
			} else{
				set currentObjOsel=$$$editStorageSubMemberKeyGet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYoutlierselectivity)
				d ParseOutlierSelectivity^%occStorageUtil(currentObjOsel,.oselArr)
				if oselArr>1 {  // possible serial field, has outlier selectivity for serial sub-fields already defined
					set oselArr(1)=$s(pOutlier'="":$$OutlierIntToExt(pOutlier),1:"")
					d constructSerialStats(.oselArr,.currentObjOsel)
					$$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYoutlierselectivity,currentObjOsel) 
				} else {              // non-serial field, or existing object histogram not defined
					if pOutlier'="" { $$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYoutlierselectivity,$$OutlierIntToExt(pOutlier)) }
					else              { $$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYoutlierselectivity) }
				}
			}
.
			if ClearValues{
				$$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYaveragefieldsize)
			} else{
				set currentAFS=$$$editStorageSubMemberKeyGet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYaveragefieldsize)
				if currentAFS["," {  // possible serial field, has selectivity for serial sub-fields already defined
					set $p(currentAFS,",",1)=pAverageFieldSize
					$$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYaveragefieldsize,currentAFS)
				} else {                // non-serial field, or existing object selectivity not defined
					if pAverageFieldSize'="" { $$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYaveragefieldsize,pAverageFieldSize) }
					else                     { $$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYaveragefieldsize) }
				}
			}
			if ClearValues{
				$$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYhistogram)
			} else{
				set currentHIST=$$$editStorageSubMemberKeyGet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYhistogram)
				d ParseNestedString^%occStorageUtil(currentHIST,",","",.histArr)
				if histArr>1 {  // possible serial field, has histograms for serial sub-fields already defined
					set histArr(1)=pHistogram
					d constructSerialStats(.histArr,.currentHIST)
					$$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYhistogram,currentHIST)
				} else {              // non-serial field, or existing object histogram not defined
					if pHistogram'="" { $$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYhistogram,pHistogram) }
					else              { $$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYhistogram) }
				}
			}
				// Delete property parameter now that we have defined it in storage
			if (pCollection = "") || (pCollection = propname) { $$$editSubMemberKill(classid,$$$cCLASSproperty,propname,$$$cPROPparameter,"SELECTIVITY") }
		}
		Else {  // A serial subfield, add the selectivity to the container field selectivity
			s containerpropname=$$LookUpPropertyName(classname,$$$SQLLocColContainerField(fldinfo)) 
			i containerpropname="" {
				if 'leaveopen { set sc=$$Close^%apiCDL(classid) }
				QUIT
			}
			s propname=$p(field,$$$SQLLocColContainerField(fldinfo)_"_",2)
			s storage=$o($$$SDEF($$$sWRK,classname,""))
			s objsel=$$$editStorageSubMemberKeyGet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYselectivity)
			if (pCollection = "") || (pCollection = containerpropname) { s:objsel="" objsel=$$$comMemberArrayGet(classid,$$$cCLASSproperty,containerpropname,$$$cXXXXparamvalue,"SELECTIVITY") }
			if ClearValues{ set nval="" }
			elseif objsel="",value="" { set nval="" }			// Clearing value
			elseif objsel="" { set nval=propname_":"_value }	// was previously undefined
			else {   // SELECTIVITY for this property previously defined
				set ii=""
				if value'="" f i=1:1:$l(objsel,",") i $p($p(objsel,",",i),":")=propname s ii=$p(objsel,",",i),$p(ii,":",2)=value,$p(objsel,",",i)=ii q
				else  f i=1:1:$l(objsel,",") i $p($p(objsel,",",i),":")=propname s objsel=$p(objsel,",",1,i-1)_$s($p(objsel,",",i+1,*)'="":","_$p(objsel,",",i+1,*),1:"") q
				i $g(ii)="",value'="" s objsel=objsel_","_propname_":"_value  // wasn't found, add it
				s nval=objsel
			}
			if $tr(nval,",")'="" { $$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYselectivity,nval) }
			else { $$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYselectivity) }
			if (pCollection = "") || (pCollection = containerpropname) { $$$editSubMemberKill(classid,$$$cCLASSproperty,containerpropname,$$$cPROPparameter,"SELECTIVITY") } // Delete property parameter now that we have defined it in storage
.
				// possibly update outlier selectivity
			set objsel=$$$editStorageSubMemberKeyGet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYoutlierselectivity)
			set oldobjsel=objsel
			if ClearValues{ set objsel="" }
			elseif objsel="" {   // was previously undefined
				set:pOutlier'="" objsel=","_$$OutlierSerialIntToExt($lb(propname)_pOutlier)
			}
			else {   // OUTLIERSELECTIVITY for this property previously defined
				d ParseOutlierSelectivity^%occStorageUtil(objsel,.oselArr)
				set found = 0
				if pOutlier'="" {
					set newStats = $$OutlierSerialIntToExt($lb(propname)_pOutlier)
					d editSerialStatsArr(.oselArr,propname,0,newStats,.found)
					if ('found) { set objsel=objsel_","_newStats } // wasn't found, add it
					else {
						d constructSerialStats(.oselArr,.objsel)
					}
				}else {
					d editSerialStatsArr(.oselArr,propname,1)
					d constructSerialStats(.oselArr,.objsel)
				}
			}
			if objsel'=oldobjsel {
				if $tr(objsel,",")'="" { $$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYoutlierselectivity,objsel) }
				else { $$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYoutlierselectivity) }
			}
			
				// possibly update average field size
			set objafs=$$$editStorageSubMemberKeyGet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYaveragefieldsize)
			if ClearValues{ set nval2="" }
			elseif objafs="",pAverageFieldSize="" { set nval2="" }  		// Clearing value
			elseif objafs="" { set nval2=propname_":"_pAverageFieldSize }	// was previously undefined
			Else {   // AverageFieldSize for this property previously defined
				set ii=""
				if pAverageFieldSize'="" {
					for i=1:1:$l(objafs,",") {
						if $p($p(objafs,",",i),":")=propname { set ii=$p(objafs,",",i),$p(ii,":",2)=pAverageFieldSize,$p(objafs,",",i)=ii quit  }
					}
				}
				else {
					for i=1:1:$l(objafs,",") {
						if $p($p(objafs,",",i),":")=propname { set objafs=$p(objafs,",",1,i-1)_$s($p(objafs,",",i+1,*)'="":","_$p(objafs,",",i+1,*),1:"") quit  }
					}
				}
				if $g(ii)="",pAverageFieldSize'="" { set objafs=objafs_","_propname_":"_pAverageFieldSize } // wasn't found, add it
				set nval2=objafs
			}
			if $tr(nval2,",")'="" { $$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYaveragefieldsize,nval2) }
			else { $$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYaveragefieldsize) }
			
				// possibly update histogram
			set objhist=$$$editStorageSubMemberKeyGet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYhistogram)
			if ClearValues{ set nval3="" }
			elseif objhist="",pHistogram="" { set nval3="" }  		    // Clearing value
			elseif objhist="" { set nval3=propname_":"_pHistogram }	// was previously undefined
			Else {   // Histogram for this property previously defined
				d ParseNestedString^%occStorageUtil(objhist,",","",.histArr)
				set found = 0
				if pHistogram'="" {
					set newStats = propname_":"_pHistogram
					d editSerialStatsArr(.histArr,propname,0,newStats,.found)
					if ('found) { set objhist=objhist_","_newStats } // wasn't found, add it
					else {
						d constructSerialStats(.histArr,.objhist)
					}
				}
				else {
					d editSerialStatsArr(.histArr,propname,1)
					d constructSerialStats(.histArr,.objhist)
				}
				set nval3=objhist
			}
			if $tr(nval3,",")'="" { $$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYhistogram,nval3) }
			else { $$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYhistogram) }
			
		}
		If 'leaveopen {
			s sc=$$Save^%apiDDL(classid) i $$$ISERR(sc) d Close^%apiCDL(classid) QUIT
			s sc=$$Close^%apiCDL(classid)
		}
	}	// Class not kept up-to-date
	Else {	// Keep the class up-to-date
		If $$$SQLLocColContainerField(fldinfo)="" {  // Not a serial subfield
			set propname=$$$SQLLocColPropertyName(fldinfo)
			QUIT:propname=""
			set storage=$o($$$SDEF($$$sDEF,classname,""))
			if ClearValues{
				$$$defStorageSubMemberKeyKill(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYselectivity)
			} else{
				set currentObjSel=$$$defStorageSubMemberKeyGet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYselectivity)
				if currentObjSel["," {  // possible serial field, has selectivity for serial sub-fields already defined
					set $p(currentObjSel,",",1)=value
					$$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYselectivity,currentObjSel)
				} else {                // non-serial field, or existing object selectivity not defined
					if value'="" { $$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYselectivity,value) }
					else         { $$$defStorageSubMemberKeyKill(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYselectivity) }
				}
			}
			if ClearValues{
				$$$defStorageSubMemberKeyKill(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYoutlierselectivity) 
			} else{
				set currentObjOsel=$$$defStorageSubMemberKeyGet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYoutlierselectivity)
				d ParseOutlierSelectivity^%occStorageUtil(currentObjOsel,.oselArr)
				if oselArr>1 {  // possible serial field, has outlier selectivity for serial sub-fields already defined
					set oselArr(1)=$s(pOutlier'="":$$OutlierIntToExt(pOutlier),1:"")
					d constructSerialStats(.oselArr,.currentObjOsel)
					$$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYoutlierselectivity,currentObjOsel) 
				} else {              // non-serial field, or existing object histogram not defined
					if pOutlier'="" { $$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYoutlierselectivity,$$OutlierIntToExt(pOutlier)) }
					else              { $$$defStorageSubMemberKeyKill(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYoutlierselectivity) }
				}			
			}
			if ClearValues{
				$$$defStorageSubMemberKeyKill(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYaveragefieldsize)
			} else{
				set currentAFS=$$$defStorageSubMemberKeyGet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYaveragefieldsize)
				if currentAFS["," {  // possible serial field, has selectivity for serial sub-fields already defined
					set $p(currentAFS,",",1)=pAverageFieldSize
					$$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYaveragefieldsize,currentAFS)
				} else {                // non-serial field, or existing object selectivity not defined
					if pAverageFieldSize'="" { $$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYaveragefieldsize,pAverageFieldSize) }
					else         { $$$defStorageSubMemberKeyKill(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYaveragefieldsize) }
				}
			}
			if ClearValues{
				$$$defStorageSubMemberKeyKill(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYhistogram)
			} else{
				set currentHIST=$$$defStorageSubMemberKeyGet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYhistogram)
				d ParseNestedString^%occStorageUtil(currentHIST,",","",.histArr)
				if histArr>1 {  // possible serial field, has histograms for serial sub-fields already defined
					set histArr(1)=pHistogram
					d constructSerialStats(.histArr,.currentHIST)
					$$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYhistogram,currentHIST)
				} else {              // non-serial field, or existing object histogram not defined
					if pHistogram'="" { $$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYhistogram,pHistogram) }
					else              { $$$defStorageSubMemberKeyKill(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_propname,$$$cSTORAGEPROPERTYhistogram) }
				}
			}
			if (pCollection = "") || (pCollection = propname) { $$$defSubMemberKill(classname,$$$cCLASSproperty,propname,$$$cPROPparameter,"SELECTIVITY") } // Delete property parameter now that we have defined it in storage
		}
		Else {  // A serial sub-field, add the selectivity to the container field selectivity
			s containerpropname=$$LookUpPropertyName(classname,$$$SQLLocColContainerField(fldinfo)) 
			QUIT:containerpropname=""
			s propname=$p(field,$$$SQLLocColContainerField(fldinfo)_"_",2)
			s storage=$o($$$SDEF($$$sDEF,classname,""))
			s objsel=$$$defStorageSubMemberKeyGet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYselectivity)
			if (pCollection = "") || (pCollection = containerpropname) { s:objsel="" objsel=$$$defMemberArrayGet(classname,$$$cCLASSproperty,containerpropname,$$$cXXXXparamvalue,"SELECTIVITY") }
			if ClearValues{ set nval="" }
			elseif objsel="",value="" { set nval="" }			// Clearing value
			Elseif objsel="" { set nval=propname_":"_value }	// was previously undefined
			Else {   // SELECTIVITY for this property previously defined
				set ii=""
				if value f i=1:1:$l(objsel,",") i $p($p(objsel,",",i),":")=propname s ii=$p(objsel,",",i),$p(ii,":",2)=value,$p(objsel,",",i)=ii q  
				else  f i=1:1:$l(objsel,",") i $p($p(objsel,",",i),":")=propname set objsel=$p(objsel,",",1,i-1)_$s($p(objsel,",",i+1,*)'="":","_$p(objsel,",",i+1,*),1:"") q  
				i $g(ii)="",value'="" s objsel=objsel_","_propname_":"_value  // wasn't found, add it
				s nval=objsel
			}
			$$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYselectivity,nval)
			if (pCollection = "") || (pCollection = containerpropname) { $$$defSubMemberKill(classname,$$$cCLASSproperty,containerpropname,$$$cPROPparameter,"SELECTIVITY") } // Delete property parameter now that we have defined it in storage
			
				// possibly update outlier selectivity
			set objsel=$$$defStorageSubMemberKeyGet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYoutlierselectivity)
			set oldobjsel=objsel
			if ClearValues{ set objsel="" }
			elseif objsel="" {   // was previously undefined
				set:pOutlier'="" objsel=","_$$OutlierSerialIntToExt($lb(propname)_pOutlier)
			}
			else {   // OUTLIERSELECTIVITY for this property previously defined
				d ParseOutlierSelectivity^%occStorageUtil(objsel,.oselArr)
				set found = 0
				if pOutlier'="" {
					set newStats = $$OutlierSerialIntToExt($lb(propname)_pOutlier)
					d editSerialStatsArr(.oselArr,propname,0,newStats,.found)
					if ('found) { set objsel=objsel_","_newStats } // wasn't found, add it
					else {
						d constructSerialStats(.oselArr,.objsel)
					}
				}else {
					d editSerialStatsArr(.oselArr,propname,1)
					d constructSerialStats(.oselArr,.objsel)
				}
			}
			if objsel'=oldobjsel {
				if $tr(objsel,",")'="" { $$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYoutlierselectivity,objsel) }
				else { $$$defStorageSubMemberKeyKill(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYoutlierselectivity) }
			}
			
				// possibly update average field size
			set objafs=$$$defStorageSubMemberKeyGet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYaveragefieldsize)
			if ClearValues{ set nval2="" }
			elseif objafs="",pAverageFieldSize="" { set nval2="" }  		// Clearing value
			elseif objafs="" { set nval2=propname_":"_pAverageFieldSize }	// was previously undefined
			else {   // AverageieldSize for this property previously defined
				set ii=""
				if pAverageFieldSize {
					for i=1:1:$l(objafs,",") {
						if $p($p(objafs,",",i),":")=propname { set ii=$p(objafs,",",i),$p(ii,":",2)=pAverageFieldSize,$p(objafs,",",i)=ii quit  }
					}
				}  
				else {
					for i=1:1:$l(objafs,",") { if $p($p(objafs,",",i),":")=propname { set objafs=$p(objafs,",",1,i-1)_$s($p(objafs,",",i+1,*)'="":","_$p(objafs,",",i+1,*),1:"") quit  }}
				}  
				if $g(ii)="",pAverageFieldSize'="" { set objafs=objafs_","_propname_":"_pAverageFieldSize }  // wasn't found, add it
				set nval2=objafs
			}
			if $tr(nval2,",")'="" { $$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYaveragefieldsize,nval2) }
			else         { $$$defStorageSubMemberKeyKill(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYaveragefieldsize) }
			
				// possibly update histogram
			set objhist=$$$defStorageSubMemberKeyGet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYhistogram)
			if ClearValues{ set nval3="" }
			elseif objhist="",pHistogram="" { set nval3="" }  		    // Clearing value
			elseif objhist="" { set nval3=propname_":"_pHistogram }	// was previously undefined
			Else {   // Histogram for this property previously defined
				d ParseNestedString^%occStorageUtil(objhist,",","",.histArr)
				set found = 0
				if pHistogram'="" {
					set newStats = propname_":"_pHistogram
					d editSerialStatsArr(.histArr,propname,0,newStats,.found)
					if ('found) { set objhist=objhist_","_newStats } // wasn't found, add it
					else {
						d constructSerialStats(.histArr,.objhist)
					}
.
				}
				else {
					d editSerialStatsArr(.histArr,propname,1)
					d constructSerialStats(.histArr,.objhist)
				}
				set nval3=objhist
			}
			if $tr(nval3,",")'="" { $$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYhistogram,nval3) }
			else         { $$$defStorageSubMemberKeyKill(classname,$$$cCLASSstorage,storage,$$$cSDEFproperty,tQualifier_containerpropname,$$$cSTORAGEPROPERTYhistogram) }
			
		}
		
			#; if we are done with the class here, update the DEF/COM timestamps
		if 'leaveopen {
			set tTS=$zu(188)
			$$$defClassKeySet(classname,$$$cCLASStimechanged,tTS)
			do RebuildItemIndex^%R(classname,"CLS",,1)
			set sc=$$KeepClassUpToDate^%occDepend(classname)
			if $$$ISERR(sc) { do logStatus(display,pLogFile,sc,5) }
		}
	}	// Class kept up-to-date
	QUIT
}
constructSerialStats(&arr,&output) PRIVATE {
	set key = "", output = ""
	for {
		set key = $o(arr(key),1,val) q:key=""
		set output=output_val_","	
	}
	set output = $e(output,1,*-1)
	RETURN
}
editSerialStatsArr(&arr,propname,kill,newStats,&found) PRIVATE {
	set found = 0
	for i = 1:1:$g(arr,0) {
		if $p(arr(i),":")=propname {
			if kill {
				k arr(i)
			} else {
				set arr(i)=newStats
				set found = 1	
			}
			quit
		}
	}
	RETURN
}
LookUpPropertyName(classname,fieldname) [] PRIVATE {
	    #; ------------------------------------------------------------------
	    #; Function:     LookUpPropertyName
	    #; Purpose:      Given a class handle and a field name, return
	    #;               the Property Name for the field as defined in ^oddMAP
	    #; Parameters:
	    #;   classname - Handle to a Class which has already been Opened
	    #;   fieldname - Name of the field
	    #; ------------------------------------------------------------------
	    #;
	  s prop=""
	    #; First check all properties to see if sqlfieldname is equal to the fieldname
	  f  s prop=$$$comMemberNext(classname,$$$cCLASSproperty,prop) q:prop=""  i $$$UPPER($$$comMemberKeyGet(classname,$$$cCLASSproperty,prop,$$$cPROPsqlfieldname))=$$$UPPER(fieldname) q
	    #; If none were found, now check if any property names are equal to the fieldname
	  i prop="" f  s prop=$$$comMemberNext(classname,$$$cCLASSproperty,prop) q:prop=""  i $$$comMemberKeyGet(classname,$$$cCLASSproperty,prop,$$$cPROPsqlfieldname)="",$$$UPPER(prop)=$$$UPPER(fieldname) q
	    #; If no property matched the fieldname, PROPERTY will be ""
	  QUIT prop
	}
	
	// Given an outler selectivity value in the form selectivity,value, convert this to a format that can be handled internally.
	// We convert to $lb(selectivity,value)
	// Value may be quoted and if it had control characters it is in $$Quote^%qcr(value) format
	// This format is stored in SQL metadata
OutlierExtToInt(pVal="",pDel=":") [] PUBLIC {
	QUIT:pVal="" ""
	set pSel=$p(pVal,pDel),pData=$p(pVal,pDel,2,*)
	QUIT:pData="" $lb(pSel,)
	QUIT $lb(+pSel,$$Unquote(pData))
}
	
	// Given an outler selectivity value in the form $lb(selectivity,value), convert this to a format that can be handled by XML.
	// We convert to selectivity,value
	// If value contains any control characters, we return $$Quote^%qcr(value)
	// This format is stored in Object metadata (and exported to XML)
OutlierIntToExt(pVal="") [] PUBLIC {
	QUIT:pVal="" ""
	set pSel=$lg(pVal),pData=$lg(pVal,2)
	QUIT:pData="" pSel_":"
	QUIT pSel_":"_##class(%Library.Global).Quote(pData)
}
.
	// Given an outler selectivity value for a serial sub-field in the form $lb(field,selectivity,value), convert this to a format that can be handled by XML.
	// We convert to field:selectivity:value
	// If value contains any control characters, we return $$Quote^%qcr(value) for value
	// This format is stored in Object metadata (and exported to XML)
OutlierSerialIntToExt(pVal="") [] PUBLIC {
	QUIT:pVal="" ""
	set pField=$lg(pVal),pSel=$lg(pVal,2),pData=$lg(pVal,3)
	QUIT:pData="" pField_":"_pSel_":"
	QUIT pField_":"_pSel_":"_##class(%Library.Global).Quote(pData)
}
.
CreateLogFile(pLogFile) [] {
		#; Creates the Tune Table log file, returns Status Code
	set sc=$$$OK
	$$$DebugTrace("CreateLogFile^%qarTune: pLogFile="_$g(pLogFile))
	open pLogFile:"WNS":5 else  set sc=$$$ERROR($$$FileCanNotOpen,pLogFile) goto exit
	close pLogFile
exit	$$$DebugTrace("CreateLogFile^%qarTune(END): sc="_sc)
	RETURN sc
}
.
AppendToLogFile(pLogFile) [] {
		#; Opens an existing Tune Table log file for append, returns Status Code
	$$$DebugTrace("AppendToLogFile^%qarTune: pLogFile="_$g(pLogFile))
	open pLogFile:"WAS":5 else  set sc=$$$ERROR($$$FileCanNotOpen,pLogFile) goto exit
exit	$$$DebugTrace("SppendToLogFile^%qarTune(END): sc="_sc)
	RETURN $$$OK
}
.
FlushLog(pLogFile,close=0,tStartTime,tTabCount,%TTNS) [] PRIVATE {
	$$$DebugTrace("FlushLog^%qarTune: pLogFile="_$g(pLogFile),", close="_$g(close)_", tStartTime="_$g(tStartTime)_", tTabCount="_$g(tTabCount)_", %TTNS="_$g(%TTNS))
	set sc = $$$OK
	if pLogFile'="" {
		do:close LogFileTrailer(pLogFile,$zh-tStartTime,tTabCount)
		set sc = $$WriteToLogFile(pLogFile,%TTNS)
		$$$LogClear
		if close { close pLogFile }
	}
	$$$DebugTrace("FlushLog^%qarTune(END):")
	RETURN sc
}
.
	
WriteToLogFile(pLogFile,%TTNS) [] PUBLIC {
		#; Opens an existing Tune Table log file for append, returns Status Code
	$$$DebugTrace("WriteToLogFile^%qarTune: pLogFile="_$g(pLogFile),", %TTNS="_$g(%TTNS))
	set sc=$$$OK
	do $SYSTEM.ECP.Sync()
	lock +^|%TTNS|IRIS.TuneTableLog:$s($zu(115,5)<10:10,1:$zu(115,5))
	if '$t { set sc=$$$ERROR($$$FileCanNotOpen,pLogFile) goto exit}
	#; YCL190 - make log file writeable
	do ##class(%File).SetWriteable(pLogFile,0)
	open pLogFile:"WAS":5 
	if '$t { 
		lock -^|%TTNS|IRIS.TuneTableLog:"I"
		set sc=$$$ERROR($$$FileCanNotOpen,pLogFile)
		goto exit
	}
	try {
		use pLogFile
		for i=1:1:$$$LogGlobalRoot {
			set data=$$$LogGlobalName($j,i)  // data is $lb(indent,msg,indent,msg,...)
			write !
			for j=1:2:$ll(data) {
				write ?$lg(data,j),$lg(data,j+1)
			}
		}
		//hang .1  // Hang here to allow output to finish before close
		close pLogFile
		$$$LogClear
	} catch {
		close pLogFile
		lock -^|%TTNS|IRIS.TuneTableLog:"I"
		set sc=$$$ERROR($$$GeneralError,"Process "_$j_", Namespace "_$namespace_" :: Unexpected error writing to log file "_pLogFile_", $ze="_$ze)
		goto exit
	}
	lock -^|%TTNS|IRIS.TuneTableLog:"I"
exit	$$$DebugTrace("WriteToLogFile^%qarTune(END): sc="_sc)
	RETURN sc
}
.
	// Displays the contents of ^|%TTNS|IRIS.TuneTableLog to the current device
DisplayLog(%TTNS) [] PUBLIC {
	$$$DebugTrace("DisplayLog^%qarTune: %TTNS="_$g(%TTNS))
	set sc=$$$OK
	do $SYSTEM.ECP.Sync()
	lock +^|%TTNS|IRIS.TuneTableLog:$s($zu(115,5)<10:10,1:$zu(115,5))
	if '$t { set sc=$$$ERROR($$$FileCanNotOpen,pLogFile) goto exit}
	try {
		for i=1:1:$g($$$LogGlobalRoot) {
			set data=$$$LogGlobalName($j,i)  // data is $lb(indent,msg,indent,msg,...)
			write !
			for j=1:2:$ll(data) {
				write ?$lg(data,j),$lg(data,j+1)
			}
		}
	} catch {
		lock -^|%TTNS|IRIS.TuneTableLog:"I"
		set sc=$$$ERROR($$$GeneralError,"Process "_$j_", Namespace "_$namespace_" :: Unexpected error writing to log file "_pLogFile_", $ze="_$ze)
		goto exit
	}
	lock -^|%TTNS|IRIS.TuneTableLog:"I"
exit	$$$DebugTrace("DisplayLog^%qarTune(END): sc="_sc)
	RETURN $$$OK
}
.
LogFileHeader(pLogFile) [] {
		#; Assue pLogFile is open and writable
	//set currDevice = $IO
	//use pLogFile
	do log(0,pLogFile,$$$FormatText($$$Text("InterSystems TuneTable Log, created %1 by process %2 in namespace %3","%SQL.TuneTable"),$zdt($h),$j,$namespace),0)
	do log(0,pLogFile,$$$FormatText($$$Text("Version: %1","%SQL.TuneTable"),$zv),1)
	do log(0,pLogFile,$$$FormatText($$$Text("User: %1","%SQL.TuneTable"),$username),1)
	//use currDevice
	RETURN $$$OK
}
.
LogFileAppendSeparator(pLogFile) [] {
	#; Assume pLogFile is open and writable
	//set currDevice = $IO
	//use pLogFile
	do log(0,pLogFile,0,"--------------------------------------------")
	//use currDevice
	RETURN $$$OK
}
.
LogFileTrailer(pLogFile,pTime,pTabCount) [] {
		#; Assue pLogFile is open and writable
	//set currDevice = $IO
	//use pLogFile
	//write !!,"--------------------------------------------"
	do log(0,pLogFile,"")
	do log(0,pLogFile,$$$FormatText($$$Text("Tuning of %1 tables completed in %2","%SQL.TuneTable"),pTabCount,$zdt($h)))
	do log(0,pLogFile,$$$FormatText($$$Text("Elapsed time is %1 seconds","%SQL.TuneTable"),pTime))
	//use currDevice
	RETURN $$$OK
}
.
ProcessError(sc,&SQLCODE="") [] PUBLIC {
	#; ------------------------------------------------------------------
	#; Function:     ProcessError
	#; Purpose:      Given a sc status code, build %msg with an error msg
	#; Parameters:
	#;   sc         - Status code
	#;   SQLCODE     - SQL Status Code, passed by reference
	#; ------------------------------------------------------------------
	#;
	set errlist="" set:SQLCODE'="" SQLCODE=-400
	do DecomposeStatus^%apiOBJ(sc,.errlist)
	for i=1:1:errlist s %msg=errlist(i)_$s(i>1:"  ",1:"")
	QUIT $g(%msg)
}
.
log(display,pLogFile="",message,indent=1,newline=1,pParentPid=0) [] PUBLIC {
	set:pParentPid $$$MsgGlobalName(pParentPid,$I($$$MsgGlobalName(pParentPid)))=message
	if display { write:newline ! write ?indent,message }
 	if (pLogFile'="")||(display="shard local table") {
	 	if newline { do $i($$$LogGlobalRoot) }
	 	$$$LogMessage(indent,message)
.
		
		//set tCurrentDevice=$IO
		//use pLogFile
		//write:newline ! w ?indent,message
		//use tCurrentDevice
	}
	RETURN
}
.
logStatus(display,pLogFile="",sc,indent=1,pParentPid=0) [] {
	set tCurrentDevice=$IO
	do log(display,pLogFile,"------",indent,1)
	do DecomposeStatus^%apiOBJ(sc,.errorlist)
	for i=1:1:$g(errorlist) { 
		do log(display,pLogFile,errorlist(i),indent,1,pParentPid)
	}
	do log(display,pLogFile,"------",indent,1)
	RETURN
}
.
	// export the EXTENTSIZE and SELECTIVITY for all tables to an XML file
	// Called from:
	//   %SYSTEM.SQL.ExportTuneStats (DEPRECATED)
	// 	 $SYSTEM.SQL.Stats.Table.Export
	// pType is an integer flag (1/2/3) to indicate the type of table statistics need to be output. 
	// the first bit is the tune stats in the class def, the secodn bit is the latest stats in the extent metadata db.
	// 1 means just export the fixed table statistics in class definition; 
	// 2 means just export the latest collected table statistics;
	// 3 means export both the fixed table statistics in class definition and the latest collected table statistics
ExportTuneStats(pFilename,pSchemaFilter="",pTableFilter="",pDisplay=1,pType=1) [] PUBLIC {
.
	set tSC=$$$OK
	try {
		set tSchemaFilter=0,tSchemaFilter2=0,tTableFilter=0,tTableFilter2=0,tSchemaLoop="&"
		if pSchemaFilter'="" {
			set tSchemaLoop="~"
			for i=1:1:$l(pSchemaFilter,",") {
				set thisFilter=$$$UPPER($p(pSchemaFilter,",",i))
				set not=0 if $e(thisFilter)="'" set not=1,thisFilter=$e(thisFilter,2,*)
				if 'not { set tSchemaFilter($i(tSchemaFilter))=##class(%Library.ODBCCatalog).MakePat($tr(thisFilter,"*","%"),"\") }
				else    { set tSchemaFilter2($i(tSchemaFilter2))=##class(%Library.ODBCCatalog).MakePat($tr(thisFilter,"*","%"),"\") }
				set xx=$p($p(thisFilter,"*"),"_")
				if xx'="",'not { 
					if $l(xx)=1 { set loopStart=$c($a(xx)-1) } else { set loopStart=$e(xx,1,*-1)_$c($a(xx,$l(xx))-1) }
					set:loopStart']]tSchemaLoop tSchemaLoop=loopStart
				}
				else { set tSchemaLoop="&" }
			}
		}
	 	#; tSchemaFilter is now an array of pattern match arguments
	 	#; tSchemaFilter2 is an array of NOT pattern match arguments
.
		set tTableLoopStart=""
		if pTableFilter'="" {
			for i=1:1:$l(pTableFilter,",") {
				set thisFilter=$$$UPPER($p(pTableFilter,",",i))
				set not=0 if $e(thisFilter)="'" set not=1,thisFilter=$e(thisFilter,2,*)
				if 'not { set tTableFilter($i(tTableFilter))=##class(%Library.ODBCCatalog).MakePat($tr(thisFilter,"*","%"),"\") }
				else    { set tTableFilter2($i(tTableFilter2))=##class(%Library.ODBCCatalog).MakePat($tr(thisFilter,"*","%"),"\") }
				set xx=$p($p(thisFilter,"*"),"_")
				if xx'="",'not { 
					if $l(xx)=1 { set loopStart=$c($a(xx)-1) } else { set loopStart=$e(xx,1,*-1)_$c($a(xx,$l(xx))-1) }
					set:loopStart']]tTableLoopStart tTableLoopStart=loopStart
				}
				else { set tTableLoopStart="" }
			}
		}
	 	#; tTableFilter is now an array of pattern match arguments
	 	#; tTableFilter2 is an array of NOT pattern match arguments
.
		write:pDisplay !,$$$FormatText($$$Text("Exporting SQL TuneTable statistics on %1, to file %2","%SQL.TuneTable"),$zdt($h),pFilename)
		set tTime=$zh
		set writer = ##class(%XML.Writer).%New()
		set writer.Charset = "UTF-8", writer.Indent = 1
		set tSC=writer.OutputToFile(pFilename)
		quit:$$$ISERR(tSC)
		set tSC=writer.RootElement("Export generator=""CacheTuneTable"" version=""1""")
		quit:$$$ISERR(tSC)
.
		for  {
			set tSchemaLoop=$o(^rINDEXSQL("rv",tSchemaLoop)) quit:tSchemaLoop=""
			if tSchemaFilter {
				set ok=0
				for i=1:1:tSchemaFilter {
					if tSchemaLoop?@tSchemaFilter(i) { set ok=1 quit  }
				}
				continue:'ok 			// Schema does not match any of the positive patterns specified, try next schema
			}
			if tSchemaFilter2 {	// NOT pattern matches
				set ok=1
				for i=1:1:tSchemaFilter2 {
					if tSchemaLoop?@tSchemaFilter2(i) { set ok=0 quit  }
				}
				continue:'ok 			// Schema does match one of the NOT patterns specified, don't report it, try next schema
			}
			set tTableLoop=tTableLoopStart
			for  {
				set tTableLoop=$o(^rINDEXSQL("rv",tSchemaLoop,tTableLoop),1,data)
				quit:tTableLoop=""
				continue:($lg(data,3)'=1)	 	// not a table
				if tTableFilter {
					set ok=0
					for i=1:1:tTableFilter {
						if tTableLoop?@tTableFilter(i) { set ok=1 quit  }
					}
					continue:'ok 			// Table does not match any of the positive patterns specified, try next table
				}
				if tTableFilter2 {	// NOT pattern matches
					set ok=1
					for i=1:1:tTableFilter2 {
						if tTableLoop?@tTableFilter2(i) { set ok=0 quit  }
					}
					continue:'ok 			// Table does match one of the NOT patterns specified, don't report it, try next table
				}
.
				continue:'$$AnyPrivObj^%SYS.SQLSEC("1,"_$lg(data,4),0)		// Not privileged, try next table
.
				set:(pType=1)||(pType=3) tSC=$$ExportOneTable(.writer,$$$SchemaFromIQN($lg(data,4)),$$$TableFromIQN($lg(data,4)),pDisplay)
				if (pType=2)||(pType=3) {
					set tSC=##class(%ExtentMgr.TableStatsInfo).GetLatestCollectedStatsInfo($$$GetClassNameFromIQN($lg(data,4)),pDisplay,.stat)
					if tSC&&(stat'=""){
						do Convert2TuneTableStats($$$SchemaFromIQN($lg(data,4)),$$$TableFromIQN($lg(data,4)),$$$GetClassNameFromIQN($lg(data,4)),stat,.tOref)
						set tSC=writer.Object(tOref)
					}
				}
				quit:$$$ISERR(tSC)
			}
			quit:$$$ISERR(tSC)
		}
		quit:$$$ISERR(tSC)
		set tSC=writer.EndRootElement()				// Export
		quit:$$$ISERR(tSC)
		write:pDisplay !!,$$$FormatText($$$Text("Export completed in %1 seconds","%SQL.TuneTable"),$zh-tTime)
	}
	catch(ex) {
		set tSC=ex.AsStatus()
		if pDisplay do DisplayError^%apiOBJ(tSC)
	}
	QUIT tSC
}
.
/// Convert %ExtentMgr.TableStatsInfo obj (pTableStatsInfo) to %SQL.Util.TuneTableStats obj (pTuneTableStats)
Convert2TuneTableStats(pSchema,pTable,pClassName,pTableStatsInfo,&pTuneTableStats) PUBLIC {
	set pTuneTableStats=##class(%SQL.Util.TuneTableStats).%New()
	set pTuneTableStats.schema=pSchema
	set pTuneTableStats.table=pTable
	set pTuneTableStats.class=pClassName
	set pTuneTableStats.type="Collected Table Statistics"
	set pTuneTableStats.extentsize=pTableStatsInfo.ExtentSize
	set pTuneTableStats.endtime=pTableStatsInfo.EndTime
	set pTuneTableStats.duration=pTableStatsInfo.Duration
	set pTuneTableStats.username=pTableStatsInfo.UserName
	set pTuneTableStats.samplepercent=pTableStatsInfo.SamplePercent
	#; StorageInfo
	set tKey=""
	for {
		set tOrefStorageInfo=pTableStatsInfo.StorageInfo.GetNext(.tKey)
		quit:tKey=""
		quit:tOrefStorageInfo=""
		set pTuneTableStatsStorageInfo=##class(%SQL.Util.TuneTableStatsStorageInfo).%New() 
		set pTuneTableStatsStorageInfo.type=tOrefStorageInfo.Type
		set pTuneTableStatsStorageInfo.name=tOrefStorageInfo.Name
		set pTuneTableStatsStorageInfo.info=tOrefStorageInfo.Info
		do pTuneTableStats.storageinfo.Insert(pTuneTableStatsStorageInfo)
	}
	#; Fields
	set tKey=""
	for {
		set tOrefField=pTableStatsInfo.Fields.GetNext(.tKey)
		quit:tKey=""
		quit:tOrefField=""
		set pTuneTableStatsField=##class(%SQL.Util.TuneTableStatsFields).%New() 
		set pTuneTableStatsField.name=tOrefField.Name
		set pTuneTableStatsField.selectivity=tOrefField.Selectivity
		set pTuneTableStatsField.averagefieldsize=tOrefField.AverageFieldSize
		set pTuneTableStatsField.histogram=tOrefField.Histogram
		if tOrefField.OutlierSelectivity'="" {
			set pTuneTableStatsField.outlierselectivity=##class(%Library.Global).Quote($lb(tOrefField.OutlierSelectivity,$$Unquote(tOrefField.OutlierValue)))
		} else {
			set pTuneTableStatsField.outlierselectivity=##class(%Library.Global).Quote("")
		}
		do pTuneTableStats.fields.Insert(pTuneTableStatsField)
	}
	#; Maps
	set tKey=""
	for {
		set tOrefMap=pTableStatsInfo.Maps.GetNext(.tKey)
		quit:tKey=""
		quit:tOrefMap=""
		set pTuneTableStatsMap=##class(%SQL.Util.TuneTableStatsMaps).%New() 
		set pTuneTableStatsMap.blockcount=$s($isvalidnum(tOrefMap.BlockCount):-tOrefMap.BlockCount,1:tOrefMap.BlockCount)
		set pTuneTableStatsMap.name=tOrefMap.Name
		do pTuneTableStats.maps.Insert(pTuneTableStatsMap)
	}
	RETURN
}
.
/// Convert %SQL.Util.TuneTableStats obj (pTuneTableStats) to %ExtentMgr.TableStatsInfo obj (pTableStatsInfo)
Convert2TableStatsInfo(pTuneTableStats,&pTableStatsInfo) PUBLIC {
	set pTableStatsInfo=##class(%ExtentMgr.TableStatsInfo).%New()
	set pTableStatsInfo.ExtentSize=pTuneTableStats.extentsize
	set pTableStatsInfo.EndTime=pTuneTableStats.endtime
	set pTableStatsInfo.Duration=pTuneTableStats.duration
	set pTableStatsInfo.UserName=pTuneTableStats.username
	set pTableStatsInfo.SamplePercent=pTuneTableStats.samplepercent
	#; StorageInfo
	set tKey=""
	for {
		set tOrefStorageInfo=pTuneTableStats.storageinfo.GetNext(.tKey)
		quit:tKey=""
		quit:tOrefStorageInfo=""
		set pTableStatsInfoStorageInfo=##class(%ExtentMgr.StorageInfo).%New() 
		set pTableStatsInfoStorageInfo.Type=tOrefStorageInfo.type
		set pTableStatsInfoStorageInfo.Name=tOrefStorageInfo.name
		set pTableStatsInfoStorageInfo.Info=tOrefStorageInfo.info
		do pTableStatsInfo.StorageInfo.Insert(pTableStatsInfoStorageInfo)
	}
	#; Fields
	set tKey=""
	for {
		set tOrefField=pTuneTableStats.fields.GetNext(.tKey)
		quit:tKey=""
		quit:tOrefField=""
		set pTableStatsInfoField=##class(%ExtentMgr.FieldStatsInfo).%New()
		set pTableStatsInfoField.Name=tOrefField.name
		set pTableStatsInfoField.Selectivity=tOrefField.selectivity
		set pTableStatsInfoField.AverageFieldSize=tOrefField.averagefieldsize
		set pTableStatsInfoField.Histogram=tOrefField.histogram
		if tOrefField.outlierselectivity'="" {
			set outlierInfo=$$Unquote(tOrefField.outlierselectivity)
			set pTableStatsInfoField.OutlierSelectivity=$lg(outlierInfo)
			set pTableStatsInfoField.OutlierValue=##class(%Library.Global).Quote($lg(outlierInfo,2))
		}
		do pTableStatsInfo.Fields.Insert(pTableStatsInfoField)
	}
	#; Maps
	set tKey=""
	for {
		set tOrefMap=pTuneTableStats.maps.GetNext(.tKey)
		quit:tKey=""
		quit:tOrefMap=""
		set pTableStatsInfoMap=##class(%ExtentMgr.MapStatsInfo).%New() 
		set pTableStatsInfoMap.BlockCount=$s($isvalidnum(tOrefMap.blockcount):-tOrefMap.blockcount,1:tOrefMap.blockcount)
		set pTableStatsInfoMap.Name=tOrefMap.name
		do pTableStatsInfo.Maps.Insert(pTableStatsInfoMap)
	}
	RETURN
}
	#; Given a single table, export the fixed stats for the table to an XML file
ExportOneTable(writer,pSchema,pTablename,pDisplay) [] PUBLIC {
	
		#; Get this table's extentsize
	set tSC=$$$OK
	try {
		set tExtent=$$$GetExtentNameFromTableName(pSchema,pTablename)
		quit:tExtent=""
		write:pDisplay !,$$$FormatText($$$Text("Exporting tune table stats for table %1.%2","%SQL.TuneTable"),pSchema,pTablename)
		set tExtInfo=$g($$$EXTsqlinfo($$$rEXT,tExtent))
		set tExtentsize=$$$SQLLocTableExtentSize(tExtInfo)
.
		set tOref=##class(%SQL.Util.TuneTableStats).%New()
		
		set tOref.schema=pSchema
		set tOref.table=pTablename
		set tOref.class=$$$GetClassNameFromTableName(pSchema,pTablename)
		set tOref.type="Fixed Table Statistics"
		set tOref.extentsize=tExtentsize
		set tField=""
		for  {
			set tField=$o($$$EXTSQLCOL($$$rEXT,tExtent,tField)) quit:tField=""
			set tFldInfo=$$$EXTSQLCOLsqlinfo($$$rEXT,tExtent,tField)
			continue:$$$SQLLocColSelectivity(tFldInfo)=""	// no selectivity specified for this field
			set tOutlierSelectivity=$$$SQLLocColOutlierSelectivity(tFldInfo)
				#; Convert to "object" selectivity value
			if $$$SQLLocColSelectivity(tFldInfo) {
				set tSelectivity=$j((100/$$$SQLLocColSelectivity(tFldInfo)),0,4)_"%" 
				set:'tSelectivity tSelectivity=$zstrip($j(100/$$$SQLLocColSelectivity(tFldInfo),0,19),">W","0")_"%"
			}
			if $$$SQLLocColSelectivity(tFldInfo)="NUMROWS"||'$$$SQLLocColSelectivity(tFldInfo) { set tSelectivity=1 }
			set tAverageFieldSize=$$$SQLLocColAverageFieldSize(tFldInfo)
			set tHistogram=$$$SQLLocColHistogram(tFldInfo)
			set tOrefField=##class(%SQL.Util.TuneTableStatsFields).%New()
			set tOrefField.name=tField
			set tOrefField.selectivity=tSelectivity
			set tOrefField.outlierselectivity=##class(%Library.Global).Quote(tOutlierSelectivity)
			set tOrefField.averagefieldsize=tAverageFieldSize
			set tOrefField.histogram=tHistogram
			do tOref.fields.Insert(tOrefField)
			set tOrefField=""
		}
		set tMap=""
		set tStorage=$o($$$SDEF($$$sWRK,tExtent,""))
		if tStorage'="" {
			for  {
				set tMap=$o($$$EXTSQLMAP($$$rEXT,tExtent,tMap)) quit:tMap=""
				set tBlockCount=$get($$$SDEFSQLMAPblockcount($$$sDEF,tExtent,tStorage,tMap))
				if tBlockCount="" {
					set tMapInfo=$$$EXTSQLMAPsqlinfo($$$rEXT,tExtent,tMap)
					set tBlockCount=$$$SQLLocMapBlockCount(tMapInfo)
.
				}
				continue:'tBlockCount
				set tOrefMap=##class(%SQL.Util.TuneTableStatsMaps).%New()
				set tOrefMap.name=tMap
				set tOrefMap.blockcount=tBlockCount
				do tOref.maps.Insert(tOrefMap)
				set tOrefMap=""
			}
		}
		set tSC=writer.Object(tOref)
	}
	catch(ex) {
		set tSC=ex.AsStatus()
		if pDisplay do DisplayError^%apiOBJ(tSC)
	}
	QUIT tSC
}
.
SetFixedStats(pCls,pID="",pDisplay=0) [] PUBLIC {
	set tSC=$$$OK
	try {
		RETURN:'$d(^rINDEXEXT("Stats",$$getShardLocalClassName^%SYS.SHARDSRV(pCls),"StatsInfo")) $$$ERROR($$$SQLError,-484,$$$FormatText($$$Text("%1 has no collected table statistics","%SQL.TuneTable"),pCls_".cls"))
		if pID="" {
			set tSC=##class(%ExtentMgr.TableStatsInfo).GetLatestCollectedStatsInfo(pCls,pDisplay,.tOref,.tID)
			RETURN:tOref="" $$$ERROR($$$SQLError,-484,$$$FormatText($$$Text("%1 has no collected table statistics","%SQL.TuneTable"),pCls_".cls"))
		} else {
			set tID=$$getShardLocalClassName^%SYS.SHARDSRV(pCls)_"||"_pID
			RETURN:'##class(%ExtentMgr.TableStatsInfo).%ExistsId(tID) $$$ERROR($$$SQLError,-484,$$$FormatText($$$Text("%1 has no collected table statistics with ID = %2","%SQL.TuneTable"),pCls_".cls",tID))
			set tOref=##class(%ExtentMgr.TableStatsInfo).%OpenId(tID)
		}
		write:pDisplay !,$$$FormatText($$$Text("Setting fixed table statistics for class %1 on %2 from table statistics information ID %3.","%SQL.TuneTable"),$zdt($h),pCls,tID)
		set tTime=$zh
		
		// check the existence of this table
		$$$comClassKeyGetLvar(table,pCls,$$$cCLASSsqltablename)
		$$$comClassKeyGetLvar(schema,pCls,$$$cCLASSsqlschemaname)
		if (table="")||(schema=""){
			write:pDisplay !,$$$FormatText($$$Text("   *skipped*, table does not exist for class %1","%SQL.TuneTable"),pCls)
			RETURN tSC
		}
		set tExtent=$$$GetExtentNameFromTableName(schema,table)
		RETURN:$$GlobalInReadOnlyDB("oddEXT",tExtent) $$$ERROR($$$SQLError,-485,$$$FormatText($$$Text("Cannot FIX STATISITCS on a read only table %1","%SQL.TuneTable"),$$$GetIQNFromTableName(schema,table)))
		if tExtent=""{
			write:pDisplay !,$$$FormatText($$$Text("   *skipped*, table does not exist for class %1","%SQL.TuneTable"),pCls)
			RETURN tSC
		}
		set tTabInfo=$$$EXTsqlinfo($$$rEXT,tExtent)
		if $Case($$$SQLLocTableChildTableType(tTabInfo),"A":1,"L":1,:0) {
			set tParentClass = $$$SQLLocTableParentExtent(tTabInfo)
			set tCollection = $ListGet($$$comClassArrayGet(tParentClass,$$$cCLASSextents,tExtent))	// tCollection is the name of the collection property
		} else { set tCollection = "", tParentClass = "" }
		// always use pKeepClassUpToDate=1
		set tSC=$$SetExtentSize(tExtent,tTabInfo,pCls,$$$SQLLocTableExtentSize(tTabInfo),tOref.ExtentSize,0,1,,,,1,tCollection,$g(tParentClass))
		quit:$$$ISERR(tSC)
			#; Do the field's selectivities
		set tKey=""
		for {
			set tOrefField=tOref.Fields.GetNext(.tKey)
			quit:tKey=""
			quit:tOrefField=""
			set tFldInfo=$g($$$EXTSQLCOLsqlinfo($$$rEXT,tExtent,tOrefField.Name))
			continue:tFldInfo=""	// no such field??
			if $Case($$$SQLLocTableChildTableType(tTabInfo),"A":1,"L":1,:0) {
				set tParentClass = $$$SQLLocTableParentExtent(tTabInfo)
				set tCollection = $ListGet($$$comClassArrayGet(tParentClass,$$$cCLASSextents,tExtent))	// tCollection is the name of the collection property
			}
			else { set tCollection = "" }
			if tOrefField.OutlierSelectivity'="" {
				set tOutlier=$lb(tOrefField.OutlierSelectivity,$$Unquote(tOrefField.OutlierValue))
			} else {
				set tOutlier=""
			}
			// always use pKeepClassUpToDate=1
			set tSC=$$SetSelectivity(tExtent,tOrefField.Name,tFldInfo,pCls,tOref.ExtentSize,tOrefField.Selectivity,$$ConvertSelectivity^%ocsExtent(tOrefField.Selectivity,tOref.ExtentSize),0,,,1,tCollection,$g(tParentClass),,tOutlier,tOrefField.AverageFieldSize,tOrefField.Histogram)
			quit:$$$ISERR(tSC)
		}
			#; Do the map's blockcount
		set tKey=""
		for {
			set tOrefMap=tOref.Maps.GetNext(.tKey)
			quit:tKey=""
			quit:tOrefMap=""
			set tMapInfo=$g($$$EXTSQLMAPsqlinfo($$$rEXT,tExtent,tOrefMap.Name))
			continue:tMapInfo=""	// no such map??
			if $Case($$$SQLLocTableChildTableType(tTabInfo),"A":1,"L":1,:0) {
				set tParentClass = $$$SQLLocTableParentExtent(tTabInfo)
				set tCollection = $ListGet($$$comClassArrayGet(tParentClass,$$$cCLASSextents,tExtent))	// tCollection is the name of the collection property
			} else { set tCollection = "", tParentClass="" }
			// always use pKeepClassUpToDate=1
			do SetBlockCount(tExtent,tOrefMap.Name,tOrefMap.BlockCount,.tSC,"",0,1,tCollection,0,0,tParentClass)
			quit:$$$ISERR(tSC)
		}
		do NumberOfTuples^%ocsSQLRTDict(tExtent)
		set sharded=$$$comSharded(tExtent) // JMM1160=
			#; If we just imported tune stats for a shard-master table, we will copy the tune stats from the shard-master class/table to the shard-local class table
		if sharded=1 {
			set shardLocalExtent=$$getShardLocalClassName^%SYS.SHARDSRV(tExtent)
			// always use pKeepClassUpToDate=1
			set tSC=$$CopyTuneStats(tExtent,shardLocalExtent,1,0,"")
			if $$$ISERR(tSC) { if pDisplay { do DisplayError^%apiOBJ(tSC) } quit }
			do NumberOfTuples^%ocsSQLRTDict(shardLocalExtent)
			write:pDisplay !,$$$FormatText($$$Text("Copied imported auto collected table stats from shard-master class %1 to shard-local class %2","%SQL.TuneTable"),tExtent,shardLocalExtent)
		}
		do PostTune^%qarTune(tExtent,schema,table,"",,pDisplay,)
		write:pDisplay !,$$$FormatText($$$Text("Setting fixed table statistic for class %1 completed in %2 seconds","%SQL.TuneTable"),pCls,$zh-tTime)
	}
	catch(ex) {
		set tSC=ex.AsStatus()
		if pDisplay do DisplayError^%apiOBJ(tSC)
	}
	RETURN tSC
}
.
/// Copy the latest table statistics from the extent metadata database into the class definition storage within a schema.
SetSchemaFixedStats(pSchema,pDisplay=0) [] PUBLIC {
	set sc=$$$OK
	set:pSchema="" pSchema=$$$DefaultSchemaQL
	set pSchema=$$$UPPER(pSchema)
	RETURN:'$d(^rINDEXSQL("rv",pSchema)) $$$ERROR($$$SQLError,-473,$$$FormatText($$$Text("No such schema '%1'","%SQL.TuneTable"),pSchema))
	set table=""
	for  {
		set table=$o(^rINDEXSQL("rv",pSchema,table),1,data) quit:table=""
		continue:$lg(data,3)'=1	// Not a table
		set iqn=$$$GetExactIntQualifiedName(pSchema,table)
		set classname=$$$GetClassNameFromIQN(iqn)
		if classname="" {
			set sc=$$$ADDSC(sc,$$$ERROR($$$SQLError,-30,$$$FormatText($$$Text("No such table '%1'","%SQL.TuneTable"),iqn)))
			continue
		}
		set sharded=$$$comSharded(classname) // JMM1160=
		continue:sharded=2  // shard-local tables will be tuned when shard-master tables are tuned
		// Federated tables aren't tuned, they inherit their stats from their source tables
		continue:$$$SSIsFederated(classname)
		set superclass=$g($$$EXTroot($$$pEXT,classname))
		if (superclass="")||($$$getClassType(superclass)'=$$$cCLASSCLASSTYPEPERSISTENT)||$$$comClassKeyGet(superclass,$$$cCLASSnoextent) {
			// first set the stats for the class without super class, since if cls A extends cls B, it'd better to set stats for cls B first
			// this step does not ensure B always before A, if user has a specific order, they can use SetTableFixedStats
			set classes(1,classname)=""	
		} else {
			set classes(2,classname)=""	
		}
	}
	RETURN:'$d(classes) sc
	set priority="",classname="" 
	for {
		set priority=$o(classes(priority)) quit:priority=""
		for {
			set classname=$o(classes(priority,classname)) quit:classname=""
			set sc=$$$ADDSC(sc,$$SetFixedStats(classname,"",pDisplay))
		}
	}
	RETURN sc			
}
.
/// Copy the latest (default) or given table statistics from the extent metadata database into the class definition storage
SetTableFixedStats(pTable,pID="",pDisplay=0) [] PUBLIC {
	set sc=$$$OK
	set classname=$$$GetClassNameFromIQN($$IntQualifiedName^%apiSQL(pTable))
	RETURN:classname="" $$$ERROR($$$SQLError,-30,$$$FormatText($$$Text("No such table '%1'","%SQL.TuneTable"),pTable))
	set sharded=$$$comSharded(classname) // JMM1160=
	// Federated tables aren't tuned, they inherit their stats from their source tables
	RETURN:$$$SSIsFederated(classname) sc
	RETURN:sharded=2 sc  // should set fixed stats for shard-master table instead of shard-local table
	set sc=$$SetFixedStats(classname,pID,pDisplay)
	RETURN sc			
}
.
/// Remove outdated collected statistics for a given schema pSchema, based on the specified expiration Days: pExpirationDays (default 30).
PurgeStaleStatsInfo(pSchema="*",pTable="*",pExpirationDays=30,pDisplay=0) [] PUBLIC {
	set sc=$$$OK
	if pSchema="*" { // for the entire extent
		set schema="&"
		for {
			set schema=$o(^rINDEXSQL("rv",schema)) quit:schema=""
			set table=""
			for  {
				set table=$o(^rINDEXSQL("rv",schema,table),1,data) quit:table=""
				continue:$lg(data,3)'=1	// Not a table
				set iqn=$$$GetExactIntQualifiedName(schema,table)
				set classname=$$$GetClassNameFromIQN(iqn)
				if classname="" {
					set sc=$$$ADDSC(sc,$$$ERROR($$$SQLError,-30,$$$FormatText($$$Text("No such table '%1'","%SQL.TuneTable"),iqn)))
					continue
				}
				set sharded=$$$comSharded(classname) // JMM1160=
				continue:sharded=2  // the collected table statistics of shard-local tables will be purged when the collected table statistics of shard-master tables are purged
				// Federated tables aren't tuned, they inherit their stats from their source tables
				continue:$$$SSIsFederated(classname)
				set sc=$$$ADDSC(sc,##class(%ExtentMgr.TableStatsInfo).PurgeStaleStatsInfo(classname,pExpirationDays,pDisplay))
			}
		}
		RETURN sc
	}
	set:pSchema="" pSchema=$$$DefaultSchemaQL
	set pSchema=$$$UPPER(pSchema)
	RETURN:'$d(^rINDEXSQL("rv",pSchema)) $$$ERROR($$$SQLError,-473,$$$FormatText($$$Text("No such schema '%1'","%SQL.TuneTable"),pSchema))
	if pTable'="*" { // for a specific table
		set iqn=$$$GetExactIntQualifiedName(pSchema,pTable)
		set classname=$$$GetClassNameFromIQN(iqn)
		RETURN:classname="" $$$ERROR($$$SQLError,-30,$$$FormatText($$$Text("No such table '%1'","%SQL.TuneTable"),pTable))
		set sharded=$$$comSharded(classname) // JMM1160=
		// Federated tables aren't tuned, they inherit their stats from their source tables
		RETURN:$$$SSIsFederated(classname) sc
		RETURN:sharded=2 sc  // the collected table statistics of shard-local tables will be purged when the collected table statistics of shard-master tables are purged
		RETURN ##class(%ExtentMgr.TableStatsInfo).PurgeStaleStatsInfo(classname,pExpirationDays,pDisplay)
	}
	// for a specfic schema
	set table=""
	for  {
		set table=$o(^rINDEXSQL("rv",pSchema,table),1,data) quit:table=""
		continue:$lg(data,3)'=1	// Not a table
		set iqn=$$$GetExactIntQualifiedName(pSchema,table)
		set classname=$$$GetClassNameFromIQN(iqn)
		if classname="" {
			set sc=$$$ADDSC(sc,$$$ERROR($$$SQLError,-30,$$$FormatText($$$Text("No such table '%1'","%SQL.TuneTable"),iqn)))
			continue
		}
		set sharded=$$$comSharded(classname) // JMM1160=
		continue:sharded=2  // the collected table statistics of shard-local tables will be purged when the collected table statistics of shard-master tables are purged
		// Federated tables aren't tuned, they inherit their stats from their source tables
		continue:$$$SSIsFederated(classname)
		set sc=$$$ADDSC(sc,##class(%ExtentMgr.TableStatsInfo).PurgeStaleStatsInfo(classname,pExpirationDays,pDisplay))
	}
	RETURN sc
}
.
/// Set a property of table statistics to a given value for a given table. 
/// This is a runtime setting that does not affect the class definition. 
SetTableRuntimeTableStatsProp(pTable,pProperty,pValue) [] PUBLIC {
	set sc=$$$OK,pProperty=$$$UPPER(pProperty)
	set iqn=$$IntQualifiedName^%apiSQL(pTable)
	set classname=$$$GetClassNameFromIQN(iqn)
	RETURN:classname="" $$$ERROR($$$SQLError,-30,$$$FormatText($$$Text("No such table '%1'","%SQL.TuneTable"),pTable))
	set sharded=$$$comSharded(classname) // JMM1160=
	// Federated tables aren't tuned, they inherit their stats from their source tables
	RETURN:$$$SSIsFederated(classname) sc
	RETURN:sharded=2 sc // the table stats property of shard-local tables will be set when the table stats property of shard-master tables are set
	if ##class(%ExtentMgr.TableStats).%ExistsId(classname){
		set obj=##class(%ExtentMgr.TableStats).%OpenId(classname,,.sc)
		set oldVal=$s(pProperty="IGNOREFIXEDSTATS":obj.IgnoreFixedStats,1:obj.SkipAutomaticStatsCollection)
		RETURN:$$$ISERR(sc) sc
	} else {
		set obj=##class(%ExtentMgr.TableStats).%New(classname)	
		set oldVal=0
	}
	if oldVal=pValue{
		set markCQStale=0
	} elseif pProperty="IGNOREFIXEDSTATS" {
		set obj.IgnoreFixedStats=pValue
		set markCQStale=1
	} else {
		set obj.SkipAutomaticStatsCollection=pValue
		set markCQStale=('pValue) // changing SkipAutomaticStatsCollection to 1 does not change plan
	}
	set sc=obj.%Save()
	RETURN:$$$ISERR(sc) sc
	
	set shardCls=$$getShardLocalClassName^%SYS.SHARDSRV(classname)
	if (shardCls'=classname)&&(pProperty="IGNOREFIXEDSTATS") {
		// copy IgnoreFixedStats to shard cls
		if ##class(%ExtentMgr.TableStats).%ExistsId(shardCls){
			set shardobj=##class(%ExtentMgr.TableStats).%OpenId(shardCls,,.sc)
			RETURN:$$$ISERR(sc) sc
		} else {
			set shardobj=##class(%ExtentMgr.TableStats).%New(shardCls)	
		}
		set shardobj.IgnoreFixedStats=pValue
		set sc=shardobj.%Save()
		RETURN:$$$ISERR(sc) sc
	}
	// mark CQ as stale
	do:markCQStale DeleteExtentCQ^%SYS.SQLSRV($$$GetExtentNameFromIQN(iqn),,1)	
	RETURN sc
}
.
/// Set a property of table statistics for each table within a given schema. 
/// This is a runtime setting that does not affect the class definition. 
SetSchemaRuntimeTableStatsProp(pSchema="",pProperty,pValue) [] PUBLIC {
	set sc=$$$OK
	set:pSchema="" pSchema=$$$DefaultSchemaQL
	set pSchema=$$$UPPER(pSchema)
	RETURN:'$d(^rINDEXSQL("rv",pSchema)) $$$ERROR($$$SQLError,-473,$$$FormatText($$$Text("No such schema '%1'","%SQL.TuneTable"),pSchema))
	// for a specfic schema
	set table=""
	for  {
		set table=$o(^rINDEXSQL("rv",pSchema,table),1,data) quit:table=""
		continue:$lg(data,3)'=1	// Not a table
		set iqn=$$$GetExactIntQualifiedName(pSchema,table)
		set classname=$$$GetClassNameFromIQN(iqn)
		if classname="" {
			set sc=$$$ADDSC(sc,$$$ERROR($$$SQLError,-30,$$$FormatText($$$Text("No such table '%1'","%SQL.TuneTable"),iqn)))
			continue
		}
		set sharded=$$$comSharded(classname) // JMM1160=
		continue:sharded=2  // the table stats property of shard-local tables will be set when the table stats property of shard-master tables are set
		// Federated tables aren't tuned, they inherit their stats from their source tables
		continue:$$$SSIsFederated(classname)
		set sc=$$$ADDSC(sc,$$SetTableRuntimeTableStatsProp^%qarTune(iqn,pProperty,pValue))
	}
	RETURN sc
}
	#; Import Tune Table stats from an XML file creted via ExportTuneStats
	#;  Returns %Status value
	// Called from:
	//   %SYSTEM.SQL.ImportTuneStats
ImportTuneStats(pFilename,pDisplay=1,pKeepClassUpToDate=0,pClearCurrentStats=0) [] PUBLIC {
.
	set tSC=$$$OK
	try {
		write:pDisplay !,$$$FormatText($$$Text("Importing SQL TuneTable statistics on %1 from file %2, KeepClassUpToDate = %3, ClearCurrentStats = %4","%SQL.TuneTable"),$zdt($h),pFilename,pKeepClassUpToDate,pClearCurrentStats)
		set tTime=$zh
		set tReader = ##class(%XML.Reader).%New()
			#; Prevent parsing of DTDs  Corrects DP-440866 - XXE Vulnerability importing XML files in System Management Portal
		set tReader.SAXFlags=$zboolean(tReader.SAXFlags,$$$SAXVALIDATIONPROHIBITDTDS,7)
		set tSC=tReader.OpenFile(pFilename)
		quit:$$$ISERR(tSC)
		do tReader.Correlate("TuneTableStats","%SQL.Util.TuneTableStats")
	
		while tReader.Next(.tOref,.tSC) {
			quit:$$$ISERR(tSC)
			set tExtent=$$$GetExtentNameFromTableName(tOref.schema,tOref.table)
			if tOref.type="Collected Table Statistics" {
				// this is table stats from extent metadata db
				set tClassname=$$getShardLocalClassName^%SYS.SHARDSRV(tOref.class)
				if ##class(%ExtentMgr.TableStats).%ExistsId(tClassname){
					set pOref=##class(%ExtentMgr.TableStats).%OpenId(tClassname)
				} else {
					set pOref=##class(%ExtentMgr.TableStats).%New(tClassname)
				}
				do Convert2TableStatsInfo(tOref,.pTableStatsInfo)
				do pOref.TableStatsInfo.Insert(pTableStatsInfo)	
				set tSC = pOref.%Save()
				continue:tExtent=""
				do DeleteExtentCQ^%SYS.SQLSRV(tExtent,,1)
				set sc=$$QueueSystem^%SYS.WorkQueueMgr(,"$$RegenerateStaleCQsSingleNS^%SYS.SQLSRV")
				continue
			}
			write:pDisplay !,$$$FormatText($$$Text("Importing tune table stats for table %1.%2","%SQL.TuneTable"),tOref.schema,tOref.table)
			if tExtent="" {
				write:pDisplay $$$Text("   *skipped*, table does not exist","%SQL.TuneTable")
				continue
			}
			if pClearCurrentStats {	// clear any existing fixed table statistics for this table if so requested
				write:pDisplay !,$$$FormatText($$$Text("Clearing exisiting tune table stats for %1.%2","%SQL.TuneTable"),tOref.schema,tOref.table)
				do tune(tOref.schema_"."_$tr(tOref.table,".",$c(2)),1,pDisplay,pKeepClassUpToDate,1)
			}
			set tTabInfo=$$$EXTsqlinfo($$$rEXT,tExtent)
	 		if $Case($$$SQLLocTableChildTableType(tTabInfo),"A":1,"L":1,:0) {
				set tParentClass = $$$SQLLocTableParentExtent(tTabInfo)
				set tCollection = $ListGet($$$comClassArrayGet(tParentClass,$$$cCLASSextents,tExtent))	// tCollection is the name of the collection property
			}
			else { set tCollection = "", tParentClass = "" }
			set tClassname=$$$SetSQLLocTableClassname(tTabInfo)
			set tSC=$$SetExtentSize(tExtent,tTabInfo,tClassname,$$$SQLLocTableExtentSize(tTabInfo),tOref.extentsize,0,1,,,,pKeepClassUpToDate,tCollection,$g(tParentClass))
			quit:$$$ISERR(tSC)
				#; Do the field's selectivities
			set tKey=""
			for {
				set tOrefField=tOref.fields.GetNext(.tKey)
				quit:tKey=""
				quit:tOrefField=""
				set tFldInfo=$g($$$EXTSQLCOLsqlinfo($$$rEXT,tExtent,tOrefField.name))
				continue:tFldInfo=""	// no such field??
				if $Case($$$SQLLocTableChildTableType(tTabInfo),"A":1,"L":1,:0) {
					set tParentClass = $$$SQLLocTableParentExtent(tTabInfo)
					set tCollection = $ListGet($$$comClassArrayGet(tParentClass,$$$cCLASSextents,tExtent))	// tCollection is the name of the collection property
				}
				else { set tCollection = "" }
				if tOrefField.outlierselectivity'="" {
					set tOrefField.outlierselectivity=$$Unquote(tOrefField.outlierselectivity)
				}
				set tSC=$$SetSelectivity(tExtent,tOrefField.name,tFldInfo,tClassname,tOref.extentsize,tOrefField.selectivity,$$ConvertSelectivity^%ocsExtent(tOrefField.selectivity,tOref.extentsize),0,,,pKeepClassUpToDate,tCollection,$g(tParentClass),,tOrefField.outlierselectivity,tOrefField.averagefieldsize,tOrefField.histogram)
				quit:$$$ISERR(tSC)
			}
				#; Do the map's blockcount
			set tKey=""
			for {
				set tOrefMap=tOref.maps.GetNext(.tKey)
				quit:tKey=""
				quit:tOrefMap=""
				set tMapInfo=$g($$$EXTSQLMAPsqlinfo($$$rEXT,tExtent,tOrefMap.name))
				continue:tMapInfo=""	// no such map??
				if $Case($$$SQLLocTableChildTableType(tTabInfo),"A":1,"L":1,:0) {
					set tParentClass = $$$SQLLocTableParentExtent(tTabInfo)
					set tCollection = $ListGet($$$comClassArrayGet(tParentClass,$$$cCLASSextents,tExtent))	// tCollection is the name of the collection property
				}
				else { set tCollection = "", tParentClass="" }
				do SetBlockCount(tExtent,tOrefMap.name,tOrefMap.blockcount,.tSC,"",0,pKeepClassUpToDate,tCollection,1,0,tParentClass)
				quit:$$$ISERR(tSC)
			}
			do NumberOfTuples^%ocsSQLRTDict(tExtent)
			set sharded=$$$comSharded(tExtent) // JMM1160=
				#; If we just imported tune stats for a shard-master table, we will copy the tune stats from the shard-master class/table to the shard-local class table
			if sharded=1 {
				set shardLocalExtent=$$getShardLocalClassName^%SYS.SHARDSRV(tExtent)
				set tSC=$$CopyTuneStats(tExtent,shardLocalExtent,pKeepClassUpToDate,0,"")
				if $$$ISERR(tSC) { if pDisplay { do DisplayError^%apiOBJ(tSC) } quit }
				do NumberOfTuples^%ocsSQLRTDict(shardLocalExtent)
				write:pDisplay !,$$$FormatText($$$Text("Copied imported tune stats from shard-master class %1 to shard-local class %2","%SQL.TuneTable"),tExtent,shardLocalExtent)
			}
			do PostTune^%qarTune(tExtent,$$$SQLLocTableSchema(tTabInfo),$$$SQLLocTableName(tTabInfo),"",,pDisplay,)
		}
		write:pDisplay !!,$$$FormatText($$$Text("Import completed in %1 seconds","%SQL.TuneTable"),$zh-tTime)
	}
	catch(ex) {
		set tSC=ex.AsStatus()
		if pDisplay do DisplayError^%apiOBJ(tSC)
	}
	QUIT tSC
}
.
	// Called from:  tune^%qarTune, %CSP.UI.Portal.SQL.TuneTable.SetSelValues()
	#; Given an extent compute Map Block Counts for each map.  Returns a %Status value
ComputeMapBlocks(pExtent,pKeepClassUpToDate=0,pUpdate,pDisplay=0,&classid,pLeaveOpen,pLogFile="",pClearValues=0,&updated,numMasterBlocks,sampleType=2,&statsOref="") [] PUBLIC {
	$$$DebugTrace("ComputeMapBlock^%qarTune: pExtent="_$g(pExtent)_", pKeepCLassUpToDate="_pKeepClassUpToDate_", pUpdate="_$g(pUpdate)_", pDisplay="_pDisplay_", classid="_$g(classid)_", pLeaveOpen="_$g(pLeveOpen)_", pLogFile="_pLogFile_", pClearValues="_pClearValues_", updated="_$g(updated))
	set tSC=$$$OK
	set tExtInfo=$g($$$EXTsqlinfo($$$rEXT,pExtent))
	if tExtInfo="" { set tSC=$$$ERROR($$$SQLError,-30,$$$FormatText($$$Text("No such table defined for extent '%1'","%SQL.TuneTable"),pExtent)) goto exit }
		#; Any list/array collection child table does no need to be measuered.  This is a hierarchical map global structure and we will use the same BlockCount in the parents and Children.
		#; This is already handled in %ocsSQLRTDict
	//if $Case($$$SQLLocTableChildTableType(tExtInfo),"A":1,"L":1,:0) QUIT tSC
	try {
		set tMap="" 
		for i=1:1 {
			set tMap=$o($$$EXTSQLMAP($$$rEXT,pExtent,tMap)) quit:tMap=""
			set tCurrentBlockCount="",tParentClass="",tCollection=""
			set tMapInfo=$$$EXTSQLMAPsqlinfo($$$rEXT,pExtent,tMap)
			If ($e($$$SQLLocMapIndexType(tMapInfo),1,2)="FI") {
				Set FIclass = $p($p($$$SQLLocMapIndexType(tMapInfo),"(",2),")",1)
				Continue:(FIclass="")||('$$$comMemberKeyGet(FIclass,$$$cCLASSparameter,"ProjectMap",$$$cPARAMdefault))	// Don't compute Map Blocks for Functional Indices that have parameter ProjectMap set to 0
			}
	 		if $Case($$$SQLLocTableChildTableType(tExtInfo),"A":1,"L":1,:0) {
		 		if $$$SQLLocMapMaster(tMapInfo)="Y" { continue }
				set tParentClass = $$$SQLLocTableParentExtent(tExtInfo)
				set tCollection = $ListGet($$$comClassArrayGet(tParentClass,$$$cCLASSextents,pExtent))	// tCollection is the name of the collection property
			}
			  #; check whether or not this table is block sampled. If yes, we have already computed the master map block count
			if (sampleType=2){
			  	  #; if this is the master map, we have already computed the block count
				if $$$SQLLocMapMaster(tMapInfo)="Y" {
					set tReference=$$DetermineGlobalReference($p($$$SQLLocMapCompiledTopLevelPieces(tMapInfo),$c(1),1))
					set tBlocks=$normalize(numMasterBlocks*($$BufferBlockSize(tReference)\$$$DBBlockSize),0)
			  	  #; otherwise, compute the block count	
				} else {
					set tBlocks=$$ComputeBlocks(pExtent,tMap,.tCurrentBlockCount,.tSC,0,tCollection,tParentClass,pClearValues,sampleType)
				}
			} else {
				  #; use old ComputeBlocks
				set tBlocks=$$ComputeBlocks(pExtent,tMap,.tCurrentBlockCount,.tSC,0,tCollection,tParentClass,pClearValues,sampleType)
			}
			
			goto:$$$ISERR(tSC) exit
			if pClearValues {
				do log(pDisplay,pLogFile,$$$FormatText($$$Text("BLOCKCOUNT of MAP %1","%SQL.TuneTable"),tMap),5)
				do log(pDisplay,pLogFile,$$$Text("CURRENT = ","%SQL.TuneTable"),8),log(pDisplay,pLogFile,$j($fn($zabs(tCurrentBlockCount),","),27),22,0)
				do log(pDisplay,pLogFile,$$$Text("MEASURED = ","%SQL.TuneTable"),8),log(pDisplay,pLogFile,$j("<Cleared>",27),22,0)
				if $isObject(statsOref) {
					set tOrefMap=##class(%ExtentMgr.MapStatsInfo).%New()
					set tOrefMap.Name=tMap
					set tOrefMap.BlockCount="clear"
					do statsOref.Maps.Insert(tOrefMap)
				} elseif pUpdate {
					do SetBlockCount(pExtent,tMap,"clear",.tSC,.classid,pLeaveOpen,pKeepClassUpToDate,tCollection,0,0,tParentClass)
					goto:$$$ISERR(tSC) exit
					do log(pDisplay,pLogFile,$$$Text("Updated","%SQL.TuneTable"),60,0)
				}
				continue
			}
			if tBlocks=0 {
				do log(pDisplay,pLogFile,$$$FormatText($$$Text("BLOCKCOUNT of MAP %1 cannot be determined because the map is empty (no data)","%SQL.TuneTable"),tMap),5)
				continue
			}
			if tCurrentBlockCount'="",tCurrentBlockCount>-1 {
				if tCurrentBlockCount="NULL" {
					do log(pDisplay,pLogFile,$$$FormatText($$$Text("BLOCKCOUNT of MAP %1 is defined as NULL, estimated block count of the global structure will be used","%SQL.TuneTable"),tMap,tCurrentBlockCount),5)
				}
				else {
					do log(pDisplay,pLogFile,$$$FormatText($$$Text("BLOCKCOUNT of MAP %1 already defined as %2, will not be measured","%SQL.TuneTable"),tMap,tCurrentBlockCount),5)
				}
				continue
			}
			if tBlocks="super" {
				do log(pDisplay,pLogFile,$$$FormatText($$$Text("BLOCKCOUNT of MAP %1 will not be measured because it is inherited from a super class","%SQL.TuneTable"),tMap),5)
				continue
			}
			if tBlocks=""||(tBlocks=-1) {
				do log(pDisplay,pLogFile,$$$FormatText($$$Text("BLOCKCOUNT of MAP %1 cannot be determined","%SQL.TuneTable"),tMap),5)
				continue
			}
			if tCurrentBlockCount="" {
				set:tMapInfo'="" tCurrentBlockCount=$$$SQLLocMapNumberOfBlocks(tMapInfo)
			}
			do log(pDisplay,pLogFile,$$$FormatText($$$Text("BLOCKCOUNT of MAP %1","%SQL.TuneTable"),tMap),5)
			do log(pDisplay,pLogFile,$$$Text("CURRENT = ","%SQL.TuneTable"),8),log(pDisplay,pLogFile,$j($fn($zabs(tCurrentBlockCount),","),27),22,0)
			do log(pDisplay,pLogFile,$$$Text("MEASURED = ","%SQL.TuneTable"),8),log(pDisplay,pLogFile,$j($fn(tBlocks,","),27),22,0)
			if $isObject(statsOref) {
				set tOrefMap=##class(%ExtentMgr.MapStatsInfo).%New()
				set tOrefMap.Name=tMap
				set tOrefMap.BlockCount=tBlocks
				do statsOref.Maps.Insert(tOrefMap)
			} elseif pUpdate,(tBlocks'=$zabs(tCurrentBlockCount)) {
				do SetBlockCount(pExtent,tMap,tBlocks,.tSC,.classid,pLeaveOpen,pKeepClassUpToDate,tCollection,0,0,tParentClass)
				goto:$$$ISERR(tSC) exit
				set updated=1
				do log(pDisplay,pLogFile,$$$Text("Updated","%SQL.TuneTable"),60,0)
			}
		}
	}
	catch(ex) {
		$$$DebugTrace("ComputeMapBlock^%qarTune(ERROR): $ze="_$ze_", tSC="_tSC)
		set tSC=ex.AsStatus()
	}
exit	$$$DebugTrace("ComputeMapBlock^%qarTune(EXIT): tSC="_tSC)
	QUIT tSC
}
.
	// Called from ComputeMapBlocks^%qarTune
	// Given an extent and a mapname, return the actual number of blocks used by the map
	//#;   pCollection=CollectionPropertyName if this is an index map for a collection child table
ComputeBlocks(pExtent,pMapName,&pCurrentBlockCount,&pSC,pOverride=0,pCollection=0,pCollectionExtent,pClearValues=0,sampleType=2) [] PUBLIC {
	set pSC=$$$OK
	set tReturn=""
	kill blockArray
	try {
		$$$DebugTrace("ComputeBlocks^%qarTune: pExtent="_pExtent_", pMapName="_pMapName_", pCurrentBlockCount="_pCurrentBlockCount_", pSC="_pSC_", pOverride="_pOverride_", pCollection="_pCollection_", pCollectionExtent="_pCollectionExtent_", pClearValues="_pClearValues)
		set tMapInfo=$$$EXTSQLMAPsqlinfo($$$rEXT,pExtent,pMapName)
		if tMapInfo="" { $$$DebugTrace("ComputeBlocks^%qarTune:(GOTO EXIT) mapinfo empty") goto exit }	// No such map???
		if '$$$SQLLocMapFromThisTable(tMapInfo) { set tReturn="super" $$$DebugTrace("ComputeBlocks^%qarTune:(GOTO EXIT) map not from this table") goto exit }
		if pCollection="" {
			set tStorage=$o($$$SDEF($$$sDEF,pExtent,""))
			set pCurrentBlockCount=$get($$$SDEFSQLMAPblockcount($$$sDEF,pExtent,tStorage,pMapName))
		}
		else {
			  	#; this is a collection child table.  Don't get the BlockCount for the map from the child table, 
			  	#; but from the ChildBlockCount setting for the collection property
			set tStorage=$o($$$SDEF($$$sDEF,pCollectionExtent,""))
			set pCurrentBlockCount=$$$defStorageSubMemberKeyGet(pCollectionExtent,$$$cCLASSstorage,tStorage,$$$cSDEFproperty,pCollection,$$$cSTORAGEPROPERTYchildblockcount)
			set pCurrentBlockCount=$p($p($p(pCurrentBlockCount,pMapName,2),":",2),",",1)
		}
		if pClearValues { set tReturn="" $$$DebugTrace("ComputeBlocks^%qarTune:(GOTO EXIT) pClearValues is TRUE") goto exit }
		if pOverride {
			if pCurrentBlockCount'=""&&(pCurrentBlockCount>-1) { $$$DebugTrace("ComputeBlocks^%qarTune:(GOTO EXIT) explicit BlockCount already defined by user") goto exit } // BlockCount already defined by the user (positive value or 0 - 0 means used computed estimate from NumberOfTuples)
		}
		set tReference=$$DetermineGlobalReference($p($$$SQLLocMapCompiledTopLevelPieces(tMapInfo),$c(1),1))
		if tReference="" { $$$DebugTrace("ComputeBlocks^%qarTune:(GOTO EXIT) map global reference is empty") goto exit }
		// AllocatedSize does not work if tReference contains a namespace reference (^["NS"]glo or ^|"NS"|glo), it will simply return 0.
		// if AllocatedSize gets an error, say you try ^[NS]glo and NS is not defined), it will crash.  
		// Protect for this by using try/catch
		  #; if table is EBM/block sampled, use new method for getting blocks
		if (sampleType>1) {
			try {
			 	  #; get the blocks for this map
				do GetDataBlocks(tReference,,.blockArray,.DIR,.IG,.IGL,.dataBlocksPercent)
			  	  #; set the sample rate
				set numBlocks = blockArray
				if numBlocks < 100 { set blockSamplePerc = 1 } 
				else { set blockSamplePerc = $s((100/numBlocks)<$zsqr(3/numBlocks):$zsqr(3/numBlocks),1:(100/numBlocks)) }
			  	  #; sample data blocks to figure out how many big string blocks there are on average per data block.
				set tReturnBlocks = $$SampleBlocks(IG,IGL,DIR,.blockArray,blockSamplePerc)
				  #; adjust the block size based on the assumption SQL Optimizer makes on the block size
				  #; $$$DBBlockSize refers to how big the optimizer thinks the global buffer block size is
				set tReturn=$normalize(tReturnBlocks*($$BufferBlockSize(tReference)\$$$DBBlockSize)\dataBlocksPercent,0)
			} catch {
				set tReturn=0
			}
		} else {
			  #; use old version
			try { set tSize=$$AllocatedSize^%GSIZE(tReference) } catch { set tSize=0 }
			if tSize>0 { set tReturn=tSize\$$$DBBlockSize }	// AllocatedSize returns bytes. Return number of blocks based on the assumption SQL Optimizer makes on the block size
			elseif tSize=0 { set tReturn=0 }
		}		
	}
	catch(ex) {
		$$$DebugTrace("ComputeBlocks^%qarTune:(ERROR) $ze="_$ze_", ex="_ex)
		set pSC=ex.AsStatus()
	}
exit	$$$DebugTrace("ComputeBlocks^%qarTune:(END) tReturn="_tReturn_", pSC="_pSC)
	QUIT tReturn
}
.
	// Called from:
	//	%SQL.Manager.Catalog.SetMapBlockCount()
	//	ImportTuneStats
	// 	ComputeMapBlocks
SetBlockCount(pClassname,pMapname,pBlockCount,&pSC,&classid=0,pLeaveOpen=0,pKeepClassUpToDate=0,pCollection="",pFromImport=0,pCalledFromSMP=0,pParentClass="") [] PUBLIC {
	    #;  Given a class, mapname, and a value, set the map's BlockCount to the value
	    #;  Ignoring errors for now ***
	    #;      1  pClassname
	    #;      2  pMapName
	    #;      3  pBlockCount     New block count of "clear" to go back to estimated count
	    #;      4  pSC	       PBR
	    #;      5  classid:        PBR, the oref of the class definition
	    #;      6  pLeaveOpen:     1/0 flag to signal not to close the class definition object
	    #;      7  KeepClassUpToDate:  1/0 flag to signal whether to keep the class up-to-date or not.  If TRUE, we edit the
	    #;                      class definition global directly.  The default is 0, don't keep it up-to-date.
	    #;      8  pCollection:    If this is a child table projected by a collection, pCollection is the name of the property that projected the table.
	    #;	    9  pFromImport:    1 if this is from ImportTuneStats.  For this case we do not need to take make the BlockCount negative, just use the positive or negative value we imported
	    #;	    10 pCalledFromSMP: 1 if this is called from the SMP.  For this case we need to compute the BlockCount if the given BlockCount is "" or 0
	    #;      11 pParentClass:   If this is a child table projected by a collection, name of the class that contains the collection property
	
	$$$DebugTrace("SetBlockCount^%qarTune: pClassname="_(pClassname)_", pMapname="_$g(pMapname)_", pBlockCount="_$g(pBlockCount)_", pSC="_$g(pSC)_", &classid="_classid_", pLeaveOpen="_pLeaveOpen_", pKeepClassUpToDate="_pKeepClassUpToDate_", pCollection="_pCollection_", pFromImport="_pFromImport_", pCalledFromSMP="_pCalledFromSMP_", pParentClass="_pParentClass)
	set pSC=$$$OK
	if $g(pClassname)="" { $$$DebugTrace("SetBlockCount^%qarTune(GOTO END): because pClassname=""""") goto end }
	if 'pBlockCount,pBlockCount'="clear" {		// if called from SMP with a BlockCount of "" or 0, user is requesting reset to actual BlockCount
		if 'pCalledFromSMP { $$$DebugTrace("SetBlockCount^%qarTune(GOTO END): because pCalledFromSMP="_pCalledFromSMP) goto end }
		set pBlockCount=$$ComputeBlocks(pClassname,pMapname,"",.pSC,0,pCollection,pParentClass)
		if $case(pBlockCount,-1:1,"":1,"super":1,:0) { $$$DebugTrace("SetBlockCount^%qarTune(GOTO END): end because pBlockCount="_pBlockCount) goto end }  // Map could be mapped over ECP or could be from a super class
	}		// Nothing to update
.
	try {
		set mapinfo=$$$EXTSQLMAPsqlinfo($$$rEXT,pClassname,pMapname)
		
			#; Store the value in the table/map metadata
		do StoreTableBlockCount(mapinfo,pClassname,pMapname,pBlockCount,pCalledFromSMP)
.
			#; now store the values in the class metadata
		do StoreClassBlockCount(mapinfo,pClassname,pMapname,pBlockCount,pKeepClassUpToDate,pCollection,pParentClass,pCalledFromSMP,pFromImport,pLeaveOpen,.classid,.pSC)
	}
	catch(ex) {
		$$$DebugTrace("SetBlockCount^%qarTune(ERROR): $ze="_$ze_",ex="_ex)
		set pSC=ex.AsStatus()
	}
end	$$$DebugTrace("SetBlockCount^%qarTune(END): pSC="_pSC)
	RETURN    
}
.
StoreTableBlockCount(mapinfo,classname,mapname,blockcount,calledfromSMP=0) [] PRIVATE {
	$$$DebugTrace("StoreTableBlockCount^%qarTune: mapinfo=$lb::"_$g(mapinfo)_", classname="_$g(classname)_", mapname="_$g(mapname)_", blockcount="_(blockcount)_", calledfromSMP="_calledfromSMP)
	if blockcount="clear" {
		set $$$SetSQLLocMapBlockCount(mapinfo)=""
		set $$$SetSQLLocMapBlockCountType(mapinfo)=""
	}
	else {
		set $$$SetSQLLocMapBlockCount(mapinfo)=$zabs(blockcount)
		if 'calledfromSMP { set $$$SetSQLLocMapBlockCountType(mapinfo)="M" } else { set $$$SetSQLLocMapBlockCountType(mapinfo)="D" }
	}
	set $$$EXTSQLMAPsqlinfo($$$rEXT,classname,mapname)=mapinfo
	$$$DebugTrace("StoreTableBlockCount^%qarTune(END): classname="_classname_", mapname="_mapname_", blockcount="_blockcount)
	RETURN
}
.
StoreClassBlockCount(mapinfo,classname,mapname,blockcount,pKeepClassUpToDate,pCollection="",pParentClass,calledfromSMP=0,pFromImport="",pLeaveOpen,&classid=0,&pSC) [] PRIVATE {
		#; if this map is inherited, we can't define the storage map in the class to have these blockcounts.
		#; They can only be stored in the class the map originated in
	$$$DebugTrace("StoreClassBlockCount^%qarTune: classname="_(classname)_", mapname="_(mapname)_", blockcount="_(blockcount)_", pKeepClassUpToDate="_$g(pKeepClassUpToDate)_", PCollection="_pCollection_", pParentClass="_$g(pParentClass)_", calledfromSMP="_calledfromSMP_", pFromImport="_pFromImport_", pLeaveOpen="_$g(pLeaveOpen)_", classid="_classid_", pSC="_pSC)
	
	if '$$$SQLLocMapFromThisTable(mapinfo) { goto end }
.
	if 'pKeepClassUpToDate {
		set tStorage=$o($$$SDEF($$$sWRK,classname,""))
		if pCollection'="" {
				#; Any list/array collection child table does no need to be measuered.  This is a hierarchical map global structure and we will use the same BlockCount in the parents and Children.
				#; This is already handled in %ocsSQLRTDict
				#; Index maps in collection child tables do get stored in the parent's storage propoert node ChildBlockCount
				#; ChildBlockCount has the form:  MapName:BlockCount { , MapName:BlockCout ... }
				#;---
				#; Sharded tables cannot have collection child classes, so we don't need to worry about storing this in the shard-master class [for now]
			If $$$SQLLocMapMaster(mapinfo)="N" {
				set tStorage=$o($$$SDEF($$$sWRK,pParentClass,""))
				set tClass=$$Open^%apiCDL(pParentClass,,5) if $$$ISERR(tClass) { set pSC=tClass goto end }
					#; Use -blockcount for the block count.  -value means the BlockCount was set by TuneTable, +value means user defined the BlockCount
				set tBC=$$$editStorageSubMemberKeyGet(tClass,$$$cCLASSstorage,tStorage,$$$cSDEFproperty,pCollection,$$$cSTORAGEPROPERTYchildblockcount)
				do String2Array(.tBC)
				set tBC(mapname)=$s(blockcount="clear":"",pFromImport:blockcount||calledfromSMP,1:-blockcount)
				do Array2String(.tBC)
				$$$editStorageSubMemberKeySet(tClass,$$$cCLASSstorage,tStorage,$$$cSDEFproperty,pCollection,$$$cSTORAGEPROPERTYchildblockcount,tBC)
				set pCS=$$Save^%apiDDL(tClass) if $$$ISERR(pSC) { do Close^%apiCDL(tClass) goto end }
				set pSC=$$Close^%apiCDL(tClass)
			}
		}
		else {
			if 'classid {
				set classid=$$Open^%apiCDL(classname,,5) 
				if $$$ISERR(classid) { set pSC=classid goto end }
			}
				#; Use -blockcount for the block count.  -value means the BlockCount was set by TuneTable, +value means user defined the BlockCount
			if blockcount="clear" {
				$$$editStorageSubMemberKeyKill(classid,$$$cCLASSstorage,tStorage,$$$cSDEFsqlmap,mapname,$$$cSDEFSQLMAPblockcount)
			}
			else {
				$$$editStorageSubMemberKeySet(classid,$$$cCLASSstorage,tStorage,$$$cSDEFsqlmap,mapname,$$$cSDEFSQLMAPblockcount,$s(pFromImport||calledfromSMP:blockcount,1:-blockcount))
			}
			if 'pLeaveOpen {
				set pCS=$$Save^%apiDDL(classid)
				if $$$ISERR(pSC) { do Close^%apiCDL(classid) set classid=0 goto end }
				set pSC=$$Close^%apiCDL(classid)
				set classid=0
			}
	  	}
	}
	else {  // KeepClassUpToDate=1
		set tStorage=$o($$$SDEF($$$sWRK,classname,""))
		if pCollection'="" {
				#; Any list/array collection child table does no need to be measuered.  This is a hierarchical map global structure and we will use the same BlockCount in the parents and Children.
				#; This is already handled in %ocsSQLRTDict
				#; Index maps in collection child tables do get stored in the parent's storage propoert node ChildBlockCount
				#; ChildBlockCount has the form:  MapName:BlockCount { , MapName:BlockCout ... }
				#;---
				#; Sharded tables cannot have collection child classes, so we don't need to worry about storing this in the shard-master class [for now]
			If $$$SQLLocMapMaster(mapinfo)="N" {
				set tStorage=$o($$$SDEF($$$sWRK,pParentClass,""))
					#; Use -blockcount for the block count.  -value means the BlockCount was set by TuneTable, +value means user defined the BlockCount
				set tBC=$$$defStorageSubMemberKeyGet(pParentClass,$$$cCLASSstorage,tStorage,$$$cSDEFproperty,pCollection,$$$cSTORAGEPROPERTYchildblockcount)
				do String2Array(.tBC)
				set tBC(mapname)=$s(blockcount="clear":"",pFromImport||calledfromSMP:blockcount,1:-blockcount)
				do Array2String(.tBC)
				$$$defStorageSubMemberKeySet(pParentClass,$$$cCLASSstorage,tStorage,$$$cSDEFproperty,pCollection,$$$cSTORAGEPROPERTYchildblockcount,tBC)
			}
			if 'pLeaveOpen {
				set tTS=$zu(188)
				$$$defClassKeySet(pParentClass,$$$cCLASStimechanged,tTS)
				do RebuildItemIndex^%R(pParentClass,"CLS",,1)
				set pSC=$$KeepClassUpToDate^%occDepend(pParentClass)
			}
		}
		else {  // Not a collection child class
				#; Use -blockcount for the block count.  -value means the BlockCount was set by TuneTable, +value means user defined the BlockCount
			if blockcount="clear" {
				$$$defStorageSubMemberKeyKill(classname,$$$cCLASSstorage,tStorage,$$$cSDEFsqlmap,mapname,$$$cSDEFSQLMAPblockcount)
			}
			else {
				$$$defStorageSubMemberKeySet(classname,$$$cCLASSstorage,tStorage,$$$cSDEFsqlmap,mapname,$$$cSDEFSQLMAPblockcount,$s(pFromImport||calledfromSMP:blockcount,1:-blockcount))
			}
		}
			#; if we are done with the class here, update the DEF/COM timestamps
		if 'pLeaveOpen {
			set tTS=$zu(188)
			$$$defClassKeySet(classname,$$$cCLASStimechanged,tTS)
			do RebuildItemIndex^%R(classname,"CLS",,1)
			set pSC=$$KeepClassUpToDate^%occDepend(classname)
		}
	}
end	$$$DebugTrace("StoreClassBlockCount^%qarTune(END): pSC="_pSC)
	RETURN
}
.
	// Sample blocks from blockArray
	// percentage of blocks sampled = blockSamplePerc
SampleBlocks(IG,IGL,DIR,&blockArray,blockSamplePerc) [] PUBLIC {
	set numBlocks = blockArray
	set blockSampleSize = $normalize(blockSamplePerc * numBlocks,0)	
	set blockSampleCount = 0
	set bigBlockCounter = 0
	set i = 0
	kill sampled
	
	  #; loop over the blocks and get a sample
	try{
		open 63:"^^"_DIR
		for {
			set sampleThisBlock = 0
			quit:blockSampleCount=blockSampleSize
			if blockSamplePerc = 1 {
				set i = i + 1, sampleThisBlock = 1
			}
		  	  #; if block sampling percentage is high, then use sampling method
		  	  #; that avoids selecting duplicate blocks
			elseif blockSamplePerc > .3{
				set i = i + 1
				if $random(numBlocks - i + 1)<(blockSampleSize - blockSampleCount){
					set sampleThisBlock = 1
				}
			}
		  	  #; otherwise, just choose random blocks and try again
		  	  #; in case you select a duplicate
			else{
				set i=1+$random(numBlocks)
				if '$data(sampled(i)){
					set sampled(i)=1
					set sampleThisBlock = 1
				}
			}
			if sampleThisBlock {
			  	  #; load current block into view buffer
				set curBlock = blockArray(i)
				set sampleBlocks($increment(blockSampleCount)) = curBlock
				set found = 0
				VIEW curBlock
			  	  #; loop over all of the nodes and get the global references
				for j = 1:1{
					try {
						//set printableRef = $view(2*j-1,-5)
						set internalRef = $view(2*j-1,-6)
					  	  #; make sure this node corresponds to the right map
						set prevFound = found
						set found = ($extract(internalRef_$c(0),1,IGL)=IG)
						quit:prevFound&&('found)
					} catch {
						quit
					}		
				  	  #; check if this is a big string reference
					if found {
						set bigCheckRef = $view(2*j,-6)
						if $$$gdviewisbigstr($A(bigCheckRef)) {
							Set bigBlockCounter=bigBlockCounter+$piece(bigCheckRef,",",2)
						}
					}
					quit:(internalRef = "")
				}
			}
		}
	}
	catch exception{
		set %msg=$$$FormatText($$$Text("Encountered a problem sampling blocks to compute map size.","%SQL.TuneTable"),$$$SQLLocTableSchema(tabinfo)_"."_$$$SQLLocTableName(tabinfo))
		do log(display,pLogFile,%msg)
	} 	  
	close 63
	  #; estimate number of blocks in the map, including big string blocks
	set numMapBlocks = (bigBlockCounter/blockSampleSize)*numBlocks+numBlocks
	return numMapBlocks
}
.
BufferBlockSize(glb) PUBLIC {
	set databasedir = $p($$GetGlobalSourceDatabase^%SYS.SECURITY($Name(@glb)),"^",3)
	Return $p($zu(49,databasedir),",",2)
}
.
	// Compute the selctivity, outliers, and average field size from the SMP for a shard-local table
	// This will be called from the shard manager, it will compute and store new selectivity* values for the shard-local table
	// No logging needed
SMPSelectivitySharded(extentname,extentsize,KeepClassUpToDate) [%mmmsqlTTavg] PUBLIC {
	$$$DebugTrace("SMPSelectivitySharded^%qarTune: extentname="_$g(extentname)_", extentsize="_$g(extentsize)_", KeepClassUpToDate="_$g(KeepClassUpToDate))
	new %mmmsqlTTavg
	Set batch=$zu(68,25,1)
	set sc=$$$OK
	set tabinfo=$g($$$EXTsqlinfo($$$rEXT,extentname))
	if extentsize < 1000	{ set samplesize=extentsize } 
	else 			{ set samplesize = $s($normalize(3*$zsqr(extentsize),0)<1000:1000,1:$normalize(3*$zsqr(extentsize),0)) }
	set iqn=$$$BuildIQN($$$SQLLocTableSchema(tabinfo),$$$SQLLocTableName(tabinfo))
	set mrirn = $$$smdLoadGetIrn(iqn)
	set sampleType = 2, CT = ""
	if ('$$$SQLLocTableSupportsBlockSampling(tabinfo)){
		set sampleType = 1
	} else {
		do GetGlobalInfo(iqn, mrirn, .imp, .gName, .DIR, .ns, .DB, .DBS, .CT)
		if $listget(DBS,1)=0 {; if there is any err when getting global, use old row based sampling
			set sampleType = 1
		} else {
			for i = 2:1:$listlength($get(DBS)){
				if $piece($listget($listget(DBS,i)),"^")'=""{
					set sampleType = 1 quit
				}
			}
		}
	}
	; for pure columnar table, we can sample ebm instead of block sampling of master map
	; since there is nothing in the master map
	if (sampleType=2){
		set ttype=$$$GetTableTypeFromIQN(iqn)
		; for pure columnar table, we can sample bitmap extent index instead of block sampling of master map
		; since there is nothing in the master map
		if $$HasCDMs(extentname)&&('$$HasMasterMapDataFields(extentname,$$$SQLLocTableMasterMap(tabinfo))) {
			; if ebm is selectable, we can use sampleType=3 ebm sampling, else, use sampleType=1 row-based sampling
			set sampleType=$case($SYSTEM.SQL.Util.GetMapSelectability(iqn,$$$smdMapName($$$smdBitmapExtentMap(ttype,mrirn))),0:1,:3)
		} elseif ($$$smdBitmapExtentMap(ttype,mrirn)'="") {
			; for non-columnar table, if ebm is selectable, we can use sampleType=3 ebm sampling,  
			; else, still use sampleType=2 block sampling
			set sampleType=$case($SYSTEM.SQL.Util.GetMapSelectability(iqn,$$$smdMapName($$$smdBitmapExtentMap(ttype,mrirn))),0:2,:3)
		}
	}
	do CalculateSelectivity(extentname,tabinfo,.extentsize,.cselectivity,.coutliers,.selectivity,.outliers,.cavg,.%mmmsqlTTavg,.sc,0,0,"",.samplesize,0,.pSamplePerc,.classid,.secondSelectivity,.reducedSecondSelectivity,.gamma,.numMasterBlocks,.chist,.hist,sampleType,CT)
	goto:$$$ISERR(sc) end
	set classname=$$$SQLLocTableClassname(tabinfo)
	set field="" 
	for  {
		set field=$o($$$EXTSQLCOL($$$rEXT,extentname,field)) quit:field=""	// For each field in the extent...
		set fldinfo=$$$EXTSQLCOLsqlinfo($$$rEXT,extentname,field)
		set icol=$$$SQLLocColNumber(fldinfo)
		if $d(selectivity(icol))||$d(outliers(icol))||$d(%mmmsqlTTavg(icol)) {
			kill tOutlierChanged,tAverageChanged
			set currentSelectivity=$s(cselectivity(icol)="NUMROWS":1,'cselectivity(icol):"<Not Specified>",1:$j((100/cselectivity(icol)),0,4)_"%")
			set newSelectivity=$s(selectivity(icol)="NUMROWS":1,selectivity(icol)="":"<Not Specified>",'selectivity(icol):0,1:$j((100/selectivity(icol)),0,4)_"%")
 			if $d(coutleirs(icol))||$d(outliers(icol)) {
				if ($j(($lg($g(coutliers(icol)))*100),0,4)_"%")'=$lg($g(outliers(icol))) || ($lg($g(coutliers(icol)),2)'=$lg($g(outliers(icol)),2)) { set tOutlierChanged=1 }
			}
			if $$$SQLLocColStream(fldinfo)'=1 && ($d(cavg(icol))||$d(%mmmsqlTTavg(icol))) {
				if $g(cavg(icol))'=$g(%mmmsqlTTavg(icol)) { set tAverageChanged=1 }
			}
			if (((currentSelectivity'=newSelectivity) || $d(tOutlierChanged)) || $d(tAverageChanged)) {
				set objselectivity(icol)=$$SelectivityToObjectSelectivity(selectivity(icol))
				set sc=$$SetSelectivity(extentname,field,fldinfo,classname,extentsize,objselectivity(icol),selectivity(icol),0,,0,KeepClassUpToDate,"","","",$g(outliers(icol)),$g(%mmmsqlTTavg(icol)))
				goto:$$$ISERR(sc) end
			}
		}
	}
end	Do $zu(68,25,batch)
	$$$DebugTrace("SMPSelectivitySharded^%qarTune(END): sc="_sc)
	RETURN sc	
}
.
	// Copy the tune stats from one class / table to another
	// This is used for sharded tables, which to not support collection child tables [yet]
	// If we support collection child tables in sharded tables, this code wi;; need to be updated
CopyTuneStats(fromExtent,toExtent,KeepClassUpToDate,display,pLogFile) [] PUBLIC {
	$$$DebugTrace("CopyTuneStats^%qarTune: fromExtent="_$g(fromExtent)_", toExtent="_$g(toExtent)_", KeepClassUpToDate="_$g(KeepClassUpToDate)_", display="_$g(display)_", pLogFile="_$g(pLogFile))
	set sc=$$$OK
	try {
			#; Setup
		set fromTabInfo=$g($$$EXTsqlinfo($$$rEXT,fromExtent))
		if fromTabInfo="" {
			set %msg=$$$FormatText($$$Text("No such extent '%1'","%SQL.TuneTable"),fromExtent)
			do log(display,pLogFile,%msg)
			set sc=$$$ERROR($$$SQLError,-30,%msg)
			goto end
		}
		set toTabInfo=$g($$$EXTsqlinfo($$$rEXT,toExtent))
		if toTabInfo="" {
			set %msg=$$$FormatText($$$Text("No such extent '%1'","%SQL.TuneTable"),toExtent)
			do log(display,pLogFile,%msg)
			set sc=$$$ERROR($$$SQLError,-30,%msg)
			goto end
		}
			#; Copy extentsize
		set extentsize=$$$SQLLocTableExtentSize(fromTabInfo)
		set sc=$$SetExtentSize(toExtent,toTabInfo,$$$SQLLocTableClassname(toTabInfo),$$$SQLLocTableExtentSize(toTabInfo),extentsize,0,1,,.classid,1,KeepClassUpToDate,,,"",)
		goto:$$$ISERR(sc) end
.
			#; Copy block counts
		set sc=$$CopyBlockCounts(fromExtent,toExtent,KeepClassUpToDate,0,"",.classid,1)
		goto:$$$ISERR(sc) end
.
			#; Copy selectivity values for all fields
		set sc=$$CopySelectivity(fromExtent,toExtent,KeepClassUpToDate,0,"",.classid,1)
		goto:$$$ISERR(sc) end
.
		if 'KeepClassUpToDate {
			set sc=$$Save^%apiDDL(classid)
			if $$$ISERR(sc) { do Close^%apiCDL(classid) goto end }
			set sc=$$Close^%apiCDL(classid)
			if $$$ISERR(sc) { goto end }
		}
		do log(display,pLogFile,$$$FormatText($$$Text("Tune stats copied from class %1 to class %2","%SQL.TuneTable"),fromExtent,toExtent),3,1)	
	} catch(ex) {
		$$$DebugTrace("CopyTuneStats^%qarTune(ERROR): $ze="_$ze_", ex="_ex)
		set pSC=ex.AsStatus()
	}
end	$$$DebugTrace("CopyTuneStats^%qarTune(END): sc="_sc)
	RETURN sc
}
.
CopyBlockCounts(fromExtent,toExtent,KeepClassUpToDate,display,pLogFile,&classid,&leaveopen=1) [] PUBLIC {
	$$$DebugTrace("CopyBlockCounts^%qarTune: fromExtent="_$g(fromExtent)_", toExtent="_$g(toExtent)_", KeepClassUpToDate="_$g(KeepClassUpToDate)_", display="_$g(display)_", pLogFile="_$g(pLogFile)_", classid="_$g(classid)_", leaveopen="_leaveopen)
	set sc=$$$OK
	try {
			#; Setup
		set toTabInfo=$g($$$EXTsqlinfo($$$rEXT,toExtent))
		if toTabInfo="" {
			set %msg=$$$FormatText($$$Text("No such extent '%1'","%SQL.TuneTable"),toExtent)
			do log(display,pLogFile,%msg)
			set sc=$$$ERROR($$$SQLError,-30,%msg)
			goto end
		}
		if ('classid)&&('KeepClassUpToDate) {
			set classid=$$Open^%apiCDL($$$SQLLocTableClassname(toTabInfo),,5)
			if $$$ISERR(classid) { set sc=classid goto end }
		}
.
			#; Copy block counts
		set map="" 
		for i=1:1 {
			set map=$o($$$EXTSQLMAP($$$rEXT,fromExtent,map)) quit:map=""
			set mapinfo=$$$EXTSQLMAPsqlinfo($$$rEXT,fromExtent,map)
			continue:'$d($$$EXTSQLMAPsqlinfo($$$rEXT,toExtent,map),toMapInfo) 
			do StoreTableBlockCount(toMapInfo,$$$SQLLocTableClassname(toTabInfo),map,$$$SQLLocMapBlockCount(mapinfo),0)
			do StoreClassBlockCount(toMapInfo,$$$SQLLocTableClassname(toTabInfo),map,$$$SQLLocMapBlockCount(mapinfo),KeepClassUpToDate,"","",0,0,1,.classid,.sc)
			goto:$$$ISERR(sc) end
		}
.
		if ('leaveopen)&&('KeepClassUpToDate) {
			set sc=$$Save^%apiDDL(classid)
			if $$$ISERR(sc) { goto end }
			set sc=$$Close^%apiCDL(classid)
			if $$$ISERR(sc) { goto end }
		}
		
	} catch(ex) {
		$$$DebugTrace("CopyBlockCounts^%qarTune(ERROR): $ze="_$ze_", ex="_ex)
		set pSC=ex.AsStatus()
	}
end	$$$DebugTrace("CopyBlockCounts^%qarTune:(END) sc="_sc)
	RETURN sc
}
.
CopySelectivity(fromExtent,toExtent,KeepClassUpToDate,display,pLogFile,&classid=0,&leaveopen=1) [] PUBLIC {
	$$$DebugTrace("CopySelectivity^%qarTune: fromExtent="_$g(fromExtent)_", toExtent="_$g(toExtent)_", KeepClassUpToDate="_$g(KeepClassUpToDate)_", display="_$g(display)_", pLogFile="_$g(pLogFile)_", classid="_$g(classid)_", leaveopen="_leaveopen)
	set sc=$$$OK
	try {
			#; Setup
		set fromTabInfo=$g($$$EXTsqlinfo($$$rEXT,fromExtent))
		if fromTabInfo="" {
			set %msg=$$$FormatText($$$Text("No such extent '%1'","%SQL.TuneTable"),fromExtent)
			do log(display,pLogFile,%msg)
			set sc=$$$ERROR($$$SQLError,-30,%msg)
			goto end
		}
		set toTabInfo=$g($$$EXTsqlinfo($$$rEXT,toExtent))
		if toTabInfo="" {
			set %msg=$$$FormatText($$$Text("No such extent '%1'","%SQL.TuneTable"),toExtent)
			do log(display,pLogFile,%msg)
			set sc=$$$ERROR($$$SQLError,-30,%msg)
			goto end
		}
		if ('classid)&&('KeepClassUpToDate) { 
			set classid=$$Open^%apiCDL($$$SQLLocTableClassname(toTabInfo),,5)
			if $$$ISERR(classid) { set sc=classid goto end }
		}
		set extentsize=$$$SQLLocTableExtentSize(fromTabInfo)
.
			#; Copy field selectivity and related metadata
		set field="" 
		for  {
			set field=$o($$$EXTSQLCOL($$$rEXT,fromExtent,field)) quit:field=""	// For each field in the extent...
			continue:'$d($$$EXTSQLCOL($$$rEXT,toExtent,field))                      // Make sure field exists in target extent, ShardKeyHash field is an example of a field that only exists in the shard-local table
			set fldinfo=$$$EXTSQLCOLsqlinfo($$$rEXT,fromExtent,field)
			set icol=$$$SQLLocColNumber(fldinfo)
			set selectivity=$$$SQLLocColSelectivity(fldinfo)
			set objselectivity=$$SelectivityToObjectSelectivity(selectivity)
			set sc=$$SetSelectivity(toExtent,field,fldinfo,$$$SQLLocTableClassname(toTabInfo),extentsize,objselectivity,selectivity,display,.classid,1,KeepClassUpToDate,"","",pLogFile,$$$SQLLocColOutlierSelectivity(fldinfo),$$$SQLLocColAverageFieldSize(fldinfo),$$$SQLLocColHistogram(fldinfo))
			if $$$ISERR(sc) { goto end }
		}
		if ('leaveopen)&&('KeepClassUpToDate) {
			set sc=$$Save^%apiDDL(classid)
			if $$$ISERR(sc) { do Close^%apiCDL(classid) goto end }
			set sc=$$Close^%apiCDL(classid)
			if $$$ISERR(sc) { goto end }
		}
		
	} catch(ex) {
		$$$DebugTrace("CopySelectivity^%qarTune(ERROR): $ze="_$ze_", ex="_ex)
		set sc=ex.AsStatus()
	}
end	$$$DebugTrace("CopySelectivity^%qarTune:(END) sc="_sc)
	RETURN sc
}
.
DetermineGlobalReference(pRef) PUBLIC {
		#;  $$:  global reference for locking the whole table
		#;        (but no variable subscripts, please!)
	QUIT:$$refok(pRef) pRef  ;  fixed global - just use it
	set xx=0,x=0,dirref=""
	if pRef["^["     { for  { set x=xx,xx=$$find^%qarmac(pRef,"]",xx,$$$MaxStringLength) quit:'xx  } set dirref=$e(pRef,1,x-1),pRef="^"_$e(pRef,x,*) }	// ^[...]global(...)
	elseif pRef["^|" { for  { set x=xx,xx=$$find^%qarmac(pRef,"|",xx,$$$MaxStringLength) quit:'xx  } set dirref=$e(pRef,1,x-1),pRef="^"_$e(pRef,x,*) }	// ^|...|global(...)
	set good=$f(pRef,"(",1)  ;  start with just the global name
	QUIT:'$$refok($e(pRef,1,good-2)) ""
		#;  add subscripts, but stop before the first non-literal
	for  set jj=$f(pRef,",",good) quit:'jj  quit:'$$refok($e(pRef,1,jj-2)_")")  set good=jj
	set pRef=$e(pRef,1,good-2)_$e(")",$e(pRef,good-1)=",")
	set:dirref'="" pRef=dirref_$e(pRef,2,*)
	QUIT pRef
refok(pRef)
		#;  uqly but no choice
	set $zt="refbad" QUIT:$qs(pRef,0)||1 1
refbad	;  Be careful here - $ze may flag an error in the server
	set $ze="" QUIT 0
}
.
	#; Get global info: given the table name, get:
	#;
	#; irn
	#; imp for master map or EBM
	#; global name
	#; global namespace
	#; global directory
#define endrange $char(255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255)
	
GetGlobalInfo(iqn, irn, &imp, &gName, &DIR, &ns, &DB, &DBS, &columnarTable, ebm=0) Public {
	set ttype=$$$GetTableTypeFromIQN(iqn)
	set imp=$$GetImp(ttype,irn,ebm)
	set gName = $$DetermineGlobalReference($p($$$smdMapCompiledTopLevelPieces(imp),$c(1),1))
	  #; check if this is a columnar table
	  #; if it is, use master map global containing only row ID's
	if ($$$smdMapGlobal(imp) = "")&&($$$smdHasColumnarMaps(ttype,irn)) {
		set columnarTable = 1
		#; maybe use $$$smdMapGlobal(imp) in the future, right now $$$smdMapGlobal(imp) can be ""
		set gName = $piece($$$smdMapCompiledTopLevelPieces(imp),"(",1)
	}
	set gName = $Name(@gName) ; YCL225
	set ns=$qs(gName,-1)
	if ns="" Set ns=$namespace
	set IGStart=$$GetGloInt^%SYS.DATABASE()
	set IG=IGStart
	set IGEnd=IG_$$$endrange_$c(0)
	set glo=$qs(gName,0)
	  #; get all databases for this global
	  #; this will let us check whether or not it is (at least partially) remote
	set DBS=$$getalldest^%SYS.GXLINF1(ns,glo,$P(IGStart,$c(0),2,*),$P(IGEnd,$c(0),2,*),.gcol)
	if $e(ns)'="^" {
		set DB=$listget($listget(DBS,2))
		if DB="" quit $LB(0,"Could not find the database location of the starting global node")
	} else {
		set DB=$p(ns,"^",2,*)
	}
	set DIR=$p(DB,"^",2)
}
GetImp(ttype,irn,ebm=0) Public {
	RETURN $s(ebm:$$$smdBitmapExtentMap(ttype,irn),1:$$$smdMasterMap(ttype,irn))
}
	#; Get a list of the data blocks in a given table/map. Sets:
	#; 
	#; blockArray = array of blocks for the global
	#; DIR        = directory of global
	#; IG         = internal globlal reference (useful for index maps)
GetDataBlocks(gName,pSamplePerc="",&blockArray,&DIR,&IG,&IGL,&dataBlocksPercent=1) Public {
	 kill blockArray, IG
	 try{
		Set db=$$GetGlobalSourceDatabase^%SYS.SECURITY(gName)
    	set DIR=$piece(db,"^",3)
	 	set rc=$$GetBPntForTuneTable^%GSIZE("",gName,.pointerBlock,.db,.idx,.data,.IG,.err)
	 	set dataBlocksPercent = 1
.
	 	Open 63:"^^"_DIR
	 	set IGL=$L(IG)
	   	  #; if global is empty then quit
	 	if idx = -1 {set blockArray = 0 quit}
	 	if idx = 0 {set blockArray = -1 quit}
	 	set maxLev = $o(pointerBlock(""),-1)
	 	set advancedSample = (maxLev>=3)
.
		if advancedSample {
		 	set BPntIdx = idx
		 	set:$e(gName)="^" $e(gName)=""
			set:$qs("^"_gName,-1)'="" gName=$s($e(gName)="|":$p(gName,"|",3,*),1:$s($e(gName)="[":$p(gName,"]",2,*),1:gName))
			s sc=$$ViewBlockFromTop^%GSIZE(maxLev-1,DIR,gName)
			For idx=1:1 {
	        	Set x=$v(idx*2-1,-6)
				Quit:x=""
				Set x=x_$c(0)
				If IG=x {
		   			Set db=$V(idx*2,-5)
		    		Set found=1
		    		Quit
				}
				If x]IG {
		    		#;SML1810 ; shoudl not happened, but need to avoid $V(0,-5) got called.
		   			Set:idx>1 idx=idx-1 Set db=$V(idx*2,-5)
		    		Set found=1
		    		Quit
				}
			}
			If 'found {
				#;SML1810+ ; Don't need to look for right link because we already
				#; traversed from top down, the first key of right link is already
				#; 'followed' the fidning key. Just use the last entry.
				Set idx=idx-1
				#;SML1810-
	    	}
		}else {
			view pointerBlock
		}
	 	for j=1:1{
			 #; start at the first node referring to the map of interest
		 	for i=idx:1{
				set ref = $view(2*i-1,-6) 
			 	quit:ref=""
			   	  #; make sure that we are looking at the right map
			  	  #; in case block contains multiple maps
			 	If ((j'=1)||(i'=idx))&&($e(ref_$c(0),1,IGL)'=IG) {
			 		Quit
	    	 	}
	    	   	  #; read in the node and increment the array of data blocks
			 	set blockArray($increment(blockArray)) = $view(2*i,-5)
	  	 	}
	  	 	try{
		  		do ViewRightLink^%GSIZE()
		 	} catch err{}
		 	quit:$data(err)
		   	  #; after the first block, set idx = 1 in order to 
		   	  #; start at the first node of subsequent blocks
		 	set idx = 1
		   	  #; if block end with a reference to a different map, then we have
		   	  #; found all of the references to the map of interest; therefore quit.
		 	Quit:ref'=""
	 	}
	 
		 if advancedSample{
			set blockSampleCount = 0,i = 0
			if pSamplePerc'="" {
				set dataBlocksPercent = $zsqr(pSamplePerc)
				set blockSampleSize = $normalize(dataBlocksPercent*blockArray,0)
			} else {
				set blockSampleSize = $s(blockArray>100:$normalize(10*$zsqr(blockArray),0),1:blockArray)
				set dataBlocksPercent = blockSampleSize/blockArray
			}
			for {
				set sampleThisBlock = 0
				quit:blockSampleCount=blockSampleSize
				if dataBlocksPercent = 1 {
					set i = i + 1, sampleThisBlock = 1
				}
			  	  #; if block sampling percentage is high, then use sampling method
			  	  #; that avoids selecting duplicate blocks
				elseif dataBlocksPercent > .3{
					set i = i + 1
					if $random(blockArray - i + 1)<(blockSampleSize - blockSampleCount){
						set sampleThisBlock = 1
					}
				}
			  	  #; otherwise, just choose random blocks and try again
			  	  #; in case you select a duplicate
				else{
					set i=1+$random(blockArray)
					if '$data(sampled(i)){
						set sampled(i)=1
						set sampleThisBlock = 1
					}
				}
				if sampleThisBlock {
					set sampleBlocks($increment(blockSampleCount)) = blockArray(i)	
				}
			}
			k blockArray
			
			// go to next level and keep track of data blocks
			for j = 1:1:blockSampleCount {
				set idx=$s(sampleBlocks(j)=pointerBlock:BPntIdx,1:1)
				view sampleBlocks(j)
				
				 #; start at the first node referring to the map of interest
			 	for i=idx:1{
					set ref = $view(2*i-1,-6) 
				 	quit:ref=""
				   	  #; make sure that we are looking at the right map
				  	  #; in case block contains multiple maps
				 	If ((sampleBlocks(j)'=pointerBlock)||(i'=idx))&&($e(ref_$c(0),1,IGL)'=IG) {
				 		Quit
		    	 	}
		    	   	  #; read in the node and increment the array of data blocks
				 	set blockArray($increment(blockArray)) = $view(2*i,-5)
		  	 	}
			}
		}
	}
	catch ex {
		$$$DebugTrace("GetDataBlocks^%qarTune(ERROR), ex="_ex.DisplayString())
		set blockArray=-1
	} 
	Close 63
	RETURN
}
.
	#; Given an extent and a mapname, Display the Block Counts for this table
DumpBlocks(pExtent,pSC) [] PUBLIC {
	
	set pSC=$$$OK
	set tReturn=""
	w !,"Current block computation (estimate computed in class compiler)"
	w !,"Extent name",?30,"Map name",?60,"Blocks"
	try {
		set tMap="" 
		for  {
			set tMap=$o($$$EXTSQLMAP($$$rEXT,pExtent,tMap)) quit:tMap=""
			set tMapInfo=$$$EXTSQLMAPsqlinfo($$$rEXT,pExtent,tMap)
			w !,pExtent,?30,tMap,?60,$$$SQLLocMapNumberOfBlocks(tMapInfo)
		}
	}
	catch(ex) {
		set pSC=ex.AsStatus()
	}
	QUIT tReturn
}
.
Unquote(str,gvn=0)
	try {
		If 'gvn RETURN $$Eval(str)
		If str]"" RETURN $name(@str)
		RETURN str
	}
	catch {
	}
	QUIT ""
	
	// Turn string in the form "Name:Value,Name2:Value,...,NameN:Value" into an array of the form pVal(Name)=Value
	// pVal is passed by reference
String2Array(pVal) [] PUBLIC {
	if pVal="" { kill pVal QUIT }
	for i=1:1:$l(pVal,",") {
		set tPiece=$p(pVal,",",i)
		continue:$p(tPiece,":",1)=""
		set pVal($p(tPiece,":",1))=$p(tPiece,":",2)
	}
	zkill pVal
	QUIT
}
.
	// Turn an array of the form pVal(Name)=Value into a string in the form "Name:Value,Name2:Value,...,NameN:Value"
	// pVal is passed by reference
Array2String(pVal) [] PUBLIC {
	if '$d(pVal) { set pVal="" QUIT }
	set i="",pVal=""
	for  {
		set i=$o(pVal(i),1,tData) quit:i=""
		set pVal=pVal_","_i_":"_tData
		kill pVal(i)
	}
	set pVal=$e(pVal,2,*)	// Strip leading comma
	QUIT
}
.
GetIdsFromBlock(&curBlock, isNumericId=0, IGL="", IG="", &bigBlockCounter=0,isCompoundId, sLev, lLev, idSubLev=1, idSkipLev=0, &%mmmsqlTTallRowsArray, &rowCounter, &numTotalRows,&totalIdFieldSize=0,&boundaryIds="") [] PUBLIC {
	set rowCounter = 0
	set lastId = ""
	set firstId = ""
	VIEW curBlock
	#; loop over all of the nodes and get the global references
	for j = 1:1{
		set printableRef = $view(2*j-1,-5)
		quit:(printableRef = "")
		set internalRef = $view(2*j-1,-6)			
		 #; make sure this node corresponds to the right map
		set prevFound = $g(found,0)
		set found = ($extract(internalRef_$c(0),1,IGL)=IG)
		quit:prevFound&&('found)
		continue:('found)
		 #; check if this is a big string reference
		if (bigBlockCounter'=-1){
			set bigCheckRef = $view(2*j,-6)	
			if $$$gdviewisbigstr($A(bigCheckRef)) {
				Set bigBlockCounter=bigBlockCounter+$p(bigCheckRef,",",2)
			}
		}
		 #; count and collect ID
		if 'isCompoundId{
			set id=$QS(printableRef,idSubLev)
			continue:id=""
		} else {
			set id = ""
			for lev=sLev:1:lLev {
				set curLevId=$QS(printableRef,lev)
				continue:lev=idSkipLev
				quit:curLevId=""
				set id=id_curLevId_"||"
			}
			continue:curLevId=""
			set id = $e(id,1,*-2)
		}
		continue:id=lastId
		set lastId=id
		set id = $s(isNumericId:+id,1:id)
		if firstId="" {
			set firstId=id
			if $d(boundaryIds(id)) {
				d $I(rowCounter)
				continue
			}
			set boundaryIds(id)=""
		}
		set %mmmsqlTTallRowsArray($increment(numTotalRows))=id
		set totalIdFieldSize = totalIdFieldSize+$length($lb(id))
		d $I(rowCounter)
	}
	
	RETURN:$g(id)=""
	
	if $d(boundaryIds(id))&&(id'=firstId) {
		kill %mmmsqlTTallRowsArray(numTotalRows)
		; rowCounter don't need to be updated since this row is indeed exist in this block, 
		; but we should not increase numTotalRows
		set numTotalRows=numTotalRows-1 
		set totalIdFieldSize = totalIdFieldSize-$length($lb(id))
			
	} else {
		set boundaryIds(id)=""
	}
	
	RETURN
}
	// Given a extentname and a map name, return 1 if there are map data fields for this map, otherwise return 0
HasMasterMapDataFields(extentname,mapname) [] PUBLIC {
	set cnt=0,ilev=""
	for  {
		set ilev=$o($$$EXTSQLMAPDATA($$$rEXT,extentname,mapname,ilev)) quit:'ilev
		set cnt=1
		quit
	}
	RETURN cnt
}
.
	// Given an extentname, return 1 if there are any CDMs for this table, othewise return 0
HasCDMs(extentname) [] PUBLIC {
	set cnt=0,map=""
	for  {
		set map=$o($$$EXTSQLMAP($$$rEXT,extentname,map)) quit:map=""
		set mapinfo=$g($$$EXTSQLMAPsqlinfo($$$rEXT,extentname,map))
		if $$$SQLLocMapIndexType(mapinfo)="CD" { set cnt=1 quit }
	}
	RETURN cnt
}
SampleEBM(gName,extentSize,sampleSize,partitioned,partitionKeys="",&%mmmsqlTTrowList,&totalIdFieldSize=0,&reSample,&sampledIds="") PUBLIC {
	set pos=0,sampleCnt=0,%mmmsqlTTrowList=1,%mmmsqlTTrowList(1)="",n="",i=0
	if partitioned { // for partitioned table
		// if this is a default partitioned table (only have PARTITION, instead of PARTITON BY xxx), partitionKeys=""
		set subs=$ll(partitionKeys)+2 // (number of partition keys) + bucket id + chunk id
		set node=gName
		for {
			set node=$query(@node,1,bits)
			quit:node=""
			continue:$qlength(node)'=subs
			set partition=""
			for sub=1:1:(subs-2) { // collect all the partition id "partition_id_1 || partition_id_2 ||"
				set partition=partition_$qsubscript(node,sub)_"||"
			}
			set chunk=$qsubscript(node,subs)
			for { 
				set pos=$BITFIND(bits,1,pos+1) 
			  	quit:('pos)||(sampleCnt=sampleSize)
			  	continue:reSample&&($bit(sampledIds($s(partition="":"Null",1:partition),chunk),pos))
			  	set i=i+1
			  	if $random(extentSize - i + 1)<(sampleSize - sampleCnt){
				  	set:'reSample $bit(sampledIds($s(partition="":"Null",1:partition),chunk),pos)=1
				  	// id looks like "partition_id_1 || partition_id_2 || id" for partitioned table
					set idList = $lb(partition_(64000*(chunk-1)-1+pos))
					d $I(totalIdFieldSize,$length(idList))
					if $length(%mmmsqlTTrowList(%mmmsqlTTrowList))+$length(idList)<32000 {
						set %mmmsqlTTrowList(%mmmsqlTTrowList) = %mmmsqlTTrowList(%mmmsqlTTrowList)_idList
					} else{
						set %mmmsqlTTrowList($I(%mmmsqlTTrowList)) = idList
					}
					set sampleCnt=sampleCnt+1
				}
			}
		}
		return
	}
	for {
		set n=$order(@gName@(n),1,bits)
		quit:n=""
		for { 
		  	set pos=$BITFIND(bits,1,pos+1) 
		  	quit:('pos)||(sampleCnt=sampleSize) 
		  	continue:reSample&&($bit(sampledIds(n),pos))
		  	set i=i+1
		  	if $random(extentSize - i + 1)<(sampleSize - sampleCnt){
			  	set:'reSample $bit(sampledIds(n),pos)=1
				set idList = $lb(64000*(n-1)-1+pos)
				d $I(totalIdFieldSize,$length(idList))
				if $length(%mmmsqlTTrowList(%mmmsqlTTrowList))+$length(idList)<32000 {
					set %mmmsqlTTrowList(%mmmsqlTTrowList) = %mmmsqlTTrowList(%mmmsqlTTrowList)_idList
				} else{
					set %mmmsqlTTrowList($I(%mmmsqlTTrowList)) = idList
				}
				set sampleCnt=sampleCnt+1
			}
		}
	}	
	return	
}
/// Return 1 if CALCSELECTIVITY field parameter for this field (or any super field) is 0 - YCL332
checkCALCSELECTIVITY(fldinfo,tabinfo,extentname) PUBLIC {
	If $$$SQLLocColContainerField(fldinfo)="" {
		RETURN:$$$comMemberArrayGet($$$SQLLocTableClassname(tabinfo),$$$cCLASSproperty,$$$SQLLocColPropertyName(fldinfo),$$$cPROPparameter,"CALCSELECTIVITY")=0 1
	}
	Else {
		while $$$SQLLocColContainerField(fldinfo)'=""{
			RETURN:$$$comMemberArrayGet($$$SQLLocColDatatype($$$EXTSQLCOLsqlinfo($$$rEXT,extentname,$$$SQLLocColContainerField(fldinfo))),$$$cCLASSproperty,$$$SQLLocColPropertyName(fldinfo),$$$cPROPparameter,"CALCSELECTIVITY")=0 1
			set fldinfo=$$$EXTSQLCOLsqlinfo($$$rEXT,extentname,$$$SQLLocColContainerField(fldinfo))
		}
		RETURN:$$$comMemberArrayGet($$$SQLLocTableClassname(tabinfo),$$$cCLASSproperty,$$$SQLLocColPropertyName(fldinfo),$$$cPROPparameter,"CALCSELECTIVITY")=0 1
	}
	RETURN 0
}
#; onTask internal function for system task: %SYS.Task.AutoStatsCollection
#; This should only run for a period of time (maxDuration), but at least collect stats for one table (if exists)
#; If namespaces has descendants (s namespaces("NS1")="",namespaces("NS2")=""), we only loop through the ns (NS1 and NS2) specified in namespaces arg
autoStatsCollection(maxDuration=-1,&namespaces="") PUBLIC {
	new $NAMESPACE
	set sc=$$sortTablesAllNS(.ord,.namespaces)
	RETURN:$$$ISERR(sc)||('$d(ord)) sc
	Set stop=$s(maxDuration=-1:0,1:$zh+maxDuration)
	set resultid = ##class(%SQL.Diag.Result).addSystemTaskDiagResult("Automatic Table Statistic Collection")
	set cNS=$NAMESPACE
	// ord(rank1,rank2,idx)=$lb(ns,tablename)
	set rank1=""
	for {
		set rank1=$O(ord(rank1)) q:rank1=""
		set rank2=""
		for {
			set rank2=$o(ord(rank1,rank2))	q:rank2=""
			set idx=""
			for {
				set idx=$o(ord(rank1,rank2,idx),1,info)	q:idx=""
				set $lb(ns,tbl,lastNumRowsChanged)=info
				set $NAMESPACE=ns
				do ^%qarTune(tbl,1,1,,,,,,,,,,resultid,cNS,lastNumRowsChanged)
				goto:(stop)&&($zh>stop) end
			}
		}
	}
end set $NAMESPACE=cNS
	do ##class(%SQL.Diag.Result).updateStatus(resultid,"Complete")
	RETURN sc	
}
#; Loop through all the namespaces and sort tables
#; If namespaces has descendants (s namespaces("NS1")="",namespaces("NS2")=""), we only loop through the ns (NS1 and NS2) specified in namespaces arg 
sortTablesAllNS(&ord,&namespaces="") PUBLIC {
	new $NAMESPACE
	set sc=$$$OK
	kill ord
	try {
		do List^%SYS.NAMESPACE(.nslist,5,1,1,0)
		set namespace=""
		set ttFixedStats=$$$AutoStatsForFixedStatsTable
		set ttRemote=$$$AutoStatsForRemoteGlobalTable
		set ttEfficientSamplingOnly=$$$AutoStatsForEfficientSamplingTableOnly
		for { 
			set namespace=$order(nslist(namespace),1,nsdata) quit:namespace=""
			#; only loop through the namespace in the namespaces arg
			continue:($d(namespaces)>=10)&&('$d(namespaces(namespace)))
			#; If namespace not enabled skip
			continue:$listget(nsdata,1)=0 
			continue:'$$CheckNamespaceSystemAccess^%SYS.NAMESPACE(namespace)
			continue:$d(skip(namespace))
			set $NAMESPACE=namespace  // Change to namespace
			if $d($$$SSGlobal($$$SSShardsSubscript),shards){ // sharding environment
				set instanceAddress=$lb($piece($system,":",1),$g(^%SYS("SSPort")))
				set hasQS=($data($$$SSGlobal($$$SSShardsSubscript,$$$SSAppServersSubscript))'=0) // has query shard
				#; skip rest of data&query shard / master namespaces in this sharding namespaces within this instance
				for shard=-1,1:1:shards {
					continue:'$d($$$SSGlobal($$$SSShardsSubscript,shard),tAddress)
					if ($$hostsEqual^%SYS.SHARDSRV($lg(instanceAddress,1),$lg(tAddress,1)))&&($lg(instanceAddress,2)=$lg(tAddress,2)) {
						set skip($lg(tAddress,3))=""	
					}
					continue:'hasQS
					set queryshard=""
					for {
						set queryshard=$order($$$SSGlobal($$$SSShardsSubscript,$$$SSAppServersSubscript,shard,queryshard),1,tAddress) quit:queryshard=""
						if ($$hostsEqual^%SYS.SHARDSRV($lg(instanceAddress,1),$lg(tAddress,1)))&&($lg(instanceAddress,2)=$lg(tAddress,2)) {
							set skip($lg(tAddress,3))=""	
						}
					}
				}	
			}
			#; purge stale table stats
			#; StatsRetentionDays is the number days we should retain table stats for this namespace, default is 399 (57 weeks)
			#; Namespace setting -> system setting -> default (57)
			set tableStatsRetentionDays=$g(^%SYS("sql","sys","TableStatsRetention",$namespace),$g(^%SYS("sql","sys","TableStatsRetention"),57))*7
			set tsc = $$PurgeStaleStatsInfo^%qarTune("*","*",tableStatsRetentionDays,0)
			set:$$$ISERR(tsc) sc=$$$ADDSC(sc,tsc)
			set tsc = $$sortTables^%qarTune(.ord,ttFixedStats,ttRemote,ttEfficientSamplingOnly)
			set:$$$ISERR(tsc) sc=$$$ADDSC(sc,tsc)
		}
		THROW:$$$ISERR(sc)
	} catch {
		set sc = $$$ERROR($$$ObjectScriptError,$ze)
	}
	RETURN sc
}
.
#; Identify tables eligible for collection based on this ranking in current namespace.
#; 1. Tables that have no statistics at all
#; 2. Tables whose most recent collected statistics have been invalidated (through a TRUNCATE or table recompile), ranked by the age of those stats in descending order
#; 3. Tables for which the sum of the recorded ROWCOUNT of INSERT, UPDATE and DELETE statements (per the runtime stats in the statement index) exceeds 25% of the table's most recently recorded extent size, ranked by that approximate rate of change
#; Tables are exempted from automated collection (they are left out of this ranking) based on the following criteria:
#; 1. the SKIPAUTOMATICSTATSCOLLECTION class parameter is set to 1 in the class definition
#; 2. automatic statistics collection is disabled through a flag in the extent database - for cases when the class definition is not writable
#; 3. The tables master map global maps to a remote database and the configuration option to scan remote databases is off
#; 4. The tables has fixed stats and the configuration option to tune table with fixed stats is off
#; 5. The tables do not support efficient sampling and the configuration option to tune table with efficient sampling only is on
sortTables(&ord,ttFixedStats=1,ttRemote=0,ttEfficientSamplingOnly=1) PUBLIC{
	set sc=$$$OK
	set ns=$NAMESPACE
	set schema="&"
	do getDataChangeRate(.dataChangeRates)
	for  {
		set schema=$o(^rINDEXSQL("TABLE",schema)) quit:schema=""
		set table=""
		for  {
			set table=$o(^rINDEXSQL("TABLE",schema,table)) quit:table=""
			set classname=$$$GetClassNameFromTableName(schema,table)
			set sharded=$$$comSharded(classname) // JMM1160=
			// Federated tables aren't tuned, they inherit their stats from their source tables
			continue:$$$SSIsFederated(classname)
			continue:sharded=2  // shard-local tables will be tuned when shard-master tables are tuned
			continue:$$skipAutoStatsCollection(classname) // condition 1&2 in exempt rule
			set iqn=$$$GetIQNFromTableName(schema,table)
			set mrirn=$$$smdLoadGetIrn(iqn)
			continue:$$$smdTempTableType(1,mrirn)'="" // skip temp table
			set extentname=$$$GetExtentNameFromTableName(schema,table)
			set tabinfo=$g($$$EXTsqlinfo($$$rEXT,extentname))
			continue:tabinfo="" // table does not exist
			try {do GetGlobalInfo(iqn, mrirn,.imp,.gName,.DIR,,.DB,.DBS,.CT)} catch {continue}
			
			set remote=0
			if $listget(DBS,1)=0 {; if there is any err when getting global, use old row based sampling
				set remote=1 
			} else {
				for i = 2:1:$listlength($get(DBS)){
					if $piece($listget($listget(DBS,i)),"^")'=""{
						set remote=1 
						quit
					}
				}
			}
			continue:remote&&('ttRemote) // condition 3 in exempt rule
			if (ttRemote&&('remote))||('ttRemote){
				// if ttRemote = 1: remote table will be tuned (if there is no fixed stats - condition 4 in exempt rule is checked below) because ttRemote config is set to 1, so we only check local table
				// if ttRemote = 0: remote table will be excluded in the condition 3 above, so the table here should be 'remote
				set efficentSampling=($$$SQLLocTableSupportsBlockSampling(tabinfo))||($$$smdBitmapExtentMap(1,mrirn)'="")
				continue:('efficentSampling)&&(ttEfficientSamplingOnly) // condition 5 in exempt rule
			}
			continue:($$hasFixedStats^%qTable(iqn))&&('ttFixedStats) // condition 4 in exempt rule
			set tablename=schema_"."_$tr(table,".",$c(2))
			set tsc=##class(%ExtentMgr.TableStatsInfo).GetLatestCollectedStatsInfo(classname,0,.stat,.statID)
			if ($$$ISERR(tsc))||(stat="") { 
				// rank #1: Tables that have no statistics at all
				set ord(1,1,$I(ord))=$lb(ns,tablename,$g(dataChangeRates(tablename),0))
			} elseif '$$CheckStorageInfo(iqn,statID,stat.ExtentSize) {
				// rank #2: Tables whose most recent collected statistics have been invalidated 
				// (through table recompile), 
				// ranked by the age of those stats in descending order
				set ord(2,stat.EndTime,$I(ord))=$lb(ns,tablename,$g(dataChangeRates(tablename),0))
			} elseif $g(dataChangeRates(tablename,"rate"),0){
				// rank #3: Tables for which the sum of the recorded ROWCOUNT of INSERT, UPDATE and DELETE statements 
				// (per the runtime stats in the statement index) exceeds 25% of 
				// the table's most recently recorded extent size, 
				// ranked by that approximate rate of change
				set ord(4,1-dataChangeRates(tablename,"rate"),$I(ord))=$lb(ns,tablename,dataChangeRates(tablename))
			}
			
		}
	}
	RETURN sc
}
.
#; Loop through SQL statement index, get sum of the recorded ROWCOUNT of INSERT, UPDATE and DELETE statements for each table.
#; if it exceeds 25% of the table's most recently recorded extent size, 
#; get approximate rate of change
#define dataChangeRateLimit 0.25
getDataChangeRate(&tbls) public {
	kill tbls
	Set hash=""
	For {
		Set hash=$order($$$SQLIndex(1,hash)) Quit:hash=""
		continue:'$d($$$SQLIndex(1,hash,"priv"))
		continue:'$d($$$SQLIndex(5,hash,"stat"))
		set ttypeRel=""
		For {
			Set ttypeRel=$order($$$SQLIndex(1,hash,"priv",ttypeRel)) Quit:ttypeRel=""
			continue:$p(ttypeRel,",")'=1 // for table
			set priv=""
			For {
				Set priv=$order($$$SQLIndex(1,hash,"priv",ttypeRel,priv)) Quit:priv=""
				continue:'$lf($lb("i","u","d"),priv) // should be INSERT, UPDATE and DELETE
				set rel=$p(ttypeRel,",",2)
				set tbls(rel)=$g(tbls(rel))+$lg($$$SQLIndex(5,hash,"stat"),5)
			}
		}
	}
	set rel=""
	For {
		Set rel=$order(tbls(rel),1,changeCnt) Quit:rel=""
		set schema=$$$AllButLastPiece(rel,"."),tablename=$tr($$$LastPiece(rel,"."),$c(2),".")
		if (schema="")||(tablename="") { kill tbls(rel) continue }
		set extentname=$$$GetExtentNameFromTableName(schema,tablename)
		if (extentname="") { kill tbls(rel) continue }
		set tabinfo=$g($$$EXTsqlinfo($$$rEXT,extentname))
		if (tabinfo="") { kill tbls(rel) continue }
		set classname=$$$SQLLocTableClassname(tabinfo)
		if (classname="") { kill tbls(rel) continue }
		set sc=##class(%ExtentMgr.TableStatsInfo).GetLatestCollectedStatsInfo(classname,0,.stat)
		continue:$$$ISERR(sc)
		continue:stat="" // if this class does not have stats at all, it should be in rank #1 in sortTables
		set lastChangeCnt=##class(%ExtentMgr.TableStats).GetLastNumRowsChanged(classname)
		set:lastChangeCnt>changeCnt lastChangeCnt=0
		set dataChangeRate=(changeCnt-lastChangeCnt)/(stat.ExtentSize+1)
		set tbls(rel,"rate")=$s(dataChangeRate<=$$$dataChangeRateLimit:0,1:dataChangeRate)
	}
	RETURN
}
.
skipAutoStatsCollection(classname) public {
	RETURN:$PARAMETER(classname,"SKIPAUTOMATICSTATSCOLLECTION") 1 // the SKIPAUTOMATICSTATSCOLLECTION class parameter is set to 1 in the class definition
	RETURN:##class(%ExtentMgr.TableStats).GetSkipAutomaticStatsCollection(classname) 1 // automatic statistics collection is disabled through a flag in the extent database - for cases when the class definition is not writable	
	RETURN 0
}
.
#; Get storage information that could potentially invalidate the collected table statistics
GetStorageInfo(iqn,&statsOref) public {
	set sc=$$$OK
	set classname=$$$GetClassNameFromIQN(iqn),extentname=$$$GetExtentNameFromIQN(iqn)
	If '$d($$$EXTsqlinfo($$$rEXT,extentname),tabinfo) RETURN $$$ERROR($$$SQLError,-30,$$$FormatText($$$Text("No such table '%1'","%SQL.TuneTable"),iqn))
	set tDefaultStorage=$$$SQLLocTableCacheStorage($$$EXTsqlinfo($$$rEXT,extentname))
	set strategy=$$$defClassKeyGet(classname,$$$cCLASSstoragestrategy)
	set tOrefStorageInfo=##class(%ExtentMgr.StorageInfo).%New()
	set tOrefStorageInfo.Type="Default Storage"
	set tOrefStorageInfo.Name="Default Storage"
	set tOrefStorageInfo.Info=$lb(tDefaultStorage,strategy)
	// $lb(does table use default storage, strategy name if using SQL storage)
	do statsOref.StorageInfo.Insert(tOrefStorageInfo)
	
	// loop through all the fields in oddEXTR
	set field=""
	For  {
		set field=$o($$$EXTSQLCOL($$$rEXT,extentname,field)) quit:field=""
		set fldInfo=$$$EXTSQLCOLsqlinfo($$$rEXT,extentname,field)
			#;  If the class author has defined this field to not be tuned by setting the
			#;  Property paramater CACLSELECTIVITY=0, then skip this field and all the sub-fields.
			#;  CALCSELECTIVITY=0 also means no AverageFieldSize will be measured
		continue:$$checkCALCSELECTIVITY(fldInfo,tabinfo,extentname)
		continue:$$$SQLLocColArrayCollection(fldInfo) // no hist
		continue:$$checkDataType^%apiDDL2($$$SQLLocColDatatype(fldInfo),$lb("%Library.Vector","%Library.DynamicArray","%Library.DynamicObject")) // no hist
		set tOrefStorageInfo=##class(%ExtentMgr.StorageInfo).%New()
		set tOrefStorageInfo.Type="Field"
		set tOrefStorageInfo.Name=field
		// $lb(field data type, field collation)
		set tOrefStorageInfo.Info=$lb($$$SQLLocColDatatype(fldInfo),$$$SQLLocColCollation(fldInfo))
		do statsOref.StorageInfo.Insert(tOrefStorageInfo)
	}
	// loop through all the map in oddEXTR
	set map="" 
	For {
		set map=$o($$$EXTSQLMAP($$$rEXT,extentname,map)) quit:map=""
		set mapInfo=$$$EXTSQLMAPsqlinfo($$$rEXT,extentname,map)
		set indexType=$$$SQLLocMapIndexType(mapInfo)
		If ($e(indexType,1,2)="FI") {
			Set FIclass = $p($p($$$SQLLocMapIndexType(mapInfo),"(",2),")",1)
			Continue:(FIclass="")||('$$$comMemberKeyGet(FIclass,$$$cCLASSparameter,"ProjectMap",$$$cPARAMdefault))	// Don't compute Map Blocks for Functional Indices that have parameter ProjectMap set to 0
		}
 		continue:'$$$SQLLocMapFromThisTable(mapInfo)
 		set tOrefStorageInfo=##class(%ExtentMgr.StorageInfo).%New()
		set tOrefStorageInfo.Type="Map"
		set tOrefStorageInfo.Name=map
 		if tDefaultStorage {
	 		// $lb(index global, index type, index fields(multi nodes))
	 		// cannot put index fields in another $lb, since the export file will have invalid char, and we cannot use this file to import
			set tOrefStorageInfo.Info=$lb($$$SQLLocMapGlobal(mapInfo),indexType)_$$$SQLLocMapIndexFields(mapInfo)
	 	} else {
		 	// subscript exp
			set sub="",subExpressions=""
			for  {
				set sub=$o($$$EXTSQLMAPSUB($$$rEXT,extentname,map,sub)) quit:sub=""
				set msInfo=$$$EXTSQLMAPSUBsqlinfo($$$rEXT,extentname,map,sub)
				set subExpressions=subExpressions_$lb($tr($$$SQLLocMapSubExpression(msInfo),$c(5,6)))	
			}
			// data properties & delimiter
			set data="",dataProperties=""
			For  {
				set data=$o($$$EXTSQLMAPDATA($$$rEXT,extentname,map,data)) quit:data=""
				set mdInfo=$$$EXTSQLMAPDATAsqlinfo($$$rEXT,extentname,map,data)
				set dataProperties=dataProperties_$lb($$$SQLLocMapDataFieldName(mdInfo),$length($$$SQLLocMapDataDelimiter(mdInfo)))
			}
			// $lb(index global, index type, index subscript exp (multi nodes), index data prop&delimiter(multi nodes))
			set tOrefStorageInfo.Info=$lb($$$SQLLocMapGlobal(mapInfo),indexType)_subExpressions_dataProperties
		}
		do statsOref.StorageInfo.Insert(tOrefStorageInfo)
	}
	RETURN sc
}
.
#; Check if the collected table statistic storage information is still valid
CheckStorageInfo(iqn,statsID,extentSize) public {
	set classname=$$$GetClassNameFromIQN(iqn)
	set shardLocalCls=$$getShardLocalClassName^%SYS.SHARDSRV(classname)
	if shardLocalCls'=classname {
		set classname=shardLocalCls
		$$$comClassKeyGetLvar(table,classname,$$$cCLASSsqltablename)
		$$$comClassKeyGetLvar(schema,classname,$$$cCLASSsqlschemaname)
		RETURN:(table="")||(schema="") 0
		set extentname=$$$GetExtentNameFromTableName(schema,table)
	} else {
		set extentname=$$$GetExtentNameFromIQN(iqn)
	}
	If '$d($$$EXTsqlinfo($$$rEXT,extentname),tabinfo) RETURN 0
	set tDefaultStorage=$$$SQLLocTableCacheStorage($$$EXTsqlinfo($$$rEXT,extentname))
	set strategy=$$$defClassKeyGet(classname,$$$cCLASSstoragestrategy)
	merge stored=^rINDEXEXT("Stats",classname,"StatsInfo",statsID,"StorageInfo")
	// one uses default storage, another one does not
	// both use sql storage, but different storage name (assume different storage name has completely different mapping)
	RETURN:'$listsame($lg($g(stored("Default Storage","Default Storage"))),$lb(tDefaultStorage,strategy)) 0
	
	// loop through all the fields in oddEXTR
	set field=""
	For  {
		set field=$o($$$EXTSQLCOL($$$rEXT,extentname,field)) quit:field=""
		set fldInfo=$$$EXTSQLCOLsqlinfo($$$rEXT,extentname,field)
			#;  If the class author has defined this field to not be tuned by setting the
			#;  Property paramater CACLSELECTIVITY=0, then skip this field and all the sub-fields.
			#;  CALCSELECTIVITY=0 also means no AverageFieldSize will be measured
		continue:$$checkCALCSELECTIVITY(fldInfo,tabinfo,extentname)
		continue:$$$SQLLocColArrayCollection(fldInfo) // no hist
		continue:$$checkDataType^%apiDDL2($$$SQLLocColDatatype(fldInfo),$lb("%Library.Vector","%Library.DynamicArray","%Library.DynamicObject")) // no hist
		if $d(stored("Field",field),info) {
			set info=$lg(info)
			// different datatype or collation
			RETURN:'$listsame(info,$lb($$$SQLLocColDatatype(fldInfo),$$$SQLLocColCollation(fldInfo))) 0
		} elseif extentSize {
			// check if we add a required field for extent size>0
			RETURN:$$$SQLLocColRequired(fldInfo)="Y" 0
		}
	}
	// loop through all the maps in oddEXTR
	set map="" 
	For {
		set map=$o($$$EXTSQLMAP($$$rEXT,extentname,map)) quit:map=""
		set mapInfo=$$$EXTSQLMAPsqlinfo($$$rEXT,extentname,map)
		set indexType=$$$SQLLocMapIndexType(mapInfo)
		If ($e(indexType,1,2)="FI") {
			Set FIclass = $p($p($$$SQLLocMapIndexType(mapInfo),"(",2),")",1)
			Continue:(FIclass="")||('$$$comMemberKeyGet(FIclass,$$$cCLASSparameter,"ProjectMap",$$$cPARAMdefault))	// Don't compute Map Blocks for Functional Indices that have parameter ProjectMap set to 0
		}
 		continue:'$$$SQLLocMapFromThisTable(mapInfo)
 		continue:'$d(stored("Map",map),info)
 		set info=$lg(info)
 		if tDefaultStorage {
	 		// $lb(index global, index type, index fields)
			RETURN:'$listsame(info,$lb($$$SQLLocMapGlobal(mapInfo),indexType)_$$$SQLLocMapIndexFields(mapInfo)) 0
	 	} else {
		 	// subscript exp
			set sub="",subExpressions=""
			for  {
				set sub=$o($$$EXTSQLMAPSUB($$$rEXT,extentname,map,sub)) quit:sub=""
				set msInfo=$$$EXTSQLMAPSUBsqlinfo($$$rEXT,extentname,map,sub)
				set subExpressions=subExpressions_$lb($tr($$$SQLLocMapSubExpression(msInfo),$c(5,6)))	
			}
			// data properties & delimiter
			set data="",dataProperties=""
			For  {
				set data=$o($$$EXTSQLMAPDATA($$$rEXT,extentname,map,data)) quit:data=""
				set mdInfo=$$$EXTSQLMAPDATAsqlinfo($$$rEXT,extentname,map,data)
				set dataProperties=dataProperties_$lb($$$SQLLocMapDataFieldName(mdInfo),$length($$$SQLLocMapDataDelimiter(mdInfo)))
			}
			// $lb(index global, index type, index subscript exp, index data prop&delimiter)
			RETURN:'$listsame(info,$lb($$$SQLLocMapGlobal(mapInfo),indexType)_subExpressions_dataProperties) 0	
		}
	}
	RETURN 1
}
.
needResample(trueSampleSize,extentSize,tHandle,&fieldInfo,&selectivity,&resamplePercent=0) PUBLIC {
	/*
	Determine the extra percentage of rows that need to be resampled to
	improve the accuracy of outlier detection and number of distinct value
	estimation.
	
	This method works adaptively by using the information in the original
	sample of data to estimate how much more data needs to be resampled.
	To gauge how well the sample can predict features of the population, a
	cross-validation technique is used. It works by first splitting the sample
	into two subsamples, and then uses the estimation error from each 
	subsample as a prediction for the error of the original sample. This relies
	on a combination of heuritistics and statistical methods.
	
	For outlier detection, this method will default to the maximum permitted
	sampling rate if the two subsamples have different outliers. For the
	number of distinct value (NDV) estimation, we use the guaranteed-error (GE)
	estimate along with it's corresponding expected error ratio to predict
	the necessary sample size to reach a desired error.
	
	The guaranteed-error estimate is a poor estimator for data with both low
	skew and a high number of low frequency elements. On the other hand, our
	current estimate (an unsmoothed 2nd order jacknife estimator, see
	SetEstimators^%qarTune) tends to work better for these cases. For this
	type of data, the current estimate tends to do a pretty good job.
	
	Inputs
	------
	trueSampleSize:
		Original sample size
	extentSize:
		Number of rows in the whole table
	tHandle:
		First subscipt in the process-private global ^||%t where the sample
		data is stored
	fieldInfo:
		Array containing info of each column in the table, as retrieved from
		$$$EXTSQLCOLsqlinfo. Used to determine if a column is numerical data
	selectivity:
		Array with an entry for each column number. An column has the node
		"NUMROWS" if it is a unique attribute, and "" otherwise.
	
	Outputs
	-------
	:
		Boolean of whether resampling needs to be done.
	resamplePercent: (pass by reference)
		The additional percentage of rows that need to be sampled.
	*/
	
	RETURN:((extentSize>256)&&(trueSampleSize>=(15*$zsqr(extentSize))))||((extentSize<=256)&&(trueSampleSize>=extentSize)) 0
	
	set newSampleSize = 0
	set maxResampleSize = 4 * trueSampleSize
	
	set icol = ""
	for {
		set icol = $order($$$tFile(tHandle, icol))
		QUIT:(icol = "")
		
		// don't resample unique fields
		CONTINUE:(selectivity(icol) = "NUMROWS")
		
		set numericData = $case($$$SQLLocColSQLCategory(fieldInfo(icol)),"INTEGER":1,"NUMERIC":1,"DOUBLE":1,"DATE":1,"TIME":1,"POSIXTS":1,:0) 
		do SampleStatistics(tHandle, icol, numericData, .subsampleOutliers, .numDistinctVals, .numSingletons, .sampleSkew)
		
		// check that outliers in the subsamples agree
		if $list(subsampleOutliers, 1) '= $list(subsampleOutliers, 2) {
			set resamplePercent = maxResampleSize / extentSize
			RETURN 1
		}
		
		// get resampling estimate based on NDV estimation for high-skew data
		// or for non-numerical data by default
		if 'numericData || ($zabs(sampleSkew) >= 1) {
			set desiredRatioErr = 2
			set ndvResample = $$NDVResampleSizeEst(trueSampleSize, extentSize, desiredRatioErr, numDistinctVals, numSingletons)
			
			// select the largest sampling size
			set newSampleSize = $select(newSampleSize < ndvResample: ndvResample, 1: newSampleSize)
		}
		
		// at max sample size, don't need to check other columns
		if (newSampleSize - trueSampleSize) >= maxResampleSize {
			QUIT
		}
	}
	
	// remaining amount left to sample
	set resampleSize = newSampleSize - trueSampleSize
	// do not resample if new sample size is smaller than the previous
	RETURN:(resampleSize < 0) 0
	// limit to maximum resampling rate
	set:(maxResampleSize < resampleSize) resampleSize = maxResampleSize
	set resamplePercent = resampleSize / extentSize
	
	RETURN 1
}
.
SampleStatistics(tHandle, icol, isDataNumeric, &subsampleOutliers, &numDistinctVals, &numSingletons, &sampleSkew) PUBLIC {
	/*
	Gather statistics used in determining the resampling rate from data stored
	in the PPG $$$tFile. Statistics are obtained for each sample/subsample and
	stored as a $lb().
	
	Skew is calculated using a online, single-pass algorithm developed by
	Terriberry. See also the related Wikipedia article.
	
	[1] Terriberry, Timothy B. (15 October 2008) [9 December 2007].
	"Computing Higher-Order Moments Online". Archived from the original on 23
	April 2014.
	[2] https://en.wikipedia.org/wiki/Algorithms_for_calculating_variance
	
	Inputs
    ------
	tHandle, icol: int
		Subscripts in $$$tFile where the sample data is stored. icol is the
		column number from the table.
	isDataNumeric: int (boolean)
		1 if the data is numeric, 0 if not. If the data is numeric, the skew
		will be computed. Otherwise, sampleSkew is left empty ("").
		
	Outputs
    -------
	subsampleOutliers: $listbuild() of length 2
		Outliers for the two subsamples (after splitting the sample in two)
	numSingletons: $listbuild() of length 3
		Number of values that appear only once in the sample and both
		subsamples
	numDistinctVals: $listbuild() of length 3
		Number of distinct values in the sample and both subsamples
	sampleSkew: float
		The skew of the (original) sample
	*/
	
	set subsampleOutliers = $lb("", "")
	set ocount = $listbuild(0, 0)
	set sampleSkew = ""
	set (mean, moment2, moment3, n) = 0
	set (numDistinctVals, numSingletons) = $listbuild(0, 0, 0)
	set sampleSize = 0
	
	set fval=""
	for {
		set fval = $order($$$tFile(tHandle, icol, fval), 1, counts)
		QUIT:(fval = "")
		
		// loop over samples
		set i = 0
		for sampleIdx = 1, 3, 4 {
			set i = i + 1
			set count = $listget(counts, sampleIdx)
			if count {
				// count number of distinct values in each sample
				set $list(numDistinctVals, i) = $list(numDistinctVals, i) + 1
				
				// find value with max occurences to compute outlier for subsamples only
				if ((sampleIdx > 1) && (count > $list(ocount, i - 1))) {
					set $list(ocount, i - 1) = count
					set $list(subsampleOutliers, i - 1) = fval
				}
				
				// get number of values that appear exactly once in each sample
				if count = 1 {
					set $list(numSingletons, i) = $list(numSingletons, i) + 1
				}
			}
		}
		set sampleSize = sampleSize + $listget(counts, 1)
		
		// ignore null values when computing the skew
		CONTINUE:(fval=$$$NULLSubscriptMarker19)
		// don't compute skew for non-numeric data
		CONTINUE:('isDataNumeric)
		set count = $listget(counts, 1)
		// accumulate moments used for the skew
		for k=1:1:count {
			set n = n + 1
			set delta = fval - mean
			set deltaN = delta / n
			set term1 = delta * deltaN * (n - 1)
			set mean = mean + deltaN
			set moment3 = moment3 + (term1 * deltaN * (n - 2)) - (3 * deltaN * moment2)
			set moment2 = moment2 + term1
		}
	}
	
	if isDataNumeric {
		// calculate the skew
		if (moment3 = 0) || (moment2 = 0) {
			set sampleSkew = 0
		} else {
			set sampleSkew = $zsqr(n) * moment3 / ($zsqr(moment2) ** 3)
		}
	}
	
	for i = 1, 2 {
		// no outlier for empty samples and samples with a single value
		if ($list(numDistinctVals, i + 1) <= 1) {
			set $list(subsampleOutliers, i) = ""
		} else {
			set avgClassSize = (sampleSize / 2) / $list(numDistinctVals, i + 1)
			// compute average class size with the outlier value removed
			set reducedAvgClassSize = ((sampleSize / 2) - $list(ocount, i)) / ($list(numDistinctVals, i + 1) - 1)
			// no outlier in these cases
			if ((sampleSize / 2) < 6) || ($list(ocount, i) <= avgClassSize) || ($list(ocount, i) <= (5 * reducedAvgClassSize)) {
				set $list(subsampleOutliers, i) = ""
			}
		}
	}
	
	RETURN
}
.
NDVGuarErrEstimator(sampleSize, extentSize, &numDistinct, &singletons) PUBLIC {
	/*
	Guaranteed-Error Estimator for estimating the number of distinct values
	(NDV) of an attribute from a table given a sample from that attribute.
	
	The estimator is given by
	
	$$ \hat{D} = \sqrt{n / r} f_1 + \sum_{j=2}^{r} f_j $$
	
	where $f_i$ is the number of values that occur exactly $i$ times in the
	sample, $n$ is the extent size, and $r$ is the size of the sample.
	
	Moses Charikar, Surajit Chaudhuri, Rajeev Motwani, and Vivek Narasayya.
	2000. Towards estimation error guarantees for distinct values. In
	Proceedings of the nineteenth ACM SIGMOD-SIGACT-SIGART symposium on
	Principles of database systems (PODS '00). Association for Computing
	Machinery, New York, NY, USA, 268-279. 
	https://doi.org/10.1145/335168.335230
	
	Inputs
	------
	sampleSize: int
		Number of values in the sample of the attribute
	extentSize: int
		Number of rows of an attribute
	numDistinct: int
		Number of distinct values in the sample
	singletons: int
		Number of values that appear exactly once in the sample
		
	Outputs
	-------
	: int
		Estimate of the NDV for the attribute
	*/
	return $normalize(numDistinct + (($zsqr(extentSize / sampleSize) - 1) * singletons), 0)
}
.
NDVCrossValError(sampleSize, &numDistinctVals, &numSingletons) PUBLIC { 
	/*
	Given two disjoint subsets from a sample,
	determine the average ratio error of predicting the number of distinct
	values (NDV), D, in the original population from which the sample was
	drawn, when using the guaranteed-error estimator.
	
	The ratio error is defined as
	
	$$err(\hat{D}) = \max(D / \hat{D}, \hat{D} / D) $$
	
	where $D$ is the true number of distinct values of the population and
	$\hat{D}$ is the estimated number of distinct values based off of a
	sample from the population.
	
	The cross-validation error estimates the ratio error by using the NDV of
	the sample, $d$, instead of the population. It uses the estimates from the
	subsamples to compute $\hat{d}$ and an average for $err(\hat{d})$. We use
	this average as our estimate for $err(\hat{D})$.
	
	Inputs
	------
	sampleSize: int
		Size of the sample
	numDistinctVals: $lb()
		Number of distinct values in each sample
	numSingletons: $lb()
		Number of values that appear exactly once in each sample
.
	Outputs
	-------
	: float
		Estimated expected ratio error of the Guaranteed-Error NDV Estimator.
	*/
	set numSubsamples = 2
	set subsampleSize = sampleSize \ numSubsamples
	set numDistSample = $list(numDistinctVals, 1)
.
	set cvErr = 0
	// loop over subsamples
	for i = 2, 3 {
		// use subsamples to estimate NDV of total sample
		set ndvEst = $$NDVGuarErrEstimator(subsampleSize, sampleSize, $list(numDistinctVals, i), $list(numSingletons, i))
		// compute the (max) ratio error of the subsample estimate to the true sample NDV
		set ratioErr = $select(ndvEst > numDistSample: ndvEst / numDistSample, 1: numDistSample / ndvEst)
		set cvErr = cvErr + ratioErr
	}
	// average error over subsamples
	set cvErr = cvErr / numSubsamples
	
	RETURN cvErr
}
.
NDVResampleSizeEst(sampleSize, extentSize, errThreshold, &numDistinctVals, &numSingletons) PUBLIC {
	/*
	Estimate the required sample size to reach a given number-of-distinct-
	value-estimation error threshold. This number represents the new total
	sample size required (initial sample size + extra samples).
	
	The guaranteed-error number of distinct (NDV) estimator has the property
	that the expected ratio error is
	
	$$ E[err(\hat{D})] = \mathcal{O}(\sqrt(n / r)),$$
	
	were $\hat{D}$ is the NDV estimate, $n$ is the extent size of the
	population, and $r$ is the sample size. The ratio error is defined as
	
	$$err(\hat{D}) = \max(D / \hat{D}, \hat{D} / D) $$
	
	where $D$ is the true number of distinct values of the population and
	$\hat{D}$ is the estimated number of distinct values based off of a
	sample from the population. We approximate the ratio error by using the NDV
	of the sample, $d$, instead of the population. We then split this sample
	into smaller subsamples, and use the estimates from the subsamples to
	compute $\hat{d}$ and $err(\hat{d})$. We then compute the average of the
	ratio errors of the subsamples as our estimate for $err(\hat{D})$.
	
	Using the expression for the expected ratio error, we approximate
	$E[err] = c \sqrt(r / r_s)$, where $r_s$ is
	the subsample size that is used to estimate $E[err]$, and compute the
	scaling factor $c = E[err] \sqrt(r_s / r)$. We then use this scaling factor
	to estimate the number of samples necessary to reach the desired error
	'errThreshold'. This was further modified by subtracting 1 from both the
	cvErr and the desired error to ensure that when the cvErr is 1 (prediction
	agrees with true NDV), we don't resample.
	
	
	Moses Charikar, Surajit Chaudhuri, Rajeev Motwani, and Vivek Narasayya.
	2000. Towards estimation error guarantees for distinct values. In
	Proceedings of the nineteenth ACM SIGMOD-SIGACT-SIGART symposium on
	Principles of database systems (PODS '00). Association for Computing
	Machinery, New York, NY, USA, 268-279. 
	https://doi.org/10.1145/335168.335230
	
	Inputs
	------
	sampleSize: int
		Size of the sample.
	extentSize: int
		Size of the population.
	errThreshold: float > 1
		The desired ratio error for the NDV. This is meaningful for values > 1,
		where a value of 1 means the estimated NDV is exact.
	numDistinctVals: $lb()
		Number of distinct values in each sample
	numSingletons: $lb()
		Number of values that appear exactly once in each sample
	
	Outputs
	-------
	: int
		Number of samples from the original population necessary to reach the
		desired error threshold when estimating the NDV of the population.
	*/
	set ndvEsts = ""
	set numSubsamples = 2
	set subsampleSize = sampleSize \ numSubsamples
	// cross-validation error
	set cvErr = $$NDVCrossValError(sampleSize, numDistinctVals, numSingletons)
	set resampleSize = $normalize(extentSize * subsampleSize / sampleSize * (((cvErr - 1) / (errThreshold - 1)) ** 2), 0)
.
	RETURN resampleSize
}
.
Eval(x)
	New y 
	//if $e(x,1)="_" s y=x quit y
	Set @("y="_x) Quit y
.
