^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaccode^MAC^^^0
%qaccode ;
	;; COMPONENTS :: SQL/Code Generation
	#;
#INCLUDE %msql
	#;
#IF 0   ;
	;---------------------------------------------------------------------
	; Description:   ???
	; Author:        ???
	; Date:          ???
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;   AK784   (08/06/2010) - Don't add $G() to {xxx} in user code
	;   DPV3247 (08/19/2008) - SQL: relax whitespace restrictions in SQLComputeCode 
	;   DPV2806 (12/01/2006) - Fix swapexp to set pos correctly after value is replaced.
	;   DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;   DPV1993 (05/19/2003) - Re-instate code backed out by DPV1642
	;   DPV1658 (01/25/2002) - Remove setting of test in swapexps
	;   DPV1642 (01/10/2002) - Remove skipping of ()
	;   DPV1351 (07/31/2000) - Fix swapping when quotes are involved
	;   DPV1300 (05/08/2000) - rewrote routine
	;   DPV308  (11/21/1994) - Cleaned up routine
	;
	;---------------------------------------------------------------------
	;                     I N F O R M A T I O N
	;---------------------------------------------------------------------
	;
	;	This is called for Map Data Retrieval code in fldx^%qaqcdt
	;	and for SQLComputeCode in code1^%qaqcdt
	;	and for iDj variable code in refdvar^%qaqcky
	;
	;---------------------------------------------------------------------
#ENDIF  ;
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;
.
#DEFINE argPrefix "%sqlarg"
.
	/// Called from %qaqcdt and %qaqcky
swap(code,argmap="") [mts,pti,qno,str] PUBLIC {
		#; swap all {field} references with the variable assigned to the field's value
		#; or, if argprefix provided
		#;  	if '$d(argmap(sub) set argmap(sub) = $lb($increment(argmap),pti(val))
		#; 		swap in <argprefix><argmap(pti(val))>
		#; The caller can use argmap to build an argument list with which to call this code,
		#; passing in the corresponding variables rather than inlining them
	set j=1,intcode=code,pos=1,mlcomment=0
	for  {
		set pos=$$find^%qarmac(code,"{",pos,$$$MaxStringLength,.mlcomment) quit:'pos||(code'["}")
		set a=$e(code,1,pos-2),b=$e(code,pos,*),j=j+1,z=""
		set flag="",ifn=$p(b,"}"),b=$p(b,"}",2,*)
		continue:'((ifn?1.n)||(ifn?1.N1"D")||(ifn?1.N1"D"1.N)||(ifn?1"S"1.N)||(ifn?1"%".e))	// Not a {number} and not a {%something}
		set c=$e(intcode,1,pos-2-($l(code)-$l(intcode)))
		if ifn["*",ifn'="*" {
			set z=$p(ifn,"*",2+($e(ifn)="*")),ifn=$p(ifn,"*",1,1+($e(ifn)="*"))
		}
		set ref = $$swapname(ifn,z)
		//Unless this is inline code, use a mapped argument instead of a query-specific value.
		if ($g(argmap)'="inline") set ref = $$remapReference(ref, .argmap)
		set intcode=c_ref_b ; build internal line
	}
	//set ^dpv2(^dpv2,2)=intcode,^dpv2("time")=$g(^dpv2("time"))+($zh-time)
	QUIT intcode
.
}
.
	/// Called from swap
swapname(ifn,z="") [mts,pti,qno,str] PRIVATE {
	#; enter here to swap the ifn to a var name returned in y
	#; This part is in charge of translating ifn to variable
	#; it uses the ifn, the use array and z which is the 2nd * piece of {}
	#; and retruns the variable name in y
	#;
	#; ---- Figure out what the Local context is ----
	set rowraw=($$$UPPER(ifn)="%ROWRAW")
	set:rowraw ifn="%row"
	set:ifn="%ROW" ifn="%row"
	set icol=$s($d(qno)&&($d(str)):$p($g(mts(qno,str,"ATT",ifn)),"^",5),1:"")
	QUIT:icol="" ""
	set val=$s(z="E":mt("unary",icol,"%EXTERNAL"),z="B":mt("unary",icol,"%INTEXT"),1:icol)
	set ref=pti(val)
	if rowraw {	// very rarely used
		if $e($$$LOWER(ref),1,3)="$g("       { set ref=$e(ref,4,*-1) }	// remove $g(...)
		elseif $e($$$LOWER(ref),1,5)="$get(" { set ref=$e(ref,6,*-1) }	// remove $get(...)
	}
	QUIT ref
}
.
	/// Returns an argument reference corresponding to the
	/// original query-specific reference ref, adding the
	/// mapping to argmap (as argmap(ref) = n) if not already present.
	/// Called from swap
remapReference(ref, argmap) PRIVATE {
	Set find=$$findargmap(ref,.argmap,.argmapsub)
	If 'find Set find=$i(argmap),argmap(argmapsub)=$lb(find,ref)
	RETURN $$$argPrefix_find
}
.
	/// Lookup 'ref' in the hashmap 'argmap' and set 'subscript' to either
	/// the matching reference subscript, or the next available free subscript
	/// if there is no match
	/// Called from %qaqcdt and remapReference
findargmap(ref,argmap,subscript) PUBLIC {
	Set sub=$select($l(ref)>245:$zcrc(ref,9),1:ref)
	For i="",1:1 {
		Set subscript=sub_i
		If '$data(argmap(subscript),val) RETURN ""
		If $lg(val,2)=ref RETURN $lg(val)
	}
}
.
	/// Returns a string list of parameters (e.g. %sqlarg1,%sqlarg2,...)
	/// in code-appearance order, based on argmap
	/// Callced from %qaqcdt
paramArgList(argmap) PUBLIC {
	set arglist=""
	set arg=""
		//Sort by argmap(arg) (order encountered in code)
	for i=1:1:$g(argmap,0) {
		set arglist=arglist_$$$argPrefix_i_","
	}
	if $e(arglist,*)="," { set $e(arglist,*)="" }
	RETURN arglist
}
	/// Returns a string list of input parameters (e.g. sqldatad4,sqldatad8,...)
	/// corresponding to the parmeters from paramArgList.
	/// Called from %qaqcdt
callArgList(argmap, outargs="") PUBLIC {
	set arglist=""
	set arg=""
		//Sort by argmap(arg) (order encountered in code)
	for i=1:1 {
		set arg=$o(argmap(arg),1,val) QUIT:arg=""
		set args($lg(val))=$lg(val,2)
	}
		//Spit them out in order, "." if in outargs.
	for i=1:1:$g(argmap,0) {
		set arg=args(i)
		set arglist=arglist_$s($lf(outargs, arg):".",1:"")_arg_","
	}
	if $e(arglist,*)="," { set $e(arglist,*)="" }
	RETURN arglist
}
