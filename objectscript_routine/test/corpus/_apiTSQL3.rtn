%apiTSQL3^MAC^^^0
%apiTSQL3 ; TSQL compiler - batch import
	;; COMPONENTS :: SQL/Dialect
	#;
#include %occInclude
 
 	Write "Use one of these entry-points :-",!
 	Write !
	Write "CompileDirectory(inputdir,loggingfile="""")",!
	Write " Compile all the .sql files in the given directory",!
	Write " logs to the given file, or to the terminal if the",!
	Write " argument is """" or omitted",!
	Write !
	Write "CompileBatchFile(inputfile,loggingfile="""")",!
	Write " Compile 'inputfile', writing the log to 'loggingfile'",!
	Write " - 'loggingfile' defaults to the screen, or pass ""*"" for",!
	Write "   'inputfile' with "".log"" appended",!
	Write !
	Write "CREATE PROCEDURE, CREATE FUNCTION and CREATE TRIGGER are honoured and existing target",!
	Write "procedures/triggers are OVERWRITTEN without warning.",!
	Write !
	Write "Other statements (e.g. CREATE TABLE) are compiled and executed immediately",!
	Write !
	Quit
	
	// compile all the .sql files in the given directory
	// logs to the given file, or to the terminal if the argument is "" or omitted
CompileDirectory(inputdir,loggingfile="",dest="") PUBLIC {
			
	// set up logging
	New %xsqllogging
	Do ##class(%XSQL.Reporting).InitLog(loggingfile)
	
	Do ##class(%XSQL.Reporting).Log("Using settings: "_$Get(^%TSQL("SETTINGS")))
	
 	// prepare the directory
	Set dlm=$Select(inputdir["\":"\",1:"/")
 	If $Extract(inputdir,*)'=dlm {Set inputdir=inputdir_dlm}
	Write "Scanning ",inputdir," .. "
 
 	// if the directory can't be found ..
 	If ##class(%File).DirectoryExists(inputdir)=0 {
		Write "Directory ",inputdir," not found",!
		Quit
 	}
 	// open a resultset on the directory's files
 	Set rs=##class(%ResultSet).%New("%File:FileSet")
 	
 	// get the first .sql file in the directory ..
 	Set sc=rs.Execute(inputdir,"*.sql","")
 	If '$$$ISOK(sc) {
		Write "Error scanning directory ",inputdir,!
	 	Quit
 	}
 	If 'rs.Next() {
		Write "No .sql files in directory ",inputdir,!
		Quit
 	}
 
 	// for each .sql file in the directory ..
	Do {
		If rs.GetData(2)'="F" {Quit}
		
		Set inputfile=rs.GetData(1)
 
		Write "Loading input from ",inputfile," .. "
		New %xsqlstats,%xsqlstatspath
		Kill %xsqlstats
		Do CompileBatchFile(inputfile,loggingfile)
		Do ##class(%XSQL.Reporting).LogStats()
		Write "done",!
		
	} While rs.Next()
 
	Set sc=rs.Close()
	If '$$$ISOK(sc) {
		Write "Error closing resultset",!
		Quit
	}
}
 
	// compile 'inputfile', writing the log to 'loggingfile'
	// - 'loggingfile' defaults to the screen, pass "*" for 'inputfile' with ".log" appended
CompileBatchFile(inputfile,loggingfile="",dest="") PUBLIC {
	new %xsqlstats
		#; if a %sqlcontext object is already defined, use it, otherwise new it so it does not leak
	new:'$d(%sqlcontext) %sqlcontext
	quit ##class(%TSQL.Manager).Import($Get(^%SYS("tsql","DIALECT"),"Sybase"),inputfile,loggingfile)
}
.
