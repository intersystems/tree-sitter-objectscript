====
fm2class3
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%fm2class3^MAC^^^0
%fm2class3	// VA FileMan -> InterSystems Class Mapper
.
#include %msql
#include %occConstant
#include %fm2class
.
	#;---------------------------------------------------------------------
	#; Description:   New Fileman to Class Interface
	#; Author:        David Van De Griek
	#; Date:          July 2008
	#; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ] 
	#;
	#;  DPV3957 (12/05/2011) - Implement $$$variablePointerValueField setting (2.06)
	#;                         Implement $$$expandPointers=3 setting
	#;  DPV3600 (03/18/2010) - Retain class enhancements (1.18)
	#;  DPV3579 (02/16/2010) - Define ability to have Required properties for required fields or required identifiers (1.17)
	#;                         Don't create fkeys for SOC tables added by v1.16
	#;                         Allow SC fields to be defined as String and not EnumString
	#;  DPV     (02/01/2010) - Allow SetOfCodes to be set up in a separate table and linked via a fkey (1.16)
	#;  DPV3567 (01/28/2010) - Define proper sequence number for class members (1.15)
	#;  DPV3487 (09/02/2009) - Only qualify map subscript field names if they are from another table (1.14)
	#;  DPV3352 (01/28/2009) - Fix mapping of corrupt multiple pointer, fix FILEMANFILENAME parameter (1.10)
	#;  DPV3317 (11/25/2008) - Use conditional index maps when $E({field},1,N) subscript expression is used (1.07)
	#;                         Enhance some error reporting when converting too big classes.
	#;  DPV3235              - Implement new utility %fm2class
	#; --------------- Changes below were from %fm2cache ----------------------
	#;  DPV3217 (07/08/2008) - Improve performance of class creation (.815)
	#;                         Add FILEMANFILENAME and FILEMANFILENUMBER class parameters
	#;  DPV3126 (03/17/2008) - Default String field length is now 255.    (.813)
	#;                         Use %String for IEN fields.
	#;                         Define MINLEN on %String fields where appropriate
	#;                         Fix <UNDEFINED> error with fid in index2
	#;                         Perform one save of entire class instead of saving each class item
	#;                         Field names longer the 50 characters are now supported
	#;  DPV3084 (12/13/2007) - Use %EnumString datatype for multiple choice fields (.812)
	#;  DPV3069 (11/07/2007) - Add $$$retainClass parameter to not completely delete the class definition (.811)
	#;  DPV3068 (11/06/2007) - Generate index maps from new style cross references
	#;  DPV3013 (09/10/2007) - Add ;PREV logic to Next code, move multpc to %fm2cache2
	#;  DPV3013 (09/10/2007) - Add ;PREV logic to Next code, move multpc to %fm2cache2
	#;  DPV3008 (08/27/2007) - Fix Variable Pointers
	#;  DPV2963 (06/19/2007) - Fix Delete of classes, use 60 for class name length
	#;  DPV2845 (01/23/2007) - Enhance ConvertFiles entry point
	#;  DPV2801 (11/28/2006) - ConvertFiles entry point
	#;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	#;  DPV2449 (06/28/2005) - First checkin of utility
	#;---------------------------------------------------------------------
	#;                     I N F O R M A T I O N
	#;---------------------------------------------------------------------
	#;
	#;   Start your information here...
	#;---------------------------------------------------------------------
 
.
MakeClasses(compile=1) [classIndices,classFKeys,classMaps,classTriggers,Classname,filen,fileName,id,oldClassname,oldTableName,tableName,SOCClasses,SQLCODE,tPackage] PUBLIC {
	
	s $zt="makeError",tlevel=$tlevel,autoCommitMode=$zu(115,1,2)
	n %0CacheLock,%fm2cacheClassBuilding,%fmSequence,%reuseClass,%ROWCOUNT,%ROWID,%schema,%sqlcontext,Classname,classIndices,classFKeys,classMaps,classTriggers,filen,fileName,id,oldClassname,oldTableName,tableName,SOCClasses,SQLCODE,tPackage
	set tVersionNum=$$GetVersion^%fm2class()
	set tPackage=$$$package set:$e(tPackage,$l(tPackage))="." tPackage=$e(tPackage,1,$l(tPackage)-1)
	do ConvertoddFMD()
	set ^oddFMD=tVersionNum
	s t="",t1=$zh $$$output2("",1,0)
	s zu1159val=$zu(115,9) i $zu(115,9,0)
	s zu11510val=$zu(115,10) i $zu(115,10,0)
	
		#; %reuseClass is a global-in-scope variable that is 1 if the class definition is being re-created
	s %schema=$$DetermineSchemaName^%occClass($$$package),cnt=1
		
		#; Prime the classname for each file/table we are about to create/update
	for  {
		set t=$o(^IRIS.TempFMI($j,"rv",t),1,filen) quit:t=""
		set tdata=$g(^IRIS.TempFM($j,filen)) quit:tdata=""
.
			#; have to cast FileNumber as a VARCHAR so that filens that contain strings like "Soc" are not translated to numbers
		if $d(^oddFMD(filen,"p",tPackage))#2,filen'["OVF" {
			&sql(select Classname, SOCClasses, TableName 
			     into   :oldClassname, :SOCClasses, :oldTableName 
			     from   %FileMan.MappedFilePackage 
			     where  --cast(FileNumber as varchar) = :filen and Package = :tPackage
			     	    FileNumber = :filen and Package = :tPackage
			)
			if SQLCODE=0,oldClassname'="",filen'["SoC" { 
				set Classname=oldClassname	// Reuse the same class
				#;w !,Classname,?50,oldTableName
				set ^IRIS.TempFMI($j,"class",$$$UPPER(Classname))=$lb(Classname,oldTableName)
				set ^IRIS.TempFMI($j,"table",$$$UPPER(oldTableName))=$lb(Classname,oldTableName)
			}
			else {	// File mapping was not found
				s Classname=$$$package_$$Classname($lg(tdata,1),1)
			}
		}
		else {
			s Classname=$$$package_$$Classname($lg(tdata,1),1)
		}
	}
		#; At this point ^IRIS.TempFMI($j,"class"/"table",...) have been fully populated with the classes to create.
		#; The class names are qualified, but the table names are not.
.
loop	for cnt=cnt:1 {
		s t=$o(^IRIS.TempFMI($j,"rv",t),1,filen) q:t=""
		TSTART
		s tdata=$g(^IRIS.TempFM($j,filen)) q:tdata=""
		set %fm2cacheClassBuilding=1
		s oldClassname="",classIndices="",classFKeys="",classMaps="",classTriggers=""
.
			#; See if this file had been previously linked...
		set previouslyMapped=0
			#; have to cast FileNumber as a VARCHAR so that filens that contain strings like "Soc" are not translated to numbers
		if $d(^oddFMD(filen,"p",tPackage))#2,filen'["OVF" {
			&sql(select Classname, SOCClasses, TableName 
			     into   :oldClassname, :SOCClasses, :oldTableName 
			     from   %FileMan.MappedFilePackage 
			     where  --cast(FileNumber as varchar) = :filen and Package = :tPackage
			            FileNumber = :filen and Package = :tPackage
			)
			if SQLCODE=0,filen'["SoC" { 
				set previouslyMapped=1
				set Classname=oldClassname	// Reuse the same class
			}
			else {	// File mapping was not found
				s Classname=$$Classname($lg(tdata,1))
			}
		}
		else {
			s Classname=$$Classname($lg(tdata,1))
		}
		set %reuseClass=0
		if $$$retainClass {
			#;  We are REUSING a class.  Don't just delete it because that might remove any class/table items defined manually
			#;  in the class/table definition.  For example, methods/procedures, query-views, SQL privileges, etc.
			#;  I'll just call a Delete function that removes all properties, storage definitions, fkeys, etc.
			if $d(^oddDEF(Classname)),filen'["SoC",filen'["OVF" {
				$$$output2("Cleaning up old definition for class "_Classname,1,0)
				set mappedWithVersion=$$$defMemberKeyGet(Classname,$$$cCLASSparameter,"FM2CLASSVERSION",$$$cPARAMdefault)
				if +mappedWithVersion<1.18 { d ClassWipeOld^%fm2class4(Classname) s %reuseClass=1 }
				else { d ClassWipe^%fm2class4(Classname,filen) s %reuseClass=2 }
			}
			elseif $d(^oddDEF(Classname))&&(filen["Soc"||(filen["OVF")) {
				$$$output2("Deleting old definition for class "_Classname,1,0)
				Do Delete^%apiOBJ(Classname,$$$deleteQSpec)
				do DeleteBigTriggerRoutines(Classname)
			}
			if oldClassname'="",oldClassname'=Classname,$d(^oddDEF(oldClassname)),$$$AllButLastPiece($$$package,".")=$$$AllButLastPiece(oldClassname,".") {
				$$$output2("Deleting old definition for class "_oldClassname,1,0)
				Do Delete^%apiOBJ(oldClassname,$$$deleteQSpec)
				do DeleteBigTriggerRoutines(oldClassname)
			}
		}
		else {
			#;  We are OVERWRITING a class.  Just just delete it, 
			#;  and delete the old one too in case the name of the class is changing
			if $d(^oddDEF(Classname)) {
				$$$output2("Deleting old definition for class "_Classname,1,0)
				Do Delete^%apiOBJ(Classname,$$$deleteQSpec)
				do DeleteBigTriggerRoutines(Classname)
			}
			if oldClassname'="",oldClassname'=Classname,$d(^oddDEF(oldClassname)),$$$AllButLastPiece($$$package,".")=$$$AllButLastPiece(oldClassname,".") {
				$$$output2("Deleting old definition for class "_oldClassname,1,0)
				Do Delete^%apiOBJ(oldClassname,$$$deleteQSpec)
				do DeleteBigTriggerRoutines(oldClassname)
			}
		}
		if '%reuseClass,$d(^oddDEF(Classname)) {	// Should never happen, but doesn't hurt???
			$$$output2("Deleting old definition for class "_Classname,1,0)
			Do Delete^%apiOBJ(Classname,$$$deleteQSpec)
			do DeleteBigTriggerRoutines(Classname)
		}
.
		if previouslyMapped {
				#; Always delete classes defined for SET OF CODES fields.
				#; At this time we don't keep track to see if the SET OF CODE field will be created again or not.
			if $g(SOCClasses)'="" {
				for i=1:1:$ll(SOCClasses) {
					set SOCClass=$lg(SOCClasses,i)
					if $d(^oddDEF(SOCClass)) {
						$$$output2("Deleting old definition for class "_SOCClass,1,0)
						Do Delete^%apiOBJ(SOCClass,$$$deleteQSpec)
					}
				}
			}
				#; It has, so delete old link information
			if filen'["OVF" { 
				&sql(delete from %FileMan.MappedFilePackage where FileNumber = :filen and Package = :tPackage) 
				if SQLCODE<0 {
					$$$output2("ERROR deleting row from %FileMan.MappedFilePackage table",2,0)
					$$$output2("SQLCODE = "_SQLCODE_", %msg = "_$g(%msg),1,0) kill %msg
					goto makeError2
				}
			}
		}
		else {
				#; It had not previously been mapped (or MappedFile information is missing
				#; See if there is an old class given this tablename
			s oldClassname=$$LookUpClassName^%apiDDL2($$$package_$tr($lg(tdata,1),".",$c(2)))
		}
		
		$$$output2("Creating class "_Classname,1,0)
		s tableName=$lg(tdata)
		set tDateTime=$zdt($h)
		set tDesc=$lg(tdata,2)
		//set $p(tDesc,$$$NL,1)=$p(tDesc,$$$NL,1)_" on "_tDateTime	Don't add timestamp, causes source control difference issues for otherwise unchanged classes.
		s sc=$$CreateClass(Classname,tableName,tDesc,$lg(tdata,3),$lg(tdata,9),.class,$lg(tdata,10))
		If $$$ISERR(sc) $$$output2($$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()),0,0) goto makeError2
		s:compile compList(Classname)=""
		//d:$$$readonly||($lg(tdata,4)) MakeClassReadOnly(.parm,class)
		
		
		set %fmSequence=0
		if %reuseClass {
			set saveSequence=%fmSequence
			&sql(select max(SequenceNumber) into :%fmSequence from %Dictionary.ParameterDefinition where parent = :Classname)
			set:'%fmSequence %fmSequence=saveSequence
		}
		set fileName=$$getFileName^%fm2class(+filen)
		set sc=$$CreateParameter(1,.parm,class,Classname,"FILEMANFILENAME",fileName)
		if $$$ISERR(sc) $$$output2($$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()),0,0) goto makeError2
		set sc=$$CreateParameter(2,.parm,class,Classname,"FILEMANFILENUMBER",+filen)
		if $$$ISERR(sc) $$$output2($$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()),0,0) goto makeError2
		set sc=$$CreateParameter(3,.parm,class,Classname,"FM2CLASSVERSION",tVersionNum)
		if $$$ISERR(sc) $$$output2($$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()),0,0) goto makeError2
			#; Makey define the class as READONLY
		if $$$readonly||($lg(tdata,4)) {
			set sc=$$CreateParameter(4,.parm,class,Classname,"READONLY",1)
		if $$$ISERR(sc) $$$output2($$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()),0,0) goto makeError2
		}
		if $$$ClassParameters'="" {	// $$$ClassParameters should be a dynamic object
			set iter=$$$ClassParameters.%GetIterator()
			while iter.%GetNext(.parameter,.value) {
				set sc=$$CreateParameter(4,.parm,class,Classname,parameter,value)
				if $$$ISERR(sc) $$$output2($$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()),0,0) goto makeError2
			}
		}
		if 'previouslyMapped {
			s sc=$$CreateParameter(4,.parm,class,Classname,"DATECREATED",tDateTime)
			if $$$ISERR(sc) $$$output2($$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()),0,0) goto makeError2
		}
		
			#; Define the FileMan<->Class entry in the MappedFile table
		if filen'["SoC",filen'["OVF" {
			if '$g(^oddFMD(+filen))="" {
				&sql(insert into %FileMan.MappedFile (FileNumber, FileName)
					values (+:filen, :fileName))
				if SQLCODE<0 {
					$$$output2("ERROR inserting row into %FileMan.MappedFile table",2,0)
					$$$output2("SQLCODE = "_SQLCODE_", %msg = "_$g(%msg),1,0) kill %msg
					goto makeError2
				}
			}
			if '$d(^oddFMD(+filen)) {
				set ^oddFMD(+filen)=$lb(fileName)
			}
			&sql(insert into %FileMan.MappedFilePackage (FileNumber, Package, Classname, Tablename, MappedTimestamp, FM2ClassVersion)
				values (+:filen, :tPackage, :Classname, :tableName, CURRENT_TIMESTAMP, :tVersionNum))
			if SQLCODE<0 {
				$$$output2("ERROR inserting row into %FileMan.MappedFilePackage table",2,0)
				$$$output2("SQLCODE = "_SQLCODE_", %msg = "_$g(%msg),1,0) kill %msg
				goto makeError2
			}
		}
		elseif filen["SoC" {
			&sql(select ID, SOCClasses into :id, :SOCClasses FROM %FileMan.MappedFilePackage WHERE FileNumber = +:filen and Package = :tPackage)
			if SQLCODE=0 {
				set SOCClasses=$g(SOCClasses)_$lb(Classname)
				&sql(UPDATE %FileMan.MappedFilePackage Set SOCClasses = :SOCClasses WHERE ID = :id)
 				if SQLCODE<0 {
					$$$output2("ERROR updating row into %FileMan.MappedFilePackage table",2,0)
					$$$output2("SQLCODE = "_SQLCODE_", %msg = "_$g(%msg),1,0) kill %msg
					goto makeError2
				}
			}
		}
.
		
			#;  First determine Property names for relationship fields.  It is more important their names don't change.
			#;  If this does not work, might have to determine class and property names earlier.
		s f="" f  s f=$o(^IRIS.TempFM($j,filen,"f",f),1,fdata) q:f=""  i $lg(fdata,11)'="" s x=$$PropName(Classname,$lg(fdata,1))
		
		s index="" $$$output2(".",0,0)
		if %reuseClass,$d(^IRIS.TempFM($j,filen,"i")) {
			set saveSequence=%fmSequence
			&sql(select max(SequenceNumber) into :%fmSequence from %Dictionary.IndexDefinition where parent = :Classname)
			set:'%fmSequence %fmSequence=saveSequence
		}
		For ii=1:1 {
			s index=$o(^IRIS.TempFM($j,filen,"i",index),1,idata) q:index=""
			s fnames=$lg(idata,3)
			s pnames="" f i=1:1:$ll(fnames) s $p(pnames,",",i)=$$PropName(Classname,$lg(fnames,i))
			set iname=$lg(idata,1)
			s sc=$$CreateIndex(ii,.index,class,Classname,iname,$lg(idata,2),pnames)
			q:$$$ISERR(sc)
			set classIndices=classIndices_$lb(iname)
		}
		If $$$ISERR(sc) do cError(sc) continue
		
		s fkey="" $$$output2(".",0,0)
		if %reuseClass,$d(^IRIS.TempFM($j,filen,"fk")) { 
			set saveSequence=%fmSequence
			&sql(select max(SequenceNumber) into :%fmSequence from %Dictionary.ForeignKeyDefinition where parent = :Classname)
			set:'%fmSequence %fmSequence=saveSequence
		}
		For ii=1:1 {
			s fkey=$o(^IRIS.TempFM($j,filen,"fk",fkey),1,fkdata) q:fkey=""
			s fkObjName=$$FKeyName(Classname,fkey)
			s targClass=$$Classname($lg(fkdata))
			s pname=$$PropName(Classname,$lg(fkdata,2))
			s sc=$$CreateFKey(ii,.fkey,class,Classname,fkey,fkObjName,targClass,pname,$lg(fkdata,3),$lg(fkdata,4),+$lg(fkdata,5))
			q:$$$ISERR(sc)
			set classFKeys=classFKeys_$lb(fkObjName)
		}
		If $$$ISERR(sc) do cError(sc) continue
.
		s field="" $$$output2(".",0,0)
		if %reuseClass { 
			set saveSequence=%fmSequence
			&sql(select max(SequenceNumber) into :%fmSequence from %Dictionary.PropertyDefinition where parent = :Classname)
			set:'%fmSequence %fmSequence=saveSequence
		}
		For ii=1:1 {
			s field=$o(^IRIS.TempFM($j,filen,"f",field),1,fdata) q:field=""
			if 0,ii>2500 {
				$$$output2("Class has more than 2500 properties, too many fields for a single table, remaining fields skipped",1,3)
				q
			}
			s Property=$$PropName(Classname,$lg(fdata,1))
			s sc=$$CreateProperty(ii,.prop,class,Classname,Property,$lg(fdata,1),$lg(fdata,2),$lg(fdata,3),$lg(fdata,4),$lg(fdata,8),$lg(fdata,7),$lg(fdata,9),$lg(fdata,10),$lg(fdata,11),$lg(fdata,12),$lg(fdata,13),$lg(fdata,14),$lg(fdata,15),$lg(fdata,16),$lg(fdata,17),$lg(fdata,18),$lg(fdata,19),$lg(fdata,20),$lg(fdata,21),filen)	// DPV3008
			q:$$$ISERR(sc)
		}
		If $$$ISERR(sc) { do cError(sc) continue }
		Elseif ii>1500 {
			s sc=class.%Save() k prop
			If $$$ISERR(sc) do cError(sc) continue
		}
.
		s trig="" $$$output2(".",0,0)
		if %reuseClass,$d(^IRIS.TempFM($j,filen,"t")) { 
			set saveSequence=%fmSequence
			&sql(select max(SequenceNumber) into :%fmSequence from %Dictionary.TriggerDefinition where parent = :Classname)
			set:'%fmSequence %fmSequence=saveSequence
		}
		For ii=1:1 {
			s trig=$o(^IRIS.TempFM($j,filen,"t",trig),1,trgdata) q:trig=""
			s TriggerName=$$TrigName(Classname,trig)
			s sc=$$CreateTrigger(ii,.trig,class,Classname,TriggerName,trig,trgdata)
			if $$$ISERR(sc) $$$output2("WARNING:  Error creating trigger for table.  Table will not support filing.  Attempting to continue with class definition...",1,5)
			set classTriggers=classTriggers_$lb(TriggerName)
		}
		//If $$$ISERR(sc) do cError(sc) continue
.
		$$$output2(".",0,0)
		s sc=$$CreateStorageDefinition(class,.storage,$lg(tdata,10),Classname)
		If $$$ISERR(sc) do cError(sc) continue
.
		s map="" $$$output2(".",0,0)
		s iii=1,iv=1 For ii=1:1 {
			s map=$o(^IRIS.TempFM($j,filen,"m",map),1,mdata) q:map=""
			s mapname="",sc=$$CreateMap(ii,.storage,Classname,mdata,.maporef,.mapname)
			q:$$$ISERR(sc)
			set classMaps=classMaps_$lb(mapname)
			s ms=""
			For iii=iii:1 {
				s ms=$o(^IRIS.TempFM($j,filen,"m",map,"s",ms),1,msdata) q:ms=""
				s sc=$$CreateMapSubs(iii,.msoref,maporef(ii),ms,msdata,.msicoref)
				q:$$$ISERR(sc)
			}
			q:$$$ISERR(sc)
			s md=""
			For iv=iv:1 {
				s md=$o(^IRIS.TempFM($j,filen,"m",map,"d",md),1,mddata) q:md=""
				s sc=$$CreateMapData(iv,maporef(ii),md,mddata,.mdoref)
				if iv#1000=0 {
					s sc=class.%Save() 
					If $$$ISERR(sc) do cError(sc) continue
					k mdoref
				}
				q:$$$ISERR(sc)
			}
			q:$$$ISERR(sc)
			
		}
		If $$$ISERR(sc) do cError(sc) continue
.
		s sc=class.%Save() 
		If $$$ISERR(sc) do cError(sc) continue
.
		if filen'["SoC",filen'["OVF" {
			&sql(UPDATE %FileMan.MappedFilePackage (Indices,FKeys,Maps,Triggers) values (:classIndices, :classFKeys, :classMaps, :classTriggers) WHERE FileNumber = +:filen and Package = :tPackage)
			if SQLCODE {
				$$$output2("ERROR updating row in %FileMan.MappedFilePackage table",2,0)
				$$$output2("SQLCODE = "_SQLCODE_", %msg = "_$g(%msg),1,0) kill %msg
				goto makeError2
			}
		}
.
		kill %fm2cacheClassBuilding d RebuildItemIndex^%R(Classname,"CLS")
		k class,fkey,index,maporef,mdoref,msicoref,msoref,parm,prop,storage,trig
		$$$output2("Done",0,75)
		TCOMMIT
	}
	
	s t2=$zh-t1 $$$output1((cnt-1)_" classes created in "_$s(t2>60:(t2\60)_" minutes ",1:"")_(t2#60)_" seconds",1+($$$display=2),0)
	i $zu(115,10,zu11510val)
	i $zu(115,9,zu1159val)
	i $zu(115,1,autoCommitMode)
	If compile {
		d Compile(.compList,.%fm)
	}
	QUIT
.
makeError
	k class,fkey,index,maporef,mdoref,msicoref,msoref,parm,prop,storage,trig
	if $ZE["<INTERRUPT>" $$$output2("Utility interrupted by <Ctrl+C>, Class not created.",1,3) TROLLBACK 1 QUIT
	$$$output2("Unexpected Error encountered: $ZE="_$ze_"   Class not created!!!",1,3)
	if $ZE["<STORE>" $$$output2("Class is most likely too big to create",1,3)
makeError2
	TROLLBACK 1
	goto loop	// attempt next file
	
cError(sc)	
	k class,fkey,index,maporef,mdoref,msicoref,msoref,parm,prop,storage,trig
	TROLLBACK 1
	if sc=0 $$$output2("Continuing with next class...",1,5) QUIT
	do DecomposeStatus^%apiOBJ(sc,.errorlist)
	if '$g(errorlist) QUIT
	$$$output2(errorlist_" Errors encountered:",1,5)
	f i=1:1:errorlist $$$output2(errorlist(i),1,5)
	$$$output2("Continuing with next class...",1,5)
	k errorlist
	QUIT
}
.
DeleteBigTriggerRoutines(pClassname) [] PRIVATE {
		#; Delete any TI/TU routines from the BigTrigger logic for this class
	do DEL^%R(pClassname_".TI")
	do DEL^%R(pClassname_".TU")
	QUIT
}
	
CreateClass(Classname,TableName,Desc,Owner,SQLRowIdName,class,SqlRowIdPrivate=0) [] PUBLIC {
	if %reuseClass<1 {
		s class=##class(%Dictionary.ClassDefinition).%New()
		QUIT:$$$ISERR(class) class
	}
	else {
		s sc=$$$OK,class=##class(%Dictionary.ClassDefinition).%OpenId(Classname,,.sc)
		QUIT:$$$ISERR(sc) sc
		QUIT:$$$ISERR(class) class
	}
	s class.ClassType="persistent"
	s class.Description=Desc
	s class.Name=Classname
	s class.Owner=Owner
	s class.SqlRowIdName=SQLRowIdName
	s class.SqlTableName=TableName
	s:'%reuseClass class.Super="%Library.Persistent"
	if $$$superClasses'="" {	// Assume at this point class.Super has at least %Library.Persistent
		s super=$zstrip(class.Super,"*W"),$$$superClasses=$zstrip($$$superClasses,"*W")
		f i=1:1:$l($$$superClasses,",") i (","_super_",")'[(","_$p($$$superClasses,",",i)_",") s super=super_","_$p($$$superClasses,",",i)
		set class.Super=super
	}
	s class.StorageStrategy="SQLStorage"
	s:'%reuseClass class.TimeCreated=$zu(188)
	s class.TimeChanged=$zu(188)
	set:SqlRowIdPrivate class.SqlRowIdPrivate=1
	QUIT $$$OK
}
 
 
MakeClassReadOnly(parm,class) [] PUBLIC {
	s parm=##class(%Dictionary.ParameterDefinition).%New()
	QUIT:$$$ISERR(parm) parm
	s parm.parent=class
	s parm.Name="READONLY"
	s parm.Default=1
	QUIT 1
}
 
.
CreateParameter(ii,&parm,class,Classname,name,default) [] PUBLIC {
	if '$$$defMemberDefined(Classname,$$$cCLASSparameter,name) {	// parameter not defined, create a new one
		set parm(ii)=##class(%Dictionary.ParameterDefinition).%New()
		QUIT:$$$ISERR(parm(ii)) parm(ii)
	} else {                                                       // parameter is defined, update it
		set parm(ii)=##class(%Dictionary.ParameterDefinition).%OpenId(Classname_"||"_name,,.sc)
		QUIT:$$$ISERR(parm(ii)) sc
	}
		// Setting parent="" then to class is a kludge for ProdLog 145651 ***
	set parm(ii).parent="",parm(ii).parent=class
	set parm(ii).Name=name
	set parm(ii).Default=default
	set parm(ii).SequenceNumber=$i(%fmSequence)
	QUIT 1
}
.
CreateProperty(ii,prop,class,Classname,Property,SQLFieldName,Desc,Type,Required,Calculated,SQLComputed,SQLComputeCode,SQLComputeOnChange,Relationship,Cardinality,Inverse,Parameters,SQLColumnNumber,IsAReference=0,InitialExpression="",Collection="",ReadOnly=0,FMFieldNumber,FMFieldName,filen) 
	[filen,FMFieldNumber,FMFieldName,Property,SQLFieldName,Type,%ROWID,%ROWCOUNT,SQLCODE,tPackage] PUBLIC {	// DPV3008
	n %ROWID,%ROWCOUNT,SQLCODE
	s prop(ii)=##class(%Dictionary.PropertyDefinition).%New()
	QUIT:$$$ISERR(prop(ii)) prop(ii)
	s prop(ii).Name=Property
	s prop(ii).parent=class
	i Desc'="" s prop(ii).Description=Desc
	i Required s prop(ii).Required=Required
	i SQLColumnNumber s prop(ii).SqlColumnNumber=SQLColumnNumber
	i SQLComputed {
		s prop(ii).SqlComputed=1
		For i=1:1:$ll(SQLComputeCode) { s $p(ComputeCode,$c(13,10),i)=$c(9)_$lg(SQLComputeCode,i) }
		s prop(ii).SqlComputeCode=ComputeCode
		i $g(SQLComputeOnChange)'="" { f i=1:1:$ll(SQLComputeOnChange) s $li(SQLComputeOnChange,i)=$$PropName(Classname,$li(SQLComputeOnChange,i)) }
		s prop(ii).SqlComputeOnChange=$zlts(SQLComputeOnChange)
	}
	s prop(ii).SqlFieldName=SQLFieldName
	i Calculated { s prop(ii).Calculated=Calculated }
	s sType=$p(Type,"(")  If IsAReference s sType=$$Classname(sType)
	s prop(ii).Type=sType
	if Calculated,SQLComputed,$g($$$ComputedAlwaysJSONINCLUDE)'="" { set Parameters=Parameters_$lb($lb("%JSONINCLUDE",$$$ComputedAlwaysJSONINCLUDE))}
	i Parameters'="" { For i=1:1:$ll(Parameters) { Do prop(ii).Parameters.SetAt($lg($lg(Parameters,i),2),$lg($lg(Parameters,i),1)) } }
	i Relationship {
		s prop(ii).Relationship=1
		s prop(ii).Inverse=$$PropName(sType,Inverse)
		s prop(ii).Cardinality=Cardinality
	}
	i Collection'="" s prop(ii).Collection=Collection,prop(ii).SqlListType="SUBNODE"
	s:InitialExpression'=""&&('$$$readonly) prop(ii).InitialExpression=InitialExpression
	s:ReadOnly prop(ii).ReadOnly=1
	s prop(ii).SequenceNumber=$i(%fmSequence)
	if filen'["SoC" {
		//w !,filen,?20,FMFieldNumber,?40,FMFieldName,?70,SQLFieldName
		//if SQLFieldName="" b  
		if 'FMFieldNumber set FMFieldNumber=$i(^oddFMD(+filen,"p",tPackage,"f"),-1),FMFieldName=SQLFieldName
			#; Already have %FileMan.MapedFile (parent) row locked
		&sql(insert %NOLOCK into %FileMan.MappedField (MappedFilePackage, FieldNumber, FMFieldName, PropertyName, SqlFieldName, Datatype)
		values (+:filen || '||' || :tPackage, :FMFieldNumber, :FMFieldName, :Property, :SQLFieldName, :Type))
		if SQLCODE<0 {
			$$$output2("ERROR inserting row into %FileMan.MappedField table",2,0)
			$$$output2("SQLCODE = "_SQLCODE_", %msg = "_$g(%msg),1,0) kill %msg
		}
	}
	QUIT 1
}
 
 
CreateIndex(ii,index,class,Classname,name,type,properties) [] PUBLIC {
	s index(ii)=##class(%Dictionary.IndexDefinition).%New()
	QUIT:$$$ISERR(index(ii)) index
	s index(ii).parent=class
	s index(ii).Name=name
	If $$$UPPER(type)="IDKEY" s index(ii).IdKey=1,index(ii).Unique=1,index(ii).PrimaryKey=1
	If $$$UPPER(type)="UNIQUE" set index(ii).Unique=1
	s index(ii).Properties=properties
	s index(ii).SequenceNumber=$i(%fmSequence)
	QUIT 1
}
 
 
CreateFKey(ii,fkey,class,Classname,name,objName,targClass,property,desc,targKey="",noCheck=0) [] PUBLIC {
	s fkey(ii)=##class(%Dictionary.ForeignKeyDefinition).%New()
	QUIT:$$$ISERR(fkey(ii)) fkey(ii)
	s fkey(ii).parent=class
	s fkey(ii).Name=objName
	s fkey(ii).SqlName=name
	s fkey(ii).ReferencedClass=targClass
	s fkey(ii).Properties=property
	s fkey(ii).Description=desc
	set:targKey'="" fkey(ii).ReferencedKey=targKey
	set:noCheck fkey(ii).NoCheck=1
	s fkey(ii).SequenceNumber=$i(%fmSequence)
	QUIT $$$OK
}
 
CreateTrigger(ii,trig,class,Classname,name,SQLName,data) [comerr,comperr] PUBLIC {
	new comerr,comperr
	s trig(ii)=##class(%Dictionary.TriggerDefinition).%New(),status=1
	QUIT:$$$ISERR(trig(ii)) trig(ii)
	s trig(ii).Name=name
	s trig(ii).parent=class
	s trig(ii).Event=$lg(data,1)
	s trig(ii).Time=$lg(data,2)
	s trig(ii).Order=$lg(data,3)
	s trig(ii).SqlName=SQLName
	i $lg(data,4)'="" s trig(ii).Description=$lg(data,4)
	s code=$lg(data,5)
	For i=1:1:$ll(code) {
		i $lg(code,i)["^IRIS.TempFMI($j,""trig""," {
			//s ref=$e($lg(code,i),1,$l($lg(code,i))-1)
			s ref=$lg(code,i)
			s rtn=$$$nameTableRoutinePrefixGet(Classname)_$e($lg(data,1)) // .TI or .TU routine
			k ^rMAC(rtn),^ROUTINE(rtn),^rOBJ(rtn),^rINDEX(rtn,"MAC"),^rINDEX(rtn,"INT"),^rINDEX(rtn,"BAS"),^rINDEX(rtn,"OBJ")
			s $p(TrigCode,$c(13,10),i)=$c(9)_"Do ^"_rtn_"  // Trigger overflow routine"
			s c=0,l="" f j=1:1 s l=$o(@ref@(l),1,d) q:l=""  s ^rMAC(rtn,0,j)=d,c=c+$l(d)
			s tim=$zutil(188)
			s ^rMAC(rtn,0,j)=$c(9)_"QUIT",^rMAC(rtn,0)=tim,^rMAC(rtn,0,0)=j
			s ^rINDEX(rtn,"MAC")=$lb($$$TimeToODBC(tim),c+5)
			s comperr="comerr",@comperr@(0)=0
			d ^%qarmac(rtn,"","","",0,comperr,"","","","","","")
			If @comperr@(0) {
				s status=0,SQLCODE=-400,%msg="There are ("_(@comperr@(0)\2)_") syntax errors in ("_rtn_")"
				f i=1:1:@comperr@(0) $$$output2(@comperr@(1),1,5)
				QUIT
			}
			continue
		}
		s $p(TrigCode,$c(13,10),i)=$c(9)_$lg(code,i) 
	}
	if 'status QUIT $$$ERROR($$$GeneralError,%msg)
	s trig(ii).Code=TrigCode
	s trig(ii).SequenceNumber=$i(%fmSequence)
	QUIT $$$OK
}
 
 
CreateStorageDefinition(class,storage,SqlIdExpression="",Classname) [Classname,SQLCODE,storage] PUBLIC {
	new SQLCODE,%ROWCOUNT,%ROWID,%msg
	if %reuseClass<2 {
		s storage=##class(%Dictionary.StorageDefinition).%New()
		QUIT:$$$ISERR(storage) storage
	}
	else {
		&sql(select Name into :storage from %Dictionary.StorageDefinition where Name = 'SQLStorage' and parent = :Classname)        // Name of Storage created by mapper is always SQLStorage
		if SQLCODE=100 {
			s storage=##class(%Dictionary.StorageDefinition).%New()
			QUIT:$$$ISERR(storage) storage
		}
		elseif SQLCODE<0 {
			$$$output2("ERROR:  Cannot retrieve existing Storage Definition name from class: "_Classname_".",1,0) $$$output2("SQLCODE = "_SQLCODE,1,4) $$$output2("%msg = "_$g(%msg),1,4) QUIT 0
		}
		set sc=$$$OK,storage=##class(%Dictionary.StorageDefinition).%OpenId(Classname_"||"_storage,,.sc)
		QUIT:$$$ISERR(sc) sc
		QUIT:$$$ISERR(storage) storage
		set storage.parent=""
	}
	s storage.parent=class
	s storage.Name="SQLStorage"
	s storage.Type="%Storage.SQL"
	s storage.Description="SQLStorage defined by FM2Class mapper"
	s:SqlIdExpression'=""&&('$$$readonly) storage.SqlIdExpression=SqlIdExpression
	QUIT $$$OK
}
 
 
CreateMap(ii,class,Classname,data,maporef,mapname) [Classname,ii,mapname,maporef,SQLCODE] PUBLIC {
	new SQLCODE,%ROWCOUNT,%ROWID,%msg
	s mapname=$tr($lg(data,1)," !""#$%&'()*+-./:;<=>@[\]^_`{|}~?","")
	s:$e(mapname)?1n mapname="Z"_mapname
	if %reuseClass<2 {
		s maporef(ii)=##class(%Dictionary.StorageSQLMapDefinition).%New()
		QUIT:$$$ISERR(maporef(ii)) maporef(ii)
	}
	else {
		&sql(select %ID into :maporef(ii) from %Dictionary.StorageSQLMapDefinition where parent->parent = :Classname and Name = :mapname)
		if SQLCODE=100 {
			s maporef(ii)=##class(%Dictionary.StorageSQLMapDefinition).%New()
			QUIT:$$$ISERR(maporef(ii)) maporef(ii)
		}
		elseif SQLCODE<0 {
			$$$output2("ERROR:  Cannot retrieve existing Storage SQL Map Definition name from class: "_Classname_".",1,0) $$$output2("SQLCODE = "_SQLCODE,1,4) $$$output2("%msg = "_$g(%msg),1,4) QUIT 0
		}
		else {
			s sc=$$$OK,maporef(ii)=##class(%Dictionary.StorageSQLMapDefinition).%OpenId(maporef(ii),,.sc)
			QUIT:$$$ISERR(sc) sc
			QUIT:$$$ISERR(maporef(ii)) maporef(ii)
		}
	}
	s maporef(ii).parent=class
	s maporef(ii).Name=mapname
	s maporef(ii).Global=$lg(data,2)
	If $lg(data,3)="Y" s maporef(ii).Type="data"
	If $lg(data,3)="N" {
		s maporef(ii).Type="index"
		if $lg(data,4)="" {
			s maporef(ii).PopulationType="nonnull"
		}
		else {
			s maporef(ii).PopulationType=$lg(data,4)
			s maporef(ii).Condition=$lg(data,5)
			s maporef(ii).ConditionalWithHostVars=1
		}
	}
	if $lg(data,6)'="" b  
	QUIT $$$OK
}
 
 
CreateMapSubs(ii,msoref,map,ilev,data,msicoref) [] PUBLIC {
	s msoref(ii)=##class(%Dictionary.StorageSQLMapSubDefinition).%New()
	QUIT:$$$ISERR(msoref(ii)) msoref(ii)
	s msoref(ii).parent=map
	s msoref(ii).Name=ilev
	set tablename=msoref(ii).parent.parent.parent.SqlTableName
	set subscript=$lg(data,2)
	if $$$AllButLastPiece(subscript,".")=("{"_tablename) set subscript="{"_$$$LastPiece(subscript,".")
	s msoref(ii).Expression=subscript
	set:$lg(data,5)'="" msoref(ii).AccessType=$lg(data,5)
	set:$lg(data,6)'="" msoref(ii).Delimiter=$lg(data,6)
	s nextcode=$lg(data,4),NextCode=""
	For i=1:1:$ll(nextcode) { s $p(NextCode,$c(13,10),i)=$c(9)_$lg(nextcode,i) }
	i NextCode'="" s msoref(ii).NextCode=NextCode
	If $lg(data,3)'="" {
		#;  Create Invalid Subscript Conditions
		s invcond=$lg(data,3)
		For i=1:1:$ll(invcond) s sc=$$CreateMapSubsInvCond(msoref(ii),$lg(invcond,i),i,.msicoref) q:$$$ISERR(sc)
		QUIT:$$$ISERR(sc) sc
	}
	QUIT $$$OK
}
 
 
CreateMapSubsInvCond(mapsubs,cond,lev,msicoref) [] PUBLIC {
	s msicoref($i(msicoref))=##class(%Dictionary.StorageSQLMapSubInvalidconditionDefinition).%New()
	QUIT:$$$ISERR(msicoref(msicoref)) msicoref(msicoref)
	s msicoref(msicoref).parent=mapsubs
	s msicoref(msicoref).Name=lev
	s msicoref(msicoref).Expression=cond
	QUIT $$$OK
}
 
 
CreateMapData(ii,map,ilev,data,mdoref) [] PUBLIC {
	s mdoref(ii)=##class(%Dictionary.StorageSQLMapDataDefinition).%New()
	QUIT:$$$ISERR(mdoref(ii)) mdoref(ii)
	s mdoref(ii).parent=map
	s mdoref(ii).Name=$lg(data,1)
	s:$lg(data,2)'="" mdoref(ii).Node=$lg(data,2)
	s:$lg(data,3)'="" mdoref(ii).Piece=$lg(data,3)
	s:$lg(data,4)'="" mdoref(ii).Delimiter=$lg(data,4)
	s retcode=$lg(data,5),RetCode=""
	For i=1:1:$ll(retcode) { s $p(RetCode,$c(13,10),i)=$c(9)_$lg(retcode,i) }
	i RetCode'="" s mdoref(ii).RetrievalCode=RetCode
	QUIT $$$OK
}
 
 
Classname(TableName,pAddPackage) [] PUBLIC {
	If $d(^IRIS.TempFMI($j,"table",$$$UPPER(TableName)),d) QUIT $lg(d)	// Class already indexed
	s classname=$e($$$normalize(TableName),1,$$$maxShortClassnameLength) QUIT:classname="" ""
	set classname=$$$package_classname	// Add the package
		#;  If Table already Queued, just return the name
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(classname)),d) {
		If $$$UPPER($lg(d,2))=$$$UPPER(TableName) QUIT $lg(d) 	// Already found
		f i=48:1:57,65:1:90,97:1:122 s $e(classname,$l(classname))=$c(i) i '$d(^IRIS.TempFMI($j,"class",$$$UPPER(classname))) q
	}
		#; OK, we think we found the classname we want to use, make sure it is not in use by an already existing class
	if 0,$d($$$defClassRaw($$$package_classname)) {
		for i=48:1:57,65:1:90,97:1:122 {
			set $e(classname,$l(classname))=$c(i)	// Change last character of classname
			if '$d(^IRIS.TempFMI($j,"class",$$$UPPER(classname))),'$d($$$defClassRaw($$$package_classname)) quit  // Does not exist and is not already queued
		}
	}
	
	s ^IRIS.TempFMI($j,"class",$$$UPPER(classname))=$lb(classname,TableName)
	s ^IRIS.TempFMI($j,"table",$$$UPPER(TableName))=$lb(classname,TableName)
	QUIT classname
}
 
 
PropName(Classname,FieldName) [] PUBLIC {
	s propname=$e($$$normalize(FieldName),1,$$$nameLength) QUIT:propname="" ""
		#;  If Field already Queued, just return the name
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"f",$$$UPPER(FieldName)),d) { QUIT $lg(d,2) }
		#;  Field not Queued, but propname already used, find a new propname
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"p",$$$UPPER(propname)),d) {
		f i=1:1 s $e(propname,$l(propname)-$l(i)+1,$l(propname))=i q:'$d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"p",$$$UPPER(propname)))
	}
	s ^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"p",$$$UPPER(propname))=$lb(Classname,propname,FieldName)
	s ^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"f",$$$UPPER(FieldName))=$lb(Classname,propname,FieldName)
	QUIT propname
}
 
 
TrigName(Classname,TrigName) [] PUBLIC {
	s tname=$e($$$normalize(TrigName),1,$$$nameLength) QUIT:tname="" ""
		#;  If Trigger already Queued, just return the name
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"ts",$$$UPPER(TrigName)),d) { QUIT $lg(d,2) }
		#;  Trigger not Queued, but tname already used, find a new tname
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"to",$$$UPPER(tname)),d) {
		f i=1:1 s $e(tname,$l(tname)-$l(i)+1,$l(tname))=i q:'$d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"to",$$$UPPER(tname)))
	}
	s ^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"to",$$$UPPER(tname))=$lb(Classname,tname,TrigName)
	s ^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"ts",$$$UPPER(TrigName))=$lb(Classname,tname,TrigName)
	QUIT tname
}
 
FKeyName(Classname,FKeyName) [] PUBLIC {
	s fkeyname=$e($$$normalize(FKeyName),1,$$$nameLength) QUIT:fkeyname="" ""
		#;  If Fkey already Queued, just return the name
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"fks",$$$UPPER(FKeyName)),d) { QUIT $lg(d,2) }
		#;  FKey not Queued, but fkeyname already used, find a new fkeyname
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"fko",$$$UPPER(fkeyname)),d) {
		f i=1:1 s $e(fkeyname,$l(fkeyname)-$l(i)+1,$l(fkeyname))=i q:'$d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"fko",$$$UPPER(fkeyname)))
	}
	s ^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"fko",$$$UPPER(fkeyname))=$lb(Classname,fkeyname,FKeyName)
	s ^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"fks",$$$UPPER(FKeyName))=$lb(Classname,fkeyname,FKeyName)
	QUIT fkeyname
}
 
.
Compile(compList,%fm) [] PUBLIC {
.
	s $zt="CompError"
 
	s bigtime=$zh,starttime=bigtime
	$$$output1("Compiling classes...",2+($$$display=2),0)
	
	k classlist
	s class=""
	
	f  { s class=$o(compList(class)) q:class=""  d:'$d(compiled(class)) compit }
	$$$output1("Compilation of classes is complete! ",1+($$$display=2),0)
	
	Quit
                 
                 
 
compit	;
		#; Get a list of related classes for this class
	Do BuildClassList(class,.classlist)
		#; Remove the already compiled classes from this list
	s i="" f  s i=$o(classlist(i)) q:i=""  i $d(compiled(i)) k classlist(i)
		#; Count how many will be compiled in this group
	s cnt=0,i="" f  { s i=$o(classlist(i)) q:i=""  s cnt=cnt+1 }
	If cnt>0 {
		s time1=$zh
		if $$$display {
			$$$output3("Compiling "_cnt_" class"_$s(cnt>1:"es",1:"")_":",2,0)
			s i="" f  { s i=$o(classlist(i)) q:i=""  $$$output3(i,1,4) }
		}
		elseif $$$display=2 {	// Write this to the screen only
			w !,"Compiling class "_class_$s(cnt>1:" and "_cnt_" related classes",1:"")
		}
			#; Compile the group of classes
		m classlist2=classlist  // CompileList will delete entries from classlist
		k errorlog
		d CompileList^%apiOBJ(.classlist,$$$compileQSpec,.errorlog)
		if $g(errorlog) {
			$$$output2("Errors encountered during compilation of classes",2,0)
			for i=1:1:errorlog $$$output2(errorlog(i),1,0)
		}
			#; Mark this list as being compiled
		m compiled=classlist2 k classlist,classlist2
		s time1=$zh-time1 $$$output2("Elapsed time: "_$s(time1>60:(time1\60)_" minutes ",1:"")_(time1#60)_" seconds",1,0)
		i $d(bigtime) s bigtime=$zh-starttime $$$output2("Overall Elapsed Time so far: "_$s(bigtime>60:(bigtime\60)_" minutes ",1:"")_(bigtime#60)_" seconds",1,0)
	}
	q
	
BuildClassList(class,classlist)
		#; classlist is an array passed by reference
	s classlist(class)="" Do GetRelatedClasses(class)
	QUIT
 
GetRelatedClasses(class)
		#; classlist and compiled are arrays global-in-scope to this procedure
	s p="",package=$$$AllButLastPiece(class,".")
	f  {
	        s p=$o(^oddDEF(class,"a",p)) q:p=""  
	        s type=^oddDEF(class,"a",p,5)
	        if $e(type)'="%",'$d(classlist(type)),'$d(compiled(type)) s classlist(type)="" d GetRelatedClasses(type)
	}
	Quit
.
CompError	;
	b  
}
.
	// Convert old ^oddFMD structure from version 2.12 and earlier to the new structure for 2.13 and higher.
	// Beginning with 2.13, we support mapping files to more than one package at once.
ConvertoddFMD()	[] PUBLIC {
		// We store the version of FM2Class that was last run in the root node of ^oddFMD
		// We only began storing this in v2.13 and up, so if it is not there, we may need to convert
	QUIT:$g(^oddFMD)'=""
	QUIT:'$d(^oddFMD)
	set filen=""
	for {
		set filen=$o(^oddFMD(filen),1,tData) quit:filen=""
		continue:tData=""||($ll(tData)<2)
		set tPackage=$$$AllButLastPiece($lg(tData,2),".")
		if tPackage="" { $$$output2("*** Invalid ^oddFMD entry found for file '"_$lg(tData)_"' ***",1,0) continue  }
		set ^oddFMD(filen,"p",tPackage)=$li(tData,2,9)_$lb($$GetVersion^%fm2class())
		set ^oddFMD(filen)=$lb($li(tData))
		set ^oddFMI("Cls",$lg(tData,2),filen,tPackage)=""
		merge ^oddFMD(filen,"p",tPackage,"f")=^oddFMD(filen,"FIELDS")
		kill ^oddFMD(filen,"FIELDS")
	}
}
 
 
quoter(x,QuoteNumbers) PUBLIC { Quit $select(('$get(QuoteNumbers))||(x'=+x):$select(x=$char(0):"$c(0)",1:$zu(144,1,x)),1:""""_x_"""") }
.
quoter2(x,extraquote) PUBLIC { Quit $select(($zname($e(x))||($e(x)="_"))&&($zname($tr("%"_$e(x,2,$l(x)),"_@#$")))&&('($p($g(^%qSQL("reservewords",$zcvt(x,"U"))),$c(1),2)="Y")):x,x=$c(0):"$c(0)",x=+x:""""_x_"""",$g(extraquote):$$quoter3($zu(144,1,x)),1:$zu(144,1,x)) }
.
quoter3(x) PRIVATE { Quit """"_$zu(144,1,$extract(x,2,$l(x)-1))_"""" }
