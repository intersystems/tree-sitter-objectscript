====
apiISQL5
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%apiISQL5^MAC^^^0
%apiISQL5
  Quit
 
 #include %occInclude
 #include %apiXSQL
 #include %callout
 
 // use transformer 't' to transform source in stream 's' using 'settings',
 // - executegen="" .. just transform
 // - executegen="C" .. transform and compile
 // - executegen="X" .. transform, compile and execute
 //
 // if executegen="C" or "X" and the generated code begins with "ClassMethod"
 // a method is created, otherwise the code is written to macrtname - and to
 // intrtname too if executegen="X".
 //
 // may set macrtname and intrtname
 //
 // outcome is a local array for which one or more of these subscripts will be set :-
 //  HARDERROR, NOGENCODE, GENCODE, COMPILEERRORS
 //  - or anything set by things we call
 //
 // returns status
DoTransform(t,s,settings,executegen,SPInfo,macrtname,intrtname,outcome) PUBLIC {
	
	Set sc=$$GenerateCode(t, s, settings, SPInfo, .gencode, .procs, .outcome)
	If $$$ISERR(sc) {Quit sc}
	
	Do gencode.Rewind()
	Set anygencode='gencode.AtEnd
 
	// if there is no generated code ..
	If 'anygencode {
		Quit $$$OK
	}
	
	// if there's generated code and we're to compile and/or execute it ..
	If anygencode,executegen'="" {
		
		// do the compilation and/or execution
		Kill sarr
		Do ##class(%XSQL.Settings).LoadSettings(settings,.sarr)
		If $Data(sarr("UL")) {Set underline=sarr("UL")}
		ElseIf $Data(sarr("UNDERLINE")) {Set underline=sarr("UNDERLINE")}
		Else {Set underline=""}	
		
		// create required procedures
		Kill requiredclasses
		Set sc=$$CreateProcs($List(SPInfo),procs,underline,.requiredclasses)
		If $$$ISERR(sc) {Quit sc}
		
		// write method or write/compile/run routine
		Set sc=$$WriteSPMethod("ISQL",underline,SPInfo,gencode,.primaryclassname,settings,executegen="X",.macrtname,.intrtname,.outcome)
		If $$$ISERR(sc) {Quit sc}
		
		// if it was a method ..
		If $Data(primaryclassname) {
			Set primaryclasses(primaryclassname)=""
			Set sc=##class(%XSQL.Compile).CompileClasses(.primaryclasses,.requiredclasses,.outcome)
			If $$$ISERR(sc) {Quit sc}
		}
	}	
	
	Quit $$$OK
}
 
 
 // see if the generated code stream (from the current position to its end)
 // is a valid class method :-
 // - if true: return 1 and set classname, methodname, formals, returntype; writing code to implstream
 // - if false: return 0 (output parameters not well defined)
 // either way the stream position is not well defined on exit
StreamIsMethod(genstream,classname,methodname,formals,returntype,implstream) PRIVATE {
	
	// set up lexer
	Set lexer=##class(%ISQL.SimpleStreamLexer).%New(genstream)
	
	// see if first token is "ClassMethod"
	Set token=lexer.GetAndCrossCurrentToken()
	If $ZCVT(token,"U")'="CLASSMETHOD" {Quit 0}
	
	// get full name
	Set token=lexer.GetAndCrossCurrentToken() If token="" {Quit 0}
	Set fullname=token
	While 1 {
		Set token=lexer.GetCurrentToken() If token="" {Quit}
		If token'="." {Quit}
		Do lexer.CrossCurrentToken()
		Set fullname=fullname_token
		Set token=lexer.GetAndCrossCurrentToken() If token="" {Quit}
		Set fullname=fullname_token
	}
	If token="" {Quit 0}
	
	Do ##class(%XSQL.Dictionary).ParseQualifiedName(fullname,"",.classname,.methodname)
 
	// get formals
	Set token=lexer.GetAndCrossCurrentToken() If token'="(" {Quit 0}
	Set formals="",parencount=+1
	For f=1:1 {
		Set formal=""
		While 1 {
			Set token=lexer.GetAndCrossCurrentToken() If token="" {Quit}
			If token="," {Quit}
			If token="(" {Set parencount=parencount+1}
			ElseIf token=")" {Set parencount=parencount-1}
			If parencount=0 {Quit}
			If formal'="" Set formal=formal_" "
			Set formal=formal_token
		}
		If formal'="" {Set $Piece(formals,",",f)=formal}
		If (token="") || (parencount=0) {Quit}
	}
	If token="" {Quit 0}
	
	// get returntype
	Set returntype=""
	Set token=lexer.GetCurrentToken()
	If $ZCVT(token,"U")="AS" {
		Do lexer.CrossCurrentToken()
		Set parencount=0
		While 1 {
			Set token=lexer.GetCurrentToken() If token="" {Quit}
			If token="[" {Quit}
			Set returntype=returntype_token
			Do lexer.CrossCurrentToken()
		}
	}
	If token="" {Quit 0}
	
	// skip "[...]"
	Set token=lexer.GetAndCrossCurrentToken() If token'="[" {Quit 0}
	Do {
		Set token=lexer.GetAndCrossCurrentToken()
	} While token'="", token'="]"
	If token="" {Quit 0}
 
	// get "{"
	Set token=lexer.GetAndCrossCurrentToken() If token'="{" {Quit 0}
 
	// get implementation
	Do implstream.Rewind()
	Do {
		Set line=genstream.ReadLine()
		If line="}" {Quit}
		Do implstream.WriteLine(line)
	} While 1
 
	Quit 1
}
 
 
 
 // create required procedures as given one-per-line in the stream parameter
 // caller passes underline setting in underline
 // writes a list of classes to the array parameter (doesn't pre-kill it)
CreateProcs(defaultclass,procsstream,underline,classes) PUBLIC {
	Quit ##class(%XSQL.Dictionary).CreateProcs("ISQL",defaultclass,procsstream,underline,.classes)
}
 
 
 // show generated MAC code
 //AC@@@@ use line delimiter instead
ShowGen(gencode) PRIVATE {
	Set towrite=""
	Set lf=$Char(10)
	While 'gencode.AtEnd {
		Set towrite=towrite_gencode.Read(32767)
		While (towrite[lf) || ((towrite'="")&&(gencode.AtEnd)) {
			Do Log^%apiISQL($Piece(towrite,lf))
			Set towrite=$Piece(towrite,lf,2,$Length(towrite,lf))
		}
	}
}
 
 
 
 // generate code
 //
 // t - pass as %ISQL.Transformer object
 // s - pass as source code stream
 // settings - pass as settings string
 // SPInfo - pass as $ListBuild(classname,methodname)
 // gencode - returned as generated code stream
 // procs - returned as required procedures stream
 //
 // returns status and outcome
GenerateCode(t, s, settings, SPInfo, gencode, procs, outcome) PUBLIC {
	
	// reset locals
	Kill %xsqlrtnnumber,%isqltablenumber,%isqlctcu
	
	// initial defaults
	Kill macrtname,intrtname
	
	Set gencode=##class(%Library.GlobalCharacterStream).%New()
	Set procs=##class(%Library.GlobalCharacterStream).%New()
	Set errors=##class(%Library.GlobalCharacterStream).%New()
	Set errors.LineTerminator=$Char(10)
	Set ret=t.Transform(s,gencode,procs,errors,settings,SPInfo)
	
	// if the call to Transform failed ..
	If 'ret {
		Do ##class(%XSQL.Reporting).Stats("HARDERROR") Set outcome("HARDERROR")=""
		Set m="Error talking to DLL (DLLResultCode="_t.DLLResultCode_")"
		Do Log^%apiISQL(m)
		Quit $$$ERROR($$$GeneralError, m)
	}
	
	// return with suitable status if there were any syntax errors
	Set sc=##class(%XSQL.DLLInterfaceUtil).ErrorsToStatus($$$ERRORCODE($$$ISQLCompilationError),errors,s)
	If $$$ISERR(sc) {
		Do ##class(%XSQL.Reporting).Stats("COMPILEERRORS") Set outcome("COMPILEERRORS")=""
		Quit sc
	}
	
	Do gencode.Rewind()
	Set anygencode='gencode.AtEnd
	
	// if there is no generated code ..
	If 'anygencode {
		Do ##class(%XSQL.Reporting).Stats("NOGENCODE") Set outcome("NOGENCODE")=""
		Quit $$$OK
	}
	
	Do ##class(%XSQL.Reporting).Stats("GENCODE") Set outcome("GENCODE")=""
	Do Log^%apiISQL("Generated code :-")
	Do ShowGen(gencode)
	Do Log^%apiISQL("")
	Do Log^%apiISQL("")
	
	Quit $$$OK
}
 
 
 // add or replace a single method in a class, creating the class if necessary
 // - OR write a temporary routine
 //
 // underline - the UNDERLINE/UL setting
 // SPInfo - pass $ListBuild(classname, methodname)
 // gencode - pass generated code stream as returned from %ISQL.Transformer.Transform
 // primaryclassname - returned with the translated class name (method only)
 // settings - pass settings string (non-method only)
 // runit - pass boolean: run generated code (non-method only)
 // macrtname - returned with the .MAC name (non-method only)
 // intrtname - may be returned with the .INT name (non-method only)
 //
 // returns status and outcome
WriteSPMethod(App,underline, SPInfo, gencode, primaryclassname, settings, runit, macrtname, intrtname, outcome) PUBLIC {	
	
	// if we're to create a method ..
	//AC@@@@@ move this logic into the DLL by returning header + body separately
	Do gencode.Rewind()
	Set gencode.LineTerminator=$Char(10)
	Set implstream=##class(%GlobalCharacterStream).%New()
	If $$StreamIsMethod(gencode,.rawclassname,.rawmethodname,.methodformals,.methodreturntype,implstream) {
 
		Set primaryclassname=$Translate(rawclassname,"_",".")
		
		Set methodname=$Translate(rawmethodname,"_",underline)
		Set methodsqlname=rawmethodname
		
		// if the class doesn't exist ..
		If '##class(%Dictionary.ClassDefinition).%ExistsId(primaryclassname) {
			
			// create it
			Set sc=##class(%XSQL.Dictionary).CreateClass(primaryclassname, App_" Stored Procedures")
			If $$$ISERR(sc) {
				Do ReportError^%apiISQL2(sc,"Error saving method "_me.SqlName_" as "_me.Name_" in class "_cl.Name,.outcome)
				Quit sc
			}				
 
			Set classisnew=1
		}
		Else {
			
			// fetch it
			Set cl=##class(%Dictionary.ClassDefinition).%OpenId(primaryclassname)
			Set classisnew=0
			
			// remove the method if it exists
			Do ##class(%XSQL.Dictionary).DeleteMethod(cl, methodname)
		}
		
		// remove the SP if it already exists
		Set sc=##class(%XSQL.Dictionary).RemoveSPIfNecessary(cl, primaryclassname, methodsqlname)
		If $$$ISERR(sc) {
			Do ReportError^%apiISQL2(sc,"Error removing SP "_primaryclassname_"."_methodsqlname,.outcome)
			Quit sc
		}				
 
		// add the method			
		Set me=##class(%Dictionary.MethodDefinition).%New(primaryclassname_"."_methodname)
		Do cl.Methods.Insert(me)
		Set me.Name=methodname
		Set me.SqlName=methodsqlname
		Set me.ClassMethod=1
		Set me.Description=App_" Stored Procedure"
		Set me.FormalSpec=methodformals
		Set me.ReturnType=$Piece(methodreturntype,"(") // parameters apparently not allowed here
		Set me.PublicList="SQLCODE"
		Set me.SqlProc=1
		Set me.CodeMode="code"
		Set me.Implementation=implstream
		
		// save the method
		Set sc=me.%Save()
		If $$$ISERR(sc) {
			Do ReportError^%apiISQL2(sc,"Error saving method "_me.SqlName_" as "_me.Name_" in class "_cl.Name,.outcome)
			Quit sc
		}				
		Kill me
	
		Set sc=cl.%Save()
		If $$$ISERR(sc) {
			Do ReportError^%apiISQL2(sc,"Error saving class "_cl.Name,.outcome)
			Quit sc
		}				
		Kill cl
	}
	
	// .. not a method ..
	Else {
 
		// purge temporary routines for this job number
		Do ##class(%XSQL.Compile).PurgeTempRoutines(App)
		
		// allocate temporary routine
		Set temprt=##class(%XSQL.Compile).TempRtName(App)
		
		Do Log^%apiISQL("Compiling generated code to ^"_temprt_" ..")
		
		// build routine  
		Do ##class(%XSQL.Compile).BuildMacRt(temprt, gencode, " ; Generated by ShellTransform^%api"_App_"5")
		
		Set macrtname=temprt
		
		// compile routine
		Kill messages
		Set ret=##class(%XSQL.Compile).CompileMac(temprt, .messages)
		For i=1:1:$Get(messages(0)) Do Log^%apiISQL(messages(i))
		
		// if the compilation failed ..
		If ret'="" {
			Do ##class(%XSQL.Reporting).Stats("MACCOMPILEFAILED") Set outcome("MACCOMPILEFAILED")=""
			Set objlasterror=$List(ret, 2)
			If $$$ISERR(objlasterror) {
				Do ReportError^%apiISQL2(objlasterror,"MAC compilation failed")
			}
			Else {
				Do Log^%apiISQL("MAC compilation failed (no status)")
			}
			Quit objlasterror
		}
		
		Set intrtname=temprt
		
		// if we're to run it ..
		If runit {
		
			// GENRAW is incompatible with execution
			If ##class(%XSQL.Settings).InSettings(settings,"GR,GENRAW") {
				Do Log^%apiISQL("Settings preclude execution ("_settings_")")
			}
			Else {
				
				// invoke routine
				Do ##class(%XSQL.Reporting).Stats("RUNROUTINE") Set outcome("RUNROUTINE")=""
				Do Log^%apiISQL("Running ^"_temprt)
				Set SQLCODE=0
				Set sc=##class(%XSQL.Compile).RunMac(temprt)
			
				// if the run failed ..
				If $$$ISERR(sc) {
					Do ##class(%XSQL.Reporting).Stats("RUNFAILED")
					Do ReportError^%apiISQL2(sc,"Running "_temprt_" failed")
					Quit sc
				}
				Else {
					Do ##class(%XSQL.Reporting).Stats("RUNOK")
				}			
			}
		}
	}
	
	Quit $$$OK
}
