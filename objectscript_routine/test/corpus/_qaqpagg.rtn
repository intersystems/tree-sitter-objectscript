====
qaqpagg
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpagg^MAC^^^0
%qaqpagg	// (post join - part of %qaqpag)  (Aviel 5/19/87)
	;; COMPONENTS :: SQL/PathSpecification
	#;
#INCLUDE %msql
#INCLUDE %sqlEngineObjs
#INCLUDE %sySite
#INCLUDE %BigData.ShardingManager // JMM1152=
#IF 0   ;-------------------------------------------------------------
	; Description:   Generate ASL for post-join processing
	; Author:        Aviel Klausner
	; Date:          May 19, 1987
	;
	;  AK1042  (05/21/2021) - Fix shordit() logic when aggregates found
	;  AK850   (11/30/2020) - Implement lateral join
	;  MRP1246 (03/12/2021) - Fix HAVING processing in one-pass group optimization for non-conforming SQL Statements
	;  AK1033  (12/03/2020) - Expression evaluation when reading aggregates
	;  AK1037  (01/28/2021) - Use %SOMEVALUE(field) for 'opg' optimization
	;  AK1035  (12/03/2020) - Remove deleted modules from mt("once")
	;  AK1033  (12/03/2020) - Expression evaluation when reading aggregates
	;  AK1021  (08/05/2020) - Compute streamless expressions on the master
	;  AK1025  (09/15/2020) - Parallel for "precount" queries
	;  AK1020  (07/10/2020) - Apply TOP before QML batch file
	;  AK1011  (10/29/2019) - Don't apply AK705 minmax to GROUP BY field
	;  AK1007  (08/21/2019) - Distributed DML filing on parallel servers
	;  AK1004  (08/12/2019) - Enable %PARALLEL for INSERT/UPDATE/DELETE
	;  AK997   (04/12/2019) - Adjust "opg" optimization for OUTER JOIN
	;  AK988   (10/29/2018) - One-pass GROUP BY with no temp-files
	;  AK990   (10/31/2018) - Correct "empty" UNION leg for AK971 viewID
	;  AK985   (09/04/2018) - Use mt("shrows",m) to force use of "rows"
	;  AK983   (08/30/2018) - Reconstruct WHERE after FROM in parag
	;  AK978   (04/13/2018) - Implement AGG(DISTINCT f) for sharding
	;  AK977   (03/26/2018) - Fix mt("shtop") for AK960 added subqueries
	;  AK971   (10/17/2017) - View row identifiers for sharded outer join
	;  AK970   (10/10/2017) - Do not evaluate subqueries sent to shards
	;  AK967   (07/28/2017) - Shard master conditions NULL analysis for OJ
	;  AK932   (05/28/2015) - GENQ: Produce "?" for outer correlated fields
	;  AK966   (07/18/2017) - Sharded ORDER BY cannot list aggs explicitly
	;  AK960   (03/28/2017) - Add SELECT subqueries to sharded SELECT-list
	;  AK965   (06/22/2017) - Fix ORDER BY for reconstructed sharded queries
	;  HSU200  (05/25/2017) - auto-hinting for %PARALLEL
	;  AK939   (09/10/2015) - Sharded outer joins
	;  MRP856  (09/25/2015) - Fix 'SELECT TOP n ...' for certain query conditions
	;  AK938   (07/29/2015) - Sharded joins
	;  AK936   (07/07/2015) - Use hybrid local->global GROUP+aggs temp-file
	;  AK924   (03/16/2015) - Query processing for SQL sharding
	;  AK907   (04/29/2014) - Use $$SplitSize() for %PARALLEL partitioning
	;  AK887   (01/27/2015) - (TRW) aggmaps-based plans for SUM/COUNT with WHERE clause
	;  AK844   (01/03/2012) - Use reduced DISTINCT temp-file with HAVING
	;  PVA304  (04/23/2014) - Support %PARTITION BY for use by parallel work units
	;  AK902   (02/21/2014) - Parallel GROUP BY partitioned by FROM
	;  AK841   (12/21/2011) - Use extended local arrays for some temp-files
	;  AK894   (11/06/2013) - Fix TOP condition with aggregates
	;  AK900   (12/26/2013) - Parallel aggregates by range
	;  AK884   (08/05/2013) - Fix TOP for %VID
	;  AK875   (02/26/2013) - Record q# in "build" ACTION for TOP
	;  AK853   (03/27/2012) - Apply TOP condition as subscript-limiting
	;  AK864   (09/05/2012) - Fix MAX/MIN of a streamless argument
	;  AK692   (02/23/2010) - Skip 'opex' for JSV joined fields
	;  AK739   (06/18/2009) - ASL for TOP/ORDER BY in subqueries
	;  AK735   (05/11/2009) - Apply loop suppression to streamed views
	;  AK734   (05/05/2009) - Fix "subvloc" information for TOP conditions
	;  AK705   (06/19/2008) - Optimize MAX/MIN using loop suppression
	;  AK687   (12/11/2007) - Disable TOP optimization for IS13 if DISTINCT
	;  AK679   (05/03/2007) - Fix field list for TOP condition on subquery
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  AK666   (12/20/2006) - Correct streamed view field locations
	;  DPV2546 (11/08/2005) - Implement new MVR collation function.  Change collation implementations to use $zu(28)
	;  JLF047  (08/11/2005)   Fixed SELECT DISTINCT TOP ... ORDER BY
	;  AK629   (08/03/2005) - Various DESC fixes
	;  JLF046  (07/18/2005) - Fix subquery that's both "empty" and "onerow"
	;  AK618   (01/27/2005) - Ignore NULLable keys for DISTINCT
	;  AK610   (09/27/2004) - Restrict sort-file size when TOP used
	;  AK615   (11/19/2004) - Single temp-file for GROUP BY and aggregates
	;  AK600   (05/25/2004) - Fixes to loop suppression code generation
	;  AK609   (09/21/2004) - Fix ORDER BY ID DESC when BSL used
	;  DPV2294 (09/22/2004) - Fix DPV2267 by calling derange rather than just setting "d"
	;                         SQL Fix ProdLog 38944:   problem with descending
	;  DPV2267 (08/19/2004) - Fix another ORDER BY DESC returning wrong results problem
	;                         SQL Fix ProdLog 38337 - ASC does not work correctly
	;  DPV2185 (03/02/2004) - SQL Fix ProdLog 35898: an <UNDEFINED>derange+1^%qaqpagg error
	;                         Fix <UNDEFINED> error originally fixed by DPV2063 but lost by AK576
	;  AK576   (12/23/2003) - Don't loop below DISTINCT fields
	;  DPV2063 (08/21/2003) - Fix <UNDEFINED> caused by DPV2055
	;  DPV2055 (08/05/2003) - Fix ORDER BY DESC over set of values
	;  DPV1969 (03/27/2003) - Remove $$descord call
	;  AK539   (10/17/2002) - Use $BITCOUNT for COUNT(*) on BSL
	;  AK538   (10/16/2002) - Fix DESCending on subscript with %STARTSWITH
	;  DPV1765 (07/12/2002) - Fix one last problem with ORDER BY DESC, RC, and a new sort needed
	;  DPV1691 (03/25/2002) - Fix problem with DPV1632 with DESC and no RC
	;  AK510   (02/28/2002) - Use extent bitmap for unrestricted COUNT(*),f
	;  AK509   (02/28/2002) - Use $BITCOUNT for COUNT(*)
	;  DPV1632 (12/13/2001) - ORDER BY Fixes with queries generating READ_COMMITTED code
	;  AK500   (12/12/2001) - SHD: Fix HAVING and "onerow" case
	;  AK492   (10/05/2001) - SHD: Apply DISTINCT/GROUP BY within UNION
	;  DPV1397 (09/15/2000) - Fix long asl(...,"fields") nodes
	;  AK446   (05/31/2000) - View stream processing
	;  AK414   (12/09/1999) - Brazil: Subquery aggregates return one row
	;  AK394   (09/17/1999) - Generate $SORT* for temp files
	;  AK353   (02/01/1999) - UNION of SELECT
	;  AK345   (12/31/1998) - Nicer $C(0) (SQL empty string) in $$quoter
	;  AK317  (05/29/98) - Korea:  Optimize GROUP BY
	;  MRP628 (07/22/96) - Optimize ORDER BY Code Generation
	;  MRP580 (03/18/96) - Support SQL92 SUBSTRING Function
	;  MRP574 (02/10/96) - Use proper Sorting Order (DESC) for Joined 
	;                      Queries
	;  DPV152 (01/31/94) - Fix <SUBSCRIPT> error in startw1
	;  RLL382 (11/29/93) - swap subscript start and stop values when
	;                      doing descending sort
	;  AK009;AK031;AK069;RGG029;AK106;AK112;AK126;IS035;AK166;AK181
	;  AK183;AK187;ALL003;ALL001;AK190;RGG625;AK214
	;
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	s bvals=""  ;  AK1033
	n maxs s maxs=$$$mtRNumStreams  ;  AK939
	s (bhav,ahav)=""  ;  AK069  ;  AK106+
	#; If new subquery (m)-dependent variables are added before invoking $$parag, the visParallel
	#; m-swapping code there must also be updated. -TRW
	s selst=$$$mtOutputVals($g($$$mtOutput(m))),sldst=$g($$$mtGroupDistinctList(m))  ;  AK106-  ;  AK112  ;  AK183 ; ALL001
	f ext=1:1:$o($$$mtOutputOverflow(m,""),-1) s selst(ext)=$$$mtOutputOverflow(m,ext)  ;  AK069  ;  AK183  ; ALL003
	d ahavbhav(m, .ahav, .bhav)
	s list=","
	#; AK446
	#;  skip DISTINCT/GROUP BY for non-virtual subqueries and their unions
	#; AK492
	n dodist s dodist=$g($$$mtUnionTopQb(m),m) i dodist'=1,'$$$mtPViewIDVal($$$mtP(dodist)) s sldst=""
	#;  note that by groupm+2^qo, there is no need to reset sldst=selst
	#; AK492-
	#; AK446-
	s nstmd=mod  ;  for levag - nest all 1st-level aggs under this module
	d modata  ;  start from subquery's MAIN, record info for all modules
	#; AK414
	n onerow s onerow=$g($$$mtOneRow(m))
	#;  if onerow, no need for dist/sort/read (*** also if having?)
	If onerow {
		Kill:outtype $$$aslAct(mod,1)
		#; In the PVA066 AggMap case, we've already created the module
		#; for the aggregation in bsl^%qaqpmod
		#; TODO: Could I skip the nest in the bsl construction and do it here.
		If 'objAlg.Join(joi, str).HasAggMap() && ('$g($$$mtQbUsesCdmag(m))) && ('$g($$$mtQbUsesCdmp(m))) && ('$g(mt("colisalg",m)))  Do nest(mod,1)
		Set sldst="",files="onerow,"
		d modata  ;  recalculate for nest above
	}
	#; Handle the PVA066 aggregate maps
	If objAlg.Join(joi, str).HasAggMap() {
		New objMod, objMask
		Set objMod = objAsl.Mod(mod)
		Set mod = $$aggMaps(objAlg.Join(joi, str), objMod)
		#; Calculate any expressions in the output in the
		#; module which will acquire the output action.
		Do expr(objMt.Query(m).Output().Vals())
		Quit
	}
	#; AK414-
	#; AK509
	#;  optimize COUNT(*) to use $BITCOUNT (*** also if having?)
	i onerow,$l(selst,",")=2,selst=bhav,ahav="",'$g($$$mtHaving(m)),"a^count^,^^^^"[$$$mtV(+selst) s sub=$$hsub() i sub s $$$aslAct(mod,1)="a"_V_V_+selst_V_"bitcount"_V_$p(sub,V,10) d read QUIT
	#; AK509-
	#; AK576
	#;  collect mod/subscript info to optimize DISTINCT
	#; AK610
	n is13,bmod
	#; IS13 typically builds a sort file, but occasionally not in the BSL case (isalg7), and
	#; never one in the BSL case we are comfortable using for TOP optimization.
	s is13=($p(alg(joi),"^",14)="IS13")&&($p(alg(joi),"^",15)'="isalg7")&&(+alg(joi)'=3)  ;  outtype 2=>0
	#; AK610-
	d:m=1 iutf  ;  set mt("iutf",1)=1 if a circular/Halloween INSERT or UPDATE
	#; AK900
	#;  if one level of aggregates (bhav), no GROUP, then try in parallel
	n c2s
	s ord=$tr($g($$$mtSequencersQb(m)),"d")
	#; AK938
	i $g(mt("shtop",m)) { d confirmShardSupport() }
	i $g(mt("shtop",m))=m { d shard() RETURN:$$$mtShard(m)="aggs" }
	#;HSU278+
	#;we use "parallelbyauto" to note that we enable %PARALLEL by decideParallel(), not by the hint %PARALLEL manually. 
	if $$decideParallel(){ s:'$$tryParallel(m) $$$mtParallelByAuto(m)=1 set mt("hint",m,"%PARALLEL") = 1 }
	#;HSU301+ couldParallel examines there exists any constraint would block the %PARALLEL, so far the known one is the expresion:%RMLSP Collation
	i $$tryParallel(m),'$$couldParallel { 
		s mt("hint",m,"%NOPARALLEL")=1
	}    
	#;HSU301-
	Quit:(('$$tryParallel(m)) && $g($$$mtQbUsesCdmag(m)))
	New vtreeList  Set vtreeList = $$vtreeList(m) // an unordered list of all the vector opeartions in this query block
.
	#;HSU278-
	#; AK938-
	i onerow,ahav="",bhav'["^",$$tryParallel(m),$$parag() {
		Do:$$$useAPE(m) APEfinishup(m)
		QUIT
	}
	#; AK900-
	#; AK902
	#;  if one level of aggregates (bhav), GROUP BY, then try in parallel
	i ahav="",bhav'["^",$$tryParallel(m) { 
		Quit:('$$parag() && $g($$$mtQbUsesCdmag(m)))
	}  ;  in 2014.2, keep:  ,sldst
	#; AK902-
	// This is where we populate a new asl module to read the shared global if used in parallel aggregation
	If $$$parAggUsesSharedGlobal(m) {
		Do read 
		Set $p($$$mtAPESharedGlobal(m),"^",6)=mod 
	}
	RETURN:$g($$$mtParafile(m))  ;  file on the parallel servers  ;  AK1007
	#;  "parag"+"precount" - just process the COUNT(*) normally  ;  AK1025
	i $g($$$mtParag(m))'="",$g(mt("precount",m)),bhav="" { s bhav=$$$mtPAggList($$$mtP(m)) }
	#;  use optimizer plan for GROUP BY+aggs without temp-files!  ;  AK988
	i sldst,bhav,bhav'["^",ahav="",$$gbags() { d onepass }  ;  RETURN here???
	#;  if DISTINCT, no aggregates, no HAVING, then maybe suppress looping
	#; AK705
	n windows s windows = $$windowsInSubq(m)
	i sldst,bhav="",ahav="",'windows d gnolup($$sublevs(sldst))
	i bhav,ahav="",$g($$$mtGroupDistinctList(m))||onerow,'windows d minmax
	#; AK705-
	#; AK576-
	#; AK610
	#;  IF there is ORDER BY, and outtype<>0, i.e. sort-file was built,
	#;      and it matches the ORDER BY, and if this sort-file has a 1-1
	#;      match to the actual output rows (i.e. no HAVING, DISTINCT, or
	#;      GROUP BY), and there are no aggregates (which would need all rows),
	#;  THEN apply the TOP row-limit optimization
	#;      *** deal with bitmap temp-file, in one of 2 ways
	#;  find module with BUILD, in (mod-1) if IS13, but ignore RC module!
	s bmod=mod
	s:$$$aslActAction($g($$$aslAct(bmod,1)))'="b" bmod=$g($$$asl0CorrectBuildNode(bmod),bmod)  ;  fix for AK1080  ;  DAB081
	s bmod=bmod-is13 s:$e($g($$$aslAct(bmod,1)))'="b" bmod=bmod-1
	i $$$aslActAction($g($$$aslAct(bmod,1)))="b",'$$$aslActTfToBuild($$$aslAct(bmod,1)) s $$$aslActTfToBuild($$$aslAct(bmod,1))=$$nutemp^%qaqpmod("temp^"_bmod_"^^1")
	d:$g($$$mtTopLimit(m)) toplast  ;  maybe repeat last TOP condition
	#; AK894
	i $g($$$mtTopArg(m)),'$g($$$mtTopLimit(m)),ord'="",ord=order,outtype||is13,'onerow,'sldst,'$$$mtPAggList($$$mtP(m)),'$g($$$mtHaving(m)),$$nowins() d topt
	i $g($$$mtTopLimit(m)) s $$$aslActUseLocalArrOrTopOptQbOrTopnVar($$$aslAct(bmod,1))=m,$$$aslActSort($$$aslAct(bmod,1))=0,$$$mtTopTempFile($$$mtTopLimit(m))=$$$aslActTfToBuild($$$aslAct(bmod,1))  ;  AK875
	#; AK853
	d:$g($$$mtTopLimit(m)) topstop  ;  maybe apply first top-condition as a stop-condition
	#; AK610-
	#;  If outtype, i.e. sort-file was built, and there are zero or one
	#;      levels of aggregates, DISTINCT, and no HAVING (and the
	#;      DISTINCT list does not contain any aggs!), then realign the
	#;      modules a bit, process DISTINCT here, and redo the smaller
	#;      sort-file (to include any expressions computed for DISTINCT)
	#;      But it must be nested, as not to affect any aggs calculation
	#; AK615
	n distf s distf=""  ;  remember temp-file#, for use in grouped aggregates
	#; JLF047
	if sldst,bhav'["^",outtype,$$gudhaving(),ahav="",$$noaggs(),$$nowins() {
		n tsldst s tsldst=sldst
		k $$$aslAct(mod,1) d nest(mod,1),distcond(.sldst,bhav="")
		#; If we are grouping by one  field and we are sorting by the same field the distinct group comes out in sort order
		#; so no need for any sort file. Disable if doing any pagination (TOP/LIMIT/FETCH or OFFSET) as we have no code generation for pagination on hybrid temp table currently
		if order=tsldst,'$p(tsldst,",",2),'onerow,'$$hasPagination^%qaqpsq(m) {
			do sort("",.vals,distf)
		} else {
			do sort(order,.vals,,$$$mtGroupDistinctList(m))
		}
		i $d($$$mtTopLimit(m)) {
			k $$$mtTempFile($$$mtTopTempFile($$$mtTopLimit(m)))	; remove the mt("tf",*) information about the obsolete temp file
			s $$$aslActUseLocalArrOrTopOptQbOrTopnVar($$$aslAct(mod,1))=m,$$$aslActSort($$$aslAct(mod,1))=0,$$$mtTopTempFile($$$mtTopLimit(m))=$$$aslActTfToBuild($$$aslAct(mod,1))  ;  AK875
		}
	}
	#; JLF047-
	#;  If there is exactly one level of BEFORE aggregates, DISTINCT, and
	#;      no HAVING (and the DISTINCT list does not contain any aggs!),
	#;		no shared global populated by workers in parallel aggregation
	#;		(this case is dealt with in finishWorkerASL),
	#;      then process DISTINCT here, before we build the temp-file!
	#;      But it must be nested, as not to affect the aggs calculation
	i sldst,bhav'["^",bhav'="",'outtype,$$gudhaving(),ahav="",$$noaggs(),$$nowins(),'$$$parAggUsesSharedGlobal(m) d nest(mod,$$npk(ACTION)),distcond(.sldst)
	i bhav="",outtype d read  ;  read the last temp-file  ;  AK106  ;  AK112  ;  AK190
	    ;  if no temp-file with all current data (AND B-H aggs) - make one
	#; Collect all "forward" window functions; these need to "see the future" and review all results before producing values
	#; Merge to avoid duplicates (possible in at least ORDER BY <ordinal> cases)
	n fwins s fwins=$$mergeCommaLists($$forwardWindows(selst),$$forwardWindows(ord))
	#; Collect all "backward" window functions; these can produce values as soon as the final pre-window row order is available
	n bwins s bwins=$$mergeCommaLists($$backwardWindows(selst),$$backwardWindows(ord))
	//TODO: One partitioning function instead of two filters
	n selstnowin s selstnowin = $$removeWindowDependentExprs(selst)
	#; We need to preserve any field or aggregate values needed to compute the expression
	#; in which a window function appears.
	#; some comment
	s selstnowin = $$mergeCommaLists(selstnowin,$$windowExprDeps(selst))
	s selstnowin = $$mergeCommaLists(selstnowin,$$windowExprDeps(ord))
	#; We also need any values for grouping/distinct
	s selstnowin = $$mergeCommaLists(selstnowin, $$windowExprDeps($g($$$mtGroupDistinctList(m))))
	if windows, $d($$$mtDistinct(m)) {
		s selstnowin = $$mergeCommaLists(selstnowin,$$removeWindowDependentExprs($g($$$mtGroupDistinctList(m))))
	}
	n selstwin s selstwin = $$removeNonWindowDependentExprs(selst)
	#; If we're DISTINCT on window functions (by way of SELECT DISTINCT, they can't appear in GROUP BY)
	#; then we need to preserve all GROUP BY values for the final DISTINCT after WF evaluation
	//if $d(mt("distinct",m)),$$windows($g($$$mtGroupDistinctList(m))) {
	//	s selstnowin = $$mergeCommaLists(selstnowin,$$removeWindowDependentExprs($g($$$mtGroupDistinctList(m))))
	//}
	n ordernowin s ordernowin = $$removeWindowDependentExprs(order)
	n ordwin s ordwin = $$removeNonWindowDependentExprs(ord)
	#; if we computed our window values in a queued parallel or shard query, no need to recompute
	i +$g(mt("queuedwins",m)) {
		#; still potentially need to "distinct" on wf values
		if $d($$$mtDistinct(m)) s sldst = sldst_selstwin
		s fwins="", bwins=""
		s selstnowin = selst
		s selstwin = ""
		s ordernowin = order
	}
	i bhav'="" {
		// No need to do aggregation operations in parent process if we use a shared global that is populated by workers in parallel aggregation
		If '$$$parAggUsesSharedGlobal(m) {
			d:'onerow&&'outtype sort(ordernowin,.vals,$s(order="":distf,1:"")) 
			f levi=$L(bhav,"^"):-1:1 s levag=$P(bhav,"^",levi) d levag
		}
	}
	#; AK615-
	MERGE mt("v")=c2s  ;  restore SUM->COUNT, so that it would init to 0  ;  AK902
	d:$g($$$mtHaving(m)) posky^%qaqpmod("cond",$$$mtHaving(m))  ;---------- HAVING ----------  ;  AK183  ;  ALL001
	#; AK317
	#;  If there is exactly one level of AFTER aggregates, DISTINCT,
	#;      (and the DISTINCT list does not contain any aggs!),
	#;      then process DISTINCT here, before we build the temp-file!
	#;      But it must be nested, as not to affect the aggs calculation
	i sldst,ahav'="",ahav'["^",$$noaggs(),$$nowins() d nest(mod,$$npk(ACTION)),distcond(.sldst,,1)
	#; AK317-
	i ahav'="" d sort(ordernowin,.vals) f levi=$L(ahav,"^"):-1:1 s levag=$P(ahav,"^",levi) d levag
	d qmlbtf^%qaqpmod("qml9")  ;  qmlb after TOP  ;  AK1020
	#;---------- SELECT:  evaluate expressions ----------
	If $$$useAPE(m){
		// Don't evaluate expressions in selstnowin that are also in selstcorrsubq or exprfound, as those expressions are computed on the workers
		New selstlist Set selstlist = ""
		New i
		For i=1:1 {
			Set val = $p(selstnowin,",",i) 
			Quit:val=""
			If ((","_$$$mtAPESelListCorrSubq(m)_$g($$$mtAPEWorkerOutputs(m))_",")'[(","_val_",")){
				Continue:$g(mt("colisalg",m))&&$lf(vtreeList,val)
				Set selstlist = selstlist_val_","
			}
		}
		Do expr(selstlist)
	}Else{
		Do expr(selstnowin)
	}
	#;---------- SELECT DISTINCT - main query only *** why?
	#; Do any non-window-function-dependent grouping. Can't do it yet for the `select distinct wf() over ...` case
	#; since we need to calculate the wf() first. This indeed breaks the current IRIS SQL non-standard "rule"
	#; that DISTINCT and GROUP BY are equivalent, by exploiting the mt("distinct") "breadcrumb" left by the
	#; DISTINCT -> GROUP BY transformation
	#; Exception: when we use a shared global populated by workers in parallel aggregation (this case is dealt with in finishWorkerASL)
	if sldst,'($d($$$mtDistinct(m))&&(selstwin||ordwin)),'$$$parAggUsesSharedGlobal(m) d distcond(sldst,,1)  ;  last resort, if wasn't processed already
	#; Forward-looking-window:
	#; Update their intermediate structures from the final post-agg/group, pre-window row stream
	d forwardWindowExpr(fwins)
	#;  create a new temp-file if:  (one is needed for DESCending) AND (none created after last join or in this program) OR (not fully sorted yet)  ;  AK190+
	#;  s ord=$TR($g($$$mtSequencers),"d") d:$O(asl(jmod,KEY))'=""!'outtype&($g($$$mtSequencers)["d")!(ord'=order) sort(ord,.selst),read  ;  AK069 ; ALL001
	#;---------- treat DESCending order ----------
	#;  s ord=$TR($g($$$mtSequencersQb(m)),"d")  ;  AK190=
	#; DPV1632
	#;  If this mod is for RC code, this actual next loop is at the previous mod
	#;  Set lmod in that case here and use lmod in desc and below
	n lmod
	If $d($$$asl5Root(mod)) {
		s lmod=$p($$$aslMod(mod),$c(1),2)
		For  q:'$d($$$asl5Root(lmod))  s lmod=$p($$$aslMod(lmod),$c(1),2)
		}
	Else { s lmod=mod }
	#; DPV1632-
	#; DPV1691
	n ordnowin s ordnowin = $$removeWindowDependentExprs(ord)
	i +$g(mt("queuedwins",m)) {
		s ordnowin = ord
	}
	n hadsort s hadsort = 0
	n needEvalSelWin s needEvalSelWin = 1
	i $$desc||(+fwins) { 
		#; note that $$desc can re-set ord to the ordered, "d"-entry version
		#; which is used below to identify desc looping in the sort file we're
		#; about to build.
		#; We need to preserve our "DISTINCT" list values for a 
		#; final distinct, if present 
		New finaldist Set finaldist=""
		If selstwin||ordwin,$d($$$mtDistinct(m)) { Set finaldist=sldst }
		if (ordnowin '= ord)||((+fwins)&&(selst[fwins)){
			// we need to reloop again to calculate forward window function in select list, since the order we populate winval 
			// might be different from the output order, and windowrowval often needs to be populated in the same order we get winval
			// SELECT Age, Gender, FavoriteNum, MIN ( FavoriteNum ) OVER ( PARTITION BY Age ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING ) Result FROM %NOPARALLEL Sample.Person ORDER BY Age, id (desc)
			// we need to put in ordnowin as well, otherwise, the next sort cannot find ordnowin
			d sort("",$$mergeCommaLists(selstnowin,ordnowin)), read
			d expr(selstwin)
			d sort($tr(ord,"d"),$$mergeCommaLists(selst,finaldist))
			s needEvalSelWin = 0
		} else {
			d sort($tr(ord,"d"),$$mergeCommaLists(selstnowin,finaldist))
		}
		d read
		s ord=$g($$$mtSequencersQb(m)),lmod=mod,hadsort=1
	}  ;  reset lmod  ;DPV1691;DPV1765
	#; MRP574 (Use proper Sorting Order (DESC) for Joined Queries)
	i ord["d" d  ; Mark Descending for Proper Module
	. n dmod,i,info,n,ns,ntry,order,pmod,tempid,tmod,val
	. s order=$p(ord,"d")
	. f i=$l(order):-1:1 q:$e(order,i)=","
	. s order=$e(order,1,i-1)
	. i order=""||(order["d") q  ; Don't process these
	. s tempid=$p($g($$$aslKId(mod,1)),$c(1),3)
	. q:tempid=""  ; Not a Temp File
	. s dmod=+tempid,ntry=+$p(tempid,"^",2)
	. s info=$g($$$aslActNode(dmod,1,ntry))
	. q:$$$aslActNodeUseRowCounterTempId(info)'="tid"  ; Not looping on a TempID so quit
	. s pmod=$p($g($$$aslMod(mod)),$c(1),2)  ; Parent mod# calling in a nest
	. q:'pmod  ; No Parent calling in a nest so quit
	. s n=""
	. f  s n=$o($$$aslPk(pmod,1,n)) q:'n  d  ; Check Temps
	.. s tmod=+$g($$$aslPkCallAnotherMod(pmod,1,n))
	.. q:'tmod  ; No Temporary Module to Check
	.. f i=1:1 s val=$p(ord,",",i) q:val=""  d:val["d"  ; Check 'next' Key Specs
	... s ns=""
	... f  s ns=$o($$$aslKNext(tmod,1,ns)) q:'ns  d  ; Check 'next' info
	.... s info=$g($$$aslKNext(tmod,1,ns))
	.... q:+val'=+info           ; Not the DESCENDING Column so quit
	.... q:$$$aslNextLoopingType(info)="u"  ; No Orering at this level so quit
	.... s $$$aslNextLoopingType($$$aslKNext(tmod,1,ns))="d"  ; Set to DESCENDING
	#; MRP574 (Use proper Sorting Order (DESC) for Joined Queries)-
	#; AK538
	f ns=1:1 s val=$P(ord,",",ns) q:val=""  d:val["d" derange(lmod,1,ns)
	s ord=$tr(ord,"d","")
	#; We now have the "final" row order (unless there are any wf's in the ORDER BY, in which case we evaluated WF's prior to descending logic)
	if ((+bwins)||(+fwins)),needEvalSelWin {
		#; Evaluate those in the select list, order by evaluated implicitly by sort
		do expr(selstwin)
	}
	if (m=1)&&($g($$$mtSequencers)'="")&&($d($$$mtIntersectExceptOnQb(1))) {
		d sort($tr($$$mtSequencers,"d"),selst), read
		f ns=1:1:$l($$$mtSequencers,",")-1 s:$p($$$mtSequencers,",",ns)["d" $$$aslNextLoopingType($$$aslKNext(mod,1,ns))="d"  ;  DESCENDING
	}
	#;---------- SELECT DISTINCT - main query only *** why?
	#; For window functions in the SELECT DISTINCT list, we need to "double distinct": First for the implied GROUP BY of ordinary
	#; SELECT DISTINCT items (or that could have been explicitly in GROUP BY), then for the post-GROUP BY, DISTINCT window
	#; function results (which could NOT have been explicitly in GROUP BY).
	if selstwin||ordwin,$d($$$mtDistinct(m)) d distcond(sldst_selstwin,,1)  ;  last resort, if wasn't processed already
	if $d($$$mtIntersectExceptDist(m)) d distcond($$$mtIntersectExceptDist(m),,1)
	Do:$$$useAPE(m) APEfinishup(m)
	#; AK902
	QUIT
	#; Wrap the "main" entry point for ^%qaqpagg to ensure modata is always recalculated
	#; after it returns, since current (and likely future) optimizations are inclined
	#; to QUIT early & may not remember to do this.
postjoin
	Do ^%qaqpagg
	Do modata^%qaqpagg
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
gbags()	;  $$: 1 if all aggregates have %FOREACH=GROUP BY (and no DISTINCT)  ;  AK988
	f ai=1:1:$l(bhav,",")-1 RETURN:$p($$$mtV($p(bhav,",",ai))_"^","^",6,7)'=(sldst_"^") 0
	RETURN 1
	
#;--- Windowing Functions /BEGIN
.
#; Recursively search for forward window functions in vals. Takes
#; and returns a "val,..." list 
forwardWindows(vals) [ call, fwins ] public {
	New call, fwins
	Set call = "lvHasForwardWindow^%qaqpagg"
	Set fwins = ""
	For i=1:1 {
		Set val = $p(vals,",",i) QUIT:val=""
		Do lviter^%qaqpnl("v",val)
	}
	RETURN fwins
}
.
#; Recursively search for backward window functions in vals. Takes
#; and returns a "val,..." list 
backwardWindows(vals) [ call, fwins ] public {
	New call, fwins
	Set call = "lvHasBackwardWindow^%qaqpagg"
	Set fwins = ""
	For i=1:1 {
		Set val = $p(vals,",",i) QUIT:val=""
		Do lviter^%qaqpnl("v",val)
	}
	RETURN fwins
}
.
#; Recursively search for all window functions in vals. Takes
#; and returns a "val,..." list 
windows(vals) [ call, wins ] public {
	New call, wins
	Set call = "lvHasWindow^%qaqpagg"
	Set wins = ""
	For i=1:1 {
		Set val = $p(vals,",",i) QUIT:val=""
		Do lviter^%qaqpnl("v",val)
	}
	RETURN wins
}
.
#; Returns a "val," list of forward window functions appearing in query block qn
forwardWindowsInSubq(qn) [ mt ] public {
	RETURN $$forwardWindows($$$mtOutputVals($g($$$mtOutput(qn))))_$$forwardWindows($tr($g($$$mtSequencersQb(qn)),"d"))
}
.
#; Returns a "val," list of all window functions appearing in query block qn
windowsInSubq(qn) [ mt ] public {
	RETURN $$windows($$$mtOutputVals($g($$$mtOutput(qn))))_$$windows($tr($g($$$mtSequencersQb(qn)),"d"))
}
.
#; lviter window search visitors
lvHasWindow
	If (type="v")&&(ev="v")&&$$isWindow(val) Set wins=wins_val_"," RETURN
	GOTO lviterarg^%qaqpnl
.
lvHasForwardWindow
	If (type="v")&&(ev="v")&&$$isForwardWindow(val) Set fwins=fwins_val_"," RETURN
	GOTO lviterarg^%qaqpnl
.
lvHasBackwardWindow
	If (type="v")&&(ev="v")&&($$isWindow(val))&&('$$isForwardWindow(val)) Set fwins=fwins_val_"," RETURN
	GOTO lviterarg^%qaqpnl
.
#; Evaluate the "forward" component of forward window functions by
#; wrapping the functions in a "FWD" operator wrapper and then evaluating these
#; via expr()
forwardWindowExpr(vlist) [ vals ] public {
	//We don't want to consider these expressions evaluated, so shadow vals and throw 
	//away whatever "apnd" adds to it.
	New vals Set vals = ""
	Set fwlist = ""
	For i=1:1 {
		Set v = $p(vlist,",",i) QUIT:v=""
		Set fwlist = fwlist _ $$wrapForwardWindowExpr(v) _ ","
	}
	Do:+fwlist expr(fwlist)
}
wrapForwardWindowExpr(v) [ mt ] public {
	Set fvals = $p($$$mtV(v),"^",3)
	RETURN $$$newval("v^%WINDOW_FUNCTION_FWD^"_fvals_"^"_v_"^")
}
.
#; returns true for (non-wrapped) window function values
isWindow(v) [ mt ] public {
	Set val = $$$mtV(v)
	If $e(val) '= "v" RETURN 0
	If $p($p(val,"^",2),":",1) '= "%WINDOW_FUNCTION" RETURN 0
	RETURN 1	
}
.
#; returns true for (non-wrapped) window function values which are "forward-looking":
#; They cannot produce a value until all (TODO: optimize for some windows) rows have
#; been observed
isForwardWindow(v) [ mt ] public {
	If '$$isWindow(v) RETURN 0
	Set val = $$$mtV(v)
	Set func = $p($p(val,"^",2),":",2)
	Set ord = $$windowOrder(v)
	#; TODO generalize to a class of functions
	#; TODO ord matches query order, good to go.
	If ord="",$lf($lb("LAG","ROW_NUMBER"),func) RETURN 0
	If ord="",(func = "FIRST_VALUE") RETURN:'$$windowFrameRows^%qaqcpr(v) 0  RETURN:$$windowFrameRows^%qaqcpr(v)&&($$windowFrameBegin^%qaqcpr(v)<=0)&&($$windowFrameBegin^%qaqcpr(v)'="<") 0 
	If ord="",(func = "LAST_VALUE") RETURN:$$windowFrameRows^%qaqcpr(v)&&($$windowFrameEnd^%qaqcpr(v)<=0)&&($$windowFrameEnd^%qaqcpr(v)'=">") 0 
	
	RETURN 1
}
.
#; returns the "order by" list (as "val1^val2^...") for the over clause of
#; window function
windowOrder(v) [ mt ] public {
	Set val = $$$mtV(v)
	Set ordv = $p(val,"^",5)
	Set ordval = $$$mtV(ordv)
	RETURN $p(ordval,"^",4,*)
}
.
#; Returns all field and aggregate values that are requried to evaluate the window
#; functions listed in vals (non-window functions are ignored). Accepts and outputs
#; "val," lists
windowExprDeps(vals) public {
	Set winExprs = $$removeNonWindowDependentExprs(vals)
	Set deps = ""
	For i=1:1 {
		Set winExpr = $p(winExprs,",",i) QUIT:winExpr=""
		Set found = $$listree("v",winExpr,"af")
		Set deps = $$mergeCommaLists(deps, found)
	}
	RETURN deps
}
.
#; Remove any values from the "vals," list that depend on the value of a window function
removeWindowDependentExprs(vals) public {
	Set outvals = ""
	For i=1:1 {
		Set val = $p(vals,",",i) QUIT:val=""
		If '+$$windows(val) Set outvals = outvals_val_","
	}
	Return outvals
}
.
#; Remove any values from the "vals," list that do NOT depend on the value of any
#; window function
removeNonWindowDependentExprs(vals) public {
	Set outvals = ""
	For i=1:1 {
		Set val = $p(vals,",",i) QUIT:val=""
		If +$$windows(val) Set outvals = outvals_val_","
	}
	Return outvals
}
.
#; returns true if a condition log can be applied at the partition level
#; of all window functions in the "val," list windows
condPartitionsWindows(log,windows) [ mt ] public {
	Set logval = $$$mtL(log)
	Set fields = $e($p(logval,"^",3),2,*)
	For i=1:1 {
		Set field = $p(fields,",",i) QUIT:field=""
		If '$$fieldPartitionsWindows(field,windows) RETURN 0
	}
	RETURN 1
}
.
#; returns true if the value of field determines a unique window partition for
#; all window functions in the "val," list windows
fieldPartitionsWindows(field,windows) public {
	For i=1:1 {
		Set window = $p(windows,",",i) QUIT:window=""
		If '$$fieldPartitionsWindow(field,window) RETURN 0
	}
	RETURN 1
}
.
#; returns true if the value of field determines a unique window partition for
#; the window function window.
fieldPartitionsWindow(field,window) [ mt ] public {
	Set wval = $$$mtV(window)
	Set part = $p(wval,"^",4)
	Set partval = $$$mtV(part)
	Set doesPartition = 0
	For i=4:1 {
		Set v=$p(partval,"^",i) QUIT:v=""
		If $$fieldDeterminesValue(field,v) Set doesPartition = 1 QUIT
	}
	RETURN doesPartition
}
.
#; Find the list of subqueries that are involved in vals and correlated with current query block m
#; Takes and returns a "val,..." list 
hasCorrelatedSubQ(vals)[call,found,mt,m] public {
	New call, found
	Set call = "lvHasCorrelatedSubQ^%qaqpagg"
	Set found = ""
	For i=1:1 {
		Set val = $p(vals,",",i) 
		Quit:val=""
		Do lviter^%qaqpnl("v",val)
	}
	Return found
}
.
lvHasCorrelatedSubQ
	If ev ="q",$g($$$mtCorrParentQb($p(v,"^",2)))=m, $p(v,"^",3)'=","{		
		Set found=found_$p(v,"^",2)_","
		Return 
	}
	Goto lviterarg^%qaqpnl
.
hasSharedAggregate(val) [call,found,shag] {
	New call, found
	Set call = "lvHasSharedAggregate^%qaqpagg", found = ""
	Do lviter^%qaqpnl("v",val)
	Return found
}
.
lvHasSharedAggregate
	If type ="v",$lf(shag,val){		
		Set found=found_val_","
		Return 
	}
	Goto lviterarg^%qaqpnl
.
#; Recursively search for experssions that envolves correlated subqueries in vals that are not dependent on shared aggregates  
#; Takes and returns a "val,..." list 
CorrelatedSubQExpr(vals) [mt,m,found,exprfound,call,shag,vtreeList] {
	New found,exprfound,call,shag
	Set shag = ""
	s found="",exprfound="",call="shsel^%qaqpagg"  ;  AK960
	f lv=1:1:$l(vals,",")-1 d lvtree^%qaqpnl("v",$p(vals,",",lv))
.
	Set outvals = ""
	For i=1:1 {
		Set val = $p(vals,",",i) 
		Quit:val=""
		If +$$hasCorrelatedSubQ(val),'+$$hasSharedAggregate(val) Set outvals = outvals_val_","
	}
	Return outvals
.
}
#; returns true if the value of fv can be demonstrated to determine
#; the value of v
fieldDeterminesValue(fv,v) [ mt,mts ] public {
	Set val = $$$mtV(v)
	//Only support fields vs fields for now
	If $e(val) '= "f" RETURN 0
	Set fval = $$$mtV(fv)
	If $e(fval) '= "f" RETURN 0
	//If they're the same field, of course...
	If fv = v RETURN 1
	//If v is collated, fv determines if it is uncollated or same collation
	Set vifn = $p(val,"^",3)
	Set vstr = $p(val,"^",2)
	Set vqb = $$$mtRQb($$$mtR(vstr))
	Set vcoll = $p(vifn,"_",2)
	If vcoll '= "" {
		Set fifn = $p(fval,"^",3)
		Set fstr = $p(fval,"^",2)
		Set fqb = $$$mtRQb($$$mtR(fstr))
		Set fcoll = $p(fifn,"_",2)
		If fcoll'="",fcoll'=vcoll RETURN 0
		RETURN $$fieldDeterminesValue($p(mts(fqb,fstr,"ATT",+fifn),"^",5),$p(mts(vqb,vstr,"ATT",+vifn),"^",5))
	}
	//Or if this field is a view field of the value
	Set vff = $$viewFieldToField(fv)
	If vff RETURN $$fieldDeterminesValue(vff,v)
	RETURN 0
}
.
#; translates a view field (including a potentially collated one)
#; into a corresponding field (including such collation) of the view,
#; if it exists, returning "" if not (e.g. if the view field refers to an expression)
viewFieldToField(vf) [ mt, mts ] public {
	Set vfval = $$$mtV(vf)
	//only fields
	RETURN:$e(vfval)'="f" ""
	Set vfstr = $p(vfval,"^",2)
	Set vqb = $g($$$mtRVirtual(vfstr))
	//only view fields
	RETURN:'vqb ""
	Set vfifn = $p(vfval,"^",3)
	Set vfcoll = $p(vfifn,"_",2)
	Set vfidx = vf
	Set vfqb = $$$mtRQb($$$mtR(vfstr))
	//get the uncollated view field to compare to vid
	If vfcoll '= "" Set vfidx = $p(mts(vfqb,vfstr,"ATT",+vfifn),"^",5)
	Set vid = $$$mtPViewIDVal($$$mtP(vqb))
	Set vqbo = $$$mtOutputVals($$$mtOutput(vqb))
	Set vv = $p(vqbo,",",vfidx - vid)
	Set fval = $$$mtV(vv)
	//only fields
	RETURN:$e(fval)'="f" ""
	Set fstr = $p(fval,"^",2)
	Set fifn = $p(fval,"^",3)
	Set fcoll = $p(fifn,"_",2)
	If vfcoll=fcoll RETURN vv
	//different collations, what to do?
	If vfcoll'="", fcoll'="" RETURN ""
	//find the collated field in the view
	Set vcoll = $p($g(mts(vqbo, fstr, "ATT", +fifn_"_"_vfcoll)),"^",5)
	RETURN:vcoll vcoll
	RETURN ""
}
.
#; returns true if the shard partitions for streams in the current query
#; also partition the values needed to evalute the window functions in the
#; "val," list of windows
shardPartitionsWindows(windows) [ mt ] public {
	For i=1:1 {
		Set window = $p(windows,",",i) QUIT:window=""
		If '$$shardPartitionsWindow(window) RETURN 0
	}
	RETURN 1
}
.
#; returns true if the shard partitions for streams in the current query
#; also partition the values needed to evalute the window function
shardPartitionsWindow(window) [ mt ] public {
	Set wval = $$$mtV(window)
	Set part = $p(wval,"^",4)
	Set partval = $$$mtV(part)
	Set parts = ""
	For i=4:1 {
		Set v=$p(partval,"^",i) QUIT:v=""
		Set parts = parts_v_","
	}
	RETURN $$validateShardGrp(parts)
}
.
#; Merges two "val," lists, eliminating duplicates
mergeCommaLists(list1,list2) public {
	Set out = list1
	For i=1:1 {
		Set item = $p(list2,",",i) QUIT:item=""
		If (","_out)'[(","_item_",") Set out = out_item_","
	}
	RETURN out
}
.
#;--- Windowing Functions /END
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
onepass()  ;  opg - in a single pass loop up to the gsub subscript to  ;  AK988
	#;  get all GROUP BY fields, and for each such set of values, calculate
	#;  any aggregates by looping on all subscripts below gsub and then
	#;  output one row (or not), all without using temp-files
	n gsub s gsub=$$sublevs(sldst)  ;  ordinal pos# within "sublev" (or 0)
	RETURN:'$$uniq(sldst,gsub)  ;  bad subscripts - must use temp-file
	// Don't use a shared global for parallelization if we are not using a temp-file
	k $$$mtAPESharedGlobal(m)
	n gmod,tloc,tmod,build s gmod=+$lg(mt("subloc",m),gsub),tloc=$lg(mt("subloc",m),gsub+1),tmod=+tloc
	s:tloc[".55" tmod=tmod-1  ;  start before view looping
	#;  gsub/gmod=0 if no looping required from GROUP BY fields
	#;  tmod=0 if Case C - no looping beyond gsub
	#;  if tmod is in the middle of OJ padded modules, use the top
	#;  padding mod, but if gsub is in the middle of padding, skip "opg"
	#;  *** should use proper code-gen for this case, instead of giving up!
	i tmod,$g($$$asl0TopCondModInPadRange(tmod)) { s tmod=$$$asl0TopCondModInPadRange(tmod) RETURN:$lf(mt("nmod",m),tmod)<=$lf(mt("nmod",m),gmod) }  ;  AK997
	#;  if 'build' already used, save it and add it at the end
	i $$$aslActAction($g($$$aslAct(mod,1)))="b" { MERGE build=$$$aslActRoot(mod) KILL $$$aslActRoot(mod) }
	d numod()  ;  generate module with all aggregate calculations
	#;  but ignore %FOREACH grouping to avoid avm processing, and
	#;  also add the aggregate results to the temp-file, if any
	f ai=1:1:$l(bhav,",")-1 s val=$P(bhav,",",ai) i (","_$P(bhav,",",1,ai))'[(","_val_",") { s v=$$$mtV(val),agdst=$P(v,"^",7),$P(v,"^",6)="" d agg(mod) s:$d(build) build(1,$o(build(1,""),-1)+1 )=V_val }
	#;  Also add to bhav %SOMEVALUE(f) of each loose field  ;  AK1037
	i tmod { n found s found=$listfromstring($e(sldst,1,*-1)) d loosef(m,.found)
		f ai=$l(sldst,","):1:$ll(found) s val=$li(found,ai),val=$$$newval("a^somevalue^,"_sldst_val_",^^"_val_"^^"),v=$$$mtV(val),agdst="",bhav=bhav_val_"," d agg(mod)
	}
	d nestm(,mod-1),preky^%qaqpmod(mod,"temp",mod-1)  ;  opg bottom module
	#;  restore the 'build' ACTION at the end, reconnect all loose ends
	i $d(build) { MERGE $$$aslActRoot(mod)=build s $p(files,",")=mod_"^1",$$$mtTfModNum($$$mtTempFile($$$aslActTfToBuild($$$aslAct(mod,1))))=mod }
	s $$$asl0OnePassGroupBy(mod)=bhav_"^^"_mod_"^bot"
	s:'tmod tmod=mod  ;  case C - use "agone"
	s $$$asl0OnePassGroupBy(tmod)=bhav_"^"_$s(gmod'=tmod:"top",1:$p(tloc,"^",2))_"^"_mod_$s(tmod=mod:"^^agone",1:"")
	s sldst="",bhav="" d nestm():$g($$$mtHaving(m)),modata,logopt("opg",$lb(tmod,$$$asl0OnePassGroupBy(tmod)))
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
loosef(m,found="")  ;  [public: m,found,call,ord,mt] return (by ref) in .found=$LIST(fval) of loose fields
	n call,lv s call="noagf^%qaqpag"
	d lvtree^%qaqpnl("l",$g($$$mtHaving(m)))
	if m=1 f lv=1:1:$l($g($$$mtNewVals),",")-1 d lvtree^%qaqpnl("v",$p($$$mtNewVals,",",lv))
	f lv=1:1:$l($$$mtOutputVals($$$mtOutput(m)),",")-1 d lvtree^%qaqpnl("v",$p($$$mtOutputVals($$$mtOutput(m)),",",lv))
	f lv=1:1:$l(ord,",")-1 d lvtree^%qaqpnl("v",$p(ord,",",lv))
	#;  in the future, might need to also look through DISTINCT BY() list
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tryParallel(m) [ mt ] public {
	#; Subq must be hinted FROM %PARALLEL (either explicitly or via auto-parallel)
	RETURN $$hint^%qaqpre("%PARALLEL",m)
}
visParallel(m,val,mod,set,bit,onerow,sldst) [ mt ] public {
	RETURN:'($$tryParallel(m) && $$subqIsParentInitialStream(m) && $g($$$mtParagOK(+$$$mtP(m))) && ('$g(mt("badvidrefs",m))) ) 0
	//No support for set looping for now
	If set RETURN 0
	//No support for bit chunk looping for now
	If bit RETURN 0
	//One row makes no sense, can't split
	If onerow RETURN 0
	//Must be gruplup if there's grouping
	If sldst,'$$fd^%qaqpre3(sldst,val_",") RETURN 0
	//No TOP
	If $g($$$mtTopArg(m)) RETURN 0
	//No DISTINCT
	If $g($$$mtDistinct(m),"none")="" RETURN 0
	//No window functions
	If $$windowsInSubq(m) RETURN 0
	//Check range from parent "MAIN" to mod. These all must be mods of the parent or
	//descendents of the parent. In most cases this 'should' be true; willing to
	//sacrifice the optimization in cases where it's not. Too hard to rewrite the ASL sequence
	//otherwise (ASL2 should be tree-structured :) )
	If '$$isContiguousModRangeForSubq(+$$$mtP(m), mod) RETURN 0
	RETURN 1
}
	#; Is subq m a view AND the initial stream of its parent subq? Reverse engineer the ASL to find out
subqIsParentInitialStream(m) [ mt, asl ] public {
	//no support for unions
	If $g($$$mtUnionTopQb(m)) RETURN 0
	Set parent = +$$$mtP(m) RETURN:'parent 0
	If $g($$$mtUnionTopQb(parent)) RETURN 0
	Set parentMainMod = $$$mtPFirstASLModule($$$mtP(parent)) RETURN:'parentMainMod 0
	//Piece 7 is where this subq view will be vnest'ed
	Set vnestMod = $$$mtPVirtStreamModule($$$mtP(m)) RETURN:'vnestMod 0
	//Whether it's directly nested or temp/DO via connect, if the view is the
	//initial stream, the vnest module will immediately follow the MAIN mod
	Set vnestMainMod = $$$aslTopSubqMod(vnestMod)
	If (vnestMainMod+1) '= vnestMod RETURN 0
	RETURN 1
}
	#; Can we "group loop", given the chosen looping subscript from the VIS?
	#; That is, do we need to re-group/aggregate rows from the partitioned queries?
	#; We *could* extend redist to do this, which would be valuable generally, but
	#; that's a bigger change than we need for this specific optimization, where
	#; we're just looking for a JOIN to a view field that is the looping subscript
isVisParallelGroupLoop(m, v, sldst) [ mt, mts ] public {
	//By definition, v is inside the initial stream view. Let's figure out which subq that view is
	Set val = $$$mtV(v)
	If $e(val)'="f" RETURN 0
	Set str = $p(val,"^",2)
	Set qn = $$$mtRQb($$$mtR(str))
	//Now we want to find the corresponding view field
	Set vid = $$$mtPQbVal($$$mtP(qn))+1
	For i=1:1 {
		Set ov = $p($$$mtOutputVals($$$mtOutput(qn)),",",i) RETURN:ov="" 0
		If ov = v QUIT
	}
	Set vf = vid + i
	Set vfval = $$$mtV(vf)
	If $e(vfval)'="f" RETURN 0
	Set vfifn = $p(vfval,"^",3)
	//Do we have an equijoin to the vf?
	Set str = ""
	Set log = ""
	For {
		Set str = $o(mts(m,str)) QUIT:str=""
		For {
			Set log = $o(mts(m,str,"JOIN",vfifn,log),1,join) QUIT:log=""
			Set otherv = $p($p(join,"^",5),",",2)
			If $$fd^%qaqpre3(sldst,otherv_",") RETURN 1
		}
	}
	RETURN 0
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
validateShardGrp(sldst)
	#; Check the possibility to get rid of the GROUP BY in the main query.
	#; loop over each cosharded group, we need to verify the at least one shard key of this group is functional depedent on GROUP BY.
	#; And above constrain needs to hold for "EVERY" cosharded group. 
	n i,j,shstr,irn,skifn,skifns,skval,skvals,found,coshgrp
	f i=1:1:$ll(mt("cosh",m)){
		#; loop over cosharded group
		s coshgrp = $li(mt("cosh",m),i)
		s found = 0
		f j=1:1:$ll(coshgrp){
			#; loop over the sharded stream in this given cosharded group.
			s shstr = $li(coshgrp,j)
			s irn = +$$$mtR(shstr)
			i '+$$$smdSharded(1, irn) continue
			s skifns = $$$smdShardKey(1,irn)
			s:'skifns skifns = $$$smd(1,irn,"col",1)
			s skvals=""
			for k=1:1 {
				s skifn = $p(skifns,",",k) QUIT:skifn=""
			    s skval = +$p($g(mts(m,shstr,"ATT",skifn)),"^",5)
			    s:'skval skval = $$$newval("f^"_shstr_"^"_skifn,1)
				#; shard keys are implicitly SQLUPPER (all shard keys, not
				#; just strings, but it only matters here for collated fields)
				if $$$smdColCollation(1,irn,skifn)'="" {
					s skval = +$p($g(mts(m,shstr,"ATT",skifn_"_%SQLUPPER")),"^",5)
					s:'skval skval = $$$newval("f^"_shstr_"^"_skifn_"_%SQLUPPER",1)
				}
				s skvals = skvals_skval_","
			}
			i $$fd^%qaqpre3(sldst,skvals){
				s found = 1
				quit
			}
		}
		RETURN:'found 0
	}
	RETURN 1
	#; AK924
shard()	;  [public: ahav,bhav,onerow,sldst,files,ord,vals,c2s,nstmd,is13,order,outtype,topon,levag,selst,mcurs,mtc,m,mod,mt,asl] send a query to the shard servers, get back the data
	n found,exprfound,call,lv,ai,qn,qs,prm,useCAST,useCOAL,sel,parag,uu,val,deflog,v,sub
	#; If this is subq 1, assume this query can be factored until proven otherwise
	n windows s windows=$$windowsInSubq(m)
	s mt("canFactor",m)=(m=1)
	s $$$mtShard(m)=$s($g(mt("shrows",m)):"rows",onerow:"aggs",1:"plain")  ;  AK985
	#;  gruplup: if group==(fd)==>shardkey then no need to combine results!
	#;  s:mt("shardkey",m)=sldst $$$mtShard(m)="gruplup"
	#;HSU306+
	i $g(sldst)'="",$$$mtShard(m)'="rows",$$validateShardGrp^%qaqpagg(sldst) s $$$mtShard(m)="gruplup" 
	#;HSU306-
	KILL:'onerow files
	#;  test streamless conds, also remove them from mt("w")!  ;  AK960;AK1021
	i $g($$$mtStreamlessConds(m)) { d preky^%qaqpmod(mod,"cond",$$$mtStreamlessConds(m)) s $$$mtWhere(m)=$TR($$remove^%qaqpmod($TR($$$mtWhere(m),"^",","),$$$mtStreamlessConds(m)),",","^") }
	d nestm()  ;  MAIN+1 - send out query (will be "reconnected" later)
	#;  reconstruct the SELECT-list - go through the DISTINCT list, SELECT,
	#;  HAVING, and ORDER BY, and list in found=$LIST(val) all fields and
	#;  (non-streamless) subqueries found, except that for aggregates
	#;  go only through the %FOREACH list if $$$mtShard(m)'="rows"
	#;  also collect shag=$LIST() of all shared/sent aggregates ;  AK978
	n shag,agdist s shag="",agdist=""  ;  agdist=$LIST() of DISTINCT BY()
	s found="",exprfound="",call="shsel^%qaqpagg"  ;  AK960
	f lv=1:1:$l(sldst,",")-1 d lvtree^%qaqpnl("v",$p(sldst,",",lv))
	d lvtree^%qaqpnl("l",$g($$$mtHaving(m)))
	f lv=1:1:$l($$$mtOutputVals($$$mtOutput(m)),",")-1 d lvtree^%qaqpnl("v",$p($$$mtOutputVals($$$mtOutput(m)),",",lv))
	f lv=1:1:$l(ord,",")-1 d lvtree^%qaqpnl("v",$p(ord,",",lv))
	#;  if updatable cursor then also get %ID, to set into %ROWID at FETCH
	i m=1,mcurs'="",$g(mtc(mcurs,"rid")),'$g($$$mtOneRow(1)),'$g($$$mtGroupDistinctList(1)),($g($$$mtOutput(1))'["d"),'$lf(found,mtc(mcurs,"rid")) { s found=found_$lb(mtc(mcurs,"rid")) }
	#; YCL176 - Update field we get from parallel/shard sub query if this field has %SPACE collation
   	new i
   	for i = 1:1:$listlength(found) {
		set v = $$$mtV($list(found,i))
		set:(($e(v)="f")&&(v["_%SPACE")) $list(found,i)=$p(mts($$$mtRQb($$$mtR($p(v,"^",2))),$p(v,"^",2),"ATT",+$p(v,"^",3)),"^",5) ; uncollate field with %SPACE collation, since no syntax is available to specify a %SPACE collation on a value in a query	
   	}
	s mt("eval")=$g(mt("eval"))_found  ;  subqueries already evaluated  ;  AK970
	#;  mark added subqueries (and their subq's) as part of m's sent query  ;  AK977  ;  removed by AK1021
	;  f qn=2:1:$$$mtPNumQbs i $lf(found,$$$mtPQbVal($$$mtP(qn))),$g(mt("shtop",qn))=qn { f lv=2:1:$$$mtPNumQbs s:$g(mt("shtop",lv))=qn mt("shtop",lv)=m}
	#;  mark all subqueries for query reconstruction, and as "obsolete"
	f qn=2:1:$$$mtPNumQbs i $g(mt("shtop",qn))=m { s $$$mtDSNLinkedTable(qn)=" " s:qn'=m $$$mtPQbIsActive(qn)=0 }  ;  AK938
	s prm="",useCAST=1,useCOAL=1,sel=""  ;  calls accumulate prm=$LB(parm)
	n corrm s corrm=$lfs($$$mtPCorrelatedFields($$$mtP(m)))_$$latm^%qaqpre2(m)  ;  AK932;AK850
	s corrm("localxpr")=1  ;  eval expr's locally on the master  ;  AK1021
	#; if we're not OJ filtering rows, we may be able to evaluate window functions locally
	#; if they're partitioned with the shard key
	if '$d(ojfilter(m)) {
		if $$shardPartitionsWindows(windows) {
			for lv=1:1 {
				New window
				Set window = $p(windows,",",lv) QUIT:window=""
				If '$lf(found,window) Set found=found_$lb(window)
			}
			set mt("queuedwins",m)=1
		}
	}
	s vals=$listtostring(found_$lb("")),parag=$listtostring(shag_$lb(""))_vals  ;  parag=returned row fields  ;  AK978
	#; AK939
	s:'$d($$$mtShardCount) $$$mtShardCount=$$shardCount^%SYS.SHARDSRV()  ;  $$shardCount()
	#;  if ojfields() then add all streams' %ID/%VID to the SELECT-list
	#;  also store in mt("alid",m)=$LIST(pos) the positions of all the id's
	#;      (in "alst" stream order)
	i $d(ojfilter(m)) {
		#; can't factor OJ queries yet
		s mt("canFactor",m)=0
		f ai=1:1:$ll(mt("alst",m)) s val=$$tableid(m,$li(mt("alst",m),ai))_"," s:","_parag'[(","_val) parag=parag_val s $li(mt("alid",m),ai)=$l($p(","_parag,","_val),",")
		s ojfilter(m)=$$nutemp^%qaqpmod("ojf^"_mod_"^^^"_m_"^0^^^"_MAIN_"^^^0")
		n alrst,lid,rid,defer s alrst="",lid="",defer=""
		#;  mt("alrst",m)=$LIST(str,) of all right-side streams
		f  { s lid=$o(ojfilter(m,lid),1,rid) q:lid=""  d adlist(.alrst,rid) }
		s mt("alrst",m)=alrst  ;  do not send WHERE conditions on alrst
		f lv=$l($g($$$mtWhere(m)),"^")-1:-1:1 {
			s deflog=$p($$$mtWhere(m),"^",lv)
			CONTINUE:'$$defer(deflog)
			s defer=defer_deflog_"^",$p($$$mtWhere(m),"^",lv,*)=$p($$$mtWhere(m),"^",lv+1,*),v=$$$mtLColVals($$$mtL(deflog))
			#;  add fields in deferred conditions to SELECT-list
			f ai=2:1:$l(v,",")-1 s val=$p(v,",",ai)_"," s:","_parag'[(","_val) parag=parag_val
			#;  add subqueries in deferred conditions to SELECT-list
			s qs=$$listree("l",deflog,"q")
			#;  but only those in mt("shtop,qb)=m  ;  AK1021
			f ai=1:1 s val=$p(qs,",",ai) QUIT:val=""  i $g(mt("shtop",$p($$$mtV(val),"^",2)))=m { s:","_parag'[(","_val_",") parag=parag_val_"," s:'$lf($g(mt("eval")),val) mt("eval")=$g(mt("eval"))_$lb(val) }
		}
	}
	#; contextual argument to all ^%qaqcmh regeneration functions to reproduce as close to original query
	#; as possible, including Cache-isms like %STARTSWITH.
	n asOriginal s asOriginal=1
	#; AK939-
	#; regenerate top clause first so parameter order is correct, insert it later
	n topClause s topClause = ""
	#; can't apply the top clause at the shards if there's a HAVING or other processing that could exclude rows at the master
	#; or ordering by aggregates that aren't completely calculated on the shards
	n ordaggs s ordaggs = ""
	for ai=1:1 {
		Set val = $p(ord,",",ai) QUIT:val=""
		Set ordaggs = ordaggs _ $$listree("v",val,"a")
	}
	n dstby s dstby = $$genDistinctBy
	new top, topStyle
	set top=$g($$$mtTopArg(m)), topStyle=$g($$$mtTopStyle(m))
	if top && (topStyle="TOP") && ('$g($$$mtHaving(m))) && ($$$mtShard(m)'="rows") && 'windows &&
		('sldst ||
		($$$mtShard(m)="gruplup") ||
		(($$$mtShard(m) = "plain") && 'ordaggs))  {
		set topClause = $$genTop^%qaqcmh(top)  ;  AK1086
	}
	f ai=1:1:$l(parag,",")-1 s sel=sel_","_$$vertVal^%qaqcmh(.mt,$p(parag,",",ai))
	s:sel="" sel=",1"  ;  parag empty, no SELECT-list needed
	s $e(sel)=$$genSELECT^%qaqcmh(m)_" "_$s(windows:"",$l(dstby):dstby,$g($$$mtDistinct(m),"none")="":"DISTINCT ",1:"")_topClause  ;  replacing the 1st comma
	// generate potential pagination clause for LIMIT/FETCH/OFFSET
	new paginationClause 
	set paginationClause = ""
	set:"TOP"'[topStyle paginationClause = $$genPagination^%qaqcmh(m)
	set $$$mtSql(m)=sel_$$genfrom^%qaqcmh(m,1)_$$parseWhere^%qaqcmh(m)_$s($$$mtShard(m)'="rows":$$grupag(m,agdist)_$$shorder(m,parag),1:"")_paginationClause, $$$mtSqlPrm(m)=prm
	d posky^%qaqpmod("quq",m_"^^^^"_mt("shardext",m))
	d nestm()  ;  d conct  ;  mod MAIN+1 with all of the above is called, now in MAIN+2
	s $$$aslKId(mod,1)="temp"_$C(1,1)_mod_"^-1"_$C(1,1,1,1)_m_$c(1,1,1,1,1,1)_m
	#; set $$$aslIdKeyAccessType($$$aslKId(mod,1))="temp"
	#; set $$$aslIdTfBuildLoc($$$aslKId(mod,1))=mod_"^-1"
	#; set $$$aslIdQb($$$aslKId(mod,1))=m
	#; set $$$aslIdQueuedWriterQuery($$$aslKId(mod,1))=m
	s uu=$$$newval("i^tempID")
	set $$$aslKNext(mod,1,1)=uu_$C(1)_"a"
	#; set $$$aslNextSubscriptType($$$aslKNext(mod,1,1))=uu
	#; set $$$aslNextLoopingType($$$aslKNext(mod,1,1))="a"
	f ai=1:1:$l(parag,",")-1 {
		s val=$p(parag,",",ai),v=$$$mtV(val),sub=val
		#;  modify final aggregates to use returning results
		i $e(v)="a",mt("shard",m)'="gruplup" { s sub=$$$getVarNum("parag"_val),$p(parag,",",ai)=sub,$p(v,"^",3,5)=",^^"_sub s:$p(v,"^",2)="count" c2s(val)=v,$p(v,"^",2)="sum" s $$$mtV(val)=v }
		#;  "fake build" entry for each returned field
		s $$$aslActNode(mod,-1,ai+1)=$c(1)_sub,$$$aslBuildActNode(mod,-1,sub)=$c(1)_1_$c(1)_" "_$c(1)_ai
	}
	s $$$aslKFlds(mod,1)=parag  ;  aggregate results coming back
	#; AK939
	#;  test any oj deferred conditions, and add them back to mt("w")
	#;  but first apply to them NULL analysis  ;  AK967
	i $d(ojfilter(m)),defer { n mtw,nulstr s mtw=$$$mtWhere(m),$$$mtWhere(m)=defer,nulstr=mt("nulstr") d notnullw^%qaqpnl(m,1),posky^%qaqpmod("cond",$tr($$$mtWhere(m),"^",",")) s $$$mtWhere(m)=mtw_$$$mtWhere(m) }
	#; AK939-
	#;  add fake "build" info for queued temp-file read
	s $$$aslAct(mod,-1)=" "_$c(1,1,1,1,1,1)_0  ;  fake BUILD action
	s $$$aslActNode(mod,-1,1)="s"_$c(1)_uu_$c(1,1,1,1,1,1)_"tid"
	d nestm(,,1)  ;  MAIN+6 - compute the final aggregates
	s nstmd=mod  ;  for levag - nest all 1st-level aggs under this module
	#; AK902
	if $$$mtShard(m)="gruplup" {
		//reapply distinct in the presence of `select` window functions, which don't
		//follow the usual rules of functional dependence
		set:'$$windows(sldst) sldst=""
		set bhav=""
	}
	s is13=0  ;  ignore/reconstruct optimizer algorithm/output for post-join processing
	i $g($$$mtSequencersQb(m)),'$$$mtPAggList($$$mtP(m)),'$g($$$mtHaving(m)),'$g($$$mtGroupDistinctList(m)),'windows {
		s order=ord,outtype=1 d sort(order,.vals)
		i $g($$$mtTopArg(m)) { s topon=1 k $$$mtTopLimit(m) }  ;  redo TOP opt from scratch
	}
	else { s order="",outtype=0 }  ;  rely on ord<>order post-join processing
	#; Regardless, we can't factor ORDER BY or TOP/LIMIT/FETCH or OFFSET
	if ($g($$$mtSequencersQb(m)))||$$hasPagination^%qaqpsq(m) { set mt("canFactor",m)=0 }
	#; Also can't handle any "rows" or "aggs" case
	i $$$mtShard(m)="rows" s mt("canFactor",m)=0
	i $$$mtShard(m)="aggs" s mt("canFactor",m)=0
	#; ...or aggregates in general
	i bhav s mt("canFactor",m)=0
	#; ...or GROUP BY (until gruplup is restored)
	i $g($$$mtGroupDistinctList(m)) s mt("canFactor",m)=0
	#; ...or HAVING
	i $g($$$mtHaving(m)) s mt("canFactor",m)=0
	#; Any non-cosharding is disqualifying
	i $ll($g(mt("cosh",m)))>1 s mt("canFactor",m)=0
	#; Final opportunity for shard factorization
	i $g(mt("canFactor",m)) s mt("sqlFactor",m)=$$genFactorSubquery(m)
	i $$$mtShard(m)'="aggs" { Do modata RETURN }  ;  but for GROUP BY, follow some normal processing
	s levag=bhav d levag  ;  compute final aggregates
	MERGE mt("v")=c2s  ;  restore SUM->COUNT, so that it would init to 0
	d:$g($$$mtHaving(m)) posky^%qaqpmod("cond",$$$mtHaving(m))  ;  HAVING  ;  AK183  ;  ALL001
	d expr(selst)  ;  SELECT:  evaluate expressions  ;  AK069  ; ALL003
	Do modata
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; Regenerate the subquery m in an appropriate form to be distributed independently
	#; to the shard servers (differs from the shard server partition query in that it has
	#; the original SELECT list)
genFactorSubquery(m) [ mt ] public {
	Set q = "SELECT "
	//TOP clause not yet supported for factorized queries
	//DISTINCT might work if grulup is ever re-enabled
	Set q = q _ $s($g($$$mtDistinct(m),"none")="":"DISTINCT ",1:"")
	For i=1:1 {
		Set v = $p($$$mtOutputVals($g($$$mtOutput(m))),",",i) QUIT:v=""
		Set q = q _ $$vertVal^%qaqcmh(.mt,v) _ ","
	}
	If i>1 Set $e(q,*) = " " //replace trailing ","
	Set q = q _ $$genfrom^%qaqcmh(m,1)_$$parseWhere^%qaqcmh(m)_$$gengroup^%qaqcmh(m)
	//ORDER BY, HAVING not supported
	RETURN q
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
shsel	;  called from listree->lvtree with type,val,v,ev  ;  AK960;AK978 
	#;  OUTPUT:  found, shag, agdist
	#;  AK1021:  This is now called for %PARALLEL as well!
	#;  list in found=$LIST(val) all fields and subqueries, except that if
	#;    $$$mtShard(m) is not "rows", then for each aggregate ("a"),
	#;    either it has a DISTINCT BY list which is then added to
	#;    agdist=$LIST(val) (to be added to the GROUP BY clause), or add
	#;    the agg to shag=$LIST(val) and go only thru the %FOREACH list
	#;    exprfound=$LIST(val) all the other expressions that needs to be passed 
	#;    to the parent process via IPQ
	RETURN:"xtn"[ev  ;  *** maybe handle n that includes "q" (TRW1546)???
	i "f"=ev { d adlist(.found,$lb(val)) RETURN }  ;  found
	#;  do not send queries evaluated on master (as determined by shardown^%qaqpnl)  ;  AK1021
	i "q"=ev { 
		If ($g(mt("shtop",$p(v,"^",2)))=m)||($g($$$mtParatop($p(v,"^",2)))=m) {
			If $g(useAPE) {d adlist(.exprfound,$lb(val))} else {d:($g(mt("shtop",$p(v,"^",2)))=m)||($g($$$mtParatop($p(v,"^",2)))=m) adlist(.found,$lb(val))}
		}
		RETURN
	}  ;  found
	i ev="a",$g($$$mtShard(m))'="rows" {  ;  see if it has a DIST list in $P(7)
		i $p(v,"^",7),$g($$$mtShard(m))'="gruplup" { d adlist(.agdist,$listfromstring($e($p(v,"^",7),1,*-1))) }
		else {
			d adlist(.shag,$lb(val))  ;  list of sharded aggregates
			s v=$p(v,"^",6)  ;  process only %FOREACH list in $P(6)
			f lv=1:1:$l(v,",")-1 { d lvtree^%qaqpnl("v",$p(v,",",lv)) }
			RETURN  ;  don't process anything else
		}
	}
	If (type="v")&&(ev="v"){ // check if the expression needs to be passed back to the parent process
		If ($g($$$mtQbUsesCdmag(m))||$g(mt("colisalg",m)))&&$lf(vtreeList,val) { // pass vector operation results as it cannpt be computed on the parent process
			d adlist(.exprfound,$lb(val))
			RETURN
		}
		If ($p(v,"^",2)="VECTOR_DOT_PRODUCT"){ // pass VECTOR_DOT_PRODUCT() results as it is expensive to calculate
			d adlist(.exprfound,$lb(val))
			RETURN
		}
		If $e($p(v,"^",2),1,20)="USERDEFINEDFUNCTION:" { // pass user-defined function results as it is expensive to calculate
			d adlist(.exprfound,$lb(val))
			RETURN
		}
	} 
	GOTO lvarg^%qaqpnl  ;  recurse down in all other cases
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
hassubq	;  called from listree->lvtree with type,val,v,ev  ;
	#;  OUTPUT:  subqfound 
	#;  list in subqfound=$LIST(val) all subqueries
	RETURN:"xtn"[ev  ; 
	i "q"=ev { do adlist(.subqfound,$lb(val)) RETURN }  ;  found
	GOTO lvarg^%qaqpnl  ;  recurse down in all other cases
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; If there are correlated subqueries in the having and order-by clauses,
 #; add the correalted fields needed by those subqueries to found
addFieldsNeededBySubqs(found)[mt,m,call,subqfound] {
	New subqfound, call
	Set subqfound = "", call = "hassubq^%qaqpagg"
	// Find all the subqueries in the having clauses (if any) 
	d lvtree^%qaqpnl("l",$g($$$mtHaving(m)))
	// Find all the subqueries in the order-by clauses (if any) 
	For i =1:1:$l($g($$$mtSequencersQb(m)),","){
		Set vidx = +$p($g($$$mtSequencersQb(m)),",",i)
		Quit:vidx=""
		Do lvtree^%qaqpnl("v",vidx)
	}
	for i =1:1:$ll(subqfound){
		Set subqv = $g($$$mtV($li(subqfound,i)))
		if $g($$$mtCorrParentQb($p(subqv,"^",2)))=m,$p(subqv,"^",3)'="," {
			// mt("v", $li(subqfound,i)) is a correalted subquery,
			// add the correalted fields to found
			for j=2:1:($l($p(subqv,"^",3),",")-1){
				do adlist(.found,$lb($p($p(subqv,"^",3),",",j)))
			}
		}
	}
}	
grupag(m,agdist)  ;  $$: GROUP BY for m, but add agdist=$LIST(val)  ;  AK978
	n res,lv s res=$$gengroup^%qaqcmh(m)
	f lv=1:1:$ll(agdist) s res=res_","_$$vertVal^%qaqcmh(.mt,$li(agdist,lv))
	s:$e(res)="," $e(res)=" GROUP BY "
	RETURN res
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
shorder(qn,colsIdxLst)  ;  Generate ORDER BY for sharding  ;  AK965
	n res s res=""
	d shord($g($$$mtSequencersQb(qn))),shord($g($$$mtSequencers)):qn=1
	RETURN res
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
shord(s) n ii,stop s stop="~"  ;  add to res sort list s=LIST(val#[d],) , but
	#;  stop if any item is not in the SELECT-list and it has an aggregate
	f ii=1:1:$l(s,",")-1 s res=res_$s(ii=1:" ORDER BY ",1:",")_$$shordd($p(s,",",ii)) i stop'="~" { s res=stop RETURN }
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
shordd(x)  ;  $$: generated ORDER BY item for x=val#[d], with [d] for DESC
	RETURN $$shordit(+x)_$s(x["d":" DESC",1:"")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
shordit(x)  ;  $$: ORDER item for x=val#
	#;  if found in SELECT list, use position, o/w evaluate expression
	s pos=$l($p(","_colsIdxLst,","_x_","),",")
	RETURN:pos<$l(colsIdxLst,",") pos  ;  use ordinal position if in SELECT
	i $$findtree("v",x,"a")||$$windows(x) { s stop=res RETURN "***stopped***" }  ;  cannot list aggregates in ORDER BY  ;  AK966;AK1042
	RETURN $$vertVal^%qaqcmh(.mt,x)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fromid(qn)  ;  $$: LIST(val,) of FID(qn) - id's for each element in  ;  AK971
	#;  qn's FROM, but if GROUP(qn) is present then use GROUP(qn),
	#;  and if mt("onerow",qn) then FID(qn)={0}
	#;  NOTE:  "rows" outermost query block sent does not include these 2!
	RETURN:$g(mt("onerow",qn)) $$$newval("t^0")_","
	RETURN:$g(mt("empty",qn)) $$$newval("t^0")_","  ;  AK990
	RETURN:$g(mt("g",qn)) mt("g",qn)
	n str,fid s str="",fid=""
	f  s str=$o(mts(qn,str)) q:'str  s fid=fid_$$tableid(qn,str)_","
	RETURN fid
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tableid(m,str)  ;  $$: stream identifier (rowid) val# for <m,str>  ;  AK971
	n vqn s vqn=$g($$$mtRVirtual(str))
	RETURN:'vqn $$idval(m,str)  ;  regular basetable
	d viewid(vqn)  ;  construct VID(vqn) as a %VHASH node
	#;  %VID added to $P(3) to avoid a perception of streamless by AK1021!
	RETURN $$$newval("v^%VFVID:"_str_"^,"_$p(mt("p",vqn),"^",8)_",^")  ;  reference this AS VID view-field
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
viewid(vqn)  ;  generate an added view-field %VHASH expression AS VID  ;  AK971
	#;  if not UNION, hash FID(vqn)
	i $g($$$mtUnionTopQb(vqn))'=vqn { d vhash(vqn,$$fromid(vqn)) RETURN }
	;  i $ll(fid,",")=2 {  ;  possible single element optimization:
		;  if it's rowid of a table - no need to hash
		;  s pos=$l($p(","_$$$mtOutputVals($$$mtOutput(vqn)),(","_fid)),",")
		;  RETURN:pos<$l($$$mtOutput(vqn),",") pos  ;  in SELECT-list }
	#;  it's a UNION - figure out the type, and generate the hash VID
	n unlev,udist,di,udg,li,qn s unlev=$$unlev^%qaqpag(vqn),udist=($ll(unlev)=1)
	#;  if UNION DISTINCT, use each leg's SELECT-list, otherwise use
	#;  its FID prefixed with its "union DISTINCT group" first q#
	f di=1:1:$ll(unlev) { s udg=$li(unlev,di) f li=1:1:$ll(udg) { s qn=$li(udg,li) d vhash(qn,$s(udist:$p(mt("o",qn),"^",2),1:$$$newval("t^"_$li(udg))_","_$$fromid(qn))) } }
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
vhash(qn,args)  ;  mark qn as requiring an additional view-field  ;  AK971
	#;  AS VID, and generating the entry for the %VHASH of args=LIST(val,)
	s mt("viewid",qn)=$$$newval("v^%VHASH^,^"_$tr(args,",","^"))
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK939
idval(m,str)  ;  $$: rowid val# for <m,str>, add it if needed
	RETURN $$idval^%qaqpag()
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adlist(into,from) n jj  ;  append $list() from to .into (by ref), but remove duplicates
	f jj=1:1:$ll(from) s:'$lf(into,$li(from,jj)) into=into_$li(from,jj,jj)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
defer(log) n ai s log=$$$mtL(log)  ;  $$: 1 if log refers to any field in alrst
	f ai=2:1:$l(log,",")-1 RETURN:$lf(mt("alrst",m),$p($$$mtV($p(log,",",ai)),"^",2)) 1
	RETURN 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
listf	;  list in found=$LIST(fval) all fields, called from listree->lvtree with type,val,v,ev
	#;  (doesn't really recurse, could be called straight out!)
	RETURN:"xtn"[ev
	i ev="f" { d adlist(.found,$lb(val)) RETURN }  ;  found
	#;  s:ev="e" v=$p(v,"^",4,*)=""
	d adlist(.found,$listfromstring($e($p(v,"^",3),2,*-1)))  ;  use field list in $P(v,3)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK939-
/// Shard support screen. Test for unsupported features and return an appropriate diagnostic if found.
confirmShardSupport() public {
	#;  Do shardTestAll("hasUnsupportedAggregate", "aggregate")  ;  removed by AK978
	Do shardTestAll("hasUngroupedField", "combination of aggregates and ungrouped fields")
	Do shardTestAll("hasComplexCondition", "condition")
	Do shardTestAll("hasINORDER", "%INORDER hint")
	//Do shardTestAll("hasSelectedStream", "selected stream")
}
///Test for all subqueries in this shard top
shardTestAll(testRtn, featureDescription) [ mt, m ] public {
	For i=1:1:$$$mtPNumQbs {
		If $g(mt("shtop",i)) = m, $$@(testRtn)(i) Do unsupportedForShard("Unsupported " _ featureDescription _ " in sharded query")
	}
}
hasSelectedStream(m) [ mt ] public {
	Set out = $$$mtOutputVals($g($$$mtOutput(m)))
	For i=1:1 {
		Set v = $p(out,",",i) QUIT:v=""
		Set val = $g($$$mtV(v))
		If $e(val) '= "f" CONTINUE
		Set irn = +$$$mtR($p(val,"^",2))
		Set ifn = $p(val,"^",3)
		If $$$smdColStream(1,irn,ifn) RETURN 1
	}
	Return 0
}
hasINORDER(m) [ mt ] public {
	Return +$g(mt("hint",m,"%INORDER"))
}
hasComplexCondition(m) [ mt ] public {
	Return +$g(mt("complexlog",m))
}
hasUngroupedField(m) public {
	Return '$$oksel(m)
}
hasAnyShardedStreams(m, strlist) {
	For i=1:1:$ll(strlist) {
		If $$isShardedStream(m, $li(strlist,i)) RETURN 1
	}
	Return 0
}
///m is qb, strname is stream name from ON clause, e.g. "2,SQLUSER.PERSON"
isShardedStream(m, strname) [ mt ] public {
	Set str = mt("ptrel",m_"^"_strname)
	Set irn = +$$$mtR(str)
	Return +$$$smdSharded(1, irn)
}
unsupportedForShard(diagnostic) [ diagnostic ] public {
	d error(177)
}
	#; AK924-
.
	#; AK902
gudhaving()  ;  ...
	QUIT:'$g($$$mtHaving(m)) 1
	QUIT:$g($$$mtParag(m))="plain" 1
	#; AK844
	n found,call
	s found="",call="noagf^%qaqpag"  ;  return them in found=$LIST(val#)
	d lvtree^%qaqpnl("l",$$$mtHaving(m))
	if found="" QUIT 1
	QUIT $$fd^%qaqpre3(sldst,$listtostring(found)_",")   ; MAK4781
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK902-
goodDistinct()	
	n i,lvals,uncollval
	#; uncollval(ifn) = 1, this ifn only need to be output in %EXACT
	#; uncollval(ifn) = 2, this ifn need to be output in both %EXACT and Collation form.
	s lvals = $$$mtOutputVals($$$mtOutput(m))
	f i=1:1:($l(lvals,",")-1) i $$$mtVType($$$mtV($p(lvals,",",i)))="f",$p($$$mtV($p(lvals,",",i)),"^",3) '[ "_" s uncollval($p($$$mtV($p(lvals,",",i)),"^",3)) = 1
	f i=1:1:($l(lvals,",")-1) i $$$mtVType($$$mtV($p(lvals,",",i)))="f",$p($$$mtV($p(lvals,",",i)),"^",3) [ "_",$g(uncollval($p($p($$$mtV($p(lvals,",",i)),"^",3),"_",1)))=1 s uncollval($p($p($$$mtV($p(lvals,",",i)),"^",3),"_",1)) = 2 
	s lvals = sldst
	f i=1:1:($l(lvals,",")-1) i $$$mtVType($$$mtV($p(lvals,",",i)))="f",$p($$$mtV($p(lvals,",",i)),"^",3) [ "_",$g(uncollval($p($p($$$mtV($p(lvals,",",i)),"^",3),"_",1)))=1 RETURN 0
	RETURN 1
eqlist(l1,l2) ; $$: 1 if the 2 given LIST(val,) are equal
	RETURN:l1=l2 1
	RETURN:$l(l1,",")'=$l(l2,",") 0
	RETURN $$remove^%qaqpmod(l1,l2)=""
genDistinctBy()
	#;HSU302+
	n dstby s dstby=""
	RETURN:windows dstby
	i $d($$$mtDistinct(m)),$g(mt("gsynth",m)),'$$eqlist($g($$$mtGroupDistinctList(m)),parag) {
		n grp s grp = $g($$$mtGroupDistinctList(m))
		f ai=1:1:$l(grp,",")-1 s dstby = dstby_$$vertVal^%qaqcmh(.mt,$p(grp,",",ai))_","
		i $e(dstby,*)="," s dstby=$e(dstby,1,$l(dstby)-1)
		i $l(dstby) s dstby = "DISTINCT BY ( " _dstby_" ) " 
	}
	RETURN dstby
	#;HSU302-
	#; AK900
.
usepartstrs
	i ev="f",$lf(partstrs,$p(v,"^",2)) { Set found=1 RETURN }  ;  found
	i ev="x",v=("x^"_+$e(v,3,*)),v'="x^0" {Do lvtree^%qaqpnl("v",+$e(v,3,*)) } // recurse down on the x^NN lateral join variables
	GOTO lvarg^%qaqpnl  ;  recurse down in all other cases
.
 // Return 1 if a temp-file tf can be shared among the workers,0 otherwise
tempfileShareOK(tf, uselocalcache) [mt,asl,m,mts,loc,val,found,call,badval,partstrs] private  {
	new found,call,partstrs
.
	Set uselocalcache=0
.
	Set tfinfo = $g($$$mtTempFile(tf))
	Return:$p(tfinfo,"^",16) 0 // this is a bitmap tempfile, don't use shared tempfile
	
	Set tfmod = $p(tfinfo,"^",2), tfnk = $p(tfinfo,"^",4), tfm = $p($p(tfinfo,"^",19),",",1),tfstr = $p($p(tfinfo,"^",19),",",2)
	Return:$e($$$aslActVecJoin($$$aslAct(tfmod,tfnk)),1,2)="vj" 0 // we can't use shared TF for vector joiner 
.
	// record all the streams that is partitioned by parallelization for this query block and all of its parent query blocks in partstrs
	Set partstrs = "", currm = m
	while currm {
		If $$$useAPE(m) {
			Set partstrs=partstrs_$lb(mt("APE",currm,"str"))
		} else {
			Set partval = $$$mtSqlPartitionVal(currm)
			set partv = $g($$$mtV(partval))
			Set:$e(partv)="f" partstrs=partstrs_$lb(+$p(partv,"^",2))
		}
		Set currm = +$$$mtP(currm)
	}
.
	// check if any of the tempfile subscript uses information from any partitioned stream (partstrs)
	// if so, we can't share this temp file among the workers
	Set latf = $g(mts(tfm,tfstr,"lateralf")) // check lateral field 
	For i=1:1:$ll(latf){
		Return:$lf(partstrs,$p($$$mtV(i),"^",2)) 0
	}
.
	set subidx= ""
	For {
		Set subidx=$o($$$aslActNode(tfmod,tfnk,subidx),1,subinfo)
		Quit:subidx=""
		If $$$aslActNodeSubscriptTraversalMode(subinfo)="s" {
			s found=0,call="usepartstrs^%qaqpagg" 
			d lvtree^%qaqpnl("v",$$$aslActNodeSubscriptVar(subinfo))
			Return:found 0
		}
	}
.
	// cache the shared global temp-file in a local array if:
	//     (1) the temp-file is small enough to fix into a local array, and 
	//     (2) the temp-file will not be read in a suppressed loop, as in this case it is possible that only a small part of the temp-file will be read
	//     Note on (2): In these cases, it is possible that the entire temp-file will be read for multiple times. Additional algorithm is needed to distinguish these cases if (2) causes significant performance issue. 
	Set tfreadloc = $$tfreadloc(tf) ; find the ASL location where the temp-file is read. 
	Set tfreadmod=$p(tfreadloc,"^",1), tfnk=$p(tfreadloc,"^",2)
	If $$$mtTfLocation($$$mtTempFile(tf))&&((tfreadmod="")||($g($$$asl0(tfreadmod))'["nolup")) {
		Set uselocalcache=1
	}
.
	Return 1
}
/// find the first ASL module that reads temp-file #tfnum
tfreadloc(tfnum) [mt,asl] PUBLIC {
	Set tfreadmod = $$$mtTfModNum($$$mtTempFile(tfnum))
	For {
		Set tfreadmod=$o($$$aslMod(tfreadmod))
		Quit:tfreadmod=""
		Set kid = ""
		For {
			Set kid=$o($$$aslK(tfreadmod,kid))
			Quit:kid=""
			Set kidinfo = $g($$$aslKId(tfreadmod,kid))
			Return:($$$aslIdKeyAccessType(kidinfo)="temp")&&($$$aslIdTfBuildLoc(kidinfo)=($$$mtTfModNum($$$mtTempFile(tfnum))_"^"_$$$mtTfBuildAct($$$mtTempFile(tfnum)))) tfreadmod_"^"_kid
		}
	}
	Return "" // didn't find any 
}
.
#; mark eligible JOIN temp-files as shared global temp-files
markSharedJoinTF(jointf) [mt,asl,m,loc,val] private  {
	Return:'jointf
	Return:$$$mtPCorrelatedFields($$$mtP(m)) // don't use shared tf for correlated subqueries
	Return:$g($$$mtQbIsJsv(m)) // don't use shared tf if this query block has correlated fields from joined streamed view
	// loop through all the join tempfiles for this query block
	for i=1:1:($l($g(jointf),",")-1) {
		set tfnum = $p(jointf,",",i)
		Continue:$data($$$mtSharedGlobalTf(tfnum)) // we've already made a decision for this temp file
.
		Set tfinfo = $g($$$mtTempFile(tfnum))
		Continue:tfinfo=""
		Continue:$p(tfinfo,"^",1)'="temp"
.
		Set tfmod = $p(tfinfo,"^",2)
		If $$$isWorkerModule(tfmod,m){
			// If none of the tempfile subscript is the value on which the parallelization is going to partition, mark this temp-file as an ^IRIS.temp.SQL tempfile and share it among all the workers
			If $$tempfileShareOK(tfnum, .uselocalcache) {
				Set:uselocalcache $$$mtSharedGlobalTfUseCache(tfnum)=1
				set $$$mtTfLocation($$$mtTempFile(tfnum))=""
				Set $$$mtTfRealGlobalFlag($$$mtTempFile(tfnum))=1
				Set $$$mtSharedGlobalTf(tfnum) = 1
				Set $$$mtSharedGlobalTfmod(tfmod) = tfnum
			} Else {
				Set $$$mtSharedGlobalTf(tfnum) = 0
			}
		}	
	}
.
}
.
parag()	;  try computing aggregates and/or GROUP BY in parallel
	new ai,asOriginal,bit,call,dsub,fld,found,ifn,imp,kid,loc,lv,md,next,other,others,exprfound,parag,prm,qn,r0,r0logs,r1,r2,r3,sel,set,selstcorrsubq,str,sub,subqs,useCAST,useCOAL,uu,v,val,vv,xclude
	New useAPE Set useAPE = $$decideAPE(m) 
	#; don't try to parallel if we're hinted "%INORDER" and are not using APE: can't guarantee regenerated query uses same FROM clause order
	Quit:('useAPE)&&$$hint^%qaqpre("%INORDER",m) 0 
	;  don't try to parallel if any process private global found
	QUIT:'$$okmaps() 0
	;  check if the select list is suitable for merging from parallel tempfiles
	QUIT:'$$oksel(m) 0
	;  check subquery suitability (typically for ability to regenerate SQL for queuing)
	;  TODO: Could do this later and parallelize more subqueries if we know exactly how
	;  much of the query will be regenerated.
	QUIT:'$$oksubq(m,,,useAPE) 0
	; disable parallelization if this query block outputs both aggregates and non-aggregates, and doesn't have GROUP BY
	QUIT:$$outputsAggAndNonAgg(m)&&('$$hasGroupBy(m)) 0
	#; HSU311+ avoid generating %parallel query like :select DISTINCT %exact field, collate field
	i 'useAPE,$d($$$mtDistinct(m)),$g(mt("gsynth",m)),'$$goodDistinct QUIT 0
	#; HSU311-
	;  Any BAT "bars" translation is unsupported
	QUIT:$d(mt("barstrans")) 0
	;  check bhav for no %FOREACH etc./only COUNT/only subset of aggregates
	#; AK902
	f ai=1:1:$l(bhav,",")-1 RETURN:'$$okag($$$mtV($p(bhav,",",ai)),sldst) 0
	; flag as qualified for parallel in case we end up qualified for the vis parallel optimization
	s $$$mtParagOK(m) = 1
	#;  find the 1st looping subscript, make sure it qualifies, and if so
	#;  generate the queries, subqueries, and reshuffle mt/asl
	s val=$$lup1(.kid,.str,.ifn,.loc,.set,.bit,.next,.useAPE)  ;  find first looping subscript value
	if $g(val),$g(str),$g($$$mtTvfParams(str))'="" QUIT 0
	QUIT:'val 0  ;  there isn't any, or the first one did not qualify
	s imp=$p(kid,$c(1),2),md=+loc,dsub=$p(loc,"^",2)
	Return:(imp'="")&&($$$IsVectorSearchIndex(imp)) 0 // disable parallelization for VectorIndex 
	#;  all previous (non-constant) subs on the map must have (non-IN) CON
	f sub=1:1:dsub-1 {
		CONTINUE:$D(next(sub))
		s v=$$$aslKNext(md,1,sub)
		i $p(v,$c(1),2)="c" { s next(sub)=v CONTINUE }
		RETURN:'$$CONcoll(+v,.other) 0  ;  must've been a join
		s next(sub)=+v_$c(1)_"u"_$c(1)_other
	}
	If $g(imp)&&useAPE{
		// Return 0 if window functions exist but cannot be included in the worker ASL modules
		Return:($$windowsInSubq(m)&&('$$fieldPartitionsWindows(val,$$windowsInSubq(m)))) 0
		// set up mt("APE") if Adaptive Parallel Execution (APE) is doable
	} Elseif ($g($$$mtQbUsesCdmag(m))||$g($$$mtQbUsesCdmp(m))||($g(mt("dtsopt",m)))||$g(mt("colisalg",m))){
		// a query with columnar overwrite plan or columnar pre-processing can only parallelized 
		// using APE, so return 0 if APE does not support this query yet
		Return 0
	} 
.
	If 'useAPE,$g($$$mtParallelByAuto(m)),(mt("sqlcomp")="%Runtime")||(mt("sqlcomp")="%FDBMS") {
		#; YCL187 - disable parallel for the query with constant parameter(s) and compile mode is %Runtime or %FDBMS, if the query is not using APE
		#; since when generating parallel subquery, the constant parameter may not be converted correctly if 
		#; the returned result from xxxToLogical or fieldnamexxxToLogical is different from the constant itself. 
		new YCL187v, YCL187val
		set YCL187v = ""
		for {
			set YCL187v = $O($$$mtV(YCL187v),1,YCL187val)
			quit:YCL187v=""
			Return:$e(YCL187val)="t" 0
		}
	}
.
	// check if there are enough memeory for vector joiner tempfiles on the workers
	Return:('$$VJMemoryOK(m)) 0
.
	If useAPE {
		Set $$$mtAPEWorker(m) = $lb(+$$$mtPFirstASLModule($$$mtP(m)), $o($$$aslMod(""), -1))
		Set $$$mtAPEPartVal(m) = val
		Set mt("APE",m,"str") = str
	}
.
	If $GET(mt("sbslrev",m)) {
		// if reverseBsl special ASL hack (TRW1615) was used for this query block, restore mt("s",m) killed in reverseBsl^%qaqpmod for parallel processing so that the code below will generate a temp-file for this order by condition on the parent process
		Set $$$mtSequencersQb(m) = idval_"d,"
		Set ord=$TRANSLATE($GET($$$mtSequencersQb(m)),"d")
	}
	
	#;HSU256+ if findlup is -1, that means HSU242 may get invoked and we need record the lup1 for HSU242
	Set:$g(findlup1)=-1 findlup1 = val
	#;HSU256-
.
	n visParallel s visParallel = 0
	if 'useAPE,$$visParallel(m,val,mod,set,bit,onerow,sldst) {
		//Activate visParallel
		//This subquery must not be parallelized, since we're parallelizing at the
		//level of our parent
		Kill mt("hint",m,"%PARALLEL")
		Set mt("hint",m,"%NOPARALLEL")=1
		//Rewrite parse tree so the val is available at the last column
		Set $$$mtOutputVals($$$mtOutput(m)) = $$$mtOutputVals($g($$$mtOutput(m)))_val_","
		//OK, switch to our parent
		Set visParallel = m
		Set m = +$$$mtP(m), MAIN=$$$mtPFirstASLModule($$$mtP(m))
		Set selst=$$$mtOutputVals($g($$$mtOutput(m))),sldst=$g($$$mtGroupDistinctList(m))
		For ext=1:1:$o($$$mtOutputOverflow(m,""),-1) Set selst(ext)=$$$mtOutputOverflow(m,ext)
		Set dodist=$g($$$mtUnionTopQb(m),m) If dodist'=1,'$$$mtPViewIDVal($$$mtP(dodist)) Set sldst=""
		Set onerow=$g($$$mtOneRow(m))
		Set ord=$tr($g($$$mtSequencersQb(m)),"d")
		Do ahavbhav(m, .ahav, .bhav)
	}
	#;  just do it!  generate ASL, queries, subqueries, reshuffle mt/asl
	d:'useAPE markAsParallel^%qaqpag(m, "from")
	#; AK902
	#;if the the first looping subscript(val) is functionally dependent on $$$mtGroupDistinctList(m)/distinct, we do not need to check distinctness in the main query.
	s $$$mtParag(m)=$s(onerow:"aggs",visParallel:"plain",('useAPE)&&$$fd^%qaqpre3(sldst,val_","):"gruplup",1:"plain") ;HSU274
	#;are we equijoining AND grouping on a parallel view initial stream loop value? then we can also skip re-grouping
	if visParallel, $$isVisParallelGroupLoop(m, val, sldst) s $$$mtParag(m)="gruplup"
	#;HSU242+ if mt("groupby",m,"%PARALLELGROUPBY") is ON, that means AK614/HSU242 is ON, we don't
    #;need to aggregate the distinct values from temp file. Each partition query exactly matches one unique GROUP BY
    s:$g(mt("%PARALLELGROUPBY",m)) $$$mtParag(m)="gruplup"
.
	// Enabling the use of a shared global to which all workers write to in parallel
	// Disable in "cdmag" columnar case
	// Disable in "indag" case since finishWorkerASL isn't called in that case to start with
	// Disable in "gruplup" case (returned groups are distinct - no need to combine anything) since it seems that
	// 			  there is no need to write to a shared global since no final regrouping is needed by the parent process
	If useAPE&&(bhav'="")&&($$hasGroupBy(m))&&('$g($$$mtQbUsesCdmag(m)))&&('$g(mt("indag",m)))&&($g($$$mtParag(m))'="gruplup") {
		Set $$$mtAPESharedGlobal(m)=""
	}
.
	// if applyTopCond=1, we will apply the TOP condition to worker outputs
	new applyTopCond s applyTopCond = (($g($$$mtTopArg(m)))&('((($$$mtParag(m)'="gruplup")&&(sldst))||($$optimizerSort(m)'=$g($$$mtSequencersQb(m))))))||topon
	#;HSU242-
	If useAPE {
		// selstcorrsubq is a val, list of variable that are in selst and has non-streamless correlated subqueries.
		Set selstcorrsubq = $$CorrelatedSubQExpr(selst)
		Set $$$mtAPESelListCorrSubq(m) = selstcorrsubq
.
		if $g($$$mtQbUsesCdmag(m))&&$$hasOrderByTempFile(m){ 
			If applyTopCond {
				set $$$mtAPETopLimitWorkerTF(m)=$$$aslActTfToBuild($$$aslAct(mod-1,1))
			} Else {
				#; If this query block is using cdmag overwrite plan, remove the temp file 
				#; if a temp file was build for order by in the cdmag plan
				do removeLastTempFileFromMT
				// remove the asl module of building and reading the temp file
				kill $$$aslAct($$$aslTopSubqMod(mod),1), $$$aslMod(mod), $$$aslAct(mod-1,1)
				set mod = mod-1
				set $list($$$mtAPEWorker(m),2) = mod
			}
		} elseif '$g($$$mtQbUsesCdmag(m)) && '$g(mt("indag",m)) {
			#; need to complete the worker ASL if this query block is not using cdmag overwrite plan
			do finishWorkerASL(val,list,sldst,$g(agdst),ahav,bhav,ord,order,outtype)
			set mod = $o($$$aslMod(""),-1)
			set $list($$$mtAPEWorker(m),2) = mod
		}
		#; mark eligible JOIN temp-files as shared global temp-files
		Do markSharedJoinTF(jointf)
		#; apply TOP condition to the worker output
		If applyTopCond {
			Set $$$asl0InitTOPSubqRowCounter($$$topWorkerModule(m))=m
			set $$$asl0IncrTOPSubqRowCounter($p($g(mt("topalt",m),"^"_$$$bottomWorkerModule(m)),"^",2))=m
		}
		; append the parent ASL at the end of current asl
		Set MAIN=mod+1
	} Else {
		f mod=MAIN:1:mod { KILL $$$aslMod(mod) s ai=$lf($g(mt("once")),mod) s:ai $li(mt("once"),ai,ai)="" }  ;  AK1035
		KILL:'onerow files
	}  
	s mod=MAIN-1 d numain^%qaqpag()  ;  MAIN
	#; AK902-
	d nestm()  ;  MAIN+1 - compute MIN
	#;  test streamless conds, also remove them from mt("w")!  ;  AK1021
	i $g($$$mtStreamlessConds(m)) { d preky^%qaqpmod(mod,"cond",$$$mtStreamlessConds(m)) s $$$mtWhere(m)=$TR($$remove^%qaqpmod($TR($$$mtWhere(m),"^",","),$$$mtStreamlessConds(m)),",","^") }
	#; we need 'other' values and have to make sure they can be calculated
	#; later we'll find their subqueries and be sure they're excluded from
	#; obsoletion
	s others=""
	#;  compute 'other' as necessary
	f sub=1:1:dsub-1 {
		continue:next(sub)'["u"
		d calc^%qaqpmod($p(next(sub),$c(1),3))
		s others=others_$LB($p(next(sub),$c(1),3))
	}
	#; AK907
	s $$$aslKId(mod,1)=$select(set&&'imp:"set",1:"map")_$c(1)_imp_$c(1,1,1,1)_str_$c(1)_$s(visParallel:visParallel,1:m)
	#; set $$$aslIdKeyAccessType($$$aslKId(mod,1))=$select(set&&'imp:"set",1:"map")
	#; set $$$aslIdMapId($$$aslKId(mod,1))=imp
	#; set $$$aslIdStrNum($$$aslKId(mod,1))=str
	#; set $$$aslIdQb($$$aslKId(mod,1))=$s(visParallel:visParallel,1:m)
	MERGE $$$aslNextRoot(mod,KEY,1)=next
	s r0 = "", r1 = "", r2 = "", r0logs = ""
	if ifn {
		s r0=$p($g(mts($select(visParallel:visParallel,1:m),str,"RANGE",ifn)),"^",3)  ;  check for upper/lower bound
		s r1=$p(r0,$c(1),1), r2=$p(r0,$c(1),3)
		Set r0logs = $p($g(mts($select(visParallel:visParallel,1:m),str,"RANGE",ifn)),"^",2)
		n i,log
		for i=2:1 {
			s log = $p(r0logs,",",i) QUIT:log=""
			If $$$mtLOperator($$$mtL(log))["TOP" Set r0logs = $replace(r0logs,(","_log),"") // remove top conditions from r0logs
		}
		Set r0logs = $e(r0logs,2,*)
	}
.
	#;  remove limit (TOP) range conditions as these can't be passed to $$SplitSize
	i r1 && ($$$mtV(r1) [ "%LIMIT") s r1 = "" s $P(r0,$c(1),1) = ""
	i r2 && ($$$mtV(r2) [ "%LIMIT") s r2 = "" s $P(r0,$c(1),3) = ""
	i r1 { d calc^%qaqpmod(r1) }
	i r2 { d calc^%qaqpmod(r2) }
	#; are we looping over a set?
	n vset s vset = ""
	if set {
		Do removeCondsForVal(m, set)
		d calc^%qaqpmod(set)
		s mt("sql",m,"set") = set
	}
	if bit {
		s mt("sql",m,"bit") = bit
	}
	s $$$aslKParQueriesInfo(mod,KEY,1)=val_","_m_","_r0  ;  rspec==r3456
.
	#; Don't attempt to parallelize the partition queries
	k mt("hint", m, "%PARALLEL")
	if 'set {
		s mt("hint", m, "%NOPARALLEL") = 1
	}
	d pardown(m, useAPE)  ;  replaces all uses of xclude/subqs  ;  AK1021
	#;  AK1021:  use same code below as used by shard()
	#;  reconstruct the SELECT-list - go through the DISTINCT list, SELECT,
	#;  HAVING, and ORDER BY, and list in found=$LIST(val) all fields and
	#;  (non-streamless) subqueries found, except that for aggregates
	#;  go only through the %FOREACH list if $$$mtShard(m)'="rows"
	#;  also collect shag=$LIST() of all shared/sent aggregates ;  AK978
	n shag,agdist s shag="",agdist=""  ;  agdist=$LIST() of DISTINCT BY()
	s found="",exprfound="",call="shsel^%qaqpagg"  ;  AK960
	f lv=1:1:$l($$$mtOutputVals($g($$$mtOutput(m))),",")-1 d lvtree^%qaqpnl("v",$p($$$mtOutputVals($$$mtOutput(m)),",",lv))
	n outputexprfound s outputexprfound=exprfound, exprfound="" // Look for expressions that query block outputs ($$$mtOutput(m)) need and store them in outputexprfound. outputexprfound is used in evaloutputexpr^%qaqpagg to find variables that needs to be evaluated before IPQ output.
	f lv=1:1:$l(sldst,",")-1 d lvtree^%qaqpnl("v",$p(sldst,",",lv))
	n sldstexprfound s sldstexprfound=exprfound // Look for expressions that sldst need and store them in sldstexprfound. sldstexprfound is used in evaloutputexpr^%qaqpagg to find variables that needs to be evaluated for IPQ output. 
	d lvtree^%qaqpnl("l",$g($$$mtHaving(m)))
	f lv=1:1:$l(ord,",")-1 d lvtree^%qaqpnl("v",$p(ord,",",lv))
	i m=1 { f lv=1:1:$l($g($$$mtNewVals),",")-1 d lvtree^%qaqpnl("v",$p($$$mtNewVals,",",lv)) }
	#;  if updatable cursor then also get %ID, to set into %ROWID at FETCH
	#;  i m=1,mcurs'="",$g(mtc(mcurs,"rid")),'$g(mt("onerow",1)),'$g($$$mtGroupDistinctList(1)),($g($$$mtOutput(1))'["d"),'$lf(found,mtc(mcurs,"rid")) { s found=found_$lb(mtc(mcurs,"rid")) }
	#;  if updatable cursor then also get %ID, to set into %ROWID at FETCH
	i m=1,mcurs'="",$g(mtc(mcurs,"rid")),'$g($$$mtOneRow(1)),'$g($$$mtGroupDistinctList(1)),($g($$$mtOutput(1))'["d"),'$lf(found,mtc(mcurs,"rid")) {
		n rid s rid = $$$mtV(mtc(mcurs,"rid"))
		#; for an expression RID (%BARS, for example), get the expression components
		i $e(rid)="v" {  ;  need to talk to Tom - this can't happen!!!
			For lv=4:1:$l(rid,"^")-1 {
				if '$lf(found,$p(rid,"^",lv)) s found=found_$lb($p(rid,"^",lv))
			}
		}
		else {
			s found=found_$lb(mtc(mcurs,"rid"))
		}
		Do:(useAPE)&&$g($$$mtAPETopLimitWorkerTF(m)) addValToTempfile($$$mtAPETopLimitWorkerTF(m), mtc(mcurs,"rid")) ; add ID to the temp-file there TOP-optimization is applied
	}
	n windows
	s windows=$$windowsInSubq(m)
	if $$fieldPartitionsWindows(val,windows) {
		for lv=1:1 {
			New window
			Set window = $p(windows,",",lv) QUIT:window=""
			If '$lf(found,window) Set found=found_$lb(window)
		}
		set mt("queuedwins",m)=1
	}
	d:$g($$$mtGroupCorrFieldOpt(m)) adlist(.found,$lb($$$mtLOperand1($$$mtL($$$mtGroupCorrFieldOpt(m)))))  ;  AK1014
	#; YCL176 - Update field we get from parallel/shard sub query if this field has %SPACE collation
    new i
    for i = 1:1:$listlength(found) {
		set v = $$$mtV($list(found,i))
		set:(($e(v)="f")&&(v["_%SPACE")) $list(found,i)=$p(mts($$$mtRQb($$$mtR($p(v,"^",2))),$p(v,"^",2),"ATT",+$p(v,"^",3)),"^",5) ; uncollate field with %SPACE collation, since no syntax is available to specify a %SPACE collation on a value in a query
    }
	s mt("eval")=$g(mt("eval"))_found  ;  subqueries already evaluated  ;  AK970
	If useAPE {
		Do addFieldsNeededBySubqs(.found) 
		Do evalsldstexprfound(sldstexprfound)
		Do evaloutputexpr(outputexprfound)
	}
	Do adlist(.exprfound, outputexprfound)
	s vals=$listtostring(found_exprfound_$lb("")),parag=$listtostring(shag_$lb(""))_vals  ;  parag=returned row fields  ;  AK978
	Set:useAPE parag=parag_selstcorrsubq
	Set:$$$parAggUsesSharedGlobal(m) parag="" // No need for the workers to output anything
	; Temporarily save the list of outputs that needs to be sent via ipq in mt()
	s:useAPE $$$mtAPEWorkerOutputs(m) = $p(parag, ",",1,*-1)
	#; if the query is using cdmag plan and the ipq outputs comes from reading a order by temp-file,
	#; add the values in mt("APE", m, "ipqoutputs") that are not in the temp-file in the temp-file
	Do:($g($$$mtQbUsesCdmag(m))&&$g($$$mtAPETopLimitWorkerTF(m))) addIPQOutputsToTempfile($$$mtAPETopLimitWorkerTF(m))
	#;    ==^==  code above from shard()
	n corrm s corrm=$lfs($$$mtPCorrelatedFields($$$mtP(m)))_$$latm^%qaqpre2(m)  ;  AK932;AK850
	s corrm("localxpr")=1  ;  eval expr's locally on the master  ;  AK1021
	If useAPE {
		#; if this query block is using Adaptive Parallel Execution, we don't need to reconstruct SQL queries for workers; we only need to identify variables that need to be sent to workers from the parent process
		Set $$$mtAPESharedParentVars(m) = $$findprm(m)
	} Else {
		#; need to reconstruct SQL queries for workers if this query block is not using Adaptive Parallel Execution
		Do constructWorkerSQLQuery(m,.parag,.prm,.windows,.useCAST,.useCOAL,.sel,.vv,.set,.val,.visParallel,.sldst,.asOriginal)
	}
	#; If appropriate, add SQL for an external driver that might want to run a set of parallel queries (e.g. Spark)
	d paragsplit(m)
	#; Do not need to nest this according to Aviel
	;d conct  ;  do all of the above in a called module
	if $$$parAggUsesSharedGlobal(m) { // Post-EEE016: no IPQ when using a shared global in parallel aggregation, so no need for any asl nodes except this newly added "WQMSync" ACTION item
		// "WQMsync is used in actloop^%qaqcct for code generation, and in $$admodsub for making sure field information is properly maintain into mt("sublev",m) and asl(hd,0,"sublev") when $$modata is called later in $$parag
		s $$$aslAct(mod,1+$o($$$aslAct(mod,"")))="WQMsync"_$c(1)_m_$c(1)_$$$newval("i^tempID")
	} else { // Pre-EEE016
		d nestm()  ;  MAIN+4 - read the results
		#; AK907-
		s $$$aslKId(mod,1)="temp"_$C(1,1)_mod_"^-1"_$C(1,1,1,1)_m_$c(1,1,1,1,1,1)_m
		#; set $$$aslIdKeyAccessType($$$aslKId(mod,1))="temp"
		#; set $$$aslIdTfBuildLoc($$$aslKId(mod,1))=mod_"^-1"
		#; set $$$aslIdQb($$$aslKId(mod,1))=m
		#; set $$$aslIdQueuedWriterQuery($$$aslKId(mod,1))=m
		s uu=$$$newval("i^tempID")
		set $$$aslKNext(mod,1,1)=uu_$C(1)_"a"
		#; set $$$aslNextSubscriptType($$$aslKNext(mod,1,1))=uu
		#; set $$$aslNextLoopingType($$$aslKNext(mod,1,1))="a"
		s:$g($$$mtParafile(m)) parag=""
		f ai=1:1:$l(parag,",")-1 {
			s val=$p(parag,",",ai),v=$$$mtV(val),sub=val
			#;  modify final aggregates to use returning results
		#; AK902
			i $e(v)="a",mt("parag",m)'="gruplup" { s sub=$$$getVarNum("parag"_val),$p(parag,",",ai)=sub,$p(v,"^",3,5)=",^^"_sub s:$p(v,"^",2)="count" c2s(val)=v,$p(v,"^",2)="sum" s $$$mtV(val)=v }
			#;  "fake build" entry for each returned field
			s $$$aslActNode(mod,-1,ai+1)=$c(1)_sub,$$$aslBuildActNode(mod,-1,sub)=$c(1)_1_$c(1)_" "_$c(1)_ai
		}
		s $$$aslKFlds(mod,1)=parag  ;  aggregate results coming back
		#;  add fake "build" info for queued temp-file read
		s $$$aslAct(mod,-1)=" "_$c(1,1,1,1,1,1)_0  ;  fake BUILD action
		s $$$aslActNode(mod,-1,1)="s"_$c(1)_uu_$c(1,1,1,1,1,1)_"tid"
	}
	d:'$$$parAggUsesSharedGlobal(m) nestm(,,1)  ;  MAIN+6 - compute the final aggregates
	s nstmd=mod  ;  for levag - nest all 1st-level aggs under this module
	#; AK902
	#; Skip some later postjoin stuff if it was already handled in the parallel Q's
	If $$$mtParag(m)="gruplup" {
		#; aggregates are always computed in gruplup
		Set bhav=""
		#; no windows, or no distinct, grouping is complete
		If ('windows)||('$d($$$mtDistinct(m))) Set sldst="" 
	}
	s is13=0  ;  ignore/reconstruct optimizer algorithm/output for post-join processing
	i $g($$$mtSequencersQb(m)),'$$$mtPAggList($$$mtP(m)),'$g($$$mtHaving(m)),$g($$$mtTopArg(m)),'$$windows(ord),'$g(mt("complexlog",m)) {
		//If there's a top operator, we can apply the condition right here
		i topop&&$g($$$mtTopLimit(m)) {
			do posky^%qaqpmod("cond",topop)
			for i=1:1 {
				n log s log = $p(topop,",",i) QUIT:log=""
				s $li(mt("topm"),log)=m
			}
		}
		else {
			k $$$mtTopLimit(m)
		}
		s order=ord,outtype=1,topon=1 d sort(order,.vals)
	}
	else {
		s order="",outtype=0
		k $$$mtTopLimit(m)
	 }  ;  rely on ord<>order post-join processing
	i $$$mtParag(m)="aggs" {  ;  but for GROUP BY, follow some normal processing
	#; AK902-
	s levag=bhav d levag  ;  compute final aggregates
	MERGE mt("v")=c2s  ;  restore SUM->COUNT, so that it would init to 0
	d:$g($$$mtHaving(m)) posky^%qaqpmod("cond",$$$mtHaving(m))  ;  HAVING  ;  AK183  ;  ALL001
	d expr(selst)  ;  SELECT:  evaluate expressions  ;  AK069  ; ALL003
	}
	#;  force temp-file to prevent INS/UPD "Haloween" rows -  ;  AK1004
	#;  (if there are windows in ORDER BY we will be building a tempfile anyway & can't sort by them now)
	i 'outtype,m=1,$g($$$mtInsertUpdateNeedsTf),'$$windows(ord) { s outtype=1,order=ord d sort(order,.vals) }
	#; APE only: add range to the first loop
	if useAPE Do addlooprange(m,str,r0logs)
	d modata  ;  recompute metadata for all modules
	set mt("numsplits",m) = $$ComputeSplitNumber(m,str,imp)
	QUIT 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
pardown(pqb, useAPE) [mt] PUBLIC  ;  AK1021
{
	s $$$mtParatop(pqb)=pqb,$$$mtDSNLinkedTable(pqb)=" "  ;  needed for query construction
	#;  mark for query reconstruction all subqueries of the parallel-top
	#;  pqb, but skip non-FROM query blocks with no correlated fields from
	#;  within pqb (which would be processed on the master!
	#;  For union legs, FROM subqueries are always marked;
	#;  Non-FROM union legs marked only if they have correlated fields from
	#;  within pqb, the rest are processed on the master
	s topqcorr=$$$mtPCorrelatedFields($$$mtP(pqb))
	f mTopo=2:1:$$$mtPNumQbs {
		s m=$g(mt("qbo",mTopo))
		#;  if m has no correlated fields (except from
		#;  topq's ancestors), and if it's not a FROM subquery, then
		#;  it will not be included in pqb's sharded query
		i $g($$$mtParatop(+$$$mtP(m)))=pqb,$$sendqb^%qaqpnl(m,topqcorr) {
			s $$$mtParatop(m)=pqb
			s:'useAPE $$$mtDSNLinkedTable(m)=" ",$$$mtPQbIsActive(m)=0
		}
	}
	RETURN
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
parafile  ;  for parallel DML filing, set mt("parafile")=1 and override sel/prm  ;  AK1007
	i "UPD DEL"[$$$mtStatementType,'$g($$$mtInsertUpdateNeedsTf),'$g($$$mtGroupDistinctList(1)) { s $$$mtParafile(1)=1 }
	if "INS"=$$$mtStatementType,'$g($$$mtInsertUpdateNeedsTf),(('sldst&&'bhav)||($g($$$mtParag(1))="gruplup")),'$$hasPagination^%qaqpsq(1),'$g($$$mtHaving(1)),'$g(mt("s",1)) { s $$$mtParafile(1)=1 }
	RETURN:'$g($$$mtParafile(1))
	n jj s jj=mtc(mcurs,"f"),prm=""  ;  jj=[str],irn,sch.tname
	i $$$mtStatementType="INS" {
		s sel="INSERT "_$$nohints()_"INTO "_$p(jj,",",3)_"("_$$genflist($p(jj,",",2))_") SELECT "
		f jj=1:1:$l(selst,",")-1 {
			s sel=sel_$e(",",jj>1)_$$vertVal^%qaqcmh(.mt,$p(selst,",",jj),0)
		}
		RETURN
	}
	s sel=$$fromit^%qaqcmh(1,+jj)  ;  with the Tn alias
	i $$$mtStatementType="DEL" { s sel="DELETE "_$$nohints()_"FROM "_sel RETURN }
	s sel="UPDATE "_$$nohints()_sel_" SET "
	f jj=1:1:$l($$$mtFList,",")-1 {
		s sel=sel_$e(",",jj>1)_$$vertVal^%qaqcmh(.mt,$p($$$mtFList,",",jj),0)_"="_$$removeExact^%qaqcmh($$vertVal^%qaqcmh(.mt,$p($$$mtNewVals,",",jj)))  ;  AK1087
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nohints()  ;  $$:  propagate %NOXXX flags  ;  AK1007
	RETURN $s($$$mtKNoCheckFlag($g($$$mtK))=1:"%NOCHECK ",1:"")_$s($$$mtKNoLockFlag($g($$$mtK))=1:"%NOLOCK ",1:"")_$s($$$mtKNoIndexFlag($g($$$mtK))=1:"%NOINDEX ",1:"")_$s($$$mtKNoTriggerFlag($g($$$mtK))=1:"%NOTRIGGER ",1:"")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
genflist(irn) n jj,res s res=""  ;  $$: comma list of INSERT-SELECT $$$mtFList field names  ;  AK1007
	#;  $$$mtFList=val1,val2,...,valn  ;  $$$mtV(vali)="i^%insel(col#)"
	f jj=1:1:$l($$$mtFList,",")-1 s res=res_","_$$flistitem(irn,jj)
	RETURN $e(res,2,*)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
flistitem(irn,jj)  ;  $$: field name of jj-th item of $$$mtFList  ;  AK1007
	RETURN $$quoter2^%qaqcmn($$$smdGetNameFromIcol(1,irn,+$p($$$mtV($p($$$mtFList,",",jj)),"(",2)))
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
iutf	;  set $$$mtInsertUpdateNeedsTf=1 if temp-file needed to prevent ghost rows  ;  AK1004
	#;  for INSERT if the table is used in the SELECT ($$circ),
	#;  for UPDATE if the join does not start with the target master map
	i $$$mtStatementType="INS",$$circ^%qaqpag() { s $$$mtInsertUpdateNeedsTf=1 RETURN }
	RETURN:$$$mtStatementType'="UPD"  ;  ,$P(mts(1,+mtc(mcurs,"f")),"^",4)'=$p(alg(1),"^",12) { 
	i '$g($$$mtFList) { s $$$mtInsertUpdateNeedsTf=1 RETURN }  ;  array() - could be any field
	;  *** actually, should populate ifns with all non-%ID fields, could be
	;      that there are no indexes, or that we're looping only on the master map!
	#;  loop over all "next" subscripts, looking for the modified ifn's
	n ifns,md,it,jj
	f jj=1:1:$l($$$mtFList,",")-1 s $li(ifns,jj)=$p($$$mtV($p($$$mtFList,",",jj)),"^",3)
	f md=1:1:mod f it=1:1 q:'$d($$$aslK(md,it))  f jj=1:1 q:'$d($$$aslKNext(md,it,jj),node)  s node=$g($$$mtV(+node)) i $e(node)="f",$lf(ifns,+$p(node,"^",3)) { s $$$mtInsertUpdateNeedsTf=1 RETURN }
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; Return true if the mods from MAIN(m) to mod were all generated from m and its descendents
isContiguousModRangeForSubq(m,mod) [ mt ] public {
	Set main = $$$mtPFirstASLModule($$$mtP(m))
	//Loop once through subq's so this isn't M * N
	For i=1:1:$$$mtPNumQbs {
		//ignore obsolete subqs
		If '$$$mtPQbIsActive(i) CONTINUE
		Set start = +$$$mtPFirstASLModule($$$mtP(i))
		Set end = +$$$mtPLastASLModule($$$mtP(i))
		//Ignore incomplete subqs
		If ('start)||('end) CONTINUE
		//Only need to check start, must be inbetween
		If (start > main) && (start < mod) {
			Set m2 = i
			For  {
				If m2 = 0 RETURN 0 //some unrelated subq!
				If i=m QUIT //descendent of m
				Set m2 = +$$$mtP(m2)
			}
		}
	}
	RETURN 1
}
paragsplit(m) [ mt, prm, asl, mod, KEY ] public {
	RETURN 0 //disabled for now
	// public variable for vertVal and other reconstruction functions
	// contains a list of re-generated parameter slots, in textual order.
	n prm s prm=""
	//Only applicable to top level query
	If m'=1 RETURN 0
	Set pmode = $g($$$mtParag(m))
	//We want to skip any queries requiring post-join processing
	//No non-exclusive grouping, no aggregation.
	If (pmode'="gruplup")&&(pmode'="plain") RETURN 0
	If (pmode="plain")&&($g($$$mtGroupDistinctList(m))) RETURN 0
	//No sorting.
	If $g($$$mtSequencers) RETURN 0
	//No pagination: TOP/LIMIT/FETCH or OFFSET
	If $$hasPagination^%qaqpsq(m) RETURN 0
	//No DISTINCT
	If $e($$$mtOutput(m))="d" RETURN 0
	//No HAVING
	If $g($$$mtHaving(m)) RETURN 0
	//No UNION
	If $g($$$mtUnionTopQb(m)) RETURN 0
	//No set looping, yet
	If $g(mt("sql",m,"set")) RETURN 0
	//Only constant or unique looping over constants?
	Set sub = ""
	Set uniqueSubs = ""
	For  {
		Set sub = $o($$$aslKNext(mod,1,sub),1,stuff) QUIT:sub=""
		If $$$aslNextLoopingType(stuff)="c" CONTINUE //constants are OK
		If $$$aslNextLoopingType(stuff)="u" {
			Set uval = $$$aslNextLoopingLowLimOrSetVar(stuff)
			If $$$mtVType($$$mtV(uval)) = "t" {
				//constant unique looping, keep track
				//so we can substitute values for variables later
				Set uniqueSubs = uniqueSubs _ $lb(+stuff,uval)
				CONTINUE
			}
		}
		//Everything else requires runtime evaluation
		RETURN 0
	}
	//Well, OK, then.
	Set mt("paragsplit",m) = 1
	Set sel = "SELECT "
	Set out = $$$mtOutputVals($$$mtOutput(1))
	For i=1:1 {
		Set v = $p(out,",",i) QUIT:v=""
		Set sel = sel _ $$vertVal^%qaqcmh(.mt, v) _ ","
	}
	Set $e(sel,*) = "" //remove last ","
	Set mt("sql",m,"select1") = sel
	Set mt("sql",m,"select1prm") = prm
	If uniqueSubs '= "" Set mt("paragsplit",m,"uniqueSubs")=uniqueSubs
	RETURN 1
}
	#; subqs is a $list of mt("v" q^ nodes (not qn)
	#; Compute and return  (as a $list) the transitive closure of all mt("v" q^ nodes that are
	#; referenced from the subqueries whose nodes are in that $list.
	#; "referenced" means:
	#; 		- Referred to directly via a contained q^ node
	#; 		- Referred to indirectly via an n^ node-referenced expression
	#;		- Part of a union of which some other subq in the closure is the head 
referencedSubqueries(subqs) [ mt, call, qrefs ] public {
	New call, qrefs
	Set call = "lvfindsubqrefs^%qaqpagg"
	Set qrefs = subqs
	For i=1:1 {
		Set subq = $lg(qrefs,i) QUIT:subq=""
		Set qn = $p($$$mtV(subq),"^",2)
		Do lvitersubq^%qaqpnl(qn)	
	}
	QUIT qrefs
}
lvfindsubqrefs
	If ev="n" Do lvtree^%qaqpnl("v",$p(v,"^",4))
	If ev="q" {
		New qn
		Set qn = $p(v,"^",2)
		If $lf(qrefs,val) QUIT
		Set qrefs = qrefs_$lb(val)
		Do lvitersubq^%qaqpnl(qn)
	}
	GOTO lvarg^%qaqpnl
.
simpleFieldExpression(v) [ call, lvSimpleFieldExpression ] public {
	New call, lvSimpleFieldExpression
	Set call = "lvSimpleFieldExpression^%qaqpagg", lvSimpleFieldExpression = 1
	Do lviter^%qaqpnl("v",v)
	RETURN lvSimpleFieldExpression
}
lvSimpleFieldExpression
	If "txfvl"'[ev Set lvSimpleFieldExpression = 0 RETURN
	If ev="v",$p($p(v,"^",2),":",1)="%WINDOW_FUNCTION" Set lvSimpleFieldExpression = 0 RETURN
	GOTO lviterarg^%qaqpnl
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
CONcoll(val,other) n ifn,log  ;  $$: 1 if exists (non-IN) CON on this ifn or on +ifn, set .other
	s ifn=$p($$$mtV(val),"^",3)
	i $d(mts(m,str,"CON",ifn),log),'$p(log,"^",4) {  ;  non-IN CON found
		s log=$p($p(log,"^",2),",",2),other=$$$mtLOperand2($$$mtL(log))
		#;  if IS NULL then generate run-time NULL value, collated if necessary
		s:'other other=$$$newval("t^"_$$colnul^%qaqcpr($p($$$mtL(log),"^",4),0))  ;  DPV1799 Added second arg of 0 to colnul
		QUIT 1
	}
	QUIT:ifn["%ANY" 0  ;  *** should be able to apply %ANY and get an element!
	QUIT:ifn'["_" 0  ;  try finding non-IN CON on +ifn
	QUIT:'$d(mts(m,str,"CON",+ifn),log)||$p(log,"^",4) 0
	s log=$p($p(log,"^",2),",",2),other=$$$mtLOperand2($$$mtL(log))
	#;  if IS NULL then generate run-time NULL value, collated if necessary
	s:'other other=$$$newval("t^")
	s other=$$$newval("v^"_$p(ifn,"_",2)_"^,^"_other_"^")
	QUIT 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK902
okag(v,glist="")  ;  $$: 1 if aggregate v can be done in parallel - only
		#;  COUNT/SUM/MIN/MAX (*** probably some others as well), no DISTINCT, %FOREACH, DISTINCT,
		#;  User Defined Aggregate is allowed if there is a merge function defined for the UDAF
	if $e(v,1,6)="a^udaf" {
		RETURN 0 //RETURN $g($$$PROCudafmergefunction($$$pPROC,$p($p(v,"^",2),$c(2),2),$p($p(v,"^",2),$c(2),3)))'=""
	}
	RETURN:" count sum min max "'[$p(v,"^",2) 0
	RETURN:$p(v,"^",7)'="" 0  ;  SUM(DISTINCT f)
	RETURN:glist=$p(v,"^",6) 1
	RETURN $p(v,"^",6)=""  ;  could be refined to glist ==fd>> $P(6)
	#; AK902-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
oksubq(m,sharded=0,recursive=0,useAPE=0) [ mt ] PUBLIC ; $$: 1 if this subquery is OK to be part of a queued query
    #; If sharded=1 passed, apply slightly different rules
    #; For sharded use, need to distinguish query initially called for from recursive calls
{
	if (+$g($$$mtP(m))'=0) && '$$$useAPE(+$g($$$mtP(m))) {
		;  correlated subqueries are not supported at the top level for non-APE parallelization
		RETURN:('recursive && 'sharded && ($p($g($$$mtP(m)),"^",4)'="")) 0
	}
	;  full outer join transforms are not supported
	RETURN:('useAPE)&&$$fjxfrmAncestry(m) 0
	; OFFSET not supported
	RETURN:$g($$$mtOffset(m)) 0
	;  neither are left-outer-join-transform created streams. These contain
	;  novel conditions we can't be sure to regenerate.
	RETURN:$g(mt("cr8strview",m)) 0
	;  subqueries with "complex" conditions (e.g. %CONTAINS) are not supported
	If 'sharded, 'useAPE {
		For i=1:1 {
			//Look for non-eliminated complex conditions
			Set log = $p($g(mt("complexlog",m)), "^", i) QUIT:log=""
			If $d($$$mtL(log)),$$$mtLType($$$mtL(log)) '= "i" RETURN 0
		}
	}
	;  no aggregates in GROUP BY
	RETURN:('sharded && $$hasGroupByAggregate(m)) 0
	;  no windows in GROUP BY (by way of DISTINCT)
	RETURN:$$windows($g($$$mtGroupDistinctList(m))) 0
	;  all my subqueries must be OK, too
	#; For sharded, no good if it has svso (for parag use, this is prevented by complexlog)
	RETURN:(sharded && recursive && $d(mt("svso",m)) ) 0
	RETURN:$d($$$QueryBlockContainsFTs(m)) 0
	For i=1:1:$$$mtPNumQbs {
		If $$$mtPQbParent($$$mtP(i)) = m,'$$oksubq(i,sharded,1,useAPE) { RETURN 0 }
	}
	RETURN 1
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#; returns 1 if this subquery or one of its ancestors participated in a full outer join
#; transformation
fjxfrmAncestry(m) [ mt ] PUBLIC 
{
	QUIT:$d(mt("fjxfrm",m)) 1
	Set parent = +$$$mtP(m)
	QUIT:parent $$fjxfrmAncestry(parent)
	QUIT 0
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#; returns 1 if this query block uses the vector joinner API
hasVecJoiner(m) [mt, asl] {
	// loop though each module in query block m
	Set mod = $$$mtPFirstASLModule($$$mtP(m))
	While (mod'="" ){
		Set ACTIONidx = ""
		For {
			Set ACTIONidx = $o($$$aslAct(mod,ACTIONidx),1,action)
			Quit:ACTIONidx=""
			if ($$$aslActAction(action)="b")&&($e($$$aslActVecJoin(action),1,2)="vj") {
				// found ASL ACTION node that builds the vector joinner
				Return 1
			} 
		}
		Set mod=$o($$$aslMod(mod))
	} 
	Return 0
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#; returns 1 if this subquery has an aggregate in its GROUP BY list
hasGroupByAggregate(m) [ mt, call, lvopHasAgg ] PUBLIC {
	New call, lvopHasAgg
	Set lvopHasAgg = 0
	Set call = "lvopHasAgg^%qaqpagg"
	For i=1:1 {
		Set v = $p($g($$$mtGroupDistinctList(m)), ",", i)
		QUIT:v=""
		Do lvtree^%qaqpnl("v", v)
		RETURN:lvopHasAgg 1
	}
	QUIT 0
}
lvopHasAgg
	If ev="a" Set lvopHasAgg = 1 QUIT
	GOTO lvarg^%qaqpnl  ;  recurse down
#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#; returns 1 if this query block returns a mix of aggregrates and non-aggregrates
outputsAggAndNonAgg(m) [ mt, call, lvopHasAgg,lvopHasNonAgg ] PUBLIC {
	New call, lvopHasAgg,lvopHasNonAgg
	Set lvopHasAgg = 0, lvopHasNonAgg=0
	For i = 1:1:($l($p($g($$$mtOutput(m)), "^",2), ",")-1) {
		Set v = $p($p($$$mtOutput(m), "^",2), ",",i)
		QUIT:v=""
		Set call = "lvopHasAgg^%qaqpagg"
		Do lvtree^%qaqpnl("v", v)
		Set call = "lvopHasNonAgg^%qaqpagg"
		Do lvtree^%qaqpnl("v", v)
		Return:(lvopHasAgg&& lvopHasNonAgg) 1
	}
	Return 0
}
lvopHasNonAgg
	If ev="a" QUIT
	If ev="f" Set lvopHasNonAgg = 1 
	GOTO lvarg^%qaqpnl  ;  recurse down
#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#; returns 1 if this query block has group by
hasGroupBy(m) [mt] PUBLIC {
	Return ($g($$$mtGroupDistinctList(m))&&('$g(mt("gsynth",m))))
}
#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#; returns 1 if this val has a %STARTSWITH range restriction
hasStartsWithRange(v) [ mt, mts, m, str ] PUBLIC
{
	Set ifn = $p($g($$$mtV(v)),"^",3)
	QUIT:'ifn 0
	Set range = $p($g(mts(m,str,"RANGE",ifn)),"^",3)
	//%STARTSWITH ranges always have 2 in piece 2
	QUIT $p(range,$c(1),2) = 2
}
removeCondsForVal(m, v) [ mt ] PUBLIC {
	Set where = $g($$$mtWhere(m))
	Set newwhere = ""
	For i=1:1 {
		Set cond = $p(where, "^", i) QUIT:cond=""
		If $$$mtLOperand2($$$mtL(cond)) = v CONTINUE
		Set newwhere = newwhere _ cond _ "^"
	}
	If $L(where) Set $$$mtWhere(m) = newwhere
}
#; returns a sort list for subquery m of the form 4,5d,6, representing the sort order
#; required to keep the plan of queued queries consistent with the original
#; query (sorting by, for example, aggregate expressions, makes no difference)
#; We can't use ptfjoo (the optimizer sort) directly, because it does not
#; distinguish between descending and ascending sorts.
optimizerSort(m) [ mt, ptfjoo ] PUBLIC {
	Set mtSort = $g($$$mtSequencersQb(m))
	Set optSort = $p($g(ptfjoo(m)),",",2,*)
	Set sort = ""
	For i=1:1 {
		Set c = $p(mtSort,",",i) QUIT:c=""
		#; look for the raw column (no desc "d" suffix) in ptfjoo.
		#; if it's present, we should include it.
		For j=1:1 {
			Set c2 = $p(optSort,",",j) QUIT:c2=""
			If c2=+c Set sort = sort _ c _ "," QUIT
		}
	}
	RETURN sort
}
.
	// detect any process private global referenced in the mts
okmaps() [mts] PUBLIC {
	set str = "", qno=0
	for  {
		set qno=$o(mts(qno)) quit:qno=""
		for {
			set str = $o(mts(qno,str)) quit:'str
			set imp = ""
			for{
				set imp = $o(mts(qno,str,"MAP",imp)) quit:'imp
				if ($$$smdMapExists(imp)) && ($e($$$smdMapGlobal(imp),1,3)="^||") { RETURN 0 }
			}
		}
	}
	RETURN 1
}
.
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
oksel(m) [ mt, found, call ] PUBLIC ; $$: 1 if this subquery's select list can be merged from the parallel tempfiles
{
	s aggs = $$$mtPAggList($$$mtP(m))
	; can't do it if there are aggs and any non-agg fields in the select list
	; and no GROUP BY to collapse them
	i +aggs && '$g($$$mtGroupDistinctList(m)) {
		s out = $$$mtOutputVals($$$mtOutput(m))
		s call = "noagf^%qaqpag"
		s found = ""
		for i=1:1:$l(out,",")-1 {
			s v = $p(out,",",i)
			d lvtree^%qaqpnl("v",v)
			i $ll(found) RETURN 0
		}
	}
	QUIT 1
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
lup1(kid,str,ifn,loc,set,bit,next,useAPE)	n md,topmd,val,v,si,isBsl,nextkid s val=0  ;  [public: m,mod,mt,asl] $$: 1st looping subscript
	#;  value, if any, but it must qualify
	#; AK902
	#;  first check for BSL, in which case ignore temp-files and use map0
	#;  *** use EBM once we enable bitmap R0/R4
	#;  *** in future, maybe use limited id range under an ANDed BSL index
	Set set = "", bit = ""
	Set topmd=$$$aslTopSubqMod(mod)
	Set isBsl = 0
	For md=topmd:1:mod {
		If $g($$$aslKRoot(md))="bsl" {
			Set isBsl = 1
			Quit
		}
	}
	i isBsl {
		s val=$li($$$asl0LoopingSubscripts(md)),v=$$$mtV(val),str=$$$mtVFieldQbOrStream(v),ifn=$$$mtVFieldLabelOrIFN(v)
		#; For BSL, we have to be sure we're partitioning a single piece of the row ID
		s val = $$rowIdToSingleLogical(val)
		QUIT:'val 0
		s kid=$p(mts(m,str),"^",4)  ;  fake out in mod access to map0
		;f loc=1:1 QUIT:mts(m,str,"MAP",kid,loc)'=1  s asl(mod,2,1,"next",loc)=$c(1)_"c"
		f loc=1:1 QUIT:mts(m,str,"MAP",kid,loc)'=1  s next(loc)=$c(1)_"c"
		s kid=$c(1)_kid,loc=mod_"^"_loc
	}
	#; AK902-
	else {
		#;  ignore reading of temp-files
		f md=topmd:1:mod {
			s kid=$g($$$aslKId(md,1)), str=+$$$aslIdStrNum(kid)
			i kid'="",$$$aslIdTfBuildLoc(kid)'["^" { 
				If $g($$$mtStreamUsesCdmp(m,str))||($g($$$mtQbUsesCdmag(m)))||$g(mt("colisalg",m)) {
					; no sublev for columnar queries; use subvlev instead
					Set val = $lg($$$asl0ExprsToEval(md))
				} Else {
					Set val=$lg($g($$$asl0LoopingSubscripts(md))) 
				} 
				q:val 
			}
		}
		QUIT:'val 0  ;  didn't find any
		#; Check for outer join cases: We can't reconcile padded and un-padded rows from different queued queries.
		#; a) Looping padded?
		QUIT:$$isPadded(md) 0  ;  it's outer join - can't break it down
		#; b) Building a tempfile which will be read padded?
		s nextkid=$G($$$aslKId(md+1,1))
		#; Next module reads this tempfile?
		i $$$aslIdKeyAccessType(nextkid)="temp",$$$aslIdTfBuildLoc(nextkid)=(md_"^1") {
			#; With padding? Can't use.
			QUIT:$$isPadded(md+1) 0
			#; c) IC6/S8/S13 double-tempfile which will be read padded?
			s nextkid=$G($$$aslKId(md+2,1))
			#; Next module reads this tempfile, builds another, and the one after that reads it, padded? Can't use.
			i $$$aslIdKeyAccessType(nextkid)="temp",$$$aslIdTfBuildLoc(nextkid)=(md+1_"^1"),$$isPadded(md+2) QUIT 0
		}
	}
	#; AK907
	n imp,sub s imp=$$$aslIdMapId(kid)
	s v=$$$mtV(val)
	#; If it's set looping, return the set by reference, no further checking needed as
	#; we don't need to call $$SplitSize()
	If 'isBsl {
		Set str=$$$aslIdStrNum(kid)
		If $g($$$mtStreamUsesCdmp(m,str))||($g($$$mtQbUsesCdmag(m)))||$g(mt("colisalg",m)){
			; no sublev for columnar queries; use subvlev instead
			Set loc=$li($$$asl0LocOfEvalExprs(md))
			Set sub=$p(loc,"^",3)
			Set loc = $p(loc,"^",1)_"^"_sub
			Set str=$$$aslIdStrNum(kid), ifn=""
			s:$e(v)="f" ifn=$p(v,"^",3)
			QUIT val 
		} Else {
			s loc=$li($$$asl0LoopingSubscriptsLoc(md)),sub=$p(loc,"^",2)
		}
		
		If ($$$aslNextLoopingType($$$aslKNext(md,1,sub))["y") {
			Set set = $$$aslNextLoopingLowLimOrSetVar($$$aslKNext(md,1,sub)), str=$$$aslIdStrNum($$$aslKId(md,1)), ifn=""
			#; Set looping over %ANYOF sets is not yet supported.
			RETURN:$p(v,"^",3)["%ANY" 0
			#; HSU305+
			RETURN:($e(v)="f")&&($p(v,"^",3)'="")&&($$$smdGetIrnFromIfn($p($p(v,"^",3),"_"))'=(+$$$mtR(str))) 0 
			#; HSU305-
			RETURN val
		}
	}
	#;  do we have a map at all? for looping over a "set" we don't. TODO: divide the set and queue?
	QUIT:imp="" 0
.
	#;  is this a real map, or a JLF015 illusion? if the latter, get the underlying map
	i $d(mt("smdimp",imp)) s imp = mt("smdimp", imp)
	#; special case: the empty ID map of a purely columnar table
	If $g(irn),$$$smdTableStorageType(ttype,irn)="C",$e(v)="f",(($d($$$smd(12,imp))=0)||($e($$$smdMapGlobal(imp))'="^")) {
		s str=$p(v,"^",2),ifn=$p(v,"^",3)
		If ifn=$p($g(mts(m,str)),"^",5) {
			Return val
		}
	}
	#; another special case: check if we are looping on a bitmap filter provided by a class that has method $$$dsBitmapExtentGlbNameMethod
	#; if so, set up str and ifn and return val
	#; an exmaple of this is queries with %ID %FIND %DeepSee_Query_Find.slicerFind($listbuild(?,?))
	If 'isBsl, useAPE, $g($$$aslKNext(md,1,sub-1)) {
		New outerfld, outerfilter
		Set outerfld = $$$mtV(+$$$aslKNext(md,1,sub-1))
		If $e(outerfld)="f"{
			Set outerfilter = $g($$$mtFilter($p(outerfld,"^",3)))
			If outerfilter'="" {
				New userdefinedclassname 
				Set userdefinedclassname = $p($p($$$mtV($p(outerfilter,",",2)),"^",2),":",2)
				If userdefinedclassname'="", $system.CLS.IsMthd(userdefinedclassname,$$$BitmapExtentGlbNameMethod)=2 {
					// checked that (1) we are looping on a bitmap filter provided by a class, and (2) the class has method $$$BitmapExtentGlbNameMethod
					Set str=$p(v,"^",2),ifn=$p(v,"^",3)
					Set mt("APE",m,"BitmapExtentClassOref") = $p(outerfilter,",",2)
					Return val
				}
			}
		}
	}
	Quit:($d($$$smd(12,imp))=0) 0 ; skip if we have no dictionary info to use
	QUIT:$e($$$smdMapGlobal(imp))'="^" 0  ;  skip if weird mapping
	QUIT:$e($$$smdMapCompiledTopLevelPieces(imp))'="^" 0
	QUIT:$$$smdMapParIDLevWOCon(imp)>1 0  ;  skip if multipart parent ref
	#; AK907-
	QUIT:$e(v)'="f" 0  ;  not a field *** should allow expressions, esp. if numeric!
	QUIT:$p(v,"^",3)["_~" 0 ; expression "collations" are not supported
	s str=$p(v,"^",2),ifn=$p(v,"^",3)
	QUIT:ifn["%ANY" 0  ;  %ANY
	#; All we'll check if it's BSL
	QUIT:isBsl val
	QUIT:loc[.55 0  ;  *** should recurse if virtual???  but on what???
	n subType s subType = $$$aslNextSubscriptType($$$aslKNext(md,1,sub))
	QUIT:subType="power" 0  ;  Can't handle bitslice yet
	If (subType = "bit") Set bit = 1 ; But we can handle chunk bit looping
	QUIT:($$$smdMSAccessType(imp,sub)'="Sub")&&'bit 0  ;  not bit looping or a regular subscript
	#;  all previous (non-constant) subs on the map must have (non-IN) CON
	f si=1:1:sub-1 s v=$$$aslKNext(md,1,si) RETURN:($$$aslNextLoopingType(v)'="c")&&('$d(mts(m,str,"CON",$p($$$mtV(+v),"^",3)),v)||$p(v,"^",4)) 0
	#; HSU305+
	QUIT:$$$smdGetIrnFromIfn($p(ifn,"_"))'=(+$$$mtR(str)) 0 
	#; HSU305-
	QUIT val
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#; For a logical row ID field value, if it is not a multipart row ID, return the value unchanged.
#; If it is a multipart row id, and there is a 1:1 mapping between its logical and physical constitutents
#; return the value for the first logical constituent field.
#; Otherwise return ""
rowIdToSingleLogical(val) [ m, str, mt, mts ] {
	Set irn = +$$$mtR($p($$$mtV(val),"^",2))
	Set ifn = $p($$$mtV(val),"^",3)
	Set physical = $$$smdRowIDPhysicalFields(1,irn)
	Set logical = $$$smdRowIDLogicalFields(1,irn)
	#; If there's a mismatch between physical and logical, we're not going to
	#; try to untangle it.
	If $L(physical, ",") '= $L(logical, ",") QUIT ""
	#; If there's no mapping here, it's a normal single-constituent row ID
	If logical = "" QUIT val
	#; Otherwise return the val corresponding to the first logical field
	Set val=$p($g(mts(m,str,"ATT",$p(logical, ",", 1))),"^",5)
	QUIT val
}
padBottom(mod) [ asl ] public {
	//Consult the modata
	Set top = $g($$$asl0TopCondModInPadRange(mod))
	If 'top RETURN 0
	RETURN $$$asl0BtmModForOjPadding(top)
}
isPadded(mod) public {
	RETURN $$padBottom(mod)'=0
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nonul(m,val)  n wi  ;  $$: 1 if mt("w",m) includes (val IS NOT NULL)
	s val="v^'NULL^,"_val_",^"_val_"^"
	f wi=1:1:$l($g($$$mtWhere(m)),"^")-1 RETURN:$$$mtL($p($$$mtWhere(m),"^",wi))=val 1  ;  found
	QUIT 0  ;  not found
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK900-
	#; AK902
modata	;  (re)calculate module meta-data = "nmod"/"train"/"sub[v]lev/loc"
	#;  start from subquery's MAIN module, record info for all modules
	n md,hd,padtop  ;  first clear any old information
	f md=$$$mtPFirstASLModule($$$mtP(m)):1:mod f hd=0,"nmod","sublev","subloc","subvlev","subvloc" k $$$asl0Node(md,hd)
	f md=$$$mtPFirstASLModule($$$mtP(m)):1:mod d admodsub
	#;  for an un-nested module, record info on nested train of modules.
	#;  ACTIONs could be: "n" (no RC), "l2"-"n", or "b"-"l2"-"n"
	for hd=$$$mtPFirstASLModule($$$mtP(m)):1:mod if '$p($g($$$aslMod(hd)),$c(1),2) do motrain(hd)
	s hd=$select($$$mtPFirstASLModule($$$mtP(m))=$$$topWorkerModule(m):$$$bottomWorkerModule(m)+1,1:$$$mtPFirstASLModule($$$mtP(m)))  ;  copy MAIN module hd info into mt("sub...")
	f md="nmod","sublev","subloc","subvlev","subvloc" s mt(md,m)=$g($$$asl0SubNode(hd,md))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
motrain(md)	[hd,md,ACTION,asl] {
	do train
	for npk=1:1 {
		QUIT:'$data($$$aslAct(md,npk),stuff)
		if $e(stuff)="n" do motrain($p(stuff,$c(1),2)) QUIT  ; Only first nest counts for the train
	}
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK902-
	#; AK853
topstop ;  when using sort-file for TOP optimization, and if we're looping over
	#;     the first sort entry, then make sure the first TOP condition is
	#;     assigned to that subscript, so it can be used as a stop
	#;     condition, and also apply DESC, if specified, to that looping
	n asj,hd,lev,loc,cond  ;  hd=head module building sort/top temp-file
	s asj=$p($$$mtSequencersQb(m),","),hd=$$$asl0TopNestingMod($$$mtTfModNum($$$mtTempFile($$$mtTopTempFile($$$mtTopLimit(m))))),lev=$lf($g($$$asl0LoopingSubscriptsInAllNestedMods(hd)),+asj)
	QUIT:'lev  ;  first sort entry is not in subscript
	s loc=$li($$$asl0LoopingSubscriptsLocInAllNestedModules(hd),lev)  ;  ASL location of that looping
	QUIT:'$p(loc,"^",2)  ;  special "share" looping
	QUIT:$g($$$aslKRoot(+loc))="bsl"  ;  punt on BSL
	#; AK884
	QUIT:$p(loc,"^",2)=.55  ;  %VID stop-condition done in vudun^%qaqcpre
	s cond=","_$$$aslNextAdditionalCondsOnSubscript($$$aslKNext(+loc,1,$p(loc,"^",2)))
	#;  add top-condition to subscript, if not already there
	s:cond'[(","_+topop_",") $$$aslNextAdditionalCondsOnSubscript($$$aslKNext(+loc,1,$p(loc,"^",2)))=+topop_cond
	i asj["d",$$okdesc(loc,+asj) d derange(+loc,1,$p(loc,"^",2))  ;  DESC
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK853-
	#; JLF046
empty ; In case of mt("onerow",m) && mt("empty",m), build module that calculates the onerow,
	#; initialize %BEFOREHAVING aggs, process HAVING clause, %AFTERHAVING aggs, and SELECT expressions.
	#; Note: code copied from above
	i '$g($$$mtOneRow(m)) {
		set $$$asl0(mod)=1
		set $$$asl0GenZeroRows(mod)=1
		QUIT
	}
	n aggList s aggList=$p($g($$$mtP(m)),"^",3)
	f i=1:1:$l(aggList,",")-1 d preky^%qaqpmod(MAIN,"init",$lb(,,,$p(aggList,",",i)))
	d:$g($$$mtHaving(m)) posky^%qaqpmod("cond",$$$mtHaving(m))  ;---------- HAVING ----------
	#; cannot have %AFTERHAVING aggregates with onerow
	#;---------- SELECT:  evaluate expressions ----------
	s vals=""
	s selst=$$$mtOutputVals($g($$$mtOutput(m)))
	f ext=1:1:$o($$$mtOutputOverflow(m,""),-1) s selst(ext)=$$$mtOutputOverflow(m,ext)
	d expr(selst) f ext=1:1:$o(selst(""),-1) d expr(selst(ext))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF046-
	#; AK610
admodsub  ;  collect module md info into asl(md,0,"sublev"/"subloc"/"subvlev")
	#;  see if virtual map "sharing" (OR join) used (from orasl^mod) - add id
	#; AK734
	n adunary,ntry
	s adunary=1  ;  to later prevent adding unary of subscripts
	i $e($g($$$aslMod(md)))="s",$p($$$aslMod(md),$c(1),2)+1=$p($$$aslMod(md),",",2) d adsubl(+$$$aslPkDist(md,POSTKEY,1),md,0)
	#; Some post-EEE016 logic that concerns the ACTION item "WQMsync" (as set in $$parag):
	#; 		mt("sublev",m) is needed for $$sublevs to work properly (and return correct fields so that, e.g., $$uniq works properly too in $$onepass so that it returns fields and not nothing), among other important things.
	#; 		However, mt("sublev",m) is populated from asl(hd,0,0,"sublev") in $$modata. And asl(hd,0,0,"sublev") is copied from asl(hd,0,"sublev") in $$train from $$motrain from $$modata.
	#; 		It's crucial to maintain an interconnection between these necessary data structures, which is why we call $$adsubl here on the fields recorded in $$parag.
	set ntry = ""
	for {
		set ntry=$o($$$aslAct(mod,ntry))
		QUIT:ntry=""
		if $$$aslActAction($g($$$aslAct(md,ntry)))="WQMsync" {
			do adsubl(+$$$aslActBcntVarOrSubqResOrWqmOldFld($$$aslAct(md,ntry)),md,0)
		}
	}
	#;  record PREKEY/KEY/POSTKEY fields, subscripts
	d pkeyf(PREKEY),keyf,pkeyf(POSTKEY)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
train	n mdl,lblb  ;  collect module md info for train starting at
	#;  module hd, into asl(hd,0,0,"nmod"/"sublev"/"subloc"/"subvlev").
	#;  if virtual map "sharing" (OR join) used (from orasl^mod), then
	i $e($g($$$aslAct(md,1)))="s",$$$aslAct(md,1)=$g($$$aslAct(md+1,1)) {
		#;  skip down and record module lists for split threads
		s md=$$$aslActNestingModOrIpqVars($g($$$aslAct(md,1))),mdl=$p($$$aslMod(md),$c(1),2)
		f  s $$$asl0TopNestingMod(+mdl)=hd,lblb=$g(lblb)_$lb($lb(+mdl)),mdl=$p(mdl,",",2,*) q:'mdl
		s $$$asl0NestedMods(hd)=$$$asl0NestedMods(hd)_$lb(lblb)
	}
	s $$$asl0NestedMods(hd)=$g($$$asl0NestedMods(hd))_$lb(md),$$$asl0TopNestingMod(md)=hd
	f mdl="sublev","subloc","subvlev","subvloc" s $$$asl0SubNode(hd,mdl)=$g($$$asl0SubNode(hd,mdl))_$g($$$asl0Node(md,mdl))
	//  As we're looping, record in asl(mod,0,"padtop") padding ranges within this train
	s:$d($$$asl0BtmModForOjPadding(md)) padtop=md  ;  padding starting - record here and use in all modules down the line
	s:$g(padtop) $$$asl0TopCondModInPadRange(md)=$g(padtop)  ;  we're in the middle of padding - set the data structure
	KILL:$d($$$asl0TopModForOjPadding(md)) padtop  ;  padding ending - do not record any more
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
toplast	n hd,vl,log,v  ;   maybe just repeat last TOP condition
	#; AK853
	f  QUIT:$$$mtL(+topop)'["."  s $p(topop,",",1,2)=$p(topop,",",2)  ;  find first top-conditions
	;  QUIT:$p(asl(bmod,ACTION,1),$c(1),8)="bit"  ;  ***  punt on IS13 bitmap temp-file
	s hd=$$$asl0TopNestingMod(bmod),vl=$$$asl0ExprsToEvalInAllNestedMods(hd)
	s log=$$toplog($l(order,",")-1)  ;  construct last TOP condition
	d retop(log,$$locmax($$$mtLColVals($$$mtL(log)),vl))  ;  repeat log after the last subscript if needed
	#; AK739
	f log=1:1:$$$maxl s v=$$$mtL(log) i $p(v,"^",5)=+mt("toplimit",m) s $li(mt("topm"),log)=m i $e(v,1,9)="v^TOP:'=." s $p($$$mtL(log),"^",4,6)=$p($$$mtV($p(v,"^",4)),"^",4,*)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
topt	n hd,vl,tlogs,i5,log,vp  ;  construct TOP opt. when NOT in [pre-]opt.
	QUIT:$$$aslActIsBmTf($$$aslAct(bmod,1))="bit"  ;  ***  punt on IS13 bitmap temp-file
	#; AK687
	i is13,$g($$$mtGroupDistinctList(m)) QUIT  ;  disable if IS13 and DISTINCT
	s hd=$$$asl0TopNestingMod(bmod),vl=$$$asl0ExprsToEvalInAllNestedMods(hd),tlogs=""
	f i5=1:1:$l(order,",")-1 s tlogs=$$toplog(i5)_","_tlogs
	f i5=1:1:$l(order,",")-1 s log=$p(tlogs,",",i5),vp=$$locmax($$$mtLColVals($$$mtL(log)),vl) d adlog(log,vp) d:i5=1 retop(log,vp)
	#; AK853
	s topop=log  ;  first top-condition - might be used later
	s mt("toplimit",m)=$$$getVarNum("card"_$$$aslActTfToBuild($$$aslAct(bmod,1)))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
toplog(i5) n op,log  ;  [public: order,m,mt,asl] $$: log for new i5'th TOP condition
	#; MRP856
	s $p(op,"'=.",i5)=$tr($s((i5=($l(order,",")-1))&&'$p(mt("p",m),"^",3):"<",1:"'>"),"<>",$s($p(mt("s",m),",",i5)["d":"><",1:"<>"))
	s log=$$$newlog("v^TOP:"_op_"^^"_$tr($p(order,",",1,i5),",","^")_"^"),$p($$$mtL(log),"^",3)=","_$$listree("l",log,"f")
	#; AK739
	s $li(mt("topm"),log)=m  ;  reverse index so we can determine m
	QUIT log
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
locmax(fl,vl) n vp,i5,loc s vp=0  ;  $$: max position within vl=$LIST(val#) of fields in fl=LIST(,val#,)
	f i5=2:1:$l(fl,",")-1 s loc=$lf(vl,$p(fl,",",i5)) i 'loc { s vp=$ll(vl) QUIT } s:vp<loc vp=loc
	QUIT vp
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
retop(log,vp) n psub  ;  [public: hd,vl,bmod] retest log if vp is too early
	s psub=$lg($$$asl0LoopingSubscriptsLocInAllNestedModules(hd),-1),psub=$lf($$$asl0LocOfEvalExprsInAllNestedMods(hd),+psub_"^2^"_$p(psub,"^",2))  ;  find last subscript location
	i vp<psub d adlog(log,psub)  ;  repeat the condition right after psub
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adlog(log,vp) n fl,loc  ; [public: hd,vl,bmod]  test log in ASL right after "position" vp
	#; This function was added in service of adding TOP conditions, and thus
	#; always treats the log as an "outer" condition, checked after any padding range.
	#; It is not currently suitable for adding conditions that should result in padding
	#; on failure.
	i vp=$ll(vl) n mod s mod=bmod d posky^%qaqpmod("cond",log_",") QUIT  ;  do it at end, before BUILD
	s fl=$li(vl,vp),loc=$li($$$asl0LocOfEvalExprsInAllNestedMods(hd),vp)  ; see if in sub
	#; AK735
	s:loc[.55 loc=+loc_"^3^1"  ;  place right after the "unary" operaion
	n padBot s padBot=$$padBottom(+loc)
	//Don't pad if this condition fails, check it in the module after padding
	i padBot {
		d preky^%qaqpmod(padBot+1,"cond",log_",") RETURN
	}
	i $p(loc,"^",2)=2,$p(loc,"^",3),$lf($$$asl0LoopingSubscriptsInAllNestedMods(hd),fl) s $$$aslNextAdditionalCondsOnSubscript($$$aslKNext(+loc,1,$p(loc,"^",3)))=log_","_$$$aslNextAdditionalCondsOnSubscript($$$aslKNext(+loc,1,$p(loc,"^",3))) QUIT
	i $p(loc,"^",2)=2 s $$$aslPkConds(+loc,POSTKEY,1)=log_","_$g($$$aslPkConds(+loc,POSTKEY,1)) QUIT
	s $$$aslPkConds(+loc,$p(loc,"^",2),$p(loc,"^",3)+1)=log_","_$g($$$aslPkConds(+loc,$p(loc,"^",2),$p(loc,"^",3)+1)) QUIT
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
findtree(type,val,evlist)  ;  search subtree of val for nodes of type evlist
	n found,call s found=0,call="evfind^%qaqpagg"
	d lvtree^%qaqpnl(type,val)
	QUIT found  ;  return any one found
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
evfind	;  check for 'evlist', called from findtree->lvtree with type,val,v,ev
	#; AK692
	i ev="x",$p(v,"^",2),evlist["n" s found=val  ;  treat JSV fake x^NN as "correlated"
	s:evlist[ev found=val  ;  entry found - set its val in 'found'
	#; AK679
	i ev="q",'found s:evlist["f" found=+$P(v,",",2) QUIT  ; correlated field, if any
	GOTO:'found lvarg^%qaqpnl  ;  recurse down
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
listree(type,val,evlist)  ;  $$: search subtree of mt(type,val) for all
	#;  nodes of type evlist, return them in LIST(val#,) format
	n found,call s found="",call="evlstr^%qaqpagg"
	d lvtree^%qaqpnl(type,val)
	QUIT found  ;  return any one found
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
evlstr	;  check for 'evlist', called from listree->lvtree with type,val,v,ev
	#; AK692
	i ev="x",$p(v,"^",2),evlist["n",(","_found)'[(","_val_",") s found=found_val_","
	i evlist[ev,(","_found)'[(","_val_",") s found=found_val_","  ;  found
	#; AK679
	i ev="q" i evlist["f" { f lv=2:1:$l(v,",")-1 s val=$P(v,",",lv) s:(","_found)'[(","_val_",") found=found_val_"," } QUIT  ; correlated fields
	GOTO lvarg^%qaqpnl  ;  recurse down
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK610-
	#; AK576
adsubl(val,mod,sub) n jj  ;  maintain mt("sublev"/"subloc")
	#; AK600
	QUIT:$lf($g($$$asl0LoopingSubscripts(mod)),val)
	s jj=$ll($g($$$asl0LoopingSubscripts(mod)))+1,$li($$$asl0LoopingSubscripts(mod),jj)=val,$li($$$asl0LoopingSubscriptsLoc(mod),jj)=mod_"^"_sub
	d adlval(val,mod,"2^"_sub)  ;  add to list of fields
	#; AK600-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
bslup(mod) n stuff  ;  $$: val# that the BSL in asl(mod,KEY) loops on
	s stuff=$$$aslKId(mod,$o($$$aslK(mod,""),-1))
	QUIT:$$$aslIdLoopOnChunks(stuff) $$$getVarNum("bsl"_mod_"sb"_npk)  ;  chunk subscript
	QUIT $$idval^%qaqcbsl($$$aslIdQb(stuff),$$$aslIdStrNum(stuff))  ;  rowid
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK576-
	#; AK705
minmax	n lf,ags,jj,ag,fun,subn,sub,loc  ;  if all aggregates are MIN/MAX, then
	#;  suppress looping after all MIN+MAX+GROUP fields have been retrieved
	s lf=sldst,ags=$$$mtPAggList($$$mtP(m))
	#;  check whether all of ags are MIN/MAX, whether all are of the same type on the same field, and collect all their fields in lf=LIST(val,)
	f jj=1:1 s ag=$p(ags,",",jj) q:'ag  s fun=$p($$$mtV(ag),"^",2) q:(fun'="min")&&(fun'="max")  s lf=lf_$$listree("v",ag,"f"),fun($p($$$mtV(ag),"^",5)_fun)=""
	QUIT:ag  ;  found a non-MIN/MAX aggregate
	s subn=$$sublevs(lf,.sub)  ;  no need to loop after subn
	#;  see if we can shortcut looping on the MIN/MAX argument itself -
	#;      all agg's must be on the same field, and all MIN or all MAX
	#;  the following line is part of "improved AK705" (part 4)
	;  i sub f jj=1:1 s ag=$p(ags,",",jj) q:'ag  s fun=$p($$$mtV(ag),"^",2) q:(fun'="min")&&(fun'="max")  s lf=lf_$$listree("v",ag,"f"),fun($p($$$mtV(ag),"^",5)_fun)=""
	i sub s ag=$o(fun("")) i ag=$o(fun(""),-1),sub=+ag,(","_sldst)'[(","_sub_",") s:ag["max" loc=$lg($g(mt("subloc",m)),subn) i (ag["min")||$$okdesc(loc,sub) s subn=subn-1 s:ag["max" ag="desc"
	d gnolup(subn)
	d:ag="desc" derange(+loc,1,$p(loc,"^",2))  ;  for MAX must descend
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
gnolup(subn)  ;  suppress looping starting from subscript subn+1, and if that
	#;  provides the needed DISTINCT then (as side-effect) remove sldst!
	s:$$uniq(sldst,subn) sldst=""  ;  DISTINCT all taken care of!
	#; AK735
	#;  [public: mt,asl,m,mod] modify ASL to not loop over the modules in
	#;  mt("nmod")/asl("nmod"), starting from "top"=subscript #(subn+1)
	#;  within mt("sublXX",m), all the way down to "bottom"=mod
	n slev s slev=$lg($g(mt("subloc",m)),subn+1)
	QUIT:'slev  ;  beyond the last one - no loop suppression needed
	n hd,bmod,pos s hd="",bmod=mod
	s:$p(slev,"^",2)=.55 slev=slev-1_"^.44"  ;  start before a nested view
	s pos=$lf(mt("nmod",m),+slev)
	#;  when split (ORJOIN), use first module of first thread as "top"
	#;  *** maybe better to test whether asl(+slev)["s"
	s:'$p(slev,"^",2) pos=pos-1,slev=$li($li($li(mt("nmod",m),pos)))
	d nmod^%qaqpag($li(mt("nmod",m),pos,mod),0)
	#;  for slev=md^sn , mark top module, $P(asl(md,0),4)="top" , but
	#;      if previous subscript is also in md, set $P(4)=sn
	s $p($$$asl0(+slev),",",4)=$s(+$lg(mt("subloc",m),subn)=+slev:$p(slev,"^",2),1:"top")
	#; AK735-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
sublevs(dist,mx="") n jj,lev,sub  ;  $$: for dist=LIST(val,), return subscript
	#;  level n at which all values in dist are known to be determined,
	#;  0<=n<=card(mt("sublev",m))
	#;  Also return (by ref) .mx=the n subscript value, but only if
	#;      the rest of dist is retrieved earlier
	#;  *** may be improved with much more sophisticated data structures!
	#;  *** improve - expr(fields), etc.
	QUIT:$g(mt("sublev",m))="" 0  ;  no looping anyway
	#;  find dist elements in the field list
	f jj=1:1:$l(dist,",")-1 s $e(lev,1+$lf(mt("subvlev",m),$p(dist,",",jj)))=1
	QUIT:$e($g(lev))=1 $ll(mt("sublev",m))  ;  not all found, e.g. expr
	s $e(lev)=""  ;  remove the first space ("not found" position)
	#;  find how many subscripts fit into lev, find last entry, and
	f jj=1:1 s sub=$lg(mt("sublev",m),jj) q:$e(lev,$lf(mt("subvlev",m),sub))=""  s mx=sub
	s:$lg(mt("subvlev",m),$l(lev))'=mx mx=""  ;  see if it's a subscript  ;  AK864
	QUIT jj-1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
uniq(dist,subn) n sub  ;  $$: 1 if dist=LIST(val,) is known to be DISTINCT at
	#;  level subn, i.e. if each subscript up to subn (inclusive) is
	#;  either in dist, or is functionally-dependent on dist
	f subn=1:1:subn {
		 s sub=$li(mt("sublev",m),subn) i (","_dist)'[(","_sub_","),'$$fd(dist,sub) GOTO quit0
	}
	QUIT 1
quit0	QUIT 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
okdesc(loc,val)  ;  $$: 1 if subs. val at location loc supports DESC - 3 cases
	QUIT:($p(loc,"^",2)=1)&&($g($$$aslKRoot(+loc))="bsl") 0  ;  cannot reverse BSL
	QUIT:$p(loc,"^",2)=0 0  ;  OR JOIN "share", id not really sorted
	#;  check for map NextCode with no PREV, but if "y" then it's OK, also "l" is okay as only one node for a lookup
	QUIT:"a"'[$$$aslNextLoopingType($$$aslKNext(+loc,1,$p(loc,"^",2))) 1
	QUIT '$$ddNext(val,$$$aslIdMapId($$$aslKId(+loc,1)))
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK705-
	#; AK600
keyf	;  record fields accessed in asl(md,KEY)
	#;  if BSL loop, add the loop variable (id/chunk)
	i $g($$$aslKRoot(md))="bsl" d adsubl($$bslup(md),md,1) QUIT
	#;  if virtual stream nested here, record the virtual rowid as subscript
	#;  *** could do better (actual subscripts might be useful!), but the
	#;      information isn't there yet - ASL for subquery generated later!
	#;  *** add N virtual fields following the virtual rowid!
	#; AK735
	n vm,vf
	i $d($$$asl0ViewNestingInfo(md-1),vm) s vf=$$$mtPViewIDVal($$$mtP(vm)) d adsubl(vf,md,.55) f vf=vf+1:1:vf+$l($$$mtOutput(vm),",")-1 { d adlval(vf,md,"2^.55") } QUIT
	#; AK735-
	n sub,node s sub=""  ;  loop to get list of subscripts
	#; AK734
	#;  starting from here, don't add yet unary functions of subscripts
	s adunary="^"_$ll($g($$$asl0ExprsToEval(md)))
	#; AK734-
	f  s sub=$o($$$aslKNext(md,1,sub),1,node) q:'sub  i +node d adlval(+node,md,"2^"_sub) i "ady-h-"[$$$aslNextLoopingType(node) d adsubl(+node,md,sub)
	#; AK734
	n val,mod,loc s mod=md  ;  variables used in adflds,adunary
	#;  use last subscript as location in adflds() for all remaining fields
	s loc="2^"_$p($lg($g($$$asl0LoopingSubscriptsLoc(md)),-1,"^1"),"^",2)
	s sub=$p(adunary,"^",2),adunary=1  ;  now add unary functions of subscripts
	f sub=sub+1:1:$ll($g($$$asl0ExprsToEval(md))) s val=$li($$$asl0ExprsToEval(md)) d adunary
	#; AK734-
	d adflds(md,KEY,1)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
pkeyf(pk) n npk,jj s npk=""  ;  record fields accessed in asl(md,pk), pk=PREKEY/POSTKEY
	f  s npk=$o($$$aslPk(md,pk,npk)) q:npk=""  d adflds(md,pk,npk)
	;  ***  possibly missing rowid when given by constant?
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adflds(mod,pk,npk) n jj  ;  non-subscript fields from asl(mod,pk,npk,"fields")
	#; AK734
	#;  for KEY (pk=2) use asl("naxt") subscript number as $P(3) location
	f jj=1:1:$l($g($$$aslPkFlds(mod,pk,npk)),",")-1 d adlval($p($$$aslPkFlds(mod,pk,npk),",",jj),mod,$s(pk=2:loc,1:pk_"^"_npk))
	#; AK734-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adlval(val,mod,loc)  ;  maintain asl(mod,0,"subvlev")
	#;  =$LIST(val), asl(mod,0,"subvloc")=$LIST(mod^2^sub | mod^pk^npk)
	QUIT:$lf($g($$$asl0ExprsToEval(mod)),val)
	s $$$asl0ExprsToEval(mod)=$g($$$asl0ExprsToEval(mod))_$lb(val),$$$asl0LocOfEvalExprs(mod)=$g($$$asl0LocOfEvalExprs(mod))_$lb(mod_"^"_loc)
	#; AK734
	QUIT:'adunary  ;  *** remove when we'll actually compute unary on subs!
adunary	;  come in here after last subscript, with <val,mod,loc> set
	#; AK734-
	n ufn,uval s ufn=""  ;  also append collations/functions of val
	#; JLF015
	#; Ignore the %ANYOF/%ANYKEYOF cases
	f  s ufn=$o(mt("unary",val,ufn),1,uval) q:ufn=""  d:$g(uval)'="" adlval(uval,mod,loc)
	#; JLF015-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fd(list,val)  ;  $$:  1 if val is functionally dependent on list=LIST(val,)
	;  *** in future use more elaborate data structures, e.g. computeds
	;  *** in future also use "given" CON fields
	#;  for now, just check if list contains a unique key for sub's table
	QUIT:(","_list)[(","_val_",") 1
	QUIT:$$$mtVType($$$mtV(val))'="f" 0  ;  for now only do fields
	QUIT:$$$mtV(val)["%ANYOF" 0 ; Collection fields don't map unique values to IDs
	QUIT $$ddukey($p($$$mtV(val),"^",2),list)  ;  see if list[key(str)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddukey(str,list) n irn,ii,v,lifn,kn,extent,info s lifn=""  ;  $$:  1 if list=LIST(val,) implies a key for str
	QUIT:$g($$$mtRVirtual(str)) 0  ;  virtual (could theoretically go deeper...)
	s irn=+$$$mtR(str)  ;  convert list to $LIST(ifn), with default collations implied!!!
	f ii=1:1:$l(list,",")-1 s v=$$$mtV($p(list,",",ii)) i $p(v,"^",1,2)=("f^"_str),(v'["_")||($p(v,"_",2,*)=$$ddifun(irn,+$p(v,"^",3))) s lifn=lifn_$lb(+$p(v,"^",3))
	QUIT:lifn="" 0
	QUIT:$$ddcont(lifn,$$$smdRowIDField(1,irn),0) 1  ;  try rowid
	QUIT:$d($$$mtTvfParams(str)) 0 ; TVF (with a richer TVF interface, could go deeper...)
	QUIT:$$ddcont(lifn,$$$smdRowIDLogicalFields(1,irn),0) 1  ;  try idkey (if exists)
	QUIT:$$$IsFTStream(str) 0 	// until we have stats about external table, we don't know keys for FTs
	s kn=""  ;  try all keys
	s extent=$$$smdExtent(1,irn)
	new %class set %class=$$$smdClassname(1,irn)
	#; AK618
	f  s kn=$o($$$EXTCONS($$$pEXT,extent,kn)) q:kn=""  i kn'="%1",kn'="IDKEY" s info=$$$EXTCONSsqlinfo($$$pEXT,extent,kn) i $li(info,2)="PKEY",$$ddcont(lifn,$li(info,3),1) QUIT
	new %ts1,%ts2
	if kn'="" {
		set %ts1=$$$smd(1,irn,33),%ts2=$g($$$comClassKeyRaw(%class,$$$cCLASStimechanged))
		do:(%ts1'=%ts2) error("150a")	// Error message uses variable %class,%ts1,%ts2
		QUIT 1  ;  maybe PRIMARY KEY found, otherwise look for UNIQUE
	}
	f  s kn=$o($$$EXTCONS($$$pEXT,extent,kn)) q:kn=""  i kn'="%1",kn'="IDKEY" s info=$$$EXTCONSsqlinfo($$$pEXT,extent,kn) i $li(info,2)="UNIQUE",$$ddcont(lifn,$li(info,3),1) QUIT
	#; AK618-
	set %ts1=$$$smd(1,irn,33),%ts2=$g($$$comClassKeyRaw(%class,$$$cCLASStimechanged))
	do:(%ts1'=%ts2) error("150a")	// Error message uses variable %class,%ts1,%ts2
	QUIT kn'=""
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddcont(lifn,flst,names) n jj,ifn  ;  $$: 1 if lifn=$LIST(ifn) contains all of flst=LIST(ifn,ifn)
	QUIT:flst="" 0  ;  nothing passed in
	#; AK618
	f jj=1:1 s ifn=$p(flst,",",jj) q:ifn=""  s:names ifn=$$$smdGetIfn(1,irn,ifn) q:'$lf(lifn,ifn)  q:$$nulable(irn,ifn)
	QUIT ifn=""  ;  key no good if found a key field not in the list
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK618
nulable(irn,ifn)  ;  $$:  1 if <irn,ifn> may be NULL
	QUIT:$$ddreqi(irn,ifn) 0
	;  *** could check here if cannot be NULL in this specific query -
	;      find val#, has IS NOT NULL, account for collation!
	#;  Note that NULL due to OJ is OK, since that preserves implication throughout the stream!
	QUIT 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddreqi(irn,ifn)  ;  $$:  return whether field <irn,ifn> is required
	QUIT $$$smdColRequired(1,irn,+ifn)="Y"  ;  use uncollated ifn
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK618-
ddifun(irn,ifn) n v  ;  default collation of the given irn/ifn - %ALPHAUP,%STRING(5), etc.
	s v=$$$smdColCollation(1,irn,ifn)
	if $$$ISENCODEDCOLLATE(v) {QUIT "%"_v}
	QUIT $s(v="A":"%ALPHAUP",v="U":"%UPPER",v="S":"%SPACE",v="P":"%PLUS",v="M":"%MINUS",v="MV":"%MVR",v="E":"",v="T":"%STRING",v="SS":"%SQLSTRING",v="SU":"%SQLUPPER",v["T(":"%STRING("_$p(v,"(",2),v["SS(":"%SQLSTRING("_$p(v,"(",2),v["SU(":"%SQLUPPER("_$p(v,"(",2),1:v)	// DPV2546
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK600-
	#; AK629
ddNext(f,imp)  ;  $$:  return 1 if map imp has special NextCode on field val#=f
	#;  (and no AK621 PREV code)
	QUIT:'imp 0  ;  not looping on a map at all
	s f=$$$mtV(f)
	QUIT:$e(f)'="f" 0
	s f=$p(f,"^",3)
	n ilev,stuff s ilev=""  ;  find subscript for this field
	f  s ilev=$o($$$smd(12,imp,6,ilev),1,stuff) q:'ilev  i $lg(stuff,19)=+f,$lg(stuff,3)=$p(f,"_%",2) q
	QUIT:'ilev 0  ;  not found
	s stuff=$lg(stuff,14)
	QUIT:stuff="" 0  ;  no override NextCode
	f f=$ll(stuff):-1:0 q:$lg(stuff,f)=";PREV"  ;  search for AK621 PREV code
	QUIT 'f
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK629-
	#; AK509
hsub()	n sub,next  ;  $$:  asl("next") entry converted to "h" looping,
	#;  or 0 if can't convert
	QUIT:$d($$$aslPostkeyRoot(mod-1)) 0  ;  conditions or map0 access followed
	#; AK539
	GOTO:$g($$$aslKRoot(mod-1))="bsl" chunks
	s sub=$o($$$aslKNext(mod-1,1,""),-1,next)  ;  looping with no conditions
	#;  *** could improve - test some idval conditions on the temp-file
	QUIT:$p($g(next),V,2,11)'=("a"_V_V_V_V_V_V_V_V_V_"bit") 0
	s $p(next,V,1,10)=$$$newvar("sb"_(mod-1))_V_"h"_V_V_V_V_V_V_V_V_$$$newvar("ch"_(mod-1))
	s $$$aslKNext(mod-1,1,sub)=next
	QUIT next
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK509-
	#; AK539
chunks	;  see if the last BSL items returns chunks
	s sub=$o($$$aslK(mod-1,""),-1),next=$$$aslKId(mod-1,sub)  ;  last
	#;  if last BSL item streams id's, maybe remove a "convert"
	i '$$$aslIdLoopOnChunks(next) QUIT:$$$aslIdKeyAccessType(next)'="convert" 0 KILL $$$aslK(mod-1,sub) s sub=sub-1
	QUIT 1_V_V_V_V_V_V_V_V_V_$$$getVarNum("bsl"_(mod-1)_"ch"_sub)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK539-
desc()	;  $$:  returns 1 if new sort/read necessary  ;  AK190+
	#;  if DESCending on a user global, also set ord=LIST(ns,)
	QUIT:ord'=order 1  ;  need to resort anyway
	i $g($$$mtSequencersQb(m))'["d" s ord="" QUIT 0  ;  no DESC, noop required
	i ahav_bhav'=""||outtype s ord=$$$mtSequencersQb(m) QUIT 0  ;  sort/read already done, subscripts should match perfectly
	#;  there is DESC, but no temp file created yet
	#; AK629
	#;  if returning 1, ord cannot be touched
	#;  if returning 0, ord must be "" if DESC already applied, otherwise
	#;      ord must refer to lmod subscripts for final loop
	#;  *** check for intermediate outtype=1 ("tid") - not implemented yet!
	i $e($g($$$mtV(+$lg($g(mt("sublev",m))))),1,8)="i^tempID" QUIT 1
	#;  check to see if we can satisfy the DESC instead of re-sorting
	#;  This uses data in mt() added by AK576
	#;  Example:
	#;	$$$mtSequencers=8d,2,
	#;	mt("sublev",1)=$LB(8,2,10,9)
	#;	mt("subloc",1)=$LB(3^1,3^2,3^3,5^2)
	#;	This means loops on 8 at asl(3,2,1,"next",1)=8|a , then loops on 2 at asl(3,2,1,"next",2))=2|a
	n i,asj,lev,loc,ok s ok=1
	For i=1:1:$l($g($$$mtSequencersQb(m)),",")-1 {
		s asj=$p($$$mtSequencersQb(m),",",i)
		continue:asj'["d"  ;  requires DESC
		s lev=$lf($g(mt("sublev",m)),+asj)
		continue:'lev  ;  must be in a "u" subscript - no-op
		s loc=$li(mt("subloc",m),lev)
	#; AK705
		i '$$okdesc(loc,+asj) s ok=0 QUIT  ;  cannot DESC on this subscript
		s loc(loc)=""  ;  keep a list for derange()
	}
	QUIT:'ok 1  ;  Must re-sort
	#; Now go to the subloc's and set the appropriate "d" flags
	s loc="" f  s loc=$o(loc(loc)) q:loc=""  d derange(+loc,1,$p(loc,"^",2))
	s ord=""
	QUIT 0  ;  No re-sort needed
	#; AK629-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK538
derange(mod,npk,sub)  n xx  ;  add "d" to an asl("next") entry, and reverse
	#;  the start/stop range conditions on the subscript
	#; DPV2055
	If $$$aslNextLoopingType($g($$$aslKNext(mod,npk,sub)))="y" s $$$aslNextLoopingType($$$aslKNext(mod,npk,sub))="y-" QUIT  ;  Loop DESC over SET  ;  DPV2185 ($Get())
	if $$$aslNextLoopingType($g($$$aslKNext(mod,npk,sub)))="l" QUIT   ; If doing a lookup order we walk over this node does not matter as at most one item under here
	s $$$aslNextLoopingType($$$aslKNext(mod,npk,sub))="d"  ;  Set to DESCENDING
	s xx=$$$aslKNext(mod,npk,sub)
	#;  switch start<->stop conditions except if it's %STARTSWITH, in
	#;      which case code-generation presumably deals with it correctly
	s:$$$aslNextLoopingLowLimExcl(xx)'=2 $$$aslNextAdditionalCondsOnSubscript(xx)="",$p($$$aslKNext(mod,npk,sub),$c(1),3,6)=$p(xx,$c(1),5,6)_$c(1)_$p(xx,$c(1),3,4)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK538-
levag	    ;---------- process a single level of aggregates ----------
	    #;  eliminate duplicates from the list
	f ai=1:1 s val=$P(levag,",",ai) q:val=""  s:list[(","_val_",") $P(levag,",",ai,ai+1)=$P(levag,",",ai+1),ai=ai-1 s list=list_val_","
	#; AK317
	#;  "dist" aggs are always nested
	n levdefer,aj
	for ai=1:1 {
		set val=$P(levag,",",ai) q:val=""
		set v=$$$mtV(val),agdst=$P(v,"^",7),glist=$P(v,"^",6)
		if agdst {
			#; Defer these for later so if we have two identical distinct we can combine these
			set levdefer($lb(agdst,glist))=$g(levdefer($lb(agdst,glist)))_$lb(val)
		} else {
			d agg(nstmd)
		}
	}
	set aj=""
	for {
		set aj=$order(levdefer(aj)) Q:aj=""
		set val=$list(levdefer(aj)),v=$$$mtV(val)
		set agdst=$list(aj),glist=$list(aj,2)
		do nest(nstmd,1+$o($$$aslAct(nstmd,""),-1)),agg(mod)
		#; Now append additional aggregates to the same distinct table
		set agdst=""
		for ai=2:1:$ll(levdefer(aj)) {
			set val=$list(levdefer(aj),ai),v=$$$mtV(val)
			do agg(mod)
		}
	}
	#; AK317-
	If '$$$parAggUsesSharedGlobal(m) {
		d read
	} Else {
		// Don't read temp-file because the shared global will be read later
		d conct
	}
	q   ;------------------------------
agg(mod)    ;---------- process a single aggregate ----------
	set fun=$P(v,"^",2),arg=$P(v,"^",5),glist=$P(v,"^",6)
	do expr(arg),distcond(agdst,,1)
	set npk=$$npk(ACTION)
	goto:glist avm
	#; AK841
		#; The 13th $c(1) piece is LIST(val#,) of arguments 2->N of the User Defined Aggregate
	set $$$aslAct(mod,npk)="a"_V_V_val_V_fun_V_arg_$s($p(v,"^",9)="":"",1:$c(1,1,1,1,1,1,1,1)_$p(v,"^",9,*))
	RETURN
	#; AK841-
avm	    ;---------- FOR-EACH specified, AVM needed, ACTION:BUILD ----------
	s $$$aslAct(mod,npk)="b"
	d expr(glist)  ;---------- AVM subscripts ----------
	s expr=$$remove(expr,$$remove(vals,bvals)),bvals=$$remove(bvals,expr)  ;  AK1033
	s files=files_expr_mod_"^"_npk_","
	#; AK841
	i glist=$p($g($$$mtTempFile(+distf)),"^",10) { s glist=$$subdist(npk) } else { s $$$aslActTfToBuild($$$aslAct(mod,npk))=$$nutemp^%qaqpmod("temp^"_mod_"^^"_npk_"^^0") }
	s nf=0 f li=1:1:$L(glist,",")-1 d bldfld(npk,"s",$P(glist,",",li))
	#; AK841
	d bldfld(npk,"",val_V_V_V_V_fun_V_arg),apnd(val)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
subdist(npk)  ;  use distf for BUILD subscripts
	s $$$aslActTfToBuild($$$aslAct(mod,npk))=distf
	#; AK936
	s $$$mtTfAslNode(distf,$i($$$mtTfNodeCounter(distf)))=mod_"^"_npk
	QUIT $$$mtTfHashSubscripts($$$mtTempFile(distf))_$c(1)_$$$mtTfNodeCounter(distf)_","
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK615-
logopt(name,value)  ;  record in mt("logopt")=$LB(name,val,name,val,...)
	s $$$mtLogOpt=$g($$$mtLogOpt)_$lb(name,value)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
laggs(type,list,a,level)  ;  `type'=v/l, list aggregates in bhav (ahav if a)
	q:'list  s list=$TR(list,"^",",") d laggs(type,$P(list,",",2,*),a,level)  ;  AK069
	s v=mt(type,+list)  ;  treat first on list
	i "vl"[$E(v)  d laggs($E(v),$P(v,"^",4,*),a,level) q
	i "mer"[$E(v) d laggs("v",$P(v,"^",4),a,level)      q
	q:"a"'=$E(v)
	#; AK510
	i $g(mt("precount",m)),"a^count^,^^^^"[v QUIT  ;  COUNT(*) already precomputed
	s:a'=+$P(v,"^",4) a=0,level=1  ;  %BEFORE nested under %AFTER or SELECT
	i a  { s:(","_$P(ahav,"^",level))'[(","_+list_",") $P(ahav,"^",level)=$P(ahav,"^",level)_+list_"," }  ;  %AFTER-HAVING
	else { s:(","_$P(bhav,"^",level))'[(","_+list_",") $P(bhav,"^",level)=$P(bhav,"^",level)_+list_"," }  ;  %BEFORE-HAVING
	d laggs("v",$P(v,"^",5,6)_$P(v,"^",7),a,level+1)
	q   ;------------------------------
ahavbhav(m, ahav, bhav) [ mt, i, ext ] public {
	Set ahav = ""
	Set bhav = ""
	Set selst=$$$mtOutputVals($g($$$mtOutput(m))),sldst=$g($$$mtGroupDistinctList(m))
	For ext=1:1:$o($$$mtOutputOverflow(m,""),-1) Set selst(ext)=$$$mtOutputOverflow(m,ext)
	#;  to avoid deep recursion in laggs
	New i, ext
	Set (i,ext)=0 For  Set val=$$next(.selst) QUIT:val=""  Do laggs("v",val,1,1)
	Do laggs("v",sldst,1,1),laggs("v",$g($$$mtSequencersQb(m)),1,1),laggs("l",$g($$$mtHaving(m)),0,1)
	RETURN
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
expr(list) [mt,expr,vals,bvals,V] public { ;  evaluate (non-agg) expressions in 'list'  ;  AK069  ;  AK187
	#;  as side-effects, expr=LIST(val,) of those needed here,  ;  AK1033
	#;  bvals=LIST(val,) added only to the BUILD process (cumulatively)
	s list=$TR(list,"^",","),expr=""
	f li=1:1 s eval=$P(list,",",li) q:eval=""  i "vleq"[$$$mtVType($$$mtV(eval)) s expr=expr_eval_","
	RETURN:expr=""
	s list=$$remove(expr,vals)
	RETURN:list=""
	s vals=vals_list,bvals=bvals_list
	#; See if any subqueries have the same argument and if so cache them in the same subquery cache table
	#; by grouping them together as a new 'q' node also allocate a new temp table for them, do not do for svso items
	set olist=""
	for i=1:1 {
		set val=$piece(list,",",i) QUIT:val=""
		set v=$$$mtV(val)
		if $e(v)="q",$tr($p(v,"^",3),",")'="",'$d(mt("svso",$p(v,"^",2))) {
			set subq($p(v,"^",3))=$g(subq($p(v,"^",3)))_val_","
			set subqm($p(v,"^",3))=$p(v,"^",2)
		} else {
			set olist=olist_val_","
		}
	}
	set i=""
	// for multple subqueries that share the same correlated fields ($piece 3 is the same for the q node), we allocate a shared corr- type temp file to cache their combined results, avoiding redundant subquery execution.
	for {
		set i=$o(subq(i),1,val) QUIT:i=""
		if $l(val,",")>2 {
			set newnode=$$$newval("t^"_$$nutemp^%qaqpmod("corr^^^^"_subqm(i)_"^0"))
			do SetTempfileTypeForSubqCache^%qaqpagg(subqm(i),$$$mtLatestTempFileNum)
			set olist=olist_$$$newval("v^%SUBQCACHE^"_i_"^"_newnode_","_val)_","
		} else {
			set olist=olist_val
		}
	}
	d posky^%qaqpmod("temp",V_V_V_olist)
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
remove(l1,l2) [] PUBLIC {  ;  $$: l1=LIST(log#,) sans conditions in l2
	s l2=","_l2_","
	f li=1:1 s log=$p(l1,",",li) q:'log  s:l2[(","_log_",") $p(l1,",",li,*)=$p(l1,",",li+1,*),li=li-1
	QUIT l1
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
removestreamless(lc) n li,v  ;  [public: mt] $$: LIST(val#,)=lc sans streamless entries  ;  AK1058
	f li=$l(lc,",")-1:-1:1 s v=$$$mtV($p(lc,",",li)) i "fa"'[$e(v),("xt"[$e(v))||($p(v,"^",3)=",") { s $p(lc,",",li,*)=$p(lc,",",li+1,*) }
	QUIT lc
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
sort(ord,list,distf="",groupby="")  ;  build a temp-file of values in .list, sorted by `ord'
	#; deduplicate ord
	n val1 f li=2:1 s val1=+$p(ord,",",li) q:'val1  s:","_$p(ord,",",1,li-1)_","[(","_val1_",") $p(ord,",",li,*)=$p(ord,",",li+1,*),li=li-1
	d expr(ord)
	#;  next line also prevents a bug whereas the 'constant'  ;  AK1058
	#;  subscript variable gets reassigned when reading the temp-file
	s ord=$$removestreamless(ord)  ;  no need to waste space/time/code
	s bvals=""  ;  AK1033
	s $$$aslAct(mod,1)="b"                             ;  ACTION:BUILD
	#; AK394
	#;  apply $SORT* if sorting *** maybe not always, if already sorted by ord?
	s $$$aslActSort($$$aslAct(mod,1))=(ord'="")
	#; AK394-
	s files=mod_"^"_1_","
	    ;---------- sort-file subscripts ----------
	#; AK615
	#;  data node in combined distf only if distf was actually passed in!
	if distf {
		s ord=$$subdist(1)
		#; If no data going into sort file skip the constant subscript so we do not set it to "" as distinct file
		#; already has a node set at the root distinct level
		new ti,tord set tord=","_$p(ord,",",1,*-2)_","
		for ti=$l(list,",")-1:-1:0 {
			if ti=0 set ord=$piece(ord,",",1,*-2)_","
			if tord'[(","_$p(list,",",ti)_",") QUIT
		}
	} else {
		s $$$aslActTfToBuild($$$aslAct(mod,1))=$$nutemp^%qaqpmod("temp^"_mod_"^^1^^"_(ord'=""))
		d estimatePostProcTempfileSize^%qaqpmod(m,str)
	}
	#; AK615-
	s nf=0 f li=1:1 s val=$P(ord,",",li) q:val=""  d bldfld(1,"s",val)
	#; AK615
	if 'distf {
		#; See if we need a counter, if we are passed 'groupby' and this is satified by the 'ord' list then no need for counter
		if ('groupby)||('$$fd^%qaqpre3(ord,groupby)) {
			new ukf,joino
			do redist^%qaqpqo(ord,.ukf,,m)
			#; If for each stream up to 'joi' the 'ord' includes unique required field on this stream we can skip adding the counter
			for joino=1:1:joi { if '$bit(ukf,$p(jol,",",joino)) { do bldfld(1,"s",$$tid(.ord)) quit } }
		}
	}
	if 'nf s $$$mtTfLocation($$$mtTempFile($$$aslActTfToBuild($$$aslAct(mod,1))))=1   // No subscripts put it in a local
	#; AK615-
	    #;---------- temp-file non-subscript fields ----------
	    #; sort them to ensure ShowPlan output is consistent between processes, any order would do as long as it is deterministic
	n svals
	s (i,ext)=0 f  s val=$$next(.list) q:val=""  s:","_ord'[(","_val_",") svals(val)=""
	set val=""
	for {
		set val=$order(svals(val)) QUIT:val=""
		do bldfld(1,"",val)  ;  AK069;AK214
	}
	q   ;------------------------------
tid(ord)  ; Return 0 for counter but could use the idval instead and add it to .ord
	RETURN:joi'=1 0
	RETURN:ord="" 0                    ; Maybe need to preserve existing order?
	new idval
	set idval=$$idval^%qaqpmod(m,$p(jol,","))
	RETURN:","_ord[(","_idval_",") 0   ; $$redist should have marked this unique but is not checking %VID so include check here in case ukf was not set when it could have been
	RETURN:","_list'[(","_idval_",") 0
	set ord=ord_idval_","
	RETURN idval
bldfld(npk,sub,val)  ;  add an item (subscript or data) to the temp-file
	#; AK615
	#;  allow for no val, such as constant in $P(3)
	i val=0 Set val=$$$newval("i^tempID") s $p(val,V,7)="tid"
	#; AK615-
	s nf=nf+1,$$$aslActNode(mod,npk,nf)=sub_V_val  ;  AK112
	QUIT
read	;  read current data from sort/AVM temp-files
	n gotkey
	d conct,getmp(KEY,$P(files,","))
	#; See if we can convert to bitmap temp table
	if files+1=mod d bitemp^%qaqpmod(mod,m,.str,.imp)
	f li=2:1 s v=$P(files,",",li) q:v=""  d getmp(POSTKEY,v)
	#; AK317
	s nstmd=mod  ;  for levag - process all aggs under this module
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
conct	;  rewire the temp-file module-set to be "temp"-called from MAIN
	#;  instead of nested under it, prepare a new nested module under MAIN
	s md=$$$aslActNestingModOrIpqVars($$$aslAct(MAIN,1)),$$$aslMod(md)=""  ; cancel previous nesting
	d nest(MAIN,1),preky^%qaqpmod(MAIN,"temp",md)  ;  AK106
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getmp(pk,mdact)  ;---------- read temp file built in module/action mdact
	#; AK414
	QUIT:mdact="onerow"  ;  let the module slide through exactly once
	i mdact'["^" d posky^%qaqpmod("temp",V_V_V_mdact) q       ;  expression
	#;  assume temp-file is read into the original val#
	s npk=$$npk(pk)
	s $$$aslPkId(mod,pk,npk)="temp"_V_V_mdact               ;  map-id for temp
	s ns=0 f nf=1:1 s v=$g($$$aslActNode(+mdact,$P(mdact,"^",2),nf)) q:v=""  d get($P(v,V,2))  ;  AK106+ ; ALL001
	q   ;------------------------------
get(val)    ;---------- read a single temp-file field ----------
	i $E(v)'="s" d apndf(val) q  ;  AK069  ;  AK106-
	#; AK615
	i 'val {
		s:pk=KEY $$$aslKNext(mod,1,$i(ns))=V_"c"
		#; s:pk=KEY $$$aslNextLoopingType($$$aslKNext(mod,1,$i(ns)))="c"
		QUIT
	}
	s ns=ns+1
	if pk=KEY {
		s $$$aslKNext(mod,1,ns)=val_V_"a"
		#; s $$$aslNextSubscriptVal($$$aslKNext(mod,1,ns))=val
		#; s $$$aslNextLoopingType($$$aslKNext(mod,1,ns))="a"
	} else {
		s $P($$$aslPkKeys(mod,POSTKEY,npk),",",ns)=$s($bit(gotkey,val):"",1:val)  ;  AK031
	}
	s $bit(gotkey,val)=1
	q   ;------------------------------
	#; AK317
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
noaggs() n ai,val,v  ;  $$:  return whether sldst contains no
	#;  aggregates that havn't been computed yet - if it does, DISTINCT
	#;      cannot be processed yet.  Uses sldst, vals, list, and mt("v") type
	#; AK615
	#;  *** could be improved to OK cases if agg found in subtree is in vals/list
	f ai=1:1 s val=$P(sldst,",",ai) q:val=""  i ","_vals'[(","_val_","),list'[(","_val_","),$$findtree("v",val,"a") { RETURN 0 }
	#; AK615-
	RETURN 1
nowins() [ ord, selst ] public {
	RETURN '+$$windows(selst_ord)
}
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
distcond(list,nohash=0,simple=0)  ;  test DISTINCT(list), set .list (passed by ref) to NULL
	if 'list QUIT
	#; AK615
	d expr(list),posky^%qaqpmod("dist",list_$c(1)_$$nutemp^%qaqpmod("dist^"_mod_"^"_$$npk^%qaqpmod(POSTKEY)_"^^^0^^^^"_list)_$s(simple:$c(1,1,1,1)_1,1:""))
	#; Do not update distf for simple case as AK615 relies on distf being previous table for combining aggregates
	if simple new distf
	#; setup variable distf, update temp-file database with subscripts
	#; If the not we are distinct on is short do not need extra hash subscript
	n short s distf=$$$mtLatestTempFileNum,short=$$short^%qaqcpre(list,order,0)
	s $$$mtTfNewTableFlag($$$mtTempFile(distf))=1  ; Flag we do not need 'dist1prefix' variable copy in %qaqcpre, frozen plans will not have this
	if short,'$p(list,",",2) {
		s $$$mtTfHashSubscripts($$$mtTempFile(distf))=list
	} else {
	set list=""
		s $p(mt("tf",distf),"^",11)=$$$getVarNum("dist"_distf_"prefix")_","_$s('short:$$$getVarNum("dist"_distf_"cnt")_",",1:"")
		s:'nohash vals=vals_$p(mt("tf",distf),"^",11)
	}
	set list=""
	#; AK936
	s $$$mtTfLocation($$$mtTempFile(distf))=$s(simple:2,1:1)  ;  mark temp-file as hybrid
	s $$$mtTfEntAvglen($$$mtTempFile(distf))=ntup(n)  ;  ent,avglen
	d logopt("distf",distf_$s('order:"+data",1:"")_$s(bhav:"+aggs",1:""))
	if simple QUIT
	s md=$$$aslActNestingModOrIpqVars($$$aslAct(MAIN,1)),$$$mtTfTopMod($$$mtTempFile(distf))=md,$$$asl0TfsWhereThisModIsTop(md)=$g($$$asl0TfsWhereThisModIsTop(md))_$lb(distf)
	#; AK936-
	QUIT
	#; AK317-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nest(md,npk)  ;---------- NEST new module `mod' within module md ----------
	s mod=mod+1,$$$aslAct(md,npk)="n"_V_mod,$$$aslMod(mod)=V_md
	s $$$aslTopSubqMod(mod)=MAIN  ;  place to initialize counters/temp-files
	q   ;------------------------------
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adag(mod,val)  ;  add new ACTION to module mod to compute aggregate val
	n v s v=$$$mtV(val)
	d adact(mod,"a"_V_V_val_V_$p(v,"^",2)_V_$p(v,"^",5))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adact(mod,x)  ;  add new ACTION x to module mod
	s $$$aslAct(mod,$$npk(ACTION))=x
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nestm(md1="",md2="",npk="")  ;  NEST module md1 (new module if empty) within
	#;  module md2 (mod if empty) at ACTION npk (next available if empty)
	s:'md2 md2=mod  ;  under current module
	s:'md1 md1=$$numod()  ;  new module
	s:'npk npk=$$npkm(ACTION,md2)  ;  new module
	s $$$aslAct(md2,npk)="n"_$c(1)_md1,$$$aslMod(md1)=$c(1)_md2
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
numod()  ;  $$: increment mod to the next module
	s $$$aslTopSubqMod($i(mod))=MAIN  ;  place to initialize counters/temp-files
	QUIT mod
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
npkm(pk,mod) ;  $$:  next available [PRE/POST]KEY/ACTION item in mod
	QUIT 1+$o($$$aslPk(mod,pk,""),-1)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
npk(pk)  ;  $$:  next pk (PRE/POST/KEY/ACTION) in mod
	QUIT 1+$o($$$aslPk(mod,pk,""),-1)  ;  ALL003
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
apnd(val)   ;  append val to vals  ;  AK112+ ; RGG625+
	i $L(vals)<$$$complength s vals=vals_val_"," q
	f ext=1:1 q:$L($g(vals(ext)))<$$$complength
	s vals(ext)=$g(vals(ext))_val_","
	q   ;------------------------------
next(vals) s i=i+1  ;  $$:  get the next entry from vals
	    ;  start with i=ext=0, preserve their values between calls
	i 'ext,i<$L(vals,",") q $P(vals,",",i)  ;  found in the main node
	s:i'<$L($g(vals(ext)),",") ext=ext+1,i=1    ;  not in this node - try next ; ALL001
	q $P($g(vals(ext)),",",i) ; ALL001
	q   ;------------------------------
find(val)   ;  $$:  whether val found in vals
	s val=","_val_","    ;  prepare for the "contains" operation
	q:","_vals[val 1   ;  found in the main node
	q:'$D(vals(1)) 0  ;  no more nodes - not found
	f ext=1:1 q:'$D(vals(ext))  q:","_vals(ext)[val
	q $D(vals(ext))   ;  $D iff was found in this node
	q   ;------------------------------  ;  AK112-
apndf(val)  ;  append val to asl(mod,pk,npk,"fields")
	s $$$aslPkFlds(mod,pk,npk)=$g($$$aslPkFlds(mod,pk,npk))_val_","
	QUIT
error(e)
	GOTO ^%qaqperr  ; -- e is error# --
.
#; Build the bitslice processing modules for an aggmap query.
#; Returns the final mod value after construction. 
aggMaps(join, mod) Public {
	#dim join As %SQL.Engine.Objects.AlgJoin
	#dim mod As %SQL.Engine.Objects.AslMod
	
	Set mask = join.MtStream().Mask()
	#; One time generation of mask via BSL tempfile
	If mask.Exists() && mask.TempFile() {
		Do mod.NextPrekey().SetAsOnetimeTemp(mask.TempFile().Mod())
	}
	
	#dim query As %SQL.Engine.Objects.MtQuery
	Set query = join.MtStream().MtQuery
	
	#; Build a map from val indexes to their aggmaps subscript
	Do aggMapBuildValMap(.aggMaps, join)
	
	#; Build a module to calculate each aggregate, and invoke it
	#; once from this module
	Set qProps = query.Properties()
	Set aggCount = qProps.AggregateCount()
	For i=1:1:aggCount {
		Set agg = qProps.Aggregate(i)
		Set aggMapSub = $G(aggMaps(agg.Index))
		//Is there a map for this aggregate? count(*) doesn't need one (counts the mask bits)
		Set map = $S(aggMapSub:aggMapSub.AggMap.Map(),1:"")
		//If there is a map, does it originate in the superclass?
		Set fromSuperclass = $s(map:aggMapSub.AggMap.OriginatesInSuperclass(),1:0)
		Set aggMod = $$aggMapAggMod(map, agg, join.Stream().ExtentBitmap(), mask, fromSuperclass)
		Do mod.NextPrekey().SetAsOnetimeTemp(aggMod)
	}
.
	#; We need an output mod after the chunk aggregation mods
	#; above, because things like untop expect to start from the final
	#; mod.
	Set outMod = mod.Asl.NextMod()
	Do mod.Main().NextAction().SetAsNest(outMod)
	Quit outMod.Index
}
#; Builds (in map) a map between aggmap-listed aggregates and their aggmap subscript entries
aggMapBuildValMap(map, join) {
	#dim join As %SQL.Engine.Objects.AlgJoin
	#; Map of aggmap values to use as we find the corresponding aggregate to calculate
	Set aggMapCount = join.AggMapCount()
	For i=1:1:aggMapCount {
		Set aggMap = join.AggMap(i)
		Set subscriptCount = aggMap.SubscriptCount()
		For j=1:1:subscriptCount {
			Set subscript = aggMap.Subscript(j)
			Set aggCount = subscript.AggValCount()
			For k=1:1:aggCount {
				Set map(subscript.AggVal(k).Index) = subscript
			}
		}
	}
}
#; Constructs a module to calculate a single aggregate
aggMapAggMod(map, agg, extentMap, mask, fromSuperclass) {
	#dim map As %SQL.Engine.Objects.MtsMap //optional, count(*) doesn't use
	#dim extentMap As %SQL.Engine.Objects.MtsMap
	#dim agg As %SQL.Engine.Objects.MtVal
	#dim mask As %SQL.Engine.Objects.MtMask
	
	Set mod = $$$oXasl.NextMod()
	Do mod.NextPrekey().SetAsInit(agg)
		
	//So far we only support "count" and "sum" out of the optimizer.
	If agg.Function() = "count" {
		Do aggMapCount(mod, extentMap, mask, map, agg)
	}
	Else {
		Do aggMapSum(mod, map, mask, agg, fromSuperclass)
	}
	Quit mod
}
#; Updates a mod to calculate a count() agg
aggMapCount(mod, extentMap, mask, map, count) {
	#dim mod As %SQL.Engine.Objects.AslMod
	#dim extentMap As %SQL.Engine.Objects.MtsMap
	#dim mask As %SQL.Engine.Objects.MtMask
	#dim map As %SQL.Engine.Objects.MtsMap
	#dim count As %SQL.Engine.Objects.MtVal
	//If there's a mask, it's the source of our count
	If mask.Exists() {
		Set key = $$aggMapMaskKey(mod, mask)
	}
	//Otherwise, use the extent bitmap
	Else {			
		Set key = $$aggMapExtentKey(mod, extentMap)
	}
	//Either way, we now have bit chunks, and we'll count them, using the map
	//if necessary for the "N" null slice
	Do aggMapCountChunks(mod, key, map, count)
}
#; Updates a mod to calculate a sum() agg
aggMapSum(mod, map, mask, sum, fromSuperclass) Public {
	#dim mod As %SQL.Engine.Objects.AslMod
	#dim map As %SQL.Engine.Objects.MtsMap
	#dim mask As %SQL.Engine.Objects.MtMask
	#dim agg As %SQL.Engine.Objects.MtVal
	
	#; The power currently being iterated
	Set power = mod.NewModVal("power")
.
	#; The aggregate for each power
	Set aggPower = mod.NewModVal("aggPower")
	
	Set chunkMod = $$aggMapChunkMod(map, power, aggPower, mask, fromSuperclass)
	Set powerMod = $$aggMapPowerMod(map, chunkMod, power, aggPower, sum)
	
	Do mod.NextAction().SetAsNest(powerMod)
}
#; The chunk mod for a sum() aggregate loops over the chunks of an individual power of a
#; bitslice index, masking if a mask is present, and aggregating a count
#; of bits: aggPower += (count(chunk) - 2 * count(negchunk&chunk))
aggMapChunkMod(map, power, aggPower, mask, fromSuperclass) Public {
	#dim map As %SQL.Engine.Objects.MtsMap
	#dim power As %SQL.Engine.Objects.MtVal
	#dim aggPower As %SQL.Engine.Objects.MtVal
	#dim mask As %SQL.Engine.Objects.MtMask
.
	Set mod = $$$oXasl.NextMod()
	Set key = mod.NextKey()
	#; The negative chunk indicates if the value for an id should be negated
	Set negChunk = mod.NewModVal("negChunk")
	Do key.Id().SetAsBitslice(map, negChunk)
	Do aggMapLoopOverConstants(key, map)
	#; For a given power
	Do key.NextNext().SetAsGivenPower(power)
	#; Iterate the chunks filtered with the mask
	Set chunkSub = mod.NewModVal("sub")
	Set chunk = mod.NewModVal("chunk")
	Do key.NextNext().SetAsBitChunk(chunkSub, chunk)
	//We don't want to apply the mask if it's a map (i.e. the extent bitmap
	//of this class) and the map we're reading originates in this class, since
	//in that case, all the bits in the map apply to this class.
	If mask.Exists()&&(mask.TempFile()||fromSuperclass) {
		Set maskChunk = mod.NewModVal("mask")
		If mask.TempFile() {
			Do mod.NextPostkey().SetAsBitChunkFromTemp(maskChunk, chunkSub, mask.TempFile())
		}
		Else {
			Set maskMap = mask.Map()
			Set maskPk = mod.NextPostkey().SetAsBitChunkFromMap(maskChunk, chunkSub, maskMap)
			Set subCount = maskMap.SubscriptCount()
			For i=1:1:subCount {
				Quit:'maskMap.Subscript(i).IsConstant()
				Do maskPk.SetMapSubscript(i, maskMap.Subscript(i).Constant())
			}
		}
		Do mod.NextPostkey().SetAsFilter(chunk, chunk, maskChunk)
	}
	#; Aggregate: count(chunk) - count(chunk&negchunk)
	Do mod.NextAction().SetAsAggregateNegCount(aggPower, chunk, negChunk)
	Quit mod
}
#; The power mod for a sum() aggregate loops over each power in the bitslice index,
#; and invokes the chunk mod to aggregate the slice count. It multiplies each
#; slice aggregate by its power and the index factor, and aggregates the sum
#; into agg.
aggMapPowerMod(map, chunkMod, power, aggPower, agg) {
	#dim map As %SQL.Engine.Objects.MtsMap
	#dim chunkMod As %SQL.Engine.Objects.AslMod
	#dim power As %SQL.Engine.Objects.MtVal
	#dim aggPower As %SQL.Engine.Objects.MtVal
	#dim agg As %SQL.Engine.Objects.MtVal
	
	#; Module to iterate through each "power" in the bitslice index
	Set mod = $$$oXasl.NextMod()
	Set key = mod.NextKey()
	#; While we're iterating over the power, we don't need the special
	#; negchunk handling of a bitslice Id
	Do key.Id().SetAsMap(map)
	Do aggMapLoopOverConstants(key, map)
	Do key.NextNext().SetAsPower(power)
	Do mod.NextPostkey().SetAsInit(aggPower)
	Do mod.NextPostkey().SetAsTemp(chunkMod)
	#; Get factor value from map. Why negative?
	Set factor = -map.BitsliceScale()
	Do mod.NextAction().SetAsAggregateSumP(agg, power, aggPower, "1E"_factor)
	Quit mod
}
#; Iterate over the WHERE BSL-constructed bit mask
aggMapMaskKey(mod, mask) Public {
	#dim mod As %SQL.Engine.Objects.AslMod
	//mask bits from WHERE as base of count
	#dim mask As %SQL.Engine.Objects.MtMask
	Set key = mod.NextKey()
	if mask.TempFile() {
		Do key.Id().SetAsChunkTempFile(mask.TempFile())
	}
	else {
		Set map = mask.Map()
		Do key.Id().SetAsMap(map)
		Do aggMapLoopOverConstants(key, map)
	}
	Quit key
}
#; Iterate over the extent bitmap
aggMapExtentKey(mod, map) Public {
	#dim mod As %SQL.Engine.Objects.AslMod
	//no WHERE clause/map, so we count the extent
	#dim map As %SQL.Engine.Objects.MtsMap
	Set key = mod.NextKey()
	Do key.Id().SetAsMap(map)
	Do aggMapLoopOverConstants(key, map)
	Quit key
}
aggMapCountChunks(mod, key, nullMap, count) {
	Set chunkSub = mod.NewModVal("chunkSub")
	Set chunk = mod.NewModVal("chunk")
	Do key.NextNext().SetAsBitChunk(chunkSub, chunk)
	// Do we care about excluding NULLS? (i.e. count(f), not count(*))
	// If so, we must have a bitslice map to pull the "N" subscript
	If nullMap {
		Do aggMapFilterNulls(mod, nullMap, chunkSub, chunk)
	}
	Do mod.NextAction().SetAsAggregateBitCount(count, chunk)
}
#; Given a module currently streaming chunks into (chunkSub, chunk),
#; read the corresponding N (null) chunk out of the bitslice map
#; and compute chunk = $bitop(chunk & ~nullChunk)
#; i.e.: Don't consider null values
aggMapFilterNulls(mod, map, chunkSub, chunk) {
	#dim mod As %SQL.Engine.Objects.AslMod
	#dim map As %SQL.Engine.Objects.MtsMap
	#dim chunkSub As %SQL.Engine.Objects.MtVal
	#dim chunk As %SQL.Engine.Objects.MtVal
	Set nullChunk = mod.NewModVal("nullChunk")
	Set nullChunkPk = mod.NextPostkey().SetAsBitChunkFromMap(nullChunk, chunkSub, map)
	Set subCount = map.SubscriptCount()
	For i=1:1:subCount {
		Quit:'map.Subscript(i).IsConstant()
		Do nullChunkPk.SetMapSubscript(i, map.Subscript(i).Constant())
	}
	Do nullChunkPk.SetMapSubscript(i, """N""")
	Set filterPk = mod.NextPostkey().SetAsFilterInverted(chunk, chunk, nullChunk)
}
#; In key, loop over any constant subscripts of map
aggMapLoopOverConstants(key, map) {
	#dim key As %SQL.Engine.Objects.AslKey
	#dim map As %SQL.Engine.Objects.MtsMap
	Set subCount = map.SubscriptCount()
	For i=1:1:subCount {
		Quit:'map.Subscript(i).IsConstant()
		Do key.NextNext().SetAsConstant()
	}
}
#; This function identifies the type of map given the imp
mapType(imp) [mt] PUBLIC 
{
	quit:imp="" 0
	if $d(mt("filterm",imp),filter) quit 0
	set smdimp=$s($d(mt("smdimp",imp)):mt("smdimp",imp),1:imp)
	set it=$$$smdMapIndexType(smdimp)
	set type=$s($$$smdMapMaster(smdimp)="Y":$$$MASTERMAP,it="BE":$$$EXTENTBITMAP,it="B":$$$BITMAPINDEX,it="S":$$$BITSLICEINDEX,it="CD":$$$COLUMNARDATA,it="CI":$$$COLUMNARINDEX,1:$$$INDEXMAP)
	quit type
}
#; This function identifies the extentSize given the imp
extentSize(imp) [mt] PUBLIC
{
	set size = 0
	quit:imp="" size
	if $d(mt("filterm",imp),filter) quit size
	set smdimp=$s($d(mt("smdimp",imp)):mt("smdimp",imp),1:imp)
	set irn = $$$smdMapIrn(smdimp)
	set size = $$$smdExtentSize(1,irn)
	quit size
}
#; given $$$mtV(val),check this subscript is looping on the sharded table
#; return > 0, loop on sharded table
#; return 0, otherwise
loopOnShardedTable(val) [ mt ] PUBLIC
{
	quit:val="" 0
	s v=$g($$$mtV(val))
	quit:v="" 0
	quit:$p(v,"^",3)="" 0
	s ifn = $p($p(v,"^",3),"_",1)
	quit:ifn="" 0
	s irn = $$$smdGetIrnFromIfn(ifn)
	quit:irn="" 0
	quit +$$$smdSharded(1, irn)
}
.
anyShardedTables() [ mts, mt ] PUBLIC {
	Set qn = ""
	For  {
		Set qn = $o(mts(qn)) QUIT:qn=""
		If +qn=0 CONTINUE //mts("AGG")
		Set str = ""
		For  {
			Set str = $o(mts(qn,str)) QUIT:str=""
			If $g($$$mtRVirtual(str)) CONTINUE
			Set map0 = $p($g(mts(qn,str)),"^",4)
			If 'map0 CONTINUE
			If '$$$smdMapExists(map0) CONTINUE
			Set irn = $$$smdMapIrn(map0)
			If 'irn CONTINUE
			If $$$smdSharded(1,irn) RETURN 1
		}
	}
	RETURN 0
}
.
#;HSU278
#;HSU301+
callbackRMLSCollation
	if ev="v",'found {
		n ii,vv
		f ii=4:1:$l(v,"^") { 
			i $p(v,"^",ii)'="",$g($$$mtV($p(v,"^",ii)))[ "v^%RMLSP^" {
				s vv = $g($$$mtV($p(v,"^",ii)))
				if $$$mtVType($$$mtV($p( $p(vv,"^",3),",",2)))'= "f" QUIT
				if $l($p($$$mtV($p( $p(vv,"^",3),",",2)),"^",3),"_")=2 set found=1 QUIT
			}
		}
	}
	if 'found GOTO lviterarg^%qaqpnl
	QUIT
#;HSU301+
checkRMLSPCollation()
	n call,found
	s found = 0,call = "callbackRMLSCollation^%qaqpagg"
	d lvsubquery^%qaqpag(m)
	QUIT found
	
#;HSU301
#;HSU312+
callbackUnSupportedFunc
	if ev="v",'found {
		new vval set vval=$p(v,"^",2)
		s:vval["USERDEFINEDFUNCTION:%SYSTEM.SQL:GetROWID:%SYSTEM.SQL_GETROWID" found=1
		s:vval="SYSVAR:$J" found=1
		s:vval="SYSVAR:$JOB" found=1
		s:vval="SYSVAR:$ZJ" found=1
		s:vval="SYSVAR:$ZJOB" found=1
		s:vval="SYSVAR:$TL" found=1
		s:vval="SYSVAR:$TLEVEL" found=1
	}
	if 'found GOTO lviterarg^%qaqpnl
	QUIT
checkUnSupportedFunc()
		#; No parallel if this query has a PREDICT function.  PREDICT may cause re-entrancy via the Gateway back into IRIS
		#; We have found when the SQL query is parallel, for Java based providers that use re-entrancy, we have issues with WorkQueueMgr jobs
		#; performing work that requires re-entrancy.  It might have to do with the gateway and TCP/SHM devices trying to be shared between the processes
		#; We might try and correct those isssues in the future, but for now PREDICT queries will not use parallel
	quit:$d(mt("qmlb")) 1  // PREDICT
	n call,found
	s found = 0,call = "callbackUnSupportedFunc^%qaqpagg"
	d lvsubquery^%qaqpag(m)
	QUIT found
#;HSU312-
couldParallel()
	#; if there are more constraints found in the future, put all the check logic in here.
	
	#; disable parafile if INSERT/UPDATE/DELETE and not %NOLOCK
	Quit:($$$mtKNoLockFlag($g($$$mtK))'=1)&&("INS UPD DEL"[$$$mtStatementType) 0
	#; If INS and not DML_PARALLEL option, don't use parallel
	if $$$mtStatementType="INS" && ('$g(mt("options","DML_PARALLEL"))) { RETURN 0 }
	QUIT:$$checkRMLSPCollation 0
	QUIT:$$checkUnSupportedFunc 0
	QUIT:$g($$$mtCollationMismatchMarker) 0 
	QUIT 1
	
adjustedThreshold(sharded=0)
	QUIT:sharded ($$$AutoParallelThreshold) * 32
	QUIT $$$AutoParallelThreshold
.
adjustedLooping(looping,m) [mt,mts] public {
	#; Adjusted looping in decideParallel^%qaqpagg for columnar queries
	Set str=$o(mts(m,""))
	Set costpervec = 0 
	for i=1:1:$ll($$$mtVecTree(str)){
		set num = +$lg($$$mtVecTree(str),i)
		if num>0 {
			if $e($$$mtV(num),1) = "f" {
				// reading a columnar field has a cost of 1 per vector chunk
				Set costpervec = costpervec+1
			} elseif $e($$$mtV(num),1) = "a" {
				// computing aggregate has a cost of 150 per vector chunk
				Set costpervec = costpervec+150
			} else {
				// others have a cost of 50 per vector chunk
				Set costpervec = costpervec+50}
		} else {
			// eveluating a condition using vector operations has a cost of 20 per vector chunk
			Set costpervec = costpervec+20 
		}
	}
	Set:$g($$$mtSequencersQb(m)) costpervec = costpervec+120 // ORDER BY add a cost of 120 per vector chunk 
	Set:$g($$$mtGroupDistinctList(m)) costpervec = costpervec+300 //GROUP BY add a cost of 300 per vector chunk 
	Set:(costpervec=0) costpervec=1 // if no significant action found then assign costpervec as 1
	Return looping*costpervec/64000
}
#; This function decides should we parallel this query or not.
decideParallel() [m,mod,mt,mts,asl,sldst,onerow,sol,%mcost,alg] PUBLIC
{
	#;This functions would decide it is worthy parallelel or not based on the looping degree of the module m
	#;Initially the looping degree would be the extent size of this table. 
	#;First,lup1() would return first looping subscript (fls) whose type is definitely not "u" (unique looping)
	#;Based on fls, we check is there selectivity estimate on fls by check "RANGE" in mts(), if so, we multiply the looping degree
	#;with the selectvity associated with this fls in mts() array.
	#;Second, we traverse any subscripts which are preceding fsl whose type is "u"
	#;and check where we could find any "CON" int mts(),
	#;if so, multiply the looping degree with this associated selectivity.
	quit:$g($$$BuildSysFlag) 0
	#;HSU313+ only enable parallelism for IUD if both DML_PARALLEL and %NOLOCK are present.
	quit:(($$$mtStatementType="UPD")||($$$mtStatementType="DEL")||($$$mtStatementType="INS"))&&(($$$mtKNoLockFlag($g($$$mtK))'=1) || ($g(mt("options","DML_PARALLEL"))'=1) ) 0
		#; No parallel if this query has a PREDICT function.  PREDICT may cause re-entrancy via the Gateway back into IRIS
		#; We have found when the SQL query is parallel, for Java based providers that use re-entrancy, we have issues with WorkQueueMgr jobs
		#; performing work that requires re-entrancy.  It might have to do with the gateway and TCP/SHM devices trying to be shared between the processes
		#; We might try and correct those isssues in the future, but for now PREDICT queries will not use parallel
	quit:$d(mt("qmlb")) 0
	set useAPE=$$decideAPE(m)
	#;HSU313-
	s anysharded = $$anyShardedTables()
	#; HSU291+
	quit:('useAPE)&&$$hint^%qaqpre("%INORDER",m) 0
	#; HSU291-
	quit:'$$$AutoParallel 0
	quit:$$$SQLCompileOption("Parallel")=0 0
	quit:$$hint^%qaqpre("%NOPARALLEL",m) 0
	quit:($$$mtStatementType'="UPD")&&($$$mtStatementType'="DEL")&&($$$mtStatementType'="INS")&&(+$g(mt("querylock"))=1) 0
.
	set md=$$$aslTopSubqMod(mod)
	quit:('useAPE)&&($g(mt("complexlog",m))'="") 0
	set val=$$lup1(.kid,.str,.ifn,.loc,.set,,,.useAPE)  ;  find first looping subscript value
	if 'val {
		//is there a view as the initial stream? can reverse engineer this from asl
		set visq = $g($$$asl0ViewNestingInfo(md+1))
		RETURN:'visq 0
		//TODO: need a heuristic
		RETURN 1
	}
    quit:'val 0  ;  there isn't any, or the first one did not qualify
    quit:set 0 ; no auto-parallel for set yet
	If 'useAPE {
		set collation = $p($$$mtV(val),"_",2)
		i (collation="%SPACE") || (collation="%ALPHAUP") || (collation="%STRING") || (collation="%UPPER") quit 0
	}
    #; if this is not a sharded table, we must ensure this query comes from xDBC
	s shardtype = $$loopOnShardedTable(val)
	#;quit:((shardtype <= 0) && ('$$$SQLCompileOption("xDBC"))) 0
	
	#;check loop on shard server or not, if so, never(!! TRW) %PARALLEL
	#;QUIT:(shardtype=2) 0 
	#; If this is a sharded query, but the lup1 is not the sharded table but the table on the shard master, don't do it.
	QUIT:(shardtype'=2)&&anysharded 0
	
	#;check other non trivial conditions
	Set irn=+$$$mtR(str)
	Quit:'$$isTuned^%qaqpsq(irn) 0
.
	If $g($$$mtTopArg(m)),+$g($$$mtSequencersQb(m)),'$$useTempFile(.sol) { Return 0}
.
	set imp=$p(kid,$c(1),2)
	set mapType = $$mapType(imp)
	if $p($g(alg(1)),"^",23)["IC8M"{ 
		if +$$$Mcost(m,1,1,","_str_",")>=(320*$$adjustedThreshold(anysharded)),+mts(m,str)>=(1250*$$adjustedThreshold(anysharded)),( (+$$$Mcost(m,1,1,","_str_","))/(+mts(m,str)) )>=(0.00003125*$$adjustedThreshold(anysharded)) QUIT 1
		QUIT 0	
	}
	
	if ((mapType = $$$MASTERMAP) || (mapType = $$$INDEXMAP) || (mapType = $$$BITMAPINDEX) || ((mapType = $$$EXTENTBITMAP)&&useAPE))
	{
		set looping = $$extentSize(imp)
		set:$g($$$mtQbUsesCdmag(m)) looping = $$adjustedLooping(looping,m)
		set module = $p(loc,"^",1)
		set sn = $p(loc,"^",2) - 1
		set selectivity = ""
		
		;if ifn is null, we retrieve the ifn by ourself.
		set:ifn="" ifn = $p($g($$$mtV(val)),"^",3)
		set:str="" str = $p($g($$$mtV(val)),"^",2)
		if (str'="") && (ifn'="") && ($g(mts(m,str,"RANGE",ifn))) && ($p(mts(m,str,"RANGE",ifn),"^")'="")
		{
			set looping = looping * (+$p(mts(m,str,"RANGE",ifn),"^"))
		}	
		#; meet at most one "u" type subscript?
		while (sn >= 1) && ($g($$$aslKNext(module,1,sn))'="")
		{
			set type = $$$aslNextLoopingType($$$aslKNext(module,1,sn))
			if type = "u"{
				set id = $$$aslNextSubscriptVal($$$aslKNext(module,1,sn))
				set list = $g($$$mtV(id))
				set:(list'="") ifn = $p(list,"^",3)
				set:(list'="") str = $p(list,"^",2)
				set:(ifn'="")&&(str'="") selectivity = $g(mts(m,str,"CON",ifn))
				set:(selectivity'="") selectivity = $p(selectivity,"^")
				set:(selectivity'="") looping = looping * (+selectivity)
			}
			set sn = sn - 1
		}
		do estimatePreProcTempfileSize^%qaqpmod
		set outtup = ""
		set intup = $$countScannedTuples(module,sn,looping,1,.outtup,.hasTuneTableStats)
		Return:'hasTuneTableStats 0
		#;aggregates ensure a small output
		if ($g($$$mtEmpty(m)) = 1) {
			set intup = 0
			set outtup = 0
		} elseif ($g($$$mtOneRow(m)) = 1) {
			set outtup = 1
		} elseif ($d($$$mtGroupDistinctList(m),groups) '= 0) {
			set rows = 1
			for i = 1:1:$l(groups,",")-1 {
				set val = $p(groups,",",i)
				if ($$$mtVType($$$mtV(val)) = "f") {
					set selectivity = $$getValSelectivity^%qaqpag(val)
				} elseif ($$$mtVType($$$mtV(val)) = "v") {
					set selectivity = $DOUBLE("INF")
					set vals = $p($$$mtV(val),"^",3) 
					if ($l(vals,",") > 2) {
						for j=2:1:$l(vals,",")-1 {
							set partsel = $$getValSelectivity^%qaqpag($p(vals,",",j))
							if (partsel < selectivity) { set selectivity = partsel }
						}
					}
				} 
				if (+selectivity '= 0) { set rows = rows * (1/selectivity) }
				if (rows >= intup) { //(MAX possible decimal) to avoid <MAXNUMBER> error)
					set rows = intup
					quit
				} 
			}
			set outtup = rows
		}
		if (intup=0) { quit 0 }
		// use outtup to improve the estimation in mt("ntuplen",m)
		set $p($$$mtNumTupleAndAvgLen(m),",",1) = outtup
		set paraSelectivity = outtup/intup
		#;The final decision depends on the number of tuples processed in parallel as well as the ratio of the number returned/number processed
		#;the value 0.5 was selected based on a benchmark of randomly generated queries 
		if (intup >= (1*$$adjustedThreshold(anysharded))) { 
			If (paraSelectivity < 0.5) {Quit 1}
			Elseif (($g(mt("options","DML_PARALLEL"))=1) && (($$$mtStatementType="UPD")||($$$mtStatementType="DEL")||($$$mtStatementType="INS"))) {Quit 1}
			Elseif ($ll($$listvtreeqb(m, $lb("v^VECTOR_DOT_PRODUCT^","v^VECTOR_COSINE^"),0))) {Quit 1}
		}
	}
	quit 0
}
setexref(m) [mt,prm] {
	for i=1:1:$ll($g(prm("streams"))) {
		set str=$li(prm("streams"),i)
		if $d(mt("shref",str),mt("sql",m,"exref","T"_str)) {}
	}
}
	#; lvtree-based "whole subquery" scan. Given a subq #, lvtree over entire "root set" 
lvitersubqAPE(qn,issubquery) [ mt, opex ] public {
	QUIT:'qn
	//TOP
	Do lvtree^%qaqpnl("v",$g($$$mtTopArg(qn)))
	//OFFSET
	Do lvtree^%qaqpnl("v",$g($$$mtOffset(qn)))
	//IPQ outputs
	For i=1:1:$l($g($$$mtAPEWorkerOutputs(qn)), ",") {
		Set v = $p($g($$$mtAPEWorkerOutputs(qn)),",",i) 
		Do lvtree^%qaqpnl("v",v)
	}
	// fields used by workers when a shared global is used in parallel aggregation (from build^%qaqcct)
	If $$$parAggUsesSharedGlobal(qn) {
		For i=1:1 {
			Set v=$p($p($g($$$mtAPESharedGlobal(qn)),"^",3),",",i)
			QUIT:'v
			Do lvtree^%qaqpnl("v",v)
		}
	}
	// query block outputs (for queries that use cdmag plans, indag plans, are subqueries of the parallelized query block, or use a shared global temp-file)
	If $g($$$mtQbUsesCdmag(qn))||$g(mt("indag",qn))||$g(mt("colisalg",qn))||issubquery||$$$parAggUsesSharedGlobal(qn) {
		For i=1:1 {
			Set v = $p($$$mtOutputVals($g($$$mtOutput(qn))),",",i) QUIT:'v
			Do lvtree^%qaqpnl("v",v)
		}
	}
	// arguments to TVF queries (if any)
	Set str=""
	For str=1:1:$$$mtRNumStreams{
		If (($$$mtRQb($$$mtR(str))=qn)) && ($d($$$mtTvfParams(str),tvfArgs) && (tvfArgs '= $c(0))) {
			For i=1:1:$ll(tvfArgs){
				Do lvtree^%qaqpnl("v",$lg(tvfArgs,i))
			}
		}
	}
	//OUTER JOIN (note this must be post ON/linx transformation)
	For i=1:1 {
		Set l = $p($g($$$mtLeftOuterJoins(qn)),",",i) QUIT:'l
		Do lvtree^%qaqpnl("l",l)
	}
	//WHERE
	For i=1:1 {
		Set l = $p($g($$$mtWhere(qn)),"^",i) QUIT:'l
		Do lvtree^%qaqpnl("l",l)
	}
	//HAVING
	Do lvtree^%qaqpnl("l",$g($$$mtHaving(qn)))
	//GROUP BY
	For i=1:1 {
		Set v = $p($g($$$mtGroupDistinctList(qn)),",",i) QUIT:'v
		Do lvtree^%qaqpnl("v",v)
	}
	//ORDER BY
	For i=1:1 {
		Set v = +$p($g($$$mtSequencersQb(qn)),",",i) QUIT:'v
		Do lvtree^%qaqpnl("v",v)
	}
	//UNION
	For i=1:1 {
		Set uqn = +$lg($g($$$mtUnion(qn)),i) QUIT:'uqn
		Do lvtree^%qaqpnl("v",$$$mtPQbVal($$$mtP(uqn)))
	}
	//OPEN code
	For i=2:1:($l($g(opex),",")-1){
		Do lvtree^%qaqpnl("v",$p(opex,",",i))
	}
}
#; ========= listvtreeqb BEGIN 
listvtreeqb(qn,lpref,issubquery) 
    #; search all subtrees of query block qn, for all the mt("v") nodes that start 
	#; with any of the prefixes in lpref=$LIST(prefix), return them in found=LIST(val#,)
	#; this function is created based on listreeqb^%qaqpmod
	n found,call s found="",call="vpref^%qaqpagg"
	d lvitersubqAPE(qn,issubquery)
	QUIT found  ;  return all that were found 
#define adnodup s:'$lf(found,val) found=found_$lb(val)
vpref;  check for any prefix in lpref, called from listree->lvtree with type,val,v,ev	
	i ev="q" { 
		f lv=2:1:$l(v,",")-1 d lvtree^%qaqpnl("v",$P(v,",",lv)) ; correlated fields
		f lv=4:1:$l(v,"^")-1 d lvtree^%qaqpnl("v",$P(v,"^",lv)) ; arguments of the subquery
	}  
	i ev="n" {
		d lvtree^%qaqpnl("v",$P(v,"^",4))
	}
	f lv=1:1:$ll(lpref) {
		s lv(1)=$li(lpref,lv) 
		i lv(1)=$e(v,1,$l(lv(1))),(type="v") { $$$adnodup Quit}
	}
	i ev="x",$p(v,"^",2),$lf(lpref,"n"),(type="v") { $$$adnodup }
	GOTO lvarg^%qaqpnl  ;  recurse down
#; ========= listvtreeqb END 
 #; find the list of variables prm that the parent process needs to pass to the workers
 #; prm = $lb(var#1, var#2, ...)
findprm(m, issubquery = 0) [mt, asl, corrm,opex] public {
	// obtain a list of candidate variables for query block "m"
	Set varlist =$$listvtreeqb(m, $lb("x","q","n","l^L2V^","c","s","y","v","t"),issubquery) ; "c","s" and "y" might not be needed
.
	// add the unique given constant for "u" loops to varlist. Code modified based on some code in maplev^%qaqcbsl
	Set beginmd = $s(issubquery:$$$mtPFirstASLModule($$$mtP(m)),1:$$$topWorkerModule(m))
	Set endmd = $s(issubquery:$$$mtPLastASLModule($$$mtP(m)),1:$$$bottomWorkerModule(m))
	For md=beginmd:1:endmd {
		Set kid=""
		For {
			Set kid = $o($$$aslK(md,kid))
			Quit:kid=""
			Set nidx = ""
			For {
				Set nidx = $o($$$aslKNext(md,kid,nidx),1,stuff)
				Quit:nidx=""
				If $$$aslNextLoopingType(stuff)="u",+$$$aslNextLoopingLowLimOrSetVar(stuff) {
					Set vidx = +$$$aslNextLoopingLowLimOrSetVar(stuff)
					Set:$$$mtVType($$$mtV(vidx))="t" varlist = varlist_$lb(vidx)
				}
			}
		}
	}
	// go through the list of variables and decide if each of them needs to be added to prm
	// the code below is a simplyfied version of vertVal^%qaqcmh
	Set prm = ""
	Set ptr = 0 While $listnext(varlist,ptr,vidx){
		Continue:$g($$$mtV(vidx))="" // shuould not happen, but leaving this check here just in case
		Continue:('issubquery)&&(vidx=$g(mt("sql",m,"set"))) // no need to pass the set variable over if we are paritioning over this set 
		Set v= $$$mtV(vidx)
.
		If $e(v)="v"{
			If ",%ALPHAUP,%UPPER,%SQLSTRING,%SQLUPPER,%STRING,%SPACE,%PLUS,%MINUS,%MVR,%TRUNCATE,"[(","_$p(v, "^", 2)_","),'$bit($g(mt("localoref")),vidx),$$nogenval^%qaqcmh("v",vidx){
				Set:'$lf(prm,vidx) prm = prm_$lb(vidx)
			}
			Continue
		}
.
		If $e(v)="x",v=("x^"_+$e(v,3,*)),v'="x^0" { ; lateral field  ;  AK850
			s val=$e(v,3,*) 
			If $lf($g(corrm),val) Set:'$lf(prm,vidx) prm = prm_$lb(vidx)
			Continue
		}
.
		If $e(v) = "x" { ; list of parameter
			Set:'$lf(prm,vidx) prm = prm_$lb(vidx)
			Continue
		} 
		If $e(v) = "t" { ; list of constant
			Set:'$lf(prm,vidx) prm = prm_$lb(vidx)
			Continue
		} 
.
		If $e(v)="n" { ;  AK932
			s val=$p(v,"^",4) 
			If $lf($g(corrm),val) Set:'$lf(prm,vidx) prm = prm_$lb(vidx) Continue
			If (","_$$$mtPCorrelatedFields($$$mtP(m)))[$p($$$mtV(val),"^",3) Set:'$lf(prm,vidx) prm = prm_$lb(vidx) Continue
		}
.
		If $e(v,1,6)="l^L2V^" { // conditions 
			// code here is based on parseCond^%qaqcmh
			Set logNum = $piece(v,"^",4)
			Set val=$$$mtL(logNum)
			#; Restore original condition for %FIND/%INSET filters
			set val = $$invertFilter^%qaqcmh(logNum)
			#; Remove implicit collations on LIKE arguments
			set val = $$removePatternCollation^%qaqcmh(val)
			#; Don't regenerate %STARTSWITH conditions that were implied by a LIKE
			if $$isImpliedStartsWith^%qaqcmh(val) Continue
.
			i $p(val,"^",3)=",",$$nogenval^%qaqcmh("l",logNum) Set:'$lf(prm,vidx) prm = prm_$lb(vidx) Continue  ;  AK1021
			
			i $e(val,1,10)="v^FOR SOME" {  ;  AK941;AK1021
				s qn=$p($$$mtV($p(val,"^",4)),"^",2),unlocal="",unsend=""
				d unlegs^%qaqcmh(qn)  ;  construct $LIST(m) of local/sent UNION legs
				#;  PVA183: kill unnecessary TOP probably added by Cache - in case remote server doesn't support it
				If unlocal { 
					#;  for UNION:  EXISTS(A(f2) UNION B UNION C(f3) UNION D)
					#;  gives:  unlocal=$LIST(B,D), unsend=$LIST(A,C)
					#;  generate code:  SET d5=eval(EXISTS(B UNION D))
					#;  and reconstruct query:  (:d5=1 OR EXISTS(A(f2) UNION C(f3)))
					
					;  redo mt("union"/"untop")
					d reunion^%qaqcmh(unlocal)
					Set vidx = $$$mtPQbVal($$$mtP($li(unlocal)))
					Set:'$lf(prm,vidx) prm = prm_$lb(vidx)
					Continue
				}
			}
.
		}
.
		If $p(v,"^",3)=",",'$bit($g(mt("localoref")),vidx),$$nogenval^%qaqcmh("v",vidx),'(($e(v)="q")&& ($d(mt("svso",$p(v,"^",2))))) {
			;  AK1021
			Set vidx = $$localEval^%qaqcmh(vidx)
			Set:'$lf(prm,vidx) prm = prm_$lb(vidx)
			Continue
		}  
.
		If $e(v)="q" {  ;  AK1021
			s qn=$p(v,"^",2),unlocal="",unsend=""
			d unlegs^%qaqcmh(qn)  ;  construct $LIST(m) of local/sent UNION legs
			i unlocal { 
				#;  for UNION:  7+(A(f2) UNION B UNION C(f3) UNION D)
				#;  gives:  unlocal=$LIST(B,D), unsend=$LIST(A,C)
				#;  generate code:  SET d5=eval(B UNION D)
				#;  and reconstruct query:  7+COALESCE(:d5,(A(f2) UNION C(f3)))
				
			  	;  redo mt("union"/"untop")
				d reunion^%qaqcmh(unlocal)
				Set vidx = $$$mtPQbVal($$$mtP($li(unlocal)))
				Set:'$lf(prm,vidx) prm = prm_$lb(vidx)
				Continue
			} else {
				// this is a correlated subquery, therefore we need to add the variable that are needed by this subquery to prm 
				Set subqprm = $$findprm(qn,1)
				for subi = 1:1:$ll(subqprm) {
					Set:'$lf(prm,$lg(subqprm, subi)) prm = prm_$lb($lg(subqprm, subi))
				}
			}
		}
	}
.
	// add NULL constants and "once" variables from once^%qaqcpre to prm
	Set vidx = ""
	For {
	    Set vidx= $o($$$mtV(vidx),1,v)
		Quit:vidx=""
		If (v = "t^")||(v="i^once") {
			Set:'$lf(prm,vidx) prm = prm_$lb(vidx)
		}
.
	}
.
	// If there are expressions that depend on correlated subqueries in the select list, 
	// pass the parameters that are needed by these correlated subqueries to the workers
	If +$g($$$mtAPESelListCorrSubq(m)) {
	
		// find the subquery numbers from the selected variables  
		Set corrsubqs = $$hasCorrelatedSubQ^%qaqpagg($$$mtAPESelListCorrSubq(m))
		For i=1:1 {
			Set qn = $p(corrsubqs,",",i) QUIT:qn=""
			Set subqprm = $$findprm(qn,1)
			for subi = 1:1:$ll(subqprm) {
				Set:'$lf(prm,$lg(subqprm, subi)) prm = prm_$lb($lg(subqprm, subi))
			}
		}
	}
.
	// add variables that are needed by views directly under this query block
	For qn=1:1:$$$mtPNumQbs {
		If $$$mtPQbIsActive(qn), m'=qn, (+$$$mtP(qn)=m), $$$mtPViewIDVal($$$mtP(qn)) {
			Set viewprm = $$findprm(qn,1)
			For subi = 1:1:$ll(viewprm) {
				If $e(v)="n" { ;  AK932
					Set val=$p(v,"^",4) 
					If '$lf($g(corrm),val) && ('((","_$$$mtPCorrelatedFields($$$mtP(m)))[$p($$$mtV(val),"^",3))) Continue
				} 
				Set:'$lf(prm,$lg(viewprm, subi)) prm = prm_$lb($lg(viewprm, subi))
			}
		}
	}
	
	Quit prm 
.
}
.
constructWorkerSQLQuery(m,parag,prm,windows,useCAST,useCOAL,sel,vv,set,val,visParallel,sldst,asOriginal)[mt] public {
	#; construct SQL query text for workers for non-columnar %parallel queries
	#; results saved in subfields of $$$mtSql(m)
.
	s prm="",useCAST=1,useCOAL=1,sel=""  ;  calls accumulate prm=$LB(parm)
	#; AK902
	#; contextual argument to all ^%qaqcmh regeneration functions to reproduce as close to original query
	#; as possible, including Cache-isms like %STARTSWITH.
	s asOriginal=1
	#; regenerate top clause first so parameter order is correct, insert it later
	set topClause = "", top = $g($$$mtTopArg(m)), topStyle = $g($$$mtTopStyle(m)) 
	#;HSU302 genDistinctBy
	s dstby = $$genDistinctBy
	if top, topStyle = "TOP" {
		#; we may need the top to preserve the plan choice, but if we're grouping
		#; by something that could be spread amongst multiple partitions (i.e., non-gruplup)
		#; then we need every row from each partition, not just the top n
		if $$$mtParag(m)'="gruplup", sldst {
			s topClause = "TOP ((9999999999999)) "
		}
		#; need every row to sort on a window function we haven't evaluated yet
		elseif $$optimizerSort(m)'=$g($$$mtSequencersQb(m)) {
			s topClause = "TOP ((9999999999999)) "
		}
		else {
			s topClause = $$genTop^%qaqcmh(top)  ;  AK1086
		}	
	}
	
	f ai=1:1:$l(parag,",")-1 s sel=sel_","_$$vertVal^%qaqcmh(.mt,$p(parag,",",ai))
	#; AK902-
	#; AK907
	s:sel="" sel=",1"  ;  parag empty, no SELECT-list needed
	s $e(sel)=$$genSELECT^%qaqcmh(m)_" "_$s(windows:"",$l(dstby):dstby,$g($$$mtDistinct(m),"none")="":"DISTINCT ",1:"")_topClause  ;  replacing the 1st comma
	d:m=1 parafile  ;  for parallel DML filing, override sel,prm  ;  AK1007	
	s $$$mtSqlSelect(m)=sel
	s $$$mtSqlFrom(m)=$$genfrom^%qaqcmh(m,1)
	s pWhere = $$parseWhere^%qaqcmh(m)  ;  TRW1482;AK983
	#;HSU278+
	#;if %PARALLEL is decided by decideParallel(), we should not add %PARALLEL into the generated query. In other words,
	#;the generated query could be parallellel executed ifg the esitmated cost is also lower than the threshold.
	#;if $$$mtSqlFrom(m)[ " %PARALLEL ",parallelbyauto=1 s $$$mtSqlFrom(m) = $replace($$$mtSqlFrom(m)," %PARALLEL "," ") 
	#;HSU278-
    #;HSU242+ if mt("%PARALLELGROUPBY",m) is ON, we do not attempt to do parallelization for any child queries
    #;This means, even if the query GROUP BY "a,b,c" fields, we only do parallelization on "a" field.
    #;This is the reaons why we could set mt("parag",m)="gruplup" early on.
	#;s:$g(mt("%PARALLELGROUPBY",m)) mt("sql",m,"f rom") = $replace($$$mtSqlFrom(m)," %PARALLEL "," %NOPARALLEL ") 
    #;HSU242-
    do setexref(m)  ; set external references needed to be marshalled in mt("sql",m,"exref","T"_str)=Tnn
    s $$$mtSqlWhere(m)=pWhere,$$$mtSqlPrm(m)=prm,prm=""
	//For set member queries, add the appropriate connective for the set predicate
	if set s $$$mtSqlWhere(m)=$$$mtSqlWhere(m)_$s($l(pWhere)>0:" AND",1:" WHERE")
	s vv = $$vertVal^%qaqcmh(.mt,val)
	if visParallel {
		//Could teach vertVal about this rather than copying its conventions
		Set $p(vv,".",1) = "T"_$p($$$mtV($$$mtPQbVal($$$mtP(visParallel))+1),"^",2)
		//Always the last item in the SELECT list, per above
		Set $p(vv,".",2) = "C"_($l($$$mtOutputVals($$$mtOutput(visParallel)),",")-1)
	}
	s $$$mtSqlPartitionFunc(m)=vv, $$$mtSqlPartitionVal(m)=val
	s $$$mtSqlGroup(m)=$$gengroup^%qaqcmh(m),$$$mtSqlGroupPRM(m)=prm,prm=""
	#; ORDER BY only needs to contain the optimizer-relevant orderings in ptfjoo(m)
	s colsIdxLst = parag //for genord's use
	s $$$mtSqlOrd(m)=$$genordvals^%qaqcmh(m,$$optimizerSort(m),parag),$$$mtSqlOrdPRM(m)=prm,prm=""
	set:"TOP"'[topStyle $$$mtSqlPagination(m)=$$genPagination^%qaqcmh(m) // since each pagination clause (LIMIT/FETCH or OFFSET) will only correspond to one val, no item to add to mt("sql",m,"pngprm") 
	Quit
}
.
/// check if we have enough memory for vector joiner temp-files to run query block m in parallel
VJMemoryOK(m) [mt] PRIVATE {
	Return:'$data(mt("vjsize",m)) 1 // no vector joiner for this query block, return 1
.
	Set numWorker = $zutil(204,5)
	Set totalVJsize = 0  ; the total size of all the vector joiners in this query block
	
	//compute the total size of all the vector joiners in this query block
	Set joi = ""
	For {
		Set joi = $o(mt("vjsize",m,joi))
		Quit:joi=""
		Set totalVJsize = totalVJsize+mt("vjsize",m,joi)
	}
.
	//check if there will be enough memory for numWorker copies of the vector joiner tempfiles (instead of just 1 copy)
	Return:((numWorker-1)*totalVJsize+mt("vjsize"))>$$getVJMemory^%qaqpmod() 0
.
	// update mt("vjsize") if we decided to use parallelization 
	Set mt("vjsize") = (numWorker-1)*totalVJsize+mt("vjsize")
	Return 1
}
.
 #; return True if this query is supported by current implementation of Adaptive Parallel Execution (previously named as columnar parallel); False if not
decideAPE(m) [mt] PUBLIC {
	RETURN:('$$couldParallel^%qaqpagg) 0 	
	RETURN:$g(mt("hint",m,"%NOPARALLEL")) 0
.
	RETURN:$$windowsInSubq(m) 0 // not supporting windows functions at this moment
.
	If (m=1)&&("UPD DEL INS"[$$$mtStatementType)&&('$g($$$mtInsertUpdateNeedsTf)) {
		Return 0
	}
	
	If '($g($$$mtQbUsesCdmag(m))||$g($$$mtQbUsesCdmp(m))||$g(mt("colisalg",m))) {
		Return:(($$$mtStatementType="UPD")||($$$mtStatementType="DEL")||($$$mtStatementType="INS")) 0 
	}
.
	// ; embeddedSQL without UCQ
	Set isEmbeddedSQL = '(($$$SQLCompileOption("DynamicSQL")=1) || ($$$SQLCompileOption("xDBC")=1) || ($extract($get(%caller),1,8)="ShowPlan"))
	RETURN:isEmbeddedSQL&&($g(%classname)="") 0 
.
	RETURN 1	
}
.
#; modified based on cdsort^%qaqpag
#; return 1 if a temp file was build for ORDER BY, 0 if not
hasOrderByTempFile(m)[asl, mt, mts] PRIVATE {
	Set str=$o(mts(m,"")),irn=+$$$mtR(str)
	Set grp = $g($$$mtGroupDistinctList(m)),idifn=$p($g(mts(m,str)),"^",5),idval=$p($g(mts(m,str,"ATT",idifn)),"^",5)
.
	RETURN:'$g($$$mtSequencersQb(m)) 0  ;  no ORDER BY
	i ($$$mtSequencersQb(m)=grp),($l(grp,",")=2) { RETURN 0 } ; YCL217
	i ($tr($$$mtSequencersQb(m),"d")=grp),($l(grp,",")=2) { RETURN 0 } ; YCL217
	i $$$mtSequencersQb(m)=grp { RETURN 0 }
	i $tr($$$mtSequencersQb(m),"d")=grp { RETURN 0 }
	RETURN:grp 1  ;  GROUP BY, no more tricks
	RETURN:$$$mtSequencersQb(m)=(idval_",") 0  ;  ORDER BY %ID
	RETURN:$$$mtSequencersQb(m)'=(idval_"d,") 1
	RETURN 0
}
.
#; additional worker ASL set up
setUpWorkerASL(m)[mt,asl,mts,%caller] PUBLIC {
.
	// Set the ACTION of the last worker module to be sending value via ipq
	Set md = $$$bottomWorkerModule(m)
	if '$$$parAggUsesSharedGlobal(m) { // EEE016 eliminated the use of IPQs when parallel aggregation uses a shared global
		Set $$$aslAct(md,1+$o($$$aslAct(md,""),-1)) = "ipq"_$c(1)_$$$mtAPEWorkerOutputs(m)
	}
.
	if $g($$$mtQbUsesCdmag(m))||$g(mt("colisalg",m)){
	// remove the conditions that are not in WHERE and are not applied via vops
	// these conditions will be applied row-by-row in the master process
		Set md = $$$topWorkerModule(m), str=$o(mts(m,""))
		For{
			Set pkIdx = ""	
			For {
				Set pkIdx = $order($$$aslPk(md,3,pkIdx),1)
				Quit:(pkIdx="")
				If $g($$$aslPkConds(md,3,pkIdx)){
					Set cond = $g($$$aslPkConds(md,3,pkIdx))
					if '$lf($g($$$mtVecTree(str)),"-"_cond) && (("^"_$g($$$mtWhere(m)))'[("^"_cond_"^")) {
						Kill $$$aslPkConds(md,3,pkIdx) 
					}
				}
			}
			Set md=$order($$$aslMod(md),1)
			Quit:(md="")||(md>$lg($$$mtAPEWorker(m), 2))
		}
	}
.
	// remove top-level-AND streamless conditions from the worker ASL
	if $g($$$mtStreamlessConds(m)){
		Set condToRemove = $listfromstring($e($$$mtStreamlessConds(m),1,*-1)) // these are always pre-keys, so only checking prekey in the loop below
		Set md=$$$topWorkerModule(m), endmd = $$$bottomWorkerModule(m)
		For md=md:1:endmd {
			set prekeyidx = ""
			For {
				Set prekeyidx = $order($$$aslPk(md,1,prekeyidx),1)
				Quit:prekeyidx=""
				if $get($$$aslPkConds(md,1,prekeyidx)){
					Set conds = $listfromstring($e($$$aslPkConds(md,1,prekeyidx),1,*-1))
					for idxcond = $ll(conds):-1:1{
						If $lf(condToRemove,$lg(conds,idxcond)){
							Set $list(conds,idxcond,idxcond)=""
						}
					}
					if $ll(conds) {
						Set $$$aslPkConds(md,1,prekeyidx) = $listtostring(conds)_","
					} else {
						Kill $$$aslPkConds(md,1,prekeyidx)
					}
.
.
				}
			}
		}
	}
.
	// Reverse do1ce^%qaqpmod for VectorJoiner temp files
	// to make sure that the initialization of VectorJoiner is always at the top worker module 
	Set md = $$$topWorkerModule(m),mod = $$$bottomWorkerModule(m)
	Set hasOnceModule = 0
	For md=md:1:mod {
		If $lf($g(mt("once")),md){
			Set hasOnceModule = 1
		}
		s tf=$g($$$aslAct(md,1)) 
		If hasOnceModule,$$$aslActAction(tf)="b",($e($$$aslActVecJoin(tf),1,2)="vj") {
			Set $$$mtTfMainMod($$$mtTempFile($$$aslActTfToBuild(tf)))=$$$aslTopSubqMod(md)
		}
	}
.
	Quit
}
.
setUpParentASL(m)[mt,mts,asl] private {
	if $g($$$mtQbUsesCdmag(m))||$g(mt("colisalg",m)){
		// remove the conditions that are applied via vops and are in WHERE
		// these conditions will be applyed in vector operations in the workers
		Set md = $$$topParentModule(m),endmd = $$$bottomParentModule(m),str=$o(mts(m,""))
		For md=md:1:endmd {
			set pkIdx = ""
			For {
				Set pkIdx = $order($$$aslPk(md,3,pkIdx),1)
				Quit:(pkIdx="")
				If $g($$$aslPkConds(md,3,pkIdx)){
					Set cond=$$$aslPkConds(md,3,pkIdx)
					if $lf($g($$$mtVecTree(str)),"-"_cond) || (("^"_$g($$$mtWhere(m)))[("^"_cond_"^")) {
						Kill $$$aslPkConds(md,3,pkIdx)
					}
				}
			}
		}
	}
	Quit
}
.
#; helper function for addlooprange; add the APE range condition to kloop
modifyloop(kloop,m,rangeconds) [mt] private {
	; add the original range conditions on this loop so that it won't get lost 
	If $p(kloop,$c(1), 7), $e($p(kloop,$c(1), 7),*)'= "," Set $p(kloop,$c(1), 7)=$p(kloop,$c(1), 7)_"," ; add "," at the end of the original $p(kloop,$c(1),7) if there wasn't one
	If rangeconds&&((","_$p(kloop,$c(1), 7))'[(","_rangeconds)) Set $p(kloop,$c(1), 7) = $p(kloop,$c(1), 7)_rangeconds
	Set asc = $p(kloop,$c(1),2)
	If asc = "d",'$GET(mt("sbslrev",m)) {
		; This is the case when the loop is (1) an decending loop and (2) reverseBsl special ASL hack (TRW1615) was not used for this query block
		; add inclusive lower bound endIdx<m> (ending index)
		Set $p(kloop,$c(1), 3) = $$$getVarNum("endIdx"_m)
		Set $p(kloop,$c(1), 4) = 6 // 6 refers to inclusive (partition)
		; add exclusive upper bound startIdx<m> (staring index)
		Set $p(kloop,$c(1), 5) = $$$getVarNum("startIdx"_m)
		Set $p(kloop,$c(1), 6) = 5 // 5 refers to exclusive (partition)
	} else {
		; add exclusive lower bound startIdx<m> (staring index)
		Set $p(kloop,$c(1), 3) = $$$getVarNum("startIdx"_m)
		Set $p(kloop,$c(1), 4) = 5 // 5 refers to exclusive (partition)
		; add inclusive upper bound endIdx<m> (ending index)
		Set $p(kloop,$c(1), 5) = $$$getVarNum("endIdx"_m)
		Set $p(kloop,$c(1), 6) = 6 // 6 refers to inclusive (partition)
	}
	
}
.
#; Add range to the first loop found in worker asl
addlooprange(m,str,rangeconds) [asl,mt,mts] private {
	Set topmd=$$$topWorkerModule(m),endmd = $$$bottomWorkerModule(m)
	Set isBsl = 0
	For md=topmd:1:endmd {
		If $g($$$aslKRoot(md))="bsl" {
			Set isBsl = 1
			Quit
		}
	}
	If isBsl {
		// If possible, add ID range partition conditions to all the loops on ID when the building blocks for the BSL bitmap temp-file are built from the related fields; otherwise add the ID range partition on the loop that read IDs from the final BSL bitmap temp-file.
		Set idval = $$idval(m,str)
		Set bslmd = +$lg($$$asl0LoopingSubscriptsLoc(md),1)
		For md=md:1:bslmd {
			Set kid=$g($$$aslKId(md,1)) 
			If kid'="",$$$aslIdTfBuildLoc(kid)'["^" { 
				Set nextidx = ""
				For {
					Set nextidx = $order($$$aslKNext(md,1,nextidx),1,kloop)
					Quit:nextidx=""
					If ("ad"[$$$aslNextLoopingType(kloop))&&($$$aslNextSubscriptVal(kloop)=idval){ 
						do modifyloop(.kloop,m,rangeconds)
						Set $$$aslKNext(md,1,nextidx)= kloop
					}
				}				
			}
		}
.
		; add the ID range partition on the loop that read IDs from the final BSL bitmap temp-file
		Set md = bslmd
		Set knum = ""
		For{
			Set knum=$o($$$aslK(md,knum))
			Quit:knum=""
			Set kid=$g($$$aslKId(md,knum)) 
			If kid'="",$$$aslIdTfBuildLoc(kid)'["^" { 
				Set nextidx = ""
				For {
					Set nextidx = $order($$$aslKNext(md,knum,nextidx),1,kloop)
					Quit:nextidx=""
					If ("ad"[$$$aslNextLoopingType(kloop))&&($$$aslNextSubscriptVal(kloop)=idval){ 
						do modifyloop(.kloop,m,rangeconds)
						Set $$$aslKNext(md,knum,nextidx)= kloop
					}
				}				
			}
		}
		Set lastkey = $o($$$aslK(bslmd,""),-1)
		If lastkey'= "" {
			Set kloop=$g($$$aslKNext(bslmd,lastkey,1))
			Do modifyloop(.kloop,m,rangeconds)
			Set $$$aslKNext(bslmd,lastkey,1)= kloop
		}
	} else {
		For md=topmd:1:endmd {
			Set kid=$g($$$aslKId(md,1)) 
			If kid'="",$$$aslIdTfBuildLoc(kid)'["^" { 
				Set nextidx = ""
				For {
					Set nextidx = $order($$$aslKNext(md,1,nextidx),1,kloop)
					Quit:nextidx=""
					If ("adh-"[$$$aslNextLoopingType(kloop)){ 
						do modifyloop(.kloop,m,rangeconds)
						Set $$$aslKNext(md,1,nextidx)= kloop
						Return
					} elseif $$$aslNextLoopingType(kloop)["y",$$$aslNextLoopingLowLimOrSetVar(kloop)=$g(mt("sql",m,"set")) {
						Set idval = $$idval(m,str)
						If $$$aslIdKeyAccessType($$$aslKId(md,1))="set",+kloop=idval{
							// this is a loop on set by setid^%qaqpmod
							// remove the loop on set and add a copy node before reading from the master map
							set pknum = $o($$$aslPk(md,3,""),-1)+1
							For pknum=pknum:-1:2 {
								merge:$data($$$aslPk(md,3,pknum-1)) $$$aslPk(md,3,pknum)=$$$aslPk(md,3,pknum-1) 
							}
							Kill $$$aslK(md,1),$$$aslPk(md,3,1)
							Set $$$aslPkCopy(md,3,1) = "4^"_$$$newvar("setIdx"_m)_"^"_idval
							Return
						} else {
							// replace the y or y- loop by "u"
							Set $$$aslNextLoopingType(kloop)="u"
							Set $$$aslNextLoopingLowLimOrSetVar(kloop)= $$$newvar("setIdx"_m)
							Set $$$aslKNext(md,1,nextidx)= kloop
							Return
						}
					}
				}				
			}
		}
	}
	Return
 }
.
APEfinishup(m)[mt, asl] PUBLIC {
	If ($o($$$aslMod(""), -1)>$lg($$$mtAPEWorker(m),2)){ 
		Set $$$mtAPEParent(m) = $lb($lg($$$mtAPEWorker(m),2)+1, $o($$$aslMod(""), -1))
		#; continue setting up asl and mt if postjoin^%qaqpagg successfully constructed parent ASL modules
		Do setUpWorkerASL(m) ; additional ASL set up for worker processes
		Do setUpParentASL(m) ; additional ASL set up for parent process
	} Else {
		#; if postjoin didn't add any new ASL module, remove the mt structures that indicate parallization 
		Kill $$$mtAPEQbNode(m)
	} 
}
.
 // remove ORDER BY that is not in $$optimizerSort(m) from ord and order
removeUnnecessaryCond(ord, order,m) PRIVATE {
	Set optsort = ","_$$optimizerSort(m)
	Set optsort = ","_$tr(optsort,"d")_"," // include the version without "d" in this list
.
	// remove sortings that are not in optsort from ord
	Set neword = ""
	for i =1:1:$l(ord,",") {
		Set cond=$p(ord,",",i)
		Continue:cond=""
		If optsort[(","_cond_",") Set neword=neword_cond_","
	}
.
	// remove sortings that are not in optsort from order
	Set neworder = ""
	for i =1:1:$l(order,",") {
		Set cond=$p(order,",",i)
		Continue:cond=""
		If optsort[(","_cond_",") Set neworder=neworder_cond_","
	}
.
	Set ord=neword, order=neworder
.
}
.
#; remove the last temp file from mt
removeLastTempFileFromMT()
	Quit:'$g($$$mtLatestTempFileNum)
	if $$$mtLatestTempFileNum = 1 {
		kill $$$mtLatestTempFileNum
	} else {
		kill $$$mtLatestTempFile
		set $$$mtLatestTempFileNum = $$$mtLatestTempFileNum-1
	}
	Quit
.
/// This is called by finishWorkerASL to set up the shared global's $$$mtTempFile() entry to be of type "dist", using the asl module's POSTKEY entry and the given list of fields.
/// It also stores the temp-file number as metadata in mt("APE",m,"sharedGlobal").
setupSharedGlobalTfInParAgg(m,mod,distf,list) [mt,asl,POSTKEY] PRIVATE {
	// Create another temp-file (the shared global to which all workers will write in parallel)
	// Set p2 to the workerTf
	Set $p($$$mtAPESharedGlobal(m),"^",2)=distf
	// Create shared global temp-file entry now
	Set sharedGlobalTf=$$nutemp^%qaqpmod("dist^"_mod_"^"_$$npk^%qaqpmod(POSTKEY)_"^^^0^^^^"_list)
	Merge $$$mtTempFile(sharedGlobalTf)=$$$mtTempFile(distf)
	// Set p1 to the parentTf
	Set $p($$$mtAPESharedGlobal(m),"^",1)=sharedGlobalTf
	Set $$$mtTfLocation($$$mtTempFile(sharedGlobalTf))=0  ;  mark temp-file as global
	Set $$$mtTfRealGlobalFlag($$$mtTempFile(sharedGlobalTf))=1  ;  use a real temp global, not a PPG
}
finishWorkerASL(val,list,sldst,agdst,ahav,bhav,ord,order,outtype) 
	#; Finish constructing the worker ASL in $$parag for Adaptive Parallel Execution
	#; A lot of the code here are copied from ^%qaqpagg
	new ai,arg,expr,fun,glist,npk,tfmod,v
	If 'applyTopCond {
		#; no need to process any ORDER BY in the workers if we don't have TOP condition and GROUP BY
.
		// remove the last temp file build in endjoi^%qaqpmod for outtype'=0
		If outtype {
			// remove the last temp file from mt 
			Set tfmod = $$$mtTfModNum($$$mtLatestTempFile)
			Do removeLastTempFileFromMT 
			// remove the asl module that builds the temp file
			Kill $$$aslAct(tfmod,1) 
		}
		s ord="",order="",outtype=0
	} else  {
		// remove ORDER BY conditinos that is not in $$optimizerSort(m)
		do removeUnnecessaryCond(.ord,.order,m)
	}
	#;  "parag"+"precount" - just process the COUNT(*) normally  ;  AK1025
	i $g($$$mtParag(m))'="",$g(mt("precount",m)),bhav="" { s bhav=$$$mtPAggList($$$mtP(m)) }
	#;  use optimizer plan for GROUP BY+aggs without temp-files!  ;  AK988
	i sldst,bhav,bhav'["^",ahav="",$$gbags() { d onepass }  ;  RETURN here???
	#;  if DISTINCT, no aggregates, no HAVING, then maybe suppress looping
	#; AK705
	n windows s windows = $$windowsInSubq(m)
	i sldst,bhav="",ahav="",'windows d gnolup($$sublevs(sldst))
	i bhav,ahav="",$g($$$mtGroupDistinctList(m))||onerow,'windows d minmax
	#; AK705-
	#; AK576-
	#; AK610
	#;  IF there is ORDER BY, and outtype<>0, i.e. sort-file was built,
	#;      and it matches the ORDER BY, and if this sort-file has a 1-1
	#;      match to the actual output rows (i.e. no HAVING, DISTINCT, or
	#;      GROUP BY), and there are no aggregates (which would need all rows),
	#;  THEN apply the TOP row-limit optimization
	#;      *** deal with bitmap temp-file, in one of 2 ways
	#;  find module with BUILD, in (mod-1) if IS13, but ignore RC module!
	s bmod=mod
	s:$e($g($$$aslAct(bmod,1)))'="b" bmod=$g($$$asl0CorrectBuildNode(bmod),bmod)  ;  fix for AK1080  ;  DAB081
	s bmod=bmod-is13 s:$e($g($$$aslAct(bmod,1)))'="b" bmod=bmod-1
	i $e($g($$$aslAct(bmod,1)))="b",'$$$aslActTfToBuild($$$aslAct(bmod,1)) s $$$aslActTfToBuild($$$aslAct(bmod,1))=$$nutemp^%qaqpmod("temp^"_bmod_"^^1")
	n prevtoplimit s prevtoplimit = $g($$$mtTopLimit(m))
	d:$g($$$mtTopLimit(m)) toplast  ;  maybe repeat last TOP condition
	#; AK894
	i $g($$$mtTopArg(m)),'$g($$$mtTopLimit(m)),ord'="",ord=order,outtype||is13,'onerow,'sldst,'$$$mtPAggList($$$mtP(m)),'$g($$$mtHaving(m)),$$nowins() d topt
	i $g($$$mtTopLimit(m)) s $$$aslActUseLocalArrOrTopOptQbOrTopnVar($$$aslAct(bmod,1))=m,$$$aslActSort($$$aslAct(bmod,1))=0,$$$mtTopTempFile($$$mtTopLimit(m))=$$$aslActTfToBuild($$$aslAct(bmod,1))  ;  AK875
	#; AK853
	d:$g($$$mtTopLimit(m)) topstop  ;  maybe apply first top-condition as a stop-condition
	#; AK610-
	#;  If outtype, i.e. sort-file was built, and there are zero or one
	#;      levels of aggregates, DISTINCT, and no HAVING (and the
	#;      DISTINCT list does not contain any aggs!), then realign the
	#;      modules a bit, process DISTINCT here, and redo the smaller
	#;      sort-file (to include any expressions computed for DISTINCT)
	#;      But it must be nested, as not to affect any aggs calculation
	#; AK615
	n distf s distf=""  ;  remember temp-file#, for use in grouped aggregates
	#; JLF047
	if sldst,bhav'["^",outtype,$$gudhaving(),ahav="",$$noaggs(),$$nowins() {
		n tsldst s tsldst=sldst
		k $$$aslAct(mod,1) d nest(mod,1),distcond(.sldst,bhav="")
		#; If we are grouping by one  field and we are sorting by the same field the distinct group comes out in sort order
		#; so no need for any sort file. Disable if paginating as we have no code generation for pagination on hybrid temp table currently
		if order=tsldst,'$p(tsldst,",",2),'onerow,'$$hasPagination^%qaqpsq(m) {
			// If we are using a shared global in parallel aggregation, we need to set up a new temp-file (the shared global to which all workers will write in parallel)
			If $$$parAggUsesSharedGlobal(m) { Do setupSharedGlobalTfInParAgg(m,mod,distf,list) }
			do sort("",.vals,distf)
		} else {
			// Don't use a shared global for parallelization since no code generation for top on hybrid temp table currently
			k $$$mtAPESharedGlobal(m) 
			do sort(order,.vals,,$$$mtGroupDistinctList(m))
		}
		i $d($$$mtTopLimit(m)) {
			k $$$mtTempFile($$$mtTopTempFile($$$mtTopLimit(m)))	; remove the $$$mtTempFile(*) information about the obsolete temp file
			s $$$aslActUseLocalArrOrTopOptQbOrTopnVar($$$aslAct(mod,1))=m,$$$aslActSort($$$aslAct(mod,1))=0,$$$mtTopTempFile($$$mtTopLimit(m))=$$$aslActTfToBuild($$$aslAct(mod,1))  ;  AK875
		}
	}
	s:$g($$$mtTopLimit(m)) $$$mtAPETopLimitWorkerTF(m)=$$$mtTopTempFile($$$mtTopLimit(m))
	Kill:prevtoplimit="" $$$mtTopLimit(m) // revert mt("toplimit",m)
	#; JLF047-
	#;  If there is exactly one level of BEFORE aggregates, DISTINCT, and
	#;      no HAVING (and the DISTINCT list does not contain any aggs!),
	#;      then process DISTINCT here, before we build the temp-file!
	#;      But it must be nested, as not to affect the aggs calculation
	i sldst,bhav'["^",bhav'="",'outtype,$$gudhaving(),ahav="",$$noaggs(),$$nowins() {
		d nest(mod,$$npk(ACTION))
		d distcond(.sldst)
		// If we are using a shared global in parallel aggregation, we need to set up a new temp-file (the shared global to which all workers will write in parallel)
		If $$$parAggUsesSharedGlobal(m) { Do setupSharedGlobalTfInParAgg(m,mod,distf,list) }
	}
	i bhav="",outtype d read  ;  read the last temp-file  ;  AK106  ;  AK112  ;  AK190
	    ;  if no temp-file with all current data (AND B-H aggs) - make one
	#; Collect all "forward" window functions; these need to "see the future" and review all results before producing values
	#; Merge to avoid duplicates (possible in at least ORDER BY <ordinal> cases)
	n fwins s fwins=$$mergeCommaLists($$forwardWindows(selst),$$forwardWindows(ord))
	#; Collect all "backward" window functions; these can produce values as soon as the final pre-window row order is available
	n bwins s bwins=$$mergeCommaLists($$backwardWindows(selst),$$backwardWindows(ord))
	//TODO: One partitioning function instead of two filters
	n selstnowin s selstnowin = $$removeWindowDependentExprs(selst)
	#; We need to preserve any field or aggregate values needed to compute the expression
	#; in which a window function appears.
	#; some comment
	s selstnowin = $$mergeCommaLists(selstnowin,$$windowExprDeps(selst))
	s selstnowin = $$mergeCommaLists(selstnowin,$$windowExprDeps(ord))
	#; We also need any values for grouping/distinct
	s selstnowin = $$mergeCommaLists(selstnowin, $$windowExprDeps($g($$$mtGroupDistinctList(m))))
	if windows, $d($$$mtDistinct(m)) {
		s selstnowin = $$mergeCommaLists(selstnowin,$$removeWindowDependentExprs($g($$$mtGroupDistinctList(m))))
	}
	n selstwin s selstwin = $$removeNonWindowDependentExprs(selst)
	#; If we're DISTINCT on window functions (by way of SELECT DISTINCT, they can't appear in GROUP BY)
	#; then we need to preserve all GROUP BY values for the final DISTINCT after WF evaluation
	//if $d(mt("distinct",m)),$$windows($g($$$mtGroupDistinctList(m))) {
	//	s selstnowin = $$mergeCommaLists(selstnowin,$$removeWindowDependentExprs($g($$$mtGroupDistinctList(m))))
	//}
	n ordernowin s ordernowin = $$removeWindowDependentExprs(order)
	n ordwin s ordwin = $$removeNonWindowDependentExprs(ord)
	#; if we computed our window values in a queued parallel or shard query, no need to recompute
	i +$g(mt("queuedwins",m)) {
		#; still potentially need to "distinct" on wf values
		if $d($$$mtDistinct(m)) s sldst = sldst_selstwin
		s fwins="", bwins=""
		s selstnowin = selst
		s selstwin = ""
		s ordernowin = order
	}
	i bhav'="" d:'onerow&&'outtype sort(ordernowin,.vals,$s(order="":distf,1:"")) f levi=$L(bhav,"^"):-1:1 s levag=$P(bhav,"^",levi) d levag
.
	#; evaluate the output expressions that involves correlated subqueries
	d expr(selstcorrsubq)
.
	#; AK615-
	MERGE mt("v")=c2s  ;  restore SUM->COUNT, so that it would init to 0  ;  AK902
.
	#;---------- SELECT DISTINCT 
	#; Do any non-window-function-dependent grouping. Can't do it yet for the `select distinct wf() over ...` case
	#; since we need to calculate the wf() first. This indeed breaks the current IRIS SQL non-standard "rule"
	#; that DISTINCT and GROUP BY are equivalent, by exploiting the mt("distinct") "breadcrumb" left by the
	#; DISTINCT -> GROUP BY transformation
	if sldst,'($d($$$mtDistinct(m))&&(selstwin||ordwin)) d distcond(sldst,,1)  ;  last resort, if wasn't processed already
	#; Forward-looking-window:
	#; Update their intermediate structures from the final post-agg/group, pre-window row stream
	d forwardWindowExpr(fwins)
	#;  create a new temp-file if:  (one is needed for DESCending) AND (none created after last join or in this program) OR (not fully sorted yet)  ;  AK190+
	#;  s ord=$TR($g($$$mtSequencers),"d") d:$O(asl(jmod,KEY))'=""!'outtype&($g($$$mtSequencers)["d")!(ord'=order) sort(ord,.selst),read  ;  AK069 ; ALL001
	#;---------- treat DESCending order ----------
	#;  s ord=$TR($g($$$mtSequencersQb(m)),"d")  ;  AK190=
	#; DPV1632
	#;  If this mod is for RC code, this actual next loop is at the previous mod
	#;  Set lmod in that case here and use lmod in desc and below
	n lmod
	If $d($$$asl5Root(mod)) {
		s lmod=$p($$$aslMod(mod),$c(1),2)
		For  q:'$d($$$asl5Root(lmod))  s lmod=$p($$$aslMod(lmod),$c(1),2)
		}
	Else { s lmod=mod }
	#; DPV1632-
	#; DPV1691
	n ordnowin s ordnowin = $$removeWindowDependentExprs(ord)
	i +$g(mt("queuedwins",m)) {
		s ordnowin = ord
	}
	n hadsort s hadsort = 0
	n needEvalSelWin s needEvalSelWin = 1
	i $$desc||(+fwins) { 
		#; note that $$desc can re-set ord to the ordered, "d"-entry version
		#; which is used below to identify desc looping in the sort file we're
		#; about to build.
		#; We need to preserve our "DISTINCT" list values for a 
		#; final distinct, if present 
		New finaldist Set finaldist=""
		If selstwin||ordwin,$d($$$mtDistinct(m)) { Set finaldist=sldst }
		if (ordnowin '= ord)||((+fwins)&&(selst[fwins)){
			// we need to reloop again to calculate forward window function in select list, since the order we populate winval 
			// might be different from the output order, and windowrowval often needs to be populated in the same order we get winval
			// SELECT Age, Gender, FavoriteNum, MIN ( FavoriteNum ) OVER ( PARTITION BY Age ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING ) Result FROM %NOPARALLEL Sample.Person ORDER BY Age, id (desc)
			// we need to put in ordnowin as well, otherwise, the next sort cannot find ordnowin
			d sort("",$$mergeCommaLists(selstnowin,ordnowin)), read
			d expr(selstwin)
			d sort($tr(ord,"d"),$$mergeCommaLists(selst,finaldist))
			s needEvalSelWin = 0
		} else {
			d sort($tr(ord,"d"),$$mergeCommaLists(selstnowin,finaldist))
		}
		d read
		s ord=$g($$$mtSequencersQb(m)),lmod=mod,hadsort=1
	}  ;  reset lmod  ;DPV1691;DPV1765
	// No need to set a marker for DESC if a shared global is used in parallel aggregation because the worker does not need to read/send back its own temp-file data to the parent
	#; MRP574 (Use proper Sorting Order (DESC) for Joined Queries)
	If '$$$parAggUsesSharedGlobal(m) {
		i ord["d" d  ; Mark Descending for Proper Module
		. n dmod,i,info,n,ns,ntry,order,pmod,tempid,tmod,val
		. s order=$p(ord,"d")
		. f i=$l(order):-1:1 q:$e(order,i)=","
		. s order=$e(order,1,i-1)
		. i order=""||(order["d") q  ; Don't process these
		. s tempid=$$$aslIdTfBuildLoc($g($$$aslKId(mod,1)))
		. q:tempid=""  ; Not a Temp File
		. s dmod=+tempid,ntry=+$p(tempid,"^",2)
		. s info=$g($$$aslActNode(dmod,1,ntry))
		. q:$$$aslActNodeUseRowCounterTempId(info)'="tid"  ; Not looping on a TempID so quit
		. s pmod=$p($g($$$aslMod(mod)),$c(1),2)  ; Parent mod# calling in a nest
		. q:'pmod  ; No Parent calling in a nest so quit
		. s n=""
		. f  s n=$o($$$aslPk(pmod,1,n)) q:'n  d  ; Check Temps
		.. s tmod=+$g($$$aslPkCallAnotherMod(pmod,1,n))
		.. q:'tmod  ; No Temporary Module to Check
		.. f i=1:1 s val=$p(ord,",",i) q:val=""  d:val["d"  ; Check 'next' Key Specs
		... s ns=""
		... f  s ns=$o($$$aslKNext(tmod,1,ns)) q:'ns  d  ; Check 'next' info
		.... s info=$g($$$aslKNext(tmod,1,ns))
		.... q:+val'=+info           ; Not the DESCENDING Column so quit
		.... q:$$$aslNextLoopingType(info)="u"  ; No Orering at this level so quit
		.... s $$$aslNextLoopingType($$$aslKNext(tmod,1,ns))="d"  ; Set to DESCENDING
		#; MRP574 (Use proper Sorting Order (DESC) for Joined Queries)-
		#; AK538
		f ns=1:1 s val=$P(ord,",",ns) q:val=""  d:val["d" derange(lmod,1,ns)
	}
	s ord=$tr(ord,"d","")
	#; We now have the "final" row order (unless there are any wf's in the ORDER BY, in which case we evaluated WF's prior to descending logic)
	if ((+bwins)||(+fwins)),needEvalSelWin {
		#; Evaluate those in the select list, order by evaluated implicitly by sort
		do expr(selstwin)
	}
	if (m=1)&&($g($$$mtSequencers)'="")&&($d($$$mtIntersectExceptOnQb(1))) {
		d sort($tr($$$mtSequencers,"d"),selst), read
		f ns=1:1:$l($$$mtSequencers,",")-1 s:$p($$$mtSequencers,",",ns)["d" $$$aslNextLoopingType($$$aslKNext(mod,1,ns))="d"  ;  DESCENDING
	}
	#;---------- SELECT DISTINCT - main query only *** why?
	#; For window functions in the SELECT DISTINCT list, we need to "double distinct": First for the implied GROUP BY of ordinary
	#; SELECT DISTINCT items (or that could have been explicitly in GROUP BY), then for the post-GROUP BY, DISTINCT window
	#; function results (which could NOT have been explicitly in GROUP BY).
	if selstwin||ordwin,$d($$$mtDistinct(m)) d distcond(sldst_selstwin,,1)  ;  last resort, if wasn't processed already
	if $d($$$mtIntersectExceptDist(m)) d distcond($$$mtIntersectExceptDist(m),,1)
	Quit
.
#;this function calculates the number of scanned and returned tuples that would be processed in parallel
#;	mod - asl mod where parallel begins
#;	start - index of asl "next" node where parallel begins
#;	total - total size of initial parallel stream
#;  topmod - bool specifying if at beginning of recursion
#;	outtup - output to hold recursion result	
countScannedTuples(mod,start,total,topmod,outtup,hasTuneTableStats) [asl,mt,mts] Public {
	set str = 0
	set qno = 0
	set sub = start
	#;selectivities are split between rsel which remove tuples without having to scan them
	#; and asel which reduce returned tuples but must be scanned first
	set rsel = 1
	set asel = 1
	set hasTuneTableStats = 1
	#;check asl "next" nodes for conditions
	for {
		set sub = $order($$$aslKNext(mod,1,sub),1,loop)
		quit:(sub="")
		if ($$$aslNextLoopingType(loop)="c") { continue }
		set val = $$$aslNextSubscriptVal(loop)
		if ((val'="") && ($$$mtVType($$$mtV(val))="f")) {
			set ifn = $p($$$mtV(val),"^",3)
			set str = $p($$$mtV(val),"^",2)
			set irn = +$$$mtR(str)
			Set:hasTuneTableStats&&('$$isTuned^%qaqpsq(irn)) hasTuneTableStats=0
			set i = ""
			for {
				set i = $order(mts(i))
				quit:(i="")
				if ((i'="AGG") && $d(mts(i,str))) { set qno = i }
			}
			if ($$$aslNextLoopingType(loop)="y") {
				set rsel = rsel * +$g(mts(qno,str,"CON",ifn),1)
			} elseif ($$$aslNextLoopingType(loop)="u") {
				if $data(mts(qno,str,"CON",ifn)) { set rsel = rsel * +mts(qno,str,"CON",ifn) }
				elseif $data(mts(qno,str,"JOIN",ifn)) {
					set expr = $$$aslNextLoopingLowLimOrSetVar(loop)
					set log = ""
					for {
						set log = $order(mts(qno,str,"JOIN",ifn,log),1,node)
						quit:(log="")
						if ($ZSTRIP($p(node,"^",5),"<>P")=expr) { set rsel = rsel * $p(mts(qno,str,"JOIN",ifn,log),"^",2) }
					}
				}
			} elseif (($$$aslNextLoopingLowLimOrSetVar(loop)'="") || ($$$aslNextLoopingUpLim(loop)'="")) { 
				if ($$$aslNextLoopingLowLimExcl(loop)>4)||($$$aslNextLoopingUpLimExcl(loop)>4) {
					// if exclusive (partition) or inclusive (partition)
					set rsel = rsel / $s($g(mt("numsplits",qno))="":$zutil(204,5),1:mt("numsplits",qno))					
				} else {
					set rsel = rsel * +$g(mts(qno,str,"RANGE",ifn),1) 
				}
			}	
		}
		if ($$$aslNextAdditionalCondsOnSubscript(loop)'="") {
			set logs = $$$aslNextAdditionalCondsOnSubscript(loop)
			for i=1:1:$l(logs,",")-1 {
				set log = $p(logs,",",i)
				set asel = asel * $$getLogSelectivity^%qaqpag(log)
			}
		}
	}
	#;check asl "cond" nodes for conditions
	if $data($$$aslPkConds(mod,3,1),logs) {
		for i = 1:1:$l(logs,",")-1 {
			set log = $p(logs,",",i)
			set asel  = asel * $$getLogSelectivity^%qaqpag(log)
		}
	}
	#;previous total tuples by stream size of current mod
	if (('topmod) && (qno'=0)) {
		set strsize = +mts(qno, str)
		if $d($$$aslPkCallAnotherMod(mod,1,1),tfile) {
			set i = ""
			for {
				set i = $order($$$mtTempFile(i))
				quit:(i="")
				if ($p(tfile,$c(1),1) = $$$mtTfModNum($$$mtTempFile(i))) && ($$$mtTfEntAvglen($$$mtTempFile(i)) '= "") {
					set strsize = $p($$$mtTfEntAvglen($$$mtTempFile(i)),",",1)
				}
			}
		}
		set total = total * strsize
		if (total >= 9223372036854775807) { //(MAX possible decimal) to avoid <MAXNUMBER> error)
			set outtup = 1
			return total
		} 
	}
	#;mutiply total tuples by selectivities
	set scanned = total * rsel
	set passed = scanned * asel
	set total = scanned
	set ind = ""
	#;move to next nested module, total scanned is is multiplied recursively at each step 
	#;while total passed is calculated from the final layer and passed directly back up
	for {
		set ind = $order($$$aslAct(mod,ind),1,node)
		quit:(ind="")
		if ($$$aslActAction(node) = "n") {
			set total = (scanned - passed) + ($$countScannedTuples($$$aslActNestingModOrIpqVars(node),"",passed,0,.outtup,.nesttabletuned))
			Set:hasTuneTableStats&&('nesttabletuned) hasTuneTableStats = 0
		}
	}
	set:$d($$$aslKNext(mod,1,1)) $$$aslNextTuplesCount($$$aslKNext(mod,1,1)) = total
	if (outtup = "") { set outtup = passed }
	return total
}
.
#; Compute the optimal number of splits to use for this query based on query structure and table information
#; ComputeSplitNumber returns a number if an optimal number of splits can be determined, otherwise "" 
ComputeSplitNumber(m, str, imp)[mt, mts,%mcost,asl] PUBLIC {
	Return:($g(imp)="") ""
	RETURN:$o($$$Mcost(m,1,""),-1)'=1 ""  ;  use the default # of splits if this query block has more than one table
.
	Set mapinfo = $g(mts(m,str,"MAP",imp))
	Return:mapinfo="" ""
.
	// nChunk = ceil(number of rows/60,000) is the estimated number of chunks in this map;  it is also used for row-based field for simplicity
	// 60,000 is chosen over 64,000 (the max number of rows that can be stored in a vector/bitmap chunk) because a vectors/bitmap in a field is usually storing less than 64,000 rows
	Set nChunk = ($p(mapinfo,"^",2)+60000-1)\60000 
	Return:nChunk<=0 ""
.
	// number of CPU cores, which is also the number of jobs by default
	Set nCores = $zutil(204,5)
.
.
	// An upper bound on how big a split should be so that a split won't take 
	// too long to finish
	Set maxsplitsize = "" // unit: vector/bitmap chunk
.
	// A lower bound on how big a split should be based on how much work is needed 
	// from master process to merge the results 
	set minsplitsize = "" // unit: vector/bitmap chunk
.
	set AggFields = $ll($$listreeqb^%qaqpnl(m, $lb("a"))) // number of fields that are aggregated in this query block 
.
	Set GroupByFields =$l($g($$$mtGroupDistinctList(m)),",")-1 // number of fields that are grouped by on in this query block 
.
	If AggFields>0 {Set maxsplitsize = 20}
	If GroupByFields>0 {
		if $g($$$mtQbUsesCdmag(m)) {
			// group by in this query block is done via the group by vector operation
			Set minsplitsize = 2
		} else {
			Set minsplitsize = 8
		}
		
	}
	If (minsplitsize ="") && (maxsplitsize="") {
		// Case 1: no constrain on either minsplitsize or maxsplitsize
		// use the default number of splits, number of cores
		Set rst = nCores
.
	} elseif (minsplitsize ="") {
		// Case 2: we only have constrain on maxsplitsize
		// use the min number of splits that satisfies the constrain on maxsplitsize
		Set rst = (nChunk+maxsplitsize-1)\maxsplitsize
	} elseif (maxsplitsize="") {
		// Case 3: we only have constrain on minsplitsize
		// use the min number of splits that satisfies the constrain on minsplitsize
		Set rst = nChunk\minsplitsize
	} else {
		// Case 4: we have constrain on both maxsplitsize and minsplitsize
		// use the average of Case 2 and Case 3
		Set rst1= (nChunk+maxsplitsize-1)\maxsplitsize
		Set rst2 = nChunk\minsplitsize
		Set rst = (rst1+rst2+1)\2
	}	
.
	// if nCores<=rst<=2*nCores, use nCores 
	// if rst > 2*nCores, round rst to the nearest multiple of nCores
	Set rst = $s(rst<=nCores:rst,(rst>nCores)&&(rst<=(2*nCores)):nCores,1:$NORMALIZE(rst/nCores,0)*nCores)
.
	If $g($$$mtQbUsesCdmag(m)) || $g($$$mtQbUsesCdmp(m)) ||$g(mt("colisalg",m)) {
		Set:rst<2 rst=2 // use 2 as the minimal number of split for queries using vectorized plan
		Set:rst>nChunk rst = nChunk
	} else {
		// use min(16,nCores) as the minimal number of split for queries using non-vectorized plan
		Set:rst<16 rst=16 
		Set:rst>nCores rst = nCores
	}
	Set:$$hasVecJoiner(m)&&(rst>nCores) rst=nCores // don't use more than # of cores for query blocks that have vector joiner
	return rst
}
.
#; Estimate the number of calls to a subquery from the selectivity of its input fields
#; inputflds: a ",val," list of input fields of a subquery
SubqCallCount(inputflds)[mt,mts] private {
	Set count = 1
	for i = 2:1:($l(inputflds, ",")-1) {
		set sel = $$getValSelectivity^%qaqpag($p(inputflds,",",i))
		set count = count*(1.0/sel)
	}
	return count
}
.
#; This function decides if the temp-file used for caching the results of subquery subqm should be use a local array or a process-private global
#; Input arguments:
#;     subqm: the query block number for a subquery
#;     tfnum: the number of the temp-file that is used for caching the results of subquery subqm
SetTempfileTypeForSubqCache(subqm,tfnum)[mt,mts] public{
	set ntup = $p($g($$$mtNumTupleAndAvgLen(subqm)), ",", 1)
	set avglen = $p($g($$$mtNumTupleAndAvgLen(subqm)), ",", 2)
.
	// use some very rough estimation for ntup and len if we don't have these information for subquery subqm
	Set:ntup="" ntup=1.5
	Set:avglen="" avglen=$s($g($$$mtOutput(subqm))="":1,1:$l($$$mtOutput(subqm),",")*10)
	Set:avglen<1 avglen=1 // for edge case $l($$$mtOutput(subqm),",")=0
.
	// estimation the number of times this subquery will be called using the number of unique values in the input fields 
	set callcount = $$SubqCallCount($p($$$mtV($$$mtPQbVal($$$mtP(subqm))),"^",3))
.
	// multiple callcount by ntup to get the estimated # of rows in this temp file
	set $$$mtTfSizeEstimate($$$mtTempFile(tfnum)) = (ntup*callcount)_","_avglen
	set uselocal = $$useLocalArrayTempfile^%qaqpmod(tfnum)
	set $$$mtTfLocation($$$mtTempFile(tfnum))=uselocal // make sure that $$$mtTempFile(tunum) is set correctly when uselocal=0
}
.
addValToTempfile(tfnum, val)[asl,mt,ACTION,m,V,mod,nf] PUBLIC {
	new mod,nf
	Set mod = $$$mtTfModNum($$$mtTempFile(tfnum)), npk=$$$mtTfBuildAct($$$mtTempFile(tfnum))
	Set nf = $o($$$aslActNode(mod,npk,""),-1)
	d bldfld(npk,"",val)
}
.
#; if the query is using cdmag plan and the ipq outputs comes from reading a order by temp-file,
#; add the values in mt("APE", m, "ipqoutputs") that are not in the temp-file in the temp-file (if any)
addIPQOutputsToTempfile(tfnum)[asl,mt,ACTION,m,V,mod,nf] PUBLIC {
	Set tfmod = $$$mtTfModNum($$$mtTempFile(tfnum)), tfnpk=$$$mtTfBuildAct($$$mtTempFile(tfnum))
.
	Set tfvals = "" // list of variables that are currently in the temp-files (either as a subscript or as a node data)
	Set tfnf = ""
	For {
		Set tfnf = $o($$$aslActNode(tfmod,tfnpk,tfnf),1)
		Quit:tfnf=""
		Set tfvals=tfvals_$$$aslActNodeSubscriptVar($$$aslActNode(tfmod,tfnpk,tfnf))_","
	}
.
	Set valstoadd = $$remove^%qaqpmod($$$mtAPEWorkerOutputs(m), tfvals) // list of variables that needs to be added to the temp-file
	For i=1:1:$l(valstoadd,",") {
		do:+$p(valstoadd,",",i) addValToTempfile(tfnum, $p(valstoadd,",",i))
	}
}
#; return 0 if the optimizer picked a plan that doesn't use temp-file for any steam, 1 otherwise
useTempFile(sol) PRIVATE {
	For joi=1:1:$o(sol(""),-1) {
		Return:(+sol(joi)) 1
	}
	Return 0
}
.
vtreeList(m)[mt,mts] {
	Set vallist = "",str=""
	For {
		Set str=$o(mts(m,str))
		Quit:str=""
		Set vallist = vallist_$g($$$mtVecTree(str))
	}
	Return vallist
.
}
/// Add an ASL postkey "temp" node to evaluate expressions that are needed by IP outputs and not computed yet. These variables are in outputexprfound and not in exprfound or mt("vtree").
evaloutputexpr(outputexprfound)
	New outputexpr,i,val,str
	Set outputexpr="",str=$o(mts(m,"")) // str is only needed when the query block is using cdmag plans (which are only avaliable for single table queries) 
	For i=1:1:$ll(outputexprfound) {
		Set val=$lg(outputexprfound,i)
		Set:'$lf(exprfound,val)&&'(($g($$$mtQbUsesCdmag(m))||$g(mt("colisalg",m)))&&$lf(vtreeList,val)) outputexpr=outputexpr_val_","
		Set:'$lf(exprfound,val)&&'$lf(vtreeList,val) outputexpr=outputexpr_val_","
	}
	New mod Set mod = $$$bottomWorkerModule(m)
	Do expr(outputexpr)
	Quit
.
/// Evaluate sldstexprfound in the postkey of the last worker module for IPQ output. 
evalsldstexprfound(sldstexprfound) [asl,m,POSTKEY,outputexprfound,vtreeList] {
	Quit:sldstexprfound=""
	Quit:$$$parAggUsesSharedGlobal(m) // No need to evaluate sldstexprfound when aggregation global temp files are used because in this case IPQ won't output anything
.
	Set mod = $$$bottomWorkerModule(m)
	Set npk = ""
	For {
		Set npk=$o($$$aslPk(mod,POSTKEY,npk))
		Quit:npk=""
		Quit:$DATA($$$aslPkCallAnotherMod(mod,POSTKEY,npk))
	}
	If npk= "" {
		// if no "temp" node is founds, evaluate expressions in sldstexprfound together with outputexprfound
		Do adlist(.outputexprfound,sldstexprfound)
	} else {
		// As sldstexprfound can only be a subexpression of sldst, evaluate sldstexprfound expressions before asl(mod,POSTKEY,npk,"temp") to make sure that these subexpressions are not evaluated twice. Exclude expression in vtreeList as they have already been evalauted by $vop.
		Set templist = ""
		For i=1:1:$ll(sldstexprfound) {
			Set val=$lg(sldstexprfound,i)
			Set:'$lf(vtreeList,val) templist=templist_$lb(val)
		}
		Set varlist = $LISTFROMSTRING($p($$$aslPkCallAnotherMod(mod,POSTKEY,npk),$c(1),4))
		Do adlist(.templist, varlist)
		Set $p($$$aslPkCallAnotherMod(mod,POSTKEY,npk),$c(1),4) = $listtostring(templist)
	}
}
---


