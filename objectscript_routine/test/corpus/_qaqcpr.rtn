		elseif $$$VTRgetcat(arg1)="FMTIMESTAMP" { QUIT "$s("_val_"="""":"""",1:"_$$genmeth("%Library.PosixTime","OdbcToLogical",,$$genmeth("%Library.FilemanTimeStamp","LogicalToOdbc",,val))_")" }
