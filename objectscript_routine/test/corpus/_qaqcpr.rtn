#include %occExtent
#include %msql
#include %BigData.ShardingManager
#IF 0   ;-------------------------------------------------------------
	; Description:   Process Prekey/Postkey, expressions and conditions
	; Author:        Aviel Klausner
	; Date Started:  1987
	;
	;  JMM1073 (01/26/2021) - Correctly execute parallel shard-local queries while rebalancing is in progress
	;  JMM996  (08/11/2020) - Online sharded cluster rebalancing
	;  AK971   (10/17/2017) - View row identifiers for sharded outer join
	;  AK970   (10/10/2017) - Do not evaluate subqueries sent to shards
	;  AK690   (02/15/2017) - Extensions for SQL manipulation of bitmaps
	;  MRP877  (06/31/2016) - Fix SQL 3-value logic problem for $TRANSLATE(str,ident,'') with empty string ('') 3rd parameter
	;  PVA309  (06/20/2014) - Fix behavior of MVR and MINUS collation with DISTINCT, GROUP BY, and MAX/MIN
	;  AK841   (12/21/2011) - Use extended local arrays for some temp-files
	;  MRP777  (09/06/2013) - Implement $JUSTIFY | $TRANSLATE
	;  AK688   (01/24/2008) - Abstract index/filter using %FIND/%SQL.Find
	;  BJB547  (05/14/2012) - support #sqlcompile Select = FDBMS for :array() with INSERT and UPDATE
	;  AK811   (05/19/2011) - Use unsubscripted locals as FOR loop variable
	;  AK818   (07/22/2011) - Use %Open().IsNull() for stream NULL check
	;  AK801   (02/15/2008) - Improve LIKE pattern with wildcard sequence
	;  AK800   (02/10/2011) - Use $LISTFIND() for %INLIST/INSET
	;  AK797   (01/24/2011) - Use ONEOF code-generation for %INLIST/INSET
	;  AK795   (01/19/2011) - Fix subquery caching subscript variable clash
	;  JLF456  (11/01/2010) - Test for subvalue availability in the current asl module
	;  JLF414  (08/23/2010) - Handle special case of ORDER BY factor-OR, %STARTSWITH NULL
	;  AK684   (08/09/2007) - Use TRY/CATCH(<SUBSCRIPT>) for OR/IN ONEOF
