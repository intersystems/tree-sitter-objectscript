		if v'="" { set format=$$ptvalue(v) }		// Find format
		if p6'="" { set decimal=$$ptvalue(p6) }		// Find decimal
		if p6="" { RETURN "$s("_val_"="""":"""",1:$fnumber("_val_","_format_"))" }
