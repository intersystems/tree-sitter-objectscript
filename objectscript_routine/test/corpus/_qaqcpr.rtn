			set value=$p(string,"^",i)
			quit:value=""			// no more values
			set val2=value
			set:$case($p($$$mtV(value),"^",1,2),"v^%RUNTIMEOUT":1,"v^%ODBCOUT":1,"v^%EXTERNAL":1,:0) val2=$p($$$mtV(value),"^",4)	// just one level, enough???
			set JSONType=$$getJSONType(val2)
			set return=return_","_$$ptvalue(value)_","
			if mt("sqlcomp")="%Runtime" {
				// check at runtime whether executed in display mode, if so flag numeric as string
				set return=return_$case(JSONType,1:"$case($zu(115,5),2:0,:"_JSONType_")",:JSONType)
			} elseif $case(mt("sqlcomp"),"%ODBC":1,"":1,:0) {
				set return=return_JSONType
			} else {
				// other compilation modes will use LogicalToDisplay for number values so just flag numeric as string (0) at compile time
				set return=return_$case(JSONType,1:0,:JSONType)
