			#; In order to work around this, if the first argument to MOD is a DOUBLE, instead of doing MOD with a # operator, 
			#; I use a workaround of M - (N * FLOOR(M/N))
	
		
		if '$g(^%SYS("sql","sys","ansi operator precedence")){
			if $$$VTRgetcat(holdval)="DOUBLE" {
