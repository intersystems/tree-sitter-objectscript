	;  DPV562  (10/27/95)   - Fix MAXSTRING error when more than 8 fields in GROUP BY clause.
	;  MRP530  (09/05/95)   - Maybe add 'ALPHAUP' or 'UPPER' to Generated Code for complex Index Expressions
	;  MRP529  (09/03/95)   - Handle Multi-Line Fields in 'temp' swapping
	;                         --- Moved 'davalue' to '%aaapre1 ---
	;  MIT055  (07/19/95)   - Fix expressions in subqueries
	;  MRP510  (07/03/95)   - Clean-Up loose ends from MRP466
	;  DPV489  (06/23/95)   - Fix line to long created by MRP507
	;  MRP508  (06/20/95)   - Add ALPHAUP & UPPER to routine for complex.  Index Expressions that use them
	;  MRP507  (06/19/95)   - Allow the removal of some characters before ALPHAUP translation
	;  MRP496  (04/08/95)   - Support Optimized LIKE {<const> | <host var>}
	;  MRP472  (01/13/95)   - Make WHERE RowID = :p1 OR RowID = :p2 ... work
	;                       - Moved 'pk()' to %aaapre1
	;  MRP467  (12/28/94)   - Qualify the predicated with ( & ) before doing the comparison
	;  MRP466  (12/08/94)   - Handle Collation Expressions
	;  MRP456  (10/25/94)   - Piece out the Composit Row ID
	;  MRP454  (10/18/94)   - Check to see if Designated Table's RowID is Name or Text
	;  MRP427  (08/08/94)   - Support %INTERNAL
	;  MRP422  (07/25/94)   - Split up parts of %aaapre and moved them
	;                         into %aaapre.  For change codes before
	;                         (11/20/93) see zaaapre.MAC
	;  MIT001  (07/20/94)   - Support unlimited members inside 'IN' clause
	;  MRP417  (07/19/94)   - Fix proper collation functions
	;  DPV177  (04/25/94)   - Make routine , 14K INT size, Clean up code
	;  MRP379  (03/04/94)   - Process new prefix extended functions (+, -, " ") for index maps
	;  MRP378  (03/01/94)   - If TEXT or Name fields use < > operators change to ] (follows)
	;  AK275   (11/20/93)   - Implement %EXTERNAL for fields
	;  VGG062               - do not generate $g from a literal (only from variable)
	;  AK264   (05/06/93)   - assign long logical sub-expressions into variables
	;  AK002;AK030;AK034;AK035;AK057;SRH065;AK115;AK116;AK130;AK135
	;  IS026;AK145;AK170;IS102;AK184;AK188;EYT148;ALL003;EYT167;MRP168
	;  EYT170;RGG460;AK214;AFH001;AK255
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
#ENDIF  ;-------------------------------------------------------------
	$$$Abort  ; Not an Entry Point!!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK390
once(varname="",name="")	
	n var,val  ;  $$: return prefix code to run the rest
	#;      of the line only once, using a scratch variable
	if varname="" {
		set var=$$scratch(.val,0,name)
	} else {
		set var=$$$getVarName(varname),val=$$$VarNum(varname)
	}
	d null^%qaqcasl(val)
	QUIT "i '"_var_" s "_var_"=1 "
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK390-
	#; AK402
conv(v) n varf  ;  apply ODBCOut() before copying, if necessary
	#;  *** hopefully remove soon, should be done already
	#;  set up by sqlcomp->getvalex->odbcout^qaqcasl
	s varf=pti($p(v,"^",4)),v=$p($p(v,"^",2),":",2)
	#; AK668
	#;  v = i^APPCONV:fval^^arg^ , the method depends on mt("sqlcomp")
	QUIT $$convnull(varf,$$appmeth(varf,$s(mt("sqlcomp")="%ODBC":"LogicalToOdbc",mt("sqlcomp")="%Runtime":"LogicalToRuntime",1:"LogicalToDisplay"),v))
	#; AK668-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK402-
	#; AK446
convnull(arg,fun)  ;  $$:  generate code:  $s(arg="":"",1:fun)
	QUIT:arg=fun arg
	QUIT "$s("_arg_"="""":"""",1:"_fun_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK446-
	#; AK438
onesub(icols,scratch) [pti,mt] public { ;  $$:  variable for use as DISTINCT subscript -
	#;  either a single field, or a scratch variable holding $LB(icols), if scratch passed in use this as the scratch variable
	QUIT:'$p(icols,",",2) pti(+icols)
	s flist=$listfromstring($zstrip(icols,">",","),",")
	if $data(scratch) {
		s varname=$$$getVarName(scratch),icol=$$$VarNum(scratch)
	} else {
		s varname=$$scratch(.icol)
	}
	d copy^%qaqcpre("8^"_flist_"^"_icol)
	QUIT varname
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
distnull(icols)  ;  $$:  whether icols is a single nullable field
	QUIT:$p(icols,",",2) 0  ;  >1 fields - $LB() used
	QUIT $$nullreplace^%qaqcct(+icols)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK438-
	#; MRP466  (Handle Collation Expressions) removed by DPV798,AK403, restored by PVA059
expswap(func,var) ; Swap the function {ifn} with the given variable 'var'
 #; Swap {ifn} with 'var'
 f  q:func'["{"  s func=$p(func,"{")_var_$p(func,"}",2,*)
 QUIT $$shout^%qaqpqo(func)
 #;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; MRP466  (Handle Collation Expressions) removed by DPV798,AK403, restored by PVA059-
logic()
	s op=$p(string,"^",2)
	#; AK654
	i $l(string,"^")=6,"&!"[op GOTO andor
	s val4=$$cond($p(string,"^",4))
	s:op="ANYOFAND" op = "&&"
	#; See if its the 'NOT' operator. If so...do it.
	QUIT:op="'" "'"_val4
	#;  if expr too long, assign its longer part into a var
	f i5=5:1 s log=$p(string,"^",i5) q:log=""  s cond=$$cond(log) d:$L(val4)+$L(cond)>$$$complength  s val4=val4_op_cond
	. i $l(val4)<$l(cond) s cond=$$setvar(cond) q
	. s val4=$$setvar(val4)
	QUIT "("_val4_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK654
andor	n arg1,arg2,sq1,sq2,vlog  ;  use lazy evaluation &&/|| for AND/OR
	#;  restructure lazy evaluation if subquery or extrinsic function used
	s arg1=$p(string,"^",4),arg2=$p(string,"^",5),sq1=$$findtree("l",arg1,"qe"),sq2=$$findtree("l",arg2,"qe")
	i 'sq1='sq2 {  ;  neither (or both) have subqueries - just use &&/||
		s arg1=$$cond(arg1),arg2=$$cond(arg2)
			#;  if expr too long, assign its longer part into a var
			#;  DPV3245 - use 1200 instead of complength here.  complength generated a line around 3700 characters, but the line
			#;  had so many operations on it that $Compile could not handle it and returned either a <STACK> or a <STORE> error
			#;  (depending on the version).  Not as big a deal anymore to cram everything in to one line anyway with system BOL
			#;  changes in 2009.1.
		i $l(arg1)+$l(arg2)>1200 {	// DPV3245
			s:$l(arg2)>$l(arg1) vlog=arg1,arg1=arg2,arg2=vlog
			s arg1=$$setvar(arg1)
		}
		QUIT "("_arg1_$s(op="&":"&&",1:"||")_arg2_")"
	}
	s:sq1 vlog=arg1,arg1=arg2,arg2=vlog  ;  now arg2 has the subquery
	s vlog=$$$getVarName("log"_log)
	$$$liin("i "_$e("'",op="&")_$$cond(arg1)_" { s "_vlog_"="_(op="!")_" } else {")
	#;  any extra lines generated for arg2 will be part of the else{} !
	#; Because any evaluation of arg2 done here is conditional, it needs an independent
	#; scope for davals. What's already evaluated for arg1 is available for all rows, but anything newly
	#; evaluated (by $$cond) for arg2 is only available there.
	n davals s davals = $$cgcGet^%qaqcasl("davals")
	n cgc d cgcInit^%qaqcasl() d cgcSet^%qaqcasl("davals",davals)
	$$$liin("s "_vlog_"="_$$cond(arg2)_" }")
	QUIT vlog
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK654-
setvar(x) n line,scr  ;   $$:  assign x into a scratch variable
	s line="",scr=$$scratch(,1)  ;  assign a new scratch variable
	d adset^%qaqcpre(scr,x),setin^%qaqcpre       ;  add the new line with the SET
	QUIT scr
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
sw	;           compare val4 and cond by 2 $Pieces
	n line,nm1	// AK413= (line) //DPV1894= (nm1)
	s line=$$scratch(.nm1,1),line="s "_$$scratch(,1)_"="_cond $$$liin(.line)
	d copy^%qaqcpre(3_"^"_(nm1+1)_"^"_nm1_","_(nm1+1))  ;  separate into 2 $Pieces
	QUIT "("_$$swex("$p("_val4_","","")",pti(nm1))_"&"_$$swex("$p("_val4_","","",2)",pti(nm1+1))_")"
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
swex(a,b)  ; generate a %STARTSWITH b
	QUIT "(($c(0)["_b_")||("_b_"=$c(32,0)&&($e("_a_")=$c(32)))||("_b_"=$e("_a_",1,$l("_b_"))))"	// JLF089
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddname()  ; $$ function - return 1 if field of ADT SQL Category is NAME, 0 if not
	s x=$$$mtV($p(string,"^",4))
	QUIT:$e(x)'="f" 0
	QUIT $$GetFieldCategory^%qaqcct(+$p(x,"^",3))="NAME"  ;  DPV837
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
davalue(val)  ;  $$: val's run-time variable da(), but first eval and SET it
	#;  i '$$cgc^%qaqcasl() { n cgc d cgcInit^%qaqcasl() }  ;  TRW1449  ;  removed by AK1090
	RETURN $$setda(val,$$ptvalue(val))  ;  AK1090
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setda(val,xpr)  ;  $$: the run-time variable for val, after setting xpr into it  ;  AK1090
	if xpr'=pti(val) {  ;  but not if already in  ;  AK610
		$$$liin("s "_pti(val)_"="_xpr)  ;  DPV1113;AK479
		d cgcApnd^%qaqcasl("davals",val_",")
		set:$d(rtpcHelperCode("caller")) vList(val)=""
		if $$evalLiteral(xpr) {
			set pti(val)=xpr  ; Would be nice to avoid setting this variable and just rely on updating pti but we may have already referenced it
		}
	}
	RETURN pti(val)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK605
findtree(type,val,evlist)  ;  search subtree of val for nodes of type evlist
	n found,call s found=0,call="evfind^%qaqcpr"
	do lvtree^%qaqpnl(type,val)
	QUIT found  ;  return any one found
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
evlist	;  check for 'evlist', called from findtree->lvtree with type,val,v,ev
evfind	;  check for 'evlist', called from findtree->lvtree with type,val,v,ev
	#; AK694
	i ev="x",$p(v,"^",2),evlist["n" s found=val  ;  treat JSV fake x^NN as "correlated"
	s:evlist[ev found=val  ;  entry found - set its val in 'found'
	GOTO:'found lvarg^%qaqpnl  ;  recurse down
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK605-
ptvalue(val)  ;
	#;  $$:  returns an expression which is
	#;  the expanded representation of this 'val' in  $$$mtV(val).
	#;  Unless redundant, the expression is in Parenthesis.
	#; DPV700
	QUIT:val="" """"""
	RETURN:($d(rtpcHelperCode("caller"))&&($d(vList(val)))) pti(val)
	RETURN:$lf($g(mt("eval")),val) pti(val)  ;  AK970
	RETURN:$lf($g(mt("invar",+$g(mod,0))),val) pti(val)
	RETURN:$g(mod)&&$g(m)&&$$$isParentModule(mod,m)&&((","_$g($$$mtAPEWorkerOutputs(m))_",")[(","_val_",")) pti(val)
	//Create a new context for evaluation if none exists
	#;  i '$$cgc^%qaqcasl() { n cgc d cgcInit^%qaqcasl() }  ;  TRW1449  ;  removed by AK1090
	n flag,holdval,i,i5,line,op,string,tval s holdval=val  ; AK413 - NEW line
	s string=$$$mtV(val),flag=$e(string)
	#; First we check the 'simple' fields.  We know what they are.
	QUIT:"ftxai"[flag pti(val) ; regular old field, constant, variable, scratch or aggregate madness
	#; AK669
	If flag="n" {
		New ref Set ref = $p(string,"^",4)
		If $g(mt("evalBeforeUse", ref)) QUIT $$ptvalue(ref)
		QUIT pti(val)  ;  correlated fields
	}
	#; AK669-
	#; AK563
	QUIT:flag="s" $$ptvalue($p(string,"^",4))  ;  AS alias - evaluate it
	#; DPV1017
	QUIT:"ns"[flag pti($p(string,"^",4))  ;  Name/Alias : used for correlated fields and quantified comparison
	#; DPV1732
	If $p(string,"^",1,2)="v^UNDEFINEDARG" QUIT ""	// Want to return an empty string
	#;  Now these are ALL based on other stuff, generated recursively.
	QUIT:$$cgcGet^%qaqcasl("davals")[(","_val_",") pti(val)  ;  already in
	#; AK605
	#;  compute streamless expressions at OPEN, but not if it contains
	#;  aggregates, subqueries, or correlated fields *** could be improved
	i opflag,$p(string,"^",3)=",",'$$findtree("v",val,"aqn"),'$$findWindowFunction(val) d opex(val) QUIT pti(val)
	If flag="q"{
		#;  implement subquery
		Goto subq
	}
	#; AK605-
	QUIT:$e(string,1,6)="l^L2V^" $$cond($p(string,"^",4))  ;  log->val  ; AK385
	g:flag="e" extfunc ; extrinsick funk
	#;  must be subexpression - operand and a list of values
	s op=$p(string,"^",2),op=$s(op="P":"+",op="M":"-",op="S":" ",1:op)
	#; AK505
	QUIT:$e(op,1,4)="SET:" $$setval(val)
	#; AK336
	#;  method call - get code, generate subroutine, call with arguments
	if $e(op,1,7)="METHOD:" {
		set op=$p(op,":",2)
		new cls,dt,ifn,irn,param,prop
		do ddgetf($p(string,"^",4),.dt,.param,.cls,.prop,.irn,.ifn)
		QUIT $$genmeth($p(op,".",1,*-1),$p(op,".",*),.param,$$genargs($p(string,"^",4,*)),cls,prop,irn,ifn)
	}
	#;  extrinsic function call
	QUIT:$e(op,1,7)="EXTFUN:" "$$"_$TR($p(op,":",2),".","^")_"("_$$genargs($p(string,"^",4,*))_")"
	#;  intrinsic function call (COS system function)
	QUIT:$e(op,1,7)="INTFUN:" $p(op,":",2)_"("_$$genargs($p(string,"^",4,*))_")"
	#;  COS system variable
	QUIT:$e(op,1,7)="SYSVAR:" $p(op,":",2)
	if op="%SUBQCACHE" QUIT $$subqcache(val,mod,m)
	QUIT:$e(op,1,16)="%WINDOW_FUNCTION" $$windowFunction(val)
	#; AK336-
	n arg1 s arg1=$p(string,"^",4)
	#; AK479
	n arg2 s arg2=$p(string,"^",5)
	n targ1,targ2
	#;  account for NULL, zero-length string
	i op="_" {
		d davalue(arg1),davalue(arg2)
		s arg1=pti(arg1),arg2=pti(arg2)
		if $$evalLiteral(arg1,.targ1) {
			if $$evalLiteral(arg2,.targ2) {
				If targ1=""||(targ2="") QUIT """"""
				If targ1=$c(0) QUIT arg2
				If targ2=$c(0) QUIT arg1
				QUIT arg1_"_"_arg2
			} else {
				If targ1="" QUIT """"""
				If targ1=$c(0) QUIT arg2
				QUIT "$s("_$$notnull1(arg2)_arg2_"=$c(0):"_arg1_",1:"_arg1_"_"_arg2_")"
			}
		} elseif $$evalLiteral(arg2,.targ2) {
			If targ2="" QUIT """"""
			If targ2=$c(0) QUIT arg1
			QUIT "$s("_$$notnull1(arg1)_arg1_"=$c(0):"_arg2_",1:"_arg1_"_"_arg2_")"
		} else {
			QUIT "$s("_$$notnull2(arg1,arg2)_arg1_"=$c(0):"_arg2_","_arg2_"=$c(0):"_arg1_",1:"_arg1_"_"_arg2_")"
		}
	}
	#; AK479-
	/*  CODE IS OBSOLETE.  Leaving it here as a comment so we can see how we handled JSON_TABLE in SEARCH_INDEX in case we decide to revive the feature.
	                       Feature was implemented originally by DLP3494/DLP3497, but was removed from the product when it was decided many JSON features would not be released. 
	i $e(op,1,13)="SEARCH_INDEX:" {
		new tFunction,className,eoovar,indexDef,indexName
		set eoovar=$s(%msqlvar="i%%CursorData":"%mmmsqlEOO",1:$$$getVarName("ExceptionOref")),mt("has udf")=1
		if $$$%msqlvarIsLocalVar||(%msqlvar="i%%CursorData") { d vNEW^%qaqcasl(eoovar) }
		set className = $p(op,":",2)
		if $e(className)'="#" {
			set tFunction="##class("_$p(op,":",2)_")."_$$$QN($p(op,":",3)_"Find")_"("_$$genargs($p(string,"^",4,*))_")"	// ##class(classname).methodname(...)
			set line="try { set "_pti(holdval)_"="_tFunction_" } catch "_eoovar_" { set SQLCODE=-149,%msg=""Index method "_$p(op,":",2)_"."_$p(op,":",3)_"Find(...) failed with error:  SQLCODE=""_"_eoovar_".AsSQLCODE()_"",%msg=""_"_eoovar_".AsSQLMessage() ztrap ""SQER"" }" $$$liin(.line)
		} else {
			set indexName = $p(op,":",3)
			set indexDef = $g($$$smdJSONTABLEIndex(1,irn,indexName))
			set tFunction = className _ indexDef _ "," _$$genargs($p(string,"^",4,*))_")"	// ##class(classname).methodname(...)
			set line="try { set "_pti(holdval)_"="_tFunction_" } catch "_eoovar_" { set SQLCODE=-149,%msg=""Index method "_className_") on "_$e($$$quote(indexDef),2,*-1)_" failed with error:  SQLCODE=""_"_eoovar_".AsSQLCODE()_"",%msg=""_"_eoovar_".AsSQLMessage() ztrap ""SQER"" }" $$$liin(.line)
		}
		QUIT pti(holdval)
	}
	*/
	i $e(op,1,20)="USERDEFINEDFUNCTION:" {	// USERDEFINEDFUNCTION:classname:methodname:schema.procname:<call proc argument>
			#; The 5th ":" piece of the op is 1 indicates this is an argument to a call procedure, and we need to simply return the ##class method call without subroutinized code
		new args,argsCnt,classname,code,indexfind,methodname,tagx,tFunction
		set mt("has udf")=1,indexfind=0
		set classname=$tr($p(op,":",2),$c(2,3),":^"),methodname=$tr($p(op,":",3),$c(2,3),":^")
		if $e(methodname,*)=$c(1) { set indexfind=1,methodname=$e(methodname,1,*-1) }	// method name ending in $c(1) indicates this is a SEARCH_INDEX call (see code in %qaqpqo)
		set args=$p(string,"^",4,*),argsCnt=$l(args,"^")-1
#if 0 ; DLP4280-
		set tFunction="##class("_$$$QN(classname)_")."_$$$QN(methodname)_"("_$$genargs($p(string,"^",4,*))_")"	// ##class(classname).methodname(...)
#else ; DLP4280=
		if 'indexfind || ($extract(methodname,1,11) '= "JSON_TABLE#") {
	 		set tFunction="##class("_$$$QN(classname)_")."_$$$QN(methodname)_"("_$$genargs(args)_")"	// ##class(classname).methodname(...)
		} else {
			set indexName = $p(methodname,"#",2)
			set indexDef = $g($$$smdJSONTABLEIndex(1,irn,indexName))
			set tFunction = "##class("_$$$QN(classname)_").search(" _ indexDef _ "," _ $$genargs(args)_")"
		}
#endif ; DLP4280
		QUIT:$p(op,":",5) tFunction	// Argument to a CALL, this is all we need
		if $g(rtpcHelperCode("caller"))'=""{
			set tagx = "%rtpcUDF"_$I(rtpcHelperCode(-1))
			set rtpcHelperCode("helper",tagx,1) = tagx_"() try { new %err RETURN "_tFunction_" }"
			if 'indexfind { set rtpcHelperCode("helper",tagx,2) = $c(9)_"catch %err { set SQLCODE=-149,%msg=""SQL Function "_$p(op,":",4)_" failed with error:  SQLCODE=""_%err.AsSQLCODE()_"",%msg=""_%err.AsSQLMessage() ztrap ""SQER"" }" }
			else          { set rtpcHelperCode("helper",tagx,2) = $c(9)_"catch %err { set SQLCODE=-149,%msg=""Index method "_classname_"."_methodname_"(...) failed with error:  SQLCODE=""_%err.AsSQLCODE()_"",%msg=""_%err.AsSQLMessage() ztrap ""SQER"" }" }
			QUIT "$$"_tagx_"()"
		}
		set tagx=$$untag^%qaqcpre("udf")
		set code=0
			#; We new %0CacheRowLimit in this function so that if the UDF has an SQL statement, it is not row-limited by any setting we already defined in %0CacheRowLimit
		set code=code+1,code(code)=tagx_"() try { new %0CacheRowLimit,err RETURN "_tFunction_" }"
		if 'indexfind { // --- Code-Generate non-Index method 'catch err { ... }' code ---
			#;-------------------------------------------------------------------------------
			#; Add special Error Processing if the following conditions are true:
			#;   - If we're processing the following SQL Query Stored Procedure:
			#;       %SYSTEM.QUERY_PLAN(<sqlStr>,<showStats>,<planType>,<sqlPlan>,<callInfo>)
			#;   - If the value passed to the <sqlPlan> parameter is not the
			#;     refactored SQL Query Plan (Pass-through)
			#;-------------------------------------------------------------------------------
			new addSQLPlanErrProc
			set addSQLPlanErrProc=(($p(op,":",4)="%SYSTEM.QUERY_PLAN")&&($e($g($$$mtV(+$p(args,"^",4))),1,7)'="t^<plan"))
			set code=code+1,code(code)=$c(9)_"catch err { "_$s(addSQLPlanErrProc:"ztrap:(($g(SQLCODE)[""-481"")||($g(SQLCODE)[""-482"")||($g(SQLCODE)[""-99"")) ""EXPL"" ",1:"")_"set SQLCODE=-149,%msg=""SQL Function "_$p(op,":",4)_" failed with error:  SQLCODE=""_err.AsSQLCODE()_"",%msg=""_err.AsSQLMessage() ztrap ""SQER"" }"
		}
		else          { set code=code+1,code(code)=$c(9)_"catch err { set SQLCODE=-149,%msg=""Index method "_classname_"."_methodname_"(...) failed with error:  SQLCODE=""_err.AsSQLCODE()_"",%msg=""_err.AsSQLMessage() ztrap ""SQER"" }" }
		
		QUIT "$$"_$$subroutn^%qacsub("code","",1,1)_"()"
	}
	i $e(op,1,22)="USERDEFINEDFUNCTIONs1:" {							// DPV3085+
			#;  Used for %Text search functions that are passed a stream field and the stream field has OIDType 1
			#;  In this case we want to pass the stream Id, not the full Oid
		n qval s qval="##class("_$tr($p(op,":",2),$c(2,3),":^")_")."_$$$QN($tr($p(op,":",3),$c(2,3),":^"))_"("	// ##class(classname).methodname(
		If $p(string,"^",4)="" { s qval=qval_")" }  // No parameters
		Else {
			f i=4:1 {
				q:$p(string,"^",i)=""  // No more parameters
				if i=4 { s qval=qval_"$lg("_$$ptvalue($p(string,"^",i))_")," }		// add parameter to list
				else { s qval=qval_$$ptvalue($p(string,"^",i))_"," }			// add parameter to list
