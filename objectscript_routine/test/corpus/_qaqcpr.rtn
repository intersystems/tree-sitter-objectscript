		RETURN "$s("_val_"="""":"""","_val_"=+"_val_":+$p($zt("_val_",1),$zu(122,9)),"_val_"?0.1""-""1.7n||("_val_"?0.1""-""1.7N1"",""1.5N)||("_val_"?0.1""-""1.7N1"",""1.5N1""."".N):+$p($zt($p("_val_","","",2),1),$zu(122,9)),1:+$s($p("_val_","" "",2)="""":0,1:$p($ztime($ztimeh($p("_val_","" "",2),1),1),"":"",1)))"
