	QUIT:op="CONVERT:%Library.FilemanDate" "$s("_val_"="""":"""",1:"_$s($$$VTRgetcat(arg1)="TIMESTAMP":"($zdate($zdateh("_val_",3,,,,,,,0),8)-17000000)",1:val)_")"
		// CONVERT:%Library.FilemanTimeStamp is only generated internally in createlog^%qaqpdt, and we only need to convert from DATE to FMTIMESTAMP
	QUIT:op="CONVERT:%Library.FilemanTimeStamp" "$s("_val_"="""":"""",1:"_$s($$$VTRgetcat(arg1)="DATE":"($zdate("_val_",8)-17000000)",$$$VTRgetcat(arg1)="TIME":"(($zdate(+$h,8)-17000000)_"".""_($tr($zt("_val_",1),"":"")))",$$$VTRgetcat(arg1)="FMDATE":$$genmeth("%Library.FilemanDate","LogicalToOdbc",,val)_"_"" 00:00:00""",1:val)_")"
