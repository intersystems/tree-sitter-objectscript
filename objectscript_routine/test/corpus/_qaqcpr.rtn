		elseif $$$VTRgetcat(arg1)="FMDATE" 	{ QUIT "$s("_val_"="""":"""",1:"_$$genmeth("%Library.FilemanDate","LogicalToOdbc",,val)_"_"" 00:00:00"")" }
		elseif $$$VTRgetcat(arg1)="FMTIMESTAMP" { QUIT "$s("_val_"="""":"""",1:"_$$genmeth("%Library.FilemanTimeStamp","LogicalToOdbc",,val)_")" }
