		n fromtype,totype,typea,typeb
		s typea=$p($$$VTRgetdt(arg1),"(") s:typea="" typea="%Library.String"
		s typeb=$p($p(op,":",2),"(") s:typeb="" typeb="%Library.String"
		set fromtype=$$$comClassKeyGet(typea,$$$cCLASSodbctype)
		if $$$comClassKeyGet(typeb,$$$cCLASSsqlcategory)="POSIXTS" { set totype="POSIXTIME" } else { set totype=$$$comClassKeyGet(typeb,$$$cCLASSodbctype)_"("_$p($p(op,":",2),"(",2,*) }
		//set totype=$$$comClassKeyGet(typeb,$$$cCLASSodbctype)_"("_$p($p(op,":",2),"(",2,*)
		QUIT "$$msconvert^%qarfunc("_val_","""_fromtype_""","""_totype_""","_$$ptvalue(v)_","_$p(op,":",3)_","_+$g(mt("options","source-tsql"))_")"	// DPV1920=	// DPV2206=
	}
	if op="NULLIF" {
		new secondArg
		set secondArg=$$ptvalue(v)
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		if "#$"[$e(secondArg) { do davalue(arg2) set secondArg=pti(arg2) }
		RETURN "$s("_val_"="_secondArg_":"""",1:"_val_")"
	}
	if op="NVL" {
		new scr
		set scr=val
			#;  If arg1 is an extrinsic function call, we store the result in a scratch variable and just use that variable so the function is not called twice in the 'NULL check
		if $e(val,1,2)="$$" {
			new code,tagx
			set tagx=$$untag^%qaqcpre("nvl")
			set code=0
			set code=code+1,code(code)=tagx_"() new result set result="_val_" quit $s(result'="""":result,1:"_$$ptvalue(v)_")"
			QUIT "$$"_$$subroutn^%qacsub("code","",1,1)_"()"
		}
		RETURN "$s("_scr_"'="_$$colnul(arg1)_":"_scr_",1:"_$$ptvalue(v)_")"
	}
	If op="%OBJECT" {
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		RETURN "$s("_val_"'="""":##class(%Stream.Object).%Open("_val_"),1:"""")"
	}
	if op="%OID" {
		new ifn,irn,oidclass
		set irn=$$$VTRgetirn(arg1),ifn=$$$VTRgetifn(arg1),oidclass=""
			// If val is a reference field, we need to get the classname this field references and call its %ComposeOid() methed.
			// Otherwise, assume the field is an ID (checked already)
		if ifn {
			new reftab
			set reftab=$$$smdColReferencedTable(1,irn,ifn)
			set:reftab'="" oidclass=$$$GetClassNameFromIQN(reftab)
		}
		set:oidclass="" oidclass=$$$smdClassname(1,irn)
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		RETURN "$s("_val_"="""":"""",1:##class("_oidclass_").%ComposeOid("_val_"))"
	}
	QUIT:op="PATINDEX" "$$PATINDEX^%qarfunc("_val_","_$$ptvalue(v)_")"  ; DPV2618
	QUIT:op="PI" "$zpi"
	If op="PIECE" {	// DPV2093
		n del,null,p1,p2 s del=$$ptvalue(v),p1="",p2=""
		s:$p(string,"^",6)'="" p1=$$ptvalue($p(string,"^",6))	// Position 1
		s:$p(string,"^",7)'="" p2=$$ptvalue($p(string,"^",7))	// Position 2
		//s null=$s(p2'="":$$notnull3(del,p1,p2),p1'="":$$notnull2(del,p1),1:$$notnull(del))
		QUIT "$Piece("_val_","_del_$s(p1'="":","_p1,1:"")_$s(p2'="":","_p2,1:"")_")"
	}
	if op="POSITION" {
		new exprTemp1
		set exprTemp1=$$ptvalue(v)
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		if "#$"[$e(exprTemp1) { do davalue(arg2) set exprTemp1=pti(arg2) }
		RETURN "$s("_$$notnull2(val,exprTemp1)_"$f("_val_","_exprTemp1_"):$f("_val_","_exprTemp1_")-$l("_exprTemp1_"),1:0)"
	}
	if op="PREDICT" {	// PREDICT(model-name [ WITH value-name = field-expr { , value-name2 = field-expr2 } ] )
		new i,qval,types
			#; get the types for all the field=expressiions
		set types=""
			// beginning with piece 6, we have value-expr1 (6), value-expr2 (7), ...
		if v="" { set qval="$$Predict^%qarfunc("_val_","""","_$$ptvalue(mt("qmlcontext",val))_")" }	// simple case, PREDICT(model-name)
		else {
			set qval="$$Predict^%qarfunc("_val_","_$$ptvalue($p(string,"^",5))_","_"$lb("_$$ptvalue($p(string,"^",6))	// p5 is the usr trainde-model-name
			for i=7:1 {
				quit:$p(string,"^",i)=""
				set qval=qval_","_$$ptvalue($p(string,"^",i))
			}
			set qval=qval_"),"_$$ptvalue(mt("qmlcontext",holdval))_")"
		}
		RETURN qval
	}
	if op="POWER" {
		new exprTemp1
		set exprTemp1=$$ptvalue(v)
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		if "#$"[$e(exprTemp1) { do davalue(arg2) set exprTemp1=pti(arg2) }
		RETURN "$s("_$$notnull2(val,exprTemp1)_"1:("_val_"**"_exprTemp1_"))"
	}
	if op="PROBABILITY" {	// PROBABILITY(model-name [USE trined-model-name ] [ FOR expr ] WITH ... )
			#; val is the model name
		new i,qval
			#; p4 is the model name
			#; p5 is the tained-model-name from USE
			#; p6 is the FOR expr
		set qval="$$Probability^%qarfunc("_val_","_$$ptvalue($p(string,"^",5))_","_$$ptvalue($p(string,"^",6))_",$lb("_$$ptvalue($p(string,"^",7))
		for i=8:1 {
			quit:$p(string,"^",i)=""
			set qval=qval_","_$$ptvalue($p(string,"^",i))
		}
		set qval=qval_"))"
		RETURN qval
	}
	if op="QUARTER" {
		new convcode
		set convcode=$$ConvertToDate2(arg1,val,1)
		if convcode'=val {	// conversion is needed
			set val=$$scratch(,1)
			set line="set "_val_"="_convcode $$$liin(.line)			
		}
		//        null              logical %Date or $Horolog or $zts                                                                                                                                            else ,assume %TimeStamp format        
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		RETURN "$s("_val_"="""":"""","_val_"?0.1""-""1.7n||("_val_"?0.1""-""1.7N1"",""1.5N)||("_val_"?0.1""-""1.7N1"",""1.5N1""."".N):$case(+$zdate("_val_",1,,,,,-672045),1:1,2:1,3:1,4:2,5:2,6:2,7:3,8:3,9:3,:4),1:$case(+$zdate($zdateh("_val_",3,,,,,-672045),1,,,,,-672045),1:1,2:1,3:1,4:2,5:2,6:2,7:3,8:3,9:3,:4))"
	}
	if op="RADIANS" {
		// Radians = Degrees * (pi / 180)
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		RETURN "$s("_val_"="""":"""",1:("_val_"*"_($zpi/180)_"))"	// Perform $zpi/180 at compile time to reduce run-time overhead
	}
	QUIT:op="REPEAT" "$$repeat^%qarfunc("_val_","_$$ptvalue(v)_")"  ; DPV1339
	QUIT:op="REPLACE" "$$REPLACE^%qarfunc("_val_","_$$ptvalue(v)_","_$$ptvalue($p(string,"^",6))_")"  ; DPV2686=
	QUIT:op="REVERSE" "$reverse("_val_")"  ; DPV2284=
	if op="RIGHT" {
		new exprTemp1
		set exprTemp1=$$ptvalue(v)
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		if "#$"[$e(exprTemp1) { do davalue(arg2) set exprTemp1=pti(arg2) }
		RETURN "$s("_$$notnull2(val,exprTemp1)_"1:$e("_val_",*-("_exprTemp1_"-1),*))"
	}
	QUIT:(op="ROLES") "$zstl($Roles)"	; See also {fn USER()}	// JLF016= DPV2324 (eliminate %msqlgrp)
	if op="ROUND" {
		new exprTemp1
		set exprTemp1=$$ptvalue(v)
		if $p(string,"^",6)'="" { new trunc set trunc=$$ptvalue($p(string,"^",6)) }		// truncate or round
		RETURN "$$ROUND^%qarfunc("_val_","_exprTemp1_","_$g(trunc)_")"
	}
	if op="RPAD" {
		new exprTemp1
		set exprTemp1=$$ptvalue(v)
		new padstr if $p(string,"^",6)'="" { set padstr=$$ptvalue($p(string,"^",6)) } else { set padstr = " " }
		RETURN "$$rpad^%qarfunc("_val_","_exprTemp1_","_padstr_")"
	}
	if op="RTRIM" {
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		RETURN "$s("_val_"="""":"""",$zstrip("_val_","">W"")="""":$c(0),1:$zstrip("_val_","">W""))"
	}
	#; JLF019= QUIT:op="%SCORE" $$ptvalueSCORE^%qaqcpre(val,v)
	if op="SECOND" {
		do CheckForTimeStampConversion(1)
		//        null               logical %Time                                    logical %Date or $Horolog                                                                                                                   else ,assume %TimeStamp format        
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		RETURN "$s("_val_"="""":"""","_val_"=+"_val_":+$p($zt("_val_",1),$zu(122,9),3),"_val_"?0.1""-""1.7n||("_val_"?0.1""-""1.7N1"",""1.5N)||("_val_"?0.1""-""1.7N1"",""1.5N1""."".N):+$p($zt($p("_val_","","",2),1),$zu(122,9),2),1:+$s($p("_val_","" "",2)="""":0,1:$p($ztime($ztimeh($p("_val_","" "",2),1),1,9),"":"",3)))"
	}
	if op="SIGN" {
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		RETURN "$s("_val_">0:1,"_val_"<0:-1,($isvalidnum("_val_")||($e("_val_")=0))&&(+"_val_"=0):0,1:"""")"
	}
	if op="SIN" {
		RETURN $$evalOnce(val,arg1,"$zsin("_$c(1)_")")
	}
	QUIT:op="SPACE" "$j("""","_val_")"  ; DPV1339
	if op="SQRT"||(op="SQRT_AGG") {
		RETURN $$evalOnce(val,arg1,"$zsqr("_$c(1)_")")
	}
	If op="STR" {	// DPV2288=
		n dec,len s dec=0,len=10
		s:v'="" len=$$ptvalue(v)					// Length
		s:$p(string,"^",6)'="" dec=$$ptvalue($p(string,"^",6))		// Decimal
		QUIT "$$STR^%qarfunc("_val_","_len_","_dec_")"
	}
	If op="STRING" { // --- Code-Generate the Sybase SQL Anywhere STRING(<arg-list>) Function ---
		#;--------------------------------------------------------------------------------
		#; Code-Generation BNF for the Sybase SQL Anywhere STRING(<arg-list>) Function:
		#;   <arg> ::= <arg-null> | <arg-empty-str> | <arg-lit> | <arg-var>
		#;   <arg-list> ::= <arg> [ ,<arg> ]
		#;   <arg-null> ::= ""                                            // <term>
		#;   <arg-empty-str> ::= $c(0)                                    // <term>
		#;   <arg-lit> ::= <literal>                                      // <term>
		#;   <arg-var> ::= <param> | <scalar function>                    // <term>
		#;
		#;   <arg-null-test> ::= (<arg>="")
		#;   <arg-null-all> ::= <arg-null-test> [ &&<arg-null-test> ]     // var: exprTemp1
		#;   <arg-var-all> ::= <arg-var> [ _<arg-var-all> ]               // var: qvalTest
		#;   <arg-var-all-str> ::= $tr(<arg-var-all>,$c(0),"")
		#;   <arg-all> ::= <arg> [ _<arg-all> ]                           // var: qval
		#;   <arg-all-str> ::= $tr(<arg-all>,$c(0),"")
		#;
		#;   <string-fx> ::= <arg-null> |            // If all <arg> values are <arg-null>
		#;                   <arg-empty-str> |       // If all <arg> values are <arg-empty-str> [ and <arg-null> ]
		#;                   [ $s(<arg-null-all>:"",1: ] { [ $s(<arg-var-all-str>'="":<arg-all-str>,1:<arg-empty-str>) ] | [ ( ] <arg-all> [ ) ] } [ ) ]
		#;--------------------------------------------------------------------------------
		new arg,cgLine,isES,isLit,isNULL,isVar,exprTemp1,pos,qval,qval2,qvalTest,totArg,totES,totLit,totNULL,totVar,val ; DPV1352 ; DPV1430 ; MRP1276
		set qval="",qvalTest="",exprTemp1="",totArg=0,totES=0,totLit=0,totNULL=0,totVar=0
		for pos=4:1 { // --- Process All STRING(<arg-list>) Arguments/Parameters ---
			set val=$p(string,"^",pos)
			QUIT:val=""  // No more STRING(<arg-list>) arguments/parameters!
			
			set arg=$$ptvalue(val),totArg=totArg+1
			set isES=0,isLit=0,isNULL=0,isVar=0
			if (arg="""""") { set isNULL=1,totNULL=totNULL+1 } // Optimize for NULL arguments!
			elseif (arg="$c(0)") { set isES=1,totES=totES+1 }  // Optimize for Empty-String arguments!
			elseif ($e(arg,1)="""")&&($e(arg,*)="""")||$isvalidnum(arg) { set isLit=1,totLit=totLit+1 } // Optimize for Literal arguments!
			elseif ($e(arg,1,2)="(""")&&($e(arg,*-1,*)=""")")&&($p($g($$$mtV(val)),"^",2)="STRING") { set isLit=1,totLit=totLit+1 } // Optimize for Literal sub-STRING(<arg-list>) arguments!
			else { set isVar=1,totVar=totVar+1 }  // Optimize for Variable arguments!
						
			set:'(isES||isNULL) qval=qval_$s(qval'="":"_",1:"")_arg  // Don't include <arg-null> or <arg-empty-str> in <arg-all>!
			if isVar { // --- Process Variable Arguments/Parameters ---
				set qvalTest=qvalTest_$s(qvalTest'="":"_",1:"")_arg
				set exprTemp1=exprTemp1_$s(exprTemp1'="":"&&",1:"")_"("_arg_"="""")"
			}
		}
		if (totNULL=totArg) { // --- All STRING(<arg-list>) Arguments/Parameters are NULL ---
			set cgLine=""""""  // RETURN value is NULL!
		}
		elseif ((totES+totNULL)=totArg) { // --- All STRING(<arg-list>) Arguments/Parameters are Empty-String ---
			set cgLine="$c(0)" // RETURN value is Empty-String!
		}
		else { // --- Evaluate STRING(<arg-list>) Arguments/Parameters ---
			#;--------------------------------------------------------------------------------
			#; Optimization Notes: 
			#;   1) Code-generate the NULL equivalency test <arg-null-all> only if one 
			#;      or more of the function's <arg> values is <arg-var> and none of the other
			#;      <arg> values is <arg-empty-str> or <arg-lit>: 
			#;         s <into-var>=$s(<arg-null-all>:<arg-null>,1:...)
			#;   2) Code-generate the non-NULL equivalency test (<arg-var-all-str>'="") 
			#;      unless one or more of the function's <arg> values is <arg-lit>: 
			#;         $s(...,1:$s(<arg-var-all-str>'="":...
			#;   3) Code-generate the empty-string <arg-empty-str> to NULL <arg-null> 
			#;      translation <arg-all-str> unless all of the function's <arg> values 
			#;      are <arg-null> and <arg-lit>: 
			#;         $s(...,1:$s(...:<arg-all-str>,...
			#;   4) Treat the value returned from the SQL STRING(<arg-list>) function
			#;      as a <arg-lit> if used as a parameter of the STRING(<arg-list>) function
			#;--------------------------------------------------------------------------------
			set cgLine=$s((exprTemp1'="")&&'(totES+totLit):"$s("_exprTemp1_":"""",1:",1:"")_$s('totLit&&(qvalTest'=""):"$s($tr("_qvalTest_",$c(0),"""")'="""":",1:"")_$s(totVar:"$tr(",$isvalidnum(qval):"""",1:$s((totArg-(totNULL+totES))>1:"(",1:""))_qval_$s(totVar:",$c(0),"""")",$isvalidnum(qval):"""",1:$s((totArg-(totNULL+totES))>1:")",1:""))_$s('totLit&&(qvalTest'=""):",1:$c(0))",1:"")_$s((exprTemp1'="")&&'(totES+totLit):")",1:"")
		}
		RETURN cgLine
	}
	If op="STUFF" {	// DPV2615
		n start,length,subStr
		s:v'="" start=$$ptvalue(v)					// start
		s:$p(string,"^",6)'="" length=$$ptvalue($p(string,"^",6))	// length
		s:$p(string,"^",7)'="" subStr=$$ptvalue($p(string,"^",7))	// subStr
		QUIT "$$STUFF^%qarfunc("_val_","_start_","_length_","_subStr_")"
	}
	if op="SUBSTR" {
		new exprTemp1,exprTemp2
		set exprTemp1=$$ptvalue(v)
		set exprTemp2=$$ptvalue($p(string,"^",6))
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		if "#$"[$e(exprTemp1) { do davalue(arg2) set exprTemp1=pti(arg2) }
		RETURN "$s("_exprTemp1_"="""":"""",1:$e("_val_",$s("_exprTemp1_">0:"_exprTemp1_","_exprTemp1_"<0:$l("_val_")+1+"_exprTemp1_",1:1),$s("_exprTemp1_">0:"_exprTemp1_","_exprTemp1_"<0:$l("_val_")+1+"_exprTemp1_",1:1)+"_exprTemp2_"-1))"
	}
	if op="SUBSTRING" { RETURN "$zu(217,"_val_","_$$ptvalue(v)_","_$$ptvalue($p(string,"^",6))_")" }
		#;		s v="("_val_","_$$ptvalue(v)_","_$$ptvalue($p(string,"^",6))_")"
		#;		QUIT:$g(callname)[("view"_$c(1)) "$$SUBSTRING^%apiSQL"_v  ;  DPV1818 for CHECK/WHEN
		#;		  #;  NOTE:  If this code is updated, also update SUBSTRING^%apiSQL
		#;		n code s code=1
		#;		s code(1)="(c,s,l) [] PUBLIC { q:c=""""||(s="""")||(l="""") """""
		#;		s code(1)=code(1)_" s lc=$l(c),e=s+l"
		#;		s code(1)=code(1)_" i e<s { ZTRAP ""SUBS"" } q:s>lc||(e<1) $c(0)"
		#;		s code(1)=code(1)_" s:s<1 s=1 s:e>(lc+1) e=lc+1 q $e(c,s,s+(e-s)-1) }"
		#;		QUIT "$$"_$$tagnam^%qaqcasl("s")_v
		#;	}
	i op="SUBSTRING:STREAM" {	 // DPV2994
		s v="("_val_","_$$ptvalue(v)_","_$$ptvalue($p(string,"^",6))_")"
		QUIT:$g(callname)[("view"_$c(1)) "$$SUBSTRING^%apiSQL"_v  ;  DPV1818 for CHECK/WHEN
		  #;  NOTE:  If this code is updated, also update SUBSTRING^%apiSQL
		n code s code=1
		s code(1)="(c,s,l) [] PUBLIC { q:c=""""||(s="""")||(l="""") """""
		If $$$VTRgetoref(arg1)=1 { s code(1)=code(1)_" s oref=c" }	// SUBSTRING(%OBJECT(StreamField))
		Else { s code(1)=code(1)_" s oref=##class(%Stream.Object).%Open(c)" }
		s code(1)=code(1)_" q:oref.IsNull() """" s lc=oref.Size,e=s+l"			// DPV3212 Return NULL if IsNull()
		s code(1)=code(1)_" i e<s { ZTRAP ""SUBS"" } q:s>lc||(e<1) $c(0)"
		s code(1)=code(1)_" s:s<1 s=1 s:e>(lc+1) e=lc+1 q oref.ReadSQL(s,s+(e-s)-1) }"
		QUIT "$$"_$$tagnam^%qaqcasl("s")_v
	}
#IF	1	; JLF414+
	QUIT:op="%SW2LE" "("_val_"_$c($s($zbitget($zversion(0),1):65535,1:255)))" 
#ENDIF	; JLF414-
	if op="TAN" {
		RETURN $$evalOnce(val,arg1,"$ztan("_$c(1)_")")
	}
	if op="TO_VECTOR" {
		new lengthVal,lengthRuntimeVar,par,type
		set lengthVal = $p(string,"^",6)
		set type = $p($$$mtV(arg2),"^",2)
		if lengthVal'="" {
			do davalue(lengthVal)
			set lengthRuntimeVar = pti(lengthVal)
		}
.
		RETURN "$s("_val_"="""":"""",1:$$tovector^%qarfunc("_val_","""_type_""""_$s(lengthVal="":"))", 1:","_lengthRuntimeVar_"))")
	}
	if op="EMBEDDING" {
		new configName
		if arg2 '= ""{
			do davalue(arg2)
			set configName=pti(arg2)
		}
		RETURN "$$embedding^%qarfunc("_val_$s($d(configName)=0:"",1:","_configName)_$s($d(mt("embeddingModelName",holdval))=0:")", 1:","""_mt("embeddingModelName",holdval)_""")")
	}
	QUIT:op="TOCHAR" "$$tochar^%qarfunc("_val_","_$$ptvalue(v)_")" ; DPV1316
	QUIT:op="TODATE" "$$todate^%qarfunc("_val_","_$$ptvalue(v)_")" ; DPV1219
	QUIT:op="TOPOSIXTIME" "$$totimestamp^%qarfunc("_val_","_$s(v'="":$$ptvalue(v),1:"")_",1)"
	QUIT:op="TOTIMESTAMP" "$$totimestamp^%qarfunc("_val_$s(v'="":","_$$ptvalue(v),1:"")_")"	// DPV3335
	If op="TRANSLATE" {	// MRP777
		#;---------------------------------------------------------------------
		#;  BNF:
		#;
		#;    <TRANSLATE expression> ::=
		#;       $TRANSLATE (<string expression>, <identifier> [, <associator>] )
		#;---------------------------------------------------------------------
	    new associator,identifier,p6
		set identifier=$$ptvalue(v)					                            // <identifier>
		set p6=$p(string,"^",6),associator=$s(p6'="":$$ptvalue(p6),1:"")        // <associator>
	#; MRP877
		QUIT "$TRANSLATE("_val_","_"$s("_identifier_"=$c(0):"""",1:"_identifier_")"_$s(associator'="":","_"$s("_associator_"=$c(0):"""",1:"_associator_")",1:"")_")"
	}
		#; For TRIM_* functions, val is trimchar and exprTemp1 is trimsource
	if op="TRIM_BOTH"     { 
		new exprTemp1
		set exprTemp1=$$ptvalue(v)
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		if "#$"[$e(exprTemp1) { do davalue(arg2) set exprTemp1=pti(arg2) }
		RETURN "$s("_val_"="""":"""","_exprTemp1_"="""":"""",$zstrip("_exprTemp1_",""<>'E"","_val_")="""":$c(0),1:$zstrip("_exprTemp1_",""<>'E"","_val_"))"
	}
	if op="TRIM_LEADING" {
		new exprTemp1
		set exprTemp1=$$ptvalue(v)
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		if "#$"[$e(exprTemp1) { do davalue(arg2) set exprTemp1=pti(arg2) }
		RETURN "$s("_val_"="""":"""","_exprTemp1_"="""":"""",$zstrip("_exprTemp1_",""<'E"","_val_")="""":$c(0),1:$zstrip("_exprTemp1_",""<'E"","_val_"))"
	}
	if op="TRIM_TRAILING" {
		new exprTemp1
		set exprTemp1=$$ptvalue(v)
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		if "#$"[$e(exprTemp1) { do davalue(arg2) set exprTemp1=pti(arg2) }
		RETURN "$s("_val_"="""":"""","_exprTemp1_"="""":"""",$zstrip("_exprTemp1_","">'E"","_val_")="""":$c(0),1:$zstrip("_exprTemp1_","">'E"","_val_"))"
	}
		#; For TRIMSPACE_* functions, val is trimsource
	if op="TRIMSPACE_BOTH" {
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		RETURN "$s("_val_"="""":"""",$zstrip("_val_",""<>'E"","" "")="""":$c(0),1:$zstrip("_val_",""<>'E"","" ""))"
	}
	if op="TRIMSPACE_LEADING" {
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		RETURN "$s("_val_"="""":"""",$zstrip("_val_",""<'E"","" "")="""":$c(0),1:$zstrip("_val_",""<'E"","" ""))"
	}
	if op="TRIMSPACE_TRAILING" {
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		RETURN "$s("_val_"="""":"""",$zstrip("_val_","">'E"","" "")="""":$c(0),1:$zstrip("_val_","">'E"","" ""))"
	}
	if op="TRUNCATE" {
		new exprTemp1,qval
		set exprTemp1=$$ptvalue(v)
		set qval="$s("_$$notnull2(val,exprTemp1)      // handle if either argument is null
		set qval=qval_"$Number("_exprTemp1_",0)<0:+($e($p("_val_","".""),1,$l($p("_val_","".""))-(-$Number("_exprTemp1_",0)))_$e(""0000000000000000000"",0,-$Number("_exprTemp1_",0))),"   // negative scale case
		set qval=qval_"$Number("_exprTemp1_",0)>0:+$s("_val_"[""."":$p("_val_",""."")_"".""_$e($p("_val_",""."",2),1,+$Number("_exprTemp1_",0)),1:+"_val_"),"                      // positive scale case
		set qval=qval_"$Number("_exprTemp1_",0)=0:+$p("_val_","".""),1:"_val_")"	// scale = 0 case
		QUIT qval
	}
	QUIT:op="TSQL_BIT_AND" "$$TSQLBITLOGIC^%qarfunc(1,"_val_","_$$ptvalue(v)_")"	// DPV2747=
	QUIT:op="TSQL_BIT_OR" "$$TSQLBITLOGIC^%qarfunc(2,"_val_","_$$ptvalue(v)_")"	// DPV2747=
	QUIT:op="TSQL_BIT_XOR" "$$TSQLBITLOGIC^%qarfunc(3,"_val_","_$$ptvalue(v)_")"	// DPV2747=
	QUIT:op="TSQL_BIT_NOT" "$$TSQLBITLOGIC^%qarfunc(4,"_val_")"			// DPV2747=
	if op="TSQL_COL_NAME" {	// DPV2740
		n exprTemp1,qval s exprTemp1=$$ptvalue(v)
		QUIT "$s("_$$notnull2(val,exprTemp1)_"1:$lg($g(^oddTSQL("_val_",""col"","_exprTemp1_")),6))"
	}
	if op="TSQL_INDEX_COL" {	// DPV2743
		n indexId,keyNumber,userId 
		s indexId=$$ptvalue(v),keyNumber=$$ptvalue($p(string,"^",6))
		if $p(string,"^",7)'="" { s userId=$$ptvalue($p(string,"^",7)) } else { s userId="" }
		QUIT "$$TSQLINDEXCOL^%qarfunc("_val_","_indexId_","_keyNumber_","_userId_")"
	}
	QUIT:op="TSQL_LIKE" "$$TSQLLIKE^%qarfunc("_val_","_$$ptvalue(v)_$s($p(string,"^",6)'="":","_$$ptvalue($p(string,"^",6)),1:"")_")"	// DPV2628=
	QUIT:op="TSQL_LTRIM_SYBASE" "$s("_val_"="""":"""","_val_"=$c(0):"""",$zstrip("_val_",""<W"")="""":"""",1:$zstrip("_val_",""<W""))"
	QUIT:op="TSQL_NEWID" "$System.Util.CreateGUID()"	// DPV2882=
	QUIT:op="TSQL_OBJECT_ID" "$$TSQLOBJECTID^%qarfunc("_val_$s(v'="":","_$$ptvalue(v),1:"")_")"	// DPV2746=
	QUIT:op="TSQL_OBJECT_NAME" "$s("_val_"="""":"""",1:$lg($g(^oddTSQL("_val_")),2))"	// DPV2726=
	i op="TSQL_PLUS" {	// DPV2624, DPV2658
			#;  If all arguments are varchar, use _, otherwise +
		n plusop,plusargs s plusop="_"	// Assume concat
		For i=4:1 { 
			s plusarg=$p(string,"^",i)
			q:plusarg=""
			s:$Case($$$VTRgetcat(plusarg),"STRING":0,:1) plusop="+"  // If not STRING, use +
			s $li(plusargs,i-3)=$$ptvalue(plusarg)
		}
		QUIT "$$TSQLPLUS^%qarfunc("""_plusop_""","_(i-4)_","_$ListToString(plusargs)_")"
	}
	QUIT:op="TSQL_RAND" "$$TSQLRAND^%qarfunc("_val_")"	// DPV2851=
	QUIT:op="TSQL_RTRIM_SYBASE" "$s("_val_"="""":"""","_val_"=$c(0):"""",$zstrip("_val_","">W"")="""":"""",1:$zstrip("_val_","">W""))"
	QUIT:op="TSQL_TEXTPTR" "$s("_val_"="""":"""",1:$lb("_val_","_$$ptvalue($$rowid^%qaqcct(irn))_"))"	// DPV2630=  TODO:  Implement it!
	i $p(op,"_")="TSQL" {	// DPV2620
		n func,ret s func="@@"_$$$LOWER($p(op,"_",2,*)) s ret=$lg($g(^%qSQL("tsql","p","p",func)))
		s:ret="" func=$e(func,3,*),ret=$lg($g(^%qSQL("tsql","p","p",func)))
		QUIT ret
	}
	QUIT:op="UCASE" "$zcvt("_val_",""U"")"
	QUIT:op="UNIXTIMESTAMP" "$zu(99)"
	QUIT:op="UNIXTIMESTAMPDATE" "$$UnixTimeStamp^%qarfunc("_val_")"
	// MJG195 combines these cases because they're exactly the same except for the specific $vop logic they generate
	if op="VECTOR_COSINE" || (op="VECTOR_DOT_PRODUCT") { 
		new checkedAtParser,val2, dt, param
		// If query has a %Library.Embedding field and an EMBEDDING funciton, store the modelName for use by EMBEDDING
		if (($e($$$mtV(arg2),1,11) = "v^EMBEDDING") && ($$$mtVType($$$mtV(arg1))="f")){
			do ddgetf(arg1, .dt, .param) 
			if (dt = "%Library.Embedding"){
				set mt("embeddingModelName", arg2) = param("MODEL")
			}	
		} elseif (($e($$$mtV(arg1),1,11) = "v^EMBEDDING") && ($$$mtVType($$$mtV(arg2))="f")) {
			do ddgetf(arg2, .dt, .param) 
			if (dt = "%Library.Embedding"){
				set mt("embeddingModelName", arg1) = param("MODEL")
			}
		}
 		set val2=$$ptvalue(v)
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		if "#$"[$e(val2) { do davalue(arg2) set val2=pti(arg2) }
 		// if both arguments correspond to either fields or query blocks, isvector/type/length checks already performed by parser
		set checkedAtParser = ("fq"[$$$mtVType($$$mtV(arg1)))&&("fq"[$$$mtVType($$$mtV(arg2)))
		if op="VECTOR_DOT_PRODUCT",checkedAtParser {
			// if type is decimal or double, use the faster $vop
			if "DECIMAL,DOUBLE,FLOAT"[$$$UPPER($$$smdColVectorDatatype(1,$$$VTRgetirn(arg1),$$$VTRgetifn(arg1))) { RETURN "$s("_val_"="""":"""","_val2_"="""":"""",1:$vop(""dot-product"","_val_","_val2_"))"}
			else { RETURN "$s("_val_"="""":"""","_val2_"="""":"""",1:$vop(""sum"",$vop(""v*"","_val_","_val2_")))" }
		} else {
			// MJG204 - Trap <ILLEGAL VALUE> errors on vector cosine caused by sqrt on negative values (negative values are due to integer overflow in the $vop("v*") operation)
			// Since we're doing this try/catch now, let's always do vector_cosine calculation in a procedure
			new checkedInOpen
			set checkedInOpen = 0
			// vector_cosine still gets a procedure block generated even when comparing two fields or query blocks so that we can include a try/catch. The 'checkedAtParser check
			// is so that we don't generate these length/type checks if they were already done at compile time for the vector_cosine. Same for the check below as well
			if ("fq"[$$$mtVType($$$mtV(arg1))) || ("fq"[$$$mtVType($$$mtV(arg2))), 'checkedAtParser {
				do checkVectorInOpen(arg1, arg2)
				set checkedInOpen = 1
			}
			// check whether arguments to vector functions are vectors and have matching length and stored datatypes ; MJG195, YWH014, YWH025
			new code s code=1
			set code(1)="(v1,v2) [] PUBLIC {" // v1, v2 = vector arguments
			set code(1)=code(1)_" RETURN:((v1="""")||(v2="""")) """"" // if either is NULL, return NULL
			set code(1)=code(1)_" set result = """""
			if 'checkedInOpen, 'checkedAtParser { 
				// convert the vector from a list-separated string in some compile modes
				if mt("sqlcomp")="%Runtime" {
					// if runtime mode is not logical, convert string to vector
					set code(1)=code(1)_" set:$zu(115,5)>0 v1=$s('$isvector(v1):$$tovector^%qarfunc(v1),1:v1),v2=$s('$isvector(v2):$$tovector^%qarfunc(v2),1:v2)"
				} elseif ",%ODBC,%EXTERNAL,"[(","_mt("sqlcomp")_",") { // allow comma string if ODBC or Text/Display mode
					set code(1)=code(1)_" set v1=$s('$isvector(v1):$$tovector^%qarfunc(v1),1:v1),v2=$s('$isvector(v2):$$tovector^%qarfunc(v2),1:v2)"
				}
				set code(1)=code(1)_" if '$isvector(v1) || '$isvector(v2) { do SQERror^%apiSQL(254,"_$$quoter($$$Text("Cannot perform vector operation on non-vectors","%SQL"))_")}"
				set code(1)=code(1)_" if $vop(""length"",v1) '= $vop(""length"",v2) { do SQERror^%apiSQL(257,"_$$quoter($$$Text("Cannot perform vector operation on vectors of different lengths","%SQL"))_")}"
				set code(1)=code(1)_" set vtype=$vop(""type"",v1)"
			 	set code(1)=code(1)_" if vtype '= $vop(""type"",v2) { do SQERror^%apiSQL(259,"_$$quoter($$$Text("Cannot perform vector operation on vectors of different datatypes","%SQL"))_")}"
				set code(1)=code(1)_" if ""string,timestamp""[vtype { do SQERror^%apiSQL(258,"_$$quoter($$$Text("Cannot perform vector operation on non-numerical datatypes","%SQL"))_")}"
			}
			if op = "VECTOR_COSINE" {
				// if type is decimal or double, use the faster $vop
				// otherwise, calculate vector length squared (dot product with itself) first
				set code(1)=code(1)_" try { if ""decimal,double,xf32""[$vop(""type"",v1) {set result = $s(v1="""":"""",v2="""":"""",1:$vop(""cosine-similarity"",v1,v2))} else {set vecLengthSquared = $s(v1="""":"""",v2="""":"""",1:($vop(""sum"",$vop(""v*"",v1,v1))*$vop(""sum"",$vop(""v*"",v2,v2)))),result = $s('vecLengthSquared:"""",1:$vop(""sum"",$vop(""v*"",v1,v2))/(vecLengthSquared**0.5))}}"				
				// if either of the vector is 0, the squared length will be 0, and vector_cosine result will be NULL
				set code(1)=code(1)_" catch ex { if ex.Name=""<ILLEGAL VALUE>"" { do SQERror^%apiSQL(261,"_$$quoter($$$Text("Cannot perform vector operation due to overflow error","%SQL"))_")} elseif ex.Name=""<DIVIDE>"" { set result = """" } else { THROW ex } }"
			} else { // VECTOR_DOT_PRODUCT
				// if type is decimal or double, use the faster $vop
				set code(1)=code(1)_" set result = $s(v1="""":"""",v2="""":"""",""decimal,double,xf32""[$vop(""type"",v1):$vop(""dot-product"",v1,v2),1:$vop(""sum"",$vop(""v*"",v1,v2)))"
			}
			set code(1)=code(1)_" RETURN result"
			set code(1)=code(1)_" }"
			RETURN "$$"_$$tagnam^%qaqcasl("s")_"("_val_","_val2_")"
		}
	}
	if op="XMLFUNC" { QUIT "$$XMLFunc^%qarfunc("_($$$VTRgetname(holdval)="XMLFOREST")_","_$$genargs($p(string,"^",4,*))_")" }
	if op="WEEK" {
		do CheckForDateConversion(1)
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		QUIT "$s("_val_"="""":"""","_val_"?0.1""-""1.7n||("_val_"?0.1""-""1.7N1"",""1.5N)||("_val_"?0.1""-""1.7N1"",""1.5N1""."".N):$$WeekOfYear^%qarfunc(+"_val_"),"_val_"?4n1""-""1.2n1""-""1.2n0.1"" "".e:$$WeekOfYear^%qarfunc($zdateh($p("_val_","" ""),3,,,,,-672045)),1:$$WeekOfYear^%qarfunc($zdateh("_val_",-1,,,,,-672045)))"
	}
	QUIT:op="XSQL_MATCHES" "$$XSQLMATCHES^%qarfunc("_val_","_$$ptvalue(v)_$s($p(string,"^",6)'="":","_$$ptvalue($p(string,"^",6)),1:"")_")"	// DPV3176=
	if op="YEAR" {
		do CheckForDateConversion(1)
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		//          null check        Logical %Date, $Horolog, $zts                                                                     Logical %TimeStamp
		RETURN "$s("_val_"="""":"""","_val_"?0.1""-""1.7n||("_val_"?0.1""-""1.7N1"",""1.5N)||("_val_"?0.1""-""1.7N1"",""1.5N1""."".N):+$zdate("_val_",3,,,,,-672045),1:+$zdate($zdateh("_val_",3,,,,,-672045),3,,,,,-672045))"
	}
	if op="CASE" || (op="CASE_AGG") {
		#;  CASE WHEN p4 THEN p5 WHEN p6 THEN p7 ... ELSE p8 END
		#;  i p4 {
		#;  s v=p5 } else {
		#;  i p6 {
		#;  s v=p7 } else {
		#;  ...
		#;  s v=p8 } ... }  ;  return 'v'
		#;  NOTE: each pi (i=4,5,...8) might be preceeded by one or
		#;        more lines with SET of variables used within pi
		n cbs,davals  ;  AK654+
		set cbs=""  ;  count/accumulate close braces needed at the end
		s davals=$$cgcGet^%qaqcasl("davals")  ;  save before 'NEW cgc'
		#;  mark final CASE result as 'already computed'
		d cgcApnd^%qaqcasl("davals",holdval_",")
		n cgc d cgcInit^%qaqcasl(),cgcSet^%qaqcasl("davals",davals)
		#;  come in with eval(p4) already evaluated in 'val'! 8-(
		for i5=4:2:$l(string,"^")-2 {  ;  eval(i5) already in 'val'
		  		#; after each case, reset davals: can't use codegen'd results of evaluating one
				#; case in the others, since each is guarded by an if
		  	$$$liin("i "_val_" {") s cbs=cbs_" }"
			$$$liin("s "_pti(holdval)_"="_$$ptvalue($p(string,"^",i5+1))_" } else {")
			#;  eval(p5/p7/...) can't affect the other cases
			do cgcSet^%qaqcasl("davals",davals)
			set val=$$ptvalue($p(string,"^",i5+2))
			s davals=$$cgcGet^%qaqcasl("davals")
		}
		$$$liin("s "_pti(holdval)_"="_val_cbs)
		RETURN pti(holdval)  ;  AK654-
	}
	QUIT:op="%EXACT" val ;
	#;for %EXTERNAL, if field (also type "n"?), use $p(2) instead of $p(1)
	#;  do it in 2 cases:  <x><op><var> - <var> gets <x>.datatype;  and
	#;    <field><op>%ODBCIN(<y>) - %ODBCIN(<y>) gets <field>.datatype
	#; QUIT:op="%ODBCIN" $$appmeth(val,"OdbcToLogical",holdval)
	if op="%ODBCIN" {
		if $e($g($$$mtV(arg1)))="x"||($e($g($$$mtV(arg1)))="t"&&($p($g($$$mtV(arg1)),"^",2,*)'="")) {
			#; %ODBCIN on non-NULL literal or a host variable, normalize it after OdbcToLogical conversion (DPV3170)
			QUIT $$appmeth($$appmeth(val,"OdbcToLogical",holdval),"Normalize",holdval)
		}
		QUIT $$appmeth(val,"OdbcToLogical",holdval)
	}
	if op="%RUNTIMEIN" {
		if $e($g($$$mtV(arg1)))="x"||($e($g($$$mtV(arg1)))="t"&&($p($g($$$mtV(arg1)),"^",2,*)'="")) {
			#; %ODBCIN on non-NULL literal or a host variable, normalize it after DIsplay/OdbcToLogical conversion (DPV3170)
			QUIT $$appmeth($$appmeth(val,"RuntimeToLogical",holdval),"Normalize",holdval)
		}
		QUIT $$appmeth(val,"RuntimeToLogical",holdval)
	}
	QUIT:op="%INTERNAL" val
	QUIT:(op="%INTEXT")!(op="%RUNTIMEOUT")!(op="%ODBCOUT")!(op="%EXTERNAL") $s(($e($$$mtV($p(string,"^",4)))="f")&&($g(rtpcHelperCode("caller"))=""):pti(holdval),1:$$opval^%qaqcpre(op,$p(string,"^",4),val))
	QUIT:(op="USER") "$Username"	// DPV2198
	  #;  code identical to l2pat^pop
	If op="%L2PAT" {
		s v="("_val_","_$s(v:"$e("_$$ptvalue(v)_")",1:"""""")_")"
		QUIT:$g(callname)[("view"_$c(1)) "$$L2PAT^%apiSQL"_v  ;  for CHECK/WHEN
		new collation, emptystring
		set collation = $p($$$mtV($p(string,"^",4)),"^",2), emptystring = $$gencoll^%qaqcpre(collation, "$c(0)")
		#;  NOTE:  If this code is updated, also update L2PAT^%apiSQL
		n code s code=1
		s code(1)="(s,e) [] PUBLIC {"
		s code(1)=code(1)_" QUIT:s="""" ""0E"" s p="""",u="""",q=1_$c(34,34)"
		s code(1)=code(1)_" f n=1:1 { s c=$e(s,n) q:c="""" "
		s code(1)=code(1)_" i ""_%""[c { s:""_""=c u=u+1 s:q'[""."" q=$e(""."",""%""=c)_""E1""_$c(34,34) }"
		s code(1)=code(1)_" else { s:c=e n=n+1,c=$e(s,n) s:c=$c(34) c=$c(34,34) s p=p_u_q,u="""",q="""",$e(p,$l(p))=c_$c(34) } }"
		#; MJG020 - if the pattern is a (collated) empty string, translate the internal representation $c(0) to ""
		s code(1)=code(1)_" if s="_emptystring_" { QUIT $tr(p_u_$p(q,1),$c(0),"""") } else { QUIT p_u_$p(q,1) } }"
		QUIT "$$"_$$tagnam^%qaqcasl("s")_v
	}
	#;  code identical to l2sw^pop
	If op="%L2SW" {
		QUIT:'v "$p($p("_val_",""%""),""_"")"
		s v="("_val_",$e("_$$ptvalue(v)_"))"
		QUIT:$g(callname)[("view"_$c(1)) "$$L2SW^%apiSQL"_v  ;  for CHECK/WHEN
		  #;  NOTE:  If this code is updated, also update L2SW^%apiSQL
		n code s code=1
		s code(1)="(s,e) [] PUBLIC { s p="""" f n=1:1 { s c=$e(s,n) q:""_%""[c  s:c=e n=n+1,c=$e(s,n) s p=p_c } QUIT p }"
		QUIT "$$"_$$tagnam^%qaqcasl("s")_v
	}
	If op="%L2PATAU" {
		s v="("_val_","_$s(v:"$e("_$$ptvalue(v)_")",1:"""""")_")"
		QUIT:$g(callname)[("view"_$c(1)) "$$L2PATAU^%apiSQL"_v  ;  for CHECK/WHEN
		#;  NOTE:  If this code is updated, also update L2PATAU^%apiSQL
		n code s code=1
		s code(1)="(s,e) [] PUBLIC {"
		s code(1)=code(1)_" s p="""",u="""",q=1_$c(34,34)"
		s code(1)=code(1)_" f n=1:1 { s c=$e(s,n) q:c="""" "
		s code(1)=code(1)_" i ""_%""[c { s u="".""_$s((""_""=c)&&(u'="".""):$e(u,2,*)+1,1:""""),q=""E1""_$c(34,34) }"
		s code(1)=code(1)_" else { s:c=e n=n+1,c=$e(s,n) s c=$ZU(28,c,6) s:c'="""" p=p_u_q,u="""",q="""",$e(p,$l(p))=c_$c(34) } }"
		s code(1)=code(1)_" s p=p_u_$p(q,1) QUIT:p="""" ""0E"" QUIT p }"
		QUIT "$$"_$$tagnam^%qaqcasl("s")_v
	}
	If op="%MATCHES2PAT" {			// DPV3541=
		s v="("_val_","_$s(v:"$e("_$$ptvalue(v)_")",1:"""""")_")"
		QUIT "$$PatternInformixToCOS^%qarfunc"_v
	}
	If op="%MATCHES2SW" {				// DPV3541=
		QUIT:'v "$p($p($p($p("_val_",""*""),""?""),""[""),""\"")"
		s v="("_val_",$e("_$$ptvalue(v)_"))"
		QUIT:$g(callname)[("view"_$c(1)) "$$MATCHES2SW^%apiSQL"_v  ;  for CHECK/WHEN
		  #;  NOTE:  If this code is updated, also update MATCHES2SW^%apiSQL
		n code s code=1
		s code(1)="(s,e) [] PUBLIC { set p="""" set:e="""" e=""\"" for n=1:1 { set c=$extract(s,n) quit:""?*[""[c  set:c=e n=n+1,c=$extract(s,n) set p=p_c } QUIT p }"
		QUIT "$$"_$$tagnam^%qaqcasl("s")_v
	}
	#; DPV1584
	set:op="/AGG" op="/"	// remove flag that says this is an aggregate from VAR_POP agg function
	#;  for AVG=SUM/COUNT, return NULL if all values are NULL
	d davalue(arg1)
	i arg2="" {
		if $$evalLiteral(pti(arg1),.targ1) {
			QUIT $s(targ1="":"""""",1:op_pti(arg1))
		} else {
			QUIT "$s("_pti(arg1)_"="""":"""",1:"_op_pti(arg1)_")"  // unary +-
		}
	}
	d davalue(arg2) 
	if op="/0" {
		RETURN "$s("_pti(arg2)_":"_val_"/"_pti(arg2)_",1:"""")"
	}
	#;  Must be + - * / \ or #
	s arg1=pti(arg1),arg2=pti(arg2)
	if $$evalLiteral(arg1,.targ1) {
		if $$evalLiteral(arg2,.targ2) {
			if targ1=""||(targ2="") QUIT """"""
			try {
				set targ1=$xecute("() Q "_arg1_op_arg2)
				RETURN targ1
			} catch {
				RETURN arg1_op_arg2
			}
		} else {
			If targ1="" QUIT """"""
			QUIT "$s("_$$notnull1(arg2)_"1:"_arg1_op_arg2_")"
		}
	} elseif $$evalLiteral(arg2,.targ2) {
		If targ2="" QUIT """"""
		QUIT "$s("_$$notnull1(arg1)_"1:"_arg1_op_arg2_")"
	} else {
		QUIT "$s("_$$notnull2(arg1,arg2)_"1:"_arg1_op_arg2_")"
	}
	#; DPV1584-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  $SELECT components to test that the arguments are not NULL
notnull1(v1) [] PUBLIC { QUIT v1_"="""":""""," } 								// DPV2093
notnull2(v1,v2) [] PUBLIC { QUIT v1_"="""":"""","_v2_"="""":""""," } 						// AK479
notnull3(v1,v2,v3) [] PUBLIC { QUIT v1_"="""":"""","_v2_"="""":"""","_v3_"="""":""""," } 			// DPV2093
notnull4(v1,v2,v3,v4) [] PUBLIC { QUIT v1_"="""":"""","_v2_"="""":"""","_v3_"="""":"""","_v4_"="""":""""," } 	// DPV2093
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
checkVectorInOpen(arg1, arg2) [mt] public {
	// if one is a field we know the length ahead of time and can do length and type check on the second vector during query OPEN to save time
	if $$$mtVType($$$mtV(arg1)) = "f" {
		set fieldArgIFN = $$$VTRgetifn(arg1),fieldArgIRN = $$$VTRgetirn(arg1)
		set runtimeCheckVal = arg2
	} else {
		set fieldArgIFN = $$$VTRgetifn(arg2),fieldArgIRN = $$$VTRgetirn(arg2)
		set runtimeCheckVal = arg1
	}
	set vdtype=$$$smdColVectorDatatype(1,fieldArgIRN,fieldArgIFN)
	// mt("vectorOpenChecks") = [v# of the value we need to length-check and type-check at runtime] ^ [length] ^ [datatype]
	set $$$mtVectorOpenChecks($i($$$mtVectorOpenChecksCount)) = runtimeCheckVal_"^"_$$$smdColVectorLength(1,fieldArgIRN,fieldArgIFN)_"^"_$s(vdtype["INT":"INTEGER",1:vdtype)
}
getJsonObjectValue(value,sqlcat) [mt] {
	if $case(sqlcat,"INTEGER":1,"NUMERIC":1,"DOUBLE":1,:0) { QUIT "$s("_value_"="""":""null"",1:"_value_")" }
		#; Everything else is a string...
	QUIT "$s("_value_"="""":""null"",1:$zu(144,1,"_value_"))"
}
.
	// Given ma mt("v") value, return the type of the value for the JSON_* value argument.
	// Types are:
	//   - Boolean = 2
	//   - numbers = 1
	//   - JSON_OBJECT = 3
	//   - JSON_ARRAY = 4
	//   - all others = 0
getJSONType(val) [mt] {
	RETURN:$$$VTRgetdt(val)="%Library.Boolean" 2
	RETURN:$case($$$VTRgetcat(val),"INTEGER":1,"NUMERIC":1,"DOUBLE":1,:0) 1
	set op=$p($$$mtV(val),"^",1,2)		
	RETURN:$case(op,"v^JSON_OBJECT":1,"v^JSON_OBJECT_ABSENT":1,:0) 3
	RETURN:$case(op,"v^JSON_ARRAY":1,"v^JSON_ARRAY_ABSENT":1,"v^JSON_ARRAY_AGG":1,:0) 4
	RETURN:$e(op)="q" $$getJSONTypeQueryBlock(val)
	RETURN 0
}
.
getJSONTypeQueryBlock(val) [mt] {
	set queryBlock = $p($$$mtV(val),"^",2)
	set aggsList = $$$mtPAggList($$$mtP(queryBlock))
	RETURN:$l(aggsList,",")'=2 0
	RETURN:$data(mt("jsonarrayagg",$p(aggsList,",",1))) 4
	RETURN 0
}
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
genargs(vals) n args,i5,val  ;  generate actual argument list, vals=={val^}*
	s args=""
	f i5=1:1 s val=$p(vals,"^",i5) q:val=""  s args=args_","_$$ptvalue(val)
	QUIT $e(args,2,*)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
extfunc ; Extrinsic Function.  Build up the parameters
	n op,val,i5,i,string2,specialArg,start  ;  (string implicit)  JMM996
	s op=$p(string,"^",5,6),string=$p(string,"^",4),val=""
	s start=1
	if $e(op,1,17)=$$$SSShardMapScreenExtFunc { // JMM996+ JMM1073=
		#; JMM996: Dummy shard map screening external function, used in shard-local
		#; queries while rebalancing is in progress.
		#; First argument is a literal string of the format "*<shard-map-owner>*<shard-map-type>*".
		#; We need to avoid ptvalue translating this to a variable name, so this literal
		#; is available in condop for generating shard map screening code.
		s string2=$$$mtV($p(string,",",1))
		s specialArg=$p(string2,"^",2)
		if $e(specialArg,1,1)="*" {
			s val=val_","""_specialArg_""""
			s start=2
		}
	} // JMM996-
	f i5=start:1 s i=$p(string,",",i5) q:i=""  s val=val_","_$$ptvalue(i) // JMM996 JMM1073
	if $e(op,1,17)=$$$SSShardMapScreenExtFunc { // JMM996+
		#; JMM996: Dummy shard map screening external function, used in shard-local
		#; queries while rebalancing is in progress.
		#; Second argument is 1st shard key field. Get stream number from that,
		#; and make it dummy first argument, so shard screen mapping code generation
		#; in condop knows stream number for looking up mt("shref",<streamnumber>),
		#; needed for extended reference for remote shard map, if query contains non-cosharded join.
		$$$SNRBDebugTrace("extfunc^%qaqcpr string:",$g(string)) // JMM1152=
		s val=" *"_$p($g($$$mtV($p(string,",",2))),"^",2)_"*,"_$e(val,2,*)
		$$$SNRBDebugTrace("extfunc^%qaqcpr val:",val) // JMM1152=
	} // JMM996-
	QUIT "$$"_op_"("_$e(val,2,*)_")"
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
opex(val)  ;  streamless expr is computed once, at OPEN time
	s:opex'[(","_val_",") opex=opex_val_","
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
scratch(&val,tmp=0,name="") [mt,pti,cflag] PUBLIC { ; generate a run-time scratch variable, if tmp=1 use a local if not %msqlvar="i%%", name is optional variable name
	Set val = $$$newval("i")
	If name="" { Set name="scratch"_val } Else { Set name=name_":"_val }
	Do addpti^%qaqutility(name,val,0,0,0,tmp)
	RETURN pti(val)
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; FROM old %aaapre1 ; Continuation from %aaapre
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
subq	;  subquery
	n line
	#; Ensure that any referenced expressions are evaluated, and
	#; that any expressions requiring re-evaluation are flagged as such
	d evalReferencedExpressions($p($$$mtV(val),"^",2))
	d reevalReferencedExpressions($p($$$mtV(val),"^",2))
	n ref s ref = $$callsub(val,mod)
	d cgcApnd^%qaqcasl("davals",val_",") ; add this val to davals list
	if ref'="" { d setSubqn^%qaqcpre(val, pti(val), $e(ref,1,*-1)) }
	QUIT pti(val)  ;  quit with the subquery result variable
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; Generate code for combined subquery cache, this is not enabled for svso case
subqcache(var,oldmod,oldm="") [mt,pti] {
	set val=$$$mtV(var)
	set subqs=$piece(val,"^",4),tfn=$piece(subqs,","),subqs=$piece(subqs,",",2,*)
	#; return pti(var) if all the subqueries have been computed on APE workers so that we won't compute them again
	If $g(oldmod)&&$g(oldm)&&$$$isParentModule(oldmod,oldm) {
		Set AllEvaluatedOnWorkers = 1
		for i=1:1:$l(subqs,",")-1 {
			set subq=$piece(subqs,",",i)
			If ((","_$g($$$mtAPEWorkerOutputs(oldm))_",")'[(","_subq_",")) {
				Set AllEvaluatedOnWorkers = 0
				Quit
			}
		}
		Return:AllEvaluatedOnWorkers pti(var)
	}
	set tfn=$piece($$$mtV(tfn),"^",2,*)
	do initemp^%qaqcasl(tfn,0)
	set icols=$$distlist($E($p(val,"^",3),2,*))
	set call="",outlist="",extlist="",extcode=""
	for i=1:1:$l(subqs,",")-1 {
		set subq=$piece(subqs,",",i)
		#; skip this subq if its value has been computed on APE workers
		Continue:$g(oldmod)&&$g(oldm)&&$$$isParentModule(oldmod,oldm)&&(((","_$g($$$mtAPEWorkerOutputs(oldm))_",")[(","_subq_",")))
		#; Ensure that any referenced expressions are evaluated, and
		#; that any expressions requiring re-evaluation are flagged as such
		do evalReferencedExpressions($p($$$mtV(subq),"^",2))
		do reevalReferencedExpressions($p($$$mtV(subq),"^",2))
		set v=$$$mtV(subq),qn=$p(v,"^",2)
		//subquery main module
		set mod = $$$mtPFirstASLModule($$$mtP(qn))
		Set mod=$select(mod=$$$topWorkerModule(qn):$$$topParentModule(qn),1:mod)
		//output variable for subquery
		set out = pti(subq)
		do buildcaller^%qaqcasl(mod,oldmod)
		//arguments in the q^ node: correlated values, a ^ list of "n" nodes.
		s args=$p(v,"^",4,*)
		#;  generate formal and actual parameter lists
		set call=call_" s "_out_"="""" d "_$$modpre^%qaqcasl(mod)_"Mod"_"(",fl="("
		f jj=1:1 s fval=$p(args,"^",jj) q:fval=""  s call=call_pti($p($$$mtV(fval),"^",4))_",",fl=fl_pti(fval)_","
		s $e(call,*)=")",$e(fl,*)=")",mt("tempmod",mod)=fl
		set outlist=outlist_out_","
		set extlist(i)=out
	}
	set var1=$$onesub(icols)  ;  variable used for the single subscript
	#;  if single nullable field, use subscript variable with NULL-marker
	if $$distnull(icols) {
		$$$liin("s "_$$$getVarName("nsub"_+icols)_"="_$$tomark(var1))
		set var1=$$$VarName("nsub"_+icols)
	}
	set ref=$$tfref^%qaqcpre(tfn,1,1)_var1_")" ; readWriteMode=1 to indicate a write into the local temp-file in case it's a non-DISTINCT hybrid
	set refForRead=$$tfref^%qaqcpre(tfn,1,3,var1,"'$d(",","_$$$getVarName("qcachetmp")_")") ; var1 is a subscript (list), $$$getVarName("qcachetmp") is a suffix, readWriteMode=3 to indicate a read in case it's a non-DISTINCT hybrid
	set outlist="$lb("_$e(outlist,1,*-1)_")"
	#;  if subscript will never overflow, save new value in temp-file
	s isLocalArr = ('$$glotf^%qaqcpre(tfn)), subLimit = $s(isLocalArr:32766,1:120)
	if $$GenExtract^%GenerateExtract(.extcode,"",$LB($$$getVarName("qcachetmp"),$$$getVarName("sqltmp"),$$$getVarName("sqlpos")),.extlist,"","",1)<0 Ztrap "ExtErr"
	i $$short^%qaqcpre(icols,,isLocalArr) {
		$$$liin("i "_refForRead_" {"_call_" s "_ref_"="_outlist_" } else {")
	} else {
		#;  must check at run-time whether short or not
		$$$liin("i $l("_var1_")>"_subLimit_"||"_refForRead_" {"_call_" s:$l("_var1_")'>"_subLimit_" "_ref_"="_outlist_" } else {")
	}
	for i=1:1:extcode set line=extcode(i) $$$liin(.line,,1)
	$$$liin("}")
	d cgcApnd^%qaqcasl("davals",var_subqs) ; add these val to davals list
	QUIT ref
}
	#; Generates a subquery call for the q^ node val.
	#; Returns a reference to the cached tempfile result slot ("^||%t(...)"), or "" if
	#; no tempfile is used because the subquery is streamless (has no correlated values)
callsub(val,oldmod) [ mt, pti, asl, m ] PUBLIC {
.
	set v = $$$mtV(val)
	set qn = $p(v,"^",2)
	if '$d(m) { set m=qn }	// m could be undefined if ptvalue is called dfrom colset^%qaqcmn.  sub-queries are not allowed in insert column values, but this avoids an <UNDEFINED>
.
	if $$$isWorkerModule(oldmod, m) {
			#; For query block using Adaptive Parallel Execution (APE), there is no need to call the subquery 
			#; if the result of the subquery will be passed to the workers from the parent process
		RETURN:(","_$lts($$$mtAPESharedParentVars(m))_",")[(","_val_",") ""
	}
	//subquery main module
	set mod = $$$mtPFirstASLModule($$$mtP(qn))
	if $$$isWorkerModule(mod, qn) { set mod=$$$topParentModule(qn) }
		//output variable for subquery
	set out = pti(val)
		//tempfile slot reference for output (if any)
	set ref = ""
	do buildcaller^%qaqcasl(mod,oldmod)
	set call="s "_out_"="""" d "_$$modpre^%qaqcasl(mod)_"Mod"
		//svso structure, if any
	set svso = $g(mt("svso",qn))
		#; Ensure that each outer reference has been evaluated (could be an expression)
	if svso'="" && ($lg(svso,2)[",") || (",=," [ (","_$p($lg(svso,2),",",1)_",")) {
		do settemp^%qaqcpre($tr($li(svso,3),"^",","))  // This generates 's expr<i>=...' for eqch pqb expression i
	}
	set icols=$$distlist($E($p(v,"^",3),2,*))
	if icols="" {
			#; Not correlated - run once
		If $$initializeOnceVal(val,oldmod) {
			$$$liin($$once("subonce"_+val)_call) ; uses m while calling null^%qaqcasl
		}
		
			#; If the subquery has become decorrelated as a result of an svso transformation,
			#; then create a temp file reference here.
		if ($d(mt("svso",qn))) 
		{
			set tfn=$$$aslActTfToBuild($$$aslAct($p($g($$$mtP(qn)),"^",6),1))
			if tfn {
				set ref=$$tfref^%qaqcpre(tfn,2,1) ; readWriteMode=1 to request a reference to the local temp-table in case this is a non-DISTINCT hybrid
			}
		}
		RETURN ref
	}
		//arguments in the q^ node: correlated values, a ^ list of "n" nodes.
	set args=$p(v,"^",4,*)
		#;  generate formal and actual parameter lists
	set call=call_"(",fl="("
	for jj=1:1 { set fval=$p(args,"^",jj) quit:fval=""  set call=call_pti($p($$$mtV(fval),"^",4))_",",fl=fl_pti(fval)_"," }
	set $e(call,*)=")",$e(fl,*)=")",mt("tempmod",mod)=fl
		#;  use temp-file - no $SORTBEGIN
	set tfn=$$$mtPTempFile($$$mtP(qn))
	set isSharedTf = $g($$$mtSharedGlobalTf(tfn))
	do initemp^%qaqcasl(tfn,0)
	set ref=$$tfref^%qaqcpre(tfn,1)
	set var1=$$onesub(icols)  ;  variable used for the single subscript
		#;  if single nullable field, use subscript variable with NULL-marker
	if $$distnull(icols) {
		$$$liin("s "_$$$getVarName("nsub"_+icols)_"="_$$tomark(var1))
		set var1=$$$VarName("nsub"_+icols)
	}
	set ref=ref_var1_")"  ;  complete global reference
		#;  if subscript will never overflow, save new value in temp-file
	set isLocalArr = ('$$glotf^%qaqcpre(tfn)), subLimit = $s(isLocalArr:32766,1:120)
.
	if $$short^%qaqcpre(icols,,isLocalArr) {
		if isSharedTf {
			$$$liin("If '$d("_ref_","_out_") {")
			$$$liin("  Lock +"_ref)
			$$$liin("  Try {If '$d("_ref_","_out_") "_call_" Set "_ref_"="_out_"} Catch {Lock -"_ref_"#""I"" Throw}")
			$$$liin("  Lock -"_ref_"#""I""}")
		} else {
			$$$liin("i '$d("_ref_","_out_") "_call_" s "_ref_"="_out)
		}
	} else {
		#;  must check at run-time whether short or not
		if isSharedTf {
			$$$liin("If $l("_var1_")>"_subLimit_"||'$d("_ref_","_out_") {")
			$$$liin("  Lock +"_ref)
			$$$liin("  i $l("_var1_")>"_subLimit_"||'$d("_ref_","_out_") "_call_" s:$l("_var1_")'>"_subLimit_" "_ref_"="_out)
			$$$liin("  Lock -"_ref_"#""I""}")
		} else {
			$$$liin("i $l("_var1_")>"_subLimit_"||'$d("_ref_","_out_") "_call_" s:$l("_var1_")'>"_subLimit_" "_ref_"="_out)
		}
	}
	RETURN ref
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
distlist(list) n dl,jj,val  ;  $$:  remove duplicates from LIST(val,)
	f jj=1:1 s val=$p(list,",",jj) q:val=""  s $p(dl,"^",val)=val_","
	QUIT $tr($g(dl),"^")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF456
subvaluesAvailable(mod,baseFld,flds)
	n i,foundUnavailableRef,tItem,tElemType,tSub
	n ifn,uncIfn,fld,uncFld
	n irn,m,str,v,imp,tmpimp,idata
	
	#; In the bsl case, if mstep>2 then we are beyond the subscript level, and all
	#; that could be available is the rowid, which is not a collection.  Therefore,
	#; if in the bsl case and in the postkey evaluation, then we can't get the 
	#; collection values from subscript
	#;
	Quit:(mstep=1) 0							; not available from *this* module
	Quit:((mstep>2)&&($g($$$aslKRoot(mod))="bsl")) 0	; after bsl, only ID is available
	
	#; If checking distinct in postkey prior to this cond, collection subvalue
	#; previously looped on might have been lost.
	If mstep=3 {
		For i=1:1:ndata-1 { RETURN:$d($$$aslPkDist(mod,3,i)) 0 }
	}
	
	Set foundUnavailableRef = 0
	For i=2:1
	{	Set fld = $p(flds,",",i) Quit:fld=""
		Set v = $$$mtV(fld), str = $p(v,"^",2), ifn = $p(v,"^",3)
		Continue:ifn'["%ANYOF"
		If baseFld = $e(ifn,$find(ifn,$s(ifn["%ANYOFKEY":"%ANYOFKEY",1:"%ANYOF")),*)
		{	
			Set v = $$$mtR(str), irn = $p(v,"^",1), m = $p(v,"^",2)
			Set tElemType = $s(ifn["%ANYOFKEY":"K",1:"E")
			
			#; If this is a collated %ANYOF, then get the field number of the uncollated %ANYOF
			#;
			If $Length(ifn,"_")=3
			{	Set uncIfn = $p(ifn,"_",1)_"_"_$p(ifn,"_",3)
				Set uncFld = $p($g(mts(m, str, "ATT", uncIfn)),"^",5)
			}
			Else
			{	Set uncIfn = ifn
				Set uncFld = fld
			}
			
			#; Is fld or uncFld in subscript of the current asl module?
			#;
			Set tItem="",tSub="",idata=""
			Set tItem=$s((mstep=2)&&($g($$$aslKRoot(mod))="bsl"):ndata,1:1)	; ndata, passed implicitly by %qaqcbsl, is the current bsl item
			Set imp = $p($g($$$aslKId(mod,tItem)),$c(1),2)
			Set tmpimp = $s(imp="":"",1:$g(mt("smdimp",imp)))
			If tmpimp'=""		; tItem is not a collection map
			{	Set tSub="" For  Set tSub = $o($$$aslKNext(mod,tItem,tSub),1,v) q:tSub=""  Continue:v=""  If (","_fld_","_uncFld_",")[(","_$p(v,$c(1))_",") { Quit }
				If tSub=""
				{
					#; Not in subscript.  Is fld or uncFld available in node data from the current map?
					#; If present in node data, it will appear in $$smd as the collection fld, marked 
					#; with a KEY or ELEMENT subvalue flag
					#;
					s idata="" f  s idata=$o($$$smd(12,tmpimp,7,idata)) q:idata=""  quit:(+fld=$lg($$$smd(12,tmpimp,7,idata),1) && (tElemType=$lg($$$smd(12,tmpimp,7,idata),6)))
				}
			}
			If tSub="" && (idata="")
			{	Set foundUnavailableRef = 1 
				Quit 
			}
		}
	}
	QUIT 'foundUnavailableRef
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF456-
getifn(val)  ; Get the 'ifn' given the 'val' in the parse tree
	QUIT:$e($g($$$mtV(val)))="f" $p($$$mtV(val),"^",3)
	QUIT:(",v,e,n,"[(","_$e($g($$$mtV(val)))_",")) $$getifn(+$p($$$mtV(val),"^",4))
	QUIT ""  ; NO 'ifn' to find
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; From old %aaapre2 ; Continuation from %aaapre*
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cond(log)  ;  $$:  Return the Expression of the log# - without the IF.
	#;  Unless atomic, the returned expression must be in Parenthesis.
	#;  This is very recursive - so watch out!
	#;------------------------------------------------------------
	RETURN:$lf($g(mt("eval")),-log) $$$getVarName("log"_(log))  ;  logical value variable  ;  AK1049
	RETURN:$lf($g(mt("invar",$g(mod,0))),-log) $$$getVarName("log"_(log))
	n buf,cond,funcsrc,i5,ii,op,oper,string,val4,xlinenum,aoi,baseFld
	s xlinenum=1,string=$$$mtL(log),baseFld=""
	//Create a new context for evaluation if none exists
	#;  i '$$cgc^%qaqcasl() { n cgc d cgcInit^%qaqcasl() }  ;  TRW1449  ;  removed by AK1090
	#; ------ Must be a comparison of 2 values ------
	s op=$p(string,"^",2)	
	#; JLF015
	#;  Generate the BuildValueArray loop for %ANYOF conditions that were not fully index-satisfied.
	f aoi=$ll($g($$$mtAnyOfVals(log))):-1:1 { if '$d(mt("anyofInProgress",$li($$$mtAnyOfVals(log),aoi))) { s baseFld=$li($$$mtAnyOfVals(log),aoi) quit }}
	QUIT:((baseFld="")&&(op="ANYOFAND")) $$logic()		// if not marked in mt("anyof",log), then just process it like an ordinary AND
	QUIT:((baseFld'="") && '$$subvaluesAvailable(mod,baseFld,$p(string,"^",3))) $$genAnyof^%qaqcpre(log,baseFld,$s((op="ANYOFAND")&&(aoi=1):1,1:0))
	QUIT:$e(string)="l" $$logic()  ; Process the logic tree
	QUIT:"%ANYOF,%ANYOFKEY"[op $$cond($p(string,"^",4))		// look through the %ANYOF when applied to a user defined function
	#; JLF015-
	#; AK610
	#;  op = TOP : <op> [ . <op> ]
	i $e(op,1,4)="TOP:" {
		n m s m=$li(mt("topm"),log),ii=$s($$$isWorkerModule(mod,m):$$$mtAPETopLimitWorkerTF(m),1:$$$mtTopTempFile($$$mtTopLimit(m)))
		s cond="(("_$$$getVarName("limit"_ii_"sub1")_"="""")",$e(op,1,4)=""
		f i5=1:1:$L(op,".") s cond=cond_"||"_$$condop($$tomark($$davalue($p(string,"^",i5+3))),$p(op,".",i5),$$$getVarName("limit"_ii_"sub"_i5))
		QUIT cond_")"
	}
	#; AK610-
	#; AK470
	#;  set conditions:
	#;  v^[']EMPTY^^s^  (not used for now)
	i op["EMPTY" QUIT "($d("_$$setval($p(string,"^",4))_")"_$s(op="EMPTY":"<",1:">")_"9)"
	#; AK797
	s:op="INSET" op="ONEOF"
	#;  v^ONEOF^^v^s^  - whether v is in the set s
	#;  v^'ONEOF^^v^s^  - (not used for now, unclear whether needed)
	#; AK800
	QUIT:(op="ONEOF")&&($e($$$mtV($p(string,"^",5)),1,11)="v^SET:LIST^") "$lf("_$$ptvalue($p($$$mtV($p(string,"^",5)),"^",4))_","_$$ptvalue($p(string,"^",4))_")"
	i op["ONEOF" QUIT $p(op,"ONEOF")_$$oneof("$d("_$$adsub($$setval($p(string,"^",5)),$$tomarkval($p(string,"^",4)))_")",$p(string,"^",4))
	#; AK470-
	i op="FOR SOME",$p(string,"^",5)'="" d settemp^%qaqcpre($p(string,"^",5))  ; This generates 's expr1=...' for subquery
	#; JLF005
	#; Set-Valued Subquery Optimization
	#; 
	#; 	 Piece 4 is the val of the subquery
	#; 	 Pieces 5.. are the vals from the parent query block to compare to the subquery outputs
	#; 	 When davalue returns, pti(val)	contains the variable name that holds the run-time value of the val
	#; 	
	QUIT:(($e(op,1,7)="EXISTS:") || ($e(op,1,10)="NOTEXISTS:")) $$svso^%qaqcpre()
	#; JLF005-
	if op="IN" {
		new ffound set ffound=0
		for i5=5:1:$l(string,"^")-1 {
			set ffound=$$findtree^%qaqpnl("v",$p(string,"^",i5),"f")
			quit:ffound
		}
		#; Simple case to avoid evaluating streamless arguments multiple times
		RETURN:'ffound "$listfind("_$$ptvalue($$$newval("v^LISTBUILD^,^"_$piece(string,"^",5,*),0,1))_","_$$ptvalue($p(string,"^",4))_")"
		set val4=$$davalue($p(string,"^",4))
		s cond=""
		f i5=5:1:$l(string,"^")-1 d
		. s buf="("_val4_"="_$$ptvalue($p(string,"^",i5))_")"
		. i ($L(cond)+$L(buf))<3000 s cond=cond_"||"_buf
		. e  d addline
		i xlinenum>1 d
		. s funcsrc(xlinenum+1)=" q 0" 
		. s cond=cond_"||$$"_$$subroutn^%qacsub("funcsrc","",1,1)_"()"	// DPV3122
		RETURN "("_$extract(cond,3,*)_")"
	}
	s val4=$$ptvalue($p(string,"^",4))
	QUIT:op="FOR SOME" val4
	#; AK481
	#;  if collated, collate NULL
	#; DPV1799
	QUIT:op["NULL" "("_val4_$s(op["'":"'",1:"")_"="_$$colnul($p(string,"^",4),1,val4,op["'")_")"	// DPV3047
	#; AK481-
	if op["JSON" { QUIT "("_$s(op["'":"'",1:"")_"$$isJSON^%qarfunc("_val4_$s(op["*":","""_$e($p(op,"*",2))_"""",1:"")_"))" }
	#; AK377
	#;  method call - get code, generate subroutine, call with arguments
	if $e(op,1,7)="METHOD:" {
		set op=$p(op,":",2)
		new cls,dt,ifn,irn,param,prop
		do ddgetf($p(string,"^",4),.dt,.param,.cls,.prop,.irn,.ifn)
		QUIT $$genmeth($p(op,".",1,*-1),$p(op,".",*),.param,$$genargs($p(string,"^",4,*)),cls,prop,,,irn,ifn)
	}
	#;i $e(op,1,7)="METHOD:" s op=$p(op,":",2) QUIT $$genmeth($p(op,".",1,$l(op,".")-1),$p(op,".",$l(op,".")),,$$genargs($p(string,"^",4,*)))
	#;  extrinsic function call
	QUIT:$e(op,1,7)="EXTFUN:" "$$"_$TR($p(op,":",2),".","^")_"("_$$genargs($p(string,"^",4,*))_")"
	#; AK377-
	set cond=$$ptvalue($p(string,"^",5))
	#; AK412
	if op="%PATTERN" {
		new collation,emptystring,operand
		set op=$$$mtV($p(string,"^",5))
		set operand=$$$mtV($p(string,"^",4))
		set collation=$p($p(operand,"^",3),"_",2)
		set emptystring=$$gencoll^%qaqcpre(collation,"$c(0)")	// collected empty string expression
			#; if the argument to %PATTERN is the literal SQL empty string, just check if the value is equal to the SQL empty string
			#; This can be seen if TSQL dialect has: expr LIKE ''
		if op=("t^"_$c(0)) { RETURN "("_val4_"="_emptystring_")" }
			#; MJG020 - if field value is just (collated) empty string use actual "" empty string to avoid internal $c(0) representation from matching as a character
		RETURN "($s("_val4_"="_emptystring_":"""_$$applycollation^%qaqcoutlier(collation,"")_""",1:"_val4_")?"_$S($E(op)="t":$p(op,"^",2,*),1:"@("_cond_")")_")"
 	}
	if op="%MATCHES" set op=$$$mtV($p(string,"^",5)) quit "("_val4_"?"_$select($extract(op)="t":$piece(op,"^",2,*),1:"@("_cond_")")_")"	// DPV3541=
	#; Foreign tables don't rewrite a LIKE condition, but the condition still might not get pushed, if so then evaluate the LIKE condition straight up
	#; The logic is similar to %PATTERN except that we'll generate the L2PAT on the fly here
	i op="LIKE" {
		new collation, emptystring, esc, operand, patternVal
		#; The 5th arg for LIKE is the val # of the pattern. We will create a new val entry for L2PAT of this pattern and 
		#; then immediately get the runtime var name it will be stored in. Will always be referenced via @ indirection in the CQ
		set operand = $$$mtV($p(string,"^",4)), collation = $p($p(operand,"^",3),"_",2), esc = $p(string,"^",6)
		set:esc'="" esc = esc_"^"
		#; $$$newval adds entry to pti
		set patternVal = $$$newval("v^%L2PAT^^"_$p(string,"^",5)_"^"_esc,0,1)
		do opex(patternVal) // this marks the pattern so it's only evaluated once in the OPEN
		set emptystring = $$gencoll^%qaqcpre(collation,"$c(0)")
		#; MJG020 - if field value is just (collated) empty string use actual "" empty string to avoid internal $c(0) representation from matching as a character
		q "($s("_val4_"="_emptystring_":"""_$$applycollation^%qaqcoutlier(collation,"")_""",1:"_val4_")?@("_pti(patternVal)_"))"
	}
	#; AK470
	i op="%STARTSWITH",$$ddname() GOTO sw  ;  %STARTSWITH on %Name datatype
	RETURN:op["%SETINCHUNK" $e("'",op["'")_"$bit("_cond_","_val4_"#64000+1)"  ;  AK690
	i op="NCNUL" { ; YCL260 set Not Contains Null
		new arrVal,arrV,setOp,nValue
		set arrVal=$p(string,"^",4),arrV=$$$mtV(arrVal),setOp=$p($p(arrV,"^",2),":",2,*)
		set nValue=""""""
		if ($$$SQLCOLLATIONS[(","_$p(setOp,"(",1)_","))||($$$ISENCODEDCOLLATE($p(setOp,"(",1))){
			if $$$ISENCODEDCOLLATE($p(setOp,"(")) {
				new parm1,parm2
				do decodeCollate^%qaqcpre(setOp,.parm1,.parm2)
				set nValue = """"_##class(%Library.Collation).Collate("",parm1,parm2)_""""
			} else {
				set nValue = $s(setOp="":""""""," %SQLSTRING %SQLUPPER %SPACE %STRING "[$p(setOp,"("):""" """,v="%MVR":""" 5"""," %PLUS %MINUS "[setOp:0,1:"""""")	
			}
		}
		RETURN "($d("_$$ptvalue(arrVal)_")&&('$d("_$$adsub($$ptvalue(arrVal),$s(nValue="""""":$$$NULLSubscriptMarker19q,1:nValue))_")))" ; YCL271 - Check if this set exists for NCNUL
	}
	QUIT $$condop(val4,op,cond)
	#; AK470-
	#; IN condition moved up before we define val4
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK684
oneof(dod,fval)  ;  $$:  TRY to CATCH(<SUBSCRIPT>) in a "prequel" line, but if
	#;  fval short (also check MAXLEN?), just use dod=$D(arr(fval))
	QUIT:",INTEGER,NUMERIC,DOUBLE,DATE,TIME,TIMESTAMP,"[(","_$$$VTRgetcat(fval)_",") dod
	n vlog s vlog=$$$getVarName("log"_log)
	$$$liin("try { s "_vlog_"="_dod_" } catch { zt:$ze'[""<SUBSCRIPT>"" $ze s "_vlog_"=0 }")
	QUIT vlog
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK684-
	#; AK470
setval(val,forViewCheckOption=0)   ;  $$: construct set, return top node
		#;  *** note - does not handle reuse of set in >1 place - will reconstruct it
		#;  forViewCheckOption=1 if this is caled from cond^%qaqpDDLParser2.  In this case we want to NEW <var>, not kill it.
		#; AK530
		#;  set colnul only for the top SET expression
		#;   setnullmarker is the null marker to use for this entire set
	new arg,code,colnm,jj,op,ptval,string,var
	if $d($$$mtCollationNullMarker(val)) {
		new colnul,colnulq,setnullmarker
		set colnul=$$$mtCollationNullMarker(val),colnulq=$s(colnul="":$$$NULLSubscriptMarker19q,1:""""_colnul_"""")
		if colnul="" { set:'$d($$$mtNullMarker(val),setnullmarker) setnullmarker=$$$NULLSubscriptMarker19q }
		else { set setnullmarker=colnulq }
	}
		#; AK530-
	set:'$d($$$mtNullMarker(val),colnm) colnm=$g(setnullmarker)
	set string=$$$mtV(val),op=$e($p(string,"^",2),5,*),var=pti(val)
	set code=$s('forViewCheckOption:"k ",1:"n ")_var
		#;  streamless expression - see comments in ptvalue+23
	if opflag,$p(string,"^",3)=",",'$$findtree("v",val,"aqn"),'$$findWindowFunction(val) { do opex(val) RETURN var }
		#;  v^SET:UNION^^s^s^ - union of 2 sets - use MERGE
	if op="UNION" { $$$liin(code_" m "_var_"="_$$setval($p(string,"^",4))_","_var_"="_$$setval($p(string,"^",5))) RETURN var }
		#;  v^SET:INTX^^s^s^  - intersection of 2 sets
		#; AK811
	if op="INTX" { $$$liin(code_$$setlup($$setval($p(string,"^",4)))_" i $d("_$$adsub($$setval($p(string,"^",5)),"%sqlup")_","_$$adsub(var,"%sqlup")_")") RETURN var }
		#;  v^SET:SETOF^^v^v^v^v^ - makes a set out of the given scalars
	if op="SETOF" {
		for jj=4:1:$l(string,"^")-1 {
			set ptval=$$ptvalue($p(string,"^",jj))
			if ptval="""""" { set code=code_$s(colnm="":" s "_$$adsub(var,$$tomark(ptval))_"=""""",1:" s "_$$adsub(var,$$tomark(ptval,colnm))_"=""""") }  //NULL
			elseif ptval="$c(0)"||($e(ptval)=""""&&($e(ptval,*)="""")) { set code=code_" s "_$$adsub(var,ptval)_"=""""" }  // non-NULL literal or SQL empty string
			else { set code=code_$s(colnm="":" s:"_ptval_"'="""" "_$$adsub(var,ptval)_"=""""",1:" s "_$$adsub(var,$$tomark(ptval,colnm))_"=""""") }
			if $l(code)>($$$MaxRtnLineLength-50) $$$liin(.code)
		}
		if code'="" $$$liin(.code)
		RETURN var
	}
		#;  v^SET:LIST^^v^
	i op="LIST" {
		n ptrVar s ptrVar = $$localvar^%qaqcky(1, 'opflag)
		n valVar s valVar = $$localvar^%qaqcky(2, 'opflag)
		s arg = $p(string,"^",4) d davalue(arg) s arg=pti(arg)  ;  arg holds the run-time value of the $list
		$$$liin(code_" s "_ptrVar_"=0 while ($listnext("_arg_","_ptrVar_","_valVar_")) { "_"s "_$$adsub(var,"$s($g("_valVar_")="""":"_$$$NULLSubscriptMarker19q_",1:"_valVar_")")_"=""""}")	
		
		QUIT var
	}
		#;  it's a filtered subset:
		#;  v^SET:NULL^^s^
	if op="NULL" { $$$liin(code_" i $d("_$$adsub($$setval($p(string,"^",4)),$g(setnullmarker,$$$NULLSubscriptMarker19q))_","_$$adsub(var,$g(setnullmarker,$$$NULLSubscriptMarker19q))_")") RETURN var }
		#;  v^SET:'NULL^^s^
	if op="'NULL" { $$$liin(code_" m "_var_"="_$$setval($p(string,"^",4))_" k "_$$adsub(var,$g(setnullmarker,$$$NULLSubscriptMarker19q))) RETURN var }
		#; AK505
		#;  v^SET:collation^^s^
		#; BJB439
	
	if (($$$ISENCODEDCOLLATE($p(op,"(")))||(",%SQLSTRING,%SQLUPPER,%STRING,%SPACE,%PLUS,%MINUS,%MVR,%TRUNCATE,"[(","_$p(op,"(")_","))) {
		$$$liin(code_$$setlup($$setval($p(string,"^",4)))_" s "_$$adsub(var,$$gencoll^%qaqcpre(op,$$tonull("%sqlup")))_"=""""")
		RETURN var
	}
	if ",%ALPHAUP,%UPPER,%TRUNCATE,"[(","_$p(op,"(")_",") { 
		$$$liin(code_$$setlup($$setval($p(string,"^",4)))_$s(colnm="":" s:"_$$gencoll^%qaqcpre(op,$$tonull("%sqlup"))_"'="""" "_$$adsub(var,$$gencoll^%qaqcpre(op,$$tonull("%sqlup")))_"=""""",1:" s "_$$adsub(var,$$tomark($$gencoll^%qaqcpre(op,$$tonull("%sqlup")),colnm))_"="""""))
		RETURN var
	}
		#; BJB439-
		#; AK505-
		#; AK675
		#;  v^SET:~expr({ifn})^^s^ - subscript expression (pseudo collation)
	if $e(op)="~" { $$$liin(code_$$setlup($$setval($p(string,"^",4)))_" s "_$$adsub(var,$$expswap($e(op,2,*),$$tonull("%sqlup")))_"=""""") RETURN var }
		#; AK675-
		#;  any other operator (more improvements possible) - v^op^^s^v^
		#; AK674
		#;  use proper colnul, but NULL prefix is OK for %STARTSWITH
	set arg=$p(string,"^",5)
	do davalue(arg) $$$liin(code_$s(op="%STARTSWITH":"",1:" i "_pti(arg)_"'="""_colnul_"""")_$$setlup($$setval($p(string,"^",4)))_" i %sqlup'="_$g(setnullmarker,$$$NULLSubscriptMarker19q)_","_$$condop("%sqlup",op,pti(arg))_" s "_$$adsub(var,"%sqlup")_"=""""")
		#; AK674-
	RETURN var
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setlup(var)  ;  $$:  generate loop over elements of var
	d vNEW^%qaqcasl("%sqlup",'opflag)  ;  loop variable
	QUIT " s %sqlup="""" f  s %sqlup=$o("_$$adsub(var,"%sqlup")_") q:%sqlup="""" "
	#; AK811-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adsub(var,sub)  ;  $$:  add subscript sub to variable var
	QUIT $s($e(var,*)=")":$e(var,1,*-1)_",",1:var_"(")_sub_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
condop(p1,op,p2)  ; [public: shardMapNames, shardMapNumber] $$:  apply comparison p1 <op> p2
	#;  correct to use ]] in all cases, numeric and non-numeric alike
	QUIT:op[">" "("_p1_$e("'",op["'")_"]]"_p2_")"
	QUIT:op["<" "("_p2_$e("'",op["'")_"]]"_p1_")"
	QUIT:op="%STARTSWITH" $$swex(p1,p2)
	#; AK688
	#;  *** should pre-set p1,p2 into variables
	#;  *** should probably assign a separate variable for $isobject(p2)
	QUIT:op="%FIND" "$s($isobject("_p2_"):"_p2_".ContainsItem("_p1_"),1:"_p2_"=("_p1_"))"
	#;  QUIT:op="%FIND" ""_p2_".IsElement("_p1_")"
	#; AK688-
	if $e(p1,1,19)=("$$"_$$$SSShardMapScreenExtFunc) { // JMM996+
		#; JMM996: Dummy extrinsic function "IRISscreen^IRISsm" is place holder for shard map screening logic.
		#; The final line of code generated is a condition expression similar to others generated by condop,
		#; but one or more preceeding lines must be generated to copy a shard map into memory and
		#; compute the bucket number to screen against the shard map.
		#; Example of generated code for a SASK table:
		#; m:'$d(shmap(1)) shmap(1)=^|i%shrefT1|IRIS.SM.Shard("shardmaps",$g(%ISCSNShardMapVersion),"User.st1")
		#; s bucket=(i%ID\256000)+1
 		#; if bucket<=65279 {
		#; 	s bitval=$bit(shmap(1),bucket)
 		#; }
 		#; else {
 		#;	s segment=bucket\65279,bit=(bucket#65279)+1,bitval=$bit(shmap(1,segment),bit)
		#; }
 		#; i '(bitval=1) g %0AmBk1
 		#; Example of generated code for a UDSK table (with 2 shard key fields):
 		#;  s:'$d(shmap1) shmap1=$g(^IRIS.SM.Shard("shardmaps",$g(%ISCSNShardMapVersion),"||udsk"))
 		#;  s hash=0
 		#;  s hash=$zcrc($zu(28,i%%tData1,7),7,hash)
 		#;  s hash=$zcrc($zu(28,i%%tData2,7),7,hash)
 		#;  g:'($bit(shmap1,(hash#2048)+1)=1) %0AmBk1
		n mapOwner,mapType,streamNumber,shardMapName,args,arg,shardKeyField,shardKeyFieldCount,subscr2
		s streamNumber=$p(p1,"*",2)
		s mapOwner=$p(p1,"*",4)
		s mapType=$p(p1,"*",5)
		if $d(%ISCSNRemoteTables) {
			#; If query contains non-cosharded join, then each stream must use a distinct copy of its shard map,
			#; because they may be on different shards.
			s subscr2=streamNumber
		}
		else {
			#; Any streams which use the same shard map can share the same copy
			s subscr2=1
		}
		s shardMapName=$g(shardMapNames(mapOwner,subscr2))
		if shardMapName="" {
			if $d(%ISCSNRemoteTables)|| ($$$SSQueryRebalancingInProgress&&($g(mt("options","parallelQuery"))=1)) { // JMM1073
				#; If query contains non-cosharded join, keep all map copies under a single variable,
				#; so they can be killed when new shref values are set
				#; JMM1073: Also do this if this query uses parallel execution, and rebalancing is in progress
				s shardMapName="shmap("_$i(shardMapNumber)_")"
			}
			else {
				s shardMapName="shmap"_$i(shardMapNumber)
			}
			s shardMapNames(mapOwner,subscr2)=shardMapName
		}
		if $d(mt("shref",streamNumber)) {
			s shref=$$$getVarName("shref"_mt("shref",streamNumber))
			s extRefEnv="|"_shref_"|"
		}
		else {
			s extRefEnv=""
		}
		s args=$p(p1,"(",2)
		for ii=3:1 {
			s arg=$p($p(args,",",ii),")",1)
			q:(arg="")
			s shardKeyField(ii-2)=arg,shardKeyFieldCount=ii-2
		}
		if mapType=$$$SSShardMapTypeUDSK || (mapType=$$$SSShardMapTypeUDSKShardMorph) { // JMM1152=
			$$$liin("s:'$d("_shardMapName_") "_shardMapName_"=$g(^"_extRefEnv_$$$SSShardLocalGlobalName_"("""_$$$SSShardMapsSubscript_""",$g(%ISCSNShardMapVersion),"""_mapOwner_"""))")
			$$$liin("s hash=0")
			for ii=1:1:shardKeyFieldCount {
				$$$liin("s hash=$zcrc($zu(28,"_shardKeyField(ii)_",7),7,hash)")
			}
			s p1="$bit("_shardMapName_",(hash#"_$$$SSNumberOfHashBuckets_")+1)"
		}
		else { // SASK or COSK
  			$$$liin("m:'$d("_shardMapName_") "_shardMapName_"=^"_extRefEnv_$$$SSShardLocalGlobalName_"("""_$$$SSShardMapsSubscript_""",$g(%ISCSNShardMapVersion),"""_mapOwner_""")") // JMM1073
			$$$liin("s bucket=("_shardKeyField(1)_"\"_$$$SNIdRangeSize_")+1")
			$$$liin("if bucket<="_$$$SSSASKShardMapSegmentSize_" {")
			$$$liin($c(9)_"s bitval=$bit("_shardMapName_",bucket)")
			$$$liin("}")
			$$$liin("else {")
			// If shard map name contains a subscript, additional "segment" subscript must follow a comma, rather
			// than an open paren.
			s closeParenPos=$find(shardMapName,")")
			if closeParenPos {
				s segmentRef=$e(shardMapName,1,closeParenPos-2)_",segment)"
			}
			else {
				s segmentRef=shardMapName_"(segment)"
			}
			$$$liin($c(9)_"s segment=bucket\"_$$$SSSASKShardMapSegmentSize_",bit=(bucket#"_$$$SSSASKShardMapSegmentSize_")+1,bitval=$bit("_segmentRef_",bit)")
			$$$liin("}")
			s p1="bitval"
		}
	} // JMM996-
	// when both sides are vectors
	if $g(string)'="",($$$VTRgetcat($p(string,"^",4))="VECTOR")&&($$$VTRgetcat($p(string,"^",5))="VECTOR") {
		// if in logical mode, prevent comparing a vector field with a non-vector variable
		if ($$$VTRgettype($p(string,"^",4))="var")&&($$$VTRgettype($p(string,"^",5))="field") $$$liin("if $zu(115,5)=0,'$isvector("_p1_") { do SQERror^%apiSQL(267,"_$$quoter($$$Text("Cannot compare a vector field with a non-vector value","%SQL"))_")}")
		if ($$$VTRgettype($p(string,"^",5))="var")&&($$$VTRgettype($p(string,"^",4))="field") $$$liin("if $zu(115,5)=0,'$isvector("_p2_") { do SQERror^%apiSQL(267,"_$$quoter($$$Text("Cannot compare a vector field with a non-vector value","%SQL"))_")}")
	}
	// check vectors involved in equivalence, claim equivalence only when vector types match, lengths match, and $vop("v=") returns all 1's with total bit count matching the vector length
	// if inequality, add "'" in front of the condition
	QUIT:"'="[op&&($g(string)'="")&&($$$VTRgetcat($p(string,"^",4))="VECTOR")&&($$$VTRgetcat($p(string,"^",5))="VECTOR") $p(op,"=")_"($isvector("_p1_")&&$isvector("_p2_")&&($vop(""type"","_p1_")=$vop(""type"","_p2_"))&&($vop(""length"","_p1_")=$vop(""length"","_p2_"))&&($vop(""length"","_p1_")=$bitcount($vop(""v="","_p1_","_p2_"),1)))"
	QUIT "("_p1_op_p2_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK470-
.
tomarkval(icol) [mt] public { ; $$tomark($$ptval(icol)) unless icol can not be null
	RETURN:$$nullreplace^%qaqcct(icol) $$tomark($$ptvalue(icol),$g($$$mtNullMarker(icol)))
	RETURN $$ptvalue(icol)
}
.
 	// Convert a value to a null marker if null
	// called from this routine, %qaqcct, %qaqcdt, %qaqcpre, %qaqpDDLParser2
	// $$:  generate code:  $s(variable'="":variable,1:NULLMarker)
tomark(variable,nullmarker=$$$NULLSubscriptMarker19q) [] PUBLIC {
	set:nullmarker="" nullmarker=$$$NULLSubscriptMarker19q
	RETURN:variable="""""" nullmarker    // variable is "" (null)
	RETURN:$e(variable)=""""&&($e(variable,*)="""""") variable  // variable is a literal string
	RETURN:$isvalidnum(variable) variable     // variable is literal numeric
	RETURN:variable="$c(0)" variable
	RETURN "$s("_variable_"'="""":"_variable_",1:"_nullmarker_")"
}
.
	// Convert null marker to null if it is a null marker
	// Called from this routine and %qaqcky
	// $$:  generate code:  $s(variable'=NULLMarker:variable,1:"")
tonull(variable,nullmarker=$$$NULLSubscriptMarker19q) [] PUBLIC {
	RETURN:nullmarker="" variable
	RETURN "$s("_variable_"'="_nullmarker_":"_variable_",1:"""")"
}
	// Given a val 'v', return the value that represents NULL for this val
	// Typically, this will be "" or collation("")
colnul(v,QuoteIt=1,argval="",not=0) [mt] PUBLIC {	// apply v's collation (if a collated field) to NULL (unquoted)
	s v=$$$mtV(v)
	s:$p(v,"^",1,2)="v^%ODBCOUT" v=$$$mtV($p(v,"^",4))	// just one level, enough???
	s:$p(v,"^",1,2)="v^%RUNTIMEOUT" v=$$$mtV($p(v,"^",4))	// just one level, enough???
	if $e(v)="f" {
	#; AK750
		s ifn=$p(v,"^",3)  ;  maybe recurse to a collated view field
		QUIT:ifn'["_"&&$d($$$mtVirf(ifn),v)&&$li(v) $$colnul($li(v,2),QuoteIt,argval,not)
	#; AK750-
		If $d($$$smd(8,ifn),data) {  // Always quit with quotes the NULL stream oid pointer
			If $case($p(data,$c(1),2),-4:1,-1:1,:0) {
				QUIT:argval="" """"""  	// Don't need to check IsNull, or can't because we don't have the Oid value
	#; AK818
				QUIT """"""_$s(not:"&&'",1:"||")_"##class(%Stream.Object).StreamOIDIsNull("_argval_")"	// DPV3910 (StreamOIDIsNull)
			}
		}
		s v=$p($p(v,"^",3),"_",2)  ;  get the collation and apply to NULL
	} 
	else { s v=$p(v,"^",2) s:$e(v)'="%" v="" }
	
	if $$$ISENCODEDCOLLATE($p(v,"(")) {
		do decodeCollate^%qaqcpre(v,.parm1,.parm2)
		set nValue = ##class(%Library.Collation).Collate("",parm1,parm2)
		if QuoteIt { RETURN """"_nValue_ """" }
		RETURN nValue
	}
		#; PVA110: account for length parameter if v before testing collation category
	If QuoteIt QUIT $s(v="":""""""," %SQLSTRING %SQLUPPER %SPACE %STRING "[$p(v,"("):""" """,v="%MVR":""" 5"""," %PLUS %MINUS "[v:0,1:"""""")
	QUIT $s(v="":""," %SQLSTRING %SQLUPPER %SPACE %STRING "[$p(v,"("):" ",v="%MVR":" 5"," %PLUS %MINUS "[v:0,1:"")
}
.
addline ; generates a function body imitating '!' condition
	if xlinenum=1 { set funcsrc(xlinenum)=tagpre_"x"_datag_"()",datag=datag+1 }
	set xlinenum=xlinenum+1,funcsrc(xlinenum)=" i "_buf_" q 1"
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK668
	// Given a method name and a field value, return 1 if this field has the conversion method defined
	// Called from %qaqcasl, with meth values of LogicalToOdbc, LogicalToDisplay, and LogicaltoFDBMS
hasmeth(meth,fval)	//  $$: 1 if fval.meth() exists
	new irn
	set irn=$$$VTRgetirn(fval)
	goto:irn=""||($$$VTRgettype(fval)'="field") notfield
	new extent,ifn
	set extent=$$$smdExtent(1,irn)
	set ifn=+$$$VTRgetifn(fval)
	goto:'ifn notfield
	if extent="", $data($$$mtVirf(ifn)) { goto notfield } // DP-402646 if this is a virtual field, then following line throws an error
	goto:$g($$$EXTsqlmetadataversion($$$rEXT,extent),0)<1 notfield	// class compiled under an older version of the compiler where harvested code is not present in ^oddEXTR
		// collection fields are handled differently...
	if $$$smdColArrayCollection(1,irn,ifn)||($$$smdColListCollection(1,irn,ifn)="Y") { goto notfield }
	new fieldname
	set fieldname=$$$smdGetFieldName(ifn)
	QUIT:meth="LogicalToDisplay" $d($$$EXTSQLCOLLogicalToDisplay($$$rEXT,extent,fieldname))
	QUIT:meth="LogicalToOdbc" $d($$$EXTSQLCOLLogicalToOdbc($$$rEXT,extent,fieldname))
	QUIT:meth="LogicalToStorage" $d($$$EXTSQLCOLLogicalToStorage($$$rEXT,extent,fieldname))
	QUIT:meth="LogicalToFDBMS" $d($$$EXTSQLCOLLogicalToFDBMS($$$rEXT,extent,fieldname))
	QUIT:meth="DisplayToLogical" $d($$$EXTSQLCOLDisplayToLogical($$$rEXT,extent,fieldname))
	QUIT:meth="OdbcToLogical" $d($$$EXTSQLCOLOdbcToLogical($$$rEXT,extent,fieldname))
	QUIT:meth="StorageToLogical" $d($$$EXTSQLCOLStorageToLogical($$$rEXT,extent,fieldname))
	QUIT:meth="FDBMSToLogical" $d($$$EXTSQLCOLFDBMSToLogical($$$rEXT,extent,fieldname))
	QUIT:meth="LogicalToDate" $d($$$EXTSQLCOLLogicalToDate($$$rEXT,extent,fieldname))
	QUIT:meth="DateToLogical" $d($$$EXTSQLCOLDateToLogical($$$rEXT,extent,fieldname))
	QUIT:meth="LogicalToTimeStamp" $d($$$EXTSQLCOLLogicalToTimeStamp($$$rEXT,extent,fieldname))
	QUIT:meth="TimeStampToLogical" $d($$$EXTSQLCOLTimeStampToLogical($$$rEXT,extent,fieldname))
	QUIT 0
notfield	// Not a field, so conversion code was not harvested at class compile time
	new cls,dt,param,prop,code  ;  $$: 1 if fval.meth() exists
	do ddgetf(fval,.dt,.param,.cls,.prop)
	if $d(param("SCALE")),$$$VTRgetscale(fval),param("SCALE")'=$$$VTRgetscale(fval) { set param("SCALE")=$$$VTRgetscale(fval) }
	do getmeth(dt,meth,.param,.code,cls,prop,,,,,,$e($g($$$mtV(fval))),fval)
	QUIT $g(code)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	// Generate the method code for the field and return the call to the code
	// called from %qaqcasl, %qaqcpr, and %qaqcpre
	// arg is the value passed into the method
	// meth is the name of the conversion method (like LogicalToDisplay)
	// fval is the value number of the item being converted
appmeth(arg,meth,fval)	;  generate fval.meth(arg)
	new cls,collection,dt,ifn,irn,param,prop,sqllistdel
	do ddgetf(fval,.dt,.param,.cls,.prop,.collection,.sqllistdel,.irn,.ifn)  ;  get DD field info
	QUIT $$genmeth(dt,meth,.param,arg,cls,prop,collection,sqllistdel,irn,ifn,$e($g($$$mtV(fval))),fval)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	// called only from this routine
ddgetf(fval,&dt,&param,&cls="",&prop="",&collection,&sqllistdel,&irn,&ifn) ;  return (by .ref) into
	#;  <.dt,.param,.cls,.prop> DD field info for field fval
	s dt=$$$VTRgetdt(fval),collection="",sqllistdel=""
	s irn=$$$VTRgetirn(fval)
	s ifn=+$$$VTRgetifn(fval) s:ifn prop=$$$smdColPropertyName(1,irn,ifn)
	if irn {
		if $$$smdColContainerField(1,irn,ifn)'="" {
				#; if this is a serial field, we need to use the serial classname, not this classname so we call the correct conversion code
			set cls=$$$smdColContainerType(1,irn,ifn)		// cls is now the serial field's type (the serial class)
		}
		else { set cls=$$$smdClassname(1,irn) }
		if $$$smdIsAFakeTable(1,irn) {
			set cls="", prop=""
		}
	}
	if ifn {
		set:$$$smdColArrayCollection(1,irn,ifn) collection="a"
		set:$$$smdColListCollection(1,irn,ifn)="Y" collection="l"
	}
	set:$g(collection)="l"&&($$$smdColListDelimiter(1,irn,ifn)'="") sqllistdel=$$$smdColListDelimiter(1,irn,ifn)
	do GetParms^%qadfld2(irn,ifn,.param)
	set:$$$VTRgetscale(fval)'="" param("SCALE")=$$$VTRscale(fval)	// DPV3173
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK668-
	#; AK336
	// Called from %qaqcpr, %qaqcmn, and %qaqpDDLParser2
genmeth(cls,meth,par,args,classname="",property="",collection="",pSqlListDel="",irn="",ifn="",valtype="",val="") ;  return call to code-generated method code
	#;  .par by ref
	new bf,code,dlnm,olnm,ret
	if meth="RuntimeToLogical" {
		set olnm="",dlnm="",bf=0,ret=args
		if collection'="" {	// List or array collection
			if $$runnable^%qadadt(classname,property_"OdbcToCollection") {
					#; if this field uses an SqlListDelimiter, the SQL logical value is a delimited string, not a $List value
					#; However, Objects always uses a $List value for a logical list collection value.
					#; the Collection methods are expecting a $List logical collection value, so we have to convert here.
					#; EXCEPT if the cls is %Collection.MV.ListOfDT, in that case the logical value is always a delimited string
				if collection="l",pSqlListDel'="",cls'="%Collection.MV.ListOfDT" {
					set olnm="$zu(115,5)=1:$lts(##class("_classname_")."_$$$QN(property_"OdbcToCollection")_"("_args_"),"_pSqlListDel_")"
				}
				else {	// array or list collection without SqlListDel
					set olnm="$zu(115,5)=1:##class("_classname_")."_$$$QN(property_"OdbcToCollection")_"("_args_")"
				}
			}
			if $$runnable^%qadadt(classname,property_"DisplayToCollection") {
				if collection="l",pSqlListDel'="",cls'="%Collection.MV.ListOfDT" {
					set dlnm="$zu(115,5)=2:$lts(##class("_classname_")."_$$$QN(property_"DisplayToCollection")_"("_args_"),"_pSqlListDel_")"
				}
				else {	// array or list collection without SqlListDel
					set dlnm="$zu(115,5)=2:##class("_classname_")."_$$$QN(property_"DisplayToCollection")_"("_args_")"
				}
			}
		}
		else {	// regular field
			set olnm=$$genexprtag(cls,"OdbcToLogical",.par,.code,classname,property,irn,ifn,args,1,valtype,val)
			if olnm'="" set olnm="$zu(115,5)=1:"_olnm
			kill code
			set dlnm=$$genexprtag(cls,"DisplayToLogical",.par,.code,classname,property,irn,ifn,args,1,valtype,val)
			if dlnm'="" set dlnm="$zu(115,5)=2:"_dlnm
		}
		if olnm="",dlnm="" QUIT ret
		set ret="$s("
		set:olnm'="" ret=ret_olnm,bf=1
		set:dlnm'="" ret=ret_$s(bf:",",1:"")_dlnm
		set ret=ret_",1:"_args_")"
		QUIT ret
	}
	if meth="LogicalToRuntime" {
		set olnm="",dlnm="",bf=0,ret=args
		if collection'="" {	// List or array collection
			if $$runnable^%qadadt(classname,property_"CollectionToOdbc") {
					#; if this field uses an SqlListDelimiter, the SQL logical value is a delimited string, not a $List value
					#; However, Objects always uses a $List value for a logical list collection value.
					#; the Collection methods are expecting a $List logical collection value, so we have to convert here.
					#; EXCEPT if the cls is %Collection.MV.ListOfDT, in that case the logical value is always a delimited string
				if collection="l",pSqlListDel'="",cls'="%Collection.MV.ListOfDT" {
					set olnm="$zu(115,5)=1:##class("_classname_")."_$$$QN(property_"CollectionToOdbc")_"($lfs("_args_","_pSqlListDel_"))"
				}
				else {	// array or list collection without SqlListDel
					set olnm="$zu(115,5)=1:##class("_classname_")."_$$$QN(property_"CollectionToOdbc")_"("_args_")"
				}
			}
			if $$runnable^%qadadt(classname,property_"CollectionToDisplay") {
					#; if this field uses an SqlListDelimiter, the SQL logical value is a delimited string, not a $List value
					#; However, Objects always uses a $List value for a logical list collection value.
					#; the Collection methods are expecting a $List logical collection value, so we have to convert here.
					#; EXCEPT if the cls is %Collection.MV.ListOfDT, in that case the logical value is always a delimited string
				if collection="l",pSqlListDel'="",cls'="%Collection.MV.ListOfDT" {
					set dlnm="$zu(115,5)=2:##class("_classname_")."_$$$QN(property_"CollectionToDisplay")_"($lfs("_args_","_pSqlListDel_"))"
				}
				else {	// array or list collection without SqlListDel
					set dlnm="$zu(115,5)=2:##class("_classname_")."_$$$QN(property_"CollectionToDisplay")_"("_args_")"
				}
			}
		}
		else {	// regular field
			set olnm=$$genexprtag(cls,"LogicalToOdbc",.par,.code,classname,property,irn,ifn,args,1,valtype,val)
			if olnm'="" set olnm="$zu(115,5)=1:"_olnm
			kill code
			set dlnm=$$genexprtag(cls,"LogicalToDisplay",.par,.code,classname,property,irn,ifn,args,1,valtype,val)
			if dlnm'="" set dlnm="$zu(115,5)=2:"_dlnm
		}
		if olnm="",dlnm="" QUIT ret
		set ret="$s("
		set:olnm'="" ret=ret_olnm,bf=1
		set:dlnm'="" ret=ret_$s(bf:",",1:"")_dlnm
		set ret=ret_",1:"_args_")"
		QUIT ret
	}
	if meth="FDBMSTological" {
		set olnm="",dlnm="",bf=0,ret=args
		// regular fields only for FDBMS
		do getmeth(cls,"FDBMSToLogical",.par,.code,classname,property,irn,ifn)
		set:$g(code) olnm="$zu(115,5)=1:$$"_$$tagnam^%qaqcasl("s")_"("_args_")"
		if olnm="",dlnm="" QUIT ret
		set ret="$s("
		set:olnm'="" ret=ret_olnm,bf=1
		set:dlnm'="" ret=ret_$s(bf:",",1:"")_dlnm
		set ret=ret_",1:"_args_")"
		QUIT ret
	}
	if collection'="" {
		if meth="LogicalToOdbc",$$runnable^%qadadt(classname,property_"CollectionToOdbc") {
			if collection="l",pSqlListDel'="",cls'="%Collection.MV.ListOfDT" { QUIT "##class("_classname_")."_$$$QN(property_"CollectionToOdbc")_"($lfs("_args_","_pSqlListDel_"))" }
			QUIT "##class("_classname_")."_$$$QN(property_"CollectionToOdbc")_"("_args_")"
		}
		if meth="LogicalToDisplay",$$runnable^%qadadt(classname,property_"CollectionToDisplay") {
			if collection="l",pSqlListDel'="",cls'="%Collection.MV.ListOfDT" { QUIT "##class("_classname_")."_$$$QN(property_"CollectionToDisplay")_"($lfs("_args_","_pSqlListDel_"))" }
			QUIT "##class("_classname_")."_$$$QN(property_"CollectionToDisplay")_"("_args_")"
		}
		if meth="LogicalToFDBMS",$$runnable^%qadadt(classname,property_"CollectionToFDBMS") {
			if collection="l",pSqlListDel'="",cls'="%Collection.MV.ListOfDT" { QUIT "##class("_classname_")."_$$$QN(property_"CollectionToFDBMS")_"($lfs("_args_","_pSqlListDel_"))" }
			QUIT "##class("_classname_")."_$$$QN(property_"CollectionToFDBMS")_"("_args_")"
		}
		if meth="OdbcToLogical",$$runnable^%qadadt(classname,property_"OdbcToCollection") {
			if collection="l",pSqlListDel'="",cls'="%Collection.MV.ListOfDT" { QUIT "$lts(##class("_classname_")."_$$$QN(property_"OdbcToCollection")_"("_args_"),"_pSqlListDel_")" }
			QUIT "##class("_classname_")."_$$$QN(property_"OdbcToCollection")_"("_args_")"
		}
		if meth="DisplayToLogical",$$runnable^%qadadt(classname,property_"DisplayToCollection") {
			if collection="l",pSqlListDel'="",cls'="%Collection.MV.ListOfDT" { QUIT "$lts(##class("_classname_")."_$$$QN(property_"DisplayToCollection")_"("_args_"),"_pSqlListDel_")" }
			QUIT "##class("_classname_")."_$$$QN(property_"DisplayToCollection")_"("_args_")"
		}
		if meth="FDBMSToLogical",$$runnable^%qadadt(classname,property_"FDBMSToCollection") {
			if collection="l",pSqlListDel'="",cls'="%Collection.MV.ListOfDT" { QUIT "$lts(##class("_classname_")."_$$$QN(property_"FDBMSToCollection")_"("_args_"),"_pSqlListDel_")" }
			QUIT "##class("_classname_")."_$$$QN(property_"FDBMSToCollection")_"("_args_")"
		}
	}
	QUIT $$genexprtag(cls,meth,.par,.code,classname,property,irn,ifn,args,,valtype,val)
	
genexprtag(cls,meth,&par,&code,classname="",property="",irn="",ifn="",args,nullsimple=0,valtype="",val="") [code,rtpcHelperCode] {
	do getmeth(cls,meth,.par,.code,classname,property,irn,ifn,,,.expression,valtype,val)
	if '$get(code) QUIT $select(nullsimple:"",1:args)
	if $$isinline(.expression,args) {
		kill code
		QUIT expression
	}
	if $g(rtpcHelperCode("caller"))'=""{
		set tagname = "%rtpcHelper"_$I(rtpcHelperCode(-1))
		merge rtpcHelperCode("helper",tagname) =code
		QUIT $s(rtpcHelperCode("caller")["ShowPlan":"$$",1:"..")_tagname_"("_args_")"
	}
	QUIT "$$"_$$tagnam^%qaqcasl("s")_"("_args_")"
}
#; Determine if we can inline the expression
isinline(expression,args) {
	#; If we have an expression for this and if the argument appears to be a simple variable reference then inline this
	if $get(expression)'="",args'[".",args'["$$",args'["^" {
		#; We allow $get/$data but anything else is too expensive so generate a function for these
		set tmpargs=$zconvert(args,"l")
		if args["$" {
			set tmp=$translate($replace($replace($replace($replace(tmpargs,"$g(",""),"$get(",""),"$d(",""),"$data(",""),")")
			#; This does not always put ')' back in the right place, but if the expression is complex the $$islvar will fail anyway so that is okay.
			set tmp=tmp_$translate($justify("",$length(tmp,"(")-1)," ",")")
			if tmp["$"||('$$islvar(tmp)) {
				RETURN 0
			}
			#; Need to detect $get(@@p@@) type syntax, if @@p@@ is already $get(var) need to supress one of them
			#; Functions I need to detect are $data,$get,$increment,$name,$order,$sequence,$query
			set expr=$zconvert($translate(expression,$c(9,32,160)),"l")
			set find=0
			for i=1:1 {
				set find=$find(expr,"@@p@@",find) quit:'find
				if $extract(expr,find-6)="(",$extract(expr,find)=")" {
					for j=find-7:-1:1 {
						if $extract(expr,j)="$" {
							set func=$extract(expr,j+1,find-7)
							if $listfind($listbuild("increment","i","name","n","order","o","sequence","seq","query","q"),func) RETURN 0
							if func="data"||(func="d") {
								set replace(i)=1
							} elseif func="get"||(func="g") {
								set replace(i)=2
							}
						}
					}
				}
			}
		} elseif '$$islvar(args) {
			#; If more complex than local variable do not inline
			RETURN 0
		}
		set find=0
		for i=1:1 {
			set find=$find(expression,"@@p@@",find) quit:'find
			if '$data(replace(i),type) {
				set $extract(expression,find-5,find-1)=args,find=find+$length(args)-5
			} elseif type=1 {
				for j=find-7:-1:1 quit:$extract(expression,j)="$"
				for k=find:1:1 quit:$extract(expression,k)=")"
				set $extract(expression,j,k)="1",find=find-(k-j)
			} elseif type=2 {
				for j=find-7:-1:1 quit:$extract(expression,j)="$"
				for k=find:1:1 quit:$extract(expression,k)=")"
				set $extract(expression,j,k)=args,find=find-(k-j)+$length(args)-1
			}
		}
		RETURN 1
	}
	RETURN 0
}
islvar(lvar) {
	set src(0)=1
	set src(1)=" i $g("_lvar_")"
	quit '$compile(src,0,errors,obj)
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	// getmeth calls into getcode^%qadadt to harvest the code for the method and generates it in the PBR code() parameter
	// Unless we already have it in ^oddEXTR from the class compile!
	// called from %qaqcpr and %qaqcdt and %ocsCacheSQLFiler
	// called with either:
	//	irn, ifn, extent, and fieldname = ""
	//  OR  irn and ifn defined
	//  OR  extent and fieldname defined
	// valtype is the $e(mt("v",val)) type for the value potentially having conversion code performed on it.
	// We only allow conversion code performed on the client if the type of the val is "t" (literal) or "x" (host variable)
getmeth(cls,meth,&par,&code,classname="",property="",irn="",ifn="",extent="",fieldname="",expression,valtype="",val="")
	new defCode,defaultArgs,hasAssociatedExtent,i,isCollection,isFakeTable,isTVF,pCanConvertOnClient,preharvestedMethod,procedureblock,sign
	kill expression
	set pCanConvertOnClient=0
	QUIT:meth=""	// Nothing to do
	set isCollection=0, isFakeTable=0, isTVF=0
	set hasAssociatedExtent = (extent'="")
	set preharvestedMethod = $case(meth,"LogicalToDisplay":1,"LogicalToOdbc":1,"LogicalToStorage":1,"LogicalToFDBMS":1,"DisplayToLogical":1,"OdbcToLogical":1,"StorageToLogical":1,"FDBMSToLogical":1,"LogicalToDate":1,"DateToLogical":1,"LogicalToTimeStamp":1,"TimeStampToLogical":1,:0)
	if irn {
		set isTVF = $$$smdIsATVF(1,irn)
			// If fake table, cls="" b/c smd() does not have a class for a fake table - and there is no actual class w/ a property to get code from.
			// When both cls and property nulled then getcode should not try to grab override code
		set isFakeTable = $$$smdIsAFakeTable(1,irn)
		if isFakeTable {
			set property = ""
			set hasAssociatedExtent = 0
		} elseif ifn {
			set hasAssociatedExtent = 1
			set isCollection = ($$$smdColArrayCollection(1,irn,ifn) || ($$$smdColListCollection(1,irn,ifn)="Y"))
		}
	}
.
		// See if we have already harvested the code at class/table compile time
	if hasAssociatedExtent && 'isTVF && 'isFakeTable && 'isCollection && preharvestedMethod {
		new hash
		if extent="" {	// if extent="", irn & ifn must be defined
			set extent=$$$smdExtent(1,irn)	QUIT:extent="" 0
			set fieldname=$$$smdGetFieldName(ifn)
			if ($$$SQLCompileOption("xDBCCompileMode")=1 || ($$$SQLCompileOption("RTUXdbc")=1)) && $case(valtype,"x":1,"t":1,:0) {
				if meth="LogicalToOdbc"     { set pCanConvertOnClient=$$$smdColConvertL2OOnClient(1,irn,ifn) }
				elseif meth="OdbcToLogical" { set pCanConvertOnClient=$$$smdColConvertO2LOnClient(1,irn,ifn) }
			}
		}
		elseif ($$$SQLCompileOption("xDBCCompileMode")=1 || ($$$SQLCompileOption("RTUXdbc")=1)) && $case(valtype,"x":1,"t":1,:0) {
 			new colinfo set colinfo=$$$EXTSQLCOLsqlinfo($$$rEXT,extent,fieldname)
			if meth="LogicalToOdbc"     { set pCanConvertOnClient=$$$SQLLocColConvertL2OOnClient(colinfo) }
			elseif meth="OdbcToLogical" { set pCanConvertOnClient=$$$SQLLocColConvertO2LOnClient(colinfo) }
		}
			#; Need to look up code again if this is a function/expression because the parameters might be different than defined for the field.
		if valtype="v" || ($g($$$EXTsqlmetadataversion($$$rEXT,extent),0)<1) {	// class compiled under an older version of the compiler where harvested code is not present in ^oddEXTR
			if $$getcode^%qadadt(cls,meth,.par,.sign,.code,,classname,property,.defaultArgs,.procedureblock,,.expression,.pCanConvertOnClient)
			QUIT:'$g(code)
		}
		else {
			if meth="LogicalToDisplay" 		{ set hash=$g($$$EXTSQLCOLLogicalToDisplay($$$rEXT,extent,fieldname)) }
			elseif meth="LogicalToOdbc" 		{ set hash=$g($$$EXTSQLCOLLogicalToOdbc($$$rEXT,extent,fieldname)) }
			elseif meth="LogicalToStorage"		{ set hash=$g($$$EXTSQLCOLLogicalToStorage($$$rEXT,extent,fieldname)) }
			elseif meth="LogicalToFDBMS"		{ set hash=$g($$$EXTSQLCOLLogicalToFDBMS($$$rEXT,extent,fieldname)) }
			elseif meth="DisplayToLogical"		{ set hash=$g($$$EXTSQLCOLDisplayToLogical($$$rEXT,extent,fieldname)) }
			elseif meth="OdbcToLogical"		{ set hash=$g($$$EXTSQLCOLOdbcToLogical($$$rEXT,extent,fieldname)) }
			elseif meth="StorageToLogical"		{ set hash=$g($$$EXTSQLCOLStorageToLogical($$$rEXT,extent,fieldname)) }
			elseif meth="FDBMSToLogical"		{ set hash=$g($$$EXTSQLCOLFDBMSToLogical($$$rEXT,extent,fieldname)) }
			elseif meth="LogicalToDate"		{ set hash=$g($$$EXTSQLCOLLogicalToDate($$$rEXT,extent,fieldname)) }
			elseif meth="DateToLogical"		{ set hash=$g($$$EXTSQLCOLDateToLogical($$$rEXT,extent,fieldname)) }
			elseif meth="LogicalToTimeStamp"	{ set hash=$g($$$EXTSQLCOLLogicalToTimeStamp($$$rEXT,extent,fieldname)) }
			elseif meth="TimeStampToLogical"	{ set hash=$g($$$EXTSQLCOLTimeStampToLogical($$$rEXT,extent,fieldname)) }
			QUIT:hash=""
			new sig
			set sig=$g($$$EXTsqlconversioncodesignature($$$rEXT,extent,hash))
			set sign=$lg(sig,1),defaultArgs=$lg(sig,2),expression=$lg(sig,3),procedureblock=$lg(sig,4)
			if expression="" {
				set code=$$$EXTsqlconversioncodenumlines($$$rEXT,extent,hash)
				QUIT:'code	// Should not happen, but being safe
				for i=1:1:code { set code(i)=$$$EXTsqlconversioncodeline($$$rEXT,extent,hash,i) }
			} else {
				#; Convert expression back into code in case caller needs this
				set code=1,code(1)=$char(9)_"Quit "_$replace(expression,"@@p@@",$extract($get(sign),2,*-1))
			}
		}
	}
	else {
		if $$getcode^%qadadt(cls,meth,.par,.sign,.code,,classname,property,.defaultArgs,.procedureblock,,.expression,.pCanConvertOnClient)
		QUIT:'$g(code)
	}
		#; In %qaqpif2 we build  list of select columns that will perform LogicalToOdbc on the client during Prepare.
		#; This is recorded in a comment options of select-item-positions in the xDBCL2OonClient optional
		#; If this value is a select-item-position and it is listed in this comment option, no need to convert on the server
	if val,meth="LogicalToOdbc",$d(mt("options","xDBCL2OonClient")) {
		new pos,sellist
		set sellist=$$$mtOutputVals($$$mtOutput(1))
		set pos=0 for i=1:1:$l(sellist,",") { if $p(sellist,",",i)=val { set pos=i quit } }
		if (","_mt("options","xDBCL2OonClient")_",")[(","_pos_",") { kill code set code=0 RETURN }
	}
		#; During Prepare in %qaqpif2 we build a list of parameters that will perform OdbcToLogical conversion on the client.
		#; This is stored in a comment option for the statement in xDBCParamClientConversions, a "|" list of parameter variables
		#; These input parmeters we do not need to perform O2L conversion on the server, it will be performed on the client.
	if val,valtype="x",meth="OdbcToLogical" {
		if $d(mt("options","xDBCParamClientConversions")),("|"_mt("options","xDBCParamClientConversions")_"|")[("|"_$p($$$mtV(val),"^",2)_"|") { kill code set code=0 RETURN }
	}
		// This logic is to prevent conversion on the server and perform conversion on the client when possible.
		// It is mainly for input parameters, as select items should have already been handled in getvalex^%qaqcasl by not adding the unary %ODBCOUT as the return value
		// We can not perform conversion on the client for input parameters or DQ or DU calls because we do not have a separate Prepare first that reports types to the client.
		// DPV5402 added valtype="f" here to allow fields output from a subquery to perform conversion on the client if the type supports it
		// This is also called from odbcout^%qaqcasl for non-field columns.  These, we can perform some conversion on the client, but only for the select/output columns
	elseif 0 {
		if valtype'="" && ($case(valtype,"x":1,"t":1,"f":1,:0) || ($e($g($$$mtV(+val)),1,5)="a^min") || ($e($g($$$mtV(+val)),1,5)="a^max")) || (($e($g($$$mtV(+val)),1,9)="v^CURDATE") || ($e($g($$$mtV(+val)),1,9)="v^CURTIME") || ($e($g($$$mtV(+val)),1,7)="v^CURTS")) {
			if $$$SQLCompileOption("xDBCCompileMode")=1,$$$SQLCompileOption("xDBCServerProtocol")>6,pCanConvertOnClient,'$$unionLegField(+val) {
					// If this is LogicalToOdbc for an output column, we can convert on the client even if this is DQ
				if meth="LogicalToOdbc",(","_$$$mtOutputVals($$$mtOutput(1))_",")[(","_+val_",") { kill code set code=0 RETURN  }
				if $case($$$SQLCompileOption("xDBCFunction"),"DU":0,"DQ":0,:1) { kill code set code=0 RETURN  }
			}
			if $$$SQLCompileOption("RTUXdbc")=1 { kill code set code=0 QUIT  }
		}
	}
	do:$g(defaultArgs)'=""&&($g(sign)'="") fixFormals^%ocsCacheSQLFiler0(.sign,defaultArgs,.defCode)	// DPV2926
	if code,classname'="" { // This might be a serial field, define the class context as that of the classname, which will be the serial class if this is a serial field
		new tCode
		merge tCode=code kill code
		set code=1,code(1)="#classcontext "_classname
		for i=1:1:tCode set code=code+1,code(code)=tCode(i)
		set code=code+1,code(code)="#endclasscontext"
		kill tCode
	}
	for i=code:-1:1 { s code(i+1)=code(i) }
	if $g(rtpcHelperCode("caller"))'="" {set code("procedureBlock")=procedureblock,procedureblock=0}
	if ''$g(procedureblock) {	// procedureblock
		set code=code+2,code(1)=sign_" {"_$g(defCode),code(code)="}"
	}
	else {	// not procedureblock
		set code=code+1,code(1)=sign_$g(defCode)
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK336-
ConvertToDate(arg)
	//QUIT:$$$VTRgetcat(arg)="POSIXTS" "##class(%Library.PosixTime).LogicalToOdbc("_$$ptvalue(arg)_")"
		#; An SqlCategory of FMTIMESTAMP makes an assumption that the value is a %Fileman.TimeStamp.
	QUIT:$$$VTRgetcat(arg)="FMTIMESTAMP" "##class(%Library.FilemanTimeStamp).LogicalToOdbc("_$$ptvalue(arg)_")"
		#; An SqlCategory of FMDATE makes an assumption that the value is a %Fileman.Date.
	QUIT:$$$VTRgetcat(arg)="FMDATE" "##class(%Library.FilemanDate).LogicalToDate("_$$ptvalue(arg)_")"
		#; An SqlCategory of MVDATE makes an assumption that the value is a %MV.Date.
	QUIT:$$$VTRgetcat(arg)="MVDATE" "##class(%MV.Date).LogicalToDate("_$$ptvalue(arg)_")"
	if $$$VTRgetdt(arg)'="%Library.Date",$$$VTRgetcat(arg)="DATE",$$runnable^%qadadt($$$VTRgetdt(arg),"LogicalToDate") QUIT "##class("_$$$VTRgetdt(arg)_").LogicalToDate("_$$ptvalue(arg)_")"
	if $$$VTRgetdt(arg)'="%Library.TimeStamp",$$$VTRgetcat(arg)="TIMESTAMP",$$runnable^%qadadt($$$VTRgetdt(arg),"LogicalToTimeStamp") QUIT "##class("_$$$VTRgetdt(arg)_").LogicalToTimeStamp("_$$ptvalue(arg)_")"
	QUIT $$ptvalue(arg)
.
ConvertToDate2(arg,val,includePosixCheck=0)	// Same as ConvertToDate, but pass in the arg and val separately (val has already been determined by calling ptvalue())
	if includePosixCheck { QUIT:$$$VTRgetcat(arg)="POSIXTS" "##class(%Library.PosixTime).LogicalToDate("_val_")" }
	QUIT:$$$VTRgetcat(arg)="FMTIMESTAMP" "##class(%Library.FilemanTimeStamp).LogicalToOdbc("_val_")"
	QUIT:$$$VTRgetcat(arg)="FMDATE" "##class(%Library.FilemanDate).LogicalToDate("_val_")"
	QUIT:$$$VTRgetcat(arg)="MVDATE" "##class(%MV.Date).LogicalToDate("_val_")"
	if $$$VTRgetdt(arg)'="%Library.Date",$$$VTRgetcat(arg)="DATE",$$runnable^%qadadt($$$VTRgetdt(arg),"LogicalToDate") QUIT "##class("_$$$VTRgetdt(arg)_").LogicalToDate("_val_")"
	if $$$VTRgetdt(arg)'="%Library.TimeStamp",$$$VTRgetcat(arg)="TIMESTAMP",$$runnable^%qadadt($$$VTRgetdt(arg),"LogicalToTimeStamp") QUIT "##class("_$$$VTRgetdt(arg)_").LogicalToTimeStamp("_val_")"
	QUIT val
.
ConvertToTimeStamp(arg,val,includePosixCheck=0)	// Same as ConvertToDate, but pass in the arg and val separately (val has already been determined by calling ptvalue())
	if includePosixCheck { QUIT:$$$VTRgetcat(arg)="POSIXTS" "##class(%Library.PosixTime).LogicalToOdbc("_val_")" }
	QUIT:$$$VTRgetcat(arg)="FMTIMESTAMP" "##class(%Library.FilemanTimeStamp).LogicalToOdbc("_val_")"
	QUIT:$$$VTRgetcat(arg)="FMDATE" "##class(%Library.FilemanDate).LogicalToDate("_val_")"_",0"
	QUIT:$$$VTRgetcat(arg)="MVDATE" "##class(%MV.Date).LogicalToDate("_val_")"_",0"
	if $$$VTRgetdt(arg)'="%Library.Date",$$$VTRgetcat(arg)="DATE",$$runnable^%qadadt($$$VTRgetdt(arg),"LogicalToDate") QUIT "##class("_$$$VTRgetdt(arg)_").LogicalToDate("_val_")"_",0"
	if $$$VTRgetdt(arg)'="%Library.TimeStamp",$$$VTRgetcat(arg)="TIMESTAMP",$$runnable^%qadadt($$$VTRgetdt(arg),"LogicalToTimeStamp") QUIT "##class("_$$$VTRgetdt(arg)_").LogicalToTimeStamp("_val_")"
	QUIT val
.
CheckForDateConversion(includePosixCheck=0)	;
		#; if this value is of type %Library.FilemanDate, %Library.FilemanTimestamp, or %MV.Date
		#; convert the value to a logcal %Date value first.
	new convcode
	set convcode=$$ConvertToDate2(arg1,val,includePosixCheck)
	if convcode'=val {	// conversion is needed
		set val=$$scratch(,1)
		set line="set "_val_"="_convcode $$$liin(.line)			
	}
	QUIT
CheckForTimeStampConversion(includePosixCheck=0)	;
		#; if this value is of type %Library.FilemanDate, %Library.FilemanTimestamp, or %MV.Date
		#; convert the value to a logcal %TimeStamp value first.
	new convcode
	set convcode=$$ConvertToTimeStamp(arg1,val,includePosixCheck)
	if convcode'=val {	// conversion is needed
		set val=$$scratch(,1)
		set line="set "_val_"="_convcode $$$liin(.line)			
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
	/// Given a val, return 1 if this val is from the SELECT list of any UNION subquery	
unionLegField(val) [mt] PUBLIC {
		#; If val is a virtual field get the val of the parent field
	RETURN:'val 0
	if $$$mtVType($$$mtV(val))="f",$d($$$mtVirf(+$p($$$mtV(val),"^",3)),data) {
		set realval=$lg(data,2)
	} else {
		set realval=val
	}
	set m=0
	for  {
		set m=$o($$$mtUnionLegVals(m)) quit:'m
		if $listfind($$$mtUnionLegVals(m),realval) { RETURN 1 }
	}
	RETURN 0
}
.
reevalReferencedExpressions(qn) [ mt ] public {
	Set v = ""
	For {
		Set v = $o(mt("evalAfter",qn,v)) QUIT:v=""
		//no flag needed if we always have to eval, or if streamless
		//(streamless subqueries already have a $$once flag)
		If $d(mt("evalBefore",qn,v)) CONTINUE
		If $$isStreamless^%qaqpag(v) CONTINUE
		Set line = "set "_$$$getVarName("needsEval"_v)_"=1" $$$liin(.line)
	}
}	
evalReferencedExpressions(qn) [ mt ] public {
	Set v = ""
	For {
		Set v = $o(mt("evalBefore",qn,v)) QUIT:v=""
		//no flag used if we always have to eval, or if streamless
		If $d(mt("evalAfter",qn,v)) Do settemp^%qaqcpre(v) CONTINUE
		If $$isStreamless^%qaqpag(v) Do settemp^%qaqcpre(v) CONTINUE
		Set line = "if "_$$$getVarName("needsEval"_v)_" {" $$$liin(.line)
		Do settemp^%qaqcpre(v)
		Set line = "set "_$$$getVarName("needsEval"_v)_"=0 }" $$$liin(.line)
	}
}
.
	// Given a val and an expression to code generate, return code to evaluate the expression with
	// val evaluated only once if val is itself an expression.
	// This is used for functions that check if the value is null, return null, otherwise compute the expression value
	// but if vall is itself an xepression, say $$tag^rtn() or ##class(classname).method(), we only want to call val's code once
	// For example:
	//	cast(field as date)
	//		This is simple and can continue to generate $s(field="":"",1:+field\1)
	//	cast(userDefinedFunction(field) as date)
	//		This is will generate a ##class(...).method(field) call and in the traditional $select to check for null we don't want to call the method twice.
	// expression will contain a $c(1) marker which should be replaced by the the pti(arg1) value
evalOnce(val,arg1,expression) [mt,pti] PUBLIC {
	if "$#"[$e(val) {
		do davalue(arg1)		
		if $$evalLiteral(pti(arg1),.targ1) {
			RETURN $s(targ1="":"""""",1:$replace(expression,$c(1),pti(arg1)))
		} else {
			RETURN "$s("_pti(arg1)_"="""":"""",1:"_$replace(expression,$c(1),pti(arg1))_")"
		}
	}
	RETURN "$s("_val_"="""":"""",1:"_$replace(expression,$c(1),val)_")"
}
.
#; Return true if this is a literal and set the literal into byref 'output' parameter
#; Supporting numbers (without 'E' values), strings, and $c(<int>) and '_' of these together
evalLiteral(str,output) public {  ;  MAK5086
	set output="",quote=0
	set offset=1
	for {
		set char=$e(str,offset)
		if char?1N {
			for i=offset+1:1:$l(str)+1 quit:$e(str,i)'?1N
			set output=output_$e(str,offset,i-1)
			if $e(str,i)="" RETURN 1
			if $e(str,i)="_" set offset=i+1 CONTINUE
			set output="" RETURN 0
		} elseif char="""" {
			for {
				set find=$find(str,"""",offset+1)
				if find=0 set output="" RETURN 0
				if $e(str,find)="""" {
					set output=output_$e(str,offset+1,find-1),offset=find
					CONTINUE
				}
				set output=output_$e(str,offset+1,find-2)
				if $e(str,find)="" RETURN 1
				if $e(str,find)="_" set offset=find+1 QUIT
				set output="" RETURN 0
			}
		} elseif char="$",$zcvt($e(str,offset+1,offset+2),"l")="c(" {
			for {
				for i=offset+3:1:$l(str) quit:$e(str,i)'?1N
				if $e(str,i)="," set output=output_$char($e(str,offset+3,i-1)),offset=i-2 CONTINUE
				if $e(str,i)=")" QUIT
				set output="" RETURN 0
			}
			set output=output_$char($e(str,offset+3,i-1))
			if $e(str,i+1)="" RETURN 1
			if $e(str,i+1)="_" set offset=i+2 CONTINUE
		} else {
			set output=""
			RETURN 0
		}
	}
}
.
	// Given an IRIS datatype, return the ODBC Type
GetODBCType(type="") [] PUBLIC {
	RETURN:type="" "VARCHAR"
	RETURN $$$comClassKeyGet(type,$$$cCLASSodbctype)
}
.
#; --- Window functions /BEGIN
.
#; Generate code to evaluate window function v, which may be a wrapped "forward" window function
#; to build intermediate results, or a "backward" or unwrapped "forward" window that is ready to 
#; produce its final results.
windowFunction(v) [ mt, pti,windowVars ] public {
	d cgcApnd^%qaqcasl("davals",v_",") ; add this val to davals list
	Set val = $$$mtV(v)
	Set op = $p(val,"^",2)
	Set isfwd = op [ "_FWD"
	#; FWD nodes are just wrappers to distinguish first pass from final pass
	#; in codegen. Get the real expression.
	If isfwd {
		Set v = $p(val,"^",4)
		Set val = $$$mtV(v)
		Set op = $p(val,"^",2)
	}
	#; Now no distinction between a backward WF and its forward wrapper
	#; except that isfwd = 1 for the latter
	Set func = $p(op,":",2)
	//var is the local array for window state
	#; Initialize (kill) in MAIN
	If 'isfwd /*only once*/ {
		for name="windowval"_v,"windowrowval"_v {
			Do:$$isLocalWindowVar(name) initvar^%qaqcasl(windowVars("ref",name),"")
		}
		if $d(windowVars("ppgList",v)) {
			set ptr=0
   			while $LISTNEXT(windowVars("ppgList",v),ptr,fn) {
		    	Do initemp^%qaqcasl(fn,"")
   			}
		}
	}
	//Use a little $XECUTE magic to dispatch to the appropriate set of window function codegen tags.
	//This avoids a two-level dispatch table & doesn't require splitting this code out into classes.
	//TODO: This is now obviously object-oriented: Split this code out into classes!
	Set tagName = ""
	If func = "ROW_NUMBER" Set tagName = "rowNumber"
	If func = "RANK" Set tagName = "rank"
	If func = "DENSE_RANK" Set tagName = "denseRank"
	If func = "PERCENT_RANK" Set tagName = "percentRank"
	If func = "CUME_DIST" Set tagName = "cumeDist"
	If func = "NTILE" Set tagName = "ntile"
	If func = "SUM" Set tagName = "sum"
	If func = "FIRST_VALUE" Set tagName = "firstValue"
	If func = "COUNT" Set tagName = "count"
	If func = "MIN" Set tagName = "min"
	If func = "MAX" Set tagName = "max"
	If func = "LAG" Set tagName = "lag"
	If func = "LEAD" Set tagName = "lead"
	If func = "NTH_VALUE" Set tagName = "nthValue"
	If func = "LAST_VALUE" Set tagName = "lastValue"
	If tagName '= "" {
		//Backward-looking window
		If '$$isForwardWindow^%qaqpagg(v) {
			Set expr = $XECUTE("(v) QUIT $$"_tagName_"Backward(v)",v)
		}
		//Forward-looking window during scan
		ElseIf isfwd {
			Set expr = $XECUTE("(v) QUIT $$"_tagName_"ForwardScan(v)",v)
		}
		//Forward-looking window during output
		Else {
			Set expr = $XECUTE("(v) QUIT $$"_tagName_"ForwardOutput(v)",v)
		}
		$$$liin("Set "_pti(v)_"="_expr)
		RETURN pti(v)
	}
	RETURN v
}
.
#; Loop through mt("v"), for each window function, new the array variable (local/ppg, determined by getWindowVar)
checkWindowFunTempFile()[mt] public {
	for v = 1:1 {
		RETURN:'$d($$$mtV(v))	
		set val = $$$mtV(v)
		CONTINUE:$e(val,1,19)'="v^%WINDOW_FUNCTION:"
		Set func = $p($p(val,"^",2),":",2)
		set windowVar = $$windowVar(v)
		CONTINUE:",ROW_NUMBER,RANK,DENSE_RANK,PERCENT_RANK,CUME_DIST,"[(","_func_",") ; no other arr needed
		if (",SUM,COUNT,"[(","_func_",")) && $$windowFrameRows(v) {
			set windowRowVar = $$windowRowVar(v)
			set erefs = $$getWindowVar(v,"erefs"_v,1,4) ; for counter subscript, we use 2 as average field size
			set rowvals = $s(func="SUM":$$getWindowVar(v,"rowvals"_v,2,2),1:$$getWindowVar(v,"rowvals"_v,1,4))
			if $$windowFrameRowsWidth(v)&&(func="SUM"){
				Set nnCnt = $$getWindowVar(v,"nnCnt"_v,1,4)
			}
			if $s($$windowFrameEnd(v)=">":-1,1:1)=-1 {
				set revErefs = $$getWindowVar(v,"revErefs"_v,1,4)
			}
		} elseif (",NTILE,FIRST_VALUE,NTH_VALUE,LAST_VALUE,LAG,LEAD,"[(","_func_",")) && $$isForwardWindow^%qaqpagg(v) {
			set windowRowVar = $$windowRowVar(v)
			set erefs = $$getWindowVar(v,"erefs"_v,1,4)
		} elseif (",MIN,MAX,"[(","_func_",")) && $$windowFrameRows(v){
			set windowRowVar = $$windowRowVar(v)
			set erefs = $$getWindowVar(v,"erefs"_v,1,4)
			set rowvals = $$getWindowVar(v,"rowvals"_v,2,2)
			set leftArr = $$getWindowVar(v,"left"_$s(func="MIN":"Min",1:"Max")_v,2,2)
			set rightArr = $$getWindowVar(v,"right"_$s(func="MIN":"Min",1:"Max")_v,2,2)
			if $s($$windowFrameEnd(v)=">":-1,1:1)=-1 {
				set revErefs = $$getWindowVar(v,"revErefs"_v,1,4)
			}
		}
	}
	RETURN	
}
.
#; Determine if this should be a local var or a PPG, return the variable name
getWindowVar(v,name,perPartition=0,addtionalSize=2) [m,mod,mts,mt,windowVars] public {
	if $d(windowVars("ref",name)) {
		#; if we've already new it, return the variable name directly
		RETURN windowVars("ref",name)
	}
	set useLocalArr = 1
	if $$Getbbsiz^%SYS.SQLSRV()<$$$MaxPartitionSize { ; copy from useLocalArrayTempfile^%qaqpmod
		set useLocalArr = 0
	} else {
		if 'perPartition{
			#; we user the addtionalSize+sum(avgFieldSize(each fields in this window function)+2) as the avg len
			set flds = $p($$$mtV(v),"^",3)
			set avgLen = addtionalSize,tuples = $p($g($$$mtNumTupleAndAvgLen(m)), ",", 1)
			set:tuples="" tuples=1.5
			
			for li=2:1:$l(flds,",")-1 {
				set val = $$$mtV($p(flds,",",li))
				if $e(val)'="f" {
					set curAvgLen = 60
				} else {
					set str = $p(val,"^",2),ifn=$p(val,"^",3)
					set curAvgLen = $p($g(mts(m,str,"ATT",ifn)),"^",8)
					if 'curAvgLen {
						set curMaxLen = $p($g(mts(m,str,"ATT",ifn)),"^",4)
						set curAvgLen = $s(curMaxLen>100:60,curMaxLen>50:30,curMaxLen>20:15,curMaxLen>10:10,1:curMaxLen) ; copy from nodes^%qaqojn2
					}
				}
				set avgLen = avgLen+curAvgLen+2
			}
		} else {
			#; for perPartition = 1 we use the addtionalSize as the avg len
			#; for perPartition = 2, we use addtionalSize+sum(avgFieldSize(each fields in $p(8))+2) as the avg len
			set avgLen = addtionalSize,tuples = $p($g($$$mtNumTupleAndAvgLen(m)), ",", 1)
			set:tuples="" tuples=1.5
			set winArg = $p($$$mtV(v),"^",8)
			
			if (perPartition=2)&&winArg { ; add avglen for $p(8)
				set winArgVal = $$$mtV(winArg)
				if $e(winArgVal)="f" {
					set flds = ","_winArg_","
				} else {
					set flds = $p($$$mtV(winArg),"^",3)
				}
				for li=2:1:$l(flds,",")-1 {
					set val = $$$mtV($p(flds,",",li))
					if $e(val)'="f" {
						set curAvgLen = 60
					} else {
						set str = $p(val,"^",2),ifn=$p(val,"^",3)
						set curAvgLen = $p($g(mts(m,str,"ATT",ifn)),"^",8)
						if 'curAvgLen {
							set curMaxLen = $p($g(mts(m,str,"ATT",ifn)),"^",4)
							set curAvgLen = $s(curMaxLen>100:60,curMaxLen>50:30,curMaxLen>20:15,curMaxLen>10:10,1:curMaxLen) ; copy from nodes^%qaqojn2
						}
					}
					set avgLen = avgLen+curAvgLen+2
				}
			}
			#; estimate how many row per partiition
			set windowPartVal = $p($$$mtV(v),"^",4)
			set fields = $p($$$mtV(windowPartVal),"^",3)
			set selectivity = 1
			for i=2:1:$l(fields,",")-1 {
				set fldsel = $$getValSelectivity^%qaqpag($p(fields,",",i))
				set selectivity = selectivity * fldsel
			}
			set tuples = tuples*selectivity
		}
		set:tuples*avgLen>=$$$LocalArrayMemoryThreshold useLocalArr=0
	}
	if useLocalArr {
		#; This step can be achived by tfref, but that would make the name "tablenum1", 
		#; I want to use the name specified (easy for debugging)
		set windowVars("ref",name) = $$$getVarName(name)	
		set windowVars("ref",name,"local") = 1
	} else {
		#; new temp file
		set filenum = $$nutemp^%qaqpmod("dist^"_mod_"^^^^^^^^^^0")	
		set windowVars("ref",name)=$$tfref^%qaqcpre(filenum,2)
		set windowVars("ppgList",v)=$g(windowVars("ppgList",v))_$S('$lf($g(windowVars("ppgList",v)),filenum):$lb(filenum),1:"")
	}
	RETURN windowVars("ref",name)		
}
.
#; return if this is array is a local variable
isLocalWindowVar(name) [windowVars] public {
	return $g(windowVars("ref",name,"local"))
}
.
#; The root (array) variable used as scratch space to compute window
#; function values
windowVar(v) public {
	Return $$getWindowVar(v,"windowval"_v)
}
.
#; An per-partition reference in the window function scratch space
windowSlot(v) public {
	Set partref = $$windowPartRef(v)
	Return $$wsubv($$windowVar(v), partref)
}
.
#; A per-partition-entry reference in the window function scratch space
windowEntry(v) public {
	Return $$wsubv($$windowVar(v),$$windowEntryRef(v))
}
.
windowRowVar(v) public {
	Return $$getWindowVar(v,"windowrowval"_v,,4)
}
windowRow(v) public {
	Set partref = $$windowPartRef(v)
	Return $$wsubv($$windowRowVar(v),partref)
}
windowRowSlot(v,idx) public {
	Return $$wsubv($$windowRow(v),idx)
}	
.
#; A $list of the values for the `partition by` part of the window frame
windowPartVals(v) [ mt ] public {
	Set partv = $p($$$mtV(v),"^",4)
	Set part = $$$mtV(partv)
	Set partvals = ""
	For i=4:1 {
		Set partn = $p(part,"^",i) QUIT:'partn
		Set partvals = partvals _ $lb(partn)
	}
	Return partvals
}
.
#; A code string list (,) of the `partition by` part of the window frame
windowPartRef(v) [ mt ] public {
	Set partvals = $$windowPartVals(v)
	Set partref = ""
	For i=1:1:$ll(partvals) {
		Set partn = $li(partvals,i)
		Set partref = partref _ $$tomark($$ptvalue(partn)) _","
	}
	Set partref = $e(partref,1,*-1) //remove ","
	Return partref
}
.
#; A $list of the values for the `order by` part of the window frame
windowOrderVals(v) [ mt ] public {
	Set orderv = $p($$$mtV(v),"^",5)
	Set order = $$$mtV(orderv)
	Set ordervals = ""
	For i=4:2 {
		Set ordern = $p(order,"^",i) QUIT:'ordern
		Set ordervals = ordervals _ $lb(ordern)
	}
	Return ordervals
}
.
#; A $list of the direction values for the `order by` part of the window frame
windowOrderDirVals(v) [ mt ] public {
	Set orderv = $p($$$mtV(v),"^",5)
	Set order = $$$mtV(orderv)
	Set orderdirvals = ""
	For i=5:2 {
		Set ordern = $p(order,"^",i) QUIT:'ordern
		Set orderdirvals = orderdirvals _ $lb(ordern)
	}
	Return orderdirvals
}
.
#; A code string list (,) of the `order by` part of the window frame
windowOrderRef(v) [ mt ] public {
	Set ordervals = $$windowOrderVals(v)
	Set orderref = ""
	For i=1:1:$ll(ordervals) {
		Set ordern = $li(ordervals,i)
		Set orderref = orderref _ $$tomark($$ptvalue(ordern)) _","
	}
	Set orderref = $e(orderref,1,*-1) //remove ","
	//We want the root of a partition ref for metadata
	If orderref = "" Set orderref = "$c(0)"
	Return orderref
}
.
#; The directions ("a"/"d") for the `order by` part of the window frame
#; as a string (one character per `order by` entry, in order)
windowOrderDirs(v) [ mt ] public {
	Set orderdirvals = $$windowOrderDirVals(v)
	Set orderdirs = ""
	For i=1:1:$ll(orderdirvals) {
		Set ordern = $li(orderdirvals,i) QUIT:'ordern
		Set orderdirs = orderdirs _ $p($$$mtV(ordern),"^",2) //must be a or d
	}
	Return orderdirs
}
.
#; A code string (variable or local array reference) for the entry slot in
#; the scratch space
windowEntryRef(v) [ mt ] public {
	Set partref = $$windowPartRef(v)
	Set orderref = $$windowOrderRef(v)
	Set entryref = $s(partref'="":partref_",",1:"")_orderref
	Return entryref
}
.
#; Return true if a window function can be found recursively in v
findWindowFunction(v) [ mt, call, found ] public {
	New call, found
	Set call = "lvFindWindowFunction^%qaqcpr"
	Set found = 0
	Do lviter^%qaqpnl("v",v)
	RETURN found
}
.
#; lviter visitor for findWindowFunction
lvFindWindowFunction
	RETURN:ev'="v"
	If $p($p(v,"^",2),":",1)="%WINDOW_FUNCTION" Set found = 1 RETURN
	GOTO lviterarg^%qaqpnl
	
.
#; Utility codegen function to iterate through the N order-by entry levels of a
#; window function v scratch partition in the appropriate a/d mode.
#; At the final level, the entry value is in "nodevar" if defined, and
#; nodecode is executed
#; reference for tracking additional values
scanWindowPartition(v, ref, orderdirs, nodevar="", nodecode, postcode) public {
	If $l(orderdirs) = 0 {
		//$c(0) special case for no ORDER BY, no looping
		Set orderref = $$windowOrderRef(v)
		If orderref="$c(0)" {
			Set ref = $$wsubv(ref,"$c(0)")
			if nodevar'="" $$$liin("Set "_nodevar_"=$g("_ref_")")
		}
		For i=1:1:+$g(nodecode) {
			$$$liin(nodecode(i))
		}
		For i=1:1:+$g(postcode) {
			$$$liin(postcode(i))
		}
		QUIT
	}
	Set keyvar = $$$getVarName("scanWindowPartitionKey_"_v_"-"_$l(orderdirs))
	//Add keyvar as a subscript to slot
	If $e(ref,*)=")" {
		Set ref = $e(ref,1,*-1)_","_keyvar_")"
	}
	Else {
		Set ref = ref_"("_keyvar_")"
	}
	$$$liin("Set "_keyvar_"=""""")
	$$$liin("For {")
	$$$liin(" Set "_keyvar_"=$o("_ref_","_$s($e(orderdirs,1)="a":1,1:-1)_$s($l(nodevar):","_nodevar,1:"")_") QUIT:"_keyvar_"=""""")
	Do scanWindowPartition(v, ref, $e(orderdirs,2,*), nodevar, .nodecode) //note we drop postcode, only generate after the outer loop
	$$$liin("}")
	For i=1:1:+$g(postcode) {
		$$$liin(postcode(i))
	}
	
}
getPartitionRef(v, ref, orderdirs) public {
	If $l(orderdirs) = 0 {
		RETURN $s($$windowOrderRef(v)="$c(0)":$$wsubv(ref,"$c(0)"),1:ref)
	}
	Set keyvar = $$$getVarName("scanWindowPartitionKey_"_v_"-"_$l(orderdirs))
	If $e(ref,*)=")" {
		Set ref = $e(ref,1,*-1)_","_keyvar_")"
	} else {
		Set ref = ref_"("_keyvar_")"
	}
	RETURN $$getPartitionRef(v, ref, $e(orderdirs,2,*))
}
.
#; Returns a sub-value reference under "ref"
wsubv(ref, sub) public {
	If sub="" RETURN ref
	If $e(ref,*) = ")" {
		Set refOpen = $e(ref,1,*-1)
		RETURN refOpen_","_sub_")"
	}
	Else {
		return ref_"("_sub_")"
	}
}
.
#; Is a window frame null-no extent?
windowFrameNull(v) [ mt ] public {
	Set val = $$$mtV(v)
	Set op = $p(val,"^",2)
	Set fmode = $p(op,":",3)
	//No frame at all?
	If fmode = "" RETURN 0
	//get constant bounds +/- rows, 0=current row, "<"=unbounded preceding, ">" unbounded following
	//n.b.: window frames are symmetrical
	Set fbegin = $$windowFrameBegin(v)
	Set fend = $$windowFrameEnd(v)
	If fbegin="<",fend="<" RETURN 1
	If fend=">",fbegin=">" RETURN 1
	RETURN 0
}
.
#; Is a window frame unbounded across all rows in the partition?
windowFrameUnbounded(v) [ mt ] public {
	Set val = $$$mtV(v)
	Set op = $p(val,"^",2)
	Set fmode = $p(op,":",3)
	//No frame at all?
	If fmode = "" RETURN 0
	//get constant bounds +/- rows, 0=current row, "<"=unbounded preceding, ">" unbounded following
	//n.b.: window frames are symmetrical
	Set fbegin = $$windowFrameBegin(v)
	Set fend = $$windowFrameEnd(v)
	If fbegin="<",fend=">" RETURN 1
	RETURN 0
}
.
#; Is there a ROWS window frame?
windowFrameRows(v) [ mt ] public {
	Set val = $$$mtV(v)
	Set op = $p(val,"^",2)
	Set fmode = $p(op,":",3)
	RETURN fmode = "ROWS"
}
.
#; Width of a fixed window frame
windowFrameRowsWidth(v) [ mt ] public {
	Set val = $$$mtV(v)
	Set op = $p(val,"^",2)
	Set fmode = $p(op,":",3)
	//No frame at all?
	If fmode = "" RETURN 0
	//get constant bounds +/- rows, 0=current row, "<"=unbounded preceding, ">" unbounded following
	//n.b.: window frames are symmetrical
	Set fbegin = $$windowFrameBegin(v)
	Set fend = $$windowFrameEnd(v)
	If fbegin="<" RETURN "<"
	If fend=">" RETURN ">"
	Set width = fend - fbegin + 1 //+1 including current row, exclusion TODO
	RETURN width
}
.
#; Offset of a fixed window frame: if side = r: From current row to bottom of frame, else From top of frame to current row
#; TODO: This is an unclear concept, used only from sum(), rationalize
windowFrameRowsOffset(v,side="r") [ mt ] public {
	Set val = $$$mtV(v)
	Set op = $p(val,"^",2)
	Set fmode = $p(op,":",3)
	//No frame at all?
	If fmode = "" RETURN 0
	If side="r" {
		Set fend = $$windowFrameEnd(v)
		If fend = ">" RETURN $$windowFrameBegin(v)
		RETURN fend
	} else{
		Set fbegin = $$windowFrameBegin(v)
		If fbegin="<" RETURN $$windowFrameEnd(v)
		RETURN fbegin
	}
}
.
windowFrameBegin(v) [ mt ] public {
	Set val = $$$mtV(v)
	//must be constant t^
	Set b1 = $p($$$mtV($p(val,"^",6)),"^",2)
	Set b2 = $p($$$mtV($p(val,"^",7)),"^",2)
	//TODO: Should the parser set this "current row" default?
	If b1 = "" Set b1 = 0
	If b2 = "" Set b2 = 0
	If b1 = "<" RETURN b1
	If b2 = ">" RETURN b1
	If b1 = ">" RETURN b2
	If b2 = "<" RETURN b2
	If b1 < b2 RETURN b1
	RETURN b2
}
.
windowFrameEnd(v) [ mt ] public {
	Set val = $$$mtV(v)
	//must be constant t^
	Set b1 = $p($$$mtV($p(val,"^",6)),"^",2)
	Set b2 = $p($$$mtV($p(val,"^",7)),"^",2)
	If b1 = "<" RETURN b2
	If b2 = ">" RETURN b2
	If b1 = ">" RETURN b1
	If b2 = "<" RETURN b1
	If b1 < b2 RETURN b2
	RETURN b1
}
.
#; Backward looking row numbers can be produced just by keeping
#; a counter of the # of rows per partition we've seen.
rowNumberBackward(v) public  {
	//Use slot as a live count of rows seen for the partition
	RETURN "$i("_$$windowSlot(v)_")"
}
.
#; Forward looking row numbers need to track the # of rows seen
#; for each entry in a partition
rowNumberForwardScan(v) public {
	//aggregate a count of every combination
	RETURN "$i("_$$windowEntry(v)_")"
}
.
#; To produce forward looking row number results, we sum the # of
#; rows for each set of the same entry values, and maintain that sum
#; and a running sum of all entries (in order) in the partition.
#; The row number is the running sum minus a burn-down counter
#; of rows seen in that entry so far.
rowNumberForwardOutput(v) public { 
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set orderdirs = $$windowOrderDirs(v)
	///Mark partition as scanned by setting slot = 1
	$$$liin("If $g("_slot_")="""" {")
	Set trowsvar = $$$getVarName("trows"_v)
	Set nrowsvar = $$$getVarName("nrows"_v)
	$$$liin(" Set "_trowsvar_"=0")
	//count for the values sharing an entry
	Set partitionref = $$getPartitionRef(v, slot, orderdirs)
	Set nodecode($i(nodecode)) = "Set "_partitionref_"=$i("_trowsvar_","_nrowsvar_")"
	//count for the iterator as we read
	Set nodecode($i(nodecode)) = "Do $i("_$$wsubv(partitionref,1)_","_nrowsvar_")"
	Do scanWindowPartition(v, slot, orderdirs, nrowsvar, .nodecode)
	$$$liin(" Set "_slot_"="_1)
	$$$liin("}")
	RETURN "("_entry_"-$i("_$$wsubv(entry,1)_",-1))"
}
.
.
#; count() is just a sum of 1's (always for count(*)) or 0's (if value is null))
countForwardScan(v) [ mt ] public {
	Set val = $p($$$mtV(v),"^",8)
	Set expr = $s('val:1 /* count(*) */,1:"("_$$ptvalue(val)_"'="""")")
	RETURN $$sumValForwardScan(v,expr,1)
}
.
countForwardOutput(v) public {
	RETURN $$sumForwardOutput(v,0)
}
.
#; A backward-looking first value needs only to store the first value
#; it sees for a given partition
firstValueBackward(v) [ mt ] public  {
	Set slot = $$windowSlot(v)
	//Use slot to record first value seen
	
	Set valvar = $$ptvalue($p($$$mtV(v),"^",8))
.
	If $$windowFrameRows(v),$$windowFrameBegin(v)<=0,$$windowFrameBegin(v)'="<"{
		Set counter = $$wsubv(slot,"""cnt""")	
		Set slotRef = $$wsubv(slot,"$i("_counter_")")
		Set slotFirstRef = $$wsubv(slot,"1")
		Set offset = $$windowFrameRowsOffset(v,"l")
		Set end = $$windowFrameEnd(v)
		set endLimit = ",1:"_slotFirstRef_")"
		if end<0 {
			set endLimit = ","_counter_"+"_end_">=1:"_slotFirstRef_",1:"_$$colnul($p($$$mtV(v),"^",8))_")"
		}
		Set slotRefRef = "$s($d("_$$wsubv(slot,counter_"+"_offset)_"):"_$$wsubv(slot,counter_"+"_offset)_endLimit
		$$$liin(" Set "_slotRef_"="_valvar)
		RETURN slotRefRef
	} else {
		$$$liin(" Set:'$d("_slot_") "_slot_"="_valvar)
		RETURN slot
	}
}
.
#; A forward looking first value keeps a "champion" value & list of order values
#; for each partition, comparing it based on the frame "order by" with new values
firstValueForwardScan(v) [ mt ] public {
	If $$windowFrameNull(v) {
		RETURN $$colnul($p($$$mtV(v),"^",8))
	}
	Set slot = $$windowSlot(v)
	Set val = $$ptvalue($p($$$mtV(v),"^",8))
	//"Interesting" rows case with a fixed # of preceding rows which
	//determines the first value. Uninteresting cases are equivalent to
	//no ROWS
	//TODO: the special case of windowFrameBegin = CURRENT_ROW, which
	//is a backward window function!
	If $$windowFrameRows(v),'$$windowFrameUnbounded(v),$$windowFrameBegin(v)'="<" {
		//Must keep track of all values, sorted
		Set entry = $$windowEntry(v)
		Set counter = slot
		RETURN val_","_$$wsubv(entry,"$i("_counter_")")_"="_val
	}
	Set orderref = $$windowOrderRef(v)
	Set orderdirs = $$windowOrderDirs(v)
	Set ordervals = $$windowOrderVals(v)
	Set slotFirstList = $$wsubv(slot,1)
	Set slotValue = $$wsubv(slot,2)
	Set assignNew = $$$getVarName("assignNew"_v)
	Set firstItem = $$$getVarName("firstitem"_v)
	Set newItem = $$$getVarName("newitem"_v)
	$$$liin("Set "_assignNew_"=0")
	$$$liin("If $d("_slotFirstList_") {")
	$$$liin(" Do {")
	For i=1:1:$l(orderdirs) {
		$$$liin("  Set "_firstItem_"=$li("_slotFirstList_","_i_")")
		$$$liin("  Set "_newItem_"="_$$ptvalue($li(ordervals,i)))
		If $e(orderdirs,i) = "a" {
			$$$liin("  If "_firstItem_"]]"_newItem_" { Set "_assignNew_"=1 Quit }")
		}
		Else {
			$$$liin("  If "_newItem_"]]"_firstItem_" { Set "_assignNew_"=1 Quit }")
		}
		$$$liin("  Quit:"_firstItem_"'="_newItem)
	}
	$$$liin(" } While 0")
	$$$liin("}")
	$$$liin("Else {")
	$$$liin(" Set "_assignNew_"=1")
	$$$liin("}")
	$$$liin("If "_assignNew_" {")
	$$$liin(" Set "_slotValue_"="_val)
	$$$liin(" Set "_slotFirstList_"=$lb("_orderref_")")
	$$$liin("}")
	//TODO: windowFunction() should interpret "" as "no meaningful value" and skip the pti() assignment
	RETURN "0"
}
.
#; Returning the first value for a partition is just returning the final "champion" value
firstValueForwardOutput(v) [mt] public {
	set nullV = $$colnul($p($$$mtV(v),"^",8))
	If $$windowFrameNull(v) {
		RETURN nullV
	}
	Set slot = $$windowSlot(v)
	If $$windowFrameRows(v),'$$windowFrameUnbounded(v),$$windowFrameBegin(v)'="<" {
		Set fid = $$$getVarName("fid"_v)
		Set counter = $$$getVarName("counter"_v)
		Set erefs = $$getWindowVar(v,"erefs"_v,1,4)
		Set eref = $$wsubv(erefs,"$i("_erefs_")")
		Set eidx = $$$getVarName("eidx"_v)
		Set rval = $$$getVarName("rval"_v)
		Set resultref = $$windowRowSlot(v,fid)
		Set orderdirs = $$windowOrderDirs(v)
		Set partitionref = $$getPartitionRef(v, slot, orderdirs)
		$$$liin("If $g("_slot_")'=$c(0) {")
		$$$liin(" Set "_slot_"=$c(0),"_fid_"=0")
		Set nodecode($i(nodecode)) = "Set "_eidx_"=0,"_counter_"="""" Kill "_erefs
		Set nodecode($i(nodecode)) = "For  {"
		Set nodecode($i(nodecode)) = " Set "_counter_"=$o("_$$wsubv(partitionref,counter)_",1,"_rval_") QUIT:"_counter_"="""""
		Set nodecode($i(nodecode)) = " Set "_fid_"="_fid_"+1"
		Set nodecode($i(nodecode)) = " Set "_resultref_"="_rval
		Set nodecode($i(nodecode)) = " Set "_eref_"="_fid
		Set nodecode($i(nodecode)) = "}"
		Set nodecode($i(nodecode)) = "Kill "_partitionref_" Merge "_partitionref_"="_erefs_" Set "_partitionref_"=0"
		Set evar = $$$getVarName("entry"_v)
		Do scanWindowPartition(v, slot, orderdirs, evar, .nodecode)
		$$$liin("}")
		Set entry = $$windowEntry(v)
		#; result is the first value in the rows frame...
		Set offset = $$windowFrameBegin(v)
		Set end = $$windowFrameEnd(v)
		Set resultidx = $$$getVarName("resultidx"_v)
		Set endlimit = ""
		If +end=end,end<0 {
			Set endlimit = "&&("_resultidx_$s(offset:"-"_offset,1:"")_"+"_end_">=1)"
			// we can pick the first one iff the first one is in this frame, an example query can be
			//SELECT AGE , GENDER , id , FIRST_VALUE (id) OVER ( PARTITION BY AGE ORDER BY GENDER,id ROWS BETWEEN 6 preceding AND 2 preceding) FROM PERSON ORDER BY AGE , GENDER,id
		}
		$$$liin("Set "_resultidx_"="_$$wsubv(entry,"$i("_entry_")")_$s(offset:"+"_offset,1:""))
		#; ...unless it's before the first row, in which case it is the first row value
		#; or after the last row, in which case it's null  (sqlite behavior, at least)
		Set result = "$g("_$$windowRowSlot(v,"$s(("_resultidx_"<1)"_endlimit_":1,1:"_resultidx_")")_","_nullV_")"
		RETURN result
	}
	Set slotValue = $$wsubv(slot,2)
	RETURN slotValue
}
.
#; The forward sum function maintains a sum of all operand values for a
#; particular set of entry values
sumForwardScan(v) [ mt ] public {
	RETURN $$sumValForwardScan(v, $$ptvalue($p($$$mtV(v),"^",8)))
}
.
#; The forward sum function maintains a sum of all operand values for a
#; particular set of entry values (generalized to an arbitrary val for count())
sumValForwardScan(v, val, isCount=0) [ mt ] public {
	// count(*) $p(8) is ""
	set nullV = $s($p($$$mtV(v),"^",8)'="":$$colnul($p($$$mtV(v),"^",8)),1:"""""")
	If $$windowFrameNull(v) {
		RETURN nullV
	}
	If $$windowFrameUnbounded(v) {
		//For unbounded frames, just add up all the values in subv 1
		RETURN:isCount "$i("_$$wsubv($$windowSlot(v),1)_","_val_")"	
		
		// need to take care of null value since k a zw $i(a,"")=0 but SUM(NULL)=NULL
		$$$liin("s "_$$wsubv($$windowSlot(v),1)_"=$s("_val_"'="_nullV_":$i("_$$wsubv($$windowSlot(v),1)_","_val_"),1:$g("_$$wsubv($$windowSlot(v),1)_"))")
		RETURN $$wsubv($$windowSlot(v),1)
	}
	If $$windowFrameRows(v) {
		Set counter = $$windowSlot(v)
		RETURN:isCount "$i("_$$wsubv($$windowEntry(v),"$i("_counter_")")_","_val_")"
.
		$$$liin("s "_$$wsubv($$windowEntry(v),"$i("_counter_")")_"=$s("_val_"'="_nullV_":"_val_",1:"""")")
		RETURN $$wsubv($$windowEntry(v),counter)
	}
	RETURN:isCount "$i("_$$windowEntry(v)_","_val_")"
	$$$liin("s "_$$windowEntry(v)_"=$s("_val_"'="_nullV_":$i("_$$windowEntry(v)_","_val_"),1:$g("_$$windowEntry(v)_"))")
	RETURN $$windowEntry(v)
}
.
.
#; For output, entry sums are accumulated in order and the sum
#; for the given entry returned.
sumForwardOutput(v,nullV="""""") [mt] public {
	set isCount = (nullV=0)
	set initTvar=$s(isCount:0,1:"""""") // if this is for count, initial tvar should be 0, else should be ""
	//Null frame return null
	set:nullV="""""" nullV = $$colnul($p($$$mtV(v),"^",8))
	If $$windowFrameNull(v) {
		RETURN nullV
	}
	//Unbounded sums were collected during the forward scan in subv 1
	If $$windowFrameUnbounded(v) {
		RETURN $$wsubv($$windowSlot(v),1) 
	}
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set orderdirs = $$windowOrderDirs(v)
	Set partitionref = $$getPartitionRef(v, slot, orderdirs)
	///Mark partition as scanned by setting slot = $c(0)
	$$$liin("If $g("_slot_")'=$c(0) {")
	Set evar = $$$getVarName("entry"_v)
	//For a fixed window, an entry's value will represent the sum of the
	//frame for which it is the last row, i.e. the frame of width <frame-width>
	//ending at this row.
	If $$windowFrameRows(v) {
		Set tvar = $$$getVarName("total"_v)
		Set fid = $$$getVarName("fid"_v)
		Set resultref = $$windowRowSlot(v,fid)
		Set rowvals = $$getWindowVar(v,"rowvals"_v,2,2)
		Set rowvalref = $$wsubv(rowvals,fid)
		Set trail = $$$getVarName("trail"_v)
		Set counter = $$$getVarName("counter"_v)
		Set rval = $$$getVarName("rval"_v)
		Set erefs = $$$getVarName("erefs"_v)
		Set eref = $$wsubv(erefs,"$i("_erefs_")")
		Set eidx = $$$getVarName("eidx"_v)
		Set entryref = $$wsubv(partitionref,"$i("_eidx_")")
		Set width = $$windowFrameRowsWidth(v)
		Set backrval = "$g("_$$wsubv(rowvals,fid_"-"_width)_")"
		Set dir = $s($$windowFrameEnd(v)=">":-1,1:1)
		If dir = -1 Set orderdirs = $tr(orderdirs,"ad","da")
		Set offset = $$windowFrameRowsOffset(v) * dir
		//For an unbounded following frame we have to sum "backwards"
		$$$liin(" Set "_slot_"=$c(0),"_fid_"=0,"_tvar_"="_initTvar_" Kill "_rowvals)
		If width&&('isCount) {
			Set nnCnt = $$getWindowVar(v,"nnCnt"_v,1,4)	// not null count arr
			Set nnCntRef = $$wsubv(nnCnt,fid)
			Set nnCntLastRef = "$g("_$$wsubv(nnCnt,fid_"-1")_")"
			Set nnCntBackRef = "$g("_$$wsubv(nnCnt,fid_"-"_width)_")"
			$$$liin(" Kill "_nnCnt)
		}
		Set nodecode($i(nodecode)) = "Set "_eidx_"=0,"_counter_"="""" Kill "_erefs
		Set nodecode($i(nodecode)) = "For  {"
		Set nodecode($i(nodecode)) = " Set "_counter_"=$o("_$$wsubv(partitionref,counter)_","_dir_","_rval_") QUIT:"_counter_"="""""
		Set nodecode($i(nodecode)) = " Set "_fid_"="_fid_"+1"
		Set nodecode($i(nodecode)) = " Set "_rowvalref_"="_rval
		Set nodecode($i(nodecode)) = " Set "_resultref_"="_tvar
		Set nodecode($i(nodecode)) = $s('isCount:" If "_rval_"'="_nullV_" {",1:"")_" Set "_resultref_"="_resultref_"+"_rval_","_tvar_"="_tvar_"+"_rval_$s('isCount:" }",1:"")
		If width {
			Set:'isCount nodecode($i(nodecode)) = " Set "_nnCntRef_"="_nnCntLastRef_"+("_rval_"'="_nullV_")"
			Set nodecode($i(nodecode)) = " If "_backrval_"'="""" { Set "_resultref_"="_resultref_"-"_backrval_","_tvar_"="_tvar_"-"_backrval_" }"
			Set:'isCount nodecode($i(nodecode)) = " If ("_tvar_"=0)&&("_nnCntRef_"="_nnCntBackRef_") { Set "_resultref_"="_initTvar_", "_tvar_"="_initTvar_" }"
		}
		Set nodecode($i(nodecode)) = " Set "_eref_"="_fid
		Set nodecode($i(nodecode)) = "}"
		if dir = -1 {
			// we need to reverse the value in erefs arr, since we change the direction of reading windowvals array, otherwise the result is in reversed order
			// SELECT Age, Gender, FavoriteNum, SUM/MIN/MAX( FavoriteNum ) OVER ( PARTITION BY Age ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING ) Result FROM %NOPARALLEL Sample.Person ORDER BY Age, id DESC
			Set revErefs = $$getWindowVar(v,"revErefs"_v,1,4)
			Set revEref = $$wsubv(revErefs,"$i("_revErefs_")")
			Set nodecode($i(nodecode)) = "Kill "_revErefs_" For "_counter_"="_erefs_":-1:1{"
			Set nodecode($i(nodecode)) = $c(9)_"Set "_revEref_"="_$$wsubv(erefs,counter)
			Set nodecode($i(nodecode)) = "}"
			Set nodecode($i(nodecode)) = "Kill "_partitionref_" Merge "_partitionref_"="_revErefs_" Set "_partitionref_"=0"
		} else{
			Set nodecode($i(nodecode)) = "Kill "_partitionref_" Merge "_partitionref_"="_erefs_" Set "_partitionref_"=0"
		}
		
		If offset>0 {
			Set postcode($i(postcode)) = "For "_trail_"=1:1:"_offset_" {"
			Set postcode($i(postcode)) = " Set "_fid_"="_fid_"+1"
			Set postcode($i(postcode)) = " Set "_resultref_"="_tvar
			If width {
				Set:'isCount postcode($i(postcode)) = " Set "_nnCntRef_"="_nnCntLastRef
				Set postcode($i(postcode)) = " If "_backrval_"'="""" { Set "_resultref_"="_resultref_"-"_backrval_","_tvar_"="_tvar_"-"_backrval_" }"
				Set:'isCount postcode($i(postcode)) = " If ("_tvar_"=0)&&("_nnCntRef_"="_nnCntBackRef_") { Set "_resultref_"="_initTvar_", "_tvar_"="_initTvar_" }"
				Set postcode($i(postcode)) = " If "_trail_">="_width_" { Set "_resultref_"="_initTvar_" }"
			}
.
			Set postcode($i(postcode)) = "}"
		}
		If offset<0 {
			Set postcode($i(postcode)) = "For "_trail_"=1:1:"_-offset_" {"
			Set postcode($i(postcode)) = " Set "_$$windowRowSlot(v,"1-"_trail)_"="_initTvar
			Set postcode($i(postcode)) = "}"	
		}
		
		Set result = $$windowRowSlot(v,$$wsubv(entry,"$i("_entry_")")_$s(offset:"+"_offset,1:""))
	}
	//Non-ROWS, keep the full entry-spanning total in each entry
	//(i.e., same ORDER BY value, same sum() value)
	Else {
		Set tvar = $$$getVarName("total"_v)
		Set result = entry
		$$$liin(" Set "_slot_"=$c(0),"_tvar_"="_initTvar)
		if isCount {
			Set nodecode($i(nodecode)) = "Set "_partitionref_"=$i("_tvar_","_evar_")"
		} else {
			Set nodecode($i(nodecode)) = "Set "_partitionref_"=$s("_evar_"="_nullV_":"_tvar_",1:$i("_tvar_","_evar_"))"
		}
	}
	Do scanWindowPartition(v, slot, orderdirs, evar, .nodecode, .postcode)
	$$$liin("}")
	RETURN result
}
.
#; Rank forward scan tracks the # of rows per entry
rankForwardScan(v) public {
	Set entry = $$windowEntry(v)
	RETURN "$i("_entry_")"
}
.
#; The output for rank scans a partition and assigns a rank value in order
rankForwardOutput(v) public {
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set orderdirs = $$windowOrderDirs(v)
	Set evar = $$$getVarName("entry"_v)
	Set partitionref = $$getPartitionRef(v, slot, orderdirs)
	$$$liin("If $g("_slot_")'=$c(0) {")
	Set rankvar = $$$getVarName("rank"_v)
	$$$liin(" Set "_rankvar_"=1")
	Set nodecode($i(nodecode)) = "Set "_partitionref_"="_rankvar_","_rankvar_"="_rankvar_"+"_evar
	Do scanWindowPartition(v, slot, orderdirs, evar, .nodecode)
	$$$liin(" Set "_slot_"=$c(0)" )
	$$$liin("}")
	RETURN entry
}
.
#; Rank forward scan tracks the # of rows per entry (not really needed for dense but doesn't hurt)
denseRankForwardScan(v) public {
	Set entry = $$windowEntry(v)
	RETURN "$i("_entry_")"
}
.
#; The output for rank scans a partition and assigns a dense rank value in order
denseRankForwardOutput(v) public {
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set orderdirs = $$windowOrderDirs(v)
	Set evar = $$$getVarName("entry"_v)
	Set partitionref = $$getPartitionRef(v, slot, orderdirs)
	$$$liin("If $g("_slot_")'=$c(0) {")
	Set rankvar = $$$getVarName("rank"_v)
	$$$liin(" Set "_rankvar_"=1")
	Set nodecode($i(nodecode)) = "Set "_partitionref_"="_rankvar_","_rankvar_"="_rankvar_"+1"
	Do scanWindowPartition(v, slot, orderdirs, evar, .nodecode)
	$$$liin(" Set "_slot_"=$c(0)" )
	$$$liin("}")
	RETURN entry
}
.
#; Percent rank forward scan tracks the # of rows per entry and the total # of
#; rows per partition
percentRankForwardScan(v) public {
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	RETURN "$i("_entry_")&&$i("_slot_")"
}
.
#; The output for percent rank scans a partition and assigns a rank value in order
#; then computes the percent for that rank for the given entry
percentRankForwardOutput(v) public {
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set orderdirs = $$windowOrderDirs(v)
	Set evar = $$$getVarName("entry"_v)
	Set partitionref = $$getPartitionRef(v, slot, orderdirs)
	$$$liin("If $g("_slot_")'=$c(0) {")
	Set rankvar = $$$getVarName("rank"_v)
	$$$liin(" Set "_rankvar_"=1")
	Set nodecode($i(nodecode)) = "Set "_partitionref_"=$s("_slot_"=1:0,1:("_rankvar_"-1)/("_slot_"-1)),"_rankvar_"="_rankvar_"+"_evar
	Do scanWindowPartition(v, slot, orderdirs, evar, .nodecode)
	$$$liin(" Set "_slot_"=$c(0)" )
	$$$liin("}")
	RETURN entry
}
.
#; forward scan tracks the # of rows per entry and total per slot
cumeDistForwardScan(v) public {
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	RETURN "$i("_entry_")&&$i("_slot_")"
}
.
#; The output for rank scans a partition and assigns a rank value in order
cumeDistForwardOutput(v) public {
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set orderdirs = $$windowOrderDirs(v)
	Set partitionref = $$getPartitionRef(v, slot, orderdirs)
	Set evar = $$$getVarName("entry"_v)
	$$$liin("If $g("_slot_")'=$c(0) {")
	Set countvar = $$$getVarName("count"_v)
	$$$liin(" Set "_countvar_"=0")
	Set nodecode($i(nodecode)) = "Set "_countvar_"="_countvar_"+"_evar_","_partitionref_"="_countvar_"/"_slot
	Do scanWindowPartition(v, slot, orderdirs, evar, .nodecode)
	$$$liin(" Set "_slot_"=$c(0)")
	$$$liin("}")
	RETURN entry
}
.
.
ntileForwardScan(v) public {
	//Must keep track of all values
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set counter = slot
	RETURN "$i("_$$wsubv(entry,"$i("_counter_")")_",1)"
}
.
ntileForwardOutput(v) [ mt ] public { 
	Set slot = $$windowSlot(v)
	Set fid = $$$getVarName("fid"_v)
	Set counter = $$$getVarName("counter"_v)
	Set ntile = $$$getVarName("ntile"_v)
	Set tilesize = $$$getVarName("tilesize"_v)
	Set tilecount = $$ptvalue($p($$$mtV(v),"^",8))
	Set tilemod = $$$getVarName("tilemod"_v)
	Set tilepos = $$$getVarName("tilepos"_v)
	Set erefs = $$getWindowVar(v,"erefs"_v,1,4)
	Set eref = $$wsubv(erefs,"$i("_erefs_")")
	Set eidx = $$$getVarName("eidx"_v)
	Set resultref = $$windowRowSlot(v,fid)
	Set orderdirs = $$windowOrderDirs(v)
	Set partitionref = $$getPartitionRef(v, slot, orderdirs)
	$$$liin("If $g("_slot_")'=$c(0) {")
	#; For as close to even n-tiling as possible, we set the base tile size at count\tiles and add one row to the the first count#tiles
	$$$liin(" Set "_fid_"=0,"_ntile_"=1,"_tilepos_"=0,"_tilemod_"="_slot_"#"_tilecount_","_tilesize_"="_slot_"\"_tilecount_"+$s("_tilemod_":1,1:0)")
	Set nodecode($i(nodecode)) = "Set "_eidx_"=0,"_counter_"="""" Kill "_erefs
	Set nodecode($i(nodecode)) = "For  {"
	Set nodecode($i(nodecode)) = " Set "_counter_"=$o("_$$wsubv(partitionref,counter)_") QUIT:"_counter_"="""""
	Set nodecode($i(nodecode)) = " Set "_fid_"="_fid_"+1,"_tilepos_"="_tilepos_"+1"
	Set nodecode($i(nodecode)) = " Set "_resultref_"="_ntile
	Set nodecode($i(nodecode)) = " If "_tilepos_"="_tilesize_" { Set "_ntile_"="_ntile_"+1,"_tilepos_"=0,"_tilesize_"="_slot_"\"_tilecount_"+$s($i("_tilemod_",-1)>0:1,1:0) }"
	Set nodecode($i(nodecode)) = " Set "_eref_"="_fid
	Set nodecode($i(nodecode)) = "}"
	Set nodecode($i(nodecode)) = "Kill "_partitionref_" Merge "_partitionref_"="_erefs_" Set "_partitionref_"=0"
	Do scanWindowPartition(v, slot, orderdirs,, .nodecode)
	$$$liin(" Set "_slot_"=$c(0)")
	$$$liin("}")
	Set entry = $$windowEntry(v)
	#; ...unless it's before the first row, in which case it is the first row value
	#; or after the last row, in which case it's null  (sqlite behavior, at least)
	RETURN $$windowRowSlot(v,$$wsubv(entry,"$i("_entry_")"))
	RETURN result
}
.
minForwardScan(v) [ mt ] public {
	set val = $$ptvalue($p($$$mtV(v),"^",8))
	set nullV = $$colnul($p($$$mtV(v),"^",8))
	If $$windowFrameNull(v) {
		RETURN nullV
	}
	If $$windowFrameUnbounded(v) {
		//For unbounded frames, just add up all the values in subv 1
		$$$liin("s "_$$wsubv($$windowSlot(v),1)_"=$s('$d("_$$wsubv($$windowSlot(v),1)_"):"_val_","_val_"="_nullV_":"_$$wsubv($$windowSlot(v),1)_","_$$wsubv($$windowSlot(v),1)_"="_nullV_":"_val_","_$$wsubv($$windowSlot(v),1)_"]]"_val_":"_val_",1:"_$$wsubv($$windowSlot(v),1)_")")
		RETURN $$wsubv($$windowSlot(v),1)
	}
	If $$windowFrameRows(v) {
		Set counter = $$windowSlot(v)
		$$$liin("s "_$$wsubv($$windowEntry(v),"$i("_counter_")")_"="_val)
		RETURN $$wsubv($$windowEntry(v),counter)
	}
	// if no rows, keep track of the min in this slot order by entry (if no order by, entry would be $c(0))
	$$$liin("s "_$$windowEntry(v)_"=$s('$d("_$$windowEntry(v)_"):"_val_","_val_"="_nullV_":"_$$windowEntry(v)_","_$$windowEntry(v)_"="_nullV_":"_val_","_$$windowEntry(v)_"]]"_val_":"_val_",1:"_$$windowEntry(v)_")")
	RETURN $$windowEntry(v)
}
.
#; min(i) = min (rightMin[i], leftMin[i+w-1])
#; i = entry + left offset
minForwardOutput(v) [ mt ] public {
	//Null frame return null
	set nullV = $$colnul($p($$$mtV(v),"^",8))
	If $$windowFrameNull(v) {
		RETURN nullV
	}
	//Unbounded sums were collected during the forward scan in subv 1
	If $$windowFrameUnbounded(v) {
		RETURN $$wsubv($$windowSlot(v),1) 
	}
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set orderdirs = $$windowOrderDirs(v)
	///Mark partition as scanned by setting slot = $c(0)
	$$$liin("If $g("_slot_")'=$c(0) {")
	Set evar = $$$getVarName("entry"_v)
	Set partitionref = $$getPartitionRef(v, slot, orderdirs)
	If $$windowFrameRows(v) {
		Set fid = $$$getVarName("fid"_v)
		Set width = $$windowFrameRowsWidth(v)
		Set lastfid = $$$getVarName("lastfid"_v)
		Set leftMin = $$getWindowVar(v,"leftMin"_v,2,2)
		Set leftMinRef = $$wsubv(leftMin,fid)
		Set leftMinPrevRef = $$wsubv(leftMin,fid_"-1")
		Set leftMinLastRef = $$wsubv(leftMin,lastfid)
		Set leftMinResultRef = $$wsubv(leftMin,fid_"+"_width_"-1")
		Set rightMin = $$getWindowVar(v,"rightMin"_v,2,2)
		Set rightMinRef = $$wsubv(rightMin,fid)
		Set rightMinPrevRef = $$wsubv(rightMin,fid_"+1")
		
		Set resultref = $$windowRowSlot(v,fid)
		Set resultPrevRef = $$windowRowSlot(v,fid_"-1")
		Set rowvals = $$getWindowVar(v,"rowvals"_v,2,2)
		Set rowvalref = $$wsubv(rowvals,fid)
		Set counter = $$$getVarName("counter"_v)
		Set rval = $$$getVarName("rval"_v)
		Set erefs = $$getWindowVar(v,"erefs"_v,1,4)
		Set eref = $$wsubv(erefs,"$i("_erefs_")")
		Set dir = $s($$windowFrameEnd(v)=">":-1,1:1)
		If dir = -1 Set orderdirs = $tr(orderdirs,"ad","da")
		Set needGet = ($$windowFrameRowsOffset(v,"l")*$$windowFrameRowsOffset(v,"r")>0) // we only need $get if eg. rows between 6 preceding and 2 preceding OR rows between 1 following and 3 following
		Set offset = $$windowFrameRowsOffset(v,"l") * dir
		
		Set head = fid_"+1-"_width
		Set resultHeadRef = $$windowRowSlot(v,head)
		Set resultLastRef = $$windowRowSlot(v,lastfid)
		$$$liin(" Set "_lastfid_"="_slot_","_slot_"=$c(0),"_fid_"=0 "_$s(width>1:"Kill "_rowvals_","_leftMin_","_rightMin,1:""))
		Set nodecode($i(nodecode)) = "Set "_counter_"="""" Kill "_erefs
		Set nodecode($i(nodecode)) = "For  {"
		Set nodecode($i(nodecode)) = $c(9)_"Set "_counter_"=$o("_$$wsubv(partitionref,counter)_","_dir_","_rval_") QUIT:"_counter_"="""""
		Set nodecode($i(nodecode)) = $c(9)_"Set "_fid_"="_fid_"+1"
		if width>1{
			Set nodecode($i(nodecode)) = $c(9)_"Set "_rowvalref_"="_rval
			Set nodecode($i(nodecode)) = $c(9)_"Set "_leftMinRef_"=$s("_fid_"#"_width_"=1:"_rval_","_rval_"="_nullV_":"_leftMinPrevRef_","_leftMinPrevRef_"="_nullV_":"_rval_","_leftMinPrevRef_"]]"_rval_":"_rval_",1:"_leftMinPrevRef_")"
			Set nodecode($i(nodecode)) = $c(9)_"Set:("_head_"<1)&&(("_head_")>=(1+"_offset_")) "_resultHeadRef_"="_leftMinRef
		} elseif width = 1{
			Set nodecode($i(nodecode)) = $c(9)_"Set "_resultref_"="_rval
		} else{
			Set nodecode($i(nodecode)) = $c(9)_"Set "_resultref_"=$s("_fid_"=1:"_rval_","_rval_"="_nullV_":"_resultPrevRef_","_resultPrevRef_"="_nullV_":"_rval_","_resultPrevRef_"]]"_rval_":"_rval_",1:"_resultPrevRef_")"
		}
		Set nodecode($i(nodecode)) = $c(9)_"Set "_eref_"="_fid
		Set nodecode($i(nodecode)) = "}"
		if dir = -1 {
			// we need to reverse the value in erefs arr, since we change the direction of reading windowvals array, otherwise the result is in reversed order
			Set revErefs = $$getWindowVar(v,"revErefs"_v,1,4)
			Set revEref = $$wsubv(revErefs,"$i("_revErefs_")")
			Set nodecode($i(nodecode)) = "Kill "_revErefs_" For "_counter_"="_erefs_":-1:1{"
			Set nodecode($i(nodecode)) = $c(9)_"Set "_revEref_"="_$$wsubv(erefs,counter)
			Set nodecode($i(nodecode)) = "}"
			Set nodecode($i(nodecode)) = "Kill "_partitionref_" Merge "_partitionref_"="_revErefs_" Set "_partitionref_"=0"
		} else{
			Set nodecode($i(nodecode)) = "Kill "_partitionref_" Merge "_partitionref_"="_erefs_" Set "_partitionref_"=0"
		}
		
		if width>1{
			// there might be there are at most 5 elements in this partition, and width = 7 1 preceding and 5 following
			// so when we populate left min, we didn't populate resultref(0)
			Set postcode($i(postcode)) = "if "_head_"<0 {"
			Set postcode($i(postcode)) = $c(9)_"For "_fid_"=("_head_"+1):1:0 {"
			Set postcode($i(postcode)) = $c(9,9)_"Set "_resultref_"="_leftMinLastRef
			Set postcode($i(postcode)) = $c(9)_"}"
			Set postcode($i(postcode)) = "}"
			// Populate the leftMin for the rest of last bucket 
			// otherwise, w=3, from current row to 2 following, we have 19,15,7 || 3, the result of leftmin=19,15,7 || 3, right max= 7,7,7 || 3, 
			// based on the formula below, due to '$d(leftmin(5)), we will use rightmin(3)=7, which is wrong. 
			// the result should be min (rightmin(3)=7, leftmin(5)=3)
			Set postcode($i(postcode)) = "if ("_lastfid_"#"_width_") {"
			Set postcode($i(postcode)) = $c(9)_"For "_fid_"="_lastfid_":1:("_lastfid_"+"_width_"-("_lastfid_"#"_width_")) {"
			Set postcode($i(postcode)) = $c(9,9)_"Set "_leftMinRef_"="_leftMinLastRef
			Set postcode($i(postcode)) = $c(9)_"}"
			Set postcode($i(postcode)) = "}"
			Set postcode($i(postcode)) = "For "_fid_"="_lastfid_":-1:1 {"
			Set postcode($i(postcode)) = $c(9)_" Set "_rightMinRef_"=$s(("_fid_"#"_width_"=0)||("_fid_"="_lastfid_"):"_rowvalref_","_rowvalref_"="_nullV_":"_rightMinPrevRef_","_rightMinPrevRef_"="_nullV_":"_rowvalref_","_rightMinPrevRef_"]]"_rowvalref_":"_rowvalref_",1:"_rightMinPrevRef_")"
			Set postcode($i(postcode)) = $c(9)_" Set"_$s(offset<0:":"_fid_"<=("_lastfid_"+"_offset_") ",1:" ")_resultref_"=$s('$d("_leftMinResultRef_"):"_rightMinRef_","_rightMinRef_"="_nullV_":"_leftMinResultRef_","_leftMinResultRef_"="_nullV_":"_rightMinRef_","_leftMinResultRef_"]]"_rightMinRef_":"_rightMinRef_",1:"_leftMinResultRef_")"	
			Set postcode($i(postcode)) = "}"
		} elseif width = 1{
			Set postcode($i(postcode)) = "For "_fid_"=("_lastfid_"+1):1:"_lastfid_"+"_offset_" {"
			Set postcode($i(postcode)) = $c(9)_" Set "_resultref_"="_nullV
			Set postcode($i(postcode)) = "}"
		} else {
			Set postcode($i(postcode)) = "For "_fid_"=("_lastfid_"+1):1:"_lastfid_"+"_offset_" {"
			Set postcode($i(postcode)) = $c(9)_" Set "_resultref_"="_resultLastRef
			Set postcode($i(postcode)) = "}"
		}
		Set result = $s(needGet:"$g(",1:"")_$$windowRowSlot(v,$$wsubv(entry,"$i("_entry_")")_$s(offset:"+"_offset,1:""))_$s(needGet:","_nullV_")",1:"")
	}
	Else {
		Set minVar = $$$getVarName("min"_v)
		Set result = entry
		$$$liin(" Set "_slot_"=$c(0),"_minVar_"="_nullV_"")
		Set nodecode($i(nodecode)) = "Set "_minVar_"=$s("_minVar_"="_nullV_":"_evar_","_evar_"="_nullV_":"_minVar_","_minVar_"]]"_evar_":"_evar_",1:"_minVar_")"
		Set nodecode($i(nodecode)) = "Set "_partitionref_"="_minVar
	}
	Do scanWindowPartition(v, slot, orderdirs, evar, .nodecode, .postcode)
	$$$liin("}")
	RETURN result
}
.
maxForwardScan(v) [ mt ] public {
	set val = $$ptvalue($p($$$mtV(v),"^",8))
	set nullV = $$colnul($p($$$mtV(v),"^",8))
	If $$windowFrameNull(v) {
		RETURN nullV
	}
	If $$windowFrameUnbounded(v) {
		//For unbounded frames, just add up all the values in subv 1
		$$$liin("s "_$$wsubv($$windowSlot(v),1)_"=$s('$d("_$$wsubv($$windowSlot(v),1)_"):"_val_","_val_"="_nullV_":"_$$wsubv($$windowSlot(v),1)_","_$$wsubv($$windowSlot(v),1)_"="_nullV_":"_val_","_val_"]]"_$$wsubv($$windowSlot(v),1)_":"_val_",1:"_$$wsubv($$windowSlot(v),1)_")")
		RETURN $$wsubv($$windowSlot(v),1)
	}
	If $$windowFrameRows(v) {
		Set counter = $$windowSlot(v)
		$$$liin("s "_$$wsubv($$windowEntry(v),"$i("_counter_")")_"="_val)
		RETURN $$wsubv($$windowEntry(v),counter)
	}
	$$$liin("s "_$$windowEntry(v)_"=$s('$d("_$$windowEntry(v)_"):"_val_","_val_"="_nullV_":"_$$windowEntry(v)_","_$$windowEntry(v)_"="_nullV_":"_val_","_val_"]]"_$$windowEntry(v)_":"_val_",1:"_$$windowEntry(v)_")")
	RETURN $$windowEntry(v)
}
.
#; max(i) = max (rightMax[i], leftMax[i+w-1])
#; i = entry + left offset
maxForwardOutput(v) [ mt ] public {
	//Null frame return null
	set nullV = $$colnul($p($$$mtV(v),"^",8))
	If $$windowFrameNull(v) {
		RETURN nullV
	}
	//Unbounded sums were collected during the forward scan in subv 1
	If $$windowFrameUnbounded(v) {
		RETURN $$wsubv($$windowSlot(v),1) 
	}
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set orderdirs = $$windowOrderDirs(v)
	///Mark partition as scanned by setting slot = $c(0)
	$$$liin("If $g("_slot_")'=$c(0) {")
	Set evar = $$$getVarName("entry"_v)
	Set partitionref = $$getPartitionRef(v, slot, orderdirs)
	If $$windowFrameRows(v) {
		Set fid = $$$getVarName("fid"_v)
		Set width = $$windowFrameRowsWidth(v)
		Set lastfid = $$$getVarName("lastfid"_v)
		Set leftMax = $$getWindowVar(v,"leftMax"_v,2,2)
		Set leftMaxRef = $$wsubv(leftMax,fid)
		Set leftMaxPrevRef = $$wsubv(leftMax,fid_"-1")
		Set leftMaxLastRef = $$wsubv(leftMax,lastfid)
		Set leftMaxResultRef = $$wsubv(leftMax,fid_"+"_width_"-1")
		Set rightMax = $$getWindowVar(v,"rightMax"_v,2,2)
		Set rightMaxRef = $$wsubv(rightMax,fid)
		Set rightMaxPrevRef = $$wsubv(rightMax,fid_"+1")
		
		Set resultref = $$windowRowSlot(v,fid)
		Set resultPrevRef = $$windowRowSlot(v,fid_"-1")
		Set rowvals = $$getWindowVar(v,"rowvals"_v,2,2)
		Set rowvalref = $$wsubv(rowvals,fid)
		Set counter = $$$getVarName("counter"_v)
		Set rval = $$$getVarName("rval"_v)
		Set erefs = $$getWindowVar(v,"erefs"_v,1,4)
		Set eref = $$wsubv(erefs,"$i("_erefs_")")
		Set dir = $s($$windowFrameEnd(v)=">":-1,1:1)
		If dir = -1 Set orderdirs = $tr(orderdirs,"ad","da")
		Set needGet = ($$windowFrameRowsOffset(v,"l")*$$windowFrameRowsOffset(v,"r")>0) // we only need $get if eg. rows between 6 preceding and 2 preceding OR rows between 1 following and 3 following
		Set offset = $$windowFrameRowsOffset(v,"l") * dir
		
		Set head = fid_"+1-"_width
		Set resultHeadRef = $$windowRowSlot(v,head)
		Set resultLastRef = $$windowRowSlot(v,lastfid)
		$$$liin("Set "_lastfid_"="_slot_","_slot_"=$c(0),"_fid_"=0 "_$s(width>1:"Kill "_rowvals_","_leftMax_","_rightMax,1:""))
		Set nodecode($i(nodecode)) = "Set "_counter_"="""" Kill "_erefs
		Set nodecode($i(nodecode)) = "For  {"
		Set nodecode($i(nodecode)) = $c(9)_"Set "_counter_"=$o("_$$wsubv(partitionref,counter)_","_dir_","_rval_") QUIT:"_counter_"="""""
		Set nodecode($i(nodecode)) = $c(9)_"Set "_fid_"="_fid_"+1"
		if width>1{
			Set nodecode($i(nodecode)) = $c(9)_"Set "_rowvalref_"="_rval
			Set nodecode($i(nodecode)) = $c(9)_"Set "_leftMaxRef_"=$s("_fid_"#"_width_"=1:"_rval_","_rval_"="_nullV_":"_leftMaxPrevRef_","_leftMaxPrevRef_"="_nullV_":"_rval_","_rval_"]]"_leftMaxPrevRef_":"_rval_",1:"_leftMaxPrevRef_")"
			Set nodecode($i(nodecode)) = $c(9)_"Set:("_head_"<1)&&(("_head_")>=(1+"_offset_")) "_resultHeadRef_"="_leftMaxRef
		} elseif width = 1{
			Set nodecode($i(nodecode)) = $c(9)_"Set "_resultref_"="_rval
		} else{
			Set nodecode($i(nodecode)) = $c(9)_"Set "_resultref_"=$s("_fid_"=1:"_rval_","_rval_"="_nullV_":"_resultPrevRef_","_resultPrevRef_"="_nullV_":"_rval_","_rval_"]]"_resultPrevRef_":"_rval_",1:"_resultPrevRef_")"
		}
		Set nodecode($i(nodecode)) = $c(9)_"Set "_eref_"="_fid
		Set nodecode($i(nodecode)) = "}"
		
		if dir = -1 {
			// we need to reverse the value in erefs arr, since we change the direction of reading windowvals array, otherwise the result is in reversed order
			Set revErefs = $$getWindowVar(v,"revErefs"_v,1,4)	
			Set revEref = $$wsubv(revErefs,"$i("_revErefs_")")
			Set nodecode($i(nodecode)) = "Kill "_revErefs_" For "_counter_"="_erefs_":-1:1{"
			Set nodecode($i(nodecode)) = $c(9)_"Set "_revEref_"="_$$wsubv(erefs,counter)
			Set nodecode($i(nodecode)) = "}"
			Set nodecode($i(nodecode)) = "Kill "_partitionref_" Merge "_partitionref_"="_revErefs_" Set "_partitionref_"=0"
		} else{
			Set nodecode($i(nodecode)) = "Kill "_partitionref_" Merge "_partitionref_"="_erefs_" Set "_partitionref_"=0"
		}
		
		if width>1{
			// there might be there are at most 5 elements in this partition, and width = 7 1 preceding and 5 following
			// so when we populate left Max, we didn't populate resultref(0)
			Set postcode($i(postcode)) = "if "_head_"<0 {"
			Set postcode($i(postcode)) = $c(9)_"For "_fid_"=("_head_"+1):1:0 {"
			Set postcode($i(postcode)) = $c(9,9)_"Set "_resultref_"="_leftMaxLastRef
			Set postcode($i(postcode)) = $c(9)_"}"
			Set postcode($i(postcode)) = "}"
			// populate the leftMax for the rest of last bucket 
			// otherwise, w=3, from current row to 2 following, we have 3,7,15 || 19, the result of leftmax=3,7,15 || 19, right max= 15,15,15 || 19, 
			// based on the formula below, due to '$d(leftmax(5)), we will use rightmax(3)=15, which is wrong. 
			// the result should be max (rightmax(3)=15, leftmax(5)=19)
			Set postcode($i(postcode)) = "if ("_lastfid_"#"_width_") {"
			Set postcode($i(postcode)) = $c(9)_"For "_fid_"="_lastfid_":1:("_lastfid_"+"_width_"-("_lastfid_"#"_width_")) {"
			Set postcode($i(postcode)) = $c(9,9)_"Set "_leftMaxRef_"="_leftMaxLastRef
			Set postcode($i(postcode)) = $c(9)_"}"
			Set postcode($i(postcode)) = "}"
			Set postcode($i(postcode)) = "For "_fid_"="_lastfid_":-1:1 {"
			Set postcode($i(postcode)) = $c(9)_" Set "_rightMaxRef_"=$s(("_fid_"#"_width_"=0)||("_fid_"="_lastfid_"):"_rowvalref_","_rowvalref_"="_nullV_":"_rightMaxPrevRef_","_rightMaxPrevRef_"="_nullV_":"_rowvalref_","_rowvalref_"]]"_rightMaxPrevRef_":"_rowvalref_",1:"_rightMaxPrevRef_")"
			Set postcode($i(postcode)) = $c(9)_" Set"_$s(offset<0:":"_fid_"<=("_lastfid_"+"_offset_") ",1:" ")_resultref_"=$s('$d("_leftMaxResultRef_"):"_rightMaxRef_","_rightMaxRef_"="_nullV_":"_leftMaxResultRef_","_leftMaxResultRef_"="_nullV_":"_rightMaxRef_","_rightMaxRef_"]]"_leftMaxResultRef_":"_rightMaxRef_",1:"_leftMaxResultRef_")"
			Set postcode($i(postcode)) = "}"
		} elseif width = 1{
			Set postcode($i(postcode)) = "For "_fid_"=("_lastfid_"+1):1:"_lastfid_"+"_offset_" {"
			Set postcode($i(postcode)) = $c(9)_" Set "_resultref_"="_nullV
			Set postcode($i(postcode)) = "}"	
		}else {
			Set postcode($i(postcode)) = "For "_fid_"=("_lastfid_"+1):1:"_lastfid_"+"_offset_" {"
			Set postcode($i(postcode)) = $c(9)_" Set "_resultref_"="_resultLastRef
			Set postcode($i(postcode)) = "}"
		}
		Set result = $s(needGet:"$g(",1:"")_$$windowRowSlot(v,$$wsubv(entry,"$i("_entry_")")_$s(offset:"+"_offset,1:""))_$s(needGet:","_nullV_")",1:"")
	}
	Else {
		Set maxVar = $$$getVarName("max"_v)
		Set result = entry
		$$$liin(" Set "_slot_"=$c(0),"_maxVar_"="_nullV_"")
		Set nodecode($i(nodecode)) = "Set "_maxVar_"=$s("_maxVar_"="_nullV_":"_evar_","_evar_"="_nullV_":"_maxVar_","_evar_"]]"_maxVar_":"_evar_",1:"_maxVar_")"
		Set nodecode($i(nodecode)) = "Set "_partitionref_"="_maxVar
	}
	Do scanWindowPartition(v, slot, orderdirs, evar, .nodecode, .postcode)
	$$$liin("}")
	RETURN result
}
.
lagBackward(v) [ mt ] public  {
	Set valvar = $$ptvalue($p($$$mtV(v),"^",8))
	set nullV = $$colnul($p($$$mtV(v),"^",8))
	set lagOffset = $s($p($$$mtV(v),"^",9):$$ptvalue($p($$$mtV(v),"^",9)),1:1)
	set lagDefault = $s($p($$$mtV(v),"^",10):$$ptvalue($p($$$mtV(v),"^",10)),1:nullV)
	Set slot = $$windowSlot(v)
	Set counter = $$wsubv(slot,"""cnt""")
	Set slotRef = $$wsubv(slot,"$i("_counter_")")
	Set slotResRef = $$wsubv(slot,counter_"-"_lagOffset)
	//keep track of each value in this slot
	$$$liin("Set "_slotRef_"="_valvar)
	RETURN "$g("_slotResRef_","_lagDefault_")"
}
.
lagForwardScan(v) [ mt ] public {
	Set slot = $$windowSlot(v)
	Set val = $$ptvalue($p($$$mtV(v),"^",8))
	set nullV = $$colnul($p($$$mtV(v),"^",8))
	set lagOffset = $s($p($$$mtV(v),"^",9):$$ptvalue($p($$$mtV(v),"^",9)),1:1)
	set lagDefault = $s($p($$$mtV(v),"^",10):$$ptvalue($p($$$mtV(v),"^",10)),1:nullV)
	Set counter = $$windowSlot(v)
	$$$liin("s "_$$wsubv($$windowEntry(v),"$i("_counter_")")_"="_val)
	RETURN val
}
.
lagForwardOutput(v) [ mt ] public { 
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set fid = $$$getVarName("fid"_v)
	Set counter = $$$getVarName("counter"_v)
	set nullV = $$colnul($p($$$mtV(v),"^",8))
	set lagOffset = $s($p($$$mtV(v),"^",9):$$ptvalue($p($$$mtV(v),"^",9)),1:1)
	set lagDefault = $s($p($$$mtV(v),"^",10):$$ptvalue($p($$$mtV(v),"^",10)),1:nullV)
	Set rval = $$$getVarName("rval"_v)
	Set erefs = $$getWindowVar(v,"erefs"_v,1,4)
	Set eref = $$wsubv(erefs,"$i("_erefs_")")
	Set resultref = $$windowRowSlot(v,fid)
	Set orderdirs = $$windowOrderDirs(v)
	Set partitionref = $$getPartitionRef(v, slot, orderdirs)
	$$$liin("If $g("_slot_")'=$c(0) {")
	$$$liin(" Set "_slot_"=$c(0),"_fid_"=0 ")
	Set nodecode($i(nodecode)) = "Set "_counter_"="""" Kill "_erefs
	Set nodecode($i(nodecode)) = "For  {"
	Set nodecode($i(nodecode)) = $c(9)_"Set "_counter_"=$o("_$$wsubv(partitionref,counter)_",1,"_rval_") QUIT:"_counter_"="""""
	Set nodecode($i(nodecode)) = $c(9)_"Set "_fid_"="_fid_"+1"
	Set nodecode($i(nodecode)) = $c(9)_"Set "_resultref_"="_rval
	Set nodecode($i(nodecode)) = $c(9)_"Set "_eref_"="_fid
	Set nodecode($i(nodecode)) = "}"
	Set nodecode($i(nodecode)) = "Kill "_partitionref_" Merge "_partitionref_"="_erefs_" Set "_partitionref_"=0"
	
	Set postcode($i(postcode)) = "For "_fid_"=0:-1:"_"(1-"_lagOffset_") {"
	Set postcode($i(postcode)) = $c(9)_" Set "_resultref_"="_lagDefault
	Set postcode($i(postcode)) = "}"
	Do scanWindowPartition(v, slot, orderdirs,, .nodecode,.postcode)
	$$$liin("}")
	return $$windowRowSlot(v,$$wsubv(entry,"$i("_entry_")")_"-"_lagOffset)
}
leadForwardScan(v) [ mt ] public {
	Set slot = $$windowSlot(v)
	Set val = $$ptvalue($p($$$mtV(v),"^",8))
	set nullV = $$colnul($p($$$mtV(v),"^",8))
	set lagOffset = $s($p($$$mtV(v),"^",9):$$ptvalue($p($$$mtV(v),"^",9)),1:1)
	set lagDefault = $s($p($$$mtV(v),"^",10):$$ptvalue($p($$$mtV(v),"^",10)),1:nullV)
	Set counter = $$windowSlot(v)
	$$$liin("s "_$$wsubv($$windowEntry(v),"$i("_counter_")")_"="_val)
	RETURN val
}
leadForwardOutput(v) [ mt ] public { 
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set fid = $$$getVarName("fid"_v)
	Set lastfid = $$$getVarName("lastfid"_v)
	Set counter = $$$getVarName("counter"_v)
	set nullV = $$colnul($p($$$mtV(v),"^",8))
	set leadOffset = $s($p($$$mtV(v),"^",9):$$ptvalue($p($$$mtV(v),"^",9)),1:1)
	set leadDefault = $s($p($$$mtV(v),"^",10):$$ptvalue($p($$$mtV(v),"^",10)),1:nullV)
	Set rval = $$$getVarName("rval"_v)
	Set erefs = $$getWindowVar(v,"erefs"_v,1,4)
	Set eref = $$wsubv(erefs,"$i("_erefs_")")
	Set resultref = $$windowRowSlot(v,fid)
	Set orderdirs = $$windowOrderDirs(v)
	Set partitionref = $$getPartitionRef(v, slot, orderdirs)
	$$$liin("If $g("_slot_")'=$c(0) {")
	$$$liin(" Set "_slot_"=$c(0),"_fid_"=0 ")
	Set nodecode($i(nodecode)) = "Set "_counter_"="""" Kill "_erefs
	Set nodecode($i(nodecode)) = "For  {"
	Set nodecode($i(nodecode)) = $c(9)_"Set "_counter_"=$o("_$$wsubv(partitionref,counter)_",1,"_rval_") QUIT:"_counter_"="""""
	Set nodecode($i(nodecode)) = $c(9)_"Set "_fid_"="_fid_"+1"
	Set nodecode($i(nodecode)) = $c(9)_"Set "_resultref_"="_rval
	Set nodecode($i(nodecode)) = $c(9)_"Set "_eref_"="_fid
	Set nodecode($i(nodecode)) = "}"
	Set nodecode($i(nodecode)) = "Kill "_partitionref_" Merge "_partitionref_"="_erefs_" Set "_partitionref_"=0"
	
	Set postcode($i(postcode)) = "Set "_lastfid_"="_fid
	Set postcode($i(postcode)) = "For "_fid_"=("_lastfid_"+1):1:("_lastfid_"+"_leadOffset_") {"
	Set postcode($i(postcode)) = $c(9)_" Set "_resultref_"="_leadDefault
	Set postcode($i(postcode)) = "}"
	Do scanWindowPartition(v, slot, orderdirs,, .nodecode,.postcode)
	$$$liin("}")
	return $$windowRowSlot(v,$$wsubv(entry,"$i("_entry_")")_"+"_leadOffset)
}
nthValueForwardScan(v) [ mt ] public {
	If $$windowFrameNull(v) {
		RETURN $$colnul($p($$$mtV(v),"^",8))
	}
	Set val = $$ptvalue($p($$$mtV(v),"^",8))
	Set counter = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set entryRef = $$wsubv($$windowEntry(v),"$i("_counter_")")
	RETURN val_","_entryRef_"="_val
}
nthValueForwardOutput(v) [ mt ] public {
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set width = $$windowFrameRowsWidth(v)
	Set fid = $$$getVarName("fid"_v)
	Set counter = $$$getVarName("counter"_v)
	Set n = $$ptvalue($p($$$mtV(v),"^",9))
	
	Set rval = $$$getVarName("rval"_v)
	Set erefs = $$getWindowVar(v,"erefs"_v,1,4)
	Set eref = $$wsubv(erefs,"$i("_erefs_")")
	Set result = $$windowRowSlot(v,fid)
	Set resultref = $$windowRowSlot(v,fid)
	Set orderdirs = $$windowOrderDirs(v)
	Set partitionref = $$getPartitionRef(v, slot, orderdirs)
	
	Set lOffset = $$windowFrameRowsOffset(v,"l")
	Set rOffset = $$windowFrameRowsOffset(v,"r")
	Set nullV = $$colnul($p($$$mtV(v),"^",8))
	
	$$$liin("If $g("_slot_")'=$c(0) {")
	$$$liin(" Set "_slot_"=$c(0),"_fid_"=0 ")
	
	Set nodecode($i(nodecode)) = "Set "_counter_"="""" Kill "_erefs
	Set nodecode($i(nodecode)) = "For  {"
	Set nodecode($i(nodecode)) = $c(9)_"Set "_counter_"=$o("_$$wsubv(partitionref,counter)_",1,"_rval_") QUIT:"_counter_"="""""
	Set nodecode($i(nodecode)) = $c(9)_"Set "_fid_"="_fid_"+1"
	Set:$$windowFrameUnbounded(v) nodecode($i(nodecode)) = $c(9)_"QUIT:"_fid_">"_n
	Set nodecode($i(nodecode)) = $c(9)_"Set "_resultref_"="_rval
	
	if $$windowFrameRows(v) {
		Set nodecode($i(nodecode)) = $c(9)_"Set "_eref_"="_fid
		Set nodecode($i(nodecode)) = "}"
		Set nodecode($i(nodecode)) = "Kill "_partitionref_" Merge "_partitionref_"="_erefs_" Set "_partitionref_"=0"
	} else {
		Set nodecode($i(nodecode)) = "}"
		Set nodecode($i(nodecode)) = "Set "_partitionref_"="_fid	
	}
.
	Do scanWindowPartition(v, slot, orderdirs,, .nodecode)
	$$$liin("}")
	
	If '$$windowFrameRows(v) {
		RETURN "$s("_n_">"_entry_":"_nullV_",1:"_ $$windowRowSlot(v,n)_")"	
	}
	if 'width {
		if $$windowFrameUnbounded(v) {
			RETURN "$g("_$$windowRowSlot(v,n)_","_nullV_")"
		} elseif ($$windowFrameBegin(v)="<") { 
			//nthValue Unbounded Preceding: unbounded preceding to 3 following
			//why I add get, for example, there is only 1 node in this entry, ROWS unbounded preceding to 3 following, I want nth_value (2) result for the 1st one,  
			//2 not > 1+3 but we don't have $$windowRowSlot(v,2)
			RETURN "$s("_n_">("_$$wsubv(entry,"$i("_entry_")")_"+"_rOffset_"):"_nullV_",1:$g("_ $$windowRowSlot(v,n)_","_nullV_"))"	
		}
		//nthValue Unbounded Following: 3 preceding to unbounded following
		RETURN "$g("_$$windowRowSlot(v,"$s("_$$wsubv(entry,"$i("_entry_")")_"+"_lOffset_"<1:1,1:"_$$wsubv(entry,entry)_"+"_lOffset_")+"_n_"-1")_","_nullV_")"
	}
	//nthValue with Width: 1 preceding to 5 following
	Set resultidx = $$$getVarName("resultidx"_v)
	$$$liin("Set "_resultidx_"="_"$s("_$$wsubv(entry,"$i("_entry_")")_"+"_lOffset_"<1:1,1:"_$$wsubv(entry,entry)_"+"_lOffset_")+"_n_"-1")
	RETURN "$s("_resultidx_">("_$$wsubv(entry,entry)_"+"_rOffset_"):"_nullV_",1:$g("_ $$windowRowSlot(v,resultidx)_","_nullV_"))"	
	
}
.
lastValueBackward(v) [ mt ] public  {
	Set valvar = $$ptvalue($p($$$mtV(v),"^",8))
	Set slot = $$windowSlot(v)
	Set counter = $$wsubv(slot,"""cnt""")	
	Set slotRef = $$wsubv(slot,"$i("_counter_")")
	Set offset = $$windowFrameRowsOffset(v,"r")
	Set slotRefRef = "$s($d("_$$wsubv(slot,counter_"+"_offset)_"):"_$$wsubv(slot,counter_"+"_offset)_",1:"_$$colnul($p($$$mtV(v),"^",8))_")"
	$$$liin(" Set "_slotRef_"="_valvar)
	RETURN slotRefRef
}
lastValueForwardScan(v) [ mt ] public {
	If $$windowFrameNull(v) {
		RETURN $$colnul($p($$$mtV(v),"^",8))
	}
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	Set val = $$ptvalue($p($$$mtV(v),"^",8))
	
	If $$windowFrameUnbounded(v){
		Set orderref = $$windowOrderRef(v)
		Set orderdirs = $$windowOrderDirs(v)
		Set ordervals = $$windowOrderVals(v)
		Set slotFirstList = $$wsubv(slot,1)
		Set slotValue = $$wsubv(slot,2)
		Set assignNew = $$$getVarName("assignNew"_v)
		Set lastItem = $$$getVarName("lastItem"_v)
		Set newItem = $$$getVarName("newItem"_v)
		if ordervals="" {
			$$$liin("Set "_slotValue_"="_val)
			RETURN "0"
		}
		$$$liin("Set "_assignNew_"=0")
		$$$liin("If $d("_slotFirstList_") {") // check if we need to update last_value for this slot
		$$$liin($c(9)_"Do {")
		For i=1:1:$l(orderdirs) {
			$$$liin($c(9,9)_"Set "_lastItem_"=$li("_slotFirstList_","_i_")")
			$$$liin($c(9,9)_"Set "_newItem_"="_$$ptvalue($li(ordervals,i)))
			If $e(orderdirs,i) = "a" {
				$$$liin($c(9,9)_"If "_newItem_"]]"_lastItem_" { Set "_assignNew_"=1 Quit }")
			}
			Else {
				$$$liin($c(9,9)_"If "_lastItem_"]]"_newItem_" { Set "_assignNew_"=1 Quit }")
			}
			$$$liin($c(9,9)_"Quit:"_lastItem_"'="_newItem)
		}
		$$$liin($c(9)_"} While 0")
		$$$liin("}")
		$$$liin("Else {")
		$$$liin($c(9)_"Set "_assignNew_"=1")
		$$$liin("}")
		$$$liin("If "_assignNew_" {")
		$$$liin($c(9)_"Set "_slotValue_"="_val)
		$$$liin($c(9)_"Set "_slotFirstList_"=$lb("_orderref_")")
		$$$liin("}")
		RETURN "0"
	}
	//Must keep track of all values, sorted
	Set entry = $$windowEntry(v)
	Set counter = slot
	RETURN "0,"_$$wsubv(entry,"$i("_counter_")")_"="_val
}
.
#; Returning the last value for a partition is just returning the final "champion" value
lastValueForwardOutput(v) [mt] public {
	set nullV = $$colnul($p($$$mtV(v),"^",8))
	If $$windowFrameNull(v) {
		RETURN nullV
	}
	Set slot = $$windowSlot(v)
	Set entry = $$windowEntry(v)
	If $$windowFrameUnbounded(v){
		Set slotValue = $$wsubv(slot,2)
		RETURN slotValue
	}
	
	Set fid = $$$getVarName("fid"_v)
	Set counter = $$$getVarName("counter"_v)
	Set erefs = $$getWindowVar(v,"erefs"_v,1,4)
	Set eref = $$wsubv(erefs,"$i("_erefs_")")
	Set rval = $$$getVarName("rval"_v)
	Set resultref = $$windowRowSlot(v,fid)
	Set lastfid = $$windowRowSlot(v,"""lastfid""")
	Set orderdirs = $$windowOrderDirs(v)
	Set partitionref = $$getPartitionRef(v, slot, orderdirs)
	$$$liin("If $g("_slot_")'=$c(0) {")
	If '$$windowFrameRows(v){
		$$$liin(" Set "_slot_"=$c(0)")
		Set nodecode($i(nodecode)) = "Set "_counter_"="""" "
		Set nodecode($i(nodecode)) = "Set "_counter_"=$o("_$$wsubv(partitionref,counter)_",-1,"_rval_")"
		Set nodecode($i(nodecode)) = "Set "_partitionref_"="_rval // keep track of the last value for each entry
	} else {
		$$$liin(" Set "_lastfid_"="_slot_","_slot_"=$c(0),"_fid_"=0")
		Set nodecode($i(nodecode)) = "Set "_counter_"="""" Kill "_erefs
		Set nodecode($i(nodecode)) = "For  {"
		Set nodecode($i(nodecode)) = " Set "_counter_"=$o("_$$wsubv(partitionref,counter)_",1,"_rval_") QUIT:"_counter_"="""""
		Set nodecode($i(nodecode)) = " Set "_fid_"="_fid_"+1"
		Set nodecode($i(nodecode)) = " Set "_resultref_"="_rval
		Set nodecode($i(nodecode)) = " Set "_eref_"="_fid
		Set nodecode($i(nodecode)) = "}"
		Set nodecode($i(nodecode)) = "Kill "_partitionref_" Merge "_partitionref_"="_erefs_" Set "_partitionref_"=0"
	}
	Set evar = $$$getVarName("entry"_v)
	Do scanWindowPartition(v, slot, orderdirs, evar, .nodecode, .postcode)
	$$$liin("}")
	
	If '$$windowFrameRows(v){
		RETURN entry
	}
	Set begin = $$windowFrameBegin(v)
	Set end = $$windowFrameEnd(v)
	Set resultidx = $$$getVarName("resultidx"_v)
	Set beginlimit = ""
	If +begin=begin,begin>0 {
		Set beginlimit = "&&(("_resultidx_$s(end:"-"_end,1:"")_"+"_begin_")<="_fid_")"
	}
	if end=">" {
		$$$liin("Set "_resultidx_"="_$$wsubv(entry,"$i("_entry_")"))
		RETURN:(+begin=begin)&&(begin>0) $$windowRowSlot(v,"$s("_$e(beginlimit,3,*)_":"_lastfid_",1:"_nullV_")")
		RETURN $$windowRowSlot(v,lastfid)
	}
	$$$liin("Set "_resultidx_"="_$$wsubv(entry,"$i("_entry_")")_$s(end:"+"_end,1:""))
	Set result = "$g("_$$windowRowSlot(v,"$s(("_resultidx_">"_lastfid_")"_beginlimit_":"_lastfid_",1:"_resultidx_")")_","_nullV_")"
	RETURN result
}
#; --- Window functions /END
.
 #; returns 1 if we need to generate code to initialize the "once" val in callsub, 0 otherwise 
initializeOnceVal(val,oldmod) [mt,opex,m] private {
	// Return 1 if this query block is not using Adaptive Parallel Execution
	Return:('$$$useAPE(m)) 1
	// Return 1 if this query block is using Adaptive Parallel Execution and oldmod is a parent module
	Return:($$$topParentModule(m)<= oldmod) 1
	// otherwise, we are in a worker module for a Adaptive Parallel Execution query
	// No need to initialize val if it is in opex, as its value will be passed from parent process
	for i = 1:1:$l(opex, ","){
		Return:$p(opex, ",", i)=val 0
	} 
	// otherwise initialize val
	Return 1
}
.
