	QUIT:op="CAST_VARCHAR"||(op="CONVERT:%Library.String") "$e("_$s($$$VTRgetcat(arg1)="DATE":$$genmeth("%Library.Date","LogicalToOdbc",,val),$$$VTRgetcat(arg1)="POSIXTS":$$genmeth("%Library.PosixTime","LogicalToOdbc",,val),$$$VTRgetcat(arg1)="TIME":$$genmeth("%Library.Time","LogicalToOdbc",,val),$$$VTRgetcat(arg1)="FMDATE":$$genmeth("%Library.FilemanDate","LogicalToOdbc",,val),$$$VTRgetcat(arg1)="FMTIMESTAMP":$$genmeth("%Library.FilemanTimeStamp","LogicalToOdbc",,val),1:val)_",1,"_$s(v'="":$$ptvalue(v),1:30)_")"	// DPV2667 (default len is 30)
