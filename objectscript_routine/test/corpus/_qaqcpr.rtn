			}
			
			QUIT "$s("_$$notnull2(val,exprTemp1)_"(("_val_">0)&&("_exprTemp1_"<0))||(("_val_"<0)&&("_exprTemp1_">0)):("_"$decimal($double("_val_")"_"#"_exprTemp1_"))" _ ",1:("_val_"#"_exprTemp1_"))"
