		RETURN "$s("_val_"="""":"""","_val_"=+"_val_"||("_val_"?1.7N1"",""1.5N)||("_val_"?1.7N1"",""1.5N1""."".N):$$DayOfWeek^%qarfunc("_val_"),1:$$DayOfWeek^%qarfunc($zdateh($p("_val_","" ""),3,,,,,-672045)))"
	}
	if op="DAYOFYEAR" {
		do CheckForDateConversion(1)
		if "#$"[$e(val) { do davalue(arg1) set val=pti(arg1) }
		RETURN "$s("_val_"="""":"""","_val_"?0.1""-""1.7n||("_val_"?1.7N1"",""1.5N)||("_val_"?1.7N1"",""1.5N1""."".N):+$zdate("_val_",14,,,,,-672045),1:+$zdate($zdateh("_val_",3,,,,,-672045),14,,,,,-672045))"
	}
	if op="DECODE" {	// DPV1219
		new i,def,qval
		set qval="$case("_val_","_$$ptvalue(v)_":"_$$ptvalue($p(string,"^",6))
		set def=0
		for i=7:2 {
			quit:$p(string,"^",i)=""
			if $p(string,"^",i+1)="" { set qval=qval_",:"_$$ptvalue($p(string,"^",i)) set def=1 } ; Just the default left
			else                     { set qval=qval_","_$$ptvalue($p(string,"^",i))_":"_$$ptvalue($p(string,"^",i+1)) } ; Another search/result
		}
		set qval=qval_$s(def:"",1:",:""""")_")"
