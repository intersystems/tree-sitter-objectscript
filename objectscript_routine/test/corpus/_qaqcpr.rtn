		RETURN "$s("_val_"="""":"""",1:("_val_"*"_(180/$zpi)_"))"	// Perform 180/$zpi at compile time to reduce run-time overhead
	}
	if $p(op,":",1)="%DISTINCTLIST_COLLATE" {
		RETURN "$$DistinctListCollate^%qarfunc("_val_","""_$p(op,":",2)_""")"
	}
	if $p(op,":",1)="%DISTINCT%DLIST_COLLATE" {
		RETURN "$$DistinctDListCollate^%qarfunc("_val_","""_$p(op,":",2)_""")"
	}
	if op="EXP" {
		RETURN $$evalOnce(val,arg1,"$zexp("_$c(1)_")")
	}
	If op="$EXTRACT" {	// DPV2100
		n from,null,to s from="",to=""
		s:v'="" from=$$ptvalue(v)					// From
		s:$p(string,"^",6)'="" to=$$ptvalue($p(string,"^",6))		// To
		s null=$s(to'="":$$notnull2(from,to),from'="":$$notnull1(from),1:"")
		QUIT:null'="" "$s("_null_"1:$Extract("_val_$s(from'="":","_from,1:"")_$s(to'="":","_to,1:"")_"))"
		QUIT "$Extract("_val_$s(from'="":","_from,1:"")_$s(to'="":","_to,1:"")_")"
