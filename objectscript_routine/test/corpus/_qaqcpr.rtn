	;  BJB439  (12/17/2009) - ALPHAUP index with OR field = ''
	;  AK750   (09/21/2009) - Fix $$colnul() for a collated view field
	;  BJB417  (09/07/2009) - TRIM(' ') should return Empty String not NULL
	;  AK739   (06/18/2009) - ASL for TOP/ORDER BY in subqueries
	;  AK694   (02/15/2008) - JSV fixes - OUTER JOIN into UNION, "empty"
