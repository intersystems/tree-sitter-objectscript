====
qaqpnl
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpnl^MAC^^^0
%qaqpnl	// analyze mt(l), called from %qaqpqo
	;; COMPONENTS :: SQL/PathSpecification
	#;
#INCLUDE %msql
#INCLUDE %BigData.ShardingManager // JMM1215=
#IF 0   ;-------------------------------------------------------------
	; Description:   Analyze mt(l)
	; Author:        Aviel Klausner
	; Date Started:  05/01/87
	;
	;  AK850   (11/30/2020) - Implement lateral join
	;  AK1036  (01/15/2021) - Apply "onerow" even when no aggregates left
	;  AK1031  (11/02/2020) - Propagate down non-empty mt("dsn") after pushlog()
	;  AK1021  (08/05/2020) - Compute streamless expressions on the master
	;  AK1026  (09/17/2020) - Avoid empty entries in correlated fields list
	;  AK984   (02/25/2019) - Support COSHARD WITH for query cosharding
	;  JMM912  (09/14/2018) - Recognize cosharded correlated subqueries and execute them locally
	;  AK985   (09/04/2018) - Use mt("shrows",m) to force use of "rows"
	;  AK978   (04/13/2018) - Implement AGG(DISTINCT f) for sharding
	;  JMM900  (07/24/2018) - Only coshard joins of tables whose shard maps match
	;  AK977   (03/26/2018) - Fix mt("shtop") for AK960 added subqueries
	;  AK963   (05/04/2017) - Cosharding system-generated ID's in buckets
	;  AK954   (05/24/2016) - Apply HAVING null-analysis when sharding
	;  PVA354  (03/25/2016) - Fix: : <UNDEFINED>ptvsel+1^%qaqomul for unusual ORDER BY queries 
	;  PVA348  (03/01/2016) - PVA348 - Support Lateral references in JSON_TABLE through optimizer
	;  PVA342  (12/15/2015) - Generate ojfilters for sharding only when really needed, and fix interaction between aggregates and outer joins (for sharding)
	;  AK939   (09/10/2015) - Sharded outer joins
	;  AK938   (07/29/2015) - Sharded joins
	;  PVA307  (06/18/2014) - Fix: Error running SELECT statement agains non-Cache linked table
	;  PVA279  (02/12/2014) - Enhance ptres handling for longstanding defects
	;  PVA304  (04/23/2014) - Support %PARTITION BY for use by parallel work units
	;  PVA305  (05/01/2014) - Fix re-emergence of some wrong answer cases originally fixed by PVA215/PVA287
	;  PVA301  (04/01/2014) - Fix: <SUBSCRIPT> error compiling query with unsubstituted literal 'IN'
	;  PVA294  (11/04/2013) - Allow %NOTOPOPT to be set system wide
	;  AK890   (10/09/2013) - Allow NULL with TOP condition and OR/IN
	;  PVA291  (09/30/2013) - Fix some (rare) wrong answers introduced by PVA289 
	;  PVA289  (09/26/2013) - Fix: Bad plan after Or to UNION optimization
	;  PVA287  (09/23/2013) - Fix possible wrong answer for IN condition with fields on right that reference outer join targets
	;  PVA284  (09/17/2013) - Fix: Union in subquery ignores second query if first contains subquery
	;  PVA270  (12/18/2012) - incorrect query return for SELECT ... INTO local array
	;  PVA269  (11/15/2012) - Push subquery conditions into union legs
	;  AK857   (05/03/2012) - Fix INTO array() subscripts with OR->UNION
	;  AK688   (01/24/2008) - Abstract index/filter conditions
	;  PVA260  (06/07/2012) - Remove special case optimization for idkey joins that is superseded by PVA258, and also improve edge case
	;  AK856   (04/17/2012) - GWQ: Fix UNION for streamless subqueries
	;  AK849   (01/18/2012) - Parallel processing for UNION
	;  AK831   (10/04/2011) - Correct more NOT EXISTS SVSO logic
	;  AK821   (08/19/2011) - Handle "n" nodes when listing corr. fields
	;  AK813   (03/03/2011) - Fill in mt("dsn") for new subqueries
	;  AK805   (03/03/2011) - SQLCODE=-161 for unimplemented heter. joins
	;  PVA232  (12/03/2010) - Support optional second argument of %inlist() to provide a selectivity hint 
	;  PVA231  (11/30/2010) - Implement view.%id feature
	;  PVA226  (07/21/2010) - Fix error with %exact(column) IN subquery: <SUBSCRIPT>nIsCorrTo+8^%qaqpre *mt("v","")
	;  AK692   (02/23/2010) - Skip 'opex' for JSV joined fields
	;  JLF339  (01/15/2010) - Support cloning of collection references
	;  PVA215  (12/03/2009) - Fix wrong answer for outer join and WHERE clause with exotic %startswith condition
	;  PVA210  (11/30/2009) - Fix: <UNDEFINED>copyqb+132^%qaqpre3 *xlate("v","23")
	;  AK757   (11/01/2009) - GWQ: Prevent TOP optimization
	;  PVA202  (10/23/2009) - Improve clone^%qaqpnl to not copy streamless "v" nodes if they (deeply) contain no "n" nodes
	;  PVA201  (10/22/2009) - Fix for certain queries involving date literals producing the wrong answer
	;  PVA199  (10/07/2009) - Fix cloning of streamless expressions - must actually clone
	;  PVA198  (09/04/2009) - Extend AK743 to cover remaining opportunities for view output optimization
	;  JLF270  (08/27/2009) - Make %INLIST null analysis consistent with IN
	;  JLF266  (08/18/2009) - Perform join analysis in DISTINCT optimization
	;  PVA197  (07/30/2009) - Mark query "empty" in the pre-optimizer of TOP 0 is specified
	;  PVA186  (06/16/2009) - Tests added by Cache for null correctness should not have any selectivity
	;  PVA184  (06/14/2009) - Optimizer support for TOP... ORDER BY in subqueries
	;  PVA183  (05/26/2009) - Pre-optimizer support for TOP...ORDER BY in subqueries
	;  PVA179  (05/18/2009) - Fix execution time <undefined> for a query with multiple opportunities for OR to UNION optimization
	;  PVA174  (03/19/2009) - Fix side effects of PVA173: fix references in deep query streams only for view merging
	;  PVA173  (03/17/2009) - Fix run time <UNDEFINED> when a FROM clause subquery contained in another subquery
	;                         has outer references to the other subquery's parent or higher, and that reference
	;                         is to a column of a view or FROM clause subquery that is merged.
	;  PVA172  (03/09/2009) - Fix: No Data with SELECT TOP WHERE Field IS NULL ORDER BY Field
	;  JLF242  (03/10/2009) - Add NOT NULL condition for SVSO anyneq decorrelated expression
	;  PVA169  (03/03/2009) - Fix: FULL OUTER JOIN gives <UNDEFINED>corr+2^%qaqpnl
	;  AK723   (02/13/2009) - Skip more optimizations for linked queries
	;  AK721   (02/03/2009) - Preserve linked subqueries
	;  JLF233  (12/31/2008) - Fix field list propagation in nnlf^%qaqpnl
	;  PVA161  (09/28/2008) - fix <SUBSCRIPT>fvals+27^%qaqpnl *mts(1,6,"ATT","") error
	;  DPV3231 (08/05/2008) - Use process private global for ptln, ptrel
	;  PVA158  (07/20/2008) - Utility for OR to UNION transformation
	;  PVA157  (05/01/2008) - Support faster DISTINCT while preserving case (i.e. with FASTDISTINCT OFF )
	;  AK704   (06/05/2008) - Another old 99 affecting long IN
	;  PVA156  (04/28/2008) - Implement %NOTOPOPT keyword
	;  AK691   (02/14/2008) - Implement heterogeneous queries
	;  DPV3131 (03/25/2008) - DD Lookup and Table compiler performance improvements
	;  AK683   (08/01/2007) - Use index for outer join into a view
	;  JLF185  (10/24/2007) - Performance improvement for %CONTAINS
	;  JLF181  (10/23/2007) - %SIMILARITY on a view output, with SIMILARITYINDEX defined
	;  PVA139  (09/21/2007) - Allow updatable view to be streamed
	;  JLF170  (07/31/2007) - Fixed $e(mt("p"),m) expression in lflds loop
	;  AK682   (07/23/2007) - Mark pushlog() HAVING fields as "for output"
	;  JLF170  (07/27/2007) - Initialize outputHav=0
	;  PVA145  (06/19/2007) - <UNDEFINED>transformExists+23^%qaqpre *$$$mtR("+") error
	;  PVA141  (06/14/2007) - <SUBSCRIPT>subconds+10^%qaqoco *ptres("")
	;  PVA140  (06/13/2007) - Improve JLF167 to do one type of factoring earlier (as originally done)
	;  JLF167  (05/05/2007) - Moved factorCommonAnds into propagatePreds loop
	;  DPV2903 (04/05/2007) - Don't set strLst in pushlog - it's not used
	;  PVA138  (03/26/2007) - Mixture of ANSI and legacy outer joins might lose conditions.
	;  PVA135  (03/16/2007) - Compilation fail with <SUBSCRIPT>transformExists+12^%qaqpre *$$$mtL("")
	;  PVA133  (03/08/2007) - The new %INLIST operator was never properly optimized when under and OR
	;  JLF153  (03/02/2007) - Restored SVSO optimizations that were disabled by PVA099, added analyzeSubqueries
	;  PVA124  (01/04/2007) - Implement facility to undo side effects of conds/outer/class in propagatePreds^%qaqpnl
	;  AK672   (12/01/2006) - Improve NULL testing for simple comparisons
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  JLF139  (01/04/2007) - Integrated INSET predicate with OR optimizations
	;  PVA122  (12/20/2006) - Fix a query with union and IN (1,NULL)
	;  PVA115  (12/12/2006) - Assorted outer join fixes
	;  PVA114  (12/04/2006) - Final driver code for FULL outer join
	;  PVA112  (11/29/2006) - Generalized pushdown could push conditions that change the answer to some outer join query
	;  PVA108  (11/23/2006) - Support RIGHT and LEFT joins with nested ON clauses and general predicates
	;  PVA099  (09/14/2006) - Extend PVA087 to views on the right hand side of a left join
	;  JLF125  (09/10/2006) - Support stream on left of left outer join
	;  PVA101  (10/16/2006) - Allow subquery optimizations to exploit literal expression simplification
	;  JLF123  (09/13/2006) - Partial fix for NOT over collection references, with and without index support
	;  PVA096  (09/06/2006) - Fix flaw in NULL analysis code.
	;  PVA095  (09/06/2006) - Improve, and fix bugs in PVA094 and JLF117
	;  JLF117  (08/31/2006) - Call pushlog on $$$mtLeftOuterJoins(m) items, passing the "j" flag
	;  PVA094  (08/01/2006) - Push other joins into streamed view created for general outer joins.
	;  JLF117  (08/25/2006) - Call pushlog on viewSpConds logs for PVA087 ON-clause replication
	;  JLF117  (07/27/2006) - Enhance pushlog to push outer joins.
	;  JLF115  (07/16/2006) - Remove unreferenced aggregates from mt("p",m)
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  PVA092  (06/24/2006) - Modify outer join data structure to avoid subscript size limit; assorted other outer join bugs.
	;  PVA091  (06/09/2006) - Fix maintenance of ptrel in pre-optimizer query transforms
	;  PVA087  (02/01/2006) - Extended Outer Join Support: Any ON clause for LEFT JOIN from base tables to a base table.
	;  DPV2659 (05/23/2006) - SQL Fix ProdLog 50951:  Fix CASE expression wit NULL values
	;  JLF089  (03/07/2006) - Don't test right operand of %STARTSWITH for nullness
	;  JLF087  (03/01/2006) - Add NULL analysis for HAVING clause
	;  JLF085  (02/28/2006) - Handle NULL in IN list correctly
	;  JLF083  (02/23/2006) - Restrict SVSO to fields in certain cases, to detect collation at code gen time
	;  JLF080  (02/14/2006) - Do HAVING clause analysis after calling flds/lflds
	;  JLF079  (02/10/2006) - Push TOP into UNION legs
	;  JLF073  (01/02/2006) - propagatePreds must verify that the v operand of a log is a simple field
	;  PVA084  (11/30/2005) - TOP RANGE pseudo predicate not transitively replicated when on same field as CON
	;  JLF065  (09/29/2005) - Generate mt("c",m) predicate when fld=lit1 AND fld=lit2
	;  JLF048  (08/08/2005) - Merged predicate pushdown with transitivity logic
	;  JLF051  (09/12/2005) - Extend lfnul to handle n, x, and t nodes
	;  AK627   (07/08/2005) - Remove constant expressions from ORDER BY
	;  PVA080  (05/16/2005) - Fix join condtion following IN type condition on each of its operands
	;  JLF020  (10/27/2004) - TOP operator support
	;  AK611   (10/05/2004) - Fix NULL analysis for constants/variables
	;  JLF015  (04/27/2005) - Added support for %ANYOF
	;  AK597   (04/30/2004) - Fix "pushlog" cloning of unary, streamless
	;  JLF002  (02/27/2004) - Support fields of virtual streams
	;  DPV2181 (02/26/2004) - Fix viewinfo compile - don't save/restore mt(v), just call info^%qaqpifo sooner
	;  PVA057  (11/07/2003) - Aggregate speed up: avoid data map access for aggregated collated values.
	;  AK591   (02/03/2004) - Padding may survive condition with ISNULL()
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  JLF001  (09/03/2003) - Remove redundant conjuncts
	;  AK571   (07/09/2003) - Push conditions into UNION subqueries
	;  AK568   (05/29/2003) - Correct NULL processing for NVL in WHERE
	;  DPV1970 (03/31/2003) - Allow creation of view with query against linked table
	;  PVA048  (11/22/2002) - Support <expression> is [not] null
	;  PVA041  (08/27/2002) - "WHERE column=:x or :x is null" gives wrong answer
	;  DPV1799 (08/20/2002) - Support stream fields in colnul
	;  AK530   (07/30/2002) - Apply collation to NULL in SET expressions
	;  DPV1748 (06/13/2002) - NEW ci
	;  DPV1693 (03/29/2002) - Support updatable views
	;  PVA021  (10/26/2000) - bitmaps: Pre-optimizer support for OR generalized CON node
	;  AK501   (12/13/2001) - Nataliya: Fix field list for outer join
	;  AK481   (07/27/2001) - SHD#25: Apply collation to IS [NOT] NULL
	;  DPV1449 (11/15/2000) - EMIS:  Fix piece 3 processing for 's' nodes
	;  AK446   (05/31/2000) - View stream processing
	;  AK425   (01/25/2000) - CCS#85: NULL fix for required in OUTER JOIN
	;  AK407   (11/16/1999) - NULL in conditions
	;  AK390   (08/20/1999) - CCS#48: UNION in subquery
	;  AK389   (08/11/1999) - Hycom: CASE in INSERT/UPDATE
	;  AK357   (03/11/1999) - CCS: Remove conflicting conditions error
	;  AK386   (07/28/1999) - Amital: IS NOT NULL fixes
	;  AK380   (07/08/1999) - CCS#37: OUTER JOIN with expression
	;  AK365   (05/19/1999) - CCS: expr IN subq
	;  DPV1017 (03/24/1999) - Eliminate 'NULL conditions when there is a
	;                         %STARTSWITH on the same field
	;                         Don't report error -35 if f IS NOT NULL and f in range
	;  AK315   (05/12/1998) - CCS: Multifield outer-join
	;  DPV700  (02/04/1997) - Support NULL Markers for index subscripts
	;  MRP580  (03/18/96)   - Support SQL92 SUBSTRING Function
	;  MRP557  (12/06/95)   - Allow OUTER JOINS with LIKE Conditions
	;  MRP503  (06/01/95)   - Optimize conditions for Correlated Sub-Queries
	;  AK273   (07/08/93)   - add $G() for mt("c") (derived) conditions
	;  AK015;AK017;AK028;AK078;AK091;AK101;AK116;AK153;AK168;AK180
	;  ALL001;ALL003;RGG596;AK213
	;
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	n mTopo,outputHav,singletonSelect,uniqueBody,viewsopt,nestlinx,nnodecache s outputHav=0	; JLF080, JLF128, JLF153 - Calculated in distinctOpt, referenced by transformExists
	d calcQBOrder(1)  ;  JLF128
	#; AK691
	d dsn  ;  find out DSN's for each subquery - set mt("hj"/"dsn"/"unh",m)
	new arrcol
	set arrcol=$$arrcol()   ;for SELECT ... INTO :ARRAY(), precompute column number in the output arr
	set:arrcol'="" mt("arrcol")=arrcol
	d revertBars()
	n nolatf  ;  nolatf(strf,strv)="" - can't have latf references to strf from within strv  ;  AK1060
	#;  list in $p(mt("v"/"l"),3) all fields used
	f mTopo=maxm:-1:1 s m=mt("qbo",mTopo) d flds	; In bottom-up topological order - JLF128
	// If $d(mt("vdf")), for each query block m fetch all conditions in mt("w",m) and multiply their selectivities,
	// compare the result to the ACORN-1 threshold: if it's within the threshold, enable ACORN-1 for this query block
	if $d(mt("vdf")) {
		new vdfVal
		set vdfVal = ""
		set str = ""
		for {
			set vdfVal = $o($$$mtVecDistFunc(vdfVal))
			QUIT:vdfVal=""
			set str = $p($g($$$mtV(vdfVal)),"^",2)
			CONTINUE:str=""
			set m = $p($g($$$mtR(str)),"^",2)
			CONTINUE:m=""
			if $$getTotalWHEREselectivity(m) <= $$$ACORN1SelectivityThreshold {
				set $$$mtACORN1Enabled(m) = 1
			}
		}
	}
	s str="" f  {  ;  check for badlatf in TVF arguments  ;  AK1060
		s str=$o($$$mtTvfParams(str),1,list)
		QUIT:str=""
		CONTINUE:list=$c(0)
		f li=1:1:$ll(list) d badlatv($lg(list,li),str)
	}
	k nolatf s nolatf=""  ;  disable future ROJ/FOJ badlatf test  ;  AK1060
	d checkUnionParallel
	#;  d setLateralRefs  ;  moved to end of ^%qaqpqo1  ;  PVA348;AK1060
	#;  d checkTVFArgs  ;  PVA348  ;  now supported - removed by AK1060
	#; AK688
	s call="filter"  ;  find applicable %INSUB/%INBIT to use as filters
	f m=1:1:maxm if $$$mtPQbIsActive(m),'$g($$$mtEmpty(m)) f lgi=1:1 s log=$p($g($$$mtWhere(m)),"^",lgi) q:log=""  d lvtree("l",log)
	#;  convert all the rest to %FIND - tested at the end
	f log=1:1:$$$maxl s v=$e($$$mtL(log),1,9) i (v="v^%INSUB^")||(v="v^%INBIT^") s $$$mtLOperator($$$mtL(log))="%FIND"
	#; AK688-
	#; PVA087: move lflds for $$$mtSequencersQb(), "nuval" and linx inside flds for when
	#;   flds is called again for cleanup. These operations are properly conditionalized
	#;   within flds. 
	#; AK627
	#;  remove constant expressions from $$$mtS
	#;  PVA183: Subquery ORDER BY
	s jj="" for 
	{  s jj=$o($$$mtSequencersQb(jj)) q:jj=""  continue:'$$$mtPQbIsActive(m)
	   s $$$mtSequencersQb(jj)=$$prunesort($$$mtSequencersQb(jj)) k:$$$mtSequencersQb(jj)="" $$$mtSequencersQb(jj)
	}
	if $d($$$mtSequencers)#10 { s $$$mtSequencers=$$prunesort($$$mtSequencers) zkill:$$$mtSequencers="" $$$mtSequencers }    
	#; AK627-
	#; AK425
	f mTopo=1:1:maxm  s m=mt("qbo",mTopo) d:m'=0&&$$$mtPQbIsActive(m) shardLinxToOn(m)
	n nulstr s nulstr=""  ;  $list of all outer-join right-side streams
	f m=1:1:$$$mtPNumQbs d:$$$mtPQbIsActive(m) setnulstr(m) // PVA108: make utility out of nulstr setting
	#;  d CheckLateralOJ  ;  moved to flds->latf->badlats  ;  PVA348;AK1060
	#; convert COUNT(f) to COUNT(*) when the field f does not contain nulls
	d ConvertCountReqField^%qaqpre()
	#; AK425-
	d analyzeHavingClause^%qaqpre2
	s outputHav=1,output=1 
	f mTopo=1:1:maxm  s m=mt("qbo",mTopo) d:m'=0&&$$$mtPQbIsActive(m) lflds("l",$g($$$mtHaving(m)),"do")
	s output=0
	d delDangl^%qaqpre2()	; JLF117 - Disable unreferenced logs and unlink unreferenced $$$mtP(m) aggregates
	#; PVA198: optimize view outputs; This is also done later.
	for 
	{ s viewsopt=0 f mTopo=1:1:maxm  s m=mt("qbo",mTopo) continue:$$isLinked(m)  s:$$$mtPQbIsActive(m) viewsopt=viewsopt ! $$optVwOut^%qaqpre3(m)
	  q:'viewsopt  
	  d marksqs^%qaqpre3(1) // this updates "qbo" ; this needed if we also do view
	  d clearflds^%qaqpre3
	  f mTopo=maxm:-1:1 s m=mt("qbo",mTopo) d:$$$mtPQbIsActive(m) flds
	}
	#;  Flatten subqueries and views, perform distinct optimization,
	#;  simplify Boolean expressions, remove redundant predicates, etc.
	#;  
	d analyzeQueryBlocks^%qaqpre
	#; AK407
	#; PVA087: notnull replaced by re-usable utilities
	#; PVA099: move main notnull processing to much later
	f jj=1:1:$$$maxv set:$e($g($$$mtV(jj)),1,5)="l^L2V" $p($$$mtV(jj),"^",4)=$$notnullh($p($$$mtV(jj),"^",4))	// DPV2659=
	#; AK407-
	#;  process top-level WHERE conditions
	#;  see WP#43, Conditions Analysis and Replication (5/4/87)
	#;  add conditions implied by aup (maybe later ***)
	s nopad=""  ;  flags streams that cannot be padded
	d propagatePreds(1,1) 				// Merge streamed views, do TOP opt, and all multi-phase optimizations
	d undoSideEffects^%qaqpre3 			// Restore parse tree to conventions before conds/outer/class - PVA124
	#;d:'$$anyShardedTables^%qaqpagg viewsize
	d analyzeSubqueries^%qaqpre3()		// Prepare for, then call transformExists to flatten subqueries, do svso, etc. - JLF153
	d flattenAOA^%qaqpre2				// Transform ANYOFAND predicates
	d validateCollectionRefs^%qaqpre3()	// Validate that collection-valued expressions are based on collection fields
	d propagatePreds(1,2) 				// Add NULL tests and re-do all multi-phase optimizations
	#;d:'$$anyShardedTables^%qaqpagg viewsize
	#; Implied conditions could add "fake" JSV conditions to other streams.
	do updateJsvCorr()
	d removePushedLogDependencies^%qaqpre3(.ptres) // Remove ptres and seladj relationships for fully-pushed-down conditions
	d removePushedLogDependencies^%qaqpre3(.seladj) 
	#; Remove unreferenced view outputs (also done earlier).  Here, it is necessary to clear and re-do 
	#; flds because mergeviews cannot properly maintain $$$PTVREFERENCED, the global state flag - See PVA198
	d clearflds^%qaqpre3
	f mTopo=maxm:-1:1 s m=mt("qbo",mTopo) d:$$$mtPQbIsActive(m) flds
	f mTopo=1:1:maxm s m=mt("qbo",mTopo) d:$$isShardedTop(m) shardown(m)
	for 
	{ s viewsopt=0 f mTopo=1:1:maxm  s m=mt("qbo",mTopo) continue:$$isLinked(m)  s:$$$mtPQbIsActive(m) viewsopt=viewsopt ! $$optVwOut^%qaqpre3(m)
	  q:'viewsopt  
	  d marksqs^%qaqpre3(1) 			// this updates "qbo" ; this needed if we also do view
	  d clearflds^%qaqpre3
	  f mTopo=maxm:-1:1 s m=mt("qbo",mTopo) d:$$$mtPQbIsActive(m) flds
	  f mTopo=1:1:maxm s m=mt("qbo",mTopo) d:$$isShardedTop(m) shardown(m)
	}
	d setAnyof^%qaqpre3()				// set $$$mtAnyOfVals(log), and merge %ANYOF logs in mt("w",*) into a common root if necessary
	#; AK530
	#;  for top SET expression, save Coll(NULL) of the corresponding field
	for log=1:1:$$$maxl {
		set ptlg=$$$mtL(log)
		if $p(ptlg,"^",2)="ONEOF" {
			set $$$mtCollationNullMarker($p(ptlg,"^",5))=$$colnul^%qaqcpr($p(ptlg,"^",4),0)
			set ($$$mtNullMarker($p(ptlg,"^",4)),$$$mtNullMarker($p(ptlg,"^",5)))=$$colnm($p(ptlg,"^",4),$$$mtCollationNullMarker($p(ptlg,"^",5)))
			n call,colnm s call="setcolnm",colnm=$$$mtNullMarker($p(ptlg,"^",5))
			d lvtree("v",$p(ptlg,"^",5))  ;  propagate to all SETs in the subtree
		}
	}
	#; AK530-
	QUIT:info&&(callname["view")		  	// DPV1970=
	#; AK938
	#;  set up mt("shref",str)=Tnn for external references to other shards
	$$$SNRBDebugTrace("qaqpnl %ISCSNRemoteTables:",.%ISCSNRemoteTables) // JMM1152=
	s tname="" f  s tname=$o(%ISCSNRemoteTables(tname)) q:tname=""  f m=1:1:maxm s:$d($$$ptrel(m_"^"_tname),str) mt("shref",str)=tname
	#; AK938-
	#; save ptrel if needed for future sharded or linked query reconstruction
	if $d($$$mtDSNConnection)||$d(mt("shtop"))||$d($$$ForeignTables) {
		//Preserve ptrel for alias reconstruction
		if '$d(mt("ptrel")) m mt("ptrel") = %ptrel
	}
	GOTO ^%qaqpqo1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
setcolnm  ; tag all set components with their null marker
	RETURN:$e(v,1,6)'="v^SET:"
	Set $$$mtNullMarker(val)=colnm
	GOTO lvarg
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; IBA001	
xformCond(log,m) [mt] PUBLIC {
	s v=$$$mtL(log),op=$p(v,"^",2)
	if (op="!")||(op="&") {
		d xformCond($$$mtLOperand1($$$mtL(log)),m),xformCond($$$mtLOperand2($$$mtL(log)),m)
	}
	#; do the transformation if there is only one field in the condition
	if (",>,'>,=,'=,'<,<," [ (","_op_",")) && ($l($p(v,"^",3),",")=3){  
		s fpos=$p(v,"^",3),lhsloc=$p(v,"^",4),v1=$$$mtV(lhsloc)
		#; swap lhs and rhs, if the field is on the rhs
		if ($p(v1,"^",3)=",") || ($p(v1,"^",3)=""){
			s op=$$flipop(op),$$$mtLOperator($$$mtL(log))=op
			s $p($$$mtL(log),"^",4,5)=$p(v,"^",5)_"^"_lhsloc
			s v=$$$mtL(log),lhsloc=$p(v,"^",4),v1=$$$mtV(lhsloc)
		}
		s decomp=0,propsimp=0,propsimpdiv=0
		#; in each iteration, we move a t or x node in mt("v") from lhs to rhs to try to isolate the field on the lhs
		for {
			if (($e(v1)="f")||($e($p(v1,"^",2))="%")){ // quit if we reach the desired format, i.e. the field is the only entity on the lhs
				QUIT
			}
			elseif ",+,-,*,/,"[(","_$p(v1,"^",2)_","){
				s v11=$$$mtV($p(v1,"^",4))
				#; make sure there is no bad expression referenced on the RHS, e.g. non-numeric datatype or collations.
				set allReferenedVals=$$listree^%qaqpagg("v",lhsloc,"v"),foundBadVal=0
				for cnt=1:1:$l(allReferenedVals,",")-1 {
					set refVal=$p(allReferenedVals,",",cnt), vNode=$$$mtV(refVal)
					#; collation-type values are excluded. This includes: %COLLATE,%ALPHAUP,%UPPER,%SQLSTRING,%SQLUPPER,%STRING,%PLUS,%MINUS,%SPACE,%MVR,%TRUNCATE,%ANYOF,%ANYOFKEY
					#; all v nodes in mt("v") should be of a numeric datatype
					if ($p(vNode,"^",2)["%")||$case($$checkVTRCat(refVal),"INTEGER":0,"NUMERIC":0,"DOUBLE":0,"DATE":0,"TIME":0,"POSIXTS":0,:1) {
						set foundBadVal=1
						QUIT
					}
				}
				QUIT:foundBadVal
				set vtrCat=$$checkVTRCat($p(fpos,",",2)) ; YCL244
				QUIT:$case(vtrCat,"INTEGER":0,"NUMERIC":0,"DOUBLE":0,"DATE":0,"TIME":0,"POSIXTS":0,:1)
				if ($l(v1,"^")=6){
					s oplhs=$p(v1,"^",2)
					s lhs=$s((($e(v11)="v")&&($p(v11,"^",3)'=","))||($e(v11)="f"):"f",1:"nf")
					s rhs=$p(v,"^",5)
					if (lhs="f")||(oplhs="*")||(oplhs="+"){
						if ("+-"[oplhs){
							i ((oplhs="+")&&(lhs="nf")) {
								s operand1=$p(v1,"^",4)
								s newValLHS=$$$newval($p(v1,"^",1,3)_"^"_$p(v1,"^",5)_"^"_operand1_"^"),v1=$$$mtV(newValLHS)
							}
							s newValRHS=$$$newval($p(v1,"^")_"^"_$s(oplhs="-":"+",1:"-")_"^,^"_$p(v,"^",5)_"^"_$p(v1,"^",5)_"^")
							s $p($$$mtL(log),"^",4,5)=$p(v1,"^",4)_"^"_newValRHS
							i propsimp s $p($$$mtL(log+3),"^",4,5)=$p(v1,"^",4)_"^"_newValRHS
							i propsimpdiv{ // propagate simplifications for sign conditions
								s mtv=$$$maxv
								s $$$mtV(mtv+1)="v^"_$s(oplhs="-":"+",1:"-")_"^,^"_$$$mtLOperand2($$$mtL(log+1))_"^"_$p(v,"^",5)_"^"
								s $p($$$mtL(log+1),"^",4,5)=$p(v1,"^",4)_"^"_(mtv+1)
								s $p($$$mtL(log+4),"^",4,5)=$p(v1,"^",4)_"^"_(mtv+1)
							}
						}elseif "*/"[oplhs{
							i ((oplhs="*")&&(lhs="nf")) {
								s operand1=$p(v1,"^",4)
								s newValLHS=$$$newval($p(v1,"^",1,3)_"^"_$p(v1,"^",5)_"^"_operand1_"^"),v1=$$$mtV(newValLHS)
							}
							s relem=$$$mtV($p(v1,"^",5))
							if ($e(relem)="t")||(op="=")||(op="'="){
								s newValRHS=$$$newval($p(v1,"^")_"^"_$s(oplhs="*":"/",1:"*")_"^,^"_$p(v,"^",5)_"^"_$p(v1,"^",5)_"^")
								s $p($$$mtL(log),"^",4,5)=$p(v1,"^",4)_"^"_newValRHS
								s:($p(relem,"^",2)<0) op=$$flipop(op),$$$mtLOperator($$$mtL(log))=op
								i propsimp s $p($$$mtL(log+3),"^",4,5)=$p(v1,"^",4)_"^"_newValRHS
							}else{ // we divide or multiply by an entity with unknown sign
								i decomp {QUIT} else{s decomp=1,propsimp=1}
								s mtl=$$$maxl,mtv=$$$maxv,$$$mtV(mtv+1)="t^0"
								s:($o(mt("noquconst",""),-1)'="") mt("noquconst",mtv+1)=1
								s newValRHS=$$$newval($p(v1,"^")_"^"_$s(oplhs="*":"/",1:"*")_"^,^"_$p(v,"^",5)_"^"_$p(v1,"^",5)_"^")
								s $p($$$mtL(log),"^",4,5)=$p(v1,"^",4)_"^"_newValRHS
								s $$$mtL(mtl+1)=$$$mtL(log)																		
								s $$$mtL(mtl+2)="v^>^,^"_$p(v1,"^",5)_"^"_(mtv+1)_"^"
								s $$$mtL(mtl+3)="l^&^"_fpos_"^"_(mtl+1)_"^"_(mtl+2)_"^"
								s $$$mtL(mtl+4)=$$$mtL(mtl+1)
								s $$$mtLOperator($$$mtL(mtl+4))=$$flipop(op)
								s $$$mtL(mtl+5)="v^<^,^"_$p(v1,"^",5)_"^"_(mtv+1)_"^"
								s $$$mtL(mtl+6)="l^&^"_fpos_"^"_(mtl+4)_"^"_(mtl+5)_"^"
								if (oplhs="/" ){
									s $$$mtL(log)="l^!^"_fpos_"^"_(mtl+3)_"^"_(mtl+6)_"^"
								}else{
									s $$$mtL(mtl+7)="l^!^"_fpos_"^"_(mtl+3)_"^"_(mtl+6)_"^"
									s $$$mtL(mtl+8)="v^=^,^"_$p(v1,"^",5)_"^"_(mtv+1)_"^"
									s $$$mtL(mtl+9)="v^"_op_"^,^"_(mtv+1)_"^"_rhs_"^"
									s $$$mtL(mtl+10)="l^&^,^"_(mtl+7)_"^"_(mtl+8)_"^"
									s $$$mtL(log)="l^!^"_fpos_"^"_(mtl+7)_"^"_(mtl+10)_"^"
								}
								s log=mtl+1,v=$$$mtL(log),lhsloc=$p(v,"^",4),v1=$$$mtV(lhsloc)
								continue
							}
						}
					}else{
						if (oplhs="-")||((oplhs="/")&&((op="=")||(op="'="))){
							s op=$$flipop(op)
							s $$$mtLOperator($$$mtL(log))=op
							s newValRHS=$$$newval($p(v1,"^",1,2)_"^,^"_$p(v1,"^",4)_"^"_rhs_"^")
							s $p($$$mtL(log),"^",4,5)=$p(v1,"^",5)_"^"_newValRHS
							i propsimp s $p($$$mtL(log+3),"^",4,5)=$p(v1,"^",5)_"^"_newValRHS,$$$mtLOperator($$$mtL(log+3))=$$flipop(op)
							i propsimpdiv{ // propagate simplifications for sign conditions
								s mtv=$$$maxv
								s $$$mtV(mtv+1)="v^-^,^"_$p(v1,"^",4)_"^"_$$$mtLOperand2($$$mtL(log+1))_"^"
								s $p($$$mtL(log+1),"^",4,5)=$p(v1,"^",5)_"^"_(mtv+1)
								s $p($$$mtL(log+4),"^",4,5)=$p(v1,"^",5)_"^"_(mtv+1)
								s $$$mtLOperator($$$mtL(log+1))=$$flipop($$$mtLOperator($$$mtL(log+1))),$$$mtLOperator($$$mtL(log+4))=$$flipop($$$mtLOperator($$$mtL(log+4)))
							}
						}elseif ((oplhs="/")&&(op'="=")&&(op'="='")){
							i decomp{QUIT}else{s decomp=1,propsimp=1,propsimpdiv=1}
							if ($$$mtVType($$$mtV(rhs))="t"){
								s mtl=$$$maxl,mtv=$$$maxv,$$$mtV(mtv+1)="t^0"
								s:($o(mt("noquconst",""),-1)'="") mt("noquconst",mtv+1)=1
								s newValRHS = $$$newval($p(v1,"^",1,2)_"^,^"_$p(v1,"^",4)_"^"_rhs_"^")
								s:($p($$$mtV(rhs),"^",2)>0) op=$$flipop(op),$$$mtLOperator($$$mtL(log))=op
								s $p($$$mtL(log),"^",4,5)=$p(v1,"^",5)_"^"_newValRHS
								s $$$mtL(mtl+1)=$$$mtL(log)
								s $$$mtL(mtl+2)="v^>^"_fpos_"^"_$p(v1,"^",5)_"^"_(mtv+1)_"^"
								s $$$mtL(mtl+3)="l^&^"_fpos_"^"_(mtl+1)_"^"_(mtl+2)_"^"
								s $$$mtL(mtl+4)=$$$mtL(log)
								s $$$mtLOperator($$$mtL(mtl+4))=$$flipop(op)
								s $$$mtL(mtl+5)="v^<^"_fpos_"^"_$p(v1,"^",5)_"^"_(mtv+1)_"^"
								s $$$mtL(mtl+6)="l^&^"_fpos_"^"_(mtl+4)_"^"_(mtl+5)_"^"
								s $$$mtL(log)="l^!^"_fpos_"^"_(mtl+3)_"^"_(mtl+6)_"^"
								s log=mtl+1,v=$$$mtL(mtl+1),lhsloc=$p(v,"^",4),v1=$$$mtV(lhsloc)
								continue
							}else {QUIT}						
						}
						else {QUIT}				
					}			
				}elseif $p(v1,"^",2)="-",($l(v1,"^")=5){ // If we have -(expression with a field in it), then multiply lhs and rhs by "-"
					set fieldExpressionNotNegated = $p(v1,"^",4)						// grab the underlying item originally negated in the LHS arg
					set newNegatedValue = $$$newval("v^-^,^"_$p(v,"^",5)_"^")	// add expression to mt that represents negation of the RHS
					s op=$$flipop(op)
					s $$$mtLOperator($$$mtL(log))=op
					s mtlupdate=fieldExpressionNotNegated_"^"_newNegatedValue
					s $p($$$mtL(log),"^",4,5)=mtlupdate
					i propsimp s $p($$$mtL(log+3),"^",4,5)=mtlupdate,$$$mtLOperator($$$mtL(log+3))=$$flipop(op)
					i propsimpdiv{ // propagate simplifications for sign conditions
						s $$$mtLOperand1($$$mtL(log+1))=fieldExpressionNotNegated,$$$mtLOperand1($$$mtL(log+4))=fieldExpressionNotNegated
						s $$$mtLOperator($$$mtL(log+1))=$$flipop($$$mtLOperator($$$mtL(log+1))),$$$mtLOperator($$$mtL(log+4))=$$flipop($$$mtLOperator($$$mtL(log+4)))
					}		
				}else{
					QUIT
				}
				s v=$$$mtL(log),lhsloc=$p(v,"^",4),v1=$$$mtV(lhsloc)
			}
			elseif $p(v1,"^",2)="DATEDIFF" { ; IBA049 re-write datediff conditions DATEDIFF(dp,date1,date2) op x
				s corr=$p(v1,"^",3)
				if $l(corr,",")=3{ ; there is only one field inside the datediff expression
					s datepartVal=$p(v1,"^",4) ; datepart argument of the DATEDIFF expression
					s rhsCondVal=$p(v,"^",5) ; RHS of the condition
					s date1v=$$$mtV($p(v1,"^",5)),date2v=$$$mtV($p(v1,"^",6)) ; dates to be diff'ed
					; IBA112: if date2 is the field in DATEDIFF(dp,date1,date2) op x,
					; re-write this as DATEDIFF(dp,date2,date1) flipop(op) -x
					i $p(date2v,"^")="f",",=,>,<,'>,'<,"[(","_op_",") { 
						s minusOne=$$$newval("t^-1")
						s prod=$$$newval("v^*^,^"_minusOne_"^"_$$$mtLOperand2($$$mtL(log))_"^")
						s op=$$flipop(op),$$$mtLOperator($$$mtL(log))=op, $$$mtLOperand2($$$mtL(log))=prod
						s newValLHS=$$$newval($$$mtV(lhsloc))
						s $p($$$mtV(newValLHS),"^",5,6)=$p(v1,"^",6)_"^"_$p(v1,"^",5),date1v=date2v,rhsCondVal=prod,v1=$$$mtV(newValLHS)
						s $$$mtLOperand1($$$mtL(log))=newValLHS
					}
					i $p(date1v,"^")="f",",=,>,<,'>,'<,"[(","_op_","){
						QUIT:'$$typeOk($p(v1,"^",5))
						s truncval=$$$newval("v^DATETRUNC^,^"_$p(v1,"^",4)_"^"_$p(v1,"^",6)_"^") ; DATETRUNC(dp,date2)
						s minusrhsval=$$$newval("v^-^,^"_rhsCondVal_"^") ; -x
						i op="="{
							s daddval=$$$newval("v^DATEADD^,^"_datepartVal_"^"_minusrhsval_"^"_truncval_"^") ; DATEADD(dp,-x,DATETRUNC(dp,date2))
							s logv1=$$$newlog("v^'<^"_corr_"^"_$p(v1,"^",5)_"^"_daddval_"^") ; date1>=DATEADD(dp,-x,DATETRUNC(dp,date2)) 
							s one=$$$newval("t^1")
							s minusrhsvalplusone=$$$newval("v^+^,^"_minusrhsval_"^"_one_"^") ; -x+1
							s daddval=$$$newval("v^DATEADD^,^"_datepartVal_"^"_minusrhsvalplusone_"^"_truncval_"^") ; DATEADD(dp,-x+1,DATETRUNC(dp,date2))
							s logv2=$$$newlog("v^<^"_corr_"^"_$p(v1,"^",5)_"^"_daddval_"^") ; date1<DATEADD(dp,-x+1,DATETRUNC(dp,date2))
							d replaceLog(log,logv1,logv2,corr)
						}elseif (op="'<")||(op="<"){
							s one=$$$newval("t^1")
							s minusrhsvalplusone=$$$newval("v^+^,^"_minusrhsval_"^"_one_"^") ; -x+1
							s daddval=$$$newval("v^DATEADD^,^"_datepartVal_"^"_minusrhsvalplusone_"^"_truncval_"^") ; DATEADD(dp,-x+1,DATETRUNC(dp,date2))
							s $$$mtL(log)="v^"_$s(op="'<":"<",1:"'<")_"^"_corr_"^"_$p(v1,"^",5)_"^"_daddval_"^"
						}elseif (op="'>")||(op=">"){            
							s daddval=$$$newval("v^DATEADD^,^"_datepartVal_"^"_minusrhsval_"^"_truncval_"^") ; DATEADD(dp,-x,DATETRUNC(dp,date2))
							s $$$mtL(log)="v^"_$s(op="'>":"'<",1:"<")_"^"_corr_"^"_$p(v1,"^",5)_"^"_daddval_"^"
						}
					}
				}
				QUIT
			}elseif $p(v1,"^",2)="DATEADD" {
				s corr=$p(v1,"^",3)
				if $l(corr,",")=3{ ; there is only one field inside the DATEADD expression
					s dpval=$p(v1,"^",4) ; datepart
					s rhsval=$p(v,"^",5) ;
					QUIT:'$$typeOk($p(v1,"^",6))
					s unitsv=$$$mtV($p(v1,"^",5)),date1v=$$$mtV($p(v1,"^",6))
						i $p(date1v,"^")="f",",=,>,<,'>,'<,"[(","_op_","){
						s minusdp=$$$newval("v^-^,^"_$p(v1,"^",5)_"^")
						s newValRHS=$$$newval($$$mtV(lhsloc))
						s $p($$$mtV(newValRHS),"^",5)=minusdp,$p($$$mtV(newValRHS),"^",6)=rhsval
						s $$$mtL(log)="v^"_op_"^"_corr_"^"_$p(v1,"^",6)_"^"_newValRHS_"^"
					}
				}
				QUIT
			}elseif $p(v1,"^",2)="CAST_DATE" {
				s corr=$p(v1,"^",3)
				if $l(corr,",")=3{ ; there is only one field inside the CAST_DATE expression
					s v11=$$$mtV($p(v1,"^",4))
					QUIT:($e(v11))'="f"
					s dval=$p(v1,"^",4),rhsval=$p(v,"^",5) ;
					; mt("vtr") is not filed at this point, so we use $$$smd to get the datatype of the field 
					s str=$p(v11,"^",2),ifn=$p(v11,"^",3),irn=+$$$mtR(str),type=$$GetType^%qadfld2(irn,ifn)
					s type=$case(type,"%Library.PosixTime":"POSIXTIME","%Library.TimeStamp":"TIMESTAMP",:"")
					QUIT:type=""
					QUIT:",=,'<,<,'>,>,"'[(","_op_",")
					#; IBA122 - this will ensure the RHS of the condition gets filed as a Date
					d createlog^%qaqpdt(log)
					s castop="CAST_"_type
					if op="="{
						s dpval=$$$newval("t^dd"),oneval=$$$newval("t^1")
						s daddval=$$$newval("v^DATEADD^,^"_dpval_"^"_oneval_"^"_rhsval_"^")
						s casttsval=$$$newval("v^"_castop_"^,^"_rhsval_"^")
						s log1=$$$newlog("v^<^"_corr_"^"_dval_"^"_daddval_"^"),log2=$$$newlog("v^'<^"_corr_"^"_dval_"^"_casttsval_"^")
						d replaceLog(log,log1,log2,corr)
					}elseif op="'<"{
						s casttsval=$$$newval("v^"_castop_"^,^"_rhsval_"^")
						s $p($$$mtL(log),"^",4,5)=dval_"^"_casttsval	
					}elseif op=">"{
						s dpval=$$$newval("t^dd"),oneval=$$$newval("t^1")
						s daddval=$$$newval("v^DATEADD^,^"_dpval_"^"_oneval_"^"_rhsval_"^")
						s $$$mtLOperator($$$mtL(log))="'<",$p($$$mtL(log),"^",4,5)=dval_"^"_daddval
					}elseif op="'>"{
						s dpval=$$$newval("t^dd"),oneval=$$$newval("t^1")
						s daddval=$$$newval("v^DATEADD^,^"_dpval_"^"_oneval_"^"_rhsval_"^")
						s $$$mtLOperator($$$mtL(log))="<",$p($$$mtL(log),"^",4,5)=dval_"^"_daddval
					}elseif op="<"{
						s casttsval=$$$newval("v^"_castop_"^,^"_rhsval_"^")
						s $p($$$mtL(log),"^",4,5)=dval_"^"_casttsval
					}
					k $$$mtVtr("-"_log)
				}
				QUIT
			}elseif $p(v1,"^",2)="DATETRUNC" {
				s corr=$p(v1,"^",3)
				if $l(corr,",")=3{ ; there is only one field inside the DATEADD expression
					s dpval=$p(v1,"^",4) ; datepart
					s rhsval=$p(v,"^",5) ;
					s dval=$p(v1,"^",5)
					QUIT:$$$mtVType($$$mtV(dval))'="f"
					QUIT:'$$typeOk(dval)
					s dtruncval=$$$newval("v^DATETRUNC^,^"_dpval_"^"_rhsval_"^")
					s oneval=$$$newval("t^1")
					s daddval=$$$newval("v^DATEADD^,^"_dpval_"^"_oneval_"^"_rhsval_"^")
					s daddtruncval=$$$newval("v^DATEADD^,^"_dpval_"^"_oneval_"^"_dtruncval_"^")
					s poslog=$l($p("^"_$g($$$mtWhere(m)),"^"_log_"^"))+1
					if op="=" {
						s log1=$$$newlog("v^=^,^"_rhsval_"^"_dtruncval_"^")
						s log2=$$$newlog("v^'<^"_corr_"^"_dval_"^"_dtruncval_"^")
						s log3=$$$newlog("v^<^"_corr_"^"_dval_"^"_daddval_"^")
						; now replace log with log1 & log2 & log3
						s posw=$f("^"_$g($$$mtWhere(m)),"^"_log_"^")
						if posw=0 {
							s log4=$$$newlog("v^&^"_corr_"^"_log2_"^"_log3_"^")
							s $$$mtL(log)="l^&^"_corr_"^"_log1_"^"_log4_"^"
						} else {
							s poslog=$l($p("^"_$g($$$mtWhere(m)),"^"_log_"^"))+1
							s $e($$$mtWhere(m),poslog,poslog+$l(log))=log1_"^"_log2_"^"_log3_"^"
						}
					}elseif op="'<" {
						s log1=$$$newlog("v^'<^"_corr_"^"_dval_"^"_dtruncval_"^")
						s log2=$$$newlog("v^'<^"_corr_"^"_dval_"^"_daddtruncval_"^")
						s log3=$$$newlog("v^=^,^"_rhsval_"^"_dtruncval_"^")
						s log4=$$$newlog("l^!^"_corr_"^"_log2_"^"_log3_"^")	
						d replaceLog(log,log1,log4,corr)
					}elseif op=">" {
						s $$$mtLOperator($$$mtL(log))="'<"
						s $p($$$mtL(log),"^",4,5)=dval_"^"_daddtruncval
					}elseif op="'>" {
						s $$$mtLOperator($$$mtL(log))="<"
						s $p($$$mtL(log),"^",4,5)=dval_"^"_daddtruncval
					}elseif op="<" {
						s log1=$$$newlog("v^<^"_corr_"^"_dval_"^"_daddtruncval_"^")
						s log2=$$$newlog("v^<^"_corr_"^"_dval_"^"_rhsval_"^")
						s log3=$$$newlog("v^>^,^"_rhsval_"^"_dtruncval_"^")
						s log4=$$$newlog("l^!^"_corr_"^"_log2_"^"_log3_"^")
						d replaceLog(log,log1,log4,corr)
					}
				}
				QUIT
			} elseif $p(v1,"^",2)="YEAR" {
				s corr=$p(v1,"^",3)
				if $l(corr,",")=3{ ; there is only one field inside the CAST_DATE expression
					s v11=$$$mtV($p(v1,"^",4))
					QUIT:($e(v11))'="f" ;i; maybe allow cast expressions?
					s fldVal=$p(v1,"^",4),rhsval=$p(v,"^",5)
					; mt("vtr") is not filed at this point, so we use $$$smd to get the datatype of the field 
					s str=$p(v11,"^",2),ifn=$p(v11,"^",3),irn=+$$$mtR(str),type=$$GetType^%qadfld2(irn,ifn)
					s type=$case(type,"%Library.Date":"DATE","%Library.TimeStamp":"TIMESTAMP","%Library.PosixTime":"POSIXTIME",:"")
					QUIT:type=""
					s castOp="CAST_"_type
					if op="="{
						s concatMMDD=$$$newval("t^-01-01"),fullDateVal=$$$newval("v^_^^"_rhsval_"^"_concatMMDD_"^")
						s castVal1=$$$newval("v^"_castOp_"^,^"_fullDateVal_"^")
						s oneVal=$$$newval("t^1"),yearPlusOneVal=$$$newval("v^+^^"_rhsval_"^"_oneVal_"^")
						s fullDateVal=$$$newval("v^_^^"_yearPlusOneVal_"^"_concatMMDD_"^")
						s castVal2=$$$newval("v^"_castOp_"^,^"_fullDateVal_"^")
						s log1=$$$newlog("v^<^"_corr_"^"_fldVal_"^"_castVal2_"^"),log2=$$$newlog("v^'<^"_corr_"^"_fldVal_"^"_castVal1_"^")
						d replaceLog(log,log1,log2,corr)
					}elseif op="'<"{
						s concatMMDD=$$$newval("t^-01-01"),fullDateVal=$$$newval("v^_^^"_rhsval_"^"_concatMMDD_"^")
						s castVal=$$$newval("v^"_castOp_"^,^"_fullDateVal_"^")
						s $p($$$mtL(log),"^",4,5)=fldVal_"^"_castVal
					}elseif op=">"{
						s oneVal=$$$newval("t^1"),yearPlusOneVal=$$$newval("v^+^^"_rhsval_"^"_oneVal_"^")
						s concatMMDD=$$$newval("t^-01-01")
						s fullDateVal=$$$newval("v^_^^"_yearPlusOneVal_"^"_concatMMDD_"^")
						s castVal=$$$newval("v^"_castOp_"^,^"_fullDateVal_"^")
                        s $$$mtLOperator($$$mtL(log))="'<",$p($$$mtL(log),"^",4,5)=fldVal_"^"_castVal
					}elseif op="'>"{
						s oneVal=$$$newval("t^1"),yearPlusOneVal=$$$newval("v^+^^"_rhsval_"^"_oneVal_"^")
						s concatMMDD=$$$newval("t^-01-01")
						s fullDateVal=$$$newval("v^_^^"_yearPlusOneVal_"^"_concatMMDD_"^")
						s castVal=$$$newval("v^"_castOp_"^,^"_fullDateVal_"^")
						s $$$mtLOperator($$$mtL(log))="<",$p($$$mtL(log),"^",4,5)=fldVal_"^"_castVal
					}elseif op="<"{
						s concatMMDD=$$$newval("t^-01-01"),fullDateVal=$$$newval("v^_^^"_rhsval_"^"_concatMMDD_"^")
						s castVal=$$$newval("v^"_castOp_"^,^"_fullDateVal_"^")
						s $p($$$mtL(log),"^",4,5)=fldVal_"^"_castVal
					}
				}
				QUIT
			}
			else{
				QUIT
			}	
		}
	}		
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
replaceLog(log,log1,log2,corr) [mt,m] PUBLIC { ; this function replaces a log in mt("w") with two conditions log1 and log2 
	s posw=$f("^"_$g($$$mtWhere(m)),"^"_log_"^")
	if posw=0 {
		s $$$mtL(log)="l^&^"_corr_"^"_log1_"^"_log2_"^"
	} else {
		s poslog=$l($p("^"_$g($$$mtWhere(m)),"^"_log_"^"))+1
		s $e($$$mtWhere(m),poslog,poslog+$l(log))=log1_"^"_log2_"^"
	}
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
flipop(op) PUBLIC { ; flip the operation due to multiplication by -1
    Quit $case(op,"=":"=",">":"<","'>":"'<","<":">","'<":"'>",:op)
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
checkVTRCat(val) [mt] PUBLIC {
	RETURN:val="" ""
	m tvtr=mt("vtr") // save current mt("vtr")
	do createval^%qaqpdt(val)
	set vtrCat=$$$VTRgetcat(val)
	k mt("vtr")
	m mt("vtr")=tvtr // revert mt("vtr")
	RETURN vtrCat
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
typeOk(fval) [mt] PUBLIC {  ; IBA148: custom/non-native datatypes should not undergo this optimization
	#; return 1 if the datatype is safe for datetime condition re-writes
	s fldInfo=$$$mtV(fval)
	QUIT:$e(fldInfo)'="f" 0
	s str=$p(fldInfo,"^",2),ifn=$p(fldInfo,"^",3),irn=+$$$mtR(str),type=$$GetType^%qadfld2(irn,ifn)
	RETURN $case(type,"%Library.Date":1,"%Library.PosixTime":1,"%Library.TimeStamp":1,:0)
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
viewsize
#; ++ HSU299 copy the optimizer's predicted statistis for the view into mts
	n USEREALVIEWSIZE s USEREALVIEWSIZE = 0
	#; HSU299 is disabled since not all of the queries could benifir from this mechanism.
	#; For the query with nested view, the plan seems subpar.
	#; To enable this feature in the future, s USEREALVIEWSIZE = 1 
	if 'USEREALVIEWSIZE QUIT 
	n iv,vcost,vtup,vblk,vqb,r
	f iv=maxm:-1:1 {
		s vqb=mt("qbo",iv)
		if '$$$mtPQbIsActive(vqb) continue
		if $g($$$mtDupsv(vqb)) continue
		f r=1:1:$$$mtRNumStreams{
			if $g($$$mtRVirtual(r))=vqb,$g($$$mtUnion(vqb))=""{
				s vcost = $$quickcost^%qaqomul(vqb,'$g($$$mtGroupDistinctList(vqb)),,1)
				s $p(mts($$$mtRQb($$$mtR(r)),r),"^",1) = $p(vcost,",",1)
				s $p(mts($$$mtRQb($$$mtR(r)),r),"^",2) = $p(vcost,",",2)
				quit
			}
		}
	}
	QUIT
#; -- HSU299	
	// Given a value 'v' and a collated null value, return the value to use as a null marker
	// Called from %qaqpnl and recursivly
colnm(v,colnull) [mt] public {
	set v=$$$mtV(v)
	if $e(v)'="f"   RETURN $$$NULLSubscriptMarker19q
	set ifn=$p(v,"^",3)
		#; Collated field use -1E14, unless colnull is space in which case we do not need null marker or %PLUS/%MINUS?
	RETURN:ifn'=+ifn $s(colnull=" "||(colnull=0):"",1:$$$NULLSubscriptMarkerq)
	RETURN:$d($$$mtVirf(ifn),v)&&$li(v) $$colnm($li(v,2),colnull) ; recurse into view field, (see AK570)
	set nm=$$$smdColParam(1,$$$smdGetIrnFromIfn(ifn),ifn,"INDEXNULLMARKER")
	RETURN $s(nm="":$$$NULLSubscriptMarkerq,1:nm)
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK688
filter	;  called from ^nl->lvtree with type,val,v,ev - if it's %INSUB/%INBIT,
	#;  with t.%ID as arg1 and a streamless arg2, then generate a DPV3554
	#;  "adhoc" computed field {t.g}=arg2.ContainsItem({t.%ID}), and
	#;  convert the condition to (t.g=1)
	QUIT:$e(v,1,4)="l^'^"  ;  do NOT recurse for NOT
	GOTO lvarg:ev="l"  ;  recurse down for AND/OR
	QUIT:$e(v,1,5)'="v^%IN"  ;  but not for anything else
	i $e(v,1,8)="v^%INSUB" s $$$mtLOperator($$$mtL(val))="%FIND" QUIT  ;  *** remove line when %INSUB implemented!
	s val1=$p(v,"^",4),v1=$$$mtV(val1)
	QUIT:$e(v1)'="f"
	s str=$p(v1,"^",2),idifn=$p(v1,"^",3)
	QUIT:$p(mts(m,str),"^",5)'=idifn  ;  verify it's the rowid
	s val2=$p(v,"^",5),v2=$$$mtV(val2)
	QUIT:($p(v2,"^",3)'=",")&&("tx"'[$e(v2))  ;  arg2 must be streamless
	s irn=+$$$mtR(str)  ;  for %INBIT, must have an extent bitmap
	i $e(v,1,8)="v^%INBIT",'$$$smdBitmapExtentMap(1,irn) QUIT
	#;  add new adhoc computed field, replace condition, redo $$lflds(log)
	s ifn=$$AddFakeCompField^%qTable(irn,$lb("*v"),idifn,$s($p(v,"^",6):mts(m,str)/$e($$$mtV($p(v,"^",6)),3,*),1:20))
	s $li($$$smd(1,irn,2,ifn),3)="Y"  ;  make it required
	s $$$mtFilter(ifn)=$e(v,3,8)_","_val2_","_idifn  ;  record operation and oref
	s fval=$$$newval("junk",1) d nuatt^%qaqpqo(fval,str,ifn)
	s $$$mtL(val)="v^=^,"_fval_",^"_fval_"^"_$$$newval("t^1",1)_"^"
	d lflds("l",log,"do")  ;  redo field lists for this top WHERE condition
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK688-
	#; AK691
dsn	n str,m,dsn,tm,untop  ;  discover DSN's for each subquery - first
	#;  determine $$$mtDSNBase(m)=$LB(dsn) - sources of all the query's FROM
	#;  basetables (currently, any table found forces $$$mtDSNLinkedTable(m) , which
	#;  is the subquery's final processing location)
	f str=1:1:maxs {
		CONTINUE:$d($$$mtRVirtual(str))  ;  it's not a base table
		s m=$$$mtRQb($$$mtR(str))
		CONTINUE:'$$$mtPQbIsActive(m)
	#; AK805
	#;  FROM-less query - could be processed anywhere
		CONTINUE:$$$mtFromList(m)=$lb("%TSQL_sys.snf")
	#; AK805-
	#; AK849
		CONTINUE:$g($$$mtDSNLinkedTable(m))=" "  ;  marked to run in parallel
		s dsn=$$ddcon(+$$$mtR(str))
		s:'$lf($g($$$mtDSNBase(m)),dsn) $$$mtDSNBase(m)=$g($$$mtDSNBase(m))_$lb(dsn)
		d addsn(m,dsn)
	}
	#;  go bottom->up, force queries to be processed in the same place as
	#;  their subqueries, if any, or locally in case of conflict
	#;  $$$mtDSNLinkedTable(m)=dsn - empty if processed locally
	f tm=$$$mtPNumQbs:-1:1 {
		s m=$g(mt("qbo",tm))
		CONTINUE:'$$$mtPQbIsActive(m)
	#; AK805
		CONTINUE:'$d($$$mtDSNLinkedTable(m),dsn)  ;  has not been assigned yet
	#; AK849
		CONTINUE:dsn=" "  ;  marked to run in parallel
		d addsn(+$$$mtP(m),dsn)  ;  force superquery process location
	}
	#; AK805
	#;  go top->down, any subquery still not assigned (i.e. it and any
	#;  subqueries it has specify no basetables at all - mostly queries
	#;  with no FROM) are forced to be processed in the same place as
	#;  their superquery, or else locally
	f tm=1:1:$$$mtPNumQbs {
		s m=$g(mt("qbo",tm))
		CONTINUE:'$$$mtPQbIsActive(m)
		s:'$d($$$mtDSNLinkedTable(m),dsn) (dsn,$$$mtDSNLinkedTable(m))=$g($$$mtDSNLinkedTable(+$$$mtP(m)))
	#; AK856
		s:$d($$$mtUnionTopQb(m),untop)&&'$lf($g($$$mtUnionTopDSN(untop)),dsn) $$$mtUnionTopDSN(untop)=$g($$$mtUnionTopDSN(untop))_$lb(dsn)
	    if dsn'=""
	    {  merge mt("hintsave",m)=mt("hint",m) s mt("hintsave",m)=1 // PVA307: must remember even null state of user specified hints
	       f str="%NOFLATTEN","%NOSVSO","%NOTOPOPT","%NOMERGE","%NOUNIONOROPT" s mt("hint",m,str)=1  ;  AK721;AK757
	    }
	}
	#; AK805-
	QUIT
	;#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
isLinked(m) [ mt ] PUBLIC {
	#; Does it even have a DSN?
	If $g($$$mtDSNLinkedTable(m)) = "" QUIT 0
	#; Is it also sharded? If not, it's linked.
	#; UNION %PARALLEL subqueries are treated identically
	#; to linked table queries in the preoptimizer.
	QUIT '($$isSharded(m))
}
isParallel(m) [ mt ] PUBLIC {
	QUIT $g($$$mtDSNLinkedTable(m)) = " "
}
isSharded(m) [ mt ] PUBLIC {
	QUIT ($g($$$mtDSNLinkedTable(m)) = "~")|| $g(mt("shtop",m))
}
isShardedTop(m) [ mt ] PUBLIC {
	QUIT $$isSharded(m) && ($g(mt("shtop",m)) = m)
}
isShardedNotTop(m) [mt] PUBLIC {
	QUIT $$isSharded(m) && (mt("shtop",m) '= m)
}
willRegenerate(m) PUBLIC {
	QUIT $$isLinked(m) || $$isParallel(m) || $$isSharded(m) || +$g($$$FTRegeneratedQueryBlock(m))
}
willPartition(m) PUBLIC {
	QUIT $$isParallel(m) || $$isSharded(m)
}
/// Returns true if the query is executed on 
/// a shard server.
isShardedLocal() [ mt ] PUBLIC {
	RETURN $g(mt("options","shardLocalQuery"),0)
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA342
killshardinfo(m) [mt] PUBLIC 
{ 
   k mt("cosh",m),mt("alst",m),$$$mtShardedTables(m),mt("shrows",m)  ;  AK985
   s qn="" for // have to kill all because which are sharded can SHRINK after a view merge that brings up an outer join
   {  s qn=$o(mt("shtop",qn),1,tp) q:qn=""
      k:tp=m mt("shtop",qn),mt("shardext",qn)
   }
}
shardown(pqb) [mt] PUBLIC
{
    #; PVA342: discard and re-derive all sharding information from pqb down
    d killshardinfo(pqb)
	s mt("shtop",pqb)=pqb
	d cosh(pqb) 
	s:mt("cosh",pqb)'="" mt("shardext",pqb)=$$$smdExtent(1,$$$mtRIrn($$$mtR($li($li(mt("cosh",pqb)))))) // garbage for Jeff
	#;  get subqueries from mt("g") and aggregates for asl/codegen  ;  PVA342;AK985
	i '$$shardGrp(pqb)||$$needsOJfilter^%qaqpqo1(pqb) { s mt("shrows",pqb)=1 }
	#;  mark for query reconstruction all subqueries of the  ;  AK1021
	#;  shard-top pqb, but skip non-FROM query blocks with no
	#;  correlated fields from within pqb!
	#;  For union legs, FROM subqueries are always marked;
	#;  Non-FROM union legs marked only if they have correlated fields from
	#;  within pqb, the rest are processed on the master
	s topqcorr=$$$mtPCorrelatedFields($$$mtP(pqb))
	f mTopo=2:1:$$$mtPNumQbs {
		s m=$g(mt("qbo",mTopo))
		#;  if m has no correlated fields (except from  ;  AK1021
		#;  topq's ancestors), and if it's not a FROM subquery, then
		#;  it will not be included in topq's sharded query
		i $$$mtPQbIsActive(m),$g(mt("shtop",m))'=pqb,$g(mt("shtop",+$$$mtP(m)))=pqb,$$sendqb(m,topqcorr) {
			d killshardinfo(m) s mt("shtop",m)=pqb
			d:pqb=+$$$mtP(m) coshsubq(pqb,m)  ;  JMM912
		}
	}
	RETURN
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
sendqb(m,topqcorr)  ;  $$: 1 iff m is a FROM subquery (or UNION  ;  AK1021
	#;  leg), or a non-FROM qb (or UNION leg) with correlated fields from
	#;  within pqb, where topqcorr are pqb's own correlated fields
	RETURN:$$$mtCorrParentQb(m)'=+$$$mtP(m) 1  ;  FROM subq (or UNION leg)
	#;  don't apply to m if inside a Gateway dsn subtree, but
	RETURN:$$inext(m) 1  ;  could apply to the top Gateway query block
	RETURN:$$remove^%qaqpmod($$$mtPCorrelatedFields($$$mtP(m)),topqcorr)="" 0
	RETURN:$g($$$mtUnionTopQb(m))'=m 1
	#;  it's the union top, $P(4) includes pqb fields, but they
	#;  could all be in other UNION legs - gotta search in m!
	n nvals,li s nvals=$$listreeqb(m,$lb("n^"))  ;  list of "n" nodes in m itself
	i topqcorr="",nvals'="" { RETURN 1 }
	f li=1:1:$ll(nvals) RETURN:(","_topqcorr'[(","_$p($$$mtV($li(nvals,li)),"^",4)_",")) 1
	RETURN 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
inext(m)  ;  $$: 1 if m is part of a Gateway subquery, other than its top!
	f  s m=+$$$mtP(m) RETURN:'m 0 RETURN:$g(mt("ext",m))'="" 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
shardGrp(pqb) [mt,found,call] PUBLIC  // returns 1 if can send GROUP BY/ aggregates to shard; 
               //otherwise just send up to WHERE and post compute rest; Until this is implemented,
               // can use this as a test for supportable cases. This assumes qaqpnl structures not parse time
               // structures. 
{   n found,call
	#; NOTE: only top level aggs listed in $$$mtP(qno) piece 3. 
	s shardGrp=1 // Assume we will send GROUP BY and aggregates
	s aggs=$$$mtPAggList($$$mtP(pqb))
	if aggs'="" 
	{  for i=1:1:$l(aggs,",")-1
	   {  s aggv=$p(aggs,",",i)
	      #;  if $p($$$mtV(aggv),"^",7)'="" {s shardGrp=0 quit} // agg with DISTINCT [BY] found  ;  removed by AK978
	      if $p($$$mtV(aggv),"^",4) {s shardGrp=0 quit} // %afterhaving  found
	   	  s aggl=$$listree^%qaqpagg("v",aggv,"a")
	      if $l(aggl,",")>2 {s shardGrp=0 quit } // agg of agg found
	      #; check functional dependencies of %foreach on mt("g")
	      if '$$fd^%qaqpre3($g($$$mtGroupDistinctList(pqb)),$p($$$mtV(aggv),"^",6)) {s shardGrp=0 quit} 
	   }
	}
	if shardGrp && $g($$$mtHaving(pqb))   // check HAVING clause for fields not in aggregates that are not FD of mt("g")
	{  s glist=$g($$$mtGroupDistinctList(pqb)) s found=""
	   s call="noagf^%qaqpag"  ;  return them in found=$LIST(val#)
	   d lvtree^%qaqpnl("l",$$$mtHaving(pqb))
	   s:found'="" found=$listtostring(found)_","
	   if '$$fd^%qaqpre3(glist,found) {s shardGrp=0}
	   #; OPPORTUNITY: if the HAVING uses no aggregates, even if nonstandard, it can processed on shards
	}
	QUIT shardGrp
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
addsn(m,dsn)  ;  update $$$mtDSNLinkedTable(m) based on new dsn
	QUIT:'m
	i '$d($$$mtDSNLinkedTable(m)) s $$$mtDSNLinkedTable(m)=dsn QUIT
	QUIT:$$$mtDSNLinkedTable(m)=dsn
	#; AK805
	#;  for now, cannot process locally if linked table in FROM
	d:$LB("")'[$g($$$mtDSNBase(m)) error(161)
	#; AK805-
	s $$$mtDSNLinkedTable(m)=""  ;  heterogeneous - must be processed locally
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddcon(irn) QUIT $$$smdConnection(1,irn)  ;  connection information  ;  DPV3500
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK691-
	#;  PVA183: create prunesort to centralize constant elimination from ORDER BY
prunesort(sp)
	f lx=$l(sp,",")-1:-1:1 s val=+$p(sp,",",lx),v=$$$mtV(val) s:("tx"[$e(v))||(($p(v,"^",3)=",")&&'$$findtree("v",val,"a"))&&'$$windows^%qaqpagg(val) $p(sp,",",lx,*)=$p(sp,",",lx+1,*)
	QUIT sp
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA108: new utility for nulstr maintenance; support all join types
setnulstr(m) n lx,xa,xb,log,node,op,i
	f lx=1:1 s log=$p(linx,"^",lx) q:'log  s:m=$$$mtRQb($$$mtR($p($$$mtV($$$mtLOperand2($$$mtL(log))),"^",2))) nulstr=nulstr_$lb($p($$$mtV($$$mtLOperand2($$$mtL(log))),"^",2))
	#; PVA092: Change for new mt("ON",) structure; also do for all m. 
	#; PVA087: Also figure it out for ON clauses
	s lx="" f { s lx=$o($$$mtOn(m, lx),1,node) q:lx=""
	      s xb =$li(node,4),xa=$li(node,3),op=$li(node)
	      if op="LEFT" || (op="FULL") f i=1:1:$ll(xb) s nulstr=nulstr_$lb($$$ptrel(m_"^"_$li(xb,i)))
	      if op="FULL" f i=1:1:$ll(xa) s nulstr=nulstr_$lb($$$ptrel(m_"^"_$li(xa,i)))
	}
	quit
#; PVA348: create CheckLateralOJ,batLatRef	
CheckLateralOJ() [mt,linx] PUBLIC // Check that lateral references are not to the wrong side of an outer join
{
	f lx=1:1 {
		s log=$p(linx,"^",lx) q:'log 
       s lstr = $$$mtV($$$mtLOperand1($$$mtL(log))) continue:$e(lstr)'="f"
       s lstr=$p(lstr,"^",2)
       s rstr = $p($$$mtV($$$mtLOperand2($$$mtL(log))),"^",2)
       d badLatRef($lb(lstr),$lb(rstr)) 
	}
	s m="" f  {
		s m=$o($$$mtOnRoot(m)) q:m=""
 	   s lx="" f 
	   { s lx=$o($$$mtOn(m, lx),1,node) q:lx=""
	      s xb =$li(node,4),xa=$li(node,3),op=$li(node)
	      s lstr="" f i=1:1:$ll(xa) {s lstr=lstr_$lb($$$ptrel(m_"^"_$li(xa,i)))}
	      s rstr="" f i=1:1:$ll(xb) {s rstr=rstr_$lb($$$ptrel(m_"^"_$li(xb,i)))}
	      if (op="LEFT")||(op="FULL") d badLatRef(lstr,rstr)
	      if op="FULL" d badLatRef(rstr,lstr)
	   }
	}
}
badLatRef(lstr,rstr) [nolatf] PUBLIC // is there a lateral reference from any lstr to any rstr? 
{
	f li=1:1:$ll(lstr) f ri=1:1:$ll(rstr) s nolatf($li(rstr,ri),$li(lstr,li))=""
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF048
propagatePreds(direction,phase)
	n ojkilled,ijmrg,call,foundNonStdAgg,lgi,li,vli,vals,viewFvals,xlate,viewSpConds,vmerged,logs
	#;HSU267+
	n qb,listq,q,newlistq 
	#;HSU267-
	#; Propagates predicates down (direction=1) or up (direction=-1) the query graph.
	#; phase: 
	#;		1 - first call 	- merge streamed views, TOP processing, plus multi-phase optimizations
	#;		2 - second call	- notnull processing, expand class methods, plus multi-phase optimizations
	#; 
	#; PVA087: direction flag currently disabled, because new query blocks are added to
	#;         the end as we go.
	for mTopo=1:1									; in top-down topological order - JLF128
	{	q:mTopo>maxm 								; note maxm changes as we go
		d calcQBOrder(mTopo)						; Recompute the topological order above mTopo - JLF128
		s m=$g(mt("qbo",mTopo)) 
		continue:m=0||'$$$mtPQbIsActive(m)				; ignore qb's that are marked inoperative
		continue:$d($$$mtDupsv(m))					; ignore qb's that are duplicate views - JLF125
		#; PVA197: force empty for TOP 0
		s vli=$g($$$mtV($g($$$mtTopArg(m),0)))
		i $e(vli)="t",+$e(vli,3,*)<1 s $$$mtEmpty(m)=1 k $$$mtWhere(m),$$$mtTopArg(m),$$$mtOneRow(m) continue
		//Combine implicit =*, -> and explicit "LEFT JOIN" outer joins as supported
		//If mt("j") is constructed from linx here, it needs to be redone after undoSideEffects
		if $$willRegenerate(m) Do mergeOldAndNewJoins(m,phase)
		if $$isLinked(m)||$$isParallel(m),phase=1 {
			//For gateway, UNION %PARALLEL subqueries, we'll pushlog WHERE conditions, but nothing else.
			s logs=$g($$$mtWhere(m)) f lgi=$l(logs,"^")-1:-1:1 s log=$p(logs,"^",lgi) d:direction=1 pushlog(log,"w") // d:direction=-1 pulllog(log)
			//Clear subquery-specific data structures built during pushlog.
			k viewFvals,xlate s viewSpConds=""
		}
		if $$isLinked(m)||$$isParallel(m) continue
		#; The jsv optimization adds a correlated inner join condition to a view when
		#; that view is on the right side of a LOJ.  Though correlations to streams
		#; within the same containing query block is not valid in general, it is valid
		#; in this case because of the join order restriction imposed by the LOJ.
		#; To prevent the view from being evaluated too many times, this is only done
		#; when the view does not contain views that are themselves OJ targets
	#; AK683
		d:phase=2 jsv^%qaqpre3  ;  maybe make streamed view m "joined" (checks many things: dsn, sharding etc.)
		d pointifyON^%qaqpre2(m)  ; add ON clause parent pointers - JLF131
		#; PVA124: move notnull again, conditional on phase
		#; PVA099: move notnull processing later
	#; AK954
		i phase=2 { d:'$$isSharded(m) notnullw(m,1) s:$d($$$mtHaving(m)) $$$mtHaving(m)=$$notnullh($$$mtHaving(m)) }
		#; PVA087: make loop to simplify + kill outer joins, till no more done.
		for
		{	s ijmrg=$$migrateIJ^%qaqpre3(m)			; move IJs that are not on null-padded side of ON to WHERE clause - JLF131
			d removeRedundant^%qaqpre2(m)			; can set mt("empty",m)
			q:$g($$$mtEmpty(m))
			s call="nopad"
			s logs=$g($$$mtWhere(m)) f  s log=+logs,logs=$p(logs,"^",2,*) q:'log  d lvtree("l",log)
			s ojkilled=$$killojs^%qaqpre2(m)		; move LJs that do not pass nulls to WHERE clause
			#; PVA140: look for new factor opportunies if added to WHERE clause
			if ojkilled||ijmrg s logs=$g($$$mtWhere(m)) f lgi=$l(logs,"^")-1:-1:1 s log=$p(logs,"^",lgi) d factorCommonAnds^%qaqpre(m,log,0)
			if ojkilled||ijmrg,phase=2 d notnullw(m,1)
			d removeRedundant^%qaqpre2(m)			; can set mt("empty",m)
			q:$g($$$mtEmpty(m))
			#; PVA124: only merge views in phase 1
			#; PVA289: Now safe to do in both phases; PVA291: donull arg for mergeview
			s vmerged=$$mergeviews^%qaqpre2(m,phase=2) 	; merge streamed views into containing qb - PVA099: added mergeviews
			q:$g($$$mtEmpty(m))
			q:('ojkilled && 'vmerged)
		}
		
		#;HSU267+,HSU287+
		#;if $g(mt("empty",m)),phase=1 {
		#;if $g(mt("empty",m)),$d($$$mtUnionTopQb(m),qb),qb'=m {
		#;we should only try to remove "m" which is the leaf of mt("union") tree,otherwise, we may break the tree into a graph.
		#;Doing HSU267 here is actually not ideal, we should do HSU267 in a postorder traveral (instead propagatePreds traverse in preorder way.)
		n unlegs,poslist,posqb
		#; YCL105 Note that a "onerow" subquery with mt("empty") still returns a single row
		if $g($$$mtEmpty(m)),'$g($$$mtOneRow(m)),$g($$$mtUnion(m))="" {
  			#;now traverse $$$mtUnion(qb)
  			
  			#;collect all the union legs in advance, instead of collecting during next for loop. 
  			s qb = "" f { s qb = $o($$$mtUnion(qb),1,listq) q:qb=""  s unlegs = $g(unlegs)_listq }
			
			s qb = "" f {
				s qb = $o($$$mtUnion(qb),1,listq)
				q:qb=""
				
				
				#;if "m" is the last UNION DISTINCT leg of listq, we should not remove it since dedup.
				if $lf(listq,m_"d") {
					n lastone s lastone = 0
					n qq f qq=($lf(listq,m_"d")+1):1:$ll(listq) if $f($li(listq,qq),"d") s lastone = 1 quit 
					quit:lastone=0
				}				
				#;to push mt("uns") to $$$mtSequencersQb(1), we have to create the brand new mt("v") for this new expression.
				#;For now, we don't handle this.
				if qb=1,listq=$lb(m_"a"),$g($$$mtUnionOrderBy) quit
				
				continue:('$lf(listq,m_"a"))&&('$lf(listq,m_"d"))
					
				s poslist = $lf(listq,m_"a") + $lf(listq,m_"d")
				s posqb =   $lf(unlegs,qb_"a") + $lf(unlegs,qb_"d")
				
				if poslist,($ll(listq)>1){
					#; since already checked $g($$$mtUnion(m))="" in the beginning, it is safe to remove "m"
					s $li($$$mtUnion(qb),poslist,poslist)=""
					s $$$mtPQbIsActive(m)=0 k $$$mtUnionLegVals(m) k $$$mtUnionTopQb(m)
				}
				elseif poslist,'posqb,$ll(listq)=1{
					#; For this case, we also need to obsolete "qb" after "m" is obsolete.
					#; check 'posqb to confirm qb is also not referenced in the mt("union") tree.
					#; so we are sure that the tree from $$$mtUnion(qb) is not needed anymore.  
					s $li($$$mtUnion(qb),poslist,poslist)=""
					s $$$mtPQbIsActive(m)=0 k $$$mtUnionLegVals(m) k $$$mtUnionTopQb(m)
					
					k $$$mtUnionLegVals(qb) k $$$mtUnionTopQb(qb) k $$$mtUnionTopDSN(qb) k $$$mtUnion(qb)
				}
				quit
			} 
		}
		#;HSU267-,HSU287-
		continue:$g($$$mtEmpty(m))
	#; AK831
		d:vmerged non2n^%qaqpqo  ;  if mergeviews caused n-to-n nodes
		#;  Factor Common ANDs: special ORDER BY cases
		#;  move the non OBY case earlier - PVA140
		#; PVAXXX: the special predicates that may be added for factorCommonAnds called with 3d argument of 1 are
		#;   not regeneratable, don't do this for sharded qbs.
		if phase = 2 && '$$isSharded(m)  ;  also do for subqueries containing TOP ... ORDER BY - PVA183 
		{ s logs=$g($$$mtWhere(m)) f lgi=$l(logs,"^")-1:-1:1 s log=$p(logs,"^",lgi) d factorCommonAnds^%qaqpre(m,log,1)
		}
		#; NOTE: perhaps should call removeRedundant and check for mt("empty",m) again here
		#;       For now, treat as unlikely
		#; PVA340: Note, most of what follows adds no benefit until done on the shard server
		#;         HOWEVER, it would be beneficial to do removeUnnecessaryStreams. That requires 
		#;         enhancing removeUnnecessaryStreams to deal with both linx and mt("ON") nodes 
		#;         appropriately. It currently assumes all mt("ON") nodes have been transformed out
		#;         of existence. Note that an unnecessary reference to a sharded table could 
		#;         add significant cost, even if it is eliminated in the shard server - there could be 
		#;         e.g. 10 times more shard tuples processed than are required.
        #; PVA342: For a shardtop, determine sharding of subqueries and clear contained shardtop structures.
		if $$isShardedTop(m) && '$d(mt("cosh",m)) {d shardown(m)} // view merging above may have called shardown and we don't need to if already done
		g:$$isSharded(m) shardresume
	    d placeRLSPred^%qaqpre2(m) // PVA324
		
		#; Partition mt("ON",m,) into a forest of left deep ON trees that xfrmON
		#; can decompose into simple, linx-type left outer joins
		d doFOJs^%qaqpre2(m)  ;  convert any FOJ not under another FOJ into a streamed view that implements it - PVA114
		d linearizeON^%qaqpre2(m)  ;  convert to forest of left-deep trees - JLF131
		#;HSU310+ introduces viewFvals2
		n viewFvals2
		d xfrmON(m)  ;  decompose left-deep ONs into linx-type joins - PVA087
		m viewFvals = viewFvals2
		#;HSU310-
		d marksqs^%qaqpre3(1,1)  ;  mark orphaned subqueries as abandoned - PVA169
		d:(phase=1 && (m=1)) insertTopN^%qaqpre3()	; insert TOP when ORDER BY and $$hint("%USEORDERBYINDEX",1) - JLF361
		#; Do TOP processing.  This needs to re-do some analysis that was done in
		#; analyzeHavingClause because intervening optimizations may have modified
		#; the HAVING, GROUP BY, or ORDER BY clauses that TOP eligibility depends on.
		#; (JLF020)
		if phase=1 {  // PVA124
		   s foundNonStdAgg="",vals=$p($g($$$mtP(m)),"^",3),foundNonStdAgg=0,call="ansiAgg^%qaqpre"
		   f vli=$l(vals,",")-1:-1:1 s val=$p(vals,",",vli) do lvtree("v",val) q:foundNonStdAgg
		   #; Verify that the SELECT list references only GROUP BY expressions or ANSI aggregates
		   if $d($$$mtOutput(m)) && $d($$$mtGroupDistinctList(m)) && 'foundNonStdAgg
		   {	s vals=$$$mtOutputVals($$$mtOutput(m))
			    f vli=$l(vals,",")-1:-1:1 s val=$p(vals,",",vli) do lvtree("v",val) q:foundNonStdAgg
		   }
		
		   if 'foundNonStdAgg
		   {
			#; TopN + ORDER BY.
			#;    PVA156: supress if %NOTOPOPT
			#;    PVA183: $$$mtSequencersQb(m) now for subquery ORDER BY; If m=1 and TOP present, then $$$mtSequencersQb(1) will
			#;            be used, not $$$mtS.
			#;    PVA294: use $$hint
			d:($d($$$mtSequencersQb(m)) && '$d($$$mtHaving(m)) && $d($$$mtTopArg(m)) && '$d($$$mtTopLimit(m)) && '$$hint^%qaqpre("%NOTOPOPT",m)) addTopNPred^%qaqpre3(m)
		   }
		}
shardresume	
	    #; SHOULD do removeUnnecessaryStreams for sharding, except it would need enhancement for ON nodes
		d:('$$isSharded(m)||'$d($$$mtOnRoot(m))) removeUnnecessaryStreams^%qaqpre(m)  ;  remove irrelevant streams - JLF013
		#;  clean up (hopefully obsolete) "i" nodes from mt("unary"), to avoid confusion in the next call  ;  AK1084
		s val="",fn="" f  s val=$o(mt("unary",val)) q:val=""  f  s fn=$o(mt("unary",val,fn),1,fval) q:fn=""  KILL:$$$mtVType($$$mtV(fval))="i" mt("unary",val,fn) 
		#; Replace special METHOD:%ClassMethod property class method calls with actual class and method names
		do:phase=2&&'$$isSharded(m) expandClassMethods^%qaqpre2(m)
		#; A special DISTINCT predicate is added when there is grouping with no aggregation that can 
		#; be recognized as being satisfiable on consecutive leading index subscripts, or not. Either 
		#; way, a heuristically chosen selectivity is applied (to represent the reduction in number 
		#; of rows by the DISTINCT) - PVA157
		do:phase=2&&'$$isSharded(m) distinctpred^%qaqpre3(m)  ;  add special DISTINCT predicate - PVA157
		if '$$isShardedNotTop(m)
		{
		s logs=$g($$$mtWhere(m)) f  s log=+logs,logs=$p(logs,"^",2,*) q:'log  q:$$conds // can set mt("empty",m)
		}
		continue:$g($$$mtEmpty(m))
		if '$$isSharded(m)
		{
	#; JLF073    removed by AK683
		f lx=1:1 s log=$p(linx,"^",lx) q:'log  d:m=$$$mtRQb($$$mtR($p($$$mtV($$$mtLOperand2($$$mtL(log))),"^",2))) outer
		}
		// Apply equivalence class transformations except when running on 
		// a parallel server since they already were done on the master.
		if (('$$isShardedNotTop(m)) && ('$$isShardedLocal()))
		{
		#;  Call class on each field in qb m
		f cls=1:1:$$$maxv { i $p($g(ptv(cls)),"^",$$$PTVQB)=m,+$p(ptv(cls),"^",$$$PTVEQUIVCLASS)=cls d class }
		}
		#;  push conditions into UNION view/subquery
		s logs=$g($$$mtWhere(m)) f lgi=$l(logs,"^")-1:-1:1 s log=$p(logs,"^",lgi) d:direction=1 pushlog(log,"w") // d:direction=-1 pulllog(log)
		if '$$isSharded(m)
		{
		s logs=$g($$$mtLeftOuterJoins(m)) f lgi=$l(logs,",")-1:-1:1 s log=$p(logs,",",lgi) d:direction=1 pushlog(log,"j") // d:direction=-1 pulllog(log)
		i $d(viewSpConds) { s li=0 f  s li=$bitfind(viewSpConds,1,li+1) q:'li  d pushlog(li,"j") }
		}
	#; JLF083
		s:$$$mtPCorrelatedFields($$$mtP(m)) $$$mtPCorrelatedFields($$$mtP(m))=$$distlist^%qaqcpr($$$mtPCorrelatedFields($$$mtP(m)))
		// s:'$$$mtPCorrelatedFields($$$mtP(m)) $$$mtPCorrelatedFields($$$mtP(m))=","
	#; JLF083-
		#; PVA094: reset viewFvals, viewSpConds for next query block
		#; PVA115: now kill xlate as well
		k viewFvals,xlate s viewSpConds=""
	#; AK813
		#;  fill in DSN from superquery (recursively) after OJ xforms
		#;  fix line for any non-empty entry after puslog()  ;  AK1031
		#;  (OJ transforms don't happen any more for linked tables)
		s m="" f  s m=$o($$$mtDSNLinkedTable(m),-1,log) QUIT:m=""  QUIT:log'=""
		i m'="" { f m=m+1:1:maxm d:$$$mtPQbIsActive(m) filldsn(m) }
	#; AK813-
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK939
cosh(m)	n str,quiv,conds,li,onum,onc,cosh,noco,keyquiv,fedtab  ;  [public: mt,mts]  JMM1215=
	#;  (also called from PVA34X ^%qaqoXXX) produce all cosharding info in:
	#;  mt("cosh",m)=$LB(<coshset>,...)  ;  co-sharding relationships of
	#;      all-and-only sharded tables in m
	#;  <coshset>=$LB(str,...)  ;  list of 1 or more co-sharded tables
	#;  A. set co/sharding data structures:
	#;  mt("alst",m)=$LB(str,...)  ;  all streams in m (including views)
	#;  $$$mtShardedTables(m)=$LB(str,...)  ;  all sharded tables
	s str="",mt("alst",m)="",$$$mtShardedTables(m)="",quiv="",onum="",cosh="",noco="",keyquiv="",fedtab="" // JMM1215=
	f  s str=$o(mts(m,str)) q:'str  s mt("alst",m)=$g(mt("alst",m))_$lb(str) s:$$$smdSharded(1,+$$$mtR(str)) $$$mtShardedTables(m)=$g($$$mtShardedTables(m))_$lb(str)
	#; JMM1215 Determine whether "sharded" tables are actually federated. If so, they are cosharded regardless of
	#; equivalence classes.	
	f li=1:1:$ll($$$mtShardedTables(m)) { // JMM1215+
		s cn=$$$smdClassname(1, $p( $g( $$$mtR($li($$$mtShardedTables(m),li))),"^",1) )
		i cn'="" && $$$SSIsFederated(cn) {
			s fedtab=fedtab_$lb($li($$$mtShardedTables(m),li))
		}
	}
	i $ll(fedtab) && ($ll(fedtab)'=$ll($$$mtShardedTables(m))) {
			s %msg=$system.Status.GetErrorText($$$ERROR($$$SHMCannotJoinShardedAndFederated))
			d error(400)
	} // JMM1215-
	#;  B. set equality equivalence classes in quiv, based on WHERE and ON
	d whon($g($$$mtWhere(m)))
	f  s onum=$o($$$mtOn(m, onum),1,onc) q:'onum  d whon($li(onc,2),onc)
	#;  now $li(quiv,x)=$li(quiv,y) means that val# x,y are in the same
	#;  equivalent class, i.e. m's conditions imply x=y
	#;  C. apply the 'quiv' info to determine all cosharded streams, in:
	#;  cosh=$LIST($LIST(str,),) where each element lists cosharded tables
	#;  noco= the same but of tables that are not cosharded with anything
	#;  keyquiv=$LIST($LIST(<shkf>,),) parallels the structure of cosh,
	#;      lists the shard key's representative values for all streams in each set
	f li=1:1:$ll($$$mtShardedTables(m)) d coshtab($li($$$mtShardedTables(m),li))  ;  add a table to the list
	s mt("cosh",m)=cosh_noco
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JMM912 Determine whether a subquery is cosharded (based on cosh())
coshsubq(shtop,m)	n str,quiv,conds,li,onum,onc,cosh,noco,keyquiv  ;  [public: mt,mts]
	#;  mt("cosh",m)=$LB(<coshset>,...)  ;  co-sharding relationships of
	#;      all-and-only sharded tables in m
	#;  <coshset>=$LB(str,...)  ;  list of 1 or more co-sharded tables
	#;  A. set co/sharding data structures:
	#;  mt("alst",m)=$LB(str,...)  ;  all streams in m (including views)
	#;  $$$mtShardedTables(m)=$LB(str,...)  ;  all sharded tables
	s str="",mt("alst",m)="",$$$mtShardedTables(m)="",quiv="",onum="",cosh="",noco="",keyquiv=""
	f  s str=$o(mts(m,str)) q:'str  s mt("alst",m)=$g(mt("alst",m))_$lb(str) s:$$$smdSharded(1,+$$$mtR(str)) $$$mtShardedTables(m)=$g($$$mtShardedTables(m))_$lb(str)
	RETURN:'$ll($$$mtShardedTables(m))
	#;  B. set equality equivalence classes in quiv, based on WHERE and ON
	d whon($g($$$mtWhere(m)))
	f  s onum=$o($$$mtOn(m, onum),1,onc) q:'onum  d whon($li(onc,2),onc)
	#;  now $li(quiv,x)=$li(quiv,y) means that val# x,y are in the same
	#;  equivalent class, i.e. m's conditions imply x=y
	#;  C. apply the 'quiv' info to determine all cosharded streams, in:
	#;  cosh=$LIST($LIST(str,),) where each element lists cosharded tables
	#;  noco= the same but of tables that are not cosharded with anything
	#;  keyquiv=$LIST($LIST(<shkf>,),) parallels the structure of cosh,
	#;      lists the shard key's representative values for all streams in each set
	#; First pass: ensure that if there are multiple sharded streams in this subquery, they are cosharded
	if $ll($$$mtShardedTables(m))>1 {
		f li=1:1:$ll($$$mtShardedTables(m)) d coshtab($li($$$mtShardedTables(m),li))  ;  add a table to the list
		RETURN:($ll(cosh)>1||$d(noco))
	}
	#; Second pass: are sharded streams at this level cosharded with any sharded stream of shtop query?
	s $$$mtShardedTables(m)=$$$mtShardedTables(m)_$$$mtShardedTables(shtop) 
	f li=1:1:$ll($$$mtShardedTables(m)) d coshtab($li($$$mtShardedTables(m),li))  ;  add a table to the list
	#; Is this subquery cosharded with a stream that uses shard local name?
	for li=1:1:$ll(cosh) {
		#; If this cosharded set includes a stream from this subquery
		if $lf($li(cosh,li),$li($$$mtShardedTables(m),1)) {
			s coshset=$li(cosh,li)
			for j=1:1:$ll(coshset) {
				s t=$li(coshset,j)
				if $$$mtRQb($$$mtR(t))=shtop {
					#; Does this stream use shard local name? (Logic based on fromit^%qaqcmh)
					if '$lf($g(mt("eval")),$$$mtPQbVal($$$mtP(shtop))) {
						s mt("coshsubq",m)=coshset
						#; Replace the cosharded set in mt("cosh",shtop) that contains this stream
						#; with this expanded set that includes stream(s) from this subquery
						for k=1:1:$ll(mt("cosh",shtop)) {
							s prevcoshset=$li(mt("cosh",shtop),k)
							if $lf(prevcoshset,t) {
								for kk=1:1:$ll(coshset) {
									if '$lf(prevcoshset,$li(coshset,kk)) {
										s prevcoshset=prevcoshset_$lb($li(coshset,kk))
									}
								}
								s $li(mt("cosh",shtop),k)=prevcoshset
							}
						}
						quit
					}
				}
			}
		}
		quit:$d(mt("coshsubq",m))
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
whon(conds,onc="") n li,v  ;  [public: quiv,mt] analyze WHERE/ON conditions in
	#;  conds and set quiv, onc=<ON-clause> if ON
	f li=1:1:$l(conds,"^")-1 {
		s v=$$$mtL($p(conds,"^",li))
		CONTINUE:$e(v,1,4)'="v^=^"
		#;  follow Paul's special ON rule - don't apply if both fields
		#;  on left of LOJ (or both fields on the same side of FOJ)!
		i onc'="",$li(onc)'="INNER" { n v4,v5 s v4=$$$mtV($p(v,"^",4)),v5=$$$mtV($p(v,"^",5)) i $e(v4)="f",$e(v5)="f",($lf($li(onc,3),$p(v4,"^",2))&&$lf($li(onc,3),$p(v5,"^",2)))||(($li(onc)="FULL")&&$lf($li(onc,4),$p(v4,"^",2))&&$lf($li(onc,4),$p(v5,"^",2))) { CONTINUE } }
		s f1=$$coref($p(v,"^",4),m),f2=$$coref($p(v,"^",5),m) // JMM912
		d quiv(f1,f2)
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; get underlying field or collation for a correlated reference   JMM912
coref(f,savem) n col,n,m ; [public: mt]
	s m=savem // coll^%qaqpqo expects m to be set, and may modify it, which we don't want
	if $$$mtVType($$$mtV(f))="n" {
		s f=$p($$$mtV(f),"^",4)
	}
	elseif $$$mtVType($$$mtV(f))="v" {
		s col=$p($$$mtV(f),"^",2)
		if ($$$ISENCODEDCOLLATE(col)||($lf($lb("%SQLUPPER","%ALPHAUP","%UPPER","%SPACE","%PLUS","%MINUS","%MVR","%STRING","%SQLSTRING"),col))) {
			s n=$$$mtV($p($$$mtV(f),"^",4))
			if $p(n,"^",1)="n" {
				s f=$$coll^%qaqpqo($p(n,"^",4),col)
			}
		}
	}
	RETURN f
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
quiv(x,y) n a,b s a=$lg(quiv,x),b=$lg(quiv,y)  ;  [public: quiv] update quiv with (x=y)
	i a="",b="" { s $li(quiv,x)=x,$li(quiv,y)=x RETURN }  ;  *** use =+x???
	RETURN:a=b  ;  already equivalent
	i a="" { s $li(quiv,x)=b RETURN }
	i b="" { s $li(quiv,y)=a RETURN }
	#;  merge a and b - change anything marked b to a
	s x="" f  s x=$lf(quiv,b,x) QUIT:'x  s $li(quiv,x)=a
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
coshtab(str) n irn,shkey,mapirn,csirn,li s mapirn=""  ;  [public: cosh,noco,keyquiv,mt]
	;#  JMM1215 If tables are federated add stream to cosh and return
	;#  Note that federated tables cannot be joined with regular sharded tables, so if any tables are federated, they
	;#  are all federated.
	i $g(fedtab)'="" { // JMM1215+
		i cosh="" {
			s cosh=$lb($lb(str))
		}
		else {
			s $li(cosh,1)=$li(cosh,1)_$lb(str)
		}
		RETURN
	} // JMM11215-
	;#  see if str coshards with any of the existing tables, add it to
	;#  cosh/keyquiv or to noco
	s irn=+$$$mtR(str),shkey=$LISTFROMSTRING($$$smdShardKey(1,irn))
	#;  replace DD empty shkey with ifn of the SGRISK  ;  AK963
	#;  mapirn indicates using SGRISK map instead of regular hash function
	#;  also use SGRISK irn for FOREIGN KEY COSHARD WITH  ;  AK984
	s:shkey="" mapirn=irn,shkey=$lb($$$smd(1,irn,"col",1))  ;  AK963
	s csirn=$$$smdShardMapOwner(1,irn)  ;  COSHARD WITH a SGRISK  ;  AK984
	$$$SNRBDebugTrace("coshtab^%qaqpnl csirn: "_csirn_" irn: "_irn) ; JMM1152=
	i csirn&&(csirn'=irn)&&'$$confirmShardMapOwner(irn,csirn) { s csirn=0 } ; JMM1152=
	i csirn,$$$smdShardKey(1,csirn)="" { s mapirn=csirn }
	#;  replace each ifn in the shard key with the quiv entry of the val#
	#;      of that ifn, if any;  If some ifn has no entry in quiv (or in
	#;      mts("ATT")), there's no hope for co-sharding - list it in noco
	#;  but use default collation
	#;  1. *** should be corrected for DD to have the actual collation used
	#;  2. *** logic should be adjusted for (f=g) to imply coll(f)=coll(g)
	f li=1:1:$ll(shkey) {
		s $li(shkey,li)=+$lg(quiv,$p($g(mts($$$mtRQb($$$mtR(str)),str,"ATT",$$ddefun(irn,$li(shkey,li)))),"^",5))
		i '$li(shkey,li) { s noco=noco_$lb($lb(str)) RETURN }
		s:mapirn shkey=$lb($li(shkey)_","_mapirn)  ;  SGRISK  ;  AK963
	}
	f li=1:1:$ll(cosh) i shkey=$li(keyquiv,li),mapirn||$$shardMapsMatch($li($li(cosh,li),1),str) { s $li(cosh,li)=$li(cosh,li)_$lb(str) RETURN }  ;  found co-sharded group  JMM900
	#;  str is not cosharded so far - add it to cosh/keyquiv
	s cosh=cosh_$lb($lb(str)),keyquiv=keyquiv_$lb(shkey)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
shardMapsMatch(str1,str2) n irn1,irn2 ; JMM900
	#;  this call only applies to COSHARD WITH of 2 user-defined shard keys
	s irn1=+$$$mtR(str1),irn2=+$$$mtR(str2)
	RETURN:irn1=irn2 1  ;  *** next line info should go into SMD metadata
	RETURN $$shardMapsMatch^%SYS.SHARDSRV($$$smdSchema(1,irn1)_"."_$$$smdName(1,irn1),$$$smdSchema(1,irn2)_"."_$$$smdName(1,irn2))
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
confirmShardMapOwner(irn,csirn) n thisClass,coshardClass ; JMM1152
	s thisSchema=$$$smdSchema(1,irn),thisTable=$$$smdName(1,irn),coshSchema=$$$smdSchema(1,csirn),coshTable=$$$smdName(1,csirn)
	if thisSchema="" || (thisTable="") || (coshSchema="") || (coshTable="") {
		return 0
	}
    s thisClass=$$tableNameToExtentName^%SYS.SHARDSRV(thisSchema_"."_thisTable),coshClass=$$tableNameToExtentName^%SYS.SHARDSRV(coshSchema_"."_coshTable)
    RETURN ($g($$$SSGlobal($$$SSStorageModelSQL,$$$SSEntitiesSubscript,thisClass,$$$SSShardMapSubscript,$$$SSShardMapOwnerSubscript))=coshClass)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddefun(irn,ifn) n v  ;  ifn with the default collation added, if any
	s v=$$$smdColCollation(1,irn,ifn)
	s v=$s(v="":"",v="SU":"%SQLUPPER",v="A":"%ALPHAUP",v="U":"%UPPER",v="S":"%SPACE",v="P":"%PLUS",v="M":"%MINUS",v="MV":"%MVR",v="E":"",v="T":"%STRING",v="SS":"%SQLSTRING",v["T(":"%STRING("_$p(v,"(",2),v["SS(":"%SQLSTRING("_$p(v,"(",2),v["SU(":"%SQLUPPER("_$p(v,"(",2),1:v)
	if $$$ISENCODEDCOLLATE(v) {set v = "%"_v}
	RETURN ifn_$s(v="":"",1:"_"_v)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK939-
	#; Populates the mt("jsvcorrstr") structure by checking equivalence conditions that
	#; may have been added by conds()
	#; Add streams of fields equivalent to values in mt("jsvcorrval") to mt("jsvcorrstr")
	#; Otherwise we may not be able to identify streams with these implied jsv conditions.
updateJsvCorr() [ mt, ptv ] public {
	//If there's no jsv in this query, continue.
	If $g($$$mtJsvCorrVal)="" QUIT
	Set v = 0
	For {
		Set v = $bitfind($$$mtJsvCorrVal,1,v+1) QUIT:v=0
		//get its equivalence class from ptv
		Set eqvhead= +$g(ptv(v)) If 'eqvhead CONTINUE
		Set eqvvals = $p(ptv(eqvhead),"^",$$$PTVVALSINCLASS)
		For i=1:1 {
			Set v2 = $p(eqvvals,",",i) QUIT:v2=""
			Set val2 = $g($$$mtV(v2))
			If $e(val2) '= "f" CONTINUE
			Set $bit($$$mtJsvCorrStr, $p(val2,"^",2)) = 1 //set the equiv val's stream as jsv correlated.
		}
	}
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK813
filldsn(m) n dsn  ;  recurse up superqueries from m, find first $$$mtDSNLinkedTable() with
	#;  value, and if it is external then copy it to the descendants
	QUIT:'m ""  ;  all the way to the top - could we have skipped m=1???
	i $d($$$mtDSNLinkedTable(m),dsn),dsn'="" RETURN dsn  ;  AK1031
	s dsn=$$filldsn(+$$$mtP(m))
	s:dsn'="" $$$mtDSNLinkedTable(m)=dsn
	QUIT dsn
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK813-
	#; JLF128: New routine calcQBOrder
calcQBOrder(topoqb)
	n inordr,m,tm
	f tm=2:1:topoqb-1 s inordr(mt("qbo",tm))=1	; Mark the query blocks already in the topological order
	f tm=topoqb:1:maxm { k mt("qbo",tm) }		; Remove any historical order info above topoqb
	s inordr(1)=1,mt("qbo",1)=1		; qb 1 is always the root of the query block tree, by design
	s:topoqb<=1 topoqb=2			; If asked to start at (or before) qb 1, move on to qb 2
	
	#; Find a query block that is not yet in the order but whose parent is in the order,
	#; and add it to the order.  Continue until all query blocks are accounted for.
	#;
	while (topoqb<=maxm) { f m=2:1:maxm  if '$d(inordr(m))&&($d(inordr($p($$$mtP(m),"^")))||'$$$mtPQbIsActive(m)||($p($$$mtP(m),"^")=0)) { s mt("qbo",topoqb)=m,inordr(m)=1,topoqb=$i(topoqb) }}	; JLF128
.
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA087: New routine xfrmON; 
xfrmON(m) // Transform ON clauses for a query into =*, using simple or complex streamed view
	//   as required
	new bad,ccols,fcols,good,i,lf,lo,log,logs,lxlen,ly,nbstr,nrjstr,ocnt,ojconds,ojx,ojxq,ologs,onstrms,oocnt,osq,otype,refstr,rstr,simple,sqconds,val,vdat,viewFvals,x,xlate
	#; First classify ON clauses as good (can convert completely to linx), simple (can convert
	#; to linx plus a single table streamed view), or general (requires new linx and multi-
	#; table streamed view to be constructed). The classification is placed in 5th list piece of
	#; mt("ON") node. This two pass approach is required because when processing any given
	#; ON clause, all others must be examined for references, and the treatment of these 
	#; references depends on the classification of those other ON clauses. 
	for i=1:1:$ll(nulstr) {
		set $bit(nbstr,$li(nulstr,i)) = 1
	}
	#; PVA092: modify for new mt("ON",) structure
	set ocnt="" 
	for { 
		set ocnt = $o($$$mtOn(m, ocnt),1,logs) 
		QUIT:ocnt=""
	    set ly = $li(logs,4)
		#; Check if equivalent to directly supported =*
		set good=1,simple=1,bad=0,fcols="",ccols="",lf=0,logs=$li(logs,2),refstr="",nrjstr="",rstr=$$$ptrel(m_"^"_$li(ly))
		for i=1:1 {	
			set log = $p(logs,"^",i) 
			QUIT:'log
			if '$$good^%qaqpre3(log,rstr,.fcols,.ccols,.lf) { 
				set good = 0 
				set:simple&&('$$simple(log,rstr)) simple = 0 
			}
			set:'bad&&($$nullreject^%qaqpre3(log,.refstr,.nrjstr)) bad = 1
				//on left. Support for that comes later
		}
		set:'lf simple=0
		set:'lf||($bitcount($bitlogic(fcols&ccols),1)>0) good=0
		#; PVA092: move classification info to list elements 5 and 6, because of 
		#;         mt("ON",) structure change.
		if good { 
			set $li($$$mtOn(m, ocnt),5) = "good" 
		} elseif simple { 
			set $li($$$mtOn(m, ocnt),5) = "simple" 
		} else {
			do:bad error(94)
			set x=nbstr, $bit(x,rstr)=0
			if $bitcount($bitlogic(refstr&~nrjstr&x),1)=0 { 
				set $li($$$mtOn(m, ocnt),5,6) = $lb("nullreject",refstr) 
			} else { 
				do error(94) 	  // pathologic general case, not yet supported
			}
		}
	}
.
	set ocnt = "" 
	for { 
		set ocnt = $o($$$mtOn(m, ocnt),1,logs) 
		QUIT:ocnt=""
	  	if $li(logs,5) = "nullreject" {
			set logs = $li(logs,2)
	     	if '$d(viewFvals) {
				set val = "" 
				for {  
					set val=$o($$$mtV(val),1,vdat) 
					QUIT:val=""
					CONTINUE:$e(vdat)'="f"
					CONTINUE:$$$mtRQb($$$mtR($p(vdat,"^",2)))'=m
					set viewFvals(val,m) = val
				}
			}
			for i=1:1 {	
				set log = $p(logs,"^",i) 
				QUIT:'log 
				set $p(logs,"^",i)=$$clone("l",log)
				set $$$mtL(log)="i^ojcloned^"_$$$mtL(log)
			}
			set $li($$$mtOn(m, ocnt),2) = logs
	  }
	}
	do:$d(viewFvals) flds
	#;HSU310+
	kill:$d(viewFvals) viewFvals 
	#;HSU310-
	#; PVA094: search for multi-stream conditions that can be moved into streamed views
	#;         created for outer joins; record their field information to build a translation
	#;         table when the relevant vals have been created. 
	set ocnt = "" 
	for { 
		set ocnt = $o($$$mtOn(m, ocnt),1,logs) 
		QUIT:ocnt=""
	  	CONTINUE:$Case($li(logs,5),"good":1,"simple":1,:0)
	  	set refstr=$li(logs,6)
		set rstr=$$$ptrel(m_"^"_$li($li(logs,4)))
		set x=refstr, $bit(x,rstr)=0
	  	for i=1:1 {
			set log = $p($g($$$mtWhere(m)),"^",i) 
			QUIT:log=""
	     	set ly = $$strs^%qaqpre2("l",log)	 
				#; PVA095: record fields from condition if ANY interesting streams are referenced.
				#;         Even if some irrelevant streams are referenced, transitive closure may make
				#;         a condition using only the relevant field references. The fields that
				#;         might be used in such a condition (made later) must be recorded now. 
	     	CONTINUE:$bitcount($bitlogic(ly&x),1)=0
	     	do recordw^%qaqpre2(log,x,ocnt)
	  	}
	  	set oocnt="" 
		for {
			set oocnt = $o($$$mtOn(m, oocnt),1,ologs) 
			QUIT:oocnt=""
			CONTINUE:oocnt=ocnt
				#; With general nested ON clause support, should check that stream set of 
				#; args off oocnt (that is, its 3 and 4 list piece) is a subset of the stream
				#; set of ocnt (in the same sense). In addition, 4th element (right argument) 
				#; must be contained in 'copied streams' of ocnt. However, for the generality
				#; supported by PVA087, this second condition implies the first, so that is all
				#; we test for now.
			CONTINUE:$bit(x,$$$ptrel(m_"^"_$li($li(ologs,4))))=0
			set otype = $li(ologs,5)
			set ologs = $li(ologs,2)
	     	for i=1:1 {  
				set log = $p(ologs,"^",i) 
				QUIT:'log
	        	set ly = $$strs^%qaqpre2("l",log)
					#; PVA095: record fields from condition if ANY interesting streams are referenced.
					#;         Even if some irrelevant streams are referenced, transitive closure may make
					#;         a condition using only the relevant field references. The fields that
					#;         might be used in such a condition (made later) must be recorded now. 
	        	CONTINUE:$bitcount($bitlogic(ly&x),1)=0
	        	do:otype="good" recordw^%qaqpre2(log,x,ocnt)
				if otype="simple" {
					if $$simple(log,rstr) {
						do recordo^%qaqpre2(log,x,ocnt,oocnt)
					} else {
						do recordw^%qaqpre2(log,x,ocnt)
					}
				} else {
					do recordo^%qaqpre2(log,x,ocnt,oocnt)
				}
			}
		}
	}
	
	#; PVA092: modify for new mt("ON,) structure
	set ocnt=""
	for { 
		set ocnt = $o($$$mtOn(m, ocnt),1,logs) 
		QUIT:ocnt=""
	    set ly = $li(logs,4)
		if $li(logs,5)="good" { 	// convert to linx using where^%qapqpo !
		    set logs=$li(logs,2)
		   	for i=1:1  {
				set log = $p(logs,"^",i) 
				QUIT:'log
		      		#; PVA138: add condition to WHERE clause if conflict detected (by no change to linx)
		   	  	set $$$mtLOperator($$$mtL(log)) = "=*"
				set lxlen = $l(linx,"^")
		      	do where^%qaqpqo(log,log,1)
		      	set:$l(linx,"^")=lxlen $$$mtWhere(m) = $g($$$mtWhere(m))_log_"^"
		   	}
		   	kill $$$mtOn(m, ocnt)
		   	CONTINUE //to next ON clause
		}
		#; PVA092: classification infor moved to elements 5 and 6. 
		if $li(logs,5)="simple" {	// simple case transform
			//separate ON clause conditions to go in fromsq vs. remain as oj conds
		    set ojconds="", sqconds="", logs=$li(logs,2), rstr=$$$ptrel(m_"^"_$li(ly))
			for i=1:1 { 
				set log = $p(logs,"^",i) 
				QUIT:'log  
				if $$simple(log,rstr) {
					set sqconds = sqconds_log_"^"
				} else {
					set ojconds = ojconds_log_"^"
				} 
			}
		    kill $$$mtOn(m, ocnt) // Must kill now so cr8strview doesn't see this one.
				#; PVA094: new argument for cr8strview, and remember the new qb created
			do:$d(mts(m,rstr,"lateral")) error(94) // PVA348: not supported now - would have to duplicate lateral dependencies
				                                      // and modify overall transform logic
			set osq = $$cr8strview^%qaqpre2(","_rstr_",","",sqconds,ojconds,ocnt,,1) // encapsulate rstr into a streamed view 
			set nulstr = nulstr_$lb($p($$$mtV($$$mtPViewIDVal($$$mtP(osq))),"^",2)) //PVA112 -maintain nulstr
			set ojxq(ocnt) = osq
			// build linx for ojconds 
			for i=1:1 {  
				set log = $p(ojconds,"^",i) 
				QUIT:'log
		      		#; PVA138: add condition to WHERE clause if conflict detected (by no change to linx)
			  	set $$$mtLOperator($$$mtL(log)) = "=*"
				set lxlen = $l(linx,"^")
		      	do where^%qaqpqo(log,log,1)
		      	set:$l(linx,"^")=lxlen $$$mtWhere(m) = $g($$$mtWhere(m))_log_"^"
		    }
				//Fix up esp. ptv output flag; always better to do flds inner to outer 
			set x=m,m=osq 
			do flds
			set m=x 
			do flds
			CONTINUE
		}
		#; PVA092: classification info moved to pieces 5 and 6. 
		if $li(logs,5)="nullreject" { 	// transform for almost all other cases
			set refstr = $li(logs,6) // as bitmap, including oj target
			set rstr = $$$ptrel(m_"^"_$li(ly))
			set i=-1, onstrms="," 
			for {
				set i=i+1, i=$bitfind(refstr,1,i) 
				QUIT:'i
				CONTINUE:i=rstr
			   	set onstrms = onstrms_i_","
			}
		    set logs = $li(logs,2)
		    #; PVA099: modify left streamless case to only look at streams of actual left arg of oj
		    if onstrms="," {		// if left streamless ON clause, can use any stream not null padded
			    for i=1:1 { 
					set x = $lg($li($$$mtOn(m, ocnt),3),i) 
					QUIT:x=""
			       	set x = $$$ptrel(m_"^"_x)
			       	CONTINUE:$lf(nulstr,x)
			       	set onstrms = onstrms_x_","
			       	QUIT
			    }
		    }
		    do:onstrms="," error(94)
		    #; PVA099: move this kill later
		    kill $$$mtOn(m, ocnt) // Must kill now so cr8strview doesn't see this one.
				#; PVA094: new argument for cr8strview, and remember the new qb created
			do:$d(mts(m,rstr,"lateral")) error(94) //PVA348:  Not supported now - would have to duplicate lateral dependencies
			                                      // and modify overall transform logic
			for i=2:1:($l(onstrms,",")-1) { d:$d(mts(m,$p(onstrms,",",i),"lateral")) error(94)}
			set osq = $$cr8strview^%qaqpre2(","_rstr_",",onstrms,logs,"",ocnt,,1)
			set nulstr = nulstr_$lb($p($$$mtV($$$mtPViewIDVal($$$mtP(osq))),"^",2)) //PVA112 -maintain nulstr
			set ojxq(ocnt) = osq
			// Make linx for id joins
			set lf = $l(onstrms,",")-2
			set lo = $l($$$mtOutputVals($$$mtOutput(osq)),",")-1
			for i=1:1:lf {
				set x = $$$mtPViewIDVal($$$mtP(osq))+i+lo-lf
				Set val=$$$newlog("v^=*^^"_$$findidval^%qaqpre2($p(onstrms,",",i+1))_"^"_x_"^") // new log left in val
		        #; PVA138: add condition to WHERE clause if conflict detected (by no change to linx)
				set lxlen = $l(linx,"^")
				set log = val 
				do where^%qaqpqo(log,log,1)
		        set:$l(linx,"^")=lxlen $$$mtWhere(m) = $g($$$mtWhere(m))_log_"^"
			}
				//Fix up esp. ptv output flag; always better to do flds inner to outer 
			set x=m,m=osq 
			do flds
			set m=x 
			do flds
			CONTINUE
		}
	}
	#; PVA094: Build viewFvals from ojx
	set lf="" 
	for { 
		set lf = $o(ojx("w",lf)) 
		QUIT:lf=""
		set i="" 
		for {
			set i = $o(ojx("w",lf,i),1,x) 
			QUIT:i=""
	      	set viewFvals($s($p(x,",")]"":$p(x,","),1:lf),ojxq(i))=$p(x,",",2)
	   	}
	}
	set lf="" 
	for {  
		set lf = $o(ojx("o",lf)) 
		QUIT:lf=""
	   	set i="" 
		for {  
			set i = $o(ojx("o",lf,i)) 
			QUIT:i=""
	      	set lo="" 
			for {  
				set lo = $o(ojx("o",lf,i,lo),1,x) 
				QUIT:lo=""
	         	set viewFvals($s($p(x,",")]"":$p(x,","),1:lf),ojxq(lo))=$p(x,",",2)
	      	}
	   	}
	}
	#;HSU310+
	merge viewFvals2 = viewFvals
	#;HSU310-
	RETURN
	#; PVA087: New routine 'fixrefs' 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fixrefs(m,extralg,trvals,allVals=0,nolinx=0,dostrms=0,ft=0) 
	#; Translate field references as specified in trvals (passed by 
    #; reference) to all possible parse tree locations deeply contained by
    #; query m, plus also in extralg list. This includes subqueries of m to any depth
    #; (their outer references and $$$mtP() piece 4 lists will be updated).
    #; Piece 3 lists are unaffected. It is assumed that flds^%qaqpnl will be called 
    #; after this to update piece 3 lists of of the query(s) from which trvals originate.  
    #; trvals is an array: trvals(oldval)=newval
    #; NOTE: assumes ON clauses have been classified. See xfrmON.
    #; allVals: if true, trvals may contain translation for other than "f" vals
    #; nolinx : if true, don't fix linx (thus allowing them to move to a new query) (PVA158)
    #; dostrms: look inside query streams (PVA174)
	#; ft: fixing refs for foreign table being moved into a streamed view
	n ly,li,x,v,i,newSrc,newTrg,newV,ocnt,r,str,subvaluecoll,tq,uq,args,arg	// (JLF339)
 	  #; i used within fixref lvtreemod companion
	if ft {
		s call="fixftref"
	} else {
		s call="fixref"
	}
	#; JLF339
	#; Translate mt("unary",*,*) for %ANYOF collations in accordance with
	#; xlate("bf",*) so that any references to mt("unary",*,*)
	#; from class method invocations can be properly translated.
	#; The xlate("bf",*) array may be created by the clone operation.
	#;
	s x="" 
	for
	{ 	s x=$o(mt("unary",x)) q:x=""  
		s v="" 
		for
		{	s v=$o(mt("unary",x,v)) q:v=""
			s newSrc = $s($g(trvals(x))'="":trvals(x),1:x)
			s newTrg = $s($g(trvals(mt("unary",x,v)))'="":trvals(mt("unary",x,v)),1:mt("unary",x,v))
			
			#; The v subscript may be of the form "%ANYOF[KEY]:"_baseFld, and
			#; the baseFld may be in xlate("bf",*)
			#;
			set newV = v
			for subvaluecoll="%ANYOF","%ANYOFKEY"
			{	if $l(v,":")=2&&($p(v,":",1)=subvaluecoll)&&($g(xlate("bf",$p(v,":",2)))'="") 
				{	set newV = subvaluecoll_":"_xlate("bf",$p(v,":",2))
					quit	; can only match at most one, so quit now
				}	
			}
			set mt("unary",newSrc,newV)=newTrg
		}
	}
	#; JLF339-
	s x=$$$mtOutputVals($g($$$mtOutput(m))) 
	for li=1:1 
	{ s v=$p(x,",",li) q:v=""  
	  s $p(x,",",li)=$$lvtreemod("v",v)
	  set:v'=$p(x,",",li)&&($$$mtPViewIDVal($$$mtP(m))>0) $li($$$mtVirf($p($$$mtV($$$mtPViewIDVal($$$mtP(m))+li),"^",3)),2)=$p(x,",",li)
	}
	s:x]"" $$$mtOutputVals($$$mtOutput(m))=x 
	for li=1:1 s v=$p($g($$$mtDistinct(m)),",",li) q:v=""  s $p($$$mtDistinct(m),",",li)=$$lvtreemod^%qaqpnl("v",v)
	for li=1:1 s v=$p(extralg,"^",li) q:v=""  d lvtreemod("l",v)
	for li=1:1 s v=$p($g($$$mtWhere(m)),"^",li) q:v=""  d lvtreemod("l",v)
	for li=1:1 s v=$p($g($$$mtPartitionPredicates(m)),"^",li) q:v=""  d lvtreemod("l",v) // PVA304
	d:$d($$$mtHaving(m)) lvtreemod("l",$$$mtHaving(m))
	for li=1:1 s v=$p($g($$$mtGroupDistinctList(m)),",",li) q:v=""  s $p($$$mtGroupDistinctList(m),",",li)=$$lvtreemod^%qaqpnl("v",v)
	#; PVA092: New mt("ON",) structure. 
	s ocnt="" f 
	{ s ocnt=$o($$$mtOn(m, ocnt),1,x) q:ocnt=""
	        s ly =$li(x,4)
		continue:$lg(x,5)="nullreject" // pva099: if ON classification not done, do all ON clauses
	        s x=$li(x,2)
	        for li=1:1 s v=$p(x,"^",li) q:v=""  s $p(x,"^",li)=$$lvtreemod("l",v)
	        s $li($$$mtOn(m, ocnt),2)=x
	}
	#; PVA342: do row level security 'store aside' predicates
	s str="" for 
	{  s str=$o(mt("RLS",str),1,v) q:str=""  continue:$$$mtRQb($$$mtR(str))'=m
	   s mt("RLS",str)=$$lvtreemod("l",v) // An l node should not actually be changed, so a DO would suffice 
	                                      #; but might as well be general
	}
	#; PVA348: also for TVF arguments
	s str="" for
	{  s str=$o($$$mtTvfParams(str),1,args) q:str=""  continue:$$$mtRQb($$$mtR(str))'=m
	   #; Perhaps only needed if lateral property, but harmless and possibly more general to always do:
	   continue:args=$c(0)
	   for li=1:1:$ll(args) { s v=$lg(args,li) s:v]"" $li(args,li)=$$lvtreemod("v",v) 
	   s $$$mtTvfParams(str)=args
	}
	}
	if 'nolinx f li=1:1 s v=$p(linx,"^",li) q:'v  d lvtreemod("l",v) // PVA158: check nolinx flag
	#; PVA183: support ORDER BY in subquery
	for li=1:1 s v=$p($g($$$mtSequencersQb(m)),",",li) q:'v  s $p(v,"d")=$$lvtreemod("v",+v),$p($$$mtSequencersQb(m),",",li)=v
	if m=1 
	{ 
	  for li=1:1 s v=$p($g($$$mtSequencers),",",li) q:'v  s $p(v,"d")=$$lvtreemod("v",+v),$p($$$mtSequencers,",",li)=v
	  for li=1:1 s v=$p($g($$$mtNewVals),",",li) q:'v  s $p($$$mtNewVals,",",li)=$$lvtreemod("v",v)
	  #; PVA139: also consider $$$mtSelectInto and $$$mtFList
	  s x=$p($g($$$mtSelectInto),"^") if x]"" {for li=1:1 { s v=$p(x,",",li) q:'v  s $p(x,",",li)=$$lvtreemod("v",v)} s $p($$$mtSelectInto,"^")=x}
	  for li=1:1 s v=$p($g($$$mtFList),",",li) q:'v  s $p($$$mtFList,",",li)=$$lvtreemod("v",v)
	}
	#; PVA173: Look in query streams
	#; PVA174:  only if told to look there
	if dostrms 
	{  s r=m_"^" for 
	   {  
	   	  #; PVA179: Look in union legs of a union in the "FROM" clause via the enclosing stream
		  s r=$o($$$ptrel(r),1,str) q:r=""  q:$p(r,"^")'=m  continue:'$d($$$mtRVirtual(str)) 
	      s tq=$$$mtRVirtual(str)
	      if $$lvtreemod("v",$$$mtPQbVal($$$mtP(tq)))  
	      #; Handle unions
	      s uq="" for
	      {  s uq=$o($$$mtUnionTopQb(uq)) q:uq=""  continue:uq=tq  continue:$$$mtUnionTopQb(uq)'=tq
	         if $$lvtreemod("v",$$$mtPQbVal($$$mtP(uq)))
	      }
	   }
	   #; Look in union legs of a union in the "WHERE" clause directly.
	   #; 
	   #; This is unnecessary extra work in the case where we're fixing the references
	   #; in the top of a union as the top recursive step of a view merge, since we never
	   #; merge an entire union. But looking too many places for references to transform
	   #; is worse than not looking at enough, and skipping the search would require 
	   #; yet-another-flag to fixrefs.
	   s uq="" for
	   {  s uq=$o($$$mtUnionTopQb(uq)) q:uq=""  continue:uq=m  continue:$$$mtUnionTopQb(uq)'=m
	      if $$lvtreemod("v",$$$mtPQbVal($$$mtP(uq)))
	   }
	}
	QUIT
fixref	// beware: uses caller's i
	s:ev="f"&&($d(trvals(val))) val=trvals(val)
	#; note, if n->n, this n does'nt need fixing; the referenced n that points to a field will
	#; be reached and fixed in the subquery containing it. 
	#; PVA092: Fix to use wv, which is safe in lvtreemod caller. 
	if ev="q" 
	{
		s i=0,wv=$$$mtPCorrelatedFields($$$mtP($p(v,"^",2))) 
		#; PVA145: expand expressions to underlying fields
		#; PVA179: Call lfldscln only on expressions; otherwise further out references could be eliminated.
		f lv=1:1 q:'$p(wv,",",lv)  if $d(trvals($p(wv,",",lv))) s i=1,$p(wv,",",lv)=$s($e($$$mtV(trvals($p(wv,",",lv))))'="f":$$lfldscln^%qaqpre2("v",trvals($p(wv,",",lv)),m),1:trvals($p(wv,",",lv)))
		#;  remove empty entries, must be comma-followed  ;  AK1026
		f lv=$l(wv,",")-1:-1:1 s:'$p(wv,",",lv) $p(wv,",",lv,lv+1)=$p(wv,",",lv+1)
		s:i $$$mtPCorrelatedFields($$$mtP($p(v,"^",2)))=wv 
		d:i fixrefs($p(v,"^",2),"",.trvals,allVals,nolinx,dostrms) // PVA174: dostrms
		i $d(mt("svso",$p(v,"^",2))) s mt("svso",$p(v,"^",2)) = $$fixsvso($p(v,"^",2))
	}
	if allVals,ev="v" {
		f lv=4:1  q:$p(v,"^",lv)=""  set:$d(trvals($p(v,"^",lv))) $p(mt(type,val),"^",lv) = trvals($p(v,"^",lv))
	}
	goto lvargm
.
#; Alternative to fixref for fixing foreign table refs in createStreamedViewForForeignTable^%qaqpqo. This is
#; used when we take a foreign table and move it into its own QB to act as one regeneration unit. Our use case
#; differs slightly from the fixref use case because we may be moving more things - aggregates.
fixftref
	/* 	
		Only ever replace mt("v") nodes, if we're looking at type "l" just skip and recurse down to arguments.
		Different from fixref - not just fields, any top level expr tracked in trvals should be translated to the new 
		val and then stop. Only recurse down if value was not found, so we check if any underlying items were replaced
	*/
	if type = "v", ev '= "q", $d(trvals(val)) {
		set val = trvals(val)
		RETURN val
	} elseif ev = "q" {
		#; note, if n->n, this n does'nt need fixing; the referenced n that points to a field will
		#; be reached and fixed in the subquery containing it. 
		#; PVA092: Fix to use wv, which is safe in lvtreemod caller. 
		set i=0, wv=$$$mtPCorrelatedFields($$$mtP($p(v,"^",2))) 
		#; only need to look at the correlated references of qbs because that's the only part of them that could
		#; reference something we have
		for lv=1:1 {
			QUIT:'$p(wv,",",lv)
			if $d(trvals($p(wv,",",lv))) {
				set i = 1
				set $p(wv,",",lv) = $s($e($$$mtV(trvals($p(wv,",",lv))))'="f":$$lfldscln^%qaqpre2("v",trvals($p(wv,",",lv)),m),1:trvals($p(wv,",",lv)))
			}
		}
		#;  remove empty entries, must be comma-followed  ;  AK1026
		for lv=$l(wv,",")-1:-1:1 {
			set:'$p(wv,",",lv) $p(wv,",",lv,lv+1) = $p(wv,",",lv+1)
		}
		set:i $$$mtPCorrelatedFields($$$mtP($p(v,"^",2))) = wv 
		// TODOFT verify - different than normal fixref: we do this at a stage that piece 4 (corr refs) is not 
		// guaranteed to be defined so we will always need to recurse down. It's not clear to me if we can call flds
		// (in bottom up topological order) prior to the ft pushdown logic so that piece 4 will be well defined.
		do fixrefs($p(v,"^",2),"",.trvals,allVals,nolinx,dostrms,1) // PVA174: dostrms
		
		if $d(mt("svso",$p(v,"^",2))) {
			set mt("svso",$p(v,"^",2)) = $$fixsvso($p(v,"^",2))
		}
	}
	GOTO lvargm	// recurse down
#; Returns an updated structure for mt("svso", subq)
#; Meant to be called as a utility from fixrefs, as it requires
#; all the setup done there for lvtreemod, trvals(), etc. 
fixsvso(subq) [ mt ] public {
	s svso = mt("svso",subq)
	s pqbExpr = $li(svso,3)
	s sqbExpr = $li(svso,4)
	#; pqbExpr is a x^y^ list.
	for i=1:1 {
		Set pqbV = $p(pqbExpr,"^",i) QUIT:pqbV=""
		Set $p(pqbExpr,"^",i) = $$lvtreemod("v", pqbV)
	}
	#; sqbExpr is a $list.
	for i=1:1 {
		Set sqbV = $lg(sqbExpr,i) QUIT:sqbV=""
		Set $li(sqbExpr,i) = $$lvtreemod("v", sqbV)
	}
	s $li(svso,3) = pqbExpr
	s $li(svso,4) = sqbExpr
	RETURN svso
}
	#; PVA087: New routine 'fixpcorr' 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fixpcorr //an lvtree companion
	set:ev="q" $p($$$mtP($p(v,"^",2)),"^")=m,$$$mtCorrParentQb($p(v,"^",2))=m
	goto lvarg
	#; PVA087: New routine 'fvals' 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fvals(m,extralg,strs,trvals) // Build array in trvals (passed by reference) 
	// of all field vals reference in query m to any stream in strs (pre and post
	// comma delimited). Include 
	// fields from the extralg list of conditions. Relies on piece 3 of val and log
	// entries, and also on ptv piece 8 ($$$PTVSTR). The strs are assumed to be streams of m.
	n ly,logs,val,tmpvals,tmpstrs,str,ifn,ocnt,args
	d fvals2(extralg,"l",strs,.trvals)
	d fvals2($$$mtOutputVals($$$mtOutput(m)),"v",strs,.trvals)
	d fvals2($g($$$mtWhere(m)),"l",strs,.trvals)
	d fvals2($g($$$mtPartitionPredicates(m)),"l",strs,.trvals) // PVA304
	d fvals2($g($$$mtHaving(m)),"l",strs,.trvals)
	d fvals2($g($$$mtGroupDistinctList(m)),"v",strs,.trvals)
	d fvals2($g($$$mtDistinct(m)),"v",strs,.trvals) // when supported
	#; PVA342: process mt("RLS",) row level security structure
	s str="" for 
	{  s str=$o(mt("RLS",str),1,val) q:str=""  continue:$$$mtRQb($$$mtR(str))'=m
	   d fvals2(val,"l",strs,.trvals) 
	}
	#; PVA348: also for TVF arguments
	s str="" for 
	{  s str=$o($$$mtTvfParams(str),1,args) q:str=""  continue:$$$mtRQb($$$mtR(str))'=m
	   continue:args=$c(0) 
	   s args=$$listToStringSkipNull^%qaqutility(args) continue:args=""
	   d fvals2(args,"v",strs,.trvals) 
	}
	#; PVA092: new mt("ON",) structure
	s ocnt="" f 
	{ s ocnt=$o($$$mtOn(m, ocnt),1,logs) q:ocnt=""
	        #; PVA108: use $lg() to allow for use before xfrmON
		if $lg(logs,5)'="nullreject" { d fvals2($li(logs,2),"l",strs,.trvals) }
		//otherwise, ensure %id is selected for any of strs referenced in th
		//ON clause
			else 
			{ 
				d fvals2($li(logs,2),"l",strs,.tmpvals)
				s val="",tmpstrs="" for 
				{  s val=$o(tmpvals(val)) q:val=""
				   set:strs[(","_$p(ptv(val),"^",$$$PTVSTR)_",") $bit(tmpstrs,$p(ptv(val),"^",$$$PTVSTR))=1
				}
				s str=-1 for
				{  s str=str+1,str=$bitfind(tmpstrs,1,str) q:'str
			       s val=$$getidval^%qaqpre2(str) // PVA161
				   s trvals(val)=""
				}
			}
	}
	d fvals2(linx,"l",strs,.trvals)
	d fvals2($tr($g($$$mtSequencersQb(m)),"d"),"v",strs,.trvals) // PVA183: ORDER BY in subqueries
	do:m=1 fvals2($tr($g($$$mtSequencers),"d"),"v",strs,.trvals),fvals2($g($$$mtNewVals),"v",strs,.trvals)
	QUIT
	#; PVA087: New routine 'fvals2' 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fvals2(list,type,strs,trvals) // Build array in trvals (passed by reference) of field vals
	// referenced in list of vals or logs (as specified in type), that come from
	// a stream in strs. See fvals.
	n i,vn,vd,j,fl,f
	s list=$tr(list,"^",",")
	for i=1:1
	{   s vn=$p(list,",",i) q:'vn
	    s vd=mt(type,vn)
	    continue:"xt"[$e(vd)
	    if $e(vd)="f" s:strs[(","_$p(vd,"^",2)_",") trvals(vn)="" continue
	    s fl=$p(vd,"^",3)
	    for j=2:1 { s f=$p(fl,",",j) q:'f  set:strs[(","_$p(ptv(f),"^",$$$PTVSTR)_",") trvals(f)="" }
	}
	QUIT
	#; PVA087: New routine 'ocorr' 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ocorr // fill in correleated refs in $$$mtP(osq); called from lvtree
	for  q:"n"'=ev  s val=$p(v,"^",4),type="v",v=mt(type,val),ev=$e(v)  // follow reference 
		#; record in osq if not from a stream that will be in osq
	set:"f"=ev&&(allstr'[(","_$p(ptv(val),"^",$$$PTVSTR)_",")) $$$mtPCorrelatedFields($$$mtP(osq))=$$$mtPCorrelatedFields($$$mtP(osq))_val_"," 
		#; copy correlated fields from subquery to osq, but filter out refs to m
	if "q"=ev s v=$$$mtPCorrelatedFields($$$mtP($p(v,"^",2))) for lv=1:1 s val=$p(v,",",lv) q:'val  s:allstr'[(","_$p(ptv(val),"^",$$$PTVSTR)_",") $$$mtPCorrelatedFields($$$mtP(osq))=$$$mtPCorrelatedFields($$$mtP(osq))_val_"," 
	goto lvarg // walk down parse tree
	#; PVA087: New routine 'simple' - is a condition compatible with simplest oj xfrm
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
simple(log,rstr) // check that rstr is only stream referenced by log
	n fvals,i,fval,ok
	s ok=1,fvals=$$$mtLColVals($$$mtL(log))
	f i=2:1 { s fval=$p(fvals,",",i) q:fval=""  if $p($$$mtV(fval),"^",2)'=rstr { s ok=0 q }}
	QUIT ok
	#; JLF048-
	#; AK571
pushlog(log,fwic="w") n lf,str,vm,li,unm,call,ok2push,ns,hasubq,v  ;  move log into virtual stream subqueries
	s lf=$$$mtLColVals($$$mtL(log))
	QUIT:$O(mt("tsml",0))>1
	QUIT:lf=","  ;  streamless condition - leave it here
	QUIT:$$$mtLOperator($$$mtL(log))="DISTINCT" //PVA157
	#; Do not push a TOP: predicate
	quit:($e($$$mtL(log),1,6)="v^TOP:")
	s call="ok2push",ok2push=1,hasubq=0 d lvtree("l",log)
	#; Note, pushing collection predicate raises more issues than cloning. So, since
	#;   cloning of collection preds is supported, we allow subquery to be pushed
	#;   but not yet push collection conditions.
	for li=2:1:$l(lf,",")-1 {  if $$$mtV($p(lf,",",li))["_%ANYOF" {s ok2push=0}}
	QUIT:ok2push=0  ;  the condition involves a subquery or an %ANYOF collated field
	#; If any fval happens to come directly from a virtual stream, then
	#; store the corresponding view SELECT list val in viewFvals(val,vm)
	s vm=0
	f li=2:1 
	{	s val=$p(lf,",",li) q:val=""
		s v=$$$mtV(val),str=$p($$$mtV(val),"^",2),vm=$g($$$mtRVirtual(str))
		quit:('vm&&'$d(viewFvals(val)))	; this val cannot come from any streamed view
		#;  PVA112: can't push references to padded stream itself, only things already
		#;          in viewFvals. 
		continue:'vm||$lf(nulstr,str)  
		if val=$$$mtPViewIDVal($$$mtP(vm))	{ s vm=-1 q } // The synthetic view ID doesn't come from $$$mtOutput(vm), so do no view translation
		#; PVA095: don't modify lf, and remove function return from addviewFvals
		if '$d($$$mtUnion(vm)) 
		{	d addviewFvals(v,val,vm,$$$mtPViewIDVal($$$mtP(vm))) }
		else  
		{ 	f unm=1:1:$$$mtPNumQbs d:$g($$$mtUnionTopQb(unm))=vm addviewFvals(v,val,unm,$$$mtPViewIDVal($$$mtP(vm))) }
	}
	quit:vm=-1||'$d(viewFvals)		// if vm=-1, then this log includes a synthetic view ID
	
	n pushed,retainLog 
	s retainLog=0  // PVA269: must make this work for subquery push
	d checkdopush(0,log,lf,hasubq,.retainLog)
	d:'hasubq||'retainLog checkdopush(1,log,lf,hasubq,retainLog,.pushed)
 
 #; NOTE: lgi comes from loop calling pushlog. 
	s ns=""
	s ns=$o(pushed(ns),1,vm)
	if ns&&'retainLog&&(fwic="w") { d remove(log,"i^pushlog") } // PVA354: use remove() rather than special code
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA269: New function for two pass pushdown decision for subqueries
checkdopush(doit,log,lf,hasubq,retainLog,pushed)	
	n vm,tstr,laggs,f,ns,val,li,xlatesav
	#; Loop over all streamed views that the first fval could logically come from
	#; 
	s vm="" for
	{	s vm=$o(viewFvals($p(lf,",",2),vm)) q:vm=""  q:retainLog&&'doit
	
		#; In principle, we could do a 'virtual' push into a duplicate view (all processing
		#;   really done in the duplicated view) whenever a similar condition would be pushed
		#;   into the duplicated view. A virtual push would be: set retainlog=0, and set pushed(),
		#;   but don't do anything else. The condition will simply be removed, knowing that some
		#;   corresponding condition has been pushed into the duplicated view. It is considered 
		#;   that this isn't worth the complexity - all that is saved is a post test (but, could be 
		#;   a subquery test now), as a real condition push has occurred for the duplicated view.
		#;   NOTE: we push by normal criteria into the duplicated view. 
		#;
		if $d($$$mtDupsv(vm)) {s retainLog=1 continue  } // PVA124,PVA269
		if $$hasPagination^%qaqpsq(vm) { set retainLog=1 continue } // PVA183, YWH094: can't push into subquery with pagination - will change answer; PVA269
		if $$badvidref^%qaqpre3(vm) {s retainLog=1 continue  } // can't push if restriction on viewid // PVA231, PVA269
		if '$$condPartitionsWindows^%qaqpagg(log,$$windowsInSubq^%qaqpagg(vm)) { s retainLog=1 continue }
		#; can't push if vm has %afterhaving aggregates // PVA269
		s laggs=$$$mtPAggList($$$mtP(vm))
		if laggs]"" { s f=1 for li=1:1 {q:$p(laggs,",",li)=""  if $p($$$mtV($p(laggs,",",li)),"^",4) {s retainLog=1,f=0 quit}} continue:f=0}
		#; make sure target is not linked or is a good case for subq push
		if hasubq&&'$$push2linkok(log,vm) {s retainLog=1 continue  }
		#; When pushing into an outer join target, don't kill condition in outer query - PVA087,JLF117
		#;
		#; PVA095: fix to test null padding of stream in 'source' query; was (erroneously) testing
		#;         null padding of stream in target query. 
		s tstr=$$$mtPViewIDVal($$$mtP(vm)) s:'tstr tstr=$$$mtPViewIDVal($$$mtP($$$mtUnionTopQb(vm))) s:$lf(nulstr,$p($$$mtV(tstr),"^",2)) retainLog = 1 
		s ns=1 f li=3:1 {s val=$p(lf,",",li) q:val=""  i '$d(viewFvals(val,vm)) { s ns=0 q }}
		if 'ns {s retainLog=1 continue }  ;  not all fields could come from streamed view vm
		continue:$d($$$mtEmpty(vm)) // no need to retain on behalf of empty push target
		                         #; AS LONG AS this is the last test done, i.e. no other reason
		                         #; to retainLog. 
		#; PVA124: looping for union here gives muliple unneeded copies because building 
		#;         viewfVals already added entries to cause push to each union leg
		if doit
		{  merge xlatesav=xlate // PVA269: must ensure one union leg doesn't pollute another, now the subqueries pushed
		   s xlate("qb",m)=vm   // PVA269: must prime to repoint outer references to query pushed grom
		   n nlog s nlog = $$advlog(vm,log)
		   d propagateComplexLog(log,nlog,m,vm)
		   s pushed($i(pushed))=vm
		   k xlate  
		   merge xlate=xlatesav 
		   k xlatesav
		}
	}
	quit
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;If a pushed log is complex, mark its pushed clone as complex as well.
propagateComplexLog(log, nlog, m, vm) [ mt ] PUBLIC {
	If ("^"_$G(mt("complexlog",m))) [ ("^"_log_"^") {
		Set mt("complexlog",vm) = $G(mt("complexlog",vm)) _ nlog _ "^"
	} 
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA269: Linked table function provided by Aviel
push2linkok(log,m)  ;  $$: 0 if m is linked to a connection D, and log contains subqueries that are not wholly from D
 	QUIT:" "[$g($$$mtDSNLinkedTable(m)) 1  ;  view is processed locally
 	n lsq,jj,sq s lsq=$$listree^%qaqpagg("l",log,"q")
 	f jj=1:1 s sq=$p(lsq,",",jj) q:'sq  q:$g($$$mtDSNLinkedTable($p($$$mtV(sq),"^",2)))'=$$$mtDSNLinkedTable(m)
 	QUIT 'sq
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
addviewFvals(v,val,vm,vid)
	#; PVA095: if collated ifn, add dummy viewFval for collated ifn, and real one for uncollated
	#;         Remove function return - this now called with DO. 
	#;        \dummy/
	set:v["_" viewFvals(val,vm)="",val=$p(mts($$$mtRQb($$$mtR($p(v,"^",2))),$p(v,"^",2),"ATT",+$p(v,"^",3)),"^",5)
	s viewFvals(val,vm)=$p($$$mtOutputVals($$$mtOutput(vm)),",",val-vid)
	quit 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA087: new tag numstr
numstr(m) //return number of streams in a query block
	n c,r s c=0 s r=m_"^" for { s r=$o($$$ptrel(r)) q:r=""  q:$p(r,"^")'=m  if $i(c) } // PVA091: fix
	QUIT c
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF214
ok2push	;  check for subqueries, called from virtstr->lvtree with type,val,v,ev
	i ev="q" s hasubq=1 QUIT  	// PVA269: do allow subquery push, but remember
	#; At the moment this becomes a stub. Moved test for collection predicate out.
	#; Leaving this for possible future purpose.
	GOTO lvarg  ;  recurse down
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF214-
advlog(m,log) n log1,logi,lgi,nlog  ;  add a (subtree) copy of log to m's WHERE/HAVING,
	#;  replacing fields in log (relative to vid) by m's respective SELECT-items
	s log1=$$clone("l",log),flagg=0 d lflds("l",log1,"do")
	s nlog=log1
	#; PVA124: When a ONEOF is cloned to an IN tree, it may have top level & operations
	#;         that need flattening
	i $$whok() { f lgi=1:1 { s logi=$p(log1,"^",lgi) q:logi=""  d where^%qaqpqo(.log1,logi,.lgi) } s $$$mtWhere(m)=$g($$$mtWhere(m))_log1_"^"  QUIT nlog }  ;  add to WHERE
	s $$$mtHaving(m)=$s('$g($$$mtHaving(m)):log1,1:$$$newlog("l^&^"_$$$mtLColVals($$$mtL($$$mtHaving(m)))_$e($$$mtLColVals($$$mtL(log1)),2,*)_"^"_$$$mtHaving(m)_"^"_log1_"^"))
	#; AK672
	#;  for HAVING, must mark all fields as "needed for output"
	s log1=$$$mtLColVals($$$mtL(log1))
	f log=2:1:$l(log1,",")-1 s $p(ptv($p(log1,",",log)),"^",$$$PTVNEEDEDFOROUTPUT)=0
	#; AK672-
	QUIT nlog
	#; PVA201: clone becomes clone1; then clone copies vtr infor for "v" type nodes
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
clone(type,val,ft=0) n vtr,v  ;  see clone1
	#; tbd: ensure that mt("unary",*) is translated either by clone or by callers of clone.
	s:$d($$$mtVtr(val))&&(type="v") vtr=$$$mtVtr(val)
	s v=$$clone1(type,val,ft)
	if $d(mt("barstrans",val)) s mt("barstrans",v) = mt("barstrans",val)
	s:$d(vtr) $$$mtVtr(v)=vtr
	QUIT v
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
clone1(type,val,ft=0) n v,ev,nuv,lv,earg,mtg,ovlst,pos,tval  ;  $$: type="v"/"l", recursively make a
	#;  (subtree) copy of ST entry val, replacing leaf fields
	#;  (relative to vid) by m's respective SELECT-items
	s v=mt(type,val),ev=$e(v)
	i ev="f" {
		RETURN:ft val
		set tval=val
		#;  leaf field - if collation, find the original field
	#; JLF117
		s val=viewFvals(val,m) 
		#; PVA095: Change collation handling to exploit dummy entry recorded by addviewFvals
		if 'val // must be collation of streamed ifn recorded as dummy
		{  s val=$p(mts($$$mtRQb($$$mtR($p(v,"^",2))),$p(v,"^",2),"ATT",+$p(v,"^",3)),"^",5)
		   s val=$$coll^%qaqpqo(viewFvals(val,m),$p(v,"_",2,*))
		}
	#; JLF339
		#; Translate the baseFld if the ifn is a collection subvalue reference
		#;
		n aoifn,baseFld,ifn
		s v = $$$mtV(val)
		if v["_",$p(v,"_",2)["%ANY"
		{	s ifn=$p(v,"^",3,*),aoifn=$e(ifn,1,$find(ifn,$s(ifn["%ANYOFKEY":"%ANYOFKEY",1:"%ANYOF"))-1),baseFld=$e(ifn,$l(aoifn)+1,*)
			if '$d(xlate("bf",baseFld))
			{	s xlate("bf",baseFld) = $i($$$mtNumAnyOf)
				s $p(v,"^",3,*) = $e(ifn,1,$l(aoifn))_xlate("bf",baseFld)
				s $$$mtV(val) = v
				d nuatt^%qaqpqo(val, $p(v,"^",2), $p(v,"^",3))
			}
		}
	#; JLF339-
	#; JLF117-
		set:$d($$$mtVecDistFunc(tval)) $$$mtVecDistFunc(val)=$$clone("v",$$$mtVecDistFunc(tval),ft) // update vector distance function fake field
		QUIT val  ; 
	}
	QUIT:"xt"[ev val  ;  parameter/constant/correlated field
	#; PVA183: start using xlate if set up
	QUIT:$d(xlate(type,val)) xlate(type,val)
	#; PVA115: Real outer reference handling needed for deep query copy
	if ev="n"
	{  n qn s lv=$p(v,"^",4)
	   QUIT:"xtn"[$$$mtVType($$$mtV(lv)) val // n to n not currently supported / expected per flds code
	   set:$$$mtVType($$$mtV(lv))'="f" lv=$p($p($$$mtV(lv),"^",3),",",2)
	   QUIT:'lv val // outer ref to streamless expression - can just re-use
	   #; now lv is an outer field val at the proper query level (outer refs to multiple
	   #;    levels are not possible)
	   s qn=m
	   for 
	   {  q:qn=0
	      if $d(viewFvals(lv,qn)) 
	      {  if $$$mtVType($$$mtV($p(v,"^",4)))="f" {s val=$$$newval("n^^,^"_viewFvals($p(v,"^",4),qn)_"^",1) q } 
		     if '$d(xlate("v",$p(v,"^",4))) { new m s m=qn s xlate("v",$p(v,"^",4))=$$clone("v",$p(v,"^",4),ft) }
		  	 s val=$$$newval("n^^,^"_xlate("v",$p(v,"^",4))_"^",1) 
			 q
	      }
	      s qn=$$$mtCorrParentQb(qn)
	   }
	   QUIT val 
	}
	#; PVA115: Aggregate handling for copyqb
	if ev="a"  
	{  if $p(v,"^",3)'=","
	   {  s nuv=v s:$p(nuv,"^",5) $p(nuv,"^",5)=$$clone("v",$p(v,"^",5),ft)
	      s mtg=$g($$$mtGroupDistinctList($$$mtRQb($$$mtR($p($$$mtV($p($p(v,"^",3),",",2)),"^",2))))) //source mt("g")
	      s mtg=$listfromstring(mtg),earg=$p(nuv,"^",6),ovlst=$p(v,"^",6)
	      for lv=1:1:$l(earg,",")-1
	      {  s pos=$lf(mtg,$p(ovlst,",",lv))
	         if pos s $p(earg,",",lv)=$p($$$mtGroupDistinctList(m),",",pos)
	         else  s $p(earg,",",lv)=$$clone("v",$p(earg,",",lv),ft)
	      }
	      s $p(nuv,"^",6)=earg,earg=$p(nuv,"^",7),ovlst=$p(v,"^",7)
	      for lv=1:1:$l(earg,",")-1
	      {  s pos=$lf(mtg,$p(ovlst,",",lv))
	         if pos { s $p(earg,",",lv)=$p($$$mtGroupDistinctList(m),",",pos) }
	         elseif $p(ovlst,",",lv)=$p(v,"^",5) {s $p(earg,",",lv)=$p(nuv,"^",5)}
	         else { s $p(earg,",",lv)=$$clone("v",$p(earg,",",lv),ft) }
	      }
	      s $p(nuv,"^",7)=earg,val=$$$newval(nuv,1)
	   }
	   else {s val=$$$newval(v,1)}
	   s $$$mtPAggList($$$mtP(m))=$$$mtPAggList($$$mtP(m))_val_","
	   QUIT val
	}
	
	#; If we are sitting on a class method invocation that encodes information 
	#; in its piece 2 about a val (vval) in viewFvals(vval,m), then clone the
	#; mt("unary",vval1,"%ANYOF[KEY]:baseFld")=vval2 node if necessary, and update 
	#; the reference in the method call to reference the new mt("unary",*,*) node
	#;
	#; JLF339
	if ev="v",type="v",$p($p(v,"^",2),":",1)="METHOD",$e($p($p(v,"^",2),":",3),1,6)="%ANYOF",$p($p(v,"^",2),":",4)'=""
	{	n xx,oldBaseFld,bk,vv,newvv s xx=$p(v,"^",2),oldBaseFld=$p(xx,":",4),bk=""
		s:$g(xlate("bf",oldBaseFld))="" xlate("bf",oldBaseFld) = $i($$$mtNumAnyOf)
		s $p(xx,":",4)=xlate("bf",oldBaseFld)
		s $p(mt(type,val),"^",2) = xx
		#; Translate mt("unary",*,*) for %ANYOF collations in accordance with
		#; viewFvals and xlate("bf",*) so that any references to mt("unary",*,*)
		#; from class method invocations can be properly translated.
		#;
		s x="" 
		for
		{ 	s x=$o(mt("unary",x)) q:x=""  
			s vv="" 
			for
			{	s vv=$o(mt("unary",x,vv)) q:vv=""
				s newSrc = $s($g(viewFvals(x,m))'="":viewFvals(x,m),1:x)
				s newTrg = $s($g(viewFvals(mt("unary",x,vv)))'="":viewFvals(mt("unary",x,vv)),1:mt("unary",x,vv))
				#; The vv subscript may be of the form "%ANYOF[KEY]:"_baseFld
				#;
				set newvv = $s($p(vv,":",2)=oldBaseFld:$p(vv,":",1)_":"_xlate("bf",$p(vv,":",2)),1:vv)
				set mt("unary",newSrc,newvv)=newTrg
			}
		}
	}
	#; JLF339-
	#; AK597
	#; PVA210: Go back to cloning streamless expressions; no safe criteria for when
	#;         not to do it have been found. 
	#; PVA202: re-enable non copying of streamless "" type node: iff they contain no "n" nodes
	#; PVA199: must actually clone streamless expressions because of outer references
	#; QUIT:("vl"[ev)&&(type="v")&&($p(v,"^",3)=",")&&'$$findtree(type,val,"nq") val  ;  streamless expression // PVA099: always clone an "l" node
	QUIT:ev="q" $$$mtPQbVal($$$mtP($$copysubq^%qaqpre3($p(v,"^",2),m)))
	s nuv=v
	#; PVA115: Special handling for FOR SOME for copyqb. Must clone 5th arg before 4th so
	#;         outer ref to expression in 5th will be found when cloning the query in 4th.
	#; JLF136: Generalized to handle the collection case
	if $e(nuv,1,10)="v^FOR SOME" 
	{  if $p(nuv,"^",5) s $p(nuv,"^",5)=$$clone("v",$p(nuv,"^",5),ft) s xlate("v",$p(v,"^",5))=$p(nuv,"^",5)
	   s $p(nuv,"^",4)=$$clone("v",$p(v,"^",4),ft)
	   QUIT $$$newlog(nuv)
	}
	#; PVA232: clone listsize, if present (for set:lists)
	i "vl"[ev f lv=4:1:$l(v,"^")-1 CONTINUE:'($p(v,"^",lv))  s $p(nuv,"^",lv)=$$clone(ev,$p(v,"^",lv),ft) s:$d(mt("listsize",$p(v,"^",lv))) mt("listsize",$p(nuv,"^",lv))=mt("listsize",$p(v,"^",lv))
	#; AK597
	#;  check if unary function
	n unf s unf=("vl"[ev)&&($l(v,"^")=5)&&(($$$ISENCODEDCOLLATE($p(v,"^",2)))||(" + - %ALPHAUP %EXACT %EXTERNAL %INTERNAL %INTEXT %MVR %ODBCIN %ODBCOUT %RUNTIMEIN %RUNTIMEOUT %SQLSTRING %SQLUPPER %STRING %TRUNCATE %UPPER "[(" "_$p(v,"^",2)_" ")))
	#;  and if it already has an entry
	QUIT:unf&&$d(mt("unary",$p(nuv,"^",4),$p(nuv,"^",2)),earg) earg
	#; AK597-
	set:ev="s" $p(nuv,"^",4)=$$clone("v",$p(v,"^",4),ft)
	i ev="e" s earg=$p(nuv,"^",4) f lv=1:1:$l(earg,",")-1 { s $p(earg,",",lv)=$$clone("v",$p(earg,",",lv),ft) } s $p(nuv,"^",4)=earg
	#; PVA124: If cloning a ONEOF, then reverse it back to IN/INSET and other operators
	#;    so it can be analyzed fresh in the target query
	if type="l"
	{  n nl s nl=$$$newlog(nuv)
	   set:$bit($g(ptlikeimp),val)=1 $bit(ptlikeimp,nl)=1  ;  JLF361
	   set:$$$mtLOperator($$$mtL(nl))="ONEOF" nl=$$undoONEOF^%qaqpre3(nl,$p($p(ptv($p(v,"^",4)),"^",$$$PTVRANGEINFO),",",2))
	#; JLF339
	   #; Translate $$$mtAnyOfVals(oldLog)=oldBaseList to $$$mtAnyOfVals(newLog)=newBaseList
	   if $d($$$mtAnyOfVals(val))
	   {	n bfs f bfs=1:1:$ll($$$mtAnyOfVals(val))
	   		{	s:'$d(xlate("bf",$li($$$mtAnyOfVals(val),bfs))) xlate("bf",$$$mtAnyOfVals(nl)) = $i($$$mtNumAnyOf)
	   			s $$$mtAnyOfVals(nl)=$g($$$mtAnyOfVals(nl))_$lb(xlate("bf",$$$mtAnyOfVals(nl)))
	   		}
	   }
	#; JLF339-
		if $d(mt("nRTP","SelInfo",val)){ ; YCL394
			set mt("nRTP","SelInfo",nl)=mt("nRTP","SelInfo",val)	
 		}
	   QUIT nl
	}
	#; AK597
	#;  if unary function, add new entry to mt("unary")
	QUIT:unf $i(mt("unary",$p(nuv,"^",4),$p(nuv,"^",2)),$$$newval(nuv,1))
	#; AK597-
	#; PVA183: Special handling for various TOP vals & logs 
	#;    Must record key vals in xlate
	if $e(nuv,1,8)="v^%LIMIT" { QUIT $i(xlate(type,val),$$$newval(nuv,1)) }
	if $e(nuv,1,6)="v^TOP:",$l($p(nuv,"^",2),".")=1 s xlate("v",$p(v,"^",4))=$p(nuv,"^",4)
	if $e(nuv,1,1)="v^TUPLE" { f lv=4:1:$l(v,"^")-1 s xlate("v",$p(v,"^",lv))=$p(nuv,"^",lv) }
	QUIT $$$newval(nuv,1)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
whok()	n lv  ;  $$: 1 if can go into WHERE clause
	QUIT:flagg 0  ;  condition has aggregates
	QUIT:$$$mtPAggList($$$mtP(m))="" 1  ;  query has no aggregates at all
	RETURN:$$$mtLColVals($$$mtL(log1))="," 0  ;  there are no fields in the condition
	#;  check that all fields in condition are in the GROUP BY list
	f lv=2:1:$l($$$mtLColVals($$$mtL(log1)),",")-1 GOTO quit0:","_$g($$$mtGroupDistinctList(m))'[(","_$p($$$mtL(log1),",",lv)_",")
	QUIT 1
quit0	QUIT 0  ;  found field not in GROUP BY - WHERE might affect aggregate result
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK597-
	#; JLF080
flds
	n logs,xa,inagg,str,lstvals // PVA135
	s inagg=0 // PVA198
	s output=0 d lflds("l",$g($$$mtWhere(m)),"do") d lflds("l",$g($$$mtStreamlessConds(m)),"do") d lflds("l",$g($$$mtPartitionPredicates(m)),"do") //PVA284: add $$$mtStreamlessConds() PVA304: %partition
	#; PVA342: support row level security store aside
	s str="" for 
	{  s str=$o(mt("RLS",str),1,logs) q:str=""  continue:$$$mtRQb($$$mtR(str))'=m
	   d lflds("l",logs,"do")
	}
	
	#; PVA092: New mt("ON",) structure
	#; PVA087: Process deferred ON clauses.
	   s xa="" f { s xa=$o($$$mtOn(m, xa),1,logs) q:xa=""
	          continue:$lg(logs,5)="nullreject"
	          s logs=$li(logs,2) 
	          d lflds("l",logs,"do")
	   }
	#;  PVA348:  process fields in tvf arguments (including JSON_TABLE)
	s str="" for 
	{  s str=$o($$$mtTvfParams(str),1,lstvals) q:str=""  continue:$$$mtRQb($$$mtR(str))'=m
	   continue:lstvals=$c(0)
	   s lstvals=$$listToStringSkipNull^%qaqutility(lstvals) continue:lstvals=""
	   d lflds("v",lstvals,"do") 
	}
	s:$g(outputHav) output=1 
	d lflds("l",$g($$$mtHaving(m)),"do")
	s output=1
	#; JLF080-
	f vals=$g($$$mtGroupDistinctList(m)),$$$mtOutputVals($g($$$mtOutput(m))) d lflds("v",vals,"do")
	f ext=1:1:$o($$$mtOutputOverflow(m,""),-1) d lflds("v",$g($$$mtOutputOverflow(m,ext)),"do")
	f li=2:1:$l($g(mt("tsml",m)),"^") d lflds("v",$p(mt("tsml",m),"^",li))
	#; PVA183: subquery ORDER BY
	d lflds("v",$tr($g($$$mtSequencersQb(m)),"d"),"do")  ;list fields for ORDER list
	d:m=1 lflds("v",$tr($g($$$mtSequencers),"d"),"do")  ;list fields for ORDER list
	#; list fields in mt("vdf") ; AK1093, needed for vector ANN
	new fakeField,vdf
	set fakeField=""
	for {
		s fakeField=$o($$$mtVecDistFunc(fakeField),1,vdf) q:fakeField=""  
		d lflds("v",vdf,"do") 
	}
	#; AK389
	d:m=1 lflds("v",$g($$$mtNewVals),"do")  ;  list fields in INSERT/UPDATE
	s output=0  ;  output
	#; AK501
	#;  compute field list in $P(3) for outer join conditions (m must be set!)
	f lx=1:1 {
		s log=$p(linx,"^",lx) q:'log
		CONTINUE:m'=$$$mtRQb($$$mtR($lg($$deriveStreams^%qaqpqo("l", log,1))))
		Do lflds("l",log,"do")
	}
	#; AK501-
	#; outer references can refer to expressions which have no other reachability in the parse tree.
	#; for such expressions that are contained in this subquery, make sure lflds is called.
	d lfldsOuterRefs(m,.nnodecache)
	#;  after marking all aggregates, if "onerow" and none left  ;  AK1036
	#;  (all eliminated as unused view fields), then mark m as "empty"
	i $g($$$mtOneRow(m)),$$$mtPAggList($$$mtP(m))="" { s $$$mtEmpty(m)=1,$$$mtWhere(m)="",$$$mtStreamlessConds(m)="" }
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
		#; Note: As this routine is being used more to re-initialize things, 
		#; its behavior should be documented. 
		#; 1) Repeated calls completely reconstruct piece 3 field lists for the query m
		#;    only. EXCEPT: correct construction of piece 3 of q nodes referenced in m 
		#;    requires that $$$mtP(m) piece 4 is complete and correct for subqueries of m 
		#;    at the time flds is called for m. See below for what is required to 
		#;    ensure this. 
		#; 2) As a rule, if flds is called for two queries with a containment relationship,
		#;    it should always be called first for the inner query, then the outer query. 
		#;    Otherwise, piece 3 of a q node will not necessarily be correct. 
		#; 3) Query parameter list (piece 4 of $$$mtP(m)) is only added to. It is only 
		#;    built properly, from scratch, if flds is called for all queries in order of 
		#;    inner to outer in the sense of $$$mtPActiveQbs containment, with all piece 4 
		#;    starting out blank. While other usage will fail to correct or initialize 
		#;    the parameter lists it is harmless in the sense that duplicates in this 
		#;    list are harmless. On the other hand, if some parameter needs to change, 
		#;    calling flds again will fail to achieve this unless called inner to outer, 
		#;    for all queries, with all lists starting empty. Short of this, a 
		#;    transform must explicitly correct these lists outside of flds, if they can
		#;    be affected by the transform. 
		#; 4) 'flagg' will be correctly set for query m as long as it is initialized before
		#;    the call.
		#; 5) The two ptv flags are only maintained, not reset. Thus, if they should 
		#;    change from the default state to non-default, calling flds will correct them.
		#;    However, if they change from non-default to default, flds will not correct
		#;    them. To reconstruct a best state, these flags should be cleared
		#;    to the default state for all fvals of m before calling flds (nuatt defines
		#;    the default state). Note, though, that an unnecessary non-default for either
		#;    of these flags will not affect validity, only performance. The error in the
		#;    other direction (which flds will correct) is the one which would cause runtime
		#;    failure of the query. 
		#;    
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; This may be called as a DO (lflds="do") or $$ (lflds undefined)
lflds(type,list,lflds)  ;  $$/DO:  type=v/l, (update) LIST(val#,) of fields
	new savinagg,v
	set savinagg=$g(inagg) // PVA198
	#; Side effects:
	#; * sets $P(3) to the field list
	#; * set correlated field list in $p($$$mtP(m),4) (*** needs fixing!)
	#; * set flagg if aggregates encountered
	#; * set $P(ptv(fval),12)=0 if needed for output
	#; * set $p(ptv(fval),15)=1 if used at all
	#; * set aggregate list (if not already there): $p($$$mtP(m),3) (PVA198)
	s lflds=$G(lflds),list=$tr(list,"^",",")
lflup	i 'list QUIT:lflds'="do" lflds QUIT  ;  DO if lflds="do", o/w return list
	s v=mt(type,+list),ev=$e(v)  ;  first on list
	i "f"=ev d lfield GOTO tail
	i "t"=ev  s v="" GOTO tail 
	i "x"=ev 
	{	i v=("x^"_+$e(v,3,*)),v'="x^0" {
			d:($g(rtpcHelperCode("caller"))'="ShowPlan1")&&($g(rtpcHelperCode("caller"))'="Query1") latf  ;  AK850
		}
		s v="" GOTO tail 
	}
	#; AK704
	if "vl"[ev { set v=$$lflds(ev,$p(v,"^",4,*)) GOTO fset }
	if "emrs"[ev { set v=$$lflds("v",$p(v,"^",4)) GOTO fset }
	if "a"=ev  { // PVA198: enhance to maintain aggregate list (of top level aggregates)
		if $d(inagg),'inagg {
			set inagg=1
			if ","_$$$mtPAggList($$$mtP(m))_","'[(","_+list_",") { set $$$mtPAggList($$$mtP(m))=$$$mtPAggList($$$mtP(m))_+list_"," }
		}
	   set v=$$lflds("v",$s($e(v,1,6)="a^udaf":$p(v,"^",9),1:"")_$p(v,"^",6)_$p(v,"^",7)_$p(v,"^",5)),flagg=1 
	   set:$d(inagg) inagg=savinagg
	   GOTO fset
	}
		#;  for a subquery, process the list of correlated fields.
		#;  return only fields from this (the parent) subquery
	i "q"=ev   s v=$$lflds("v",$$$mtPCorrelatedFields($$$mtP($p(v,"^",2)))) GOTO fset
	#; this shoud work properly both for correlated fields and qcomp expr.
	#;  Do we really need to recurse?  to mark "output" flag, "used"?
	#; AK571
	#;  find any field and process it in pcorr as a correlated field.
	#;  correlated subexpressions from opsome^pop, e.g. "<expr> IN ...",
	#;  are in $P("v^FORSOME^...",5) and are processed in their native "m"
	i "n"=ev n call s call="pcorr" d lvtree("v",$p(v,"^",4)) s v="" GOTO fset
	#; AK571-
	s:"i"=ev v=" *** "  ;  error or unimplemented
fset	s $p(mt(type,+list),"^",3)=","_v  ;  update list in $p(3) of sub-exp
tail	s:lflds'="do" lflds=lflds_v s list=$p(list,",",2,*) GOTO lflup
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
lfield	;  handle case of a field
	#; AK571
	#;  "n" nodes not processed here, 
	#;  filter out any correlated fields (must come from "q" node in lflup)
	i $p(ptv(+list),"^",$$$PTVQB)'=m s v="" QUIT
	do markFieldReferenced(m, +list, output)
	set v = +list_","
	QUIT
	#; AK571-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
latf	n latf,latfm,latvs,nolatf  ;  mark the laterally-referenced  ;  AK850
	#;  field NN (in x^NN) as "used" and "needed for join"
	#;  latf=val# of the field referenced laterally
	#;  latfm=q# that this field is part of
	#;  latvs=str# within latfm of the view (or tvf) that uses v
	s $LB(,latf,,latfm,,latvs)=$$latxn^%qaqpre2(v,m)
	d badlatv(latf,latvs)  ;  check for RIGHT/FULL OJ
	d markFieldReferenced(latfm,latf,0)
	d aptv(latf,$$$PTVOJSTR,latvs_",")
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
badlatv(val,strv)  ;  find bad lat-ref from strv to fields in val  ;  AK1060
	RETURN:'val  ;  e.g. missing argument
	n v,vi s v=$$$mtV(val)
	i $e(v)="f" { d badlats($p(v,"^",2),strv) RETURN }
	RETURN:"xt"[$e(v)  ;  otherwise go over fields listed in $P(3)
	f vi=2:1:$l(v,",")-1 d badlats($p($$$mtV($p(v,",",vi)),"^",2),strv)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
badlats(strf,strv)  ;  find illegal lat-ref from strv to strf  ;  AK1060
	#;  *** should be new error: "RIGHT/FULL OUTER JOIN cannot use lateral references"
	d:'$d(nolatf) CheckLateralOJ  ;  one-time build of nolatf(,) array
	d:$d(nolatf(strf,strv)) error(94)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
markFieldReferenced(m, v, output) [ mt, mts, ptv ] PUBLIC {
	#;  mark in $p(ptv,15)=1 iff used.  This is used to see if
	#;  only auf(f) is used, in which case an aup index not containing
	#;  the field itself may be used.  *** AK527 fsave^qo1 should be
	#;  modified to use this flag instead of the complex logic!
	s $p(ptv(v),"^",$$$PTVREFERENCED)=1 s:output $p(ptv(v),"^",$$$PTVNEEDEDFOROUTPUT)=0
	#; PVA198: Following ugliness needed because a collated virtual field inherently 
	#;         references the underlying virtual field - because (unlike for real fields, 
	#;         e.g. indexes) there is no possible source except the underlying virtual 
	#;         field. This need to be treated as referenced even if no direct reference.
	if $$$mtV(v)["_",$d($$$mtVirf(+$p($$$mtV(v),"^",3))) { d markFieldReferenced(m,$p(mts(m,$p($$$mtV(v),"^",2),"ATT",+$p($$$mtV(v),"^",3)),"^",5),output) }
	RETURN
}
	#; AK571
pcorr	;  called from $$lflds->"n"->lvtree with type,val,v,ev - for any fields
	#;  found, set up $P($$$mtP(),4) for all superqueries
	i "f"=ev d corr(val,m)
	#; AK821
	i "n"=ev d lvtree("v",$p(v,"^",4))
	i "q"=ev {
		n i,cv
		for i=2:1 {
			s cv=$p($p(v,"^",3),",",i) QUIT:cv=""
			d corr(cv,m)
		}
	}
	GOTO lvarg  ;  recurse down
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
corr(val,m)  ;  list of correlated fields in $p($$$mtPActiveQbs,4) for this and all superqueries
	QUIT:$p(ptv(val),"^",$$$PTVQB)=m
	i (","_$$$mtPCorrelatedFields($$$mtP(m)))[(","_val_",") QUIT
	n un0 s $$$mtPCorrelatedFields($$$mtP(m))=$$$mtPCorrelatedFields($$$mtP(m))_val_",",un0=$g($$$mtUnionTopQb(m))
	s:un0&&(un0'=m) $$$mtPCorrelatedFields($$$mtP(un0))=$$$mtPCorrelatedFields($$$mtP(un0))_val_","
	d corr(val,+$$$mtP(m))  ;  recurse up
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;"n" nodes can provide the only reachability in the parse tree
	#;for some expressions, and these expressions need to have a correct
	#;$p(3) field list.
	#;Scan the mt("v") array for "n" nodes that point to expressions.
	#;If the expression is contained by subquery m (see subqContainsExpression
	#;for what this means), call lflds on it to ensure $p(3) is updated.
lfldsOuterRefs(m,cache) [ mt ] PUBLIC {
	Set val = ""
	For {
		Set val=$o(cache(val)) QUIT:val=""
		Set v=$$$mtV(val)
		Set ref = $p(v,"^",4)
		Set v = $$$mtV(ref)
		//Only interested in references to expressions. The target of n->n->v chains will be handled
		//when we find the last reference of the chain in mt("v").
		CONTINUE:$e(v)'="v"
		//The outer reference may be the only live reference to this expression if none of the
		//usual 'entry points' to the parse tree (mt("o"), mt("w"), etc.) refer to it.
		//Analyze the expression to see if it belongs to subquery m, and if so, lflds it
		//as if it were in (e.g.) $$$mtOutput(m).
		If $$subqContainsExpression(m, ref) Do lflds("v", ref, "do")
	}
	Set val = $g(cache)
	For {
		//grep through mt("v") for "n" nodes
		Set val = $o($$$mtV(val),1,v) QUIT:val=""
		CONTINUE:$e(v)'="n"
		Set cache(val)=""
		Set ref = $p(v,"^",4)
		Set v = $$$mtV(ref)
		//Only interested in references to expressions. The target of n->n->v chains will be handled
		//when we find the last reference of the chain in mt("v").
		CONTINUE:$e(v)'="v"
		//The outer reference may be the only live reference to this expression if none of the
		//usual 'entry points' to the parse tree (mt("o"), mt("w"), etc.) refer to it.
		//Analyze the expression to see if it belongs to subquery m, and if so, lflds it
		//as if it were in (e.g.) $$$mtOutput(m).
		If $$subqContainsExpression(m, ref) Do lflds("v", ref, "do")
	}
	set cache=$$$maxv
}
.
 //Returns true iff the expression val is contained in subquery m. For the purposes of
 //this analysis, an expression is considered contained in a subquery if it refers to one
 //or more fields (via "f" nodes) from a stream of m, or one or more subqueries (via "q" nodes)
 //that are children of m.
 //
 //It is an invariant of the parse tree that all such nodes in a single expression must
 //imply the same subquery contains that expression. Fields from different subqueries must
 //not be mixed in a single expression without the use of outer references ("n" nodes). The
 //context of subquery subexpressions is fixed by $$$mtPActiveQbs $p(1) and must match the context of
 //the rest of the expression.
 //
 //As a result, we can treat the first "f" or "q" node encountered as representative.
subqContainsExpression(m, val) [ call, m, subqContainsExpression ] PUBLIC {
	New call Set call = "subqContainsExpressionLV^%qaqpnl"
	New subqContainsExpression Set subqContainsExpression = 0
	Do lviter("v", val)
	RETURN subqContainsExpression
}
subqContainsExpressionLV
	If ev="f" Set subqContainsExpression=($$contextForFieldVal(val)=m) QUIT
	If ev="q" Set subqContainsExpression=($$contextForSubqVal(val)=m) QUIT
	GOTO lviterarg
	
 //The context for a field is the subquery containing its stream
contextForFieldVal(val) [ mt ] PUBLIC {
	Set v = $$$mtV(val)
	Set str = $p(v,"^",2)
	Set subq = +$$$mtRQb($$$mtR( str)) 
	RETURN subq
}
 //The context for a subquery is its parent subquery
contextForSubqVal(val) [ mt ] PUBLIC {
	Set v = $$$mtV(val)
	Set subq = $p($$$mtV(val),"^",2)
	Set parentSubq = +$$$mtP(subq)
	RETURN parentSubq
}
	#; PVA087: Split notnull into notnullw (a utility usable on any trailing subset of the 
	#;         WHERE clause, and notnullh (usable on a single condition, returning
	#;         a single, usually different, condition). 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK571-
	#; AK407
notnullw(m,stlog) n logs,nnf,jj,log,v,nn,ii  ; apply NOT NULL logic to m's WHERE
                                             ; starting from position stlog
	s logs=$g($$$mtWhere(m)),nnf=""  ;  list of fields known as NOT NULL
	f jj=1:1 s log=$p(logs,"^",jj) q:'log  s v=$$$mtL(log) s:$e(v,1,8)="v^'NULL^" nnf=nnf_$LB($p(v,"^",4))
	i $d(mt("svso",m)),$lg(mt("svso",m),1)="anyneq" { n val s val=$$nncond^%qaqpnl($li($li(mt("svso",m),4),1)), $$$mtWhere(m)=$g($$$mtWhere(m))_val_"^" }	; JLF242	
	s logs=$p($g($$$mtWhere(m)),"^",stlog,*)
	For jj=1:1 {
		s log=$p(logs,"^",jj) q:'log
		s nn=$$nnlf(log),nnf=nnf_nn 
		For ii=1:1:$ll(nn) {
			s $$$mtWhere(m)=$$nncond($li(nn,ii),1)_"^"_$$$mtWhere(m)
	#; DPV1693
			  #;  If we are info compiling a view's query during SQL binding we need to continue tracking
			  #;  which log conditions are from the view itself and which are from view(s) in the FROM
			  #;  clause in case of WITH LOCAL CHECK OPTION.  So if we add a NOT NULL condition for a field
			  #;  from the cascaded check option list, also add the NOT NULL condition to that list.
			i callname["view",$lf($g($$$mtWhereCheckOption),log) s $$$mtWhereCheckOption=$$$mtWhereCheckOption_$lb($p($$$mtWhere(m),"^"))
	#; DPV1693-
		}
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
notnullh(inlog) // returns new log (new top level & node)
	n nn,nni,nnf s nnf="" // Future - figure out a way to share nnf collected during calls to notnullw
	#; JLF087
	s nn=$$nnlf(inlog) 
	f nni=1:1:$ll(nn) { Set val=$$$newlog("l^&^"_$$addcls($$$mtLColVals($$$mtL(inlog)),$li(nn,nni,nni))_"^"_$$nncond($li(nn,nni))_"^"_inlog_"^") s inlog=val }
	#; JLF087-
	QUIT inlog
	          #; PVA096: Describe flaw in piece 3 handling 
	#; nnlf() has long had a fundamental logical flaw in piece 3 maintenance. This flaw 
	#;        occurs for a tree of ORs. The function return of nnlf is supposed to be list
	#;        of fields not yet tested for null. For an OR, this is the intersection
	#;        of those of the left and right legs (the other tests having been added in
	#;        each leg). However, for piece 3 maintenance of a higher operator 
	#;        (above the OR), you want the union 
	#;        of any fields with null tests added (because piece 3 of any node is always
	#;        union of its operand piece 3s). In the special cases when the null test 
	#;        is different collation from other field usages, piece 3 is left invalid in
	#;        nodes above an OR.  
	#;        For now, we leave the erroeous piece 3 maintenance, and make it harmless
	#;        by ensuring that lfnull never adds new field requirement. 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nnlf(log) n v,ii,ff,nn4,nn5,nn,call s call="lfnul" ;  (nnf implicit) $$:  return $list() of fields
	#;  (or NVL, CASE, etc. subexpressions - AK568)
	#;  that must be made to fail condition log if either is NULL.
	#;  In case of OR, also apply NOT NULL logic to each operand
	s v=$$$mtL(log)
	QUIT:$e(v,1,6)="v^TOP:" ""	; TOP n passes nulls JLF081
	#;  for IN,%INLIST,%STARTSWITH just test the left hand side  JLF085,JLF089,JLF270
	#;  however, note that NOT IN must apply the 'NULL test to 
	#;  each IN list item, and similarly for NOT %INLIST.
	#; PVA305: this should have checked for %noindex per PVA242
	if $e(v)="v",",IN,INSET,%STARTSWITH,JSON*O,JSON,JSON*A,JSON*V,JSON*S,"[(","_$p($p(v,"^",2),"%NOINDEX")_",") { set nn="" do lvtree("v",$p(v,"^",4)) QUIT nn }
	QUIT:v["NULL" ""  ;  IS [NOT] NULL
	#;  for AND, return the two lists combined
	i $e(v,1,4)="l^&^" QUIT $$unls($$nnlf($p(v,"^",4)),$$nnlf($p(v,"^",5)))
	#;  for OR, return common fields, apply the rest to each subcondition
	#; AK481
	#; JLF233
	i $e(v,1,4)="l^!^" s nn4=$$nnlf($p(v,"^",4)),nn5=$$nnlf($p(v,"^",5)),nn=$$intls(nn4,nn5) s $$$mtLOperand1($$$mtL(log))=$$andnn($p(v,"^",4),$$diffls(nn4,nn)),$$$mtLOperand2($$$mtL(log))=$$andnn($p(v,"^",5),$$diffls(nn5,nn)),ii=$$$mtLColVals($$$mtL($$$mtLOperand1($$$mtL(log)))),v=$$$mtLColVals($$$mtL($$$mtLOperand2($$$mtL(log)))),$$$mtLColVals($$$mtL(log))=(","_$$distlist^%qaqcpr($e(ii,2,$l(ii))_$e(v,2,$l(v)))) QUIT nn
	#; JLF085
	#; JLF101-
	#; For NOT FOR SOME [ ELEMENT ], do not add a 'NULL test for piece 5 of the FOR SOME
	QUIT:($e(v)="l")&&($p($p(v,"^",2),"%NOINDEX")="'")&&($e($$$mtL($p(v,"^",4)),1,10)="v^FOR SOME") ""
	QUIT:$e($p(v,"^",2),1,10)="NOTEXISTS:" ""
	#; JLF101--
	#; PVA305: this should have checked for %noindex per PVA242
	QUIT:($e(v)="l")&&($p($p(v,"^",2),"%NOINDEX")="'")&&(",IN,INSET,"'[(","_$p($$$mtLOperator($$$mtL($p(v,"^",4))),"%NOINDEX")_",")) $$nnlf($p(v,"^",4))  ;  NOT, except NOT IN and NOT %INLIST - JLF270
	#; YCL034 - add check for each element in the list for NOT %INLIST
	if ($e(v)="l")&&($p($p(v,"^",2),"%NOINDEX")="'")&&($p($$$mtLOperator($$$mtL($p(v,"^",4))),"%NOINDEX")="INSET") {
		set nn4=$$nnlf($p(v,"^",4))
		if ("^"_$$$mtWhere(m))[("^"_log_"^") { ; add as TOP AND condition
			do nulog("v^NCNUL^^"_$p($$$mtL($p(v,"^",4)),"^",5,*))
			do lflds("l",val,"do") 
		} else {
			new ncnul
			Set val=$$$newlog("v^NCNUL^^"_$p($$$mtL($p(v,"^",4)),"^",5,*)) 
			set ncnul=val
			do lflds("l",val,"do")
			set $$$mtL(log)="l^&^"_$$$mtLColVals($$$mtL(log))_"^"_$$$newlog($$$mtL(log))_"^"_ncnul_"^" ; copy current log to a new log, rewrite current log with the AND condition
		}
		RETURN nn4
	}
	#;  condition must be of type v
	s nn=""  ;  it's a comparison - collect the fields, with default collations
	#; AK568
	#; FOR SOME, EXISTS subqueries ($p 4) do not need null analysis: They're understood as a set, not a value.
	#; If there's a fifth argument, it must be not null for a non-negated FOR SOME (see the negated case above).
    i ($e(v,1,10)="v^FOR SOME")||($e(v,1,9)="v^EXISTS:") {
		for ii=5:1:$l(v,"^")-1 d lvtree("v", $p(v,"^",ii))
    	QUIT nn
    }
    #; Default case, recurse through the whole condition.
	d lvtree("l",log)  ;  lfnul sets nn
	#; AK568-
	#; AK481-
	QUIT nn
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
andnn(val,nn) n jj  ;  $$:  return log# of
	#;    "val AND ({nn} IS NOT NULL)" (also works if nn is empty)
	#; AK481
	f jj=1:1:$ll(nn) Set val=$$$newlog("l^&^"_$$addcls($p($$$mtL(val),"^",3),$li(nn,jj,jj))_"^"_$$nncond($li(nn,jj))_"^"_val_"^")
	#; AK481-
	QUIT val
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nncond(val,markNotNull=0)  ;  $$:  for field val, return log# of "val IS NOT NULL"
	#; AK568
	#; JLF051
	Set val=$$$newlog("v^'NULL^"_$s($e($$$mtV(val))="f":","_val_",","xt"[$e($$$mtV(val)):",",1:$p($$$mtV(val),"^",3))_"^"_val_"^")  ;  (putlog resets val!)
	s seldict(val)=1 // PVA186: don't count any selectivity for NULL correctness tests we add
	s mt("nncond",val) = 1
	s:markNotNull mt("logToNotNull",log)=val, mt("NotNullTolog",val)=log
	#; JLF051-
	QUIT val
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK568
lfnul	;  set up nn=$LIST(), called from $$nnlf->lvtree with type,val,v,ev
	#; JLF015
	i "f"=ev QUIT:$$ddreq(val)  QUIT:$$$mtV(val)["%ANYOF"  QUIT:$d($$$mtFilter($p($$$mtV(val),"^",3)))  s:'$lf(nnf_nn,val) nn=nn_$lb(val) QUIT
	#; AK611
	i "v"=ev," NVL COALESCE NULLIF IFNULL DECODE CASE PREDICT PROBABILITY "[(" "_$p(v,"^",2)_" ") s nn=nn_$lb(val) QUIT
	//Ordinary scalar subqueries need "NOT NULL", but SVSO ones have their own handling.
	i "q"=ev s nn=nn_$lb(val) QUIT
	QUIT:$e(v,1,12)="v^LISTBUILD^"  ;  arguments allowed to be NULL, AND result is never NULL	// DPV4307=
	; AK591+
	QUIT:"e"=ev  ;  extrinsic function may return non-NULL value
	QUIT:$e(v,1,22)="v^USERDEFINEDFUNCTION:"  ;  same for method	// See ProdLog 105842.  I think we need to change this ***  (DPV)
	#;  *** but should check return value for NULL without calling again!
	; AK591-
	; JLF051+
	i "x"=ev s:'$lf(nnf_nn,val) nn=nn_$lb(val) QUIT
		#; The following line requires nulstr to be set for all superqueries!
	i "n"=ev { i ($e($$$mtV($p(v,"^",4)))="f")&&($$ddreq($p(v,"^",4))||($$$mtV($p(v,"^",4))["%ANYOF")) { QUIT } s:'$lf(nnf_nn,val) nn=nn_$lb(val) QUIT }
	i v="t^" s nn=nn_$lb(val) QUIT
	; JLF051-
		#; Assume that all aggregates in the HAVING clause are nullable except for count.
	i "a"=ev { s:$p(v,"^",2)'="count" nn=nn_$lb(val) QUIT }	// JLF087=
	; AK672+
	#;  enough to test NOT NULL on one side
	#;  (except if it's using a non-standard NULL-marker)  ;  IBA097
	i "v"=ev,"<^<%'>"[$e(v,3,4) d lvtree("v",$p(v,"^",4)),badnm($p(v,"^",5)) QUIT  // PVA305: <% for %NOINDEX
	i "v"=ev,">^>%'<"[$e(v,3,4) d lvtree("v",$p(v,"^",5)),badnm($p(v,"^",4)) QUIT  // PVA305: >% for %NOINDEX
	i "v^=^"=$e(v,1,4),$g(mt("options","NULLEQUAL")) { RETURN }	// Used in TSQL code generation for ANSI_NULL_OFF mode
	i "v^=^"=$e(v,1,4),$e($$$mtV($p(v,"^",5)))="f" d lvtree("v",$p(v,"^",5)) QUIT
	i "v^=^"=$e(v,1,4) {
		d lvtree("v",$p(v,"^",4))
		if $d(mt("nRTP","SelInfo",val)) {	; YCL472
			new curnn
			set curnn=nn  ; save current nn
			d lvtree("v",$p(v,"^",5)) 
			set nn=$$checkRTPCNN(curnn,nn)
		}
		QUIT
	}
	; AK672-
	GOTO lvarg  ;  recurse down
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  type="v"/"l", generic tree traversal - for each
	#;  node, set v,ev and GOTO @call, which may continue down to lvarg
lvtree(type,val) QUIT:'val  n v,ev,lv s v=mt(type,val),ev=$e(v) GOTO @call
lvarg	;  possibly come back from 'call' to recurse down the subtree
	QUIT:"fxtqn"[ev ; note that lvarg doesn't recurse down on x^NN lateral join variables or n^ correlated fields
	i "vl"[ev f lv=4:1:$l(v,"^")-1 { d lvtree(ev,$p(v,"^",lv)) } QUIT
	i "a"=ev s v=$p(v,"^",6)_$p(v,"^",7)_$p(v,"^",5)_"," f lv=1:1:$l(v,",")-1 { d lvtree("v",$p(v,",",lv)) } QUIT
	i "s"=ev d lvtree("v",$p(v,"^",4)) QUIT  ;  AS alias (obsolete)
	i "e"=ev s v=$p(v,"^",4) f lv=1:1:$l(v,",")-1 { d lvtree("v",$p(v,",",lv)) } QUIT
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
badnm(val)  ;  if val had a non-standard NULL-marker, then must  ;  IBA097
	#;  apply to it the "not NULL" analysis
	new v,irn set v=$$$mtV(val)
	RETURN:($e(v)'="f")||(v["_")
	set irn=$$$smdGetIrnFromIfn($p(v,"^",3))
	RETURN:'irn
	do:$$$smdColUserDefinedNullMarker(1,irn,$p(v,"^",3)) lvtree("v",val)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
listreeqb(qn,lpref)  ;  $$: search all subtrees of query block qn, for all
	#;  nodes that start with any of the prefixes in lpref=$LIST(prefix),
	#;  return them in found=LIST(val#,)
	n found,call s found="",call="lpref^%qaqpnl"
	d lvitersubq(qn)
	QUIT found  ;  return all that were found
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  add val to found=$LIST(val), but only if not already there
#define adnodup s:'$lf(found,val) found=found_$lb(val)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
lpref	;  check for any prefix in lpref, called from listree->lvtree with type,val,v,ev
	i ev="q" { f lv=2:1:$l(v,",")-1 d lvtree("v",$P(v,",",lv)) }  ; correlated fields
	f lv=1:1:$ll(lpref) s lv(1)=$li(lpref,lv) i lv(1)=$e(v,1,$l(lv(1))) { $$$adnodup QUIT }
	i ev="x",$p(v,"^",2),$lf(lpref,"n") { $$$adnodup }
	GOTO lvarg  ;  recurse down
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; lvtree-based "whole subquery" scan. Given a subq #, lvtree over entire "root set" 
lvitersubq(qn) [ mt ] public {
	QUIT:'qn
	//TOP
	Do lvtree("v",$g($$$mtTopArg(qn)))
	//OFFSET
	Do lvtree("v",$g($$$mtOffset(qn)))
	//SELECT
	For i=1:1 {
		Set v = $p($$$mtOutputVals($g($$$mtOutput(qn))),",",i) QUIT:'v
		Do lvtree("v",v)
	}
	//OUTER JOIN (note this must be post ON/linx transformation)
	For i=1:1 {
		Set l = $p($g($$$mtLeftOuterJoins(qn)),",",i) QUIT:'l
		Do lvtree("l",l)
	}
	//WHERE
	For i=1:1 {
		Set l = $p($g($$$mtWhere(qn)),"^",i) QUIT:'l
		Do lvtree("l",l)
	}
	//HAVING
	Do lvtree("l",$g($$$mtHaving(qn)))
	//GROUP BY
	For i=1:1 {
		Set v = $p($g($$$mtGroupDistinctList(qn)),",",i) QUIT:'v
		Do lvtree("v",v)
	}
	//ORDER BY
	For i=1:1 {
		Set v = +$p($g($$$mtSequencersQb(qn)),",",i) QUIT:'v
		Do lvtree("v",v)
	}
	//UNION
	For i=1:1 {
		Set uqn = +$lg($g($$$mtUnion(qn)),i) QUIT:'uqn
		Do lvtree("v",$$$mtPQbVal($$$mtP(uqn)))
	}
}
 //Queue a type/value pair into the LIFO lviterQ.
 //(Could offer clients FIFO queues someday, but LIFO matches the original
 //lvtree behavior.)
#define lviterQ(%type,%val) Set:%val lviterQ($increment(lviterQ))=$listbuild(%type,%val)
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  type="v"/"l", generic tree traversal - for each
	#;  node, set v,ev and GOTO @call, which may continue down to lviterarg
lviter(type,val)
	//Always ignore empty or 0 vals so client doesn't need to check
	QUIT:'val
	//Create a new queue in this scope
	New lviterQ,v,ev,lv,ascend
	//Queue the passed value
	$$$lviterQ(type,val)
	 //Process each entry in the current lviterQ until it is empty. 
	While $g(lviterQ)>0 {
		//Return a type/value pair by reference, removing it from lviterQ 
		Set $lb(type,val)=lviterQ(lviterQ) Kill lviterQ(lviterQ) Set lviterQ=lviterQ-1
		#; Support calling nodes while descending through tree rather than ascending as we normally do
		If $e(val)="-" {
			Set val=$e(val,2,*),ascend=0
		} Else {
			Set ascend=1
		}
		Set v=mt(type,val),ev=$e(v)
		//We need a scope wrapper for the call, so when it QUITs (either directly
		//or after GOTO-ing lvarg, we can return to lviterS to keep processing
		//the queue.
		Do
		. GOTO @call
	}
	QUIT
.
#; Push a node onto lviterQ tree called during tree descent
#; Logic called by 'GOTO @call' above can push this special node, then 'GOTO lviterarg' to push descendents onto queue
#; When we finish processing descendents we will get this special node which sets 'ascend=1' and calls @call again
#; so logic in here can run the descending part of its work
lviterpushdesc(type,val) [lviterQ] public {
	$$$lviterQ(type,"-"_val)
}
.
lviterqueue(type, val)
	$$$lviterQ(type,val)	
 //Clients should "GOTO lviterarg" to continue recursing down into the curren value. 
lviterarg	
	QUIT:"fxtqn"[ev
	New lv,val
	//Note that all iterations over lists are reversed to match original depth-first lvtree recursion
	if "vl"[ev {
		for lv=$l(v,"^")-1:-1:4 {
			set val=$p(v,"^",lv)
			$$$lviterQ(ev,val)
		}
	} elseif "a"=ev {
		set v=$p(v,"^",6)_$p(v,"^",7)_$p(v,"^",5)_","
		for lv=$l(v,",")-1:-1:1 {
			set val=$p(v,",",lv)
			$$$lviterQ("v",val)
		}
	} elseif "s"=ev {
		$$$lviterQ("v",$p(v,"^",4))  ;  AS alias (obsolete)
	} elseif "e"=ev {
		s v=$p(v,"^",4)
		f lv=$l(v,",")-1:-1:1 {
			set val=$p(v,",",lv)
			$$$lviterQ("v",val)
		}
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
lvqbmod(qn,dounion=0,dofrom=0) n lv,str,sublist  ;  iterate over all  ;  AK850
	#;  contents of queryblock qn, and call lvtreemod^%qaqpnl to modify references therein
	#;  for UNION top, descend into all UNION legs if dounion=1
	#;  *** descend into all FROM views/subqueries if dofrom=1 (unimplemented)
	//Search SELECT list
	#;  if it's a view, also modify mt("virf",vifn), using ml=%VID.ifn
	s sublist=$$$mtOutputVals($g($$$mtOutput(qn))),ml=$p($g($$$mtV(+$$$mtPViewIDVal($$$mtP(qn)))),"^",3)
	For lv=1:1:$l(sublist,",")-1 s $p(sublist,",",lv)=$$lvtreemod^%qaqpnl("v",$p(sublist,",",lv)) s:ml $li($$$mtVirf(ml+lv),2)=$p(sublist,",",lv)
	s:sublist'="" $$$mtOutputVals($$$mtOutput(qn))=sublist
	//Search TOP value (probably uninteresting in 99% of cases)
	If $g($$$mtTopArg(qn)) s $$$mtTopArg(qn)=$$lvtreemod^%qaqpnl("v",$$$mtTopArg(qn))
	//Search OFFSET value
	If $g($$$mtOffset(qn)) s $$$mtOffset(qn)=$$lvtreemod^%qaqpnl("v",$$$mtOffset(qn))
	//Search LEFT JOIN conditions
	For lv=1:1:$l($g($$$mtLeftOuterJoins(qn)),",")-1 s $p($$$mtLeftOuterJoins(qn),",",lv)=$$lvtreemod^%qaqpnl("l",$p($$$mtLeftOuterJoins(qn),",",lv))
	//Search WHERE clause
	For lv=1:1:$l($g($$$mtWhere(qn)),"^")-1 s $p($$$mtWhere(qn),"^",lv)=$$lvtreemod^%qaqpnl("l",$p($$$mtWhere(qn),"^",lv))
	//Seach mt("c") constant conditions
	For lv=1:1:$l($g($$$mtStreamlessConds(qn)),",")-1 s $p($$$mtStreamlessConds(qn),",",lv)=$$lvtreemod^%qaqpnl("l",$p($$$mtStreamlessConds(qn),",",lv))
	//Search %PARTITION BY clause
	For lv=1:1:$l($g($$$mtPartitionPredicates(qn)),"^")-1 s $p($$$mtPartitionPredicates(qn),"^",lv)=$$lvtreemod^%qaqpnl("l",$p($$$mtPartitionPredicates(qn),"^",lv))
	//Search GROUP BY clause
	For lv=1:1:$l($g($$$mtGroupDistinctList(qn)),",")-1 s $p($$$mtGroupDistinctList(qn),",",lv)=$$lvtreemod^%qaqpnl("v",$p($$$mtGroupDistinctList(qn),",",lv))
	//Search HAVING clause
	If $g($$$mtHaving(qn)) s $$$mtHaving(qn)=$$lvtreemod^%qaqpnl("l",$$$mtHaving(qn))
	//Search ORDER BY clause
	For lv=1:1:$l($g($$$mtSequencersQb(qn)),",")-1 s $p($$$mtSequencersQb(qn),",",lv)=$$lvtreemod^%qaqpnl("v",+$p($$$mtSequencersQb(qn),",",lv))_$e("d",$p($$$mtSequencersQb(qn),",",lv)["d")
	//Search TVF arguments in the FROM clause
	s str="" f  {
		s str=$o($$$mtTvfParams(str),1,sublist)
		QUIT:str=""
		CONTINUE:$$$mtRQb($$$mtR(str))'=qn
		CONTINUE:sublist=$c(0)
		f lv=1:1:$ll(sublist) s:$ld(sublist,lv) $li($$$mtTvfParams(str),lv)=$$lvtreemod^%qaqpnl("v",$li(sublist,lv))
		// may also need to update corresponding mt("tvf","label",ml) - DAB036
	}
	//If this is a query we've avoided LOJ transforming to facilitate regeneration (shard, parallel, etc.)
	//we need to check mt("ON")
	Set ml = ""
	For  {
		Set ml = $o($$$mtOn(qn, ml),1,sublist) QUIT:ml=""
		Set sublist = $li(sublist,2)
		For lv=1:1:$l(sublist,"^")-1 {
			s $p(sublist,"^",lv)=$$lvtreemod^%qaqpnl("l",$p(sublist,"^",lv))
		}
		s $li($$$mtOn(qn, ml),2)=sublist
	}
	//Descend through union legs
	If dounion,$g($$$mtUnionTopQb(qn)) = qn {
		Set ml = ""
		For  {
			Set ml = $o($$$mtUnionTopQb(ml)) QUIT:ml=""
			CONTINUE:ml=qn
			CONTINUE:$$$mtUnionTopQb(ml)'=qn
			Do lvqbmod(ml)
		}
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA057
	#;  allow in place modification and re-wiring of a parse tree
lvtreemod(type,val) n v,ev,lv,wv  ;  type="v"/"l", generic tree traversal - for each
	#;  node, set v,ev and GOTO @call, which may continue down to lvarg
	#;  This differs from lvtree in that the callback can modify val,type,v,ev and the tree is modified
	#;     as it is traversed. lvtreemod returns a val which may sometimes be different from the
	#;     input val. 
	QUIT:'val val  ;  just in case
	s v=mt(type,val),ev=$e(v) GOTO @call
lvargm	;  possibly come back from 'call' to recurse down the subtree
	QUIT:"fxtq"[ev val //PVA226: needs to go into 'n' node to allow it to be changed to match
	                   #; to the fifth piece of FOR SOME node
	if ev="n" s $p(mt(type,val),"^",4)=$$lvtreemod^%qaqpnl("v",$p(v,"^",4)) QUIT val
	i "vl"[ev f lv=4:1:$l(v,"^")-1 { s $p(mt(type,val),"^",lv)=$$lvtreemod(ev,$p(v,"^",lv)) } QUIT val
	i "a"=ev {
		s wv=$p(v,"^",6)  f lv=1:1:$l(wv,",")-1 { s $p(wv,",",lv)=$$lvtreemod("v",$p(wv,",",lv))}
		s $p(v,"^",6)=wv
		s wv=$p(v,"^",7)  f lv=1:1:$l(wv,",")-1 { s $p(wv,",",lv)=$$lvtreemod("v",$p(wv,",",lv))}
		s $p(v,"^",7)=wv
		s $p(v,"^",5)=$$lvtreemod("v",$p(v,"^",5))
		s mt(type,val)=v
		QUIT val
	}
	i "s"=ev s $p(mt(type,val),"^",4)=$$lvtreemod("v",$p(v,"^",4)) QUIT val  ;  AS alias (obsolete)
	i "e"=ev s v=$p(v,"^",4) f lv=1:1:$l(v,",")-1 { s $p(v,",",lv)=$$lvtreemod("v",$p(v,",",lv)) } s $p(mt(type,val),"^",4)=v QUIT val
	QUIT val
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA057-
	 #;  $$:  convert comma-list cls to $LIST
cls2ls(cls) [] PUBLIC { QUIT:cls="" "" s ls="" f jj=2:1:$l(cls,",")-1 { s ls=ls_$lb($p(cls,",",jj)) } QUIT ls }
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK568-
	#; AK591
nopad	;  set up nopad, called from $$conds->lvtree with type,val,v,ev
	#;  for type="l", check whether padding a stream forces val to be FALSE
	#;  for type="v", check whether padding a stream forces val to be NULL
	i "f"=ev s:'$p(nopad,",",$p(v,"^",2)) $p(nopad,",",$p(v,"^",2))=1 QUIT  ;  cancel outer-join for this field's stream
	QUIT:"e"=ev  ;  extrinsic function may return non-NULL value
	QUIT:$E(v,1,22)="v^USERDEFINEDFUNCTION:"  ;  same for method
	QUIT:" NVL COALESCE NULLIF IFNULL DECODE CASE "[(" "_$p(v,"^",2)_" ")
	i $E(v,1,4)="l^!^" {
		n nold,nleft,nrite,jj
		s nold=nopad,nopad="" d lvtree("l",$p(v,"^",4))
		s nleft=nopad,nopad="" d lvtree("l",$p(v,"^",5))
		s nrite=nopad,nopad=nold
		f jj=1:1:$l(nleft,",") i $p(nleft,",",jj),$p(nrite,",",jj) s $p(nopad,",",jj)=1
		QUIT }
	#; If this predicate cannot pass a NULL then recurse else QUIT
	#; PVA305: this should have checked for %noindex per PVA242
	QUIT:type="l"&&(" & 'NULL = '= > '> < '< %MATCHES %PATTERN %STARTSWITH [ '[ IN FOR_SOME_%ELEMENT INSET "'[(" "_$tr($p($p(v,"^",2),"%NOINDEX")," ","_")_" "))	// DPV3541 (%MATCHES)
	#; PVA215: recurse only for left side of %startswith
	#; PVA287: same for IN
	#; PVA301: check for type="l" to exclude literals
	#; PVA305: this should have checked for %noindex per PVA242; also add missing parens
	if type="l" && (" %STARTSWITH IN INSET "[(" "_$p($p(v,"^",2),"%NOINDEX")_" ")){s val=$p(v,"^",4),type="v",v=mt(type,val),ev=$e(v) GOTO nopad}
	GOTO lvarg  ;  recurse down
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK591-
	#; AK481
addcls(cls,ls) n jj  ;  $$:  return comma-list cls with fields from ls added
	#; AK568
	#;  but if an ls item is a function, use its field list
	f jj=$ll(ls):-1:1 s:$e($$$mtV($li(ls,jj)))'="f" $li(ls,jj,jj)=$$cls2ls($p($$$mtV($li(ls,jj)),"^",3))
	#; AK568-
	f jj=1:1:$ll(ls) s:cls'[(","_$li(ls,jj)_",") cls=cls_$li(ls,jj)_","
	QUIT cls
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK481-
	#;  $$:  return union of two $list()
unls(ls1,ls2) [] PUBLIC { f jj=$ll(ls1):-1:1 { s:'$lf(ls2,$li(ls1,jj)) ls2=$li(ls1,jj,jj)_ls2 } QUIT ls2 }
	#;  $$:  return intersection of two $list()
intls(ls1,ls2) [] PUBLIC { f jj=$ll(ls1):-1:1 { s:'$lf(ls2,$li(ls1,jj)) $li(ls1,jj,jj)="" } QUIT ls1 }
	#;  $$:  return set difference (ls1\ls2) of two $list()
diffls(ls1,ls2) [] PUBLIC { f jj=$ll(ls1):-1:1 { s:$lf(ls2,$li(ls1,jj)) $li(ls1,jj,jj)="" } QUIT ls1 }
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddreq(v) s v=$$$mtV(v)  ;  $$:  return whether field v is required
	#; AK425
	QUIT:$lf(nulstr,$p(v,"^",2)) 0  ;  if OJ, may be NULL even if required
	#; AK446
	#; JLF002
	QUIT:$g($$$mtRVirtual($p(v,"^",2)))&&(v=$$$mtV($$$mtPViewIDVal($$$mtP($$$mtRVirtual($p(v,"^",2)))))) 1
	QUIT:$g($$$mtRVirtual($p(v,"^",2))) 0  ;  virtual stream *** maybe find better values?
	#; JLF002-
	#; AK481
	#;  if collated, use uncollated ifn
	QUIT $$$smdColRequired(1,+$$$mtR($p(v,"^",2)),+$p(v,"^",3))="Y"
	#; AK481-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK407-
	#; AK627
findtree(type,val,evlist)  ;  search subtree of val for nodes of type evlist
	n found,call s found=0,call="evfind"
	do lvtree(type,val)
	QUIT found  ;  return any one found
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
evfind	;  check for 'evlist', called from findtree->lvtree with type,val,v,ev
	#; AK692
	i ev="x",$p(v,"^",2),evlist["n" s found=val  ;  treat JSV fake x^NN as "correlated"
	s:evlist[ev found=val  ;  entry found - set its val in 'found'
	GOTO:'found lvarg  ;  recurse down
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK627-
outer	;  treat (candidate for) outer-join condition
	s ptlg=$$$mtL(log),con=$p(ptlg,"^",5),str=$p($$$mtV(con),"^",2),m=$$$mtRQb($$$mtR(str))
		#; PVA087: get rid of killing outer joins here; done earlier
	s $$$mtLeftOuterJoins(m)=$g($$$mtLeftOuterJoins(m))_log_",",$p(ptl,"^",log)="o",val=$p(ptlg,"^",4)
	#; AK380
	i $$$mtVType($$$mtV(val))'="f",'$d(ptv(val)) s ptv(val)=val_"^e^^^^"_val_",^"_m
	d aptv(con,$$$PTVLOGREFS,log_","),aptv(val,$$$PTVLOGREFS,log_","),aptv(val,$$$PTVOJSTR,str_",")
	#; AK315
	#;  maintain list of conditions that outer-join into this stream
	s $$$mtROuterJoins(str)=$g($$$mtROuterJoins(str))_log_","
	#; AK315-
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; For DSN queries, we want to use mt("ON") directly, so we'll integrate implicit joins into it.
mergeOldAndNewJoins(qn,phase) [ log, mt, linx ] PUBLIC {
	//First, let's decide on a strategy by figuring out which kind of joins we have.
	New log	// Be careful here, log was PRIVATE here, but when we call outer, log is PUBLIC, so made it PUBLIC here too.
	Set hasON = $d($$$mtOnRoot(qn))
	If 'hasON {
		//No need to worry about ON regeneration, use linx list to create mt("j") outer joins for =* -> etc.
		//Preexisting regeneration code can handle these.
		//We do this in both phases, because undoSideEffects kills mt("j")
		f lx=1:1 s log=$p(linx,"^",lx) q:'log  d:qn=$$$mtRQb($$$mtR($p($$$mtV($$$mtLOperand2($$$mtL(log))),"^",2))) outer
		QUIT
	}
	Set arrowJoins = $$arrowJoins(qn)
	Set starJoins = $$starJoins(qn, arrowJoins)
	//We won't try to support mixing outer join =* conditions with "ON" clause LOJ in Gateway queries. Convert them all to WHERE clauses.
	Do convertJoinsToWhere(qn, starJoins)
	Do mergeArrowJoins(qn, arrowJoins)
}
.
shardLinxToOn(qn) [ mt, linx ] PUBLIC {
	If '$d(mt("shtop")),'$g(mt("options","source-tsql")) RETURN
	Set hasON = $d($$$mtOnRoot(qn))
	Do nestedLinx(qn)
	Set arrowJoins = $$arrowJoins(qn)
	Set starJoins = $$starJoins(qn, arrowJoins)
	If hasON,$ll(starJoins) Do unsupportedForShard^%qaqpagg("mixed join syntax")
	Do mergeLinx(qn, starJoins_arrowJoins)
}
.
#; As far as we can tell from experimenting with ASA's "Rewrite" command, T-SQL moves an entire
#; top level AND condition from WHERE to an ON clause if it contains an =* / *= condition.
#; This function simulates that behavior in our QP by moving such a top level condition into
#; linx. This breaks the contract of "linx", but only very briefly, as this is in service
#; of immediately moving conditions from linx into mt("ON") the logic for which is in mergeLinx
nestedLinx(qn) [ mt, linx, nestlinx ] PUBLIC {
	If '$g(mt("options","source-tsql")) RETURN
	Set w = $g($$$mtWhere(qn))
	Set w2 = ""
	For i=1:1:$l(w,"^")-1 {
		Set log = $p(w,"^",i)
		Set legacy = $$legacyConds(log)
		//If any legacy joins found, move to linx,
		//otherwise, keep in WHERE
		If '$ll(legacy) {
			Set w2 = w2_log_"^"
			CONTINUE
		}
		Set linx = linx_log_"^"
		//Convert =* to = now that they're in linx
		For j=1:1:$ll(legacy) {
			Set $$$mtLOperator($$$mtL($li(legacy,j)))="="
			//More than one per top level AND = undefined behavior!!
			Set nestlinx(log) = $li(legacy,j)
		}
	}
	Kill $$$mtWhere(qn)
	If w2 Set $$$mtWhere(qn) = w2
}
.
legacyConds(log) [ call, legacyConds ] PUBLIC {
	New call, legacyConds
	Set call = "legacyCondsLV^%qaqpnl"
	Set legacyConds = ""
	Do lviter("l",log)
	RETURN legacyConds
}
.
legacyCondsLV
	If ev="v",$p(v,"^",2)="=*" Set legacyConds = legacyConds_$lb(val)
	GOTO lviterarg
.
mergeLinx(qn, joins) [ mt, nestlinx ] PUBLIC {
	//Build partial order function, rhs => condition map
	Set streams = ""
	For i=1:1:$ll(joins) {
		Set cond = $li(joins, i)
		If $d(nestlinx(cond),nestlog) {
			Set join = $$$mtL(nestlog)
		}
		Else {
			Set join = $$$mtL(cond)
		}
		Set lhs = $$toAlias($P(join, "^", 4))
		Set rhs = $$toAlias($P(join, "^", 5))
		Set joinary(lhs,rhs,cond)=""
		If '$lf(streams, lhs) Set streams = streams _ $lb(lhs)
		If '$lf(streams, rhs) Set streams = streams _ $lb(rhs)
		Set lhscond(lhs,cond)=rhs
		Set rhscond(rhs,cond)=lhs	
	}
	Set ord = ""
	//Build stream order
	For i=1:1:$ll(streams) {
		Set stream = $li(streams,i)
		Set target = $ll(ord) + 1
		For j=1:1:$ll(ord) {
			Set group = $li(ord,j)
			Set greater = $$partialGreater(.joinary, group, stream)
			Set lesser = $$partialLesser(.joinary, group, stream)
			Set incomp = $$partialIncomp(.joinary, group, stream)
			If $ll(greater_lesser)=0,j<target Set target = j CONTINUE
			If $ll(greater),$ll(lesser) Set target = -j QUIT
			If $ll(greater) Set target = j+1 CONTINUE
			If $ll(lesser),j=1 Set target = -1 CONTINUE
			If $ll(lesser),(j-1)<target Set target = j-1 CONTINUE
		}
		If target<0 {
			Set target = -target
			Set group = $li(ord,target)
			Set greater = $$partialGreater(.joinary, group, stream)
			Set lesser = $$partialLesser(.joinary, group, stream)
			Set incomp = $$partialIncomp(.joinary, group, stream)
			Set ord = $li(ord,1,target-1) _ $s(greater="":"",1:$lb(greater)) _ $lb(incomp_$lb(stream)) _ $s(lesser="":"",1:$lb(lesser)) _ $li(ord,target+1,*) CONTINUE
		}
		If target=0 Set ord = $lb($lb(stream))_ord CONTINUE
		Set $li(ord,target) = $lg(ord,target)_$lb(stream)
	}
	//Migrate streams up as far as possible
	Set updated=1
	While updated,$ll(ord)>1 {
		Set updated = 0
		For i=$ll(ord):-1:2 {
			Set group = $li(ord,i)
			Set upgroup = $li(ord,i-1)
			For j=1:1:$ll(group) {
				Set stream = $li(group,j)
				Set incomp = $$partialIncomp(.joinary, upgroup, stream)
				If $ll(incomp) = $ll(upgroup) {
					Set $li(ord,i-1) = $li(ord,i-1) _ $lb(stream)
					Set $li(ord,i) = $li($li(ord,i),1,j-1)_$li($li(ord,i),j+1,*)
					If $li(ord,i) = "" Set ord = $li(ord,1,i-1)_$li(ord,i+1,*)
					Set updated = 1 QUIT
				}
			}
			If updated = 1 QUIT
		}
	}
	Set ons = ""
	For i=1:1:$ll(ord) {
		Set group = $li(ord,i)
		For j=1:1:$ll(group) {
			Set lhs = $li(group,j)
			Set cond = ""
			For  {
				Set cond = $o(lhscond(lhs,cond),1,rhs) QUIT:cond=""
				Do removeFromLinx(cond)
				#; this is only for T-SQL, see nestedLinx
				Set extendedLhs = $$extendedLhs(cond,rhs)
				Set found = 0,merged = 0
				//CASE 1: No matching LHS or RHS, create a new ON
				For k=1:1:$ll(ons) {
					Set on = $li(ons,k)
					If $lf($li(on,3)_$li(on,4),lhs)||$lf($li(on,3)_$li(on,4),rhs) Set found = 1 QUIT	
				}
				If 'found {
					Set impliedConds = $$impliedOn(qn,cond,$lb(lhs),$lb(rhs))
					Do incorporateStreams(.onstreams,extendedLhs_$lb(rhs))
					Set ons = ons _ $lb($lb("LEFT",impliedConds,extendedLhs,$lb(rhs)))
					Set merged = 1
				}
				CONTINUE:merged
				//CASE 2: Matching LHS & RHS, add condition
				For k=1:1:$ll(ons) {
					Set on = $li(ons,k)
					If $lf($li(on,3),lhs),$lf($li(on,4),rhs) {
						Set impliedConds = $$impliedOn(qn,cond,$li(on,3),$li(on,4))
						Set $li(on,2) = $li(on,2)_impliedConds
						For x=1:1:$ll(extendedLhs) {
							Set xlhs = $li(extendedLhs,x)
							If '$lf($li(on,3),xlhs) {
								Set $li(on,3) = $li(on,3) _ $lb(xlhs)
								Do incorporateStreams(.onstreams,$lb(xlhs))
							}
						}
						Set $li(ons,k) = on
						Set merged=1
						QUIT
					}
				}
				CONTINUE:merged
				//CASE 3: LHS, RHS in separate trees, merge
				//TODO: remove redundancy with CASE 4
				Set lhsOnK = ""
				For k=$ll(ons):-1:1 {
					Set on = $li(ons,k)
					If $lf($li(on,3),lhs)||$lf($li(on,4),lhs) {
						Set lhsOnK = k
						QUIT
					}
				}
				Set rhsOnK = ""
				For k=$ll(ons):-1:1 {
					Set on = $li(ons,k)
					If $lf($li(on,3),rhs)||$lf($li(on,4),rhs) {
						Set rhsOnK = k
						QUIT
					}
				}
				If lhsOnK'="",rhsOnK'="" {
					Set lhsOn = $li(ons, lhsOnK)
					Set rhsOn = $li(ons, rhsOnK)
					//The first implementation of this change built an ON clause linking the LHS ON to
					//the LHS of the RHS ON with a 1=1 condition (this is T-SQL semantics, see PL 160416)
					//This would be necessary for Sybase ASE, which doesn't support CROSS JOIN, but
					//our ON clause encoding allows newly joined streams to show up on both the right and the
					//left, treating the relationship with any existing streams on that "side" as CROSS JOIN
					//
					//Now extend the LHS of the RHS ON and add the condition(s)
					Set $li(rhsOn,3) = $li(lhsOn,3)_$li(lhsOn,4)_$li(rhsOn,3)
					Set extendedLhs = $$extendedLhs(cond, rhs)
					For x=1:1:$ll(extendedLhs) {
						Set xlhs = $li(extendedLhs,x)
						If '$lf($li(rhsOn,3),xlhs) {
							Set $li(rhsOn,3) = $li(rhsOn,3) _ $lb(xlhs)
							Do incorporateStreams(.onstreams,$lb(xlhs))
						}
					}				
					Set impliedConds = $$impliedOn(qn,cond,$li(rhsOn,3),$li(rhsOn,4))
					Set $li(rhsOn,2) = $li(rhsOn,2)_impliedConds
					Set ons = $li(ons,1,rhsOnK-1)_$li(ons,rhsOnK+1,*)
					Set ons = ons _ $lb(rhsOn)
					Set merged = 1
					QUIT
				}
				//CASE 4: Extend last join chain w/new RHS
				Set newlhs = extendedLhs
				Set newrhs = $lb(rhs)
				For k=$ll(ons):-1:1 {
					Set on = $li(ons,k)
					If $lf($li(on,3),lhs)||$lf($li(on,4),lhs) {
						Set newlhs = $li(on,3)_$li(on,4)
						Do incorporateStreams(.onstreams,newrhs)
						QUIT
					}
				}
				For k=$ll(ons):-1:1 {
					Set on = $li(ons,k)
					If $lf($li(on,3),rhs)||$lf($li(on,4),rhs) {
						Set newrhs = $li(on,3)_$li(on,4)
						Do incorporateStreams(.onstreams,newlhs)
						QUIT
					}
				}
				Set impliedConds = $$impliedOn(qn,cond,newlhs,newrhs)
				Set ons = ons _ $lb($lb("LEFT",impliedConds,newlhs,newrhs))
				Set merged = 1
			}
		}	
	}
	For i=1:1:$ll(ons) {
		Set $$$mtOn(qn,$i($$$mtOnCount)) = $li(ons,i)
	}
}
.
#; Track streams as they're incorporated into the ON clause, throw
#; an error if a stream is added more than once (rather than nested
#; in a new ON clause)
incorporateStreams(onstreams, streams) PUBLIC {
	For i=1:1:$ll(streams) {
		If $d(onstreams($li(streams,i))) Do error(94)
		Set onstreams($li(streams,i))=""
	}
}
.
#; See nestedLinx: Because T-SQL allows an =* condition to be arbitrarily nested
#; in another condition, that condition may have streams other than the LHS which
#; need to be CROSS JOIN'd in order to migrate this condition into an ON clause.
#; We assume all such streams that are not the RHS stream of the =* condition should be
#; CROSS JOIN'd
extendedLhs(cond, rhs) PUBLIC {
	//All the streams in the cond, minus the rhs
	Set streams = $$deriveStreams^%qaqpqo("l",cond)
	Set extendedLhs = ""
	For i=1:1:$ll(streams) {
		Set lhs = $$strtoname^%qaqpre2($li(streams,i))
		If lhs = rhs CONTINUE
		Set extendedLhs = extendedLhs _ $lb(lhs)
	}
	RETURN extendedLhs
}
partialGreater(ary,group,val) PUBLIC {
	Set greater = ""
	For i=1:1:$ll(group) {
		Set item = $li(group,i)
		If $d(ary(item,val)) Set greater = greater _ $lb(item)
	}
	RETURN greater
}
.
partialLesser(ary,group,val) PUBLIC {
	Set lesser = ""
	For i=1:1:$ll(group) {
		Set item = $li(group,i)
		If $d(ary(val,item)) Set lesser = lesser _ $lb(item)
	}
	RETURN lesser
}
.
partialIncomp(ary,group,val) PUBLIC {
	Set incomp = ""
	For i=1:1:$ll(group) {
		Set item = $li(group,i)
		If '$d(ary(val,item)),'$d(ary(item,val)) Set incomp = incomp _ $lb(item)
	}
	RETURN incomp
}
#; TSQL (at least of the Sybase variety) has different legacy join (=* / *=) semantics than ISC products
#; Notably in this case, WHERE clause conditions on the RHS of a legacy left outer join triggered by
#; a legacy =* condition (*= in TSQL, where they flip the *) are treated as additional ON clauses.
#; This is in contrast to our semantics, where these WHERE clauses can (if not "outer" conditions using
#; "post padding" operators) cancel the outer join into an inner join.
impliedOn(qn,cond,lhs,rhs) [ mt ] PUBLIC {
	If '$g(mt("options","source-tsql")) RETURN cond_"^"
	Set conds = cond_"^"
	For i=1:1:$l($g($$$mtWhere(qn)),"^")-1 {
		Set l = $p($$$mtWhere(qn),"^",i)
		Set streams = $$deriveStreams^%qaqpqo("l",l)
		Set foundrhs = 0
		For j=1:1:$ll(streams) {
			Set alias = $$strtoname^%qaqpre2($li(streams,j))
			If $lf(rhs, alias) Set foundrhs = 1 QUIT
		}
		Set foundall = 1
		for j=1:1:$ll(streams) {
			Set alias = $$strtoname^%qaqpre2($li(streams,j))
			If '$lf(lhs_rhs,alias) Set foundall = 0 QUIT
		}
		If foundrhs,foundall Set conds = conds _ l _"^"
	}
	Set logs = ""
	Set lconds = "^"_conds
	For i=1:1:$l($g($$$mtWhere(qn)),"^")-1 {
		Set l = $p($$$mtWhere(qn),"^",i)
		If '$find(lconds,"^"_l_"^") Set logs = logs _ l _"^"
	}
	Kill $$$mtWhere(qn)
	If $l(logs) Set $$$mtWhere(qn)=logs
	RETURN conds
}
.
mergeArrowJoins(qn, joins) PUBLIC {
	For i=1:1:$LL(joins) {
		Set join = $LI(joins, i)
		Do mergeArrowJoin(qn, join)
	}
}
mergeArrowJoin(qn, join) [ mt ] PUBLIC {
	Set cond = $$$mtL(join)
	Set lhs = $$toAlias($P(cond, "^", 4))
	Set rhs = $$toAlias($P(cond, "^", 5))
	Set merged = 0
	Set n = ""
	For {
		//Go backward to find the highest scope node
		Set n = $O($$$mtOn(qn, n),-1,on) QUIT:n=""
		Set onLhs = $LI(on,3)
		Set onRhs = $LI(on,4)
		//If this is already an existing join, add the condition
		If $LF(onLhs,lhs) && $LF(onRhs,rhs) {
			Set $li(on,2) = $li(on,2)_join_"^"
			Set $$$mtOn(qn, n) = on
			Set merged = 1 QUIT
		}
		//Look for the arrow join lhs
		If $LF(onLhs,lhs) || $LF(onRhs,lhs) {
			//If found, add a higher scope LOJ for this condition
			Set newOn = $LB("LEFT",join_"^", onLhs_onRhs, $LB(rhs))
			Set $$$mtOn(qn,$INCREMENT($$$mtOnCount)) = newOn
			Set merged = 1 QUIT
		}
	}
	//If we couldn't merge it, add a new top level chain
	If 'merged {
		Set newOn = $LB("LEFT", join_"^", $LB(lhs), $LB(rhs))
		Set $$$mtOn(qn,$INCREMENT($$$mtOnCount)) = newOn
	}
	Do removeFromLinx(join)
}
convertJoinsToWhere(qn, joins) [ mt ] PUBLIC {
	For i=1:1:$LL(joins) {
		Set join = $LI(joins, i)
		Set $$$mtWhere(qn) = $G($$$mtWhere(qn)) _ join _ "^"
		Do removeFromLinx(join)
	}
}
removeFromLinx(log) [ linx,mt,impjns ] PUBLIC {
	For i=1:1 {
		Set link = $p(linx,"^",i) QUIT:link=""
		If link = log {
			Set linx = $p(linx,"^",1,i-1)_$s(i'=1:"^",1:"")_$p(linx,"^",i+1,*) QUIT
		}
	}
	#;  also remove from impjns(), o/w mergeArrowJoin() might add it again
	KILL impjns($$$mtLOperand1($$$mtL(log)),$$$mtLOperand2($$$mtL(log)))  ;  ,impjns($$$mtLOperand2($$$mtL(log)),$$$mtLOperand1($$$mtL(log)))
}
starJoins(qn, arrowJoins) [ linx, mt ] PUBLIC {
	Set joins = ""
	For i=1:1 {
		Set join = $P(linx,"^",i) QUIT:join=""
		Set stream = $lg($$deriveStreams^%qaqpqo("l", join))
		Set joinSubq = $$$mtRQb($$$mtR(stream))
		CONTINUE:joinSubq'=qn
		If '$LF(arrowJoins, join) Set joins = joins _ $LB(join)
	}
	QUIT joins
}
arrowJoins(qn) [ impjns ] PUBLIC {
	Set joins = ""
	Set x = ""
	For {
		Set x = $O(impjns(x)) QUIT:x=""
		Set y = ""
		For {
			Set y = $O(impjns(x,y), 1, v) QUIT:y=""
			If $P(v,",",2) = qn Set joins = joins _ $LB($P(v,",",1))
		}
	}
	QUIT joins
}
.
toAlias(v) [ mt ] PUBLIC {
	Set str = $$deriveStream^%qaqpqo(v)
	QUIT $$strtoname^%qaqpre2(str)
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; Purpose:
	#;		To construct equivalence classes of equality conditions, and to identify the dominant
	#;		restricting condition with each equivalance class so that the equivalance class can be 
	#;		evaluated most efficiently.  ptl is assigned a preliminary classification for each log, 
	#;		which will later be used in the assignment of the mts condition type.
	#;		For example, fld=expr becomes an "x" in	ptl, which becomes a CON codition in mts, or 
	#;		a.fld = b.fld becomes a "j" in ptl, becomes a JOIN in mts, and so on.
	#;  	The mts type of the condition is not fully known until after the equivalence
	#;		class analysis is complete, since this depends on the dominant condition of each 
	#;		equivalence class.
	#;
	#;		Also, set the $$$PTVLOGREFS entry in ptv for the fields of this log to associate a 
	#;		val with the logs it appears in.
	#;		
	#; PVA021: conds now has a function return
conds() ; return 1 if conflicting predicates found, else 0
	#;PVA021:
	#; IMPORTANT: Logic here should be kept in synch with clasfycond tag for what can go in a CON mts entry.
	s ptlg=$$$mtL(log),op=$p(ptlg,"^",2),vals=$p(ptlg,"^",3)
	#; PVA021: conds now has a function return
	i vals="," s $$$mtStreamlessConds(m)=$g($$$mtStreamlessConds(m))_log_",",$p(ptl,"^",log)="s" QUIT 0 ; streamless
	f pi=2:1 s val=$p(vals,",",pi) q:val=""  d aptv(val,$$$PTVLOGREFS,log_",")
	GOTO:op="NULL" null
	#; PVA087: remove nopad usage. This now done earlier.
	s $p(ptl,"^",log)="m"
	#; PVA021: conds now has a function return
	QUIT:op="'" 0
	#; PVA021: 
	#; analyze OR conditions whose leaves are field=, field null, or IN tests; ranges if ANDed with these.
	QUIT:op="!" $$or
	#; JLF020
	QUIT:(("=IN'<'>%STARTSWITH,INSET"'[op)&&($e(op,1,4)'="TOP:")) 0 ;  non-equality COMP-cond ; PVA021: add IN operator ; JLF139 added INSET
	s val=$p(ptlg,"^",4),con=$p(ptlg,"^",5),type=$$$mtVType($$$mtV(con))
	#; PVA021: add IN operator; conds now has function return.
	#; PVA232: INSET should always have been listed below
	i "f"'=$$$mtVType($$$mtV(val)) QUIT:"f"'=type 0 QUIT:op="%STARTSWITH" 0 QUIT:op="IN" 0 QUIT:op="INSET" 0 d switch  ;  expr=expr, expr%SW is no good  ;  AK017
	#;  now the first operand (val) is a field
	#; PVA021: Handle IN operator
	QUIT:op="IN" $$in
	#; JLF139
	QUIT:op="INSET" $$in
	GOTO easy:"tx"[type,easy:$p($$$mtV(con),"^",3)=","  ;  field-op-fixpr
	#; PVA021: conds now has a function return
	QUIT:op'="=" 0
	s (ptv(val,con),ptv(con,val))=log  ;indicates `val=con' exists
	#;  A.f1=A.f2 ("f"), A.f1=B.f2 ("j"), or field=expr ("x")
	i "f"=type s $p(ptl,"^",log)=$S($p($$$mtV(val),"^",2)=$p($$$mtV(con),"^",2):"f",1:"j")
	e  s $p(ptl,"^",log)="x" s:'($d(ptv(con))#10) ptv(con)=con_"^e^^^^"_con_",^"_m
	s a=+$p(ptv(val),"^",$$$PTVEQUIVCLASS),b=+$p(ptv(con),"^",$$$PTVEQUIVCLASS)  ;  merge 2 equivalent classes
	#; PVA021: conds now has a function return
	QUIT:a=b 0  s:b<a x=a,a=b,b=x  ;  now a<b, a is the new class
	s list=$p(ptv(b),"^",$$$PTVVALSINCLASS) d aptv(a,$$$PTVVALSINCLASS,list)
	f li=1:1 s val=+$p(list,",",li) q:'val  s $p(ptv(val),"^")=a
	s xa=$p(ptv(a),"^",$$$PTVRANGEINFO),xb=$p(ptv(b),"^",$$$PTVRANGEINFO),type=$p(ptv(a),"^",$$$PTVCONTYPE)_$p(ptv(b),"^",$$$PTVCONTYPE)
	#; PVA021: Test for inconsistent condition, set mt("empty",..) and return 1; Fix comment on 'combine'.
	i type["n" s $$$mtEmpty(m)=1,$$$mtWhere(m)="",$$$mtStreamlessConds(m)="" QUIT 1
	#; PVA084: copy piece 16 from 'b' if it exists. The is special remembered
	#;         TOP RANGE info when it has collided with a CON type condition.
	set:$p(ptv(b),"^",$$$PTVTOPINFO)]"" $p(ptv(a),"^",$$$PTVTOPINFO)=$p(ptv(b),"^",$$$PTVTOPINFO)
combine ;  entry-point from `easy' and numerous other places, via GOTO
	#; PVA021: conds now has a function return
	QUIT:""=xb 0  i ""=xa s $p(ptv(a),"^",$$$PTVCONTYPE,$$$PTVRANGEINFO)=type_"^"_xb QUIT 0  ;  no conflicts
	i type="cc" s v=$$$mtV(xa),v3=$$$mtV(xb) d compare(xa,"=",xb) QUIT 0
	GOTO:type="rr" rr
	#; PVA021: Add cases ii,nx,ir,ci
	GOTO:type="ii" ii
	i $e(type,2)="n" s $p(ptv(a),"^",$$$PTVCONTYPE,$$$PTVRANGEINFO)="n^"_xb,x=xa,xa=xb,xb=x,type="n"_$e(type) GOTO nx ; switch xa,xb
	GOTO:$e(type)="n" nx ;  x means any type. 
	#; could check for "empty" cases of conflict between c,r, or i, given literal values. For now don't bother - run time $$$mtStreamlessConds(m) 
	#; processing is good enough. 
	#;ir/ri
	i type="ri" s $p(ptv(a),"^",$$$PTVCONTYPE,$$$PTVRANGEINFO)="i^"_xb,x=xa,xa=xb,xb=x GOTO ir ; switch xa,xb
	GOTO:type="ir" ir
	#;ic/ci
	i type="ic" s $p(ptv(a),"^",$$$PTVCONTYPE,$$$PTVRANGEINFO)="c^"_xb,x=xa,xa=xb,xb=x GOTO ci ; switch xa,xb
	GOTO:type="ci" ci
	s:type="rc" $p(ptv(a),"^",$$$PTVCONTYPE,$$$PTVRANGEINFO)="c^"_xb,x=xa,xa=xb,xb=x ; switch xa,xb
	#;  now type="cr", compare CON in xa to each RANGE in xb
	#; DPV1693
	For li=2:1 {
		s con=$p(xb,",",li) q:'con  
	#; JLF020
		#; Don't create a streamless TOP: condition, and do not remove the TOP: operator from mt("w",*)
		continue:$e($p(con,$c(1),2),1,4)="TOP:"
	#; JLF020-
		d compare(xa,$p(con,$c(1),2),$p(con,$c(1),3)),remove(+con,"i^pushtoC")  ;  *** must notify $p(ptv,3-5)!
		  #;  If the new log (val) created by compare() is replacing an old log that was in the "check option cascaded"
		  #;  log list, add the new log value to the list.
		s:$lf($g($$$mtWhereCheckOption),+con) $$$mtWhereCheckOption=$$$mtWhereCheckOption_$lb(val)
	}
	#; DPV1693-
	#; JLF020
	#; If merging with a range condition that includes a TOP: operator, then save the TOP info in ptv
	if xb[($c(1)_"TOP:") {
		n lastOp,topLog s lastOp=$p(xb,",",$l(xb,",")-1),topLog=$p(lastOp,$c(1),1)
		#; Recreate xb based on the TOP: operator alone
		d setXbTop(topLog)
		s $p(ptv(a),"^",$$$PTVTOPINFO)=xb
	}
	#; JLF020-
	#; PVA021: conds now has a function return
	QUIT 0
	#; PVA021: Add tags ir,nx,ci,ii,in
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ir	; Combine by filtering set by one or more range predicates
	s con=$p(xa,",")
	#; DPV1693
	#; JLF020
	n cocflag,normlRng s cocflag=0,normlRng=0
	f li=2:1 {
		s val=$p(xb,",",li) q:'val 
	#; JLF020
		#; Don't create a streamless TOP: condition, and do not remove the TOP: operator from mt("w",*)
		continue:$e($p(val,$c(1),2),1,4)="TOP:"
		s normlRng=1
	#; JLF020-
		s con=$$$newval("v^SET:"_$p(val,V,2)_"^,^"_con_"^"_$p(val,V,3)_"^",1) d remove(+val,"i^pushtoC")
		  #;  If removing any logical that was in the "check option cascaded" log list will result in 
		  #;  a new log entry ('EMPTY) below, add the new log value to the list below (flag it here)
		s:$lf($g($$$mtWhereCheckOption),+val) cocflag=1
	}
	#; AK890
	s:normlRng $p(xa,",",1,2)=con_",0",$$$mtLOperand2($$$mtL($p(xa,",",3)))=con
	#; JLF020
	s:($p(xa,",",5)>1&&(xb'[($c(1)_"TOP:"))) $p(xa,",",5)=$p(xa,",",5)\2 ; heuristic for effect of filter on set size.
	if normlRng {
	#; JLF020-
	If $p(xa,",",4)="" { 
		Set val=$$$newlog("v^'EMPTY^,^"_con_"^") 
		s $p(xa,",",4)=val,$$$mtStreamlessConds(m)=$g($$$mtStreamlessConds(m))_val_","  // putlog sets val to new log#
		s:cocflag $$$mtWhereCheckOption=$$$mtWhereCheckOption_$lb(val)
	}
	Else { s $$$mtLOperand1($$$mtL($p(xa,",",4)))=con }
	#; JLF020
	} // end if normlRng
	#; DPV1693-
	s $p(ptv(a),"^",$$$PTVRANGEINFO)=xa
	#; JLF020
	#; If merging with a range condition that includes a TOP: operator, then save the TOP info
	if xb[($c(1)_"TOP:") {
		n lastOp,topLog s lastOp=$p(xb,",",$l(xb,",")-1),topLog=$p(lastOp,$c(1),1)
		#; Recreate xb based on the TOP: operator alone
		d setXbTop(topLog)
		s $p(ptv(a),"^",$$$PTVTOPINFO)=xb
	}
	#; JLF020-
	QUIT 0
	#; all conflict with a null test, except for a set that has been ORed with IS NULL.
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nx	s con=$e(type,2),li=0 s:"ni"'[con li=1 s:con="i"&&('$p(xb,",",2)) li=1
	#; PVA172: If second condition is range, with only one condition, and it is TOP,
	#;         don't set mt("empty",) and store info in special place
	if con="r",$l(xb,",")=3,xb[($c(1)_"TOP:")
	{  s $p(ptv(a),"^",$$$PTVTOPINFO)=xb
	   QUIT 0
	}
	i li s $$$mtEmpty(m)=1,$$$mtWhere(m)="",$$$mtStreamlessConds(m)="" QUIT 1 ; most conditions ANDed with IS NULL cause whole 
	      #;  WHERE clause to evaluate to FALSE.
	d remove(xb,"i^pushtoC"):con="n",remove($p(xb,",",3),"i^pushtoC"):con="i"
	#; note: it is never crucial to remove and mt("c") condition;
	#;     furthermore, there shouldn't be an mt("c") for an "i" compatible with "n" because it is thus known 
	#;      non empty (the set must at least include null). 
	QUIT 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ci	; Combine by adding constant test of set membership
	d compare(xa,"ONEOF",+xb),remove($p(xb,",",3),"i^pushtoC") d:$p(xb,",",4)'="" removec($p(xb,",",4))
	#; PVA124: record info about ONEOF set in ptv to allow possible undoing of ONEOF
	s $p(xb,",",2)=0 // clear null in set flag
	s ptv(+xb)=+xb_"^e^"_val_",^i^"_xb_"^"_(+xb)_",^"_m
	#; DPV1693
	#;  If the new log (val) created by compare() is replacing an old log that was in the "check option cascaded"
	#;  log list, add the new log value to the list.
	s:$lf($g($$$mtWhereCheckOption),$p(xb,",",3)) $$$mtWhereCheckOption=$$$mtWhereCheckOption_$lb(val)
	#; DPV1693-
	QUIT 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ii	; make new set as intersection of prior sets
	s con=$$$newval("v^SET:INTX^,^"_$p(xa,",")_"^"_$p(xb,",")_"^",1)
	#; change any prior $$$mtStreamlessConds(m) 'EMPTY condition for xa to use new set; make new 'EMPTY condition if none
	#;   made yet. val (mis)used to hold log# below.
	s val=$p(xa,",",4) i val'="" s $$$mtLOperand1($$$mtL(val))=con 
	e  Set val=$$$newlog("v^'EMPTY^,^"_con_"^") s $p(xa,",",4)=val,$$$mtStreamlessConds(m)=$g($$$mtStreamlessConds(m))_val_"," ; putlog sets val to new log#
	#; change prior mt("w",m) ONEOF condition to use new set, remove obsoleted current IN
	s $$$mtLOperand2($$$mtL($p(xa,",",3)))=con
	#; PVA080: Remove use of 'log', get from xb piece 3. If get here from f1=f2 merging
	#;         equivalence classes, log will point to this condition rather than one of 
	#;         IN conditions. 
	d remove($p(xb,",",3),"i^pushtoC") d:$p(xb,",",4)'="" removec($p(xb,",",4))
	#; DPV1693
	  #;  If the new log (val) created by $$$newlog() is replacing an old log that was in the "check option cascaded"
	  #;  log list, add the new log value to the list.
	#; PVA080: Remove use of 'log', repl with xb piece 3. 
	s:$lf($g($$$mtWhereCheckOption),$p(xb,",",3)) $$$mtWhereCheckOption=$$$mtWhereCheckOption_$lb(val)
	#; DPV1693-
	  #; change ptv entry to use new set; update null pass flag
	s $p(xa,",",1,2)=con_","_($p(xa,",",2)&$p(xb,",",2))
	s:$p(xb,",",5)<$p(xa,",",5) $p(xa,",",5)=$p(xb,",",5) ; take minimum of two set sizes.
	s $p(ptv(a),"^",$$$PTVRANGEINFO)=xa
	QUIT 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
in()	 ; This called from "conds"; expects QUIT 1 for conflicting predicates
	#; JSL5032 - new op1 and save old op off in mt("lops",log)
	n bad,ftype,op1
	s a=+$p(ptv($p(vals,",",2)),"^",$$$PTVEQUIVCLASS),type=$p(ptv(a),"^",$$$PTVCONTYPE)
	; must analyze all values for being fixed expressions
	s bad=0 f pi=5:1 s con=$p(ptlg,"^",pi) q:con=""  s ftype=$$$mtVType($$$mtV(con)) i "tx"'[ftype&&($p($$$mtV(con),"^",3)'=",") s bad=1 q
	QUIT:bad 0  ; nothing more to do - no good for OR generalized CON
 
	#; Build set value, convert IN to ONEOF operator; compute pi = # elements in set
	if op="INSET"		// Streamless list
	#; PVA232: support optional third arg giving list size 'estimate'
	{	QUIT:($l(ptlg,"^")>7 || '($p($p($$$mtV($p(ptlg,"^",5)),"^",2),":",1)="SET")) 0 //  tbd - generalize code gen in the future to handle streamless extrinsic functions
		s op="ONEOF",$$$mtLOperator($$$mtL(log))=op,con=$p(ptlg,"^",5),pi=$$getsize(ptlg,log)
		// keep $p(6) in RTPC first time compilation, so this INSET condition will not trigger RTPC list length
		// since we know the list length in $p(6)  
		s:'($d(rtpcHelperCode("caller"))&&($p(ptlg,"^",6)'="")) $$$mtL(log)=$p($$$mtL(log),"^",1,5)_"^",$$$mtOrigOp(log)="INSET"
	}
	else
	{	s pi=$l(ptlg,"^")-5 ; first 4 pieces, plus apparent piece at end from trailing "^"
		s con=$$$newval("v^SET:SETOF^,^"_$p(ptlg,"^",5,*),1)  ; we've established no field refs.
		s op1=$p(ptlg,"^",2) s $p(ptlg,"^",2)="ONEOF",$p(ptlg,"^",5,*)=con_"^"
		if $d(rtpcHelperCode("caller")){
			// populate $p(6), so this IN condition will not trigger RTPC list length 
			// since we know the list length pi by count $length
			s $$$mtL(log)= ptlg_$$$newval("t^"_pi,1)_"^"
		} else {
			s $$$mtL(log)=ptlg,op="ONEOF",$$$mtOrigOp(log)=$ZCVT(op1,"U")
		}
	}
 
	#; Set up for common combine analysis.
	s xa=$p(ptv(a),"^",$$$PTVRANGEINFO),type=type_"i",xb=con_","_$s($g(mt("pushlog",log))=1:1,1:0)_","_log_",,"_pi,$p(ptl,"^",log)="c" GOTO combine
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA021: Change to use 'combine' catching all the new cases. 
null	 ; This reached from "conds"
 #; PVA048: It's only a CON if the operand is a field.
	if $e($$$mtV($p(ptlg,"^",4)))'="f" s $p(ptl,"^",log)="m" QUIT 0 ; streamless case already excluded
	s a=+$p(ptv($p(vals,",",2)),"^",$$$PTVEQUIVCLASS),type=$p(ptv(a),"^",$$$PTVCONTYPE)
	s xa=$p(ptv(a),"^",$$$PTVRANGEINFO),type=type_"n",xb=log,$p(ptl,"^",log)="c" GOTO combine
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
switch	;  make the field (currently con) the first operand (val)
	s x=con,con=val,val=x,type=$$$mtVType($$$mtV(con)),op=$tr(op,"<>","><")
	s ptlg="v^"_op_"^"_vals_"^"_val_"^"_con_"^",$$$mtL(log)=ptlg
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
easy	s a=+$p(ptv(val),"^",$$$PTVEQUIVCLASS),type=$p(ptv(a),"^",$$$PTVCONTYPE),xa=$p(ptv(a),"^",$$$PTVRANGEINFO)
	i op="=" s xb=con,type=type_"c",$p(ptl,"^",log)="c" GOTO combine
	#; JLF020
	if $e(op,1,4)="TOP:" { d setXbTop(log) }
	else { s xb=$S((op="<")||(op="'>"):$c(1,1),1:"")_con_$c(1)_$S(op="%STARTSWITH":2,1:$l(op)=2)_","_log_$c(1)_op_$c(1)_con_"," }
	s type=type_"r",$p(ptl,"^",log)="r"
	#; JLF020-
	s range(val_"^"_op_"^"_con)=log
	GOTO combine
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF020
setXbTop(log) [ xb, mt ] PUBLIC {	    
	s mtl=$$$mtL(log),lastSubOp=$p($p(mtl,"^",2),":",2),con=$p(mtl,"^",5),op=$p(mtl,"^",2)
	s lastSubOp = $p(lastSubOp,".",$l(lastSubOp,".")),incl=$s(lastSubOp["'":3,1:4)
	#; xa,xb have this structure: lowerBound | inclusiveFlag | upperBound | inclusiveFlag , log | operatorName | lbVal , log | operatorName | ubVal ,
	if (",<,'>," [ (","_lastSubOp_",")) { s ub=con,lb="" } else { s ub="",lb=con }
	s xb = lb_$c(1)_$s(lb'="":incl,1:"")_$c(1)_ub_$c(1)_$s(ub'="":incl,1:"")_","_log_$c(1)_op_$c(1)_con_"," // lb_","_log_$c(1)_op_$c(1)_ub_","
	QUIT
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF020-
	#; JLF020
	#; PVA141: prefer non-TOP upper bound
rr	s x=$p(xa,",") s:(('$p(x,$c(1),3)||($p(x,$c(1),4)>2))&&($p(x,$c(1),2)'=2)) $p(x,$c(1),3,4)=$p($p(xb,","),$c(1),3,4)
	#; JLF020-
	#; xb is information about the comparison just found, and xa is the accumulated 
	#; information about previous comparisons on the same equivalence class of fields. 
	#; However, the same code handles a case where xa and xb may both be lists of conditions, 
	#; each with upper and/or lower bounds. This happens when you have ranges on x and on y, 
	#; and then x=y is encountered. Then x,y become an equivalence class, and their range
	#; descriptors are merged.
	#; 
	#; Note: bounds format in ,-piece 1 is: lowerBound | inclusiveFlag | upperBound | inclusiveFlag
	#;
	#; JLF020
	i $p(x,$c(1),2)'=2,xb s:('$p(x,$c(1),1)||($p(x,$c(1),2)>2)) $p(x,$c(1),1,2)=$p($p(xb,","),$c(1),1,2)
	#; Ensure that a TOP: predicate is never the first log when 2 or more choices exist
	s $p(ptv(a),"^",$$$PTVRANGEINFO)=x_","_$s((+$p(xb,$c(1),2)>2)||(+$p(xb,$c(1),4)>2):$p(xa,",",2,*)_$p(xb,",",2,*),1:$p(xb,",",2,*)_$p(xa,",",2,*))
	#; JLF020-
	#; PVA021: conds now has a function return
	QUIT 0
	#; PVA021: Add new tags: or,andnl,ornl,clasfycond,orxfrm,andxfrm,fillt,rflt,xfrmleaf
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
or()	; Analyze whether an OR term can be represented as a good condition for the optimizer
	#; we assume the OR is not a streamless condition (this should be checked for elsewhere).
	#; Function return is 1 if OR expression known to evaluate to FALSE, else 0. (mt("empty",m) will
	#; already be set when return is 1). 
	n ii,ll,good,fv,stype,npf,vnum,val,cnt,origlog
	#; Phase 1: Can it be a generalized CON node: a possibly run time determined discrete set of values
	#;    of a given field.
	#; Pass 1: Is it good? (Don't make parse tree manipulations without a global goodness decision)
	#;    Is more than one field involved?
	s fv=$p(vals,",",2),good=1
	#; AK530
	n colnul s colnul=$$colnul^%qaqcpr(fv,0)  ;  Coll(NULL) - " ", 0, or ""  DPV1799 added second parameter to colnul
	f ii=3:1 s ll=$p(vals,",",ii) q:ll=""  s:ll'=fv good=0 q:'good
	QUIT:'good 0
	#; For now, equivalence classes are ignored in the above code. We will treat an OR tree as CON candidate 
	#; only if all its field refs are to the same actual field. Later, when we support the ORANGE node, this will
	#; be generalized (OR tree will be examined with equivalence mapping, and when new equivalence detected, 
	#; prior ORANGEs - then recorded in ptv - will be re-examined). HOWEVER, two separate OR trees meeting 
	#; current criteria will be merged as an equivalence is detected. 
	QUIT:$$ornl(log)'=1 0
	s origlog=log 
	#; Pass 2: Build parse tree operations for run time set derivation, plus $$$mtStreamlessConds(m) condition.   
	#;     As currently implemented, $$ornl prevents us from detecting the case where the top level of ORs 
	#;     includes f is null or... or f is not null. In this case, the whole top level OR node could be discarded -
	#;     it is always TRUE. If $$ornl were extended to detect TRUE and FALSE trees (irrespective of SET character)
	#;     we could throw the while top OR term away in the first case, or set mt("empty",m) in the second case. 
	#;     Doing this would involve adding npf flag propagation and special handling for NULL and 'NULL conditions.
	#;     The logic involved is present in orxfrm/andxrm, even though it isn't reachable for the top level OR 
	#;     (because of $$ornl).  
	#;     In general, as more types of OR become useful to the optimizer in future work, $$ornl will return 
	#;     additional classifications of the OR tree. These will be passed to orxfrm. This solves a general issue
	#;     with OR processing - we don't know what should be done with particular cases within the OR tree without 
	#;     knowing its global classification from the optimizer's point of view. 
	d orxfrm(log,.stype,.npf,.vnum,.cnt) ; because of pre-analysis done by $$ornl, only some types possible here
	#; DPV1693
	If stype="ds"||(stype="ss")||(stype="c") {
		If stype="ds",'npf {
			Set val=$$$newlog("v^'EMPTY^,^"_vnum_"^") 
			s $$$mtStreamlessConds(m)=$g($$$mtStreamlessConds(m))_val_",",ii=val ; putlog sets val to new log#v
			  #;  If the new log (val) created by $$$newlog() is replacing an old log that was in the "check option cascaded"
			  #;  log list, add the new log value to the list.
			s:$lf($g($$$mtWhereCheckOption),log) $$$mtWhereCheckOption=$$$mtWhereCheckOption_$lb(val)
		}
		Else { s ii="" }
		d remove(log,"i^pushtoC") n rlog s rlog=log ; OR tree will be replace by ONEOF condition.
		s:stype="c" vnum=$$$newval("v^SET:SETOF^,^"_vnum_"^",1)
		d nulog("v^ONEOF^,"_fv_",^"_fv_"^"_vnum_"^") ; this sets log to new logic #
		if $D(mt("nRTP","SelInfo",rlog)){
			set mt("nRTP","SelInfo",log) = mt("nRTP","SelInfo",rlog)	
		}
		s:$lf($g($$$mtWhereCheckOption),rlog) $$$mtWhereCheckOption=$$$mtWhereCheckOption_$lb(val)
		s $p(ptl,"^",log)="c"
		s:cnt<1 cnt=1 s cnt=cnt\1
		s a=+$p(ptv(fv),"^",$$$PTVEQUIVCLASS),type=$p(ptv(a),"^",$$$PTVCONTYPE)_"i",xa=$p(ptv(a),"^",$$$PTVRANGEINFO),xb=vnum_","_npf_","_log_","_ii_","_cnt
		if log'=origlog,("^"_$g(mt("complexlog",m))[("^"_origlog_"^")) d complexlog^%qaqpnl(m,log)
		GOTO combine
	}
	If stype="n" {
		s:$lf($g($$$mtWhereCheckOption),log) $$$mtWhereCheckOption=$$$mtWhereCheckOption_$lb(vnum)
		d remove(log,"i^pushtoC") s log=vnum d addlog(log)
		if log'=origlog,("^"_$g(mt("complexlog",m))[("^"_origlog_"^")) d complexlog^%qaqpnl(m,log)
		GOTO null
	}
	#; DPV1693-
	i stype="FALSE" s $$$mtEmpty(m)=1,$$$mtWhere(m)="",$$$mtStreamlessConds(m)="" QUIT 1
	i stype="TRUE" d remove(log,"i^pushtoC") QUIT 0 ; no need to test if always true
	$$$Abort ; nothing else should ever happen here, unless bug in ornl.
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
andnl(log) ; analyze whether a logic tree starting with AND will result in a discrete set of values
	#; Returns: 0 - log not compatible with generalized CON node being produced
	#;              1 - result is a discrete set suitable for gen. CON node
	#;              2 - result is not a discrete set, but could be part of a logic tree which does yield 
	#;                  a discrete set.
	#; log : logic number of $$$mtL(..)
	n ii,ll,alist,good,op,class
	s alist=$p($$$mtL(log),"^",4,5),good=2
	f ii=1:1 s ll=$p(alist,"^",ii) q:ll=""  d  q:good=0
	. s op=$$$mtLOperator($$$mtL(ll)) i op="&" s alist=alist_"^"_$p($$$mtL(ll),"^",4,5) q  ; fold ANDs into a flat list
	. i op="!" s op=$$ornl(ll) s:op=1 good=1 s:op=0 good=0 q
	. s op=$$$mtL(ll) i $p(op,"^")'="v" s good=0 q  ; negation or something else we don't like yet.
	. s class=$$clasfycond(op)
	. i class=1 s good=1 q
	. q:class=2  s good=0 q
	QUIT good
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ornl(log) ; analyze whether a logic tree starting with OR will result in a discrete set of values
	#; Returns: 0 - log not compatible with generalized CON node being produced
	#;              1 - result is a discrete set suitable for generalized CON node
	#;              2 - result is not a discrete set, but could be part of a logic tree which does yield 
	#;                  a discrete set.
	#; log : logic number of $$$mtL(..)
	n ii,ll,olist,good,op,class
	s olist=$p($$$mtL(log),"^",4,5),good=1
	f ii=1:1 s ll=$p(olist,"^",ii) q:ll=""  d  q:good=0
	. s op=$$$mtLOperator($$$mtL(ll)) i op="!" s olist=olist_"^"_$p($$$mtL(ll),"^",4,5) q  ; fold ORs into a flat list
	. i op="&" s op=$$andnl(ll) s:op=2 good=2 s:op=0 good=0 q
	. s op=$$$mtL(ll) i $p(op,"^")'="v" s good=0 q  ; negation or something else we don't like yet.
	. s class=$$clasfycond(op)
	. q:class=1
	. i class=2 s good=2 q
	. s good=0 q
	QUIT good
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
clasfycond(ptln) ; Given a ptln for a logic entry of type "v" which references only one field, 
	                        ; analyze whether it is representable as <field> in <fixed value list>
	                        ; or a <field> <cmpop> <fixed expr>
	                        ; or something else.
	#; returns 1 if condition is a set type condition, 2 if a general comparison, 0 otherwise.
	#; IMPORTANT: Logic here should be kept in synch with conds tag for what can go in a CON mts entry.
	#;   For now we don't do equivalence indirection because OR conditions are not currently replicated  
	#;   over equivalence classes. In a later phase of improvements, such replication and this logic will be 
	#;   generalized. 
	n op,opf,opv,val,good,pi,type
	s op=$p(ptln,"^",2)
 #; PVA041: Don't short circuit NULL test	
	QUIT:"'NULL'=IN'[']'<'>%STARTSWITH,INSET"'[op 0				; JLF139 added INSET
	s opf=$p(ptln,"^",4),opv=$p(ptln,"^",5)
	QUIT:op="NULL"&&("f"=$$$mtVType($$$mtV(opf))) 1
	QUIT:opv="" $s("f"=$$$mtVType($$$mtV(opf)):2,1:0) ; catch unary field tests here
	i "f"'=$$$mtVType($$$mtV(opf)) QUIT:"f"'=$$$mtVType($$$mtV(opv)) 0 QUIT:"IN'[']INSET%STARTSWITH"[op 0  s opv=opf
	i op'="IN" s val=$$$mtV(opv) QUIT:"tx"[$e(val) $s(op="=":1,op="INSET":1,1:2) QUIT:$p(val,"^",3)="," $s(op="=":1,op="INSET":1,1:2) QUIT 0
	; must analyze all values of IN for being fixed expressions (IN is only case left now).
	s good=1 f pi=5:1 s val=$p(ptln,"^",pi) q:val=""  s type=$$$mtVType($$$mtV(val)) i "tx"'[type,$p($$$mtV(val),"^",3)'="," s good=0 q
	QUIT good 
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
orxfrm(log,stype,npf,vnum,cnt) ; Transform an OR tree
	#; log - input -  log number of OR to transform
	#; stype - output - type of result produced (see below)
	#; npf - output - whether null is known to be in the result
	#; vnum - output - val# of result (usually; sometimes it's a log#, based on stype)
	#; cnt - output - estimate of number of elements in set, if vnum is a set.
	#; 
	#; Currently, only some type of discrete set result is produced (for top level OR). 
	#; Ornl must be run first to classify the OR. 
	#; stype values: TRUE, FALSE, c (= constant), n (is null), r (range), nn (not null), ss (simple set),
	#; ds (derived set), lt (logic tree).
	#; vnum based on stype: not set for TRUE, FALSE; log# for n, r, nn; otherwise val# of result. 
	#;
	n left,right,ptln,op,t,n,v,i,ii,ll,olist
	  #; Note, we only recurse for AND, to avoid framestack issues.
	s olist=$p($$$mtL(log),"^",4,5),left=""
	f ii=1:1 s ll=$p(olist,"^",ii) q:ll=""  d  
	. s ptln=$$$mtL(ll),op=$p(ptln,"^",2) i op="!" s olist=olist_"^"_$p(ptln,"^",4,5) q  
	. if left]"" { s right=$$xfrmleaf(ll,ptln,op) } else { s left=$$xfrmleaf(ll,ptln,op) q  }
	. ;xfrm action based on left, right, store in ret
	. s:$li(left)]$li(right) i=left,left=right,right=i ;reduce distinct cases by half by symmetry
	. s t=$li(left)_$li(right)
	. s:t["TRUE" left=$lb("TRUE",1,,"")
	. s:t["FALSE" left=right ; known FALSE is left because of switch above (if FALSETRUE, we set left twice twice - to the same thing. BFD. 
	. s:t="cc" n=$$$newval("v^SET:SETOF^,^"_$li(left,3)_"^"_$li(right,3)_"^",1),left=$lb("ss",0,n,2)
	#; AK530
	. if t="cn" { n nullval s nullval=$$$newval("t^"_colnul,1) d dtset^%qaqpdt(nullval,$$$VTRgetdt($li(left,3))) s n=$$$newval("v^SET:SETOF^,^"_$li(left,3)_"^"_nullval_"^",1),left=$lb("ss",1,n,2) }
	. // i t="nn" ; pick arbitrary one of the null tests to keep. Doing nothing will pick left one.
	. s:t="cr" n=$$$newval("v^SET:UNION^,^"_$$$newval("v^SET:=^,^^"_$li(left,3)_"^",1)_"^"_$$rflt(right,"")_"^",1),left=$lb("lt",0,n,"x/2+1") 
	. s:t="nr" n=$$$newval("v^SET:UNION^,^"_$$$newval("v^SET:NULL^,^^",1)_"^"_$$rflt(right,"")_"^",1),left=$lb("lt",1,n,"x/2+1")
	. s:t="rr" n=$$$newval("v^SET:UNION^,^"_$$rflt(left,"")_"^"_$$rflt(right,"")_"^",1),left=$lb("lt",0,n,"x")
	. s:t="cnn" left=right ; =constant is subsumed in NOT NULL
	. s:t="nnn" left=$lb("TRUE",1,,"")
	. //i t="nnr" ; doing nothing will keep left (nn), which is what we want.
	. //i t="nnnn" ; doesn't matter which is preserved, doing nothing keeps left
	. s:t="css" i=$li(right,3),$e($$$mtV(i),$l($$$mtV(i))+1)=$li(left,3)_"^",left=right,$li(left,4)=$li(left,4)+1
	#; AK530
	. s:t="nss" i=$li(right,3),$e($$$mtV(i),$l($$$mtV(i))+1)=$$$newval("t^"_colnul,1)_"^",$li(right,2)=1,left=right,$li(left,4)=$li(left,4)+1
	. s:t="rss" left=$$rflt(left,""),i=$$$newval("v^SET:INTX^,^^"_$li(right,3)_"^",1),n=$$$newval("v^SET:UNION^,^"_left_"^"_i_"^",1),left=$lb("lt",$li(right,2),n,"x/2+$s(x<"_$li(right,4)_":x,1:"_$li(right,4)_")")
	. s:t="nnss" left=$s($li(right,2):$lb("TRUE",1,,""),1:left)
	. s:t="ssss" i=$li(right,3),$e($$$mtV(i),$l($$$mtV(i))+1)=$p($$$mtV($li(left,3)),"^",4,*),$li(right,2)=$li(right,2)||$li(left,2),$li(right,4)=$li(right,4)+$li(left,4),left=right
	. s:t="cds" i=$$$newval("v^SET:SETOF^,^"_$li(left,3)_"^",1),n=$$$newval("v^SET:UNION^,^"_i_"^"_$li(right,3)_"^",1),$li(right,3)=n,left=right,$li(left,4)=$li(left,4)+1
	#; AK530
	. s:t="dsn" n=$$$newval("v^SET:UNION^,^"_$$$newval("v^SET:SETOF^,^"_$$$newval("t^"_colnul,1)_"^",1)_"^"_$li(left,3)_"^",1),left=$lb("ds",1,n,$li(left,4)+1)
	. s:t="dsr" right=$$rflt(right,""),i=$$$newval("v^SET:INTX^,^^"_$li(left,3)_"^",1),n=$$$newval("v^SET:UNION^,^"_right_"^"_i_"^",1),left=$lb("lt",$li(left,2),n,"x/2+$s(x<"_$li(left,4)_":x,1:"_$li(left,4)_")")
	. s:t="dsnn" left=$s($li(left,2):$lb("TRUE",1,,""),1:right)
	. s:t="dsss" n=$$$newval("v^SET:UNION^,^"_$li(left,3)_"^"_$li(right,3)_"^",1),left=$lb("ds",$li(left,2)||$li(right,2),n,$li(left,4)+$li(right,4))
	. s:t="dsds" n=$$$newval("v^SET:UNION^,^"_$li(left,3)_"^"_$li(right,3)_"^",1),left=$lb("ds",$li(left,2)||$li(right,2),n,$li(left,4)+$li(right,4))
	. s:t="clt" n=$$$newval("v^SET:UNION^,^"_$li(right,3)_"^"_$$$newval("v^SET:=^,^^"_$li(left,3)_"^",1)_"^",1),left=$lb("lt",$li(right,2),n,$li(right,4)_"+1")
	. s:t="ltn" n=$$$newval("v^SET:UNION^,^"_$$$newval("v^SET:NULL^,^^",1)_"^"_$li(left,3)_"^",1),left=$lb("lt",1,n,$li(left,4)_"+1")
	. s:t="ltr" n=$$$newval("v^SET:UNION^,^"_$$rflt(right,"")_"^"_$li(left,3)_"^",1),$li(left,3)=n,$li(left,4)=$li(left,4)_"+(x/2)"
	. s:t="ltnn" left=$s($li(left,2):$lb("TRUE",1,,""),1:right)
	. s:t="ltss" i=$$$newval("v^SET:INTX^,^^"_$li(right,3)_"^",1),n=$$$newval("v^SET:UNION^,^"_$li(left,3)_"^"_i_"^",1),left=$lb("lt",$li(right,2)||$li(left,2),n,$li(left,4)_"+$s(x<"_$li(right,4)_":x,1:"_$li(right,4)_")")
	. s:t="dslt" i=$$$newval("v^SET:INTX^,^^"_$li(left,3)_"^",1),n=$$$newval("v^SET:UNION^,^"_$li(right,3)_"^"_i_"^",1),left=$lb("lt",$li(right,2)||$li(left,2),n,$li(right,4)_"+$s(x<"_$li(left,4)_":x,1:"_$li(left,4)_")")
	. s:t="ltlt" n=$$$newval("v^SET:UNION^,^"_$li(left,3)_"^"_$li(right,3)_"^",1),left=$lb("lt",$li(right,2)||$li(left,2),n,$li(left,4)_"+("_$li(right,4)_")")
	s stype=$li(left),npf=$li(left,2),vnum=$lg(left,3),cnt=$lg(left,4)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
andxfrm(log,stype,npf,vnum,cnt) ; Transform an AND tree
	#; log - input -  log number of OR to transform
	#; stype - output - type of result produced (see below)
	#; npf - output - whether null is known to be in the result
	#; vnum - output - val# of result (usually; sometimes it's a log#, based on stype)
	#; cnt - output - estimate of number of elements in set, if vnum is a set.
	#; 
	#; This is used for AND below OR, not for top level AND (which is incorporated in mt("w",) anyway).
	#; Ornl must be run first to classify the top level OR. 
	#; stype values: TRUE, FALSE, c (= constant), n (is null), r (range), nn (not null), ss (simple set),
	#; ds (derived set), lt (logic tree).
	#; vnum based on stype: not set for TRUE, FALSE; log# for n, r, nn; otherwise val# of result. 
	#;
	n left,right,ptln,op,t,n,v,i,ii,ll,olist
	  #; Note, we only recurse for OR, to avoid framestack issues.
	s olist=$p($$$mtL(log),"^",4,5),left=""
	f ii=1:1 s ll=$p(olist,"^",ii) q:ll=""  d  
	. s ptln=$$$mtL(ll),op=$p(ptln,"^",2) i op="&" s olist=olist_"^"_$p(ptln,"^",4,5) q  
	. i left]"" { s right=$$xfrmleaf(ll,ptln,op) } else { s left=$$xfrmleaf(ll,ptln,op) q  }
	. ;xfrm action based on left, right, store in ret
	. s:$li(left)]$li(right) i=left,left=right,right=i ;reduce distinct cases by half by symmetry
	. s t=$li(left)_$li(right)
	. s:t["TRUE" left=right
	. s:t["FALSE" left=$lb("FALSE",0,,"") ; known FALSE is left because of switch above (if FALSETRUE, we set left twice - first wrong, then right. BFD. )
	. s:t="cc" n=$$$newval("v^SET:=^,^"_$$$newval("v^SET:SETOF^,^"_$li(left,3)_"^",1)_"^"_$li(right,3)_"^",1),left=$lb("ds",0,n,1)
	. s:t="cn" left=$lb("FALSE",0,,"")
	. //i t="nn" ; pick arbitrary one of the null tests to keep. Doing nothing will pick left one.
	. s:t="cr" n=$$rflt(right,$$$newval("v^SET:SETOF^,^"_$li(left,3)_"^",1)),left=$lb("ds",0,n,.5) 
	. s:t="nr" left=$lb("FALSE",0,,"")
	. s:t="rr" n=$$rflt(right,$$rflt(left,"")),left=$lb("lt",0,n,"x/4")
	. s:t="cnn" n=$$$newval("v^SET:'NULL^,^"_$$$newval("v^SET:SETOF^,^"_$li(left,3)_"^",1)_"^",1),left=$lb("ds",0,n,1)
	. s:t="nnn" left=$lb("FALSE",0,,"")
	. s:t="nnr" n=$$$newval("v^SET:'NULL^,^"_$$rflt(right,"")_"^",1),left=$lb("lt",0,n,"x/2")
	. //i t="nnnn" ; doesn't matter which is preserved, doing nothing keeps left
	. s:t="css" n=$$$newval("v^SET:=^,^"_$li(right,3)_"^"_$li(left,3)_"^",1),left=$lb("ds",0,n,1)
	. s:t="nss"&&('$li(right,2)) left=$lb("FALSE",0,,"") ; otherwise, left = null test, will be retained.
	. s:t="rss" n=$$rflt(left,$li(right,3)),left=$lb("ds",0,n,$li(right,4)/2)
	. s:t="nnss" n=$$$newval("v^SET:'NULL^,^"_$li(right,3)_"^",1),left=$lb("ds",0,n,$s($li(right,2):$li(right,4)-1,1:$li(right,4)))
	. s:t="ssss" n=$$$newval("v^SET:INTX^,^"_$li(left,3)_"^"_$li(right,3)_"^",1),left=$lb("ds",$li(left,2)&$li(right,2),n,$s($li(right,4)<$li(left,4):$li(right,4),1:$li(left,4)))
	. s:t="cds" n=$$$newval("v^SET:=^,^"_$li(right,3)_"^"_$li(left,3)_"^",1),left=$lb("ds",0,n,1)
	. i t="dsn" s:'$li(left,2) left=$lb("FALSE",0,,"") s:$li(left,2) left=right
	. s:t="dsr" n=$$rflt(right,$li(left,3)),left=$lb("ds",0,n,$li(left,4)/2)
	. s:t="dsnn" n=$$$newval("v^SET:'NULL^,^"_$li(left,3)_"^",1),left=$lb("ds",0,n,$s($li(left,2):$li(left,4)-1,1:$li(left,4)))
	. s:t="dsss" n=$$$newval("v^SET:INTX^,^"_$li(left,3)_"^"_$li(right,3)_"^",1),left=$lb("ds",$li(left,2)&$li(right,2),n,$s($li(right,4)<$li(left,4):$li(right,4),1:$li(left,4)))
	. s:t="dsds" n=$$$newval("v^SET:INTX^,^"_$li(left,3)_"^"_$li(right,3)_"^",1),left=$lb("ds",$li(left,2)&$li(right,2),n,$s($li(right,4)<$li(left,4):$li(right,4),1:$li(left,4)))
	. i t="clt" s cnt=$$fillt($$$newval("v^SET:SETOF^,^"_$li(left,3)_"^",1),right,1) s left=$lb("ds",0,$li(right,3),cnt)
	. i t="ltn" s:'$li(left,2) left=$lb("FALSE",0,,"") s:$li(left,2) left=right
	. s:t="ltr" n=$$rflt(right,$li(left,3)),left=$lb("lt",0,n,$li(left,4)_"/2")
	. s:t="ltnn" n=$$$newval("v^SET:'NULL^,^"_$li(left,3)_"^",1),left=$lb("lt",0,n,$s($li(left,2):$li(left,4)_"-1",1:$li(left,4)))
	. s:t="ltss" cnt=$$fillt($li(right,3),left,$li(right,4)),left=$lb("ds",$li(left,2)&$li(right,2),$li(left,3),cnt)
	. s:t="dslt" cnt=$$fillt($li(left,3),right,$li(left,4)),left=$lb("ds",$li(left,2)&$li(right,2),$li(right,3),cnt)
	. s:t="ltlt" n=$$$newval("v^SET:INTX^,^"_$li(left,3)_"^"_$li(right,3)_"^",1),left=$lb("lt",$li(left,2)&$li(right,2),n,"$s("_$li(right,4)_"<("_$li(left,4)_"):"_$li(right,4)_",1:"_$li(left,4)_")")
	s stype=$li(left),npf=$li(left,2),vnum=$lg(left,3),cnt=$lg(left,4)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fillt(sval,ltinfo,ssize) ; Fill in filter logic tree with supplied set value. 
	 #; Leaf terms of the logic tree (those with an empty operand) are filled with sval for this operand.
	 #; sval - input - val# of set to use for missing operands of logic tree leaves
	 #; ltinfo - input - a list of information on the logic tree - same format as left/right in orxfrm/andxfrm
	 #; ssize - estimated size of sval
	 #; RETURNS: estimated count for set resulting from logic tree
	n ptln,op,ii,ll,vlist,x
	  #; Note, we avoid recursion because of framestack limits
	s vlist=$li(ltinfo,3)
	f ii=1:1 s ll=$p(vlist,"^",ii) q:ll=""  d  
	. s ptln=$$$mtV(ll) q:$e(ptln)'="v"
	. s op=$p(ptln,"^",2) i op="SET:UNION" s $e(vlist,$l(vlist)+1)="^"_$p(ptln,"^",4,5) q
	. q:"'NULL'=INTX'[']'>'<%STARTSWITH"'[$p(op,":",2)
	. i $p(ptln,"^",4)="" s $p(ptln,"^",4)=sval,$$$mtV(ll)=ptln q
	. i op="SET:INTX" s $e(vlist,$l(vlist)+1)="^"_$p(ptln,"^",4,5) q
	. s $e(vlist,$l(vlist)+1)="^"_$p(ptln,"^",4)
	#; The count estimate for an lt is a COS executable expression in terms of x
	s x=ssize x "s ii="_$li(ltinfo,4)
	QUIT $s(ii>ssize:ssize,1:ii)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
rflt(rterm,vset) ; build possibly incomplete filter set operaton for OR/AND range leaf
	#; rterm a "r" type left or right value from orxfrm or andxfrm
	#; vset: "" if not available yet, otherwise val# of set to filter
	#; return value is val# of the [incomplete] range filter
	n ptln,op,i,v
	s ptln=$$$mtL($li(rterm,3)),op=$p(ptln,"^",2),i=$e($$$mtV($p(ptln,"^",4))),v=$s(i="f":$p(ptln,"^",5),1:$p(ptln,"^",4))
	s:i'="f" op=$tr(op,"<>","><")
	QUIT $$$newval("v^SET:"_op_"^,^"_vset_"^"_v_"^",1) 
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
xfrmleaf(log,ptln,op) ; set up a leaf term for transform (orxfrm, andxfrm)
	#; Return is a $lb(..) of the same info as the output args of orxfrm, andxfrm
	n t,n,v,c
	i op="&" d andxfrm(log,.t,.n,.v,.c) QUIT $lb(t,n,v,c) ; when called from orxfrm
	i op="!" d orxfrm(log,.t,.n,.v,.c) QUIT $lb(t,n,v,c) ; when called from andxfrm
	i op="=" s n=$s($e($$$mtV($p(ptln,"^",4)))="f":$p(ptln,"^",5),1:$p(ptln,"^",4)) QUIT $lb("c",0,n,1)
	QUIT:op="INSET" $lb("ds",0,$p(ptln,"^",5),$$getsize(ptln,log)) // PVA232: getsize, JSL5032 - log parameter
	i op="IN" s n=$$$newval("v^SET:SETOF^,^"_$p(ptln,"^",5,*),1) QUIT $lb("ss",0,n,$l($p(ptln,"^",6,*),"^"))  ; modified by JLF139
	QUIT:op="NULL" $lb("n",1,log,1)
	QUIT:"'='[']'<'>%STARTSWITH"[op $lb("r",0,log,"")
	QUIT:op="'NULL" $lb("nn",0,log,"")
	$$$Abort ; nothing else should ever happen here, unless bug in ornl.
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
compare(con,op,con2)  ;  verify (now or at run-time) that `con-op-con2'
	#;  if both are =constant conditions, compare now
	#; JLF065
	set:op="="&&($e(v3)="t")&&($e(v)'="t") $p(ptv(a),"^",$$$PTVRANGEINFO)=xb
	Set val=$$$newlog("v^"_op_"^,^"_con_"^"_con2_"^") s $$$mtStreamlessConds(m)=$G($$$mtStreamlessConds(m))_val_","
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA021: introduce fldcon variable, quit if whole result empty
class	n fldcon ; used as memory across fldcon, incon calls, so new'ed here
	QUIT:$g($$$mtEmpty($p(ptv(cls),"^",$$$PTVQB)))   ; skip if whole WHERE clause of this query is known false.
	s list=$p(ptv(cls),"^",$$$PTVRANGEINFO),clst=$p(ptv(cls),"^",$$$PTVVALSINCLASS),k=$l(clst,",")-1,m=$p(ptv(cls),"^",$$$PTVQB)
	#; PVA021: Move call to equiv before fldcon, and call for all classes (with k>2). Previous logic 
	#;     missed both opportunities for index usage in temp algs and oppotunities to skip testing
	#;     some conditions. Add comment about "n" type classes.
	d:k>2 equiv ; If we could be sure the optimizer could handle it well, it would be more elegant
	     ; in the case of type="c" to REMOVE all equalities between class members as redundant; 
	#; type="n" classes not considered here because they are incompatible with any equality producing 
	#; an equivalence. This is detected in conds. 
	n ci	// DPV1748=
	i $p(ptv(cls),"^",$$$PTVCONTYPE)="c" f ci=1:1:k s fval=$p(clst,",",ci) d:"f"=$$$mtVType($$$mtV(fval)) fldcon
	#; PVA021: Undo MRP557 which erroneously prevented replications of %STARTSWITH conditions.
	i $p(ptv(cls),"^",$$$PTVCONTYPE)="r",k>1 f li=2:1 s con=$p(list,",",li) q:'con  d range
	i $p(ptv(cls),"^",$$$PTVCONTYPE)="i" f ci=1:1:k s fval=$p(clst,",",ci) d:"f"=$$$mtVType($$$mtV(fval)) incon
	#; PVA084: Handle TOP range replication when main class type is not "r"
	i $p(ptv(cls),"^",$$$PTVTOPINFO)]"",k>1 s list=$p(ptv(cls),"^",$$$PTVTOPINFO),li=2,con=$p(list,",",li) d range
	QUIT
	#; PVA021: Add new tags: incon, impincon
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
incon	;  a IN type CON applies to the equivalence-class of this field
	; Add a ONEOF condition for the field if it doesn't have one (assumed exactly one left by 
	; analysis in conds).
	i $$$mtLOperand1($$$mtL($p(list,",",3)))'=fval { d nulog("v^ONEOF^,"_fval_","_"^"_fval_"^"_+list_"^"_$s($d(rtpcHelperCode("caller")):$p($$$mtL($p(list,",",3)),"^",6),1:"")) s $p(ptl,"^",log)="c" }
	else { s log=$p(list,",",3) }
	#; remember these ONEOF conditions for building ptres entries.
	s fldcon(fval)=log
	#; Generate ptres implications for each distinct pair of fields.
	f li=1:1:ci-1 s val2=$p(clst,",",li) d:"f"=$$$mtVType($$$mtV(val2)) impincon
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
impincon ; Add two implications for a pair of fields: (f1 in s, f1=f2) -> f2 in s,
	#;   (f2 in s, f1=f2) -> f1 in s
	s l1=log,l2=fldcon(val2),l3=ptv(fval,val2),ptres(l1,","_$S(l2<l3:l2_","_l3,1:l3_","_l2)_",")="",ptres(l2,","_$S(l1<l3:l1_","_l3,1:l3_","_l1)_",")=""
	s seladj(l3,","_$s(l1<l2:l1_","_l2,1:l2_","_l1)_",")=l2 // PVA279: shouldn't matter which we adjust by
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA021: handle that a CON may be an IN condition now, and that IN conditions may be
	#;         type "c" IN ptl.
fldcon	;  an equality CON applies to the equivalence-class of this field
	s logs=$p(ptv(fval),"^",$$$PTVLOGREFS),val=0
	  #;  add CON to this field if needed, remove if two exist
	  #;    We need to check that a "c" in ptl is an = because there could be obsolete IN conditions recorded now.
	#; DPV1693
	n cocflag s cocflag=0
	f li=1:1 {
		s log=$p(logs,",",li) q:'log  
		i "c"=$p(ptl,"^",log),$$$mtLOperator($$$mtL(log))="=" { 
			i val { d remove(val,"i^pushtoC"):val s:$lf($g($$$mtWhereCheckOption),val) cocflag=1 } 
			s val=log,$$$mtLOperand2($$$mtL(log))=list 
		}
	}
	If 'val {
		d nulog("v^=^,"_fval_",^"_fval_"^"_list_"^") s $p(ptl,"^",log)="c"
		s:cocflag $$$mtWhereCheckOption=$$$mtWhereCheckOption_$lb(log)
	}
	Else { s log=val }
	#; DPV1693-
	#; PVA021: previously, no code below commoent beginning with "***". Relevant code added.
	#;  *** add const=expr, and all possible ptres; For now just add 2 types of ptres - const=expr not useful now
	#;     and not necessary.
	s fldcon(fval)=log ; so we can find this easily in impfldcon
	f li=1:1:ci-1 s val2=$p(clst,",",li) d:"f"=$$$mtVType($$$mtV(val2)) impfldcon
	QUIT
	#; PVA021: Add new tag impfldcon
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
impfldcon ; Add two types of implication for fld=const to ptres: (f1=c,f1=f2)==>(f2=c) (2 of these) and (f1=c,f2=c)==>(f1=f2)
	s l1=log,l2=fldcon(val2),l3=ptv(fval,val2)
	s ptres(l1,","_$S(l2<l3:l2_","_l3,1:l3_","_l2)_",")="",ptres(l2,","_$S(l1<l3:l1_","_l3,1:l3_","_l1)_",")="",ptres(l3,","_$S(l1<l2:l1_","_l2,1:l2_","_l1)_",")=""
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
equiv	f v1=1:1:k-1 s val1=$p(clst,",",v1) f v2=v1+1:1:k   s val2=$p(clst,",",v2) d:'$g(ptv(val1,val2)) nueq
	f v1=1:1:k-2 s val1=$p(clst,",",v1) f v2=v1+1:1:k-1 s val2=$p(clst,",",v2) f v3=v2+1:1:k s val3=$p(clst,",",v3) d impeq
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nueq	;  if field=val1, field=val2 then add the condition val1=val2
	d nulog("v^=^,"_$$lflds("v",val1_"^"_val2)_"^"_$S("f"=$$$mtVType($$$mtV(val1)):val1_"^"_val2,1:val2_"^"_val1)_"^")
	s (ptv(val1,val2),ptv(val2,val1))=log,type=$$$mtVType($$$mtV(val1))_$$$mtVType($$$mtV(val2))
	s $p(ptl,"^",log)=$s(type'["f":"m",type'="ff":"x",$p($$$mtV(val1),"^",2)=$p($$$mtV(val2),"^",2):"f",1:"j")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
impeq	;  add 3 implications `{A=B, B=C} ==> A=C' to ptres
	s l1=ptv(val1,val2),l2=ptv(val1,val3),l3=ptv(val2,val3),ptres(l1,","_$S(l2<l3:l2_","_l3,1:l3_","_l2)_",")="",ptres(l2,","_$S(l1<l3:l1_","_l3,1:l3_","_l1)_",")="",ptres(l3,","_$S(l1<l2:l1_","_l2,1:l2_","_l1)_",")=""
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
range	;  no comparison, only see that no duplication
	s op=$p(con,$c(1),2),con=$p(con,$c(1),3)
	QUIT:$p(list,",",2,li)[($c(1)_op_$c(1)_con_",")
	f v1=1:1:k   s val1=$p(clst,",",v1) d:'$g(range(val1_"^"_op_"^"_con)) nurng
	f v1=1:1:k-1 s val1=$p(clst,",",v1) f v2=v1+1:1:k s val2=$p(clst,",",v2) d imprng
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nurng	;  if field=val1, field<con then add the condition val1<con
	s v=$$$mtV(val1)
	d nulog("v^"_op_"^"_$S("f"=$e(v):","_val1_",",1:$p(v,"^",3))_"^"_val1_"^"_con_"^")
	s range(val1_"^"_op_"^"_con)=log,$p(ptl,"^",log)=$S("f"=$e(v):"r",1:"m")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
imprng	;  add 2 implications `{A=B, RANGE(A)} ==> RANGE(B)' to ptres
	s l1=range(val1_"^"_op_"^"_con),l2=range(val2_"^"_op_"^"_con),l3=ptv(val1,val2),ptres(l1,","_$S(l2<l3:l2_","_l3,1:l3_","_l2)_",")="",ptres(l2,","_$S(l1<l3:l1_","_l3,1:l3_","_l1)_",")=""
	s seladj(l3,","_$s(l1<l2:l1_","_l2,1:l2_","_l1)_",")=l2 // PVA279: shouldn't matter which we adjust by
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA021: Factor nulog into nulog and addlog, used by nulog and also separately.
nulog(v) 
	Set val=$$$newlog(v)
	Do addlog(val) 
	QUIT  ;  add condition v
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
addlog(val) ;  add log# to mt("w"), ptv; set log as side effect.
	#; JLF017
	s vals=$$$mtLColVals($$$mtL(val)),$$$mtWhere(m)=$g($$$mtWhere(m))_val_"^",log=val
	f pi=2:1 s val=$p(vals,",",pi) q:val=""  d aptv(val,$$$PTVLOGREFS,log_",")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK683
adwlog(m,val) s $$$mtWhere(m)=$g($$$mtWhere(m))_val_"^"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK683-
	#;  append stuff to piece pn of ptv(val)
aptv(val,pn,stuff) s $p(ptv(val),"^",pn)=$p(ptv(val),"^",pn)_stuff QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
remove(log,istr)  ;  remove a single log from mt("w")
	#;  istr - option string to use to ignore the log; won't ignore if this argument missing 
	#;         THIS STRING SHOULD BEGIN WITH "i". (PVA354)
    #; Be bold and do as requested, no checks.
	s lgi=$l($p("^"_$$$mtWhere(m),"^"_log_"^"),"^"),$p($$$mtWhere(m),"^",lgi,*)=$p($$$mtWhere(m),"^",lgi+1,*)
	if $d(istr) { s $$$mtLType($$$mtL(log))=istr_$$$mtL(log) }
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA021
removec(log) ;  remove a single log from mt("c")
	s lgi=$l($p(","_$$$mtStreamlessConds(m),","_log_","),","),$p($$$mtStreamlessConds(m),",",lgi,*)=$p($$$mtStreamlessConds(m),",",lgi+1,*)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA232: Create getsize
complexlog(m, v) [ mt ] PUBLIC {
	s mt("complexlog",m) = $G(mt("complexlog",m)) _ v _ "^"
}
putcomplexlog(m, v) [ val ] PUBLIC {
	Set val=$$$newlog(v)
	Do complexlog(m, val)
}
.
	#; JSL5032 - add log parameter to store negative log sizes
	#; getsize now returns size, including negative sizes, in mt("logsize",log)
	#; The negative size is used for outlier support for operators that become "ONEOF"
getsize(lv,log) [mt,rtpcHelperCode] PUBLIC
  {  
  	 s sarg=$p(lv,"^",6),lst=$p(lv,"^",5)
     if sarg=""
     {  s sz=5
        if '$d(mt("listsize",lst)) { s mt("listsize",lst)=$s($d(rtpcHelperCode("caller")):"",1:$$$newval("t^"_sz,1)) Set mt("logsize",log)=5 }
     }
     else
     {  s sz=+$p($$$mtV(sarg),"^",2)
     	s szoriginal = sz
     	
     	// JSL5032, additional logic to handle negative sizes
    	if sz=0 
    	{
        	s sz=5
        }
    	elseif sz < 0 
    	{
        	s sz=-sz
    	} 
       	Set $$$mtV(sarg)="t^"_sz 
       	if '$d(mt("listsize",lst)) { s mt("listsize",lst)=sarg}
		Set:'$D(mt("logsize",log)) mt("logsize",log)=szoriginal     	
.
     }
     QUIT sz
  }
  
	#; Confirm that any user-specified UNION %PARALLEL can be performed, remove
	#; the relevant $$$mtDSNConnection/$$$mtUnionTopDSN entries if not.
checkUnionParallel() [ mt, maxm ] PUBLIC {
	//top down order: if we mark a parent as non-%PARALLEL, we need to check its children
	//who now may also need to be non-%PARALLEL
	f mTopo=1:1:maxm {
		s m=mt("qbo",mTopo)
		//ignore non-parallel subqueries
		If '$$isParallel(m) CONTINUE
		Set topm = $g($$$mtUnionTopQb(m))
		If 'topm CONTINUE //ignore non-union
		If $$isParallel(+$$$mtP(topm)) CONTINUE //ignore queries we'll regenerate as part of our parent
		//If there are correlated fields, this can't currently be run in parallel
		If +$$$mtPCorrelatedFields($$$mtP(m)) Do removeUnionParallel(topm)
	}
}
removeUnionParallel(m) [ mt ] PUBLIC {
	Kill $$$mtDSNLinkedTable(m)
	Kill $$$mtUnionTopDSN(m)
	For m2=1:1:$$$mtPNumQbs {
		If $g($$$mtUnionTopQb(m2)) = m,$g($$$mtDSNLinkedTable(m2))=" " Kill $$$mtDSNLinkedTable(m2)
	}
}
#; PVA348: create setLateralRefs,checkTVFArgs,argsToVals
setLateralRefs() [mt,mts] PUBLIC
{  s str="" for
   {  s str=$o($$$mtTvfParams(str),1,arglist) q:str=""
	  continue:arglist=$c(0)
      s bitstrs="",latf=""
      for i=1:1:$ll(arglist)
      {  s argval=$lg(arglist,i) continue:argval=""
         s bitstr=$$strs^%qaqpre2("v",argval,.latf) continue:bitstr=""
         s bitstrs=$bitlogic(bitstrs|bitstr)
      }
      continue:bitstrs=""
      s mts($$$mtRQb($$$mtR(str)),str,"lateral")=$ListFromString($e($$bitopc^%qaqomul(bitstrs),2,*-1))
      s mts($$$mtRQb($$$mtR(str)),str,"lateralf")=latf  ;  lateral fields  ;  AK850
      d setNeededForJoin(latf)
   }
}
#; set every field in $LIST(lf) as 'needed for join' in mts 
#; if it is currently marked as 'not needed for output/join' 
setNeededForJoin(lf) [mt,mts] PUBLIC
{	s p=0 while $listnext(lf,p,f)
	{	s ifn=$p($$$mtV(f),"^",3),str=$p($$$mtV(f),"^",2),m=$$$mtRQb($$$mtR(str))
		s:+mts(m,str,"ATT",ifn)=1 $e(mts(m,str,"ATT",ifn))=2
	}
}
 //Where possible and beneficial, revert %BARS() = <val> conditions created by "BAT" %ID spoofing
 //and note that <val> will require translation before being compared or assigned to the LHS
revertBars() [ mt ] PUBLIC {
	For l=1:1 {
		Set log = $g($$$mtL(l)) QUIT:log=""
		If $e(log,1,3)'="v^=" CONTINUE
		Set lhsV = $p(log,"^",4),lhs=$$$mtV(lhsV)
		Set rhsV = $p(log,"^",5),rhs=$$$mtV(rhsV)
		Set lhsBars = $e(lhs,1,8)="v^%BARS^"
		Set rhsBars = $e(rhs,1,8)="v^%BARS^"
		If lhsBars Set $$$mtLOperand1($$$mtL(l)) = $$revertBar(lhsV)
		If rhsBars Set $$$mtLOperand2($$$mtL(l)) = $$revertBar(rhsV)
		If lhsBars Set mt("barstrans",$$$mtLOperand1($$$mtL(l)))=1
		If rhsBars Set mt("barstrans",$$$mtLOperand2($$$mtL(l)))=1
	} 
}
revertBar(v) [ m,mt,mts ] PUBLIC {
	Set val = $$$mtV(v)
	Set fieldV = $p(val,"^",4) //first one is fine, all from the same stream
	Set field = $$$mtV(fieldV)
	Set str = $p(field,"^",2)
	Set idifn = $p(mts(m,str),"^",5)
	RETURN $$nufld^%qaqpqo(str,idifn)
}
argsToVals(args) [] PUBLIC 
{
	s vals="" for i=1:1:$ll(args) {s:$lg(args,i)]"" vals=vals_$li(args,i)_","}
	quit vals
}
.
#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#; for SELECT ... INTO :ARRAY(), precompute column number in the output arr
#; store in mt("arrcol"), subscripted by select list position
arrcol()[mt,jj] PUBLIC {
	new jj
	set arrcol=""
	if ($$$mtStatementType="DEC"||($$$mtStatementType="SEL"))&&($p($g($$$mtSelectInto),"^")]"") {
		s str = ""
		f jj=1:1:$ll($$$mtAlphaUpAliases(1)) {
			set val=$$realf^%qaqcasl($p($$$mtOutputVals($$$mtOutput(1)),",",jj)),v=$$$mtV(val) 
			i $e(v)="f" { ; in the output array we just put f node.
				s:'str str=$p(v,"^",2) ; we just care about one table (multi tables are not supported for into :array())
				s:str=$p(v,"^",2) $li(arrcol,jj)=$$ddcol^%qaqcasl(val)
			}
		} 	
	}
	return arrcol
}
.
/// Get the total selectivity of the WHERE conditions in query block m
getTotalWHEREselectivity(m) [mt] PUBLIC {
	set totalSeelctivity = 1.0
	// Fetch all conditions in mt("w") and multiply their selectivities
	for i=1:1:$length($get($$$mtWhere(m)),"^")-1 { // WHERE conditions (non-streamless)
		set log=$p($$$mtWhere(m),"^",i)
		CONTINUE:log=""
		set totalSeelctivity = totalSeelctivity * $$GetSel^%qaqomul(log)
	}
	RETURN totalSeelctivity
}
.
error(e) GOTO ^%qaqperr
.
lsq	
	#; n-nodes may point to expressions containing subqueries which
	#; are consequently live.
	if ev="n" d lviter("v",$p(v,"^",4))
	goto:ev'="q" lviterarg
	d marksqs^%qaqpre3($p(v,"^",2))
	QUIT
.
lviterDeriveStreams
	If ev="f",'$lf(streams,$p(v,"^",2)) Set streams = streams _ $lb($p(v,"^",2))
	If first,streams'="" QUIT ; Shortcut if we only care about first stream
	Goto lviterarg
.
checkRTPCNN(curnn,nn) [mt,rtpcTVLogInfo] public { ; YCL472
	RETURN:$$$SQLCompileOption("rtpc-info-queryType")'="" nn ; during utility class generation (Show Plan)
	RETURN:$ll(curnn)=$ll(nn) nn ; same list length, no newly added nn
	new rtpcTVLogInfo
	set res=curnn
	; This is runtime query compilation
	; if we don't have truth value info for this nn condition, don't add this nn
	; otherwise, we add some unnecessary streamless condition which may cause bad plan
	for pos=($ll(curnn)+1):1:$ll(nn) {
		set val=$li(nn,pos),rtpcTVLogInfo=""
		set tvok = $$dfsXprs^%qaqcoutlier(0,$s(%caller["ShowPlan":2,1:0),,val,"CheckTruthValues")
		continue:'tvok
		set hash = $$$Base64SHA($lb("'NULL")_rtpcTVLogInfo,10)
		continue:$g(mt("nRTP","TruthValueInfo",hash),"ignore")="ignore" ; skip if we don't have truth value info for this condition
		set res=res_$lb(val) ; add to return result
	}
	RETURN res
	
}	
.
addPrunePartitions() [ mt ] PUBLIC {
	f m=1:1:$$$mtPNumQbs {
		i $$$mtPQbIsActive(m) {
			s logs=$g($$$mtWhere(m))
			f lgi=1:1:$l(logs,"^")-1{
				s log=$p(logs,"^",lgi)
				d addPrune(logs,log,m)
			}
		}
	}
}
.
addPrune(logs,log,m) [mt] PUBLIC {
	s v=$$$mtL(log),op=$$$mtLOperator(v)
	if (op="!")||(op="&") {
		s llog=$$$mtLOperand1($$$mtL(log)),rlog=$$$mtLOperand2($$$mtL(log))
		d addPrune(logs,llog,m),addPrune(logs,rlog,m)
	}
	return:'((",>,'>,=,'=,'<,<,NULL,'NULL," [ (","_op_",")) && ($l($$$mtLColVals(v),",")=3))
	
	s fpos=$$$mtLColVals(v),lhsloc=$$$mtLOperand1(v),v1=$$$mtV(lhsloc)
	#; swap lhs and rhs, if the field is on the rhs
	if ($p(v1,"^",3)=",") || ($p(v1,"^",3)=""){
		s op=$$flipop(op),$$$mtLOperator($$$mtL(log))=op
		s $p($$$mtL(log),"^",4,5)=$$$mtLOperand2(v)_"^"_lhsloc
		s v=$$$mtL(log),lhsloc=$$$mtLOperand1(v),v1=$$$mtV(lhsloc)
	}
	set rhs=$$$mtLOperand2(v)
	if rhs'=""{
		set pv=$$$mtV($$$mtLOperand2(v))
		return:'(("tx"[$$$mtVType(pv))||(($$$mtVType(pv)="v")&&($$isStreamless^%qaqpre(pv))))
	}
.
	s xpidop=$case(op,">":"'<","<":"'>","NULL":"=","'NULL":"'=",:op)
	s partBy=$$isPartitionedBy(v1) 
	return:partBy=""
	s xpid=$lg(partBy,1)
	s pBy=$lg(partBy,2)
	
	;; cannot prune HASH
	return:$lg(pBy,2)="HASH"
.
	s pkifn=$lg(pBy,1)
	s interval=$lg(pBy,3)
	s mtl=$$$maxl,mtv=$o($$$mtV(""),-1)
	
	s str=$$$mtVFieldQbOrStream(v1),ifn=$$$mtVFieldLabelOrIFN(v1),irn=+$$$mtR(str)
	s xpidifn=$$$smdGetIfn($$$smdTType(irn),irn,"x__partitionid"_xpid)
	s vval=$p(v,"^",5)
.
	;;return:(($lg(pBy,4)'="")&&($$$VTRgetcat(vval)'="STRING"))
.
	s vf = $$nufld^%qaqpqo(str,xpidifn)
	s:vf'=(mtv+1) mtv=mtv-1
.
	d logopt^%qaqpagg("PPRUNE",m)
.
	if ",NULL,'NULL," [ (","_op_","){
		s nv2=$$$newval("t^-10000000000000000000")
		s nl2=$$$newlog("v^"_xpidop_"^,"_vf_",^"_vf_"^"_nv2_"^")
		s nl3=$$$newlog(mt("l",log))
		s mt("l",log)="l^&^^"_nl3_"^"_nl2_"^"
		return
	}
.
	if $lg(pBy,2)="LIST" {
		s nl2=$$$newlog("v^"_xpidop_"^,"_vf_",^"_vf_"^"_vval_"^")
		s nl3=$$$newlog(mt("l",log))
		s mt("l",log)="l^&^^"_nl3_"^"_nl2_"^"
		return
	}
.
	;; RANGE
	if ($lg(pBy,4)'="") {
		;; process DATE/TIME range partition
.
		s nv2=$$$newval("t^mi")
		s nv3=$$$newval("t^1841-01-01 00:00:00")
		s nv4=$$$newval("v^DATEDIFF^^"_nv2_"^"_nv3_"^"_vval_"^")
		s nv5=$$$newval("t^"_interval)
		s nv6=$$$newval("v^#^^"_nv4_"^"_nv5_"^")
		s nv7=$$$newval("v^-^^"_nv4_"^"_nv6_"^")
		s nv8=$$$newval("v^DATEADD^^"_nv2_"^"_nv7_"^"_nv3_"^")
.
		s parts=$lb( ;; "+SUBSTR(string,"_$lg(part,2)_","_$lg(part,3)_")*"_$lg(part,4)
					$lb("YEAR",1,4,100000000,"yy"),
					$lb("MONTH",6,2,1000000,"mm"),
					$lb("DAY",9,2,10000,"dd"),						
					$lb("HOUR",12,2,100,"hh"),						
					$lb("MINUTE",15,2,1,"mi")
				)
		s nextv=nv8
		f i=1:1:$ll(parts) {
			s part=$lg(parts,i)
.
			s nextv=$i(nextv),mt("v",nextv)="t^"_$lg(part,2)
			s nextv=$i(nextv),mt("v",nextv)="t^"_$lg(part,3)
			s nextv=$i(nextv),mt("v",nextv)="v^SUBSTR^,^"_nv8_"^"_(nextv-2)_"^"_(nextv-1)_"^"
			s nextv=$i(nextv),mt("v",nextv)="t^"_$lg(part,4)
			s nextv=$i(nextv),mt("v",nextv)="v^*^,^"_(nextv-2)_"^"_(nextv-1)_"^"
.
			s:i>1 nextv=$i(nextv),mt("v",nextv)="v^+^,^"_(res)_"^"_(nextv-1)_"^"
			s res=nextv
.
			q:$lg(part,1)=$lg(pBy,4)
		}
		if (i<3) {
			s ff=$s(i=1:"t^1010000",1:"t^10000")
			s nextv=$i(nextv),mt("v",nextv)=ff
			s nextv=$i(nextv),mt("v",nextv)="v^+^,^"_(res)_"^"_(nextv-1)_"^"
			s res=nextv
		}
		s mt("v",nv2)="t^"_$lg(part,5)
.
		s nl1=$$$newlog("v^"_xpidop_"^,"_(vf)_",^"_(vf)_"^"_(res)_"^")
		s nl2=$$$newlog(mt("l",log))
		s mt("l",log)="l^&^^"_nl2_"^"_nl1_"^"
.
.
		;; s poslog=$l($p("^"_$g(mt("w",m)),"^"_log_"^"))+1
		;; s $e(mt("w",m),poslog,poslog+$l(log))=(mtl+2)_"^"
.
	} else {
		;; process partition key for numeric range
.
		s nv2=$$$newval("t^0")
		s nl1=$$$newlog("v^'<^,^"_vval_"^"_nv2_"^")
		s nv3=$$$newval("l^L2V^,^"_nl1_"^")
		
		s nv4=$$$newval("t^"_interval)
		s nv5=$$$newval("v^\^,^"_vval_"^"_nv4_"^")
		s nv6=$$$newval("v^-^,^"_nv4_"^"_vval_"^")
		s nv7=$$$newval("v^\^,^"_nv6_"^"_nv4_"^")
		s nv8=$$$newval("v^*^,^"_nv7_"^"_nv4_"^")
		s nv9=$$$newval("v^+^,^"_vval_"^"_nv8_"^")
		s nv10=$$$newval("v^\^,^"_nv9_"^"_nv4_"^")
		s nv11=$$$newval("v^-^,^"_nv10_"^"_nv7_"^")
		s nv12=$$$newval("v^CASE^,^"_nv3_"^"_nv5_"^"_nv11_"^")
.
		s nl2=$$$newlog("v^"_xpidop_"^,"_vf_",^"_vf_"^"_nv12_"^")
		s nl3=$$$newlog(mt("l",log))
		s mt("l",log)="l^&^^"_nl3_"^"_nl2_"^"
.
		;; s poslog=$l($p("^"_$g(mt("w",m)),"^"_log_"^"))+1
		;; s $e(mt("w",m),poslog,poslog+$l(log))=nl3_"^"
	}
}
.
isPartitionedBy(v1) [mt] PUBLIC {
	return:$$$mtVType(v1)'="f" ""
	s str=$$$mtVFieldQbOrStream(v1),ifn=$$$mtVFieldLabelOrIFN(v1),irn=+$$$mtR(str)
	return:'$$$smdPartitioned(1,irn) ""
	s pBy=$$$smdPartitionKey(1,irn)
	f i=1:1:$ll(pBy) {
		return:($lg($lg(pBy,i),1)=ifn)&&($lg($lg(pBy,i),2)'="HASH") $lb(i,$lg(pBy,i))
	}
	return ""
}
