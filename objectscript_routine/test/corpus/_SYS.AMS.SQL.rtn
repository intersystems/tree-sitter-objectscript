%SYS.AMS.SQL^MAC^^^0
	;%SYS.AMS.SQL.MAC
	;; COMPONENTS :: SQL/Runtime
	#;
	
#INCLUDE %msql
.
#DEFINE AMSSQLDebugPermGlo ^IRIS.Debug.AMS
#DEF1ARG AMSSQLDebugPerm(%params) $$$AMSSQLDebugPermGlo(%params)
#DEFINE bumpAMSSQLDebugPermID $i($$$AMSSQLDebugPerm(0))
.
#DEF1ARG AMSSQLDebugPermInfo(%params) $$$AMSSQLDebugPerm(0,%params)
#DEF1ARG bumpAMSSQLDebugPermInfoID(%params) $i($$$AMSSQLDebugPermInfo(%params))
.
.
#IF 0   ;--------------------------------------------------------------------------------
	; Description:    System Helper Methods related to:
	;                 Application Metadata Stack (AMS) for the SQL application 
	;                 (ApplicationID="%SQL" [WHERE "%SQL"=$$$AMSApplicationIDSQL])
	; Author:         Michael Pantaleo
	; Date Started:   05/10/2023
	; Maintenance History: [XXXnnn (MM/DD/YY) - Description]
	;                      [ONLY Add the DevChage/JIRA that creates & relates to this routine]
	;
	;  MRP1336 (04/24/2023) - [DP-422553] Provide debugging tools for processing the Application Metadata Stack (AMS) within the '%SYS.AppMetadataStack.SQL' class
	;
	;--------------------------------------------------------------------------------
	;                             I N F O R M A T I O N
	;--------------------------------------------------------------------------------
	; 
	; This routine contains System Helper methods that are used by the Application 
	; Metadata Stack (AMS) (for the SQL application), contained within the
	; '%SYS.AppMetadataStack.SQL.CLS' class, to perform the following tasks:
	;
	;   DEBUGGING
	;   ---------
	;   The SQL Application Metadata Stack - Debugging Tool (AMS-DT) collects
	;   the information arrays { amsInfo(...) | amsParent(...) | amsChildren(...) | 
	;   amsTree(...) } at different processing stages during the invocation of the
	;   '##class(%SYS.AppMetadataStack.SQL).GetStackInfo(...)' method (and its
	;   helper methods), and stores this information in the following global that
	;   is mapped to the 'IRISTEMP' namespace, which ensures that this data gets
	;   deleted whenever the IRIS instance is shutdown:
	;
	;     $$$AMSSQLDebugInfo(amsDebugID)  =>  ^IRIS.Temp.AMS(0,amsDebugID)
	;
	;   If it's necessary to persist the debugging data indefinitely, then the
	;   following two methods can be used to permanently save the data for future
	;   processing, and to restore the data to perform appropriate analysis and
	;   debugging when necessary:
	;
	;     - saveSQLAMSDebugArrays(...)
	;     - restoreSQLAMSDebugArrays(...)
	;
	;     $$$AMSSQLDebugPermInfo(amsDebugID)  =>  ^IRIS.Debug.AMS(0,amsDebugID)
	;
	;   The following is a list of all available methods that can be used with
	;   the SQL Application Metadata Stack - Debugging Tool (AMS-DT):
	;
	;     - setSQLAMSDebug(...)        
	;     - getSQLAMSDebug(...)
	;
	;     - clearSQLAMSDebug(...)
	;     - getSQLAMSDebugArrays(...)
	;     - populateSQLAMSDebugArrays(...)
	;     - validateSQLAMSDebugArrays(...)
	;     - showSQLAMSDebugArrays(...)
	;
	;     - saveSQLAMSDebugArrays(...)
	;     - restoreSQLAMSDebugArrays(...)
	;
	;     - versionSQLAMSDebug()
	;
	;
	;     EXAMPLE
	;     -------
	;     The SQL Application Metadata Stack - Debugging Tool (AMS-DT) can be used
	;     in the following way to debug a UnitTest that invokes the following method
	;     either directly or indirectly via a SQL Statement invocation against the
	;     'INFORMATION_SCHEMA.CURRENT_STATEMENTS' table, which invokes this method
	;     to populate the 'amsInfo(...)' array used as its data ResultSet:
	;
	;        ##class(%SYS.AppMetadataStack.SQL).GetStackInfo(...)
	;
	;     0) Before invoking the UnitTest, perform the following tasks:
	;
	;     1) Clear any data collected and stored in the AMS-DT global:
	;          USER>set tSC=$$clearSQLAMSDebug^%SYS.AMS.SQL()
	;
	;     2) Enable the AMS-DT collection:
	;          USER>set tSC=$$setSQLAMSDebug^%SYS.AMS.SQL(1,.oldAMSDebug1)
	;
	;     3) Invoke the UnitTest to collect AMS-DT Debugging data:
	;          USER>set tSC=##class(%UnitTest.Manager).DebugLoadTestSuite("SQL/ProcessViewer")
	;          USER>set tSC=##class(%UnitTest.Manager).DebugRunTestCase("SQL/ProcessViewer",,,"TestStatementParallel")
	;
	;     4) Disable the AMS-DT collection:
	;          USER>set tSC=$$setSQLAMSDebug^%SYS.AMS.SQL(0,.oldAMSDebug2)
	;
	;     5) Determine which invocation to the 'GetStackInfo(...)' method
	;        to further debug and analyze:
	;          USER>set tSC=$$showSQLAMSDebugArrays^%SYS.AMS.SQL()
	;
	;     6) After determining the correct 'amsDebugID' to further debug and
	;        analyze, ensure that the data arrays collection are valid:
	;          USER>set amsDebugID=??  (e.g. set amsDebugID=1)
	;          USER>set tSC=$$validateSQLAMSDebugArrays^%SYS.AMS.SQL(amsDebugID)
	;
	;     7) Analyze and debug the population of the AMS-DT information arrays
	;        'amsInfo(...)', 'amsParent(...)', and 'amsChildrent(...)' by stepping
	;        through the code at each BREAK point:
	;          USER>set tSC=$$populateSQLAMSDebugArrays^%SYS.AMS.SQL(amsDebugID)
	;
#ENDIF  ;--------------------------------------------------------------------------------
	$$$Abort  ;  Not an Entry Point!!
	QUIT
 	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
.
	#;--------------------------------------------------------------------------------
	#;          S E T / G E T   S Q L   A M S  - D E B U G G I N G   T O O L          
	#;           C O N F I G U R A T I O N   S E T T I N G   M E T H O D S                   
	#;--------------------------------------------------------------------------------
	#; The following methods are used to set/get the SQL Application Metadata Stack -
	#; Debugging Tool (AMS-DT) Configuration Settings:
	#;
	#;   - setSQLAMSDebug(...)   // Set the Collection Configuration Setting for the AMS-DT
	#;   - getSQLAMSDebug(...)   // Get the Collection Configuration Setting for the AMS-DT
	#;
	#;   - setSQLAMSBreak(...)   // Set the BREAK Configuration Setting for the AMS-DT
	#;   - getSQLAMSBreak(...)   // Get the BREAK Configuration Setting for the AMS-DT
	#;
	#;----------------------------------------------------------------------------------
.
	#; MRP1336 [Created the Application Metadata Stack - Debugging Tool (AMS-DT)]
	#; MRP1339 [Enhanced the Application Metadata Stack - Debugging Tool (AMS-DT) for processing Sharded Queries]
	#; MRP1340 [Fixed workaround to resolve 'SQL Process Viewer' bugs caused by APE/Sharding code not setting all CQ definition info]
	#; MRP1404 [Enhance the Application Metadata Stack - Debugging Tool (AMS-DT) by enabling process BREAKing in core modules]
.
/// -------------------------------------------------------------------------------
/// Method:       setSQLAMSDebug
/// Description:  Set (Enabled/Disabled) the Collection Configuration Setting
///               for the SQL Application Metadata Stack - Debugging Tool (AMS-DT)
///               which collects the information arrays 'ams*(...)' at different 
///               processing stages during the invocation of the 'GetStackInfo(...)'
///               method (and its helper methods) within the 
///               '%SYS.AppMetadataStack.SQL' class...
/// 
/// Notes:        InterSystems INTERNAL USE ONLY. DO NOT DOCUMENT!
///               This setting in on a per system basis.
///               The default of the AMS-DT setting is 'disabled'.
/// 
/// Invocation:   This method can be invoked in the following ways:
///                  ObjectScript: $$setSQLAMSDebug^%SYS.AMS.SQL(...)
///                           SQL: N/A
///
/// Examples:     The following examples shows the use of this method:
/// 
///    #1         Enable the SQL Application Metadata Stack - Debugging
///               Tool (AMS-DT) Collection Configuration Setting:
/// 
///               set tSC=$$setSQLAMSDebug^%SYS.AMS.SQL(1,.oldDebugVal)
///
///    #2         Reset the SQL Application Metadata Stack - Debugging
///               Tool (AMS-DT) Collection Configuration Setting from 
///               Example #1:
/// 
///               set tSC=$$setSQLAMSDebug^%SYS.AMS.SQL(oldDebugVal)
///
/// Data Storage: ^%SYS("sql","ams","debug")
///
/// Parameters:
///    flag      - A flag to determine whether or not to enabled/disabled
///                the SQL Application Metadata Stack - Debugging Tool (AMS-DT)
///                Collection Configuration Setting
///                  0 = Disabled  [DEFAULT]
///                  1 = Enabled
///    oldVal    - A Pass By Reference (PBR) parameter to returns the old
///                setting
///    
/// RETURN Value: The status of this method's invocation
/// -------------------------------------------------------------------------------
///
setSQLAMSDebug(flag,oldVal) [] PUBLIC {
	set oldVal=$$$DebugSQLAMS
	set:'oldVal&&(flag=1) $$$AMSSQLDebugFlagGlo=1
	kill:'flag&&oldVal $$$AMSSQLDebugFlagGlo  // Remove this global unless it's set!
	
	RETURN $CASE(flag,0:$$$OK,1:$$$OK,:$$$ERROR($$$GeneralError,"The 'flag' parameter must be one of the following values: 0 | 1"))
}
.
/// -------------------------------------------------------------------------------
/// Method:       getSQLAMSDebug
/// Description:  Get the Collection Configuration Setting for the SQL
///               Application Metadata Stack - Debugging Tool (AMS-DT)...
/// 
/// Note:         InterSystems INTERNAL USE ONLY. DO NOT DOCUMENT!
/// 
/// Invocation:   This method can be invoked in the following ways:
///                  ObjectScript: $$getSQLAMSDebug^%SYS.AMS.SQL(...)
///                           SQL: N/A
///
/// Examples:     The following example shows the use of this method:
/// 
///    #1         Get the SQL Application Metadata Stack - Debugging
///               Tool (AMS-DT) Collection Configuration Setting:
/// 
///               set amsDebugFlag=$$getSQLAMSDebug^%SYS.AMS.SQL()
///
/// Data Storage: ^%SYS("sql","ams","debug")
///
/// Parameters:
///    N/A
///    
/// RETURN Value: The Collection Configuration Setting for the SQL
///               Application Metadata Stack - Debugging Tool (AMS-DT):
///                  0 = Disabled
///                  1 = Enabled
/// -------------------------------------------------------------------------------
///
getSQLAMSDebug() [] PUBLIC {
	RETURN $$$DebugSQLAMS
}
.
/// -------------------------------------------------------------------------------
/// Method:       setSQLAMSBreak
/// Description:  Set (Enabled/Disabled) the BREAK Configuration Setting
///               for the SQL Application Metadata Stack - Debugging Tool (AMS-DT)
///               which controls BREAKing at different processing stages
///               during the invocation of the 'GetStackInfo(...)'
///               method (and its helper methods) within the 
///               '%SYS.AppMetadataStack.SQL' class...
/// 
/// Notes:        InterSystems INTERNAL USE ONLY. DO NOT DOCUMENT!
///               This setting in on a per system basis.
///               The default of the AMS-DT setting is 'disabled'.
/// 
/// Invocation:   This method can be invoked in the following ways:
///                  ObjectScript: $$setSQLAMSBreak^%SYS.AMS.SQL(...)
///                           SQL: N/A
///
/// Examples:     The following examples shows the use of this method:
/// 
///    #1         Enable the SQL Application Metadata Stack - Debugging
///               Tool (AMS-DT) BREAK Configuration Setting for the
///               following break-point locations:
///                  1.1  - BREAK within the 'GetStackInfo' method before
///                         the collection of AMS Information
///                  1.2  - BREAK within the 'GetStackInfo' method before
///                         performing any
/// 
///               set tSC=$$setSQLAMSBreak^%SYS.AMS.SQL("1.1,1.2",.oldBreakVal)
///                  OR
///               set tSC=$$setSQLAMSBreak^%SYS.AMS.SQL($LB(1.1,1.2),.oldBreakVal)
///
///    #2         Reset the SQL Application Metadata Stack - Debugging
///               Tool (AMS-DT) BREAK Configuration Setting from 
///               Example #1:
/// 
///               set tSC=$$setSQLAMSBreak^%SYS.AMS.SQL(oldBreakVal)
///
/// Data Storage: ^%SYS("sql","ams","break")
///
/// Parameters:
///    flag      - A flag to determine whether to BREAK at specific locations while
///                processing the Application Metadata Stack (AMS), specified either
///                as a comma-delimited string or a $LIST(...) of the following
///                values:
///                  0|"" - Don't BREAK while processing the Application Metadata Stack  [DEFAULT: ""]
///                  1.1  - BREAK within the 'GetStackInfo' method before the collection
///                         of AMS Information
///                  1.2  - BREAK within the 'GetStackInfo' method before performing any
///                         AMS Post-Processing
///                  2.1  - BREAK within the 'ProcessStackInfo' method before processing
///                         all PIDs on the system
///                  3.1  - BREAK within the 'populateSPCInfo' method before instantiating
///                         the Parent & Children 'variables': pGroupID & sGroupID*
///                  3.2  - BREAK within the 'populateSPCInfo' method before instantiating
///                         the Parent & Children 'arrays': amsParent(...) & amsChildren(...)
///    oldVal    - A Pass By Reference (PBR) parameter to returns the old setting
///    
/// RETURN Value: The status of this method's invocation
/// -------------------------------------------------------------------------------
///
setSQLAMSBreak(flag,oldVal) [] PUBLIC {
	
	set oldVal=$$$BreakSQLAMS
	set:'$LV(flag) flag=$LFS(flag)
	set:$LF($LB($LB(0),$LB("0")),flag) flag=""
	
	for pos=1:1:$LL(flag) { // --- Validate All 'flag' Values ---
		set val=$LG(flag,pos)
		RETURN:'$LF($LB(0,1.1,1.2,2.1,3.1,3.2),val) $$$ERROR($$$GeneralError,"The 'flag' parameter contains a value ("_val_") that's not one of the following valid values: 0,1.1,1.2,2.1,3.1,3.2")
	}
	
	set:flag'="" $$$AMSSQLBreakFlagGlo=flag
	kill:flag="" $$$AMSSQLBreakFlagGlo       // Remove this global unless it's set!
	
	RETURN $$$OK
}
.
/// -------------------------------------------------------------------------------
/// Method:       getSQLAMSBreak
/// Description:  Get the BREAK Configuration Setting for the SQL
///               Application Metadata Stack - Debugging Tool (AMS-DT)...
/// 
/// Note:         InterSystems INTERNAL USE ONLY. DO NOT DOCUMENT!
/// 
/// Invocation:   This method can be invoked in the following ways:
///                  ObjectScript: $$getSQLAMSBreak^%SYS.AMS.SQL(...)
///                           SQL: N/A
///
/// Examples:     The following example shows the use of this method:
/// 
///    #1         Get the SQL Application Metadata Stack - Debugging
///               Tool (AMS-DT) BREAK Configuration Setting:
/// 
///               set amsDebugFlag=$$getSQLAMSBreak^%SYS.AMS.SQL()
///
/// Data Storage: ^%SYS("sql","ams","break")
///
/// Parameters:
///    N/A
///    
/// RETURN Value: The BREAK Configuration Setting for the SQL Application Metadata
///               Stack - Debugging Tool (AMS-DT), as a $LIST(...) of the following
///               values:
///                  0|"" - Don't BREAK while processing the Application Metadata Stack
///                  1.1  - BREAK within the 'GetStackInfo' method before the collection
///                         of AMS Information
///                  1.2  - BREAK within the 'GetStackInfo' method before performing any
///                         AMS Post-Processing
///                  2.1  - BREAK within the 'ProcessStackInfo' method before processing
///                         all PIDs on the system
///                  3.1  - BREAK within the 'populateSPCInfo' method before instantiating
///                         the Parent & Children 'variables': pGroupID & sGroupID*
///                  3.2  - BREAK within the 'populateSPCInfo' method before instantiating
///                         the Parent & Children 'arrays': amsParent(...) & amsChildren(...)
/// -------------------------------------------------------------------------------
///
getSQLAMSBreak() [] PUBLIC {
	RETURN $$$BreakSQLAMS
}
.
.
	#;--------------------------------------------------------------------------------
	#;                 S Q L   A M S  -  D E B U G G I N G   T O O L                  
	#;                      P R O C E S S I N G   M E T H O D S        
	#;--------------------------------------------------------------------------------
	#; The following methods are used to process the SQL Application Metadata Stack -
	#; Debugging Tool (AMS-DT):
	#;
	#;   - clearSQLAMSDebug(...)
	#;   - getSQLAMSDebugArrays(...)
	#;   - populateSQLAMSDebugArrays(...)
	#;   - validateSQLAMSDebugArrays(...)
	#;   - showSQLAMSDebugArrays(...)
	#;
	#;----------------------------------------------------------------------------------
.
/// -------------------------------------------------------------------------------
/// Method:       clearSQLAMSDebug
/// Description:  Clear the data collected by the SQL Application Metadata Stack - 
///               Debugging Tool (AMS-DT)...
/// 
/// Note:         InterSystems INTERNAL USE ONLY. DO NOT DOCUMENT!
/// 
/// Invocation:   This method can be invoked in the following ways:
///                  ObjectScript: $$clearSQLAMSDebug^%SYS.AMS.SQL(...)
///                           SQL: N/A
///
/// Examples:     The following examples shows the use of this method:
/// 
///    #1         Clear the SQL Application Metadata Stack - Debugging
///               Tool (AMS-DT) data collected for a specific 'amsDebugID':
/// 
///               set tSC=$$clearSQLAMSDebug^%SYS.AMS.SQL(1)
///
///    #2         Clear ALL data collected by SQL Application Metadata Stack - 
///               Debugging Tool (AMS-DT):
/// 
///               set tSC=$$clearSQLAMSDebug^%SYS.AMS.SQL()
///
/// Data Storage: ^IRIS.Temp.AMS(0,amsDebugID,...)
///
/// Parameters:
///    amsDebugID  - If specified, then clear the AMS-DT data collected for
///                  this specific invocation of the 'GetStackInfo(...)' method;
///                  Otherwise, if not specified, then clear all AMS-DT
///                  data
///    tempPerm    - A flag to determine whether to delete the temporary global
///                  or the permanent global where the AMS-DT data is stored
///                    0 = Temporary Global                                        [DEFAULT: 0]
///                    1 = Permanent Global
///                         [Created via the saveSQLAMSDebugArrays(...) method]
///    
/// RETURN Value: The status of this method's invocation
/// -------------------------------------------------------------------------------
///
clearSQLAMSDebug(amsDebugID, tempPerm = 0) [] PUBLIC {
	if +$g(amsDebugID) { // --- Kill Specific AMS-DT Debugging Information ---
		if 'tempPerm { // --- Temporary Global ---
			kill $$$AMSSQLDebugInfo(amsDebugID)
			kill:$o($$$AMSSQLDebugInfo(""))="" $$$AMSSQLDebug(0)
		}
		else { // --- Permanent Global ---
			kill $$$AMSSQLDebugPermInfo(amsDebugID)
			kill:$o($$$AMSSQLDebugPermInfo(""))="" $$$AMSSQLDebugPerm(0)
		}
	}
	else { // --- Kill All AMS-DT Debugging Information ---
		if 'tempPerm { kill $$$AMSSQLDebugGlo }  // Temporary Global!
		else { kill $$$AMSSQLDebugPermGlo }      // Permanent Global!
	}
	RETURN $$$OK
}
.
.
/// -------------------------------------------------------------------------------
/// Method:       getSQLAMSDebugArrays
/// Description:  Get the information arrays 'ams*(...)' collected by the SQL 
///               Application Metadata Stack - Debugging Tool (AMS-DT)...
/// 
/// Note:         InterSystems INTERNAL USE ONLY. DO NOT DOCUMENT!
/// 
/// Invocation:   This method can be invoked in the following ways:
///                  ObjectScript: $$getSQLAMSDebugArrays^%SYS.AMS.SQL(...)
///                           SQL: N/A
///
/// Examples:     The following examples shows the use of this method:
/// 
///    #1         Get the SQL Application Metadata Stack - Debugging Tool (AMS-DT)
///               information arrays 'ams*(...)' for a specific 'amsDebugID':
/// 
///               set tSC=$$getSQLAMSDebugArrays^%SYS.AMS.SQL(1,,.amsInfo)
///
///    #2         Get the SQL Application Metadata Stack - Debugging Tool (AMS-DT)
///               information arrays 'ams*(...)' for the last 'amsDebugID'
///               created/collected:
/// 
///               set tSC=$$getSQLAMSDebugArrays^%SYS.AMS.SQL(,,.amsInfo)
///
/// Data Storage: ^IRIS.Temp.AMS(0,amsDebugID,...)
///
/// Parameters:
///    amsDebugID  - If specified, then get the AMS-DT information arrays
///                  collected for this specific invocation of the 
///                  'GetStackInfo(...)' method;
///                  Otherwise, if not specified, then use the last 'amsDebugID'
///                  created during the invocation of the 'GetStackInfo(...)' 
///                  method
///    debugStage  - The processing stage at which the AMS-DT information
///                  arrays are collected:
///                    1 - Immediately after invoking the primary collection
///                        method: ProcessStackInfo(...)
///                    2 - Immediately after invoking the Post-Processing (PP)
///                        of the Parent/Children information: 
///                          normalizeChildrenPP(...)
///                    3 - Immediately after invoking the Post-Processing (PP)
///                        of the Parent/Children information: 
///                          normalizeAPEPP(...)
///                   10 - Immediately after invoking the Post-Processing (PP)    [DEFAULT]
///                        of the Parent/Children information: 
///                          populateSPCInfoPP(...)
///    amsInfo     - A Pass By Reference (PBR) array to be returned with this
///                  specific array information
///    amsParent   - A Pass By Reference (PBR) array to be returned with this
///                  specific array information
///    amsChildren - A Pass By Reference (PBR) array to be returned with this
///                  specific array information
///    amsTree     - A Pass By Reference (PBR) array to be returned with this
///                  specific array information
///    node0       - A Pass By Reference (PBR) array to be returned with this
///                  specific array information
///                  [This information is independent of the 'debugStage' parameter]
///    
/// RETURN Value: The status of this method's invocation
/// -------------------------------------------------------------------------------
///
getSQLAMSDebugArrays(amsDebugID = "", debugStage = 10, &amsInfo, &amsParent, &amsChildren, &amsTree, &node0) [] PUBLIC {
.
	new %objlasterror
	
	set tSC=$$$OK
	kill amsInfo,amsParent,amsChildren,amsTree,node0  // Tabula Rasa!
	
 try {
	set:amsDebugID="" amsDebugID=$o($$$AMSSQLDebugInfo(" "),-1)  // Default to the last one collected!
	if amsDebugID="" { set tSC=$$$ERROR($$$GeneralError,"The 'amsDebugID' parameter must be a valid value: amsDebugID="_$$$quote(amsDebugID)) THROW }
	if '$d($$$AMSSQLDebugInfo(amsDebugID)) { set tSC=$$$ERROR($$$GeneralError,"No AMS-DT data exists for specified 'amsDebugID' value: amsDebugID="_$$$quote(amsDebugID)) THROW }
	set:debugStage="" debugStage=10  // Default to the 'Last' Post-Process (PP) stage of AMS Stack Information processing!
	if ",1,2,3,10,"'[(","_debugStage_",") { set tSC=$$$ERROR($$$GeneralError,"The 'debugStage' parameter must be one of the following values: 1 | 2 | 3 | 10 ") THROW }
	
	set nodeMethod="get"
	
	merge node0=$$$AMSSQLDebugInfo(amsDebugID,nodeMethod,0)
	
	merge amsInfo=$$$AMSSQLDebugInfo(amsDebugID,nodeMethod,debugStage,"amsInfo")
	merge amsParent=$$$AMSSQLDebugInfo(amsDebugID,nodeMethod,debugStage,"amsParent")
	merge amsChildren=$$$AMSSQLDebugInfo(amsDebugID,nodeMethod,debugStage,"amsChildren")
	merge amsTree=$$$AMSSQLDebugInfo(amsDebugID,nodeMethod,debugStage,"amsTree")
 }
 catch {
	set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
 }
	RETURN tSC
}
.
.
/// -------------------------------------------------------------------------------
/// Method:       populateSQLAMSDebugArrays
/// Description:  Populate the information arrays 'ams*(...)' collected by the SQL 
///               Application Metadata Stack - Debugging Tool (AMS-DT).
///               This method differs from the 'getSQLAMSDebugArrays(...)' method,
///               but ultimately should produce the same results.
///               While the 'getSQLAMSDebugArrays(...)' method returns the
///               information arrays 'ams*(...)' collected for a specific 
///               invocation of the 'GetStackInfo(...)' method (amsDebugID),
///               this method re-generates the arrays 'ams*(...)' on-the-fly
///               based on each processes ($JOB) that contain an AMS metadata 
///               string, and re-running all of the helper methods invoked by
///               the 'GetStackInfo(...)' method:
///                  - ProcessStackInfo(...)
///                      - populateSPCInfo(...)
///                  - normalizeChildrenPP(...)
///                  - normalizeAPEPP(...)
///                  - populateSPCInfoPP(...)
/// 
/// Notes:        InterSystems INTERNAL USE ONLY. DO NOT DOCUMENT!
///               Used primarily for debugging each step of the 'GetStackInfo(...)'
///               method, using data previously collected by the AMS-DT
/// 
/// Invocation:   This method can be invoked in the following ways:
///                  ObjectScript: $$populateSQLAMSDebugArrays^%SYS.AMS.SQL(...)
///                           SQL: N/A
///
/// Examples:     The following examples shows the use of this method:
/// 
///    #1         Populate the SQL Application Metadata Stack - Debugging Tool
///               (AMS-DT) information arrays 'ams*(...)' for a specific 
///               'amsDebugID':
/// 
///               set tSC=$$populateSQLAMSDebugArrays^%SYS.AMS.SQL(1,,,.amsInfo)
///
///    #2         Populate the SQL Application Metadata Stack - Debugging Tool
///               (AMS-DT) information arrays 'ams*(...)' for the last
///               'amsDebugID' created/collected:
/// 
///               set tSC=$$populateSQLAMSDebugArrays^%SYS.AMS.SQL(,,,.amsInfo)
///
/// Data Storage: ^IRIS.Temp.AMS(0,amsDebugID,...)
///
/// Parameters:
///    amsDebugID  - If specified, then populate the AMS-DT information arrays
///                  for this specific invocation of the 'GetStackInfo(...)'
///                  method;
///                  Otherwise, if not specified, then use the last 'amsDebugID'
///                  created during the invocation of the 'GetStackInfo(...)' 
///                  method
///    break       - A flag to determine if we should BREAK while processing
///                  this method for debugging purposes:
///                    0 = Don't BREAK while processing this method
///                    1 = BREAK before invoking the primary processing methods
///                    2 = BREAK before invoking all processing methods            [DEFAULT: 2]
///    amsBreak    - A flag to determine whether to BREAK at specific locations while
///                  processing the Application Metadata Stack (AMS), specified either
///                  as a comma-delimited string or a $LIST(...) of the following
///                  values:
///                    0|"" - Don't BREAK while processing the Application Metadata Stack  [DEFAULT: ""]
///                    1.1  - BREAK within the 'GetStackInfo' method before the collection
///                           of AMS Information
///                    1.2  - BREAK within the 'GetStackInfo' method before performing any
///                           AMS Post-Processing
///                    2.1  - BREAK within the 'ProcessStackInfo' method before processing
///                           all PIDs on the system
///                    3.1  - BREAK within the 'populateSPCInfo' method before instantiating
///                           the Parent & Children 'variables': pGroupID & sGroupID*
///                    3.2  - BREAK within the 'populateSPCInfo' method before instantiating
///                           the Parent & Children 'arrays': amsParent(...) & amsChildren(...)
///    amsInfo     - A Pass By Reference (PBR) array to be returned with this
///                  specific array information
///    amsParent   - A Pass By Reference (PBR) array to be returned with this
///                  specific array information
///    amsChildren - A Pass By Reference (PBR) array to be returned with this
///                  specific array information
///    amsTree     - A Pass By Reference (PBR) array to be returned with this
///                  specific array information
///    
/// RETURN Value: The status of this method's invocation
/// -------------------------------------------------------------------------------
///
populateSQLAMSDebugArrays(amsDebugID = "", break = 2, amsBreak = "", &amsInfo, &amsParent, &amsChildren, &amsTree) [] PUBLIC {
	
	new %objlasterror
	
	set tSC=$$$OK
	kill amsInfo,amsParent,amsChildren,amsTree  // Tabula Rasa!
	
 try {
	
	set:amsBreak="" amsBreak=$$$BreakSQLAMS    // AMS-DT: BREAK list (Used for debugging)!
	set:'$LV(amsBreak) amsBreak=$LFS(amsBreak)
	set:$LF($LB($LB(0),$LB("0")),amsBreak) amsBreak=""
	
	set tSC=$$getSQLAMSDebugArrays(.amsDebugID,1,.amsInfoOrig,,,.amsTree) // Retrieve info before the 'First' Post-Process (PP) stage of AMS-DT collection!
	THROW:$$$ISERR(tSC)
	
	set tSC=$$setSQLAMSDebug(0,.oldAMSDebug)  // Disable AMS-DT Debugging Flag!
	
	set tSC=$$generateSQLAMSDebugArrays(.amsInfoOrig,.amsTree,break,amsBreak,.amsInfo,.amsParent,.amsChildren)
	
	break:break  // BREAK after populating AMS-DT arrays: amsInfo(...), amsParent(...), amsChildren(...) & amsTree(...)
 }
 catch {
	set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
 }
 	do:$d(oldAMSDebug) setSQLAMSDebug(oldAMSDebug)  // Reset AMS-DT Debugging Flag!
 	
	RETURN tSC
}
.
/// This is a helper method for the 'populateSQLAMSDebugArrays(...)' method...
generateSQLAMSDebugArrays(&amsInfoOrig,&amsTree,break=2,amsBreak="",&amsInfo,&amsParent,&amsChildren) [amsInfoList, isAPESubQuery] PUBLIC {
	set tSC=$$$OK
	
	new amsInfoList,isAPESubQuery
	
	set infoOnly=0
	
 try {
	
	set serverID=""
	for { // --- Process All 'serverID' Values ---
		set serverID=$o(amsTree("x-serverID",serverID),1,server)
		QUIT:serverID=""  // No more 'serverID' values!
		
		set order=""
		for { // --- Process All 'order' Values ---
			set order=$o(amsTree("x-order",server,order),1,orderInfoList)
			QUIT:order=""  // No more 'order' values!
			
			set $LG(pid,sqlIndexHash,isAPESubQuery)=orderInfoList
			
			if isAPESubQuery { set amsInfoList=amsInfoOrig("APE",server,pid,sqlIndexHash,"info") }
			else { set amsInfoList=amsInfoOrig(server,pid,sqlIndexHash,"info") }
			
			// --- Reset/Clear <statement order> ---
			set amsInfoList=$LIST(amsInfoList,1,$$$AMSSQLPPStatementOrderPos-1)_$LB()_$LIST(amsInfoList,$$$AMSSQLPPStatementOrderPos+1,*)
			
			// ---  Reset 'workerCnt' ---
			set statsList=$LG(amsInfoList,$$$AMSSQLPPStatsListPos)
			set $LIST(statsList,1)=1  // Initialize 'workerCnt' to 1!
			set $LIST(amsInfoList,$$$AMSSQLPPStatsListPos)=statsList
			
			if 'isAPESubQuery { // --- Collect Application Metadata Stack (AMS) Information for NON-Adaptive Parallel Executions (APE) Subqueries ---
				set amsInfo(server,pid,sqlIndexHash,"info")=amsInfoList
			}
			else { // --- Temporarily Collect Application Metadata Stack (AMS) Information for Adaptive Parallel Executions (APE) Subqueries
				set amsInfo("APE",server,pid,sqlIndexHash,"info")=amsInfoList
			}
			
			break:break=2  // BREAK before calling $$populateSPCInfo(...), which populates AMS-DT arrays: amsParent(...), amsChildren(...) & amsTree(...)
			
			set tSC=##class(%SYS.AppMetadataStack.SQL).populateSPCInfo(.amsInfo,server,pid,sqlIndexHash,infoOnly,/*amsDebugID*/"",amsBreak,/*getAllAMS*/"",.amsParent,.amsChildren,.amsTree)
		}
	}
	
	break:break  // BREAK before calling 'normalizeChildrenPP(...)', 'normalizeAPEPP(...)' & 'populateSPCInfoPP(...)', which populates AMS-DT arrays: amsInfo(...), amsParent(...), amsChildren(...) & amsTree(...)
	
	set:$d(amsParent("x-pGroupID"))||$d(amsParent("x-sGroupID")) tSC=##class(%SYS.AppMetadataStack.SQL).normalizeChildrenPP(.amsParent,.amsChildren)  // MRP1337
	set:$d(amsParent("APE")) tSC=##class(%SYS.AppMetadataStack.SQL).normalizeAPEPP(.amsParent,.amsChildren)
	set tSC=##class(%SYS.AppMetadataStack.SQL).populateSPCInfoPP(.amsInfo, .amsParent, .amsChildren, .amsTree)
 }
 catch {
	set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
 }
	RETURN tSC
}
.
.
/// -------------------------------------------------------------------------------
/// Method:       validateSQLAMSDebugArrays
/// Description:  Validate the information arrays 'ams*(...)' collected by the SQL 
///               Application Metadata Stack - Debugging Tool (AMS-DT).
/// 
/// Note:         InterSystems INTERNAL USE ONLY. DO NOT DOCUMENT!
/// 
/// Invocation:   This method can be invoked in the following ways:
///                  ObjectScript: $$validateSQLAMSDebugArrays^%SYS.AMS.SQL(...)
///                           SQL: N/A
///
/// Examples:     The following examples shows the use of this method:
/// 
///    #1         Validate the SQL Application Metadata Stack - Debugging Tool
///               (AMS-DT) information arrays 'ams*(...)' for a specific 
///               'amsDebugID':
/// 
///               set tSC=$$validateSQLAMSDebugArrays^%SYS.AMS.SQL(1)
///
///    #2         Validate the SQL Application Metadata Stack - Debugging Tool
///               (AMS-DT) information arrays 'ams*(...)' for the last
///               'amsDebugID' created/collected:
/// 
///               set tSC=$$validateSQLAMSDebugArrays^%SYS.AMS.SQL()
///
/// Data Storage: ^IRIS.Temp.AMS(0,amsDebugID,...)
///
/// Parameters:
///    amsDebugID  - If specified, then validate the AMS-DT information arrays
///                  for this specific invocation of the 'GetStackInfo(...)'
///                  method;
///                  Otherwise, if not specified, then use the last 'amsDebugID'
///                  created during the invocation of the 'GetStackInfo(...)' 
///                  method
///
/// RETURN Value:   1 = Valid AMS-DT arrays collected
///               tSC = Invalid AMS-DT arrays collected: Error Code
/// -------------------------------------------------------------------------------
///
validateSQLAMSDebugArrays(amsDebugID = "") [amsChildren,amsChildrenOrig,amsInfo,amsInfoOrig,amsParent,amsParentOrig,amsTree,amsTreeOrig,array,arrayGlo,arrayOrigGlo] PUBLIC {
	
	new %objlasterror
	new array,arrayGlo,arrayOrigGlo
	new amsChildren,amsChildrenOrig,amsInfo,amsInfoOrig,amsParent,amsParentOrig,amsTree,amsTreeOrig
	
	set tSC=$$$OK
	
 try {
	set:amsDebugID="" amsDebugID=$o($$$AMSSQLDebugInfo(" "),-1)  // Default to the last one collected!
	if amsDebugID="" { set tSC=$$$ERROR($$$GeneralError,"The 'amsDebugID' parameter must be a valid value: amsDebugID="_$$$quote(amsDebugID)) THROW }
	if '$d($$$AMSSQLDebugInfo(amsDebugID)) { set tSC=$$$ERROR($$$GeneralError,"No AMS-DT data exists for specified 'amsDebugID' value: amsDebugID="_$$$quote(amsDebugID)) THROW }
	
	set arrayOrigGlo=$name($$$AMSSQLDebugInfo(amsDebugID,"get",1))
	
	for array="amsInfo","amsParent","amsChildren","amsTree" { // --- Process All 'array' Values ---
		merge @(array_"Orig")=@arrayOrigGlo@(array)
		
		set amsDebugProcID=""
		for level=1:1 { // --- Process All 'amsDebugProcID' Values ---
			set amsDebugProcID=$o($$$AMSSQLDebugInfo(amsDebugID,"process",amsDebugProcID))
			QUIT:amsDebugProcID=""  // No more 'amsDebugProcID' values!
		
			set debugStage=$s(",amsInfo,amsTree,"[(","_array_","):1,",amsParent,amsChildren,"[(","_array_","):$o($$$AMSSQLDebugInfo(amsDebugID,"process",amsDebugProcID,""),-1),1:1)
			set arrayGlo=$name($$$AMSSQLDebugInfo(amsDebugID,"process",amsDebugProcID,debugStage,array))
			
			if array="amsChildren",level>1 { // --- Process 'amsChildren' Information ---
				set pCaller=""
				for { // --- Used to Merge Info from Multiple 'amsDebugProcID' Values ---
					set pCaller=$o(@arrayGlo@(0,pCaller),1,childrenList)
					QUIT:pCaller=""  // No more 'pCaller' values!
					CONTINUE:$g(@array@(0,pCaller))=childrenList  // SKIP Identical <ams child list> values!
					
					// --- Record $LIST(...) of 'childrenList' ---
					for cPos=1:1:$LL(childrenList) { // --- Add Unique Elements from the 'childrenList' $LIST(...) to the 'amsChildren(0,pCaller)' $LIST(...) ---
						set cElem=$LG(childrenList,cPos)
						set:'$LF($g(@array@(0,pCaller)),cElem) $LIST(@array@(0,pCaller),*+1)=cElem  // Add Unique 'cElem'!
					}
				}
			}
			else { // --- Merge 'ams*(...)' Information Arrays ---
				merge @array=@arrayGlo
			}
		}
		// --- Remove Nodes Added After Collection ---
		kill amsTree("x-server"),amsTree("x-serverID")
		kill amsTreeOrig("x-server"),amsTreeOrig("x-serverID")
		
		set diffVal=$$diffArrayRefs(array_"Orig",array,.msg,.tSC,1)
		THROW:$$$ISERR(tSC)  // INVALID: Differences found!
	}
 }
 catch {
	set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
 }
	RETURN tSC
}
.
.
/// -------------------------------------------------------------------------------
/// Method:       diffArrayRefs [SQL: N/A]
/// Purpose:      This method process two array references (arrayRef1 & arrayRef2)
///               and compares them node by node, value by value; comparing both 
///               structure and value.
///               If they are identical, then this method will return a zero (0);
///               Otherwise, this method will return a one (1) to indicate array
///               differences.
///               This method will also populate the following Pass By Reference
///               parameters:
///                  msg - A message specifying either the equivalence or
///                        differences between the two arrays being compared.
///                  tSC - The status of this method's execution
///
///   NOTE:       The PBR array's can be a simple atomic value or complex array 
///               structure.
/// 
/// Invocation:   This method can be invoked in the following ways:
///                  ObjectScript: $$diffArrayRefs^%SYS.AMS.SQL(...)
///                           SQL: N/A
///
/// Parameters:
///   arrayRef1  - The 1st array reference to compare against for differences
///   arrayRef2  - The 2nd array reference to compare against for differences
///   msg        - A Pass By Reference message of the array differences
///   tSC        - A Pass By Reference variable of the status of
///                this method's execution
///   errOnDiff  - A flag to determine whether to throw a General Error when
///                a difference is found:
///                  0 = Don't throw an error on array differences                 [DEFAULT: 0]
///                  1 = Throw an error on array differences
/// 
/// Return: 0 = No array differences; 1 = Array differences
/// -------------------------------------------------------------------------------
///
diffArrayRefs(arrayRef1, arrayRef2, &msg, &tSC = $$$OK, errOnDiff = 0) [arrayRef1,arrayRef2] PUBLIC {
	
	new %objlasterror
	
	set tSC=$$$OK,$ZE=""
 try {
	set diff=0  // No Differences!
	set ref1=$p(arrayRef1,"(",1),ref2=$p(arrayRef2,"(",1)
	set msg="Arrays '"_ref1_"' & '"_ref2_"' are identical!"
	
	set val1=$g(@arrayRef1),val2=$g(@arrayRef2)
	if val1'=val2 { set diffType="val" THROW }  // The top/root node value of each array are different!
	
	for { // --- Process All Array Nodes ---
		set ref1=$q(@ref1,1,val1),ref2=$q(@ref2,1,val2)
		if $p(ref1,"(",2,*)'=$p(ref2,"(",2,*) { set diffType="ref" THROW }  // The top level reference of the each array are different!
		if val1'=val2 { set diffType="val" THROW }  // The top level value of the each array are different!
		
		QUIT:(ref1="")||(ref2="")  // No more array nodes!
	}
 }
 catch { // --- Process Differences between 'arrayRef1' & 'arrayRef2' --- 
	if tSC=$$$OK,$ZE'="" { set tSC=$$$ERROR($$$ObjectScriptError,$ze) }
	
 	set diff=1 // Indicates Differences!
 	if diffType="ref" { // --- Array Reference Differences ---
 		set:ref1="" ref1="""""" set:ref2="" ref2=""""""
 		set msg="The array references differ: "_ref1_"'="_ref2
 	}
 	else { // --- Array Value Differences ---
 		set msg="The values for the arrays '"_ref1_"' & '"_ref2_"' differ: "_val1_"'="_val2
 	}
 	if errOnDiff,tSC=$$$OK { set tSC=$$$ERROR($$$GeneralError,msg) }
 }
	RETURN diff 
}
.
.
/// -------------------------------------------------------------------------------
/// Method:       showSQLAMSDebugArrays
/// Description:  Show the data collected by the SQL Application Metadata Stack - 
///               Debugging Tool (AMS-DT) to help determine which 'amsDebugID'
///               to further debug and analyze...
/// 
/// Note:         InterSystems INTERNAL USE ONLY. DO NOT DOCUMENT!
/// 
/// Invocation:   This method can be invoked in the following ways:
///                  ObjectScript: $$showSQLAMSDebugArrays^%SYS.AMS.SQL(...)
///                           SQL: N/A
///
/// Examples:     The following examples shows the use of this method:
/// 
///    #1         Show the SQL Application Metadata Stack - Debugging
///               Tool (AMS-DT) data collected for a specific 'amsDebugID':
/// 
///               set tSC=$$showSQLAMSDebugArrays^%SYS.AMS.SQL(1)
///
///    #2         Show ALL data collected by SQL Application Metadata Stack - 
///               Debugging Tool (AMS-DT):
/// 
///               set tSC=$$showSQLAMSDebugArrays^%SYS.AMS.SQL()
///
/// Data Storage: ^IRIS.Temp.AMS(0,amsDebugID,...)
///
/// Parameters:
///    amsDebugID  - If specified, then show the AMS-DT data collected for
///                  this specific invocation of the 'GetStackInfo(...)' method;
///                  Otherwise, if not specified, then show all AMS-DT
///                  data
///    detail      - A flag to determine whether to show abridged information
///                  or detailed information:
///                    0 = Show abridged information                               [DEFAULT: 0]
///                    1 = Show detailed information
///    showHeader  - A flag to determine whether to show header information
///                  before the AMS-DT data collected.
///                  [This is an internal field only]
///    
/// RETURN Value: The status of this method's invocation
/// -------------------------------------------------------------------------------
///
showSQLAMSDebugArrays(amsDebugID = "", detail = 0, showHeader = 1) [] PUBLIC {
.
	new %objlasterror,%sqlcontext
	
	set tSC=$$$OK
	
 try {
	if amsDebugID'="",'$d($$$AMSSQLDebugInfo(amsDebugID)) { set tSC=$$$ERROR($$$GeneralError,"No AMS-DT data exists for specified 'amsDebugID' value: amsDebugID="_$$$quote(amsDebugID)) THROW }
.
	if amsDebugID="" { // --- Show All AMS-DT Arrays ---
		set amsDebugID="",amsDebugCnt=0
		for { // --- Process All 'amsDebugID' Values ---
			set amsDebugID=$o($$$AMSSQLDebugInfo(amsDebugID))
			QUIT:amsDebugID=""  // No more 'amsDebugID' values!
			
			set tSC=$$showSQLAMSDebugArrays(amsDebugID,detail,$i(amsDebugCnt)=1)
		}
	}
	else { // --- Show the details for a specific set of AMS-DT Arrays ---
		set tSC=$$getSQLAMSDebugArrays(.amsDebugID,10,.amsInfo,,,.amsTree,.node0) // Retrieve info from the 'Last' Post-Process (PP) stage of AMS-DT collection!
		THROW:$$$ISERR(tSC)
		
		set $LG(methodName,className,server,port,pid,ns,userName,roles,horolog,zhorolog,tlevel,zu41,ze)=node0(1)
		set $LG(par1List,par2List,par3List,par4List)=node0(2)
		
		write !!
		if showHeader { // --- Display Header Information ---
			write "Application Metadata Stack - Debugging Tool (AMS-DT)"
			write !,"----------------------------------------------------"
		}
		
		set valOffset=18
		write !,"amsDebugID:",?valOffset,amsDebugID
		write !,"Method:",?valOffset,"##class(",className,").",methodName,"(",$$$quote($LG(par1List,2)),",",$LG(par2List,2),",.ams,",$LG(par3List,2),")"
		write !,"Date:",?valOffset,$ZDT(horolog)
		write !,"PID:",?valOffset,pid
		write !
		set tSC=$$getSQLAMSDebugAMSInfo(.amsInfo,.amsTree,.amsDetail)
		
		write !,"SQL Statement Details:"
		for stmtType="SA","P","CP","C" { // --- Write 'Statement Type' Counts ---
			set stmtTypeCnt=$g(amsDetail("stmtType",stmtType,"cnt"))
			write:stmtTypeCnt !?2,$CASE(stmtType,"SA":"Stand-Alone","P":"Parent","CP":"Child/Parent","C":"Children",:"Stand-Alone"),":",?valOffset,stmtTypeCnt
		}
		
		set pos="",stmtValOffset=21
		for { // --- Process All 'amsInfo(...)' Entries ----
			set pos=$o(amsDetail("stmt",pos),1,posInfo)
			QUIT:'+pos  // No more 'pos' values!
			
			set $LG(server,pid,sqlIndexHash,stmtType,sqlStmt)=posInfo
			CONTINUE:'detail&&(",SA,P,"'[(","_stmtType_","))  // Skip sub-statements when 'detail flag passed!
			
			set labelOffset=$s(stmtType="C":4,1:2)
			write !!?labelOffset,"Server:",?stmtValOffset,server,"  (PID: ",pid,")"
			write !?labelOffset,"Statement Type:",?stmtValOffset,$CASE(stmtType,"SA":"Stand-Alone","P":"Parent","CP":"Child/Parent","C":"Child",:"Stand-Alone")
			write !?labelOffset,"SQL Statement:",?stmtValOffset,sqlStmt
		}
	}
 }
 catch {
	set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
 }
	RETURN tSC
}
.
/// This is a helper method for the 'showSQLAMSDebugArrays(...)' method...
getSQLAMSDebugAMSInfo(&amsInfo, &amsTree, &amsDetail) [] PUBLIC {
	
	new %objlasterror
	
	set tSC=$$$OK
	
 try {
	for pos=1:1:$LL($g(amsInfo("orderStmts"))) { // --- Process All 'amsInfo(...)' Entries In Order ---
		set orderInfo=$LG(amsInfo("orderStmts"),pos)
		set $LG(stmtType,server,pid,sqlIndexHash)=orderInfo
		do $i(amsDetail("stmtType",stmtType,"cnt"))
		set $LIST(amsDetail("stmtType",stmtType,"list"),*+1)=pos
		
		set amsInfoList=$g(amsInfo(server,pid,sqlIndexHash,"info"))
		set ns=$LG(amsInfoList,$$$AMSSQLNamespacePos)
		set sqlStmt=$g(amsTree("x-sql",server,ns,sqlIndexHash))
		if sqlStmt="" { // --- Try to get the SQL Statement another way ---
			set normalize=1,upper=0
			set sqlStmt=##class(INFORMATION.SCHEMA.CURRENTSTATEMENTS).GetSQLStatement(ns,sqlIndexHash,.tSCstmt,normalize,upper)
		}
		set amsDetail("stmt",pos)=$LB(server,pid,sqlIndexHash,stmtType,sqlStmt)
	}
 }
 catch {
	set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
 }
	RETURN tSC
}
.
.
/// -------------------------------------------------------------------------------
/// Method:       saveSQLAMSDebugArrays
/// Description:  Save the information arrays 'ams*(...)' collected by the SQL 
///               Application Metadata Stack - Debugging Tool (AMS-DT)
///               to a permanent global location...
/// 
/// Note:         InterSystems INTERNAL USE ONLY. DO NOT DOCUMENT!
/// 
/// Invocation:   This method can be invoked in the following ways:
///                  ObjectScript: $$saveSQLAMSDebugArrays^%SYS.AMS.SQL(...)
///                           SQL: N/A
///
/// Examples:     The following examples shows the use of this method:
/// 
///    #1         Save the SQL Application Metadata Stack - Debugging Tool (AMS-DT)
///               information arrays 'ams*(...)' for a specific 'amsDebugID':
/// 
///               set amsDebugIDperm=$$saveSQLAMSDebugArrays^%SYS.AMS.SQL(1,,.tSC)
///
///    #2         Save the SQL Application Metadata Stack - Debugging Tool (AMS-DT)
///               information arrays 'ams*(...)' for the last 'amsDebugID'
///               created/collected:
/// 
///               set amsDebugIDperm=$$saveSQLAMSDebugArrays^%SYS.AMS.SQL(,,.tSC)
///
///    #3         Save all SQL Application Metadata Stack - Debugging Tool (AMS-DT)
///               information arrays 'ams*(...)' entries:
/// 
///               set amsDebugIDpermList=$$saveSQLAMSDebugArrays^%SYS.AMS.SQL("all",,.tSC)
///
/// Data Storage: ^IRIS.Temp.AMS(0,amsDebugID,...)
///               ^IRIS.Debug.AMS(0,amsDebugID,...)
///
/// Parameters:
///    amsDebugID  - If specified, then save the AMS-DT information arrays
///                  collected for this specific invocation of the 
///                  'GetStackInfo(...)' method;
///                  Otherwise, if not specified, then use the last 'amsDebugID'
///                  created during the invocation of the 'GetStackInfo(...)' 
///                  method;
///                  If "all" is specified, then save all AMS-DT information 
///                  array entries to the permanent global location
///    ns          - The namespace in which to permanently store the SQL 
///                  Application Metadata Stack - Debugging Tool (AMS-DT)
///                  information arrays 'ams*(...)'
///                  [DEFAULT: The current namespace]
///    tSC         - The status of this method's invocation
///    
/// RETURN Value: The 'amsDebugID' for the newly saved AMS-DT information arrays
/// -------------------------------------------------------------------------------
///
saveSQLAMSDebugArrays(amsDebugID = "", ns = "", &tSC = $$$OK ) [] PUBLIC {
.
	new %objlasterror
	
	set tSC=$$$OK
	set amsDebugIDperm=""
	
 try {
	set:amsDebugID="" amsDebugID=$o($$$AMSSQLDebugInfo(" "),-1)  // Default to the last one collected!
	if amsDebugID="" { set tSC=$$$ERROR($$$GeneralError,"The 'amsDebugID' parameter must be a valid value: amsDebugID="_$$$quote(amsDebugID)) THROW }
	if amsDebugID'="all",'$d($$$AMSSQLDebugInfo(amsDebugID)) { set tSC=$$$ERROR($$$GeneralError,"No AMS-DT data exists for specified 'amsDebugID' value: amsDebugID="_$$$quote(amsDebugID)) THROW }
	
	set:ns="" ns=$NAMESPACE if $$$UPPER(ns)'=$NAMESPACE { new $NAMESPACE set $NAMESPACE=ns }
	
	if amsDebugID="all" { // --- Save ALL Entries ---
		set amsDebugID=""
		for { // --- Process All 'amsDebugID' Values ---
			set amsDebugID=$o($$$AMSSQLDebugInfo(amsDebugID))
			QUIT:amsDebugID=""  // No more 'amsDebugID' values!
			
			set amsDebugIDperm1=$$$bumpAMSSQLDebugPermID
			MERGE $$$AMSSQLDebugPermInfo(amsDebugIDperm1)=$$$AMSSQLDebugInfo(amsDebugID)
			set $LIST(amsDebugIDperm,*+1)=amsDebugIDperm1
		}
	}
	else { // --- Save the Specified 'amsDebugID' Entry ---
		set amsDebugIDperm=$$$bumpAMSSQLDebugPermID
		MERGE $$$AMSSQLDebugPermInfo(amsDebugIDperm)=$$$AMSSQLDebugInfo(amsDebugID)
	}
 }
 catch {
	set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
 }
	RETURN amsDebugIDperm
}
.
.
/// -------------------------------------------------------------------------------
/// Method:       restoreSQLAMSDebugArrays
/// Description:  Restore the saved information arrays 'ams*(...)' collected by
///               the SQL Application Metadata Stack - Debugging Tool (AMS-DT)
///               from a permanent global location to the temporary global
///               location for processing...
/// 
/// Note:         InterSystems INTERNAL USE ONLY. DO NOT DOCUMENT!
/// 
/// Invocation:   This method can be invoked in the following ways:
///                  ObjectScript: $$restoreSQLAMSDebugArrays^%SYS.AMS.SQL(...)
///                           SQL: N/A
///
/// Examples:     The following examples shows the use of this method:
/// 
///    #1         Restore the saved SQL Application Metadata Stack - Debugging Tool
///               (AMS-DT) information arrays 'ams*(...)' for a specific 
///               'amsDebugID':
/// 
///               set amsDebugID=$$restoreSQLAMSDebugArrays^%SYS.AMS.SQL(1,,.tSC)
///
///    #2         Restore all saved SQL Application Metadata Stack - Debugging Tool
///               (AMS-DT) information arrays 'ams*(...)' entries:
/// 
///               set amsDebugIDList=$$restoreSQLAMSDebugArrays^%SYS.AMS.SQL("all",,.tSC)
///
/// Data Storage: ^IRIS.Temp.AMS(0,amsDebugID,...)
///               ^IRIS.Debug.AMS(0,amsDebugID,...)
///
/// Parameters:
///    amsDebugIDperm - The ID of the AMS-DT information arrays saved to a
///                     permanent global location
///                     If "all" is specified, then restore all saved entries
///                     to the 'active' temporary global location 
///    ns             - The namespace in which the permanently stored SQL 
///                     Application Metadata Stack - Debugging Tool (AMS-DT)
///                     information arrays 'ams*(...)' exist
///                     [DEFAULT: The current namespace]
///    tSC            - The status of this method's invocation
///    
/// RETURN Value: The 'amsDebugID' for the newly restored AMS-DT information arrays;
///               If "all" is specified for the 'amsDebugIDperm' parameter, then
///               return a $LIST(...) of all newly restored AMS-DT 'amsDebugID'
///               values
/// -------------------------------------------------------------------------------
///
restoreSQLAMSDebugArrays(amsDebugIDperm = "", ns = "", &tSC = $$$OK ) [] PUBLIC {
.
	new %objlasterror
	
	set tSC=$$$OK
	set amsDebugID=""
	
 try {
	if amsDebugIDperm="" { set tSC=$$$ERROR($$$GeneralError,"The 'amsDebugIDperm' parameter must be a valid value: amsDebugIDperm="_$$$quote(amsDebugIDperm)) THROW }
	if amsDebugIDperm'="all",'$d($$$AMSSQLDebugPermInfo(amsDebugIDperm)) { set tSC=$$$ERROR($$$GeneralError,"No AMS-DT data exists for specified 'amsDebugIDperm' value: amsDebugIDperm="_$$$quote(amsDebugIDperm)) THROW }
	
	set:ns="" ns=$NAMESPACE if $$$UPPER(ns)'=$NAMESPACE { new $NAMESPACE set $NAMESPACE=ns }
	
	if amsDebugIDperm="all" { // --- Restore ALL Saved Entries ---
		set amsDebugIDperm=""
		for { // --- Process All 'amsDebugIDperm' Values ---
			set amsDebugIDperm=$o($$$AMSSQLDebugPermInfo(amsDebugIDperm))
			QUIT:amsDebugIDperm=""  // No more 'amsDebugIDperm' values!
			
			set amsDebugID1=$$$bumpAMSSQLDebugID
			MERGE $$$AMSSQLDebugInfo(amsDebugID1)=$$$AMSSQLDebugPermInfo(amsDebugIDperm)
			set $LIST(amsDebugID,*+1)=amsDebugID1
		}
	}
	else { // --- Restore the Specified Saved Entry ---
		set amsDebugID=$$$bumpAMSSQLDebugID
		MERGE $$$AMSSQLDebugInfo(amsDebugID)=$$$AMSSQLDebugPermInfo(amsDebugIDperm)
	}
 }
 catch {
	set:tSC=$$$OK tSC=$$$ERROR($$$ObjectScriptError,$ze)
 }
	RETURN amsDebugID
}
.
/// Return the version of the Application Metadata Stack - Debugging Tool (AMS-DT)...
versionSQLAMSDebug() [] PUBLIC {
	
	; --- Previous Versions ---
	;
	; --- Current Version ---
	RETURN "1.0"  // 05/10/2023: Initial Routine Creation
}
