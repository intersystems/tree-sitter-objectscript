====
qaqosn
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqosn^MAC^^^0
%qaqosn	// ptr ; 03 Jun 88  11:42 AM
	;; COMPONENTS :: SQL/Optimizer
	#;
#include %msql         
#include %qao 
	#;
#IF 0    ;---------------------------------------------------------------------
	; Description:   Query Optomizer
	; Author:        Terry Ragon
	; Date Started:  22 April 1988
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
    ;  PVA256  (03/27/2012) - Enhance TOP .... ORDER BY optimization to use partial indexes more often 
    ;  PVA248  (12/19/2011) - Fix cases where %noindex hint changed the query answer.
    ;  PVA242  (07/28/2011) - Support a hint (%noindex) to not use indexes to satisfy the indicated condition. 
    ;  PVA213  (07/09/2011) - A new hint %ALLINDEX is provided to request that 'all indexes' be used for the first table in the join order. 
	;  PVA212  (05/01/2011) - Multi-index optimization will now use indexes for all 'efficient' equality conditions, by default. 
    ;  PVA218  (03/05/2010) - Fix a selectivity handling bug. 
	;  PVA194  (07/28/2009) - Remove obsolete tests for map population type in the optimizer. 
    ;  PVA177  (05/06/2009) - Fix undesired plan bias for DISTINCT queries when there is no good index for DISTINCT 
    ;  PVA154  (09/01/2008) - Improve optimizer cost model : distinguish selectivity for complex conditions on map subscripts from that on map data
	;  PVA157  (05/01/2008) - Support faster DISTINCT while preserving case (i.e. with FASTDISTINCT OFF )
	;  PVA152  (11/08/2007) - Query Optimization improved for text and collection predicates
	;  PVA146  (07/06/2007) - Joins can interfere with best index choice for starting table when multiple overlapping indexes are present.
	;  PVA130  (02/27/2007) - Prevent <DIVIDE> errors in the optimizer when very large number of ORDER BY columns.
	;  PVA083  (11/18/2005) - Minor discrepancy in selectivity handling
	;  PVA072  (11/10/2004) - Support pseudo conditions implied by TOP... ORDER BY in optimizer
 	;  PVA066  (08/25/2004) - Initial optimizer support for bit slice indexes 
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  PVA32   (02/06/2002) - Apply range optimizations to unrestricted index components
	;  PVA014  (09/13/2000) - Support CON as optional OR of constant = conditions.
	;  PVA023  (10/24/2001) - Optimizer fails to prevent testing of some unnecessary conditions. 
	;  AK430   (03/06/1999) - BERNE: Disable temp-files on virtual fields
	;  MRP695  (06/19/1997) - Don't Use Index Map for NULL Sub Comparison.
	;    DPV702 (01/03/97) - Improve efficiency of QO
	;                          Made %qaoinor a local call via an INCLUDE
	;    DPV700 (01/30/97) - Handle NULL Subscripts in Full Maps
	;    MRP639 (08/23/96) - Allow Conditional Map for Complex RANGE 
	;                        Specifications...
	;    MRP421 (07/27/94) - Fix and make the query optimizer faster by
	;                        always selecting the Master Map for queries
	;                        that have only the condition:
	;                           WHERE Table_RowID = xxx
	;
	;
	;---------------------------------------------------------------------
	;                    I N F O R M A T I O N
	;---------------------------------------------------------------------
	;         
	; Create ptis() and malg() arrays for initial stream algorithms
	; for a given stream.
	; Input variables:
	;     qoqn: (sub)query #
	;     qojsn: join set #
	;     qosn:  stream # to be joined
	; mts() array has been created
	;
	; Among others, the following structures are built for each map:
	;    form() = cost formula values (uses $$$SSE1, etc as subscripts)
	;    resknown = list of rest we know can be satisfied by map
	;    respar   = list of rest we know can partially be satisfied
	;    respar(res) = partial selectivity processed due to this subscript
	;    ressubk(mapsub) = known restrictions satisfied by this map sub
	;    ressubp(mapsub) = partial ...
	;
#ENDIF   ;---------------------------------------------------------------------
	#;
	#; Run through mts(); if one is an outer join, this stream can't
	#; be an initial stream
	#;
	#; qoridifn = record id ^ bracketed list of ifns for the record id
	n MIfound,MWonly,MWmap s MIfound=0,MWonly=0,MWmap=0 // PVA212
	s qoouter=0,qoja="",qoridifn=$p(mts(qoqn,qosn),"^",5,6) i $p(qoridifn,"^",2)="" s qoridifn=$p(qoridifn,"^")_"^,"_$p(qoridifn,"^",1)_","
	#; qoja = join attribute ifn
	f i=1:1 s qoja=$o(mts(qoqn,qosn,"JOIN",qoja)) q:qoja=""!qoouter  s qojar="" f i=1:1 s qojar=$o(mts(qoqn,qosn,"JOIN",qoja,qojar)) q:qojar=""  s a=mts(qoqn,qosn,"JOIN",qoja,qojar),qoouter=+$p(a,"^",4) q:qoouter
	QUIT:qoouter
	#;
	#; No outer join
	#;
	#; get interesting orders in qointord() for this stream
	n qointord d %qaoinor^%qaoinor(","_qosn_",",.qointord)
	#; PVA023: kill resalready for each new context of use of 'allmap' (used now in algorithm
	#;    generation for proper costing of temp files)
	k resalready
	#; PVA213: Set up dummy interesting order cost entries here so can skip allmap in case of %allindex
	s qoio="" f i=1:1 s qoio=$o(qointord(qoio)) q:qoio=""  s $$$Mcost(qoqn,qojsn,1,","_qosn_",",qoio)=""
	d colisalg  ;  maybe generated columnar algorithms for qosn  ;  AK1081
	#; PVA212: Do multi-index strategies first (isalg7()), so can skip others based on 
	#;         result of multi-index analysis.
	d:('$$hint^%qaqpre("%NOBSL",qoqn))&&('$G(^%SYS("HINT","%NOBSL"))) isalg7^%qaqomul
	QUIT:MIfound&&'MWonly&&$$hint^%qaqpre("%ALLINDEX",qoqn) // PVA213
	#; now consider all interesting order possibilities
a	s qoio="" f i=1:1 s qoio=$o(qointord(qoio)) q:qoio=""  s a=$$getifn(qoio) i a]"" d allmap($p(a,"^"),$p(a,"^",2)) ; convert column #s to ifns if possible
	d allmap("",1) ; now process unordered algorithms
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getifn(collist) ;
	#;
	#; getifn
	#; convert column numbers to ifns if possible
	#; input parameter: list of comma bracketed column #s
	#; return:     ifnlist ^ sel
	#;        where: ifnlist = list of ifns (or ifn_function) bracketed
	#;                        by comma, if all columns are simple ifns
	#;                sel = combined selectivity of the ifns
	#;          null string if at least one column was not a simple ifn
	#; Note: if $$getifn returns a null string, we will
	#;           still consider how to produce such an interesting
	#;           order by sorting the output of a fastest algorithm
	n col,ifn,a,b,sel s ifn="",col="",sel=1
	f i=2:1:$l(collist,",")-1 s a=$$$mtV($p(collist,",",i)) d getifn1 q:ifn=""
	s:sel<1e-15 sel=1e-15 // PVA130
	QUIT $s(ifn="":"",1:","_ifn_"^"_sel)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getifn1	i $p(a,"^")'="f" s ifn="" QUIT
	s b=$p(a,"^",3),sel=sel*$p(mts(qoqn,qosn,"ATT",b),"^",6),ifn=ifn_b_","
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
allmap(jaifnlst,jasel) ;
	#;
	#; allmap
	#; process all the maps for this interesting order
	#; input parameters:
	#;      jaifnlst: comma bracketed list of ifns in interesting order
	#;      jasel:  selectivity of that jaifnlst
	#;
	n begsub,conrid,form,formlog,ifn,jasub,map,map0,mapsub,qojc,qojrid,qonjsub,qonojcr,qonumjasub,qoorder,qosubdone,rangesub,resknown,resmaybe,respar,typ
	#; AK430+
	n vorused s vorused=0  ;  1 if jaifnlst contains a virtual field
	s ifn=""
	f  s ifn=$o($$$mtVirtualOrFields(ifn)) q:ifn=""  i jaifnlst[(","_ifn_",") s vorused=1 q
	#; AK430-
	#; PVA066: skip bit slice indexes
	#; JLF156: skip collection index templates ("T")
	s map="" f i=1:1 s map=$o(mts(qoqn,qosn,"MAP",map)) q:map=""  s typ=$p(mts(qoqn,qosn,"MAP",map),"^",6) if 'MWmap||(map=MWmap) d:(typ=""||("T,S"'[typ)) map
	q
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
map	; Spin through maps that are on file in mts(qoqn,qosn,"MAP",map)...
	#; for this join attribute, consider this map
	i map'=$p(mts(qoqn,qosn),"^",4),$$onlyrow(+qoridifn) q  ; ONLY use Master Map...
	#; PVA072: add tressubk,jj,lnum,topsel
	#; PVA023: 'new' tchange.
	#; PVA157: add hasdist
	#; PVA256: add hastoprange
	n change,tchange,ressubk,ressubm,ressubp,tressubk,jj,lnum,topsel,hasdist,hastoprange
	n mapsubifn s mapsubifn=","
    n movdistcost,movdistcostb,dgood s (movdistcost,movdistcostb,dgood)=0 // PVA177
    k respar // PVA218: array entries were never cleared!!
	s qosubdone=0,jasub="",rangesub="",resknown="",resmaybe="",respar="",rangeifn="",qonjsub=0,qonumjasub=""
	s (hasdist,hastoprange)=0
	#;
	#; when qosubdone = 1, it means that subsequent subscripts are
	#; of interest for determining if restrictions can be processed
	#; on the restriction, but they should not be used for setting
	#; jasub or rangesub and their selectivity should be applied to
	#; the $$$SSOI subscript, not to the actual map subscript
	#; set qojrid = 1 if JA is record id
	#;
	i jaifnlst=$p(qoridifn,"^",2) s qojrid=1
	e  i $l(jaifnlst,",")=3,$p(jaifnlst,",",2)=$p(qoridifn,"^") s qojrid=1
	e  s qojrid=0
	k form,ptform // PVA152
	#; PVA154: new form() entries SSOID, SSOIMULD
	f i=$$$SSE1M,$$$SSE1,$$$SSJASUB,$$$SSJAADD,$$$SSJAADDM,$$$SSE2M,$$$SSE2,$$$SSRM,$$$SSR,$$$SSE3M,$$$SSE3,$$$SSOI,$$$SSOID,$$$SSOIMUL,$$$SSOIMULD,$$$SSO0,$$$SSO0MUL,$$$SSOE,$$$SSJAIN,$$$SSJACOND s form(i)=1
	s form($$$SSJA)=jasel
	#; PVA072: set up ptform() 
	#; PVA154: new form() entries SSOID, SSOIMULD
	f i=$$$SSJA,$$$SSE1M,$$$SSE1,$$$SSJASUB,$$$SSJAADD,$$$SSJAADDM,$$$SSE2M,$$$SSE2,$$$SSRM,$$$SSR,$$$SSE3M,$$$SSE3,$$$SSOI,$$$SSOID,$$$SSOIMUL,$$$SSOIMULD,$$$SSO0,$$$SSO0MUL,$$$SSOE,$$$SSJAIN,$$$SSJACOND s ptform(i)=form(i)
	#; PVA072: SSJACOND set up must account for whether range is  TOP: predicate
	#;         Also, because transitive elimination of RANGE when CON exists on same
	#;         ifn, is disabled for TOP: RANGE, , set up for form() needs change as well
	#;         as ptform()
	f i=2:1:$l(jaifnlst,",")-1 {
		s c=$p(jaifnlst,",",i),a=$g(mts(qoqn,qosn,"CON",c)),b=$g(mts(qoqn,qosn,"RANGE",c))
		s:a form($$$SSJACOND)=form($$$SSJACOND)*a,formlog($$$SSJACOND)=$g(formlog($$$SSJACOND))_$p(a,"^",2)
		s:b form($$$SSJACOND)=form($$$SSJACOND)*b,formlog($$$SSJACOND)=$g(formlog($$$SSJACOND))_$p(b,"^",2)
	}
	s ptform($$$SSJACOND)=form($$$SSJACOND)
	if $d($$$mtTopLimit(qoqn)) {
	  f i=2:1:$l(jaifnlst,",")-1 {
		s c=$p(jaifnlst,",",i),b=$g(mts(qoqn,qosn,"RANGE",c)),a=$p(b,"^",2)
		f jj=2:1 {s lnum=$p(a,",",jj) quit:lnum=""
		  if $e($$$mtL(lnum),1,6)="v^TOP:" {
		    s topsel=$$GetSel^%qaqomul(lnum)
		    s ptform($$$SSJACOND)=ptform($$$SSJACOND)/topsel
		    quit // can only be one top condition for a given RANGE
		  }
		}
	  }
	}
	s begsub=$o(mts(qoqn,qosn,"MAP",map,"")) q:begsub=""
	s map0=map=$p(mts(qoqn,qosn),"^",4) ; map0 = 1 if this is map 0
	#; process each subscript
	s qoorder=jaifnlst'="" ; 1 => interesting order in jaifnlst order is directly produced by this map
	#; conrid = "CON" condition if there is a CON on the record id
	s conrid=$g(mts(qoqn,qosn,"CON",+qoridifn))
	#; If this is a conditional map, process the
	#; conditional map restrictions.  First, see
	#; what restrictions are exactly satisfied by the
	#; conditional map restrictions.
	; --- Process the Conditional Map Restrictions as Normal ---
	s mapsub=0,x=mts(qoqn,qosn,"MAP",map)
	#; If there are any restrictions that are partially
	#; satisfied by the conditional map (i.e. the query
	#; restriction is more restrictive than the map restriction)
	#; then process them.
	s x=$p(x,"^",4) f y=2:1:$l(x,"_")-1 s z=$p(x,"_",y) d cmappar
	#;  code moved from ^s4, ^s1, ^s2  ;  DPV702
	s allinmap=1 // until find otherwise (PVA248)
	d %qaos4 ; process the map subscripts
	d %qaos1 ; process additional "CON","RANGE","COMP" restrictions
	d ^%qaqosn2 ; Now its time to select algorithms
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
onlyrow(rowid)  ; Check to see if we are only accessing a table given the
	#;        RowID...  If so return a 1; Otherwise return 0...
	n cnt,found,ifn
	s ifn="",found=0
	f cnt=1:1 s ifn=$o(mts(qoqn,qosn,"CON",ifn)) q:ifn=""!(cnt>2)  s:ifn=rowid found=1
	QUIT cnt=2&found
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 #; This routine currently never gets invoked, due to change in what is set up in %qaqpcmp. 
cmappar	; Process restrictions that are partially satisfied by,
	#; but are more restrictive than, the conditional map restriction
	#; input variable: z =
	#;        ,restriction #s, : selectivity in cond map of
	#;                             corresponding restriction
	#; set maxsel = selectivity of restriction
	f c="CON","RANGE" s a="" f j=1:1 s a=$o(mts(qoqn,qosn,c,a)) q:a=""  s b=mts(qoqn,qosn,c,a) i $p(b,"^",2)[(","_$p(z,",",2)_",") s maxsel=+b g cmappar1
    #; PVA242: modify below for noindex, in case this routine is re-activated (see above).
	f c="COMP","MREL" s a="" f j=1:1 s a=$o(mts(qoqn,qosn,c,a)) q:a=""  i $bit(noindexmap,a)=0 i $p(z,":")[(","_a_",") s maxsel=+mts(qoqn,qosn,c,a) g cmappar1
	#; we didn't find it (but should have)
	#; it shouldn't have been a JOIN (or a MREL) restriction
	#; just make up a value for its partial selectivity
	s maxsel=+$p(z,":",2),maxsel=$s(maxsel*2<1:maxsel*2,maxsel*1.1<1:maxsel*1.1,1:1)
	#; PVA023: use partial in %qaqojn3  ;  DPV702
cmappar1	d partial^%qaqojn3(+$p(z,":",2),maxsel,$$$SSE1M,$$$SSE1,$p(z,":")) QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#define MAPsubifn(%v) $p(%v,"^",2)_$s($p(%v,"^",6)'="":"_"_$p(%v,"^",6),1:"")
#define ifCON(%m,%str,%ifn) ($d(mts(%m,%str,"CON",%ifn),ifCONx)&&'$p(ifCONx,"^",4))
colisalg  ;  maybe generate columnar Initial Stream algorithms for  ;  AK1081
	#;  stream qosn, query must use at least one field with a CXM,
	#;  OR only use %ID and have an EBM
	RETURN:$g(mt("nocolopt",qosn))  ;  uses unimplemented or disabled cases
	RETURN:$g(qno) ; don't include IS31/IS32 for quickcosting
	n irn,idifn,idval,bidifn,ebm,xcol,xnoncol,a,b,c,i,map,mapBx,pureBmcon,cxm,partial,partres,vres,vop,high,mform,ressub s xcol="",xnoncol="",cxm=",",partial="",partres="",vres(0)="",vres(1)="",high="isalg8"
	#;  addtional variables used in jfile()
	n vorused,qoorder,dgood,movdistcost,movdistcostb,qojrid,resknown,resmaybe,respar,jaifnlst,outnodes s vorused=0,qoorder=0,dgood=0,movdistcost=0,movdistcostb=0,qojrid=0,resknown="",resmaybe="",respar="",jaifnlst=","_+qoridifn_",",outnodes="1,0,0"
	s irn=+$$$mtR(qosn)
	s idifn=$p($g(mts(qoqn,qosn)),"^",5),bidifn=$$$smdBIDField(1,irn),ebm=$$$smdBitmapExtentMap(1,irn)
	RETURN:bidifn ;IBA disable IS31/32 for BAT tables. If re-enabled, test dev/sql/TRW/bat
	RETURN:'$d(mts(qoqn,qosn,"MAP",+ebm))  ;  no extent bitmap
	#;  for BAT, treat BID as rowid for our purposes
	s:bidifn $p(mts(qoqn,qosn,"ATT",bidifn),"^",9)=ebm,$p(mts(qoqn,qosn,"ATT",idifn),"^",9)="",idifn=bidifn
	#; *** DP-441515: temporarily disable if %ID has a RANGE or CON condition, until we implement that efficiently!
	RETURN:$d(mts(qoqn,qosn,"RANGE",idifn))||$d(mts(qoqn,qosn,"CON",idifn)) 0
	s a="",map="",mapBx="",pureBmcon=1  ;  collect xnoncol, xcol, cxm
	f  { s a=$o(mts(qoqn,qosn,"ATT",a),1,b)
		q:a=""
		#; IBA: we choose bmcon over columnar if both available
		s mapBx=$p(b,"^",10),map=$p(b,"^",9)
		s:'mapBx pureBmcon=0
		i 'map { s xnoncol=1 }
		else {
			CONTINUE:map=ebm
			s xcol=1
			#;  if both f and COLL(f) are needed, and each has its own CXM, then only use f's CXM
			i a["_",$p($g(mts(qoqn,qosn,"ATT",+a)),"^",9) { CONTINUE }
			s:cxm'[(","_map_",") cxm=cxm_map_","
		}
	}
	#; skip colalg if there is no columnar fields, if any non-columnar fields and it's not a pure bmcon plan
	i 'xcol,xnoncol,'pureBmcon { s mt("nocolopt",qosn)=1 RETURN }
	#; 	#;  ---------------- all OK - file IS31/IS32 !
	#;  columnar information in new $P(^) of malg(alg#):
	#;  28. cxm=LIST(imp,) of CxM maps to access (including bmCON bitmaps)
	#;  29. rowlup=1/0 - whether this plan produces a row-loop
	s a="" f  {
		s a=$o(mts(qoqn,qosn,"MAP",a),1,b)
		q:a=""
		#; introduced by AK1081. Will be used in a future dev-change for partial testing.
		i b["_" { s c=+$p(b,"^",9) d:$d(mts(qoqn,qosn,"CON",c)) partcon(a,+b,c) }
		i b["B",$$bmcollcon(a,.c) { f i=1:1:$ll(c) d partcon(a,+b,$li(c,i)) }
	}
	#;  collect vres(0)/vres(1) from mts(CON/RANGE/COMP)
	f c="CON","RANGE" { s a=""
		f  { s a=$o(mts(qoqn,qosn,c,a),1,b)
			q:a=""
			s b=$e($p(b,"^",2),2,*),vop=''$lf(mts("VOP"),-b),vres(vop)=vres(vop)_b
		}
	}
	s a="" f  s a=$o(mts(qoqn,qosn,"COMP",a)) q:'a  s vop=''$lf(mts("VOP"),-a),vres(vop)=vres(vop)_a_","
	f i=1:1:$$$SUBMAX s mform(i)=1  ;  initialize cost formula array .mform(sub)
	s a=mts(qoqn,qosn,"MAP",$p(mts(qoqn,qosn),"^",4))  ;  set up some mform() parameters
	s mform($$$SNbtup)=$p(a,"^",2),mform($$$SNbblk)=+a
	#;  use "index" for VOP conditions, "map0" for non-VOP
	s ressub=$s(vres(1):"index:,"_vres(1)_"::"_partial_":",1:"")_$e("*",vres(1)&&vres(0))_$s(vres(0):"map0:,"_vres(0)_":::",1:"")
	#;  %malg(alg#)= ... 27:aggmaps ^ 28:cxm ^ 29:vopres ^ 30:nonvop ^ 31:rowlup
	s map=ebm
	i 'xnoncol { d jfile^%qaqosn2("IS31",.mform,"",ressub,0,"","","","","","^"_$e(cxm,2,*)_"^"_''vres(0)_"^"_partres) }
	else  { d jfile^%qaqosn2("IS32",.mform,"",ressub,1,"","","","","","^"_$e(cxm,2,*)_"^1^"_partres) }
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
bmcollcon(imp,lifn)  ;  [public: qoqn,qosn,mts] $$: 1 only if for bitmap  ;  AK1081
	#;  imp, each subscript has a CON or its "uncollate" has a CON;
	#;  list in .lifn=$LIST(+ifn) (by ref) all those exact ifn's with a
	#;  CON that have Coll(ifn) as a subscript - return 0 if lifn is empty
	n sub,v,ifn,ifCONx s lifn=""
	f sub=1:1 {
		s v=$g(mts(qoqn,qosn,"MAP",imp,sub))
		q:v=""
		CONTINUE:+v=1  ;  constant subscript
		s ifn=$$$MAPsubifn(v)
		CONTINUE:$$$ifCON(qoqn,qosn,ifn)
		RETURN:ifn'["_" 0
		RETURN:'$$$ifCON(qoqn,qosn,+ifn) 0
		s lifn=lifn_$lb(+ifn)
	}
	RETURN lifn'=""
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
partcon(imp,size,ifn)  ;  [public: partial] use map imp for partial  ;  AK1081
	#;  testing of ifn's CON, but only if better (larger) than other maps
	s:size>$g(partial(ifn)) partial(ifn)=size_","_imp
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; DPV702+
%qaos1 ; process restrictions in "CON" not satisfied by a subscript
	#; process conditions on non-ANYOF ifns, then ANYOFAND, then conditions on ANYOF ifns
	#; BUT generate the conditions in the REVERSE of the desired evaluation order
	n aoa,ifns,extracost,extdistcost
	f aoa=0:1:1
	{	continue:aoa&&'$d($$$mtNumAnyOf)
	    #; PVA242: handle %noindex; PVA248: move test on noindexmap to other^%qaqosn
		if aoa { s a="" f i=1:1 { s a=$o(mts(qoqn,qosn,"COMP",a)) q:a=""  continue:$p($$$mtLOperator($$$mtL(a)),"%NOINDEX")'="ANYOFAND"  d comother }}
 
		s ifn="" f i=1:1 { s ifn=$o(mts(qoqn,qosn,"CON",ifn)) q:ifn=""  continue:(('aoa&&(ifn["%ANYOF"))||(aoa&&(ifn'["%ANYOF")))  d cother }
		#; process restrictions in "RANGE" not satisfied by a subscript
		#; note that we either process all or none of the range
		#; restrictions for a single ifn.  Furthermore, we only use the
		#; first of these restrictions to indicate whether or not they
		#; should all be unwound from cost formula
		s ifn=""
		f i=1:1 { s ifn=$o(mts(qoqn,qosn,"RANGE",ifn)) q:ifn=""  continue:(('aoa&&(ifn["%ANYOF"))||(aoa&&(ifn'["%ANYOF")))  d rother }
		#; process additional restrictons in "COMP"
	    #; PVA242: handle %noindex; PVA248: move test on noindexmap to other^%qaqosn
		s a="" f i=1:1 { s a=$o(mts(qoqn,qosn,"COMP",a)) q:a=""   continue:$p($$$mtLOperator($$$mtL(a)),"%NOINDEX")="ANYOFAND"  continue:aoa'=$$hasAnyofIfn(a)  d comother }
 
	}
	q
hasAnyofIfn(log) n val,k,found,ifns,ifn s ifns=$$$mtLColVals($$$mtL(log)),found=0 f k=2:1 { s val=$p(ifns,",",k) q:val=""  if $$$mtV(val)["%ANYOF" { s found=1 quit }} QUIT found
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cother	; check to see if this "CON" restriction has already been
	#; processed with a subscript.  If not, process it.
	#; PVA152: record collectcost
	#; PVA157: collectcost->extracost
	#; PVA177: set extdistcost
	s x=mts(qoqn,qosn,"CON",ifn),b=$$resdone($p($p(x,"^",2),",",2)),extracost=$p(x,"^",7),extdistcost=0
	QUIT:b=-1  d other($p(x,"^",2),x/$s(b>0:b,1:1),+x,","_ifn_",") QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
rother	; check to see if this "RANGE" restriction has already been
	#; processed with a subscript.  If not, process it.
	#; PVA152: record collectcost
	#; PVA157: collectcost->extracost
	#; PVA177: set extdistcost
	s e=$g(mts(qoqn,qosn,"RANGE",ifn)),f=$s(e<1:+e,1:1),extracost=$p(e,"^",7),extdistcost=0
	#; either all restrictions have been applied or none have
	s b=$$resdone($p($p(e,"^",2),",",2)) QUIT:b=-1
	d other($p(e,"^",2),f/$s(b>0:b,1:1),f,","_ifn_",") QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
comother	; Process a complex single stream restriction
	#; PVA152: record collectcost
	#; PVA157: collectcost->extracost; add distinct filter cost if applicable
	#; PVA177: set extdistcost
	s x=mts(qoqn,qosn,"COMP",a),b=$$resdone(a),extracost=$p(x,"^",7),extdistcost=0 QUIT:b=-1
	s:$$$mtLOperator($$$mtL(a))="DISTINCT" extracost=extracost+(CDFACTOR/CGGFACTOR),extdistcost=(CDFACTOR/CGGFACTOR)  //PVA157
	d other(","_a_",",x/$s(b>0:b,1:1),+x,$p(x,"^",2)) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
resdone(res) ;
	#; Process a multiple relation restriction
	#;
	#; $$resdone
	#;  Also called from qosinit
	#; See if this restriction has already been processed
	#; input parameter: restriction # (not bracketed)
	#; output:
	#;          -1 already processed
	#;          -2 not yet processed
	#;           0 < value < 1  partially processed
	#;                   the value represents the partial selectivity
	#;                   that was previously applied
	#;
	#; first see if we know we have processed this restriction
	QUIT:resknown[(","_res_",") -1
	#; no - have we partially processed it?
	QUIT:$d(respar(res)) respar(res)
	QUIT -2  ; no - indicate not at all processed yet
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
other(resall,sel,maxsel,ifnlist) ;
	#; Process this restriction.
	#; If all ifns in 'ifnlist' are in this map (or this is map 0)
	#; store the restriction with cost formula subscript $$$SSOI
	#; Else store it with subscript $$$SSO0  This indicates whether
	#; this is an "other" restriction that can be satisfied in the
	#; index or in map 0 (but not by a subscript.)
	#; In the malg() array this will appear in the 'resknown'
	#; field and in the 'ressub' field with subscript
	#; "index" or "map0"
	#; input parameters:
	#;     resall:   bracketed list of restriction #s
	#;               (only "CON" and "RANGE" can pass more than
	#;               one restriction, and it always calls 'known',
	#;               not 'maybe')
	#;     sel:      selectivity to be applied for restriction(s)
	#;               This may be less than maxsel since restriction may
	#;               already have been partially satisifed in a subscript
	#;     maxsel:   Full selectivity of restriction(s)
	#;     ifnlist:  list of ifns needed from this stream:
	#; Also called from ^%qaqosn and ^%qaos4
    #; PVA154: 'other' routine sets post subscript selectivity; thus use new SSOID
	n a,b,c,fsub s fsub=$$$SSOID,mapsub="index"
	#; are all the ifns in this map?
	f i=2:1:$l(ifnlist,",")-1 i $p(mts(qoqn,qosn,"ATT",$p(ifnlist,",",i)),"^",7)'[(","_map_",") s fsub=$$$SSO0,mapsub="map0" q
	#; PVA248: noindexmap test and actions moved here.
	if 'map0&&$bit(noindexmap,$p(resall,",",2)) s allinmap=0,fsub=$$$SSO0,mapsub="map0"
	#; PVA152: record collection cost (usually 0) in appropriate data node cost bucket
	#; PVA157: collectcost->extracost
	#; PVA177: set movdistcost,movdistcostb 
	if mapsub="index" {s form($$$SGPi)=$g(form($$$SGPi))+extracost,ptform($$$SGPi)=$g(ptform($$$SGPi))+extracost,movdistcost=extdistcost}
	else {s form($$$SGPb)=$g(form($$$SGPb))+extracost,ptform($$$SGPb)=$g(ptform($$$SGPb))+extracost,movdistcostb=extdistcost}
	#; make change to cost formula input parameter
	#; PVA023: use 'known' in %qaqojn3
	d known^%qaqojn3(maxsel,"",fsub,resall) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
%qaos4 ;
	#; now process the map subscripts
	n rsub s rsub=0 ; ; IBA082: add rsub to keep track of higher level range conditions
	f mapsub=begsub:1 s x=$g(mts(qoqn,qosn,"MAP",map,mapsub)) q:x=""  d dosub
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dosub	;process this subscript
	s a=+x,ifn=$p(x,"^",2) i a=1 s qonjsub=qonjsub-1 QUIT
	#;
	#; qojc: 1 => there is a CON or a join with this jaifnlst on
	#;       this subscript, and the subscript is the exact ifn;
	#;        used for setting 'qoorder' flag
	#; qojcr: 1 => there is a CON, RANGE, or a join with this jaifnlst
	#;       on this sub; the subscript could be a function of the
  	#;       underlying ifn; used for setting 'qosubdone' flag
	s qojc=0,qojcr=0
	#; PVA32: set sel so properly initialized always for subdone.
	s sel=1
	#; MRP569+ (Analyze Complex Subscripts for Query Optimization)...
	i a=9 d  QUIT  ; Handle Valid Complex Subscript...
	. n iii,ifns
	. s ifns=$p(x,"^",9)
	. s a=2
	. f iii=2:1 s ifn=$p(ifns,",",iii) q:'+ifn  s qojc=0,qojcr=0 d exactifn  ; Process Each 'ifn' in the Subscript...
	; MRP569-
	g exactifn:a=2,manyfun:(a>2)&(a<6),ordifn:a=6
	d conrid:conrid]"" g subdone
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
exactifn	; we have an ifn that satisfies either a "JOIN, "CON", or "RANGE"
	#; (or several)
	s mapsubifn=mapsubifn_ifn_","
	#; if this is an interesting order ifn, process its restrictions
	i 'qosubdone,mapsub>0,'jasub,$$testja d setjasub
	#; check for "CON" restriction
exact1	s sel=1,b=$g(mts(qoqn,qosn,"CON",ifn))
	#;
	#; Also make sure that this CON restriction isn't a comparison with
	#; a null string, which can't be done with a subscript
	#; TR03+
	#; if CON is on IOA, then use $$$SSE2M even if it isn't the
	#; first subscript of the IOA
	#;
	#; DPV700: CON restriction with a NULL string may now take place on a subscript if the Map.MapPopulateType field is 1 (Full).
	#; PVA014: Don't set qojc if CON is a generalized one (with OR), because it does NOT guarantee ordering
	#;     by succeeding subscripts in this case.
	#; PVA023: Use 'known' in %qaqojn3
	i b]"" {
		d known^%qaqojn3(+b,
						 $s((jasub="")&rsub:"",jasub="":$$$SSE1M,(jasub=mapsub)!(qonjsub>0):$$$SSE2M,1:$$$SSE3M),
						 $s((jasub="")&rsub:$$$SSOI,jasub="":$$$SSE1,(jasub=mapsub)!(qonjsub>0):$$$SSE2,1:$$$SSE3),
						 $p(b,"^",2))
		s:'$p(b,"^",4) qojc=(+x=2)!(+x=3) s sel=-1,qojcr=1
	}
	d conrid:conrid]""
	#; check for range selectivity
	s b=$g(mts(qoqn,qosn,"RANGE",ifn)) s:(b]"") rsub=1
	g chkcomp:b="" s qojcr=1 ; TR05: changed g subdone to g chkcomp
	#;
	#; TR03+
	#; if RANGE is on IOA, then use $$$SSE2M
	#;
	#; PVA32: Moved setting of rangesub to subdone because now includes case of an unrestricted subscript
	#; PVA023: use 'known' in %qaqojn3
	#; PVA083: Remove logic that said 'ignor range selectivity if already found CON on subscript'
	d known^%qaqojn3(+b,
					 $s(qonjsub>0:$$$SSE2M,mapsub>0:$$$SSRM,1:$$$SSE1M),
					$s(qonjsub>0:$$$SSE2,mapsub>0:$$$SSR,1:$$$SSE1),
					$p(b,"^",2))
	#; See if there is a complex restriction that can now be processed
chkcomp	s a="" f i=1:1 s a=$o(mts(qoqn,qosn,"COMP",a)) q:a=""  d:(map0||'$bit(noindexmap,a)) chkcomp1 // PVA242
	#;
	#; if haven't processed interesting order yet, a non-CON
	#; subscript means we don't have an interesting order output
	#;
subdone	i 'qojc,jasub="" s qoorder=0
	#; PVA32: rangesub now set here so it applies to unbounded subscripts
	#; PVA146: qonjsub not relevent to setting of rangesub or qosubdone in interesting
	#;         order situation (as here); unlike in join situation (as it qaqojn3). 
	i sel'=-1,mapsub>0,rangesub="",'qosubdone s rangesub=mapsub,rangeifn=ifn
	s qonjsub=qonjsub-1 i 'qojcr s qosubdone=1
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
chkcomp1	; see if this complex restriction can be performed on this subscript
	s b=mts(qoqn,qosn,"COMP",a),c=$p(b,"^",2)
	#; see if all needed subscripts are present
	f i=2:1:$l(c,",")-1 g chkcomp2:mapsubifn'[(","_$p(c,",",i)_",")
	#; this complex condition can be processed now
	s c=$$resdone(a) QUIT:c=-1  ; see if restriction already processed
	#; PVA023: Use 'known' in %qaqojn3
	d distcost^%qaqojn3(a,0) //PVA157
	d known^%qaqojn3(+b,"",$$$SSOI,","_a_",") 
chkcomp2	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ordifn	; We have an interesting order ifn or a subscript on which we can
	#; process a complex condition.  The subscript must be an exact
	#; ifn or a known function (e.g. ALPHAUP) of an ifn
	#; If it is not the interesting order for which we are looking,
	#; then this map does not automatically produce an interesting
	#; order and we essentially have the same state as if we
	#; couldn't recognize the subscript
	#;
	s mapsubifn=mapsubifn_ifn_$s($p(x,"^",6)="":"",1:"_"_$p(x,"^",6))_","
	g ordifn1:qosubdone!jasub
	i mapsub>0,$$testja d setjasub g ordifn1
	i qojrid,$p(x,"^",4)!map0,mapsub=1 d setjasub s qonjsub=10 i '$p(x,"^",5) s qoorder=0
ordifn1	d conrid:conrid]"" g chkcomp
	#;
	#; we have a subscript that is standard function on a
	#; "JOIN", "CON", or "RANGE" with one-to-one mapping
	#; onefun g exact1 ; TR05 removed process almost as if subscript 
	#;  was exactly an ifn
	#;
	#; we have a subscript that is a standard function on a
	#; "CON" or "RANGE" with many-to-one mapping of ifn to subscripts
	#; Processing is similar to 'exactifn', except:
	#;     ignore interesting order possibility
	#;    get selectivity from "MAP" subscript entry
manyfun	s mapsubifn=mapsubifn_ifn_"_"_$p(x,"^",6)_"," g many1:jasub]""
	#; see if this function of this ifn (& subsequent subscripts)
	#; match interesting order
	#;
	i 'qosubdone,mapsub>0,$$testja d setjasub g many1
	#; check for "CON" restriction
many1	; check for CON or RANGE on function of ifn
	s sel=1,b=$g(mts(qoqn,qosn,"CON",ifn_"_"_$p(x,"^",6)))
	#;
	#; Also make sure that this CON restriction isn't a comparison with
	#; a null string, which can't be done with a subscript
	#; TR03+
	#; if CON is on IOA, then use $$$SSE2M even if it isn't the
	#; first subscript of the IOA
	#; DPV700: CON restriction with a NULL string may now take place on a subscript if the Map.MapPopulateType field is 1 (Full).
	#; PVA014: Don't set qojc if CON is a generalized one (with OR), because it does NOT guarantee ordering
	#;     by succeeding subscripts in this case.
	#; PVA023: Use 'known' in %qaqojn3
	i b]"" d known^%qaqojn3(+b,$s((jasub="")&rsub:"",jasub="":$$$SSE1M,(jasub=mapsub)!(qonjsub>0):$$$SSE2M,1:$$$SSE3M),$s((jasub="")&rsub:$$$SSOI,jasub="":$$$SSE1,(jasub=mapsub)!(qonjsub>0):$$$SSE2,1:$$$SSE3),$p(b,"^",2)) s:'$p(b,"^",4) qojc=1 s sel=-1,qojcr=1
	#; check for range selectivity
	s b=$g(mts(qoqn,qosn,"RANGE",ifn_"_"_$p(x,"^",6))) g many2:b="" s qojcr=1
	#; PVA083: remove this logic: if sel = -1, we had a "CON" condition so don't apply any more selectivity
	#; if range is on IOA, then use $$$SSE2M instead of range
	#; PVA32: Rangesub set moved to subdone to pick up unbounded subscripts
	#; PVA023: Use 'known' in %qaqojn3
  	d known^%qaqojn3(+b,$s(qonjsub>0:$$$SSE2M,mapsub>0:$$$SSRM,1:$$$SSE1M),$s(qonjsub>0:$$$SSE2,mapsub>0:$$$SSR,1:$$$SSE1),$p(b,"^",2))
	#; PVA32: Don't override sel becoming -1; this is a one time change; so introduce sel2 to remember 
	#;        partial selectivity. 
many2	n sel2 s sel2=$p(x,"^",3) s b=$g(mts(qoqn,qosn,"CON",ifn)) ; sel2 = selectivity of partial rest
	#;
	#; Make sure that this CON restriction isn't a comparison with
	#; a null string, which can't be done with a subscript
	#; TR03+
	#; if CON is on IOA, then use $$$SSE2M even if it isn't the
	#; first subscript of the IOA
	#;
	#; DPV700: CON restriction with a NULL string may now take place on a subscript if the Map.MapPopulateType field is 1 (Full).
	#; PVA32: Use sel2 for partial selectivity, preserving sel as flag.
	i b]"" d knowpart(sel2,+b,$s(jasub="":$$$SSE1M,(jasub=mapsub)!(qonjsub>0):$$$SSE2M,1:$$$SSE3M),$s(jasub="":$$$SSE1,(jasub=mapsub)!(qonjsub>0):$$$SSE2,1:$$$SSE3),$p(b,"^",2)) s sel=-1,qojcr=1
	d conrid:conrid]"" ; check for possible CON on record id
	#; check for range selectivity if type = 3
	g many3:x-3 s b=$g(mts(qoqn,qosn,"RANGE",ifn)) g many3:b="" s qojcr=1
	#; If range is on IOA, use $$$SSE2
	#; PVA32: Moved setting of rangesub to subdone to pick up unbounded subscripts
	#;        Also use sel2 for partial selectivity, preserving sel as flag.
	#; PVA072: knowpart changed to known, since +x=3 here, and knowpart =
	#;          known in this case. This means setting sel2 no longer needed.
	d known^%qaqojn3(+b,$s(mapsub>0:$$$SSRM,1:$$$SSE1M),$s(mapsub>0:$$$SSR,1:$$$SSE1),$p(b,"^",2))
many3	g chkcomp
	#; PVA023: Delete 'known' and 'partial' because we share versions in %qaqojn3 that maintain 'change' array
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
knowpart(a,b,c,d,e) ;
	#; If one-to-one correspondence function, use known()
	#; Else, its many-to-one and we use partial()
	#;
	#; PVA023: Use 'partial' and 'known' in %qaqojn3
	i +x=5 d partial^%qaqojn3(a,b,c,d,e) QUIT
	d known^%qaqojn3(b,c,d,e) QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
testja() ;
	#; See if this and immediately following subscripts (except for
	#;      intervening constants) form the interesting order.
	#;     There must be an exact correspondence.
	#; return: 1 if subscript(s) = jaifnlst
	#;   also, if return a 1, then set:
	#;        a) qonjsub = # of subscripts used for the interesting order
	#;        b) s qonumjasub = ,s1,s2,...,
	#;            where sx = # subscripts for corresponding JAlist
	#;
	QUIT:jaifnlst="" 0
	n a,b,c,d,f,sub,ifn s a=1,sub=mapsub,d=","
	f i=2:1:$l(jaifnlst,",")-1 s ifn=$p(jaifnlst,",",i),c=sub d testja1 q:'a  s d=d_(sub-c)_","
	i a s qonjsub=sub-mapsub,qonumjasub=d QUIT 1
	QUIT 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
testja1	s b=$g(mts(qoqn,qosn,"MAP",map,sub)),sub=sub+1
	i +b=1 g testja1 ; skip constant subscript
	#;
	#; if ifn in jaifnlst is a function, then the subscript should
	#; also be the same function of the ifn
	#;
	i ifn'=+ifn s a=$p(b,"^",2)_"_"_$p(b,"^",6)=ifn QUIT
	#;
	#; ifn in jaifnlst is an exact ifn, make sure this subscript is
	#; the same ifn
	#;
	i $p(b,"^",2)'=ifn s a=0 QUIT
	#;
	#; if this subscript is exact ifn or one-one function with same
	#; order, or (type = 6 and subscript isn't a function), then we pass
	#;
	i (+b=2)!(+b=3)!((+b=6)&($p(b,"^",6)="")) QUIT
	s a=0 QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setjasub	; got the interesting order
	#; DONT MODIFY THE IF SWITCH IN THIS SUBROUTINE
	#; PVA072: set ptform() as well.
	#; PVA146: Don't set qojcr or qojc. This is not valid for an interesting order (mistakenly
	#;         copied from similar (valid) logic for the join case in qaqojn3.
	s jasub=mapsub,form($$$SSJASUB)=jasel,ptform($$$SSJASUB)=jasel QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
conrid	; if there is a CON condition on the record id, and this is the
	#; 1st subscript of map0 or it is a subscript in another map that
	#; has the idsub flag set, then we can process the CON condition
	QUIT:conrid=""  i 'map0,'$p(x,"^",4) QUIT
	#; if restriction already satisfied, don't worry about it
	s c=$p($p(conrid,"^",2),",",2) i resknown[(","_c_",") s conrid="" QUIT
	#; if const is on part of the IOA, treat it as a $$$SSE2 restriction
	#; PVA023: User 'known' in %qaqojn3
	i '$p(conrid,"^",3) d known^%qaqojn3(+conrid,$s((jasub="")&rsub:"",jasub="":$$$SSE1M,(jasub=mapsub)!(qonjsub>0):$$$SSE2M,1:$$$SSE3M),$s((jasub="")&rsub:$$$SSOI,jasub="":$$$SSE1M,(jasub=mapsub)!(qonjsub>0):$$$SSE2,1:$$$SSE3),$p(conrid,"^",2)) s sel=-1,qojc=0,qojcr=1,conrid=""
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
