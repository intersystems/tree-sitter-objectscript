^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%fm2cache2^MAC^^^0
%fm2cache2 ; VA -> Cach FILE MANAGER INTERFACE (cont) (Version .816)
 #;
#INCLUDE %msql
 #;
#IF 0    ;
	#;---------------------------------------------------------------------
	#; Description:   New Fileman Interface - Build class definitions
	#; Author:        David Van De Griek
	#; Date:          December 2004
	#; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ] 
	#;
	#;  DPV3217 (07/08/2008) - Improve performance of class creation (.815)
	#;                         Add FILEMANFILENAME and FILEMANFILENUMBER class parameters
	#;  DPV3126 (03/17/2008) - Default String field length is now 255.    (.813)
	#;                         Use %String for IEN fields.
	#;                         Define MINLEN on %String fields where appropriate
	#;                         Fix <UNDEFINED> error with fid in index2
	#;                         Perform one save of entire class instead of saving each class item
	#;                         Field names longer the 50 characters are now supported
	#;  DPV3084 (12/13/2007) - Use %EnumString datatype for multiple choice fields (.812)
	#;  DPV3069 (11/07/2007) - Add %fmRetainClass parameter to not completely delete the class definition (.811)
	#;  DPV3068 (11/06/2007) - Generate index maps from new style cross references
	#;  DPV3013 (09/10/2007) - Add ;PREV logic to Next code, move multpc to %fm2cache2
	#;  DPV3013 (09/10/2007) - Add ;PREV logic to Next code, move multpc to %fm2cache2
	#;  DPV3008 (08/27/2007) - Fix Variable Pointers
	#;  DPV2963 (06/19/2007) - Fix Delete of classes, use 60 for class name length
	#;  DPV2845 (01/23/2007) - Enhance ConvertFiles entry point
	#;  DPV2801 (11/28/2006) - ConvertFiles entry point
	#;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	#;  DPV2449 (06/28/2005) - First checkin of utility
	#;---------------------------------------------------------------------
	#;                     I N F O R M A T I O N
	#;---------------------------------------------------------------------
	#;
	#;   Start your information here...
	#;---------------------------------------------------------------------
#ENDIF   ;
 
#define normalize(%name) $tr(%name," !""#$%&'()*+-./:;<=>@[\]^_`{|}~,","")
#;	For Cache 5.0.x #define maxShortClassnameLength	25
#define maxShortClassnameLength	60
 
MakeClasses(compile=1) [] PUBLIC {
	s t="",t1=$zh w !
	s zu1159val=$zu(115,9) i $zu(115,9,0)
	s zu11510val=$zu(115,10) i $zu(115,10,0)
		#; %reuseClass is a global-in-scope variable that is 1 if the class definition is being re-created
	n %schema,%reuseClass s %schema=$$DetermineSchemaName^%occClass(%package)
	For cnt=1:1 {
		s t=$o(^IRIS.TempFMI($j,"rv",t),1,filen) q:t=""
		s tdata=$g(^IRIS.TempFM($j,filen)) q:tdata=""
		s Classname=%package_$$Classname($lg(tdata,1))
		s oldClassname=$$LookUpClassName^%apiDDL2(%package_$tr($lg(tdata,1),".",$c(2))),%reuseClass=0
		if %fmRetainClass,oldClassname=Classname,$d(^oddDEF(Classname)) {
			#;  We are re-creating a class.  Don't just delete it because that might remove any class/table items defined manually
			#;  in the class/table definition.  For example, methods/procedures, query-views, SQL privileges, etc.
			#;  I'll just call a Delete function that removes all properties, storage definitions, fkeys, etc.
			w !,"Cleaning up old definition for class "_oldClassname
			d ClassWipe(Classname) s %reuseClass=1
			w !,"Re-defining class "_Classname
		}
		elseif oldClassname'="",$d(^oddDEF(oldClassname)) {
			w !,"Deleting old definition for class "_oldClassname
			Do Delete^%apiOBJ(oldClassname,%compflags)
		}
		if '%reuseClass,$d(^oddDEF(Classname)) {	// Should never happen, but doesn't hurt???
			w !,"Deleting old definition for class "_Classname
			Do Delete^%apiOBJ(Classname,%compflags)
		}
		w !,"Creating class "_Classname
		s sc=$$CreateClass(Classname,$lg(tdata,1),$lg(tdata,2),$lg(tdata,3),$lg(tdata,9),.class)
		If $$$ISERR(sc) w $$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) q
		s:compile compList(Classname)=""
		d:%readonly MakeClassReadOnly(.parm,class)
		
		s sc=$$CreateParameter(1,.parm,class,Classname,"FILEMANFILENAME",$$ddtable^%fm2cache(filen))
		If $$$ISERR(sc) w $$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) q
		s sc=$$CreateParameter(2,.parm,class,Classname,"FILEMANFILENUMBER",filen)
		If $$$ISERR(sc) w $$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) q
		
			#;  First determine Property names for relationship fields.  It is more important their names don't change.
			#;  If this does not work, might have to determine class and property names earlier.
		s f="" f  s f=$o(^IRIS.TempFM($j,filen,"f",f),1,fdata) q:f=""  i $lg(fdata,11)'="" s x=$$PropName(Classname,$lg(fdata,1))
		
		s index="" w "."
		For ii=1:1 {
			s index=$o(^IRIS.TempFM($j,filen,"i",index),1,idata) q:index=""
			s fnames=$lg(idata,3)
			s pnames="" f i=1:1:$ll(fnames) s $p(pnames,",",i)=$$PropName(Classname,$lg(fnames,i))
			s sc=$$CreateIndex(ii,.index,class,Classname,$lg(idata,1),$lg(idata,2),pnames)
			If $$$ISERR(sc) w $$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) q
		}
		s fkey="" w "."
		For ii=1:1 {
			s fkey=$o(^IRIS.TempFM($j,filen,"fk",fkey),1,fkdata) q:fkey=""
			s fkObjName=$$FKeyName(Classname,fkey)
			s targClass=%package_$$Classname($lg(fkdata))
			s pname=$$PropName(Classname,$lg(fkdata,2))
			s sc=$$CreateFKey(ii,.fkey,class,Classname,fkey,fkObjName,targClass,pname,$lg(fkdata,3))
			If $$$ISERR(sc) w $$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) q
		}
		s field="" w "."
		For ii=1:1 {
			s field=$o(^IRIS.TempFM($j,filen,"f",field),1,fdata) q:field=""
			s Property=$$PropName(Classname,$lg(fdata,1))
			s sc=$$CreateProperty(ii,.prop,class,Classname,Property,$lg(fdata,1),$lg(fdata,2),$lg(fdata,3),$lg(fdata,4),$lg(fdata,8),$lg(fdata,7),$lg(fdata,9),$lg(fdata,10),$lg(fdata,11),$lg(fdata,12),$lg(fdata,13),$lg(fdata,14),$lg(fdata,15),$lg(fdata,16),$lg(fdata,17),$lg(fdata,18),$lg(fdata,19))	// DPV3008
			If $$$ISERR(sc) w $$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) q
		}
		s trig="" w "."
		For ii=1:1 {
			s trig=$o(^IRIS.TempFM($j,filen,"t",trig),1,trgdata) q:trig=""
			s TriggerName=$$TrigName(Classname,trig)
			s sc=$$CreateTrigger(ii,.trig,class,Classname,TriggerName,trig,trgdata)
			If $$$ISERR(sc) w $$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) q
		}
		w "."
		s sc=$$CreateStorageDefinition(class,.storage,$lg(tdata,10))
		If $$$ISERR(sc) w $$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) q
		s map="" w "."
		s iii=1,iv=1 For ii=1:1 {
			s map=$o(^IRIS.TempFM($j,filen,"m",map),1,mdata) q:map=""
			s sc=$$CreateMap(ii,.storage,Classname,mdata,.maporef)
			If $$$ISERR(sc) w $$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) q
			s ms=""
			For iii=iii:1 {
				s ms=$o(^IRIS.TempFM($j,filen,"m",map,"s",ms),1,msdata) q:ms=""
				s sc=$$CreateMapSubs(iii,.msoref,maporef(ii),ms,msdata,.msicoref)
				If $$$ISERR(sc) q
			}
			If $$$ISERR(sc) w $$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) q
			s md=""
			For iv=iv:1 {
				s md=$o(^IRIS.TempFM($j,filen,"m",map,"d",md),1,mddata) q:md=""
				s sc=$$CreateMapData(iv,maporef(ii),md,mddata,.mdoref)
				If $$$ISERR(sc) q
			}
			If $$$ISERR(sc) w $$DisplayError^%apiOBJ($$GetLastError^%apiOBJ()) q
			
		}
		s sc=class.%Save() 
		If $$$ISERR(sc) {
			w $$DisplayError^%apiOBJ($$GetLastError^%apiOBJ())
			k class,fkey,maporef,mdoref,msicoref,msoref,parm,prop,storage
			q
		}
		k class,fkey,maporef,mdoref,msicoref,msoref,parm,prop,storage
		w ?60,"Done"
	}
	s t2=$zh w !!,(cnt-1)," classes created in ",(t2-t1)," seconds."
	i $zu(115,10,zu11510val)
	i $zu(115,9,zu1159val)
	If compile {
		w !!,"Compiling classes...",!
		d Compile(.compList,%compflags)
	}
	QUIT
}
 
 
ClassWipe(Classname) [Classname,SQLCODE] PUBLIC {
	n %0CacheLock,%ROWCOUNT,%ROWID,SQLCODE
	&sql(delete from %Dictionary.PropertyDefinition where parent = :Classname)
	if SQLCODE<0 w !,"ERROR:  Cannot delete properties from class definition "_Classname_".",!,"   SQLCODE = "_SQLCODE,!,"   %msg = ",$g(%msg) q
	&sql(delete from %Dictionary.PropertyUDLTextDefinition where parent = :Classname)
	if SQLCODE<0 w !,"ERROR:  Cannot delete property UDL text definitions from class definition "_Classname_".",!,"   SQLCODE = "_SQLCODE,!,"   %msg = ",$g(%msg) q
	&sql(delete from %Dictionary.IndexDefinition where parent = :Classname)
	if SQLCODE<0 w !,"ERROR:  Cannot delete indexes from class definition "_Classname_".",!,"   SQLCODE = "_SQLCODE,!,"   %msg = ",$g(%msg) q
	&sql(delete from %Dictionary.ForeignKeyDefinition where parent = :Classname)
	if SQLCODE<0 w !,"ERROR:  Cannot delete foreign keys from class definition "_Classname_".",!,"   SQLCODE = "_SQLCODE,!,"   %msg = ",$g(%msg) q
	&sql(delete from %Dictionary.TriggerDefinition where parent = :Classname)
	if SQLCODE<0 w !,"ERROR:  Cannot delete triggers from class definition "_Classname_".",!,"   SQLCODE = "_SQLCODE,!,"   %msg = ",$g(%msg) q
	&sql(delete from %Dictionary.StorageDefinition where parent = :Classname)
	if SQLCODE<0 w !,"ERROR:  Cannot delete storage definitions from class definition "_Classname_".",!,"   SQLCODE = "_SQLCODE,!,"   %msg = ",$g(%msg) q
	&sql(delete from %Dictionary.UDLTextDefinition where parent = :Classname)
	if SQLCODE<0 w !,"ERROR:  Cannot delete UDL text definitions from class definition "_Classname_".",!,"   SQLCODE = "_SQLCODE,!,"   %msg = ",$g(%msg) q
	QUIT
}
 
CreateClass(Classname,TableName,Desc,Owner,SQLRowIdName,class) [] {
	if '%reuseClass {
		s class=##class(%Dictionary.ClassDefinition).%New()
		QUIT:$$$ISERR(class) class
	}
	else {
		s sc=$$$OK,class=##class(%Dictionary.ClassDefinition).%OpenId(Classname,,.sc)
		QUIT:$$$ISERR(sc) sc
		QUIT:$$$ISERR(class) class
	}
	s class.ClassType="persistent"
	s class.Description=Desc
	s class.Name=Classname
	s class.Owner=Owner
	s class.SqlRowIdName=SQLRowIdName
	s class.SqlTableName=TableName
	s:'%reuseClass class.Super="%Library.Persistent"
	s class.StorageStrategy="SQLStorage"
	s:'%reuseClass class.TimeCreated=$zu(188)
	s class.TimeChanged=$zu(188)
	//s sc=class.%Save(0)
	QUIT $$$OK
}
 
 
MakeClassReadOnly(parm,class) [] {
	s parm=##class(%Dictionary.ParameterDefinition).%New()
	QUIT:$$$ISERR(parm) parm
	s parm.parent=class
	s parm.Name="READONLY"
	s parm.Default=1
	//s sc=parm.%Save(0)
	//k parm
	QUIT 1
}
 
.
CreateParameter(ii,parm,class,Classname,name,default) [] {
	s parm(ii)=##class(%Dictionary.ParameterDefinition).%New()
	QUIT:$$$ISERR(parm(ii)) parm
	s parm(ii).parent=class
	s parm(ii).Name=name
	s parm(ii).Default=default
	QUIT 1
}
.
CreateProperty(ii,prop,class,Classname,Property,SQLFieldName,Desc,Type,Required,Transient,SQLComputed,SQLComputeCode,SQLComputeOnChange,Relationship,Cardinality,Inverse,Parameters,SQLColumnNumber,IsAReference=0,InitialExpression="",Collection="",ReadOnly=0) [] {	// DPV3008
	s prop(ii)=##class(%Dictionary.PropertyDefinition).%New()
	QUIT:$$$ISERR(prop(ii)) prop(ii)
	s prop(ii).Name=Property
	s prop(ii).parent=class
	i Desc'="" s prop(ii).Description=Desc
	i Required s prop(ii).Required=Required
	i SQLColumnNumber s prop(ii).SqlColumnNumber=SQLColumnNumber
	i SQLComputed {
		s prop(ii).SqlComputed=1
		For i=1:1:$ll(SQLComputeCode) { s $p(ComputeCode,$c(13,10),i)=$c(9)_$lg(SQLComputeCode,i) }
		s prop(ii).SqlComputeCode=ComputeCode
		i $g(SQLComputeOnChange)'="" { f i=1:1:$ll(SQLComputeOnChange) s $li(SQLComputeOnChange,i)=$$PropName(Classname,$li(SQLComputeOnChange,i)) }
		s prop(ii).SqlComputeOnChange=$zlts(SQLComputeOnChange)
	}
	s prop(ii).SqlFieldName=SQLFieldName
	i Transient s prop(ii).Transient=Transient
	s sType=$p(Type,"(")  If IsAReference s sType=%package_$$Classname(sType)
	s prop(ii).Type=sType
	i Parameters'="" { For i=1:1:$ll(Parameters) { Do prop(ii).Parameters.SetAt($lg($lg(Parameters,i),2),$lg($lg(Parameters,i),1)) } }
	i Relationship {
		s prop(ii).Relationship=1
		s prop(ii).Inverse=$$PropName(sType,Inverse)
		s prop(ii).Cardinality=Cardinality
	}
	i Collection'="" s prop(ii).Collection=Collection,prop(ii).SqlListType="SUBNODE"
	s:InitialExpression'=""&&('%readonly) prop(ii).InitialExpression=InitialExpression
	s:ReadOnly prop(ii).ReadOnly=1
	s prop(ii).SequenceNumber=1
	//s sc=prop.%Save(0)
	//k prop
	QUIT 1
}
 
 
CreateIndex(ii,index,class,Classname,name,type,properties) [] {
	s index(ii)=##class(%Dictionary.IndexDefinition).%New()
	QUIT:$$$ISERR(index(ii)) index
	s index(ii).parent=class
	s index(ii).Name=name
	If $$$UPPER(type)="IDKEY" s index(ii).IdKey=1,index(ii).Unique=1,index(ii).PrimaryKey=1
	s index(ii).Properties=properties
	s index(ii).SequenceNumber=2
	//s sc=index.%Save(0)
	//k index
	QUIT 1
}
 
 
CreateFKey(ii,fkey,class,Classname,name,objName,targClass,property,desc) [] {
	s fkey(ii)=##class(%Dictionary.ForeignKeyDefinition).%New()
	QUIT:$$$ISERR(fkey(ii)) fkey(ii)
	s fkey(ii).parent=class
	s fkey(ii).Name=objName
	s fkey(ii).SqlName=name
	s fkey(ii).ReferencedClass=targClass
	s fkey(ii).Properties=property
	s fkey(ii).Description=desc
	s fkey(ii).SequenceNumber=3
	//s sc=fkey.%Save(0)
	//k fkey
	QUIT $$$OK
}
 
CreateTrigger(ii,trig,class,Classname,name,SQLName,data) [] {
	s trig(ii)=##class(%Dictionary.TriggerDefinition).%New()
	QUIT:$$$ISERR(trig(ii)) trig(ii)
	s trig(ii).Name=name
	s trig(ii).parent=class
	s trig(ii).Event=$lg(data,1)
	s trig(ii).Time=$lg(data,2)
	s trig(ii).Order=$lg(data,3)
	s trig(ii).SqlName=SQLName
	i $lg(data,4)'="" s trig(ii).Description=$lg(data,4)
	s code=$lg(data,5)
	For i=1:1:$ll(code) {
		i $lg(code,i)["^IRIS.TempFMI($j,""trig""," {
			//s ref=$e($lg(code,i),1,$l($lg(code,i))-1)
			s ref=$lg(code,i)
			s rtn=$$$nameTableRoutinePrefixGet(Classname)_$e($lg(data,1)) // .TI or .TU routine
			k ^rMAC(rtn),^ROUTINE(rtn),^rOBJ(rtn),^rINDEX(rtn,"MAC"),^rINDEX(rtn,"INT"),^rINDEX(rtn,"BAS"),^rINDEX(rtn,"OBJ")
			s $p(TrigCode,$c(13,10),i)=$c(9)_"Do ^"_rtn_"  // Trigger overflow routine"
			s c=0,l="" f j=1:1 s l=$o(@ref@(l),1,d) q:l=""  s ^rMAC(rtn,0,j)=d,c=c+$l(d)
			s tim=$zutil(188)
			s ^rMAC(rtn,0,j)=$c(9)_"QUIT",^rMAC(rtn,0)=tim,^rMAC(rtn,0,0)=j
			s ^rINDEX(rtn,"MAC")=$lb($$$TimeToODBC(tim),c+5)
			s comperr="comerr",@comperr@(0)=0
			d ^%qarmac(rtn,"","","",0,comperr,"","","","","","")
			If @comperr@(0) {
				s status=0,SQLCODE=-400,%msg="There are ("_(@comperr@(0)\2)_") syntax errors in ("_rtn_")"
				QUIT
			}
			continue
		}
		s $p(TrigCode,$c(13,10),i)=$c(9)_$lg(code,i) 
	}
	s trig(ii).Code=TrigCode
	s trig(ii).SequenceNumber=5
	//s sc=trig.%Save(0)
	//k trig
	QUIT $$$OK
}
 
 
CreateStorageDefinition(class,storage,SqlIdExpression="") [] {
	s storage=##class(%Dictionary.StorageDefinition).%New()
	QUIT:$$$ISERR(storage) storage
	s storage.parent=class
	s storage.Name="SQLStorage"
	s storage.Type="%Storage.SQL"
	s:SqlIdExpression'=""&&('%readonly) storage.SqlIdExpression=SqlIdExpression
	//s sc=storage.%Save(0)
	QUIT $$$OK
}
 
 
CreateMap(ii,class,Classname,data,maporef) [] {
	s maporef(ii)=##class(%Dictionary.StorageSQLMapDefinition).%New()
	QUIT:$$$ISERR(maporef(ii)) maporef(ii)
	s maporef(ii).parent=class
	s mapname=$tr($lg(data,1)," !""#$%&'()*+-./:;<=>@[\]^_`{|}~?","")
	s:$e(mapname)?1n mapname="Z"_mapname
	s maporef(ii).Name=mapname
	s maporef(ii).Global=$lg(data,2)
	If $lg(data,3)="Y" s maporef(ii).Type="data"
	If $lg(data,3)="N" {
		s maporef(ii).Type="index"
		s maporef(ii).PopulationType="nonnull"
	}
	//s sc=maporef.%Save(0)
	QUIT $$$OK
}
 
 
CreateMapSubs(ii,msoref,map,ilev,data,msicoref) [] {
	s msoref(ii)=##class(%Dictionary.StorageSQLMapSubDefinition).%New()
	QUIT:$$$ISERR(msoref(ii)) msoref(ii)
	s msoref(ii).parent=map
	s msoref(ii).Name=ilev
	s msoref(ii).Expression=$lg(data,2)
	s nextcode=$lg(data,4),NextCode=""
	For i=1:1:$ll(nextcode) { s $p(NextCode,$c(13,10),i)=$c(9)_$lg(nextcode,i) }
	i NextCode'="" s msoref(ii).NextCode=NextCode
	//s sc=msoref.%Save(0)
	//QUIT:$$$ISERR(sc) sc
	If $lg(data,3)'="" {
		#;  Create Invalid Subscript Conditions
		s invcond=$lg(data,3)
		For i=1:1:$ll(invcond) s sc=$$CreateMapSubsInvCond(msoref(ii),$lg(invcond,i),i,.msicoref) q:$$$ISERR(sc)
		QUIT:$$$ISERR(sc) sc
	}
	//k msoref
	QUIT $$$OK
}
 
 
CreateMapSubsInvCond(mapsubs,cond,lev,msicoref) [] {
	s msicoref($i(msicoref))=##class(%Dictionary.StorageSQLMapSubInvalidconditionDefinition).%New()
	QUIT:$$$ISERR(msicoref(msicoref)) msicoref(msicoref)
	s msicoref(msicoref).parent=mapsubs
	s msicoref(msicoref).Name=lev
	s msicoref(msicoref).Expression=cond
	//s sc=msicoref.%Save(0)
	//k msicoref
	QUIT $$$OK
}
 
 
CreateMapData(ii,map,ilev,data,mdoref) [] {
	s mdoref(ii)=##class(%Dictionary.StorageSQLMapDataDefinition).%New()
	QUIT:$$$ISERR(mdoref(ii)) mdoref(ii)
	s mdoref(ii).parent=map
	s mdoref(ii).Name=$lg(data,1)
	s:$lg(data,2)'="" mdoref(ii).Node=$lg(data,2)
	s:$lg(data,3)'="" mdoref(ii).Piece=$lg(data,3)
	s:$lg(data,4)'="" mdoref(ii).Delimiter=$lg(data,4)
	s retcode=$lg(data,5),RetCode=""
	For i=1:1:$ll(retcode) { s $p(RetCode,$c(13,10),i)=$c(9)_$lg(retcode,i) }
	i RetCode'="" s mdoref(ii).RetrievalCode=RetCode
	//s sc=mdoref(ii).%Save(0)
	//k mdoref
	QUIT $$$OK
}
 
 
Classname(TableName) [] {
	If $d(^IRIS.TempFMI($j,"table",$$$UPPER(TableName)),d) QUIT $lg(d)	// Class already indexed
	s classname=$e($$$normalize(TableName),1,$$$maxShortClassnameLength) QUIT:classname="" ""
		#;  If Table already Queued, just return the name
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(classname)),d) {
		If $$$UPPER($lg(d,2))=$$$UPPER(TableName) QUIT $lg(d) 	// Already found
		f i=48:1:57,65:1:90,97:1:122 s $e(classname,$l(classname))=$c(i) i '$d(^IRIS.TempFMI($j,"class",$$$UPPER(classname))) q
	}
	s ^IRIS.TempFMI($j,"class",$$$UPPER(classname))=$lb(classname,TableName)
	s ^IRIS.TempFMI($j,"table",$$$UPPER(TableName))=$lb(classname,TableName)
	QUIT classname
}
 
 
PropName(Classname,FieldName) [] {
	s propname=$e($$$normalize(FieldName),1,31) QUIT:propname="" ""
		#;  If Field already Queued, just return the name
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"f",$$$UPPER(FieldName)),d) { QUIT $lg(d,2) }
		#;  Field not Queued, but propname already used, find a new propname
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"p",$$$UPPER(propname)),d) {
		f i=1:1 s $e(propname,$l(propname)-$l(i)+1,$l(propname))=i q:'$d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"p",$$$UPPER(propname)))
	}
	s ^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"p",$$$UPPER(propname))=$lb(Classname,propname,FieldName)
	s ^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"f",$$$UPPER(FieldName))=$lb(Classname,propname,FieldName)
	QUIT propname
}
 
 
TrigName(Classname,TrigName) [] {
	s tname=$e($$$normalize(TrigName),1,31) QUIT:tname="" ""
		#;  If Trigger already Queued, just return the name
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"ts",$$$UPPER(TrigName)),d) { QUIT $lg(d,2) }
		#;  Trigger not Queued, but tname already used, find a new tname
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"to",$$$UPPER(tname)),d) {
		f i=1:1 s $e(tname,$l(tname)-$l(i)+1,$l(tname))=i q:'$d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"to",$$$UPPER(tname)))
	}
	s ^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"to",$$$UPPER(tname))=$lb(Classname,tname,TrigName)
	s ^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"ts",$$$UPPER(TrigName))=$lb(Classname,tname,TrigName)
	QUIT tname
}
 
FKeyName(Classname,FKeyName) [] {
	s fkeyname=$e($$$normalize(FKeyName),1,31) QUIT:fkeyname="" ""
		#;  If Fkey already Queued, just return the name
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"fks",$$$UPPER(FKeyName)),d) { QUIT $lg(d,2) }
		#;  FKey not Queued, but fkeyname already used, find a new fkeyname
	If $d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"fko",$$$UPPER(fkeyname)),d) {
		f i=1:1 s $e(fkeyname,$l(fkeyname)-$l(i)+1,$l(fkeyname))=i q:'$d(^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"fko",$$$UPPER(fkeyname)))
	}
	s ^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"fko",$$$UPPER(fkeyname))=$lb(Classname,fkeyname,FKeyName)
	s ^IRIS.TempFMI($j,"class",$$$UPPER(Classname),"fks",$$$UPPER(FKeyName))=$lb(Classname,fkeyname,FKeyName)
	QUIT fkeyname
}
 
#DEFINE InitTotalTime n bigtime,starttime,time1 s bigtime=$zh,starttime=bigtime
#DEFINE InitTime s time1=$zh
#DEFINE ElapsedTime s time1=$zh-time1 w !,"Elapsed time: "_$s(time1>60:(time1\60)_" minutes ",1:"")_(time1#60)_" seconds"
#DEFINE RunningTotalTime i $d(bigtime) s bigtime=$zh-starttime w !,"Overall Elapsed Time so far: "_$s(bigtime>60:(bigtime\60)_" minutes ",1:"")_(bigtime#60)_" seconds"
#DEFINE ElapsedTotalTime i $d(bigtime) s bigtime=$zh-starttime w !!,"COMPLETE!",!,"Overall Elapsed Time: "_$s(bigtime>60:(bigtime\60)_" minutes ",1:"")_(bigtime#60)_" seconds"
 
Compile(compList,flags) ;
 
	$$$InitTotalTime
	n class,classlist,classlist2,cnt,compiled,i
	
	k classlist
	s class=""
	
	f  { s class=$o(compList(class)) q:class=""  d:'$d(compiled(class)) compit }
	i $g(flags)["d" $$$ElapsedTotalTime
	Quit
                 
                 
 
compit	;
		#; Get a list of related classes for this class
	Do BuildClassList(class,.classlist)
		#; Remove the already compiled classes from this list
	s i="" f  s i=$o(classlist(i)) q:i=""  i $d(compiled(i)) k classlist(i)
		#; Count how many will be compiled in this group
	s cnt=0,i="" f  { s i=$o(classlist(i)) q:i=""  s cnt=cnt+1 }
	If cnt>0 {
		If $g(flags)["d" $$$InitTime w !!,"Compiling class "_class_$s(cnt>1:" and "_cnt_" related classes",1:"")
			#; Compile the group of classes
		m classlist2=classlist  // CompileList will delete entries from classlist
		d CompileList^%apiOBJ(.classlist,$g(flags))
			#; Mark this list as being compiled
		m compiled=classlist2 k classlist,classlist2
		If $g(flags)["d" $$$ElapsedTime $$$RunningTotalTime
	}
	q
 
BuildClassList(class,classlist)
		#; classlist is an array passed by reference
	s classlist(class)="" Do GetRelatedClasses(class)
	QUIT
 
GetRelatedClasses(class)
		#; classlist and compiled are arrays global-in-scope to this procedure
	n p,package,type s p="",package=$$$AllButLastPiece(class,".")
	f  {
	        s p=$o(^oddDEF(class,"a",p)) q:p=""  
	        s type=^oddDEF(class,"a",p,5)
	        //i $e(type,1,$l($p(package,".")))=$p(package,".")
	        if $e(type)'="%",'$d(classlist(type)),'$d(compiled(type)) s classlist(type)="" d GetRelatedClasses(type)
	}
	Quit
	
	#;=========================================================================================================
	#;  Overflow from %fm2cache
	#;=========================================================================================================
 
CreateFMFilingTriggers(filen,gloref,subfile=0,parrefname="",parfile="",wpfid="") [] PUBLIC {
		#; ENTRY POINT TO CREATE FILING TRIGGERS - CALL THE FILEMAN FILER
		#;
		#;   subfile=0 = main file
		#;   subfile=1 = Sub File
		#;   subfile=2 = Not a sub-file, but a word-processing field
 
		#; Data is passed to and from the DBS as values in the FileMan Data Array (FDA). 
		#; The FDA contains the file, internal entry numbers, and field information in its subscripting scheme.
		#; The format of the FDA is:
		#;    FDA_ROOT(FILE#,"IENS",FIELD#)="VALUE"
 
		#; UPDATE^DIE(FLAGS,FDA_ROOT,IEN_ROOT,MSG_ROOT)
 
#define BigTrigger 16000
 
 	s errline="i $d(%FMERR("_filen_",""DIERR"")) { s U=""^"" d MSG^DIALOG(""AT"",.err,32768,,""%FMERR("_filen_")"") s %ok=0 f err=1:1:err { s $p(%msg,$c(13,10),err)=$g(err(err)) } q  }"
 	s BigTrigger=0
		#; BEFORE INSERT Trigger
	If subfile=0 {
		s code=$lb("n DISYS,DT,DTIME,DUZ,FDA,FDAIEN,IO,U,wp s FDAIEN(1)={IEN}")
		s fid="",wplist="" For  {
			s fid=$o(^IRIS.TempFMI($j,"fid",filen,fid),1,fdata) q:fid=""
			continue:$lg(fdata,3)=2	// No computed always fields
			If $lg(fdata,4)	{ s wplist=wplist_$lb(fid) continue  }	// No Word Processing fields - handled later
			s code=code_$lb("s:{"_$$quoter2($lg(fdata))_"}'="""" FDA("_filen_",""+1,"","_fid_")={"_$$quoter($lg(fdata))_"}")
			i $l(code)>$$$BigTrigger s BigTrigger=1 q
		}
		If BigTrigger {
			s code=$li(code,1,1)
			d ExternalTriggerCode(filen,.wplist,"ins","""s:$d(%d(""_$lg(fdata,5)_""))#2 FDA(""_filen_"",""""+1,"""",""_fid_"")=%d(""_$lg(fdata,5)_"")""")
			s code=code_$lb("^IRIS.TempFMI($j,""trig"",""ins"","_filen_")")
		}
		s code=code_$lb("d UPDATE^DIE("""",""FDA"",""FDAIEN"",""%FMERR("_filen_")"") s %SkipFiling=1")
		s code=code_$lb(errline)
		s c=0 For i=1:1:$ll(wplist) { 
			s fid=$lg(wplist,i)
			s c=c+1,fdata=^IRIS.TempFMI($j,"fid",filen,fid)
			s code=code_$lb("If {"_$$quoter2($lg(fdata))_"}'="""" { s D0={RowId} f i=1:1:$ll({"_$$quoter2($lg(fdata))_"}) { s wp(i)=$lg({"_$$quoter2($lg(fdata))_"},i) } d WP^DIE("_filen_",{RowId},"_fid_",,""wp"",""%FMERR("_filen_")"") "_errline_"}")
		}
		s code=code_$lb("QUIT")
	}
	ElseIf subfile=1 { 
		s code=$lb("n DISYS,DT,DTIME,DUZ,FDA,FDAIEN,iens,IO,U s FDAIEN(1)={IEN},iens=""+1,""_$p({IENS},"","",2,*)") 
		s fid="",wplist="" For  {
			s fid=$o(^IRIS.TempFMI($j,"fid",filen,fid),1,fdata) q:fid=""
			b:filen=1001
			continue:$lg(fdata,3)=2	// No computed always fields
			If $lg(fdata,4)	{ s wplist=wplist_$lb(fid) continue  }	// No Word Processing fields - handled later
			s code=code_$lb("s:{"_$$quoter2($lg(fdata))_"}'="""" FDA("_filen_",iens,"_fid_")={"_$$quoter2($lg(fdata))_"}")
			i $l(code)>$$$BigTrigger s BigTrigger=1 q
		}
		If BigTrigger {
			s code=$li(code,1,1)
			d ExternalTriggerCode(filen,.wplist,"ins","""s:$d(%d(""_$lg(fdata,5)_""))#2 FDA(""_filen_"",iens,""_fid_"")=%d(""_$lg(fdata,5)_"")""")
			s code=code_$lb("^IRIS.TempFMI($j,""trig"",""ins"","_filen_")")
		}
		s code=code_$lb("d UPDATE^DIE("""",""FDA"",""FDAIEN"",""%FMERR("_filen_")"") s %SkipFiling=1")
		s code=code_$lb(errline)
		s c=0 For i=1:1:$ll(wplist) {
			s fid=$lg(wplist,i)
			s c=c+1,fdata=^IRIS.TempFMI($j,"fid",filen,fid)
			s code=code_$lb("If {"_$$quoter2($lg(fdata))_"}'="""" { s D0={RowId} f i=1:1:$ll({"_$$quoter2($lg(fdata))_"}) { s wp(i)=$lg({"_$$quoter2($lg(fdata))_"},i) } d WP^DIE("_filen_",{IENS},"_fid_",,""wp"",""%FMERR("_filen_")"") "_errline_"}")
		}
		s code=code_$lb("QUIT")
	}
	ElseIf subfile=2 {	// Word-Processing Field
		s code=$lb("n DISYS,DT,DTIME,DUZ,FDA,FDAIEN,IO,U,wp")
		s fid=.01,fdata=$g(^IRIS.TempFMI($j,"fid",filen,fid)) b:fdata=""
		s code=code_$lb("s wp(1)={"_$$quoter2($lg(fdata))_"}")
		s code=code_$lb("d WP^DIE("_parfile_",$p({IENS},"","",2,*),"_wpfid_",""A"",""wp"",""%FMERR("_filen_")"") s %SkipFiling=1")
		s code=code_$lb(errline)
	}
	s ^IRIS.TempFM($j,filen,"t","BeforeInsertFiling")=$lb("INSERT","BEFORE",0,"BEFORE INSERT Trigger to perform filing",code)
 
		#; BEFORE DELETE Trigger
	If subfile=0 {
		s code=$lb("n %,%H,DA,DIC,DIK,DISYS,DT,DTIME,DUZ,IO,U,X,Y d DTNOLF^DICRW s DIK="_$$quoter(gloref)_" s DA={%%ID} d ^DIK s %SkipFiling=1 q  ")
	}
	ElseIf subfile=1 {
		s c=$l(gloref,$c(1))-1,gloref=$$quoter(gloref)
		s p=1 f  s p=$f(gloref,$c(1)) q:'p  s gloref=$e(gloref,1,p-2)_"""_DA("_c_")_"""_$e(gloref,p,$l(gloref)),c=c-1
		s code=$lb("n %,%H,c,DA,DIC,DIK,DISYS,DT,DTIME,DUZ,i,IO,U,X,Y d DTNOLF^DICRW s c=0 For i=$l({"_$$quoter2(parrefname)_"},""||""):-1:1 { s DA($i(c))=$p({"_$$quoter2(parrefname)_"},""||"",i) } s DIK="_gloref_",DA={IEN},%SkipFiling=1 d ^DIK q  ")
	}
	ElseIf subfile=2 {	// Word-Processing Field
		s code=$lb("n DISYS,DT,DTIME,DUZ,FDA,FDAIEN,i,iens,IO,U,wp For i=$l({"_$$quoter2(parrefname)_"},""||""):-1:1 { s iens=$p({"_$$quoter2(parrefname)_"},""||"",i)_"","" }")
		s code=code_$lb("d GETS^DIQ("_parfile_",iens,"_wpfid_",,""wp"",""%FMERR("_filen_",""""DIQERR"""")"")")
		s code=code_$lb(errline)
		s code=code_$lb("k wp("_parfile_",iens,"_wpfid_",{IEN})")
		s code=code_$lb("d WP^DIE("_parfile_",iens,"_wpfid_",,""wp("_parfile_",iens,"_wpfid_")"",""%FMERR("_filen_")"") s %SkipFiling=1")
		s code=code_$lb(errline)
	}
	s ^IRIS.TempFM($j,filen,"t","BeforeDeleteFiling")=$lb("DELETE","BEFORE",0,"BEFORE Trigger to perform filing",code)
 
 
 	s BigTrigger=0
		#; BEFORE UPDATE Trigger
	If subfile = 0 { 
		s code=$lb("n DISYS,DT,DTIME,DUZ,FDA,IENS,IO,U,wp,wproot s IENS={IEN}_"",""") 
		s fid="",wplist="" For  {
			s fid=$o(^IRIS.TempFMI($j,"fid",filen,fid),1,fdata) q:fid=""
			continue:$lg(fdata,3)=2	// No computed always fields
			If $lg(fdata,4)	{ s wplist=wplist_$lb(fid) continue  }	// No Word Processing fields - handled later
			s code=code_$lb("s:{"_$$quoter2($lg(fdata))_"*C} FDA("_filen_",IENS,"_fid_")={"_$$quoter2($lg(fdata))_"}")
			i $l(code)>$$$BigTrigger s BigTrigger=1 q
		}
		If BigTrigger {
			s code=$li(code,1,1)
			d ExternalTriggerCode(filen,.wplist,"upd","""s:$a(%e,""_$lg(fdata,5)_"") FDA(""_filen_"",IENS,""_fid_"")=%d(""_$lg(fdata,5)_"")""")
			s code=code_$lb("^IRIS.TempFMI($j,""trig"",""upd"","_filen_")")
		}
		s code=code_$lb("d:$d(FDA) UPDATE^DIE("""",""FDA"",""FDAIEN"",""%FMERR("_filen_")"") s %SkipFiling=1")
		s code=code_$lb(errline)
		For i=1:1:$ll(wplist) {
			s fid=$lg(wplist,i)
			s fdata=^IRIS.TempFMI($j,"fid",filen,fid)
			s code=code_$lb("If {"_$$quoter2($lg(fdata))_"*C} { s D0={RowId} k wp If {"_$$quoter2($lg(fdata))_"}'="""" { s wproot=""wp"" f i=1:1:$ll({"_$$quoter2($lg(fdata))_"}) { s wp(i)=$lg({"_$$quoter2($lg(fdata))_"},i) }} Else { s wproot=""@"" } d WP^DIE("_filen_",{RowId},"_fid_",,wproot,""%FMERR("_filen_")"") "_errline_"}")
		}
		s code=code_$lb("QUIT")
	}
	ElseIf subfile=1 { 
		s code=$lb("n DISYS,DT,DTIME,DUZ,FDA,n,IO,U,wp,wproot s IENS={IENS}") 
		s fid="",wplist="" For  {
			s fid=$o(^IRIS.TempFMI($j,"fid",filen,fid),1,fdata) q:fid=""
			continue:$lg(fdata,3)	// No computed fields
			If $lg(fdata,4)	{ s wplist=wplist_$lb(fid) continue  }	// No Word Processing fields - handled later
			s code=code_$lb("s:{"_$$quoter2($lg(fdata))_"*C} FDA("_filen_",IENS,"_fid_")={"_$$quoter2($lg(fdata))_"}")
			i $l(code)>$$$BigTrigger s BigTrigger=1 q
		}
		If BigTrigger {
			s code=$li(code,1,1)
			d ExternalTriggerCode(filen,.wplist,"upd","""s:$a(%e,""_$lg(fdata,5)_"") FDA(""_filen_"",IENS,""_fid_"")=%d(""_$lg(fdata,5)_"")""")
			s code=code_$lb("^IRIS.TempFMI($j,""trig"",""upd"","_filen_")")
		}
		s code=code_$lb("d:$d(FDA) UPDATE^DIE("""",""FDA"",""FDAIEN"",""%FMERR("_filen_")"") s %SkipFiling=1")
		s code=code_$lb("i $d(%FMERR("_filen_",""DIERR"")) { s %ok=0,%msg=""Call to FileMan Filer (UPDATE^DIE) failed.  See %FMERR("_filen_",""""DIERR"""") for details"" q  }")
		For i=1:1:$ll(wplist) {
			s fid=$lg(wplist,i)
			s fdata=^IRIS.TempFMI($j,"fid",filen,fid)
			s code=code_$lb("If {"_$$quoter2($lg(fdata))_"*C} { s D0={RowId} k wp If {"_$$quoter2($lg(fdata))_"}'="""" { s wproot=""wp"" f i=1:1:$ll({"_$$quoter2($lg(fdata))_"}) { s wp(i)=$lg({"_$$quoter2($lg(fdata))_"},i) }} Else { s wproot=""@"" } d WP^DIE("_filen_",{IENS},"_fid_",,wproot,""%FMERR("_filen_")"") "_errline_"}")
		}
	}
	ElseIf subfile=2 {	// Word-Processing Field
		s fid=.01,fdata=$g(^IRIS.TempFMI($j,"fid",filen,fid)) b:fdata=""
		s code=$lb("n DISYS,DT,DTIME,DUZ,FDA,FDAIEN,i,iens,IO,U,wp For i=$l({"_$$quoter2(parrefname)_"},""||""):-1:1 { s iens=$p({"_$$quoter2(parrefname)_"},""||"",i)_"","" }")
		s code=code_$lb("d GETS^DIQ("_parfile_",iens,"_wpfid_",,""wp"",""%FMERR("_filen_",""""DIQERR"""")"")")
		s code=code_$lb(errline)
		s code=code_$lb("s wp("_parfile_",iens,"_wpfid_",{IEN})={"_$$quoter2($lg(fdata))_"}")
		s code=code_$lb("d WP^DIE("_parfile_",iens,"_wpfid_",,""wp("_parfile_",iens,"_wpfid_")"",""%FMERR("_filen_")"") s %SkipFiling=1")
		s code=code_$lb(errline)
	}
	s ^IRIS.TempFM($j,filen,"t","BeforeUpdateFiling")=$lb("UPDATE","BEFORE",0,"BEFORE UPDATE Trigger to perform filing",code)
	QUIT
}
 
ExternalTriggerCode(filen,wplist,type,line) [fdata,fid,filen,lcnt,line,type,xline] PUBLIC {
	n fdata,fid,lcnt,xline
	s fid="",wplist="",lcnt=0,xline="" For  {
		s fid=$o(^IRIS.TempFMI($j,"fid",filen,fid),1,fdata) q:fid=""
		continue:$lg(fdata,3)=2	// No computed always fields
		If $lg(fdata,4)	{ s wplist=wplist_$lb(fid) continue  }	// No Word Processing fields - handled later
		x "s xline=xline_"" ""_"_line
		i $l(xline)>4000 s ^IRIS.TempFMI($j,"trig",type,filen,$i(lcnt))=$c(9)_$e(xline,2,$l(xline)) s xline=""
	}
	i xline'="" s ^IRIS.TempFMI($j,"trig",type,filen,$i(lcnt))=$c(9)_$e(xline,2,$l(xline)) s xline=""
}
 
multpc(filen,fid,tabname,fldnm,mainfield,icol,MAPNAME,gref) [] PUBLIC { 	// create all of the calculated fields
	s prefix=fldnm,stuff=^DD(filen,fid,0),SQLComputed=1,Transient=0
	s type="%Library.String" ; temporarily created as Text Data Type         
	//s TypeParam=$lb($lb("COLLATION","EXACT"))
	s fieldlength=255,TypeParam("MAXLEN")=255	// Default Length
	s x=$p(stuff,"^",5,99)
	i x["$L(X)>",+$p(x,"$L(X)>",2) s TypeParam("MAXLEN")=+$p(x,"$L(X)>",2),fieldlength=TypeParam("MAXLEN")	// MaxLen
	i x["$L(X)<",+$p(x,"$L(X)<",2) s TypeParam("MINLEN")=+$p(x,"$L(X),",2)					// MinLen
	s table="" 
	For one=1:1 {
			#; insert one desref computed field
		s table=$o(^DD(filen,fid,"V","B",table)) q:table=""
		s pointerName=$tr($p(^DD(filen,fid,"V",$o(^DD(filen,fid,"V","B",table,"")),0),"^",2)," "_"_")
		s fldnm=prefix_"_"_pointerName	//prefix_$e("00",$l(one),2)_one
		s fldnm=$$ddfieldu^%fm2cache(fldnm,filen) q:"*"[fldnm
		s desc="'"_$$ddtable^%fm2cache(table)_"'" ; Caption
		i 'table s ok=0,x="Invalid Pointer For Field #"_fid_". Omitted." d log^%fm2cache(x,"W")
			#; INSERT FIELD INFO INTO FIELD TABLE
		s ^IRIS.TempFM($j,filen,"f",$$$UPPER(fldnm))=$lb(fldnm,desc,type,0,fieldlength,"Exact",$g(SQLComputed,0),$g(Transient,0),$g(SQLComputedCode),,,,,TypeParam,$i(icol),1)
		s ^IRIS.TempFMI($j,"fid",filen,fid_"-"_table)=$lb(fldnm,desc,+$g(SQLComputed)+$g(Transient),0,icol)
		s ^IRIS.TempFMI($j,"desref",tabname,fldnm)=$lb(table,1)
		s mainfield(table)=$lb(fldnm,icol)
	}
		#; now we update the computations of all computed fields
 		#; input array is mainfield(table)=fldnm
	s MainSQLComputedCode="",MainSQLComputeOnChange=""
	s one="" For  {
		s one=$o(mainfield(one),1,fieldname) q:one=""
		s icol=$lg(fieldname,2),fieldname=$lg(fieldname)
		s SQLComputedCode=$lb("Quit:{"_$$quoter2(fieldname)_"}'=""""&&($Case($g(%oper),""INSERT"":1,""UPDATE"":1,:0))  If $p({"_$$quoter2(mainfield)_"},"";"",2,999)'="""_$$addquote($e($g(^DIC(one,0,"GL")),2,$l($g(^DIC(one,0,"GL")))))_""" s {"_$$quoter2(fieldname)_"}="""" Quit","s {"_$$quoter2(fieldname)_"}=$p({"_$$quoter2(mainfield)_"},"";"")")
		s RetrievalCode=$lb("If $p("_gref_","";"",2,999)'="""_$$addquote($e($g(^DIC(one,0,"GL")),2,$l($g(^DIC(one,0,"GL")))))_""" s {"_$$quoter2(fieldname)_"}="""" Quit","s {"_$$quoter2(fieldname)_"}=$p("_gref_","";"")")
		s ^IRIS.TempFM($j,filen,"m",MAPNAME,"d",$i(^IRIS.TempFM($j,filen,"m",MAPNAME,"d")))=$lb(fieldname,,,,RetrievalCode)
		s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fieldname)),7)=1	// SQL Computed
		s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fieldname)),8)=0	// NOT Computed Always (Transient)
		s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fieldname)),9)=SQLComputedCode
		s ^IRIS.TempFMI($j,"fid",filen,fid_"-"_one)=$lb(fldnm,desc,2,0)
		s MainSQLComputeOnChange=MainSQLComputeOnChange_$lb(fieldname)
		s xx=$$addquote($e($g(^DIC(one,0,"GL")),2,$l($g(^DIC(one,0,"GL")))))
		#;s MainSQLComputedCode=MainSQLComputedCode_$lb("i {"_fieldname_"}'="""",$p({"_mainfield_"},"";"",2,999)'="""_xx_""" s {"_mainfield_"}={"_fieldname_"}_"";"_xx_""" q")
			#;  Note, {Field*C} does not work in computed code so I have to revert to checking $a(%e,icol) to see if the field has changed.
			#;  Since this variable pointer field itself is not computed always it should be OK.
		s MainSQLComputedCode=MainSQLComputedCode_$lb("i ($g(%oper)=""INSERT""&&({"_$$quoter2(fieldname)_"}'=""""))||($a($g(%e),"_icol_")=1) s {"_$$quoter2(mainfield)_"}={"_$$quoter2(fieldname)_"}_"";"_xx_""" q")	// DPV3009
	}
	s MainSQLComputedCode=MainSQLComputedCode_$lb("s {"_$$quoter2(mainfield)_"}="""" ")
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(mainfield)),7)=1		// SQL Computed
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(mainfield)),8)=0		// Not Computed Always (Not Transient)
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(mainfield)),9)=MainSQLComputedCode
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(mainfield)),10)=MainSQLComputeOnChange
	QUIT
}
 
 
validact(syntax,action) ; return the action that is valid for mapping
		#; error out if it's not possible to map (e.g. parent not mapped)
		#; --- NOTE: this entry point assumes that syntax is CORRECT ---
		// *** fix
	n exit,i,max,x,y s exit="",max=$l(syntax,"->")
	s:$g(action)="" action="iu"
	s x=$p(syntax,"->",max),y=$p(x,"^",2),x=$p(x,"^")
	i x="" s exit="error" quit EXIT
	i y'="",'$d(^IRIS.TempFMI($j,"fid",x,+y)) d  QUIT exit
	. i $d(^IRIS.TempFM($j,x)),action["i" s exit="i" q
	. s exit="error" q
	i y'="" d  QUIT exit
	. i action'["u",action'["d" s exit="error" q
	. i action'="d" s exit="u" q
	. s exit="d" q
	i '$d(^IRIS.TempFM($j,x)) d  QUIT exit
	. i action'["i" s exit="error" q
	. s x=$p(syntax,"->",max-1),y=$p(x,"^",2),x=$p(x,"^",1)
	. s exit=$s(x="":"i",'$d(^IRIS.TempFM($j,x)):"error",1:"i") q
	i action'["u",action'["d" s exit="error"
	i action'="d" s exit="u"
	e  s exit="d"
	QUIT exit
 
 
syntax(filen,fid) ; 
	n syntax,up,y s syntax="",fid=$g(fid)
	i fid'="",'$d(^DD(filen,fid)) QUIT syntax
	i fid="" i $p($g(^DD(filen,.01,0)),"^",2)["W" { s syntax="W" } Else { s syntax=filen } d syntaxup QUIT syntax
	s y=$p($g(^DD(filen,fid,0)),"^",2)
		#; deal with word-processing fields
	i y?.n.1"."1.n.e,$p($g(^DD(+y,.01,0)),"^",2)["W" s y=$c(1)_"W"_$c(1)
		#; multiple field
	i y?.1"."1.n.e s syntax=filen_"^"_fid_"->"_(+y)
	e  d
	. ; last level, not a multiple filed
	. i fid=.01,y["W" s syntax="W" q  ; Word Processing
	. s syntax=filen_"^"_fid_$s(y=($c(1)_"W"_$c(1)):"W",1:"")
	d syntaxup
	QUIT syntax
 
 
syntaxup ;
	f  s up=$g(^DD(filen,0,"UP")) q:up=""  d  q:syntax=""
	. s fid=$o(^DD(up,"SB",filen,"")) i fid="" s syntax="" q
	. s filen=up,syntax=filen_"^"_fid_$s(syntax'="W":"->",1:"")_syntax
	q
 
 
keycomp(key,len,test) ; compress FileMan names to Cach format
		#; don't map fields/files starting with ...
	n i,j,tmp,x,y
	i $g(%fmnme) s j=0 d  i j QUIT "*" ; don't map - return '*'
	. f i=1:1:%fmnme d  q:j
	.. i %fmnme[$c(1) s x=$p(%fmnme,$c(1),i+1)
	.. e  s x=$g(^%qSQLKeys("fileman","name","data","nomap",i))
	.. i $e(key,1,$l(x))=x s j=1
	g:'$g(%fmnm) oldcomp ; if name mapping dsiabled do old
	f y="req","opt" s j="" d
	. f i=1:1 s j=$o(^%qSQLKeys("fileman","name","data",y,j)) q:j=""  d
	.. s tmp=^(j),key=$$trans(key,$p(tmp,$c(1)),$p(tmp,$c(1),2))
	i $g(%fmnmd) s key=$$dupelim(key)
oldcomp ; old style compression of key name
	s tmp=$tr(key," ","_"),key=""
	f  q:$e(tmp)?1AN  q:tmp=""  s tmp=$e(tmp,2,$l(tmp))
	s:tmp?1n.e tmp="f"_tmp
	f j=1:1:$l(tmp) i $e(tmp,j)'?1pc!($e(tmp,j)="_") s key=key_$e(tmp,j)
	s tmp=$$trans(key,"__","_")
	f j=1:1:$l(tmp)+1 q:$e(tmp,j)?1a
	s tmp=$e(tmp,j,$l(tmp))
		#; this is in the old case where vowels are stripped, etc...
	i '$g(test),$l(tmp)>len f j=$l(tmp):-1:2 i "AaEeIiOoUu"[$e(tmp,j) s tmp=$e(tmp,1,j-1)_$e(tmp,j+1,$l(tmp)) q:$l(tmp)'>len
	i '$g(test) s tmp=$e(tmp,1,len)
	q tmp
 
 
trans(st,from,to) ; translate words from 'from' to 'to' in 'st'ring
	i $$$UPPER(st)'[$$$UPPER(from) q st
	n x,y x "s x=("" "_$$$UPPER(st)_" ""'?.e1p1"""_$$$UPPER(from)_"""1p.e)"
	q:x st s y=1
trnsloop s x=$f($$$UPPER(st),$$$UPPER(from),y) q:x=0 st s y=x-1-$l(from)
	i $s(y=0:1,$e(st,y)?1p:1,1:0),$s(x=($l(st)+1):1,$e(st,x)?1p:1,1:0) d
	. s st=$e(st,1,y)_to_$e(st,x,$l(st)),y=y+$l(to)+1
	e  s y=x
	g trnsloop
 
 
dupelim(st) ; elimiante duplicate words from string
	n i,j,tmp,x,y s (tmp,x,y)=""
	f i=1:1:$l(st)+1 s j=$e(st_" ",i) s:j'?1p x=x_j d:j?1p
	. i x="",i'=1,$e(st,i-1)=j s j="" ; eliminate repeated punctuations
	. i x'="",$$$UPPER(x)=$$$UPPER(y) s x="" s:$e(tmp,$l(tmp))=j j=""
	. s tmp=tmp_x_j s:x'="" y=x s x=""
	q $e(tmp,1,$l(tmp)-1)
 
 
addquote(text) [] {
		#; Double The Quotes In A String
	 s newtext="" f i=1:1:$l(text) { s newtext=newtext_$e(text,i) i $e(text,i)="""" s newtext=newtext_"""" } QUIT newtext
}
 
 
