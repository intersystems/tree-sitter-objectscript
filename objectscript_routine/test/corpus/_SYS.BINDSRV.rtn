getClassLGInfo()
{
	// JMM192+ Continue supporting old metadata interface for Light C++ Binding
	// until LCB is modified to use the new inteface
	// if (%clientVersion '< $$$metaInfoBranch4)
	// {
	// 	s %err=$$$makeErr(-1, "getClassLGInfo() is deprecated", "")
	// 	$$$putErr(%err)
	// 	$$$putNext($$$OK)
	// }
	// JMM192-
 
try $$$setupTry
