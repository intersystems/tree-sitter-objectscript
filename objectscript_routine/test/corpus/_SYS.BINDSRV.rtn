LoadReadOnlyByQuery()
{
	s class=$$$ReadNext, query=$$$ReadNext, nargs=$$$ReadNext
	do:$$$logging ##class(%SYS.DBSRV).logappend("LoadReadOnlyByQuery: class = "_class_", query = "_query_", nargs = "_nargs)
	s list = ##class(%ListOfObjectsWithClassName).%New()
	s rs=##class(%ResultSet).%New("%DynamicQuery:SQL")
	s %qsc=rs.Prepare(query)
	$$$CheckStatus(%qsc)
	if nargs=0 d rs.Execute() goto LoadReadOnlyExecQuery
	if nargs=1 d rs.Execute($$$ReadNext) goto LoadReadOnlyExecQuery
	if nargs=2 d rs.Execute($$$ReadNext,$$$ReadNext) goto LoadReadOnlyExecQuery
	if nargs=3 d rs.Execute($$$ReadNext,$$$ReadNext,$$$ReadNext) goto LoadReadOnlyExecQuery
	if nargs=4 d rs.Execute($$$ReadNext,$$$ReadNext,$$$ReadNext,$$$ReadNext) goto LoadReadOnlyExecQuery
	if nargs=5 d rs.Execute($$$ReadNext,$$$ReadNext,$$$ReadNext,$$$ReadNext,$$$ReadNext) goto LoadReadOnlyExecQuery
	if nargs=6 d rs.Execute($$$ReadNext,$$$ReadNext,$$$ReadNext,$$$ReadNext,$$$ReadNext,$$$ReadNext) goto LoadReadOnlyExecQuery
	do ##class(%SYS.DBSRV).FlushError("Too many parameters to Prepare. Maximum is 6")
	RETURN
LoadReadOnlyExecQuery
	d rs.SetIdInfo(1,class)
	While rs.Next() {
		s obj = rs.GetObject()
		if obj=$$$NULLOREF { do ##class(%SYS.DBSRV).FlushError("Error opening object of class "_class_".") quit }
		d list.Insert(obj)
	}
	$$$WriteHeader
	Set Seen = ""
	Set %qsc = ##class(%Library.CPPStoredProc).cobjexportCollection($$$qdev,list)
	$$$CheckStatus(%qsc)
	
	$$$Flush0
	Quit
}
 
LoadReadOnlyByExec()
{
	set %debug=1
	d initServer(0)
	d setupMethodInfo()
	
	$$$StartRedirect
	
	for ii = 1:1:$$$getMtdNumArgs { xecute "s r"_ii_" = "_$$$getArgStr(ii) }
	s runMtd = "s "_$$$getMtdRetValStr_" = $zobj"
	s runMtd = runMtd_"classmethod("_$$$getMtdClassNameStr_", "_$$$getMtdNameStr
	for ii = 1:1:$$$getMtdNumArgs { s runMtd = runMtd_", .r"_ii }
	s runMtd = runMtd_")"
 
	xecute runMtd
 
	$$$StopRedirect
	$$$WriteHeader
	Set Seen=""
	$$$putNext($$$getMtdRetVal_"")
	for ii = 1:1:$$$getMtdNumArgs 
	{
		if ($$$isArgByRef(ii)) 
		{ 
			xecute "s "_$$$getArgStr(ii)_" = $g(r"_ii_")"
			$$$putNext($$$getArg(ii)_"")
		}
	}
	if $$$getMtdRetType=$$$clientTypeObjId,$IsObject($$$getMtdRetVal)
	{
		Set %qsc = ##class(%Library.CPPStoredProc).cobjexport($$$qdev,$$$getMtdRetVal)
		$$$CheckStatus(%qsc)
	}
	Set %qsc=$$$OK
	for ii = 1:1:$$$getMtdNumArgs 
	{
		if $$$isArgByRef(ii),$$$getArgType(ii)=$$$clientTypeObjId,$IsObject($$$getArg(ii))
		{ 
			Set %qsc = ##class(%Library.CPPStoredProc).cobjexport($$$qdev,$$$getArg(ii))
			$$$CheckStatus(%qsc)
		}
	}
	If %qsc'=$$$OK q
	
	$$$resetMtdInfo	
	k Seen
	$$$Flush0
	Quit
}
 
 // THE FOLLOWING CODE IS *ALMOST* THE SAME AS IN %SYS.DBSRV
 // UPDATES TO THIS MOST LIKELY NEED TO BE MADE IN %SYS.DBSRV AS WELL
 //==============
 
 // 1 piece at getCommon
 // 
 // srv_output_branch:
 // n pieces at getCommon
 // 
 // srv_output_branch1:
 // 1 piece at real time
 // 
 // srv_output_branch2:
 // 1 piece at real time + cache
 //
 // srv_output_branch3:
 // n pieces at real time + cache
 
addToOutput(str, func, val)      
{
	set lastGlobalRef = $$saveLastRef()
.
	$$$SysLog(3,"Output Redirection", func, val)
	
	if ($d($$$redirectOutput) && '$$$redirectOutput) {
		do revertLastRef(lastGlobalRef)
		return
	}
 
	if '$d($$$srv) { 
		set $$$srv=##class(%SYS.DBSRV).%New()
		set $$$srv.Logging=##class(%SYS.DBSRV).setupLogging($namespace)
		if $$$logging {
			do ##class(%SYS.DBSRV).logappend("New %SYS.DBSRV object created in addToOutput^%SYS.BINDSRV()")
		}
	}
.
	s jobInfo = $$$getJobInfo
	s:($$$qdev'="") %curqdev = $$$qdev
	s $$$qdev = $$$getDevice(jobInfo)
	s %clientVersion = $$$getClientVersion(jobInfo)
	s %useCache = $$$getUseCache(jobInfo)
	s %allowNestedCalls = $$$allowNestedCalls(jobInfo)
 
	d addToBufferedOutput(str)
	s:$d(%curqdev) $$$qdev = %curqdev
	if ($$$bufferSrvOutput) {
		do revertLastRef(lastGlobalRef)
		return
	}
	if (%clientVersion '< $$$srvOutputBranch1) {d sendBufferedOutput() }
 
	if ((%clientVersion < $$$srvOutputBranch2) || '%allowNestedCalls) { $$$flushOutputBuf }
	else
	{
		if (%useCache) { d cachePutData() }
		d SendMsg
		$$$setBufferSrvOutput(0)
		if (%useCache) { d $zu(177,0) }
	}
	do revertLastRef(lastGlobalRef)
}
.
saveLastRef() {
	$$$AddAllRoleTemporary
	return $zreference
}
.
revertLastRef(lastGlobalRef) {
	$$$AddAllRoleTemporary
	if lastGlobalRef'="" {
		set old68val=$zutil(68,1,1)
		try { if $data(@lastGlobalRef) } catch {}
		do $zutil(68,1,old68val)		
	}
}
 
addToBufferedOutput(str)
{
	if (($length($$$outLastPieceVar) + $length(str)) '> $$$maxOutputPieceLen) { 
		s $$$outLastPieceVar =$$$outLastPieceVar_str 
	}
	else 
	{
		i $i($$$outCountVar) 
		s $$$outLastPieceVar = str
	}
}
 
sendBufferedOutput()
{
	if ((%clientVersion < $$$srvOutputBranch) || ((%clientVersion '< $$$srvOutputBranch1) && (%clientVersion < $$$srvOutputBranch3)))
	{ 
		$$$putNext($$$outLastPieceVar) 
	}
	else
	{
		$$$putNext($$$outCountVar)
		for ii = 1:1:$$$outCountVar { $$$putNext($$$outPieceVar(ii)) }
	}
	$$$resetBufferedOutput
}
 
wstr(str) public
{
	// Write str
	d addToOutput(str, "wstr", str) 
}
 
wchr(ch) public
{
	// Write *a
	d addToOutput(ch, "wchr", ch) 
}
 
wtab(num) public
{
	// Write ?n 
	s str = ""
	for ii = 1:1:num { s str = str_" " }
	d addToOutput(str, "wtab", num) 
}
  
wnl() public
{
	// Write !
	d addToOutput($c(13,10), "wnl", "") 
}
 
wff() public
{
	// Write #
	d addToOutput($c(13,10,13,10), "wff", "") 
}
 
getRedirectedInput(len, time)
{
	s jobInfo = $$$getJobInfo
	s:($$$qdev'="") %curqdev = $$$qdev
	s $$$qdev = $$$getDevice(jobInfo)
 	s %clientVersion = $$$getClientVersion(jobInfo)
 
	if (%clientVersion < $$$inputRedirectionBranch)  { q "" }
 
	$$$putNext(len)
	$$$putNext(time)
	
	$$$Flush($$$InputRedirectionMsgId)
	$$$ReadHeader
	$$$setHeaderId1 $$$setHeaderId2
 
	$$$getNext(res)
	s:$d(%curqdev) $$$qdev = %curqdev
	q res
}
 
rstr(len,time) public
{
	q $$getRedirectedInput()
}
 
rchr(time) public
{
	q $$getRedirectedInput()
}
 
SendZobjVal()
{
	s oref = $$$ReadNext
	s obj = $zobjref(oref)
	s lval = ""
	s lmods= ""
	set $zt = "SendZobjValTrap"
	f i=1:1 Quit:'$d($zobjval(obj,i))  d
	. if ($d($zobjval(obj,i))=10)  {set val = ""} else {set val = $zobjval(obj,i)}
	. set lval = lval_$lb(val)
	. set lmods = lmods_$lb($zobjmods(obj,i))
SendZobjValTrap
	
	set $zt = ""
	$$$WriteHeader
	$$$putNext(i-1)
	$$$putNext(lval)
	$$$putNext(lmods)
	$$$Flush0
}
 
 //==============
 
DSSendResultSetAxes(rs)
{
	set axisCount = rs.%GetAxisCount()
	for axis = 0:1:axisCount {
		set status=rs.%GetAxisMembers(axis,.key)
		if ($$$ISERR(status)) {
			kill ^||DeepSee.AxisMembers			
			throw ##class(%Exception.StatusException).CreateFromStatus(status)
		}
				
		$$$putNext(axis)
 
		set tupleIdx = 1
		set memberIdx = 0
		while ($data(^||DeepSee.AxisMembers(key, axis, tupleIdx, memberIdx))) {
			while ($data(^||DeepSee.AxisMembers(key, axis, tupleIdx, memberIdx))) {
				$$$putNext(^||DeepSee.AxisMembers(key, axis, tupleIdx, memberIdx))								
				set memberIdx = memberIdx + 1
			}
			$$$putNextEndElem // tuple
		
			set tupleIdx = tupleIdx + 1
			set memberIdx = 0			
		}
		$$$putNextEndElem // axis
	}
	$$$putNextEndElem // axes
 
	kill ^||DeepSee.AxisMembers	
}
 
DSSendResultSetCellsInBatch(rs, ordinal)
{
	// ordinal is 0 based
	set axisCount = rs.%GetAxisCount()
	for axis = 1:1:axisCount {
		set axisSize(axis) = rs.%GetAxisSize(axis)
	}
	
	set ordinalOffsets(1) = 1
	for ii=2:1:axisCount set ordinalOffsets(ii) = ordinalOffsets(ii - 1) * axisSize(ii - 1)
	set totalCellCount = ordinalOffsets(axisCount) * axisSize(axisCount)
	
	set ordinalTemp = ordinal
	for ii=axisCount:-1:1 {
		set startIndexes(ii) = (ordinalTemp \ ordinalOffsets(ii)) + 1
		set ordinalTemp = ordinalTemp # ordinalOffsets(ii)
	}
	
	set flushedBatch = 0
	set cellCount = 0
	if (axisCount = 1) {
		for idx1=startIndexes(1):1:axisSize(1) {
			set cell = rs.%GetOrdinalValue(idx1)
			set flushedBatch = $$$putNextInBatch(cell)
			goto:flushedBatch finish
			set cellCount = cellCount + 1
		}
	}
	elseif (axisCount = 2) {
		for idx2=startIndexes(2):1:axisSize(2) {
			for idx1=startIndexes(1):1:axisSize(1) {
				set cell = rs.%GetOrdinalValue(idx1, idx2)
				set flushedBatch = $$$putNextInBatch(cell)
				goto:flushedBatch finish
				set cellCount = cellCount + 1
			}
		}
	}
	elseif (axisCount = 3) {
		for idx3=startIndexes(3):1:axisSize(3) {
			for idx2=startIndexes(2):1:axisSize(2) {
				for idx1=startIndexes(1):1:axisSize(1) {
					set cell = rs.%GetOrdinalValue(idx1, idx2, idx3)
					set flushedBatch = $$$putNextInBatch(cell)
					goto:flushedBatch finish
					set cellCount = cellCount + 1
				}
			}
		}
	}
	elseif (axisCount = 4) {
		for idx4=startIndexes(4):1:axisSize(4) {
			for idx3=startIndexes(3):1:axisSize(3) {
				for idx2=startIndexes(2):1:axisSize(2) {
					for idx1=startIndexes(1):1:axisSize(1) {
						set cell = rs.%GetOrdinalValue(idx1, idx2, idx3, idx4)
						set flushedBatch = $$$putNextInBatch(cell)
						goto:flushedBatch finish
						set cellCount = cellCount + 1
					}
				}
			}
		}
	}
	elseif (axisCount = 5) {
		for idx5=startIndexes(5):1:axisSize(5) {
			for idx4=startIndexes(4):1:axisSize(4) {
				for idx3=startIndexes(3):1:axisSize(3) {
					for idx2=startIndexes(2):1:axisSize(2) {
						for idx1=startIndexes(1):1:axisSize(1) {
							set cell = rs.%GetOrdinalValue(idx1, idx2, idx3, idx4, idx5)
							set flushedBatch = $$$putNextInBatch(cell)
							goto:flushedBatch finish
							set cellCount = cellCount + 1
						}
					}
				}
			}
		}
	}
	elseif (axisCount = 6) {
		for idx6=startIndexes(6):1:axisSize(6) {
			for idx5=startIndexes(5):1:axisSize(5) {
				for idx4=startIndexes(4):1:axisSize(4) {
					for idx3=startIndexes(3):1:axisSize(3) {
						for idx2=startIndexes(2):1:axisSize(2) {
							for idx1=startIndexes(1):1:axisSize(1) {
								set cell = rs.%GetOrdinalValue(idx1, idx2, idx3, idx4, idx5, idx6)
								set flushedBatch = $$$putNextInBatch(cell)
								goto:flushedBatch finish
								set cellCount = cellCount + 1
							}
						}
					}
				}
			}
		}
	}
	elseif (axisCount = 7) {
		for idx7=startIndexes(7):1:axisSize(7) {
			for idx6=startIndexes(6):1:axisSize(6) {
				for idx5=startIndexes(5):1:axisSize(5) {
					for idx4=startIndexes(4):1:axisSize(4) {
						for idx3=startIndexes(3):1:axisSize(3) {
							for idx2=startIndexes(2):1:axisSize(2) {
								for idx1=startIndexes(1):1:axisSize(1) {
									set cell = rs.%GetOrdinalValue(idx1, idx2, idx3, idx4, idx5, idx6, idx7)
									set flushedBatch = $$$putNextInBatch(cell)
									goto:flushedBatch finish
									set cellCount = cellCount + 1
								}
							}
						}
					}
				}
			}
		}
	}
	
	if (ordinal + cellCount '< totalCellCount) {
		$$$killDSRS(rs)
	}
	
finish
	if ('flushedBatch) {
		$$$flushOutput
	}
}
 
DSSendResultSetCells(rs)
{
	set axisCount = rs.%GetAxisCount()		
	for axis = 1:1:axisCount {
		set axisSize(axis) = rs.%GetAxisSize(axis)
	}
	
	if (axisCount = 1) {
		for idx1=1:1:axisSize(1) {
			set cell = rs.%GetOrdinalValue(idx1)
			$$$putNext(cell)
		}
	}
	elseif (axisCount = 2) {
		for idx2=1:1:axisSize(2) {
			for idx1=1:1:axisSize(1) {
				set cell = rs.%GetOrdinalValue(idx1, idx2)
				$$$putNext(cell)
			}
		}
	}
	elseif (axisCount = 3) {
		for idx3=1:1:axisSize(3) {
			for idx2=1:1:axisSize(2) {
				for idx1=1:1:axisSize(1) {
					set cell = rs.%GetOrdinalValue(idx1, idx2, idx3)
					$$$putNext(cell)
				}
			}
		}
	}
	elseif (axisCount = 4) {
		for idx4=1:1:axisSize(4) {
			for idx3=1:1:axisSize(3) {
				for idx2=1:1:axisSize(2) {
					for idx1=1:1:axisSize(1) {
						set cell = rs.%GetOrdinalValue(idx1, idx2, idx3, idx4)
						$$$putNext(cell)
					}
				}
			}
		}
	}
	elseif (axisCount = 5) {
		for idx5=1:1:axisSize(5) {
			for idx4=1:1:axisSize(4) {
				for idx3=1:1:axisSize(3) {
					for idx2=1:1:axisSize(2) {
						for idx1=1:1:axisSize(1) {
							set cell = rs.%GetOrdinalValue(idx1, idx2, idx3, idx4, idx5)
							$$$putNext(cell)
						}
					}
				}
			}
		}
	}
	elseif (axisCount = 6) {
		for idx6=1:1:axisSize(6) {
			for idx5=1:1:axisSize(5) {
				for idx4=1:1:axisSize(4) {
					for idx3=1:1:axisSize(3) {
						for idx2=1:1:axisSize(2) {
							for idx1=1:1:axisSize(1) {
								set cell = rs.%GetOrdinalValue(idx1, idx2, idx3, idx4, idx5, idx6)
								$$$putNext(cell)
							}
						}
					}
				}
			}
		}
	}
	elseif (axisCount = 7) {
		for idx7=1:1:axisSize(7) {
			for idx6=1:1:axisSize(6) {
				for idx5=1:1:axisSize(5) {
					for idx4=1:1:axisSize(4) {
						for idx3=1:1:axisSize(3) {
							for idx2=1:1:axisSize(2) {
								for idx1=1:1:axisSize(1) {
									set cell = rs.%GetOrdinalValue(idx1, idx2, idx3, idx4, idx5, idx6, idx7)
									$$$putNext(cell)
								}
							}
						}
					}
				}
			}
		}
	}
	
	$$$putNextEndElem // cells		
}
 
DSPrepareAndExecuteQueryCmn()
{
	$$$getNext(mdx)
	set args = ""
	$$$getNext(numArgs)
	do:$$$logging ##class(%SYS.DBSRV).logappend("DSPrepareAndExecuteQueryCmn: mdx = "_mdx_", numArgs = "_numArgs)
	for ii=1:1:numArgs {
		$$$getNext(name)
		$$$getNext(value)
		set args(name) = value
	}
	
	set tRS = ##class(%DeepSee.ResultSet).%ExecuteDirect(mdx, args, .pSC)
	$$$putNext(pSC)
	if ($$$ISERR(pSC)) { quit "" }
	
	d DSSendResultSetAxes(tRS)	
	
	quit tRS
}
 
DSPrepareAndExecuteQuery()
{
	set tRS = $$DSPrepareAndExecuteQueryCmn()
	if (tRS = "") { quit }
	
	d DSSendResultSetCells(tRS)		
}
 
DSPrepareAndExecuteQueryInBatch()
{
	try {
		set tRS = $$DSPrepareAndExecuteQueryCmn()
		if (tRS = "") { quit }
	
		$$$putNext($$$objToOref(tRS))
	
		$$$addDSRS(tRS)
		d DSSendResultSetCellsInBatch(tRS, 0)
	}
	catch {
		$$$flushOutput
		throw
	}
}
 
DSQuerySendNextBatch()
{
	try {
		$$$getNext(rsOref)
		$$$getNext(ordinal)
		do:$$$logging ##class(%SYS.DBSRV).logappend("DSQuerySendNextBatch: rsOref = "_rsOref_", ordinal = "_ordinal)
	
		set rs = $$$orefToObj(rsOref)
		d DSSendResultSetCellsInBatch(rs, ordinal)
	}
	catch {
		$$$flushOutput
		throw
	}
}
 
DSCloseQuery()
{
	$$$getNext(rsOref)
	do:$$$logging ##class(%SYS.DBSRV).logappend("DSCloseQuery: rsOref = "_rsOref)
	set rs = $$$orefToObj(rsOref)	
	$$$killDSRS(rs)
}
 
TCPProvider()
{
	$$$getNext(srvDelegateClass)
	do:$$$logging ##class(%SYS.DBSRV).logappend("TCPProvider: srvDelegateClass = "_srvDelegateClass)
	if (srvDelegateClass '= "") { set %tcpProvider = $zobjclassmethod(srvDelegateClass, "%New") }
	
	do %tcpProvider.ProcessMessage()
 }
 
