	{
		$$$getNext(elem)
		d $zobjmethod(oref,"Insert",elem)
		i $i(idx)
	}
}
	
JavaGetObjList()
{
try $$$setupTry
	d getCommon()
	$$$getNext(oref)
	$$$getNext(begin)
	$$$getNext(numElems)
	do:$$$logging ##class(%SYS.DBSRV).logappend("JavaGetObjList: oref = "_oref_", begin = "_begin_", numElems = "_numElems)
	
	s coln = $$$toClientObj(oref)
	s end = begin + numElems
	s idx = begin
	s elemList = ""
	s classNameList = ""
	while (idx < end)
	{
		s elem = $zobjmethod(coln, "GetAt", idx)
		if (elem="") { s className = "" }
		else
		{
			$$$initObjVar(elem)
			s className = $zobjclass(elem)
			s elem = $$$toInt(elem)
		}
		
		if (%clientVersion < $$$colnMsgBranch) 
		{
			s elemList = elemList_$lb(elem)
			s classNameList = classNameList_$lb(className)
		}
		else
		{ 
			$$$putNext(elem)
			$$$putNext(className)
		}		
		i $i(idx)
	}
	
	if (%clientVersion < $$$colnMsgBranch) { s %res = $lb(elemList, classNameList) }
	else { s %res = "" }
	
	goto finally
		
catch $$$setupCatchCmn
 
finally
	d putCommon()
}
 
JavaPutObjList()
