	do:$$$logging ##class(%SYS.DBSRV).logappend("getClassLGInfo: className = "_className)
	s sendDefs = 1
	
	s status = ##class(%CPPStoredProc).getClassDependencies(className, .dep)
	if ($$$ISERR(status)) { goto catch }
	
	s status = ##class(%CPPStoredProc).getWrapperClassDef(className, .clientDef)
	if ($$$ISERR(status)) { goto catch }	
	if ($i(classes)) { s classes(className) = clientDef }
 
	for idx = 1:1:$listLength(dep) 
	{
		s className = $list(dep, idx)
		s status = ##class(%CPPStoredProc).getWrapperClassDef(className, .clientDef)
		if ($$$ISERR(status)) { goto catch }	
		if ('$d(classes(className))) { if ($i(classes)) { s classes(className) = clientDef } }
	}
	goto finally
	
catch $$$setupCatchCmn
	if ('$d(status)) { s status = "" }
	s sendDefs = 0
	
finally	
	$$$putErr(%err) 
	$$$putNext(status)
	if ('sendDefs) { q }
	
	$$$putNext(classes)
	s idx = $o(classes(""))
	while (idx '= "")
	{
		d classes(idx).send()
		s idx = $o(classes(idx))
	}
}
 
