JavaBulkLoad()
	s %qrc=0,$ZT="JavaBulkLoadErr"		
	n query, class, list, rs, obj, args
	s list = ""
	d getCommon()
	s class=$$$ReadNext, query=$$$ReadNext, args=$$$ReadNext
	do:$$$logging ##class(%SYS.DBSRV).logappend("JavaBulkLoad: class = "_class_", query = "_query_", args = "_args)
	for i=1:1:args {
		set args(i)=$$$ReadNext
		do:$$$logging ##class(%SYS.DBSRV).logappend($c(9,9)_"args("_i_") = "_args(i))
	}
	s list = ##class(%Compiler.LG.QueryHelper).Query(class,query,.args)
	i $ZE'="" goto JavaBulkLoadErr
	$$$initObjVar(list)
	s err=""
	goto JavaBulkLoadFinally
JavaBulkLoadErr
	s $ZT=""
	i $ZE="" s err="" 
	e  s %err=$$$makeGenErr
	s $ZE=""
JavaBulkLoadFinally
	s $ZT=""
	i list="" s list=1
	s %res = $lb(list)
	d putCommon()
	q
 
