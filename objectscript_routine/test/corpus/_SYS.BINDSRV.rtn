getClassesDependencies()
{
	$$$getNext(numClasses)
	for ii = 1:1:numClasses 
	{
		$$$getNext(name)
		do:$$$logging ##class(%SYS.DBSRV).logappend("getClassesDependencies: name = "_name)
		s node(name) = ""
	}
	if (%clientVersion '< $$$metaInfoBranch3) { $$$getNext(inclSubCls) }
	else { s inclSubCls = 0 }
	
	s status = $$IncludeClasses^%occLGUtil(.node, .classes, %langType, 1, inclSubCls)
	$$$putNext(status)
	q:$$$ISERR(status)
 
 	s name = $o(classes(""))
 	while (name '= "")
 	{
	 	$$$putNext(name)
	 	$$$putNext("")
	 	s name = $o(classes(name))
 	}
}
 
