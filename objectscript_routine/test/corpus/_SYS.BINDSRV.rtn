LoadReadOnlyById()
{
	Set cls = $$$ReadNext
	Set id = $$$ReadNext
	do:$$$logging ##class(%SYS.DBSRV).logappend("LoadReadOnlyById: class = "_cls_", id = "_id)
	Set o = $zobjclassmethod(cls, "%OpenId", id, -1, .%qsc)
	$$$CheckStatus(%qsc)
	$$$WriteHeader
	Set %qsc = ##class(%Library.CPPStoredProc).cobjexport($$$qdev,o)
	$$$CheckStatus(%qsc)
	
	$$$Flush0
	Quit
}
 
LoadReadOnlyByOid()
{
	Set cls = $$$ReadNext
	if cls=""  set cls = "%Persistent"
	Set id = $$$ReadNext
	do:$$$logging ##class(%SYS.DBSRV).logappend("LoadReadOnlyByOid: class = "_cls_", oid = "_id)
	Set o = $zobjclassmethod(cls, "%Open", id, -1, .%qsc)
	$$$CheckStatus(%qsc)
	$$$WriteHeader
	Set %qsc = ##class(%Library.CPPStoredProc).cobjexport($$$qdev,o)
	$$$CheckStatus(%qsc)
	
	$$$Flush0
	Quit
