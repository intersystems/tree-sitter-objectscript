CPPinitPrimColn(isArr)
{
	$$$getNext(oref)
	do:$$$logging ##class(%SYS.DBSRV).logappend("CPPinitPrimColn: oref = "_oref)
	s coln = $$$toClientObj(oref)
	
	$$$putNext(coln.Count())
	s key = ""
	s val = coln.GetNext(.key)
	while (key '= "")
	{
		if (isArr) { $$$putNext(key) }
		$$$putNext(val)
		s val = coln.GetNext(.key)
	}
}		
 
CPPinitObjColn(isArr)
{
	$$$getNext(oref)	
	do:$$$logging ##class(%SYS.DBSRV).logappend("CPPinitObjColn: oref = "_oref)
	s coln = $$$toClientObj(oref)	
	
	$$$putNext(coln.Count())
	q:(isArr = 0)
	
	s key = ""
	d coln.GetNext(.key)
	while (key '= "")
	{
		$$$putNext(key)
		d coln.GetNext(.key)
	}	
}
 
OpenAllObjects()
{
try $$$setupTry
	d getCommon()
	
	$$$getNext(oref)
	do:$$$logging ##class(%SYS.DBSRV).logappend("OpenAllObjects: oref = "_oref)
	s coln = $$$toClientObj(oref)
	
	if (%clientVersion < $$$propertyPathsColnBranch) {
		d OpenAllObjectsList(coln)
	}
	else {
		$$$getNext(msgKind)
		if (msgKind = $$$openAllObjectsListRecursive) {
			d OpenAllObjectsList(coln)
		}
		elseIf (msgKind = $$$openAllObjectsListWithPropertyPaths) {
			d OpenAllObjectsListWithPropertyPaths(coln)			
		}
		elseIf (msgKind = $$$openAllObjectsArrayWithPropertyPaths) {
			d OpenAllObjectsArrayWithPropertyPaths(coln)			
		}
	}	
	
catch $$$setupCatchCmn
 
finally
	d putCommon()
}
 
OpenAllObjectsListWithPropertyPaths(coln)
{
	d OpenAllObjectsGetPropertyPaths(.propertyPaths)
	s count = coln.Count()
	$$$putNext(count)
	for idx = 1:1:count {
		s elem = coln.GetAt(idx)
		$$$initObjVar(elem)
		$$$putNext($$orefClientRep(elem))
		d OpenAllObjectsElemWithPropertyPaths(elem, .propertyPaths, .swizzledObjects)
	}
	d putAllSwizzledObjects(.swizzledObjects)
}
 
OpenAllObjectsArrayWithPropertyPaths(coln)
{
	d OpenAllObjectsGetPropertyPaths(.propertyPaths)
	s count = coln.Count()
	$$$putNext(count)
	s key = ""
	d coln.GetNext(.key)
	while (key '= "")
	{
		$$$putNext(key)
		s elem = coln.GetAt(key)
		$$$initObjVar(elem)
		$$$putNext($$orefClientRep(elem))
		d OpenAllObjectsElemWithPropertyPaths(elem, .propertyPaths, .swizzledObjects)
		d coln.GetNext(.key)
	}	
	d putAllSwizzledObjects(.swizzledObjects)
}
 
OpenAllObjectsGetPropertyPaths(propertyPaths)
{
	$$$getNext(className)
	while (className '= "") {
		$$$getNext(propName)
		while (propName '= "") {
			set propertyPaths(className, propName) = ""
			$$$getNext(propName)
		}
		$$$getNext(className)	
	}
}
 
OpenAllObjectsElemWithPropertyPaths(obj, propertyPaths, swizzledObjects)
{
	set className = $order(propertyPaths(""))
	while (className '= "") {
		if (obj.%Extends(className)) {
			set propertyPath = $order(propertyPaths(className, ""))
			while (propertyPath '= "") {
				d openObjectProperties(obj, propertyPath, .swizzledObjects)
				set propertyPath = $order(propertyPaths(className, propertyPath))
			}
		}
		set className = $order(propertyPaths(className))
	}
}
 
OpenAllObjectsList(coln)
{
	s count = coln.Count()
	$$$putNext(count)
	for idx = 1:1:count {
		s elem = coln.GetAt(idx)
		$$$initObjVar(elem)
		d OpenAllObjectsElem(elem)
	}
}
 
OpenAllObjectsArray(coln)
{
	s count = coln.Count()
	$$$putNext(count)
	s key = ""
	d coln.GetNext(.key)
	while (key '= "")
	{
		$$$putNext(key)
		s elem = coln.GetAt(key)
		$$$initObjVar(elem)
		d OpenAllObjectsElem(elem)
		d coln.GetNext(.key)
	}	
}
 
OpenAllObjectsElem(elem)
{
	$$$putNext($$orefClientRep(elem))
	if (elem.%IsA("%Collection.ListOfObj") || elem.%IsA("%Library.ListOfObjects")) { d OpenAllObjectsList(elem) }
	elseIf (elem.%IsA("%Collection.ArrayOfObj") || elem.%IsA("%Library.ArrayOfObjects") || elem.%IsA("%Library.RelationshipObject")) 
	{ d OpenAllObjectsArray(elem) }
}
 
