try $$$setupTry
	d getCommon()
	$$$getNext(orefn)
	s oref = $$$toClientObj(orefn)
	$$$getNext(count)
	do:$$$logging ##class(%SYS.DBSRV).logappend("JavaPutObjList: orefn = "_orefn_", count = "_count)
	s idx = 0
	while (idx < count)
	{
		$$$getNext(elem)
		d $zobjmethod(oref,"Insert",$$$toClientObj(elem))
		i $i(idx)
	}
	goto finally
	
catch $$$setupCatchCmn
	
finally
	s %res = 1
	d putCommon()
}
	
JavaGetPrimArr()
{
	$$$getNext(oref)
	$$$getNext(key)
	$$$getNext(maxNumElems)
	$$$getNext(dir)
	do:$$$logging ##class(%SYS.DBSRV).logappend("JavaPutPrimArr: oref = "_oref_", key = "_key_", maxNumElems = "_maxNumElems_", dir = "_dir)
	
	s coln = $$$toClientObj(oref)
	s res = ""
	s numElems = 0
	s idx = 0
	if (dir > 0) { s nextKey = "Next" }
	else { s nextKey = "Previous" }
	if (key = "") { s key = $zobjmethod(coln, nextKey, key) }
	
	while ((key '= "") && (numElems < maxNumElems))
	{
		s elem = $zobjmethod(coln, "GetAt", key)
		if (dir > 0) { s res=res_$lb(key, elem) }
		else { s res=$lb(key, elem)_res }
		
		i $i(numElems)
		s key = $zobjmethod(coln, nextKey, key)
	}
	
	s res = $lb(numElems)_res
	$$$putNext(res)
}
 
JavaPutPrimArr()
{
	$$$getNext(orefn)
	s oref = $$$toClientObj(orefn)
	$$$getNext(count)
	do:$$$logging ##class(%SYS.DBSRV).logappend("JavaPutPrimArr: orefn = "_orefn_", count = "_count)
	s idx = 0
	while (idx < count)
	{
		$$$getNext(key)
		$$$getNext(elem)
		d $zobjmethod(oref,"SetAt",key,elem)
		i $i(idx)
	}
	$$$putNext(1)
	q 0
}
	
JavaGetObjArr()
{
try $$$setupTry
	d getCommon()
	$$$getNext(oref)
	$$$getNext(key)
	$$$getNext(maxNumElems)
	$$$getNext(dir)
	do:$$$logging ##class(%SYS.DBSRV).logappend("JavaGetObjArr: oref = "_oref_", key = "_key_", maxNumElems = "_maxNumElems_", dir = "_dir)
 
	s coln = $$$toClientObj(oref)	
	s numElems = 0
	s idx = 0
	if (dir > 0) { s nextKey = "Next" }
	else { s nextKey = "Previous" }
	if (key = "") { s key = $zobjmethod(coln, nextKey, key) }
	s elemList = ""
	s classNameList = ""
	
	while ((key '= "") && (numElems < maxNumElems))
	{
		s elem = $zobjmethod(coln, "GetAt", key)
		if (elem="") { s className = "" }
		else
		{
			$$$initObjVar(elem)
			s className = $zobjclass(elem)
			s elem = $$$toInt(elem)
		}
		
		if (dir > 0) 
		{
			if (%clientVersion < $$$colnMsgBranch)
			{
				s elemList = elemList_$lb(key, elem)
				s classNameList = classNameList_$lb(className)
			}
			else
			{
				$$$putNext(key)				
				$$$putNext(elem)
				$$$putNext(className)
			}
		}
		else // don't need to support colnMsgBranch for the reverse direction
		{
			s elemList = $lb(key, elem)_elemList
			s classNameList = $lb(className)_classNameList
		}
				
		i $i(numElems)
		s key = $zobjmethod(coln, nextKey, key)
	}
	
	if ((%clientVersion < $$$colnMsgBranch)	|| (dir '> 0)) { s %res = $lb($lb(numElems)_elemList, classNameList) }
	else { s %res = "" }
	goto finally
	
catch $$$setupCatchCmn
 
finally
	d putCommon()
}
 
JavaPutObjArr()
{
try $$$setupTry
	d getCommon()
	$$$getNext(orefn)	
	s oref = $$$toClientObj(orefn)
	$$$getNext(count)
	do:$$$logging ##class(%SYS.DBSRV).logappend("JavaPutObjArr: orefn = "_orefn_", count = "_count)
	s idx = 0
	while (idx < count)
	{
		$$$getNext(elem)
		$$$getNext(key)
		d $zobjmethod(oref,"SetAt",$$$toClientObj(elem),key)
		i $i(idx)
	}
	goto finally
	
catch $$$setupCatchCmn
 
finally
	s %res = 1
	d putCommon()
}
