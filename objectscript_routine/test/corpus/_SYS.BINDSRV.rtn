transaction()
{
try $$$setupTry
	d getCommon()
	$$$getNext(id)
	do:$$$logging ##class(%SYS.DBSRV).logappend("transaction: id = "_id)
	
	if (id = 1) { tstart  goto finally }
	if (id = 2) { tcommit  goto finally }
	if (id = 3) { trollback  goto finally }
	if (id = 4) { s %res = $lb($tlevel) goto finally } 
 
catch $$$setupCatchCmn
	
finally
	d putCommon()
}
 
