	$$$getNext(numClasses)
	k classes
	for ii=1:1:numClasses { $$$getNext(class) s classes(class)="" }
	
	if (%clientVersion '< $$$metaInfoBranch6) 
	{ 
		$$$getNext(qspec)
		$$$getNext(mode)
	}
	else 
	{ s qspec = "", mode = $$$modeCppCodeGen }
	
	d OutputMetaInfo^%occMetaInfo($$$qdev, .classes, qspec,, mode)	
}
 
