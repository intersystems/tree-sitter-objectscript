getStatusMessage(status, lang)
{
	d DecomposeStatus^%apiOBJ(status, .elst, "", .lang)
	s msg = ""
	for ii=1:1:($g(elst)-1) { s msg=msg_elst(ii)_$c(13,10) }
	if ($g(elst) > 0) { s msg=msg_elst(elst) }
	q msg
}
 
getStatusInfo()
{
try $$$setupTry
	$$$getNext(status)
	$$$getNext(lang)
	do:$$$logging ##class(%SYS.DBSRV).logappend("getStatusInfo: status = "_status_", lang = "_lang)
	
	s code = $$$GETERRORCODE(status)
	s msg = $$getStatusMessage(status, lang)
	goto finally
	
catch $$$setupCatchCmn
 
finally
	$$$putErr(%err)
	$$$putNext($g(code))
	$$$putNext($g(msg))
}
 
