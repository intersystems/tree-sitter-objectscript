====
SYS.BINDSRV
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%SYS.BINDSRV^MAC^^^0
	#; %SYS.BINDSRV (old %bindserver) ; Cache Language Binding Server
 
#include %SYS.DBSRV
#include %SYS.BINDSRV
#include %occInclude
#include %occMetaInfo
  
 //==============
 
ObjectFunctions() 	; Called from %SYS.DBSRV class, now called with a do from %SYS.DBSRV instead of a goto ServerLoop
		#; return 1 is no error
		#; return 0 if error (goto Error in DBSRV)
		#; return -1 if we should disconnect (goto drvDC in DBSRV)
	goto ServerLoop
.
Dispatch ; Main server loop
	if $$$logging&&(%qfun'="") { do ##class(%SYS.DBSRV).log(%qfun_" END") set %msg="",%ROWCOUNT="" }
	If $$$srv.LCBmode {        // JMM188+
		If $g(LCBfinishedBINDSRV)'="" {
			kill LCBfinishedBINDSRV
			kill LCBfinishedDBSRV
			RETURN 1
		}
		s LCBfinishedBINDSRV=1
	} Else { // JMM188-
		Use $IO::"^%SYS.BINDSRV"
		do $zu(132)
	}      // JMM188=
	s %qrc=0
	set:$$$srv.ClientMaxIdleTime="" $$$srv.ClientMaxIdleTime=$$$GetClientMaxIdleTime
	if $$$srv.ClientMaxIdleTime {
		try {
			do $SYSTEM.Alarm.Set($$$srv.ClientMaxIdleTime)
			$$$ReadHeader
			do $SYSTEM.Alarm.Clear()
		} catch {
			If $ze["<ALARM" { 
				Set %qrc=450 
				Set %msg = "Client/Server connection was idle for "_$$$srv.ClientMaxIdleTime_" seconds, disconnecting"
				$$$LOG(%msg)
				RETURN -1
			}
		}
	} else {
		$$$ReadHeader
	}
ServerLoop
	If $$$srv.LCBmode {        // JMM188+
		If $g(LCBfinishedBINDSRV)=2 {
			kill LCBfinishedBINDSRV
			kill LCBfinishedDBSRV
			RETURN 1
		}
		s LCBfinishedBINDSRV=2   
	}                            // JMM188-	
	Use $IO::"^%SYS.BINDSRV"    	
	$$$setHeaderId1 $$$setHeaderId2
	if '$$$srv.LCBmode { $$$StartRedirectEx } // JMM188=
	
		#; DPV2293 Single security check for all non-SQL binding messages before checking the message.  
		#; There will also be one security check for all SQL messages in %SYS.DBSRV
	if '$SYSTEM.Security.Check($$$ServiceObjectResourceName,$$$PermUseAbrev) {
		set %qrc=-99,%msg=$$$ERROR($$$OperationRequires1,$$$PermUseName,$$$ServiceObjectResourceName),%msg=$$DecomposeStatus^%apiOBJ(%msg,.%msg) s:%msg %msg=%msg(1)
		do Audit99^%SYS.SQLSEC(%msg)
		RETURN 0
	}
 	
 	//Set $ZT="Error^%SYS.DBSRV"	// don't clear $ZE here as it prevents $ZE from being available to output method ,$ZE=""
 	do:$$$logging ##class(%SYS.DBSRV).log(%qfun_" BEGIN")
	i %qfun="B0" d start()                                          goto SendMsg
	i %qfun="B1" d stop(1)                                          goto SendMsg
	i %qfun="BP" d reset()                                          goto EndMsg
	i %qfun="B9" d openObj(0)                                       goto SendMsg
	i %qfun="BG" d openObj(1)                                       goto SendMsg
	i %qfun="BA" d delObj()                                         goto SendMsg
	i %qfun="BH" d getProp()                                        goto SendMsg
	i %qfun="BI" d setProp()                                        goto SendMsg
	i %qfun="B7" d runMethod(1)                                     goto SendMsg
	i %qfun="B8" d runMethod(0)                                     goto SendMsg
	i %qfun="BB" d transaction()                                    goto SendMsg	
	i %qfun="B5" d incRefCnt()                                      goto SendMsg
	i %qfun="B6" d decRefCnt(1)                                     goto SendMsg
	i %qfun="BJ" d getStatusInfo()                                  goto SendMsg
	i %qfun="BL" goto return
	i %qfun="BM" d sync()                                           goto SendMsg
 
	// C++ collections	
	i %qfun="BC" d CPPinitPrimColn(0)                               goto SendMsg
	i %qfun="BD" d CPPinitPrimColn(1)                               goto SendMsg
	i %qfun="BE" d CPPinitObjColn(0)                                goto SendMsg	
	i %qfun="BF" d CPPinitObjColn(1)                                goto SendMsg
	i %qfun="BQ" d OpenAllObjects()                                 goto SendMsg
	
	// Java collections
	i %qfun="M1" d JavaGetPrimList()                                goto SendMsg
	i %qfun="M2" d JavaGetPrimArr()                                 goto SendMsg
	i %qfun="M3" d JavaGetObjList()                                 goto SendMsg
	i %qfun="M4" d JavaGetObjArr()                                  goto SendMsg
	i %qfun="M5" d JavaPutPrimList()                                goto SendMsg
	i %qfun="M6" d JavaPutPrimArr()                                 goto SendMsg
	i %qfun="M7" d JavaPutObjList()                                 goto SendMsg
	i %qfun="M8" d JavaPutObjArr()                                  goto SendMsg
	i %qfun="M9" d JavaBulkLoad()                                   goto SendMsg
 
	// class information
	i %qfun="B2" d DynObjMetaInfo("ClassProperties")                goto SendMsg
	i %qfun="B3" d DynObjMetaInfo("ClassMethods")                   goto SendMsg
	i %qfun="B4" d DynObjMetaInfo("ClassQueries")                   goto SendMsg
	i %qfun="BK" d getClassInfo()                                   goto SendMsg
	i %qfun="BN" d getClassesDependencies()                         goto SendMsg
	i %qfun="MI" d getClassesInfo()                                 goto SendMsg
	i %qfun="MX" d getIndexesInfo()                                 goto SendMsg ; JMM031
	i %qfun="MT" d getLCClassesInfo()                                 goto SendMsg ; JMM0174, JMM246
	i %qfun="MP" d getParametersInfo()								goto SendMsg ; JMM598
	i %qfun="SE" d getSerializationInfo()                           goto SendMsg ; JMM031
	i %qfun="MG" d getClassGlobalInfo()								goto SendMsg ; JMM082
	i %qfun="PS" d getColnPropStorageInfo()                         goto SendMsg ; JMM225
	i %qfun="CT" d getPropTypeCategoryInfo()						goto SendMsg ; JMM226
	i %qfun="SV" d setClientVersion()								goto SendMsg ; JMM292, JMM301
	
	// Read-Only Load
	i %qfun="LI" d LoadReadOnlyById()                               goto EndMsg
	i %qfun="LO" d LoadReadOnlyByOid()                              goto EndMsg
	i %qfun="LQ" d LoadReadOnlyByQuery()                            goto EndMsg
	i %qfun="LE" d LoadReadOnlyByExec()                             goto EndMsg
 
	i %qfun="MZ" d SendZobjVal()									goto EndMsg
	
	// DeepSee
	i %qfun="D1" d DSPrepareAndExecuteQuery()                       goto SendMsg
	i %qfun="D2" d DSPrepareAndExecuteQueryInBatch()                goto EndMsg
	i %qfun="D3" d DSQuerySendNextBatch()                           goto EndMsg
	i %qfun="D4" d DSCloseQuery()                                   goto SendMsg	
	
	// TCP Provider
	i %qfun="WS" d TCPProvider()                                    goto SendMsg	
	
	$$$StopRedirect
return
	if $$$logging&&(%qfun'="") { do ##class(%SYS.DBSRV).log(%qfun_" END") set %msg="" }
	RETURN 1
 
SendMsg
	$$$flushOutput
	u $$$qdev if $zobjexport(51) {} // this turns on JLC1370
EndMsg
	$$$StopRedirect
	goto Dispatch
 
 //==============
 
orefClientRep(obj)
{
	do:$$$logging ##class(%SYS.DBSRV).logappend("orefClientRep: obj = "_obj)
	if ($isObject(obj)) { s className=$zobjclass(obj) }
	else { s className="" }
	q $$$objToOref(obj)_"@"_className
}
 
toClientObjChecked(oref)
{
	;;$$$LOG("toClientObjChecked: "_oref)
	do:$$$logging ##class(%SYS.DBSRV).logappend("toClientObjCheck: oref = "_oref)
	q:(oref = "") ""
	s oref = +oref
	if ($$$isClientOref(oref)) {
		q $$$orefToObj(oref)
	}
	
	s err = $$$makeErr($$$openOrefErr,"could not open oref "_oref, $lb(oref))
	// JMM718+
	// Return single, un-nested ref count error rather than
	// nested list of multiple ref count errors, for compatibility with .NET and C++
	// binding client code
	//s %refCntErrs=%refCntErrs_$lb(err)
	s:$g(%refCntErrs)="" %refCntErrs=err // JMM718-
	q ""
}
 
incRefCnt(obj)
{
	do:$$$logging ##class(%SYS.DBSRV).logappend("incRefCnt: obj = "_obj)
	s oref = $$$toInt(obj)
	q:(oref = 0)
	
	if '$d(%sysOrefs(oref)) { $$$addNewObj(oref) }
	s %sysOrefs(oref) = obj 
	if (%javaClient) { s %sysOrefs(oref, 1) = $g(%sysOrefs(oref, 1)) + 1 }
}
 
decRefCnt(asMsg)
{
try $$$setupTry
.
	$$$getNext(oref)
	do:$$$logging ##class(%SYS.DBSRV).logappend("decRefCnt: oref = "_oref)
	if (%javaClient) { $$$getNext(numRefs) }
 
	if ('%javaClient) 
	{
		if $d(%relationshipReferences(oref)) {
			Set referencingOref = $o(%relationshipReferences(oref,"")) 
			// go through everyone who is pointing back at the object to be closed
			while referencingOref '= ""
			{
				Set relatedProperty = $o(%relationshipReferences(oref,referencingOref,""))
				Set swizzleKey = $o(%relationshipReferences(oref,referencingOref,relatedProperty,""))
				if $d(%sysOrefs(referencingOref)) {
					Set relatedObject = $$$orefToObj(referencingOref)
					// if a bad entry (i.e., original referencer was closed and a different object has taken
					// its place) just remove the entry
					try {
						Set relationshipObject = $property(relatedObject,relatedProperty)
						if $IsObject(relatedObject) && $isObject(relationshipObject) {
							D relationshipObject.%UnSwizzleAt(swizzleKey)
							K %relationshipReferences(oref,referencingOref,relatedProperty,swizzleKey)
						}
					}
					catch propertyAccessException {
						K %relationshipReferences(oref,referencingOref,relatedProperty,swizzleKey)
					}
				}
				else {
					// clean up if referencer is not an object at this point
					Kill %relationshipReferences(oref,referencingOref)
				}
				Set referencingOref = $o(%relationshipReferences(oref,referencingOref))
			}
		}
		$$$killObjVar(oref)
		if (asMsg) { $$$putNext("") }
		q
	}
	
	if ('$d(%sysOrefs(oref, 1))) { zt "U"_oref }
	s obj = $$$toClientObj(oref)
	s %sysOrefs(oref, 1) = %sysOrefs(oref, 1) - numRefs
	if (%sysOrefs(oref, 1) < 0) { zt "RefCntErr" }
	if (%sysOrefs(oref, 1) = 0) $$$killObjVar(oref)
	if (asMsg) { $$$putNext("") }
	q
	
catch $$$setupCatch
	s err = $$$makeErr($$$closeObjErr,"could not close oref "_oref, $lb(oref, numRefs, $ZE))
	if (asMsg)
	{
		s %refCntErrs = err 
		$$$putErr(%refCntErrs)
	}
	// JMM718+
	// Return single, un-nested ref count error rather than
	// nested list of multiple ref count errors, for compatibility with .NET and C++
	// binding client code
	// else { s %refCntErrs=%refCntErrs_$lb(err) }
	else { s:$g(%refCntErrs)="" %refCntErrs=err } // JMM718-
}
  
 //==============
 
putCommon()
{
	do:$$$logging ##class(%SYS.DBSRV).logappend("putCommon")
	$$$putRes
	$$$putErr(%err)
	$$$putErr(%refCntErrs)
	if (%clientVersion < $$$srvOutputBranch1) { d sendBufferedOutput() }
 
	q:'%useCache
	d cachePutData() 
}
 
cachePutData()
{
	do:$$$logging ##class(%SYS.DBSRV).logappend("cachePutData")
	d $zu(177,2) 
	s cacheData = $zu(177,3)
	
	if ((cacheData = "") && '$d(%changedObjs))
	{
		$$$putNext(0)
		d $zu(177,1)
		q
	}
	
	if ('$d(%changedObjs)) { $$$resetChangedObjs }
	
	for idx = 1:4 
	{
		s oref = $zla(cacheData,idx) 
		q:(oref = -1)
		if ($$$isClientOref(oref)) { $$$addChangedObj(oref) }
	}
	
	$$$putNext(%changedObjs)
	s oref = $o(%changedObjs(""))
	while (oref '= "") 
	{
		d zobjvalPutWire(oref)
		s oref = $o(%changedObjs(oref))
	}
	
	$$$resetChangedObjs
	$$$resetNewObjs
	
	d $zu(177,1)
}
 
zobjvalPutWire(oref)
{
	$$$putNext(oref)
	do:$$$logging ##class(%SYS.DBSRV).logappend("zobjvalPutWire: oref = "_oref)
	s obj = $$$toClientObj(oref)
	if (%clientVersion '< $$$sendOidBranch) { $$$putNext($$$objOID(obj)) }
	if ($$$isNonCacheableObj(obj)) { $$$putNext(0) }
	else 
	{
		if (%clientVersion < $$$sendZobjvalDiffsBranch) 
		{
			$$$putNext(obj)
			q
		}
		else
		{
			if ($$$isNewObj(oref)) { 
				$$$putNextWholeObj(obj) 
			}
			else { 
				$$$putNextDiffs(obj) 
			}
		}
	}
}	
 
 //==============
 
getCommon()
{
	q:'%useCache
	d cacheGetData()
	
	$$$getNext(numObjs)
	do:$$$logging ##class(%SYS.DBSRV).logappend("getCommon: numObjs = "_numObjs)
	for idx = 1:1:numObjs { d decRefCnt(0) }	
}
 
cacheGetData() // cannot be a procedure (indirect execution)
	new numProps, idx, oref, ii, jj, modFlag, val, obj, propName, mtdName
	d $zu(177,0)
	
	$$$getNext(numProps)
	do:$$$logging ##class(%SYS.DBSRV).logappend("getCacheData: numProps: "_numProps)
	for idx = 1:1:numProps 
	{
		$$$getNext(oref)
		$$$getNext(ii)
		$$$getNext(jj)
		$$$getNext(modFlag)
		$$$getNext(val)
		
		s obj = $$$toClientObj(oref)
		s slot = ii + 16384
		
		s change = 0
		if ('$d($zobjval(obj,slot,0,3,slot))) { s change = 1 }
		else { if ($zobjval(obj,slot,0,3,slot) '= val) { s change = 1 } }
 
		if (change) { s $zobjval(obj,slot,0,3,slot) = val }
	}
	
	$$$getNext(numProps)
	for idx = 1:1:numProps 
	{
		$$$getNext(oref)
		$$$getNext(propName)
		$$$getNext(val)
		
		s obj = $$$toClientObj(oref)
		s val = $$$toClientObj(val)
		s mtdName = propName_"Set"
		d $zobjmethod(obj, mtdName, val)
	}	
	q
 
 //==============
 
setClientVersion() // JMM292+
{
	// setClientVersion() is called when LCB uses a device-only connection, on behalf of
	// JNI-based Java object API, because start() is not called in that case, but
	// %clientVersion is still needed.
	$$$getNext(%clientVersion)
	s okVer = (%clientVersion '< $$$srvVerCutOff)
	do:$$$logging ##class(%SYS.DBSRV).logappend("setClientVersion: %clientVersion = "_%clientVersion_", okVer = "_okVer)
	$$$putNext(okVer) 
}                  // JMM292-
 
start()
{
 	d initServer(1)
 
	s okVer = (%clientVersion '< $$$srvVerCutOff)
	do:$$$logging ##class(%SYS.DBSRV).logappend("start: okVer = "_okVer)
	$$$putNext(okVer) 
	$$$putNext($$$serverVersion) 
	$$$putNext($zbitget($zversion(0),1)) 
	$$$putNext($namespace) 
	$$$putNext($zv) 
	$$$putNext($$$PRODUCTVERSIONSTR) 
	$$$putNext(+$J)
	
	// connection properties
	$$$putNext(2) // count
	$$$putNext("IYB638") // support message BP (reset)
	$$$putNext(1)
	$$$putNext("IYB647") // support message BQ (open all objects from a collection)
	$$$putNext(1)
}
 
initServer(rwMode)
{
	
	if ('$d(%jobBufferDefined)) 
	{ 
		$$$initjobbuffer 
		s %jobBufferDefined = 1
	}
	$$$getNext(%clientVersion) 
	if (rwMode) { $$$getNext(cacheType) }
	$$$getNext(%javaClient)
	$$$getNext(%debug)
	do:$$$logging ##class(%SYS.DBSRV).logappend("initServer: rwMode = "_$g(rwMode)_", %clientVersion = "_$g(%clientVersion)_", %javaClient = "_$g(javaClient)_", %debug = "_$g(debug))
	
	if (%javaClient) { s %langType = 2 }
	else { s %langType = 1 }	
	
	if (rwMode)
	{
		s %connections = $g(%connections) + 1
		if (%connections=1){
			
			s %useCache = (cacheType '= 0)
			s $$$useCacheVar = %useCache
			s %refCntErrs = ""
		}
	}
	if ($g(%connections)<2){
		s %res = ""
		s %err = ""
		s $$$outCountVar = ""
		$$$setBufferSrvOutput(1)
	
		if ('$d(%mtdInfo))
		{
			s %mtdInfo = 0 $$$initMtdInfo
			$$$resetMtdInfo
		}
	
		$$$resetBufferedOutput
		if (rwMode) { $$$resetChangedObjs }
	
		$$$setMaxMDPropLen(0)
	}
	
	s %allowNestedCalls = 1
	$$$setJobInfo($$$bldJobInfo)
}
 
stop(sendResponse)
{
try $$$setupTry
	d getCommon()
	do:$$$logging ##class(%SYS.DBSRV).logappend("stop: sendResponse = "_sendResponse)
	
	s errData = ""
	s %connections = %connections - 1
	i %connections>0 goto return
	s node = $o(%sysOrefs(""), 1, oref)
	while (node '= "")
	{
		if (node '= 0) { s errData = errData_$lb(node, $zobjclass(oref)) }
		s node = $o(%sysOrefs(node), 1, oref)
	}	
	goto finally 
 
catch $$$setupCatch
	s %err = ""
 
finally 
	$$$closeServer
return	
	if (errData '= "") { s %err = $$$makeErr($$$closeObjsErr, "forcefully closed some objects", errData) }
	
	if (sendResponse)
	{
		$$$putErr(%refCntErrs) 
		$$$putErr(%err)
	}
}
 
reset()
{
	do:$$$logging ##class(%SYS.DBSRV).logappend("reset")
	do ##class(%SYS.DBSRV).ResetConnection()
	do stop(0)
	do initServer(1)
	RETURN
}
 
	/// Called from %Net.Remote.Java.JDBCGateway.%ProcessError()
pushFrame(cacheType="") PUBLIC
{
	do:$$$logging ##class(%SYS.DBSRV).logappend("pushFrame: cacheType = "_cacheType)
	set %bindserverFrame = $g(%bindserverFrame) + 1
	Merge:$d(%mtdInfo) %bindserverFrame(%bindserverFrame,1)=%mtdInfo
	Set %bindserverFrame(%bindserverFrame,2)=$g(%qacn)
	Set %bindserverFrame(%bindserverFrame,3)=$g(%qmsgid)
	if ($$$qdev'="") Set %bindserverFrame(%bindserverFrame,4)=$$$qdev
	else  k %bindserverFrame(%bindserverFrame,4)
	Set %bindserverFrame(%bindserverFrame,14)=$g(%useCache)
	set:cacheType'="" %useCache = (cacheType '= 0)
	Set %bindserverFrame(%bindserverFrame,15)=$g(%refCntErrs)
	s %refCntErrs = ""
	Set %bindserverFrame(%bindserverFrame,16)=$g(%res)
	s %res = ""
	Set %bindserverFrame(%bindserverFrame,17)=$g(%err)
	s %err = ""
	s:$d($$$outCountVar) %bindserverFrame(%bindserverFrame,18)= $$$outCountVar
	Merge:$d(^||BindSrvOutPieceVar) %bindserverFrame(%bindserverFrame,19)= ^||BindSrvOutPieceVar
	$$$resetBufferedOutput
	Quit $$$OK
}
 
	/// Called from %Net.Remote.Java.JDBCGateway.%ProcessError()
popFrame() PUBLIC
{
	do:$$$logging ##class(%SYS.DBSRV).logappend("popFrame")
	Set %qacn = %bindserverFrame(%bindserverFrame,2)
	Set %qmsgid = %bindserverFrame(%bindserverFrame,3)
	Set oldQdev = $d(%bindserverFrame(%bindserverFrame,4))
	if (oldQdev) { Set $$$qdev = %bindserverFrame(%bindserverFrame,4) }
	else  { set $$$qdev="" }
	//Set %useCache = %bindserverFrame(%bindserverFrame,14)
	Set %refCntErrs = %bindserverFrame(%bindserverFrame,15)
	Set %res = %bindserverFrame(%bindserverFrame,16)
	Set %err = %bindserverFrame(%bindserverFrame,17)
	If ($d(%bindserverFrame(%bindserverFrame,1))) {
		Merge %mtdInfo=%bindserverFrame(%bindserverFrame,1)
		if (oldQdev) $$$setHeaderId1 $$$setHeaderId2
	}
	$$$resetBufferedOutput
	s:$d(%bindserverFrame(%bindserverFrame,18)) $$$outCountVar = %bindserverFrame(%bindserverFrame,18)
	Merge:$d(%bindserverFrame(%bindserverFrame,19)) ^||BindSrvOutPieceVar = %bindserverFrame(%bindserverFrame,19)
	k %bindserverFrame(%bindserverFrame)
	set %bindserverFrame = %bindserverFrame - 1
	Quit $$$OK
}
 
 //==============
 
openObj(openid)
{
try $$$setupTry
	d getCommon()
	if (openid) { $$$getNext(className) }
	$$$getNext(id)
	$$$getNext(concurrency)
	$$$getNext(timeout)
	do:$$$logging ##class(%SYS.DBSRV).logappend("openObj: id = "_id_", concurrency = "_concurrency_", timeout = "_timeout)
	
	set numPropertyPaths = 0
	if (%clientVersion '< $$$propertyPathsBranch) {
		$$$getNext(openObjExtKind)
		if (openObjExtKind = $$$openObjPropertyPathsSimpleList) {
			$$$getNext(propertyPath)
			while (propertyPath '= "") {
				i $i(numPropertyPaths)
				set propertyPaths(numPropertyPaths) = propertyPath
				$$$getNext(propertyPath)
			}
		}
	}
	
	if (openid) { s mtdName = "%OpenId" }
	else 
	{
		s mtdName = "%Open"
		s className = $$$getClassName(id)
	}
 
	s curTimeout = $zu(115,4)
	s status = 1
	if (timeout '= -1) d $zu(115, 4, timeout)
	if (concurrency = -1) { s %res = $zobjclassmethod(className, mtdName, id, , .status) }
	else { s %res = $zobjclassmethod(className, mtdName, id, concurrency, .status) }
	d $zu(115, 4, curTimeout)
	
	$$$initObjVar(%res)
	s obj = %res
	s %res = $lb($$orefClientRep(%res))
	
	if (%clientVersion '< $$$propertyPathsBranch) {
		if ($$$ISOK(status)) {
			for ii=1:1:numPropertyPaths {
				s propertyPath = propertyPaths(ii)
				d openObjectProperties(obj, propertyPath, .swizzledObjects)
			}
		}
		d putAllSwizzledObjects(.swizzledObjects)
	}
	
	goto finally
	
catch $$$setupCatchCmn
	s status = $$$ERROR($$$ObjectScriptError, $ZE)
	
finally
	if $$$ISERR(status) 
	{
		if (openid) { s msg = "couldn't open object (%OpenId)" }
		else { s msg = "couldn't open object (%Open)" }
		s %err = $$$makeErr($$$openObjErr, msg, $lb($$$GETERRORCODE(status), status))
	}
	d putCommon()
}
 
openObjectProperties(obj, propertyPath, swizzledObjects)
{
	s numProps = $length(propertyPath,".")
	s propObj = obj
	for jj=1:1:numProps {
		s property = $piece(propertyPath,".",jj)
		s propObj = $zobjproperty(propObj,property)
		q:propObj=""
		$$$initObjVar(propObj)
		s swizzledObjects($$$objToOref(propObj)) = propObj
	}
}
 
putAllSwizzledObjects(swizzledObjects) 
{
	s propObjOref = $order(swizzledObjects(""))
	while (propObjOref '= "") {
		$$$putNext($$orefClientRep(swizzledObjects(propObjOref)))
		s propObjOref = $order(swizzledObjects(propObjOref))
	}
	$$$putNext("")	
}
 
delObj()
{
try $$$setupTry
	$$$getNext(oid)
	$$$getNext(concurrency)
	do:$$$logging ##class(%SYS.DBSRV).logappend("delObj: oid = "_oid_", concurrency = "_concurrency)
	
	s %res = $zobjclassmethod($$$getClassName(oid),"%Delete", oid, concurrency)
	goto finally
	
catch $$$setupCatchCmn
 
finally
	$$$putErr(%err)
	$$$putRes
}
 
 //==============
 
getProp()
{
	if (%clientVersion < $$$streamPropBranch)
	{
		d getPropBranch()
		q
	}
	
try $$$setupTry
	d getCommon()
	$$$getNext(oref)
	$$$getNext(propName)
	$$$getNext(typeId)
	do:$$$logging ##class(%SYS.DBSRV).logappend("getProp: oref = "_oref_", propName = "_propName_", typeId = "_typeId)
 
 	s obj = $$$toClientObj(oref)
 	
	Set class = $classname(obj)
	$$$comMemberKeyGetLvar(relationship,class,$$$cCLASSproperty,propName,$$$cPROPrelationship)
	$$$comMemberKeyGetLvar(cardinality,class,$$$cCLASSproperty,propName,$$$cPROPcardinality)
	$$$comMemberKeyGetLvar(relatedType,class,$$$cCLASSproperty,propName,$$$cPROPtype)
	$$$comMemberKeyGetLvar(inverse,class,$$$cCLASSproperty,propName,$$$cPROPinverse)
	
	s val = $zobjproperty(obj, propName)
.
	if $IsObject(val) && relationship=1 && $$$classIsPersistent(relatedType) {
		if ($G(cardinality)="one")||($G(cardinality)="parent") {
			 Set inverseProperty = $property(val,inverse)
			 Set currentObjId = obj.%Id()
			 Do {
				Set item = inverseProperty.GetObjectIdNext(.key)
				If (item '= "") {
					if item=currentObjId {
						Set %relationshipReferences(+obj,+val,inverse,key) = ""
					}
				}
			 } While (key '= "")
		}
	}
	
	if (typeId = $$$clientTypeObjId) { $$$initObjVar(val) }	
.
	goto finally
	
catch $$$setupCatchCmn
	
finally
	d putCommon()
 
	if ((typeId = $$$clientTypeLongStrId) || (typeId = $$$clientTypeLongBinId)) { d putStreamWire(val) }
	elseif (typeId = $$$clientTypeObjId) { $$$putNext($$orefClientRep(val)) }
	else { $$$putNext(val) }
}
 
getPropBranch()
{
try $$$setupTry
	d getCommon()
	$$$getNext(oref)
	$$$getNext(propName)
	$$$getNext(isObj)
	do:$$$logging ##class(%SYS.DBSRV).logappend("getPropBranch: oref = "_oref_", propName = "_propName_", isObj = "_isObj)
 
	s obj = $$$toClientObj(oref)
	s %res = $zobjproperty(obj, propName)
	if (isObj) 
	{
		$$$initObjVar(%res)
		s %res = $$orefClientRep(%res)
	}
		
	s %res = $lb(%res)
	goto finally
	
catch $$$setupCatchCmn
	
finally
	d putCommon()
}
 
setProp()
{
try $$$setupTry
	d getCommon()
	$$$getNext(oref)
	$$$getNext(propName)
	do:$$$logging ##class(%SYS.DBSRV).logappend("setProp: oref = "_oref_", propName = "_propName)
 
	s obj = $$$toClientObj(oref)
	
	if (%clientVersion < $$$streamPropBranch) 
	{
		$$$getNext(isObj)
		$$$getNext(val)
		if isObj { s val = $$$toClientObj(val) }
	}
	else 
	{
		$$$getNext(typeId)
		if ((typeId = $$$clientTypeLongStrId) || (typeId = $$$clientTypeLongBinId))
		{
			s val = $zobjproperty(obj, propName)
			d getStreamWire(val)
			goto finally
		}
		else
		{
			$$$getNext(val)
			if (typeId = $$$clientTypeObjId) { s val = $$$toClientObj(val) }
		}
	}
 
	s $zobjproperty(obj, propName) = val
	goto finally
	
catch $$$setupCatchCmn
 
finally
	d putCommon()
}
 
 //==============
 
runMethod(isFunc)
{
	$$$initMtdInfo
	d getCommon()
	if (%clientVersion < $$$descrArgsBranch) { d setupMethodInfoBranch() }
	else { d setupMethodInfo() }
	do:$$$logging ##class(%SYS.DBSRV).logappend("runMethod: isFunc = "_isFunc)
	
	$$$setBufferSrvOutput(0)
	
try $$$setupTry
	d runMtdLow(isFunc)
	if (%clientVersion < $$$descrArgsBranch) { d setupMtdRetValBranch() }
	goto finally
	
catch $$$setupCatchCmn
 
finally
	if ((%clientVersion '< $$$srvOutputBranch1)) 
	{ 
		if (($$$outCountVar > 1) || ($length($$$outLastPieceVar) > 0)) { d addToOutput("", "", "") }
		$$$putNextEndElem
	}
	$$$setBufferSrvOutput(1)
	
	if (%clientVersion '< $$$mtdExceptions)
	{
		s e = $g($$$getExceptionInfo)
		if (e = "") { $$$putNext(0) }
		else
		{
			$$$putNext(6)
			$$$putNext($classname(e))
			$$$putNext(e.Name)
			$$$putNext(e.Code)
			$$$putNext(e.Location)
			$$$putNext(e.Data)
			$$$putNext(e.DisplayString())
		}
	}
	d putCommon()
	
	if (%clientVersion '< $$$descrArgsBranch)
	{
		s ii = $$$getNextArgByRef("")
		while (ii '= "")
		{
			d putArgWire(ii)	
			s ii = $$$getNextArgByRef(ii)
		}
		if ($$$getMtdRetType '= $$$clientTypeVoidId) { $$$putResWire }
	}
	$$$resetMtdInfo	
}
 
runMtdLow(isFunc) // cannot be a procedure (indirect execution)
	n ii,mtdObj,runMtd,r1,r2,r3,r4,r5,r6,r7,r8,r9,r10,r11,r12,r13,r14,r15,r16,r17,r18,r19,r20,r21,r22,r23,r24
	
	$$$LOG("message: runMethod("_isFunc_"):")
	do:$$$logging ##class(%SYS.DBSRV).logappend("runMtdLow: isFunc = "_isFunc)
	
	for ii = 1:1:$$$getMtdNumArgs { xecute "s r"_ii_" = "_$$$getArgStr(ii) }
	
	if (isFunc) { s runMtd = "s "_$$$getMtdRetValStr_" = $zobj" }
	else { s runMtd = "d $zobj" }
	if ($$$getMtdOref '= -1) 
	{
		s mtdObj = $$$toClientObj($$$getMtdOref)
		s runMtd = runMtd_"method(mtdObj, "_$$$getMtdNameStr
		$$$LOG("object: "_mtdObj)
	}
	else 
	{
		s runMtd = runMtd_"classmethod("_$$$getMtdClassNameStr_", "_$$$getMtdNameStr
		$$$LOG("class: "_$$$getMtdClassName)
	}
	$$$LOG("method: "_$$$getMtdName)
	
	for ii = 1:1:$$$getMtdNumArgs { s runMtd = runMtd_", .r"_ii $$$LOG("arg"_ii_": "_$g($$$getArg(ii))) }
	s runMtd = runMtd_")"
	if (%clientVersion '< $$$mtdExceptions) 
	{
		try { xecute runMtd }
		catch exception { $$$setExceptionInfo(exception) }	
	}
	else { xecute runMtd }
	 
	$$$LOG("output args:")
	for ii = 1:1:$$$getMtdNumArgs 
	{
		if ($$$isArgByRef(ii)) 
		{ 
			xecute "s "_$$$getArgStr(ii)_" = $g(r"_ii_")"
			$$$LOG("arg"_ii_": "_$g($$$getArg(ii)))
			if ($$$getArgType(ii) = $$$clientTypeObjId) { $$$initObjVar($g($$$getArg(ii))) }
		}
	}
	if ($$$getMtdRetType = $$$clientTypeObjId) { $$$initObjVar($g($$$getMtdRetVal)) }
	if ($$$getMtdRetType = $$$clientTypeVoidId) { s $$$getMtdRetVal = "" }
	$$$LOG("return value: "_$g($$$getMtdRetVal))
	q
 
setupMethodInfoBranch()
{
	$$$getNext($$$getMtdOref)
	$$$getNext($$$getMtdClassName)
	$$$getNext($$$getMtdName)
	$$$getNext($$$getMtdRetType)
	do:$$$logging ##class(%SYS.DBSRV).logappend("setupMethodInfo: oref = "_$$$getMtdOref_", mtdName = "_$$$getMtdName_", className = "_$$$getMtdClassName_", mtdRetType = "_$$$getMtdRetType)
.
	if ($$$getMtdRetType = 0) { s $$$getMtdRetType = $$$clientTypeStrId }
	elseif ($$$getMtdRetType = 1) { s $$$getMtdRetType = $$$clientTypeObjId }
	else { s $$$getMtdRetType = $$$clientTypeVoidId }
 
	$$$getNext($$$getMtdNumArgs)
	for ii = 1:1:$$$getMtdNumArgs
	{
		$$$getNext($$$getArg(ii))
		$$$setArgType(ii, $$$clientTypeStrId)
	}
	
	$$$getNext($$$getMtdNumRefs)
	for ii = 1:1:$$$getMtdNumRefs
	{
		$$$getNext(idx)
		$$$makeArgByRef(idx)
	}
	
	$$$getNext(numObjs)
	for ii = 1:1:numObjs 
	{  
		$$$getNext(idx)
		$$$setArgType(idx, $$$clientTypeObjId)
		$$$setArg(idx, $$$toClientObj($$$getArg(idx)))
	}
}
 
setupMethodInfo()
{
	$$$getNext($$$getMtdOref)
	$$$getNext($$$getMtdClassName)
	$$$getNext($$$getMtdName)
	$$$getNext($$$getMtdRetType)
	
	$$$getNext($$$getMtdNumArgs)
	do:$$$logging ##class(%SYS.DBSRV).logappend("setupMethodInfo: oref = "_$$$getMtdOref_", mtdName = "_$$$getMtdName_", className = "_$$$getMtdClassName_", mtdRetType = "_$$$getMtdRetType)
	for ii = 1:1:$$$getMtdNumArgs { d getArgWire(ii) }
	
	$$$getNext($$$getMtdNumRefs)
	for ii = 1:1:$$$getMtdNumRefs
	{
		$$$getNext(idx)
		$$$makeArgByRef(idx)
	}
	
	if (%clientVersion '< $$$optionalNestedCalls)
	{
		$$$getNext(%allowNestedCalls)
		if ($$$allowNestedCalls($$$getJobInfo) '= %allowNestedCalls) { $$$setJobInfo($$$bldJobInfo) }
	}
}
 
getArgWire(idx)
{
	$$$getNext($$$getArgType(idx))
	if (($$$getArgType(idx) = $$$clientTypeLongStrId) || ($$$getArgType(idx) = $$$clientTypeLongBinId))
	{
		if ($$$getArgType(idx) = $$$clientTypeLongStrId) { s stream = ##class(%GlobalCharacterStream).%New() }
		else { s stream = ##class(%GlobalBinaryStream).%New() }
		$$$setArg(idx, stream)
		d getStreamWire(stream)
		q
	}
	
	$$$getNext($$$getArg(idx))
	if ($$$getArgType(idx) = $$$clientTypeObjId) { $$$setArg(idx, $$$toClientObj($$$getArg(idx))) }	
}
 
getStreamWire(stream)
{
	d stream.Rewind()
	
	$$$getNext(numPieces)
	for ii = 1:1:numPieces 
	{ 
		$$$getNext(piece) 
		s status = stream.Write(piece)
		if ($$$ISERR(status)) 
		{
			s code = $$$GETERRORCODE(status)
			s msg = $$getStatusMessage(status)
			s %err = $$$makeErr(code,msg,"")
			q
		}
	}
	d stream.Rewind()
}
 
putArgWire(idx)
{
	if (($$$getArgType(idx) = $$$clientTypeLongStrId) || ($$$getArgType(idx) = $$$clientTypeLongBinId))
	{
		s stream = $g($$$getArg(idx))
		d putStreamWire(stream)
		q
	}
	
	s val = $g($$$getArg(idx))
	if ($$$getArgType(idx) = $$$clientTypeObjId) { s val = $$orefClientRep(val) }
	$$$putNext(val)
}
 
putStreamWire(stream)
{
	if (stream = "")
	{
		$$$putNext(0)
		q
	}
			
	d stream.Rewind()
	$$$putNext(stream.Size)
	while ('stream.AtEnd) { $$$putNext(stream.Read()) }
}
 
setupMtdRetValBranch()
{
	if ($$$getMtdRetType = $$$clientTypeObjId) { s %res = $lb($$orefClientRep($$$getMtdRetVal)) }
	else { s %res = $lb($$$getMtdRetVal) }
	
	s ii = $$$getNextArgByRef("")
	while (ii '= "")
	{
		if ($$$getArgType(ii) = $$$clientTypeObjId) { s %res = %res_$lb($$orefClientRep($$$getArg(ii))) }
		else { s %res = %res_$lb($$$getArg(ii)) }
		s ii = $$$getNextArgByRef(ii)
	}
}
 
