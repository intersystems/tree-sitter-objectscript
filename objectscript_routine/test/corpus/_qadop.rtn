%qadop	// Operation table API
	;; COMPONENTS :: SQL/Parser
	
#INCLUDE %msql
#IF 0  	;-------------------------------------------------------------
	; Description:   Operation table API Implementation
	; Author:        Aviel Klausner
	; Date Started:  February 5, 1997
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;  DPV3230 (08/01/2008) - Correct DATE <op> TIMESTAMP when user-defined datatypes are used 
	;  DPV3131 (03/25/2008) - DD Lookup and Table compiler performance improvements
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  DPV1300 (05/01/2000) - Fix <NOLINE> error - findopt/findop
	;  AK377   (06/19/1999) - CCS: Modify SQL categories
	;  AK333   (10/23/98)   - Change hard-coded %STRING/%MVALUE to %String/STRING
	;  DPV753  (07/02/97)   - Call getcode^%qadadt rather than getmeth^%qadadt
	;  AK285   (02/05/97)   - Implement operation table API (routine created)
	;
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
	;  The operation table API inplemented here includes 8 functions:
	;      addopt, modopt, delopt, getopt, findopt
	;      openopl, fetchopl, closeopl
	;
	;-------------------------------------------------------------
	;          Global structure for operation table storage
	;  Note:  the list of categories in lcat is in UPPER
	;  ^mdd(4,op,narg,lcat,1) = kind	; retdt	; commute	;
	;  ^mdd(4,op,narg,lcat,2) = gcode
	;  ^mdd(4,op,narg,lcat,3) = .ptarr (including subtree)
	;              where .ptarr() may be structured as follows:
	;                      ptarr=result - index#
	;                      ptarr(argn+1:result)=parse-tree entry
	;  Generic functions are stored with lcat being  * or *,*
	;
	;-------------------------------------------------------------
	;          Error Codes Returned
	;  All the API functions are called as extrinsic functions, returning
	;      1 if OK, or an error code otherwise.  The error codes are:
	;
	;  A. Operation name missing.
	;  B.	#arguments not specified.
	;  C. List of arguments missing.
	;  D. Operation table entry already exists.
	;  E. Operation table entry not found.
	;  M. Search not open.
	;  N. No more operation table entries.
	;
#ENDIF 	;-------------------------------------------------------------
 $$$Abort 	; Not an Entry Point!!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;              Macros
	#;  notnull - Verify that %n is not NULL, or quit with %e
#DEFINE notnull(%n,%e) QUIT:%n="" %e
	#;  optok - Verify that the 3 arguments are not NULL, or quit with the
	#;      appropriate error code.
	#;      Side-effect - sets the list of categories to $zcvt(str,"U")
#DEFINE optok(%op,%n,%l) $$$notnull($g(%op),"A") $$$notnull($g(%n),"B") s %l=$zcvt($g(%l),"U") $$$notnull(%l,"C")
	#;  optok - Verify that the 3 arguments are OK, and that they
	#;      correspond to an actual opt entry, or give the error code "E".
	#;      Side-effect - sets the list of categories to $zcvt(str,"U")
#DEFINE optxist(%op,%n,%l) $$$optok(%op,%n,%l) QUIT:'$d(^mdd(4,%op,%n,%l)) "E"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;                      Operation table maintenance
addopt(op,narg,lcat,kind,gcode,retdt,commute)	;  add entry to operation table
	#;  kind may be oper/expr/method/ERROR
	$$$optok(op,narg,lcat)
	QUIT:$d(^mdd(4,op,narg,lcat)) "D" 	;  check if opt entry already exists
	s ^mdd(4,op,narg,lcat,1)=$g(kind)_";"_$g(retdt)_";"_$g(commute)
	s ^mdd(4,op,narg,lcat,2)=$g(gcode)
	#; *** generate .ptarr
	QUIT 1
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
modopt(op,narg,lcat,kind,gcode,retdt,commute)	;  $$  modify an opt entry
	$$$optxist(op,narg,lcat)        
	s:$d(kind) $p(^mdd(4,op,narg,lcat,1),";")=$g(kind)
	s:$d(retdt) $p(^mdd(4,op,narg,lcat,1),";",2)=$g(retdt)
	s:$d(commute) $p(^mdd(4,op,narg,lcat,1),";",3)=$g(commute)
	s:$d(gcode) ^mdd(4,op,narg,lcat,2)=$g(gcode)
	#; *** generate .ptarr
	QUIT 1
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
delopt(op,narg,lcat)	;  $$  Delete an operation table entry
	$$$optxist(op,narg,lcat)
	k ^mdd(4,op,narg,lcat)
	QUIT 1
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getopt(op,narg,lcat,kind,gcode,retdt,commute,ptarr)	;  $$  retrieve all
	#;  information on an opt entry.  All output parameters - by ref
	$$$optxist(op,narg,lcat)
	s commute=$g(^mdd(4,op,narg,lcat,1)),kind=$p(commute,";"),retdt=$p(commute,";",2),commute=$p(commute,";",3)
	s gcode=$g(^mdd(4,op,narg,lcat,2))
	k ptarr m ptarr=^mdd(4,op,narg,lcat,3) 	;  copy whole subtree, passed by ref
	QUIT 1
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;                      Operation table search
findopt(op,narg,ldt,kind,gcode,retdt,rev,ptarr,lcat)	;  $$  
	#;  the main operation table search engine
	#;  if function, first look for a method in %arg1's datatype!
	#;  consider commute, * instead of any/all categories
	#;  INPUT:
	#;      op - operation
	#;      narg - number of arguments
	#;      ldt - comma-list of the narg arguments' datatypes
	#;  OUTPUT (by reference):
	#;      .kind - oper/expr/method/ERROR
	#;      .gcode - code to run for this operation
	#;      .retdt - resulting datatype (%argi already resolved)
	#;      .rev - commutative flag - 1 requires caller to reverse arg's
	#;      .ptarr - array with parse-tree for ret (only for "expr"?).
	#;               Entries 1:narg are the input %argi, and ptarr is
	#;               the last entry, which is also the whole expression
	#;      lcat - comma-list of the narg arguments' categories
	#;  The category table returns parse-tree information -
	#;  an expression + a parsed expression - in an array, in which
	#;  nodes 1:narg are the arguments.
	#;  Alternatively, expr/meth may require caller to replace %argi
	#;  at code generation time
	#;                          /-->--$$getmeth
	#;                         /
	#;  Calling sequence:  findopt ----(->-)---- $$getoprev -->-- $$getopt
	#;                         \                        /
	#;                          \-->-- $$findall* -->--/
	new argi,methinfo,sign 	;  method information
	for argi=1:1:narg s $p(lcat,",",argi)=$$getcat^%qaqpdt($p(ldt,",",argi))
	#;  first check for method of %arg1 (if a function)
	#;  *** check signature, class/instance, etc.
	if $$getcode^%qadadt($p(ldt,","),op,,.sign,,.methinfo) {
	 	s kind="meth",gcode=op,retdt="",rev=0 	;  *** also set gcode,retdt,etc.
	 	QUIT 1
	}
	QUIT:'$d(^mdd(4,op,narg)) "E" 	;  opt entry not found
	#;  try first an exact match of lcat
	QUIT:$$getoprev(op,narg,lcat,.kind,.gcode,.retdt,.rev,.ptarr) 1 	;  1st try!
	#;  (above line not needed, included later as first choice in $$findall!)
	#;  not found - see if can use defaults. (*, generic M oper)
	#;  first look for "ALL" (*) matches, in all combinations
	QUIT:$$findall(1,lcat) 1 	;  recursively tries to replace each arg with *
	QUIT "E" 	;--- opt entry not found
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
findall(argi,lcat)	;  try modifying argi in lcat to * (or leaving it as is),
	#;  then recurse down to next argument, return 1 if found
	#;  Note that op,narg,.ref,.retdt,.ptarr,.rev are passed explicitly!
	#;  if bottom of recursion - check it out in the table!
	QUIT:argi>narg $$getoprev(op,narg,lcat,.kind,.gcode,.retdt,.rev,.ptarr)
	QUIT:$$findall(argi+1,lcat) 1 	;  first try argument argi as is
	s $p(lcat,",",argi)="*" 	;  else, try ALL for argument argi
	QUIT:$$findall(argi+1,lcat) 1
	QUIT 0 	;--- $$findall
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getoprev(op,narg,lcat,kind,gcode,retdt,rev,ptarr)	;  $$:  same as findopt,
	#;  but look only for an exact match in the global,
	#;  or a commutative match (setting rev=1), return 1 if found
	i $$getopt(op,narg,lcat,.kind,.gcode,.retdt,,.ptarr) s rev=0 d %argdt QUIT 1 	;  exact!
	#;  check if found the reverse with the commutative flag on
	i narg=2,$$getopt(op,narg,$p(lcat,",",2)_","_$p(lcat,","),.kind,.gcode,.retdt,.rev,.ptarr),rev=1 d %argdt QUIT 1
	QUIT 0 	;--- $$getoprev
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
%argdt	;  resolve retdt explicitly if retdt="%argi", using ldt and rev
	i retdt?1"%arg"1.N s retdt=$e(retdt,5,*) s:rev retdt=3-retdt s retdt=$p(ldt,",",retdt)
	QUIT 	;--- %argdt
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cast(from,to,kind,gcode,ptarr)	;  searches for a CAST from datatypes from to to,
	#; DPV1300
	#; returns (by ref) .kind,.gcode,.ptarr() - same as returned by findopt()
	QUIT $$findopt("CAST",2,,from_","_to,.kind,.gcode,,,.ptarr)
	#; DPV1300-
	QUIT 	;--- cast
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;                      List operation table entries
openopl(search,filter)	;  $$  Establish a search over the opt entries.
	#;  search only the operation filter, or all entries if filter="".
	#;  .search passed in and out by ref, used for internal bookkeeping.
	k search 	;  search = status	; op	; narg	; lcat	; filter
	#;  status = 1 for opened, 2 for fetched, NULL for closed
	#;  filter is an operation (already in cannonic form)
	s search="1;"_$g(filter)_";;;"_$g(filter) 	;  open, nothing fetched yet
	QUIT 1
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fetchopl(search,op,narg,lcat)	;  $$  Retrieve the next opt entry.
	#;  Returns 1, M, N.  all parameters by ref
	n filter
	QUIT:'$g(search) "M" 	;  check if search not open
	s op=$p(search,";",2),narg=$p(search,";",3),lcat=$p(search,";",4),filter=$p(search,";",5)
	g:+search'=1 order3 	;  find next lcat
	s $e(search)=2 	;  first fetch, check if filter itself is an operation
	i filter'="" g:$d(^mdd(4,op)) order2 s search="" QUIT "N" 	;  given filter not found
order1	;  look for next op - outer loop
	i $p(search,";",5)'="" s search="" QUIT "N" 	;  no more data for given filter
	s op=$o(^mdd(4,op)) 	;  proceed to the next op
	i op="" s search="" QUIT "N" 	;  no more data - completed all op's
	#;  an operation found - 
order2	;  look for next narg value - middle loop
	s narg=$o(^mdd(4,op,narg)) 	;  proceed to the next narg
	g:narg="" order1 	;  try a different op
	#;  an narg value found - 
order3	;  look for next lcat value - internal loop
	s lcat=$o(^mdd(4,op,narg,lcat)) 	;  proceed to the next lcat
	g:lcat="" order2 	;  try a different narg
	#;  an opt entry found - set .search and quit
	s $p(search,";",2)=op,$p(search,";",3)=narg,$p(search,";",4)=lcat
	QUIT 1
closeopl(search)	;  $$  .search - by ref
	s search=""
	QUIT 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
---

