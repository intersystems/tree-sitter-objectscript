		set var2 = $$localvar(2)
		$$$liin("s "_var2_"=$vop(""defined"","_pti($li(stuff,3))_"),"_result_"=$s("_pti($li(stuff,4))_"="""":"_pti($li(stuff,3))_",1:$vop(""set"","_pti($li(stuff,3))_","_pti($li(stuff,4))_",""string"",$bitlogic("_pti($li(stuff,5))_"&~"_var2_")))")
		RETURN
	}
	i op="NVLsv" {
		#;  s result=$s(s="":v,1:$vop("set","",s,"string",wf))
		$$$liin("s "_result_"=$s("_pti($li(stuff,3))_"="""":"_pti($li(stuff,4))_",1:$vop(""set"","""","_pti($li(stuff,3))_",""string"","_pti($li(stuff,5))_"))")
		RETURN
	}
	i op="NVLss" {
		#;  s result=$s(s1="":$s(s2="":"",1:$vop("set","",s2,"string",wf)),1:$vop("set","",s1,"string",wf))
		$$$liin("s "_result_"=$s("_pti($li(stuff,3))_"="":$s("_pti($li(stuff,4))_"="""":"""",1:$vop(""set"","""","_pti($li(stuff,4))_",""string"","_pti($li(stuff,5))_")),1:$vop(""set"","""","_pti($li(stuff,3))_",""string"","_pti($li(stuff,5))_"))")
		RETURN
	}
	i op="NULLIFvv" {
		#;  s bm=$vop("v=",v1,v2)
		#;  s result=$vop("mask",v1,$bitlogic(wf&~bm))
		set var2 = $$localvar(2)
		$$$liin("s "_var2_"=$vop(""v="","_pti($li(stuff,3))_","_pti($li(stuff,4))_")")
		$$$liin("s "_result_"=$vop(""mask"","_pti($li(stuff,3))_",$bitlogic("_pti($li(stuff,5))_"&~"_var2_"))")
		RETURN
	}
	i op="NULLIFvs" {
		#;  s result=$vop("mask",v,$vop("!=",v,s))
		$$$liin("s "_result_"=$vop(""mask"","_pti($li(stuff,3))_",$vop(""!="","_pti($li(stuff,3))_","_pti($li(stuff,4))_"))")
		RETURN
	}
	i op="NULLIFsv" {
		#;  s bm=$vop("=",v,s)
		#;  s result=$vop("set","",s,"string",$bitlogic(wf&~bm))
		set var2 = $$localvar(2)
		$$$liin("s "_var2_"=$vop(""="","_pti($li(stuff,4))_","_pti($li(stuff,3))_")")
		$$$liin("s "_result_"=$vop(""set"","""","_pti($li(stuff,3))_",""string"",$bitlogic("_pti($li(stuff,5))_"&~"_var2_"))")
		RETURN
	}
	i op="NULLIFss" {
		#;  s result=$s(s1=s2:"",1:$vop("set","",s1,"string",wf))
		$$$liin("s "_result_"=$s("_pti($li(stuff,3))_"="_pti($li(stuff,4))_":"""",1:$vop(""set"","""","_pti($li(stuff,3))_",""string"","_pti($li(stuff,5))_"))")
		RETURN
	}
	i $e(op,1,6)="IFNULL" {
		#;  if (3 args and s) s v3=$s(s="":"",1:$vop("set","",s,"string",wf))
		#;  if (2 args) s v3=""
		set var2 = $$localvar(2),var3 = $$localvar(3)
		if $ll(stuff)=7 {
			if $li(stuff,6)="v" {
				$$$liin("s "_var3_"="_pti($li(stuff,7))_"")
			} else {
				$$$liin("s "_var3_"=$s("_pti($li(stuff,7))_"="""":"""",1:$vop(""set"","""","_pti($li(stuff,7))_",""string"","_pti($li(stuff,5))_"))")
			}
		} else {
			$$$liin("s "_var3_"=""""")
		}
	}
	i op="IFNULLvv" {
		#;  s bm=$vop("defined",v1)
		#;  s result=$vop("vset",v3,v2,$bitlogic(wf&~bm))
		$$$liin("s "_var2_"=$vop(""defined"","_pti($li(stuff,3))_"),"_result_"=$vop(""vset"","_var3_","_pti($li(stuff,4))_",$bitlogic("_pti($li(stuff,5))_"&~"_var2_"))")
		RETURN
	}
	i op="IFNULLvs" {
		#;  s bm=$vop("defined",v1)
		#;  s result=$vop("set",v3,s,"string",$bitlogic(wf&~bm))
		$$$liin("s "_var2_"=$vop(""defined"","_pti($li(stuff,3))_"),"_result_"=$vop(""set"","_var3_","_pti($li(stuff,4))_",""string"",$bitlogic("_pti($li(stuff,5))_"&~"_var2_"))")
		RETURN
	}
	i op="IFNULLsv" {
		#;  s result=$s(s="":v2,1:v3)
		$$$liin("s "_result_"=$s("_pti($li(stuff,3))_"="""":"_pti($li(stuff,4))_",1:"_var3_")")
		RETURN
	}
	i op="IFNULLss" {
		#;  s result=$s(s1="":$vop("set","",s2,"string",wf),1:v3)
		$$$liin("s "_result_"=$s("_pti($li(stuff,3))_"="""":$vop(""set"","""","_pti($li(stuff,4))_",""string"","_pti($li(stuff,5))_"),1:"_var3_")")
		RETURN
	}
	i op="COALESCE" {
		#;  s var4=$s(t1="v":v1,1:$s(s1="":"",1:$vop("set","",s1,type1,wf))),result=var4
		#;  f { 
		#;   s var2=$VOP("defined",result),var3=$BITLOGIC(wf&~var2) QUIT:'$bitfind(var3,1)
		#;   s var4=$s(t2="v":v2,1:$s(s2="":"",1:$vop("set","",s2,type1,wf))),result=$vop("vset",result,var4,type1,var3)
		#;   ...
		#;   QUIT
		#;  }
		set var2=$$localvar(2),var3=$$localvar(3),var4=$$localvar(4)
		n wf,type1,t1,v1 s wf=pti($li(stuff,3)),type1=""""_$li(stuff,4)_"""",t1=$li(stuff,5),v1=pti($li(stuff,6))
		$$$liin("s "_var4_"="_$s(t1="v":v1,1:"$s("_v1_"="""":"""",1:$vop(""set"","""","_v1_","_type1_","_wf_"))")_","_result_"="_var4)
		$$$liin("f {")
		f jj=7:2:$ll(stuff) {
			s t1=$li(stuff,jj),v1=pti($li(stuff,jj+1))
			$$$liin(" s "_var2_"=$VOP(""defined"","_result_"),"_var3_"=$BITLOGIC("_wf_"&~"_var2_") QUIT:'$bitfind("_var3_",1)")
			$$$liin(" s "_var4_"="_$s(t1="v":v1,1:"$s("_v1_"="""":"""",1:$vop(""set"","""","_v1_","_type1_","_wf_"))")_","_result_"=$vop(""vset"","_result_","_var4_","_var3_")")
		}
		$$$liin(" QUIT")
		$$$liin("}")
		RETURN
	}
	f jj=3:1:$ll(stuff) s args=args_","_pti($li(stuff,jj))  ;  optional arguments	
	$$$liin("s "_result_"=$vop("""_op_""""_args_")")
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
/// This method is for bundling aggregations in the same loop for the LCCA (Low Cardinality Columnar Aggregation) optimization.  ;  YLM001
///
/// PARAMETERS:
///   stuff      - This parameter value is passed from the 'mt("LCCAInputs",m)' array node,
///                which was built during the invocation of the 'vagg^%qaqpag(...)' and the 
///                'LCCAFinalAgg^%qaqpag(...)' methods, and has the following format:
///                    $LB({$LB(,"{sumg | countg | maxg | ming}",groupingNum,keysNum,resultNum,bmeNum)}*n, 
///                        {$LB(,"countgb",groupingNum,keysNum,resultNum)}*n,
///                        {$LB(,"keys",resultNum)}*(0/1),
///                        {$LB(,"outlierVal",outlierValue)}*(0/1),
///                        {$LB(,"cc",cc)}*1,
///                        {$LB(,"wf",wf)}*1)
///                  WHERE *n ::= $LB(...) >=1 instances
///                        *(0/1) ::= $LB(...) { 0 } 1 } instances
///
///                  NOTE: Each entry in the 'stuff' parameter is in the same format as the 'stuff'
///                        parameter of the 'vop(...)' method above, which is a $LIST(...) containing
///                        the following pieces of information:
///                        
///                          1.  empty               - Same as the input for the 'vop(...)' method above
///                          2.  label               - { "sumg" | "countg" | "maxg" | "countgb" | "keys" | "outlierVal" | "cc" | "wf" }
///                          3.* groupingNum/cc/wf   - If label={ "countgb" | "keys" | "outlierVal" }, then there won't be a piece 3 entry; if label={ "cc" | "wf" }, this would be the 'cc' or 'wf' value.
///                          4.* keysNum             - If label={ "keys" | "outlierVal" | "cc" | "wf" }, then there won't be a piece 4 entry
///                          5.* resultNum           - If label={ "keys" | "outlierVal" | "cc" | "wf" }, then there won't be a piece 5 entry
///                          6.* bmeNum              - If label={ "keys" | "outlierVal" | "cc" | "wf" }, then there won't be a piece 6 entry
///
///                  Example: stuff=$LB($LB(,"sumg",15,16,17,12),$lb(,"countg",15,16,18,12),$lb(,"maxg",15,19,20,12),$lb(,"ming",15,19,21,12),$lb(,"countgb",17,19,37),$lb(,"keys",21),$lb(,"outlierVal","MA"),$lb(,"cc",6),$lb(,"wf",12))
///
/// IMPORTANT VARIABLES
///   aggs(...)  - An array that stores the Name instead of Num of output variables in the cached query. It will be built like: aggs("sumg")=$lb($lb(<localName>,<aggingName>,<resultName>, $lb(<localName>,<aggingName>,<resultName> ,...))
///      for example,   aggs("sumg")=$lb($lb("i%Vvecvar116","i%Voarvar217"),...)
///                     aggs("countg")=$lb($lb("i%Vvecvar116","i%Voarvar318"),...)
///                     aggs("maxg")=$lb($lb("i%Vvecvar519","i%Voarvar620"),...)
///                     aggs("ming")=$lb($lb("i%Vvecvar520","i%Voarvar621"),...)
///                     aggs("countgb")=$lb($lb("i%Vch319","i%Voarvar837"),...)
///                     aggs("cc")="MA"
///                     aggs("wf")=12
///                     aggs("keys")=$lb($lb("i%Voarvar721")) // there will be a special grouping agg just for the group by col key, unless there's no group by.
///   opsCnt(...)     - An array that counts the time of each type of aggregations. (e.g. "sumg/countg/maxg/ming" that would be turned into "sum/count/max/min" in the cached query.)
///   bmeName         - This variable is the same for all aggregations in this case. It's the name for the variable uesed in the cached query that represents the bitmap extent bitstring.
///   groupingName    - This variable is the same for all aggregations in this case. It's the name for the variable used in the cached query that represents the grouping column.
///   outlierVal      - If hybrid approach is required (by useLCCAOptimization^%qaqpag), then this variable stores that outlier value, e.g. "MA" if the majority of the values are "MA" and the LCCACondition determines that the hybrid approach is needed.
///   cc              - This parameter means count star. It's the same as the 'cc' variable in the '%qaqpag.MAC' routine.
///   wf              - This parameter means the val of the filter bitmap. It's the same as the 'wf' variable in the '%qaqpag.MAC' routine. It stands for "WHERE filter" according to the comments in cdmag^%qaqpag.
///
/// RETURN VALUE: None
///
bundledVop(stuff) [pti] public {
	for stuffPos=1:1:$ll(stuff) { // --- Process all of the pieces of the "stuff" $LIST(...) to populate the "aggs(...)" & "opsCnt(...)" arrays and other important variables (outVal, groupingName, bmeName) ---
		set inner=$li(stuff,stuffPos)
		set label=$li(inner,2)
		if label="keys" {
			set aggs(label)=$lb($lb(pti($li(inner,3))))
		} elseif label="outlierVal" {
			set outlierVal=$li(inner,3)
		} elseif (label="countgb") {
			set aggs(label) = $g(aggs(label))_$lb($lb(pti($li(inner,4)),pti($li(inner,5))))
			set:'$d(groupingName) groupingName=pti($li(inner,3))
		} elseif (label="cc") {
			set cc=$li(inner,3)
		} elseif (label="wf") {
			set bmeName=pti($li(inner,3))
		} else { // "sumg", "countg", "maxg", "ming"
			set aggs(label)=$g(aggs(label))_$lb($lb(pti($li(inner,4)),pti($li(inner,5))))
			// in case of the LCCA optimization, the bmeName and the groupingName will be the same no matter of the number of group by columns or if they are modified (e.g. even in this query: "SELECT ... FROM ... GROUP BY field1+field2, field3+field4" conceptually there is only 1 composited group by column at this stage here).
			set:'$d(groupingName) groupingName=pti($li(inner,3))
		}
		do $i(opsCnt(label)) // bump the counter for that aggregation
	}
	set localVarCounter=0 // the counter for the local var used in the generated cached query
	if '$d(outlierVal) { // the LCCA approach ($$$LCCASwitchON)
		set bitsVar=$$localvar($i(localVarCounter)), nextPresentIDVar=$$localvar($i(localVarCounter)), nextGroupByColumnKeyVar=$$localvar($i(localVarCounter))
		set workMaskVar=$$localvar($i(localVarCounter)), gKeyVar=$$localvar($i(localVarCounter)), definedVar=$$localvar($i(localVarCounter))
		set tmpMaxVar=$$localvar($i(localVarCounter)), tmpMinVar=$$localvar($i(localVarCounter)), tmpSumVar=$$localvar($i(localVarCounter))
		
		$$$liin("set "_bitsVar_"="_bmeName)
		// LCCA logic: accumulate aggregations instead of *g which does grouping and agg at the same time, reduced the number of entire scans, also it'd trigger the SIMD acceleration on the CPU level.
		$$$liin("for { // --- the LCCA logic (bundled vops instead of seperate full scans for all values) ---")
		$$$liin($c(9)_"set "_nextPresentIDVar_"=$bitfind("_bitsVar_",1) QUIT:'"_nextPresentIDVar)
		$$$liin($c(9)_"set "_nextGroupByColumnKeyVar_"=$vector("_groupingName_","_nextPresentIDVar_")")
		$$$liin($c(9)_"if "_nextGroupByColumnKeyVar_"="""" {")
		$$$liin($c(9,9)_"set "_workMaskVar_"=$vop(""defined"","_groupingName_"),"_workMaskVar_"=$bitlogic("_bmeName_"&~"_workMaskVar_")")
		$$$liin($c(9,9)_"set "_gKeyVar_"="_$$$NULLSubscriptMarker19q)
		$$$liin($c(9)_"} else {")
		$$$liin($c(9,9)_"set "_workMaskVar_"=$vop(""="", "_groupingName_","_nextGroupByColumnKeyVar_")")
		$$$liin($c(9,9)_"set "_workMaskVar_"=$bitlogic("_workMaskVar_" & "_bmeName_")")
		$$$liin($c(9,9)_"set "_gKeyVar_"="_nextGroupByColumnKeyVar)
		$$$liin($c(9)_"}")
		// accumulate the aggregations
		do bundledVopCodeGen(0) // Code-Generate CQ code for the non-outlier LCCA aproach!
		// If the query doesn't have count star, then cdmag() wouldn't add a $vop for the keys column, we need to optimize the counting in this optimization.
		// Otherwise, then cdmag() would added a $vop for the keys column, we don't need to optimize that column in this optimization.
		if '$d(cc) {
			set keysinV=$li($li(aggs("keys"),1),1)_"("_gKeyVar_")"
			$$$liin($c(9)_"set "_keysinV_"=$g("_keysinV_")+$bitcount("_workMaskVar_",1)")
		}
		$$$liin($c(9)_"set "_bitsVar_"=$bitlogic("_bitsVar_" & ~"_workMaskVar_")")
		$$$liin("}")
	} else { // the "hybrid" LCCA approach ($$$LCCASwitchHYBRID)
		set outlierMaskVar=$$localvar($i(localVarCounter)), definedVar=$$localvar($i(localVarCounter)), tmpMaxVar=$$localvar($i(localVarCounter))
		set tmpMinVar=$$localvar($i(localVarCounter)), newMaskVar=$$localvar($i(localVarCounter)), tmpStatusVar=$$localvar($i(localVarCounter)), tmpSumVar=$$localvar($i(localVarCounter))
.
		if outlierVal="" { // if outlierVal is "", needs special handling in code gen
			$$$liin("set "_outlierMaskVar_"=$vop(""defined"", "_groupingName_"),"_outlierMaskVar_"=$bitlogic("_bmeName_"&~"_outlierMaskVar_")")
		} else {
			$$$liin("set "_outlierMaskVar_"=$vop(""="", "_groupingName_","""_outlierVal_""")")
			$$$liin("set "_outlierMaskVar_"=$bitlogic("_outlierMaskVar_" & "_bmeName_")")
		}
		// hybrid LCCA logc part 1: use the new "sum"/"count"/"max"/"min" on the significant outlier value
		$$$liin("if $bitfind("_outlierMaskVar_",1) { // --- the hybrid LCCA logic (bundled vops instead of seperate full scans for the significant outlier value and do the aggregation for the rest) ---")
		do bundledVopCodeGen(1) // Code-Generate CQ code for the outlier "hybrid" LCCA aproach!
		// If the query doesn't have count star, then cdmag() wouldn't add a $vop for the keys column, we need to optimize the counting in this optimization.
		// Otherwise, then cdmag() would added a $vop for the keys column, we don't need to optimize that column in this optimization.
		if '$d(cc) {
			set keysinV=$li($li(aggs("keys"),1),1)_$s(outlierVal="":"",1:"("""_outlierVal_""")")
			$$$liin($c(9)_"set "_keysinV_"=$g("_keysinV_") + $bitcount("_outlierMaskVar_",1)")
		}
		$$$liin("}")
		// hybrid LCCA logic part 2: use the old "sumg"/"countg"/"maxg"/"ming" on the other values
		$$$liin("set "_newMaskVar_"=$bitlogic("_bmeName_" & ~"_outlierMaskVar_")")
		for operator = "sumg", "countg", "maxg", "ming" {
			for aggIdx=1:1:$g(opsCnt(operator),0) {
				set $LG(valV,resultV)=$LG(aggs(operator),aggIdx)
				$$$liin("set "_tmpStatusVar_"=$vop("""_operator_""","_groupingName_","_valV_","_resultV_","_newMaskVar_")")
			}
		}
		// If the query doesn't have count star, then cdmag() wouldn't add a $vop for the keys column, we need to optimize the counting in this optimization.
		// Otherwise, then cdmag() would added a $vop for the keys column, we don't need to optimize that column in this optimization.
		if '$d(cc) { 
			set specialCnt="$vop(""set"","""",1,""integer"","_newMaskVar_")"
			$$$liin("set "_tmpStatusVar_"=$vop(""countg"","_groupingName_","_specialCnt_","_$li($li(aggs("keys"),1),1)_")")
		}
	}
	set cgbStatusVar=$$localvar($i(localVarCounter))
	for aggIdx=1:1:$g(opsCnt("countgb"),0) { // the "countgb" should not be included inside the LCCA loop.
		set $LG(keyV,resV)=$LG(aggs("countgb"),aggIdx)
		$$$liin("set "_cgbStatusVar_"=$vop(""countgb"","_groupingName_","_keyV_","_resV_")")
	}
	RETURN
bundledVopCodeGen(useOutlier = 0) // --- helper to Generate the CQ code for all 'bundledVop(...)' operators ---
	for operator="sumg","countg","maxg","ming" { // --- Accumulate the aggregations for each 'operator' ---
		for aggIdx=1:1:$g(opsCnt(operator),0) { //  --- Process aggregations for the specified 'operator' value ---
			set resultgKeyinV=$LG($LG(aggs(operator),aggIdx),2)_$s(useOutlier:$s(outlierVal="":"",1:"("""_outlierVal_""")"),1:"("_gKeyVar_")")
			set valV=$LG($LG(aggs(operator),aggIdx),1)
			if operator="sumg" { // --- Generate CQ Code for 'sumg' ---
				$$$liin($c(9)_"set "_tmpSumVar_"=$vop(""sum"","_valV_","_$s(useOutlier:outlierMaskVar,1:workMaskVar)_")")
				$$$liin($c(9)_"if $g("_tmpSumVar_")'="""" "_"set "_resultgKeyinV_"=$g("_resultgKeyinV_")+"_tmpSumVar)
			}
			elseif operator="countg" { // --- Generate CQ Code for 'countg' ---
				$$$liin($c(9)_"set "_definedVar_"=$vop(""defined"","_valV_")")
				$$$liin($c(9)_"set "_resultgKeyinV_"=$g("_resultgKeyinV_")+$bitcount($bitlogic("_$s(useOutlier:outlierMaskVar,1:workMaskVar)_" & "_definedVar_"),1)")
			}
			elseif operator="maxg" { // --- Generate CQ Code for 'maxg' ---
				$$$liin($c(9)_"set "_tmpMaxVar_"=$vop(""max"","_valV_","_$s(useOutlier:outlierMaskVar,1:workMaskVar)_")")
				$$$liin($c(9)_"if "_tmpMaxVar_"'="""","_tmpMaxVar_" ]] $g("_resultgKeyinV_") { set "_resultgKeyinV_"="_tmpMaxVar_" }")
			}
			elseif operator="ming" { // --- Generate CQ Code for 'ming' ---
				$$$liin($c(9)_"set "_tmpMinVar_"=$vop(""min"","_valV_","_$s(useOutlier:outlierMaskVar,1:workMaskVar)_")")
				// NOTE: Special handling needed here since (123>"" = 1) and (123<"" = 0)
				$$$liin($c(9)_"if "_tmpMinVar_"'="""" && ("_tmpMinVar_" ']] $g("_resultgKeyinV_") || '$d("_resultgKeyinV_") ) { set "_resultgKeyinV_"="_tmpMinVar_" }")
			}
		}
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
}
wfempty(stuff)  ;  stuff=wf, generate:  GOTO:'$BITFIND(wf,1) bottom  ;  AK1047
	$$$liin("g:'$bitfind("_pti(stuff)_",1) "_bottom)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
hch()	;  temporary kluge - $$$getVarName("ch"_mod) for the EBM module  ;  AK1045
	n md,nmd s md=mod f  s nmd=$p($g($$$aslMod(md)),$c(1),2) QUIT:'nmd  s md=nmd
	RETURN $$$getVarName("ch"_md)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK849
quq(x)	;  x=qn^untop[^val] - queue a process to run query qn (part of
	#;  untop UNION level), record the results pipe tfid in val if given
	#; AK924
	GOTO:$p(x,"^",5)'="" qush
	n qtn,prm,useCAST,useCOAL,quq,tagx,qn,ptr,tmp,params,qtwork s prm="",useCAST=1,useCOAL=1,quq=""
	s qn=$p(x,"^"),qtn=$$$getVarName("quq"_$p(x,"^",2)),qtwork=$$$getVarName("quqwork"_$p(x,"^",2))
	if qn="" {  ; Blank entry always queued after all other entries
		$$$liin("d "_qtn_".QueueLocalEntryMultiFunc(.quqf)")
		QUIT
	}
	n corrm s corrm=$lfs($$$mtPCorrelatedFields($$$mtP(qn)))_$$latm^%qaqpre2(qn)  ;  AK932 ; AK850
	#;  if query text already set, just use it
	i $d($$$mtSql(qn)) { s prm=$$$mtSqlPrm(qn) } else { s $$$mtSql(qn)=$$gensel^%qaqcmh(qn,1) }  ;  sets prm=$LB(parm)
	set ptr=0 while $listnext(prm,ptr,tmp) {
		set quq=quq_","_$$ptvalue^%qaqcpr(tmp),params($increment(params))="%sqlparm"_params
	}
	set quq="$lb("_$extract(quq,2,*)_")"
	set tagx="$$"_$$generateworker^%qaqcky($$$mtSql(qn),.params,,$s($p(x,"^",3):$p(x,"^"),1:""),qn)
	i ($p(x,"^")=$p(x,"^",2)) {
		$$$liin("n quqf")
		new groupId,groupIdStr
		if $$$SQLPushAMSInfo { // --- Prepare to Push 'Application Metadata Stack' (AMS) Information ---
			set groupId = $$localvar("groupId"),groupIdStr = $s($d(mt("sql",qn,"exref")):",."_groupId,1:",,."_groupId)
		} else {
			set groupId="",groupIdStr=""
		}
		if $d(mt("sql",qn,"exref")) {
			$$$liin("do")
			$$$liin(". n exref")
			new tbl,newtbl set tbl=""
			for {
				set tbl=$order(mt("sql",qn,"exref",tbl),1,newtbl) QUIT:tbl=""
				$$$liin(". s exref("""_tbl_""")=$g(%ISCSNRemoteTables("""_newtbl_"""))")
			}
			$$$liin(". s "_qtn_"=##class(%SYSTEM.WorkMgrIPQ).SQLInitialize("_$order($$$aslPk(mod,pk,""),-1)_",1,2,.exref"_groupIdStr_"),"_qtwork_"=0")
			do UpdateGroupId^%qaqcky(". ",groupId)
			
		} else {
			$$$liin("s "_qtn_"=##class(%SYSTEM.WorkMgrIPQ).SQLInitialize("_$order($$$aslPk(mod,pk,""),-1)_",1,2"_groupIdStr_"),"_qtwork_"=0")
			do UpdateGroupId^%qaqcky("",groupId)
		}
	}
	$$$liin("d BuildMultiFunc^%SYS.WorkQueueMgr(.quqf,"""_tagx_""",##class(%SYSTEM.Rtn).GetCurrent(),$zname,"_quq_"),$i("_qtwork_")")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK924
qush  ;  queue a sharded query, x=m^^^^extname
	n csopt,jj,li,localquid,m,moreoptions,pjt,prm,qtn,qtnsub,quq,shtf,tabs,tfn,quid,shclassnames ; JMM992 JMM1152
	s m=+x,quq="",csopt="",pjt=""
	s qtn=$$$getVarName("quq"_m),quid=$$$getVarName("quid"_m),tfn=$$localvar(1),shtf=$$localvar(2),localquid=$$localvar(3),qtnsub=$$adsub^%qaqcpr(qtn,tfn) ; JMM992
	#;  save and reuse in CLOSE/errtag query task cleanup/%EndQuery() line
	s mt("quq",$i(mt("quq")))="s "_tfn_"="""" f  s "_tfn_"=$o("_qtnsub_") q:"_tfn_"=""""  d ##class(%SQL.Agent).%EndQuery("_tfn_","_quid_") k "_qtnsub $$$liin(mt("quq",mt("quq")))
	#;  if query text already set, just use it
	s prm=$$$mtSqlPrm(m)  ;  sets prm=$LB(params)
	#;  evaluate prm - usually "x" entries, but could be expressions,  ;  AK1021
	#;  incl. subqueries which might generate extra lines right here
	f jj=1:1:$ll(prm) s quq=quq_","_$$ptvalue^%qaqcpr($li(prm,jj))
	#; AK938
	#;  *** remove SET of mt("sql",m,"shtab") from ^cmh!!!  ;  AK939
	#;  *** maybe don't need mt("shnot") either!!!  ;  JMM837
	#;  turn mt("cosh",m)=$LB($LB(7,9),$LB(8))  ;  AK939
	#;  into pjt=,$LB($LB("T7","T9"),3),$LB($LB("T8"),2)
	#;  and "Cosharding" /*#OPTION csopt=,["T7","T9"],["T8"]  ;  AK996
	f jj=1:1:$ll(mt("cosh",m)) { s tabs=$li(mt("cosh",m),jj),csopt=csopt_",[",pjt=pjt_",$LB($LB(" f li=1:1:$ll(tabs) { s csopt=csopt_$e(",",li>1)_"""T"_$li(tabs,li)_"""",pjt=pjt_$e(",",li>1)_"""T"_$li(tabs,li)_""""  } s csopt=csopt_"]",pjt=pjt_"),"_((li>1)+2)_")" }
	#; JMM837: NO LONGER NEED to list non-sharded tables as type 1
	#; JMM1135: Don't allow joining federated tables with sharded tables
	#; JMM1135+
	#; JMM1215 Prevention of joining sharded and federated tables moved to cosh^%qaqpnl
	#; JMM1152 When merging JMM1215 and JMM1152, I'm restoring this block of code, originally added with JMM1135,
	#; that was removed by JMM1215.  It is needed for setting shclassnames.  It redundantly checks to prevent joining 
	#; federated and sharded tables, which is now, due to JMM1215, also done earlier in cosh^%qaqpnl.
	set shtabs=$g($$$mtShardedTables(m))
	if shtabs'="" { // JMM1152=
		set nfed=0,nsh=0
		s shclassnames="$lb("  // JMM1152=
		for ii=1:1:$ll(shtabs) {
			s cn=$$$smdClassname(1, $p( $g( $$$mtR($lg(shtabs,ii))),"^",1) )
			if cn'="" {
				if $ll(shtabs)> 1 { // JMM1152=
					if $$$SSIsFederated(cn) {
						set nfed=$i(nfed)
					}
					else {
						set nsh=$i(nsh)
					}
				} // JMM1152+
				if ii=$ll(shtabs) {
					s punc=")"
				}
				else {
					s punc=","
				}
				s isShardMorph=$$isShardMorph^%SYS.SHARDSRV(cn)
				if isShardMorph {
					s shardMorphComma=",", shardMorphFlag=$$quoter(isShardMorph)
				}
				else {
					s shardMorphComma="", shardMorphFlag=""
				}
				s tname="T"_$lg(shtabs,ii),shclassnames=$g(shclassnames)_"$lb("_$$quoter(tname)_","_$$quoter(cn)_shardMorphComma_shardMorphFlag_")"_punc // JMM1152-
			}
		}
		if nfed && nsh {
			throw ##class(%Exception.StatusException).CreateFromStatus($$$ERROR($$$SHMCannotJoinShardedAndFederated))
		}
	}
	#; JMM1135-	
	#; JMM738
	if $d(%SNBrokerQuery) {
		#; Called from within %BrokerShardOp method of %BigData.ShardingManager.
		#; If there are no non-co-sharded joins, this query can be brokered, so set variables
		#; to return needed information.
		if $ll(mt("cosh",m))=1 {
			s %SNShardedTable=$p($g(x),"^",5)
			#; JMM837: No longer needed s %SNNonShardedTables=$g(mt("sql",m,"shnot"))
			s %SNShardLocalQuery=$$$mtSql(m)
		}
	}
	#; JMM738-
		#; here we add in more options we want to propogate from the main query to the sharded query
	set moreoptions=""
	set shardScreenOption=$$$SQLCompileOption("ISCShardScreen")  // JMM1134+
	if shardScreenOption'="" { set moreoptions=moreoptions_" /*#OPTIONS {""ISCShardScreen"":"_shardScreenOption_"} */" } // JMM1134-
	if $$$SQLCompileOption("NULLEQUAL")=1 { set moreoptions=moreoptions_" /*#OPTIONS {""NULLEQUAL"":1} */" }
	if $$$SQLCompileOption("source-tsql")=1 { set moreoptions=moreoptions_" /*#OPTIONS {""source-tsql"":1} */" }
	$$$liin("d:'##class(%BigData.ShardedSQL).%ShardQuery("_$g(shclassnames)_","_$$quoter($$$mtSql(m)_" /*#OPTIONS {""CompileSelectMode"":""Logical"",""shardLocalQuery"":1,""Cosharding"":["_$e(csopt,2,*)_"]} */"_moreoptions)_",1,$this_"""",."_shtf_",."_localquid_$s(quq'="":",$LB("_$e(quq,2,*)_")",1:",")_",$LB("_$e(pjt,2,*)_")) SQERror^%apiSQL(251,""Sharded query queue error: ""_%msg)") ; JMM992 JMM1152
	do UpdateGroupId^%qaqcky("","$system.Context.SN().groupId")
	#; AK938-
	$$$liin("s "_quid_"="_localquid_",("_$$$getVarName("shtf"_m)_","_qtn_")=$li("_shtf_"),"_$$$getVarName("shcount"_m)_"=$li("_shtf_",2) f "_tfn_"="_qtn_":1:"_qtn_"+($li("_shtf_",2)-1) s "_qtnsub_"=""""")  ;  AK939 JMM992 JMM1092 JMM1152
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK924-
	#; AK849-
	#; AK945
ddefun(irn,ifn) n v  ;  $$: ifn with the default collation added, if any
	s v=$$$smdColCollation(1,irn,ifn)
	s v=$s(v="":"",v="SU":"%SQLUPPER",v="A":"%ALPHAUP",v="U":"%UPPER",v="S":"%SPACE",v="P":"%PLUS",v="M":"%MINUS",v="MV":"%MVR",v="E":"",v="T":"%STRING",v="SS":"%SQLSTRING",v["T(":"%STRING("_$p(v,"(",2),v["SS(":"%SQLSTRING("_$p(v,"(",2),v["SU(":"%SQLUPPER("_$p(v,"(",2),1:v)
	if $$$ISENCODEDCOLLATE(v) {set v = "%"_v}
	RETURN ifn_$s(v="":"",1:"_"_v)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK945-
setcond(conds)  ; insert code for a condition from the parse tree.
	#; Don't evaluate the same expression more than once in this context
	#;  new cgc d cgcInit^%qaqcasl()  ;  TRW1449  ;  removed by AK1090
	new i5,log,line f i5=1:1 {
		s log=$p(conds,",",i5) q:log=""
		s line = "i '"_$$cond^%qaqcpr(log)_" "
		#; Failure of a TOP condition should not trigger null padding
		if $$padhead^%qaqcasl(mod),$e($$$mtLOperator($$$mtL(log)),1,3)="TOP" s line = line_"s "_$$$getVarName("pad"_$$padhead^%qaqcasl(mod))_"=0 "
		s line = line_"g "_$s($g(mt("offsetlog"))=log:bottomout,$$vudun(.log):log,1:bottom)
		$$$liin(line)
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK884
vudun(log) n v,ifn,str s v=$$$mtL(log)  ;  $$: whether log is an upper bound
	#;  RANGE condition on %VID, in which case return in .log (by ref) the
	#;  nstmd_"dun" tag to jump to to stop view processing
	QUIT:"v^<^v^'>^v^TOP:<^"'[$p(v,"^",1,2) 0  ;  not an upper bound
	s v=$$$mtV($p(v,"^",4))  ;  the condition's first argument
	QUIT:$e(v)'="f" 0  ;  not a field
	s ifn=$p(v,"^",3)
	QUIT:$lg($g($$$mtVirf(ifn)),1)'=0 0  ;  not %VID
	s str=$p(v,"^",2)  ;  verify that it's a RANGE
	QUIT:$p($g(mts($$$mtRQb($$$mtR(str)),str,"RANGE",ifn)),"^",2)'[(","_log_",") 0
	s log=$$modpre^%qaqcasl($$$mtPVirtStreamModule($$$mtP($$$mtRVirtual(str))))_"dun"
	QUIT 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK884-
temp(stuff)  ;  Call to do "temp" stuff for PreKey or Post Key
	d:$p(stuff,$c(1),1)'="" calltemp  ; call a Module
	i $p(stuff,$c(1),3)'="" s line=$p(stuff,$c(1),2) $$$liin(.line) ;insert some M
	d:$p(stuff,$c(1),4)'="" settemp($p(stuff,$c(1),4))
	#;  transfer into da() things defined in $$$mtV(icol)
	#;  There can be lots of val's, separated by commas.
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
calltemp  ;  We'll call another ASL Module.
	#;  might need temp-file processing (hybrid, $SORTEND) after module is done
	new duntf,li,modtag,oncecode,tf 
	set duntf=$g($$$asl0TfsWhereThisModIsTop(+stuff))
	set modtag=$$modpre^%qaqcasl(+stuff)_"Mod"  ;  AK936
	#; AK920
	#;  Do the $p(1) Module, $p(2) means do this call only once !!!
	set oncecode = $$once(mod,+stuff,$p(stuff,$c(1),2),"d "_$s(duntf="":modtag,1:"")) 
	If $g($$$mtSharedGlobalTfmod(+stuff)) {
		new tfnum,tfvar,uselocalcache
		set tfnum= $$$mtSharedGlobalTfmod(+stuff)
		set uselocalcache=$g($$$mtSharedGlobalTfUseCache(tfnum))
		Set tfvar = $s($$$mtTfRealGlobalFlag($$$mtTempFile(tfnum)):$$$tGlobalQ,1:$$$tFileQ)_"("_$$$getVarName("tablenum"_tfnum)_")"
		If uselocalcache {
			$$$liin("Merge:'$data("_$$$getVarName("tfcache"_tfnum)_") "_$$$getVarName("tfcache"_tfnum)_"="_tfvar)
		} else {
			$$$liin("Set:'$data("_$$$getVarName("tfcache"_tfnum)_") "_$$$getVarName("tfcache"_tfnum)_"=$get("_tfvar_")")			
		}
		$$$liin("If '$g("_$$$getVarName("tfcache"_tfnum)_"){")
		$$$liin(" Lock +"_tfvar)
		If uselocalcache {
			$$$liin(" Merge "_$$$getVarName("tfcache"_tfnum)_"="_tfvar)
		} else {
			$$$liin(" Set "_$$$getVarName("tfcache"_tfnum)_"=$get("_tfvar_")")
		}
		$$$liin(" If '$g("_$$$getVarName("tfcache"_tfnum)_"){")
		$$$liin("  Try {")
		$$$liin("    i $sortbegin("_tfvar_") {}")
		$$$liin("    d "_$s(duntf="":modtag,1:"")) ;  AK936
		$$$liin("    i $sortend("_tfvar_") {}")
		$$$liin("    s "_tfvar_"=1")
		If uselocalcache {
			$$$liin("    Merge "_$$$getVarName("tfcache"_tfnum)_"="_tfvar)
		} else {
			$$$liin("    Set "_$$$getVarName("tfcache"_tfnum)_"=1")
		}
		$$$liin("  } Catch {Lock -"_tfvar_"#""I"" Throw}")
		$$$liin(" }")
		$$$liin(" Lock -"_tfvar_"#""I""")
		$$$liin("}")
		If uselocalcache {
			Set $$$mtTfLocation($$$mtTempFile(tfnum)) = 1, $$$mtTfRealGlobalFlag($$$mtTempFile(tfnum))=0
			// change the temp-file reference to the local cache variable 
			New oldtfref Set oldtfref = $e(tfvar,1,*-1) 
			New newtfref Set newtfref = $$$getVarName("tfcache"_tfnum)
			If $e(newtfref,*)=")" {Set newtfref=$e(newtfref,1,*-1)} Else {Set newtfref = newtfref_"(" }
.
			New tref Set tref = $$$mtTfModNum($$$mtTempFile(tfnum))_"^"_$$$mtTfBuildAct($$$mtTempFile(tfnum))
		
			Set $$$mtTref(tref) = $select($$$mtTref(tref)=oldtfref:newtfref,1:$replace($$$mtTref(tref),oldtfref_",",newtfref,,1,1))
			Set $$$mtTrefRefNode(tref) = $select($$$mtTrefRefNode(tref)=oldtfref:newtfref,1:$replace($$$mtTrefRefNode(tref),oldtfref_",",newtfref,,1,1))
.
			New refidx,refstuff s refidx = ""
			For {
				Set refidx = $o($$$mtTrefRefSubLev(tref,refidx),1,refstuff)
				Quit:refidx=""
				Set $$$mtTrefRefSubLev(tref,refidx) = $select(refstuff=oldtfref:newtfref,1:$replace(refstuff,oldtfref_",",newtfref,,1,1))
			}
		}
	} else {
		$$$liin(oncecode)  ;  AK936
	}
	#; AK920-
	i duntf'="" {  ;  AK936+
		n tfvarr,tfname,vlist,pi,qmlp  ;  AK986;AK1010;AK1017
		f li=1:1:$ll(duntf) { s tf=$li(duntf,li)
			s vlist=$$$mtTfPredictNode($$$mtTempFile(tf))  ;  AK1017
			i vlist { f pi=1:1:$l(vlist,",")-1 { if $p(vlist,",",pi)>0 { $$$liin(". s "_pti($p(vlist,",",pi))_"=$DOUBLE(""NAN"")") } } CONTINUE }
			CONTINUE:'$$hybtf(tf)
			s tfvarr=$$$getVarName("hybtf"_tf),tfname=$$$getVarName("hybtfn"_tf)
			$$$liin(". k "_tfvarr_" s "_tfname_"=##quote("_tfvarr_")")
		}
		$$$liin(". d "_modtag) /// call to the module
		f li=1:1:$ll(duntf) { s tf=$li(duntf,li)
			s vlist=$$$mtTfPredictNode($$$mtTempFile(tf))  ;  AK1010
.
			i $e(vlist)="-" {
				set mtorder = "", mtunary = "", ascheck = 0
				for j=1:1 {
					if ($$$mtVType($$$mtV(j))="q") { QUIT }
					if ($$$mtVType($$$mtV(j))="s") { set ascheck = 1 }
					if $$$mtVType($$$mtV(j))="f" { set mtorder = mtorder_$lb($$$LOWER($p($$$smd(1,"ifn",$p($$$mtV(j),"^",3)),$c(1)))) }
				}
				set mtorder2 = ""
				if $d($$$mtAlphaUpAliases(m)) && ascheck {
					for asidx=1:1:$LL($$$mtAlphaUpAliases(m)) {
						set mtorder2=mtorder2_$LB($$$LOWER($LG($$$mtAlphaUpAliases(m),asidx)))
					}
				}
.
				set u = ""
				while $o(mt("unary",u)) { /// Do only one expensive $o, use a for and an exit instead of this while.
					set u = $o(mt("unary",u))
					set vidx = $p($$$mtV(u),"^",3)
					for j=1:1 {
						#; if $d(mt("virf",vidx),virfData) { set vidx = $p($$$mtV(+$list(virfData,2)),"^",3) } /// Needs to be somehow recursive...
						while $d($$$mtVirf(vidx),virfData) { set vidx = $p($$$mtV(+$list(virfData,2)),"^",3) }
						if $e(vidx)="," { set vidx = $p($$$mtV(+$p(vidx,",",2)),"^",3) } /// In case of casting.
						else { QUIT }
					}
					set mtunary = mtunary_$lb( $$$LOWER($p($$$smd(1,"ifn",vidx),$c(1))) )
				}
				set mtunary2 = ""
				if ascheck {
					for mtui=1:1:$LL(mtunary) {
						set cUFi = $LF(mtorder,$LG(mtunary,mtui))
						set mtunary2 = mtunary2_$LB($LG(mtorder2,cUFi))
					}
					set mtunary = mtunary2
				}
				if mtorder2'="" { set mtorder = mtorder2 }
			}
			i $e(vlist)="-" { $$$liin(". s "_$$$getVarName("statuscode")_"=##class(%ML.Model).%PredictAll("_$$quoter($p(mt("tsml",-$p(vlist,",")),"^"))_","_$$quoter($p(mt("tsml",-$p(vlist,",")),"^",2))_","_$$$getVarName("tablenum"_tf)_","_$$quoter($LFS($p(mt("tsml",-$p(vlist,",")),"^",3,*),"^"))_",,,,"_$$quoter(mtorder)_","_$$quoter(mtunary)_","_$$quoter(m)_") i '"_$$$getVarName("statuscode")_" { s %msg=""PREDICT execution error: ""_$$GetErrorText^%apiOBJ("_$$$getVarName("statuscode")_") ZTRAP ""PREDICT"" }") CONTINUE }
			i vlist { f pi=1:1:$l(vlist,",")-1 { s qmlp=$p(vlist,",",pi) $$$liin(". s "_$$$getVarName("statuscode")_"=##class(%ML.Model).%PredictAll("_$$ptvalue^%qaqcpr($p($$$mtV(qmlp),"^",4))_","_$$ptvalue^%qaqcpr($p($$$mtV(qmlp),"^",5))_","_$$$getVarName("tablenum"_tf)_","_$$qmlpos(qmlp,tf)_") i '"_$$$getVarName("statuscode")_" { s %msg=""PREDICT execution error: ""_$$GetErrorText^%apiOBJ("_$$$getVarName("statuscode")_") ZTRAP ""PREDICT"" }") } CONTINUE }
			#;  may need one last merge of %sqlvtf() into the global temp-file
			if $$hybtf(tf) $$$liin(". d:$e("_tfname_")=""^"" "_$$hybtag(tf))
			If $$$parAggUsesSharedGlobal(m)&&(mod=$$$topWorkerModule(m)) {
				// We write from PPG to shared global if PPG was used and from local array otherwise
				$$$liin(". i ($e("_tfname_")=""^"") {d "_$$hybtag(tf,$$$getParAggSharedTf(m),0)_"} else {d "_$$hybtag(tf,$$$getParAggSharedTf(m),1)_"}")
			}
			#;  temp file may need $sortend
			if $$glotf^%qaqcpre(tf)&&$$$mtTfNeedsSort($$$mtTempFile(tf)),'$g($$$mtSharedGlobalTf(tf)) $$$liin(". i $sortend("_$$$mtTref(tf)_")) { }")
		}
	}  ;  AK936-
	#; AK614
	#;  test counter if provided
	if $p(stuff,$c(1),5) $$$liin("g "_bottom_":'"_pti($p(stuff,$c(1),5)))
	#; AK614-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
qmlpos(qmlp,tf)  ;  $$: "$LB(argpos),[$lb(predictpos)][,$lb(probabilitypos),probability-expression]" - %PredictAll()  ;  AK1010
	#;  arguments, with the positions within the tf temp-file of
	#;  the arguments and the result of the qmlp QuickML function
	new arg,bmod,jj,pos,predict,v
	set bmod=$$$mtTfModNum($$$mtTempFile(tf)),jj=""
	#;  build reverse index tf(fval)=pos of temp-file positions
	#;  *** we must presume to mimic the data^%qaqcct position algorithm
	f  s jj=$o($$$aslActNode(bmod,1,jj),1,v) q:'jj  d:$e(v)'="s" tfadd($$$aslActNodeSubscriptVar(v))
	s v=$$$mtV(qmlp),arg="",predict=($e(v,1,9)="v^PREDICT")
	f jj=$s(predict:6,1:7):1:$l(v,"^")-1 s arg=arg_","_tf($p(v,"^",jj))
	RETURN "$lb("_$e(arg,2,*)_")"_$s(predict:"",1:",")_",$lb("_tf(qmlp)_")"_$s(predict:"",1:","_$$ptvalue^%qaqcpr($p(v,"^",6)))	// p6 is probability FOR expression
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tfadd(val)  ;  add val and its unary functions to the temp-file
	d tffun("%ODBCOUT"),tffun("%RUNTIMEOUT"),tffun("%EXTERNAL"),tffun("%INTEXT"),tfpos(val)
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tffun(fun)  ;  Add fun(val)
	s fun=$g(mt("unary",val,fun))
	QUIT:'fun  ;  keyword was not requested
	QUIT:pti(val)=pti(fun)  ;  same variable, keyword is no-op
	d tfpos(fun)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tfpos(val)  ;  add val to a new temp-file position tf(val) if not already there
	s:'$d(tf(val)) tf(val)=$i(pos)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK920
once(caller,called=0,flag=1,code="")  ;  $$: if flag, prefix the code so it will
	#;  run only once, using a scratch variable flag - if the called
	#;  module is listed in mt("once"), then initialize the flag in mod=1
	RETURN:flag["," $$latfcache(flag,code)  ;  cache temp-file by latf  ;  AK850
	i $lf($g(mt("once")),called) {
		n oldmod s oldmod = mod
		n mod s mod=$s($$$isWorkerModule(oldmod,m):$$$topWorkerModule(m),1:1)  ;  init var in top worker module or module 1
		s:'flag flag=1
	}
	i flag>1 { n mod s mod=flag	}
	QUIT:'flag code  ;  "once" flag not set
	n main,callpos,li,md,var,val
	s main=$$$aslTopSubqMod(mod),callpos=$lf($g($$$asl0NestedMods(main)),caller)
	#;  if there is no looping before the call, then no flag needed
	#; AK926
	i callpos f li=1:1 RETURN:li>(callpos-(pk=1)) code s md=$li($$$asl0NestedMods(main),li) q:+md'=md  q:$g($$$asl0LoopingSubscripts(md))'=""
	s var=$$scratch^%qaqcpr(.val,0,"once"_caller_":"_called)
	s $p($$$mtV(val),"^",2) = "once" //represent this variable as "i^once" in mt("v")
	#; AK926-
	d null^%qaqcasl(val,$s(flag>1:2,1:0))
	QUIT "i '"_var_" { s "_var_"=1 "_code_" }"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
latfcache(flag,code)  ;  $$: line to cache lateral fields and make the call  ;  AK850-
	#;  flag=tf#,latf1,latf2,
	#;  first generate a line to set onesub=var("distlatf"_tf#)
	#;  s onesub=$zlist(latf1,latf2)  ;  or if only one field:
	#;  s onesub=$s(latf1'="":latf1,1:-1E19)  ;  or no line if latf1 is
	#;  reguired, in which case pti(onesub) must be the same as pti(latf1)
	#;  If "short", generate:
	#;  i '$d(^||%t(i%tablenum5,onesub)) { s ^||%t(i%tablenum5,onesub)="" d %0AmDMod }
	#;  if not always short, cache only when short strings:
	#;  i $l(onesub)<120 { i '$d(^||%t(i%tablenum5,onesub)) { s ^||%t(i%tablenum5,onesub)="" d %0AmDMod } } else { s onesub=$e(onesub,1,120) KILL ^||%t(i%tablenum5,onesub) d %0AmDMod }
	n var,icol,latf,refForRead,refForWrite  ;  for caching subscript - var("distlatf"_tf#)
	s var=$$$getVarName("distlatf"_+flag),icol=$$$VarNum("distlatf"_+flag)
	s latf=$p(flag,",",2,$l(flag,",")-1)
	i latf["," { d copy("8^"_$listfromstring(latf,",")_"^"_icol) }
	#;  single field
	elseif $$nullreplace^%qaqcct(latf) { $$$liin("s "_var_"="_$$tomark^%qaqcpr(pti(latf))) }
	#;  otherwise (required single field), use same pti() as the field, done in ^%qaqcasl step 13
	s refForRead=$$tfref(+flag,1,3,var,"'$d(",")") ; readWriteMode=3 to indicate a read, which returns a hybrid selection if what we are reading is a non-DISTINCT hybrid temp-file
	s refForWrite=$$tfref(+flag,1,1)_var_")" ; readWriteMode=1 to indicate a write, which returns a reference to the local temp-file "i%hybtf1(" if what we are writing to is a non-DISTINCT hybrid temp-file
	#;  if subscript will never overflow, save new value in temp-file
	n isLocalArr,subLimit
	s isLocalArr = ('$$glotf(+flag))
	RETURN:$$short(latf,,isLocalArr) "i "_refForRead_" { s "_refForWrite_"="""" "_code_" }"
	#;  must check at run-time, don't cache if too long
	s subLimit=$s(isLocalArr:32766,1:120)
	RETURN "i $l("_var_")<"_subLimit_" { i "_refForRead_" { s "_refForWrite_"="""" "_code_" } } else { s "_var_"=$e("_var_",1,"_subLimit_") KILL "_refForWrite_" "_code_" }"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK920-
distinct(stuff) ; Distinct Condition.  This is a Condition, which
	#; SET a Temp File if it passes.  Its used for unique stuff.
	#; AK438
	n icols,ref,var1,cnt,var2,short,tfvarr,tfname
	s icols=$p(stuff,$c(1),1)
	#; AK615
	n distf,fpre s distf=$p(stuff,$c(1),2)
	#; If the subscript is short we skip the extra field in the temp file, use this rather than recalculate $$short because of frozen plans
	#; For union $$short never returns true as icols is 'i^unout' type so safe to set this to 0 when there is no piece 11 in $$$mtLatestTempFileNum
	s short=$s($$$mtTfHashSubscripts($$$mtTempFile(distf))'="":$p($$$mtTfHashSubscripts($$$mtTempFile(distf)),",",2)="",1:0)
	#; AK841
	s ref=$$tfref(distf,1)
	d:'$p(stuff,$c(1),3) initemp^%qaqcasl(distf,0)  ;  no $SORTBEGIN  ;  AK394;AK419
	if $p(stuff,$c(1),6) {
		s tfvarr=$$$getVarName("hybtf"_distf),tfname=$$$getVarName("hybtfn"_distf)
		d initvar^%qaqcasl(tfname,"##quote("_tfvarr_")")
		d initvar^%qaqcasl(tfvarr)		
	}
	#; AK615-
	#; AK849
	#;  stuff=LIST(dval,)^tfn^noinitflag[^val4^LIST(val5,)] - check
	#;  DISTINCT on the dval listed using temp-file tfn, don't call
	#;  initemp() if noinitflag=1 (AK419), if val4 specified then skip this
	#;  "distinct" check unless val4 equals one of the val5 listed (AK849)
	#;  generate conditional check:  i $lf($lb(2,6,12),v4) {
	i $p(stuff,$c(1),4) {
		$$$liin("i $lf($lb("_$extract($p(stuff,$c(1),5),1,*-1)_"),"_pti($p(stuff,$c(1),4))_") {")
	}
	#; AK849-
	#;  if subscript(s) will not overflow, just use old temp-file structure
	s fpre=$$$getVarName("dist"_distf_"prefix") if 'short s cnt=$$$getVarName("dist"_distf_"cnt")  ;  ,fend=$$$getVarName("distfend"),gend=$$$getVarName("distgend")  ;  AK936
	s var1=$$onesub^%qaqcpr(icols,"dist"_distf_"prefix")  ;  variable used for the single subscript
	s var2=var1  ; Keep copy of this so we can use this if expr>108 characters as null value will never be that long
	#; Before we loop if this isn't distinct, be sure to note that we did find a row to potentially suppress further looping
	i pk=3 { d gruprowfound^%qaqcasl() i grup["nolup" { n bottom s bottom=$s($p(grup,",",4):grup("snbot"),1:tagpre_"dun") } }
	#; bitmap distinct file
	if $$$mtTfBitmapFlag($$$mtTempFile(distf)) {
		$$$liin("g:$bit("_ref_var1_"\64000+1),"_var1_"#64000+1) "_bottom_" s $bit("_ref_var1_"\64000+1),"_var1_"#64000+1)=1")
		GOTO exitdistinct
	}
	#;  if single nullable field, use subscript variable with NULL-marker, just insert expression into 'var1' rather than using a new variable as it is more efficient
	if $$distnull^%qaqcpr(icols) { set var1=$$tomark^%qaqcpr(var1) }
	#; AK841
	n hybad,tfvarr,tfname s hybad=""  ;  AK936;AK986
	s:$$hybtf(distf) tfvarr=$$$getVarName("hybtf"_distf),tfname=$$$getVarName("hybtfn"_distf),ref=$$adsub^%qaqcmn(tfvarr),hybad="d:$i("_tfvarr_")>"_$$maxhyb(distf)_" "_$$hybtag(distf)_" "
	if short {
		if fpre'=var1 {
			if $$$mtTfRealGlobalFlag($$$mtTempFile(distf)) {
				set fpre=var1
			} else {
				#; For frozen plans still need this variable copy
				$$$liin("s "_fpre_"="_var1)
			}
		}
		s ref=ref_fpre_","
		$$$liin("g:$d("_$e(ref,1,*-1)_")) "_bottom_" "_hybad_"s "_$s($e(ref)="^":"^("_fpre,1:$e(ref,1,*-1))_")=""""")
		#; YCL171 was only needed for non-parallel query blocks. Parallel DISTINCT queries send the aggregated temp-file distf to the parent
		#; that processes final results, so reaching bottom is all we really care about (so that we can build the relevant temp-file that
		#; will be sent to parent), so there is no need for an additional check to skip to bottom in such parallel query blocks
		if $$hybtf(distf)&&('$$$useAPE(m)) $$$liin("g:($e("_tfname_")=""^"")&&$d("_$$tfref(distf,1)_fpre_")) "_bottom) ; YCL171
		GOTO exitdistinct
	}  ;  AK936
	s ref=ref_fpre_","
	#; AK841-
	#; AK936
	n fend,gend,hash2 s fend=$$localvar(1),gend=$$localvar(2),hash2=$$localvar(3)
	#;  could be long - must check at run-time whether short or not
	$$$liin("if $l("_var2_")>108 { s "_fend_"=$e("_var2_",109,*),"_fpre_"=$e("_var2_",1,108)_$zcrc("_var2_",7) } else { s "_fend_"="""""_$s(fpre=var1:"",1:","_fpre_"="_var1)_" }")
	#; AK811
	#;  loop over existing entries - 3 cases:  if found then condition
	#;  fails, otherwise continue to the next one, if at the end then
	#;  add it there and the condition passes
	#; AK841
	#; AK936
	i '$$hybcheck(distf) {
		#;  code to check distinct in temp-file, and to add a new entry
		#;      global temp-file:
		#;  f hash2=1:1 s cnt=hash2 q:'$s(hash2=1:$d(^||%t(%sqlt(2),hash1,1),gend),1:$d(^(hash2),gend))  g:gend=fend bottom
		#;  s ^(hash2)=fend
		#;      local (hybrid) temp-file:
		#;  f hash2=1:1 s cnt=hash2 q:'$d(%sqlvtf(hash1,hash2),gend)  g:gend=fend bottom
		#;  d:$i(%sqlvcc)>123456 hmerge s %sqlvtf(hash1,hash2)=fend
		$$$liin("f "_hash2_"=1:1 s "_cnt_"="_hash2_" q:'"_$s($e(ref)="^":"$s("_hash2_"=1:$d("_ref_"1),"_gend_"),1:$d(^("_hash2_"),"_gend_"))",1:"$d("_ref_hash2_"),"_gend_")")_"  g:"_gend_"="_fend_" "_bottom)
		$$$liin(hybad_"s "_$s($e(ref)="^":"^(",1:ref)_hash2_")="_fend)
	} else {
		#;  hybrid, but a separate temp-file for the "data" node drives`
		#;  the 2nd pass - the "distinct" check must also consult with
		#;  the global, if any, and both must use the same hash2 value:
		#;  s cnt=0,hash2=0
		#;  f  s hash2=$o(%sqlvtf(hash1,hash2),1,gend) QUIT:hash2=""  s cnt=hash2 g:gend=fend bottom
		#;  i $e(tfname)="^" { f hash2=1:1 { i $s(hash2=1:$d(^||%t(%sqlt(2),hash1,1),gend),1:$d(^(hash2),gend)) { i gend=fend { DO  g %0AmDdun } } else { s:cnt>=hash2 hash2=cnt+1 DO  QUIT } } } else { s hash2=cnt+1 DO  }
		#;  . s cnt=hash2 d:$i(%sqlvcc)>123456 hmerge s %sqlvtf(hash1,hash2)=fend
		$$$liin("s "_cnt_"=0,"_hash2_"=0")
		$$$liin("f  s "_hash2_"=$o("_ref_hash2_"),1,"_gend_") q:"_hash2_"=""""  s "_cnt_"="_hash2_" g:"_gend_"="_fend_" "_bottom)
		$$$liin("i $e("_tfname_")=""^"" { f "_hash2_"=1:1 { i $s("_hash2_"=1:$d("_$$tfref(distf,1)_fpre_",1),"_gend_"),1:$d(^("_hash2_"),"_gend_")) { i "_gend_"="_fend_" { d  g "_bottom_" } } else { s:"_cnt_">="_hash2_" "_hash2_"="_cnt_"+1 d  q } } } else { s "_hash2_"="_cnt_"+1 d }")
		$$$liin(". s "_cnt_"="_hash2_" "_hybad_"s "_ref_hash2_")="_fend)
	}
	#; AK936-
	#; AK811-
	#; AK615-
	#; AK849
exitdistinct	if $p(stuff,$c(1),4) $$$liin("}")  ;  close conditional check
	#; AK438-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK936
hybcheck(tf)  ;  $$: 1 if a separate data temp-file is used, which requires a
	#;  global DISTINCT check before adding the temp-file data row
	RETURN:'$$hybtf(tf) 0  ;  not a hybrid temp-file
	n tempid  ;  see if the non-aggregate data node is in this temp-file
	RETURN '$d($$$mtTfAslNode(tf,1),tempid)||($$$aslActNodeAggFunc($g($$$aslActNode(+tempid,$p(tempid,"^",2),4)))'="")
maxhyb(tf) [ mt ] PUBLIC { ;  $$:  #rows estimated to fit in a reasonable local array; 
	Set length = $p($$$mtTfEntAvglen($$$mtTempFile(tf)),",",2) ; estimated length of a single row in this tf
	Set memoryThreshold = $$$LocalArrayMemoryThreshold 	; the default memory threshold; this should be consistent with what's used in useLocalArrayTempfile^%qaqpmod!!	
	Set bbsize = $$Getbbsiz^%SYS.SQLSRV()*1024 ; bbsize in byte
	If memoryThreshold>(bbsize\8) Set memoryThreshold=bbsize\8
	#;  Row estimate = memoryThreshold/(((#aggs+1)*64)+avglen)\1 
	RETURN memoryThreshold/(($g($$$mtTfNodeCounter(tf))+1)*64+length)\1
}
.
hybtf(tf) [ mt ] PUBLIC { ;  $$:  1 if a hybrid temp-file used for DISTINCT statements
	RETURN:'$d($$$mtTempFile(tf)) 0
	if $$$mtTfBitmapFlag($$$mtTempFile(tf)) RETURN 0    ; bitmap temp file is not hybrid
	RETURN $$$mtTfLocation($$$mtTempFile(tf))&&($$$mtTfType($$$mtTempFile(tf))="dist")
}
.
hybtfForNonDistinct(tf) [ asl,mt ] PUBLIC {
	// Returns 1 if tf is a new/post-EEE019 hybrid temp-file, which differs than the old one in that this one is used for non-DISTINCT statements:
	// - 	A bitmap temp file will not be considered as a post-EEE019 hybrid (reasoning in EEE019);
	//   	sometimes the bitmap indicator is hidden in p8 of the ASL module (for more context, search files for variations of $p(asl(bmod,ACTION,1),$c(1),8)="bit");
	//		bitslice temp-files also fall under this category (TRW1529) - for such temp-files, bsl^%qaqpmod sets asl(mod,KEY)="bsl" and creates the temp-file with p2=mod, so we will check that asl node
	// - 	VectorJoin temp-files also won't be eligible (see AK1064, reasoning in EEE019)
	RETURN:'$d($$$mtTempFile(tf)) 0
	if $$$mtTfBitmapFlag($$$mtTempFile(tf)) RETURN 0
	set mod = $$$mtTfModNum($$$mtTempFile(tf))
	if mod {
		RETURN $$$mtTfType($$$mtTempFile(tf))'="dist" && 
			   $$$mtTfLocation($$$mtTempFile(tf)) && 
			   ($$$aslActIsBmTf($$$aslAct(mod,1))'="bit") && 
			   ($$$aslActVecJoin($$$aslAct(mod,1))="") &&
			   ($g($$$aslKRoot(mod))'="bsl")
	}
	RETURN 0
}
.
glotf(tf) [ asl,mt ] PUBLIC { ;  $$:  1 if a global temp-file (including hybrid)
	RETURN:'$d($$$mtTempFile(tf),tfv) 0  ;  not sure why or how, logic copied from AK841 filenum^%qaqcasl
	if $p(tfv,"^",16) RETURN 0  ; bitmap temp file uses locals
	RETURN '$p(tfv,"^",12)||($p(tfv,"^")="dist")
}
hybtag(tf,sharedTf="",fromLocal=1)  ;  $$:  tag that merges %sqlvtf() into global when cc gets too big
	#; When sharedTf'="":
	#; 		1. tf is the temp-file number of the worker's local array/PPG (source temp-file to be copied from)
	#; 		2. sharedTf is the temp-file number of the shared global (destination temp-file to be copied into)
	#; 		3. fromLocal tells us whether we are copying from a local array (1) or a PPG (0)
	#; 		This subroutine generates the code lines for the subroutines that are called when we are using a shared global in parallel aggregation (e.g., GROUP BY)
	#; See later below for examples of the generated code
	n htag s htag=$$$mtTfHybridMerge($$$mtTempFile(tf))  ;  maybe generated by the other call
	If sharedTf'="" {
		New tmphtag
		Set tmphtag=$p($g($$$mtAPESharedGlobal(m)),"^",$s(fromLocal:4,1:5))
		If tmphtag'="" RETURN tmphtag
	} Else {
		RETURN:htag'="" htag  ;  also called from calltemp() for final merge
	}
	#; When sharedTf="", this subroutine generates the following hybrid copy/merge code:
	#;
	#;	For "short" GROUP BY, no "hash" overflow nodes, always use 1 as
	#;	"hash2" subscript:
	#;  hmerge
	#;   i $d(^||%t(i%%CursorDatat(1)))<9 { MERGE ^||%t(i%%CursorDatat(1))=tf } else {
	#;   n grp,tnd,gnd s grp=""
	#;   f { s grp=$o(tf(grp)) QUIT:grp=""
	#;   i '$d(^||%t(i%%CursorDatat(1),grp)) { MERGE ^(grp)=tf(grp) CONTINUE }
	#;   ; no need to copy the "data" node, if any
	#;   ; naked:  first time through use ^(grp,2), thereafter use ^(3), ^(4) etc.
	#;   i $i(^(grp,2),tf(grp,2)) { } ; COUNT(*)
	#;  
	#;   i $d(tf(grp,3),tnd) { i $i(^(grp,3),tnd) { } } ; SUM, COUNT(x), could also be used for COUNT(*)
	#;   i $d(tf(grp,4),tnd) { s:'$d(^(grp,4),gnd)||(gnd]]tnd) ^(4)=tnd } ; MIN
	#;   i $d(tf(grp,5),tnd) { s:'$d(^(grp,5),gnd)||(tnd]]gnd) ^(5)=tnd } ; MAX
	#;   i $d(tf(grp,6),tnd) { s ^(6)=$s($d(^(grp,6),gnd):gnd_",",1:"")_tnd } ; LIST
	#;   i $d(tf(grp,7),tnd) { s ^(7)=$g(^(grp,7))_tnd } ; XMLAGG, %DLIST
	#;   ;  note - "^(grp,2)" used exactly once in all the code above!
	#;   } }
	#;   KILL tf s cc=0,glo=1
	#;   RETURN
	#;
	#;	For "long" GROUP BY with overflow nodes:
	#;  hmergelong
	#;   i $d(^||%t(i%%CursorDatat(1)))<9 { MERGE ^||%t(i%%CursorDatat(1))=tf } else {
	#;   n grp,tfc,gc,tnd,gnd s grp="",tfc=""
	#;   f { s grp=$o(tf(grp)) QUIT:grp=""
	#;   i '$d(^||%t(i%%CursorDatat(1),grp)) { MERGE ^(grp)=tf(grp) CONTINUE }
	#;   f { s tfc=$o(tf(grp,tfc),1,tnd) QUIT:tfc=""
	#;   f gc=1:1 s gnd=tnd_" " QUIT:'$d(^||%t(i%%CursorDatat(1),grp,gc),gnd)||(gnd=tnd)
	#;   i gnd'=tnd { MERGE ^(gc)=tf(grp,tfc) CONTINUE }
	#;   ; no need to copy the "data" node, if any
	#;   ; naked:  first time through use ^(gc,2), thereafter use ^(3), ^(4) etc.
	#;   i $i(^(gc,2),tf(grp,tfc,2)) { } ; COUNT(*)
	#;   i $d(tf(grp,tfc,3),tnd) { i $i(^(gc,3),tnd) { } } ; SUM, COUNT(x), could also be used for COUNT(*)
	#;   i $d(tf(grp,tfc,4),tnd) { s:'$d(^(gc,4),gnd)||(gnd]]tnd) ^(4)=tnd } ; MIN
	#;   i $d(tf(grp,tfc,5),tnd) { s:'$d(^(gc,5),gnd)||(tnd]]gnd) ^(5)=tnd } ; MAX
	#;   i $d(tf(grp,tfc,6),tnd) { s ^(6)=$s($d(^(gc,6),gnd):gnd_",",1:"")_tnd } ; LIST
	#;   i $d(tf(grp,tfc,7),tnd) { s ^(7)=$g(^(gc,7))_tnd } ; XMLAGG, %DLIST
	#;   ;  note - "^(gc,2)" used exactly once in all the code above!
	#;   } } }
	#;   KILL tf s cc=0,glo=1
	#;   RETURN
	#; 
	#; When sharedTf'="", this subroutine generates the code lines for the subroutines that are called when we are using a shared global in parallel aggregation (e.g., GROUP BY).
	#; It generates one of two possible subroutines; those subroutines copy data from the PPG of the worker to the shared global if a PPG was used and from the local array of the worker otherwise.
	#; It returns the subroutine's tag (which is stored in $p(mt("APE",m,"sharedGlobal"),"^",4) for a local array and $p(mt("APE",m,"sharedGlobal"),"^",5) for a PPG).
	#; 
	#; Example of subroutine that copies from local array to shared global:
	#;  n grp,tnd,gnd s grp=""
	#;	try {
	#;		f {
	#;			s grp=$o(i%hybtf1(grp)) q:grp=""
	#;			lock +^IRIS.Temp.SQL($zlist(i%tablenum2,grp))
	#;			i '$d(^IRIS.Temp.SQL(i%tablenum2,grp)) { m ^(grp)=i%hybtf1(grp) lock -^IRIS.Temp.SQL($zlist(i%tablenum2,grp))#"I" continue }
	#;			d $i(^(grp,4),i%hybtf1(grp,4))
	#;			i $d(i%hybtf1(grp,2),tnd) { d $i(^(2),tnd) }
	#;			i $d(i%hybtf1(grp,3),tnd) { d $i(^(3),tnd) }
	#;			lock -^IRIS.Temp.SQL($zlist(i%tablenum2,grp))#"I"
	#;		}
	#;	} catch {
	#;		lock -^IRIS.Temp.SQL($zlist(i%tablenum2,grp))#"I"
	#;		throw
	#;	}
	#;	k i%hybtf1
	#;	ret
	#;
	#; Example of subroutine that copies from PPG to shared global:
	#; 	n grp,tnd,gnd s grp=""
	#; 	try {
	#;  	f {
	#; 			s grp=$o(^||%t(i%tablenum1,grp)) q:grp=""
	#; 			lock +^IRIS.Temp.SQL($zlist(i%tablenum2,grp))
	#; 			i '$d(^IRIS.Temp.SQL(i%tablenum2,grp)) { m ^IRIS.Temp.SQL(i%tablenum2,grp)=^||%t(i%tablenum1,grp) lock -^IRIS.Temp.SQL($zlist(i%tablenum2,grp))#"I" continue }
	#; 			d $i(^IRIS.Temp.SQL(i%tablenum2,grp,4),^||%t(i%tablenum1,grp,4))
	#; 			i $d(^||%t(i%tablenum1,grp,2),tnd) { d $i(^IRIS.Temp.SQL(i%tablenum2,grp,2),tnd) }
	#; 			i $d(^||%t(i%tablenum1,grp,3),tnd) { d $i(^IRIS.Temp.SQL(i%tablenum2,grp,3),tnd) }
	#; 			lock -^IRIS.Temp.SQL($zlist(i%tablenum2,grp))#"I"
	#; 		}
	#; 	} catch {
	#; 		lock -^IRIS.Temp.SQL($zlist(i%tablenum2,grp))#"I"
	#; 		throw
	#; 	}
	#; 	k ^||%t(i%tablenum1)
	#; 	ret
	new %SQLCodeGenTabIndent,agg,aslref,code,copyPPG,cst,down,gref,nakedPtrNoGrp,nakedPtrWithGrp,node,ref,ref2,refsub,short,tempid,tfc
	Set %SQLCodeGenTabIndent=0 // Set indentation for the generated code
	#; If the subscript is short we skip the extra field in the temp file, use this rather than recalculate $$short because of frozen plans
	#; For union $$short never returns true as icols is 'i^unout' type so safe to set this to 0 when there is no piece 11 in $$$mtLatestTempFileNum
	set short=$s($$$mtTfHashSubscripts($$$mtTempFile(tf))'="":$p($$$mtTfHashSubscripts($$$mtTempFile(tf)),",",2)="",1:0)
	set tfc=$s(short:"",1:"tfc,"),aslref=$s(short:3,1:4)
	#; When sharedTf="", ref=global ref including first comma, ref2=reference with closing ')'
	#; Otherwise,
	#; 		ref=global ref of shared global (destination) ready for 1st subscript (i.e., "^IRIS.Temp.SQL(i%tablenum2,")
	#; 		ref2=global ref of shared global (destination) with closing ')'
	Set ref=$$tfref($s(sharedTf'="":sharedTf,1:tf),1,2) ; readWriteMode=2 to request a reference to the PPG temp-file "^||%t(tablenum1," if what we are referencing (merging into, in such cases) is a non-DISTINCT hybrid temp-file
	Set ref2=$$tfref($s(sharedTf'="":sharedTf,1:tf),2,2)
	Set copyPPG=(sharedTf'="")&&('fromLocal)
	#;  ref=local array top node, refsub=local array/PPG ready for 1st sub
	Set refsub=$s(copyPPG:$$tfref(tf,1,2),1:$$adsub^%qaqcmn(tfvarr)) ; readWriteMode=2 to request a reference to the PPG in case it's a non-DISTINCT hybrid
	#; Naked pointers are used only when copying from a local array (not PPG)
	Set nakedPtrNoGrp=$s(copyPPG:ref,1:"^(")
	Set nakedPtrWithGrp=$s(copyPPG:ref_"grp,",1:"^(")
	if $$$mtTfLocation($$$mtTempFile(tf))=2 || $$hybtfForNonDistinct(tf) {
		d code("")
		d code("i $g("_$$$getVarName("tablenum"_tf)_")="""" s "_$$$getVarName("tablenum"_tf)_"=$i("_$s($$$mtTfRealGlobalFlag($$$mtTempFile(tf)):$$$tGlobalQ,1:$$$tFileQ)_")")
		if $$hybtfForNonDistinct(tf) {
			// If TOP optimization is used, only copy the topn nodes to the PPG
			if $$$mtTopTempFile($g($$$mtTopLimit(m)))=tf {
				d code("n grp,topn s grp=""""")
				d code("f {")
				// Loop over the groups in reverse order only when DESC is applied to the first subscript in the temp-file (since "SELECT TOP 3 ... f1 ASC, f2 DESC" should not copy to PPG in reverse)
				d code("s grp=$o("_refsub_"grp)"_$s((($p($$$mtSequencersQb(m),",",1)["d")):",-1",1:"")_") q:grp=""""",$i(%SQLCodeGenTabIndent))
				d code("q:$i(topn)>("_$$paginationTotalRows^%qaqcct(m)_") ")
				d code("m "_ref_"grp)="_refsub_"grp)")
				d code("}",$i(%SQLCodeGenTabIndent,-1))
			} else {
				// No TOP optimization, merge entire local into PPG
				d code("m "_ref2_"="_tfvarr)
			}
			d code("k "_tfvarr_" s "_tfname_"=$na("_ref2_")")
		} else {
			d code("m "_ref2_"="_tfvarr_" k "_tfvarr_" s "_tfname_"=$na("_ref2_")")
		}
		d code("ret")
		s htag=$$subroutn^%qacsub("code",$$untag^%qaqcpre(),,1)
		s $$$mtTfHybridMerge($$$mtTempFile(tf))=htag
		Kill %SQLCodeGenTabIndent
		RETURN htag
	}	
	#;  first time through just MERGE the whole temp-file
	#; When sharedTf is used, we go directly to the group by group aggregation logic for the shared global (destination), skipping merging from local array/PPG because we can't lock the main global node
	If sharedTf="" {
		d code("")
		d code("i $g("_$$$getVarName("tablenum"_tf)_")="""" {")
		d code("s "_$$$getVarName("tablenum"_tf)_"=$i("_$s($$$mtTfRealGlobalFlag($$$mtTempFile(tf)):$$$tGlobalQ,1:$$$tFileQ)_") m "_ref2_"="_tfvarr_"",$i(%SQLCodeGenTabIndent))
		d code("} else {",$i(%SQLCodeGenTabIndent,-1))
		d $i(%SQLCodeGenTabIndent)	// Increment indentation level for the else block
	} Else {
		d code("")
	}
	d code("n grp,tnd,gnd"_$s(short:" s ",1:",tfc,gc s tfc="""",")_"grp=""""")
	New mainindent,mainline
	Set mainline=code	// Used later to modify the generated code
	Set mainindent=%SQLCodeGenTabIndent	// Ditto
	#; When sharedTf is used, we start a try/catch block
	If sharedTf'="" { 
		d code("try {")
		d $i(%SQLCodeGenTabIndent)	// Increment indentation level for the try block
	}
	#;  loop over all prefixes in the local array
	d code("f {")
	d code("s grp=$o("_refsub_"grp)) q:grp=""""",$i(%SQLCodeGenTabIndent))
	#; When sharedTf is used, we lock the shared global (destination).
	#; We use a list for the lock name because it offers better performance than using a global node. Notes:
	#; 		$zlist(), unlike $lb(), ensures that list elements are coerced into strings to match the format of global subscripts.
	#; 		This ensures consistency when accessing (locking/unlocking) group subscripts. For example, we shouldn't be able to edit node ^a(4) 
	#; 		from process A, while another process B is holding a lock ^a($lb(4)), just because the current process A has grp="4" instead of grp=4.
	#; 		In addition, MAK4383 points out that $zlist() is slightly faster than $lb(), both being faster than using the global node as the lock name.
	If sharedTf'="" { d code("lock +"_$$$tGlobalQ_"($zlist"_$p(ref,$$$tGlobalQ,2,*)_"grp))") }
	#;  if same prefix never found, just MERGE the whole prefix set
	#; When sharedTf is used, we release the shared global lock
	d code("i '$d("_ref_"grp)) { m "_nakedPtrNoGrp_"grp)="_refsub_"grp) "_$s(sharedTf'="":"lock -"_$$$tGlobalQ_"($zlist"_$p(ref,$$$tGlobalQ,2,*)_"grp))#""I"" ",1:"")_"continue }")
	#;  for "long" version, loop over all new values for the given prefix
	i 'short {
		d code("f {")
		d code("s tfc=$o("_refsub_"grp,tfc),1,tnd) q:tfc=""""",$i(%SQLCodeGenTabIndent))	// Indent inner for loop
		#;  loop to see if this exact value is already in the global temp-file
		i '$$hybcheck(tf) {  ;  for the long recheck case, tfc=gc
			d code("f gc=1:1 s gnd=tnd_"" "" q:'$d("_ref_"grp,gc),gnd)||(gnd=tnd)")
			#;  if it's a new GROUP BY value, just MERGE its whole information
			d code("i gnd'=tnd { m "_nakedPtrWithGrp_"gc)="_refsub_"grp,tfc) continue }")
		} else {
			d code("i '$d("_ref_"grp,tfc),gnd) { m "_nakedPtrWithGrp_"tfc)="_refsub_"grp,tfc) continue } s gc=tfc")
	} }
	#;  exact GROUP BY value already is in the global, no need to copy the
	#;  data, but each aggregate value, if any, would have to be combined
	#;  adjust the naked to one/two levels below, but only once!
	s down=$s(short:"grp,",1:"gc,")  ;  e.g. ^(grp,1,2), ^(3), ^(4), ...
	s cst=""  ;  first look for COUNT(*) node, if any
	f node=1:1:$g($$$mtTfNodeCounter(tf)) {
		s tempid=$$$mtTfAslNode(tf,node),agg=$p($g($$$aslActNode(+tempid,$$$mtTfNodeNpk(tempid),aslref)),$c(1),6,7)  ;  agg[V[arg]]
		#;  use naked adjustment on COUNT(*), and the rest is simple
		i $p(agg,$c(1))="count",'$p(agg,$c(1),2) { d code("d $i("_nakedPtrNoGrp_down_node_"),"_refsub_"grp,"_tfc_node_"))") s cst=node QUIT }
	}
	i 'cst { n agindent,agline s agline=code s agindent=%SQLCodeGenTabIndent }
	f node=1:1:$g($$$mtTfNodeCounter(tf)) {
		CONTINUE:node=cst  ;  COUNT(*) already processed
		s tempid=$$$mtTfAslNode(tf,node),agg=$$$aslActNodeAggFunc($g($$$aslActNode(+tempid,$$$mtTfNodeNpk(tempid),aslref)))  ;  agg
		#;  i $d(tf(grp,1,3),tnd) { i $i(^(3),tnd) { } }  ;  SUM, COUNT(x)
		i (agg="sum")||(agg="count")     { d hybag("d ",                "$i(", ",tnd)",  "") CONTINUE }  ;   AK961
		;i (agg="sum")||(agg="count")     { d hybag("TRY { i "         , "$i(", ",tnd)", " { } } catch { throw:$ZERROR'[""<MAXINCREMENT>"" }") CONTINUE }  ;  AK961
		#;  i $d(tf(grp,1,4),tnd) { s:'$d(^(4),gnd)||(gnd]]tnd) ^(4)=tnd }  ;  MIN
		i (agg="min")                    { d hybag("s:'",               "$d(", ",gnd)", "||(gnd]]tnd) "_nakedPtrWithGrp_node_")=tnd") CONTINUE }
		#;  i $d(tf(grp,1,5),tnd) { s:'$d(^(5),gnd)||(tnd]]gnd) ^(5)=tnd }  ;  MAX
		i (agg="max")                    { d hybag("s:'",               "$d(", ",gnd)", "||(tnd]]gnd) "_nakedPtrWithGrp_node_")=tnd") CONTINUE }
		#;  i $d(tf(grp,1,6),tnd) { s ^(6)=$s($d(^(6),gnd):gnd_",",1:"")_tnd }  ;  LIST
		i (agg="list")                   { d hybag("s "_nakedPtrWithGrp_node_")=$s(", "$d(", ",gnd)", ":gnd_"","",1:"""")_tnd") CONTINUE }
		#;  i $d(tf(grp,1,7),tnd) { s ^(7)=$g(^(7))_tnd }  ;  XMLAGG, %DLIST
		i (agg="xmlagg")||(agg="%dlist") { d hybag("s "_nakedPtrWithGrp_node_")=",    "$g(", ")",     "_tnd") CONTINUE }
		#;  must be the data node, not interesting
	}
	#;  for the last line generated, no need to set nf=1
	i 'cst,$e(code(code),*-7,*)="s nf=1 }" { s $e(code(code),*-7,*)="}" }
	i 'cst,code>(agline+1) {
		Set $e(code(mainline),1,3)=" "_$e($c(9,9,9,9,9,9,9,9,9,9),1,mainindent)_"n nf,"
		Set $e(code(agline+1))=" "_$e($c(9,9,9,9,9,9,9,9,9,9),1,agindent)_"s nf=0 "
	}
	If 'short { d code("}",$i(%SQLCodeGenTabIndent,-1)) } // Closing the bracket that 'short opened
	#; When sharedTf is used, we release the shared global lock right before closing the main for loop
	If sharedTf'="" {
		d code("lock -"_$$$tGlobalQ_"($zlist"_$p(ref,$$$tGlobalQ,2,*)_"grp))#""I""")	// Releasing the lock when sharedTf is used
	} Else {
		d code("}",$i(%SQLCodeGenTabIndent,-1))	// Closing the main for loop when sharedTf is not used
	} 
	d code("}",$i(%SQLCodeGenTabIndent,-1))	// Closing the main for loop when sharedTf is used and the else block otherwise (since we still have an open if-branch merge when sharedTf is not used)
	#; When sharedTf is used, we finish the try/catch block
	If sharedTf'="" {
		d code("} catch {",$i(%SQLCodeGenTabIndent,-1))	// Closing the try block
		d code("lock -"_$$$tGlobalQ_"($zlist"_$p(ref,$$$tGlobalQ,2,*)_"grp))#""I""",$i(%SQLCodeGenTabIndent))
		d code("throw")
		d code("}",$i(%SQLCodeGenTabIndent,-1))	// Closing the catch block
	}
	d code("k "_$s(copyPPG:$$tfref(tf,2,1),1:tfvarr)) ; readWriteMode=1 to request a reference to the local temp-table in case this is a non-DISTINCT hybrid
	#; When sharedTf is used, we don't reset the tfname
	If sharedTf="" { d code("s "_tfname_"=$na("_ref2_")") }
	d code("ret")
	If sharedTf="" {
		s htag=$$subroutn^%qacsub("code",$$untag^%qaqcpre(),,1)
		s $$$mtTfHybridMerge($$$mtTempFile(tf))=htag
	} Else {
		Set htag=$$subroutn^%qacsub("code",htag_"Write"_$SELECT(fromLocal:"LocalArray",1:"PPG")_"ToSharedGlobal",,1)
		Set $p($$$mtAPESharedGlobal(m),"^",$s(fromLocal:4,1:5))=htag
	}
	Kill %SQLCodeGenTabIndent // Used in other files
	RETURN htag
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
hybag(A,B,C,D)  ; [public: cst,tfc,node,gref,down,agline,code] add 1 aggregate line through various code cases
	#;  if COUNT(*) already done, then just use simple naked, for example:
	#;  i $d(tf(grp,1,3),tnd) { i $i(^(3),tnd) { } } ; SUM, COUNT(x)
	#; If copying from a PPG (and using sharedTf in hybtag), we use the naked pointer replacement(s) stored in nakedPtrWithGrp/nakedPtrNoGrp
	i cst { d code("i $d("_refsub_"grp,"_tfc_node_"),tnd) { "_A_B_nakedPtrWithGrp_node_")"_C_D_" }") RETURN }
	#;  else, use B^(4)C or B^(grp,1,4)C , depending on nf, for example:
	#;  i $d(tf(grp,1,4),tnd) { i $s(nf:$i(^(4),tnd),1:$i(^(grp,1,4),tnd)) { } s nf=1 }
	#;  for the 1st aggregate line generated, always adjust down the naked,
	s gref=B_nakedPtrNoGrp_down_node_")"_C  ;  in case agline=code
	#;  for the other lines we may or may not need to, depending on nf
	if agline'=code {
		d code("i $d("_refsub_"grp,"_tfc_node_"),tnd) { if nf { "_A_B_nakedPtrWithGrp_node_")"_C_D_" } else { "_A_gref_D_" } s nf=1 }")
	} else {
		d code("i $d("_refsub_"grp,"_tfc_node_"),tnd) { "_A_gref_D_" s nf=1 }")
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
code(line,indent="")	// Copied indentation logic from liin^%qaqcasl and edited it to support existing use cases of code()
	// If no indentation level was provided, set it to $g(%SQLCodeGenTabIndent) (could be "")
	If indent="" { Set indent=$g(%SQLCodeGenTabIndent) }
	// If indentation level is 0 (either because %SQLCodeGenTabIndent is 0 or indent was passed in as 0) then we add a whitespace before the line
	Set line=$s(indent=0:" "_line,1:$e($c(9,9,9,9,9,9,9,9,9,9),1,indent)_line)
	s code($i(code))=line  ;  add line to the code
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
localvar(n)  ;  use unsubscripted variable %sqldataNNv, to be used only locally
	s n="%sqldata"_n_"v" d vNEW^%qaqcasl(n)
	QUIT n
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK936-
	#; AK841
short(icols,order="",isLocalArr=0) [mt,mts] public { ;  $$:  whether icols will fit in the subscript - 1 if the
	#;  following is less than 110: Add up for each field in icols:
	#;  if it's a string - MAXLEN+3, if numeric/date/time - 10,
	#;  timestamp - 20, default - 20, otherwise return 0.
	
	#; First if we are ordering by these fields then they must be 'short'
	set found=0
	for i=1:1:$l(icols,",")-1 {
		if (","_order)'[(","_$p(icols,",",i)_",") Set found=1 QUIT
	}
	if 'found RETURN 1
	#; YCL111 - use 32766 as subcript limit for local array
	s tot=0,limit=$s(isLocalArr:32766,1:110)
	for {
		q:'icols
		s v=$$$mtV(+icols),icols=$p(icols,",",2,*)
		if $e(v)="v" {
			#; Numeric expression means we return a number so count this as 20
			if $lf($lb("+","-","/","*","%PLUS","%MINUS","%RMINUS","ABS","ACOS","ASIN","ATAN","CEILING","POWER","QUARTER","CAST_INT","CAST_DOUBLE","CAST_NUMERIC"),$p(v,"^",2)) {
				set tot=tot+20 
				RETURN:tot>=limit 0 
				continue
			#; YCL114 - check value for remove leading space
			} elseif ($p(v,"^",2) = "%RMLSP") {
				set icols = $p(icols,",",2,*)_$p(v,"^",4)_","
				continue
			} elseif $p($p(v,"^",2),":",1)="%WINDOW_FUNCTION" { 
				#; YCL207 - Check max length for window functions
				if '$p(v,"^",8) { 
					#; if there is no $p(8) (1st argument), the output should be a integer: 
					#; ROW_NUMBER(),RANK(),PERCENT_RANK()
					set tot=tot+20 
					RETURN:tot>=limit 0 
					continue
				} else {
					#; if there is $p(8) (1st argument), use the max length for the 1st argument
					set icols = $p(icols,",",2,*)_$p(v,"^",8)_","
					continue
				}
			}
		}
		#; Aggregate also return a number (may be others we wish to include)
		if $e(v)="a",$lf($lb("sum","min","max","count","avg"),$p(v,"^",2)) {
			set tot=tot+20 
			RETURN:tot>=limit 0 
			continue
		}
		RETURN:$e(v)'="f" 0
		#; YCL114 - if this is a vfld check subq-original-val
		set ifn = +$p(v,"^",3)
		if $d($$$mtVirf(ifn)){
			set icols = $p(icols,",",2,*)_$lg($$$mtVirf(ifn),2)_","
			continue
		}
		set str=$p(v,"^",2),irn=+$$$mtR(str)
		#; IBA057 adjusted $p4 of mts(qb,str,"ATT",ifn) when MAXLEN="", we can still retrieve MAXLEN from smd
		#; len=$p($g(mts($$$mtRQb($$$mtR($p(v,"^",2))),$p(v,"^",2),"ATT",$p(v,"^",3)),"^^^20"),"^",4)
		set len=$$$smdColMaxLength(1,irn,ifn)
		s:$g($$$mtRVirtual(str)) len=$p($$viewfldst^%qaqpqo(str,ifn,1),"^",2)
		if len="" RETURN 0   ; MAXLEN="" means string can be any length
		
		#; Check for a $LIST collection, which could have N elements of MAXLEN
		if $$$smdColListCollection(1,irn,ifn) = "Y" RETURN 0
		set tot=tot+len+3
		RETURN:tot>=limit 0
	}
	RETURN tot<limit  ;  will fit at least 2 fields with default MAXLEN=50
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK841-
	#; AK403
gencoll(fun,arg)  ;  $$:  code for collation fun(arg)
	#; DPV1567
	RETURN:fun="%SQLUPPER" $$$SQLUPPERCodeGen(arg)
	RETURN:fun="%ALPHAUP" $$$ALPHAUPCodeGen(arg)
	RETURN:fun="%MVR" $$$MVRCodeGen(arg)
	RETURN:fun="%UPPER" $$$UPPERCodeGen(arg)
	RETURN:fun="%SQLSTRING" $$$SQLSTRINGCodeGen(arg)
	RETURN:fun="%STRING" $$$STRINGCodeGen(arg)
	RETURN:fun="%TRUNCATE" $$$TRUNCATECodeGen(arg)
	if ($$$ISENCODEDCOLLATE(fun)) {
		new parm1,parm2
		do decodeCollate(fun,.parm1,.parm2)
		RETURN $$$COLLATETCodeGen(arg,parm1,parm2)
	}
		#; DPV1567-
		#;  apply the truncation
	RETURN:fun["(" "$e("_$$gencoll($p(fun,"("),arg)_",1,"_$s(fun["#":$$ptvalue^%qaqcpr(+$p(fun,"(",2)),1:+$p(fun,"(",2))_")"
	RETURN:fun="%SPACE" "("" ""_"_arg_")"  ;  Space Prefix
	RETURN:fun="%PLUS" "+"_arg  ;  unary +
	RETURN:fun="%MINUS" "-"_arg  ;  unary -
	RETURN arg  ;  needed?
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK403-
	#; MIT070
opval(op,val,ptival) n code  ;  apply val.op to ptival
	#;  op is either %RUNTIMEOUT, %ODBCOUT, %EXTERNAL
	;  *** should add $$convnull, use parameters if field!
	#; AK668
	QUIT $$appmeth^%qaqcpr(ptival,$s(op="%ODBCOUT":"LogicalToOdbc",op="%EXTERNAL":"LogicalToDisplay",op="%RUNTIMEOUT":"LogicalToRuntime",op="%FDBMS":"LogicalToFDBMS",1:""),val)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; MIT070-
settemp(vals)  ;
	#;
	#; set expressions into their var's.  from temp+3,cond+11,
	#; and from close+1^asl.  This figures it out and inserts the code.
	#; If a field needs another field, it'll insert the code for that.
	#;
	n i5,val,line
	//expressions need only be evaluated once in this context
	#;  n cgc do cgcInit^%qaqcasl  ;  TRW1449  ;  removed by AK1090
	f i5=1:1 s val=$p(vals,",",i5) q:val=""  d davalue^%qaqcpr(val)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK419
init(val)  ;  for val = $LB(tfmod,tfkey,tfnk,val#),
	#;  initialize a temp file specified in asl(tfmod,tfkey,tfnk)
	#;  ("build" if tfkey=4, "dist" if tfkey=1/3);  OR,
	#;  initialize variable val# (temp-file counter, or aggregate)
	n ival
	i $ld(val,4)  s ival=$lg(val,5),val=$li(val,4) d null^%qaqcasl(val,1,ival) QUIT
	s val=$s($li(val,2)=4:$$$aslActTfToBuild($$$aslAct($li(val),$li(val,3))),1:$$$aslPkDistTf($$$aslPkDist($li(val),$li(val,2),$li(val,3))))
	#; AK841
	s val=$$tfref(val,2,1) ; readWriteMode=1 to request a reference to the local temp-file - in case this is a non-DISTINCT hybrid - since it's a kill
	$$$liin("k "_val)
	#; AK841-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK419-
	#; AK841
tfref(tf,comma=0,readWriteMode=0,subscriptsStr="",prefix="",suffix="") [ asl,mt ] public { ;  temp-file reference (comma=0:before comma, comma=1:include comma, comma=2:close bracket) for tf# tf, "%XXXt(tf" if
	#;  local, or  "^||%t(%XXXt(tf)" for global temp-file
	#; AK936
	#; 
	#; EEE019 introduced new non-DISTINCT hybrid temp-files, which required refactoring how temp-files are referenced (different for a read vs. write/build)
	#; readWriteMode:
	#; 		Changes the returned reference as follows (comma logic could adjust the example output accordingly):
	#; 		1. readWriteMode=1 (only affects non-DISTINCT hybrid temp-files) returns a reference to the local temp-file - e.g., "i%hybtf1(..." instead of "i%table1(...". Mostly called in the general write case.
	#; 		2. readWriteMode=2 (only affects non-DISTINCT hybrid temp-files) returns a reference to the PPG - e.g., "^||%t(tablenum1".
	#; 		3. readWriteMode=3 (when the temp-file reference is used for a read; affects both DISTINCT and non-DISTINCT hybrid temp-files) returns a hybrid reference using $select - e.g., "$s($e(i%hybtfn1)=""^"":"i%hybtf1(blah)",1:"_$replace(str,tfvar,hybtf)_")".
	#; 
	#; 		If readWriteMode=0 then the reference returned follows the old logic pre-EEE019 where we only had non-DISTINCT hybrids (for which hybridsel^%qaqcky was enough to appropriately reference the hybrid temp-file).
	#; 		This is the case for instance in distinct^%qaqcpre() - or in bstopfilt^%qaqcpre() and bsrangefilt, which are called from bit2^%qaqcky, which is only applicable to local temp-files (since bitmaps are not post-EEE019 hybrids, same for VectorJoin's).
	#; 		It is also the case when the returned reference is intended to be a global or a (non-hybrid) local.
	#; 
	#; subscriptsStr:
	#; 		Only used when reading, i.e., readWriteMode=3. It represents the list of subscripts and follows the "sub1[,subn]" format. 
	#; 		It behaves similarly to hybridsel^%qaqcky in order to return a hybrid $select reference but while also incorporating subscriptsStr as the subscripts of the temp-file we are referencing.
	#; 
	#; prefix and suffix:
	#; 		Only used when reading, i.e., readWriteMode=3. These represent the prefix and suffix that are to be stitched to the complete temp-file reference (including the subscripts from subscriptsStr, if any).
	#; 		E.g., prefix="d(" and suffix=")" OR prefix="d(" and suffix=",nodeVal)", etc.
	if $$glotf(tf) {
		if $$$mtTfRealGlobalFlag($$$mtTempFile(tf)) { RETURN $$$tGlobalQ_"("_$$$getVarName("tablenum"_tf)_$s(comma=1:",",comma=2:")",1:"") }	// global, not PPG
		// If reading, we still need to incorporate subscriptsStr/prefix/suffix
		if (readWriteMode=3) {
			set subscriptsForPPG = ""
			if subscriptsStr'="" {
				set subscriptsForPPG = ","_subscriptsStr_")"
			}
			set var = $$$tFileQ_"("_$$$getVarName("tablenum"_tf)
			RETURN prefix_var_subscriptsForPPG_suffix
		}
		// Otherwise, we are writing to a PPG
		RETURN $$$tFileQ_"("_$$$getVarName("tablenum"_tf)_$s(comma=1:",",comma=2:")",1:"")
	} elseif readWriteMode && $$hybtfForNonDistinct(tf) {
		if readWriteMode=1 {
			// Writing to a non-DISTINCT hybrid (local version)
			set var = $$$getVarName("hybtf"_tf)
			RETURN $s($e(var,*)=")":$e(var,1,*-1)_$s(comma=1:",",comma=2:")",1:""),1:var_$s(comma=2:"",1:"("))
		} elseif readWriteMode=2 {
			// Writing to a non-DISTINCT hybrid (PPG version)
			RETURN $$$tFileQ_"("_$$$getVarName("tablenum"_tf)_$s(comma=1:",",comma=2:")",1:"")
		} elseif readWriteMode=3 {
			// Reading from a non-DISTINCT hybrid, ignore comma flag and use subscriptsStr/prefix/suffix
			// Some code logic follows hybridsel^%qaqcky
			set var = $$$tFileQ_"("_$$$getVarName("tablenum"_tf) ; We want to use a PPG reference for the "i%hybtfn1=""^""" case in the $select below
			set hybtf = $$$getVarName("hybtf"_tf)
			// When subscriptsStr is non-empty it follows a "sub1[,subn]" format, so we need to preface it with one comma for PPGs and nothing for local
			// and finish it with a closing parantheses before concatenating it to the PPG 
			set subscriptsForLocal = ""
			set subscriptsForPPG = ""
			if subscriptsStr'="" {
				set subscriptsForLocal = subscriptsStr_")"
				set subscriptsForPPG = ","_subscriptsStr_")"
			}
			RETURN "$s($e("_$$$getVarName("hybtfn"_tf)_")=""^"":"_prefix_var_subscriptsForPPG_suffix_",1:"_prefix_$$adsub^%qaqcmn(hybtf)_subscriptsForLocal_suffix_")"
		}
	} else {
		set var = $$$getVarName("table"_tf)
		set finalRef = $s($e(var,*)=")":$e(var,1,*-1)_$s(comma=1:",",comma=2:")",1:""),1:var_$s(comma=2:"",1:"("))
		// If reading, we still need to incorporate subscriptsStr/prefix/suffix
		if (readWriteMode=3) {
			set subscriptsForLocal = ""
			if subscriptsStr="" {
				// Leave alone after adding prefix and suffix
				set finalRef = prefix_finalRef_suffix
			} else {
				// Incorporate subscripts
				set subscriptsForLocal = subscriptsStr_")"
				set finalRef = prefix_var_"("_subscriptsForLocal_suffix
			}
		}
		RETURN finalRef
	}
}
assign(stuff) [ pti, mod ] public {
	Set type = $lg(stuff,1)
	Set val1 = $lg(stuff,2)
	Set val2 = $lg(stuff,3)
	If type = "con" {
		Set line = "s "_pti(val1)_"="_val2
		$$$liin(line)
	}
	If type = "swap" {
		Set svar = $$$getVarName("swap"_mod)
		Set line = "s "_svar_"="_pti(val1)_","_pti(val1)_"="_pti(val2)_","_pti(val2)_"="_svar
		$$$liin(line)
	}
	If type = "if" {
		$$$liin("if " _ $$cond^%qaqcpr(val1) _ "{")
		Do assign($li(stuff,3,*))
		$$$liin("}")
	}
}
bstopfilt(stuff) [ pti ] public {
	Set tfout = $$tfref($lg(stuff,1),2)
	Set tfin = $$tfref($lg(stuff,2),1)
	Set limitv = $lg(stuff,3)
	Set bsid = $lg(stuff,4)
	Set dir = $lg(stuff,5)
	Set finalSort = $lg(stuff,6)
	Set tag = $$bitsliceTopFilter(tfout, tfin, bsid, dir, finalSort)
	$$$liin("Do "_tag_"("_pti(limitv)_")")
}
bsrangefilt(stuff) [ pti ] public {
	Set tfout = $$tfref($lg(stuff,1),1)
	Set tfin = $$tfref($lg(stuff,2),1)
	Set bsid = $lg(stuff,3)
	Set lowerv = $lg(stuff,4)
	Set upperv = $lg(stuff,5)
	Set scale = $lg(stuff,6)
	Set tag = $$bitsliceRangeFilter(tfout, tfin, bsid, scale)
	$$$liin("Do "_tag_"("_$$ptvalue^%qaqcpr(lowerv)_","_$$ptvalue^%qaqcpr(upperv)_")")
}
bitsliceRangeFilter(tfoutref, tfinref, bsid, scale) [ code ] public {
	Set bsref = $$$smdMapGlobal(bsid) _ "("
	Set sub = ""
	For  {
		Set sub = $o($$$smd(12,bsid,6,sub)) QUIT:sub=""
		Set con = $$$smdMSConstant(bsid,sub)
		QUIT:con=""
		Set bsref = bsref _ con _ ","
	}
	New code
	Do code("(lower="""",upper="""") [] public {")
	Do code("	Set count=0,chunkId=""""")
	Do code("	For {")
	Do code(" 		Set chunkId=$o("_tfinref_"chunkId),1,chunk) QUIT:chunkId=""""")
	Do code("		Set count=count+$bitcount(chunk,1)")
	Do code("	}")
	Do code("	If count<10000 RETURN")
	Do code("	Set lslice=$s(lower="""":-1024,1:($bitfind($factor(lower,"_scale_"),1,0,-1) * $s(lower<0:-1,1:1) - 1))")
	Do code("	Set uslice=$s(upper="""":1024,1:($bitfind($factor(upper,"_scale_"),1,0,-1) * $s(upper<0:-1,1:1) + 1))")
	Do code("	//Can't be null, so let's start there.")
	Do code("	Merge filter="_bsref_"""N"")")
	Do code("	//Filter or pass 0?")
	Do code("	If (0<lslice)||(0>uslice) {")
	Do code("		Set chunkId=""""")
	Do code("		For {")
	Do code("			Set chunkId=$o("_bsref_"""Z"",chunkId),1,chunk) QUIT:chunkId=""""")
	Do code("			Set filter(chunkId)=$bitlogic(filter(chunkId)|chunk)")
	Do code("		}")
	Do code("	}")
	Do code("	Else {")
	Do code("		Set chunkId=""""")
	Do code("		For {")
	Do code("			Set chunkId=$o("_bsref_"""Z"",chunkId),1,chunk) QUIT:chunkId=""""")
	Do code("			Set pass(chunkId)=$bitlogic(pass(chunkId)|chunk)")
	Do code("		}")
	Do code("	}")
	Do code("	Set slice=""""")
	Do code("	For {")
	Do code("		Set slice=$o("_bsref_"slice),1,slice) QUIT:slice=""""  CONTINUE:+slice=0")
	Do code("		If '((slice>=uslice)||(slice>=lslice)||(-slice<=lslice)||(-slice<=uslice)) CONTINUE")
	Do code("		Set chunkId=""""")
	Do code("		For {")
	Do code("			Set chunkId=$o("_bsref_"slice,chunkId),1,chunk) QUIT:chunkId=""""")
	Do code("			If slice>=uslice {")
	Do code("				Set filter(chunkId)=$bitlogic(filter(chunkId)|(chunk&~"_bsref_"""-"",chunkId)))")
	Do code("			}")
	Do code("			If slice>=lslice {")
	Do code("				Set pass(chunkId)=$bitlogic(pass(chunkId)|(chunk&~"_bsref_"""-"",chunkId)))")
	Do code("			}")
	Do code("			If -slice<=lslice {")
	Do code("				Set filter(chunkId)=$bitlogic(filter(chunkId)|(chunk&"_bsref_"""-"",chunkId)))")
	Do code("			}")
	Do code("			If -slice<=uslice {")
	Do code("				Set pass(chunkId)=$bitlogic(pass(chunkId)|(chunk&"_bsref_"""-"",chunkId)))")
	Do code("			}")
	Do code("		}")
	Do code("	}")
	Do code("	Set chunkId=""""")
	Do code("	For {")
	Do code("		Set chunkId=$o("_tfinref_"chunkId),1,chunk) QUIT:chunkId=""""")
	Do code("		Set "_tfoutref_"chunkId)=$bitlogic(chunk&pass(chunkId)&~filter(chunkId))")
	Do code("	}")
	Do code("}")
	RETURN $$subroutn^%qacsub("code",$$untag^%qaqcpre("bsRange"),,1)
}
bitsliceTopFilter(tfoutref, tfinref, bsid, dir, finalSort) [ code ] public {
	Set bsref = $$$smdMapGlobal(bsid) _ "("
	Set sub = ""
	For  {
		Set sub = $o($$$smd(12,bsid,6,sub)) QUIT:sub=""
		Set con = $$$smdMSConstant(bsid,sub)
		QUIT:con=""
		Set bsref = bsref _ con _ ","
	}
	New code
	Set negref = bsref_"""-"","
	Do code("(limit) [] public {")
	Do code("	Set chunkId="""",count=0")
	Do code("	For {")
	Do code("		Set chunkId=$o("_tfinref_"chunkId),1,chunk) QUIT:chunkId=""""")
	Do code("		Set count=count+$bitcount(chunk,1)")
	Do code("	}")
	// We're cheating here: If tfin '= tfout we won't have written output, but
	// existing ASL generation always sets tfin = tfout
	Do code("	If count<=limit QUIT")
	Do code("   If count<10000 QUIT")
	Do code("	Set candidates=1")
	Do code("	Set filtered=2")
	Do code("	Merge a(candidates)="_$s($e(tfinref,*)=",":$e(tfinref,1,*-1)_")",$e(tfinref,*)'="(":tfinref_")",1:$e(tfinref,1,*-1)))
	Do code("	Set remaining=limit")
	Do code("	Set winners=""""")
	Do code("	Set slice=""""")
	Do code("	Set ord="_$select(dir="a":"""N-Z+""",1:"""+Z-N"""))
	Do code("	Set ordpos=1")
	Do code("	While remaining {")
	Do code("		If ordpos>$l(ord) QUIT")
	Do code("		Set cat=$e(ord,ordpos)")
	Do code("		Set ssub=$s(""-+""[cat:$o("_bsref_"slice),-1),1:cat)")
	Do code("		If ""-+""[cat {")
	Do code("			Set slice=ssub")
	Do code("			If ssub="""" Set ordpos=ordpos+1 CONTINUE")
	Do code("			If ""NZ-""[ssub CONTINUE")
	Do code("		}")
	Do code("		Else {")
	Do code("			Set ordpos=ordpos+1")
	Do code("		}")
	Do code("		Set chunkId=""""")
	Do code("		For {")
	Do code("			Set chunkId=$o("_bsref_"ssub,chunkId),1,chunk) QUIT:chunkId=""""")
	Do code("			If cat=""+"" {")
	Do code("				Set a(filtered,chunkId)=$bitlogic(a(candidates,chunkId)&"_$s(dir="a":"~",1:"")_"chunk&~"_negref_"chunkId))")
	Do code("			}")
	Do code("			ElseIf cat=""-"" {")
	Do code("				Set a(filtered,chunkId)=$bitlogic(a(candidates,chunkId)&"_$s(dir="d":"~",1:"")_"chunk&"_negref_"chunkId))")
	Do code("			}")
	Do code("			Else {")
	Do code("				Set a(filtered,chunkId)=$bitlogic(a(candidates,chunkId)&chunk)")
	// If this is the last sort field, we can treat all N and Z values as indistinguishable and choose
	// an arbitrary subset.
	If finalSort {
		Do code("				If ""NZ""[cat {")
		Do code("					Set i=0")
		Do code("					While remaining {")
		Do code("						Set i=$bitfind(a(filtered,chunkId),1,i+1) QUIT:i=0")
		Do code("						Set $bit(winners(chunkId),i)=1")
		Do code("						Set $bit(a(candidates,chunkId),i)=0")
		Do code("						Set $bit(a(filtered,chunkId),i)=0")
		Do code("						Set remaining=remaining-1")
		Do code("					}")
		Do code("				}")
	}
	Do code("			}")
	Do code("		}")
	Do code("		Set chunkId="""",count=0")
	Do code("		For {")
	Do code("			Set chunkId=$o(a(filtered,chunkId),1,chunk) QUIT:chunkId=""""")
	Do code("			Set count=count+$bitcount(chunk,1)")
	Do code("		}")
	Do code("		If count=0 CONTINUE")
	Do code("		If count<=remaining {")
	Do code("			Set chunkId=""""")
	Do code("			For {")
	Do code("				Set chunkId=$o(a(filtered,chunkId),1,chunk) QUIT:chunkId=""""")
	Do code("				Set a(candidates,chunkId)=$bitlogic(a(candidates,chunkId)&~chunk)")
	Do code("				Set winners(chunkId)=$bitlogic(winners(chunkId)|chunk)")
	Do code("			}")
	Do code("			Set remaining=remaining-count")
	Do code("		}")
	Do code("		Else {")
	Do code("			Set temp=filtered")
	Do code("			Set filtered=candidates")
	Do code("			Set candidates=temp")
	Do code("		}")
	Do code("	}")
	Do code("	Kill "_tfoutref)
	Do code("	If remaining {")
	Do code("		Set chunkId=""""")
	Do code("		For {")
	Do code("			Set chunkId=$o(a(candidates,chunkId),1,chunk) QUIT:chunkId=""""")
	Do code("			Set winners(chunkId)=$bitlogic(winners(chunkId)|chunk)")
	Do code("		}")
	Do code("	}")
	Do code("	Merge "_tfoutref_"=winners")
	Do code("}")
	RETURN $$subroutn^%qacsub("code",$$untag^%qaqcpre("bsTop"),,1)
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK841-
copy(stuff) n a,b,i,x  ;  insert code to copy from 1 field to another
	#;  EP from above and from sw+2
	s line=""
	#;  7,8,13 use $List, and therefore cannot be combined with "~"  ;  AK659
	GOTO cop7:+stuff=7,cop8:+stuff=8,cop13:+stuff=13
	i stuff["~" f i=1:1:$l(stuff,"~") { d copy($p(stuff,"~",i)) } QUIT
	#; AK659-
	i +stuff=1 s a=pti($p(stuff,"^",3)),x=pti($p(stuff,"^",2)) q:a=x  $$$liin("s "_a_"="_x) q
	#; Copy flag=6, same as 1, but must deal with NULL Subscript Marker
	#; AK885
	#;  but only after conversions/collations appended to 'line'
	if +stuff=6 {
		set a=$p(stuff,"^",3)
		#;  don't apply vset() if no actual copy happens  ;  AK1081
		d:a'=$p(stuff,"^",2) vset^%qaqcdt(a,pti($p(stuff,"^",2)),.line)
		if $d($$$mtNullMarkerSub(mod,a),x) {
			new subvar
			set subvar=$$$getVarName("sub"_a)
			if $$nullreplace^%qaqcct($p(stuff,"^",2)) {
				set line=line_" s "_subvar_"=$s("_pti(a)_"="""":"_x_",1:"_pti(a)_")"
			} else {
					#; We don't need null replacement since the source can't be null, but we need to 
					#; copy the value to the target so it is defined
				set line=line_" s "_subvar_"="_pti(a)
			}
		}
		if line'="" $$$liin(.line)
		RETURN
	}
	#;  could just add:  . d vset^%qaqcdt($p(stuff,"^",3),,.line)  ;  append conversions to line
	#; AK885-
	i +stuff=3 d cop3 GOTO setin
	i +stuff=10 {
		d cop3
		i line="" RETURN
		s a=$p(stuff,"^",3)
		f i=1:1:$l(a,",") {
			s b=$p(a,",",i)
			if $d(%nsvalex(mod,b)) set line=line_" s:"_pti(b)_"="""" "_pti(b)_"="_%nsvalex(mod,b)
		}
		GOTO setin
	}
	GOTO cop4:+stuff=4,cop5:+stuff=5,cop9:+stuff=9  ;  AK353
	GOTO cop11:+stuff=11
	GOTO cop14:+stuff=14
	#;  +stuff=2:  break record ID into based fields.
	#;  (physical), or +stuff=12 - into based fields (logical)  ;  AK659
	#;  Note - if its a parent ID we gotta do multiple pieces DUDE.
	#; DPV1628
	n icol,ifn,irn,offset
	#; DPV1900
	s a=$p(stuff,"^",2)		// ID col val#
	s ifn=$p($$$mtV(a),"^",3)	// ID ifn
	s irn=$$$smdGetIrnFromIfn(ifn)	// irn of ID we are breaking into based on fields
	s a=$p(stuff,"^",3)		// list of cols
	f i=1:1:$l(a,",") {
		s icol=$p(a,",",i)
		i icol'="" {
	#; AK659
			i +stuff=12 {s offset=$p($$$smdLogicalNumright(1,irn),"^",i)} else {s offset=$p($$$smdPhysicalNumright(1,irn),"^",i)}
.
			n extra    // JMM1324=
			s extra="" // JMM1226+
			i $$$smdPartitioned(1,irn) { 
				if i = ($l(a,",")-1) { 
					// JMM1226 Compute %%BUCKETID from %%PROWID, rather than extracting it from rowid
					s extra="\"_($$$PartitionChunkSize * $$$PartitionNChunks)_"+1"
				}
				elseif i=$l(a,",") {
					s offset=offset-1
				} 
			} // JMM1226-
			//ensure the rightmost $p extraction consumes the remainder of the source value
			i i=$l(a,","),offset["," { s $p(offset,",",*)="*" }
			i i=$l(a,","),offset'["," { s offset=offset_",*" }
	
			d adset(pti(icol),"$p("_pti($p(stuff,"^",2))_",""||"""_$s(offset="1":"",1:","_offset)_")"_extra) // JMM1226=
		}
	}
	#; DPV1900-
	#; DPV1628-
setin	i line'="" s line="s "_$e(line,2,*) $$$liin(.line)  ;  add SETs line
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adset(into,from)  ;  add a SET argument to the line
	#; AK664
	QUIT:into=from
	d:$l(line)+$l(into)+$l(from)-20>$$$complength setin s line=line_","_into_"="_from
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cop3	;  Split Name field into 2 subscripts
	new fromval,intoval,nullvalue
	set a=$p(stuff,"^",3) ; list of subscripts
	for i=1,2 {
		set intoval=$p(a,",",i)
		set fromval=$p(stuff,"^",2)
		do adset(pti(intoval),"$p("_pti(fromval)_","","","_i_")")
		if $d($$$mtNullMarkerSub(mod,intoval),nullvalue),$$nullreplace^%qaqcct(intoval) {
			new subvar
			set subvar=$$$getVarName("sub"_intoval)
			do adset(subvar,"$s("_pti(intoval)_"="""":"_nullvalue_",1:"_pti(intoval)_")")
		}
	}
	RETURN  ;--- cop3
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cop4	;  reconstruct record ID from based fields
	s a=$p(stuff,"^",2) ; list of based on fields
	f i=1:1:$l(a,",") s j=$p(a,",",i) s:j'="" line=line_"_""||""_"_pti(j)
	s line="s "_pti($p(stuff,"^",3))_"="_$e(line,7,*) $$$liin(.line)  ;ID column
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cop5	;  reconstruct Name field from 2 subscripts
	set a=$p(stuff,"^",2) ; list of subscripts
	new comma,n1,n2
	set n1=pti($p(a,","))
	set n2=pti($p(a,",",2))
		#; We need to insert the comma if the first name (second subscript) is not null
		#; Name = "" or Name = "Madonna", gets no comma
		#; name = "Smith,John" or Name = ",Kelly" gets a comma
	if $d($$$mtNullMarkerSub(mod,$p(a,",",2))) { set comma="$e("","","_n2_"'="""")" }
	else { set comma=""",""" }
	do adset(pti($p(stuff,"^",3)),n1_"_"_comma_"_"_n2)
	GOTO setin
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cop7	new return,tmpcode,name,jj,lblist  ;  7 ^ val ^ $lb(val) - unpack a $list
	set lblist=$p(stuff,"^",3,*)
	for jj=1:1:$ll(lblist) set name(jj)=pti($li(lblist,jj))
	set return=$$GenExtract^%GenerateExtract(.tmpcode,"",$lb(pti($p(stuff,"^",2)),$$$getVarName("sqltmp"),$$$getVarName("sqlpos")),.name,"",,$g(%msqlvar)="i%%")
	if return<0 Ztrap "ExtErr"
	for i=1:1:tmpcode set line=tmpcode(i) $$$liin(.line)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cop8	n lblist,jj  ;  8 ^ $lb(val) ^ val - pack a cannonic $zlist - use only string format!
	s lblist=$p(stuff,"^",2,*-1)  ;  use $P(*) because $LIST() may contain "^", e.g. $LB(94)
	#; DPV1297
	n prefix,var s prefix="",var=pti($p(stuff,"^",*))
	f jj=1:1:$ll(lblist) s line=line_","_pti($li(lblist,jj)) i $l(line)>($$$MaxRtnLineLength-100) d
	. s line=line_")",$e(line)="s "_var_"="_prefix_"$zlist("
	. $$$liin(.line)
	. s prefix=var_"_"
	i line'="" s line=line_")",$e(line)="s "_var_"="_prefix_"$zlist("
	#; DPV1297-
	$$$liin(.line)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cop9
	if $p(stuff,"^",3) = "convert"{ ;  9 ^ q# ^ "convert"
	#; apply ODBCOut() to the variables in $$$mtUnionVals(m)
		new unoutval,unoutvals,outvals,outval,jj,m
		set m = $p(stuff,"^",2), unoutvals = $$$mtUnionVals(m), outvals=$$$mtOutputVals($$$mtOutput(m))	
		for jj=1:1:$ll(unoutvals){
			set unoutval = $lg(unoutvals,jj) // variable number of jj-th union output
			set outval = $p(outvals,",",jj) // variable number of jj-th query block output 
.
			#; $$appmeth^%qaqcpr generates the code that converts the union output 
			#; variable $$$mtV(unoutval) to the right format based on the datatype of 
			#; $$$mtV(outval). Combined with $$convnull and adset, this line of code 
			#; below generated the complete format conversion code for unoutval
			d adset(pti(unoutval),$$convnull^%qaqcpr(pti(unoutval), $$appmeth^%qaqcpr(pti(unoutval),$s(mt("sqlcomp")="%ODBC":"LogicalToOdbc",mt("sqlcomp")="%Runtime":"LogicalToRuntime",1:"LogicalToDisplay"),outval)))
		}
	} else {
		n m,selst,untop,unout,jj,val,unsort,unslog  ;  9 ^ q#
		#;  copy subquery results from mt("o") into mt("unout")
		s m=$p(stuff,"^",2),selst=$$$mtOutputVals($$$mtOutput(m)),untop=$$$mtUnionTopQb(m),unout=$$$mtUnionVals(untop)
		#; AK402
		#;  apply ODBCOut() before copying, if necessary
		#;  *** hopefully remove soon, should be done already
		#; AK668
		i untop=1 f jj=1:1:$ll(unout) s val=mt("sqlcomp",$p(selst,",",jj)) d:$e($$$mtV(val),1,10)="i^APPCONV:" adset(pti(val),$$conv^%qaqcpr($$$mtV(val)))
		#; AK402-
		#; AK778
		f jj=1:1:$ll(unout) s val=$p(selst,",",jj) i '$$isViewNulled(val) s:untop=1 val=mt("sqlcomp",val) d adset(pti($li(unout,jj)),pti(val))
		#;  also copy logical sort values to $$$mtUnionSortLogical, if necessary
		i untop=1,$d($$$mtUnionSortLogical) s unsort=$$$mtUnionOrderBy,unslog=$$$mtUnionSortLogical f jj=1:1:$l(unsort,",")-1 d adset(pti($li(unslog,jj)),pti($p(selst,",",+$p(unsort,",",jj))))
	}
	GOTO setin
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK353-
	#; AK419
cop11	n jj  ;  11 ^ sub1,...,subn, ^ val2  =>  SET val2(sub1,...,subn)=""
	s line="s "_pti($p(stuff,"^",3)),$e(line,*)="",stuff=$p(stuff,"^",2)
	f jj=1:1:$l(stuff,",")-1 s line=line_","_pti($p(stuff,",",jj))
	s line=line_")=""""" $$$liin(.line)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cop13	new jj,lblist  ;  13 ^ val ^ $lb(val) - unpack a $zlist  ;  AK1046
	set lblist=$p(stuff,"^",3,*)
	set line = "s $zlist("
	for jj=1:1:$ll(lblist) set line=line_pti($li(lblist,jj))_$s(jj=$ll(lblist):")",1:",")
	set line = line_"="_pti($p(stuff,"^",2))
	for jj=1:1:$ll(lblist) do vset^%qaqcdt($li(lblist,jj),,.line)
	$$$liin(.line)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cop14	;  14 ^ val ^ x - for $VOP("xxxg") output  ;  AK1046; AK1047
	#;  array val, add the NULL group result (if any), which would be
	#;  at the top node, to a NULL/null-marker subscript (based on x)
	n nul s nul=$$colnul^%qaqcpr($p(stuff,"^",3))  ;  '" "' or '""'
	set:nul="""""" nul=$$$NULLSubscriptMarker19q
	$$$liin("i $d("_pti($p(stuff,"^",2))_","_$$adsub^%qaqcmn(pti($p(stuff,"^",2)))_nul_")) { }")
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK419-
	#; JLF005
setSubqn(val, subqn, ref)
	n refNull,subqM,pqbExprs,jj,refnxt,refclose
	s subqM = $p($$$mtV(val),"^",2)
	set refnxt=$s(ref["(":",",1:"("),refclose=$replace(refnxt,",",")")
	if $d(mt("svso",subqM)) && ($lg($g(mt("svso",subqM)),2)[",") || (",=," [ (","_$p($lg($g(mt("svso",subqM)),2),",",1)_","))
	{
		#; We have just returned from the subquery.  Using the correlating values from the
		#; parent query block, obtain the value of the subquery, and return it to the caller.
		#;
		#; s ref=$p(asl($p($g($$$mtP(subqM)),"^",6),4,1),$c(1),6)
		#; s ref=$$$tFileQ_"("_$$$MakeMSQLModuleVarArray("t",ref)_",0"
		
		#; Add the correlated column subscript, if any,
		#; 		$p($$$mtV(val),"^",3)'=","
		#; if $d($$$mtP(subqM)) && ($$$mtPCorrelatedFields($$$mtP(subqM))'="") && ($$$mtPCorrelatedFields($$$mtP(subqM))'=",")
		#; {	
			#; Remove duplicates from the list of correlated fields
			#; n i,tmp,corr s corr=$$$mtP(subqM) f i=1:1 { s j=$p(corr,",",i) q:j=""  s tmp(j)="" }
			#; s j="",tmp="" f { s j=$o(tmp(j)) q:j=""  s tmp=tmp_j_"," }
			#; s $$$mtPCorrelatedFields($$$mtP(subqM))=tmp
			#; s ref = ref_","_$s($l($$$mtPCorrelatedFields($$$mtP(subqM)),",")-1>1:$$$getVarName("corr"_subqM),1:"$s("_pti($p($$$mtPCorrelatedFields($$$mtP(subqM)),",",1))_"'="""":"_pti($p($$$mtPCorrelatedFields($$$mtP(subqM)),",",1))_",1:"_$$$NULLSubscriptMarkerq_")")
			
			#; n icols s icols=$$distlist^%qaqcpr($E($p($$$mtV(val),"^",3),2,999))
			#; s ref = ref_","_$s($l(icols,",")>2:$$$getVarName("sub"_+icols),1:$$onesub^%qaqcpr(icols))
		#; }
	#; JLF245
		#; Add the decorrelated-equal column subscript, if any.  If the original FOR SOME had an
		#; expression that needed to be evaluated, this will be at the end of the pqb expressions
		#; in list element 3 of mt("svso",subqM), but the number of corresponding sqb expressions
		#; in list element 4 can be used to iterate over the pqb expressions in list element 3.
		#;
		f jj=2:1:$ll($lg(mt("svso",subqM),4)) s $li(pqbExprs,jj-1) = $p($li(mt("svso",subqM),3),"^",jj)
	#; JLF245-
		i $lg($g(mt("svso",subqM)),2)["," d copy("8^"_pqbExprs_"^"_$$$VarNum("decorr"_subqM)) s ref=ref_","_$$$getVarName("decorr"_subqM)
		#; Add the value column subscript, in the case where the operator is "=", and do either a $d or '$d
		#;
		s refNull = ""
	#; JLF105
		n pqbExprNullVal,sqbExprNullVal,sqbExprNullSub
		s pqbExprNullVal=$$colnul^%qaqcpr($p($li(mt("svso",subqM),3),"^",1))
		s sqbExprNullVal=$$colnul^%qaqcpr($li($li(mt("svso",subqM),4),1))
		set sqbExprNullSub=$s(sqbExprNullVal="""""":$$$NULLSubscriptMarker19q,1:sqbExprNullVal)
		set refNull=ref_refnxt_sqbExprNullSub_")"
	#; JLF105-
	#; JLF120
		n topref s topref=ref_refclose
		if ($p($lg($g(mt("svso",subqM)),2),",",1)="=") {
			s ref=ref_refnxt_pti($p($li(mt("svso",subqM),3),"^",1))_")"
		} else {
			s ref=ref_refclose
		}
		if $li(mt("svso",subqM),1)="anyeql"			// EXISTS =
		{
	#; JLF105
			$$$liin("s "_subqn_"=("_pti($p($li(mt("svso",subqM),3),"^",1))_"'="_pqbExprNullVal_")&&$d("_ref_")")
		}
		elseif $li(mt("svso",subqM),1)="anyneq"		// EXISTS <>
		{
			$$$liin("s "_subqn_"=$g("_ref_")")
		}		
		elseif $li(mt("svso",subqM),1)="alleql"		// NOTEXISTS <>
		{
			$$$liin("s "_subqn_"=$g("_ref_")")			
		}
		elseif $li(mt("svso",subqM),1)="allneq"		// NOTEXISTS =
		{
	#; JLF105
	#; JLF120
			$$$liin("s "_subqn_"=($d("_topref_")<9)||(("_pti($p($li(mt("svso",subqM),3),"^",1))_"'="_pqbExprNullVal_")&&'$d("_refNull_")&&'$d("_ref_"))")
		}
		else
		{
			$$$liin("s "_subqn_"=$g("_ref_")")
		}
	}	
	QUIT
	#; JLF005-
	#; JLF015
genAnyof(anyofLog,baseFld,genLogic,inline=0)
	n basePti,element,collType,code,cval,eleList,flds,fnum,irn,j,keyList,lg,ln,str,qno,v,v2
	
	s mt("anyofInProgress",baseFld)=1	
	s v = $$$mtL(anyofLog)
	
	#; Remove the duplicates from $$$mtL(anyofLog) piece 3 (and sort)
	f fnum=2:1:$l(v,",")-1 { s $p(flds,"^",$p(v,",",fnum))=$p(v,",",fnum)_"," }
	s flds = ","_$tr($g(flds),"^")
	s ln=1,code(ln) = "()"
	
	#; Create the list of key and value f-vals that we need to loop over
	s keyList="",eleList=""
	f j=2:1:$l(flds,",")-1
	{ s v2=$$$mtV($p(flds,",",j))
	  if baseFld=$e(v2,$find(v2,$s(v2["%ANYOFKEY":"%ANYOFKEY",1:"%ANYOF")),*)
	  { if v2["%ANYOFKEY" { s keyList = $g(keyList)_$lb($p(flds,",",j)) }
	    elseif v2["%ANYOF" { s eleList = $g(eleList)_$lb($p(flds,",",j)) }
	  }
	}
	s cval=$s(eleList'="":$li(eleList,1),1:$li(keyList,1))
	s str = $p($$$mtV(cval),"^",2)
	s qno = $$$mtRQb($$$mtR(str))
	s basePti = pti($p(mts(qno,str,"ATT",+$p($$$mtV(cval),"^",3)),"^",5))
	#; Get the property type of the deep field reference
	s v2=$$$mtV($$thruRMLSP^%qaqpqo1($$realf^%qaqpre2(cval)))  ;  AK1084
	s ifn = $p(v2,"^",3)
	s irn = $$$smdGetIrnFromIfn(+ifn)
	s collType = $$$smdColCollectionType(1,irn,+ifn)	// DPV3500
	#; AK710
	n key,ele,num,pos,itm s key="",ele="",v=$p($$$mtV($li(keyList_eleList)),"_")_"_%ANYOF",str=$p(v,"^",2),qno=$$$mtRQb($$$mtR(str))
	#; AK854
	n dlg s dlg=$s($$$smdColOIDType(1,irn,+ifn):"$lg",1:"")
	if collType="list" { ;  [ Collection = list ]
		s key=$$gaof(v_"KEY"),num=$$$getVarName("anyof"_baseFld_"num")
			#; If the field has a List Delimiter specified, the Logical value for the field is a delimited string (DPV3306)
			#; Otherwise it is a $List logical value
		n listDel s listDel=$$$smdColListDelimiter(1,irn,+ifn)					// DPV3306+
		set:listDel'=""&&($e(listDel)'="$") listDel=$$$SQLquoter(listDel)
		if listDel="" {	// List stored as $List
			$$$liin("s "_num_"=$ll("_basePti_"),"_key_"=0")
			$$$liin("f { QUIT:$i("_key_")>"_num)
	#; AK854
			i eleList'="" s ele=$$gaof(v) $$$liin("s "_ele_"="_dlg_"($lg("_basePti_","_key_"))")
		}
		else {	// List stored as delimited string	// DPV3306+
			$$$liin("s "_num_"=$l("_basePti_","_listDel_"),"_key_"=0")
			$$$liin("f { QUIT:$i("_key_")>"_num)
			i eleList'="" s ele=$$gaof(v) $$$liin("s "_ele_"="_dlg_"($p("_basePti_","_listDel_","_key_"))")  ;  AK854
		}						// DPV3306-
		d gaolup(key,ele)
		QUIT $$setvar^%qaqcpr(key_"<="_num)
	}
	if collType="array"  ;  [ Collection = array ]
	{	s num=$$$getVarName("anyof"_baseFld_"num"),pos=$$$getVarName("anyof"_baseFld_"pos"),itm=$$$getVarName("anyof"_baseFld_"itm")
		$$$liin("s "_num_"=$ll("_basePti_"),"_pos_"=0")
		$$$liin("f { QUIT:$i("_pos_")>"_num_"  s "_itm_"=$lg("_basePti_","_pos_")")
		i keyList'="" s key=$$gaof(v_"KEY") $$$liin("s "_key_"=$li("_itm_")")
		i eleList'="" s ele=$$gaof(v) $$$liin("s "_ele_"="_dlg_"($li("_itm_",2))")  ;  AK854
		d gaolup(key,ele)
		QUIT $$setvar^%qaqcpr(pos_"<="_num)
	}
	#;  call bva() - must be done in a subtag because of variable .bva
	n dt,tagid
	s key=$$gaof(v_"KEY"),ele=$$gaof(v)
	d docode(.tagid)  ;  AK811
	$$$liin("n bva s "_key_"=""""")
	s dt = $$$smdColDatatype(1,irn,+ifn)
	#; Special case for %Text - we don't want to inherit all of the methods into every class that
	#; implements the Text interface, so if the type class is in the %Text package, execute from there,
	#; else execute as a property method.
	#;  *** AK854 - next condition should probably be applied to non-streams as well!
	if $$$smdColStream(1,irn,+ifn) {	// DPV3085=	// DPV3202+
		#; if this is a stream field the value will be a fully formed Oid.
		#; What we need to pass to BVA is the actual ID stored on disk, this value depends on the OIDType of the field.
		#; If needed, here I'll extract the on-disk ID value for the stream from the full Oid (DPV3082)
		set:$$$smdColOIDType(1,irn,+ifn)=1 basePti="$lg("_basePti_")"
		set:$$$smdColOIDType(1,irn,+ifn)=2 basePti="$li("_basePti_",1,2)"
	}					// DPV3085-
	if '$d($$$smd(1,irn,2,+ifn,"adtp","LANGUAGECLASS"))
	{	$$$liin("do ##class("_$$$smdClassname(1,irn)_")."_$$$QN($$$smdColPropertyName(1,irn,+ifn)_"BuildValueArray")_"("_basePti_", .bva)") }
	else
	{	s dt = $$$smd(1,irn,2,+ifn,"adtp","LANGUAGECLASS")
		#; Support dynamic binding of the LANGUAGECLASS
		if $e(dt)="^"
		{	$$$liin("do $classmethod("_dt_",""BuildValueArray"","_basePti_",.bva)") }
		else
		{	$$$liin("do ##class("_dt_")."_"BuildValueArray"_"("_basePti_", .bva)") }
	}
	$$$liin("f { s "_key_"=$o(bva("_key_"),1,"_ele_") q:"_key_"=""""")
	d gaolup(key,ele)
	d dotag2(tagid)
	QUIT $$setvar^%qaqcpr(key_"'=""""")
	#; AK710-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF015-
	#; AK710
gaolup(k,e) n fnum,val,coll
	f fnum=1:1:$ll(keyList) s val=$li(keyList,fnum),coll=$p($p($$$mtV(val),"^",3),"_",2) if $e(coll,1,6)'="%ANYOF" $$$liin("s "_pti(val)_"="_$$gencoll(coll,k))
	f fnum=1:1:$ll(eleList) s val=$li(eleList,fnum),coll=$p($p($$$mtV(val),"^",3),"_",2) if $e(coll,1,6)'="%ANYOF" $$$liin("s "_pti(val)_"="_$$gencoll(coll,e))
	$$$liin("QUIT:"_$s(genLogic:$$logic^%qaqcpr,1:$$cond^%qaqcpr(anyofLog))_" }")
	k mt("anyofInProgress",baseFld)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
gaof(v)	;  $$:  var for given %ANYOF[KEY], make scratch if not already defined
	QUIT pti($$col^%qaqcdt($p(v,"^",3)_baseFld))
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dotag1(tagid)  ;  setup for subsequent code to go into a tag called by DO
	s tagid="m"_mod_"l"_lines
	$$$liin("g "_tagpre_tagid_"g")
	s tag=tagpre_tagid_"d"
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dotag2(tagid)  ;  setup for previos code to go into a tag called by DO
	$$$liin("q")
	s tag=tagid_"p"  ;  "passover" tag
	$$$liin("d "_tagid)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK710-
	#; AK811
docode(dotag,arg="")  ;  [public: tag] put subsequent code lines into tag
	#;  .dotag (returned by ref), with formal arguments arg, to be called by DO.
	#;  Regular code continues at the "passover" tag dotag_"p" (set up by caller)
	s dotag=$$untag()
	$$$liin("g "_dotag_"p")  ;  continue at the "passover" tag
	s tag=dotag_arg
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
untag(xtra="")  ;  [public: mod,lines] $$: unique tag based on the current mod/lines
	QUIT tagpre_"m"_mod_"l"_lines_"t"_xtra
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK811-
svso()
	if (($e(op,1,7)="EXISTS:")||($e(op,1,10)="NOTEXISTS:"))
	{	n qnode,pqbExpr,svsoAggValue s qnode=$p(string,"^",4),pqbExpr=$p(string,"^",5)
		i ($e(op,1,8)="EXISTS:<") d davalue^%qaqcpr(qnode) s svsoAggValue=pti(qnode) QUIT "(("_svsoAggValue_"'="_$$$SQLEMPTYq_")&&("_svsoAggValue_"]]" _$$ptvalue^%qaqcpr(pqbExpr)_"))"
		i ($e(op,1,9)="EXISTS:'<") d davalue^%qaqcpr(qnode) s svsoAggValue=pti(qnode) QUIT "$s("_svsoAggValue_"="_$$$SQLEMPTYq_":"_$$$SQLFALSE_",1:"_svsoAggValue_"']]"_$$ptvalue^%qaqcpr(pqbExpr)_")"
		i ($e(op,1,8)="EXISTS:>") d davalue^%qaqcpr(qnode) s svsoAggValue=pti(qnode) QUIT "$s("_svsoAggValue_"="_$$$SQLEMPTYq_":"_$$$SQLFALSE_",1:"_$$ptvalue^%qaqcpr(pqbExpr)_"]]"_svsoAggValue_")"	
		i ($e(op,1,9)="EXISTS:'>") d davalue^%qaqcpr(qnode) s svsoAggValue=pti(qnode) QUIT "$s("_svsoAggValue_"="_$$$SQLEMPTYq_":"_$$$SQLFALSE_",1:"_$$ptvalue^%qaqcpr(pqbExpr)_"']]"_svsoAggValue_")"
		i ($e(op,1,11)="NOTEXISTS:<")  d davalue^%qaqcpr(qnode) s svsoAggValue=pti(qnode) QUIT "$s("_svsoAggValue_"="_$$$SQLEMPTYq_":"_$$$SQLTRUE_","_svsoAggValue_"="_$$$SQLCONTAINSNULL_":"_$$$SQLFALSE_",1:$li("_svsoAggValue_")']]"_$$ptvalue^%qaqcpr(pqbExpr)_")"
		i ($e(op,1,12)="NOTEXISTS:'<") d davalue^%qaqcpr(qnode) s svsoAggValue=pti(qnode) QUIT "$s("_svsoAggValue_"="_$$$SQLEMPTYq_":"_$$$SQLTRUE_","_svsoAggValue_"="_$$$SQLCONTAINSNULL_":"_$$$SQLFALSE_",1:$li("_svsoAggValue_")]]"_$$ptvalue^%qaqcpr(pqbExpr)_")"
		i ($e(op,1,11)="NOTEXISTS:>")  d davalue^%qaqcpr(qnode) s svsoAggValue=pti(qnode) QUIT "$s("_svsoAggValue_"="_$$$SQLEMPTYq_":"_$$$SQLTRUE_","_svsoAggValue_"="_$$$SQLCONTAINSNULL_":"_$$$SQLFALSE_",1:"_$$ptvalue^%qaqcpr(pqbExpr)_"']]$li("_svsoAggValue_"))"
		i ($e(op,1,12)="NOTEXISTS:'>") d davalue^%qaqcpr(qnode) s svsoAggValue=pti(qnode) QUIT "$s("_svsoAggValue_"="_$$$SQLEMPTYq_":"_$$$SQLTRUE_","_svsoAggValue_"="_$$$SQLCONTAINSNULL_":"_$$$SQLFALSE_",1:"_$$ptvalue^%qaqcpr(pqbExpr)_"]]$li("_svsoAggValue_"))"
		i ($e(op,1,12)="NOTEXISTS:'=") d davalue^%qaqcpr(qnode) s svsoAggValue=pti(qnode) QUIT "$s("_svsoAggValue_"="_$$$SQLEMPTYq_":"_$$$SQLTRUE_","_svsoAggValue_"="_$$$SQLCONTAINSNULL_":"_$$$SQLFALSE_","_svsoAggValue_"="_$$$SQLMULTIDISTINCTVALUED_":"_$$$SQLFALSE_",1:$li("_svsoAggValue_")="_$$ptvalue^%qaqcpr(pqbExpr)_")"
		i ($e(op,1,9)="EXISTS:'=")     d davalue^%qaqcpr(qnode) s svsoAggValue=pti(qnode) QUIT "$s("_svsoAggValue_"="_$$$SQLMULTIDISTINCTVALUED_":"_$$$SQLTRUE_","_svsoAggValue_"="""":"_$$$SQLFALSE_",1:$li("_svsoAggValue_")'="_$$ptvalue^%qaqcpr(pqbExpr)_"&&($li("_svsoAggValue_")'="""")&&($ll("_svsoAggValue_")=1))"
		i ($e(op,1,11)="NOTEXISTS:=") d davalue^%qaqcpr(qnode) s svsoAggValue=pti(qnode) QUIT $$ptvalue^%qaqcpr(qnode)
		i ($e(op,1,8)="EXISTS:=")     d davalue^%qaqcpr(qnode) s svsoAggValue=pti(qnode) QUIT $$ptvalue^%qaqcpr(qnode)	
	}
	QUIT ""
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
bmch(bmch) {
	#dim bmch As %SQL.Engine.Objects.AslPkBitChunk
	Set chunk = bmch.Chunk().Image()
	Set chunkNum = bmch.ChunkNum().Image()
	//Whether it's from a tempfile or a map, we set
	//chunkRef to everything prior to ", <chunkSub>)"
	Set tempFile = bmch.TempFile()
	If tempFile {
		Set chunkRef = $$tfref(tempFile.Index,1)
	}
	Else {
		Set chunkRef = bmch.MapRef()_","
	}
	Set chunkRef = chunkRef _ chunkNum _ ")"
	$$$liin("s " _ chunk _ " = $G(" _ chunkRef _ ")")
}
filter(filter) {
	#dim filter As %SQL.Engine.Objects.AslPkFilter
	Set out = filter.Out().Image()
	Set a = filter.A().Image()
	Set b = filter.B().Image()
	Set filterOp = $s(filter.Invert():"~",1:"")
	$$$liin("s " _ out _ " = $bitlogic(" _ a _ "&" _ filterOp _ b _ ")")
}
#; When in isolation mode READ VERIFIED,
#; re-applies unary functions to vals read from the master map
#; and rechecks conditions. m0colls values are those
#; that were already produced by the read of the master map
#; and are not computed again.
#; Neither are %RUNTIMEOUT conversions re-applied, as they're
#; not used in calculations, regardless of the source of the values.
verify(conds, m0vals, m0colls, subshadows) [ mt, pti, vset ] public {
	#; Reset vset to only the values we know were calculated
	#; from master map values.
	New vset Set vset = ""
	For i=1:1:$ll(m0colls) {
		Set $bit(vset,$li(m0colls,i)) = 1
	}
	#; Exclude %RUNTIMEOUT conversions
	For i=1:1:$ll(m0vals) {
		Set val = $li(m0vals,i)
		If '$d(mt("unary",val,"%RUNTIMEOUT"),outval) CONTINUE
		Set $bit(vset,outval) = 1
	}
	#; Switch in shadow variables using bsl mechanism
	#; We need to set collation calculations into (and
	#; generate conditions on) these shadow variables
	#; to avoid overwriting subscript variables used for 
	#; looping.
	For i=1:2:$ll(subshadows) {
		Set sub = $li(subshadows,i)
		Set shadow = $li(subshadows,i+1)
		Do switch^%qaqcbsl(.switch,sub,pti(shadow))
	}
	Set vline = ""
	For i=1:1:$ll(m0vals) {
		Do vset^%qaqcdt($li(m0vals,i),,.vline)
	}
	if (vline="")&&(conds="") GOTO verifyDone //nothing to generate
	$$$liin("i " _ $$$getVarName("isolationMode") _ "=3 {")
	If vline'="" $$$liin(vline)
	For i=1:1:$ll(conds) {
		Set cond = $li(conds, i)
		Do setcond(cond)
	}
	$$$liin("}")
verifyDone
	Do restore^%qaqcbsl(.switch)
}
.
/// Encode COLLATE collation
/// for example: "COLLATE(""prepend-space,mode=u"",5)" should be encoded to "C100U(5)"
encodeCollate(str) public {
	set encodedCollate = $S($E(str,1)="%":"%C",1:"C")
	return:str'["(" encodedCollate_"000N"
 	do getCollateParms(str,.parm1,.parm2)
 	set:(parm2'="") parm2 = $ZSTRIP(parm2,"*P")
	set encodedCollate = encodedCollate_(parm1["prepend-space")_(parm1["strip-trailing-whitespace")_(parm1["strip-accents")	
	if (parm1["mode=u") {
		set encodedCollate = encodedCollate_"U"
	}
	elseif (parm1["mode=l") {
		set encodedCollate = encodedCollate_"L"
	}
	elseif (parm1["mode=+") {
		set encodedCollate = encodedCollate_"+"
	}
	elseif (parm1["mode=-") {
		set encodedCollate = encodedCollate_"-"
	}
	else{
		set encodedCollate = encodedCollate_"N" 	
	}
	if parm1["translate=" {
		set tblName = $P(parm1,"translate=",2)
		if tblName["," {
			set tblName = $P(tblName,",",1)	
		}
		set encodedCollate = encodedCollate_tblName 	
	}
	if parm2'="" {
		set encodedCollate = encodedCollate_"("_parm2_")"	
	}
	set temp = encodedCollate
	set encodedCollate = $P(encodedCollate,"(",1)
	if $E(encodedCollate)="%"{
		set $system.Context.SQLCompile().ReservedWords(encodedCollate) = $c(1)_"Y"_$c(1)_"65778"
		set:$D(%context) %context.ReservedWords(encodedCollate) = $c(1)_"Y"_$c(1)_"65778"
		set $system.Context.SQLCompile().ReservedWords($E(encodedCollate,2,*)) = $c(1)_"Y"_$c(1)_"65778"
		set:$D(%context) %context.ReservedWords($E(encodedCollate,2,*)) = $c(1)_"Y"_$c(1)_"65778"
	}
	else{
		set $system.Context.SQLCompile().ReservedWords(encodedCollate) = $c(1)_"Y"_$c(1)_"65778"
		set:$D(%context) %context.ReservedWords(encodedCollate) = $c(1)_"Y"_$c(1)_"65778"
		set $system.Context.SQLCompile().ReservedWords("%"_encodedCollate) = $c(1)_"Y"_$c(1)_"65778"
		set:$D(%context) %context.ReservedWords("%"_encodedCollate) = $c(1)_"Y"_$c(1)_"65778"
	}
	set encodedCollate = temp
	return encodedCollate	
}
.
/// Return transformation-spec (parm1) and truncate-length (parm2) from 
/// a given parameter string (str): """prepend-space,mode = L"",5" or "'prepend-space,mode = L'"
getCollateParms(str="",parm1="",parm2="",class="",prop="") public {
	set str = $REPLACE(str,"'","""")
	set str = $zcvt($zstrip(str,"*W"),"L")
	if $L(str,"""")>3 {
		set %msg=$$$Text("transformation-spec should be a single string.","%qaqcpre")
		throw ##class(%Exception.StatusException).CreateFromStatus($$$ERROR($$$InvalidCOLLATECollation,$S(class="":"",1:class_":"_prop_" ")_$S(str'["COLLATE":"%COLLATE("_str_")",1:str),%msg))
	} elseif $L(str,"mode=")>2 {
		set %msg=$$$Text("Only one mode is acceptable.","%qaqcpre")
		throw ##class(%Exception.StatusException).CreateFromStatus($$$ERROR($$$InvalidCOLLATECollation,$S(class="":"",1:class_":"_prop_" ")_$S(str'["COLLATE":"%COLLATE("_str_")",1:str),%msg))
	} 
	set parm1 = $P(str,"""",2)
 	set parm2 = $P(str,"""",*)
 	if $L(parm2,",")>2 {
		set %msg=$$$Text("Only one truncate-length is acceptable.","%qaqcpre")
		throw ##class(%Exception.StatusException).CreateFromStatus($$$ERROR($$$InvalidCOLLATECollation,$S(class="":"",1:class_":"_prop_" ")_$S(str'["COLLATE":"%COLLATE("_str_")",1:str),%msg))	
	}
 	set:(parm2'="") parm2 = $ZSTRIP(parm2,"*P")
 	if ((parm2'="")&&((parm1["mode=+")||(parm1["mode=-"))) {
		set %msg=$$$Text("Truncare-length is not allowed for mode=+ or mode=-.","%qaqcpre")
		throw ##class(%Exception.StatusException).CreateFromStatus($$$ERROR($$$InvalidCOLLATECollation,$S(class="":"",1:class_":"_prop_" ")_$S(str'["COLLATE":"%COLLATE("_str_")",1:str),%msg))	
	}
 	if ((parm2'="")&&((+parm2)'=parm2)) {
		set %msg=$$$Text("Truncate-length should be an integer.","%qaqcpre")
		throw ##class(%Exception.StatusException).CreateFromStatus($$$ERROR($$$InvalidCOLLATECollation,$S(class="":"",1:class_":"_prop_" ")_$S(str'["COLLATE":"%COLLATE("_str_")",1:str),%msg))	
	}
 	quit 1
}
.
/// Decode COLLATE collation
/// for example: if str = "C110U(5)", 
/// transformation-spec (parm1) should be "prepend-space,strip-trailing-whitespace,mode=u" 
/// truncate-length (parm2) should be 5
decodeCollate(str,parm1,parm2) public {
	if $E(str,1) = "%" {set str = $E(str,2,*)}
	set parm1 = "", parm2 = ""
	quit:(str="C")||(str="C000N") 1
	set parm1 = $S($E(str,2):"prepend-space,",1:"")_$S($E(str,3):"strip-trailing-whitespace,",1:"")_$S($E(str,4):"strip-accents,",1:"")
	set parm1 = parm1_"mode="_$zcvt($E(str,5),"L")_","
	if ($E(str,6)'="")&&($E(str,6)'="(") {
		set parm1 = parm1_"translate="_$E(str,6,*)
	}
	if $e(parm1,*) = "," {
		set parm1 = $e(parm1,1,*-1)	
	}
	if str["(" {
		set parm2 = +$P(str,"(",2)	
	}
	quit 1
}
