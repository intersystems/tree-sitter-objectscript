====
qaqcpre
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqcpre^MAC^^^0
%qaqcpre	// Process the Prekey/Postkey
	;; COMPONENTS :: SQL/CodeGeneration
	#;
#include %msql
#include %sqlEngineObjs
#INCLUDE %SYS.PTools.Stats
#include %BigData.ShardingManager
#IF 0   ;-------------------------------------------------------------
	; Description:   Process Prekey/Postkey
	; Author:        Jim Finnerty
	; Date Started:  2003
	;
	;  JMM1134 (12/22/2021) - Consistently use shard map screening, or not, in all shard-local queries of a given sharded query
	;  AK1047  (10/06/2021) - Columnar WHERE filter for "onerow"/GROUP BY
	;  AK1046  (07/30/2021) - Columnar aggregates with GROUP BY
	;  AK1045  (06/30/2021) - Columnar "onerow" aggregates on expressions
	;  AK1041  (05/14/2021) - Columnar "onerow" with no WHERE
	;  AK850   (11/30/2020) - Implement lateral join
	;  JMM1092                Fix issues with adding shards while sharded queries are running
	;  AK1021  (08/05/2020) - Compute streamless expressions on the master
	;  AK1017  (06/18/2020) - Batch multiple ML calls
	;  AK1010  (10/23/2019) - Batch SQL rows for QuickML predictions
	;  JMM992  (10/22/2019) - Permit same job to execute multiple concurrent sharded queries
	;  AK996   (03/01/2019) - Add Cosharding comment to distributed query
	;  AK986   (10/03/2018) - Use indirection for hybrid temp-file read
	;  JMM837  (03/11/2018) - Unified routine and globals databases for sharded cluster
	;  AK932   (05/28/2015) - GENQ: Produce "?" for outer correlated fields
	;  MRP1007 (07/10/2017) - Provide method for Setting PTools SQLStats-flag by Namespace: $SYSTEM.SQL.SetSQLStatsFlagByNS()
	;  MRP1000 (07/02/2017) - Use new $ZU() bins created by JO3000 for all SQLStats flags
	;  JMM789  (05/24/2017) - Sharded query governor/cancel mechanism
	;  AK961   (04/24/2017) - Avoid MAXINCREMENT in hybrid temp-file merge
	;  JMM738  (07/14/2016) - Enable %BrokerShardOp to handle arbitrary queries
	;  AK939   (09/10/2015) - Sharded outer joins
	;  AK945   (01/04/2016) - Allow cosharding on collated fields
	;  AK938   (07/29/2015) - Sharded joins
	;  AK936   (07/07/2015) - Use hybrid local->global GROUP+aggs temp-file
	;  AK924   (03/16/2015) - Query processing for SQL sharding
	;  AK926   (03/24/2015) - Fix prior-looping check for module caller
	;  AK887   (01/27/2015) - (TRW) bmch/filter support for aggmaps plans
	;  AK920   (11/03/2014) - DO a called module only once, if possible
	;  AK902   (02/21/2014) - Parallel GROUP BY partitioned by FROM
	;  AK841   (12/21/2011) - Use extended local arrays for some temp-files
	;  AK900   (12/26/2013) - Parallel aggregates by range
	;  AK884   (08/05/2013) - Fix TOP for %VID
	;  AK885   (08/20/2013) - Apply conversions before copy(6) NULL-marker
	;  AK854   (04/18/2012) - Support OIDType in serialized collection code
	;  AK849   (01/18/2012) - Parallel processing for UNION
	;  AK828   (09/08/2011) - Use small integer subscripts for %xxxd()
	;  AK811   (05/19/2011) - Use unsubscripted locals as FOR loop variable
	;  AK778   (07/08/2010) - Don't copy unused view columns in UNION
	;  JLF245  (03/22/2009) - Make calls to testSvso consistent with each other, and block correlated expressions
	;  DPV3306 (10/30/2008) - Correct FOR SOME ELEMENT with delimited string list collection
	;  AK710   (09/26/2008) - Move ANYOF element looping inline
	;  DPV3202 (06/24/2008) - Correct some queries that use %CONTAINSTERM, +ifn
	;  JLF214  (04/08/2008) - Support text operators on streamed views
	;  AK668   (12/28/2006) - Group By and ValueList/DisplayList
	;  DPV3085 (12/13/2007) - Pass in stored ID to BVA instead of fully formed Oid for stream fields
	;  DPV3028 (09/25/2007) - Just record $H, $ZN, and Namespace in top node of temp file now that it is a private global
	;  AK659   (10/25/2006) - Outer join into a split rowid in an index map
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  AK664   (11/13/2006) - Duplicate streamed views
	;  AK660   (11/02/2006) - Fix copy into self with NULL marker
	;  JLF120  (09/13/2006) - Make NOTEXISTS:= case of SVSO test for empty set
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  DPV2677 (06/22/2006) - Support "BROWSE" mode for READ_COMMITTED locking via xODBC
	;  JLF105  (05/04/2006) - Use correct pqb correlated NULL and sqb correlated NULL substitute in svso "<> ALL" case
	;  AK614   (11/19/2004) - Index-assisted aggregates optimization
	;  JLF083  (02/23/2006) - Use collated nulls in SVSO
	;  DPV2593 (02/21/2006) - SQL Enhancement: Use private global for SQL instead of ^mtemp0
	;  DPV2587 (02/16/2006) - SQL Enhancement: Move ^CacheTempSMD($J) to ^||smd()
	;  JLF066  (10/03/2005) - Do svso correlated expression evaluation before build phase
	;  AK615   (12/02/2004) - Single temp-file for GROUP BY and aggregates
	;  AK589   (11/22/2004) - Fix DISTINCT for string of length 124
	;  JLF005  (10/27/2004) - Overflow from ^%qaqcpr (routine created)
	;
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
#ENDIF  ;-------------------------------------------------------------
	$$$Abort  ; Not an Entry Point!!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
pk(pk)	n padnext,ndata,vidsvar  ;  Process all the Pre/PostKey things
	#;  can be a module call (to create Temp File), condition, or a copy
	#;  for pk=3, Either Data GET, Conditions, or Module call.
	#;  *** for pk=1, why not data, distinct?
	s ndata=""
ploop	s ndata=$o($$$aslPk(mod,pk,ndata))
	if ndata="" QUIT  ; all done
	#; AK828
	n objAsl s objAsl = $$$oXasl
	d:$d($$$aslPkId(mod,pk,ndata)) axes^%qaqcky(pk,ndata)  ;get data
	d:$d($$$aslPkConds(mod,pk,ndata)) setcond($$$aslPkConds(mod,pk,ndata)) ; Conditions
	d:$d($$$aslPkCallAnotherMod(mod,pk,ndata)) temp($$$aslPkCallAnotherMod(mod,pk,ndata))
	d:$d($$$aslPkCopy(mod,pk,ndata)) copy($$$aslPkCopy(mod,pk,ndata))
	d:$d($$$aslPkDist(mod,pk,ndata)) distinct($$$aslPkDist(mod,3,ndata))
	#; AK419
	d:$d($$$aslPkInit(mod,pk,ndata)) init($$$aslPkInit(mod,pk,ndata))
	#; AK427
	d:$d($$$aslPkCompare(mod,pk,ndata)) compare($$$aslPkCompare(mod,pk,ndata))
	#; AK446
	d:$d($$$aslPkUnaryFuncs(mod,pk,ndata)) unary($$$aslPkUnaryFuncs(mod,pk,ndata))
	#; AK849
	d:$d($$$aslPkQueueQuery(mod,pk,ndata)) quq($$$aslPkQueueQuery(mod,pk,ndata))
	d:$d($$$aslPkVecOp(mod,pk,ndata)) vop($$$aslPkVecOp(mod,pk,ndata))  ;  AK1041
	d:$d($$$aslPkWhereFilt(mod,pk,ndata)) wfempty($$$aslPkWhereFilt(mod,pk,ndata))  ;  AK1047
	d:$d($$$aslPkBmChunk(mod,pk,ndata)) bmch(objAsl.Mod(mod).Pk(pk,ndata).BitChunk())
	d:$d($$$aslPkBmFilt(mod,pk,ndata)) filter(objAsl.Mod(mod).Pk(pk,ndata).Filter())
	d:$d($$$aslPkUnsupportedDml(mod,pk,ndata)) assign($$$aslPkUnsupportedDml(mod,pk,ndata))
	d:$d($$$aslPkCachedChunk(mod,pk,ndata)) cachedchunk($$$aslPkCachedChunk(mod,pk,ndata))  ;  AK1080
	d:$d($$$aslPkCheckBit(mod,pk,ndata)) checkbit($$$aslPkCheckBit(mod,pk,ndata))  ;  AK1080
	d:$d($$$aslPkBslTopFilt(mod,pk,ndata)) bstopfilt($$$aslPkBslTopFilt(mod,pk,ndata))
	d:$d($$$aslPkBundledVecOps(mod,pk,ndata)) bundledVop($$$aslPkBundledVecOps(mod,pk,ndata))
	for i=1:1 {
		if $d($$$aslPkBslRangeFiltItem(mod,pk,ndata,i)) {
			d bsrangefilt($$$aslPkBslRangeFiltItem(mod,pk,ndata,i))
		}
		else {
			QUIT
		}
	}
	#; DPV1531
	d:$d($$$aslPkCompareUnlock(mod,pk,ndata)) CompareUnlock($$$aslPkCompareUnlock(mod,pk,ndata))
	#; DPV1550
	If $d($$$aslPkEndmodtagUncommitted(mod,pk,ndata)),mt("querylock"),$g(taglockskip)'="" {
	        s tag=taglockskip,taglockskip=""
	        If $p($$$aslPkEndmodtagUncommitted(mod,pk,ndata),"^")>1,$d(mt("var","%delock_"_$p($$$aslPkEndmodtagUncommitted(mod,pk,ndata),"^")_"_"_$p($$$aslPkEndmodtagUncommitted(mod,pk,ndata),"^",2))) { s line=$$unlocksi2^%qaqcct($p($$$aslPkEndmodtagUncommitted(mod,pk,ndata),"^"),$p($$$aslPkEndmodtagUncommitted(mod,pk,ndata),"^",2),1) }	// DPV2677 (Pass reset=1 to unlocksi)
	        Else { s line=";" }
	        $$$liin(.line)
	        if padbot $$$liin("s "_$$$getVarName("pad"_mod)_"=1")
	}
	#; DPV1550-
	#; DPV1531-
	if $d($$$aslPostkeyReadVerifiedConds(mod,pk,ndata)) {
		do verify($g($$$aslPostkeyReadVerifiedConds(mod,pk,ndata)), $g($$$aslPostkeyReadVerifiedValsToReeval(mod,pk,ndata)), $g($$$aslPostkeyReadVerifiedSkipCollation(mod,pk,ndata)), $g($$$aslPostkeyReadVerifiedScratchVars(mod,pk,ndata)))
	}
	GOTO ploop
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cachedchunk(stuff)  ;  for stuff = idval ^ chn , maybe load new chunks  ;  AK1080
	#;  s v=id\64000+1 GOTO bottom:$g(chn)=v s chn=v
	n v s v=$$localvar(1)
	$$$liin("s "_v_"="_pti(+stuff)_"\64000+1 GOTO "_bottom_":$g("_pti($p(stuff,"^",2))_")="_v_" s "_pti($p(stuff,"^",2))_"="_v)
		#; We cannot allow this cached variable to survive multiple invocations of the cached query (which happens in xDBC if the CQ oref is cached)
	set mt("killvars")=$g(mt("killvars"))_$lb(pti($p(stuff,"^",2)))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
checkbit(stuff)  ;  for stuff = hch ^ pos [ ^ val ] , fail if  ;  AK1080
	#;  bit pos in hch not set, also apply vset(val) if provided
	#;  GOTO:'$BIT(hch,pos) bottom
	$$$liin("g:'$BIT("_pti(+stuff)_","_pti($p(stuff,"^",2))_") "_bottom)
	d:$p(stuff,"^",3) vset^%qaqcdt($p(stuff,"^",3))
	#; reset bit pos if requested
	i $p(stuff,"^",4) $$$liin("s $BIT("_pti(+stuff)_","_pti($p(stuff,"^",2))_")=0")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK427
compare(stuff)  ;  for stuff = val1 ^ val2 , compare the values as a condition
	s line="g:"_pti(+stuff)_"'="_pti($p(stuff,"^",2))_" "_bottom $$$liin(.line)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK427-
	#; DPV1531  DPV1550=
CompareUnlock(stuff)     ;  for stuff = val1 ^ val2 , compare the values as a condition, i failure unlock the row and goto bottom
	s line="i "_pti(+stuff)_"'="_pti($p(stuff,"^",2))_" {" $$$liin(.line),unlocksi^%qaqcct($p(stuff,"^",3),$p(stuff,"^",4)) s line="g "_bottom_" }" $$$liin(.line)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; DPV1531  DPV1550=-
	#; AK446
.
	#; Return true if val is a view-nulled field, a view field referencing a view-nulled field,
	#; or a correlated field referencing a view-nulled field.
	#; The mt("var","nul") value is "special" in that it should never be referenced
isViewNulled(val) [ mt,mts ] public {
	Set nulval = +$g(mt("var","nul"))
	RETURN:'nulval 0 //there's no nul value to worry about
	If val=nulval RETURN 1
	Set v = $$$mtV(val)
	//recurse n-node ref
	If $e(v)="n" RETURN $$isViewNulled($p(v,"^",2))
	//recurse view field
	If $e(v)'="f" RETURN 0
	Set str = $p(v,"^",2)
	Set q = +$g($$$mtRVirtual(str))
	If 'q RETURN 0 //not a view field
	Set vid = $$$mtPViewIDVal($$$mtP(q))
	If $p(v,"^",3)["_" {
		//uncollate
		Set qb = $$$mtRQb($$$mtR($p(v,"^",2)))
		Set val = $p(mts(qb,str,"ATT",+$p(v,"^",3)),"^",5)
	}
	If val=vid RETURN 0 //vid can't be nul value
	Set offset = val - vid
	RETURN $$isViewNulled($p($$$mtOutputVals($$$mtOutput(q)),",",offset))
}
unary(str) [ line, mt, pti ] public {;  set all "unary" functions on fields in str
	Set line="",fval="",fn=""
	#; AK664
	#;  if duplicate streamed view, copy field values to populate the row
	Set vq=$g($$$mtRVirtual(str)),dupv=$lg($g($$$mtDupsvRoot),vq)
	If dupv {
		Set base=$$$mtPViewIDVal($$$mtP(dupv)),ofset=$$$mtPViewIDVal($$$mtP(vq))-base
		For fnv=base:1:base+$l($$$mtOutput(dupv),",")-1 {
			CONTINUE:$$isViewNulled(fnv) //skip null'd view fields
	   		Do adset(pti(fnv+ofset),pti(fnv))
		}
	}
	#; AK664-
	For {
		Set fval=$o(mt("unary",fval)) QUIT:'fval
		CONTINUE:("f^"_str)'=$p($$$mtV(fval),"^",1,2) 
		For {
			Set fn=$o(mt("unary",fval,fn),1,fnv) QUIT:fn=""
			Do adset(pti(fnv),$s($$$mtVType($$$mtV(fnv))'="f":$$opval(fn,fval,pti(fval)),1:$$gencoll(fn,pti(fval))))
		}
	}
	Do setin
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK446-
	#;  allow "vop" argument to be either a quoted value, or a numeric val#
#define qnumarg(%arg) $s($li(stuff,%arg):pti($li(stuff,%arg)),1:$li(stuff,%arg))
vop(stuff)  ;  for stuff=$LB(result,op,vec[,args]) generate:  s result=$VOP("op",vec[,args])  ;  AK1041
	n args,jj,op,result,var2,var3,var4,from,to s args="",op=$li(stuff,2),result=$s($lg(stuff)="":$$localvar(1),1:$g(pti($lg(stuff))))
	d:"^countgb^countg^maxg^ming^sumg^anyg^countbg^groupg^"[("^"_op_"^") initvar^%qaqcasl(pti($li(stuff,5)))
	i op="vrne" {  ;  for (a<>b) in which "restrict" was applied to one
		#;  side, e.g. ra=restrict(a,vectype(b)), $VOP("v!=",ra,b) is
		#;  not enough, the correct result is:
		#;  vrne(ra,b,a): (ra<>b) OR (DEF(a) AND DEF(b) AND ~DEF(ra))
		set var2=$$localvar(2),var3=$$localvar(3),var4=$$localvar(4)
		$$$liin("s "_result_"=$vop(""v!="","_pti($li(stuff,3))_","_pti($li(stuff,4))_")")
		$$$liin("s "_var2_"=$vop(""defined"","_pti($li(stuff,5))_"),"_var3_"=$vop(""defined"","_pti($li(stuff,3))_"),"_var4_"=$vop(""defined"","_pti($li(stuff,4))_")")
		$$$liin("s "_result_"=$bitlogic("_result_"|("_var2_"&"_var4_"&~"_var3_"))")
		RETURN
	}
	i $ll(stuff)=5," = != < <= > >= "[(" "_op_" ") {  ;  AK1068
		#;  for =/range on 'string' vector, first convert the scalar for ZLS/NULL
		#;  s result=op(v,$CASE(<scalar>,$C(0):"",:<scalar>))  ;  arg5=1
		#;  s result=op(v,$CASE(<scalar>,$C(32):"",$C(32,0):$C(32),:<scalar>))  ;  arg5=2  ;  YCL218
		$$$liin("s "_result_"=$vop("""_op_""","_pti($li(stuff,3))_",$case("_pti($li(stuff,4))_$s($li(stuff,5)=1:",$c(0):"""",:",1:",$c(32):"""",$c(32,0):$c(32),:")_pti($li(stuff,4))_"))")
		RETURN
	}
	i op="replace" {  ;  replace(v,Qold,Qnew,vtype[,bm]) - replace  ;  AK1068
		#;  in v any instance of scalar old with new, but restrict to bitmap bm positions if provided
		#;  s result=$VOP("set",arg3,arg5,arg6,$VOP("=",arg3,arg4))
		#;  s result=$VOP("set",arg3,arg5,arg6,$BITLOGIC($VOP("=",arg3,arg4)&arg7))
		$$$liin("s "_result_"=$vop(""set"","_pti($li(stuff,3))_","_$$$qnumarg(5)_","""_$li(stuff,6)_""",$vop(""="","_pti($li(stuff,3))_","_$$$qnumarg(4)_"))")
		RETURN
		#;  with optional bitmap, when implemented:  (could also use a separate dummy variable)
		i $lg(stuff,7) $$$liin("s "_result_"=$vop(""set"","_pti($li(stuff,3))_","_$$$qnumarg(4)_","""_$li(stuff,6)_""",$bitlogic("_pti($li(stuff,7))_"&$vop(""="","_pti($li(stuff,3))_","_$$$qnumarg(4)_")))")
	}
	i op="collzls" {  ;  collzls(v,bm) - replace in v any  ;  AK1068
		#;  instance of space=$C(32) with $C(32,0), and then any
		#;  undefined (restrict to bitmap bm positions) to space
		#;  s var2=$VOP("defined",arg3)
		#;  s result=$vop("set",$VOP("set",arg3,$C(32,0),"string",$VOP("=",arg3," "))," ","string",$BITLOGIC(arg4&~var2))
		set var2=$$localvar(2)
		$$$liin("s "_var2_"=$vop(""defined"","_pti($li(stuff,3))_")")
		$$$liin("s "_result_"=$vop(""set"",$vop(""set"","_pti($li(stuff,3))_",$C(32,0),""string"",$vop(""="","_pti($li(stuff,3))_","" "")),"" "",""string"",$bitlogic("_pti($li(stuff,4))_"&~"_var2_"))")
		RETURN
	}
	i op="null" {  ;  null(v,bm) - bitmap of undefined positions in v  ;  AK1064
		#;  s result=$vop("defined",arg3),result=$bitlogic(arg4&~result)
		$$$liin("s "_result_"=$vop(""defined"","_pti($li(stuff,3))_"),"_result_"=$bitlogic("_pti($li(stuff,4))_"&~"_result_")")
		RETURN
	}
	i op="setlit" {  ;  setlit(v,lit,vtype,bm) - "set" with literal lit/vtype  ;  AK1064
		#;  s result=$vop("set",arg3,"arg4","arg5",arg6)
		$$$liin("s "_result_"=$vop(""set"","_pti($li(stuff,3))_","""_$li(stuff,4)_""","""_$li(stuff,5)_""","_pti($li(stuff,6))_")")
		RETURN
	}
	i op="removeval" {  ;  result=removeval(v,const) - change any const in v to "undefined"  ;  AK1064
		#;  s result=$vop("mask",arg3,$vop("!=",arg3,arg4))
		$$$liin("s "_result_"=$vop(""mask"","_pti($li(stuff,3))_",$vop(""!="","_pti($li(stuff,3))_","""_$li(stuff,3)_"""))")
		RETURN
	}
	i op="idvec" {  ;  AK1061
		#;  s result=$vop("+",$vop("positions",BMV),VHI)
		#;  s result=$vop("e_",$vop("convert",$vop("+",$vop("positions",BMV),VHI),"string"),"prtn_prefix")
		n expr s expr="$vop(""+"",$vop(""positions"","_pti($li(stuff,3))_"),"_pti($li(stuff,4))_"-1)"
		n ptnvars s ptnvars=$lg(stuff,5)
		if ptnvars'="" {
			n pfx s pfx=""
			for i=1:1:$l(ptnvars,",")-1 {
				s pfx=pfx_pti($p(ptnvars,",",i))_"_""||""_"
			}
			s expr="$vop(""e_"",$vop(""convert"","_expr_",""string""),"_$e(pfx,1,*-1)_")"
		}
		$$$liin("s "_result_"="_expr)
		RETURN
	}
	i op="scalar2vec" {  ;  AK1047
		#;  s result=$s(arg3="":"",1:$vop("set","",arg3,"string",arg4))  ;  CDS3436
		$$$liin("s "_result_"=$s("_pti($li(stuff,3))_"="""":"""",1:$vop(""set"","""","_pti($li(stuff,3))_",""string"","_pti($li(stuff,4))_"))")
		RETURN
	}
	i op="undefined" {  ;  AK1047 ; YCL146
		#;  s result=$vop("undefined",arg3,arg4)  ;  not implemented yet, for now:
		#;  s result=$vop("defined",arg3),result=$bitlogic(arg4&~result)
		$$$liin("s "_result_"=$vop(""defined"","_pti($li(stuff,3))_"),"_result_"=$bitlogic("_pti($li(stuff,4))_"&~"_result_")")
		RETURN
	}
	i (op="log2bm") {  ; AK1047
		#; s result=$s(eval(arg3):arg4,1:"")
		$$$liin("s "_result_"=$s("_$$cond^%qaqcpr($li(stuff,3))_":"_pti($li(stuff,4))_",1:"""")")
		RETURN
	}
	i (op="&")||(op="&~")||(op="|") {  ;  AK1047
		#;  s result=$bitlogic(arg3<op>arg4)
		$$$liin("s "_result_"=$bitlogic("_pti($li(stuff,3))_op_pti($li(stuff,4))_")")
		RETURN
	}
	i op="countbg" {  ;  AK1046
		#;  s result=$vop("countg",GV,$vop("set","",1,"integer",BMV),COA)
		$$$liin("s "_result_"=$vop(""countg"","_pti($li(stuff,3))_",$vop(""set"","""",1,""integer"","_pti($li(stuff,4))_"),"_pti($li(stuff,5))_")")
		RETURN
	}
	i op="groupg" {  ;  AK1046
		#;  s result=$vop("anyg",GV,$vop("set","",1,"integer",BMV),COA)  ;  when "anyg" implemented
		$$$liin("s "_result_"=$vop(""countg"","_pti($li(stuff,3))_",$vop(""set"","""",1,""integer"","_pti($li(stuff,4))_"),"_pti($li(stuff,5))_")")
		RETURN
	}
	i op="%VHASH" {  ;  AK1046 ; YCL453
		#;  s result=$vop("zlist",A,BMV)
		#;	d $zu(224,result,1,"string")
		#;	s result=$vop("v_",result,$vop("zlist",B,BMV))
		#;	s result=$vop("v_",result,$vop("zlist",C,BMV))
		$$$liin("s "_result_"=$vop(""zlist"","_pti($li(stuff,4))_","_pti($li(stuff,3))_")")
		$$$liin("d "_"$zu(224,"_result_",1,""string"")") 
		f jj=5:1:$ll(stuff) {
			$$$liin("s "_result_"=$vop(""v_"","_result_",$vop(""zlist"","_pti($li(stuff,jj))_","_pti($li(stuff,3))_"))")
		}
		RETURN
