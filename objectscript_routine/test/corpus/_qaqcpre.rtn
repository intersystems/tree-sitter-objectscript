	i $e(op,1,5)="ONEOF" {  ;  f=? OR f=?, IN  ;  DAB033;YCL140;AK1075
		#;  ONEOF[n/r][i/s/c] - set() may (n) or may not (r) include NULL,
		#;  f might be non-string (i), not collated (s), or collated (c)
		#;  s bm="",x=init  ;  init depends on the options - nc:" " , r*:"" , ni/ns:-1E19
		#;  next line included only for n*:
		#;  s:$d(set(x)) bm=$vop("defined",v),bm=$bitlogic(wf&~bm)  ;  only for n
		#;  arg depends on the options - c:$S(x=$C(32,0):" ",1:x) , s:$s(x=$c(0):"",1:x) , i:x
		#;  f  s x=$o(set(x)) q:x=""  s bx=$vop("=",v,arg),bm=$bitlogic(bm|bx)
		n line s var2=$$localvar(2),var3=$$localvar(3)
		s line="s "_result_"="""","_var2_$s(op["nc":"="" """,op["r":"=""""",1:"="_$$$NULLSubscriptMarker19q)
		s:op["n" line=line_" s:$d("_pti($li(stuff,4))_"("_var2_")) "_result_"=$vop(""defined"","_pti($li(stuff,3))_"),"_result_"=$bitlogic("_pti($li(stuff,5))_"&~"_result_")"
		$$$liin(line_" f  s "_var2_"=$o("_pti($li(stuff,4))_"("_var2_")) q:"_var2_"=""""  s "_var3_"=$vop(""="","_pti($li(stuff,3))_","_$s(op["c":"$s("_var2_"=$c(32,0):"" "",1:"_var2_")",op["s":"$s("_var2_"=$c(0):"""",1:"_var2_")",1:var2)_"),"_result_"=$bitlogic("_result_"|"_var3_")")
		RETURN
	}
	i op="addColNul" {  ;  result=addColNul(v,bm,const) - set any "undefined" in v+bm to const  ; YCL145
		#;  s var2=$vop("defined",arg3)  ;  use string/int based on const
		#;  s result=$vop("set",arg3,arg5,"string"/"integer",$bitlogic(arg4&~var2))
		set var2 = $$localvar(2)
		$$$liin("s "_var2_"=$vop(""defined"","_pti($li(stuff,3))_")")
		;  *** use unquoted constant, also pass in the datatype of v
		$$$liin("s "_result_"=$vop(""set"","_pti($li(stuff,3))_","_$li(stuff,5)_","_$s($isvalidnum($li(stuff,5)):"""integer""",1:"""string""")_",$bitlogic("_$s($lg(stuff,4):pti($li(stuff,4))_"&~"_var2,1:"~"_var2_",64000")_"))")
		RETURN
	}
	i op="SUBSTRING" {
