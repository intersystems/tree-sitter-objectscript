		set to = $$localvar(4)
		$$$liin("s "_from_"="_pti($li(stuff,4))_","_to_"="_pti($li(stuff,5)))
		$$$liin("s "_result_"=$s("_from_"="""":"""","_to_"="""":"""",1:$vop(""substring"","_pti($li(stuff,3))_","_from_","_to_"))")
		RETURN
	}
	i op="SUBSTR" {
		s var2 = $$localvar(2),var3 = $$localvar(3),from = $$localvar(4),to = $$localvar(5)
		$$$liin("s "_var2_"="_pti($li(stuff,4))_","_var3_"="_pti($li(stuff,5))_","_from_"=$s("_var2_"=0:1,1:"_var2_"),"_to_"="_var2_"+"_var3_"-$s("_var2_"=0:0,1:1)")
		$$$liin("i ("_var2_"="""")||("_var3_"="""")||("_var3_"<1)||("_to_"<"_from_") s "_result_"=""""")
