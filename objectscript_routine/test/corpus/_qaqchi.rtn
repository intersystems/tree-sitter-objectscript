====
qaqchi
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqchi^MAC^^^0
%qaqchi	// DO certain HIGH LEVEL Pre-Processing
	;; COMPONENTS :: SQL/PathSpecification
	#; Even this this routine in named %qaqc..., it does no code gen.  It processes asl() after optimization and before code gen, so I think it should be considered part of PathSPecification
#INCLUDE %msql
#IF 0   ;-------------------------------------------------------------
	; Description:   High Level Pre-Processing Part of ASL
	; Author:        Aviel Klausner
	; Date:          October 88 ?
	;
	;  MRP1083 (10/10/2018) - Fix leaky SQL compilation variable (srcV) during 'asl()' pre-processing redo in 'key^%qaqchi'
	;  AK688   (01/24/2008) - Abstract index/filter conditions
	;  AK799   (02/04/2011) - Fix map with parent subscripts out of order
	;  AK783   (07/30/2010) - Apply conversions to given split parent
	;  AK659   (10/25/2006) - Outer join into a split rowid in an index map
	;  DPV2839 (01/17/2007) - SQL: Various performance improvements to SQL/Routine compilers
	;  AK649   (06/06/2006) - Fix "u" looping for NULL=*NULL OUTER JOIN
	;  DPV2576 (01/20/2006) - Call StorageToLogical for fields only used in SQL Computed code.
	;  AK619   (03/04/2005) - Parent reference with >10 physical parts
	;  AK577   (09/25/2003) - Fix split subscript with "y" nexting
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  AK532   (09/02/2002) - NULL testing for "u" subscript and OUTER JOIN
	;  AK505   (01/11/2002) - Code generation for SET looping in KEY
	;  DPV1506 (03/13/2001) - Properly handle start condition with user-defined nullmarkers
	;  DPV1441 (11/14/2000) - Support user-defined NULLSubscriptMarker
	;  DPV1433 (10/26/2000) - Fix null subscript replacement for Name fields in 2 subscripts
	;  AK354   (02/05/1999) - Eliminate duplicate col# for parent's ifn's
	;  AK408   (11/23/1999) - Conditions on a split subscript
	;  DPV1180 (11/01/1999) - Fix NULL Name values in index subscripts
	;  DPV1149 (09/28/1999) - Remove internal id number dependencies for parent-child relationships
	;  AK315   (05/12/1998) - CCS: Multifield outer-join
	;  DPV981  (02/18/1998) - Don't set up NULL Marker replacement for master maps
	;  MRP700  (07/08/97)   - Optimize Complex OR & IN Conditions
	;  DPV751  (06/24/97)   - Copied %aaa* to %qcg*.  Derived from %aaahi
	;                         Changed all I references to "^".
	;  MIT061  (01/17/97)   - Remove $P($C(1)) from field node value in QP
	;  DPV700  (01/15/97)   - handle NULL Subscript Markers
	;  MRP643  (10/02/96)   - Modularize Embedded SQL Code: 'gvar' to '$$$MSQLModuleVariable'
	;  DPV603  (03/06/96)   - Cleaned up code
	;  MRP577  (01/15/96)   - Allow BETWEEN conditions for 2 piece subscript
	;  MRP548  (11/12/95)   - Support System Type Templates
	;  MRP472  (01/13/95)   - Make WHERE RowID = :p1 OR RowID = :p2 ... work
	;                       --- cleaned up: old stuff in zaaahi ---
	;  AK274   (07/13/93)   - handle ParID split into unordered subscripts
	;  AK029;AK030;AK033;AK035;AK041;AK063;AK152;AK159;ALL003;ALL001;AK216;AFH001
	;
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
	;  Called from %qaqcasl.  spin thru asl() to check for pre-procesing 
	;
	;  1. If a "next" entry has type "u", pre-copy(1/6) the given value
	;     into the correct variable (including on temp-files).
	;     DPV700 - use copy(6) for NULL-processing
	;     DPV1180 - but use copy(1) if split %Name, NULL done on each part
	;  2. "next" entry on a split Name:
	;         Add 1 additional asl "next" entry.
	;         If type "u", first copy(split - 3/10) the given value into its 2
	;         parts.
	;         If type "y", loop on the set with icol, then copy(split - 3/10)
	;             into the actual subscripts, and use type "u" on the 2nd subscript
	;         If type "a", flag in $P(8) to copy(combine - 5) afterwards.
	;         Retest all subscript conditions on the 2nd subscript - AK408
	;             If %SW, mark each "next" entry with %SW.
	;                 pre-copy(split - 3) the given constant.
	;             If other range, modify to "...-or-equal" and apply to
	;                 the first subscript using the split(3) constant,
	;                 then retest the condition on the 2nd subscript
	;  3. "next" entry on a split ParentID:  Same as %Name, except:
	;         May be more than 2 subscripts
	;         Use copy(2/4) instead of copy(3/5)
	;         For %SW (???), do not split condition, just test later
	;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  col# for given ifn.  qno, str had better be set.
#define instream(%ifn) $p($g(mts(qno,str,"ATT",%ifn)),"^",5)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	n ndata,id,imp,str,qno,i5,stuff,icol,asc,ifn,based s mod=""
hiloop	s mod=$o($$$aslMod(mod)) QUIT:mod=""
	set id=$g($$$aslKId(mod,1))
	set imp=$$$aslIdMapId(id)
	set str=$$$aslIdStrNum(id)
	set qno=$$$aslIdQb(id)
	#; JLF015
	#;  If a cloned collection map, then get its originating imp
	n smdimp s smdimp=$s($d(mt("smdimp",+imp)):mt("smdimp",+imp),1:+imp)
	#; JLF015-
	#; If the map we are nexting on is a 'Full' index map, we need to
	#; allow for NULL subscript values for non-required fields.
	#; mt("nmsub") will hold a list of fields (as defined in mt("v"))
	#; who's subscript values need to be checked for the NULL marker
	#; mt("nmsub") (NULL marker subscript) is an array of the form:
	#;     $$$mtNullMarkerSub(mod,fld)=<Null Subscript Marker Expression>
	#; Where fld is the $$$mtV(xxx), xxx value
.
	if imp,'$d(mt("filterm",imp)),$$$smdMapMaster(smdimp)'="Y",$$$smdMapPopulateType(smdimp)=1 {  // MapPopulateType=Full (and not master)
		new asldata,cnt,ifn,irn,mtfld,n,nullmarker,scol
		set n="",cnt=0
		for  {
			set n=$o($$$aslKNext(mod,1,n),1,asldata) quit:n=""
			set mtfld=+asldata continue:'mtfld                   // Not a Field
			set ifn=+$p($g($$$mtV(mtfld)),"^",3) continue:ifn=0  // Unknown Field
			set cnt=cnt+1
			set irn=$$$smdGetIrnFromIfn(ifn)                     // Get Field's table
			#; If this is a parent ref field, increment the counter if the parent has composite id
			#; this would avoid mismatch between the unexpanded asl(mod,2,1,"next") which has logical fields and $$$smdMapNullMarkers which has the null markers for the physical fields
			if $$$smdGetIcolFromIfn(ifn)=0{set cnt=cnt+$$$smdMapParIDLevWOCon(smdimp)-1}
			set scol=$$$aslNextLoopingLowLimOrSetVar(asldata)
				#; We have to implement special handling if %Name fields mapped in two subscripts because we have not yet expanded the "next" entries
				#; to include two subscripts for this field.  $$$smdMapNullMarkers(smdimp) already accounts for the two subscripts.
				#; For this case we will store $$$mtNullMarkerSub(mod,mtfld)=$lb(nullmarker-sub1,nullmarker-sub2), and then in expand we will split this apart into the two nodes.
				#; Even if the %Name field is using a collation that cannot produce a NULL value, the second subscript of a %Name value could be NULL
			if $p(mts(qno,str,"MAP",imp,n),"^",8) {
					#; name subscript 1
				set nullmarker=$lg($$$smdMapNullMarkers(smdimp),cnt)
				if nullmarker'="" {
						#; Check for Non-NULL start value (If using default nullmarker)
					if scol,$$$mtVType($$$mtV(scol))="t",$$$mtVConstVal($$$mtV(scol))'="",$$$aslNextLoopingLowLimExcl(asldata)'=2,nullmarker=$$$NULLSubscriptMarkerq { set nullmarker="" }
						#; Check for NULL (non-inclusive) start value (If using default nullmarker)
					elseif scol,$$$mtVType($$$mtV(scol))="t",$$$mtVConstVal($$$mtV(scol))="",$$$aslNextLoopingLowLimExcl(asldata)=0,nullmarker=$$$NULLSubscriptMarkerq { set ok=nullmarker="" }
						#;  no NULL-marker if OJ and "unique" value comes from a field - test for NULL would cause proper padding
					if $$$aslNextLoopingType(asldata)="u",$$$aslIdPaddingOjLogic(id)="p" { set ok=nullmarker="" }
				}
					#; name subscript 2
				set cnt=cnt+1
				set $$$mtNullMarkerSub(mod,mtfld)=$lb(nullmarker,$lg($$$smdMapNullMarkers(smdimp),cnt))
				continue
			}
			continue:$$$smdColRequired(1,irn,ifn)="Y"            // Field is required
				#; These uses of $$$NULLSubscriptMarkerq should be OK because if the field requires a smaller number nullmarker, it should be defined in $$$smdMapNullMarkers already 
				#; If we find a nullmarker of "", this subscript should not require a null marker.  Most likely this is a string field with a collation
				#; that will not be NULL.  If we find a nullmarker="" and it should not be, we should fix this in CompiledTopLevelPieces^%ocsSQLRTDict.
			set nullmarker=$lg($$$smdMapNullMarkers(smdimp),cnt) continue:nullmarker=""  //s:nullmarker="" nullmarker=$$$NULLSubscriptMarkerq
				#; Check for Non-NULL start value (If using default nullmarker)
			if scol,$$$mtVType($$$mtV(scol))="t",$$$mtVConstVal($$$mtV(scol))'="",$$$aslNextLoopingLowLimExcl(asldata)'=2,nullmarker=$$$NULLSubscriptMarkerq {
					#; if the constant start valye collates after the null marker, we are ok
				if $$$mtVConstVal($$$mtV(scol))]]$$$NULLSubscriptMarker { continue }
					#; Otherwise, the constant start value is either the null marker, or collates before the null marker
					#; At code generation time we will start looping with the nullmarker value, but we need to set the start to be non-inclusive here
				if $case($$$aslNextLoopingLowLimExcl(asldata),1:1,6:1,:0) { set $$$aslNextLoopingLowLimExcl($$$aslKNext(mod,1,n))=$$$aslNextLoopingLowLimExcl(asldata)-1 }
			}
				#; Check for NULL (non-inclusive) start value (If using default nullmarker)
			if scol,$$$mtVType($$$mtV(scol))="t",$$$mtVConstVal($$$mtV(scol))="",$$$aslNextLoopingLowLimExcl(asldata)=0,nullmarker=$$$NULLSubscriptMarkerq { continue }
				#;  no NULL-marker if OJ and "unique" value comes from a field - test
				#;     for NULL would cause proper padding
				#; TRW: Check old "p" flag and new TRW1497 pad ranges with $$padhead
			if $$$aslNextLoopingType(asldata)="u",($$$aslIdPaddingOjLogic(id)="p")||$$padhead^%qaqcasl(mod) { continue }
			set $$$mtNullMarkerSub(mod,mtfld)=nullmarker
			set $$$mtUserDefNullMarkerFlag(mod,mtfld)=$$$smdColUserDefinedNullMarker(1,+$$$mtR($$$mtVFieldQbOrStream($$$mtV(mtfld))),$$$mtVFieldLabelOrIFN($$$mtV(mtfld)))  ; IBA097, indicate presence of a user-defined nullmarker
		}
	}
.
	#;  Check for Uniques, Parent ID's, and Name
	s i5=""
	#; MRP700
	for  {
		set i5=$o($$$aslKNext(mod,1,i5)) quit:i5=""
		set stuff=$$$aslKNext(mod,1,i5)
		set asc=$$$aslNextLoopingType(stuff)
		do:((asc'="c")&&(asc'="h")) key
	}
	#; MRP700-
	GOTO hiloop
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
key	s icol=$$$aslNextSubscriptVal(stuff)
	#;  Pre=process a Unique Subscript - setup a "copy" in Pre-Key
	#; DPV1180
	If asc="u" {
		#;  If name field broken in two subscripts, don't set copy flag to 6 if NULL marker replacement needed handle it below in xpand.
		new npk,srcV
		set npk=$o($$$aslPk(mod,1,""),-1)+1
		set srcV=$$$aslNextLoopingLowLimOrSetVar(stuff)
		if imp,$p(mts(qno,str,"MAP",imp,i5),"^",8),'$$needsBarsTranslation^%qaqpmod(srcV,icol) {
			set $$$aslPkCopy(mod,1,npk)=1_"^"_srcV_"^"_icol
		}
		elseif '$$hasNextCopy(mod,i5,$$$aslNextLoopingLowLimOrSetVar(stuff)),'$$needsBarsTranslation^%qaqpmod(srcV,icol) {
			set $$$aslPkCopy(mod,1,npk)=$s('$d($$$mtNullMarkerSub(mod,icol)):1,1:6)_"^"_srcV_"^"_icol   // copy type 6 (nullmarker), or type 1 (regular scalar copy)
		}
	}
	#; DPV1180-
	QUIT:imp=""  ;  the following only for DD maps, not temp files
	#; AK688
	QUIT:$d(mt("filterm",imp))
	s x=$p(mts(qno,str,"MAP",imp,i5),"^",8) ;Name flag set in ddname^qo1
	#; If Name field broken down into 2 subscripts, we gotta expand it.
	#;  *** add conditions, especially %SW (?)
	i x d xpand("S"_x_",S"_(x+1),1) QUIT
	#;  See if this field is a Parent ID Field which is REALLY
	#;  based on others ones.  If so we gotta expand it.
	#;  icol entry can be either of f/i^str^ifn
	QUIT:$$$smdGetIcolFromIfn($p($$$mtVFieldLabelOrIFN($$$mtV(icol)),"_"))'=0  ; not a parent ID after all
	QUIT:$$$smdMapParIDLevWOCon(smdimp)<2  ; its not strung over 2 or more subscripts
	#;  OK. We gotta DO Something, so
	s based=$$$smdRowIDPhysicalFields(1,$$$smdLoadGetIrn($$$smdParentTable(1,+$$$mtR(str))))
	d xpand(based,0)
	#;  Get list of fields this ID (in the Parent) is based on
	#;  we need the col's to do an ID type copy
	QUIT
	#; Returns true if val is already set by a $p(8) copy operation
	#; in a prior subscript loop. (See AK029 / AK505 / TRW1586)
hasNextCopy(mod,sub,val) [ asl ] public {
	For i=sub:-1:1 {
		Set stuff=$$$aslKNext(mod,1,i)
		Set copies = $$$aslNextCopySpecAfterThisSubscript(stuff)
		//There can be multiple copy commands in this subscript, ~-separated, see AK659
		For j=1:1 {
			Set targets = $$$aslPkCopyTarget($p(copies,"~",j)) QUIT:targets=""
			If (","_targets_",")[(","_val_",") RETURN 1
		}
.
	}
	RETURN 0
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
xpand(basecol,nflag)  ;  nflag=0 for parid, 1 for name
	#; we need the col's to do an ID/Name type copy.
	#; AK619
	#;  for real ifn, must use an existing col#, if one exists.  ;  AK354
	#;  for "Si", must never use an existing col#, since it most likely belongs to a different map
	for i=1:1 {
		set ifn=$p(basecol,",",i) q:ifn=""
		set j=$s(ifn:$$col(ifn),1:$$scrcol(ifn))
		set $P(basecol,",",i)=j
		set $$$aslKNext(mod,1,$$i5sub())=j_$c(1)_asc
		#; set $$$aslNextSubscriptVal($$$aslKNext(mod,1,$$i5sub()))=j
		#; set $$$aslNextLoopingType($$$aslKNext(mod,1,$$i5sub()))=asc
		set i5=i5+.001  ;  AK033;AK152+;AK274
	}
	#;  for SET looping, loop at the first subscript on icol, then copy(2/3/10)  ;  AK505;AK577
	#;     into the actual subscripts, and don't loop on the other subscripts
	#; AK659
	#;  if this feature already used on this subscript, then just
	#;     add the copy as an additional "~" piece in $P(8), and
	#;     use the same looping variable in $P(9)
	if asc["y" {
		set $$$aslNextLoopingLowLimOrSetVar($$$aslKNext(mod,1,i5\1))=$$$aslNextLoopingLowLimOrSetVar(stuff)
		#; set $p($$$aslKNext(mod,1,i5\1),$c(1),8,9)=$s($p(stuff,$c(1),8):$p(stuff,$c(1),8)_"~",1:"")_$s('$d($$$mtNullMarkerSub(mod,icol)):2+nflag,1:10)_"^"_icol_"^"_basecol_$c(1)_$s($p(stuff,$c(1),9):$p(stuff,$c(1),9),1:icol)
		set $$$aslNextCopySpecAfterThisSubscript($$$aslKNext(mod,1,i5\1)) = $s($$$aslNextCopySpecAfterThisSubscript(stuff):$$$aslNextCopySpecAfterThisSubscript(stuff)_"~",1:"")_$s('$d($$$mtNullMarkerSub(mod,icol)):2+nflag,1:10)_"^"_icol_"^"_basecol
		set $$$aslNextAnotherLoopingSetVar($$$aslKNext(mod,1,i5\1)) = $s($$$aslNextAnotherLoopingSetVar(stuff):$$$aslNextAnotherLoopingSetVar(stuff),1:icol)
		for i=i5\1+.001:.001:i5-.001 { set $$$aslNextLoopingType($$$aslKNext(mod,1,i))="u" }
	}
	#; AK659-
	s $$$aslNextAdditionalCondsOnSubscript($$$aslKNext(mod,1,i5-.001))=$$$aslNextAdditionalCondsOnSubscript(stuff)  ;  AK408
	#; AK619-
	#;  If its a UNIQUE in "next", better copy some more
	#; DPV1180
	#; DPV1433
	if asc="u" {
		set $$$aslPkCopy(mod,1,$o($$$aslPk(mod,1,""),-1)+1)=$s('$d($$$mtNullMarkerSub(mod,icol)):2+nflag,nflag:10,1:2)_"^"_icol_"^"_basecol
		#; set $$$aslPkCopyCopyType($$$aslPkCopy(mod,1,$o(asl(mod,1,""),-1)+1))=$s('$d($$$mtNullMarkerSub(mod,icol)):2+nflag,nflag:10,1:2)
		#; set $$$aslPkCopySource($$$aslPkCopy(mod,1,$o(asl(mod,1,""),-1)+1))=icol
		#; set $$$aslPkCopyTarget($$$aslPkCopy(mod,1,$o(asl(mod,1,""),-1)+1))=basecol
	}
	#;  Change mt("nmsub") from name field itself into two name subscripts
	#; DPV1441
	if nflag,$d($$$mtNullMarkerSub(mod,icol)) {
		new nmark
		for i=1:1:$l(basecol,",") {
			set nmark=$lg($$$mtNullMarkerSub(mod,icol),i)
			set:nmark'="" $$$mtNullMarkerSub(mod,$p(basecol,",",i))=nmark
		}
		kill $$$mtNullMarkerSub(mod,icol)
	}
	#; AK783
	#;  add no-op copy(1) icol=icol, to cause vset(icol) in nextcond^cky()
	i asc="u" {
		set $$$aslNextCopySpecAfterThisSubscript($$$aslKNext(mod,1,i5\1))="1^"_icol_"^"_icol
	}
	#; AK783-
	QUIT:asc="u"
	#; DPV1433-
	#; AK505
	QUIT:asc["y"
	#; Flag columns to recombine into ParentID/Name, for suback+9,+11^key
	#; AK619
	s $$$aslNextCopySpecAfterThisSubscript($$$aslKNext(mod,1,i5-.001))=(4+nflag)_"^"_basecol_"^"_icol  ;  AK408
	#; AK505
	#;  %SW on Name:  split the condition into 2 $Pieces, no need to retest
	#; AK619
	if nflag,$$$aslNextLoopingLowLimExcl(stuff)=2 {
		set basecol=$$split($$$aslNextLoopingLowLimOrSetVar(stuff),basecol)
		#; set $p($$$aslKNext(mod,1,i5-.002),$c(1),3,4)=+basecol_$c(1)_2
		set $$$aslNextLoopingLowLimOrSetVar($$$aslKNext(mod,1,i5-.002))=+basecol
		set $$$aslNextLoopingLowLimExcl($$$aslKNext(mod,1,i5-.002))=2
		set $$$aslNextLoopingLowLimOrSetVar($$$aslKNext(mod,1,i5-.001))=$p(basecol,",",2)
		set $$$aslNextLoopingLowLimExcl($$$aslKNext(mod,1,i5-.001))=2
		QUIT
	}
	QUIT:$c(1,1,1)[$p(stuff,$c(1),3,6)  ;  no range condition
	#;  apply modified RANGE conditions from $p(3,6) to subscript of first
	#;  piece, retest on last subscript (*** probably works only for %Name)
	n rlog,log7
	s rlog=$p(mts(qno,str,"RANGE",$$$mtVFieldLabelOrIFN($$$mtV(icol))),"^",2),log7=$p(stuff,$c(1),7)
	#;  retest the whole RANGE condition on the last subscript
	f i=2:1:$l(rlog,",")-1 i ","_log7'[(","_$p(rlog,",",i)_",") s log7=log7_$p(rlog,",",i)_","
	#; AK619
	s $$$aslNextAdditionalCondsOnSubscript($$$aslKNext(mod,1,i5-.001))=log7
	QUIT:$p(stuff,$c(1),4)=2  ;  %STARTSWITH - only retest
	#;  modify the subscript range condition(s) to "...-or-equals" on the
	#;     split of the constant, ...
	s rlog=stuff,$p(rlog,$c(1),7)=""
	i $p(rlog,$c(1),3) s $p(rlog,$c(1),4)=1,$p(rlog,$c(1),3)=+$$split($p(rlog,$c(1),3),basecol)  ;  f>=?
	i $p(rlog,$c(1),5) s $p(rlog,$c(1),6)=1,$p(rlog,$c(1),5)=+$$split($p(rlog,$c(1),5),basecol)  ;  f<=?
	#;  and test it on the subscript that corresponds with the "first" part
	s i=i5\1 n i5 s i5=i  ;  to make sure $$i5sub works properly
	s $p($$$aslKNext(mod,1,$$i5sub()),$c(1),3,6)=$p(rlog,$c(1),3,6)  ;  ***
	#; AK505-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK505
split(icol,based) n i  ;  $$:  comma-separated list (like based) of scratch
	#;  variables into which icol is split using copy(2/3) in PREKEY
	f i=1:1:$l(based,",") s $p(based,",",i)=$$$newvar("split"_icol_"p"_i)
	s $$$aslPkCopy(mod,1,$o($$$aslPk(mod,1,""),-1)+1)=2+nflag_"^"_icol_"^"_based
	QUIT based
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK505-
i5sub() ;  $$:  if split ParID, unordered,
	#;  Set the asl node according to the actual order in the map
	QUIT:nflag i5  ;  Name
	n cnt,ilev,sub
	s ilev=$$$smdMapParIDStartLev(smdimp),cnt=i5\1  ;  see sub^qo1
	#; Find ifn's place within the actual subscripts, skip constants
	#; AK619
	f  s sub=$lg($$$smd(12,smdimp,6,ilev),19) q:sub=ifn  s:sub cnt=cnt+.001 s ilev=$o(^(ilev)) i 'ilev $$$Abort
	QUIT cnt
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  $$:  get val#, or assign      a new column  ...  or existing one
col(ifn) QUIT:'$d(mts(qno,str,"ATT",ifn)) $$scrcol(ifn) QUIT $$$instream(ifn)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; $$ Function - Scratch Column. It Returns 'icol'.
	#;  We assign a scratch column number, and stick into parse tree.
	#;  called from col+2^dat,xpand+2,col+1 *** use macro!
scrcol(ifn,sl2=0) //
	new icol
