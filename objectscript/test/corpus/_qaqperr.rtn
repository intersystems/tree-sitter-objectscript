e26	q $$$FormatMessage(,"%Parser","e26",,)
e27	q $$$FormatMessage(,"%Parser","e27",,name)
e28	q $$$FormatMessage(,"%Parser","e28",,$e(sql,p))
e29	q $$$FormatMessage(,"%Parser","e29",,name)
