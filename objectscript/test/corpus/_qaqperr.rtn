e30h	q $$$FormatMessage(,"%Parser","e30h",,)
e31	if $g(path)="" q $$$FormatMessage(,"%Parser","e31a",,fname,tname)
	q $$$FormatMessage(,"%Parser","e31b",,fname,tname)
e32	q $$$FormatMessage(,"%Parser","e32",,)
e33	q $$$FormatMessage(,"%Parser","e33",,$$$mtFromTableName(ml))
