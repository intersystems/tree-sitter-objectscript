e35	if $g($$$mtStatementType)="INS" q $$$FormatMessage(,"%Parser","e35a",,$$$smdSchema(3,ivn),$$$smdName(3,ivn))
	if $g($$$mtStatementType)="UPD" q $$$FormatMessage(,"%Parser","e35b",,$$$smdSchema(3,ivn),$$$smdName(3,ivn))
