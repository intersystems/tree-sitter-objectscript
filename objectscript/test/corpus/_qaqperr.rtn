====
qaqperr
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqperr^MAC^^^0
%qaqperr	// SQL error messages (5/10/87)
	;; COMPONENTS :: SQL
	#;
#INCLUDE %msql
#IF 0   ;-------------------------------------------------------------
	; Description:   SQL Error Messages
	; Author:        Aviel Klausner
	; Date Started:  05/10/1987
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;  MRP1016 (08/23/2017) - SQL: Remove SQLCODE/%msg error duplication from Query Processing/Compilation
	;  MRP1015 (08/22/2017) - SQL: Add meaningful SQLCODE error for 'Cardinality mismatch between the SELECT-list and %INTOLIST-param'
	;  MRP822  (12/08/2014) - SQLCODE=-381: Too many arguments #%1 to %2 function: %3
	;  MRP777  (09/06/2013) - SQLCODE=-380: Invalid or Missing argument #%1 to %2 function: %3
	;  AK805   (03/03/2011) - SQLCODE=-161 for unimplemented heter. joins
	;  PVA180  (05/19/2009) - Parse TOP ... ORDER BY in subqueries. 
	;  DPV3341 (01/15/2009) - Support TOP clause in INSERT/SELECT, report error if TOP used in subquery
	;  DPV3324 (12/16/2008) - Report error for INSERT statements with a subquery
	;  PVA163  (10/30/2008) - Give informative SQL Error message for UNION with invalid ORDER BY
	;  DPV3227 (07/28/2008) - Implement "tablist" info compile
	;  DPV3191 (06/11/2008) - Report error for SUM() on DATE, TIME, or TIMESTAMP values
	;  DPV3158 (05/13/2008) - Don't allow UPDATE to set non-stream field equal to stream field value
	;  JLF199  (1/8/2008)   - Added Invalid Savepoint name message
	;  DPV3079 (12/10/2007) - SQL Error localization
	;  DPV3059 (10/24/2007) - Implement support for %OID() function
	;  DPV3057 (10/22/2007) - Report error -313 if stream field found in a condition
	;  DPV3053 (10/16/2007) - For COALESCE function return best compatible type
	;  DPV3042 (10/02/2007) - Report -377 error if duplicate fields in INSERT or UPDATE list
	;  DPV2994 (08/06/2008) - Revert stream oref change.  Implement %OBJECT()
	;  DPV2927 (05/02/2007) - Simplify some SQL error messages
	;  DPV2723 (08/29/2006) - Report error if un-delimited USER token is used as schema name
	;                         SQL Fix ProdLog 51079: CREATE TABLE User.T changes default schema assignment
	;  PVA087  (02/01/2006) - Extended Outer Join Support: Any ON clause for LEFT JOIN from base tables to a base table.
	;  DPV2531 (10/05/2005) - Support BIGINT in CAST
 	;  PVA072  (11/10/2004) - Support pseudo conditions implied by TOP... ORDER BY in optimizer
	;  JMM001  (10/27/2004) - Implement support for IDENTITY columns
	;  DPV2221 (06/02/2004) - Improve error reporting, always start error line with ERROR:
	;  DPV2148 (12/19/2003) - Enhance User-defined procedure error reporting.
	;			  SQL Fix ProdLog 31898:  Stored procedures are not visible if sqlproc method does not have return type
	;  DPV2132 (12/01/2003) - Check readonly for INS/UPD/DEL at compile time
	;			  SQL Fix ProdLog 34802:  some errors for UPDATE/DELETE for Read-Only tables
	;  DPV2126 (11/14/2003) - Support SETUSER <username>
	;  DPV2125 (11/14/2003) - Use token instead of c as quote char in err3
	;  BJB275  (10/03/2003) - Do not allow DesRef->field to be modified by INSERT or UPDATE
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  PVA053  (06/11/2003) -  Give error message for ambiguous ORDER BY clause 
	;  DPV2000 (06/02/2003) - Enhance some error messages
	;  PVA050  (02/12/2003) - ensure use of rowid based on one field, and the field itself are equally optimized. 
	;  BJB237  (08/27/2002) - Avoid <MAXNUMBER> error SQL constants
	;  DPV1743 (06/11/2002) - Allow $$tag^rtn function calls to be disallowed
	;  DPV1738 (06/05/2002) - Don't allow stream field as argument to scalar functions (added error 37)
	;  DPV1732 (05/31/2002) - Re-implement SQL Function support
	;  DPV1693 (03/28/2002) - Support updatable views
	;  DPV1596 (10/09/2001) - Support calling SQL functions
	;  PVA027  (08/01/2001) - Support a few optimizer directives on the FROM clause  
	;  DPV1565 (07/10/2001) - Add error 8, unsupported DATEPART code
	;  DPV1525 (04/17/2001) - Fix <UNDEFINED> error if called during recount compilation.
	;  DPV1509 (03/16/2001) - Implement CALL Statement for embedded SQL
	;  DPV1504 (03/09/2001) - Implement CREATE TRIGGER
	;  DPV1486 (02/13/2001) - Add error numbers for CREATE FUNCTION/METHOD/PROCEDURE/QUERY
	;  DPV1391 (09/06/2000) - Add "GRANT/REVOKE "_ to beginning of error 56
	;                         Eliminate error 58 - no longer used
	;  DPV1324 (06/19/2000) - #import sets current schema(s)
	;  DPV1310 (05/30/2000) - Support schemas
	;  PVA004  (10/27/1999) - wrong results for some join expressions
	;  AK398   (10/13/1999) - Fix ODBC Server error reporting
	;  DPV1151 (10/01/1999) - Support SQLUPPER and SQLSTRING Collations
	;  DPV1125 (08/23/1999) - Support orthogonal RIGHT OUTER JOIN operator: *=
	;  DPV1061 (05/10/1999) - Fix error reporting for -31
	;  DPV1006 (04/07/1999) - String collation support
	;  DPV904  (11/12/1998) - Enhanced error format for Studio
	;  AK290   (04/14/1997) - Implement {d|t|ts x} and %ODBCIN
	;  RLL655  (10/17/97)   - Fix RLL651 error trapping
	;  RLL651  (04/30/97)   - Handle SQLCODE<-100
	;  MRP683  (04/15/97)   - General View Validation...
	;  MRP570d (04/07/97)   - TP: Disable <level of isolation>="REPEATABLE READ"...
	;  AK286   (03/21/97)   - Use operation table (SQL categories) in QP
	;  MSS015  (03/05/97)   - Multi-Conditional OUTER-JOIN error message is added (SQL ERROR #94).
	;  MRP661  (12/09/96)   - Reserve SQL error 100 for the Relational Server
	;  DPV691  (10/22/96)   - DDL Parser error messages
	;  MRP570  (06/26/96)   - Transaction Processing
	;  MRP612  (06/01/96)   - Support SQL92 NATURAL JOIN...
	;  MRP597  (03/03/96)   - Consolidate the SQL Reserved Word List...
	;  MRP589  (03/20/96)   - Confirm Cardinality Match between SELECT-list & INTO-list...
	;  MRP585  (03/19/96)   - Support SQL92 TRIM Functions...
	;  MRP556  (11/30/95)   - Allow ORDER BY <agg> only as <column> alias...
	;  MRP552  (11/21/95)   - Don't allow Mutli-Line Fields in ORDER BY...
	;  MRP541  (11/07/95)   - Allow LIKE & [ against Multi-Line Fields...
	;  MRP537  (10/31/95)   - Record SQL errors for Macro Preprocessor when flags set..
	;  MRP535  (10/20/95)   - Support SET <field> = <value expression>
	;  MIT056  (07/21/95)   - Check for aggr and distinct in FROM subqueries
	;  MRP513  (07/04/95)   - Disallow Redundant Fields in SELECT list...
	;  RLL600  (05/10/95)   - Added error message (-65)
	;  VM023   (01/03/94)   - Changed the error message (-31)
	;  VM012   (10/30/94)   - New error message (-64)
	;  MRP393  (02/04/94)   - New error message (-63)
	;  PRT002  (10/12/93)   - Error code for GRANT REVOKE Roles
	;  PRT003  (10/18/93)   - GRANT/REVOKE %THRESHOLD (9 v.s. num constant)
	;  AK012;AK022;AK023;AK045;AK058;AK069;RGG073;IS002;IS009;EYT030
	;  AK148;AK157;EYT099;AK167;MRP121;AK192;AK193;AK248;MRP289
	;
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	if callname="recount"||(callname="tablist")||(callname="findname") { set %msg="SQLCODE=-"_+e_" : "_$$err()_$s(e<30||(e=312)||(e=326):"^"_$e(sql,1,p-1),1:""),SQLCODE=-e }
	elseif callname'="info"&&(callname'["view") { set %msg=$$$FormatMessage(,"%Parser","ERROR",,)_rtname_$s($g(entry)="LINES":"",1:".MAC")_"("_sqlline1_") : SQLCODE=-"_+e_" : "_$$err()_$select((e<30)||$case(e,148:1,312:1,326:1,327:1,:0):"^"_$e(sql,1,p-1),1:""),SQLCODE=-e }
	else { set %msg=" "_$$err()_$select((e<30)||$case(e,84:1,312:1,326:1,327:1,:0):"^"_$e(sql,1,p-1),1:""),SQLCODE=-e }
	i $g(wrtref)'="",$g(backgrnd) d  ; Record SQL Error for MPP...
	. n n,sqlcnt
	. s n=$g(@wrtref@(0))+1
	. s sqlcnt=$g(@wrtref@("sql"))+1
	. s @wrtref@(n)=%msg
	. s @wrtref@(0)=n                  ; Count ALL Errors
	. s @wrtref@("sql")=sqlcnt         ; Count SQL Errors
ep	;  entry-point from onebrace+?^dat, e,%msg already set
	//MRP1016 (Error displayed in sqlerror+?^%qarmac) i '$g(backgrnd) u:$g(%diffdev) IO w !,$p(%msg,"^") w:e<30 !,$p(%msg,"^",2) u 0
	$$$Abort ;  intentional error, 'w %msg' to see error, go to $ZT: err^%qaqqt
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
err()	s $zt="otherr^%qaqperr" g @("e"_e) ;---------- e = error# ----------
e1	q $$$FormatMessage(,"%Parser","e1",,$s(t="ID":$$$FormatMessage(,"%Parser","IDENTIFIER",,),t=9:$$$FormatMessage(,"%Parser","LITERAL",,)_$s($g(value)=+$g(value):" ("_value_")",$g(value)'="":" ('"_$tr(value,$c(0))_"')",1:""),t=$c(1):"<"_$$$FormatMessage(,"%Parser","EOS",,)_">",1:t),$s(token="ID":$$$FormatMessage(,"%Parser","IDENTIFIER",,)_$s($g(lower)'="":" ("_$tr(lower,$c(0))_")",1:""),token=9:$$$FormatMessage(,"%Parser","LITERAL",,)_$s($g(value)=+$g(value):" ("_value_")",$g(value)'="":" ('"_$tr(value,$c(0))_"')",1:""),token=$c(1):"<"_$$$FormatMessage(,"%Parser","EOS",,)_">",1:token),$g(moreinfo))
e2	q $$$FormatMessage(,"%Parser","e2",,)
e3	q $$$FormatMessage(,"%Parser","e3",,token)
e4	if '$d(op) q $$$FormatMessage(,"%Parser","e4a",,)
	q $$$FormatMessage(,"%Parser","e4b",,)
e5	q $$$FormatMessage(,"%Parser","e5",,)
e6	q $$$FormatMessage(,"%Parser","e6",,value)
e7	q $$$FormatMessage(,"%Parser","e7",,)
e8	q $$$FormatMessage(,"%Parser","e8",,$g(VALUE))
e9	q $$$FormatMessage(,"%Parser","e9",,$s($g(t)="":"UNION",1:t))
e10	q $$$FormatMessage(,"%Parser","e10",,)
e11	q $$$FormatMessage(,"%Parser","e11",,)
e12	q $$$FormatMessage(,"%Parser","e12",,)
e13	q $$$FormatMessage(,"%Parser","e13",,)
e14	q $$$FormatMessage(,"%Parser","e14",,)
e15	q $$$FormatMessage(,"%Parser","e15",,)
