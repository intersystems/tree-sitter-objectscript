e17	q $$$FormatMessage(,"%Parser","e17",,)
e18	q $$$FormatMessage(,"%Parser","e18",,)
e19	q $$$FormatMessage(,"%Parser","e19",,)
e20	q $$$FormatMessage(,"%Parser","e20",,$g(label))
e21	if $g($$$mtStatementType)="INS" q $$$FormatMessage(,"%Parser","e21a",,$p($$$mtV(val),"^",4))
	if $g($$$mtStatementType)="UPD" q $$$FormatMessage(,"%Parser","e21b",,$p($$$mtV(val),"^",4))
	q $$$FormatMessage(,"%Parser","e21c",,$p($$$mtV(val),"^",4))
e22	q $$$FormatMessage(,"%Parser","e22",,)
e23	q $$$FormatMessage(,"%Parser","e23",,label)
e24	q $$$FormatMessage(,"%Parser","e24",,value)
