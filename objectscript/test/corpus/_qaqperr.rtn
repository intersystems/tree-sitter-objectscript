e52	if new q $$$FormatMessage(,"%Parser","e52a",,$s($e(mcurs,*)="0":$e(mcurs,1,*-1),1:mcurs))
	q $$$FormatMessage(,"%Parser","e52b",,$s($e(mcurs,*)="0":$e(mcurs,1,*-1),1:mcurs))
e52c	q $$$FormatMessage(,"%Parser","e52c",,$s($e(mcurs,*)="0":$e(mcurs,1,*-1),1:mcurs),action,$lg(mtc(mcurs,"error"),1),$lg(mtc(mcurs,"error"),2))
e53	q $$$FormatMessage(,"%Parser","e53",,)
