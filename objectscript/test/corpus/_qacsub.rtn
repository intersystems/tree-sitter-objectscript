^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qacsub^MAC^^^0
%qacsub	// General Subroutinization Routine
	;; COMPONENTS :: SQL/Code Generation
	#;
#INCLUDE %msql
	#;
#DEFINE filelist(%a) %sqlcodegen("file-list",%substk,%a)
#DEFINE linesub(%a) $e(%a,1,100)
	#;
#IF 0   ;
	;---------------------------------------------------------------------
	; Description:   General subroutinization routine
	; Author:        Ricardo Garcia (RGG432)
	; Date:          
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;  AK828   (09/08/2011) - Use small integer subscripts for %xxxd()
	;  DPV3389 (04/07/2009) - Correct problem with #; comments inside of multi-line comments
	;  DPV3143 (05/06/2008) - Fix <PROTECT> error in subroutinizer
	;  DPV3131 (03/25/2008) - DD Lookup and Table compiler performance improvements
	;  DPV3123 (03/12/2008) - Use Merge instead of Set when defining ^rOBJ in %qacsub
	;  DPV3086 (12/18/2007) - Correct SIZE setting of routine after LinKing
	;  ATG002  (05/18/2007) - Fix <UNDEFINED> error.
	;  DPV2858 (03/05/2007) - Fix compilation of tables with no LinK lines
	;  STC1094 (10/28/2006) - Add routine change audit
	;  DPV2752 (10/10/2006) - Fix <LABELREDEF> error.  Don't call $$fits if not filing
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  DPV2069 (09/10/2003) - Don't new %msg in end so CompileTable can record error text
	;  DPV1477 (01/08/2001) - Use length of 100 instead of 200 for linesub macro.
	;                         Avoided <SUBSCRIPT> errors on Kanji systems.
	;  DPV1300 (05/03/2000) - Use $Compile, other cleanup
	;  DPV1217 (12/13/1999) - Fixed <UNDEFINED> in sizeit
	;  DPV1069 (05/24/1999) - Fix rtbytes UNDEFINED error during %RI
	;                         no compile but check syntax errors
	;  DPV821  (03/03/98)   - Enhance routine splitting - get closer to limit
	;  AK297   (11/05/97)   - Match all subroutine lines correctly
	;  DPV684  (09/30/96)   - Eliminate more duplicate tags
	;  DPV308  (11/21/94)   - Clean up routine
	;  RLL386  (12/20/93)   - avoid double line tags when passing in a tag
	;                         to $$subroutn and 1st line already has tag
	;  RLL376  (11/22/93)   - fix parsing of subroutine name when dealing
	;                         with ;;LinK line
	;  RLL374  (11/22/93)   - filetg should not file previously filed
	;                         subroutines if in same routine
	;  RLL348  (10/08/93)   - DTM performance improvements ZINSERT/ZSAVE
	;  RLL262  (04/14/93)   - back out $name call for DSM
	;  RLL247  (03/02/93)   - replace all quoted instances $j with $name for
	;                         intervendor portability ($j with string values)
	;  RLL235  (01/27/93)   - support multi-character rtchar
	;
	;---------------------------------------------------------------------
	;                     I N F O R M A T I O N
	;---------------------------------------------------------------------
	;
	;
	; If the tag is not passed in, it's parsed out from the first line of
	; code. If no tag passed in, and no tag parsed out then assign fake
	; tag.
	; The values of flag are:
	;    1. File with the next file request
	;    2. NOT USED Link to an existing subroutine, or file at next file request
	;    3. NOT USED File at next file request, or expand and file in the future
	;    4. NOT USED File a previously requested (or filed subroutine) with the
	;       next file request, if this subroutine was not previously
	;       submitted return null (RGG594)
	;
	;---------------------------------------------------------------------
#ENDIF   ;
	$$$Abort  ; Not an Entry Point!!
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
subroutn(ref,tag,flag=0,%noObjCompile=0) ; Request filing of subroutine
		#; Called from %qaqcasl, %qaqcdt, %qaqcky, %qaqcmn, %qaqcpr
		#; flag is 0 (<UNDEFINED>) from all locations except comd^%qaqcpr where it is 1
		#; %noObjCompile is always 1 (as of 2012.2, changing code to reflect that DPV3943)
.
	new i,j,k,d,line,lineold,linetag,notag,ref1,size
	set i="",tag=$g(tag),notag=(tag="")
	QUIT:ref="" ""
	for  set i=$o(@ref@(i),1,line) quit:i=""  quit:tag'=""  quit:$s($e(line)?1an:1,"%("[$e(line):1,1:0)
	set:i=""&&(tag="") i=$o(@ref@(i))
	QUIT:i="" ""  ; no-subroutine
	set linetag=i
	set line=@ref@(i) set:line="" line=" "
	if tag=""," ("'[$e(line) {
		for j=1:1 {
			set tag=$p(line," ",1,j) 
			if $l(tag,"""")#2 { set line=$e("(",tag["(")_$p(tag,"(",2,*)_" "_$p(line," ",j+1,*),tag=$p(tag,"(") set @ref@(i)=line quit  }
		}
	}
		#; tag undefined assign a random tagname
	set:tag="" tag=" " goto:'$d(%sqlcodegen("code",$$$linesub(line))) subnew
	set j="" 
	for  {
		set j=$o(%sqlcodegen("code",$$$linesub(line),j)) quit:j=""
		set k="" for i=1:1 { set k=$o(@ref@(k),1,d) quit:k=""  quit:$g(%sqlcodegen("sub",j,"mac",i))'=d  }
		quit:k=""&&('$d(%sqlcodegen("sub",j,"mac",i)))
	}
	GOTO:j="" subnew
	set tag=j
found	set j=$g(%sqlcodegen("sub",tag)),size=$p(j,$c(1))
		#; case1 subroutine exists and not filed yet (has no routine)
		#; If called from top of %qarmac, everything is going in this routine, just return the tag.
	QUIT:$g(%ccall)="%qarmac" tag
	set $$$filelist(tag)=size_$c(1)_0
	set:notag @ref@(linetag)=tag_@ref@(linetag)
	set:'$d(%sqltags(%substk,tag)) %sqltags(%substk,tag)=2  ;  used by another statement // AK828
	QUIT tag ; to indicate that already there
.
subnew	; new subroutine
		#; Assign a unique tagname if already another one with different code
	new coderef,d,tag1
	set tag1=$p(@ref@(1)," ") set:tag1["(" tag1=$p(tag1,"(")
	if $s(tag=" ":1,$d(%sqlcodegen("sub",tag)):1,1:0) set:tag=" " notag=0 set tag=$$random(tag)
	set %sqlcodegen("code",$$$linesub(line),tag)=""
	if " "'[tag1,tag1=tag set (line,@ref@(1))=$p(@ref@(1),tag1,2,*)
	set k=""
	for i=1:1 set k=$o(@ref@(k),1,d) quit:k=""   set %sqlcodegen("sub",tag,"mac",i)=d
		#; INSERT tag into tag line
	set (line,lineold)=%sqlcodegen("sub",tag,"mac",linetag)
	set line=tag_line
	set %sqlcodegen("sub",tag,"mac",linetag)=line,coderef=$$compcode($na(%sqlcodegen("sub",tag,"mac")))
	if coderef="" {
		set k=$o(%sqlcodegen("sub",tag,"mac",""),-1) 
		for i=1:1:k set %sqlcodegen("sub",tag,"int",i)=%sqlcodegen("sub",tag,"mac",i)
	}
	else {
		set k="",ref1=coderef,d=""
		for i=1:1 set k=$o(@ref1@(k),1,d) quit:k=""  set %sqlcodegen("sub",tag,"int",i)=d
		k @ref1
	}
		#; REMOVE tag from first line
	set %sqlcodegen("sub",tag,"mac",linetag)=lineold
	set %sqlcodegen("sub",tag)=0_$c(1)_0_$c(1)_linetag
	set $$$filelist(tag)=coderef_$c(1)_0
	set:notag @ref@(linetag)=tag_@ref@(linetag)
	set %sqltags(%substk,tag)=0  ;  not (yet) used by another statement // AK828
	QUIT tag
.
.
file(ref,action="",rtfile,errflag) ;
		#;
		#; entry point to file the subroutines created so-far
		#;
		#; This part of the code will take care of filing the source requested
		#; and all of the subroutines requested so-far, unless the action var
		#; indicates otherwise.
		#;
		#;  action is either "" or "int-only-=-no-filing" (DPV2752)
		#;     as of now (2012.2), action is always "int-only-=-no-filing", changing the code to reflect that (DPV3943)
		#;
		#; Called from %qaqqt, %qarmac
		#;
.
	new d,data,i,j,k,line,lineold,linetag,ref1,coderef,tag,%ISCSQLDEBUG
	kill %sqlcodegen("file",%substk,"mac"),%sqlcodegen("file",%substk,"int")
	set k=$o(@ref@(""),1,d)
	if k'="" { 
		set line=d,%sqlcodegen("file",%substk,"mac",1)=line
		for i=2:1 { set k=$o(@ref@(k),1,d) quit:k=""   set %sqlcodegen("file",%substk,"mac",i)=d }
	}
	set errflag=$g(errflag)
	set coderef=$$compcode($na(%sqlcodegen("file",%substk,"mac")),.errflag)
	if coderef="" {
		set k="" 
		for i=1:1 { set k=$o(@ref@(k),1,d) quit:k=""  set %sqlcodegen("file",%substk,"int",i)=d }
	}
	else {
		set k="",ref1=coderef
		for i=1:1 set k=$o(@ref1@(k),1,d) quit:k=""  set %sqlcodegen("file",%substk,"int",i)=d
		kill @ref1
	}
	kill $$$sqlineitself
		#; file all of the defined tags
	set tag="" 
	for  set tag=$o(%sqlcodegen("file-list",%substk,tag)) quit:tag=""  do filetg
	set i=$o(%sqlcodegen("file",%substk,"int",""),-1),k=$o($$$sqline(1,""),-1)
	for i=k+1:1:k+i do setline^%qaqcasl(1,i,%sqlcodegen("file",%substk,"int",i-k))
	kill %sqlcodegen("file-list",%substk)
	QUIT
.
.
compcode(ref1,errflag)	;
	  #; Entry point returns byte cnt estimate of an array of lines
	  #; returns reference to output code
	new d,emsgs,errflag,ref2,ref,x
	new:'$d(success) success
	QUIT:'$d(@ref1) ""  ;  No code
	  #;
	  #;---See how much code we are adding and decide whether to split rtn:
	  #;
	set tagchar=$$incrt(tagchar)
	set ref2=$na(%sqlcodegen2(+$g(%substk),1)),errflag=$g(errflag)
	if '$d(wrtref) new wrtref set wrtref="emsgs"
	  #;  Compile the MAC lines to INT
	do LINES^%qarmac(ref1,ref2,.tagchar,0,.errflag,$g(nosyntax),wrtref,2,.embedtags,.%symtab,,,$g(rtname),,.qstruct,,,.success,$g(%caller),.methodstoadd)	// DPV1897= (.%symtab)	// DPV2162 (qstruct)	// DPV3968 (.success)
	  #;  Check for errors
	if $d(emsgs) {
		new etext,x set etext="" 
		for i=1:1:emsgs(0) {
				if $zstrip(emsgs(i),"<W")'="" {
					set x=$s($d(rtname):rtname_".MAC  ",1:"")_emsgs(i)
					if %display=2 w !,x
					set:($l(etext)+$l(x)+2)'>($$$MaxStringLength-100) etext=etext_$c(13,10)_x
				}
			}
		set %ok=0_$c(1)_$s($g(tag)'="":"Compiling tag '"_tag_"'  ",1:"")_etext
		ztrap  	// Should go back to error^%ocsSQLRTDict2 or the caller's error trap
	}
	if '$d(@ref2) {
		ztrap:$ze["INTERRUPT" $ze
		if $g(err)'="" { set %ok=0_$c(1)_$s($g(tag)'="":"Compiling tag '"_tag_"'  ",1:"")_err kill err }
		elseIf $ze'="" { set %ok=0_$c(1)_$s($g(tag)'="":"Compiling tag '"_tag_"'  ",1:"")_" Unexpected error:  "_$ze }
		ztrap
	}
	kill @ref2@(0) // remove line count node
	QUIT $g(ref2)
 
 
filetg	; file tags
		#;
		#; Considerations when filing subroutines:
		#;   
		#; 1. New Link that has already been filed as a subroutine
		#; 2. Previously defined as a link but being filed NOW
		#; 3. None of the above
		#;
	if $d(%sqlcodegen("sub",tag,"r",0)) quit:%sqlcodegen("sub",tag,"r",0)=$g(rtfile)
	set data=%sqlcodegen("sub",tag),linetag=$p(data,$c(1),3),data=$p(data,$c(1))
		#; ADD tag to first line of subroutine - NOTE naked on left hand side
	set (line,lineold)=%sqlcodegen("sub",tag,"mac",linetag)
	set line=tag_line
	set %sqlcodegen(linetag)=line
	set i=$o(%sqlcodegen("sub",tag,"int",""),-1),k=$o($$$sqline(1,""),-1)
	for i=k+1:1:k+i do setline^%qaqcasl(1,i,%sqlcodegen("sub",tag,"int",i-k))
	  #; REMOVE tag from first line
	set %sqlcodegen("sub",tag,"mac",linetag)=lineold
	set %sqlcodegen("sub",tag,"r",0)=""
	QUIT
.
.
open	; Called from %qadcpt, %qaqqt, %qarmac
	set %substk=$g(%substk)+1  ;  assign a new stack number
	kill %sqltags(%substk)  ;  shouldn't have to do this // AK828=
	QUIT
.
close	;  Called from %qadcpt, %qaqqt, %qarmac
		#; AK828+
	new tag,inuse,level set tag=""  ;  notify upper levels of tags we're using
	for  set tag=$o(%sqltags(%substk,tag),1,inuse) quit:tag=""  if inuse=2 for level=%substk-1:-1:1 set:$d(%sqltags(level,tag),inuse)&&(inuse=0) %sqltags(tag)=1
	kill %sqltags(%substk)
		#; AK828-
	set %substk=$g(%substk)-1  ;  decrement stack number
	QUIT
.
start	;   when opening up filing for subroutinization expect as input:
	#;
	#;  initialize: tagchar  (tag character)
	#;
	#; Called from:  %R, %occRoutine, %qadcpt
	#;
	#;   #; This next line is also in 1+5^%qarmac - avoids a routine call - if editing, edit it there also
	kill %sqlcodegen
	set tagchar="A"
	QUIT
.
end	; end the subroutinization and filing here
		#; Called from %R, %occRoutine, %qadcpt, %qarmac
	kill tagchar,%sqlcodegen,%substk
	QUIT
 
random(tag) ; if a tag already exists assign a random tag, starting by
	new i,j,k,l,tagor,tagtmp 
	set:$g(tag)="" tag=" "
	set k=$d(%sqlcodegen("sub",tag))
	set:tag=" " tag=""
	if 'k,tag'="" QUIT tag
	if $l(tag)>31 set tag=$e(tag,1,31) do randadd1 QUIT:'$d(%sqlcodegen("sub",tag)) tag set tag=$e(tag,1,31)
randmtg	set tagor=tag,l=0
randmlp	do randadd1 QUIT:'$d(%sqlcodegen("sub",tag)) tag if $l(tag)=31 do randlvl
randmlp1	set l=l+1,k(l)=$$nxtchr($g(k(l))) 
	if k(l) set tag=tag_$c(k(l)) goto randmlp
	set l=l-1
	if 'l,$l(tagor)>0 set tag=$e(tagor,1,*-1) goto randmtg
	QUIT:'l ""
	do randlvl
	goto randmlp1
randlvl	set k(l)=$a($e(tag),$l(tagor)+l),tag=$e(tag,1,$l(tagor)+l-1),l=l-1 QUIT
randadd1	for j=48:1:57,65:1:90,97:1:122 set tagtmp=tag_$c(j) if '$d(%sqlcodegen("sub",tagtmp)) set tag=tagtmp quit
	QUIT
nxtchr(k) s k=k+1,k=$s(k<48:48,k>57&(k<65):65,k>90&(k<97):97,k>122:0,1:k) QUIT k
.
.
incrt(t) [] PRIVATE {  // this routine generates nextchars for unique tags
	   QUIT:t="" "A"
	   set s="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijklmnopqrstuvwxyz",l=$l(t),x=$e(t,l)
	   if x="z" set x="",t=$$incrt($e(t,1,l-1))_"A",l=$l(t) set:$e(t)'?1a t="a"_$e(t,2,8)
	   QUIT $e(t,1,l-1)_$e(s,$f(s,x))
}
