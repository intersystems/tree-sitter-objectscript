====
qaqpreparser
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpreparser^MAC^^^0
%qaqpreparser	;
	;; COMPONENTS :: SQL/Parser
	#;
#include %msql
.
#DEFINE %KeywordOptionsSELECT "%DORUNTIME,%NOFPLAN,%NOLOCK,%NORUNTIME,%PROFILE,%PROFILE_ALL,%PROFILE_NONE,%ROWLIMIT,%ROWOFFSET"
#DEFINE %KeywordOptionsINSERT "%DORUNTIME,%NOCHECK,%NOFPLAN,%NOINDEX,%NOJOURN,%NOLOCK,%NORUNTIME,%NOSTREAM,%NOTRIGGER,%OBJECTFILER,%PROFILE,%PROFILE_ALL,%PROFILE_NONE,%USECHECKVARIABLE"
#DEFINE %KeywordOptionsUPDATE "%DORUNTIME,%ILOCK,%NOCHECK,%NOFPLAN,%NOINDEX,%NOJOURN,%NOLOCK,%NORUNTIME,%NOSTREAM,%NOTRIGGER,%OBJECTFILER,%PROFILE,%PROFILE_ALL,%PROFILE_NONE,%USECHECKVARIABLE"
#DEFINE %KeywordOptionsDELETE "%DORUNTIME,%NOCHECK,%NOFPLAN,%NOINDEX,%NOJOURN,%NOLOCK,%NORUNTIME,%NOSTREAM,%NOTRIGGER,%OBJECTFILER,%PROFILE,%PROFILE_ALL,%PROFILE_NONE,%USECHECKVARIABLE"
#DEFINE %KeywordOptionsALL "%DORUNTIME,%ILOCK,%NOCHECK,%NOFPLAN,%NOINDEX,%NOJOURN,%NOLOCK,%NORUNTIME,%NOSTREAM,%NOTRIGGER,%OBJECTFILER,%PROFILE,%PROFILE_ALL,%PROFILE_NONE,%ROWLIMIT,%ROWOFFSET,%USECHECKVARIABLE"
.
	#; MRP861
preparse(input,intovar=0,hcLnBrkChar="",cursorname="",type,currentof,foundinto,caller,pProfile=0,pkwOption,%compOptions,explainStmt=0,actions="") [backgrnd,begline,begtoken,c,callname,endline,endtoken,f,fsave,hcLnBrkChar,indexline,input,insdt,label,line,lineprev,logic,lower,m,mask,maybeCOS,maybePython,more,n,name,p,pprev,prevtoken,qr,rv,sql,SQLCODE,token,tt,val,value,usingFound] PUBLIC {
	#;------------------------------------------------------------------------------
	#; Sample Input:
	#; s input(1) = """aviel"" aviel.sas :vv from a"
	#; s input(2)="where f=4 and z=? order by 2 ff"
	#; s input=2
	#; intovar = 1 means do not replace :vars in the INTO list of a SELECT statement.
	#;           this is called with 1 from the prepare for a ShowPlan.  A ShowPlan may have been called from the SMP with an INTO clause.
	#;         = 2 It does not replace constants and for other variables
	#;           it does not replace public variables as these can still be directly referenced, for these it returns $lb("p","publicvar") with
	#;           the 'p' indicating this is a public variable that is not replaced. For a complex variable like i%IVAR it will replace these with
	#;           sqltmp1, sqltmp2 etc. so using a name that should not collide with customer variables
	#; hcLnBrkChar : An optional delimiter (e.g. $c(10) [LF] OR $c(13,10) [CRLF]) that is used during
	#;               SQL Parsing/Lexical Analysis to check for a line-break character within the lines
	#;               of a <sql statement>. This parameter represents the SQL Hyphen-Comment (-- comment)
	#;               line-break character used to delineate SQL Hyphen-Comments from the
	#;               remaining lines of a <sql statement>
	#; cursorname : Returned by reference if the statement references a cursor and "" otherwise
	#; type       : output variable returning the type of the statement
	#; currentof  : Returned by reference, true is WHERE CURRENT OF query and false otherwise
	#; foundinto  : Returned by reference, true if we found INTO and false otherwise
	#; caller     : from %qarmac the name of the routine/class we are processing e.g. A.RTN or User.Class.CLS
	#; pProfile   : Returned by reference: One of the following values to indicate if the 
	#;              Percent Profile Directive (PPD) %PROFILE[_ALL] is found within the given
	#;              SQL Statement 'input'.
	#;              This value is used by the PTools application to set the 'SQLStats-flag':
	#;                -1 = %PROFILE_NONE directive found
	#;                 0 = No %PROFILE[_ALL] directive found    [DEFAULT]
	#;                 2 = %PROFILE directive found
	#;                 3 = %PROFILE_ALL directive found
	#; pkwOption  : Returned by reference: If passed a value of 1, return an array of 
	#;              Percent-KeyWord Options/Directives (PKWO/PKWD) found during the
	#;              parsing of the given SQL Statement 'input'. 
	#;                  The 'pkwOption(...)' array has the following structure:
	#;                     pkwOption(0)=# of %Keyword Options found
	#;                     pkwOption(n)=%Keyword Option  (e.g. { <select option> | <insert option> | <update Option> | <delete option> })
	#;                     pkwOption(n,"vspec")=$LIST(<val spec>s)  // %Keyword Option <val spec> List (e.g. %ROWOFFSET <val spec>)
	#;                     NOTE: If the <val spec> being recorded is a <host var>
	#;                           (e.g. :var OR ?), then the value recorded here will be
	#;                           ":"_($LL(rv)+1), where the number after the colon represents
	#;                           the position within the Replaced Variable sub-$LIST (rv),
	#;                           which is the 2nd piece of the $LIST returned by this method.
	#;
	#;              The %Keyword Options can be found within the following SQL Statements,
	#;              as of 04 May 2020 (These lists may change in the future):
	#;                 <selex> ::= SELECT <selst> [ <from> ]
	#;                   <selst> ::=  {<select options>} [<dist>] [TOP <top spec> ]<select list> <targt>
	#;                     <select option> ::= [%DORUNTIME | %NOFPLAN | %NOLOCK| %NORUNTIME | %PROFILE | %PROFILE_ALL |
	#;                                          %PROFILE_NONE | %ROWLIMIT <val spec> | %ROWOFFSET <val spec>]
	#;
	#;                 <insrt> ::= INSERT {<insert option>} [ INTO ] <iud_target> <asign>
	#;                   <insert option> ::= %DORUNTIME | %NOCHECK | %NOFPLAN | %NOINDEX | %NOJOURN | %NOLOCK | 
	#;                                       %NORUNTIME | %NOSTREAM | %NOTRIGGER | %OBJECTFILER | %PROFILE |
	#;                                       %PROFILE_ALL | %PROFILE_NONE |%USECHECKVARIABLE
	#;
	#;                 <updt> ::= UPDATE {<update option>} [ INTO ] <iud_target> <asign>
	#;                   <update Option> ::= <insert option> | %ILOCK
	#;
	#;                 <delet> ::= DELETE {<delete option>} [ FROM ] <iud_target> [<from>] [WHERE <werop>]
	#;                   <delete option> ::= <insert option>
	#;
	#;              NOTE:
	#;                    1. This parameter is only returned as an array if it is passed
	#;                       into this method as the value of one (pkwOption=1).  This is
	#;                       done specifically to optimize the preparsing process, as the 
	#;                       %Keyword Options will not be parsed and returned otherwise:
	#;                          set pkwOption=1 // Return Percent-KeyWord Options
	#;                          set pp=$$preparse(.sql,,,,,,,,,.pkwOption)
	#;                    2. The following %Keywords cannot be used in conjunction in a
	#;                       SQL Query: %DORUNTIME %NORUNTIME
	#; %compOptions : Returned by reference, list of comment options
	#; explainStmt  : Returned by reference, true (1) if the SQL Statement (input) is      // MRP1267
	#;                an EXPLAIN Statement and false (0) otherwise
	#; actions      : A $LIST(...) or comma-delimited list of the actions to perform
	#;                during the 'preparse(...)' invocation:
	#;                   1 - Only return the PBR parameter 'type' parameter once it is determined
	#;                   2 - Only return the PBR parameter 'explainStmt' parameter once it is determined
	#;
	#;                NOTE: Once all action(s) are processed, stop the invocation of
	#;                      this method and return the following: $LB(input,"","")
	#;
	#; variable:
	#;	qr - quote replace, boolean.  1 means replace literals, 0 means do not replace literals
	#;      insdt - inside datatype, integer, Current count of '(' in datatype expression.  >0 means we are inside a datatype argument, like VARCHAR(20), NUMERIC( (10) , (2) ), don't replace literals in a datatype argument.
	#;  JMM1049: %BrokerShardOp needs to strip comments but not perform any literal substitution.  It sets $SNNoQR=1,
	#;      which causes all logic that depends on the variable qr to behave as if qr=0.
	#;    
	#; RETURN Value: A $LIST() with the following pieces of information:
	#;                  1) res      - Preparsed 'input' string
	#;                  2) rv       - $LIST() Replaced Variable Info
	#;                  3) public   - $LIST() Host Variable Info
	#;------------------------------------------------------------------------------
.
#define QR $case(+$g(%SNNoQR),1:0,:qr)
.
	new backgrnd,begline,begtoken,c,callname,%compTags,endline,endtoken,f,fsave,%inMLComment,indexline,insdt,label,line,lineprev,logic,lower,m,mask,maybeCOS,maybePython,more,n,name,p,pprev,prevtoken,qr,rv,sql,token,tt,val,value,usingFound
	new %context,%COSParse,%delid,%macroMode,%mmmJSONOBJECT,%PythonParse
	s delidchk=+$get(%mmmNoDelidCheck) new %mmmNoDelidCheck set %mmmNoDelidCheck=delidchk
	set:'$LV(actions) actions=$LFS(actions)
	set %macroMode=1  // Enable $$$MACRO parsing!
	kill %compOptions set %compOptions=0,%compTags=0
	set currentof=0
	set foundinto=0,public="",type=""
	set:$d(%sqlHVarTypes2) %sqlHVarTypes2("typelist")=""
	set pProfile=0 // DEFAULT: 0 = No %PROFILE[_ALL] directive found
	set skipLit="" // This variable will keep track of literals for which we want to skip replacement with "?" 
	try {
		set line=0,more=0,f=0,p=0,callname="info",sql=input,backgrnd=1,%context=$system.Context.SQLCompile(),%delid=%context.DelimitedIdentifiers
		set tt=0
		do first:'input
		set oldmask=$get(mask)
		do lext
		if token=$c(1) { set tReturn=$lb(input,"","") quit  }
		while token="(" { // for the query starts with (: ( select * from tab )
			set tt=tt+1,tt(tt)=$lb(token,lower,value,%delid,$s("'"""'[$e(sql,f):1,1:0))
			do lext
		}
		set tt=tt+1,tt(tt)=$lb(token,lower,value,%delid,$s("'"""'[$e(sql,f):1,1:0))
		set maybeCOS=0,maybePython=0
		if $case(token,"CREATE":1,"ALTER":1,"GRANT":1,"REVOKE":1,"DROP":1,"SET":1,:0) {
			new %mmmNo28Check set %mmmNo28Check=1
			set %mmmNoDelidCheck=1
			set:token="CREATE" maybeCOS=1,maybePython=1
		}
		set type=token,typeOrig=type,typeOrigVal=$g(value),typeTT=tt
		set select=$case(token,"SELECT":1,"DECLARE":1,:0)
		set into=0,bracket=0,usingFound=0
		set create=(token="CREATE"),alter=(token="ALTER")
		if token="ID",value="TRAIN" { set train=1 new %mmmNoDelidCheck set %mmmNoDelidCheck=1 } else { set train=0 }
		if token="ID",value="LOAD" { set load=1 new %mmmNoDelidCheck set %mmmNoDelidCheck=1 } else { set load=0 }
		for  {
			if token="ID",value="JSON_OBJECT",'$d(%mmmJSONOBJECT) { set %mmmJSONOBJECT=1,jsonParen=0 }
			if (train||create||alter||load) && (token="USING") && ('$d(%mmmJSONOBJECT)) { set %mmmJSONOBJECT=1,jsonParen=0,jsonCBrace=0,%delid=1,usingFound=1 }
			do lext
			quit:token=$c(1)
			
			if $d(%mmmJSONOBJECT) {
				if '((train||create||alter||load) && usingFound) {	// USING <json> is the last clause of CREATE and TRAIN, and there should be no parenthesis
					set:token="(" jsonParen=jsonParen+1
					set:token=")" jsonParen=jsonParen-1
					kill:jsonParen=0 %mmmJSONOBJECT
				} else {
					set:token="{" jsonCBrace=jsonCBrace+1
					set:token="}" jsonCBrace=jsonCBrace-1
					kill:jsonCBrace=0 %mmmJSONOBJECT
				}
			}
			if intovar=2 {
				if token="INTO",select||(type="FETCH"),'foundinto,bracket=0 set into=1,foundinto=1 set %mmmNoDelidCheck=1  ; So we can support INTO :p("a.b")
				if $$isEndOfInto(into),bracket=0 { set into=0,%mmmNoDelidCheck=delidchk }
				if token="VALUES"||(token="WHERE"),type="INSERT"||(type="UPDATE")||(type="DELETE")||(select),bracket=0 { set into=1,%mmmNoDelidCheck=1 } ; So we can support VALUES (:p("a.b"))
				if token="(",into,$i(bracket)
				if token=")",into,$i(bracket,-1)
			}
			set tt=tt+1,tt(tt)=$lb(token,lower,value,%delid,$s("'"""[$e(sql,f):1,1:0))
			set:maybeCOS&&(token="ID")&&((value="OBJECTSCRIPT")||(value="COS")||(value="COMPUTECODE")) %COSParse=1,mask=$$MASK(sql)_$c(1)  // Reset mask for COS parser so "$", ":", "'", """" are included in mask
			set:maybePython&&(token="ID")&&((value="PYTHON")) %PythonParse=1,mask=$$MASK(sql)_$c(1)  		// Reset mask for Python parser so "$", ":", "'", """" are included in mask
		}
		// --- Determine the Correct SQL Statement Type ---
	 	do GetTypen^%SYS.SQLSRV(0,.sqlStmtTypes)
		set sqlStmtTypes="~"_sqlStmtTypes_"TRUNCATE TABLE~"  // Add missing <sql statememt type> values!
		set type="",typeTokens=0
		for typeOffset=0,1,2 { // --- Determine if it's a single/multi-token SQL Statement Type: Search for the longest match-able SQL Statement 'type' ---
			set type=type_$s(typeOffset:" ",1:"")_$LG($g(tt(typeTT+typeOffset)),3)
			set:sqlStmtTypes[("~"_type_"~") typeTokens=typeOffset+1
		}
		if typeTokens { set type=$p(type," ",1,typeTokens) } // SQL Statement Type Found!
		else { set type=$s(typeOrig="ID":$s(sqlStmtTypes[("~"_typeOrigVal):typeOrigVal,1:""),1:typeOrig) } // Possibly a Minor SQL Statement (e.g. OPEN, FETCH, CLOSE, etc) OR INVALID!
		set actionsPos=$LF(actions,1)
		if actionsPos,type'="WITH" { // --- Process 'actions' #1 ---
			set actions=$LIST(actions,1,actionsPos-1)_$LIST(actions,actionsPos+1,*)
			RETURN:actions="" $LB(input,"","")  // All 'actions' completed, so stop processing!
		}
 		
		kill:$lg(tt(tt),1)=";" tt($i(tt,-1)+1) // remove trailing semicolon
		if $get(%COSParse) { kill %COSParse set mask=oldmask }
		elseif $get(%PythonParse) { kill %PythonParse set mask=oldmask }
		set res="",qr=1,rv="",token=$li(tt(1))
		if tt>0,($case(token,"CREATE":1,"ALTER":1,"GRANT":1,"REVOKE":1,"DROP":1,"SET":1,:0))||($case($lg(tt(1),3),"LOCK":1,"TUNE":1,"COLLECT":1,"TRAIN":1,"VALIDATE":1,"LOAD":1,"PURGE":1,"FREEZE":1,"UNFREEZE":1,"EXPLAIN":1,"CANCEL":1,"THROUGH":1,:0)) {	// DPV2204 (SET), LOCK looked for in piece 3 since LOCK is not reserved.
			if $LG(tt(1),3)="EXPLAIN" { // --- EXPLAIN Statement Found ---
				set explainStmt=1
				set actionsPos=$LF(actions,2)
				if actionsPos { // --- Process 'actions' #2 ---
					set actions=$LIST(actions,1,actionsPos-1)_$LIST(actions,actionsPos+1,*)
					RETURN:actions="" $LB(input,"","")  // All 'actions' completed, so stop processing!
				}
			}
			if 'input { set res=input,tReturn=$lb(res,"","") quit  }
			for i=1:1:input { set res=res_$c(13,10)_input(i) }	// DPV2269 ($c(13,10) instead of " "
			set tReturn=$lb(res,"","")
			quit
		}
		set afterOrder=0,inOver=0,bracket=0,foundinto=0,getcursor=0,cteInfo=0,insdt=0,into=0,obp=0,pkwOptionParse=0,pkwOptionParseStart=0,pkwSpecs=0,pkwSpecsParen=0,round=0,sqlType=type,vectorFunctionAfterOrder=0,vfp=0
 		set pkwOptionParseStart=$CASE(sqlType,"DECLARE":6,:2) // Position of first %Keyword Option
		for i=1:1:tt { // --- Process All Tokens in the 'tt(n)' Array ---
			set ttval=tt(i),$LG(token,lower,value,,qconst)=ttval
			if cteInfo,$g(cteInfo("sql stmt")),token'="(" { // --- Processing a CTE Statement's Main <sql statement> ---
 				set type=token  // Correct <sql statement> type!
				set actionsPos=$LF(actions,1)
				if actionsPos { // --- Process 'actions' #1 ---
					set actions=$LIST(actions,1,actionsPos-1)_$LIST(actions,actionsPos+1,*)
					RETURN:actions="" $LB(input,"","")  // All 'actions' completed, so stop processing!
				}
				set cteInfo=0  // Stop Processing CTE!
			}
			set:pkwOptionParse'<0 pkw=$s((token="ID")&&($e(value)="%"):value,"%(?)"[$e(token):token,pkwSpecs:value,1:""),pkwCont=0
			set:(i=pkwOptionParseStart)&&(pkw'="") pkwOptionParse=1+($g(pkwOption)>0)
			if pkwOptionParse=1 { // --- Quick Process %Keyword Options ---
				if pkw="%PROFILE" { set pProfile=2,res=res_" "_pkw CONTINUE }
				if pkw="%PROFILE_ALL" { set pProfile=3,res=res_" "_pkw CONTINUE }
				if pkw="%PROFILE_NONE" { set pProfile=-1,res=res_" "_pkw CONTINUE }
				if (pkw="%ROWLIMIT")||(pkw="%ROWOFFSET") { set pkwSpecs=1,res=res_" "_pkw CONTINUE }
				if pkwSpecs { // --- Process %Keyword <val spec>s ---
					set pkwSpecsParen=pkwSpecsParen+$CASE(token,"(":1,")":-1,:0) // Count paren tokens { ( | ) }
					set:'pkwSpecsParen pkwSpecs=pkwSpecs-1 set pkwCont=1
				}
				if (","_$$$%KeywordOptionsALL_",")[(","_pkw_",") { set res=res_" "_pkw CONTINUE } // Quickly process Well-Defined %Keyword Options
.
				set:'pkwCont pkwOptionParse=-1  // Finished processing All %Keyword Options
			}
			elseif pkwOptionParse=2 { // --- Process All %Keyword Options ---
				if ",SELECT,DECLARE,"[(","_sqlType_",") { // --- Process <select option>s ---
					if pkw="%DORUNTIME" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%NOFPLAN" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%NOLOCK" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%NORUNTIME" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%PROFILE" { set pProfile=2,pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%PROFILE_ALL" { set pProfile=3,pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%PROFILE_NONE" { set pProfile=-1,pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if (pkw="%ROWLIMIT")||(pkw="%ROWOFFSET") { set pkwSpecs=1,pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkwSpecs { // --- Process %Keyword <val spec>s ---
						set pkwSpecsParen=pkwSpecsParen+$CASE(token,"(":1,")":-1,:0) // Count paren tokens { ( | ) }
						set:'pkwSpecsParen pkwSpecs=pkwSpecs-1 set pkwCont=1
						// --- Record <literal> OR <host var> (token = { : | ? }) Value ---
						set:"()"'[pkw $LIST(pkwOption(pkwOption(0),"vspec"),*+1)=$s(token=9:pkw,1:":"_($LL(rv)+1))
					}
				}
				elseif ",INSERT,UPDATE,DELETE,"[(","_sqlType_",") { // --- Process <insert option>s | <update Option>s | <delete option>s ---
					if pkw="%DORUNTIME" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if (pkw="%ILOCK")&&(sqlType="UPDATE") { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%NOCHECK" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%NOFPLAN" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%NOINDEX" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%NOJOURN" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%NOLOCK" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%NORUNTIME" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if (pkw="%NOSTREAM")&&(",INSERT,UPDATE,"[(","_sqlType_",")) { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%NOTRIGGER" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%OBJECTFILER" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%PROFILE" { set pProfile=2,pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%PROFILE_ALL" { set pProfile=3,pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					if pkw="%PROFILE_NONE" { set pProfile=-1,pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
					#; --- %USECHECK is internally used by the SQL filer.  It means to simply pass the %check variable along and use those settings. ---
					#; --- This allows us to retain settings for nested filer calls, like when the filer deletes all the child rows in the table ---
					if pkw="%USECHECKVARIABLE" { set pkwOption($i(pkwOption(0)))=pkw,res=res_" "_pkw CONTINUE }
				}
				set:'pkwCont pkwOptionParse=-1  // Finished processing All %Keyword Options
			}
			if token="ID" {
				if getcursor set cursorname=lower
				if $case(value,"ROUND":1,"TRUNCATE":1,:0) { set round=round+1,round(round)=0 }
				elseif ",DATEADD,DATEDIFF,DATENAME,DATEPART,DATE_TRUNC,"[(","_value_","),$li($g(tt(i+2)),1)=9 { set res=res_" "_value_" ( '"_$li(tt(i+2),3)_"'",i=i+2 continue }	// Don't replace the date part argument of some SQL date/time functions if it is a literal
				elseif value="JSON_TABLE" { if $li($g(tt(i+1)),1)="(" { set jsontable=0,qr=0 }}
				elseif value="JSON_OBJECT",'$d(jsonobject),$li($g(tt(i+1)),1)="(" { set jsonobject=0,qr=0 }
				elseif $case(value,"TIMESTAMPADD":1,"TIMESTAMPDIFF":1,:0),$lg(tt(i-1),3)="FN" { set res=res_" "_value_" ( "_$li(tt(i+2),3),i=i+2 continue }	// Don't replace first argument to { fn TIMESTAMP*(x,y,z) }
				elseif value="EXPLAIN",type="DECLARE",i=5 { // --- EXPLAIN Statement Found ---
					set res=res_" "_lower,explain=1,explainOpt=1,explainInto=1,explainStmt=1
					set actionsPos=$LF(actions,2)
					if actionsPos { // --- Process 'actions' #2 ---
						set actions=$LIST(actions,1,actionsPos-1)_$LIST(actions,actionsPos+1,*)
						RETURN:actions="" $LB(input,"","")  // All 'actions' completed, so stop processing!
					}
					CONTINUE
				}
				elseif ",TO_CHAR,TO_DATE,TO_POSIXTIME,TO_TIMESTAMP,"[(","_value_",") { // find the second argument and keep it in 'skipLit'
					set parenCnt=0
					for ttPos=i+2:1:tt { // --- Loop through 'tt(ttPos)' until we find the second argument of the SQL function ---
						CONTINUE:$CASE($LG(tt(ttPos)),"(":$i(parenCnt),")":$i(parenCnt,-1),:parenCnt) // Skip until: 'parenCnt
						if $LG(tt(ttPos))=",",$LG(tt(ttPos+1))="9" {
							set skipLit=skipLit_$LB(ttPos+1)
						}
					}
				}
			}
			if $g(explain) { // --- Process <explain> Statement ---                        // MRP1267 // MRP1329
				#; <explain statement>     ::= <explain>
				#; <explain>               ::= EXPLAIN [ <explain option list> ] [ INTO <param> ] <explain sql statement>
				#; <explain sql statement> ::= { <selct> | <with clause> | <updat> | <delet> }
				#;   -- <selct> denotes the SELECT Statement
				#;   -- <with clause> denotes the WITH Statement (aka CTE)
				#;   -- <updat> denotes the UPDATE Statement
				#;   -- <delet> denotes the DELETE Statement
				#;   -- <insrt>, which denotes the INSERT Statement, is not currently supported with <explain>
				#; <explain option list>   ::= [ <alt option ] [ <stat option> ]
				#; <alt option>            ::= ALT | ALL
				#; <stat option>           ::= STAT | STATS
				#; <left-paren>            ::= ( [ <left-paren> ]
				#; <right-paren>           ::= ) [ <right-paren> ]
				#;   -- The <stat option> and <alt option> can be specified in any order
				
				if explainOpt,",ALT,ALL,STAT,STATS,"[(","_value_",") { set res=res_" "_$s(token="(":token,1:lower) CONTINUE }
				if explainInto=1,token="INTO",i<tt,$LG(tt(i+1),1)=":" { // --- Process INTO <host-var> ---
					set res=res_" "_lower_" :"_$LG(tt($i(i)),3)
					set explainInto=2 // Mark flag to process 1st <host-var> token!
					set explainOpt=0  // Finished processing the <explain option list> statement!
					CONTINUE
				}
				if explainInto=2,token="(" { // --- Check for Complex <host-var> OR <left-paren> <selct> <right-paren> ---
					set explainInto=0  // Finished processing the <host-var> statement!
					for iOff=1:1 { // --- Parse <explain> Statement ---
						set explainTok=$LG($g(tt(i+iOff)),1)
						CONTINUE:explainTok="("                    // Skip wrapper <left-paren>s!
						QUIT:",WITH,SELECT,"[(","_explainTok_",")  // QUIT when 'WITH' or 'SELECT' found!
						set explainInto=3                          // Mark flag to process Complex <host-var>!
						QUIT
					}
				}
				if explainInto=3 { // --- Process INTO <host-var> ---
					if token'="SELECT" { // --- Process Complex <host-var> ---
						set res=res_$CASE(token,"ID":""""_lower_"""",9:value,:token)
						set:$i(explainPCnt,$CASE(token,"(":1,")":-1,:0))=0 explainInto=0 // Finished processing the <host-var> statement!
						CONTINUE
					}
				}
				set explain=0  // Finished processing the <explain> statement!
			}
			if token="DECLARE"||(token="FETCH")||(token="OPEN")||(token="CLOSE") {
				set getcursor=1
			} elseif token="OF",type="DELETE"||(type="UPDATE"),i>4,$li(tt(i-1))="CURRENT",$li(tt(i-2))="WHERE" {
				set getcursor=1,currentof=1
			} else {
				set getcursor=0
			}
			if token="WITH",'cteInfo,type="WITH" { set cteInfo=1 } // Set a flag to indicate that we are processing a CTE Statement: WITH <ident> AS ( <sql statement> ) <sql statement>
				// Do not replace the second to last argument(s) to %COLLATE, %SQLUPPER, %SQLSTRING, %STRING, or %TRUNCATE
			if $extract(token)="%",$case(token,"%COLLATE":1,"%SQLUPPER":1,"%STRING":1,"%SQLSTRING":1,"%TRUNCATE":1,:0) { set round=round+1,round(round)=0 }
			if $d(tovector),token=")" {kill tovector set qr=1}
			if $d(jsontable) {
				set:token="(" jsontable=jsontable+1
				if token=")" { set jsontable=jsontable-1 if 'jsontable { kill jsontable set qr=1 }}
			}
			if $d(jsonobject) {
				if token="("     { set jsonobject=jsonobject+1 }
				elseif token=")" { set jsonobject=jsonobject-1 if 'jsonobject { kill jsonobject set qr=1 }}
			}
			if $d(round(round)) { 	// When we pass the "," marking the second argument of ROUND, set round(round,1)=1, meaning we won't replace the next constant
				set:token="(" round(round)=round(round)+1 
				set:token=")" round(round)=round(round)-1 
				set:token=","&&(round(round)=1) round(round,1)=1 
				if token=")",round(round)=0 { kill round(round) set round=round-1 }
			}
			if token="(" {
					#; Don't replace literals within (...) of a datatype reference
				if $d(tt(i-1)) && ((" CHAR CHARACTER DEC DECIMAL NCHAR NUMBER NVARCHAR NUMERIC VARBINARY VARCHAR VARCHAR2 VARYING " [ (" "_$li(tt(i-1))_" ")) || ($li(tt(i-1))="ID" && ($case($li(tt(i-1),3),"BINARY":1,"VARBINARY":1,:0)))) {
					set insdt=1
				} else { set:insdt insdt=insdt+1 }
				#; Count parens inside ORDER BY. Only treat the first unmatched ")" as closing the subquery
				set:afterOrder obp=obp+1
				// turn on literal replacement when it is: 1) within an ORDER BY clause,
				// 2) there is a previous token, and it is a vector function: TO_VECTOR VECTOR_COSINE VECTOR_DOT_PRODUCT, 
				// 3) not a nested vector function (vectorFunctionAfterOrder'=1)
				if afterOrder,$d(tt(i-1))," TO_VECTOR VECTOR_COSINE VECTOR_DOT_PRODUCT "[(" "_$li(tt(i-1),3)_" "),'vectorFunctionAfterOrder { set qr=1,vectorFunctionAfterOrder=1,vfp=0 } 
				set:vectorFunctionAfterOrder vfp=vfp+1 
				if into,intovar=2,$i(bracket)
				if inOver,$i(overNest)
				if cteInfo,$i(cteInfo("(")) // Count open parenthesis '(' within a CTE Statement!
				set res=res_" "_token
				continue
			}
			if token=")" {
				#; Only treat this ")" as closing a subquery if all ORDER BY "(" are accounted for
				// turn off literal replacement since we reach the final parenthesis of the vector function, but still within an ORDER BY clause
				if vectorFunctionAfterOrder,'vfp { set qr=0,vectorFunctionAfterOrder=0 }
				if vectorFunctionAfterOrder,vfp { set vfp=vfp-1 }  
				if afterOrder,'obp { set afterOrder=0,qr=1 }
				if afterOrder,obp { set obp=obp-1 }
				if into,intovar=2,$i(bracket,-1)=0
				if inOver,'$i(overNest,-1) set inOver=0
				if cteInfo,$i(cteInfo(")")),$g(cteInfo("("))=cteInfo(")"),"|,|AS|"'[("|"_$LG($g(tt(i+1)),1)_"|") { set cteInfo("sql stmt")=1 } // Set a flag to indicate that we are ready to process a CTE Statement's Main <sql statement>
				set:insdt insdt=insdt-1
				set res=res_" "_token
				continue
			}
 			#; A UNION can end a subquery ORDER BY; a FETCH can end an ORDER BY
			if ",FETCH,UNION,"[(","_token_","),afterOrder,obp=0 {
				set afterOrder=0,qr=1
				set res=res_" "_token
				continue
			}
			#; A LIMIT or OFFSET can also end an ORDER BY
			if token="ID",",LIMIT,OFFSET,"[(","_value_","),afterOrder,obp=0 {
				set afterOrder=0,qr=1
			}
			if intovar=1 {
				if token="INTO",select { set qr=0 }
				elseif $$isEndOfInto('qr) { set qr=1 }
			} elseif intovar=2 {
				if token="INTO",select,'foundinto { set into=1,foundinto=1 }
				if $$isEndOfInto(into) { set into=0 }
			}
			#; Special handling for ROWS to avoid literal substitution of frame bounds
			if token="ROWS" {
				Set rowsres = $$rowsClause(.tt,.i)
				If rowsres '= "" Set res = res _ rowsres continue
			}
			if "I'_$O?9N:"'[$e(token) { set res=res_" "_token continue  }
			if intovar=2,into,token="ID" set token=":",value=lower  ; Handle case where into var is not prepended with ':'
			If token="ID",value="OVER",i<tt,$li(tt(i+1))="(" {
				Set inOver=1, overNest=0
			}
			if token="ID" {
				if value="ORDER",i<tt,$li(tt(i+1))="BY",'inOver { set qr=0,res=res_" ORDER",afterOrder=1,obp=0 continue  }
				if %delid { set res=res_" "_$s($li(ttval,4)=2:$$quoter(lower,1),1:lower) } 
				else { s res=res_" "_lower }
				continue
			}
			if token="9" {
				#; %COLLATE has quoted constant as argument(transformation-spec), which should not be parameter substituted.
				if $d(round(round,1)) { set res=res_" "_$$squoter(value) kill round(round,1) continue  }
				if qconst {
					if 'insdt,$$$QR,$$cpar(i),intovar'=2 {
							#; if %sqlHVarTypes2 is defined, we need to record the types of any literals being replaced with host variables.
							#; I expect %sqlHVarTypes2=1 to be defined when calling from a dynamic SQL preparse that we want to type the literals replaced.
						if $d(%sqlHVarTypes2),'$lf(skipLit,i) {
							set constantValue=value
							set type=$s($l(constantValue)'>32:1,$l(constantValue)'>128:2,$l(constantValue)'>512:3,1:4)	// Because qconst is TRUE, this must be a string literal
							set %sqlHVarTypes2("typelist")=$g(%sqlHVarTypes2("typelist"))_$lb(type)
						}
						set:'$lf(skipLit,i) rv=rv_$lb("c",value)
						set res=res_$s($LF(skipLit,i):" '"_value_"'",1:" ?") // IF $LF(skipLit,i), THEN this literal value is a format argument of an SQL function so do not replace it.
					}
					else { set res=res_" "_$$fquoter(value) }
				}
				else {
					if 'insdt,$$$QR,$$cpar(i),intovar'=2 { 
						if $d(%sqlHVarTypes2) {
							set constantValue=value   // Because qconst is FALSE, this must be a numeric type
							if constantValue["."||(constantValue>2147483647)||(constantValue<-2147483648) { set type=11 }  // NUMERIC
							else { set type=10 }                                                                           // INTEGER
							set %sqlHVarTypes2("typelist")=$g(%sqlHVarTypes2("typelist"))_$lb(type)
						}
						set rv=rv_$lb("c",value),res=res_" ?"
					} 
					else { set res=res_" "_$$squoter(value) }
				}
				continue
			}
			if token="$",$d(tt(i+1)) {
					#; $<function>.  $"EXTRACT" is reserved word, all others are not reserved
				if $lg(tt(i+1))="ID"," FIND JUSTIFY LENGTH LIST LISTBUILD LISTDATA LISTFIND LISTFROMSTRING LISTGET LISTLENGTH LISTSAME LISTTOSTRING MVFMT MVFMTS MVICONV MVICONVS MVOCONV MVOCONVS PIECE TRANSLATE TSQL_BIT_AND TSQL_BIT_NOT TSQL_BIT_OR TSQL_BIT_XOR TSQL_COL_NAME TSQL_ERROR TSQL_GETUTCDATE TSQL_FETCH_STATUS TSQL_INDEX_COL TSQL_LIKE TSQL_LOCK_TIMEOUT TSQL_NESTLEVEL TSQL_NEWID TSQL_OBJECT_ID TSQL_OBJECT_NAME TSQL_PLUS TSQL_RAND TSQL_SERVERNAME TSQL_SPID TSQL_SQLSTATUS TSQL_TRANCOUNT TSQL_VERSION TSQL_DB_NAME TSQL_HOST_NAME TSQL_TEXTPTR XSQL_MATCHES "[(" "_$lg(tt(i+1),3)_" ")  { set res=res_" $"_$lg(tt(i+1),3),i=i+1 continue }
				if $lg(tt(i+1))="EXTRACT"  { set res=res_" $EXTRACT",i=i+1 continue }	// EXTRACT is a reserved word
					#; check for $var special variables and use a single token for these too
				if $lg(tt(i+1))="ID"," H HOROLOG J JOB NAMESPACE TL TLEVEL USERNAME ZH ZHOROLOG ZJ ZJOB ZNSPACE ZPI ZTIMESTAMP ZTIMEZONE ZTS ZTZ ZV ZVERSION "[(" "_$lg(tt(i+1),3)_" ")  { set res=res_" $"_$lg(tt(i+1),3),i=i+1 continue }
			}
			if token=":" {
				if '$d(jsonobject) { do hvar }
					#; We are in a JSON_OBJECT() function.  We will do our best to differentiate between the key/valye pair ":" separator and an :hvar
				elseif ("(:=+-_,"[$lg(tt(i-1))) { do hvar }	// Within JSON_OBJECT(), hvars must be wrapped in parenthesis (:hvar) unless preceded by tokens '(', ':', "=", "+", "-", "_", ",",otherwise, the ":" is ambiguous
				else { set res=res_" :"  }	// could be a token for the key/value separator or an hvar.  Err on the side of caution and treat as an hvar
				continue
			}
			if 'select,token="NULL",$lg($g(tt(i-1)))'="IS",$lg($g(tt(i-1)))'="NOT",intovar'=2,'$g(%SNNoQR) { set rv=rv_$lb("c",""),res=res_" ?" set:$d(%sqlHVarTypes2) %sqlHVarTypes2("typelist")=$g(%sqlHVarTypes2("typelist"))_$lb() continue  }
			if token="?" { set res=res_" ?",rv=rv_$lb("?","?") set:$d(%sqlHVarTypes2) %sqlHVarTypes2("typelist")=$g(%sqlHVarTypes2("typelist"))_$lb() continue  }
			if token="ORDER" { set qr=0,res=res_" ORDER",afterOrder=1 continue  }
			if token="'<" { set res=res_" >=" continue  } 
			if token="'&" { set res=res_" NOT&" continue  }
			if token="'!" { set res=res_" NOT!" continue  }
			if token="'[" { set res=res_" NOT[" continue  }
			if token="']" { set res=res_" NOT]" continue  } 
			if token="'>" { set res=res_" <=" continue  }
			if token="'=" { set res=res_" <>" continue  }
			if token="_" { set res=res_" ||" continue  }
			if token="$$" {
				set func=value
				#; See if we need to add caller routine name to function calls
				if intovar=2,func'["^",$get(caller)["." { // --- Process Extrinsic Function without a Routine Reference - $$extFunc(...) ---
					set res=res_" $$"_func_"^"_$select($piece(caller,".",*)="RTN":$piece(caller,".",1,*-1),1:$piece(caller,".",1,*-1)_".1")_"("
				} else {
					set res=res_" $$"_func_"("
				}
				continue
			}
			if token="$$$" { // --- Process a $$$MACRO ---
				set res=res_" $$$"_value
				continue
			}
			set res=res_" "_token
		}
		if %compTags { for iter=1:1:%compTags { set res=res_" /*#TAG "_%compTags(iter)_" */" } }	// Put SQL Comment TAGs back on the statement
		if %compOptions { for iter=1:1:%compOptions { set res=res_" /*#OPTIONS "_%compOptions(iter)_" */" } }	// Put SQL Comment Options back on the statement
		if $g(%sqlHVarTypes2("typelist"))'="" {
			set types=$listtostring(%sqlHVarTypes2("typelist"),",",1)
			if $tr(types,",")'="" {
				set res=res_" /*#OPTIONS {""DynamicSQLTypeList"":"""_types_"""} */"
			}
		}
		set tReturn=$lb(res,rv,public)
		
	}
	catch {
		if '$g(SQLCODE) { set SQLCODE=-400,%msg="Error occurred in Preparse:  "_$ze }				// DPV2175=	// DPV2371=
		set tReturn=""
	}
	QUIT tReturn
.
hvar	;  See if the host variable is of the form var(<constant>).  If so, treat it as one item
	set varref=value,ispublic=1
	#;  See if the host variable is of the form i%Prop or r%Prop.  If so, treat it as one item
	if varref="i"||(varref="r"),$e($lg($g(tt(i+1)),2))="%",$lg($g(tt(i+1)))="ID"||($$$SQLReservedWordForParsingContext(%context,$lg($g(tt(i+1))))) {
		set ispublic=0
		set i=i+1,varref=varref_$li(tt(i),2)
		#; If the i%"var name" reference is quoted include this here
		if $li(tt(i),2)="%",$lg($g(tt(i+1)),4) {
			if $lg($g(tt(i+1)))="ID" {
				set i=i+1,varref=varref_$$$QN($li(tt(i),2))
			} elseif $lg($g(tt(i+1)))=9 {
				set i=i+1,varref=varref_$$$QN($li(tt(i),3))
			}
		}
	} elseif $zname(varref,0) {
		set public=public_$lb(varref)
	}
	#; Now look for '.' 
	if $lg($g(tt(i+1)))="." {
		set ispublic=0
		set varref=varref_"."_$$$QN($li(tt(i+2),2)),i=i+2
	}
	#; Now check for '(' so we can handle this all as a single ? variable
bracket		if $lg($g(tt(i+1)))="(" {
		set quote=1,varref=varref_"("
		for j=i+2:1:tt {
			set optype=$lg($g(tt(j)))
			if optype=9 {
				set varref=varref_$$$QuoteName($li(tt(j),3))
			} elseif optype="ID" {
				set var=$li(tt(j),2)
				if $li(tt(j),4)=2 {
					set varref=varref_""""_$replace(var,"""","""""")_""""
				} else {
					if $zname(var,0) set public=public_$lb(var)
					set varref=varref_$$$QN(var)
				}
			} elseif optype="(" {
				set quote=quote+1,varref=varref_"("
			} elseif optype=")" {
				set quote=quote-1,varref=varref_")"
				if quote=0 QUIT
			} elseif optype="," {
				set varref=varref_","
			} elseif optype="$$" {
				set ispublic=0
				set varref=varref_"$$"_$li(tt(j),3)_"(",quote=quote+1
			} elseif optype="$$$" { // --- Process a $$$MACRO ---
				set varref=varref_" $$$"_$li(tt(j),3)
			} elseif optype=":" { // --- Skip ':' for embedded/recursive Host Variable references [e.g. :data(:row,"field")] ---
				set varref=varref_$li(tt(j),3)
			} elseif optype'="" {
				set ispublic=0
				set varref=varref_$li(tt(j),2)
			}
		}
		set i=j
	}
	#; Look for chained '.'
	if $lg($g(tt(i+1)))="." {
		set ispublic=0
		set varref=varref_"."_$$$QN($li(tt(i+2),2)),i=i+2
		GOTO bracket
	}
	
	if $$$QR {
		if intovar=2 {
			set replacearg=$s($zconvert($e(type,1,3),"u")="DEC":"i%sqltmp",1:"sqltmp")_$i(hvcnt)
			#; If this is local variable reference do not need to change it
			if ispublic {
				set rv=rv_$lb("p",$s(into:".",1:"")_varref),res=res_" :"_varref
			} else {
				set rv=rv_$lb("v",$s(into:".",1:"")_varref),res=res_" :"_replacearg
			}
		} else {
			set rv=rv_$lb("v",varref),res=res_" ?"
		}
		set:$d(%sqlHVarTypes2) %sqlHVarTypes2("typelist")=$g(%sqlHVarTypes2("typelist"))_$lb()
	} else {
		set res=res_" :"_varref
	}
	QUIT
.
}
.
	// isEndOfInto - check if the current token terminates the INTO variables list
isEndOfInto(into) [token] PRIVATE {
	RETURN (into && (" FROM UNION "[(" "_token_" ")))
}
.
	// cpar - check parenthesis
	// Return 1 if we should possibly replace the literal with hvar.
	// Return 0 if we should not replace literal
	// i - token position
	// 3. For the sequence of tokens:  ID LPAR CONST RPAR
	// 
	//    A. If ID is any of the following:
	//           TOP, SELECT, LIKE, WHERE, ON, AND, OR, NOT, BETWEEN,
	//           %STARTSWITH, CASE, WHEN, THEN, ELSE
	//       then the CONST is NOT replaced
	// 
	//    B. For any other ID, the CONST is replaced by QMARK
	// 
	// 4. Otherwise, in any sequence:  LPAR CONST RPAR
	//    the CONST is NOT replaced 
	// 
	// 5. Otherwise, any CONST is replaced by QMARK
	// 
cpar(i) [tt] PRIVATE {
		#; Don't replace <literal> IS [NOT] NULL with hvar, leads to poor query plans in some cases
	set j=$lg($g(tt(i+1)))		// j is next token
 	if j="IS" {
	 	if $lg($g(tt(i+2)))="NULL" { QUIT 0 }				// <literal> IS NULL
 		if $lg($g(tt(i+2)))="NOT",$lg($g(tt(i+3)))="NULL" { QUIT 0 }	// <literal> IS NOT NULL
 	}
	QUIT:(i=1)||(i=tt)||(j'=")")||('$d(tt(i-1))) 1	// first token, last token, next token is not ")", or previous token does not exist
	set j=i-($li(tt(i-1))="-")	// set j to i (this token position), or i-1 (if previous token is "-").  This effectivily treats -<literal> as a single token
	QUIT:'$d(tt(j-1))||($li(tt(j-1))'="(")||('$d(tt(j-2))) 1	// If previous token does not exist, or the previous token is not a "(", or two tokens left does not exist, return 1
	set k=$li(tt(j-2))		// k is two tokens previous
 	QUIT:$Case(k,"TOP":1,"SELECT":1,"LIKE":1,"WHERE":1,"ON":1,"AND":1,"OR":1,"NOT":1,"BETWEEN":1,"%STARTSWITH":1,"CASE":1,"WHEN":1,"THEN":1,"ELSE":1,:0) 0		// Rule 3A, ID LPAR CONST RPAR, literal not replaced
 	QUIT:k="ID"||($$$SQLReservedWordForParsingContext(%context,k)) 1                                        // Rule 3B, OtherID LPAR CONST RPAR, literal possibly replaced
 	QUIT:$li(tt(j-1))="("&&($li(tt(j+1))=")") 0                                             // Rule 4, LPAR CONST RPAR, literal not replaced
	QUIT $s(k["'":0,k["&":0,k["!":0,k["[":0,k["]":0,k[">":0,k["=":0,k="_":0,k["(":0,1:1)	// was k["_", but then it is TRUE for things like k=CURRENT_TIMESTAMP
}
 
tableList(pStatementText,imports="") [SQLCODE,mcurs,mtag,mtc] PUBLIC {
	new mcurs,mtag,mtc,SQLCODE
	set SQLCODE = 0
		#; Get a list of actual table name specified in this statement
	try { d comp^%qaqqt("query",.pStatementText,"tablist",,,,,,,imports) } catch tException { if (tException.Location '= "errdone+2^%qaqqt") || (tException.Name '= "<SYNTAX>") { set SQLCODE = -400 } }
	set tTabList="",tTab="" 
	for  { set tTab=$o(mtc(0,0,"tablist",tTab)) quit:tTab=""  set tTabList=tTabList_$lb($zcvt(tTab,"U")) }
	QUIT tTabList
}
.
#; parse and de-lex from tt() @ p a ROWS window function frame clause, if any, advancing p to the final
#; token position, returns "" and no change to p if no clause found
rowsClause(tt, p) public {
	Set i = p
	Set res = ""
	Set between = 0
	//skip ROWS
	Set i = i+1
	// it is NOT a ROWS window function frame clause if 
	// 1) ROWS is the last token, or 2) ROWS is followed by FETCH, or ONLY
	RETURN:('$d(tt(i)))||(",FETCH,ONLY,"[(","_$lg(tt(i))_",")) "" 
	If $li(tt(i)) = "BETWEEN" {
		Set between = 1
		Set i = i+1
	}
	Set bound1 = $$rowsBound(.tt, .i)
	If bound1 = "" RETURN ""
	Set bound2 = ""
	If between {
		//skip AND
		Set i = i+2
		Set bound2 = $$rowsBound(.tt, .i)
		If bound2 = "" RETURN ""
	}
	Set p = i
	RETURN " ROWS"_$s(between:" BETWEEN",1:"")_bound1_$s(between:" AND"_bound2,1:"")
}
rowsBound(tt, p) public {
	If $li(tt(p)) = "CURRENT" {
		Set p = p + 1
		RETURN " CURRENT ROW"
	}
	If $li(tt(p)) = 9 {
		Set bound = $li(tt(p),3)
		Set p = p + 1
		RETURN " "_bound_" "_$li(tt(p),3)
	}
	if $li(tt(p)) = "ID",$li(tt(p),3) = "UNBOUNDED" {
		Set p = p + 1
		RETURN " UNBOUNDED"_" "_$li(tt(p),3)
	} 
	RETURN ""
}
dynamic(pStatementText,pParsedSQL="",pArguments="",imports="",pFirstToken="") [ backgrnd,comperr,mcurs,mtag,mtc,pathout,error,SQLCODE] PUBLIC {
	new backgrnd,comperr,error,mcurs,mtag,mtc,pathout,%qsccerr,SQLCODE,%switch
	set SQLCODE = 0
		set pFirstToken = $$firstToken(.pStatementText)
		if $Extract(pFirstToken,1,3) = "SEL" { set tPreparserResult = $$preparse(.pStatementText) } else { set tPreparserResult = $$preparseDeferred(.pStatementText) }
		if (tPreparserResult '= "") && ('SQLCODE) {
			set pParsedSQL = $list(tPreparserResult,1),pArguments = $list(tPreparserResult,2)
			Set:$find(pParsedSQL, " /*#OPTIONS {""DynamicSQL"":1} */")=0 pParsedSQL=pParsedSQL_" /*#OPTIONS {""DynamicSQL"":1} */"
	} else {
		set pParsedSQL = "", pArguments = ""
	}
	QUIT SQLCODE
}
 
/// Gets the first token in the input. If the token was an identifier ("ID"), the value of the identifier is returned in the PBR param identiferValue.
/// Can handle all nodes of the input when passed as reference.
firstToken(&input, &identifierValue) [begline,begtoken,c,callname,checkFirstToken,endline,endtoken,f,fsave,indexline,input,insdt,label,line,lineprev,logic,lower,m,mask,maybeCOS,maybePython,more,n,name,p,prevtoken,pprev,pprev,qr,rv,sql,token,val,value] PUBLIC {
	#; Sample Input:
	#; s input(1) = """aviel"" aviel.sas :vv from a"
	#; s input(2)="where f=4 and z=? order by 2 ff"
	#; s input=2
	
	new begline,begtoken,c,callname,checkFirstToken,%compOptions,%compTags,%delid,%context,endline,endtoken,f,fsave,indexline,lineprev,%inMLComment,insdt,label,line,lineprev,logic,lower,m,mask,maybeCOS,more,n,name,p,pprev,prevtoken,qr,rv,sql,token,val,value
	set line=0,more=0,f=0,p=0,callname="info",sql=input,%compOptions=0,%compTags=0,%context=$system.Context.SQLCompile(),%delid=%context.DelimitedIdentifiers
	try {
		do first:'input 
		do lext 
	} 
	catch {
		if '$g(SQLCODE) { set SQLCODE=-400,%msg="Error occurred in Preparse:  "_$ze }
		set token=""
	}
	$$$lexcheck("WITH") do cte^%qaqpsq1(0)  // Skip over the CTE's <with clause> ::= WITH <with list>  [See 'sqlbnf.txt' for details]
	QUIT:token=$c(1) "" 
	set identifierValue = $s(token="ID": value, 1:token)
	QUIT token
}
.
firstTokens(&input,numTokens=1) [begline,begtoken,c,callname,checkFirstToken,endline,endtoken,f,fsave,indexline,input,insdt,label,line,lineprev,logic,lower,m,mask,maybeCOS,maybePython,more,n,name,p,prevtoken,pprev,pprev,qr,rv,sql,token,val,value] PUBLIC {
	#; Sample Input:
	#; s input(1) = """aviel"" aviel.sas :vv from a"
	#; s input(2)="where f=4 and z=? order by 2 ff"
	#; s input=2
	new begline,begtoken,c,callname,checkFirstToken,%compOptions,%compTags,%context,%delid,endline,endtoken,f,fsave,%inMLComment,indexline,insdt,label,line,lineprev,logic,lower,m,mask,maybeCOS,more,n,name,p,pprev,prevtoken,qr,rv,sql,token,val,value
	set line=0,more=0,f=0,p=0,callname="info",sql=input,%compOptions=0,%compTags=0,%context=$system.Context.SQLCompile(),%delid=%context.DelimitedIdentifiers
	set return=""
	try {
		do first:'input 
		for i=1:1:numTokens {
			do lext
			$$$lexcheck("WITH") do cte^%qaqpsq1(0)  // Skip over the CTE's <with clause> ::= WITH <with list>  [See 'sqlbnf.txt' for details]
			set return=return_$lb($s(token="ID":value,1:token))
			quit:token=$c(1)
		}
	}
	catch {
		if '$g(SQLCODE) { set SQLCODE=-400,%msg="Error occurred in Preparse:  "_$ze }
		set return=""
	}
	RETURN return
}
.
	// Given an sql statement in input(), return the first token ofthe statement. If the token was an identifier ("ID"), the value of the identifier is returned in the PBR param identiferValue.
firstToken2(&input, &identifierValue) [c,callname,checkFirstToken,f,fsave,pprev,lineprev,input,insdt,label,line,logic,lower,m,mask,maybeCOS,more,n,name,p,prevtoken,qr,rv,sql,sqltext,token,val,value] PUBLIC {
	new c,callname,checkFirstToken,%delid,%compTags,%context,f,fsave,%inMLComment,insdt,label,line,lineprev,logic,lower,m,mask,maybeCOS,more,n,name,p,pprev,prevtoken,qr,rv,sql,token,val,value
	set line=0,more=0,f=0,p=0,callname="info",sql=input(0),%context=$system.Context.SQLCompile(),%delid=%context.DelimitedIdentifiers,%compTags=0
	try {
		set input=input(0) kill input(0)
		do first:'input do lext
	}
	catch {	set token="" }   // don't worry about reporting an error, it will be cause later in the real preparse
	$$$lexcheck("WITH") do cte^%qaqpsq1(0)  // Skip over the CTE's <with clause> ::= WITH <with list>  [See 'sqlbnf.txt' for details]
	set input(0)=input zkill input
	RETURN:token=$c(1) ""
	set identifierValue = $s(token="ID": value, 1:token)
	RETURN $$$UPPER(token)
}
.
squoter(x) [] PRIVATE {
		#; $$ Func to wrap quotes around x, x may already contain quotes
		#; DPV2175 ($Number())	// DPV2508 (x=+x back in for '+007' case)	// DPV2675 ('') if $c(0)
	QUIT:(+$Number(x)||(x=0))&&(x=+x) x  
	QUIT:x=$c(0) "''"
	QUIT "'"_$replace(x,"'","''")_"'"
}
.
fquoter(x) [] PRIVATE {
	QUIT:x=$c(0) "''"	  		// DPV2675 ('') if $c(0)
	QUIT "'"_$replace(x,"'","''")_"'"
}
.
preparseDeferred(input) [c,callname,ext,f,fsave,begline,begtoken,endline,endtoken,indexline,prevtoken,pprev,lineprev,pprev,hvcnt,hvn,input,insdt,into,jointype,label,likeerr,likeesc,likepat,line,logic,lower,m,mask,maybeCOS,maybePython,more,n,name,p,ptln,qr,res,rest,round,rv,rw,select,setqexp,sql,SQLCODE,sldst,subval,switch,token,tsq,tt,val,value] PRIVATE {
		#; replace host vars and constants with p<n> where n is incremented from 1 by 1
		#; the replaced values are returned as part of the return value $list as 'v' and 'c' list entries followed by the replaced value.
		#; for host variables replaced in the INTO list of a select statement a dot (COS pass by reference indicator) preceeds the variable name
		#; for SELECT...INTO :array() the subscripts are removed from the replaced values list and the byref indicator dot is used. However, the
		#; subscript information is retained in the statement. For example:
		#;      select * into :a() from person
		#; becomes:
		#;	select * into :p1() from person
		#; and the replaced value list contains $listbuild("v",".a")
	new c,callname,%compOptions,%compTags,%delid,%context,ext,f,fsave,begline,begtoken,endline,endtoken,%inMLComment,indexline,prevtoken,pprev,lineprev,pprev,hvcnt,hvn,insdt,into,jointype,label,likeerr,likeesc,likepat,line,logic,lower,m,mask,maybeCOS,maybePython,more,n,name,p,ptln,qr,res,rest,round,rv,rw,select,setqexp,sql,sldst,subval,switch,token,tsq,tt,val,value
	new %COSParse,%PythonParse
	set line=0,more=0,f=0,p=0,callname="info",sql=input,%compOptions=0,%compTags=0,%context=$system.Context.SQLCompile(),%delid=%context.DelimitedIdentifiers
	kill tt set tt=0
	try {
		do first:'input
		set oldmask=$get(mask)
		do lext 
		if token=$c(1) { set tReturn=$lb(input,"","") quit  }
		set tt=tt+1,tt(tt)=$lb(token,lower,value,%delid),maybeCOS=0,maybePython=0
		if (token="CREATE")||(token="ALTER")||(token="GRANT")||(token="REVOKE")||(token="DROP")||(token="SET") { new %mmmNo28Check set %mmmNo28Check=1 set:token="CREATE" maybeCOS=1,maybePython=1 }
		set select=(token="SELECT")
		for  {
			do lext
			quit:token=$c(1)
			set tt=tt+1,tt(tt)=$lb(token,lower,value,%delid)
			set:maybeCOS&&(token="ID")&&((value="OBJECTSCRIPT")||(value="COS")) %COSParse=1,mask=$$MASK(sql)_$c(1)  // Reset mask for COS parser so "$", ":", "'", """" are included in mask
			set:maybePython&&(token="ID")&&((value="PYTHON")) %PythonParse=1,mask=$$MASK(sql)_$c(1)  		// Reset mask for Python parser so "$", ":", "'", """" are included in mask
		}
		kill:$lg(tt(tt),1)=";" tt($i(tt,-1)+1) // remove trailing semicolon
		if $get(%COSParse) { kill %COSParse set mask=oldmask }
		elseif $get(%PythonParse) { kill %PythonParse set mask=oldmask }
		set res="",qr=1,rv=""
		If tt>0,($li(tt(1))="CREATE")||($li(tt(1))="ALTER")||($li(tt(1))="GRANT")||($li(tt(1))="REVOKE")||($li(tt(1))="DROP")||($li(tt(1))="SET")||($case($lg(tt(1),3),"LOCK":1,"TUNE":1,"COLLECT":1,"THROUGH":1,:0)) {	// DPV2204 (SET)
			if 'input { set res=input set tReturn=$lb(res,"","") quit  }
			for i=1:1:input { set res=res_$c(13,10)_input(i) }	// DPV2269 ($c(13,10) instead of " "
			set tReturn=$lb(res,"","")
			quit
		}
		set insdt=0,into=0,round=0,afterOrder=0
		for i=1:1:tt {
			set ttval=tt(i)
			set token=$li(ttval)
			if token="ID" {
				set value=$li(ttval,3)
				if $case(value,"ROUND":1,"TRUNCATE":1,:0) { set round=round+1,round(round)=0 }
				elseif value="DATEPART",$li($g(tt(i+2)),1)=9 { set res=res_" "_value_" ( '"_$li(tt(i+2),3)_"'",i=i+2 continue }	// Don't replace first argument of DATEPART if it is a literal
				elseif value="JSON_TABLE" { if $li($g(tt(i+1)),1)="(" { set jsontable=0,qr=0 }}
				elseif value="JSON_OBJECT",'$d(jsonobject),$li($g(tt(i+1)),1)="(" { set jsonobject=0,qr=0 }
				elseif $case(value,"TIMESTAMPADD":1,"TIMESTAMPDIFF":1,:0),$lg(tt(i-1),3)="FN" { set res=res_" "_value_" ( "_$li(tt(i+2),3),i=i+2 continue }	// Don't replace first argument to { fn TIMESTAMP*(x,y,z) }
			}
				// Do not replace the second to last argument(s) to %COLLATE, %SQLUPPER, %SQLSTRING, %STRING, or %TRUNCATE
			if $extract(token)="%",$case(token,"%COLLATE":1,"%SQLUPPER":1,"%STRING":1,"%SQLSTRING":1,"%TRUNCATE":1,:0) { set round=round+1,round(round)=0 }
			if $d(tovector),token=")" {kill tovector set qr=1}
			if $d(jsontable) {
				set:token="(" jsontable=jsontable+1
				if token=")" { set jsontable=jsontable-1 if 'jsontable { kill jsontable set qr=1 }}
			}
			if $d(jsonobject) {
				if token="("     { set jsonobject=jsonobject+1 }
				elseif token=")" { set jsonobject=jsonobject-1 if 'jsonobject { kill jsonobject set qr=1 }}
			}
			if $d(round(round)) { 	// When we pass the "," marking the second argument of ROUND, set round(round,1)=1, meaning we won't replace the next constant
				set:token="(" round(round)=round(round)+1 
				set:token=")" round(round)=round(round)-1 
				set:token=","&&(round(round)=1) round(round,1)=1 
				if token=")",round(round)=0 { kill round(round) set round=round-1 }
			}
			if token="(" {
					#; Don't replace literals within (...) of a datatype reference
				if $d(tt(i-1)) && ((" CHAR CHARACTER DEC DECIMAL NCHAR NUMBER NVARCHAR NUMERIC VARBINARY VARCHAR VARCHAR2 VARYING " [ (" "_$li(tt(i-1))_" ")) || ($li(tt(i-1))="ID" && ($case($li(tt(i-1),3),"BINARY":1,"VARBINARY":1,:0)))) {
					set insdt=1
				} else { set:insdt insdt=insdt+1 }
				set res=res_" "_token
				continue
			}
			if token=")" {
				if afterOrder { set afterOrder=0,qr=1 }
				set:insdt insdt=0
				set res=res_" "_token
				continue
			}
			if token="INTO",select { set into=1,select=0 }
			if $$isEndOfInto(into) { set into=0 }
			if "I'_$O?9N:"'[$e(token) { set res=res_" "_token continue  }
			if token="ID" {
				if %delid { set res=res_" "_$s($li(tt(i),4)=2:$$quoter($li(tt(i),2),1),1:$li(tt(i),2)) } 
				else { set res=res_" "_$li(tt(i),2) }
				continue
			}
			if token="9",$d(round(round,1)) { set res=res_" "_$$squoter($li(tt(i),3)) kill round(round,1) continue  }
			if token="9" {
				if 'insdt,$$$QR,$$cpar(i) { set rv=rv_$lb("c",$li(tt(i),3)),res=res_" :p"_$i(hvcnt) } 
				else { set res=res_" "_$$squoter($li(tt(i),3)) }
				continue
			}
			if token="$",$d(tt(i+1)) {
					#; $<function>.  $"EXTRACT" is reserved word, all others are not reserved
				if $lg(tt(i+1))="ID"," FIND JUSTIFY LENGTH LIST LISTBUILD LISTDATA LISTFIND LISTFROMSTRING LISTGET LISTLENGTH LISTSAME LISTTOSTRING MVFMT MVFMTS MVICONV MVICONVS MVOCONV MVOCONVS PIECE TRANSLATE TSQL_BIT_AND TSQL_BIT_NOT TSQL_BIT_OR TSQL_BIT_XOR TSQL_COL_NAME TSQL_ERROR TSQL_GETUTCDATE TSQL_FETCH_STATUS TSQL_INDEX_COL TSQL_LIKE TSQL_LOCK_TIMEOUT TSQL_NESTLEVEL TSQL_NEWID TSQL_OBJECT_ID TSQL_OBJECT_NAME TSQL_PLUS TSQL_RAND TSQL_SERVERNAME TSQL_SPID TSQL_SQLSTATUS TSQL_TRANCOUNT TSQL_VERSION TSQL_DB_NAME TSQL_HOST_NAME TSQL_TEXTPTR XSQL_MATCHES "[(" "_$lg(tt(i+1),3)_" ")  { set res=res_" $"_$lg(tt(i+1),3),i=i+1 continue }
				if $lg(tt(i+1))="EXTRACT"  { set res=res_" $EXTRACT",i=i+1 continue }	// EXTRACT is a reserved word
					#; check for $var special variables and use a single token for these too
				if $lg(tt(i+1))="ID"," H HOROLOG J JOB NAMESPACE TL TLEVEL USERNAME ZH ZHOROLOG ZJ ZJOB ZNSPACE ZPI ZTIMESTAMP ZTIMEZONE ZTS ZTZ ZV ZVERSION "[(" "_$lg(tt(i+1),3)_" ")  { set res=res_" $"_$lg(tt(i+1),3),i=i+1 continue }
			}
			if token=":" { do dfshvar continue  }
			if token="NULL",$lg($g(tt(i-1)))'="IS",$lg($g(tt(i-1)))'="NOT" { set rv=rv_$lb("c",""),res=res_" :p"_$i(hvcnt) continue  }
			if token="?" { set res=res_" ?",rv=rv_$lb("?","?") continue  }
			if token="ORDER" { set qr=0,res=res_" ORDER",afterOrder=1 continue  }
			if token="'<" { set res=res_" >=" continue  }
			if token="'&" { set res=res_" NOT&" continue  }
			if token="'!" { set res=res_" NOT!" continue  }
			if token="'[" { set res=res_" NOT[" continue  } 
			if token="']" { set res=res_" NOT]" continue  }
			if token="'>" { set res=res_" <=" continue  }
			if token="'=" { set res=res_" <>" continue  }
			if token="_" { set res=res_" ||" continue  }
			if token="$$" { set res=res_" $$"_$li(tt(i),3)_"(" continue  }
			set res=res_" "_token
		}
		set tReturn=$lb(res)_$lb(rv)
	}
	catch {
		if '$g(SQLCODE) { set SQLCODE=-400,%msg="Error occurred in Preparse:  "_$ze }				// DPV2175=	// DPV2371=
		set tReturn=""
	}
	
	QUIT tReturn
	
		#;  See if the host variable is of the form var(<constant>).  If so, treat it as one item
dfshvar
	set hvn=$li(tt(i),3)
	if (i<tt) {
		if (hvn = "i")&&($e($li(tt(i+1),3))="%")&&($li(tt(i+1))="ID") { s hvn="i"_$li(tt($i(i)),2) }
		elseif $li(tt(i+1))="." {
			set i=i+1
			do {
				s hvn=hvn_".",i=i+1
				if $li(tt(i))="ID" { s hvn=hvn_$li(tt(i),2),i=i+1 }
			} while (i<tt)&&($li(tt(i))=".")
			if i'>tt,$li(tt(i))="(" {	// Perhaps it is multi-dimensional?
				s hvn=hvn_"(",i=i+1
				for  {
						#; Note, that if there is a string literal in as a multi-dimensional subscript, the preparser treats it as an ID, not a literal when
						#; delimited identifiers it turned ON.
						#; For now I'll handle this by simply adding quotes.  This means we do not currently support
						#; an identifier in a subscript of a multi-dimnsional reference, which is probably OK.
					if $li(tt(i))="ID" { s hvn=hvn_$$quoter($li(tt(i),2)) }
					elseif $li(tt(i))=9 { s hvn=hvn_$$quoter($li(tt(i),3)) }
					else { set hvn=hvn_$li(tt(i)) }
					q:i'<tt||($li(tt(i))=")")
					set i=i+1
				}
			}
			else { set i=i-1 }	// if not multi-dimensional, i already points to the next token.  for loop in dfstk is going to increment i, we need to decrement one here so we don't skip a token
		}
	}
	If $$$QR,$lg($g(tt(i+1)))="(",$lg($g(tt(i+2)))="9",$lg($g(tt(i+3)))=")" { s subval="("_$li(tt(i+2),3)_")" if '(",("[$e(subval,*-1)) { s rv=rv_$lb("v",$Select('into:"",1:".")_hvn_subval),res=res_" :p"_$i(hvcnt) } else { s rv=rv_$lb("v","."_hvn),res=res_" :p"_$i(hvcnt)_subval } s i=i+3 q }
	If $$$QR { s rv=rv_$lb("v",$Select('into:"",1:".")_hvn),res=res_" :p"_$i(hvcnt) } Else { s res=res_" "_hvn }
	QUIT
}
.
#INCLUDE %qaqplex
#INCLUDE %fcalpha
#INCLUDE %quoter
---


