%qaqptp1	// Transaction Processing/Environment Setting Module: Part 1
	;; COMPONENTS :: SQL/Parser
	#;         
#INCLUDE %msql
 ;
#IF 0    ;---------------------------------------------------------------------
 ; Description:   Transaction Processing/Environment Setting
 ;                (Statement Parsing): Part 1 
 ; Author:        Michael Pantaleo
 ; Date Started:  16 December 1996
 ; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
 ;
 ;  DPV3296 (10/20/2008) - Don't treat SIZE and CROSS as reserved words in the parser
 ;   MRP570d (04/07/97) - TP: Disable <level of isolation>=
 ;                       "REPEATABLE READ"...
 ;   MRP570  (06/26/96) - Transaction Processing/Environment Setting
 ;                      - Creating of Entire Routine -
 ;    
#ENDIF   ;---------------------------------------------------------------------
 ;
 $$$Abort  ; Not an Entry Point!!
 q
 ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
starttp ; Parse START TRANSACTION here...
#IF 0    ;---------------------------------------------------------------------
 ;  BNF:
 ;
 ;   <start transaction statement> ::= START TRANSACTION 
 ;                             [ <%commit option> ] <transaction mode> 
 ;                             [ {, <transaction mode> }... ] 
 ;   <transaction mode> ::= <isolation level> | 
 ;                        | <transaction access mode> 
 ;                        | <diagnostic size>
 ;   <transaction access mode> ::= READ ONLY | READ WRITE
 ;   <isolation level> ::= ISOLATION LEVEL <level of isolation>
 ;   <level of isolation> ::= READ UNCOMMITTED | READ COMMITTED | READ VERIFIED
 ;                          | REPEATABLE READ | SERIALIZABLE
 ;   <diagnostics size> ::= DIAGNOSTICS SIZE <number of  conditions>
 ;   <number of conditions> ::= <simple value specification>
 ;   <%commit option> ::= %COMMITMODE <%commit mode>
 ;   <%commit mode> ::= IMPLICIT | EXPLICIT | NONE
#ENDIF   ;---------------------------------------------------------------------
 n t
 s $$$mtStatementType=$$$mtStatementType_" TP"
 i value="%COMMITMODE" d        ; <%commit option>
 . d skip(token)                ; Must have <%commit mode> token
 . i ",IMPLICIT,EXPLICIT,NONE,"'[(","_value_",") s t="IMPLICIT, EXPLICIT, or NONE," d error(1)  ; Invalid <%commit mode>...
 . d putval("t"_"^"_value)
 . s $$$mtTransaction=$e($p($g($$$mtV(+val)),"^",2))_"-"_val_"^"
 . d skip(token)
 f  d trmode q:'$$check(",")
 i $g($$$mtTransaction)["t-RW",($$$mtTransaction["i-RU")||($$$mtTransaction["i-RV") d error(92)
 q
 ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
settp ; Parse SET TRANSACTION here...
#IF 0    ;---------------------------------------------------------------------
 ;  BNF:
 ;
 ;   <set transaction statement> ::= SET TRANSACTION 
 ;                             [ <%commit option> ] <transaction mode> 
 ;                             [ {, <transaction mode> }... ] 
 ;   <transaction mode> ::= <isolation level> | 
 ;                        | <transaction access mode> 
 ;                        | <diagnostic size>
 ;   <transaction access mode> ::= READ ONLY | READ WRITE
 ;   <isolation level> ::= ISOLATION LEVEL <level of isolation>
 ;   <level of isolation> ::= READ UNCOMMITTED | READ COMMITTED | READ VERIFIED
 ;                          | REPEATABLE READ | SERIALIZABLE
 ;   <diagnostics size> ::= DIAGNOSTICS SIZE <number of  conditions>
 ;   <number of conditions> ::= <simple value specification>
 ;   <%commit option> ::= %COMMITMODE <%commit mode>
 ;   <%commit mode> ::= IMPLICIT | EXPLICIT | NONE
#ENDIF   ;---------------------------------------------------------------------
 n t
 s $$$mtStatementType=$$$mtStatementType_" TP"
 i value="%COMMITMODE" d        ; <%commit option>
 . d skip(token)                ; Must have <%commit mode> token
 . i ",IMPLICIT,EXPLICIT,NONE,"'[(","_value_",") s t="IMPLICIT, EXPLICIT, or NONE," d error(1)  ; Invalid <%commit mode>...
 . d putval("t"_"^"_value)
 . s $$$mtTransaction=$e($p($g($$$mtV(+val)),"^",2))_"-"_val_"^"
 . d skip(token)
 f  d trmode q:'$$check(",")
 i $g($$$mtTransaction)["t-RW",($$$mtTransaction["i-RU")||($$$mtTransaction["i-RV") d error(92)
 q
 ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
trmode ; Parse <transaction mode> here...
 n t
 i token="ISOLATION" d  q       ; <isolation level>
 . i $g($$$mtTransaction)["i-" d error(91)  ; Duplicate <trans mode>
 . n symbol s symbol=""
 . s level=$$getlevel(.symbol)
 . d putval("t"_"^"_level)
 . s $$$mtTransaction=$g($$$mtTransaction)_"i-"_symbol_"-"_val_","
 e  i token="READ" d    q       ; <transaction access mode>
 . d skip(token)                ; Must have <READ> token
 . i ",ONLY,WRITE,"'[(","_value_",") s t="ONLY or WRITE," d error(1)
 . i $g($$$mtTransaction)[("t-R"_$e(value)) d error(91)  ; Duplicate <trans mode>
 . d putval("t"_"^"_value)
 . s $$$mtTransaction=$g($$$mtTransaction)_"t-R"_$e(value)_"-"_val_","
 . d skip(token)
 e  i token="DIAGNOSTICS" d  q  ; <diagnostic size>
 . n sflag s sflag=1
 . d skip(token)                ; Must have <diagnostics> token
 . d skipid("SIZE")               ; Must have <size> token	// DPV3296
 . i $g($$$mtTransaction)["d-" d error(91)  ; Duplicate <trans mode>
 . d term^%qaqpslx              ; <simple value specification>
 . i $p($g($$$mtV(+val)),"^",2)["." d error(93)
 . s $$$mtTransaction=$g($$$mtTransaction)_"d-"_$p($g($$$mtV(+val)),"^",2)_"-"_val_","
 q         
 ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getlevel(symbol) ; Get the <isolation level> from parsing...
 n level s level=""
 d skip("ISOLATION")         ; Must have <isolation> token
 d skip("LEVEL")             ; Must have <level> token
 s level=value 
 i token'="SERIALIZABLE" d skip(token) s level=level_" "_value
	#; MRP570d (TP: Disable <level of isolation>="REPEATABLE READ")...
 d:level="REPEATABLE READ" error(96)
 i ",READ UNCOMMITTED,READ COMMITTED,READ VERIFIED,REPEATABLE READ,SERIALIZABLE,"'[(","_level_",") s t="READ UNCOMMITTED, READ COMMITTED, READ VERIFIED, REPEATABLE READ, or SERIALIZABLE," d error(1)  ; Invalid <level of isolation>
 d skip(token)
 s symbol=$s(level="READ UNCOMMITTED":"RU",level="READ COMMITTED":"RC",level="READ VERIFIED":"RV",level="REPEATABLE READ":"RR",level="SERIALIZABLE":"S",1:"")
 q level
 ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
