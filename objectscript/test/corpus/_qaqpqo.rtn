====
qaqpqo
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpqo^MAC^^^0
%qaqpqo	// Analyze mt for QO (1/26/87 Aviel)
	;; COMPONENTS :: SQL/PreOptimizer
	#;
#INCLUDE %msql
#INCLUDE %occODBC
#INCLUDE %BigData.ShardingManager // JMM1220=
.
	#; default %x to %d if it is 0 or NULL
#DEFINE default(%x,%d) $s(%x:%x,1:%d)
.
#IF 0   ;-------------------------------------------------------------
	; Description:   Analyze parse-tree for Query Optimizer
	; Author:        Aviel Klausner
	; Date Started:  January 26, 1987
	;  
	;  AK850   (11/30/2020) - Implement lateral join
	;  AK982   (08/24/2018) - Simplify coll2(uncollate(collate(f)))
	;  MRP1015 (08/22/2017) - SQL: Add meaningful SQLCODE error for 'Cardinality mismatch between the SELECT-list and %INTOLIST-param'
	;  MRP1014 (08/18/2017) - SQL: Correct <SUBSCRIPT> compiling Embedded SQL with 'Cardinality mismatch between the SELECT-list and INTO-list'
	;  PVA342  (12/15/2015) - Generate ojfilters for sharding only when really needed, and fix interaction between aggregates and outer joins (for sharding) 
	;  PVA309  (06/20/2014) - Fix behavior of MVR and MINUS collation with DISTINCT, GROUP BY, and MAX/MIN
	;  PVA304  (04/23/2014) - Support %PARTITION BY for use by parallel work units 
	;  AK905   (03/24/2014) - Apply correct collation to field with DISTINCT
	;  PVA288  (09/25/2013) - Use Exact Collation for Key of Collections (unless buildvaluearray used) 
	;  PVA262  (06/13/2012) - support alternative to %starttable: %firsttable <correlation name>
	;  AK838   (12/05/2011) - Fix variable m in redist()->nufld() calls
	;  AK831   (10/04/2011) - Correct more NOT EXISTS SVSO logic
	;  PVA242  (07/28/2011) - Support a hint (%noindex) to not use indexes to satisfy the indicated condition
	;  PVA232  (12/03/2010) - Support optional second argument of %inlist() to provide a selectivity hint
	;  AK767   (02/16/2010) - Reduce DISTINCT for collations, expressions
	;  BJB444  (03/04/2010) - Support collation for LIKE with ALPHAUP
	;  PVA217  (01/26/2010) - Enhance collection predicate optimization to favor using collection indexes first in the join order
	;  PVA208  (11/10/2009) - Implement keyword to specify table to start joins from: %STARTTABLE
	;  PVA193  (07/20/2009) - TuneTable should Ignore Row Level Security
	;  PVA183  (05/26/2009) - Pre-optimizer support for TOP...ORDER BY in subqueries
	;  DPV3410 (05/14/2009) - Implement SQL schema search paths
	;  AK726   (02/26/2009) - Fix <FRAMESTACK> on unused or2in nodes
	;  DPV3369 (03/05/2009) - Report in contextdep() if there are reference to %CLASSNAME or %TABLENAME, unqualified names off for now
	;  DPV3316 (12/02/2008) - Support privileges on Cubes
	;  AK711   (09/19/2008) - Convert some OR to IN after parsing
	;  DPV3258 (09/26/2008) - Avoid <SUBSCRIPT> error if $p(v,"^",2,3) is long because of -> joins
	;  DPV3231 (08/05/2008) - Use process private global for ptln, ptrel
	;  AK701   (05/20/2008) - Collation of UNION virtual stream field
	;  DPV3131 (03/25/2008) - DD Lookup and Table compiler performance improvements
	;  DPV3121 (03/05/2008) - Implement LinkedTableMap to define fake master map for Linked tables
	;  PVA152  (11/08/2007) - Query Optimization improved for text and collection predicates
	;  PVA149  (10/15/2007) - Restore support of arrow syntax from view columns in post 2007.1 versions
	;  PVA139  (09/21/2007) - Allow updatable view to be streamed
	;  DPV2859 (02/16/2007) - GOTO info^%qaqpifo for readonly views in view info compile
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  DPV2807 (12/20/2006) - Put idifn in mts(m,str) for view info compile against external tables
	;                         SQL Fix ProdLog 55016:  Can't add WHERE clause to VIEW on ext. tables
	;  DPV2770 (10/20/2006) - Allow missing RowID/IDENTITY inINS/UPD of a view
	;  JLF125  (10/19/2006) - Support view on left of LOJ
	;  AK656   (09/29/2006) - No "updatable stream" if UNION or GROUP BY
	;  DPV2744 (09/25/2006) - Allow missing IDENTITY column in INSERT/UPDATE
	;  AK653   (08/01/2006) - Apply collation to LIKE
	;  PVA093  (07/21/2006) - Drop support for legacy not&, not! operators
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  PVA092  (06/24/2006) - Modify outer join data structure to avoid subscript size limit; assorted other outer join bugs
	;  AK651   (06/29/2006) - NVL inherits collation of its first argument
	;  PVA089  (06/08/2006) - Make PVA057 distinct/group by optimization depend on a 'fastdistinct' switch
	;  PVA087  (02/01/2006) - Extended Outer Join Support: Any ON clause for LEFT JOIN from base tables to a base table
	;  AK637   (11/10/2005) - Support FROM in UPDATE/DELETE
	;  JLF016  (02/17/2006) - Add Row-Level Security predicate here so collations get applied
	;  DPV2546 (11/08/2005) - Implement new MVR collation function.  Change collation implementations to use $zu(28)
	;  DPV2533 (10/12/2005) - Fix INSERT/SELECT into a view
	;                         SQL Fix ProdLog 46593: insert..select fails with <UNDEFINED>pushlog+3^%qaqpnl
	;  PVA076  (04/01/2005) - SELECT DISTINCT or SELECT of GROUP BY columns no failed to invoke LogicalToODBC
	;  AK632   (09/29/2005) - Mark rowid as "needed for output" for DELETE
	;  AK618   (01/27/2005) - Ignore NULLable keys for DISTINCT
	;  JMM006  (11/03/2004) - Permit INSERT INTO <table> DEFAULT VALUES for table with no columns except non-private rowid (i.e. identity column)
	;  AK613   (10/28/2004) - Don't apply Coll() to UnColl()
	;  PVA071  (10/25/2004) - Selecting from a view or FROM subquery that has GROUP BY or DISTINCT may returns invalid results
	;  JLF015  (03/22/2004) - Added support for %ANYOF
	;  JLF003  (10/08/2003) - EXISTS subquery flattening and EXISTS subquery to view transformations
	;  DPV2211 (04/22/2004) - For nuirn, nuifn, nuimp; bump appropriate $$$smd counter
	;  DPV2181 (02/26/2004) - Fix viewinfo compile - don't save/restore mt(v), just call info^%qaqpifo sooner
	;  PVA057  (11/07/2003) - Aggregate speed up: avoid data map access for aggregated collated values.
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;                         UPDATED on 01/26/2004 to fix DetermineQualifiedName
	;  PVA050  (02/12/2003) - ensure use of rowid based on one field, and the field itself are equally optimized
	;  DPV1970 (03/31/2003) - Allow creation of view with query against linked table
	;  DPV1936 (02/12/2003) - New variables:  append, lefts1, lni, log1, lr, str1
	;  DPV1831 (09/19/2002) - Fix display of error reporting in error(30) call from ddtab
	;  PVA042  (08/29/2002) - Improve queries containing NOT: some wrong answers fixed, and performance improved
	;  DPV1791 (08/12/2002) - Fix <UNDEFINED> in ddfldst
	;  DPV1748 (06/13/2002) - New ridfname
	;  PVA34   (03/15/2002) - Use more than one index per table for restriction
	;  DPV1693 (03/28/2002) - Support updatable views
	;  AK501   (12/13/2001) - Nataliya: Fix field list for outer join
	;  AK490   (09/25/2001) - SHD: Fix 'main table' logic
	;  PVA027  (08/01/2001) - Support a few optimizer directives on the FROM clause
	;  AK481   (07/27/2001) - SHD#25: Apply collation to IS [NOT] NULL
	;  DPV1559 (06/20/2001) - Handle Default Schame Name == Current SQL User Name
	;  AK462   (01/05/2001) - Magic: Apply collation to IN
	;  PVA021  (10/26/2000) - bitmaps: Pre-optimizer support for OR generalized CON node
	;  AK451   (09/06/2000) - Nataliya: Apply collation within aggregates
	;  AK446   (05/31/2000) - View stream processing
	;  DPV1324 (06/19/2000) - Use #import list of default schemas
	;  AK435   (04/04/2000) - EMIS: Reduce DISTINCT list
	;  DPV1279 (03/14/2000) - Eliminate dummy field check
	;  AK420   (01/10/2000) - Berne: Pre-optimizer OR constructs
	;  AK403   (10/28/1999) - Apply collation to equality conditions
	;  DPV1158 (10/12/1999) - Make [ not use collation function
	;  DPV1151 (10/01/1999) - Support SQLUPPER and SQLSTRING Collations
	;  DPV1149 (09/29/1999) - Store field des ref pointers as table name, not irn
	;  AK380   (07/08/1999) - CCS#37: OUTER JOIN with expression
	;  DPV1095 (06/28/1999) - Add truncate parameter to STRING function
	;  AK372   (06/04/1999) - Phil: T.* hides correctly
	;  AK361   (04/29/1999) - ODBC datatype reporting and conversion
	;  DPV1006 (04/07/1999) - String collation support
	;  DPV1007 (03/17/1999) - Preserve '_' in identifier names
	;                         Changed some $$$ALPHAUP to $$$IDName
	;  AK315   (05/12/1998) - CCS: Multifield outer-join
	;  DPV928  (12/04/1998) - Don't report hidden fields for INS, UPD, DEC, SEL
	;                         in 'star'
	;  AK318   (06/09/1998) - CCS:  Allow missing rowid in INSERT/UPDATE
	;  DPV837  (05/08/98)   - Remove dependencies on old datatype
	;  DPV811  (02/03/98)   - Make $$dummy call local
	;  DPV798  (01/09/98)   - Turn off Collation Expressions (MRP466)
	;                         for Cache SQL
	;  DPV768  (09/05/97)   - Made $$dummy a local call - eliminate %qarmisc
	;                         from compiler routine set.
	;  RLL651  (04/30/97)   - Do not use hidden fields on INSERT/UPDATE
	;                         with no column list; fixed error
	;                         detection for cardinality mismatch on
	;                         INSERT/UPDATE with no column list
	;  AK289   (04/07/97)   - Restructure INSERT/UPDATE
	;  MSS015  (02/27/97)   - Multi-Conditional OUTER JOIN are not supported
	;  AK286   (03/19/97)   - Use operation table (SQL categories) in QP
	;  DPV700  (12/18/96)   - Eliminate the qapqo^%qaqqt2 middle man for
	;                         better performance, move putstr to %qaqpqo2
	;                         Use mt( rather than just mt(
	;  MRP617  (06/11/96)   - Allow Duplicate SELECT-list Items
	;  MRP614  (06/02/96)   - Support SQL92 Column Name JOIN
	;  MRP612  (06/01/96)   - Support SQL92 NATURAL JOIN
	;  MRP608  (05/21/96)   - Support SELECT <qualifier>.<asterisk>
	;  MRP596  (04/01/96)   - Don't Apply Index Expression to Fields in a 
	;                         LIKE/%STARTSWITH/? Condition
	;  MRP589  (03/20/96)   - Confirm Cardinality Match between SELECT-list 
	;                         & INTO-list
	;  MRP552  (11/21/95)   - Don't allow Mutli-Line Fields in ORDER BY
	;  MRP541  (11/07/95)   - Allow LIKE & [ against Multi-Line Fields
	;  MRP518  (08/02/95)   - Don't add Index Expression to Field if
	;                         not a sub in an Index
	;  MRP513  (07/04/95)   - Disallow Redundant Fields in SELECT list
	;  MRP500  (05/09/95)   - Choose proper selectivity for fields &
	;                         mutate Foreign Keys in RowID to ->
	;  MRP466  (11/28/94)   - Handle Collation Expressions
	;                         --- cleaned up: old stuff in zqapqo ---
	;  VM012   (11/01/94)   - fix INSERT ... VALUES field number mismatch
	;  VM005   (10/26/94)   - fix an INSERT-SELECT field resolving bug
	;  MRP455  (10/21/94)   - Don't check privilages for DesRef fields
	;  MRP442  (08/24/94)   - Fix LIKE predicate to apply function properly
	;  MRP417  (07/19/94)   - Fix proper collation functions
	;  MRP393  (04/11/94)   - Don't apply collation functions to the
	;                         operands for the LIKE or ? operator
	;  MRP379  (03/04/94)   - Process new prefix extended functions 
	;                         (+, -, " ") for index maps
	;  MRP378  (03/01/94)   - Always apply functions (ALPHAUP, UPPER) 
	;                         to conditions if defined on the field
	;  AK268   (06/04/93)   - Remove duplicates from sort list
	;  AK023;AK028;AK069;SRH049;AK078;AK092;AK097;AK101;AK113;AK116
	;  AK153;AK157;AK168;AK180;ALL003;ALL001;ALL006;AK198;AK204
	;  RGG614;RGG625;RGG639;AK226;AK234;AK260
	;
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	if $extract($get(%caller),1,8)="ShowPlan" {
		if $extract(%caller,9,*)=3 {
			MERGE bmt("v")=mt("v")
		}
		if (",INS,UPD,DEL,")[(","_$Get($$$mtStatementType)_",") MERGE dmlmt=mt,dmlsql=sql
	}
	n a,append,b,bool,call,cls,clst,ev,ext,flagg,fn,fname,fval,i,id,idi,idifn,idsub,idv,ifn,ilev,imp,imp0,irn,join,k,l1,l2,l3,laggs,lefts,lefts1,leftv,lgi,li,link,linx,list,ln,lni,log,log1,logs,lx,m,maxm,maxs,ml,mlabel,mname,mpst,mv,newstr,node,nopad,ns,op,output,path,pi,pidi,pidv,pimp0,plog,pstr,ptl,ptlg,ptv,range,ridfname,ridifn,sel,selog,sfl,sinfo,sl,skip,str,str1,sub,table,tname,tup,type,v,v1,v2,v3,val,val1,val2,val3,vals,vi,x,xa,xb,%X,%Y  // DPV1693 (ridifn) // DPV1748 (ridfname) // DPV1936 (append, lefts1, lni, log1, str1)
	k $$$ptrelRoot
	#; PVA149: add the saved implicit join conditions to the WHERE clause;
	#;    Must be done here because arrow syntax can be encountered in the middle of an OR
	s val1="" f
	{  s val1=$o(impjns(val1)) q:'val1
	   s val2="" f
	   {  s val2=$o(impjns(val1,val2),1,val3) q:'val2
	      s val=+val3,m=$p(val3,",",2) d andwhere^%qaqpslx(val,m)
	   }
	}
	s ptv="ptv",maxm=$$$mtPNumQbs,(str,maxs)=0
	#; PVA304: add %partition
	f m=1:1:$$$mtPNumQbs i $$$mtPQbIsActive(m) s ptj(m,1)=",^," s:$g($$$mtWhere(m)) $$$mtWhere(m)=$$$mtWhere(m)_"^" s:$g($$$mtPartitionPredicates(m)) $$$mtPartitionPredicates(m)=$$$mtPartitionPredicates(m)_"^"
	d ptln
	  #; ------ Reslove SELECT * ------
	If $$$mtOutputVals($g($$$mtOutput(1)))="","DEC SEL"[$$$mtStatementType {  // SELECT *
		d star		// Expand SELECT *
		d chckcard	// Check SELECT-list/INTO-list Cardinality Match
	}
	d:"DEC SEL"[$$$mtStatementType starchk  ; Check for SELECT ...,t.*,...
		#; after we call star, check that the number of values in VALUE list is not less than the number of columns in INSERT table
	i $g($$$mtSelectInto)="","INS UPD"[$$$mtStatementType {
		do star
		if valins,valins'=$$bcount() { do error^%qaqpsq1($s(valins<$$bcount():62,1:116)) QUIT  }
	}
	new oldmtt
	i $g($$$mtOutput(1))'="",$$$mtOutputVals($$$mtOutput(1))="",$$$mtStatementType="INS" s oldmtt=$$$mtStatementType,$$$mtStatementType="SEL" d star s $$$mtStatementType=oldmtt i $l($p($$$mtSelectInto,"^",2),",")<$l($$$mtOutputVals($$$mtOutput(1)),",") d error^%qaqpsq1(64) q
	#; DPV1693
	i " INS UPD DEL "[(" "_$$$mtStatementType_" "),info d ddtab	// Catches updating operations against non-updatable views
	#; change %SYSTEM.RevM* to %RM*
	for val=1:1:$$$maxv set v=$p($$$mtV(val),":",1,3) set:$e(v,1,38)="v^USERDEFINEDFUNCTION:%SYSTEM.SQL:RevM" $p($$$mtV(val),"^",2)="%RM"_$e(v,39,*)
	g:info&&((callname'["view")||readonlyview=1) info^%qaqpifo  ;  Get DD info and get out! DPV2859= (Might also be a readonly view, don't care about checkoption code)
	#; DPV2181
	#;  If we a info compiling a view query, Do info^%qaqpifo and then return here to
	#;  continue into notnull processing in %qaqpnl
	do:info&&(callname["view") info^%qaqpifo
	#; DPV2181-
	#; DPV1693-
	#; ------ Lists all arrow->syntax links/conditions ------
	s linx=""
	#; ------ Process all fields and streams ------
	d mutatfld()
	#; PVA139: revert dpv1693 here; back to simple field loop.	
	f fval=1:1:$$$maxv s v=$$$mtV(fval) d:"f"=$e(v) field
	do fakeVDFIfn()
	#; Convert "ID"/"%ID" to legacy row ID (may be multipart %BARS expression) for BAT tables
	do bars()
	#; Ensure the legacy row ID will be available for queries where it's needed for (e.g.) %ROWID=
	do ensureBatRowId()
	#; ------ Add a field to fieldless streams (RID for bases) ------
	s ml=""
	f  d ddtab q:ml=""  i '$d($$$ptrel(ml)) s v="f^"_ml_"^"_$S($p(table,V,2)=3:$$ddfnext(""),1:$$ddrid) Set fval=$$$newval(v,1) d field
	#; PVA027
	#;  Build mts("streamorder",qoqn) from $$$mtFromList(qoqn). If later change decides to use one structure for
	#;   SELECT * ordering and for streamorder support, this logic would expand into a recursive algorithm to
	#;   extract underlying base tables, in proper FROM order, from a view reference in $$$mtFromList(..).
	f m=1:1:maxm 
	{  if $d(mts("streamorder",m)) 
#; PVA208: support %STARTTABLE
	   {  if $g(mt("hint",m,"%STARTTABLE")) {s mts("streamorder",m)=$lb($$$ptrel(m_"^"_$li($$$mtFromList(m),1)))} 
	      elseif $g(mt("hint",m,"%FIRSTTABLE"))]"" // PVA262: support %firsttable <ident>
	      {  if '$d($$$mtFLabelsSaveNode(m,mt("hint",m,"%FIRSTTABLE"))) {k mt("hint",m,"%FIRSTTABLE"),mts("streamorder",m)}
	         else 
	         {  s mt("hint",m,"%STARTTABLE")=1
	            s mts("streamorder",m)=$lb($$$ptrel($o($$$mtFLabels(m,mt("hint",m,"%FIRSTTABLE"),""))))
	         }
	      }
	      else { f m1=1:1:$ll($$$mtFromList(m)) s mts("streamorder",m)=mts("streamorder",m)_$lb($$$ptrel(m_"^"_$li($$$mtFromList(m),m1)))}
	   }
	}
	#; PVA027-
	#;  List of potential outer-joins - convert each link to a log#
	f ln=1:1 s link=$p(linx,"^",ln) q:link=""  d linx s $p(linx,"^",ln)=val
	f m=1:1:$$$mtPNumQbs{  ;  IBA001
		s output=0
		d lflds^%qaqpnl("l",$g($$$mtWhere(m)),"do")
		k output
	}
	f m=1:1:$$$mtPNumQbs {
		s logs=$g($$$mtWhere(m))
		f lgi=1:1:$l(logs,"^")-1{
			s log=$p(logs,"^",lgi)
			d xformCond^%qaqpnl(log,m)
		}	
	}  ;  IBA001-
	d addPrunePartitions^%qaqpnl	
	#;  clear $p(3) field-list and ptv() flags  ;  AK1093
	f val=1:1:$$$maxv s:"vleaqn"[$$$mtVType($$$mtV(val)) $p($$$mtV(val),"^",3)=""
	f log=1:1:$$$maxl s:$$$mtLType($$$mtL(log))'="i" $$$mtLColVals($$$mtL(log))=""
	#; AK286
	d docats^%qaqpdt  ;  Modify query based on the OPT, also generate vtree
	
		#; If we have PREDICT or PROBABILITY WITH columns that need type checking, we can do it now
	if 'info,$d($$$mtQuickMLTypeCheckRoot) { do MLTypeCheck() }
	#; AK286-
	#; JLF016
	#; Apply Row-Level Security here so that proper collations get added below
	if '($$$SQLCompileOption("TuneTable")=1) { for m=1:1:$$$mtPNumQbs { do:$$$mtPQbIsActive(m) applyRLS^%qaqpre2(m) } }
	#; JLF016-
	#;  Now start optimizing the conditions
	#; ------ mt("w",m)= list of top-level AND conditions ------
	#; PVA087: Change 'where' to take arguments and use for deferred ON clauses
	f m=1:1:$$$mtPNumQbs { s logs=$g($$$mtWhere(m)) f lgi=1:1 { s log=$p(logs,"^",lgi) q:log=""  d where(.logs,log,.lgi) } s:$d($$$mtWhere(m)) $$$mtWhere(m)=logs }
	#; PVA304: %partition 
	f m=1:1:$$$mtPNumQbs { s logs=$g($$$mtPartitionPredicates(m)) f lgi=1:1 { s log=$p(logs,"^",lgi) q:log=""  d where(.logs,log,.lgi) } s:$d($$$mtPartitionPredicates(m)) $$$mtPartitionPredicates(m)=logs }
	#; AK711
	f m=1:1:$$$mtPNumQbs s logs=$g($$$mtWhere(m)) f lgi=1:1 s log=$p(logs,"^",lgi) q:log=""  d or2in
	do flattenJoinConditionsAndMoveINNERToWhere(1, '$d($$$ForeignTables))
	#; set external connections info
	d calcQBOrder^%qaqpnl(1)
	d setExternal
	// MJG291 - Move all FTs into a subquery -- and for SOME of them, also move things like WHERE conditions, aggregates, grouping
	// Doing this here will mean top-level ANDs are flattened; linx, topoqb are already created; "ON" will be slightly refactored; nulstr NOT yet created
	if $d($$$ForeignTables) {
		do foreignTablePushdown^%qaqpftpd()
		do flattenJoinConditionsAndMoveINNERToWhere(0, 1)
	}
	#; Lookup index for SEARCH_INDEX function
	for val=1:1:$$$maxv { 
		set v=$$$mtV(val) 
		if $e(v)="v",$p(v,"^",4)'="",$e($$$mtV($p(v,"^",4)))="s" { set $p($$$mtV(val),"^",4) = $p($$$mtV($p(v,"^",4)),"^",4) }
		if $e(v,1,15)="v^SEARCH_INDEX:" {
				#; Turn SEARCH_INDEX into USERDEFINEDFUNCTION for code generation
				#; findIndex returns Classname:Indexname
				#; The $c(1) at the end of the method name signal the code generator that this is a SEARCH_INDEX call
			set $p($$$mtV(val),"^",2)="USERDEFINEDFUNCTION:"_$$findIndex($p($p(v,"^",2),":",2), val)_"Find"_$c(1)
		}
	}
	#; collation procession
	#; A. in ST, replace COLL(f) with f_COLL
	for val=1:1:$$$maxv {
		if $$isWindow^%qaqpagg(val) do collateWindow(val)
	}
	for val=1:1:$$$maxv {
		set v=$$$mtV(val) 
		if $e(v)="v" {
			set fn=$p(v,"^",2)
			if (($$$ISENCODEDCOLLATE(fn))||(",%ANYOF,%ANYOFKEY,%ALPHAUP,%UPPER,%SQLSTRING,%SQLUPPER,%STRING,%PLUS,%MINUS,%SPACE,%MVR,%TRUNCATE,"[(","_$p($p(fn,"("),":")_","))) {
				set v=$$$mtV($p(v,"^",4)) 
				if $e(v)="f" { 
					set str=$p(v,"^",2),m=$$$mtRQb($$$mtR(str)) 
					do nuatt(val,str,$p(v,"^",3)_"_"_$tr(fn,":"))
				} 
				elseif $e(v)="n" { set $$$mtV(val)="n^^^"_$$coll($p(v,"^",4),fn)_"^" }  ;  JLF015
			}
		}
	}
	for val=1:1:$$$maxv { // YWH006 CHECK vector function to take only vector type or its subclass
		set v=$$$mtV(val) 
		if $e(v)="v" {
			set fn=$p(v,"^",2)
			if $case(fn,"VECTOR_DOT_PRODUCT":1,"VECTOR_COSINE":1,:0) {
				for pi = 4,5 {
					CONTINUE:($$$VTRgettype($p(v,"^",pi))="var")||($$$mtV($p(v,"^",pi))="t^") // Skip if the argument is a variable or NULL
					if '$$checkDataType^%apiDDL2($$$VTRgetdt($p(v,"^",pi)),$lb("%Library.Vector")) { // check that it is a vector or its subclass
						do error(254) // not vector or its subclass
					} elseif '$$VectorSearch^%SYS.LICENSE() { // YWH010 - check vector license bit
						do error(256) // vector search not supported for current license
					}
					new argIFN,argIRN,v1
					set argIFN=$$$VTRgetifn($p(v,"^",pi)), argIRN=$$$VTRgetirn($p(v,"^",pi))
					if argIFN'=""{
						set v1 = $$$smdSchema(1,argIRN)_ "." _ $$$smdName(1,argIRN) _ "." _ $$$smdColName(1,argIRN,argIFN)
						do:("STRING,TIMESTAMP"[$$$smdColVectorDatatype(1,argIRN,argIFN)) error(258) // YWH014 - check if both expressions are supported datatypes
						do:$$$smdColVectorLength(1,argIRN,argIFN)="" error(260) //YWH014 - prevent vector operations on unspecified length
					}
				}
				// if both expressions for the vector functions are fields or query blocks, check if they match
				if ("fq"[$e($$$mtV($p(v,"^",4))))&&("fq"[$e($$$mtV($p(v,"^",5)))) {
					// Simplify if we have the same vector for VECTOR_COSINE
					if fn="VECTOR_COSINE"&&($p(v,"^",4)=$p(v,"^",5)) {set $$$mtV(val)="t^1" CONTINUE}
					do checkVectorCol($p(v,"^",4),$p(v,"^",5))
				}
			}
		}
	}
	d non2n  ;  previous line (and parsing) could result in n-to-n nodes
	#; AK451,PVA057 - Better to do this before conditions. This allows for the possibility
	#;  of col < max(col2) to discover that collate(uncollate(max(collate(col2)))) can become 
	#;  max(collate(col2)). If aggregates are done later, performing this optimization would 
	#;  require tracking down the expression containing the aggregate.
	#;  apply collation to aggregate's %FOREACH/DISTINCT BY 
	#; PVA057: transform max/min of a collated column to be e.g.: <uncollate>(max(<collate>(<column>)))
	#; Note that we don't want to eliminate streamless DISTINCT values for aggregates (only eliminate when pi'=7)
	new mTopo
	for mTopo=maxm:-1:1 
	{	s m=mt("qbo",mTopo) 				; YCL408 - In bottom-up topological order
		set laggs=$$$mtPAggList($$$mtP(m))
		for li=1:1:$l(laggs,",")-1 {
			set fval=$p(laggs,",",li)
			set v=$$$mtV(fval)
			for pi=6,7 {
				s $p($$$mtV(fval),"^",pi)=$$redist($$colist($p(v,"^",pi)),,$s(pi=6:2,1:0),m)
			}
			d:" max min "[(" "_$p(v,"^",2)_" ") maxfrm(fval)
			#; DAP003
			#; Apply collation to SELECT COUNT as well as MIN and MAX
			#; Careful to exclude the SELECT COUNT(*) case when $p(v,"^",5)=""!
			d:((" count "[(" "_$p(v,"^",2)_" ")) && ($p(v,"^",5)'="")) maxfrm(fval)
			#; DAP003-
		}
	}
	
	#; AK451,PVA057 - Better to do this before conditions. This allows for the possibility-
	#;  B. Apply collations to conditions
	f log=1:1:$$$maxl s v=$$$mtL(log) i $e(v)="v","'<'>%STARTSWITH']'="[$p($p(v,"^",2),"%NOINDEX") d logfn // PVA242
	#; AK462
	#; PVA232: Don't collate the optional size argument of %inlist
	#;  Apply collations to IN using left-side collation, per SQL Standard
	#; PVA242: handle %noindex
	f log=1:1:$$$maxl s v=$$$mtL(log) i $p($p(v,"^",2),"%NOINDEX")="IN"||($p($p(v,"^",2),"%NOINDEX")="INSET") s fn=$$ddfun($p(v,"^",4)) f pi=4:1:$l(v,"^")-1 if '($p($p(v,"^",2),"%NOINDEX")="INSET"&&(pi>5)) s $p($$$mtL(log),"^",pi)=$$coll($p(v,"^",pi),fn)
	#; AK462-
	#; AK653
	#;  Apply collations to LIKE using left-side collation
	#; BJB444
    #; PVA242: handle %noindex
	f log=1:1:$$$maxl s v=$$$mtL(log) i $p($p(v,"^",2),"%NOINDEX")="%PATTERN",$e($$$mtV($p(v,"^",5)),1,9)="v^%L2PAT^" s fn=$$ddfun($p(v,"^",4)) i (("%SQLSTRING %SQLUPPER %UPPER %SPACE"[$p(fn,"("))||$$$ISENCODEDCOLLATE(fn)) {s $$$mtLOperand1($$$mtL(log))=$$coll($p(v,"^",4),fn),$p($$$mtV($p(v,"^",5)),"^",4)=$$coll($p($$$mtV($p(v,"^",5)),"^",4),fn) } if $p(fn,"(")="%ALPHAUP" {s $$$mtLOperand1($$$mtL(log))=$$coll($p(v,"^",4),fn),$p($$$mtV($p(v,"^",5)),"^",2)="%L2PATAU" }
	#; BJB444-
	#; AK653-
	#;  Apply exact-style collations to MATCHES using left-side collation
	for log=1:1:$$$maxl {		// DPV3596=
		set v=$$$mtL(log) 
		if $p($p(v,"^",2),"%NOINDEX")="%MATCHES",$e($$$mtV($p(v,"^",5)),1,15)="v^%MATCHES2PAT^" { // PVA242
			set fn=$$ddfun($p(v,"^",4)) 
			if $case(fn,"%SQLSTRING":1,"%SPACE":1,:0) {	// Does not occur if %SQLSTRING(len)
				set $$$mtLOperand1($$$mtL(log))=$$coll($p(v,"^",4),fn)
				set $p($$$mtV($p(v,"^",5)),"^",4)=$$coll($p($$$mtV($p(v,"^",5)),"^",4),fn)
			}
		}
	}
	#; AK481
	#;  Apply collations to IS [NOT] NULL
	f log=1:1:$$$maxl s v=$$$mtL(log) i $p($tr($p(v,"^",2),"'"),"%NOINDEX")="NULL" s fn=$$ddfun($p(v,"^",4)) s $$$mtLOperand1($$$mtL(log))=$$coll($p(v,"^",4),fn) // PVA242
	#; AK481-
	#;  C. apply collation to GROUP BY/DISTINCT 
	f m=1:1:$$$mtPNumQbs i $$$mtPQbIsActive(m),($e($g($$$mtOutput(m)))="d")||($g($$$mtGroupDistinctList(m))) d groupm
	#;  C.2 apply UNCOLL(COLL(f)) to GROUP BY/DISTINCT fields  ;  PVA057
	#; PVA057: Transform references to grouping columns into uncollate(ifn_collate) in the 
	#;          HAVING clause
	#; PVA089: Don't do this if fastdistinct disabled
	if $$$FastDistinct s call="xfrmgrp^%qaqpqo" f m=1:1:$$$mtPNumQbs i $$$mtPQbIsActive(m),$d($$$mtHaving(m)) d lvtreemod^%qaqpnl("l",$$$mtHaving(m))
	#; PVA057: Transform references to grouping or DISTINCT BY columns into uncollate(ifn_collate)
	#;         in the SELECT clause.
	#; NOTE: reference to $e($g($$$mtOutput(m)))="d" will need to change when DISTINCT ... GROUP BY is fixed.
	#; PVA089: Don't do this if fastdistinct disabled
	if $$$FastDistinct 
	{ s call="xfrmgrdst^%qaqpqo" f m=1:1:$$$mtPNumQbs 
	  { 
		i $$$mtPQbIsActive(m),$e($g($$$mtOutput(m)))="d" 
		{ 
			s x=$$$mtOutputVals($$$mtOutput(m)) 
			for li=1:1 
			{   s v=$p(x,",",li) q:v=""  s $p(x,",",li)=$$lvtreemod^%qaqpnl("v",v)
				#; PVA071: if SELECT val# changes and m is a streamed view, must change mt("virf")
				if v'=$p(x,",",li),$$$mtPViewIDVal($$$mtP(m))>0 
				{
					s $li($$$mtVirf($p($$$mtV($$$mtPViewIDVal($$$mtP(m))+li),"^",3)),2)=$p(x,",",li)
				}
			} 
			s $$$mtOutputVals($$$mtOutput(m))=x 
		}
	  } 
	}
	#; PVA087: 'missed' xfrmgrdst opportunity - should only happen as a result of support
	#;          updated table joined to a streamed view. 
	#; PVA089: Don't do this if fastdistinct disabled
	if $$$FastDistinct s m=1 	for li=1:1 s v=$p($g($$$mtNewVals),",",li) q:'v  s $p($$$mtNewVals,",",li)=$$lvtreemod^%qaqpnl("v",v)
	#;  C.3 reduce GROUP BY/DISTINCT list using $$redist()  ;  AK1084
	#;  (moved here from groupm() above to be after UNCOLL(COLL(f))
	f m=1:1:$$$mtPNumQbs i $$$mtPQbIsActive(m),$g($$$mtGroupDistinctList(m)) d grpred
	#;  D. apply collation to ORDER BY 
	f li=1:1 s val1=$p($g($$$mtSequencers),",",li) q:'val1  s $p($$$mtSequencers,",",li)=$$coll(+val1,1)_$e("d",val1["d")
	f m=1:1:$$$mtPNumQbs // PVA183: also for subqueries
	{   continue:'$$$mtPQbIsActive(m)
		f li=1:1 s val1=$p($g($$$mtSequencersQb(m)),",",li) q:'val1  s $p($$$mtSequencersQb(m),",",li)=$$coll(+val1,1)_$e("d",val1["d")
	}
	#;  D.2. apply collation to UNION [ALL] ORDER BY 
	if $d($$$mtUnionOrderBy) {
		#; collect union legs
		new coll,tcoll,unlegs
		set unlegs=""
		f m=1:1:$$$mtPNumQbs {
			set:($$$mtPQbIsActive(m))&&($g($$$mtUnionTopQb(m))=1) unlegs=unlegs_$LB(m)	
		}
		f li=1:1 {
			#; li is the pos of value in the mt("uns")
			#; mt("uns") contains the pos in the output
			s pos=$p($g($$$mtUnionOrderBy),",",li) 
			q:'pos  
			set i=0,coll="*"
			while $LISTNEXT(unlegs,i,m) {
				s tcoll=$$ddfun($p($$$mtOutputVals($$$mtOutput(m)),",",pos))
				set coll=$s(coll_tcoll="**":"*",1:$$fnfn(coll,tcoll))
   			}
			if "*"'[coll {
				if $$$CompatibilityPreUnionCollation {
					set mt("compatibility","PreUnionCollation")=1
					QUIT
				}
				set $p($$$mtUnionCollation,",",li)=coll
			}
		}
	}
	#; E. Apply collation for UNION output
	d collUnion
	#; F. in ST, replace COLL(x^(NN=f)) with x^(MM=COLL(f)),
	#; so that we don't need to retrieve f if it's not needed.
	for val=1:1:$$$maxv {
		set v=$$$mtV(val) 
		if $e(v)="v" {
			set fn=$p(v,"^",2)
			if (($$$ISENCODEDCOLLATE(fn))||(",%ANYOF,%ANYOFKEY,%ALPHAUP,%UPPER,%SQLSTRING,%SQLUPPER,%STRING,%PLUS,%MINUS,%SPACE,%MVR,%TRUNCATE,"[(","_$p($p(fn,"("),":")_","))) {
				set v=$$$mtV($p(v,"^",4)) 
				if $e(v)="x",v=("x^"_+$e(v,3,*)),v'="x^0" { set $$$mtV(val)="x^"_$$coll($e(v,3,*),fn) }
			}
		}
	}
	#; PVA057: Do all removal of %EXACT here
	s call="killexact^%qaqpqo"
	f m=1:1:$$$mtPNumQbs {
		i $$$mtPQbIsActive(m) {
			s x=$$$mtOutputVals($g($$$mtOutput(m))) continue:x=""
			for li=1:1 {
				s v=$p(x,",",li) q:v=""  s $p(x,",",li)=$$lvtreemod^%qaqpnl("v",v)
				#; PVA071: if SELECT val# changes and m is a streamed view, must change mt("virf")
				set:v'=$p(x,",",li)&&($$$mtPViewIDVal($$$mtP(m))>0) $li($$$mtVirf($p($$$mtV($$$mtPViewIDVal($$$mtP(m))+li),"^",3)),2)=$p(x,",",li)
			}
			s $$$mtOutputVals($$$mtOutput(m))=x
		}
	}
	#; AK726
	f m=1:1:$$$mtPNumQbs i $$$mtPQbIsActive(m) d lvtreemod^%qaqpnl("l",$G($$$mtHaving(m))) s logs=$g($$$mtWhere(m)) f lgi=1:1:$L(logs,"^")-1 d lvtreemod^%qaqpnl("l",$p(logs,"^",lgi))
	#; PVA304: %partition
	f m=1:1:$$$mtPNumQbs i $$$mtPQbIsActive(m) s logs=$g($$$mtPartitionPredicates(m)) f lgi=1:1:$L(logs,"^")-1 d lvtreemod^%qaqpnl("l",$p(logs,"^",lgi))
	f m=1:1:$$$mtPNumQbs 
	{  continue:'$$$mtPQbIsActive(m)
	   s i="" f 
	   { s i=$o($$$mtOn(m, i),1,xa) q:i=""
	     s logs=$li(xa,2)
	          f lgi=1:1 { s log=$p(logs,"^",lgi) q:log=""  d lvtreemod^%qaqpnl("l",log) }
	   }
	   }
	#; PVA342: killexact for stored aside RLS predicates
	s str="" for 
	{ s str=$o(mt("RLS",str),1,val) q:str=""  continue:$$$mtRQb($$$mtR(str))'=m
	  d lvtreemod^%qaqpnl("l",val)
	}	
	
	f m=1:1:$$$mtPNumQbs i $$$mtPQbIsActive(m) for li=1:1 s v=$p($g($$$mtGroupDistinctList(m)),",",li) q:v=""  s $p($$$mtGroupDistinctList(m),",",li)=$$lvtreemod^%qaqpnl("v",v)
	f m=1:1:$$$mtPNumQbs i $$$mtPQbIsActive(m) for li=1:1 s v=$p($g($$$mtDistinct(m)),",",li) q:v=""  s $p($$$mtDistinct(m),",",li)=$$lvtreemod^%qaqpnl("v",v)
	#; PVA087: handle a few missed killexact opportunities
	#; PVA183: ORDER BY in subqueries
	f m=1:1:$$$mtPNumQbs i $$$mtPQbIsActive(m) { for li=1:1 s v=$p($g($$$mtSequencersQb(m)),",",li) q:'v  s $p(v,"d")=$$lvtreemod^%qaqpnl("v",+v),$p($$$mtSequencersQb(m),",",li)=v }
	s m=1
	for li=1:1 s v=$p($g($$$mtSequencers),",",li) q:'v  s $p(v,"d")=$$lvtreemod^%qaqpnl("v",+v),$p($$$mtSequencers,",",li)=v
	for li=1:1 s v=$p($g($$$mtNewVals),",",li) q:'v  s $p($$$mtNewVals,",",li)=$$lvtreemod^%qaqpnl("v",v)
	#; PVA183: move later: killexact can create opportunities for duplicate removal
	#;  remove duplicates from ORDER BY
	f li=2:1 s val1=+$p($g($$$mtSequencers),",",li) q:'val1  s:","_$TR($p($$$mtSequencers,",",1,li-1),"d")_","[(","_val1_",") $p($$$mtSequencers,",",li,*)=$p($$$mtSequencers,",",li+1,*),li=li-1
	f m=1:1:$$$mtPNumQbs // PVA183: also for subqueries
	{  continue:'$$$mtPQbIsActive(m)
	   f li=2:1 s val1=+$p($g($$$mtSequencersQb(m)),",",li) q:'val1  s:","_$TR($p($$$mtSequencersQb(m),",",1,li-1),"d")_","[(","_val1_",") $p($$$mtSequencersQb(m),",",li,*)=$p($$$mtSequencersQb(m),",",li+1,*),li=li-1
	}
	#; Remove trailing order by entries implied by previous entries
	if $g($$$mtSequencers) {             // handle "statement level" ORDER BY
		set $$$mtSequencers=$$prunesort($$$mtSequencers,$g($$$mtGroupDistinctList(1)),1)
		if $$$mtSequencers="" zkill $$$mtSequencers
	}
	f m=1:1:$$$mtPNumQbs          // also for subqueries
	{   continue:'$$$mtPQbIsActive(m)  // skip obsolete query
		continue:'$g($$$mtSequencersQb(m))  // no order by for this subquery
		set $$$mtSequencersQb(m)=$$prunesort($$$mtSequencersQb(m),$g($$$mtGroupDistinctList(m)),m)
		if $$$mtSequencersQb(m)="" kill $$$mtSequencersQb(m)
	}
	#; YCL254 rewrite NULL Handling Functions and CASE
	d nulHandlingFuncOpt
	GOTO ^%qaqpnl  ; ->> Handle conditions and maps
.
   // Check two vector columns in conditions or vector operations: length and stored datatype
   // arg1, arg2 - mt("v") entries for vector columns
checkVectorCol(arg1,arg2) [mt,v1,v2] public {
	// skip the check if either of the arguments is not a field or a query block
	RETURN:("fq"'[$$$mtVType($$$mtV(arg1)))||("fq"'[$$$mtVType($$$mtV(arg2))) 
.
	new v1,v2 // the two vectors schema.TableName.ColumnName
	set arg1IFN = $$$VTRgetifn(arg1), arg2IFN = $$$VTRgetifn(arg2)
	set arg1IRN = $$$VTRgetirn(arg1), arg2IRN = $$$VTRgetirn(arg2)
	set v1 = $$$smdSchema(1,arg1IRN)_ "." _ $$$smdName(1,arg1IRN)_ "." _ $$$smdColName(1,arg1IRN,arg1IFN)
	set v2 = $$$smdSchema(1,arg2IRN)_ "." _ $$$smdName(1,arg2IRN)_ "." _ $$$smdColName(1,arg2IRN,arg2IFN)
	
	do:$$$smdColVectorLength(1,arg1IRN,arg1IFN)'=$$$smdColVectorLength(1,arg2IRN,arg2IFN) error(257)  // vector length mismatch
	do:$$$smdColVectorDatatype(1,arg1IRN,arg1IFN)'=$$$smdColVectorDatatype(1,arg2IRN,arg2IFN) error(259) // vector type mismatch
	// if both of the vector fields have unspecified length
	do:$$$smdColVectorLength(1,arg1IRN,arg1IFN)="" error(260)
}
.
.
/// For every query block, flatten JOIN conditions to top-level ANDs and transform any query block whose entire mt("ON")
/// structure is only INNER JOINs to become CROSS JOINs with the conditions in the WHERE clause
///
///	Parameters:
///		flattenConditions		- (optional, default 1) if true, flatten the conditions. When foreign tables are present
///									we break this up into two passes: one to flatten, then do pushdown analysis, then
///									move to WHERE. Otherwise we may miss out on pushing INNER JOINs
///		moveToWhere				- (optional, default 1) if true, transform all-INNER-JOIN into WHERE clause. When foreign
///									tables are present, it will call this procedure in a first pass to only flatten conditions
///									so this will be set to false.
flattenJoinConditionsAndMoveINNERToWhere(flattenConditions=1,moveToWhere=1) [m,mt] PRIVATE {
	#; PVA092; new mt("ON",) structure
	for m=1:1:$$$mtPNumQbs { 
		set i="",skip=0
		for {
			set i=$o($$$mtOn(m, i),1,xa) q:i=""
			if flattenConditions {
				set logs=$li(xa,$$$SQLONPREDICATE)
				for lgi=1:1 { s log=$p(logs,"^",lgi) q:log=""  d where(.logs,log,.lgi) }
				set $li($$$mtOn(m, i),$$$SQLONPREDICATE)=logs	
			}
			#; If any non-inner join do not apply this optimization
			if $li(xa,$$$SQLONOPERATOR)'=$$$SQLONINNERJOIN set skip=1
		}
		#; Move join conditions to where clause here (complex analysis of this involving outer join is done in propagatePreds^%qaqpnl)
		if moveToWhere, 'skip, '$d($$$FTRegeneratedQueryBlock(m)) {
			set i=""
			for {
				set i=$o($$$mtOn(m, i),1,xa) q:i=""
				set $$$mtWhere(m)=$g($$$mtWhere(m))_$li(xa,$$$SQLONPREDICATE)
				kill $$$mtOn(m, i)
			}
		}
	}
}
.
moveOnlyINNERJoinsToWhere() [m,mt] PRIVATE {
.
}
.
#; Passed in a ORDER BY, reduces this by looking if items are dependent on prior items and if so removing these.
#; as $$fd includes streamless WHERE conditions in its dependancy analysis this will remove ORDER BY on these fields too
#; Also if there are unique required fields (or fields making up the compound IDKEY) anything after these is dependent
#; on the unique required field so these get removed too
prunesort(sort,groups,m) [mt] public {
	if sort="" RETURN sort
	set newsort=""
	#; Look to see if any of the fields in the ORDER BY list are implied by prior fields and if so remove it
	for li=$l(sort,",")-1:-1:1 {
		// YWH009 - Prevent vectors or their subclasses in ORDER BY clause
		do:$$checkDataType^%apiDDL2($$$VTRgetdt(+$p(sort,",",li)),$lb("%Library.Vector")) error(255) // YWH014 deal with desc
		set order=$p(sort,",",li)_",",previous=$tr($p(sort,",",1,li-1)_$s(li=1:"",1:","),"d")
		#; If there is a GROUP BY and the previous implies the group then we do not need this order item
		if groups'="",$$fd^%qaqpre3(previous,groups) { continue }
		if '$$fd^%qaqpre3(previous,$tr(order,"d")) { set newsort=order_newsort  continue }
		if +$$windows^%qaqpagg(+order) { set newsort=order_newsort continue }
	}
	if sort'=newsort do logopt^%qaqpagg("sort","m="_m_" : "_sort_" -> "_newsort)
	RETURN newsort
}
.
#; For all the where conditions if they are streamless add them to the vars reference and return this list
eqflds(m) [mt] public {
	set logs=$g($$$mtWhere(m)),vars=""
	for lgWhr=1:1:$l(logs,"^")-1 {
		set log=$p(logs,"^",lgWhr)	
		set mtlog=$$$mtL(log)
		if ($p(mtlog,"^",2))'="=" continue
		for arg=4,5 {
			if $e($$$mtV($p(mtlog,"^",arg)))="f",$$isStreamless^%qaqpre($$$mtV($p(mtlog,"^",9-arg))) {
				set vars=vars_$p(mtlog,"^",arg)_","
				QUIT
			}
		}
	}
	RETURN vars
}
.
.
#; Return $bit of streams in m, and "" if any virtual streams
mstr(m) [mt] public {
	set bitmap=""
	for str=1:1:$o($$$mtR(""),-1) {
		if $$$mtRQb($$$mtR(str))'=m continue
		RETURN:$d($$$mtRVirtual(str)) ""      // Virtual stream
		RETURN:$d($$$mtTvfParams(str)) ""  // tvf
		///RETURN:$$$IsFTStream(str) ""  		// foreign tables
		set $bit(bitmap,str)=1
	}
	RETURN bitmap
}
.
	// Return the number of entries in $$$mtSelectInto
bcount() [mt] PUBLIC {
	QUIT ($l($$$mtSelectInto,",")-1)
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK831
non2n	n val,crf,ii,v  ;  make sure no "n" node points to another "n" node
	f val=1:1:$$$maxv s crf=val f ii=1:1 { s v=$$$mtV(crf) q:$e(v)'="n"  s crf=$p(v,"^",4) } s:ii>2 $p($$$mtV(val),"^",4)=crf
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK831-
	#; AK711
or2in	n v,inarg,v5  ;  maybe convert log from OR to IN (no $P(3)!)
	s v=$$$mtL(log),inarg=""
	f  {    i $e(v,1,4)="v^=^",$p(v,"^",4)=+inarg,inarg["^","tx"[$e($$$mtV($p(v,"^",5))) s $p(inarg,"^")=$p(v,"^",4,5),$$$mtL(log)="v^IN^^"_inarg_"^" QUIT
		QUIT:$e(v,1,4)'="l^!^"
		s v5=$$$mtL($p(v,"^",5))
		QUIT:$e(v5,1,4)'="v^=^"  ;  not an =
		QUIT:"tx"'[$e($$$mtV($p(v5,"^",5)))  ;  not const/var
		QUIT:($p(v5,"^",4)'=+inarg)&&(inarg'="")  ;  not an =
		s $p(inarg,"^")=$p(v5,"^",4,5),v=$$$mtL($p(v,"^",4))
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK711-
mutatfld() [mt] PUBLIC {
	#; Mutate Foreign Key Fields in RowID to -> syntax
	For fval=1:1:$$$maxv {
		s v=$$$mtV(fval)
		If "f"=$e(v) {	// Maybe Mutate...
			continue:$p(v,"^",2,3)["->"		// DPV3258
			s fname=$p(v,"^",4),tname=$$$IDName($g($$$mtFromTableName($p(v,"^",2,3))))
			continue:tname=""||(fname="")||($e(tname,1,3)="%%Q")		// MUST have an explicit, real Table & Field Name!!!
			set irn=$$$smdLoadGetIrn(tname,$g($$$mtTvf(+$p(v,"^",2,3),tname)))
			continue:'irn  
			set ifn=$o($$$smd(1,irn,"f",fname,""))
			continue:(irn&&ifn)||($$$smdParentTable(1,irn)="")		// Field in this Table.  No mutation necessary... or No Parent Defined for this table...
			#; ------ Search for Mutation Possibilities ------
			#; s arrowfld=$$findfld($$$smdExtent(1,irn),fname),arrowlen=$l(arrowfld)
			s arrowfld=$$findfld(irn,fname),arrowlen=$l(arrowfld)	// DPV3064
			s:$e(arrowfld,arrowlen-1,arrowlen)="->" arrowfld=""
			s $p($$$mtV(fval),"^",4)=$s(arrowfld'="":arrowfld,1:fname)
		}
	}
	QUIT
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
findfld(irn,fname) [] PUBLIC {	// Find the field 'fname' in one of the RowID based on fields. (DPV3064)
	QUIT:'irn ""  // No Table ID present!!
	s foundfld="",parfld=+$g($$$smd(1,irn,"col",0)),idbased=$$idbased(irn)
	f i=$l(idbased,",")-1:-1:1 {  ; Find Field...
		s idifn=$p(idbased,",",i) q:idifn=""||(foundfld'="")
		continue:'$d($$$smd(1,irn,2,idifn))  ; Field not in this table...
		s:idifn=$o($$$smd(1,irn,"f",fname,"")) foundfld=fname
	}
	QUIT:foundfld'="" foundfld  ; Found the Field...
	QUIT:parfld $$$IDName($p($g($$$smd(1,irn,2,parfld,1)),$c(1)))_"->"_$$findfld($$$smdLoadGetIrn($$$smdParentTable(1,irn)),fname)	// This call oK, parent table cannot be a table function
	QUIT ""  ; Can't go any higher!!
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	// Given an MapName, look up the index map and then return the classname and object index name this index map was projected from.
	// pMapName is assumed to be not NULL. val is the subscript in $$$mtV(val)=v^SEARCH_INDEX:[pMapName]. This is used for the SEARCH_INDEX function.
findIndex(pMapName, val) [mt] PUBLIC {
	new %tMapName
	set tClassname="",tIndexName=""
	if $l(pMapName,".")=3 {	// Schema.Table.SQLMapName
		set tname=$p(pMapName,".",1)_"."_$p(pMapName,".",2),tMap=$p(pMapName,".",3)	// tname variable used if we need to report table not found
		set irn=$$$smdLoadGetIrn(tname)	// no need for table function logic here, tvf don't have indices
		do:irn="" error(30)
		if '$$findIndexInTable(irn,tMap,.tClassname,.tIndexName) do error(151)	// *** error!
	}
	elseif $l(pMapName,".")=2 {	// Table.SQLMapName, no Schema, need to search all tables in the query
			// Could also be an alias, suppress the name check
		set tMap=$p(pMapName,".",2)
		set m = mt("search_index", pMapName, val)   // set relevant query block to be block this index is invoked in 
		set lbl=""
		for  {
			set lbl=$o($$$mtFLabelsSaveNode(m,lbl)) q:lbl=""
			set fitem=""
			for  {
				set fitem=$o($$$mtFLabels(m,lbl,fitem),1,tData) q:fitem=""
			//	if $$$UPPER($p(pMapName,"."))=$$$UPPER($tr($$$LastPiece($lg(tData,1),"."),$c(2),".")) {	// Search all tablenames that match for this map (probably just one cout could be A.tab, B.tab
					set tname=$lg(tData,1)
					continue:$e(tname,1,3)="%%Q"
					set irn=$$$smdLoadGetIrn(tname)	// no need for table function logic here, tvf don't have indices
					do:irn="" error(30)
					set checked = ($data(checkedIrns(irn))#2) // see if table has been checked already
					set checkedIrns(irn) = "" //mark the current table as checked
					if (checked || '$$findIndexInTable(irn,tMap,.tClass,.tIndex)) { continue }
					if tIndexName="" {
						set tClassname=tClass,tIndexName=tIndex
					}
					else {		// Ambiguous index name, found in more than one table name
						set %tMapName=pMapName do error(152)
					}
			//	}
			}
		}
		if tIndexName="" { set %tMapName=pMapName do error(151) }
	}
	elseif $l(pMapName,".")=1 {	// SQLMapName, no Schema or Table, need to search all schema.tables in the query
		set tMap=pMapName
		set m=mt("search_index", pMapName, val) // set relevant query block to be the block this index is invoked in
		set lbl=""
		for  {
			set lbl=$o($$$mtFLabelsSaveNode(m,lbl)) q:((lbl="") || (m=""))
			set fitem=""
			for  {	// Check each table in the query block for the map
				set fitem=$o($$$mtFLabels(m,lbl,fitem),1,tData) q:fitem=""
				set tname=$lg(tData,1)
				continue:$e(tname,1,3)="%%Q"||($$$LOWER($$$LastPiece(tname,"."))?1"tsq"1.n1"%")
				set irn=$$$smdLoadGetIrn(tname)	// no need for table function logic here, tvf don't have indices
				do:irn="" error(30)
				set checked = ($data(checkedIrns(irn))#2) // see if table has been checked already
				set checkedIrns(irn) = "" // mark the current table as checked
				if (checked || '$$findIndexInTable(irn,tMap,.tClass,.tIndex)) { continue }
				if tIndexName="" {
					set tClassname=tClass,tIndexName=tIndex
				}
				else {		// Ambiguous index name, found in more than one table name
					set %tMapName=pMapName do error(152)
				}
			}
		}
		if tIndexName="" { set %tMapName=pMapName do error(151) }
	}
	QUIT $tr(tClassname,":^",$c(2,3))_":"_$tr(tIndexName,":^",$c(2,3))
}
.
	// Given a table irn and a map name, find the map the run-time dictionary.
	// If it exists, return by reference the Classname and Indexname that projected this index map.
	// We can't look in $$$smd maps here because Functional Indices are not projected to $$$smd
findIndexInTable(irn,pMapName,pClassname,pIndexName) [] PUBLIC {
	set pClassname=$$$smdExtent(1,irn),pIndexName=""
	if $$$smdTempTableType(1,irn) '= "JSON_TABLE" {
			// Have to loop here because pMapName is probably $$$UPPER(mapname)
		set tMap=""
		for  {
			set tMap=$o($$$EXTSQLMAP($$$rEXT,pClassname,tMap)) quit:tMap=""
			if $$$UPPER(tMap)=$$$UPPER(pMapName) {
				set tMapInfo=$$$EXTSQLMAPsqlinfo($$$rEXT,pClassname,tMap)
				set pIndexName=$$$SQLLocMapIndexName(tMapInfo)
				quit
			}
		}
	} else {
			// JSON_TABLE - need to find the index somewhere else as we don't have a compiled extent in $$$EXT
		if $Data($$$smdJSONTABLEIndex(1,irn,pMapName),indexDef) {
			set index = ##class(%Library.DynamicAbstractObject).%FromJSON(indexDef)
#if 0 ; DLP4280+
			set pClassname = "##class("_index.%Get(2)_").search("
			set pIndexName = pMapName
#else ; DLP4280=
			set pClassname = index.%Get(2)
			set pIndexName = "JSON_TABLE#" _ pMapName _ "#"
#endif ; DLP4280-
		}
	}
	QUIT:pIndexName'="" 1	// Found the map
	set pClassname=""
	QUIT 0
}
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
idbased(irn) [] PUBLIC {
		#; Return a comma delimited list of the RowID's Based On Fields...
	QUIT:'$g(irn) ""  ; Nothing to return...
	QUIT:$$$smdRowIDBased(1,irn)="Y" ","_$$$smdRowIDPhysicalFields(1,irn)_","
	QUIT ","_$$$smdRowIDField(1,irn)_","
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA057: new tag killexact - an lvtreemod callback
killexact ; Transform reference to %EXACT(ifn) into reference to ifn
	for { i "v^%EXACT"=$e(v,1,8) { s val=$p(v,"^",4),type=ev,v=mt(type,val),ev=$e(v) } else { q } }
	goto lvargm^%qaqpnl
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA057: new tag xfrmgrp
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
xfrmgrp   ; transform references to grouping columns in the HAVING clause into references to
	#;	    <uncollate>(<collate>(<column>)). This tag is an lvtreemod callback.
	QUIT:ev="v"&&(",%ALPHAUP,%UPPER,%SQLSTRING,%SQLUPPER,%STRING,%PLUS,%MINUS,%SPACE,%EXACT,%MVR,%TRUNCATE,"[$p($p(v,"^",2),"(")) val
	QUIT:ev="v"&&$$$ISENCODEDCOLLATE($p($p(v,"^",2),"(")) val
	QUIT:ev="a" val // don't transform inside of aggregates
	GOTO:ev'="f" lvargm^%qaqpnl
	QUIT:v["_" val ; skip already collated ifn
	QUIT $$xfrm($g($$$mtGroupDistinctList(m)))
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA057: new tag xfrmgrdst to transform references to grouping or distinct columns in the
	#;         SELECT clause into references to <uncollate>(<collate>(column)). This function is an
	#;         lvtreemod() call back.
xfrmgrdst 
	// must stop descending (quit) if reach any explicit collation  - that is taken to override this transform.
	RETURN:ev="v"&&(",%ALPHAUP,%UPPER,%SQLSTRING,%SQLUPPER,%STRING,%PLUS,%MINUS,%SPACE,%EXACT,%MVR,%TRUNCATE,"[$p($p(v,"^",2),"(")) val
	RETURN:ev="v"&&$$$ISENCODEDCOLLATE($p($p(v,"^",2),"(")) val // if this is a COLLATE encoded collation
	RETURN:ev="a" val // don't transform inside of aggregates
	GOTO:ev'="f" lvargm^%qaqpnl
	RETURN:v["_" val ; skip already collated ifn
	set lv=val,val=$$xfrm($g($$$mtGroupDistinctList(m)))
	RETURN:lv'=val val
	RETURN $$xfrm($g($$$mtDistinct(m)))
.
		///  given uncollated field val/v from the caller, and ilst=LIST(val,)
		///  transform val only if collation fn(val) is an element of ilst,
		///  and only if val not found elsewhere within ilst exept as fn(val)
		///  look for fn(val) in ilst, make sure val and %ANY(val) are not there
.
xfrm(ilst)  ;  $$: UNCOLL(fn(val)), if needed, or just val
	new li,fv,fn,lfq,dt
	set fn="",lfq=""  ;  PVA076: new variable dt
	for li=1:1:$l(ilst,",")-1 {
		set fv=$$$mtV($p(ilst,",",li))
		RETURN:fv=v val  ;  listed uncollated
		if $p(fv,"_")=v { RETURN:fv["%ANY" val set fn=$p(fv,"_",2) }
	}
	RETURN:fn="" val  ;  didn't find any COLL(val)
		#;  lfq=LIST(fval,) of all fields and subqueries within ilst
	for li=1:1:$l(ilst,",")-1 { set lfq=lfq_$$listree^%qaqpagg("v",$p(ilst,",",li),"fq") }
	for li=1:1:$l(lfq,",")-1 {
		set fv=$$$mtV($p(lfq,",",li))
		RETURN:$e(fv)="q" val  ;  bail out if subquery found - val might be correlated therein
			#;  look for a different collation, or val itself
		if $p(fv,"_")=v,(v_"_"_fn)'=fv { RETURN val }
	}
		#; PVA076: propagate data type from underlying field.
	set dt=$$$VTRgetdt(val)
	set val=$$coll(val,fn)
		#; PVA309: support uncollate for %MINUS and %MVR
	if ",%ALPHAUP,%UPPER,%PLUS,%TRUNCATE,"[$p(fn,"(") { set $$$VTRdt(val)=dt RETURN val }
	if $$$ISENCODEDCOLLATE($p(fn,"("))  {
		new parm1,parm2
		do decodeCollate^%qaqcpre(fn,.parm1)
		if parm1["prepend-space" {
			set fv=$g(mt("unary",val,"%RMLSP")) 
			if 'fv { 
				Set val=$$$newval("v^%RMLSP^^"_val_"^",1) 
				set mt("unary",$p($$$mtV(val),"^",4),"%RMLSP")=val,$$$VTRdt(val)=dt 
			} else { set val=fv}
		}
		if parm1["mode=-" {
			set fv=$g(mt("unary",val,"%RMINUS")) 
			if 'fv { 
				Set val=$$$newval("v^%RMINUS^^"_val_"^",1) 
				set mt("unary",$p($$$mtV(val),"^",4),"%RMINUS")=val,$$$VTRdt(val)=dt 
			} else { set val=fv}
		}
	}
	elseif "%MVR"=$p(fn,"(") { set fv=$g(mt("unary",val,"%RMVR")) if 'fv { Set val=$$$newval("v^%RMVR^^"_val_"^",1) set mt("unary",$p($$$mtV(val),"^",4),"%RMVR")=val,$$$VTRdt(val)=dt } else { set val=fv }}
	elseif "%MINUS"=$p(fn,"(") { set fv=$g(mt("unary",val,"%RMINUS")) if 'fv { Set val=$$$newval("v^%RMINUS^^"_val_"^",1) set mt("unary",$p($$$mtV(val),"^",4),"%RMINUS")=val,$$$VTRdt(val)=dt } else { set val=fv }}
	else {
		new ifn,irn
		set ifn=$$$VTRgetifn(val),irn=$$$VTRgetirn(val)
		if irn,ifn,$$$smdColVALUELIST(1,irn,ifn)'="" {
				// %CON2VL is Convert to valuelist.  This will take the collated value and return the cooresponding VALUELIST value, which will be the correct case. (DPV6618)
			set fv=$g(mt("unary",val,"%CON2VL"))	// Instead of removing the leading space, convert to the VALUELIST value
			if 'fv { Set val=$$$newval("v^%CON2VL^^"_val_"^",1) set mt("unary",$p($$$mtV(val),"^",4),"%CON2VL")=val,$$$VTRdt(val)=dt } 
			else { set val=fv }
.
		} else {	// No VALUELIST, just remove the leading space
			set fv=$g(mt("unary",val,"%RMLSP"))
			if 'fv { Set val=$$$newval("v^%RMLSP^^"_val_"^",1) set mt("unary",$p($$$mtV(val),"^",4),"%RMLSP")=val,$$$VTRdt(val)=dt } 
			else { set val=fv }
		}
	}
	RETURN val
.
		/// PVA057: new tag maxfrm to transform max or min of collated columns
maxfrm(agval) ; Transform Max(ifn,...) to <uncollate>(Max(ifn_collate,...) if ifn has default collation ; same for Min()
	n v,fval,oval,nval,agglst,p,r
	s v=$$$mtV(agval),fval=$p(v,"^",5),oval=$$$mtV(fval),$p(v,"^",5)=$$coll(fval,1),$$$mtV(agval)=v,fval=$p(v,"^",5),nval=$$$mtV(fval)
	#; AK651
	if oval'=nval {
		// For the following, uncollate is a no op
		QUIT:nval["%ALPHAUP"  QUIT:nval["%UPPER"  QUIT:nval["%PLUS"  QUIT:nval["%TRUNCATE"
		#; DAP003
		QUIT:v["count"
		#; DAP003-
		Set val=$$$newval(v,1)
		#; PVA309: Support uncollate for %MINUS, %MVR
		if $$$ISENCODEDCOLLATE($p(nval,"_",2,*))  {
			new parm1,parm2
			do decodeCollate^%qaqcpre($p(nval,"_",2,*),.parm1)
			if parm1["prepend-space" {
				s $$$mtV(agval)="v^%RMLSP^^"_val_"^" 
			}
			if parm1["mode=-" {
				if parm1["prepend-space"{
					Set val=$$$newval($$$mtV(agval),1)
				}
				s $$$mtV(agval)= "v^%RMINUS^^"_val_"^"
			}
		}
		elseif nval["%MINUS" {s $$$mtV(agval)= "v^%RMINUS^^"_val_"^" } ; here we can't use mt("unary",)
		elseif nval["%MVR" {s $$$mtV(agval)= "v^%RMVR^^"_val_"^" }
			// For all the other collations, uncollate just removes a leading space
		else {
			new ifn,irn
			set ifn=$$$VTRgetifn(val),irn=$$$VTRgetirn(val)
				#;  here we can't use mt("unary",) because we're re-using agval to avoid having to find and modify  expressions the refer to it.
			if irn,ifn,$$$smdColVALUELIST(1,irn,ifn)'="" {
					// %CON2VL is Convert to valuelist.  This will take the collated value and return the cooresponding VALUELIST value, which will be the correct case. (DPV6618)
				set $$$mtV(agval)="v^%CON2VL^^"_val_"^"
			} else {	// No VALUELIST, just remove the leading space
				set $$$mtV(agval)="v^%RMLSP^^"_val_"^"
			}
		}
		// Must modify aggregate list to point to new val# for aggregate
		//    Skip queries that have been merged, so a given aggregate will be found in
		//    only one query. Possibly not needed, as aggregate queries not merged, but
		//    still no point in examining queries that are obsolete.
		for m=1:1:maxm { if $$$mtPQbIsActive(m) {
			s agglst=","_$$$mtPAggList($$$mtP(m)),p=$p(agglst,","_agval_","),r=$p(agglst,","_agval_",",2)
			if p'=agglst s agglst=p_","_val_","_r,$$$mtPAggList($$$mtP(m))=$e(agglst,2,*) quit
		}}
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ptln	f fval=1:1:$$$maxv s v=$$$mtV(fval) i "f^1"=$p(v,"^",1,2),$p(v,"^",4)'["." s $$$ptln($p(v,"^",3)_"^"_$$$IDName($p(v,"^",4)))=fval
	s ml="1^",fname=""
	QUIT
bars() [ mt, mts, val, ptv, m ] public {
	new m
	Set v = ""
	For {
		Set v = $o(mt("bars",v)) QUIT:v=""
		Set idval = $$$mtV(v)
		set str = $piece(idval, "^", 2)
		// query block number of idval
		set m = $$$mtRQb($$$mtR( str))
		Set barval = $$idToBars(idval)
		If barval = idval CONTINUE //shouldn't happen but doesn't hurt to check
		//for a %BARS expression, idToBars creates the field entries
		//but if idToBars just returns a new field val we need to create it.
		//(this is a bad interface and TODO, update)
		If $e(barval)="f"  {
			// check if the legacy row ID node exists in mt("v") already
			set vbar=$piece($get(mts(m, str,"ATT", $piece(barval,"^",3))), "^", 5) 
			if (vbar '= "") && ($$$mtV(vbar) = barval) {
				// update mt and ptv to depend on existing legacy row ID value #
				do replaceVal(m, v, vbar)
				set $$$mtV(v) = "i^ignore^"
				set ifn = $piece(idval, "^", 3)
				kill ptv(v)
			} else {
				// otherwise, create the new value number for the legacy row ID, replacing the ID/%ID row ID val#
				do nuatt(v,$p(barval,"^",2),$p(barval,"^",3))
			}
		}
		Else {
			Set $$$mtV(v)=barval
			Kill ptv(v)
		}
		Set ifn = $piece(idval,"^",3)
		// all references to the ID/%ID field value v have been removed in mt
		Kill mts(m,str,"ATT",ifn)
	}
	
}
.
replaceVal(m, val1arg, val2arg) [mt, call, val1, val2] PUBLIC {
	/*
	Go through mt and replace all dependencies on val1 with val2 for the
	query block m.
	*/
	
	new call, val1, val2
	
	// replace in SELECT list
	set valList = $$$mtOutputVals($get($$$mtOutput(m)))
	for i = 1:1:($length(valList, "," ) - 1) {
		if $piece(valList, ",", i) = val1arg {
			set $piece(valList, ",", i) = val2arg
		}
	}
	set $piece($$$mtOutput(m), "^", 2) = valList
	
	// replace TOP value
	if $g($$$mtTopArg(m)) = val1arg {
		set $$$mtTopArg(m) = val2arg
	}
.
	// replace OFFSET value
	if $g($$$mtOffset(m)) = val1arg {
		set $$$mtOffset(m) = val2arg
	}
	
	// replace in %PARTITION BY clause
	for i = 1:1:($length($get(mt("%paritition", m)), "^") - 1) {
		if $piece($$$mtPartitionPredicates( m), "^", i) = val1arg {
			set $piece($$$mtPartitionPredicates( m), "^", i) = val2arg
		}
	}
	
	// replace in GROUP BY clause
	for i = 1:1:($length($get($$$mtGroupDistinctList( m)), ",") - 1) {
		if $piece($$$mtGroupDistinctList( m), ",", i) = val1arg {
			set $piece($$$mtGroupDistinctList( m), ",", i) = val2arg
		}
	}
	
	// replace in ORDER BY clause
	for i = 1:1:($length($get($$$mtSequencersQb(m)), ",") - 1) {
		if $piece($$$mtSequencersQb(m), ",", i) = val1arg {
			set $piece($$$mtSequencersQb(m), ",", i) = val2arg
		}
	}
	
	// replace in mt("v") and mt("l")
	set call = "replaceValCallBack^%qaqpqo"
	set val1 = val1arg
	set val2 = val2arg
	do lvsubquery^%qaqpag(m)
	
	RETURN
}
.
replaceValCallBack
	new i, valList
	if ev = "v" {
		for i = 4:1:$length(v, "^") {
			if $piece(v, "^", i) = val1 {
				set $piece(mt(type, val), "^", i) = val2
			}
		}
	} elseif ev = "a" {
		for i = 5:1:$length(v, "^") {
			if $piece(v, "^", i) = val1 {
				set $piece(mt(type, val), "^", i) = val2
			}
		}
	} elseif ev = "s" {
		if $piece(v, "^", 4) = val1 {
			set $piece(mt(type, val), "^", 4) = val2
		}
	} elseif ev = "e" {
		set valList = $piece(v, "^", 4)
		for i = 1:1:($length(valList, ",") - 1) {
			if $piece(valList, ",", i) = val1 {
				set $piece(valList, ",", i) = val2
			}
		}
		set $piece(mt(type, val), "^", 4) = valList
	}
	GOTO lviterarg^%qaqpnl
	RETURN
.
ensureBatRowId() [ mt, mcurs, m ] public {
	new m
	If $g($$$mtOneRow(1)) RETURN
	If $g($$$mtGroupDistinctList(1)) RETURN
	If $g($$$mtOutput(1))["d" RETURN
	If $g(%0SQLCompileLevel)||($g(mt("options","parallelQuery"),0)) RETURN
	If $$$mtStatementType'="DEC",$$$mtStatementType'="SEL" RETURN
	//Too early to know this, alas
	//If $g(mt("fastSelect")) RETURN
	Set rid = ""
	Set v = ""
	For {
		Set v = $o($$$mtV(v),1,val) QUIT:v=""
		If $e(val)'="f" CONTINUE
		Set str = +$p(val,"^",2)
		If $d(rid(str)) CONTINUE
		Set ifn = +$p(val,"^",3)
		Set irn = $$$smdGetIrnFromIfn(ifn)
		If 'irn CONTINUE
		Set bid = $$$smdBIDField(1,irn)
		If 'bid CONTINUE
		Set rid(str) = $$$smdBATOldRowIDPhysical(1,irn)
	}
	Set str = ""
	For {
		Set str = $o(rid(str),1,ifns) QUIT:str=""
		set m = $$$mtRQb($$$mtR( str))
		For i=1:1 {
			Set ifn = $p(ifns,",",i) QUIT:ifn=""
			Set v = $$nufld(str,ifn)
			#; There's no easy way to convince the optimizer that
			#; a field value is needed without getting it into
			#; the parse tree somewhere, so we set up a dummy condition
			Set log = $$$newlog("v^%BATPULL^^"_v_"^")
			Set $$$mtWhere(m) = $g($$$mtWhere(m))_log_"^"
		}
	}
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
star	n fcol,hide s fcol="",hide=0
	#; JMM006
	q:$$$mtKInsertDefaultFlag($g($$$mtK)) ; This is INSERT ... DEFAULT VALUES, nothing to do here.
	#; AK318
	#;  for INSERT/UPDATE, see if valins = size({fields}-{hidden}-{rowid})
	#;      and if so, set hide(rowidifn)=1, and hide it!
	d:",INS,UPD,"[(","_$$$mtStatementType_",") ddhideid
	#; AK318-
	#;  AK289;RLL651;AK372
	f  d ddtfs q:fname=""  d colmn,apndo(val):"DEC SEL"[$$$mtStatementType,flist^%qaqpsq1(val):"INS UPD"[$$$mtStatementType
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
colmn	s val=$g($$$ptln($p(ml,"^",2)_"^"_fname)) ; Check if exists with label,
	s:'val val=$g($$$ptln("^"_fname))       ; or without,
	Set:'val val=$$$newval("f^"_ml_"^"_fname,1)    ; or with new
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
apndo(val)  ;  append val to $$$mtOutput(1)
	i $l($g($$$mtOutput(1)))<$$$complength s $$$mtOutput(1)=$g($$$mtOutput(1))_val_"," q
	f ext=1:1 q:$l($g($$$mtOutputOverflow(1,ext)))<$$$complength
	s $$$mtOutputOverflow(1,ext)=$g($$$mtOutputOverflow(1,ext))_val_","
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
field	;  replace  $$$mtV(fval)="f"^m^[label]^{name.}field-name
	#;           mt("f",m^label)=table-name
	#;           mt("tvf","label",m^label)=TVF-Parameters
	#;			 mt("ft","label",m^label)=name
	#;  by       $$$mtV(fval)="f"^stream#^ifn
	#;           ptrel(m^label{.name})=stream#
	#;           $$$mtR(stream#)=irn^m
	#;           mt("tvf","str",stream#)=TVF-Parameters
	#;			 mt("ft","stream",stream#)=name
	n ttype,data,ifn,x
	s mlabel=$p(v,"^",2,3),m=+mlabel,fname=$p(v,"^",4),tname="" s:mlabel'["->" tname=$g($$$mtFromTableName(mlabel))		// DPV3258
	#; ------ If field had no label, list all labels ------
	#; AK446
	GOTO:$e(tname,1,3)="%%Q" vstrf  ;  it's a virtual stream field
	#; PVA149: Eliminate use of path^%qavFunctions; use new information stored in $$$mtV() entry for arrow syntax
 	s:tname="" tname=$$$LastPiece(mlabel,"->")
 	set irn=$$$smdLoadGetIrn(tname,$g($$$mtTvf(m,tname)))
 	set ttype=$$$smdGetTType(tname)
 	if ttype=3 
 	{  // Should only happen for INSERT into updatable view; map to underlying irn/fname
 	   s x=$o($$$smd(3,irn,"f",fname,""),1,data),ifn=$p(data,$c(1),2)
	   QUIT:ifn=""
	   s data=$$$smd(1,"ifn",ifn),irn=$p(data,$c(1),2),fname=$p(data,$c(1))
 	}
	d putstr(mlabel,irn)
	set ifn=$$$smdGetIfn(1,irn,fname) if ifn="" { do error(31) }  // error 31a uses fname/tname variables
	d nuatt(fval,str,ifn)  ;  First process all other flds already in mt
	set:$d($$$mtTvfLabelParams(mlabel)) $$$mtTvfParams(str)=$$$mtTvfLabelParams(mlabel),$$$mtTvfFuncLabel(str) = $p(mlabel,"^",2)
	if $d($$$FTByLabel(mlabel), data) {
		set $$$FTByOriginalStream(str) = data
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
link	d putstr(mlabel_"^"_$p(path,"^",2,ln),$p(link,",",4))
	QUIT:'newstr
	s linx=lefts_","_$p(link,",",2,3)_","_str_","_m_"^"_linx
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
linx	;  Each link yields two fields and an (outer-?) join
	s m=$p(link,",",5) d nufld(+link,$p(link,",",2)) s leftv=val
	d nufld($p(link,",",4),$p(link,",",3))
	#; AK501
	Set val=$$$newlog("v^=^^"_leftv_"^"_val_"^")
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ignore(log)  ;  Mark this 'log' as an unused scratch value
	s $$$mtL(log)="i"
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA087: make this take args to use for ON clause (which will should never directly contain =*)
where(logs,log,lgi)	s bool=$$$mtL(log),op=$p(bool,"^",2)  ;  flatten top-level AND
	i op="&" s $p(logs,"^",lgi)=$p(bool,"^",4,5),lgi=lgi-1 d ignore(log) QUIT
	#; PVA242: handle %NOINDEX
	i $p(op,"%NOINDEX")="&" s $$$mtLOperator($$$mtL($p(bool,"^",4)))=($$$mtLOperator($$$mtL($p(bool,"^",4)))_"%NOINDEX"),$$$mtLOperator($$$mtL($p(bool,"^",5)))=($$$mtLOperator($$$mtL($p(bool,"^",5)))_"%NOINDEX") s $p(logs,"^",lgi)=$p(bool,"^",4,5),lgi=lgi-1 d ignore(log) QUIT
	QUIT:op'="=*"
	s $$$mtLOperator($$$mtL(log))="="
	s leftv=$p(bool,"^",4),val=$p(bool,"^",5)   ; For outer-join, move to linx
	#;  allow for const=*field  *** should also generalize for expr=*field
	s lefts=$$$mtV(leftv),lefts=$s($e(lefts)="f":$p(lefts,"^",2),1:"")	// AK380
	/* s str=$$$mtV(val) d error(32):$e(str)'="f" */ s str=$$deriveStream(val) d error(32):str=""
	q:lefts=str  ;  With itself, leave in where, will cause nopad
	#;  linx is in reverse order of processing
	#;  must put in the right place - in position (append+1) of linx!
	s append=0,ln=0,lni=$l(linx,"^")-1
	GOTO:'lni append
outer	s lni=lni-1,ln=ln+1,log1=$p(linx,"^",ln),bool=$$$mtL(log1),str1=$p($$$mtV($p(bool,"^",5)),"^",2)
	s lefts1=$$$mtV($p(bool,"^",4)),lefts1=$s($e(lefts1)="f":$p(lefts1,"^",2),1:"")	// AK380
	s:lefts1=str append=ln  ;  process log before log1 - move log forward
	#;  process log1 before log - move log1 to end
	#;  also adjust lefts so that anything log1 needs would also be moved!
	#;  QUIT if a cycle detected - all will be converted by nopad
	i lefts=str1 QUIT:lefts1=str  s $p(linx,"^",ln,*)=$p(linx,"^",ln+1,*)_log1_"^",ln=ln-1 s:lefts1'="" lefts=lefts1	// AK380
	g:lni outer
	#;  so move log from where(lgi) to linx(append+1)
append	s $p(linx,"^",append+1,*)=log_"^"_$p(linx,"^",append+1,*)
	s $p(logs,"^",lgi,*)=$p(logs,"^",lgi+1,*),lgi=lgi-1
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK446
vstrf	n str  ;  [public: fval,v,mlabel,m,fname,tname] virtual stream field
	s str=$g($$$ptrel(mlabel))
	i 'str s str=$$nuvstr(),$$$ptrel(mlabel)=str QUIT  ;  setup a new virtual stream
	d virf(fval,str,$$nuifn())  ;  provide field with virtual ifn
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nuvstr(srcStr="") n str  ;  [public: m,tname] $$:  setup a new virtual stream,
	#;  complete with str#, irn, map0, rowid
	s str=$i(maxs),$$$mtRVirtual(str)=$e(tname,4,*),$$$mtRNumStreams=str,ptj(m,1)=$g(ptj(m,1))_str_","
	if srcStr'=""				// JLF125
	{	s $$$mtR(str)=+$$$mtR(srcStr)_"^"_m
		s mts(m,str)=mts($$$mtRQb($$$mtR(srcStr)),srcStr)
		s $p(mts(m,str),"^",5)=$p($$$mtV($$getidval^%qaqpre2(srcStr)),"^",3)	
	}
	else
	{	s $$$mtR(str)=$$nuirn()_"^"_m
		s mts(m,str)="200^50^^"_$$nuimp()_"^"_$$nuifn()_"^"
	}
	d virf(fval,str,$p(mts(m,str),"^",5))  ;  we assume fval=%ID is the first one!
	#; AK490
	i mcurs'="",m=1,$$$mtStatementType="DEC" s mtc(mcurs,"f")=""  ;  no "main table" for this DECLARE!
	QUIT str
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
virf(val,str,ifn)  ;  set mt("virf",ifn)=<position-in-subq,subq-original-val>
	d nuatt(val,str,ifn)
	n vm,pos s vm=$$$mtRVirtual(str),pos=val-$$$mtPViewIDVal($$$mtP(vm))
	s:'$d($$$mtDupsv(vm)) $$$mtVirf(ifn)=$lb(pos,$p($$$mtOutputVals($$$mtOutput(vm)),",",pos))
	KILL $$$mtVtr(val) d createval^%qaqpdt(val)  ;  AK1071
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
/// Define the field for the foreign stream which corresponds to a finalized pushdown unit of some foreign table(s)
/// Parameters:
///		val					- mt("v") number of the field that we're adding
///		positionInSelect	- foreign stream fields are created intially from a query block. this is the fields 
///								position in that block's SELECT. This will always be one less than the icol column position
///								in the fake table created in smd() for this because there is no ID in the SELECT list,
///								so we create a fake ID field in icol position 1 of the table with "position" 0 in the
///								SELECT list
///		str					- stream this is being added under (ASSUMED ALREADY EXISTS!)
///		ifn					- ifn (smd field ID) created for this val
///		originalVal			- original mt("v") number that this new "field" would correspond to
///
///	Uses non-procedure block functions; make sure public list is always maintained correctly
foreignField(val, positionInSelect, str, ifn, originalVal=0) [ fval, m, mt, mts, ptv ] PUBLIC {
	do nuatt(val, str, ifn)			// define $$$mtV(val), ptv(val) (w/ field statistics), mts()
	
	//set $$$FTFakeStreamVal(str, val) = $lb(positionInSelect, originalVal)
	kill $$$mtVtr(val) 			// blank slate
	do createval^%qaqpdt(val)  	// now fill in mt("vtr")
	RETURN
}
	#;  $$:  new unused irn, for virtual table
nuirn()	[mt] PUBLIC { s mt("virr")=$i($$$smd("tcnt")) QUIT mt("virr") }
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  $$:  new unused ifn, for virtual field
nuifn()	[mt] PUBLIC { s mt("virf")=$i($$$smd("fcnt")) QUIT mt("virf") }
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  $$:  new unused imp, for virtual map
nuimp()	[mt] PUBLIC { s mt("virm")=$i($$$smd("mcnt")) QUIT mt("virm") }
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK446-
logfn	;  apply collation to both arguments of v=$$$mtL(log), as needed
	#; AK403
	n fn,pi,val  ;  determine the collation to apply 
	s fn=$$fnfn($$ddfun($p(v,"^",4)),$$ddfun($p(v,"^",5)))
	;  Apply fun (if any) to both arguments of log
	f pi=4,5 s $p($$$mtL(log),"^",pi)=$$coll($p(v,"^",pi),fn)
	#; AK403-
	QUIT
.
setExternal() [mt, maxs] PUBLIC {
	#; sets mt("ext",q#) to the connection name for external queries
	#; modelled after dsn^%qaqpnl
	f str=1:1:maxs { ; iterate over streams
		CONTINUE:$d($$$mtRVirtual(str)) ; not a base table
		s m=$$$mtRQb($$$mtR(str)) ; query#
		CONTINUE:'$$$mtPQbIsActive(m)
		CONTINUE:$$$mtFromList(m)=$lb("%TSQL_sys.snf") ; FROM-less query
		s irn=+$$$mtR(str)
		s ext=$$$smdConnection(1,irn)
		d addext(m,ext)
	}
	f tm=$$$mtPNumQbs:-1:1 { ; propagate external connections up if they exist
		s m=$g(mt("qbo",tm))
		CONTINUE:'$$$mtPQbIsActive(m)
		CONTINUE:'$d(mt("ext",m),ext) ; has not been assigned yet
		d addext(+$$$mtP(m),ext) ; set superquery connection
	}
	f tm=1:1:$$$mtPNumQbs { ; propagate external connections down to unassigned
		s m=$g(mt("qbo",tm))
		CONTINUE:'$$$mtPQbIsActive(m)
		s:'$d(mt("ext",m),ext) (ext,mt("ext",m))=$g(mt("ext",+$$$mtP(m)))
	}
}
addext(m,ext) [mt] PUBLIC {
	QUIT:'m
	i '$d(mt("ext",m)) s mt("ext",m)=ext QUIT
	QUIT:mt("ext",m)=ext
	s mt("ext",m)=""  ;  heterogeneous - must be processed locally
}
isExternal(m) [ mt ] PUBLIC {
	QUIT mt("ext",m) '= ""
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK403
groupm	;  process GROUP BY/DISTINCT for subquery m
	#;  first "set up" GROUP - copy from SELECT-list if needed
	i $g($$$mtGroupDistinctList(m))="" s $$$mtGroupDistinctList(m)=$$$mtOutputVals($g($$$mtOutput(m))) s mt("gsynth",m) = 1
	#;  C. apply collation to GROUP BY/DISTINCT
	s $$$mtGroupDistinctList(m)=$$colist($$$mtGroupDistinctList(m))  ;  AK451
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
grpred	n colist,li,onegroup  ;  reduce GROUP BY for subquery m
	#;  optimize DISTINCT - if the list includes the rowid
	#;      (or any other UNIQUE key) of some table, remove
	#;      all other fields of that table from the list
	#; AK767
	//Some external databases don't like (for example) selecting
	//columns that aren't in the GROUP BY, even though we allow it.
	//So don't attempt to "simplify" the GROUP BY list for them.
	RETURN:$$isExternal(m)
	set colist=$$$mtGroupDistinctList(m)
	// Prevent vector category in GROUP BY clause ; YWH026
	for li=$l(colist,",")-1:-1:1 do:$$$VTRgetcat($p(colist,",",li))="VECTOR" error(255)
	s $$$mtGroupDistinctList(m) = $$redist(colist,,2,m,.onegroup)
	s:onegroup $$$mtOneGroup(m)=1
	d:colist'=$$$mtGroupDistinctList(m) logopt^%qaqpagg("group","m="_m_" : "_colist_" -> "_$$$mtGroupDistinctList(m))
	#; AK767-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
deriveStream(val) PUBLIC {
	Set streams = $$deriveStreams("v",val)
	If $ll(streams)=1 RETURN $li(streams)
	RETURN ""
}
.
deriveStreams(type,val,first=0) [ call, streams, first ] PUBLIC {
	New call, streams
	Set call = "lviterDeriveStreams"
	Set streams = ""
	Do lviter^%qaqpnl(type,val)
	RETURN streams
}
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK435
	#; AK767
redist(dist,ukf,removeStreamless=1,m,onegroup=0) s ukf=""  ;  $$: red = LIST(val,),
	#;  a subset of dist=LIST(val,) reduced to an equivalent list -
	#;  if dist contains a key of T, remove any other T fields
	#;  .ukf (by ref) returns $bit(ukf,str)=1 if unique key found for str
	#;  elst=$LIST(val) of expressions to resolve after call to key()
	#; if removeStreamless then add in all CON conditions and then
	#; remove these at the end so we return the minimal set possible, if this is 2 do not return "" from
	#; this removal but return redist(removeStreamless=0) of the original list to allow for loop supression logic to fire
	#; (maybe remove 2 option after making sure loop supression works when we do return "")
	#; m is optional query block #, if not present then look it up from parse tree
	#; onegroup (by ref) returns 1 if con conditions reduce the result to "" (for GROUP BY)
	n li,val,v,ev,elst,str,ifn,coll,dc,nl,red,call,found,con,origdist s elst="",red="",call="evdist^%qaqpqo",con=""
	#; Find the subquery 'm' number
	if $get(m)="" {
		set m=""
		for li=1:1:$l(dist,",")-1 {
			set m=$$findtree^%qaqpnl("v",$p(dist,",",li),"f")
			QUIT:m
		}
		if m {
			set m=$$$mtRQb($$$mtR($p($$$mtV(m),"^",2)))
		}
	}
	if removeStreamless,m {
		set con=$$eqflds(m),origdist=dist
		set dist=con_dist	
	}
	f li=1:1:$l(dist,",")-1 {
		s val=$p(dist,",",li),v=$$$mtV(+val),ev=$e(v)
		s:val["_" v=v_"_"_$p(val,"_",2)  ;  handle val_%COLL notation
		#;  s v=v_$e(val,$f(val_"_","_")-1,*)
		i $e(v,1,9)="v^%EXACT^",$e($$$mtV($p(v,"^",4)))="f" s v=$$$mtV($p(v,"^",4)),ev="f"  ;  *** need to do anything else?  f itself?
		CONTINUE:"txn"[ev  ;  step 2 - remove constants
		i ev'="f" s elst=elst_$lb(val) CONTINUE  ;  step 3
		s str=$p(v,"^",2),ifn=+$p(v,"^",3),coll=$p(v,"_",2)
		#;  coll(str,ifn,_COLL)=val  ;  collations found, "_" for exact
		s coll(str,ifn,"_"_coll)=val  ;  step 1
		#;  nl(ifn) = ifn is not required (use DD only, ignore nulstr)
		s:'$d(nl(ifn)) nl(ifn)=$$nulable(+$$$mtR(str),ifn)
		CONTINUE:nl(ifn)  ;  can't be a useful part of a UNIQUE key
		#;  step 4 - coll(str,ifn)=COLL ; default collation COLL (or
		#;  one that "implies" the DC(ifn) ), or "" if exact ifn found
		i coll="" s:$d(coll(str,ifn))=10 coll(str,ifn)="" CONTINUE  ;  exact field found
		#;  dc(ifn) = default collation of ifn (incl. "")
	#; AK838
		;  nufld() expects the correct m
		s:'$d(dc(ifn)) dc(ifn)=$$ddfun($$nufld(str,ifn))  ;  default collation
		CONTINUE:dc(ifn)=""
		CONTINUE:$g(coll(str,ifn))=dc(ifn)  ;  can't do better than DC
		#;  mark as "found" if it is the DC, or if it "implies" the
		#;      DC (unless it also "implies" the best found so far)
		i (coll=dc(ifn))||($$fdcoll(coll,dc(ifn))&&(($g(coll(str,ifn))="")||'$$fdcoll(coll,coll(str,ifn))))  s coll(str,ifn)=coll
	}
	f str=1:1:$g($$$mtRNumStreams) i $d(coll(str)) d redstr(str)
	#;  step 7 - add unimplied expr's from elst - only if it references
	#;  a field not in/implied by red/coll(), using lvtree->evdist
	f li=1:1:$ll(elst) {
		s val=$li(elst,li),found=0
		d lvtree^%qaqpnl("v",val)
		//expressions on window functions are not determined (only) by fields
		if found||$$windows^%qaqpagg(val) { s red=red_val_"," }
	}
	#;  step 8 - remove fields with equivalence conditions to streamless values
	if con="" set onegroup=(red="") RETURN $s(onegroup&&(removeStreamless=2):dist,1:red)   // This includes the 'removeStreamless case
	n red2	s red2 = ""
	f li=1:1:$l(red,",")-1 {
		s val = $p(red,",",li)
		if (","_con)'[(","_val_",") s red2 = red2_val_","
	}
	set onegroup=(red2="")
	#; For GROUP BY and aggregates case do not want to remove everything or loop supression logic will not work, so this reverts to how it used to work
	if onegroup,removeStreamless=2 {
		Set ukf=""
		Set red2=$$redist(origdist,.ukf,0,m)
		if red2="" set red2=origdist
	}
	RETURN red2
	#; AK767-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK767
redstr(str)  ;  process str for $$redist()
	#;  step 4 - if EXACT (or DC) found, use it in red()
	#;  red(str,ifn)=val# in dist of EXACT ifn (or DC) of a required field
	s ifn="" f  s ifn=$o(coll(str,ifn)) q:'ifn  s:$d(coll(str,ifn),coll)=11 red(str,ifn)=coll(str,ifn,"_"_coll)
	d:$d(red(str)) key(str)  ;  step 5
	QUIT:$bit(ukf,str)  ;  key found - done with this stream
	#;  step 6 - add unimplied collations,
	#;  for fields that did not include EXACT (or DC) - add them all!
	s ifn="" f  s ifn=$o(coll(str,ifn)) q:'ifn  d redifn(str,ifn)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
redifn(str,ifn)  ;  add ifn+collations to red, for $$redist()
	i $d(coll(str,ifn,"_"),val) s red=red_val_"," QUIT
	n c2  ;  no need to include collations implied by others
	s coll="" f  s coll=$o(coll(str,ifn,coll)) q:coll=""  s c2="" f  s c2=$o(coll(str,ifn,c2)) q:c2=""  i coll'=c2,$$fdcoll($e(coll,2,*),$e(c2,2,*)) KILL coll(str,ifn,c2)
	s coll="" f  s coll=$o(coll(str,ifn,coll),1,val) q:coll=""  s red=red_val_","
	QUIT
#;--- Windowing Functions /BEGIN
collateWindow(v) [ mt ] public {
	Set part = $p($$$mtV(v),"^",4)
	Set partval = $$$mtV(part)
	Set vlist = $tr($p(partval,"^",4,*),"^",",")
	Set covlist = $$colist(vlist)
	Set rcovlist = $$redist(covlist)
	Set vargs = $tr(rcovlist,",","^")
	Set $p($$$mtV(part),"^",4,*)=vargs
	Set ord = $p($$$mtV(v),"^",5)
	Set ordval = $$$mtV(ord)
	For i=4:2 {
		Set ov = $p(ordval,"^",i) QUIT:'ov
		Set $p($$$mtV(ord),"^",i) = $$coll(ov,1)
	}
}
#;--- Windowing Functions /END
lvtreeFindStreamed ; [public: call, ev, v, lv, streamed]
	QUIT:streamed
	If ev="f" Set streamed = 1 QUIT
	#; YCL124 - Check if subqueries have correlated fields when determine IsStreamless
	If (ev="q")&&($$$mtPCorrelatedFields($$$mtP($p(v,"^",2)))'="") Set streamed = 1 QUIT
	GOTO lvarg^%qaqpnl
isExpressionStreamless(v) [ mt, streamed, call ] public {
	New call, streamed
	Set call = "lvtreeFindStreamed^%qaqpqo"
	Set streamed = 0
	Do lvtree^%qaqpnl("v", v)
	QUIT 'streamed
}
#; Does a field value have an equivalence expression in its subquery that
#; guarantees it will have "at most one row per group" behavior?
hasStreamlessEquivalence(v) [ mt ] public {
	//Disable optimization for now, "onerow" and a single row "GROUP BY" have
	//slightly different semantics. Will be handled in ASL/codegen
	RETURN 0
	//Ideally we'd do this after we have all the equivalence
	//classes added.
	//Don't bother with n_<collation> syntax for now
	If +v '= v RETURN 0
	Set val = $$$mtV(v)
	//Fields only for now.
	If $e(val) '= "f" RETURN 0
	Set str = $p(val,"^",2)
	Set qn = $$$mtRQb($$$mtR(str))
	//Not for synthetic GROUP BY (aka "DISTINCT")
	If $g(mt("gsynth",qn)) RETURN 0
	//Ignore an equivalence if there are no aggregates:
	//AK576-style loop suppression needs the GROUP BY
	If $$$mtPAggList($$$mtP(qn)) = "" RETURN 0
	Set w = $g($$$mtWhere(qn))
	For i=1:1 {
		Set l = $p(w,"^",i) RETURN:'l 0
		Set cond = $$$mtL(l)
		If $p(cond,"^",1,2)'="v^=" CONTINUE
		If $p(cond,"^",4)=v,$$isExpressionStreamless($p(cond,"^",5)) RETURN 1
		If $p(cond,"^",5)=v,$$isExpressionStreamless($p(cond,"^",4)) RETURN 1
	}
}
allAggregatesUngrouped(qn) [ mt ] public {
	Set aggs = $$$mtPAggList($$$mtP(qn))
	For i=1:1 {
		Set av = $p(aggs,",",i) RETURN:'av 1
		Set agg = $$$mtV(av)
		//Should be empty if ungrouped
		If $p(agg,"^",6,7) '= "^" RETURN 0
	}
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
evdist	;  [public: ukf,coll,str,ifn,call,type,val,v,ev,lv] from redist->lvtree
	QUIT:found  ;  find a [collated] field unimplied by red/ukf/coll(),
	#;  i.e. that its stream is not in ukf, dist/coll() did not already
	#;  include the exact field, it did not include this collation, and
	#;  it did not include any collation that implies this collation
	i ev="f" s str=$p(v,"^",2) QUIT:$bit(ukf,str)  s ifn=+$p(v,"^",3) i $d(coll(str,ifn)) { QUIT:$d(coll(str,ifn,"_"))  s coll=$p(v,"_",2) QUIT:$d(coll(str,ifn,"_"_coll))  s lv="" f  { s lv=$o(coll(str,ifn,lv)) q:lv=""  q:$$fdcoll($e(lv,2,*),coll) } QUIT:lv'="" } s found=val QUIT
	#;  if subquery, there could be correlated fields (-1 if unknown)
	i ev="q" i v'["," { s found=-1 QUIT } f lv=2:1:$l(v,",")-1 { d lvtree^%qaqpnl("v",$p(v,",",lv)) q:found } QUIT
	#;  if aggregate, result depends only on the %FOREACH (GROUP BY) list
	i ev="a" s $p(v,"^",5)="",$p(v,"^",7)=""
	GOTO lvarg^%qaqpnl  ;  recurse down
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fdcoll(c1,c2,fun)  ;  $$: 1 if c1(f) "implies" (functionally determines) c2(f),
	#;  i.e. if exists function F() such that (for all x) c2(x)=F(c1(x))
	#;  return 0 if not or if not determined
	#;  ci ::= [ %SQLUPPER | %SQLSTRING | %STRING | %UPPER | %ALPHAUP | %SPACE | %EXACT | %TRUNCATE | ... ] [ (<int>) ]
	#;  *** .fun should return (by ref) the function F() - not implemented
	QUIT:c1=c2 1
	QUIT:(c1="")||(c1="%SPACE")||(c1="%EXACT")||(c1="%TRUNCATE") 1
	QUIT:(c2="")||(c2="%SPACE")||(c2="%EXACT")||(c2="%TRUNCATE") 0
	i c1["(",c2["(" QUIT ($p(c2,"(",2)<=$p(c1,"(",2))||$$fdcoll($p(c1,"("),$p(c2,"("))
	i c2["(" QUIT $$fdcoll(c1,$p(c2,"("))
	QUIT:c1["(" 0
	QUIT:(c1="%UPPER")&&((c2="%SQLUPPER")||(c2="%ALPHAUP")) 1
	QUIT:(c1="%SQLSTRING")&&(c2="%SQLUPPER") 1
	#;  more special cases could be added later! (%STRING?)
	QUIT 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK767-
key(str) n irn,extent,info,kn  ;  see if any of the keys for str can help	// DPV2060 (extent,info)
	#; AK446
	QUIT:$g($$$mtRVirtual(str))  ;  virtual (could theoretically go deeper...)
	s irn=+$$$mtR(str),extent=$$$smdExtent(1,irn)
	QUIT:$$$SSIsFederated($$$smdClassname(1,irn)) // JMM1220 Don't assume any field of federated table is unique
	QUIT:$$okkey($$$smdRowIDField(1,irn),0)  		//  try rowid
	QUIT:$$okkey($$$smdRowIDLogicalFields(1,irn),0)  	//  try idkey (if exists)
	new %class set %class=$$$smdClassname(1,irn)
	s kn=""  //  try all keys
	For  {
		s kn=$o($$$EXTCONS($$$pEXT,extent,kn)) q:kn=""  
		s info=$$$EXTCONSsqlinfo($$$pEXT,extent,kn)
		i kn'="%ROWID","UNIQUE PKEY"[$li(info,2),$$okkey($li(info,3),1) q
	}
	new %ts1,%ts2
	set %ts1=$$$smd(1,irn,33),%ts2=$g($$$comClassKeyRaw(%class,$$$cCLASStimechanged))
	do:(%ts1'=%ts2) error("150a")	// Error message uses variable %class,%ts1,%ts2
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
okkey(flst,names) n jj,ifn  ;  $$: 1 if all of flst are in dist,
		#;  if so also reset red(str) to include only the key
	QUIT:flst="" 0  ;  nothing passed in
	#; AK618    removed by AK767 - red(str,ifn) already has only required
	f jj=1:1 s ifn=$p(flst,",",jj) q:ifn=""  s:names ifn=$$$smdGetIfn(1,irn,ifn) q:'$d(red(str,ifn))  s $p(flst,",",jj)=red(str,ifn)
	QUIT:ifn'="" 0  ;  this key field was not found - can't use this key
	#; AK767
	s red=red_flst_","  ;  good key found for this stream, use the key
	s $bit(ukf,str)=1  ;  mark stream as "unique key found"
	#; AK767-
	QUIT 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK435-
	#; AK618
nulable(irn,ifn)  ;  $$:  1 if <irn,ifn> may be NULL
	QUIT:$$ddreqi(irn,ifn) 0
	#;  *** could check here if cannot be NULL in this specific query -
	#;      find val#, has IS NOT NULL, account for collation!
	#;  Note that NULL due to OJ is OK, since that preserves implication throughout the stream!
	QUIT 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddreqi(irn,ifn)  ;  $$:  return whether field <irn,ifn> is required
	QUIT $$$smdColRequired(1,irn,+ifn)="Y"  ;  use uncollated ifn
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK618-
	#; AK451
colist(list) n li  ;  $$: list=LIST(val,) with collation applied to each element
	f li=1:1:$l(list,",")-1 s $p(list,",",li)=$$coll($p(list,",",li),1)
	QUIT list
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK451-
coll(val,fn)  ;  $$:  return fn(val), if fn=1 then use val's own collation
	s:fn=1 fn=$$ddfun(val)
	QUIT:"*"[fn val  ;  nothing to apply
	n v1 s v1=$$$mtV(val)
	QUIT:v1[fn&&("fv"[$e(v1)) val  ;  fn already applied, fn(fn(x))=fn(x)
	d exact(val) s v1=$$$mtV(val)  ; optimize fn(exact(fld)) once we know fn will be applied
	#;  optimize collate applied to the uncollate functions %RM*:
	#;  If the collation we want was there before the uncollate was applied, return
	#;  the underlying pre-uncollated (i.e., collated) value
	QUIT:($e(v1,1,5)="v^%RM")&&($$colcol($p(v1,"^",4))=fn) $p(v1,"^",4)  ;  fn(unfn(fn(field)))=fn(field)  ;  AK613
	#;  another uncollate issue:  f2(unfn(fn(field)))=>f2(field)  ;  AK982
	i ($e(v1,1,5)="v^%RM"),$e($$$mtV($p(v1,"^",4)))="f" { s v1=$p($$$mtV($p(v1,"^",4)),"_") }
	#;  Here we should see if fn1(fn2(x)) can be improved
	#;  i $e(v1)="f",v1["_"  ;  *** check if already has fn, ... and QUIT
	i $e(v1)="f",v1'[fn {
		if v1'["_"||($p(v1,"_",2,*)["%ANYOF") d nufun(v1) QUIT val  ;  fn(field)	// JLF015
	}
	#; If the operand is a SET operator, then add a set collation, else add a normal collation
	RETURN $$getval("v^"_$s($e($$$mtV(val),1,6)="v^SET:":"SET:",1:"")_fn_"^^"_val_"^")	// JLF016
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; YCL408: loop through mt("v") to check if an entry exists for v, 
	#; if an entry is found, return the existing val. Otherwise, create a new mt("v") entry and return val using $$$newval
getval(v) [mt] public { 
	set val=""
	for { 
		set val=$o($$$mtV(val),1,tv) 
		quit:'+val  
		RETURN:v=tv val
	} 
	RETURN $$$newval(v,1)
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fnfn(c1,c2)  ;  $$:  return combined collation for c1,c2
	#;  ci may be "*" ("coercable"), "" for EXACT, or one of the other 8
	#; JLF015
	s c1 = $s($e(c1,1,6)="%ANYOF":"*",$e($p(c1,"_",2),1,6)="%ANYOF":$p(c1,"_",1),$e($p(c1,"_",3),1,6)="%ANYOF":$p(c1,"_",1,2),1:c1)
	s c2 = $s($e(c2,1,6)="%ANYOF":"*",$e($p(c2,"_",2),1,6)="%ANYOF":$p(c2,"_",1),$e($p(c2,"_",3),1,6)="%ANYOF":$p(c2,"_",1,2),1:c2)
	#; JLF015-
	QUIT:c1_c2["*" $TR(c1_c2,"*")
	QUIT:c1=c2 c1
	if (($$$ISENCODEDCOLLATE(c1)) &&($$$ISENCODEDCOLLATE(c2))){
		set:$e(c1)="%" c1 = $e(c1,2,*)	
		set:$e(c2)="%" c2 = $e(c2,2,*)
		set c3 = "C"_($e(c1,2)&&$e(c2,2))_($e(c1,3)&&$e(c2,3))
		set mode = $e(c1,5)_$e(c2,5)
		if $e(mode,1)=$e(mode,2){
			set mode = $e(mode,1)
		} elseif mode["N" {
			set mode = "N"
		} elseif mode["-" {
			set mode = $s(mode["+":"+",1:"N")
		} elseif mode["L" {
			set mode = $s(mode["U":"U",1:"N")
		} else {
			set mode = "N"
		}
		if ($e(c1,6,*)'=$e(c2,6,*)){
			// if translate tables are different, do not translate
			set c3 = c3_"0"_mode
		}else{
			set sa = ($e(c1,4)&&$e(c2,4))
			set c3 = c3_sa_mode_$s(sa=1:$e(c1,6,*),1:"")
		}
		QUIT c3
	}
	s c1=","_c1_","_c2_","
	QUIT:c1[",," ""  ;  %EXACT
	i ((c1[",%MINUS,")||(c1["C000-")) QUIT $s(((c1[",%PLUS,")||(c1["C000+")):"%PLUS",1:"")  ;  PLUS >> MINUS
	#;  SPACE >> SQLSTRING >> UPPER >> SQLUPPER >> ALPHAUP >> STRING
	#; strong -> weak
	QUIT:((c1[",%SPACE")||(c1["C100N")) "%SPACE"  ;  follow the precedence
	QUIT:((c1[",%SQLSTRING")||(c1["C110N")) "%SQLSTRING"  ;  length?
	QUIT:((c1[",%UPPER")||(c1["C000U")) "%UPPER"
	QUIT:((c1[",%SQLUPPER")||(c1["C110U")) "%SQLUPPER"  ;  length?
	QUIT:((c1[",%ALPHAUP")||(c1["C000U")) "%ALPHAUP"
	QUIT:c1[",%MVR" "%MVR"
	QUIT:((c1[",%TRUNCATE")||(c1["C000N")) "%TRUNCATE"  ;  length?
	QUIT "%STRING"  ;  length?
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK403-
exact(v)  ;  If v=EXACT(x) then reset val to x
	s v=$$$mtV(v) i "v^%EXACT"=$e(v,1,8) s val=$p(v,"^",4)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nufun(v)  ;  For field v, find (or make) val# for fn(v)
	#; JLF015
	n nuIfn,fval s nuIfn=$p(v,"^",3)_"_"_$p(fn,":")_$p(fn,":",2)  ;  append the %ANYOF label, if present
	#; Swap the order of the regular collation function and the %ANYOF to put the ANYOF in position 3
	i ($l(nuIfn,"_")>2 && ($p(nuIfn,"_",3)'["%ANYOF")) { n t s t=$p(nuIfn,"_",2),$p(nuIfn,"_",2)=$p(nuIfn,"_",3),$p(nuIfn,"_",3)=t }
	s str=$p(v,"^",2),m=$$$mtRQb($$$mtR(str)),fval=$p(mts(m,str,"ATT",$p(v,"^",3)),"^",5)
	set val = $g(mt("unary",fval,fn))	
	RETURN:val val
	d nufld(str,nuIfn)
	#; JLF015-
	#; AK446
	#;  setup proper mt("unary") node
	s mt("unary",fval,fn)=val
	#; AK446-
	QUIT val  ;  AK420
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nufld(str,ifn)  ;  [public: m,val,mts] Find field VALUE entry, make new one if necessary
	s val=$p($g(mts(m,str,"ATT",ifn)),"^",5) 
	If ('val)||('$d($$$mtV(val))) {
		Set val=$$$newval("f^"_str_"^"_ifn,1)
		Do nuatt(val,str,ifn)
	}
	QUIT val  ;  AK420
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nuatt(val,str,ifn)  ;
	s $$$mtV(val)="f^"_str_"^"_ifn  ;  ifn may contain _fun
	#;-------------------------------------------------------------------
	#; INFO:
	#;   ptv(val)= I pieces:
	#;               1: class-val#  
	#;               2: f/e
	#;               3: LIST(log#,)
	#; PVA021: Update for new IN condition handling, as well as document prior cases better.
	#;               4: class-type:n/c/r/i (null test/field=fixed expr/range/IN condition/) (see conds^%qaqpnl)
	#;               5: class-type-LIST(log#,) really as follows, depending on class-type:
	#;                                      class-type="n" : log# of null test
	#;                                      class-type="c" : val# of literal, parameter, or 'constant' expression
	#;                                      class-type="r" : $p(.,",") 1 - bounds info, 2-n - info for each applicable condition
	#;                                        bounds info: $p(.,$c(1)) 1 - lower bound val#, 2 - inclusion flag (0 not included,
	#;                                           1 included, 2 %startswith condition, 3 TOP inclusive, 4 TOP non-inclusive),
	#;                                           3 - upper bound, 4 - upper bound inclusion flag.
	#;                                        range info: $p(.,$c(1)) 1 - log# of comparison, 2 - operator, 3 - val# of bound
	#;                                      class-type="i" : $p(.,",") 1 - val# of set of fixed expr, 2 - null inclusion flag
	#;                                           (0 set does not include null, 1 set does include null), 3 - log# of mt("w",m) "ONEOF"
	#;                                            condition, 4 - log# of $$$mtStreamlessConds(m) 'EMPTY condition, 5 - estimate of
	#;                                            number of elements in set
	#;               6: class-LIST(val#,) 
	#;               7: query#
	#;               8: str# 
	#;               9: ifn
	#;              10: selectivity 
	#;              11: length 
	#;              12: output:0/1
	#;              13: LIST(str#,)
	#;              14: LIST(imp,)
	#;              15: used (see lfield^nl)
	#;              16: TOP: range predicate descriptor (JLF020)
	#;---------------------------------------------------------------------
	s ptv(val)=val_"^f^^^^"_val_",^"_m_"^"_str_"^"_ifn_"^"_$$ddfldst(str,ifn)_"^1^^"_$p(mts(m,str),"^",4)_","
	s $p(mts(m,str,"ATT",ifn),"^",5)=val
	QUIT val  ;  AK420
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;---------- DATA DICTIONARY ACCESS ----------
ddtfs	;  Data Dictionary Access
	#;  $O-loop on ml and fcol/fname, thru mt("f",1^...) and map 
	#;  `ViewFieldsByFieldName' or 'ColumnNumber' for BaseTable
	i fname'="" d ddtcol q:fname'=""
	#; AK637
	d ddtab q:+ml'=1  i ("INS UPD"'[$$$mtStatementType)||(ml=$$$mtTarget) d ddtcol d error(33):fname="" QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddtcol	;  Updates variable fname, and for BASETABLE also fcol
	n ifn
	If $p(table,$c(1),2)=3 {
		s fname=$$ddfnext(fname) QUIT:fname=""
		s:$d(hide(fname)) fname=$$ddfnext(fname) QUIT:fname="" // maybe this field is ID or IDENTITY
		s:$d(hide(fname)) fname=$$ddfnext(fname)               // maybe this field is ID or IDENTITY (2 at most)
		QUIT
	}
ddlp	s fcol=$o($$$smd(1,+table,"col",fcol)),fname=""
	QUIT:fcol=""
	s ifn=+^(fcol),fname=$$$IDName($$$smdGetFieldName(ifn))
		#;  If SELECT */T.*, don't report hidden fields for INS, UPD, DEC, SEL
	GOTO:$$$smdColHidden(1,+table,ifn)="Y" ddlp  ;  AK318;DPV928;AK372
		#;  allow hiding the rowID for INSERT/UPDATE (set in ddhideid)
	GOTO:",INS,UPD,"[$$$mtStatementType&&($g(hide(ifn))) ddlp
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddtab	;  Get  itn V ttype  for next ml from maps SuperName/ViewNameAll
	s ml=$o($$$mtFromTableName(ml))
	QUIT:ml=""
	GOTO:'$$$mtPQbIsActive(+ml) ddtab  ;  ignore obsolete query-blocks
	GOTO:$d($$$mtQbHasForSomeElement($p(ml,"^",1))) ddtab		 ;  ignore %ELEMENT from-items
	s table=$$$mtFromTableName(ml)
	#; PVA139: process streamed view now, instead of skipping
	#;  Unqualified field names begin with a $c(1)
	If $e(table)=$c(1) { // All tables should be fully qualified during parsing, so all such logic in pqo is really obsolete
		s table=$$DetermineQualifiedName($$$mtFromTableName(ml),1)	// ,ContextDependent=1	// DPV3369
		s:info mtc(0,0,"some unqualified names")=1 ;  It is an unqualified name, qualify it based on %defschema  // DPV1693 DQN now takes parameters
	}
	Else {
		n tname s tname=table
		s:$e(table,1,3)="%%Q" tname=$$strvname(ml) // PVA139: handle streamed view
		If " INS UPD DEL "[(" "_$$$mtStatementType_" "),$$$mtKViewName($g($$$mtK))'="" { // IUD for view, subquery or CTE
			set tname=$$$mtKViewName($g($$$mtK)) // find the actual target table
			s table=$$$smdLoadGetIrn(tname)_$c(1)_$$$smdGetTType(tname)
		} else {
			s table=$$$smdLoadGetIrn(tname,$g($$$mtTvf(+ml,tname))) g:table="" ddtab // PVA139: skip streamed subqueries for now
			s table=table_$c(1)_$$$smdGetTType(tname)	// Add on table type
		}
	}
	If " INS UPD DEL "[(" "_$$$mtStatementType_" "),$$$mtKViewName($g($$$mtK))'="" {  //DPV1693+  mt("k") p12 defined in frmit^%qaqpsq
		new tt
		if $e($$$mtKViewName($$$mtK))=$c(1) { s tt=$$DetermineQualifiedName($$$mtKViewName($$$mtK),0) }
		else { set tt=($$$mtKViewName($$$mtK)_$c(1)_$$$GetTableTypeFromIQN($$$mtKViewName($$$mtK))) }
		if $p(tt,$c(1),2)=1 { set $$$mtKViewName($$$mtK)="" QUIT  }	// not a view
		new ivn set ivn=$$$smdLoadGetIrn($p(tt,$c(1)))	// LoadGetIrn call OK, can't be a table function
		set $$$mtKViewIVN($$$mtK)=ivn
		if $$$smdViewUpdateable(ivn)'=1 { do error(35) }	// Report error if INS/UPD/DEL for non-updatable View
		elseif " INS UPD "[(" "_$$$mtStatementType_" "),'$g($$$mtKCheckOptionCodeCounter) {		// Only retrieve the code one time...
			s $$$mtKCheckOption($$$mtK)=$Case($$$smdViewCheckOption(ivn),"C":2,"L":1,:0),$$$mtKTargetTableIRN($$$mtK)=+table
			n extlist,i,j,thisextent s thisextent=$$$smdExtent(3,ivn)
			  #;  First, load check option validation code from underlying views
			If $d($$$EXTsqlcheckoption($$$rEXT,thisextent,-1),extlist) {
				For i=1:1:$ll(extlist) { 
					If $lg(extlist,i)'="" { 
						For j=1:1:$g($$$EXTsqlcheckoption($$$rEXT,$li(extlist,i),0)) s $$$mtKCheckOptionCode($i($$$mtKCheckOptionCodeCounter))=$$$EXTsqlcheckoption($$$rEXT,$li(extlist,i),j)
					}
				}
			}
			If $$$mtKCheckOption($$$mtK) {
				  #;  Then the check option validation code for this view (if any)
				If $g($$$EXTsqlcheckoption($$$rEXT,thisextent,0)) {
					For j=1:1:$$$EXTsqlcheckoption($$$rEXT,thisextent,0) {
						s $$$mtKCheckOptionCode($i($$$mtKCheckOptionCodeCounter))=$$$EXTsqlcheckoption($$$rEXT,thisextent,j)	// DPV2181 (j, not 4)
					}
				}
			}
			if $g($$$mtKCheckOptionCodeCounter),$d(mtc(mcurs,"f")),$$$smdSharded(1,$p(mtc(mcurs,"f"),",",2)) {
				do error("35s")
			}
		}
	}  // DPV1693-
	QUIT
	#; PVA139: create new function strvname
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
strvname(ml)
    n qn,lb,ft,vn
    s qn="",vn="" f  { s qn=$o($$$mtFLabelsQbNode(qn)) q:qn=""
       s lb="" f  {s lb=$o($$$mtFLabelsSaveNode(qn,lb)) q:lb=""
          s ft="" f  { s ft=$o($$$mtFLabels(qn,lb,ft),1,vn) q:ft=""
             g:ft=ml strvend
          }
       }
    }
strvend	QUIT $lg(vn)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	// Called only locally, from ddtab, expand, and start
DetermineQualifiedName(name,updatept=1,ml) [mt,slist,tab,tname] PUBLIC {
		#;  Function take an unqualified name and qualifies it based on %defschema settings
		#;  Returns InternalNumber_$c(1)_TableType
	new slist,tab,tname
	If '$d(name) s name=$$$mtFromTableName(ml)
	s savetab=name,tab=name,cnt=0,table="",foundInSchemaPath=0
	if $g(%sqlSchemaPath)'="",$g($$$mtStatementType)'="%CH" {	// DPV3410=  %CHECKPRIV does not use schemapath
		for i=1:1:$ll(%sqlSchemaPath) {
			set qualtab=$lg(%sqlSchemaPath,i)_"."_$p(tab,$c(1),2)
			if $d($$$mtKAction("EXECUTE")) {	// GRANT EXECUTE, looking for PROC, not table/view
				if $d($$$pPROC($$$UPPER($lg(%sqlSchemaPath,i)),$$$UPPER($p(tab,$c(1),2))))) {
					set foundInSchemaPath=1
					set table=$$$UPPER($lg(%sqlSchemaPath,i))_$c(1)_$$$UPPER($p(tab,$c(1),2))
					set $$$mtFromTableName($p(ml,$c(1))_qualtab)=$lg(%sqlSchemaPath,i)_"."_$p($$$mtFromTableName(ml),$c(1),2) k $$$mtFromTableName(ml)  // Add qualification to parse tree, always for a procedure regardless of updatept flag
				}
			}
			else {
				set rvidxdata=$$$GetRVIdxDataFromIQN(qualtab)
				if rvidxdata'="" {
					set table=$$$smdLoadGetIrn($lg(rvidxdata,4))
					continue:'table		// Error loading table, or just not there???
					set foundInSchemaPath=1,table=table_$c(1)_$lg(rvidxdata,3)	// Add on table type (irn_$c(1)_ttype)
					if updatept s $$$mtFromTableName($p(ml,$c(1))_qualtab)=$lg(%sqlSchemaPath,i)_"."_$p($$$mtFromTableName(ml),$c(1),2) k $$$mtFromTableName(ml)  // Add qualification to parse tree
				}
				elseif $g($$$mtTvf(+ml,qualtab)) {	// could be a table function?
					set table=$$$smdLoadGetIrn(qualtab,$g($$$mtTvf(+ml,qualtab)))
					continue:'table		// Error loading table, or just not there???
					set foundInSchemaPath=1,table=table_$c(1)_1	// Add on table type (irn_$c(1)_ttype)
					if updatept s $$$mtFromTableName($p(ml,$c(1))_qualtab)=$lg(%sqlSchemaPath,i)_"."_$p($$$mtFromTableName(ml),$c(1),2) k $$$mtFromTableName(ml)  // Add qualification to parse tree
				}
			}
		}
	}
	if 'foundInSchemaPath {
		For i=1:1:$ll(%defschema) {
			set qualtab=$lg(%defschema,i)_"."_$p(tab,$c(1),2)
			set rvidxdata=$$$GetRVIdxDataFromIQN(qualtab)
			if rvidxdata'="" {
				set cnt=cnt+1 quit:cnt>2  	// cnt is the number of schemas we found the table in
				if cnt=2 {			// Only give -43 error once
					set tab=$e(savetab,2,*) 
					for i=1:1:$ll(%defschema) { set $p(slist,",",i)=$$quoter2($lg(%defschema,i)) }
					do error(43)	// Table ambiguous  error 43 display uses tab and slist (schema list)
				}
				set table=$$$smdLoadGetIrn($lg(rvidxdata,4))	// DPV2060 (01/26/2003) - UPDATED, piece 4, not 2
				continue:'table		// Error loading table, or just not there???
				set table=table_$c(1)_$lg(rvidxdata,3)	// Add on table type (irn_$c(1)_ttype)
				if updatept {   // Add qualification to parse tree
					set $$$mtFromTableName($p(ml,$c(1))_qualtab)=$lg(%defschema,i)_"."_$p($$$mtFromTableName(ml),$c(1),2)
					kill $$$mtFromTableName(ml)
				}
			}
			else {		// see if it is a table function
				set table=$$$smdLoadGetIrn(qualtab,$g($$$mtTvf(+ml,qualtab)))
				continue:'table		// Error loading table, or just not there???
				set cnt=cnt+1     	// cnt is the number of schemas we found the table in
				if cnt=2 {		// Only give -43 error once
					set tab=$e(savetab,2,*) 
					for i=1:1:$ll(%defschema) { set $p(slist,",",i)=$$quoter2($lg(%defschema,i)) }
					do error(43)	// Table ambiguous  error 43 display uses tab and slist (schema list)
				}
				set table=table_$c(1)_1	// Add on table type (irn_$c(1)_ttype)
				if updatept {   // Add qualification to parse tree
					set $$$mtFromTableName($p(ml,$c(1))_qualtab)=$lg(%defschema,i)_"."_$p($$$mtFromTableName(ml),$c(1),2)
					kill $$$mtFromTableName(ml)
				}
			}
		}
		If cnt=0 {
			set tab=$e(savetab,2,*),slist="",ssplen=0
			if $g(%sqlSchemaPath)'="",$g($$$mtStatementType)'="%CH" set ssplen=$ll(%sqlSchemaPath) f i=1:1:ssplen s $p(slist,",",i)=$$quoter2($lg(%sqlSchemaPath,i))
			if slist="",$ll(%defschema)=1 { set tname=$lg(%defschema,1)_"."_tab kill slist }
			else {
				for i=1:1:$ll(%defschema) { set:(","_slist_",")'[(","_$lg(%defschema,i)_",") $p(slist,",",i+ssplen)=$$quoter2($lg(%defschema,i)) }
			}
			do error(30)   ; Table not found, error 30 uses tname
		}
	}
	QUIT table
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddrid() [mt,ridifn,table] PUBLIC { 
	#; DPV4005
		#;  Since PVA193, this is only called for tables, not views
		#;  Since this was the only place $$$EXTsqlviewtableidx was references, I removed the maintaning of the $$$EXTsqlviewtableidx metadata.
		#;  Trying to keep this metadata up to date was not possible when the view was created against a table mapped from a read-only database or a database where the user only had read privileges.
	QUIT $$$IDName($$$smdRowIDFieldName(1,+table))
	#; DPV4005-
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddfnext(f)  ;  KEYUP of next field name, maps ViewFieldsby/FieldName
	QUIT $o($$$smd(3,+table,"f",f))  ;  used for views only  ;  DPV1279
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA139: use mt("k") if a streamed view
ddhideid n cnt,id,identity,ifn,table,ttype  //  set hide(id)=1 if that makes valins match!
	s table=$g($$$mtFromTableName($$$mtTarget))
	set:$e(table,1,3)="%%Q" table=$$$mtKViewName($g($$$mtK))
	QUIT:table=""
	s ttype=$$$smdGetTType(table),table=$$$smdGetIrn(table)
	QUIT:table=""	//  better find a table
	If ttype=1 {	// table
		s id=+$$$smdRowIDField(1,table),ifn="",cnt=0
		s identity=0
		f  { s ifn=$o($$$smd(1,table,2,ifn)) q:'ifn  i ifn'=id,$$$smdColHidden(1,table,ifn)'="Y" { s cnt=cnt+1 s:$$$smdColIsIdentityColumn(1,table,ifn) identity=ifn }}
		if cnt=valins { s hide(id)=1 }  //  bingo - hiding the rowid will do good
		elseif identity,(cnt-1)=valins { s hide(id)=1,hide(identity)=1 }	// bingo - hiding the id AND the IDENTITY field will do good...
	}
	Else {	// view
			#;  For views, hide(FIELDNAME)="", not ifn like for tables.
		n d,irn,FIELD,vcol s id="",identity=0,FIELD="",cnt=0
		For  {
			s FIELD=$o($$$smd(3,table,"f",FIELD)) q:FIELD=""
			s vcol=""
			For  {
				s vcol=$o($$$smd(3,table,"f",FIELD,vcol),1,d) q:vcol=""
				s ifn=$p(d,$c(1),2) continue:'ifn
				s irn=$$$smdGetIrnFromIfn(ifn) s:$$$smdColNumber(1,irn,ifn)=1 id=FIELD
				i FIELD'=id,$$$smdColNumber(1,irn,ifn)'=1,$$$smdColHidden(1,irn,ifn)'="Y" { s cnt=cnt+1 s:$$$smdColIsIdentityColumn(1,irn,ifn) identity=FIELD }
			}
		}
		if id'="",cnt=valins { s hide(id)=1 }  		//  bingo - hiding the rowid will do good
		elseif id="",identity'="",cnt=valins  { s hide(identity)=1 }	//  bingo - hiding the identity will do good
		elseif id'="",identity'="",(cnt-1)=valins { s hide(id)=1,hide(identity)=1 }	// bingo - hiding the id AND the IDENTITY field will do good...
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddstst(irn)  ;  Stream statistics: #tuple^#block^,heir,^imp0^ifnID^,ifn-id, ...
		#;  If we are compiling a view query during the view's projection to SQL and the table is a linked table,
		#;  don't worry about looking at the table statistics.
		#;	DPV2807 - For views against an external table, go ahead and record the idifn in mts()
		#;                This is needed later in pre-optimizations in nufld
	new extentSize
	s idifn=$$$smdRowIDField(1,irn)
	QUIT:callname["view"&&($$$smdConnection(1,irn)'="") "^^^^"_idifn  	// DPV1970=	// DPV2807=	// DPV3121=
	s imp=+$$$smdMasterMap(1,irn)
	d error(38):'imp,error(39):'idifn
	set extentSize=$$$smdExtentSize(1,irn)
	QUIT $CASE(extentSize,"":200,0:1,:extentSize)_"^"_$$$default($$$smdMapNumberOfBlocks(imp),100)_"^^"_imp_"^"_idifn_"^"_$S("Y"=$$$smdRowIDBased(1,irn):","_$$$smdColRecIDBasedFields(1,irn,idifn)_",",1:"")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ddfun(v)  ;  The collation of the given val#, if a field - %ALPHAUP,%STRING(5),
		#;  etc., "" for EXACT field, and "*" ("coercable") if not a field
		#; NOTE!! There is a ddfun^%qaqpif2 now that MUST be kept in synch with this
		#;  one - it uses the the mt() structures as they exist at info compile time
	new val
	s val=v,v=$$$mtV(v)
	RETURN:$e(v,1,9)="v^%EXACT^" ""  ;  AK1086
	if ($e(v)="v")&&(" NVL IFNULL COALESCE CASE "[(" "_$p(v,"^",2)_" ")){
		RETURN $$nulHandlingFuncCol(v)
	}
	#; AK905
	#;  return correct collation to the all uncollate functions %RM*
	QUIT:($e(v,1,5)="v^%RM") $$colcol($p(v,"^",4))  ;  ddfun(unfn(fn(field)))=fn
	#; AK905-
	if $e(v,1,22)="v^USERDEFINEDFUNCTION:" QUIT $$$VTRgetcollation(val)	// DPV3588
	if $e(v,1,3)="v^_" {	// DPV3589
			#; if A||B and A and B have the same collation, report concatenated value as the same collation
		new collation1,collation2
		set collation1=$$ddfun($p(v,"^",4)),collation2=$$ddfun($p(v,"^",5))
		if collation1=collation2 QUIT collation1
		if collation1="*" QUIT collation2
		if collation2="*" QUIT collation1
		
	}
	i $e(v)="x",$isvalidnum($e(v,3,*)),v'="x^0" RETURN $$ddfun($e(v,3,*))  ;  lateral field
	RETURN:$e(v)="n" $$ddfun($p(v,"^",4))  ;  correlated field
	RETURN:($e(v)="v")&&(",%ANYOF,%ANYOFKEY,"[(","_$p($p(v,"^",2),":")_",")) $$ddfun($p(v,"^",4))	// JLF015
	#; if scalar subquery, recurse to its SELECT-item ; CIG014
	RETURN:$e(v)="q" $s(+$$$mtOutputVals($$$mtOutput($p(v,"^",2))):$$ddfun(+$$$mtOutputVals($$$mtOutput($p(v,"^",2)))), 1:"*" )
		#; AK403+
	QUIT:$e(v)'="f" "*"  ;  "coercable" for non-field
	i v["_%ANYOF" 
	{  QUIT:$l(v,"_")=3 $p($p(v,"^",3),"_",2) 
	   if v["_%ANYOFKEY" && ($$collectionType^%qaqpre3(val)'="bva") QUIT "" // PVA288
	   s $p(v,"^",3)=+$p(v,"^",3) 
	}	// JLF015
	QUIT:v["_" "*"
		#;  for virtual stream get original collation, use EXACT for expr's
	QUIT:$g($$$mtRVirtual($p(v,"^",2))) $$vscoll(v)	// AK701
	s v=$$$smdColCollation(1,+$$$mtR($p(v,"^",2)),$p(v,"^",3))
		#;  MRP379;DPV837;DPV859;DPV1006;DPV1095;DPV1151;DPV2546
		#;  *** when these go into the global, this could be simply  "QUIT v"
	if $$$ISENCODEDCOLLATE(v) {QUIT $s($e(v)="%":v,1:"%"_v)}
	QUIT $s(v="A":"%ALPHAUP",v="U":"%UPPER",v="S":"%SPACE",v="P":"%PLUS",v="M":"%MINUS",v="MV":"%MVR",v="E":"",v="MV":"%MVR",v="T":"%STRING",v="SS":"%SQLSTRING",v="SU":"%SQLUPPER",v="TR":"%TRUNCATE",v["T(":"%STRING("_$p(v,"(",2),v["SS(":"%SQLSTRING("_$p(v,"(",2),v["SU(":"%SQLUPPER("_$p(v,"(",2),v["TR(":"%TRUNCATE("_$p(v,"(",2),1:v)
		#; AK403-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
colcol(val) [ mt ] PUBLIC {  ;  $$: the collation applied to the given COLLATED value val
	s v=$$$mtV(val)
	QUIT:$e(v)="f" $p(v,"_",2)
	//Is a MIN or MAX aggregate? Then return the collation of the underlying value,
	//since it's retained through the aggregation.
	QUIT:$e(v,1,3)="a^m" $$colcol($p(v,"^",5))
	//Otherwise, this must be a collation operation, return the operation.
	QUIT $p(v,"^",2)  ;  for the case of val=coll(uncoll(x))
}
	#; AK701
vscoll(v)  ;  get virtual stream original field collation, including UNION
	n vm,vcoll,m,coll s vm=$$$mtRVirtual($p(v,"^",2))
	s v=$lg($g($$$mtVirf($p(v,"^",3))))  ;  position in subquery
	QUIT:'v ""  ;  vid, collation
	s vcoll=$$ddfun($p($$$mtOutputVals($$$mtOutput(vm)),",",v))
	QUIT:vcoll="" ""  ;  EXACT
	QUIT:'$d($$$mtUnion(vm)) vcoll  ;  for UNION, they all have to match!
	f m=1:1:$$$mtPNumQbs {
		i $$$mtPQbIsActive(m),$g($$$mtUnionTopQb(m))=vm,m'=vm {
			s coll=$$ddfun($p($$$mtOutputVals($$$mtOutput(m)),",",v))
			set vcoll=$s(coll_vcoll="**":"*",1:$$fnfn(coll,vcoll))
		}
	}
	QUIT vcoll
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK701-
	#;  Convert: "^" -> $c(2) AND "_" -> $c(3) AND "," -> $c(4)
twist(str) [] PUBLIC { QUIT $tr(str,"^_,",$c(2,3,4)) }
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  Convert: $c(2) -> "^"  AND $c(3) -> "_" AND $c(4) -> ","
shout(str) [] PUBLIC { QUIT $tr(str,$c(2,3,4),"^_,") }
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; This ddfldst2 version does not change tup,vals so is safe to call from elsewhere
ddfldst2(str,ifn) [tup,vals] public { new tup,vals return $$ddfldst(str,ifn) }
ddfldst(str,ifn)  ;  Field statistics:  selectivity^max-length
	QUIT:$g($$$mtRVirtual(str)) $$viewfldst(str,ifn) //$s(ifn=$p(mts(m,str),"^",5):".005^30",1:".1^50")  ;  virtual stream *** maybe find better values?	// AK446
		#;  if a virtual field, just copy statistics from the 1st field (AK420)
	QUIT:$d($$$mtVirtualOrFields(+ifn)) $p(ptv($li($li($$$mtVirtualOrFields(+ifn),2))),"^",10,11)
	#; DPV1791
	  #;  Get irn from field index because $$$mtR(str) might not be the field's irn
	  #;  Field might be from a parent table.
	n irn s irn=$$$smdGetIrnFromIfn(+ifn)
	s tup=+$g(mts(m,str),100),vals=$$$smdColSelectivity(1,irn,+ifn)  ; Note that is possible we call from %qaqpmod when mts(m,str) is not defined, so provide default tup value, if value is incorrect plan is still valid
	s:'vals vals=$$ddvals(irn,+ifn)
	#; DPV1791-
	s:ifn["_" vals=vals/1.2  ;  less values for function(field)
	#; PVA217: New heuristic and usage rules for collection selectivity. 
	#; s:ifn["%ANYOF" vals=tup**(1/12) // PVA152
	#; Instead of ensuring that up to twelve ANDed collection conditions are sure to
	#; use the index (PVA152 heuristic), ensure that AND of all the actual collection
	#; conditions is 'fairly' selective. However, many calls to ddfldst will be at times when
	#; the parse tree is in the middle of transforming between two different field 
	#; representations, making it very hard to find all the collection conditions on the
	#; same field. Further, when cloning a set of collection conditions to a new query,
	#; only one such condition will exist when the field information is set in ptv for the
	#; cloned field. As a placeholder, we store negative relation cardinality for the number of values.
	#; Before ptv selectivity information can be used, txtfixptv^%qaqpqo1 must be called at a safe time.
	if ifn["%ANYOF" { s vals=-tup s:vals>-1 vals=-1}
	else {s:vals<1 vals=1}          ;  at least one (can't divide by 0)
	QUIT 1/vals_"^"_$$$smdColMaxLength(1,irn,+ifn)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;        (Use the proper value after "NUMROWS/")
ddvals(irn,ifn) ;  Estimate #values for this field
	#;  cases:  Y/N, multiple choice, unique, RID, or designative
	QUIT:vals="NUMROWS" tup
	i $e(vals,1,8)="NUMROWS/" s vals=+$p(vals,"NUMROWS/",2) QUIT $s(vals'>1:tup,tup>vals:tup/vals,1:1)
	n isrowid,isdesref,vallist
	s isrowid=($$$smdColNumber(1,+$$$mtR(str),+ifn)=1),isdesref=($$$smdColReferencedTable(1,+$$$mtR(str),+ifn)'="")
	#; PVA34 Rearrange sequence of settings to be more logical (desref,rowid,unique,vallist,default)
	#; DPV2060= Get ref extentsize from extent so we don't have to load all referenced tables into temp structure
	If isdesref {
		new tname
		set tname=$$$smdColReferencedTable(1,irn,ifn)	// table is now IQN of referenced table
		set vals=$$$GetExtentNameFromIQN(tname)		// vals is now extent name of referenced table
		if vals="" { new fname set fname=$$$smdColName(1,irn,ifn) do error("30f") }
		set vals=$$$EXTsqlinfo($$$rEXT,vals),vals=$$$SQLLocTableExtentSize(vals)
		QUIT:vals&&(tup>vals) vals
	}
		#; SHOULD REALLY check for single property foreign key or relationship property and handle as for isdesref
	QUIT:isrowid tup
	QUIT:$$$smdColUnique(1,irn,ifn)="Y" tup ; unique
	s vallist=$$$smdColVALUELIST(1,+$$$mtR(str),+ifn)
	QUIT:vallist'="" $l(vallist,",")  ; # of choices for the field
	#; PVA34: prior default selectivity was so high that muli-component indexes were frequently not favored
	#;        over single component. This default assures index usage without hiding the benefit of
	#;        satisfying multiple equality conditions on one index.
	QUIT $s(tup<897:tup+3/3,1:300)
	#; Calculate or estimate view field statistics
viewfldst(str, ifn, nodefault=0) [ m, mt, mts ] PUBLIC {
	Set vidIfn = $p(mts(m, str),"^",5)
	If ifn = vidIfn RETURN ".005^"_$s(nodefault:"",1:"30") //original ddfldst estimate for vid
	Set subq = +$$$mtRVirtual(str)
	Set vout = $p($$$mtOutputVals($$$mtOutput(subq)),",",1,*-1) //drop trailing comma
	Set vid = $p(mts(m,str,"ATT",vidIfn),"^",5)
	Set voutPos = ""
	For i=vid+1:1:vid+$l(vout,",") {
		//must be fields
		CONTINUE:$$$mtVType($$$mtV(i))'="f"
		If +$p($$$mtV(i),"^",3) = +ifn {
			Set voutPos = i-vid
			QUIT
		}
	}
	If 'voutPos RETURN ".1^"_$s(nodefault:"",1:"50") //shouldn't get here, but bail with original ddfldst estimate
	Set v = $p(vout,",",voutPos)
	Set val = $$$mtV(v)
	If $e(val) = "f" {
		New m
		Set m = subq
		RETURN $$ddfldst($p(val,"^",2),$p(val,"^",3))
	}
	RETURN ".1^"_$s(nodefault:"",1:"50")
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#define collationStr1(%col) $s(%col'="%SQLUPPER":"$$$"_$p($e(%col,2,*),"(")_"(",1:"$e($$$SQLUPPER(")
#define collationStr2(%col) $s(%col["(":",",1:"")_$p($e(%col,2,*),"(",2)_$s(%col["%SQLUPPER(":",2,*)",%col'="%SQLUPPER":"",1:"),2,*)")
#;  queryType = 0: xDBC Query; 
#;  queryType = 1: Embedded SQL;
#;  queryType = 2: Dynamic SQL;
#;  queryType = -1: Do Not Apply RTPC;
checkRTP(sql,queryType=-1,sqlvarcparm="",selectMode="")[mt] PUBLIC {
	quit:queryType=-1 $$$OK
	set nRTP = 0,hasOutlier = 0,hasTruthValue = 0,hasRange = 0,hasListLength = 0
	quit:($$$SQLCompileOption("TuneTable")=1) $$$OK
	quit:('$g(mt("doruntime")))&&(($g(mt("noruntime")))||('$$$RTPCGLOBSETTING)||('$$$AdaptiveMode)) $$$OK
	// if user chooses to "Optimize queries based on parameter values"
	// set rtpc-utility option = 1
	quit:(($g(mt("options","parallelQuery"))=1)&&(queryType=0)) $$$OK
	
	set addOptionComment = '$G(mt("options","rtpc-utility"))
	set mt("options","rtpc-utility") = 1
	
	set key=$O(mt("options","rtpc-"),1,value)
	for {
		q:$e(key,1,5)'="rtpc-"
		// return ok if this is a runtime query
		return:key'="rtpc-utility" $$$OK
		set key=$O(mt("options",key),1,value) q:key=""
	}
	quit:'$$isRTPCApplicable^%qaqcoutlier(1,queryType,sqlvarcparm,selectMode,.hasOutlier,.outlier,.hasTruthValue,.truthValue,.hasRange,.range,.hasListLength,.listLength,.hasSameVDF,.vdfRTPC) $$$OK
	if queryType=-2 {
		set queryType=2,showPlan=1
	} else {
		set showPlan=0	
	}
	merge nRTP("dispatch-code","helper") = vdfRTPC("helper")
	set:queryType=0 nRTP("comp") = mt("sqlcomp")
	set parms = ""
	if (hasOutlier)&&('$d(mt("options","rtpc-log-sel")))&&($g(mt("options","rtpc-utility"))){
		set nRTP = 1
		if (addOptionComment&&(queryType'=1)){
			// if this comment options /*#OPTIONS {""rtpc-utility"":1} */ is updated, we should also update 
			// AddInto+2^%SYS.SQLSRV line as well
			set sql($O(sql(""),-1)) = sql($O(sql(""),-1))_" /*#OPTIONS {""rtpc-utility"":1} */"
			set addOptionComment = 0
		}
		// Generate RT dispatch code for outlier
		set str = 1,l = 0
		for i=1:1 {
			q:'$D(outlier(i))
			set inset=$lg(outlier(i),4)
			set qpar=$lg(outlier(i),6)
			set oval=$lg(outlier(i),5)
			set:$lg(outlier(i),7)'="" parms = parms_$s(parms="":"",1:",")_$lg(outlier(i),7)
			set:showPlan nRTP("logInfo","outlier")=$g(nRTP("logInfo","outlier"))_$lb($lg(outlier(i),8))
			if ('$isvalidnum($lg(outlier(i),2))){
				set osel = """"_$lg(outlier(i),1)_"^""_"_$lg(outlier(i),2)
				set sel = """"_$lg(outlier(i),1)_"^""_"_$lg(outlier(i),3)
			} else {
				set osel = """"_$lts($li(outlier(i),1,2),"^")_""""
				set sel = """"_$lg(outlier(i),1)_"^"_$lg(outlier(i),3)_""""
			}
			if inset = 1 { // for list op
				set qpar = "$D("_qpar_"("_oval_"))"
				set tmp = $S(i>1:$$$quote(""","""),1:"")_"_$S("_qpar_">0:"_osel_",1:"_sel_")"
			} else{ // for = op
				set tmp = $S(i>1:$$$quote(""","""),1:"")_"_$S("_qpar_"="_oval_":"_osel_",1:"_sel_")"
			}
			if (l+$L(tmp)>$$$MaxRtnLineLength)&&l{
				set str($I(str)) = tmp
				set l = $L(tmp)
			}
			else{
				set str(str) = $G(str(str))_$S(l:"_",1:"")_tmp
				set l = l+$L(tmp)
			}
		}
		set dc = 0
		set key=""
		for {
			set key=$O(outlier("exp",key),1,value) q:key=""	
			
			set dc($I(dc))=$c(9)_value
		}
		set key=""
		for {
			set key=$O(outlier("llexp",key),1,value) q:key=""	
			
			set dc($I(dc))=$c(9)_value
		}
		for i=1:1:str {
			if i=1 {
				set dc($I(dc))=$c(9)_"set SQLrtpcrtexpr1="_$E(str(i),2,*)
			}
			
			else{
				set dc($I(dc))=$c(9)_"set SQLrtpcrtexpr1=SQLrtpcrtexpr1_"_str(i)	
			}
			
		} 
		merge nRTP("dispatch-code","rtexpr") = dc
		set nRTP("rtexprStr") = "SQLrtpcrtexpr1"
	}
	if (hasTruthValue)&&('$d(mt("options","rtpc-truthValue")))&&($g(mt("options","rtpc-utility"))){
		set nRTP = 1
		kill str
		if (addOptionComment&&(queryType'=1)){
			set sql($O(sql(""),-1)) = sql($O(sql(""),-1))_" /*#OPTIONS {""rtpc-utility"":1} */"
			set addOptionComment = 0
		}
		set str = 1,l = 0, key = "", i = 0
		for {
			set key=$O(truthValue(key),1,value) q:(key="")||((+key)=0)
			set val1=$lg(value,1)
			set op=$lg(value,2)
			set val2=$lg(value,3)
			set:$lg(value,4)'="" parms = parms_$s(parms="":"",1:",")_$lg(value,4)
			set hash = $lg(value,5)
			set:showPlan nRTP("logInfo","truthvalue")=$g(nRTP("logInfo","truthvalue"))_$lb($lg(value,6))
			set tVal=hash_"^1" // it is impossible to have "^" in the hash, so we can put hash^T/F as truth value info
			set fVal=hash_"^0"
			set i = $I(i)
			if op = "NULL" {
				set tmp = $S(i>1:$$$quote(""","""),1:"")_"_$S(("_val1_"=""""):"""_tVal_""",1:"""_fVal_""")"
			} elseif op = "'NULL"{
				set tmp = $S(i>1:$$$quote(""","""),1:"")_"_$S(("_val1_"'=""""):"""_tVal_""",1:"""_fVal_""")"
			}else {
				set tmp = $S(i>1:$$$quote(""","""),1:"")_"_$S((("_val1_"="""")||("_val2_"="""")):"""_fVal_""","_val1_op_val2_":"""_tVal_""",1:"""_fVal_""")"
			}
			if (l+$L(tmp)>$$$MaxRtnLineLength)&&l{
				set str($I(str)) = tmp
				set l = $L(tmp)
			}
			else{
				set str(str) = $G(str(str))_$S(l:"_",1:"")_tmp
				set l = l+$L(tmp)
			}
		}
		kill dc
		set dc = $G(nRTP("dispatch-code","rtexpr"),0)
		set key=""
		for {
			set key=$O(truthValue("exp",key),1,value) q:key=""	
			
			set dc($I(dc))=$c(9)_value
		}
		for i=1:1:str {
			if i=1 {
				set dc($I(dc))=$c(9)_"set SQLrtpcrtexpr2="_$E(str(i),2,*)
			}
			
			else{
				set dc($I(dc))=$c(9)_"set SQLrtpcrtexpr2=SQLrtpcrtexpr2_"_str(i)	
			}
			
		} 
		merge nRTP("dispatch-code","rtexpr") = dc
		set nRTP("rtexprStr") = $S($G(nRTP("rtexprStr"))="":"SQLrtpcrtexpr2",1:nRTP("rtexprStr")_"_SQLrtpcrtexpr2")
	}
	if (hasRange)&&('$d(mt("options","rtpc-range")))&&($g(mt("options","rtpc-utility"))){
		set nRTP = 1
		kill str
		if (addOptionComment&&(queryType'=1)){
			set sql($O(sql(""),-1)) = sql($O(sql(""),-1))_" /*#OPTIONS {""rtpc-utility"":1} */"
			set addOptionComment = 0
		}
		set str = 1,l = 0, key = "", i = 0,rangeSelCalCode = 0
		for {
			set key=$O(range(key),1,value) q:(key="")||((+key)=0)
			set setSelOne = $S(value=1:1,1:0)
			set log=key
			if 'setSelOne {
				set lowerValue = $lg(value,2)
				set upperValue = $lg(value,3)
				set hist = ##class(%Library.Global).Unquote($lg(value,8))
				if hist'=""{
					set binWidth = $LIST(hist,1)
					set isNumInterp = $LIST(hist,2)
					set nullBucketCount = $LIST(hist,3)
					set bucketVals = $LIST(hist,4)
					set commonLeadingChars = $LIST(hist,5)
					set intBucketVals = $LIST(hist,6) 
				}
				set lowerOp = $lg(value,5)
				set upperOp = $lg(value,6)
				set neValue = $lg(value,7)
				set:showPlan nRTP("logInfo","range")=$g(nRTP("logInfo","range"))_$lg(value,9)
				set sel = $lg(value,10)
				set:$lg(value,4)'="" parms = parms_$s(parms="":"",1:",")_$lg(value,4)
			}
			set i = $I(i)
			if setSelOne {
				set tmp = $S(i>1:$$$quote(""","""),1:"")_"_"_$$$quote(log_"^1")
			} elseif nullBucketCount=16{
				set tmp = $S(i>1:$$$quote(""","""),1:"")_"_"_$$$quote(log_"^.00001")
			} elseif $ll(neValue)=2{ //%STARTSWITH
				set nullValue = $lg(neValue),emptyValue=$lg(neValue,2)
				set nullSel=$s(nullBucketCount=0:0.999999,1:1-(nullBucketCount/16))
				set rangeSelCalCode($I(rangeSelCalCode))="if ("_lowerValue_"="_nullValue_")||($l("_lowerValue_")=0)||("_lowerValue_"="_emptyValue_") {"
				set rangeSelCalCode($I(rangeSelCalCode))=$c(9)_"set SQLrtpcbucketSel"_log_"="_nullSel
				set rangeSelCalCode($I(rangeSelCalCode))="}"
				set rangeSelCalCode($I(rangeSelCalCode))="else{ "
				do genRangeSelCalCode($c(9),lowerValue,lowerOp,upperValue, upperOp, nullBucketCount, bucketVals, commonLeadingChars, intBucketVals, binWidth, isNumInterp, log,.rangeSelCalCode,sel)
				set rangeSelCalCode($I(rangeSelCalCode))="}"
				set tmp = $S(i>1:$$$quote(""","""),1:"")_"_"_$$$quote(log_"^")_"_SQLrtpcbucketSel"_log
				
			} else{
				do genRangeSelCalCode(,lowerValue, lowerOp,upperValue, upperOp, nullBucketCount, bucketVals, commonLeadingChars, intBucketVals, binWidth, isNumInterp, log,.rangeSelCalCode,sel)
				set tmp = $S(i>1:$$$quote(""","""),1:"")_"_"_$$$quote(log_"^")_"_SQLrtpcbucketSel"_log
			}
			if (l+$L(tmp)>$$$MaxRtnLineLength)&&l{
				set str($I(str)) = tmp
				set l = $L(tmp)
			}
			else{
				set str(str) = $G(str(str))_$S(l:"_",1:"")_tmp
				set l = l+$L(tmp)
			}
		}
		
		kill dc
		set dc = $G(nRTP("dispatch-code","rtexpr"),0)
		set key=""
		for {
			set key=$O(range("exp",key),1,value) q:key=""	
			
			set dc($I(dc))=$c(9)_value
		}
		for i=1:1:rangeSelCalCode {
			set dc($I(dc))=$c(9)_rangeSelCalCode(i)
		} 
		for i=1:1:str {
			if i=1 {
				set dc($I(dc))=$c(9)_"set SQLrtpcrtexpr3="_$E(str(i),2,*)
			}
			
			else{
				set dc($I(dc))=$c(9)_"set SQLrtpcrtexpr3=SQLrtpcrtexpr3_"_str(i)	
			}
			
		} 	
		merge nRTP("dispatch-code","rtexpr") = dc
		set nRTP("rtexprStr") = $S($G(nRTP("rtexprStr"))="":"SQLrtpcrtexpr3",1:nRTP("rtexprStr")_"_SQLrtpcrtexpr3")
	}
	if (hasListLength)&&('$d(mt("options","rtpc-list")))&&($g(mt("options","rtpc-utility"))){
		set nRTP = 1
		kill str
		if (addOptionComment&&(queryType'=1)){
			set sql($O(sql(""),-1)) = sql($O(sql(""),-1))_" /*#OPTIONS {""rtpc-utility"":1} */"
			set addOptionComment = 0
		}
		set str = 1,l = 0
		for i=1:1 {
			q:'$D(listLength(i))
			set log=$lg(listLength(i),1)
			set sel=$lg(listLength(i),2)
			set:$lg(listLength(i),3)'="" parms = parms_$s(parms="":"",1:",")_$lg(listLength(i),3)
			set tmp = $S(i>1:$$$quote(""","""),1:"")_"_"_$$$quote(log_"^")_"_"_sel
			if (l+$L(tmp)>$$$MaxRtnLineLength)&&l{
				set str($I(str)) = tmp
				set l = $L(tmp)
			}
			else{
				set str(str) = $G(str(str))_$S(l:"_",1:"")_tmp
				set l = l+$L(tmp)
			}
			set:showPlan nRTP("logInfo","listlength")=$g(nRTP("logInfo","listlength"))_$lb($lg(listLength(i),4))
		}
	kill dc
		set dc = $G(nRTP("dispatch-code","rtexpr"),0)
		set key=""
		for {
			set key=$O(listLength("exp",key),1,value) q:key=""	
			
			set dc($I(dc))=$c(9)_value
		}
		for i=1:1:str {
			if i=1 {
				set dc($I(dc))=$c(9)_"set SQLrtpcrtexpr4="_$E(str(i),2,*)
			}
			
			else{
				set dc($I(dc))=$c(9)_"set SQLrtpcrtexpr4=SQLrtpcrtexpr4_"_str(i)	
			}
			
		} 
		merge nRTP("dispatch-code","rtexpr") = dc
		set nRTP("rtexprStr") = $S($G(nRTP("rtexprStr"))="":"SQLrtpcrtexpr4",1:nRTP("rtexprStr")_"_SQLrtpcrtexpr4")
	}
	if (hasSameVDF)&&('$d(mt("options","rtpc-vdf")))&&($g(mt("options","rtpc-utility"))){
		set nRTP = 1
		kill str
		if (addOptionComment&&(queryType'=1)){
			set sql($O(sql(""),-1)) = sql($O(sql(""),-1))_" /*#OPTIONS {""rtpc-utility"":1} */"
			set addOptionComment = 0
		}
		set str = 1,l = 0, key = "", i = 0,rangeSelCalCode = 0
		for {
			set key=$O(vdfRTPC(key),1,value) q:(key="")||('$isvalidnum(key))
			set:showPlan nRTP("logInfo","vdf")=$g(nRTP("logInfo","vdf"))_$lb($li(value,1,3))
			set $lb(m,ordPos,selPos,hash,result,parm)=value
			set:parm'="" parms = parms_$s(parms="":"",1:",")_parm
			set tmp = $S($i(i)>1:$$$quote(""","""),1:"")_"_"_$$$quote(m_"^"_ordPos_"^"_selPos_"^"_hash_"^")_"_"_result
			
			if (l+$L(tmp)>$$$MaxRtnLineLength)&&l{
				set str($I(str)) = tmp
				set l = $L(tmp)
			}
			else{
				set str(str) = $G(str(str))_$S(l:"_",1:"")_tmp
				set l = l+$L(tmp)
			}
		}
		kill dc
		set dc = $G(nRTP("dispatch-code","rtexpr"),0)
		set key=""
		for {
			set key=$O(vdfRTPC("exp",key),1,value) q:key=""	
			
			set dc($I(dc))=$c(9)_value
		}
		for i=1:1:str {
			if i=1 {
				set dc($I(dc))=$c(9)_"set SQLrtpcrtexpr5="_$E(str(i),2,*)
			}
			
			else{
				set dc($I(dc))=$c(9)_"set SQLrtpcrtexpr5=SQLrtpcrtexpr5_"_str(i)	
			}
		} 	
		merge nRTP("dispatch-code","rtexpr") = dc
		set nRTP("rtexprStr") = $S($G(nRTP("rtexprStr"))="":"SQLrtpcrtexpr5",1:nRTP("rtexprStr")_"_SQLrtpcrtexpr5")
	}
	kill dc
	set dc = 0
	
	if (queryType=0)||(queryType=2){
		for i=1:1:sql {
			set sqlline=sql(i)
			set sqllen=$l(sqlline)
			set tsql(i,$I(tsql(i)))=$e(sqlline,1,$$$MaxRtnLineLength) // First 4k of this line of code
			for ii=($$$MaxRtnLineLength+1):$$$MaxRtnLineLength { quit:ii>sqllen  set tsql(i,$I(tsql(i)))=$e(sqlline,ii,ii+$$$MaxRtnLineLength-1) }	// Remaining 4k chunks of this line
		}
	}
	if (queryType=0) {
		for i=1:1:sql {
			for j=1:1:tsql(i){
				if (i=sql)&&(j=tsql(i)) {
					set str = ""
					set:hasOutlier str = str_$$$quote(tsql(i,j)_" /*#OPTIONS {""rtpc-log-sel"":[""")
	 									_"_SQLrtpcrtexpr1_"
	 				set:hasTruthValue str = str_$$$quote($s(str="":tsql(i,j)_" /*#OPTIONS {",1:"""],")_"""rtpc-truth-value"":[""")
	 									_"_SQLrtpcrtexpr2_"
	 				set:hasRange str = str_$$$quote($s(str="":tsql(i,j)_" /*#OPTIONS {",1:"""],")_"""rtpc-range"":[""")
	 									_"_SQLrtpcrtexpr3_"
	 				set:hasListLength str = str_$$$quote($s(str="":tsql(i,j)_" /*#OPTIONS {",1:"""],")_"""rtpc-list"":[""")
	 									_"_SQLrtpcrtexpr4_"
	 				set:hasSameVDF str = str_$$$quote($s(str="":tsql(i,j)_" /*#OPTIONS {",1:"""],")_"""rtpc-vdf"":[""")
	 									_"_SQLrtpcrtexpr5_"
					set tmp = $c(9)_"set SQLrtpcsql("_i_")="_$s(j>1:"SQLrtpcsql("_i_")_",1:"")_str_$$$quote("""]} */")
					set dc($I(dc))=tmp 	
					set dc($I(dc))=$c(9)_"set SQLrtpcsql(0)="_sql			
				} 
				else {
					set dc($I(dc))=$c(9)_"set SQLrtpcsql("_i_")="_$s(j>1:"SQLrtpcsql("_i_")_",1:"")_$$$quote(tsql(i,j))
				}
			}
		}
	}elseif (queryType=2) {
		for i=1:1:sql {
			for j=1:1:tsql(i){
				if (i=sql)&&(j=tsql(i)) {	
					set str = ""
					set:hasOutlier str = str_$$$quote(tsql(i,j)_" /*#OPTIONS {""rtpc-log-sel"":[""")
	 									_"_SQLrtpcrtexpr1_"
	 				set:hasTruthValue str = str_$$$quote($s(str="":tsql(i,j)_" /*#OPTIONS {",1:"""],")_"""rtpc-truth-value"":[""")
	 									_"_SQLrtpcrtexpr2_"
	 				set:hasRange str = str_$$$quote($s(str="":tsql(i,j)_" /*#OPTIONS {",1:"""],")_"""rtpc-range"":[""")
	 									_"_SQLrtpcrtexpr3_"
	 				set:hasListLength str = str_$$$quote($s(str="":tsql(i,j)_" /*#OPTIONS {",1:"""],")_"""rtpc-list"":[""")
	 									_"_SQLrtpcrtexpr4_"	
	 				set:hasSameVDF str = str_$$$quote($s(str="":tsql(i,j)_" /*#OPTIONS {",1:"""],")_"""rtpc-vdf"":[""")
	 									_"_SQLrtpcrtexpr5_"		
					set dc($I(dc))=$c(9)_"set SQLrtpcsql="_$S((i=1)&&(j=1):"",1:"SQLrtpcsql_")_str_$$$quote("""]} */")
				} else{
					set dc($I(dc))=$c(9)_"set SQLrtpcsql="_$S((i=1)&&(j=1):"",1:"SQLrtpcsql_")
										_$$$quote(tsql(i,j))
				}
	 		}
		}
	} else {
		set key=""
		for {
			set key=$O(sql(key),1,value) q:key=""			
			for j=1:1024:$l(value) {
				set qtmp=$$quoteName^%qaqcasl($$$QuoteName($e(value,j,j+1023)))
				set dc($I(dc))=$c(9,9,9)_"set SQLrtpcxxsql(""S"","_key_")="_$s(j=1:"",1:"SQLrtpcxxsql(""S"","_key_")_")_qtmp
			}
			set tkey = key
		}
		set str = ""
		set:hasOutlier str = $$$quote(" /*#OPTIONS {""rtpc-utility"":1,""rtpc-log-sel"":[""")
 							_"_SQLrtpcrtexpr1_"
 		set:hasTruthValue str = str_$$$quote($s(str="":" /*#OPTIONS {""rtpc-utility"":1,",1:"""],")_"""rtpc-truth-value"":[""")
 							_"_SQLrtpcrtexpr2_"
 		set:hasRange str = str_$$$quote($s(str="":" /*#OPTIONS {""rtpc-utility"":1,",1:"""],")_"""rtpc-range"":[""")
 							_"_SQLrtpcrtexpr3_"
 		set:hasListLength str = str_$$$quote($s(str="":" /*#OPTIONS {""rtpc-utility"":1,",1:"""],")_"""rtpc-list"":[""")
 							_"_SQLrtpcrtexpr4_"
 		set:hasSameVDF str = str_$$$quote($s(str="":" /*#OPTIONS {""rtpc-utility"":1,",1:"""],")_"""rtpc-vdf"":[""")
 							_"_SQLrtpcrtexpr5_"
 		set dc($I(dc))=$c(9,9,9)_"set SQLrtpcxxsql(""S"","_(tkey+1)_")= "_str_$$$quote("""]} */")
	}
	merge nRTP("dispatch-code","sql") = dc
	set:queryType=1 nRTP("params") = parms
	merge mt("nRTP") = nRTP
	QUIT $$$OK	
}
#; LV = lower value
#; LO = lower operator
#; UV = upper value
#; UO = upper operator
#; NNB = number of null buckets
#; HI = histogram buckets
#; CL = number of common leading characters between successive buckets (stored in histogram)
#; IB = bounds converted to integers after stripping shared leading characters (stored in histogram)
#; BW = bin width, e.g. with 16 bins, binwidth = 1/15 = .0666667 (stored in histogram)
#; NI = is the field numerically interpolatable? (stored in histogram)
#define SB(%i) $CASE(%i,0:0,1:.00006103515625,2:.000244140625,3:.0009765625,4:.00390625,5:.015625,6:.0625,7:.25,8:1,:"")
#define SBmiddle(%i) (($$$SB(%i+0.5)+$$$SB(%i-0.5))/2)
#define minAccuracy 0.001
genRangeSelCalCode(indent="",LV="",LO="",UV="",UO="",NNB=0,HI,CL,IB,BW,NI,log,&str,sel) PUBLIC{
	#; find the lower bucket
	if LO = "" {
		set str($I(str)) = indent_"set SQLrtpclowerBucket = "_(NNB + 1)
