		set str($I(str)) = indent_"}"
	}
	
	#; If need to interpolate but bounds and values are not integers,
	  #; get the corresponding intege values
	set str($I(str)) = indent_"if SQLrtpcupperBucket = SQLrtpclowerBucket{"
	set str($I(str)) = indent_$c(9)_"if (SQLrtpclowerBucket = 1)||(SQLrtpclowerBucket = 17){"
	set str($I(str)) = indent_$c(9,9)_"set SQLrtpcES = 0"
	set str($I(str)) = indent_$c(9)_"} else{"
	if NI{
		set str($I(str)) = indent_$c(9,9)_"set SQLrtpclower = $LI("_##class(%Library.Global).Quote(HI)_",SQLrtpclowerBucket-1)"
		set str($I(str)) = indent_$c(9,9)_"set SQLrtpcupper = $LI("_##class(%Library.Global).Quote(HI)_",SQLrtpclowerBucket)"
		#; compute the exact (un-bucketed) selectivity
		set str($I(str)) = indent_$c(9,9)_"set SQLrtpcES = $s(SQLrtpclower=SQLrtpcupper:0,SQLrtpclower=""-10000000000000000000"":0,("_$s(UO="":"SQLrtpcupper",1:UV)_"-"_$s(LO="":"SQLrtpclower",1:LV)_")/(SQLrtpcupper-SQLrtpclower)<"_$$$minAccuracy_":-0.06667,1:("_$s(UO="":"SQLrtpcupper",1:UV)_"-"_$s(LO="":"SQLrtpclower",1:LV)_")*"_BW_"/(SQLrtpcupper-SQLrtpclower))"
	
	} else{
		set str($I(str)) = indent_$c(9,9)_"set SQLrtpclower = $LI("_##class(%Library.Global).Quote(IB)_",2*(SQLrtpclowerBucket-1))"
		set str($I(str)) = indent_$c(9,9)_"set SQLrtpcupper = $LI("_##class(%Library.Global).Quote(IB)_",2*SQLrtpclowerBucket-1)"
		
		if UO'="" {
			set str($I(str)) = indent_$c(9,9)_"set SQLrtpchighStr = $extract("_UV_",$LI("_##class(%Library.Global).Quote(CL)_",SQLrtpclowerBucket-1)+1,*)"
			set str($I(str)) = indent_$c(9,9)_"if $ziswide(SQLrtpchighStr){set SQLrtpchighStr=$zconvert(SQLrtpchighStr,""O"",""UTF8"")}"
			set str($I(str)) = indent_$c(9,9)_"Set SQLrtpcUV=$zla($e($c(0,0,0,0)_$reverse($e(SQLrtpchighStr,1,4)),*-3,*))"
		}
		if LO'="" {
			set str($I(str)) = indent_$c(9,9)_"set SQLrtpclowStr = $extract("_LV_",$LI("_##class(%Library.Global).Quote(CL)_",SQLrtpclowerBucket-1)+1,*)"
			set str($I(str)) = indent_$c(9,9)_"if $ziswide(SQLrtpclowStr){set SQLrtpclowStr=$zconvert(SQLrtpclowStr,""O"",""UTF8"")}"
			set str($I(str)) = indent_$c(9,9)_"set SQLrtpcLV=$zla($e($c(0,0,0,0)_$reverse($e(SQLrtpclowStr,1,4)),*-3,*))"
		}
		set str($I(str)) = indent_$c(9,9)_"set SQLrtpcES = $s(SQLrtpclower=SQLrtpcupper:0,SQLrtpclower=""-10000000000000000000"":0,("_$s(UO="":"SQLrtpcupper",1:"SQLrtpcUV")_"-"_$s(LO="":"SQLrtpclower",1:"SQLrtpcLV")_")/(SQLrtpcupper-SQLrtpclower)<"_$$$minAccuracy_":-0.06667,1:("_$s(UO="":"SQLrtpcupper",1:"SQLrtpcUV")_"-"_$s(LO="":"SQLrtpclower",1:"SQLrtpcLV")_")*"_BW_"/(SQLrtpcupper-SQLrtpclower))"
	
	}
	set str($I(str)) = indent_$c(9)_"}"
	set str($I(str)) = indent_"} else{"
	#; set the lower percentile
	if LO = ""{
		if (NNB=0){
			set str($I(str)) = indent_$c(9)_"set SQLrtpclowerPerc = 0"
		} elseif (NNB = 16) {
			set str($I(str)) = indent_$c(9)_"set SQLrtpclowerPerc = 1"
		} else {
			set str($I(str)) = indent_$c(9)_"set SQLrtpclowerPerc = (SQLrtpclowerBucket-1)*"_BW
		}
	} else {
		set str($I(str)) = indent_$c(9)_"set SQLrtpclowerPerc = $S(SQLrtpclowerBucket=1:0,SQLrtpclowerBucket=17:1,"_LV_"=$LI("_##class(%Library.Global).Quote(HI)_",SQLrtpclowerBucket):(SQLrtpclowerBucket-1)*"_BW_",1:(SQLrtpclowerBucket-1.5)*"_BW_")"
	}
	 #; set the upper percentile
	if UO = "" {
		set str($I(str)) = indent_$c(9)_"set SQLrtpcupperPerc = 1"	
	} else {
		set str($I(str)) = indent_$c(9)_"set SQLrtpcupperPerc = $S(SQLrtpcupperBucket=17:1,SQLrtpcupperBucket=1:0,"_UV_"=$LI("_##class(%Library.Global).Quote(HI)_",SQLrtpcupperBucket):(SQLrtpcupperBucket-1)*"_BW_",1:(SQLrtpcupperBucket-1.5)*"_BW_")"	
	}
	
	set str($I(str)) = indent_$c(9)_"set SQLrtpcES = SQLrtpcupperPerc - SQLrtpclowerPerc"
	set str($I(str)) = indent_"}"
	set str($I(str)) = indent_"set SQLrtpcbucketSel"_log_" = $S(SQLrtpcES=-0.06667:SQLrtpcES,SQLrtpcES=0:.00001,"_sel_"]]SQLrtpcES:"_sel_",SQLrtpcES]]"_$$$SB(4)_":$S(SQLrtpcES]]"_$$$SB(6)_":$S(SQLrtpcES]]"_$$$SB(7)_":"_$$$SBmiddle(7.5)_",1:"_$$$SBmiddle(6.5)_"),1:$S(SQLrtpcES]]"_$$$SB(5)_":"_$$$SBmiddle(5.5)_",1:"_$$$SBmiddle(4.5)_")),1:$S(SQLrtpcES]]"_$$$SB(2)_":$S(SQLrtpcES]]"_$$$SB(3)_":"_$$$SBmiddle(3.5)_",1:"_$$$SBmiddle(2.5)_"),1:$S(SQLrtpcES]]"_$$$SB(1)_":"_$$$SBmiddle(1.5)_",1:"_$$$SBmiddle(0.5)_")))"
}
chckcard	; Check the Cardinality between the SELECT-list & INTO-list...
	i ",DEC,SEL,"[(","_$$$mtStatementType_","),$d($$$mtSelectInto) d  ; Cardinality Check
	. ; --- Check for valid SELECT with Mixed INTO array/scalar ---
	. q:$g($$$mtSelectInto)?1.n1",^"1.n1",".e&&($p($g($$$mtV(+$$$mtSelectInto)),"^",2)["(")   ; Valid SELECT Mixed...
	. q:$$staro  ; Don't check for SELECT <qualifier>.<asterisk> now...
	. n totb
	. s totb=$l($p($$$mtSelectInto,"^",2),",")-1 q:'totb  ; No INTO-list (Must be an array)...
	. if $d(mt("into$list")) { do:totb'=1 error(176) QUIT }
	. n toto 
	. s toto=$l($$$mtOutputVals($g($$$mtOutput(1))),",")-1 q:'toto  ; No SELECT-list (Must be SELECT *)...
	. n i,node s i="",node="" f  s i=$o($$$mtOutputOverflow(1,i)) q:'+i  s toto=toto+$l($$$mtOutputOverflow(1,i),",")-1
	. d:totb'=toto error(76)
	i $$$mtStatementType="FET",$d($$$mtSelectInto),mcurs'="" d  ; Cardinality Check...
	. n totb s totb=$l($p($$$mtSelectInto,"^",2),",")-1 q:'totb  ; No INTO-list (Must be an array)...
	. if $d(mt("into$list")) { do:totb'=1 error(176) QUIT }
	. new toto s toto=$l($g(mtc(mcurs,"o")),$c(1))-1
	. q:'toto  ; No SELECT-list (Must be SELECT *)...
	. d:totb'=toto error(76)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
starchk	; Check for SELECT ...,<qualifier>.<asterisk>,... and expand...
	n expand,node,olist,sellist
	s sellist=$$$mtOutputVals($g($$$mtOutput(1)))
	QUIT:sellist=""  ; No SELECT-list (Must be SELECT *)...
	s olist("o",1)=$p($$$mtOutput(1),"^")_"^"
	s expand=$$expand(sellist,.olist)
	s node=""
	f  s node=$o($$$mtOutputOverflow(1,node)) q:'+node  s expand=expand+$$expand($$$mtOutputOverflow(1,node),.olist)
	QUIT:'expand  ; No Expansion so nothing to do...
		#;
		#; --- Expanded SELECT <qualifier>.<asterisk> so reset Parse Tree ---
		#;
	k $$$mtOutput(1) m $$$mtOutput(1)=olist("o",1)
	d chckcard  ; Check SELECT-list/INTO-list Cardinality Match..
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
staro() [mt] PUBLIC {
		#; Check to see if there are any SELECT <qualifier>.<asterisk> fields..
	s found=$$starfld($$$mtOutputVals($g($$$mtOutput(1)))) QUIT:found found  ; <qualifier>.<asterisk> Found...
	s node="" f  s node=$o($$$mtOutputOverflow(1,node)) q:'+node  s found=$$starfld($$$mtOutputOverflow(1,node)) q:found
	QUIT found
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
starfld(sellist) [mt] PUBLIC {
		#; Check to see if there is a <qualifier>.<asterisk> field...
		#;         (Return 0 - None Found or 1 - Found)
	s found=0
	f ii=1:1 { s val=$p(sellist,",",ii) q:'+val  s info=$g($$$mtV(val)) i $p(info,"^")="f",$p(info,"^",4)="*" { s found=1 q  } }
	QUIT found
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
expand(sellist,olist) ; Spin through all the Select List Items and Expand
	#;             (Return 0 - No Expansion or 1 - Expansion)
	n expand,fcol,ii,info,ml,newval,setlist,table,val,valinfo,mtcpos,infocnt,tmpvals,tvcnt
	s expand=0,setlist=0,mtcpos=0,fcol=""
	f ii=1:1 {
		s val=$p(sellist,",",ii) q:'val  ; Check SELECT-List
		s mtcpos=mtcpos+1 ; for expanding the mtc array
		i setlist { d:"DEC SEL"[$$$mtStatementType olist(setlist) s setlist=0 } ; Set 'val' into 'olist'...
		s info=$g($$$mtV(val))
		i $p(info,"^")'="f"||($p(info,"^",4)'="*") { s setlist=val continue  }  ; Nothing to do
		s ml=$p(info,"^",2,3)
		i +ml'=1 { s setlist=val continue }             // Don't expand Subqueries
		i '$$$mtPQbIsActive(+ml) { s setlist=val continue  }	// Ignore obsolete query-blocks
		s $$$mtVType($$$mtV(val))="i"  ;  mark old "T.*' node in ST as obsolete	// AK373
		if $e($g($$$mtFromTableName(ml)))=$c(1) { s table=$$DetermineQualifiedName(,,ml) }
		else {  n tname s tname=$g($$$mtFromTableName(ml)),table=$p($g($$$smd("rv",$$$IDName(tname))),$c(1),2,3) d error(30):table="" }	// DPV1831, DPV2060
		d ddtcol d error(33):fname=""
		s expand=1 k tmpvals
		For  {  ; Expand all the field from the given table..
			q:fname=""
			s newval=$g($$$ptln($p(ml,"^",2)_"^"_fname))    ; Exists with label,
			s:'newval newval=$g($$$ptln("^"_fname))         ; or without,
			i 'newval { Set val=$$$newval("f"_"^"_ml_"^"_fname,1) s newval=val	}	// AK373
			i "DEC SEL"[$$$mtStatementType { d olist(newval) s tmpvals($i(tmpvals))=newval }	// save the newvals for mtc
			d ddtcol
		}
		if callname="info","DEC SEL"[$$$mtStatementType {		// shift mtc down, put in new entries
			s infocnt="" f  { s infocnt=$o(mtc(0,0,"select",infocnt),-1) q:infocnt=mtcpos  s mtc(0,0,"select",infocnt+tmpvals-1)=mtc(0,0,"select",infocnt) }
			s infocnt=mtcpos-1 f tvcnt=1:1:tmpvals { s val=tmpvals(tvcnt) d title^%qaqpslx }
			s mtcpos=mtcpos+tmpvals-1
		}
	}
			#; Maybe Set 'val' into 'olist'...
	d:setlist&&("DEC SEL"[$$$mtStatementType) olist(setlist)
	QUIT expand
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
olist(val) [olist] PUBLIC {
		#; Append val to olist("o",1)
	i $l($g(olist("o",1)))<$$$complength { s olist("o",1)=$g(olist("o",1))_val_"," QUIT  }
	s ext=$o(olist("o",1," "),-1)+1,olist("o",1,ext)=val_","
	QUIT
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
start	RETURN:$d($$$mtRoles)    // Roles - no need to check data dict
	new label,list,ml,name,objid,rvidxdata,tname,typ,val
	set typ=""
	
	if $d($$$mtFromTableName("1^*")) {
		if $d($$$mtKAction("EXECUTE"))    { set $$$mtR(9)="*" }
		elseif $d($$$mtKAction("CUBE"))   { set $$$mtR(4)="*" }
		elseif $d($$$mtKAction("SERVER")) { set $$$mtR(7)="*" }
		elseif $d($$$mtKAction("USE"))    { set $$$mtR(6)="*" } // only hit for ML configs b/c of above condition
		else                        { set $$$mtR(1)="*", $$$mtR(3)="*" }
		RETURN
	}
.
		#; checks for existance of tables, views and fields
		#; sets up list of ids in $$$mtR(1) for tables ($List format)
		#;                        $$$mtR(3) for views  ($List format)
		#;                        $$$mtR(4) for cubes ($List format)
		#;                        $$$mtR(5) for schemas ($List format)
		#;                        $$$mtR(6) for ML Configuration ($List format)
		#;                        $$$mtR(7) for foreign servers ($List format)
		#;                        $$$mtR(9) for procedures ($List format)
		#; stores ifn,ivfn in $$$mtV(val#)
	if $d($$$mtKAction( "SERVER")) {
		new object, schema, server, serverClass, serverIQN
		set object = ""
		for  {
			set object = $o($$$mtFromTableName(object)) 
			QUIT:object=""
			set tname = $p(object, "^", 2) // tname used by error(30)
			set serverClass = $$LookUpClassName^%apiDDL2(tname)
			do:serverClass="" error(30)
			// store the exact case when we log the privilege, up until this point it's all caps:
			set schema = $$$comClassKeyGet(serverClass, $$$cCLASSsqlschemaname)
			set server = $$$comClassKeyGet(serverClass, $$$cCLASSsqltablename)
			set sc = $$updateForeignServerIndex^%SYS.SQLSEC
			if $$$ISERR(sc) {
				set %msg = "Encountered error updating foreign server index: " _ $SYSTEM.Status.GetErrorText(sc)
				do error(400)
				RETURN 0
			}
			do:'$d(^rINDEXSQL("SERVER", $$$UPPER(schema), $$$UPPER(server))) error(30) 
			set $$$mtR(7)=$g($$$mtR(7))_$lb(schema_"."_server)
		}
		RETURN
	}
	set ml="",label=""
	if $d($$$mtKAction("USE")),'$d($$$mtKAction( "zzzSCHEMA")) { // Only ML Configuration privs, because above condition checks SERVERs
		for  {
			set ml=$o($$$mtFromTableName(ml)) quit:ml=""
			set $$$mtR(6)=$g($$$mtR(6))_$lb($p(ml,"^",2))
		}
		RETURN
	}
	if $d($$$mtKAction("CUBE")) {									// DPV3316
		f  s ml=$o($$$mtFromTableName(ml)) q:ml=""  s $$$mtR(4)=$g($$$mtR(4))_$lb($p(ml,"^",2))
		QUIT
	}
	if $d($$$mtKAction("zzzSCHEMA")) {
		for  { set ml=$o($$$mtFromTableName(ml)) quit:ml=""  set $$$mtR(5)=$g($$$mtR(5))_$lb($p(ml,"^",2)) }
		QUIT
	}
		#; loops through table,view names
		#;  Make sure all tables/views in parse tree are qualified
	f  s ml=$o($$$mtFromTableName(ml)) q:ml=""  d:$e($$$mtFromTableName(ml))=$c(1) DetermineQualifiedName(,,ml)	// DPV1324
	For  {	// DPV2060 - Eliminated call to chktv and made it in-line, use new metadata
		s ml=$o($$$mtFromTableName(ml)) q:ml=""  
		s name=$p(ml,"^",2),tname=name
		If $d($$$mtKAction("EXECUTE")) {
			n schema,proc
			s schema=$$$UPPER($$$AllButLastPiece(name,"."))
			s proc=$$$UPPER($tr($$$LastPiece(name,"."),$c(2),"."))
			If '$d($$$pPROC(schema,proc))) d error(428) QUIT  // schema/proc used in e428^%qaqperr
			s $$$mtR(9)=$g($$$mtR(9))_$lb($g($$$PROCschema($$$pPROC,schema,proc))_"."_$tr($g($$$PROCname($$$pPROC,schema,proc)),".",$c(2)))	// DPV2409=
		}
		Else {
			s objid=$$$smdLoadGetIrn(name,$g($$$mtTvf(+ml,name)))
			d:objid="" error(30)	// tname used in e30^%qaqperr
			s typ=$$$smdGetTType(name),$$$mtR(typ)=$g($$$mtR(typ))_$lb($$$smdGetIqnFromIrn(objid))
		}
	}
	QUIT
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; YCL261: Apply collation for null handling functions and CASE
	#; inherit the collation of the first not "coercable" output arg
	#; coercable means whether the collation of one expression can be coerced into the collation of the other
nulHandlingFuncCol(v) public {
	set op = $p(v,"^",2),colOrd=""
	if op="NVL" { ; NVL(ex1,ex2), ISNULL(ex1,ex2) and {fn IFNULL(ex1,ex2)} colOrd=ex1,ex2
		set colOrd=$lb($p(v,"^",4),$p(v,"^",5))	
	} elseif op="IFNULL" { ; IFNULL(ex1,ex2,[ex3]) colOrd=ex2,[ex3]
		set colOrd=$lb($p(v,"^",5))	
		set:$p(v,"^",6) colOrd=colOrd_$lb($p(v,"^",6))
	} elseif op="COALESCE" { ; COALESCE (ex1,ex2,...) colOrd=ex1,ex2,...
		for i=4:1 {
			quit:'$p(v,"^",i)
			set colOrd=colOrd_$lb($p(v,"^",i))
		}
	} else { ; CASE ... THEN ex1 ... THEN ex2 ... ELSE exn END colOrd=ex1,ex2,...,exn
		#; find all the output values
		for i=5:2 {
			quit:'$p(v,"^",i)
			set colOrd=colOrd_$lb($p(v,"^",i))
		}
		set colOrd=colOrd_$lb($p(v,"^",i-1))
	}
	set ptr=0
	while $LISTNEXT(colOrd,ptr,v) {
		set curCol=$$ddfun(v)
		RETURN:curCol'="*" curCol ; use the collation for the first not "coercable" output arg
		set:'$d(col) col=curCol    
	}
	RETURN col
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; YCL254 - rewrite NULL handling functions and CASE
nulHandlingFuncOpt() [mt] public {
	f log=1:1:$$$maxl{
		set v = $$$mtL(log)
		continue:$e(v,1,4)'="l^'^"
		set notConds($p(v,"^",4))=$g(notConds($p(v,"^",4)))_$lb(log)
	}
	f log=1:1 {
		quit:log>$$$maxl
		continue:$$$mtLType($$$mtL(log))'="v"
		#; we assume UDF/subq is expensive, we don't want to increase the number of 
		#; excution of UDF/subq
		continue:$$hasSubqUDF(log)
		#; YCL447 - Collect all the argument in this condition, if this argument is null handling function, collect all the arguments in this null handling function as well
		#; we should make sure there is at least one streamless expression
		#; since we want to rewrite NVL(?,f1)=f2 but don't want not rewrite NVL(f1, f2)=f3
		set v = $$$mtL(log)
		set foundStreamless=($p(v,"^",2)="IN")
		if $l(v,"^")=5 { ; only one argument, for example, NULL or 'NULL
			set foundStreamless=1
		} elseif $p(v,"^",2)="IN" { ; only rewrite NullHandlingFuntion IN (<all streamless exps>)
			set nhfVal= $p(v,"^",4)
			do getUncollVal(.nhfVal)
			continue:",NVL,COALESCE,IFNULL,CASE,"'[(","_$p($$$mtV(nhfVal),"^",2)_",") ; for IN, only optimize NullHandlingFun(f1,f2) IN (<all streamless exps>)
			for lgi=5:1 {
				set val=$p(v,"^",lgi)
				quit:val=""
				if '$$isStreamless^%qaqpre($$$mtV(val)) { ; all the elements should be streamless
					set foundStreamless=0
					quit
				}
			}
		} else {
			for lgi=4:1 {
				set val=$p(v,"^",lgi)
				quit:val=""
				quit:foundStreamless
				do getUncollVal(.val)
				if $$isStreamless^%qaqpre($$$mtV(val)) {
					set foundStreamless=1
					quit
				} elseif ",NVL,COALESCE,IFNULL,CASE,"[(","_$p($$$mtV(val),"^",2)_",") {
					set nhfV= $$$mtV(val)
					for vali=4:1 {
						set argVal=$p(nhfV,"^",vali)
						quit:argVal=""
						if $$isStreamless^%qaqpre($$$mtV(argVal)) { ; at least one of them are streamless
							set foundStreamless=1
							quit
						}
					}	
				}
			}
		}
		continue:'foundStreamless
		for lgi=4:1 {
			set v = $$$mtL(log)
			quit:$e(v)'="v"
			quit:$p(v,"^",lgi)=""
			set col="",val=$p(v,"^",lgi)
			continue:$$$mtVType($$$mtV(val))'="v"
			do getUncollVal(.val,.col)
			continue:",NVL,COALESCE,IFNULL,CASE,"'[(","_$p($$$mtV(val),"^",2)_",") ; continue if it is not a null handling function or CASE
			continue:$$isStreamless^%qaqpre($$$mtV(val)) ; YCL428 - Don't rewrite streamless null handling functions
			if ($e($$$mtV(val),1,6)="v^NVL^")||(($e($$$mtV(val),1,11)="v^COALESCE^")&&($l($$$mtV(val),"^")=6)){
				; {fn IFNULL(ex1,ex2)}, NVL(ex1,ex2), ISNULL(ex1,ex2), and COALESCE(ex1,ex2) with two arguments
				; ((ex1 is null) and (cond(ex2))) or ((ex1 is not null) and (cond(ex1)))
				; for some special operartor like < > '< '> = '=, we don't need to add (ex1 is not null) since this opt is before null analysis
				; null analysis will add the corresponding not null condition
				set nvlv=$$$mtV(val),op=$p(v,"^",2)
				set v1=$p(nvlv,"^",4),v2=$p(nvlv,"^",5)
				set v1Col = $s(col'="":$$coll(v1,col),1:v1)
				set v2Col = $s(col'="":$$coll(v2,col),1:v2)
				set $p(v,"^",3)="" ; clear $p(3), should be populated correctly in %qaqpnl
				
				if op="NULL" {
					; we only need ((ex1 is null) and (cond(ex2))) since ((ex1 is not null) and (cond(ex1))) is always false
					do addAndCond(log,"v^NULL^^"_v1Col_"^",$$$newlog($p(v,"^",1,lgi-1)_"^"_v2Col_"^"_$p(v,"^",lgi+1,*)))
					set lgi=3 ; reset lgi to check if v1 is a null handling function
					d logopt^%qaqpagg("nulHandlingFuncOpt",$lb(log)) 
					; we should not have notConds for this log, since in null^%qaqpop, we should flip the op
				} else {
					set ex1n=$$$newlog("v^NULL^^"_v1Col_"^")
					set condex2=$$$newlog($p(v,"^",1,lgi-1)_"^"_v2Col_"^"_$p(v,"^",lgi+1,*))
					set nl=$$$newlog("l^&^^"_ex1n_"^"_condex2_"^")
					if " < > '< '> = '= "[(" "_op_" ") {
						; ((ex1 is null) and (cond(ex2))) or (cond(ex1))
						set nnl=$$$newlog($p(v,"^",1,lgi-1)_"^"_v1Col_"^"_$p(v,"^",lgi+1,*))
						set $$$mtL(log)="l^!^^"_nl_"^"_nnl_"^"
						d logopt^%qaqpagg("nulHandlingFuncOpt",$lb(log)) 
						; we should not have notConds for this log, since in gotoperator^%qaqpslx, we should flip the op
					} else {
						; ((ex1 is null) and (cond(ex2))) or ((ex1 is not null) and (cond(ex1)))
						set ex1nn=$$$newlog("v^'NULL^^"_v1Col_"^")
						set condex1=$$$newlog($p(v,"^",1,lgi-1)_"^"_v1Col_"^"_$p(v,"^",lgi+1,*))
						set nnl=$$$newlog("l^&^^"_ex1nn_"^"_condex1_"^")
						set $$$mtL(log)="l^!^^"_nl_"^"_nnl_"^"
						d logopt^%qaqpagg("nulHandlingFuncOpt",$lb(log)) 
						if $d(notConds(log)) {
							; not condition should be rewrite as
							; ((ex1 is not null) or (not (cond(ex2)))) and ((ex1 is null) or (not (cond(ex1))))
							set ncondex1=$$$newlog("l^'^^"_condex1_"^")
							set ncondex2=$$$newlog("l^'^^"_condex2_"^")
							set nl=$$$newlog("l^!^^"_ex1n_"^"_ncondex1_"^")
							set ptr=0
							while $listnext(notConds(log),ptr,lg){
								do addAndCond(lg,"l^!^^"_ex1nn_"^"_ncondex2_"^",nl)
								d logopt^%qaqpagg("nulHandlingFuncOpt",$lb(lg)) 
							}
						}
					}
					
				}
				
			} elseif $e($$$mtV(val),1,9)="v^IFNULL^"{
				; IFNULL(ex1,ex2) and IFNULL(ex1,ex2,ex3)
				; ((ex1 is null) and (cond(ex2))) or ((ex1 is not null) and (cond(ex3/null)))
				; if we only have two arguments in IFNULL: IFNULL(ex1,ex2), for some special operartor like < > '< '> = '= 'NULL, 
				; we don't need to add ((ex1 is not null) and (cond(null))) since cond(null) is always false
				set ifnullv=$$$mtV(val),op=$p(v,"^",2)
				set v1=$p(ifnullv,"^",4),v2=$p(ifnullv,"^",5),v3=$p(ifnullv,"^",6)
				set v1Col = $s(col'="":$$coll(v1,col),1:v1)
				set v2Col = $s(col'="":$$coll(v2,col),1:v2)
				set $p(v,"^",3)="" ; clear $p(3), should be populated correctly in %qaqpnl
				
				if (v3="")&&(" < > '< '> = '= 'NULL "[(" "_op_" ")) {
					; if there are only 2 argument, and op=< > '< '> = '= 'NULL, nnl is always false
					;((ex1 is null) and (cond(ex2))) 
					do addAndCond(log,"v^NULL^^"_v1Col_"^",$$$newlog($p(v,"^",1,lgi-1)_"^"_v2Col_"^"_$p(v,"^",lgi+1,*)))
					set lgi=3 ; reset lgi to check if v1 is a null handling function
					d logopt^%qaqpagg("nulHandlingFuncOpt",$lb(log)) 
					; we should not have notConds for this log, since in gotoperator^%qaqpslx and null^%qaqpop, we should flip the op
				} elseif (v3="")&&(op="NULL") {
					; if there are only 2 argument, and op=NULL, we don't need to add cond(null) since it is always true
					set nl=$$$newlog("l^&^^"_$$$newlog("v^NULL^^"_v1Col_"^")_"^"_$$$newlog($p(v,"^",1,lgi-1)_"^"_v2Col_"^"_$p(v,"^",lgi+1,*))_"^")
					set nnl=$$$newlog("v^'NULL^^"_v1Col_"^")
					set $$$mtL(log)="l^!^^"_nl_"^"_nnl_"^"
					d logopt^%qaqpagg("nulHandlingFuncOpt",$lb(log)) 
					; we should not have notConds for this log, since in null^%qaqpop, we should flip the op
				} else {
					set:v3="" v3=$$$newval("t^",1)
					set v3Col = $s(col'="":$$coll(v3,col),1:v3)
					set ex1n=$$$newlog("v^NULL^^"_v1Col_"^")
					set ex1nn=$$$newlog("v^'NULL^^"_v1Col_"^")
					set condex2=$$$newlog($p(v,"^",1,lgi-1)_"^"_v2Col_"^"_$p(v,"^",lgi+1,*))
					set condex3=$$$newlog($p(v,"^",1,lgi-1)_"^"_v3Col_"^"_$p(v,"^",lgi+1,*))
					set nl=$$$newlog("l^&^^"_ex1n_"^"_condex2_"^")
					set nnl=$$$newlog("l^&^^"_ex1nn_"^"_condex3_"^")
					set $$$mtL(log)="l^!^^"_nl_"^"_nnl_"^"
					d logopt^%qaqpagg("nulHandlingFuncOpt",$lb(log)) 
					if $d(notConds(log)) {
						; not condition should be rewrite as
						; ((ex1 is not null) or (not (cond(ex2)))) and ((ex1 is null) or (not (cond(ex3/null))))
						set ncondex2=$$$newlog("l^'^^"_condex2_"^")
						set ncondex3=$$$newlog("l^'^^"_condex3_"^")
						set nl=$$$newlog("l^!^^"_ex1n_"^"_ncondex3_"^")
						set ptr=0
						while $listnext(notConds(log),ptr,lg){
							do addAndCond(lg,"l^!^^"_ex1nn_"^"_ncondex2_"^",nl)
							d logopt^%qaqpagg("nulHandlingFuncOpt",$lb(lg)) 
						}
					}
				}
			} elseif $e($$$mtV(val),1,7)="v^CASE^"{
				; NULLIF(ex1,ex2), which be writen as CASE WHEN ex1=ex2 THEN ex3 ELSE ex4 END, ex3 is null, ex4=ex1
				; CASE WHEN ex1=ex2 THEN ex3 ELSE ex4 END
				; CASE ex1 WHEN ex2 THEN ex3 ELSE ex4 END
				; ((ex1 = ex2) and (cond(ex3))) or (((ex1 != ex2) or (ex1 is null) or (ex2 is null)) and (cond(ex4)))
				; if ex3 is null, for some special operartor like < > '< '> = '= 'NULL, we don't need to add ((ex1 = ex2) and (cond(ex3))) since cond(null) is always false
				; if ex4 is null, for some special operartor like < > '< '> = '= 'NULL, we don't need to add (((ex1 != ex2) or (ex1 is null) or (ex2 is null)) and (cond(ex4))) since cond(null) is always false
				continue:$l($$$mtV(val),"^")'=7
				set casev=$$$mtV(val),op=$p(v,"^",2)
				set l2vv=$p(casev,"^",4)
				continue:$e($$$mtV(l2vv),1,6)'="l^L2V^"
				set l2vl=$p($$$mtV(l2vv),"^",4)
				continue:$e($$$mtL(l2vl),1,4)'="v^=^"
				set v1=$$$mtLOperand1($$$mtL(l2vl)),v2=$$$mtLOperand2($$$mtL(l2vl))
				set v3=$p(casev,"^",5),v3IsNull=($$$mtV(v3)="t^"),v4=$p(casev,"^",6),v4IsNull=($$$mtV(v4)="t^")
				set v4Col = $s(col'="":$$coll(v4,col),1:v4)
				set $p(v,"^",3)="" ; clear $p(3), should be populated correctly in %qaqpnl
				if (" < > '< '> = '= 'NULL "[(" "_op_" "))&&(v4IsNull) {
					; nel is always false, we only need el
					set v3Col = $s(col'="":$$coll(v3,col),1:v3)
					do addAndCond(log,"v^=^^"_v1_"^"_v2_"^",$$$newlog($p(v,"^",1,lgi-1)_"^"_v3Col_"^"_$p(v,"^",lgi+1,*)))
					set lgi=3 ; reset lgi to check if v1/v2 is a null handling function
					d logopt^%qaqpagg("nulHandlingFuncOpt",$lb(log)) 
					; we should not have notConds for this log, since in gotoperator^%qaqpslx and null^%qaqpop, we should flip the op
				} elseif (op="NULL")&&(v4IsNull) {
					; remove cond(ex4) since it's always true
					set l1 = $$$newlog("l^!^^"_$$$newlog("v^NULL^^"_v1_"^")_"^"_$$$newlog("v^NULL^^"_v2_"^")_"^")
					set nel = $$$newlog("l^!^^"_$$$newlog("v^'=^^"_v1_"^"_v2_"^")_"^"_l1_"^")
					set el=$$$newlog("l^&^^"_$$$newlog("v^=^^"_v1_"^"_v2_"^")_"^"_$$$newlog($p(v,"^",1,lgi-1)_"^"_v3Col_"^"_$p(v,"^",lgi+1,*))_"^")
					set $$$mtL(log)="l^!^^"_el_"^"_nel_"^"
					d logopt^%qaqpagg("nulHandlingFuncOpt",$lb(log)) 
					; we should not have notConds for this log, since in null^%qaqpop, we should flip the op
				}else {
					set l1 = $$$newlog("l^!^^"_$$$newlog("v^NULL^^"_v1_"^")_"^"_$$$newlog("v^NULL^^"_v2_"^")_"^")
					set l2 = $$$newlog("l^!^^"_$$$newlog("v^'=^^"_v1_"^"_v2_"^")_"^"_l1_"^")
					if (" < > '< '> = '= 'NULL "[(" "_op_" "))&&(v3IsNull){
						; el is always false, we only need nel
						do addAndCond(log,$p(v,"^",1,lgi-1)_"^"_v4Col_"^"_$p(v,"^",lgi+1,*),l2)
						set lgi=3 ; reset lgi to check if v4 is a null handling function
						d logopt^%qaqpagg("nulHandlingFuncOpt",$lb(log)) 
						; we should not have notConds for this log, since in gotoperator^%qaqpslx and null^%qaqpop, we should flip the op
					} else {
						set v3Col = $s(col'="":$$coll(v3,col),1:v3)
						set condex3=$$$newlog($p(v,"^",1,lgi-1)_"^"_v3Col_"^"_$p(v,"^",lgi+1,*))
						set condex4=$$$newlog($p(v,"^",1,lgi-1)_"^"_v4Col_"^"_$p(v,"^",lgi+1,*))
						set exeq=$$$newlog("v^=^^"_v1_"^"_v2_"^")
						set el=$$$newlog("l^&^^"_exeq_"^"_condex3_"^")
						set nel=$$$newlog("l^&^^"_l2_"^"_condex4_"^")
						set $$$mtL(log)="l^!^^"_el_"^"_nel_"^"
						d logopt^%qaqpagg("nulHandlingFuncOpt",$lb(log)) 
						if $d(notConds(log)) {
							; not condition should be rewrite as
							; (((ex1 != ex2) OR (ex1 is null) OR (ex2 is null)) OR (not (cond(ex3)))) AND ((ex1 = ex2) OR (not (cond(ex4))))
							set ncondex3=$$$newlog("l^'^^"_condex3_"^")
							set ncondex4=$$$newlog("l^'^^"_condex4_"^")
							set el=$$$newlog("l^!^^"_exeq_"^"_ncondex4_"^")
							set ptr=0
							while $listnext(notConds(log),ptr,lg){
								do addAndCond(lg,"l^!^^"_l2_"^"_ncondex3_"^",el)
								d logopt^%qaqpagg("nulHandlingFuncOpt",$lb(lg)) 
							}
						}
					}
				}
			}
		}
	}
	RETURN
}
collUnion() [mt] { ; Apply collation for UNION output YCL287
	RETURN:'$$$FastDistinct
	RETURN:'$d($$$mtUnionTopRoot)	
	f m=1:1:$$$mtPNumQbs {
		continue:'$$$mtPQbIsActive(m)
		continue:$g($$$mtUnionTopQb(m))'=m
		set unlev=$$unlev^%qaqpag(m,$d($$$mtAlphaUpAliases(m)))
		set ptr1=0
		while $LISTNEXT(unlev,ptr1,qList) {
			continue:$ll(qList)<2 // if there is only one query (for example, q1 union all q2), we don't need to do anything
			// qList is a list of query that UNION/DISTINCT together
			set ptr2=0
			kill o
			while $LISTNEXT(qList,ptr2,q) {
				for li=1:1:$ll($$$mtUnionLegVals(q)) {
					// li is the position in the output
					// (the 1st output, the 2nd output...)
					set o(li)=$get(o(li))_$li($$$mtUnionLegVals(q),li,li)
				}
			}
			for li=1:1{
				quit:'$d(o(li))
				// find and combine collation functions
				set ptr2=0
				set ddfun=$$getUnionOutputColFun($list(o(li)))
				continue:ddfun=-1
				for i=2:1:$ll(o(li)) {
					// i is the position of query in the qList 
					// (the 1st query in this UNION, the 2nd query in this UNION...)
					set ddfunTemp=$$getUnionOutputColFun($list(o(li),i))
					if ddfunTemp=-1 {
						set ddfun=""
						quit	
					}
					set ddfun=$s(ddfun_ddfunTemp="**":"*",1:$$fnfn(ddfun,ddfunTemp))
				}
				continue:"*"[ddfun // do not apply collation
				if $$$CompatibilityPreUnionCollation {
					set mt("compatibility","PreUnionCollation")=1
					RETURN
				}
				// apply collation function and output <uncollate>(<collate>(column))
				for i=1:1:$ll(o(li)) {
					set q=$list(qList,i)
					s x=$$$mtOutputVals($$$mtOutput(q))
					continue:+x=0  // no output required
					s val=$p(x,",",li)
					s $p(x,",",li)=$$xfrmunion(val,ddfun) 
					if val'=$p(x,",",li),$$$mtPViewIDVal($$$mtP(q))>0 
					{
						s $li($$$mtVirf($p($$$mtV($$$mtPViewIDVal($$$mtP(q))+li),"^",3)),2)=$p(x,",",li)
					} 
					s $$$mtOutputVals($$$mtOutput(q))=x
				}
			}
			// copy mt("o") back to mt("unflds")
			while $LISTNEXT(qList,ptr2,q) {
				s:+$$$mtOutputVals($$$mtOutput(q))'=0 $$$mtUnionLegVals(q)=$ListFromString($e($$$mtOutputVals($$$mtOutput(q)),1,*-1))
			}
		}
     
	}
	RETURN
}
getUnionOutputColFun(val)[mt] {
	set v=$$$mtV(val)
	// if user explicitly specify the collation, we don't want to apply collation
	// even the ddfun returned by fnfn same as this one, we will apply rmlsp for others but not this one.
	if ($e(v)="v" && (($$$ISENCODEDCOLLATE($p($p(v,"^",2),"(",1)))||($$$SQLCOLLATIONS[(","_$p($p(v,"^",2),"(",1)_","))))||
		($e(v)="f" && (($$$ISENCODEDCOLLATE($p($p($p(v,"^",3),"_",2),"(",1)))||($$$SQLCOLLATIONS[(","_$p($p($p(v,"^",3),"_",2),"(",1)_",")))) {
			RETURN -1
	} else {
			RETURN $$ddfun(val)
	}	
}
xfrmunion(val,fn)
		#; PVA076: propagate data type from underlying field.
	new fv,dt
	set dt=$$$VTRgetdt(val)
	set val=$$coll(val,fn)
		#; PVA309: support uncollate for %MINUS and %MVR
	if ",%ALPHAUP,%UPPER,%PLUS,%TRUNCATE,"[$p(fn,"(") { set $$$VTRdt(val)=dt RETURN val }
	if $$$ISENCODEDCOLLATE($p(fn,"("))  {
		new parm1
		do decodeCollate^%qaqcpre(fn,.parm1)
		if parm1["prepend-space" {
			set fv=$g(mt("unary",val,"%RMLSP")) 
			if 'fv { 
				Set val=$$$newval("v^%RMLSP^^"_val_"^",1) 
				set mt("unary",$p($$$mtV(val),"^",4),"%RMLSP")=val,$$$VTRdt(val)=dt 
			} else { set val=fv }
		}
		if parm1["mode=-" {
			set fv=$g(mt("unary",val,"%RMINUS")) 
			if 'fv { 
				Set val=$$$newval("v^%RMINUS^^"_val_"^",1) 
				set mt("unary",$p($$$mtV(val),"^",4),"%RMINUS")=val,$$$VTRdt(val)=dt 
			} else { set val=fv }
		}
	}
	elseif "%MVR"=$p(fn,"(") { set fv=$g(mt("unary",val,"%RMVR")) if 'fv { Set val=$$$newval("v^%RMVR^^"_val_"^",1) set mt("unary",$p($$$mtV(val),"^",4),"%RMVR")=val,$$$VTRdt(val)=dt } else { set val=fv }}
	elseif "%MINUS"=$p(fn,"(") { set fv=$g(mt("unary",val,"%RMINUS")) if 'fv { Set val=$$$newval("v^%RMINUS^^"_val_"^",1) set mt("unary",$p($$$mtV(val),"^",4),"%RMINUS")=val,$$$VTRdt(val)=dt } else { set val=fv }}
	else {
		new ifn,irn
		set ifn=$$$VTRgetifn(val),irn=$$$VTRgetirn(val)
		if irn,ifn,$$$smdColVALUELIST(1,irn,ifn)'="" {
				// %CON2VL is Convert to valuelist.  This will take the collated value and return the cooresponding VALUELIST value, which will be the correct case. (DPV6618)
			set fv=$g(mt("unary",val,"%CON2VL"))	// Instead of removing the leading space, convert to the VALUELIST value
			if 'fv { Set val=$$$newval("v^%CON2VL^^"_val_"^",1) set mt("unary",$p($$$mtV(val),"^",4),"%CON2VL")=val,$$$VTRdt(val)=dt } 
			else { set val=fv }
.
		} else {	// No VALUELIST, just remove the leading space
			set fv=$g(mt("unary",val,"%RMLSP"))
			if 'fv { Set val=$$$newval("v^%RMLSP^^"_val_"^",1) set mt("unary",$p($$$mtV(val),"^",4),"%RMLSP")=val,$$$VTRdt(val)=dt } 
			else { set val=fv }
		}
	}
	RETURN val
.
#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#; YCL302 - rewrite $$$mtL(log) to cond1 AND cond2
#; cond1Exp is the condition content of cond1
#; cond2Num is the condition log number
addAndCond(log,cond1Exp,cond2Num) [mt,m] public {
	new m ; YCL449: addlog needs public variable m
	f m=1:1:$$$mtPNumQbs          
	{   
		if ("^"_$g($$$mtWhere(m)))[("^"_log_"^") { ; add as TOP AND condition to WHERE
			set $$$mtL(log)=cond1Exp
			do addlog^%qaqpnl(cond2Num) 
			RETURN
		} elseif $d($$$mtOnRoot(m)) { ; add as TOP AND condition to ON
			set i=""
			for {
				set i=$o($$$mtOn(m,i),1,xa) 
				quit:i=""
				set logs=$li(xa,$$$SQLONPREDICATE)
				for lgi=1:1 {
					set tlog=$p(logs,"^",lgi)
					quit:tlog="" 
					continue:log'=tlog
					set $$$mtL(log)=cond1Exp 
					set $p(logs,"^",lgi)=log_"^"_cond2Num
					set $li($$$mtOn(m,i),$$$SQLONPREDICATE)=logs
					RETURN
				}	
			}
		}
	}
	set $$$mtL(log)="l^&^^"_$$$newlog(cond1Exp)_"^"_cond2Num_"^"	
	RETURN
}
findSubqUDF 
	QUIT:found
	If $e(v,1,22)="v^USERDEFINEDFUNCTION:" Set found = 1 QUIT
	If ev="q" Set found = 1 QUIT
	GOTO lvarg^%qaqpnl
hasSubqUDF(v) [ mt, found, call ] public {
	New call, found
	Set call = "findSubqUDF^%qaqpqo"
	Set found = 0
	Do lvtree^%qaqpnl("l", v)
	QUIT found
}
getUncollVal(&val,&col="") [mt] public {
	set op=$p($p($$$mtV(val),"^",2),"(",1)
	if (($$$SQLCOLLATIONS[(","_op_","))||($$$ISENCODEDCOLLATE(op))) {
			#; if collated, get the argument in $p(4)
			set col = $p($$$mtV(val),"^",2),val = $p($$$mtV(val),"^",4)
	}
	RETURN	
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; ---------- GENERAL UTILITIES ----------
default(x,d) [] PUBLIC { QUIT $s(x:x,1:d)  }  //  Default x to d if it is 0 or NULL
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
putstr(sname,irn)  ;  [public: lefts,newstr] used in link
	s lefts=str,str=$g($$$ptrel(sname)),newstr=str="" q:'newstr
	s str=$i(maxs),$$$ptrel(sname)=str,$$$mtR(str)=irn_"^"_m,$$$mtRNumStreams=str
    #; PVA139: add dependency doc.
    #; CRITICAL: Any change to mtc maintenance below must be mirrored in mrgstrview^%qaqpre2.
	#; AK656 
	i mcurs'="",$p(sname,"^")=1,sname'["->",$D($$$mtFromTableName(sname)),($$$mtStatementType="DEC")||(($g(mtc(mcurs,"f"))="")&&(sname=$g($$$mtTarget))) { // DPV3258 (sname'["->")
		// update mtc(mcurs,"f") if it is "" in the case for INS/UPD/DEL
		if ('$D(mtc(mcurs,"f"))||((" INS UPD DEL "[(" "_$$$mtStatementType_" "))&&($g(mtc(mcurs,"f"))="")))&&'$d($$$mtUnion(1))&&'$g($$$mtOneRow(1))&&'$g($$$mtGroupDistinctList(1))&&($g($$$mtOutput(1))'["d") {
			set mtc(mcurs,"f")=str_","_irn_","_$$$mtFromTableName(sname)
		} else {
			set mtc(mcurs,"f")=""
		}
	}
	#; ------ Stream statistics, add stream to join-set ------
	s mts(m,str)=$$ddstst(irn),ptj(m,1)=$g(ptj(m,1))_str_","
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
idToBars(val) [ mt ] public {
	Set str = $p(val,"^",2)
	Set ifn = $p(val,"^",3)
	Set irn = $$$smdGetIrnFromIfn(ifn)
	Set barifns = $$$smdBATOldRowIDPhysical(1,irn)
	If $l(barifns,",")=1 RETURN "f^"_str_"^"_barifns
	Set bars = ""
	For i=1:1 {
		Set bifn = $p(barifns,",",i) QUIT:bifn=""
		Set v = $$nufld(str,bifn)
		Set bars = bars_v_"^"
	}
	RETURN "v^%BARS^^"_bars
}
.
	// Check the types of the model's WITH columns against the type of the over-ridden WITH columns in PREDICT/PROBABILITY
	// mt("qml","valtypecheck",val)= <model-column type> (ODBC numeric type #)
	// We need to make sure this is compatabile with the val's actual type
MLTypeCheck() [mt] PUBLIC {
	set val=""
	for  {
		set val=$o($$$mtQuickMLValTypeCheck(val),1,modelcoltype)
		quit:val=""
		continue:$$$VTRgettype(val)="var" // if this WITH column is a HVar, assume the user entered the correct value type.  If the provider cannot handle the type mismatch/conversion, let the provider report the error.
		set valdt=$$$comClassKeyGet($$$VTRgetdt(val),$$$cCLASSodbctype)	// valdt is now ODBC type name
		set valdt=$$GetODBCTypeNumber^%ourODBC(valdt)			// valdt is now ODBC type number
		if modelcoltype=12
		if $case(modelcoltype,$$$ODBCTYPEchar:1,$$$ODBCTYPEvarchar:1,:0),$case(valdt,$$$ODBCTYPEchar:0,$$$ODBCTYPEvarchar:0,:1) { goto typeerr }
		elseif $case(modelcoltype,$$$ODBCTYPEnumeric:1,$$$ODBCTYPEdecimal:1,:0),$case(valdt,$$$ODBCTYPEnumeric:0,$$$ODBCTYPEdecimal:0,:1) { goto typeerr }
		elseif $case(modelcoltype,$$$ODBCTYPEdouble:1,$$$ODBCTYPEfloat:1,:0),$case(valdt,$$$ODBCTYPEdouble:0,$$$ODBCTYPEfloat:0,:1) { goto typeerr }
		elseif modelcoltype=$$$ODBCTYPEbigint,$case(valdt,$$$ODBCTYPEbigint:0,$$$ODBCTYPEinteger:0,$$$ODBCTYPEsmallint:0,$$$ODBCTYPEtinyint:0,:1) { goto typeerr }
		elseif modelcoltype=$$$ODBCTYPEinteger,$case(valdt,$$$ODBCTYPEinteger:0,$$$ODBCTYPEsmallint:0,$$$ODBCTYPEtinyint:0,:1) { goto typeerr }
		elseif modelcoltype=$$$ODBCTYPEsmallint,$case(valdt,$$$ODBCTYPEsmallint:0,$$$ODBCTYPEtinyint:0,:1) { goto typeerr }
		elseif modelcoltype=$$$ODBCTYPEtinyint,$case(valdt,$$$ODBCTYPEtinyint:0,:1) { goto typeerr }
		elseif modelcoltype=$$$ODBCTYPEdate,$case(valdt,$$$ODBCTYPEdate:0,:1) { goto typeerr }
		elseif modelcoltype=$$$ODBCTYPEtime,$case(valdt,$$$ODBCTYPEtime:0,:1) { goto typeerr }
		elseif modelcoltype=$$$ODBCTYPEtimestamp,$case(valdt,$$$ODBCTYPEtimestamp:0,:1) { goto typeerr }
		elseif modelcoltype=$$$ODBCTYPEposixtime,$case(valdt,$$$ODBCTYPEposixtime:0,:1) { goto typeerr }
		elseif $case(modelcoltype,$$$ODBCTYPEbinary:1,$$$ODBCTYPEvarbinary:1,:0),$case(valdt,$$$ODBCTYPEbinary:0,$$$ODBCTYPEvarbinary:0,:1) { goto typeerr }
		elseif modelcoltype=$$$ODBCTYPEbit,$case(valdt,$$$ODBCTYPEbit:0,:1) { goto typeerr }
	}
	RETURN
typeerr	;
	new %modelcolumntype,%withcolumntype
	do GetODBCTypeInfo^%ourODBC(modelcoltype,.%modelcolumntype)
	do GetODBCTypeInfo^%ourODBC(valdt,.%withcolumntype)
	do error^%qaqperr(193)
	RETURN
}
fakeVDFIfn() [maxm,mt,ptv,mts,m,str] public { ; create fake computed field for vector distance function (vdf) in ORDER BY
	RETURN:($zu(115,2)'=0)&&($$$mtKNoLockFlag($g($$$mtK))'=1) ; if we are not using default READ UNCOMMITTED isolation level and the query does not have %NOLOCK keyword, quit. Since this index get static data
	RETURN:'$d($$$mtSequencers) // if there is no order by at all
	new m,str
	for m=1:1:maxm{ 
		continue:$s(m=1:('$d($$$mtSequencersQb(m)))&&('$d($$$mtSequencers)),1:'$d($$$mtSequencersQb(m)))
		continue:'$d($$$mtTopArg(m))
		set ord=$s(m=1:$g($$$mtSequencers),1:$$$mtSequencersQb(m))
		set:m=1 checkBoth=0 // check both $$$mtSequencers and $$$mtSequencersQb(1)
		set foundOrderIdDesc=0
loop	for i=1:1:$l(ord,",")-1 {
			// should not have order by id desc
			set val=$p(ord,",",i)
			continue:$isvalidnum(val)
			set val=+val
			// check if it's id
			continue:$$$mtVType($$$mtV(val))'="f" 
			set ifn=$p($$$mtV(val),"^",3)
			set idifn=$p($g(mts(m,$p($$$mtV(val),"^",2))),"^",5)
			continue:ifn'=idifn
			// we indeed find ORDER BY ID desc
			set foundOrderIdDesc=1
			quit
		}
		continue:foundOrderIdDesc
		for i=1:1:$l(ord,",")-1 {
			set val=$p(ord,",",i)
			set desc=0
			if '$isvalidnum(val) {
				set desc=1
				set val=+val
			}
			// check for v^<DISTANCE FUNCTION>^
			continue:$$$mtVType($$$mtV(val))'="v"
			if $p($$$mtV(val),"^",2)="VECTOR_L2" {
				continue:desc //VECTOR_L2(maybe?) support order by ASCE
			} elseif $lf($lb("VECTOR_DOT_PRODUCT","VECTOR_COSINE"),$p($$$mtV(val),"^",2)) {
				continue:'desc //VECTOR_COSINE and VECTOR_DOT_PRODUCT support order by DESC
			} else {
				continue
			}
			//switch $p(4) and $p(5) if $p(4) is not f
			set:$e($$$mtV($p($$$mtV(val),"^",4)))'="f" $$$mtV(val)=$p($$$mtV(val),"^",1,3)_"^"_$p($$$mtV(val),"^",5)_"^"_$p($$$mtV(val),"^",4)_"^"
			continue:$e($$$mtV($p($$$mtV(val),"^",4)))'="f" // should be a field
			set pval=$p($$$mtV(val),"^",5)
			set pv=$$$mtV(pval)
			continue:'(("tx"[$e(pv))||(($e(pv)="v")&&($$isStreamless^%qaqpre(pv))))
			set v=$$$mtV(val)
			set fv=$$$mtV($p($$$mtV(val),"^",4))
			set str=$p(fv,"^",2)
			set fifn=+$p(fv,"^",3)
			set irn=$$$smdGetIrnFromIfn(fifn)
			continue:irn="" // continue for virtual field, if it's virtual field, 
							//we need to add this field in the output of the correponding query, 
							// and since that value in the output, we cannot use this index
			// collect %IGNOREINDEX
			set maplist = $$hint^%qaqpre("%IGNOREINDEX",m)
			set ignoreMaps = ","_$zcvt($$getQualifiedNames^%qaqpqo1(maplist,irn),"U")_","
			// search for ANN index
			set mname="",imps=""
			for  {
				s mname=$o($$$smd(1,irn,"map",mname)) 
				q:mname="" 
				s imp=$o($$$smd(1,irn,"map",mname,"")) 
				set indexType=$$$smdMapIndexType(imp)
				set iqn=$$$smdGetIqnFromIrn(irn)
				continue:'$$$IsVectorSearchIndex(imp) // not vector search index 
				continue:'$SYSTEM.SQL.Util.GetMapSelectability(iqn,$$$smdMapName(imp)) // not selectable
				// check %IGNOREINDEX
				continue:ignoreMaps[(","_$zcvt($$schemaDotTable^%qaqpqo1(irn)_"."_$$$smdMapName(imp),"U")_",")
				continue:ignoreMaps[(","_$zcvt($$schemaDotTable^%qaqpqo1(irn),"U")_".*,")
				continue:'$$$CheckVectorSearchIndexOp(indexType,$p($$$mtV(val),"^",2))
				set indexField=$lg($$$smdMapIndexFields(imp)) // get field name for this vector search index
                continue:indexField=""
                continue:$$$smdGetIfn($$$smdTType(irn),irn,indexField)'=$p(fv,"^",3) // index not for this field
				continue:$d(maps(imp))  // this index has been used, since should not have 1 map for 2 fake field
				set maps(imp)=""	
				set imps=imps_imp_","
			}
			continue:imps="" // no vector index found for this order by VECTOR distance function
			set vdfVal=val
			set ifn=$$AddFakeCompField^%qTable(irn,$lb("vdf"),fifn,"NUMROWS")
			set $li($$$smd(1,irn,2,ifn),4)="%Library.Double" //update smdColDatatype
			set $li($$$smd(1,irn,2,ifn),7)=20 //update smdColMaxLength
			set $li($$$smd(1,irn,2,ifn),10)="DOUBLE" //update smdColxDBCType
			set $li($$$smd(1,irn,2,ifn),35)="DOUBLE" //update smdColCategory
			set val=$$nufld(str,ifn)
			set $p(ptv(val),"^",$$$PTVMAPS)=$p(ptv(val),"^",$$$PTVMAPS)_imps
			// mark id accessible from these imps
			set idifn=$p($g(mts(m,str)),"^",5)
			set idval=$$nufld(str,idifn)
			set:$d(ptv(idval)) $p(ptv(idval),"^",$$$PTVMAPS)=$p(ptv(idval),"^",$$$PTVMAPS)_imps
			set $p(ord,",",i)=val_$s(desc:"d",1:"")
			set $$$mtVecDistFunc(val)=vdfVal
			if (","_$$$mtOutputVals($$$mtOutput(m)))[(","_vdfVal_",") {
				// if this vdfval is in the select list, we can replace it with the fake field val
				// SELECT id,people,vec1,VECTOR_DOT_PRODUCT(vec1,to_vector('[63,64,67]',int)) FROM SQLUser.vtable ORDER BY 4
				set pOutput=(","_$$$mtOutputVals($$$mtOutput(m)))
				set pOutput=$replace(pOutput,(","_vdfVal_","),(","_val_","))
				set $$$mtOutputVals($$$mtOutput(m))=$e(pOutput,2,*)
			}
		}
		if m=1,checkBoth=0 {
			set:ord'="" $$$mtSequencers=ord
			set ord=$g($$$mtSequencersQb(m)),checkBoth=1 goto loop
		} else {
			set:ord'="" $$$mtSequencersQb(m)=ord
		}
	}
	RETURN
}
.
.
