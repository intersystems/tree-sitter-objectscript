====
qaqpjson
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpjson^MAC^^^0
%qaqpjson	// machine readable plan for SQL queries 
	;; COMPONENTS :: SQL/RunTime
	#;
#INCLUDE %msql
#INCLUDE %sqlEngineObjs
#INCLUDE %SYS.PTools.Stats
#IF 0   ;-------------------------------------------------------------
		; Description: generate a machine readable plan from asl
		; Date Started: March 25, 2021
#ENDIF  ;-------------------------------------------------------------
	$$$Abort  ; Not an Entry Point
jsonplan() [asl,mt,mts,modun,parallelquery,sqlOrig,sql,cost,temptables,tftab,litabs,showstats,seldict,RTPCisON] PUBLIC{; generate plan for the whole query using asl and other structures like mt and mts and $$$smd
	Set planinfo={},qbtab=[],showstats=1
	Set DML=((",INS,UPD,DEL,")[(","_$Get($$$mtStatementType)_","))&&('$o($$$aslMod(""),-1))
	Set planinfo.text=$$sqltext()
	Set options={}
	If ($o(mt("options",""))'=""){
		Set opt=$o(mt("options",""))
		For{	
			Set nextopt=$o(mt("options",opt))
			If opt="DynamicSQLTypeList"{
				s param=[]
				For i=1:1:$Length(mt("options",opt),","){
					Set par={},type=$Piece(mt("options",opt),",",i)
					Set type=$Case(type,1:"String of length 1 to 32 (inclusive)",
					2:"String of length 33 to 128 (inclusive)",
					3:"String of length 129 to 512 (inclusive)",
					4:"String of length > 512",
					10:"Integer",
					11:"Numeric",:"")
					Set par.name="%parm("_i_")" Set:(type'="") par.type=type
					Do param.%Push(par)}
				Set options.parameters=param
			} Else {
				If (opt="rtpc-log-sel")||(opt="rtpc-truth-value")||(opt="rtpc-range")||(opt="rtpc-list")||(opt="rtpc-vdf") {
					Set key="",val=[]
					For {
						Set key = $O(mt("options",opt,key),1,v)
						QUIT:key=""
						Set pair = {}
						if opt="rtpc-vdf" {
							set key1 = "queryBlock"
							set key2 = "orderPosition"
							set key3 = "selectPosition"
							set key4 = "expressionHash"
							set key5 = "equivalence"
							Do pair.%Set(key1, $p(v, "^", 1))
							Do pair.%Set(key2, $p(v, "^", 2))
							Do pair.%Set(key3, $p(v, "^", 3))
							Do pair.%Set(key4, $p(v, "^", 4))
							Do pair.%Set(key5, $p(v, "^", 5))
						} else {
							set key1 = $select(opt="rtpc-truth-value": "conditionHash", 1:"logNumber")
							set key2 = $select(opt="rtpc-truth-value": "truthValue", 1:"selectivity")
							Do pair.%Set(key1, $p(v, "^", 1))
							Do pair.%Set(key2, $p(v, "^", 2))
						}
						
						Do val.%Set(key, pair)
					}
				} Else {
					Set val=mt("options",opt)
				}
				Do options.%Set(opt,val)
			}
			Set opt=nextopt
			QUIT:(opt="")
		}	
	}
	Set tftab=[]
	For m=1:1:$Length($Get($$$mtPActiveQbs)) {
		CONTINUE:DML
		CONTINUE:'$$$mtPQbIsActive(m) ; skip merged subqueries
		CONTINUE:$$$mtPVirtStreamModule($$$mtP(m))  ; skip virtual streams
		CONTINUE:$Get($$$mtUnionTopQb(m),m)'=m  ;  skip union legs that are already processed
		Set qbid="qb"_m,mm=m
		If $Data($$$mtUnionTopQb(m)){
			For{
				Set mm=$Order($$$mtUnionTopQb(mm))
				QUIT:(mm="")
				If $$$mtUnionTopQb(mm)=m
				Set qbid=qbid_"qb"_mm
			}	
		}
		Set qbobj={},qbobj.id=qbid,qbobj.plan=$$module($Select($Piece($$$mtP(m),"^",5)=$$$topWorkerModule(m):$$$topParentModule(m),1:$Piece($$$mtP(m),"^",5)),m)
		Do qbtab.%Push(qbobj)
	}
	If DML{
		Set DMLtype=$Select($$$mtStatementType="INS":"insert",$$$mtStatementType="UPD":"update",$$$mtStatementType="DEL":"delete",1:$$$mtStatementType)
		Set qbobj={},stp={},stpobj={},qbobj.id="qb1"
		Set stpobj.table=$list($$$mtFromList(1),1)
		Do stp.%Set(DMLtype,stpobj)
		Set qbobj.plan=stp
		Do qbtab.%Push(qbobj)
	}
	Set planinfo.RTPC=$Select(RTPCisON:"ON",1:"OFF")
	Set:($Data(mt("frozen"))||$g(%frozenplan)) planinfo.frozen="yes"
	Do planinfo.%Set("query blocks",qbtab)
	If $$cost(cost).%Size(),'DML Set planinfo.cost=$$cost(cost)
	Set:(options.%Size()) planinfo.options=options
	If litabs.%Size(){
		Set orderedlitabs=litabs
		For i=1:1:litabs.%Size(){
			Set tab=litabs.%Get(i-1)
			Set tab.fields=$$sorttabfields(tab.fields)
		}
		Set planinfo.tables=litabs
	}
	Do:(tftab.%Size()) planinfo.%Set("temp-files",tftab)
	If $g(mt("shardquery")){
		Do planinfo.%Set("shard query","1")
	}
	QUIT planinfo
}
cost(cost) PUBLIC {		
	Set costobj={},total=$Piece(cost,","),cd=$Piece(cost,",",2),cgg=$Piece(cost,",",3),cgs=$Piece(cost,",",4)
	QUIT:(cost="") {} 
	Set costobj.total=total
	Do costobj.%Set("block reads",cd),costobj.%Set("global reads",cgg),	costobj.%Set("global writes",cgs)
	QUIT costobj
}
tf() [mt] PUBLIC {
	Set tftab=[]
	QUIT:'$d($$$mtLatestTempFileNum) tftab
	Set tfn=""
	For{
		Set tfn=$Order($$$mtTempFile(tfn),1,tfinfo)
		QUIT:tfn=""
		Set tfobj={},tfobj.id="TF"_tfn //,tfobj.type=$Select($Piece(tfinfo,"^",16)=1:"bitmap distinct",$Piece(tfinfo,"^",1)="dist":"hybrid",1:"regular")
		Do tftab.%Push(tfobj)	
	}
	QUIT tftab
}	
module(mod,m) [asl,mts,mt,modun,parallelquery,temptables,tftab,litabs,showstats,tfn,seldict] PUBLIC { ;return dynamic array of objects, each object represents a step
	QUIT:$Extract(modun,mod)  s $Extract(modun,mod)=1  //  process shared module only once
	Do sharespecs(mod,.ss)
	Set:$Data($$$asl0ViewNestingInfo(mod)) m=$$$asl0ViewNestingInfo(mod)
	Set modtab=[]
	If $Data($$$asl5Root(mod)){ ; module with an endmodtag postkey
		Set modtab=$$concatarray(modtab,$$pkey(mod,3,1,m)),modtab=$$concatarray(modtab,$$action(mod,.ss,m))
		QUIT modtab
	}
	Set modtab=$$concatarray(modtab,$$pkey(mod,1,0,m)) ; process prekey (funk=1)
	Set parq = $Get($$$aslKParQueriesInfo(mod,2,1))
	If parq{
		Do modtab.%Push($$parq(mod,m,parq))
	}Elseif $Data($$$aslKRoot(mod)){
		If ($Get($$$aslKRoot(mod))="bsl") {Set lobj=$$bsl(mod,m)}
		Elseif ($Get($$$aslKRoot(mod))="dsn") {Set lobj=$$dsn(mod,m)}
		Else{
			Set lobj=$$loop(mod,m),newqb=lobj.%Get("m")
			If (newqb'="") Do lobj.%Remove("m") Set m=newqb
		}
		Set body=[],body=$$concatarray(body,$$pkey(mod,3,0,m)),body=$$concatarray(body,$$action(mod,.ss,m))
		/* Set ojnullpadding=lobj.%Get("nullpadding")
		If (ojnullpadding){ ;ii needs testing
			Set ojobj={} Do ojobj.%Set("outer join null padding","") Do lobj.%Remove("nullpadding"),body.%Push(ojobj)} */
		Set lobj.body=body
		Do modtab.%Push(lobj)
		QUIT modtab
	}
	Set modtab=$$concatarray(modtab,$$pkey(mod,3,0,m)),modtab=$$concatarray(modtab,$$action(mod,.ss,m))
	QUIT modtab
}
loop(mod,m)[asl,mt,mts,modun,parallelquery,temptables,tftab,litabs,showstats,tfn,seldict] PUBLIC { ; return object with type "loop"
	Set obj={},knext=""
	; No need to loop on knext in asl(mod,2,knext) because the only case it has more than 1 value is bsl, which is already treated
	Set knext=$Order($$$aslK(mod,knext))
	QUIT:(knext="")	
	Set info=$$$aslKId(mod,knext)
	Set structure=$$$aslIdKeyAccessType(info)
	Set smdimp=$$$aslIdMapId(info)
	Set tfid=$$$aslIdTfBuildLoc(info)
	Set str=$$$aslIdStrNum(info)
	Set qb=$$$aslIdQb(info)
	Set:(qb'="") m=qb
	If smdimp {
		Set map=$$map(smdimp,info),obj.structure=map
		Set alias=$$alias(qb,str)
		If +$g($$$FTFakeStream(str)), $d($$$FTFakeStreamQuery(str), query) {
			Do obj.%Set("foreign table query", query)
		}
		Set:(alias'="")&&($Find(alias,",")=0) obj.alias=alias
	}Elseif($$$aslIdTfType(info)="bmvar"){
		Set obj.structure="bitmap chunk"
		Goto simpleloop 
	}Elseif tfid{
		Set obj.structure="temp-file"
		Set obj.id=$$tfn($Piece(tfid,"^"),$Piece(tfid,"^",2))
	}Elseif  structure="set"{ Set obj.structure="set" Goto simpleloop
	}Elseif  structure="ntimes"{ Set obj.structure="ntimes" Goto simpleloop
	}Elseif  structure="single"{ Set obj.structure="single" Goto simpleloop
	}
	Set subsar=[]
	If info["vectorjoin" {  ;  vector join vj.Probe(), vj.Join  ;  AK1064
		Set binfo=$$$aslAct(+$$$aslIdTfBuildLoc(info),$p($$$aslIdTfBuildLoc(info),"^",2))
		Set sub={}
		Set k=$$jkeys^%qaqpmod(+$$$aslActLeftTableKeysVec(binfo)),ktab=[]
		For i=1:1:$Length(k,",")-1{ d ktab.%Push($$val($Piece(k,",",i)))}
		Do sub.%Set("given vectors",$$sortfields(ktab))
		Do subsar.%Push(sub)
		Set sub={}
		Do sub.%Set("join result vector chunks",$CASE($$$aslActVecJoin(binfo),"vj1":"outer","vj2":"full outer",:"inner"))
		Do subsar.%Push(sub) Set obj.subscripts=subsar
	}Else{
		Set nnext=""
		For {
			Set sub={},wsub={}
			Set nnext=$Order($$$aslKNext(mod,knext,nnext))
			QUIT:(nnext="")
			Set info=$$$aslKNext(mod,knext,nnext),subval=$$$aslNextSubscriptVal(info)	
			If $$$aslNextLoopingType(info)'="c"{
				If nnext=1,$Data(mt("filterm",+$$$aslNextLoopingType(info))){
					Do sub.%Set("filter computed field",""),subsar.%Push(sub)
					CONTINUE
				} 
				Set valobj=$$val(subval)
				Set iter=valobj.%GetIterator()
				Set key="",nempty=iter.%GetNext(.key,.value)
				If key="field" Set sub.id=value
			}
			Else {
				Set sub.constant=""
				Do subsar.%Push(sub)
				CONTINUE
			} 
			Set p2=$$$aslNextLoopingType(info),p3=$$$aslNextLoopingLowLimOrSetVar(info),p4=$$$aslNextLoopingLowLimExcl(info),p5=$$$aslNextLoopingUpLim(info),p6=$$$aslNextLoopingUpLimExcl(info)
			If p2'=""{
				Set looptype=$Case(p2,"c":"constant","u":"unique","a":"ascending","d":"descending","y":"ascending","y-":"descending","h":"ascending","h-":"descending",:"")
				Do:(looptype'="") sub.%Set("loop_type",looptype)
				If p2="u",+p3{ Do sub.%Set("given value",$$val($$$aslNextSubscriptVal(info)))}
			}
			Set ll=$Case(p4,0:"exclusive",1:"inclusive",2:"%startswith",:"")
			If ll'=""{
				Set llim={}
				Set:(+p3) subval=$$val(p3)
				Do llim.%Set(ll,subval)
				Do sub.%Set("lower limit",llim)
			}
			Set ul=$Case(p4,0:"exclusive",1:"inclusive",:"")
			If ul'=""{
				Set ulim={}
				Set:(+p5) subval=$$val(p5)
				Do ulim.%Set(ul,subval)
				Do sub.%Set("upper limit",ulim)			
			}
			If $Data($$$aslNextBslTopFilt(mod,2,1,nnext),optInfo) { ;ii needs testing
				Do sub.%Set("bitslice top rows",$$map($List(optInfo,4))) ;ii can add more info from optInfo
			}
			For jj=1:1 { ;ii needs testing
				Set bsrmaps=[]
				If $Data($$$aslNextBslRangeFilt(mod,2,1,nnext,jj),optInfo) {
					Do bsrmaps.%Push($$map($List(optInfo,3))) ;ii add more info from optInfo?
				}
				else {
					QUIT
				}
				Do:(bsrmaps.%Size()) sub.%Set("bitslice range filter",bsrmaps)
			}
			Set cond=[]
			/* future change: extract more condition info from MTS
			If $Piece(info,$c(1),4)="2"{ ; %STARTSWITH condition
				If $Get(qb),$Get(str),$Data(mts(qb,str,"RANGE",$Piece($$$mtV(subval),"^",3))) {
					Set rangelog=$Piece(mts(+qb,+str,"RANGE",$Piece($$$mtV(subval),"^",3)),"^",2)
					Do cond.%Push($$log($Piece(rangelog,",",2)))}}
			If $Piece(info,$c(1),2)="u"{ ; given unique value
				If $Get(qb),$Get(str),$Data(mts(qb,str,"CON",$Piece($$$mtV(subval),"^",3))) {
					Set uniquelog=$Piece(mts(+qb,+str,"CON",$Piece($$$mtV(subval),"^",3)),"^",2)
					Do cond.%Push($$log($Piece(uniquelog,",",2)))
				}
			}*/
			Set otherconds=$$$aslNextAdditionalCondsOnSubscript(info)
			If otherconds{
				For i=1:1:$Length(otherconds,",")-1{
					Set log=$Piece(otherconds,",",i) CONTINUE:(log="")
					Do:($Get($$$mtL(log))'="") cond.%Push($$log(log))}	}
			Set:(cond.%Size()) sub.conditions=cond
			Do:nempty wsub.%Set(key,sub)
			Do subsar.%Push(wsub)
		}
		Set obj.subscripts=subsar
		Set finfo=$Get($$$aslKFlds(mod,knext)),ftab=[],ftab2=[]
		For i=1:1:$Length(finfo,",")-1{
			Set fldobj=$$val($Piece(finfo,",",i))
			Do ftab.%Push($$val($Piece(finfo,",",i)))
		}
		Set ftab=$$sortfields(ftab)
		For j=1:1:ftab.%Size(){
			Set ftabj=ftab.%Get(j-1)
			Do:ftabj.field'="" ftab2.%Push(ftabj.field)
		}
		Do:(ftab2.%Size()) obj.%Set("data",ftab2)
	}
simpleloop
	Set lobj={},lobj.loop=obj
	Set:(qb'="") lobj.m=qb
	Do:($$$aslIdPaddingOjLogic(info)="p") lobj.%Set("null padding","") ; outer join null padding
	QUIT lobj
}
parq(mod,m,parq)[asl,mt,mts,modun,parallelquery,temptables,tftab,litabs,showstats,tfn,seldict] PUBLIC {
	If $$$useAPE(m){
		Set info=$$$aslKId(mod,1)
		Set smdimp=$$$aslIdMapId(info)
		Set maptype=$$mapType^%qaqpagg(smdimp)
		Set chunktype=$case(maptype,$$$EXTENTBITMAP:"bitmap chunks",$$$COLUMNARDATA:"vector chunks",$$$COLUMNARINDEX:"vector chunks",$$$MASTERMAP:"id",:"subscript values")
		Set topworkermod = $$$topWorkerModule(m)
		Set obj={}
		Set obj.map=$$map(smdimp,info)
		Do obj.%Set("partition on",chunktype),obj.%Set("temp-file",$$tfn(mod+1,-1)),obj.%Set("worker plan",$$module(topworkermod,m))
		Set lobj={} Do lobj.%Set("parallel worker",obj)
	}Else{
		Set parallelquery($Increment(parallelquery)) = $$getparallelquery^%qaqplan(parq) Merge mt("parallelquery")=parallelquery
		Set obj={}
		Set set = $g(mt("sql",m,"set"))
		Set info=$$$aslKId(mod,1)
		Set smdimp=$$$aslIdMapId(info)
		Set map=$$map(smdimp,info)
		Set obj.map=map
		Set set = $g(mt("sql",m,"set"))
		If set'=""{
			Set obj.set=$Get($$$mtSqlPartitionFunc(m))
		}Else{
			Set obj.subranges=$Get($$$mtSqlPartitionFunc(m))
		}
		Do obj.%Set("temp-file",$$tfn(mod+1,-1))
		Set subobj={}
		Set:($Get($$$mtSql(m))'="") subobj.sql=$Get($$$mtSql(m))
		Set:($Get($$$mtSqlSelect(m))'="") subobj.select=$Get($$$mtSqlSelect(m))
		Set:($Get($$$mtSqlFrom(m))'="") subobj.from=$Get($$$mtSqlFrom(m))
		Set:($Get($$$mtSqlWhere(m))'="") subobj.where=$Get($$$mtSqlWhere(m))
		Set:((set'="")&&($Get($$$mtSqlPartitionFunc(m))'="")) subobj.set=$Get($$$mtSqlPartitionFunc(m))
		Do:($Get($$$mtSqlGroup(m))'="") subobj.%Set("group by",$Get($$$mtSqlGroup(m)))
		Do:($Get($$$mtSqlOrd(m))'="") subobj.%Set("order by",$Get($$$mtSqlOrd(m)))
		Do obj.%Set("subquery",subobj)
		Set lobj={},lobj.parallel=obj
	}
	QUIT lobj
}
pkey(mod,funk,skipemt=0,m)[asl,mt,mts,modun,parallelquery,temptables,tftab,litabs,showstats,tfn,seldict] PUBLIC { ; return dynamic array with the prekey/postkey steps (funk=1 or 3)
	Set ndata="",ar=[]
	For	{
		Set obj={},wobj={},ndata=$Order($$$aslPk(mod,funk,ndata))
		QUIT:'ndata
		Set item=$Order($$$aslGenericNode(mod,funk,ndata,""))
		CONTINUE:(item="verify")
		Set:item="fields" item=$Order($$$aslGenericNode(mod,funk,ndata,item))
		Set:item="id" info=$$$aslGenericNode(mod,funk,ndata,item) ; , qb=$p(info,$c(1),7)
		Set:item="quq" info=$$$aslGenericNode(mod,funk,ndata,item)
		If skipemt {
			Set:item="endmodtag" skipemt=0
			CONTINUE}
		Set pkydata=$$$aslGenericNode(mod,funk,ndata,item)
		If item="copy"{
			Set coptype=$Piece(pkydata,"^",1),from="source",to="destination"
			If coptype=9{
				Set qbobj={},qbobj.subquery="qb"_$Piece(pkydata,"^",2),toobj={}
				Do toobj.%Set("union table","")
				Set from=qbobj,to=toobj
			}
			// Elseif coptype=4,coptype=1{
			Elseif $Length(pkydata,"^")=3{
				Set from=$$val($Piece(pkydata,"^",2)),to=$$val($Piece(pkydata,"^",3))}
			Set obj.from=from,obj.to=to
			Set wobj.copy=obj
			Do ar.%Push(wobj)
		}Elseif item="dist"{
			Set colvals=$Piece(pkydata,$c(1),1),colar=[]
			For i=1:1:$l(colvals,",")-1{
				Set val=$Piece(colvals,",",i) CONTINUE:(val="")
				If $Get($$$mtV(val))'=""{ Set col=$$val(val) Do colar.%Push(col)}}
			Set obj.columns=colar
			Do obj.%Set("temp-file","TF"_$Piece(pkydata,$c(1),2))
			Set wobj={},wobj.distinct=obj
			Do ar.%Push(wobj)
		}Elseif item="temp",($Piece(pkydata,$c(1),4)=""){
			Set nmod=$Piece(pkydata,$c(1))
			Set nesmod=$$module(nmod,m) ; nesmod is an array
			Set tfid="",modobj={}
			Set tfid=$$findtf(+pkydata)
			Do:(tfid.%Size()=1) modobj.%Set("temp-file",tfid.%Get(0))
			Do:(tfid.%Size()>1) modobj.%Set("temp-file",tfid)
			Set modobj.plan=nesmod
			If ($Piece(pkydata,$c(1),2)=1){ Set obj.once=modobj
			}Else{ Set obj.module=modobj}
			Do ar.%Push(obj)
		}Elseif item="temp",($Piece(pkydata,$c(1),4)'=""){
			; can $Piece(4) be a list? if so "expression" value should be an array
			Set obj.evaluate=$$val(+$Piece(pkydata,$c(1),4))
			Do ar.%Push(obj)
		}Elseif item="cond"{
			Set logs=[]
			For i=1:1:$l(pkydata,","){Set log=$Piece(pkydata,",",i) If log Do logs.%Push($$log(log))}
			Do obj.%Set("test conditions",logs)
			Do ar.%Push(obj)
		}Elseif item="id"{ ; read map/tf using the given idkey/subscript values
			If ($Piece(info,$c(1),15)="bmvar")||($Piece(info,$c(1),15)="vecvar") {
				Set cht=$Extract($p(info,$c(1),15)) // chunk type can be "vector" or "bitmap"
				If cht="b"{
					Do obj.%Set("bitmap chunk lookup",$$log($Piece($$$mtV(+$Piece(info,$c(1),3)),"bmlog",2)))
					Do ar.%Push(obj)
				}Elseif cht="v"{
					Do obj.%Set("vector chunk lookup",$$val($Piece($$$mtV(+$Piece(info,$c(1),3)),"vecvar",2)))
					Do ar.%Push(obj)
				}
			}Else{
				Set obj.type=$Select($Piece(info,$c(1),2):"map",$Piece(info,$c(1),3):"temp-file",1:"")
				Set:($Piece(info,$c(1),2)) obj.id=$$map($Piece(info,$c(1),2),info)
				Set:($Piece(info,$c(1),3)) obj.id=$$tfn(+$Piece(info,$c(1),3),$Piece($Piece(info,$c(1),3),"^",2))
				Set str=$Piece(info,$c(1),6),qb=$Piece(info,$c(1),7)
				Set alias=$$alias(qb,str)
				If (alias'=""),($Find(alias,",")=0) Set obj.alias=alias
				Set finfo=$Get($$$aslPkFlds(mod,funk,ndata)),ftab=[],ftab2=[]
				For i=1:1:$Length(finfo,",")-1{
					Set fldobj=$$val($Piece(finfo,",",i))
					Do ftab.%Push($$val($Piece(finfo,",",i)))}
				For j=1:1:ftab.%Size(){
					Set ftabj=ftab.%Get(j-1)
					Do:ftabj.field'="" ftab2.%Push(ftabj.field)}
				Do:(ftab2.%Size()) obj.%Set("data",ftab2)
				Do:($Piece(info,$c(1),5)="p") obj.%Set("null padding","")
				Set wobj.lookup=obj
				Do ar.%Push(wobj)
				If $Piece(info,$c(1),5)="p"{
					Set outerobj={}
					Do outerobj.%Set("outer join null padding"),ar.%Push(outerobj)
				}
			}
		}Elseif item="compare"{
			If $Length(info,"^")=2{
				Set vals=[]
				Do vals.%Push($$val($Piece(info,"^",1))),vals.%Push($$val($Piece(info,"^",2)))
				Set obj.compare=vals
				Do ar.%Push(obj)
			}
		}Elseif item="quq"{
			If $Data(parallelquery){
				Set parallelquery($i(parallelquery)) = $$$mtSql(+info)
				Merge mt("parallelquery")=parallelquery
				Set mt("shardquery")=1 } 
			Set shobj={}
			Set shobj.type=$Select($Get($$$mtShard(+info))="":"separate process",1:"shard servers")
			Set shobj.query=$$$mtSql(+info)
			Do shobj.%Set("temp-file",$$tfn(mod+1,-1))
			Set obj.shard=shobj
			Do ar.%Push(obj)		
		}Elseif item="init"{
			Do obj.%Set("initialize temp-file","") ; AK419
			Do ar.%Push(obj)
		}Elseif item="unary"{ ; set all "unary" functions on fields in str
			Set fval="",fn="",str=$$$aslPkUnaryFuncs(mod,funk,ndata),fnvtab=[]
			For {
				Set fval=$Order(mt("unary",fval)) QUIT:'fval
				CONTINUE:("f^"_str)'=$p($$$mtV(fval),"^",1,2) 
				For {
					Set fn=$o(mt("unary",fval,fn),1,fnv) QUIT:fn=""
					Do fnvtab.%Push($$val(fnv))}
			}
			If (fnvtab.%Size()) Set obj.unary=$$sortfields(fnvtab) Do ar.%Push(obj)
		}Elseif item="bmch"{ //i needs testing if type is temp-file
			Set objAsl = $$$oXasl
			Set arg=objAsl.Mod(mod).Pk(funk,ndata).BitChunk()
			#dim arg As %SQL.Engine.Objects.AslPkBitChunk
			Set tempfile=arg.TempFile(),map=arg.Map()
			Do wobj.%Set($Select(tempfile:"temp-file",1:"map"),$Select(tempfile:$$tfn(tempfile.Mod().Index, tempfile.BuildAction().Index),1:$$map(map)))
			Do obj.%Set("read bitmap chunk",wobj)
			Do ar.%Push(obj)
		}Elseif item="bsrangefilt"{ //i needs testing
			Do wobj.%Set("temp-file","TF"_$List(pkydata,1))
			Set wobj.map=$$map($list(pkydata,3))
			Do obj.%Set("bitslice temp-file range filter",wobj)
			Do ar.%Push(obj)
		}Elseif item="bstopfilt"{ //i needs testing
			Do obj.%Set("bitslice top rows filter",$$map($List(pkydata,4)))
			Do ar.%Push(obj)
		}Elseif item="filter"{
			Set objAsl = $$$oXasl
			Set filter=objAsl.Mod(mod).Pk(funk,ndata).Filter()
			#dim filter As %SQL.Engine.Objects.AslPkFilter
			Do obj.%Set("bitwise operation",$Select(filter.Invert():"and not",1:"and"))
			Do ar.%Push(obj)
		}Elseif item="vop"{
			Set op=$Listget(pkydata,2)
			Set wobj.operation=$$vbopname(op)
			If ",sumg,countg,ming,maxg,countgb,groupg,"[(","_op_","){
				Set tfobj={},tfobj.name=$$tfn($List(pkydata,5),0)
				Do:(op'="groupg") tfobj.%Set("node data",$Select(op="countgb":"COUNT(rows)",1:$Translate($Extract(op,1,*-1),"suminaxcot","SUMINAXCOT")))
				Do wobj.%Set("array temp-file",tfobj)
			}
			If op="convert" Set wobj.datatype=$Listget(pkydata,4)
			Set wobj.filter=$Select($$filtop^%qaqplan(op):"produced",1:"not produced") 
			If ",&,&~,|,"[(","_op_","){
				Do obj.%Set("bitmap operation",wobj)
			}Else{
				Do obj.%Set("vector operation",wobj)
			}
			Do ar.%Push(obj)
		}
		;Elseif item="assign"{}
	}
	QUIT ar
}
vbopname(op) PUBLIC { ; vop/bitmap operation name
	RETURN $Case(op,"&":"AND","&~":"NOT","|":"OR",:op)
}
findtf(bmod) [temptables,mt] { ;  identify temp-file being generated in bmod
	Set tfs=[],tf=""
	If $Data(temptables(bmod)) {
		Set tf="",tfs=[]
		For {
			Set tf=$Order(temptables(bmod,tf)) QUIT:tf=""
			Set tfinfo=$$$mtTempFile(tf)
			If $Piece(tfinfo,"^")="dist",$Piece(tfinfo,"^",3)=""{ Do tfs.%Push("TF"_tf)
			} Else { Do tfs.%Push($$tfn($Piece(tfinfo,"^",2),$Piece(tfinfo,"^",$Select($Piece(tfinfo,"^")="dist":3,1:4)),$p(tfinfo,"^")="dist"))}
		}
	}
	QUIT tfs
}
action(mod,&ss,m)[asl,mt,mts,modun,parallelquery,temptables,tftab,litabs,showstats,tfn,seldict] PUBLIC{ ; return array with the new steps in action (funk=4) 
	Set ndata="",acar=[],stp={},stpobj={}
	If $Get($$$asl0TopModForOjPadding(mod)){
		Set padf=$g($$$asl0PaddedFldsForOjPadding($$$asl0TopModForOjPadding(mod))),tabs="",view=0,tabsa=[]
		For jj=1:1:$Length(padf,",")-1 s tab=$$table^%qaqplan(+$$$mtR($Piece($$$mtV($Piece(padf,",",jj)),"^",2))) If tab="." { Set view=1 } else { Set:'$Listfind(tabs,tab) tabs=tabs_$Listbuild(tab) }
		For jj=1:1:$Listlength(tabs) {Do tabsa.%Push($List(tabs,jj))}
		Do:view tabsa.%Push("view")
		Set stpobj.tables=tabsa
		Do stp.%Set("null padding",stpobj)
		Do acar.%Push(stp)}
	For{
		Set ndata=$Order($$$aslAct(mod,ndata),1,item),stp={}
		QUIT:(ndata="")
		If $Data(ss(mod,item)){ ; process union
			Set unobj=$$union(mod,item,.ss,m)
			Do:unobj.%Size() acar.%Push(unobj)
			CONTINUE
		}
		CONTINUE:(",s,l2,"[(","_$$$aslActAction(item)_","))
		CONTINUE:(ndata=-1)
		Set itemtype=$$$aslActAction(item)
		If itemtype="n"{
			Set nesmod=$$module($$$aslActNestingModOrIpqVars(item),m)
			Set iter = nesmod.%GetIterator(),key="",value=""
     		While iter.%GetNext(.key,.value) {
        		Do acar.%Push(value)
        	}
		}Elseif itemtype="b"{
			Set stp=$$build(mod,ndata,m)
		}Elseif itemtype="a"{
			If $$$aslActBcntAgg(item)="bitcount" {Set stp.accumulate="bitcount"} Else { Set stp.accumulate=$$val($$$aslActBcntVarOrSubqResOrWqmOldFld(item))}
		}Elseif itemtype="q"{
			Set result=$$$aslActBcntVarOrSubqResOrWqmOldFld(item)
			Do:(result'="") stp.%Set("determine subquery result",$$val(result))
		}Elseif itemtype="o"{	
			Do stp.%Set("handle row",$Select($$$mtStatementType="INS":"insert",$$$mtStatementType="UPD":"update",$$$mtStatementType="DEL":"delete",1:"output"))
		}Elseif itemtype="ipq"{
			Set vals = $$$aslActNestingModOrIpqVars(item)_","
			Set ldat = []
			for i=1:1:($l(vals,",")-1){
				Do ldat.%Push($$val($p(vals,",",i)))
			}
			Set ipqobj={}
			Do ipqobj.%Set("temp-file",$$tfn($$$topParentModule($$findqn^%qaqplan(mod))+2,-1))
			Do ipqobj.%Set("node data",$$sortfields(ldat))
			Do stp.%Set("add row",ipqobj)
		}Else{
			Set stp.type=$$$aslActAction(item)
			Do stp.%Set($$$aslActAction(item)_"ACTIONKEY",$$$aslActAction(item)_"ACTIONVALUE")
		}
		Do:(itemtype'="n")&&(stp.%Size()) acar.%Push(stp)
	}
	QUIT acar
}
build(mod,item,m)[mt,mts,asl,parallelquery,tftab,showstats,tfn,seldict] PUBLIC{
	Set info=$$$aslAct(+mod,item),bobj={},bldi=0,lsubs=[],ls=[],ldata=[],ld=[],bobj={},wbobj={}
	Set sort=$Select(($$$aslActSort(info)=1):"required",($$$aslActSort(info)=0):"not required",1:"")
	Set tfid=$$$aslActTfToBuild(info)
	If 'tfid{
		Do wbobj.%Set("build temp-file","")
		QUIT wbobj
	}
	Merge mttfinfo=$$$mtTempFile(+tfid)
	/* Set tftype=$Select($Piece(mttfinfo,"^")="dist":"hybrid",
							$Piece(mttfinfo,"^")="corr":"corrolated",
						 	($Piece(mttfinfo,"^")="temp")&&($Piece(info,$c(1),8)="bit"):"bitmap",
						 	($Piece(mttfinfo,"^")="temp"):"local",
							($Piece(mttfinfo,"^",19)):"pre-process",
						 	1:"other") */
	Set bitmap=($$$aslActIsBmTf(info)="bit")||($Piece(mttfinfo,"^",16))
	Set storage=$Select($Piece(mttfinfo,"^")="dist":"hybrid",$Piece(mttfinfo,"^",12)=1:"local",$Piece(mttfinfo,"^",12)=0:"global",1:"")		 	
	Set bobj.id="TF"_tfid
	If $$$aslActVecJoin(info)'="" {  ; AK1064
		Set k=$$jkeys^%qaqpmod(+$$$aslActRightTableKeysVec(info)),f=$$remove^%qaqpmod($$unveclist^%qaqpmod($$$aslActRightTableFldsVecs(info)),k)
		Set ftab=[],ktab=[]
		For i=1:1:$Length(f,",")-1{ d ftab.%Push($$val($Piece(f,",",i)))}
		For i=1:1:$Length(k,",")-1{ d ktab.%Push($$val($Piece(k,",",i)))}
		If f=""{ Do bobj.%Set("key vectors",ktab)
		}Else {Do bobj.%Set("vectors",$$sortfields(ftab)),bobj.%Set("key vectors",$$sortfields(ktab))}
	}Else{
		For  {
			Set bldi=$Order($$$aslActNode(mod,item,bldi),1,bin)
			QUIT:(bldi="")
			If $$$aslActNodeSubscriptTraversalMode(bin)="s"{
				Set value=$$$aslActNodeSubscriptVar(bin)
				If +value {
					Set val=$$val(value)
					Do lsubs.%Push(val)
					Set rval=$$copyobj(val)
					Do rval.%Remove("alias")
					Do ls.%Push(rval)
				}Elseif	(+$$$aslActNodeConstSubscriptVar(bin)){
					Set litsub={},litsub.literal="" Do lsubs.%Push(litsub)
				}
			} Elseif $$$aslActNodeSubscriptTraversalMode(bin)=""{
				Set datobj=$$val($$$aslActNodeSubscriptVar(bin)),rdatobj=$$copyobj(datobj)
				Do:(datobj.%Size()) ldata.%Push(datobj),rdatobj.%Remove("alias"),ld.%Push(rdatobj)	
			}
		}
	}
	Set tfobj={},tfobj.id="TF"_tfid
	Set tfobj.type=$Select(bitmap:"bitmap",$$$aslActVecJoin($$$aslAct(mod,item))'="":"vector-join",1:"regular")
	If (lsubs.%Size()){ Set bobj.subscripts=lsubs,tfobj.subscripts=ls}
	If (ldata.%Size()) {
		Do bobj.%Set("data",$$sortfields(ldata))
		Set pdat=tfobj.data
		If (pdat="") {
			Set tfobj.data=$$sortfields(ld)
		}Else{
			Set tt=$$sortfields($$concatarray(tfobj.data,ld))
		}
	}
	Do:(storage'="") tfobj.%Set("storage",storage)
	Do:(sort'="") tfobj.%Set("$SORT",sort)
	Do tftab.%Push(tfobj)
	Do wbobj.%Set("build temp-file",bobj)
	QUIT wbobj
}
dsn(mod) [asl,mt,mts,modun,parallelquery,temptables,tftab,litabs,showstats,tfn,seldict] Public { ; process xDBC
	Set obj={},wobj={}
	Set dsn=$$$aslKId(mod,1),m=$$$aslIdQb(dsn),dsn=$$$aslIdLoopSupprSubscript(dsn)
	Do getFlags^%apiGTW(dsn,,.isJDBC)
	Set type=$Select(isJDBC:"j",1:"o")_"dbc"
	Set obj.dsn=dsn
	Set obj.query=$$$mtSql(m) ;  generated query
	Do wobj.%Set(type,obj)
	QUIT wobj
}
bsl(mod,m) [asl,mt,mts,modun,parallelquery,temptables,tftab,litabs,showstats,tfn,seldict] Public { ; process bsl modules
	Set obj={},wobj={},bodyarray=[]
	Set last=$Order($$$aslK(mod,""),-1),chid=$Select($$$aslIdLoopOnChunks($$$aslKId(mod,last)):"bitmap chunk",1:"idkey value")
	Do obj.%Set("stream type",chid)
	Set obj.expression=$$bslit(mod,last,m)
	Do wobj.%Set("multi-index loop",obj)
	QUIT wobj	
}
bslit(mod,item,m) [asl,mt,mts,modun,parallelquery,temptables,tftab,litabs,showstats,tfn,seldict] Public { ;  returns an object: expression for BSL item asl(mod,2,item), adapted from bslit^%qaqplan
	Set info=$$$aslKId(mod,item),optinfo=$Get($$$aslKBslTopOptInfo(mod,2,item))
	Set flag=$$$aslIdKeyAccessType(info),arg=$$$aslNextSkipNull($$$aslKNext(mod,item,1))
	Set exp={}
	If flag="or"{
		Set arg1=$$bslit(mod,+arg,m),arg2=$$bslit(mod,$Piece(arg,",",2),m)
		Set args=[] Do args.%Push(arg1),args.%Push(arg2)
		Set exp.union=args	
	}Elseif flag="and"{
		Set arg1=$$bslit(mod,+arg,m),arg2=$$bslit(mod,$Piece(arg,",",2),m)
		Set args=[] Do args.%Push(arg1),args.%Push(arg2)
		Set exp.intersect=args	
	}Elseif flag="map"{
		Set exp.map=$$map($$$aslIdMapId(info),info)
	}Elseif flag="temp"{
		Set tfobj={},tfobj.id=$$tfn(+$$$aslIdTfBuildLoc(info),$Piece($$$aslIdTfBuildLoc(info),"^",2)),tfobj.module=$$module(+$Piece(info,$c(1),3),m)
		Do exp.%Set("temp-file",tfobj)	
	}Elseif flag="convert"{
		Set exp.convert=$$bslit(mod,arg,m)
	}Elseif flag="bstopfilt"{
		Set exp.type="bitslice top filter",exp.expression=$$bslit(mod,arg,m),exp.from=$$map($List(optinfo,4),info)
	}Elseif flag="bsrangefilt"{
		Set ar=[] For i=1:1:$Listlength(optinfo){Do ar.%Push($$map($List($List(optinfo,i),3),info))}
		Set exp.type="bitslice range filter",exp.expression=$$bslit(mod,arg,m),exp.from=ar
	}Elseif flag="set"{ ; to be reviewed/tested
		Set exp.set=$$val(+$$$aslKNext(mod,ndata,1))
	}Elseif flag="single"{ ; to be reviewed/tested
		Set exp.single=$$val(+$$$aslKNext(mod,ndata,1))
	}
	QUIT exp
}
union(mod,item,&ss,m)[asl,mt,mts,modun,parallelquery,temptables,tftab,litabs,showstats,tfn,seldict]{ ; returns an object, process the "legs" and their shared module
	Set listitem=ss(mod,item),unobj={},obj={}
	QUIT:listitem="" unobj ; this leg is alrady processed
	Set legsarray=[]
	For lgi=1:1:$Listlength(listitem)-1 {
		Set unstp=$$module($List(listitem,lgi),m)
		Do legsarray.%Push(unstp)
	}
	Set unobj.legs=legsarray,shareval=$$module($List(listitem,*),m),unobj.share=shareval,obj.union=unobj
	QUIT obj
}	
.
sharespecs(mod,&ss) [asl,showstats] PUBLIC { ; build "share" specification array
	#; the first node data (associated with the first leg of ss) is a list of the top modules for each leg, followed by a shared module
	#; the subsequent node data associated with the remaining legs are empty because they are processed when treating the first leg
	#; ss(mod,"n"_$c(1)_leg1)=$lb(leg1,leg2,..,legn,sharedmod)
	#; ss(mod,"n"_$c(2)_leg2)=""
	#; .
	#; .
	#; ss(mod,"n"_$c(1)_legn)=""
	Set nmodlist=$Listget($Get($$$asl0NestedMods(mod)),2)
	QUIT:'$Listvalid(nmodlist)
	QUIT:$Listlength(nmodlist)<2
	Set ndata="",nlegs=0,topmodlist=$Listbuild()
	For{
		Set ndata=$Order($$$aslAct(mod,ndata),1,item)
		QUIT:(ndata="")
		If $$$aslActAction(item)="n"{ Set ss(mod,item)="",nlegs=nlegs+1,$List(topmodlist,nlegs)=$$$aslActNestingModOrIpqVars(item)}}
	If (nlegs>1){
		Set firstleg=$Order(ss(mod,""))
		Set $List(topmodlist,nlegs+1)=$List($Get($$$asl0NestedMods(mod)),*)
		Set ss(mod,firstleg)=topmodlist
	}Else {Kill ss Set ss=""}
}
tfn(mod,item,dist=0) [tfn,mt,asl,tftab] PUBLIC {
	If '$Data(tfn(mod,item)){
		If 'item,'$Data(mt("oatfn",mod),tf){
			Set $$$mtTempFile($i($$$mtLatestTempFileNum))="plan^"_mod_"^^"_item,tf=$$$mtLatestTempFileNum // array temp-file (columnar)
		}
		Elseif dist{ Set tf=$$$aslPkDistTf($$$aslPkDist(mod,3,item)) // Set:'$d(mt("tf",tf,"text")) mt("tf",tf,"text")="TF"_tf //$s($$$mtTfBitmapFlag($$$mtTempFile(tf)):"bitmap ",1:"")_"temp-file "_tf
		}Else{
			If '$$$aslActTfToBuild($$$aslAct(mod,item)){
				Set $$$mtTempFile($i($$$mtLatestTempFileNum))="plan^"_mod_"^^"_item
				Set $$$aslActTfToBuild($$$aslAct(mod,item))=$$$mtLatestTempFileNum
				Set nutfobj={},nutfobj.id="TF"_$$$mtLatestTempFileNum
				Do tftab.%Push(nutfobj) 
			}
			Set tf=$$$aslActTfToBuild($$$aslAct(mod,item))
		}
		// Set:'$d(mt("tf",tf,"text")) mt("tf",tf,"text")="TF"_tf ; add temp-file to the parse tree
		Set tfn(mod,item)="TF"_tf
	}
	QUIT tfn(mod,item)
}
map(imp,idinfo="") [mt,litabs,showstats] PUBLIC { ;
	Set mapobj={}
	If $d(mt("filterm",imp),filter){
		Set name=$Select($Extract(filter,1,6)="%INBIT":"bitmap ",1:"")_"filter"
		Set mapobj.name=name
		Do mapobj.%Set("filtered table",$$table^%qaqplan(+$$$mtR($Piece(idinfo,$c(1),6)))_".%ID")
	}Else{
		Set smdimp=$s($d(mt("smdimp",imp)):mt("smdimp",imp),1:imp)
		Set it=$$$smdMapIndexType(smdimp)
		Set node=$s($$$smdMapMaster(smdimp)="Y":"master",it="BE":"bitmap extent",it="B":"bitmap",it="S":"bitslice",$e(it)="C":"columnar index",1:"index")
		Set tabname=$$table^%qaqplan($$$smdMapIrn(smdimp)),mapname=$$$smdMapName(smdimp),mapid=tabname_"."_mapname
		Set mapobj.id=mapid
		Set mapobj.map=mapname
		Set mapobj.type=node
		Set str=$Piece(idinfo,$c(1),6),qb=$Piece(idinfo,$c(1),7)
		Set mappos=$$tableexists(litabs,tabname)
		If mappos=-1{
			Set ntab={},ntab.name=tabname,ntab.maps=[],ntab.fields=[]
			Do litabs.%Push(ntab) // need to push ntab first or $$log will infinitely recurse and get a <FRAMESTACK> error
			If $$$IsFTStream(str) {
				Do ntab.%Set("foreign server", $s($d($$$FTFakeStream(str)): $$$FTFakeStreamServer(str), 1:$$$FTServerByOriginalStream(str)))
			}
			Set tabmaps=[]
			If showstats{
				Do mapobj.%Set("blockcount",$$$smdMapNumberOfBlocks(imp))
				Set irn=$$$smdMapIrn(imp)
				If $$$smdMasterMap(1,irn)=imp Do mapobj.%Set("extent size",$$$smdExtentSize(1,irn))
			}
			Do ntab.maps.%Push(mapobj)
			
		}Else{
			Set tab=litabs.%Get(mappos)
			Set lmaps=tab.maps	
			If '$$objexists(lmaps,mapid) {
				If showstats{
					Do mapobj.%Set("blockcount",$$$smdMapNumberOfBlocks(imp))
					Set irn=$$$smdMapIrn(imp)
					If $$$smdMasterMap(1,irn)=imp Do mapobj.%Set("extent size",$$$smdExtentSize(1,irn))
				}
				Do lmaps.%Push(mapobj)
			}
		}
		//Set alias=$$alias(qb,str)
		//Set:(alias'="")&&($Find(alias,",")=0) mapobj.alias=alias
	}
	QUIT mapid
}
val(val) [mt,mts,showstats,litabs] Public{ ; returns an object that describes mt("v",val)
	QUIT:(val="") {}
	if $d($$$mtVecDistFunc(val)) {
		s val=$$$mtVecDistFunc(val)
	}
	Set info=$Get($$$mtV(val)),valobj={}
	if $Piece(info,"^",1)="f"{
    	Set ifn=$Piece(info,"^",3),virf=0,coll=""
		If ifn["_" Set coll=$Extract(ifn,$f(ifn,"_"),*)
		If $Data($$$mtVirf(+ifn),ifnval){
			Set virftype=$List(ifnval,1),ifnval=$List(ifnval,2)
			If 'virftype{
				Do valobj.%Set("view counter","")
				 
			} Else{
			 	Do valobj.%Set("view field",$$val(ifnval))
			 	Set:(coll'="") valobj.collation=coll
			}
			QUIT valobj 	 
		}
		Set smdinfo=$Get($$$smd(1,"ifn",+ifn)),irn=$Piece(smdinfo,$c(1),2)
		Set irninfo=$g($$$smd(1,irn)),tabname=$li(irninfo,1)_"."_$li(irninfo,2)
		Set rawname=$Piece($Get($$$smd(1,"ifn",+ifn)),$c(1),1)
		Set:(coll'="") id=rawname_"_"_coll
		Set:(coll="") id=rawname
		Set valobj.field=id
		Set str=$Piece(info,"^",2),m=$Piece($Get($$$mtR(str)),"^",2)
		Set alias=$$alias(m,str)
		Set:(alias'="")&&($Find(alias,",")=0) valobj.alias=alias
		// don't reveal the internal pseudo-ID counter field name used for foreign tables
		if $$$IsFTStream(str), $$$smdGetFieldName(ifn)=$$$smdRowIDFieldName(1, irn) {
			set valobj.field = "pseudo-ID", id = "pseudo-ID"
		}
		Set tabpos=$$tableexists(litabs,tabname)
		If tabpos=-1{
			Set ntab={},ntab.name=tabname,ntab.fields=[],ntab.maps=[]
			Do litabs.%Push(ntab) // need to push ntab first or $$log will infinitely recurse and get a <FRAMESTACK> error
			If $$$IsFTStream(str) {
				Do ntab.%Set("foreign server", $s($d($$$FTFakeStream(str)): $$$FTFakeStreamServer(str), 1:$$$FTServerByOriginalStream(str)))
			}
			Set liflds=ntab.fields	
		}Else{
			Set tab=litabs.%Get(tabpos)
			Set liflds=tab.fields
		}
		If '$$objexists(liflds,id) {
			Set fullobj={},fullobj.id=valobj.field
			Set:(coll'="") fullobj.collation=coll
			Set:(coll'="") fullobj.uncollated=rawname
			If showstats{
				Set irn=$Piece(smdinfo,$C(1),2)
				Set sel=$Piece($Get(mts(m,str,"ATT",ifn)),"^",6)
				Set:(sel'="") fullobj.selectivity=sel  ; $$$smdColSelectivity(1,irn,+ifn) is less relevant than the selectivity in mts()
				Do:(irn'="") fullobj.%Set("average field length",$$$smdColAverageFieldSize(1,irn,+ifn))	
			}
			Do liflds.%Push(fullobj)
		}
	}
	Elseif $Piece(info,"^",1)="t"{
		Set valobj.const=$Piece(info,"^",2)
	}Elseif $Piece(info,"^",1)="a"{
		Set obj={}
		Set obj.function=$Piece(info,"^",2)
		If '$Piece(info,"^",5) {Set aobj={},aobj.rows="",obj.argument=aobj}
		Else {Set obj.argument=$$val($Piece(info,"^",5))}
		Set valobj.aggregate=obj
	}Elseif $Piece(info,"^",1)="x"{
		If $Piece($$$mtV(val),"^",2){
			Set valobj=$$val($Piece($$$mtV(val),"^",2))
		} Else{ Set valobj.parameter=$Piece($$$mtV(val),"^",2)}
	}Elseif $Piece(info,"^",1)="v"{ 
		Set args=[],vobj={}
		For i=4:1:$l(info,"^") {
			Set argval=$Piece(info,"^",i)
			Do:(argval'="") args.%Push($$val(argval))	
		}
		Do vobj.%Set($Piece(info,"^",2),$$sortfields(args)),valobj.%Set("expression",vobj)
	}Elseif $Piece(info,"^",1)="q"{
		Set valobj.subquery="qb"_$Piece(info,"^",2)
	}Elseif $Piece(info,"^",1,2)="i^unout"{
		Do valobj.%Set("union column",$Piece(info,"^%%C",2))
	} Elseif $Extract(info,1,5)="i^^i^",info["vsb"{ 
		Set valobj."vector chunks"=""
	} Elseif $Extract(info,1,5)="i^^i^",info["sb"{ ; This was $Extract(info,1,7)="i^^i^sb"{
		Set valobj."bitmap chunks"=""
	} Elseif info="i^tempID"{
		Set valobj.counter=""
	}Elseif $Extract(info,1,10)="i^^i^parag"{
		Do valobj.%Set("parallel aggregate","")
	}Elseif info["i^^i^bmlog"{
		Do valobj.%Set("bitmap filter",$$log($p(info,"i^^i^bmlog",2)))
	}Elseif info["i^^i^wf"{
		Do valobj.%Set("where filter",$$log($p(info,"i^^i^wf",2)))
	}
	Elseif info[".power"{
		Do valobj.%Set("bitslice power","")
	}Elseif info[".sub"{
		Do valobj.%Set("bitslice chunk","")
	}Elseif info[".aggPower"{
		Do valobj.%Set("power aggregate","")
	}Elseif info[".chunkSub"{
		Do valobj.%Set("bitmap chunks","")
	}Elseif info?1"i^".E1"^dist"1.N1"prefix"{
		Do valobj.%Set("the hash","")
	}Elseif info?1"i^".E1"^dist"1.N1"cnt"{
		Do valobj.%Set("the hash bucket","")
	}
	QUIT valobj
}
log(log) [mt,seldict,showstats] Public{ ; returns an object that describes $$$mtL(log)
	QUIT:(log="") {}
	Set info=$Get($$$mtL(log))  QUIT:(info="") {}
	Set wobj={},obj={}
	i $Piece(info,"^",1)="v"{
		Set vtype=$Piece(info,"^",2)
		Set args=[]
		f i=4:1:$l(info,"^") {Set argval=$Piece(info,"^",i) Do:(argval'="") args.%Push($$val(argval))}
		Set obj.args=$$sortfields(args)
		Set:($Data(seldict(log))) obj.selectivity=seldict(log)
		Do wobj.%Set(vtype,obj)
	}Elseif $Piece(info,"^",1)="l"{
		Set type=$Piece(info,"^",2),type=$case(type,"!":"OR","&":"AND","'!":"NOR","'&":"NAND","'":"NOT",:type)
		Set obj.type=type
		Set args=[]
		f i=4:1:$l(info,"^") { Set arglog=$Piece(info,"^",i) Do:(arglog'="") args.%Push($$log(arglog))}
		Set obj.args=args,obj.selectivity=$Get(seldict(log))
		Do wobj.%Set(type,obj)
	}
	QUIT wobj
}
sqltext() [sqlOrig,sql] Public{ ; This function is adapted from %qaqplan
	Set declare=$$$UPPER($$$StripLeadingWhiteSpace($Get(sqlOrig(1)))),declare=$s($Extract(declare,1,11)="DECLARE QRS":0,1:$Extract(declare,1,7)="DECLARE")
	MERGE sqlStmt=sql
	Set sqltext=[]
	if 'sqlStmt {Set sqltext=[""]}
	Else {  
		Set sqlLn1=0
		for jj=1:1:sqlStmt {	; Process SQL Query Lines
			Set sqlLine=sqlStmt(jj)
			if 'sqlLn1&&'declare{	; Remove DECLARE CURSOR if not part of original SQL Statement
				Set sqlLineUPPER=$$$UPPER(sqlLine)
				if $Extract($$$StripLeadingWhiteSpace(sqlLineUPPER),1,2)'="--" {	// --- First SQL Query Line ---
					Set sqlLn1=1	; Mark that SQL Query Line 1 Processed
					Set:$Extract($$$StripLeadingWhiteSpace(sqlLineUPPER),1,7)="DECLARE" sqlLine=$Extract(sqlLine,$f(sqlLineUPPER,"CURSOR FOR")+1,*)
					CONTINUE:$tr(sqlLine," ","")="" ; Skip Empty SQL Line
				}
			}
			Do sqltext.%Push(sqlLine) ; Add SQL Query Line to sqltext array
		}
	}
	QUIT sqltext
}
alias(qb,str)[mt] PUBLIC {
	QUIT:(qb="") ""
	QUIT:(str="") ""
	s qbalias="",title="",alias="",stra=""
	f{
		s qbalias =$order(mt("ptrel",qbalias),1,stra)
		q:(qbalias="")
		s qba=$p(qbalias,"^",1),aliasa=$p(qbalias,"^",2)
		s:(aliasa[",") aliasa=$p(aliasa,",",*)
		i ((qba_","_stra)=(qb_","_str)),aliasa'=$g($$$mtFromTableName(qbalias)) s alias=aliasa			
	}
	if alias["tsq",alias["%" s alias="" ; don't show internally generated subquery table aliases
	if alias["->"{ ; arrow syntax for implicit joins
		s:($p(alias,"->")'[".") alias=$tr($p(alias,"->",1,2),"->",".")_"->"
		s:($p(alias,"->")[".") alias=$p(alias,"->")_"->"
	}
	QUIT alias
}
tableexists(tablist,tabname) PUBLIC {
	Set iter = tablist.%GetIterator(),pos=-1
	While iter.%GetNext(.key , .value ) {
        If tabname=value.name Set pos=key}	
	QUIT pos	
}
objexists(olist,nuid) PUBLIC {
	Set iter = olist.%GetIterator(),oexists=0
	While iter.%GetNext(.key , .value ) {
        If nuid=value.id Set oexists=1}	
	QUIT oexists
}
copyobj(obj) PUBLIC{
	Set newobj={}
	Set iter = obj.%GetIterator()
	While iter.%GetNext(.key , .value ) {
        Do newobj.%Set(key,value)}	
	QUIT newobj
}
concatarray(a,b) PUBLIC { ; concatenate 2 dynamic arrays a and b
     set iter = b.%GetIterator()
     while iter.%GetNext(.key , .value ) {
        Do a.%Push(value)}	
     QUIT a
}
sortfields(a)[mt] PUBLIC{
	#; for an array of vals, sort the fields/virtual fields in the subscript order
	QUIT:(a.%Size()<2) a
	Set s=a.%Size(),b=[],lflds="",m=""
	For i=1:1:s{
		Set field=a.%Get(i-1),fldobj=field."field",vfldobj=field."view field"
		If $Piece($Piece(fldobj,"{"),"@",2)="%Library.DynamicObject"{
			Set id=fldobj."id"
			Set:($g(m(id))="") m(id)=i,lflds=lflds_$lb(i)
		}Elseif fldobj'=""{
			#; we might have something like this [{"field":"fVARCHAR1_%SQLUPPER","alias":"X"},{"field":"fVARCHAR1_%SQLUPPER"}]
			Set:($g(m(fldobj))="") m(fldobj)=i,lflds=lflds_$lb(i)
		}Elseif vfldobj'=""{
			Set id=vfldobj."field"
			#; view field is not always mapped to a field, it can be mapped to a subquery or an expression
			Set:(id'="")&&($g(m(id))="") m(id)=i,lflds=lflds_$lb(i)
		}
	}
	Set pos=$o(m(""))
	For i=1:1:s{
		If $LISTFIND(lflds,i),pos'=""{
			Do b.%Push(a.%Get(m(pos)-1))
		    Set pos=$o(m(pos))
		}Else{
			Do b.%Push(a.%Get(i-1))
		}
	}
	RETURN b
}
sorttabfields(a)[mt] PUBLIC{
	#; for an array of field ids, sort the ids in the subscript order
	Set s=a.%Size(),b=[],lflds=""
	For i=1:1:s{
		Set field=a.%Get(i-1),fldobj=field.id
		Set m(fldobj)=i,lflds=lflds_$lb(i)
	}
	Set pos=$o(m(""))
	For i=1:1:s{
		If $LISTFIND(lflds,i),pos'=""{
			Do b.%Push(a.%Get(m(pos)-1))
		    Set pos=$o(m(pos))
		}Else{
			Do b.%Push(a.%Get(i-1))
		}
	}
	RETURN b
}
