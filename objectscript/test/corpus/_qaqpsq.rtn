====
qaqpsq
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpsq^MAC^^^0
%qaqpsq(input)  ;  SQL parser
	;; COMPONENTS :: SQL/Parser
	#;
#INCLUDE %msql
#INCLUDE %sySite
#IF 0   ;-------------------------------------------------------------
	; Description:   SQL parser main entry
	; Author:        Aviel Klausner
	; Date Started:  January 28 1988
	;
	;  AK850   (11/30/2020) - Implement lateral join
	;  AK1032  (11/16/2020) - Allow streamless expression as TVF argument
	;  AK1009  (10/22/2019) - Use non-matching first FROM-item for ASE
	;  AK1004  (08/12/2019) - Enable %PARALLEL for INSERT/UPDATE/DELETE
	;  JMM837  (03/09/2018) - Unified routine and globals databases for sharded cluster
	;  PVA348  (03/01/2016) - PVA348 - Support Lateral references in JSON_TABLE through optimizer 
    ;  PVA349  (02/11/2015) - Fix parsing problem where (even with delimited identifiers) you could not INSERT into a table named "JSON_TABLE". 	
	;  PVA342  (12/15/2015) - Generate ojfilters for sharding only when really needed, and fix interaction between aggregates and outer joins (for sharding) 
	;  DLP3474 (12/17/2015) - Change JSON_TABLE syntax from JSON encoded arguments to SQL standard syntax
	;  PVA331  (09/06/2015) - Support %nofplan directive, display whether a shown plan is frozen, and various other frozen plan changes
	;  PVA330  (08/31/2015) - Fix %firsttable to work in FROM subqueries
	;  AK938   (07/29/2015) - Sharded joins
	;  AK924   (03/16/2015) - Query processing for SQL sharding
	;  PVA320  (05/10/2015) - Initial Query Plan save/use facility
	;  PVA304  (04/23/2014) - Support %PARTITION BY for use by parallel work units
	;  PVA302  (04/17/2014) - Allow parantheses around SELECT statement 
	;  AK883   (08/01/2013) - Remove ORDER BY if "onerow"
	;  PVA290  (09/26/2013) - Support %NOREDUCE	query hint
	;  PVA285  (09/20/2013) - Fix cause of a <NULL VALUE> error in pushtop^%qaqpop
	;  AK862   (04/02/2012) - "findname" for all tables and fields
	;  PVA262  (06/13/2012) - support alternative to %starttable: %firsttable <correlation name>
	;  AK849   (01/18/2012) - Parallel processing for UNION
	;  AK834   (10/27/2011) - Fix view fields removal logic for DESC ORDER
	;  PVA213  (07/09/2011) - A new hint %ALLINDEX is provided to request that 'all indexes' be used for the first table in the join order
	;  PVA236  (03/09/20ll) - Fix <SUBSCRIPT> error in pathifn caused by attempt to tread %vid as a real view field 
	;  PVA209  (12/01/2009) - Rationalize interaction between hints
	;  PVA208  (11/10/2009) - Implement keyword to specify table to start joins from: %STARTTABLE
	;  PVA205  (11/03/2009) - Support %NOUNIONOROPT query hint
	;  PVA204  (10/27/2009) - Make ORDER a non reserved word
	;  PVA198  (09/04/2009) - Extend AK743 to cover remaining opportunities for view output optimization
	;  AK743   (07/30/2009) - Remove unused view fields during parsing
	;  PVA183  (05/26/2009) - Pre-optimizer support for TOP...ORDER BY in subqueries
	;  PVA180  (05/19/2009) - Parse TOP ... ORDER BY in subqueries
	;  DPV3410 (05/14/2009) - Implement SQL schema search paths
	;  DPV3369 (03/05/2009) - Report in contextdep() if there are reference to %CLASSNAME or %TABLENAME, unqualified names off for now
	;  PVA168  (02/24/2009) - Query against view with outer join might have result set metadata that was incorrect as to which columns are nullable
	;  DPV3357 (02/03/2009) - Correct table name resolution when using UNICODE names
	;  PVA164  (10/31/2008) - Give error message for unsupported NATURAL FULL JOIN and FULL JOIN ... USING
	;  DPV3231 (08/05/2008) - Use process private global for ptln, ptrel
	;  DPV3228 (07/28/2008) - Informix temp tables and deferred SQL support
	;  DPV3227 (07/28/2008) - Implement "tablist" info compile
	;  DPV3128 (06/18/2008) - Fix type reporting for union queries
	;  DPV3196 (06/13/2008) - Support SELECT with no from clause - implied FROM clause of %TSQL_sys.snf
	;  AK703   (06/04/2008) - Don't use "onerow" if correlated fields used
	;  PVA156  (04/28/2008) - Implement %NOTOPOPT keyword
	;  DPV3131 (03/25/2008) - DD Lookup and Table compiler performance improvements
	;  DPV3121 (03/05/2008) - Implement LinkedTableMap to define fake master map for Linked tables
	;  DPV3095 (01/22/2008) - Support for column-level privileges
	;  PVA139  (09/21/2007) - Allow updatable view to be streamed
	;  PVA128  (02/13/2007) - Enable xDBC to report correct column nullability information for new outer join support.
	;  PVA129  (02/23/2007) - <UNDEFINED>clone+3^%qaqpnl when compiling CREATE VIEW of full outer join of two comples full outer joins
	;  DPV2862 (02/22/2007) - New some variables that were leaking
	;                         SQL Fix ProdLog 55764:  Local variables remain after compiling
	;  JLF148  (02/06/2007) - Added ORDER to list of terms that could follow the FROM clause (PVA126)
	;  PVA126  (02/06/2007) - Improve error handling when FROM clause contains an unknown keyword
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  PVA119  (12/18/2006) - When compiling update /delete against an updatable view: <UNDEFINED>stream+11^%qaqpmod *mtc("1A","f")
	;  PVA108  (11/22/2006) - Support RIGHT and LEFT joins with nested ON clauses and general predicates
	;  AK661   (11/06/2006) - Fix NULLABLE reporting for OUTER JOIN
	;  PVA105  (11/09/2006) - Parse all the previously unsupported cases of JOIN ...ON
	;  PVA104  (11/08/2006) - Cache SQL allows invalid FROM clause - reference across commas
	;  PVA103  (11/08/2006) - Delimited table alias with embedded periods does not work
	;  PVA099  (09/14/2006) - Extend PVA087 to views on the right hand side of a left join
	;  JLF124  (10/16/2006) - %IGNOREINDICES index hint
	;  PVA092  (06/24/2006) - Modify outer join data structure to avoid subscript size limit; assorted other outer join bugs
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  PVA087  (02/01/2006) - Extended Outer Join Support: Any ON clause for LEFT JOIN from base tables to a base table
	;  AK637   (11/10/2005) - Support FROM in UPDATE/DELETE
	;  JLF090  (03/08/2006) - Correct <>ALL semantics, add NOT pushdown
	;  PVA085  (01/03/2006) - %inorder in a view will apply for all views; it will imply streaming
	;  JLF071  (12/14/2005) - Federated Database Support
	;  DPV2533 (10/12/2005) - Fix INSERT/SELECT into a view
	;                         SQL Fix ProdLog 46593: insert..select fails with <UNDEFINED>pushlog+3^%qaqpnl
	;  PVA082  (09/19/2005) - NATURAL joins don't work
	;  DPV2512 (09/09/2005) - Restructure mt("view")
	;                         SQL Fix ProdLog 45792: View Creation WITH CHECK OPTION FAILS
	;  DPV2480 (08/03/2005) - New some variables
	;  AK572   (08/01/2005) - Check that UNION subqueries have same width
	;  DPV2444 (06/16/2005) - Don't reference ^oddEXTR in ddtab after loading table into $$$smd
	;  PVA081  (05/24/2005) - Fix ERROR #94 - LOJ from a view expression
	;  JLF003  (10/08/2003) - EXISTS subquery flattening and EXISTS subquery to view transformations (hints)
	;  AK604   (07/02/2004) - Avoid error 94 for CREATE VIEW
	;  DPV2157 (01/26/2004) - Don't perform table lookups for embedded SQL within a CREATE PROC/FUNC/METH/QUERY statement
	;                         Fix ProdLog 35184:  Can't create stored procedures for classes in the default package
	;  DPV2142 (12/10/2003) - Return SQLCODE=-142 error if cardinality mismatch between view column and select list
	;			  SQL Fix ProdLog 28869: an unqualified name resolution problem
	;  DPV2137 (12/02/2003) - Always set mt("k") piece 12 for INS/UPD/DEL, not just for views
	;  DPV2134 (12/02/2003) - CompileDeferredList is in %apiDDL2, not %apiDDL
	;			  SQL Fix ProdLog 34862:  SET OPTION COMPILEMODE=IMMEDIATE fails
	;  DPV2132 (12/01/2003) - Check readonly for INS/UPD/DEL at compile time
	;			  SQL Fix ProdLog 34802:  some errors for UPDATE/DELETE for Read-Only tables
	;  DPV2090 (10/10/2003) - Add extentname to mtc(0,0,"table")
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  PVA052  (06/05/2003) - Gather correct information for SELECT privilege checking
	;  PVA050  (02/12/2003) - ensure use of rowid based on one field, and the field itself are equally optimized
	;  DPV1963 (03/14/2003) - Eliminate binding of connection string to ^mdd
	;  AK531   (08/21/2002) - Fix implied %FOREACH when DISTINCT used
	;  AK526   (07/01/2002) - CDS: Outer join into a view with one table
	;  DPV1730 (05/29/2002) - Only don't allow alaias in UPD/DEL if m=1
	;  DPV1729 (05/28/2002) - Only set mt("k") piece 12 with view name for UPD/DEL, INS handled in insrt^%qaqpsq1
	;  DPV1724 (05/28/2002) - New viewinfo in qterm if genview'="" and subq'=genview
	;  AK522   (05/21/2002) - Don't mark view as external
	;  DPV1693 (04/04/2002) - Support updatable views
	;  AK515   (04/04/2002) - CDS: Outer join into a view with no WHERE
	;  MIT181  (04/01/2002) - Do not flatten queries for external tables
	;  DPV1676 (03/05/2002) - CCS: Use view's schema as default schema when processing view's query
	;  AK500   (12/12/2001) - SHD: Fix HAVING and "onerow" case
	;  AK497   (11/29/2001) - SHD: Skip error 94 on info-compile
	;  DPV1616 (11/16/2001) - Move checking of duplicate view column names to SQL binding
	;                         Use mt( instead of @mt@(
	;  PVA027  (08/01/2001) - Support a few optimizer directives on the FROM clause
	;  DPV1559 (06/20/2001) - Handle Default Schame Name == Current SQL User Name
	;  AK469   (03/29/2001) - Allow LEFT JOIN into a view
	;  AK461   (01/30/2001) - View with UNION
	;  DPV1490 (01/30/2001) - New genview in union
	;  DPV1475 (01/03/2001) - Put qnum in ptln subscript for AS <expr>, it was already done for AS Field
	;  PVA013  (09/28/2000) - Compaq: AS clause accepted for FROM clause subquery
	;  PVA018  (09/25/2000) - Magic: Allow parentheses around join expressions
	;  AK446   (05/31/2000) - View stream processing
	;  DPV1344 (07/18/2000) - Add support for INSTALL compile mode
	;  DPV1324 (06/19/2000) - #import sets current schema(s)
	;  AK447   (06/15/2000) - FROM parsing cleanup
	;  DPV1310 (05/30/2000) - Support schemas
	;  DPV1284 (03/30/2000) - Use $$any() instead of $$anyid() for reserved words
	;  DPV1274 (03/09/2000) - Add $namespace as first subscript to ^mtemp2, since its stored in CacheTemp
	;  DPV1223 (12/16/1999) - Fix delimited identifiers for field qualifiers in select list
	;  AK414   (12/09/1999) - Brazil: Subquery aggregates return one row
	;  AK405   (11/01/1999) - Dynamic host variables
	;  PVA004  (10/27/1999) - wrong results for some join expressions
	;  PVA003  (10/13/1999) - NATURAL JOIN and JOIN...USING don't compile
	;  PVA002  (10/08/1999) - JOIN defaults to LEFT JOIN instead of INNER
	;  AK399   (10/08/1999) - CCS: Fix UNION SELECT f AS g
	;  PVA001  (10/06/1999) - CROSS JOIN syntax
	;  AK395   (09/03/1999) - External tables
	;  DPV1126 (08/23/1999) - Eliminate some reserved words
	;  AK390   (08/20/1999) - CCS#48: UNION in subquery
	;  AK380   (07/08/1999) - CCS#37: OUTER JOIN with expression
	;  AK366   (05/25/1999) - CCS: Fix view modification
	;  DPV1060 (05/10/1999) - Fix deferred compile mode and ODBC Prepare query compiles
	;  DPV1007 (03/17/1999) - Preserve '_' in identifier names
	;  AK353   (02/01/1999) - UNION of SELECT
	;  AK351   (01/28/1999) - CCS: Correct external AS-list
	;  AK344   (12/29/1998) - {oj} as a FROM element
	;  AK335   (11/02/1998) - Empty string and NULL
	;  MRP732  (10/30/98)   - Support Standard Syntax: CREATE VIEW <view-name> [<column-list>) AS ...
	;  AK326   (07/23/98)   - Replace ?<pat> with %PATTERN <const>
	;  AK325   (07/21/98)   - Korea: Allow spaces in $$ a ^ b ()
	;  MRP707  (09/05/97)   - Fix Problem with General View ALIAS
	;  MRP706  (08/28/97)   - Fix SELECT V1.Alias, V2.Alias Join Problem
	;  MRP686  (04/24/97)   - Fix Multiple JOIN Conditions in JOINed General Views
	;  MRP684  (04/18/97)   - Fix Field SELECTion for General View
	;  MRP683  (04/15/97)   - General View Validation
	;  MRP682  (04/10/97)   - Use Aliased Fields Properly in General Views
	;  MRP676  (02/26/97)   - Support ODBC OUTER JOIN Syntax
	;  MRP570  (12/30/96)   - Transaction Processing/Environment Setting
	;  MRP658  (12/02/96)   - Handle <owner>.<catalog>.<schema>.<table> 
	;  MRP657  (12/02/96)   - Remove Leading Underscore from Identifiers For Client
	;  MRP648  (10/07/96)   - Fix General View JOINing Problem
	;  DPV654  (08/01/96)   - Make $$ALPHAUP a local call
	;  MRP642  (09/18/96)   - Robust Stored Procedure Information
	;  MRP612  (06/01/96)   - Support SQL92 NATURAL JOIN
	;  MRP611  (06/01/96)   - Support SQL92 CROSS JOIN
	;  MRP597  (03/03/96)   - Consolidate the SQL Reserved Word List
	;  MRP590  (03/21/96)   - Fix General View Qualification
	;  MRP589  (03/20/96)   - Confirm Cardinality Match between SELECT-list & INTO-list
	;  MRP560  (12/12/95)   - Support General_View_Alias.Field
	;  MRP535  (10/20/95)   - Support SET <field> = <value expression>
	;  MRP528  (08/28/95)   - Support View.Field
	;  AK277   (08/01/95)   - Fix Exponential notation in tag expo
	;  MIT056  (07/21/95)   - Check for aggr and distinct in FROM subqueries
	;  MIT054  (07/18/95)   - Check for fields in expressions, containing aggregates
	;  MRP451  (10/14/94)   - Allow Pattern Match agains :@variable
	;  MRP397  (05/04/94)   - Support the SQL Concatenation operator ||
	;  DPV177  (04/26/94)   - Make routine's INT code < 14K.  Clean up rtn.
	;  MRP393  (04/11/94)   - NEW 'likepat', 'likeerr', & 'likeesc'..
	;  MRP380  (03/08/94)   - Reference the common directory when setting-up
	;                         mtc(0,0,"tables",... information
	;  MRP347  (10/28/93)   - ODBC Support: Reference the proper directory
	;                         where the table is located
	;  MRP319  (07/31/93)   - Add General Views to the info list of
	;                         mtc(0,0,"table",...
	;
	;  AK059;AK062;AK076;EYT098;EYT099;AK171;MRP121;MRP124;MRP129
	;  AK186;EYT155;MRP165;ALL006;MRP201;MRP270;AK234;AK248;AK251
	;  AK252;MRP289;MRP290;MRP293;AK265
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
	;  Parser variables
	;  ----------------
	;  token,value,lower,%delid - implicitly return lext token information
	;  sql,line,p,f - used internally by lext as state information
	;  variables used throughout to implicitly pass info to/from functions:
	;    val - current val#
	;    name - current name resulting from parsing
	;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	n c,f,label,likeerr,likeesc,likepat,line,lineprev,logic,lower,m,mask,more,n,name,p,pprev,prevtoken,rest,rw,sql,sldst,switch,token,val,value,i,ext,setqexp,jointype,tsq,firsttbl,lexp
	new cteQBm,cteWQNList
	set cteWQNList=""  // A $LIST(...) stack of 'withQryName' values for each invocation to the 'ctefrmit(...)' method!
	set cteQBm=0       // The current CTE query block (m+1)
	n lat s lat=""  ;  $e(lat,m)=1 if inside a LATERAL from-item  ;  AK850
	n floc s floc=""  ;  AK862
	n checkedStats s checkedStats=""	; only want to check if the table stats in smd is valid for each table once
	kill $$$ptlnRoot // Just in case, we used to NEW ptln here
	s line=0,more=0,f=0,p=0,sql=input,$$$mtPActiveQbs=""
	d first:'input,lext
	#; AK351
	#;  set $LIST of the external AS-list into mt("as"/"AS",n) where n
	#;       is the coming subquery - used in as^slx
	#;  allow for "AS" after the list (eventually will be mandatory)
	If callname["view" // PVA302: only look for this during execution of CREATE VIEW
	{   set lexp=$$lexmark() // Look ahead to break ambiguity, so (SELECT will not be parsed as (<identifier>
		if $$check("(") 
		{  if token'="ID" {d lexgo(lexp) } // PVA302: go back if not ID
		   else 
		   {  s n=$$$mtPNumQbs+1 
		      f i=1:1 s $li($$$mtAliases(n),i)=$g(lower),$li($$$mtAlphaUpAliases(n),i)=$g(value) $$$lexskip("ID") i '$$check(",") $$$lexskip(")") i $$check("AS")||1 q
		      #;  If compiling a view, record the number of items in the AS list to compare with the actual number of
		      #;  columns in the view's query and report an error if there is a difference.
		      s mtc(0,0,"number of AS")=$ll($$$mtAlphaUpAliases(n))	// DPV2142=
		   }
		}
	}
	#; AK351-
	s $$$mtStatementType=$e(token,1,3) // this setting may be overridden in stat^%qaqpsq1
	#; Handle Deferred Compilation Mode
	i $g(^mtemp2($namespace,"Deferred Compile Mode")),'(",CRE,ALT,DRO,SET,"[(","_$$$mtStatementType_",")) d CompileDeferredList^%apiDDL2(.SQLCODE) QUIT:SQLCODE<0
	set:$g(value)="START" $$$mtStatementType=value  ; START TRANSACTION
	set:$g(value)="%INTRANSACTION" $$$mtStatementType=value  ; %INTRANSACTION
	set:$g(value)="USE" $$$mtStatementType="USD"
	#; PVA320: quit if valid frozen plan found
	do stat^%qaqpsq1 QUIT:callname="tablist"  QUIT:fplan  // DPV3227
	RETURN:$$$mtStatementType="THR" // THROUGH statement
	if '$g($$$mtExplain) { do error(25):token'=V }  // Pass-through for <explain statement>!
	d chckcard^%qaqpqo ; Check SELECT-list/INTO-list Cardinality Match
		// AK405+
		#;  reassign the sorted parameters
	new jj,len,pn,varType
	set jj="",pn=0
	for  {
		set jj=$o($$$mtRecordParams(jj)) quit:jj=""
		set val=$$$mtRecordParams(jj),name=$e($$$mtV(val),3,*),pn=pn+1
		set:name="?" name=$s($get(%msqlvarcparm)="":"%parm("_pn_")",$e(%msqlvarcparm,*)'="(":%msqlvarcparm_pn,1:%msqlvarcparm_pn_")"),$$$mtV(val)="x^"_name  ;  dynamic
		if info { set mtc(0,0,"parameter","val",val)=pn,mtc(0,0,"parameter",pn)=name_$c(1)_val }
			#; If there are any parameters defined in mt("options","DynamicSQLTypeList"), these were from the dynamic SQL preparser.  We should have type information about
			#; the type of literal the host variabele replaced.  The preparser defines the parameters in mt("options","DynamicSQLTypeList") in order as they appear in the SQL text, so
			#; we use this opportunity to type the variables here in the proper order.
		if $p($g(mt("options","DynamicSQLTypeList")),",",pn) {
			kill len
			set varType=$$paramType($p(mt("options","DynamicSQLTypeList"),",",pn),.len)
			if $g(varType)'="" {
				do create^%qaqpdt(val,"var",varType,,,,name) 
				if info {
					if $d(len) { set $$$VTRomsinfo(val)=$$definfo^%qaqpif2(varType,len,len) }
					elseif varType="%Library.Numeric" { set $$$VTRomsinfo(val)=$$definfo^%qaqpif2(varType,20,18,9),$$$VTRscale(val)=9 }
					else { set $$$VTRomsinfo(val)=$$definfo^%qaqpif2(varType) }
				}
			}
		}
	}
	set:info mtc(0,0,"parameter")=pn
		// AK405-
	kill $$$ptlnRoot
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
paramType(type,&len) [] PUBLIC {
		#;   type values
		#;     CAST_CHAR32 = 1
		#;     CAST_CHAR128 = 2
		#;     CAST_CHAR512 = 3
		#;     CAST_CHAR = 4
		#;     CAST_INT = 10
		#;     CAST_NUM = 11
	QUIT:type="" ""
	if type=1  { set datatype="%Library.String",len=32   QUIT datatype }
	if type=2  { set datatype="%Library.String",len=128  QUIT datatype }
	if type=3  { set datatype="%Library.String",len=512  QUIT datatype }
	if type=4  { set datatype="%Library.String",len=4096 QUIT datatype }
	if type=10 { set datatype="%Library.Integer"         QUIT datatype }
	if type=11 { set datatype="%Library.Numeric"         QUIT datatype }
	QUIT ""
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
query(supq,one,csupq)  ;  <query> ::= <qterm> { UNION [ ALL ] | INTERSECT | EXCEPT [ <corr> ] <qterm> }
	#;  supq - parent q#, one=1 if only one SELECT-item allowed
	#;  csupq - parent skipping FROM containment for correct outer reference checking
	#;  called from:  frmit+3, ^sql1(x2), ^selx(x2), ^pop(x2)
	#; JLF090
	n nsav s nsav=$g(negate) n negate s negate=0
	n:supq=csupq genview  //  PVA285: don't leak view/fromsubq processing into ordinary subqueries
	#; AK353
	d qterm(supq,one,csupq)
	#; AK390
	f  {
		$$$peekany(" UNION INTERSECT EXCEPT "){
			$$$lexcheck("UNION") d union
			$$$lexcheck("INTERSECT") d intersectexcept(0)
			$$$lexcheck("EXCEPT") d intersectexcept(1)
		} else {
			QUIT	
		}	
	}
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
union	new all,corr,un1,un2,unj  ;  process union
	#; DPV1490
	i $g(genview)'="" n genview
	s un1=$p($$$mtV(val),"^",2)  ;  un1 is first UNION q#
	s all=$e("da",$$check("ALL")+1),corr=$$corr()
	#; AK849
	if $$checkid("%PARALLEL"), '$$hasOffset(un1,1) {
		 // mark to run in parallel if there is no OFFSET in the first leg or its subquery
		set $$$mtUnionTopDSN(un1)=$lb(" "," "),$$$mtDSNLinkedTable(un1)=" "
	}
	#; PVA050: new csupq arg to qterm (comes from query that calls union)
	d qterm(supq,one,csupq),docorr
	s un2=$p($$$mtV(val),"^",2),mt("union",un1)=$g(mt("union",un1))_$lb(un2_all)
	if $d(mt("unh",un1)),$$hasOffset(un2,1) { // remove parallel if there is OFFSET in the second leg or its subquery
		kill $$$mtUnionTopDSN(un1),$$$mtDSNLinkedTable(un1)
	}
	#; AK572
	if "CRV ALV"'[$$$mtStatementType,$d($$$mtAlphaUpAliases(un1))#2,$d($$$mtAlphaUpAliases(un2))#2 { do error(9):$ll($$$mtAlphaUpAliases(un1))'=$ll($$$mtAlphaUpAliases(un2)) }  ;  must be same size
	s $$$mtUnionTopQb(un1)=un1,$$$mtUnionTopQb(un2)=un1  ;  top for whole level
	#; AK849
	f unj=un1+1:1:$$$mtPNumQbs s:$g($$$mtUnionTopQb(unj))=un2 $$$mtUnionTopQb(unj)=un1 s:$g($$$mtDSNLinkedTable(un1))=" " $$$mtDSNLinkedTable(unj)=" "
	s val=$$$mtPQbVal($$$mtP(un1))  ;  return val# of un1
		#; Record the fields involved in the select lists of the unions.  Later in %qaqpifo, we can go through and make sure
		#; we have the best type information from all legs of the union. (DPV3128)
	s $$$mtUnionLegVals(un1)=$ListFromString($e($$$mtOutputVals($$$mtOutput(un1)),1,*-1)),$$$mtUnionLegVals(un2)=$ListFromString($e($$$mtOutputVals($$$mtOutput(un2)),1,*-1))	// DPV3128
	#; AK390-
	QUIT	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
intersectexcept(isExcept=0)	
	n q1,q2,q2Val,all,corr
	s q1=$p($$$mtV(val),"^",2)  ;  q1 is first intersect/except q#
	d pushdownQb(q1)
	set all="d" ;s all=$e("da",$$check("ALL")+1)
	n val
	s corr=$$corr()
	d qterm(q1,one,q1),docorr 
	s q2=$p($$$mtV(val),"^",2),q2Val=val ;  q2 is 2nd intersect/except q#, q2Val is the mt("v") entry for q2
	if "CRV ALV"'[$$$mtStatementType,$d($$$mtAlphaUpAliases(q1))#2,$d($$$mtAlphaUpAliases(q2))#2 { do error2(9,$s(isExcept:"EXCEPT",1:"INTERSECT")):$ll($$$mtAlphaUpAliases(q1))'=$ll($$$mtAlphaUpAliases(q2)) }  ;  must be same size
	new oIncG ; if group by exist and output includes group by, we don't need to add distinct
	if $g($$$mtGroupDistinctList(q1)) {
		set oIncG=1
		for i=1:1:($l($$$mtGroupDistinctList(q1),",")-1){
			if (","_$$$mtOutputVals($$$mtOutput(q1)))'[(","_$p($$$mtGroupDistinctList(q1),",",i)) {
				set oIncG=0
				quit
			}
		}
	} else {
		set oIncG=0 ; we don't have group by, we need to add "d" in the code below
	}
	if (all = "d")&&('$g($$$mtOneRow(q1)))&&('oIncG) { ; if there is only one row, we don't need to apply distinct
		; if we have intersect or except without ALL, we need to distinct the output if there is no group by
		if $d($$$mtGroupDistinctList(q1)) {
			s $$$mtIntersectExceptDist(q1)=$$$mtOutputVals($$$mtOutput(q1))
		} else {
			s $$$mtOutputDistinct($$$mtOutput(q1))="d"
			s $$$mtDistinct(q1)=""
		}
	}
	; similar to opsome^%qaqpop("=","SOME",every output in q2) 
	n qnum,unj,op,val2,q1Nvals
	set op="="
	s q2Val=$$preserveRows^%qaqpop(q2Val,q1,1)
	s q2=$p($$$mtV(q2Val),"^",2)
	s $$$mtIntersectExcept(q1,q2)=$s(isExcept:"e",1:"i")
	d adcorrs(q2,$$$mtOutputVals($$$mtOutput(q1)),.q1Nvals)
	d top1^%qaqpop(q2)
	#;  for UNION, apply to the whole UNION level (also flatten it!)
	f unj=q2+1:1:$$$mtPNumQbs {
		d:$g($$$mtUnionTopQb(unj))=q2 adcorrs(unj,$$$mtOutputVals($$$mtOutput(q1)),q1Nvals),top1^%qaqpop(unj) 
	}
	d unflat^%qaqpop(q2)
	; for intersect and except, we don't need to add $p(5) here, since we don't need to test $p(5) is not null 
	; and these n nodes should be evaluated in subq^%qaqcpr
	d putlog("v^FOR SOME^^"_q2Val_"^") 
	d:isExcept not^%qaqpop 
	new gIncO ; group include output
	set gIncO=1
	for i=1:1:($l($$$mtOutputVals($$$mtOutput(q1)),",")-1){
		if (","_$g($$$mtGroupDistinctList(q1)))'[(","_$p($$$mtOutputVals($$$mtOutput(q1)),",",i)) {
			set gIncO=0
			quit
		}
	}
	d andwhav^%qaqpop(val,q1,$s($$$mtPAggList($$$mtP(q1))="":"w",gIncO:"w",1:"h"))
	RETURN
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adcorrs(qnum,q1Output="",q1Nvals="") ; for except and intersect
	new i,q2Output,gIncO,eq,n1,n2,n12,nval,hasNvals
	set q2Output = $$$mtOutputVals($$$mtOutput(qnum)),hasNvals=(q1Nvals'="")
	set gIncO=1
	for i=1:1:($l(q2Output,",")-1){
		if (","_$g($$$mtGroupDistinctList(qnum)))'[(","_$p(q2Output,",",i)) {
			set gIncO=0
			quit
		}
	}
	for i=1:1:($l(q1Output,",")-1){
		if hasNvals {
			set nval=$p(q1Nvals,",",i)
		} else {
			d putval("n^^^"_$p(q1Output,",",i)_"^") 
			set nval=val
			set q1Nvals=q1Nvals_val_","
		}
		d putlog("v^"_op_"^^"_nval_"^"_$p(q2Output,",",i)_"^")
		set eq=val
		d putlog("v^NULL^^"_nval_"^")
		set n1=val
		d putlog("v^NULL^^"_$p(q2Output,",",i)_"^")
		set n2=val
		d putlog("l^&^^"_n1_"^"_n2_"^")
		set n12=val
		d putlog("l^!^^"_eq_"^"_val_"^")
		; knownAtCompileTime could prune these null condition if the $p(q1Output/q2Output,",",i) cannot be null
		d andwhav^%qaqpop(val,qnum,$s($$$mtPAggList($$$mtP(qnum))="":"w",gIncO:"w",1:"h"))
	}
	d noutput^%qaqpop(qnum) 
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#; preserve rows in query block qb to a new query block, 
#; set qb to another query layer (wrap the new query block) if it has TOP or other constructs (window functions)
pushdownQb(qb) 
	RETURN:info
	new i,haswindows,oval
	for i=1:1:($l($$$mtOutputVals($$$mtOutput(qb)),",")-1){
		s oval = +$p($$$mtOutputVals($$$mtOutput(qb)),",",i)
		s haswindows = +$$windows^%qaqpagg(oval)
		quit:haswindows
	}
	RETURN:('$$hasPagination(qb))&&('$g(haswindows))&&('$d($$$mtUnion(qb)))
	new entries,entry,newqb,ptr,val
	set entries=$lb("from","corr","dups","dupsv","eleblk","shtop","shardext","dsn","unh","g","gsynth","o","c","w","h","empty","onerow","ON","s","AS","as","distinct","toplimit","top","hint","hintsave","usef","union","unh","unflds","ieDist","IntersectExcept")
	set ptr=0
	set $$$mtPActiveQbs=$$$mtPActiveQbs_1,newqb=$$$mtPNumQbs
	while $LISTNEXT(entries,ptr,entry) {
		continue:'$d(mt(entry,qb))
		if $lf($lb("top","hint","hintsave","IntersectExcept"),entry) {
			merge mt(entry,newqb)=mt(entry,qb)
			continue:$lf($lb("hint","hintsave"),entry)
		} else { 
			if entry="shtop" {
				n shtop s shtop=$g(mt("shtop",qb))
				s:shtop mt("shtop",newqb)=$s(shtop=qb:newqb,1:$g(mt("shtop",+$$$mtP(qb))))
			} else {
				set mt(entry,newqb)=mt(entry,qb) 
			}
			continue:$lf($lb("usef","corr"),entry)
		}
		k mt(entry,qb)
	}
	n key,key1,key2,value
	set key=""
	f  {
		s key=$o($$$mtUnionTopQb(key),1,value) 
		q:key="" 
		if value=qb {
			set $$$mtUnionTopQb(key)=newqb
			if key=value {
			 	set $$$mtUnionTopQb(newqb)=$$$mtUnionTopQb(key)
			 	k $$$mtUnionTopQb(key)
			}
		} 
		
	}
	set key=""
	f  {
		s key=$o($$$mtFromTableName(key)) 
		q:key="" 
		if $p(key,"^",1)=qb {
			s $$$mtFromTableName(newqb_"^"_$p(key,"^",2))=$$$mtFromTableName(key)
			k $$$mtFromTableName(key)
		} 
		
	}
	set key=""
	f  {
		s key=$o($$$mtFLabelsQbNode(key)) 
		q:key="" 
		if key=qb {
			set key1=""
			f {
				s key1=$o($$$mtFLabelsSaveNode(key,key1)) 
				q:key1=""
				set key2=""
				f {
					s key2=$o($$$mtFLabels(key,key1,key2)) 
					q:key2=""
					set $$$mtFLabels(newqb,key1,newqb_"^"_$p(key2,"^",2))=$$$mtFLabels(key,key1,key2)
					k $$$mtFLabels(key,key1,key2)
				}
			}
		} 
		
	}
	set key=""
	f  {
		s key=$o($$$mtV(key)) 
		q:key="" 
		continue:$$$mtVType($$$mtV(key))'="f"
		if $p($$$mtV(key),"^",2)=qb {
			s $p($$$mtV(key),"^",2)=newqb
		}
		
	}
	set key=""
	f  {
		s key=$o($$$mtP(key)) 
		q:key="" 
		if +$$$mtP(key)=qb {
			// point subquery of qb to new qb
			s $$$mtPQbParent($$$mtP(key))=newqb
		} elseif ((+$$$mtP(qb))=(+$$$mtP(key)))&&(qb'=key){
			// point the query with same level of qb to qb (for example: union)
			s $$$mtPQbParent($$$mtP(key))=qb
		}
		
	}
	new m
	set m=qb // vstr needs
	for i=1:1:($l($$$mtOutputVals($$$mtOutput(newqb)),",")-1){
		d addvinf^%qaqpslx(newqb,$p($$$mtOutputVals($$$mtOutput(newqb)),",",i),$li($$$mtAlphaUpAliases(newqb),i))
	} 
	n nm,label,xqlbl,name
	set name=newqb
	s nm="tsq"_$i(tsq)_"%",label=$li(%defschema)_"."_nm,xqlbl=$lb(nm,label,0)
	set val=$o(mt("v"),-1) // vstr needs
	d vstr^%qaqpsq
	for i=1:1:($l($$$mtOutputVals($$$mtOutput(newqb)),",")-1){
			s $$$mtOutput(m)=$g($$$mtOutput(m))_$li(%viewinfo("vcols",newqb,$li($$$mtAlphaUpAliases(newqb),i)),2)_","
	   		s $$$mtAlphaUpAliases(m)=$li($$$mtAlphaUpAliases(newqb),i)
	}
	s $$$mtAlphaUpAliases(m)=$$$mtAlphaUpAliases(newqb)
	s $$$mtOutput(m)="^"_$$$mtOutput(m) 
	d putval("q^"_newqb)
	s $p($$$mtP(newqb),"^",1,2)=qb_"^"_val
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
corr()	;  <corr> ::= CORRESPONDING [ BY <flist> ]
	#;  $$: return NULL, $LB("*") for no BY, or $LB(FNAME)
	QUIT ""  ;  not implemented yet
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
docorr	;  prune and reorder SELECT-lists of un1, un2 based on corr
	QUIT  ;  not implemented yet - noop for now
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
qterm(supq,one,csupq)  ;  <qterm> ::= ( <query> ) | <selex>
	$$$lexcheck("(") d query(supq,one,csupq) $$$lexskip(")") QUIT
	n m,val1,op,levag,laggs,switch
	#;  $$$mtPActiveQbs is a string of 1's, $e(,m)=0 if subquery obsolete
	s levag=0,laggs="",$$$mtPActiveQbs=$$$mtPActiveQbs_1,m=$$$mtPNumQbs
	s $$$mtP(m)=supq  ; MRP121 The first piece of many to be added later
	s $$$mtCorrParentQb(m)=csupq
	#; PVA342: remove AK938 change here, cannot know the correct setting till
	#;   both cosharding and outer joins have been analyzed
	n group,having,where s group=0,having=0,where=0  ;  group=1 while in GROUP BY, having=1 while in HAVING, where=1 while in WHERE/FROM (agg's not allowed when where=1)
selex	;  <selex> ::= SELECT <selst> FROM <tables>
	#;  [ WHERE <prdct> ] [ GROUP BY <LIST,colmn> ] [ HAVING <prdct> ]
	#; AK353-
	#;  processing FROM before SELECT!
	#; AK637
	#;  process FROM, if none use %TSQL_sys.snf
	i '$$from() s name="%TSQL_sys.snf",$$$mtFromTableName(m_"^"_name)=name,$$$mtFLabels(m,"snf",m_"^"_name)=$lb(name,0),$$$mtFromList(m)=$lb(name),$$$mtDSNConnection="" i $$$smdLoadGetIrn(name)  ;  DPV3196;AK862
	#; AK395
	#;  if external table, save SELECT location
	i extab d mark^%qaqpslx s mt("seloc")=$LB(l1,m1)
	#; AK395-
	#; AK703
	s $$$mtCorrFieldUsed(m)=0  ;  to record correlated field use, for "onerow"
	$$$lexskip("SELECT")
	d selct^%qaqpslx()  ;  process SELECT, etc.
	#; AK637-
	#;  remove AS nodes from outer-most SELECT-list
	#; AK399AK446
	d noas(m):'$$$mtP(m)  ;  should never have them in the first place!
	#;  further processing,imply,putval moved from ^selx
	#; ========================= Further Processing ====================
	#; AK531
	#;  imply agg(%FOREACH) if GROUP BY, imply "onerow" if HAVING or
	#;      aggregates, but not if SELECT DISTINCT BY() explicitly used
	i $g($$$mtDistinct(m))="",laggs d imply
	#; AK531-
	s:$g($$$mtGroupDistinctList(m)) $p($$$mtOutput(m),"^")="d"
	#; AK366
	#;  *** this really should have been killed in frmit, kept until here
	#;      temporarily to support selex+7 above (SELECT * FROM view)
	f n=1:1:$$$mtPNumQbs i $$$mtPQbIsActive(n)=0,m=+$$$mtP(n) k $$$mtOutput(n)
	#; AK366-
	$$$lexputval("q^"_m)
	s $p($$$mtP(m),"^",2,4)=val_"^"_laggs_"^"  ;MRP121 Set remaining pieces here
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK743
	#; PVA198: make jj an argument, maintain anyset: whether any actual change made
nuljj(n,jj) n ii,v,nv  ;  [public: mt,anyset] set the jj-th SELECT-item of subquery
	#;  n to NULL, but not if in $$$mtSequencersQb(n), recurse to UNION legs, but not
	#;  to anything before the last UNION DISTINCT, including n itself
	f ii=$ll($g($$$mtUnion(n))):-1:1 s v=$li($$$mtUnion(n),ii) RETURN:v["d"  d nuljj(+v,jj)
	s v=$$$mtOutputVals($$$mtOutput(n))
	#; AK834
	QUIT:","_$tr($g($$$mtSequencersQb(n)),"d")[(","_$p(v,",",jj)_",")  ;  not if in ORDER BY
	s nv=$$getnul() s:$p(v,",",jj)'=nv anyset=1,$p(v,",",jj)=nv,$$$mtOutputVals($$$mtOutput(n))=v
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getnul()  ;  $$:  val# for NULL constant - generate it if doesn't exist already
	s:'$d(mt("var","nul")) $$$mtV($$$newvar("nul",0,0))="t^"
	QUIT $$$VarNum("nul")
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK743-
parseIndexRef(pAllowStar=1)
	#; Syntax:
	#;
	#;		ignoreHint	:== { %IGNOREINDEX | %IGNOREINDICES } indexRefs
	#;		indexRefs	:== indexRef [ , indexRefs ]
	#;		indexRef	:== [[ schema . ] table . ] { indexName | * }	// * only allowed if pAllowStar is TRUE
	#;
	if pAllowStar,$$check("*") { QUIT "*" }
	new ixname 
	set ixname=value
	do skip("ID")
	if $$check(".")
	{	if pAllowStar,$$check("*") { QUIT ixname_".*" }
		set:token="ID" ixname = ixname_"."_value
		do skip("ID")
	}
	if $$check(".")
	{	if pAllowStar,$$check("*") { QUIT ixname_".*" }
		set:token="ID" ixname = ixname_"."_value
		do skip("ID")
	}
	QUIT ixname
	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; YCL338	
parseTableRef()
	#; Syntax:
	#;
	#;		ignoreHint	:== { %NOFIXEDSTATS } tableRefs
	#;		tableRefs ::= tableRef {, tableRef }
	#;		tableRef :== * |  schema.* | [ schema .] table
	#;
	if $$check("*") { RETURN "*" }
	new tblname 
	set tblname=value
	do skip("ID")
	if $$check(".")
	{	if $$check("*") { QUIT tblname_".*" }
		set:token="ID" tblname = tblname_"."_value
		do skip("ID")
	}
	QUIT tblname
	#; AK637
	#; For UPDATE/DELETE, skip forward and process FROM, if any, then process the target table name
	#; Returns 1 if a FROM clause was found, 0 otherwise.
udfrom()   
	new csupq,frmit,iudtarg,udf
	set udf="",csupq=0
	set udf=$$from()  ;  record end of FROM clause in 'switch'
		#;  udf=1 means FROM clause found, processing target table now
	set iudtarg=1  // PVA349: prohibit TVFs, JSON_TABLE, and <jtab> from being accepted
	set frmit=$$frmit()  ;  process the target table name based on the FROM findings
		#; If this ia TRUNCATE and not a simple table or view, report an error (view has to be updateable, but that is reported elsewhere)
	if frmit>1,$$$mtKTruncateFlag($g($$$mtK))=1 { do error("30h") }
	set:frmit["2" $$$mtKIudSubquery($$$mtK)=1	// DPV3702= UPDATE/DELETE target is a subquery
	set $$$mtTarget="1^"_label
	RETURN udf
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; This function skips forward to the applicable FROM clause, parses it, records
	#; the final location in 'switch' variable, then moves back to the location at which we started this function to resume
	#; parsing SELECT list etc. This lets us parse/get info about the tables in the query up front, even though
	#; FROM does not come first in the statement (QUEL fans roll your eyes.)
	#;
	#; Returns: 
	#;	1 if FROM clause found, for SELECT/UPDATE/DELETE -
	#;	0 if not found
from()
	new inONClause,lexp	 ; PVA087: undefine inONClause at beginning of any FROM clause
	set lexp = $$lexmark()  ;  save current location
	set val = 0
	set:'$g(%mmmNo28Check) %mmmNo28Check=10	// Don't report error for ":" separator in JSON_OBJECT(key:value) function
	new jsonParen,%mmmJSONOBJECT,%mmmNoDelidCheckSave
	if '$d(%mmmNoDelidCheck) { 
		new %mmmNoDelidCheck 
		set %mmmNoDelidCheck = 1 
	} else { 
		set %mmmNoDelidCheckSave = %mmmNoDelidCheck 
		set %mmmNoDelidCheck = 1 
	}
	// find the FROM-clause (AK186 - but skip FROM in subqueries!)
	for {
		QUIT:token=V||(token=";")  // end of statement (CREATE PROC may have statements end using the ";" token)
		set:token="("||(token="$$") val=val+1 
		if token=")" { 
			set val = val-1
			QUIT:val<0
		} 
		do lext
		if val=0, (token="FROM") || (token="UNION") || (token="INTERSECT") || (token="EXCEPT") {
			QUIT
		}
		do JSONParm^%qaqpsq(token,value,.jsonParen)
	}
	do:val>0 error(202) // one or more opening parentheses '(' did not find a match before FROM or end of statement
	kill:%mmmNo28Check=10 %mmmNo28Check
	if $d(%mmmNoDelidCheckSave) { 
		set %mmmNoDelidCheck = %mmmNoDelidCheckSave 
		kill %mmmNoDelidCheckSave 
	} else { 
		kill %mmmNoDelidCheck 
	}
	if (val<0) || $case(token,V:1,"UNION":1,"INTERSECT":1,"EXCEPT":1,";":1,:0) { 
		// no FROM clause found - must be optional!
		do lexgo(lexp) 
		set switch="" 
		RETURN 0 
	}
	do lext  // we're pointing at the 'FROM', lext past it
	new hint
	for {	// parse any hints after 'FROM'
		set hint="" $$$lexany(" %ALLINDEX %DBUGFULL %FIRSTTABLE %FLATTEN %FULL %IGNOREINDEX %IGNOREINDICES %INORDER %NOBSL %NOFACTORORDERBYOR %NOFIXEDSTATS %NOFLATTEN %NOMERGE %NOMERGEEQUIVAGG %NOPARALLEL %NOREDUCE %NOSVSO %NOTOPOPT %NOUNIONOROPT %PARALLEL %STARTTABLE ",hint)
		QUIT:hint=""
		if hint="%FIRSTTABLE" { // PVA262
			set mt("hint",m,hint) = value
			do skip("ID") 
		} elseif hint="%NOFIXEDSTATS" { 
			for { 
				set mt("hint","%NOFIXEDSTATS") = $g(mt("hint","%NOFIXEDSTATS"))_$lb($zconvert($$parseTableRef(),"U"))
				QUIT:'$$check(",")
			}
		} elseif ",%IGNOREINDICES,%IGNOREINDEX,"'[(","_hint_",") { 
			set mt("hint",m,hint) = 1 
		} else { 
			for { 
				set mt("hint",m,"%IGNOREINDEX") = $g(mt("hint",m,"%IGNOREINDEX"))_$lb($zconvert($$parseIndexRef(),"U")) 
				QUIT:'$$check(",")
			} 
		}
		set:(hint="%INORDER"||(hint="%STARTTABLE")||(hint="%FIRSTTABLE")) mts("streamorder",m)=""
		set:hint="%FULL" mts("fromopts",m)="f"
		set:hint="%DBUGFULL" mts("fromopts",m)="d"
	}
	#; JLF003-
	#; PVA027-
	// parse table names and labels and get the info into $$$smd
	do tables
	// while here, make sure whatever comes after the table list is a valid clause for that position
	if '$$peekany(" WHERE %PARTITION GROUP HAVING UNION ) ; WITH FOR SHARD INTERSECT EXCEPT PARTITION FETCH "_V_" ") && '$$peekanyid(" ORDER LIMIT OFFSET ") {
		// PVA126 - improve error; JLF148 - added ORDER; PVA204 - treat ORDER as an identifier, not reserved token)
		do error(25)
	}
	#;  save location immediately after table list and back-up to process SELECT, etc.
	set switch = $$lexmark() 
	do lexgo(lexp)
	RETURN 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
lexmark()  ;  $$:  current lexical context, to be used in lexgo()/switch()
	#;  use $l(sql)-p, because line may start w/ overflow chars from line-1
	QUIT line_"^"_($l(sql)-p)_"^"_token_"^"_(p-f)_"^"_%delid_"^"_$g(value)_"^"_$g(lower) // PVA302: value, lower may not be defined
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
lexgo(x="")  ;  restore lexical context x, saved by $$lexmark()
	QUIT:x=""  ;  store only, no status change right now
	i line'=+x s line=x-1,p=0 d newln
	s p=$l(sql)-$p(x,"^",2),token=$p(x,"^",3),f=p-$p(x,"^",4),%delid=$p(x,"^",5),value=$p(x,"^",6),lower=$p(x,"^",7)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK637-
switch(x) ;
	#;  lexical context switch - store in "switch" current state,
	#;  change to state as specified by x (if not NULL).
	#; AK637
	s switch=$$lexmark() d lexgo($g(x))
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tables	; Spin through all the tables here
	#; AK344
	n where s where=1  ;  <tables> ::= <tref> { , <tref> }
	f  d tref $$$lexnotcheck(",",QUIT)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tref	;  <tref> ::= <jtab> | "{" oj <jtab> "}"
	;  should be skipid("OJ") - here we're assuming it's "OJ"
	$$$lexcheck("{") $$$lexskip("ID") d jtab() $$$lexskip("}") QUIT  ;  ODBC oj escape
	d jtab()
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA105: add badj argument
jtab(sv,badj) n frmtype,svfirsttbl,svbadj  ;  <jtab> ::= <frmit> { <join> }
	#;  returns: 0 - simple table ref; 1 - view; 2 - table subquery;
	#;      3 - join expression; "s1"/"s2" - streamed view/subquery
	#;  sv=1 forces a view or subqeury to be streamed
	#;  badj is optional and should normally be passed by reference. It indicates whether any USING or NATURAL
	#;       joins were found. Join expressions containing these are not currently supported as an
	#;       argument of OUTER JOIN ... ON.
	#;  PVA104: manage firsttbl to control scope of FROM clause resolution
	s svfirsttbl=$g(firsttbl(m),1),svbadj=$g(badj,0),badj=0
	s firsttbl(m)=$ll($g($$$mtFromList(m)))+1 // PVA104: save beginning of scope for ON clauses
	s frmtype=$$frmit($g(sv),.badj)
	#;  apply join expressions - for now, they cannot be streamed
	f  QUIT:'$$join(frmtype,.badj)  s frmtype=3
	s firsttbl(m)=svfirsttbl,badj=svbadj||badj
	if m=1{
		#; we only want single table in the FROM for adding INTO i%%sqlcol()
		if info {
			set mtc(0,0,"only select star","tbl")=(frmtype=0)
		} else {
			set mt("only select star","tbl")=(frmtype=0)	
		}
	}
	QUIT frmtype
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA105: add badj argument
join(frmtype,badj)  ;  $$:  return 1 if any of them found
	#;  <join> ::= CROSS JOIN <frmit> | NATURAL <jop> <frmit> | <jop> <jtab> <jspec>
	#;  frmtype: type of frmit to the left
	#;  badj should be passed by reference. It indicates whether any USING or NATURAL
	#;       joins were found. Join expressions containing these are not currently supported as an
	#;       argument of OUTER JOIN ... ON.
	new lqlbl,nullbls,righttyp,rqlbl
	if $$checkid("CROSS") {
		do skip("JOIN")
		do frmit(0,.badj) 	// no join conditions so we can parse the right table and get out
		RETURN 1
	}
	new jop,lastTableOnLHS,leftSideLabel,rbadj 
	set leftSideLabel=label, rbadj=0
	set lastTableOnLHS = $ll($$$mtFromList(m))		// PVA105: need to track mt("from",m) idx of last table in left arg of join
	if $$checkid("NATURAL") {
			// We set badj so when natural() recurses to frmit()->jtab()->join(), we know we parsed a JOIN type that can't be paired with future non-LEFT outer joins
		set badj = 1 
		do:frmtype'=0 error(94)
		do:'$$jtype() skipid("JOIN")
		do natural 
		RETURN 1
	}
	if '$$jtype() {
		RETURN:'$$checkid("JOIN") 0		;  no join operation found
	}
	#; PVA105: Allow ROJ into anything unless it contains a 'bad' join type
	if (jop="RIGHT"||(jop="FULL")), badj {
		do error(94)
	}
	#; PVA105: No longer need to force any special processing in jtab for left join.
	set righttyp = $$jtab(0, .rbadj)	//	rbadj - 1/0 if there are problem joins in right side argument of this join
	if (jop="LEFT"||(jop="FULL")), rbadj {
		do error(94)
	}
	set:rbadj badj=1
	#;  <jspec> ::= ON <jcond> | USING ( <jlist> )
	#;  <jcond> ::= <prdct>  ;  only ANDed =conditions, apply jop
	new cols,fname,lastTableOnRHS,rightSideLabel
	set cols = ""
	set rightSideLabel = label
	#; PVA087: Save aside all ON clauses for later analysis.
	#;         'Outer' tag becomes obsolete.
	set lastTableOnRHS = $ll($$$mtFromList(m))
	if $$checkid("ON") {
		set inONClause = "" // PVA087: disable arrow and legacy outer join in ON clause
		do prdct^%qaqpslx()
		kill inONClause
		  #; PVA128: Set mt("ojtab") for null padded streams
		  #; PVA092: buildt new mt("ON",) structure. 
		  #; PVA099: Now do for any LEFT join
		  #; PVA105: always use new structure
		do addJoinNodeToONClause(jop, val, lastTableOnLHS, lastTableOnRHS)
		RETURN 1
	}
	do skipid("USING"), skip("(")  ;  <jlist> ::= <fname> { , <fname> }
		;  only simple tables allowed. PVA164 added jop=FULL 
	if (frmtype'=0) || (righttyp'=0) || (jop="FULL") {
		do error(94)
	}
	#;  given a list of fields in both tables, apply jop to each pair
	#; PVA050: addImplicitJoinCondition now takes two lable arguments, which we obtain using ftolbl
	set lqlbl = $$ftolbl^%qaqpslx(m, leftSideLabel)
	set rqlbl = $$ftolbl^%qaqpslx(m, rightSideLabel)
	new andONCondition,implicitONCondition,useMtON
	set useMtON = ($d($$$FTByLabel(m_"^"_leftSideLabel)) || $d($$$FTByLabel(m_"^"_rightSideLabel)))
	set implicitONCondition = ""
	for {	; --- Parse <join colmn list> ---
		set fname = value 
		do skip("ID")
			// will set val
		do addImplicitJoinCondition(leftSideLabel, lqlbl, rightSideLabel, rqlbl, fname, useMtON, .implicitONCondition)
		QUIT:'$$check(",")
	}
	if useMtON {	// add the explicit ON join node represented by all the USING columns
		do addJoinNodeToONClause(jop, implicitONCondition, lastTableOnLHS, lastTableOnRHS)
	}
	set badj = 1
	do skip(")")
	RETURN 1
.
/// Called to add a join node to mt("ON",) structure for an ON clause join.
/// Parameters:
///		joinType						- type of join: INNER, LEFT, RIGHT, FULL. If RIGHT we will automatically flip it to left.
/// 										Note that the fromLength* parameters below should not be flipped before passing
///											in, they should represent the LHS and RHS as written in the SQL statement.
///		joinCondition					- the condition expression val# representing the join condition.
///		fromLengthBeforeRHSParse 		- number of tables in FROM list before parsing RHS arg of a given join. This functions
///											as the index in mt("from",m) that represents the last table of the LHS of the join.
///		fromLengthAfterRHSParse 		- number of tables in FROM list after parsing RHS arg of a given join. This functions
///											as the index in mt("from",m) that represents the last table of the RHS of the join.
addJoinNodeToONClause(joinType="INNER",joinCondition,fromLengthBeforeRHSParse,fromLengthAfterRHSParse) [firsttbl,info,mt,m] PRIVATE {
		// should be smarter about this and maybe pass in the lend stuff
	if joinType = "RIGHT" {
		set leftTableList = $li(mt("from",m),fromLengthBeforeRHSParse+1,fromLengthAfterRHSParse)
		set rightTableList = $li(mt("from",m),$g(firsttbl(m),1),fromLengthBeforeRHSParse)
		set joinType = "LEFT"
	} else {
		set leftTableList = $li(mt("from",m),$g(firsttbl(m),1),fromLengthBeforeRHSParse)
		set rightTableList = $li(mt("from",m),fromLengthBeforeRHSParse+1,fromLengthAfterRHSParse)
	}
	set:$e(joinCondition,*)'="^" joinCondition=joinCondition_"^" 	// The log# list for mt("ON") ($li(2)) has a trailing "^"
	set $$$mtOn(m,$i($$$mtOnCount)) = $lb(joinType,joinCondition,leftTableList,rightTableList)
	if info { 
		if (joinType="LEFT") {
			set nullbls = rightTableList
		} elseif joinType="FULL" {
			set nullbls = leftTableList_rightTableList
		}
		set:$d(nullbls) mt("ojtab") = $g(mt("ojtab"))_nullbls
	}
	RETURN 
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
jtype() ;  $$:  if any of them found return 1, and set jop to INNER/LEFT/RIGHT
	#;  <jtype> ::= [ INNER JOIN | LEFT [ OUTER ] JOIN | RIGHT [ OUTER ] JOIN ]
	#; PVA105: Parse FULL join 
	$$$lexany(" INNER LEFT RIGHT FULL ",jop) do  QUIT 1
	. i jop'="INNER" $$$lexcheckid("OUTER")  ;  noise word
	. $$$lexskipid("JOIN")
	s jop="INNER"
	QUIT 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
natural  ;  find all fields with identical names, apply jop to each pair
	#;  copied from $$joinchk^sql3
	do:jop="FULL" error(94)	 // PVA164
	new fname,ifn,implicitONCondition,lastTableOnRHS,leftirn,leftt,lefttv,lqlbl,rightSideLabel,riteirn,ritet,ritetv,rqlbl,useMtON
	set implicitONCondition = ""
	set leftt = $p($g($$$mtFromTableName(m_"^"_label)),"^")
	#; PVA082: use leftt, ritet in smdGetTType, rather than leftirn, riteirn
	set leftirn = $$$smdLoadGetIrn(leftt,$g($$$mtTvf(m,leftt)))
	set lefttv = $$$smdGetTType(leftt)
	do:$$frmit()'=0 error(94)  ;  for now, only simple tables allowed	// PVA004
	set lastTableOnRHS = $ll(mt("from",m))
	set rightSideLabel = label
	set ritet = $p($g($$$mtFromTableName(m_"^"_label)),"^")
	set riteirn = $$$smdLoadGetIrn(ritet,$g($$$mtTvf(m,ritet)))
	set ritetv=$$$smdGetTType(ritet)
	set fname = ""  ;  Find identical Field Names
	#; PVA050: get lqlbl, rqlbl now needed by fcond
	set lqlbl = $$ftolbl^%qaqpslx(m,leftSideLabel), rqlbl=$$ftolbl^%qaqpslx(m,rightSideLabel)
	set useMtON = ($d($$$FTByLabel(m_"^"_lqlbl)) || $d($$$FTByLabel(m_"^"_rqlbl)))
	for  set fname=$o($$$smd(lefttv,leftirn,"f",fname)) QUIT:fname=""  do:$d($$$smd(ritetv,riteirn,"f",fname))
	#; PVA003+ (next two lines)
	#; Don't match hidden columns, especially ID; if either matching name hidden, skip this match.
	#;   The implied semantic is that NATURAL JOIN sees same columns as SELECT *
	. set ifn=$$$smdGetIfn(1,leftirn,fname) QUIT:$$$smdColHidden(1,leftirn,ifn)="Y"
	. set ifn=$$$smdGetIfn(1,riteirn,fname) QUIT:$$$smdColHidden(1,riteirn,ifn)="Y"
	. do addImplicitJoinCondition(leftSideLabel,lqlbl,rightSideLabel,rqlbl,fname,useMtON,.implicitONCondition)
	if useMtON, implicitONCondition'="" {	// add the explicit ON join node represented by all the NATURAL columns
		do addJoinNodeToONClause(jop, implicitONCondition, lastTableOnLHS, lastTableOnRHS)
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	/// Represent JOIN condition on leftSideLabel.fname and rightSideLabel.fname for USING or NATURAL join syntax by
	/// adding condition to mt("l") representing an equality (or =* 'linx' condition). 
	///
	///	Parameters:
	///		leftSideLabel	- table label on left side of join
	///		lqlbl			- label returned by ftolbl(), referenced in %ptln, for left side table
	///		rightSideLabel	- table label on right side of join
	///		rqlbl			- label returned by ftolbl(), referenced in %ptln, for right side table
	///		fname			- field name on which to join
	///		useMtON			- 1/0, This will typically be 0 and is set to 1 by foreign table parsing. If true we are generating 
	/// 						an explicit ON clause join condition to be added with a JOIN node in mt("ON",). This 
	///							function will NOT add this condition to mt("ON") because it needs to be added as part 
	///							of a single JOIN node representing all the USING conditions when looping on this function is finished.
	///		mtONCondition	- (PBR) the current condition val# representing the ON clause condition being built by repeated calls. It is
	///							a form of state tracked by this function. Used by callers in join() and natural() when
	///							foreign tables are involved in a JOIN with USING or NATURAL syntax. This should be empty
	///							on the first call for a given join, and simply keeps getting updated by this function
	///							on each call to represent the growing condition. Callers using this should use PBR to repeatedly
	///							pass this in and then use addJoinNodeToONClause() once the full condition is built.
	/// 
	#; PVA050: now need lqlbl, rqlbl for new style ptln maintenance
addImplicitJoinCondition(leftSideLabel,lqlbl,rightSideLabel,rqlbl,fname,useMtON=0,&mtONCondition="")  ;  AND condition leftSideLabel.fname <jop> rightSideLabel.fname
	new leftVal,leftFieldName,logOp,rightFieldName,rightVal
	set leftFieldName = $$getJoinFieldName(m,leftSideLabel,fname)
	set rightFieldName = $$getJoinFieldName(m,rightSideLabel,fname)
	set leftVal = $$tfval(leftSideLabel,lqlbl,leftFieldName)
	set rightVal = $$tfval(rightSideLabel,rqlbl,rightFieldName)
	set logOp = $s(jop="INNER"||(useMtON):"=",1:"=*")
	do putlog("v^"_logOp_"^^"_$s(jop="RIGHT":rightVal_"^"_leftVal,1:leftVal_"^"_rightVal)_"^")
	if 'useMtON { // only AND the cond into WHERE clause if using WHERE condition+FROM list for the join
		do andwhere(val,m)
	} else { 
		if mtONCondition'="" {	// AND into existing mt("ON",) condition
			do putlog("l^&^^"_mtONCondition_"^"_val_"^")
		}
		set mtONCondition = val
	}
	RETURN
.
/// Given the provided field reference, return the correct field name to be used in the join condition. If the field is 
/// the field which a single-field RowID is based on, return the RowID name instead. Otherwise the actual field name
/// is returned. See DPV1938 and PVA050 for more info
getJoinFieldName(m,tableLabel,fieldName) [mt] PRIVATE {
	set tableName = $p($g($$$mtFromTableName(m_"^"_tableLabel)),"^")
	set irn = $$$smdLoadGetIrn(tableName,$g($$$mtTvf(m,tableName)))
	set tableType = $$$smdGetTType(tableName)
	if tableType=1, irn, ($$$smdRowIDLogicalFields(1,irn)=$$$smdGetIfn(1,irn,fieldName)) { 
		RETURN $$$smdRowIDFieldName(1,irn) 
	}
	RETURN fieldName
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA050: now need qlbl for ptln maintenance
tfval(tname,qlbl,fname)  ;  $$:  val# for tname.fname, maintain ptln()
	#; PVA003
	s val=$g($$$ptln(m,qlbl_"."_$tr(fname,".",$c(2))))
	i 'val d putval("f^"_m_"^"_tname_"^"_fname) s $$$ptln(m,qlbl_"."_$tr(fname,".",$c(2)))=val
	#; PVA003-
	QUIT val
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
andwhere(val,m) n wh  ;  AND condition val to the WHERE clause of query m
	#; AK366
	QUIT:'val  ;  nothing to do
	s wh=$g($$$mtWhere(m))  ;  might be nothing there
	d:wh putlog("l^&^^"_wh_"^"_val_"^")
	s $$$mtWhere(m)=val
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK344-
	#; PVA050: new xqlbl variable for remembering table, alias information
frmit(sv=0,badj)   ;  <frmit> ::= [ LATERAL ] <table> [ [ AS ] label ] // DPV1693 = default sv to 0
		#;  $$:	0 - simple table ref
		#;	1 - view
		#;	2 - table subquery
		#;	3 - join expression
		#;	"s1"/"s2" - streamed view/subquery
		#;  sv=1 forces a view or subqeury to be streamed, due to OUTER JOIN
	new frmtype,gvinput,tvfname,viewschema,vlabel,xqlbl
	n dumy s dumy=$g(lat) n lat s lat=dumy  ;  stack
	s:'$g(^%SYS("sql","sys","nolatj"),0) $e(lat,m)=$$checkid("LATERAL")  ;  1/0 in position m if the optional LATERAL was used  ;  AK850
	n floc s floc=""  ;  AK862
	If '$$check("(") {
		if '$$ctefrmit(value,cteWQNList,cteQBm) { // --- Continue Processing if not a CTE <with clause> ---
			d stname(.name) 
				#; DPV2137 - Moved this up to before label GOTO so it is set for all INS/UPD/DEL
				#; PVA050: add INS case back in, as INSERT now calls frmit (but not for query for
				#;         query insert, which has m set back to 1).
				#; DLP3474
				#; PVA349: prohibit functions is updating target
			if ( ('$g(iudtarg) || (m > 2)) && $$check("(") ){	// Table value function
				s tvfname=name
				s $e(lat,m)=1  ;  implied for TVF/J_T even if not used
				if name="JSON_TABLE" { // JSON_TABLE function
						// JSON_TABLE always places a specific number of arguments in mt("v")
						// 1. context item - <column reference> | <literal> | COLLECTION <identifier>
						// 2. context path (optional - defaults to '$' in code generation)
						// 3. columns
						// in the future, we could add more and this will impact the serialization of the JSON_FUNCTION signature and subsequent 
						// look up in the statement cache.
					new jsonParameters,savename,isCollection,jtlexvars
						// We will capture JSON_TABLE and treat is as a TVF but will parse the arguments separately
						// First, get the <json_context_expression>
						#; PVA348: Back to the beginning for lateral references; post validation may reject some cases
					set savename=name, isCollection = 0
						// Support FORMAT COLLECTION, default FORMAT to JSON (lookahead)
					if token = "ID" {
						do holdcur^%qaqpsl2(.jtlexvars) // Save current parse information
							// check for FORMAT
						if $$check("ID") && (value = "FORMAT") && $$check("ID") && (value = "COLLECTION") {
							set isCollection = 1
						}
						do setold^%qaqpsl2(.jtlexvars) // restore current parse information
					}
					if isCollection {
						do putval("t^"_lower)
						do lext
					} else {
						do scalx^%qaqpslx
					}
					set jsonParameters = $listbuild(val)
					if $$checkid("FORMAT") {
						if token = "ID" {
							// value for format
							if (value = "COLLECTION") && ('isCollection) {
								// cannot use FORMAT COLLECTION with anything other than an ID as the first operand
								set t = "FORMAT JSON"
								set moreinfo="FORMAT COLLECTION not valid for JSON values of this type"
								do error(1) 
							}
							if (value = "COLLECTION") || (value = "JSON") {
                                do putval("t^"_value)
								set jsonParameters = jsonParameters _ $listbuild(val)
								do lext
							} else {
								set t="FORMAT JSON|COLLECTION"
								do error(1) // error - we only support JSON and COLLECTION at this time
							}
						} else {
							// error - format value expected
							set t="FORMAT JSON"
							kill moreinfo
							do error(1) // FORMAT expected value
						}
					} else {
                        do putval("t^JSON")
						set jsonParameters = jsonParameters _ $listbuild(val)
					}
					set name=savename
						// now comes the <json_path_expression> which is a string literal
					if $$check(",") {
						do pconst^%qaqpslx
						set jsonParameters = jsonParameters _ $listbuild(val)
					} else {
						// default to '$' - not standard
						do putval("t^$")
						set jsonParameters = jsonParameters _ $listbuild(val)
					}
					if $$checkid("COLUMNS") {
							// the first character of the columns clause argument indicates COLUMNS (c) or %TYPE (%).
						do putval("t^"_$$jsontcols())
						set jsonParameters = jsonParameters _ $listbuild(val)
					} elseif $$checkid("%TYPE") {
						do pconst^%qaqpslx
							// the first character of the columns clause argument indicates COLUMNS (c) or %TYPE (%).
						set $$$mtV(val)=$$$mtVType($$$mtV(val))_"^%"_$p($$$mtV(val),"^",2,*)
						set jsonParameters = jsonParameters _ $listbuild(val)
					}
					do skip(")")
					set $$$mtTvf(m,name) = jsonParameters
				} else {	// Table value function
						#; DLP3474-
					n targs s targs=""
					f  {
						i $$check(")") { s targs=targs_$lb() QUIT }  ;  last parameter missing
						i $$check(",") { s targs=targs_$lb() CONTINUE }  ;  missing parameter
						d scalx^%qaqpslx s targs=targs_$lb(val)
						;  d error(1):$$findtree^%qaqpnl("v",val,"f")  ;  cannot have fields
						QUIT:$$check(")")
						d skip(",")
					}
					s $$$mtTvf(m,tvfname)=$s(targs=$c(1):$c(0),1:targs),name=tvfname
				}
			}
			new i,tableschema
			set i=$$ddtab(.name,.gvinput,.viewschema,,.tableschema) // fully determin name before setting mt("k"), always as was before DPV2137
			if i=1,$g(tableschema)'="",$g(iudtarg) {
					// DML_NOLOCK setting means we imply %NOLOCK for each DML targeting a table in this schema
				if $g(^rINDEXSQL("schema",$$$UPPER(tableschema),"settings","DML_NOLOCK")) { set $$$mtKNoLockFlag($$$mtK)=1 }
					// DML_NOCHECK setting means we imply %NOCHECK for each DML targeting a table in this schema
				if $g(^rINDEXSQL("schema",$$$UPPER(tableschema),"settings","DML_NOCHECK")) { set $$$mtKNoCheckFlag($$$mtK)=1 }
					// DML_PARALLEL setting means we imply %NOLOCK and mt("option","DML_PARALLEL") for each DML targeting a table in this schema
				if $g(^rINDEXSQL("schema",$$$UPPER(tableschema),"settings","DML_PARALLEL")) { set $$$mtKNoLockFlag($$$mtK)=1 set:'$d(mt("options","DML_PARALLEL")) mt("options","DML_PARALLEL")=1 }
					// DML_NONORMALIZE setting means we imply %NONORMALIZE for each DML targeting a table in this schema
				if $g(^rINDEXSQL("schema",$$$UPPER(tableschema),"settings","DML_NONORMALIZE")) { set $$$mtKNoNormalizeFlag($$$mtK)=1 }
.
				// If it's an Insert or Update, check for the %Library.Embedding datatype to see if we need to check %USE_EMBEDDING privs
				if ($$$mtStatementType="INS") || ($$$mtStatementType = "UPD"){
					new irn, ifn, fieldName
					set fieldName = ""
					set irn =$$$smdGetIrn(name)
					for  {
						set fieldName = $o($$$smd(1, irn, "f", fieldName)) 
						QUIT:fieldName=""
						set ifn = $o($$$smd(1, irn, "f", fieldName, ""))
						if ($$checkDataType^%apiDDL2($$$smdColDatatype(1, irn, ifn), $lb("%Library.Embedding"))) {
							set $li(mtc(0,0,"syspriv"),15)=1
						}
					}
				}
			}
			if $g(saveplan)>0&&$d(mt("tpdunqtbl")) {
				s mt("pdunqtbl",mt("tpdunqtbl"))=$lb(name,m)
				k mt("tpdunqtbl")
			}
			if $g(saveplan)>0 && (i=0) { // view referenced (PVA356)
				s pdict("view",name)=$lb($$viewhash^%qaqplansave(.gvinput,.viewschema),m)
				s pdict("tbl",name)=""
			}
				#; AK862
				#;  if table not qualified, record "findname" of resolved name
			d:$ll($g(floc(1)))=1 namap^%qaqpsl2("t",name,$li(floc,1,2))
				#; AK862-
			i m=1,'$d(%insqry)," UPD DEL INS "[(" "_$$$mtStatementType_" ") { s $$$mtKViewName($$$mtK)=name }
			
			GOTO label:i
			i m=1,'$d(%insqry),$$$mtStatementType="INS" {	// DPV2533+
				s $$$mtFromTableName(1_"^"_name)=name
				n savlabel s savlabel=$tr($p(name,".",$l(name,".")),$c(2),".")
				s $$$mtFLabels(m,savlabel,1_"^"_name)=$lb(name,0)
				s $$$mtFromList(m)=$g($$$mtFromList(m))_$lb(name) // PVA104: this is now not optional
				s label=name,$$$mtTargetLabel=label	// AK637=
				QUIT 1 	// DPV2533-
			}
			#; PVA052: record an outermost view for SELECT priv checking in info compile
			if $g(inview)="",'$d(mtc(0,0,"select privs",name)) {
				if " UPD DEL INS "[(" "_$$$mtStatementType_" ") { if m>1 { s mtc(0,0,"select privs",name)="" }}	// DPV3095 change structure of mtc(0,0,"select privs")
				else { s mtc(0,0,"select privs",name)="" }
				if $d(mtc(0,0,"select privs",name)),'$d(mtc(0,0,"select privs",name,"realname")) {
					new ttype,irn set ttype=$$$smdGetTType(name),irn=$$$smdGetIrn(name)
					if irn,$$$smdShardMasterName(ttype,irn)'="" { set mtc(0,0,"select privs",name,"realname")=$$$smdShardMasterName(ttype,irn) }
				}
			}
			s $e(lat,m)=""  ; lateral not applicable to views  ;  AK850
			d alias,gview(.gvinput,,viewschema)			// AK637=
			s label=$li(xqlbl,2-$li(xqlbl,3))  ;  alias/name	// AK637=
			s frmtype=1
		}
	}
	   #;  diagnose whether (jtab) or (query), with nesting allowed
	ElseIf (($g(iudtarg) && (m < 3)) || ($$diagprn'="jtab")) { d frmsubq s frmtype=2 }  // PVA013 // PVA349: no jtab if updating target
	                             // note: frmsubq sets xqlbl
	#;  clear lat(m) to not affect jtab FROM-items  ;  AK850
	Else { s $e(lat,m)="",frmtype=$$jtab(sv,.badj) d skip(")") RETURN frmtype  } //  No need to merge (below) in this case
	s name=$p($$$mtV(val),"^",2)
		#;  stream the view/subquery (unless within "info" compile) if either:
		#;  aggregates or DISTINCT used, it's a UNION, or forced by the caller
		#;  due to OUTER JOIN (except if one table with simple conditions)
		#; PVA085: Add %inorder as a case forcing streaming.
		#; PVA099: Stream ALL views on rhs of lj. They will be merged back later, if appropriate.
		#; PVA105: Now must stream all views, merging them later, as needed. 
		#; PVA119: Well, we should, but we can't stream all views until the mtc rats nest 
		#;         is sorted out. 
		#; PVA129: DO stream view for CREATE VIEW info compile of readonlyview not set
		#; PVA139: stream views even in top query block of regular compile of updating statements
	if 'info||((callname["view")&&(readonlyview'=1))
		|| (callname="findname")  ;  stream if "findname"  ;  AK862
	{
		s frmtype="s"_frmtype d vstr QUIT frmtype // stream
	}
	n v,ml,lx,ly,lxt,lxy,lyt,j  ;  AK248
		#;---------- query modification ----------
	s $$$mtPQbIsActive(name)=0  ;  mark query-block name as obsolete
	s ml=name_"^"  ;  add inner FROM entries to m
		#; PVA168: Maintain mt("ojtab") in case merged stream label was there.
	f  {
		s ml=$o($$$mtFromTableName(ml)) QUIT:+ml'=name  
		s $$$mtFromTableName(m_"^"_$TR(ml,"^",","))=$$$mtFromTableName(ml) 
		s $$$mtFLabels(m,$li(xqlbl),m_"^"_$TR(ml,"^",","))=$li(xqlbl,2,3)
		s:$lf($g(mt("ojtab")),$p(ml,"^",2)) mt("ojtab")=mt("ojtab")_$lb($TR(ml,"^",","))
	}
		#; PVA027
		#; Add base tables to mt("from") for %inorder. Later change which uses this structure for SELECT * ordering
		#;   will remove this (having only view name/label instead). That change will compensate by recursively acquiring 
		#;   underlying base tables in proper order at the time mts("streamorder",m) is built. Alternatively, two separate arrays can be
		#;   used, one for SELECT * purposes, one for streamorder purposes. Note, we need separate loops because the addition to 
		#;   mt("from"..) needs to preserve underlying FROM order.
		f n=1:1:$ll($$$mtFromList(name)) s $$$mtFromList(m)=$g($$$mtFromList(m))_$lb(name_","_$li($$$mtFromList(name),n))
		#; PVA027-
		#; PVA092: new mt("ON",) structure
		#; PVA087: Move ON clauses to new query
	s n=""
	f  {
		s n=$o($$$mtOn(name, n),1,lx) q:n=""
		s ly=$li(lx,4),lx=$li(lx,3)
		s lxt="" f j=1:1:$ll(lx) s lxt=lxt_$lb(name_","_$li(lx,j))
		s lyt="" f j=1:1:$ll(ly) s lyt=lyt_$lb(name_","_$li(ly,j))
		s $$$mtOn(m, n)=$li($$$mtOn(name, n),1,2)_$lb(lxt)_$lb(lyt)
			// k $$$mtOn(name, n)  - except no other code seems to bother cleaning up abandoned
			//    query bloc,
	}
		#; 1    AK515
		#;  update label, if possible
	i $ll($$$mtFromList(name))=1 s label=name_","_$li($$$mtFromList(name))
		#; 1    AK515-
		#;  modify all field entries $$$mtV(val)= f^name^[label]^field
		#;     to belong to query m:              f^m^[name,label]^field
	n tname s tname="f^"_name
	f val=1:1:$$$maxv s v=$$$mtV(val) s:tname=$p(v,"^",1,2) ml=$p(v,"^",3),$p($$$mtV(val),"^",2,3)=m_"^"_$s(ml'="":name_","_ml,1:"")  ;  AK248
		;  *** check for aup, arrow fields!
		#; AK366
		#;  move vsub's WHERE and subqueries to m
	f n=1:1:$$$mtPNumQbs s:+$$$mtP(n)=name $p($$$mtP(n),"^")=m  ;  subqueries of name
	f n=1:1:$$$mtPNumQbs s:$$$mtCorrParentQb(n)=name $$$mtCorrParentQb(n)=m // PVA099: fix this oversight (no known problem caused by it, though)
	d andwhere($g($$$mtWhere(name)),m)  ;  WHERE clause of inner query - AND with outer WHERE
	i callname["view" {	//DPV1693+
			#; Record log #'s of conditions from WHERE clauses not from the main view's query
			#; These are then excluded from this view's CHECK OPTION conditions in %qaqqt
		s n="" f  s n=$o($$$mtL(n)) q:'n  s:'$lf($g($$$mtWhereCheckOption),n) $$$mtWhereCheckOption=$g($$$mtWhereCheckOption)_$lb(n)
	}  //DPV1693-
	k $$$mtWhere(name)  ;  ,$$$mtOutput(name)  ;  not to interfere with later processing
	#; AK366-
	QUIT frmtype
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK526
andfeqoj(m) n logs,jj  ;  $$:  1 if WHERE of m is AND of simple
	#;  conditions of the form <field>=<const> , and if so then change
	#;  all such conditions to <const>=*<field>
	QUIT:$ll($$$mtFromList(m))>1 0  ;  more than one table
	QUIT:'$g($$$mtWhere(m)) 1  ;  no WHERE clause (AK515)
	QUIT:'$$alleq($$$mtWhere(m),.logs) 0
	f jj=1:1:$l(logs,",")-1 s $$$mtLOperator($$$mtL($p(logs,",",jj)))="=*"
	QUIT 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
alleq(log,list) n ptlg,val1,val2,l1,l2  ;  $$:  1 if log is AND of simple
	#;  conditions of the form <field>=<const> , list them (by ref) in .list={log,}
	s ptlg=$$$mtL(log),val1=$p(ptlg,"^",4),val2=$p(ptlg,"^",5)
	i $e(ptlg,1,4)="v^=^",$$$mtVType($$$mtV(val2))="f","tx"[$$$mtVType($$$mtV(val1)) s list=log_"," QUIT 1
	#;  if <field>=<const> , switch to <const>=<field>
	i $e(ptlg,1,4)="v^=^",$$$mtVType($$$mtV(val1))="f","tx"[$$$mtVType($$$mtV(val2)) s list=log_",",$p($$$mtL(log),"^",4,5)=val2_"^"_val1 QUIT 1
	i $e(ptlg,1,4)="l^&^",$$alleq(val1,.l1),$$alleq(val2,.l2) s list=l1_l2 QUIT 1
	QUIT 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK526-
/// Check to see if the <sql statement>'s <from clause> (<frmit>) is a CTE <with clause>
/// and parse accordingly.  
///
/// Return 1 if the specified 'withQryName' is a <with query name> defined in the SQL
/// Parse Tree 'mt(...)' [see: cte^%qaqpsql1(...)]; Otherwise, return 0
/// 
ctefrmit(withQryName,cteWQNList,cteQBm) ; return 0 if not CTE, 1 if CTE found
	#;--------------------------------------------------------------------------------
	#; Parameters:
	#;  withQryName - The name specified for the <with query name> component of the
	#;                CTE's <with clause>.  This value is always in UPPER case.
	#;  cteWQNList  - A $LIST(...) stack of 'withQryName' values for each invocation
	#;                to this method
	#;  cteQBm      - If parsing a CTE <with clause>, record the current CTE query 
	#;                block (m+1 - which will not increment if there are subqueries 
	#;                within the CTE definition) which goes away when the current
	#;                CTE parsing is finished
	#;--------------------------------------------------------------------------------
	
	if $g(inview)'="" { // currently within a view definition, code also appears in cte^%qaqpsq1
		set withQryName=withQryName_$c(1)_$p(inview,"^",2) // this CTE name only lives within this VIEW
	} elseif callname["view" { // we are compiling a view
		set withQryName=withQryName_$c(1)_$p(callname,$c(1),2) // this CTE name only lives within this VIEW
	}
.
	RETURN:'$d($$$mtCTEWithQueryNameNode(withQryName)) 0 // No CTE <with clause> defined for the given <with query name>!
	
	new lexInfo
	set cteQBm=$$$mtPNumQbs+1,lexInfo=$$lexmark()  // Save the 'starting' CTE's current lexical context information & query block (active QB+1)
	
	$$$lexcheck("ID")
	if token="." { // --- If processing a <schema> (not a CTE <with clause>), then continue processing from the 'starting' CTE's saved lexical context ---
		do lexgo(lexInfo)  // Restore the 'starting' CTE's saved lexical context information!
		RETURN 0
	} 
	
	do:$LF(cteWQNList,withQryName) error(384)  // Prevent circular CTE definition!
	set cteWQNList=cteWQNList_$LB(withQryName)
	
	do lexgo($$$mtCTELexicalInfo(withQryName)),frmsubq  // Restore the CTE's saved lexical context information and process the CTE's <with query> as a subquery table/view!
	set frmtype=2  // Mark the <with query> as a 'table subquery' (2)!
	
	do lexgo(lexInfo),alias  // Restore the 'starting' CTE's saved lexical context information and add the CTE's <with query name> as an alias!
	$$$peekany(" ID AS ") do alias  // Process any traditional alias and overwrite the CTE's <with query name>!
	
	RETURN 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA013
frmsubq n genview,vlabel,dname,vinfstr,vinfval,vpos,dlen,nxtsub,fpos
	s dname="tsq"_$i(tsq)_"%"
	s genview=$g(m)_"^"_$li(%defschema)_"."_dname  ; dummy name unlikely to collide with any user names
	d query(m,0,csupq),skip(")")
	#; AK637
	s name=$li(%defschema)_"."_dname
	d alias
	#; AK637-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA013-
	#; AK446
vstr	;  [public: m,name,label] setup view stream information, must set label!
	#; PVA027: added jx
	n bad,perq,jj,jx,i,args,k s perq="%%Q"_name
	#; PVA050: use xqlbl instead of viewinfo to set bad.
	s bad=name_"^"_name_$li(xqlbl,2)  ;  bad = n^n_vname
	#;  modify $$$mtFromTableName(n^n_vname_talias)=tname => $$$mtFromTableName(n^talias)=tname
	s jj=bad 
	for  {
		s jj=$o($$$mtFromTableName(jj)) q:$e(jj,1,$l(bad))'=bad
		s $$$mtFromTableName(name_"^"_$e(jj,$l(bad)+1,*))=$$$mtFromTableName(jj) k $$$mtFromTableName(jj)
			#;  make corresponding change for tvf's labels
		if $d($$$mtTvfLabelParams(jj)) { set $$$mtTvfLabelParams(name_"^"_$e(jj,$l(bad)+1,*))=$$$mtTvfLabelParams(jj) kill $$$mtTvfLabelParams(jj) }
			#; for FTs inside virtual stream, make sure they have their labels reset
		if $d($$$FTByLabel(jj)) { set $$$FTByLabel(name_"^"_$e(jj,$l(bad)+1,*))=$$$FTByLabel(jj) kill $$$FTByLabel(jj) }
			#;  make corresponding change in view's mt("from"..) entry (PVA027)
		s jx=$lf($$$mtFromList(name),$p(jj,"^",2,*)) s:jx $li($$$mtFromList(name),jx)=$e(jj,$l(bad)+1,*)
	}
	#; PVA330 now need to fix up flbls, for firsttable in subqueries
	s jj="" for
	{  s jj=$o($$$mtFLabelsSaveNode(name,jj)) q:jj=""
	   s jx="" for
	   {  s jx=$o($$$mtFLabels(name,jj,jx)) q:jx=""
	      if $e(jx,1,$l(bad))=bad { s $$$mtFLabels(name,jj,name_"^"_$e(jx,$l(bad)+1,*))=$$$mtFLabels(name,jj,jx) k $$$mtFLabels(name,jj,jx)}
	   }
	}
	#; PVA092: Similarly fix outer join arguments
	s jj="" for  { 
		s jj=$o($$$mtOn(name, jj),1,jx) q:jj=""
	   	for i=3,4 { 
	   		s args=$li(jx,i)
			for k=1:1:$ll(args) { s:$e(name_"^"_$li(args,k),1,$l(bad))=bad $li(args,k)=$e($li(args,k),$l($p(bad,"^",2,*))+1,*) }
	      s $li(jx,i)=args
	   }
	   s $$$mtOn(name, jj)=jx
	}
	#;  modify $$$mtV(jj)=f^n^n_vname_talias^fname => $$$mtV(jj)=f^n^talias^fname
	f jj=1:1:val { s:$e($$$mtV(jj),3,$l(bad)+2)=bad $e($$$mtV(jj),3,$l(bad)+2)=name_"^" }
	s $$$mtFromTableName(m_"^"_label)=perq  ;  set FROM entry in outer query
	#; PVA050: set flbls for streamed view.
	s $$$mtFLabels(m,$li(xqlbl),m_"^"_label)=$li(xqlbl,2,3)
	#; PVA027
	#;  also set in mt("from,m)
	s $$$mtFromList(m)=$g($$$mtFromList(m))_$lb(label)
	#; PVA027-
	#;  generate a rowid for the virtual stream, save its val# for later
	#; PVA050: Use and set %viewinfo instead of ptln.
	d advf(m,label,"%VID") s $$$mtPViewIDVal($$$mtP(name))=$li(%viewinfo("vcols",name,"%VID"),2) // PVA236: use %vid
	#;  for each SELECT item prepare a new "f" val#
	f jj=1:1:$ll($$$mtAlphaUpAliases(name)) { d advf(m,label,$li($$$mtAlphaUpAliases(name),jj)) }
	#;  *** handle "SELECT *" !
	#;  should never have them "s" nodes to begin with!
	d noas(name) 
	f n=name+1:1:$$$mtPNumQbs { d noas(n):$g($$$mtUnionTopQb(n))=name }
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
advf(m,label,fname)  ;  add view field label.fname to subq# m
	#; Update %viewinfo with new val#s for references to streamed view columns.
	#;   but don't clobber information that a name is ambiguous
	n v s v=$$newval("f^"_m_"^"_label_"^"_fname) ; this is remembered implicitly by val# sequence
	#;		from %VID of streamed view
	#; AK862
	#;  set up view field's "findname" info
	s:(callname="findname")&&(fname'="%VID") mt("namapv",v)=$$namapvf()
	#; AK862-
	i fname'="%VID" { QUIT:$g(%viewinfo("vcols",name,fname))="" }  ; ambiguous
	else { s $li(%viewinfo("vcols",name,fname))="" }
	s $li(%viewinfo("vcols",name,fname),2)=v
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK862
namapvf()  ;  [public: frmtype,xqlbl,fname,jj,mt] $$: SCH.TAB.FLD for view field, if any
	QUIT:frmtype="s1" $li(xqlbl,2)_"."_fname  ;  an actual view
	n val s val=$p($$$mtOutputVals($$$mtOutput(name)),",",jj) s:$$$mtVType($$$mtV(val))="s" val=$p($$$mtV(val),"^",4)
	QUIT:fname=$p($g(mt("namapv",val)),".",3) mt("namapv",val)
	QUIT ""  ;  a FROM subquery fname might match an actual DD field
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK862-
noas(m) n i,val,v  ;  remove AS nodes from SELECT-list of subquery m
	s i=0 f  s val=$$nexto(m) QUIT:'val  s v=$$$mtV(val) d:$e(v)="s"
	. s val=$p(v,"^",4)  ;  replace P2 in the SELECT-list by P4 itself:
	. i i>1 s $p($$$mtOutput(m),",",i)=val QUIT  ;  ... main node, but special case
	. s $p($$$mtOutput(m),",")=$p($$$mtOutput(m),"^")_"^"_val  ;  ... for 1st piece
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK446-
gview(input,vlabel,viewschema) ;  process the query of a general view, come back with val
		#; PVA052: new variable 'inview'
	n %defschema,f,genview,inview,lexp,line,lower,mask,more,p,sql,token,value
	n begline,begtoken,endline,endtoken,indexline,prevtoken,pprev,lineprev,pprev // JSL5130
		#;  When processing a view query, the default schema should be that of the schema the view is defined in.
	set %defschema=$lb(viewschema)
	set genview=$g(m)_"^"_name
		#; PVA052: set inview
	set inview=genview // This used as flag to know if really in a view for privilege gathereing;
	                 #;  Unlike genview, it is therefore NOT set for FROM subqueries, and is NOT
	                 #;  cleared for UNION view handling.
		#;note, f anf p are just temp and reinitialized to 0 next
	set f=$$$GetRVIdxDataFromIQN(name),p=$$$smdLoadGetIrn(name)
	set mtc(0,0,"table",m_"^"_name)=$lg(f,3)_$c(1)_p_$c(1)_$lg(f,4)_$c(1)_$$$smdExtent($lg(f,3),p)_$c(1)_$$$smdClassname($lg(f,3),p)_$c(1)_$$$smdSharded($lg(f,3),p)_$c(1)_$$$smdFastInsert($lg(f,3),p)_$c(1)_$$$smdFastSelect($lg(f,3),p)_$c(1)_$$$smdfastSelectSlotCount($lg(f,3),p)_$c(1)_$$$smdShardMasterName($lg(f,3),p)_$c(1)_$$$smdfastInsertSlotCount($lg(f,3),p)
		#;  suspend "findname" processing within view's query text
	if callname="findname" { new callname set callname="info" }	// AK862=
	set line=0,more=0,f=0,p=0,sql=input  //  initialize lexical analyzer
	do lext
		#;  set $LIST of the external AS-list into mt("as"/"AS",n) where n
		#;       is the coming subquery - used in as^slx
		#;  allow for "AS" after the list (eventually will be mandatory)
	set lexp=$$lexmark() // PVA302: look ahead one to break ambiguity of (ID versus (SELECT
	if $$check("(") {
		if token'="ID" { do lexgo(lexp) }
	   	else {
			set n=$$$mtPNumQbs+1
			for i=1:1 {
				set $li($$$mtAliases(n),i)=$g(lower),$li($$$mtAlphaUpAliases(n),i)=$g(value) 
				$$$lexskip("ID")
				$$$lexcheck(",") CONTINUE
				$$$lexskip(")")
				$$$lexcheck("AS")
				QUIT
			}
		}
	}
	// --- Making sure this is a <select statement> only OR a CTE <with clause> followed by a <select statement> --- 
	// code also appears in view^%qaqpDDLParser
	if token="WITH" { // --- Process the CTE's <with clause> ---
		do skip("WITH"), cte^%qaqpsq1(1) // Process the CTE's <with clause>
	}
	do query(m,0,csupq),error(25):token'=$c(1) 	// PVA180: remove spurious order^ call.
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA018
diagprn()   ; Distinquish (query) from (jtab) : look ahead for LL(k) parse ambiguity in SQL FROM clause
	#; When this is called, the leading parenthesis has been parsed by CHECK. When diagprn returns,
	#; it guarantees next lext call will again yield first token following this open paren.
	n switch,type,val
	i token="SELECT" QUIT "query"
	i token'="(" QUIT "jtab"
	d switch(),skip("(") s type=$$diagprn()
	i type="jtab" g xdiagprn
	#; substantive case: must examine token after an initial (query)
	s val=1 ; indicate already in a parenthesis level - skiped above
	f  d error(26):token=V s:token="("!(token="$$") val=val+1 s:token=")" val=val-1 d lext i val=0 QUIT
	i token=")" s type="query" g xdiagprn
	i " UNION INTERSECT EXCEPT "[(" "_token_" ") s type="query" g xdiagprn
	s type="jtab"
xdiagprn d switch(switch)
	QUIT type
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA018-
	#; PVA050: new function, getunqlabel to apply ANSI standard duplicate rules for FROM clause
	#;         as well as being used in colmn^%qaqpslx parsing
getunqlabel(tlabel,m,sdott,fitm,qual,utbl,latf) ; find FROM item matching an unqalified column label (tlabel)
	#;  m (input) : query number of FROM clause to search
	#;  sdott (input) : S.tlabel, in case tlabel came with a preceding S.
	#;  if lat(m) is empty, must find it starting from firsttbl(m)
    #;  if lat(m)=1, could find it anywhere in FROM(m)
	#;  return 1 if found (and leave latf=""), 0 if not.
	#;  if implicit lateral is found (lat(m)=0) then set latf as a candidate and return 0
	#;  OUTPUT BY REF: if successful, following saved values are valid
	#;  fitm=m^label - (first) $$$mtFromTableName(fitm) item corresponding to tlabel
	#;  qual - exposed table name: either alias or the same as utbl
	#;  utbl=sch.tab - qualified table/view name actually referenced. 
	#;                            synthetic name for table subquery.
    #;  latf=lb(m,fitm,qual,utbl) is a candidate for an implicit LATERAL column,
    #;    in case nothing else is found. 
	#;  2 cases, aliased and not aliased (including views and subqueries):
	#;  FROM [s2.]t2 x,[s3.]t3
	#;  $$$mtFromList(m)=$LB("A","S3.T3")
	#;  mt("flbls",m,"A","m^A")=$LB("S2.T2",1)  ;  3rd subscript is unique!
	#;  mt("flbls",m,"T3","m^S3.T3")=$LB("S3.T3",0)
	#;  an additional case, for view FROM items, is used for info-compile,
	#;    as well as for a short period of parsing (when?) for info=0:
	#;  $$$mtFromList(m)=$LB(...,"<from-ident>",...)
	#;  mt("flbls",m,"<unique-label>","m^<from-ident>")=$LB(sch.tab,<aliased-flag>)
 	s fitm=$o($$$mtFLabels(m,tlabel,""),1,qual)
	RETURN:fitm="" 0  ;  label not in m's FROM clause
	s utbl=$li(qual),qual=$s($li(qual,2):tlabel,1:utbl)
	i sdott'="",qual'=sdott { RETURN 0 }  ;  tlabel matched, but it came with a different S.tlabel
	i $e(lat,m)=1 { RETURN 1 }  ;  lateral table found  ;  AK850
	i $e(lat,m)=0 { s:latf="" latf=$lb(m,fitm,qual,utbl) RETURN 0 }  ; implicit lateral candidate
	#; PVA104: treat out of scope match as a non-match
	i $lf($$$mtFromList(m),$p(fitm,"^",2,*))>=$g(firsttbl(m),1) { s latf="" RETURN 1 }  ;  can't be earlier than firsttbl(m)
	RETURN 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	// Given a name of a table, define the "realname" node of mtc(0,0,"select privs") if this is a sharded=2 table
realname(iqn) [mtc] PUBLIC {
	set ttype=$$$smdRVData(iqn)
	if ttype'="" { 
		set irn=$p(ttype,$c(1),2),ttype=$p(ttype,$c(1),3)
		if $$$smdShardMasterName(ttype,irn)'="" { set mtc(0,0,"select privs",iqn,"realname")=$$$smdShardMasterName(ttype,irn) }
	}
	RETURN
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
label	;
		#; PVA052: record any table ref not contained in a view for SELECT priv checking in info compile
	if $g(inview)="",'$d(mtc(0,0,"select privs",name)) {
		if $d($$$mtTvf(m,name)) { /* nothing yet, define priv info in mtc() in ddtab */ }
		elseif " UPD DEL INS "[(" "_$$$mtStatementType_" ") { if m>1 { s mtc(0,0,"select privs",name)="" }}	// DPV3095
		else { s mtc(0,0,"select privs",name)="" }
		if $d(mtc(0,0,"select privs",name)),'$d(mtc(0,0,"select privs",name,"realname")) { do realname(name) }
	}
		#; AK637
	n aslab,savlabel,xqlbl
	d alias  ;  sets label, xqlbl based on name and alias
	s aslab=$e(1,$li(xqlbl,3)),savlabel=$li(xqlbl)
		#; AK637-
		#; ------ Gather General View Information ------
	i $g(genview)'="" s label=m_$p(genview,"^",2)_label ; Fully Qualified Label
	s $$$mtFromTableName(m_"^"_label)=name  ; Record General View Table
	s $$$mtFLabels(m,savlabel,m_"^"_label)=$lb(name,aslab]"")
		#; PVA027
		#;  Also add to $$$mtFromList(m)
	s $$$mtFromList(m)=$g($$$mtFromList(m))_$lb(label)
		#; PVA027-
		// For table valued functions, record the parameters for this call to the function by the label
		// Later, in %qaqpqo, we'll move the parameter list to an entry identified by the str
		//set:$d(mt("tvf",m,name)) mt("tvf","label",m_"^"_$s(aslab:label,1:name))=mt("tvf",m,name)
	set:$d($$$mtTvf(m,name)) $$$mtTvfLabelParams(m_"^"_label)=$$$mtTvf(m,name)
		#; PVA348:  Crucial to have stream based representation for JSON_TABLE that cannot be resolved at parse
		#;   time. The 'm' based representation becomes garbage if more than one JSON_TABLE used in a
		#;   given query block. Only the last usage would be preserved.
	set:$d($$$mtTvf(m,"JSON_TABLE")) $$$mtTvfLabelParams(m_"^"_label)=$$$mtTvf(m,"JSON_TABLE")
	set:$d($$$FTByName(name)) $$$FTByLabel(m_"^"_label) = name		// MJG291
	QUIT 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK637
alias	;  [ [ AS ] <id> ] - set label,xqlbl based on name and alias, if used
	#;  label=name/alias, xqlbl=$LB("effective FROM label",name,aliasflag)
	#;  for:  FROM A.B, C.E AS F ,  the "effective labels" are B and F
	n lxloc
	s label=name
	#; PVA204: look ahead to disambiguate ORDER
	if token="ID" {
			#; AK862
		d getloc^%qaqpsl2:floc'=""  ;  record lable location
		if value="ORDER" { // PVA204: disambiguate possible ORDER
			s lxloc=$$lexmark()
			d skip("ID")
			if $$check("BY") { d lexgo(lxloc) }
			else { d lexgo(lxloc) s label=value  d skip("ID") }
		} elseif ",LIMIT,OFFSET,"[(","_value_",") { // disambiguate possible LIMIT and OFFSET
			set lxloc=$$lexmark()
			do skip("ID")
			for { // skip through all the left paranthesis
				if token="(" { 
					do lext 
				} else { 
					quit 
				} 
			} 
			if ("?:9"[token)||(token="ALL") { // if literal or variable or parameter, this is a LIMIT or OFFSET clause
				do lexgo(lxloc)
			} else { 
				do lexgo(lxloc) 
				set label=value 
				do skip("ID") 
			} 
		} else { s label=value d skip("ID") }
	}
		#; AK862
	else {
		$$$lexcheck("AS") s label=value d getloc^%qaqpsl2:floc'="" $$$lexskip("ID")
	}
		#;  if alias identical to table name was used, record for "findname"
	d:$lg($g(floc(1)),2)=label namap^%qaqpsl2("t",name,$li(floc,1,2))
		#; AK862-
		#; PVA103: don't get last period piece of label if label contains an alias
	s xqlbl=$lb($s(label=name:$tr($p(label,".",$l(label,".")),$c(2),"."),1:label),name,label'=name)
	i m=1," INS UPD "[(" "_$$$mtStatementType_" ") s $$$mtTargetLabel=label
		#;  if processing UPDATE/DELETE target table and a FROM cluase has
		#;  already been processed (udf=1), done if target already identically
		#;  included in FROM (also in the special case of unaliased target and
		#;  exactly one instance of the table in FROM, aliased, in which case
		#;  label is SET to that alias)
		#;  For ASE, use first aliased FROM-item on the table ;  AK1009
	i m=1,"UPD DEL"[$$$mtStatementType,udf=1 { n labs s labs=$$labs(name) QUIT:$lf(labs,label)  i label=name,labs'="",($ll(labs)=1)||($g(mt("options","source-tsql"))=1) { s label=$li(labs),xqlbl=$lb(label,name,1),$$$mtTargetLabel=label QUIT } }
	i $d($$$mtFLabelsSaveNode(m,$li(xqlbl))) s label=$li(xqlbl) d error(20)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
labs(name) n labs,jj,tlab,qual s labs=""  ;  $$:  $LIST() of all labels
	#;  of name used in the FROM clause (or name itself for unaliased use)
	#;  Make sure they are in order of appearance  ;  AK1009
	f jj=1:1:$ll($$$mtFromList(m)) { s tlab=$li($$$mtFromList(m),jj) i tlab=name { s labs=labs_$lb(name) CONTINUE } i $o($$$mtFLabels(m,tlab,""),1,qual)'="",$li(qual)=name { s labs=labs_$lb(tlab) } }
	QUIT labs
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK637-
stname(name,noparse=0) ;  [public: name] construct in name the "upper qualified table name" -  (AK447)
	#;  ignore {catalog.} , undelimit the values, replace "."
	#;  by $c(2) in table name only, add default schema if missing
	#;  name is passed by reference
	#; noparse: optional flag to assume name supplied for standardization and skip parsing (dots call)
	d:'noparse dots  ;  parse and get the reverse-$LIST
    s:$g(saveplan)>0&&($ll(name)=1) mt("tpdunqtbl")=$li(name)
    #; PVA349: don't recognize JSON_TABLE as updating target
	if (('$g(iudtarg) || (m>2)) && ($lg(name)="JSON_TABLE")&&(token="(")) { set name = $li(name) quit }
		#; %sqlSchemaPath does not apply to DDL satements.  There are some problems with CREATE VIEW if %sqlSchemaPath is defined and the tables/views in the view's
		#; query are not yet defined when CREATE VIEW is compiled.  If this is a DDL statement, ignore any %sqlSchemaPath settings.
	new:"CRT ALT DRT CRV ALV DRV CRI DRI CRUS ALUS DRUS CRF CRM CRP CRQ DRF DRM DRP DRQ CRG DRG"[$$$mtStatementType %sqlSchemaPath
	
		#; if there is one entry in the %sqlSchemaPath and one entry in the %defschema and they are the same, just use the %defschema
	if $ll($g(%sqlSchemaPath))=1,$ll(%defschema)=1,$lg(%sqlSchemaPath)=$lg(%defschema) {
		if $lg(name,2)="" { set:info mtc(0,0,"some unqualified names")=1 set mt("unqualified-names")=1 }
		set name=$li(name_%defschema,2)_"."_$tr($li(name),".",$c(2))
	}
		#; multiple possible default schemas, if schema not specified prefiz the name with $c(1)
		#;  This tells us to determine the qualified name during table lookup.
	elseif $ll($g(%sqlSchemaPath))+$ll(%defschema)>1 {
		s name=$lg(name,2)_"."_$tr($li(name),".",$c(2))
		if $e(name)="." {	// Name is unqualified, attempt to resolve name to a temp table name
			set:info mtc(0,0,"some unqualified names")=1
			set mt("unqualified-names")=1
			if $isobject($g(%sqlcontext)) {	// Look for potential temp table's physical table name (DPV3509)
				n foundone,i,tname,tryname s tname="",foundone=0
				for i=1:1:$ll($g(%sqlSchemaPath)) {
					set tryname=$lg(%sqlSchemaPath,i)_name
					s tname=%sqlcontext.ResolveTableName(tryname)
					if tname'=tryname { set foundone=1,name=$$$UPPER(tname) set $$$mtGptTable(tname)="" quit  }
				}
				QUIT:foundone	// Found a temp table name in the %sclSchemaPath list
				for i=1:1:$ll(%defschema) {
					set tryname=$lg(%defschema,i)_name
					s tname=%sqlcontext.ResolveTableName(tryname)
					if tname'=tryname { set foundone=1,name=$$$UPPER(tname) set $$$mtGptTable(tname)="" quit  }
				}
				QUIT:foundone	// Found a temp table name in the %defschema list
			}
				// For recount compile, we don't care what the label is, just use SQLUSER.  We just need a place-holder label name to use.
			if callname="recount" set name="SQLUSER"_name QUIT
			set $e(name)=$c(1)
			QUIT
		}
	}
		#;  If just one schema in the schema search path, add it here (if not specified)...
	elseif $ll($g(%sqlSchemaPath))=1 {	// DPV3410=
		if $lg(name,2)="" { /* set ContextDependent=1 */ set:info mtc(0,0,"some unqualified names")=1 set mt("unqualified-names")=1 }
		s name=$li(name_%sqlSchemaPath,2)_"."_$tr($li(name),".",$c(2))
	}
		#;  If just one default schema (single #import), add it here (if not specified)...
	elseif $ll(%defschema)=1 {
		if $lg(name,2)="" { /* set ContextDependent=1 */ set:info mtc(0,0,"some unqualified names")=1 set mt("unqualified-names")=1 } // DPV3369
		s name=$li(name_%defschema,2)_"."_$tr($li(name),".",$c(2))
	}
		#;  no default schema specified (possible?), if schema not specified tag the name with $c(1).  
		#;  This tells us to determine the qualified name during table lookup.
	else { 
		s name=$lg(name,2)_"."_$tr($li(name),".",$c(2))
		if $e(name)="." {
			if callname="recount" set name="SQLUSER"_name QUIT
			set $e(name)=$c(1) 
			set:info mtc(0,0,"some unqualified names")=1
			set mt("unqualified-names")=1
		}
	}
.
	if $isobject($g(%sqlcontext)) {	// DPV3228=, DPV3509=
		new tname,gptname
		set tname=name set:$e(tname)=$c(1) tname=$e(tname,2,*)
		set gptname=%sqlcontext.ResolveTableName(tname)
		if gptname'="" { set name=$$$UPPER(gptname) set:gptname'=tname $$$mtGptTable(tname)="" }
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dots	s name=""  ;  [public: name] reverse-$LIST of parsed <id>{.<id>}
	#; AK862
	f  s name=$lb(value)_name d getloc^%qaqpsl2:callname="findname" $$$lexskip("ID") $$$lexnotcheck(".",QUIT)
	#;  for "findname", remember name as entered, record SCH.TAB if used
	d:(floc'="")&&($ll(name)>1) namap^%qaqpsl2("st",$li(name,2)_"."_$li(name),$li(floc,3,4)_$li(floc,1,2))
	#; AK862-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
imply	;----------  add implicit %FOREACH/DISTINCT in some cases  ;  AK062+
		#;  do not imply anything if agg(... %FOREACH ...) explicitly used
	for i=1:1:$l(laggs,",")-1 {
		RETURN:$p($$$mtV($p(laggs,",",i)),"^",6)'=""
	}
		#;  add %FOREACH(<GROUP-list>) to all top-level aggregates
		#;      if none had %FOREACH and SELECT DISTINCT BY was not used
	if $g($$$mtGroupDistinctList(m)) {
		for i=1:1:$l(laggs,",")-1 {
			set $p($$$mtV($p(laggs,",",i)),"^",6)=$$$mtGroupDistinctList(m)
			set:$p($$$mtV($p(laggs,",",i)),"^",7)'="" $p($$$mtV($p(laggs,",",i)),"^",7)=$p($$$mtV($p(laggs,",",i)),"^",7)_$$$mtGroupDistinctList(m)
		}
	}
	#;  mark query as "onerow" if HAVING or aggregates were used,
	#;      SELECT DISTINCT and GROUP were not used, no %FOREACH was used
	#;      in agg's, and no fields were used in the SELECT-list outside
	#;      of agg's  *** for now last condition not tested precisely
	#;		and no nested aggregates, and no unaggregated fields used in HAVING
	#;
	#; Aggregates of aggregates in ungrouped queries cannot be "onerow"
	for i=1:1:$l(laggs,",")-1 {
		RETURN:$$IsAggOfAgg($p(laggs,",",i))
	}
	QUIT:$$$mtCorrFieldUsed(m)  		// correlated field used - no "onerow"!	// AK703=
	QUIT:$g($$$mtGroupDistinctList(m))		// GROUP BY or SELECT DISTINCT specified
	;  QUIT:$d(mt("distinct",m))  	// SELECT DISTINCT used (removed by MAK5055)
	QUIT:$$OutputHasFields(m)	// Fields in the select list outside of aggs
	QUIT:$$HavingHasFields(m)   // Fields in the HAVING clause outside of aggs
	set $$$mtOneRow(m)=1		// mark subquery as "onerow" (AK414=)
	kill $$$mtSequencersQb(m)			// no need to sort only one row (AK883=)
	kill $$$mtDistinct(m)   // if onerow do not need distinct at all (MAK5055)
	QUIT
.
IsAggOfAggLV
	If ev="a" Set IsAggOfAgg = 1 QUIT
	GOTO lviterarg^%qaqpnl
.
 // Return 1 if value v is an aggregate of some other aggregate	
IsAggOfAgg(v) [ mt, call, IsAggOfAgg ] {
	Set val = $g($$$mtV(v))
	//only applies to aggregates
	If $e(val) '= "a" QUIT 0
	New call Set call = "IsAggOfAggLV^%qaqpsq"
	New IsAggOfAgg Set IsAggOfAgg = 0
	Do lviter^%qaqpnl("v", $p(val, "^", 5)) //iterate through aggregate expression
	Quit IsAggOfAgg
}
	
	
OutputHasFields(m) // Return 1 if $$$mtOutput(m) has any fields, else return 0
	new i,ii,val
	set i=0
	for  { set i=i+1,val=$p($$$mtOutputVals($g($$$mtOutput(m))),",",i) quit:'val  quit:$$checkf(val) }
	QUIT ''val
.
HavingHasFields(m) [ mt, call, found ] PUBLIC {
	Set h = $g($$$mtHaving(m))
	QUIT:'h 0
	New call Set call = "noagf^%qaqpag"
	New found Set found = ""
	Do lviter^%qaqpnl("l", h)
	QUIT $ll(found)>0
}
.
 // if this query block has pagination clause like TOP/LIMIT/FETCH or OFFSET
hasPagination(m) [mt] PUBLIC {
	if $g(m)="" { // checking any query layer, including the outermost
		RETURN:$d($$$mtTop)||$d($$$mtOffsetList)||$d($$$mtRowlimit)||$d($$$mtRowOffset) 1
	} else {
		RETURN:$d($$$mtTopArg(m))||$d($$$mtOffset(m)) 1
	}
	RETURN 0
}
.
 // if this query block or its subquery (children) has OFFSET
hasOffset(m,recursive=0) [mt] PUBLIC {
	RETURN:+$g($$$mtOffset(m)) 1
	if recursive { // check all its subquery
		for i=1:1:$$$mtPNumQbs {
			if $$$mtPQbParent($$$mtP(i))=m,$$hasOffset(i,1) { RETURN 1 }
		}
	}
	RETURN 0
}
.
checkf(n) ;recursive check of expressions for "f"
	QUIT:'n 0
	new v
	set v=$$$mtV(n)
	QUIT:"f"=$e(v) 1
	//i "v"=$$$mtVType($$$mtV(n)),$$checkf($p($$$mtV(n),"^",4)) QUIT 1
	//i "v"=$$$mtVType($$$mtV(n)) QUIT $$checkf($p($$$mtV(n),"^",5))
		// This code used to only check to see if there was a field in pieces 4 and 5, but some functions, like JSON_ARRAY, could have many more values to check to look for a field.
	if "v"=$e(v) {
		if $$checkf($p(v,"^",4)) RETURN 1
		new ii
		for ii=5:1 {
			quit:$p(v,"^",ii)=""
			RETURN:$$checkf($p(v,"^",ii)) 1
		}
	}
	QUIT 0
.
nexto(m) s i=i+1 ;  $$:  get the next entry from $$$mtOutput(m)
	#;  start with i=0, caller preserve its value between calls
	QUIT $p($$$mtOutputVals($g($$$mtOutput(m))),",",i)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;---------- DATA DICTIONARY ACCESS ----------
	#;  setshard will be 0 if called from fplanar^%qaqplansave and mt("fsave") is defined (which means this is a frozen plan for an insert/select query)
ddtab(tname,gvinput,viewschema,setshard=1,&tableschema) ;
	#;  $$:  1 if basetable, 0 if view, error(24) if neither
	#;       if view, set in .gvinput (by ref) the query text
	#;                set viewschema in .viewschema (by ref)
	QUIT:"CRV ALV CRF CRM CRP CRQ"[$$$mtStatementType 1  ;  CREATE/ALTER VIEW - no checking	// DPV2157 (No checking for CREATE PROC, etc. either
	new ex,iristempDB,iristempGblColl,iristempSFN,irn,locknode,name,procGblColl,savename,slist,ssplen,tabMapColl,ttype
	set savename=tname
.
		#;  Unqualified field names begin with a $c(1)
		#;  tname may be passed by reference, to add qualifier
	if $e(tname)=$c(1) {	//   It is an unqualified name, qualify it based on %defschema
		if callname="tablist" s tname=$e(tname,2,*),mtc(0,0,"tablist",tname)="" 	// DPV3227
		n cnt,i,found,qualtab,savetab,tab s (savetab,tab)=tname,cnt=0,found=0
			#; If there is a secha search path, look there first for the name qualification
		if $g(%sqlSchemaPath)'="" {	// DPV3410=
			for i=1:1:$ll(%sqlSchemaPath) {
				if $d(^rINDEXSQL("rv",$$$UPPER($lg(%sqlSchemaPath,i)),$$$UPPER($p(tab,$c(1),2)))) {
					s tname=$lg(%sqlSchemaPath,i)_"."_$p(tname,$c(1),2)  ; Add qualification to table name
					s found=1 q  // quit for loop
				}
			}
		}
			#; if no schema search path, or no match found in the schema search path, continue looking at the default schema(s)
			#; from the import list or the default schema setting.
		if 'found {
			for i=1:1:$ll(%defschema) {
				if $d(^rINDEXSQL("rv",$$$UPPER($lg(%defschema,i)),$$$UPPER($p(tab,$c(1),2)))) {
					s cnt=cnt+1 ; cnt is the number of schemas we found the table in
					s tname=$lg(%defschema,i)_"."_$p(tname,$c(1),2)  ; Add qualification to table name
				}
			}
			if cnt=0 {
				set tab=$e(tname,2,*),slist="",ssplen=0
				if $g(%sqlSchemaPath)'="" set ssplen=$ll(%sqlSchemaPath) f i=1:1:ssplen s $p(slist,",",i)=$$quoter2($lg(%sqlSchemaPath,i))
				f i=1:1:$ll(%defschema) s:(","_slist_",")'[(","_$lg(%defschema,i)_",") $p(slist,",",i+ssplen)=$$quoter2($lg(%defschema,i))
				d error(30)   ; Table not found, error 30 uses tname
			}
			if cnt>1 {	// error 43 display uses tab and slist (schema list)
				n tab s tab=$e(savetab,2,*)
				f i=1:1:$ll(%defschema) s $p(slist,",",i)=$$quoter2($lg(%defschema,i))
				d error(43)   ; Table ambiguous
			}
		}
		#; set ContextDependent=1 // DPV3369=
		s:info mtc(0,0,"some unqualified names")=1			// DPV1559
		set mt("unqualified-names")=1
	}
.
	if callname="tablist" { s mtc(0,0,"tablist",tname)="" }	//deferred compile mode
		// tname might get changed if this is JSON_TABLE()
	set irn=$$smdLoadGetIrn^%qTable(.tname,$g($$$mtTvf(m,savename))) do error(30):irn=""		// tname used in %qaqperr
	set ttype=$$$smdTType(irn)	// DPV3228 $$$smdGetTType(tname)
		#; If we loaded a table definition and the table has any CD or CI maps, report an error if the instance is not licensed for Columnar
		#; I don't check if "tablist" compile because "tablist" compiles don't report errors.
	if callname'="tablist",ttype=1,$$$smdHasColumnarMaps(1,irn),'$$ColumnarStorage^%SYS.LICENSE() { set tname=savename do error(157) }
	if ttype=3,$$$mtStatementType="DEL",$$$mtKTruncateFlag($g($$$mtK))=1 { set tname=savename do error("30g") }
.
	  #; if table isn't tuned, and caller is not TuneTable, tune it now before continuing with query
	if $get(tname)'="", 'info,ttype=1, ($g(%caller)="xDBC" || ($e($g(%caller),1,7)="Dynamic")), '$data(mt("options","TuneTable")),'$g(mt("options","NoAutoTune"),0),'$g(mt("options","parallelQuery"),0), $case($$$mtStatementType,"SEL":1,"DEC":1,:0), $$$smdSharded(1,irn)'=2, $$$smdIsATVF(1,irn)'=1, $$$smdConnection(1,irn)="", $$checkNoTLock(tname), '$$isTuned(irn), '$get($$$BuildSysFlag), $$$AdaptiveMode,$$$AutoTune,$$$smdTempTableType(1,irn)="",'$$skipAutoStatsCollection^%qarTune($$$smdClassname(1,irn)),$get(^IRIS.Temp.UnitState)="" {
		  #; try to get lock
		try{
			set locknode=tname
			Lock +^IRIS.AutoTune(tname):0
			if '$test {
				kill locknode
				set irn=$$smdLoadGetIrn^%qTable(.tname,$g($$$mtTvf(m,savename))) do error(30):irn=""		// tname used in %qaqperr
			} else {
			  #; if we got the lock, proceed to tuning the table
			  #; make sure that we want to tune this table
				if '$$isTuned(irn),'$select($extract(tname,1)="%":1,$$$smdSchema(ttype,irn)="INFORMATION_SCHEMA":1,1:0) {
				  	  #; proceed to tuning the table
				  	do ^%qarTune(tname,1,0,,,,,,,,,1)
		  		  	  #; rebuild smd after tuning table
					do $i(^||%sql.compcounter)	// Increment this counter so that smd will get refreshed.  COunt is originally set in comp^%qaqqt
					set irn=$$smdLoadGetIrn^%qTable(.tname,$g($$$mtTvf(m,savename))) do error(30):irn=""		// tname used in %qaqperr
				}
			}
		} catch(ex){}
	}
	if $data(locknode){
		kill locknode
		try { Lock -^IRIS.AutoTune($get(tname))#"I" }
			#; If this unlock gets a <PROTECT> error, we are most likely in a mirrored, read-online non-async database where locking is not allowed
		catch { if $ze["<PROTECT" {} else { throw }}
	}
.
		#;  if external table, send the whole query to the DSN
	If 'info,ttype=1 {	// It is a table, not a view
		n con s con=$$$smdConnection(1,irn)	// DPV3121=
	#; AK938
		#;  #define smdSharded(%x,%irn) ($g(^AK924($$$smdExtent(1,%irn)))=1)  ;  AK924
		#;  i con="",$$$smdSharded(1,irn) { s con="~",mt("shardext",m)=$$$smdExtent(1,irn) }  ;  AK924
		#;  determine if it's the top-sharded subquery
		#;i '$g(mt("shtop",m)),($$$smdSharded(1,irn)=1)||((m>1)&&($$$smdSharded(1,irn)=2)) { d setshard(m) }
		if setshard,'$g(mt("shtop",m)),($$$smdSharded(1,irn)=1) { do setshard(m) } ; JMM837
		s:$g(mt("shtop",m)) con=""  ;  ignore linked tables if sharding
	#; AK938-
	#; JLF071
		if '$d($$$mtDSNConnection) { s:con'="" extab=1,federated=0 }
		elseif con'=$g($$$mtDSNConnection) { s federated=1,extab=0 }
		s $$$mtDSNConnection=$s(federated:"",1:con)
	#; JLF071-
	}
	
	#;--------------------------------------------------------------------------------
	#;                         GLOBALS NLS COLLATION MISMATCH
	#;--------------------------------------------------------------------------------
	#; Collect mismatching NLS Collation information in the SQL parsing array
	#; 'mt("collationMismatch",...)' based on the following conditions: 
	#;   - If the NLS Collation for the globals in the 'IRISTEMP' database is 
	#;     different that of the globals in the current process.
	#;   - If the table specified by 'irn' has one or more Index Map whose global's
	#;     NLS Collation is different from that of the globals in the current
	#;     process.
	#; 
	#; NOTE: This information is used to disable SQL Parallel Processing when
	#;       the SQL parsing array 'mt("collationMismatch",...)' is defined!
	#;
	#; Processing Information
	#; ----------------------
	#; $ZU(23,1)        - The current process's NLS Collation Sequence for globals
	#;                    and arrays
	#; $ZU(49,<db-dir>) - A comma-delimited list of DB information. $LIST(,","):
	#;                      1 - The 'system file number' (sfn) (index into gfiletab)
	#;                          of the DB file, which exists and is now mounted
	#;                            ...
	#;                     13 - The default global NLS Collation sequence for the DB
	#;                          This default is used for all globals created in this DB
	#;                            ...
	#; $ZU(49,<sfn>,3)  - A carrot-delimited list of DB information. $LIST(,"^"):
	#;                      1 - The 'sysid' value:  
	#;                            { 0 = local DB | # = remote system id }
	#;                            ...
	#;                      5 - The default global NLS Collation sequence for the DB
	#;                          This default is used for all globals created in this DB
	#;                            ...
	#; ^%SYS("DBRefByName",<db-name>) - <implied namespace> for the given <db-name> 
	#;                                  (e.g. ^%SYS("DBRefByName","IRISTEMP")="^^c:\intersystems\projectssql\mgr\iristemp\")
	#;
	#; WHERE
	#;   <db>      ::= The IRIS database (DB) (e.g. IRIS.DAT)
	#;   <db-name> ::= The database (DB) name (e.g. "IRISTEMP")
	#;   <db-dir>  ::= The database (DB) physical directory for the given <db-name>
	#;                   $ZU(12)_<db-name> (e.g. "c:\intersystems\projectssql\mgr\IRISTEMP")
	#;   <sfn>     ::= The 'system file number' for the given <db-dir>
	#;
	#;   <system>            ::= The name of the IRIS System (e.g. $p($SYSTEM,":",1))
	#;   <implied namespace> ::= "^[<system>]^<db-dir>"
	#; 
	#;--------------------------------------------------------------------------------
	
	set procGblColl=$zu(23,1)  // The NLS Collation for the globals in the current process ($JOB)!
	set tabMapColl=$$$smdTableMapCollations(ttype,irn)
	set iristempSFN=+$zu(49,$p($g(^%SYS("DBRefByName","IRISTEMP")),"^",3))
	if iristempSFN'=-2 { // --- Process Valid 'sfn' (-2=<db-dir>/<db> doesn't exist) ---
		set iristempGblColl=$p($zu(49,iristempSFN,3),"^",5)  // The default NLS Collation for the globals in the 'IRISTEMP' DB!
		if iristempGblColl'=procGblColl,$g($$$mtCollationMismatchInIrisTemp)="" { // --- The NLS Collation for the Globals in the 'IRISTEMP' Database is different than that of the Globals in the Current Process ---
			do $i($$$mtCollationMismatchMarker)  // Bump the Collation Mismatch Marker!
			set $$$mtCollationMismatchInProcess=procGblColl
			set $$$mtCollationMismatchInIrisTemp=iristempGblColl
		}
	}
	if tabMapColl'="",'$match($p(tabMapColl,":",1),"("_procGblColl_",)*"_procGblColl_"$") { // --- The Table specified by 'irn' has an Index Map whose Global's NLS Collation is different from that of the Globals in the Current Process  ---
		new gblColl,gblCollList,gblNameList,pos
		do $i($$$mtCollationMismatchMarker)  // Bump the Collation Mismatch Marker!
		set $$$mtCollationMismatchInProcess=procGblColl
		
		set gblCollList=$p(tabMapColl,":",1),gblNameList=$p(tabMapColl,":",2)
		for pos=1:1:$l(gblCollList,",") { // --- Collect a List of all Mismatching NLS Collations as "<gbl name> (<nls coll>)[, <gbl name> (<nls coll>)]*" ---
			set gblColl=$p(gblCollList,",",pos)  // Index Map Global NLS Collation!
			set:gblColl'=procGblColl $$$mtCollationMismatchInTable(irn)=$g($$$mtCollationMismatchInTable(irn))_$p(gblNameList,",",pos)_" ("_gblColl_"), "  // Use this directly in the 'collationMismatch^%qaqplan(...) <warning> for ShowPlan/<explain statement>!
		}
		set $e($$$mtCollationMismatchInTable(irn),*-1,*)=""  // Remove trailing ", "
	}
	
	If ttype=1 {	// Base Table
		set tableschema=$$$UPPER($$$smdSchema(1,irn))
		If m=1,'$d(%insqry)," UPD DEL INS "[(" "_$$$mtStatementType_" "),$$$smdReadOnly(1,irn)="Y" d error(115)	// DPV2132=
		if info,$$$smdIsATVF(1,irn) {
			set mtc(0,0,"execute privs")=$g(mtc(0,0,"execute privs"))_$lb($lb($$$smdSchema(1,irn),$$$smdName(1,irn),$$$smdClassname(1,irn)))
		}
		// MJG291 - we don't reserve an extra node in smd to say something is a FT, we just only populate FT info for FTs. predicate pushdown will be 0 or 1 for all FTs -- only "" when not populated
		if $$$smdFTPredicatePushdown(1,irn) '= "" {
			new fdwClass,fdwSupportsPushdown,ftServer,pushdownType,pushdownTypeName
			do $i($$$ForeignTables)
			set fdwSupportsPushdown = +$$$smdFTPredicatePushdown(1, irn)
			set:$$$smdFTDefaultQuery(1,irn)'="" $$$FTDefaultQueryByName(tname) = $$$smdFTDefaultQuery(1,irn) 
			set ftServer = $$$smdFTServerName(1,irn)
			if ftServer'="" {
				do:'$$$comClassDefined(ftServer) error2(245, ftServer)
				set $$$FTServerByName(tname) = ftServer
				if '$d($$$FTServerArray(ftServer)) {
					// ftServer -- corresponds to SERVER param of the FT class -- is *class* name of the server, not 
					// SQL name, so we can plug it right in for ^oddCOM subscript
					set $$$FTServerSupportsDelIds(ftServer) = $$$comMemberKeyGet(ftServer,$$$cCLASSparameter, "DELIMITEDIDS", $$$cPARAMdefault)
					set fdwClass = $$$FTFDWFromFSClass(ftServer)
					set $$$FTServerFDWClass(ftServer) = $$getNewFdwClassNameFromOldClassName^%apiSQL(fdwClass)
					set $$$FTServerIsQueryable(ftServer) = fdwSupportsPushdown
					if fdwSupportsPushdown {
						// pushdown type is defined by the server, not the individual FT
						set pushdownTypeName = $$$comMemberKeyGet(ftServer,$$$cCLASSparameter,"PUSHDOWNTYPE",$$$cPARAMdefault)
						set pushdownType = $$$pushdownTypeNameToNumber(pushdownTypeName)
						set:pushdownType=-1 pushdownType = $$$OFF
					} else {
						set pushdownType = $$$OFF
					}
					set $$$FTServerPushdownType(ftServer) = pushdownType
				}
			}
			set $$$QueryBlockContainsFTs(m) = 1
		}
		QUIT 1
	}
	d ddvud($$$smdExtent(3,irn),.gvinput)
	s viewschema=$$$UPPER($$$smdSchema(3,irn)) 			// DPV1676
	s mt("view2",m+1,"co")=$$$smdViewCheckOption(irn)_"^"_irn	// DPV1693=
	RETURN 0
	
	#; checks whether or not a table is tuned
isTuned(irn) [] PUBLIC {
#if 1 ; DLP4269+
	if $$$smdTempTableType(1,irn) = "JSON_TABLE" {
		return 0
	}
#endif ; DLP4269-
	if $$$smdExtentSize(1,irn) '= 100000 {
		Return 1
	}
	set icol=""
	for {
		  #; go through the columns
		set icol=$order($$$smd(1,irn,"col",icol),1,ifn) quit:icol=""
.
		  #; If any column marked as needing tuning has a selectivity
		  #; value, then the table is (at least partially) tuned.
		if $$$comMemberArrayGet($$$smdClassname(1,irn),$$$cCLASSproperty,$$$smdColPropertyName(1,irn,ifn),$$$cPROPparameter,"CALCSELECTIVITY")'=0 {
			set sel=$$$smdColSelectivity(1,irn,ifn)
			if sel="NUMROWS" { continue }   // this field is unique, check next field
			if sel '= "" { Return 1 }       // found a non-unique field that has a selectivity
		}
	}
	  #; Otherwise, the table is not tuned.
	Return 0
}
	
ddvud(extent,input) [] PUBLIC {					// DPV2060 - rewrote function
		#;  Get query of a view definition into .input() (by ref)
	s input=$$$EXTsqlviewquery($$$rEXT,extent,0)
	For input=1:1:input s input(input)=" "_^(input)
	QUIT
}
.
	#; DLP3474
jsontcols()
	new jj, jsonColumns, jsonColumn
	set jsonColumns = ""
	if $$check("(") {
		for jj=1:1 {
			set jsonColumn = $Listbuild(value,lower)
			do skip("ID")
			set jsonColumn = jsonColumn _ $Listbuild($$datyp^%qaqpDDLParser(1))
			if $$checkid("PATH") {
				set jsonColumn = jsonColumn _ $listbuild(value)
				do skip(9)
			} else {
				set jsonColumn = jsonColumn _ $listbuild("")
			}
				// column is now fully constructed, add it to the output
			set jsonColumns = jsonColumns _ $Listbuild(jsonColumn)
			quit:'$$check(",")
		}
	}
	do skip(")")
	return "c"_jsonColumns
	#; DLP3474-
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK938
    #; PVA342: convert shardown to setshard; Can't guess subqueries to mark till have coshard structure
    #; TBD: When shardext is removed, inline this above ; JMM837
setshard(m)  ;  [public: irn,mt] mark mt("shtop") for m and all its subqueries
	#;  also set mt("shardext") (probably obsolete soon!!!)
	s mt("shtop",m)=m,mt("shardext",m)=$$$smdExtent(1,irn)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK938-
	
	// using=1 if this statement could have a USING clause
JSONParm(token,value,&jsonParen=0,&jsonCBrace=0,using=0) PUBLIC {
	if $d(%mmmJSONOBJECT) {   // Handle ":" within JSON_OBJECT differently than a ":" in an HVar
		if 'using {	// if USING <json> there should be no parenthesis
			set:token="(" jsonParen=jsonParen+1
			set:token=")" jsonParen=jsonParen-1
			kill:jsonParen=0 %mmmJSONOBJECT
		} else {
			set:token="{" jsonCBrace=jsonCBrace+1
			set:token="}" jsonCBrace=jsonCBrace-1
			kill:jsonCBrace=0 %mmmJSONOBJECT
		}
	}
	if token="ID",value="JSON_OBJECT",'$d(%mmmJSONOBJECT) { set %mmmJSONOBJECT=1, jsonParen=0 }
	if using,token="USING",'$d(%mmmJSONOBJECT) { set %mmmJSONOBJECT=1,jsonParen=0,jsonCBrace=0,%delid=1 }
}
.
#; YCL196
checkNoTLock(table) PUBLIC {
	set schema=$$$AllButLastPiece(table,"."),tablename=$tr($$$LastPiece(table,"."),$c(2),".")
	RETURN:(schema="")||(tablename="") 0
	set extentname=$$$GetExtentNameFromTableName(schema,tablename)	
	RETURN:(extentname="") 0
	set extents=$$FlattenIrnTree^%ocsSQLRTDict(extentname)
	set firstExtent=$lg(extents)
	#; check if this ^oddEXTR(firstExtent,"NoT") has been locked or not
	try{
		RETURN ($zutil(156,40,$namespace,"^oddEXTR",firstExtent,"NoT")="")
	} catch ex {
		#; YCL211 - Prevent <PROTECT> error on backup mirror member 
		if ex.Name="<PROTECT>" { RETURN 0 }
 		else { THROW ex }	
	}
}
#INCLUDE %qaqplex
#INCLUDE %fcalpha
#INCLUDE %quoter
.
