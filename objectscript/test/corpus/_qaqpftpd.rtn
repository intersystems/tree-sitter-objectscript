%qaqpftpd	// Analyze parse-tree for foreign table pushdown
	;; COMPONENTS :: SQL/PreOptimizer
	#;
#INCLUDE %msql
.
#IF 0   ;-------------------------------------------------------------
	; Description:   Analyze parse-tree for foreign table pushdown, isolating components of the query that can be 
    ;               reconstructed for external databases and removed from the local parse tree structure.
	; Author:        Michael Golden
	; Date Started:  August 22, 2025 (most of the logic already existing and excised from %qaqpqo)
#ENDIF ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
.
	/// TODOFT - Change all loops to use this for more efficient $find traversal?
 #; These macros defined to make $find loops over some delimited string easier. See usage throughout.
#define FLOOPInit 							set nextDelimiterPos=0
#define FLOOPNext(%loopOver,%delimiter) 	set prevDelimiterPos=nextDelimiterPos, nextDelimiterPos = $f(%loopOver,"^",prevDelimiterPos)  QUIT:'nextDelimiterPos
#define FLOOPGetItem(%loopOver) 			$e(%loopOver,prevDelimiterPos,nextDelimiterPos-2)
.
/// Introduced by MJG291
///
///	Go through each query block that's been marked as containing foreign table and create fake streams for each contained
/// foreign table stream, optionally containing JOINs, WHERE conditions, aggregates, GROUPing, HAVING, row limiting, 
///	ordering, distinct, custom SELECT entries.
foreignTablePushdown() [ linx, mt, nulstr, ftLateralFields ] PUBLIC {
	// set information about outer join right-hand-sides, this is done later in the QP but should be safe for our
	// purposes to do it ahead of time
	new nulstr, ftLateralFields
	set nulstr = ""
	for qb=1:1:$$$mtPNumQbs {
		do:$$$mtPQbIsActive(qb) setnulstr^%qaqpnl(qb)
	}
.
	// If an FT precedes a lateral stream in the FROM, it will have its entire pushdown resolved before we can evaluate 
    // lateral references. So, ahead of any QB analysis, find which FT streams have lateral references in the QB. Then 
    // later we can add those to SELECT lists in evaluateQueryBlockForFT()
	set val = ""
	for {
		set val = $o($$$mtV(val), 1, v)
		QUIT:val=""
		if $e(v)="x",v=("x^"_+$e(v,3,*)),v'="x^0" { 
			set field = $p(v,"^",2)
			set stream = $p($$$mtV(field),"^",2)
			set ftLateralFields(stream) = $g(ftLateralFields(stream))_field_","
		}
	}
	
.
	/* -------- (1) Evaluate all query blocks - builds mt("ft", "pushdown") -------- */
	set index = ""
	for {
		set index = $o(mt("qbo", index), 1, qb)		// "qbo" = QBs in nested order, always check outer QB before inner
		QUIT:index=""
		CONTINUE:'$$$mtPQbIsActive(qb)
		CONTINUE:'$d($$$QueryBlockContainsFTs(qb))
		CONTINUE:+$g($$$FTQBAdoptedSubquery(qb))	// already adopted fully as a subq of another PDU so must've analyzed it on a previous pass
		
		do evaluateQueryBlockForFT(qb)
	}
	
	/* -------- (2) Move each pushdown unit (each is 1 block of queryable FTs) into its own "foreign stream" -------- */
	set pushdownUnit = ""
	for {
		set pushdownUnit = $o($$$FTPDU(pushdownUnit))
		QUIT:pushdownUnit=""
		CONTINUE:$d($$$FTPDURemoved(pushdownUnit))		// assigned this PDU at the start but it got collapsed into another one via a JOIN
		set qb = $$$FTPDUOldQueryBlock(pushdownUnit)
		CONTINUE:+$g($$$FTQBAdoptedSubquery(qb))		// included fully as subq of some outer FTQB, won't get its own unit
		
		do createFakeStreamForPushdownUnit(pushdownUnit)
	}
	
	do calcQBOrder^%qaqpnl(1)		// make sure our temp QBs don't mess up the order
	do cleanParseTree()				// remove analysis-only subscripts to avoid polluting parse tree
.
	RETURN
}
.
.
/// Evaluate one whole query block containing foreign tables to determine pushability of the foreign tables in that QB.
///	####################################################################################################################
///	---- Parameters ----
///		qb			- query block under evaluation
///	####################################################################################################################
/// ---- Returns ----
///		1		- 	The whole QB is pushable as *one entire subquery to the specified server*. This is used when an 
///					outer FT query block wants to check if this query block, which is e.g. the argument of an 
///					IN condition, can be pushed as part of the outer query's regeneration.
///		0		- Something in this QB prevents it from being regenerated *in whole* to the specified server.
///
///	The return value is not important when called at the top level of foreignTablePushdown(), but the behavior 
///	internally is mostly the same. If the whole QB is pushable (and the larger structure it belongs to is pushable)
/// then the FT streams in this query block will never be moved into their own streamed view. That is not the concern 
/// of this procedure. Once called for a QB, this should not need to be called again (but should never be dangerous if 
/// it is called multiple times). This proc must evaluate the *entire* FT-containing query block, and should not terminate
/// prematurely. 
///
/// IMPORTANT NOTE on "pushable" vs "includable" for items/clauses. Pushable means it can be pushed in some way to 
/// an external server - this may mean only as a subquery. Includable means it can be included in a regeneration unit
/// without being in a subquery. Essentially, includable = (pushable AND no correlated refs). Some things this does not
/// apply to - for example DISTINCT is simple and it is either includable+pushable or neither.
evaluateQueryBlockForFT(qb) [ ftLateralFields, linx, mt, nulstr ] {
	RETURN:($$$FTQBEvaluated(qb, pushableAsSubquery)) +pushableAsSubquery		// already evaluated this QB
	set pushableAsSubquery = 1
	
	/* -- Assign each stream in this QB to a pushdown unit -- 
		Do this up front because the pushdown logic requires each
		condition/item/etc. in this query block to know which, if
		any, of the units in this query block it can be assigned to */
	do assignPushdownUnits(qb)
	
	
	
	set whereIsPushable = $$evaluateWHEREforFT(qb)
	set selectListIsPushable = $$evaluateSELECTforFT(qb)
	set groupByIsPushable = $$evaluateGROUPBYforFT(qb)
	set havingIsPushable = $$evaluateHAVINGforFT(qb)
	set orderByIsPushable = $$evaluateORDERBYforFT(qb)
.
	/* -------- (6) Evaluate JOIN conditions -------- 
		Make sure we SELECT fields which only appear in JOIN conditions. Need to do it ahead of any final analysis of 
        aggregation/SELECT so that we know there are items we have added to the SELECT list which would need to appear 
        in the GROUP BY of the correspond query	*/
	//do evaluateJoinConditions(qb)
	
	// The clauses may have reported some information about corr refs, local refs. Make sure they're noted on the QB
	do mergeClauseInformationToContainingQuery(qb)
	
	// Finish analysis of SELECT aggregates, GROUP BY, HAVING
	do finishAggregationAnalysis(qb, .aggregationClausesPushable, .aggregationClausesIncludable)
	
	/* This variable will be true as long as the rest of the query is ok enough to theoretically allow a distinct 
		or ORDER BY to be included in its own pushown unit regen. Will still need to make the decision to actually DO so
		based on other specific info later.
	*/
	set potentiallyIncludeDistinctAndOrderBy 	= 	$$$FTQBClauseIncludable(qb,$$$WHERE)
													&& $$$FTQBClauseIncludable(qb,$$$SELECT)
													&& aggregationClausesIncludable
													&& '+$g($$$FTQBContainsLocalReference(qb))
													&& ($$$FTQBNumPushdownUnits(qb) = 1)
	
	
	set includeDistinct = potentiallyIncludeDistinctAndOrderBy && '$g($$$FTQBDistinctBy(qb))
	// only include the order by if we include the distinct
	set includeOrderBy = includeDistinct && $$$FTQBClauseIncludable(qb,$$$ORDERBY)
	set topVal = $$rowLimitHelper(qb, .topStyle, .offset)
	set includeTop = ('topVal && 'offset) || includeOrderBy
	if 'includeTop { 
		// bidirectional...
		set includeOrderBy = 0
		// in case ORDER BY cols get added to the SELECT
		set includeDistinct = 0
	}
	// if there's ORDER BY and a DISTINCT, then the values in the ORDER BY must all be SELECTed
	if includeOrderBy, includeDistinct, $g($$$FTQBClause(qb,$$$ORDERBY))'="", $g($$$FTQBSimpleDistinct(qb)) {
		if '$$orderByExpressionsAppearInSelect(qb) {
			set includeOrderBy = 0, includeDistinct = 0, includeTop = 0
		}
	}
	if 'includeOrderBy {
		// remove from this pushdown unit's regeneration structure
		do disincludeClauseForFtPushdown(qb, $$$ORDERBY)
	}
.
.
	/* 
		All of these actions must go together - some individual clauses may have been disincluded already due to 
		their own inconsistency, but e.g. a GROUP BY clause might need to be disincluded here because the HAVING 
		turned out to be bad. Calling disinclude*() multiple times is ok, and should remain so in future changes. 
		
		This set of actions does NOT imply that this query block is not pushable as a subquery. Subquery pushability
		is determined already by the ability to push each clause. The below set of actions needs to be taken if 
		we determine that THIS query block can't contain all of these clauses if it were to be pushed on its own. 
		That is often related, but at times distinct, from its pushability as a subquery. 
		
		Note we are checking ORDER BY again here. ORDER BY could become unpushable after the final aggregation analysis
		but its own validation relies on the aggregation analysis so it must follow it. If ORDER BY is disincluded and
		it contains aggregates then we need to do this last minute aggregation invalidation as well.
	*/
	if 'aggregationClausesIncludable || ('includeOrderBy && $d($$$FTQBClauseAggregateArray(qb, $$$ORDERBY))) {
		do disincludeClauseForFtPushdown(qb, $$$GROUPBY)
		do disincludeClauseForFtPushdown(qb, $$$HAVING)
		do disincludeAggregatesForFtPushdown(qb)
		// Update this var if order by + aggs is reason for this invalidation
		set:aggregationClausesIncludable aggregationClausesIncludable = 0
	} else {
		// HAVING clause may have had subqueries, since the HAVING will definitely regenerate its subqueries now, 
		// we need to mark them as adopted
		if $g($$$FTQBClause(qb, $$$HAVING)) '= "" {
			do adoptSubqueries("l", +$$$FTQBClause(qb, $$$HAVING))
		}
	}
.
	/*  - Up to now the SELECT of each PDU is a local array, turn into finalized lists and add in aggregates (if any).
		- Mark for DISTINCT, TOP handling
	*/
	do finalizeAllClauses(qb, aggregationClausesIncludable, includeOrderBy, includeDistinct, includeTop)	// except joins...
	// Ok - determined how each FT will look if pushed individually, but how about this entire qb to potential outer-qb suitors?
	// So don't use "includable" flags here, just pushable
	set pushableAsSubquery = $$$FTQBClausePushable(qb,$$$WHERE)
							&& $$$FTQBClausePushable(qb,$$$SELECT)
							&& $$$FTQBClausePushable(qb,$$$ORDERBY)
							&& aggregationClausesPushable					// comprises GROUP, HAVING, aggregates
							&& '$g($$$FTQBDistinctBy(qb))
							//&& topStyleOk
							&& ('$g($$$FTQBClause(qb, $$$ORDERBY)) || $d($$$mtTopArg(qb)))	// ORDER BY in subquery must have TOP!
							&& '$g($$$mtUnionTopQb(qb))
	set $$$FTQBPushable(qb) = pushableAsSubquery
	RETURN pushableAsSubquery
}
.
.
/// Assign pushdown units to the foreign tables in the given query block by strategically pushing certain joins within
assignPushdownUnits(qb) [ ftLateralFields, impjns, linx, mt ] PRIVATE {
		// Begin with naive assignment of one PDU to every queryable FT stream
		// NB: %ptrel(m^label)=stream#
	set mlabel = qb_"^", joinPushdown = 1
	for {
		set mlabel = $o($$$ptrel(mlabel), 1, stream)
		QUIT:+mlabel'=qb		
		if '$d($$$FTByOriginalStream(stream)) {  	// non-FT stream
			set $$$FTQBContainsLocalReference(qb) = 1
			CONTINUE
		} 
			// The whole logic is for determining predicates we might be able to push down for logical reconstruction,
			// if this ft stream is not queryable, we should just continue. For any portion of this logic, these
			// non-queryable FTs will be treated as local references
		set server = $$$FTServerByOriginalStream(stream)
		// continue if this foreign server does not accept SQL queries (e.g. CSV file)
		if '$$$FTServerIsQueryable(server) {
			set $$$FTQBContainsLocalReference(qb) = 1
			CONTINUE
		}
		/* 	Use contrived pushdownUnit numbers to track info in the parse tree. Each stream maps to one unit at any given
			time but each PDU might map to multiple streams depending on pushdown of joins (represented as local array)
		 	Each unit tracks all info needed for ONE foreign table regeneration, handled by 
			createFakeStreamForPushdownUnit() (i.e. one pushdown unit <-> one foreign stream) 	*/
		if '$d($$$FTOriginalStreamToPushdownUnit(stream), pushdownUnit) {
			set pushdownUnit = $i($$$FTPushdownUnits)
			set $$$FTOriginalStreamToPushdownUnit(stream) = pushdownUnit
			set $$$FTPDUServer(pushdownUnit) = server
			set $$$FTPDUOneStream(pushdownUnit, stream) = ""	// with join pushdown each pushdown unit is potentially multiple streams
			set $$$FTPDUOldQueryBlock(pushdownUnit) = qb
		}
		$$$FTQBAddPushdownUnit(qb, pushdownUnit)
		// track the foreign servers involved in this query so an outer query can ensure pushability of the query
		if '$d($$$FTQBAssociatedServer(qb, server)) {
			do $i($$$FTQBAssociatedServerCount(qb))
			set $$$FTQBAssociatedServer(qb, server) = 1
		}
		set $$$FTPDUType(pushdownUnit) = $$$FTServerPushdownType(server)
.
		// LATERAL FIELD RESOLUTION - Does this stream have fields that act as lateral references for later subqueries? 
		// Then right off the bat, it will need to SELECT them. Note we do this here because the structure of the SELECT
		// is mt(qb, val)=PDU - we don't have PDUs until now. If we ever allow JOIN pushdown in these cases, we will 
		// have to update collapsePushableNodes() to remap the PDU set here if it gets collapsed into another PDU
		if $d(ftLateralFields(stream), lateralFields) {
			set joinPushdown = 0	
			for i=1:1:$l(lateralFields,",")-1 {
				set lateralField = $p(lateralFields,",",i)
				QUIT:lateralField="" // in case
				set $$$FTQBClauseItem(qb, $$$SELECT, lateralField) = pushdownUnit
			}
		}
	}
	
		// if there are no ANSI-style JOINs, or there are JOINs other than ANSI-style JOINs, or we need to avoid join PD for
		// some other reason then just use the naive assignment
	if '$d($$$mtOnRoot(qb)) || $d(impjns) || ($g(linx) '= "") || 'joinPushdown {
		set joinPushdown = 0
		do evaluateJoinConditions(qb)	// still need to gather information, e.g. fields needed to be SELECTed
	}
		// parents() is union-find-esque data structure. Built along with the joinTree() and helpful if passed along
		
	do constructJoinTree(qb, .joinTree, .parents)
	do:joinPushdown analyzeJoinTree(qb, .joinTree, .parents)
		// call this even if no join pushdown - it should probably be renamed as it handles general fake stream assignment
		// and also handles rewiring of mt("ON") and mt("from") in the future query blocks
	do reconstructFromJoinTree(qb, .joinTree, .parents)
	
	RETURN
.
}
.
.
/// Given query block qb, turn the mt("ON") clause into a operator tree that represents the ANSI JOINs within. The operator
/// tree is a full binary tree that represents the JOINs in the query according to some particular ordering. It takes the
/// following format:
///
///		joinTree(<node-id>) = $lb(<left-node-id>, <right-node-id>, <join-type>, <base-table-stream>, <conditions>, <pushdown-units>, <local-tables-present>, <pushable>, <ON-table-names>)
///
/// Where:
///
///		<left-node-id>, <right-node-id> :=  <node-id> of the left / right side of this node, respectively. Since this is 
///											a full binary tree, either both <left-node-id> and <right-node-id> are 
///											defined, or both are null. If both are null, this is a leaf node and must be 
///											a base table.
///				<node-id>				:= IDs of nodes in the tree.
/// 	<join-type> 					:= One of $$$BASETABLE, $$$LEFT, $$$FULL, $$$INNER, $$$CROSS (RIGHT already translated to LEFT). BASE represents a base table
/// 	<base-table-stream> 			:= $$$mtRNumStreams stream # only populated for $$$BASETABLE type
/// 	<conditions> 					:= A list of mt("l") conditions involved in the JOIN
/// 	<pushdown-units>				:= $bit string representing the pushdown units (PDUs) involved in that node. We 
///											will leave these blank - except for BASETABLE nodes - until PDUs start to get merged in analyzeJoinTree()
///											as they are dependent on what's beneath them, and it's easier to wait
///											for lower structures in the tree to be finalized instead of having to go back
///											and rewire later
/// 	<local-tables-present> 			:= 1/0 flag, whether the node contains local tables
///		<pushable>						:= 1/0 flag, whether the node is considered pushable as one unit, with this JOIN node in the FROM clause
///		<ON-table-names>				:= $lb of table labels in the node similar to mt("ON") style, is used for rebuilding
///											the mt("ON") clause
///
///	Note: useful to utilize the macros defined in %msql which contain $$$jtXXX macros for join tree indices in the $lb
///
///	---- Parameters ----
///		qb			- query block
///		joinTree	- (PBR) Built by this procedure and returned by reference here. Multidimensional array in the format
///						specified above which represents JOIN operators in a full binary tree structure.
///		parents			- (PBR) Built by this procedure and returned by reference. See 'Auxiliary structures' below for more
///						information.
///
/// ===== Auxiliary structures =====
///		This algorithm uses a union-find style data structure in order to take a stream (or node) and find its parent node
/// 	as already determined in the join operator tree. This requires tracking stream and node IDs and takes the form:
///			parents("stream", stream#) = <node-id>, if <node-id> represents the parent JOIN node above the stream
/// 		parents("node", stream#) = <node-id>, if <node-id> represents the parent JOIN node above the stream
constructJoinTree(qb, &joinTree, &parents) [impjns, linx, mt] PRIVATE {
	set onClauseIdx = ""
	for {
		set onClauseIdx = $o($$$mtOn(qb, onClauseIdx), 1, onClauseData)
		QUIT:onClauseIdx=""
		/* 	getJoinNodeFromTableList() will create new base-table nodes, if necessary. But base node is only created 
			if the list itself is one element because that is a new table in the list. If we see a table not present in 
			parents() but not alone, it is likely because of a scenario like:
					
					A LEFT JOIN B CROSS JOIN C LEFT JOIN D 
			
			which has an mt("ON") like:
					
					mt("ON", 1) = $lb(A), $lb(B)
					mt("ON", 2) = $lb(A,B,C), $lb(E)		<-- C comes out of nowhere
			
			When this happens, we should add in CROSS JOIN nodes for all the new tables. Need to watch this for
			right hand side as well e.g.:
					
					A LEFT JOIN B CROSS JOIN C RIGHT JOIN D
					mt("ON", 1) = $lb(A), $lb(B)
					mt("ON", 2) = $lb(D), $lb(A,B,C)		<-- C comes out of nowhere, but on the right
		*/
		set leftTables = $li(onClauseData, 3)
		set leftNode = $$getJoinNodeFromTableList(qb, leftTables, .joinTree, .parents)
		
		set rightTables = $li(onClauseData, 4)
		set rightNode = $$getJoinNodeFromTableList(qb, rightTables, .joinTree, .parents)
		
			// Gather info needed to set a new node in joinTree() for this JOIN
		set newNodeId = $i(joinTree)
		set conditions = $li(onClauseData, 2)
		set joinType = $$$joinTypeNameToShorthand($li(onClauseData, 1))
		set containsLocalTable = ($$$jtNodeContainsLocalTable(leftNode) || $$$jtNodeContainsLocalTable(rightNode))
			
			/* Add to join tree, update parents() so left and right child reflect new node as their parent. This new node
				starts as top of new subtree by definition, until some higher node is added with it as a child. Setting
				new node as its own parent in parents() accomplishes this. */
		set joinTree(newNodeId) = $lb(leftNode, rightNode, joinType, "", conditions, "", containsLocalTable)
		set (parents("node", newNodeId), parents("node", leftNode), parents("node", rightNode)) = newNodeId
	}
	
	RETURN
}
.
.
/// Given a list of tables representing either the left side or right side of tables in an mt("ON") index $list, get 
/// the current top-level node of the subtree in joinTree that this list of tables represents a previous JOIN of.
/// For example, in the following query (these are all abbreviated without conditions etc to focus on main concepts):
///
///		A LEFT JOIN B LEFT JOIN C CROSS JOIN D LEFT JOIN E
///
///	The mt("ON") will look like:
///	
///		mt("ON", qb, 1) = $lb("LEFT",,$lb("A"), $lb("B"))
///		mt("ON", qb, 2) = $lb("LEFT",,$lb("A", "B"), $lb("C"))
///		mt("ON", qb, 3) = $lb("LEFT",,$lb("A", "B", "C", "D"), $lb("E"))    <-- note how 'D' appears seemingly from nowhere
///
/// This procedure could be given the list $lb("A", "B") and will return the existing node in our joinTree() of operators
/// that represents the LEFT join between A and B, so that we can add a JOIN between that node, and C.
///
/// IMPORTANT: If a table in the list isn't present in the join tree, it is added by this procedure. If the table is
/// the only table in the list, then only a representative $$$BASETABLE node will be added to the join tree. If the table 
/// is not alone in the list, it should be from a scenario like index 3 above, in which case this procedure
/// will insert this table into the list by adding CROSS JOIN(s) to the joinTree as necessary to make it work.
///
/// INPUT:
///		qb					- query block under investigation
///		tableList			- $lb of table names involved in one side of a JOIN, as in the mt("ON") clause
///		joinTree 			- (PBR) current join operator tree structure. Potentially altered by this procedure. See constructJoinTree() for more.
///		parents					- (PBR) union-find-esque data structure. Potentially altered by this procedure. See constructJoinTree() for more.
getJoinNodeFromTableList(qb, tableList, &joinTree, &parents) [ mt ] PRIVATE {
        // Must loop over entire list due to note above re:CROSS JOINs
    set ptr=0, prevTable=""
    while $listnext(tableList, ptr, tableName) {
		set streamNumber = $$$ptrel(qb_"^"_tableName)
			// Table not seen before, need to add a base node for it
		if '$d(parents("stream", streamNumber)) {
			set newNodeId = $$addBaseTableNode(streamNumber, .joinTree, .parents)
			if prevTable'="" {    // Must have been a previous JOIN node for some part of this list so add this as RHS of a cross join with that earlier node
				set prevBaseNode = $$tableNameToBaseNode(qb, prevTable, .parents)
				set prevParentNode = $$getParentJoinNode(prevBaseNode, .joinTree, .parents)
				do addCrossJoinNode(prevParentNode, newNodeId, .joinTree, .parents)
			}
            $$$listnextPeekAhead(tableList,ptr,nextTable,hasNext)
			if hasNext {   // Some table after us in the list, check if it's already part of a join subtree
				set nextBaseNode = $$tableNameToBaseNode(qb, nextTable, .parents)
				if +nextBaseNode {  // Only add CROSS JOIN if table after us was already seen in a previous list, if not we'll handle it as we progress through the list
					set nextParentNode = $$getParentJoinNode(nextBaseNode, .joinTree, .parents)
					do addCrossJoinNode(newNodeId, nextParentNode, .joinTree, .parents)
				}
			}
		}
        set prevTable = tableName
	}
.
		// every table in the list is now in the tree, get the parent node of the last one (or first, or really whoever)
	set baseNode = $$tableNameToBaseNode(qb, prevTable, .parents)
	RETURN $$getParentJoinNode(baseNode, .joinTree, .parents)
}
.
.
/// Given a table name, return its base node representation in the join tree
///
///	---- Parameters ----
///		tableName		- Name of the table. E.g. "SQLUSER.T1"
///		parents				- (PBR) structure for tracking parents of nodes. See constructJoinTree()
///
///	---- Returns ----
///		The node ID in the join tree that is associated with the base node that represents this table within the tree.
///		OR "" if the table does not have a corresponding base node in the tree yet.
tableNameToBaseNode(qb, tableName, &parents) [mt] PRIVATE {
	set streamNumber = $$$ptrel(qb_"^"_tableName)
	RETURN $g(parents("stream", streamNumber))
}
.
/// Helper procedure for constructJoinTree(). See that procedure to understand the parents parameter data structure. Given
/// a node ID, recurses through parents() to locate the operator node that is the highest level parent.
///
/// INPUT:
///		node				- node ID in the tree for which we want to find the toplevel parent node of.
///		joinTree 			- (PBR) current join operator tree structure. See constructJoinTree() for more.
///		parents					- (PBR) union-find-esque data structure. See constructJoinTree() for more.
///
///	---- Returns ----
///		the node id # of the operator node that is the (current) top parent.
///		"" if the node is not in the tree
getParentJoinNode(node, &joinTree, &parents) [mt] PRIVATE {
	RETURN:'$d(parents("node", +node)) ""		// not a node in the tree
	
	while (parents("node", node) '= node) {
		set node = parents("node", node)
	}
	
	RETURN node
}
.
.
/// Helper function to take the given stream and add a node to the join tree that represents that stream as a base node.
///
/// ----- Parameters -----
///		streamNumber		- $$$mtRNumStreams stream number for the table we are adding to the join tree
///		joinTree		- (PBR) join tree structure so which we need to add a node for this stream
///		parents				- (PBR) disjoint set structure to track parents of nodes
///
///	----- Returns -----
///		The new node id representing the base node added to the tree
addBaseTableNode(streamNumber, &joinTree, &parents) [mt] PRIVATE {
	RETURN:$d(parents("stream", streamNumber), nodeId) nodeId		// in case already there don't do anything
	
	set nodeId = $i(joinTree)
	// The join tree node needs to be set up with info about what the node contains w.r.t. local tables/pushdown units
	set pushdownUnits = ""
	set localTable = '$d($$$FTByOriginalStream(streamNumber))
	if 'localTable {
		// FT, so determine PDU info or leave it as local table if not a queryable FT
		set server = $$$FTServerByOriginalStream(streamNumber)
		if $$$FTServerIsQueryable(server) {
			set localTable = 0
			set pushdownUnit = $$$FTOriginalStreamToPushdownUnit(streamNumber)
			set $bit(pushdownUnits, pushdownUnit) = 1
		} else {
			set localTable = 1
		}
	}
	set joinTree(nodeId) = $lb("", "", $$$BASETABLE, streamNumber, "", pushdownUnits, localTable, 'localTable)
	set parents("stream", streamNumber) = nodeId		// link the stream to this node
	set parents("node", nodeId) = nodeId				// start the node as its own parent to show it's the top of a "subtree" (...consisting of only itself right now)
	
	RETURN nodeId
}
.
.
/// Add a CROSS JOIN between the leftNode and rightNode into the joinTree. leftNode and rightNode are existing node IDs 
/// in the joinTree structure.
///
/// ---- Parameters ----
///		leftNode		- Node id of the left side of this CROSS JOIN
///		rightNode		- Node id of the right side of this CROSS JOIN
///		joinTree		- (PBR) join stree structure. See constructJoinTree()
///		parents				- (PBR) disjoint set parent structure. See constructJoinTree()
///
///	---- Returns ----
///		The ID of the node added to the joinTree to represent this cross join
addCrossJoinNode(leftNode, rightNode, &joinTree, &parents) [mt] PRIVATE {
	set:'parents("node",leftNode)=leftNode leftNode = $$getParentJoinNode(leftNode, .joinTree, .parents)		// get top level if not already
	set:'parents("node",rightNode)=rightNode rightNode = $$getParentJoinNode(rightNode, .joinTree, .parents)		// get top level if not already
	
	set containsLocalTable = ($$$jtNodeContainsLocalTable(leftNode) || $$$jtNodeContainsLocalTable(rightNode))
	set newNodeId = $i(joinTree)
	set joinTree(newNodeId) = $lb(leftNode, rightNode, $$$CROSS, "", "", "", containsLocalTable, 0)
	set (parents("node", newNodeId), parents("node", leftNode), parents("node", rightNode)) = newNodeId
	
	RETURN newNodeId
}
.
.
/// For the given JOIN operator tree (joinTree), analyze the nodes of the tree to discover when a given node represents a JOIN that
/// can be cohesively pushed to one external server. If not simple (e.g. node doesn't all belong to one server), we 
/// attempt to apply associative identities to the nodes of the tree to rearrange nodes into an order that allows
/// pushing JOINs that are otherwise not next to each other.
///
/// Algorithm proceeds in a Depth First Search style using a stack. Stack "operations" are implemented by way of tags
/// at the bottom of the procedure that can work on local variables
///
/// ---- Parameters ----
///		qb				- query block
///		joinTree		- (PBR) multidimensional array representing an operator tree of joins in qb. See constructJoinTree() for more information on the structure.
///		parents         - (PBR) union-find-esque data structure that can be used to track parents of nodes. See constructJoinTree() for more information on the structure.
///
/// ---- Returns ----
///     Nothing.
analyzeJoinTree(qb, &joinTree, &parents) [mt] PRIVATE {
	RETURN:'$d(joinTree)
	set mlabel = qb_"^"
	for {	// Loop over %ptrel and find top-level node of some subtree. Need to check every stream, e.g. (... FROM A join B, C join D ...) could be two trees
		set mlabel = $o($$$ptrel(mlabel), 1, stream)	// NB: %ptrel(m^label{.name})=stream#
		QUIT:+mlabel'=qb
		set baseNode = $g(parents("stream", stream))
		CONTINUE:'baseNode	// e.g. table from FROM list that is not involved in any explicit ANSI joins
		set parentNode = $$getParentJoinNode(baseNode, .joinTree, .parents)
		CONTINUE:'parentNode    // stream not involved in any JOIN tree i.e. solo tables in a comma list e.g. 'c' in {a join b, c}
		CONTINUE:$d(visited(parentNode))
		/* ---- DFS from the parent node down to leaf nodes and begin coalescing into JOINs ---- 
			It's ok not to kill visited() set between each DFS because node #s will be distinct between subtrees anyway, 
			and we should keep it b/c it's useful for the %ptrel loop above. This is so in a structure like 
			(... FROM A join B, C join D ...) we only evaluate the A-B tree on A, and not again on B. */
		kill stack
		do stackPush(.stack, parentNode)	// initialize stack for DFS helper
		for {
			set node = $$joinTreeDFSNextNode(.joinTree, .stack, .visited), pushable = 1
			QUIT:'node
			CONTINUE:($$$jtNodeJoinType(node)=$$$BASETABLE)	    // nothing to do with simple base tables
			set leftChild = $$$jtNodeLeftChild(node), rightChild = $$$jtNodeRightChild(node)	// no base tables, these should exist		
			if ('$$$jtNodePushable(leftChild) || '$$$jtNodePushable(rightChild)) {		// children must be pushable
				set pushable = 0
			}
			if $$$jtNodeContainsLocalTableGet(node) {		// local table immediately disqualifies this node
				set pushable = 0
			}
			if pushable {	// if children were pushable, they each have one PDU, so 1 server + no local tables
				set leftServer = $$$FTPDUServer($bitfind($$$jtNodePDUs(leftChild),1,0))
				set rightServer = $$$FTPDUServer($bitfind($$$jtNodePDUs(rightChild),1,0))
				set:(leftServer '= rightServer) pushable = 0 	// both sides must go to the same server to combine them
			}
				// And check all conditions in the ON clause
			set conditions = $$$jtNodeConditionsGet(node)
			$$$FLOOPInit
			for {
				$$$FLOOPNext(conditions,"^")
				set condition = +$$$FLOOPGetItem(conditions)
				CONTINUE:'condition
				do exploreItemForPushdown(qb, condition, "l")			// Must explore every condition even if already not pushable - we need info about underlying fields etc.
				if pushable, '$$validateExploredConditionForON(.joinTree, node, condition, leftServer) {	// only need to validate every condition if still possibly pushable
					set pushable = 0
				}
			}
.
			/* ========== TODO - This is where we would do associative identities if not already pushable ========== */
.
.
			if pushable {	// === Good to go - turn this node into one pushdown unit === 
				do collapsePushableNodes(.joinTree, .oldToNewPDU, node, qb)
			} else {
					// both children of this node must represent their own PDUs (or they have similar subtrees) so
					// the PDUs in this node are a merge of all PDUs in subnodes
				set leftPDUs = $$$jtNodePDUs(leftChild), rightPDUs = $$$jtNodePDUs(rightChild)
				set $$$jtNodePDUs(node) = $$$MergePushdownUnits(leftPDUs, rightPDUs)
					// Track fields needed in JOIN conditions to go into SELECT lists of relevant pushdown units. At this 
					// point, anything further down in the join tree is settled - those pushdown units will not change
				set conditions = $$$jtNodeConditionsGet(node)
				$$$FLOOPInit
				for {
					$$$FLOOPNext(conditions,"^")
					set condition = +$$$FLOOPGetItem(conditions)
					CONTINUE:'condition
					do addUnderlyingFieldsToSelectLists(qb,"l",condition)
				}
			}
			
			set $$$jtNodePushable(node) = pushable
		}
	}
.
		// Everything done, fix up stream->PDU mappings for any streams originally in a now-collapsed PDU. Need to do 
		// this last -- and not mid-tree-traversal -- so we don't have to traverse down again to all leaf node base tables to update their mapping 
		// every time we collapse a joinTree node into one PDU, 
		//
		// Actually, we should do this in collapsePushableNodes() because exploreItem() above needs to now about the most up
		// to date PDUs when it sets underlying fields
	#; set stream = ""
	#; for {
	#; 	set stream = $o($$$FTOriginalStreamToPushdownUnit(stream),1,oldPDU)
	#; 	QUIT:stream=""
	#; 	set:$d(oldToNewPDU(oldPDU), newPDU) $$$FTOriginalStreamToPushdownUnit(stream) = newPDU
	#; }
	
	RETURN
}
.
.
.
/// Given the provided node and condition, determine whether the condition is pushable as part of regenrated JOIN  
/// represented by this node in the join tree.
///
/// This is only called by analyzeJoinTree(). Due to that, it is assumed this procedure is called on conditions only when
/// the rest of the structure of the node is pushable. This allows us convenient assumptions such as there being a right
/// and left child node, those nodes having exactly one pushdown unit and no local tables.
///
///	Parameters:
///		joinTree			- (PBR) Full binary tree representing joins. See constructJoinTree()
///		node				- The node in the joinTree that this condition belongs to, needed to get info about children
///		condition			- mt("l") condition (that has already been explored by a call to exploreItemForPushdown())
///								for which we need to make a decision about its validity
///		server				- The server the nodes would be pushed to. This is valid because of the simplifying assumptions
///								mentioned above which imply that we will only be in this procedure if both left and 
///								right child nodes will be going to the same server
///
///	Returns:
///		1/0 whether this condition can be considered a valid ON clause condition for pushing.
validateExploredConditionForON(&joinTree, node, condition, server) [mt] PRIVATE {
	#; RETURN 1	// for testing purposes, just return true always for now
	
	RETURN:(+$g($$$FTServerPushdownType(server))=$$$OFF) 0	// Pushdown OFF
	RETURN:(+$g($$$FTServerPushdownType(server)) < +$g($$$FTItemMostPermissiveOperatorType("l", condition))) 0	// More permissive operators than the server allows
	RETURN:+$g($$$FTItemUnsupportedDatatypes("l", condition)) 0		// item has an unsupported datatype somewhere
	RETURN:$d($$$FTItemUnsupportedOperators("l", condition)) 0		// operator not allowed by any pushdown type
	RETURN:$d($$$FTItemSubqueries("l", condition)) 0				// no subqueries in join conditions period for now
.
	RETURN 1
	
	// TODOFT how to handle NULL predicates? we may not need to handle this until the associative identity work is done
	// because any given join node condition set should only contain conditions relevant to the tables within their
	// subtree, which at this point are already analyzed and have been approved or else we would not be here
	#; 	|| (+$g($$$FTItemInterestingNullBehavior(lv,item)) && ($d($$$FTItemNullStreamFieldArray(lv,item))))	// involves a field from RHS of LOJ and is subject to potentially interesting null behavior
.
}
.
.
/// Helper for analyzeJoinTree() that collapses the given binary JOIN node of the joinTree into one pushdown
/// unit. I.e. it will update the assignment of pushdown units so that the JOIN represented by this node (+ all of its
/// children) will be contained by one pushdown unit. It does this by arbitrarily choosing the PDU of the left child and
/// carrying it forward as the PDU assigned to this entire node, overwriting the right child PDU where necessary in the mt()
/// pushdown structure, in the joinTree, and in the oldToNewPDU map.
///
///	Parameters:
///		joinTree		- (PBR) binary tree representation of joins. see constructJoinTree
///		oldToNewPDU		- (PBR) auxiliary structure used by analyzeJoinTree to keep track of when some node in the joinTree
///							has been combined into a pushed JOIN and thus assigment of PDUs needs to be rerouted with old
///							PDUs mapping to new PDUs. I.e. oldToNewPDU(oldPDU) = newPDU
///		node			- The node in joinTree that is being collapsed into a pushable join
///		qb				- the QB in which the join tree lives
collapsePushableNodes(&joinTree, &oldToNewPDU, node, qb) [mt] PRIVATE {
		// To be here for 'node', L+R must be pushable -> L+R were also previously collapsed -> should guarantee one left PDU + one right PDU
	set leftChild = $$$jtNodeLeftChild(node), rightChild = $$$jtNodeRightChild(node)
	set keepPDU = $bitfind($$$jtNodePDUs(leftChild),1,0)	// arbitrary choice: keep the left PDU, "delete" the right PDU
	set replacePDU = $bitfind($$$jtNodePDUs(rightChild),1,0)
	set $$$FTPDURemoved(replacePDU) = 1
	
	/* ==== Remap PDU references ==== */
	set oldPDU = ""
	for {	// first, for any previously collapsed PDU in the map, if "new" pdu is now the PDU getting collapsed, update the mapping
		set oldPDU = $o(oldToNewPDU(oldPDU),1,newPDU)
		QUIT:oldPDU=""
		if newPDU = replacePDU {
			set oldToNew(oldPDU) = keepPDU
		}
	}
		// add entry to map for this
	set oldToNewPDU(replacePDU) = keepPDU
		// make sure all streams that were mapped to the old PDU will reflect the new one
	set stream = ""
	for {
		set stream = $o($$$FTPDUOneStream(replacePDU,stream))
		QUIT:stream=""
		set $$$FTOriginalStreamToPushdownUnit(stream) = keepPDU
		set $$$FTPDUOneStream(keepPDU,stream) = ""
	}
	kill $$$FTPDUStreams(replacePDU)
		// and remap what the query block thinks it contains
	set $bit($$$FTQBPushdownUnits(qb), replacePDU) = 0
	set $bit($$$FTQBPushdownUnits(qb), keepPDU) = 1
		// and make sure the node for which we replaced its PDU now specifies the new PDU within
	set replacedNodeBits = $$$jtNodePDUs(rightChild)
	set $bit(replacedNodeBits, replacePDU) = 0
	set $bit(replacedNodeBits, keepPDU) = 1
	set $$$jtNodePDUs(rightChild) = replacedNodeBits
		// set up our internal PDUs, which will start off with this one PDU
	set $bit(thisNodeBits, keepPDU) = 1
	set $$$jtNodePDUs(node) = thisNodeBits
		// and make sure all conditions in this JOIN and the right child join have their associated-PDU lists updated
	set conditions = $$$jtNodeConditionsGet(node)
	set conditions = conditions_$$$jtNodeConditionsGet(rightChild)
	$$$FLOOPInit
	for {
		$$$FLOOPNext(conditions,"^")
		set condition = +$$$FLOOPGetItem(conditions)
		CONTINUE:'condition
		set $bit($$$FTItemAssociatedPDUs("l",condition), replacePDU) = 0
		set $bit($$$FTItemAssociatedPDUs("l",condition), keepPDU) = 1
		set underlyingField = ""
		for {
			set underlyingField = $o($$$FTItemUnderlyingField("l",condition,underlyingField),1,oldUnderlyingPDU)
			QUIT:underlyingField=""
			set:$d(oldToNewPDU(oldUnderlyingPDU),newUnderlyingPDU) $$$FTItemUnderlyingField("l",condition,underlyingField) = newUnderlyingPDU
		}
	}
	
	RETURN
}
.
.
/// Helper function to perform a DFS on the joinTree. State is maintained in stack (driver of the DFS) and the visited()
/// set.
///	
///	The algorithm always starts by popping a node from the stack. If neither child of that node have been visited, it will
///	push itself BACK onto the stack (to be processed again in the future), then push its children onto the stack, and continue.
///	If there are no children, or the children are visited, then it will add this node to the visited set and return it as
///	the next node to be analyzed.
///
///	---- Parameters ----
///		joinTree		- (PBR) Operator tree of joins in some query block being analyzed. See constructJoinTree() for structure.
///		stack			- (PBR) Stack that maintains the state needed to drive iterative DFS algo. Can use stackPush() and
///							and stackPop() helper procedures for traversal
///		visited			- (PBR) multidimensional array used to determine if a node has been analyzed.
///		
///
/// ---- Returns ----
///		A node ID in joinTree() that is next in the DFS traversal. 0 if the given joinTree has been fully traversed.
joinTreeDFSNextNode(&joinTree, &stack, &visited) [] PRIVATE {
	set node = +$$stackPop(.stack)
	RETURN:'node 0
	while (node) {
		set joinType = $$$jtNodeJoinType(node)
		set leftChild = $$$jtNodeLeftChild(node)
		set rightChild = $$$jtNodeRightChild(node)
		//		base table				left child visited or undefined				right child visited or undefined
		if (joinType = $$$BASETABLE) || ((leftChild="" || $d(visited(leftChild))) && (rightChild="" || $d(visited(rightChild)))) {
				// This node can be returned to the caller to analyze
			set visited(node) = ""
			RETURN node
		} else {
				// We need to continue recursing, add node back to stack so we see it again later and then add its
				// children and continue
			do stackPush(.stack, node)
			do:(rightChild'=""&&'$d(visited(rightChild))) stackPush(.stack, rightChild)
			do:(leftChild'=""&&'$d(visited(leftChild))) stackPush(.stack, leftChild)
		}
		set node = +$$stackPop(.stack)
	}
	
	// loop returns directly if it finds a valid node, so if here, there is nothing left
	RETURN 0
}
.
/// Helper function for FT join operator tree traversal. Pushes 'node' onto the top of the stack. Node is assumed to
/// be a join operator node ID, though fundamentally can be anything.
stackPush(&stack, node) [] PRIVATE {
	set stack($o(stack(""), -1) + 1) = node
}
.
.
/// Helper function for FT join operator tree traversal. Pops an element from the top of the stack and returns it.
/// ---- Returns ----
///		Node ID (#) of a JOIN in the join operator tree
stackPop(&stack) [] PRIVATE {
	set stackLevel = $o(stack(""), -1, poppedNode)
	if stackLevel '= "" {
		kill stack(stackLevel)
	} else {
		set poppedNode = ""
	}
	RETURN poppedNode
}
.
.
/// Given query block and the join operator tree, turn that operator tree into our internal representation of JOINs
/// in the mt("ON") structure. It will stay in a holding place until it's ready to move into the actual mt("ON")
/// structure later. For example, might not do it if the subquery ends up adopted and will be regenerated in full
/// because we don't want to mess with the actual query structure then. Note that we need to keep track of two different
/// types of on clause structure - one is for the "ON" clause that would be inside the pushdown unit, and one is for
/// the "ON" clause in the actual query which will reflect pushdown-unit-fake-streams as some of its sources
///
/// The algorithm will DFS down to start with the lowest nodes of the join tree. Once it encounters a node which is
/// pushable, everything beneath it will be built into an mt("ON") that can be include in the PDU represented by
/// that node. All other nodes will be built up as mt("ON") for the actual query.
///
/// When encountering a $$$CROSS node, we will just add the tables for the RHS of the cross to a running table list,
/// because these are not actually represented in mt("ON") explicitly
///
///	Note - This logic actually builds the future mt("ON")/mt("from") clauses -- of both the contrived pushdown unit QB, and the original
///			QB where the FTs are being removed from -- in a staging area, that is only then populated later on after
///			pushdown analysis is done.
///
///	Parameters:
///		qb 			- query block
///		joinTree	- (PBR) tree of joins; see constructJoinTree(). might actually contain multiple distinct subtrees
///		parents		- (PBR) structure used to trace parents of nodes so we can start at the top of a given join tree
reconstructFromJoinTree(qb, &joinTree, &parents) [mt] PRIVATE {
	// TODOFT could probably combine this logic with analyzeJoinTree and only do one DFS over the tree but would be
	// tricky
	set ptr = 0
	while $listnext($$$mtFromList(qb),ptr,label) {
		set mlabel = qb_"^"_label
		set stream = $$$ptrel(mlabel)
			// if a base node for table exists, it's in the joinTree; if not, it's only in the "from" list i.e. it's
			// originally CROSS JOINed in (or comma list) and not part of a LEFT/FULL/INNER etc join
		set baseNode = +$g(parents("stream", stream))
		if baseNode {	// reconstruct "ON" based on the parent node!
			set parentNode = $$getParentJoinNode(baseNode, .joinTree, .parents)
			do:'$d(visited(parentNode)) reconstructONFromNode(qb, parentNode, .joinTree, .parents, .visited)
		} else {	// no "ON" - just add to mt("from")
			set localTable = '$d($$$FTByOriginalStream(stream))
			if 'localTable {	// foreign table so needs to be replaced with fake stream
				set server = $$$FTServerByOriginalStream(stream)
				if $$$FTServerIsQueryable(server) {								// if queryable, needs fake stream created; otherwise, treated as local
					set pdu = $$$FTOriginalStreamToPushdownUnit(stream)
					set $$$FTPDUfrom(pdu) = $g($$$FTPDUfrom(pdu))_$lb(label)	// build "from" of the pushdown unit, which will have original label
					set label = $$$FakeStreamPrefix_pdu										// and reset label from the QB's POV, which will be fake stream
				}
			}
			set $$$FTQBfrom(qb) = $g($$$FTQBfrom(qb))_$lb(label)
		}
	}
}
.
.
/// Given the specified node in the join tree, reconstruct the subtree that it creates into an mt("ON") structure. This 
/// focused on building from the perspective of the real query block, i.e. the actual mt("ON"). When a node is encountered
/// that is fully pushable, this will dispatch to another procedure to build the entire mt("ON")/("from") for the given
/// pushdown unit. Then back here, it will slot this into the current qb
reconstructONFromNode(qb, parentNode, &joinTree, &parents, &visited) [mt] PRIVATE {
	kill stack
	do stackPush(.stack, parentNode)	// initialize stack for DFS helper
	for {
		set node = $$stackPop(.stack)
		QUIT:'node
			// if pushable, this will be an entire unit so we can dispatch and stop going down that path
		if +$$$jtNodePushableGet(node) {	// need to do Get() here, we might have skipped the analyze() portion (which sets pushability) if not doing join pushdown
			set label = $$turnJoinSubtreeIntoPushdownStream(qb, node, .joinTree, .parents, .visited)
			set label = $lb(label)
			set $$$FTQBfrom(qb) = $g($$$FTQBfrom(qb))_label		// this basically acts as a new base stream
			set $$$jtNodeTableNames(node) = label				// and the whole node gets this as its table name list
			CONTINUE
		} else {
			set leftChild = $$$jtNodeLeftChild(node)
			set rightChild = $$$jtNodeRightChild(node)
			if ((leftChild'="" && '$d(visited(leftChild))) || (rightChild'="" && '$d(visited(rightChild)))) {
					// Need to DFS further, add node back to stack to see it again later, then add children and continue
					// Add right then left so left child gets processed first necessary?
				do stackPush(.stack, node)
				do:(rightChild'=""&&'$d(visited(rightChild))) stackPush(.stack, rightChild)
				do:(leftChild'=""&&'$d(visited(leftChild))) stackPush(.stack, leftChild)
				CONTINUE
			}
				// If here, 'node' is next to do and is ready to be processed. All cases will add 'table names' list
				// to the join tree node. Other side effects differ by case
			set visited(node) = ""
			set joinType = $$$jtNodeJoinType(node)	// avoid repeated list access
			if joinType = $$$BASETABLE {
					// just add to "from"
				set stream = $$$jtNodeBaseStream(node)
				set labels = $lb($$strtoname^%qaqpre2(stream))
				set $$$FTQBfrom(qb) = $g($$$FTQBfrom(qb))_labels
			} elseif joinType = $$$CROSS {
					// Just combine table names together but don't add to ON or FROM
				set labels = $$$jtNodeTableNames(leftChild)_$$$jtNodeTableNames(rightChild)
			} else {
				// i.e. LEFT/FULL/INNER - real joins that appear in ON. Add "ON" index for them
				set leftLabels = $$$jtNodeTableNames(leftChild)
				set rightLabels = $$$jtNodeTableNames(rightChild)
				set idx = $i($$$FTQBmtON(qb))
				set $$$FTQBmtONidx(qb,idx) = $lb($$$joinTypeShorthandToName(joinType), $$$jtNodeConditions(node), leftLabels, rightLabels)
				set labels = leftLabels_rightLabels
			}
			set $$$jtNodeTableNames(node) = labels		// add table names list to node
		}
	}
}
.
.
/// Does a DFS and reconstruction for a join subtree that is entirely pushable. It will be represented in the outer (real)
/// query block as a fake stream.
turnJoinSubtreeIntoPushdownStream(qb, node, &joinTree, &parents, &visited) [mt] PRIVATE {
	// within here we are building a single pushdown JOIN stream so we can safely assume we have one pushdown unit
	set pdu = $bitfind($$$jtNodePDUs(node),1)
	kill stack
	do stackPush(.stack, node)	// We start our own stack within here, doing our own DFS
	for {
		set node = $$stackPop(.stack)
		QUIT:'node
		set leftChild = $$$jtNodeLeftChild(node)
		set rightChild = $$$jtNodeRightChild(node)
		if ((leftChild'="" && '$d(visited(leftChild))) || (rightChild'="" && '$d(visited(rightChild)))) {
				// Need to DFS further, add node back to stack to see it again later, then add children and continue
				// Add right then left so left child gets processed first necessary?
			do stackPush(.stack, node)
			do:(rightChild'=""&&'$d(visited(rightChild))) stackPush(.stack, rightChild)
			do:(leftChild'=""&&'$d(visited(leftChild))) stackPush(.stack, leftChild)
			CONTINUE
		}
			// Ready to process node
		set visited(node) = ""
		set joinType = $$$jtNodeJoinType(node)	// avoid repeated list access
		if joinType = $$$BASETABLE {
				// just add to "from"
			set stream = $$$jtNodeBaseStream(node)
			set labels = $lb($$strtoname^%qaqpre2(stream))
			set $$$FTPDUfrom(pdu) = $g($$$FTPDUfrom(pdu))_labels
		} elseif joinType = $$$CROSS {
				// Just combine table names together but don't add to ON or FROM
			set labels = $$$jtNodeTableNames(leftChild)_$$$jtNodeTableNames(rightChild)
		} else {
			// i.e. LEFT/FULL/INNER - real joins that appear in ON. Add "ON" index for them
			set leftLabels = $$$jtNodeTableNames(leftChild)
			set rightLabels = $$$jtNodeTableNames(rightChild)
			set idx = $i($$$FTPDUmtON(pdu))
			set $$$FTPDUmtONidx(pdu,idx) = $lb($$$joinTypeShorthandToName(joinType), $$$jtNodeConditions(node), leftLabels, rightLabels)
			set labels = leftLabels_rightLabels
		}
		set $$$jtNodeTableNames(node) = labels		// add table names list to node
	}
	RETURN $$$FakeStreamPrefix_pdu
}
.
.
/// Now that all of the clauses in the query have been analyzed, we need to circle back and make
/// sure that aggs/grouping/having etc can be pushed. This means:
///		- Each clause (WHERE etc) must be pushable
///				This does not include SELECT/ORDER BY, we could do them locally unless they contain bad aggs, but this
///				is tracked via $$$FTQBDisableAggregates() and not via the clause pushability
///		- Number of pushdown units must be 1
///		- No local references
///		- No correlated references
///		- Aggregates must not be disabled (e.g. because an analysis found that there was an IRIS-only agg somewhere)
///		- GROUP BY must contain all non-aggregated fields
///
///	---- Returns ----
///		1/0 whether we can indeed push the aggs etc. or not
finishAggregationAnalysis(qb, &pushable, &includable) [ mt ] {
	set pushable = 1, includable = 1
	// if there were no aggregates, no group by, no having then there's no aggregate analysis to do here. Aggregates
	// in the ORDER BY or DISTINCT BY will be handled separate
	if '$d($$$FTQBClauseAggregateArray(qb, $$$SELECT))
		&& '$d($$$FTQBClauseAggregateArray(qb, $$$ORDERBY))
		&& ($g($$$FTQBClause(qb, $$$HAVING)) = "")
		&& ($g($$$FTQBClause(qb, $$$GROUPBY)) = "")
	{
		RETURN
	}
	if $$$FTQBNumPushdownUnits(qb) > 1 { 
		set pushable = 0
		set includable = 0
		GOTO exitEarly
	}
	for clause = $$$WHERE, $$$GROUPBY, $$$HAVING {
		if '+$g($$$FTQBClausePushable(qb,clause)) {
			set pushable = 0
			set includable = 0
			GOTO exitEarly
		} elseif '+$g($$$FTQBClauseIncludable(qb, clause)) {
			set includable = 0
		}
	}
	
	// Can't push aggregates if the ORDER BY had some and isn't pushable itself	
	// We will need to do another check for this later as well, because the ORDER BY may become unpushable
	// after this due to other factors too.
	if $d($$$FTQBClauseAggregateArray(qb, $$$ORDERBY)) {
		if '+$g($$$FTQBClausePushable(qb, $$$ORDERBY)) {
			set pushable = 0
			set includable = 0
			GOTO exitEarly
		} elseif '+$g($$$FTQBClauseIncludable(qb, $$$ORDERBY)) {
			set includable = 0
		}
	}
	if +$g($$$FTQBContainsLocalReference(qb)) {
		set pushable = 0
		set includable = 0
		GOTO exitEarly
	}
	if +$g($$$FTQBDisableAggregates(qb)) {
		set pushable = 0
		set includable = 0
		GOTO exitEarly
	}
	if '$$validateFieldsAppearInGroupByForFT(qb) {
		set pushable = 0
		set includable = 0
		GOTO exitEarly
	}
.
exitEarly
	RETURN
}
.
.
/// Expressions in the ORDER BY must appear in the DISTINCT (select) list. If they don't then we can't push the distinct
/// or the order by. Other DBs enforce this with an error.
orderByExpressionsAppearInSelect(qb) [mt] {
	set orderBy = $g($$$FTQBClause(qb,$$$ORDERBY))
	for i=1:1:($l(orderBy, ",")-1) {
		set val = $p(orderBy, ",", i)
		QUIT:val=""
		set valNumberOnly = +val
		if '$d($$$FTQBClauseItem(qb,$$$SELECT,valNumberOnly)) {
			RETURN 0
		}
	}
	RETURN 1
.
}
.
.
/// Determine what parts of the WHERE clause can be pushed
/// WHERE is different from other clauses because of the order of SQL query operations. WHERE
/// comes first. This means once we determine that a top-level (i.e. ANDed) condition in the WHERE clause
/// can be pushed, there is NO reason to undo that linkage. 	
///
/// Same cannot be said for clauses such as GROUP BY, aggs in the SELECT etc. If there are two pushdown 
/// units in a given query, either due to two separate queries we have to send to server(s), or a non-pushable FT,
/// or a local IRIS table etc., then we cannot push these clauses, as there is no one server that they need to
/// go to (i.e. the results are impacted by all streams). We may be able to be smarter about this in 
/// the future such as: streamless expr's regenerated for all servers, pushing aggs in certain very limited cases
/// for a PDU that is e.g. the left-most PDU in a left outer equijoin on a unique key etc. For now, no. 	
/// 
/// ---- Parameters ----
///		qb			- query block of the parse tree we are evaluating the WHERE clause of
///
/// Whenever we're here and isPushableCondition needs to dispatch to evaluateQB, it should reset the top-level condition that 
/// pushable QBs are staged under to be the top-level AND condition from that new QB WHERE clause
///
///	---- Returns ----
///	    1 if the entire WHERE clause is pushable, 0 if some condition in the WHERE is not pushable
///		Via parse tree:
///			- A cache entry in mt("ft", "pushdown", pushdownUnit, "w") = mt("w") style WHERE clause
evaluateWHEREforFT(qb) [ mt ] {
	RETURN:$$$FTQBClauseEvaluated(qb, $$$WHERE, whereClausePushable) whereClausePushable
	
	set whereClausePushable = 1
	set whereClauseIncludable = 1
	
	/* Loop over conditions. There's a difference between reporting as pushable and being includable. In the query: 
	
			SELECT t1.c1 FROM t1 WHERE t1.c2 > ANY (SELECT t2.c2 FROM T2 WHERE ~T2.C3=T1.C3~) 
		
		The condition ~T2.C3=T1.C3 is not includable because it can never be included in this pushdown unit,
		as it references an outer pushdown unit. It is still PUSHABLE though, because it is simply a commparison
		of two fields, and may be pushable as part of the outer query block if T1.C3 belongs to the outer unit. */
	for condIdx=1:1:($l($g($$$mtWhere(qb)),"^") - 1) {
		set condition = $p($$$mtWhere(qb), "^", condIdx)
		do exploreItemForPushdown(qb, condition, "l")
		do validateExploredConditionForWHERE(qb, condition, .pushable, .includable, .pushdownUnit)
		if includable {
			// Link with the 1 pushdown unit the condition references
			set $$$FTPDUClause(pushdownUnit, $$$WHERE) = $g($$$FTPDUClause(pushdownUnit, $$$WHERE))_condition_"^"
			//	Deactivate the qbs adopted by this parent condition, they won't get their own pushdown unit
			do adoptSubqueries("l", condition)
		} else {
			set whereClauseIncludable = 0
			set:'pushable whereClausePushable = 0
			do addUnderlyingFieldsToSelectLists(qb, "l", condition)
			do releaseSubqueries("l", condition)
		}
		// Bring corr refs and local refs into the WHERE clause so they can be tracked by the QB it belongs to
		do mergeItemInformationToClause("l", condition, $$$WHERE, qb)
	}
.
	set $$$FTQBClausePushable(qb, $$$WHERE) = whereClausePushable
	set $$$FTQBClauseIncludable(qb, $$$WHERE) = whereClauseIncludable
	RETURN whereClausePushable
}
.
.
/// Given an explored condition in mt("l") for query block qb, determine pushability and includability for the condition
/// based on a number of factors about the top level condition.
///
/// ---- Parameters ----
///		qb 					- The qb of the WHERE clause the condition belongs to
///		condition			- Condition # of mt("l")
///		pushable			- (PBR) The condition can be pushed as part of some PDU. This includes being pushed only
///								if part of a subquery contingent on some outer query. This is the case with conditions
///								that involve correlated references
///		includable			- (PBR) Can be regenerated as a standalone condition on some PDU in its own query block.
///								This is slightly more restrictive than pushable because a condition with correlated ref
///								may be pushable as part of an outer query, but it will never be includable in the WHERE
///								clause of some pushdown unit in its own query block.
///		pushdownUnit		- (PBR) All includable conditions must belong to one PDU. This will return the PDU of the
///								one PDU this condition returns to if includable. If not, will hold ""
validateExploredConditionForWHERE(qb, condition, &pushable, &includable, &pushdownUnit) [ mt ] PRIVATE {
	set pushable = 1
	do validateExploredItemCommon(qb, condition, "l", .pushable, .pushdownUnit)
	if pushable {
		/* 
			TODOFT-improvement - Our handling of interesting null behavior could be improved for conditions in the WHERE
				clause. Options include: if a condition involves a null stream field and it is not an IS [NOT] NULL 
				condition, we could push the condition and still evaluate it locally as well (to make sure we are 
				sufficiently restrictive on the final joined result set). We might not want to do this for conditions 
				involving subqueries because then we will still be evaluating the entire subquery locally anyway.
				
				Another solution would push the condition to the external server and then add a local condition in the form
				of an IS NOT NULL condition, since all other predicates should evaluate to false on a NULL field from the
				joined result set.  
		*/
.
		/* ----	Validate the subqueries under this condition, stop looping once one is bad  ---- */
		set server = $$$FTPDUServer(pushdownUnit)
		set subquery = ""
		for {
			set subquery = $o($$$FTItemSubquery("l", condition, subquery))
			QUIT:subquery=""
			// subq must be pushable, have 1 server (same one as this PDU), and be under a permitted subquery operator
			if +$g($$$FTQBAssociatedServerCount(subquery)) '= 1 
				|| (server '= $o($$$FTQBAssociatedServer(subquery, ""))) 
				|| ('+$g($$$FTQBPushable(subquery)))
				|| ('+$g($$$FTItemSubqueryPushableOperator("l", condition, subquery)))
			{
				set pushable = 0
				GOTO exitEarly
			}
		}
	}
exitEarly
	set includable = pushable && ($$$FTItemNumCorrelatedPDUs("l", condition) = 0)
	RETURN
}
.
.
/// Given the mt("v") index 'val', confirm whether or not it can be pushed in some way as part of a SELECT list
///
/// ---- Parameters ----
///		qb					- The qb of the SELECT list
///		val					- mt("v") index that we are looking at
///		pushable			- (PBR) specifies whether this item can be considered pushable
///		includable			- (PBR) specifies if this item can be included in the SELECT list of a pushdown unit in its 
///								own query block. A bit more restrictive than pushable because corr refs not includable
///		pushdownUnit		- (PBR) if includable, this item will belong to exactly one pushdown unit, which will be
///								return in this parameter. Otherwise it will be ""
validateExploredValueForSELECT(qb, val, &pushable, &includable, &pushdownUnit) [ mt ] PRIVATE {
	set pushable = 1
	do validateExploredItemCommon(qb, val, "v", .pushable, .pushdownUnit)
	// might contain correlated references (ok?)
	if pushable {
		// no subqueries in the SELECT
		if $d($$$FTItemSubqueries("v", val)) {
			set pushable = 0
			GOTO exitEarly
		}
		
		if $d($$$FTItemUnpushableAggregates("v", val)) {
			set pushable = 0
			GOTO exitEarly
		}
	}
exitEarly
	set includable = pushable && ($$$FTItemNumCorrelatedPDUs("v", val) = 0)
	RETURN
}
.
/// Given the mt("v") index 'val', confirm whether or not it can be pushed in some way as part of an ORDER BY claus
///
/// ---- Parameters ----
///		qb					- The qb of the ORDER BY list
///		val					- mt("v") index that we are looking at
///		pushable			- (PBR) specifies whether this item can be considered pushable
///		includable			- (PBR) specifies if this item can be included in the ORDER BY list of a pushdown unit in its 
///								own query block. A bit more restrictive than pushable because corr refs not includable
///		pushdownUnit		- (PBR) if includable, this item will belong to exactly one pushdown unit, which will be
///								return in this parameter. Otherwise it will be ""
validateExploredValueForORDERBY(qb, val, &pushable, &includable, &pushdownUnit) [ mt ] PRIVATE {
	set pushable = 1
	do validateExploredItemCommon(qb, val, "v", .pushable, .pushdownUnit)
	if pushable { 
		if $d($$$FTItemUnpushableAggregates("v", val)) {
			set pushable = 0
			GOTO exitEarly
		}
		// no streamless - validaExploredItemCommon() is only approving streamless if there's exactly one pushdown
		// unit in the query block and no local refs in the query block - this should be fine everywhere.
		// if '$$$FTItemNumAssociatedPDUs("v",val) {
		// 	set pushable = 0
		// 	GOTO exitEarly
		// }
		// subqueries are ignored for order by so maybe could just ignore and then still push?
		if $d($$$FTItemSubqueries("v", val)) {
			set pushable = 0
			GOTO exitEarly
		}
	}
exitEarly
	set includable = pushable && ($$$FTItemNumCorrelatedPDUs("v", val) = 0)
	RETURN
}
.
.
/// Given the mt("v") index 'val', confirm whether or not it can be pushed in some way as part of a GROUP BY
///
/// ---- Parameters ----
///		qb					- The qb of the GROUP BY clause
///		val					- mt("v") index that we are looking at
///		pushable			- (PBR) specifies whether this item can be considered pushable
///		includable			- (PBR) specifies if this item can be included in the GROUP BY of a pushdown unit in its 
///								own query block. A bit more restrictive than pushable because corr refs not includable
///		pushdownUnit		- (PBR) if includable, this item will belong to exactly one pushdown unit, which will be
///								return in this parameter. Otherwise it will be ""
validateExploredValueForGROUPBY(qb, val, &pushable, &includable, &pushdownUnit) [ mt ] PRIVATE {
	set pushable = 1
	do validateExploredItemCommon(qb, val, "v", .pushable, .pushdownUnit)
	if pushable {
		// GROUP BY more restrictive than some other clauses - we don't allow expressions right now. For some other
		// vendors you will get an error if you have GROUP BY expression(col) and you reference col nakedly elsewhere
		// in the query, but allowed to mention expression(col) elsewhere. It's simpler to just disallow entirely
		if $$$FTItemHasAnyOperators("v", val) {
			set pushable = 0
		}
		// no streamless - we don't want to generate SELECT agg()...GROUP BY ?. If someone puts a constant in the 
		// group by (meaningless) it will shut off their aggregate pushdown
		if '$$$FTItemNumAssociatedPDUs("v",val) {
			set pushable = 0
		}
	}
.
	set includable = pushable && ($$$FTItemNumCorrelatedPDUs("v", val) = 0)
	RETURN
}
.
/// Given an explored condition in mt("l") for query block qb, determine pushability and includability for the condition
/// in a HAVING clause.
///
/// ---- Parameters ----
///		qb 					- The qb of the HAVING clause the condition belongs to
///		condition			- Condition # of mt("l")
///		pushable			- (PBR) The condition can be pushed as part of some PDU. This includes being pushed only
///								if part of a subquery contingent on some outer query. This is the case with conditions
///								that involve correlated references
///		includable			- (PBR) Can be regenerated as a standalone condition on some PDU in its own query block.
///								This is slightly more restrictive than pushable because a condition with correlated ref
///								may be pushable as part of an outer query, but it will never be includable in the HAVING
///								clause of some pushdown unit in its own query block.
///		pushdownUnit		- (PBR) All includable conditions must belong to one PDU. This will return the PDU of the
///								one PDU this condition returns to if includable. If not, will hold ""
validateExploredConditionForHAVING(qb, condition, &pushable, &includable, &pushdownUnit) [ mt ] PRIVATE {
	set pushable = 1
	do validateExploredItemCommon(qb, condition, "l", .pushable, .pushdownUnit)
	if pushable {
		if $d($$$FTItemUnpushableAggregates("l", condition)) {
			set pushable = 0
			GOTO exitEarly
		}
		
		// no streamless - validaExploredItemCommon() is only approving streamless if there's exactly one pushdown
		// unit in the query block and no local refs in the query block - this should be fine everywhere.
		// if '$$$FTItemNumAssociatedPDUs("l",condition) {
		// 	set pushable = 0
		// 	GOTO exitEarly
		// }
		/* ----	Validate the subqueries under this condition, stop looping once one is bad  ---- */
		set server = $$$FTPDUServer(pushdownUnit)
		set subquery = ""
		for {
			set subquery = $o($$$FTItemSubquery("l", condition, subquery))
			QUIT:subquery=""
			// subq must be pushable, have 1 server (same one as this PDU), and be under a permitted subquery operator
			if +$g($$$FTQBAssociatedServerCount(subquery)) '= 1 
				|| (server '= $o($$$FTQBAssociatedServer(subquery, ""))) 
				|| ('+$g($$$FTQBPushable(subquery)))
				|| ('+$g($$$FTItemSubqueryPushableOperator("l", condition, subquery)))
			{
				set pushable = 0
				QUIT
			}
		}
	}
exitEarly
	set includable = pushable && ($$$FTItemNumCorrelatedPDUs("l", condition) = 0)
	RETURN
}
.
.
/// Some checks for validating an item don't depend on the specific clause they are in. For example, if an item
/// contains a reference to a local table, that will never be pushable no matter where it is contained. This procedure
/// is called by clause-specific logic to handle these cases.
validateExploredItemCommon(qb, item, lv, &pushable, &pushdownUnit) [ mt ] PRIVATE {
	set pushable = 1
	/* TODOFT-improvement This is something that could be improved a bit: if there is condition that has 0 pushdown
	units (i.e. its streamless as far as the outer query is concerned) we could push that as a subquery of a 
	condition if the condition is in a query block that has exactly one PDU and the subquery goes to the 
	same server. */
	
	set itemNumPushdownUnits = $$$FTItemNumAssociatedPDUs(lv, item)
	if itemNumPushdownUnits > 1 {
		set pushable = 0
		RETURN
	} elseif itemNumPushdownUnits = 1 {
		// get the exactly one pushdown unit that this item references
		set pushdownUnit = $$$FTItemGetNextAssociatedPDU(lv, item, 0)
	} else {
		// zero pushdown units referenced by this item. If there is ONE total pushdown unit in the query block then 
		// maybe we can just push this with that pushdown unit. We'll validate the rest of the common requirements
		// against that 1 PDU and it's up to the caller (i.e. each clause) to determine if they want to allow that
		if $$$FTQBNumPushdownUnits(qb) > 1  || (+$g($$$FTQBContainsLocalReference(qb))){
			set pushable = 0
			RETURN
		}
		set pushdownUnit = $$$FTQBGetNextPushdownUnit(qb,0)
	}
.
	if (+$g($$$FTPDUType(pushdownUnit)) = $$$OFF)				// Pushdown OFF
		|| '$$$FTQBContainsPushdownUnit(qb, pushdownUnit)  		// PDU of item not in this QB (kind of trivial)
		|| (+$g($$$FTPDUType(pushdownUnit)) < +$g($$$FTItemMostPermissiveOperatorType(lv, item)))	// More permissive operators than the server allows
		|| +$g($$$FTItemContainsLocalReference(lv, item))		// local reference (e.g. local table)
		|| +$g($$$FTItemUnsupportedDatatypes(lv, item))			// item has an unsupported datatype somewhere
		|| $d($$$FTItemUnsupportedOperators(lv, item))			// operator not allowed by any pushdown type
		|| (+$g($$$FTItemInterestingNullBehavior(lv,item)) && ($d($$$FTItemNullStreamFieldArray(lv,item))))	// involves a field from RHS of LOJ and is subject to potentially interesting null behavior
	{
		set pushable = 0
	}
.
	RETURN
}
.
.
/// Add the fields associated with a given "v" or "l" to the SELECT lists of each pushdown
/// unit that they correspond to. Will be called when something is decided not pushable and 
/// we decide we need to SELECT the fields they involve in order to do them locally
/// ---- Parameters ----
///		qb 					- Query block
///		type				- "v" or "l"
///		item				- The number of "v" or "l" node that is having underlying fields added
///		trackForGroupBy		- Whether or not the fields should be tracked for group by containment. Note that
///								this shouldn't ever need to be true, because whenever we are adding underlying fields 
///								to the SELECT list, something else must've failed (e.g. a WHERE condition, having 
///								clause etc) in which case grouping/aggs will be canceled regardless. There may be times
///								where e.g. SELECT list evaluation adds the underlying fields of %SQLUPPER(col) to the
///								SELECT list but in cases such as this, these clauses will already always add their
///								unaggregated fields to the group by tracking anyway, so this is already handled.
addUnderlyingFieldsToSelectLists(qb, type, item, trackForGroupBy=0) [ mt ] PRIVATE {
	set underlyingField = ""
	for {
		set underlyingField = $o($$$FTItemUnderlyingField(type, item, underlyingField), 1, pushdownUnit)
		QUIT:underlyingField=""
		// add underlying field as a SELECT list item, linked to the pushdown unit it should go with
		set $$$FTQBClauseItem(qb, $$$SELECT, underlyingField) = pushdownUnit
	}
}
.
.
/// Determine the HAVING clause for the pushdown unit associated with the given foreign table stream
/// Similar to WHERE evaluation 
evaluateHAVINGforFT(qb) [ mt ] {
	RETURN:$$$FTQBClauseEvaluated(qb, $$$HAVING, havingPushable) havingPushable
	
	set originalHavingClause = $g($$$mtHaving( qb))
	if originalHavingClause = "" {
		set $$$FTQBClause(qb, $$$HAVING) = ""
		set $$$FTQBClausePushable(qb, $$$HAVING) = 1
		set $$$FTQBClauseIncludable(qb, $$$HAVING) = 1
		RETURN 1
	}
	
	set having = "", havingPushable = 1, havingIncludable = 1
	do exploreItemForPushdown(qb, originalHavingClause, "l")
	do validateExploredConditionForHAVING(qb, originalHavingClause, .pushable, .includable, .pushdownUnit)
	if includable {
		set having = originalHavingClause
	} else {
		set havingIncludable = 0
		set:'pushable havingPushable = 0
		do addUnderlyingFieldsToSelectLists(qb, "l", originalHavingClause)
		do releaseSubqueries("l", originalHavingClause)
	}
	do trackUnaggregatedFieldsForGroupByContainment(qb, "l", originalHavingClause)
	do mergeItemInformationToClause("l", originalHavingClause, $$$HAVING, qb)
.
	set $$$FTQBClause(qb, $$$HAVING) = having
	set $$$FTQBClausePushable(qb, $$$HAVING) = havingPushable
	set $$$FTQBClauseIncludable(qb, $$$HAVING) = havingIncludable
	RETURN pushable
}
.
.
/// If the "v"/"l" node represented by 'item' has subqueries it was considering regenerating,
/// mark them as adopted and deactivate them so that they will not be considered for their own pushdown
///	---- Parameters ----
///		itemType			- "l" or "v"
///		item				- index in mt("l") or mt("v") for the top level item containing the subqueries to be adopted
adoptSubqueries(itemType, item) [ mt ] PRIVATE {
	set subquery = ""
	for {
		set subquery = $o($$$FTItemSubquery(itemType, item, subquery))
		QUIT:subquery=""
		set $$$mtPQbIsActive(subquery) = 0
		kill:$d($$$mtTopPreoptHint(subquery)) $$$mtTopArg(subquery) // we ignore TOP optimization when pushing anyway
		set $$$FTQBAdoptedSubquery(subquery) = 1
	}
}
.
.
/// If the "v"/"l" node represented by 'item' has subqueries it was considering regenerating,
/// abandon then - something happened that made us decide that would not be possible
///	---- Parameters ----
///		itemType			- "l" or "v"
///		item				- index in mt("l") or mt("v") for the top level item containing the subqueries to be adopted
releaseSubqueries(itemType, item) [ mt ] PRIVATE {
	// release all subq's downstream of this condition that we considered adopting
	set subquery = ""
	for {
		set subquery = $o($$$FTItemSubquery(itemType, item, subquery))
		QUIT:subquery=""
		set $$$FTQBAdoptedSubquery(subquery) = 0
	}
}
.
.
/// Check all the underlying fields of the provided top-level item that are 
/// unaggregated so that they will be validated against the GROUP BY when we go
/// to finalize the pushing of aggs etc.
trackUnaggregatedFieldsForGroupByContainment(qb, itemType, item) [ mt ] PRIVATE {
	set underlyingField = ""
	for {
		set underlyingField = $o($$$FTItemUnderlyingField(itemType, item, underlyingField))
		QUIT:underlyingField=""
		if +$g($$$FTItemUnaggregatedField(itemType, item, underlyingField)) {
			set $$$FTQBGroupByMustContainField(qb, underlyingField) = ""
		}
	}
}
.
/// For each clause in the query block, add its information to the containing query block, particularly:
///		- correlated references
///		- local references
mergeClauseInformationToContainingQuery(qb) [ mt ] PRIVATE {
	for clauseType = $$$WHERE, $$$SELECT, $$$GROUPBY, $$$HAVING, $$$ORDERBY {
		set $$$FTQBCorrelatedPDUs(qb) = $$$MergePushdownUnits($$$FTQBCorrelatedPDUs(qb), $$$FTQBClauseCorrelatedPushdownUnits(qb,clauseType))
		merge $$$FTQBCorrelatedReferenceArray(qb) = $$$FTQBClauseCorrelatedReferenceArray(qb, clauseType)
		if +$g($$$FTQBClauseContainsLocalReference(qb, clauseType)) {
			set $$$FTQBContainsLocalReference(qb) = 1
		}
	}
	RETURN
}
.
.
/// Merge the attributes we have linked to this underlying item to the SELECT list it is contained within
mergeItemInformationToClause(itemType, item, clauseType, qb) [ mt ] PRIVATE {
	set $$$FTQBClausePushdownUnits(qb, clauseType) = $$$MergePushdownUnits($$$FTQBClausePushdownUnits(qb, clauseType), $$$FTItemAssociatedPDUs(itemType, item))
	set $$$FTQBClauseCorrelatedPushdownUnits(qb, clauseType) = $$$MergePushdownUnits($$$FTQBClauseCorrelatedPushdownUnits(qb, clauseType), $$$FTItemCorrelatedPDUs(itemType, item))
	merge $$$FTQBClauseCorrelatedReferenceArray(qb, clauseType) = $$$FTItemCorrelatedReferenceArray(itemType, item)
	if +$g($$$FTItemContainsLocalReference(itemType, item)) {
		set $$$FTQBClauseContainsLocalReference(qb, clauseType) = 1
	}
}
.
.
#; 	======================
#;	|	GROUP BY logic	 |
#;	======================
.
/// Determine information about the GROUP BY clause in the given QB that will help us determine pushability of
///	each item.
///
/// mt("g") is not only used for GROUP BY - also used for DISTINCT BY (col-list). But for DISTINCT BY, the same fields 
///	will appear in mt("distinct"). Note also that we support a %FOREACH keyword within each aggregate, represented as 
///	a list of fields in the 6th ^ piece of the aggregate mt("v") node. 
///
/// NOTE: pushing of grouping is ALL OR NOTHING - either the full GROUP BY can be pushed or we will do all the 
///	grouping locally. Hence, unlike with SELECT or WHERE, this proc always stores its decisions about the GROUP BY
///	clause at the query block level
///
///	---- Parameters ----
///		qb		- Query block being evaluated
///
evaluateGROUPBYforFT(qb) [ mt, nulstr ] {
	RETURN:$$$FTQBClauseEvaluated(qb, $$$GROUPBY, groupByPushable) groupByPushable
.
	set originalGroupingClause = $g($$$mtGroupDistinctList( qb))
	if originalGroupingClause = "" {	// no GROUP BY anyway
		set $$$FTQBClause(qb, $$$GROUPBY) = ""
		set $$$FTQBClausePushable(qb, $$$GROUPBY) = 1
		set $$$FTQBClauseIncludable(qb, $$$GROUPBY) = 1
		RETURN 1
	}
	set groupBy = "", groupByPushable = 1, groupByIncludable = 1
.
	/* 	Items in the DISTINCT BY list appear in the mt("g") clause. If they appear in both the GROUP BY and the DISTINCT
		BY then they will appear in the mt("g") node multiple times.
		 */
	set distinctByList = ""
	if $d($$$mtDistinct( qb), distinctByList) {
		set distinctByList = ","_distinctByList			// make comma delimited both sides for CONTAINS ( [ ) conditions
		/* Ok, when we combine GROUP BY and DISTINCT [BY] the DISTINCT clause is ignored. When it's a plain DISTINCT,
			the DISTINCT is ignored but the rest of the query acts the same. When it's DISTINCT BY (), we DO NOT 
			calculate the aggregates by group, although we do group the GROUP BY fields in the final result, but we 
			can't push the aggs and grouping to the external or else the result would be different than typical local 
			results.
			
			So if this is a plain DISTINCT we should just continue to push GROUP BY and remove it locally later if we push
			the GROUP BY. But if it's a DISTINCT BY we should just disable because there's no good way to push some logic
			and locally evaluate the rest. 
			
			TODOFT if this doesn't work optionally turn off always? */
		if distinctByList '= "," {
			set groupByIncludable = 0
			set groupByPushable = 0
		}
	}
	
	for i=1:1:$l(originalGroupingClause, ",")-1 {
		set val = $p(originalGroupingClause, ",", i)
		QUIT:val=""
		do exploreItemForPushdown(qb, val, "v")
		do validateExploredValueForGROUPBY(qb, val, .pushable, .includable, .pushdownUnit)
		if (distinctByList [ (","_val_",")) {	 // this val is in DISTINCT BY clause, remove so we can tell if in both distinct & group
			set distinctByList = $replace(distinctByList,","_val_",", ",") 	// 
			if $g($$$FTItemContainsAggregates("v", val)) {
				set $$$FTQBDisableAggregates(qb) = 1	// never push DISTINCT BY so if it has aggs, we need to do all aggregation in IRIS
			}
			do addUnderlyingFieldsToSelectLists(qb, "v", val)
			CONTINUE 		// continue without merging information to the GROUP BY clause TODOFT verify?
		} else {
			if includable {
				set groupBy = groupBy_val_","
			} else {
				set groupByIncludable = 0
				set:'pushable groupByPushable = 0
				do addUnderlyingFieldsToSelectLists(qb, "v", val)
			}
		}
		// track the info from the underlying item on the GROUP BY clause at large so that evaluateQB() can
		// pass certain information along to parent queries
		do mergeItemInformationToClause("v", val, $$$GROUPBY, qb)
	}
.
	set $$$FTQBClause(qb, $$$GROUPBY) = groupBy
	set $$$FTQBClausePushable(qb, $$$GROUPBY) = groupByPushable
	set $$$FTQBClauseIncludable(qb, $$$GROUPBY) = groupByIncludable
	
	RETURN groupByPushable
}
.
#; 	======================
#;	|	SELECT logic	 |
#;	======================
.
.
/// Evaluate the SELECT list of the given QB for what we need to push.
///
/// ---- Parameters ----
///		qb				- The query block we will evaluate the SELECT list of
///
///	---- Returns ----
///		1 if the entire SELECT list for the query block can be pushed as is, else 0
///
evaluateSELECTforFT(qb) [ mt ] {
	RETURN:$$$FTQBClauseEvaluated(qb, $$$SELECT, pushable) pushable
.
	if $g($$$mtOutput(qb))="" {
		set $$$FTQBClausePushable(qb, $$$SELECT) = 1
		set $$$FTQBClauseIncludable(qb, $$$SELECT) = 1
		RETURN 1
	}
.
	set selectPushable = 1
	set selectIncludable = 1
	
	// "d" = distinct in some way
	//		- If mt("distinct",m) = "", this is SELECT DISTINCT selItems ...
	// 		- If mt("distinct",m) = a comma-list of fields and "g" is not set, this is DISTINCT BY (distFields ...) selItems ...
	// 		- If NO mt("distinct",m) and "g" is set, there's a GROUP BY
	set distinctList = ""
	set originalSelectList = $p($g($$$mtOutput(qb)), "^", 2)	// comma-delimited select items
	if $p($$$mtOutput(qb), "^", 1) = "d" {
		if $d($$$mtDistinct( qb), distinctList) {
			if distinctList '= "" {		// DISTINCT BY (varying external syntaxes), we evaluate the actual list w/ GROUP BY later
				set $$$FTQBDistinctBy(qb) = 1
			} else {
				// regular SELECT DISTINCT... This can only apply to query blocks with one pushdown unit, otherwise
				// will need to be done locally. So we'll store it at the QB level and disable it as needed back in the
				// query block level.
				set $$$FTQBSimpleDistinct(qb) = 1
			}
		}
	}
	
	/* 	Loop over the SELECT items in this query block and assign them to the appropriate pushdown unit. If anything
		cannot be pushed, make sure we SELECT its underlying fields. Keep note of when we will need to disable
		aggregates so that we can undo them in the query block level. Example cases where we think we push aggs but then
		disable them:
			SELECT count(c1), %DLIST(c2)... 
				count is ok but %dlist is not, aggs are all or nothing so need to retroactively revoke the COUNT 
			SELECT count(C1), c2, c3 ... GROUP BY c2 
				since c3 is not in the group by, we can't push GROUP BY, and can't push the aggregates			*/
	
	for i=1:1:$l(originalSelectList, ",")-1 {
		set val = $p(originalSelectList, ",", i)
		continue:val=""
		do exploreItemForPushdown(qb, val, "v")
		do validateExploredValueForSELECT(qb, val, .itemPushable, .includable, .pushdownUnit)
		if includable {
			/* 	Aggregates can only be pushed based on information at the query level, so just store them at the QB 
				level and move them over later if we meet all qualifications to push aggregates */
			if +$g($$$FTItemContainsAggregates("v", val)) {
				set $$$FTQBClauseAggregate(qb, $$$SELECT, val) = 1
			} else {
				set $$$FTQBClauseItem(qb, $$$SELECT, val) = pushdownUnit
			}
		} else {
			set selectIncludable = 0
			set:'itemPushable selectPushable = 0
			do addUnderlyingFieldsToSelectLists(qb, "v", val)
			if +$g($$$FTItemContainsAggregates("v", val)) 
				|| (+$g($$$FTItemContainsLocalReference("v", val))) 
				|| ($$$FTItemNumCorrelatedPDUs("v", val) '= 0)
				|| ($d($$$FTItemSubqueries("v", val)))
			{
				set $$$FTQBDisableAggregates(qb) = 1
				// so we can use this to verify if there are any aggregates present
				set:+$g($$$FTItemContainsAggregates("v", val)) $$$FTQBClauseAggregate(qb, $$$SELECT, val) = 1
			}
		}
		do trackUnaggregatedFieldsForGroupByContainment(qb, "v", val)
		// get info from the item into the SELECT to be tracked by evaluateQB()
		do mergeItemInformationToClause("v", val, $$$SELECT, qb)
	}
	
	set $$$FTQBClausePushable(qb, $$$SELECT) = selectPushable
	set $$$FTQBClauseIncludable(qb, $$$SELECT) = selectIncludable
	RETURN selectPushable
}
.
.
#; 	======================
#;	|	ORDER BY logic	 |
#;	======================
.
/// Loop over the ORDER BY clause in the query block associated with the given pushdown unit.
/// Also considers TOP
evaluateORDERBYforFT(qb) [ mt ] {
	RETURN:$$$FTQBClauseEvaluated(qb, $$$ORDERBY, pushable) pushable
	
	set originalOrderBy = $$orderByHelper(qb, 0)
	if originalOrderBy = "" {
		set $$$FTQBClause(qb, $$$ORDERBY) = ""
		set $$$FTQBClausePushable(qb, $$$ORDERBY) = 1
		set $$$FTQBClauseIncludable(qb, $$$ORDERBY) = 1
		RETURN 1
	}
	
	set orderBy = "", orderByPushable = 1, orderByIncludable = 1
	for i=1:1:($l(originalOrderBy, ",")-1) {
		set val = $p(originalOrderBy, ",", i)
		QUIT:val=""
		// val could be e.g. '3d' for descending, only pass numeric part
		set valNumberOnly = +val
		do exploreItemForPushdown(qb, valNumberOnly, "v")
		do validateExploredValueForORDERBY(qb, valNumberOnly, .pushable, .includable, .pushdownUnit)
		//continue:$d($$$FTItemSubqueries("v", val))
		if includable {
			set orderBy = orderBy _ val _ ","
		} else {
			set orderByIncludable = 0
			set:'pushable orderByPushable = 0
			do addUnderlyingFieldsToSelectLists(qb, "v", valNumberOnly)
		}
		// track that aggregates appeared in the ORDER BY
		if +$g($$$FTItemContainsAggregates("v", valNumberOnly)) {
			set:'includable $$$FTQBDisableAggregates(qb) = 1
			set $$$FTQBClauseAggregate(qb, $$$ORDERBY, valNumberOnly) = 1
		}
		do trackUnaggregatedFieldsForGroupByContainment(qb, "v", valNumberOnly)
		do mergeItemInformationToClause("v", valNumberOnly, $$$ORDERBY, qb)
	}
.
	set $$$FTQBClausePushable(qb, $$$ORDERBY) = orderByPushable
	set $$$FTQBClauseIncludable(qb, $$$ORDERBY) = orderByIncludable
	// this will get removed later if we can't do order by (lots of restrictions, we probably can't)
	set $$$FTQBClause(qb, $$$ORDERBY) = orderBy
	RETURN orderByPushable
}
.
.
/// Our pushdown analysis will mark every single field that is finds in a non-aggregated context, and each clause
/// that requires non-aggregated fields to appear in the GROUP BY will 
validateFieldsAppearInGroupByForFT(qb) [ mt ] PRIVATE {
	set val = ""
	for {
		set val = $o($$$FTQBGroupByMustContainField(qb, val))
		QUIT:val=""
		if '$$$FTQBGroupByContainsField(qb, val) {
			RETURN 0
		}
	}
.
	RETURN 1
}
.
/// At this point all of the analysis for this query block is done. We should take all of the clauses and track them
/// by the pushdown unit they correspond to. This means:
///		- Build up the SELECT list for each pushdown unit, including aggs
///		- Move GROUP BY/HAVING/ORDER BY to the one relevant PDU, if that is the case. Plus TOP and DISTINCT
finalizeAllClauses(qb, aggregationOk=0, includeOrderBy=0, includeDistinct=0, includeTop=0) [ mt ] PRIVATE {
	// initialize all the SELECT lists to "^"
	set pushdownUnit = $$$FTQBGetNextPushdownUnit(qb, 0)
	while pushdownUnit {
		set $$$FTPDUClause(pushdownUnit, $$$SELECT) = "^"
		set pushdownUnit = $$$FTQBGetNextPushdownUnit(qb, pushdownUnit + 1)
	}
	// create SELECT lists (without aggs for now)
	set item = ""
	for {
		set item = $o($$$FTQBClauseItem(qb, $$$SELECT, item), 1, pushdownUnit)
		QUIT:item=""
		set $$$FTPDUClause(pushdownUnit, $$$SELECT) = $$$FTPDUClause(pushdownUnit, $$$SELECT) _ item _ ","
	}
	
	// Add agg / GROUP / HAVING if allowed/present, also add DISTINCT if allowed/present
	if aggregationOk {
		// **** If aggregation is true it can be assumed there's one pushdown unit ****
		set pushdownUnit = $$$FTQBGetNextPushdownUnit(qb, 0)
		// add aggregates to the SELECT
		set agg = ""
		// remove aggs from tracking in original query block, prepend with comma for easier presence checking
		set oldAggs = ","_$$$mtPAggList($$$mtP(qb))
		for {
			set agg = $o($$$FTQBClauseAggregate(qb, $$$SELECT, agg))
			QUIT:agg=""
			set commaAgg = (","_agg_",")
			if oldAggs [ commaAgg {
				set oldAggs = $replace(oldAggs, commaAgg, ",")
			}
			set $$$FTPDUClause(pushdownUnit, $$$SELECT) = $$$FTPDUClause(pushdownUnit, $$$SELECT) _ agg _ ","
		}
		set $$$mtPAggList($$$mtP(qb)) = $e(oldAggs,2,*)
		
		set $$$FTPDUClause(pushdownUnit, $$$GROUPBY) = $g($$$FTQBClause(qb, $$$GROUPBY))
		// Make sure we track d^ in SELECT
		if $g($$$FTPDUClause(pushdownUnit, $$$GROUPBY)) '= "" {
			set $p($$$FTPDUClause(pushdownUnit, $$$SELECT), "^", 1) = "d"
		} else {
			kill $$$FTPDUClause(pushdownUnit, $$$GROUPBY)
		}
.
		if $g($$$FTQBClause(qb, $$$HAVING)) '= "" {
			set $$$FTPDUClause(pushdownUnit, $$$HAVING) = $$$FTQBClause(qb, $$$HAVING)
		}
.
		if includeDistinct, $g($$$FTQBSimpleDistinct(qb)) {
			set $p($$$FTPDUClause(pushdownUnit, $$$SELECT), "^", 1) = "d"
			set $$$FTPDUDistinct(pushdownUnit) = 1
		}
		if includeOrderBy {
			set $$$FTPDUClause(pushdownUnit, $$$ORDERBY) = $g($$$FTQBClause(qb, $$$ORDERBY))
		}
		if includeTop {
			set topVal = $$rowLimitHelper(qb, .topStyle, .offset, 0)
			if topVal {
				set $$$FTPDUTop(pushdownUnit) = topVal
				set $$$FTPDUTopStyle(pushdownUnit) = $s(topStyle="": "TOP", 1: topStyle)
			}
			set:offset'="" $$$FTPDUOffset(pushdownUnit) = offset
		}
		/* 	A query like "SELECT count(c1) FROM t1" will be marked as onerow in the QP. When we move the aggregation
			into a pushdown unit, we remove aggregates etc from the original query block. This results in the original
			QB being: onerow, no aggs, no grouping, no distinct/foreach, no having etc. In other words, streamless and 
			onerow. This results in it being EMPTY! It's easiest to kill this onerow marker if we're moving the entire 
			aggregation to the external server instead of finding a way to represent that we need to loop over a "master
			map" (ft pushdown unit) with one row. */
		kill $$$mtOneRow(qb)
	}
	RETURN
}
.
.
/// Evaluate JOIN conditions (ON and linx (=* / *=, natural joins, USING joins)) to check for fields that we need 
/// to additionally SELECT from queries. INNER join conditions are placed in the WHERE clause and would be addressed 
/// by the evaluateWHERE logic. We don't need to worry about arrow syntax (impjns) because arrow syntax doesn't make
/// sense on foreign tables as they cannot have related tables (i.e. you cannot have a field/property of a
/// foreign table(/class) that is some other table(/class)).
evaluateJoinConditions(qb) [ mt, linx ] PRIVATE {
	// Need to evaluate mt("ON") conditions as well as any conditions in linx that correspond to this query block so 
	// that we can be sure to select them
.
	// loop over mt("ON") for this subquery
	//	NB: 	mt("ON",query#,counter)=$lb(operator,logs,left,right)
	set counter = ""
	for {
		set counter = $o($$$mtOn(qb, counter), 1, info)
		QUIT:counter=""
		set logs = $lg(info, 2)
		for condIdx=1:1:$l(logs, "^")-1 {
			set condition = $p(logs, "^", condIdx)
			QUIT:condition=""	// just in case
			do exploreItemForPushdown(qb, condition, "l")
			// There may have been a correlated field used in the condition, if so then we need to make sure the query 
			// block we are in will report that it contained that correlated field. Typically we set this on an item and
			// then a clause - in this case we will set directly on the query block.
			if $$$FTItemNumCorrelatedPDUs("l", condition) > 0 {
				set $$$FTQBCorrelatedPDUs(qb) = $$$MergePushdownUnits($$$FTQBCorrelatedPDUs(qb), $$$FTItemCorrelatedPDUs("l", condition))
				merge $$$FTQBCorrelatedReferenceArray(qb) = $$$FTItemCorrelatedReferenceArray("l", condition)
				if +$g($$$FTItemContainsLocalReference("l", condition)) {
					set $$$FTQBContainsLocalReference(qb) = 1
				}
			}
			do addUnderlyingFieldsToSelectLists(qb, "l", condition)
		}
	}
	
	// loop over linx, look at conditions that pertain to fields in this query block, explore the condition and 
	// add underlying fields to be SELECTed. linx conditions must be between fields (or corr fields) only!
	for condIdx=1:1:$l(linx,"^")-1 {
		set condition = $p(linx, "^", condIdx)
		QUIT:condition=""	// just in case
		set arg = $$$mtLOperand2($$$mtL(condition))
		set argStream = $p($$$mtV(arg),"^",2)
		set argQb = $$$mtRQb($$$mtR( argStream))
		CONTINUE:argQb'=qb
		
		do exploreItemForPushdown(qb, condition, "l")
		// There may have been a correlated field used in the condition, if so then we need to make sure the query 
		// block we are in will report that it contained that correlated field. Typically we set this on an item and
		// then a clause - in this case we will set directly on the query block.
		if $$$FTItemNumCorrelatedPDUs("l", condition) > 0 {
			set $$$FTQBCorrelatedPDUs(qb) = $$$MergePushdownUnits($$$FTQBCorrelatedPDUs(qb), $$$FTItemCorrelatedPDUs("l", condition))
			merge $$$FTQBCorrelatedReferenceArray(qb) = $$$FTItemCorrelatedReferenceArray("l", condition)
			if +$g($$$FTItemContainsLocalReference("l", condition)) {
				set $$$FTQBContainsLocalReference(qb) = 1
			}
		}
		do addUnderlyingFieldsToSelectLists(qb, "l", condition)
	}
}
.
.
#; 	==============================================
#;	|	Functions for pushdown invalidation	 	 |
#;	==============================================
/// For some reason, it has been determined that the query we are pushing cannot contain GROUP BY, HAVING, or 
/// aggregates. Go through the aggregates and remove them so they won't be put into the SELECT list
disincludeAggregatesForFtPushdown(qb) [ mt ] PRIVATE {
	set $$$FTQBClausePushable(qb, $$$SELECT) = 0
	set $$$FTQBDisableAggregates(qb) = 1
	// loop over items in the SELECT w/ aggs, add underlying fields to the SELECT + remove from consideration
	set topLevelItem = ""
	for {
		set topLevelItem = $o($$$FTQBClauseAggregate(qb, $$$SELECT, topLevelItem))
		QUIT:topLevelItem=""
		do addUnderlyingFieldsToSelectLists(qb, "v", topLevelItem)
		kill $$$FTQBClauseAggregate(qb, $$$SELECT, topLevelItem)		// remove from consideration
	}
}
.
.
/// Encapsulates logic to cancel pushdown of some clause in a query block. 
/// This is currently only for clause types where we disinclude the entire thing, i.e. HAVING, GROUP BY, or ORDER BY.
/// Any WHERE clauses/SELECT lists are more piecemeal so never get disincluded from regeneration in full this way
disincludeClauseForFtPushdown(qb, clauseType) [ mt ] PRIVATE {
	set $$$FTQBClauseIncludable(qb, clauseType) = 0
	set clause = $g($$$FTQBClause(qb, clauseType))
	RETURN:clause=""
	set:($e(clause,*)=",") $e(clause,*) = ""		// remove trailing comma, different clauses are different ways
	set $$$FTQBClause(qb, clauseType) = ""
	set itemType = $case(clauseType, $$$HAVING: "l", : "v")
	for i=1:1:$l(clause, ",") {
		set item = $p(clause, ",", i)
		QUIT:item=""
		do releaseSubqueries(itemType, item)
		do addUnderlyingFieldsToSelectLists(qb, itemType, item)
	}
	if clauseType = $$$ORDERBY, $d($$$FTQBClauseAggregateArray(qb, clauseType)) {
		set $$$FTQBDisableAggregates(qb) = 1
	}
}
.
.
#; 	==============================================
#;	|	Auxiliary functions for pushdown support |
#;	==============================================
.
/// Whether a given constant's datatype can be pushed
///	---- Parameters ----
///		datatype (COS class) name, e.g. "%Library.String"
///
/// ---- Returns ----
///		1 if pushable, else 0
isPushableArgumentDatatype(dt) PRIVATE {
	set:dt["(" dt = $p(dt,"(",1)
	RETURN $$$FTPushableArgumentDatatypes [ (" "_dt_" ")
}
.
.
/// Whether a given aggregate function is supported (e.g. $$$mtV(1) = "a^COUNT^....")
///	---- Parameters ----
///		aggregate function name ("COUNT" in the above example)
///
/// ---- Returns ----
///		1 if pushable, else 0
isPushableAggregateFunction(function) PRIVATE {
	RETURN $$$FTPushableAggregateFunctions [ (" "_$$$UPPER(function)_" ")
}
.
.
/// Whether a given of mt("l") "v"-predicate is supported (e.g. $$$mtL(1) = "v^=^....")
///	---- Parameters ----
///		predicate           - name of the logical predicate (e.g. "=" in the above example)
///     parentItemChain     - chain of parent predicates above this so we can set info at the top level of the chain
checkPredicate(predicate, parentItemChain) [mt] PRIVATE {
	set topLevelItem = +parentItemChain
	set topLevelLV = $$$FTChainTopLevelItemType(parentItemChain)
	if $$$FTPushablePredicates($$$IRIS)[(","_predicate_",") {
		set thisType = $$$IRIS
	} elseif $$$FTPushablePredicates($$$EXTENDED)[(","_predicate_",") {
		set thisType = $$$EXTENDED
 	} elseif $$$FTPushablePredicates($$$ANSI92)[(","_predicate_",") {
		set thisType = $$$ANSI92
	}  elseif $$$FTPushablePredicates($$$BASIC)[(","_predicate_",") {
		set thisType = $$$BASIC
	} else {
		set $$$FTItemUnsupportedOperators(topLevelLV, topLevelItem) = 1
		RETURN
	}
	if thisType > +$g($$$FTItemMostPermissiveOperatorType(topLevelLV, topLevelItem)) {
		set $$$FTItemMostPermissiveOperatorType(topLevelLV, topLevelItem) = thisType
	}
	RETURN
}
.
.
/// Check the operator of an mt("l") node for predicate pushdown
/// Could also
checkLogicalOperator(op, parentItemChain) [ mt ] PRIVATE {
	set topLevelItem = +parentItemChain
	set topLevelLV = $$$FTChainTopLevelItemType(parentItemChain)
	// evaluate in order of decreasing permissiveness...
	if $$$FTPushableLogOps($$$IRIS)[(" "_op_" ") {
		set thisType = $$$IRIS
	} elseif $$$FTPushableLogOps($$$EXTENDED)[(" "_op_" ") {
		set thisType = $$$EXTENDED
 	} elseif $$$FTPushableLogOps($$$ANSI92)[(" "_op_" ") {
		set thisType = $$$ANSI92
	} elseif $$$FTPushableLogOps($$$BASIC)[(" "_op_" ") {
		set thisType = $$$BASIC
	} else {
		// no hits, not supported by any type
		set $$$FTItemUnsupportedOperators(topLevelLV, topLevelItem) = 1
		RETURN
	}
	if thisType > +$g($$$FTItemMostPermissiveOperatorType(topLevelLV, topLevelItem)) {
		set $$$FTItemMostPermissiveOperatorType(topLevelLV, topLevelItem) = thisType
	}
	RETURN
}
.
.
/// Checks pushdown information of mt("v") "v"-operators e.g. $$$mtV(1) = "v^CAST_CHAR^...."
/// op would be "CAST_CHAR" in the above example
checkExpression(op, parentItemChain) [ mt ] PRIVATE {
	set topLevelItem = +parentItemChain
	set topLevelLV = $$$FTChainTopLevelItemType(parentItemChain)
	
	// special handling for the conversion functions
	if op[":" && (" CONVERT MSCONVERT " [ $p(op, ":", 1)) {
		if '$$isPushableArgumentDatatype($p(op, ":", 2)) {
			set $$$FTItemUnsupportedOperators(topLevelLV, topLevelItem) = 1
			RETURN
		}
		set op = $p(op, ":", 1)
	} elseif op["%TRUNCATE(" {
		set op = $p(op, "(", 1)
	}
.
	if $$$FTPushableExpressions($$$IRIS)[(" "_op_" ") {
		set thisType = $$$IRIS
	} elseif $$$FTPushableExpressions($$$EXTENDED)[(" "_op_" ") {
		set thisType = $$$EXTENDED
 	} elseif $$$FTPushableExpressions($$$ANSI92)[(" "_op_" ") {
		set thisType = $$$ANSI92
	} elseif $$$FTPushableExpressions($$$BASIC)[(" "_op_" ") {
		set thisType = $$$BASIC
	} else {
		// no hits, not supported by any type
		set $$$FTItemUnsupportedOperators(topLevelLV, topLevelItem) = 1
		RETURN
	}
	if thisType > +$g($$$FTItemMostPermissiveOperatorType(topLevelLV, topLevelItem)) {
		set $$$FTItemMostPermissiveOperatorType(topLevelLV, topLevelItem) = thisType
	}
	RETURN
}
.
/// Encapsulates some common logic for looking at a field and grabbing information that's important
/// about it for pushdown
checkField(qb, fieldVal, parentItemChain, insideAggregate=0) [ mt, nulstr ] PRIVATE {
	set topLevelItem = +parentItemChain
	set topLevelLV = $$$FTChainTopLevelItemType(parentItemChain)
	set fieldStream = $p($$$mtV(fieldVal), "^", 2)
	if $$fieldIsLocalReference(fieldVal, fieldStream, .ftIdField) {
		set $$$FTItemContainsLocalReference(topLevelLV, topLevelItem) = 1
		if ftIdField {
			set $$$FTIdFieldByOriginalStream(fieldStream) = fieldVal
		}
	} else {
		// at this point in QP it's not sufficient to check piece-4 of $$$mtPActiveQbs so this is the best check we
		// can do for correlated reference		
		set fieldQb = $$$mtRQb($$$mtR( fieldStream))
		if qb '= fieldQb {
			// this field is a correlated ref, it doesn't actuallly belong to this query block so mark it as such
			set correlatedPushdownUnit = $$$FTOriginalStreamToPushdownUnit(fieldStream)
			$$$FTItemAddCorrelatedPDU(topLevelLV, topLevelItem, correlatedPushdownUnit)
			set $$$FTItemCorrelatedReference(topLevelLV, topLevelItem, fieldVal) = correlatedPushdownUnit
			if 'insideAggregate {
				set $$$FTItemCorrelatedReferenceUnaggregated(topLevelLV, topLevelItem, fieldVal) = 1
			}
		} else {
			set pushdownUnit = $$$FTOriginalStreamToPushdownUnit(fieldStream)
			$$$FTItemAddAssociatedPDU(topLevelLV, topLevelItem, pushdownUnit)
			//set $$$FTItemAssociatedServer("v", fieldVal, $$$FTPDUServer(pushdownUnit)) = 1
			set $$$FTItemUnderlyingField(topLevelLV, topLevelItem, fieldVal) = pushdownUnit
			if '$$isPushableArgumentDatatype($$$VTRgetdt(fieldVal)) {
				set $$$FTItemUnsupportedDatatypes(topLevelLV, topLevelItem) = 1
			}
			if 'insideAggregate {
				set $$$FTItemUnaggregatedField(topLevelLV, topLevelItem, fieldVal) = 1
			}
			// Need to know when some item involves a field from e.g. the right side of a LOJ. Our query result would not
			// be restrictive enough if we push that condition. With this flag we will still push something but not remove
			// it from our original clauses either.
			// TODOFT new nulstr-like concept based on PDUs instead of raw streams
			if $d(nulstr), $listfind(nulstr, fieldStream) {
				set $$$FTItemNullStreamField(topLevelLV, topLevelItem, fieldVal) = 1
			}
		}
	}
	RETURN
}
.
.
/// For FT pushdown, check if the provided field ("f" node in mt("v")) is effectively
/// a local reference, which could be:
///		- from a non-FT stream
///		- a local-only FT field (right now only _$FTID)
fieldIsLocalReference(fieldVal, fieldStream, &ftIdField=0) [ mt ] PRIVATE {
	RETURN:'$d($$$FTByOriginalStream(fieldStream)) 1
	set irn = $$$mtRIrn($$$mtR( fieldStream))
	set ifn = $p($$$mtV(fieldVal), "^", 3)
	if ($$$smdColFTExternalColName(1, irn, ifn) = "") {
		set ftIdField = 1
		RETURN 1
	}
	// At this point it's a column in a FT, but it might be a non-queryable FT. We can just treat as a local reference 
	// because non queryable FTs will never need to move into their own new stream. We can't send them anything but 
	// the columns involved in the query. It is easier for us to just ignore them during pushdown!
	set server = $$$FTServerByOriginalStream(fieldStream)
	RETURN '+$g($$$FTServerIsQueryable(server))
}
.
.
.
/// Explore an "l" or "v" item for the purposes of foreign table pushdown. The procedure is purely exploratory
/// and does not make any decisions. It simply reports everything that it finds. Namely, since all decisions are
/// made by top-level (within this qb) clauses, this logic "reports" its metadata by linking it to the top-level item
/// (condition or "v" arg) and then allowing the top-level clauses to make decisions about it.
///
///	---- Parameters ----
///		qb 					- query block under consideration
///		item				- index in mt("v" / "l") of the item
///		lv					- "v" or "l"
///		parentItemChain		- string chain of the parent items (v and l) above this item. First 
///								entry is the ~top-level item~. This is where info is tracked because it is where
///								we make decisions about the pushability of items. The string takes the form of:
///
///											num^type,num^type,...,num^type  e.g.  1^l,4^v,...7^v
///
///								Where the first entry is the aforementioned top-level item. 
exploreItemForPushdown(qb, item, lv, parentItemChain="", insideAggregate=0) [ mt, nulstr ] PRIVATE {
	RETURN:item=""
	// mt(lv, item) = itemInfo, where itemInfo = itemType^....
	// e.g. $$$mtV(1) = f^1^SQLUSER.EX^C1   
	//		then lv = "v", item = 1, itemInfo = f^1^SQLUSER.EX^C1, itemType = "f"
	set itemInfo = mt(lv, item)
	set itemType = $e(itemInfo), op = $p(itemInfo,"^",2)	
	set parentItemChain = parentItemChain _ $s(parentItemChain="": "", 1: ",") _ item _ "^" _ lv    // put leading comma if the chain already has preceding items
	set topLevelItem = +parentItemChain
	set topLevelLV = $p($p(parentItemChain, ",", 1), "^", 2)
	if itemType = "t" {		// constant
		// nothing to do here? it's just a consntant
	} elseif itemType = "x" { // variable, lateral ref
		if itemInfo=("x^"_+$e(itemInfo,3,*)),itemInfo'="x^0" {
			set $$$FTItemContainsLocalReference(topLevelLV, topLevelItem) = 1	
		}
	} elseif itemType = "f" {	// field
		do checkField(qb, item, parentItemChain, insideAggregate)
	} elseif itemType = "l" {	// logical condition
		do checkLogicalOperator(op, parentItemChain)
		do exploreItemForPushdown(qb, $p(itemInfo, "^", 4), "l", parentItemChain)
		do exploreItemForPushdown(qb, $p(itemInfo, "^", 5), "l", parentItemChain)
	} elseif itemType = "v" {	// value
		// is this is part of a logical condition the "v" node is a logical predicate, if not it's some type of operator
		if lv = "l" {
			do checkPredicate(op, parentItemChain)
		} else {
			do checkExpression(op, parentItemChain)
		}
		for i=4:1 {
			set argument = $p(itemInfo,"^",i)
			quit:argument=""
			do exploreItemForPushdown(qb, argument, "v", parentItemChain)
		}
		// some expressions like %MINUS will take a null argument and output something other than null which makes
		// them bad candidates for pushing when combined possible nullability from JOINs
		if $$$FTInterestingNullBehaviorExpressions [ (" " _ op _ " ") {
			set $$$FTItemInterestingNullBehavior(topLevelLV,topLevelItem) = 1
		}
	} elseif itemType = "n" {	// correlated reference
		// explore the value it points to, eventually checkField() will handle that correlated reference
		do exploreItemForPushdown(qb, $p(itemInfo, "^", 4), "v", parentItemChain)
	} elseif itemType = "q" {	// subquery
		
		/* 	Subquery only pushable if part of a FOR SOME (EXISTS, ANY, ALL, SOME) or IN condition - otherwise, we would
			need to make sure it's only one row and we don't have a good way to test that for pushdown. But we need
			to evaluate the whole query block regardless. If pushing, ENTIRE subquery must be pushable. Could check for
			"onerow" but are there cases where our semantics differ that could lead to errors from external DB?		*/
		
		set parentCondition = $$findNearestParentCondition(parentItemChain)
		if parentCondition = "" {
			set pushableOperator = 1
		} else {
			set parentOperator = $$$mtLOperator($$$mtL(parentCondition))
			set pushableOperator =  (",FOR SOME,IN," [ (","_parentOperator_","))
		}
		set subquery = $p(itemInfo, "^", 2)
		/* 	Link subq and track the type of operator. The rest of the info about the subquery - correlated refs,
			associated servers, etc will be checked in the top level by referencing the QB using the link */
		set $$$FTItemSubquery(topLevelLV, topLevelItem, subquery) = ""
		set $$$FTItemSubqueryPushableOperator(topLevelLV, topLevelItem, subquery) = pushableOperator
		// Need to evaluate the subquery so we know what to do with it back in the top level!
		do evaluateQueryBlockForFT(subquery)
		/*	---- The subq may have had correlated references, if those refs are from PDUs in our QB then those PDUs
			become associated with this item. If not, they become corr refs of this item for a furter up QB to 
			consider		  ---- */
		set correlatedField = ""
		for {
			set correlatedField = $o($$$FTQBCorrelatedReference(subquery, correlatedField), 1, correlatedPushdownUnit)
			QUIT:correlatedField=""
			if $$$FTQBContainsPushdownUnit(qb, correlatedPushdownUnit) {
				// This corr ref in the subquery references something from our own QB
				$$$FTItemAddAssociatedPDU(topLevelLV, topLevelItem, correlatedPushdownUnit)
				set $$$FTItemUnderlyingField(topLevelLV, topLevelItem, correlatedField) = correlatedPushdownUnit
				// if the corr ref that originates in this query block appeared unaggregated in the subquery block, 
				// it may need to appear in the group by of the current query block (for external DBs, this is not required
				// by IRIS)
				if +$g($$$FTQBCorrelatedReferenceUnaggregated(subquery, correlatedField)) {
					set $$$FTItemUnaggregatedField(topLevelLV, topLevelItem, correlatedField) = 1
				}
			} else {
				// the reference is from something further up, this becomes a correlated ref for us
				merge $$$FTItemCorrelatedReference(topLevelLV, topLevelItem, correlatedField) = $$$FTQBCorrelatedReference(subquery, correlatedField)
				$$$FTItemAddCorrelatedPDU(topLevelLV, topLevelItem, correlatedPushdownUnit)
			}
		}
		// the QB containing a reference to a local table means this condition effectively contains a local reference
		// as it would not be pushable without the subquery anyway
		if +$g($$$FTQBContainsLocalReference(subquery)) {
			set $$$FTItemContainsLocalReference(topLevelLV, topLevelItem) = 1
		}
	} elseif itemType = "a" {	// aggregate
		set op = $p(itemInfo, "^", 2)
		set afterHaving = +$p(itemInfo, "^", 4)
		set operand = $p(itemInfo, "^", 5)
		set forEachList = $p(itemInfo, "^", 6)
		set badForEachList = (forEachList '= $g($$$mtGroupDistinctList( qb)))
		set distinctList = $p(itemInfo, "^", 7)
		// Flag top level item contains aggs; need to be able to disable all other aggs when any aggs can't be pushed
		set $$$FTItemContainsAggregates(topLevelLV, topLevelItem) = 1
.
		if '$$isPushableAggregateFunction(op) 
			|| afterHaving 
			|| badForEachList
			|| (distinctList '= "") {
			set $$$FTItemUnpushableAggregates(topLevelLV, topLevelItem) = 1
		}
		
		// explore underlying field
		do exploreItemForPushdown(qb, operand, "v", parentItemChain, 1)
		
		// if the for-each is just replicated group by clause we can leave that to be evaluated later
		if badForEachList {
			for i=1:1:$l(forEachList, ",") {
				set field = $p(forEachList, ",", i)
				CONTINUE:field=""
				do exploreItemForPushdown(qb, field, "v", parentItemChain, 1)
			}
		}
		for i=1:1:$l(distinctList, ",") {
			set field = $p(distinctList, ",", i)
			CONTINUE:field=""
			do exploreItemForPushdown(qb, field, "v", parentItemChain, 1)
		}
	} elseif itemType = "e" {	// extrinsic function, aka COS procedure; never push but need to explore its args
		set $$$FTItemContainsLocalReference(topLevelLV, topLevelItem) = 1
		set args = $p(itemInfo, "^", 4)
		for i=1:1:($l(args, ",")-1) {
			set subval = $p(args, ",", i)
			quit:subval=""
			do exploreItemForPushdown(qb, item, "v", parentItemChain, insideAggregate)
		}
	}
.
	// logical conditions will always be considered interesting null behavior - i.e. items to be careful about pushing
	// when they are involved in the RHS of a LOJ
	if lv = "l" {
		set $$$FTItemInterestingNullBehavior(topLevelLV,topLevelItem) = 1
	}
.
	RETURN
} 
.
.
/// Given parent item chain of the format:
///		num^type,num^type,...,num^type
/// Find the nearest parent that is a logical condition
findNearestParentCondition(chain) [ mt ] PRIVATE {
	for i=$l(chain, ","):-1:1 {
		if $p($p(chain, ",", i), "^", 2) = "l" {
			RETURN +$p(chain, ",", i)
		}
	}
	RETURN ""
}
.
.
/// The purpose of this procedure is to create a streamed view, moving a foreign table stream into that view.
/// In the future this should include the possibility of moving multiple joined streams from one QB w/ FTs into 
///	a streamed view. For example, consider a query such as the following:
///
///		SELECT c1, c2, COUNT(c3) FROM ft1 WHERE c2 > 100 GROUP BY (c1, c2)
///
///	We should wish to turn this into the following:
///											
///		SELECT T1.c1, T1.c2, T1.count_1 FROM ( SELECT c1, c2, count(c3) FROM ft1 WHERE c2 > 100 GROUP BY (c1, c2) ) T1
///
///	where the pushability of the conditions/aggregates etc is determined by another procedure and handed to this 
///	procedure. Note that the entire subquery (i.e. streamed view, where it's "streamed" because it's represented by 
///	the contrived stream T1) represented by T1 would be removed from consideration during the rest of query processing, 
///	with the query text inside the T1 subq being regenerated for an external source. This is a trivial example, but 
///	for instance if the query did not contain a GROUP BY then we would not be able to push the aggregate and so our
///	output would look like:
///
///		# evaluate the aggregate locally
///		SELECT T1.c1, T1.c2, count(T1.c3) FROM ( SELECT c1, c2, c3 FROM ft1 WHERE c2 > 100 ) T1
///
/// This procedure is similar in nature to cr8strview^%qaqpre2, which is used often for the purposes of JOIN transforms 
///	within the query processor. There are multiple reasons for not reusing cr8strview for foreign tables:
///		1 - cr8strview relies on certain additional structures that make sense for its existing use cases but would 
///			not be useful for foreign tables
///		2 - foreign tables require additional structures to be moved within the streamed view (e.g. aggregates in 
///			the select-list) which cr8strview would not support and would therefore require additional 
///			external handling if reused.
///
///	There is overlap in the functionality of cr8strview and this procedure and at times we may reuse pieces 
///	of logic in cr8strview.
///
///	---- Parameters ----
///		pushdownUnit				- Index number in mt("ft", "pushdown") that we are moving into a subquery
///
/// ---- Returns ----
/// 	New query block number
///
/// Public variables (may overlap, e.g. mt):
/// 	Needed b/c they store program state we need access to: 			m, mt
///		Needed b/c things we call will need them: 						fval, maxm, mlabel, tname
///
///	Notes:
/// 	- 	Procedure block; public-list is VERY important, we call functions that rely on globally scoped vars!
///		- 	Assumes that all info provided is ok to become an FT streamed view; this proc won't double check that it's 
///			ok to push a condition, SELECT an aggregate, etc.
///		-	Unlike cr8strview, the "v" expressions that need to be rewired are being given to us by the 
///			foreignTablePushdown() logic b/c it identified what needs to be moved to the query. cr8strview needs to
///			build up its trvals() array by calling fvals, we already have it. Once new mt("v") numbers are assigned to
///			to the output of the new QB, we will THEN build up trvals(oldVal) = newVal
/// 	Removed from the cr8strview logic: 
///			- the creation of new values for the copied streams (not the moved streams) and selecting them
///			- getting ID fields for the copy streams
///			- the cloning of the WHERE conditions
///			- copying of TVF structure information and FT information
createFakeStreamForPushdownUnit(pushdownUnit=0) [ fval, m, maxm, mcurs, mlabel, mt, param, tname ] {
	/* 	New the mlabel var so that it can be set by movePushdownUnitToNewQb() to the mlabel of the mlabel that would 
		correspond to the new qb we create, which will become the new stream after allocatedFakeStream*(). mlabel needs 
		to be public for the things we are calling here. It is important that mlabel be coordinated here so that it can
		be set by movePushdownUnitToNewQb() and then utilized by putstr() from within allocate*(). Similarly new m 
		because it needs to be public and need to make sure it is set to the qb that contains the pushdown unit */
	new m, mlabel, param
	RETURN:('pushdownUnit||('$d($$$FTPDU(pushdownUnit))))||($d($$$FTPDURemoved(pushdownUnit))) 0
	
	set m = $$$FTPDUOldQueryBlock(pushdownUnit)	// some helper funcs expect old QB in m, so in here m is always the old QB!
	
	/* -------- (1) Move PDU structure into QB in mt() for easier regeneration -------- */
	set newQb = $$movePushdownUnitToNewQb(pushdownUnit, .streamCommaList, .ftNames, .mlabel)
	set $$$FTPDUNewQueryBlock(pushdownUnit) = newQb
	
.
	/* -------- (2) Set up fake "foreign stream" for new QB w/ fields for each output item of newQb -------- */
	set newStream = $$allocateFakeStreamForQueryBlock(newQb, mlabel, .trvals, .newIdVal)
	set $$$FTFakeStreamServer(newStream) = $$$FTPDUServer(pushdownUnit)
	set $$$FTFakeStreamPDU(newStream) = pushdownUnit
	set $$$FTFakeStreamQueryBlock(newStream) = newQb		// link stream to the QB in the parse tree that represents its logic (mostly for getting info for ShowPlan later)
	set $$$FTRegeneratedQueryBlock(newQb) = newStream		// flag this qb as being only for FT query regeneration so we can skip it for things later
.
		// The FTID field is not supposed to be referenced as it doesn't have much meaning, but it might be, and if any
		// FT stream in this unit had its ID referenced, then all refs to it should change to the ID of the unit as a whole
	set originalStream = ""
	for {
		set originalStream = $o($$$FTPDUOneStream(pushdownUnit,originalStream))
		QUIT:originalStream=""
		set:$d($$$FTIdFieldByOriginalStream(originalStream),originalIdVal) trvals(originalIdVal) = newIdVal
		set $$$FTFakeStreamOneUnderlyingStream(newStream, originalStream) = ""
	}
.
.
	/* 
		-------- (3) Change stream references in rest of QB from old to new --------
		Change old stream # in mt to # of the new foreign stream; fixstrmrefs presupposes some structure in mt("ON") 
		which should be fine here.
	*/
	set m = $$$mtRQb($$$mtR(newStream))	// remember newStream is in the old QB which is where we want to rewire refs
	do fixstrmrefs^%qaqpre2(m, streamCommaList, ftNames, newStream, mlabel, 1, 1)
	//do fixrefs^%qaqpnl(m, "", .trvals, 1, 0, 1, 1)
.
.
	/* -------- (4) Generate query for foreign stream; deactivate temp qb b/c no longer needed -------- 
		NB: do this before fixrefs, the subquery and the outer query might reference some vals together. We can
		avoid the headache of cloning if we just generate the subq external query text here (while the subq is in a good
		state w.r.t. references but outer query maybe not) then update the references (putting the outer query in a good
		state but the subquery maybe not) and then siomply deactivate the subquery. */
	merge mt("ptrel") = $$$ptrelRoot
	set sql = $$buildsubq^%qaqcmh(newQb)
	/*
		Change old mt("v") vals of fields, expr's etc. to new "fields" of foreign stream; 
		Unlike typical fixrefs, pass ft=1 to call custom logic for setting vals. See note above - we do this
		after generation of the subquery for a reason.
	*/
	do fixrefs^%qaqpnl(m, "", .trvals, 1, 0, 1, 1)
	
	set $$$FTFakeStreamQuery(newStream) = sql
	set $$$mtPQbIsActive(newQb) = 0					// deactivate the new query block - was just to generate the fakeStream query which we already did
	
	RETURN newStream		// originally returned new qb when I planned to use streamed views
}
.
.
/// Called by createFakeStreamForPushdownUnit(). This procedure encapsulates logic to move the structure that we
/// determined could be represented in one regenerable pushdown unit into a query block. This query block will be short
/// lived in order for us to create a SQL statement that represents its structure and turn it into a fake "foreign 
/// stream" and then deactivate it.
///
/// In the future this should include the possibility of moving multiple joined streams from one QB w/ FTs into 
///	a query block. For example, consider a query such as the following:
///
///		SELECT c1, c2, COUNT(c3) FROM ft1 WHERE c2 > 100 GROUP BY (c1, c2)
///
///	We should wish to turn this into the following:
///											
///		SELECT T1.c1, T1.c2, T1.count_1 FROM ( SELECT c1, c2, count(c3) FROM ft1 WHERE c2 > 100 GROUP BY (c1, c2) ) T1
///
///	where the pushability of the conditions/aggregates etc is determined by another procedure and handed to this 
///	procedure. Note that the entire subquery represented by T1 would be removed from consideration during the rest of 
///	query processing, with the query text inside the T1 subq being regenerated for an external source. This is a 
///	trivial example, but for instance if the query did not contain a GROUP BY then we would not be able to push the 
/// aggregate and so our output would look like:
///
///		# evaluate the aggregate locally
///		SELECT T1.c1, T1.c2, count(T1.c3) FROM ( SELECT c1, c2, c3 FROM ft1 WHERE c2 > 100 ) T1
///
///
/// This procedure is similar to cr8strview^%qaqpre2, which is used often for the purposes of JOIN transforms 
///	within the query processor. There are multiple reasons for not reusing cr8strview for foreign tables:
///		1 - cr8strview relies on certain additional structures that make sense for its existing use cases but would 
///			not be useful for foreign tables
///		2 - foreign tables require additional structures to be moved within the subquery (e.g. aggregates in 
///			the select-list) which cr8strview would not support and would therefore require additional 
///			external handling if reused.
///		3 - we do not wish to leave the query block around as a proper streamed view because we do not want it to
///			undergo further processing
///
///	There is overlap in the functionality of cr8strview and this procedure and at times we may reuse pieces 
///	of logic in cr8strview.
///
///	---- Parameters ----
///		pushdownUnit				- Index number in mt("ft", "pushdown") that we are moving into a subquery
///		streamCommaList				- (PBR) The caller needs this list too so we do it once here and return it
///		ftNames						- (PBR) names of the moved foreign tables returned for the caller
///		mlabel						- (PBR) m^label for the newQb created here (as if it were a streamed view), which
///										will become the mlabel of the fake stream created off of this qb. That part is
///										done by the caller so returned for the caller to use
///
/// ---- Returns ----
/// 	New query block number
///
/// Public variables (may overlap, e.g. mt):
/// 	Needed b/c they store program state we need access to: 			m, mt
///		Needed b/c things we call will need them: 						fval, maxm, mlabel, tname
///
///	Notes:
/// 	- 	Procedure block; public-list is VERY important, we call functions that rely on globally scoped vars!
///		- 	Assumes that all info provided is ok to become an FT query block; this proc won't double check that it's 
///			ok to push a condition, SELECT an aggregate, etc.
///		-	Unlike cr8strview, the "v" expressions that need to be rewired are being given to us by the 
///			foreignTablePushdown() logic b/c it identified what needs to be moved to the query. cr8strview needs to
///			build up its trvals() array by calling fvals, we already have it. Once new mt("v") numbers are assigned to
///			to the output of the new QB, we will THEN build up trvals(oldVal) = newVal. This is done via the 
///			mt("ft", "pushdown") structure
/// 	Removed from the cr8strview logic: 
///			- the creation of new values for the copied streams (not the moved streams) and selecting them
///			- getting ID fields for the copy streams
///			- the cloning of the WHERE conditions
///			- copying of TVF structure information and FT information
movePushdownUnitToNewQb(pushdownUnit, &streamCommaList, &ftNames, &mlabel) [ fval, m, maxm, mcurs, mlabel, mt, tname ] PRIVATE {
	new fval, tname 	// public for called subroutines but must have fresh values
	set stream = "",streamCommaList=","
	for {
		set stream = $o($$$FTPDUOneStream(pushdownUnit,stream))
		QUIT:stream=""
		set streamCommaList = streamCommaList_stream_","		// newquery() expects streamCommalist to be comma pre/post delimited:  ,[s1,s2],
	}
	set label = $$$FakeStreamPrefix_pushdownUnit
.
.
	/* 
		-------- (1) Create new query block skeleton in mt() and move the given stream to it --------	
		Typically copies "corr" over, but top-level FT streamed views don't have correlated references by definition 
	*/
	set newQb = $$newquery^%qaqpre2(m, streamCommaList, .ftNames, 1)
	set $$$mtCorrParentQb( newQb) = 0
	#; for hint="%NOFLATTEN","%NOSVSO","%NOTOPOPT","%NOMERGE","%NOUNIONOROPT","%NOREDUCE" { 
	#; 		// mark hints so none of these transforms are done
	#; 		set mt("hint", newQb, hint)=1 
	#; }
	//set xlate("qb", m) = newQb	used by cr8strview for cloning, but we don't clone...
	
.
	/* 
		-------- (2) Move everything: FROM, SELECT, WHERE, GROUP, HAVING, ORDER, TOP, DISTINCT + remove from original QB. -------- 
	*/
	do moveClausesToNewQb(pushdownUnit, m, newQb)
	// Set up piece-4 of $$$mtP(newQb) that lists corr refs - unnecessary? but wouldn't hurt
	//do setqparms^%qaqpre2(m, newQb, streamCommaList)
 
.
	/* 	
		-------- (3) Move mts, repoint ptv, setup "AS" and select-list based on fcols, putval a new  --------
		query q^ node, fix all subqs in the new query to say the new QB is their parent, take old streams out of nulstr.
	*/
	set select = $$$mtOutput(newQb)
	set doHaving = $d($$$mtHaving( newQb))
    do finishquery^%qaqpre2($p(select,"^",2), newQb, streamCommaList, doHaving, 1)
	
	
	/* 
		-------- (4) Provide label for this streamed view QB in the outer QB	-------- 
		e.g. SELECT newc1 FROM (SELECT c1 as newc1 from FT) AS newlabel, we want outer QB to have the newlabel qb stream
	*/
	set mlabel = m_"^"_label
.
	RETURN newQb
}
.
.
/// Utility for movePushdownUnitToNewQb() to encapsulate sublogic in one place.
/// Moves mt of "w", "h", "g", "s" from oldQb to newQb. Also moves SELECT, although this is technically
/// "overwritten" (to the same values) by finishquery()
moveClausesToNewQb(pushdownUnit, oldQb, newQb) [ mt ] PRIVATE {
.
	// Move over new FROM clause and "ON" information from the staging area of the pushdownUnit and then rewrite the oldQb
	// info as well
	// NB: mt("f") will be done with new fake stream by allocateFakeStreamForQueryBlock(), and old streams are already removed by newquery^%qaqpre2()
	if $d($$$FTPDUmtON(pushdownUnit)) {
		merge $$$mtOnRoot(newQb) = $$$FTPDUmtON(pushdownUnit)
	}
	set $$$mtFromList(newQb) = $g($$$FTPDUfrom(pushdownUnit))
	if '+$g($$$FTQBFromClauseMoved(oldQb)) {	// only do this once for each oldQb
		kill $$$mtOnRoot(oldQb)
		merge $$$mtOnRoot(oldQb) = $$$FTQBmtON(oldQb)
		set $$$mtFromList(oldQb) = $g($$$FTQBfrom(oldQb))
		set $$$FTQBFromClauseMoved(oldQb) = 1
	}
.
	set $$$mtWhere(newQb) = $g($$$FTPDUClause(pushdownUnit,$$$WHERE))
	if $$$mtWhere(newQb) = "" {
		kill $$$mtWhere(newQb)
	} else {
		set oldQbWhere = "^"_$g($$$mtWhere(oldQb))
		for condIdx=1:1:$l($$$mtWhere(newQb), "^")-1 {
			set commaDelimitedCondition = "^"_$p($$$mtWhere(newQb), "^", condIdx)_"^"
			if oldQbWhere [ commaDelimitedCondition {
				set oldQbWhere = $replace(oldQbWhere, commaDelimitedCondition, "^")
			}
		}
		set $$$mtWhere(oldQb) = $e(oldQbWhere, 2, *)	// we ^-delimit in the front for easier handling
		kill:($$$mtWhere(oldQb)="") $$$mtWhere(oldQb)
	}
.
	set group = $g($$$FTPDUClause(pushdownUnit, $$$GROUPBY))
	if group '= "" {
		set $$$mtGroupDistinctList( newQb) = group
		kill $$$mtGroupDistinctList( oldQb)
	}
.
	set having = $g($$$FTPDUClause(pushdownUnit, $$$HAVING))
	if having '= "" {
		set $$$mtHaving( newQb) = having
		kill $$$mtHaving( oldQb)
	}
.
	set order = $g($$$FTPDUClause(pushdownUnit, $$$ORDERBY))
	if order '= "" {
		set $$$mtSequencersQb(newQb) = order
		do orderByHelper(oldQb, 1)	// handles killing the old qb ORDER BY
	}
	
	set top = $g($$$FTPDUTop(pushdownUnit))
	if top '= "" {
		set $$$mtTopArg(newQb) = top
		set $$$mtTopStyle( newQb) = $$$FTPDUTopStyle(pushdownUnit)
		do rowLimitHelper(oldQb,,,1)	// kill based on where the TOP info is coming from
	}
.
	set offset = $g($$$FTPDUOffset(pushdownUnit))
	if offset '= "" {
		set $$$mtOffset(newQb) = offset
		set:'$d($$$mtTopStyle(newQb)) $$$mtTopStyle(newQb) = "ANSI"	// we always set TOPSTYLE if any pagination present
		kill $$$mtOffset(oldQb)
	}
.
	if $g($$$FTPDUDistinct(pushdownUnit)) {
		/* Remove local mt("distinct") processing. Quirks:
				1. SELECT DISTINCT ... GROUP BY
					- We handle this differently than other DBs (we ignore the DISTINCT). We should just push the 
					grouping and remove the distinct processing locally or else we would yield different results
					than we normally do. Don't transfer mt("distinct") to new QB so that we don't generate SELECT 
					DISTINCT...GROUP BY for the external source - they could have different results.
				3. SELECT DISTINCT ...
					- If we are pushing this DISTINCT then we don't need to process it locally. Set mt("distinct") on
					the new QB and then remove from the old
.
				Note we never do pushing of DISTINCT BY () and that would disable aggregates etc. Note also we could
				have SELECT DISTINCT agg() FROM tab, in which case the distinct is useless.
.
				We remove the d^ in the old SELECT list when we move over the SELECT
		*/
		if group = "" {
			set $$$mtDistinct( newQb) = ""				// "distinct" node is set to "" in mt when it's present
		}
		kill $$$mtDistinct( oldQb)
	}
.
.
	// don't clean up the old select, references inside of it will just get rewired later
	set select = $g($$$FTPDUClause(pushdownUnit, $$$SELECT))
	if select = "^" {	// empty
		set $p(select,"^",2) = $$$newval("t^1",1)_","		// should be unlikely (impossible?) to happen
	} else {
		// d^ implies distinct rows via DISTINCT or GROUP BY. If we're doing this in the pushed query null out the
		// d^ on the old QB's SELECT list
		if $p(select, "^", 1) = "d" {
			set $$$mtOutputDistinct($$$mtOutput(oldQb)) = ""
		}
	}
	// the avg() function is currently put into "vtr" as a string, for now we do quick override for FTs until we can
	// fix the actual filing of all avg() functions in mt to be numeric types
	set selectVals = $p(select, "^", 2)
	for i=1:1:$l(selectVals,",")-1 {
		set val = +$p(selectVals,",",i)
		QUIT:'val
		// fix datatype of this avg() function in mt("vtr")
		if $$$mtVType($$$mtV(val))="v", $p($$$mtV(val),"^",2)="/0" {
			// sets the vtr datatype as NUMERIC or DOUBLE based on arguments; we will tell it to treat as division operator, which avg() basically is
			do NumericOrDouble2^%qaqpdt(val, $p($$$mtV(val),"^",4), $p($$$mtV(val),"^",5), "/")
		}
	}
	set $$$mtOutput(newQb) = select
}
.
.
/// Create a new foreign stream, complete with stream number + irn + ifns etc. NOT a virtual stream (no query block)
/// ---- Parameters ----
///		newQb					- the new subquery qb # that this stream is being created off of
///		mlabel					- m^label where m is the old query block that this stream is created in
///		trvals					- (PBR) trvals(oldVal) = newVal so we can fix references to mt("v") nodes throughout mt
allocateFakeStreamForQueryBlock(newQb, mlabel, &trvals, &newIdVal) [ fval, m, maxm, maxs, mcurs, mt, mtc, mts, ptj, ptv ] PRIVATE {
	// Create a fake table in smd() for the above stream, complete with fields and master map. Will return via PBR 
	// args the irn/ifns/imp assigned. This procedure needs mt!
	set selectList = $p($$$mtOutput(newQb), "^", 2)
	do addFakeStreamToDataDictionary^%qTable(selectList, .fullTableName, .irn, .ifns, .imp)
	set idIfn = ifns(0)
	set $$$FTirnIsFakeStream(irn) = 1
	set $$$FTimpFromFakeStream(imp) = 1
	set $$$FTifnFromFakeStream(idIfn) = 1
	set $$$mtFromTableName(mlabel) = fullTableName 			// table name assigned when we add fake info to smd()
	
	// assign new stream tied to fake irn
	do putstr^%qaqpqo(mlabel, irn)
	set stream = $g($$$ptrel(mlabel))		// putstr() will put stream number here, avoids public var
	set $$$FTFakeStream(stream) = 1
.
	// add vals for the fields in the parse tree; the logic called will use our fake smd() to get the information
	set positionInSelect = ""
	for {
		set positionInSelect = $o(ifns(positionInSelect), 1, ifn)
		QUIT:positionInSelect=""
		set fval = $$$newval("junk",1)
		if positionInSelect = 0 {
			set oldVal = 0
			set newIdVal = fval
		} else {
			set oldVal = $p(selectList, ",", positionInSelect)
			set trvals(oldVal) = fval
		}
		
		set $$$FTifnFromFakeStream(ifn) = 1
		do foreignField^%qaqpqo(fval, positionInSelect, stream, ifn, oldVal)
	}
	
	// always need to do this?
	if mcurs'="", m=1, $$$mtStatementType = "DEC" {
		set mtc(mcurs,"f") = stream_","_$$$mtRIrn($$$mtR(stream))_","_fullTableName
	}
	
	RETURN stream
}
.
.
/// Function to move information about FTs when QBs are copied etc. Called by various functions such as:
///		newquery^%qaqpre2
///		mrgstrview^%qaqpre2
/// Caller should confirm that this should be called
copyFTInformation(oldStream=0, newStream=0, oldmlabel="", newmlabel="", killOld=0) [ mt ] PUBLIC {
	RETURN:'oldStream 
	if +$g($$$FTFakeStream(oldStream)) {
		// fake stream created post-pushdown for some queryable FT so all we really need to do is make sure
		// the new stream has the same post-pushdown information as the old one
		merge $$$FTFakeStream(newStream) = $$$FTFakeStream(oldStream)
		RETURN
	}
	// this is an actual defined FT on the system ("original FT stream") so we need to move over mlabel information
	if oldmlabel {
		set $$$QueryBlockContainsFTs(+newmlabel) = 1
		set $$$FTByLabel(newmlabel) = $$$FTByLabel(oldmlabel)
		kill:killOld $$$FTByLabel(oldmlabel)
	}
	// The caller doesn't always need streams moved over - e.g. we are merging a stream into an outer query block
	// so the stream information all stays the same and only the mlabel information is changing
	if newStream {
		set $$$FTByOriginalStream(newStream) = $$$FTByOriginalStream(oldStream)
		kill:killOld $$$FTByOriginalStream(oldStream)
	}
}
.
.
/// Handed a name  (e.g. "OFF"), determines if that is a valid pushdown type name based on the current list of
/// pushdown type names in 
isValidPushdownTypeName(pushdownTypeName) [] PUBLIC {
	RETURN ($$$pushdownTypeNameToNumber($$$UPPER(pushdownTypeName)) >= 0)
}
.
.
/// After all pushdown analysis is done, remove any subscripts from mt() that were only needed for analysis and will
/// not be needed from now on.
cleanParseTree() [mt] PRIVATE {
	kill $$$FTQueryBlocks				// info about query blocks as we evaluate them
	kill $$$mtFtPushdownCond		// info about conditions as we evaluate
	kill $$$mtFtPushdownExpr		// info about expressions etc
	kill $$$FTPushdownUnits				// at this point, needed info for each pushdown unit has been moved under its corresponding fake stream
	kill $$$mtFtPushdownUnitMap		// no longer need to map between them
}
.
.
/// Row limiting can potentially appear in multiple locations according to the following rules. This procedure is 
/// meant to collapse these locations into one place to say "if there is TOP / LIMIT / FETCH for the given query block,
/// return the value of $$$mtTopArg(qb) etc. Also returns the style (TOP / LIMIT / ANSI(i.e. fetch)) for the query block
/// in the PBR style parameter
///
///	Parameters:
///		qb		- query block to look in
///		style	- (PBR) TOP, LIMIT, or ANSI to specify whether the style used was TOP, LIMIT, or FETCH respectively
///		offset	- (PBR) mt("v") value specifying the offset if there is one
///		kill	- 1/0, if 1 then this is being called as part of cleaning up the row limiting flags in the specified QB
///
///	Returns:
///		mt("v") value that specifies the row limiting value. See also PBR 'style' and 'offset' parameters. If called with
///		kill=1, has the side effect of modifying the parse tree row limiting clause of the given qb.
rowLimitHelper(qb, &style, &offset, kill=0) [mt] PRIVATE {
	set topVal="", style="", offset=""
		// sets 'top' if true. Use ! to prevent short circuit, then the offset $d() check will always be run and will always
		// populate 'offset' if there's an offset
	if $d($$$mtTopArg(qb), topVal) ! $d($$$mtOffset(qb), offset) {
		set:+topVal style = $g($$$mtTopStyle( qb))
		kill:kill $$$mtTopArg(qb), $$$mtTopStyle(qb), $$$mtOffset( qb)
	} elseif qb=1, '$d($$$mtUnion(qb)) {	
		// for LIMIT/FETCH, row limiting goes in mt("top") if applying to a specific query block. For example in 
		// SELECT ... UNION (SELECT ... FETCH FIRST 10 ROWS ONLY)  the FETCH applies to the second QB and would go in 
		// $$$mtTopArg(2) with mt("topstyle",2) filled out, which would've been handled by the above
		// But if there's only one query block and there's an order by, then the LIMIT/FETCH for the first query block will be in $$$mtRowlimit.
		// But if tere's a union, then $$$mtRowlimit applies to the entire UNION result and no one query block
		if $d($$$mtRowlimit, topVal) { 	// also sets 'top' if true
			set style = $g($$$mtRowlimitStyle)
			kill:kill $$$mtRowlimit, $$$mtRowlimitStyle
		}
		set offset = $g($$$mtRowOffset)
		kill:kill $$$mtRowOffset
	}
	RETURN topVal
}
.
.
/// See notes about rowLimitHelper(). This is similar for order by and returns the order by clause asociated with the query block
/// If looking for the first query block, and there is not $$$mtTopArg(1), then the order by is stored in $$$mtS. Otherwise,
/// it's stored in $$$mtSequencersQb(qb)
///
/// Parameters:
///		qb		- query block to look for an ORDER BY in
///		kill	- 1/0, if 1 then this is being called to kill the ORDER BY of the specified 'qb'
///
///	Returns:
///		The ORDER BY clause value of the given query block, or "" if no such. If called with kill=1, has the side effect
///		of modifying the parse tree ORDER BY clause of the given qb.
orderByHelper(qb, kill=0) [mt] PRIVATE {
	set order = ""
	if $d($$$mtTopArg(qb)) {
		set order = $g($$$mtSequencersQb(qb))
		kill:kill $$$mtSequencersQb(qb)
	} elseif qb=1 {
		set order = $g($$$mtSequencers)
		zkill:kill $$$mtSequencers
	}
	RETURN order
}
