^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqcky^MAC^^^0
%qaqcky	// asl code generation of the nexting mechanism
	;; COMPONENTS :: SQL/CodeGeneration
	#;
#include %msql
#include %BigData.ShardingManager
#INCLUDE %SYS.PTools.Stats
#IF 0   ;-------------------------------------------------------------
	; Description:   asl code generation of the nexting mechanism
	; Author:        Aviel Klausner
	; Date Started:  1987
	;
	;  AK1047  (10/06/2021) - Columnar WHERE filter for "onerow"/GROUP BY
	;  AK1046  (07/30/2021) - Columnar aggregates with GROUP BY
	;  AK1045  (06/30/2021) - Columnar 'onerow' aggregates on expressions
	;  AK1044  (06/28/2021) - Fix 'opg' set-looping code-generation for IN
	;  AK1041  (05/14/2021) - Columnar "onerow" with no WHERE
	;  JMM1092 (04/13/2021) - Fix issues with adding shards while sharded queries are running
	;  JMM1090 (03/26/2021) - Fix timing issues with dropping, re-creating tables during rebalancing
	;  JMM1073 (01/26/2021) - Correctly execute parallel shard-local queries while rebalancing is in progress
	;  JMM1064 (12/18/2020) - Sharding optimization: don't store tempfile names in IRIS.Temp.IRIS.Sql
	;  AK1032  (11/16/2020) - Allow streamless expression as TVF argument
	;  AK1021  (08/05/2020) - Compute streamless expressions on the master
	;  JMM1035 (04/15/2020) - Force insert/select to insert locally on shards with undocumented ISCShardLocalInsert query option
	;  JMM1009 (12/10/2019) - In $SYSTEM.SQL.Shell(), aggregate globals/cmds/disk stats for sharded queries
	;  JMM992  (10/22/2019) - Permit same job to execute multiple concurrent sharded queries
	;  AK1007  (08/21/2019) - Distributed DML filing on parallel servers
	;  AK995   (01/08/2019) - Record shard server rows read by shard master
	;  AK988   (10/29/2018) - One-pass GROUP BY with no temp-files
	;  AK991   (11/05/2018) - Simplify loop suppression following DPV5329
	;  JMM837  (03/09/2018) - Unified routine and globals databases for sharded cluster
	;  AK972   (11/09/2017) - Fix sharded FULL OUTER JOIN
	;  JMM789  (05/10/2017) - Sharded query governor/cancel mechanism
	;  JSL5057 (04/06/2017) - new the variable passed by reference to fetch, don't use asl directly to calculate name of oref directly
	;  JSL5056 (04/01/2017) - generate handling of fetch information from oref
	;  JSL5054 (04/01/2017) - use asl to code generate support for RTPC (Run Time Plan Choice)
	;  AK956   (07/29/2015) - Pad BM chunk with fake row for chunk looping
	;  AK939   (09/10/2015) - Sharded outer joins
	;  JMM669  (10/08/2015) - Shared nothing: Implement improved performance trace calls
	;  AK938   (07/29/2015) - Sharded joins
	;  AK907   (04/29/2014) - Use $$SplitSize() for %PARALLEL partitioning
	;  AK902   (02/21/2014) - Parallel GROUP BY partitioned by FROM
	;  AK841   (12/21/2011) - Use extended local arrays for some temp-files
	;  AK853   (03/21/2012) - Apply TOP condition as subscript-limiting
	;  AK688   (01/24/2008) - Abstract index/filter conditions
	;  AK849   (01/18/2012) - Parallel processing for UNION
	;  AK808   (04/27/2011) - Apply collations to given join values
	;  AK732   (04/03/2009) - Compute %EXTERNAL/%ODBCOUT/collations ASAP
	;  AK719   (01/06/2009) - Handle %STARTSWITH for a %Name field
	;  DPV3276 (09/30/2008) - Correct code generation syntax issue in nextcond
	;  AK709   (06/19/2008) - National collation subscript with %STARTSWITH
	;  AK699   (05/09/2008) - Get %row only if looping on all subscripts
	;  AK691   (02/14/2008) - Implement heterogeneous queries
	;  DPV3211 (03/11/2008) - tag name changes for class compiler performance improvements
	;  BJB366  (10/16/2007) - Generate Goto Bottom, AK600, for Cache SQL Storage with NEXT CODE
	;  DPV3047 (10/04/2007) - Fully support StreamField IS [NOT] NULL
	;  ATG001  (02/27/2007) - Use $g to avoid <UNDEFINED> in dun code's null marker transformation
	;  DPV2839 (01/17/2007) - SQL: Various performance improvements to SQL/Routine compilers
	;  AK657   (10/19/2006) - Fix looping up to a constant subscript
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  AK649   (06/06/2006) - Fix "u" looping for NULL=*NULL OUTER JOIN
	;  AK614   (11/19/2004) - Index-assisted aggregates optimization
	;  AK646   (05/05/2006) - Subscript with %STARTSWITH on empty string
	;  DPV2593 (02/21/2006) - SQL Enhancement: Use private global for SQL instead of ^mtemp0
	;  JLF074  (01/03/2006) - Handle null mapid case in markAnyofSubs
	;  AK621   (03/21/2005) - DESC for SpecialNextCode
	;  AK619   (03/04/2005) - Parent reference with >10 physical parts
	;  AK620   (03/09/2005) - Fix DESC for "set" traversal
	;  AK608   (09/09/2004) - SELECT SUM(f) FROM t using bitslice
	;  AK600   (05/25/2004) - Fixes to loop suppression code generation
	;  DPV2260 (08/10/2004) - Fix code generation of long 'good' line with ref1 about 400+ chars in length
	;  DPV2200 (03/18/2004) - Fix stopcond check on negative numeric values and NULL
	;                         SQL Fix ProdLog 36296: viewtest: a query with column < negative number returns wrong results
	;  DPV2194 (03/11/2004) - Set mstop properly
	;                         SQL Fix ProdLog 36182:  unit test for AK583 fails: a query returns a wrong result set
	;  DPV2131 (11/25/2003) - SQL Fix ProdLog 34794:  Order By Desc does not always work with $Piece mapping
	;  AK583   (11/10/2003) - Use $$$sysUNICODE for %STARTSWITH DESC
	;  AK567   (05/30/2003) - Outer join into a split parent ref. subscript
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  AK574   (08/15/2003) - Set padcode before "next" loop
	;  DPV2055 (08/05/2003) - Fix ORDER BY DESC over set of values
	;  AK570   (06/25/2003) - DESCending on a bitmap
	;  DPV1940 (02/20/2003) - Fix code-gen problem in invalid^%qaqcky where 255 line length limit was still assumed
	;  AK551   (12/12/2002) - Suppress looping below a KEY level
	;  AK548   (11/19/2002) - NULL marker for last subscript "y"
	;  AK532   (09/02/2002) - NULL testing for "u" subscript and OUTER JOIN
	;  DPV1799 (08/20/2002) - Support stream fields in colnul
	;  AK513   (03/19/2002) - BSL code generation
	;  AK518   (04/18/2002) - Pad collated fields
	;  AK519   (05/06/2002) - IDX: Fix subscript dataaccess wandering naked
	;  AK514   (03/26/2002) - Filter inherited bitmaps
	;  AK506   (01/22/2002) - ASL for chunk and bit manipulation
	;  AK505   (01/11/2002) - Code generation for SET looping in KEY
	;  AK503   (12/17/2001) - Use bitmaps anywhere
	;  DPV1528 (04/19/2001) - Fix <UNDEFINED> of "Z" variable when it hasn't been initialized.
	;  AK467   (02/27/2001) - Use $BIT for an id list temp-file
	;  AK464   (02/02/2001) - Salva: conditions for OUTER JOIN
	;  DPV1441 (11/14/2000) - Support user-defined NULLSubscriptMarker
	;  DPV1351 (07/31/2000) - Fix up refdvar - use proper global structure
	;  DPV1327 (06/22/2000) - Fix ORDER BY DESC problem on 8-bit system
	;  AK436   (04/12/2000) - CCS#146: Use "]]" instead of "]"
	;  DPV1277 (03/14/2000) - Fix NULL subscript marker expression swapping with subscript vars
	;  AFH268  (07/30/1997) - ME: fix piece counter incrementing
	;  DPV1244 (01/13/2000) - Don't imply a stop condition of field'=+field numeric data
	;  DPV1171 (10/22/1999) - Don't code generate ALPHAUP/UPPER functions
	;  DPV1151 (10/01/1999) - Support SQLUPPER and SQLSTRING Collations
	;  AK394   (09/17/1999) - Generate $SORT* for temp files
	;  AK391   (08/31/1999) - Hycom: Outer join into unique index
	;  AK388   (08/06/1999) - Uniface: NULL in conditions
	;  DPV1095 (06/28/1999) - Add truncate parameter to STRING function
	;  DPV1006 (04/07/1999) - String collation support
	;  DPV1004 (03/16/1999) - Support NUMERIC ODBC Type
	;  DPV997  (03/09/99)   - Fix problem where 'Z' variable was initialized 
	;                         too late
	;  DPV992  (03/05/99)   - Fix unicode order by ... desc problem
	;  DPV966  (02/04/99)   - VA:  Support Map Subscript Loop Initialization value
	;  DPV963  (02/02/99)   - Fix multiple LIKE conditions on subscripts.
	;  DPV880  (09/30/98)   - TIMESTAMP category is not numeric
	;  DPV878  (09/25/98)   - Fix DPV700 problem in next to avoid infinite
	;                         loop at run-time.
	;  AK327   (07/28/98)   - Replace LOCK +^mtemp with $INCREMENT(^mtemp0)
	;  DPV837  (05/07/98)   - CLEAN UP:  Eliminate need for old datatype
	;  DPV836  (05/04/98)   - Fix multiple occurances of ordertag in 1 rtn
	;  MRP713  (03/28/98)   - SQLI Mapper - Stop Expression
	;  MRP725  (02/03/98)   - Fix tag problems with MRP700
	;  MRP700  (07/08/97)   - Optimize Complex OR & IN Conditions
	;  DPV751  (06/23/97)   - Raname %aaa* to %qcg*.  Derived from %aaakey*
	;                         Changed all II's to ","
	;  BJB067  (03/12/97)   - Handle 10 or more subscript levels
	;  DPV700  (01/22/97)   - Handle NULL Subscript Markers
	;  MIT061  (01/17/97)   - Remove $P($C(1)) from field node value in QP
	;  MRP643  (10/02/96)   - Modularize Embedded SQL Code: 'gvar' to 
	;                         '$$$MSQLModuleVariable'
	;  MRP640  (08/26/96)   - Fix Multiple ANDed LIKE :hostvar Problems
	;  MRP633  (07/26/96)   - Fix DPV641: Check Proper Log#
	;  MRP627  (07/22/96)   - Generate Pattern Match for Recursive Conds
	;  DPV641  (07/15/96)   - Start at correct place when doing < TextField
	;                         and DESCENDING.
	;  MRP623  (06/28/96)   - Don't replicate pattern ptch for LIKE :hostvar
	;  DPV624  (05/30/96)   - SAIC:  Fix <SUBSCRIPT> error in SQL Query code
	;  MRP603  (04/25/96)   - Add LIKE condition for UNIQUE subs
	;  MRP599  (04/09/96)   - Apply Subquery Looping Conditions
	;  DPV603  (03/06/96)   - Make d in a local call
	;  AFH205  (02/29/96)   - use pattern match to check for numeric in
	;                         start/stop conds.
	;  MRP570  (01/29/96)   - Transaction Processing
	;  MRP564  (01/17/95)   - Check proper exists conditions for Access
	;                         Type of 'Other'
	;  MRP562  (12/18/95)   - Allow LIKE <multiple-choice-field>
	;  DPV578  (12/06/95)   - Make NULL Date, Time and Number fields
	;                         collate first when Ordered By.
	;  MRP542  (11/08/95)   - Moved 'startval()', 'startsw()', & 
	;                         'startlog()' to %aaakey2 because >8K
	;                         --- Clean the Module up during the move ---
	;  MRP540  (11/03/95)   - Don't repeat LIKE pattern condition for
	;                         JOINed queries
	;  MRP538  (11/01/95)   - COBE: Fix Code-Gen of conditions BUG caused by JC001
	;  MRP507  (06/19/95)   - Handle %ALPHAUP for LIKE, remove . & ""
	;  DPV487  (06/19/95)   - Make routine < 8K OBJ size by cleaning up
	;                         routine
	;  DPV458  (05/25/95)   - Fix line too long caused by MRP496.
	;                         Clean up code
	;  RLL600  (05/10/95)   - Support FETCH %ROWCOUNT = <rowcnt>
	;  RLL597  (05/09/95)   - Fix skip code for Access Type = "Other"
	;  MRP499  (05/08/95)   - Fix <SUBSCRIPT> for 'convert' subs
	;  RLL594  (04/24/95)   - Fix %STARTSWITH code generation bug
	;                         (MRP-3 May 95: I had to remove this change
	;                                      due to further problems)
	;  MRP496  (04/08/95)   - Support Optimized LIKE {<const> | <host var>}
	;  MRP466  (11/28/94)   - Handle Collation Expressions
	;  PRT017  (07/22/94)   - RowId based on many fields
	;  PRT016  (07/21/94)   - Start with " " if numeric descending order
	;  PRT009  (04/15/94)   - Fix infinite loop in repl+1
	;  MRP379  (03/04/94)   - Process new prefix extended functions 
	;                         (+, -, " ") for index maps
	;                         *** REMOVED Some: Keep around for info ***
	;  RLL382  (11/29/93)   - fix start val for descending non-numeric sort
	;  DPV059  (03/01/93)   - Make most comments #if 0's to decrease source
	;  AK029;AK031;AK035;AK036;AK040;AK046;AK048;AK069;AK071
	;  AK094;AK095;AK104;AK107;AK109;AK130;AK145;AK146;AK161
	;  ALL001;AK188;EYT149;ALL003;AK207;AK216;RLL097;MRP254
	;  AK224;MRP275(NOT FINNISHED);AK247;AK253;AK261;RLL307
	;  EYT149;AK208;AK211;AK216;MRP254;AK235;AK259
	;  EYT 09/05/90
	;  supercedes old %aaakey1 which was merged with %aaakey in AK161
	;  EYT149
	;   moved here parts of strtstop,padcode, moved back stuff  ;  AK216
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
#ENDIF  ;-------------------------------------------------------------
	$$$Abort  ; Not an Entry Point!!
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  col# for given ifn.  qno, str had better be set.
#define instream(%ifn) $p($g(mts(qno,str,"ATT",%ifn)),"^",5)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  access a map or a temp-file, as specified in asl(mod,funk,ndata)
axes(funk,ndata)  ;  Main entry-point for both KEY and PRE/POSTKEY
	#; This part creates the Code to do the Looping mechanism.
	#; It calls the build subroutine and the Data GET.
	#;  [public: mt,mts,sqline,lines,line,tag,asl,mod,bottom,grup]
	#; AK849
	n havar s havar=""  ;  whether have already top-node data in this var
	#; AK513
	GOTO:$g($$$aslRoot(mod,funk))="bsl" bsl^%qaqcbsl
	#; AK691
	GOTO:$g($$$aslRoot(mod,funk))="dsn" gendsn^%qaqcmh
	#; JLF015
	n mapid,tempid,str,qno,temptype,hival,loval,good,ptnvars,rtype,smdmapid s smdmapid=""
	#;  $P(stuff):
	#;  2. mapid - imp of map involved
	#;  3. tempid - modnum ^ actnum  ;  "build" location of
	#;     temp-file involved, special cases for actnum=0
	#;  5. "p" if padding (outer join logic) involved
	#;  15. temptype - "virtual temp-file" - tempid=source^0
	#;      "vecvar"/"bmvar" - read from vector/bitmap source at position loval
	#;      "convar" - assign loval (or NULL) to a CON field (source=-11)
	#;  16. hival - request to evaluate %ID offset - (chunknum-1)*64000
	#;  17. loval - position within vector/bitmap - %ID#64000+1
	#;              for CON, loval is 'other' value, or missing for IS NULL
	#;  18. ptnvars - var ids for partition subscripts
	
	s stuff=$$$aslPkId(mod,funk,ndata)
	set mapid=$$$aslIdMapId(stuff)
	set tempid=$$$aslIdTfBuildLoc(stuff)
	set padnext=($$$aslIdPaddingOjLogic(stuff)="p")
	set str=$$$aslIdStrNum(stuff)
	set qno=$$$aslIdQb(stuff)
	set temptype=$$$aslIdTfType(stuff)
	set hival=$$$aslIdHighVal(stuff)
	set loval=$$$aslIdLowVal(stuff)
	set ptnvars=$p(stuff,$c(1),18)
	s:$e(tempid,*)="^" tempid=tempid_0  ;  AK1046
	#;  read value from vector/bitmap/CON condition  ;  AK1049;AK1081
	i tempid["^0",funk'=2,temptype'="oarvar"  { n icol s icol=+$g($$$aslPkFlds(mod,funk,ndata)) $$$liin("s "_pti(icol)_"="_$$temp0(+tempid)) d vset^%qaqcdt(icol) RETURN }
	if mapid'=""		// JLF074
	{	// d:(qno&&str) markAnyofSubs(qno,str,mapid,1)	; Disable BuildValueArray loop generation
		s smdmapid=$s($d(mt("smdimp",+mapid)):mt("smdimp",+mapid),1:mapid)
	}
	#; JLF015-
	#; AK732
	i mapid n idifn,idval s idifn=$p(mts(qno,str),"^",5),idval=$$$instream(idifn)
	#; AK608
	n negch s negch=$$$aslIdBslNegChunk(stuff)  ;  corresponding chunk from bitslice "-" bitmap of negative values
	#; AK513
	#; AK505
	n ktyp s ktyp=$$$aslIdPkAccessType(stuff)  ;  map/temp/set/single/ntimes/or/and/convert/not
	#; AK620
	i ktyp="set" {
		i $d($$$aslKParQueriesInfo(mod,2,1),stuff) { GOTO parq }  ;  queue queries
		n next,nstf
		set next=0
		set nstf=$$$aslPkNext(mod,funk,ndata,1)
		d setkey($$$aslNextLoopingLowLimOrSetVar(nstf),$p(nstf,$c(1)),$$$aslNextLoopingType(nstf)["-") QUIT
	}
	#; AK620-
	#; AK505-
	#; AK506
	#;  loop N times
	if ktyp="ntimes" {
		new lup
		set lup=$$$getVarName("lupN"_mod)
		$$$liin("s "_lup_"=""""")
		set line1 = bottom,bottom = tagpre_"k1",tag = bottom
		$$$liin("g:$i("_lup_")>"_$s(($$$aslNextLoopingLowLimExcl($$$aslPkNext(mod,funk,ndata,1))=1):"(",1:"")_pti($$$aslNextLoopingLowLimOrSetVar($$$aslPkNext(mod,funk,ndata,1)))_$s(($$$aslNextLoopingLowLimExcl($$$aslPkNext(mod,funk,ndata,1))=1):"+1)",1:"")_" "_line1)
		QUIT
	}
	#; AK506-
	#; AK513-
	//new tvforef	// new'd in %qaqqt...  table value function oref, used in next and fields
	s good="",rtype=1
	d build  ;  Build reference and Code.  If funk=3, then good=
	#;  LIST(,<good-cond>), but good=NULL if tempid or if no real "Sub"
	#; If we setup havar but should not use it because ref changed since we set it up remove it now
	if $get(havar)'="",$get(havar("ref"))'="",$get(havar("ref"))'=ref do removehavar^%qaqcasl(.havar)
	s:temptype="nomap" good=""  ;  no code if no master map!  ;  AK1080
	d fields^%qaqcdt  ;  get some data
	QUIT:'padnext
	if (funk=1)||(funk=3) {
		s tag=tagpre_"p"_ndata,line=""
		#; Remove this tag if not needed, it is only used to jump forward over some instructions from %qaqcdt line
		do addtagchk^%qaqcasl(.tag)
		QUIT
	}
	s $p(xtfun,",",6)=1,line="s "_$$$getVarName("oldpad_"_mod)_"=1" $$$liin(.line)  ;  flag in xtfun usage of p(mod)
	s tag=tagpre_"pdtg" $$$liin(.line)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
temp0(srce)  ;  [public: temptype,loval,icol,pti] $$: icol value -  ;  AK1081
	#;  from CON condition, or from vector/bitmap at position loval
	RETURN:temptype="convar" $s(loval:$$ptvalue^%qaqcpr(loval),1:$$colnul^%qaqcpr(icol,1))
	RETURN $s(temptype="vecvar":"$ve",1:"$bit")_"("_pti(srce)_","_pti(loval)_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
markAnyofSubs(qno,str,mapid,value)
	QUIT:($d(mt("collidx",mapid))&&('$d(mt("smdimp",mapid))||(mapid=mt("smdimp",mapid))))
	n baseFld,sub,v s sub=""
	f {	s sub=$o(mts(qno,str,"MAP",mapid,sub),1,v) q:sub=""
		i $p(v,"^",6)["%ANYOF" { s baseFld=$e(v,$find(v,$s(v["%ANYOFKEY":"%ANYOFKEY",1:"%ANYOF")),*) i value=1 { s mt("anyofInProgress",baseFld)=1 } else { k mt("anyofInProgress",baseFld) }}
	  }
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
build	;  Get the Global Reference for Next or Get
	#;  Set the variable 'ref', and for funk=2 create the nexting loops
	QUIT:tempid&&((funk=1)||(funk=3))
	n asc,atype,code,const,del,dod,exp,i5,ilev,ilevh,keycol,listval,log,loopinit,modn,modtemp,mstart,mstop,next,next2,numeric,padcode,padun,qistart,qistop,qstart,qstop,qpartition,ref1,slev,start,stopcond,subi,swline,swsw
	#; AK709
	n cval,cnum,swe,swl,swn  ;  %SW const information and runtime variables
	#; AK719
	n cat  ;  used not only in strtstop, but also in startln/startval
	#; AK503
	n vsb,vch,vhi,vlo  ;  4 variables needed for $ORDER/$BITFIND code
	n nosubnodes   ; used to optimize $d/$o extraction by determining if this could have subnodes in global structure or not
	s nosubnodes=1
	n useiterator,oldvar1,oldvar2 s useiterator=$$useIterator(mod,ndata,tempid,smdmapid,.havar)  ; None null if we are using iterator
	#; AK808
	s dod=1
	if funk=2,mapid {
		set next=""
		for {
			set next = $o($$$aslPk(mod,1,next))
			QUIT:next=""
			set stuff = $g($$$aslPkCopy(mod,1,next))
			for i5=1:1 {
				set keycol = $p($$$aslPkCopyTarget(stuff),",",i5)
				QUIT:keycol=""
				do:$p($$$mtV(keycol),"^",1,2)=("f^"_str) vset^%qaqcdt(keycol)
			}
		}
	}
	n useVectorMap
	set useVectorMap=""
	i funk=2,mapid,$$$IsVectorSearchIndex(smdmapid){
		n fakeField,vdfNext,partitionKey,bucketId,rowIdVal
		set fakeField=$$getFakeVDF(mod,ndata,.vdfNext,.partitionKey,.bucketId,.rowIdVal)
		set:vdfNext="" vdfNext=1
		#; 1. fake field (distance)  
		#; 2. idval
		#; 3. index name        
		#; 4. table name                                  
		#; 5. top N (pti)               
		#; 6. point                                                    
		#; 7. vector index obj
		#; 8. index class name
		#; 9. for partition table, the true nexting level for vdf
		#; 10. for partition table, $lb(all partition keys) (pti)
		#; 11. for partition table, bucket id (pti)
		set useVectorMap=$lb(fakeField,$s(rowIdVal'="":rowIdVal,1:idval),$$$smdMapIndexName(smdmapid),$$$smdGetIqnFromIrn($$$smdMapIrn(smdmapid)),$s($d($$$mtTopArg(m)):pti($$$mtTopArg(m)),1:""),$p($$$mtV($$$mtVecDistFunc(fakeField)),"^",5),$$$getVarName("vioref"_mod_$s(ndata=1:"",1:"x"_ndata)),$p($p($$$smdMapIndexType(smdmapid),"(",2),":",1),vdfNext,partitionKey,bucketId)
.
		// see if we need to do any length/type/embedding checks for the input vectors of the vector distiance; code adapted from ptvalue^%qaqcpr
		New arg1,arg2,dt,param
		Set arg1=$p($$$mtV($$$mtVecDistFunc(fakeField)),"^",4) // if reached here, arg1 will correspond to type "f"
		Set arg2=$p($$$mtV($$$mtVecDistFunc(fakeField)),"^",5)
		if ($e($$$mtV(arg2),1,11) = "v^EMBEDDING") { // if arg2 is an embedding vector
			do ddgetf^%qaqcpr(arg1, .dt, .param) // get the model from arg1
			set:(dt = "%Library.Embedding") mt("embeddingModelName", arg2) = param("MODEL")
		} 
		do:("fq"'[$$$mtVType($$$mtV(arg2))) checkVectorInOpen^%qaqcpr(arg1, arg2)
.
	}
	#; AK548
	n tonm,subnm s tonm="",subnm=""
	#;  subnm - last looping "next" subscript.
	#;  tonm - code to replace all NULL's with NULL-markers, to be used
	#;         after the looping tag for subnm.
	s next2="",keycol=0  ;  find subnm, the last looping "next" subscript
	for {
		set next2 = $o($$$aslKNext(mod,1,next2),1,stuff)
		QUIT:next2=""
		if "c,u,l,"'[($$$aslNextLoopingType(stuff)_",") {
			set subnm = next2,keycol = +stuff
			set:$$$aslNextLoopingType(stuff)["y" tonm(keycol)="",keycol=0  ;  DPV2055 (["y", not ="y")
		}
	}
	s keycol=0  ;  now generate the NULL-to-NULLmarker line
	#; AK548-
	s loopinit=""  ;  DPV966
	#;  Put in code if we're padding to setup the pad flag
	#; AK574
	i funk=2,padnext {
		$$$liin("s "_$$$getVarName("oldpad_"_mod)_"=0") d padcode  ;  get code for padding
	}
	#; AK574-
	s next=0  ; number of nexting level we're on
	#; AK688
	n filter i $d(mt("filterm",+mapid),filter) { } s filter=$p($g(filter),",",2)
	#;  if it's a filter "map" then compute the oref (once), and
	#;  skip right ahead to processing the bitmap layer
	i filter d davalue^%qaqcpr(filter) s ilev=1,slev=1,next2=1,atype="Sub",rtype=3,ref="junk" GOTO keyloop
	#; AK688-
	s next2=0 ; counter to spin thru asl(mod,2,1,"next",next2)
	#;          its needed cause Path Sel gives me constants.
	s ilev=0  ; needed to flip thru map/temp id levels
	set atype=""	// Initialize here because there may not be any map subscripts when we get to maplev via keyloop
	#; for maps, rtype is the ref type (1 for globals,
	#; 2 for piecing of globals, 3 for other expressions, and NULL),
	#; ref1=complete ref, ref is ready for the next sub, dod=<check $D!>
	#; JLF015
	if smdmapid {  ;  DPV2060;AK938
		s ref1=$$$smdMapGlobal(smdmapid),rtype="",dod=ref1'=""
		s nosubnodes=$$nosubnodes(smdmapid)
		d shref(.ref1)
		$$$SNRBDebugTrace("build^%qaqcky dod: "_dod_" shref called shref for:",ref1) // JMM1152+
		s:dod ref=ref1_$e("@",$e(ref1)="@")_"(",rtype=1   // JMM1152-
		if $e($$$smdMapIndexType(smdmapid))="C" { set dod=0 }	// DPV6330
		GOTO keyloop
	}
	#;  FOR temp Files, BUILD module must be processed, and References
	#;  already set-up in the subscript, o/w "bd", $p(6) not setup yet!
	s modtemp=+tempid,modn=$p(tempid,"^",2) ; mod where this is defined
	if 0 {
		if 'modn {
			set ref1 = pti(modtemp),ref = $$adsub^%qaqcmn(ref1),dod = 1,nosubnodes = 1,atype = "",rtype = 1,ilev = 1,constant = "",ifn = ""
			do arrtf
			set havar = $g(pti(+$g($$$aslKFlds(mod,1))),havar)
			GOTO next
		}  ;  AK1046
	}
	#;  loop over a $VOP("xxxg") local "output array" oar(gv)=val
	if temptype="oarvar" {
		set ref1 = pti(modtemp),ref = $$adsub^%qaqcmn(ref1),dod = 1,nosubnodes = 1,atype = "",rtype = 1,ilev = 1,constant = "",ifn = ""
		do arrtf
		set havar = $g(pti(+$g($$$aslKFlds(mod,1))),havar)
		GOTO next
	}  ;  AK1046
	#;  loop over a bitmap chunk in a local variable
	if temptype="bmvar" {
		set ref1 = pti(modtemp),ref = ref1,dod = 1,nosubnodes = 1,atype = "",rtype = 1,ilev = 1,constant = "",ifn = ""
		do setnext
		GOTO next
	}  ;  AK1046
	new modref
	set modref=$$$aslActTfToBuild($g($$$aslAct(modtemp,modn)))
	#; AK841
	if $e($g($$$mtTref(tempid)),*)="(" {
		set ref=$$$mtTref(tempid),ref1=$e($$$mtTref(tempid),1,*-1)
	} else {
		set ref=$g($$$mtTref(tempid))_",",ref1=$g($$$mtTref(tempid))_")"
	}
	i temptype="vectorjoin" GOTO vj
	#; AK394
	#;  if this is the first read for this temp file, maybe needs $sortend
	if modref,'$D(filenum(modref)),$$$aslActSort($$$aslAct(modtemp,modn)),$$glotf^%qaqcpre(modref),'$g($$$mtSharedGlobalTf(modref)) {
		set filenum(modref) = 1,line = "i $sortend("_$e(ref,1,*-1)_"))"
		$$$liin(.line)  ;  AK849
		if ($g($$$mtOptionsSQLRuntimeStatsFlag)=1),$d($$$mtSQLRuntimeStatsHasSortbegin(modref)) {
			// For SQL runtime stats, we need to mark this line as the location for merging the temp-file
			do markTfMerge^%qaqcasl(modref)
		}
	}
	#; AK394-
	#; AK506
	if $$$aslActIsBmTf($$$aslAct(modtemp,modn))="bit" {
		kill $$$aslBuildActNodeRoot(modtemp,modn)  ;  garbage
	}
	s atype="",rtype=1  ;  for temp files
	
	If tempid&&$$$readingSharedGlobalTfInParent(m,mod,tempid) {
		// We reach here if both conditions are checked:
		// 	1. The current module is where we should read the shared global that was populated by all workers in parallel aggregation
		// 	2. The current worker tf # (which is fetched from $g(mt("tref",tempid,"tf"))) is the correct tf # that was populated by all workers privately in parallel
		// 	   Important context: tempid is the mod_"^"_ntry composition of the module and postkey entry where the worker temp-file was built and mt("tref",tempid,"tf")) stores the tf # of the worker's temp-file
		//						  (e.g., for tempid="2^3" it means that the worker's temp-file was built in module 2 and with mt("tref",tempid,"tf"))=1 it means that the worker's temp-file has the number 1)
		//
		// If both conditions are checked, then we set `ref` to be the correct reference to the shared global temp-file instead
		Set ref=$$tfref^%qaqcpre($$$getParAggSharedTf(m),1)
	}
keyloop	;
	#; we loop down thru each key level.  It can be a constant,
	#;  a predefined col#, or a true NEXTING level.
	i tempid,'modn { RETURN }  ;  AK1046
	s:atype="Bit" ilev=9999  ;  there's nothing after the bitmap level  ;  AK1041
	d maplev:mapid,templev:tempid  ;  exactly one of the two is called!
	i ilev="",$d($$$aslKParQueriesInfo(mod,2,1),stuff) { GOTO parq }  ;  queue queries
	#; QUIT after the last level, but check $D if it was a constant
	i ilev="" s atype="done" d:smdmapid&&(ilevh="")&&'filter refx("%row",$$$smdMapRowReference(smdmapid),funk,.dod) QUIT  ;  DPV2060;AK688
	GOTO next:funk=2
	#; now the code to check for null/invalid subscripts
	if '$d(condcheck(var1)) s good=good_","_var1_"'="""""
	d invalid
	GOTO keyloop
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
vj	;  generate a call to vj.Join()  ;  AK1064
	#;  d vj2.Join(lvhi,lwf,lkeyvec[,lfldsvec...])  ;  asl("next",1)=c2 V "u" V c1
	#;  but don't include %ID/jto in the left table actual "extra fields"
	new bnode
	set bnode = $$$aslAct(modtemp,modn)
	$$$liin("d "_ref1_".Join("_$$genargs($$$aslActLeftTableFirstIdOfChunk(bnode)_"^"_$$$aslActLeftTableBmFilt(bnode)_"^"_$tr($$$aslActLeftTableKeysVec(bnode)_$$remove^%qaqpmod($$$aslActLeftTableFldsVecs(bnode),$$$aslActLeftTableKeysVec(bnode)_$$$aslActLeftIdReturnedVec(bnode)),",","^"))_")")
	s var1="novar",next2="",dod=1,nosubnodes=1,atype="",rtype=1,ilev=1,constant="",ifn=""
	d setnext
 	GOTO next
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK938
shref(ref)  ;  [public: str,mt] use ^|"ext^ref"| to other shard servers in .ref
	#; JMM1152+
	n tnn,alias,foundStorage
	if +$g(%SNDebug) {
		n tempMtShref m tempMtShref=mt("shref")
		$$$SNRBDebugTrace("shref^%qaqcky ref: "_ref_" str: "_str_" mt(shref):",.tempMtShref) // JMM1152=
		if $d(mt("shref",str),tnn) {
			$$$SNRBDebugTrace("shref^%qaqcky 2 tablevar: "_tnn_" storage:",$g(%ISCSNRemoteTables(tnn,"storage"))) // JMM1152=
			s alias=$g(%ISCSNRemoteTables(tnn,"alias"))
			if alias'="" {
				$$$SNRBDebugTrace("shref^%qaqcky 2 storage for alias "_alias_":",$g(%ISCSNRemoteTables(alias,"storage"))) // JMM1152=
			}
			else {
				$$$SNRBDebugTrace("shref^%qaqcky no alias for tnn "_tnn) // JMM1152=
			}
		}
	}
	if $d(mt("shref",str),tnn) {
		$$$SNRBDebugTrace("shtref 3a") // JMM1152=
		if $d(%ISCSNRemoteTables(tnn,"storage")) {
			$$$SNRBDebugTrace("shtref 3b") // JMM1152=
			#; We assume that the data, id, and index locations differ only in the last piece of the name
			#; (".1,".2",".3",etc.).  Get this piece from the original ref, and append it to the extentloc.
			s suffix=$$$LastPiece(ref,".") // JMM1222+
			s extentlocVar=$$$getVarName("extentloc"_tnn)_"("_suffix_")"
			s ref="@"_extentlocVar,foundStorage=1 // JMM1222-
			$$$SNRBDebugTrace("shref^%qaqcky 3: modified ref to:",ref) // JMM1152=
			// JMM1222 Store this extentloc variable in mt("extentloc",str,suffix), so it will be passed to parallel jobs
			s mt("extentloc",str,suffix)=extentlocVar // JMM1222-
		}
		elseif $d(%ISCSNRemoteTables(tnn,"alias"),alias) && $d(%ISCSNRemoteTables(alias,"storage")) {
			$$$SNRBDebugTrace("shtref 3v") // JMM1152=
			s suffix=$$$LastPiece(ref,".") // JMM1222+
			s extentlocVar=$$$getVarName("extentloc"_alias)_"("_suffix_")"
			s ref="@"_extentlocVar,foundStorage=1 // JMM1222-
			$$$SNRBDebugTrace("shref^%qaqcky 3: used alias, modified ref to:",ref) // JMM1152=
			// JMM1222 Store this extentloc variable in mt("extentloc",str,suffix), so it will be passed to parallel jobs
			s mt("extentloc",str,suffix)=extentlocVar // JMM1222=
		}
	}
	if '$g(foundStorage) {
		$$$SNRBDebugTrace("shref^%qaqcky 4: using pref-JMM1152 logic") // JMM1152=
		#; JMM11152-
		n tnn s:$d(mt("shref",str),tnn) $e(ref)="^|"_$$$getVarName("shref"_tnn)_"|"
	} // JMM1152=
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK938-
	#; AK907
/// Generate code to queue a parallel query based on values in the subscript level
/// right below 'ref1'
parq	// [PUBLIC: ref1,stuff]
	#;-----------------------------------------------------------------------------------
	#; VARIABLES:
	#;  stuff = "fval,qn,rspec"
	#;  rspec = A $c(1) delimited string of the following values:
	#;            1. [strt]
	#;            2. [inclstrt]
	#;            3. [stop]
	#;            4. [inclstop]
	#;  V     = A delimiter with the value $c(1)
	#;-----------------------------------------------------------------------------------
	new argstoset,bit,exrefStr,groupId,groupIdStr,hasStartsWith,maptype,newtbl,prefix,prm,prmread,qn,qtn,qtwork,queryinfoStr,refInKind,refName,rspec,set,stop,stopv,strt,strtv,tagx,tbl,useAPE,prmvar
	
	set qn=$$$aslKParQueriesSubq(stuff)  // Query #
	set rspec=$$$aslKParQueriesRangeInfo(stuff)
	set qtn=$$$getVarName("quq"_qn)
	set qtwork=$$$getVarName("quqwork"_qn)
	set strt=+rspec
	set stop=$p(rspec,$c(1),3)  // SQL Query Start & Stop Flags!
	set useAPE=$$$useAPE(qn)  // 'useAPE' Flag!
	set maptype=""
	set mt("killonclose")=$g(mt("killonclose"))_$lb(qtn)	// The 'quq*' variables will be killed during SQL Cursor CLOSE!
	if useAPE { // --- Generate Information when using 'APE' ---
		do generateWorkerArgs(qn,.argstoset,.prm,.prmread,1)    // Generate code that defines variables in the Pass By Reference Parameters (if needed) before code-generating the following method invocation: $$%RunWork2^%SYS.WorkQueueMgr(...)
		set tagx="$${APEtag"_qn_"}",prm="{parameters"_m_"}"     // These '{...}' placeholders will be replaced with actual values when the 'buildAPEparagfunc' method is called from 'close^%qaqcasl'
	} else { // --- Generate Information when not using 'APE' ---
		set tagx=$$buildstatement(qn,.prm)
	}
	set hasStartsWith=($p(rspec,$c(1),2)=2)
	if strt { // --- SQL Query has a condition with a Start value ---
		set strtv=pti(strt)
		#; %STARTSWITH (r3456 "4" (pos 2) = 2) has an interesting semantics:
		#;  The empty string '$c(0)' means range over every value, not only non-numerics.
		set:hasStartsWith strtv="$s("_strtv_"=$c(0):"""","_strtv_"=$c(32,0):"" "",1:"_strtv_")"
	} else { // --- SQL Query doesn't have a condition with a Start value ---
		set strtv=""""""
	}
	set stopv=$s(stop:pti(stop),1:"""""")
	set set=$g(mt("sql",qn,"set")),bit=$g(mt("sql",qn,"bit"))
	if bit,strt { set strtv="("_strtv_"\64000)+1" }
	if bit,stop { set stopv="("_stopv_ "\64000)+1" }
	if $$$DebugParallelSQL $$$liin("set ^IRIS.Temp.SQLDebug($i(^IRIS.Temp.SQLDebug))=$lb($zn,$zh,$j,""pre"")")
	set prefix="",exrefStr=""
	if $d(mt("sql",qn,"exref")) { // --- The SQL Query has External References defined in the Parse Tree (SEE: setexref^%qaqpagg(m)) ---
		set prefix=". ",exrefStr=".exref"
		$$$liin("do")
		$$$liin(". n exref")
		set tbl=""
		for { // --- Process All 'tbl' Values ---
			set tbl=$o(mt("sql",qn,"exref",tbl),1,newtbl)
			QUIT:tbl=""  // No more 'tbl' values!
			
			if $d(%ISCSNRemoteTables(newtbl,"alias"),newtbl) {} // JMM1073
			$$$liin(". set exref("""_tbl_""")=$g(%ISCSNRemoteTables("""_newtbl_"""))")
		}
	}
	if $$$SQLPushAMSInfo { // --- If we are planning to push 'Application Metadata Stack' (AMS) Information, then retrieve/store the 'groupID' from the WQM ---
		set groupId=$$localvar("groupId"),groupIdStr="."_groupId
	} else { // --- Not pushing the AMS, so don't collect 'groupID' from the WQM ---
		set groupId="",groupIdStr=""
	}
	if set="" { // --- No data set in the following SQL Parse Tree node: mt("sql",qn,"set") ---
		if $g(ref1)["^["||($g(ref)["^|") { // --- Process Extended Global Referencing ---
			#; If 'ref1' is in an extended global reference form, then switch extended 
			#; reference mode to 0, get the $name result, and switch the extended global
			#; reference mode back                                                       //DAB020
			set refInKind=$$$getVarName("rik"_qn),refName=$$$getVarName("rn"_qn)
			set:$d($$$smd(12,smdmapid)) maptype=$$mapType^%qaqpagg(smdmapid)
			$$$liin(prefix_"set "_refInKind_"=$zu(68,7,0),"_refName_"=$name("_ref1_") do:"_refInKind_" $zu(68,7,1)")
		} else { // --- Process Normal Global Referencing, etc ---
			if $d($$$smd(12,smdmapid)) {
				set maptype=$$mapType^%qaqpagg(smdmapid)
				if maptype=$$$MASTERMAP,ref1="",$$$smdTableStorageType(ttype,$$$smdMapIrn(smdmapid))="C" { // --- Process Columnar Table with Empty Master Map ---
					#; Special case: Empty master map for purely columnar table
					#;               Need to read the global name from ^oddEXTR
					set refName="$name("_$$$SQLLocMapGlobal($$$EXTSQLMAPsqlinfo($$$rEXT,$$$smdClassname(ttype,$$$smdMapIrn(smdmapid)),$$$smdMapName(smdmapid)))_")"
				} else {
					set refName="$name("_$s($e(ref1,1,3)="$g(":$e(ref1,4,*-1),1:ref1)_")" 
				}
			} elseif $g(mt("APE",m,"BitmapExtentClassOref")) {
				#; Special case: we are paritioning on a bitmap filter provided by user
				set refName=pti(mt("APE",m,"BitmapExtentClassOref"))_"."_$$$BitmapExtentGlbNameMethod_"()"
			} else {
				set refName="$name("_$s($e(ref1,1,3)="$g(":$e(ref1,4,*-1),1:ref1)_")"
			}
		}
		set queryinfoStr=$s(maptype'="":"$lb("_maptype_","_$g(mt("numsplits",qn))_")",1:"") 
		if prefix="" { $$$liin("do  // --- Create a Parallel Worker Helper ---") } // Use dot-do syntax to new the Pass By Reference parameter 'count' and pop it when finished!
		$$$liin(". new count")
		// If prm is too long, then we need to have specific sqline handling for it
		if $l(prm)>$$$complength {
			set prmvar=$$prmLengthHandler(prm)
		} else {
			set prmvar=prm
		}
		// No need for an IPQ group when using a shared global in parallel aggregation, so set type=0 to indicate a regular work group. Otherwise, we use an IPQ (type=2)
		$$$liin(". set "_qtn_"=$$%RunWork2^%SYS.WorkQueueMgr("_$s($$$parAggUsesSharedGlobal(m):"0",1:"2")_","_refName_","_strtv_","_stopv_",##class(%SYSTEM.Rtn).GetCurrent(),"""_tagx_":""_$zname,"_prmvar_","_hasStartsWith_","_exrefStr_","_groupIdStr_","_queryinfoStr_",.count),"_qtwork_"=count")
	} else { // --- Data set in the following SQL Parse Tree node: mt("sql",qn,"set") ---
		if prefix="" { $$$liin("do") } // Use dot-do syntax to new the Pass By Reference parameters 'count' & 'svals' and pop them when finished!
		$$$liin(". new count,svals m svals="_pti(set))
		// If prm is too long, then we need to have specific sqline handling for it
		if $l(prm)>$$$complength {
			set prmvar=$$prmLengthHandler(prm)
		} else {
			set prmvar=prm
		}
		// No need for an IPQ group when using a shared global in parallel aggregation, so set type=0 to indicate a regular work group. Otherwise, we use an IPQ (type=2)
		$$$liin(". set "_qtn_"=##class(%SQL.Agent).%RunWorkVals2("_$s($$$parAggUsesSharedGlobal(m):"0",1:"2")_",.svals,##class(%SYSTEM.Rtn).GetCurrent(),"""_tagx_":""_$zname,"_prmvar_","_exrefStr_","_groupIdStr_",.count),"_qtwork_"=count")
	}
	set:useAPE mt("APE",qn,"ParCallLoc")=mod_"^"_lines // Record the location ('mod' & 'lines') of the line where we'll need to replace 'tagx' and 'prm' when we later invoke the 'buildAPEparagfunc' method from 'close^%qaqcasl'
	if groupId'="" { // --- Record Information About 'groupId' ---
		do $i(mt("groupId"))  // Count the number of 'groupId' values created and processed by the WQM via the following method invocation: %RunWork2^%SYS.WorkQueueMgr(...)
		do UpdateGroupId("",groupId,$s(('$g($$$mtStreamUsesCdmp(m,str)))&&('useAPE):mt("groupId"),1:0))  // Don't pass the 3rd parameter 'groupIdLevel' for 'Columnar Table Maps' OR for SQL Queries using 'Adaptive Parallel Execution' (APE)!  //MRP1407: See 'Special Note' in JIRA DP-435826
	}
.
	if 'useAPE { // --- Not using Parallel Processing ---
		do buildparagfunc(qn,$g(ref1),strt,stop,bit,hasStartsWith) 
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
localvar(n,open="",remove=0)  ;  use unsubscripted variable %sqldataNNv, to be used only locally
	s n="%sqldata"_n_"v" d vNEW^%qaqcasl(n,open,remove)
	QUIT n
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK907-
	#; AK505
setsub	;  for subscript type "y", generate a loop over the set
	#; DPV2055
	d setkey($p(stuff,$c(1),3),$s($p(stuff,$c(1),9):$p(stuff,$c(1),9),1:keycol),asc["-")
	#; See if we gotta break down a Name/Parent ID - flag set in ^hi
	d:$p(stuff,$c(1),8) copy^%qaqcpre($p(stuff,$c(1),8))
	#; [DPV5329] if $d($$$mtNullMarkerSub(mod,keycol)),0 { $$$liin("s "_var1_"=$s("_pti(keycol)_"="""":"_$$$mtNullMarkerSub(mod,keycol)_",1:"_pti(keycol)_")") }
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; DPV2055
setkey(sset,sval,reverseorder=0)  ;  for KEY type "s" or subscript "y", generate a loop
	#;  over sset, copy value to sval, increment next
	;  *** do we need to allow for outer-join padding here?
	new lup
	set lup=$$$getVarName("sub"_sval)
	$$$liin("s "_lup_"=""""")
	s line1=bottom,bottom=tagpre_"k"_$i(next),tag=bottom
	#;  opg - when done with all agg rows, do the group row ACTION  ;  AK1044
	i ktyp'="set",$p($g($$$asl0OnePassGroupBy(mod)),"^",2)=next2 { s line1=$$modpre^%qaqcasl($p($$$asl0OnePassGroupBy(mod),"^",3))_"act" }
	#; AK548
	#;  this is the inner-most loop, set in the NULL-markers
	i ktyp'="set",subnm=next2,tonm'="" $$$liin($e(tonm,2,*))
	#; AK548-
	#; AK600
	#;  for loop suppression, get next group if this is the inner-most loop
	;  i ktyp'="set",$d(grup(next2)) $$$liin(grup(next2))  ;  AK991
	#; AK600-
	#; DPV2055 - added reverseorder
	#; IBA124 - Apply nullmarker conversions between set of values and map subscripts
	if $g($$$mtNullMarker(sset))'=$g($$$mtNullMarkerSub(mod,sval)),$g($$$mtNullMarkerSub(mod,sval))'="",$g($$$mtNullMarker(sset))'="" {
		$$$liin("s:"_lup_"="_$$$mtNullMarkerSub(mod,sval)_" "_lup_"="_$$$mtNullMarker(sset)_" s "_lup_"=$o("_$$adsub^%qaqcpr(pti(sset),lup)_$s(reverseorder:",-1",1:"")_")")
		$$$liin("g:"_lup_"="""" "_line1)
		$$$liin("s:"_lup_"="_$$$mtNullMarker(sset)_" "_lup_"="_$$$mtNullMarkerSub(mod,sval))
	} else {
		$$$liin("s "_lup_"=$o("_$$adsub^%qaqcpr(pti(sset),lup)_$s(reverseorder:",-1",1:"")_")")
		$$$liin("g:"_lup_"="""" "_line1)
	}
	#; AK732
	#; Look up the null value replacement to use, if this is "" the $$tonull just copies the variable over see SQL/FreeTextSearch/Prodlog55809/
	do vset^%qaqcdt(sval,$$tonull^%qaqcpr(lup,$g($$$mtNullMarkerSub(mod,sval))))  ;  conversions/collations
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK505-
maplev	; Get the Next Subscript Level from a MAP
	#;  DPV2060+
	#; AK699
	d:$d($$$smd(12,smdmapid,6,+ilev,"expr")) refdvar(ilev_"D",ilev)  ;  Reference vars {iDj}
	s ilev=$o($$$smd(12,smdmapid,6,ilev))
	s ilevh=ilev  ;  save to know whether we ended early
	set:useiterator'="" $list(useiterator,7) = ref1
	#; AK699-
	#; AK657
	#;  see if asl(KEY,"next") does not loop over all subscripts
	i funk=2 {
		s exp=$o($$$aslKNext(mod,1,next2),1,asc) 
		i exp="" { 
			s ilev="" 
			if useiterator'="" {
				do appendtoline^%qaqcasl(mod,$lg(useiterator,6),") ")
				if $lg(useiterator,10)'="" {
					do appendtoline^%qaqcasl(mod,$lg(useiterator,6),"if '"_$li(useiterator,10)_" ")
				}
				do appendtoline^%qaqcasl(mod,$lg(useiterator,6),$lg(useiterator,5))
			}
			QUIT 
		} 
		s:$p(asc,$c(1),2)="c" next2=exp s:($p(asc,$c(1),2)="h")||$p(asc,$c(1),10) ilev="" 
	}
	#; AK657-
	#;  for bitmaps, simulate last subscript on rowid *** maybe set rtype,refx(slev_D),mts(ATT,S_slev)
	#; AK506
	#; AK608
	i 'ilev,atype'="Bit","BSC"[$e($p(mts(qno,str,"MAP",mapid),"^",6)_" ") s ilev=$i(slev),ifn=$p(mts(qno,str),"^",5),exp="{"_ifn_"}",dod=0 d setnext QUIT
	i 'ilev s ilev="" do:useiterator'="" appendtoline^%qaqcasl(mod,$lg(useiterator,6),") "_$lg(useiterator,5)) QUIT
	#; JLF015
	s ifn=$$$smdMSFieldIfn(smdmapid,ilev),constant=$$$smdMSConstant(smdmapid,ilev),exp=$$$smdMSExpression(smdmapid,ilev)
	s slev=+ilev,atype=$$$smdMSAccessType(smdmapid,ilev),del=$$$smdMSPieceDelimiter(smdmapid,ilev)
	s mstart=$$$smdMSStartValue(smdmapid,ilev),mstop=$$$smdMSStopValue(smdmapid,ilev)	// DPV2194= (Stop, not Start)
	d refx(slev_"D",$$$smdMSOverrideDataExpression(smdmapid,ilev),funk,.dod)  ;  reference expression {iD}
	#; JLF015-
	#;  DPV2060-
	i constant'="" d adref(constant) d  GOTO maplev
	. n icol s icol=$$$newval("i^"_str_"^S"_slev)
	. s $p(mts(qno,str,"ATT","S"_slev),"^",5)=icol,pti(icol)=constant
	d setnext:funk=2,addcol:funk=1,addcol:funk=3
	set var1=$select(useVectorMap'="":pti(keycol),$data($$$mtNullMarkerSub(mod,keycol)):$$$getVarName("sub"_keycol),1:pti(keycol))
	#; AK608
	#;  save reference for negch later use
	i $p(stuff,$c(1),11)="power",negch s negch="s "_pti(negch)_"=$g("_$tr(ref,$c(2))_"""-"","
	#; AK608-
	#; DPV1277
	d adref($c(2)_var1_$c(2))
	#;  cross ref for get RID stuff and subscript-code
	#;  NOTE:  funk=3 on map0 may overwrite index-map's mts("ATT",{Si})
	#; For asc="u" no need to copy anything as we have the original subscript variable in keycol (validate this with Aviel!!) shown in SQL/ODBCviaSQLGateway/queryoptimization/AK600
	set $p(mts(qno,str,"ATT","S"_slev),"^",5)=$s(var1'=pti(keycol):$$$VarNum("sub"_keycol),1:keycol)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
refx(name,over,funk,dod) [ref,ref1,rtype,atype,havar,good,pti,line,keycol,var1,mod,ndata,nosubnodes] { ;  reference expr {name}, with override 'over'
	if over'="" { ; Set-Up Variable Stuff
		if dod {
			if funk=2 { d dod } else { s good=good_",$d("_ref1_")" }
		}
		set ref1=$$repl(over)
		if $e(ref1)="^"||($e(ref1,1,5)="@(""^""") {
			set rtype=1,dod=1
			set ref=$S($f(")",$e(ref1,*)):$E(ref1,1,*-1)_",",1:ref1_"(")
		} else {
			set rtype=3,dod=0
		}
	}
	QUIT:'rtype  ;  no reference at this level
	if funk=2,dod,"GlobalSubPieceList"'[atype d dod
	#; a global reference that's not SET into a run-time variable
	set oref1=ref1,exit=0
	if rtype=1 {
		set ref1="$g("_ref1_")"
		if atype'="Piece",atype'="Other",atype'="List" {
			set pti($$scrcol(name,,0))=ref1 
			set exit=1
		}
	}
	if 'exit {
		set keycol=$$scrcol(name)  ;  assign a val#
		set var1=pti(keycol),ref=var1
	}
	if dod,"GlobalSubPieceList"'[atype,(funk=1)||(funk=3) {
		#; Determine if it is useful to use two piece $data to get the value of this node
		#; This is true if either we are doing a $data on a node we will later get i.e. $$needhavar() is true
		#; or if we already determined we will copy this value into a local here i.e. 'exit
		if 'exit set getvar=var1
		if name="%row",$$needhavar(.havar,.getvar,"node"_mod_"val"_funk_ndata) {}
		if $get(getvar)'="" {
			if name="%row",nosubnodes {
				set good=$select(good="":",1",1:good)_" i $d("_oref1_","_getvar_")#2"
			} else {
				set datavar=$$$getVarName("tmpdata")
				set good=$select(good="":",1",1:good)_" s "_datavar_"=$d("_oref1_","_getvar_") s:"_datavar_"=10 "_getvar_"="""" i "_datavar
			}
		} else {
			set good=good_",$d("_oref1_")"
		}
	}
	set dod=0
	if exit QUIT
			
	#; otherwise (including $p(^g)) SET {name} into a variable
	if $get(getvar)="" set line="s "_var1_"="_ref1
	i funk=2||(good="") { $$$liin(.line) QUIT }  ;  otherwise conditions pending in good
	i good=",$t"  { $$$liin("i  "_line) QUIT }  ;  IF "good"
	i good=",'$t" { $$$liin("e  "_line) QUIT }  ;  IF "bad"
	$$$liin($select($extract(good,1,3)=",1 ":$extract(good,4,*),1:"i "_$extract(good,2,*))_" "_line) s good=",$t"  ;  good conditions
}
	;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dod	QUIT:'dod ;  maybe time to test $D on a global reference (funk=2)
	if tempid,$g($$$aslKFlds(mod,1)) {
		d removehavar^%qaqcasl(.havar) s havar=$$$getVarName("node"_mod_"val"_funk_ndata)  ;  no need to get the node again
	}
	s line="i '"_$$hybridsel("$d("_ref1_$s(havar'="":","_havar,1:"")_")",$g(tempid))_" g "_bottom
	i padnext,next=0 { s line=line_padcode }
	$$$liin(.line)
	QUIT
	;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adref(x)  ;  build rtype,ref1,ref with a new MapSubs access entry x
	if atype="Other" { set rtype="" RETURN }
	if atype="Piece" { set ref="$p("_ref_","_del_","_x,ref1=$tr(ref,$c(2))_")",rtype=$e(223,rtype) RETURN }
	if atype="List" { set listval=ref,ref="$lg("_ref_","_x,ref1=$tr(ref,$c(2))_")",rtype=$e(223,rtype) RETURN }
	set ref1=$tr(ref,$c(2))_$tr(x,$c(2))_")",ref=ref_x_",",dod=1  ;  regular subscript
	RETURN
	;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
templev	; Get the Next Subscript from a Temp (funk=2 only!)
	s ilev=$o($$$aslActNode(modtemp,modn,ilev),1,stuff)
	if ilev="" {
		if useiterator'="" {
			do appendtoline^%qaqcasl(mod,$lg(useiterator,6),") ")
			if $lg(useiterator,10)'="" {
				do appendtoline^%qaqcasl(mod,$lg(useiterator,6),"if '"_$li(useiterator,10)_" ")
			}
			do appendtoline^%qaqcasl(mod,$lg(useiterator,6),$lg(useiterator,5))	
		} else {
			do dod
		}
		QUIT
	}
	GOTO:$$$aslActNodeSubscriptTraversalMode(stuff)'="s" templev  ;  its a data storage node
	s constant=$$$aslActNodeConstSubscriptVar(stuff),ifn=""
	#; stick in constant
	i constant'="" d adref(constant) GOTO templev
arrtf	;  entry for OutArray temp-file, modn=0  ;  AK1046
	d setnext
	#; AK506
	QUIT:atype="Bit"  ;  a bitmap subscript
	#; Now find out what the subscript is, set ss(i)=da(i)
	#; AK849
	if $$nullreplace^%qaqcct(keycol) {
		set var1=$$$getVarName("sub"_keycol)
	} else {
		set var1=pti(keycol)
	}
	#; AK849-
	#; DPV1277
	d adref($c(2)_var1_$c(2))  ;  s ref1=ref_var1_")",ref=ref_var1_","
	#; AK849
	if (asc="u")&&(var1'=pti(keycol)) $$$liin("s "_var1_"="_pti(keycol))
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setnext	; OK, Now we gotta set up the NEXTING Loops
	s next2=$o($$$aslKNext(mod,1,next2),1,stuff),keycol=+stuff,asc=$p(stuff,$c(1),2)
	#; AK849
	i useiterator="",tempid,$o($$$aslKNext(mod,1,next2))="",$g($$$aslKFlds(mod,1)) d removehavar^%qaqcasl(.havar) s havar=$$$getVarName("node"_mod_"val"_funk_ndata)  ;  no need to get the node again
	#;  for DISTINCT, suppress looping from this level down
	#;  use current "bottom" tag to get the next group, don't loop further
	d:$p(grup,",",4)=next2 nolupstart^%qaqcasl  ;  AK600;AK991;AK988
	#;  opg - initialize aggregates and start looping on aggregate rows
	d:$p($g($$$asl0OnePassGroupBy(mod)),"^",2)=next2 opginit^%qaqcasl(bottom)  ;AK988
	GOTO setnext:asc="c"  ; its just a const, which i'm getting from MAP DFN.
	s:asc="" asc="a"  ;  *** possible?
	#; AK506
	#; check if this subscript is a bitmap
	i $p(stuff,$c(1),11)="bit" s atype="Bit",var1=pti(keycol),dod=0 s:"adl"[asc vsb=$$$getVarName("sb"_mod),vch=$$$getVarName("ch"_mod),vhi=$$$getVarName("hi"_mod),vlo=$$$getVarName("lo"_mod)
	#; AK506-
	i temptype="bmvar" s var1=pti(keycol),vlo=var1,vch=ref1 s:hival vhi=pti(hival)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
addcol	;  Data Get (POSTKEY) - add this column to the growing Reference.
	#; check if subscript is a simple field
	i $E(exp)="{" s keycol=+$E(exp,2,*) i "{"_keycol_"}"=exp s keycol=$$$instream(keycol) QUIT
	#; complex expression - set scratch val#
	s:$e(exp,1,2)'="$$" exp="("_exp_")"
	s keycol=$$$maxv+1,$$$mtV(keycol)="i",pti(keycol)=$$swap(exp)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
swap(swap) ; $$ Func. 'swap' is the expression to be changed.  only from addcol^key
	#;  This changes it from {ifn} to da(icol)  *** handle "{"!
	n b
	f  {	s b=$p(swap,"{",2,$$$MaxRtnLineLength) q:b=""  
		s swap=$p(swap,"{")_pti($$$instream(+b))_$p(b,"}",2,$$$MaxRtnLineLength)
	}
	QUIT swap
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	;  Called from keyloop when funk=2
next	;  generate code for a single asl("next") subscript
	i atype="Bit",asc="u",$p(stuff,$c(1),10)'="" { 
		n pfx s pfx=""
		if ptnvars'="" {
			for i=1:1:$l(ptnvars,",")-1 {
				s pfx=pfx_pti($p(ptnvars,",",i))_","
			}
		}
		if smdmapid,$$$smdMapIndexType(smdmapid)["C",$$$smdMapVectorType(smdmapid)="string",$$$smdMapSmallChunkSize(smdmapid){
			$$$liin("s "_$$localvar(1)_"=1,"_pti($p(stuff,$c(1),10))_"=$g("_$tr(ref,$c(2))_pfx_var1_",1))") 
			$$$liin("d "_"$zu(224,"_pti($p(stuff,$c(1),10))_",1,""string"")") 
			$$$liin("f {")
			$$$liin($c(9)_"s "_$$localvar(1)_"=$o("_$tr(ref,$c(2))_pfx_var1_","_$$localvar(1)_"),1,"_$$localvar(2)_") q:"_$$localvar(1)_"="""" ")
			$$$liin($c(9)_"s "_pti($p(stuff,$c(1),10))_"=$vop(""append"","_pti($p(stuff,$c(1),10))_","_$$localvar(2)_","_$$$smdMapSmallChunkSize(smdmapid)_"*("_$$localvar(1)_"-1)+1)") 
			$$$liin("}")
			RETURN 	
		}
		$$$liin("s "_pti($p(stuff,$c(1),10))_"=$g("_$tr(ref,$c(2))_pfx_var1_"))") RETURN 
	}  ;  AK1045
	i asc="u" { d unique,nextcond(stuff) GOTO keyloop } ;  process "unique" on a subscript
	i asc["y" { d setsub,unique,nextcond(stuff) GOTO keyloop }  ;  AK505;DPV2055
	s dod=0 ; $D will be checked thru $ORDER
	#; From old %aaakey1
	#; asl code generation of the nexting mechanism
	if useVectorMap'="" && (+next=0) {
		set $$$mtACORN1DunTag(m)=bottom
	}
	s line1=" g "_bottom  ;  where to go if failed
	#;  opg - when done with all agg rows, do the group row ACTION  ;AK988
	i $p($g($$$asl0OnePassGroupBy(mod)),"^",2)=next2 { s line1=" g "_$$modpre^%qaqcasl($p($$$asl0OnePassGroupBy(mod),"^",3))_"act" }
	s next=next+1 ; the TRUE nexting level
	if asc'="l",useiterator=""||(next=1),useVectorMap=""||(next<=$lg(useVectorMap,9)) { s bottom=tagpre_"k"_next } ; tag for NEXTING, if just looking up a value do not change this as we never jump to this location as no need to loop on this
	if padnext,next=1 { s padun="i "_$$$getVarName("oldpad_"_mod)_"=2"_line1 }
	#;  calculate (at compile-time or run-time) the range values:
	#;  start, qistart, const, stopcond, and swline.
	d strtstop
	d startln:temptype'="vectorjoin"  ; Create the appropriate Start Line(s)
	#; *** if atype="Piece", set start properly, and if non-
	#;     numeric then dun here.  place correctly for padding!
	#; We gotta allow for padding, which means checking the pad flag,
	#; padding if =0, then going to action part of our mission.
	#; insert code only for top level.
	i padnext,next=1 { s line1=line1_padcode }  ;  *** maybe @ afternxt?
	if smdmapid {
		if $d($$$smd(12,smdmapid)),$$$smdIsATVF(1,$$$smdMapIrn(smdmapid)) { do rtvf GOTO suback }	// "next" subroutine for a table valued function  ;  DPV4186
		elseif $$$smdMSOverrideNextCode(smdmapid,ilev)'="" { ;  "next" subroutine override, FTs have this but have their own generation
			if $$$IsFTStream(str) { do generateFTNextCode(str, var1) GOTO suback }
			else { do nextcode GOTO suback }
		} 
	}
	#; AK849
	i tempid["-" { d rqut GOTO suback } ;  read queued queries temp-files
	#;  otherwise, simulate in-line the default NEXT subroutine
	#;  if initial value is inclusive (f>=const), skip nextcode/$O,
	#;     just check invalid
	if qistart&&(useiterator="") {  ;  Set-Up some info
		if $case(atype,"Piece":1,"List":1,:0) {
			set line="i "_var1_">0"
		} else {
			#; Look to see if we will be getting a value from this node later, if so use two piece $data to get it now
			#; need to set havar to "" before the $data in case the node did not have any data
			if smdmapid'="",($o($$$smd(12,smdmapid,6,""),-1)=ilev),$e($$$smdMapIndexType(smdmapid))'="B",$$needhavar(.havar,,"node"_mod_"val"_funk_ndata)
			set line="" 
			if 'const {
				if 'qpartition { set line="i "_var1_"'="""""_$s($g($$$mtUserDefNullMarkerFlag(mod,+stuff)):"",$g($$$mtNullMarkerSub(mod,+stuff))="":"",1:"&&("_var1_"]]"_$$$mtNullMarkerSub(mod,+stuff)_")")_" " }
				else           { set line="i "_var1_"'="""" " }  // For the qpartition case, no need to worry about the ""<->nullmarker range of values
			}
			if havar'="" {
				if nosubnodes {
					set line=line_"i $d("_ref1_","_havar_")#2"
				} else {
					new datavar set datavar=$$$getVarName("tmpdata")
					set line=line_"s "_datavar_"=$d("_ref1_","_havar_") s:"_datavar_"=10 "_havar_"="""" i "_datavar
				}
			} else {
				set line=line_"i $d("_ref1_")"
			}
		}
		set line=line_" g "_tagpre_"g"_next
		$$$liin(.line)
	}
	#; For iterator need tags for main iteration loop only
	if asc'="l",useiterator=""||(next=1),useVectorMap=""||(next<=$lg(useVectorMap,9)) { s tag=bottom } else { s tag="" }
	; Now set up the REAL LOOP, Right HERE!!!
.
	#; AK600
	#;  for loop suppression, get next group if this is the inner-most loop
	;  d:$d(grup(next2)) liin^%qaqcasl(grup(next2))  ;  AK991
	#; AK600-
	if padnext $$$liin(padun)  ;  if Padding gotta see if we've already done it
	#;----- "NEXT" looping line for various cases
	#;  vectorjoin:  Mk1 i 'vj2.ProbeNext(.j2c1vec,.j2id2vec,.j2id1vec,.j2b2vec,.j2b1vec) g Mdun
	GOTO:temptype="vectorjoin" vjoin  ;  AK1064
	i temptype="bmvar" { d bmvar GOTO suback }  ;  bitmap for funk=2  ;  AK503
	i atype="Bit" { d bit2 GOTO suback }  ;  bitmap for funk=2  ;  AK503
	#;  BY JOVE - its a piecing situation
	#;  bump the piece counter, and see if its blank
	#; DPV2131
	if useiterator'="" {
		#; If array reference copy it as we can not pass array by reference
		if var1["(" set oldvar1=var1,var1=$$localvar(next)
		#; Start main iterator next line
		if next=1 {
			if '($li(useiterator,2)#2),havar["(" set oldvar2=havar,havar=$$localvar("havar"_next)
			if $lg(useiterator,10)'="" {
				$$$liin("s "_$lg(useiterator,10)_"=$zu(113,"_$lg(useiterator,4)_","_$s('($li(useiterator,2)#2):"."_havar_",",1:"")_"."_var1)
			}else {
				$$$liin("i '$zu(113,"_$lg(useiterator,4)_","_$s('($li(useiterator,2)#2):"."_havar_",",1:"")_"."_var1)
			}
			set $list(useiterator,5)=line1,$list(useiterator,6)=lines
			if $data(oldvar2) {
				$$$liin("s "_oldvar2_"="_havar)
				set havar=oldvar2 kill oldvar2
			}
		} else {
			#; Append new value to existing line
			do appendtoline^%qaqcasl(mod,$lg(useiterator,6),",."_var1)
		}
		if $data(oldvar1) {
			$$$liin("s "_oldvar1_"="_var1)
			set var1=oldvar1 kill oldvar1
		}
	} elseif $case(atype,"Piece":1,"List":1,:0) {
		$$$liin("s "_var1_"="_var1_$s(asc'="d":"+1",1:"-1"))
	} elseif (useVectorMap'="")&&(next>=$lg(useVectorMap,9)) {
		if next=$lg(useVectorMap,9) {
			#; If array reference copy it as we can not pass array by reference
			$$$liin("if '"_$lg(useVectorMap,7)_".getNext(."_$s(pti($lg(useVectorMap,1))["(":$$localvar(1),1:pti($lg(useVectorMap,1)))_",."_$s(pti($lg(useVectorMap,2))["(":$$localvar(2),1:pti($lg(useVectorMap,2)))_")"_line1)
			if pti($lg(useVectorMap,1))["(" {
				$$$liin("s "_pti($lg(useVectorMap,1))_"="_$$localvar(1))
			}
			if pti($lg(useVectorMap,2))["(" {
				$$$liin("s "_pti($lg(useVectorMap,2))_"="_$$localvar(2))
			}
			if $$isACORNon^%qaqpag(m) {
				$$$liin("i '.."_$$$mtACORN1FilterMethodName(m)_"("_$s(pti($lg(useVectorMap,2))["(":$$localvar(2),1:pti($lg(useVectorMap,2)))_") g "_bottom)
				// Save current variable name for the ID (i%IDnn) from pti, then replace it with "%id" whenever generated so that the code starting from sqline(mod,$$$mtACORN1StartLine(m)) and 
				// ending at (the later updated) $$$mtACORN1EndLine(m) will be ready to be moved as is into the ACORN-1 filter method (the copy happens when calling generateACORN1FilterMethod^%qaqcky <- modloop^%qaqcky)
				// The pti variable name for the ID will later be reverted to what it was once we are done generating the code (after generateACORN1FilterMethod^%qaqcky <- modloop^%qaqcky)
				set $$$mtACORN1OldPTIForiID(m) = pti($lg(useVectorMap,2))
				set $$$mtACORN1NewPTIForiID(m) = "%idToBeFiltered"
				set pti($lg(useVectorMap,2)) = $g($$$mtACORN1NewPTIForiID(m))
				set $$$mtACORN1Mod(m)=mod
				set $$$mtACORN1ModTag(m)=bottom
				set $$$mtACORN1UseVectorMap(m)=useVectorMap
				set $$$mtACORN1StartLine(m)=lines+1
				set $$$mtACORN1EndLine(m)=lines+1
			}
		}
	} else { ;  Conditional Check
		#; Look to see if we will be getting a value from this node later, if so use three piece $order to get it now
		#; need to set havar to "" before the $order in case the node did not have any data
		if smdmapid'="",($o($$$smd(12,smdmapid,6,""),-1)=ilev),$e($$$smdMapIndexType(smdmapid))'="B",$$needhavar(.havar,,"node"_mod_"val"_funk_ndata)
		#;----- THIS IS THE ACTUAL "NEXT" LINE --------
		if havar="" {
			$$$liin("s "_var1_"="_$$hybridsel("$o("_ref1_$s(asc'="d":"",1:",-1")_")",$g(tempid)))
		} else {
			$$$liin($s(nosubnodes:"",1:"s "_havar_"="""" ")_"s "_var1_"="_$$hybridsel("$o("_ref1_","_$e("-",asc="d")_"1,"_havar_")",$g(tempid)))
		}
	}
	i qistart,mstop'="" { s tag=tagpre_"g"_next } ;  skip to here if start-value inclusive
	i mapid'="",ilev'="" { d stopexp(mapid,ilev,$g(slev),var1,atype,line1) } ; MRP713 STOP Expression
	k code s code=0
	d code(var1_"]]"_mstop):mstop'=""
	f code=1:1:code $$$liin("i "_code(code)_" s "_var1_"="_$s(atype="Piece"||(atype="List"):$$$MaxRtnLineLength,1:""""""))
	if $case(atype,"Piece":0,"List":0,:1) {
		if (useiterator="")&&((useVectorMap="")||(next<$lg(useVectorMap,9))) $$$liin("i "_var1_"="""""_line1)
		set condcheck(var1)=""  ; Keep track of variables we have checked for null so we do not need to add this to 'good' in keyloop
	}
	if qistart,mstop="" { s tag=tagpre_"g"_next } ;  skip to here if start-value inclusive
	If atype="Piece" {
		If asc'="d" { $$$liin("i "_$tr(ref,$c(2))_",*)="""""_line1) }
		Else { $$$liin("i "_var1_"<1"_line1) }
	} elseif atype="List" {
		if asc'="d" { $$$liin("if "_var1_">$ll("_listval_")"_line1) }	// went past the end of the $list, we are done
		else { $$$liin("if "_var1_"<1"_line1) }							// went past the first list element, we are done
	}
	d:mapid mstart  ;  check "invalid" override, or at least mstart
suback	;   come back from "next" override
	#;  Check out the ENDING conditions.
	i (stopcond'="")&&(useiterator="")&&((useVectorMap="")||(next<$lg(useVectorMap,9))){ $$$liin("i "_stopcond_line1) }  ; simple end condition
	#; we do use global iterator and use level= $ZU(113,token...), and this is not the last level 
	if (useiterator'="")&&($lg(useiterator,10)'="")&&(next<$lg(useiterator,1)) {
		#; if this is the 1st level we loop on, and we might need startVal inclusive in the range, check itfirstVal 
		$$$liin("i ("_$lg(useiterator,10)_">"_($lg(useiterator,1)-next)_")"_$s((next=1)&&($lg(useiterator,11)'=""):"||("_$lg(useiterator,11)_")",1:"")_" {"_$s((next=1)&&($lg(useiterator,11)'=""):" s:"_$lg(useiterator,11)_"=1 "_$lg(useiterator,11)_"=0",1:""))
		new itCheckLevelLines 
		set itCheckLevelLines=lines
	}
	#; AK608
	#;  for bitslice "power" subscript, end loop at "-"/"N"/"Z"
	if $p(stuff,$c(1),11)="power" {
		$$$liin("g:("_var1_"=""N"")||("_var1_"=""-"") "_bottom)
	}
	#; AK608-
	#;  insert any conditions tied to this key
	i swsw d  ; %STARTSWITH / LIKE
	. ; Handle possible NULL Subscript markers
	. n n,p s n="" f  s n=$o(%nsvalex(mod,n)) q:n'=+n  d
	.. s p=pti(n)
	.. i swline[p s swline=$replace(swline,p,"$s("_p_"'="_%nsvalex(mod,n)_":"_p_",1:"""")")
	. ; Code Generate the line(s)
	. s line=$g(swline) $$$liin(.line)
	#; IF theres a null here, swap it in
	if pti(keycol)'=var1 { $$$liin("s "_pti(keycol)_"=$s("_var1_"="_$select(tempid:$$$NULLSubscriptMarker19q,1:$$$mtNullMarkerSub(mod,keycol))_":"""",1:"_var1_")") }
	#; See if we gotta reconstruct a Name/Parent ID - flag set in 3X^hi
	d:$p(stuff,$c(1),8) copy^%qaqcpre($p(stuff,$c(1),8))
	if tag'="" $$$liin("")  ;  "g" tag for qistart
	#; AK614
	#;  if "nonul" flag, skip NULL value
	if $p(stuff,$c(1),12) $$$liin("g "_bottom_":"_pti(keycol)_"="_$$colnul^%qaqcpr(keycol,1,pti(keycol))_$s($d(%nsvalex(mod,keycol)):"||("_pti(keycol)_"="_%nsvalex(mod,keycol)_")",1:""))	// DPV3047
	#; AK614-
	d nextcond(stuff)  ;  Code-Generate the 'next' Conditions in $P(7)
	#; AK608
	#;  retrieve corresponding chunk for "-" bitslice
	i asc["h",negch'="" { $$$liin(negch_var1_"))") }
	#; AK608-
	#; we do use global iterator and use level= $ZU(113,token...), and this is not the last level 
	if (useiterator'="")&&($lg(useiterator,10)'="")&&(next<$lg(useiterator,1)) {
		if itCheckLevelLines=lines{
			kill $$$sqline(mod,lines)
		} else {
			$$$liin("}")
		}
	}
	GOTO keyloop
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
vjoin	;  generate call to vj.ProbeNext() in the loop:  ;  AK1064
	#;  Mk1 i 'vj2.ProbeNext(.jtovec,.ridvec,.lidvec[,.rfldsvec...][,.lfldsvec...]) g Mdun
	#;    [ s javvec=jtovec ]  ;  in some cases
	#;      s jvhi=jvhi+64000  ;  init in MAIN, have to start with chunk#=2!!!
	#;      s jwf="",jwf=$bitlogic(~jwf,$VOP("length",lidvec))  ;  generate a bitmap of n 1's
	#;  vector join "build" node information:
	#;  1. "b"  ;  "build" ACTION
	#;  13. "vj0"/"vj1"  ;  inner/outer join
	#;  14. vecvar(jto), = left table key vector (possibly %VHASH)
	#;  15. LIST(vecvar(val),) = left table field vectors needed after the
	#;      join, if any (may include %ID and jointo)
	#;  16. vecvar(jav), = right table key vector (possibly %VHASH)
	#;  17. LIST(vecvar(val),) = right table field vectors needed after the
	#;      join, if any (may include %ID and jalist)
	#;  18. rvhi = right table firstId, id of position 1 in the chunk
	#;  19. rwf = val of right table applicable bitmap filter (EBM or WHERE)
	#;  20. lvhi = left table firstId, id of position 1 in the chunk
	#;  21. lwf = val of left table applicable bitmap filter (EBM or WHERE)
	#;  22. jidvec = vector of returned result-set id value
	#;  23. lidvec = returned vector of left id values for joi join result
	#;  24. ridvec = returned vector of right id values for joi join result
	#;  25. jvhi = join result-set firstId, id of position 1 in the chunk
	#;  26. jwf = join result-set bitmap filter
	#;  For the .keys return parameter, use jtovec, except use javvec if
	#;      javvec needed, jtovec not needed, and it's an inner join
	#;  For the actual "extra fields" parameters, don't include 23/14 in
	#;      fldsleft, and don't include 24/16 in fldsright (except
	#;      include 16=jav if OUTER JOIN and it's a single field)
	s var1=pti(keycol)
	$$$liin("i '"_ref1_".ProbeNext("_$$genargs(+$p(bnode,$c(1),$s($$innerj(bnode)&&$$needRk(bnode)&&'$$needLk(bnode):16,1:14))_"^"_$p(bnode,$c(1),24)_"^"_$p(bnode,$c(1),23)_"^"_$tr($$remove^%qaqpmod($p(bnode,$c(1),17),$s($$innerj(bnode):$p(bnode,$c(1),16),1:"")_$p(bnode,$c(1),24))_$$remove^%qaqpmod($p(bnode,$c(1),15),$p(bnode,$c(1),14)_$p(bnode,$c(1),23)),",","^"),".")_")"_line1)  ; simple end condition
	d nullvar^%qaqcasl(pti($p(bnode,$c(1),25)))  ;  init jvhi=""
	#;  copy jto into jav if INNER JOIN, single-field key, and both needed
	i $$innerj(bnode),$$needRk(bnode),$$needLk(bnode) { $$$liin("s "_pti(+$p(bnode,$c(1),16))_"="_pti(+$p(bnode,$c(1),14))) }
	$$$liin("s "_pti($p(bnode,$c(1),25))_"="_pti($p(bnode,$c(1),25))_"+64000,"_pti($p(bnode,$c(1),26))_"="""","_pti($p(bnode,$c(1),26))_"=$bitlogic(~"_pti($p(bnode,$c(1),26))_",$VOP(""length"","_pti($p(bnode,$c(1),23))_"))")
	i ($$outerj(bnode))&&($p($g(mt("mtrxjoin")),"^",5)+1=mod) {
		n ojbm,val,ojbmc,lup,lupN,ojdef,ojnulls,ojwf
		s ojbm=$$scratch^%qaqcpr(.val,0,"ojbm"_mod)
		s ojbmc=pti($p($g(mt("mtrxjoin")),"^",8))
		s lup=$$$getVarName("lupN"_+$p($g(mt("mtrxjoin")),"^",3)),lupN=pti(+$p($g(mt("mtrxjoin")),"^",7))
		s ojdef=$$localvar("ojdef")
		s ojnulls=$$localvar("ojnulls")
		s ojwf=pti($p(bnode,$c(1),26))
		$$$liin("s:'$d("_ojbm_"($i("_ojbmc_"))) "_ojbm_"("_ojbmc_")="_ojwf)
		$$$liin("s:"_lup_"<="_lupN_" "_ojdef_"=$vop(""defined"","_$$ptvalue^%qaqcpr($p(bnode,$c(1),24))_"),"_ojnulls_"=$bitlogic("_ojwf_"&~"_ojdef_"),"_ojbm_"("_ojbmc_")=$bitlogic("_ojbm_"("_ojbmc_")&"_ojnulls_"),"_ojwf_"=$bitlogic("_ojwf_"&"_ojdef_")")
		$$$liin("s:"_lup_">"_lupN_" "_ojwf_"="_ojbm_"("_ojbmc_")")
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
innerj(vjb)  ;  $$: whether INNER join or not - $P(13)="vj0"
	RETURN $p(vjb,$c(1),13)="vj0"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
outerj(vjb)  ;  $$: whether OUTER join or not - $P(13)="vj1"
	RETURN $p(vjb,$c(1),13)="vj1"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
needLk(vjb)  ;  $$: whether left key jto $P(14) is needed in fldsleft $P(15) (and is single field)
	RETURN (","_$p(vjb,$c(1),15))[(","_$p(vjb,$c(1),14))
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
needRk(vjb)  ;  $$: whether right key jav $P(16) is needed in fldsright $P(17) (and is single field)
	RETURN (","_$p(vjb,$c(1),17))[(","_$p(vjb,$c(1),16))
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
genargs(vals,byref="") n args,i5,val  ;  generate actual argument list, vals=={val^}*
	s args=""
	f i5=1:1 s val=$p(vals,"^",i5) q:val=""  s args=args_","_byref_$$ptvalue^%qaqcpr(val)
	QUIT $e(args,2,*)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; MRP713 (SQLI Mapper - Stop Expression)
stopexp(mapid,ilev,slev,var1,atype,line1)  ;  Apply STOP Expression
	#; JLF015
	n line s line=$$$smdMSStopExpression($s($d(mt("smdimp",mapid)):mt("smdimp",mapid),1:mapid),ilev)
	QUIT:line=""
	$$$liin("i "_$$repl($replace(line,"{S"_slev_"}",var1))_line1)
	QUIT
	#; MRP713 (SQLI Mapper - Stop Expression)-
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
unique	n good  ;  tests for Unique in a key.  ep only from next+6
	//Next nodes (including unique) can have a "nonul" piece 12, indicating we should
	//skip looping over the collated value of null. This was previously
	//done when "padnext" was set via a "p" ASL flag, but with the new OJ logic
	//it's done on a per-subscript basis.
	n nonul s nonul = +$p(stuff,$c(1),12)=1
	n nevernull s nevernull = +$p(stuff,$c(1),12)=2
	#; AK808
	i mapid,$$$mtV(keycol)["_",$$$mtV(keycol)'["_%ANY",'$bit(vset,keycol) $$$liin("s "_$e($$csufn^%qaqcdt($$$instream(+$p($$$mtV(keycol),"^",3)),$p($$$mtV(keycol),"_",2),keycol),2,*))
	#;         see if we got a NULL. If so it will NEVER pass.
	#; AK649
	#;  if a collated subscript is compared to a field in an OUTER JOIN,
	#;  and $$colnul() is not NULL, then test both colnul and NULL,
	#;  otherwise simply test sub="" to prevent
	#;  <SUBSCRIPT>, but if NULL-marker used, no need to test at all
	#;  variable colnul is either "" (no test), $$quote("") (test
	#;  against ""), or else test against both colnul and ""
	#;  for split parent reference just generate sub=""
	new colnul
	set colnul=$s($d($$$mtNullMarkerSub(mod,keycol)):"",(padnext||nonul)&&($e($g($$$mtV(+$p(stuff,$c(1),3))))="f"):$$colnul^%qaqcpr(keycol,1),1:"""""")
	s good=$s(colnul="":"",1:","_var1_"'="_colnul_$s(colnul="""""":"",1:","_var1_"'="""""))
	#; AK649-
	#; AK614
	#;  restore NM->null for "u" subscripts at "dun"
	#; ATG001 added the $g around var1
	#; ATG001
	#; [DPV5329] s:$d(%nsvalex(mod,keycol)) asl(mod,"dun")=$g(asl(mod,"dun"))_" s:$g("_var1_")="_%nsvalex(mod,keycol)_" "_var1_"="""""
	#; AK614-
	d:mapid invalid
	#; AK503
	#; AK688
	i atype="Bit" {
		s dod=0
		#; Removed check for ID'=+ID as this was done after $bit check anyway and bit 1 in chunk 1 will be 0 so it is not needed
		$$$liin("i '$bit("_$$getch(var1_"\64000+1",filter,1)_","_var1_"#64000+1)"_$s($$ebmfilter():"||'$bit("_$$ebmsub(var1_"\64000+1")_","_var1_"#64000+1)",1:"")_" g "_bottom_$S(padnext:padcode,1:""))
		QUIT
	}
	#; AK532
	QUIT:good=""  ;  NULL-substitute - nothing to check
	QUIT:nevernull ; We've been assured there's a value available
	#;  good=",'$t" means that the tests were already generated into $TEST
	#; AK649
	$$$liin($S(good=",'$t":"i ",good=",$t":"e ",1:"i "_var1_"="_colnul_$s(colnul="""""":"",1:"||("_var1_"="""")"))_" g "_bottom_$S(padnext:padcode,1:""))
	#; AK532-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK849
rqut	; Simulate "NextCode" to read temp-file "pipes" written by multiple queued query writers
	new code,groupId,qtn,qn,qtnq,qtwork,tagx,quid
	
	set qn=$$$aslIdQueuedWriterQuery($$$aslPkId(mod,funk,ndata))
	set qtn=$$$getVarName("quq"_qn),qtwork=$$$getVarName("quqwork"_qn),quid=$$$getVarName("quid"_qn)
	set groupId=$$$getVarName("groupId"_qn)
	set tagx=$$untag^%qaqcpre()
	#; We don't need to remove the 'havar' because we will never have used it anyway and 
	#; removing it would result in a hole in the 'pti' variables, which is ultimately
	#; not a big deal, but it is nice to avoid this issue!
	set havar=$$$getVarName("node"_mod_"val"_funk_ndata)
	set tag=bottom
	;  d:$d(grup(next2)) liin^%qaqcasl(grup(next2))  ;  AK600;BJB366;AK991
	if padnext $$$liin(padun)  ;  if Padding gotta see if we've already done it
	if $g($$$mtShard(qno))="" { // --- Process Data from the WQM ---
		$$$liin(" // Process Data from WQM...")
		$$$liin("for { // --- Process All WQM Data ---")
		#; NOTE: We use try/catch to detect the case where 'qtn' is set to null, indicating 
		#;       that the global is not defined, as it's faster to catch this condition 
		#;       rather than test for this condition before calling the method:
		$$$liin("   try { set "_havar_"="_qtn_".NextValue } catch { if '$isobject($g("_qtn_")) { set "_var1_"="""" "_line1_" quit } throw }")  // Done with this level, go up
		if $g($$$mtParafile(qno)) { $$$liin("   if $a("_havar_",9)=2 { set "_havar_"=$e("_havar_",10,*),%ROWID=$li("_havar_",2),SQLCODE=0 do $i("_$$$VarName("rowcnt")_",$li("_havar_")) continue }") }  ;  AK1007
		else { $$$liin("   if $e("_havar_",1,8)'=$c(0,0,0,0,0,0,0,0),"_havar_"'="""" quit") }
		$$$liin("   if ($a("_havar_",9)=1&&($i("_qtwork_",-1)=0))||("_havar_"="""")||($a("_havar_",10)=1),"_qtn_".SQLDecode2('"_qtwork_") { set "_var1_"="""","_havar_"="""" kill "_qtn_" "_line1_" quit }")  // Done with this level, go up
		$$$liin("}")
		RETURN
	}
	#;  NextCode for sharding:
	#;  NEXT  ;  [public: qtn,tid,nd] set <qtn,tid,nd> to next row location, or tid=""
	#;	n nq i $d(qtn,nq)<9 { s tid="" RETURN }  ;  no query ever sent, but for OJ filter use next line:
	#;	n nq i $d(qtn,nq)<9 { s tid=$o(^tf(0,tid),1,nd) RETURN }  ;  next padded row  ;  AK939
	#;	f  {
	#;		s tid=$O(@("^IRIS.Temp.IRIS.Sql"_nq)@(0,qtn(nq),1,nd)  ;  Get the next row from the same channel we were reading last time
	#;		i tid="" { s nq=$o(qtn(nq)) s:nq="" nq=$o(qtn(nq)) h:qtn=nq .001 CONTINUE }  ;  If no more rows in this channel move to next channel, if wrapping hang briefly and start again
	#;		;  now we've got an actual shard server temp-file entry
	#;		s ^IRIS.TFR($j,$I(^IRIS.TFR($j)))=$LB($ZN,$ZH,nq,tid)_nd  ;  trace, if on  ;  AK995
	#;		;  $C(1) (undefined 1st element) indicates 100 or error
	#;		i $e(nd)'=$c(1) { i tid#checkInterval=0 { d incrQrySem^%SYS.SHARDSRV(nq,quid) } ; Manage semaphore so writer does not get too far ahead of reader (JMM992 added quid)
	#;		s qtn(nq)=tid,qtn=nq [ <OJlogic> ] RETURN }  ;  real data row from server
	#;		d:$li(nd,2)'=100 SQERror^%apiSQL(242,"Parallel query run-time error: -"_$LI(nd,2)_" "_$LG(nd,3))  ;  pipe reported error
	#;		kill @("^IRIS.Temp.IRIS.Sql"_nq),^IRIS.Temp.IRIS.Sql(nq),qtn(nq)  ; this pipe done
	#;		i $D(qtn)<9 { s tid="" RETURN }  ;  all done, but for OJ filter use next line:
	#;		i $D(qtn)<9 { s tid=$o(^tf(0,""""),1,nd) RETURN }  ;  get 1st padded row  ;  AK939
	#;		s nq=$o(qtn(nq)) s:nq="" nq=$o(qtn(nq)) s qtn=nq }  ;  round robin from the top
	#;	RETURN  ;  (never really gets here, RETURN used from within the loop)
	s qtnq=$$adsub^%qaqcpr(qtn,"nq")
	new ojtfForRead,ojtfForWrite
	set ojtfForRead = ""
	set ojtfForWrite = ""
	#; AK939
	n ojtf,rejtag s ojtf="" d:$d(ojfilter(qno)) ojf(qno)
	#; Implmented a greedy read which reads all of one shards data before moving onto the next one, this will reduce block
	#; contension as ECP sets will be somewhat bursty and it also removes some variable allocation/deallocation which shows up as memory allocation
	#; as well as removing the constant $order on the queue number local array we were doing before
	i ojtf'="" {
		n alrid,lid,rid,ojfn,jj,x s alrid="",lid="",x=""
		f ojfn=0:1 { s lid=$o(ojfilter(qno,lid),1,rid) q:lid=""  d adlist(.alrid,rid) s x=x_",lid"_(ojfn+1)_",rid"_(ojfn+1) }
	}
	// readWriteMode=3 for $$tfref^%qaqcpre to indicate a read, which would do special $select generation for a non-DISTINCT hybrid temp-file
	d code(" n nq"_$s(ojtf'="":",keep,allid"_x,1:"")_" i $d("_qtn_",nq)<9 { s "_var1_"="_$s(ojtf'="":$$tfref^%qaqcpre(ojfilter(qno),1,3,"0,"_var1,"$o(",",1,"_havar_")"),1:"""""")_" ret }")  ;  no data/query  ;  AK902
	d code(" f  {")
	d code(" s "_var1_"=$o(@(""^IRIS.Temp.IRIS.Sql""_nq)@(0,"_qtnq_"),1,"_havar_")")
	d code(" i "_var1_"="""" { s nq=$o("_qtnq_") s:nq="""" nq=$o("_qtnq_") h:"_qtn_"=nq .001 continue }")  ;  nothing here, pause if all were checked
	#;  row found - return it, but may need some OJ processing instead
	#;  compile-time check for temp-file contents recording  ;  AK995
	d:$g(^IRIS.SM("tfr")) code(" s ^IRIS.TFR($j,$i(^IRIS.TFR($j)))=$lb($zn,$zh,nq,"_var1_")_"_havar)  ;  AK995
	#; JMM837 n checkIntervalCode
	n checkIntervalCode s checkIntervalCode="i "_var1_"#"_$$$SSCheckInterval_"=0 { d incrQrySem^%SYS.SHARDSRV(nq,"_quid_") }" ; JMM992
	i ojtf="" { d code(" i $e("_havar_")'=$c(1) { "_checkIntervalCode_" s "_qtnq_"="_var1_","_qtn_"=nq ret }") }
	#; AK939
	else {
		// As mentioned above, readWriteMode=3 is used here in calls for $$tfref^%qaqcpre to indicate a read, which would generate special $select logic for non-DISTINCT hybrid temp-files
		d code(" i $e("_havar_")'=$c(1) { "_checkIntervalCode_" s "_qtnq_"="_var1_","_qtn_"=nq")
		#;  loop over all ojfilter(qno,lid)=rid entries
		n alrid,lid,rid,ojfn,jj,x s alrid="",lid="",x=""
		f ojfn=0:1 { s lid=$o(ojfilter(qno,lid),1,rid) q:lid=""  d adlist(.alrid,rid) s x=x_",lid"_(ojfn+1)_",rid"_(ojfn+1) }
		s x="" f jj=1:1:$ll(alrid) { s x=x_"||("_$$idvar(qno,$li(alrid,jj))_"="""")" }
		d code(" s keep="_$e(x,3,*))  ;  s keep=(var1="")||...||(var3="")
		d code(" i keep { s allid="_$$zlids(mt("alst",qno))_" continue:"_$$tfref^%qaqcpre(ojfilter(qno),1,3,"-1,allid","$d(",")")_"  s "_ojtfForWrite_"-1,allid)="""" }")  ;  step 3
		s x="",lid="" f jj=1:1:ojfn { s lid=$o(ojfilter(qno,lid)),x=x_",lid"_jj_"="_$$zlids(lid) }
		d code(" s "_$e(x,2,*))  ;  s lid1=$ZLIST(...),...,lid4=$ZLIST(...)
		#;  i 'keep { d reject(1,lid1),...,reject(4,lid4) ret }  ;  step 1
		s x="" f jj=1:1:ojfn { s x=x_","_rejtag_"("_jj_",lid"_jj_")" }
		d code(" i 'keep { d "_$e(x,2,*)_" ret }")  ;  step 1
		#;  i lid1'=$C(1,1) { s rid1=$ZLIST(...) d:rid1'=$C(1) reject(1,lid1) }  ;  step 4  ;  AK972
		s lid="" f jj=1:1:ojfn { s lid=$o(ojfilter(qno,lid),1,rid) d code(" i lid"_jj_"'="_$$alnul($ll(lid))_" { s rid"_jj_"="_$$zlids(rid)_" d:rid"_jj_"'="_$$alnul($ll(rid))_" "_rejtag_"("_jj_",lid"_jj_") }") }
		#;  i lid1'=$C(1,1),rid1=$C(1),$d(^ojf1(lid1,0)) { continue }  ;  step 5
		s lid="" f jj=1:1:ojfn { s lid=$o(ojfilter(qno,lid),1,rid) d code(" i lid"_jj_"'="_$$alnul($ll(lid))_",rid"_jj_"="_$$alnul($ll(rid))_",$d("_ojtf_jj_",lid"_jj_",0)) { continue }") }
		#; JMM1152: Get shard count from this query's temp file count, not from cluster's number of shards.  
		#; Temp file count may differ from cluster's number of shards, for example if master is being treated as a shard
		#; when querying a table that is being converted between sharded and nonsharded.
		d code(" s "_var1_"=$g("_$$$getVarName("shcount"_qno)_","_$$$mtShardCount_")*"_var1_"+nq-"_$$$getVarName("shtf"_qno)_","_$$tfref^%qaqcpre(ojfilter(qno),1,3,"0,"_var1)_"="_havar)  ;  s tid=7*tid+nq-tfn1,^main(tid)=row  ;  step 6
		#;  i lid1'=$C(1,1),rid1=$C(1) { s ^ojf1(lid1,tid)="" }  ;  step 7
		s lid="" f jj=1:1:ojfn { s lid=$o(ojfilter(qno,lid),1,rid) d code(" i lid"_jj_"'="_$$alnul($ll(lid))_",rid"_jj_"="_$$alnul($ll(rid))_" { s "_$$tfref^%qaqcpre(ojfilter(qno),1,3,jj_",lid"_jj_","_var1)_"="""" }") }
		d code(" continue }")
	}
	#; AK939-
	d code(" d:$li("_havar_",2)'=100 SQERror^%apiSQL(252,""Sharded query run-time error: -""_$li("_havar_",2)_"" ""_$lg("_havar_",3))")
	#; Previously we called ##class(%SQL.Agent).%EndQuery(nq) but this just kills these globals so inline this here
	d code(" d:+$g(%SNGetQueryStats) getQueryStats^%SYS.SHARDSRV(nq)") ; JMM1009
	d code(" if +$g(%SNSaveTempFiles) {kill "_qtnq_"} else {kill @(""^IRIS.Temp.IRIS.Sql""_nq)@(0),^(-1),"_qtnq_"} d cleanupQuery^%SYS.SHARDSRV(nq,"_quid_",1)") ; JMM1064= JMM1073= JMM1090=
	i $d(%SNDebug) {
		if %SNDebug>=10 {
			d code(" i $d(%SNDebug) { d debugtrace^%SYS.SHARDSRV(""Got end-of-data from nq: ""_nq,,10) }")
		}
	}
	d code(" i $d("_qtn_")<9 { s "_var1_"="_$s(ojtf'="":$$tfref^%qaqcpre(ojfilter(qno),1,3,"0,""""","$o(",",1,"_havar_")"),1:"""""")_" ret }")  ;  last query done  ;  AK939
	d code(" s nq=$o("_qtnq_") s:nq="""" nq=$o("_qtnq_") s "_qtn_"=nq }")
	d code(" q")
	$$$liin("d "_$$subroutn^%qacsub("code",tagx,,1))  ;  subroutine call
	i $d(%SNDebug) {
		if %SNDebug>=10 {
			$$$liin("i $d(%SNDebug),"_var1_"=1 { d debugtrace^%SYS.SHARDSRV(""Got first row from nq: ""_"_qtn_",,10) }")
		}
	}
	$$$liin("i "_var1_"="""""_line1)  ;  done with this level, go up
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK849-
	#; AK939
ojf(m)	n code  ;  [public: ojtf,rejtag,tagx,asl] set up for OJ filtering
	s ojtf=$$tfref^%qaqcpre(ojfilter(qno),1)  ;  temp-file for all ojf() data
	s ojtfForRead=$$tfref^%qaqcpre(ojfilter(qno),1,3,"n,lid,tid","$o(",")") ; temp-file for all ojf() data ; readWriteMode=3 to indicate a read in case it's a non-DISTINCT hybrid
	s ojtfForWrite=$$tfref^%qaqcpre(ojfilter(qno),1,1) ; readWriteMode=1 to indicate a write into the local temp-file in case it's a non-DISTINCT hybrid
	s ojtf=ojtfForWrite ; ojtf is used outside of this function so we better keep it
	#;  reject(n,lid) n tid  ;  add a "rejection" 0 entry for ojfn index
	#;	RETURN:$D(^tf(n,lid,0))  ;  already marked for rejection
	#;	s tid="" f  { s tid=$O(^tf(n,lid,tid)) q:tid=""  KILL ^tf(0,tid) }
	#;	KILL ^tf(n,lid)
	#;	s ^tf(n,lid,0)=""
	#;	RETURN
	d code("(n,lid) n tid RETURN:"_$$tfref^%qaqcpre(ojfilter(qno),1,3,"n,lid,0","$d(",")")_"  s tid="""" f  { s tid="_$$tfref^%qaqcpre(ojfilter(qno),1,3,"n,lid,tid","$o(",")")_" q:tid=""""  KILL "_ojtfForWrite_"0,tid) } KILL "_ojtfForWrite_"n,lid) s "_ojtfForWrite_"n,lid,0)=""""")
	d code(" q")
	s rejtag=$$subroutn^%qacsub("code",tagx_"r",,1)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
zlids(lstr) n lb,jj,str s lb=""  ;  [public: qno] $$: "$ZLIST()" of id's of the lstr=$LIST(str) streams
	f jj=1:1:$ll(lstr) s str=$li(lstr,jj),lb=lb_","_$$idvar(qno,str)
	RETURN "$zlist("_$e(lb,2,*)_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adlist(into,from) n jj ;  append $list() from to .into (by ref), but remove duplicates
	f jj=1:1:$ll(from) s:'$lf(into,$li(from,jj)) into=into_$li(from,jj,jj)
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
alnul(n)  ;  $ZLIST() of n NULLs, e.g. "$C(1,1,1)" for n=3
	s $p(n,",1",n+1)=")"
	RETURN "$c("_$p(n,",",2,*)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
idvar(m,str)  ;  $$: variable used for rowid of the given stream
	RETURN "$li("_havar_","_$li(mt("alid",m),$lf(mt("alst",m),str))_")"
	;  RETURN pti($p(mts(qno,str,"ATT",$p(mts(qno,str),"^",5)),"^",5))
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK939-
	// Simulate "NextCode" to read table valued function
	//  This code sets tvforef, used later in fields^%qaqcdt
	//  This code has to be run in LOGICAL mode or RUNTIME/LOICAL mode
	// I set $zu(115,5,0) when in this code and restore it when we leave (could optimize to only to this if the TVF is SELCTMODE=RUNTIME!)
rtvf	new code,i,prm,tagx,tParams,tParameters,tZU115,val
	set tvforef(str)=$$$getVarName("tvfOref"_str)
	set mt("killonclose")=$g(mt("killonclose"))_$lb(tvforef(str))	// The tvforef variables will be killed during cursor close
	set tZU115=$$$getVarName("tvfZU115"_str)
	set tagx=$$untag^%qaqcpre()
		// here we need to get the arguments to the TVF query.
		// We should already have str defined here, so we can get the parameter list directly from the mt("tvf","str"str) entry 
	set tParams=$g($$$mtTvfParams(str)),tParameters=""
	// if the parameter is an expression, make sure it is evaluated in open.
	// We only support a streamless expression for a JSON_TABLE "tvf"
	// Regular tvfs still just allow varcon as arguments.
	// except for expressions with correlated fields  ;  AK1032
	if tParams'=$c(0) {
		f i=1:1:$ll(tParams) s tParameters=tParameters_","_$s($lg(tParams,i):$$ptvalue^%qaqcpr($li(tParams,i)),1:"") 
	}
	s $e(tParameters)=""	// strip leading ","
	do code(" set "_tZU115_"=$zu(115,5,0)")
	do code(" set:'"_var1_" "_tvforef(str)_"="_$$$smdMapTVFCall(smdmapid)_"("_tParameters_")")
	do code(" if "_tvforef(str)_".%SQLCODE<0 { set SQLCODE="_tvforef(str)_".%SQLCODE,%msg="_tvforef(str)_".%Message,"_var1_"="""" do $zu(115,5,"_tZU115_") ztrap ""SQER""  }")
	do code(" if '"_tvforef(str)_".%Next() { do $zu(115,5,"_tZU115_")")  // No more rows
	do code($c(9)_"if "_tvforef(str)_".%SQLCODE<0 { set SQLCODE="_tvforef(str)_".%SQLCODE,%msg="_tvforef(str)_".%Message,"_var1_"="""" ztrap ""SQER""  }")
	do code($c(9)_"set "_var1_"="""" quit }")
		// Since %Next() can be anythign a user writes, we should also check and make sure the %SQLCODE property is not an error when %Next() returns true also
	do code(" do $zu(115,5,"_tZU115_")")
	do code(" if "_tvforef(str)_".%SQLCODE<0 { set SQLCODE="_tvforef(str)_".%SQLCODE,%msg="_tvforef(str)_".%Message,"_var1_"="""" ztrap ""SQER""  }")
	do code(" set "_var1_"="_var1_"+1")
	do code(" quit")
	if asc'="l",(useiterator="")||(next=1) { set tag=bottom }    ; No tag needed for a lookup
	if $d(grup(next2)) $$$liin(grup(next2))
	if padnext $$$liin(padun)  				// if Padding gotta see if we've already done it
	$$$liin("do "_$$subroutn^%qacsub("code",tagx,,1))	// subroutine call
	$$$liin("if "_var1_"="""""_line1)			// done with this level, go up
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nextcode 
	new i5,code,nxtcode
	set nxtcode=$$$smdMSOverrideNextCode(smdmapid,ilev)
		#; generate "next" subroutine as specified by the MAP DFN:
		#;     %ki [padding test]
		#;         d %xi
	do:qistart greq  ;if qistart (f>=value), need to chk val, skip to %gi
	set datag=datag+1  ;  for tag uniqueness
	new prev,pi
	set prev=$lf(nxtcode,";PREV")  ;  DESC code location, if any
		#;  use either NEXT or PREVious code, if present
		#; See if the nxtcode is a singe line that matches the next code for %TSQ_sys.snf table
		#; This is used each time a SELECT is used with no FROM clause, and I optimize it here to not need a function call
	new inline set inline=0 if $ll(nxtcode)=1,$lg(nxtcode)="s {S1}=$s(1]]{S1}:1,1:"""")" { set inline=1 }
	new temp
	for pi=(asc="d")*prev+1:1:$ll(nxtcode) {	// AK621
		QUIT:pi=prev  
		set temp=$$nxtline($lg(nxtcode,pi))
		if temp[" NEXT" { set temp=$replace(temp," NEXT"," "_tagpre_"x"_datag) } 
		if temp[",NEXT" { set temp=$replace(temp,",NEXT",","_tagpre_"x"_datag) } 
		set code($i(i5))=" "_temp
	}
	s code(i5+1)=" q"
	if asc'="l",useiterator=""||(next=1) s tag=bottom   ; No tag needed for a lookup
	if $d(grup(next2)) $$$liin(grup(next2))	// BJB366=
	if padnext $$$liin(padun)  ;  if Padding gotta see if we've already done it
	if 'inline {
		new %sqlParallelInfo // In case there is embedded SQL in this code, it is a recursive compile not under any current parallel unbrella
		s line="d "_$$subroutn^%qacsub("code",tagpre_"x"_datag,,1) $$$liin(.line)  ;  subroutine call	// DPV3122
	}
	else {
		$$$liin(code(1))	// optimized - inline, %TSQL_sys.snf next code
	}
	s:qistart tag=tagpre_"g"_next  ;skip to here if start-value inclusive
	s line="i "_var1_"="""""_line1 $$$liin(.line)  ;  done with this level, go up
	QUIT
.
/// Generate the code for the tag in the cached query that will grab the next row of the given foreign table stream
///
/// Parameters
/// 	stream			- stream # of the foreign table we are generating for, used to reference mt() for ft information
///		runtimeIDVar	- Name of the variable in the runtime generated code that represents the ID for the foreign table
///							being looped over by this NEXT code
generateFTNextCode(stream, runtimeIDVar) [asc,bottom,datag,grup,line,line1,mt,next,next2,padnext,padun,pti,qistart,smdmapid,tag,tagpre,useiterator] PRIVATE {
	set indent = ""	// for the code generation
	// oref is the runtime variable name for the foreign table FDW object that we use to get the actual FT data, zu115 is runtime variable name used to hold select mode
	set oref = $$$getVarName($$$FTOrefVar(stream))
	set zu115 = $$$getVarName($$$FTSelectModeVar(stream))
	set mt("killonclose")=$g(mt("killonclose"))_$lb(oref, zu115) // make sure these get cleaned at the end of the query
.
		/* Maybe passed a "fake" stream, for SQL FTs where we create a fake stream in mt() to represent the pushed query.
			Resolve that to the underlying stream now. */
	set isFakeStream = $d($$$FTFakeStream(stream)), configTables = []
	if isFakeStream {
		set server = $$$FTFakeStreamServer(stream)
		set originalStream = ""
		for tablePosition=0:1 {
			set originalStream = $o($$$FTFakeStreamOneUnderlyingStream(stream, originalStream))
			QUIT:originalStream=""
			do configTables.%Set(tablePosition, $$getForeignTableConfigSerialization(originalStream))
		}
	} else {
		// one original FT stream, i.e. a CSV table
		set server = $$$FTServerByOriginalStream(stream)
		do configTables.%Set(0, $$getForeignTableConfigSerialization(stream))
	}
.
.
	// variables we need for the code gen
	set wrapperClass = $$$FTServerFDWClass(server)
	set runtimeConfig = $$localvar("CONFIG")
	set exception = $$localvar("EX")
	set msg = $$localvar("MSG")
	set status = $$localvar("SC")
	
		// build up compile-time dynamicobject that we can %ToJSON() into the generated code
	set config = {}
	set config.server = $$getServerConfigSerialization(server)
	set config.tables = configTables
.
		// fake streams are due to pushdown so we need to add in the SQL-specific config information for them. We will
		// have to do the ?-parameters in the query separate because they use runtime variables, so we can't include
		// them in a compile-time config object that we just %ToJSON() into the generated code
	if isFakeStream {
		set config.sql = $g($$$FTFakeStreamQuery(stream))
		set parameters = $g($$$FTFakeStreamQueryParameters(stream))
		set parameterTypes = ""
			/* turn parameters into proper structure of [[datatypeNum1, runtimeVariable1], ... ], but dynamic arrays
			don't accept variables without calling %Set so we have to do the runtimeVariable1 items separately	(parameterVals) */
		set parameterVals=1, parameterVals(1)="", ptr=0, index=0, numParameters=$ll(parameters)
		while $listnext(parameters,ptr,val) {
			set dataType = $$$VTRgetdt(val)
			set dataType=$case($p(dataType,".",2),"Boolean":-7,"TinyInt":-6,"BigInt":-5,"Numeric":2,"Integer":4,"SmallInt":5,"Double":8,"Date":9,"Time":10,"TimeStamp":11,"PosixTime":11,:12)
			set parameterTypes = parameterTypes_",["_dataType_"]"
			set parameterVals(parameterVals) = parameterVals(parameterVals)_","_runtimeConfig_".sqlParameters.%Get("_index_").%Set(1,"_pti(val)_")"
			do $i(index)
			if $l(parameterVals(parameterVals))>$$$MaxRtnLineLength, index<numParameters {
				set $e(parameterVals(parameterVals),1) = ""
				do $i(parameterVals)
				set parameterVals(parameterVals) = ""
			}
		}
		set $e(parameterTypes,1) = "" // remove leading comma on the datatypes
		set $e(parameterVals(parameterVals),1) = ""	// remove leading comma on the parameter value binding
	}
.
	/* ===== GENERATE ACTUAL NEXT CODE ====== */
	// runtimeIDVar is used as the looping/row count variable, and is reset to "" when FT is out of rows. It's like the {L1} field of custom storage
	do gen(" try {")
		do gen("set "_zu115_" = $zu(115,5,0)", 1)
		do gen("if '$d("_oref_") {", 1)
			do gen("set "_runtimeConfig_"="_config.%ToJSON(), 2)								// build the runtime config
			if isFakeStream {
				do gen("set "_runtimeConfig_".sqlParameters=["_parameterTypes_"]", 2)		// parameters added separate
				set parameterValIndex = ""
				for {
					set parameterValIndex = $o(parameterVals(parameterValIndex),1,line)
					QUIT:parameterValIndex=""
					QUIT:line=""
					do gen("do "_line, 2)
				}
			}
			do gen("set "_oref_" = ##class("_wrapperClass_").%New("_runtimeConfig_")", 2)	// INSTANTIATE OREF
			do gen("if "_oref_"="""" { set SQLCODE=-270, %msg=$system.Status.GetErrorText(%objlasterror), "_runtimeIDVar_"="""" QUIT }", 2)	// handle failure to instantiate, QUITs the try block
			do gen("set "_status_" = "_oref_".execute()", 2)
			do gen("if $$$ISERR("_status_") { set SQLCODE=-230,%msg=$system.Status.GetErrorText("_status_"), "_runtimeIDVar_"="""" QUIT }", 2)
		do gen("} else { ", 1)
			do gen("if "_runtimeIDVar_"="""" { // looping over the FT result set again", 2)
				do gen("do "_oref_".reset()", 3)
			do gen("}", 2)
		do gen("}", 1)
		do gen("if '"_oref_".next() {", 1)
			do gen("set "_runtimeIDVar_"="""" // fully explored the result set ", 2)
			do gen("QUIT", 2)	// QUIT the try{}
		do gen("}", 1)
		do gen("set "_runtimeIDVar_"=$g("_runtimeIDVar_")+1", 1)
	do gen(" } catch "_exception_" {")
		do gen("set SQLCODE=$system.Status.StatusToSQLCODE("_exception_".AsStatus(), ."_msg_")", 1)
		do gen("set %msg="_msg, 1)
	do gen(" }")
	do gen(" do $zu(115,5,"_zu115_")")	// reset selectmode
	do gen(" ztrap:SQLCODE'>-1 ""SQER""")
	do gen(" RETURN")
	
	if asc'="l",useiterator=""||(next=1) { set tag=bottom   } ; No tag needed for a lookup
	if $d(grup(next2)) { $$$liin(grup(next2)) }	// BJB366=
	if padnext { $$$liin(padun) } ;  if Padding gotta see if we've already done it
	$$$liin("d "_$$subroutn^%qacsub("code",tagpre_"x"_datag,,1))   ;  subroutine call	// DPV3122
	set:qistart tag = tagpre_"g"_next  ;skip to here if start-value inclusive
	$$$liin("i "_runtimeIDVar_"="""""_line1)  ;  done with this level, go up
	
	RETURN
.
	// dispatches to code() and handles indenting to make the code generation above a bit cleaner
gen(line, indent=0)
	do code($$$tabs(indent)_line)
	RETURN
}
.
.
/// Get the serialized 'server' object for the provided server class, to be added to a serialized config object for
/// for foreign data wrapper creation. Will shortcut to a precreated config object if it's already been requested before.
///
/// Parameters:
///		FT server class name
///	Returns:
///		JSON object (%DynamicObject) representing the serialized server config. "" if not valid
getServerConfigSerialization(serverClass) [mt] PRIVATE {
	RETURN:$d($$$FTServerConfig(serverClass), config) config
	set config = ""
	try {
		set config = $classmethod(serverClass, "serializeConfig")
	} catch ex {
		set:ex.Name="<METHOD DOES NOT EXIST>" config = $$getServerConfigSerialization^%apiSQL(serverClass)
	}
.
	RETURN config
}
.
.
/// Get the serialized 'table' object for the provided stream number, to be added to a serialized config object for 
/// foreign data wrapper creation. Will shortcut to a precreated config object if it's already been requested before.
///
///	Returns:
///		JSON object (%DynamicObject) representing the serialized FT config. "" if not an FT
getForeignTableConfigSerialization(stream) [mt] PRIVATE {
.
	RETURN:$d($$$FTConfigByOriginalStream(stream), config) config
	RETURN:'$$$IsFTStream(stream) ""
	set config = ""
	try {
		set irn = +$$$mtR( stream)
		set class = $$$smdClassname(1, irn)
		set config = $classmethod(class, "serializeConfig")
	} catch ex {
		set:ex.Name="<METHOD DOES NOT EXIST>" config = $$getForeignTableConfigSerialization^%apiSQL(class)
	}
	
	RETURN config
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
greq	n good  ;  handle >= case when "next" override exists
	#;  i 'qistart s line="g "_bottom d in q
	#;  if initial value is inclusive (f>=const), might skip nextcode
	s good=$S($case(atype,"Piece":1,"List":1,:0):","_var1_">0",'const!(atype="Other"):","_var1_"'=""""",1:"")
	d invalid
	i good=",'$t" s line="e  g "_tagpre_"g"_next $$$liin(.line) QUIT  ;  value "valid"
	i good=",$t" s line="i  g "_tagpre_"g"_next $$$liin(.line) QUIT  ;  value "valid"
	s line="i "_$E(good_$S(rtype=1:",$d("_ref1_")",1:""),2,*)_" g "_tagpre_"g"_next $$$liin(.line)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mstart	n code,i5,oic  ;start value/"invalid" override (when no "next" override)
	s oic=$$$smdMSOverrideInvalidCondition(smdmapid,ilev),code=0,i5=$ll(oic)	// DPV2060
	i i5 f i5=1:1:i5 d code($$nxtline($lg(oic,i5)))
	d:'i5 code(mstart_"]]"_var1):mstart'="",code($tr(ref,$c(2))_")="""""):$case(atype,"Piece":1,"List":1,:0)
	f i5=1:1:code s line="i "_code(i5)_" g "_bottom $$$liin(.line)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
invalid	n i,invcode,getvar,ln,numinv,datavar  ;  come in with good=[,...Si'=NULL]
	#;  generate: I [...Si'=NULL,]$d(ref)
	#;            I '$t
	#;            E  I inv1
	#;            E  I inv2
	#;  return good=",'$t" or ",$t" iff "invalid" code found
	s invcode=$$$smdMSOverrideInvalidCondition(smdmapid,ilev)
	i invcode="" s invcode=$$$smdMSDefaultInvalidConditions(smdmapid,ilev) GOTO:invcode="" invallen
	s dod=0
	#; Reason we check this when we have superclass and subclasses the invalid code contains multiple references to the first $lg piece of the D global
	if rtype=1,$$nxtline($listtostring(invcode))["$g("_ref1_")" {
		set getvar=$$$getVarName("tmpinvalid"),datavar=$$$getVarName("tmpdata")
		set good=$select(good="":",1",1:good)_" s "_datavar_"=$d("_ref1_","_getvar_") s:"_datavar_"=10 "_getvar_"="""" i "_datavar
	} else {
		s good=good_$s(rtype=1:",$d("_ref1_")",1:"")
	}
	s:good="" good=",1"
	s line="i "_$e(good,2,*) $$$liin(.line)
	s numinv=$ll(invcode)
	for i=1:1:numinv {
		set ln=$$nxtline($lg(invcode,i))
		if $get(getvar)'="" set ln=$replace(ln,"$g("_ref1_")",getvar)
		if $d(%ISCSNRemoteTables) && ($e($g(ref1),*,*)="|") { // JMM1195+
			#; Table is a remote shard-local table.  ref1 is "^|<shref-variable-name>|".
			#; Replace references to shard-local globals (whose names start with ^IS.) with extended references.
			set ln=$replace(ln,"^IS.",ref1_"IS.")
		} // JMM1195-
		if i=1 {
			#; Optimize for a single line single expression (so call $$goodexpr in case generated code has 'expr1,expr2' in it which would be generated as 'if expr1,expr2' in old code)
			if numinv=1,$$goodexpr(ln) {
				set line="i  i '("_ln_")" $$$liin(.line)
				set good=",$t"   ; flag that "invalid" code found for optimized simple case
				RETURN
			} else {
				#; Flip the true/false flag
				s line="i '$t" $$$liin(.line)
			}
		}
		set line="e  i "_ln $$$liin(.line)
	}
	s good=",'$t"  ;  flag that "invalid" code found
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
goodexpr(val) public {  ; Return true if 'val' is a valid expression and false otherwise
	set code(0)=1,code(1)=" i '("_val_")"
	set rc=$compile(code,0,err)
	RETURN rc=0
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
invallen  ;  check to see if good is too long and ref too
	i rtype=1,$l(good)+$l(ref1)+5'>($$$MaxRtnLineLength-500) QUIT  	// DPV1940=	// DPV2260 (500 instead of 50)
	i rtype'=1,$l(good)'>($$$MaxRtnLineLength-50) QUIT  		// DPV1940=
	s dod=0,good=good_$S(rtype=1:",$d("_ref1_")",1:"") s:good="" good=",1"
	s line="i "_$E(good,2,*) $$$liin(.line)
	s good=",$t" ; flag that code had to be split
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nxtline(line) s subi="{S"_slev_"}"
	s line=$replace(line,"^("_subi_")",ref1)
	s line=$replace(line,subi,var1)  ;  change {S3} for da(5)
	QUIT $$repl(line)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
repl(line) n i,subtmp  ;  $$:  replace {Si} and {iD}
	f i=1:1:slev f subi="S"_i,i_"D" f  q:line'[("{"_subi)  s subtmp=subi_$p($p(line,"{"_subi,2),"}") s line=$replace(line,"{"_subtmp_"}",pti($p(mts(qno,str,"ATT",subtmp),"^",5)))
	QUIT line
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; From old %aaakey1 ; asl code generation of the nexting mechanism
strtstop  ;  returns start, qistart, const, stopcond, and swline.
	#;  Figure out the Start Conditions
	#; Might be from asl(), or Data Dict of Field, or Map DFN.
	#; Check out Data type from DD.
	set cat="" set:ifn'="" cat=$$GetFieldCategory^%qaqcct(ifn) ; must be a field - check its SQL Category
	set numeric=$s("^INTEGER^DATE^DOUBLE^NUMERIC^TIME^"[("^"_cat_"^"):1,1:0)
	#;  start/Stop values on Subscript from MAP DFN
	set:'mapid mstart="",mstop=""	// DPV2060 Otherwise, mstart/mstop set in maplev
	set qstart=$p(stuff,$c(1),3),qistart=$p(stuff,$c(1),4),qstop=$p(stuff,$c(1),5),qistop=$p(stuff,$c(1),6),swsw=(2=qistart),qpartition=0
	#; If qistart>4 signal this RANGE is from a %PARTITION BY so do not null replace
	if qistart>4 { set qistart=qistart-5,qistop=qistop-5,qpartition=1 }
	#; Start with " " if doing descending order and numeric
	set const=$s(qstart:$$$mtVType($$$mtV(qstart))="t",1:0)
	#;  cval = the given constant value, cnum = whether it is numeric
	set:const cval=$e($$$mtV(qstart),3,*),cnum=(cval=+cval)
	#;  if constant is NULL/empty string, just cancel %STARSWITH
	if swsw,const,$c(0)[cval { set swsw=0,qstart="",qistart="",const=0 }
	set loopinit=$s(smdmapid&ilev:$$loopinit(smdmapid,ilev,slev,var1,atype),1:"")  ; Loop Initialization Value
	set start=$s(qstart:pti(qstart),loopinit'=""&&(asc'="d"):loopinit,'const&&(asc="d")&numeric:""" """,1:"""""")
		#;  If ORDER BY DESC over a Piece subscript, we need to start at the last piece, not the first (DPV2131)
	if $case(atype,"Piece":1,"List":0,:0),start=""" """,asc="d" { set start="$l("_$e(ref,4,$f(ref,del)-1)_")+1" }
	if $case(atype,"Piece":0,"List":1,:0),start=""" """,asc="d" { set start="$ll("_listval_")+1" }
	if const,start="""""" { set qistart=0,swsw=0 }  ; the const NULL (cancel SW)
	set stopcond=""
	#; [DPV5329] n var1null s var1null=$s(var1=pti(keycol)&&($g(%nsvalex(mod,keycol))'=""):"$s("_var1_"'="_%nsvalex(mod,keycol)_":"_var1_",1:"""")",1:var1)
	new var1null set var1null=var1
	goto:swsw strtwith
	RETURN:qstop=""
	//Not valid with AK672, see TRW1587
	//i numeric s stopcond=var1_$s(asc="d":$s(qistop:"<",1:"'>"),1:$s(qistop:">",1:"'<"))_pti(qstop) QUIT
	#;  Use Binary Sorts-after (]]) operator rather than $$ordertag  ;  DPV837
	if asc="d" {
		if $g($$$mtUserDefNullMarkerFlag(mod,+stuff)){ ; IBA097  if user-defined null-marker, undo DPV5808
			i asc="d" s stopcond=$s('qistop:$s('qpartition:var1null,1:var1)_"']]"_pti(qstop),1:pti(qstop)_"]]"_$s('qpartition:var1null,1:var1)) RETURN
			s stopcond=$s('qistop:pti(qstop)_"']]"_$s('qpartition:var1null,1:var1),1:$s('qpartition:var1null,1:var1)_"]]"_pti(qstop)) RETURN
		}
			#; note that on the lines below var1null was used if 'qpartition, but since var1 and var1null are the same, I cleaned this up (DPV)
			#; If there is a null marker for this subscript, we need to make sure we do not go into the null values if the stopcond collates before the nullmarker (DPV5808)
		if 'qistop {
			if 'qpartition { set stopcond=var1_"']]"_$s($g($$$mtNullMarkerSub(mod,+stuff))="":pti(qstop),1:"$s("_pti(qstop)_"]]"_$$$mtNullMarkerSub(mod,+stuff)_":"_pti(qstop)_",1:"_$$$mtNullMarkerSub(mod,+stuff)_")") }   //stop value not inclusive 
			else           { set stopcond=var1_"']]"_pti(qstop) }   //stop value not inclusive, for qpartition case, no need to worry about going between "" and null-marker range
		}
		else       {	// stop value is inclusive
			if $g($$$mtNullMarkerSub(mod,+stuff))'="",'qpartition { set stopcond=pti(qstop)_"]]"_var1_"||("_var1_"']]"_$$$mtNullMarkerSub(mod,+stuff)_")" }
			else { set stopcond=pti(qstop)_"]]"_var1 }
		}
		RETURN
	}
	set stopcond=$s('qistop:pti(qstop)_"']]"_$s('qpartition:var1null,1:var1),1:$s('qpartition:var1null,1:var1)_"]]"_pti(qstop))
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; DPV966
	#; JLF015
loopinit(smdmapid,ilev,slev,var1,atype)	 ;  Return Loop Initialization Value
	n line s line=$$$smdMSLoopInitValue(smdmapid,ilev)	// DPV2060
	#; JLF015-
	QUIT:line="" ""
	QUIT $$repl($replace(line,"{S"_slev_"}",var1))
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; DPV966-
strtwith  ;  handle %STARTSWITH
	#; if Name, that means that subscript is not split
	#; use only $p(1) as RANGE and retest later the whole condition!
	#; temporary measure - if a^, then use $p(1) as RANGE but don't retest
	i cat="NAME" d  QUIT  ;  Handle 'Name' categories here
	#; AK719
	. s swe=$$$getVarName("sw"_mod_"enc"_next2),swl=$$$getVarName("sw"_mod_"len"_next2)
	#;  i l,$E($ZU(70,5,$P(f,",")),1,l)'=e GOTO DONE  ;  stopcond
	#;  i '$$$sw($P(f,","),$P(p,",")) { GOTO:l NEXT GOTO DONE } i '$$$sw($P(f,",",2),$P(p,",",2)) GOTO NEXT  ;  swline
	. s stopcond=swl_",$e($zu(70,5,$p("_var1null_","","")),1,"_swl_")'="_swe
	. s swline="i '"_$$swex("$p("_var1_","","")","$p("_start_","","")")_" { g:"_swl_" "_bottom_line1_" } i '"_$$swex("$p("_var1_","","",2)","$p("_start_","","",2)")_" g "_bottom
	#; AK719-
	#;  Real %STARTSWITH
	#; AK709
	s swline="i '"_$$swex(var1,start)
	#;  field numeric - no limiting, just test the condition on each value
	i numeric s swline=swline_" g:"_var1_$s(asc="d":"'<"_start,1:"=+"_var1)_" "_bottom_line1 QUIT
	#;  numeric constant - loop up to ":", test each value
	#;  i ":"']f GOTO DONE ; stopcond
	#;  i '$$$sw(f,p) GOTO NEXT ; swline
	i const,cnum s:asc'="d" stopcond=""":""']"_var1null s swline=swline_" g "_bottom QUIT
	s swe=$$$getVarName("sw"_mod_"enc"_next2),swl=$$$getVarName("sw"_mod_"len"_next2)
	#;  non-numeric constant - if ambiguous, loop based on encoding prefix
	#;  i l,$E($ZU(70,5,f),1,l)'=e GOTO DONE ; stopcond
	#;  i '$$$sw(f,p) GOTO:l NEXT GOTO DONE ; swline
	i const s stopcond=swl_",$e($zu(70,5,"_var1null_"),1,"_swl_")'="_swe,swline=swline_" g:"_swl_" "_bottom_line1 QUIT
	s swn=$$$getVarName("sw"_mod_"num"_next2)  ;  could be numeric or ambiguous
	#;  i (n&&(":"']f))||(l&&($E($ZU(70,5,f),1,l)'=e)) GOTO DONE ; stopcond
	#;  i '$$$sw(f,p) GOTO:n||l NEXT GOTO DONE ; swline
	s stopcond=$s(asc'="d":"("_swn_"&&("":""']"_var1null_"))||",1:"")_"("_swl_"&&($e($zu(70,5,"_var1null_"),1,"_swl_")'="_swe_"))"
	s swline=swline_" g:"_swn_"||"_swl_" "_bottom_line1
	#; AK709-
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
swex(a,b)  ;  generate a %STARTSWITH b
	#; AK646
	QUIT "(($c(0)["_b_")||(($c(32,0)["_b_")&&($e("_a_")="" ""))||("_b_"=$e("_a_",1,$l("_b_"))))"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
padcode	n j,i,next2,op,i5,log,code  ;  ep only from next+4^key
	#; set into 'padcode' code for padding.
	#; Add test of padding flags
	#;  padN=0 - Havent gone in this module yet
	#;  padN=1 - Have gotten at least 1 tuple from disc - padding disabled
	#;           [But it may have failed conditions.]
	#;  padN=2 - Are in A Padding situation.
	s code=1,code(1)=" s "_$$$getVarName("oldpad_"_mod)_"=2"
	#;  if chunk looping, just set bit 64001 as a fake bit, to
	#;      indicate a single fake row (for COUNT(*) )
	i $o($$$aslKNext(mod,1,""),-1,i),$p(i,$c(1),2)="h" { s code(code)=code(code)_","_pti($p(i,$c(1),10))_"=$C(151,1,65,31,0,250)" } else {  ;  AK956
	s j=""  ;  Insert NULL for all keys!!!
	#; AK567
	#;  and for split parent reference subscript replaced in xpand^hi
	#; AK619
	f  s j=$o($$$aslKNext(mod,1,j)) q:j=""  d null($$$aslNextSubscriptVal($$$aslKNext(mod,1,j))) d:j[".001" null($p(mts(qno,str,"ATT",$p(mts(qno,str,"MAP",mapid,j\1),"^",2)),"^",5))
	#; AK567-
	#;  Insert NULL for all fields to get data for...
	#;  *** handle multi-nodes in "fields"
	f i=1:1 s j=$p($g($$$aslKFlds(mod,1)),",",i) q:j=""  d null(j)
	}  ;  AK956
	d code(" g "_tagpre_"pdtg")
	s padcode=":"_$$$getVarName("oldpad_"_mod)_"=1 g "_$$subroutn^%qacsub("code",tagpre_"0pad",,1)	// DPV3122
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
null(i)	;  set the whole node to NULL
	QUIT:i=""
	n keyword
	d setnull(i)
	s keyword=""
	f  s keyword=$o(mt("unary",i,keyword)) q:keyword=""  d setnull(mt("unary",i,keyword))
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setnull(i)  ;  set variable of i to null in the padding code
	#; AK518
	QUIT:$d(i5(i))  s i5(i)=""  ;  remove duplicate setting
	i $l(code(code))<$$$complength s code(code)=code(code)_","
	e  d code(" s ")
	#; AK518
	#; DPV1799
	s code(code)=code(code)_pti(i)_"="_$$colnul^%qaqcpr(i,1)  ;  if collated, collate NULL
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
refdvar(prelev,ilev)  ;
	#;  Set-Up the internal variable reference for 'iDj' Variables
	new code,argmap,dvar,dlev,x s dvar=""
	for  {
		set dvar=$o($$$smd(12,smdmapid,6,ilev,"expr",dvar),1,x) quit:'dvar
		set dlev=$$scrcol($tr($lg(x),"{}"),,,1)
		set i=$ll($lg(x,2))
		if i=1,$lg($lg(x,2),i)="" { continue }
		for i=1:1:i { set code(i)=$lg($lg(x,2),i) }
		kill argmap
			// If the last line of the code is a comment ";*inline*", this is iDj code for columnar mapping and we want the code inline for performance
		if code(i)=";*inline*" { set argmap="inline" kill code(i) set i=i-1 }
		for i=1:1:i { set code(i)=" "_$$swap^%qaccode(code(i),.argmap) }
		if $g(argmap)="inline" {
			if i=1 {
				set line=$$$StripLeadingWhiteSpace(code(i))
				$$$liin(.line)
			} else {
				set code(i+1)=" q"
				set line="do "_$$tagnam^%qaqcdt("d")
			}
		}
		else { 
			set code(i+1)=" q"
			set line = $$invokeCode^%qaqcdt(.argmap, dlev)
		}
		if funk=2||(good="") { $$$liin(.line) continue }
		if good=",$t" { set line="i  "_line_" i 1" $$$liin(.line) continue }
		if good=",'$t" { set line="e  "_line_" i 0" $$$liin(.line) continue }
		set line="i "_$e(good,2,*)_" "_line_" i 1",good=",$t" $$$liin(.line)
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
code(line) s code($i(code))=line  ;  add line to the code
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
generateACORN1FilterMethod() [m,methodstoadd,mt,sqline] PUBLIC {
	// This subroutine generates code for a new CQ method, named mt("ACORN-1",m,"filterMethodName"), which contains code to check for the query's
	// conditions and return 1 if satisfied and 0 otherwise, copying (cut-pasting namely) code originally generated in sqline(mt("ACORN-1",m,"mod")) in next^%qaqcky
	set class = $get(%classname)
	RETURN:(class="")||($extract($get(%caller),1,8)="ShowPlan")
	set method = $$$mtACORN1FilterMethodName(m)
	set methodstoadd = methodstoadd_$lb(method)
.
	// Register new method
	$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHorigin,class)
	$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHclassmethod,0)
	$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHrunnable,1)
	
	// Register method parameter and return type
	$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHuseractualtype,"%Library.String")
	$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHformalspecparsed,$lb($lb($g($$$mtACORN1NewPTIForiID(m)),"%Library.String","","")))
	$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHreturntype,"%Library.Boolean")
	
	// Copy code from sqline(mt("ACORN-1",m,"mod")) starting in line $$$mtACORN1StartLine(m) and ending in line lastLineNumWithModTag (defined below) into this
	// newly generated method that filters nodes that pass the query's conditions generated originally in sqline(mt("ACORN-1",m,"mod")) in next^%qaqcky.
	// First we define lastLineNumWithModTag to be the last line that includes a reference to the mt("ACORN-1",m,"modTag") tag. We use this line to know when to stop copying
	set lastLineNumWithModTag = $$$mtACORN1EndLine(m)
	for i=$$$mtACORN1StartLine(m):1:$$$mtACORN1EndLine(m) {
		set line = $$$sqline($$$mtACORN1Mod(m),i)
		if $find(line,$$$mtACORN1ModTag(m)) {
			set lastLineNumWithModTag = i
		}
	}
	// Copy code now
	for i=$$$mtACORN1StartLine(m):1:lastLineNumWithModTag {
		set line = $$$sqline($$$mtACORN1Mod(m),i)
		// Skip lines that:
		// 1. go to the dun tag, or
		// 2. are marked as related to TOP conditions (under "skippedLines")
		// But first replace any potential changed references of the ID variable pti($p(useVectorMap,2)) back to mt("ACORN-1",m,"oldptiFori%ID")
		if ($find(line,$$$mtACORN1DunTag(m))'=0) || ($LISTFIND($g($$$mtACORN1SkippedLines(m)),i)'=0) {
			set $$$sqline($$$mtACORN1Mod(m),i)=$replace($$$sqline($$$mtACORN1Mod(m),i),$$$mtACORN1NewPTIForiID(m),$$$mtACORN1OldPTIForiID(m))
			CONTINUE
		}
		// Replace the bottom tag mt("ACORN-1",m,"modTag") with a new method_"QUIT0" subroutine that runs "QUIT 0"
		set line = $replace(line,$$$mtACORN1ModTag(m),method_"QUIT0")
		// Delete line from original sqline(mod)
		kill $$$sqline($$$mtACORN1Mod(m),i)
		$$$comSubMemberSet(class,$$$cCLASSmethod,method,$$$cMETHimplementation,i+1-$$$mtACORN1StartLine(m),line)
	}
.
	// Add new subroutine that QUITs with value 0 if the current ID does not pass the filter
	set quittingTagLines = 1
	$$$comSubMemberSet(class,$$$cCLASSmethod,method,$$$cMETHimplementation,$$$mtACORN1EndLine(m)+$i(quittingTagLines)-$$$mtACORN1StartLine(m)," QUIT 1")
	$$$comSubMemberSet(class,$$$cCLASSmethod,method,$$$cMETHimplementation,$$$mtACORN1EndLine(m)+$i(quittingTagLines)-$$$mtACORN1StartLine(m),method_"QUIT0")
	$$$comSubMemberSet(class,$$$cCLASSmethod,method,$$$cMETHimplementation,$$$mtACORN1EndLine(m)+$i(quittingTagLines)-$$$mtACORN1StartLine(m)," QUIT 0")
.
	$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHimplementation,0)
}
startln	; Create the appropriate Start Line(s) [from %qaqcky]
	#;  Do the Start Code Line
	#;  handle also start/stop here
	#; AK506
	if atype="Bit","adl"[asc { GOTO bitstrt }  ;  bitmap subscript
	if (useVectorMap'="")&&(next=$lg(useVectorMap,9)) {
		d davalue^%qaqcpr($lg(useVectorMap,6))
		$$$liin("set "_$lg(useVectorMap,7)_"=##class("_$$$VectorIndexWorkerClass($lg(useVectorMap,8))_").%New("""_$$$GetClassNameFromIQN($lg(useVectorMap,4))_""","""_$lg(useVectorMap,3)_""")")
		if $lg(useVectorMap,5)'="" { $$$liin("set "_$lg(useVectorMap,7)_".K="_$lg(useVectorMap,5)) }
		if $lg(useVectorMap,10)'="" { $$$liin("set "_$lg(useVectorMap,7)_".PartitionKeys=$lb("_$lts($lg(useVectorMap,10))_")") }
		if $lg(useVectorMap,11)'="" { $$$liin("set "_$lg(useVectorMap,7)_".BucketID="_$lg(useVectorMap,11)) }
		$$$liin("set "_$lg(useVectorMap,7)_".Point="_pti($lg(useVectorMap,6)))
		If $lg(useVectorMap,8)=$$$HNSWIndexClass,$g(mt("options","efSearch")) { $$$liin("set "_$lg(useVectorMap,7)_".efSearch="_+mt("options","efSearch")) }
		
		// Disable ACORN if no conditions were found other than TOP; if some were found, set up the filter and CQ oref properties used by ACORNneighborsDynamicExpand in HNSWIndexerV2
		if $$isACORNon^%qaqpag(m) {
			if $$hasNonTOPconditions(mod,ndata) {
				set $$$mtACORN1FilterMethodName(m)=gtag_"Acorn1Filter"_m
				set $$$aslPostkeyAcorn1(mod)=gtag_"Acorn1Filter"_m
				if $extract($get(%caller),1,8)="ShowPlan" {
					// Add ACORN-1 optimization to the optimizations log in dmt("logopt")
					set dmt("logopt")=$g(dmt("logopt"))_$lb("ACORN-1",m)
				}
				$$$liin("set "_$lg(useVectorMap,7)_".FilterMethodName="""_$$$mtACORN1FilterMethodName(m)_"""")
				// Store ID instead of actual OREF to avoid a referential loop that sabotages proper OREF destruction; then use $zobjref in HNSWIndexerV2 (EEE035)
				$$$liin("set "_$lg(useVectorMap,7)_".CachedQueryOrefId=+$this")
			} else {
				set $$$mtACORN1Enabled(m) = 0
			}
		}
	}
	if ((useiterator="")||(qistart=0)||(qistart=1))&&((useVectorMap="")||(next<$lg(useVectorMap,9))){
		set line="set "_var1_"="_$s(tempid["-":1,1:$$startval(asc)) $$$liin(.line)  ; Start Line.
	}
	if useiterator'="" {
		new iterflag set iterflag = $lg(useiterator,2)
		if qistart{
			if $case(atype,"Piece":1,"List":1,:0) {
				set line="$s("_var1_">0:0,1:2)"
			} else {
				#; Look to see if we will be getting a value from this node later, if so use two piece $data to get it now
				#; need to set havar to "" before the $data in case the node did not have any data
				if smdmapid'="",($o($$$smd(12,smdmapid,6,""),-1)=ilev),$e($$$smdMapIndexType(smdmapid))'="B",$$needhavar(.havar,,"node"_mod_"val"_funk_ndata)
				set line="" 
				if 'const {
					if 'qpartition { set line="$s("_var1_"'="""""_$s($g($$$mtUserDefNullMarkerFlag(mod,+stuff)):"",$g($$$mtNullMarkerSub(mod,+stuff))="":"",1:"&&("_var1_"]]"_$$$mtNullMarkerSub(mod,+stuff)_")")_":0,1:2)" }
					else           { set line="$s("_var1_"'="""":0,1:2)" }  // For the qpartition case, no need to worry about the ""<->nullmarker range of values
				}
			}
			set:line'="" iterflag = iterflag_"+"_line
		}
		
		if next=1,tempid {
			$$$liin("s "_$lg(useiterator,3)_"=##class(%Iterator.Global).%New($name("_$$$mtTref(tempid)_")),"_$lg(useiterator,1)_","_iterflag_","_$s($lg(useiterator,8)'="":var1,1:"""""")_","_$s($lg(useiterator,9)'="":pti($lg(useiterator,9)),1:"""""")_"),"_$lg(useiterator,4)_"="_$lg(useiterator,3)_".getzu113Cookie()"_$s($lg(useiterator,11)'="":","_$lg(useiterator,11)_"=1",1:""))
		}
		elseif next=1,mapid {
			if $lg(useiterator,7)["^["||($lg(useiterator,7)["^|") {
				;  If $lg(useiterator,7) is in an extended reference form, RefInKind to 0, get the $name result, and switch the RefInKind setting back
				new refInKind,refName
				set refInKind=$$$getVarName("rik"_qno),refName=$$$getVarName("rn"_qno)
				$$$liin("set "_refInKind_"=$zu(68,7,0),"_refName_"=$name("_$lg(useiterator,7)_") do:"_refInKind_" $zu(68,7,1)")
				$$$liin("set "_$lg(useiterator,3)_"=##class(%Iterator.Global).%New("_refName_","_$lg(useiterator,1)_","_iterflag_","_$s($lg(useiterator,8)'="":var1,1:"""""")_","_$s($lg(useiterator,9)'="":pti($lg(useiterator,9)),1:"""""")_"),"_$lg(useiterator,4)_"="_$lg(useiterator,3)_".getzu113Cookie()"_$s($lg(useiterator,11)'="":","_$lg(useiterator,11)_"=1",1:""))
			} else {
				$$$liin("s "_$lg(useiterator,3)_"=##class(%Iterator.Global).%New($name("_$lg(useiterator,7)_"),"_$lg(useiterator,1)_","_iterflag_","_$s($lg(useiterator,8)'="":var1,1:"""""")_","_$s($lg(useiterator,9)'="":pti($lg(useiterator,9)),1:"""""")_"),"_$lg(useiterator,4)_"="_$lg(useiterator,3)_".getzu113Cookie()"_$s($lg(useiterator,11)'="":","_$lg(useiterator,11)_"=1",1:""))
			}
		} 
		RETURN
	}
		#; in strtstop, if qstart (val# of lower loop limit) was given, we ignored any loopinit value defined in the map.
		#; Here we handle the case where the loopinit value should be used instead of the qtart value if the loopinit value collates after the qtart value
		#; This corrects ProdLog 156970
	if $g(loopinit)'="" { set line="set:"_loopinit_"]]"_var1_" "_var1_"="_loopinit $$$liin(.line) }
.
		#; AK719
		#;  s e=$ZU(70,5,$P(p,",")),l=$L(e)  ;  startln
	if swsw,cat="NAME" { $$$liin("s "_swe_"=$zu(70,5,$p("_start_","","")),"_swl_"=$l("_swe_")") RETURN }
		#; AK719-
		#; AK709
		#;  setup %SW prefix values (*** could be done at OPEN)
		#;      When determining swn (starts with number), we can't just use swn=+swn to determine if it is a number because a string like '1E1234' will give a <MAXNUMBER> error
		#;      Instead, we check if <start> value is "" (in which case it is not a number), or $c(0) collates after <start> (in which case it is a number)
		#;      I also set swn=start first since start is ususally a $select expression we don't need to evaluate more than once.
		#;      swl = startswith length
		#;	swn = startswith number
		#;	swe = startswith encoded
		#;  Notes about $zu(70,5):
		#;	$ZU(70,5,item,[rule]) -- encodes "item" into key
		#;	format using the encoding rule given.  The encoding
		#;	rule is what is returned by $ZU(70,0) or $ZU(70,1). If
		#;	rule is omitted, use the local encoding rule of the
		#;	current collating type.
		#;	If there are no ambiguous characters, then "" is
		#;	returned, otherwise the encode string is
		#;	returned, but with the disambiguouators stripped off
		#;	This can be used to handle %STARTSWITH correctly
		
	if swsw,'numeric,'const { $$$liin("s "_swe_"=$zu(70,5,"_start_"),"_swl_"=$L("_swe_") s "_swn_"="_start_","_swn_"=$s("_swn_"="""":0,1:($c(0)]]"_swn_"))") RETURN }
	if swsw,'numeric,'cnum { $$$liin("s "_swe_"=$zu(70,5,"_start_"),"_swl_"=$L("_swe_")") }
		#; AK709-
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK503
bitstrt	;  Create the appropriate Start Line(s) for bitmap subscript
	#;  qstart=$P(stuff,3) - start val#, start=pti(qstart)
	#;  qistart=$P(stuff,4) - 1 if start inclusive, 0 if not, 2 for %STARTSWITH
	#; AK688
	#; AK570
	#;  id>x:  s id=x s:id<0 id=0 s sub=id+1\64000+1,ch=$g(^I(xx,yy,sub)),lo=id+1#64000,hi=id-lo+1
	i "al"[asc,qistart=0 $$$liin("s "_var1_"="_start_" s:"_var1_"<0 "_var1_"=0 s "_vsb_"="_var1_"+1\64000+1,"_vch_"="_$$getch(vsb,filter)_","_vlo_"="_var1_"+1#64000,"_vhi_"="_var1_"-"_vlo_"+1"_$s($$ebmfilter():","_$$ebmand(vch,vsb),1:"")) QUIT
	#;  id>=x: s id=x s:id<1 id=1 s:id["." id=id\1+1 s sub=id\64000+1,ch=$g(^I(xx,yy,sub)),lo=id#64000,hi=id-lo
	i "al"[asc,qistart=1 $$$liin("s "_var1_"="_start_" s:"_var1_"<1 "_var1_"=1 s:"_var1_"[""."" "_var1_"="_var1_"\1+1 s "_vsb_"="_var1_"\64000+1,"_vch_"="_$$getch(vsb,filter)_","_vlo_"="_var1_"#64000,"_vhi_"="_var1_"-"_vlo_$s($$ebmfilter():","_$$ebmand(vch,vsb),1:"")) s qistart="zbm" QUIT
	#;  id<x:  s id=x s:id<1 id=1 s:id["." id=id\1+1 s sub=id-1\64000+1,ch=$g(^I(xx,yy,sub)),lo=id-1#64000+2,hi=id-lo+1
	i asc="d",qistart=0 $$$liin("s "_var1_"="_start_" s:"_var1_"<1 "_var1_"=1 s:"_var1_"[""."" "_var1_"="_var1_"\1+1 s "_vsb_"="_var1_"-1\64000+1,"_vch_"="_$$getch(vsb,filter)_","_vlo_"="_var1_"-1#64000+2,"_vhi_"="_var1_"-"_vlo_"+1"_$s($$ebmfilter():","_$$ebmand(vch,vsb),1:"")) QUIT
	#;  id<=x: s id=x s:id<0 id=0 s sub=id\64000+1,ch=$g(^I(xx,yy,sub)),lo=id#64000+2,hi=id-lo+2
	i asc="d",qistart=1 $$$liin("s "_var1_"="_start_" s:"_var1_"<0 "_var1_"=0 s "_vsb_"="_var1_"\64000+1,"_vch_"="_$$getch(vsb,filter)_","_vlo_"="_var1_"#64000+2,"_vhi_"="_var1_"-"_vlo_"+2"_$s($$ebmfilter():","_$$ebmand(vch,vsb),1:"")) s qistart="zbm" QUIT
	#; AK570-
	$$$liin("s "_vsb_"="""","_vch_"="""","_vlo_"=1")
	s qistart="zbm"  ;  I think this line can be removed
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
bmvar	;  generate $BITFIND loop over a bitmap chunk in a variable  ;  AK1049
	#;  k1 s lo=$BITFIND(ch,1,lo+1) i 'lo<line1>
	#;   [ s id=hi+lo-1 ]
	i asc="a" $$$liin("s "_vlo_"=$bitfind("_vch_",1,"_vlo_"+1) i '"_vlo_line1)
	#;  k1 s lo=$bitfind(ch,1,$s(lo="":0,lo<=1:-1,1:lo-1),-1) i 'lo <line1> ;  DESC AK1092
	i asc="d" $$$liin("s "_vlo_"=$bitfind("_vch_",1,"_"$s("_vlo_"="""":0,"_vlo_"<=1:-1,1:"_vlo_"-1),-1) i '"_vlo_line1)
	;  *** maybe next line belongs to fields^%qaqcdt
	n idvar s idvar=+$g($$$aslKFlds(mod,1))  ;  optional %ID calculation
	if idvar {
		#; calculate partitioned ID if needed
		n expr s expr=vhi_"+"_vlo_"-1"
		if ptnvars'="" {
			n pfx s pfx=""
			for i=1:1:$l(ptnvars,",")-1 {
				s pfx=pfx_pti($p(ptnvars,",",i))_"_""||""_"
			}
			s expr=pfx_"("_expr_")"
		}
		d vset^%qaqcdt(idvar,expr)  ;  AK1070
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
bit2	;  generate $ORDER/$BITFIND loop for funk=2
	#; AK688
	#;  bitmap subscript, but loop over whole chunks
	i asc["h" {
		$$$liin("s "_$$dorch(var1,pti($p(stuff,$c(1),10)),$tr(asc,"h")_"1",filter)_" i "_var1_"="""" {"_line1_" }")
		i $$ebmfilter() { $$$liin("s "_$$ebmand(pti($p(stuff,$c(1),10)),var1)) }
		if $p(stuff,$c(1),19) {
			n lup,lupN s lup=$$$getVarName("lupN"_+$p(stuff,$c(1),19)),lupN=pti($p($p(stuff,$c(1),19),",",2))
			$$$liin("i "_var1_">("_lup_"*(($o("_ref1_"(""""),-1)+"_lupN_"-1)\"_lupN_")) {"_line1_" }")
		}
		#;  optionally calculate 'hi'  ;  AK1049
		i $p(stuff,$c(1),13) { $$$liin("s "_pti($p(stuff,$c(1),13))_"="_var1_"-1*64000") }
		QUIT
	}
	n optInfo
	i $d($$$aslNextBslTopFilt(mod,2,1,next2),optInfo) || $d($$$aslNextBslRangeFilt(mod,2,1,next2,1),optInfo) {
		n vwinded s vwinded = $$$getVarName("winded"_mod_"n"_next2)
		d initvar^%qaqcasl(vwinded,0)
		//Assume for now these opts all share a tf
		n tempid s tempid = $li(optInfo,1)
		$$$liin("if '"_vwinded_" {")
		$$$liin("   for  {")
		$$$liin("      set "_$$dorch(vsb,vch,1,filter)_" quit:"_vsb_"=""""")
		$$$liin("      set "_$$tfref^%qaqcpre(tempid,1)_vsb_")="_vch)
		$$$liin("   }")
		$$$liin("   set "_vwinded_"=1")
		$$$liin("   set "_vch_"=""""")
		d bsopts(mod,next2)
		$$$liin("}")
		n ref s ref=$$tfref^%qaqcpre(tempid,1)
	}
	n nonul s nonul = +$p(stuff,$c(1),12)=1
	n expr s expr=""
	if ptnvars'="" {
		s expr="s:"_var1_"'=0 "_var1_"="
		for i=1:1:$l(ptnvars,",")-2 {
			s expr=expr_pti($p(ptnvars,",",i))_"_""||""_"
		}
		s expr=expr_var1_" "
	}
	
	#;  k2  f  s lo=$BITFIND(ch,1,lo+1) i lo {s id=hi+lo-1 s:id=0 id="" QUIT} s sub=$o(^I(<subs>,sub),1,ch) QUIT:sub=""  s hi=sub-1*64000
	if "al"[asc $$$liin("f  s "_vlo_"=$bitfind("_vch_",1,"_vlo_"+1) i "_vlo_" { s "_var1_"="_vhi_"+"_vlo_"-1 "_expr_" "_$s(nonul:"continue:"_var1_"=0 ",1:"s:"_var1_"=0 "_var1_"=""""")_" q } s "_$$dorch(vsb,vch,1,filter)_" q:"_vsb_"=""""  s "_vhi_"="_vsb_"-1*64000"_$s($$ebmfilter():","_$$ebmand(vch,vsb),1:""))
	#;  k2  f  s lo=$s(lo=1:0,1:$BITFIND(ch,1,lo-1,-1) i lo {s id=hi+lo-1 s:id=0 id="" QUIT} s sub=$o(^I(xx,yy,sub),-1,ch) QUIT:sub=""  s hi=sub-1*64000,lo=1.4
	if asc="d" $$$liin("f  s "_vlo_"=$s("_vlo_"=1:0,1:$bitfind("_vch_",1,"_vlo_"-1,-1)) i "_vlo_" { s "_var1_"="_vhi_"+"_vlo_"-1 "_$s(nonul:"continue:"_var1_"=0 ",1:"s:"_var1_"=0 "_var1_"=""""")_" q } s "_$$dorch(vsb,vch,-1,filter)_" q:"_vsb_"=""""  s "_vhi_"="_vsb_"-1*64000,"_vlo_"=1.4"_$s($$ebmfilter():","_$$ebmand(vch,vsb),1:""))
	#; AK688-
	#; This is always an integer so no need to check for =""
	if "adl"[asc set condcheck(var1)=""
	$$$liin("i "_vsb_"="""""_line1)  ;  done with this level, go up
	#;  can't use %STARTSWITH to limit looping, just test it
	s:swsw swline="i '"_$$swex(var1,start)_" g "_bottom
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK503-
	#; AK688
getch(vsb,filter="",bit=0)  ;  $$: code to retrieve the actual bitmap string from
	#;  a bit map node subscripted by chunk# vsb, but if filter
	#;  provided, then use the filter method
	QUIT:'filter $s(bit=0:"$g("_$tr(ref,$c(2))_vsb_"))",1:$tr(ref,$c(2))_vsb_")")  ;  MAK4147
	QUIT pti(filter)_".GetChunk("_vsb_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dorch(vsb,vch,dir,filter="")  ;  $$: SET argument to traverse a bit map using
	#;  $ORDER to loop over chunk# vsb in subscript, and to get the actual
	#;  bitmap string from the node into vch, in direction dir=[-]1, but if
	#;  filter provided, then use the filter methods
	QUIT:'filter vsb_"="_"$o("_$tr(ref,$c(2))_vsb_"),"_dir_","_vch_")"
	n ch s ch=$$localvar(1)  ;  by-ref requires an unsubscripted variable
	QUIT ch_"="_vsb_","_vch_"="_pti(filter)_$s(dir=1:".NextChunk(",1:".PreviousChunk(")_"."_ch_") s "_vsb_"="_ch
bsopts(mod,next) [ asl ] public {
	for i=1:1 {
		If $d($$$aslNextBslRangeFilt(mod,2,1,next,i),optInfo) {
			d bsrangefilt^%qaqcpre(.optInfo)
		}
		Else {
			QUIT
		}
	}
	If $d($$$aslNextBslTopFilt(mod,2,1,next),optInfo) {
		d bstopfilt^%qaqcpre(.optInfo)
	}
}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK688-
	#; AK514
ebmfilter()  ;  $$: 1 if chunk filtering using the extent bitmap is needed
	i mapid,$p(mts(qno,str,"MAP",mapid),"^",5)=0 QUIT 1
	QUIT 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ebmand(vch,vsb)  ;  $$: $BITLOGIC to AND extent bitmap vsb chunk into chunk vch
	QUIT vch_"=$bitlogic("_vch_"&"_$$ebmsub(vsb)_")"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
ebmsub(vsb)  ;  $$: extent bitmap node at subscript vsb
	QUIT $$adsub^%qaqcpr($p($$$smdMapCompiledTopLevelPieces($$$smdBitmapExtentMap(1,+$$$mtR(str))),$c(1)),vsb)  ;  AK688
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK514-
	#; From old %aaakey2 ; asl code generation Continuation
startval(ad)  ;  Returns proper starting value for ASCENDING/DESCENDING
	#;               subscript
	if $p(stuff,$c(1),19) {
		n lup,lupN s lup=$$$getVarName("lupN"_+$p(stuff,$c(1),19)),lupN=pti($p($p(stuff,$c(1),19),",",2))
		s start="("_lup_"-1)*(($o("_ref1_"(""""),-1)+"_lupN_"-1)\"_lupN_")"
	}
	#; AK467
	if 'swsw {	// not a %STARTSWITH
		RETURN:$g($$$mtUserDefNullMarkerFlag(mod,+stuff)) start ; IBA097, start from start if there is a user-defined nullmarker
		// This check for the null marker corrects an issue where null values are returned if the start value collates before the null marker
		if $g($$$mtNullMarkerSub(mod,+stuff))'="",start'="""""" { RETURN "$s("_start_"="""":"""","_start_"]]"_$$$mtNullMarkerSub(mod,+stuff)_":"_start_",1:"_$$$mtNullMarkerSub(mod,+stuff)_")" }
		RETURN start
	}
	#; AK646
	i const,("t^"_$c(0))[$$$mtV(qstart) s start="""""",const=0
	e  s start="$s("_start_"=$c(0):"""","_start_"=$c(32,0):"" "",1:"_start_")"
	#; AK646-
	QUIT:ad'="d" start  ;  ASCENDING
	#; AK719
	s qistart="swdesc"  ;  no need to check the initial value if %SW+DESC
	#;  if non-numeric, then append the highest non-null value
	#;  $C(65535/255) on UNICODE/8-bit system - use highest on each system
	QUIT:cat="NAME" "$p("_start_","","")_"_$$genmaxch()
	#; AK719-
	i numeric s const=0 QUIT """ """  ;  DESCENDING numeric sorts must start at the end!!
	#; AK709
	QUIT start_"_"_$$genmaxch()
	#; AK467-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK709
genmaxch()  ;  $$: generated code to get (at run-time) max char = $C(255|65535)
	QUIT "$c($s($zbitget($zversion(0),1):65535,1:255))"
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK709-
nextcond(stuff)  ;  Code-Generate the 'next' Conditions
	#; AK732
	d vsetnm(keycol)  ;  set keycol collations, conversions
	#;  "copy" target(s) - combined/split subscript(s) (ParentRef, %Name)
	s op=$p($p(stuff,$c(1),8),"^",3) f  q:'op  d vsetnm(+op) s op=$p(op,",",2,*)
	#; AK732-
	s op=$p(stuff,$c(1),7)  ; 'next' Conditions
	#; AK853
	QUIT:op=""
	n n,ptisave,rop,rng,rdun s n="",rop=$$$mtV(keycol),rng="",rdun=""
	#; Don't evaluate the same expression more than once in this context
	#;  n cgc d cgcInit^%qaqcasl()  ;  TRW1449  ;  removed by AK1090
	s:$e(rop)="f" rng=$p($g(mts($$$mtRQb($$$mtR($p(rop,"^",2))),$p(rop,"^",2),"RANGE",$p(rop,"^",3))),"^",2)
	f i5=1:1 {  ;  generate more stop-conditions from $P(7)
		QUIT:asc="u"
		s log=$p(op,",",i5)
		QUIT:log=""
		s rop=$$$mtLOperator($$$mtL(log))
		CONTINUE:(rop'["TOP")&&(rng'[(","_log_","))  ;  use TOP or range
		CONTINUE:$$$mtLOperand1($$$mtL(log))'=keycol ; EEE002 < skip generating this stop condition if the TOP condition is not applied to the field f itself (e.g., if it's on an expression of f) >
		s rop=((asc="d")||(asc["-"))_$TR(rop,"TOP:")
		i (rop="0<")||(rop="0'>")||(rop="1>")||(rop="1'<") { ; no "." allowed in `rop` to make sure we use only the first TOP condition
			if $$isACORNon^%qaqpag(m) {
				if mod=$g($$$mtACORN1Mod(m)) {
					// Revert ID variable name to its old original name in pti
					set pti($lg($$$mtACORN1UseVectorMap(m),2)) = $$$mtACORN1OldPTIForiID(m)
				}
			}
			#; Don't pad failed TOP conditions
			$$$liin("i "_$s(padnext:$$$getVarName("oldpad_"_mod)_"=1,",1:"")_"'"_$$cond^%qaqcpr(log)_$s($$padhead^%qaqcasl(mod):" s "_$$$getVarName("pad"_$$padhead^%qaqcasl(mod))_"=0",1:"")_$s($e(line1,1,3)=" g ":line1,1:" g "_line1))
			if $$isACORNon^%qaqpag(m) {
				if mod=$g($$$mtACORN1Mod(m)) {
					set $$$mtACORN1SkippedLines(m)=$g($$$mtACORN1SkippedLines(m))_$lb($o($$$sqline(mod,""),-1))
					// Set ID variable name back to its new name ACORN-1 name
					set pti($lg($$$mtACORN1UseVectorMap(m),2)) = $$$mtACORN1NewPTIForiID(m)
				}
			}
			s $bit(rdun,log)=1  ;  mark condition as done
		}
	}
	#; [DPV5329] f  { s n=$o(%nsvalex(mod,n)) q:n'=+n  s ptisave(n)=pti(n),pti(n)="$s("_pti(n)_"'="_%nsvalex(mod,n)_":"_pti(n)_",1:"""")" }
	#; AK853-
	#; DPV700
	#;
	#; If this subscript uses a NULL Marker, need to translate NULL
	#; Subscript marker values to "" for the next conditions.
	#;
	#; DPV3276
	f i5=1:1 {
		s log=$p(op,",",i5) q:log=""
	#; AK853
		CONTINUE:$bit(rdun,log)  ;  already processed
		$$$liin("i '"_$$cond^%qaqcpr(log)_$s(padnext:" s "_$$$getVarName("oldpad_"_mod)_"=1",1:"")_" g "_bottom)
	#; AK853-
	}
	#; DPV3276-
	#; DPV700-
	#; AK853
	MERGE pti=ptisave  ;  restore the proper variables
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK732
vsetnm(icol)  ;  set unary(icol), but first replace NULL marker, if any
	#;  if NULL-replaced, must use the actual field value
	#; [DPV5329] if $d(%nsvalex(mod,icol)),$$nullreplace^%qaqcct(icol) {
	#; [DPV5329] 	d vset^%qaqcdt(icol,,,$$tonull^%qaqcpr(pti(icol),%nsvalex(mod,icol)))  ;  set icol collations, conversions
	#; [DPV5329] } else {
		d vset^%qaqcdt(icol)  ;  set icol collations, conversions
	#; [DPV5329] }
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK732-
	#; $$ Function - Scratch Column. It Returns 'icol'.
	#;  We assign a scratch column number, and stick into parse tree.
	#;  called from col+2^dat,xpand+2,col+1 *** use macro!
scrcol(ifn,sl2=0,makevar=1,killvar=0) 
	new icol
	set icol=$$$newval("i^"_str_"^"_ifn_$s(sl2:"^S2L^",1:""),0,makevar,"scrcol"_str_":"_ifn_$s(sl2:"S2L",1:""),'cflag,,killvar)
	set $p(mts(qno,str,"ATT",ifn),"^",5)=icol
	QUIT icol
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; Detect if we will be getting the root global node to pull out the data
	#; and so if two piece $data/three piece $order will be useful
needhavar(havar,getvar,alternative) [mt,asl,smdmapid,mod,funk,ndata,ref] {
	#; If the taget ref has changed remove any previous havar and retest
	if $get(havar)'="",$get(havar("ref"))'="",$get(havar("ref"))'=ref do removehavar^%qaqcasl(.havar)
	#; If we already have a havar then we already checked needrow previously
	if $get(havar)'="" {
		#; If we previously got a havar for a temp table do not try resetting it here at all
		if $get(havar("ref"))="" quit 0
		set needrow=1
	} else {
		set needrow=0,fields=$get($$$aslPkFlds(mod,funk,ndata))
		for icol=1:1:$length(fields,",") {
			set field=$piece(fields,",",icol) if field="" continue
			set ifn=$p($$$mtV(field),"^",3),irn2=$$$smdGetIrnFromIfn(+ifn)
			if ifn=""||(irn2="") continue
			if $$expandtrigger(irn2,ifn,field,.trak) set needrow=1 quit
		}
	}
	if needrow {
		if $get(getvar)="" {
			if havar="" set havar=$$$getVarName(alternative)
			set getvar=havar
		} else {
			if havar'="",havar'=getvar do removehavar^%qaqcasl(.havar)
			set havar=getvar,havar("used")=1
		}
		set havar("ref")=ref
	}
	quit needrow
}
#;
#; Based on code in comptrig^%qaqcdt, return 1 if we are getting the data at this node
#; and false otherwise. Follows triggers back to the fields they depend on
expandtrigger(irn2,ifn,icol,trak) [smdmapid] {
	QUIT:$d($$$smd(1,irn2,2,+ifn,51,smdmapid))&&$$ddinsub^%qaqcdt(irn2,ifn,smdmapid) 0
	set x=$o($$$smd(1,irn2,2,ifn,52,smdmapid,""),1,del)
	if x RETURN $case($piece(del,$c(1)),"":1,"%row":1,:0)
	if ifn'["_",$$$smdColComputed(1,irn2,ifn)_$$$smdColComputedAlways(1,irn2,ifn)'="YY" RETURN 0
	if $data(trak(icol)) RETURN 0
	set trak(icol)=""
	set based=$S(ifn["_":+ifn,1:$$$smdColComputedReferencedFields(1,irn2,ifn))
	for i5=1:1 {
		s ifnb=$p(based,",",i5) q:ifnb=""
		s irnb=$$$smdGetIrnFromIfn(ifnb)
		if $$expandtrigger(irnb,ifnb,-ifnb,.trak) RETURN 1
	}
	RETURN 0
}
#;
#; Return true if this table does not use subnodes in storage under the main data node at all
nosubnodes(imp) {
	Set irn=$$$smdMapIrn(imp) Quit:+irn=0 0
	Set type=$$$smdTType(irn) Quit:type="" 0
	Set class=$$$smdClassname(type,irn) Quit:class="" 0
	If ($$$smdCacheStorage(type,irn)=1)&&($$$smdMapMaster(imp)'="Y") Quit 1
	If $$$smdCacheStorage(type,irn)'=1 Quit 0              ; Default storage
	If '$get($$$EXTuseextentset($$$pEXT,class),0) Quit 0   ; Must be USEEXTENTSET
	If $$$smdKids(type,irn)'="" Quit 0                     ; Has child tables
	RETURN 1
}
#;
genstatement(qn, prm, params,dynparam=0,select="select") [mt, pti] {
	#; set or range?
	Set isSet = $d(mt("sql",qn,"set"))
	Set isBit = $d(mt("sql",qn,"bit"))
	#; Generate the select we will use
	set prm="",count=0
	kill params
	set dynparmcount = 2
	Set:isSet dynparmcount = 1
	for parmtype=$g(mt("sql",qn,select_"prm")),$g($$$mtSqlPrm(qn)),$char(0),$g($$$mtSqlGroupPRM(qn)),$g($$$mtSqlOrdPRM(qn)) {
		if parmtype=$char(0) {
			#; Make space for the start,end arguments
			if $increment(params,dynparmcount)
		} else {
			set ptr=0 while $listnext(parmtype,ptr,tmp) {
			#;  evaluate prm - usually "x" entries, but  ;  AK1021
			#;  could be expressions, incl. subqueries, which might
			#;  generate extra lines right here (or in opex)
				set prm=prm_","_$$ptvalue^%qaqcpr(tmp)
				set params($increment(count))="%sqlparm"_$increment(params)
			}
		}
	}
	set prm="$lb("_$extract(prm,2,*)_")"
	#; Pre-TRW1511, this was all in $$$mtSql(qn). This expression should work post-TRW1511 and for pre-TRW1511 frozen plans
	set selfromwhere = $g($$$mtSql(qn))_$g(mt("sql",qn,select))_$g($$$mtSqlFrom(qn))_$g($$$mtSqlWhere(qn))
	#; everything before the %PARTITION conditions
	if (isSet) {
		set statement = selfromwhere_" "_ $$$mtSqlPartitionFunc(qn) _ " = "_$s(dynparam:"?",1:":setval")
	}
	else {
		set statement = selfromwhere_" %PARTITION BY "
		#; build a range condition
		set startParam = $s(dynparam:"?",1:":start")
		set endParam = $s(dynparam:"?",1:":end")
		if isBit {
			set startParam = "(("_startParam_")*64000 - 1)"
			set endParam = "(("_endParam_")*64000 - 1)"
		}
		set statement = statement_$$$mtSqlPartitionFunc(qn)_" > " _ startParam _ " AND "_$$$mtSqlPartitionFunc(qn)_" <= "_endParam_" "
	}
	#; group clause
	set statement = statement _ $s($g($$$mtSqlGroup(qn))'="":$$$mtSqlGroup(qn)_" ",1:"")
	#; order by clause
	set statement = statement _ $s($g($$$mtSqlOrd(qn))'="":$$$mtSqlOrd(qn)_" ",1:"")
	#; Pagination clause LIMIT/OFFSET/FETCH
	set statement = statement _ $s($g($$$mtSqlPagination(qn))'="":$$$mtSqlPagination(qn)_" ",1:"")
	return statement_" /*#OPTIONS {""parallelQuery"":""1""} */"
}
.
paragfuncsupported(qn) [ mt ] public {
	return $g(mt("paragsplit",qn))
}
buildstatement(qn,prm) [mt,pti] {
	Set isSet = $d(mt("sql",qn,"set"))
	Set statement = $$genstatement(qn, .prm, .params)
	return $$generateworker(statement,.params,$s(isSet:"setval",1:"start,end"),,qn)
}
.
buildparagnullfunc() [ mt,code,tagpre ] public {
	RETURN //disabled for now
	if $$paragfuncsupported(1) {
		RETURN
	}
	new code
	d code("(statement, params, maxSplits) public { ")
	d code(" s statement="""" k params")
	d code(" return 0")
	d code(" }")
	set tag=$$subroutn^%qacsub("code",tagpre_"clientParag",,1)
	Set ^||%isc.sql.ClientParallelTag = tag
}
buildparagfunc(qn,gref,start,stop,isBit,isPrefix) [mt,code,tagpre,pti] public {
	RETURN //disabled for now
	if '$$paragfuncsupported(qn) {
		RETURN
	}
	new code
	d code("(statement, params, maxSplits) public { ")
	d code(" s statement="""" k params")
	s startv = ""
	s stopv = ""
	//Only the simplest static bounds (constants) are currently supported.
	//First practical loosening might be simple collation expressions.
	if start,$$$mtVType($$$mtV(start))="t" s startv = $p($$$mtV(start),"^",2,*)
	if stop,$$$mtVType($$$mtV(stop))="t" s stopv = $p($$$mtV(stop),"^",2,*)
	if isBit,startv s startv = (startv\64000)+1
	if isBit,stopv s stopv = (stopv\64000)+1
	s splitstatement = $$genstatement(qn, .prm, .params, 1 /* use ? for new params */, "select1")
	for i=1:1:params {
		if '$d(params(i)) {
			if '$g(startPos) { 
				s startPos = i
			}
			else {
				s endPos = i
			}
		}
	}
	//Replace unique subscript variables in gref with
	//their constant values, assuming xDBC form (the only
	//supported client for parallel factorization)
	s uniqueSubs = $g(mt("paragsplit",qn,"uniqueSubs"))
	for i=1:2:$ll(uniqueSubs) {
		s val = $li(uniqueSubs,i+1)
		s dat = $e($$$mtV(val),3,*)
		s dat = $$$SQLquoter(dat)
		s gref = $replace(gref, pti($li(uniqueSubs,i)), $$appmeth^%qaqcpr(dat,"OdbcToLogical",val))
	}
	d code(" s splits = $$%Split^%SYS.WorkQueueMgr($name("_gref_"),maxSplits,"_$$$quote(startv)_","_$$$quote(stopv)_","_$s(startv="":0,1:isPrefix)_")")
	d code(" if splits="""" return 0")
	d code(" s statement = "_$$$quote(splitstatement))
	d code(" for i=1:1:$ll(splits) {")
	d code("   s params(i,"_startPos_")=$li($li(splits,i),1)")
	d code("   s params(i,"_endPos_")=$li($li(splits,i),2)")
	d code(" }")
	d code(" return 1")
	d code(" }")
	set tag=$$subroutn^%qacsub("code",tagpre_"clientParag",,1)
	Set ^||%isc.sql.ClientParallelTag = tag
}
.
#; Generate worker jobs SQL code, return the tag name
generateworker(statement,params,args="",tblno="",qn) [code,mt,asl] public {
	new code
	set cursorname="p"_$translate($$untag^%qaqcpre(),"%")
	set sqltext=1,sqltext(1)=statement
	#; simply sqlact - we don't need a lot of options regarding compile, etc. only info.
	set sc = $$sqlact^%SYS.ResultSet(.sqltext,"",.mtc2) if $$$ISERR(sc) { Set SQLCODE=$$StatusToSQLCODE^%apiOBJ(sc,.msg) Do SQERror^%apiSQL(242,"Parallel query build error: -"_SQLCODE_" "_msg) }
	merge qinfo=mtc2(0,0)
	GOTO:qinfo("type")'="SEL" genDMLworker
	set addedinto=$$AddInto^%SYS.ResultSet(.sqltext,.qinfo,qinfo("select"),.sqlout,"%sqlout")
	set into="",put=""
	for i=1:1:qinfo("select") set into=into_" :%sqlout"_i_",",put=put_"%sqlout"_i_","
	set into=$extract(into,1,*-1),put=$extract(put,1,*-1)
	do code("("_$select(args="":"",1:args_",")_"args)")
	do code("#include %systemInclude")
	if $$$DebugParallelSQL do code(" n zh s zh=$zh")
	set exref=""
	if $d(mt("sql",qn,"exref")) {
		set tbl=""
		for {
			set tbl=$order(mt("sql",qn,"exref",tbl),1,newtbl) QUIT:tbl=""
			set exref=exref_""""_tbl_""","""_newtbl_""","
		}
		set exref="$lb("_$e(exref,1,*-1)_")"
	}
	do code("#execute d stackvar^%qaqcky("_exref_")")
	set tmpcode=0,return=0
	if $data(params)\10 {
		set return=$$GenExtract^%GenerateExtract(.tmpcode,"",$lb("args","tmp","pos"),.params,"","",$g(%msqlvar)="i%%")
		if return<0 Do SQERror^%apiSQL(242,"Parallel query build error: -1 Unable to generate worker argument extract code")
	}
	do code("	new sc,SQLCODE,%msg,%ROWCOUNT,sqldata"_$piece(",tmp,pos",",",1,return+1)_$select(put="":"",1:","_put)_" set sc=$$$OK")
	if '$$$parAggUsesSharedGlobal(qn) { // EEE016 eliminated the use of IPQs when parallel aggregation uses a shared global
		do code("	new ipq set ipq=$system.Context.WorkMgr().IPQ")
	}
	for i=1:1:tmpcode do code("	"_tmpcode(i))
	if tblno'="" set put=tblno_$select(put="":"",1:","_put)
	set tmp="	&sql(DECLARE "_cursorname_" CURSOR FOR "
	for i=1:1:sqlout {
		set tmp=tmp_sqlout(i)
		if i=sqlout {
			set tmp=tmp_" /*#OPTIONS {""fastFetchPut"":"""_put_"""} */"
				#; here we add in more options we want to propogate from the main query to the parallel query
			if $$$SQLCompileOption("NULLEQUAL")=1 { set tmp=tmp_" /*#OPTIONS {""NULLEQUAL"":1} */" }
			if $$$SQLCompileOption("source-tsql")=1 { set tmp=tmp_" /*#OPTIONS {""source-tsql"":1} */" }
			if $$$SQLCompileOption("ISCShardLocalInsert")=1 { set tmp=tmp_" /*#OPTIONS {""ISCShardLocalInsert"":1} */" } // JMM1035
			set tmp=tmp_")"
		}
		do code(tmp)
		set tmp="	"
	}
	do code("	&sql(OPEN "_cursorname_")")
	do code("	quit:SQLCODE<0 $$$ERROR($$$SQLCode,SQLCODE,$g(%msg))")
	if addedinto {
		do code("	&sql(FETCH "_cursorname_")")
	} else {
		do code("	&sql(FETCH "_cursorname_" INTO "_into_")")
	}
	do code("	if SQLCODE,SQLCODE'=100 { set sc=$$$ERROR($$$SQLCode,SQLCODE,$g(%msg)) }")
	do code("	&sql(close "_cursorname_")")
	do code("	if $$$ISOK(sc),SQLCODE,SQLCODE'=100 { set sc=$$$ERROR($$$SQLCode,SQLCODE,$g(%msg)) }")
	do code("#execute do unstackvar^%qaqcky()")
	if $$$DebugParallelSQL do code(" s ^IRIS.Temp.SQLDebug($i(^IRIS.Temp.SQLDebug))=$lb($zn,zh,$zh-zh,$j,$lb("_$select(args="":"",1:args_",")_"args))")
	do code("	quit sc")
	set tag=$$subroutn^%qacsub("code",$$untag^%qaqcpre(),,1)
	quit tag
genDMLworker  ;  parafile - parallel DML filing  ;  AK1007
	do code("("_$select(args="":"",1:args_",")_"args)")
	do code("#include %systemInclude")
	set exref=""
	if $d(mt("sql",qn,"exref")) {
		set tbl=""
		for {
			set tbl=$order(mt("sql",qn,"exref",tbl),1,newtbl) QUIT:tbl=""
			set exref=exref_""""_tbl_""","""_newtbl_""","
		}
		set exref="$lb("_$e(exref,1,*-1)_")"
	}
	do code("#execute d stackvar^%qaqcky("_exref_")")
	do code("	new ptr,var,sc,ipq,SQLCODE,%msg,%ROWCOUNT,tmp,pos")
	do code("	set ptr=0,sc=$$$OK,ipq=$system.Context.WorkMgr().IPQ")
	if $data(params)\10 {
		set return=$$GenExtract^%GenerateExtract(.tmpcode,"",$lb("args","tmp","pos"),.params,"","",$g(%msqlvar)="i%%")
		if return<0 Do SQERror^%apiSQL(242,"Parallel query build error: -1 Unable to generate worker argument extract code")
		for i=1:1:tmpcode do code("	"_tmpcode(i))
	}
		#; here we add in more options we want to propogate from the main query to the parallel query
	set options=""
	if $$$SQLCompileOption("NULLEQUAL")=1 { set options=options_" /*#OPTIONS {""NULLEQUAL"":1} */" }
	if $$$SQLCompileOption("source-tsql")=1 { set options=options_" /*#OPTIONS {""source-tsql"":1} */" }
	if $$$SQLCompileOption("ISCShardLocalInsert")=1 { set options=options_" /*#OPTIONS {""ISCShardLocalInsert"":1} */" } // JMM1035
	do code("	&sql("_statement_options_")")
	do code("	s:%ROWCOUNT ipq.Value=$c(0,0,0,0,0,0,0,0,2)_$lb(%ROWCOUNT,%ROWID)")
	do code("	if SQLCODE,SQLCODE'=100 { set sc=$$$ERROR($$$SQLCode,SQLCODE,$g(%msg)) }")
	do code("#execute do unstackvar^%qaqcky()")
	// This is a special case ONLY for %parallel code.  The statement uses %sqldata## public variables instead of arrays for performance,
	// but the %sqldata## variables are not cleaned up by cursor close.  We clean them up here.
	// *** actually we might not need this for INSERT/UPDATE/DELETE
	do code("	quit sc")
	set tag=$$subroutn^%qacsub("code",$$untag^%qaqcpre(),,1)
	KILL $$$aslAct($$$mtPLastASLModule($$$mtP(1)),1)  ;  don't need "output" ACTION here (probably should be done somewhere else)
	quit tag
}
stackvar(exref) public {
	set %msqlvarstack($increment(%msqlvarstack))=$listbuild(%msqlvar,%msqlvarcparm,%caller,%switch,%sqlmode)
	if $g(exref)'="" {
		merge %msqlvarstack(%msqlvarstack,0)=%ISCSNRemoteTables
		for i=1:1:$ll(exref)/2 {
			s tab=$li(exref,i*2) // JMM1073+
			if $d(%ISCSNRemoteTables(tab))=1 {
				set table($li(exref,i*2-1))=%ISCSNRemoteTables(tab)
			}
			elseif $d(%ISCSNRemoteTables(tab,"alias")) {
				s rebalInProgress=1
				set alias=%ISCSNRemoteTables(tab,"alias")
				set table(tab,"alias")=alias
				if $d(%ISCSNRemoteTables(alias)) {
					set table($li(exref,i*2-1))=%ISCSNRemoteTables(alias)
				}
			} // JMM1073-
		}
		kill %ISCSNRemoteTables
		merge %ISCSNRemoteTables=table
	}
	set %msqlvar="sqldata",%msqlvarcparm="%sqlparm",%switch="Logical",%sqlmode="parallel"
	kill %caller
	set %sqlParallelInfo=%0SQLCompileLevel	// %sqlParallelInfo will be killed in %qaqqt in case their is more non-parallel recursion.
}
unstackvar() public {
	set tmp=%msqlvarstack(%msqlvarstack)
	if $data(%msqlvarstack(%msqlvarstack,0))\10=1 {
		kill %ISCSNRemoteTables
		merge %ISCSNRemoteTables=%msqlvarstack(%msqlvarstack,0)
	}
	if $increment(%msqlvarstack,-1)=0 { kill %msqlvarstack } else { kill %msqlvarstack(%msqlvarstack+1) }
	kill %msqlvar,%msqlvarcparm,%caller,%switch,%sqlmode set $lb(%msqlvar,%msqlvarcparm,%caller,%switch,%sqlmode)=tmp
	kill %sqlParallelInfo
}
 #; JSL5056 - with Aviel's help
 #; JSL5068 - don't allow set with no left hand side
adset(into,from)	        ;  add a SET argument to the line
	s line=line_","_into_"="_from QUIT:$l(line)'>$$$complength
setin	s:$E(line,2,*)'="" line="s "_$E(line,2,*) $$$liin(.line) QUIT ;  add line with many SETs
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
#; Turn indirect hybrid temp file reference into a $select which is faster at runtime
hybridsel(str,tempid) [mt] public {
	if tempid="" RETURN str
	If $g($$$mtTrefTempFile(tempid))'="" { RETURN str } // Return shared global if it's used in parallel aggregation
	Set tf=$g($$$mtTrefTfNode(tempid))
	if tf="" RETURN str
	set tfvar="@"_$$$getVarName("hybtfn"_tf)_"@("
	if str'[tfvar RETURN str
	set tfref=$$tfref^%qaqcpre(tf,1,2),hybtf=$$$getVarName("hybtf"_tf) ; readWriteMode=2 to indicate that we want to use a PPG reference in case it's a non-DISTINCT hybrid temp-file (because it's what the $select below returns when "i%hybtfn1=""^""")
	#; tfref has trailing ',' so update the hybrid reference similarly
	if $e(hybtf,*)=")" { set hybtf=$e(hybtf,1,*-1)_"," } else { set hybtf=hybtf_"(" }
	RETURN "$s($e("_$e(tfvar,2,*-2)_")=""^"":"_$replace(str,tfvar,tfref)_",1:"_$replace(str,tfvar,hybtf)_")"
}
#;
#; See if we can use the global iterator to walk this temp table, always looking at asl(mod,2)
useIterator(mod,ndata,tempid,smdmapid,havar) [asl,mt,funk] public {
	RETURN:($zu(115,2)'=0)&&($$$mtKNoLockFlag($g($$$mtK))'=1) "" ; if we are not using default READ UNCOMMITTED isolation level and the query does not have %NOLOCK keyword, quit. $o get fresh data, while glb iter get static a block of data
	RETURN:funk'=2 ""
	RETURN:$$$GlobalIteratorRowsThreshold=-1 "" ; -1 means disable global iterator
	RETURN:('tempid)&&('smdmapid) ""
	set stuff=$$$aslKId(mod,ndata)
	RETURN:$p($g($$$asl0OnePassGroupBy(mod)),"^",2) "" ; not for AK988 'one-pass grouping' ('opg') optimization, test: SQL/dynamicSQL/queryoptimization/DAB/y2021/DAB012,  asl(2,0,"opg")=7,11,^4^24  ;  start aggregation from "next" subscript 4
	if tempid {
		RETURN:$g(%msqlvar)'="i%%" ""   ; Only use this in class context (which should always be the case anyway)
		RETURN:$$$asl0StartLoopSuppr($g($$$asl0(mod))) ""  ; Group skipping loop at last level (we could use iterator and adjust depth, but it will be inefficient compared with $order anyway)
		set tempid=$p(stuff,$c(1),3)
		set buildaction=$g($$$aslAct($p(tempid,"^"),$p(tempid,"^",2)))
		RETURN:$$$aslActAction(buildaction)'="b" ""  ; Should not be needed, but check we have the build action
		set tf=$$$aslActTfToBuild(buildaction)
		set tableinfo=$$$mtTempFile(tf)
		RETURN:($p(tableinfo,"^",16))||($p(tableinfo,"^",12)) ""  ; Bitmap temp file or hybrid/local temp file
	} else {
		if $p(stuff,$c(1),7)'="" { 
			set m = $p(stuff,$c(1),7)
			RETURN:$g($$$mtFromList(m))=$lb("%TSQL_sys.snf") "" ; there is no FROM clause in this query
			RETURN:$d($$$mtDistinct(m)) "" ; distinct query 
			RETURN:($d($$$mtGroupDistinctList(m)))&&($$$mtPAggList($$$mtP(m))="") "" ; group by query but no aggreation, in this case we should not loop through whole glb
		}
		RETURN:'$d($$$smd(12,smdmapid)) "" ; virtual map created by nuimp/clonemap
		set irn=$$$smdMapIrn(smdmapid)
		set ttype=$$$smdTType(irn)
		RETURN:$$$smdCacheStorage(ttype,irn)'=1 "" ; YCL475 must be default storage
		RETURN:$$$smdIsATVF(1,irn) ""	; "next" subroutine for a table valued function  ;  DPV4186
		RETURN:'$$isTuned^%qaqpsq(irn) "" ; check if this table has been tuned
		if $$$smdMapFromThisTable(smdmapid) { 
			set extentSize=$$$smdExtentSize(ttype,irn)
			set superIrn=""
		} else {; map comes from super class, we need the extent size for the super class, since the index glb is in the super class
			set classname=$$$smdClassname(ttype,irn)
			set mapname=$$$smdMapName(smdmapid)
			set originclass=$$getMapSuperClass(classname,mapname)
			RETURN:originclass="" ""
			$$$comClassKeyGetLvar(schema,originclass,$$$cCLASSsqlschemaname)
			$$$comClassKeyGetLvar(table,originclass,$$$cCLASSsqltablename)
			set iqn=$$$BuildIQN(schema,table)
			set irn=$$$smdLoadGetIrn(iqn)
			set ttype=$$$smdTType(irn)
			RETURN:$$$smdIsATVF(1,irn) ""	; "next" subroutine for a table valued function  ;  DPV4186
			RETURN:'$$isTuned^%qaqpsq(irn) "" ; check if this table has been tuned
			set extentSize=$$$smdExtentSize(ttype,irn)
			set superIrn=irn
		}
		RETURN:extentSize<$$$GlobalIteratorRowsThreshold "" ; check the extent size for this table
		RETURN:$$estimateGILoopRows(mod,ndata,extentSize,superIrn)<$$$GlobalIteratorRowsThreshold ""  ; if we just loop thourgh very few rows in this loop, ignore global iterator
		RETURN:$$$IsVectorSearchIndex(smdmapid) "" ; not for vector search index (speical next code)
	}
	#; See if all loops are ascending order and are simple no conditions
	set constantDepth=0,constantDepthInt=0,depth=0,depthInt=0,hasASC=0,hasSVIC=0
	for  {
		set depth = $o($$$aslKNext(mod,ndata,depth),1,next) quit:depth=""
		do $I(depthInt)
		if smdmapid {
			RETURN:$case($$$smdMSAccessType(smdmapid,depthInt),"Piece":1,"List":1,:0) "" ; test: SQL/dynamicSQL/CacheSQLStorage/DPV2131
			set nxtcode=$$$smdMSOverrideNextCode(smdmapid,depthInt) 
			RETURN:($ll(nxtcode)=1)&&($lg(nxtcode)="s {S1}=$s(1]]{S1}:1,1:"""")") "" ; select LAST_IDENTITY() ROWID from %TSQL_sys.snf  mt(from) = $lb("%TSQL_SYS.SNF")
			RETURN:($$$smdMSOverrideNextCode(smdmapid,depthInt)'="") "" ;  "next" subroutine override
			RETURN:$$$smdMSOverrideDataExpression(smdmapid,depthInt)'="" "" ; test: SQL/filer/DPV4943
			if "uc"[$p(next,$c(1),2) {
				RETURN:(constantDepthInt'=(depthInt-1)) "" ; cannot have constant/unique value as the subscript we are iterating through
				d $I(constantDepthInt) 
				set constantDepth = depth 
				continue
			} else {
				RETURN:$$$smdMSLoopInitValue(smdmapid,depthInt)'="" "" ; this map should not have LoopInitValue
				RETURN:($$$smdMSStopValue(smdmapid,depthInt)'="")||($$$smdMSStopExpression(smdmapid,depthInt)'="") "" ; this map should not have StopValue/StopExpression in the subscript we are iterating through
				if ($$$smdMSStartValue(smdmapid,depthInt)'="")||($ll($$$smdMSOverrideInvalidCondition(smdmapid,depthInt))) { 
					; this map should not have StartValue/OverrideInvalidCondition in the subscript (except last subscript) we are iterating through
					RETURN:hasSVIC ""
					set hasSVIC=1
				}
			}
		}
		RETURN:($p(next,$c(1),2)'="a")&&($p(next,$c(1),2)'="l") ""  ; Not ascending order
		set:($p(next,$c(1),2)="a")&&('hasASC) hasASC=1
		
		RETURN:($p(next,$c(1),11)'="") ""  ; Not bitmapsubcript or bitslice "power" subscript 
		
		if $p(next,$c(1),12)'="" { ; test and skip the NULL (-substitute) in this subscript 
			RETURN:$p(next,$c(1),12)=1 ""
		}
		RETURN:($p(next,$c(1),7,11)'=$c(1,1,1,1))&&($p(next,$c(1),7,11)'="") "" ; No other conditions
		
		RETURN:($p(next,$c(1),13,17)'="")&&($p(next,$c(1),13,17)'=$c(1,1,1,1)) "" ; No other conditions
		RETURN:($p(next,$c(1),19,*)'="") "" ; No other conditions
		
		; if there are start(4) or end(6) condition, the limit type should be 0:exclusive, 1:inclusive, 5: exclusive (partition), or 6: inclusive (partition)
		; this should always the first subscript below the 'global' name provided
		RETURN:($p(next,$c(1),4)'="")&&(($CASE($p(next,$c(1),4),0:0,1:0,5:0,6:0,:1))||(depthInt'=(constantDepthInt+1))) "" 
		RETURN:($p(next,$c(1),6)'="")&&(($CASE($p(next,$c(1),6),0:0,1:0,5:0,6:0,:1))||(depthInt'=(constantDepthInt+1))) "" 
	}
	RETURN:hasASC=0 "" ; there has be at least one looping type="a", we don't want to use GI for: asl(3,2,1,"next",1)="51"_$c(1)_"u"... asl(3,2,1,"next",2)="97"_$c(1)_"l" 
	set depthInt=depthInt-constantDepthInt,iterflag=0
	RETURN:depthInt=0 "" ; for parq, for example, asl(2,2,1,"id")="map"_$c(1)_"4"_$c(1,1,1,1)_"1"_$c(1)_"1"   asl(2,2,1,"parq")="5,1,"
	set depth = $o($$$aslKNext(mod,ndata,constantDepth),1,next)
	if ($p(next,$c(1),4)'="") {
		set limitType = $p(next,$c(1),4)
		set:limitType>4 limitType = limitType-5
		set iterflag = iterflag + $case(limitType,0:2,:0)
		set startVal = $p(next,$c(1),3) ; start value
		set needFirstVal='(limitType=0)
	}
	if ($p(next,$c(1),6)'="") {
		set limitType = $p(next,$c(1),6)
		set:limitType>4 limitType = limitType-5
		set iterflag = iterflag + $case(limitType,0:4,:0)
		set endVal = $p(next,$c(1),5) ; end value
	}
	#; We are going ahead with global iterator code generation now
	#; Do we need the data code
	if $g($$$aslKFlds(mod,ndata)) { 
		if smdmapid {
			set needrow=0,fields=$get($$$aslPkFlds(mod,funk,ndata))
			for icol=1:1:$length(fields,",") {
				set field=$piece(fields,",",icol) if field="" continue
				set ifn=$p($$$mtV(field),"^",3),irn2=$$$smdGetIrnFromIfn(+ifn)
				if ifn=""||(irn2="") continue
				if $$expandtrigger(irn2,ifn,field,.trak) set needrow=1 quit
			}
		} else {
			set needrow = 1
		}
		if needrow {
			do removehavar^%qaqcasl(.havar)
			set havar=$$$getVarName("node"_mod_"val"_2_ndata)
		} else {
			set iterflag=iterflag+1
		}
	} else {
		set iterflag=iterflag+1
	}
	set itvar=$$$getVarName("itoref"_mod_$s(ndata=1:"",1:"x"_ndata)),cookie=$$$getVarName("itcookie"_mod_$s(ndata=1:"",1:"x"_ndata))
	if depthInt>1 {
		set itlevel=$$$getVarName("itlevel"_mod_$s(ndata=1:"",1:"x"_ndata))
		set:$g(needFirstVal) itfirstval=$$$getVarName("itfirstval"_mod_$s(ndata=1:"",1:"x"_ndata))
	}
	#;------------------------------------------------------------------------------
    #; $LIST(...) Elements returned from useIterator(...)
	#; --------------------------------------------------
	#;   1. depthInt     // The number of subscripts to iterate over
	#;   2. iterflag     // A bit mask specified with the following bit values:
	#;                        1. If set, the 'GetNext()' method will not be 
	#;                           passed a return data value argument
	#;                        2. If set, the start range is exclusive; Otherwise,
	#;                           the start range is inclusive
	#;                        4. If set, the end range is exclusive; Otherwise,
	#;                           the end range is inclusive
	#;   3. itvar        // The name of the scratch variable used for the 
	#;                      Global Iterator: ##class(%Iterator.Global).%New(...)
	#;   4. cookie       // The name of the scratch variable used for the
	#;                      Global Iterator cookie: .getzu113Cookie()
	#;   5. line1        // The text of the line for where to go if failed (for example, line1=" g %0AmBdun") 
	#;						to be used for code-generation
	#;   6. lines        // The 'line' within the 'sqline(mod,line)' array used
	#;                      used for "i '$zu(113,i%itcookie2,..." code-generation 
	#;   7. ref1         // The root node reference of the global to be used
	#;                      for the Global Iterator
	#;   8. startVal     // The optional start value from which to start iterating
	#;   9. endVal       // The optional end value to which to iterate to
	#;	 10. itlevel		// The number of subscripts it iterated over and 0 if it is at the end of the range/global
	#;	 11. itfirstval		// The boolean to indicate if this is the first value in the loop
	#;------------------------------------------------------------------------------
	//            1        2      3      4   567       8           9         10            11
	RETURN $lb(depthInt,iterflag,itvar,cookie,,,,$g(startVal),$g(endVal),$g(itlevel),$g(itfirstval))
}
.
/// This function is called by useIterator
/// Estimate how many rows we would scan for this loop
estimateGILoopRows(mod,ndata,extentSize,superClsIrn="")[asl,mt,mts] public {
	set sub="",rows=extentSize
	for {
		set sub=$o($$$aslKNext(mod,ndata,sub),1,loop)
		quit:sub=""
		continue:'$lf($lb("a","u"),$p(loop,$c(1),2)) // only care about a and u type
		set val=$p(loop,$c(1),1)
		if ((val'="") && ($$$mtVType($$$mtV(val))="f")) {
			set ifn=$p($$$mtV(val),"^",3),str=$p($$$mtV(val),"^",2)
			set irn=+$$$mtR(str),m=$$$mtRQb($$$mtR(str))
			if ($p(loop,$c(1),2)="u") {  // if this index is from super class, we need the sel of this field in the super class
				if superClsIrn="" {
					if $data(mts(m,str,"CON",ifn)) {
						set sel=+mts(m,str,"CON",ifn)
					} else {
						try{ // get selectivity
							set sel=$p($g(mt("ptv",val)),"^",$$$PTVCONEQLSEL)
							set:sel="" sel=+$$ddfldst2^%qaqpqo(str,ifn)
						} catch { 
							RETURN 0 
						}
						// take care of outlier sel
						set osel=$$$smdColOutlierSelectivity($$$smdTType(irn),irn,ifn)
						if osel'="" {
							set osel=$lg(osel)
							set sel=osel*osel+((1-osel)*sel) // bias to the outlier sel
						}
					}
				} else {
					set fName=$$$smdGetFieldName(+ifn),superTtype=$$$smdTType(superClsIrn)
					set superIfn=$$$smdGetIfn(superTtype,superClsIrn,fName)
					RETURN:superIfn="" 0
					if $data(mts(m,str,"CON",ifn)) { // if there is a CON, and the sel is outlier, and sub cls and super cls share the same outlier value
						set sel=+mts(m,str,"CON",ifn)
						set osel=$$$smdColOutlierSelectivity($$$smdTType(irn),irn,ifn)
						if (osel'="")&&(sel=$lg(osel)){
							set superOSel=$$$smdColOutlierSelectivity(superTtype,superClsIrn,superIfn)
							if (superOSel'="")&&($lg(osel,2)=$lg(superOSel,2)) { // same outlier, we should use outlier sel in super cls
								set rows=rows*$lg(superOSel,1)
								continue
							}
						}
					} 
					set vals=$$$smdColSelectivity(superTtype,superClsIrn,superIfn) // vals=1/sel copy from ddfldst2
					RETURN:vals="" 0 // no selectivity
					RETURN:(vals="NUMROWS")||($$$smdColUnique(superTtype,superClsIrn,superIfn)="Y") 1 
					if $e(vals,1,8)="NUMROWS/" {
						set vals=+$p(vals,"NUMROWS/",2) 
						set vals=$s(vals'>1:extentSize,extentSize>vals:extentSize/vals,1:1)
					} 
					set sel=1/vals
					set osel=$$$smdColOutlierSelectivity(superTtype,superClsIrn,superIfn)
					if osel'="" {
						set osel=$lg(osel)
						set sel=osel*osel+((1-osel)*sel) // bias to the outlier sel
					}
					
				}
				RETURN:sel="" 0 
				set rows=rows*sel
			} elseif (($p(loop,$c(1),3)'="") || ($p(loop,$c(1),5)'="")) { // range condition
				if ($p(loop,$c(1),4)>4)||($p(loop,$c(1),6)>4) {
					// if exclusive (partition) or inclusive (partition)
					// should only appear on 1 sub
					set rows=rows/$s($g(mt("numsplits",m))="":$zutil(204,5),1:mt("numsplits",m))				
				} else {
					// normal range condition
					// if there is a super class, we have no information about range sel
					// so we still use the range sel for sub class
					set rows=rows*(+$g(mts(m,str,"RANGE",ifn),1)) 
				}
			}	
		}
	}
	RETURN rows
}
.
#define ArgsPerLine 100
#define addtoprms(%prmval, %prmreadval) Set prm=prm_%prmval_",",prmcounts=prmcounts+1,prmread=prmread_%prmreadval_$s(prmcounts#$$$ArgsPerLine=0:$c(1),1:",")
.
 #; This function sets prm, prmread and argstoset
 #; 	prm="$lb(var)": a string of a list of parameters that needs to be passed to the worker instances
 #;     prm="$lg(var)": a string of a list of parameters that the worker instances will receive from the parent process
 #; 	argstoset=$lb(): a list of variables that needs to be set in the worker open code
 #;     defvars = 1 or 0: when defvars is 1, we are running this function only for generating code that defines variables in prms (if needed) before code generating RunWork2 (e.g. subquery calls). when defvars is 0, we are running this function to find the complete lists of argstoset, prm and prmread
generateWorkerArgs(qn, argstoset, prm, prmread,defvars = 0)[mt,opex,pti,mcurs,asl,%fastivar,%classname,sqline,lines] private {
	; mostly copied from genstatement
	Set select = "select"
	Set varlist = $$findprm^%qaqpagg(qn)
	Set ptr=0 While $listnext($g($$$mtAPESharedParentVars(qn)),ptr,vidx){
		Set:'$lf(varlist,vidx) varlist = varlist_$lb(vidx)
	}
	Set $$$mtAPESharedParentVars(qn) = varlist 
	Set argstoset="", prm="$lb(",prmread = "",prmcounts = 0
.
	Set ptr=0 While $listnext(varlist,ptr,vidx) {
		If $p($p($$$mtV(vidx),"^",2),":",1)="SET",vidx'=$g(mt("sql",qn,"set")) {
			Set:'$lf(argstoset,vidx) argstoset=argstoset_$lb(vidx)
		} elseif ($p($$$mtV(vidx),":",1)="v^USERDEFINEDFUNCTION") {
			Set:'$lf(argstoset,vidx) argstoset=argstoset_$lb(vidx)
		} else {
			if ($$$mtVType($$$mtV(vidx))="t") && (($e($$$mtV(vidx),3,*) = pti(vidx))||((""""_$replace($e($$$mtV(vidx),3,*),"""","""""")_"""") = pti(vidx))||($e(pti(vidx))="$")||(pti(vidx)="""""")) {
				Continue
			}
			if ($g(%classname)'="")&&('$data(%fastivar(%classname,2,pti(vidx)))) {
				set %fastivar(%classname,2,pti(vidx))=""
			}
			If defvars {
				// we are running this function to generate code that defines variables in prms (if needed) before code generating RunWork2
				Set ptiexpr = $$ptvalue^%qaqcpr(vidx)
				if ptiexpr'=pti(vidx) {
					$$$liin("Set "_pti(vidx)_"="_ptiexpr)
				}
			} else {
				if $$$mtV(vidx) = "i^once"{
					// initialize "once" variables from once^%qaqcpre to "" for workers
					$$$addtoprms("""""",pti(vidx))
				} else {
					$$$addtoprms(pti(vidx),pti(vidx))
				}
			}
			
		}
		// add the "once" variables for subquery calls to prm
		if $$$mtVType($$$mtV(vidx))="q" {
			$$$addtoprms($$$getVarName("subonce"_vidx),$$$getVarName("subonce"_vidx))
		}
		
	} 
	
	Return:defvars // no need to run the rest of the code if defvars=1
.
	// add variables that are defined in opex
	Set opexx = opex 
	Set $E(opexx)=""  ;  remove leading ","
	Set opexx=$$reverse^%qaqcasl(opexx)  ; Reverse this string so things are defined
	For i=1:1:$l(opexx,","){
		Set tempIdx = $p(opexx,",", i)
		If tempIdx {
			If $p($p($$$mtV(tempIdx),"^",2),":",1)="SET",tempIdx'=$g(mt("sql",qn,"set")) {
				Set:'$lf(argstoset,tempIdx) argstoset=argstoset_$lb(tempIdx)
			} elseif ($p($$$mtV(tempIdx),":",1)="v^USERDEFINEDFUNCTION") {
				Set:'$lf(argstoset,tempIdx) argstoset=argstoset_$lb(tempIdx)
			} Elseif '$lf(varlist, tempIdx) {
				$$$addtoprms(pti(tempIdx),pti(tempIdx))
				Set varlist=varlist_$lb(tempIdx)
			}
		}
	}
.
	Set controlvars = ""
	// pass control variables needed by this query block
	Do qbcontrolvars(qn,.controlvars)
	for i=1:1:$ll(controlvars) {
		$$$addtoprms($lg(controlvars,i),$lg(controlvars,i))
	}
.
	If $$$SQLStatsFlagON {
		$$$addtoprms($$$getVarName("action-flag-run"),$$$getVarName("action-flag-run"))
		$$$addtoprms($$$getVarName("statsJob"),$$$getVarName("statsJob"))
		$$$addtoprms($$$getVarName("statsNS"),$$$getVarName("statsNS"))
		$$$addtoprms($$$getVarName("collect-flag-bits"),$$$getVarName("collect-flag-bits"))
	}
.
	// Cached query classes for DynamicSQL INSERT/UPDDATE/DELETE queries sometimes uses a class method 
	// %Execute to do the work, so no need to create new Cached query class instances in these cases 
	Set prm=prm_$s((($$$SQLCompileOption("DynamicQuery")'=1)&&($$$SQLCompileOption("DynamicSQL")=1)&&("INS UPD DEL"[$$$mtStatementType)):")",1:"$system.CLS.GetORefContext($this))")
	Set prmread= $e(prmread,1,*-1)
.
	Return
}
.
setcontrolvars(controlvars,var) private {
	Set:'$lf(controlvars,var) controlvars=controlvars_$lb(var)
}
.
qbcontrolvars(m,controlvars,issubquery=0) [mt, asl, mcurs] private {
.
	// find the ASL module numbers of any shared ASL modules used in this query block
	Set beginmd = $s(issubquery:$$$mtPFirstASLModule($$$mtP(m)),1:$$$topWorkerModule(m))
	Set endmd = $s(issubquery:$$$mtPLastASLModule($$$mtP(m)),1:$$$bottomWorkerModule(m))
	Set sharedmods =""
	For md=beginmd:1:endmd {
		set ntry=""
		For {
			Set ntry=$o($$$aslAct(md,ntry),1,action)
			Quit:ntry=""
			If $p(action,$c(1))="s" {
				Set smod=$p(action,$c(1),2)
				Set:'$lf(sharedmods,smod) sharedmods=sharedmods_$lb(smod)
			} 
		}
	}
.
	For tf=1:1:$g($$$mtLatestTempFileNum) {
		set tfinfo = $g($$$mtTempFile(tf))
		// If the module is not a worker's module then the temp-file won't be returned as one of the parameters. However, when 
		// we are using a shared global in parallel aggregation then we need to pass the shared global temp-file name as a control 
		// variable since the workers will populate it in parallel
		if issubquery || $$$isWorkerModule($p(tfinfo,"^",2),m) || (tf=$$$getParAggSharedTf(m)) || $lf(sharedmods,$p(tfinfo,"^",2)) {
			// temp-file indices for global and $SORT temp-files that are not PPGs
			If ($$glotf^%qaqcpre(tf)&&($p(tfinfo,"^",20)||$lf(sharedmods,$p(tfinfo,"^",2))))||($p(tfinfo,"^",6))||$g($$$mtSharedGlobalTf(tf)) do setcontrolvars(.controlvars,$$$getVarName("tablenum"_tf))
			// We need to send i%hybtfn variables for post-EEE019 hybrid temp-files (p1'="dist" / non-DISTINCT statements)
			if $$hybtfForNonDistinct^%qaqcpre(tf) {
				do setcontrolvars(.controlvars,$$$getVarName("hybtfn"_tf))
			}
		}
	}
.
	if $data(mt("querylock",m)){
	#; pass the isolation mode variables to workers when needed
		do setcontrolvars(.controlvars,$$$getVarName("isolationMode"))
		set str=""
		f  {
			s str=$o(mt("querylock",m, str)) q:str=""
			if 'mcurs {
				do setcontrolvars(.controlvars,$$$getVarName("lockstat_"_m_"_"_str))
			}
			do setcontrolvars(.controlvars,$$$getVarName("%delock_"_m_"_"_str))
		}
	}
.
	if $$ASLhasVerify(m,issubquery) {
		do setcontrolvars(.controlvars,$$$getVarName("isolationMode"))
	}
.
	set ASLwithDSN = $$ASLwithDSN(m,issubquery)
	For jj=1:1:$ll(ASLwithDSN) do setcontrolvars(.controlvars,$$$getVarName("hstmt"_$li(ASLwithDSN,jj))) 
.
	// add the variables needed by shard extended global reference
	For str =1:1:$$$mtRNumStreams { // JMM1222+
		If $$$mtRQb($$$mtR(str))=m {  // JMM1222-
			if $d(mt("shref",str)) {
				do setcontrolvars(.controlvars,$$$getVarName("shref"_mt("shref",str)))
			}
			// JMM1222 add the variables needed for extent locations for cross-sharded joins of tables under conversion 
			// to/from sharded
			if $d(mt("extentloc",str)) { // JMM1222+
				s suffix=$o(mt("extentloc",str,""))
				while suffix'="" {
					do setcontrolvars(.controlvars,mt("extentloc",str,suffix))
					s suffix=$o(mt("extentloc",str,suffix))
				}
			} // JMM1222-
		}
	}
.
	// add variables needed by subquery blocks that is directly udner this query block
	for qn=1:1:$$$mtPNumQbs {
		if $$$mtPQbIsActive(qn), m'=qn,(+$$$mtP(qn)=m) {
			do qbcontrolvars(qn, .controlvars,1)
		}
	}
}
.
.
 #; return 1 if the worker modules for this query block has a "verify" ASL entry, 0 otherwise
ASLhasVerify(m,issubquery) [asl,mt] private {
	Set startmod = $s(issubquery:$$$mtPFirstASLModule($$$mtP(m)),$$$useAPE(m):$$$topWorkerModule(m),1:$$$mtPFirstASLModule($$$mtP(m)))
	Set endmod = $s(issubquery:$$$mtPLastASLModule($$$mtP(m)),$$$useAPE(m):$$$bottomWorkerModule(m),1:$$$mtPLastASLModule($$$mtP(m)))
	For mod=startmod:1:endmod {
		For pk = 1:1:4 {
			Set ndata = ""
			For {
				Set ndata = $o($$$aslPk(mod,pk,ndata),1)
				Quit:ndata=""
				If $data($$$aslPostkeyReadVerifiedConds(mod,pk,ndata)) {
					Return 1
				}
			}
		}
	}
	// check if corrrelated subqueries have verify 
	for subm = (m+1):1:$$$mtPNumQbs {
		if ($$$mtPQbIsActive(subm)) && ($$$mtCorrParentQb(subm)=m) && $$ASLhasVerify(subm,1){
			Return 1
		}
.
	}
	Return 0
}
.
 #; return a list of ASL modules that have DSN loops
 #; code referenced gendsn^%qaqcmh
ASLwithDSN(m,issubquery)[mt,asl]{
	Set ans = ""
	Set startmod = $s(issubquery:$$$mtPFirstASLModule($$$mtP(m)),$$$useAPE(m):$$$topWorkerModule(m),1:$$$mtPFirstASLModule($$$mtP(m)))
	Set endmod = $s(issubquery:$$$mtPLastASLModule($$$mtP(m)),$$$useAPE(m):$$$bottomWorkerModule(m),1:$$$mtPLastASLModule($$$mtP(m)))
	For mod=startmod:1:endmod {
		For pk = 1:1:4 {
			Set:$g($$$aslRoot(mod,pk))="dsn" ans=ans_$lb(mod)
		}
	}
	// include any DSN modules in subquery 
	for subm = (m+1):1:$$$mtPNumQbs {
		if $$$mtPQbIsActive(subm), (+$$$mtP(subm)=m) {
			Set ans = ans_$$ASLwithDSN(subm,1)
		}
	}
	Return ans
}
.
#; Build the %SQLparallel<m> tag for the APE worker processes 
buildAPEparagfunc
	Return:'$d($$$mtAPERoot)
	New qn,SQLparallalTag,SQLparallelCallLine,prm,argstoset, prmread, callmod, callline, prmvar
	Set qn = ""
	For {
		Set qn = $o($$$mtAPEQbNode(qn))
		Quit:qn=""
		Set callmod = $p(mt("APE",qn,"ParCallLoc"),"^",1), callline = $p(mt("APE",qn,"ParCallLoc"),"^",2)
		Set SQLparallelCallLine = sqline(callmod, callline)
		Set SQLparallalTag = "$$"_$$generateSQLparallel(qn,.prm,.argstoset,.prmread)
		Set SQLparallelCallLine = $replace(SQLparallelCallLine,"$${APEtag"_qn_"}",SQLparallalTag)
		if $l(prm)>$$$complength {
			set prmvar=$$prmLengthHandler(prm)
			Set SQLparallelCallLine = $replace(SQLparallelCallLine,"{parameters"_qn_"}",prmvar)
		} else {
			Set SQLparallelCallLine = $replace(SQLparallelCallLine,"{parameters"_qn_"}",prm)
		}
		Set sqline(callmod, callline) = SQLparallelCallLine
	}
prmLengthHandler(prm)
	// Check if the prm string composed of "$lb(...)" is too long
	// Specifically handle these cases with incremental lines, setting a local variable to the $lb()
	n prmentries, prmline, prmvar
	set prmentries=$e(prm,5,*-1)
	set prmvar=$$localvar(1)
	set sqline(callmod, $o(sqline(callmod, callline),-1)+0.01)=" . s "_prmvar_" = """""
	set prmline=" . s "_prmvar_" = "_prmvar_"_$lb("
	for prmi=1:1:$length(prmentries,",") {
		if $l(prmline_$p(prmentries,",",prmi))>$$$complength {
			set sqline(callmod, $o(sqline(callmod, callline),-1)+0.01)=$e(prmline,1,*-1)_")"
			set prmline=" . s "_prmvar_" = "_prmvar_"_$lb("_$p(prmentries,",",prmi)_","
		} else {
			set prmline=prmline_$p(prmentries,",",prmi)_","
		}
	}
	s sqline(callmod, $o(sqline(callmod, callline),-1)+0.01)=$e(prmline,1,*-1)_")"
	return prmvar
 #; add a new tag %SQLparallel_m(begin, end, args)
generateSQLparallel(m,prm,argstoset, prmread)
	Do generateWorkerArgs(qn, .argstoset, .prm,.prmread)
	New APEcode Set APEcode = 0
	New parset Set parset=$g(mt("sql",m,"set"))
	Set APEcode($i(APEcode)) = $s(parset:"(setIdx,args)",1:"(begin,end,args)")
	; find the query parameters
.
	If (($$$SQLCompileOption("DynamicQuery")'=1)&&($$$SQLCompileOption("DynamicSQL")=1)&&("INS UPD DEL"[$$$mtStatementType)) {
		// Cached query classes for DynamicSQL INSERT/UPDDATE/DELETE queries uses a class method 
		// %Execute to do the work, so no need to generate RunWork method 
		do GenerateParCode("APEcode", m,argstoset, prmread)
	} else {
		Set APEcode($i(APEcode)) ="	Return $system.CLS.NewObj($lg(args,*))."_gtag_"RunWorker"_m_$s(parset:"(setIdx,args)",1:"(begin,end,args)")
		; Build RunWorker method for Adaptive Parallel Execution (APE)
		Do buildRunWorkermethod(qn, $get(%classname), argstoset, prmread, .methodstoadd)
	}
	Return $$subroutn^%qacsub("APEcode",gtag_"SQLparallel"_m,,1)
.
 #; add a method RunWorker_m(begin, end, args) to the cached query class 
buildRunWorkermethod(m, class, argstoset, prmread, methodstoadd)
	Return:(class="")||($extract($get(%caller),1,8)="ShowPlan")
.
    new method Set method = gtag_"RunWorker"_m
	Set methodstoadd = methodstoadd_$lb(method)
.
	$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHorigin,class)
	$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHclassmethod,0)
	$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHrunnable,1)
	if cflag {
		// do not generate this method as a procedure block for cursorless cases
		$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHprocedureblock,1)
	}
	 
	#; sepcify the types of the input arguments; this method has no output
	if $g(mt("sql",m,"set")){
		$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHuseractualtype,"%Library.String,%Library.String")
		$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHformalspecparsed,$lb($lb("setIdx","%Library.String","",""),$lb("args","%Library.String","","")))
	} else {
		$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHuseractualtype,"%Library.String,%Library.String,%Library.String")
		$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHformalspecparsed,$lb($lb("begin","%Library.String","",""),$lb("end","%Library.String","",""),$lb("args","%Library.String","","")))
	}
	$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHreturntype,"%Library.Status")
.
	New parcode Set parcode = 0
	do GenerateParCode("parcode", m,argstoset, prmread)
	for i=1:1:parcode {
		$$$comSubMemberSet(class,$$$cCLASSmethod,method,$$$cMETHimplementation,i,parcode(i))
	}
	$$$comMemberKeySet(class,$$$cCLASSmethod,method,$$$cMETHimplementation,parcode)
	Return
.
/// Return 1 if subqb is a sub-query block of mainqb, 0 otherwise
isSubQueryBlock(mainqb,subqb)[mt] {
	Return:(mainqb>=subqb) 0 
	Set m=subqb
	While m>0 {
		Set m = +$g($$$mtP(m))
		Return:m=mainqb 1
	}
	Return 0
}
 #; GenerateParCode generates the open, entry and close code for the parallel worker, and stored the generated code in ref
GenerateParCode(ref, m, argstoset, prmread)[mt, pti, gtag, cflag, sqlidxhash, opflag, sqline, cgc, xtVFlds] PUBLIC {
	Set @ref@($i(@ref)) = $char(9)_"try {"
.
	if 'cflag {
		// add a line of code to new the variables used if cursorless 
		Set @ref@($i(@ref)) = $char(9)_$Char(9)_"n sc,err"
		Set opennewline = @ref
	}
.
	if $g(mt("sql",m,"bit"))||$g(mt("APE",m,"BitmapExtentClassOref")) {
		Set @ref@($i(@ref)) = $char(9)_$Char(9)_"Set "_$$$getVarName("startIdx"_m)_" = $s(begin="""":"""",1:begin*64000), "_$$$getVarName("endIdx"_m)_" = $s(end="""":"""",1:end*64000)"
	} elseif $g(mt("sql",m,"set")){
		Set @ref@($i(@ref)) = $char(9)_"Set "_$$$getVarName("setIdx"_m)_" = setIdx"
	}
	else {
		Set @ref@($i(@ref)) = $char(9)_$Char(9)_"Set "_$$$getVarName("startIdx"_m)_" = begin, "_$$$getVarName("endIdx"_m)_" = end"
	}
.
	#; open code 
	Set @ref@($i(@ref)) =$Char(9)_$Char(9)_"// open code for this parallel subquery"
	Set @ref@($i(@ref)) =$Char(9)_$Char(9)_"Set SQLCODE=0, sc=$$$OK"
.
	// Setting cursor variable to non-numerical value "ParallelWorker" to skip closing code in %OnClose
	If $$$comClassArrayDefined(%classname, $$$cCLASSinstancevar, "%CursorNumber") Set @ref@($i(@ref)) = $Char(9)_$Char(9)_"s i%%CursorNumber=""ParallelWorker"""
	If $$$comClassArrayDefined(%classname, $$$cCLASSinstancevar, "%qacn") Set @ref@($i(@ref)) = $Char(9)_$Char(9)_"s i%%qacn=""ParallelWorker"""
.
	If $l(prmread){ //otherwise prmread="", so nothing to set here
		if $l(prmread,$c(1)) = 1 {
			Set @ref@($i(@ref)) = $Char(9)_$Char(9)_"Set $lb("_prmread_")=args"
		} else {
			Set currargidx = 1
			for k=1:1:($l(prmread,$c(1))-1) {
				Set @ref@($i(@ref)) = $Char(9)_$Char(9)_"Set $lb("_$p(prmread,$c(1),k)_")=$list(args,"_currargidx_","_(currargidx+$$$ArgsPerLine-1)_")"
				Set currargidx = currargidx+$$$ArgsPerLine
			}
			Set @ref@($i(@ref)) = $Char(9)_$Char(9)_"Set $lb("_$p(prmread,$c(1),*)_")=$list(args,"_currargidx_",*)"
		}
	}
.
	// If there are virtual fields derived from x (parameter) or t (constant) node, initialize them here
	for prmIDX=1:1:$ll($g($$$mtAPESharedParentVars(m))) {
		set inner=$li($$$mtAPESharedParentVars(m),prmIDX)
		for xtVFldIDX=1:1:$ll($g(xtVFlds(inner))) {
			Set @ref@($i(@ref)) =$Char(9)_$Char(9)_"Set "_pti($li(xtVFlds(inner),xtVFldIDX))_"="_pti(inner)
		}
	}
.
	// set the variables in argstoset in the open code in vidx order
	For i=1:1:$ll(argstoset) {
		Set orderedArgstoset($lg(argstoset,i)) = 1
	}
	n cgc d cgcInit^%qaqcasl()  ;  AK1090
	set vidx = ""
	For {
		Set vidx = $o(orderedArgstoset(vidx))
		Quit:vidx=""
		do setVarWorker(ref, vidx, opflag)
	}
.
	; initialize global temp files 
	Set tflist = ""
	for tf=1:1:$g($$$mtLatestTempFileNum) {
		Set tfmod = $p($g($$$mtTempFile(tf)),"^",2)
		// Also skip if it's a shared global temp-file in some query block
		if $$glotf^%qaqcpre(tf),'$g($$$mtSharedGlobalTf(tf)),($$$isWorkerModule(tfmod,m)||($$isSubQueryBlock(m, $p($g($$$mtTempFile(tf)),"^",5)))||(+tfmod&&$$isSubQueryBlock(m, $$findqn^%qaqplan(tfmod)))),'($$isParAggSharedTf^%qaqpag(tf)) {
			Set isPPG = ('$$$mtTfRealGlobalFlag($$$mtTempFile(tf)))
			If isPPG {
				Set @ref@($i(@ref)) = $Char(9)_$Char(9)_"set "_$$$getVarName("tablenum"_tf)_"=$i("_$$$tFileQ_")"
			}
			Set @ref@($i(@ref)) = $Char(9)_$Char(9)_"if $g("_$$$getVarName("tablenum"_tf)_")'="""" kill "_$s($$$mtTfRealGlobalFlag($$$mtTempFile(tf)):$$$tGlobalQ,1:$$$tFileQ)_"("_$$$getVarName("tablenum"_tf)_")"
			Set tflist = tflist_$lb(tf)
		}
	}
.
	// --- Initialize & Push 'Application Metadata Stack' (AMS) Information ---
	do InitAMSInfoWorker(ref)
	if $$$SQLPushAMSInfo { // --- Push AMS & Enable Process Interrupts ---
		set @ref@($i(@ref))=$c(9,9)_$$$PushAMSSQLInfoQ($$$getVarName("AMSInfo"),1)_"  // Push AMS & Enable Process Interrupts!"
	}
.
	#; call entry tag
	Set @ref@($i(@ref)) = $Char(9)_$Char(9)_"// call entry tag for workers"
	Set workerTopModule = $$$topWorkerModule(m)
	Set @ref@($i(@ref)) = $Char(9)_$Char(9)_"Do "_$select(workerTopModule=1:gtag_"first",1:$$modpre^%qaqcasl(workerTopModule)_"Mod")
	Set @ref@($i(@ref)) = $Char(9)_"} catch err {}"
.
	#; close code
	Set @ref@($i(@ref)) =$Char(9)_"// close code for this parallel subquery"
	Set @ref@($i(@ref)) = $Char(9)_"Set:$g(SQLCODE)'<0 SQLCODE=0"
	Set @ref@($i(@ref)) = $Char(9)_"If (SQLCODE'=0 &&(SQLCODE'=100)) Set sc=$system.Error.FromSQLCode(SQLCODE,$g(%msg))"
	; close temp files if they were allocated; copied from closetmp^%qaqcasl
	for i=1:1:$listlength(tflist) {
		Set tf = $lg(tflist,i)
		Set @ref@($i(@ref)) = $Char(9)_"if $g("_$$$getVarName("tablenum"_tf)_")'="""" kill "_$s($$$mtTfRealGlobalFlag($$$mtTempFile(tf)):$$$tGlobalQ,1:$$$tFileQ)_"("_$$$getVarName("tablenum"_tf)_")"
	}
	// JMM1326 Close any shard worker groups
#if 1 // Re-enable JMM1326
	if $d(mt("shtab")) {
		Set @ref@($i(@ref)) = $Char(9)_"Set sc2=$$propagateDisconnect^%SYS.SHARDSRV() Set:sc=1 sc=sc2"
	}
#endif
.
	// temperory walkaround for https://usjira.iscinternal.com/browse/DP-412273
	// this line is needed as sometimes i%CursorState is defined for worker processes by $VOPs
	If cflag Set @ref@($i(@ref)) = $Char(9)_"Kill:$data(i%CursorState) i%CursorState"
.
	#; throw error (if any)
	Set @ref@($i(@ref)) = $Char(9)_"throw:$data(err) err"
.
	#; return code
	Set @ref@($i(@ref)) = $Char(9)_"// return to parent process"
	Set @ref@($i(@ref)) = $Char(9)_"If $$$ISOK(sc),SQLCODE'=0,SQLCODE'=100 Set sc=$system.Error.FromSQLCode(SQLCODE,$g(%msg))"
	Set @ref@($i(@ref)) = $Char(9)_"RETURN sc"
.
	#; If cursorless, complete the line of code that new variables (if necessary)
	If 'cflag,$p($$$sqline(1,1),"n ",2)'="" {
		Set @ref@(opennewline) = @ref@(opennewline)_","_$p($$$sqline(1,1),"n ",2)
	}
}
.
#; add code to compute val in the opening code for woker processes
setVarWorker(ref, val, opflag)
	new sqline,expr,modmun,lino,line
	set opflag = 0
	set sqline = ""
	set expr =  $$ptvalue^%qaqcpr(val)
	if expr '= $g(pti(val)) {
		Set @ref@($i(@ref)) = $Char(9)_"Set "_pti(val)_"="_expr
	} else {
		Set modmun = ""
		for {
			Set modmun = $o(sqline(modmun))
			Quit:modmun=""
			Set lino = ""
			For {
				Set lino = $o(sqline(modmun,lino),1,line)
				Quit:lino=""
				Set @ref@($i(@ref)) = $Char(9)_line
			}
		}
	}
	Return
.
/// MRP1309/MRP1310/MRP1312/MRP1317/MRP1321
/// Modified the 'Application Metadata Stack' (AMS) Information from: InitAMSInfo^%qaqcasl
InitAMSInfoWorker(ref) [codecontainer,mt,pti,rtname,sqlidxhash] PUBLIC {
	QUIT:'$$$SQLPushAMSInfo  // Don't Initialize/Modified 'Application Metadata Stack' (AMS) Information!
	
	set isShardLocalQuery=$g(mt("options","shardLocalQuery"),0)
	set isParallelSubQuery=2 // set to 2 (means this is an APE parallel subquery) here, unlike in InitAMSInfo^%qaqcasl ; YCL162
	set SQLStatementID=$LG($LG(sqlidxhash,2),6)
	set appMetadataStackIDQ="$LB("""_$$$AMSApplicationIDSQL_""","_SQLStatementID_")"
	set serverInfoListQ="$LB($USERNAME,"_$$$quote($zu(110)_":"_$g(^%SYS("SSPort")))_")"
	set queryInfoListQ="$LB("_$$$quote($s($g(%caller)="":"EmbeddedSQL",1:%caller))_","_isParallelSubQuery_","_isShardLocalQuery_","_$$GetType^%SYS.SQLSRV($g($$$mtStatementType))_")"
	set cachedQueryNameQ=$s($g(%classname)'="":$$$quote(%classname),$g(rtname)'="":$$$quote(rtname),$g(codecontainer)="RTN":"$zn",1:"$classname()")
	set callerNameQ=$$$quote($LG($g($$$CQ("QueryRoutine",$s($g(%classname)'="":%classname,1:"*"))),15))
	
	// $LIST(...) Positions:                     1                       2                   3                  4                          567 8                                                  9   10                       11                   12           13  14
	set line="set "_$$$getVarName("AMSInfo")_"=$LB("_appMetadataStackIDQ_","_serverInfoListQ_","_queryInfoListQ_","_$$$quote($lg(sqlidxhash))_",,,,$LG(##class(%SYSTEM.Context).WorkMgr().WorkData)"_",,"_$$$quote($namespace)_","_cachedQueryNameQ_","_callerNameQ_","_","_")"
	if line'="" { Set @ref@($i(@ref)) = $Char(9)_$Char(9)_line }
	RETURN
}
/// Populate the 'AMSInfo' metadata string with the WQM's 'groupId' and 'groupIdAllList'
/// before pushing this metadata string back onto the 'Application Metadata Stack' (AMS)
/// 
/// PARAMETERS:
///   prefix       - The prefix value to be concatenated to the beginning of the line
///                  that is passed to the $$$liin(...) MACRO/Method that defines
///                  the array of lines to be code-generated for the Cached Query
///   groupId      - The variable that holds the value of the 'groupId' used for
///                  processing Parallel SQL Queries via the WQM.
///   groupIdLevel - The level at which the 'groupId' value is being processed.
///                  Namely, the number associated with the WQM Helper Group that
///                  has been processed via the following method invocation:
///                    %RunWork2^%SYS.WorkQueueMgr(...)
///
///                  For the first invocation, this parameter value will be 1, for
///                  the second invocation this parameter value will be 2, and so on
///                  and so on.
///                  This parameter value should ONLY be specified directly after
///                  code-generating the line invoking the aforementioned invocation
///                  of the '%RunWork2^%SYS.WorkQueueMgr(...)' method; Otherwise,
///                  this parameter value should not be specified, or passed the 
///                  empty string ("").
///
UpdateGroupId(prefix="",groupId="",groupIdLevel=0) [lines,mod,mt,qn] PUBLIC {
	QUIT:'$$$SQLPushAMSInfo  // Don't Update 'Application Metadata Stack' (AMS) Information!
	
	set amsInfo=$$$getVarName("AMSInfo")
	set amsInfoLine=prefix_"set $LIST("_amsInfo_","_$$$AMSSQLWQMGroupIDPos_")="_groupId  // Set 'groupId' into the $$$getVarName("AMSInfo") $LIST(...)!
	
	if groupIdLevel { // --- Record a $LIST(...) of All 'groupId' Values Processing a Parallel SQL Query via the WQM ---
		set amsInfoLine=amsInfoLine_",$LIST("_amsInfo_","_$$$AMSSQLWQMGroupIDAllListPos_")=$LG("_amsInfo_","_$$$AMSSQLWQMGroupIDAllListPos_")_$LB("_groupId_")"  // Set the 'groupIdAllList' into the $$$getVarName("AMSInfo") $LIST(...)!
	}
	$$$liin(amsInfoLine)
	$$$liin($$$PushAMSSQLInfoQ(amsInfo,1)_"  // Push AMS & Enable Process Interrupts!")
	set:$g(qn) mt("groupId",qn)=mod_"^"_lines_"^"_groupId  // Record the location for the current AMS Push with the metadata containing the 'groupId' value!
}
.
/// YCL341 - Get the super classname that holds the global for this map (if this map is not from this class)
getMapSuperClass(classname, mapname) PUBLIC {
	set superclass=$g($$$EXTroot($$$pEXT,classname))
	if superclass="" {  ; YCL465: get parent class for collection child table
		$$$comMemberKeyGetLvar(sqlcollectiontable,classname,$$$cCLASSparameter,"SQLCOLLECTIONTABLE",$$$cPARAMdefault)
		If sqlcollectiontable="A"||(sqlcollectiontable="L") {
			Set parent=$$$EXTparent($$$pEXT,classname)
			If parent'="" {
				Set superclass=$$$EXTPROPtype($$$pEXT,classname,parent)
			}
		}	
	}
	return:superclass="" ""
	return:$$$getClassType(superclass)'=$$$cCLASSCLASSTYPEPERSISTENT ""
	return:$$$comClassKeyGet(superclass,$$$cCLASSnoextent) ""
	set mapinfo=$$$EXTSQLMAPsqlinfo($$$rEXT,superclass,mapname)
	return:mapinfo="" ""
	return:$$$SQLLocMapFromThisTable(mapinfo) superclass
	return $$getMapSuperClass(superclass, mapname)
}
/// Get fake vector search field val from asl next loop
///	VDF = Vector Distance Function
/// for partition table, also get true nexting loop level for vdf, a $lb() of parition keys, bucket id and row id
getFakeVDF(mod,ndata,&vdfNext="",&patitionKeys="",&bucketId="",&rowIdVal="") [asl,mt,pti] PUBLIC {
	set irn = +mt("r",$$$aslIdStrNum($$$aslKId(mod,ndata)))
	set ttype = $$$smdTType(irn)
	set classname = $$$smdClassname(ttype,irn)
	set numPartitionKey=$ll($$getPartitionKeyFromCom^%occPartition(classname))
	set sub="", subCount=0,uSubCount=0,patitionKeys="",vdfVal="",found=0
	for  {
		set sub = $o($$$aslKNext(mod,ndata,sub),1,next) quit:sub=""
		if ",a,d,u,"[(","_$$$aslNextLoopingType(next)_",") {
			do $I(subCount)
			do:$p(next,$c(1),2)="u" $I(uSubCount)
			RETURN:('numPartitionKey) +next
			if subCount<=numPartitionKey {
				set patitionKeys=patitionKeys_$lb(pti(+next))	
			} elseif subCount=(numPartitionKey+1) {
				set bucketId=pti(+next)
			} elseif subCount=(numPartitionKey+3) {
				set rowIdVal=+next
			}
		}
		if ('found)&&(subCount>$s(numPartitionKey=0:numPartitionKey,1:numPartitionKey+1)) {
			set vdfNext=subCount-uSubCount,vdfVal=+next,found=1
		}
	}
	RETURN vdfVal
}
/// Used to disable ACORN if no conditions were found other than TOP
/// Returns 1 if a non-TOP condition is found; returns 0 otherwise
hasNonTOPconditions(mod,ndata) [asl,mt] PUBLIC {
	// Process all POSTKEY entries to get the list of conditions under asl(mod,3,item,"cond")
	set itemPostKey=""
	for {
		set itemPostKey=$o($$$aslPk(mod,3,itemPostKey))
		QUIT:itemPostKey=""  // No more 'item' values!
		CONTINUE:$g($$$aslPkConds(mod,3,itemPostKey))=""  // Skip entries that don't have any Query Condition Specifications!
		// Scan the conditions
		set condition = ""
		set conditionPtr = 0
		while $LISTNEXT($LFS($$$aslPkConds(mod,3,itemPostKey)),conditionPtr,condition) {
			CONTINUE:condition=""
			CONTINUE:($e($$$mtLOperator($$$mtL(+condition)),1,3)="TOP")
			// Found a non-TOP condition
			RETURN 1
		}
	}
.
	// Process all KEY "next" conditions stored in p7 of the "next" subscript entry
	set nextSubscript = ""
	for {
		set nextSubscript=$o($$$aslKNext(mod,ndata,nextSubscript))
		QUIT:nextSubscript=""  // No more 'nextSub' values!
		// Scan the conditions
		set condition = ""
		set conditionPtr = 0
		while $LISTNEXT($LFS($$$aslNextAdditionalCondsOnSubscript($$$aslKNext(mod,ndata,nextSubscript))),conditionPtr,condition) {
			CONTINUE:condition=""
			CONTINUE:($e($$$mtLOperator($$$mtL(+condition)),1,3)="TOP")
			// Found a non-TOP condition
			RETURN 1
		}
	}
.
	RETURN 0
}
