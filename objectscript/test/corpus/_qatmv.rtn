====
qatmv
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qatmv^MAC^^^0
%qatmv	// setup MV tables in ^SMD for MV queries (Aviel 5/31/2k5)
	;; COMPONENTS :: SQL/MV
	#;
#include %msql
#IF 0   ;-------------------------------------------------------------
	; Description:   API to setup MV tables in ^SMD for MV queries 
	; Author:        Aviel Klausner
	; Date Started:  May 31, 2005
	;
	;  JPL1627 (12/11/2013) - MV API: use ID rather than ITEMID for computed field
	;  AK815   (06/07/2011) - MV API: Generate MVSVASS table info for CMQL
	;  AK814   (06/03/2011) - MV API: Fix collations with truncation
	;  AK812   (04/28/2011) - MV API: Allow specifying #blocks per map
	;  DPV3788 (02/18/2011) - SQL: optimistic CC - Corrected issue with "fake" tables for MV
	;  AK781   (07/19/2010) - MV API: Allow fields in child computation
	;  AK780   (07/12/2010) - MV API: Child correlated computed fields
	;  AK655   (09/08/2006) - MV API: Use private smd global
	;  AK643   (02/09/2006) - MV API: Add support for indexes
	;  AK642   (01/30/2006) - MV API: Add support for general mapping
	;  AK641   (01/13/2006) - MV API: Add support for collations
	;  AK636   (10/24/2005) - MV API: Node/piece/delim for child table
	;  AK635   (10/20/2005) - MV API: Add support for computed fields
	;  AK634   (07/12/2005) - API for setting MV tables in ^CacheTempSMD
	;                         (routine created)
	;-------------------------------------------------------------
	#;  This extremely simple API enables you to generate any
	#;  MV table needed when translating MVB queries
	#;  This API loads the entire table definition into the temporary
	#;  $$$smd() structure, with fake irn/ifn/imp values.
	#;	MVCRT(tname,gname,numrows)  ;  create MV table
	#;	MVCRC(tname,gname,numrows,part,fname,sel,node,piece,del,comp,coll)  ;  create MV child table
	#;	*** for now, child supports only a single control field
	#;	MVCRF(tname,fname,sel,node,piece,del,comp,coll)  ;  create MV field
	#;	MVCRI(tname,gname,itype,flist,colist,nlist)  ;  create MV index
	#;	$$MVFILEI(gname,idvar,rowvar,atpos,itype,nlist)  ;  MV index SET code
	#;	MVRMT(tname)  ;  remove MV table
	#;  Note:  gname, node, del are all "quoted" values (code-gen-ready)
#ENDIF  ;-------------------------------------------------------------
	QUIT  ;  Not an Entry
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mvcomp(rtn)  ;  set up ^SMD for MV tables in examples and compile routine rtn
	n i s i=$zu(68,28,0) k $$$smdRoot d $zu(68,28,i) s $$$smdRoot=$namespace
	d mvbuild,^%qarmac(rtn)
	s i=$zu(68,28,0) k $$$smdRoot d $zu(68,28,i) s $$$smdRoot=$namespace
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mvbuild	;  set up ^SMD for MV tables in examples - each table in the
	;  examples can be created with a subset of the following lines:
	d MVCRT("T",$LB("^D.MV(""V63"")"),10000)
	d MVCRF("T","AT1",5000,"",1,"$MVAM")
	d MVCRF("T","AT2",5000,"",2,"$MVAM")
	d MVCRF("T","AT3",5000,,"","","$$a^b({ID})")  ;  computed field
	d MVCRC("C",$LB("^D.MV(""V63"")"),30000,"T","AT1",12000,"",1,"$MVAM")
	d MVCRF("C","AT2",12000,"",2,"$MVAM")
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
MVCRT(tname,gname,numrows,blocks=3600) [] PUBLIC {  ;  set up ^SMD for MV table MV.tname
	s:'$d($$$smdRoot)#2 $$$smdRoot=$namespace
	d table(tname,gname,numrows,"",,,,,,,,blocks)
	QUIT
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
MVCRC(tname,gname,numrows,part,fname,sel,node="",piece="",del="",comp="",coll="EXACT",blocks=3600) [] PUBLIC {  ;  set up ^SMD for MV child table MV.tname
	s:'$d($$$smdRoot)#2 $$$smdRoot=$namespace
	d table(tname,gname,numrows,part,fname,sel,node,piece,del,comp,coll,blocks)
	QUIT
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
table(tname,gname,numrows,part,fname,sel,node,piece,del,comp,coll,blocks) PUBLIC {  ;  set up ^SMD for MV table MV.tname
	s qtn="MV."_tname s:'$g(numrows) numrows=100000
	s irn=$i($$$smd("tcnt"))
	s invi=$lg(gname,2),nxtc=$lg(gname,3),fref=$lg(gname,4),gname=$lg(gname),cons=0
	i gname'="" s:$e(gname)'="^" gname="^"_gname s:$e(gname,*)=")" $e(gname,$l(gname))="" s gname=gname_$s(gname["(":",",1:"("),cons=$l(gname,",")-1  ;  #constant subscripts
	#; Define table defintion
	;  *** Note: upper case assumed!
	s $$$smd("rv",qtn)=qtn_$c(1)_irn_$c(1)_1_$c(1,1,1,1,1,1,1)_"10:qatmvW02"
	s idifn=$i($$$smd("fcnt"))
	d field(tname,"ID",irn,idifn,1)
	#; Define master map MVTS
	s imp=$i($$$smd("mcnt"))
	s $$$smd(1,irn,"map","MVTS",imp)="MVTS"
	i cons f cons=1:1:cons s $$$smd(12,imp,6,cons)=$LB(,$p($p(gname,"(",2,*),",",cons),,$p($p(gname,"(",2,*),",",cons),,,,"Sub")
	i $i(cons)  ;  {ID} following constant subscripts
	s $$$smd(12,imp)=$lb("MVTS",$p(gname,"("),"Y",1,"D",1,"I",,1,"N",,,,,fref,$lb($$$NULLSubscriptMarkerq),blocks,blocks,,,,,cons,cons,1,"Y",,,,,,,,$s(gname="":"",1:gname_"%d(1))"_$c(1)_gname_$c(6)_qtn_$c(5)_"ID"_$c(6)_")"_$c(1)),,,,"D",irn)
	s $$$smd(1,irn,2,idifn)=$LB("ID",1,"Y","%Library.String","N","Y",50,"NUMROWS","E","VARCHAR",0,0,0,,"N",,,,"N",,,,,,"Y",$LB("ITEMID"),,,"%%ID",0)
	set $$$smd(1,irn,33)=""	// Class compile timestamp, "" since there is no class  ;  DPV3788
	GOTO:part'="" child
	s idk=$i($$$smd("fcnt"))
	d field(tname,"ITEMID",irn,idk,2)
	s $$$smd(1,irn)=$LB("MV",tname,qtn,"_SYSTEM",numrows,$h,"N",0,"ID","Y",idk,idk,0,1,1,,,,,,"MVTS",0,$s(gname="":"",1:gname_$c(1)_")"),qtn,idifn,imp,,,,"30:qatmv")
	s $$$smd(12,imp,6,cons)=$LB("ID",,,"{"_idifn_"}",,,,$s(gname="":"Other",1:"Sub"),,$$$NULLSubscriptMarkerq,,invi,$s(gname="":"",1:$LB("s {S"_cons_"}=$o("_gname_"{S"_cons_"}))","q:{S"_cons_"}=""""")),nxtc,,,,,idifn)
	s $$$smd(12,imp,8.5,1)=$lb(idk,"{S"_cons_"}")
	s $$$smd(1,irn,2,idifn,51,imp,cons)=irn
	s $$$smd(1,irn,2,idk)=$LB("ITEMID",2,"Y","%Library.String","N","Y",50,"NUMROWS","E","VARCHAR",0,0,0,,"N",,,,"N",,,,,,,,,,"ITEMID",0)
	s $li($$$smd(1,irn,2,idifn),26)=idk	// Update smdColRecIDBasedFields with proper ifn
	d MVCRF(tname,"%RECORD",numrows\1.1)
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
child	;  set up ^SMD for MV child table MV.tname
	s part="MV."_part,pirn=$p($$$smd("rv",part),$c(1),2),pinfo=$$$smd(1,pirn),pidk=$li(pinfo,12)
	;  *** should remove gname argument, use information stored in parent!
	s $$$smd(1,pirn,20)=$G($$$smd(1,pirn,20))_$LB(qtn)  ;  children
	s par=$i($$$smd("fcnt")),csub=$i($$$smd("fcnt")),att=$i($$$smd("fcnt"))
	d field(tname,"PAR",irn,par,0)
	d field(tname,"CHILDSUB",irn,csub,2)
	d field(tname,fname,irn,att,3,coll)
	s $$$smd(1,irn)=$LB("MV",tname,qtn,"_SYSTEM",numrows,$h,"N",0,"ID","Y",par_","_csub,pidk_","_csub,0,"1^2","1^2",part,,part,$LB($LB("PAR",0,part)),"PAR","MVTS",0,$s(gname="":"",1:gname_"$P("_$c(1)_",""||"")"_$s(node="":"",1:","_node)_")"),qtn,idifn,imp,,,,"30:qatmv")
	s $$$smd(1,irn,23)="^"_par_",0,"_part_"^"
	;  *** Note:  might have to remodify parent table!!!
	;             e.g.:  smd(12),$P(36)=$LB($LB(MV.C,MVTS))
	;  *** Note:  $LI(24,25,34) (and other parts) for now support
	;             numeric node and no piece (=old global structure), and
	;      piece and no node (=current global structure).  Eventual
	;      future global structure of multiple attributes per node
	;      would have both node and piece
	s:gname'="" gname=gname_"{S"_cons_"}"
	#;  gname->$LI(13) (unused) in case a field specifies 'node'  ;  AK780
	s $$$smd(12,imp,6,cons)=$LB("ITEMID",,,"{"_pidk_"}",,,,$s(gname="":"Other",1:"Sub"),,$$$NULLSubscriptMarkerq,,invi,gname,nxtc,,,"MV",$E(part,4,*),pidk)
	s $$$smd(1,pirn,2,pidk,51,imp,cons)=irn
	s ilev=cons+1,svar="{S"_ilev_"}"  ;  for {childsub}
	#;  gname is now the whole row
	i gname'="" s:node'="" gname=gname_","_node s gname="$g("_gname_"))"
	e  s gname=fref
	#;  {1D1} is defined to be the whole item "row"  ;  AK780
	s $$$smd(12,imp,6,cons,"expr",1)=$LB("{"_cons_"D1}",$LB("s {"_cons_"D1}="_gname)),gname="{"_cons_"D1}"
	s:comp'="" gname=$$chswap(comp,cons)
	s:del'="" gname="$p("_gname_","_del_","_piece_")"
	#;  define {2D}, in $P(15), to be the whole attribute (now in gname)
	s $$$smd(12,imp,6,ilev)=$LB("CHILDSUB",,,"{"_csub_"}",,,,"Other",,$$$NULLSubscriptMarkerq,,$LB(svar_"\1'="_svar,svar_"<1",svar_">$l({"_ilev_"D},$MVVM)"),,$LB("s "_svar_"=$S("_svar_"<1:1,"_svar_">=$l({"_ilev_"D},$MVVM):"""",1:"_svar_"\1+1) q",";PREV","s "_svar_"=$S("_svar_"=""""||("_svar_">$l({"_ilev_"D},$MVVM)):$l({"_ilev_"D},$MVVM),"_svar_"<=1:"""","_svar_"\1'="_svar_":"_svar_"\1,1:"_svar_"-1)"),gname,,,,csub)
	s $$$smd(12,imp,7,1)=$LB(att,,,)
	s $$$smd(1,irn,2,csub,51,imp,ilev)=irn
	s $$$smd(1,irn,2,att,52,imp,1)=""
	s $$$smd(12,imp,8.5,1)=$lb(pidk,"{S"_cons_"}"),^(2)=$lb(csub,svar)  ;  MV.T.ITEMID, MV.C.CHILDSUB
	s $li($$$smd(12,imp),15,35)=$lb("$P({"_ilev_"D},$MVVM,"_svar_")",,blocks,blocks,"Y",cons,cons,"Y",cons,ilev,2,"Y",1,1,,,,,,,$li(pinfo,26))
	s $li($$$smd(1,irn,2,idifn),26)=par_","_csub	//$LB("PAR","CHILDSUB")
	s $$$smd(1,irn,2,par)=$LB("PAR",0,"Y","%Library.String","N","N",50,$li(pinfo,5)\1.05,"E","VARCHAR",0,0,0,,"N",,,,"N",,,,,,,,,part,"PAR",0)
	s $$$smd(1,irn,2,csub)=$LB("CHILDSUB",2,"Y","%Library.String","N","N",50,,"E","VARCHAR",0,0,0,,"N",,,,"N",,,,,,,,,,"CHILDSUB",0)
	s $$$smd(1,irn,2,att)=$lb(fname,3,"N","%Library.String","N","N",50,sel,$$cl(coll),"VARCHAR",0,0,0,,"N",,,,"N",,,,,,,,,,fname,0)
	;  childsub is actually integer - probably doesn't matter
	d MVCRF(tname,"%RECORD",$li(pinfo,5)\1.2)
	QUIT
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
MVCRF(tname,fname,sel,node="",piece="",del="",comp="",coll="EXACT",sv="") [] PUBLIC {  ;  set up ^SMD for MV field
	#;  MV.tname.fname, with selectivity sel and collation coll, mapped to
	#;  attribute stored in <node,piece,del> or with computed code comp
	#;  For child table, it is added as correlated with the main attribute
	#;  sv=1 indicates computation at the single-value level - internally
	#;      implemented as a real computed field!  ;  AK781
	#;  ***  add future info:  datatype, ...
	s qtn="MV."_tname,irn=$p($$$smd("rv",qtn),$c(1),2),imp=$li($$$smd(1,irn),26)
	s ifn=$i($$$smd("fcnt")),col=$O($$$smd(1,irn,"col",""),-1)+1
	d field(tname,fname,irn,ifn,col,coll)
	#;  computed field, either in parent or child single-value computation
	i comp'="",'$d($$$smd(1,irn,"col",0))||sv  ;  
	{	s fl=ifn
	    s comp=$replace(comp,"{ITEMID}",$S(sv:"{PAR}",1:"{ID}"))
		f  q:comp'["{"  s fn=$p($p(comp,"{",2),"}"),comp=$replace(comp,"{"_fn_"}",$c(2)_$o($$$smd(1,irn,"f",fn,""))_$c(3)),fl=$o($$$smd(1,irn,"f",fn,""))_","_fl
		s $$$smd(1,irn,2,ifn)=$lb(fname,col,"N","%Library.String","N","N",50,sel,$$cl(coll),"VARCHAR",0,0,0,,"N",,,,"Y","Y",,fl,,,,,,,fname,0),^(ifn,7,0)=1,^(1)="Set {"_ifn_"}="_$TR(comp,$C(2,3),"{}")
		QUIT
	}
	s $$$smd(1,irn,2,ifn)=$lb(fname,col,"N","%Library.String","N","N",50,sel,$$cl(coll),"VARCHAR",0,0,0,,"N",,,,"N",,,,,,,,,,fname,0)
	s idata=$O($$$smd(12,imp,7,""),-1)+1
	i '$d($$$smd(1,irn,"col",0))
	{	s $$$smd(12,imp,7,idata)=$LB(ifn,node,piece,del)
		s $$$smd(1,irn,2,ifn,52,imp,idata)=node_$c(1)_piece_$c(1)_del
		s $li($$$smd(12,imp),37)=1  ;  for DPV3478 - *** verify for computed, child, etc.!
		QUIT
	}  ;  child table (correlated) field - use "Access variable"
	#;  {<cons>D<ivar>} at the ItemId level for the whole attribute value (computed or pieced)
	;  *** probably need to fix this code if this and/or controlling field is computed, NextCode, etc.
	;  *** for child table computed field, it would be nice to allow
	;      arbitrary parent-table fields (identical to the format for
	;      parent field), including {ITEMID} and {%RECORD}, and we translate it all
	s cons=$o($$$smd(12,imp,6,""),-1)-1,ivar=$O($$$smd(12,imp,6,cons,"expr",""),-1)+1,avar="{"_cons_"D"_ivar_"}"
	s gname=$s(comp'="":$$chswap(comp,cons,irn,imp),node'="":"$g("_$li($$$smd(12,imp,6,cons),13)_","_node_"))",1:"{"_cons_"D1}")
	s:del'="" gname="$p("_gname_","_del_","_piece_")"
	#;  gname is now the whole attribute
	s $$$smd(1,irn,2,ifn,52,imp,idata)=""
	i fname="%RECORD" s $$$smd(12,imp,7,idata)=$LB(ifn,,,,$LB("s {"_ifn_"}="_gname)) QUIT
	s $$$smd(12,imp,6,cons,"expr",ivar)=$LB(avar,$LB("s "_avar_"="_gname))
	s $$$smd(12,imp,7,idata)=$LB(ifn,,,,$LB("s {"_ifn_"}=$P("_avar_",$MVVM,{S"_(cons+1)_"})"))
	QUIT
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
chswap(code,lev,irn="",imp="")  ;  $$: code, with replacements for child table map definition
	d swap2("{ITEMID}","{S"_lev_"}")
	d swap2("{%RECORD}","{"_lev_"D1}")
	QUIT:'irn code  ;  MVCRC() computation cannot reference other fields
	d swap2("{ID}","({S"_lev_"}_""||""_{"_lev_"D1})")  ;  (probably never used)
	#;  replace the child table main field name with {2D}
	d swap2("{"_$P($$$smd(1,"ifn",$$$smd(1,irn,"col",3)),$c(1))_"}","{"_(lev+1)_"D}")
	n idata,md  ;  md=$LB(ifn,,,,$LB("s {ifn}=$P({1Dj},$MVVM,{S2})")) -
	#;  replace {fname} with {1Dj}
	f idata=3:1:$O($$$smd(12,imp,7,""),-1) s md=$$$smd(12,imp,7,idata) d swap2("{"_$P($$$smd(1,"ifn",$LI(md)),$c(1))_"}",$P($P($LI($LI(md,5)),"=$P(",2),",$MV"))
	QUIT code
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
swap2(from,to)  ;  [public: code] replace 'from' by 'to' in 'code'
	s code=$replace(code,from,to)
	QUIT
	#;  $$: code, with {ITEMID}/{%RECORD} replaced by {S1}/{1D1} (at level lev)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; AK814
cl(coll) 
	if $$$ISENCODEDCOLLATE($P(coll,"(")) QUIT coll
	QUIT $case($P(coll,"("),"MVR":"MV","SPACE":"S","SQLSTRING":"SS","SQLUPPER":"SU",:"E")_$P(coll,$P(coll,"("),2)
	#;  $$: short collation name, for use in $LI(9) of the field data
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
colex(coll,arg) QUIT $case(coll,"":arg,"SPACE":""" ""_"_arg,:"$$"_$P(coll,"(")_"("_arg_$S(coll["(":","_$P(coll,"(",2),1:")"))
	#; AK814-
	#;  $$: subscript expression for coll(arg)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
field(tname,fname,irn,ifn,col,coll="EXACT") PUBLIC {  ;  set up ^SMD for MV field fname
	s $$$smd(1,irn,30)=$G($$$smd(1,irn,30))_$LB(fname),^(32)=^(30)
	s $$$smd(1,irn,"col",col)=ifn
	s $$$smd(1,irn,"f",fname,ifn)=fname
	s $$$smd(1,"ifn",ifn)=fname_$c(1)_irn_$c(1)_col
	s $$$smd(8,ifn)=fname_$c(1)_12_$c(1)_50_$c(1)_50_$c(1)_0_$c(1)_(col>2)_$c(1,1)_fname_$c(1)_"MV"_$c(1,1)_tname_$c(1,1,1,1,1)_12
	s $$$smd(1,irn,2,ifn,"adtp","MAXLEN")=50,^("COLLATION")=coll
	QUIT
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
MVCRI(tname,gname,itype="I",flist,colist="",nlist="",blocks="") [] PUBLIC {  ;  set up ^SMD for
	#;  MV index of itype I/B/BE on MV.tname in global gname, with
	#;  subscripts flist=LIST(fname,) with collations colist=LIST(fname,)
	#;  and node data in a $LIST() format with fields nlist=LIST(fname,)
	#; AK812
	s:blocks="" blocks=$s(itype="B":400,itype="BE":10,1:1500)
	s qtn="MV."_tname
	s irn=$p($$$smd("rv",qtn),$c(1),2),tinfo=$$$smd(1,irn)
	s idifn=$lg(tinfo,25),idk=$lg(tinfo,11),phys=$lg(tinfo,12)
	s:$e(gname,*)=")" $e(gname,$l(gname))="" s gname=gname_$s(gname["(":",",1:"("),cons=$l(gname,",")-1  ;  #constant subscripts
	s g23a=gname,g23b=gname  ;  compiled gref in $P(34)
	s:itype["B" $li($$$smd(1,irn),13)=1  ;  "Bitmap friendly"
	#; Define new map MVIimp
	s imp=$i($$$smd("mcnt"))
	s $$$smd(1,irn,"map","MVI"_imp,imp)="MVI"_imp
	s idata=""  ;  set nodes (12,7) and (1,2,52) for node data fields
	s lnl=$l(nlist,",")-1
	f ii=1:1:lnl s fname=$p(nlist,",",ii) i fname'="",$i(idata) s ifn=$o($$$smd(1,irn,"f",fname,"")),$$$smd(1,irn,2,ifn,52,imp,idata)=$c(1)_$s(lnl=1:"",1:ii),$$$smd(12,imp,7,idata)=$LB(ifn,,$s(lnl=1:"",1:ii))
	i cons f cons=1:1:cons s $$$smd(12,imp,6,cons)=$LB(,$p($p(gname,"(",2,*),",",cons),,$p($p(gname,"(",2,*),",",cons),,,,"Sub",,$$$NULLSubscriptMarkerq)
	s:itype'["B" flist=flist_$s(phys[",":"ITEMID,CHILDSUB,",1:"ID,")
	f ii=1:1:$l(flist,",")-1 {
		s coll=$p(colist,",",ii),fname=$p(flist,",",ii)
		s ifn=$s(fname="ITEMID":+phys,1:$o($$$smd(1,irn,"f",fname,""))),irn2=$p($$$smd(1,"ifn",ifn),$c(1),2)
		s $$$smd(1,irn2,2,ifn,51,imp,$i(cons))=irn_$c(1)_coll
		s $$$smd(12,imp,6,cons)=$LB(fname,,coll,$$colex(coll,"{"_ifn_"}"),,,,"Sub",,$$$NULLSubscriptMarkerq,,,$LB("s {S"_cons_"}=$o("_gname_"{S"_cons_"}))","q:{S"_cons_"}="""""),,,,,,ifn)
		s gname=gname_"{S"_cons_"},"
		s g23a=g23a_$$colex(coll,"%d("_$p($$$smd(1,"ifn",ifn),$c(1),3)_")")_","
		s g23b=g23b_$$colex(coll,$c(6)_qtn_$c(5)_fname_$c(6))_","
		#;  since SPACE() is reversible, make field itself available!
		i coll="SPACE",(","_nlist)'[(","_fname_",") s $$$smd(1,irn2,2,ifn,52,imp,$i(idata))="",$$$smd(12,imp,7,idata)=$LB(ifn,,,,$LB("s {"_ifn_"}=$E({S"_cons_"},2,*)"))
	}
	s $e(g23a,$l(g23a))=")",$e(g23b,$l(g23b))=")"
	f ii=1:1:$l(phys,",") s $$$smd(12,imp,8.5,ii)=$s(itype["B":$lb(idifn,"{"_idifn_"}"),1:$lb($p(phys,",",ii),"{S"_(cons-((phys[",")&&(ii=1)))_"}"))
	s $$$smd(12,imp)=$lb("MVI"_imp,$p(gname,"("),"N",1,"L",0,itype,,1,"N",,,,,,$lb($$$NULLSubscriptMarkerq),blocks,blocks)_$s(phys[",":$lb("Y",cons-1,cons-1,"Y",cons-1,cons,2,"Y",1,1),1:$lb(,,,,cons,cons,1,"Y",,))_$lb(,,,,,g23a_$c(1)_g23b_$c(1),,,nlist'="","D",irn)
	QUIT
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
MVFILEI(gname,idvar,rowvar,atpos,itype,nlist) [] PUBLIC {  ;  $$:  MV index SET code
	#;  itype="iat" - whole attribute indexed,
	#;  itype="imv" - each multivalue indexed individually
	#;  nlist=LIST(pos,pos) of fields in index data
	#;        (if itype="imv", append * for correlated fields!)
	#;  examples:
	#;  MVFILEI("^D.MV(""AT3Index"")","%id","%row",3,1,"") =>
	#;      s ^D.MV("AT3Index",$P(%row,$MVAM,3),%id)=""
	#;  MVFILEI("^D.MVI","dd","rr",3,2,"") =>
	#;      n %mvii f %mvii=1:1:$L($P(rr,$MVAM,3),$MVVM) s ^D.MVI($P($P(rr,$MVAM,3),$MVVM,%mvii),%mvii,dd)=""
	#;  MVFILEI("^D.MVI","dd","rr",3,2,"4,7*,1") =>
	#;      n %mvii f %mvii=1:1:$L($P(rr,$MVAM,3),$MVVM) s ^D.MVI($P($P(rr,$MVAM,3),$MVVM,%mvii),%mvii,dd)=$LB($P(rr,$MVAM,4),$P($P(rr,$MVAM,7),$MVVM,%mvii),$P(rr,$MVAM,1))
	#;  Note that in the index node data, attribute 7 is correlated!
	#;  *** deal with NULL in subscript!
	s:$e(gname)'="^" gname="^"_gname
	s:$e(gname,*)=")" $e(gname,$l(gname))=""
	s gname=gname_$s(gname["(":",",1:"(")
	s sub="$P("_rowvar_",$MVAM,"_atpos_")"
	i nlist="" s rs=""""""  ;  build node data expression
	e  s rs="" f fi=1:1 { s pos=$p(nlist,",",fi) q:pos=""  s pce="$P("_rowvar_",$MVAM,"_+pos_")" s:(itype="imv")&&(pos["*") pce="$P("_pce_",$MVVM,%mvii)" s rs=rs_","_pce } s rs="$LB("_$e(rs,2,*)_")"
	QUIT:itype="iat" "s "_gname_sub_","_idvar_")="_rs
	QUIT:itype="imv" "n %mvii f %mvii=1:1:$L("_sub_",$MVVM) s "_gname_"$P("_sub_",$MVVM,%mvii),%mvii,"_idvar_")="_rs
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
MVSVTL(cn) [] PUBLIC {  ;  $$: multivalue subvalue table list for class cn
	#;  <tl> ::= LIST(<ti> $MVAM <ti>)  ;  table list
	#;  <ti> ::= <tname> $MVVM LIST(<fi> $MVVM <fi>)  ;  single table info
	#;           ;  the fields are in the order:  rowid,ItemID,mv_key,sv_key,<datafields>
	#;  <fi> ::= <fname> $MVSM [ <mvname> ]  ;  single field info
	#;           ;  first 4 fields provide only the fname
	#;  algorithm:  look up "extents" under ^oddCOM(cn,77,en)=child, make
	#;  sure sv_key is found under ^oddCOM(en,"a","sv_key"), find the table
	#;  name under ^oddCOM(en,53)=qtname, loop over the field names in
	#;  ^oddEXTR(en,"b",fn,91)=$LB(1:colnum,...,28:pn), and for non-IDKEY
	#;  fields get the original MVNAME from ^oddCOM(cn,"a",pn,"P","MVNAME")
	s en="",tl=""
	f  { s en=$O(^oddCOM(cn,77,en),1,node)  ;  "extent name"
		QUIT:en=""
		CONTINUE:node=""  ;  not a child table
		CONTINUE:'$D(^oddCOM(en,"a","sv_key"))  ;  not from an MVSVASS
		s ti=$MVAM_^oddCOM(en,53)_$MVVM_$MVVM_$MVVM_"mv_key"_$MVVM_"sv_key"
		s fn=""
		f  { s fn=$O(^oddEXTR(en,"b",fn))  ;  field name
			QUIT:fn=""
			CONTINUE:(fn="mv_key")||(fn="sv_key")
			s node=^(fn,91)  ;  beware of naked!
			i $LI(node)=1 s $P(ti,$MVVM,2)=fn CONTINUE  ;  rowid
			i $LI(node)=0 s $P(ti,$MVVM,3)=fn CONTINUE  ;  ItemId
			s node=$G(^oddCOM(cn,"a",$LI(node,28),"P","MVNAME"))
			s:node'="" ti=ti_$MVVM_fn_$MVSM_node
		}
		s:$L(ti,$MVVM)>5 tl=tl_ti
	}
	QUIT $E(tl,2,*)
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
MVSVFL(cn,fsv) [] PUBLIC {
	#; Called from %SYS.MVQ
	#;  for class cn, return (by ref) in
	#;  .fsv(mvname)=$LB(tname,fname,itemid)
	#;  MVSVASSOCIATION subvalue table information for any property with
	#;  the given MVNAME (use property name if no MVNAME provided)
	#;  itemid is the parent reference field name
	#;  algorithm:  look up "extents" under ^oddCOM(cn,77,en)=child, make
	#;  sure sv_key is found under ^oddCOM(en,"a","sv_key"), find the table
	#;  name at ^oddCOM(en,53)=qtname and the parent reference/ItemId
	#;  field name at $LI($LI(^oddEXTR(en,91),11)), loop over the field
	#;  names in ^oddEXTR(en,"b",fn,91)=$LB(1:colnum,...,28:pn), and for
	#;  non-IDKEY fields get the original MVNAME from
	#;  ^oddCOM(cn,"a",pn,"P","MVNAME") (or use the property name pn)
	s en="",tl=""
	f  { s en=$O(^oddCOM(cn,77,en),1,node)  ;  "extent name"
		QUIT:en=""
		CONTINUE:node=""  ;  not a child table
		CONTINUE:'$D(^oddCOM(en,"a","sv_key"))  ;  not from an MVSVASS
		s tn=$LB(^oddCOM(en,53)),par=$LB($LI($LI(^oddEXTR(en,91),11)))
		s fn=""
		f  { s fn=$O(^oddEXTR(en,"b",fn))  ;  field name
			QUIT:fn=""
			CONTINUE:(fn="mv_key")||(fn="sv_key")
			s node=^(fn,91)  ;  beware of naked!
			CONTINUE:$LI(node)<2  ;  rowid or ItemId
			s pn=$LI(node,28)  ;  property name
			s node=$G(^oddCOM(cn,"a",pn,"P","MVNAME"))
			s:node="" node=pn  ;  use property name if no MVNAME
			s fsv(node)=tn_$LB(fn)_par
		}
	}
	QUIT
	}
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  Build the following temp structure for the table definitions:
	#;  $$$smd(1,irn) = $lb()
	#;	1.  schema
	#;	2.  tabname
	#;	3.  classname
	#;	4.  owner
	#;	5.  numrows
	#;	6.  $h or last compile
	#;	7.  readonly (Y or N)
	#;	8.  default storage strategy (1 or 0)
	#;	9.  ifn of RowID field
	#;	10. Is RowID based on other fields (Y or N)
	#;	11. "," list of Logical (this tab) ifns the RowID is based on
	#;	12. "," list of Physical (all tabs) ifns the RowID is based on
	#;	13. BitMap Friendly RowID? (1 or 0)
	#;	14. numright offsets for $P args for 'physical' based fields
	#;	15. numright offsets for $P args for 'logical' based fields
	#;	16. Name of the parent table
	#;	17. Child Table Type: 'A'rray, 'L'ist, 'R'elationship, or NULL
	#;	18. Extentname of parent table
	#;	19. $List of $lb(fldname,icol,extent) of all tables this table references
	#;	20. Parent reference field name
	#;	21. Master Map Name
	#;	22. System Flag
	#;	23. Lock Reference for Queries, $C(1) marks rowid variable
	#;	24. extent
	#;	25. RowID ifn for this table
	#;	26. Master Map imp
	#;  $$$smd(1,irn,20) = $lb() of all child table names  ;  DPV2446
	#;  $$$smd(1,irn,23) = List of all Relations this one points to: ^ifn1,icol1,TableName1^ifn2,icol2,TableName2^...^
	#;  $$$smd(1,irn,30) = $lb() all non-hidden fields UPPER case, icol order
	#;  $$$smd(1,irn,32) = $lb() all non-hidden fields exact case, icol order
	#;  $$$smd(1,irn,33) = FAKE Class compiler timestamp from $$$comClassKeyRaw(%class,$$$cCLASStimechanged), just use $zu(188) here
	#;  $$$smd("rv",TABLENAME)=tablename_$c(1)_irn_$c(1)_ttype
	#;  TABLE Columns:
	#;  $$$smd(1,irn,2,ifn) = $lb()
	#;	1.  Fieldname
	#;	2.  Column Number (icol)
	#;	3.  Required (Y or N)
	#;	4.  Datatype (ADT)
	#;	5.  Hidden Field (Y or N)
	#;	6.  Unique field (Y or N)
	#;	7.  Maximum Length
	#;	8.  Selectivity
	#;	9.  Collation Function - A U T E(=EXACT) S(=SPACE) P M MV(=MVR) SS SU TR
	#;		T  - STRING (may have truncate length i.e. T(10)
	#;		SS - SQLSTRING (may have truncate length i.e. SS(10)  (DPV1151)
	#;		SU - SQLUPPER (may have truncate length i.e. SS(10)   (DPV1151)
	#;		TR - TRUNCATE (may have truncate length i.e. TR(10)   (DPV3644)
	#;	10. xDBC Typename
	#;	11. Array Collection Flag (1 or 0)
	#;	12. Uses Stream Interface? (1 or 0)
	#;	13. System Generated Value (1 or 0)
	#;	14. Container Field Name
	#;	15. List Field (Y or N)
	#;	16. List Type (1=Store in Pieces, 2= Store in Nodes, 3 = Store in $List)
	#;	17. List Field Delimiter (for ListType = 1)
	#;	18. Collection Type (If List Field - for ADT API)
	#;	19. Computed Field (Y or N)
	#;	20. Always Equal to Computation (Y or N)
	#;	21. $List of field names which trigger the computation
	#;	22. "," list of field ifns which are referenced in computed code
	#;	23. Default Value
	#;	25. Record ID - Based on other fields (Y or N)
	#;	26. Record ID - LIST(ifn,ifn) of ID based field *** (was $LIST(names) - fix in code!!!) ***
	#;	28. Name of Referenced table (Internal Qualified Table Name)
	#;	29. Property Name
	#;	30. ReadOnly? (1/0) (DPV2253)
	#;	31.-37. additional newer information *** check!
	#;  $$$smd(1,irn,2,ifn,51,imp,ilev) = irn_$c(1)_SubscripFunction (Like ALPHAUP)
	#;  $$$smd(1,irn,2,ifn,52,imp,idata) = node_$c(1)_piece_$c(1)_delimeter
	#;  $$$smd(1,"ifn",ifn) = fieldname_$c(1)_irn_$c(1)_icol
	#;  $$$smd(1,irn,"f",FIELD,ifn)=field
	#;  $$$smd(1,irn,"col",icol)=ifn
	#;  $$$smd(1,irn,2,ifn,"adtp","COLLATION") = collation long name
	#;  $$$smd(1,irn,2,ifn,"adtp","MAXLEN") = max length parameter value
	#;  $$$smd(1,irn,2,ifn,"adtp","VALUELIST") = valuelist parameter value
	#;  $$$smd(8,ifn) = $c(1) pieces"
	#;	1.  fldname
	#;	2.  datatype
	#;	3.  length
	#;	4.  precision
	#;	5.  scale
	#;	6.  nullable
	#;	7.  --
	#;	8.  fldname
	#;	9.  schema
	#;	10. --
	#;	11. tabname
	#;	12->15. --
	#;	16. datatype
	#;  $$$smd(12,imp) = $lb()
	#;	1.  Mapname
	#;	2.  Global Reference
	#;	3.  Master (Data) Map? (Y or N)
	#;	4.  Map Populate Type (Non-NULL||0, Full||1, Conditional||2)
	#;	5.  Type of data ('L'ist, or 'D'elimited)
	#;	6.  Unique map?  (1 or 0) 1 if defined as unique index in class
	#;	7.  Index Type (I)ndex, (K)ey, (B)itmap, (B)itmap(E)xtent
	#;	8.  $list format of sql fields defined in the index definition
	#;	9.  FromThisTable (1 or 0) flag i the map is defined in the immediate class
	#;	10.  Conditional Map? (Y or N)
	#;	11. Condition code for conditional update
	#;	12. Conditional Maps - Host Variable Override, 1 or 0, optional, default = 0
	#;	13. $List() of Field names used in Conditional expression
	#;	14. Conditional Maps - Percentage of rows in this map
	#;	15. Row Reference Override
	#;	16. $List of NULL Subscript Markers
	#;	17. Number of blocks used just by map itself - not used in QP (?)
	#;	18. Number of blocks occupied by this map
	#;	19. Is Parent ID stored in the subscripts? Y or N
	#;	20. 'ilev' that Parent ID starts
	#;	21. 'ilev' of last Parent ID
	#;	22. Is this in Parent ID order? Y or N
	#;	23. 'ilev' that Row ID starts
	#;	24. 'ilev' of last Row ID
	#;	25. Number and levels of Row ID, including constants,
	#;	         AND treating Parent ID as one subscript
	#;	26. Is the RowID in order? Y or N
	#;	27. Number of Parent ID levels without constants
	#;	28. Level that Parent ID starts without constants
	#;	29,30,31,32,33 - not used
	#;	34. Compiled top level pieces					Calculated in FinishMap
	#;	35. imp of Map this one is stored under	Calculated in FinishMap
	#;		The top-level parent map's imp if this is a child table
	#;	36. $List of $LB(extent,mapname) of all maps stored under 	Calculated in FinishMap
	#;		this one (for top-level maps only)
	#;      37. AllFieldsInMainNode (1/0) flag 				Calculated in MapFinalize
	#;      38. BlockCountType - "M"easured (TuneTable computed), or "D"efined (User defined)
	#;      39. irn of table this map belongs to
	#;      40. BitSlice Scale - for BitSlice indices only
	#;	41. Table Valued Function Call (##class(class).queryFunc()	Only for fake TVF tables - without arguments
	#;  $$$smd(12,imp,6,ilev) = $lb() - Map Subscripts
	#;	1.  Field Name
	#;	2.  Constant
	#;	3.  Function - Can be 'keyup' or 'exp' if it's a complex expression on 1 ifn.
	#;	4.  COS Expression - fields represented as {FieldName}
	#;	5.  Start value
	#;	6.  Stop value
	#;	7.  Stop Expression
	#;	8.  Access Type
	#;	9.  Piece Delimiter
	#;	10. NULL Subscript Marker
	#;	11. $List() of Special Invalid Conditions (Default)
	#;	12. $List() of Special Invalid Conditions (Override)
	#;	14. $List(lines) of Special NEXT code (Override)
	#;	15. Override Data Expression
	#;	16. Loop Init Value
	#;	17. Field's Schema	// Only if from another table
	#;	18. Field's Table Name	// Only if from another table
	#;	19. Field Ifn
	#;	20,21 added later
	#;  $$$smd(12,imp,6,ilev,"expr",ivar) = $lb() - Map Varaiables
	#;	1.  Map Variable Name
	#;	2.  Map Variable Code
	#;  $$$smd(12,imp,7,idata) = $lb() - Map Data
	#;	1.  ifn
	#;	2.  Node(s)   e.g.,  1,"a","data"
	#;	3.  Piece Number(s)
	#;	4.  Delimiter string(s), one for each piece
	#;	5.  $List() of M retrieval code
	#;	6.  FieldCollectionType - "K"/"E" for KEYS/ELEMENTS (DPV2616)
	#;  $$$smd(12,imp,8.5,n) = $lb() - Map Data
	#;	1.  ifn
	#;	2.  MUMPS expression to calculate this field.
	#;		{S1} represents subscript 1, {P3} is piece 3,
	#;		and {ifn} is a field listed in MapData.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
---

