	#; JLF016
applyRLS(m) [ mt ] public {
		#; Apply row-level security to query block m
.
	for str=1:1:$$getNodeCount^%qaqpre("r") {
		if $$$mtRQb($$$mtR(str))=m,'$g($$$mtRVirtual(str)) {
			set irn=$$$mtRIrn($$$mtR(str))
			do getReaderListIFN(irn, .readerListIFN, .type)
			if readerListIFN { do addRLSPred(irn,m,str,readerListIFN,type) set $$$mtNumAnyOf="" }
		}
	}
	RETURN
}
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
getReaderListIFN(irn,ifn,type)
		#; If the ROWLEVELSECURITY parameter is defined for the specified class, and the property
		#; it refers to exists, then set the ifn.  If the property has a runnable BuildValueArray
		#; method, then set type to 1 (collection), else set type to 0 (non-collection)
.
	RETURN:irn=""
	new rlsprop,pkgdotcls,methname,ttype
	set ifn="",type=0
	set ttype=$$$smdTType(irn)
		#; Jira DP-412479 reported that once in a blue moon (Mike has seen it 2/3 times a year) ttype will be "" here, leading to a <SUBSCRIPT> error
		#; This is a sharded UnitTest.  I can only suspect there is somehow $$$smd getting purged and the irn in $$$mtRNumStreams is no longer defined.
		#; I have no idea how this could happen, but I'm going to protect against a <SUBSCRIPT> here by adding a RETURN:ttype=""
		#; This might not actually fix the issue, but hopefully it will lead to an easier diagnosis.
		#; Note, the UnitTest is NOT using RLS and it is not using Frozen Plans in all cases where this issue has been seen (according to Mike).
	RETURN:ttype=""
	set rlsprop=$$$smdRowLevelSecurityParam(ttype,irn)
	set:(rlsprop=""||(rlsprop=1)) rlsprop="%READERLIST"
	set ifn=$$$smdGetIfn(1,irn,rlsprop)
	RETURN:ifn=""
		#; if the rls field is also the single-field IDKey, just use the IDKey field (Netsmart has a setup like this - Jira DP-417366)
	if $$$smdRowIDLogicalFields(ttype,irn)=ifn { set ifn=$$$smdRowIDField(ttype,irn) }
	set:$$ismeth^%qadadt($$$smdClassname(ttype,irn),rlsprop_"BuildValueArray")=1 type=1
	RETURN
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
addRLSPred(irn, m, str, readerListIFN, type)
	#; PVA342: Here, we save the generated RLS conditions in a new strucutre mt("RLS",str). At this time
	#;    we do not know which query blocks are sharded, nor do we know the correct place to add these 
	#;    conditions for outer joins. Thus, they are held aside until we know these things. All intervening processing
	#;    must handle these the same way mt("ON") condition entry is done.
	n inLog,rlValuesIFN,rlValuesVal,user,val
	#; Adds the row-level security predicate to the WHERE clause of qb m
 
	#; Obtain or create the %READERLIST val that the RLS predicate will be applied to
	#;
	s rlValuesVal = $$nufld^%qaqpqo(str, readerListIFN)  ;BJB426
	if type=0
	{	s rlValuesIFN = readerListIFN }
	else
	{	s rlValuesIFN = $s($l(readerListIFN,"_")'=2:readerListIFN_"_%ANYOF"_($$$maxv+1),1:$p(readerListIFN,"_",1)_"_%ANYOF"_(val+1)_"_"_$p(readerListIFN,"_",2)) }
	s rlValuesVal = $$nufld^%qaqpqo(str, rlValuesIFN)
 
	#; Create the RLS predicate: (RL = $Username) OR (RL IN ($Roles)) OR (RL IS NULL),
	#; relying on %qaqpnl to merge this into an efficient ONEOF operation, possibly with
	#; the IS NULL removed if REQUIRED and not on the null-padded side of an outer join
	#;
	#; PVA342: Since we are now just saving this condition, possibly not adding it for shards, 
	#;    we defer all setting of mt("complexlog").
	Set val=$$$newval("v^USER^,^",1) 
	Set val=$$$newlog("v^=^,"_rlValuesVal_",^"_rlValuesVal_"^"_val_"^") s user = val
	Set val=$$$newval("v^ROLES^,^",1)
	Set val=$$$newval("v^SET:LIST^,^"_val_"^",1) 
	Set val=$$$newlog("v^INSET^,"_rlValuesVal_",^"_rlValuesVal_"^"_val_"^")
	Set val=$$$newlog("l^!^"_rlValuesVal_",^"_user_"^"_val_"^") s inLog = val
	Set val=$$$newlog("v^NULL^,"_rlValuesVal_",^"_rlValuesVal_"^")
	Set val=$$$newlog("l^!^,"_rlValuesVal_",^"_val_"^"_inLog_"^")
	s mt("RLS",str)=val // PVA342: save to decide later where or whether to add this
	quit
	#; JLF016-
 #; PVA342: new function:
placeRLSPred(m) [linx,m,mt,nulstr] PUBLIC
{   
    #; For now, we just do as was done previously - add to mt("w"). However, to correctly support row level
    #; security in the context of outer joins:
    #;   Search right arguments of LEFT
    #;   join ON nodes and both arguments of FULL join ON nodes for a
    #;   stream. Completely ignore INNER join nodes that may exit. Of these,
    #;   use the argument with the fewest total streams. Cases:
.
    #;    - not found in any such argument: add to mt("w",qno)
    #;    - found in a LEFT join argument: add to that ON node's
    #;      conditions.
    #;    - found in FULL join argument: wrap the stream in a streamed view
    #;      that SELECTs all "f" type v nodes that exist for that STREAM, doing
    #;      all required reference fix ups for things to point to the new
    #;      virtual fields of virtual stream. DO NOT mark this %noreduce, as it
    #;      may be possible to merge this later depending on later analysis. 
.
    #;   For a complete fix up, =* and arrow syntax must all be converted to
    #;   ON nodes early in preopt, as in a future plan. 
	set mOriginal = m
	s str="" for 
	{ s str=$o(mt("RLS",str),1,val) q:str=""  continue:$p(mt("r",str),"^",2)'=mOriginal
	  #; following is just safety catch for future possible code reorganization. Currently,
	  #; this is called within the large block of propagatePreds that is skipped for sharded 
	  #; blocks. Note, protection to only run in the phase 1 call is not needed because of the
	  #; killing of mt("RLS") nodes.
	  if $$isSharded^%qaqpnl(mOriginal) {s mt("l",val)="i^sharded RLS^"_mt("l",val) k mt("RLS",str)}
	  else 
	  {
		// EEE039: str is the (one) stream touched by this RLS condition (i.e., stream of the fieldVal used by this condition)
		// because the field in p3 of this mt("l",val) condition was set in addRLSPred^%qaqpre2() to belong to this str# in mt("RLS",str#).
		// We proceed differently about how to add this condition if this stream is one of the JOIN streams (nulstrs stores right hand streams for LEFT joins and both sides' streams for FULL joins).
		// If that doesn't happen, we will use the following flags to later add this condition to this initial query block mOriginal
		set addedToON = 0
		set implicitJOIN = 0
		if $d(nulstr),$listfind(nulstr,str) {
			set ctr = ""
			set ONNode = ""
			// Implicit JOINs don't have mt("ON")
			if '$d(mt("ON")),$d(linx) {
				new m
				set m = mOriginal
				set m = $$cr8strview(","_str_",","","","","")
				// Without marking new qb as %NOREDUCE, some queries were failing because the newly assigned mt("w") - during addlog^%qaqpnl(val) - for
				// the new qb=2 (in the following example) was getting killed ('k mt("w",sqb)') and merged into the parent query in $$mrgstrview 
				// which is exactly what we DON't want to do (since we want current condition, val, to apply to new streamed view qb):
				// SELECT ID,Table2->Name2 FROM %PARALLEL EEE039.Table1 -- should return all LHS rows, and null pad non-privileged row values from %PARALLEL RHS
				s mt("hint",m,"%NOREDUCE")=1
				// Now add the condition val to mt("w",m) of this newly wrapped qb
				d addlog^%qaqpnl(val)
				d complexlog^%qaqpnl(m, val)
				set implicitJOIN = 1
			}
.
			// Explicit LEFT and FULL OUTER JOINs have mt("ON") entries; loop over them and add condition val appropriately.
			// For this to work for chained LEFT OUTER JOINS, we only add the condition val when the RHS table name ($li(ONNode,4) where $ll=1) corresponds to the current stream (strtoname^%qaqpre2(str)).
			// For FULL OUTER JOINs, we check both left and right tables
			for {
				set ctr = $o(mt("ON",mOriginal,ctr),1,ONNode)
				QUIT:ctr=""
				if ($li(ONNode) = "LEFT"),($LB($$strtoname(str))=$li(ONNode,4)) { // It could be INNER as well; in that case we add to mt("w") later
					set $li(mt("ON",mOriginal,ctr),2) = $li(ONNode,2)_val_"^"
					set addedToON = 1
				} elseif ($li(ONNode) = "FULL"),(($LB($$strtoname(str))=$li(ONNode,4))||($LB($$strtoname(str))=$li(ONNode,3))) {
					new m
					set m = mOriginal
					set m = $$cr8strview(","_str_",","","","","")
					// After we wrap current stream in its new view (query block), addlog below will correctly bind a new "w" condition to this newly generated qb#=m.
					// This is what we want for a FULL JOIN: for the RLS condition to apply/be added to the mt("w") within this subquery so that rows not passing RLS get filtered out.
					// Usually mt("ON",m) conditions are later transformed into mt("w",qb) conditions via xfrmON^%qaqpnl and are bound to the correct query blocks;
					// so, if this RLS condition was added to "ON" now and later assigned to "w" like what we do for LEFT, it would end up at the main query block m
					// which is not accurate because that "w" condition would just check the condition during the JOIN and not after the JOIN as desired.
					d addlog^%qaqpnl(val)
					d complexlog^%qaqpnl(m, val)
					set addedToON = 1
				}
			}
		}
		// Otherwise, i.e. when the current stream's condition was not added to any ON entry for LEFT JOINs or any created view as part of a FULL or implicit JOIN, add condition to mt("w",mOriginal)
		if 'addedToON,'implicitJOIN {
	    	d addlog^%qaqpnl(val)
	    	d complexlog^%qaqpnl(mOriginal, val)
		}
	    k mt("RLS",str)
	  }
	}
    quit
}    
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mergeEquivAggs(m)  ; JLF009+
	#; Merge equivalent aggregates in query block m
	RETURN:'$$$mtPQbIsActive(m)
	s $$$mtPAggList($$$mtP(m))=$$mergequiv(m,$$$mtPAggList($$$mtP(m)))  ;  AK1019
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mergequiv(m,valist)  ;  $$: vlist = subset of valist=LIST(val,), after
	#;  combining equivalent entries  ;  AK1019
	n vlist,allcanon,fi,val,prc,tov s vlist="",allcanon=""
	f fi=1:1:$l(valist,",")-1 {
		s val=$p(valist,",",fi),prc=$$buildCanonical^%qaqpre("v",val,0,-1,""),tov=$lf(allcanon,prc)
		i tov { d replsubq(m,val,tov) CONTINUE }
		s $li(allcanon,val)=prc,vlist=vlist_val_","
	}
	RETURN vlist
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
replsubq(m,redirectFrom,redirectTo)  ;  replace val# redirectFrom to
	n call,lv,v  ;  redirectTo everywhere in subquery m  ;  AK1019
	set call="redirectRef^%qaqpre2"
	s:$g($$$mtTopArg(m))=redirectFrom $$$mtTopArg(m)=redirectTo  ;  TOP
	s:$g($$$mtOffset(m))=redirectFrom $$$mtOffset(m)=redirectTo  ;  OFFSET
	s v=$$$mtOutputVals($g($$$mtOutput(m)))  ;  SELECT-list
	f lv=1:1:$l(v,",")-1
	{	if redirectFrom = $p(v,",",lv)
		{	s $p(v,",",lv)=redirectTo,$$$mtOutputVals($$$mtOutput(m))=v
		}
		else
		{	do lvtree^%qaqpnl("v",$p(v,",",lv))
		}
	}
	#;  OUTER JOIN (note this must be post ON/linx transformation)
	#;  *** Note:  replsubq() is not applied to linx, mt("ON")!
	f lv=1:1:$l($g($$$mtLeftOuterJoins(m)),",")-1 d lvtree^%qaqpnl("l",$p($$$mtLeftOuterJoins(m),",",lv))
	f lv=1:1:$l($g($$$mtWhere(m)),"^")-1 d lvtree^%qaqpnl("l",$p($$$mtWhere(m),"^",lv))  ;  WHERE
	f lv=1:1:$l($g($$$mtGroupDistinctList(m)),",")-1  ;  GROUP BY
	{	if redirectFrom=$p($$$mtGroupDistinctList(m),",",lv)
		{	s $p($$$mtGroupDistinctList(m),",",lv)=redirectTo }
		else
		{	d lvtree^%qaqpnl("v",$p($$$mtGroupDistinctList(m),",",lv)) }
	}
	do:$g($$$mtHaving(m)) lvtree^%qaqpnl("l",$$$mtHaving(m))  ;  HAVING
	#; Replace any references in the (conventional) ORDER BY
	if m=1
	{	f lv=1:1:$l($g($$$mtSequencers),",")-1
		{	if redirectFrom=+$p($$$mtSequencers,",",lv) 
			{	s $p($$$mtSequencers,",",lv)=redirectTo_$e("d",$p($$$mtSequencers,",",lv)["d") }
			else
			{	d lvtree^%qaqpnl("v",+$p($$$mtSequencers,",",lv)) }
		}
	}
	#; Replace any references in a subquery ORDER BY
	f lv=1:1:$l($g($$$mtSequencersQb(m)),",")-1
	{	if redirectFrom=+$p($$$mtSequencersQb(m),",",lv)
		{	s $p($$$mtSequencersQb(m),",",lv)=redirectTo_$e("d",$p($$$mtSequencersQb(m),",",lv)["d") }
		else
		{	d lvtree^%qaqpnl("v",+$p($$$mtSequencersQb(m),",",lv)) }
	}
	f lv=1:1:$$$maxv
	{	if $$$mtV(lv)=("n^^,^"_redirectFrom_"^") {
			s $p($$$mtV(lv),"^",4)=redirectTo
		}
	}
	RETURN
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
redirectRef	;  called with type,val,v,ev, and redirectFrom,redirectTo
	#;  replace all references of redirectFrom to redirectTo
	#;  Note:  no need to update v, which is still used in the lvarg recursion (might cause infinite loop!)
	RETURN:"ftsxin"[ev  ;  no operands to fix up
	n vpc  ;  *** do we need to do something for "n"?  ;  AK1019
	if "e"=ev {
		s vpc=$p(v,"^",4)
		f lv=1:1:$l(vpc,",")-1 s:$p(vpc,",",lv)=redirectFrom $p(vpc,",",lv)=redirectTo
		s $p($$$mtV(val),"^",4)=vpc
	}
	elseif "a"=ev {
		s:$p(v,"^",5)=redirectFrom $p($$$mtV(val),"^",5)=redirectTo
		s vpc=$p(v,"^",6) f lv=1:1:$l(vpc,",")-1 { s:$p(vpc,",",lv)=redirectFrom $p(vpc,",",lv)=redirectTo,$p($$$mtV(val),"^",6)=vpc }
		s vpc=$p(v,"^",7) f lv=1:1:$l(vpc,",")-1 { s:$p(vpc,",",lv)=redirectFrom $p(vpc,",",lv)=redirectTo,$p($$$mtV(val),"^",7)=vpc }
	}
	elseif "v"=ev {
		f lv=4:1:$l(v,"^")-1 { s:$p(v,"^",lv)=redirectFrom $p(mt(type,val),"^",lv)=redirectTo }
	}
	elseif "q"=ev {
		s:$p(v,"^",5)=redirectFrom $p($$$mtV(val),"^",5)=redirectTo
	}
	#; AK822
	GOTO lvarg^%qaqpnl  ;  JLF009-
	#; JLF015
expandClassMethods(m)
	n call,lgi,log,logs,trvals,foundMethod,str,i
	QUIT:$$$mtPQbIsActive(m)=0 
	set call = "expandClassMethodRef^%qaqpre2"
	set trvals = "", foundMethod = 0
	
	#; Expand all the class methods, but also mark the no-ops in noopList.
	#; The noopList is a list of values that are to be replaced by their
	#; first operand (in "^" piece 4)
	#;
	s logs=$g($$$mtWhere(m)) f lgi=$l(logs,"^")-1:-1:1 s log=$p(logs,"^",lgi) d lviter^%qaqpnl("l",log)
	s logs=$g($$$mtPartitionPredicates(m)) f lgi=$l(logs,"^")-1:-1:1 s log=$p(logs,"^",lgi) d lviter^%qaqpnl("l",log) //PVA304
	s log=$g($$$mtHaving(m)) d:log'="" lviter^%qaqpnl("l",log)
	if $$$mtOutputVals($g($$$mtOutput(m)))'=""
	{	for lgi=1:1:$l($$$mtOutputVals($g($$$mtOutput(m))),",")-1 set val = $p($$$mtOutputVals($$$mtOutput(m)),",",lgi) d lviter^%qaqpnl("v",val) 
	}
	s str="" for  // PVA348: Only needed for lateral, but harmless to do for all
	{  s str=$o($$$mtTvfParams(str),1,arglist) q:str=""  
	   continue:($$$mtRQb($$$mtR(str))'=m || (arglist=$c(0)))
	   for i=1:1:$ll(arglist) {s val=$lg(arglist) do:val lviter^%qaqpnl("v",val)}
	}
	if m=1,$g($$$mtSequencers)'=""
	{	for lgi=1:1:$l($g($$$mtSequencers),",")-1 set val = $p($$$mtSequencers,",",lgi) d lviter^%qaqpnl("v",+val) 
	}
	if $g($$$mtSequencersQb(m))'="" // PVA183: ORDER BY in subqueries
	{	for lgi=1:1:$l($g($$$mtSequencersQb(m)),",")-1 set val = $p($$$mtSequencersQb(m),",",lgi) d lviter^%qaqpnl("v",+val) 
	}
	
	#; Now go back over the noopList and bypass all no-op functions, if any exist
	#;
	do:$o(trvals(""))'="" fixrefs^%qaqpnl(m,"",.trvals,1)	// (JLF339)
	
	#; Expansion of the class method references can result in operations that
	#; can (only) now be recognized as being redundant
	#;
	d:foundMethod removeRedundant(m)			; can set mt("empty",m)
	QUIT
expandClassMethodRef  ;  called with type,val,v,ev
	n fcoll s fcoll=""
	if "ftx"[ev QUIT
	if "vl"[ev {
		if type="v","METHOD:*"=$e($p(v,"^",2),1,8) {
			#; On way up tree push special token to be processed when we have handled child nodes which will call same entry with 'ascend=0'
			if ascend=1 {
				do lviterpushdesc^%qaqpnl(type,val)
				GOTO lviterarg^%qaqpnl
			} else {
				n ifn,irn,str,qno,ttype,meth,fnode,ismeth,dt,method,prefix,similarity,fval
				s meth=val,prefix="",dt="",fval=""
				s method = $e($p($p($$$mtV(meth),"^",2),":",2),2,*)
				s similarity = $s(method="Similarity":1,1:0)
				s foundMethod = 1		// returned to caller
				
				#; The methods are inherited from the type class of the first
				#; argument, in "^" piece 4.
				#;
				#; For collection fields we may need to get the %ANYOFKEY field
				#; reference, which is recorded as a unary operation, with the
				#; identifying information in ":" pieces 4 and 5.  If ":" piece
				#; 3 is not supplied, then it is expected to be "^" parameter 4
				#;
				if $l($p($$$mtV(meth),"^",2),":")<3 
				{	s fval=$p($$$mtV(meth),"^",4) }
				elseif $p($p($$$mtV(meth),"^",2),":",3)="%ANYOFKEY"
				{	n bk s bk="",fval="" for  s bk=$o(mt("unary",bk)) q:bk=""  if $d(mt("unary",bk,$p($p($$$mtV(meth),"^",2),":",3,4))) { s fval=mt("unary",bk,$p($p($$$mtV(meth),"^",2),":",3,4)) quit }
					// assert fval'="" && $d($$$mtV(fval))
				}
				else 
				{ 	d error(309) }		// tbd - define a more informative error code
				s fnode = $$$mtV(fval)
	
				#; If this is a view output, look through the view to the mt("o",*) node that defines the view output
				n i,vo,vid,fvalDeep,fnodeDeep s fvalDeep=fval,fnodeDeep=fnode
				while ($e(fnodeDeep)="f" && $d($$$mtRVirtual($p(fnodeDeep,"^",2))))
				{	s fvalDeep=$$thruRMLSP^%qaqpqo1($lg($$$mtVirf(+$p(fnodeDeep,"^",3)),2)),fnodeDeep=$$$mtV(fvalDeep)
					if fnodeDeep["_" s fnodeDeep="" quit	// Disallow deep references through a collation function (or any expression)
				}
				s fvalDeep=$$thruRMLSP^%qaqpqo1(fvalDeep),fnodeDeep=$$$mtV(fvalDeep)  ;  AK1084
	
				if $e(fnodeDeep)="f"
				{
					s ifn=$p(fnodeDeep,"^",3),irn=$$$smdGetIrnFromIfn(+ifn),ttype=$$$smdTType(irn)
		#; JLF091
					if $$ismeth^%qadadt($$$smdClassname(ttype,irn),$$$smdColPropertyName(1,irn,+ifn)_method)=1
					{	s dt = $$$smdClassname(ttype,irn),prefix=$$$smdColPropertyName(1,irn,+ifn) }
					else
					{	s dt = $$$smdColDatatype(1,irn,+ifn) }
		#; JLF091-
					s str=$p(fnode,"^",2),fcoll=$$ddfun^%qaqpqo(fval)
					n langClass,simIdx,tLangClassTS s langClass="",simIdx="",tLangClassTS=""
					if ",ChooseSearchKey,Standardize,CreateQList,Similarity,"[(","_method_",")
					{	s langClass = $g($$$smd(ttype,irn,2,+ifn,"adtp","LANGUAGECLASS"))
						if langClass="" 
						{	s langClass=$g(^oddCOM(dt,$$$cCLASSproperty,$$$smdColPropertyName(1,irn,+ifn),$$$cCONSparameter,"LANGUAGECLASS"))
							s simIdx=$g(^oddCOM(dt,$$$cCLASSproperty,$$$smdColPropertyName(1,irn,+ifn),$$$cCONSparameter,"SIMILARITYINDEX"))
						}
						else
						{	s simIdx = $g($$$smd(ttype,irn,2,+ifn,"adtp","SIMILARITYINDEX")) }
	
						if langClass="" { d error(309) g doneExpandClassMethodRef }
						if $e(langClass)'="^" {
							set tLangClassTS=$g($$$comClassKeyRaw(langClass,$$$cCLASStimechanged)) 
							if tLangClassTS="" {
								for i=1:1:$$$LockTimeout {
									set tLangClassTS=$g($$$comClassKeyRaw(langClass,$$$cCLASStimechanged)) 
										#; if on the first try the timestamp is not defined, attempt to lock the class with a timeout of 0.  If we get the lock, the class is not currently being compiled and
										#; we have no idea if/when the class will be compiled.  Just release the lock immediately and report the error.
										#; We only wait on the timestamp if the class is locked, indicating it is being compiled.
									if i=1,tLangClassTS="" {
										lock +^oddDEF(langClass)#"S":0 
										if '$test { /* OK, it is locked, assume it is being compiled and wait for completetion or lock timeout */ } 
										else { lock -^oddDEF(langClass)#"SI" quit  }	// class is not locked, quit loop and fall through to error 150b below
									}
									quit:tLangClassTS'=""
									hang 1
								}
							}
							if tLangClassTS="" {
								new %class set %class=langClass
								do error("150b")	// Error message uses variable %class
							}
						}
	
						if $$$smdColStream(1,irn,+ifn),$l($p($$$mtV(meth),"^",2),":")>=3,$p($$$mtV(meth),"^",3)=",",$e(langClass)'="^"
						{	s dt=langClass,prefix="" }
	
					}
					#; %CONTAINS is an expensive predicate, and this is primarily because
					#; of the need to call Standardize on the rows that pass the index filter.
					#; If we are in a %CONTAINS operation and the property has STEMMING, 
					#; THESAURUS, and FILTERNOISEWORDS turned off, NUMERIC = 1, and 
					#; MINWORDLEN = 1 then Standardize is a no-op and can  be replaced 
					#; with its operand.
					#;
					if (method="Standardize") && (fnodeDeep=fnode) {
						new %ts2
						if ($$$comMemberKeyGet(langClass,$$$cCLASSparameter,"STEMMING",$$$cPARAMdefault)'="1")
						&& ($$$comMemberKeyGet(langClass,$$$cCLASSparameter,"THESAURUS",$$$cPARAMdefault)'="1")
						&& ($$$comMemberKeyGet(langClass,$$$cCLASSparameter,"FILTERNOISEWORDS",$$$cPARAMdefault)'="1")
						&& ($$$comMemberKeyGet(langClass,$$$cCLASSparameter,"NUMERIC",$$$cPARAMdefault)="1")
						&& (+$$$comMemberKeyGet(langClass,$$$cCLASSparameter,"MINWORDLEN",$$$cPARAMdefault)=1)
						{	if ($$$comMemberKeyGet(langClass,$$$cCLASSparameter,"CASEINSENSITIVE",$$$cPARAMdefault)'="1")
							{	s trvals(val) = $p($$$mtV(val),"^",4) }							// make the class method a no-op
							else
							{	s $$$mtV(val) = "v^%SQLUPPER^"_$p($$$mtV(val),"^",3,4)_"^" }	// just case-fold the operand
							set %ts2=$g($$$comClassKeyRaw(langClass,$$$cCLASStimechanged))
							if tLangClassTS'=%ts2 {
								new %class,%ts1
								set %class=langClass,%ts1=tLangClassTS
								do error("150a")	// Error message uses variable %class,%ts1,%ts2
							}
							g doneExpandClassMethodRef 
						} 
						set %ts2=$g($$$comClassKeyRaw(langClass,$$$cCLASStimechanged))
						if tLangClassTS'=%ts2 {
							new %class,%ts1 set %class=langClass,%ts1=tLangClassTS
							do error("150a")	// Error message uses variable %class,%ts1,%ts2
						}
					}
				
					#; Special case for %SIMILARITY: If SIMILARITYINDEX is non-null and the SimilarityIdx 
					#; method is defined, then use the index-based implementation of %SIMILARITY
					#; 
					if similarity && (fnodeDeep=fnode) && (simIdx'="")
					{	n imp,mapRef s imp=""
						#; Find the map that matches the irn and the specified name of the similarity index.
						for { s imp=$o($$$smd(12,imp)) q:((imp="")||((irn=$$$smdMapIrn(imp))&&(simIdx=$$$smdMapName(imp)))) }
						if imp'=""
						{	s method = "SimilarityIdx"
							s $p($$$mtV(meth),"^",4) = $$getidval(str) // $$$smdRowIDField(ttype,irn)
							s $p($$$mtV(meth),"^",6) = $p($$$mtV(meth),"^",5)_"^"				; move QList arg to piece 6
							; fill in piece 3 from pieces 4 and 6 (piece 5 is a constant)
							s $p($$$mtV(meth),"^",3) = $s($e($$$mtV($p($$$mtV(meth),"^",6)))="v":$p($$$mtV($p($$$mtV(meth),"^",6)),"^",3),1:",")_$p($$$mtV(meth),"^",4)_","
							s mapRef=$p($p($$$smdMapCompiledTopLevelPieces(imp),$c(1),2),$c(6))
							s mapRef=$p(mapRef,",",1,$s($l(mapRef,",")=1:1,1:$l(mapRef,",")-1))_")"
							s $p($$$mtV(meth),"^",5) = $$$newval("t^"_mapRef,1)
						}
					}
				}
	
				i $$ismeth^%qadadt(dt,prefix_method)'=1
				{	i ",ChooseSearchKey,Standardize,CreateQList,Standardize,"[(","_method_",")
					{ d error(309) }
					else
					{ n value s value=dt_"_"_prefix_method do error(118) }
				}
				
				if langClass'="",$$$smdColStream(1,irn,+ifn),$l($p($$$mtV(meth),"^",2),":")>=3,$p($$$mtV(meth),"^",3)=",",$e(langClass)'="^"
				{	s dt=langClass,prefix="" }
	
				s $p($$$mtV(meth),"^",2)="USERDEFINEDFUNCTION:"_$tr(dt,":^",$c(2,3))_":"_$tr(prefix_method,":^",$c(2,3))
				s:$d($$$mtVtrName(meth)) $$$mtVtrName(meth)=$p($$$mtV(meth),"^",2)
				
				if similarity
				{	s opn = $p($$$mtV(meth),"^",$s(method="SimilarityIdx":6,1:5))		; QList in piece 5 or piece 6
					s $p($$$mtV(opn),"^",2) = "USERDEFINEDFUNCTION:"_$tr(dt,":^",$c(2,3))_":"_$tr(prefix,":^",$c(2,3))_"CreateQList"
					s $p($$$mtV(opn),"^",5) = $$$newval("t^"_fcoll,1)
				}
	
				n udfArgVal s udfArgVal=$p($$$mtV(meth),"^",4)						// DPV3085
				if $e($g($$$mtV(udfArgVal)))="f" {
					s ifn=+$p($$$mtV($$thruRMLSP^%qaqpqo1($$realf(udfArgVal))),"^",3),irn=$$$smdGetIrnFromIfn(ifn)
					if $$$smdColStream(ttype,irn,ifn) {
							#; if this is a stream field the value will be a fully formed Oid.
							#; What we need to pass to BVA is the actual ID stored on disk, this value depends on the OIDType of the field.
							#; If needed, here I'll extract the on-disk ID value for the stream from the full Oid
						set:$$$smdColOIDType(ttype,irn,ifn)=1 p2=$p($$$mtV(meth),"^",2),$p(p2,":",1)="USERDEFINEDFUNCTIONs1",$p($$$mtV(meth),"^",2)=p2
						set:$$$smdColOIDType(ttype,irn,ifn)=2 p2=$p($$$mtV(meth),"^",2),$p(p2,":",1)="USERDEFINEDFUNCTIONs2",$p($$$mtV(meth),"^",2)=p2
					}
				}											// DPV3085-
			}
		} else {
			//The usual non-METHOD:* case
			GOTO lviterarg^%qaqpnl
		}
	}
	#; JLF214
realf(val)  
	n m,v f  s v=$$$mtV(val) QUIT:$e(v)'="f"  s m=$g($$$mtRVirtual($p(v,"^",2))) QUIT:'m  QUIT:'$$$mtPQbIsActive(m)  s v=$$$mtVirf(+$p(v,"^",3)) QUIT:'$li(v)  s val=$s($g($$$mtUnionTopQb(m))=m:$lg($$$mtUnionLegVals(m),$li(v)),1:$p($$$mtOutputVals($$$mtOutput(m)),",",$li(v)))
	QUIT val
	#; JLF214-
doneExpandClassMethodRef
	QUIT
	#; JLF015-
.
noOtherReferences(qb,pcf,corrlogs)  ;  $$: 1 if the correlated field pcf
	#;  (from outside qb) is not used anywhere within qb (including its
	#;  subqueries) other than within the conditions corrlogs=$LB(log)
	new call,isCorr,a,str,i s call="refPqbExpr^%qaqpre2",isCorr=""
	for a=1:1:$l($g($$$mtWhere(qb)),"^")-1 i '$lf(corrlogs,$p($$$mtWhere(qb),"^",a)) d lvtree^%qaqpnl("l",$p($$$mtWhere(qb),"^",a)) QUIT:isCorr
	QUIT:isCorr 0
	if $d($$$mtHaving(qb))
	{	n andList set andList = $$topLevelAnd^%qaqpre($$$mtHaving(sqb))
		for a=1:1:$l(andList,"^")-1 i '$lf(corrlogs,$p(andList,"^",a)) d lvtree^%qaqpnl("l",$p(andList,"^",a)) QUIT:isCorr
		QUIT:isCorr 0
	}
	if $d($$$mtOutput(qb)) for a=1:1 { s val=$p($$$mtOutputVals($$$mtOutput(qb)),",",a) q:val=""  d lvtree^%qaqpnl("v",val) q:isCorr } QUIT:isCorr 0
	s str="" for  // PVA348: Only needed for lateral, but harmless to do for all
	{  s str=$o($$$mtTvfParams(str),1,arglist) q:str=""  
	   continue:($$$mtRQb($$$mtR(str))'=qb || (arglist=$c(0)))
	   for i=1:1:$ll(arglist) {s val=$lg(arglist) do:val lvtree^%qaqpnl("v",val)}
	}
.
	if $d($$$mtLeftOuterJoins(qb)) for a=1:1 { s val=$p($$$mtLeftOuterJoins(qb),",",a) q:val=""  d lvtree^%qaqpnl("v",val) q:isCorr } QUIT:isCorr 0
	if $d($$$mtGroupDistinctList(qb)) for a=1:1 { s val=$p($$$mtGroupDistinctList(qb),",",a) q:val=""  d lvtree^%qaqpnl("v",val) q:isCorr } QUIT:isCorr 0
	#; Verify that there are no FROM-clause correlations inside query block qb
	n mm f mm=2:1:$$$mtPNumQbs i $$$mtPQbIsActive(mm),qb=+$$$mtP(mm),(","_$$$mtPCorrelatedFields($$$mtP(mm)))[(","_pcf_",") s isCorr=1 QUIT
	QUIT 'isCorr
.
refPqbExpr  ;  called with type,val,v,ev,isCorr,pcf
	//If n node points to "v" node, find its fields (in piece 3!)
	i ev="n" {
		n rval s rval = $p(v,"^",4)
		i rval=pcf { s isCorr=1 QUIT }
		//If referencing an expression, check its field list for the pcf
		n rv s rv = $$$mtV(rval)
		i $e(rv)="v",$p(rv,"^",3)[(","_pcf_",") { s isCorr=1 QUIT }
	}
	GOTO lvarg^%qaqpnl
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
removeRedundant(m)
	New call,canon,lc,lgi,mtList,mtList0,mtList1,nConj,nConj0,nConj1,nulog,p,v,ev,log	// DPV2473 (New nulog)
	set lc="",logs=$g($$$mtWhere(m))
	f lgi=$l(logs,"^")-1:-1:1
	{	s log=$p(logs,"^",lgi)
		#; Remove any expressions of the form NVL(nonNullible,value) with nonNullible
		#; 
		s call = "simplifyNvl^%qaqpre2"
		do lvtree^%qaqpnl("l",log)
		s canon=$$buildCanonical^%qaqpre("l",log,0,-1,"")
		if $lf(lc,canon)
		{	
			set $$$mtRedoFields = 1 // The following code always changes mt
			s $p($$$mtWhere(m),"^",lgi,*)=$p($$$mtWhere(m),"^",lgi+1,*)
			d:($d($$$mtStreamlessConds(m))&&($f($$$mtStreamlessConds(m),log_",")>0)) removec^%qaqpnl(log)
			s $$$mtL(log) = "i^removeDupLog^"_$$$mtL(log) 
		}
		else
		{	
			// The following code block could change mt; set $$$mtRedoFields to 1 if so
			s lc=lc_$lb(canon)
			set nConj1 = 0, nConj0 = 0, mtList1 = "", mtList0 = "", nulog = log
			set call = "knownAtCompileTime^%qaqpre2"
			do lvtree^%qaqpnl("l",log)		// search for and replace compile-time constant expressions
			i nConj0 > 0 s nConj = nConj0, mtList = mtList0 s nulog = $$PruneUnaryANDOR^%qaqpre("l",  log, 0 )
			i 'nulog || ((nulog=log) && (mtList0 '= "") && (log = $li($li(mtList0)))) k $$$mtWhere(m) s $$$mtEmpty(m)=1,nConj1=0 set $$$mtRedoFields = 1 q		// all-FALSE WHERE clause
			i nConj1 > 0 s nConj = nConj1, mtList = mtList1 s nulog = $$PruneUnaryANDOR^%qaqpre("l",nulog, 1 )
			if $d($$$mtWhere(m)) && ((nulog'=log) || ((nulog=log) && (((mtList0'="") && (log = $li($li(mtList0)))) || ((mtList1'="") && (log = $li($li(mtList1)))))))
			{	
				set $$$mtRedoFields = 1 // The following code always changes mt
				if 'nulog 
				{	s $p($$$mtWhere(m),"^",lgi,*)=$p($$$mtWhere(m),"^",lgi+1,*) } 
				else 
				{	if $$$mtLOperator($$$mtL(nulog))'="&"
					{	s $p($$$mtWhere(m),"^",lgi)=nulog }
					else
					{	s $p($$$mtWhere(m),"^",lgi)=$p($$$mtL(nulog),"^",4,5)
						s v=$$$mtL(nulog),ev=$e(v)
						#; If either operand is streamless, then add them to $$$mtStreamlessConds(m)
						s:$p(mt(ev,$p(v,"^",4)),"^",3)="," $$$mtStreamlessConds(m)=$g($$$mtStreamlessConds(m))_$p(v,"^",4)_","
						s:$p(mt(ev,$p(v,"^",5)),"^",3)="," $$$mtStreamlessConds(m)=$g($$$mtStreamlessConds(m))_$p(v,"^",5)_","
						s $$$mtL(nulog) = "i^PruneUnaryANDOR^"_$$$mtL(nulog)
					}
				}
			}
		}
	}
	k:($g($$$mtWhere(m))="") $$$mtWhere(m)		// if mt("w",m) becomes null, then kill it.
	do redoFields // EEE038: it's necessary to clear and redo fields after changing mt entries such as "v","l","w","c","empty" (e.g., removing conditions)
	quit
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; JLF010
redoFields
	RETURN:$g($$$mtRedoFields)'=1
	new m,mTopo
	do clearflds^%qaqpre3
	for mTopo=maxm:-1:1 {
		set m = $g(mt("qbo",mTopo))
		do:$$$mtPQbIsActive(m) flds^%qaqpnl
	}
	kill $$$mtRedoFields
	RETURN
simplifyNvl
	QUIT:("ftsxiq"[ev)
	;  called with type,val,v,ev,	mtList, nConj
	;  
	if ("vl" [ type) && (ev = "v")
	{	if ($p(v,"^",4)&&($p($$$mtV($p(v,"^",4)),"^",1,2)="v^NVL") && ('$$IsNullable^%qaqpre($p($$$mtV($p(v,"^",4)),"^",4)))) s $p(mt(type,val),"^",4)=$p($$$mtV($p(v,"^",4)),"^",4) set $$$mtRedoFields = 1	// DPV2500=; $$$mtRedoFields is used by redoFields^%qaqpre2()
		if ($p(v,"^",5)&&($p($$$mtV($p(v,"^",5)),"^",1,2)="v^NVL") && ('$$IsNullable^%qaqpre($p($$$mtV($p(v,"^",5)),"^",4)))) s $p(mt(type,val),"^",5)=$p($$$mtV($p(v,"^",5)),"^",4) set $$$mtRedoFields = 1	// DPV2500=; $$$mtRedoFields is used by redoFields^%qaqpre2()
	}
	#; AK822
	GOTO lvarg^%qaqpnl
knownAtCompileTime
	;  called with type,val,v,ev,	mtList, nConj
	;  
	QUIT:("ftsxiq"[ev)
	
	#; #IF 1	 JLF119
    #; fldX = fldX, fldX <> fldX
    if (type="l" && (ev="v")) //PVA097: eliminate bad test on piece 3 and set v to new node
    {	if $p(v,"^",2)="=",$p(v,"^",4)=$p(v,"^",5) { s mt(type,val)="v^'NULL^"_$p(v,"^",3,4)_"^",v=mt(type,val) set $$$mtRedoFields = 1 } // $$$mtRedoFields is used by redoFields^%qaqpre2()
    	elseif $p(v,"^",2)="'=",$p(v,"^",4)=$p(v,"^",5) { s mtList0 = mtList0 _ $lb($lb(val)), nConj0 = nConj0+1 }  // always FALSE
    }
    #; PVA097: moved this optimization later to catch case introduced by fld=fld
	if ("v" [ ev) && ($p(v,"^",2)="'NULL") && $p(v,"^",4) && '$$IsNullable^%qaqpre($p(v,"^",4))
	{	s mtList1 = mtList1 _ $lb($lb(val)), nConj1 = nConj1+1 }		// always TRUE
	if ("v" [ ev) && ($p(v,"^",2)="NULL") && $p(v,"^",4) && '$$IsNullable^%qaqpre($p(v,"^",4))
	{	s mtList0 = mtList0 _ $lb($lb(val)), nConj0 = nConj0+1 }		// always FALSE
	
	#; take care of null is null and null is not null cases
	if ("v" [ ev) && ($p(v,"^",2)="NULL") && $p(v,"^",4) && ($$$mtV($p(v,"^",4))="t^")
	{	s mtList1 = mtList1 _ $lb($lb(val)), nConj1 = nConj1+1 }		// always TRUE
	if ("v" [ ev) && ($p(v,"^",2)="'NULL") && $p(v,"^",4) && ($$$mtV($p(v,"^",4))="t^")
	{	s mtList0 = mtList0 _ $lb($lb(val)), nConj0 = nConj0+1 }		// always FALSE
 
    #; Streamless expressions
	if (type="l" && (ev="v") && ($p(v,"^",3)=","))
	{	n allLit,anySame,i s allLit=("t"[$e($$$mtV($p(v,"^",4)))),anySame=0 f i=5:1 q:$p(v,"^",i)=""  if "t"'[$e($$$mtV($p(v,"^",i))) { s allLit=0 } elseif $$$mtV($p(v,"^",4))=$$$mtV($p(v,"^",i)) { s anySame=1 }
		n truthValue
		if $$findRTPCTruthValueInfo(val,.truthValue){
			if truthValue {	
				s mtList1 = mtList1 _ $lb($lb(val)), nConj1 = nConj1+1 // always TRUE
			} else {	
				s mtList0 = mtList0 _ $lb($lb(val)), nConj0 = nConj0+1 // always FALSE 	
			}
		}
		elseif $p(v,"^",2)="'"
		{	quit			// we don't handle the explicitly negated cases yet, so exclude them for now
		}
		elseif $p(v,"^",2)="IN" || ($p(v,"^",2)="=")
		{	if anySame,allLit,($$$mtV($p(v,"^",4))'="t^")
			{	s mtList1 = mtList1 _ $lb($lb(val)), nConj1 = nConj1+1 }	// always TRUE
			elseif allLit
			{	s mtList0 = mtList0 _ $lb($lb(val)), nConj0 = nConj0+1 }	// always FALSE
		}
		elseif $p(v,"^",2)="'="
		{	if 'anySame,allLit,($$$mtV($p(v,"^",4))'="t^"),($$$mtV($p(v,"^",5))'="t^")
			{	s mtList1 = mtList1 _ $lb($lb(val)), nConj1 = nConj1+1 }	// always TRUE
			elseif allLit
			{	s mtList0 = mtList0 _ $lb($lb(val)), nConj0 = nConj0+1 }	// always FALSE
		}
		elseif $p(v,"^",2)="<"
		{	if "t"=$e($$$mtV($p(v,"^",5))),$e($$$mtV($p(v,"^",4)),1,11)="v^LENGTH^,^","t"=$e($$$mtV($p($$$mtV($p(v,"^",4)),"^",4)))
			{	if ($s($e($$$mtV($p($$$mtV($p(v,"^",4)),"^",4)),3,4)=$c(0):0,1:$length($$$mtV($p($$$mtV($p(v,"^",4)),"^",4)))-2))<(+$e($$$mtV($p(v,"^",5)),3,*)),$$$mtV($p($$$mtV($p(v,"^",4)),"^",4))'="t^"
				{	s mtList1 = mtList1 _ $lb($lb(val)), nConj1 = nConj1+1 }	// always TRUE
				else
				{	s mtList0 = mtList0 _ $lb($lb(val)), nConj0 = nConj0+1 }	// always FALSE
			}
		}
	}
.
	// Check vectors in comparison
	if (type="l" && (ev="v") && ("'<'>'="[$p(v,"^",2)) && ($$$VTRgetcat($p(v,"^",4))="VECTOR") && ($$$VTRgetcat($p(v,"^",5))="VECTOR")) {
		do:"'<'>"[$p(v,"^",2) error(266) // vector not supported for inequality operators
.
		// check length and datatype if both side of comparison are fields in the VECTOR category
		if (($$$VTRgettype($p(v,"^",4))="field") && ($$$VTRgettype($p(v,"^",5))="field")) {
			new arg1IFN,arg1IRN,arg2IFN,arg2IRN,t1,t2
			set arg1IFN = $$$VTRgetifn($p(v,"^",4)), arg2IFN = $$$VTRgetifn($p(v,"^",5))
			set arg1IRN = $$$VTRgetirn($p(v,"^",4)), arg2IRN = $$$VTRgetirn($p(v,"^",5))
			set t1 = $$$smdSchema(1,arg1IRN)_ "." _ $$$smdName(1,arg1IRN)
			set t2 = $$$smdSchema(1,arg2IRN)_ "." _ $$$smdName(1,arg2IRN)
			
			do:t1'=t2 error(264) // temporarily prevent logical conditions involving vectors and they are from different tables
			// if datatype mismatch
			if ($$$smdColVectorDatatype(1,arg1IRN,arg1IFN)'=$$$smdColVectorDatatype(1,arg2IRN,arg2IFN)) {
				set:$p(v,"^",2)="=" mtList0 = mtList0 _ $lb($lb(val)), nConj0 = nConj0+1 // always FALSE for =
				set:$p(v,"^",2)="'=" mtList1 = mtList1 _ $lb($lb(val)), nConj1 = nConj1+1 // always TRUE for '=
			}	
		}
	}
	#; #IF 1	 JLF119-
	#; AK822
	GOTO lvarg^%qaqpnl
	#; JLF010-
	#; JLF080
analyzeHavingClause
	new m, mTopo, logs, log, lgi, vals, val, vli, call
	#;  Push HAVING clause predicates into the WHERE clause, set up mts("AGG",m) node if all 
	#;  aggregates of a qb m are SQL-standard aggregates, and add TopN predicate if possible.
	#;  
	n foundNonStdAgg s foundNonStdAgg=""
	s call = "ansiAgg^%qaqpre"
	f mTopo=$$$mtPNumQbs:-1:1
	{	s m=mt("qbo",mTopo)
		continue:$$isLinked^%qaqpnl(m)
		i $$$mtPQbIsActive(m)
		{	
			#; Check if any of the aggregates are non-ANSI
			#;
			s vals=$p($g($$$mtP(m)),"^",3),foundNonStdAgg=0
			f vli=$l(vals,",")-1:-1:1 s val=$p(vals,",",vli) do lvtree^%qaqpnl("v",val)
	#; JLF069
			#; Verify that the SELECT list references only GROUP BY expressions or ANSI aggregates
			#;
			if 'foundNonStdAgg && $d($$$mtOutput(m)) && $d($$$mtGroupDistinctList(m))
			{
				s vals=$$$mtOutputVals($$$mtOutput(m))
				f vli=$l(vals,",")-1:-1:1 s val=$p(vals,",",vli) do lvtree^%qaqpnl("v",val)
			}
	#; JLF069-
			d:('foundNonStdAgg) simplifyHavingClause(m)
		}
	}
	QUIT
simplifyHavingClause(m)
	QUIT:'$d($$$mtHaving(m))
	new a,aggsPresent,andList,aVal,call,clc,containsAggs,fldList,fl,gbPresent,hList,hlog,lgi,log,moved,newFldList,saveWhr,val
	n inAllAggDistBy  // JLF069
	set andList = $$topLevelAnd^%qaqpre($$$mtHaving(m))
	set moved = "",hList="",aggsPresent=($$$mtPAggList($$$mtP(m))'=""),gbPresent=$d($$$mtGroupDistinctList(m)),call="containsAggFunc^%qaqpre2"
	for lgi=1:1:$l(andList,"^")-1
	{	s log = $p(andList,"^",lgi)
	#; JLF069
		s containsAggs="",inAllAggDistBy=1
		s fldList=$$$mtLColVals($$$mtL(log)),clc=","_log_","
		f a=1:1:$l($$$mtPAggList($$$mtP(m)),",")-1 
		{	s aVal=$p($$$mtPAggList($$$mtP(m)),",",a)
			if (","_$p($$$mtV(aVal),"^",6))'[clc { s inAllAggDistBy=0 quit }
		}
	#; JLF069-
		d:(aggsPresent && gbPresent) lvtree^%qaqpnl("l",log)	// Any aggregates referenced in this log?
		if 'aggsPresent || (gbPresent && 'containsAggs && inAllAggDistBy) // JLF069
		{	s $$$mtWhere(m) = $g($$$mtWhere(m))_log_"^"
			s moved = 1
		}
		else
		{	s hList = hList _ $lb(log)
		}
	}
	#; Reconstruct the HAVING clause, if necessary
	#;
	if moved
	{	if $ll(hList) = 0
		{	k $$$mtHaving(m)
		}
		elseif $ll(hList)=1
		{	s $$$mtHaving(m) = $li(hList,1)
		}
		else
		{	
			#; Construct a left-deep tree of the remaining logs in the HAVING clause,
			#; recursively union the field list in piece 3 as the tree is built
			#;
			s saveWhr = $g($$$mtWhere(m))
			s fldList = $$$mtLColVals($$$mtL($li(hList,1)))
			s newFldList = $$$mtLColVals($$$mtL($li(hList,2)))
			f fl=2:1:$l(newFldList)-1 s:($find(fldList,$p(newFldList,",",fl))=0) fldList = fldList _ $p(newFldList,",",fl) _ ","
			do nulog^%qaqpnl("l^&^"_fldList_"^"_$li(hList,1)_"^"_$li(hList,2)_"^")
			set hlog = log	; was val - changed 7/21/2004
			for lgi=3:1:$ll(hList)
			{	s newFldList = $$$mtLColVals($$$mtL($li(hList,lgi)))
				f fl=2:1:$l(newFldList)-1 s:($find(fldList,$p(newFldList,",",fl))=0) fldList = fldList _ $p(newFldList,",",fl) _ ","
				do nulog^%qaqpnl("l^&^"_fldList_"^"_hlog_"^"_$li(hList,lgi)_"^")
				set hlog = log	; was val - changed 7/21/2004
			}
			s $$$mtHaving(m) = hlog
			s:(saveWhr'="") $$$mtWhere(m) = saveWhr
		}	
	}
	QUIT
	#; JLF080-
containsAggFunc	;  called with type,val,v,ev, 	returnValue
	QUIT:("ftsxiq"[ev)
	if (ev="a") set containsAggs = 1 QUIT
	#; AK822
	GOTO lvarg^%qaqpnl
    #; PVA094: new routine recordw
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
recordw(log,strms,onum) // record field references in log to strms in ojx as "w" entries
                   // for ON clause number onum
                   // See PVA094 devlog entry for significance of this. 
    n lf,i
	s lf=$$$mtLColVals($$$mtL(log))
	for i=2:1 
    {  q:$p(lf,",",i)=""
	   s:$bit(strms,$p($$$mtV($p(lf,",",i)),"^",2))=1 ojx("w",$p(lf,",",i),onum)=""
	}
	QUIT
    #; PVA094: new routine recordo
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
recordo(log,strms,onum,oonum) // record field references in log to strms in ojx as "o" entries
                   // for ON clause number onum from ON clause oonum. Also record
                   // log in viewSpConds
                   // See PVA094 devlog entry for significance of this. 
    n lf,i
	s lf=$$$mtLColVals($$$mtL(log))
	for i=2:1 
    {  q:$p(lf,",",i)=""
	   s:$bit(strms,$p($$$mtV($p(lf,",",i)),"^",2))=1 ojx("o",$p(lf,",",i),oonum,onum)=""
	}
	s $bit(viewSpConds,log)=1
	QUIT
	#; PVA087: New routine killojs; replaces part of what was in 'outer' tag (PVA094 moved
	#;         to pre2). 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
killojs(m) // If null padded rows for an outer join would  be rejected by some condition
           // (as recorded in nopad), move outer join conditions to WHERE clause 
           // (converting to inner join), and remove any corresponding outer join 
           // structures. 
	n anykilled,lx,ly,i,str,con,log,ptlg,ocnt,op,lnp,rnp
	s anykilled=0
 
 
	//old style outer joins
	f lx=1:1 
	{	s log=$p(linx,"^",lx) q:'log  
		continue:'$$$mtLOperand2($$$mtL(log))
		continue:"f"'=$e($$$mtV($$$mtLOperand2($$$mtL(log)))) 
		continue:m'=$$$mtRQb($$$mtR($p($$$mtV($$$mtLOperand2($$$mtL(log))),"^",2)))
		s ptlg=$$$mtL(log),con=$p(ptlg,"^",5),str=$p($$$mtV(con),"^",2)
		continue:'$p(nopad,",",str)   
		s $$$mtWhere(m)=$$$mtWhere(m)_log_"^",anykilled=1
		s $p(linx,"^",lx,*)=$p(linx,"^",lx+1,*),lx=lx-1
		#; PVA108: fix up nulstr at the end, not here
	}
	//new style outer joins
	#; PVA092: New mt("ON",) structure
	#; PVA108: completely rewrite ON clause handling for FULL join, and LEFT with multi-stream arguments
	s ocnt="" f { s ocnt=$o($$$mtOn(m, ocnt),1,con) q:ocnt=""
	        s ly=$li(con,4),lx=$li(con,3),op=$li(con)
	        if op="LEFT" 
	        {  continue:'$$detnopad(ly)
			   s $$$mtWhere(m)=$$$mtWhere(m)_$li($$$mtOn(m, ocnt),2),anykilled=1
			   k $$$mtOn(m, ocnt)
	        }
	        if op="FULL"
	        {  s lnp=$$detnopad(lx),rnp=$$detnopad(ly)
	           if lnp&&rnp 
	           {  s $$$mtWhere(m)=$$$mtWhere(m)_$li($$$mtOn(m, ocnt),2),anykilled=1
			      k $$$mtOn(m, ocnt) continue
	           }
	           if lnp
	           {  s $li($$$mtOn(m, ocnt))="LEFT",anykilled=1 continue
	           }
	           if rnp
	           {  s $li($$$mtOn(m, ocnt))="LEFT",anykilled=1
	              s $li($$$mtOn(m, ocnt),3)=ly
	              s $li($$$mtOn(m, ocnt),4)=lx
	           }
	        }
	}
    d:anykilled resetnulstr(m),pointifyON^%qaqpre2(m) // PVA108: fix ups
    QUIT anykilled
    #; PVA108: new tag detnopad
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
detnopad(strnmlst)
    n i,str,dnp s dnp=0
    for i=1:1:$ll(strnmlst) { s str=$$$ptrel(m_"^"_$li(strnmlst,i)) set:$p(nopad,",",str) dnp=1 }
    QUIT dnp
    #; PVA108: new tag resetnulstr
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
resetnulstr(m)
    n i,str
    for i=$ll(nulstr):-1:1
    {  s str=$li(nulstr,i)
       if $$$mtRQb($$$mtR(str))=m s $li(nulstr,i,i+1)=$li(nulstr,i+1,i+1)
    }
    d setnulstr^%qaqpnl(m)
    QUIT 
	#; PVA094: New fucntion strs
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
strs(type,lv,latf="") // return bit string of streams referenced by l or v entry
	n strs,v,i,flds s strs=""
	s v=mt(type,lv)
	if "xt"[$e(v) {}
	elseif $e(v)="f" {s $bit(strs,$p(v,"^",2))=1 s:'$lf(latf,lv) latf=latf_$lb(lv) }
	else
	{  s flds=$p(v,"^",3)
	   for i=2:1 
	   {  s v=$p(flds,",",i) q:v=""
	      s $bit(strs,$p($$$mtV(v),"^",2))=1
	      s:'$lf(latf,v) latf=latf_$lb(v)  ;  AK850
	   }
	}
	QUIT strs
	#; PVA087: New routine 'strtoname' (PVA094 moved to pre2). 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
strtoname(str) // find ptrlel label for a stream and return name following query number
	new n,s
	set n=""
	for {
		set n = $o($$$ptrel(n),1,s) 
		QUIT:n=""
		QUIT:s=str
	}
	RETURN $p(n,"^",2,*)
	#; PVA087: new routine findidval (PVA094 moved to pre2)
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
findidval(str) // find the rowid val for str in query m, if it exists (else return 0)
	#; JLF125
	n i,idValInM,sqn,savm
	#; PVA106: set sqn, save/restore m around getidval
	s sqn=$$$mtRQb($$$mtR(str)),savm=m,m=sqn,idValInM=$$getidval(str),m=savm
	QUIT:m=sqn idValInM		// We already know the ID val in m, so just return it
	for i=1:1 {	if $p($$$mtOutputVals($g($$$mtOutput(sqn))),",",i)=idValInM s idValInM=$$$mtPViewIDVal($$$mtP(sqn))+i q }
	if $g($$$mtRVirtual($p($$$mtV(idValInM),"^",2)))'=sqn QUIT 0 // in case piece 8 was empty
	QUIT idValInM
	#; JLF125-
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
getidval(str)
    #; PVA162: change to use SMD to get rowid because mts(qno,str) may not exist yet for 
    #;         usage for this from fvals from cr8strview. New usage introduced by PVA161.
	QUIT $s($g($$$mtRVirtual(str)):$$$mtPViewIDVal($$$mtP($$$mtRVirtual(str))),1:$$nufld^%qaqpqo(str,$$$smdRowIDField(1,+$$$mtR(str))))
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA099: new routine mergeviews
mergeviews(m,donull)
	#; donull flag indicates whether mergviews should do null analysis (notnullw/h). If called after null
	#;   analysis is done for m, it is necessary to call with this flag on (PVA291 added)
	n anymerged,vn,str,sqb,ocnt,lx,ly,dqv
	s anymerged=0
	   s vn=m_"^" for i=1:1
	   {  s vn=$o($$$ptrel(vn),1,str) q:vn=""  q:$p(vn,"^")'=m 
	      s sqb=$g($$$mtRVirtual(str)) continue:sqb=""  continue:$d($$$mtDupsv(sqb))
	      #; PVA231: Also, can't merge sqb if it has been duplicated
	      s dqv="" f  s dqv=$o($$$mtDupsv(dqv)) q:dqv=""  q:$$$mtDupsv(dqv)=sqb
		  continue:$O(mt("tsml",0))>1
          continue:dqv]""
	#; AK721
		continue:$g($$$mtDSNLinkedTable(sqb))'=""  ;  linked subquery - keep intact 
	      #; NOTE: merging a shard top into a parent query is desirable as is merging anything into a shard top
.
	      #; skip if irreducible
		  continue:$d($$$mtOneRow(sqb)) // PVA198: in case all refs to aggs optimized away - onerow still semantically 
		                              //   prevents merge.
	      continue:$$$mtPAggList($$$mtP(sqb))]""||($e($$$mtOutput(sqb))="d")||$d($$$mtUnion(sqb))
	      continue:$$windowsInSubq^%qaqpagg(sqb)
	      continue:$$hasPagination^%qaqpsq(sqb)||$d($$$mtSequencersQb(sqb)) // PVA183
	      continue:$$linxrefs(sqb) // PVA299
	      continue:$$vidrefs^%qaqpre3(sqb) // can't merge if view id referenced (pva115) // PVA231: vidrefs changed to one argument
	      #;if '$lf(nulstr,str) { if $g(mt("empty",sqb)){ s mt("empty",m)=1 RETURN 0} s:'$$mrgstrview(sqb,m,donull) anymerged=1  }
	      if '$lf(nulstr,str) { s:'$$mrgstrview(sqb,m,donull) anymerged=1 if $g($$$mtEmpty(sqb)){ s $$$mtEmpty(m)=1 RETURN 0} }
	      elseif $$numstr^%qaqpnl(sqb)=1 
	      {   // find ON clause for which str is rhs
			  s ocnt="" f   // if in linx, we won't find it, and couldn't merge it anyway
			  {  s ocnt=$o($$$mtOn(m, ocnt),1,lx) q:ocnt=""
			     #; This could be generalized but, for now, the most common case.
			     #; PVA115: Fix this special merge case to be correct in presence of RIGHT/FULL join
			     continue:$li(lx)'="LEFT"
	   			 s ly=$li(lx,4) continue:$ll(ly)>1  quit:$li(ly)=$p(vn,"^",2,*)
	          }
	          if ocnt,'$$badselexps(sqb),'$$mrgstrview(sqb,m,donull,ocnt) s anymerged=1 // PVA300: badselexps
	      }
	   }	
	QUIT anymerged
 
	#; PVA099: new routine mrgstrview
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
mrgstrview(sqb,pqb,donull,ocnt) // merge sqb into pqb
                    #; return 0 for success, 1 for failure 
					#; donull flag indicates whether mergviews should do null analysis (notnullw/h). If called after null
					#;   analysis is done for pqb, it is necessary to call with this flag on (PVA291 added)
                    #; ocnt is optional. It specifies the ON clause counter for an ON
                    #;    clause mt("w",sqb) should be merged with. Normally, this 
                    #;    function would merge mt("w",sqb) with mt("w",pqb)
	#; CRITICAL: It is an error to call this for an sqb that has mts("streamorder",sqb)
	#;           defined unless pqb does as well (function return for failure if you do). Also,
	#;           note that as of 2007.2.x,
	#;           the behavior %inorder in a query against a reducible view will change 
	#;           when the view does not specify %inorder. If we
	#;           happen not to merge such a view, the behavior will be as before. However, if
	#;           we merge it, the merged tables will be completely unconstrained as to
	#;           processing order. This change will become manifest when we stream all views,
	#;           then later merge them when possible. Note, the prior behavior is readily 
	#;           achievable by putting %inorder in the view as well as the query against it.
	#;           
	#;           Currently, this utility only works from after flds processing up to before
	#;           xfrmON (that is, source and target must be in this parse tree state). 
	#;           Later, this will be extended to work after propagatePreds, e.g. by handling
	#;           $$$mtLeftOuterJoins() as well as linx. This routine is never intended to be used
	#;           within xfrmON. 
	#;           
	#;           NOTE: linx are dealt with within fixrefs and flds. EXTENDING this utility
	#;           to work after conds/outer/class would require flds and fixrefs being changed
	#;           to know about $$$mtLeftOuterJoins() as well as linx. Thus, use of flds, in its current
	#;           state, after outer^%qaqpnl, is incorrect. 
	#;           
	#;           Note: It is assumed that mt("dups",pqb) does not need adjustment. There is
	#;           no known case where this would be necessary. 
	#;           
	n str,vn,label,i,fval,x,sqbstr,mlabel,lx,lxt,ly,lyt,n,sqstlbls,sqblbl,sqstrms,trvals,val,v,ov,oval,fn,mtarg
	s fval=$$$mtPViewIDVal($$$mtP(sqb))
	s sqbstr=$p($$$mtV(fval),"^",2) // PVA208: move this early for new tests
	if $$hint^%qaqpre("%NOREDUCE",sqb) QUIT 1 // PVA298
    if $d(mts("streamorder",sqb))&&'$d(mts("streamorder",pqb)) QUIT 1	
    #; PVA208: Many new cases (see devchange) for inorder/starttable combinations
    if $d(mts("streamorder",sqb))&&'$d(mt("hint",sqb,"%STARTTABLE"))&&'$lf(mts("streamorder",pqb),sqbstr) QUIT 1
    if $d(mts("streamorder",pqb))&&'$d(mt("hint",pqb,"%STARTTABLE"))&&$d(mt("hint",sqb,"%STARTTABLE")) QUIT 1
    if $d(mt("hint",pqb,"%STARTTABLE"))&&'$d(mts("streamorder",sqb))&&(sqbstr=$li(mts("streamorder",pqb))) QUIT 1
    if $d(mt("hint",pqb,"%STARTTABLE"))&&$d(mts("streamorder",sqb))&&'$d(mt("hint",sqb,"%STARTTABLE")) QUIT 1
    if $d(mt("hint",pqb,"%STARTTABLE"))&&$d(mt("hint",sqb,"%STARTTABLE"))&&(sqbstr'=$li(mts("streamorder",pqb))) QUIT 1
    if ('$$oksubq^%qaqpagg(pqb,1)||$$shardcontext^%qaqpre(pqb)) && $$isShardedTop^%qaqpnl(sqb) QUIT 1
    s sqstlbls="",sqstrms=""
	#;  decision made to do the merge!
	#;  populate latxn(xval)=$LB(refqn,latf,latfs,latfm,latvm,latvs)
	#;  for latf in a tvf() argument, latvm="", latvs is the tvf str#, and,
	#;  unless latf is found in a subquery within the argument, refqn=latfm
	n latxn,refqn,latf,latfs,latfm,latvm,latvs,call s call="findxNN^%qaqpre2"
	d subqtree^%qaqpag(sqb)  ;  AK850
	#;  A. using latxn(xval), find all latf nodes in sqb, and convert
	#;  them into their target node, or into an "n" node pointing to the
	#;  same target, or no change (respectively if found in sqb itself, or
	#;  in a non-FROM subquery of sqb, or in a FROM subquery of sqb)
	s call="x2f^%qaqpre2" d:$d(latxn)>1 lvqbmod^%qaqpnl(sqb)  ;  convert x in sqb itself
	s i="" f {  ;  convert x references in sqb non-FROM subqueries
		s i=$o(latxn(i),1,latxn) 
		QUIT:'i
		s $LB(refqn,latf,latfs,latfm,latvm,latvs)=latxn
		CONTINUE:latfm'=pqb
		CONTINUE:latvm'=sqb  ;  case A - "x" pointing from within sqb to earlier tables in pqb's FROM
		#;  1. xval found in sqb itself - already replaced above with f
		i refqn=sqb { s $$$mtV(i)="i^mrgvxNN^"_i }
		else {
 			#;  2. xval found in sqb's non-FROM subquery - replace x with("n"->f)
 			#;     Note: sqb subqueries already repointed to pqb above!
			s n=refqn
			f  { s n=$$$mtCorrParentQb(n) QUIT:'n  i n=sqb { s $$$mtV(i)="n^^,^"_latf QUIT } }
			#;  3. xval found within sqb's FROM subquery - no-op
		}
	}
	#;  B. find all latf references to sqb's view fields, in later views or
	#;  tvf's, replace them with a clone of the viewfield expression, while
	#;  converting plain fields within the expression to new latf x^NN
	#;  references (also need to convert any latf x^NN reference within a
	#;  subquery within this expression into n^NN references - this is
	#;  already done by step A.2. above!)
	s call="klonef2x^%qaqpre2"  ;  also uses latxn(xval)
	f i=1:1:$$$maxv {  ;  case B - "x" pointing to an sqb view-field
		s x=$$$mtV(i)
		if $p(x,"^",1)'="x"||('$isvalidnum($e(x,3,*),0,1)) { CONTINUE }
		s latf=$e(x,3,*)  ;  that reference sqb view-fields
		CONTINUE:sqbstr'=$p($$$mtV(latf),"^",2)
		s oval=$li($$$mtVirf(+$p($$$mtV(latf),"^",3)),2),ov=$$$mtV(oval)
		i $e(ov)="f" { s $$$mtV(i)="x^"_oval CONTINUE }  ;  was "x^"_latf
		s $$$mtV(i)=$$$mtV($$lvtreemod^%qaqpnl("v",oval))
	}
	if donull {d notnullw^%qaqpnl(sqb,1) s:$d($$$mtHaving(sqb)) $$$mtHaving(sqb)=$$notnullh^%qaqpnl($$$mtHaving(sqb))}
 
 	#; deactivate sqb and its stream
	s $$$mtPQbIsActive(sqb)=0 
	s ptj(pqb,1)=$p(ptj(pqb,1),","_sqbstr_",")_","_$p(ptj(pqb,1),","_sqbstr_",",2)
	s $$$mtR(sqbstr)="0^0" // current method of killing a stream
	k mts(pqb,sqbstr)
	s sqblbl=$$strtoname(sqbstr),mlabel=pqb_"^"_sqblbl
	#; PVA139: If sqb stream is only one in top query, clear some mtc info so it 
	#;         can be reset properly as sqb is merged. 
	#; PVA149: Adjust this criterion for query INSERT case
	if $$$mtStatementType'="INS" {s mtarg=(mlabel=$g($$$mtTarget))} else {s mtarg=0}  // PVA198: INSERT target will never be merged or even run as a query
	if pqb=1,$p(ptj(1,1),"^",2)=",",mcurs]"",$$$mtStatementType'="INS"||mtarg k mtc(mcurs,"f")
	k $$$ptrel(mlabel),$$$mtFromTableName(mlabel)
.
 	#; PVA139: Check that stream merged into target does not have multiple streams
 	i mtarg,$$numstr^%qaqpnl(sqb)>1 s $$$mtK="" d error(35)
	// The last node of mt("ON",sqb,) includes the left & right JOIN tables' stream labels in the order they appear in the subquery before it's merged.
	// For proper replacement of lists of labels in fixstrmrefs^%qaqpre2() later on, sqstlbls must retain the order in which the tables appear in the initial mt("ON") entries.
	// Other labels not appearing in mt("ON") for this subquery sqb (TODO: e.g., cross JOINs) will be handled in the loop below that scans %ptrel.
	new labelIdx,lastOnNode
	if $o(mt("ON",sqb,""),-1,lastOnNode)'="" {
		set labelIdx = 0
		set label = ""
		while $listnext($li(lastOnNode,3)_$li(lastOnNode,4),labelIdx,label) {
			// label should change from tableName to sqb,tableName since the new label should include the sqb after
			// merging this view into the parent subquery pqb (see in loop below how vn is sqb^ that gets changed into sqb,)
			set sqstlbls = sqstlbls_$lb(sqb_","_label)
		}
	}
	// move sqb's streams to pqb
	s vn=sqb_"^" for 
	{  s vn=$o($$$ptrel(vn),1,str) q:vn=""  q:$p(vn,"^")'=sqb 
	   s sqstrms=sqstrms_$lb(str)
	   s label=$TR(vn,"^",",") // for now copy this stupid convention; hopefully
	                           #;   we can eliminate later
	   s $$$ptrel(pqb_"^"_label)=str
	   #; JMM996: If rebalancing is in progress and this is a non-cosharded join, 
	   #; create a cross reference from the label used for this table stream's shref, to the
	   #; view's stream name ("T1", "T2", etc.) under which the sharding manager stores
	   #; the extended reference prefixes for shard local tables.
	   #; Note: If %ISCSNRemoteTables is defined, we must be in a shard-local query,
	   #; so any view we encounter must be a shard-map screening view.
	   if $d(%ISCSNRemoteTables) && $$$SSQueryRebalancingInProgress { // JMM996+
			n viewstrname
			s viewstrname=$p(mlabel,"^",2)
			if $d(%ISCSNRemoteTables(viewstrname)) {
				s %ISCSNRemoteTables(label,"alias")=viewstrname
			}
	   } // JMM996-
	   k $$$ptrel(vn)
	   s $$$mtRQb($$$mtR(str))=pqb
	   s ptj(pqb,1)=ptj(pqb,1)_str_","
	   merge mts(pqb,str)=mts(sqb,str)
	   #; PVA139: set up mtc information as is done in putstr^%qaqpqo. Also mt("target" change)
	   i mcurs'="",pqb=1,vn'["->",$D($$$mtFromTableName(vn)),($$$mtStatementType="DEC")||(($g(mtc(mcurs,"f"))="")&&(mlabel=$g($$$mtTarget))) { // DPV3258 (vn'["->")
			// update mtc(mcurs,"f") if it is "" in the case for INS/UPD/DEL
			if ('$D(mtc(mcurs,"f"))||((" INS UPD DEL "[(" "_$$$mtStatementType_" "))&&($g(mtc(mcurs,"f"))="")))&&'$d($$$mtUnion(1))&&'$g($$$mtOneRow(1))&&'$g($$$mtGroupDistinctList(1))&&($g($$$mtOutput(1))'["d"&&'$d($$$mtRVirtual(str))) {
				set mtc(mcurs,"f")=str_","_$$$mtRIrn($$$mtR(str))_","_$$$mtFromTableName(vn)	
			} else {
				set mtc(mcurs,"f")=""
			}
	   }
	   s:(mlabel=$g($$$mtTarget)) $$$mtTarget=pqb_"^"_label
	   k mts(sqb,str)
	   #; Note that we don't bother with mt("flbls") as this should only really
	   #;  be used or needed during parsing for resolving column references
	   #;  For example, it is never corrected when a view is streamed during
	   #;  parsing. We also don't bother with mt("from"). It isn't really needed 
	   #;  after being used to set up mts("streamorder"). We do set up mt("f") 
	   #;  as it is used in code generation for cursor update statements, 
	   #;  among other things. 
	   
	    // Handle tables that were not handled when sqstlbls was populated earlier
		if '$lf(sqstlbls,label) {
			set sqstlbls=sqstlbls_$lb(label) // for use in updating arg lists of ON clauses
		}
	   s:vn'["->"&&($d($$$mtFromTableName(vn))) $$$mtFromTableName(pqb_"^"_label)=$$$mtFromTableName(vn) // PVA121: $$$mtFromTableName(vn) might not exist if implicit joins used	// DPV3258 (vn'["->")
	   if $d($$$FTByLabel(vn)) {
			do copyFTInformation^%qaqpftpd(str, 0, vn, pqb_"^"_label, 1)
	   }
	}
	k ptj(sqb,1)
	
	// adjust mts("streamorder",)
	#; PVA208: Given the new logic about when to allow merge, the actual streamorder
	#;         adjustment logic needs no changes.
	if $d(mts("streamorder",pqb))
	{  s i=$lf(mts("streamorder",pqb),sqbstr)
	   if $d(mts("streamorder",sqb))
	   { s:i x=mts("streamorder",pqb),$li(x,i,i)=mts("streamorder",sqb),mts("streamorder",pqb)=x }
	   else // PVA108: fix typo below
	   {  s:i x=mts("streamorder",pqb),$li(x,i,i+1)=$li(x,i+1,i+1),mts("streamorder",pqb)=x }
	}
		
	// repoint queries directly contained in sqb to pqb
	f i=1:1:$$$mtPNumQbs if $$$mtPQbIsActive(i) s:+$$$mtP(i)=sqb $p($$$mtP(i),"^")=pqb 
	f i=1:1:$$$mtPNumQbs if $$$mtPQbIsActive(i)&&($$$mtCorrParentQb(i)=sqb) s $$$mtCorrParentQb(i)=pqb,x=m,m=i d flds^%qaqpnl s m=x
 
	// retarget ptv entries to new query
	for i=1:1:$$$maxv { continue:'$d(ptv(i))  s:$p(ptv(i),"^",7)=sqb $p(ptv(i),"^",7)=pqb }
	#; dont' worry about ptln - not used after 'field' transform to parse tree
	#; don't worry about vtr query number field; it is not used. 
 
	#; Fix up nulstr if sqbstr in it: add new, delete old
	s:$lf(nulstr,sqbstr) nulstr=nulstr_sqstrms
	for  // multiple instances of same stream allowed in nulstr
	{  s i=$lf(nulstr,sqbstr) q:'i
	   s $li(nulstr,i,i+1)=$li(nulstr,i+1,i+1)
	}
	
 
 	#; Adjust stream argument lists of mt("ON",) nodes
	s n="" f 
	{  s n=$o($$$mtOn(pqb, n),1,lx) q:n=""
	   s ly=$li(lx,4),lx=$li(lx,3)
	   s i=$lf(lx,sqblbl) s:i $li(lx,i,i)=sqstlbls
	   s i=$lf(ly,sqblbl) s:i $li(ly,i,i)=sqstlbls
	   s $li($$$mtOn(pqb, n),3,4)=$lb(lx,ly)
	}
 
 	#; Move ON clauses from sqb to pqb (it is caller's responsibiltity to ensure that this
 	#;   is valid, i.e. sqb should not be merged if this is not valid).
	s n="" f 
	{  s n=$o($$$mtOn(sqb, n),1,lx) q:n=""
	   s ly=$li(lx,4),lx=$li(lx,3)
	   s lxt="" f i=1:1:$ll(lx) s lxt=lxt_$lb(sqb_","_$li(lx,i))
	   s lyt="" f i=1:1:$ll(ly) s lyt=lyt_$lb(sqb_","_$li(ly,i))
	   s $$$mtOn(pqb, n)=$li($$$mtOn(sqb, n),1,2)_$lb(lxt)_$lb(lyt)
	   k $$$mtOn(sqb, n) 
	}
	// Retarget refs to virtual fields, everywhere in sql statement, to underlying vals.
	for i=1:1:$$$maxv 
	{  s x=$g($$$mtV(i)) 
		if $p(x,"^",1,2)=("f^"_sqbstr) 
		{  continue:i=fval
	      s oval=$li($$$mtVirf(+$p(x,"^",3)),2),ov=$$$mtV(oval)
	   	  if x["_%ANYOF" { if ov'["_" { s oval=$$thruRMLSP^%qaqpqo1(oval),ov=$$$mtV(oval),fn=$p(x,"_",2,3) d nufun^%qaqpqo(ov) s trvals(i)=val } else { d error(309) } }
	      elseif x["_" {s trvals(i)=$$coll^%qaqpqo(oval,$p(x,"_",2))}
	      else { s trvals(i)=oval }
 		  #; PVA139: Check that UPDATE target query does not project non-fields
 	      i mtarg,$e($$$mtV(trvals(i)))'="f" { s $$$mtK="" d error(35) }
		}
	}
 	d fixrefs^%qaqpnl(pqb,"",.trvals,0,0,1) // PVA174: add dostrms
	do replaceAggExpr(pqb)
	if $g(ocnt) s $li($$$mtOn(pqb, ocnt),2)=$li($$$mtOn(pqb, ocnt),2)_$g($$$mtWhere(sqb))
 	else  s $$$mtWhere(pqb)=$g($$$mtWhere(pqb))_$g($$$mtWhere(sqb)) k:$$$mtWhere(pqb)="" $$$mtWhere(pqb)
 	
 	s mt("complexlog",pqb) = $g(mt("complexlog",pqb)) _ $g(mt("complexlog",sqb)) k:mt("complexlog",pqb)="" mt("complexlog",pqb)
 	k mt("complexlog",sqb)
 	k $$$mtWhere(sqb)
 	 
 	s x=m,m=pqb d flds^%qaqpnl s m=x
 	
 	#; PVA120: If merging to top query, must re-do $$$mtSequencers ORDER BY optimizations
	if pqb=1 && ($d($$$mtSequencers)#10) { // PVA183: Adust for $$$mtSequencers having subnodes: full $d() and zkill
	   f i=2:1 s val=+$p($$$mtSequencers,",",i) q:'val  s:","_$TR($p($$$mtSequencers,",",1,i-1),"d")_","[(","_val_",") $p($$$mtSequencers,",",i,*)=$p($$$mtSequencers,",",i+1,*),i=i-1
	   s $$$mtSequencers=$$prunesort^%qaqpnl($$$mtSequencers)
	   ZKILL:$$$mtSequencers="" $$$mtSequencers  ;  as if never was there
	}
	if $d($$$mtSequencersQb(pqb)) { // PVA183: Also for ORDER BY in subqueries
	   f i=2:1 s val=+$p($g($$$mtSequencersQb(pqb)),",",i) q:'val  s:","_$TR($p($$$mtSequencersQb(pqb),",",1,i-1),"d")_","[(","_val_",") $p($$$mtSequencersQb(pqb),",",i,*)=$p($$$mtSequencersQb(pqb),",",i+1,*),i=i-1
	   s $$$mtSequencersQb(pqb)=$$prunesort^%qaqpnl($$$mtSequencersQb(pqb))
	   KILL:$g($$$mtSequencersQb(pqb),0)="" $$$mtSequencersQb(pqb)  ;  as if never was there
	}
 
	for i=1:1:$$$maxv s x=$g($$$mtV(i)) if $p(x,"^",1,2)=("f^"_sqbstr) s $$$mtV(i)="i^strmrg",pti(i)="<obsolete>" k ptv(i)
 
    d pointifyON^%qaqpre2(pqb) // PVA108
    d resetnulstr(pqb) // PVA300
    d:($$isShardedTop^%qaqpnl(pqb) || $$isShardedTop^%qaqpnl(sqb)) shardown^%qaqpnl(pqb)
      #; We need to call shardown any time the shard tuple structure of pqb may change (PVA342)
	// outer references to sqb will not need adjustmet - fval numbers they
	//    point to will remain valid. Nor will pqb's arguments ($$$mtP(pqb) piece 4) 
	//    need adjusting. 
	// Note, there can be no outer references from sqb to pqb if it is valid to 
	//    merge them. 
 	QUIT 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
replaceAggExpr(pqb) [mt] public
	#; replaceAggExpr finds all expressions which will need to be evaluated multiple
	#; times, due to being part of the SELECT list as well as the argument of aggregation
	#; it then duplicates the mt("v") nodes for those expressions, replacing that value in
	#; $$$mtOutput(pqb) for the SELECT list of the parent query
    {
		#; extract and loop through all aggregates for parent qb
		RETURN:'$data($$$mtOutput(pqb))
		set pqbOutput = ","_$piece($$$mtOutput(pqb), "^",2)
		set aggregateList = $piece(mt("p", pqb), "^", 3)
		for i=1:1:$length(aggregateList, ",")-1 {
			set agg = $$$mtV($piece(aggregateList, ",", i))
			set aggVals = $piece(agg, "^", 6)_$piece(agg, "^", 7)_$piece(agg, "^", 5)_","
			#; loop through every aggregate argument
			for j = 1:1:$length(aggVals, ",")-1 {
				set val = $piece(aggVals, ",", j)
				#; check if the agg argument is part of the SELECT list
				#; check the agg argument is an expression
				continue:'(pqbOutput[(","_val_","))
				continue:'($extract($$$mtV(val))="v")
				set newVal = $$$newval($$$mtV(val),1)
				set pqbOutput = $replace(pqbOutput, ","_val_",", ","_newVal_",")
			}
		}
		set $piece($$$mtOutput(pqb), "^", 2) = $piece(pqbOutput, ",", 2, *)
		RETURN
	}
.
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
latm(m)	;  $$: list of lateral fields used in m from outside of m  ;  AK850
	#;  use subqtree->lvsubquery->findxNN to populate latxn() with all
	#;  lateral fields within m  , and then find those from outside of m
	RETURN:m=1 ""
	n latxn,call,n,supq,latm,xval,latf,latfm s call="findxNN^%qaqpre2",supq="",latm=""
	d subqtree^%qaqpag(m)  ;  AK850
	s n=m f  { s n=+$$$mtP(n) QUIT:'n  s supq=supq_$lb(n) }
	s xval="" f {
		s xval=$o(latxn(xval),1,latxn) 
		QUIT:'xval
		s $lb(,latf,,latfm)=latxn
		s:$lf(supq,latfm) latm=latm_$lb(latf)
	}
	RETURN latm
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
findxNN	;  lviter() call back, coming in with type,val,v,ev  ;  AK850
	#;  also input from lvsubquery^%qaqpag() qn=q# where this val was found
	#;  For any "x^NN" lateral field reference found in refqn,
	#;  populate latxn(val)=$LB(refqn,latf,latfs,latfm,latvm,latvs)
	#;  For latf in a tvf() argument, latvm="" and latvs is the tvf str#
	#;  Note that latvm="" can only happen if the lateral reference is in a
	#;  subquery inside a tvf() argument, since plain lateral references
	#;  in a tvf() argument don't use x^NN nodes!
	i ev="x",v=("x^"_+$e(v,3,*)),v'="x^0" { s latxn(val)=$$latxn(v,qn) RETURN }
	GOTO lviterarg^%qaqpnl
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
latxn(v,qn)  ;  $$: $LB(qn,latf,latfs,latfm,latvm,latvs) for lateral reference
	#;  v="x^NN" found in subquery qn where:
	#;  latf=val# of the lateral field we're referencing
	#;  latfs=str# of this field
	#;  latfm=q# that this stream/field is part of
	#;  latvm=q# of the view within latfm that references this field
	#;       or "" if qn is within a latfm tvf() argument
	#;  latvs=str# of that view (or tvf) within latfm
	n latf,latfs,latfm,latvm,latvs,qq
	s latf=$e(v,3,*),latfm=$$$mtV(latf),latfs=$p(latfm,"^",2),latfm=$$$mtRQb($$$mtR(latfs))
	#;  find latvm=q# of the highest view that contains this latf
	s qq=qn f  { s latvm=qq,qq=+$$$mtP(qq) QUIT:qq=latfm  QUIT:'qq }  ;  qq=0 should never happen
	i $d($$$mtUnionTopQb(latvm),latvm) { }  ;  if from a later union leg
	#;  check if in a subquery inside a tvf() argument
	RETURN:$$$mtCorrParentQb(latvm)=latfm $LB(qn,latf,latfs,latfm,"",$$tvfstr(latfm,$$$mtPQbVal($$$mtP(latvm))))
	RETURN $LB(qn,latf,latfs,latfm,latvm,$p($$$mtV($$$mtPViewIDVal($$$mtP(latvm))),"^",2))  ;  view
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
tvfstr(m,qval) n str,args,li s str=""  ;  $$: str# of tvf() in m that references qval
	f  { s str=$O($$$mtTvfParams(str),1,args) RETURN:'str 0 CONTINUE:args=$c(0)  f li=1:1:$ll(args) { RETURN:$$valtree^%qaqpmod("v",$lg(args,li),$lb(qval)) str } }
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
x2f	;  lvtreemod() call back, coming in with type,val,v,ev,  ;  AK850
	#;  using latxn(xval), replace all leaf x^fval nodes in sqb itself (but
	#;  not in subqueries) into their target fval
	i $d(latxn(val),latxn) {
		s $LB(refqn,latf,latfs,latfm,latvm,latvs)=latxn
		i latfm=pqb,latvm=sqb,refqn=sqb { RETURN latf }
	}
	GOTO lvargm^%qaqpnl  ;  recurse to replace contents of v
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
klonef2x  ;  lvtreemod() call back, coming in with type,val,v,ev, also latxn()
	#;  clones an expression before a merge-view operation, replacing leaf
	#;  f nodes fval with new x^fval lateral references, also must replace
	#;  x^NN nodes with new x^NN nodes (because step A will replace them
	#;  with f!), while streamless subexpressions don't need to be cloned
	RETURN:ev="f" $$$newval("x^"_val,1)
	i ev="q" { n xlate,viewFvals,m s m=sqb RETURN $$clone^%qaqpnl(val) }
	i "tx"[ev,'$d(latxn(val)) RETURN val  ;  streamless
	s val=$s(type="v":$$$newval(v,1),1:$$newlog^%qaqpmod(v))
	RETURN:ev="x" val  ;  x^NN in sqb clone
	RETURN:ev="n" val  ;  better to clone, because it's in a different subquery!
	#;  "vlae" expression may have f, x, or n -
	GOTO lvargm^%qaqpnl  ;  recurse to replace contents of v
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 	#; PVA114: new function doFOJs
doFOJs(m) ; Convert any FOJs in m that are not contained in another FOJ into a streamed 
          #; into a streamed view implementing the FOJ (using fjxfrm)
	n onc,onode
	s onc="" for 
	{  s onc=$o($$$mtOn(m, onc),1,onode) q:onc=""
	   continue:$li(onode,$$$SQLONOPERATOR)'=$$$SQLONFULLJOIN||$$inFOJ(m,onode)
	   d fjxfrm(m,onc)
	}
    QUIT
	#; PVA114: new function inFOJ
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
inFOJ(m,onNode)
	#; Returns 1 if onNode of m is within the scope of an FOJ 
	#; else returns 0
	#;
	QUIT:$li(onNode,$$$SQLONPARENT)="" 0
	QUIT:$li($$$mtOn(m,$li(onNode,$$$SQLONPARENT)),$$$SQLONOPERATOR)=$$$SQLONFULLJOIN 1
	QUIT $$inFOJ(m,$$$mtOn(m,$li(onNode,$$$SQLONPARENT)))
 	#; PVA113: new function fjxfrm
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fjxfrm(m,onidx)
	#; Transform the specified FULL outer join into a streamed view implementing
	#;    it as a UNION all of two (appropriately adjusted) LEFT join queries.
	#; m - query containing FULL join
	#; onidx - index of the the FULL outer join
	n strnames,i,movstrs,q1,trvals,ll,lr,q2,onc,onode,str,idval,qr,savm,rstrs,tname,mlabel
	n fval
	n viewFvals,xlate  // MUST!! be newed here for copyqb
	#;
	#;
	s mt("fjxfrm",m) = onidx
	#;  Create first query: lj from from jf
	s onode=$$$mtOn(m, onidx),ll=$li(onode,$$$SQLONLEFTSTREAMS),lr=$li(onode,$$$SQLONRIGHTSTREAMS)
	s strnames=ll_lr
	s movstrs="," for i=1:1:$ll(strnames)	{ s movstrs=movstrs_$$$ptrel(m_"^"_$li(strnames,i))_"," }
	s $li($$$mtOn(m, onidx),$$$SQLONOPERATOR)=$$$SQLONLEFTJOIN 
	s q1=$$cr8query(movstrs,.trvals)
	#;
	#; Create second query from first, and reverse its left & right operands (thus, rj, effectively)
	; s q2=$$copyqb^%qaqpre2(q1,m)
	s q2=$$copyqb^%qaqpre3(q1,m)
	d pointifyON^%qaqpre2(q2) // so I can find the top ON easily	
	s onc="" for {s onc=$o($$$mtOn(q2, onc),1,onode) q:$li(onode,$$$SQLONPARENT)="" }
	s lr=$li(onode,$$$SQLONLEFTSTREAMS),ll=$li(onode,$$$SQLONRIGHTSTREAMS)
	s $li($$$mtOn(q2, onc),$$$SQLONLEFTSTREAMS)=ll,$li($$$mtOn(q2, onc),$$$SQLONRIGHTSTREAMS)=lr
	d resetnulstr(q2) // because lj args just flipped
	#;
	#; Add "id is null" test or q1 WHERE clause
	if $ll(lr)=1  
	{  s str=$$$ptrel(q2_"^"_$li(lr))
	   s savm=m,m=q2,idval=$$getidval(str),m=savm
	}
	else // compound rhs of lj in q2
	{  s savm=m,m=q2
	   s rstrs="," for i=1:1:$ll(lr)	{ s rstrs=rstrs_$$$ptrel(m_"^"_$li(lr,i))_"," }
	   s qr=$$cr8strview(rstrs,"","","","")
       s m=qr d flds^%qaqpnl
       s m=q2 d flds^%qaqpnl s m=savm
       d resetnulstr(q2) // because this new stream is a left join target
	   s idval=$$$mtPViewIDVal($$$mtP(qr))
	}
	Set val=$$$newlog("v^NULL^^"_idval_"^")
	s $$$mtWhere(q2)=$g($$$mtWhere(q2))_val_"^"
	s savm=m,m=q2 d lflds^%qaqpnl("l",val,"do") s m=savm // PVA233: critical to maintain ptv flags
	#;
	#; make union of q1 and q2
	s $$$mtUnion(q1)=$lb(q2_"a")
	s $$$mtUnionTopQb(q1)=q1
	s $$$mtUnionTopQb(q2)=q1
	#;
	#;  make stream of union
	s tname="%%Q"_q1
	s mlabel=m_"^crvw%"_q1
	s $$$mtFromTableName(mlabel)=tname
	s fval = $$$newval("junk",1) //real content to be filled in by vstrf
	s $$$mtPViewIDVal($$$mtP(q1))=fval // set pointer to (what will be) id val of osq streamed view
	d vstrf^%qaqpqo,createval^%qaqpdt(fval)
	for i=1:1:$l($$$mtOutputVals($$$mtOutput(q1)),",")-1 
	{ s fval=$$$newval("junk",1) 
	  s trvals($p($$$mtOutputVals($$$mtOutput(q1)),",",i))=fval
	  d vstrf^%qaqpqo,createval^%qaqpdt(fval)
	}
	#; 
	#;  fix all references to movstrs in m to ref output of new stream 
	d fixstrmrefs(m,movstrs,strnames,$$$ptrel(mlabel),mlabel,1)
	d fixrefs^%qaqpnl(m,"",.trvals)
	d flds^%qaqpnl
	
	QUIT 
 	#; PVA113: new function fixstrmrefs
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fixstrmrefs(m,movstrs,strnames,newstr,newstrname,doON,forFT=0)
	#; Fix various stream structures in m based on the streams movstrs being replaced 
	#; by the stream newstr.
	#;   m - query to fix up
	#;   movstrs - replaced stream numbers, comma delimited pre and post
	#;   strnames - $list of names corresponding to movstrs (1 to 1, in order)
	#;   newstr - new stream number to replace movstrs with
	#;   newstrname - full m label of newstr (e.g. m^stuff)
	#;   doON - whether ON nodes referencing strnames should be adjusted
	#;	 forFT	- being done as part of foreign table pushdown creation of a fake stream
	#;	
	#; repl movstrs in ON clauses of m with new stream
   	#;    lots of assumptions made about how the ON stream lists are built .... and about movstrs
	new i,j,ll,lr,onc,onode,st,x
	if doON {	// TODOFT - not do this once JOIN pushdown happens because we should handle it
		set onc = "" 
		for {
			set onc = $o($$$mtOn(m, onc),1,onode) 
			QUIT:onc=""
	      	set ll=$li(onode,$$$SQLONLEFTSTREAMS), lr=$li(onode,$$$SQLONRIGHTSTREAMS)
			if $lf(lr,$li(strnames)) {
				set $li(lr,$lf(lr,$li(strnames)),$lf(lr,$li(strnames,$ll(strnames)))) = $lb($p(newstrname,"^",2))
			}
			if $lf(ll,$li(strnames)) {
				set $li(ll,$lf(ll,$li(strnames)),$lf(ll,$li(strnames,$ll(strnames)))) = $lb($p(newstrname,"^",2))
			}
			set $li($$$mtOn(m, onc),$$$SQLONLEFTSTREAMS,$$$SQLONRIGHTSTREAMS) = $lb(ll,lr)
	   }
	}
	#; Fix up steamorder 
	#;    If the first stream of movstrs is in streamorder, replace it with newstr.
	#;    Simply remove any other movstrs from streamorder. This is a sensible way
	#;    to update streamorder (for both %starttable and %inorder) as long as the first
	#;    stream in movstrs is the earliest one in FROM order, among the movstrs.
	#; PVA208: fix up & adjust for both %starttable and %inorder
	if $d(mts("streamorder",m)) {
		if $lf(mts("streamorder",m),$p(movstrs,",",2)) {
			set $li(mts("streamorder",m),$lf(mts("streamorder",m),$p(movstrs,",",2))) = newstr
		}
		for j=3:1 {
			set st = $p(movstrs,",",j) 
			QUIT:'st
			set i = $lf(mts("streamorder",m),st) 
			CONTINUE:'i
			set $li(mts("streamorder",m),i,i+1) = $li(mts("streamorder",m),i+1,i+1)
	   }	
	}
	#; Fix up nulstr
	do:'forFT resetnulstr(m)	// FTs will do this on their own because they need to wait until the end of a longer operation
 
 	RETURN
 	#; PVA109: new function cr8query
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cr8query(movstrs,trvals,where,addids,wand,pos,orlist) 
	#; Create a new query and move the given streams (and any associated structures) to it.
	#;  movstrs: streams to move, comma delimited pre and post; assumed to come from 
	#;           query m
	#;  trvals: normally passed by reference; will be filled in as trvals(fval)=""
	#;          for all 'f' type vals in query m referencing movstrs; these are 
	#;          what will need later fix up. 
	#; ----          
	#; The arguments below are used in a pecular way meant only for OrToUnion
	#; in order to clone a little as possible to avoid problems from
	#; multiple references to the same val from view merging.
	#; -----
	#;  where: mt("w") for the new query [optional argument] //PVA158
	#;  addids: if true, add rowid of each movstr at end of mt("o") of created query
	#;  		Note: these mt("o") entries are not included in trvals
	#;          [optional argument] //PVA158
    #; wand - 0 if the OR driving the UNION is in mt("w")
    #;        otherwise the $$$mtL() number of the AND containing the OR
    #; pos - "^" piece position in mt("l") or mt("w") to replace with each OR alternative
    #; orlist - $list of mt("l") entries for the OR alternatives. None of these should be
    #;          an OR. PASSED BY REFERENCE.
	#;---------------------------          
	#;  RETURNS: created query number
	new fcols,fval,i,ifn,osq,savm,st,val,viewFvals,xlate	// DPV3337 (fcols)
	// create new query
	set osq = $$newquery(m,movstrs,"") // we don't need the movenames
	#; PVA158 Handle optional WHERE argument.
	if $g(where)]"" {	// The following seems a horrible kluge, but can't come up with a better way..
		if wand { set $p($$$mtL(wand),"^",pos) = $li(orlist,$ll(orlist)) } 
		else { set $p(where,"^",pos) = $li(orlist,$ll(orlist)) }
		set savm=m, m=osq
		set xlate("qb",savm) = osq // PVA252: move this back here
		for i=2:1 {
			set st = $p(movstrs,",",i) 
			QUIT:'st
			set ifn = "" 
			for {
				set ifn = $o(mts(savm,st,"ATT",ifn)) 
				QUIT:ifn="" //these mts entries not moved yet
				set fval = $p(mts(savm,st,"ATT",ifn),"^",5)
				set viewFvals(fval,osq) = fval
			}
		}
	   #; Must clone the WHERE clause that will be used with the moved streams because, due to
	   #;   view merging, it may share "v" nodes with mt("o"); mt("o") will remain with outer query
	   #;   and have its field refs retargeted to union stream fields. Thus the sharing must be broken -
	   #;   by cloning. 
		for i=1:1 {
			set val = $p(where,"^",i) 
			QUIT:val=""
			set $p(where,"^",i) = $$clone^%qaqpnl("l",val) 
			set $$$mtL(val) = "i^clean"_$$$mtL(val) // PVA159
			do propagateComplexLog^%qaqpnl(val, $p(where,"^",i), savm, osq)
		}
		for i=1:1:$ll(orlist)-1 { 	// last element of orlist already 'in' where and cloned above // PVA323
			set val = $li(orlist,i)
			set $li(orlist,i) = $$clone^%qaqpnl("l",val)
			set $$$mtL(val) = "i^clean"_$$$mtL(val)
			do propagateComplexLog^%qaqpnl(val,$li(orlist,i),savm,osq)
		}
		if wand {
			set $li(orlist,$ll(orlist)) = $p($$$mtL(wand),"^",pos)
			set $p($$$mtL(wand),"^",pos) = $li(orlist)
		} else {
			set $li(orlist,$ll(orlist)) = $p(where,"^",pos)
			set $p(where,"^",pos) = $li(orlist)
		}
		set $$$mtWhere(osq) = where 
		set m = savm
	}
 
	do setqparms(m,osq,movstrs) // set $$$mtP(osq) piece 4
 
	//Find fields needed for output from subquery that will be retargeted in m
	do fvals^%qaqpnl(m,"",movstrs,.trvals)
 
	// build 'select' list for osq
	set i="", fcols="" 
	for { 
		set i = $o(trvals(i)) 
		QUIT:i=""
		set fcols = fcols_i_","	
	}
	if $g(addids) { 	// add id fields for movstrs // PVA158
		for i=2:1 {
			set st = $p(movstrs,",",i) 
			QUIT:'st
			set val = $s($g($$$mtRVirtual(st)): $$$mtPViewIDVal($$$mtP($$$mtRVirtual(st))), 1: $$nufld^%qaqpqo(st,$p(mts(m,st),"^",5)))
			set fcols = fcols_val_"," 
		}
	}
	if fcols="" { set fcols = $$$newval("t^1",1)_"," } 	// PVA123: must select something
	do finishquery(fcols,osq,movstrs)
 	set savm=m, m=osq 
	do flds^%qaqpnl 
	set m = savm
	merge mt("hint",osq) = mt("hint",m)
	RETURN osq
 	#; PVA109: new function finishquery
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
finishquery(fcols,osq,movstrs,doHaving=0,forFT=0)	
	#; fcols: comma delimited list of vals to go in mt("o")
	#; osq: query number to finish
	#; movstrs: streams moved to osq from m; comma delimited pre and post.
	#; doHaving: (used by foreign tables) tells fixsubq^%qaqpre3 if it should look in HAVING to repoint subqueries too
	#; forFT: (used by foreign tables) tells this logic not to resetnulstr which can cause issues because there will be
	#;			entries in mt("from") that are not yet moved around by the pushdown logic. FTs run before nulstr is
	#;			used by the rest of the preopt and is only needed for analysis, so at the time this is called, nulstr
	#;			can be treated as blank slate anyway
	#; 
	new i,st
	#; move mts entries
	for i=2:1 {
		set st = $p(movstrs,",",i)
		QUIT:'st
		merge mts(osq,st) = mts(m,st)
		kill mts(m,st)
	}
	// retarget ptv entries to new query
	for i=1:1:$$$maxv { 
		CONTINUE:'$d(ptv(i))
		if movstrs [ (","_$p(ptv(i),"^",8)_",") {
			set $p(ptv(i),"^",7) = osq 
		}
	}
 
	for i=1:1:($l(fcols,",")-1) {
		set $$$mtAlphaUpAliases(osq) = $g($$$mtAlphaUpAliases(osq))_$lb("%OSQ"_$p(fcols,",",i))
	}
	set $$$mtOutputVals($$$mtOutput(osq)) = fcols
	set $$$mtAliases(osq) = $$$mtAlphaUpAliases(osq)
 
	#; finish up new query
	set $$$mtPQbVal($$$mtP(osq)) = $$$newval("q^"_osq,1)
 
	#; Repoint appropriate subqueries from m to osq. 
	do fixsubq^%qaqpre3(osq, doHaving) 
	do:'forFT resetnulstr(osq) 
	
	RETURN
	#; PVA115: Eliminate cloneon - was not necessary
 	#; PVA109: new function setqparms
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setqparms(m,osq,allstr)
    #; Set piece 4 of osq on behalf of outer references from mt("w",osq) and ON clauses
    #; in osq. 
    #;    m: parent query
    #;    osq: new query
    #;    allstr: a list of all streams in osq, comma delimited pre and post.
	n logs,call,i,log,j
	if $$$mtCorrParentQb(m)>0  // There may be outer references in 'where' to list for new osq
	{ s call="ocorr^%qaqpnl"
	  s logs=$g($$$mtWhere(osq)) // PVA170: $g() 
	  for i=1:1 { s log=$p(logs,"^",i) q:'log  d lvtree^%qaqpnl("l",log)}
	  s i="" for  
	  {  s i=$o($$$mtOn(osq, i),1,logs) q:i=""  // PVA142 - fix type
		 s logs=$li(logs,2)
	     for j=1:1 s log=$p(logs,"^",j) q:'log
	     d lvtree^%qaqpnl("l",log)
	  }
	}
	QUIT
 	#; PVA109: new function newquery
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
newquery(m,movstrs,movnames,forFT=0)	// DPV3850 argument should be movnames, not movenames
	#; Start a new query using a list of streams moved from query m
	#;     m 			: query movstrs come from
	#;     movstrs 		: a list of stream numbers, comma delimited pre, and post; from m
	#;     movenames 	: normally passed by reference; returns the stream names corresponding
	#;                 		to movstrs, in case the caller needs them.
	#;		forFT		: this is being done for foreign table pushdown
	new i,j,lx,ly,nm,nmoved,osq,q,st,x
	#; allocate the new query 
	set osq = $i(maxm)
	set $$$mtPQbIsActive(osq) = 1
	set $$$mtP(osq) = m
	set mt("dups",osq) = $$$SQLPRESERVEDUPS
	set $$$mtCorrParentQb(osq) = $$$mtCorrParentQb(m)
 	set nmoved = $l(movstrs,",")-2
 
	if 'forFT {	// foreign tables handle join rewiring on their own
		#; move ON clauses contained in movenames;
		set j=""
		for {
			set j = $o($$$mtOn(m, j),1,lx) 
			QUIT:j=""
			set ly = $li(lx,4)
			set lx = $li(lx,3)
			CONTINUE:$ll(ly)+$ll(lx)>nmoved
			CONTINUE:movstrs'[(","_$$$ptrel(m_"^"_$li(lx))_",") // This test is sufficient by design
			set $$$mtOn(osq, j) = $$$mtOn(m, j)
			kill $$$mtOn(m, j) 
		}
	}
 
	#; move the streams
	set movnames = ""
	set ptj(osq,1) = ",^,"
	do cleanunary^%qaqpre3(movstrs) // PVA175: eliminate mt("unary") elements  
	                               #; that refer to the moved streams
	for i=2:1 {
		set st = $p(movstrs,",",i) 
		QUIT:'st
		set nm = $$strtoname(st)
		set movnames=movnames_$lb(nm)
		set $$$mtRQb($$$mtR(st)) = osq
		if $d($$$mtRVirtual(st)) {
			set q = $$$mtRVirtual(st)
			set $p($$$mtP(q),"^") = osq // PVA099
	      	#; PVA158: fix not to wipe out other $$$mtP(qno) pieces when up pointer reset
			if $d($$$mtUnionTopQb(q)) {
				for j=1:1:$ll($$$mtUnion(q)) {
					set $$$mtPQbParent($$$mtP(+$li($$$mtUnion(q),j))) = osq
				}
			}
	   }
	   set ptj(osq,1) = ptj(osq,1)_st_","
	   set x = $p(ptj(m,1),"^",2)
	   set x = $p(x,","_st_",") _ "," _ $p(x,","_st_",",2)
	   set $p(ptj(m,1),"^",2) = x
	   set $$$ptrel(osq_"^"_nm) = st
	   kill $$$ptrel(m_"^"_nm)
  	   //FROM clause stuff for new query
	   #; Note that we don't bother with mt("flbls") as this should only really
	   #;  be used or needed during parsing for resolving column references
	   #;  For example, it is never corrected when a view is streamed during
	   #;  parsing. We also don't bother with mt("from"). It isn't really needed 
	   #;  after being used to set up mts("streamorder"). We do set up mt("f") 
	   #;  as it is used in code generation for cursor update statements, 
	   #;  among other things. 
   	   // PVA158: arrow syntax streams don't have mt("f") entries
		if nm'["->",$d($$$mtFromTableName(m_"^"_nm)) {	// DPV3258 (nm'["->")
			set $$$mtFromTableName(osq_"^"_nm) = $$$mtFromTableName(m_"^"_nm)
			kill $$$mtFromTableName(m_"^"_nm)
		}
		
		if $$$IsFTStream(st) {
			do copyFTInformation^%qaqpftpd(st,0,m_"^"_nm, osq_"^"_nm,1)
		}	
	} 
	
	RETURN osq
	
	
	#; PVA087: new routine cr8strview
	#; PVA094: add vwhndl argument, move to pre2
	#; PVA108: remove label argument; heavily modify and enhance for multiple moved streams
	#;         and associated new tasks. Code is about 2/3 new. 
	#; PVA179: add dostrms argument
	#; HSU276: add loj argument
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cr8strview(movstrs,cpystrms,where,extra,vwhndl,dostrms=0,loj=0) 
    #; Move movstrs(comma delimited, pre and post, stream numbers)
    #; to be part of a new streamed view that
    #; replaces movstrs in query m, with given where clause.
    #; 'extra' are additional conditions, not yet part of any
    #; query, whose references to movstrs are to be included in
    #; bookkeeping and fixups. cpystrms are additional streams 
    #; (comma delimited, pre and post) to be copied (not 
    #; moved) to the new query. References to these in 'where' will 
    #; be fixed up. cpystrms can come from queries other than m. Only rowid is selected
    #; from cpystrms. vwhndl, if not empty, indicates that structures for
    #; extended pushdown should be maintained (ojx).
    #; Dostrms indicates scope of reference cleanups. See corresponding
    #; argument of fixrefs^%qaqpnl. 
    #; NOTE: movstrs must in the order they will be found mt("ON",nodes)
    #; NOTE(PVA102): the 'where' clause is cloned to handle problems that
    #;       some of its referenced vals may be referenced 
    #;       elsewhere in query m. Caller must decide what to
    #;       do with 'where' itself, for cleanup.
	n allstr,args,fcols,fval,fvals,i,idflds,label,mlabel,movenames,nm,osq,savm,st,str,tname,trstrms,trvals,val,viewFvals,x,xlate	// DPV3337 (movenames, not movnames)
	// create new query
	if $p(movstrs,",",3)="" s label=$$strtoname($p(movstrs,",",2))
	else  s label="" // will be set later
	s osq=$$newquery(m,movstrs,.movenames) // PVA109
	s xlate("qb",m)=osq //PVA115: This needed for clone to properly retarget cloned
	                   #; subqueries in 'where'  
	s mt("cr8strview",osq) = m 
	
	s $$$mtWhere(osq)=where k:$$$mtWhere(osq)="" $$$mtWhere(osq) //PVA099: kill mt("w",) if empty
 
	s allstr=cpystrms_$p(movstrs,",",2,*)
	d setqparms(m,osq,allstr) // PVA109
	 
	// copy additional streams to query
	s savm=m,m=osq 
	for i=2:1 
	{  s st=$p(cpystrms,",",i) q:'st
	   s nm=$$strtoname(st)
	   // putstr has stupid hidden requirement that str be initialized before putstr called.
	#; JLF125
	   #; Create a new stream, str
	   if $d($$$mtRVirtual(st)) { set str=$$cr8dupview(st,nm,osq) }
	   else 
	   {	s str=0 d putstr^%qaqpqo(m_"^"_nm,+$$$mtR(st))
	   		s $$$mtFromTableName(osq_"^"_nm)=$$$mtFromTableName(savm_"^"_nm)
	   		if nm'["->",$e($$$mtFromTableName(osq_"^"_nm),1,3)="%%Q" s $$$mtFromTableName(osq_"^"_nm)=$$$mtFromTableName($e($$$mtFromTableName(osq_"^"_nm),4,*)_"^"_nm)	// DPV3258 (nm'["->")
	   } // putstr leaves new stream in str
	#; JLF125-
	   s trstrms(st)=str // to translate stream references
		if $$$IsFTStream(st) {	// transfer FT information for the new streams created
			do copyFTInformation^%qaqpftpd(st, str, savm_"^"_nm, osq_"^"_nm)
		}
	}
	s m=savm
 
 	#; PVA342: We assume that this is only called after RLS have been placed for query blocks 
 	#;  cpystrms have come from; and that the transform algorithm using this is correct, thus preserves 
 	#;  semantics of the already placed RLS condition. Deeper query blocks will be handled correctly by
 	#;  copyqb used by clone. It would be possibly harmful, given above reasoning, to try to generated new 
 	#;  RLS conditions on copied streams.
 
	//Find fields needed for output from subquery that will be retargeted
	d fvals^%qaqpnl(m,extra,movstrs,.trvals)
 
	// Find fields needed from cpystrms not required for output
	d fvals2^%qaqpnl($g($$$mtWhere(osq)),"l",cpystrms,.fvals) 
 
	#; PVA094: Add vals needed for conditions that will be copied in from elsewhere, later
	if $g(vwhndl)]""
	{
  	  s fval="" for 
	  {  s fval=$o(ojx("w",fval)) q:fval=""
	     s:$d(ojx("w",fval,vwhndl)) fvals(fval)=""
	  }
	  s fval="" for 
	  {  s fval=$o(ojx("o",fval)) q:fval=""
	     s i="" for 
	     {  s i=$o(ojx("o",fval,i)) q:i=""
	        s:$d(ojx("o",fval,i,vwhndl)) fvals(fval)=""
	     }
	  }
	}
	// make new fvals for for them
	s savm=m,m=osq 
	s fval="" for  
	{  s fval=$o(fvals(fval)) q:fval="" 
	   s x=$$$mtV(fval)
	   #; PVA116: use nufld so we won't create duplicate fval for virtual field of dusv stream
	   s fvals(fval)=$$nufld^%qaqpqo(trstrms($p(x,"^",2)),$p(x,"^",3))  // to retarget these in 'where' conditions
	}
	#; PVAP094: Fill in these new fvals as sources for fields for conditions that will be copied
	#;          FROM this streamed view
	if $g(vwhndl)]""
	{  
	   s fval="" for 
	   {  s fval=$o(fvals(fval)) q:fval=""
	      s i="" for 
	      {  s i=$o(ojx("o",fval,vwhndl,i)) q:i=""
	         s $p(ojx("o",fval,vwhndl,i),",")=fvals(fval)
	      }
	   }
	}
	#; PVA094: Fill in the new fvals as targets for fields for conditions that will be copied 
	#;         TO this streamed view
	if $g(vwhndl)]""
	{
	   s fval="" for 
	   {  s fval=$o(fvals(fval)) q:fval=""
	      s:$d(ojx("w",fval,vwhndl)) $p(ojx("w",fval,vwhndl),",",2)=fvals(fval)
	      s i="" for 
	      {  s i=$o(ojx("o",fval,i)) q:i=""
	         s:$d(ojx("o",fval,i,vwhndl)) $p(ojx("o",fval,i,vwhndl),",",2)=fvals(fval)
	      }
	   }
	}
	// ensure rowid selected from copied streams, and remember to SELECT these
	s idflds="," 
	for i=2:1
	{	s st=$p(cpystrms,",",i) q:'st
		s val=$s($g($$$mtRVirtual(st)):$$$mtPViewIDVal($$$mtP($$$mtRVirtual(trstrms(st)))),1:$$nufld^%qaqpqo(trstrms(st),$p(mts(m,trstrms(st)),"^",5)))  ; PVA102
		s idflds=idflds_val_"," // want this to be 1 to 1 with cpystrms
	}
	#; PVA102: Clone 'where', substituting for fvals. Cloning needed because
	#;   of multiple refs to vals introduced by merging a view. 
	#; Copy fvals into format needed for clone
	s fval="" for {  s fval=$o(fvals(fval)) q:fval=""  s viewFvals(fval,m)=fvals(fval)}
	for i=2:1 // PVA115: move this back here now that cloneon eliminated.
	{  s st=$p(movstrs,",",i) q:'st
	   s ifn="" for 
	   { s ifn=$o(mts(savm,st,"ATT",ifn)) q:ifn="" //these mts entries not moved yet
	      s fval=$p(mts(savm,st,"ATT",ifn),"^",5)
	      s viewFvals(fval,osq)=fval
	   }
	}
 	#; NOTE: strictly, unless 'where' arg and cpystrms arg given, viewFvals setup and
 	#;       cloning are not neede. Could just move 'where' and fix refs, as was once 
 	#;       done. However, this works in all cases with less code, and no 
 	#;       performance impact. 
	#; PVA107: if cloned log in viewSpConds, replace with clone
	s where=$g($$$mtWhere(osq)) if where]"" 
	{ for i=1:1 
	   {  s val=$p(where,"^",i) q:val=""  
	      s $p(where,"^",i)=$$clone^%qaqpnl("l",val),$$$mtL(val)="i^ojcloned^"_$$$mtL(val)
	      if $bit($g(viewSpConds),val)=1 s $bit(viewSpConds,val)=0,$bit(viewSpConds,$p(where,"^",i))=1
	   } 
	   s $$$mtWhere(osq)=where 
	}
  
    s st="" 
	for { // PVA350: Stream structures must be copied if copied stream is a tvf  
		s st=$o(trstrms(st),1,str) 
		q:st=""
		if $d($$$mtTvfParams(st)) {  
			s args=$$$mtTvfParams(st) 
			if args'=$c(0) {for i=1:1:$ll(args) {s val=$lg(args,i) s:val]"" $li(args,i)=$$clone^%qaqpnl("v",val)}}
			s $$$mtTvfParams(str)=args
			s $$$mtTvfFuncLabel(str)=$$$mtTvfFuncLabel(st)
	   	}
    }
	s m=savm
	  				 
	#; dont' worry about ptln - not used after 'field' transform to parse tree
	#; don't worry about vtr query number field; it is not used. 
 
	// build 'select' list for osq
	s i="",fcols="" 
	for 
	{ s i=$o(trvals(i)) q:i=""  
	  s fcols=fcols_i_","	
	}
	#;HSU276++
	#;If two conditions hold, we would add the ID of each stream into the SELECT list of the generated view.
	#;First, any stream of movstrs is not a view.
	#;Second, the SELECT list does not contain the ID of this stream
	#;It is also important to note that we have to add the IDs in this code block, just after the necessary fields of RHS of LOJ "trvals" has been added into "fcols"
	#;and before the IDs of LHS "idflds" been added into "fcols".
	#;So the symbol tables of the SELECT list of this generated view could in the order of 
	#;$$$mtV(view_id_num) = q^N
	#;$$$mtV(RHS_necessary_fields_num) = trvals
	#;$$$mtV(RHS_IDs) = strid
	#;$$$mtV(LHS_IDs) = idflds 
	#;Since in xfrmON^%qaqpnl,it assumes the LHS IDs are in the tail of the symbol table, so it could fetch the correct LHS IDs to form the correct OUTER JOIN ON predicate. 
	if loj=1 { 
		n ii,strid,movviews
		s movviews = 0
		f ii=2:1:($l(movstrs,",")-1) {
			if $g($$$mtRVirtual($p(movstrs,",",ii))) s movviews = 1 QUIT
		}
		i 'movviews f ii=2:1:($l(movstrs,",")-1) s strid = $$getidval($p(movstrs,",",ii)) i (","_fcols)'[(","_strid_",") s fcols = fcols_strid_","
		#;HSU276--
	}
	
	// add rowid select items for cpystrms
	for i=2:1
	{ s val=$p(idflds,",",i) q:'val
	  s fcols=fcols_val_","	
	}
	if fcols="" s fcols=$$$newval("t^1",1)_"," // PVA123: must select something
 
    d finishquery(fcols,osq,movstrs) // PVA109
	
	s tname="%%Q"_osq
	s mlabel=m_"^"_$s(label="":"crvw%"_osq,1:label)
	s $$$mtFromTableName(mlabel)=tname
	s fval = $$$newval("junk",1) //real content to be filled in by vstrf
	s $$$mtPViewIDVal($$$mtP(osq))=fval // set pointer to (what will be) id val of osq streamed view
	d vstrf^%qaqpqo,createval^%qaqpdt(fval)
	for i=1:1:$l($$$mtOutputVals($$$mtOutput(osq)),",")-1 
	{ s fval=$$$newval("junk",1) 
	  s trvals($p($$$mtOutputVals($$$mtOutput(osq)),",",i))=fval
	  d vstrf^%qaqpqo,createval^%qaqpdt(fval)
	}
	#; PVA113: factor out fixstrmrefs to use in fjxfrm
	d fixstrmrefs(m,movstrs,movenames,$$$ptrel(mlabel),mlabel,'vwhndl)	// DPV3850, argument is movenames, not movname
 
   	#; Find all references to trvals in m, and retarget to streamed view.
	#;   Includes full depth search for outer references. trvals specifies how
	#;   field references should be translated.
	#;
	d fixrefs^%qaqpnl(m,extra,.trvals,0,0,dostrms) // PVA179: add dostrms
	#; PVA094: record trvals targets as srcfvals for ojx("w") entries
	if $g(vwhndl)]""
	{  
	   s fval="" for
	   {  s fval=$o(trvals(fval)) q:fval=""
	      s i="" for
	      {  s i=$o(ojx("w",fval,i)) q:i=""
	         s $p(ojx("w",fval,i),",")=trvals(fval)
	      }
	   }
	}
	QUIT osq
	#; JLF125
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cr8dupview(origStr,strName,pqb)
	n const1,fromQb,fval,i,label,mlabel,newQb,olist,origIfn,tname
	s const1=$$$newval("t^1",1)  // needed for phony output list of dup view
	s fromQb=$$$mtRVirtual(origStr)
	s newQb=$i(maxm)
	s $$$mtPQbIsActive(newQb)=1
	s $$$mtP(newQb)=pqb
	s $$$mtCorrParentQb(newQb)=$$$mtCorrParentQb(pqb)
	s $$$mtDupsv(newQb)=fromQb
	s $$$mtPQbVal($$$mtP(newQb))=$$$newval("q^"_newQb,1)
	s tname="%%Q"_newQb
	s mlabel=pqb_"^"_strName
	s $$$mtFromTableName(mlabel)=tname
	s fval = $$$newval("junk",1) //real content to be filled in by vstrf
	s $$$mtPViewIDVal($$$mtP(newQb))=fval // set pointer to (what will be) id val of newQb streamed view
	s $$$mtOutput(newQb)=""
	
	#; m is passed implicitly to nuvstr and virf
	n m s m=pqb
	
	#; Create the new stream and its ID
	s origIfn=$p($$$mtV($$getidval(origStr)),"^",3)
	s $$$ptrel(mlabel)=$$nuvstr^%qaqpqo(origStr)
	d createval^%qaqpdt(fval)
	
	s $$$mtOutput(newQb)=$g($$$mtOutput(fromQb)),olist=$$$mtOutputVals($$$mtOutput(newQb))
	for i=1:1:$l(olist,",")-1 
	{	s fval=$$$newval("junk",1)
		s $p(olist,",",i)=const1,$$$mtOutputVals($$$mtOutput(newQb))=olist
		d virf^%qaqpqo(fval,$$$ptrel(mlabel),origIfn+i)  ;  provide field with virtual ifn
		d createval^%qaqpdt(fval)
	}
	QUIT $$$ptrel(mlabel)  // stream number of newly created view
	#; JLF125-
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
delDangl()
	n agl,nagl,ai
	f log=1:1:$$$maxl s:$$$mtLColVals($$$mtL(log))="" $$$mtL(log)="i^unreachable^"_$$$mtL(log)
	f m=1:1:$$$mtPNumQbs
	{	continue:'$$$mtPQbIsActive(m)  s agl=$$$mtPAggList($$$mtP(m)),nagl=""
		f ai=1:1:$l(agl,",")-1  s:$p($$$mtV($p(agl,",",ai)),"^",3)'="" nagl=nagl_$p(agl,",",ai)_","
		if (agl'=nagl) {
			s $$$mtPAggList($$$mtP(m))=nagl
			d flds^%qaqpnl
		}
	}
	quit
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
qualName(val)
	  n v,irn,ifn,ttype,pkgdotcls,propname,i,j,m
	  s v=$g($$$mtV(val))
	  if $e(v)="f"
	  {	  
	        #; PVA099: change to sue strtoname instead of relying on $$$mtFromList()
		  	s irn=+$$$mtR($p($$$mtV(val),"^",2)),ifn=+$p($$$mtV(val),"^",3),m=$$$mtRQb($$$mtR($p($$$mtV(val),"^",2)))
		  	if '$d($$$mtRVirtual($p($$$mtV(val),"^",2))) { s ttype=$$$smdTType(irn),pkgdotcls=$$$smdClassname(ttype,irn),propname=$$$smdColPropertyName($$$smdTType(irn),irn,ifn)}
		  	else {s pkgdotcls="viewstrm"_$p($$$mtV(val),"^",2),propname="viewifn"_ifn}
			quit pkgdotcls_"."_propname_" ("_$$strtoname($p($$$mtV(val),"^",2))_")"
	  }
	  elseif $e(v)="n"
	  { quit $$qualName($p(v,"^",4))
	  }
	  elseif $e(v)="v"
	  { n operands s operands=""
	    f i=4:1  { q:$p(v,"^",i)=""  s operands=operands_$s(i>4:",",1:"")_$$qualName($p(v,"^",i)) }
	    quit $p(v,"^",2)_"("_operands_")"
	  }
	  quit ""
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
listvals()
	n i
	f i=1:1:$$$maxv  { w !,"mt(""v"",",i,")=",$g($$$mtV(i)),$c(9),$c(9),$$qualName(i) }
	quit
	#; JLF122
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
distinctDeterminesOutputs(lm)
	n dbl,funcDep, ulj, ulk, oval, vlist
	QUIT:'$d($$$mtOutput(lm)) 1
	s dbl = $s($d($$$mtGroupDistinctList(lm)):","_$$$mtGroupDistinctList(lm),$d($$$mtDistinct(lm)):","_$$$mtDistinct(lm),1:"")
	QUIT:dbl="" 0
	s funcDep=1,vlist=$$$mtOutputVals($$$mtOutput(lm))
	for ulj=1:1
	{	s oval = $p(vlist,",",ulj) q:'oval
		continue:"txn"[$$$mtVType($$$mtV(oval)) 		// effectively a constant
		if "f"=$$$mtVType($$$mtV(oval)) { if dbl'[(","_oval_",") { s funcDep=0 quit } else { continue }}
		elseif "vl"[$$$mtVType($$$mtV(oval)) { for ulk=4:1  q:""=$p($$$mtV(oval),"^",ulk)  s vlist=vlist_$p($$$mtV(oval),"^",ulk)_"," }
		elseif "a"=$$$mtVType($$$mtV(oval)) { if $p($$$mtV(oval),"^",7)_","'=dbl||$p($$$mtV(oval),"^",6) { s funcDep=0 quit }}
		else { s funcDep=0 quit }	// Cases s,q,e
	}
	QUIT funcDep
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-	
	#; JLF122-
flattenAOA
	n call,lgi,logs,m,toplevel,v,wlist
 	#; Remove all the label ("s") nodes that are operands of an ANYOF or ANYOFKEY
 	#; 
	f val=1:1:$$$maxv s v=$$$mtV(val) i $e(v)="v",",%ANYOF,%ANYOFKEY,"[(","_$p(v,"^",2)_","),$e($$$mtV($p(v,"^",4)))="s" s $p($$$mtV(val),"^",4)=$p($$$mtV($p(v,"^",4)),"^",4)
 
	f mTopo=$$$mtPNumQbs:-1:1				; In bottom-up topological order - JLF128
	{	s m=mt("qbo",mTopo)
		continue:($$isSharded^%qaqpnl(m))
		i $$$mtPQbIsActive(m) 
		{	n progress s progress=1
			while(progress)					; To Do: evaluate if loop can be removed now that we're processing it in bottom-up order
			{	s progress=0,logs=$g($$$mtWhere(m)) 
				s call = "flattenNestedElementOf^%qaqpre" 
				f lgi=$l(logs,"^")-1:-1:1 s log=$p(logs,"^",lgi) d lvtree^%qaqpnl("l",log)
			}
		/*	
			s call = "xformAoaSubtree^%qaqpre2"
			s logs=$g($$$mtWhere(m))
			f lgi=$l(logs,"^")-1:-1:1 s log=$p(logs,"^",lgi) d lvtree^%qaqpnl("l",log)
			s:$d($$$mtWhere(m)) $$$mtWhere(m)=$tr($$distlist^%qaqcpr($tr($$$mtWhere(m),"^",",")),",","^")
		*/	
			#; Flattening may have removed correlations that will not be recognized as needing
			#; null correction, so fill in piece 3's
			#;
			d:$d($$$mtNumAnyOf) lflds^%qaqpnl("l",$g($$$mtWhere(m)),"do")
		}
	}
  	 
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
xformAoaSubtree		;  called with type,val,v,ev,logs,lgi,m
	n toplevel s toplevel=$find("^"_$$$mtWhere(m),"^"_val_"^")	; The character position of 
 
	QUIT:((type'="l")||("vl"'[ev))				; Stop at the first non-predicate node
	
	#; When an ANYOFAND has a single operand that is a log with val operands, then the ANYOFAND
	#; can be replaced by its operand, and the operand marked in $$$mtAnyOfVals(log); otherwise, the
	#; operands of the ANYOFAND can be ANDed to the ANYOFAND itself, with ptres marked to indicate
	#; that the ANYOFAND implies each of the logs of its operands.
	#;
	if ($p(v,"^",2)="'"||($p(v,"^",2)="'%NOINDEX")),$$$mtLOperator($$$mtL($p(v,"^",4)))="ANYOFAND" // PVA242
	{	n opn,j
		s opn=$p(v,"^",3)
		f j=2:1  q:$p(opn,",",j)=""  s:$$$mtV($p(opn,",",j))["_%ANYOF" mt("forallval",$p(opn,",",j))=""
		s mt("foralllog",$p(v,"^",4))=""
		s toplevel=0
		GOTO lvarg^%qaqpnl
	}
	if $p($p(v,"^",2),"%NOINDEX")="ANYOFAND" // PVA242
	{	n aoa,arg,j,vSave,valSave,log
		s valSave=val,vSave=v
		s aoa=val
		if toplevel
		{	s toplevel=$l($e($$$mtWhere(m),1,toplevel-$l(val)-3),"^")	; convert toplevel to position in "^" pieces to val
			if $$aoaIsSatFromSubs(v)
			{	s aoa=$p(v,"^",4)
			    if $p(v,"^",2)["%NOINDEX" s $$$mtLOperator($$$mtL(aoa))=$$$mtLOperator($$$mtL(aoa))_"%NOINDEX" // PVA242
				s $p($$$mtWhere(m),"^",toplevel)=aoa		// assert($l(v,"^")=5)
				#; PVA316 noconds: no irrecoverable side effects for quickcost setup
				s $$$mtAnyOfVals(aoa)=$$baseFlds(aoa) s:'noconds $$$mtLType($$$mtL(val))="i" 
				k $$$mtAnyOfVals(val)
				if $d(ptres(val))'=0 { m ptres(aoa)=ptres(val) k ptres(val) }
				do setPtl(aoa,m)
			}
			else 
			{	s aoa=val
				f j=4:1:$l(v,"^")-1 
				{	
					#; If an ANYOFAND is nested below this one, then we need to ensure
					#; that if IT gets replaced, the pointer to it from aoa gets forwarded.
					#; For now, just ignore this optimization opportunity and prevent the
					#; nested ANYOFAND from being copied up in the first place.
					#;
					if $p($$$mtLOperator($$$mtL($p(v,"^",j))),"%NOINDEX")'="ANYOFAND"||'$$aoaIsSatFromSubs($$$mtL($p(v,"^",j))) // PVA242
					{	s ptres($p(v,"^",j),","_aoa_",")=""
						if $$$mtLOperator($$$mtL(aoa))["%NOINDEX" s $$$mtLOperator($$$mtL($p(v,"^",j)))=$$$mtLOperator($$$mtL($p(v,"^",j)))_"%NOINDEX" // PVA242
						s $p($$$mtWhere(m),"^",toplevel)=$p($$$mtWhere(m),"^",toplevel)_"^"_$p(v,"^",j)
					}
					do setPtl($p(v,"^",j),m)
				}
			}
		}
		elseif '$d(mt("foralllog",val))	// not toplevel, may or may not be satisifiable from index subscript
		{	if $l(v,"^")=5
			{	s aoa=val
			    if $p(mt(type,aoa),"^",2)["%NOINDEX" s $p(mt(ev,$p(v,"^",4)),"^",2)=$p(mt(ev,$p(v,"^",4)),"^",2)_"%NOINDEX" // PVA242
				#; PVA316 noconds: no irrecoverable side effects for quickcost setup
			    s mt(type,aoa)=mt(ev,$p(v,"^",4)) s:'noconds $e(mt(ev,$p(v,"^",4)))="i"
			    if $d(ptres($p(v,"^",4)))'=0 { m ptres(aoa)=ptres($p(v,"^",4)) k ptres($p(v,"^",4)) }
			}
			/*
			else
			{	s $p(mt(type,valSave),"^",2)="&"		// convert the ANYOFAND to an &
				Set val=$$$newlog(v),aoa=val			// copy of ANYOFAND is under the &
				for { q:$p(v,"^",5)=""  Set val=$$$newlog("l^&^"_$p(v,"^",3,5)_"^") s ptres(val,","_aoa_",")="" s $p(v,"^",4,5)=val }
				s $p(mt(type,valSave),"^",4,5)=aoa_"^"_val
			}
			*/
		}
		s $$$mtAnyOfVals(aoa)=$$baseFlds(aoa)
		#; PVA155: Use conds to classify aoa if added to mt("w")
	    #; PVA316 noconds: no irrecoverable side effects for quickcost setup
		if $p($$$mtLOperator($$$mtL(aoa)),"%NOINDEX")="ANYOFAND",$find("^"_$$$mtWhere(m),"^"_aoa_"^") s log=aoa if 'noconds && $$conds^%qaqpnl // PVA242
		s valSave=aoa,vSave=$$$mtL(valSave),ev=$e(vSave),type="l"
		s toplevel=0,val=valSave,v=vSave
		GOTO lvarg^%qaqpnl
	}
	s toplevel=0
	#; AK822
	GOTO lvarg^%qaqpnl
setPtl(log,m)
	#; PVA155: Change to use conds rather than incomplete emulation
	#; Implicit inputs: log,m
	#; Implicit outputs: ptl,mt,ptv
	#; PVA316 noconds: no irrecoverable side effects for quickcost setup
	QUIT:noconds
	n a,b,con,list,li,ptlg,op,pi,type,v,val,vals,xa,xb
	if $$conds^%qaqpnl
	QUIT 
aoaIsSatFromSubs(v)
	if $p($p(v,"^",2),"%NOINDEX")="ANYOFAND" // PVA242
	{	QUIT:($l(v,"^")>5) 0						/* more than one ANDed term => not satisfiable from an index */
		QUIT:($e(mt(ev,$p(v,"^",4)))="v") 1			/* one ev=v type log => is satisfiable by reading the index */
		QUIT:("!"'=$p(mt($e(v),$p(v,"^",4)),"^",2)) 0		/* single operand is not an OR => not satisfiable from an index */
		QUIT $$aoaIsSatFromSubs($$$mtL($p(v,"^",4)))
	}
	#; Else we must be sitting on an OR
	if $$$mtLOperator($$$mtL($p(v,"^",4)))="!" { QUIT:'$$aoaIsSatFromSubs($p(v,"^",4)) 0 } else { QUIT:$e($$$mtL($p(v,"^",4)))'="v" 0 }
	if $$$mtLOperator($$$mtL($p(v,"^",5)))="!" { QUIT:'$$aoaIsSatFromSubs($p(v,"^",5)) 0 } else { QUIT:$e($$$mtL($p(v,"^",5)))'="v" 0 }
	QUIT 1
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
baseFlds(log)
	n baseFld,baseFlds,fval,f,flds,v,p
	s flds=$p($g($$$mtL(log)),"^",3),baseFlds=""
	QUIT:$l(flds)<3 ""
	f f=2:1  s fval=$p(flds,",",f) q:fval=""  s v=$$$mtV(fval),p=$find(v,$s(v["%ANYOFKEY":"%ANYOFKEY",1:"%ANYOF")) s:p>0 baseFld=$e(v,p,*) s:(p>0&&'$lf(baseFlds,baseFld)) baseFlds=$g(baseFlds)_$lb(baseFld)
	QUIT baseFlds
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
pointifyON(m)	
	#; JLF131 - New procedure pointifyON
	#;
	#; Create left, right, and parent pointers for each mt("ON",m,*)
	#;
	new contained,i,oi,oj,iNode,jNode,oil,oir,ojl,ojr,anyIStream,parentStrCount
	s oi=""
	for
	{	s oi=$o($$$mtOn(m, oi),1,iNode) q:oi=""
		s oil=$lg(iNode,$$$SQLONLEFTSTREAMS),oir=$lg(iNode,$$$SQLONRIGHTSTREAMS)
		s $li($$$mtOn(m, oi),$$$SQLONPARENT)="",$li($$$mtOn(m, oi),$$$SQLONPARENTSIDE)=""
		s parentStrCount="",anyIStream=$li(oil)
		s oj=""
		for
		{	s oj=$o($$$mtOn(m, oj),1,jNode) q:oj=""
			continue:oi=oj
			s ojl=$lg(jNode,$$$SQLONLEFTSTREAMS),ojr=$lg(jNode,$$$SQLONRIGHTSTREAMS)
			
			if ($ll(oil)+$ll(oir))<=$ll(ojl) && ((parentStrCount="") || (parentStrCount>$ll(ojl))) && $lf(ojl,anyIStream)
			{	s parentStrCount=$ll(ojl)
				s $li($$$mtOn(m, oi),$$$SQLONPARENT)=oj
				s $li($$$mtOn(m, oi),$$$SQLONPARENTSIDE)=$$$SQLONLEFTSTREAMS
			}
			elseif ($ll(oil)+$ll(oir))<=$ll(ojr) && ((parentStrCount="") || (parentStrCount>$ll(ojr))) && $lf(ojr,anyIStream)
			{	s parentStrCount=$ll(ojr)
				s $li($$$mtOn(m, oi),$$$SQLONPARENT)=oj
				s $li($$$mtOn(m, oi),$$$SQLONPARENTSIDE)=$$$SQLONRIGHTSTREAMS
			}
		}
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
linearizeON(m)
	#; JLF131 - New procedure linearizeON
	#; PVA113: simplify and modify in prep for prior fjxfrm usage
	#;
	#; Convert the ON forest to left-deep format by moving entire ON subtrees that 
	#; are on the null-padded side of a  left join (that is not itself in the null pad side 
	#; of an ON) into their own query block.  When
	#; complete, each tree in the ON forest will be a left deep sequence of zero or
	#; more left outer joins 
	#;
	new oi,onNode s oi=""
	for 
	{	s oi=$o($$$mtOn(m, oi),1,onNode) q:oi=""  
		continue:$$inNullPaddedSubtree(m,onNode)
		do:$ll($li($$$mtOn(m, oi),$$$SQLONRIGHTSTREAMS))>1 cvtONSubtreeToQB(m,oi,$$$SQLONRIGHTSTREAMS)
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cvtONSubtreeToQB(m,splitNode,side) 
   #; JLF131 - New procedure cvtONSubtreeToQB 
   #; 
   #; Convert ON subtree to query block (streamed view). 
   #; 
   n strs,i,sqb,x s strs="," 
   #; PVA108: cr8strview needs stream numbers, not names; also expects caller to use flds^%qaqpnl
   for i=1:1:$ll($li($$$mtOn(m, splitNode),side)) s strs=strs_$$$ptrel(m_"^"_$li($li($$$mtOn(m, splitNode),side),i))_"," 
   s sqb=$$cr8strview(strs,"","","","") 
   s x=m,m=sqb d flds^%qaqpnl
   s m=x d flds^%qaqpnl
   QUIT 
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
inNullPaddedSubtree(m,onNode)
	#; JLF131 - New procedure inNullPaddedSubtree
	#; PVA113 - Simplify to just return boolean; return of splitnode no longer needed.
	#;
	#; Returns 1 if onNode in m is on the null padded side of some ancestor ON node, 
	#; else returns 0
	#;
	QUIT:$li(onNode,$$$SQLONPARENT)="" 0
	QUIT:$li($$$mtOn(m,$li(onNode,$$$SQLONPARENT)),$$$SQLONOPERATOR)=$$$SQLONFULLJOIN 1
	QUIT:$li($$$mtOn(m,$li(onNode,$$$SQLONPARENT)),$$$SQLONOPERATOR)=$$$SQLONINNERJOIN $$inNullPaddedSubtree(m,$$$mtOn(m,$li(onNode,$$$SQLONPARENT)))
	QUIT:$li(onNode,$$$SQLONPARENTSIDE)=$$$SQLONLEFTSTREAMS $$inNullPaddedSubtree(m,$$$mtOn(m,$li(onNode,$$$SQLONPARENT)))
	QUIT 1	
	#; PVA145: create lfldscln
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
lfldscln(type,list,m)
	#; A wrapper for lflds that is 'clean' in variable usage, including not relying 
	#; on a public m value. As such, it does not support a 'do' option: it is a 
	#; pure function.
	#; NOTE: ptv needs to be ptv set correctly for all fields (of all
    #; queries) when this is called.
	n v,ev,i,flagg,lv,fldList
 	Set fldList = $$lflds^%qaqpnl(type,list)
 	#; Remove the final comma from multiple returns so that
 	#; this function can be used to translate a list piecewise from
 	#; e.g. ...,8,... to ...,2,3,...
 	If $e(fldList,*) = "," Set $e(fldList,*) = ""
 	QUIT fldList
#; PVA299: Create linxrefs
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
linxrefs(sqb) [linx,mt] public
    {   s sqbstr=$p($$$mtV($$$mtPViewIDVal($$$mtP(sqb))),"^",2)
        s bad=0
        f li=1:1 
        {  s v=$p(linx,"^",li) quit:'v
           s fv=$$$mtV($$$mtLOperand1($$$mtL(v)))
           if $e(fv)="f"&&($p(fv,"^",2)=sqbstr)&&($e($$$mtV($li($$$mtVirf(+$p(fv,"^",3)),2)))'="f") { set bad=1 quit }
        }
	    QUIT bad
    }
#; PVA300: Create badselexps
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
badselexps(sqb) [mt,nopad,call] public
 {  s svnopad=nopad,bad=0,call="nopad^%qaqpnl"
   for i=1:1 
   {  s v=$p($$$mtOutputVals($$$mtOutput(sqb)),",",i) quit:v=""
      s nopad=""
      d lvtree^%qaqpnl("v",v)
      if nopad="" && ($$$mtV(v)'="t^"){ s bad=1 quit}
   }
   s nopad=svnopad
   QUIT bad
 }	
 
findRTPCTruthValueInfo(val,&truthValue) [mt,rtpcTVLogInfo] public {
	RETURN:'$D(mt("nRTP","TruthValueInfo")) 0
	new rtpcTVLogInfo
	set rok = 1,v = $$$mtL(val)
	set lok = $$dfsXprs^%qaqcoutlier(0,$s(%caller["ShowPlan":2,1:0),,$p(v,"^",4),"CheckTruthValues")
	RETURN:'lok 0	
	set:$p(v,"^",5) rok=$$dfsXprs^%qaqcoutlier(0,$s(%caller["ShowPlan":2,1:0),,$p(v,"^",5),"CheckTruthValues") // in case the operator is null or 'null
	RETURN:'rok 0	
	set hash = $$$Base64SHA($lb($p(v,"^",2))_rtpcTVLogInfo,10)
	if $g(mt("nRTP","TruthValueInfo",hash),"ignore")'="ignore" {
		set truthValue = mt("nRTP","TruthValueInfo",hash)
		RETURN 1
	}
	RETURN 0
}
