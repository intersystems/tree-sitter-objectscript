====
qaqutility
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqutility^MAC^^^0
%qaqutility	
	;; COMPONENTS :: SQL/Utility
	#;
#INCLUDE %msql
/// Convert a $lb(item1,item2,...,itemN) list to an "item1,item2,...,itemN," string, ignoring items that are undefined or "" 
listToStringSkipNull(list,delimiter=",") [] PUBLIC 
{
	Set str="" 
	For i=1:1:$LISTLENGTH(list) {
		Set:$LISTGET(list,i)]"" str=str_$LIST(list,i)_delimiter
	}
	Quit str
}
.
/// Add a new mt("v") value entry [v] and return its value entry number on mt("v"). If createval=1, call createval^%qaqpdt to iteratively create new mt("v") entries for the sub-variables used in v.  
/// Pre-BYS259 function calls to post-BYS259 function calls conversion:
///     newval^%qaqcasl: $$newval(v,addpti=1,name,vnew=0,val="",addtokillvars=0) -> $$newval^%qaqutility(v,0,1,name,vnew=0,val="",addtokillvars=0)
///     newval^%qaqpagg: $$newval(v) -> $$newval^%qaqutility(v)
///     newval^%qaqpmod: $$newval(v) -> $$newval^%qaqutility(v,1)
///     putval^%qaqcasl: do putval(v) -> Set val=$$newval^%qaqutility(v)
///     putval^%qaqpagg: do putval(v) -> Set val=$$newval^%qaqutility(v)
///     putval^%qaqpmod: do putval(v) -> Set val=$$newval^%qaqutility(v,1)
/// Note that $$$lexputval in %msql and any other macro related to it were not replaced as $$$lexputval is a parser-specific helper macro
newval(v,createval=0, addpti=0,name,vnew=0,val="",addtokillvars=0,nosub=0,sqltmp=0) [mt,pti,cflag] PUBLIC {
	If val="" { Set val=$$$maxv+1}
	Set:($DATA(v)#2) $$$mtV(val)=v 
	If createval {
		Do createval^%qaqpdt(val)
	}
	If addpti {
		Do addpti($GET(name),val,vnew,addtokillvars,nosub,sqltmp)
	}
	Return val
}
.
/// Add a mt("v") value [val] with name [name] to pti 
/// If vnew=1: call vNEW^%qaqcasl if %msqlvar is a local variable (this case shows up in newval^%qaqcasl, which as been replaced by newval^%qaqutility)
/// If addtokillvars=1: add the variable to mt("killvars")
/// If nosub=1: use a %msqlvar local variable (this case shows up in newvar^%qaqcasl, which as been replaced by newval^%qaqutility) 
/// If tmp=1: use a %sqltmp local variable (this case shows up in scratch^%qaqcpr)
addpti(name,val,vnew=0,addtokillvars=0,nosub=0,sqltmp=0) [mt,pti,cflag] PUBLIC {
	If %msqlvar="i%%" {
		Set pti(val)=$$addcursorvar^%qaqcasl(%classname,name,val)
		Set:addtokillvars mt("killvars")=$GET(mt("killvars"))_$LISTBUILD(pti(val))
	} Else {
		// this is the less likely case
		If sqltmp {
			Set pti(val)="%sqltmp"_val 
			Set addtokillvars=1
		} ElseIf nosub { 
			Set pti(val)=%msqlvar_"d"_val
			Set addtokillvars=1 
		} Else {
			Set pti(val)=$SELECT(%msqlvar["(":$PIECE(%msqlvar,"(")_"d"_"("_$PIECE(%msqlvar,"(",2)_","_$ZUTIL(144,1,val)_")",$$$%msqlvarIsLocalVar:%sqldatavar_val_"d",1:%msqlvar_"d"_"("_val_")") 
			Set addtokillvars=0
		}
		Set:addtokillvars mt("killvars")=$GET(mt("killvars"))_$LISTBUILD(pti(val))
		If (vnew&&$$$%msqlvarIsLocalVar)||sqltmp||('cflag) Do vNEW^%qaqcasl(pti(val))
	}
	Return val
}
.
/// Return value number on mt("v") of newly-allocated scratch variable with name [name] and generate a cross-reference for the name under mt("var")
///      nosub=1 means use a non-subscripted variable name
/// Pre-BYS259 function calls to post-BYS259 function calls conversion:
///		newvar^%qaqcasl: $$newvar(name,nosub=0)-> $$newvar^%qaqutility(name,nosub=0)
///		newvar^%qaqpmod: $$newvar(name) -> $$newvar^%qaqutility(name)
///		newvar^%qaqpsq: $$newvar(name) -> $$newvar^%qaqutility(name,0,0)
newvar(name,nosub=0,addpti=1) [mt,pti,cflag] public {
	Set val=$SELECT(name="CursorState":0,1:$ORDER($$$mtV(""),-1)+1) // Always give CursorState the '0' number so it is consistent for use across the cursor, see Prodlog 151722
	Set v = "i^^i^"_name
	Set $$$VarNum(name)=$$newval(v,1,addpti,name,0,val,0,nosub)
	Return $$$VarNum(name)
}
.
/// Returns the name of a scratch variable with name [name], generate it if doesn't exist already
/// nosub=1 means use a non-subscripted variable name
/// Pre-BYS259 function calls to post-BYS259 function calls conversion:
/// 	getvar^%qaqcasl: getvar(name) -> getVarName^%qaqutility(name)
getVarName(name) [mt,pti,cflag] public {
	If '$DATA($$$VarNum(name)) {
		Do newvar(name)
	}
	Return $$$VarName(name)
}
.
/// Returns the value number (on mt("v")) of a named scratch variable , generate it if doesn't exist already
/// Pre-BYS259 function calls to post-BYS259 function calls conversion:
/// 	getvar^%qaqpmod: getvar(name) -> getVarNum^%qaqutility(name)
getVarNum(name) [mt,pti,cflag] PUBLIC { 
	If '$DATA($$$VarNum(name)) {
		Return $$newvar(name)
	}
	Return $$$VarNum(name)
}
.
/// Add a new mt("l") entry, l. Return its log number on mt("l")
/// Pre-BYS259 function calls to post-BYS259 function calls conversion:
///		newlog^%qaqpnl: $$newlog^%qaqpnl(l) -> $$newlog^%qaqutility(l)
///		newlog^%qaqpagg: $$newlog^%qaqpagg(l) -> $$newlog^%qaqutility(l)
///		newlog^%qaqpqo: $$newlog^%qaqpqo(l) -> $$newlog^%qaqutility(l)
///		newlog^%qaqpre3: $$newlog^%qaqpqo(l) -> $$newlog^%qaqutility(l)
///     putlog^%qaqpnl: do putlog^%qaqpnl(l) -> Set val=$$newlog^%qaqutility(l)
///     putlog^%qaqpagg: do putlog^%qaqpagg(l) -> Set val=$$newlog^%qaqutility(l)
///     putlog^%qaqpqo: do putlog^%qaqpqo(l) -> Set val=$$newlog^%qaqutility(l)
///     putlog^%qaqpre3: do putlog^%qaqpre3(l) -> Set val=$$newlog^%qaqutility(l)
/// Notes:
/// 	1. this subroutine doesn't have any option to call createlog^%qaqpdt as createlog^%qaqpdt is usually not called together with newlog (unlike newval)
/// 	2. $$$lexputlog in %msql and any other macro related to it were not replaced as $$$lexputlog is a parser-specific helper macro
newlog(l) [mt] PUBLIC {
	Set log=$$$maxl+1
	Set $$$mtL(log)=l
	Return log
}
