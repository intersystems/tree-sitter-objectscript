^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqpifo^MAC^^^0
%qaqpifo	// Get info in mtc(0,0,)
	;; COMPONENTS :: SQL/DataDictLookup
	#;
#INCLUDE %msql
#IF 0   ;-------------------------------------------------------------
	; Description:   Create mtc(0,0,... array
	; Author:        Aviel Klausner
	; Date Started:  7/7/92
	; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ]
	;
	;  DPV3367 (03/03/2009) - Correct NULLABLE reporting for UNION queries
	;  DPV3258 (08/26/2008) - Avoid <SUBSCRIPT> error on long -> chains
	;  DPV3128 (03/21/2008) - Fix type reporting for union queries
 	;  PVA149  (10/15/2007) - Restore support of arrow syntax from view columns in post 2007.1 versions
	;  PVA129  (02/23/2007) - <UNDEFINED>clone+3^%qaqpnl when compiling CREATE VIEW of full outer join of two comples full outer joins
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  DPV2060 (08/21/2003) - Eliminate ^mdd - Use new 'smd' macros
	;  PVA050  (02/12/2003) - ensure use of rowid based on one field, and the field itself are equally optimized. 
	;  DPV1522 (04/12/2001) - Remove call to %qactpt1 to see if Int->Ext code exists
	;  DPV1414 (10/11/2000) - Fix prepared names of aggregate, expression, and literal columns
	;  AK398   (10/13/1999) - Fix ODBC Server error reporting
	;  DPV1045 (04/15/1999) - Fix -> syntax field lookup
	;  DPV937  (02/27/1999) - Return field name as field description in mtc() for ADO
	;  DPV947  (01/07/1999) - Determine a field's ifn without calling $$path
	;  MRP670  (02/10/97)   - Support SQL_TIMESTAMP & MEMO Field...
	;  MRP642  (09/18/96)   - Robust Stored Procedure Information...
	;                       --- Clean Up - Old Routine (zqapinfo) ---
	;  MRP548  (11/12/95)   - Support System Type Templates...
	;   VM019   (11/30/94)   - Add support for M Time Stamp
	;   MRP455  (10/21/94)   - Don't check privilages for DesRef fields...
	;   PRT020  (09/15/94)   - Change datatype for server to 14-17 for dates
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
	; Collect Data Dictionary info after resolving SELECT *:
	; For each SELECT-item get its description, datatype, length, whether
	; repeating, and whether it has internal-to-external conversion
	;
	; For more detailed information that will be returned, see the 
	; comments in the 'moreinfo' module  in '%qaqpif2'.           (MRP642)
	;
#ENDIF  ;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
 
info	;
	#; ------ List ALL Tables in FROM ------
	s ml="1^"
	f li=1:1 s ml=$o($$$mtFromTableName(ml)) q:+ml'=1  s $p(list,",",li)=$$$mtFromTableName(ml)
		
	new gi,unf
	do defineunf
	s i=0,ext=0  ; Loop over SELECT-list...
	f li=1:1 s fval=$$nexto q:fval=""  s mtc(0,0,"select",li)=$$selit("select",li,fval)
	s mtc(0,0,"select")=li-1  ; Size of the SELECT-list
	d moreinfo^%qaqpif2(list,"select")  ; Collect more detailed info about SELECT-list & Params...
	if ",SEL,DEC,"'[(","_$$$mtStatementType_",") k mtc(0,0,"select") QUIT  ; Not SELECT								// DPV3128
	QUIT
.
.
	#; the following code will populate unf(), which is used to record the union legs item pairs.
	#; for example, if we have:
	#;    select a,b union select c,d union select e,f
	#; we define:	unf(val(a))=$lb(val(a),val(c),val(e))
	#;		unf(val(b))=$lb(val(b),val(d),val(f))
	#; we then use this structure to define most compatible type/precision/length/scale/etc. for each column in the union query
	#; This is also called from docats^%qaqpdt
defineunf
	new ii,ival,jj,pos	// gi used in getinfo^%qaqpif2
	for ii=$$$mtPNumQbs:-1:1 {
		if $g($$$mtUnionTopQb(ii))=ii {
			for pos=1:1:$ll($g($$$mtUnionLegVals(ii))) {
				set val=+$$skipas($li($$$mtUnionLegVals(ii),pos))
				set unf(val)=$lb(val)
				for jj=ii+1:1:$$$mtPNumQbs {
					set:$g($$$mtUnionTopQb(jj))=ii ival=+$$skipas($li($$$mtUnionLegVals(jj),pos)),unf(val)=unf(val)_$g(unf(ival),$lb(ival))
				}
			}
		}
	}
	QUIT
.
skipas(val) [mt] PUBLIC { QUIT:$$$mtVType($$$mtV(val))'="s" val QUIT $p($$$mtV(val),"^",4) }
	
max(a,b) [] PUBLIC { q:a>b a q b }											// DPV3128-
	
.
selit(select,li,fval) [mt,mtc] PUBLIC {	; Process a single SELECT-item.  So far, mtc(,,,li)= $p($c(1)):
		#;---------------------------------------------------------------------
		#;  1. AS variable v1, if there was one
		#;  2. query text of the item, if it was not a field
		#;---------------------------------------------------------------------
	s v=$g(mtc(0,0,select,li)),v1=$p(v,$c(1)),past10=$p(v,$c(1),11,*)
		#;  If no as variable and the fval type is 'a' or 'v', see if there is an alias in another 'v' node (DPV1414)
	s ufval=fval,uv=$$$mtV(fval) d vfollow^%qaqpif2(.ufval,.uv) // PVA129: follow to underlying val if streamed view
		#; PVA129: following a,e,t,v test based un underlying val for streamed views
	i v1="",$$$IsOneOf($$$mtVType($$$mtV(ufval)),"a,e,t,v") s v1=fval f  s v1=$o($$$mtV(v1)) q:v1=""  i $$$mtVType($$$mtV(v1))="s",$p($$$mtV(v1),"^",4)=fval s v1=$p($$$mtV(v1),"^",5) q  	// DPV1414=
		#; --- If not a field, default in Text of length 10
		#; PVA129: further work done on underlying val for streamed views; 
	s fval=ufval
		#; PVA129: can't rely on mtc categorization for streamed views. Must re-check underlying val for being field
	if $p(v,$c(1),2)'=""||($$$mtVType($$$mtV(fval))'="f")||($p($$$mtV(fval),"^",4)="%VID") { set $p(v,$c(1),3,4)=8_$c(1)_10 goto as }
		#;  it's a field - use $$$mtV(fval)="f"^1^[label]^{name.}field-name
		#;                     $$$mtFromTableName(m^label)=table-name
	s v=$$$mtV(fval),fname=$p(v,"^",4),tname=$s($p(v,"^",2,3)'["->":$g($$$mtFromTableName($p(v,"^",2,3))),1:"")	// DPV3258 (Avoid <SUBSCRIPT> error on long -> chains
	s:tname="" tname=$$$LastPiece($p(v,"^",3),"->") // PVA149: new convention for table name arrow syntax resolves to
		#; PVA149: remove use of path^%qavFunctions
	s ifn=$$GetifnFromTableOrView(fname,tname) d error(31):'ifn 
	If ifn'[$c(1) {	// Table field
		s v=$$ddata(ifn)
	}
	Else {		// View field - ifn = virn_$c(1)_vcol
		s v=$$ddata(ifn)
			#; -- If a viewfield, use field name and description from view! --
		s fname=$$$smdColName(3,+ifn,$p(ifn,$c(1),2)),$p(v,$c(1))=fname,$p(v,$c(1),2)=fname
	}
as	; If AS variable given, use it as field name and as default title...
	s $p(v,$c(1),11)=past10
	s:v1'="" $p(v,$c(1))=v1,$p(v,$c(1),10)=v1
	s $p(v,$c(1),11)=$g(fval)  ; val#
		#; --- If no default title given, use the description ---
	s:$p(v,$c(1),10)="" $p(v,$c(1),10)=$p(v,$c(1),2)
		#; --- If still NULL, use the name ---
	s:$p(v,$c(1),10)="" $p(v,$c(1),10)=$p(v,$c(1))
	QUIT v
}
 
 
GetifnFromTableOrView(fname,tvlist) [] PUBLIC {
		#;  Given a field name and a list of table(s) and/or view(s) the field is in, determine the field's ifn
		#;  tvlist is a comma delimited list of tables and or views
		#;  For table fields, return ifn
		#;  For view fields, return virn_$c(1)_vcol
	s ifn=""
		// *** NEEDS TO BE FIXED FOR VIEWS
	For i=1:1:$l(tvlist,",") {
		s relname=$p(tvlist,",",i)
		s irn=$$$smdLoadGetIrn(relname)
		If $$$smdGetTType(relname)=1 If $$$smdFieldExists(1,irn,fname) s ifn=$$$smdGetIfn(1,irn,fname) i ifn { s qval=ifn q  }  continue
		If $$$smdGetTType(relname)=3 If $$$smdFieldExists(3,irn,fname) s ifn=$$$smdGetIfn(3,irn,fname),ifn=$p($$$smd(3,irn,"f",$$$UPPER(fname),ifn),$c(1),2) i ifn s qval=irn_$c(1)_ifn q  // ifn is really the view column number
	}
	QUIT qval
}
 
 
ddata(ifn) [] PRIVATE {	
		#; $$: Basetable field info from the DD:
		#;     RETURN:  Fieldname $c(1) Fieldname $c(1,1) Length $c(1,1) 0 $c(1) irn $c(1) ifn
	s x=$$finfo^%qaqpif2(ifn)
	QUIT $p(x,$c(1))_$c(1)_$p(x,$c(1))_$c(1,1)_$p(x,$c(1),3)_$c(1,1)_0_$c(1)_$$$smdGetIrnFromIfn(ifn)_$c(1)_ifn
}
.
.
nexto()	;$$: The next entry from $$$mtOutput(1)
	#; --- Start with i=ext=0, preserve their values between calls ---
	s i=i+1
	i 'ext,i<$l($g($$$mtOutput(1)),",") QUIT $p($$$mtOutputVals($g($$$mtOutput(1))),",",i)  ; Found in the main node
	s:i'<$l($g($$$mtOutputOverflow(1,ext)),",") ext=ext+1,i=1  ; Not in this node - try next
	QUIT $p($g($$$mtOutputOverflow(1,ext)),",",i)
.
nextom(m)	;$$: The next entry from $$$mtOutput(m)
	#; --- Start with i=ext=0, preserve their values between calls ---
	s i=i+1
	i 'ext,i<$l($g($$$mtOutput(m)),",") QUIT $p($$$mtOutputVals($g($$$mtOutput(m))),",",i)  ; Found in the main node
	s:i'<$l($g($$$mtOutputOverflow(m,ext)),",") ext=ext+1,i=1  ; Not in this node - try next
	QUIT $p($g($$$mtOutputOverflow(m,ext)),",",i)
.
error(e)	g ^%qaqperr
