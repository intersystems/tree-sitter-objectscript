====
fm2class2
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%fm2class2^MAC^^^0
%fm2class2	// VA FileMan -> InterSystems Class Mapper
.
#include %msql
#include %fm2class
.
	#;---------------------------------------------------------------------
	#; Description:   New Fileman to Class Interface
	#; Author:        David Van De Griek
	#; Date:          July 2008
	#; Maintenance History: [ XXXnnn (MM/DD/YY) - Description ] 
	#;
	#;  DPV4053 (06/27/2012) - Remove BigTrigger logic (for 2011.1+ only) (2.11)
	#;  DPV3957 (12/05/2011) - Implement $$$variablePointerValueField setting (2.06)
	#;                         Implement $$$expandPointers=3 setting
	#;  DPV3628 (05/05/2010) - Correct filing (insert) into Sub-File, allow FileMan to define IEN (1.21)
	#;  DPV3612 (04/14/2010) - Correct NEW logic in filing triggers (1.19)
	#;  DPV3579 (02/16/2010) - Define ability to have Required properties for required fields or required identifiers (1.17)
	#;                         Don't create fkeys for SOC tables added by v1.16
	#;                         Allow SC fields to be defined as String and not EnumString
	#;  DPV     (02/01/2010) - Allow SetOfCodes to be set up in a separate table and linked via a fkey (1.16)
	#;  DPV3398 (04/23/2009) - Correct problem building classes with too many properties (1.11)
	#;  DPV3352 (01/28/2009) - Fix mapping of corrupt multiple pointer, fix FILEMANFILENAME parameter (1.10)
	#;  DPV3343 (01/15/2009) - Make %fm2class smaller (1.09)
	#;  DPV3339 (01/13/2009) - Qualify table name in ExpandedPointers computed field query (1.08)
	#;  DPV3317 (11/25/2008) - Use conditional index maps when $E({field},1,N) subscript expression is used (1.07)
	#;                         Correct reference with non-defined type parameters
	#;  DPV3235              - Implement new utility %fm2class
	#; --------------- Changes below were from %fm2cache ----------------------
	#;  DPV3217 (07/08/2008) - Improve performance of class creation (.815)
	#;                         Add FILEMANFILENAME and FILEMANFILENUMBER class parameters
	#;  DPV3126 (03/17/2008) - Default String field length is now 255.    (.813)
	#;                         Use %String for IEN fields.
	#;                         Define MINLEN on %String fields where appropriate
	#;                         Fix <UNDEFINED> error with fid in index2
	#;                         Perform one save of entire class instead of saving each class item
	#;                         Field names longer the 50 characters are now supported
	#;  DPV3084 (12/13/2007) - Use %EnumString datatype for multiple choice fields (.812)
	#;  DPV3069 (11/07/2007) - Add $$$retainClass parameter to not completely delete the class definition (.811)
	#;  DPV3068 (11/06/2007) - Generate index maps from new style cross references
	#;  DPV3013 (09/10/2007) - Add ;PREV logic to Next code, move multpc to %fm2cache2
	#;  DPV3013 (09/10/2007) - Add ;PREV logic to Next code, move multpc to %fm2cache2
	#;  DPV3008 (08/27/2007) - Fix Variable Pointers
	#;  DPV2963 (06/19/2007) - Fix Delete of classes, use 60 for class name length
	#;  DPV2845 (01/23/2007) - Enhance ConvertFiles entry point
	#;  DPV2801 (11/28/2006) - ConvertFiles entry point
	#;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	#;  DPV2449 (06/28/2005) - First checkin of utility
	#;---------------------------------------------------------------------
	#;                     I N F O R M A T I O N
	#;---------------------------------------------------------------------
	#;
	#;   Start your information here...
	#;---------------------------------------------------------------------
 
.
	#;=========================================================================================================
	#;  Overflow from %fm2class
	#;=========================================================================================================
 
CreateFMFilingTriggers(filen,gloref,subfile=0,parrefname="",parfile="",wpfid="") [] PUBLIC {
		#; ENTRY POINT TO CREATE FILING TRIGGERS - CALL THE FILEMAN FILER
		#;
		#;   subfile=0 = main file
		#;   subfile=1 = Sub File
		#;   subfile=2 = Not a sub-file, but a word-processing field
 
		#; Data is passed to and from the DBS as values in the FileMan Data Array (FDA). 
		#; The FDA contains the file, internal entry numbers, and field information in its subscripting scheme.
		#; The format of the FDA is:
		#;    FDA_ROOT(FILE#,"IENS",FIELD#)="VALUE"
 
		#; UPDATE^DIE(FLAGS,FDA_ROOT,IEN_ROOT,MSG_ROOT)
 
 	set errline="if $d(%FMERR("_filen_",""DIERR"")) { new err set U=""^"" do MSG^DIALOG(""AT"",.err,32768,,""%FMERR("_filen_")"") set %ok=0 for err=1:1:err { set $p(%msg,$c(13,10),err)=$g(err(err)) } RETURN }"
 	set tIENName=$lg(^IRIS.TempFM($j,filen),12)
.
		#; -=-=- BEFORE INSERT Trigger -=-=- 
	if subfile=0 {
		set code=$lb("new:'$data(DIC) DIC set DIC(0)="""" new:'$data(DUZ) DISYS,DT,DTIME,DUZ new D0,FDA,FDAIEN,i,IO,U,wp set FDAIEN(1)={"_tIENName_"}")
		set fid="",wplist="" 
		for  {
			set fid=$o(^IRIS.TempFMI($j,"fid",filen,fid),1,fdata) q:fid=""
			continue:$lg(fdata,3)=2	// No computed always fields
			if $lg(fdata,4)	{ set wplist=wplist_$lb(fid) continue  }	// No Word Processing fields - handled later
			do addInputTransform($lg(fdata,1),$lg(fdata,7),.code)
			set code=code_$lb("set:{"_$$quoter2($lg(fdata))_"}'="""" FDA("_filen_",""+1,"","_fid_")={"_$$quoter($lg(fdata))_"}")
		}
		set code=code_$lb("do UPDATE^DIE("""",""FDA"",""FDAIEN"",""%FMERR("_filen_")"") set %SkipFiling=1")
		set code=code_$lb(errline)
		set c=0
		for i=1:1:$ll(wplist) { 
			set fid=$lg(wplist,i)
			set c=c+1,fdata=^IRIS.TempFMI($j,"fid",filen,fid)
			if $$$wpIsList=3 {	// WP field is a long string, lines delimited by $c(13,10)
				set code=code_$lb("if {"_$$quoter2($lg(fdata))_"}'="""" { set D0={RowId} for i=1:1:$l({"_$$quoter2($lg(fdata))_"},$c(13,10)) { set wp(i)=$p({"_$$quoter2($lg(fdata))_"},$c(13,10),i) } do WP^DIE("_filen_",{RowId},"_fid_",,""wp"",""%FMERR("_filen_")"") "_errline_"}")
			} else {
				set code=code_$lb("if {"_$$quoter2($lg(fdata))_"}'="""" { set D0={RowId} for i=1:1:$ll({"_$$quoter2($lg(fdata))_"}) { set wp(i)=$lg({"_$$quoter2($lg(fdata))_"},i) } do WP^DIE("_filen_",{RowId},"_fid_",,""wp"",""%FMERR("_filen_")"") "_errline_"}")
			}
		}
		set code=code_$lb("RETURN")
	} elseif subfile=1 {
		set code=$lb("new:'$data(DIC) DIC set DIC(0)="""" new:'$data(DUZ) DISYS,DT,DTIME,DUZ new D0,FDA,FDAIEN,i,iens,IO,U,wp set:{"_tIENName_"}'=""""&&({"_tIENName_"}'=-999) FDAIEN(1)={"_tIENName_"} set iens=""+1,""_$p({"_tIENName_"S},"","",2,*)") 
		set fid="",wplist=""
		for  {
			set fid=$o(^IRIS.TempFMI($j,"fid",filen,fid),1,fdata) quit:fid=""
			continue:$lg(fdata,3)=2	// No computed always fields
			if $lg(fdata,4)	{ set wplist=wplist_$lb(fid) continue  }	// No Word Processing fields - handled later
			do addInputTransform($lg(fdata,1),$lg(fdata,7),.code)
			set code=code_$lb("set:{"_$$quoter2($lg(fdata))_"}'="""" FDA("_filen_",iens,"_fid_")={"_$$quoter2($lg(fdata))_"}")
		}
		set code=code_$lb("do UPDATE^DIE("""",""FDA"",""FDAIEN"",""%FMERR("_filen_")"") set %SkipFiling=1")
		set code=code_$lb(errline)
		set c=0
		set code=code_$lb("set (pNew(2),%d(2))=$g(FDAIEN(1)),$p(%d(1),""||"",*)=%d(2),pNew(1)=%d(1),$p({IENS},"","",1)=%d(2)")		// Update childsub/IEN/RowID/IENS field with proper assigned value
		for i=1:1:$ll(wplist) {
			set fid=$lg(wplist,i)
			set c=c+1,fdata=^IRIS.TempFMI($j,"fid",filen,fid)
			if $$$wpIsList=3 {
				set code=code_$lb("if {"_$$quoter2($lg(fdata))_"}'="""" { set D0={RowId} for i=1:1:$l({"_$$quoter2($lg(fdata))_"},$c(13,10)) { set wp(i)=$p({"_$$quoter2($lg(fdata))_"},$c(13,10),i) } do WP^DIE("_filen_",{"_tIENName_"S},"_fid_",,""wp"",""%FMERR("_filen_")"") "_errline_"}")
			} else {
				set code=code_$lb("if {"_$$quoter2($lg(fdata))_"}'="""" { set D0={RowId} for i=1:1:$ll({"_$$quoter2($lg(fdata))_"}) { set wp(i)=$lg({"_$$quoter2($lg(fdata))_"},i) } do WP^DIE("_filen_",{"_tIENName_"S},"_fid_",,""wp"",""%FMERR("_filen_")"") "_errline_"}")
			}
		}
		set code=code_$lb("RETURN")
	} elseif subfile=2 {	// Word-Processing Field
		set code=$lb("new:'$data(DIC) DIC set DIC(0)="""" new:'$data(DUZ) DISYS,DT,DTIME,DUZ new FDA,IO,U,wp")
		set fid=.01,fdata=$g(^IRIS.TempFMI($j,"fid",filen,fid)) b:fdata=""
		set code=code_$lb("set wp(1)={"_$$quoter2($lg(fdata))_"}")
		set code=code_$lb("do WP^DIE("_parfile_",$p({"_tIENName_"S},"","",2,*),"_wpfid_",""A"",""wp"",""%FMERR("_filen_")"") set %SkipFiling=1")
		set code=code_$lb(errline)
	}
	set ^IRIS.TempFM($j,filen,"t","BeforeInsertFiling")=$lb("INSERT","BEFORE",0,"BEFORE INSERT Trigger to perform filing",code)
 
		#; -=-=- BEFORE DELETE Trigger -=-=- 
	if subfile=0 {
		set code=$lb("new:'$data(DUZ) DISYS,DT,DTIME,DUZ new %,%H,DA,DIC,DIK,IO,U,X,Y")
		set code=code_$lb("do DTNOLF^DICRW set DIK="_$$quoter(gloref)_" set DA={%%ID} do ^DIK")
		set code=code_$lb("set %SkipFiling=1")
		set code=code_$lb("RETURN ")
	} elseif subfile=1 {
		set c=$l(gloref,$c(1))-1,gloref=$$quoter(gloref)
		set p=1
		for  {
			set p=$f(gloref,$c(1)) quit:'p
			set gloref=$e(gloref,1,p-2)_"""_DA("_c_")_"""_$e(gloref,p,$l(gloref))
			set c=c-1
		}
		set code=$lb("new:'$data(DUZ) DISYS,DT,DTIME,DUZ new %,%H,c,DA,DIC,DIK,i,IO,U,X,Y")
		set code=code_$lb("do DTNOLF^DICRW")
		set code=code_$lb("set c=0 for i=$l({"_$$quoter2(parrefname)_"},""||""):-1:1 { set DA($i(c))=$p({"_$$quoter2(parrefname)_"},""||"",i) }")
		set code=code_$lb("set DIK="_gloref_",DA={"_tIENName_"},%SkipFiling=1 do ^DIK")
		set code=code_$lb("RETURN")
	} elseif subfile=2 {	// Word-Processing Field
		set code=$lb("new:'$data(DUZ) DISYS,DT,DTIME,DUZ new DFDA,i,iens,IO,U,wp For i=$l({"_$$quoter2(parrefname)_"},""||""):-1:1 { s iens=$p({"_$$quoter2(parrefname)_"},""||"",i)_"","" }")
		set code=code_$lb("do GETS^DIQ("_parfile_",iens,"_wpfid_",,""wp"",""%FMERR("_filen_",""""DIQERR"""")"")")
		set code=code_$lb(errline)
		set code=code_$lb("kill wp("_parfile_",iens,"_wpfid_",{"_tIENName_"})")
		set code=code_$lb("if $d(wp("_parfile_",iens,"_wpfid_"))=1 { do WP^DIE("_parfile_",iens,"_wpfid_",,""@"",""%FMERR("_filen_")"") set %SkipFiling=1 }")	// Deleting the only row")
		set code=code_$lb("else { do WP^DIE("_parfile_",iens,"_wpfid_",,""wp("_parfile_",iens,"_wpfid_")"",""%FMERR("_filen_")"") set %SkipFiling=1 }")
		set code=code_$lb(errline)
		set code=code_$lb("RETURN")
	}
	set ^IRIS.TempFM($j,filen,"t","BeforeDeleteFiling")=$lb("DELETE","BEFORE",0,"BEFORE Trigger to perform filing",code)
 
 
		#; -=-=- BEFORE UPDATE Trigger -=-=- 
	if subfile = 0 { 
		set code=$lb("new:'$data(DIC) DIC set DIC(0)="""" new:'$data(DUZ) DISYS,DT,DTIME,DUZ new D0,FDA,i,IENS,IO,U,wp,wproot s IENS={"_tIENName_"}_"",""") 
		set fid="",wplist=""
		for  {
			set fid=$o(^IRIS.TempFMI($j,"fid",filen,fid),1,fdata) quit:fid=""
			continue:$lg(fdata,3)=2	// No computed always fields
			if $lg(fdata,4)	{ set wplist=wplist_$lb(fid) continue  }	// No Word Processing fields - handled later
			if $lg(fdata,7)'="" {
				set code=code_$lb("if {"_$$quoter2($lg(fdata))_"*C} {")
				do addInputTransform($lg(fdata,1),$lg(fdata,7),.code,1)
				set code=code_$lb($c(9)_"set FDA("_filen_",IENS,"_fid_")={"_$$quoter2($lg(fdata))_"}")
				set code=code_$lb("}")
			} else {	// no input transform
				set code=code_$lb("set:{"_$$quoter2($lg(fdata))_"*C} FDA("_filen_",IENS,"_fid_")={"_$$quoter2($lg(fdata))_"}")
			}
		}
		set code=code_$lb("d:$d(FDA) UPDATE^DIE("""",""FDA"",,""%FMERR("_filen_")"") set %SkipFiling=1")
		set code=code_$lb(errline)
		for i=1:1:$ll(wplist) {
			set fid=$lg(wplist,i)
			set fdata=^IRIS.TempFMI($j,"fid",filen,fid)
			if $$$wpIsList=3 {
				set code=code_$lb("if {"_$$quoter2($lg(fdata))_"*C} { set D0={RowId} kill wp if {"_$$quoter2($lg(fdata))_"}'="""" { set wproot=""wp"" for i=1:1:$l({"_$$quoter2($lg(fdata))_"},$c(13,10)) { set wp(i)=$p({"_$$quoter2($lg(fdata))_"},$c(13,10),i) }} else { set wproot=""@"" } do WP^DIE("_filen_",{RowId},"_fid_",,wproot,""%FMERR("_filen_")"") "_errline_"}")
			} else {
				set code=code_$lb("if {"_$$quoter2($lg(fdata))_"*C} { set D0={RowId} kill wp if {"_$$quoter2($lg(fdata))_"}'="""" { set wproot=""wp"" for i=1:1:$ll({"_$$quoter2($lg(fdata))_"}) { set wp(i)=$lg({"_$$quoter2($lg(fdata))_"},i) }} else { set wproot=""@"" } do WP^DIE("_filen_",{RowId},"_fid_",,wproot,""%FMERR("_filen_")"") "_errline_"}")
			}
		}
		set code=code_$lb("RETURN")
	} elseif subfile=1 { 
		set code=$lb("new:'$data(DIC) DIC set DIC(0)="""" new:'$data(DUZ) DISYS,DT,DTIME,DUZ new D0,FDA,n,i,IENS,IO,U,wp,wproot set IENS={"_tIENName_"S}") 
		set fid="",wplist=""
		for  {
			set fid=$o(^IRIS.TempFMI($j,"fid",filen,fid),1,fdata) quit:fid=""
			continue:$lg(fdata,3)	// No computed fields
			if $lg(fdata,4)	{ set wplist=wplist_$lb(fid) continue  }	// No Word Processing fields - handled later
			if $lg(fdata,7)'="" {
				set code=code_$lb("if {"_$$quoter2($lg(fdata))_"*C} {")
				do addInputTransform($lg(fdata,1),$lg(fdata,7),.code,1)
				set code=code_$lb($c(9)_"set FDA("_filen_",IENS,"_fid_")={"_$$quoter2($lg(fdata))_"}")
				set code=code_$lb("}")
			} else {	// no input transform
				set code=code_$lb("set:{"_$$quoter2($lg(fdata))_"*C} FDA("_filen_",IENS,"_fid_")={"_$$quoter2($lg(fdata))_"}")
			}
		}
		set code=code_$lb("do:$d(FDA) UPDATE^DIE("""",""FDA"",,""%FMERR("_filen_")"") set %SkipFiling=1")
		set code=code_$lb("if $d(%FMERR("_filen_",""DIERR"")) { set %ok=0,%msg=""Call to FileMan Filer (UPDATE^DIE) failed.  See %FMERR("_filen_",""""DIERR"""") for details"" RETURN }")
		for i=1:1:$ll(wplist) {
			set fid=$lg(wplist,i)
			set fdata=^IRIS.TempFMI($j,"fid",filen,fid)
			if $$$wpIsList=3 {
				set code=code_$lb("if {"_$$quoter2($lg(fdata))_"*C} { set D0={RowId} kill wp if {"_$$quoter2($lg(fdata))_"}'="""" { set wproot=""wp"" for i=1:1:$l({"_$$quoter2($lg(fdata))_"},$c(13,10)) { set wp(i)=$p({"_$$quoter2($lg(fdata))_"},$c(13,10),i) }} else { set wproot=""@"" } do WP^DIE("_filen_",{"_tIENName_"S},"_fid_",,wproot,""%FMERR("_filen_")"") "_errline_"}")
			} else {
				set code=code_$lb("If {"_$$quoter2($lg(fdata))_"*C} { set D0={RowId} kill wp if {"_$$quoter2($lg(fdata))_"}'="""" { set wproot=""wp"" for i=1:1:$ll({"_$$quoter2($lg(fdata))_"}) { set wp(i)=$lg({"_$$quoter2($lg(fdata))_"},i) }} else { s wproot=""@"" } do WP^DIE("_filen_",{"_tIENName_"S},"_fid_",,wproot,""%FMERR("_filen_")"") "_errline_"}")
			}
		}
		set code=code_$lb("RETURN")
	} elseif subfile=2 {	// Word-Processing Field
		set fid=.01,fdata=$g(^IRIS.TempFMI($j,"fid",filen,fid)) b:fdata=""
		set code=$lb("new:'$data(DIC) DIC set DIC(0)="""" new:'$data(DUZ) DISYS,DT,DTIME,DUZ new FDA,i,iens,IO,U,wp")
		set code=code_$lb("for i=$l({"_$$quoter2(parrefname)_"},""||""):-1:1 { set iens=$p({"_$$quoter2(parrefname)_"},""||"",i)_"","" }")
		set code=code_$lb("do GETS^DIQ("_parfile_",iens,"_wpfid_",,""wp"",""%FMERR("_filen_",""""DIQERR"""")"")")
		set code=code_$lb(errline)
		set code=code_$lb("set wp("_parfile_",iens,"_wpfid_",{"_tIENName_"})={"_$$quoter2($lg(fdata))_"}")
		set code=code_$lb("do WP^DIE("_parfile_",iens,"_wpfid_",,""wp("_parfile_",iens,"_wpfid_")"",""%FMERR("_filen_")"") set %SkipFiling=1")
		set code=code_$lb(errline)
		set code=code_$lb("RETURN")
	}
	set ^IRIS.TempFM($j,filen,"t","BeforeUpdateFiling")=$lb("UPDATE","BEFORE",0,"BEFORE UPDATE Trigger to perform filing",code)
	RETURN
}
 
addInputTransform(fname,transformCode,&code,addTab=0) [] PRIVATE {
	RETURN:'$$$executeInputTransforms
	if transformCode'="",transformCode'="Q",'$$JustLengthCheck(transformCode) {
		set indent=$e($c(9),addTab)
		set code=code_$lb(indent_"set X={"_$$quoter2(fname)_"} "_transformCode_$c(9,9)_"// Input Transformation code for field "_fname)
		set code=code_$lb(indent_"if $d(X) { set {"_$$quoter2(fname)_"}=X } else { set {"_$$quoter2(fname)_"}="""" }" )
	}
	RETURN
}
.
	// Given a string of MUMPS code for a FIleMan field's input transform, see if it is just a length check
JustLengthCheck(str) PRIVATE {
	if str?1"K:$L(X)>"1.N1"!($L(X)<"1.N1") X" { RETURN 1 }
	RETURN 0
}
ExternalTriggerCode(filen,wplist,type,line) [fdata,fid,filen,lcnt,line,type,xline] PUBLIC {
	n fdata,fid,lcnt,xline
	s fid="",wplist="",lcnt=0,xline="" For  {
		s fid=$o(^IRIS.TempFMI($j,"fid",filen,fid),1,fdata) q:fid=""
		continue:$lg(fdata,3)=2	// No computed always fields
		If $lg(fdata,4)	{ s wplist=wplist_$lb(fid) continue  }	// No Word Processing fields - handled later
		x "s xline=xline_"" ""_"_line
		i $l(xline)>4000 s ^IRIS.TempFMI($j,"trig",type,filen,$i(lcnt))=$c(9)_$e(xline,2,$l(xline)) s xline=""
	}
	i xline'="" s ^IRIS.TempFMI($j,"trig",type,filen,$i(lcnt))=$c(9)_$e(xline,2,$l(xline)) s xline=""
}
 
.
header(location,fmlist="") [] PUBLIC {
.
	$$$output1("===============================================================================",2,0)
	$$$output1("InterSystems Corporation FM2Class utility version "_$$GetVersion^%fm2class(),1,4)
	$$$output1("DATE/TIME:",1,4) $$$output1($zdt($h),0,24)
	$$$output1("VERSION:",1,4) $$$output1($SYSTEM.Version.Format(4),0,24)
	$$$output1("NAMESPACE:",1,4) $$$output1($NAMESPACE,0,24)
	$$$output1("UTILITY CALL:",1,4) $$$output1(location_$s(location["$":"",1:"^%fm2class"),0,24)
	$$$output1("UTILITY OPTIONS:",1,4)
	$$$output1("PACKAGE NAME:",1,8) $$$output1($$$package,0,45)
	$$$output1("RECURSION",1,8) $$$output1($case($$$recursion,0:"NONE",1:"PARTIAL",2:"FULL",:$$$recursion)_$s($$$UPPER($$$recursion)["DEPTH":"",1:" ("_$$$recursion_")"),0,45)
	$$$output1("TABLE NAME FORMAT",1,8) $$$output1($$$tableNameFormat,0,45)
	$$$output1("CHILD TABLE NAME FORMAT",1,8) $$$output1($$$childTableNameFormat,0,45)
	$$$output1("FIELD NAME FORMAT",1,8) $$$output1($$$fieldNameFormat,0,45)
	$$$output1("MAXIMUM NAME LENGTH",1,8) $$$output1($$$nameLength,0,45)
	$$$output1("EXTENDED GLOBAL MAPPING STRING",1,8) $$$output1($s($$$extendedMapping="":"<not specified>",1:$$$extendedMapping),0,45)
	$$$output1("EXPANDED POINTERS?",1,8) $$$output1($s($$$expandPointers=1:"YES, OPTION 1, REF and REF_NAME",$$$expandPointers=2:"YES, OPTION 2, REFID and REF",$$$expandPointers=3:"YES, OPTION 3, REF_f<file#>ID and REF",1:"NO")_" ("_$$$expandPointers_")",0,45)
	$$$output1("CREATE VARIABLE POINTER VALUE FIELD?",1,8) $$$output1($s($$$variablePointerValueField=1:"YES",1:"NO")_" ("_$$$variablePointerValueField_")",0,45)
	$$$output1("EXPANDED SET OF CODES?",1,8) $$$output1($s($$$expandSetOfCodes:"YES",1:"NO"),0,45)	
	$$$output1("SET OF CODES DATATYPE:",1,8) $$$output1($s($$$setOfCodesEnum:"%Library.EnumString",1:"%Library.String"),0,45)	
	$$$output1("WORD PROC FIELD SETTING:",1,8) $$$output1($case($$$wpIsList,0:"CHILD TABLE",1:"LIST COLLECTION",2:"BOTH CHILD TABLE and LIST COLLECTION",3:"SINGLE STRING FIELD",:"<unknown>")_" ("_$$$wpIsList_")",0,45)
	$$$output1("PROPERTIES DEFINED AS REQUIRED:",1,8) $$$output1($s($$$requiredType:"REQUIRED FILEMAN FIELDS",1:"REQUIRED FILEMAN IDENTIFIERS")_" ("_$$$requiredType_")",0,45)	
	$$$output1("DATE FIELDS MAP AS TYPE",1,8) $$$output1($$$dateType,0,45)
	$$$output1("DATETIME FIELDS MAP AS TYPE",1,8) $$$output1($$$datetimeType,0,45)
	$$$output1("STRICTDATA TYPE PARAMETER",1,8) $$$output1($$$strictData,0,45)
	$$$output1("RETAIN CLASS?",1,8) $$$output1($s($$$retainClass:"YES",1:"NO"),0,45)
	$$$output1("COMPILE?",1,8) $$$output1($s($$$compile:"YES",1:"NO"),0,45)
	if $$$compile $$$output1("COMPILER QSPEC OPTIONS:",1,8) $$$output1($$$compileQSpec,0,45)
	$$$output1("CLASS DELETE QSPEC OPTIONS:",1,8) $$$output1($$$deleteQSpec,0,45)
	$$$output1("READONLY?",1,8) $$$output1($s($$$readonly:"YES",1:"NO"),0,45)
	$$$output1("IEN FIELD NAME:",1,8) $$$output1($$$ienFieldName,0,45)
	$$$output1("MUMPS CROSS REFS AS INDEX MAP?:",1,8) $$$output1($case($$$mapMUMPSCrossReferences,0:"NONE",1:"ALL BUT ""A"" INDEXES",2:"ALL INCLUDING ""A"" INDEXES",:"<unknown>")_" ("_$$$mapMUMPSCrossReferences_")",0,45)
	if $$$superClasses'="" $$$output1("SUPER CLASSES:",1,8) $$$output1($$$superClasses,0,45)
	if $$$JSONAdaptor'="" $$$output1("JSON ADAPTOR:",1,8) $$$output1($$$JSONAdaptor,0,45)
	if $$$ClassParameters'="" $$$output1("CLASS PARAMETERS:",1,8) $$$output1($$$ClassParameters.%ToJSON(),0,45)
	if $$$logFile'="" $$$output1("LOG FILE:",1,8) $$$output1($$$logFile,0,45)
	$$$output1("DISPLAY OPTION:",1,8) $$$output1($$$display,0,45)
	if fmlist'="" {
		$$$output1("FILES REQUESTED TO BE MAPPED:",1,8) $$$output1($s(fmlist="":"0 FILES",fmlist'[",":"1 FILE",1:$l(fmlist,",")_" FILES"),0,45)
		for  {
			quit:fmlist=""
			if $l(fmlist)<91 { $$$output1(fmlist,1,10) quit  }
			for i=90:-1:1 { quit:$e(fmlist,i)=","  }
			$$$output1($e(fmlist,1,i),1,10)
			set $e(fmlist,1,i)=""
		}
	}
	else {
		$$$output1("FILES REQUESTED TO BE MAPPED",1,8) $$$output1("ALL",0,45)
	}
	$$$output1("===============================================================================",2,0)
	RETURN
}
.
.
References() [] PUBLIC {
	if '$d(^IRIS.TempFMI($j,"desref")) { RETURN }
	do log2^%fm2class("Converting pointer fields to reference properties","M","",2)
	set tabname=""
	new %fmRecursionLevel
	for  {
		set tabname=$o(^IRIS.TempFMI($j,"desref",tabname)) quit:tabname=""
		set fldname=""
		for  {
			set fldname=$o(^IRIS.TempFMI($j,"desref",tabname,fldname),1,dfil) quit:fldname=""
			set $lg(dfil,fk,,%fmRecursionLevel)=dfil	// re-define the %fmRecursionLevel at the time we decided to make this desref
			set dtabname=$lg($g(^IRIS.TempFMI($j,"fm",dfil)))
			set thisfile=^IRIS.TempFMI($j,"rv",$$$UPPER(tabname))
			if dtabname="" { 
				set ok=$$CreateRefTable(dfil,fldname,.dtabname,thisfile)	// create designated table
				if 'ok {
					do MakeString(thisfile,fldname,"%Library.String")
					kill ^IRIS.TempFMI($j,"desref",tabname,fldname)
					continue
				}
			}
			do MakeReference(thisfile,fldname,dtabname)			// make text field a reference
			if $$$expandPointers { do MakeExpandedPointerField(thisfile,dtabname,fldname,dfil,tabname) }
			if fk=1 { set ^IRIS.TempFM($j,thisfile,"fk","FKey_"_fldname)=$lb(dtabname,fldname,"Foreign Key constraint for Variable Pointer reference field "_fldname) }	// DPV3009, Variable pointer reference fields create foreign key constraints
			if fk=2 { set ^IRIS.TempFM($j,thisfile,"fk","FKey_"_fldname)=$lb(dtabname,fldname,"Foreign Key constraint for Pointer reference field "_fldname_"->"_dtabname) }		// DPV3017, Pointer reference fields create foreign key constraints
			kill ^IRIS.TempFMI($j,"desref",tabname,fldname)
		}
		set tabname=""	// We make have more entries populated in the "desref" index, so start from the beginning
	}
	do log2^%fm2class("References Converted","M","",1)
	RETURN
}
 
 
CreateRefTable(dfil,fldname,tabname,thisfile) [] PUBLIC {
		#; CREATE THE DESIGNATED TABLE
	if '$d(^DIC(dfil)) {
		s ok=0,x="WARNING: File #"_dfil_", Field "_fldname_", Unable to create reference class for pointer field, No ^DIC("_dfil_") entry defined,  field mapped as %String."
		d log2^%fm2class(x,"W",,,dfil)
		s dirn=0
		QUIT 0
	}
	s topfil=dfil,err=$$CreateTable^%fm2class(dfil,1,topfil,thisfile)
	g:err CreateRefTableErr
	s tabname=$lg(^IRIS.TempFM($j,dfil))
	QUIT 1
 
CreateRefTableErr
	s ok=0,x="WARNING: File #"_thisfile_", Field "_fldname_", Unable to create reference class for pointer field (err="_err_").  Mapped As String."
	d log2^%fm2class(x,"W",,,dfil)
	s dirn=0
	QUIT 0
}
 
 
MakeReference(filen,fldname,type) [] PUBLIC {
		#; RE-DO THE TEXT FIELD AS A DES REF FIELD
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fldname)),3)=type
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fldname)),14)=""	// Clear Type Parameters
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fldname)),16)=1	// IsAReference
	QUIT
}
 
 
MakeString(filen,fldname,type) [] PUBLIC {
		#; RE-DO THE REFERENCE FIELD AS A String
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fldname)),3)=type
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fldname)),16)=0	// IsAReference
	QUIT
}
.
.
MakeExpandedPointerField(filen,refTable,refField,refFilen,thisTable) [] PUBLIC {
	s stuff=^DD(refFilen,.01,0) // get field specs.
	s required=($p(stuff,"^",2)["R")				// Required
	s flength=$g(^DD(refFilen,.01,30))
	s fmtype=$p(stuff,"^",2)
	s datype=$$datype(fmtype)
	i datype="" s nocon=1 d log2^%fm2class("File #"_refFilen_", Field #.01; Omitting expanded pointer field - unsupported data type.","W",,,refFilen) q
	i $p(stuff,"^",5)="",fmtype["D",'fmtype s nocon=1 d log2^%fm2class("File #"_refFilen_", Field #.01; Omitting expaned pointer field - null input transform on a DATE field.","W",,,refFilen) q
		// Look for a better type
	set type="%Library.String",dt=+datype
	if $p(stuff,"^",5)'="",$p(stuff,"^",5)'="Q" {	// Maybe it is a date/datetime type
		set x=$p(stuff,"^",5,*)
		if fmtype["D" { kill TypeParam("MAXLEN"),TypeParam("MINLEN") set:'flength flength=19 do fmdate(x,fmtype,flength,.type,.TypeParam) }
	}
	if fmtype["J" {
		set x=$e(fmtype,$f(fmtype,"J"),$l(fmtype))
		set:+$p(x,",",2) TypeParam("SCALE")=+$p(x,",",2) 	// NuDeci
	}
	if dt=5,fmtype'["D" {	// numeric data type (Exclude date/time)
		set type="%Library.Numeric",flength=0
		kill TypeParam("MAXLEN"),TypeParam("MINLEN")
		if fmtype?.e1","1n.n.e { set TypeParam("SCALE")=+$p(fmtype,",",2) } ; Nu decPlaces
		set x=$p(^DD(refFilen,.01,0),"^",5)
		if x["(X>" { set y1=$f(x,"(X>"),y2=$f(x,")",y1),z=$e(x,y1,y2-2) set:$isvalidnum(z) TypeParam("MAXVAL")=z,flength=$l(z) } ; NuMax
		if x["(X<" { set y1=$f(x,"(X<"),y2=$f(x,")",y1),z=$e(x,y1,y2-2) if $isvalidnum(z) { set TypeParam("MINVAL")=z set:flength<$l(z) flength=$l(z) }} ; NuMin
		if 'flength { set flength=20 }
		else { set:$g(TypeParam("SCALE")) flength=flength+TypeParam("SCALE")+1 }
	}
	if $d(TypeParam) {
		set TypeParam="",p=""
		for  { 
			set p=$o(TypeParam(p),1,d) quit:p=""
			set TypeParam=TypeParam_$lb($lb(p,d))
		}
	}
	
	s description="Expanded Pointer Field for "_refField_"->"_$p(stuff,"^",1)
	i $d(^DD(refFilen,.01,.1)) s description=description_$$$NL_^(.1)
	s x=0 f  s x=$o(^DD(refFilen,.01,21,x)) q:x'=+x  s description=description_$$$NL_$g(^DD(refFilen,.01,21,x,0))
	s refFieldName=$lg($g(^IRIS.TempFMI($j,"fid",refFilen,.01)))
		// If refFieldName is "", we most likely are performing a mapping with $$$recursion<2 and this file was not mapped, just quit and don't create this Expanded Pointer Field
	QUIT:refFieldName=""
	set refFieldDesc=$lg($g(^IRIS.TempFM($j,filen,"f",$$$UPPER(refField))),2)
	if $$$expandPointers=1 { 
			#; Change FieldName into FieldName_NAME
		s fldnm=$$ddfield2^%fm2class(refField,"_"_refFieldName,filen,.01)
	}
	if $$$expandPointers=2 { 
			#; Change FieldName_ID into FieldName
		s fldnm=$$ddfield2^%fm2class($e(refField,1,$l(refField)-$case($$$fieldNameFormat,"Pascal":2,"Camel":2,:3)),"",filen,.01)
	}
	elseif $$$expandPointers=3 {
			#; Change FieldName_fFilenID into FieldName
		if $$$fieldNameFormat="Pascal" { set tRefFieldEP=$$keycomp($e(refField,1,$l(refField)-($l($tr(refFilen,"."))+3)),128) }
		elseif $$$fieldNameFormat="Camel" { set tRefFieldEP=$$keycomp($e(refField,1,$l(refField)-($l($tr(refFilen,"."))+3)),128) }
		else { set tRefFieldEP=$$keycomp($e(refField,1,$l(refField)-($l(refFilen)+4)),128) }
			#; check for non-mapping names
		set tFilen=filen set:tFilen["OVF" tFilen=""""_tFilen_""""
		if "*"'[tRefFieldEP set tRefFieldEP=$$unique(tRefFieldEP,"^IRIS.TempFM($j,"_tFilen_",""f"")",128,,"ddfield",.01)
		set fldnm=tRefFieldEP
	}
	s schema=$$DetermineSchemaName^%occClass($$$package)		// DPV3339
	s SQLComputedCode=$lb("new id,%ROWCOUNT,%ROWID,SQLCODE,val set id={%%ID}","&sql(select "_$$quoter2(refField)_"->"_$$quoter2(refFieldName)_" into :val from "_$$quoter2(schema)_"."_$$quoter2(thisTable)_" where %ID=:id)","set {"_fldnm_"}=$select(SQLCODE=0:val,1:"""")")	// DPV3339 (schema)
	s ^IRIS.TempFM($j,filen,"f",$$$UPPER(fldnm))=$lb(fldnm,description,type,0,,,1,1,$g(SQLComputedCode),,,,,$g(TypeParam),,0,,,1,refFilen_",.01,"_fldnm,$p(stuff,"^"))
	s ^IRIS.TempFMI($j,"fid",filen,refFilen_",.01,"_fldnm)=$lb(fldnm,,2,0,,0)
	QUIT
}
 
.
fmdate(x,fmtype,flength,type,TypeParam) [] PUBLIC {
	#; general date subroutine,
	#;         Input variables are: x          Fileman code
	#;                              fmtype     Fileman DataType
	#;                              flength    Field's length
	#;        Output variables are: type       Field's datatype
	#; Deal with Date-Time formats - get rid of Secs if no Time
 
	n %DT s %DT=$p($p(x,"%DT=""",2),"""") s:fmtype["C" %DT="",x=""
	s:%DT'["T" %DT=$tr(%DT,"S","")
	s parms=""
		#; date format v.s. date-time format
		#;  It could be true that a field has a "T" code, but only a length
		#;  of 7, which can only hold a date.  If the field specifies a length
		#;  and we know the length can only hold a date value, then just make it
		#;  a Date.
	If %DT["T"||(%DT["C") {
		If flength,flength<8 { s type=$p($$$dateType,"("),parms=$p($$$dateType,"(",2,999) }		// FileMan Date
		Else { s type=$p($$$datetimeType,"("),parms=$p($$$datetimeType,"(",2,999) }			// FileMan.DateTime
	}
	Else { s type=$p($$$dateType,"("),parms=$p($$$dateType,"(",2,999) }
	if parms'="" {
		s parms=$e(parms,1,$l(parms)-1) 	// remove trailing ')'
		s ok=$$ParseDelimitedString^%occStorageUtil(parms,",",.parm)
		if ok {
			for p=1:1:parm {
				s parameter=$p(parm(p),"=",1)
				s value=$e(parm(p),$l(parameter)+2,$l(parm(p)))
				s:$e(value)="""" value=$$$StripQuotes(value)
				s TypeParam(parameter)=value
			}
		}
	}
	if type="%Library.FilemanDate"||(type="%Library.FilemanTimeStamp") {
		set TypeParam("STRICTDATA")=$$$strictData
	}
	QUIT
}
.
 
multpc(filen,fid,tabname,fldnm,mainfield,icol,MAPNAME,gref,fieldsAdded) [] PUBLIC { 	// create all of the calculated fields
	s prefix=fldnm,stuff=^DD(filen,fid,0),SQLComputed=1,Calculated=0
	s type="%Library.String" ; temporarily created as Text Data Type         
	//s TypeParam=$lb($lb("COLLATION","EXACT"))
	s fieldlength=255,TypeParam("MAXLEN")=255	// Default Length
	s x=$p(stuff,"^",5,99)
	i x["$L(X)>",+$p(x,"$L(X)>",2) s TypeParam("MAXLEN")=+$p(x,"$L(X)>",2),fieldlength=TypeParam("MAXLEN")	// MaxLen
	i x["$L(X)<",+$p(x,"$L(X)<",2) s TypeParam("MINLEN")=+$p(x,"$L(X),",2)					// MinLen
	s table="" 
	For one=1:1 {
			#; insert one desref computed field
		s table=$o(^DD(filen,fid,"V","B",table)) q:table=""		// loop over the referenced filens
		s tabnum=$o(^DD(filen,fid,"V","B",table,""))
		if tabnum=""||('$d(^DD(filen,fid,"V",tabnum,0))) {
			s ref1=$Name(^DD(filen,fid,"V","B",table,tabnum)),ref2=$Name(^DD(filen,fid,"V",tabnum,0))
			s ok=0,x="File #"_filen_", Field #"_fid_".  Invalid Pointer.  Entry exists for '"_ref1_"', but not for '"_ref2_"'"
			d log2^%fm2class(x,"W",,,filen)
			continue
		}
		set pointerFilen=$p(^DD(filen,fid,"V",tabnum,0),"^",1)
		set pointerName=$tr($p(^DD(filen,fid,"V",tabnum,0),"^",2)," ","_")
		if '$d(^DD(pointerFilen,.01,0)) set ok=0,x="Invalid File/Field (#"_pointerFilen_", Field #.01) pointed to by File #"_filen_", Variable Pointer Field #"_fid_".  Reference to File #"_pointerFilen_" omitted." d log2^%fm2class(x,"W",,,filen) continue
		set refFieldName=$p(^DD(pointerFilen,.01,0),"^",1)
		if $$reservedword(refFieldName) { set refFieldName=refFieldName_"_01" }
		if $$$expandPointers=1 {	// 1 means for each pointer field mapped we will also create a computed property that expands the pointer field and is equal to the NAME (.01) field in the referenced file
			set fldnm=prefix_"_"_pointerName	//prefix_$e("00",$l(one),2)_one
			set fldnm=$$ddfield^%fm2class(fldnm,filen) quit:"*"[fldnm
			set expandPointerName=$$ddfield^%fm2class(fldnm_"_"_refFieldName,pointerFilen,.01,1,1)
		}
		elseif $$$expandPointers=2 {	// 2 Same as 1 but the names of the fields will be different.  Reference field will be named <Field>_ID.  Expanded field will be named <Field>.  This is a computed field equal to the .01 field of the referenced table
			set fldnm=prefix_"_"_pointerName_"_ID"
			set fldnm=$$ddfield^%fm2class(fldnm,filen) quit:"*"[fldnm
			set expandPointerName=$$ddfield^%fm2class(prefix_"_"_pointerName,pointerFilen,.01,1,1)
		}
		elseif $$$expandPointers=3 {	// 3 Same as 2 but the names of the fields will be different.  Reference field will be named <Field>_f<pointed-to-file-id#>ID.  Expanded field will still be named <Field>.  This is a computed field equal to the .01 field of the referenced table
			set fldnm=prefix_"_"_pointerName_"_f"_table_"ID"
			set fldnm=$$ddfield^%fm2class(fldnm,filen) quit:"*"[fldnm
			set expandPointerName=$$ddfield^%fm2class(prefix_"_"_pointerName,pointerFilen,.01,1,1)
		}
		else { // $$$expandPointers=0
			set expandPointerName=""
			set fldnm=$$ddfield^%fm2class(fldnm,filen) quit:"*"[fldnm
		}
			#; IF THIS DESCRIPTION CHANGES THE CODE IN Reference() MUST BE UPDATED
		s desc="Variable Pointer Reference Field for Pointer field "_pointerName_$$$NL_"'"_$$getFileName^%fm2class(table)_"'" ; Caption
		i 'table s ok=0,x="Invalid Pointer For Field #"_fid_". Omitted." d log^%fm2class(x,"W")
			#; INSERT FIELD INFO INTO FIELD TABLE
		s ^IRIS.TempFM($j,filen,"f",$$$UPPER(fldnm))=$lb(fldnm,desc,type,0,fieldlength,"Exact",$g(SQLComputed,0),$g(Calculated,0),$g(SQLComputedCode),,,,,TypeParam,$i(icol),1)
		s ^IRIS.TempFMI($j,"fid",filen,fid_"-"_table)=$lb(fldnm,desc,+$g(SQLComputed)+$g(Calculated),0,icol)
		s ^IRIS.TempFMI($j,"desref",tabname,fldnm)=$lb(table,1,,%fmRecursionLevel)
		//break:filen="19620.92"	// This file gave an error when variablePointerValueField=1, I think it is a bad FM definition
		s mainfield(table)=$lb(fldnm,icol,expandPointerName),fieldsAdded=fieldsAdded+1
	}
		#; now we update the computations of all computed fields
 		#; input array is mainfield(table)=fldnm
	set MainSQLComputedCode="",MainSQLComputeOnChange="",ValueComputeCode=""
	set one=""
	for  {
		s one=$o(mainfield(one),1,fieldname) q:one=""
		s icol=$lg(fieldname,2),expandPointerName=$lg(fieldname,3),fieldname=$lg(fieldname)
		s SQLComputedCode=$lb("Quit:{"_$$quoter2(fieldname)_"}'=""""&&($Case($g(%oper),""INSERT"":1,""UPDATE"":1,:0))  If $p({"_$$quoter2(mainfield)_"},"";"",2,999)'="""_$$addquote($e($g(^DIC(one,0,"GL")),2,$l($g(^DIC(one,0,"GL")))))_""" s {"_$$quoter2(fieldname)_"}="""" Quit","s {"_$$quoter2(fieldname)_"}=$p({"_$$quoter2(mainfield)_"},"";"")")
		s RetrievalCode=$lb("If $p("_gref_","";"",2,999)'="""_$$addquote($e($g(^DIC(one,0,"GL")),2,$l($g(^DIC(one,0,"GL")))))_""" s {"_$$quoter2(fieldname)_"}="""" Quit","s {"_$$quoter2(fieldname)_"}=$p("_gref_","";"")")
			#; The fields used here are the value fields, not the ID values
		if $$$variablePointerValueField {
			set ValueComputeCode=ValueComputeCode_$lb("if {"_$$quoter2(expandPointerName)_"}'="""" { set {*}={"_$$quoter2(expandPointerName)_"} quit }") 
		}	
		s ^IRIS.TempFM($j,filen,"m",MAPNAME,"d",$i(^IRIS.TempFM($j,filen,"m",MAPNAME,"d")))=$lb(fieldname,,,,RetrievalCode)
		s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fieldname)),7)=1	// SQL Computed
		s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fieldname)),8)=0	// NOT Computed Always (Calculated)
		s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(fieldname)),9)=SQLComputedCode
		s ^IRIS.TempFMI($j,"fid",filen,fid_"-"_one)=$lb(fldnm,desc,2,0)
		s MainSQLComputeOnChange=MainSQLComputeOnChange_$lb(fieldname)
		s xx=$$addquote($e($g(^DIC(one,0,"GL")),2,$l($g(^DIC(one,0,"GL")))))
		#;s MainSQLComputedCode=MainSQLComputedCode_$lb("i {"_fieldname_"}'="""",$p({"_mainfield_"},"";"",2,999)'="""_xx_""" s {"_mainfield_"}={"_fieldname_"}_"";"_xx_""" q")
			#;  Note, {Field*C} does not work in computed code so I have to revert to checking $a(%e,icol) to see if the field has changed.
			#;  Since this variable pointer field itself is not computed always it should be OK.
		s MainSQLComputedCode=MainSQLComputedCode_$lb("i ($g(%oper)=""INSERT""&&({"_$$quoter2(fieldname)_"}'=""""))||($a($g(%e),"_icol_")=1) s {"_$$quoter2(mainfield)_"}={"_$$quoter2(fieldname)_"}_"";"_xx_""" q")	// DPV3009
	}
	if $$$variablePointerValueField,$g(ValueComputeCode)'="" {
			#; define a single field that will have the value of the variable pointer so we can always get it from this field.
		set fldnm=$$ddfield2^%fm2class(mainfield,"_VALUE",filen,.01) q:"*"[fldnm
		set desc="Variable Pointer Value Field for Pointer field "_mainfield
			#; Add a final set {*}="" if all the conditions in the ValueComputeCode are false
		set ValueComputeCode=ValueComputeCode_$lb("set {*}=""""")
			#; INSERT FIELD INFO INTO FIELD TABLE
		set ^IRIS.TempFM($j,filen,"f",$$$UPPER(fldnm))=$lb(fldnm,desc,type,0,fieldlength,"Exact",1,1,$g(ValueComputeCode),,,,,TypeParam,$i(icol),0)
		set ^IRIS.TempFMI($j,"fid",filen,fid_"-"_table)=$lb(fldnm,desc,2,0,icol)
	}
	s MainSQLComputedCode=MainSQLComputedCode_$lb("set {"_$$quoter2(mainfield)_"}="""" ")
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(mainfield)),7)=1		// SQL Computed
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(mainfield)),8)=0		// Not Computed Always (Not Calculated)
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(mainfield)),9)=MainSQLComputedCode
	s $li(^IRIS.TempFM($j,filen,"f",$$$UPPER(mainfield)),10)=MainSQLComputeOnChange
	QUIT
}
 
 
validact(syntax,action) [] PUBLIC {
		#; return the action that is valid for mapping
		#; error out if it's not possible to map (e.g. parent not mapped)
		#; --- NOTE: this entry point assumes that syntax is CORRECT ---
	s exit="",max=$l(syntax,"->")
	s:$g(action)="" action="iu"
	s x=$p(syntax,"->",max),y=$p(x,"^",2),x=$p(x,"^")
	QUIT:x="" "error"
	i y'="",'$d(^IRIS.TempFMI($j,"fid",x,+y)) d  QUIT exit
	. i $d(^IRIS.TempFM($j,x)),action["i" s exit="i" q
	. s exit="error" q
	i y'="" d  QUIT exit
	. i action'["u",action'["d" s exit="error" q
	. i action'="d" s exit="u" q
	. s exit="d" q
	i '$d(^IRIS.TempFM($j,x)) d  QUIT exit
	. i action'["i" s exit="error" q
	. s x=$p(syntax,"->",max-1),y=$p(x,"^",2),x=$p(x,"^",1)
	. s exit=$s(x="":"i",'$d(^IRIS.TempFM($j,x)):"error",1:"i") q
	i action'["u",action'["d" s exit="error"
	i action'="d" s exit="u"
	e  s exit="d"
	QUIT exit
}
 
 
keycomp(key,len) [] PUBLIC {
		#; compress FileMan names to IRIS format
		#; don't map fields/files starting with ...
	s tmp=$tr(key," .","__"),key=""
	f  q:$e(tmp)?1AN  q:tmp=""  s tmp=$e(tmp,2,$l(tmp))
	s:tmp?1n.e tmp="f"_tmp
	f j=1:1:$l(tmp) i $e(tmp,j)'?1pc||($e(tmp,j)="_") s key=key_$e(tmp,j)
	s tmp=$$trans(key,"__","_")
	f j=1:1:$l(tmp)+1 q:$e(tmp,j)?1a
	s tmp=$e(tmp,j,$l(tmp))
		#; this is in the old case where vowels are stripped, etc...
	i $l(tmp)>len f j=$l(tmp):-1:2 i "AaEeIiOoUu"[$e(tmp,j) s tmp=$e(tmp,1,j-1)_$e(tmp,j+1,$l(tmp)) q:$l(tmp)'>len
	set tmp=$e(tmp,1,len)
	QUIT tmp
}
 
 
trans(st,from,to) [x] PUBLIC {
		#; translate words from 'from' to 'to' in 'st'ring
	QUIT:$$$UPPER(st)'[$$$UPPER(from) st
	new x x "s x=("" "_$$$UPPER(st)_" ""'?.e1p1"""_$$$UPPER(from)_"""1p.e)"
	QUIT:x st s y=1
trnsloop s x=$f($$$UPPER(st),$$$UPPER(from),y) QUIT:x=0 st s y=x-1-$l(from)
	if $s(y=0:1,$e(st,y)?1p:1,1:0),$s(x=($l(st)+1):1,$e(st,x)?1p:1,1:0) { s st=$e(st,1,y)_to_$e(st,x,$l(st)),y=y+$l(to)+1 }
	else { s y=x }
	g trnsloop
}
 
 
codeopt(string) [] PUBLIC {
		#; OPTIMIZE FILE MANAGER EXECUTABLE CODE
		#; (INTERFACE COMPILE-TIME SUB-ROUTINE)
		#; This subroutine determines whether to treat executable code
		#; as a program line or as an executable string.  Any code with
		#; QUITS must be converted to Xecute syntax with all quotes
		#; converted to double quotes.
		#;
	s us=$$$ALPHAUP(string)
	i '((us[" Q")||(us["Q:")||(us[" QUIT")||(us["QUIT:")||(us="Q")) QUIT string
		#; string probably contains a quit.  Find where we think it is
	s qpos=$f(us," Q") i qpos="" s qpos=$f(us,"Q:") i qpos="" s qpos=$f(us," QUIT") i qpos="" s qpos=$f(us,"QUIT:") i qpos="" s qpos=1
		#; find where we think there might be a for loop
	s fpos=$f(us," F ") i fpos="" s fpos=$f(us," FOR ") i fpos="" s fpos=$l(string)
		#; If the quit is in the for loop, no need to execute code.
	i fpos<qpos QUIT string
	s newcode="x """_$$addquote(string)_""""
	QUIT newcode
}
.
.
addquote(text) [] {
		#; Double The Quotes In A String
	 s newtext="" f i=1:1:$l(text) { s newtext=newtext_$e(text,i) i $e(text,i)="""" s newtext=newtext_"""" } QUIT newtext
}
 
 
lexan(gloref,subs,level) [] PUBLIC {
		#; Derive Subscript Levels From ^DIC(filen,0,"GL")
		#; INPUT - subs = string of subscript expressions
		#; OUTPUT - level array - list of subscripts
	k level s level=0
ploop	QUIT:subs=""  s subi="",(qp,lpp,rpp)=0,end=0
ploop1	QUIT:end  s x=$e(subs) i x="" s end=1 g addlev
	if ","")("'[x d concat g ploop1
	if x="""" s qp=qp+1 d  d concat g ploop1
	. i qp#2 f i=2:1:$f(subs,"""",2)-2 d
	.. i $e(subs,i)="(" s lpp=lpp-1
	.. i $e(subs,i)=")" s rpp=rpp-1
	if x="(" s lpp=lpp+1 d concat g ploop1
	if x=")" s rpp=rpp+1 d concat g ploop1
	if x="," i (qp#2)!(lpp'=rpp) d concat g ploop1
addlev	s level($i(level))=subi
	s subs=$e(subs,2,$l(subs))
	g ploop
concat	s subi=subi_x,subs=$e(subs,2,$l(subs)) QUIT
}
 
 
lexanC(M,glo,level) [] PUBLIC {
		#; Derive Subscript Levels From M Executable Code
		#; returns glo (PBR)
	k level s level=0
	s glo=$p($p(M,"S ^",2),"(",1) ; global name
	s subs=$p($p(M,"(",2,999),")=",1)
ploop	QUIT:subs=""  s subi="",qp=0,lpp=0,rpp=0,end=0
ploop1	QUIT:end  s x=$e(subs) i x="" s end=1 g addlev
	i ","")("'[x d concat g ploop1
	if x="""" {
		s qp=qp+1
		i qp#2 f i=2:1:$f(subs,"""",2)-2 s:$e(subs,i)="(" lpp=lpp-1 s:$e(subs,i)=")" rpp=rpp-1
		d concat g ploop1
	}
	i x="(" s lpp=lpp+1 d concat g ploop1
	i x=")" s rpp=rpp+1 d concat g ploop1
	i x="," i (qp#2)||(lpp'=rpp) d concat g ploop1
addlev	s level($i(level))=subi,subs=$e(subs,2,$l(subs)) g ploop
.
concat	s subi=subi_x,subs=$e(subs,2,$l(subs)) q
}
 
 
extchk(x,len,extractLen) [] PUBLIC {
		#; Convert every "$E(X,1,N)" where N > maxlen to "X"
	s inst=1,delim="$E(X,1"
	f  s p1=$p(x,delim,1,inst) q:p1=x  s p2=$p(x,delim,inst+1,*) d
	. i '($l(p1,"""")#2) s inst=inst+1 q  ; in quotes
	. i "),"'[$e(p2) s inst=inst+1 q  ; bad M
	. i $e(p2)=")" d  q
	. . i len>1 s inst=inst+1 ; bad length
	. . e  s x=p1_"X"_$p(p2,")",2,*)
	. i $e(p2)'="," s inst=inst+1 q  ; bad M
	. set extractLen=+$e(p2,2,$l(p2))
	. i extractLen<len s inst=inst+1 q  ; bad length ; PRT013 correct length
	. i $e(p2,$l(+$e(p2,2,$l(p2)))+2)'=")" s inst=inst+1 q  ; bad M ; PRT012 06/03/94 fix bug
	. s x=p1_"X"_$p(p2,")",2,*)
	QUIT x
}
.
 
extchk2(x,filen,fields,delim,err,extractLen) [] PUBLIC {
		#; Convert every "$E(X(n),1,N)" where N > maxlen to "X"
	s inst=1
	f  s p1=$p(x,delim,1,inst) q:p1=x  s p2=$p(x,delim,inst+1,*),fieldOrder=+p2,startExtract=$p(p2,",",2),p2=","_$p(p2,",",3,*) d  q:err
	. i startExtract'=1 s inst=inst+1 q   // Not $e(...,1,...)
	. i '($l(p1,"""")#2) s inst=inst+1 q  ; in quotes
	. i "),"'[$e(p2) s inst=inst+1 q  ; bad M
	. s fid=$g(fields(fieldOrder)) i fid="" s inst=inst+1 q
	. s fldnm=$lg($g(^IRIS.TempFMI($j,"fid",filen,fid)),1)
	. i fldnm="" s err=8 QUIT
	. s len=$lg($g(^IRIS.TempFM($j,filen,"f",$$$UPPER(fldnm))),5)
	. i $e(p2)=")" d  q
	. . i len>1 s inst=inst+1 ; bad length
	. . e  s x=p1_"{"_fldnm_"}"_$p(p2,")",2,*)
	. i $e(p2)'="," s inst=inst+1 q  ; bad M
	. set extractLen=+$e(p2,2,$l(p2))
	. i extractLen<len s inst=inst+1 q  ; bad length ; PRT013 correct length
	. i $e(p2,$l(+$e(p2,2,$l(p2)))+2)'=")" s inst=inst+1 q  ; bad M ; PRT012 06/03/94 fix bug
	. s x=p1_"{"_fldnm_"}"_$p(p2,")",2,*)
	QUIT x
}
.
.
unique(val,glo,len,ignore,caller,fid,filen="") [glo] PUBLIC {
		#; find a unique name for the value in val
		#; if value equal 'ignore' then ignore uniqueness. (Updates)
	s ignore=$g(ignore),up=$$$UPPER(val),upignore=$$$UPPER(ignore),x=up 
	QUIT:up=upignore ignore
	QUIT:'$d(@glo@(up))&&('$$reservedword(up)) val
	if filen'="" s val=val_"_"_$tr(filen,".","_") i '$d(@glo@($$$UPPER(val))),'$$reservedword(val) QUIT val
	if $g(caller)="ddfield",$$reservedword(up) {
		s val=val_$tr(fid,".","_") 
		s:$l(val)>len val=$e(val,1,40) 
		s up=$$$ALPHAUP(val) 
		QUIT:'$d(@glo@(up))&&('$$reservedword(up)) val
	}
	if $l(val)<len f i=48:1:57,65:1:91 s x=up_$c(i) q:x=upignore  q:'$d(@glo@(x))&&('$$reservedword(x))
	QUIT:x=upignore ignore
	if $t&&(i<91) { QUIT val_$c(i) }
uniqloop s up=$e(up,1,$l(up)-1) i up="" q ""
	for i=48:1:57,65:1:91 { s x=up_$c(i) q:x=upignore  q:'$d(@glo@(x))&&('$$reservedword(x))  }
	QUIT:x=upignore ignore
	if i<91 { quit x }
	goto uniqloop
}
 
	// Given a string, return 1 if it is a reserved word used by the parser
reservedword(str) [] PRIVATE {
	RETURN ($p($g(^%qSQL("reservewords",$$$UPPER(str))),$c(1),2)="Y")
}
.
fixglref(filen,gloref) [] PUBLIC {
		#;  We have a global reference which might reference fields from other 
		#;  (parent) tables.  Since Computed field code is not allowed to 
		#;  reference fields from other tables, we have to turn these into 
		#;  $Piece({RowID},"",xxx) reference.
		#;
	s data=$g(^IRIS.TempFM($j,filen))
	QUIT:$lg(data,5)'="Y" gloref 	// RowID not based on other fields
	s physical=$lg(data,7)
	//QUIT:physical=$lg(data,8) gloref ; Physical and Logical RowID field list is the same
	For i=1:1:$ll(physical) {
		set field=$lg(physical,i)
		if $p(field,".")=$lg(data,1) {	// field from this table, replace {TABLE.FIELD} with {FIELD}
			set gloref=$$strrep(gloref,"{"_field_"}","{"_$p(field,".",2)_"}",1) // Need to adjust if TABLE or FIELD names are allowed to contain "."
			continue
		}
		set:physical'=$lg(data,8) gloref=$$strrep(gloref,"{"_field_"}","$p({RowId},""||"""_$s(i=1:"",1:","_i)_")",1) 
	}
	QUIT gloref
}
 
 
datype(fmtype) [] PUBLIC {
		#; Return IRIS numeric Data Type number Given FileMan DataType String
	s datype=""
	i fmtype?.1"."1.n.e s datype=100 			// fake datatype for child tables
	e  i fmtype="" 	// missing data type - not supported
	e  i fmtype["C",(fmtype[",")||(fmtype["D") s datype=5	// Computed Field --> Numeric
	e  i fmtype["C" s datype=8				// Computed Field --> Text
	e  i fmtype["V" s datype="8->"				// Variable pointer --> Text + comp flds
	e  i fmtype["D" s datype=5				// Date/Time --> Number
	e  i fmtype["F" s datype=8				// Free Text --> Text
	e  i fmtype["N" s datype=5				// Numeric --> Number
	e  i fmtype["P" s datype=10				// Pointer --> Designative Reference
	e  i fmtype["S" s datype=6				// Set --> Multiple Choice
	e  i fmtype["W" s datype=8				// Word-Processing --> Text
	e  s datype=8						// No DataType --> Text
		#; Any Other FileMan Data Types Not Supported
	QUIT datype
}
 
 
find(filen,gloref,nodename) [] PUBLIC {
		#; Find Out If There Is Computed Field For gloref
	s fld="",nodename=""
	For  {
		s fld=$o(^IRIS.TempFM($j,filen,"f",fld),1,data) q:fld=""
		continue:$lg(data,9)=""	// No computed code
		s compcode=$li(data,9)
		f i=1:1:$ll(compcode) i $lg(compcode,i)[("}=$g("_gloref) s nodename=$lg(data) q
	}
	QUIT
}
 
 
GlobalRef(filen,mapname) [] PUBLIC {
	s glo=$lg(^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname)),2)_"("
	s ilev=0 f  s ilev=$o(^IRIS.TempFM($j,filen,"m",$$$UPPER(mapname),"s",ilev),1,data) q:'ilev  s level($i(level))=$lg(data,2)
	s level="" f  { s level=$o(level(level)) q:level=""  s glo=glo_$s($e(glo,$l(glo))="(":"",1:",")_level(level) } s glo=glo_")"
	QUIT glo
}
 
 
MapSubsChild(pfilen,cfilen,tabname,mapname,&gloref,parprof,&level,&err) [] PUBLIC {
	#; Create Map Subscripts
 
		#; First copy parent map subs to child map subs
		#;	Find master map of parent
		#; Build gloref for use in Delete Trigger of Child Table (to set into DIC)
		
	set pmap="",savegloref=gloref
	for  { set pmap=$o(^IRIS.TempFM($j,pfilen,"m",pmap),1,data) quit:pmap=""  quit:$lg(data,3)="Y" }
	if pmap="" { set err=17 RETURN }  // *** No master map in parent table???
	set MAPNAME=$$$UPPER(mapname)
	set i="",gloref=$p(gloref,"(")_"(",DAargs=""
	for  {
		set i=$o(^IRIS.TempFM($j,pfilen,"m",pmap,"s",i),1,data) quit:i=""  
		set ^IRIS.TempFM($j,cfilen,"m",MAPNAME,"s",i)=data
			#;  gloref has constant or $c(1) for DA() position holder
		set gloref=gloref_$s($lg(data)="":$lg(data,2),1:$c(1))_","
		if $lg(data)'="" { set DAargs="{L"_i_"}"_$e(",",DAargs'="")_DAargs }	// Args to pass to $$SCR^%fm2class4 to define DA() for parent IEN(s)
	}
	set level=$o(^IRIS.TempFM($j,cfilen,"m",MAPNAME,"s",""),-1)
		#;  Now insert literal child subscript(s)
	set subi=$p($p(parprof,"^",4),";",1)
	if +subi'=subi { set subi=""""_subi_"""" }
	set ^IRIS.TempFM($j,cfilen,"m",MAPNAME,"s",$i(level))=$lb(,subi)
	set gloref=gloref_subi_","
		#;  Now insert variable child subscript(s)
	set level=level+1
	set DAargs="{L"_level_"}"_$e(",",DAargs'="")_DAargs
	set invcond=$lb("{L"_level_"}'>0")
	if $$$wholeFileScreen { set fileScreenCode=$g(^DD(cfilen,0,"SCR")) } else { set fileScreenCode="" }
	if fileScreenCode'="" {
		if fileScreenCode["X" {	// might need 01 field (NAME) value
			set namefielddata=$g(^DD(cfilen,.01,0))
			if namefielddata'="" {
				set node=$p($p(namefielddata,"^",4),";",1)
				set piece=$p($p(namefielddata,"^",4),";",2)
				set namefieldref="$p("_gloref_"DA,"_node_"),""^"","_piece_")"
				if namefieldref[$c(1) {	// Fill in DA() references
					for i=$l(namefieldref,$c(1))-1:-1:1 {
						set namefieldref=$p(namefieldref,$c(1),1)_"DA("_i_")"_$p(namefieldref,$c(1),2,*)
					}
				}
			}
		} else { set namefieldref="" }
			// Additional isvalid condition
		set invcond=invcond_$lb("'$$SCR^%fm2class4({L"_level_"},"_$$quoter(namefieldref)_","_$$quoter(fileScreenCode)_$e(",",DAargs'="")_DAargs_")")
			// NEXT logic
		set nextsub=$lb("set:{L"_level_"}="""" {L"_level_"}=0 set {L"_level_"}=$o(^({L"_level_"})) if '{L"_level_"} set {L"_level_"}="""" quit")
		set nextsub=nextsub_$lb("goto:'$$SCR^%fm2class4({L"_level_"},"_$$quoter(namefieldref)_","_$$quoter(fileScreenCode)_$e(",",DAargs'="")_DAargs_") NEXT")
			// PREV logic
		set nextsub=nextsub_$lb(";PREV","set:{L"_level_"}="""" {L"_level_"}=$c(0) set {L"_level_"}=$o(^({L"_level_"}),-1) if '{L"_level_"} set {L"_level_"}="""" quit")
		set nextsub=nextsub_$lb("goto:'$$SCR^%fm2class4({L"_level_"},"_$$quoter(namefieldref)_","_$$quoter(fileScreenCode)_$e(",",DAargs'="")_DAargs_") PREV")
	} else {	// no file screen
		set nextsub=$lb("set:{L"_level_"}="""" {L"_level_"}=0 set {L"_level_"}=$o(^({L"_level_"})) set:'{L"_level_"} {L"_level_"}=""""")
		set nextsub=nextsub_$lb(";PREV","set:{L"_level_"}="""" {L"_level_"}=$c(0) set {L"_level_"}=$o(^({L"_level_"}),-1) set:'{L"_level_"} {L"_level_"}=""""")
	}
	set tIENName=$lg(^IRIS.TempFM($j,cfilen),12)
	set ^IRIS.TempFM($j,cfilen,"m",MAPNAME,"s",level)=$lb(tabname_"."_tIENName,"{"_tabname_"."_tIENName_"}",invcond,nextsub)
	RETURN
}
 
SoCTable(tabname,filen,fldfid,fldname,clevel,soctabname) [] PUBLIC {
		#; Create Table for  Set Of Codes
		#; Called as extrinsic function
		#; Input Parameters - tabname = name of table with a Set Of Codes field
		#;                    filen = File # Of FileMan File
		#;                    fldfid = fid of Set Of Codes field
		#;		      fldname = Name of the Set Of Codes field
		#;                    clevel = Child Level
		#;                    soctabname = optional var to pass back new table name
		#;                    savetabname = tabname, but not with OVF if an overflow table
		#; Returns          - 0 = success, >0 = error code
		#;                    soctabname = name of new table (passed by ref)
		#;
		#; Global variables used in pgm:
		#; filen = FileMan File# For Sub-Field/Multi-Line Field2
		#; tabirn = row id of base table
		#; btabnm = base table name
		#; rowifn = ifn of row id field
		#; childifn = ifn of childsub field
		#; mapid  = row id of master map
		#; parprof = sub-field profile from parent table
		#; topfil = file # of top level file
		#; wp      = 1/0 if this is a word processing field child table
 
	do log2^%fm2class("Analyzing Set Of Codes field "_fldfid_" ("_fldname_")","M",clevel*3,1)
	set soctabname=tabname_"_SOC_"_fldname
	set desc="Generated class for FileMan Set Of Codes Field in File: '"_filen_"'(Name: '"_$$getFileName^%fm2class(filen)_"'), Field: '"_fldfid_"' (Name: '"_fldname_"')   Class generated by %fm2class version "_$$GetVersion^%fm2class()
	set filenSoc=filen_"SoC"_fldfid
	set ^IRIS.TempFM($j,filenSoc)=$lb(soctabname,desc,$$$owner,1,"Y","RowId",$lb(soctabname_".CODE"),$lb(soctabname_".CODE"),"RowId",1)
	set ^IRIS.TempFMI($j,"rv",$$$UPPER(soctabname))=filenSoc
	set ^IRIS.TempFMI($j,"fm",filenSoc)=$lb(soctabname,desc)
	
		#; Create Master Map
	set gloref="^DD"
	set mapname="DataMap",MAPNAME="DATAMAP"
	set ^IRIS.TempFM($j,filenSoc,"m",MAPNAME)=$lb(mapname,gloref,"Y")
.
		#; Map Subscripts
	set ^IRIS.TempFM($j,filenSoc,"m",MAPNAME,"s",1)=$lb(,+filen,"","")
	set ^IRIS.TempFM($j,filenSoc,"m",MAPNAME,"s",2)=$lb(,fldfid,"","")
	set ^IRIS.TempFM($j,filenSoc,"m",MAPNAME,"s",3)=$lb(,0,"","")
	set ^IRIS.TempFM($j,filenSoc,"m",MAPNAME,"s",4)=$lb(,3,"","","Piece","""^""")
	set ^IRIS.TempFM($j,filenSoc,"m",MAPNAME,"s",5)=$lb("RowID","{RowID}","","","Piece",""";""")
.
		#; Map Data
	set ^IRIS.TempFM($j,filenSoc,"m",MAPNAME,"d",$i(^IRIS.TempFM($j,filenSoc,"m",MAPNAME,"d")))=$lb("CODE",,"1",""":""",)
	set ^IRIS.TempFM($j,filenSoc,"m",MAPNAME,"d",$i(^IRIS.TempFM($j,filenSoc,"m",MAPNAME,"d")))=$lb("MEANING",,"2",""":""",)
.
		#; CODE Field
	set desc="Internal Code for this Set Of Codes"
	set ^IRIS.TempFM($j,filenSoc,"f","CODE")=$lb("CODE",desc,"%Library.String",1,fieldlength,"EXACT",0,0,,,,,,$g(TypeParam),4,0,,,1,fldfid_"CODE","CODE",)
	set ^IRIS.TempFMI($j,"fid",filenSoc,fldfid)=$lb("CODE",desc,0,0,4,1)
		#; MEANING Field
	set desc="Code Meaning for this Set Of Codes"
	set ^IRIS.TempFM($j,filenSoc,"f","MEANING")=$lb("MEANING",desc,"%Library.String",1,fieldlength,"EXACT",0,0,,,,,,$g(TypeParam),5,0,,,1,fldfid_"MEANING","MEANING")
	set ^IRIS.TempFMI($j,"fid",filenSoc,fldfid)=$lb("MEANING",desc,0,0,5,1)
	
		#; UNIQUE index for CODE
	set ^IRIS.TempFM($j,filenSoc,"i","CODEUnique")=$lb("CODEUnique","UNIQUE",$lb("CODE"))
	#;	#; FKey from main table to SOC table for this code
	#;set ^IRIS.TempFM($j,filen,"fk","FKey_"_fldname)=$lb(soctabname,fldname,"Foreign Key constraint for Set Of Codes field "_fldname,"CODEUnique",1)
.
	set %fmQueueCount=%fmQueueCount+1
	QUIT 1 ; success
}
.
 
quoter(x,QuoteNumbers) PUBLIC { Quit $select(('$get(QuoteNumbers))||(x'=+x):$select(x=$char(0):"$c(0)",1:$zu(144,1,x)),1:""""_x_"""") }
.
quoter2(x,extraquote) PUBLIC { Quit $select(($zname($e(x))||($e(x)="_"))&&($zname($tr("%"_$e(x,2,$l(x)),"_@#$")))&&('($p($g(^%qSQL("reservewords",$zcvt(x,"U"))),$c(1),2)="Y")):x,x=$c(0):"$c(0)",x=+x:""""_x_"""",$g(extraquote):$$quoter3($zu(144,1,x)),1:$zu(144,1,x)) }
.
quoter3(x) PRIVATE { Quit """"_$zu(144,1,$extract(x,2,$l(x)-1))_"""" }
.
