====
qaqoco
====
^MAC^Save for Source Control^^~Format=IRIS.S~^UTF8
%RO
%qaqoco^MAC^^^0
%qaqoco	// QO - Create cost array (PTR 7/7/87)
	;; COMPONENTS :: SQL/Optimizer
	#;
#INCLUDE %msql
#INCLUDE %qao
#IF 0  	;-------------------------------------------------------------
	; Description:   QO - Create Cost Array
	; Author:        Terry Ragon
	; Date:          July 7, 1987
	;
	;  AK850   (11/30/2020) - Implement lateral join
	;  PVA348  (03/01/2016) - PVA348 - Support Lateral references in JSON_TABLE through optimizer 
	;  PVA316  (02/04/2015) - Make cost based decision for or->union optimization for multi-table OR condition case 
	;  PVA279  (02/12/2014) - Enhance ptres handling for longstanding defects 
	;  PVA277  (06/28/2013) - Fix a certain join query becoming slower in 2013.1
	;  PVA255  (03/20/2012) - Fix problem where optimizer may specify a temp file build for no good reason.
	;  PVA229  (09/16/2010) - Fix JLF338 optimizer part to work as intended. 
	;  PVA220  (03/12/2010) - Fix poor join order choices in some queries with DISTINCT 
	;  PVA208  (11/10/2009) - Implement keyword to specify table to start joins from: %STARTTABLE 
	;  PVA206  (11/03/2009) - Fix optimizer to properly consider interim sorts. 
	;  PVA185  (06/16/2009) - Optimization for TOP without ORDER BY 
	;  PVA184  (06/14/2009) - Optimizer support for TOP... ORDER BY in subqueries. 
	;  PVA157  (05/01/2008) - Support faster DISTINCT while preserving case (i.e. with FASTDISTINCT OFF )
	;  DPV3124 (03/12/2008) - performance improvements, merge with %qaqoco2, no functionality changes
	;  PVA141  (06/14/2007) - <SUBSCRIPT>subconds+10^%qaqoco *ptres("")
	;  DPV2849 (01/25/2007) - More 999 -> $$$MaxStringLength changes
	;  DPV2697 (07/12/2006) - Use $e(...,*) and $e(...,...,*) in SQL code
	;  PVA073  (07/13/2005) - Avoid unnecessary data map access for "TOP n id .... ORDER BY id" queries; also for idkey columns. Also, additional TOP bugs.
	;  PVA072  (11/10/2004) - Support pseudo conditions implied by TOP... ORDER BY in optimizer
	;  PVA34   (03/15/2002) - Use more than one index per table for restriction.
	;  PVA023  (10/24/2001) - Optimizer fails to prevent testing of some unnecessary conditions. 
	;  PVA028  (08/28/2001) - Remove ptjorder/ptjouter structures from optimizer
	;  PVA027  (08/01/2001) - Support a few optimizer directives on the FROM clause  
	;  PVA026  (07/02/2001) - SHD: Speed up and reduce cachetemp use by the query optimizer
	;  PVA019  (10/18/2000) - CSM: Fix some cases of bad choice of join plan.
	;  AK445   (06/07/2000) - Fix ptres replication analysis
	;  DPV702  (01/02/1997) - Improve effieciency of code
	;                       Move setdata^%qaoc3 to setdata^%qaqoco2
	;                       Move ^%qaoc1 to procjoin
	;                       Move ^%qaoc2 to finproc
	;                       Move ^%qaoc11 to ^%qaqoco2
	;                       Made %qaoinor a local call via a #INCLUDE
	;                       Made is^%qaois a local call via a #INCLUDE
	;-------------------------------------------------------------
	;                       I N F O R M A T I O N
	;-------------------------------------------------------------
	;
	;  Start your information here...
	;
#ENDIF 	;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	; PVA072: compute new variable totstrm up front. 
	n algnum,totstrm
	s a=""  f i=1:1 s a=$o(ptj(qoqn,qojsn,a)) q:a="" 	; calc # of streams
	s totstrm=i-1
	d is0		; process initial streams
	d procjoin	; process joins
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
is0	; Process initial streams
	#; $$$Mcost(qoqn,qojsn,qonumstr,","_qosn_",",order)="" was setup in 
	#;    qosinit
	#;      i.e., the interesting orders have already been defined for
	#;      initial streams
	#; $$$Ptinits() was also already setup which defines algorithms to be
	#;      applied to initial streams
	#; loop through $$$Ptinits() to process each initial stream
	#; s costprev = "", the $$$Mcost() entry for the prev set of streams.
	s qosn="",qonumstr=1,costprev=""
    #; PVA348: remove everything that was done here for join order hints. It is now all enforced
    #;   when and initial stream is considered for some join. 
	f i=1:1 s qosn=$o($$$Ptinits(qoqn,qojsn,qosn)) q:qosn=""  d is1 
	d finproc	; finish processing this stream set
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
is1	; loop through each algorithm of this initial stream
	#; PVA023: set resmaybe,resknown,resprev; kill resalready
	#; PVA348: remove use of strmfound to detect error(34) here. That logic had to be moved later
	#;    to allow cartesion products with order dependencies. 
	s qoslist=","_qosn_",",algnum="",resmaybe="",resknown=-1,resprev="",noresmay=","
	k resalready	; for each new stream
	f i=1:1 s algnum=$o($$$Ptinits(qoqn,qojsn,qosn,algnum)) q:algnum=""  d is2($$$Malg(algnum))
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
is2(qoalg)	; process this algorithm for this initial stream
	#; input parameter:
	#;     alg:  $$$Malg() value for this algorithm
	#; process cost formula for buffer pool size = .8*PBP
	#; create cost array form() based on alg
	#; PVA072: new variable uset 
	#; PVA34: new variable costpreflt
	n costpreflt,uset
	#; PVA348: remove setting of strmfound
	s a=$p(qoalg,"^",17) f i=1:1:$$$SUBMAX s form(i)=+$p(a,",",i)
		#; PVA023: call new setresalready tag	; pre-optimizer always did replication over
		#;    equalities within a stream, but optimizer never took account of this.
	s:resknown=-1 resknown=$p(qoalg,"^",7)	; same for all init stream algs on a given stream, so only do once
	d setresalready	; sets nores as well as resalready
		#; PVA023: as with 'join' tag, factor out selectivity of replicated restrictions.
		#; subtract out impact of replicated restrictions that have already
		#; been processed
		#; PVA072: compute uset - whether to use deferred TOP entry, vs. regular one, in formsub
	if $p(qoalg,"^",13)]""{
		if $e($p(qoalg,"^",13))="S"&&(totstrm=1) {s uset=0}
		else {s uset=1}
	}
	else {s uset=0}
	s a="" f i=1:1 s a=$o($$$Malg(algnum,a)) q:a=""  d formsub:(nores[(","_a_",") || (adjsel[(","_a_","))) // PVA279: adjsel
	s cost8=$$is^%qaois($p(qoalg,"^",14),+$p(qoalg,"^",3),PBP8)	; process cost formula
		#; PVA34: get cost of pre filter alg, if any, and add to cost8
	s costpreflt=$p(qoalg,"^",26)
	s costtemp=$p(qoalg,"^",16) s:costtemp $p(cost8,"^")=$$addcost($p(cost8,"^"),costtemp)	; add any preprocessing cost
	s:costpreflt $p(cost8,"^")=$$addcost($p(cost8,"^"),costpreflt)
		#; PVA023: set nores, resalready as well in 'x'
		#; PVA279: set adjsel
	s x="^"_qosn_"^^"_algnum_"^"_nores_"^"_resalready_"^"_resknown_"^^"_adjsel_"^"
		#; if this is the first algorithm for this stream, fill in extra data
		#; and create outseq, outsort, and readcost
	s y=$g($$$Mcost(qoqn,qojsn,qonumstr,qoslist))
	i y]"" s outseq=$p(y,"^",4),outsort=$p(y,"^",5),readcost=$p(y,"^",6),resslist=$p(y,"^",7)
	e  s resslist=$p(qoalg,"^",7) d setdata(+$p(cost8,"^",2))
		#; if we have an algorithm that produces a sort file, the cost to
		#; later read and then delete the sort file has already been included
	s y=$p(qoalg,"^",14)="IS13"
	s:'y cost3=$$is^%qaois($p(qoalg,"^",14),+$p(qoalg,"^",3),PBP3)	; process cost formula for .3*PBP
	s:'y&&(costtemp) $p(cost3,"^")=$$addcost($p(cost3,"^"),costtemp)
		#; PVA34: add pre-filter cost to cost3, if needed
	s:'y&&(costpreflt) $p(cost3,"^")=$$addcost($p(cost3,"^"),costpreflt)
		#; if we don't automatically produce a sort file, the only way we
		#; will use cost8 is when we produce a sequential file
	s:'y $p(cost8,"^")=$$addcost(outseq,cost8)
		#; is a natural order produced?  if so, store a cost entry for it
		#;     under that order with outtype = 2 if a sort file is
		#;     automatically created and otherwise under outtype = 0 and 1
	s a=$p(qoalg,"^",20)
	GOTO is3:a=""
		#; PVA072: Prevent interim temp files if a TOP limit is active
		#; PVA157: or if DISTINCT on query block
		#; PVA185: check timefirst instead of toplimit
	i y s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,a,2,$$nexti(a,2))=$p(cost8,"^")_x_cost8
	e  s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,a,0,$$nexti(a,0))=$p(cost3,"^")_x_cost3 s:'timefirst(qoqn)&&'$d($$$mtGroupDistinctList(qoqn)) $$$Mcost(qoqn,qojsn,qonumstr,qoslist,a,1,$$nexti(a,1))=$p(cost8,"^")_x_cost8
		#; store it under order=0 and outtype = 0 and 1  or under 2
is3	i y s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,0,2,$$nexti(0,2))=$p(cost8,"^")_x_cost8
	e  s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,0,0,$$nexti(0,0))=$p(cost3,"^")_x_cost3 s:'timefirst(qoqn)&&'$d($$$mtGroupDistinctList(qoqn)) $$$Mcost(qoqn,qojsn,qonumstr,qoslist,0,1,$$nexti(0,1))=$p(cost8,"^")_x_cost8
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; add two sets of cost numbers return: a combined cost set number
addcost(a,b) PUBLIC { QUIT a+b_","_($p(a,",",2)+$p(b,",",2))_","_($p(a,",",3)+$p(b,",",3))_","_($p(a,",",4)+$p(b,",",4))  }
	;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
procjoin	; Process Joins (was ^%qaoc1) 	;  DPV702
	#; PVA072: move setting of totstrm to be available throughout
	#; PVA026 Add call to new tag: prune 
	#; PVA027 Don't call prune if %dbugfull has been specified
	f qonumstr=2:1:totstrm d j2,finproc,prune:totstrm>6&&($g(mts("fromopts",qoqn))'="d")
	QUIT
	#; PVA026: Create new tag: prune
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
prune	; Prune all except the most likely candidates from $$$Mcost
	n keep,streams,order,outtype,soln,cost,strm,j,keeps,x
		#; PVA027 If %full specified, prune only abandoned solutions that would never contribute to the 
		#;    final choice. Only disk space is save, not algorithm speed.
	i $g(mts("fromopts",qoqn))="f" d  QUIT
	. s streams="" f  s streams=$o($$$Mcost(qoqn,qojsn,qonumstr,streams)) q:streams=""  s order="" f  s order=$o($$$Mcost(qoqn,qojsn,qonumstr,streams,order)) q:order=""  s outtype="" f  s outtype=$o($$$Mcost(qoqn,qojsn,qonumstr,streams,order,outtype)) q:outtype=""  d
	. . i '$g($$$Mcost(qoqn,qojsn,qonumstr,streams,order,outtype)) k $$$Mcost(qoqn,qojsn,qonumstr,streams,order,outtype) q
	. . s soln=$$$Mcost(qoqn,qojsn,qonumstr,streams,order,outtype),j="" f  s j=$o($$$Mcost(qoqn,qojsn,qonumstr,streams,order,outtype,j)) q:j=""  zkill:j'=soln $$$Mcost(qoqn,qojsn,qonumstr,streams,order,outtype,j)
		#; Find most promising solutions, one per (stream,order,outtype)
	s streams="" f  s streams=$o($$$Mcost(qoqn,qojsn,qonumstr,streams)) q:streams=""  s order="" f  s order=$o($$$Mcost(qoqn,qojsn,qonumstr,streams,order)) q:order=""  s outtype="" f  s soln="",outtype=$o($$$Mcost(qoqn,qojsn,qonumstr,streams,order,outtype),1,soln) q:outtype=""  d:soln
	. s cost=+$$$Mcost(qoqn,qojsn,qonumstr,streams,order,outtype,soln)
	. f j=2:1 s strm=$p(streams,",",j) q:strm=""  d
	. . g:'$d(keep(strm,order,outtype)) keepit 
	. . q:cost'<$li(keep(strm,order,outtype)) 
keepit	. . s keep(strm,order,outtype)=$lb(cost,streams,soln) q
		#; Eliminate unneeded and less promising solutions from $$$Mcost
		#; reorganize keep into keeps(streams,order,outtype)=soln
	s strm="" f  s strm=$o(keep(strm)) q:strm=""  s order="" f  s order=$o(keep(strm,order)) q:order=""  s outtype="" f  s outtype=$o(keep(strm,order,outtype),1,x) q:outtype=""  s keeps($li(x,2),order,outtype)=$li(x,3)
	k keep
	s streams="" f  s streams=$o($$$Mcost(qoqn,qojsn,qonumstr,streams)) q:streams=""  d
	. i '$d(keeps(streams)) k $$$Mcost(qoqn,qojsn,qonumstr,streams) q
	. s order="" f  s order=$o($$$Mcost(qoqn,qojsn,qonumstr,streams,order)) q:order=""  d
	. . i '$d(keeps(streams,order)) k $$$Mcost(qoqn,qojsn,qonumstr,streams,order) q
	. . s outtype="" f  s outtype=$o($$$Mcost(qoqn,qojsn,qonumstr,streams,order,outtype)) q:outtype=""  d
	. . . i '$d(keeps(streams,order,outtype)) k $$$Mcost(qoqn,qojsn,qonumstr,streams,order,outtype) q
	. . . s soln=keeps(streams,order,outtype),j="" f  s j=$o($$$Mcost(qoqn,qojsn,qonumstr,streams,order,outtype,j)) q:j=""  zkill:j'=soln $$$Mcost(qoqn,qojsn,qonumstr,streams,order,outtype,j)
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
j2	; process all entries for this # of streams
	; loop through each cost array entry for qonumstr-1
    n strmfound s strmfound=0 // PVA348
	s qoprev="" f i=1:1 s qoprev=$o($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev)) q:qoprev=""  d j3
	d:'strmfound error(34) 	; %inorder not consistent with outer joins  // PVA348 - change how this detected
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
j3	; for a given set of previous streams, find each stream that can
		#; be processed next
		#; cartes: 1 if doing a cartesian product,
		#;    0 if did at least one join so don't have to do cartesian product
		#; costprev: value of $$$Mcost(qoqn,qojsn,qonumstr-1,qoprev)
		#; resprev: list of restrictions satisfied by previous set of streams
		#; PVA027: prohibit,inlen,inlist added
	n prohibit,inlen,inlist	; prohibit will list streams prohibited by the partial order specified by %inorder
	if qonumstr=2 // PVA348: This is how starttable/firsttable are now enforced, along with lateral reference streams
	{
	  quit:( $g(mt("hint",qoqn,"%STARTTABLE")) && ($p(qoprev,",",2) '= $li(mts("streamorder",qoqn))) )
	  quit:$d(mts(qoqn,$p(qoprev,",",2),"lateral"))
	}
.
		#; PVA027: the mcost node may be just a 'phantom' pointer for a %inorder prohibited initial stream. 
		#;   Use $g() and quit for this case. 
	s cartes=1,costprev=$g($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev)),resprev=$p(costprev,"^",7) QUIT:costprev=""
		#; PVA027: Build prohibit list from %inorder partial order, if present.
	s inlist=$g(mts("streamorder",qoqn)),inlen=$ll(inlist) f i=1:1:inlen q:qoprev'[(","_$li(inlist,i)_"," )
	s prohibit=$li(inlist,i+1,inlen)
	quit:$lf(prohibit,$p(qoprev,",",2)) // PVA348: already wrong order
		#; pva028: Eliminate use of ptjorder here
		#;  Each remaining stream must be considered 
		#; PVA027: Filter against prohibit
	s qosn="" f i=1:1 s qosn=$o(ptj(qoqn,qojsn,qosn)) q:qosn=""  i qoprev'[(","_qosn_","),'$lf(prohibit,qosn) d j4
j4dun	;  all possible joins added
	QUIT:'cartes 	; quit if at least one stream can be joined
	n cartsol,cartis,cartsel
	d cartprod 	; ***must do a cartesian product
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
j4	; this stream (qosn) is not contained in the set of
		#; previous streams (qoprev).  It may be a join candidate.
		#; pva028: removed comment reference to ptjorder.
	n ldeps,i
	if $d(mts(qoqn,qosn,"lateral"),ldeps) // PVA348 - skep stream if unsatisfied lateral references
	{  for i=1:1:$ll(ldeps) {return:qoprev'[(","_$li(ldeps,i)_",")}
	}
	s reqslist="" f i=1:1 s reqslist=$o(ptj(qoqn,qojsn,qosn,reqslist)) q:reqslist=""  d jmaybe
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
jmaybe	; if this set of required streams is in qoprev, then this stream can be joined now
	f i=2:1:$l(reqslist,",")-1 GOTO jmaybe1:qoprev'[(","_$p(reqslist,",",i)_",")
		#; all needed streams are present already 
		#; process this stream's  algorithms
		#; PVA023: kill resalready (now an array, not just a variable) when new stream considererd
	s newstream=1,algnum="" k resalready f j=1:1 s algnum=$o(ptj(qoqn,qojsn,qosn,reqslist,algnum)) q:algnum=""  s cartes=0 d join
jmaybe1	QUIT
	;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
join	; join this stream to the set of previous streams
		#; input variables:
		#;  qosn: the stream to be joined
		#;  qoprev: the previous set of streams
		#;  algnum: the algorithm # of the malg() array
		#;  costprev: value of $$$Mcost(qoqn,qojsn,qonumstr-1,qoprev)
		#;  resprev: list of restrictions satisfied by previous set of streams
		#; PVA072: new variable uset
	n uset,xy s qoalg=$$$Malg(algnum)
		#; Skip unsupported merge join algorithm. Not implemented, yet occasionally selected. Cost formulas for them
		#; never adequately debugged.
	q:$p(qoalg,"^",14)="J9"
		#; set qoslist = qoprev with qosn inserted in order
	f i=2:1:$l(qoprev,",")-1 i $p(qoprev,",",i)>qosn s qoslist=$p(qoprev,",",1,i-1)_","_qosn_","_$p(qoprev,",",i,200) q
	e  s qoslist=qoprev_qosn_","
		#; PVA023: Updated comments about resalready:
		#; if this is the first algorithm for joining this stream to the
		#; previous set of streams, must find out what 'maybe' restrictions
		#; can't be processed, and with which of those previous
		#; streams might this stream be physically stored.
		#; Which replicated restrictions need not be tested depends on map chosen and
		#;   other factors, so these must be determined more often (but not for every
		#;   algorithm). See Setresalready.
		#; created variables:
		#;     resalready: restrictions already satisifed due to replication
		#;     nores: restrictions don't have to process here (due to maybe
		#;        restrictions that can't be processed and due to replication)
	d:newstream %qaoc4
	s strmfound=1 // PVA348
		#; PVA023: call new setresalready tag
	d setresalready	; sets nores as well as resalready
join1	; 	#; process this algorithm
		#; setup extra data to be stored with cost array entries for this alg
		#; PVA279: set adjsel
	s extradata="^"_algnum_"^"_nores_"^"_resalready_"^"_resknown_"^"_resmaybe_"^"_adjsel_"^"
	s cost3(0)="",cost3(1)="",cost8=""	;indicate haven't called cost3 or cost8 yet
	GOTO join2:cartes	; cost array not used if cartesian product
		#; setup cost array
	n a,par s a=$p(qoalg,"^",17) f i=1:1:$$$SUBMAX s form(i)=+$p(a,",",i)
		#; subtract out impact of replicated restrictions that have already
		#; been processed or maybe restrictions that can't be processed
		#; PVA072: compute uset - whether to use deferred TOP entry, vs. regular one, in formsub
	if $p(qoalg,"^",13)]""{
		if $e($p(qoalg,"^",13))="S"&&(totstrm=1) {s uset=0}
		else {s uset=1}
	}
	else {s uset=0}
	s a="" f i=1:1 s a=$o($$$Malg(algnum,a)) q:a=""  d formsub:(nores[(","_a_",")|| (adjsel[(","_a_","))) // PVA279: adjsel
	GOTO jordreq:$p(qoalg,"^",11)	; branch if ordered input required
		#; apply .3*PBP cost to fastest unordered input where input outtype
		#; = 0 or 1, and output is order = 0 and outtype = 0
		#; pva026 - use $g below, 0,0 and 0,1 solns may be pruned.
join2	s y=$g($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,0,0)),z=$g($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,0,1))
	i y s par=qoqn_":"_qojsn_":"_(qonumstr-1)_":"_qoprev_":0:0:"_y d junord1($$cost3(par),$p($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,0,0,y),"^"),par)
	i 'y,z s par=qoqn_":"_qojsn_":"_(qonumstr-1)_":"_qoprev_":0:1:"_z d junord1($$cost3(par),$p($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,0,1,z),"^"),par)
    if nojord && (qonumstr=2)  // PVA316: without join interesting orders can miss picking up multi-index initial stream plans - need to explicitly look for them
    {  s z2=$g($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,0,2))
       s:z2 par=qoqn_":"_qojsn_":"_(qonumstr-1)_":"_qoprev_":0:2:"_z2
       d:z2 junord1($$cost3(par),$p($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,0,2,z2),"^"),par)
    }
		#;
		#; apply .8*PBP cost to fastest unordered temp file input from
		#; the previous level
		#;
		#; PVA072: Don't add interim temp files if TOP limit active (but final
		#;         sort file ok and needed for TOP limiting).
		#; PVA073: This is actually not reachable with toplimit active because z (an outtype 1
		#;         partial solution) will never exist. Simplify test 'documenting' that this will
		#;         never be used in the toplimit case.
		#; PVA157: also for DISTINCT on query
		#; PVA185: check timefirst instead of toplimit
	i z d:'timefirst(qoqn)&&'$d($$$mtGroupDistinctList(qoqn)) junord2($$cost8,$p($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,0,1,z),"^"),qoqn_":"_qojsn_":"_(qonumstr-1)_":"_qoprev_":0:1:"_z)
		#;
		#; if the ptfjoo order is an output order of the previous stream set,
		#; then consider using it as input for this algorithm and store
		#; the output as order=ptfjoo and outtemp = 0 and 1
		#;
	q:ptfjoo(qoqn)=""  q:'$d($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,ptfjoo(qoqn))) // PVA184: ptfjoo by query number now
		#;
		#; apply .3*PBP cost to fastest inp where input outtype = 0 or 1 or 2
		#; and output is order = ptfjoo and outtype = 0
		#;
		#;PVA184: change ptfjoo reference to index by query number
	s y=$g($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,ptfjoo(qoqn),0)),xy=0
	s z=$g($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,ptfjoo(qoqn),1)),x=1
	s a=$g($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,ptfjoo(qoqn),2))
	i z,a,$$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,ptfjoo(qoqn),2,a)<$$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,ptfjoo(qoqn),1,z) s z=a,x=2
    i 'z,a s z=a,x=2 // PVA206
    #; PVA206: make y best of y and z, writing only best of 3 to outtype 0
	i y,z,$$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,ptfjoo(qoqn),x,z)<$$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,ptfjoo(qoqn),0,y) s y=z,xy=x
    i 'y,z s y=z,xy=x // PVA206
	i y s par=qoqn_":"_qojsn_":"_(qonumstr-1)_":"_qoprev_":"_ptfjoo(qoqn)_":"_xy_":"_y d junord3($$cost3(par),$p($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,ptfjoo(qoqn),xy,y),"^"),par)
		#;
		#; apply .8*PBP cost to fastest temp file input with order = ptfjoo
		#; and input outtype = 1 or 2 and output outtype = 1
		#;
		#; PVA072: Don't add interim temp files if TOP limit active
		#; PVA157: or if DISTINCT on query
		#; PVA184: ptfjoo by qoqn now
		#; PVA185: check timefirst instead of toplimit
	i z d:'timefirst(qoqn)&&'$d($$$mtGroupDistinctList(qoqn)) junord4($$cost8,$p($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,ptfjoo(qoqn),x,z),"^"),qoqn_":"_qojsn_":"_(qonumstr-1)_":"_qoprev_":"_ptfjoo(qoqn)_":"_x_":"_z)
	q
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
jordreq	; perform join where ordered input is required
		#; note: naturally occurring output order = interesting input order
		#;    also: for an interesting order (input order '= 0)
		#;          we have an input of outtype = 1 or 2, but not both,
		#;          and maybe an outtype = 0
		#;
	GOTO jmerge:$p(qoalg,"^",14)="J9"	; branch if merge sort algorithm
	s order=$p(qoalg,"^",5)	; order = interesting order input
		#; apply .3*PBP to non-temp file ordered input
	s y=$g($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,order,0))
	i y s par=qoqn_":"_qojsn_":"_(qonumstr-1)_":"_qoprev_":"_order_":0:"_y d jord1($$cost3(par),$p($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,order,0,y),"^"),par,order)
		#; apply .3*PBP and .8*PBP to temp file ordered input
	f x=1,2 s y=$g($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,order,x)) i y s par=qoqn_":"_qojsn_":"_(qonumstr-1)_":"_qoprev_":"_order_":"_x_":"_y d
	. d jord1($$cost3(par),$p($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,order,x,y),"^"),par,order)
		#; PVA073: don't generate interim temp files for toplimit, ever
		#; PVA157: or if DISTINCT
		#; PVA185: check timefirst instead of toplimit
	. d:(('timefirst(qoqn)&&'$d($$$mtGroupDistinctList(qoqn)))||(qonumstr=totstrm)) jord2($$cost8,$p($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,order,x,y),"^"),par,order)
	q
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA072: Currently not reached. If re-enabled, must be modified for TOP limit:
	#;         it is not permissible to build a temp file of input 
	#;         to current join when TOP is being done. 
jmerge	; merge sort algorithm
	s c=costprev*form($$$SSJAIN)
		#; i c>1, there is at least one tuple for each JA that passes all
		#;        high level restrictions (other than restrictions on the JA)
	if c>1 { s b=1/form($$$SSJAIN)+.5\1 } else { s b=+costprev }
	s a=form($$$SSJACOND)/$s(form($$$SSJA)<form($$$SSJAIN):form($$$SSJA),1:form($$$SSJAIN))
	s qoout8=$$jmerge^%qaqojn(+costprev,+$p($p(costprev,"^",3),",",4),b,+$p(costprev,"^",3),a)
		#; add probable cost of producing temp index/sort file for the stream
		#; being joined and subtract cost of reading input file since that is
		#; calculated in merge cost
	s a=$p(qoout8,"^"),c=$p(qoalg,"^",16) s $p(qoout8,"^")=(a+c-readcost)_","_($p(a,",",2)+$p(c,",",2)-$p(readcost,",",2))_","_($p(a,",",3)+$p(c,",",3)-$p(readcost,",",3))_","_($p(a,",",4)+$p(c,",",4)-$p(readcost,",",4))
		#; apply .8*PBP to temp file ordered input
	f x=1,2 s y=$g($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,order,x)) d:y jord2(qoout8,$p($$$Mcost(qoqn,qojsn,qonumstr-1,qoprev,order,x,y),"^"),qoqn_":"_qojsn_":"_(qonumstr-1)_":"_qoprev_":"_order_":"_x_":"_y,order)
	QUIT
	;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
formsub	; if this is a replicated restriction that has already been processed,
	#; or if it is a maybe restriction that can't be processed,
	#; then remove its impact from the cost formulas
	#; Note that not everything in resalready is in
	#; the malg(,) array since sometimes several restrictions
	#; apply to the same field.  For example, if we replicate
	#; A.A > 3  and A.A < 5  then deduct from cost formulas only
	#; once for both restrictions
	#; PVA023: This logic is replicated in prepform^%qaqojn2. Must keep these in synch.
	#;   Also fix long standing (never hit?) bug where "," used instead of "^"
	#; PVA072: use proper formula change entry based on uset
	s b=$g($$$Malg(algnum,a)) f i=1:1:$l(b,"^") s c=$p(b,"^",i) s:c]"" form(+c)=form(+c)*$s(uset:$p(c,":",3),1:$p(c,":",2))
	if $$$mtLOperator($$$mtL(a))="DISTINCT" // PVA220: must remove distinct filter cost as well.
	                                  #; This does not fit into multiplicative design of
	                                  #; existing change() array; do special logic
	{  if form($$$SGPi)'<(CDFACTOR/CGGFACTOR)&&(form($$$SGPi)>form($$$SGPb)) {s form($$$SGPi)=form($$$SGPi)-(CDFACTOR/CGGFACTOR)}
	   elseif form($$$SGPb)'<(CDFACTOR/CGGFACTOR) {s form($$$SGPb)=form($$$SGPb)-(CDFACTOR/CGGFACTOR)}
	}
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
finproc	; Finish processing this stream set (was ^%qaoc2) 	;  DPV702
a	n a,qoslist,outseq,outsort s qoslist=""
	f i=1:1 s qoslist=$o($$$Mcost(qoqn,qojsn,qonumstr,qoslist)) q:qoslist=""  d
		#; pva026 if no solutions set up for qoslist, following node may be undefined
	. s a=$g($$$Mcost(qoqn,qojsn,qonumstr,qoslist)) q:a=""
	. s outseq=$p(a,"^",4),outsort=$p(a,"^",5) d finish
	QUIT
	;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
finish	; used by both initial stream and join algorithms
	#; now go though the cost array for this number of streams
	#; and find fastest solutions
	#; PVA026: The following assumption must be relaxed for pruning.
	#; This code assumes there is always a mcost entry for
	#; order=0,outtype=0 when this code is called, although
	#; there may not be when this code exits.  This will
	#; always be true for initial streams, and it will always
	#; be true for joins provided there is always at least one
	#; unordered input join algorithm
	#; input variables:
	#;     qoqn, qojsn,qonumstr, qoslist, outseq, outsort
	#; first process order = 0.  Find fastest outtype=0, then use it
	#;     to create a outtype=1.  Then find fastest outtype=1.
	#;     Then create an entry in outtype=2
	#;     and find the fastest outtype=2
	n x,y,z,a,b,c,d,order s x=$$fastest(0,0)
		#; use this entry to create an order=0, outtype=1 entry
		#; PVA026 - skip if x is empty (no (0,0) solution)
		#; PVA072: Don't add interim temp files if TOP limit active
		#; PVA157: or if DISTINCT
		#; PVA185: check timefirst instead of toplimit
	s:x]""&&'timefirst(qoqn)&&'$d($$$mtGroupDistinctList(qoqn)) $$$Mcost(qoqn,qojsn,qonumstr,qoslist,0,1,$$nexti(0,1))=$$addcost(x,outseq)_"^"_$p(x,"^",2,*)
		#;
		#; calculate fastest entry for outtype = 1, order = 0
		#; if outtype=1 is a faster solution than outtype=0, then don't keep
		#; outtype=0 (this is unusual, but could occur due to size of buffer
		#; pool's impact on algorithms)
		#;
		#;PVA026 - fastest (0,1) may be unavailable so test for d empty
		#;PVA027: Add !(x="" ) for more correct test of when to use d.
	s d=$$fastest(0,1) i d]"",d<x||(x="") s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,0,0)="",x=d-outseq_","_($p(d,",",2)-$p(outseq,",",2))_","_($p(d,",",3)-$p(outseq,",",3))_","_($p(d,",",4)-$p(outseq,",",4))_"^"_$p(d,"^",2,*)
		#;
		#; now use this fastest order=0,outtype=0 or 1 entry to create an
		#; order=0,outtype=2 entry
		#;PVA026 - check for x nonempty
		#; PVA072: Don't add interim temp files if TOP limit active (but final
		#;         sort file ok and needed for TOP limiting).
		#; PVA157: same for DISTINCT
		#; PVA185: check timefirst instead of toplimit
	s:x]""&&(('timefirst(qoqn)&&'$d($$$mtGroupDistinctList(qoqn)))||(qonumstr=totstrm)) $$$Mcost(qoqn,qojsn,qonumstr,qoslist,0,2,$$nexti(0,2))=$$addcost(x,outsort)_"^"_$p(x,"^",2,*)
	s fastsort=$$fastest(0,2)	; find fastest order=0,outtype=2 entry
		#;
		#; add it to each interesting order outtype=2 and find fastest
		#; solutions
		#;
	s order=0 f i=1:1 s order=$o($$$Mcost(qoqn,qojsn,qonumstr,qoslist,order)) q:order=""  d finish1
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
finish1	; add fastsort to this outtype=2 array for this interesting order
	#; then determine fastest outtype solutions for this interesting order
	#; PVA026 - check for existence of fastsort
	#; PVA072: Don't add interim temp files if TOP limit active (but final
	#;         sort file ok and needed for TOP limiting).
	#; PVA157: same for DISTINCT
	#; PVA185: check timefirst instead of toplimit
	s:fastsort]""&&(('timefirst(qoqn)&&'$d($$$mtGroupDistinctList(qoqn)))||(qonumstr=totstrm)) $$$Mcost(qoqn,qojsn,qonumstr,qoslist,order,2,$$nexti(order,2))=fastsort
	s x=$$fastest(order,0)	; get fastest outtype=0 solution
		#; use this entry to create an outtype=1 entry
		#; PVA072: Don't add interim temp files if TOP limit active
	#; PVA157: same for DISTINCT
	#; PVA185: check timefirst instead of toplimit
	s:x]""&&'timefirst(qoqn)&&'$d($$$mtGroupDistinctList(qoqn)) $$$Mcost(qoqn,qojsn,qonumstr,qoslist,order,1,$$nexti(order,1))=$$addcost(outseq,x)_"^"_$p(x,"^",2,*)
	s y=$$fastest(order,1)	; get fastest outtype=1 solution
	s z=$$fastest(order,2)	; get fastest outtype=2 solution
		#; only keep the faster of the fastest outtype=1 or 2 solutions
	i y>z q:z=""  s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,order,1)="" QUIT
	s:y'="" $$$Mcost(qoqn,qojsn,qonumstr,qoslist,order,2)=""
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
fastest(order,type)	; find fastest entry for this outtype
	#; input parameters:
	#;     order: interesting order (or 0)
	#;     type: output type (0,1, or 2)
	#;return: cost solution of the fastest entry
	#;        + set $$$Mcost(qoqn,...,type)= index to fastest solution 
	#;              	;***MAYBE SET IT TO FASTEST SOLUTION VALUE!!!
	#;
	s c=0,a="",d=""
	f i=1:1:$o($$$Mcost(qoqn,qojsn,qonumstr,qoslist,order,type,""),-1) s b=$$$Mcost(qoqn,qojsn,qonumstr,qoslist,order,type,i) s:(b<c)||(i=1) c=+b,a=i,d=b
	s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,order,type)=a
	QUIT d
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
nexti(order,outtype)	;
	#; obtain next value to use for 'i' subscript of the cost array
	#; input parameters:
	#;     order: interesting order subscript, or 0
	#;     outtype: output type (0,1, or 2)
	#; return: next value
	#;****If use a global for the cost array, we should use an arr to keep
	#; track of the outtype=0,1,and 2 highest i for order=0
	#;
	QUIT $o($$$Mcost(qoqn,qojsn,qonumstr,qoslist,order,outtype,""),-1)+1
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
%qaoc4	;  (was ^%qaoc4) 	;  DPV702
	#; PVA023: Updated comments below to reflect that nores and resalready are not 
	#;         computed here. See setresalready.
	#;
	#; if this is the first algorithm for joining this stream to the
	#; previous set of streams, must find out what 'maybe' restrictions
	#; can't be processed, and with which of those previous
	#; streams might this stream be physically stored
	#; created variables:
	#;     parchild, setdata, outseq, outsort, readcost, resslist
	#;     resmaybe, noresmaybe, resslist
	#;
	#;
	#; set parchild = set of previous streams with which this stream
	#;     is physically stored and joined on child's parent id
	#; PVA023: 'new' qointord; (this bug fix not related to rest of PVA023). 
	n a,x,y,qointord s newstream=0,parchild=",",a=$p(mts(qoqn,qosn),"^",3)
	i a'="" f i=2:1:$l(a,",")-1 s:qoprev[(","_$p(a,",",i)_",") parchild=parchild_$p(a,",",i)_","
	s:parchild="," parchild=""
		#; what maybes can't be satisfied?
	s resmaybe=",",noresmay=",",a=$p(qoalg,"^",8) i a'="" f y=1:1:$l(a,"*") d:$p(a,"*",y) maybe($p(a,"*",y))
		#; what restrictions may already have been satisfied?
		#; PVA023: resalready and nores no longer set here. They really depend on more than just the
		#;         stream set, so they are built when all determinants are known.
	s resknown=$p(qoalg,"^",7) s:resmaybe="," resmaybe=""
		#;
		#; resmaybe = list of maybe restrictions we should process
		#; noresmay = list of maybe restrictions we shouldn't process
		#; PVA023: Deleted comments about nores and resalready.
		#; resslist = list of all restrictions processed in this set of streams
		#;
		#;
		#; if this is the first time we have created solutions for this
		#; set of streams, we must also setup interesting orders
		#; and the list of all restrictions processed in this set of streams
		#;
	s setdata=$g($$$Mcost(qoqn,qojsn,qonumstr,qoslist))
	i setdata]"" s outseq=$p(setdata,"^",4),outsort=$p(setdata,"^",5),readcost=$p(setdata,"^",6),resslist=$p(setdata,"^",7)
		#; PVA023: fix reference to $l(resknown) where $l(resmaybe) was meant.
	e  s resslist=$e(resprev,1,*-1)_$e(resknown,1,*-1)_$e(resmaybe,1,*-1),resslist=$s(resslist]"":resslist_",",1:"")
	e  d %qaoinor^%qaoinor(qoslist,.qointord) s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,0)="",a="" f i=1:1 s a=$o(qointord(a)) q:a=""  s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,a)=""
		#;
		#; if setdata = "", then we wil setup setdata and $$$Mcost(...,qoslist)
		#; and outseq,outsort,readcost,resslist later after evaluating
		#; the first formula cost since we need to know the # of output
		#; tuples to perform the calulations of these values
		#;
	QUIT
	#; PVA023: Add new tag 'setresalready'
	#; PVA279: seladj/adjsel 
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
setresalready
	#; 
	#; Inputs (implicit):
	#;   resknown  - restrictions knowns satisfied on current stream, no dependencies on other streams
	#;   ptres - structure recording which restrictions imply other restriction's truth
	#;   seladj - structure recording selectivity adjustments for conditions in ptres when tested 
	#;            in an order that requires all be tested
	#;   resprev - restrictions previously satisfied (on prior streams)
	#;   resmaybe - restrictions dependent on other streams that are satisfiable on the current stream
	#;                      (required prior streams have been processed).
	#;   noresmay - restrictions involving current stream and other streams which are no satisfiable
	#;              given the prior streams processes.                   
	#;   qoalg
	#;   
	#; Outputs (implicit):
	#;       resalready - restrictions already satisfied because of what has been tested before (see inputs).
	#;       nores - restrictions don't have to process here (due to maybe
	#;               restrictions that can't be processed and due to replication)
	#;       adjsel - restrictions that require selectivity adjustment due to logical dependency,
	#;                that is, when an implication set is tested in an order such that all conditions
	#;                must be tested, but selectivity should be the same as if one were skipped.
	#; 
	#; Note: When this is called for joins, it relies on resknown+resmaybe being applicable over all joins
	#;   considered for a given set of prior streams and current stream- even though each could be different for different 
	#;   joins. The logic of calling %qaoc4 only for each new stream is based on this assumption. Thus cost
	#;   entries actually contain resknown from the first join of a 'series' and NOT necessarily the 
	#;   resknown from the algorithm they reference. 
	#;   
	#;   For initial streams, of course, resmaybe is empty and resknown is invariant over the algorithms 
	#;   for a given stream. 
	#;   
	n tempalg,map,joinres,ressub
		#;PVA34: multi-map main algorithm ISALG7 is map-less.
	s joinres=$p(qoalg,"^",6),map=$p(qoalg,"^",12) s:map="" map=" " 
	s:joinres="" joinres=" "	; so we can use it in a subscript
		#; temp alg only makes a difference when it affects when join conditions are
		#; are tested; so we set empty for initial stream and cartesian products
		#; When handling initial and cartesian product stream SOLUTIONS, we don't care about temp alg. 
	if +qoalg<2 { s tempalg=$p(qoalg,"^",13) } else { s tempalg="" }
		#; PVA072: setresalready2 now takes ressub as argument. 
	s ressub=$p(qoalg,"^",10) d setresalready2(ressub)
	QUIT
	
	#; setresalready2 is called for temp alg costing. Now that we consider the impact of single stream 
	#; equivalence classes (which were always generated by the pre-optimizer), the cost formula for
	#; temp algs must be adjusted. The information to do this is developed by setresalready2.
	#; PVA072: setresalready2 now takes ressub as argument. 
	#; PVA277: modify to use structured constructs instead of dots; this alse repaired a logic flaw
setresalready2(ressub)	n a,y,z,i,reswork,sub,subinfo,ifn,log,v,other,plog,tempmap0
	i tempalg]"" s tempmap0="no" i ",IC3,IC5,IC6,S3,S5,S7,S8,S10,S12,S13,"[(","_tempalg_",") s tempmap0="yes"
	s:$g(tempmap0)="" tempmap0=" "	; so we can use it in a subscript.
	i $d(resalready(tempmap0,map,joinres)) s resalready=$p(resalready(tempmap0,map,joinres),"^"),adjsel=$p(resalready(tempmap0,map,joinres),"^",2) g setresdone
	s resalready=",",reswork=",",adjsel=","
		#; Build reswork - a list of conditions in an order consistent with how %qaqpmod specifies their testing in ASL.
		#;    Important efficiencies are lost if there are discrpancies between conditon order in reswork and condition
		#;    testing order in ASL (defined by loop and next in %qaqpmod, plus join and prep tags which drive them).
		#; Following relies on ressub having been build in subscript order with no gaps. Such is currently the case 
		#;   and needs to remain that way. Thus, ith piece corresponds to ith map subscript.
	s sub="" f   
	{ s sub=$o(mts(qoqn,qosn,"MAP",map,sub),1,subinfo)  q:sub=""
	  continue:+subinfo<2||(+subinfo>6)
	  s log="",ifn=$p(subinfo,"^",2)_$s($p(subinfo,"^",6)'="":"_"_$p(subinfo,"^",6),1:"")
		; Ideally, we should consider 'false' JOINs even if tempmap0. These are 
		; outer join <field>=<constant> conditions that are set up as JOIN nodes. 
	  i tempmap0']" " 
	  {
	    s log="" f  s log=$o(mts(qoqn,qosn,"JOIN",ifn,log)) q:'log  q:resmaybe_resknown[(","_log_",")  
	    i log s reswork=reswork_log_"," g subconds
	    i ifn["_"   
	    {
	      s plog="" f  s plog=$o(mts(qoqn,qosn,"JOIN",+ifn,plog)) q:'plog  q:resmaybe_resknown[(","_plog_",")
	      g:plog subconds
	    }
	  }
		;
		; Now update resalready to reflect the application of any [generalized] 
		; CON conditions on this subscript.  Since the JOIN condition has already
		; applied, any generalized CON condition that applies transitively through
		; the JOIN only needs to be applied in the earliest applicable stream.
	  s log=$p($p($g(mts(qoqn,qosn,"CON",ifn)),"^",2),",",2) i log s reswork=reswork_log_"," g subconds
	  i ifn["_" s plog=$p($p($g(mts(qoqn,qosn,"CON",+ifn)),"^",2),",",2) g:plog subconds	; partially satisfied condition not
	         	;added to reswork, but it does disable looking for any other special conditions to apply first.
		#; We ignore the change in order of condition processing for special in/or or allrowid optimizations
		#; in qaqpmod, for the reasons described in //code_server/main/rdbm/docs/ptres.txt. Briefly, they only
		#; apply under circumstances such that their order of testing cannot change what goes in resalready. 
		#; Furthermore, they are soon to be replaced by more general OR optimizations that won't need such 
		#; special handling. 
rcheck  	s v=$g(mts(qoqn,qosn,"RANGE",ifn)) g:v="" subconds
	  	s other=$p(v,"^",3),val=$p(mts(qoqn,qosn,"ATT",ifn),"^",5)	; val# for ifn must exist because RANGE does
	  	s log=$$range^%qaqpmod($p(v,"^",2),other) 
		#; PVA073: filter log from $$range against ressub -> if not there, this is a non-testable
		#;         TOP condition
	  	s log=$$remove(log,$$remove(log,$p($p(ressub,"*",sub),":",2)))
	  	s:+log reswork=reswork_log_$s($e(log,*)=",":"",1:",") // PVA141: log may or may not end in a ","
subconds  s plog=$p($p(ressub,"*",sub),":",2),plog=$e(plog,2,*),plog=$$remove(plog,log_$s(tempmap0]" ":joinres,1:"")) s:plog]"" reswork=reswork_plog
	}
	s i=$f(ressub,"index:") i i s log=$e($p($e(ressub,i,*),":"),2,*) s:log]"" reswork=reswork_log
	if tempmap0=" "
	{
	  s i=$f(ressub,"indexmul:") i i s log=$p($e(ressub,i,*),":"),log=$$remove($e(log,2,*),reswork) s:log]"" reswork=reswork_log
	  i i s log=$p($e(ressub,i,*),":",2),plog=reswork_noresmay,log=$$remove($e(log,2,*),plog) s:log]"" reswork=reswork_log
	}
	else
	{  
	   i tempmap0="yes" s i=$f(ressub,"map0:") i i s log=$e($p($e(ressub,i,*),":"),2,*) s:log]"" reswork=reswork_log
	   s log=$$remove($e(joinres,2,*),reswork) s:log]"" reswork=reswork_log	; we allow for false joins in joinres 
	}
		#;      to have already been processed, though this not implemented yet. See earlier comment about false joins.
	s log=$e(resknown,2,*)_$e(resmaybe,2,*),log=$$remove(log,reswork) s:log]"" reswork=reswork_log
		#; now build resalready from reswork  
	f y=2:1:$l(reswork,",")-1 s a=$p(reswork,",",y) d already:($d(ptres(a))||$d(seladj(a)))
	s:resalready="," resalready="" s:adjsel="," adjsel=""  s resalready(tempmap0,map,joinres)=resalready_"^"_adjsel
setresdone
	s nores=noresmay_$e(resalready,2,*) i nores="," s nores=""
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
jord1(qoout,parcost,parsub,order)	;
	#;
	#; store solution for .3*PBP, ordered input
	#; store with order=0,outtype = 0
	#; if order is an interesting output order,
	#; then also store with that order and outtype = 0
	#; input parameters:
	#;     qoout: output of cost formula        cost ^ # tuples
	#;     parcost: cost incurred by parent
	#;     parsub: subscripts for parent
	#;     order: interesting input order
	#;
	d:setdata="" setdata(+$p(qoout,"^",2))
	n x s x=$$addcost($p(qoout,"^"),parcost)_"^"_qosn_"^"_parsub_extradata_qoout
	s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,0,0,$$nexti(0,0))=x
	s:$d($$$Mcost(qoqn,qojsn,qonumstr,qoslist,order)) $$$Mcost(qoqn,qojsn,qonumstr,qoslist,order,0,$$nexti(order,0))=x
	q
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
jord2(qoout,parcost,parsub,order)	;
	#;
	#; store solution for .8*PBP, ordered temp file input
	#; store with outtype = 1 and 2 for order = 0
	#; if order is an interesting output order,
	#; then also store with that order and outtype = 1
	#; input parameters:
	#;     qoout: output of cost formula        cost ^ # tuples
	#;     parcost: cost incurred by parent
	#;     parsub: subscripts for parent
	#;     order: interesting input order
	#;
	d:setdata="" setdata(+$p(qoout,"^",2))
	n x s x=$$addcost($p(qoout,"^"),parcost)
		#; PVA073: Never generate outtype 1 temp files, ever, for TOP
	#; PVA157: same for DISTINCT
	#; PVA185: check timefirst instead of toplimit
	s:'timefirst(qoqn)&&'$d($$$mtGroupDistinctList(qoqn)) $$$Mcost(qoqn,qojsn,qonumstr,qoslist,0,1,$$nexti(0,1))=$$addcost(x,outseq)_"^"_qosn_"^"_parsub_extradata_qoout
	s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,0,2,$$nexti(0,2))=$$addcost(x,outsort)_"^"_qosn_"^"_parsub_extradata_qoout
		#; PVA073: Never generate outtype 1 temp files, ever, for TOP
	#; PVA157: same for DISTINCT
	i $d($$$Mcost(qoqn,qojsn,qonumstr,qoslist,order)) s:'timefirst(qoqn)&&'$d($$$mtGroupDistinctList(qoqn)) $$$Mcost(qoqn,qojsn,qonumstr,qoslist,order,1,$$nexti(order,1))=$$addcost(x,outseq)_"^"_qosn_"^"_parsub_extradata_qoout
	q
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
junord1(qoout,parcost,parsub)	;
	#;
	#; store solution for .3*PBP, unordered input
	#; store with order=0, outtype = 0
	#; input parameters:
	#;     qoout: output of cost formula        cost ^ # tuples
	#;     parcost: cost incurred by parent
	#;     parsub: subscripts for parent
	#;
	d:setdata="" setdata(+$p(qoout,"^",2))
	s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,0,0,$$nexti(0,0))=$$addcost($p(qoout,"^"),parcost)_"^"_qosn_"^"_parsub_extradata_qoout
	q
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
junord2(qoout,parcost,parsub)	;
	#;
	#; store solution for .8*PBP, unordered temp file input
	#; store with outtype = 1 and 2 %under order = 0
	#; input parameters:
	#;     qoout: output of cost formula        cost ^ # tuples
	#;     parcost: cost incurred by parent
	#;     parsub: subscripts for parent
	#;
	d:setdata="" setdata(+$p(qoout,"^",2))
	n x s x=$$addcost($p(qoout,"^"),parcost)
	s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,0,1,$$nexti(0,1))=$$addcost(x,outseq)_"^"_qosn_"^"_parsub_extradata_qoout
	s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,0,2,$$nexti(0,2))=$$addcost(x,outsort)_"^"_qosn_"^"_parsub_extradata_qoout
	q
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
junord3(qoout,parcost,parsub)	;
	#;
	#; store solution for .3*PBP, output order = ptfjoo, outtype = 0
	#; input parameters:
	#;     qoout: output of cost formula        cost ^ # tuples
	#;     parcost: cost incurred by parent
	#;     parsub: subscripts for parent
	#;
	d:setdata="" setdata(+$p(qoout,"^",2))
	#; PVA184: ptfjoo by qoqn now
	s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,ptfjoo(qoqn),0,$$nexti(ptfjoo(qoqn),0))=$$addcost($p(qoout,"^"),parcost)_"^"_qosn_"^"_parsub_extradata_qoout
	q
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
junord4(qoout,parcost,parsub)	;
	#;
	#; store solution for .8*PBP, output order = ptfjoo, outtype = 1
	#; input parameters:
	#;     qoout: output of cost formula        cost ^ # tuples
	#;     parcost: cost incurred by parent
	#;     parsub: subscripts for parent
	#;
	d:setdata="" setdata(+$p(qoout,"^",2))
	n x s x=$$addcost($p(qoout,"^"),parcost)
	#; PVA184: ptfjoo by qoqn now
	s $$$Mcost(qoqn,qojsn,qonumstr,qoslist,ptfjoo(qoqn),1,$$nexti(ptfjoo(qoqn),1))=$$addcost(x,outseq)_"^"_qosn_"^"_parsub_extradata_qoout
	q
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cost3(parent)	;
	#;
	#; evaluate (if necessary) the cost formula for a .3*PBP buffer pool
	#; $$cost3() requires an input parameter which indicates whether or not
	#; it should ignore map0 disk accesses because the stream is stored
	#; physically contiguous with a child/parent that has been accessed
	#; without any intervening output temp file
	#; if $$cost3() has already been called with the same par/child flag,
	#; then just return
	#; input parameter:
	#;     parent: the set of subscripts needed to reference the 
	#;             parent solution
	#; return: results of cost formula in format:
	#;         cost,cd,cgg,cgs ^ number of tuples
	#;
	n x s x=$$parchild(parent) q:cost3(x) cost3(x) q:cartes $$cartcost(+costprev,PBP*.3)
	s cost3(x)=$$join^%qaqojn($p(qoalg,"^",14),+costprev,+$p(qoalg,"^",3),+qoalg,+$p(qoalg,"^",11),x,PBP3)
	s:$p(qoalg,"^",16) $p(cost3(x),"^")=$$addcost($p(cost3(x),"^"),$p(qoalg,"^",16))
	q cost3(x)
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cost8()	; calculate cost of applying algorithm with a .8*PBP available  buffer pool
	q:cost8]"" cost8 q:cartes $$cartcost(+costprev,PBP*.8)
	s cost8=$$join^%qaqojn($p(qoalg,"^",14),+costprev,+$p(qoalg,"^",3),+qoalg,+$p(qoalg,"^",11),0,PBP8)
	s:$p(qoalg,"^",16) $p(cost8,"^")=$$addcost($p(cost8,"^"),$p(qoalg,"^",16))
	q cost8
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
parchild(parent)	;
	#;
	#; see if this algorithm uses a stream that is stored physically
	#; with an already processed stream that accessed map 0, and there
	#; are no temporary output files in between
	#; input parameter:
	#;      parent:  set of parent subscripts for cost array
	#; input variable:
	#;      parchild: set of previous streams with which this steam
	#;                is physically stored and joined on the child's
	#;                parent id
	#; return: 1 => can avoid disk access
	#;         0 => can't avoid disk access
	#;
	q:parchild=""||('$p(qoalg,"^",21))||(cartes) 0
	n num,a s num=qonumstr
parch1	q:$p(parent,":",6) 0	; q if prev strm set output went into temp file
	s num=num-1 q:'num 0
		#; get previous stream set solution
	s a=$$$Mcost(qoqn,qojsn,num,$p(parent,":",4),$p(parent,":",5),$p(parent,":",6),$p(parent,":",7))
	q:parchild[(","_$p(a,"^",2)_",")&&($p($$$Malg($p(a,"^",4)),"^",21)) 1
	s parent=$p(a,"^",3) g parch1
setdata(numtup)	;
	#; this is the first time we have processed a solution for this
	#; set of strms, so must calculate the value for $$$Mcost(...,qoslist)
	#; input parameter:
	#;     numtup: # of tuples
	#; input variables: qoqn,qojsn,qonumstr
	#;     qoslist: stream list including this stream
	#;     resslist: list of all restrictions processed in this set of
	#;               streams solution as a debugging aid
	#;     costprev: previous stream set entry for 
	#;                $$$Mcost(qoqn,qojsn,qonumstr-1,qoprev)
	#; return variables:
	#;     setdata: value for $$$Mcost(qoqn,qojsn,qonumstr,qoslist)  
	#;                (also setup that array node)
	#;     outseq: cost to output results of join in a sequential temp file
	#;          and later read and delete the temp file
	#;     outsort: cost to output results of join in a sorted temp file
	#;          and later read and delete the temp file
	#;     outnodes: amount of data that would be stored for this set
	#;               of streams in a temp output sort file; format is:
	#;               nodes,maxlen,avglen,#blocks
	#;               where nodes is # nodes per output tuple, maxlen
	#;               and avglen don't count node overhead
	#;     readcost: cost to later read an output temp file
	#;
	n a,b,c,bytes,baby,nodesper,outnodes,cgs,cgg,cd,blocks s a=$p(costprev,"^",3),b=$p(qoalg,"^",19)
		#; a = outnodes for previous stream set, b = outnodes for this stream
	;HSU231+
	if ($p(b,",",3)'=""){
		s c=$p(a,",",2)+$p(b,",",2)
	    ;use avg length to estimate nodesper
		set nodesper=$select($$$LimitGlobalNodeSize:($p(a,",",3)+$p(b,",",3))\$$$MaxGlobalNodeSize+1,1:1)
		set outnodes=nodesper_","_c_","_($p(a,",",3)+$p(b,",",3))
	}
	else{
		; if no avg field legth info, we still use c (max field length) to estimate nodesper
		s c=$p(a,",",2)+$p(b,",",2),nodesper=$select($$$LimitGlobalNodeSize:c\$$$MaxGlobalNodeSize+1,1:1),outnodes=nodesper_","_c_","_($p(a,",",3)+$p(b,",",3))
	}
	;HSU231-
		#; determine amount of data in a temp output file
		#; count 7 overhead bytes per global node
	s bytes=nodesper*7+$p(outnodes,",",3)	; bytes = # bytes per tuple
		#; determine cost to produce, read, and delete a sequential file
	s blocks=numtup*bytes\$$$DBBlockSize+1	; # blocks for sequentially created file
	s cgs=numtup*nodesper+TEMPCGS,a=blocks,cd=a*3+TEMPCD	; must write block, read block, and garbage collect (write) it
	s b=numtup*(nodesper+1),cgg=b+TEMPCGG	; assumes have to do a $O per tuple on read
	s outseq=((cd*CDFACTOR)+(cgs*CGSFACTOR)+(cgg*CGGFACTOR))_","_cd_","_cgg_","_cgs
		#; determine cost to read a temp output file
	s readcost=((a*CDFACTOR)+(b*CGGFACTOR))_","_a_","_b_",0"
		#; determine cost to produce, read, and delete a sort file
	s blocks=numtup*bytes\($$$DBBlockSize*3\4)+1,cd=blocks*3+TEMPCD
		#; if need to use baby files, cost to produce the file is increased
	If $$$CostBabyFile {
	  s baby=($$$DBBlockSize*3\4)*BABYBLK\bytes s:baby<20 baby=20	; baby = # tuples per baby sort file
	  if blocks>BABYBLK { s cgg=cgg*2,cgs=cgs*2,cd=cd*2 } else { s baby="" }
	} else {s baby=""}
	s outsort=((cd*CDFACTOR)+(cgg*CGGFACTOR)+(cgs*CGSFACTOR))_","_cd_","_cgg_","_cgs
	s outnodes=outnodes_","_blocks,setdata=numtup_"^"_baby_"^"_outnodes_"^"_outseq_"^"_outsort_"^"_readcost_"^"_resslist
	s $$$Mcost(qoqn,qojsn,qonumstr,qoslist)=setdata
	QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cartprod	; Cartesian product
	#; For this set of previous streams, find one or more streams
	#; that can be used for a cartesian product (exclude streams
	#; that are in "previous" stream set, and exclude streams
	#; that are the right side of a left outer join)
	#;
	#;PVA027: add strmfound and filter against 'prohibit'
	#; PVA348: remove setting and use of strmfound (error(34)) here. It is now set lower down, and tested higher up
	s qosn="" f i=1:1 s qosn=$o(ptj(qoqn,qojsn,qosn)) q:qosn=""  d:qoprev'[(","_qosn_",")&&('$lf(prohibit,qosn)) cart1
		#;PVA027: Add error(34) test
	q
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cart1	; run through mts()
	#; if this stream is the right side of an outer join, then this stream can't be used
	n ldeps,i,nargs,usesort,xy  // need to new xy for jump to join2
	if $d(mts(qoqn,qosn,"lateral"),ldeps) // PVA348: check that lateral references satisfiable
	{  for i=1:1:$ll(ldeps) {return:qoprev'[(","_$li(ldeps,i)_",")}
	}
	s qoouter=0,qoja=""
		#; qoja = join attribute ifn
	f i=1:1 s qoja=$o(mts(qoqn,qosn,"JOIN",qoja)) q:qoja=""||qoouter  s qojar="" f i=1:1 s qojar=$o(mts(qoqn,qosn,"JOIN",qoja,qojar)) q:qojar=""  s a=mts(qoqn,qosn,"JOIN",qoja,qojar),qoouter=+$p(a,"^",4) q:qoouter
	QUIT:qoouter
		#;
		#; yes - can do a cartesian product of this stream with the previous
		#; stream set.  The method is to use the initial stream algorithm
		#; that produces, for this stream, the fastest temp file output
		#; Then we do a cartestian product of the previous stream set
		#; with that algorithm.
		#; find fastest unordered temp output file for initial stream on qosn
		#;
    // PVA348: heuristically compute number of possible stream 'argument' values : lateral reference streams
    s nargs=$$EstArgCard(qoqn,qosn)
    // PVA348: If multiple rows input per argument set, we want to force caching via a sort file
    if +costprev/nargs '< 1.5 {s usesort=1} else {s usesort=0}
    if usesort
    {  	s y=$g($$$Mcost(qoqn,qojsn,1,","_qosn_",",0,2)) 
        if y {s x=2 g gotone}
    }
	s x=1,y=$g($$$Mcost(qoqn,qojsn,1,","_qosn_",",0,1))
		#; PVA072: $g around solution access, and quit if no useful 
		#;         starting point for cartesian product. This allows 
		#;         error message rather than internal error to be returned. 
	s:'y x=2,y=$g($$$Mcost(qoqn,qojsn,1,","_qosn_",",0,2)) 
	#; PVA157: try a non-temp file solution, if necessary. There is no way to turn off
	#;         DISTINCT opt like there is TOP opt (note, FASTDISTINCT has nothing to do
	#;         with optimizer distinct op; that controls a pre-optimizer optimization).
	s:'y x=0,y=$g($$$Mcost(qoqn,qojsn,1,","_qosn_",",0,0)) QUIT:'y
gotone
	n cartsolIter,foundOne,algInfo,ycnt,ycntsol
	s cartis=$$$Mcost(qoqn,qojsn,1,","_qosn_","),cartsol=$$$Mcost(qoqn,qojsn,1,","_qosn_",",0,x,y)
	i $p($$$Malg($p(cartsol,"^",4)),"^",13)="",$p($$$Malg($p(cartsol,"^",4)),"^",23)'["IC8M" {
		s ycnt="",foundOne=0
		f {
			s ycnt=$o($$$Mcost(qoqn,qojsn,1,","_qosn_",",0,x,ycnt),1,ycntsol)
			QUIT:ycnt=""
			s algInfo=$$$Malg($p(ycntsol,"^",4))
			i $p(algInfo,"^",13)'="" {
				s cartsolIter=$$$Mcost(qoqn,qojsn,1,","_qosn_",",0,x,y)
				i ((cartsolIter*$p($p(algInfo,"^",17),",",$$$SSE1)<cartsol)&'foundOne)||((cartsolIter<cartsol)&foundOne) {	
					s y=ycnt,cartsol=$$$Mcost(qoqn,qojsn,1,","_qosn_",",0,x,y),foundOne=1
				}
			}	
		}
	}
		#; set qoslist = qoprev with qosn inserted in order
	f i=2:1:$l(qoprev,",")-1 i $p(qoprev,",",i)>qosn s qoslist=$p(qoprev,",",1,i-1)_","_qosn_","_$p(qoprev,",",i,200) q
	e  s qoslist=qoprev_qosn_","
		#;
		#; find list of multistream restrictions that can be satisfied with
		#; this cartesian product.  Also put selectivity of them in cartsel.
		#;
	s a="",b="",cartsel=1 f i=1:1 s b=$o(mts(qoqn,qosn,"MREL",b)) q:b=""  s c=mts(qoqn,qosn,"MREL",b),d=$p(c,"^",3) s:$$dores a=a_"*"_b_":"_d,cartsel=cartsel*c
		#; create a new algorithm for this cartesian product
	s b=$$$Malg($p(cartsol,"^",4))	; initial stream algorithm
	s qoalg=3_"^"_$p(b,"^",2,7)_"^"_$e(a,2,*)_"^"_$p(b,"^",9,99)
	#; AK392
	s algnum=$i($$$Malg(0)),$$$Malg(algnum)=qoalg
		#;PVA027: Set strmfound
		#;PVA023: kill resalready, call setresalready
	s newstream=1,strmfound=1 k resalready d %qaoc4^%qaqoco,setresalready^%qaqoco,join1^%qaqoco QUIT
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#; PVA348: create EstArgCard, OneArg
EstArgCard(qoqn,qosn) [mt,mts] PUBLIC
{
    quit:'$d(mts(qoqn,qosn,"lateralf"),args) 1 // can only be one arg set if no lateral dependencies
    // Since we know it has lateral dependencies we know it has some arguments
    s nargs=1 for i=1:1:$ll(args)
    {  s nargs = nargs * $$OneArg($li(args,i))  // OneArg will return zero if arg is indeterminate
    }
    s:('nargs ) nargs=1 // whatever - shouldn't really happen
    quit nargs 
}  
OneArg(val) [mt,mtsq,str,irn,ifn,tup,vals] PUBLIC
{  n str,irn,ifn,tup,vals
   s v=$$$mtV(val)
   q:"txn"[$e(v) 1
   if $e(v)="f" 
   {  	
      s ifn=$p(v,"^",3),str=$p(v,"^",2),irn=$$$mtRIrn($$$mtR(str)),qn=$$$mtRQb($$$mtR(str))
      if $d($$$mtRVirtual(str)) {  s nv=$s(ifn=$p($d(mts(qn,str)),"^",5):200,1:10) q nv}
      if $d(mts(qn,str,"CON",+ifn),info) {s nv=+$p(info,"^",4) s:'nv nv=1 q nv}
      s ifn2=$o(mts(qn,str,"CON",+ifn_"_"),1,info) // we'll take any collation as a heuristic
      if +ifn2=+ifn {s nv=+$p(info,"^",4) s:'nv nv=1 q nv}
      s nv=$$$smdColSelectivity(1,irn,+ifn)
      s tup=+$g(mts(qn,str),100),vals=nv  ; tup and vals are used as inputs to ddvals
      s:'nv nv=$$ddvals^%qaqpqo(irn,+ifn)
      if $d(mts(qn,str,"RANGE",+ifn),info) {s nv=nv*info}
      else 
      {  s ifn2=$o(mts(qn,str,"CON",+ifn_"_"),1,info) 
         if +ifn2=+ifn {s nv=nv*info }
      }
      s:nv<1 nv=1      
      q nv
   }
   else
   {  s flst=$p(v,"^",3)
      q:flst="," 1 // streamless
      s nv=1 for i=2:1 {s val=$p(flst,",",i) q:'val  s nv=nv*$$OneArg(val) }
      q nv
   }   
}  
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dores()	; return: 1 if this restriction can be processed by this 
	#; cartesian product
	f i=2:1:$l(d,",")-1 g dores1:qoslist'[(","_$p(d,",",i)_",")
	QUIT 1
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
dores1	QUIT 0
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
cartcost(intuples,abp)	;
	#;
	#; calculate cost of cartesian product
	#; don't add $p(qoalg,"^",16) in cost3 or cost8 since we
	#; include create cost in cartcost
	#; input parameters:
	#;     intuples: # of input tuples from left side
	#;     abp: # available buffers in buffer pool
	#; input variable:
	#;     cartis: the "costprev" value for the initial stream
	#;             algorithm that is used for the right side stream
	#;             i.e. like mtemp(...,streams) which is:
	#;                 numtuples ^ baby ^ outnodes ^ outseq ^ outsort
	#;                 ^ readcost ^ resslist    for the initial stream
	#;     cartsol: the solution cost for the initial stream in
	#;              mtemp(...,streams,0,outtype,i)
	#;     cartsel: selectivity of multistream restrictions that
	#;              can be satisfied by the cartesian product
	#; Fundamentally, the cost is:
	#;     Cost to create the initial stream (right side of cart prod)
	#;     +  Cost to read the initial stream temp file 'intuples' times
	#;        (although only have to read the disk once if the # blocks
	#;        in the initial stream temp file > abp)
	#;
	n a,cd,cgg,cgs,numtup s numtup=intuples*cartis*cartsel+.5\1 s:numtup<1 numtup=1
		#; get initial stream creation cost
	s a=$p(cartsol,"^"),cd=$p(a,",",2),cgs=$p(a,",",4)
		#;
		#; must read the initial stream temp file intuples times
		#; note that one read is already built into the initial stream cost
		#;
	s cgg=$p($p(cartis,"^",6),",",3)*(intuples-1)+$p(a,",",3)
		#;
		#; if # disk blocks in initial stream temp file > abp
		#; then we have to read the temp file from the disk repetitively
		#;
	s a=$p($p(cartis,"^",3),",",4) s:a>abp cd=(intuples-1)*a+cd
	QUIT ((cd*CDFACTOR)+(cgg*CGGFACTOR)+(cgs*CGSFACTOR))_","_cd_","_cgg_","_cgs_"^"_numtup
	#;-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
	#;  $$: l1=LIST(log#,) sans conditions in l2
remove(l1,l2) [] PRIVATE { s l2=","_l2_"," f li=1:1 { s log=$p(l1,",",li) q:'log  i l2[(","_log_",") s $p(l1,",",li,*)=$p(l1,",",li+1,*),li=li-1 } QUIT l1 }
	;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
maybe(pair)	;
	#; see if a maybe restriction can be satisfied
	#; input variable:
	#;     pair:     restriction:streams
	#; updates resmaybe if it can be, noresmay if it can't
	n c s c=$p(pair,":",2)
	f i=2:1:$l(c,",")-1 i qoprev'[(","_$p(c,",",i)_",") GOTO maybe1
	s resmaybe=resmaybe_$p(pair,":")_","
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
maybe1	s noresmay=noresmay_$p(pair,":")_","
	QUIT
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
already	;
	#; see if this restriction has already been satisfied due to
	#; replication
	#; input variable: a: restriction #
	#; AK445
	s z="" f  s z=$o(ptres(a,z)) q:z=""  q:$$already1
	s z="" f  { s z=$o(seladj(a,z)) q:z=""  q:$$adjsel } // PVA279
	#; AK445-
	QUIT
	#; PVA279: create adjsel
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
adjsel() 
	f i=2:1:$l(z,",")-1 GOTO:resprev_$p(reswork,",",1,y)'[(","_$p(z,",",i)_",") adjsel1
	s adjsel=adjsel_a_","
	QUIT 1
adjsel1 QUIT 0	
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
already1() 	;  $$:  1 if all of z was processed, also add to resalready
	#; AK445
	#;  look in resknown only up to a, to avoid skipping a whole cycle
	#; PVA023: Change to use the new reswork instead of resknown. Eliminate reference to resmaybe, as
	#;         that is now incorporated into reswork. Also eliminate reference to resalready because 
	#;         everything in resalready came from reswork so far.
	f i=2:1:$l(z,",")-1 GOTO:resprev_$p(reswork,",",1,y)'[(","_$p(z,",",i)_",") already2
	#; AK445-
	#; ***also, what if this says not to process one of two mutually
	#; dependent restrictions, but the wrong one is in the $$$Malg(,)
	#; table?  can that happen?
	s resalready=resalready_a_","
	QUIT 1
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
already2 QUIT 0
	#;=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
propagateSubqCost(subqLog) [mt,mts,qoqn,qojsn,ptj,seldict] PUBLIC { ; IBA142 - Expose subquery call count to the optimizer
	#; propagate the subquery cost to the parent query block.
	#; The subquery cost is muliplied by the estimated number of subquery calls.
	set subqList=$$$mtLogSubquery(qoqn,subqLog)
	set totalSubqCost=0
	for j=1:1:$l(subqList,",")-1 {
		set subq=$p(subqList,",",j)
		QUIT:$o($$$Mcost(subq,1,""),-1)'=1  ;  more than one table in the subquery
		set qosn=$o(ptj(subq,1,""))
		#; find subquery cost by looping on the solution space and storing the lowest cost
		set subqCost="",qonumstr=1,order=""
		for {
			s order=$o($$$Mcost(subq,qojsn,qonumstr,","_qosn_",",order))
			QUIT:order=""
			for outtype=0:1:2 {
				set soln=""
				for {
					s soln=$o($$$Mcost(subq,qojsn,qonumstr,","_qosn_",",order,outtype,soln),1,cost)
					QUIT:soln=""
					s:(subqCost="")||(+cost<subqCost) subqCost=+cost
				}
			}
		}
		#; In reality, the subqueries can have different degrees of correlation.
		#; So propagating their cost individually can be better
		#; For now, this is simplified by just taking the sum
		set totalSubqCost=totalSubqCost+subqCost
	}
	QUIT:totalSubqCost=0 ; a safeguard if we fail to retrieve subquery cost
	set qosn=$o(ptj(qoqn,1,""))
	QUIT:qosn="" ; should not happen, but just in case
	set numtups=+mts(qoqn,qosn) ; number of tuples, usually this is the same as the extentsize
	set qonumstr=1 ; IBA142 applies only when we have one stream per query block for now.
	set order=""
	#; Main loop to propagate the cost of subqueries
	#; We propagate the cost for each interesting order, which is LIST(,#val,) or 0 if no interesting order.
	for {
		set order=$o($$$Mcost(qoqn,qojsn,qonumstr,","_qosn_",",order))
		QUIT:order=""
		#; We propagate the cost for each outtype
		for outtype=0:1:2 {
			CONTINUE:$$$Mcost(qoqn,qojsn,qonumstr,","_qosn_",",order,outtype)=""
			set soln=""
			for {
				set soln=$o($$$Mcost(qoqn,qojsn,qonumstr,","_qosn_",",order,outtype,soln),1,solnInfo)
				QUIT:soln=""
				set qoalg=$$$Malg($p(solnInfo,"^",4)) ; find th %malg number
				#; resknown is enough to handle single stream queries
				#; When this gets extended to multiple streams, ressubscript might be needed to handle this correctly
				set resknown=$p(qoalg,"^",7)
				#; worst case is we need to call the subquery as many times as the extentsize of the parent query block.
				set subqCalls=numtups
				#; A safeguard: only propagate the cost if the stream processes the condition. This possibly can be removed.
				if resknown[(","_subqLog_",") {
					#; everytime we process a condition before the subqLog introducing the correlation,
					#; reduce the estimate of number of subquery calls by its selectivity
					for j=2:1:$l(resknown,",")-1 {
						set log=$p(resknown,",",j)
						QUIT:log=subqLog
						set subqCalls=subqCalls*seldict(log)
					}
					#; assume there is at least one subquery call 
					set:subqCalls<1 subqCalls=1
					#; Update the original cost by adding a subquery cost multiplied by the number of calls.
					set prevCost=$p($$$Mcost(qoqn,qojsn,qonumstr,","_qosn_",",order,outtype,soln),"^")
					set newCost=+prevCost+(subqCalls*totalSubqCost)
					#; Only update the total cost, no need to update CD, CGG and CGS for now.
					set $p($$$Mcost(qoqn,qojsn,qonumstr,","_qosn_",",order,outtype,soln),"^")=newCost_","_$p(prevCost,",",2,*)
				}
			}
			#; now, parse the outtype solution space again to update the best solution
			set soln="",bestOuttypeCost=""
			for {
				set soln=$o($$$Mcost(qoqn,qojsn,qonumstr,","_qosn_",",order,outtype,soln),1,solnInfo)
				QUIT:soln=""
				if (bestOuttypeCost="")||(+solnInfo<bestOuttypeCost) {
					set bestOuttypeCost=+solnInfo
					#; update fastest solution for each (order,outtype) duo
					set $$$Mcost(qoqn,qojsn,qonumstr,","_qosn_",",order,outtype)=soln
				}
			}
		}
	}
	QUIT
}
