{
  "name": "tree-sitter-objectscript",
  "version": "1.4.0",
  "description": "Tree Sitter Grammar for InterSystems ObjectScript",
  "scripts": {
    "install": "node-gyp-build",
    "lint": "eslint common/grammar.js",
    "test": "node --test bindings/node/*_test.js"
  },
  "author": "Dave McCaldon <davem@intersystems.com>",
  "maintainers": [
    "Hannah Kimura <hkimura@intersystems.com>"
  ],
  "license": "MIT",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "objectscript"
  ],
  "dependencies": {
    "node-gyp-build": "^4.8.2",
    "node-addon-api": "^8.5.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "eslint-config-treesitter": "^1.0.2",
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.25.9",
    "tree-sitter": "^0.25.0"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "files": [
    "objectscript/grammar.js",
    "udl/grammar.js",
    "core/grammar.js",
    "expr/grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "common/**",
    "bindings/node/*",
    "objectscript/src/**",
    "udl/queries/*",
    "udl/src/**",
    "tree-sitter.json",
    "udl/package.json",
    "core/package.json",
    "expr/package.json",
    "*.wasm",
    "core/src/**",
    "expr/src/**",
    "expr/queries/*",
    "core/queries/*"
  ]
}
