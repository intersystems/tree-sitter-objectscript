{
  "grammars": [
    {
      "name": "objectscript_routine",
      "camelcase": "ObjectScriptRoutine",
      "scope": "source.objectscript_routine",
      "path": "objectscript_routine",
      "external-files": ["common/scanner.h"],
      "file-types": ["mac", "inc", "int", "rtn"],
      "highlights": ["objectscript_routine/queries/highlights.scm"],
      "injections": ["objectscript_routine/queries/injections.scm"],
      "indents": ["objectscript_routine/queries/indents.scm"],
      "injection-regex": "^(cos|objectscript)$"
    },
    {
      "name": "objectscript",
      "camelcase": "ObjectScript",
      "scope": "source.objectscript",
      "path": "objectscript",
      "external-files": ["common/scanner.h"],
      "highlights": ["objectscript/queries/highlights.scm"],
      "injections": ["objectscript/queries/injections.scm"],
      "indents": ["objectscript/queries/indents.scm"],
      "injection-regex": "^(cos|objectscript)$"
    },
    {
      "name": "objectscript_udl",
      "camelcase": "ObjectScriptUdl",
      "scope": "source.objectscript_udl",
      "path": "udl",
      "external-files": ["common/scanner.h"],
      "file-types": ["cls"],
      "highlights": ["udl/queries/highlights.scm"],
      "injections": ["udl/queries/injections.scm"],
      "indents": ["udl/queries/indents.scm"],
      "injection-regex": "^(cos|objectscript)$"
    },
    {
      "name": "objectscript_core",
      "camelcase": "ObjectScriptCore",
      "scope": "source.objectscript_core",
      "path": "core",
      "external-files": ["common/scanner.h"],
      "highlights": ["core/queries/highlights.scm"],
      "injections": ["core/queries/injections.scm"],
      "indents": ["core/queries/indents.scm"],
      "injection-regex": "^(cos|objectscript)$"
    },
    {
      "name": "objectscript_expr",
      "camelcase": "ObjectScriptExpr",
      "scope": "source.objectscript_expr",
      "path": "expr",
      "highlights": ["expr/queries/highlights.scm"],
      "injection-regex": "^(cos|objectscript)$"
    }
  ],
  "metadata": {
    "version": "1.9.1",
    "license": "MIT",
    "description": "ObjectScript grammars for tree-sitter",
    "namespace": "io.github.treesitter.objectscript",

    "authors": [
      {
        "name": "Dave McCaldon",
        "email": "davem@intersystems.com"
      },
      {
        "name": "Hannah Kimura",
        "email": "hkimura@intersystems.com"
      }
    ],
    "links": {
      "repository": "https://github.com/intersystems/tree-sitter-objectscript"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "java": true,
    "kotlin": true
  }
}
