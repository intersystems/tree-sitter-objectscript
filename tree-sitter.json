{
  "grammars": [
    {
      "name": "objectscript",
      "camelcase": "ObjectScript",
      "scope": "source.objectscript",
      "path": "udl",
      "external-files": [
        "common/scanner.h"
      ],
      "file-types": [
        "cls"
      ],
      "highlights": [
        "expr/queries/highlights.scm",
        "core/queries/highlights.scm",
        "udl/queries/highlights.scm"
      ],
      "injections": [
        "core/queries/injections.scm",
        "udl/queries/injections.scm"
      ],
      "indents": [
        "core/queries/indents.scm",
        "udl/queries/indents.scm"
      ],
      "injection-regex": "^(cos|objectscript)$"
    },
    {
      "name": "objectscript_core",
      "camelcase": "ObjectScriptCore",
      "scope": "source.objectscript_core",
      "path": "core",
      "external-files": [
        "common/scanner.h"
      ],
      "highlights": [
        "expr/queries/highlights.scm",
        "core/queries/highlights.scm"
      ],
      "injections": [
        "core/queries/injections.scm"
      ],
      "indents": [
        "core/queries/indents.scm"
      ],
      "injection-regex": "^(cos|objectscript)$"
    },
    {
      "name": "objectscript_expr",
      "camelcase": "ObjectScriptExpr",
      "scope": "source.objectscript_expr",
      "path": "expr",
      "external-files": [
        "common/scanner.h"
      ],
      "highlights": [
        "expr/queries/highlights.scm"
      ],
      "injection-regex": "^(cos|objectscript)$"
    }
  ],
  "metadata": {
    "version": "1.3.0",
    "license": "MIT",
    "description": "ObjectScript Core grammar for tree-sitter",
    "authors": [
      {
        "name": "Dave McCaldon",
        "email": "davem@intersystems.com"
      },
      {
        "name": "Hannah Kimura",
        "email": "hkimura@intersystems.com"
      }
    ],
    "links": {
      "repository": "https://github.com/intersystems/tree-sitter-objectscript"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift" : true
  }
}
